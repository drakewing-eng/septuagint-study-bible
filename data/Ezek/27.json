[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72]],"And the word of the Lord came to me, saying,"],["2",[["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["λαβὲ",708076,176],["ἐπὶ",705080,0],["Σορ",711939,9],["θρῆνον",706309,6]],"And thou, son of man, take up a lamentation against Sor;"],["3",[["καὶ",707031,7],["ἐρεῖς",705415,166],["τῇ",709436,100],["Σορ",711939,1],["τῇ",709436,100],["κατοικούσῃ",707534,220],["ἐπὶ",705080,0],["τῆς",709436,16],["εἰσόδου",704119,17],["τῆς",709436,16],["θαλάσσης",706069,17],["τῷ",709436,53],["ἐμπορίῳ",704613,54],["τῶν",709436,80],["λαῶν",708094,81],["ἀπὸ",701425,0],["νήσων",709302,65],["πολλῶν",710646,198],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["τῇ",709436,100],["Σορ",711939,1],["σὺ",712181,164],["εἶπας",705373,162],["ἐγὼ",704018,164],["περιέθηκα",710403,155],["ἐμαυτῇ",704545,105],["κάλλος",707093,25],["μου",709032,133]],"and thou shalt say to Sor that dwells at the entrance of the sea, to the mart of the nations coming from many islands, Thus saith the Lord to Sor; Thou hast said, I have clothed myself with my beauty."],["4",[["ἐν",704639,0],["καρδίᾳ",707141,1],["θαλάσσης",706069,17],["τῷ",709436,113],["Βεελιμ",702619,114],["υἱοί",713075,52],["σου",711945,133],["περιέθηκάν",710403,150],["σοι",711925,159],["κάλλος",707093,25]],"In the heart of the sea thy sons have put beauty upon thee for Beelim.",{"s":"d","q":0.6}],["5",[["κέδρος",707590,12],["ἐκ",704132,0],["Σανιρ",711494,118],["ᾠκοδομήθη",709509,37],["σοι",711925,159],["ταινίαι",712690,191],["σανίδων",711491,65],["κυπαρίσσου",707982,17],["ἐκ",704132,0],["τοῦ",709436,35],["Λιβάνου",708185,18],["ἐλήμφθησαν",708076,99],["τοῦ",709436,20],["ποιῆσαί",710582,106],["σοι",711925,159],["ἱστοὺς",706850,57],["ἐλατίνους",704390,60]],"Cedar in Senir was employed for thee in building: boards of cypress timber were taken out of Libanus, and wood to make thee masts of fir."],["6",[["ἐκ",704132,0],["τῆς",709436,16],["Βασανίτιδος",702569,17],["ἐποίησαν",710582,150],["τὰς",709436,38],["κώπας",708026,39],["σου",711945,133],["τὰ",709436,41],["ἱερά",706633,68],["σου",711945,133],["ἐποίησαν",710582,150],["ἐξ",704132,0],["ἐλέφαντος",704438,18],["οἴκους",709516,57],["ἀλσώδεις",700730,60],["ἀπὸ",701425,0],["νήσων",709302,65],["τῶν",709436,80],["Χεττιιν",713841,81]],"They made thine oars [of wood] out of the land of Basan; thy sacred utensils they made of ivory, thy shady houses of wood from the isles of Chetiim."],["7",[["βύσσος",702834,12],["μετὰ",708780,0],["ποικιλίας",710586,17],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["ἐγένετό",703104,23],["σοι",711925,159],["στρωμνὴ",712174,12],["τοῦ",709436,20],["περιθεῖναί",710403,106],["σοι",711925,159],["δόξαν",703791,9],["καὶ",707031,7],["περιβαλεῖν",710294,296],["σε",711598,163],["ὑάκινθον",713048,9],["καὶ",707031,7],["πορφύραν",710682,9],["ἐκ",704132,0],["τῶν",709436,130],["νήσων",709302,65],["Ελισαι",704482,118],["καὶ",707031,7],["ἐγένετο",703104,23],["περιβόλαιά",710300,64],["σου",711945,133]],"Fine linen with embroidery from Egypt supplied thy couch, to put honour upon thee, and to clothe thee with blue and purple from the isles of Elisai; and they became thy coverings."],["8",[["καὶ",707031,7],["οἱ",709436,136],["ἄρχοντές",701862,52],["σου",711945,133],["οἱ",709436,136],["κατοικοῦντες",707534,146],["Σιδῶνα",711775,9],["καὶ",707031,7],["Αράδιοι",701678,52],["ἐγένοντο",703104,189],["κωπηλάται",708027,52],["σου",711945,133],["οἱ",709436,136],["σοφοί",711985,138],["σου",711945,133],["Σορ",711939,258],["οἳ",709781,250],["ἦσαν",704093,137],["ἐν",704639,0],["σοί",711925,159],["οὗτοι",709858,201],["κυβερνῆταί",707948,52],["σου",711945,133]],"And thy princes were the dwellers in Sidon, and the Aradians were thy rowers: thy wise men, O Sor, who were in thee, these were thy pilots."],["9",[["οἱ",709436,136],["πρεσβύτεροι",710735,267],["Βυβλίων",702828,286],["καὶ",707031,7],["οἱ",709436,136],["σοφοὶ",711985,138],["αὐτῶν",702165,40],["ἦσαν",704093,137],["ἐν",704639,0],["σοί",711925,159],["οὗτοι",709858,201],["ἐνίσχυον",704750,137],["τὴν",709436,8],["βουλήν",702792,9],["σου",711945,133],["καὶ",707031,7],["πάντα",710177,195],["τὰ",709436,63],["πλοῖα",710556,64],["τῆς",709436,16],["θαλάσσης",706069,17],["καὶ",707031,7],["οἱ",709436,136],["κωπηλάται",708027,52],["αὐτῶν",702165,40],["ἐγένοντό",703104,189],["σοι",711925,159],["ἐπὶ",705080,0],["δυσμὰς",703865,39],["δυσμῶν",703865,65]],"The elders of the Biblians, and their wise men, who were in thee, these helped thy counsel: and all the ships of the sea and their rowers traded for thee to the utmost west."],["10",[["Πέρσαι",710429,52],["καὶ",707031,7],["Λυδοὶ",708265,52],["καὶ",707031,7],["Λίβυες",708190,52],["ἦσαν",704093,137],["ἐν",704639,0],["τῇ",709436,100],["δυνάμει",703839,1],["σου",711945,133],["ἄνδρες",701150,52],["πολεμισταί",710604,52],["σου",711945,133],["πέλτας",710242,39],["καὶ",707031,7],["περικεφαλαίας",710331,39],["ἐκρέμασαν",707892,150],["ἐν",704639,0],["σοί",711925,159],["οὗτοι",709858,201],["ἔδωκαν",703654,150],["τὴν",709436,8],["δόξαν",703791,9],["σου",711945,133]],"Persians and Lydians and Libyans were in thine army: thy warriors hung in thee shields and helmets; these gave [thee] thy glory."],["11",[["υἱοὶ",713075,52],["Αραδίων",701678,81],["καὶ",707031,7],["ἡ",709436,10],["δύναμίς",703839,12],["σου",711945,133],["ἐπὶ",705080,0],["τῶν",709436,43],["τειχέων",712759,44],["σου",711945,133],["φύλακες",713616,52],["ἐν",704639,0],["τοῖς",709436,147],["πύργοις",711092,148],["σου",711945,133],["ἦσαν",704093,137],["τὰς",709436,38],["φαρέτρας",713364,39],["αὐτῶν",702165,40],["ἐκρέμασαν",707892,150],["ἐπὶ",705080,0],["τῶν",709436,130],["ὅρμων",709756,65],["σου",711945,133],["κύκλῳ",707959,114],["οὗτοι",709858,201],["ἐτελείωσάν",712771,150],["σου",711945,133],["τὸ",709436,24],["κάλλος",707093,25]],"The sons of the Aradians and thine army were upon thy walls; there were guards in thy towers: they hung their quivers on thy battlements round about; these completed thy beauty."],["12",[["Καρχηδόνιοι",707190,52],["ἔμποροί",704614,52],["σου",711945,133],["ἀπὸ",701425,0],["πλήθους",710529,21],["πάσης",710177,82],["ἰσχύος",706858,17],["σου",711945,133],["ἀργύριον",701707,25],["καὶ",707031,7],["χρυσίον",713972,25],["καὶ",707031,7],["σίδηρον",711774,6],["καὶ",707031,7],["κασσίτερον",707198,6],["καὶ",707031,7],["μόλυβον",708981,6],["ἔδωκαν",703654,150],["τὴν",709436,8],["ἀγοράν",700183,9],["σου",711945,133]],"The Carthaginians were thy merchants because of the abundance of all thy strength; they furnished thy market with silver, and gold, and iron, and tin, and lead."],["13",[["ἡ",709436,10],["Ἑλλὰς",704512,12],["καὶ",707031,7],["ἡ",709436,10],["σύμπασα",712324,29],["καὶ",707031,7],["τὰ",709436,63],["παρατείνοντα",710109,242],["οὗτοι",709858,201],["ἐνεπορεύοντό",704611,139],["σοι",711925,159],["ἐν",704639,0],["ψυχαῖς",714070,76],["ἀνθρώπων",701163,81],["καὶ",707031,7],["σκεύη",711844,42],["χαλκᾶ",713690,68],["ἔδωκαν",703654,150],["τὴν",709436,8],["ἐμπορίαν",704612,9],["σου",711945,133]],"Greece, both the whole [world], and the adjacent coasts, these traded with thee in the persons of men, and they gave [as] thy merchandise vessels of brass."],["14",[["ἐξ",704132,0],["οἴκου",709516,18],["Θεργαμα",706204,118],["ἵππους",706790,57],["καὶ",707031,7],["ἱππεῖς",706786,57],["ἔδωκαν",703654,150],["ἀγοράν",700183,9],["σου",711945,133]],"Out of the house of Thogarma horses and horsemen furnished thy market."],["15",[["υἱοὶ",713075,52],["Ῥοδίων",711278,81],["ἔμποροί",704614,52],["σου",711945,133],["ἀπὸ",701425,0],["νήσων",709302,65],["ἐπλήθυναν",710530,150],["τὴν",709436,8],["ἐμπορίαν",704612,9],["σου",711945,133],["ὀδόντας",709461,57],["ἐλεφαντίνους",704436,60],["καὶ",707031,7],["τοῖς",709436,147],["εἰσαγομένοις",704107,341],["ἀντεδίδους",701231,363],["τοὺς",709436,58],["μισθούς",708939,57],["σου",711945,133]],"The sons of the Rhodians were thy merchants; from the islands they multiplied thy merchandise, [even] elephants' teeth: and to them that came in thou didst return thy prices,"],["16",[["ἀνθρώπους",701163,57],["ἐμπορίαν",704612,9],["σου",711945,133],["ἀπὸ",701425,0],["πλήθους",710529,21],["τοῦ",709436,35],["συμμίκτου",712308,116],["σου",711945,133],["στακτὴν",712043,9],["καὶ",707031,7],["ποικίλματα",710588,42],["ἐκ",704132,0],["Θαρσις",706124,118],["καὶ",707031,7],["Ραμωθ",711174,323],["καὶ",707031,7],["Χορχορ",713925,323],["ἔδωκαν",703654,150],["τὴν",709436,8],["ἀγοράν",700183,9],["σου",711945,133]],"[even] men [as] thy merchandise, from the multitude of thy trading [population], myrrh and embroidered works from Tharsis: Ramoth also and Chorchor furnished thy market."],["17",[["Ιουδας",706775,4],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["τοῦ",709436,35],["Ισραηλ",706839,18],["οὗτοι",709858,201],["ἔμποροί",704614,52],["σου",711945,133],["ἐν",704639,0],["σίτου",711814,18],["πράσει",710719,1],["καὶ",707031,7],["μύρων",709072,44],["καὶ",707031,7],["κασίας",707194,17],["καὶ",707031,7],["πρῶτον",711041,647],["μέλι",708700,25],["καὶ",707031,7],["ἔλαιον",704380,25],["καὶ",707031,7],["ῥητίνην",711252,9],["ἔδωκαν",703654,150],["εἰς",704105,0],["τὸν",709436,5],["σύμμικτόν",712308,27],["σου",711945,133]],"Juda and the children of Israel, these were thy merchants; in the sale of corn and ointments and cassia: and they gave the best honey, and oil, and resin, to thy trading [population]."],["18",[["Δαμασκὸς",703275,120],["ἔμπορός",704614,4],["σου",711945,133],["ἐκ",704132,0],["πλήθους",710529,21],["πάσης",710177,82],["δυνάμεώς",703839,17],["σου",711945,133],["οἶνος",709530,4],["ἐκ",704132,0],["Χελβων",713802,228],["καὶ",707031,7],["ἔρια",705426,42],["ἐκ",704132,0],["Μιλήτου",708919,118]],"[The people of] Damascus were thy merchants by reason of the abundance of all thy power; wine out of Chelbon, and wool from Miletus; and they brought wine into thy market.",{"s":"d","q":0.63}],["19",[["καὶ",707031,7],["οἶνον",709530,6],["εἰς",704105,0],["τὴν",709436,8],["ἀγοράν",700183,9],["σου",711945,133],["ἔδωκαν",703654,150],["ἐξ",704132,0],["Ασηλ",701931,118],["σίδηρος",711774,4],["εἰργασμένος",705383,419],["καὶ",707031,7],["τροχὸς",712994,4],["ἐν",704639,0],["τῷ",709436,113],["συμμίκτῳ",712308,30],["σού",711945,133],["ἐστιν",704093,91]],"Out of Asel [came] wrought iron, and there is the sound of wheels among thy trading [population].",{"s":"d","q":0.47}],["20",[["Δαιδαν",703248,120],["ἔμποροί",704614,52],["σου",711945,133],["μετὰ",708780,0],["κτηνῶν",707934,44],["ἐκλεκτῶν",704240,83],["εἰς",704105,0],["ἅρματα",701768,42]],"[The people of] Dædan were thy merchants, with choice cattle for chariots."],["21",[["ἡ",709436,10],["Ἀραβία",701673,12],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["ἄρχοντες",701862,52],["Κηδαρ",707645,118],["οὗτοι",709858,201],["ἔμποροί",704614,52],["σου",711945,133],["διὰ",703417,0],["χειρός",713787,17],["σου",711945,133],["καμήλους",707110,57],["καὶ",707031,7],["κριοὺς",707906,57],["καὶ",707031,7],["ἀμνοὺς",700855,57],["ἐν",704639,0],["οἷς",709781,311],["ἐμπορεύονταί",704611,269],["σε",711598,163]],"Arabia and all the princes of Kedar, these were thy traders with thee, [bringing] camels, and lambs, and rams, in which they trade with thee."],["22",[["ἔμποροι",704614,52],["Σαβα",711332,118],["καὶ",707031,7],["Ραγμα",711141,118],["οὗτοι",709858,201],["ἔμποροί",704614,52],["σου",711945,133],["μετὰ",708780,0],["πρώτων",711041,749],["ἡδυσμάτων",705946,44],["καὶ",707031,7],["λίθων",708196,81],["χρηστῶν",713958,169],["καὶ",707031,7],["χρυσίον",713972,25],["ἔδωκαν",703654,150],["τὴν",709436,8],["ἀγοράν",700183,9],["σου",711945,133]],"The merchants of Sabba and Ramma, these were thy merchants, with choice spices, and precious stones: and they brought gold to thy market."],["23",[["Χαρραν",713750,120],["καὶ",707031,7],["Χαννα",713716,120],["οὗτοι",709858,201],["ἔμποροί",704614,52],["σου",711945,133],["Ασσουρ",702001,120],["καὶ",707031,7],["Χαρμαν",713740,120],["ἔμποροί",704614,52],["σου",711945,133]],"Charra, and Chanaa, these were thy merchants: Assur, and Charman, were thy merchants:"],["24",[["φέροντες",713428,146],["ἐμπορίαν",704612,9],["ὑάκινθον",713048,9],["καὶ",707031,7],["θησαυροὺς",706258,57],["ἐκλεκτοὺς",704240,60],["δεδεμένους",703394,360],["σχοινίοις",712610,96],["καὶ",707031,7],["κυπαρίσσινα",707981,68]],"bringing [for] merchandise blue, and choice stores bound with cords, and cypress wood."],["25",[["πλοῖα",710556,64],["ἐν",704639,0],["αὐτοῖς",702165,151],["Καρχηδόνιοι",707190,52],["ἔμποροί",704614,52],["σου",711945,133],["ἐν",704639,0],["τῷ",709436,53],["πλήθει",710529,54],["ἐν",704639,0],["τῷ",709436,113],["συμμίκτῳ",712308,30],["σου",711945,133],["καὶ",707031,7],["ἐνεπλήσθης",704592,168],["καὶ",707031,7],["ἐβαρύνθης",702553,168],["σφόδρα",712586,28],["ἐν",704639,0],["καρδίᾳ",707141,1],["θαλάσσης",706069,17]],"Ships were thy merchants, in abundance, with thy trading [population]: and thou wast filled and very heavily loaded in the heart of the sea."],["26",[["ἐν",704639,0],["ὕδατι",713071,54],["πολλῷ",710646,97],["ἦγόν",700209,137],["σε",711598,163],["οἱ",709436,136],["κωπηλάται",708027,52],["σου",711945,133],["τὸ",709436,34],["πνεῦμα",710566,15],["τοῦ",709436,35],["νότου",709364,18],["συνέτριψέν",712520,2],["σε",711598,163],["ἐν",704639,0],["καρδίᾳ",707141,1],["θαλάσσης",706069,17]],"Thy rowers have brought thee into great waters: the south wind has broken thee in the heart of the sea."],["27",[["ἦσαν",704093,137],["δυνάμεις",703839,191],["σου",711945,133],["καὶ",707031,7],["ὁ",709436,3],["μισθός",708939,4],["σου",711945,133],["καὶ",707031,7],["τῶν",709436,80],["συμμίκτων",712308,169],["σου",711945,133],["καὶ",707031,7],["οἱ",709436,136],["κωπηλάται",708027,52],["σου",711945,133],["καὶ",707031,7],["οἱ",709436,136],["κυβερνῆταί",707948,52],["σου",711945,133],["καὶ",707031,7],["οἱ",709436,136],["σύμβουλοί",712295,52],["σου",711945,133],["καὶ",707031,7],["οἱ",709436,136],["σύμμικτοί",712308,138],["σου",711945,133],["ἐκ",704132,0],["τῶν",709436,80],["συμμίκτων",712308,169],["σου",711945,133],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["ἄνδρες",701150,52],["οἱ",709436,136],["πολεμισταί",710604,52],["σου",711945,133],["οἱ",709436,136],["ἐν",704639,0],["σοὶ",711925,159],["καὶ",707031,7],["πᾶσα",710177,29],["ἡ",709436,10],["συναγωγή",712376,12],["σου",711945,133],["ἐν",704639,0],["μέσῳ",708768,30],["σου",711945,133],["πεσοῦνται",710481,135],["ἐν",704639,0],["καρδίᾳ",707141,1],["θαλάσσης",706069,17],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῆς",709436,16],["πτώσεώς",711072,17],["σου",711945,133]],"Thy forces, and thy gain, and that of thy traders, and thy rowers, and thy pilots, and thy counsellors, and they that traffic with thee, and all thy warriors that are in thee: and all thy company in the midst of thee shall perish in the heart of the sea, in the day of thy fall."],["28",[["πρὸς",710844,0],["τὴν",709436,8],["φωνὴν",713640,9],["τῆς",709436,16],["κραυγῆς",707886,17],["σου",711945,133],["οἱ",709436,136],["κυβερνῆταί",707948,52],["σου",711945,133],["φόβῳ",713534,114],["φοβηθήσονται",713532,144]],"At the cry of thy voice thy pilots shall be greatly terrified."],["29",[["καὶ",707031,7],["καταβήσονται",707202,135],["ἀπὸ",701425,0],["τῶν",709436,43],["πλοίων",710556,44],["πάντες",710177,138],["οἱ",709436,136],["κωπηλάται",708027,52],["σου",711945,133],["καὶ",707031,7],["οἱ",709436,136],["ἐπιβάται",705085,52],["καὶ",707031,7],["οἱ",709436,136],["πρωρεῖς",711026,52],["τῆς",709436,16],["θαλάσσης",706069,17],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["στήσονται",706846,135]],"And all the rowers and the mariners shall come down from the ships, and the pilots of the sea shall stand on the land."],["30",[["καὶ",707031,7],["ἀλαλάξουσιν",700632,218],["ἐπὶ",705080,0],["σὲ",711598,163],["τῇ",709436,100],["φωνῇ",713640,1],["αὐτῶν",702165,40],["καὶ",707031,7],["κεκράξονται",707868,135],["πικρὸν",710475,27],["καὶ",707031,7],["ἐπιθήσουσιν",705304,218],["ἐπὶ",705080,0],["τὴν",709436,8],["κεφαλὴν",707639,9],["αὐτῶν",702165,40],["γῆν",703083,9],["καὶ",707031,7],["σποδὸν",712022,9],["ὑποστρώσονται",713247,135]],"And they shall wail over thee with their voice, and cry bitterly, and put earth on their heads, and spread ashes under them."],["32",[["καὶ",707031,7],["λήμψονται",708076,135],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτῶν",702165,40],["ἐπὶ",705080,0],["σὲ",711598,163],["θρῆνον",706309,6],["καὶ",707031,7],["θρήνημά",706308,25],["σοι",711925,159]],"And their sons shall take up a [lament] for thee, even a lamentation for Sor, [saying],"],["33",[["πόσον",710692,27],["τινὰ",712866,356],["εὗρες",705676,162],["μισθὸν",708939,6],["ἀπὸ",701425,0],["τῆς",709436,16],["θαλάσσης",706069,17],["ἐνέπλησας",704592,162],["ἔθνη",704068,42],["ἀπὸ",701425,0],["τοῦ",709436,20],["πλήθους",710529,21],["σου",711945,133],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,35],["συμμίκτου",712308,116],["σου",711945,133],["ἐπλούτισας",710562,162],["πάντας",710177,60],["βασιλεῖς",702580,57],["τῆς",709436,16],["γῆς",703083,17]],"How large a reward hast thou gained from the sea? thou hast filled nations out of thine abundance; and out of thy mixed merchandise thou hast enriched all the kings of the earth."],["34",[["νῦν",709384,28],["συνετρίβης",712520,168],["ἐν",704639,0],["θαλάσσῃ",706069,1],["ἐν",704639,0],["βάθει",702381,30],["ὕδατος",713071,21],["ὁ",709436,3],["σύμμικτός",712308,14],["σου",711945,133],["καὶ",707031,7],["πᾶσα",710177,29],["ἡ",709436,10],["συναγωγή",712376,12],["σου",711945,133],["ἐν",704639,0],["μέσῳ",708768,30],["σου",711945,133],["ἔπεσον",710481,150],["πάντες",710177,138],["οἱ",709436,136],["κωπηλάται",708027,52],["σου",711945,133]],"Now art thou broken in the sea, thy traders are in the deep water, and all thy company in the midst of thee: all thy rowers have fallen."],["35",[["πάντες",710177,138],["οἱ",709436,136],["κατοικοῦντες",707534,146],["τὰς",709436,38],["νήσους",709302,39],["ἐστύγνασαν",712177,150],["ἐπὶ",705080,0],["σέ",711598,163],["καὶ",707031,7],["οἱ",709436,136],["βασιλεῖς",702580,52],["αὐτῶν",702165,40],["ἐκστάσει",704314,1],["ἐξέστησαν",704940,150],["καὶ",707031,7],["ἐδάκρυσεν",703256,2],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτῶν",702165,40]],"All the dwellers in the islands have mourned over thee, and their kings have been utterly amazed, and their countenance has wept."],["36",[["ἔμποροι",704614,52],["ἀπὸ",701425,0],["ἐθνῶν",704068,44],["ἐσύρισάν",712538,150],["σε",711598,163],["ἀπώλεια",701660,12],["ἐγένου",703104,174],["καὶ",707031,7],["οὐκέτι",709827,28],["ἔσῃ",704093,123],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"Merchants from the nations have hissed at thee; thou art utterly destroyed, and shalt not be any more for ever."]]