[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["τῷ",709436,53],["ἔτει",705543,54],["τῷ",709436,53],["ἑβδόμῳ",703925,97],["ἐν",704639,0],["τῷ",709436,113],["πέμπτῳ",710245,30],["μηνὶ",708874,114],["δεκάτῃ",703343,101],["τοῦ",709436,35],["μηνὸς",708874,18],["ἦλθον",705453,150],["ἄνδρες",701150,52],["ἐκ",704132,0],["τῶν",709436,80],["πρεσβυτέρων",710735,527],["οἴκου",709516,18],["Ισραηλ",706839,18],["ἐπερωτῆσαι",705069,106],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["ἐκάθισαν",707006,150],["πρὸ",710747,0],["προσώπου",710986,21],["μου",709032,133]],"And it came to pass in the seventh year, on the fifteenth day of the month, there came men of the elders of the house of Israel to enquire of the Lord, and they sat before me."],["2",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72]],"And the word of the Lord came to me, saying,"],["3",[["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["λάλησον",708071,176],["πρὸς",710844,0],["τοὺς",709436,58],["πρεσβυτέρους",710735,496],["τοῦ",709436,35],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐρεῖς",705415,166],["πρὸς",710844,0],["αὐτούς",702165,62],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["εἰ",704071,7],["ἐπερωτῆσαί",705069,106],["με",708618,163],["ὑμεῖς",713081,219],["ἔρχεσθε",705453,374],["ζῶ",705851,157],["ἐγὼ",704018,164],["εἰ",704071,7],["ἀποκριθήσομαι",701492,180],["ὑμῖν",713084,90],["λέγει",708124,91],["κύριος",707996,4]],"Son of man, speak to the elders of the house of Israel, and thou shalt say to them, Thus saith the Lord; Are ye come to enquire of me? [As] I live, I will not be enquired of by you, saith the Lord."],["4",[["εἰ",704071,7],["ἐκδικήσω",704174,165],["αὐτοὺς",702165,62],["ἐκδικήσει",704175,1],["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["τὰς",709436,38],["ἀνομίας",701192,39],["τῶν",709436,80],["πατέρων",710189,81],["αὐτῶν",702165,40],["διαμάρτυραι",703513,300],["αὐτοῖς",702165,151]],"Shall I utterly take vengeance on them, son of man? testify to them of the iniquities of their fathers:"],["5",[["καὶ",707031,7],["ἐρεῖς",705415,166],["πρὸς",710844,0],["αὐτούς",702165,62],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἀφ᾿",701425,0],["ἧς",709781,167],["ἡμέρας",705984,17],["ᾑρέτισα",700469,155],["τὸν",709436,5],["οἶκον",709516,6],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐγνωρίσθην",703135,156],["τῷ",709436,53],["σπέρματι",712008,54],["οἴκου",709516,18],["Ιακωβ",706401,18],["καὶ",707031,7],["ἐγνώσθην",703105,156],["αὐτοῖς",702165,151],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ἀντελαβόμην",701243,161],["τῇ",709436,100],["χειρί",713787,1],["μου",709032,133],["αὐτῶν",702165,40],["λέγων",708124,72],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"and thou shalt say to them, Thus saith the Lord; From the day that I chose the house of Israel, and became known to the seed of the house of Jacob, and was known to them in the land of Egypt, and helped them with my hand, saying, I am the Lord your God;"],["6",[["ἐν",704639,0],["ἐκείνῃ",704183,105],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἀντελαβόμην",701243,161],["τῇ",709436,100],["χειρί",713787,1],["μου",709032,133],["αὐτῶν",702165,40],["τοῦ",709436,20],["ἐξαγαγεῖν",704834,106],["αὐτοὺς",702165,62],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["ἡτοίμασα",705539,155],["αὐτοῖς",702165,151],["γῆν",703083,9],["ῥέουσαν",711241,78],["γάλα",702919,25],["καὶ",707031,7],["μέλι",708700,25],["κηρίον",707657,15],["ἐστὶν",704093,91],["παρὰ",709995,0],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9]],"in that day I helped them with my hand, to bring them out of the land of Egypt into the land which I prepared for them, a land flowing with milk and honey, it is abundant beyond every land."],["7",[["καὶ",707031,7],["εἶπα",705373,155],["πρὸς",710844,0],["αὐτούς",702165,62],["ἕκαστος",704133,14],["τὰ",709436,41],["βδελύγματα",702604,42],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["αὐτοῦ",702165,102],["ἀπορριψάτω",701563,45],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["ἐπιτηδεύμασιν",705301,96],["Αἰγύπτου",700401,17],["μὴ",708851,28],["μιαίνεσθε",708900,73],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"And I said to them, Let every one cast away the abominations of his eyes, and defile not yourselves with the devices of Egypt: I am the Lord your God."],["8",[["καὶ",707031,7],["ἀπέστησαν",702214,150],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["οὐκ",709805,28],["ἠθέλησαν",706176,150],["εἰσακοῦσαί",704108,106],["μου",709032,133],["τὰ",709436,41],["βδελύγματα",702604,42],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["αὐτῶν",702165,40],["οὐκ",709805,28],["ἀπέρριψαν",701563,150],["καὶ",707031,7],["τὰ",709436,41],["ἐπιτηδεύματα",705301,42],["Αἰγύπτου",700401,17],["οὐκ",709805,28],["ἐγκατέλιπον",703967,150],["καὶ",707031,7],["εἶπα",705373,155],["τοῦ",709436,20],["ἐκχέαι",704368,106],["τὸν",709436,5],["θυμόν",706334,6],["μου",709032,133],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["τοῦ",709436,20],["συντελέσαι",712510,106],["τὴν",709436,8],["ὀργήν",709728,9],["μου",709032,133],["ἐν",704639,0],["αὐτοῖς",702165,151],["ἐν",704639,0],["μέσῳ",708768,30],["γῆς",703083,17],["Αἰγύπτου",700401,17]],"But they revolted from me, and would not hearken to me: they cast not away the abominations of their eyes, and forsook not the devices of Egypt: then I said that I would pour out my wrath upon them, to accomplish my wrath upon them in the midst of Egypt."],["9",[["καὶ",707031,7],["ἐποίησα",710582,155],["ὅπως",709719,7],["τὸ",709436,24],["ὄνομά",709666,25],["μου",709032,133],["τὸ",709436,24],["παράπαν",710083,28],["μὴ",708851,28],["βεβηλωθῇ",702614,384],["ἐνώπιον",704823,0],["τῶν",709436,43],["ἐθνῶν",704068,44],["ὧν",709781,103],["αὐτοί",702165,201],["εἰσιν",704093,197],["ἐν",704639,0],["μέσῳ",70