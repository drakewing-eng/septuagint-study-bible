,["με",708618,163],["ἐπὶ",705080,0],["τὰ",709436,41],["πρόθυρα",710801,42],["τῆς",709436,16],["πύλης",711082,17],["οἴκου",709516,18],["κυρίου",707996,18],["τῆς",709436,16],["βλεπούσης",702740,222],["πρὸς",710844,0],["βορρᾶν",702765,6],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἐκεῖ",704181,28],["γυναῖκες",703209,191],["καθήμεναι",707000,305],["θρηνοῦσαι",706306,306],["τὸν",709436,5],["Θαμμουζ",706083,6]],"And he brought me in to the porch of the house of the Lord that looks to the north; and, behold, [there were] women sitting there lamenting for Thammuz."],["15",[["καὶ",707031,7],["εἶπεν",705373,2],["πρός",710844,0],["με",708618,163],["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["ἑώρακας",709725,266],["καὶ",707031,7],["ἔτι",705538,28],["ὄψει",709725,123],["ἐπιτηδεύματα",705301,42],["μείζονα",708653,68],["τούτων",709858,40]],"And he said to me, Son of man, thou hast seen; but thou shalt yet see [evil] practices greater than these."],["16",[["καὶ",707031,7],["εἰσήγαγέν",704107,2],["με",708618,163],["εἰς",704105,0],["τὴν",709436,8],["αὐλὴν",702137,9],["οἴκου",709516,18],["κυρίου",707996,18],["τὴν",709436,8],["ἐσωτέραν",705525,36],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἐπὶ",705080,0],["τῶν",709436,43],["προθύρων",710801,44],["τοῦ",709436,35],["ναοῦ",709191,18],["κυρίου",707996,18],["ἀνὰ",700902,0],["μέσον",708768,46],["τῶν",709436,80],["αιλαμ",700431,44],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,46],["τοῦ",709436,20],["θυσιαστηρίου",706348,21],["ὡς",714148,7],["εἴκοσι",704085,59],["ἄνδρες",701150,52],["τὰ",709436,63],["ὀπίσθια",709692,195],["αὐτῶν",702165,40],["πρὸς",710844,0],["τὸν",709436,5],["ναὸν",709191,6],["τοῦ",709436,35],["κυρίου",707996,18],["καὶ",707031,7],["τὰ",709436,63],["πρόσωπα",710986,64],["αὐτῶν",702165,40],["ἀπέναντι",701389,28],["καὶ",707031,7],["οὗτοι",709858,201],["προσκυνοῦσιν",710925,197],["τῷ",709436,113],["ἡλίῳ",705974,114]],"And he brought me into the inner court of the house of the Lord, and at the entrance of the temple of the Lord, between the porch and the altar, were about twenty men, with their back parts toward the temple of the Lord, and their faces [turned] the opposite way; and these were worshipping the sun."],["17",[["καὶ",707031,7],["εἶπεν",705373,2],["πρός",710844,0],["με",708618,163],["ἑώρακας",709725,266],["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["μὴ",708851,28],["μικρὰ",708915,68],["τῷ",709436,113],["οἴκῳ",709516,114],["Ιουδα",706768,18],["τοῦ",709436,20],["ποιεῖν",710582,55],["τὰς",709436,38],["ἀνομίας",701192,39],["ἃς",709781,193],["πεποιήκασιν",710582,353],["ὧδε",714090,28],["διότι",703734,7],["ἔπλησαν",710532,150],["τὴν",709436,8],["γῆν",703083,9],["ἀνομίας",701192,39],["καὶ",707031,7],["ἰδοὺ",706497,88],["αὐτοὶ",702165,201],["ὡς",714148,7],["μυκτηρίζοντες",709052,645]],"And he said to me, Son of man, thou hast seen this. [Is it] a little thing to the house of Juda to practise the iniquities which they have practised here? for they have filled the land with iniquity: and, behold, these are as scorners."],["18",[["καὶ",707031,7],["ἐγὼ",704018,164],["ποιήσω",710582,165],["αὐτοῖς",702165,151],["μετὰ",708780,0],["θυμοῦ",706334,18],["οὐ",709805,28],["φείσεται",713406,93],["ὁ",709436,3],["ὀφθαλμός",709870,4],["μου",709032,133],["οὐδὲ",709816,7],["μὴ",708851,28],["ἐλεήσω",704418,165]],"Therefore will I deal with them in wrath: mine eye shall not spare, nor will I have any mercy."]]