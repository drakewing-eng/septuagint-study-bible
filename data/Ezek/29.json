,709446,71],["λέγει",708124,91],["κύριος",707996,4],["κύριος",707996,4],["ἰδοὺ",706497,88],["δίδωμι",703654,157],["τῷ",709436,113],["Ναβουχοδονοσορ",709149,114],["βασιλεῖ",702580,114],["Βαβυλῶνος",702352,17],["γῆν",703083,9],["Αἰγύπτου",700401,17],["καὶ",707031,7],["προνομεύσει",710826,127],["τὴν",709436,8],["προνομὴν",710827,9],["αὐτῆς",702165,86],["καὶ",707031,7],["σκυλεύσει",711900,127],["τὰ",709436,41],["σκῦλα",711902,42],["αὐτῆς",702165,86],["καὶ",707031,7],["ἔσται",704093,93],["μισθὸς",708939,4],["τῇ",709436,100],["δυνάμει",703839,1],["αὐτοῦ",702165,102]],"Thus saith the Lord God; Behold, I [will] give to Nabuchodonosor king of Babylon the land of Egypt, and he shall take the plunder thereof, and seize the spoils thereof; and [it] shall be a reward for his army."],["20",[["ἀντὶ",701227,0],["τῆς",709436,16],["λειτουργίας",708135,17],["αὐτοῦ",702165,102],["ἧς",709781,167],["ἐδούλευσεν",703814,2],["ἐπὶ",705080,0],["Τύρον",713028,9],["δέδωκα",703654,89],["αὐτῷ",702165,50],["γῆν",703083,9],["Αἰγύπτου",700401,17],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["κύριος",707996,4]],"In return for his service wherewith he served against Tyre, I have given him the land of Egypt; thus saith the Lord God:"],["21",[["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἀνατελεῖ",701066,127],["κέρας",707625,15],["παντὶ",710177,30],["τῷ",709436,113],["οἴκῳ",709516,114],["Ισραηλ",706839,18],["καὶ",707031,7],["σοὶ",711925,159],["δώσω",703654,165],["στόμα",712125,25],["ἀνεῳγμένον",701186,439],["ἐν",704639,0],["μέσῳ",708768,30],["αὐτῶν",702165,40],["καὶ",707031,7],["γνώσονται",703105,135],["ὅτι",709803,7],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4]],"In that day shall a horn spring forth for all the house of Israel, and I will give thee an open mouth in the midst of them; and they shall know that I am the Lord."]]