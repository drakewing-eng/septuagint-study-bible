[["1",[["ἐν",704639,0],["τῷ",709436,53],["ἔτει",705543,54],["τῷ",709436,53],["δεκάτῳ",703343,97],["ἐν",704639,0],["τῷ",709436,113],["δεκάτῳ",703343,30],["μηνὶ",708874,114],["μιᾷ",704106,101],["τοῦ",709436,35],["μηνὸς",708874,18],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72]],"In the twelfth year, in the tenth month, on the first [day] of the month, the word of the Lord came to me, saying,"],["2",[["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["στήρισον",712098,176],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["ἐπὶ",705080,0],["Φαραω",713360,6],["βασιλέα",702580,6],["Αἰγύπτου",700401,17],["καὶ",707031,7],["προφήτευσον",711008,176],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐπ᾿",705080,0],["Αἴγυπτον",700401,9],["ὅλην",709597,36]],"Son of man, set thy face against Pharao king of Egypt, and prophesy against him, and against the whole of Egypt:"],["3",[["καὶ",707031,7],["εἰπόν",705373,176],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐπὶ",705080,0],["Φαραω",713360,6],["τὸν",709436,5],["δράκοντα",703822,6],["τὸν",709436,5],["μέγαν",708653,27],["τὸν",709436,5],["ἐγκαθήμενον",703952,212],["ἐν",704639,0],["μέσῳ",708768,30],["ποταμῶν",710693,81],["αὐτοῦ",702165,102],["τὸν",709436,5],["λέγοντα",708124,183],["ἐμοί",704577,159],["εἰσιν",704093,197],["οἱ",709436,136],["ποταμοί",710693,52],["καὶ",707031,7],["ἐγὼ",704018,164],["ἐποίησα",710582,155],["αὐτούς",702165,62]],"and say, Thus saith the Lord; Behold, I am against Pharao, the great dragon that lies in the midst of his rivers, that says, The rivers are mine, and I made them."],["4",[["καὶ",707031,7],["ἐγὼ",704018,164],["δώσω",703654,165],["παγίδας",709910,39],["εἰς",704105,0],["τὰς",709436,38],["σιαγόνας",711763,39],["σου",711945,133],["καὶ",707031,7],["προσκολλήσω",710921,165],["τοὺς",709436,58],["ἰχθῦς",706870,57],["τοῦ",709436,35],["ποταμοῦ",710693,18],["σου",711945,133],["πρ