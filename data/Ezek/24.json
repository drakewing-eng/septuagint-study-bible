[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["ἐν",704639,0],["τῷ",709436,53],["ἔτει",705543,54],["τῷ",709436,53],["ἐνάτῳ",704666,97],["ἐν",704639,0],["τῷ",709436,113],["μηνὶ",708874,114],["τῷ",709436,113],["δεκάτῳ",703343,30],["δεκάτῃ",703343,101],["τοῦ",709436,35],["μηνὸς",708874,18],["λέγων",708124,72]],"And the word of the Lord came to me, in the ninth year, in the tenth month, on the tenth [day] of the month, saying,"],["2",[["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["γράψον",703194,176],["σεαυτῷ",711599,50],["εἰς",704105,0],["ἡμέραν",705984,9],["ἀπὸ",701425,0],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86],["ἀφ᾿",701425,0],["ἧς",709781,167],["ἀπηρείσατο",701394,23],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,17],["ἐπὶ",705080,0],["Ιερουσαλημ",706644,9],["ἀπὸ",701425,0],["τῆς",709436,16],["ἡμέρας",705984,17],["τῆς",709436,16],["σήμερον",711751,28]],"Son of man, write for thyself daily from this day, on which the king of Babylon set himself against Jerusalem, [even] from this day."],["3",[["καὶ",707031,7],["εἰπὸν",705373,176],["ἐπὶ",705080,0],["τὸν",709436,5],["οἶκον",709516,6],["τὸν",709436,5],["παραπικραίνοντα",710087,183],["παραβολὴν",710003,9],["καὶ",707031,7],["ἐρεῖς",705415,166],["πρὸς",710844,0],["αὐτούς",702165,62],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἐπίστησον",705756,176],["τὸν",709436,5],["λέβητα",708121,6],["καὶ",707031,7],["ἔκχεον",704368,176],["εἰς",704105,0],["αὐτὸν",702165,85],["ὕδωρ",713071,25]],"And speak a parable to the provoking house, and thou shalt say to them, Thus saith the Lord; Set on the caldron, and pour water into it:"],["4",[["καὶ",707031,7],["ἔμβαλε",704547,176],["εἰς",704105,0],["αὐτὸν",702165,85],["τὰ",709436,41],["διχοτομήματα",703761,42],["πᾶν",710177,46],["διχοτόμημα",703761,25],["καλόν",707097,46],["σκέλος",711831,25],["καὶ",707031,7],["ὦμον",714114,6],["ἐκσεσαρκισμένα",704308,437],["ἀπὸ",701425,0],["τῶν",709436,43],["ὀστῶν",709792,44]],"and put the pieces into it, every prime piece, the leg and shoulder taken off from the bones,"],["5",[["ἐξ",704132,0],["ἐπιλέκτων",705189,83],["κτηνῶν",707934,44],["εἰλημμένων",708076,635],["καὶ",707031,7],["ὑπόκαιε",713202,240],["τὰ",709436,41],["ὀστᾶ",709792,42],["ὑποκάτω",713204,0],["αὐτῶν",702165,70],["ἔζεσεν",705869,2],["ἔζεσεν",705869,2],["καὶ",707031,7],["ἥψηται",701654,187],["τὰ",709436,63],["ὀστᾶ",709792,64],["αὐτῆς",702165,86],["ἐν",704639,0],["μέσῳ",708768,30],["αὐτῆς",702165,86]],"[which are] taken from choice cattle, and burn the bones under them: her bones are boiled and cooked in the midst of her."],["6",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὦ",714081,88],["πόλις",710612,12],["αἱμάτων",700442,44],["λέβης",708121,4],["ἐν",704639,0],["ᾧ",709781,309],["ἐστιν",704093,91],["ἰὸς",706764,4],["ἐν",704639,0],["αὐτῷ",702165,50],["καὶ",707031,7],["ὁ",709436,3],["ἰὸς",706764,4],["οὐκ",709805,28],["ἐξῆλθεν",704909,2],["ἐξ",704132,0],["αὐτῆς",702165,86],["κατὰ",707200,0],["μέλος",708707,25],["αὐτῆς",702165,86],["ἐξήνεγκεν",704356,2],["οὐκ",709805,28],["ἔπεσεν",710481,2],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["κλῆρος",707727,4]],"Therefore thus saith the Lord; O bloody city, the caldron in which there is scum, and the scum has not gone out of, she has brought it forth piece by piece, no lot has fallen upon it."],["7",[["ὅτι",709803,7],["αἷμα",700442,25],["αὐτῆς",702165,86],["ἐν",704639,0],["μέσῳ",708768,30],["αὐτῆς",702165,86],["ἐστιν",704093,91],["ἐπὶ",705080,0],["λεωπετρίαν",708172,9],["τέταχα",712730,89],["αὐτό",702165,129],["οὐκ",709805,28],["ἐκκέχυκα",704368,89],["αὐτὸ",702165,129],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["τοῦ",709436,20],["καλύψαι",707102,106],["ἐπ᾿",705080,0],["αὐτὸ",702165,129],["γῆν",703083,9]],"For her blood is in the midst of her; I have set it upon a smooth rock: I have not poured it out upon the earth, so that the earth should cover it;"],["8",[["τοῦ",709436,20],["ἀναβῆναι",700905,106],["θυμὸν",706334,6],["εἰς",704105,0],["ἐκδίκησιν",704175,9],["ἐκδικηθῆναι",704174,179],["δέδωκα",703654,89],["τὸ",709436,24],["αἷμα",700442,25],["αὐτῆς",702165,86],["ἐπὶ",705080,0],["λεωπετρίαν",708172,9],["τοῦ",709436,20],["μὴ",708851,28],["καλύψαι",707102,106],["αὐτό",702165,129]],"that my wrath should come up for complete vengeance to be taken: I set her blood upon a smooth rock, so as not to cover it."],["9",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["κἀγὼ",706969,288],["μεγαλυνῶ",708647,165],["τὸν",709436,5],["δαλὸν",703268,6]],"Therefore thus saith the Lord, I will also make the firebrand great,"],["10",[["καὶ",707031,7],["πληθυνῶ",710530,165],["τὰ",709436,41],["ξύλα",709427,42],["καὶ",707031,7],["ἀνακαύσω",700966,165],["τὸ",709436,24],["πῦρ",711088,25],["ὅπως",709719,7],["τακῇ",712839,384,204],["τὰ",709436,41],["κρέα",707889,42],["καὶ",707031,7],["ἐλαττωθῇ",704394,384],["ὁ",709436,3],["ζωμὸς",705911,4]],"and I will multiply the wood, and kindle the fire, that the flesh may be consumed, and the liquor boiled away;"],["11",[["καὶ",707031,7],["στῇ",706846,172],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἄνθρακας",701160,57],["ὅπως",709719,7],["προσκαυθῇ",710911,384],["καὶ",707031,7],["θερμανθῇ",706213,384],["ὁ",709436,3],["χαλκὸς",713695,4],["αὐτῆς",702165,86],["καὶ",707031,7],["τακῇ",712839,384,204],["ἐν",704639,0],["μέσῳ",708768,30],["ἀκαθαρσίας",700507,17],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐκλίπῃ",704237,172],["ὁ",709436,3],["ἰὸς",706764,4],["αὐτῆς",702165,86]],"and that [it] may stand upon the coals, that her brass may be thoroughly heated, and be melted in the midst of her filthiness, and her scum may be consumed,"],["12",[["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἐξέλθῃ",704909,172],["ἐξ",704132,0],["αὐτῆς",702165,86],["πολὺς",710646,14],["ὁ",709436,3],["ἰὸς",706764,4],["αὐτῆς",702165,86],["καταισχυνθήσεται",707257,134],["ὁ",709436,3],["ἰὸς",706764,4],["αὐτῆς",702165,86]],"and her abundant scum may not come forth of her."],["13",[["ἀνθ᾿",701227,0],["ὧν",709781,252],["ἐμιαίνου",708900,497],["σύ",712181,164],["καὶ",707031,7],["τί",712867,126],["ἐὰν",703912,7],["μὴ",708851,28],["καθαρισθῇς",706985,279],["ἔτι",705538,28],["ἕως",705792,0],["οὗ",709781,48],["ἐμπλήσω",704592,165],["τὸν",709436,5],["θυμόν",706334,6],["μου",709032,133]],"Her scum shall become shameful, because thou didst defile thyself: and what if thou shalt be purged no more until I have accomplished my wrath?"],["14",[["ἐγὼ",704018,164],["κύριος",707996,4],["λελάληκα",708071,89],["καὶ",707031,7],["ἥξει",705956,127],["καὶ",707031,7],["ποιήσω",710582,165],["οὐ",709805,28],["διαστελῶ",703588,165],["οὐδὲ",709816,7],["μὴ",708851,28],["ἐλεήσω",704418,165],["κατὰ",707200,0],["τὰς",709436,38],["ὁδούς",709458,39],["σου",711945,133],["καὶ",707031,7],["κατὰ",707200,0],["τὰ",709436,41],["ἐνθυμήματά",704740,42],["σου",711945,133],["κρινῶ",707905,165],["σε",711598,163],["λέγει",708124,91],["κύριος",707996,4],["διὰ",703417,0],["τοῦτο",709858,129],["ἐγὼ",704018,164],["κρινῶ",707905,165],["σε",711598,163],["κατὰ",707200,0],["τὰ",709436,41],["αἵματά",700442,42],["σου",711945,133],["καὶ",707031,7],["κατὰ",707200,0],["τὰ",709436,41],["ἐνθυμήματά",704740,42],["σου",711945,133],["κρινῶ",707905,165],["σε",711598,163],["ἡ",709436,10],["ἀκάθαρτος",700508,29],["ἡ",709436,10],["ὀνομαστὴ",709669,29],["καὶ",707031,7],["πολλὴ",710646,29],["τοῦ",709436,20],["παραπικραίνειν",710087,55]],"I the Lord have spoken; and it shall come, and I will do [it]; I will not delay, neither will I have any mercy: I will judge thee, saith the Lord, according to thy ways, and according to thy devices: therefore will I judge thee according to thy bloodshed, and according to thy devices will I judge thee, thou unclean, notorious, and abundantly provoking one."],["15",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72]],"And the word of the Lord came to me, saying,"],["16",[["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["λαμβάνω",708076,157],["ἐκ",704132,0],["σοῦ",711945,133],["τὰ",709436,41],["ἐπιθυμήματα",705142,42],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["σου",711945,133],["ἐν",704639,0],["παρατάξει",710107,1],["οὐ",709805,28],["μὴ",708851,28],["κοπῇς",707829,279],["οὐδὲ",709816,7],["μὴ",708851,28],["κλαυσθῇς",707703,279]],"Son of man, behold I take from thee the desire of thine eyes by violence: thou shalt not lament, neither shalt thou weep."],["17",[["στεναγμὸς",712065,4],["αἵματος",700442,21],["ὀσφύος",709800,17],["πένθους",710253,21],["ἐστίν",704093,91],["οὐκ",709805,28],["ἔσται",704093,93],["τὸ",709436,34],["τρίχωμά",712972,15],["σου",711945,133],["συμπεπλεγμένον",712334,327],["ἐπὶ",705080,0],["σὲ",711598,163],["καὶ",707031,7],["τὰ",709436,63],["ὑποδήματά",713195,64],["σου",711945,133],["ἐν",704639,0],["τοῖς",709436,147],["ποσίν",710707,148],["σου",711945,133],["οὐ",709805,28],["μὴ",708851,28],["παρακληθῇς",710039,279],["ἐν",704639,0],["χείλεσιν",713781,96],["αὐτῶν",702165,40],["καὶ",707031,7],["ἄρτον",701829,6],["ἀνδρῶν",701150,81],["οὐ",709805,28],["μὴ",708851,28],["φάγῃς",713296,175]],"Thou shalt groan for blood, and have mourning upon thy loins; thy hair shall not be braided upon thee, and thy sandals [shall be] on thy feet; thou shalt in no wise be comforted by their lips, and thou shalt not eat the bread of men."],["18",[["καὶ",707031,7],["ἐλάλησα",708071,155],["πρὸς",710844,0],["τὸν",709436,5],["λαὸν",708094,6],["τὸ",709436,24],["πρωὶ",711021,28],["ὃν",709781,112],["τρόπον",712980,6],["ἐνετείλατό",704791,23],["μοι",708974,159],["καὶ",707031,7],["ἀπέθανεν",701461,2],["ἡ",709436,10],["γυνή",703209,12],["μου",709032,133],["ἑσπέρας",705500,17],["καὶ",707031,7],["ἐποίησα",710582,155],["τὸ",709436,24],["πρωὶ",711021,28],["ὃν",709781,112],["τρόπον",712980,6],["ἐπετάγη",705294,37],["μοι",708974,159]],"And I spoke to the people in the morning, as he commanded me in the evening, and I did in the morning as it was commanded me."],["19",[["καὶ",707031,7],["εἶπεν",705373,2],["πρός",710844,0],["με",708618,163],["ὁ",709436,3],["λαός",708094,4],["οὐκ",709805,28],["ἀναγγελεῖς",700921,166],["ἡμῖν",705994,90],["τί",712867,126],["ἐστιν",704093,91],["ταῦτα",709858,290],["ἃ",709781,69],["σὺ",712181,164],["ποιεῖς",710582,154]],"And the people said to me, Wilt thou not tell us what these things are that thou doest?"],["20",[["καὶ",707031,7],["εἶπα",705373,155],["πρὸς",710844,0],["αὐτούς",702165,62],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["ἐγένετο",703104,23],["λέγων",708124,72]],"Then I said to them, The word of the Lord came to me, saying,"],["21",[["εἰπὸν",705373,176],["πρὸς",710844,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["Ισραηλ",706839,18],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["βεβηλῶ",702614,157],["τὰ",709436,41],["ἅγιά",700159,68],["μου",709032,133],["φρύαγμα",713598,25],["ἰσχύος",706858,17],["ὑμῶν",713091,145],["ἐπιθυμήματα",705142,42],["ὀφθαλμῶν",709870,81],["ὑμῶν",713091,145],["καὶ",707031,7],["ὑπὲρ",713111,0],["ὧν",709781,252],["φείδονται",713406,269],["αἱ",709436,190],["ψυχαὶ",714070,191],["ὑμῶν",713091,145],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["ὑμῶν",713091,145],["καὶ",707031,7],["αἱ",709436,190],["θυγατέρες",706320,191],["ὑμῶν",713091,145],["οὓς",709781,298],["ἐγκατελίπετε",703967,265],["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["πεσοῦνται",710481,135]],"Say to the house of Israel, Thus saith the Lord; Behold, I [will] profane my sanctuary, the boast of your strength, the desire of your eyes, and for which your souls are concerned; and your sons and your daughters, whom ye have left, shall fall by the sword."],["22",[["καὶ",707031,7],["ποιήσετε",710582,337],["ὃν",709781,112],["τρόπον",712980,6],["πεποίηκα",710582,89],["ἀπὸ",701425,0],["στόματος",712125,21],["αὐτῶν",702165,40],["οὐ",709805,28],["παρακληθήσεσθε",710039,261],["καὶ",707031,7],["ἄρτον",701829,6],["ἀνδρῶν",701150,81],["οὐ",709805,28],["φάγεσθε",705495,124]],"And ye shall do as I have done: ye shall not be comforted at their mouth, and ye shall not eat the bread of men."],["23",[["καὶ",707031,7],["αἱ",709436,190],["κόμαι",707803,191],["ὑμῶν",713091,145],["ἐπὶ",705080,0],["τῆς",709436,16],["κεφαλῆς",707639,17],["ὑμῶν",713091,145],["καὶ",707031,7],["τὰ",709436,63],["ὑποδήματα",713195,64],["ὑμῶν",713091,145],["ἐν",704639,0],["τοῖς",709436,147],["ποσὶν",710707,148],["ὑμῶν",713091,145],["οὔτε",709857,7],["μὴ",708851,28],["κόψησθε",707829,142],["οὔτε",709857,7],["μὴ",708851,28],["κλαύσητε",707703,125],["καὶ",707031,7],["ἐντακήσεσθε",704795,124],["ἐν",704639,0],["ταῖς",709436,75],["ἀδικίαις",700271,76],["ὑμῶν",713091,145],["καὶ",707031,7],["παρακαλέσετε",710039,337],["ἕκαστος",704133,14],["τὸν",709436,5],["ἀδελφὸν",700249,6],["αὐτοῦ",702165,102]],"And your hair [shall be] upon your head, and your shoes on your feet: neither shall ye at all lament or weep; but ye shall pine away in your iniquities, and shall comfort every one his brother."],["24",[["καὶ",707031,7],["ἔσται",704093,93],["Ιεζεκιηλ",706539,4],["ὑμῖν",713084,90],["εἰς",704105,0],["τέρας",712793,25],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἐποίησεν",710582,2],["ποιήσετε",710582,337],["ὅταν",709801,28],["ἔλθῃ",705453,172],["ταῦτα",709858,290],["καὶ",707031,7],["ἐπιγνώσεσθε",705104,124],["διότι",703734,7],["ἐγὼ",704018,164],["κύριος",707996,4]],"And Jezekiel shall be for a sign to you: according to all that I have done shall ye do, when these things shall come; and ye shall know that I am the Lord."],["25",[["καὶ",707031,7],["σύ",712181,164],["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["οὐχὶ",709862,28],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ὅταν",709801,28],["λαμβάνω",708076,157],["τὴν",709436,8],["ἰσχὺν",706858,9],["παρ᾿",709995,0],["αὐτῶν",702165,40],["τὴν",709436,8],["ἔπαρσιν",705041,9],["τῆς",709436,16],["καυχήσεως",707571,17],["αὐτῶν",702165,40],["τὰ",709436,41],["ἐπιθυμήματα",705142,42],["ὀφθαλμῶν",709870,81],["αὐτῶν",702165,40],["καὶ",707031,7],["τὴν",709436,8],["ἔπαρσιν",705041,9],["ψυχῆς",714070,17],["αὐτῶν",702165,40],["υἱοὺς",713075,57],["αὐτῶν",702165,40],["καὶ",707031,7],["θυγατέρας",706320,39],["αὐτῶν",702165,40]],"And thou, son of man, [shall it] not [be] in the day when I take their strength from them, the pride of their boasting, the desires of their eyes, and the pride of their soul, their sons and their daughters,"],["26",[["ἐν",704639,0],["ἐκείνῃ",704183,105],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἥξει",705956,127],["ὁ",709436,3],["ἀνασῳζόμενος",701064,466],["πρὸς",710844,0],["σὲ",711598,163],["τοῦ",709436,20],["ἀναγγεῖλαί",700921,106],["σοι",711925,159],["εἰς",704105,0],["τὰ",709436,41],["ὦτα",709852,42]],"that in that day he that escapes shall come to thee, to tell [it] thee in thine ears?"],["27",[["ἐν",704639,0],["ἐκείνῃ",704183,105],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["διανοιχθήσεται",703532,134],["τὸ",709436,34],["στόμα",712125,15],["σου",711945,133],["πρὸς",710844,0],["τὸν",709436,5],["ἀνασῳζόμενον",701064,464],["καὶ",707031,7],["λαλήσεις",708071,166],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἀποκωφωθῇς",701502,279],["οὐκέτι",709827,28],["καὶ",707031,7],["ἔσῃ",704093,123],["αὐτοῖς",702165,151],["εἰς",704105,0],["τέρας",712793,25],["καὶ",707031,7],["ἐπιγνώσονται",705104,135],["διότι",703734,7],["ἐγὼ",704018,164],["κύριος",707996,4]],"In that day thy mouth shall be opened to him that escapes; thou shalt speak, and shalt be no longer dumb: and thou shalt be for a sign to them, and they shall know that I am the Lord."]]