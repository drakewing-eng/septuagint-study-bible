[["1",[["καὶ",707031,7],["σύ",712181,164],["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["λαβὲ",708076,176],["σεαυτῷ",711599,50],["ῥομφαίαν",711291,9],["ὀξεῖαν",709682,36],["ὑπὲρ",713111,0],["ξυρὸν",709433,25],["κουρέως",707860,18],["κτήσῃ",707932,420],["αὐτὴν",702165,104],["σεαυτῷ",711599,50],["καὶ",707031,7],["ἐπάξεις",704994,166],["αὐτὴν",702165,104],["ἐπὶ",705080,0],["τὴν",709436,8],["κεφαλήν",707639,9],["σου",711945,133],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸν",709436,5],["πώγωνά",711115,6],["σου",711945,133],["καὶ",707031,7],["λήμψῃ",708076,123],["ζυγὸν",705894,6],["σταθμίων",712039,44],["καὶ",707031,7],["διαστήσεις",703690,166],["αὐτούς",702165,62]],"And thou, son of man, take thee a sword sharper than a barber's razor; thou shalt procure it for thyself, and shalt bring it upon thine head, and upon thy beard: and thou shalt take a pair of scales, and shalt separate the hair."],["2",[["τὸ",709436,24],["τέταρτον",712811,46],["ἐν",704639,0],["πυρὶ",711088,54],["ἀνακαύσεις",700966,166],["ἐν",704639,0],["μέσῃ",708768,101],["τῇ",709436,100],["πόλει",710612,1],["κατὰ",707200,0],["τὴν",709436,8],["πλήρωσιν",710545,9],["τῶν",709436,130],["ἡμερῶν",705984,65],["τοῦ",709436,35],["συγκλεισμοῦ",712220,18],["καὶ",707031,7],["λήμψῃ",708076,123],["τὸ",709436,24],["τέταρτον",712811,46],["καὶ",707031,7],["κατακαύσεις",707258,166],["αὐτὸ",702165,129],["ἐν",704639,0],["μέσῳ",708768,97],["αὐτῆς",702165,86],["καὶ",707031,7],["τὸ",709436,24],["τέταρτον",712811,46],["κατακόψεις",707285,166],["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["κύκλῳ",707959,114],["αὐτῆς",702165,86],["καὶ",707031,7],["τὸ",709436,24],["τέταρτον",712811,46],["διασκορπίσεις",703579,166],["τῷ",709436,53],["πνεύματι",710566,54],["καὶ",707031,7],["μάχαιραν",708593,9],["ἐκκενώσω",704210,165],["ὀπίσω",709697,0],["αὐτῶν",702165,40]],"A fourth part thou shalt burn in the fire in the midst of the city, at the fulfilment of the days of the siege: and thou shalt take a fourth part, and burn it up in the midst of it: and a fourth part thou shalt cut with a sword round about it: and a fourth part thou shalt scatter to the wind; and I will draw out a sword after them."],["3",[["καὶ",707031,7],["λήμψῃ",708076,123],["ἐκεῖθεν",704182,28],["ὀλίγους",709568,60],["ἐν",704639,0],["ἀριθμῷ",701744,114],["καὶ",707031,7],["συμπεριλήμψῃ",712329,123],["αὐτοὺς",702165,62],["τῇ",709436,100],["ἀναβολῇ",700916,1],["σου",711945,133]],"And thou shalt take thence a few in number, and shalt wrap them in the fold of thy garment."],["4",[["καὶ",707031,7],["ἐκ",704132,0],["τούτων",709858,40],["λήμψῃ",708076,123],["ἔτι",705538,28],["καὶ",707031,7],["ῥίψεις",711267,166],["αὐτοὺς",702165,62],["εἰς",704105,0],["μέσον",708768,46],["τοῦ",709436,20],["πυρὸς",711088,21],["καὶ",707031,7],["κατακαύσεις",707258,166],["αὐτοὺς",702165,62],["ἐν",704639,0],["πυρί",711088,54],["ἐξ",704132,0],["αὐτῆς",702165,86],["ἐξελεύσεται",704909,93],["πῦρ",711088,25],["καὶ",707031,7],["ἐρεῖς",705415,166],["παντὶ",710177,30],["οἴκῳ",709516,114],["Ισραηλ",706839,18]],"And thou shalt take of these again, and cast them into the midst of the fire, and burn them up with fire: from thence shall come forth fire; and thou shalt say to the whole house of Israel,"],["5",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["αὕτη",709858,107],["ἡ",709436,10],["Ιερουσαλημ",706644,12],["ἐν",704639,0],["μέσῳ",708768,97],["τῶν",709436,43],["ἐθνῶν",704068,44],["τέθεικα",712849,89],["αὐτὴν",702165,104],["καὶ",707031,7],["τὰς",709436,38],["κύκλῳ",707959,114],["αὐτῆς",702165,86],["χώρας",714011,39]],"Thus saith the Lord; This is Jerusalem: I have set her and the countries round about her in the midst of the nations."],["6",[["καὶ",707031,7],["ἐρεῖς",705415,166],["τὰ",709436,41],["δικαιώματά",703697,42],["μου",709032,133],["τῇ",709436,100],["ἀνόμῳ",701194,101],["ἐκ",704132,0],["τῶν",709436,43],["ἐθνῶν",704068,44],["καὶ",707031,7],["τὰ",709436,41],["νόμιμά",709340,68],["μου",709032,133],["ἐκ",704132,0],["τῶν",709436,130],["χωρῶν",714011,65],["τῶν",709436,130],["κύκλῳ",707959,114],["αὐτῆς",702165,86],["διότι",703734,7],["τὰ",709436,41],["δικαιώματά",703697,42],["μου",709032,133],["ἀπώσαντο",701659,189],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["νομίμοις",709340,230],["μου",709032,133],["οὐκ",709805,28],["ἐπορεύθησαν",710667,99],["ἐν",704639,0],["αὐτοῖς",702165,151]],"And thou shalt declare mine ordinances to the lawless one from out of the nations; and my statutes [to the sinful one] of the countries round about her: because they have rejected mine ordinances, and have not walked in my statutes."],["7",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἀνθ᾿",701227,0],["ὧν",709781,252],["ἡ",709436,10],["ἀφορμὴ",702230,12],["ὑμῶν",713091,145],["ἐκ",704132,0],["τῶν",709436,43],["ἐθνῶν",704068,44],["τῶν",709436,43],["κύκλῳ",707959,114],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["νομίμοις",709340,230],["μου",709032,133],["οὐκ",709805,28],["ἐπορεύθητε",710667,472],["καὶ",707031,7],["τὰ",709436,41],["δικαιώματά",703697,42],["μου",709032,133],["οὐκ",709805,28],["ἐποιήσατε",710582,265],["ἀλλ᾿",700680,7],["οὐδὲ",709816,7],["κατὰ",707200,0],["τὰ",709436,41],["δικαιώματα",703697,42],["τῶν",709436,43],["ἐθνῶν",704068,44],["τῶν",709436,43],["κύκλῳ",707959,114],["ὑμῶν",713091,145],["οὐ",709805,28],["πεποιήκατε",710582,330]],"Therefore thus saith the Lord, Because your occasion [for sin has been taken] from the nations round about you, and ye have not walked in my statutes, nor kept mine ordinances, nay, ye have not even done according to the ordinances of the nations round about you; therefore thus saith the Lord;"],["8",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐπὶ",705080,0],["σὲ",711598,163],["καὶ",707031,7],["ποιήσω",710582,165],["ἐν",704639,0],["μέσῳ",708768,97],["σου",711945,133],["κρίμα",707903,25],["ἐνώπιον",704823,0],["τῶν",709436,43],["ἐθνῶν",704068,44]],"Behold, I am against thee, and I will execute judgment in the midst of thee in the sight of the nations."],["9",[["καὶ",707031,7],["ποιήσω",710582,165],["ἐν",704639,0],["σοὶ",711925,159],["ἃ",709781,69],["οὐ",709805,28],["πεποίηκα",710582,89],["καὶ",707031,7],["ἃ",709781,69],["οὐ",709805,28],["ποιήσω",710582,165],["ὅμοια",709626,68],["αὐτοῖς",702165,151],["ἔτι",705538,28],["κατὰ",707200,0],["πάντα",710177,68],["τὰ",709436,41],["βδελύγματά",702604,42],["σου",711945,133]],"And I will do in thee things which I have not done, and the like of which I will not do again, for all thine abominations."],["10",[["διὰ",703417,0],["τοῦτο",709858,129],["πατέρες",710189,52],["φάγονται",713296,135],["τέκνα",712761,42],["ἐν",704639,0],["μέσῳ",708768,97],["σου",711945,133],["καὶ",707031,7],["τέκνα",712761,64],["φάγονται",713296,135],["πατέρας",710189,57],["καὶ",707031,7],["ποιήσω",710582,165],["ἐν",704639,0],["σοὶ",711925,159],["κρίματα",707903,42],["καὶ",707031,7],["διασκορπιῶ",703579,165],["πάντας",710177,60],["τοὺς",709436,58],["καταλοίπους",707317,60],["σου",711945,133],["εἰς",704105,0],["πάντα",710177,27],["ἄνεμον",701123,6]],"Therefore the fathers shall eat [their] children in the midst of thee, and children shall eat [their] fathers; and I will execute judgments in thee, and I will scatter all that are left of thee to every wind."],["11",[["διὰ",703417,0],["τοῦτο",709858,129],["ζῶ",705851,157],["ἐγώ",704018,164],["λέγει",708124,91],["κύριος",707996,4],["εἰ",704071,7],["μὴ",708851,28],["ἀνθ᾿",701227,0],["ὧν",709781,252],["τὰ",709436,41],["ἅγιά",700159,68],["μου",709032,133],["ἐμίανας",708900,162],["ἐν",704639,0],["πᾶσιν",710177,94],["τοῖς",709436,95],["βδελύγμασίν",702604,96],["σου",711945,133],["κἀγὼ",706969,288],["ἀπώσομαί",701659,181],["σε",711598,163],["οὐ",709805,28],["φείσεταί",713406,93],["μου",709032,133],["ὁ",709436,3],["ὀφθαλμός",709870,4],["κἀγὼ",706969,288],["οὐκ",709805,28],["ἐλεήσω",704418,165]],"Therefore, [as] I live, saith the Lord; surely, because thou hast defiled my holy things with all thine abominations, I also will reject thee; mine eye shall not spare, and I will have no mercy."],["12",[["τὸ",709436,24],["τέταρτόν",712811,46],["σου",711945,133],["ἐν",704639,0],["θανάτῳ",706096,114],["ἀναλωθήσεται",700992,134],["καὶ",707031,7],["τὸ",709436,24],["τέταρτόν",712811,46],["σου",711945,133],["ἐν",704639,0],["λιμῷ",708210,114],["συντελεσθήσεται",712510,134],["ἐν",704639,0],["μέσῳ",708768,97],["σου",711945,133],["καὶ",707031,7],["τὸ",709436,24],["τέταρτόν",712811,46],["σου",711945,133],["εἰς",704105,0],["πάντα",710177,27],["ἄνεμον",701123,6],["σκορπιῶ",711881,165],["αὐτούς",702165,62],["καὶ",707031,7],["τὸ",709436,34],["τέταρτόν",712811,26],["σου",711945,133],["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["πεσοῦνται",710481,135],["κύκλῳ",707959,114],["σου",711945,133],["καὶ",707031,7],["μάχαιραν",708593,9],["ἐκκενώσω",704210,165],["ὀπίσω",709697,0],["αὐτῶν",702165,40]],"A fourth part of thee shall be cut off by pestilence, and a fourth part of thee shall be consumed in the midst of thee with famine: and [as for another] fourth part of thee, I will scatter them to every wind; and a fourth part of thee shall fall by the sword round about thee, and I will draw out a sword after them."],["13",[["καὶ",707031,7],["συντελεσθήσεται",712510,134],["ὁ",709436,3],["θυμός",706334,4],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["ὀργή",709728,12],["μου",709032,133],["ἐπ᾿",705080,0],["αὐτούς",702165,62],["καὶ",707031,7],["ἐπιγνώσῃ",705104,123],["διότι",703734,7],["ἐγὼ",704018,164],["κύριος",707996,4],["λελάληκα",708071,89],["ἐν",704639,0],["ζήλῳ",705871,114],["μου",709032,133],["ἐν",704639,0],["τῷ",709436,53],["συντελέσαι",712510,106],["με",708618,163],["τὴν",709436,8],["ὀργήν",709728,9],["μου",709032,133],["ἐπ᾿",705080,0],["αὐτούς",702165,62]],"And my wrath and mine anger shall be accomplished upon them: and thou shalt know that I the Lord have spoken in my jealousy, when I have accomplished mine anger upon them."],["14",[["καὶ",707031,7],["θήσομαί",712849,181],["σε",711598,163],["εἰς",704105,0],["ἔρημον",705420,9],["καὶ",707031,7],["τὰς",709436,38],["θυγατέρας",706320,39],["σου",711945,133],["κύκλῳ",707959,114],["σου",711945,133],["ἐνώπιον",704823,0],["παντὸς",710177,116],["διοδεύοντος",703715,152]],"And I will make thee desolate, and thy daughters round about thee, in the sight of every one that passes through."],["15",[["καὶ",707031,7],["ἔσῃ",704093,123],["στενακτὴ",712067,29],["καὶ",707031,7],["δηλαϊστὴ",703398,29],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["τοῖς",709436,95],["κύκλῳ",707959,114],["σου",711945,133],["ἐν",704639,0],["τῷ",709436,53],["ποιῆσαί",710582,106],["με",708618,163],["ἐν",704639,0],["σοὶ",711925,159],["κρίματα",707903,42],["ἐν",704639,0],["ἐκδικήσει",704175,1],["θυμοῦ",706334,18],["μου",709032,133],["ἐγὼ",704018,164],["κύριος",707996,4],["λελάληκα",708071,89]],"And thou shalt be mourned over and miserable among the nations round about thee, when I have executed judgments in thee in the vengeance of my wrath. I the Lord have spoken."],["16",[["ἐν",704639,0],["τῷ",709436,53],["ἐξαποστεῖλαί",704872,106],["με",708618,163],["τὰς",709436,38],["βολίδας",702756,39],["μου",709032,133],["τοῦ",709436,35],["λιμοῦ",708210,18],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἔσονται",704093,135],["εἰς",704105,0],["ἔκλειψιν",704239,9],["καὶ",707031,7],["συντρίψω",712520,165],["στήριγμα",712097,25],["ἄρτου",701829,18],["σου",711945,133]],"And when I have sent against them shafts of famine, then they shall be consumed, and I will break the strength of thy bread."],["17",[["καὶ",707031,7],["ἐξαποστελῶ",704872,165],["ἐπὶ",705080,0],["σὲ",711598,163],["λιμὸν",708210,6],["καὶ",707031,7],["θηρία",706252,42],["πονηρὰ",710660,68],["καὶ",707031,7],["τιμωρήσομαί",712861,181],["σε",711598,163],["καὶ",707031,7],["θάνατος",706096,4],["καὶ",707031,7],["αἷμα",700442,15],["διελεύσονται",703673,135],["ἐπὶ",705080,0],["σέ",711598,163],["καὶ",707031,7],["ῥομφαίαν",711291,9],["ἐπάξω",704994,165],["ἐπὶ",705080,0],["σὲ",711598,163],["κυκλόθεν",707956,28],["ἐγὼ",704018,164],["κύριος",707996,4],["λελάληκα",708071,89]],"So I will send forth against thee famine and evil beasts, and I will take vengeance upon thee; and pestilence and blood shall pass through upon thee; and I will bring a sword upon thee round about. I the Lord have spoken."]]