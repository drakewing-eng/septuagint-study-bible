[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72]],"And the word of the Lord came to me, saying,"],["2",[["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["ἐπίστρεψον",705278,176],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["ἐπ᾿",705080,0],["ὄρος",709768,25],["Σηιρ",711734,118],["καὶ",707031,7],["προφήτευσον",711008,176],["ἐπ᾿",705080,0],["αὐτὸ",702165,129]],"Son of man, set thy face against mount Seir, and prophesy against it,"],["3",[["καὶ",707031,7],["εἰπόν",705373,176],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐπὶ",705080,0],["σέ",711598,163],["ὄρος",709768,25],["Σηιρ",711734,118],["καὶ",707031,7],["ἐκτενῶ",704322,165],["τὴν",709436,8],["χεῖρά",713787,9],["μου",709032,133],["ἐπὶ",705080,0],["σὲ",711598,163],["καὶ",707031,7],["δώσω",703654,165],["σε",711598,163],["ἔρημον",705420,36],["καὶ",707031,7],["ἐρημωθήσῃ",705421,364]],"and say to it, Thus saith the Lord God; Behold, I am against thee, O mount Seir, and I will stretch out my hand against thee, and will make thee a waste, and thou shalt be made desolate."],["4",[["καὶ",707031,7],["ταῖς",709436,75],["πόλεσίν",710612,76],["σου",711945,133],["ἐρημίαν",705417,9],["ποιήσω",710582,165],["καὶ",707031,7],["σὺ",712181,164],["ἔρημος",705420,12],["ἔσῃ",704093,123],["καὶ",707031,7],["γνώσῃ",703105,123],["ὅτι",709803,7],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4]],"And I will cause desolation in thy cities, and thou shalt be desolate, and thou shalt know that I am the Lord."],["5",[["ἀντὶ",701227,0],["τοῦ",709436,20],["γενέσθαι",703104,109],["σε",711598,163],["ἐχθρὰν",705775,9],["αἰωνίαν",700505,36],["καὶ",707031,7],["ἐνεκάθισας",703953,162],["τῷ",709436,113],["οἴκῳ",709516,114],["Ισραηλ",706839,18],["δόλῳ",703787,114],["ἐν",704639,0],["χειρὶ",713787,1],["ἐχθρῶν",705779,81],["μαχαίρᾳ",708593,1],["ἐν",704639,0],["καιρῷ",707047,114],["ἀδικίας",700271,17],["ἐπ᾿",705080,0],["ἐσχάτῳ",705519,30]],"Because thou hast been a perpetual enemy, and hast laid wait craftily for the house of Israel, with the hand of enemies with a sword, in the time of injustice, at the last:"],["6",[["διὰ",703417,0],["τοῦτο",709858,129],["ζῶ",705851,157],["ἐγώ",704018,164],["λέγει",708124,91],["κύριος",707996,4],["κύριος",707996,4],["εἰ",704071,7],["μὴν",708873,11],["εἰς",704105,0],["αἷμα",700442,25],["ἥμαρτες",700773,162],["καὶ",707031,7],["αἷμά",700442,25],["σε",711598,163],["διώξεται",703768,93]],"Therefore, as I live, saith the Lord God, verily thou hast sinned even to blood, therefore blood shall pursue thee."],["7",[["καὶ",707031,7],["δώσω",703654,165],["τὸ",709436,24],["ὄρος",709768,25],["Σηιρ",711734,118],["εἰς",704105,0],["ἔρημον",705420,9],["καὶ",707031,7],["ἠρημωμένον",705421,448],["καὶ",707031,7],["ἀπολῶ",701513,165],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["ἀνθρώπους",701163,57],["καὶ",707031,7],["κτήνη",707934,42]],"And I will make mount Seir a waste, and desolate, and I will destroy from off it men and cattle:"],["8",[["καὶ",707031,7],["ἐμπλήσω",704592,165],["τῶν",709436,80],["τραυματιῶν",712921,81],["σου",711945,133],["τοὺς",709436,58],["βουνοὺς",702797,57],["καὶ",707031,7],["τὰς",709436,38],["φάραγγάς",713351,39],["σου",711945,133],["καὶ",707031,7],["ἐν",704639,0],["πᾶσι",710177,94],["τοῖς",709436,95],["πεδίοις",710215,96],["σου",711945,133],["τετραυματισμένοι",712922,362],["μαχαίρᾳ",708593,1],["πεσοῦνται",710481,135],["ἐν",704639,0],["σοί",711925,159]],"and I will fill thy hills and thy valleys with slain men, and in all thy plains there shall fall in thee men slain with the sword."],["9",[["ἐρημίαν",705417,9],["αἰώνιον",700505,36],["θήσομαί",712849,181],["σε",711598,163],["καὶ",707031,7],["αἱ",709436,190],["πόλεις",710612,191],["σου",711945,133],["οὐ",709805,28],["μὴ",708851,28],["κατοικηθῶσιν",707534,272],["ἔτι",705538,28],["καὶ",707031,7],["γνώσῃ",703105,123],["ὅτι",709803,7],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4]],"I will make thee a perpetual desolation, and thy cities shall not be inhabited any more: and thou shalt know that I am the Lord."],["10",[["διὰ",703417,0],["τὸ",709436,24],["εἰπεῖν",705373,106],["σε",711598,163],["τὰ",709436,41],["δύο",703849,59],["ἔθνη",704068,42],["καὶ",707031,7],["αἱ",709436,190],["δύο",703849,59],["χῶραι",714011,191],["ἐμαὶ",704578,192],["ἔσονται",704093,135],["καὶ",707031,7],["κληρονομήσω",707724,165],["αὐτάς",702165,231],["καὶ",707031,7],["κύριος",707996,4],["ἐκεῖ",704181,28],["ἐστιν",704093,91]],"Because thou saidst, The two nations and the two countries shall be mine, and I shall inherit them; whereas the Lord is there:"],["11",[["διὰ",703417,0],["τοῦτο",709858,129],["ζῶ",705851,157],["ἐγώ",704018,164],["λέγει",708124,91],["κύριος",707996,4],["καὶ",707031,7],["ποιήσω",710582,165],["σοι",711925,159],["κατὰ",707200,0],["τὴν",709436,8],["ἔχθραν",705775,9],["σου",711945,133],["καὶ",707031,7],["γνωσθήσομαί",703105,180],["σοι",711925,159],["ἡνίκα",706008,28],["ἂν",700900,11],["κρίνω",707905,207],["σε",711598,163]],"therefore, [as] I live, saith the Lord, I will even deal with thee according to thine enmity, and I will be made known to thee when I shall judge thee:"],["12",[["καὶ",707031,7],["γνώσῃ",703105,123],["ὅτι",709803,7],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["ἤκουσα",700587,155],["τῆς",709436,16],["φωνῆς",713640,17],["τῶν",709436,130],["βλασφημιῶν",702738,65],["σου",711945,133],["ὅτι",709803,7],["εἶπας",705373,162],["τὰ",709436,63],["ὄρη",709768,64],["Ισραηλ",706839,18],["ἔρημα",705420,195],["ἡμῖν",705994,90],["δέδοται",703654,187],["εἰς",704105,0],["κατάβρωμα",707217,25]],"and thou shalt know that I am the Lord. I have heard the voice of thy blasphemies, whereas thou hast said, The desert mountains of Israel are given to us for food;"],["13",[["καὶ",707031,7],["ἐμεγαλορημόνησας",708636,162],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["τῷ",709436,53],["στόματί",712125,54],["σου",711945,133],["ἐγὼ",704018,164],["ἤκουσα",700587,155]],"and thou hast spoken swelling words against me with thy mouth: I have heard [them]."],["14",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἐν",704639,0],["τῇ",709436,100],["εὐφροσύνῃ",705717,1],["πάσης",710177,82],["τῆς",709436,16],["γῆς",703083,17],["ἔρημον",705420,36],["ποιήσω",710582,165],["σε",711598,163]],"Thus saith the Lord; When all the earth is rejoicing, I will make thee desert."],["15",[["ἔρημον",705420,26],["ἔσῃ",704093,123],["ὄρος",709768,15],["Σηιρ",711734,118],["καὶ",707031,7],["πᾶσα",710177,29],["ἡ",709436,10],["Ιδουμαία",706503,12],["ἐξαναλωθήσεται",704861,134],["καὶ",707031,7],["γνώσῃ",703105,123],["ὅτι",709803,7],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["αὐτῶν",702165,40]],"Thou shalt be desert, O mount Seir, and all Idumea; and it shall be utterly consumed: and thou shalt know that I am the Lord their God."]]