[["1",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["θεός",706192,4],["πύλη",711082,12],["ἡ",709436,10],["ἐν",704639,0],["τῇ",709436,100],["αὐλῇ",702137,1],["τῇ",709436,100],["ἐσωτέρᾳ",705525,101],["ἡ",709436,10],["βλέπουσα",702740,188],["πρὸς",710844,0],["ἀνατολὰς",701071,39],["ἔσται",704093,93],["κεκλεισμένη",707710,451],["ἓξ",704828,59],["ἡμέρας",705984,39],["τὰς",709436,38],["ἐνεργούς",704719,119],["ἐν",704639,0],["δὲ",703303,11],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῶν",709436,43],["σαββάτων",711350,44],["ἀνοιχθήσεται",701186,134],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῆς",709436,16],["νουμηνίας",709371,17],["ἀνοιχθήσεται",701186,134]],"Thus saith the Lord God; The gate that is in the inner court, that looks eastward, shall be shut the six working days; [but] let it be opened on the sabbath-day, and it shall be opened on the day of the new moon."],["2",[["καὶ",707031,7],["εἰσελεύσεται",704114,93],["ὁ",709436,3],["ἀφηγούμενος",702203,122],["κατὰ",707200,0],["τὴν",709436,8],["ὁδὸν",709458,9],["τοῦ",709436,20],["αιλαμ",700431,21],["τῆς",709436,16],["πύλης",711082,17],["τῆς",709436,16],["ἔξωθεν",704984,28],["καὶ",707031,7],["στήσεται",706846,93],["ἐπὶ",705080,0],["τὰ",709436,41],["πρόθυρα",710801,42],["τῆς",709436,16],["πύλης",711082,17],["καὶ",707031,7],["ποιήσουσιν",710582,218],["οἱ",709436,136],["ἱερεῖς",706614,52],["τὰ",709436,41],["ὁλοκαυτώματα",709589,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["τοῦ",709436,20],["σωτηρίου",712659,21],["αὐτοῦ",702165,102],["καὶ",707031,7],["προσκυνήσει",710925,127],["ἐπὶ",705080,0],["τοῦ",709436,20],["προθύρου",710801,21],["τῆς",709436,16],["πύλης",711082,17],["καὶ",707031,7],["ἐξελεύσεται",704909,93],["καὶ",707031,7],["ἡ",709436,10],["πύλη",711082,12],["οὐ",709805,28],["μὴ",708851,28],["κλεισθῇ",707710,384],["ἕως",705792,0],["ἑσπέρας",705500,17]],"And the prince shall enter by the way of the porch of the inner gate, and shall stand at the entrance of the gate, and the priests shall prepare his whole-burnt-offerings and his peace-offerings, and he shall worship at the entrance of the gate: then shall he come forth; but the gate shall not be shut till evening."],["3",[["καὶ",707031,7],["προσκυνήσει",710925,127],["ὁ",709436,3],["λαὸς",708094,4],["τῆς",709436,16],["γῆς",703083,17],["κατὰ",707200,0],["τὰ",709436,41],["πρόθυρα",710801,42],["τῆς",709436,16],["πύλης",711082,17],["ἐκείνης",704183,86],["ἐν",704639,0],["τοῖς",709436,95],["σαββάτοις",711350,96],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["νουμηνίαις",709371,76],["ἐναντίον",704654,0],["κυρίου",707996,18]],"And the people of the land shall worship at the entrance of that gate, both on the sabbaths and at the new moons, before the Lord."],["4",[["καὶ",707031,7],["τὰ",709436,41],["ὁλοκαυτώματα",709589,42],["προσοίσει",710974,127],["ὁ",709436,3],["ἀφηγούμενος",702203,122],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῶν",709436,43],["σαββάτων",711350,44],["ἓξ",704828,59],["ἀμνοὺς",700855,57],["ἀμώμους",700895,60],["καὶ",707031,7],["κριὸν",707906,6],["ἄμωμον",700895,27]],"And the prince shall offer whole-burnt-offerings to the Lord on the sabbath-day, six lambs without blemish, and a ram without blemish;"],["5",[["καὶ",707031,7],["μαναα",708463,25],["πέμμα",710244,25],["τῷ",709436,113],["κριῷ",707906,114],["καὶ",707031,7],["τοῖς",709436,147],["ἀμνοῖς",700855,148],["θυσίαν",706345,9],["δόμα",703789,25],["χειρὸς",713787,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐλαίου",704380,21],["τὸ",709436,24],["ιν",706746,25],["τῷ",709436,53],["πέμματι",710244,54]],"and a freewill-offering, a meat-offering for the ram, and a meat-offering for the lambs, the gift of his hand, and a hin of oil for the meat-offering."],["6",[["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῆς",709436,16],["νουμηνίας",709371,17],["μόσχον",709029,6],["ἄμωμον",700895,27],["καὶ",707031,7],["ἓξ",704828,59],["ἀμνούς",700855,57],["καὶ",707031,7],["κριὸς",707906,4],["ἄμωμος",700895,14],["ἔσται",704093,93]],"And on the day of the new moon a calf without blemish, and six lambs, and there shall be a ram without blemish;"],["7",[["καὶ",707031,7],["πέμμα",710244,15],["τῷ",709436,113],["κριῷ",707906,114],["καὶ",707031,7],["πέμμα",710244,15],["τῷ",709436,113],["μόσχῳ",709029,114],["ἔσται",704093,93],["μαναα",708463,15],["καὶ",707031,7],["τοῖς",709436,147],["ἀμνοῖς",700855,148],["καθὼς",707030,28],["ἐὰν",703912,7],["ἐκποιῇ",704289,204],["ἡ",709436,10],["χεὶρ",713787,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐλαίου",704380,21],["τὸ",709436,24],["ιν",706746,25],["τῷ",709436,53],["πέμματι",710244,54]],"and a meat-offering for the ram, and there shall be a meat-offering for the calf as a freewill-offering, and for the lambs, according as his hand can furnish, and [there shall be] a hin of oil for the cake."],["8",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["εἰσπορεύεσθαι",704124,110],["τὸν",709436,5],["ἀφηγούμενον",702203,212],["κατὰ",707200,0],["τὴν",709436,8],["ὁδὸν",709458,9],["τοῦ",709436,20],["αιλαμ",700431,21],["τῆς",709436,16],["πύλης",711082,17],["εἰσελεύσεται",704114,93],["καὶ",707031,7],["κατὰ",707200,0],["τὴν",709436,8],["ὁδὸν",709458,9],["τῆς",709436,16],["πύλης",711082,17],["ἐξελεύσεται",704909,93]],"And when the prince goes in, he shall go in by the way of the porch of the gate, and he shall go forth by the way of the gate."],["9",[["καὶ",707031,7],["ὅταν",709801,28],["εἰσπορεύηται",704124,428],["ὁ",709436,3],["λαὸς",708094,4],["τῆς",709436,16],["γῆς",703083,17],["ἐναντίον",704654,0],["κυρίου",707996,18],["ἐν",704639,0],["ταῖς",709436,75],["ἑορταῖς",704990,76],["ὁ",709436,3],["εἰσπορευόμενος",704124,122],["κατὰ",707200,0],["τὴν",709436,8],["ὁδὸν",709458,9],["τῆς",709436,16],["πύλης",711082,17],["τῆς",709436,16],["πρὸς",710844,0],["βορρᾶν",702765,6],["προσκυνεῖν",710925,55],["ἐξελεύσεται",704909,93],["κατὰ",707200,0],["τὴν",709436,8],["ὁδὸν",709458,9],["τῆς",709436,16],["πύλης",711082,17],["τῆς",709436,16],["πρὸς",710844,0],["νότον",709364,6],["καὶ",707031,7],["ὁ",709436,3],["εἰσπορευόμενος",704124,122],["κατὰ",707200,0],["τὴν",709436,8],["ὁδὸν",709458,9],["τῆς",709436,16],["πύλης",711082,17],["τῆς",709436,16],["πρὸς",710844,0],["νότον",709364,6],["ἐξελεύσεται",704909,93],["κατὰ",707200,0],["τὴν",709436,8],["ὁδὸν",709458,9],["τῆς",709436,16],["πύλης",711082,17],["τῆς",709436,16],["πρὸς",710844,0],["βορρᾶν",702765,6],["οὐκ",709805,28],["ἀναστρέψει",701060,127],["κατὰ",707200,0],["τὴν",709436,8],["πύλην",711082,9],["ἣν",709781,131],["εἰσελήλυθεν",704114,171],["ἀλλ᾿",700680,7],["ἢ",705924,7],["κατ᾿",707200,0],["εὐθὺ",705602,46],["αὐτῆς",702165,86],["ἐξελεύσεται",704909,93]],"And whenever the people of the land shall go in before the Lord at the feasts, he that goes in by the way of the north gate to worship shall go forth by the way of the south gate; and he that goes in by the way of the south gate shall go forth by the way of the north gate: he shall not return by the gate by which he entered, but he shall go forth opposite it."],["10",[["καὶ",707031,7],["ὁ",709436,3],["ἀφηγούμενος",702203,122],["ἐν",704639,0],["μέσῳ",708768,30],["αὐτῶν",702165,40],["ἐν",704639,0],["τῷ",709436,53],["εἰσπορεύεσθαι",704124,110],["αὐτοὺς",702165,62],["εἰσελεύσεται",704114,93],["μετ᾿",708780,0],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἐκπορεύεσθαι",704293,110],["αὐτοὺς",702165,62],["ἐξελεύσεται",704909,93]],"And the prince shall enter with them in the midst of them when they go in; and when they go forth, he shall go forth."],["11",[["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἑορταῖς",704990,76],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["πανηγύρεσιν",709963,76],["ἔσται",704093,93],["τὸ",709436,24],["μαναα",708463,25],["πέμμα",710244,25],["τῷ",709436,113],["μόσχῳ",709029,114],["καὶ",707031,7],["πέμμα",710244,25],["τῷ",709436,113],["κριῷ",707906,114],["καὶ",707031,7],["τοῖς",709436,147],["ἀμνοῖς",700855,148],["καθὼς",707030,28],["ἂν",700900,11],["ἐκποιῇ",704289,204],["ἡ",709436,10],["χεὶρ",713787,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐλαίου",704380,21],["τὸ",709436,24],["ιν",706746,25],["τῷ",709436,53],["πέμματι",710244,54]],"And in the feasts and in the general assemblies the freewill oblation shall be a meat-offering for the calf, and a meat-offering for the ram, and for the lambs, as his hand can furnish, and a hin of oil for the meat-offering."],["12",[["ἐὰν",703912,7],["δὲ",703303,11],["ποιήσῃ",710582,172],["ὁ",709436,3],["ἀφηγούμενος",702203,122],["ὁμολογίαν",709633,9],["ὁλοκαύτωμα",709589,25],["σωτηρίου",712659,21],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["ἀνοίξει",701186,127],["ἑαυτῷ",703917,50],["τὴν",709436,8],["πύλην",711082,9],["τὴν",709436,8],["βλέπουσαν",702740,78],["κατ᾿",707200,0],["ἀνατολὰς",701071,39],["καὶ",707031,7],["ποιήσει",710582,127],["τὸ",709436,24],["ὁλοκαύτωμα",709589,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["τοῦ",709436,20],["σωτηρίου",712659,21],["αὐτοῦ",702165,102],["ὃν",709781,112],["τρόπον",712980,6],["ποιεῖ",710582,91],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῶν",709436,43],["σαββάτων",711350,44],["καὶ",707031,7],["ἐξελεύσεται",704909,93],["καὶ",707031,7],["κλείσει",707710,127],["τὰς",709436,38],["θύρας",706337,39],["μετὰ",708780,0],["τὸ",709436,24],["ἐξελθεῖν",704909,106],["αὐτόν",702165,85]],"And if the prince should prepare [as] a thanksgiving a whole-burnt-peace-offering to the Lord, and should open for himself the gate looking eastward, and offer his whole-burnt-offering, and his peace-offerings, as he does on the sabbath-day; then shall he go out, and shall shut the doors after he has gone out."],["13",[["καὶ",707031,7],["ἀμνὸν",700855,6],["ἐνιαύσιον",704744,27],["ἄμωμον",700895,27],["ποιήσει",710582,127],["εἰς",704105,0],["ὁλοκαύτωμα",709589,25],["καθ᾿",707200,0],["ἡμέραν",705984,9],["τῷ",709436,113],["κυρίῳ",707996,114],["πρωὶ",711021,28],["ποιήσει",710582,127],["αὐτόν",702165,85]],"And he shall prepare daily as a whole-burnt-offering to the Lord a lamb of a year old without blemish: in the morning shall he prepare it."],["14",[["καὶ",707031,7],["μαναα",708463,25],["ποιήσει",710582,127],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["τὸ",709436,24],["πρωὶ",711021,28],["ἕκτον",704340,46],["τοῦ",709436,20],["μέτρου",708846,21],["καὶ",707031,7],["ἐλαίου",704380,21],["τὸ",709436,24],["τρίτον",712968,46],["τοῦ",709436,20],["ιν",706746,21],["τοῦ",709436,20],["ἀναμεῖξαι",701001,106],["τὴν",709436,8],["σεμίδαλιν",711675,9],["μαναα",708463,21],["τῷ",709436,113],["κυρίῳ",707996,114],["πρόσταγμα",710959,25],["διὰ",703417,0],["παντός",710177,116]],"And he shall prepare a freewill-offering for it in the morning, the sixth part of a measure [of flour], and a third part of a hin of oil to mix [therewith] the fine flour, [as] a freewill-offering to the Lord, a perpetual ordinance."],["15",[["ποιήσετε",710582,337],["τὸν",709436,5],["ἀμνὸν",700855,6],["καὶ",707031,7],["τὸ",709436,24],["μαναα",708463,25],["καὶ",707031,7],["τὸ",709436,24],["ἔλαιον",704380,25],["ποιήσετε",710582,337],["τὸ",709436,24],["πρωὶ",711021,28],["ὁλοκαύτωμα",709589,25],["διὰ",703417,0],["παντός",710177,116]],"Ye shall prepare the lamb, and the freewill-offering, and the oil in the morning, [for] a perpetual whole-burnt-sacrifice."],["16",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["θεός",706192,4],["ἐὰν",703912,7],["δῷ",703654,172],["ὁ",709436,3],["ἀφηγούμενος",702203,122],["δόμα",703789,25],["ἑνὶ",704106,30],["ἐκ",704132,0],["τῶν",709436,80],["υἱῶν",713075,81],["αὐτοῦ",702165,102],["ἐκ",704132,0],["τῆς",709436,16],["κληρονομίας",707725,17],["αὐτοῦ",702165,102],["τοῦτο",709858,132],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτοῦ",702165,102],["ἔσται",704093,93],["κατάσχεσις",707451,12],["ἐν",704639,0],["κληρονομίᾳ",707725,1]],"Thus saith the Lord God; If the prince shall give a gift to one of his sons out of his inheritance, this shall be to his sons a possession [as] an inheritance."],["17",[["ἐὰν",703912,7],["δὲ",703303,11],["δῷ",703654,172],["δόμα",703789,25],["ἑνὶ",704106,30],["τῶν",709436,80],["παίδων",709932,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔσται",704093,93],["αὐτῷ",702165,50],["ἕως",705792,0],["τοῦ",709436,20],["ἔτους",705543,21],["τῆς",709436,16],["ἀφέσεως",702199,17],["καὶ",707031,7],["ἀποδώσει",701449,127],["τῷ",709436,113],["ἀφηγουμένῳ",702203,241],["πλὴν",710540,28],["τῆς",709436,16],["κληρονομίας",707725,17],["τῶν",709436,80],["υἱῶν",713075,81],["αὐτοῦ",702165,102],["αὐτοῖς",702165,151],["ἔσται",704093,93]],"But if he give a gift to one of his servants, then it shall belong to him until the year of release; and [then] he shall restore [it] to the prince: but of the inheritance of his sons [the possession] shall continue to them."],["18",[["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["λάβῃ",708076,172],["ὁ",709436,3],["ἀφηγούμενος",702203,122],["ἐκ",704132,0],["τῆς",709436,16],["κληρονομίας",707725,17],["τοῦ",709436,35],["λαοῦ",708094,18],["καταδυναστεῦσαι",707248,106],["αὐτούς",702165,62],["ἐκ",704132,0],["τῆς",709436,16],["κατασχέσεως",707451,17],["αὐτοῦ",702165,102],["κατακληρονομήσει",707274,127],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτοῦ",702165,102],["ὅπως",709719,7],["μὴ",708851,28],["διασκορπίζηται",703579,462],["ὁ",709436,3],["λαός",708094,4],["μου",709032,133],["ἕκαστος",704133,14],["ἐκ",704132,0],["τῆς",709436,16],["κατασχέσεως",707451,17],["αὐτοῦ",702165,102]],"And the prince shall by no means take of the inheritance of the people, to oppress them: he shall give an inheritance to his sons out of his [own] possession: that my people be not scattered, every one from his possession."],["19",[["καὶ",707031,7],["εἰσήγαγέν",704107,2],["με",708618,163],["εἰς",704105,0],["τὴν",709436,8],["εἴσοδον",704119,9],["τῆς",709436,16],["κατὰ",707200,0],["νώτου",709403,21],["τῆς",709436,16],["πύλης",711082,17],["εἰς",704105,0],["τὴν",709436,8],["ἐξέδραν",704891,9],["τῶν",709436,43],["ἁγίων",700159,83],["τῶν",709