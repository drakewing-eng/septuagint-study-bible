[["1",[["καὶ",707031,7],["εἶπεν",705373,2],["πρός",710844,0],["με",708618,163],["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["κατάφαγε",707519,176],["τὴν",709436,8],["κεφαλίδα",707640,9],["ταύτην",709858,104],["καὶ",707031,7],["πορεύθητι",710667,244],["καὶ",707031,7],["λάλησον",708071,176],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18]],"And he said to me, Son of man, eat this volume, and go and speak to the children of Israel."],["2",[["καὶ",707031,7],["διήνοιξα",703532,155],["τὸ",709436,24],["στόμα",712125,25],["μου",709032,133],["καὶ",707031,7],["ἐψώμισέν",714077,2],["με",708618,163],["τὴν",709436,8],["κεφαλίδα",707640,9]],"So he opened my mouth, and caused me to eat the volume. And he said to me, Son of man,"],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["πρός",710844,0],["με",708618,163],["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["τὸ",709436,34],["στόμα",712125,15],["σου",711945,133],["φάγεται",713296,93],["καὶ",707031,7],["ἡ",709436,10],["κοιλία",707761,12],["σου",711945,133],["πλησθήσεται",710532,134],["τῆς",709436,16],["κεφαλίδος",707640,17],["ταύτης",709858,86],["τῆς",709436,16],["δεδομένης",703654,446],["εἰς",704105,0],["σέ",711598,163],["καὶ",707031,7],["ἔφαγον",713296,155],["αὐτήν",702165,104],["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["τῷ",709436,53],["στόματί",712125,54],["μου",709032,133],["ὡς",714148,7],["μέλι",708700,15],["γλυκάζον",703109,32]],"thy mouth shall eat, and thy belly shall be filled with this volume that is given to thee. So I ate it; and it was in my mouth as sweet honey."],["4",[["καὶ",707031,7],["εἶπεν",705373,2],["πρός",710844,0],["με",708618,163],["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["βάδιζε",702367,240],["εἴσελθε",704114,176],["πρὸς",710844,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["Ισραηλ",706839,18],["καὶ",707031,7],["λάλησον",708071,176],["τοὺς",709436,58],["λόγους",708236,57],["μου",709032,133],["πρὸς",710844,0],["αὐτούς",702165,62]],"And he said to me, Son of man, go thy way, and go in to the house of Israel, and speak my words to them."],["5",[["διότι",703734,7],["οὐ",709805,28],["πρὸς",710844,0],["λαὸν",708094,6],["βαθύχειλον",702383,27],["καὶ",707031,7],["βαρύγλωσσον",702548,27],["σὺ",712181,164],["ἐξαποστέλλῃ",704872,123],["πρὸς",710844,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["Ισραηλ",706839,18]],"For thou art not sent to a people of hard speech, [but] to the house of Israel;"],["6",[["οὐδὲ",709816,7],["πρὸς",710844,0],["λαοὺς",708094,57],["πολλοὺς",710646,60],["ἀλλοφώνους",700707,60],["ἢ",705924,7],["ἀλλογλώσσους",700691,60],["οὐδὲ",709816,7],["στιβαροὺς",712099,60],["τῇ",709436,100],["γλώσσῃ",703120,1],["ὄντας",704093,235],["ὧν",709781,252],["οὐκ",709805,28],["ἀκούσῃ",700587,123],["τοὺς",709436,58],["λόγους",708236,57],["αὐτῶν",702165,40],["καὶ",707031,7],["εἰ",704071,7],["πρὸς",710844,0],["τοιούτους",712878,60],["ἐξαπέστειλά",704872,155],["σε",711598,163],["οὗτοι",709858,201],["ἂν",700900,11],["εἰσήκουσάν",704108,150],["σου",711945,133]],"neither to many nations of other speech and other tongues, nor of harsh language, whose words thou wouldest not understand: although if I [had] sent thee to such, they would have hearkened to thee."],["7",[["ὁ",709436,3],["δὲ",703303,11],["οἶκος",709516,4],["τοῦ",709436,35],["Ισραηλ",706839,18],["οὐ",709805,28],["μὴ",708851,28],["θελήσωσιν",706176,234],["εἰσακοῦσαί",704108,106],["σου",711945,133],["διότι",703734,7],["οὐ",709805,28],["βούλονται",702795,269],["εἰσακούειν",704108,55],["μου",709032,133],["ὅτι",709803,7],["πᾶς",710177,14],["ὁ",709436,3],["οἶκος",709516,4],["Ισραηλ",706839,18],["φιλόνεικοί",713487,138],["εἰσιν",704093,197],["καὶ",707031,7],["σκληροκάρδιοι",711860,138]],"But the house of Israel will not be willing to hearken to thee; for they will not hearken to me: for all the house of Israel are stubborn and hard-hearted."],["8",[["καὶ",707031,7],["ἰδοὺ",706497,88],["δέδωκα",703654,89],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["δυνατὸν",703845,46],["κατέν