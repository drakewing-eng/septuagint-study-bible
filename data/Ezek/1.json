[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["τῷ",709436,53],["τριακοστῷ",712937,97],["ἔτει",705543,54],["ἐν",704639,0],["τῷ",709436,113],["τετάρτῳ",712811,30],["μηνὶ",708874,114],["πέμπτῃ",710245,101],["τοῦ",709436,35],["μηνὸς",708874,18],["καὶ",707031,7],["ἐγὼ",704018,164],["ἤμην",704093,333],["ἐν",704639,0],["μέσῳ",708768,97],["τῆς",709436,16],["αἰχμαλωσίας",700499,17],["ἐπὶ",705080,0],["τοῦ",709436,35],["ποταμοῦ",710693,18],["τοῦ",709436,35],["Χοβαρ",713884,118],["καὶ",707031,7],["ἠνοίχθησαν",701186,99],["οἱ",709436,136],["οὐρανοί",709844,52],["καὶ",707031,7],["εἶδον",709725,155],["ὁράσεις",709721,39],["θεοῦ",706192,18]],"Now it came to pass in the thirtieth year, in the fourth month, on the fifth day of the month, that I was in the midst of the captivity by the river of Chobar; and the heavens were opened, and I saw visions of God."],["2",[["πέμπτῃ",710245,101],["τοῦ",709436,35],["μηνός",708874,18],["τοῦτο",709858,132],["τὸ",709436,34],["ἔτος",705543,15],["τὸ",709436,34],["πέμπτον",710245,26],["τῆς",709436,16],["αἰχμαλωσίας",700499,17],["τοῦ",709436,35],["βασιλέως",702580,18],["Ιωακιμ",706887,18]],"On the fifth day of the month; this was the fifth year of the captivity of king Joakim."],["3",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρὸς",710844,0],["Ιεζεκιηλ",706539,6],["υἱὸν",713075,6],["Βουζι",702781,18],["τὸν",709436,5],["ἱερέα",706614,6],["ἐν",704639,0],["γῇ",703083,1],["Χαλδαίων",713678,81],["ἐπὶ",705080,0],["τοῦ",709436,35],["ποταμοῦ",710693,18],["τοῦ",709436,35],["Χοβαρ",713884,118],["καὶ",707031,7],["ἐγένετο",703104,23],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["χεὶρ",713787,12],["κυρίου",707996,18]],"And the word of the Lord came to Jezekiel the priest, the son of Buzi, in the land of the Chaldeans, by the river of Chobar; and the hand of the Lord was upon me."],["4",[["καὶ",707031,7],["εἶδον",709725,155],["καὶ",707031,7],["ἰδοὺ",706497,88],["πνεῦμα",710566,15],["ἐξαῖρον",704839,32],["ἤρχετο",705453,19],["ἀπὸ",701425,0],["βορρᾶ",702765,18],["καὶ",707031,7],["νεφέλη",709277,12],["μεγάλη",708653,29],["ἐν",704639,0],["αὐτῷ",702165,50],["καὶ",707031,7],["φέγγος",713404,15],["κύκλῳ",707959,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["πῦρ",711088,15],["ἐξαστράπτον",704886,32],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["μέσῳ",708768,97],["αὐτοῦ",702165,102],["ὡς",714148,7],["ὅρασις",709721,12],["ἠλέκτρου",705964,21],["ἐν",704639,0],["μέσῳ",708768,97],["τοῦ",709436,20],["πυρὸς",711088,21],["καὶ",707031,7],["φέγγος",713404,25],["ἐν",704639,0],["αὐτῷ",702165,50]],"And I looked, and, behold, a sweeping wind came from the north, and a great cloud on it, and [there was] brightness round about it, and gleaming fire, and in the midst of it as it were the appearance of amber in the midst of the fire, and brightness in it."],["5",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["μέσῳ",708768,97],["ὡς",714148,7],["ὁμοίωμα",709629,15],["τεσσάρων",712808,83],["ζῴων",705916,44],["καὶ",707031,7],["αὕτη",709858,107],["ἡ",709436,10],["ὅρασις",709721,12],["αὐτῶν",702165,70],["ὁμοίωμα",709629,15],["ἀνθρώπου",701163,18],["ἐπ᾿",705080,0],["αὐτοῖς",702165,206]],"And in the midst as it were the likeness of four living creatures. And this was their appearance; the likeness of a man was upon them."],["6",[["καὶ",707031,7],["τέσσαρα",712808,195],["πρόσωπα",710986,64],["τῷ",709436,53],["ἑνί",704106,97],["καὶ",707031,7],["τέσσαρες",712808,192],["πτέρυγες",711057,191],["τῷ",709436,53],["ἑνί",704106,97]],"And each one [had] four faces, and each one [had] four wings."],["7",[["καὶ",707031,7],["τὰ",709436,63],["σκέλη",711831,64],["αὐτῶν",702165,70],["ὀρθά",709738,195],["καὶ",707031,7],["πτερωτοὶ",711059,138],["οἱ",709436,136],["πόδες",710707,52],["αὐτῶν",702165,70],["καὶ",707031,7],["σπινθῆρες",712015,52],["ὡς",714148,7],["ἐξαστράπτων",704886,72],["χαλκός",713695,4],["καὶ",707031,7],["ἐλαφραὶ",704399,192],["αἱ",709436,190],["πτέρυγες",711057,191],["αὐτῶν",702165,70]],"And their legs were straight; and their feet were winged, and [there were] sparks, like gleaming brass, and their wings were light."],["8",[["καὶ",707031,7],["χεὶρ",713787,12],["ἀνθρώπου",701163,18],["ὑποκάτωθεν",713205,28],["τῶν",709436,130],["πτερύγων",711057,65],["αὐτῶν",702165,70],["ἐπὶ",705080,0],["τὰ",709436,41],["τέσσαρα",712808,68],["μέρη",708752,42],["αὐτῶν",702165,70],["καὶ",707031,7],["τὰ",709436,63],["πρόσωπα",710986,64],["αὐτῶν",702165,70],["τῶν",709436,43],["τεσσάρων",712808,83]],"And the hand of a man was under their wings on their four sides."],["9",[["οὐκ",709805,28],["ἐπεστρέφοντο",705278,139],["ἐν",704639,0],["τῷ",709436,53],["βαδίζειν",702367,55],["αὐτά",702165,71],["ἕκαστον",704133,26],["κατέναντι",707507,28],["τοῦ",709436,20],["προσώπου",710986,21],["αὐτῶν",702165,70],["ἐπορεύοντο",710667,139]],"And the faces of them four turned not when they went; they went every one straight forward.",{"s":"d","q":0.65}],["10",[["καὶ",707031,7],["ὁμοίωσις",709631,12],["τῶν",709436,43],["προσώπων",710986,44],["αὐτῶν",702165,70],["πρόσωπον",710986,15],["ἀνθρώπου",701163,18],["καὶ",707031,7],["πρόσωπον",710986,15],["λέοντος",708171,18],["ἐκ",704132,0],["δεξιῶν",703360,83],["τοῖς",709436,95],["τέσσαρσιν",712808,94],["καὶ",707031,7],["πρόσωπον",710986,15],["μόσχου",709029,18],["ἐξ",704132,0],["ἀριστερῶν",701749,83],["τοῖς",709436,95],["τέσσαρσιν",712808,94],["καὶ",707031,7],["πρόσωπον",710986,15],["ἀετοῦ",700318,18],["τοῖς",709436,95],["τέσσαρσιν",712808,94]],"And the likeness of their faces was the face of a man, and the face of a lion on the right to the four; and the face of a calf on the left to the four; and the face of an eagle to the four."],["11",[["καὶ",707031,7],["αἱ",709436,190],["πτέρυγες",711057,191],["αὐτῶν",702165,70],["ἐκτεταμέναι",704322,423],["ἄνωθεν",701298,28],["τοῖς",709436,95],["τέσσαρσιν",712808,94],["ἑκατέρῳ",704134,97],["δύο",703849,59],["συνεζευγμέναι",712248,415],["πρὸς",710844,0],["ἀλλήλας",700689,231],["καὶ",707031,7],["δύο",703849,59],["ἐπεκάλυπτον",705155,137],["ἐπάνω",705030,28],["τοῦ",709436,20],["σώματος",712635,21],["αὐτῶν",702165,70]],"And the four had their wings spread out above; each one [had] two joined to one another, and two covered their bodies."],["12",[["καὶ",707031,7],["ἑκάτερον",704134,26],["κατὰ",707200,0],["πρόσωπον",710986,25],["αὐτοῦ",702165,49],["ἐπορεύετο",710667,19],["οὗ",709781,160],["ἂν",700900,11],["ἦν",704093,13],["τὸ",709436,34],["πνεῦμα",710566,15],["πορευόμενον",710667,208],["ἐπορεύοντο",710667,139],["καὶ",707031,7],["οὐκ",709805,28],["ἐπέστρεφον",705278,137]],"And each one went straight forward: wherever the spirit was going they went, and turned not back."],["13",[["καὶ",707031,7],["ἐν",704639,0],["μέσῳ",708768,97],["τῶν",709436,43],["ζῴων",705916,44],["ὅρασις",709721,12],["ὡς",714148,7],["ἀνθράκων",701160,81],["πυρὸς",711088,21],["καιομένων",707049,299],["ὡς",714148,7],["ὄψις",709901,12],["λαμπάδων",708079,65],["συστρεφομένων",712562,788],["ἀνὰ",700902,0],["μέσον",708768,46],["τῶν",709436,43],["ζῴων",705916,44],["καὶ",707031,7],["φέγγος",713404,25],["τοῦ",709436,20],["πυρός",711088,21],["καὶ",707031,7],["ἐκ",704132,0],["τοῦ",709436,20],["πυρὸς",711088,21],["ἐξεπορεύετο",704293,19],["ἀστραπή",702021,12]],"And in the midst of the living creatures [there was] an appearance as of burning coals of fire, as an appearance of lamps turning among the living creatures; and the brightness of fire, and out of the fire came forth lightning."],["15",[["καὶ",707031,7],["εἶδον",709725,155],["καὶ",707031,7],["ἰδοὺ",706497,88],["τροχὸς",712994,4],["εἷς",704106,14],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ἐχόμενος",705785,122],["τῶν",709436,43],["ζῴων",705916,44],["τοῖς",709436,95],["τέσσαρσιν",712808,94]],"And I looked, and, behold, the four [had each] one wheel on the ground near the living creatures."],["16",[["καὶ",707031,7],["τὸ",709436,34],["εἶδος",704074,15],["τῶν",709436,80],["τροχῶν",712994,81],["ὡς",714148,7],["εἶδος",704074,15],["θαρσις",706125,118],["καὶ",707031,7],["ὁμοίωμα",709629,15],["ἓν",704106,26],["τοῖς",709436,95],["τέσσαρσιν",712808,94],["καὶ",707031,7],["τὸ",709436,34],["ἔργον",705396,15],["αὐτῶν",702165,40],["ἦν",704093,13],["καθὼς",707030,28],["ἂν",700900,11],["εἴη",704093,301],["τροχὸς",712994,4],["ἐν",704639,0],["τροχῷ",712994,114]],"And the appearance of the wheels was as the appearance of beryl: and the four had one likeness: and their work was as it were a wheel in a wheel."],["17",[["ἐπὶ",705080,0],["τὰ",709436,41],["τέσσαρα",712808,68],["μέρη",708752,42],["αὐτῶν",702165,40],["ἐπορεύοντο",710667,139],["οὐκ",709805,28],["ἐπέστρεφον",705278,137],["ἐν",704639,0],["τῷ",709436,53],["πορεύεσθαι",710667,110],["αὐτὰ",702165,71]],"They went on their four sides: they turned not as they went;"],["18",[["οὐδ᾿",709816,7],["οἱ",709436,136],["νῶτοι",709403,52],["αὐτῶν",702165,40],["καὶ",707031,7],["ὕψος",713288,15],["ἦν",704093,13],["αὐτοῖς",702165,151],["καὶ",707031,7],["εἶδον",709725,155],["αὐτά",702165,71],["καὶ",707031,7],["οἱ",709436,136],["νῶτοι",709403,52],["αὐτῶν",702165,40],["πλήρεις",710541,138],["ὀφθαλμῶν",709870,81],["κυκλόθεν",707956,28],["τοῖς",709436,147],["τέσσαρσιν",712808,230]],"neither did their backs [turn]: and they were high: and I beheld them, and the backs of them four were full of eyes round about."],["19",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["πορεύεσθαι",710667,110],["τὰ",709436,41],["ζῷα",705916,42],["ἐπορεύοντο",710667,139],["οἱ",709436,136],["τροχοὶ",712994,52],["ἐχόμενοι",705785,348],["αὐτῶν",702165,70],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἐξαίρειν",704839,55],["τὰ",709436,41],["ζῷα",705916,42],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["ἐξῄροντο",704839,139],["οἱ",709436,136],["τροχοί",712994,52]],"And when the living creatures went, the wheels went by them: and when the living creatures lifted themselves off the earth, the wheels were lifted off."],["20",[["οὗ",709781,48],["ἂν",700900,11],["ἦν",704093,13],["ἡ",709436,10],["νεφέλη",709277,12],["ἐκεῖ",704181,28],["τὸ",709436,34],["πνεῦμα",710566,15],["τοῦ",709436,20],["πορεύεσθαι",710667,110],["ἐπορεύοντο",710667,139],["τὰ",709436,63],["ζῷα",705916,64],["καὶ",707031,7],["οἱ",709436,136],["τροχοὶ",712994,52],["καὶ",707031,7],["ἐξῄροντο",704839,139],["σὺν",712372,0],["αὐτοῖς",702165,151],["διότι",703734,7],["πνεῦμα",710566,15],["ζωῆς",705910,17],["ἦν",704093,13],["ἐν",704639,0],["τοῖς",709436,147],["τροχοῖς",712994,148]],"Wherever the cloud happened to be, there was the spirit ready to go: the wheels went and were lifted up with them; because the spirit of life was in the wheels."],["21",[["ἐν",704639,0],["τῷ",709436,53],["πορεύεσθαι",710667,110],["αὐτὰ",702165,71],["ἐπορεύοντο",710667,139],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἑστάναι",706846,115],["αὐτὰ",702165,71],["εἱστήκεισαν",706846,263],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἐξαίρειν",704839,55],["αὐτὰ",702165,71],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["ἐξῄροντο",704839,139],["σὺν",712372,0],["αὐτοῖς",702165,206],["ὅτι",709803,7],["πνεῦμα",710566,15],["ζωῆς",705910,17],["ἦν",704093,13],["ἐν",704639,0],["τοῖς",709436,147],["τροχοῖς",712994,148]],"When those went, [the wheels] went; and when those stood, [the wheels] stood; and when those lifted themselves off the earth, they were lifted off with them: for the spirit of life was in the wheels."],["22",[["καὶ",707031,7],["ὁμοίωμα",709629,15],["ὑπὲρ",713111,0],["κεφαλῆς",707639,17],["αὐτοῖς",702165,151],["τῶν",709436,43],["ζῴων",705916,44],["ὡσεὶ",714159,7],["στερέωμα",712077,15],["ὡς",714148,7],["ὅρασις",709721,12],["κρυστάλλου",707926,18],["ἐκτεταμένον",704322,413],["ἐπὶ",705080,0],["τῶν",709436,130],["πτερύγων",711057,65],["αὐτῶν",702165,70],["ἐπάνωθεν",705032,28]],"And the likeness over the heads of the living creatures was as a firmament, as the appearance of crystal, spread out over their wings above."],["23",[["καὶ",707031,7],["ὑποκάτω",713204,0],["τοῦ",709436,20],["στερεώματος",712077,21],["αἱ",709436,190],["πτέρυγες",711057,191],["αὐτῶν",702165,70],["ἐκτεταμέναι",704322,423],["πτερυσσόμεναι",711058,305],["ἑτέρα",705535,29],["τῇ",709436,100],["ἑτέρᾳ",705535,101],["ἑκάστῳ",704133,30],["δύο",703849,59],["συνεζευγμέναι",712248,415],["ἐπικαλύπτουσαι",705155,306],["τὰ",709436,41],["σώματα",712635,42],["αὐτῶν",702165,70]],"And their wings were spread out under the firmament, reaching one to the other; two [wings] to each, covering their bodies."],["24",[["καὶ",707031,7],["ἤκουον",700587,333],["τὴν",709436,8],["φωνὴν",713640,9],["τῶν",709436,130],["πτερύγων",711057,65],["αὐτῶν",702165,70],["ἐν",704639,0],["τῷ",709436,53],["πορεύεσθαι",710667,110],["αὐτὰ",702165,71],["ὡς",714148,7],["φωνὴν",713640,9],["ὕδατος",713071,21],["πολλοῦ",710646,92],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἑστάναι",706846,115],["αὐτὰ",702165,71],["κατέπαυον",707365,137],["αἱ",709436,190],["πτέρυγες",711057,191],["αὐτῶν",702165,70]],"And I heard the sound of their wings when they went, as the sound of much water: and when they stood, their wings were let down."],["25",[["καὶ",707031,7],["ἰδοὺ",706497,88],["φωνὴ",713640,12],["ὑπεράνωθεν",713119,28],["τοῦ",709436,20],["στερεώματος",712077,21],["τοῦ",709436,35],["ὄντος",704093,152],["ὑπὲρ",713111,0],["κεφαλῆς",707639,17],["αὐτῶν",702165,70]],"And lo! a voice from above the firmament"],["26",[["ὡς",714148,7],["ὅρασις",709721,12],["λίθου",708196,18],["σαπφείρου",711505,17],["ὁμοίωμα",709629,15],["θρόνου",706315,18],["ἐπ᾿",705080,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπὶ",705080,0],["τοῦ",709436,20],["ὁμοιώματος",709629,21],["τοῦ",709436,35],["θρόνου",706315,18],["ὁμοίωμα",709629,15],["ὡς",714148,7],["εἶδος",704074,15],["ἀνθρώπου",701163,18],["ἄνωθεν",701298,28]],"that was over their head, [there was] as the appearance of a sapphire stone, [and] the likeness of a throne upon it: and upon the likeness of the throne was the likeness as an appearance of a man above."],["27",[["καὶ",707031,7],["εἶδον",709725,155],["ὡς",714148,7],["ὄψιν",709901,9],["ἠλέκτρου",705964,21],["ἀπὸ",701425,0],["ὁράσεως",709721,17],["ὀσφύος",709800,17],["καὶ",707031,7],["ἐπάνω",705030,28],["καὶ",707031,7],["ἀπὸ",701425,0],["ὁράσεως",709721,17],["ὀσφύος",709800,17],["καὶ",707031,7],["ἕως",705792,28],["κάτω",707557,28],["εἶδον",709725,155],["ὡς",714148,7],["ὅρασιν",709721,9],["πυρὸς",711088,21],["καὶ",707031,7],["τὸ",709436,24],["φέγγος",713404,25],["αὐτοῦ",702165,102],["κύκλῳ",707959,114]],"And I saw as it were the resemblance of amber from the appearance of the loins and upwards, and from the appearance of the loins and under I saw an appearance of fire, and the brightness thereof round about."],["28",[["ὡς",714148,7],["ὅρασις",709721,12],["τόξου",712898,21],["ὅταν",709801,28],["ᾖ",704093,204],["ἐν",704639,0],["τῇ",709436,100],["νεφέλῃ",709277,1],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["ὑετοῦ",713074,18],["οὕτως",709859,28],["ἡ",709436,10],["στάσις",712049,12],["τοῦ",709436,20],["φέγγους",713404,21],["κυκλόθεν",707956,28],["αὕτη",709858,107],["ἡ",709436,10],["ὅρασις",709721,12],["ὁμοιώματος",709629,21],["δόξης",703791,17],["κυρίου",707996,18],["καὶ",707031,7],["εἶδον",709725,155],["καὶ",707031,7],["πίπτω",710481,157],["ἐπὶ",705080,0],["πρόσωπόν",710986,25],["μου",709032,133],["καὶ",707031,7],["ἤκουσα",700587,155],["φωνὴν",713640,9],["λαλοῦντος",708071,152]],"As the appearance of the bow when it is in the cloud in days of rain, so was the form of the brightness round about.",{"s":"d","q":0.5}]]