[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72]],"And the word of the Lord came to me, saying,"],["2",[["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["λάλησον",708071,176],["τοῖς",709436,147],["υἱοῖς",713075,148],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133],["καὶ",707031,7],["ἐρεῖς",705415,166],["πρὸς",710844,0],["αὐτούς",702165,62],["γῆ",703083,12],["ἐφ᾿",705080,0],["ἣν",709781,131],["ἂν",700900,11],["ἐπάγω",704994,157],["ῥομφαίαν",711291,9],["καὶ",707031,7],["λάβῃ",708076,172],["ὁ",709436,3],["λαὸς",708094,4],["τῆς",709436,16],["γῆς",703083,17],["ἄνθρωπον",701163,6],["ἕνα",704106,27],["ἐξ",704132,0],["αὐτῶν",702165,40],["καὶ",707031,7],["δῶσιν",703654,234],["αὐτὸν",702165,85],["ἑαυτοῖς",703917,151],["εἰς",704105,0],["σκοπόν",711877,6]],"Son of man, speak to the children of thy people, and thou shalt say to them, On whatsoever land I shall bring a sword, and the people of the land take one man of them, and set him for their watchman:"],["3",[["καὶ",707031,7],["ἴδῃ",709725,172],["τὴν",709436,8],["ῥομφαίαν",711291,9],["ἐρχομένην",705453,173],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["σαλπίσῃ",711425,172],["τῇ",709436,100],["σάλπιγγι",711424,1],["καὶ",707031,7],["σημάνῃ",711745,172],["τῷ",709436,113],["λαῷ",708094,114]],"and he shall see the sword coming upon the land, and blow the trumpet, and sound an alarm to the people;"],["4",[["καὶ",707031,7],["ἀκούσῃ",700587,172],["ὁ",709436,3],["ἀκούσας",700587,182],["τὴν",709436,8],["φωνὴν",713640,9],["τῆς",709436,16],["σάλπιγγος",711424,17],["καὶ",707031,7],["μὴ",708851,28],["φυλάξηται",713619,239],["καὶ",707031,7],["ἐπέλθῃ",705068,172],["ἡ",709436,10],["ῥομφαία",711291,12],["καὶ",707031,7],["καταλάβῃ",707300,172],["αὐτόν",702165,85],["τὸ",709436,24],["αἷμα",700442,25],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τῆς",709436,16],["κεφαλῆς",707639,17],["αὐτοῦ",702165,102],["ἔσται",704093,93]],"and he that hears the sound of the trumpet shall hear [indeed], and [yet] not take heed, and the sword shall come upon him, and overtake him, his blood shall be upon his [own] head."],["5",[["ὅτι",709803,7],["τὴν",709436,8],["φωνὴν",713640,9],["τῆς",709436,16],["σάλπιγγος",711424,17],["ἀκούσας",700587,182],["οὐκ",709805,28],["ἐφυλάξατο",713619,23],["τὸ",709436,34],["αἷμα",700442,15],["αὐτοῦ",702165,102],["ἐπ᾿",705080,0],["αὐτοῦ",702165,102],["ἔσται",704093,93],["καὶ",707031,7],["οὗτος",709858,121],["ὅτι",709803,7],["ἐφυλάξατο",713619,23],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["ἐξείλατο",704838,23]],"Because he heard the sound of the trumpet, and took no heed, his blood shall be upon him: but the other, because he took heed, has delivered his soul."],["6",[["καὶ",707031,7],["ὁ",709436,3],["σκοπός",711877,4],["ἐὰν",703912,7],["ἴδῃ",709725,172],["τὴν",709436,8],["ῥομφαίαν",711291,9],["ἐρχομένην",705453,173],["καὶ",707031,7],["μὴ",708851,28],["σημάνῃ",711745,172],["τῇ",709436,100],["σάλπιγγι",711424,1],["καὶ",707031,7],["ὁ",709436,3],["λαὸς",708094,4],["μὴ",708851,28],["φυλάξηται",713619,239],["καὶ",707031,7],["ἐλθοῦσα",705453,149],["ἡ",709436,10],["ῥομφαία",711291,12],["λάβῃ",708076,172],["ἐξ",704132,0],["αὐτῶν",702165,40],["ψυχήν",714070,9],["αὕτη",709858,107],["διὰ",703417,0],["τὴν",709436,8],["αὑτῆς",703917,86],["ἀνομίαν",701192,9],["ἐλήμφθη",708076,37],["καὶ",707031,7],["τὸ",709436,24],["αἷμα",700442,25],["ἐκ",704132,0],["τῆς",709436,16],["χειρὸς",713787,17],["τοῦ",709436,35],["σκοποῦ",711877,18],["ἐκζητήσω",704187,165]],"But if the watchman see the sword coming, and do not sound the trumpet, and the people do not watch; and the sword come, and take a soul from among them, that [soul] is taken because of its iniquity; but the blood [thereof] will I require at the watchman's hand."],["7",[["καὶ",707031,7],["σύ",712181,164],["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["σκοπὸν",711877,6],["δέδωκά",703654,89],["σε",711598,163],["τῷ",709436,113],["οἴκῳ",709516,114],["Ισραηλ",706839,18],["καὶ",707031,7],["ἀκούσῃ",700587,123],["ἐκ",704132,0],["στόματός",712125,21],["μου",709032,133],["λόγον",708236,6]],"And thou, son of man, I have set thee [as] a watchman to the house of Israel, and thou shalt hear a word from my mouth."],["8",[["ἐν",704639,0],["τῷ",709436,53],["εἶπαί",705415,106],["με",708618,163],["τῷ",709436,113],["ἁμαρτωλῷ",700776,30],["θανάτῳ",706096,114],["θανατωθήσῃ",706097,364],["καὶ",707031,7],["μὴ",708851,28],["λαλήσῃς",708071,175],["τοῦ",709436,20],["φυλάξασθαι",713619,109],["τὸν",709436,5],["ἀσεβῆ",701909,60],["ἀπὸ",701425,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["αὐτοῦ",702165,102],["αὐτὸς",702165,121],["ὁ",709436,3],["ἄνομος",701194,14],["τῇ",709436,100],["ἀνομίᾳ",701192,1],["αὐτοῦ",702165,102],["ἀποθανεῖται",701461,93],["τὸ",709436,24],["δὲ",703303,11],["αἷμα",700442,25],["αὐτοῦ",702165,102],["ἐκ",704132,0],["τῆς",709436,16],["χειρός",713787,17],["σου",711945,133],["ἐκζητήσω",704187,165]],"When I say to the sinner, Thou shalt surely die; [if] thou speak not to warn the wicked from his way, the wicked himself shall die in his iniquity; but his blood will I require at thine hand."],["9",[["σὺ",712181,164],["δὲ",703303,11],["ἐὰν",703912,7],["προαπαγγείλῃς",710758,175],["τῷ",709436,113],["ἀσεβεῖ",701909,30],["τὴν",709436,8],["ὁδὸν",709458,9],["αὐτοῦ",702165,102],["τοῦ",709436,20],["ἀποστρέψαι",701598,106],["ἀπ᾿",701425,0],["αὐτῆς",702165,86],["καὶ",707031,7],["μὴ",708851,28],["ἀποστρέψῃ",701598,172],["ἀπὸ",701425,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["αὐτοῦ",702165,102],["οὗτος",709858,121],["τῇ",709436,100],["ἀσεβείᾳ",701904,1],["αὐτοῦ",702165,102],["ἀποθανεῖται",701461,93],["καὶ",707031,7],["σὺ",712181,164],["τὴν",709436,8],["ψυχὴν",714070,9],["σαυτοῦ",711599,102],["ἐξῄρησαι",704838,332]],"But if thou forewarn the wicked of his way to turn from it, and he turn not from his way, he shall die in his ungodliness; but thou hast delivered thine own soul."],["10",[["καὶ",707031,7],["σύ",712181,164],["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["εἰπὸν",705373,176],["τῷ",709436,113],["οἴκῳ",709516,114],["Ισραηλ",706839,18],["οὕτως",709859,28],["ἐλαλήσατε",708071,265],["λέγοντες",708124,146],["αἱ",709436,190],["πλάναι",710496,191],["ἡμῶν",705999,145],["καὶ",707031,7],["αἱ",709436,190],["ἀνομίαι",701192,191],["ἡμῶν",705999,145],["ἐφ᾿",705080,0],["ἡμῖν",705994,90],["εἰσιν",704093,197],["καὶ",707031,7],["ἐν",704639,0],["αὐταῖς",702165,200],["ἡμεῖς",705983,219],["τηκόμεθα",712839,378],["καὶ",707031,7],["πῶς",711121,28],["ζησόμεθα",705851,141]],"And thou, son of man, say to the house of Israel; Thus have ye spoken, saying, Our errors, and our iniquities weigh upon us, and we pine away in them, and how then shall we live?"],["11",[["εἰπὸν",705373,176],["αὐτοῖς",702165,151],["ζῶ",705851,157],["ἐγώ",704018,164],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["οὐ",709805,28],["βούλομαι",702795,254],["τὸν",709436,5],["θάνατον",706096,6],["τοῦ",709436,35],["ἀσεβοῦς",701909,116],["ὡς",714148,7],["τὸ",709436,24],["ἀποστρέψαι",701598,106],["τὸν",709436,5],["ἀσεβῆ",701909,27],["ἀπὸ",701425,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ζῆν",705851,55],["αὐτόν",702165,85],["ἀποστροφῇ",701599,1],["ἀποστρέψατε",701598,74],["ἀπὸ",701425,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["ὑμῶν",713091,145],["καὶ",707031,7],["ἵνα",706747,7],["τί",712867,126],["ἀποθνῄσκετε",701461,87],["οἶκος",709516,4],["Ισραηλ",706839,18]],"Say to them, Thus saith the Lord; [As] I live, I desire not the death of the ungodly, as that the ungodly should turn from his way and live: turn ye heartily from your way; for why will ye die, O house of Israel?"],["12",[["εἰπὸν",705373,176],["πρὸς",710844,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133],["δικαιοσύνη",703695,12],["δικαίου",703694,116],["οὐ",709805,28],["μὴ",708851,28],["ἐξέληται",704838,239],["αὐτὸν",702165,85],["ἐν",704639,0],["ᾗ",709781,108],["ἂν",700900,11],["ἡμέρᾳ",705984,1],["πλανηθῇ",710495,384],["καὶ",707031,7],["ἀνομία",701192,12],["ἀσεβοῦς",701909,116],["οὐ",709805,28],["μὴ",708851,28],["κακώσῃ",707073,172],["αὐτὸν",702165,85],["ἐν",704639,0],["ᾗ",709781,108],["ἂν",700900,11],["ἡμέρᾳ",705984,1],["ἀποστρέψῃ",701598,172],["ἀπὸ",701425,0],["τῆς",709436,16],["ἀνομίας",701192,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["δίκαιος",703694,14],["οὐ",709805,28],["μὴ",708851,28],["δύνηται",703838,428],["σωθῆναι",712627,179]],"Say to the children of thy people, The righteousness of the righteous shall not deliver him, in the day wherein he errs: and the iniquity of the ungodly shall not harm him, in the day wherein he turns from his iniquity, but the righteous [erring] shall not be able to deliver himself."],["13",[["ἐν",704639,0],["τῷ",709436,53],["εἶπαί",705415,106],["με",708618,163],["τῷ",709436,113],["δικαίῳ",703694,30],["οὗτος",709858,121],["πέποιθεν",710221,171],["ἐπὶ",705080,0],["τῇ",709436,100],["δικαιοσύνῃ",703695,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["ποιήσῃ",710582,172],["ἀνομίαν",701192,9],["πᾶσαι",710177,192],["αἱ",709436,190],["δικαιοσύναι",703695,191],["αὐτοῦ",702165,102],["οὐ",709805,28],["μὴ",708851,28],["ἀναμνησθῶσιν",701002,272],["ἐν",704639,0],["τῇ",709436,100],["ἀδικίᾳ",700271,1],["αὐτοῦ",702165,102],["ᾗ",709781,108],["ἐποίησεν",710582,2],["ἐν",704639,0],["αὐτῇ",702165,105],["ἀποθανεῖται",701461,93]],"When I say to the righteous, [Thou shalt live; and] he trusts in his righteousness, and shall commit iniquity, none of his righteousnesses shall be remembered; in his unrighteousness which he has wrought, in it shall he die."],["14",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["εἶπαί",705415,106],["με",708618,163],["τῷ",709436,113],["ἀσεβεῖ",701909,30],["θανάτῳ",706096,114],["θανατωθήσῃ",706097,364],["καὶ",707031,7],["ἀποστρέψῃ",701598,123],["ἀπὸ",701425,0],["τῆς",709436,16],["ἁμαρτίας",700775,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ποιήσῃ",710582,172],["κρίμα",707903,25],["καὶ",707031,7],["δικαιοσύνην",703695,9]],"And when I say to the ungodly, Thou shalt surely die; and he shall turn from his sin, and do judgment and justice,"],["15",[["καὶ",707031,7],["ἐνεχύρασμα",704724,25],["ἀποδῷ",701449,172],["καὶ",707031,7],["ἅρπαγμα",701803,25],["ἀποτείσῃ",701618,172],["ἐν",704639,0],["προστάγμασιν",710959,96],["ζωῆς",705910,17],["διαπορεύηται",703551,428],["τοῦ",709436,20],["μὴ",708851,28],["ποιῆσαι",710582,106],["ἄδικον",700272,27],["ζωῇ",705910,1],["ζήσεται",705851,93],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἀποθάνῃ",701461,172]],"and return the pledge, and repay that which he has robbed, [and] walk in the ordinances of life, so as to do no wrong; he shall surely live, and shall not die."],["16",[["πᾶσαι",710177,192],["αἱ",709436,190],["ἁμαρτίαι",700775,191],["αὐτοῦ",702165,102],["ἃς",709781,193],["ἥμαρτεν",700773,2],["οὐ",709805,28],["μὴ",708851,28],["ἀναμνησθῶσιν",701002,272],["ὅτι",709803,7],["κρίμα",707903,25],["καὶ",707031,7],["δικαιοσύνην",703695,9],["ἐποίησεν",710582,2],["ἐν",704639,0],["αὐτοῖς",702165,151],["ζήσεται",705851,93]],"None of his sins which he has committed shall be remembered: because he has wrought judgment and righteousness; by them shall he live."],["17",[["καὶ",707031,7],["ἐροῦσιν",705415,218],["οἱ",709436,136],["υἱοὶ",713075,52],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133],["οὐκ",709805,28],["εὐθεῖα",705602,29],["ἡ",709436,10],["ὁδὸς",709458,12],["τοῦ",709436,35],["κυρίου",707996,18],["καὶ",707031,7],["αὕτη",709858,107],["ἡ",709436,10],["ὁδὸς",709458,12],["αὐτῶν",702165,40],["οὐκ",709805,28],["εὐθεῖα",705602,29]],"Yet the children of thy people will say, The way of the Lord is not straight: whereas this their way is not straight."],["18",[["ἐν",704639,0],["τῷ",709436,53],["ἀποστρέψαι",701598,106],["δίκαιον",703694,27],["ἀπὸ",701425,0],["τῆς",709436,16],["δικαιοσύνης",703695,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ποιήσῃ",710582,172],["ἀνομίας",701192,17],["καὶ",707031,7],["ἀποθανεῖται",701461,93],["ἐν",704639,0],["αὐταῖς",702165,200]],"When the righteous turns away from his righteousness, and shall commit iniquities, then shall he die in them."],["19",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἀποστρέψαι",701598,106],["τὸν",709436,5],["ἁμαρτωλὸν",700776,27],["ἀπὸ",701425,0],["τῆς",709436,16],["ἀνομίας",701192,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ποιήσῃ",710582,172],["κρίμα",707903,25],["καὶ",707031,7],["δικαιοσύνην",703695,9],["ἐν",704639,0],["αὐτοῖς",702165,151],["αὐτὸς",702165,121],["ζήσεται",705851,93]],"And when the sinner turns from his iniquity, and shall do judgment and righteousness, he shall live by them."],["20",[["καὶ",707031,7],["τοῦτό",709858,129],["ἐστιν",704093,91],["ὃ",709781,128],["εἴπατε",705373,265],["οὐκ",709805,28],["εὐθεῖα",705602,29],["ἡ",709436,10],["ὁδὸς",709458,12],["κυρίου",707996,18],["ἕκαστον",704133,27],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["αὐτοῦ",702165,102],["κρινῶ",707905,165],["ὑμᾶς",713080,194],["οἶκος",709516,4],["Ισραηλ",706839,18]],"And this is that which ye said, The way of the Lord is [not] straight. I will judge you, O house of Israel, every one for his ways."],["21",[["καὶ",707031,7],["ἐγενήθη",703104,37],["ἐν",704639,0],["τῷ",709436,53],["δωδεκάτῳ",703890,97],["ἔτει",705543,54],["ἐν",704639,0],["τῷ",709436,113],["δωδεκάτῳ",703890,30],["μηνὶ",708874,114],["πέμπτῃ",710245,101],["τοῦ",709436,35],["μηνὸς",708874,18],["τῆς",709436,16],["αἰχμαλωσίας",700499,17],["ἡμῶν",705999,145],["ἦλθεν",705453,2],["ὁ",709436,3],["ἀνασωθεὶς",701064,217],["πρός",710844,0],["με",708618,163],["ἀπὸ",701425,0],["Ιερουσαλημ",706644,17],["λέγων",708124,72],["ἑάλω",700673,2],["ἡ",709436,10],["πόλις",710612,12]],"And it came to pass in the tenth year of our captivity, in the twelfth month, on the fifth [day] of the month, [that] one that had escaped from Jerusalem came to me, saying, The city is taken."],["22",[["καὶ",707031,7],["ἐγενήθη",703104,37],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["χεὶρ",713787,12],["κυρίου",707996,18],["ἑσπέρας",70550