[["1",[["καὶ",707031,7],["ἐξήγαγέν",704834,2],["με",708618,163],["εἰς",704105,0],["τὴν",709436,8],["αὐλὴν",702137,9],["τὴν",709436,8],["ἐξωτέραν",704987,36],["κατὰ",707200,0],["ἀνατολὰς",701071,39],["κατέναντι",707507,28],["τῆς",709436,16],["πύλης",711082,17],["τῆς",709436,16],["πρὸς",710844,0],["βορρᾶν",702765,6],["καὶ",707031,7],["εἰσήγαγέν",704107,2],["με",708618,163],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἐξέδραι",704891,191],["πέντε",710266,59],["ἐχόμεναι",705785,305],["τοῦ",709436,20],["ἀπολοίπου",701519,92],["καὶ",707031,7],["ἐχόμεναι",705785,305],["τοῦ",709436,35],["διορίζοντος",703730,152],["πρὸς",710844,0],["βορρᾶν",702765,6]],"And he brought me into the inner court eastward, opposite the northern gate: and he brought me in, and behold five chambers near the vacant space, and near the northern partition,"],["2",[["ἐπὶ",705080,0],["πήχεις",710462,57],["ἑκατὸν",704136,59],["μῆκος",708868,25],["πρὸς",710844,0],["βορρᾶν",702765,6],["καὶ",707031,7],["τὸ",709436,24],["πλάτος",710507,25],["πεντήκοντα",710270,59],["πήχεων",710462,81]],"a hundred cubits in length toward the north, and in breadth fifty,"],["3",[["διαγεγραμμέναι",703441,423],["ὃν",709781,112],["τρόπον",712980,6],["αἱ",709436,190],["πύλαι",711082,191],["τῆς",709436,16],["αὐλῆς",702137,17],["τῆς",709436,16],["ἐσωτέρας",705525,82],["καὶ",707031,7],["ὃν",709781,112],["τρόπον",712980,6],["τὰ",709436,63],["περίστυλα",710397,64],["τῆς",709436,16],["αὐλῆς",702137,17],["τῆς",709436,16],["ἐξωτέρας",704987,82],["ἐστιχισμέναι",712112,415],["ἀντιπρόσωποι",701270,192],["στοαὶ",712114,191],["τρισσαί",712960,192]],"ornamented accordingly as the gates of the inner court, and arranged accordingly as the peristyles of the outer court, [with] triple porticos fronting one another."],["4",[["καὶ",707031,7],["κατέναντι",707507,28],["τῶν",709436,130],["ἐξεδρῶν",704891,65],["περίπατος",710363,4],["πηχῶν",710462,148],["δέκα",703333,59],["τὸ",709436,24],["πλάτος",710507,25],["ἐπὶ",705080,0],["πήχεις",710462,57],["ἑκατὸν",704136,59],["τὸ",709436,24],["μῆκος",708868,25],["καὶ",707031,7],["τὰ",709436,63],["θυρώματα",706343,64],["αὐτῶν",702165,40],["πρὸς",710844,0],["βορρᾶν",702765,6]],"And in front of the chambers was a walk ten cubits in breadth, the length [reaching] to a hundred cubits; and their doors were northward."],["5",[["καὶ",707031,7],["οἱ",709436,136],["περίπατοι",710363,52],["οἱ",709436,136],["ὑπερῷοι",713172,52],["ὡσαύτως",714158,28],["ὅτι",709803,7],["ἐξείχετο",704917,19],["τὸ",709436,24],["περίστυλον",710397,25],["ἐξ",704132,0],["αὐτοῦ",702165,102],["ἐκ",704132,0],["τοῦ",709436,20],["ὑποκάτωθεν",713205,28],["περιστύλου",710397,21],["καὶ",707031,7],["τὸ",709436,34],["διάστημα",703589,15],["οὕτως",709859,28],["περίστυλον",710397,15],["καὶ",707031,7],["διάστημα",703589,15],["καὶ",707031,7],["οὕτως",709859,28],["στοαί",712114,191]],"And the upper walks were in like manner: for the peristyle projected from it, [even] from the range of columns below, and [there was] a space between; so [were there] a peristyle and a space between, and so [were there] two porticos."],["6",[["διότι",703734,7],["τριπλαῖ",712951,192],["ἦσαν",704093,137],["καὶ",707031,7],["στύλους",712179,57],["οὐκ",709805,28],["εἶχον",705785,137],["καθὼς",707030,28],["οἱ",709436,136],["στῦλοι",712179,52],["τῶν",709436,80],["ἐξωτέρων",704987,169],["διὰ",703417,0],["τοῦτο",709858,129],["ἐξείχοντο",704917,139],["τῶν",709436,80],["ὑποκάτωθεν",713205,28],["καὶ",707031,7],["τῶν",709436,80],["μέσων",708768,169],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17]],"For they were triple, and they had not pillars like the pillars of the outer ones: therefore they projected from the lower ones and the middle ones from the ground."],["7",[["καὶ",707031,7],["φῶς",713642,25],["ἔξωθεν",704984,28],["ὃν",709781,112],["τρόπον",712980,6],["αἱ",709436,190],["ἐξέδραι",704891,191],["τῆς",709436,16],["αὐλῆς",702137,17],["τῆς",709436,16],["ἐξωτέρας",704987,82],["αἱ",709436,190],["βλέπουσαι",702740,306],["ἀπέναντι",701389,28],["τῶν",709436,13