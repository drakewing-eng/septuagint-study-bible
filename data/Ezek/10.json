,["ἦραν",700473,150],["τὰ",709436,63],["χερουβιν",713830,64],["τοῦτο",709858,132],["τὸ",709436,34],["ζῷον",705916,15],["ὃ",709781,128],["εἶδον",709725,155],["ἐπὶ",705080,0],["τοῦ",709436,35],["ποταμοῦ",710693,18],["τοῦ",709436,35],["Χοβαρ",713884,118]],"And the cherubs were the same living creature which I saw by the river of Chobar."],["16",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["πορεύεσθαι",710667,110],["τὰ",709436,41],["χερουβιν",713830,42],["ἐπορεύοντο",710667,139],["οἱ",709436,136],["τροχοί",712994,52],["καὶ",707031,7],["οὗτοι",709858,201],["ἐχόμενοι",705785,348],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἐξαίρειν",704839,55],["τὰ",709436,41],["χερουβιν",713830,42],["τὰς",709436,38],["πτέρυγας",711057,39],["αὐτῶν",702165,70],["τοῦ",709436,20],["μετεωρίζεσθαι",708829,110],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["οὐκ",709805,28],["ἐπέστρεφον",705278,137],["οἱ",709436,136],["τροχοὶ",712994,52],["αὐτῶν",702165,70]],"And when the cherubs went, the wheels went, and they were close to them: and when the cherubs lifted up their wings to mount up from the earth, their wheels turned not."],["17",[["ἐν",704639,0],["τῷ",709436,53],["ἑστάναι",706846,115],["αὐτὰ",702165,71],["εἱστήκεισαν",706846,263],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["μετεωρίζεσθαι",708829,110],["αὐτὰ",702165,71],["ἐμετεωρίζοντο",708829,139],["μετ᾿",708780,0],["αὐτῶν",702165,70],["διότι",703734,7],["πνεῦμα",710566,15],["ζωῆς",705910,17],["ἐν",704639,0],["αὐτοῖς",702165,206],["ἦν",704093,13]],"When they stood, [the wheels] stood; and when they mounted up, [the wheels] mounted up with them: because the spirit of life was in them."],["18",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["δόξα",703791,12],["κυρίου",707996,18],["ἀπὸ",701425,0],["τοῦ",709436,35],["οἴκου",709516,18],["καὶ",707031,7],["ἐπέβη",705082,2],["ἐπὶ",705080,0],["τὰ",709436,41],["χερουβιν",713830,42]],"Then the glory of the Lord departed from the house, and went up on the cherub