,708618,163],["ἐπὶ",705080,0],["σὲ",711598,163],["τὴν",709436,8],["ἄβυσσον",700098,9],["καὶ",707031,7],["κατακαλύψῃ",707260,172],["σε",711598,163],["ὕδωρ",713071,15],["πολύ",710646,26]],"For thus saith the Lord God; When I shall make the city desolate, as the cities that shall not be inhabited, when I have brought the deep up upon thee,"],["20",[["καὶ",707031,7],["καταβιβάσω",707208,165],["σε",711598,163],["πρὸς",710844,0],["τοὺς",709436,58],["καταβαίνοντας",707202,235],["εἰς",704105,0],["βόθρον",702749,6],["πρὸς",710844,0],["λαὸν",708094,6],["αἰῶνος",700504,18],["καὶ",707031,7],["κατοικιῶ",707538,165],["σε",711598,163],["εἰς",704105,0],["βάθη",702376,42],["τῆς",709436,16],["γῆς",703083,17],["ὡς",714148,7],["ἔρημον",705420,9],["αἰώνιον",700505,36],["μετὰ",708780,0],["καταβαινόντων",707202,170],["εἰς",704105,0],["βόθρον",702749,6],["ὅπως",709719,7],["μὴ",708851,28],["κατοικηθῇς",707534,279],["μηδὲ",708855,7],["ἀνασταθῇς",701173,279],["ἐπὶ",705080,0],["γῆς",703083,17],["ζωῆς",705910,17]],"and great waters shall cover thee; and I shall bring thee down to them that go down to the pit, to the people of old time, and shall cause thee to dwell in the depths of the earth, as in everlasting desolation, with them that go down to the pit, that thou mayest not be inhabited, nor stand upon the land of life;"],["21",[["ἀπώλειάν",701660,9],["σε",711598,163],["δώσω",703654,165],["καὶ",707031,7],["οὐχ",709805,28],["ὑπάρξεις",713104,166],["ἔτι",705538,28],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["λέγει",708124,91],["κύριος",707996,4],["κύριος",707996,4]],"I will make thee a destruction, and thou shalt be no more for ever, saith the Lord God."]]