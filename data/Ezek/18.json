209,9],["τοῦ",709436,35],["πλησίον",710547,28],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐμίανεν",708900,2]],"and [if he] has not eaten on the mountains, and has not set his eyes on the devices of the house of Israel, and has not defiled his neighbour's wife,"],["16",[["καὶ",707031,7],["ἄνθρωπον",701163,6],["οὐ",709805,28],["κατεδυνάστευσεν",707248,2],["καὶ",707031,7],["ἐνεχυρασμὸν",704725,6],["οὐκ",709805,28],["ἐνεχύρασεν",704722,2],["καὶ",707031,7],["ἅρπαγμα",701803,25],["οὐχ",709805,28],["ἥρπασεν",701804,2],["τὸν",709436,5],["ἄρτον",701829,6],["αὐτοῦ",702165,102],["τῷ",709436,113],["πεινῶντι",710222,379],["ἔδωκεν",703654,2],["καὶ",707031,7],["γυμνὸν",703202,27],["περιέβαλεν",710294,2]],"and has not oppressed a man, and has not retained the pledge, nor committed robbery, has given his bread to the hungry, and has clothed the naked,"],["17",[["καὶ",707031,7],["ἀπ᾿",701425,0],["ἀδικίας",700271,17],["ἀπέστρεψε",701598,2],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["τόκον",712882,6],["οὐδὲ",709816,7],["πλεονασμὸν",710519,6],["οὐκ",709805,28],["ἔλαβεν",708076,2],["δικαιοσύνην",703695,9],["ἐποίησεν",710582,2],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["προστάγμασίν",710959,96],["μου",709032,133],["ἐπορεύθη",710667,37],["οὐ",709805,28],["τελευτήσει",712781,127],["ἐν",704639,0],["ἀδικίαις",700271,76],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["ζωῇ",705910,1],["ζήσεται",705851,93]],"and has turned back his hand from unrighteousness, has not received interest or usurious increase, has wrought righteousness, and walked in mine ordinances; he shall not die for the iniquities of his father, he shall surely live."],["18",[["ὁ",709436,3],["δὲ",703303,11],["πατὴρ",710189,4],["αὐτοῦ",702165,102],["ἐὰν",703912,7],["θλίψει",706276,1],["θλίψῃ",706274,123],["καὶ",707031,7],["ἁρπάσῃ",701804,172],["ἅρπαγμα",701803,25],["ἐναντία",704656,68],["ἐποίησεν",710582,2],["ἐν",704639,0],["μέσῳ",708768,97],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133],["καὶ",707031,7],["ἀποθανεῖται",701461,93],["ἐν",704639,0],["τῇ",709436,100],["ἀδικίᾳ",700271,1],["αὐτοῦ",702165,102]],"But if his father grievously afflict, or plunder, he has wrought enmity in the midst of my people, and shall die in his iniquity."],["19",[["καὶ",707031,7],["ἐρεῖτε",705415,337],["τί",712867,126],["ὅτι",709803,7],["οὐκ",709805,28],["ἔλαβεν",708076,2],["τὴν",709436,8],["ἀδικίαν",700271,9],["ὁ",709436,3],["υἱὸς",713075,4],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ὁ",709436,3],["υἱὸς",713075,4],["δικαιοσύνην",703695,9],["καὶ",707031,7],["ἔλεος",704426,25],["ἐποίησεν",710582,2],["πάντα",710177,68],["τὰ",709436,41],["νόμιμά",709340,68],["μου",709032,133],["συνετήρησεν",712512,2],["καὶ",707031,7],["ἐποίησεν",710582,2],["αὐτά",702165,71],["ζωῇ",705910,1],["ζήσεται",705851,93]],"But ye will say, Why has not the son borne the iniquity of the father? Because the son has wrought judgment and mercy, has kept all my statutes, and done them, he shall surely live."],["20",[["ἡ",709436,10],["δὲ",703303,11],["ψυχὴ",714070,12],["ἡ",709436,10],["ἁμαρτάνουσα",700773,188],["ἀποθανεῖται",701461,93],["ὁ",709436,3],["δὲ",703303,11],["υἱὸς",713075,4],["οὐ",709805,28],["λήμψεται",708076,93],["τὴν",709436,8],["ἀδικίαν",700271,9],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["οὐδὲ",709816,7],["ὁ",709436,3],["πατὴρ",710189,4],["λήμψεται",708076,93],["τὴν",709436,8],["ἀδικίαν",700271,9],["τοῦ",709436,35],["υἱοῦ",713075,18],["αὐτοῦ",702165,102],["δικαιοσύνη",703695,12],["δικαίου",703694,116],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["ἔσται",704093,93],["καὶ",707031,7],["ἀνομία",701192,12],["ἀνόμου",701194,116],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["ἔσται",704093,93]],"But the soul that sins shall die: and the son shall not bear the iniquity of the father, nor shall the father bear the iniquity of the son: the righteousness of the righteous shall be upon him, and the iniquity of the transgressor shall be upon him."],["21",[["καὶ",707031,7],["ὁ",709436,3],["ἄνομος",701194,14],["ἐὰν",703912,7],["ἀποστρέψῃ",701598,123],["ἐκ",704132,0],["πασῶν",710177,198],["τῶν",709436,130],["ἀνομιῶν",701192,65],["αὐτοῦ",702165,102],["ὧν",709781,199],["ἐποίησεν",710582,2],["καὶ",707031,7],["φυλάξηται",713619,239],["πάσας",710177,119],["τὰς",709436,38],["ἐντολάς",704802,39],["μου",709032,133],["καὶ",707031,7],["ποιήσῃ",710582,172],["δικαιοσύνην",703695,9],["καὶ",707031,7],["ἔλεος",704426,25],["ζωῇ",705910,1],["ζήσεται",705851,93],["οὐ",709805,28],["μὴ",708851,28],["ἀποθάνῃ",701461,172]],"And if the transgressor turn away from all his iniquities which he has committed, and keep all my commandments, and do justice and mercy, he shall surely live, and shall by no means die."],["22",[["πάντα",710177,68],["τὰ",709436,41],["παραπτώματα",710095,42],["αὐτοῦ",702165,102],["ὅσα",709788,68],["ἐποίησεν",710582,2],["οὐ",709805,28],["μνησθήσεται",708923,134],["ἐν",704639,0],["τῇ",709436,100],["δικαιοσύνῃ",703695,1],["αὐτοῦ",702165,102],["ᾗ",709781,108],["ἐποίησεν",710582,2],["ζήσεται",705851,93]],"None of his trespasses which he has committed shall be remembered: in his righteousness which he has done he shall live."],["23",[["μὴ",708851,28],["θελήσει",706172,1],["θελήσω",706176,207],["τὸν",709436,5],["θάνατον",706096,6],["τοῦ",709436,35],["ἀνόμου",701194,116],["λέγει",708124,91],["κύριος",707996,4],["ὡς",714148,7],["τὸ",709436,24],["ἀποστρέψαι",701598,106],["αὐτὸν",702165,85],["ἐκ",704132,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["τῆς",709436,16],["πονηρᾶς",710660,82],["καὶ",707031,7],["ζῆν",705851,55],["αὐτόν",702165,85]],"Shall I at all desire the death of the sinner, saith the Lord, as I [desire] that he should turn from [his] evil way, and live?"],["24",[["ἐν",704639,0],["δὲ",703303,11],["τῷ",709436,53],["ἀποστρέψαι",701598,106],["δίκαιον",703694,27],["ἐκ",704132,0],["τῆς",709436,16],["δικαιοσύνης",703695,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ποιήσῃ",710582,172],["ἀδικίαν",700271,9],["κατὰ",707200,0],["πάσας",710177,119],["τὰς",709436,38],["ἀνομίας",701192,39],["ἃς",709781,193],["ἐποίησεν",710582,2],["ὁ",709436,3],["ἄνομος",701194,14],["πᾶσαι",710177,192],["αἱ",709436,190],["δικαιοσύναι",703695,191],["αὐτοῦ",702165,102],["ἃς",709781,193],["ἐποίησεν",710582,2],["οὐ",709805,28],["μὴ",708851,28],["μνησθῶσιν",708923,272],["ἐν",704639,0],["τῷ",709436,53],["παραπτώματι",710095,54],["αὐτοῦ",702165,102],["ᾧ",709781,209],["παρέπεσεν",710089,2],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἁμαρτίαις",700775,76],["αὐτοῦ",702165,102],["αἷς",709781,281],["ἥμαρτεν",700773,2],["ἐν",704639,0],["αὐταῖς",702165,200],["ἀποθανεῖται",701461,93]],"But when the righteous man turns away from his righteousness, and commits iniquity, according to all the transgressions which the transgressor has wrought, none of his righteousness which he has wrought shall be at all remembered: in his trespass wherein he has trespassed, and in his sins wherein he has sinned, in them shall he die."],["25",[["καὶ",707031,7],["εἴπατε",705373,265],["οὐ",709805,28],["κατευθύνει",707521,91],["ἡ",709436,10],["ὁδὸς",709458,12],["κυρίου",707996,18],["ἀκούσατε",700587,74],["δή",703395,11],["πᾶς",710177,14],["οἶκος",709516,4],["Ισραηλ",706839,18],["μὴ",708851,28],["ἡ",709436,10],["ὁδός",709458,12],["μου",709032,133],["οὐ",709805,28],["κατευθύνει",707521,91],["οὐχὶ",709862,28],["ἡ",709436,10],["ὁδὸς",709458,12],["ὑμῶν",713091,145],["οὐ",709805,28],["κατευθύνει",707521,91]],"Yet ye have said, The way of the Lord is not straight. Hear now, all the house of Israel; will not my way be straight? Is your way straight?"],["26",[["ἐν",704639,0],["τῷ",709436,53],["ἀποστρέψαι",701598,106],["τὸν",709436,5],["δίκαιον",703694,27],["ἐκ",704132,0],["τῆς",709436,16],["δικαιοσύνης",703695,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ποιήσῃ",710582,172],["παράπτωμα",710095,25],["καὶ",707031,7],["ἀποθάνῃ",701461,172],["ἐν",704639,0],["τῷ",709436,53],["παραπτώματι",710095,54],["ᾧ",709781,209],["ἐποίησεν",710582,2],["ἐν",704639,0],["αὐτῷ",702165,50],["ἀποθανεῖται",701461,93]],"When the righteous turns away from his righteousness and commits a trespass, and dies in the trespass which he has committed, he shall [even] die in it."],["27",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἀποστρέψαι",701598,106],["ἄνομον",701194,27],["ἀπὸ",701425,0],["τῆς",709436,16],["ἀνομίας",701192,17],["αὐτοῦ",702165,102],["ἧς",709781,167],["ἐποίησεν",710582,2],["καὶ",707031,7],["ποιήσῃ",710582,172],["κρίμα",707903,25],["καὶ",707031,7],["δικαιοσύνην",703695,9],["οὗτος",709858,121],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["ἐφύλαξεν",713619,2]],"And when the wicked man turns away from his wickedness that he has committed, and shall do judgment and justice, he has kept his soul,"],["28",[["καὶ",707031,7],["ἀπέστρεψεν",701598,2],["ἐκ",704132,0],["πασῶν",710177,198],["τῶν",709436,130],["ἀσεβειῶν",701904,65],["αὐτοῦ",702165,102],["ὧν",709781,199],["ἐποίησεν",710582,2],["ζωῇ",705910,1],["ζήσεται",705851,93],["οὐ",709805,28],["μὴ",708851,28],["ἀποθάνῃ",701461,172]],"and has turned away from all his ungodliness which he has committed: he shall surely live, he shall not die."],["29",[["καὶ",707031,7],["λέγουσιν",708124,197],["ὁ",709436,3],["οἶκος",709516,4],["τοῦ",709436,35],["Ισραηλ",706839,18],["οὐ",709805,28],["κατορθοῖ",707548,91],["ἡ",709436,10],["ὁδὸς",709458,12],["κυρίου",707996,18],["μὴ",708851,28],["ἡ",709436,10],["ὁδός",709458,12],["μου",709032,133],["οὐ",709805,28],["κατορθοῖ",707548,91],["οἶκος",709516,4],["Ισραηλ",706839,18],["οὐχὶ",709862,28],["ἡ",709436,10],["ὁδὸς",709458,12],["ὑμῶν",713091,145],["οὐ",709805,28],["κατορθοῖ",707548,91]],"Yet the house of Israel say, The way of the Lord is not right. Is not my way right, O house of Israel? is not your way wrong?"],["30",[["ἕκαστον",704133,27],["κατὰ",707200,0],["τὴν",709436,8],["ὁδὸν",709458,9],["αὐτοῦ",702165,102],["κρινῶ",707905,165],["ὑμᾶς",713080,194],["οἶκος",709516,4],["Ισραηλ",706839,18],["λέγει",708124,91],["κύριος",707996,4],["ἐπιστράφητε",705278,372],["καὶ",707031,7],["ἀποστρέψατε",701598,74],["ἐκ",704132,0],["πασῶν",710177,198],["τῶν",709436,130],["ἀσεβειῶν",701904,65],["ὑμῶν",713091,145],["καὶ",707031,7],["οὐκ",709805,28],["ἔσονται",704093,135],["ὑμῖν",713084,90],["εἰς",704105,0],["κόλασιν",707789,9],["ἀδικίας",700271,17]],"I will judge you, O house of Israel, saith the Lord, each one according to his way: be converted, and turn from all your ungodliness, and it shall not become to you the punishment of iniquity."],["31",[["ἀπορρίψατε",701563,74],["ἀπὸ",701425,0],["ἑαυτῶν",703917,40],["πάσας",710177,119],["τὰς",709436,38],["ἀσεβείας",701904,39],["ὑμῶν",713091,145],["ἃς",709781,193],["ἠσεβήσατε",701906,265],["εἰς",704105,0],["ἐμέ",704555,163],["καὶ",707031,7],["ποιήσατε",710582,74],["ἑαυτοῖς",703917,151],["καρδίαν",707141,9],["καινὴν",707042,36],["καὶ",707031,7],["πνεῦμα",710566,25],["καινόν",707042,46],["καὶ",707031,7],["ἵνα",706747,7],["τί",712867,126],["ἀποθνῄσκετε",701461,87],["οἶκος",709516,4],["Ισραηλ",706839,18]],"Cast away from yourselves all your ungodliness wherein ye have sinned against me; and make to yourselves a new heart and a new spirit: for why should ye die, O house of Israel?"],["32",[["διότι",703734,7],["οὐ",709805,28],["θέλω",706176,157],["τὸν",709436,5],["θάνατον",706096,6],["τοῦ",709436,35],["ἀποθνῄσκοντος",701461,152],["λέγει",708124,91],["κύριος",707996,4]],"For I desire not the death of him that dies, saith the Lord."]]