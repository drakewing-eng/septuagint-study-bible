[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72]],"And the word of the Lord came to me, saying,"],["2",[["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["τί",712867,126],["ὑμῖν",713084,90],["ἡ",709436,10],["παραβολὴ",710003,12],["αὕτη",709858,107],["ἐν",704639,0],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["λέγοντες",708124,146],["οἱ",709436,136],["πατέρες",710189,52],["ἔφαγον",713296,150],["ὄμφακα",709651,9],["καὶ",707031,7],["οἱ",709436,136],["ὀδόντες",709461,52],["τῶν",709436,43],["τέκνων",712761,44],["ἐγομφίασαν",703167,150]],"Son of man, what mean ye by this parable among the children of Israel, saying, The fathers have eaten unripe grapes, and the children's teeth have been set on edge?"],["3",[["ζῶ",705851,157],["ἐγώ",704018,164],["λέγει",708124,91],["κύριος",707996,4],["ἐὰν",703912,7],["γένηται",703104,239],["ἔτι",705538,28],["λεγομένη",708124,211],["ἡ",709436,10],["παραβολὴ",710003,12],["αὕτη",709858,107],["ἐν",704639,0],["τῷ",709436,113],["Ισραηλ",706839,114]],"[As] I live, saith the Lord, surely this parable shall no more be spoken in Israel."],["4",[["ὅτι",709803,7],["πᾶσαι",710177,192],["αἱ",709436,190],["ψυχαὶ",714070,191],["ἐμαί",704578,192],["εἰσιν",704093,197],["ὃν",709781,112],["τρόπον",712980,6],["ἡ",709436,10],["ψυχὴ",714070,12],["τοῦ",709436,35],["πατρός",710189,18],["οὕτως",709859,28],["καὶ",707031,7],["ἡ",709436,10],["ψυχὴ",714070,12],["τοῦ",709436,35],["υἱοῦ",713075,18],["ἐμαί",704578,192],["εἰσιν",704093,197],["ἡ",709436,10],["ψυχὴ",714070,12],["ἡ",709436,10],["ἁμαρτάνουσα",700773,188],["αὕτη",709858,107],["ἀποθανεῖται",701461,93]],"For all souls are mine; as the soul of the father, so also the soul of the son, they are mine: the soul that sins, it shall die."],["5",[["ὁ",709436,3],["δὲ",703303,11],["ἄνθρωπος",701163,4],["ὃς",709781,213],["ἔσται",704093,93],["δίκαιος",703694,14],["ὁ",709436,3],["ποιῶν",710582,72],["κρίμα",707903,25],["κα