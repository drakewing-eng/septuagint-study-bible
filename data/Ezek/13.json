[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72]],"And the word of the Lord came to me, saying,"],["2",[["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["προφήτευσον",711008,176],["ἐπὶ",705080,0],["τοὺς",709436,58],["προφήτας",711009,57],["τοῦ",709436,35],["Ισραηλ",706839,18],["καὶ",707031,7],["προφητεύσεις",711008,166],["καὶ",707031,7],["ἐρεῖς",705415,166],["πρὸς",710844,0],["αὐτούς",702165,62],["ἀκούσατε",700587,74],["λόγον",708236,6],["κυρίου",707996,18]],"Son of man, prophesy against the prophets of Israel, and thou shalt prophesy, and shalt say to them, Hear ye the word of the Lord:"],["3",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["οὐαὶ",709807,88],["τοῖς",709436,147],["προφητεύουσιν",711008,146],["ἀπὸ",701425,0],["καρδίας",707141,17],["αὐτῶν",702165,40],["καὶ",707031,7],["τὸ",709436,24],["καθόλου",707016,28],["μὴ",708851,28],["βλέπουσιν",702740,197]],"Thus saith the Lord, Woe to them that prophesy out of their own heart, and who see nothing at all."],["4",[["οἱ",709436,136],["προφῆταί",711009,52],["σου",711945,133],["Ισραηλ",706839,153],["ὡς",714148,7],["ἀλώπεκες",700743,191],["ἐν",704639,0],["ταῖς",709436,75],["ἐρήμοις",705420,76]],"Thy prophets, O Israel, are like foxes in the deserts."],["5",[["οὐκ",709805,28],["ἔστησαν",706846,150],["ἐν",704639,0],["στερεώματι",712077,54],["καὶ",707031,7],["συνήγαγον",712375,150],["ποίμνια",710598,42],["ἐπὶ",705080,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["Ισραηλ",706839,18],["οὐκ",709805,28],["ἀνέστησαν",701173,150],["οἱ",709436,136],["λέγοντες",708124,146],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["κυρίου",707996,18]],"They have not continued steadfast, and they have gathered flocks against the house of Israel, they that say,"],["6",[["βλέποντες",702740,146],["ψευδῆ",714036,68],["μαντευόμενοι",708490,348],["μάταια",708575,68],["οἱ",709436,136],["λέγοντες",708124,146],["λέγει",708124,91],["κύριος",707996,4],["καὶ",707031,7],["κύριος",707996,4],["οὐκ",709805,28],["ἀπέσταλκεν",701592,171],["αὐτούς",702165,62],["καὶ",707031,7],["ἤρξαντο",701860,189],["τοῦ",709436,20],["ἀναστῆσαι",701173,106],["λόγον",708236,6]],"In the day of the Lord, have not stood, seeing false [visions], prophesying vanities, who say, The Lord saith, and the Lord has not sent them, and they began [to try] to confirm the word."],["7",[["οὐχ",709805,28],["ὅρασιν",709721,9],["ψευδῆ",714036,68],["ἑωράκατε",709725,330],["καὶ",707031,7],["μαντείας",708488,39],["ματαίας",708575,119],["εἰρήκατε",705415,330]],"Have ye not seen a false vision? and spoken vain prophecies?"],["8",[["διὰ",703417,0],["τοῦτο",709858,129],["εἰπόν",705373,176],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἀνθ᾿",701227,0],["ὧν",709781,252],["οἱ",709436,136],["λόγοι",708236,52],["ὑμῶν",713091,145],["ψευδεῖς",714036,138],["καὶ",707031,7],["αἱ",709436,190],["μαντεῖαι",708488,191],["ὑμῶν",713091,145],["μάταιαι",708575,192],["διὰ",703417,0],["τοῦτο",709858,129],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["λέγει",708124,91],["κύριος",707996,4]],"And therefore say, Thus saith the Lord; Because your words are false, and your prophecies are vain, therefore, behold, I am against you, saith the Lord."],["9",[["καὶ",707031,7],["ἐκτενῶ",704322,165],["τὴν",709436,8],["χεῖρά",713787,9],["μου",709032,133],["ἐπὶ",705080,0],["τοὺς",709436,58],["προφήτας",711009,57],["τοὺς",709436,58],["ὁρῶντας",709725,235],["ψευδῆ",714036,68],["καὶ",707031,7],["τοὺς",709436,58],["ἀποφθεγγομένους",701634,236],["μάταια",708575,68],["ἐν",704639,0],["παιδείᾳ",709924,1],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133],["οὐκ",709805,28],["ἔσονται",704093,135],["οὐδὲ",709816,7],["ἐν",704639,0],["γραφῇ",703191,1],["οἴκου",709516,18],["Ισραηλ",706839,18],["οὐ",709805,28],["γραφήσονται",703194,144],["καὶ",707031,7],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["τοῦ",709436,35],["Ισραηλ",706839,18],["οὐκ",709805,28],["εἰσελεύσονται",704114,135],["καὶ",707031,7],["γνώσονται",703105,135],["διότι",703734,7],["ἐγὼ",704018,164],["κύριος",707996,4]],"And I will stretch forth my hand against the prophets that see false [visions], and those that utter vanities: they shall not partake of the instruction of my people, neither shall they be written in the roll of the house of Israel, and they shall not enter into the land of Israel; and they shall know that I am the Lord."],["10",[["ἀνθ᾿",701227,0],["ὧν",709781,252],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["ἐπλάνησαν",710495,150],["λέγοντες",708124,146],["εἰρήνη",704098,12],["εἰρήνη",704098,12],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["εἰρήνη",704098,12],["καὶ",707031,7],["οὗτος",709858,121],["οἰκοδομεῖ",709509,91],["τοῖχον",712879,6],["καὶ",707031,7],["αὐτοὶ",702165,201],["ἀλείφουσιν",700644,197],["αὐτόν",702165,85],["εἰ",704071,7],["πεσεῖται",710481,93]],"Because they have caused my people to err, saying, Peace; and there is no peace; and one builds a wall, and they plaster it,—it shall fall."],["11",[["εἰπὸν",705373,176],["πρὸς",710844,0],["τοὺς",709436,58],["ἀλείφοντας",700644,235],["πεσεῖται",710481,93],["καὶ",707031,7],["ἔσται",704093,93],["ὑετὸς",713074,4],["κατακλύζων",707278,72],["καὶ",707031,7],["δώσω",703654,165],["λίθους",708196,57],["πετροβόλους",710445,60],["εἰς",704105,0],["τοὺς",709436,58],["ἐνδέσμους",704682,57],["αὐτῶν",702165,40],["καὶ",707031,7],["πεσοῦνται",710481,135],["καὶ",707031,7],["πνεῦμα",710566,25],["ἐξαῖρον",704839,47],["καὶ",707031,7],["ῥαγήσεται",711243,134]],"Say to them that plaster [it], It shall fall; and there shall be a flooding rain; and I will send great stones upon their joinings, and they shall fall; and there shall be a sweeping wind, and it shall be broken."],["12",[["καὶ",707031,7],["ἰδοὺ",706497,88],["πέπτωκεν",710481,171],["ὁ",709436,3],["τοῖχος",712879,4],["καὶ",707031,7],["οὐκ",709805,28],["ἐροῦσιν",705415,218],["πρὸς",710844,0],["ὑμᾶς",713080,194],["ποῦ",710706,28],["ἐστιν",704093,91],["ἡ",709436,10],["ἀλοιφὴ",700725,12],["ὑμῶν",713091,145],["ἣν",709781,131],["ἠλείψατε",700644,265]],"And lo! the wall has fallen; and will they not say to you, Where is your plaster wherewith ye plastered [it]?"],["13",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["καὶ",707031,7],["ῥήξω",711244,165],["πνοὴν",710574,9],["ἐξαίρουσαν",704839,78],["μετὰ",708780,0],["θυμοῦ",706334,18],["καὶ",707031,7],["ὑετὸς",713074,4],["κατακλύζων",707278,72],["ἐν",704639,0],["ὀργῇ",709728,1],["μου",709032,133],["ἔσται",704093,93],["καὶ",707031,7],["τοὺς",709436,58],["λίθους",708196,57],["τοὺς",709436,58],["πετροβόλους",710445,60],["ἐν",704639,0],["θυμῷ",706334,114],["ἐπάξω",704994,165],["εἰς",704105,0],["συντέλειαν",712509,9]],"Therefore thus saith the Lord; I will even cause to burst forth a sweeping blast with fury, and there shall be a flooding rain in my wrath; and in [my] fury I will bring on great stones for complete destruction."],["14",[["καὶ",707031,7],["κατασκάψω",707416,165],["τὸν",709436,5],["τοῖχον",712879,6],["ὃν",709781,112],["ἠλείψατε",700644,265],["καὶ",707031,7],["πεσεῖται",710481,93],["καὶ",707031,7],["θήσω",712849,165],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἀποκαλυφθήσεται",701474,134],["τὰ",709436,63],["θεμέλια",706181,64],["αὐτοῦ",702165,102],["καὶ",707031,7],["πεσεῖται",710481,93],["καὶ",707031,7],["συντελεσθήσεσθε",712510,261],["μετ᾿",708780,0],["ἐλέγχων",704415,81],["καὶ",707031,7],["ἐπιγνώσεσθε",705104,124],["διότι",703734,7],["ἐγὼ",704018,164],["κύριος",707996,4]],"And I will break down the wall which ye have plastered, and it shall fall; and I will lay it on the ground, and its foundations shall be discovered, and it shall fall; and ye shall be consumed with rebukes: and ye shall know that I am the Lord."],["15",[["καὶ",707031,7],["συντελέσω",712510,165],["τὸν",709436,5],["θυμόν",706334,6],["μου",709032,133],["ἐπὶ",705080,0],["τὸν",709436,5],["τοῖχον",712879,6],["καὶ",707031,7],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἀλείφοντας",700644,235],["αὐτόν",702165,85],["καὶ",707031,7],["πεσεῖται",710481,93],["καὶ",707031,7],["εἶπα",705373,155],["πρὸς",710844,0],["ὑμᾶς",713080,194],["οὐκ",709805,28],["ἔστιν",704093,91],["ὁ",709436,3],["τοῖχος",712879,4],["οὐδὲ",709816,7],["οἱ",709436,136],["ἀλείφοντες",700644,146],["αὐτὸν",702165,85]],"And I will accomplish my wrath upon the wall, and upon them that plaster it; it shall fall: and I said to you, The wall is not, nor they that plaster it,"],["16",[["προφῆται",711009,52],["τοῦ",709436,35],["Ισραηλ",706839,18],["οἱ",709436,136],["προφητεύοντες",711008,146],["ἐπὶ",705080,0],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["οἱ",709436,136],["ὁρῶντες",709725,146],["αὐτῇ",702165,105],["εἰρήνην",704098,9],["καὶ",707031,7],["εἰρήνη",704098,12],["οὐκ",709805,28],["ἔστιν",704093,91],["λέγει",708124,91],["κύριος",707996,4]],"even the prophets of Israel, who prophesy concerning Jerusalem, and who see [visions of] peace for her, and there is no peace, saith the Lord."],["17",[["καὶ",707031,7],["σύ",712181,164],["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["στήρισον",712098,176],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["ἐπὶ",705080,0],["τὰς",709436,38],["θυγατέρας",706320,39],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133],["τὰς",709436,38],["προφητευούσας",711008,338],["ἀπὸ",701425,0],["καρδίας",707141,17],["αὐτῶν",702165,40],["καὶ",707031,7],["προφήτευσον",711008,176],["ἐπ᾿",705080,0],["αὐτὰς",702165,231]],"And thou, son of man, set thy face firmly against the daughters of thy people, that prophesy out of their own heart; and prophesy against them."],["18",[["καὶ",707031,7],["ἐρεῖς",705415,166],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["οὐαὶ",709807,88],["ταῖς",709436,75],["συρραπτούσαις",712542,495],["προσκεφάλαια",710917,42],["ἐπὶ",705080,0],["πάντα",710177,27],["ἀγκῶνα",700166,6],["χειρὸς",713787,17],["καὶ",707031,7],["ποιούσαις",710582,495],["ἐπιβόλαια",705092,42],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["κεφαλὴν",707639,9],["πάσης",710177,82],["ἡλικίας",705971,17],["τοῦ",709436,20],["διαστρέφειν",703592,55],["ψυχάς",714070,39],["αἱ",709436,190],["ψυχαὶ",714070,191],["διεστράφησαν",703592,99],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133],["καὶ",707031,7],["ψυχὰς",714070,39],["περιεποιοῦντο",710367,139]],"And thou shalt say, Thus saith the Lord, Woe to the [women] that sew pillows under every elbow, and make kerchiefs on the head of every stature to pervert souls! The souls of my people are perverted, and they have saved souls alive."],["19",[["καὶ",707031,7],["ἐβεβήλουν",702614,137],["με",708618,163],["πρὸς",710844,0],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["ἕνεκεν",704709,0],["δρακὸς",703824,17],["κριθῶν",707900,65],["καὶ",707031,7],["ἕνεκεν",704709,0],["κλασμάτων",707704,44],["ἄρτου",701829,18],["τοῦ",709436,20],["ἀποκτεῖναι",701498,106],["ψυχάς",714070,39],["ἃς",709781,193],["οὐκ",709805,28],["ἔδει",703312,127],["ἀποθανεῖν",701461,106],["καὶ",707031,7],["τοῦ",709436,20],["περιποιήσασθαι",710367,109],["ψυχάς",714070,39],["ἃς",709781,193],["οὐκ",709805,28],["ἔδει",703312,127],["ζῆσαι",705851,106],["ἐν",704639,0],["τῷ",709436,53],["ἀποφθέγγεσθαι",701634,110],["ὑμᾶς",713080,194],["λαῷ",708094,114],["εἰσακούοντι",704108,379],["μάταια",708575,68],["ἀποφθέγματα",701635,42]],"And they have dishonoured me before my people for a handful of barley, and for pieces of bread, to slay the souls which should not die, and to save alive the souls which should not live, while ye speak to a people hearing vain speeches."],["20",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐπὶ",705080,0],["τὰ",709436,41],["προσκεφάλαια",710917,42],["ὑμῶν",713091,145],["ἐφ᾿",705080,0],["ἃ",709781,69],["ὑμεῖς",713081,219],["συστρέφετε",712562,87],["ἐκεῖ",704181,28],["ψυχάς",714070,39],["καὶ",707031,