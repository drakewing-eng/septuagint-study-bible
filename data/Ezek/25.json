[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72]],"And the word of the Lord came to me, saying,"],["2",[["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["στήρισον",712098,176],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["ἐπὶ",705080,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["Αμμων",700847,18],["καὶ",707031,7],["προφήτευσον",711008,176],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62]],"Son of man, set thy face steadfastly against the children of Ammon, and prophesy against them;"],["3",[["καὶ",707031,7],["ἐρεῖς",705415,166],["τοῖς",709436,147],["υἱοῖς",713075,148],["Αμμων",700847,18],["ἀκούσατε",700587,74],["λόγον",708236,6],["κυρίου",707996,18],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἀνθ᾿",701227,0],["ὧν",709781,252],["ἐπεχάρητε",705330,472],["ἐπὶ",705080,0],["τὰ",709436,41],["ἅγιά",700159,68],["μου",709032,133],["ὅτι",709803,7],["ἐβεβηλώθη",702614,37],["καὶ",707031,7],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["τοῦ",709436,35],["Ισραηλ",706839,18],["ὅτι",709803,7],["ἠφανίσθη",702182,37],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["Ιουδα",706768,18],["ὅτι",709803,7],["ἐπορεύθησαν",710667,99],["ἐν",704639,0],["αἰχμαλωσίᾳ",700499,1]],"and thou shalt say to the children of Ammon, Hear ye the word of the Lord; thus saith the Lord; Forasmuch as ye have rejoiced against my sanctuary, because it was profaned; and against the land of Israel, because it was laid waste; and against the house of Juda, because they went into captivity;"],["4",[["διὰ",703417,0],["τοῦτο",709858,129],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["παραδίδωμι",710014,157],["ὑμᾶς",713080,194],["τοῖς",709436,147],["υἱοῖς",713075,148],["Κεδεμ",707584,18],["εἰς",704105,0],["κληρονομίαν",707725,9],["καὶ",707031,7],["κατασκηνώσουσιν",707423,218],["ἐν",704639,0],["τῇ",709436,100],["ἀπαρτίᾳ",701358,1],["αὐτῶν",702165,40],["ἐν",704639,0],["σοὶ",711925,159],["καὶ",707031,7],["δώσουσιν",703654,218],["ἐν",704639,0],["σοὶ",711925,159],["τὰ",709436,41],["σκηνώματα",711849,42],["αὐτῶν",702165,40],["αὐτοὶ",702165,201],["φάγονται",713296,135],["τοὺς",709436,58],["καρπούς",707169,57],["σου",711945,133],["καὶ",707031,7],["αὐτοὶ",702165,201],["πίονται",710478,135],["τὴν",709436,8],["πιότητά",710479,9],["σου",711945,133]],"therefore, behold, I [will] deliver you to the children of Kedem for an inheritance, and they shall lodge in thee with their stuff, and they shall pitch their tents in thee: they shall eat thy fruits, and they shall drink thy milk."],["5",[["καὶ",707031,7],["δώσω",703654,165],["τὴν",709436,8],["πόλιν",710612,9],["τοῦ",709436,35],["Αμμων",700847,18],["εἰς",704105,0],["νομὰς",709337,39],["καμήλων",707110,81],["καὶ",707031,7],["τοὺς",709436,58],["υἱοὺς",713075,57],["Αμμων",700847,18],["εἰς",704105,0],["νομὴν",709337,9],["προβάτων",710768,44],["καὶ",707031,7],["ἐπιγνώσεσθε",705104,124],["διότι",703734,7],["ἐγὼ",704018,164],["κύριος",707996,4]],"And I will give up the city of Ammon for camels' pastures, and the children of Ammon for a pasture of sheep: and ye shall know that I am the Lord."],["6",[["διότι",703734,7],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἀνθ᾿",701227,0],["ὧν",709781,252],["ἐκρότησας",707918,162],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133],["καὶ",707031,7],["ἐπεψόφησας",705343,162],["τῷ",709436,113],["ποδί",710707,114],["σου",711945,133],["καὶ",707031,7],["ἐπέχαρας",705330,162],["ἐκ",704132,0],["ψυχῆς",714070,17],["σου",711945,133],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["τοῦ",709436,35],["Ισραηλ",706839,18]],"For thus saith the Lord; Because thou hast clapped thine hands, and stamped with thy foot, and heartily rejoiced against the land of Israel;"],["7",[["διὰ",703417,0],["τοῦτο",709858,129],["ἐκτενῶ",704322,165],["τὴν",709436,8],["χεῖρά",713787,9],["μου",709032,133],["ἐπὶ",705080,0],["σὲ",711598,163],["καὶ",707031,7],["δώσω",703654,165],["σε",711598,163],["εἰς",704105,0],["διαρπαγὴν",703561,9],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["καὶ",707031,7],["ἐξολεθρεύσω",704956,165],["σε",711598,163],["ἐκ",704132,0],["τῶν",709436,80],["λαῶν",708094,81],["καὶ",707031,7],["ἀπολῶ",701513,165],["σε",711598,163],["ἐκ",704132,0],["τῶν",709436,130],["χωρῶν",714011,65],["ἀπωλείᾳ",701660,1],["καὶ",707031,7],["ἐπιγνώσῃ",705104,123],["διότι",703734,7],["ἐγὼ",704018,164],["κύριος",707996,4]],"therefore I will stretch out my hand against thee, and I will make thee a spoil to the nations; and I will utterly destroy thee from among the peoples, and I will completely cut thee off from out of the countries: and thou shalt know that I am the Lord."],["8",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἀνθ᾿",701227,0],["ὧν",709781,252],["εἶπεν",705373,2],["Μωαβ",709085,12],["ἰδοὺ",706497,88],["ὃν",709781,112],["τρόπον",712980,6],["πάντα",710177,195],["τὰ",709436,63],["ἔθνη",704068,64],["οἶκος",709516,4],["Ισραηλ",706839,18],["καὶ",707031,7],["Ιουδα",706768,18]],"Thus saith the Lord; Because Moab has said, Behold, are not the house of Israel and Juda like all the [other] nations?"],["9",[["διὰ",703417,0],["τοῦτο",709858,129],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["παραλύω",710070,157],["τὸν",709436,5],["ὦμον",714114,6],["Μωαβ",709085,17],["ἀπὸ",701425,0],["πόλεων",710612,65],["ἀκρωτηρίων",700614,44],["αὐτοῦ",702165,102],["ἐκλεκτὴν",704240,36],["γῆν",703083,9],["οἶκον",709516,6],["Ασιμουθ",701955,18],["ἐπάνω",705030,28],["πηγῆς",710450,17],["πόλεως",710612,17],["παραθαλασσίας",710023,82]],"Therefore, behold, I will weaken the shoulder of Moab from his frontier cities, [even] the choice land, the house of Bethasimuth above the fountain of the city, by the sea-side."],["10",[["τοῖς",709436,147],["υἱοῖς",713075,148],["Κεδεμ",707584,18],["ἐπὶ",705080,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["Αμμων",700847,18],["δέδωκα",703654,89],["αὐτοὺς",702165,62],["εἰς",704105,0],["κληρονομίαν",707725,9],["ὅπως",709719,7],["μὴ",708851,28],["μνεία",708961,12],["γένηται",703104,239],["τῶν",709436,80],["υἱῶν",713075,81],["Αμμων",700847,18]],"I have given him the children of Kedem in addition to the children of Ammon for an inheritance, that there may be no remembrance of the children of Ammon."],["11",[["καὶ",707031,7],["εἰς",704105,0],["Μωαβ",709085,9],["ποιήσω",710582,165],["ἐκδίκησιν",704175,9],["καὶ",707031,7],["ἐπιγνώσονται",705104,135],["διότι",703734,7],["ἐγὼ",704018,164],["κύριος",707996,4]],"And I will execute vengeance on Moab; and they shall know that I am the Lord."],["12",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἀνθ᾿",701227,0],["ὧν",709781,252],["ἐποίησεν",710582,2],["ἡ",709436,10],["Ιδουμαία",706503,12],["ἐν",704639,0],["τῷ",709436,53],["ἐκδικῆσαι",704174,106],["αὐτοὺς",702165,62],["ἐκδίκησιν",704175,9],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["Ιουδα",706768,18],["καὶ",707031,7],["ἐμνησικάκησαν",708967,150],["καὶ",707031,7],["ἐξεδίκησαν",704174,150],["δίκην",703702,9]],"Thus saith the Lord; Because of what the Idumeans have done in taking vengeance on the house of Juda, and [because they] have remembered injuries, and have exacted full recompence;"],["13",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["καὶ",707031,7],["ἐκτενῶ",704322,165],["τὴν",709436,8],["χεῖρά",713787,9],["μου",709032,133],["ἐπὶ",705080,0],["τὴν",709436,8],["Ιδουμαίαν",706503,9],["καὶ",707031,7],["ἐξολεθρεύσω",704956,165],["ἐξ",704132,0],["αὐτῆς",702165,86],["ἄνθρωπον",701163,6],["καὶ",707031,7],["κτῆνος",707934,25],["καὶ",707031,7],["θήσομαι",712849,181],["αὐτὴν",702165,104],["ἔρημον",705420,36],["καὶ",707031,7],["ἐκ",704132,0],["Θαιμαν",706062,118],["διωκόμενοι",703768,348],["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["πεσοῦνται",710481,135]],"therefore thus saith the Lord; I will also stretch out my hand upon Idumea, and will utterly destroy out of it man and beast; and will make it desolate; and they that are pursued out of Thæman shall fall by the sword."],["14",[["καὶ",707031,7],["δώσω",703654,165],["ἐκδίκησίν",704175,9],["μου",709032,133],["ἐπὶ",705080,0],["τὴν",709436,8],["Ιδουμαίαν",706503,9],["ἐν",704639,0],["χειρὶ",713787,1],["λαοῦ",708094,18],["μου",709032,133],["Ισραηλ",706839,18],["καὶ",707031,7],["ποιήσουσιν",710582,218],["ἐν",704639,0],["τῇ",709436,100],["Ιδουμαίᾳ",706503,1],["κατὰ",707200,0],["τὴν",709436,8],["ὀργήν",709728,9],["μου",709032,133],["καὶ",707031,7],["κατὰ",707200,0],["τὸν",709436,5],["θυμόν",706334,6],["μου",709032,133],["καὶ",707031,7],["ἐπιγνώσονται",705104,135],["τὴν",709436,8],["ἐκδίκησίν",704175,9],["μου",709032,133],["λέγει",708124,91],["κύριος",707996,4]],"And I will execute my vengeance on Idumea by the hand of my people Israel: and they shall deal in Idumea according to mine anger and according to my wrath, and they shall know my vengeance, saith the Lord."],["15",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἀνθ᾿",701227,0],["ὧν",709781,252],["ἐποίησαν",710582,150],["οἱ",709436,136],["ἀλλόφυλοι",700706,138],["ἐν",704639,0],["ἐκδικήσει",704175,1],["καὶ",707031,7],["ἐξανέστησαν",704865,150],["ἐκδίκησιν",704175,9],["ἐπιχαίροντες",705330,146],["ἐκ",704132,0],["ψυχῆς",714070,17],["τοῦ",709436,20],["ἐξαλεῖψαι",704852,106],["ἕως",705792,0],["αἰῶνος",700504,18]],"Therefore thus saith the Lord, Because the Philistines have wrought revengefully, and raised up vengeance rejoicing from their heart to destroy [the Israelites] to a man;"],["16",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐκτενῶ",704322,165],["τὴν",709436,8],["χεῖρά",713787,9],["μου",709032,133],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἀλλοφύλους",700706,60],["καὶ",707031,7],["ἐξολεθρεύσω",704956,165],["Κρῆτας",707898,57],["καὶ",707031,7],["ἀπολῶ",701513,165],["τοὺς",709436,58],["καταλοίπους",707317,60],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["τὴν",709436,8],["παραλίαν",710062,9]],"therefore thus saith the Lord; Behold, I [will] stretch out my hand upon the Philistines, and will utterly destroy the Cretans, and will cut off the remnant that dwell by the sea-coast."],["17",[["καὶ",707031,7],["ποιήσω",710582,165],["ἐν",704639,0],["αὐτοῖς",702165,151],["ἐκδικήσεις",704175,39],["μεγάλας",708653,119],["καὶ",707031,7],["ἐπιγνώσονται",705104,135],["διότι",703734,7],["ἐγὼ",704018,164],["κύριος",707996,4],["ἐν",704639,0],["τῷ",709436,53],["δοῦναι",703654,106],["τὴν",709436,8],["ἐκδίκησίν",704175,9],["μου",709032,133],["ἐπ᾿",705080,0],["αὐτούς",702165,62]],"And I will execute great vengeance upon them; and they shall know that I am the Lord, when I have brought my vengeance upon them."]]