[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72]],"Moreover the word of the Lord came to me, saying, Also, thou, son of man, say,"],["2",[["καὶ",707031,7],["σύ",712181,164],["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["εἰπόν",705373,176],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["τῇ",709436,100],["γῇ",703083,1],["τοῦ",709436,35],["Ισραηλ",706839,18],["πέρας",710281,15],["ἥκει",705956,91],["τὸ",709436,34],["πέρας",710281,15],["ἥκει",705956,91],["ἐπὶ",705080,0],["τὰς",709436,38],["τέσσαρας",712808,119],["πτέρυγας",711057,39],["τῆς",709436,16],["γῆς",703083,17]],"Thus saith the Lord; An end is come to the land of Israel, the end is come on the four corners of the land."],["3",[["ἥκει",705956,91],["τὸ",709436,34],["πέρας",710281,15]],"The end is come"],["4",[["ἐπὶ",705080,0],["σὲ",711598,163],["τὸν",709436,5],["κατοικοῦντα",707534,183],["τὴν",709436,8],["γῆν",703083,9],["ἥκει",705956,91],["ὁ",709436,3],["καιρός",707047,4],["ἤγγικεν",703939,171],["ἡ",709436,10],["ἡμέρα",705984,12],["οὐ",709805,28],["μετὰ",708780,0],["θορύβων",706293,81],["οὐδὲ",709816,7],["μετὰ",708780,0],["ὠδίνων",714094,65]],"on thee, the inhabitant of the land: the time is come, the day has drawn nigh, not with tumult, nor with pangs."],["5",[["νῦν",709384,28],["ἐγγύθεν",703946,28],["ἐκχεῶ",704368,165],["τὴν",709436,8],["ὀργήν",709728,9],["μου",709032,133],["ἐπὶ",705080,0],["σὲ",711598,163],["καὶ",707031,7],["συντελέσω",712510,165],["τὸν",709436,5],["θυμόν",706334,6],["μου",709032,133],["ἐν",704639,0],["σοὶ",711925,159],["καὶ",707031,7],["κρινῶ",707905,165],["σε",711598,163],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["σου",711945,133],["καὶ",707031,7],["δώσω",703654,165],["ἐπὶ",705080,0],["σὲ",711598,163],["πάντα",710177,68],["τὰ",709436,41],["βδελύγματά",702604,42],["σου",711945,133]],"Now I will pour out mine anger upon thee near at hand, and I will accomplish my wrath on thee: and I will judge thee for thy ways, and recompense upon thee all thine abominations."],["6",[["οὐ",709805,28],["φείσεται",713406,93],["ὁ",709436,3],["ὀφθαλμός",709870,4],["μου",709032,133],["οὐδὲ",709816,7],["μὴ",708851,28],["ἐλεήσω",704418,165],["διότι",703734,7],["τὰς",709436,38],["ὁδούς",709458,39],["σου",711945,133],["ἐπὶ",705080,0],["σὲ",711598,163],["δώσω",703654,165],["καὶ",707031,7],["τὰ",709436,41],["βδελύγματά",702604,42],["σου",711945,133],["ἐν",704639,0],["μέσῳ",708768,97],["σου",711945,133],["ἔσονται",704093,135],["καὶ",707031,7],["ἐπιγνώσῃ",705104,123],["διότι",703734,7],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["ὁ",709436,3],["τύπτων",713022,72]],"Mine eye shall not spare, nor will I have any mercy: for I will recompense thy ways upon thee, and thine abominations shall be in the midst of thee; and thou shalt know that I am the Lord that smite [thee]."],["7",[["νῦν",709384,28],["τὸ",709436,34],["πέρας",710281,15],["πρὸς",710844,0],["σέ",711598,163],["καὶ",707031,7],["ἀποστελῶ",701592,165],["ἐγὼ",704018,164],["ἐπὶ",705080,0],["σὲ",711598,163],["καὶ",707031,7],["ἐκδικήσω",704174,165],["σε",711598,163],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["σου",711945,133],["καὶ",707031,7],["δώσω",703654,165],["ἐπὶ",705080,0],["σὲ",711598,163],["πάντα",710177,68],["τὰ",709436,41],["βδελύγματά",702604,42],["σου",711945,133]],"Now the end [is come] to thee, and I will send [judgment] upon thee: and I will take vengeance on thy ways, and will recompense all thine abominations upon thee."],["8",[["οὐ",709805,28],["φείσεται",713406,93],["ὁ",709436,3],["ὀφθαλμός",709870,4],["μου",709032,133],["ἐπὶ",705080,0],["σέ",711598,163],["οὐδὲ",709816,7],["μὴ",708851,28],["ἐλεήσω",704418,165],["διότι",703734,7],["τὴν",709436,8],["ὁδόν",709458,9],["σου",711945,133],["ἐπὶ",705080,0],["σὲ",711598,163],["δώσω",703654,165],["καὶ",707031,7],["τὰ",709436,41],["βδελύγματά",702604,42],["σου",711945,133],["ἐν",704639,0],["μέσῳ",708768,97],["σου",711945,133],["ἔσται",704093,93],["καὶ",707031,7],["ἐπιγνώσῃ",705104,123],["διότι",703734,7],["ἐγὼ",704018,164],["κύριος",707996,4]],"Mine eye shall not spare, nor will I have any mercy: for I will recompense thy way upon thee, and thine abominations shall be in the midst of thee; and thou shalt know that I am the Lord."],["9",[["διότι",703734,7],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4]],"For thus saith the Lord; Behold, the end is come.",{"s":"d","q":0.5}],["10",[["ἰδοὺ",706497,88],["τὸ",709436,34],["πέρας",710281,15],["ἥκει",705956,91],["ἰδοὺ",706497,88],["ἡμέρα",705984,12],["κυρίου",707996,18],["εἰ",704071,7],["καὶ",707031,7],["ἡ",709436,10],["ῥάβδος",711135,12],["ἤνθηκεν",701152,171],["ἡ",709436,10],["ὕβρις",713051,12],["ἐξανέστηκεν",704865,171]],"Behold, the day of the Lord! although the rod has blossomed,"],["11",[["καὶ",707031,7],["συντρίψει",712520,127],["στήριγμα",712097,25],["ἀνόμου",701194,116],["καὶ",707031,7],["οὐ",709805,28],["μετὰ",708780,0],["θορύβου",706293,18],["οὐδὲ",709816,7],["μετὰ",708780,0],["σπουδῆς",712035,17]],"pride has sprung up, and will break the staff of the wicked one, and [that] not with tumult, nor with haste."],["12",[["ἥκει",705956,91],["ὁ",709436,3],["καιρός",707047,4],["ἰδοὺ",706497,88],["ἡ",709436,10],["ἡμέρα",705984,12],["ὁ",709436,3],["κτώμενος",707932,122],["μὴ",708851,28],["χαιρέτω",713665,31],["καὶ",707031,7],["ὁ",709436,3],["πωλῶν",711116,72],["μὴ",708851,28],["θρηνείτω",706306,31]],"The time is come, behold the day: let not the buyer rejoice, and let not the seller mourn."],["13",[["διότι",703734,7],["ὁ",709436,3],["κτώμενος",707932,122],["πρὸς",710844,0],["τὸν",709436,5],["πωλοῦντα",711116,183],["οὐκέτι",709827,28],["μὴ",708851,28],["ἐπιστρέψῃ",705278,172],["καὶ",707031,7],["ἄνθρωπος",701163,4],["ἐν",704639,0],["ὀφθαλμῷ",709870,114],["ζωῆς",705910,17],["αὐτοῦ",702165,102],["οὐ",709805,28],["κρατήσει",707879,127]],"For the buyer shall never again return to the seller, neither shall a man cleave with the eye [of hope] to his life."],["14",[["σαλπίσατε",711425,74],["ἐν",704639,0],["σάλπιγγι",711424,1],["καὶ",707031,7],["κρίνατε",707905,74],["τὰ",709436,41],["σύμπαντα",712324,68]],"Sound ye the trumpet, and pass sentence on all together."],["15",[["ὁ",709436,3],["πόλεμος",710605,4],["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["ἔξωθεν",704984,28],["καὶ",707031,7],["ὁ",709436,3],["λιμὸς",708210,4],["καὶ",707031,7],["ὁ",709436,3],["θάνατος",706096,4],["ἔσωθεν",705523,28],["ὁ",709436,3],["ἐν",704639,0],["τῷ",709436,53],["πεδίῳ",710215,54],["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["τελευτήσει",712781,127],["τοὺς",709436,58],["δὲ",703303,11],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["λιμὸς",708210,4],["καὶ",707031,7],["θάνατος",706096,4],["συντελέσει",712510,127]],"[There shall be] war with the sword without, and famine and pestilence within: he that is in the field shall die by the sword; and famine and pestilence shall destroy them that are in the city."],["16",[["καὶ",707031,7],["ἀνασωθήσονται",701064,144],["οἱ",709436,136],["ἀνασῳζόμενοι",701064,348],["ἐξ",704132,0],["αὐτῶν",702165,40],["καὶ",707031,7],["ἔσονται",704093,135],["ἐπὶ",705080,0],["τῶν",709436,43],["ὀρέων",709768,44],["πάντας",710177,60],["ἀποκτενῶ",701498,165],["ἕκαστον",704133,27],["ἐν",704639,0],["ταῖς",709436,75],["ἀδικίαις",700271,76],["αὐτοῦ",702165,102]],"But they that escape of them shall be delivered, and shall be upon the mountains: and I will slay all [the rest], every one for his iniquities."],["17",[["πᾶσαι",710177,192],["χεῖρες",713787,191],["ἐκλυθήσονται",704254,144],["καὶ",707031,7],["πάντες",710177,138],["μηροὶ",708885,52],["μολυνθήσονται",708987,144],["ὑγρασίᾳ",713062,1]],"All hands shall be completely weakened, and all thighs shall be defiled with moisture."],["18",[["καὶ",707031,7],["περιζώσονται",710317,135],["σάκκους",711386,57],["καὶ",707031,7],["καλύψει",707102,127],["αὐτοὺς",702165,62],["θάμβος",706082,15],["καὶ",707031,7],["ἐπὶ",705080,0],["πᾶν",710177,26],["πρόσωπον",710986,15],["αἰσχύνη",700483,12],["ἐπ᾿",705080,0],["αὐτούς",702165,62],["καὶ",707031,7],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["κεφαλὴν",707639,9],["φαλάκρωμα",713324,15]],"And they shall gird themselves with sackcloth, and amazement shall cover them; and shame shall be upon them, [even] upon every face, and baldness upon every head."],["19",[["τὸ",709436,34],["ἀργύριον",701707,15],["αὐτῶν",702165,40],["ῥιφήσεται",711267,134],["ἐν",704639,0],["ταῖς",709436,75],["πλατείαις",710509,291],["καὶ",707031,7],["τὸ",709436,34],["χρυσίον",713972,15],["αὐτῶν",702165,40],["ὑπεροφθήσεται",713154,134],["αἱ",709436,190],["ψυχαὶ",714070,191],["αὐτῶν",702165,40],["οὐ",709805,28],["μὴ",708851,28],["ἐμπλησθῶσιν",704592,272],["καὶ",707031,7],["αἱ",709436,190],["κοιλίαι",707761,191],["αὐτῶν",702165,40],["οὐ",709805,28],["μὴ",708851,28],["πληρωθῶσιν",710543,272],["διότι",703734,7],["βάσανος",702570,12],["τῶν",709436,130],["ἀδικιῶν",700271,65],["αὐτῶν",702165,40],["ἐγένετο",703104,23]],"Their silver shall be cast forth in the streets, and their gold shall be despised: their souls shall not be satisfied, and their bellies shall not be filled: for it was the punishment of their iniquities."],["20",[["ἐκλεκτὰ",704240,68],["κόσμου",707851,18],["εἰς",704105,0],["ὑπερηφανίαν",713138,9],["ἔθεντο",712849,189],["αὐτὰ",702165,71],["καὶ",707031,7],["εἰκόνας",704089,39],["τῶν",709436,43],["βδελυγμάτων",702604,44],["αὐτῶν",702165,40],["ἐποίησαν",710582,150],["ἐξ",704132,0],["αὐτῶν",702165,40],["ἕνεκεν",704709,0],["τούτου",709858,102],["δέδωκα",703654,89],["αὐτὰ",702165,71],["αὐτοῖς",702165,151],["εἰς",704105,0],["ἀκαθαρσίαν",700507,9]],"[As for] their choice ornaments, they employed them for pride, and they made of them images of their abominations: therefore have I made them uncleanness to them."],["21",[["καὶ",707031,7],["παραδώσω",710014,165],["αὐτὰ",702165,71],["εἰς",704105,0],["χεῖρας",713787,39],["ἀλλοτρίων",700699,169],["τοῦ",709436,20],["διαρπάσαι",703562,106],["αὐτὰ",702165,71],["καὶ",707031,7],["τοῖς",709436,147],["λοιμοῖς",708245,148],["τῆς",709436,16],["γῆς",703083,17],["εἰς",704105,0],["σκῦλα",711902,42],["καὶ",707031,7],["βεβηλώσουσιν",702614,218],["αὐτά",702165,71]],"And I will deliver them into the hands of strangers to make them a prey, and to the pests of the earth for a spoil; and they shall profane them."],["22",[["καὶ",707031,7],["ἀποστρέψω",701598,165],["τὸ",709436,24],["πρόσωπόν",710986,25],["μου",709032,133],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["καὶ",707031,7],["μιανοῦσιν",708900,218],["τὴν",709436,8],["ἐπισκοπήν",705255,9],["μου",709032,133],["καὶ",707031,7],["εἰσελεύσονται",704114,135],["εἰς",704105,0],["αὐτὰ",702165,71],["ἀφυλάκτως",702237,28],["καὶ",707031,7],["βεβηλώσουσιν",702614,218],["αὐτά",702165,71]],"And I will turn away my face from them, and they shall defile my charge, and shall go in to them unguardedly, and profane them."],["23",[["καὶ",707031,7],["ποιήσουσι",710582,218],["φυρμόν",713628,6],["διότι",703734,7],["ἡ",709436,10],["γῆ",703083,12],["πλήρης",710541,29],["λαῶν",708094,81],["καὶ",707031,7],["ἡ",709436,10],["πόλις",710612,12],["πλήρης",710541,29],["ἀνομίας",701192,17]],"And they shall work uncleanness: because the land is full of strange nations, and the city is full of iniquity."],["24",[["καὶ",707031,7],["ἀποστρέψω",701598,165],["τὸ",709436,24],["φρύαγμα",713598,25],["τῆς",709436,16],["ἰσχύος",706858,17],["αὐτῶν",702165,40],["καὶ",707031,7],["μιανθήσεται",708900,134],["τὰ",709436,41],["ἅγια",700159,68],["αὐτῶν",702165,40]],"And I will turn back the boasting of their strength; and their holy things shall be defiled."],["25",[["ἐξιλασμὸς",704934,4],["ἥξει",705956,127],["καὶ",707031,7],["ζητήσει",705879,127],["εἰρήνην",704098,9],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93]],"And [though] propitiation shall come, and [one] shall seek peace, yet there shall be none."],["26",[["οὐαὶ",709807,88],["ἐπὶ",705080,0],["οὐαὶ",709807,88],["ἔσται",704093,93],["καὶ",707031,7],["ἀγγελία",700139,12],["ἐπ᾿",705080,0],["ἀγγελίαν",700139,9],["ἔσται",704093,93],["καὶ",707031,7],["ζητηθήσεται",705879,134],["ὅρασις",709721,12],["ἐκ",704132,0],["προφήτου",711009,18],["καὶ",707031,7],["νόμος",709349,4],["ἀπολεῖται",701513,93],["ἐξ",704132,0],["ἱερέως",706614,18],["καὶ",707031,7],["βουλὴ",702792,12],["ἐκ",704132,0],["πρεσβυτέρων",710735,527]],"There shall be woe upon woe, and there shall be message upon message; and a vision shall be sought from a prophet; but the law shall perish from the priest, and counsel from the elders."],["27",[["ἄρχων",701862,4],["ἐνδύσεται",704701,93],["ἀφανισμόν",702183,6],["καὶ",707031,7],["αἱ",709436,190],["χεῖρες",713787,191],["τοῦ",709436,35],["λαοῦ",708094,18],["τῆς",709436,16],["γῆς",703083,17],["παραλυθήσονται",710070,144],["κατὰ",707200,0],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτῶν",702165,40],["ποιήσω",710582,165],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["κρίμασιν",707903,96],["αὐτῶν",702165,40],["ἐκδικήσω",704174,165],["αὐτούς",702165,62],["καὶ",707031,7],["γνώσονται",703105,135],["ὅτι",709803,7],["ἐγὼ",704018,164],["κύριος",707996,4]],"The prince shall clothe himself with desolation, and the hands of the people of the land shall be made feeble: I will do to them according to their ways, and according to their judgments will I punish them; and they shall know that I am the Lord."]]