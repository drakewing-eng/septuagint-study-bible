6,4],["κύριος",707996,4]],"I will feed my sheep, and I will cause them to rest; and they shall know that I am the Lord: thus saith the Lord God."],["16",[["τὸ",709436,24],["ἀπολωλὸς",701513,409],["ζητήσω",705879,165],["καὶ",707031,7],["τὸ",709436,24],["πλανώμενον",710495,214],["ἐπιστρέψω",705278,165],["καὶ",707031,7],["τὸ",709436,24],["συντετριμμένον",712520,448],["καταδήσω",707239,165],["καὶ",707031,7],["τὸ",709436,24],["ἐκλεῖπον",704237,47],["ἐνισχύσω",704750,165],["καὶ",707031,7],["τὸ",709436,24],["ἰσχυρὸν",706855,46],["φυλάξω",713619,165],["καὶ",707031,7],["βοσκήσω",702767,165],["αὐτὰ",702165,71],["μετὰ",708780,0],["κρίματος",707903,21]],"I will seek that which is lost, and I will recover the stray one, and will bind up that which was broken, and will strengthen the fainting, and will guard the strong, and will feed them with judgment."],["17",[["καὶ",707031,7],["ὑμεῖς",713081,219],["πρόβατα",710768,64],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["διακρινῶ",703488,165],["ἀνὰ",700902,0],["μέσον",708768,27],["προβάτου",710768,21],["καὶ",707031,7],["προβάτου",710768,21],["κριῶν",707906,81],["καὶ",707031,7],["τράγων",712917,81]],"And [as for] you, ye sheep, thus saith the Lord God, Behold, I will distinguish between sheep and sheep, [between] rams and he-goats."],["18",[["καὶ",707031,7],["οὐχ",709805,28],["ἱκανὸν",706710,26],["ὑμῖν",713084,90],["ὅτι",709803,7],["τὴν",709436,8],["καλὴν",707097,36],["νομὴν",709337,9],["ἐνέμεσθε",709253,501],["καὶ",707031,7],["τὰ",709436,41],["κατάλοιπα",707317,68],["τῆς",709436,16],["νομῆς",709337,17],["ὑμῶν",713091,145],["κατεπατεῖτε",707360,399],["τοῖς",709436,147],["ποσὶν",710707,148],["ὑμῶν",713091,145],["καὶ",707031,7],["τὸ",709436,24],["καθεστηκὸς",707011,409],["ὕδωρ",713071,25],["ἐπίνετε",710478,399],["καὶ",707031,7],["τὸ",709436,24],["λοιπὸν",708247,46],["τοῖς",709436,147],["ποσὶν",710707,148],["ὑμῶν",713091,145],["ἐταράσσετε",712721,399]],"And [is it] not enough for you that ye fed on the good pasture, that ye trampled with your feet the remnant of your pasture? and [that] ye drank the standing water, [that] ye disturbed the residue with your feet?"],["19",[["καὶ",707031,7],["τὰ",709436,41],["πρόβατά",710768,42],["μου",709032,133],["τὰ",709436,41],["πατήματα",710188,42],["τῶν",709436,80],["ποδῶν",710707,81],["ὑμῶν",713091,145],["ἐνέμοντο",709253,139],["καὶ",707031,7],["τὸ",709436,24],["τεταραγμένον",712721,448],["ὕδωρ",713071,25],["ὑπὸ",713184,0],["τῶν",709436,80],["ποδῶν",710707,81],["ὑμῶν",713091,145],["ἔπινον",710478,137]],"So my sheep fed on that which ye had trampled with your feet; and they drank the water that had been disturbed by your feet."],["20",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["διακρινῶ",703488,165],["ἀνὰ",700902,0],["μέσον",708768,27],["προβάτου",710768,21],["ἰσχυροῦ",706855,92],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,27],["προβάτου",710768,21],["ἀσθενοῦς",701939,92]],"Therefore thus saith the Lord God; Behold, I will separate between the strong sheep and the weak sheep."],["21",[["ἐπὶ",705080,0],["ταῖς",709436,75],["πλευραῖς",710524,76],["καὶ",707031,7],["τοῖς",709436,147],["ὤμοις",714114,148],["ὑμῶν",713091,145],["διωθεῖσθε",703767,374],["καὶ",707031,7],["τοῖς",709436,95],["κέρασιν",707625,96],["ὑμῶν",713091,145],["ἐκερατίζετε",707628,399],["καὶ",707031,7],["πᾶν",710177,46],["τὸ",709436,24],["ἐκλεῖπον",704237,47],["ἐξεθλίβετε",704199,399]],"Ye did thrust with your sides and shoulders, and pushed with your horns, and ye cruelly treated all the sick."],["22",[["καὶ",707031,7],["σώσω",712627,165],["τὰ",709436,41],["πρόβατά",710768,42],["μου",709032,133],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ὦσιν",704093,271],["ἔτι",705538,28],["εἰς",704105,0],["προνομήν",710827,9],["καὶ",707031,7],["κρινῶ",707905,165],["ἀνὰ",700902,0],["μέσον",708768,27],["κριοῦ",707906,18],["πρὸς",710844,0],["κριόν",707906,6]],"Therefore I will save my sheep, and they shall not be any more for a prey; and will judge between ram and ram."],["23",[["καὶ",707031,7],["ἀναστήσω",701173,165],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["ποιμένα",710596,6],["ἕνα",704106,27],["καὶ",707031,7],["ποιμανεῖ",710594,127],["αὐτούς",702165,62],["τὸν",709436,5],["δοῦλόν",703817,6],["μου",709032,133],["Δαυιδ",703232,6],["καὶ",707031,7],["ἔσται",704093,93],["αὐτῶν",702165,40],["ποιμήν",710596,4]],"And I will raise up one shepherd over them, and he shall tend them, [even] my servant David, and he shall be their shepherd;"],["24",[["καὶ",707031,7],["ἐγὼ",704018,164],["κύριος",707996,4],["ἔσομαι",704093,181],["αὐτοῖς",702165,151],["εἰς",704105,0],["θεόν",706192,6],["καὶ",707031,7],["Δαυιδ",703232,4],["ἐν",704639,0],["μέσῳ",708768,30],["αὐτῶν",702165,40],["ἄρχων",701862,4],["ἐγὼ",704018,164],["κύριος",707996,4],["ἐλάλησα",708071,155]],"and I the Lord will be to them a God, and David a prince in the midst of them; I the Lord have spoken it."],["25",[["καὶ",707031,7],["διαθήσομαι",703609,181],["τῷ",709436,113],["Δαυιδ",703232,114],["διαθήκην",703456,9],["εἰρήνης",704098,17],["καὶ",707031,7],["ἀφανιῶ",702182,165],["θηρία",706252,42],["πονηρὰ",710660,68],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["κατοικήσουσιν",707534,218],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["καὶ",707031,7],["ὑπνώσουσιν",713182,218],["ἐν",704639,0],["τοῖς",709436,147],["δρυμοῖς",703836,148]],"And I will make with David a covenant of peace, and I will utterly destroy evil beasts from off the land; and they shall dwell in the wilderness, and sleep in the forests."],["26",[["καὶ",707031,7],["δώσω",703654,165],["αὐτοὺς",702165,62],["περικύκλῳ",710340,28],["τοῦ",709436,20],["ὄρους",709768,21],["μου",709032,133],["καὶ",707031,7],["δώσω",703654,165],["τὸν",709436,5],["ὑετὸν",713074,6],["ὑμῖν",713084,90],["ὑετὸν",713074,6],["εὐλογίας",705633,17]],"And I will settle them round