[["1",[["καὶ",707031,7],["σὺ",712181,164],["λαβὲ",708076,176],["θρῆνον",706309,6],["ἐπὶ",705080,0],["τὸν",709436,5],["ἄρχοντα",701862,6],["τοῦ",709436,35],["Ισραηλ",706839,18]],"Moreover do thou take up a lamentation for the prince of Israel,"],["2",[["καὶ",707031,7],["ἐρεῖς",705415,166],["τί",712867,24],["ἡ",709436,10],["μήτηρ",708892,12],["σου",711945,133],["σκύμνος",711903,4],["ἐν",704639,0],["μέσῳ",708768,97],["λεόντων",708171,81],["ἐγενήθη",703104,37],["ἐν",704639,0],["μέσῳ",708768,97],["λεόντων",708171,81],["ἐπλήθυνεν",710530,13],["σκύμνους",711903,57],["αὐτῆς",702165,86]],"and say, Why is thy mother become a whelp in the midst of lions? in the midst of lions she has multiplied her whelps."],["3",[["καὶ",707031,7],["ἀπεπήδησεν",701544,2],["εἷς",704106,14],["τῶν",709436,80],["σκύμνων",711903,81],["αὐτῆς",702165,86],["λέων",708171,4],["ἐγένετο",703104,23],["καὶ",707031,7],["ἔμαθεν",708480,2],["τοῦ",709436,20],["ἁρπάζειν",701804,55],["ἁρπάγματα",701803,42],["ἀνθρώπους",701163,57],["ἔφαγεν",713296,2]],"And one of her whelps sprang forth; he became a lion, and learned to take prey, he devoured men."],["4",[["καὶ",707031,7],["ἤκουσαν",700587,150],["κατ᾿",707200,0],["αὐτοῦ",702165,102],["ἔθνη",704068,64],["ἐν",704639,0],["τῇ",709436,100],["διαφθορᾷ",703625,1],["αὐτῶν",702165,40],["συνελήμφθη",712262,37],["καὶ",707031,7],["ἤγαγον",700209,150],["αὐτὸν",702165,85],["ἐν",704639,0],["κημῷ",707653,114],["εἰς",704105,0],["γῆν",703083,9],["Αἰγύπτου",700401,17]],"And the nations heard a report of him; he was caught in their pit, and they brought him into the land of Egypt in chains."],["5",[["καὶ",707031,7],["εἶδεν",709725,2],["ὅτι",709803,7],["ἀπῶσται",701659,171],["ἀπ᾿",701425,0],["αὐτῆς",702165,86],["καὶ",707031,7],["ἀπώλετο",701513,23],["ἡ",709436,10],["ὑπόστασις",713241,12],["αὐτῆς",702165,86],["καὶ",707031,7],["ἔλαβεν",708076,2],["ἄλλον",700697,85],["ἐκ",704132,0],["τῶν",709436,80],["σκύμνων",711903,81],["αὐτῆς",702165,86],["λέοντα",708171,6],["ἔταξεν",712730,2],["αὐτόν",702165,85]],"And she saw that he was driven away from her, [and] her hope [of him] perished, and she took another of her whelps; she made him a lion."],["6",[["καὶ",707031,7],["ἀνεστρέφετο",701060,19],["ἐν",704639,0],["μέσῳ",708768,97],["λεόντων",708171,81],["λέων",708171,4],["ἐγένετο",703104,23],["καὶ",707031,7],["ἔμαθεν",708480,2],["ἁρπάζειν",701804,55],["ἁρπάγματα",701803,42],["ἀνθρώπους",701163,57],["ἔφαγεν",713296,2]],"And he went up and down in the midst of lions, he became a lion, and learned to take prey, he devoured men."],["7",[["καὶ",707031,7],["ἐνέμετο",709253,19],["τῷ",709436,113],["θράσει",706300,30],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰς",709436,38],["πόλεις",710612,39],["αὐτῶν",702165,40],["ἐξηρήμωσεν",704907,2],["καὶ",707031,7],["ἠφάνισεν",702182,2],["γῆν",703083,9],["καὶ",707031,7],["τὸ",709436,24],["πλήρωμα",710544,25],["αὐτῆς",702165,86],["ἀπὸ",701425,0],["φωνῆς",713640,17],["ὠρύματος",714141,21],["αὐτοῦ",702165,102]],"And he prowled in his boldness and laid waste their cities, and made the land desolate, and the fulness of it, by the voice of his roaring."],["8",[["καὶ",707031,7],["ἔδωκαν",703654,150],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["ἔθνη",704068,42],["ἐκ",704132,0],["χωρῶν",714011,65],["κυκλόθεν",707956,28],["καὶ",707031,7],["ἐξεπέτασαν",704277,150],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["δίκτυα",703703,42],["αὐτῶν",702165,40],["ἐν",704639,0],["διαφθορᾷ",703625,1],["αὐτῶν",702165,40],["συνελήμφθη",712262,37]],"Then the nations set upon him from the countries round about, and they spread their nets upon him: he was taken in their pit."],["9",[["καὶ",707031,7],["ἔθεντο",712849,189],["αὐτὸν",702165,85],["ἐν",704639,0],["κημῷ",707653,114],["καὶ",707031,7],["ἐν",704639,0],["γαλεάγρᾳ",702934,1],["ἦλθεν",705453,2],["πρὸς",710844,0],["βασιλέα",702580,6],["Βαβυλῶνος",702352,17],["καὶ",707031,7],["εἰσήγαγεν",704107,2],["αὐτὸν",702165,85],["εἰς",704105,0],["φυλακήν",713613,9],["ὅπως",709719,7],["μὴ",708851,28],["ἀκουσθῇ",700587,384],["ἡ",709436,10],["φωνὴ",713640,12],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τὰ",709436,41],["ὄρη",709768,42],["τοῦ",709436,35],["Ισραηλ",706839,18]],"And they put him in chains and in a cage, [and] he came to the king of Babylon; and he cast him into prison, that his voice should not be heard on the mountains of Israel."],["10",[["ἡ",709436,10],["μήτηρ",708892,12],["σου",711945,133],["ὡς",714148,7],["ἄμπελος",700870,12],["ὡς",714148,7],["ἄνθος",701157,15],["ἐν",704639,0],["ῥόᾳ",711273,1],["ἐν",704639,0],["ὕδατι",713071,54],["πεφυτευμένη",713636,203],["ὁ",709436,3],["καρπὸς",707169,4],["αὐτῆς",702165,86],["καὶ",707031,7],["ὁ",709436,3],["βλαστὸς",702736,4],["αὐτῆς",702165,86],["ἐγένετο",703104,23],["ἐξ",704132,0],["ὕδατος",713071,21],["πολλοῦ",710646,92]],"Thy mother was as a vine and as a blossom on a pomegranate tree, planted by water: her fruit and her shoots abounded by reason of much water."],["11",[["καὶ",707031,7],["ἐγένετο",703104,23],["αὐτῇ",702165,105],["ῥάβδος",711135,12],["ἰσχύος",706858,17],["ἐπὶ",705080,0],["φυλὴν",713620,9],["ἡγουμένων",705931,299],["καὶ",707031,7],["ὑψώθη",713289,37],["τῷ",709436,53],["μεγέθει",708656,54],["αὐτῆς",702165,86],["ἐν",704639,0],["μέσῳ",708768,97],["στελεχῶν",712062,44],["καὶ",707031,7],["εἶδεν",709725,2],["τὸ",709436,24],["μέγεθος",708656,25],["αὐτῆς",702165,86],["ἐν",704639,0],["πλήθει",710529,54],["κλημάτων",707720,44],["αὐτῆς",702165,86]],"And she became a rod for a tribe of princes, and was elevated in her bulk in the midst of [other] trees, and she saw her bulk in the multitude of her branches."],["12",[["καὶ",707031,7],["κατεκλάσθη",707270,37],["ἐν",704639,0],["θυμῷ",706334,114],["ἐπὶ",705080,0],["γῆν",703083,9],["ἐρρίφη",711267,37],["καὶ",707031,7],["ἄνεμος",701123,4],["ὁ",709436,3],["καύσων",707567,4],["ἐξήρανεν",709419,2],["τὰ",709436,41],["ἐκλεκτὰ",704240,68],["αὐτῆς",702165,86],["ἐξεδικήθη",704174,37],["καὶ",707031,7],["ἐξηράνθη",709419,37],["ἡ",709436,10],["ῥάβδος",711135,12],["ἰσχύος",706858,17],["αὐτῆς",702165,86],["πῦρ",711088,25],["ἀνήλωσεν",700992,2],["αὐτήν",702165,104]],"But she was broken down in wrath, she was cast upon the ground, and the east wind dried up her choice [branches]: vengeance came upon them, and the rod of her strength was withered; fire consumed it."],["13",[["καὶ",707031,7],["νῦν",709384,28],["πεφύτευκαν",713636,353],["αὐτὴν",702165,104],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["ἐν",704639,0],["γῇ",703083,1],["ἀνύδρῳ",701285,101]],"And now they have planted her in the wilderness, in a dry land."],["14",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["πῦρ",711088,15],["ἐκ",704132,0],["ῥάβδου",711135,17],["ἐκλεκτῶν",704240,169],["αὐτῆς",702165,86],["καὶ",707031,7],["κατέφαγεν",707519,2],["αὐτήν",702165,104],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ἐν",704639,0],["αὐτῇ",702165,105],["ῥάβδος",711135,12],["ἰσχύος",706858,17],["φυλὴ",713620,12],["εἰς",704105,0],["παραβολὴν",710003,9],["θρήνου",706309,18],["ἐστὶν",704093,91],["καὶ",707031,7],["ἔσται",704093,93],["εἰς",704105,0],["θρῆνον",706309,6]],"And fire is gone out of a rod of her choice [boughs], and has devoured her; and there was no rod of strength in her. Her race is become a parable of lamentation, and it shall be for a lamentation."]]