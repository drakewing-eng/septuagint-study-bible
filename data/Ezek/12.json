[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72]],"And the word of the Lord came to me, saying,"],["2",[["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["ἐν",704639,0],["μέσῳ",708768,97],["τῶν",709436,130],["ἀδικιῶν",700271,65],["αὐτῶν",702165,40],["σὺ",712181,164],["κατοικεῖς",707534,154],["οἳ",709781,250],["ἔχουσιν",705785,197],["ὀφθαλμοὺς",709870,57],["τοῦ",709436,20],["βλέπειν",702740,55],["καὶ",707031,7],["οὐ",709805,28],["βλέπουσιν",702740,197],["καὶ",707031,7],["ὦτα",709852,42],["ἔχουσιν",705785,197],["τοῦ",709436,20],["ἀκούειν",700587,55],["καὶ",707031,7],["οὐκ",709805,28],["ἀκούουσιν",700587,197],["διότι",703734,7],["οἶκος",709516,4],["παραπικραίνων",710087,72],["ἐστίν",704093,91]],"Son of man, thou dwellest in the midst of the iniquities of those, who have eyes to see, and see not; and have ears to hear, and hear not: because it is a provoking house."],["3",[["καὶ",707031,7],["σύ",712181,164],["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["ποίησον",710582,176],["σεαυτῷ",711599,50],["σκεύη",711844,42],["αἰχμαλωσίας",700499,17],["ἡμέρας",705984,17],["ἐνώπιον",704823,0],["αὐτῶν",702165,40],["καὶ",707031,7],["αἰχμαλωτευθήσῃ",700500,364],["ἐκ",704132,0],["τοῦ",709436,35],["τόπου",712903,18],["σου",711945,133],["εἰς",704105,0],["ἕτερον",705535,27],["τόπον",712903,6],["ἐνώπιον",704823,0],["αὐτῶν",702165,40],["ὅπως",709719,7],["ἴδωσιν",709725,234],["διότι",703734,7],["οἶκος",709516,4],["παραπικραίνων",710087,72],["ἐστίν",704093,91]],"Thou therefore, son of man, prepare thyself baggage for going into captivity by day in their sight; and thou shalt be led into captivity from thy place into another place in their sight; that they may see that it is a provoking house."],["4",[["καὶ",707031,7],["ἐξοίσεις",704356,166],["τὰ",709436,41],["σκεύη",711844,42],["σου",711945,133],["ὡς",714148,7],["σκεύη",711844,42],["αἰχμαλωσίας",700499,17],["ἡμέρας",705984,17],["κατ᾿",707200,0],["ὀφθαλμοὺς",709870,57],["αὐτῶν",702165,40],["καὶ",707031,7],["σὺ",712181,164],["ἐξελεύσῃ",704909,123],["ἑσπέρας",705500,17],["ὡς",714148,7],["ἐκπορεύεται",704293,117],["αἰχμάλωτος",700503,14]],"And thou shalt carry forth thy baggage, baggage for captivity, by day before their eyes: and thou shalt go forth at even, as a captive goes forth, in their sight."],["5",[["ἐνώπιον",704823,0],["αὐτῶν",702165,40],["διόρυξον",703732,176],["σεαυτῷ",711599,50],["εἰς",704105,0],["τὸν",709436,5],["τοῖχον",712879,6],["καὶ",707031,7],["διεξελεύσῃ",703665,123],["δι᾿",703417,0],["αὐτοῦ",702165,102]],"Dig for thyself into the wall [of the house], and thou shalt pass through it in their sight:"],["6",[["ἐνώπιον",704823,0],["αὐτῶν",702165,40],["ἐπ᾿",705080,0],["ὤμων",714114,81],["ἀναλημφθήσῃ",700984,364],["καὶ",707031,7],["κεκρυμμένος",707923,251],["ἐξελεύσῃ",704909,123],["τὸ",709436,34],["πρόσωπόν",710986,15],["σου",711945,133],["συγκαλύψεις",712201,166],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἴδῃς",709725,175],["τὴν",709436,8],["γῆν",703083,9],["διότι",703734,7],["τέρας",712793,25],["δέδωκά",703654,89],["σε",711598,163],["τῷ",709436,113],["οἴκῳ",709516,114],["Ισραηλ",706839,18]],"thou shalt be lifted up on [men's] shoulders, and shalt go forth in secret: thou shalt cover thy face, and shalt not see the ground: because I have made thee a sign to the house of Israel."],["7",[["καὶ",707031,7],["ἐποίησα",710582,155],["οὕτως",709859,28],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἐνετείλατό",704791,23],["μοι",708974,159],["καὶ",707031,7],["σκεύη",711844,42],["ἐξήνεγκα",704356,155],["ὡς",714148,7],["σκεύη",711844,42],["αἰχμαλωσίας",700499,17],["ἡμέρας",705984,17],["καὶ",707031,7],["ἑσπέρας",705500,17],["διώρυξα",703732,155],["ἐμαυτῷ",704545,50],["τὸν",709436,5],["τοῖχον",712879,6],["καὶ",707031,7],["κεκρυμμένος",707923,251],["ἐξῆλθον",704909,155],["ἐπ᾿",705080,0],["ὤμων",714114,81],["ἀνελήμφθην",700984,156],["ἐνώπιον",704823,0],["αὐτῶν",702165,40]],"And I did thus according to all that he commanded me; and I carried forth my baggage for captivity by day, and in the evening I dug through the wall for myself, and went out secretly; I was taken up on [men's] shoulders before them."],["8",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["τὸ",709436,24],["πρωὶ",711021,28],["λέγων",708124,72]],"And the word of the Lord came to me in the morning, saying,"],["9",[["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["οὐκ",709805,28],["εἶπαν",705373,150],["πρὸς",710844,0],["σὲ",711598,163],["ὁ",709436,3],["οἶκος",709516,4],["τοῦ",709436,35],["Ισραηλ",706839,18],["οἶκος",709516,4],["ὁ",709436,3],["παραπικραίνων",710087,72],["τί",712867,126],["σὺ",712181,164],["ποιεῖς",710582,154]],"Son of man, have not the house of Israel, the provoking house, said to thee, What doest thou?"],["10",[["εἰπὸν",705373,176],["πρὸς",710844,0],["αὐτούς",702165,62],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["κύριος",707996,4],["ὁ",709436,3],["ἄρχων",701862,4],["καὶ",707031,7],["ὁ",709436,3],["ἀφηγούμενος",702203,122],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["παντὶ",710177,30],["οἴκῳ",709516,114],["Ισραηλ",706839,114],["οἵ",709781,250],["εἰσιν",704093,197],["ἐν",704639,0],["μέσῳ",708768,97],["αὐτῶν",702165,40]],"Say to them, Thus saith the Lord God, the Prince and the Ruler in Israel, even to all the house of Israel who are in the midst of them:"],["11",[["εἰπὸν",705373,176],["ὅτι",709803,7],["ἐγὼ",704018,164],["τέρατα",712793,25],["ποιῶ",710582,157],["ἐν",704639,0],["μέσῳ",708768,97],["αὐτῆς",702165,86],["ὃν",709781,112],["τρόπον",712980,6],["πεποίηκα",710582,89],["οὕτως",709859,28],["ἔσται",704093,93],["αὐτοῖς",702165,151],["ἐν",704639,0],["μετοικεσίᾳ",708832,1],["καὶ",707031,7],["ἐν",704639,0],["αἰχμαλωσίᾳ",700499,1],["πορεύσονται",710667,135]],"say, I am performing signs: as I have done, so shall it be to him: they shall go into banishment and captivity."],["12",[["καὶ",707031,7],["ὁ",709436,3],["ἄρχων",701862,4],["ἐν",704639,0],["μέσῳ",708768,97],["αὐτῶν",702165,40],["ἐπ᾿",705080,0],["ὤμων",714114,81],["ἀρθήσεται",700473,134],["καὶ",707031,7],["κεκρυμμένος",707923,251],["ἐξελεύσεται",704909,93],["διὰ",703417,0],["τοῦ",709436,35],["τοίχου",712879,18],["καὶ",707031,7],["διορύξει",703732,127],["τοῦ",709436,20],["ἐξελθεῖν",704909,106],["αὐτὸν",702165,85],["δι᾿",703417,0],["αὐτοῦ",702165,102],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["συγκαλύψει",712201,127],["ὅπως",709719,7],["μὴ",708851,28],["ὁραθῇ",709725,384],["ὀφθαλμῷ",709870,114],["καὶ",707031,7],["αὐτὸς",702165,121],["τὴν",709436,8],["γῆν",703083,9],["οὐκ",709805,28],["ὄψεται",709725,93]],"And the prince in the midst of them shall be borne upon shoulders, and shall go forth in secret through the wall, and shall dig so that he may go forth thereby: he shall cover his face, that he may not be seen by [any] eye, and he himself shall not see the ground."],["13",[["καὶ",707031,7],["ἐκπετάσω",704278,165],["τὸ",709436,24],["δίκτυόν",703703,25],["μου",709032,133],["ἐπ᾿",705080,0],["αὐτόν",702165,85],["καὶ",707031,7],["συλλημφθήσεται",712262,134],["ἐν",704639,0],["τῇ",709436,100],["περιοχῇ",710360,1],["μου",709032,133],["καὶ",707031,7],["ἄξω",700209,165],["αὐτὸν",702165,85],["εἰς",704105,0],["Βαβυλῶνα",702352,9],["εἰς",704105,0],["γῆν",703083,9],["Χαλδαίων",713678,81],["καὶ",707031,7],["αὐτὴν",702165,104],["οὐκ",709805,28],["ὄψεται",709725,93],["καὶ",707031,7],["ἐκεῖ",704181,28],["τελευτήσει",712781,127]],"And I will spread out my net upon him, and he shall be caught in my toils: and I will bring him to Babylon to the land of the Chaldeans; but he shall not see it, though he shall die there."],["14",[["καὶ",707031,7],["πάντας",710177,60],["τοὺς",709436,58],["κύκλῳ",707959,114],["αὐτοῦ",702165,102],["τοὺς",709436,58],["βοηθοὺς",702748,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["πάντας",710177,60],["τοὺς",709436,58],["ἀντιλαμβανομένους",701243,236],["αὐτοῦ",702165,102],["διασπερῶ",703584,165],["εἰς",704105,0],["πάντα",710177,27],["ἄνεμον",701123,6],["καὶ",707031,7],["ῥομφαίαν",711291,9],["ἐκκενώσω",704210,165],["ὀπίσω",709697,0],["αὐτῶν",702165,40]],"And I will scatter to every wind all his assistants round about him, and all that help him; and I will draw out a sword after them."],["15",[["καὶ",707031,7],["γνώσονται",703105,135],["διότι",703734,7],["ἐγὼ",704018,164],["κύριος",707996,4],["ἐν",704639,0],["τῷ",709436,53],["διασκορπίσαι",703579,106],["με",708618,163],["αὐτοὺς",702165,62],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["καὶ",707031,7],["διασπερῶ",703584,165],["αὐτοὺς",702165,62],["ἐν",704639,0],["ταῖς",709436,75],["χώραις",714011,76]],"And they shall know that I am the Lord, when I have scattered them among the nations; and I will disperse them in the countries."],["16",[["καὶ",707031,7],["ὑπολείψομαι",713212,181],["ἐξ",704132,0],["αὐτῶν",702165,40],["ἄνδρας",701150,57],["ἀριθμῷ",701744,114],["ἐκ",704132,0],["ῥομφαίας",711291,17],["καὶ",707031,7],["ἐκ",704132,0],["λιμοῦ",708210,18],["καὶ",707031,7],["ἐκ",704132,0],["θανάτου",706096,18],["ὅπως",709719,7],["ἐκδιηγῶνται",704172,380],["πάσας",710177,119],["τὰς",709436,38],["ἀνομίας",701192,39],["αὐτῶν",702165,40],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["οὗ",709781,48],["εἰσήλθοσαν",704114,150],["ἐκεῖ",704181,28],["καὶ",707031,7],["γνώσονται",703105,135],["ὅτι",709803,7],["ἐγὼ",704018,164],["κύριος",707996,4]],"And I will leave of them [a few] men in number [spared] from the sword, and from famine, and from pestilence; that they may declare all their iniquities among the nations whither they have gone; and they shall know that I am the Lord."],["17",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72]],"And the word of the Lord came to me, saying,"],["18",[["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["τὸν",709436,5],["ἄρτον",701829,6],["σου",711945,133],["μετ᾿",708780,0],["ὀδύν