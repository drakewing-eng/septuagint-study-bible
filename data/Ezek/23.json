[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72]],"And the word of the Lord came to me, saying,"],["2",[["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["δύο",703849,59],["γυναῖκες",703209,191],["ἦσαν",704093,137],["θυγατέρες",706320,191],["μητρὸς",708892,17],["μιᾶς",704106,82]],"Son of man, there were two women, daughters of one mother:"],["3",[["καὶ",707031,7],["ἐξεπόρνευσαν",704295,150],["ἐν",704639,0],["Αἰγύπτῳ",700401,1],["ἐν",704639,0],["τῇ",709436,100],["νεότητι",709258,1],["αὐτῶν",702165,40],["ἐκεῖ",704181,28],["ἔπεσον",710481,150],["οἱ",709436,136],["μαστοὶ",708569,52],["αὐτῶν",702165,40],["ἐκεῖ",704181,28],["διεπαρθενεύθησαν",703537,99]],"and they went a-whoring in Egypt in their youth: there their breasts fell, there they lost their virginity."],["4",[["καὶ",707031,7],["τὰ",709436,63],["ὀνόματα",709666,64],["αὐτῶν",702165,40],["ἦν",704093,13],["Οολα",709685,12],["ἡ",709436,10],["πρεσβυτέρα",710735,178],["καὶ",707031,7],["Οολιβα",709687,12],["ἡ",709436,10],["ἀδελφὴ",700244,12],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐγένοντό",703104,189],["μοι",708974,159],["καὶ",707031,7],["ἔτεκον",712853,150],["υἱοὺς",713075,57],["καὶ",707031,7],["θυγατέρας",706320,39],["καὶ",707031,7],["τὰ",709436,63],["ὀνόματα",709666,64],["αὐτῶν",702165,40],["Σαμάρεια",711449,12],["ἡ",709436,10],["Οολα",709685,12],["καὶ",707031,7],["Ιερουσαλημ",706644,12],["ἡ",709436,10],["Οολιβα",709687,12]],"And their names were Oola the elder, and Ooliba her sister: and they were mine, and bore sons and daughters: and [as for] their names, Samaria was Oola, and Jerusalem was Ooliba."],["5",[["καὶ",707031,7],["ἐξεπόρνευσεν",704295,2],["ἡ",709436,10],["Οολα",709685,12],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["ἐπέθετο",705304,23],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἐραστὰς",705379,57],["αὐτῆς",702165,86],["ἐπὶ",705080,0],["τοὺς",709436,58],["Ἀσσυρίους",702004,57],["τοὺς",709436,58],["ἐγγίζοντας",703939,235],["αὐτῇ",702165,105]],"And Oola went a-whoring from me, and doted on her lovers, on the Assyrians that were her neighbours,"],["6",[["ἐνδεδυκότας",704701,277],["ὑακίνθινα",713047,68],["ἡγουμένους",705931,236],["καὶ",707031,7],["στρατηγούς",712144,57],["νεανίσκοι",709232,52],["ἐπίλεκτοι",705189,138],["πάντες",710177,138],["ἱππεῖς",706786,52],["ἱππαζόμενοι",706782,348],["ἐφ᾿",705080,0],["ἵππων",706790,81]],"clothed with purple, princes and captains; [they were] young men and choice, all horsemen riding on horses."],["7",[["καὶ",707031,7],["ἔδωκεν",703654,2],["τὴν",709436,8],["πορνείαν",710672,9],["αὐτῆς",702165,86],["ἐπ᾿",705080,0],["αὐτούς",702165,62],["ἐπίλεκτοι",705189,138],["υἱοὶ",713075,52],["Ἀσσυρίων",702004,81],["πάντες",710177,138],["καὶ",707031,7],["ἐπὶ",705080,0],["πάντας",710177,60],["οὓς",709781,298],["ἐπέθετο",705304,23],["ἐν",704639,0],["πᾶσι",710177,94],["τοῖς",709436,95],["ἐνθυμήμασιν",704740,96],["αὐτῆς",702165,86],["ἐμιαίνετο",708900,19]],"And she bestowed her fornication upon them; all were choice sons of the Assyrians: and on whomsoever she doted herself, with them she defiled herself in all [their] devices."],["8",[["καὶ",707031,7],["τὴν",709436,8],["πορνείαν",710672,9],["αὐτῆς",702165,86],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["οὐκ",709805,28],["ἐγκατέλιπεν",703967,2],["ὅτι",709803,7],["μετ᾿",708780,0],["αὐτῆς",702165,86],["ἐκοιμῶντο",707767,139],["ἐν",704639,0],["νεότητι",709258,1],["αὐτῆς",702165,86],["καὶ",707031,7],["αὐτοὶ",702165,201],["διεπαρθένευσαν",703537,150],["αὐτὴν",702165,104],["καὶ",707031,7],["ἐξέχεαν",704368,150],["τὴν",709436,8],["πορνείαν",710672,9],["αὐτῶν",702165,40],["ἐπ᾿",705080,0],["αὐτήν",702165,104]],"And she forsook not her fornication with the Egyptians: for in her youth they committed fornication with her, and they deflowered her, and poured out their fornication upon her."],["9",[["διὰ",703417,0],["τοῦτο",709858,129],["παρέδωκα",710014,155],["αὐτὴν",702165,104],["εἰς",704105,0],["χεῖρας",713787,39],["τῶν",709436,80],["ἐραστῶν",705379,81],["αὐτῆς",702165,86],["εἰς",704105,0],["χεῖρας",713787,39],["υἱῶν",713075,81],["Ἀσσυρίων",702004,81],["ἐφ᾿",705080,0],["οὓς",709781,298],["ἐπετίθετο",705304,19]],"Therefore I delivered her into the hands of her lovers, into the hands of the children of the Assyrians, on whom she doted."],["10",[["αὐτοὶ",702165,201],["ἀπεκάλυψαν",701474,150],["τὴν",709436,8],["αἰσχύνην",700483,9],["αὐτῆς",702165,86],["υἱοὺς",713075,57],["καὶ",707031,7],["θυγατέρας",706320,39],["αὐτῆς",702165,86],["ἔλαβον",708076,150],["καὶ",707031,7],["αὐτὴν",702165,104],["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["ἀπέκτειναν",701498,150],["καὶ",707031,7],["ἐγένετο",703104,23],["λάλημα",708072,15],["εἰς",704105,0],["γυναῖκας",703209,39],["καὶ",707031,7],["ἐποίησαν",710582,150],["ἐκδικήσεις",704175,39],["ἐν",704639,0],["αὐτῇ",702165,105],["εἰς",704105,0],["τὰς",709436,38],["θυγατέρας",706320,39]],"They uncovered her shame: they took her sons and daughters, and slew her with the sword: and she became a byword among women; and they wrought vengeance in her for the sake of the daughters."],["11",[["καὶ",707031,7],["εἶδεν",709725,2],["ἡ",709436,10],["ἀδελφὴ",700244,12],["αὐτῆς",702165,86],["Οολιβα",709687,12],["καὶ",707031,7],["διέφθειρε",703624,13],["τὴν",709436,8],["ἐπίθεσιν",705138,9],["αὐτῆς",702165,86],["ὑπὲρ",713111,0],["αὐτὴν",702165,104],["καὶ",707031,7],["τὴν",709436,8],["πορνείαν",710672,9],["αὐτῆς",702165,86],["ὑπὲρ",713111,0],["τὴν",709436,8],["πορνείαν",710672,9],["τῆς",709436,16],["ἀδελφῆς",700244,17],["αὐτῆς",702165,86]],"And her sister Ooliba saw [it], and she indulged in her fondness more corruptly than she, and in her fornication more than the fornication of her sister."],["12",[["ἐπὶ",705080,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["τῶν",709436,80],["Ἀσσυρίων",702004,81],["ἐπέθετο",705304,23],["ἡγουμένους",705931,236],["καὶ",707031,7],["στρατηγοὺς",712144,57],["τοὺς",709436,58],["ἐγγὺς",703948,28],["αὐτῆς",702165,86],["ἐνδεδυκότας",704701,277],["εὐπάρυφα",705658,68],["ἱππεῖς",706786,57],["ἱππαζομένους",706782,236],["ἐφ᾿",705080,0],["ἵππων",706790,81],["νεανίσκοι",709232,52],["ἐπίλεκτοι",705189,138],["πάντες",710177,138]],"She doted upon the sons of the Assyrians, princes and captains, her neighbours, clothed with fine linen, horsemen riding on horses; [they were] all choice young men."],["13",[["καὶ",707031,7],["εἶδον",709725,155],["ὅτι",709803,7],["μεμίανται",708900,255],["ὁδὸς",709458,12],["μία",704106,29],["τῶν",709436,130],["δύο",703849,59]],"And I saw that they were defiled, [that] the two [had] one way."],["14",[["καὶ",707031,7],["προσέθετο",710965,23],["πρὸς",710844,0],["τὴν",709436,8],["πορνείαν",710672,9],["αὐτῆς",702165,86],["καὶ",707031,7],["εἶδεν",709725,2],["ἄνδρας",701150,57],["ἐζωγραφημένους",705903,458],["ἐπὶ",705080,0],["τοῦ",709436,35],["τοίχου",712879,18],["εἰκόνας",704089,39],["Χαλδαίων",713678,81],["ἐζωγραφημένους",705903,458],["ἐν",704639,0],["γραφίδι",703193,1]],"And she increased her fornication, and she saw men painted on the wall, likenesses of the Chaldeans painted with a pencil,"],["15",[["ἐζωσμένους",705913,458],["ποικίλματα",710588,64],["ἐπὶ",705080,0],["τὰς",709436,38],["ὀσφύας",709800,39],["αὐτῶν",702165,40],["καὶ",707031,7],["τιάραι",712846,191],["βαπταὶ",702516,192],["ἐπὶ",705080,0],["τῶν",709436,130],["κεφαλῶν",707639,65],["αὐτῶν",702165,40],["ὄψις",709901,12],["τρισσὴ",712960,29],["πάντων",710177,169],["ὁμοίωμα",709629,25],["υἱῶν",713075,81],["Χαλδαίων",713678,81],["γῆς",703083,17],["πατρίδος",710196,17],["αὐτῶν",702165,40]],"having variegated girdles on their loins, having also richly dyed [attire] upon their heads; all had a princely appearance, the likeness of the children of the Chaldeans, of their native land."],["16",[["καὶ",707031,7],["ἐπέθετο",705304,23],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["τῇ",709436,100],["ὁράσει",709721,1],["ὀφθαλμῶν",709870,81],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐξαπέστειλεν",704872,2],["ἀγγέλους",700140,57],["πρὸς",710844,0],["αὐτοὺς",702165,62],["εἰς",704105,0],["γῆν",703083,9],["Χαλδαίων",713678,81]],"And she doted upon them as soon as she saw them, and sent forth messengers to them into the land of the Chaldeans."],["17",[["καὶ",707031,7],["ἤλθοσαν",705453,150],["πρὸς",710844,0],["αὐτὴν",702165,104],["υἱοὶ",713075,52],["Βαβυλῶνος",702352,17],["εἰς",704105,0],["κοίτην",707781,9],["καταλυόντων",707323,170],["καὶ",707031,7],["ἐμίαινον",708900,137],["αὐτὴν",702165,104],["ἐν",704639,0],["τῇ",709436,100],["πορνείᾳ",710672,1],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐμιάνθη",708900,37],["ἐν",704639,0],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἀπέστη",702214,2],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτῆς",702165,86],["ἀπ᾿",701425,0],["αὐτῶν",702165,40]],"And the sons of Babylon came to her, into the bed of rest, and they defiled her in her fornication, and she was defiled by them, and her soul was alienated from them."],["18",[["καὶ",707031,7],["ἀπεκάλυψεν",701474,2],["τὴν",709436,8],["πορνείαν",710672,9],["αὐτῆς",702165,86],["καὶ",707031,7],["ἀπεκάλυψεν",701474,2],["τὴν",709436,8],["αἰσχύνην",700483,9],["αὐτῆς",702165,86],["καὶ",707031,7],["ἀπέστη",702214,2],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ἀπ᾿",701425,0],["αὐτῆς",702165,86],["ὃν",709781,112],["τρόπον",712980,6],["ἀπέστη",702214,2],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ἀπὸ",701425,0],["τῆς",709436,16],["ἀδελφῆς",700244,17],["αὐτῆς",702165,86]],"And she exposed her fornication, and exposed her shame: and my soul was alienated from her, even as my soul was alienated from her sister."],["19",[["καὶ",707031,7],["ἐπλήθυνας",710530,162],["τὴν",709436,8],["πορνείαν",710672,9],["σου",711945,133],["τοῦ",709436,20],["ἀναμνῆσαι",701002,791],["ἡμέρας",705984,39],["νεότητός",709258,17],["σου",711945,133],["ἐν",704639,0],["αἷς",709781,281],["ἐπόρνευσας",710674,162],["ἐν",704639,0],["Αἰγύπτῳ",700401,1]],"And thou didst multiply thy fornication, so as to call to remembrance the days of thy youth, wherein thou didst commit whoredom in Egypt,"],["2