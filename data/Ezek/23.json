,252],["ἀπέστη",702214,2],["ἡ",709436,10],["ψυχή",714070,12],["σου",711945,133],["ἀπ᾿",701425,0],["αὐτῶν",702165,40]],"Wherefore thus saith the Lord God; Behold, I [will] deliver thee into the hands of those whom thou hatest, from whom thy soul is alienated."],["29",[["καὶ",707031,7],["ποιήσουσιν",710582,218],["ἐν",704639,0],["σοὶ",711925,159],["ἐν",704639,0],["μίσει",708947,54],["καὶ",707031,7],["λήμψονται",708076,135],["πάντας",710177,60],["τοὺς",709436,58],["πόνους",710661,57],["σου",711945,133],["καὶ",707031,7],["τοὺς",709436,58],["μόχθους",709039,57],["σου",711945,133],["καὶ",707031,7],["ἔσῃ",704093,123],["γυμνὴ",703202,29],["καὶ",707031,7],["ἀσχημονοῦσα",702053,188],["καὶ",707031,7],["ἀποκαλυφθήσεται",701474,134],["αἰσχύνη",700483,12],["πορνείας",710672,17],["σου",711945,133],["καὶ",707031,7],["ἀσέβειά",701904,12],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["πορνεία",710672,12],["σου",711945,133]],"And they shall deal with thee in hatred, and shall take all [the fruits] of thy labours and thy toils, and thou shalt be naked and bare: and the shame of thy fornication shall be exposed: and thy ungodliness and thy fornication"],["30",[["ἐποίησεν",710582,2],["ταῦτά",709858,71],["σοι",711925,159],["ἐν",704639,0],["τῷ",709436,53],["ἐκπορνεῦσαί",704295,106],["σε",711598,163],["ὀπίσω",709697,0],["ἐθνῶν",704068,44],["καὶ",707031,7],["ἐμιαίνου",708900,497],["ἐν",704639,0],["τοῖς",709436,95],["ἐνθυμήμασιν",704740,96],["αὐτῶν",702165,40]],"brought this upon thee, in that thou wentest a-whoring after the nations, and didst defile thyself with their devices."],["31",[["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["τῆς",709436,16],["ἀδελφῆς",700244,17],["σου",711945,133],["ἐπορεύθης",710667,168],["καὶ",707031,7],["δώσω",703654,165],["τὸ",709436,24],["ποτήριον",710699,25],["αὐτῆς",702165,86],["εἰς",704105,0],["χεῖράς",713787,39],["σου",711945,133]],"Thou didst walk in the way of thy sister; and I will put her cup into thine hands."],["32",[["τάδε",709446,71],["λέ