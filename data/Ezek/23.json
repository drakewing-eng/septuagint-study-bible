["με",708618,163],["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["οὐ",709805,28],["κρινεῖς",707905,166],["τὴν",709436,8],["Οολαν",709685,9],["καὶ",707031,7],["τὴν",709436,8],["Οολιβαν",709687,9],["καὶ",707031,7],["ἀπαγγελεῖς",701321,166],["αὐταῖς",702165,200],["τὰς",709436,38],["ἀνομίας",701192,39],["αὐτῶν",702165,284]],"And the Lord said to me; Son of man, wilt thou not judge Oola and Ooliba? and declare to them their iniquities?"],["37",[["ὅτι",709803,7],["ἐμοιχῶντο",708976,139],["καὶ",707031,7],["αἷμα",700442,25],["ἐν",704639,0],["χερσὶν",713787,76],["αὐτῶν",702165,284],["τὰ",709436,41],["ἐνθυμήματα",704740,42],["αὐτῶν",702165,284],["ἐμοιχῶντο",708976,139],["καὶ",707031,7],["τὰ",709436,41],["τέκνα",712761,42],["αὐτῶν",702165,284],["ἃ",709781,69],["ἐγέννησάν",703051,150],["μοι",708974,159],["διήγαγον",703442,150],["αὐτοῖς",702165,206],["δι᾿",703417,0],["ἐμπύρων",704625,83]],"For they have committed adultery, and blood was in their hands, they committed adultery with their devices, and they passed through the fire to them their children which they bore to me."],["38",[["ἕως",705792,28],["καὶ",707031,7],["ταῦτα",709858,71],["ἐποίησάν",710582,150],["μοι",708974,159],["τὰ",709436,41],["ἅγιά",700159,68],["μου",709032,133],["ἐμίαινον",708900,137],["καὶ",707031,7],["τὰ",709436,41],["σάββατά",711350,42],["μου",709032,133],["ἐβεβήλουν",702614,137]],"So long too as they did these things to me, they defiled my sanctuary, and profaned my sabbaths."],["39",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["σφάζειν",712571,55],["αὐτοὺς",702165,62],["τὰ",709436,41],["τέκνα",712761,42],["αὐτῶν",702165,40],["τοῖς",709436,95],["εἰδώλοις",704079,96],["αὐτῶν",702165,40],["καὶ",707031,7],["εἰσεπορεύοντο",704124,139],["εἰς",704105,0],["τὰ",709436,41],["ἅγιά",700159,68],["μου",709032,133],["τοῦ",709436,20],["βεβηλοῦν",702614,55],["αὐτά",702165,71],["καὶ",707031,7],["ὅτι",709803,7],["οὕτως",709859,28],["ἐποίουν",710582,137],["ἐν",704639,0],["μέσῳ",708768,30],["τοῦ",709436,35],["οἴκου",709516,18],["μου",709032,133]],"And when they sacrificed their children to their idols, they also went into my sanctuary to profane it: and whereas they did thus in the midst of my house;"],["40",[["καὶ",707031,7],["ὅτι",709803,7],["τοῖς",709436,147],["ἀνδράσιν",701150,148],["τοῖς",709436,147],["ἐρχομένοις",705453,341],["μακρόθεν",708417,28],["οἷς",709781,311],["ἀγγέλους",700140,57],["ἐξαπεστέλλοσαν",704872,150],["πρὸς",710844,0],["αὐτούς",702165,62],["καὶ",707031,7],["ἅμα",700745,28],["τῷ",709436,53],["ἔρχεσθαι",705453,110],["αὐτοὺς",702165,62],["εὐθὺς",705602,28],["ἐλούου",708258,497],["καὶ",707031,7],["ἐστιβίζου",712102,497],["τοὺς",709436,58],["ὀφθαλμούς",709870,57],["σου",711945,133],["καὶ",707031,7],["ἐκόσμου",707851,18],["κόσμῳ",707851,114]],"and whereas they did thus to the men that came from afar, to whom they sent messengers, and as soon as they came, immediately thou didst wash thyself, and didst paint thine eyes and adorn thyself with ornaments,"],["41",[["καὶ",707031,7],["ἐκάθου",707000,497],["ἐπὶ",705080,0],["κλίνης",707737,17],["ἐστρωμένης",712175,440],["καὶ",707031,7],["τράπεζα",712919,12],["κεκοσμημένη",707847,203],["πρὸ",710747,0],["προσώπου",710986,21],["αὐτῆς",702165,86],["καὶ",707031,7],["τὸ",709436,24],["θυμίαμά",706330,25],["μου",709032,133],["καὶ",707031,7],["τὸ",709436,24],["ἔλαιόν",704380,25],["μου",709032,133],["εὐφραίνοντο",705715,139],["ἐν",704639,0],["αὐτοῖς",702165,151]],"and satest on a prepared bed, and before it [there was] a table set out, and [as for] mine incense and mine oil, they rejoiced in them,"],["42",[["καὶ",707031,7],["φωνὴν",713640,9],["ἁρμονίας",701776,17],["ἀνεκρούοντο",700982,139],["καὶ",707031,7],["πρὸς",710844,0],["ἄνδρας",701150,57],["ἐκ",704132,0],["πλήθους",710529,21],["ἀνθρώπων",701163,81],["ἥκοντας",705956,235],["ἐκ",704132,0],["τῆς",709436,16],["ἐρήμου",705420,17],["καὶ",707031,7],["ἐδίδοσαν",703654,139],["ψέλια",714034,42],["ἐπὶ",705080,0],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτῶν",702165,40],["καὶ",707031,7],["στέφανον",712083,6],["καυχήσεως",707571,17],["ἐπὶ",705080,0],["τὰς",709436,38],["κεφαλὰς",707639,39],["αὐτῶν",702165,40]],"and they raised a sound of music, and [that] with men coming from the wilderness out of a multitude of men, and they put bracelets on their hands, and a crown of glory on their heads;"],["43",[["καὶ",707031,7],["εἶπα",705373,155],["οὐκ",709805,28],["ἐν",704639,0],["τούτοις",709858,151],["μοιχεύουσιν",708979,197],["καὶ",707031,7],["ἔργα",705396,42],["πόρνης",710675,17],["καὶ",707031,28],["αὐτὴ",702165,107],["ἐξεπόρνευσεν",704295,2]],"Therefore I said, Do they not commit adultery with these? and has she also gone a-whoring [after] the manner of a harlot?"],["44",[["καὶ",707031,7],["εἰσεπορεύοντο",704124,139],["πρὸς",710844,0],["αὐτήν",702165,104],["ὃν",709781,112],["τρόπον",712980,6],["εἰσπορεύονται",704124,269],["πρὸς",710844,0],["γυναῖκα",703209,9],["πόρνην",710675,9],["οὕτως",709859,28],["εἰσεπορεύοντο",704124,139],["πρὸς",710844,0],["Οολαν",709685,9],["καὶ",707031,7],["πρὸς",710844,0],["Οολιβαν",709687,9],["τοῦ",709436,20],["ποιῆσαι",710582,106],["ἀνομίαν",701192,9]],"And they went in to her, as [men] go in to a harlot; so they went in to Oola and to Ooliba to work iniquity."],["45",[["καὶ",707031,7],["ἄνδρες",701150,52],["δίκαιοι",703694,138],["αὐτοὶ",702165,201],["ἐκδικήσουσιν",704174,218],["αὐτὰς",702165,231],["ἐκδικήσει",704175,1],["μοιχαλίδος",708975,17],["καὶ",707031,7],["ἐκδικήσει",704175,1],["αἵματος",700442,21],["ὅτι",709803,7],["μοιχαλίδες",708975,191],["εἰσίν",704093,197],["καὶ",707031,7],["αἷμα",700442,25],["ἐν",704639,0],["χερσὶν",713787,76],["αὐτῶν",702165,40]],"And they are just men, and shall take vengeance on them with the judgment of an adulteress and the judgment of blood: for they are adulteresses, and blood is in their hands."],["46",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["κύριος",707996,4],["ἀνάγαγε",700933,176],["ἐπ᾿",705080,0],["αὐτὰς",702165,231],["ὄχλον",709884,6],["καὶ",707031,7],["δὸς",703654,176],["ἐν",704639,0],["αὐταῖς",702165,200],["ταραχὴν",712722,9],["καὶ",707031,7],["διαρπαγὴν",703561,9]],"Thus saith the Lord God, Bring up a multitude upon them, and send trouble and plunder into the midst of them."],["47",[["καὶ",707031,7],["λιθοβόλησον",708194,176],["ἐπ᾿",705080,0],["αὐτὰς",702165,231],["λίθοις",708196,148],["ὄχλων",709884,81],["καὶ",707031,7],["κατακέντει",707269,240],["αὐτὰς",702165,231],["ἐν",704639,0],["τοῖς",709436,95],["ξίφεσιν",709423,96],["αὐτῶν",702165,40],["υἱοὺς",713075,57],["αὐτῶν",702165,40],["καὶ",707031,7],["θυγατέρας",706320,39],["αὐτῶν",702165,40],["ἀποκτενοῦσι",701498,218],["καὶ",707031,7],["τοὺς",709436,58],["οἴκους",709516,57],["αὐτῶν",702165,40],["ἐμπρήσουσιν",704617,218]],"And stone them with the stones of a multitude, and pierce them with their swords: they shall slay their sons and their daughters, and shall burn up their houses."],["48",[["καὶ",707031,7],["ἀποστρέψω",701598,165],["ἀσέβειαν",701904,9],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["παιδευθήσονται",709926,144],["πᾶσαι",710177,192],["αἱ",709436,190],["γυναῖκες",703209,191],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ποιήσουσιν",710582,218],["κατὰ",707200,0],["τὰς",709436,38],["ἀσεβείας",701904,39],["αὐτῶν",702165,40]],"And I will remove ungodliness out of the land, and all the women shall be instructed, and shall not do according to their ungodliness."],["49",[["καὶ",707031,7],["δοθήσεται",703654,134],["ἡ",709436,10],["ἀσέβεια",701904,12],["ὑμῶν",713091,145],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["καὶ",707031,7],["τὰς",709436,38],["ἁμαρτίας",700775,39],["τῶν",709436,43],["ἐνθυμημάτων",704740,44],["ὑμῶν",713091,145],["λήμψεσθε",708076,124],["καὶ",707031,7],["γνώσεσθε",703105,124],["διότι",703734,7],["ἐγὼ",704018,164],["κύριος",707996,4]],"And your ungodliness shall be recompensed upon you, and ye shall bear the guilt of your devices: and ye shall know that I am the Lord."]]