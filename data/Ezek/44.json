[["1",[["καὶ",707031,7],["ἐπέστρεψέν",705278,2],["με",708618,163],["κατὰ",707200,0],["τὴν",709436,8],["ὁδὸν",709458,9],["τῆς",709436,16],["πύλης",711082,17],["τῶν",709436,80],["ἁγίων",700159,169],["τῆς",709436,16],["ἐξωτέρας",704987,82],["τῆς",709436,16],["βλεπούσης",702740,222],["κατ᾿",707200,0],["ἀνατολάς",701071,39],["καὶ",707031,7],["αὕτη",709858,107],["ἦν",704093,13],["κεκλεισμένη",707710,451]],"Then he brought me back by the way of the outer gate of the sanctuary that looks eastward; and it was shut."],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["ἡ",709436,10],["πύλη",711082,12],["αὕτη",709858,107],["κεκλεισμένη",707710,451],["ἔσται",704093,93],["οὐκ",709805,28],["ἀνοιχθήσεται",701186,134],["καὶ",707031,7],["οὐδεὶς",709817,14],["μὴ",708851,28],["διέλθῃ",703673,172],["δι᾿",703417,0],["αὐτῆς",702165,86],["ὅτι",709803,7],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τοῦ",709436,35],["Ισραηλ",706839,18],["εἰσελεύσεται",704114,93],["δι᾿",703417,0],["αὐτῆς",702165,86],["καὶ",707031,7],["ἔσται",704093,93],["κεκλεισμένη",707710,451]],"And the Lord said to me, This gate shall be shut, it shall not be opened, and no one shall pass through it; for the Lord God of Israel shall enter by it, and it shall be shut."],["3",[["διότι",703734,7],["ὁ",709436,3],["ἡγούμενος",705931,122],["οὗτος",709858,121],["καθήσεται",707007,93],["ἐν",704639,0],["αὐτῇ",702165,105],["τοῦ",709436,20],["φαγεῖν",713296,106],["ἄρτον",701829,6],["ἐναντίον",704654,0],["κυρίου",707996,18],["κατὰ",707200,0],["τὴν",709436,8],["ὁδὸν",709458,9],["αιλαμ",700431,21],["τῆς",709436,16],["πύλης",711082,17],["εἰσελεύσεται",704114,93],["καὶ",707031,7],["κατὰ",707200,0],["τὴν",709436,8],["ὁδὸν",709458,9],["αὐτοῦ",702165,102],["ἐξελεύσεται",704909,93]],"For the prince, he shall sit in it, to eat bread before the Lord; he shall go in by the way of the porch of the gate, and shall go forth by the way of the same."],["4",[["καὶ",707031,7],["εἰσήγαγέν",704107,2],["με",708618,163],["κατὰ",707200,0],["τὴν",709436,8],["ὁδὸν",709458,9],["τῆς",709436,16],["πύλης",711082,17],["τῆς",709436,16],["πρὸς",710844,0],["βορρᾶν",702765,6],["κατέναντι",707507,28],["τοῦ",709436,35],["οἴκου",709516,18],["καὶ",707031,7],["εἶδον",709725,155],["καὶ",707031,7],["ἰδοὺ",706497,88],["πλήρης",710541,14],["δόξης",703791,17],["ὁ",709436,3],["οἶκος",709516,4],["κυρίου",707996,18],["καὶ",707031,7],["πίπτω",710481,157],["ἐπὶ",705080,0],["πρόσωπόν",710986,25],["μου",709032,133]],"And he brought me in by the way of the gate that looks northward, in front of the house: and I looked, and, behold, the house was full of the glory of the Lord: and I fell upon my face."],["5",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["τάξον",712730,176],["εἰς",704105,0],["τὴν",709436,8],["καρδίαν",707141,9],["σου",711945,133],["καὶ",707031,7],["ἰδὲ",709725,176],["τοῖς",709436,147],["ὀφθαλμοῖς",709870,148],["σου",711945,133],["καὶ",707031,7],["τοῖς",709436,95],["ὠσίν",709852,96],["σου",711945,133],["ἄκουε",700587,240],["πάντα",710177,68],["ὅσα",709788,68],["ἐγὼ",704018,164],["λαλῶ",708071,157],["μετὰ",708780,0],["σοῦ",711945,133],["κατὰ",707200,0],["πάντα",710177,68],["τὰ",709436,41],["προστάγματα",710959,42],["οἴκου",709516,18],["κυρίου",707996,18],["καὶ",707031,7],["κατὰ",707200,0],["πάντα",710177,68],["τὰ",709436,41],["νόμιμα",709340,68],["αὐτοῦ",702165,102],["καὶ",707031,7],["τάξεις",712730,166],["τὴν",709436,8],["καρδίαν",707141,9],["σου",711945,133],["εἰς",704105,0],["τὴν",709436,8],["εἴσοδον",704119,9],["τοῦ",709436,35],["οἴκου",709516,18],["κατὰ",707200,0],["πάσας",710177,119],["τὰς",709436,38],["ἐξόδους",704948,39],["αὐτοῦ",702165,102],["ἐν",704639,0],["πᾶσι",710177,230],["τοῖς",709436,147],["ἁγίοις",700159,230]],"And the Lord said to me, Son of man, attend with thine heart, and see with [thine] eyes, and hear with thine ears all that I say to thee, according to all the ordinances of the house of the Lord, and all the regulations thereof; and thou shalt attend well to the entrance of the house, according to all its outlets, in all the holy things."],["6",[["καὶ",707031,7],["ἐρεῖς",705415,166],["πρὸς",710844,0],["τὸν",709436,5],["οἶκον",709516,6],["τὸν",709436,5],["παραπικραίνοντα",710087,183],["πρὸς",710844,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["Ισραηλ",706839,18],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["ἱκανούσθω",706711,407],["ὑμῖν",713084,90],["ἀπὸ",701425,0],["πασῶν",710177,198],["τῶν",709436,130],["ἀνομιῶν",701192,65],["ὑμῶν",713091,145],["οἶκος",709516,4],["Ισραηλ",706839,18]],"And thou shalt say to the provoking house, [even] to the house of Israel, Thus saith the Lord God; Let it suffice you [to have committed] all your iniquities, O house of Israel!"],["7",[["τοῦ",709436,20],["εἰσαγαγεῖν",704107,106],["ὑμᾶς",713080,194],["υἱοὺς",713075,57],["ἀλλογενεῖς",700690,60],["ἀπεριτμήτους",701397,60],["καρδίᾳ",707141,1],["καὶ",707031,7],["ἀπεριτμήτους",701397,60],["σαρκὶ",711537,1],["τοῦ",709436,20],["γίνεσθαι",703104,110],["ἐν",704639,0],["τοῖς",709436,147],["ἁγίοις",700159,230],["μου",709032,133],["καὶ",707031,7],["ἐβεβήλουν",702614,137],["αὐτὰ",702165,71],["ἐν",704639,0],["τῷ",709436,53],["προσφέρειν",710974,55],["ὑμᾶς",713080,194],["ἄρτους",701829,57],["στέαρ",712054,25],["καὶ",707031,7],["αἷμα",700442,25],["καὶ",707031,7],["παρεβαίνετε",709996,399],["τὴν",709436,8],["διαθήκην",703456,9],["μου",709032,133],["ἐν",704639,0],["πάσαις",710177,291],["ταῖς",709436,75],["ἀνομίαις",701192,76],["ὑμῶν",713091,145]],"that ye have brought in aliens, uncircumcised in heart, and uncircumcised in flesh, to be in my sanctuary, and to profane it, when ye offered bread, flesh, and blood; and ye transgressed my covenant by all your iniquities;"],["8",[["καὶ",707031,7],["διετάξατε",703603,74],["τοῦ",709436,20],["φυλάσσειν",713619,55],["φυλακὰς",713613,39],["ἐν",704639,0],["τοῖς",709436,95],["ἁγίοις",700159,94],["μου",709032,133]],"and ye appointed [others] to keep the charges in my sanctuary."],["9",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["πᾶς",710177,14],["υἱὸς",713075,4],["ἀλλογενὴς",700690,14],["ἀπερίτμητος",701397,14],["καρδίᾳ",707141,1],["καὶ",707031,7],["ἀπερίτμητος",701397,14],["σαρκὶ",711537,1],["οὐκ",709805,28],["εἰσελεύσεται",704114,93],["εἰς",704105,0],["τὰ",709436,41],["ἅγιά",700159,68],["μου",709032,133],["ἐν",704639,0],["πᾶσιν",710177,230],["υἱοῖς",713075,148],["ἀλλογενῶν",700690,169],["τῶν",709436,80],["ὄντων",704093,170],["ἐν",704639,0],["μέσῳ",708768,30],["οἴκου",709516,18],["Ισραηλ",706839,18]],"Therefore thus saith the Lord God; No alien, uncircumcised in heart or uncircumcised in flesh, shall enter into my sanctuary, of all the children of strangers that are in the midst of the house of Israel."],["10",[["ἀλλ᾿",700680,7],["ἢ",705924,7],["οἱ",709436,136],["Λευῖται",708160,52],["οἵτινες",709793,450],["ἀφήλαντο",702180,189],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["ἐν",704639,0],["τῷ",709436,53],["πλανᾶσθαι",710495,110],["τὸν",709436,5],["Ισραηλ",706839,6],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["κατόπισθεν",707544,28],["τῶν",709436,43],["ἐνθυμημάτων",704740,44],["αὐτῶν",702165,40],["καὶ",707031,7],["λήμψονται",708076,135],["ἀδικίαν",700271,9],["αὐτῶν",702165,40]],"But as for the Levites who departed far from me when Israel went astray from me after their imaginations, they shall even bear their iniquity."],["11",[["καὶ",707031,7],["ἔσονται",704093,135],["ἐν",704639,0],["τοῖς",709436,95],["ἁγίοις",700159,94],["μου",709032,133],["λειτουργοῦντες",708132,146],["θυρωροὶ",706344,52],["ἐπὶ",705080,0],["τῶν",709436,130],["πυλῶν",711082,65],["τοῦ",709436,35],["οἴκου",709516,18],["καὶ",707031,7],["λειτουργοῦντες",708132,146],["τῷ",709436,113],["οἴκῳ",709516,114],["οὗτοι",709858,201],["σφάξουσιν",712571,218],["τὰ",709436,41],["ὁλοκαυτώματα",709589,42],["καὶ",707031,7],["τὰς",709436,38],["θυσίας",706345,39],["τῷ",709436,113],["λαῷ",708094,114],["καὶ",707031,7],["οὗτοι",709858,201],["στήσονται",706846,135],["ἐναντίον",704654,0],["τοῦ",709436,35],["λαοῦ",708094,18],["τοῦ",709436,20],["λειτουργεῖν",708132,55],["αὐτοῖς",702165,151]],"Yet they shall minister in my sanctuary, [being] porters at the gates of the house, and serving the house: they shall slay the victims and the whole-burnt-offerings for the people, and they shall stand before the people to minister to them."],["12",[["ἀνθ᾿",701227,0],["ὧν",709781,252],["ἐλειτούργουν",708132,137],["αὐτοῖς",702165,151],["πρὸ",710747,0],["προσώπου",710986,21],["τῶν",709436,43],["εἰδώλων",704079,44],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐγένετο",703104,23],["τῷ",709436,113],["οἴκῳ",709516,114],["Ισραηλ",706839,18],["εἰς",704105,0],["κόλασιν",707789,9],["ἀδικίας",700271,17],["ἕνεκα",704709,0],["τούτου",709858,102],["ἦρα",700473,155],["τὴν",709436,8],["χεῖρά",713787,9],["μου",709032,133],["ἐπ᾿",705080,0],["αὐτούς",702165,62],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4]],"Because they ministered to them before their idols, and it became to the house of Israel a punishment of iniquity; therefore have I lifted up my hand against them, saith the Lord God."],["13",[["καὶ",707031,7],["οὐκ",709805,28],["ἐγγιοῦσι",703939,218],["πρός",710844,0],["με",708618,163],["τοῦ",709436,20],["ἱερατεύειν",706607,55],["μοι",708974,159],["οὐδὲ",709816,7],["τοῦ",709436,20],["προσάγειν",710848,55],["πρὸς",710844,0],["τὰ",709436,41],["ἅγια",700159,68],["υἱῶν",713075,81],["τοῦ",709436,35],["Ισραηλ",706839,18],["οὐδὲ",709816,7],["πρὸς",710844,0],["τὰ",709436,41],["ἅγια",700159,68],["τῶν",709436,43],["ἁγίων",700159,83],["μου",709032,133],["καὶ",707031,7],["λήμψονται",708076,135],["ἀτιμίαν",702094,9],["αὐτῶν",702165,40],["ἐν",704639,0],["τῇ",709436,100],["πλανήσει",710497,1],["ᾗ",709781,108],["ἐπλανήθησαν",710495,99]],"And they shall not draw nigh to me to minister to me in the priests' office, nor to approach the holy things of the children of Israel, nor [to approach] my holy of holies: but they shall bear their reproach for the error wherein they erred."],["14",[["καὶ",707031,7],["κατατάξουσιν",707453,218],["αὐτοὺς",702165,62],["φυλάσσειν",713619,55],["φυλακὰς",713613,39],["τοῦ",709436,35],["οἴκου",709516,18],["εἰς",704105,0],["πάντα",710177,68],["τὰ",709436,41],["ἔργα",705396,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἰς",704105,0],["πάντα",710177,68],["ὅσα",709788,68],["ἂν",700900,11],["ποιήσωσιν",710582,234]],"They shall bring them to keep the charges of the house, for all the service of it, and for all that they shall do."],["15",[["οἱ",709436,136],["ἱερεῖς",706614,52],["οἱ",709436,136],["Λευῖται",708160,52],["οἱ",709436,136],["υἱοὶ",713075,52],["τοῦ",709436,35],["Σαδδουκ",711369,18],["οἵτινες",709793,450],["ἐφυλάξαντο",713619,189],["τὰς",709436,38],["φυλακὰς",713613,39],["τῶν",709436,80],["ἁγίων",700159,169],["μου",709032,133],["ἐν",704639,0],["τῷ",709436,53],["πλανᾶσθαι",710495,110],["οἶκον",709516,6],["Ισραηλ",706839,18],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["οὗτοι",709858,201],["προσάξουσιν",710848,218],["πρός",710844,0],["με",708618,163],["τοῦ",709436,20],["λειτουργεῖν",708132,55],["μοι",708974,159],["καὶ",707031,7],["στήσονται",706846,135],["πρὸ",710747,0],["προσώπου",710986,21],["μου",709032,133],["τοῦ",709436,20],["προσφέρειν",710974,55],["μοι",708974,159],["θυσίαν",706345,9],["στέαρ",712054,25],["καὶ",707031,7],["αἷμα",700442,25],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4]],"The priests the Levites, the sons of Sadduc, who kept the charges of my sanctuary when the house of Israel went astray from me, these shall draw nigh to me to minister to me, and shall stand before my face, to offer sacrifice to me, the fat and the blood, saith the Lord God."],["16",[["οὗτοι",709858,201],["εἰσελεύσονται",704114,135],["εἰς",704105,0],["τὰ",709436,41],["ἅγιά",700159,68],["μου",709032,133],["καὶ",707031,7],["οὗτοι",709858,201],["προσελεύσονται",710890,135],["πρὸς",710844,0],["τὴν",709436,8],["τράπεζάν",712919,9],["μου",709032,133],["τοῦ",709436,20],["λειτουργεῖν",708132,55],["μοι",708974,159],["καὶ",707031,7],["φυλάξουσιν",713619,218],["τὰς",709436,38],["φυλακάς",713613,39],["μου",709032,133]],"These shall enter into my sanctuary, and these shall approach my table, to minister to me, and they shall keep my charges."],["17",[["καὶ",707031,7],["ἔσται",704093,93],["ἐν",704639,0],["τῷ",709436,53],["εἰσπορεύεσθαι",704124,110],["αὐτοὺς",702165,62],["τὰς",709436,38],["πύλας",711082,39],["τῆς",709436,16],["αὐλῆς",702137,17],["τῆς",709436,16],["ἐσωτέρας",705525,82],["στολὰς",712120,39],["λινᾶς",708214,119],["ἐνδύσονται",704701,135],["καὶ",707031,7],["οὐκ",709805,28],["ἐνδύσονται",704701,135],["ἐρεᾶ",705397,9],["ἐν",704639,0],["τῷ",709436,53],["λειτουργεῖν",708132,55],["αὐτοὺς",702165,62],["ἀπὸ",701425,0],["τῆς",709436,16],["πύλης",711082,17],["τῆς",709436,16],["ἐσωτέρας",705525,82],["αὐλῆς",702137,17]],"And it shall come to pass when they enter the gates of the inner court, [that] they shall put on linen robes; and they shall not put on woollen garments when they minister at the gate of the inner court."],["18",[["καὶ",707031,7],["κιδάρεις",707668,39],["λινᾶς",708214,119],["ἕξουσιν",705785,218],["ἐπὶ",705080,0],["ταῖς",709436,75],["κεφαλαῖς",707639,76],["αὐτῶν",702165,40],["καὶ",707031,7],["περισκελῆ",710379,68],["λινᾶ",708214,68],["ἕξουσιν",705785,218],["ἐπὶ",705080,0],["τὰς",709436,38],["ὀσφύας",709800,39],["αὐτῶν",702165,40],["καὶ",707031,7],["οὐ",709805,28],["περιζώσονται",710317,135],["βίᾳ",702712,1]],"And they shall have linen mitres upon their heads, and shall have linen drawers upon their loins; and they shall not tightly gird themselves."],["19",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἐκπορεύεσθαι",704293,110],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὴν",709436,8],["αὐλὴν",702137,9],["τὴν",709436,8],["ἐξωτέραν",704987,36],["πρὸς",710844,0],["τὸν",709436,5],["λαὸν",708094,6],["ἐκδύσονται",704180,135],["τὰς",709436,38],["στολὰς",712120,39],["αὐτῶν",702165,40],["ἐν",704639,0],["αἷς",709781,281],["αὐτοὶ",702165,201],["λειτουργοῦσιν",708132,197],["ἐν",704639,0],["αὐταῖς",702165,200],["καὶ",707031,7],["θήσουσιν",712849,218],["αὐτὰς",702165,231],["ἐν",704639,0],["ταῖς",709436,75],["ἐξέδραις",704891,76],["τῶν",709436,43],["ἁγίων",700159,83],["καὶ",707031,7],["ἐνδύσονται",704701,135],["στολὰς",712120,39],["ἑτέρας",705535,119],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἁγιάσωσιν",700153,234],["τὸν",709436,5],["λαὸν",708094,6],["ἐν",704639,0],["ταῖς",709436,75],["στολαῖς",712120,76],["αὐτῶν",702165,40]],"And when they go out into the outer court to the people, they shall put off their robes, in which they minister; and they shall lay them up in the chambers of the sanctuary, and shall put on other robes, and they shall not sanctify the people with their robes."],["20",[["καὶ",707031,7],["τὰς",709436,38],["κεφαλὰς",707639,39],["αὐτῶν",702165,40],["οὐ",709805,28],["ξυρήσονται",709431,135],["καὶ",707031,7],["τὰς",709436,38],["κόμας",707803,39],["αὐτῶν",702165,40],["οὐ",709805,28],["ψιλώσουσιν",714057,218],["καλύπτοντες",707102,146],["καλύψουσιν",707102,218],["τὰς",709436,38],["κεφαλὰς",707639,39],["αὐτῶν",702165,40]],"And they shall not shave their heads, nor shall they pluck off their hair; they shall carefully cover their heads."],["21",[["καὶ",707031,7],["οἶνον",709530,6],["οὐ",709805,28],["μὴ",708851,28],["πίωσιν",710478,234],["πᾶς",710177,14],["ἱερεὺς",706614,4],["ἐν",704639,0],["τῷ",709436,53],["εἰσπορεύεσθαι",704124,110],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὴν",709436,8],["αὐλὴν",702137,9],["τὴν",709436,8],["ἐσωτέραν",705525,36]],"And no priest shall drink any wine, when they go into the inner court."],["22",[["καὶ",707031,7],["χήραν",713848,9],["καὶ",707031,7],["ἐκβεβλημένην",704148,436],["οὐ",709805,28],["λήμψονται",708076,135],["ἑαυτοῖς",703917,151],["εἰς",704105,0],["γυναῖκα",703209,9],["ἀλλ᾿",700680,7],["ἢ",705924,7],["παρθένον",710148,9],["ἐκ",704132,0],["τοῦ",709436,20],["σπέρματος",712008,21],["Ισραηλ",706839,18],["καὶ",707031,7],["χήρα",713848,12],["ἐὰν",703912,7],["γένηται",703104,239],["ἐξ",704132,0],["ἱερέως",706614,18],["λήμψονται",708076,135]],"Neither shall they take to themselves to wife a widow, or one that is put away, but a virgin of the seed of Israel: but if there should happen to be a priest's widow, they shall take [her]."],["23",[["καὶ",707031,7],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["διδάξουσιν",703649,218],["ἀνὰ",700902,0],["μέσον",708768,27],["ἁγίου",700159,92],["καὶ",707031,7],["βεβήλου",702613,92],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,27],["ἀκαθάρτου",700508,92],["καὶ",707031,7],["καθαροῦ",706988,92],["γνωριοῦσιν",703135,218],["αὐτοῖς",702165,151]],"And they shall teach my people [to distinguish] between holy and profane, and they shall make known to them [the difference] between unclean and clean."],["24",[["καὶ",707031,7],["ἐπὶ",705080,0],["κρίσιν",707908,9],["αἵματος",700442,21],["οὗτοι",709858,201],["ἐπιστήσονται",705756,135],["τοῦ",709436,20],["διακρίνειν",703488,55],["τὰ",709436,41],["δικαιώματά",703697,42],["μου",709032,133],["δικαιώσουσιν",703696,218],["καὶ",707031,7],["τὰ",709436,41],["κρίματά",707903,42],["μου",709032,133],["κρινοῦσιν",707905,218],["καὶ",707031,7],["τὰ",709436,41],["νόμιμά",709340,68],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,41],["προστάγματά",710959,42],["μου",709032,133],["ἐν",704639,0],["πάσαις",710177,291],["ταῖς",709436,75],["ἑορταῖς",704990,76],["μου",709032,133],["φυλάξονται",713619,135],["καὶ",707031,7],["τὰ",709436,41],["σάββατά",711350,42],["μου",709032,133],["ἁγιάσουσιν",700153,218]],"And these shall attend at a judgment of blood to decide it: they shall rightly observe my ordinances, and judge my judgments, and keep my statutes and my commandments in all my feasts; and they shall hallow my sabbaths."],["25",[["καὶ",707031,7],["ἐπὶ",705080,0],["ψυχὴν",714070,9],["ἀν