32,0],["μέσου",708768,92],["αὐτῆς",702165,86]],"Therefore thus saith the Lord; Your dead whom ye have smitten in the midst of it, these are the flesh, and this[city] is the caldron: but I will bring you forth out of the midst of it."],["8",[["ῥομφαίαν",711291,9],["φοβεῖσθε",713532,374],["καὶ",707031,7],["ῥομφαίαν",711291,9],["ἐπάξω",704994,165],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["λέγει",708124,91],["κύριος",707996,4]],"Ye fear the sword; and I will bring a sword upon you, saith the Lord."],["9",[["καὶ",707031,7],["ἐξάξω",704834,165],["ὑμᾶς",713080,194],["ἐκ",704132,0],["μέσου",708768,92],["αὐτῆς",702165,86],["καὶ",707031,7],["παραδώσω",710014,165],["ὑμᾶς",713080,194],["εἰς",704105,0],["χεῖρας",713787,39],["ἀλλοτρίων",700699,169],["καὶ",707031,7],["ποιήσω",710582,165],["ἐν",704639,0],["ὑμῖν",713084,90],["κρίματα",707903,42]],"And I will bring you forth out of the midst of it, and will deliver you into the hands of strangers, and will execute judgments among you."],["10",[["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["πεσεῖσθε",710481,124],["ἐπὶ",705080,0],["τῶν",709436,43],["ὁρίων",709749,44],["τοῦ",709436,35],["Ισραηλ",706839,18],["κρινῶ",707905,165],["ὑμᾶς",713080,194],["καὶ",707031,7],["ἐπιγνώσεσθε",705104,124],["ὅτι",709803,7],["ἐγὼ",704018,164],["κύριος",707996,4]],"Ye shall fall by the sword; I will judge you on the mountains of Israel; and ye shall know that I am the Lord."],["11",[["αὐτὴ",702165,107],["ὑμῖν",713084,90],["οὐκ",709805,28],["ἔσται",704093,93],["εἰς",704105,0],["λέβητα",708121,6],["καὶ",707031,7],["ὑμεῖς",713081,219],["οὐ",709805,28],["μὴ",708851,28],["γένησθε",703104,142],["ἐν",704639,0],["μέσῳ",708768,97],["αὐτῆς",702165,86],["εἰς",704105,0],["κρέα",707889,42],["ἐπὶ",705080,0],["τῶν",709436,43],["ὁρίων",709749,44],["τοῦ",709436,35],["Ισραηλ",706839,18],["κρινῶ",707905,165],["ὑμᾶς",713080,194]],null],["12",[["καὶ",707031,7],["ἐπιγνώσεσθε",705104,124],["διότι",703734,7],["ἐγὼ",704018,164],["κύριος",707996,4]],null],["13",[["καὶ",707031,7],["ἐγένετο",7