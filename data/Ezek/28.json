25],["ἐν",704639,0],["τοῖς",709436,147],["θησαυροῖς",706258,148],["σου",711945,133]],"Hast thou gained power for thyself by thine [own] knowledge or thine [own] prudence, and [gotten] gold and silver in thy treasures?"],["5",[["ἐν",704639,0],["τῇ",709436,100],["πολλῇ",710646,101],["ἐπιστήμῃ",705267,1],["σου",711945,133],["καὶ",707031,7],["ἐμπορίᾳ",704612,1],["σου",711945,133],["ἐπλήθυνας",710530,162],["δύναμίν",703839,9],["σου",711945,133],["ὑψώθη",713289,37],["ἡ",709436,10],["καρδία",707141,12],["σου",711945,133],["ἐν",704639,0],["τῇ",709436,100],["δυνάμει",703839,1],["σου",711945,133]],"By thy abundant knowledge and thy traffic thou hast multiplied thy power; thy heart has been lifted up by thy power."],["6",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἐπειδὴ",705056,7],["δέδωκας",703654,266],["τὴν",709436,8],["καρδίαν",707141,9],["σου",711945,133],["ὡς",714148,7],["καρδίαν",707141,9],["θεοῦ",706192,18]],"Therefore thus saith the Lord; Since thou hast set thine heart as the heart of God;"],["7",[["ἀντὶ",701227,0],["τούτου",709858,102],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐπάγω",704994,157],["ἐπὶ",705080,0],["σὲ",711598,163],["ἀλλοτρίους",700699,60],["λοιμοὺς",708245,57],["ἀπὸ",701425,0],["ἐθνῶν",704068,44],["καὶ",707031,7],["ἐκκενώσουσιν",704210,218],["τὰς",709436,38],["μαχαίρας",708593,39],["αὐτῶν",702165,40],["ἐπὶ",705080,0],["σὲ",711598,163],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸ",709436,24],["κάλλος",707093,25],["τῆς",709436,16],["ἐπιστήμης",705267,17],["σου",711945,133],["καὶ",707031,7],["στρώσουσιν",713247,218],["τὸ",709436,24],["κάλλος",707093,25],["σου",711945,133],["εἰς",704105,0],["ἀπώλειαν",701660,9]],"because of this, behold, I [will] bring on thee strange plagues from the nations; and they shall draw their swords against thee, and against the beauty of thy knowledge,"],["8",[["καὶ",707031,7],["καταβιβάσουσίν",707208,218],["σε",711598,163],["καὶ",707031,7],["ἀποθανῇ",701461,123],["θανάτῳ",706096