[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72]],"And the word of the Lord came to me, saying,"],["2",[["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["προφήτευσον",711008,176],["καὶ",707031,7],["εἰπόν",705373,176],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὦ",714081,88],["ὦ",714081,88],["ἡ",709436,10],["ἡμέρα",705984,12]],"Son of man, prophesy, and say, Thus saith the Lord; Woe, woe [worth] the day!"],["3",[["ὅτι",709803,7],["ἐγγὺς",703948,28],["ἡ",709436,10],["ἡμέρα",705984,12],["τοῦ",709436,35],["κυρίου",707996,18],["ἡμέρα",705984,12],["πέρας",710281,15],["ἐθνῶν",704068,44],["ἔσται",704093,93]],"For the day of the Lord is nigh, a day of cloud; it shall be the end of the nations."],["4",[["καὶ",707031,7],["ἥξει",705956,127],["μάχαιρα",708593,12],["ἐπ᾿",705080,0],["Αἰγυπτίους",700400,57],["καὶ",707031,7],["ἔσται",704093,93],["ταραχὴ",712722,12],["ἐν",704639,0],["τῇ",709436,100],["Αἰθιοπίᾳ",700419,1],["καὶ",707031,7],["πεσοῦνται",710481,135],["τετραυματισμένοι",712922,362],["ἐν",704639,0],["Αἰγύπτῳ",700401,1],["καὶ",707031,7],["συμπεσεῖται",712332,93],["αὐτῆς",702165,86],["τὰ",709436,63],["θεμέλια",706181,64]],"And a sword shall come upon the Egyptians, and there shall be tumult in Ethiopia, and in Egypt [men] shall fall down slain together, and her foundations shall fall."],["5",[["Πέρσαι",710429,64],["καὶ",707031,7],["Κρῆτες",707898,52],["καὶ",707031,7],["Λυδοὶ",708265,52],["καὶ",707031,7],["Λίβυες",708190,52],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["ἐπίμικτοι",705204,52],["καὶ",707031,7],["τῶν",709436,80],["υἱῶν",713075,81],["τῆς",709436,16],["διαθήκης",703456,17],["μου",709032,133],["μαχαίρᾳ",708593,1],["πεσοῦνται",710481,135],["ἐν",704639,0],["αὐτῇ",702165,105]],"Persians, and Cretans, and Lydians, and Libyans, and all the mixed multitude, and they of the children of my covenant, shall fall by the sword therein."],["6",[["καὶ",707031,7],["πεσοῦνται",710481,135],["τὰ",709436,63],["ἀντιστηρίγματα",701274,64],["Αἰγύπτου",700401,17],["καὶ",707031,7],["καταβήσεται",707202,93],["ἡ",709436,10],["ὕβρις",713051,12],["τῆς",709436,16],["ἰσχύος",706858,17],["αὐτῆς",702165,86],["ἀπὸ",701425,0],["Μαγδώλου",708332,118],["ἕως",705792,0],["Συήνης",712251,17],["μαχαίρᾳ",708593,1],["πεσοῦνται",710481,135],["ἐν",704639,0],["αὐτῇ",702165,105],["λέγει",708124,91],["κύριος",707996,4]],"And the supports of Egypt shall fall; and the pride of her strength shall come down from Magdol to Syene: they shall fall by the sword in it, saith the Lord."],["7",[["καὶ",707031,7],["ἐρημωθήσεται",705421,134],["ἐν",704639,0],["μέσῳ",708768,30],["χωρῶν",714011,65],["ἠρημωμένων",705421,748],["καὶ",707031,7],["αἱ",709436,190],["πόλεις",710612,191],["αὐτῶν",702165,40],["ἐν",704639,0],["μέσῳ",708768,30],["πόλεων",710612,65],["ἠρημωμένων",705421,748],["ἔσονται",704093,135]],"And it shall be made desolate in the midst of desolate countries, and their cities shall be [desolate] in the midst of the desolate cities:"],["8",[["καὶ",707031,7],["γνώσονται",703105,135],["ὅτι",709803,7],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["ὅταν",709801,28],["δῶ",703654,207],["πῦρ",711088,25],["ἐπ᾿",705080,0],["Αἴγυπτον",700401,9],["καὶ",707031,7],["συντριβῶσι",712520,272],["πάντες",710177,138],["οἱ",709436,136],["βοηθοῦντες",702746,146],["αὐτῇ",702165,105]],"and they shall know that I am the Lord, when I shall send fire upon Egypt, and [when] all that help her shall be broken."],["9",[["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἐξελεύσονται",704909,135],["ἄγγελοι",700140,52],["σπεύδοντες",712011,146],["ἀφανίσαι",702182,106],["τὴν",709436,8],["Αἰθιοπίαν",700419,9],["καὶ",707031,7],["ἔσται",704093,93],["ταραχὴ",712722,12],["ἐν",704639,0],["αὐτοῖς",702165,151],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["Αἰγύπτου",700401,17],["ὅτι",709803,7],["ἰδοὺ",706497,88],["ἥκει",705956,91]],"In that day shall messengers go forth hasting to destroy Ethiopia utterly, and there shall be tumult among them in the day of Egypt: for, behold, it comes."],["10",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["κύριος",707996,4],["καὶ",707031,7],["ἀπολῶ",701513,165],["πλῆθος",710529,25],["Αἰγυπτίων",700400,81],["διὰ",703417,0],["χειρὸς",713787,17],["Ναβουχοδονοσορ",709149,18],["βασιλέως",702580,18],["Βαβυλῶνος",702352,17]],"Thus saith the Lord God; I will also destroy the multitude of the Egyptians by the hand of Nabuchodonosor king of Babylon,"],["11",[["αὐτοῦ",702165,102],["καὶ",707031,7],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτοῦ",702165,102],["λοιμοὶ",708245,52],["ἀπὸ",701425,0],["ἐθνῶν",704068,44],["ἀπεσταλμένοι",701592,429],["ἀπολέσαι",701513,106],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἐκκενώσουσιν",704210,218],["πάντες",710177,138],["τὰς",709436,38],["μαχαίρας",708593,39],["αὐτῶν",702165,40],["ἐπ᾿",705080,0],["Αἴγυπτον",700401,9],["καὶ",707031,7],["πλησθήσεται",710532,134],["ἡ",709436,10],["γῆ",703083,12],["τραυματιῶν",712921,81]],"his [hand] and his people's; [they are] plagues sent forth from the nations to destroy the land: and they all shall unsheath their swords against Egypt, and the land shall be filled with slain."],["12",[["καὶ",707031,7],["δώσω",703654,165],["τοὺς",709436,58],["ποταμοὺς",710693,57],["αὐτῶν",702165,40],["ἐρήμους",705420,60],["καὶ",707031,7],["ἀπολῶ",701513,165],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["τὸ",709436,24],["πλήρωμα",710544,25],["αὐτῆς",702165,86],["ἐν",704639,0],["χερσὶν",713787,76],["ἀλλοτρίων",700699,169],["ἐγὼ",704018,164],["κύριος",707996,4],["λελάληκα",708071,89]],"And I will make their rivers desolate, and will destroy the land and the fulness of it by the hands of strangers: I the Lord have spoken."],["13",[["ὅτι",709803,7],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["κύριος",707996,4],["καὶ",707031,7],["ἀπολῶ",701513,165],["μεγιστᾶνας",708657,57],["ἀπὸ",701425,0],["Μέμφεως",708727,17],["καὶ",707031,7],["ἄρχοντας",701862,57],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["καὶ",707031,7],["οὐκ",709805,28],["ἔσονται",704093,135],["ἔτι",705538,28]],"For thus saith the Lord God; I will also destroy the nobles from Memphis, and the princes of Memphis out of the land of Egypt; and they shall be no more."],["14",[["καὶ",707031,7],["ἀπολῶ",701513,165],["γῆν",703083,9],["Παθουρης",709919,17],["καὶ",707031,7],["δώσω",703654,165],["πῦρ",711088,25],["ἐπὶ",705080,0],["Τάνιν",712708,9],["καὶ",707031,7],["ποιήσω",710582,165],["ἐκδίκησιν",704175,9],["ἐν",704639,0],["Διοσπόλει",703733,1]],"And I will destroy the land of Phathore, and will send fire upon Tanis, and will execute vengeance on Diospolis."],["15",[["καὶ",707031,7],["ἐκχεῶ",704368,165],["τὸν",709436,5],["θυμόν",706334,6],["μου",709032,133],["ἐπὶ",705080,0],["Σάιν",711384,9],["τὴν",709436,8],["ἰσχὺν",706858,9],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ἀπολῶ",701513,165],["τὸ",709436,24],["πλῆθος",710529,25],["Μέμφεως",708727,17]],"And I will pour out my wrath upon Sais the strength of Egypt, and will destroy the multitude of Memphis."],["16",[["καὶ",707031,7],["δώσω",703654,165],["πῦρ",711088,25],["ἐπ᾿",705080,0],["Αἴγυπτον",700401,9],["καὶ",707031,7],["ταραχὴν",712722,9],["ταραχθήσεται",712721,134],["Συήνη",712251,12],["καὶ",707031,7],["ἐν",704639,0],["Διοσπόλει",703733,1],["ἔσται",704093,93],["ἔκρηγμα",704301,15],["καὶ",707031,7],["διαχυθήσεται",703636,134],["ὕδατα",713071,15]],"And I will send fire upon Egypt; and Syene shall be sorely troubled; and there shall be a breaking in Diospolis, and waters shall be poured out."],["17",[["νεανίσκοι",709232,52],["ἡλίου",705974,18],["πόλεως",710612,17],["καὶ",707031,7],["Βουβάστου",702778,118],["ἐν",704639,0],["μαχαίρᾳ",708593,1],["πεσοῦνται",710481,135],["καὶ",707031,7],["αἱ",709436,190],["γυναῖκες",703209,191],["ἐν",704639,0],["αἰχμαλωσίᾳ",700499,1],["πορεύσονται",710667,135]],"The youths of Heliopolis and Bubastum shall fall by the sword, and the women shall go into captivity."],["18",[["καὶ",707031,7],["ἐν",704639,0],["Ταφνας",712737,111],["συσκοτάσει",712551,127],["ἡ",709436,10],["ἡμέρα",705984,12],["ἐν",704639,0],["τῷ",709436,53],["συντρῖψαι",712520,106],["με",708618,163],["ἐκεῖ",704181,28],["τὰ",709436,41],["σκῆπτρα",711851,42],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ἀπολεῖται",701513,93],["ἐκεῖ",704181,28],["ἡ",709436,10],["ὕβρις",713051,12],["τῆς",709436,16],["ἰσχύος",706858,17],["αὐτῆς",702165,86],["καὶ",707031,7],["αὐτὴν",702165,104],["νεφέλη",709277,12],["καλύψει",707102,127],["καὶ",707031,7],["αἱ",709436,190],["θυγατέρες",706320,191],["αὐτῆς",702165,86],["αἰχμάλωτοι",700503,192],["ἀχθήσονται",700209,144]],"And the day shall be darkened in Taphnæ, when I have broken there the sceptres of Egypt: and the pride of her strength shall perish there: and a cloud shall cover her, and her daughters shall be taken prisoners."],["19",[["καὶ",707031,7],["ποιήσω",710582,165],["κρίμα",707903,25],["ἐν",704639,0],["Αἰγύπτῳ",700401,1],["καὶ",707031,7],["γνώσονται",703105,135],["ὅτι",709803,7],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4]],"And I will execute judgment on Egypt; and they shall know that I am the Lord."],["20",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["τῷ",709436,53],["ἑνδεκάτῳ",704676,97],["ἔτει",705543,54],["ἐν",704639,0],["τῷ",709436,113],["πρώτῳ",711041,339],["μηνὶ",708874,114],["ἑβδόμῃ",703925,101],["τοῦ",709436,35],["μηνὸς",708874,18],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72]],"And it came to pass in the eleventh year, in the first month, on the seventh [day] of the month, the word of the Lord came to me, saying,"],["21",[["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["τοὺς",709436,58],["βραχίονας",702808,57],["Φαραω",713360,18],["βασιλέως",702580,18],["Αἰγύπτου",700401,17],["συνέτριψα",712520,155],["καὶ",707031,7],["ἰδοὺ",706497,88],["οὐ",709805,28],["κατεδέθη",707239,37],["τοῦ",709436,20],["δοθῆναι",703654,179],["ἴασιν",706444,9],["τοῦ",709436,20],["δοθῆναι",703654,179],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["μάλαγμα",708434,25],["τοῦ",709436,20],["δοθῆναι",703654,179],["ἰσχὺν",706858,9],["ἐπιλαβέσθαι",705185,109],["μαχαίρας",708593,39]],"Son of man, I have broken the arms of Pharao, king of Egypt; and, behold, it has not been bound up to be healed, to have a plaster put upon it, [or] to be strengthened to lay hold of the sword."],["22",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐπὶ",705080,0],["Φαραω",713360,6],["βασιλέα",702580,6],["Αἰγύπτου",700401,17],["καὶ",707031,7],["συντρίψω",712520,165],["τοὺς",709436,58],["βραχίονας",702808,57],["αὐτοῦ",702165,102],["τοὺς",709436,58],["ἰσχυροὺς",706855,60],["καὶ",707031,7],["τοὺς",709436,58],["τεταμένους",712754,360],["καὶ",707031,7],["καταβαλῶ",707203,165],["τὴν",709436,8],["μάχαιραν",708593,9],["αὐτοῦ",702165,102],["ἐκ",704132,0],["τῆς",709436,16],["χειρὸς",713787,17],["αὐτοῦ",702165,102]],"Therefore thus saith the Lord God; Behold, I am against Pharao king of Egypt, and I will break his strong and outstretched arms, and will smite down his sword out of his hand."],["23",[["καὶ",707031,7],["διασπερῶ",703584,165],["Αἴγυπτον",700401,9],["εἰς",704105,0],["τὰ",709436,41],["ἔθνη",704068,42],["καὶ",707031,7],["λικμήσω",708202,165],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὰς",709436,38],["χώρας",714011,39]],"And I will disperse the Egyptians among the nations, and will utterly scatter them among the countries."],["24",[["καὶ",707031,7],["κατισχύσω",707531,165],["τοὺς",709436,58],["βραχίονας",702808,57],["βασιλέως",702580,18],["Βαβυλῶνος",702352,17],["καὶ",707031,7],["δώσω",703654,165],["τὴν",709436,8],["ῥομφαίαν",711291,9],["μου",709032,133],["εἰς",704105,0],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπάξει",704994,127],["αὐτὴν",702165,104],["ἐπ᾿",705080,0],["Αἴγυπτον",700401,9],["καὶ",707031,7],["προνομεύσει",710826,127],["τὴν",709436,8],["προνομὴν",710827,9],["αὐτῆς",702165,86],["καὶ",707031,7],["σκυλεύσει",711900,127],["τὰ",709436,41],["σκῦλα",711902,42],["αὐτῆς",702165,86]],"And I will strengthen the arms of the king of Babylon, and put my sword into his hand: and he shall bring it upon Egypt, and shall take her plunder and seize her spoils."],["25",[["καὶ",707031,7],["ἐνισχύσω",704750,165],["τοὺς",709436,58],["βραχίονας",702808,57],["βασιλέως",702580,18],["Βαβυλῶνος",702352,17],["οἱ",709436,136],["δὲ",703303,11],["βραχίονες",702808,52],["Φαραω",713360,18],["πεσοῦνται",710481,135],["καὶ",707031,7],["γνώσονται",703105,135],["ὅτι",709803,7],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["ἐν",704639,0],["τῷ",709436,53],["δοῦναι",703654,106],["τὴν",709436,8],["ῥομφαίαν",711291,9],["μου",709032,133],["εἰς",704105,0],["χεῖρας",713787,39],["βασιλέως",702580,18],["Βαβυλῶνος",702352,17],["καὶ",707031,7],["ἐκτενεῖ",704322,127],["αὐτὴν",702165,104],["ἐπὶ",705080,0],["γῆν",703083,9],["Αἰγύπτου",700401,17]],"Yea, I will strengthen the arms of the king of Babylon, and the arms of Pharao shall fail: and they shall know that I am the Lord, when I have put my sword into the hands of the king of Babylon, and he shall stretch it out over the land of Egypt."],["26",[["καὶ",707031,7],["διασπερῶ",703584,165],["Αἴγυπτον",700401,9],["εἰς",704105,0],["τὰ",709436,41],["ἔθνη",704068,42],["καὶ",707031,7],["λικμήσω",708202,165],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὰς",709436,38],["χώρας",714011,39],["καὶ",707031,7],["γνώσονται",703105,135],["πάντες",710177,138],["ὅτι",709803,7],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4]],"And I will disperse the Egyptians among the nations, and utterly scatter them among the countries; and they all shall know that I am the Lord."]]