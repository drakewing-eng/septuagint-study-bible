αυματιῶν",712921,81]],"in the midst of the slain."],["26",[["ἐκεῖ",704181,28],["ἐδόθησαν",703654,99],["Μοσοχ",709025,120],["καὶ",707031,7],["Θοβελ",706281,120],["καὶ",707031,7],["πᾶσα",710177,29],["ἡ",709436,10],["ἰσχὺς",706858,12],["αὐτῶν",702165,40],["περικύκλῳ",710340,28],["τοῦ",709436,20],["μνήματος",708962,21],["αὐτοῦ",702165,102],["πάντες",710177,138],["τραυματίαι",712921,52],["αὐτοῦ",702165,102],["πάντες",710177,138],["ἀπερίτμητοι",701397,138],["τραυματίαι",712921,52],["ἀπὸ",701425,0],["μαχαίρας",708593,39],["οἱ",709436,136],["δεδωκότες",703654,268],["τὸν",709436,5],["φόβον",713534,6],["αὐτῶν",702165,40],["ἐπὶ",705080,0],["γῆς",703083,17],["ζωῆς",705910,17]],"There were laid Mosoch, and Thobel, and all his strength round about his tomb: all his slain men, all the uncircumcised, slain with the sword, who caused their fear to be in the land of the living."],["27",[["καὶ",707031,7],["ἐκοιμήθησαν",707767,99],["μετὰ",708780,0],["τῶν",709436,80],["γιγάντων",703101,81],["τῶν",709436,80],["πεπτωκότων",710481,387],["ἀπὸ",701425,0],["αἰῶνος",700504,18],["οἳ",709781,250],["κατέβησαν",707202,150],["εἰς",704105,0],["ᾅδου",700255,18],["ἐν",704639,0],["ὅπλοις",709704,96],["πολεμικοῖς",710602,94],["καὶ",707031,7],["ἔθηκαν",712849,150],["τὰς",709436,38],["μαχαίρας",708593,39],["αὐτῶν",702165,40],["ὑπὸ",713184,0],["τὰς",709436,38],["κεφαλὰς",707639,39],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐγενήθησαν",703104,99],["αἱ",709436,190],["ἀνομίαι",701192,191],["αὐτῶν",702165,40],["ἐπὶ",705080,0],["τῶν",709436,43],["ὀστῶν",709792,44],["αὐτῶν",702165,40],["ὅτι",709803,7],["ἐξεφόβησαν",704360,150],["γίγαντας",703101,57],["ἐν",704639,0],["γῇ",703083,1],["ζωῆς",705910,17]],"And they are laid with the giants that fell of old, who went down to Hades with [their] weapons of war: and they laid their swords under their heads, but their iniquities were upon their bones, because they terrified all men during their life."],["28",[["καὶ",707031,7],["σὺ",712181,164],["ἐν",704639,0],["μέσῳ",708768,