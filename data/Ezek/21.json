018,164],["κύριος",707996,4],["λελάληκα",708071,89]],"And I also will clap my hands, and let loose my fury: I the Lord have spoken [it]."],["23",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72]],"And the word of the Lord came to me, saying,"],["24",[["καὶ",707031,7],["σύ",712181,164],["υἱὲ",713075,153],["ἀνθρώπου",701163,18],["διάταξον",703603,176],["σεαυτῷ",711599,50],["δύο",703849,59],["ὁδοὺς",709458,39],["τοῦ",709436,20],["εἰσελθεῖν",704114,106],["ῥομφαίαν",711291,9],["βασιλέως",702580,18],["Βαβυλῶνος",702352,17],["ἐκ",704132,0],["χώρας",714011,17],["μιᾶς",704106,82],["ἐξελεύσονται",704909,135],["αἱ",709436,190],["δύο",703849,59],["καὶ",707031,7],["χεὶρ",713787,12],["ἐν",704639,0],["ἀρχῇ",701836,1],["ὁδοῦ",709458,17],["πόλεως",710612,17],["ἐπ᾿",705080,0],["ἀρχῆς",701836,17]],"And thou, son of man, appoint thee two ways, that the sword of the king of Babylon may enter in: the two shall go forth of one country; and [there shall be] a force at the top of the way of the city, thou shalt set [it] at the top of the way,"],["25",[["ὁδοῦ",709458,17],["διατάξεις",703603,166],["τοῦ",709436,20],["εἰσελθεῖν",704114,106],["ῥομφαίαν",711291,9],["ἐπὶ",705080,0],["Ραββαθ",711132,227],["υἱῶν",713075,81],["Αμμων",700847,18],["καὶ",707031,7],["ἐπὶ",705080,0],["τὴν",709436,8],["Ιουδαίαν",706769,9],["καὶ",707031,7],["ἐπὶ",705080,0],["Ιερουσαλημ",706644,9],["ἐν",704639,0],["μέσῳ",708768,30],["αὐτῆς",702165,86]],"that the sword may enter in upon Rabbath of the children of Ammon, and upon Judea, and upon Jerusalem in the midst thereof."],["26",[["διότι",703734,7],["στήσεται",706846,93],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,17],["ἐπὶ",705080,0],["τὴν",709436,8],["ἀρχαίαν",701835,36],["ὁδὸν",709458,9],["ἐπ᾿",705080,0],["ἀρχῆς",701836,17],["τῶν",709436,130],["δύο",703849,59],["ὁδῶν",709458,65],["τοῦ",709436,20],["μαντεύσασθαι",708490,109],["μαντείαν",708488,9],["τοῦ",709436,20],["ἀναβράσαι",700917,10