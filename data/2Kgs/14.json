0",[["τύπτων",713022,72],["ἐπάταξας",710185,162],["τὴν",709436,8],["Ιδουμαίαν",706503,9],["καὶ",707031,7],["ἐπῆρέν",705002,2],["σε",711598,163],["ἡ",709436,10],["καρδία",707141,12],["σου",711945,133],["ἐνδοξάσθητι",704693,244],["καθήμενος",707000,122],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["σου",711945,133],["καὶ",707031,7],["ἵνα",706747,7],["τί",712867,126],["ἐρίζεις",705423,154],["ἐν",704639,0],["κακίᾳ",707054,1],["σου",711945,133],["καὶ",707031,7],["πεσῇ",710481,123],["σὺ",712181,164],["καὶ",707031,7],["Ιουδας",706775,4],["μετὰ",708780,0],["σοῦ",711945,133]],"Thou hast smitten and wounded Edom, and thy heart has lifted thee up: stay at home and glorify thyself; for wherefore art thou quarrelsome to thy hurt? So [both] thou wilt fall and Juda with thee."],["11",[["καὶ",707031,7],["οὐκ",709805,28],["ἤκουσεν",700587,2],["Αμεσσιας",700814,4],["καὶ",707031,7],["ἀνέβη",700905,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ισραηλ",706839,18],["καὶ",707031,7],["ὤφθησαν",709725,99],["προσώποις",710986,96],["αὐτὸς",702165,121],["καὶ",707031,7],["Αμεσσιας",700814,4],["βασιλεὺς",702580,4],["Ιουδα",706768,18],["ἐν",704639,0],["Βαιθσαμυς",702430,1],["τῇ",709436,100],["τοῦ",709436,35],["Ιουδα",706768,18]],"Nevertheless Amessias hearkened not: so Joas king of Israel went up, and he and Amessias king of Juda looked one another in the face in Bæthsamys of Juda."],["12",[["καὶ",707031,7],["ἔπταισεν",711048,2],["Ιουδας",706775,4],["ἀπὸ",701425,0],["προσώπου",710986,21],["Ισραηλ",706839,18],["καὶ",707031,7],["ἔφυγεν",713433,2],["ἀνὴρ",701150,4],["εἰς",704105,0],["τὸ",709436,24],["σκήνωμα",711849,25],["αὐτοῦ",702165,102]],"And Juda was overthrown before Israel, and [every] man fled to his tent."],["13",[["καὶ",707031,7],["τὸν",709436,5],["Αμεσσιαν",700814,6],["υἱὸν",713075,6],["Ιωας",706896,18],["υἱοῦ",713075,18],["Οχοζιου",709888,18],["βασιλέα",702580,6],["Ιουδα",706768,18],["συνέλαβεν",712262,2],["Ιωας",706896,4],["υἱὸς",713075,4],["Ιωαχας",706902,18],["βασιλεὺς",702580,4],["Ισραηλ",706839,18],["ἐν",704639,0],["Βαιθσαμυς",702430,1],["καὶ",707031,7],["ἦλθεν",705453,2],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["καθεῖλεν",706982,2],["ἐν",704639,0],["τῷ",709436,53],["τείχει",712759,54],["Ιερουσαλημ",706644,17],["ἐν",704639,0],["τῇ",709436,100],["πύλῃ",711082,1],["Εφραιμ",705769,18],["ἕως",705792,0],["πύλης",711082,17],["τῆς",709436,16],["γωνίας",703226,17],["τετρακοσίους",712817,60],["πήχεις",710462,60]],"And Joas king of Israel took Amessias the son of Joas the son of Ochozias, in Bæthsamys; and he came to Jerusalem, and broke down the wall of Jerusalem, [beginning] at the gate of Ephraim as far as the gate of the corner, four hundred cubits."],["14",[["καὶ",707031,7],["ἔλαβεν",708076,2],["τὸ",709436,24],["χρυσίον",713972,25],["καὶ",707031,7],["τὸ",709436,24],["ἀργύριον",701707,25],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["σκεύη",711844,42],["τὰ",709436,41],["εὑρεθέντα",705676,328],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18],["καὶ",707031,7],["ἐν",704639,0],["θησαυροῖς",706258,148],["οἴκου",709516,18],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["τοὺς",709436,58],["υἱοὺς",713075,57],["τῶν",709436,130],["συμμίξεων",712309,65],["καὶ",707031,7],["ἀπέστρεψεν",701598,2],["εἰς",704105,0],["Σαμάρειαν",711449,9]],"And he took the gold, and the silver, and all the vessels that were found in the house of the Lord, and in the treasures of the king's house, and the hostages, and returned to Samaria."],["15",[["καὶ",707031,7],["τὰ",709436,63],["λοιπὰ",708248,195],["τῶν",709436,80],["λόγων",708236,81],["Ιωας",706896,18],["ὅσα",709788,68],["ἐποίησεν",710582,2],["ἐν",704639,0],["δυναστείᾳ",703841,1],["αὐτοῦ",702165,102],["ἃ",709781,69],["ἐπολέμησεν",710601,2],["μετὰ",708780,0],["Αμεσσιου",700814,18],["βασιλέως",702580,18],["Ιουδα",706768,18],["οὐχὶ",709862,28],["ταῦτα",709858,290],["γεγραμμένα",703194,443],["ἐπὶ",705080,0],["βιβλίῳ",702719,54],["λόγων",708236,81],["τῶν",709436,130],["ἡμερῶν",70