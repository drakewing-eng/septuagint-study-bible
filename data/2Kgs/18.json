[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["ἔτει",705543,54],["τρίτῳ",712968,97],["τῷ",709436,113],["Ωσηε",714161,114],["υἱῷ",713075,114],["Ηλα",705957,18],["βασιλεῖ",702580,114],["Ισραηλ",706839,18],["ἐβασίλευσεν",702581,2],["Εζεκιας",704044,4],["υἱὸς",713075,4],["Αχαζ",702245,18],["βασιλέως",702580,18],["Ιουδα",706768,18]],"And it came to pass in the third year of Osee son of Ela king of Israel [that] Ezekias son of Achaz king of Juda began to reign."],["2",[["υἱὸς",713075,4],["εἴκοσι",704085,59],["καὶ",707031,7],["πέντε",710266,59],["ἐτῶν",705543,44],["ἦν",704093,13],["ἐν",704639,0],["τῷ",709436,53],["βασιλεύειν",702581,55],["αὐτὸν",702165,85],["καὶ",707031,7],["εἴκοσι",704085,59],["καὶ",707031,7],["ἐννέα",704754,59],["ἔτη",705543,42],["ἐβασίλευσεν",702581,2],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["ὄνομα",709666,15],["τῇ",709436,100],["μητρὶ",708892,1],["αὐτοῦ",702165,102],["Αβου",700085,12],["θυγάτηρ",706320,12],["Ζαχαριου",705847,18]],"Five and twenty years old was he when he began to reign, and he reigned twenty and nine years in Jerusalem: and his mother's name [was] Abu, daughter of Zacharias."],["3",[["καὶ",707031,7],["ἐποίησεν",710582,2],["τὸ",709436,24],["εὐθὲς",705596,46],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["κυρίου",707996,18],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἐποίησεν",710582,2],["Δαυιδ",703232,4],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτοῦ",702165,102]],"And he did that which was right in the sight of the Lord, according to all that his father David did."],["4",[["αὐτὸς",702165,121],["ἐξῆρεν",704839,2],["τὰ",709436,41],["ὑψηλὰ",713285,68],["καὶ",707031,7],["συνέτριψεν",712520,2],["πάσας",710177,119],["τὰς",709436,38],["στήλας",712092,39],["καὶ",707031,7],["ἐξωλέθρευσεν",704956,2],["τὰ",709436,41],["ἄλση",700729,42],["καὶ",707031,7],["τὸν",709436,5],["ὄφιν",709875,6],["τὸν",709436,5],["χαλκοῦν",713690,27],["ὃν",709781,112],["ἐποίησεν",710582,2],["Μωυσῆς",709112,4],["ὅτι",709803,7],["ἕως",705792,0],["τῶν",709436,130],["ἡμερῶν",705984,65],["ἐκείνων",704183,284],["ἦσαν",704093,137],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["θυμιῶντες",706329,146],["αὐτῷ",702165,50],["καὶ",707031,7],["ἐκάλεσεν",707084,2],["αὐτὸν",702165,85],["Νεεσθαν",709243,6]],"He removed the high places, and broke in pieces the pillars, and utterly destroyed the groves, and the brazen serpent which Moses made: because until those days the children of Israel burnt incense to it: and he called it Neesthan."],["5",[["ἐν",704639,0],["κυρίῳ",707996,114],["θεῷ",706192,114],["Ισραηλ",706839,18],["ἤλπισεν",704529,2],["καὶ",707031,7],["μετ᾿",708780,0],["αὐτὸν",702165,85],["οὐκ",709805,28],["ἐγενήθη",703104,37],["ὅμοιος",709626,14],["αὐτῷ",702165,50],["ἐν",704639,0],["βασιλεῦσιν",702580,148],["Ιουδα",706768,18],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["γενομένοις",703104,615],["ἔμπροσθεν",704618,0],["αὐτοῦ",702165,102]],"He trusted in the Lord God of Israel; and after him there was not any like him among the kings of Juda, nor among those that were before him."],["6",[["καὶ",707031,7],["ἐκολλήθη",707791,37],["τῷ",709436,113],["κυρίῳ",707996,114],["οὐκ",709805,28],["ἀπέστη",702214,2],["ὄπισθεν",709691,28],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐφύλαξεν",713619,2],["τὰς",709436,38],["ἐντολὰς",704802,39],["αὐτοῦ",702165,102],["ὅσας",709788,119],["ἐνετείλατο",704791,23],["Μωυσῇ",709112,114]],"And he clave to the Lord, he departed not from following him; and he kept his commandments, as many as he commanded Moses."],["7",[["καὶ",707031,7],["ἦν",704093,13],["κύριος",707996,4],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἐν",704639,0],["πᾶσιν",710177,230],["οἷς",709781,311],["ἐποίει",710582,13],["συνῆκεν",712481,2],["καὶ",707031,7],["ἠθέτησεν",700369,2],["ἐν",704639,0],["τῷ",709436,113],["βασιλεῖ",702580,114],["Ἀσσυρίων",702004,81],["καὶ",707031,7],["οὐκ",709805,28],["ἐδούλευσεν",703814,2],["αὐτῷ",702165,50]],"And the Lord was with him; and he was wise in all that he undertook: and he revolted from the king of the Assyrians, and served him not."],["8",[["αὐτὸς",702165,121],["ἐπάταξεν",710185,2],["τοὺς",709436,58],["ἀλλοφύλους",700706,60],["ἕως",705792,0],["Γάζης",702884,17],["καὶ",707031,7],["ἕως",705792,0],["ὁρίου",709749,21],["αὐτῆς",702165,86],["ἀπὸ",701425,0],["πύργου",711092,18],["φυλασσόντων",713619,170],["καὶ",707031,7],["ἕως",705792,0],["πόλεως",710612,17],["ὀχυρᾶς",709889,82]],"He smote the Philistines [even] to Gaza, and to the border of it, from the tower of the watchmen even to the strong city."],["9",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["τῷ",709436,53],["ἔτει",705543,54],["τῷ",709436,53],["τετάρτῳ",712811,97],["βασιλεῖ",702580,114],["Εζεκια",704044,114],["αὐτὸς",702165,121],["ἐνιαυτὸς",704745,4],["ὁ",709436,3],["ἕβδομος",703925,14],["τῷ",709436,113],["Ωσηε",714161,114],["υἱῷ",713075,114],["Ηλα",705957,18],["βασιλεῖ",702580,114],["Ισραηλ",706839,18],["ἀνέβη",700905,2],["Σαλαμανασσαρ",711396,4],["βασιλεὺς",702580,4],["Ἀσσυρίων",702004,81],["ἐπὶ",705080,0],["Σαμάρειαν",711449,9],["καὶ",707031,7],["ἐπολιόρκει",710608,13],["ἐπ᾿",705080,0],["αὐτήν",702165,104]],"And it came to pass in the fourth year of king Ezekias (this is the seventh year of Osee son of Ela king of Israel,) [that] Salamanassar king of the Assyrians came up against Samaria, and besieged it."],["10",[["καὶ",707031,7],["κατελάβετο",707300,23],["αὐτὴν",702165,104],["ἀπὸ",701425,0],["τέλους",712787,21],["τριῶν",712927,83],["ἐτῶν",705543,44],["ἐν",704639,0],["ἔτει",705543,54],["ἕκτῳ",704340,97],["τῷ",709436,113],["Εζεκια",704044,114],["αὐτὸς",702165,121],["ἐνιαυτὸς",704745,4],["ἔνατος",704666,14],["τῷ",709436,113],["Ωσηε",714161,114],["βασιλεῖ",702580,114],["Ισραηλ",706839,18],["καὶ",707031,7],["συνελήμφθη",712262,37],["Σαμάρεια",711449,12]],"And he took it at the end of three years, in the sixth year of Ezekias, (this [is] the ninth year of Osee king of Israel, when Samaria was taken.)"],["11",[["καὶ",707031,7],["ἀπῴκισεν",701464,2],["βασιλεὺς",702580,4],["Ἀσσυρίων",702004,81],["τὴν",709436,8],["Σαμάρειαν",711449,9],["εἰς",704105,0],["Ἀσσυρίους",702004,57],["καὶ",707031,7],["ἔθηκεν",712849,2],["αὐτοὺς",702165,62],["ἐν",704639,0],["Αλαε",700626,1],["καὶ",707031,7],["ἐν",704639,0],["Αβωρ",700100,1],["ποταμῷ",710693,114],["Γωζαν",703215,17],["καὶ",707031,7],["Ορη",709736,96],["Μήδων",708864,17]],"And the king of the Assyrians carried away the Samaritans to Assyria, and put them in Alaë and in Abor, [by] the river Gozan, and [in] the mountains of the Medes;"],["12",[["ἀνθ᾿",701227,0],["ὧν",709781,252],["ὅτι",709803,7],["οὐκ",709805,28],["ἤκουσαν",700587,150],["τῆς",709436,16],["φωνῆς",713640,17],["κυρίου",707996,18],["θεοῦ",706192,18],["αὐτῶν",702165,40],["καὶ",707031,7],["παρέβησαν",709996,150],["τὴν",709436,8],["διαθήκην",703456,9],["αὐτοῦ",702165,102],["πάντα",710177,68],["ὅσα",709788,68],["ἐνετείλατο",704791,23],["Μωυσῆς",709112,4],["ὁ",709436,3],["δοῦλος",703817,4],["κυρίου",707996,18],["καὶ",707031,7],["οὐκ",709805,28],["ἤκουσαν",700587,150],["καὶ",707031,7],["οὐκ",709805,28],["ἐποίησαν",710582,150]],"because they hearkened not to the voice of the Lord their God, and transgressed his covenant, [even] in all things that Moses the servant of the Lord commanded, and hearkened not [to them], nor did [them]."],["13",[["καὶ",707031,7],["τῷ",709436,53],["τεσσαρεσκαιδεκάτῳ",712809,97],["ἔτει",705543,54],["βασιλεῖ",702580,114],["Εζεκιου",704044,18],["ἀνέβη",700905,2],["Σενναχηριμ",711693,4],["βασιλεὺς",702580,4],["Ἀσσυρίων",702004,81],["ἐπὶ",705080,0],["τὰς",709436,38],["πόλεις",710612,39],["Ιουδα",706768,18],["τὰς",709436,38],["ὀχυρὰς",709889,119],["καὶ",707031,7],["συνέλαβεν",712262,2],["αὐτάς",702165,231]],"And in the fourteenth year of king Ezekias came up Sennacherim king of the Assyrians against the strong cities of Juda, and took them."],["14",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Εζεκιας",704044,4],["βασιλεὺς",702580,4],["Ιουδα",706768,18],["ἀγγέλους",700140,57],["πρὸς",710844,0],["βασιλέα",702580,6],["Ἀσσυρίων",702004,81],["εἰς",704105,0],["Λαχις",708116,9],["λέγων",708124,72],["ἡμάρτηκα",700773,89],["ἀποστράφητι",701598,244],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["ὃ",709781,128],["ἐὰν",703912,7],["ἐπιθῇς",705304,175],["ἐπ᾿",705080,0],["ἐμέ",704555,163],["βαστάσω",702594,165],["καὶ",707031,7],["ἐπέθηκεν",705304,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ἀσσυρίων",702004,81],["ἐπὶ",705080,0],["Εζεκιαν",704044,6],["βασιλέα",702580,6],["Ιουδα",706768,18],["τριακόσια",712936,68],["τάλαντα",712697,42],["ἀργυρίου",701707,21],["καὶ",707031,7],["τριάκοντα",712934,59],["τάλαντα",712697,42],["χρυσίου",713972,21]],"And Ezekias king of Juda sent messengers to the king of the Assyrians to Lachis, saying, I have offended; depart from me: whatsoever thou shalt lay upon me, I will bear. And the king of Assyria laid upon Ezekias king of Juda [a tribute of] three hundred talents of silver, and thirty talents of gold."],["15",[["καὶ",707031,7],["ἔδωκεν",703654,2],["Εζεκιας",704044,4],["πᾶν",710177,26],["τὸ",709436,24],["ἀργύριον",701707,25],["τὸ",709436,34],["εὑρεθὲν",705676,418],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18],["καὶ",707031,7],["ἐν",704639,0],["θησαυροῖς",706258,148],["οἴκου",709516,18],["τοῦ",709436,35],["βασιλέως",702580,18]],"And Ezekias gave all the silver that was found in the house of the Lord, and in the treasures of the king's house."],["16",[["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["συνέκοψεν",712230,2],["Εζεκιας",704044,4],["τὰς",709436,38],["θύρας",706337,39],["ναοῦ",709191,18],["κυρίου",707996,18],["καὶ",707031,7],["τὰ",709436,41],["ἐστηριγμένα",712098,388],["ἃ",709781,69],["ἐχρύσωσεν",713980,2],["Εζεκιας",704044,4],["βασιλεὺς",702580,4],["Ιουδα",706768,18],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτὰ",702165,71],["βασιλεῖ",702580,114],["Ἀσσυρίων",702004,81]],"At that time Ezekias cut off [the gold from] the doors of the temple, and [from] the pillars which Ezekias king of Juda [had] overlaid with gold, and gave it to the king of the Assyrians."],["17",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["βασιλεὺς",702580,4],["Ἀσσυρίων",702004,81],["τὸν",709436,5],["Θαρθαν",706115,6],["καὶ",707031,7],["τὸν",709436,5],["Ραφις",711205,6],["καὶ",707031,7],["τὸν",709436,5],["Ραψακην",711210,6],["ἐκ",704132,0],["Λαχις",708116,17],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["Εζεκιαν",704044,6],["ἐν",704639,0],["δυνάμει",703839,1],["βαρείᾳ",702554,101],["ἐπὶ",705080,0],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["ἀνέβησαν",700905,150],["καὶ",707031,7],["ἦλθον",705453,150],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["ἔστησαν",706846,150],["ἐν",704639,0],["τῷ",709436,113],["ὑδραγωγῷ",713065,114],["τῆς",709436,16],["κολυμβήθρας",707802,17],["τῆς",709436,16],["ἄνω",701296,28],["ἥ",709781,177],["ἐστιν",704093,91],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["τοῦ",709436,35],["ἀγροῦ",700196,18],["τοῦ",709436,35],["γναφέως",703127,18]],"And the king of the Assyrians sent Tharthan and Raphis and Rapsakes from Lachis to king Ezekias with a strong force against Jerusalem. And they went up and came to Jerusalem, and stood by the aqueduct of the upper pool, which is by the way of the fuller's field."],["18",[["καὶ",707031,7],["ἐβόησαν",702743,150],["πρὸς",710844,0],["Εζεκιαν",704044,6],["καὶ",707031,7],["ἐξῆλθον",704909,150],["πρὸς",710844,0],["αὐτὸν",702165,85],["Ελιακιμ",704454,4],["υἱὸς",713075,4],["Χελκιου",713815,18],["ὁ",709436,3],["οἰκονόμος",709514,4],["καὶ",707031,7],["Σομνας",711936,4],["ὁ",709436,3],["γραμματεὺς",703185,4],["καὶ",707031,7],["Ιωας",706896,4],["υἱὸς",713075,4],["Ασαφ",701894,18],["ὁ",709436,3],["ἀναμιμνῄσκων",701002,72]],"And they cried to Ezekias: and there came to him Heliakim the son of Chelcias the steward, and Somnas the scribe, and Joas the son of Saphat the recorder."],["19",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτοὺς",702165,62],["Ραψακης",711210,4],["εἴπατε",705373,74],["δὴ",703395,11],["πρὸς",710844,0],["Εζεκιαν",704044,6],["τάδε",709446,71],["λέγει",708124,91],["ὁ",709436,3],["βασιλεὺς",702580,4],["ὁ",709436,3],["μέγας",708653,14],["βασιλεὺς",702580,4],["Ἀσσυρίων",702004,81],["τίς",712867,126],["ἡ",709436,10],["πεποίθησις",710275,12],["αὕτη",709858,107],["ἣν",709781,131],["πέποιθας",710221,266]],"And Rapsakes said to them, Say now to Ezekias, Thus says the king, the great king of the Assyrians, What [is] this confidence wherein thou trustest?"],["20",[["εἶπας",705373,162],["πλὴν",710540,7],["λόγοι",708236,52],["χειλέων",713781,44],["βουλὴ",702792,12],["καὶ",707031,7],["δύναμις",703839,12],["εἰς",704105,0],["πόλεμον",710605,6],["νῦν",709384,28],["οὖν",709835,11],["τίνι",712867,432],["πεποιθὼς",710221,270],["ἠθέτησας",700369,162],["ἐν",704639,0],["ἐμοί",704577,159]],"Thou hast said, (but [they are] mere words,) [I have] counsel and strength for war. Now then in whom dost thou trust, that thou hast revolted from me?"],["21",[["νῦν",709384,28],["ἰδοὺ",706497,88],["πέποιθας",710221,266],["σαυτῷ",711599,50],["ἐπὶ",705080,0],["τὴν",709436,8],["ῥάβδον",711135,9],["τὴν",709436,8],["καλαμίνην",707080,36],["τὴν",709436,8],["τεθλασμένην",706273,436],["ταύτην",709858,104],["ἐπ᾿",705080,0],["Αἴγυπτον",700401,9],["ὃς",709781,213],["ἂν",700900,11],["στηριχθῇ",712098,384],["ἀνὴρ",701150,4],["ἐπ᾿",705080,0],["αὐτήν",702165,104],["καὶ",707031,7],["εἰσελεύσεται",704114,93],["εἰς",704105,0],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["τρήσει",712814,127],["αὐτήν",702165,104],["οὕτως",709859,28],["Φαραω",713360,4],["βασιλεὺς",702580,4],["Αἰγύπτου",700401,17],["πᾶσιν",710177,230],["τοῖς",709436,147],["πεποιθόσιν",710221,536],["ἐπ᾿",705080,0],["αὐτόν",702165,85]],"See now, art thou trusting for thyself on this broken staff of reed, [even] upon Egypt? whosoever shall stay himself upon it, it shall even go into his hand, and pierce it: so [is] Pharao king of Egypt to all that trust on him."],["22",[["καὶ",707031,7],["ὅτι",709803,7],["εἶπας",705373,162],["πρός",710844,0],["με",708618,163],["ἐπὶ",705080,0],["κύριον",707996,6],["θεὸν",706192,6],["πεποίθαμεν",710221,314],["οὐχὶ",709862,28],["αὐτὸς",702165,121],["οὗτος",709858,121],["οὗ",709781,48],["ἀπέστησεν",702214,2],["Εζεκιας",704044,4],["τὰ",709436,41],["ὑψηλὰ",713285,68],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["θυσιαστήρια",706348,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["τῷ",709436,113],["Ιουδα",706768,114],["καὶ",707031,7],["τῇ",709436,100],["Ιερουσαλημ",706644,1],["ἐνώπιον",704823,0],["τοῦ",709436,20],["θυσιαστηρίου",706348,21],["τούτου",709858,49],["προσκυνήσετε",710925,337],["ἐν",704639,0],["Ιερουσαλημ",706644,1]],"And whereas thou hast said to me, We trust on the Lord God: [is] not this he, whose high places and altars Ezekias has removed, and has said to Juda and Jerusalem, Ye shall worship before this altar in Jerusalem?"],["23",[["καὶ",707031,7],["νῦν",709384,28],["μίχθητε",708911,372],["δὴ",703395,11],["τῷ",709436,113],["κυρίῳ",707996,114],["μου",709032,133],["βασιλεῖ",702580,114],["Ἀσσυρίων",702004,81],["καὶ",707031,7],["δώσω",703654,165],["σοι",711925,159],["δισχιλίους",703747,60],["ἵππους",706790,57],["εἰ",704071,7],["δυνήσῃ",703838,123],["δοῦναι",703654,106],["σεαυτῷ",711599,50],["ἐπιβάτας",705085,57],["ἐπ᾿",705080,0],["αὐτούς",702165,62]],"And now, I pray you, make an agreement with my lord the king of the Assyrians, and I will give thee two thousand horses, if thou shalt be able on thy part to set riders upon them."],["24",[["καὶ",707031,7],["πῶς",711121,28],["ἀποστρέψεις",701598,166],["τὸ",709436,24],["πρόσωπον",710986,25],["τοπάρχου",712901,18],["ἑνὸς",704106,116],["τῶν",709436,80],["δούλων",703817,81],["τοῦ",709436,35],["κυρίου",707996,18],["μου",709032,133],["τῶν",709436,80],["ἐλαχίστων",704400,616],["καὶ",707031,7],["ἤλπισας",704529,162],["σαυτῷ",711599,50],["ἐπ᾿",705080,0],["Αἴγυπτον",700401,9],["εἰς",704105,0],["ἅρματα",701768,42],["καὶ",707031,7],["ἱππεῖς",706786,57]],"How then wilt thou turn away the face of one petty governor from among the least of my lord's servants? whereas thou trustest for thyself on Egypt for chariots and horsemen."],["25",[["καὶ",707031,7],["νῦν",709384,28],["μὴ",708851,28],["ἄνευ",701137,0],["κυρίου",707996,18],["ἀνέβημεν",700905,289],["ἐπὶ",705080,0],["τὸν",709436,5],["τόπον",712903,6],["τοῦτον",709858,85],["τοῦ",709436,20],["διαφθεῖραι",703624,106],["αὐτόν",702165,85],["κύριος",707996,4],["εἶπεν",705373,2],["πρός",710844,0],["με",708618,163],["ἀνάβηθι",700905,176],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104],["καὶ",707031,7],["διάφθειρον",703624,176],["αὐτήν",702165,104]],"And now have we come up without the Lord against this place to destroy it? The Lord said to me, Go up against this land, and destroy it."],["26",[["καὶ",707031,7],["εἶπεν",705373,2],["Ελιακιμ",704454,4],["υἱὸς",713075,4],["Χελκιου",713815,18],["καὶ",707031,7],["Σομνας",711936,4],["καὶ",707031,7],["Ιωας",706896,4],["πρὸς",710844,0],["Ραψακην",711210,6],["λάλησον",708071,176],["δὴ",703395,11],["πρὸς",710844,0],["τοὺς",709436,58],["παῖδάς",709932,57],["σου",711945,133],["Συριστί",712540,28],["ὅτι",709803,7],["ἀκούομεν",700587,243],["ἡμεῖς",705983,219],["καὶ",707031,7],["οὐ",709805,28],["λαλήσεις",708071,166],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["Ιουδαϊστί",706774,28],["καὶ",707031,7],["ἵνα",706747,7],["τί",712867,126],["λαλεῖς",708071,154],["ἐν",704639,0],["τοῖς",709436,95],["ὠσὶν",709852,96],["τοῦ",709436,35],["λαοῦ",708094,18],["τοῦ",709436,35],["ἐπὶ",705080,0],["τοῦ",709436,20],["τείχους",712759,21]],"And Heliakim the son of Chelkias, and Somnas, and Joas, said to Rapsakes, Speak now to thy servants in the Syrian language, for we understand it; and speak not with us in the Jewish language: and why dost thou speak in the ears of the people that are on the wall?"],["27",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτοὺς",702165,62],["Ραψακης",711210,4],["μὴ",708851,28],["ἐπὶ",705080,0],["τὸν",709436,5],["κύριόν",707996,6],["σου",711945,133],["καὶ",707031,7],["πρὸς",710844,0],["σὲ",711598,163],["ἀπέστειλέν",701592,2],["με",708618,163],["ὁ",709436,3],["κύριός",707996,4],["μου",709032,133],["λαλῆσαι",708071,106],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["οὐχὶ",709862,28],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἄνδρας",701150,57],["τοὺς",709436,58],["καθημένους",707000,236],["ἐπὶ",705080,0],["τοῦ",709436,20],["τείχους",712759,21],["τοῦ",709436,20],["φαγεῖν",713296,106],["τὴν",709436,8],["κόπρον",707828,9],["αὐτῶν",702165,40],["καὶ",707031,7],["πιεῖν",710478,106],["τὸ",709436,24],["οὖρον",709851,25],["αὐτῶν",702165,40],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["ἅμα",700745,28]],"And Rapsakes said to them, Has my master sent me to thy master, and to thee, to speak these words? [has he] not [sent me] to the men who sit on the wall, that they may eat their own dung, and drink their own water together with you?"],["28",[["καὶ",707031,7],["ἔστη",706846,2],["Ραψακης",711210,4],["καὶ",707031,7],["ἐβόησεν",702743,2],["φωνῇ",713640,1],["μεγάλῃ",708653,101],["Ιουδαϊστὶ",706774,28],["καὶ",707031,7],["ἐλάλησεν",708071,2],["καὶ",707031,7],["εἶπεν",705373,2],["ἀκούσατε",700587,74],["τοὺς",709436,58],["λόγους",708236,57],["τοῦ",709436,35],["μεγάλου",708653,116],["βασιλέως",702580,18],["Ἀσσυρίων",702004,81]],"And Rapsakes stood, and cried with a loud voice in the Jewish language, and spoke, and said, Hear the words of the great king of the Assyrians:"],["29",[["τάδε",709446,71],["λέγει",708124,91],["ὁ",709436,3],["βασιλεύς",702580,4],["μὴ",708851,28],["ἐπαιρέτω",705002,31],["ὑμᾶς",713080,194],["Εζεκιας",704044,4],["λόγοις",708236,148],["ὅτι",709803,7],["οὐ",709805,28],["μὴ",708851,28],["δύνηται",703838,428],["ὑμᾶς",713080,194],["ἐξελέσθαι",704838,109],["ἐκ",704132,0],["χειρός",713787,17],["μου",709032,133]],"thus says the king, Let not Ezekias encourage you with words: for he shall not be able to deliver you out of his hand."],["30",[["καὶ",707031,7],["μὴ",708851,28],["ἐπελπιζέτω",705064,31],["ὑμᾶς",713080,194],["Εζεκιας",704044,4],["πρὸς",710844,0],["κύριον",707996,6],["λέγων",708124,72],["ἐξαιρούμενος",704838,122],["ἐξελεῖται",704838,93],["ἡμᾶς",705981,194],["κύριος",707996,4],["οὐ",709805,28],["μὴ",708851,28],["παραδοθῇ",710014,384],["ἡ",709436,10],["πόλις",710612,12],["αὕτη",709858,107],["ἐν",704639,0],["χειρὶ",713787,1],["βασιλέως",702580,18],["Ἀσσυρίων",702004,81]],"And let not Ezekias cause you to trust on the Lord, saying, The Lord will certainly deliver us; this city shall not be delivered into the hand of the king of the Assyrians: hearken not to Ezekias:"],["31",[["μὴ",708851,28],["ἀκούετε",700587,87],["Εζεκιου",704044,18],["ὅτι",709803,7],["τάδε",709446,71],["λέγει",708124,91],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ἀσσυρίων",702004,81],["ποιήσατε",710582,74],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["εὐλογίαν",705633,9],["καὶ",707031,7],["ἐξέλθατε",704909,74],["πρός",710844,0],["με",708618,163],["καὶ",707031,7],["πίεται",710478,93],["ἀνὴρ",701150,4],["τὴν",709436,8],["ἄμπελον",700870,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀνὴρ",701150,4],["τὴν",709436,8],["συκῆν",712254,9],["αὐτοῦ",702165,102],["φάγεται",713296,93],["καὶ",707031,7],["πίεται",710478,93],["ὕδωρ",713071,25],["τοῦ",709436,35],["λάκκου",708067,18],["αὐτοῦ",702165,102]],"for thus says the king of the Assyrians, Gain my favour, and come forth to me, and every man shall drink [of the wine] of his own vine, and every man shall eat of his own fig-tree, and shall drink water out of his own cistern;"],["32",[["ἕως",705792,0],["ἔλθω",705453,207],["καὶ",707031,7],["λάβω",708076,207],["ὑμᾶς",713080,194],["εἰς",704105,0],["γῆν",703083,9],["ὡς",714148,7],["γῆ",703083,12],["ὑμῶν",713091,145],["γῆ",703083,12],["σίτου",711814,18],["καὶ",707031,7],["οἴνου",709530,18],["καὶ",707031,7],["ἄρτου",701829,18],["καὶ",707031,7],["ἀμπελώνων",700872,81],["γῆ",703083,12],["ἐλαίας",704376,17],["ἐλαίου",704380,21],["καὶ",707031,7],["μέλιτος",708700,21],["καὶ",707031,7],["ζήσετε",705851,337],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἀποθάνητε",701461,125],["καὶ",707031,7],["μὴ",708851,28],["ἀκούετε",700587,335],["Εζεκιου",704044,18],["ὅτι",709803,7],["ἀπατᾷ",701364,91],["ὑμᾶς",713080,194],["λέγων",708124,72],["κύριος",707996,4],["ῥύσεται",711309,93],["ἡμᾶς",705981,194]],"until I come and remove you to a land like your own land, a land of corn and wine, and bread and vineyards, a land of olive oil, and honey, and ye shall live and not die: and do not ye hearken to Ezekias, for he deceives you, saying, The Lord shall deliver you."],["33",[["μὴ",708851,28],["ῥυόμενοι",711309,348],["ἐρρύσαντο",711309,189],["οἱ",709436,136],["θεοὶ",706192,52],["τῶν",709436,43],["ἐθνῶν",704068,44],["ἕκαστος",704133,14],["τὴν",709436,8],["ἑαυτοῦ",703917,102],["χώραν",714011,9],["ἐκ",704132,0],["χειρὸς",713787,17],["βασιλέως",702580,18],["Ἀσσυρίων",702004,81]],"Have the gods of the nations at all delivered each their own land out of the hand of the king of the Assyrians?"],["34",[["ποῦ",710706,28],["ἐστιν",704093,91],["ὁ",709436,3],["θεὸς",706192,4],["Αιμαθ",700443,17],["καὶ",707031,7],["Αρφαδ",701830,17],["ποῦ",710706,28],["ἐστιν",704093,91],["ὁ",709436,3],["θεὸς",706192,4],["Σεπφαρουαιν",711697,52],["καὶ",707031,7],["ὅτι",709803,7],["ἐξείλαντο",704838,189],["Σαμάρειαν",711449,9],["ἐκ",704132,0],["χειρός",713787,17],["μου",709032,133]],"Where is the god of Hæmath, and of Arphad? where is the god of Seppharvaim, Ana, and Aba? for have they delivered Samaria out of my hand?"],["35",[["τίς",712867,158],["ἐν",704639,0],["πᾶσιν",710177,230],["τοῖς",709436,147],["θεοῖς",706192,148],["τῶν",709436,130],["γαιῶν",702903,65],["οἳ",709781,250],["ἐξείλαντο",704838,189],["τὰς",709436,38],["γᾶς",703083,39],["αὐτῶν",702165,40],["ἐκ",704132,0],["χειρός",713787,17],["μου",709032,133],["ὅτι",709803,7],["ἐξελεῖται",704838,93],["κύριος",707996,4],["τὴν",709436,8],["Ιερουσαλημ",706644,9],["ἐκ",704132,0],["χειρός",713787,17],["μου",709032,133]],"Who [is there] among all the gods of the countries, who have delivered their countries out of my hand, that the Lord should deliver Jerusalem out of my hand?"],["36",[["καὶ",707031,7],["ἐκώφευσαν",708032,150],["καὶ",707031,7],["οὐκ",709805,28],["ἀπεκρίθησαν",701492,99],["αὐτῷ",702165,50],["λόγον",708236,6],["ὅτι",709803,7],["ἐντολὴ",704802,12],["τοῦ",709436,35],["βασιλέως",702580,18],["λέγων",708124,72],["οὐκ",709805,28],["ἀποκριθήσεσθε",701492,261],["αὐτῷ",702165,50]],"But [the men] were silent, and answered him not a word: for [there was] a commandment of the king, saying, Ye shall not answer him."],["37",[["καὶ",707031,7],["εἰσῆλθεν",704114,2],["Ελιακιμ",704454,4],["υἱὸς",713075,4],["Χελκιου",713815,18],["ὁ",709436,3],["οἰκονόμος",709514,4],["καὶ",707031,7],["Σομνας",711936,4],["ὁ",709436,3],["γραμματεὺς",703185,4],["καὶ",707031,7],["Ιωας",706896,4],["υἱὸς",713075,4],["Ασαφ",701894,18],["ὁ",709436,3],["ἀναμιμνῄσκων",701002,72],["πρὸς",710844,0],["Εζεκιαν",704044,6],["διερρηχότες",703565,362],["τὰ",709436,41],["ἱμάτια",706742,42],["καὶ",707031,7],["ἀνήγγειλαν",700921,150],["αὐτῷ",702165,50],["τοὺς",709436,58],["λόγους",708236,57],["Ραψακου",711210,18]],"And Heliakim the son of Chelcias, the steward, and Somnas the scribe, and Joas the son of Saphat the recorder came in to Ezekias, having rent their garments; and they reported to him the words of Rapsakes."]]