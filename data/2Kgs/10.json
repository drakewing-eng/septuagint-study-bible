1],["καρδίᾳ",707141,1],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἀπέστη",702214,2],["ἐπάνωθεν",705032,28],["ἁμαρτιῶν",700775,65],["Ιεροβοαμ",706629,18],["υἱοῦ",713075,18],["Ναβατ",709134,18],["ὃς",709781,213],["ἐξήμαρτεν",704859,2],["τὸν",709436,5],["Ισραηλ",706839,6]],"But Ju took no heed to walk in the law of the Lord God of Israel with all his heart: he departed not from following the sins of Jeroboam, who made Israel to sin."],["32",[["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["ἤρξατο",701860,23],["κύριος",707996,4],["συγκόπτειν",712230,55],["ἐν",704639,0],["τῷ",709436,113],["Ισραηλ",706839,114],["καὶ",707031,7],["ἐπάταξεν",710185,2],["αὐτοὺς",702165,62],["Αζαηλ",700320,4],["ἐν",704639,0],["παντὶ",710177,97],["ὁρίῳ",709749,54],["Ισραηλ",706839,18]],"In those days the Lord began to cut Israel short; and Azael smote them in every coast of Israel;"],["33",[["ἀπὸ",701425,0],["τοῦ",709436,35],["Ιορδάνου",706763,18],["κατ᾿",707200,0],["ἀνατολὰς",701071,39],["ἡλίου",705974,18],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9],["Γαλααδ",702920,17],["τοῦ",709436,35],["Γαδδι",702877,18],["καὶ",707031,7],["τοῦ",709436,35],["Ρουβην",711295,18],["καὶ",707031,7],["τοῦ",709436,35],["Μανασση",708470,18],["ἀπὸ",701425,0],["Αροηρ",701787,17],["ἥ",709781,177],["ἐστιν",704093,91],["ἐπὶ",705080,0],["τοῦ",709436,20],["χείλους",713781,21],["χειμάρρου",713783,18],["Αρνων",701783,17],["καὶ",707031,7],["τὴν",709436,8],["Γαλααδ",702920,9],["καὶ",707031,7],["τὴν",709436,8],["Βασαν",702564,9]],"from Jordan eastward all the land of Galaad belonging to the Gadites, of Gaddi and that of Ruben, and of Manasses, from Aroer, which is on the brink of the brook of Arnon, and Galaad and Basan."],["34",[["καὶ",707031,7],["τὰ",709436,63],["λοιπὰ",708248,195],["τῶν",709436,80],["λόγων",708236,81],["Ιου",706765,18],["καὶ",707031,7],["πάντα",710177,68],["ὅσα",709788,68],["ἐποίησεν",710582,2],["καὶ",707031,7],["πᾶσα",710177,29],["ἡ",709436,10],["δυναστεία",703841,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰς",709436,38],["συνάψεις",712412,39],["ἃς",709781,193],["συνῆψεν",712404,2],["οὐχὶ",709862,28],["ταῦτα",709858,290],["γεγραμμένα",703194,443],["ἐπὶ",705080,0],["βιβλίῳ",702719,54],["λόγων",708236,81],["τῶν",709436,130],["ἡμερῶν",705984,65],["τοῖς",709436,147],["βασιλεῦσιν",702580,148],["Ισραηλ",706839,18]],"And the rest of the acts of Ju, and all that he did, and all his might, and the wars wherein he engaged, [are] not these things written in the book of the chronicles of the kings of Israel?"],["35",[["καὶ",707031,7],["ἐκοιμήθη",707767,37],["Ιου",706765,4],["μετὰ",708780,0],["τῶν",709436,80],["πατέρων",710189,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔθαψαν",706103,150],["αὐτὸν",702165,85],["ἐν",704639,0],["Σαμαρείᾳ",711449,1],["καὶ",707031,7],["ἐβασίλευσεν",702581,2],["Ιωαχας",706902,4],["υἱὸς",713075,4],["αὐτοῦ",702165,102],["ἀντ᾿",701227,0],["αὐτοῦ",702165,102]],"And Ju slept with his fathers; and they buried him in Samaria: and Joachaz his son reigned in his stead."],["36",[["καὶ",707031,7],["αἱ",709436,190],["ἡμέραι",705984,191],["ἃς",709781,193],["ἐβασίλευσεν",702581,2],["Ιου",706765,4],["ἐπὶ",705080,0],["Ισραηλ",706839,6],["εἴκοσι",704085,59],["ὀκτὼ",709555,59],["ἔτη",705543,42],["ἐν",704639,0],["Σαμαρείᾳ",711449,1]],"And the days which Ju reigned over Israel [were] twenty-eight years in Samaria."]]