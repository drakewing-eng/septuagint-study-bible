,711082,17],["τῆς",709436,16],["ἀνὰ",700902,0],["μέσον",708768,27],["τῶν",709436,43],["τειχέων",712759,44],["αὕτη",709858,107],["ἥ",709781,177],["ἐστιν",704093,91],["τοῦ",709436,35],["κήπου",707654,18],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["οἱ",709436,136],["Χαλδαῖοι",713678,52],["ἐπὶ",705080,0],["τὴν",709436,8],["πόλιν",710612,9],["κύκλῳ",707959,114],["καὶ",707031,7],["ἐπορεύθη",710667,37],["ὁδὸν",709458,9],["τὴν",709436,8],["Αραβα",701671,9]],"And the city was broken up, and all the men of war went forth by night, by the way of the gate between the walls, this is [the gate] of the king's garden: and the Chaldeans [were set] against the city round about: and [the king] went by the way of the plain."],["5",[["καὶ",707031,7],["ἐδίωξεν",703768,2],["ἡ",709436,10],["δύναμις",703839,12],["τῶν",709436,80],["Χαλδαίων",713678,18],["ὀπίσω",709697,0],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["κατέλαβον",707300,150],["αὐτὸν",702165,556],["ἐν",704639,0],["Αραβωθ",701675,1],["Ιεριχω",706620,1],["καὶ",707031,7],["πᾶσα",710177,29],["ἡ",709436,10],["δύναμις",703839,12],["αὐτοῦ",702165,559],["διεσπάρη",703584,37],["ἐπάνωθεν",705032,28],["αὐτοῦ",702165,559]],"And the force of the Chaldeans pursued the king, and overtook him in the plains of Jericho: and all his army was dispersed from about him."],["6",[["καὶ",707031,7],["συνέλαβον",712262,150],["τὸν",709436,5],["βασιλέα",702580,6],["καὶ",707031,7],["ἤγαγον",700209,150],["αὐτὸν",702165,556],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["Βαβυλῶνος",702352,17],["εἰς",704105,0],["Δεβλαθα",703308,9],["καὶ",707031,7],["ἐλάλησεν",708071,2],["μετ᾿",708780,0],["αὐτοῦ",702165,559],["κρίσιν",707908,9]],"And they took the king, and brought him to the king of Babylon to Reblatha; and he gave judgment upon him."],["7",[["καὶ",707031,7],["τοὺς",709436,58],["υἱοὺς",713075,57],["Σεδεκιου",711618,18],["ἔσφαξεν",712571,2],["κατ᾿",707200,0],["ὀφθαλμοὺς",709870,57],["αὐτοῦ",702165,559],["καὶ",707031,7],["τοὺς",709436,58],["ὀφθαλμοὺς",709870,57],["Σεδεκιου",711618,18],["ἐξετύφλωσεν",704352,2],["καὶ",707031,7],["ἔδησεν",703394,2],["αὐτὸν",702165,556],["ἐν",704639,0],["πέδαις",710210,76],["καὶ",707031,7],["ἤγαγεν",700209,2],["αὐτὸν",702165,556],["εἰς",704105,0],["Βαβυλῶνα",702352,9]],"And he slew the sons of Sedekias before his eyes, and put out the eyes of Sedekias, and bound him in fetters, and brought him to Babylon."],["8",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["μηνὶ",708874,114],["τῷ",709436,113],["πέμπτῳ",710245,30],["ἑβδόμῃ",703925,101],["τοῦ",709436,35],["μηνός",708874,18],["αὐτὸς",702165,561],["ἐνιαυτὸς",704745,4],["ἐννεακαιδέκατος",704756,4],["τῷ",709436,113],["Ναβουχοδονοσορ",709149,114],["βασιλεῖ",702580,114],["Βαβυλῶνος",702352,17],["ἦλθεν",705453,2],["Ναβουζαρδαν",709144,4],["ὁ",709436,3],["ἀρχιμάγειρος",701848,4],["ἑστὼς",706846,270],["ἐνώπιον",704823,0],["βασιλέως",702580,18],["Βαβυλῶνος",702352,17],["εἰς",704105,0],["Ιερουσαλημ",706644,9]],"And in the fifth month, on the seventh day of the month (this [is] the nineteenth year of Nabuchodonosor king of Babylon), came Nabuzardan, captain of the guard, who stood before the king of Babylon, to Jerusalem."],["9",[["καὶ",707031,7],["ἐνέπρησεν",704617,2],["τὸν",709436,5],["οἶκον",709516,6],["κυρίου",707996,18],["καὶ",707031,7],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["πάντας",710177,60],["τοὺς",709436,58],["οἴκους",709516,57],["Ιερουσαλημ",706644,17],["καὶ",707031,7],["πᾶν",710177,46,27],["οἶκον",709516,6],["ἐνέπρησεν",704617,2]],"And he burnt the house of the Lord, and the king's house, and all the houses of Jerusalem, even every house did the captain of the guard burn."],["10",[["ὁ",709436,3],["ἀρχιμάγειρος",701848,4]],"And the force of the Chaldeans pulled down the wall of Jerusalem round about."],["11",[["καὶ",707031,7],["τὸ",709436,24,5],["περισσὸν",710387,27],["τοῦ",709436,35],["λαοῦ",708094,18],["τὸ",709436,24],["καταλειφθὲν",707305,377],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["καὶ",707031,7],["τοὺς",709436,58],["ἐμπεπτωκότας",704593,277],["οἳ",709781,250],["ἐνέπεσον",704593,150],["πρὸς",710844,0],["βασιλέα",702580,6],["Βαβυλῶνος",702352,17],["καὶ",707031,7],["τὸ",709436,24],["λοιπὸν",708247,46],["τοῦ",709436,20],["στηρίγματος",712097,21],["μετῆρεν",708794,2],["Ναβουζαρδαν",709144,4],["ὁ",709436,3],["ἀρχιμάγειρος",701848,4]],"And Nabuzardan the captain of the guard removed the rest of the people that were left in the city, and the men who had deserted to the king of Babylon, and the rest of the multitude."],["12",[["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,80],["πτωχῶν",711076,81],["τῆς",709436,16],["γῆς",703083,17],["ὑπέλιπεν",713212,2],["ὁ",709436,3],["ἀρχιμάγειρος",701848,4],["εἰς",704105,0],["ἀμπελουργοὺς",700871,57],["καὶ",707031,7],["εἰς",704105,0],["γαβιν",702866,9]],"But the captain of the guard left of the poor of the land to be vine-dressers and husbandmen."],["13",[["καὶ",707031,7],["τοὺς",709436,58],["στύλους",712179,57],["τοὺς",709436,58],["χαλκοῦς",713695,57],["τοὺς",709436,58],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18],["καὶ",707031,7],["τὰς",709436,38],["μεχωνωθ",708850,39],["καὶ",707031,7],["τὴν",709436,8],["θάλασσαν",706069,9],["τὴν",709436,8],["χαλκῆν",713690,36],["τὴν",709436,8],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18],["συνέτριψαν",712520,150],["οἱ",709436,136],["Χαλδαῖοι",713678,52],["καὶ",707031,7],["ἦραν",700473,150],["τὸν",709436,5],["χαλκὸν",713695,6],["αὐτῶν",702165,565],["εἰς",704105,0],["Βαβυλῶνα",702352,9]],"And the Chaldeans broke to pieces the brazen pillars that were in the house of the Lord, and the bases, and the brazen sea that was in the house of the Lord, and carried their brass to Babylon."],["14",[["καὶ",707031,7],["τοὺς",709436,58],["λέβητας",708121,57],["καὶ",707031,7],["τὰ",709436,41],["ιαμιν",706410,42],["καὶ",707031,7],["τὰς",709436,38],["φιάλας",713453,39],["καὶ",707031,7],["τὰς",709436,38],["θυίσκας",706324,39],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["σκεύη",711844,42],["τὰ",709436,41],["χαλκᾶ",713690,68],["ἐν",704639,0],["οἷς",709781,311],["λειτουργοῦσιν",708132,349],["ἐν",704639,0],["αὐτοῖς",702165,623],["ἔλαβεν",708076,2]],"And the caldrons, and the shovels, and the bowls, and the censers, and all the brazen vessels with which they minister, he took."],["15",[["καὶ",707031,7],["τὰ",709436,41],["πυρεῖα",711093,42],["καὶ",707031,7],["τὰς",709436,38],["φιάλας",713453,39],["τὰς",709436,38],["χρυσᾶς",713971,119],["καὶ",707031,7],["τὰς",709436,38],["ἀργυρᾶς",701705,119],["ἔλαβεν",708076,2],["ὁ",709436,3],["ἀρχιμάγειρος",701848,4]],"And the captain of the guard took the fire-pans, and the gold and silver bowls."],["16",[["στύλους",712179,57],["δύο",703849,59],["ἡ",709436,10],["θάλασσα",706069,12],["ἡ",709436,10],["μία",704106,29],["καὶ",707031,7],["τὰ",709436,63],["μεχωνωθ",708850,64],["ἃ",709781,69],["ἐποίησεν",710582,2],["Σαλωμων",711430,4],["τῷ",709436,113],["οἴκῳ",709516,114],["κυρίου",707996,18],["οὐκ",709805,28],["ἦν",704093,13],["σταθμὸς",712040,4],["τοῦ",709436,35],["χαλκοῦ",713690,116],["πάντων",710177,83],["τῶν",709436,43],["σκευῶν",711844,44]],"Two pillars, and one sea, and the bases which Solomon made for the house of the Lord: there was no weight of the brass of all the vessels."],["17",[["ὀκτωκαίδεκα",709556,59],["πήχεων",710462,81],["ὕψος",713288,15],["τοῦ",709436,35],["στύλου",712179,18],["τοῦ",709436,35],["ἑνός",704106,116],["καὶ",707031,7],["τὸ",709436,34],["χωθαρ",713996,15],["ἐπ᾿",705080,0],["αὐτοῦ",702165,559],["τὸ",709436,24],["χαλκοῦν",713690,46],["καὶ",707031,7],["τὸ",709436,24],["ὕψος",713288,25],["τοῦ",709436,20],["χωθαρ",713996,21],["τριῶν",712927,169],["πήχεων",710462,81],["σαβαχα",711345,15],["καὶ",707031,7],["ῥοαὶ",711272,191],["ἐπὶ",705080,0],["τοῦ",709436,20],["χωθαρ",713996,21],["κύκλῳ",707959,114],["τὰ",709436,41],["πάντα",710177,68],["χαλκᾶ",713690,68],["καὶ",707031,7],["κατὰ",707200,0],["τὰ",709436,41],["αὐτὰ",702165,620],["τῷ",709436,113],["στύλῳ",712179,114],["τῷ",709436,113],["δευτέρῳ",703389,30],["ἐπὶ",705080,0],["τῷ",709436,53],["σαβαχα",711345,54]],"The height of one pillar [was] eighteen cubits, and the chapiter upon it was of brass: and the height of the chapiter was three cubits: the border, and the pomegranates on the chapiter round about were all of brass: and so it was with the second pillar with its border."],["18",[["καὶ",707031,7],["ἔλαβεν",708076,2],["ὁ",709436,3],["ἀρχιμάγειρος",701848,4],["τὸν",709436,5],["Σαραιαν",711518,6],["ἱερέα",706614,6],["τὸν",709436,5],["πρῶτον",711041,534],["καὶ",707031,7],["τὸν",709436,5],["Σοφονιαν",711984,6],["υἱὸν",713075,6],["τῆς",709436,16],["δευτερώσεως",703391,17],["καὶ",707031,7],["τοὺς",709436,58],["τρεῖς",712927,60],["τοὺς",709436,58],["φυλάσσοντας",713619,235],["τὸν",709436,5],["σταθμὸν",712040,6]],"And the captain of the guard took Saraias the high-priest, and Sophonias the second in order, and the three door-keepers."],["19",[["καὶ",707031,7],["ἐκ",704132,0],["τῆς",709436,16],["πόλεως",710612,17],["ἔλαβεν",708076,2],["εὐνοῦχον",705651,6],["ἕνα",704106,27],["ὃς",709781,213],["ἦν",704093,13],["ἐπιστάτης",705266,18],["ἐπὶ",705080,0],["τῶν",709436,80],["ἀνδρῶν",701150,81],["τῶν",709436,80],["πολεμιστῶν",710604,81],["καὶ",707031,7],["πέντε",710266,59],["ἄνδρας",701150,57],["τῶν",709436,80],["ὁρώντων",709725,170],["τὸ",709436,24],["πρόσωπον",710986,25],["τοῦ",709436,35],["βασιλέως",702580,18],["τοὺς",709436,58],["εὑρεθέντας",705676,460],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["καὶ",707031,7],["τὸν",709436,5],["γραμματέα",703185,6],["τοῦ",709436,35],["ἄρχοντος",701862,18],["τῆς",709436,16],["δυνάμεως",703839,17],["τὸν",709436,5],["ἐκτάσσοντα",704321,183],["τὸν",709436,5],["λαὸν",708094,6],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἑξήκοντα",704922,59],["ἄνδρας",701150,57],["τοῦ",709436,35],["λαοῦ",708094,18],["τῆς",709436,16],["γῆς",703083,17],["τοὺς",709436,58],["εὑρεθέντας",705676,460],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1]],"And they took out of the city one eunuch who was commander of the men of war, and five men that saw the face of the king, that were found in the city, and the secretary of the commander-in-chief, who took account of the people of the land, and sixty men of the people of the land that were found in the city."],["20",[["καὶ",707031,7],["ἔλαβεν",708076,2],["αὐτοὺς",702165,622],["Ναβουζαρδαν",709144,4],["ὁ",709436,3],["ἀρχιμάγειρος",701848,4],["καὶ",707031,7],["ἀπήγαγεν",701324,2],["αὐτοὺς",702165,622],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["Βαβυλῶνος",702352,17],["εἰς",704105,0],["Δεβλαθα",703308,9]],"And Nabuzardan the captain of the guard took them, and brought them to the king of Babylon to Reblatha."],["21",[["καὶ",707031,7],["ἔπαισεν",709933,2],["αὐτοὺς",702165,622],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,17],["καὶ",707031,7],["ἐθανάτωσεν",706097,2],["αὐτοὺς",702165,622],["ἐν",704639,0],["Δεβλαθα",703308,1],["ἐν",704639,0],["γῇ",703083,1],["Αιμαθ",700443,17],["καὶ",707031,7],["ἀπῳκίσθη",701464,37],["Ιουδας",706775,4],["ἐπάνωθεν",705032,28],["τῆς",709436,16],["γῆς",703083,17],["αὐτοῦ",702165,559]],"And the king of Babylon smote them and slew them at Reblatha in the land of Æmath. So Juda was carried away from his land."],["22",[["καὶ",707031,7],["ὁ",709436,3],["λαὸς",708094,4],["ὁ",709436,3],["καταλειφθεὶς",707305,217],["ἐν",704639,0],["γῇ",703083,1],["Ιουδα",706768,18],["οὓς",709781,298],["κατέλιπεν",707305,2],["Ναβουχοδονοσορ",709149,4],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,17],["καὶ",707031,7],["κατέστησεν",707011,2],["ἐπ᾿",705080,0],["αὐτῶν",702165,565],["τὸν",709436,5],["Γοδολιαν",703148,6],["υἱὸν",713075,6],["Αχικαμ",702272,18],["υἱοῦ",713075,18],["Σαφαν",711569,18]],"And [as for] the people that were left in the land of Juda, whom Nabuchodonosor king of Babylon left, even over them he set Godolias son of Achicam son of Saphan."],["23",[["καὶ",707031,7],["ἤκουσαν",700587,150],["πάντες",710177,13