τορία",705513,12],["διὰ",703417,0],["παντὸς",710177,116],["ἐδόθη",703654,37],["αὐτῷ",702165,560],["ἐξ",704132,0],["οἴκου",709516,18],["τοῦ",709436,35],["βασιλέως",702580,18],["λόγον",708236,6],["ἡμέρας",705984,17],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["αὐτοῦ",702165,559],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["τῆς",709436,16],["ζωῆς",705910,17],["αὐτοῦ",702165,559]],"And his portion, a continual portion, was given him out of the house of the king, a daily rate for every day all the days of his life."]]