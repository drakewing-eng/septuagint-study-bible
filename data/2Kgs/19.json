[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὡς",714148,7],["ἤκουσεν",700587,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["Εζεκιας",704044,4],["καὶ",707031,7],["διέρρηξεν",703565,2],["τὰ",709436,41],["ἱμάτια",706742,42],["ἑαυτοῦ",703917,102],["καὶ",707031,7],["περιεβάλετο",710294,23],["σάκκον",711386,6],["καὶ",707031,7],["εἰσῆλθεν",704114,2],["εἰς",704105,0],["οἶκον",709516,6],["κυρίου",707996,18]],"And it came to pass when king Ezekias heard it, that he rent his clothes, and put on sackcloth, and went into the house of the Lord."],["2",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Ελιακιμ",704454,6],["τὸν",709436,5],["οἰκονόμον",709514,6],["καὶ",707031,7],["Σομναν",711935,6],["τὸν",709436,5],["γραμματέα",703185,6],["καὶ",707031,7],["τοὺς",709436,58],["πρεσβυτέρους",710735,57],["τῶν",709436,80],["ἱερέων",706614,81],["περιβεβλημένους",710294,360],["σάκκους",711386,57],["πρὸς",710844,0],["Ησαιαν",706026,6],["τὸν",709436,5],["προφήτην",711009,6],["υἱὸν",713075,6],["Αμως",700898,18]],"And he sent Heliakim the steward, and Somnas the scribe, and the elders of the priests, clothed with sackcloth, to Esaias the prophet the son of Amos."],["3",[["καὶ",707031,7],["εἶπον",705373,150],["πρὸς",710844,0],["αὐτόν",702165,85],["τάδε",709446,71],["λέγει",708124,91],["Εζεκιας",704044,4],["ἡμέρα",705984,12],["θλίψεως",706276,17],["καὶ",707031,7],["ἐλεγμοῦ",704413,18],["καὶ",707031,7],["παροργισμοῦ",710169,18],["ἡ",709436,10],["ἡμέρα",705984,12],["αὕτη",709858,107],["ὅτι",709803,7],["ἦλθον",705453,150],["υἱοὶ",713075,52],["ἕως",705792,0],["ὠδίνων",714094,65],["καὶ",707031,7],["ἰσχὺς",706858,12],["οὐκ",709805,28],["ἔστιν",704093,91],["τῇ",709436,100],["τικτούσῃ",712853,220]],"And they said to him, Thus says Ezekias, This day [is] a day of tribulation, and rebuke, and provocation: for the children are come to the travail-[pangs], but the mother has no strength."],["4",[["εἴ",704071,7],["πως",711121,28],["εἰσακούσεται",704108,93],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",7