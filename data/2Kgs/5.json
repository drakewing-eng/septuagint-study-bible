39,0],["τῷ",709436,53],["σπέρματί",712008,54],["σου",711945,133],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["ἐξῆλθεν",704909,2],["ἐκ",704132,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["λελεπρωμένος",708152,419],["ὡσεὶ",714159,11],["χιών",713870,12]],"The leprosy also of Naiman shall cleave to thee, and to thy seed for ever. And he went out from his presence leprous, like snow."]]