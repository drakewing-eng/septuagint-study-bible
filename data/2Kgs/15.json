[["1",[["ἐν",704639,0],["ἔτει",705543,54],["εἰκοστῷ",704086,97],["καὶ",707031,7],["ἑβδόμῳ",703925,97],["τῷ",709436,113],["Ιεροβοαμ",706629,114],["βασιλεῖ",702580,114],["Ισραηλ",706839,18],["ἐβασίλευσεν",702581,2],["Αζαριας",700328,4],["υἱὸς",713075,4],["Αμεσσιου",700814,18],["βασιλέως",702580,18],["Ιουδα",706768,18]],"In the twenty-seventh year of Jeroboam king of Israel Azarias the son of Amessias king of Juda began to reign."],["2",[["υἱὸς",713075,4],["ἑκκαίδεκα",704203,59],["ἐτῶν",705543,44],["ἦν",704093,13],["ἐν",704639,0],["τῷ",709436,53],["βασιλεύειν",702581,55],["αὐτὸν",702165,85],["καὶ",707031,7],["πεντήκοντα",710270,59],["καὶ",707031,7],["δύο",703849,59],["ἔτη",705543,42],["ἐβασίλευσεν",702581,2],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["ὄνομα",709666,15],["τῇ",709436,100],["μητρὶ",708892,1],["αὐτοῦ",702165,102],["Χαλια",713684,12],["ἐξ",704132,0],["Ιερουσαλημ",706644,17]],"Sixteen years old was he when he began to reign, and he reigned fifty-two years in Jerusalem: and his mother's name was Jechelia of Jerusalem."],["3",[["καὶ",707031,7],["ἐποίησεν",710582,2],["τὸ",709436,24],["εὐθὲς",705596,46],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["κυρίου",707996,18],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἐποίησεν",710582,2],["Αμεσσιας",700814,4],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτοῦ",702165,102]],"And he did that which was right in the eyes of the Lord, according to all things that Amessias his father did."],["4",[["πλὴν",710540,28],["τῶν",709436,80],["ὑψηλῶν",713285,169],["οὐκ",709805,28],["ἐξῆρεν",704839,2],["ἔτι",705538,28],["ὁ",709436,3],["λαὸς",708094,4],["ἐθυσίαζεν",706346,13],["καὶ",707031,7],["ἐθυμίων",706329,137],["ἐν",704639,0],["τοῖς",709436,147],["ὑψηλοῖς",713285,230]],"Only he took not away [any] of the high places: as yet the people sacrificed and burnt incense on the high places."],["5",[["καὶ",707031,7],["ἥψατο",701654,23],["κύριος",707996,4],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["ἦν",70409