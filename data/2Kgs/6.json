[["1",[["καὶ",707031,7],["εἶπον",705373,150],["οἱ",709436,136],["υἱοὶ",713075,52],["τῶν",709436,80],["προφητῶν",711009,81],["πρὸς",710844,0],["Ελισαιε",704483,6],["ἰδοὺ",706497,88],["δὴ",703395,11],["ὁ",709436,3],["τόπος",712903,4],["ἐν",704639,0],["ᾧ",709781,309],["ἡμεῖς",705983,219],["οἰκοῦμεν",709499,243],["ἐνώπιόν",704823,0],["σου",711945,133],["στενὸς",712068,14],["ἀφ᾿",701425,0],["ἡμῶν",705999,145]],"And the sons of the prophets said to Elisaie, Behold now, the place wherein we dwell before thee is too narrow for us."],["2",[["πορευθῶμεν",710667,283],["δὴ",703395,11],["ἕως",705792,0],["τοῦ",709436,35],["Ιορδάνου",706763,18],["καὶ",707031,7],["λάβωμεν",708076,79],["ἐκεῖθεν",704182,28],["ἀνὴρ",701150,4],["εἷς",704106,14],["δοκὸν",703781,9],["μίαν",704106,36],["καὶ",707031,7],["ποιήσωμεν",710582,79],["ἑαυτοῖς",703917,151],["ἐκεῖ",704181,28],["τοῦ",709436,20],["οἰκεῖν",709499,55],["ἐκεῖ",704181,28],["καὶ",707031,7],["εἶπεν",705373,2],["δεῦτε",703383,28]],"Let us go, we pray thee, unto Jordan, and take thence every man a beam, and make for ourselves a habitation there."],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["εἷς",704106,14],["ἐπιεικέως",705131,28],["δεῦρο",703382,28],["μετὰ",708780,0],["τῶν",709436,80],["δούλων",703817,81],["σου",711945,133],["καὶ",707031,7],["εἶπεν",705373,2],["ἐγὼ",704018,164],["πορεύσομαι",710667,181]],"And he said, Go. And one of them said gently, Come with thy servants. And he said, I will go."],["4",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["μετ᾿",708780,0],["αὐτῶν",702165,40],["καὶ",707031,7],["ἦλθον",705453,150],["εἰς",704105,0],["τὸν",709436,5],["Ιορδάνην",706763,6],["καὶ",707031,7],["ἔτεμνον",712791,137],["τὰ",709436,41],["ξύλα",709427,42]],"And he went with them, and they came to Jordan, and began to cut down wood."],["5",[["καὶ",707031,7],["ἰδοὺ",706497,88],["ὁ",709436,3],["εἷς",704106,14],["καταβάλλων",707203,72],["τὴν",709436,8],["δοκόν",703781,9],["καὶ",707031,7],["τὸ",709436,24],["σιδήριον",711772,25],["ἐξέπεσεν",704284,2],["εἰς",704105,0],["τὸ",709436,24],["ὕδωρ",713071,25],["καὶ",707031,7],["ἐβόησεν",702743,2],["ὦ",714081,88],["κύριε",707996,153],["καὶ",707031,7],["αὐτὸ",702165,129],["κεχρημένον",713936,414]],"And behold, one was cutting down a beam, and the axe head fell into the water: and he cried out, Alas! master: and it was hidden."],["6",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["ἄνθρωπος",701163,4],["τοῦ",709436,35],["θεοῦ",706192,18],["ποῦ",710706,28],["ἔπεσεν",710481,2],["καὶ",707031,7],["ἔδειξεν",703314,2],["αὐτῷ",702165,50],["τὸν",709436,5],["τόπον",712903,6],["καὶ",707031,7],["ἀπέκνισεν",701487,2],["ξύλον",709427,25],["καὶ",707031,7],["ἔρριψεν",711267,2],["ἐκεῖ",704181,28],["καὶ",707031,7],["ἐπεπόλασεν",705229,2],["τὸ",709436,24],["σιδήριον",711772,25]],"And the man of God said, Where did it fall? and he shewed him the place: and he broke off a stick, and threw it in there, and the iron came to the surface."],["7",[["καὶ",707031,7],["εἶπεν",705373,2],["ὕψωσον",713289,176],["σαυτῷ",711599,50],["καὶ",707031,7],["ἐξέτεινεν",704322,2],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔλαβεν",708076,2],["αὐτό",702165,129]],"And he said, Take it up to thyself. And he stretched out his hand, and took it."],["8",[["καὶ",707031,7],["βασιλεὺς",702580,4],["Συρίας",712533,17],["ἦν",704093,13],["πολεμῶν",710601,72],["ἐν",704639,0],["Ισραηλ",706839,114],["καὶ",707031,7],["ἐβουλεύσατο",702791,23],["πρὸς",710844,0],["τοὺς",709436,58],["παῖδας",709932,57],["αὐτοῦ",702165,102],["λέγων",708124,72],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["τόνδε",709446,85],["τινὰ",712866,356],["ελμωνι",704524,6],["παρεμβαλῶ",710132,165]],"And the king of Syria was at war with Israel: and he consulted with his servants, saying, I will encamp in such a place."],["9",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Ελισαιε",704483,4],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["Ισραηλ",706839,18],["λέγων",708124,72],["φύλαξαι",713619,300],