ῖς",706614,52],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτούς",702165,62],["τί",712867,126],["ὅτι",709803,7],["οὐκ",709805,28],["ἐκραταιοῦτε",707875,399],["τὸ",709436,24],["βεδεκ",702617,25],["τοῦ",709436,35],["οἴκου",709516,18],["καὶ",707031,7],["νῦν",709384,28],["μὴ",708851,28],["λάβητε",708076,125],["ἀργύριον",701707,25],["ἀπὸ",701425,0],["τῶν",709436,130],["πράσεων",710719,65],["ὑμῶν",713091,145],["ὅτι",709803,7],["εἰς",704105,0],["τὸ",709436,24],["βεδεκ",702617,614],["τοῦ",709436,35],["οἴκου",709516,18],["δώσετε",703654,337],["αὐτό",702165,129]],"And king Joas called Jodae the priest, and the [other] priests, and said to them, Why have ye not repaired the breaches of the house? now then receive no [more] money from your sales, for ye shall give it to [repair the] breaches of the house."],["9",[["καὶ",707031,7],["συνεφώνησαν",712366,150],["οἱ",709436,136],["ἱερεῖς",706614,52],["τοῦ",709436,20],["μὴ",708851,28],["λαβεῖν",708076,106],["ἀργύριον",701707,25],["παρὰ",709995,0],["τοῦ",709436,35],["λαοῦ",708094,18],["καὶ",707031,7],["τοῦ",709436,20],["μὴ",708851,28],["ἐνισχῦσαι",704750,106],["τὸ",709436,24],["βεδεκ",702617,25],["τοῦ",709436,35],["οἴκου",709516,18]],"And the priests consented to receive no more money of the people, and not to repair the breaches of the house."],["10",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Ιωδαε",706908,4],["ὁ",709436,3],["ἱερεὺς",706614,4],["κιβωτὸν",707667,9],["μίαν",704106,36],["καὶ",707031,7],["ἔτρησεν",712814,2],["τρώγλην",713012,9],["ἐπὶ",705080,0],["τῆς",709436,16],["σανίδος",711491,17],["αὐτῆς",702165,86],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτὴν",702165,104],["παρὰ",709995,0],["ιαμιβιν",706408,118],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["ἀνδρὸς",701150,18],["οἴκου",709516,18],["κυρίου",707996,18],["καὶ",707031,7],["ἔδωκαν",703654,150],["οἱ",709436,136],["ἱερεῖς",706614,52],["οἱ",709436,136],["φυλάσσοντες",713619,146],["τὸν",709436,5],["σταθμὸν",712040,6],["πᾶν",710177,46],["τὸ",709436,24],["ἀρ