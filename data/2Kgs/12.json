[["1",[["υἱὸς",713075,4],["ἐτῶν",705543,44],["ἑπτὰ",705357,59],["Ιωας",706896,4],["ἐν",704639,0],["τῷ",709436,53],["βασιλεύειν",702581,55],["αὐτόν",702165,85]],"Joas [was] seven years old when he began to reign."],["2",[["ἐν",704639,0],["ἔτει",705543,54],["ἑβδόμῳ",703925,97],["τῷ",709436,113],["Ιου",706765,114],["ἐβασίλευσεν",702581,2],["Ιωας",706896,4],["καὶ",707031,7],["τεσσαράκοντα",712806,59],["ἔτη",705543,42],["ἐβασίλευσεν",702581,2],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["ὄνομα",709666,15],["τῆς",709436,16],["μητρὸς",708892,17],["αὐτοῦ",702165,102],["Αβια",700054,12],["ἐκ",704132,0],["τῆς",709436,16],["Βηρσαβεε",702702,17]],"Joas began to reign in the seventh year of Ju, and he reigned forty years in Jerusalem: and his mother's name [was] Sabia of Bersabee."],["3",[["καὶ",707031,7],["ἐποίησεν",710582,2],["Ιωας",706896,4],["τὸ",709436,24],["εὐθὲς",705596,46],["ἐνώπιον",704823,0],["κυρίου",707996,18],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,9],["ἃς",709781,193],["ἐφώτισεν",713646,2],["αὐτὸν",702165,85],["Ιωδαε",706908,4],["ὁ",709436,3],["ἱερεύς",706614,4]],"And Joas did that which was right in the sight of the Lord all the days that Jodae the priest instructed him."],["4",[["πλὴν",710540,28],["τῶν",709436,80],["ὑψηλῶν",713285,169],["οὐ",709805,28],["μετεστάθησαν",708668,99],["καὶ",707031,7],["ἐκεῖ",704181,28],["ἔτι",705538,28],["ὁ",709436,3],["λαὸς",708094,4],["ἐθυσίαζεν",706346,13],["καὶ",707031,7],["ἐθυμίων",706329,137],["ἐν",704639,0],["τοῖς",709436,147],["ὑψηλοῖς",713285,230]],"Only there were not [any] of the high places removed, and the people still sacrificed there, and burned incense on the high places."],["5",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιωας",706896,4],["πρὸς",710844,0],["τοὺς",709436,58],["ἱερεῖς",706614,57],["πᾶν",710177,46],["τὸ",709436,24],["ἀργύριον",701707,25],["τῶν",709436,80],["ἁγίων",700159,169],["τὸ",709436,24],["εἰσοδιαζόμενον",704117,47],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["κυρί