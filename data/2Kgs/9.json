ους",706790,57],["καὶ",707031,7],["συνεπάτησαν",712326,150],["αὐτήν",702165,104]],"And he said, Throw her [down]. And they threw her [down]; and some of her blood was sprinkled on the wall, and on the horses: and they trampled on her."],["34",[["καὶ",707031,7],["εἰσῆλθεν",704114,2],["Ιου",706765,4],["καὶ",707031,7],["ἔφαγεν",713296,2],["καὶ",707031,7],["ἔπιεν",710478,2],["καὶ",707031,7],["εἶπεν",705373,2],["ἐπισκέψασθε",705250,186],["δὴ",703395,11],["τὴν",709436,8],["κατηραμένην",707396,444],["ταύτην",709858,104],["καὶ",707031,7],["θάψατε",706103,74],["αὐτήν",702165,104],["ὅτι",709803,7],["θυγάτηρ",706320,12],["βασιλέως",702580,18],["ἐστίν",704093,91]],"And [Ju] went in and ate and drank, and said, Look now, after this cursed woman, and bury her, for she is a king's daughter."],["35",[["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["θάψαι",706103,106],["αὐτὴν",702165,104],["καὶ",707031,7],["οὐχ",709805,28],["εὗρον",705676,150],["ἐν",704639,0],["αὐτῇ",702165,105],["ἄλλο",700697,129],["τι",712866,126],["ἢ",705924,7],["τὸ",709436,24],["κρανίον",707871,25],["καὶ",707031,7],["οἱ",709436,136],["πόδες",710707,52],["καὶ",707031,7],["τὰ",709436,41],["ἴχνη",706873,42],["τῶν",709436,80],["χειρῶν",713787,65]],"And they went to bury her; but they found nothing of her but the skull, and the feet, and the palms of her hands."],["36",[["καὶ",707031,7],["ἐπέστρεψαν",705278,150],["καὶ",707031,7],["ἀνήγγειλαν",700921,150],["αὐτῷ",702165,50],["καὶ",707031,7],["εἶπεν",705373,2],["λόγος",708236,4],["κυρίου",707996,18],["ὃν",709781,112],["ἐλάλησεν",708071,2],["ἐν",704639,0],["χειρὶ",713787,1],["δούλου",703817,18],["αὐτοῦ",702165,102],["Ηλιου",705970,18],["τοῦ",709436,35],["Θεσβίτου",706221,18],["λέγων",708124,72],["ἐν",704639,0],["τῇ",709436,100],["μερίδι",708748,1],["Ιεζραελ",706547,17],["καταφάγονται",707519,135],["οἱ",709436,136],["κύνες",708004,52],["τὰς",709436,38],["σάρκας",711537,39],["Ιεζαβελ",706537,17]],"And they returned and told him. And he said, [It is] the word of the Lord, which he spoke by the hand of Eliu the Thesbite, saying, In the portion of Jezrael shall the dogs eat the flesh of Jezabel."],["37",[["καὶ",707031,7],["ἔσται",704093,93],["τὸ",709436,24],["θνησιμαῖον",706277,46],["Ιεζαβελ",706537,17],["ὡς",714148,7],["κοπρία",707827,12],["ἐπὶ",705080,0],["προσώπου",710986,21],["τοῦ",709436,35],["ἀγροῦ",700196,18],["ἐν",704639,0],["τῇ",709436,100],["μερίδι",708748,1],["Ιεζραελ",706547,17],["ὥστε",714164,7],["μὴ",708851,28],["εἰπεῖν",705373,106],["αὐτούς",702165,62],["Ιεζαβελ",706537,9]],"And the carcase of Jezabel shall be as dung on the face of the field in the portion of Jezrael, so that they shall not say, [This is] Jezabel."]]