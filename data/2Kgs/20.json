[["1",[["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["ἠρρώστησεν",701811,2],["Εζεκιας",704044,4],["εἰς",704105,0],["θάνατον",706096,6],["καὶ",707031,7],["εἰσῆλθεν",704114,2],["πρὸς",710844,0],["αὐτὸν",702165,85],["Ησαιας",706026,4],["υἱὸς",713075,4],["Αμως",700898,18],["ὁ",709436,3],["προφήτης",711009,4],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτόν",702165,85],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἔντειλαι",704791,176],["τῷ",709436,113],["οἴκῳ",709516,114],["σου",711945,133],["ὅτι",709803,7],["ἀποθνῄσκεις",701461,154],["σὺ",712181,164],["καὶ",707031,7],["οὐ",709805,28],["ζήσῃ",705851,123]],"In those days was Ezekias sick [even] to death. And the prophet Esaias the son of Amos came in to him, and said to him, Thus saith the Lord, Give charge to thy household; [for] thou shalt die, and not live."],["2",[["καὶ",707031,7],["ἀπέστρεψεν",701598,2],["Εζεκιας",704044,4],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["πρὸς",710844,0],["τὸν",709436,5],["τοῖχον",712879,6],["καὶ",707031,7],["ηὔξατο",705727,23],["πρὸς",710844,0],["κύριον",707996,6],["λέγων",708124,72]],"And Ezekias turned to the wall, and prayed to the Lord, saying,"],["3",[["ὦ",714081,88],["δή",703395,11],["κύριε",707996,153],["μνήσθητι",708960,244],["δὴ",703395,11],["ὅσα",709788,68],["περιεπάτησα",710362,155],["ἐνώπιόν",704823,0],["σου",711945,133],["ἐν",704639,0],["ἀληθείᾳ",700656,1],["καὶ",707031,7],["ἐν",704639,0],["καρδίᾳ",707141,1],["πλήρει",710541,101],["καὶ",707031,7],["τὸ",709436,24],["ἀγαθὸν",700106,46],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["σου",711945,133],["ἐποίησα",710582,155],["καὶ",707031,7],["ἔκλαυσεν",707703,2],["Εζεκιας",704044,4],["κλαυθμῷ",707705,114],["μεγάλῳ",708653,30]],"Lord, remember, I pray thee, how I have walked before thee in truth and with a perfect heart, and have done that which is good in thine eyes. And Ezekias wept with a great weeping."],["4",[["καὶ",707031,7],["ἦν",704093,13],["Ησαιας",706026,4],["ἐν",704639,0],["τῇ",709436,100],["αὐλῇ",702137,1],["τῇ",709436,100],["μέσῃ",708768,101],["καὶ",707031,7],["ῥῆμα",711246,15],["κυρίου",707996,18],["ἐγένετο",703104,23],["πρὸς",710844,0],["αὐτὸν",702165,85],["λέγων",708124,72]],"And Esaias was in the middle court, and the word of the Lord came to him, saying,"],["5",[["ἐπίστρεψον",705278,176],["καὶ",707031,7],["ἐρεῖς",705415,166],["πρὸς",710844,0],["Εζεκιαν",704044,6],["τὸν",709436,5],["ἡγούμενον",705931,212],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Δαυιδ",703232,18],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["ἤκουσα",700587,155],["τῆς",709436,16],["προσευχῆς",710892,17],["σου",711945,133],["εἶδον",709725,155],["τὰ",709436,41],["δάκρυά",703255,42],["σου",711945,133],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἰάσομαί",706424,165],["σε",711598,163],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["τρίτῃ",712968,101],["ἀναβήσῃ",700905,123],["εἰς",704105,0],["οἶκον",709516,6],["κυρίου",707996,18]],"Turn back, and thou shalt say to Ezekias the ruler of my people, Thus saith the Lord God of thy father David, I have heard thy prayer, I have seen thy tears: behold, I will heal thee: on the third day thou shalt go up to the house of the Lord."],["6",[["καὶ",707031,7],["προσθήσω",710965,165],["ἐπὶ",705080,0],["τὰς",709436,38],["ἡμέρας",705984,39],["σου",711945,133],["πέντε",710266,59],["καὶ",707031,7],["δέκα",703333,59],["ἔτη",705543,42],["καὶ",707031,7],["ἐκ",704132,0],["χειρὸς",713787,17],["βασιλέως",702580,18],["Ἀσσυρίων",702004,81],["σώσω",712627,165],["σε",711598,163],["καὶ",707031,7],["τὴν",709436,8],["πόλιν",710612,9],["ταύτην",709858,104],["καὶ",707031,7],["ὑπερασπιῶ",713121,165],["ὑπὲρ",713111,0],["τῆς",709436,16],["πόλεως",710612,17],["ταύτης",709858,86],["δι᾿",703417,0],["ἐμὲ",704555,163],["καὶ",707031,7],["διὰ",703417,0],["Δαυιδ",703232,6],["τὸν",709436,5],["δοῦλόν",703817,6],["μου",709032,133]],"And I will add to thy days fifteen years; and I will deliver thee and this city out of the hand of the king of the Assyrians, and I will defend this city for my own sake, and for my servant David's sake."],["7",[["καὶ",707031,7],["εἶπεν",705373,2],["λαβέτωσαν",708076,264],["παλάθην",709934,9],["σύκων",712255,65],["καὶ",707031,7],["ἐπιθέτωσαν",705304,264],["ἐπὶ",705080,0],["τὸ",709436,24],["ἕλκος",704507,25],["καὶ",707031,7],["ὑγιάσει",713056,127]],"And he said, Let them take a cake of figs, and lay it upon the ulcer, and he shall be well."],["8",[["καὶ",707031,7],["εἶπεν",705373,2],["Εζεκιας",704044,4],["πρὸς",710844,0],["Ησαιαν",706026,6],["τί",712867,126],["τὸ",709436,24],["σημεῖον",711748,25],["ὅτι",709803,7],["ἰάσεταί",706424,127],["με",708618,163],["κύριος",707996,4],["καὶ",707031,7],["ἀναβήσομαι",700905,181],["εἰς",704105,0],["οἶκον",709516,6],["κυρίου",707996,18],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["τρίτῃ",712968,101]],"And Ezekias said to Esaias, What [is] the sign that the Lord will heal me, and I shall go up to the house of the Lord on the third day?"],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["Ησαιας",706026,4],["τοῦτο",709858,132],["τὸ",709436,34],["σημεῖον",711748,15],["παρὰ",709995,0],["κυρίου",707996,18],["ὅτι",709803,7],["ποιήσει",710582,127],["κύριος",707996,4],["τὸν",709436,5],["λόγον",708236,6],["ὃν",709781,112],["ἐλάλησεν",708071,2],["πορεύσεται",710667,93],["ἡ",709436,10],["σκιὰ",711852,12],["δέκα",703333,59],["βαθμούς",702375,57],["ἐὰν",703912,7],["ἐπιστρέφῃ",705278,204],["δέκα",703333,59],["βαθμούς",702375,57]],"And Esaias said, This [is] the sign from the Lord, that the Lord will perform the word which he has spoken, the shadow [of the dial] shall advance ten degrees: [or] if it should go back ten degrees [this would also be the sign]."],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["Εζεκιας",704044,4],["κοῦφον",707863,26],["τὴν",709436,8],["σκιὰν",711852,9],["κλῖναι",707738,106],["δέκα",703333,59],["βαθμούς",702375,57],["οὐχί",709862,28],["ἀλλ᾿",700680,7],["ἐπιστραφήτω",705278,22],["ἡ",709436,10],["σκιὰ",711852,12],["δέκα",703333,59],["βαθμοὺς",702375,57],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,0]],"And Ezekias said, [It is] a light thing for the shadow to go down ten degrees: nay, but let the shadow return ten degrees backward on the dial."],["11",[["καὶ",707031,7],["ἐβόησεν",702743,2],["Ησαιας",706026,4],["ὁ",709436,3],["προφήτης",711009,4],["πρὸς",710844,0],["κύριον",707996,6],["καὶ",707031,7],["ἐπέστρεψεν",705278,2],["ἡ",709436,10],["σκιὰ",711852,12],["ἐν",704639,0],["τοῖς",709436,147],["ἀναβαθμοῖς",700904,148],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,0],["δέκα",703333,59],["βαθμούς",702375,57]],"And Esaias the prophet cried to the Lord: and the shadow returned back ten degrees on the dial."],["12",[["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["ἀπέστειλεν",701592,2],["Μαρωδαχβαλαδαν",708530,4],["υἱὸς",713075,4],["Βαλαδαν",702471,18],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,17],["βιβλία",702719,42],["καὶ",707031,7],["μαναα",708463,9],["πρὸς",710844,0],["Εζεκιαν",704044,6],["ὅτι",709803,7],["ἤκουσεν",700587,2],["ὅτι",709803,7],["ἠρρώστησεν",701811,2],["Εζεκιας",704044,4]],"At that time Marodach Baladan, son of Baladan king of Babylon, sent letters and a present to Ezekias, because he had heard that Ezekias was sick."],["13",[["καὶ",707031,7],["ἐχάρη",713665,37],["ἐπ᾿",705080,0],["αὐτοῖς",702165,151],["Εζεκιας",704044,4],["καὶ",707031,7],["ἔδειξεν",703314,2],["αὐτοῖς",702165,151],["ὅλον",709597,27],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,20],["νεχωθα",709285,21],["τὸ",709436,24],["ἀργύριον",701707,25],["καὶ",707031,7],["τὸ",709436,24],["χρυσίον",713972,25],["τὰ",709436,41],["ἀρώματα",701867,42],["καὶ",707031,7],["τὸ",709436,24],["ἔλαιον",704380,25],["τὸ",709436,24],["ἀγαθόν",700106,46],["καὶ",707031,7],["τὸν",709436,5],["οἶκον",709516,6],["τῶν",709436,43],["σκευῶν",711844,44],["καὶ",707031,7],["ὅ