[["1",[["καὶ",707031,7],["εἶπεν",705373,2],["Ελισαιε",704483,4],["ἄκουσον",700587,176],["λόγον",708236,6],["κυρίου",707996,18],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὡς",714148,7],["ἡ",709436,10],["ὥρα",714128,12],["αὕτη",709858,107],["αὔριον",702149,28],["μέτρον",708846,25],["σεμιδάλεως",711675,17],["σίκλου",711786,18],["καὶ",707031,7],["δίμετρον",703708,27],["κριθῶν",707900,65],["σίκλου",711786,18],["ἐν",704639,0],["ταῖς",709436,75],["πύλαις",711082,76],["Σαμαρείας",711449,17]],"And Elisaie said, Hear thou the word of the Lord; Thus saith the Lord, As at this time, to-morrow a measure of fine flour [shall be sold] for a shekel, and two measures of barley for a shekel, in the gates of Samaria."],["2",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["ὁ",709436,3],["τριστάτης",712963,4],["ἐφ᾿",705080,0],["ὃν",709781,112],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐπανεπαύετο",705018,19],["ἐπὶ",705080,0],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["τῷ",709436,113],["Ελισαιε",704483,114],["καὶ",707031,7],["εἶπεν",705373,2],["ἰδοὺ",706497,88],["ποιήσει",710582,127],["κύριος",707996,4],["καταρράκτας",707404,57],["ἐν",704639,0],["οὐρανῷ",709844,114],["μὴ",708851,28],["ἔσται",704093,93],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["καὶ",707031,7],["Ελισαιε",704483,4],["εἶπεν",705373,2],["ἰδοὺ",706497,88],["σὺ",712181,164],["ὄψῃ",709725,123],["τοῖς",709436,147],["ὀφθαλμοῖς",709870,148],["σου",711945,133],["καὶ",707031,7],["ἐκεῖθεν",704182,28],["οὐ",709805,28],["φάγῃ",713296,172]],"And the officer on whose hand the king rested, answered Elisaie, and said, Behold, [if] the Lord shall make flood-gates in heaven, might this thing be? and Elisaie said, Behold, thou shalt see with thine eyes, but shalt not eat thereof."],["3",[["καὶ",707031,7],["τέσσαρες",712808,138],["ἄνδρες",701150,52],["ἦσαν",704093,137],["λεπροὶ",708151,138],["παρὰ",709995,0],["τὴν",709436,8],["θύραν",706337,9],["τῆς",709436,16],["πόλεως",710612,17],["καὶ",707031,7],["εἶπεν",705373,2],["ἀνὴρ",701150,4],["πρὸς",710844,0],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102],["τί",712867,126],["ἡμεῖς",705983,219],["καθήμεθα",707000,378],["ὧδε",714090,28],["ἕως",705792,0],["ἀποθάνωμεν",701461,79]],"And there were four leprous men by the gate of the city: and one said to his neighbour, Why sit we here until we die?"],["4",[["ἐὰν",703912,7],["εἴπωμεν",705373,79],["εἰσέλθωμεν",704114,79,207],["εἰς",704105,0],["τὴν",709436,8],["πόλιν",710612,9],["καὶ",707031,7],["ὁ",709436,3],["λιμὸς",708210,4],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["καὶ",707031,7],["ἀποθανούμεθα",701461,141],["ἐκεῖ",704181,28],["καὶ",707031,7],["ἐὰν",703912,7],["καθίσωμεν",707006,79],["ὧδε",714090,28],["καὶ",707031,7],["ἀποθανούμεθα",701461,141],["καὶ",707031,7],["νῦν",709384,28],["δεῦτε",703383,28],["καὶ",707031,7],["ἐμπέσωμεν",704593,79],["εἰς",704105,0],["τὴν",709436,8],["παρεμβολὴν",710133,9],["Συρίας",712533,17],["ἐὰν",703912,7],["ζωογονήσωσιν",705915,234],["ἡμᾶς",705981,194],["καὶ",707031,7],["ζησόμεθα",705851,141],["καὶ",707031,7],["ἐὰν",703912,7],["θανατώσωσιν",706097,234],["ἡμᾶς",705981,194],["καὶ",707031,7],["ἀποθανούμεθα",701461,141]],"If we should say, Let us go into the city, then [there is] famine in the city, and we shall die there: and if we sit here, then we shall die. Now then come, and let us fall upon the camp of the Syrians: if they should take us alive, then we shall live; and if they should put us to death, then we shall [only] die."],["5",[["καὶ",707031,7],["ἀνέστησαν",701173,150],["ἐν",704639,0],["τῷ",709436,53],["σκότει",711889,54],["εἰσελθεῖν",704114,106],["εἰς",704105,0],["τὴν",709436,8],["παρεμβολὴν",710133,9],["Συρίας",712533,17],["καὶ",707031,7],["ἦλθον",705453,150],["εἰς",704105,0],["μέρος",708752,25],["τῆς",709436,16],["παρεμβολῆς",710133,17],["Συρίας",712533,17],["καὶ",707031,7],["ἰδοὺ",706497,88],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀνὴρ",701150,4],["ἐκεῖ",704181,28]],"And they rose up while it was yet night, to go into the camp of Syria; and they came into a part of the camp of Syria, and behold, there [was] no man there."],["6",[["καὶ",707031,7],["κύριος",707996,4],["ἀκουστὴν",700584,36],["ἐποίησεν",710582,2],["τὴν",709436,8],["παρεμβολὴν",710133,9],["Συρίας",712533,17],["φωνὴν",713640,9],["ἅρματος",701768,21],["καὶ",707031,7],["φωνὴν",713640,9],["ἵππου",706790,18],["καὶ",707031,7],["φωνὴν",713640,9],["δυνάμεως",703839,17],["μεγάλης",708653,82],["καὶ",707031,7],["εἶπεν",705373,2],["ἀνὴρ",701150,4],["πρὸς",710844,0],["τὸν",709436,5],["ἀδελφὸν",700249,6],["αὐτοῦ",702165,102],["νῦν",709384,28],["ἐμισθώσατο",708940,23],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["βασιλεὺς",702580,4],["Ισραηλ",706839,18],["τοὺς",709436,58],["βασιλέας",702580,57],["τῶν",709436,80],["Χετταίων",713838,81],["καὶ",707031,7],["τοὺς",709436,58],["βασιλέας",702580,57],["Αἰγύπτου",700401,17],["τοῦ",709436,20],["ἐλθεῖν",705453,106],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194]],"For the Lord had made the army of Syria to hear a sound of chariots, and a sound of horses, [even] the sound of a great host: and [each] man said to his fellow, Now has the king of Israel hired against us the kings of the Chettites, and the kings of Egypt, to come against us."],["7",[["καὶ",707031,7],["ἀνέστησαν",701173,150],["καὶ",707031,7],["ἀπέδρασαν",701448,150],["ἐν",704639,0],["τῷ",709436,53],["σκότει",711889,54],["καὶ",707031,7],["ἐγκατέλιπαν",703967,150],["τὰς",709436,38],["σκηνὰς",711845,39],["αὐτῶν",702165,40],["καὶ",707031,7],["τοὺς",709436,58],["ἵππους",706790,57],["αὐτῶν",702165,40],["καὶ",707031,7],["τοὺς",709436,58],["ὄνους",709671,57],["αὐτῶν",702165,40],["ἐν",704639,0],["τῇ",709436,100],["παρεμβολῇ",710133,1],["ὡς",714148,7],["ἔστιν",704093,91],["καὶ",707031,7],["ἔφυγον",713433,150],["πρὸς",710844,0],["τὴν",709436,8],["ψυχὴν",714070,9],["ἑαυτῶν",703917,40]],"And they arose and fled while it was yet dark, and left their tents, and their horses, and their asses in the camp, as they were, and fled for their lives."],["8",[["καὶ",707031,7],["εἰσῆλθον",704114,150],["οἱ",709436,136],["λεπροὶ",708151,138],["οὗτοι",709858,201],["ἕως",705792,0],["μέρους",708752,21],["τῆς",709436,16],["παρεμβολῆς",710133,17],["καὶ",707031,7],["εἰσῆλθον",704114,150],["εἰς",704105,0],["σκηνὴν",711845,9],["μίαν",704106,36],["καὶ",707031,7],["ἔφαγον",713296,150],["καὶ",707031,7],["ἔπιον",710478,150],["καὶ",707031,7],["ἦραν",700473,150],["ἐκεῖθεν",704182,28],["ἀργύριον",701707,25],["καὶ",707031,7],["χρυσίον",713972,25],["καὶ",707031,7],["ἱματισμὸν",706744,6],["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["καὶ",707031,7],["ἐπέστρεψαν",705278,150],["καὶ",707031,7],["εἰσῆλθον",704114,150],["εἰς",704105,0],["σκηνὴν",711845,9],["ἄλλην",700697,104],["καὶ",707031,7],["ἔλαβον",708076,150],["ἐκεῖθεν",704182,28],["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["καὶ",707031,7],["κατέκρυψαν",707292,150]],"And these lepers entered a little way into the camp, and went into one tent, and ate and drank, and took thence silver, and gold, and raiment; and they went and returned thence, and entered into another tent, and took thence, and went and hid [the spoil]."],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["ἀνὴρ",701150,4],["πρὸς",710844,0],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102],["οὐχ",709805,28],["οὕτως",709859,28],["ἡμεῖς",705983,219],["ποιοῦμεν",710582,243],["ἡ",709436,10],["ἡμέρα",705984,12],["αὕτη",709858,107],["ἡμέρα",705984,12],["εὐαγγελίας",705546,17],["ἐστίν",704093,91],["καὶ",707031,7],["ἡμεῖς",705983,219],["σιωπῶμεν",711818,243],["καὶ",707031,7],["μένομεν",708736,243],["ἕως",705792,0],["φωτὸς",713642,21],["τοῦ",709436,35],["πρωὶ",711021,28],["καὶ",707031,7],["εὑρήσομεν",705676,275],["ἀνομίαν",701192,9],["καὶ",707031,7],["νῦν",709384,28],["δεῦρο",703382,28],["καὶ",707031,7],["εἰσέλθωμεν",704114,79],["καὶ",707031,7],["ἀναγγείλωμεν",700921,79],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["βασιλέως",702580,18]],"And [one] man said to his neighbour, We are not doing [well] thus: this day is a day of glad tidings, and we hold our peace, and are waiting till the morning light, and shall find mischief: now then come, and let us go into [the city], and report to the house of the king."],["10",[["καὶ",707031,7],["εἰσῆλθον",704114,150],["καὶ",707031,7],["ἐβόησαν",702743,150],["πρὸς",710844,0],["τὴν",709436,8],["πύλην",711082,9],["τῆς",709436,16],["πόλεως",710612,17],["καὶ",707031,7],["ἀνήγγειλαν",700921,150],["αὐτοῖς",702165,151],["λέγοντες",708124,146],["εἰσήλθομεν",704114,289],["εἰς",704105,0],["τὴν",709436,8],["παρεμβολὴν",710133,9],["Συρίας",712533,17],["καὶ",707031,7],["ἰδοὺ",706497,88],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐκεῖ",704181,28],["ἀνὴρ",701150,4],["καὶ",707031,7],["φωνὴ",713640,12],["ἀνθρώπου",701163,18],["ὅτι",709803,7],["εἰ",704071,7],["μὴ",708851,28],["ἵππος",706790,4],["δεδεμένος",703394,419],["καὶ",707031,7],["ὄνος",709671,4],["καὶ",707031,7],["αἱ",709436,190],["σκηναὶ",711845,191],["αὐτῶν",702165,40],["ὡς",714148,7],["εἰσίν",704093,197]],"So they went and cried toward the gate of the city, and reported to them, saying, We went into the camp of Syria, and, behold, there is not there a man, nor voice of man, only horses tied and asses, and their tents as they were."],["11",[["καὶ",707031,7],["ἐβόησαν",702743,150],["οἱ",709436,136],["θυρωροὶ",706344,52],["καὶ",707031,7],["ἀνήγγειλαν",700921,150],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["βασιλέως",702580,18],["ἔσω",705521,28]],"And the porters cried aloud, and reported to the house of the king within."],["12",[["καὶ",707031,7],["ἀνέστη",701173,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["νυκτὸς",709386,17],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["τοὺς",709436,58],["παῖδας",709932,57],["αὐτοῦ",702165,102],["ἀναγγελῶ",700921,165],["δὴ",703395,11],["ὑμῖν",713084,90],["ἃ",709781,69],["ἐποίησεν",710582,2],["ἡμῖν",705994,90],["Συρία",712533,12],["ἔγνωσαν",703105,150],["ὅτι",709803,7],["πεινῶμεν",710222,243],["ἡμεῖς",705983,219],["καὶ",707031,7],["ἐξῆλθαν",704909,150],["ἐκ",704132,0],["τῆς",709436,16],["παρεμβολῆς",710133,17],["καὶ",707031,7],["ἐκρύβησαν",707923,99],["ἐν",704639,0],["τῷ",709436,113],["ἀγρῷ",700196,114],["λέγοντες",708124,146],["ὅτι",709803,7],["ἐξελεύσονται",704909,135],["ἐκ",704132,0],["τῆς",709436,16],["πόλεως",710612,17],["καὶ",707031,7],["συλλημψόμεθα",712262,141],["αὐτοὺς",702165,62],["ζῶντας",705851,235],["καὶ",707031,7],["εἰς",704105,0],["τὴν",709436,8],["πόλιν",710612,9],["εἰσελευσόμεθα",704114,141]],"And the king rose up by night, and said to his servants, I will now tell you what the Syrians have done to us. They knew that we are hungry; and they have gone forth from the camp and hidden themselves in the field, saying, They will come out of the city, and we shall catch them alive, and go into the city."],["13",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["εἷς",704106,14],["τῶν",709436,80],["παίδων",709932,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["λαβέτωσαν",708076,264],["δὴ",703395,11],["πέντε",710266,59],["τῶν",709436,80],["ἵππων",706790,81],["τῶν",709436,80],["ὑπολελειμμένων",713212,445],["οἳ",709781,250],["κατελείφθησαν",707305,99],["ὧδε",714090,28],["ἰδού",706497,88],["εἰσιν",704093,197],["πρὸς",710844,0],["πᾶν",710177,46],["τὸ",709436,24],["πλῆθος",710529,25],["Ισραηλ",706839,18],["τὸ",709436,24],["ἐκλεῖπον",704237,47],["καὶ",707031,7],["ἀποστελοῦμεν",701592,275],["ἐκεῖ",704181,28],["καὶ",707031,7],["ὀψόμεθα",709725,141]],"And one of his servants answered and said, Let them now take five of the horses that were left, which were left here; behold, they are the number left to all the multitude of Israel; and we will send thither and see."],["14",[["καὶ",707031,7],["ἔλαβον",708076,150],["δύο",703849,59],["ἐπιβάτας",705085,57],["ἵππων",706790,81],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ισραηλ",706839,18],["ὀπίσω",709697,0],["τοῦ",709436,35],["βασιλέως",702580,18],["Συρίας",712533,17],["λέγων",708124,72],["δεῦτε",703383,28],["καὶ",707031,7],["ἴδετε",709725,74]],"So they took two horsemen; and the king of Israel sent after the king of Syria, saying, Go, and see."],["15",[["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["ὀπίσω",709697,0],["αὐτῶν",702165,40],["ἕως",705792,0],["τοῦ",709436,35],["Ιορδάνου",706763,18],["καὶ",707031,7],["ἰδοὺ",706497,88],["πᾶσα",710177,29],["ἡ",709436,10],["ὁδὸς",709458,12],["πλήρης",710541,14],["ἱματίων",706742,44],["καὶ",707031,7],["σκευῶν",711844,44],["ὧν",709781,103],["ἔρριψεν",711267,2],["Συρία",712533,12],["ἐν",704639,0],["τῷ",709436,53],["θαμβεῖσθαι",706081,110],["αὐτούς",702165,62],["καὶ",707031,7],["ἐπέστρεψαν",705278,150],["οἱ",709436,136],["ἄγγελοι",700140,52],["καὶ",707031,7],["ἀνήγγειλαν",700921,150],["τῷ",709436,113],["βασιλεῖ",702580,114]],"And they went after them even to Jordan: and, behold, all the way was full of garments and vessels, which the Syrians had cast away in their panic. And the messengers returned, and brought word to the king."],["16",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["ὁ",709436,3],["λαὸς",708094,4],["καὶ",707031,7],["διήρπασεν",703562,2],["τὴν",709436,8],["παρεμβολὴν",710133,9],["Συρίας",712533,17],["καὶ",707031,7],["ἐγένετο",703104,23],["μέτρον",708846,25],["σεμιδάλεως",711675,17],["σίκλου",711786,18],["καὶ",707031,7],["δίμετρον",703708,27],["κριθῶν",707900,65],["σίκλου",711786,18],["κατὰ",707200,0],["τὸ",709436,24],["ῥῆμα",711246,25],["κυρίου",707996,18]],"And the people went out, and plundered the camp of Syria: and a measure of fine flour was sold for a shekel, according to the word of the Lord, and two measures of barley for a shekel."],["17",[["καὶ",707031,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["κατέστησεν",707011,2],["τὸν",709436,5],["τριστάτην",712963,6],["ἐφ᾿",705080,0],["ὃν",709781,112],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐπανεπαύετο",705018,19],["ἐπὶ",705080,0],["τῇ",709436,100],["χειρὶ",713787,1],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τῆς",709436,16],["πύλης",711082,17],["καὶ",707031,7],["συνεπάτησεν",712326,2],["αὐτὸν",702165,85],["ὁ",709436,3],["λαὸς",708094,4],["ἐν",704639,0],["τῇ",709436,100],["πύλῃ",711082,1],["καὶ",707031,7],["ἀπέθανεν",701461,2],["καθὰ",706979,28],["ἐλάλησεν",708071,2],["ὁ",709436,3],["ἄνθρωπος",701163,4],["τοῦ",709436,35],["θεοῦ",706192,18],["ὃς",709781,213],["ἐλάλησεν",708071,2],["ἐν",704639,0],["τῷ",709436,53],["καταβῆναι",707202,106],["τὸν",709436,5],["ἄγγελον",700140,6],["πρὸς",710844,0],["αὐτόν",702165,85]],"And the king appointed the officer on whose hand the king leaned [to have charge] over the gate: and the people trampled on him in the gate, and he died, as the man of God [had] said, who spoke when the messenger came down to him."],["18",[["καὶ",707031,7],["ἐγένετο",703104,23],["καθὰ",706979,28],["ἐλάλησεν",708071,2],["Ελισαιε",704483,4],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["λέγων",708124,72],["Δίμετρον",703707,15],["κριθῆς",707900,17],["σίκλου",711786,18],["καὶ",707031,7],["μέτρον",708846,25],["σεμιδάλεως",711675,17],["σίκλου",711786,18],["καὶ",707031,7],["ἔσται",704093,93],["ὡς",714148,7],["ἡ",709436,10],["ὥρα",714128,12],["αὕτη",709858,107],["αὔριον",702149,28],["ἐν",704639,0],["τῇ",709436,100],["πύλῃ",711082,1],["Σαμαρείας",711449,17]],"So it came to pass as Elisaie had spoken to the king, saying, Two measures of barley [shall be sold] for a shekel, and a measure of fine flour for a shekel; and it shall be as at this time to-morrow in the gate of Samaria."],["19",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["ὁ",709436,3],["τριστάτης",712963,4],["τῷ",709436,113],["Ελισαιε",704483,114],["καὶ",707031,7],["εἶπεν",705373,2],["ἰδοὺ",706497,88],["κύριος",707996,4],["ποιεῖ",710582,91],["καταρράκτας",707404,57],["ἐν",704639,0],["τῷ",709436,113],["οὐρανῷ",709844,114],["μὴ",708851,28],["ἔσται",704093,93],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["καὶ",707031,7],["εἶπεν",705373,2],["Ελισαιε",704483,4],["ἰδοὺ",706497,88],["ὄψῃ",709725,123],["τοῖς",709436,147],["ὀφθαλμοῖς",709870,148],["σου",711945,133],["καὶ",707031,7],["ἐκεῖθεν",704182,28],["οὐ",709805,28],["φάγῃ",713296,172]],"And the officer answered Elisaie, and said, Behold, [if] the Lord makes flood-gates in heaven, shall this thing be? and Elisaie said, Behold, thou shalt see [it] with thine eyes, but thou shalt not eat thereof."],["20",[["καὶ",707031,7],["ἐγένετο",703104,23],["οὕτως",709859,28],["καὶ",707031,7],["συνεπάτησεν",712326,2],["αὐτὸν",702165,85],["ὁ",709436,3],["λαὸς",708094,4],["ἐν",704639,0],["τῇ",709436,100],["πύλῃ",711082,1],["καὶ",707031,7],["ἀπέθανεν",701461,2]],"And it was so: for the people trampled on him in the gate, and he died."]]