[["1",[["ἐν",704639,0],["ἔτει",705543,54],["δωδεκάτῳ",703890,97],["τῷ",709436,113],["Αχαζ",702245,114],["βασιλεῖ",702580,114],["Ιουδα",706768,18],["ἐβασίλευσεν",702581,2],["Ωσηε",714161,4],["υἱὸς",713075,4],["Ηλα",705957,18],["ἐν",704639,0],["Σαμαρείᾳ",711449,1],["ἐπὶ",705080,0],["Ισραηλ",706839,6],["ἐννέα",704754,59],["ἔτη",705543,42]],"In the twelfth year of Achaz king of Juda began Osee the son of Ela to reign in Samaria over Israel nine years."],["2",[["καὶ",707031,7],["ἐποίησεν",710582,2],["τὸ",709436,24],["πονηρὸν",710660,46],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["κυρίου",707996,18],["πλὴν",710540,28],["οὐχ",709805,28],["ὡς",714148,7],["οἱ",709436,136],["βασιλεῖς",702580,52],["Ισραηλ",706839,18],["οἳ",709781,250],["ἦσαν",704093,137],["ἔμπροσθεν",704618,0],["αὐτοῦ",702165,102]],"And he did evil in the eyes of the Lord, only not as the kings of Israel that were before him."],["3",[["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["ἀνέβη",700905,2],["Σαλαμανασαρ",711395,4],["βασιλεὺς",702580,4],["Ἀσσυρίων",702004,81],["καὶ",707031,7],["ἐγενήθη",703104,37],["αὐτῷ",702165,50],["Ωσηε",714161,4],["δοῦλος",703817,4],["καὶ",707031,7],["ἐπέστρεψεν",705278,2],["αὐτῷ",702165,50],["μαναα",708463,25]],"Against him came up Salamanassar king of the Assyrians; and Osee became his servant, and rendered him tribute."],["4",[["καὶ",707031,7],["εὗρεν",705676,2],["βασιλεὺς",702580,4],["Ἀσσυρίων",702004,81],["ἐν",704639,0],["τῷ",709436,113],["Ωσηε",714161,114],["ἀδικίαν",700271,9],["ὅτι",709803,7],["ἀπέστειλεν",701592,2],["ἀγγέλους",700140,57],["πρὸς",710844,0],["Σηγωρ",711731,6],["βασιλέα",702580,6],["Αἰγύπτου",700401,17],["καὶ",707031,7],["οὐκ",709805,28],["ἤνεγκεν",713428,2],["μαναα",708463,25],["τῷ",709436,113],["βασιλεῖ",702580,114],["Ἀσσυρίων",702004,81],["ἐν",704639,0],["τῷ",709436,113],["ἐνιαυτῷ",704745,114],["ἐκείνῳ",704183,50],["καὶ",707031,7],["ἐπολιόρκησεν",710608,2],["αὐτὸν",702165,85],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ἀσσυρίων",702004,81],["καὶ",707031,7],["ἔδησεν",703394,2],["αὐτὸν",702165,85],["ἐν",704639,0],["οἴκῳ",709516,114],["φυλακῆς",713613,17]],"And the king of the Assyrians found iniquity in Osee, in that he sent messengers to Segor king of Egypt, and brought not a tribute to the king of the Assyrians in that year: and the king of the Assyrians besieged him, and bound him in the prison-house."],["5",[["καὶ",707031,7],["ἀνέβη",700905,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ἀσσυρίων",702004,81],["ἐν",704639,0],["πάσῃ",710177,101],["τῇ",709436,100],["γῇ",703083,1],["καὶ",707031,7],["ἀνέβη",700905,2],["εἰς",704105,0],["Σαμάρειαν",711449,9],["καὶ",707031,7],["ἐπολιόρκησεν",710608,2],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["τρία",712927,68],["ἔτη",705543,42]],"And the king of the Assyrians went up against all the land, and went up to Samaria, and besieged it [for] three years."],["6",[["ἐν",704639,0],["ἔτει",705543,54],["ἐνάτῳ",704666,97],["Ωσηε",714161,18],["συνέλαβεν",712262,2],["βασιλεὺς",702580,4],["Ἀσσυρίων",702004,81],["τὴν",709436,8],["Σαμάρειαν",711449,9],["καὶ",707031,7],["ἀπῴκισεν",701464,2],["τὸν",709436,5],["Ισραηλ",706839,6],["εἰς",704105,0],["Ἀσσυρίους",702004,57],["καὶ",707031,7],["κατῴκισεν",707534,2],["αὐτοὺς",702165,62],["ἐν",704639,0],["Αλαε",700626,1],["καὶ",707031,7],["ἐν",704639,0],["Αβωρ",700100,1],["ποταμοῖς",710693,148],["Γωζαν",703215,17],["καὶ",707031,7],["Ορη",709736,96],["Μήδων",708864,65]],"In the ninth year of Osee the king of the Assyrians took Samaria, and carried Israel away to the Assyrians, and settled them in Alae, and in Abor, [near] the rivers of Gozan, and [in] the mountains of the Medes."],["7",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὅτι",709803,7],["ἥμαρτον",700773,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["τῷ",709436,113],["κυρίῳ",707996,114],["θεῷ",706192,114],["αὐτῶν",702165,40],["τῷ",709436,113],["ἀναγαγόντι",700933,350],["αὐτοὺς",702165,62],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["ὑποκάτωθεν",713205,28],["χειρὸς",713787,17],["Φαραω",713360,18],["βασιλέως",702580,18],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ἐφοβήθησαν",713532,99],["θεοὺς",706192,57],["ἑτέρους",705535,60]],"For it came to pass that the children of Israel [had] transgressed against the Lord their God, who had brought them up out of the land of Egypt, from under the hand of Pharao king of Egypt, and they feared other gods,"],["8",[["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["τοῖς",709436,95],["δικαιώμασιν",703697,96],["τῶν",709436,43],["ἐθνῶν",704068,44],["ὧν",709781,252],["ἐξῆρεν",704839,2],["κύριος",707996,4],["ἀπὸ",701425,0],["προσώπου",710986,21],["υἱῶν",713075,81],["Ισραηλ",706839,18],["καὶ",707031,7],["οἱ",709436,136],["βασιλεῖς",702580,52],["Ισραηλ",706839,18],["ὅσοι",709788,138],["ἐποίησαν",710582,150]],"and walked in the statutes of the nations which the Lord cast out before the face of the children of Israel, and of the kings of Israel as many as did [such things],"],["9",[["καὶ",707031,7],["ὅσοι",709788,138],["ἠμφιέσαντο",700886,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["λόγους",708236,57],["οὐχ",709805,28],["οὕτως",709859,28],["κατὰ",707200,0],["κυρίου",707996,18],["θεοῦ",706192,18],["αὐτῶν",702165,40],["καὶ",707031,7],["ᾠκοδόμησαν",709509,150],["ἑαυτοῖς",703917,151],["ὑψηλὰ",713285,68],["ἐν",704639,0],["πάσαις",710177,291],["ταῖς",709436,75],["πόλεσιν",710612,76],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["πύργου",711092,18],["φυλασσόντων",713619,170],["ἕως",705792,0],["πόλεως",710612,17],["ὀχυρᾶς",709889,82]],"and [in those] of the children of Israel as many as secretly practised customs, not as [they should have done], against the Lord their God:"],["10",[["καὶ",707031,7],["ἐστήλωσαν",712094,150],["ἑαυτοῖς",703917,151],["στήλας",712092,39],["καὶ",707031,7],["ἄλση",700729,42],["ἐπὶ",705080,0],["παντὶ",710177,30],["βουνῷ",702797,114],["ὑψηλῷ",713285,30],["καὶ",707031,7],["ὑποκάτω",713204,28],["παντὸς",710177,92],["ξύλου",709427,21],["ἀλσώδους",700730,92]],"and they built for themselves high places in all their cities, from the tower of the watchmen to the fortified city. And they made for themselves pillars and groves on every high hill, and under every shady tree."],["11",[["καὶ",707031,7],["ἐθυμίασαν",706329,150],["ἐκεῖ",704181,28],["ἐν",704639,0],["πᾶσιν",710177,230],["ὑψηλοῖς",713285,230],["καθὼς",707030,28],["τὰ",709436,41],["ἔθνη",704068,42],["ἃ",709781,69],["ἀπῴκισεν",701464,2],["κύριος",707996,4],["ἐκ",704132,0],["προσώπου",710986,21],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐποίησαν",710582,150],["κοινωνοὺς",707777,57],["καὶ",707031,7],["ἐχάραξαν",713730,150],["τοῦ",709436,20],["παροργίσαι",710167,106],["τὸν",709436,5],["κύριον",707996,6]],"And burned incense there on all high places, as the nations [did] whom the Lord removed from before them, and dealt with familiar spirits, and they carved [images] to provoke the Lord to anger."],["12",[["καὶ",707031,7],["ἐλάτρευσαν",708108,150],["τοῖς",709436,95],["εἰδώλοις",704079,96],["οἷς",709781,311],["εἶπεν",705373,2],["κύριος",707996,4],["αὐτοῖς",702165,151],["οὐ",709805,28],["ποιήσετε",710582,337],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["κυρίῳ",707996,114]],"And they served the idols, of which the Lord said to them, Ye shall not do this thing [against] the Lord."],["13",[["καὶ",707031,7],["διεμαρτύρατο",703513,23],["κύριος",707996,4],["ἐν",704639,0],["τῷ",709436,113],["Ισραηλ",706839,114],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["Ιουδα",706768,114],["ἐν",704639,0],["χειρὶ",713787,1],["πάντων",710177,169],["τῶν",709436,80],["προφητῶν",711009,81],["αὐτοῦ",702165,102],["παντὸς",710177,116],["ὁρῶντος",709725,152],["λέγων",708124,72],["ἀποστράφητε",701598,74],["ἀπὸ",701425,0],["τῶν",709436,130],["ὁδῶν",709458,65],["ὑμῶν",713091,145],["τῶν",709436,80],["πονηρῶν",710660,169],["καὶ",707031,7],["φυλάξατε",713619,74],["τὰς",709436,38],["ἐντολάς",704802,39],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,41],["δικαιώματά",703697,42],["μου",709032,133],["καὶ",707031,7],["πάντα",710177,27],["τὸν",709436,5],["νόμον",709349,6],["ὃν",709781,112],["ἐνετειλάμην",704791,161],["τοῖς",709436,147],["πατράσιν",710189,148],["ὑμῶν",713091,145],["ὅσα",709788,68],["ἀπέστειλα",701592,155],["αὐτοῖς",702165,151],["ἐν",704639,0],["χειρὶ",713787,1],["τῶν",709436,80],["δούλων",703817,81],["μου",709032,133],["τῶν",709436,80],["προφητῶν",711009,81]],"And the Lord testified against Israel and against Juda, even by the hand of all his prophets, [and] of every seer, saying, Turn ye from your evil ways, and keep my commandments and my ordinances, and all the law which I commanded your fathers, [and] all that I sent to them by the hand of my servants the prophets."],["14",[["καὶ",707031,7],["οὐκ",709805,28],["ἤκουσαν",700587,150],["καὶ",707031,7],["ἐσκλήρυναν",711864,150],["τὸν",709436,5,24],["νῶτον",709403,25],["αὐτῶν",702165,40],["ὑπὲρ",713111,0],["τὸν",709436,5,24],["νῶτον",709403,25],["τῶν",709436,80],["πατέρων",710189,81],["αὐτῶν",702165,40]],"But they hearkened not, and made their neck harder than the neck of their fathers."],["15",[["καὶ",707031,7],["τὰ",709436,41],["μαρτύρια",708525,42],["αὐτοῦ",702165,102],["ὅσα",709788,68],["διεμαρτύρατο",703513,23],["αὐτοῖς",702165,151],["οὐκ",709805,28],["ἐφύλαξαν",713619,150],["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["ὀπίσω",709697,0],["τῶν",709436,80],["ματαίων",708575,169],["καὶ",707031,7],["ἐματαιώθησαν",708578,99],["καὶ",707031,7],["ὀπίσω",709697,0],["τῶν",709436,43],["ἐθνῶν",704068,44],["τῶν",709436,43],["περικύκλῳ",710340,28],["αὐτῶν",702165,40],["ὧν",709781,252],["ἐνετείλατο",704791,23],["αὐτοῖς",702165,151],["τοῦ",709436,20],["μὴ",708851,28],["ποιῆσαι",710582,106],["κατὰ",707200,0],["ταῦτα",709858,71]],"And they kept not any of his testimonies which he charged them; and they walked after vanities, and became vain, and after the nations round about them, concerning which the Lord had charged them not to do accordingly."],["16",[["ἐγκατέλιπον",703967,150],["τὰς",709436,38],["ἐντολὰς",704802,39],["κυρίου",707996,18],["θεοῦ",706192,18],[