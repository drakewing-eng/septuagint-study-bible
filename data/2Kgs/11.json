[["1",[["καὶ",707031,7],["Γοθολια",703154,12],["ἡ",709436,10],["μήτηρ",708892,12],["Οχοζιου",709888,18],["εἶδεν",709725,2],["ὅτι",709803,7],["ἀπέθανον",701461,150],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτῆς",702165,86],["καὶ",707031,7],["ἀπώλεσεν",701513,2],["πᾶν",710177,46],["τὸ",709436,24],["σπέρμα",712008,25],["τῆς",709436,16],["βασιλείας",702577,17]],"And Gotholia the mother of Ochozias saw that her son was dead, and she destroyed all the seed royal."],["2",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Ιωσαβεε",706938,12],["θυγάτηρ",706320,12],["τοῦ",709436,35],["βασιλέως",702580,18],["Ιωραμ",706933,18],["ἀδελφὴ",700244,12],["Οχοζιου",709888,18],["τὸν",709436,5],["Ιωας",706896,6],["υἱὸν",713075,6],["ἀδελφοῦ",700249,18],["αὐτῆς",702165,86],["καὶ",707031,7],["ἔκλεψεν",707715,2],["αὐτὸν",702165,85],["ἐκ",704132,0],["μέσου",708768,116],["τῶν",709436,80],["υἱῶν",713075,81],["τοῦ",709436,35],["βασιλέως",702580,18],["τῶν",709436,80],["θανατουμένων",706097,299],["αὐτὸν",702165,85],["καὶ",707031,7],["τὴν",709436,8],["τροφὸν",712985,9],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,53],["ταμιείῳ",712700,54],["τῶν",709436,130],["κλινῶν",707737,65],["καὶ",707031,7],["ἔκρυψεν",707923,2],["αὐτὸν",702165,85],["ἀπὸ",701425,0],["προσώπου",710986,21],["Γοθολιας",703154,17],["καὶ",707031,7],["οὐκ",709805,28],["ἐθανατώθη",706097,37]],"And Josabee daughter of king Joram, sister of Ochozias, took Joas the son of her brother, and stole him from among the king's sons that were put to death, [secreting] him and his nurse in the bedchamber, and hid him from the face of Gotholia, and he was not slain."],["3",[["καὶ",707031,7],["ἦν",704093,13],["μετ᾿",708780,0],["αὐτῆς",702165,86],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18],["κρυβόμενος",707923,217],["ἓξ",704828,59],["ἔτη",705543,42],["καὶ",707031,7],["Γοθολια",703154,12],["βασιλεύουσα",702581,188],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"And he remained with her hid in the house of the Lord six years: and Gotholia reigned over the land."],["4",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἔτει",705543,54],["τῷ",709436,53],["ἑβδόμῳ",703925,97],["ἀπέστειλεν",701592,2],["Ιωδαε",706908,4],["ὁ",709436,3],["ἱερεὺς",706614,4],["καὶ",707031,7],["ἔλαβεν",708076,2],["τοὺς",709436,58],["ἑκατοντάρχους",704140,57],["τὸν",709436,5],["Χορρι",713918,6],["καὶ",707031,7],["τὸν",709436,5],["Ρασιμ",711189,6],["καὶ",707031,7],["ἀπήγαγεν",701324,2],["αὐτοὺς",702165,62],["πρὸς",710844,0],["αὐτὸν",702165,85],["εἰς",704105,0],["οἶκον",709516,6],["κυρίου",707996,18],["καὶ",707031,7],["διέθετο",703609,23],["αὐτοῖς",702165,151],["διαθήκην",703456,9],["κυρίου",707996,18],["καὶ",707031,7],["ὥρκισεν",709751,2],["αὐτοὺς",702165,62],["ἐνώπιον",704823,0],["κυρίου",707996,18],["καὶ",707031,7],["ἔδειξεν",703314,2],["αὐτοῖς",702165,151],["Ιωδαε",706908,4],["τὸν",709436,5],["υἱὸν",713075,6],["τοῦ",709436,35],["βασιλέως",702580,18]],"And in the seventh year Jodae sent and took the captains of hundreds of the Chorri and of the Rhasim, and brought them to him into the house of the Lord, and made a covenant of the Lord with them, and adjured them, and Jodae shewed them the king's son."],["5",[["καὶ",707031,7],["ἐνετείλατο",704791,23],["αὐτοῖς",702165,151],["λέγων",708124,72],["οὗτος",709858,121],["ὁ",709436,3],["λόγος",708236,4],["ὃν",709781,112],["ποιήσετε",710582,337],["τὸ",709436,24],["τρίτον",712968,46],["ἐξ",704132,0],["ὑμῶν",713091,145],["εἰσελθέτω",704114,45],["τὸ",709436,24],["σάββατον",711350,25],["καὶ",707031,7],["φυλάξετε",713619,337],["φυλακὴν",713613,9],["οἴκου",709516,18],["τοῦ",709436,35],["βασιλέως",702580,18],["ἐν",704639,0],["τῷ",709436,113],["πυλῶνι",711083,114]],"And charged them, saying, This [is] the thing which ye shall do.",{"s":"d","q":0.64}],["6",[["καὶ",707031,7],["τὸ",709436,24],["τρίτον",712968,46],["ἐν",704639,0],["τῇ",709436,100],["πύλῃ",711082,1],["τῶν",709436,130],["ὁδῶν",709458,65],["καὶ",707031,7],["τὸ",709436,24],["τρίτον",712968,27],["τῆς",709436,16],["πύλης",711082,17],[