[["1",[["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["αὐτοῦ",702165,102],["ἀνέβη",700905,2],["Ναβουχοδονοσορ",709149,4],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,17],["καὶ",707031,7],["ἐγενήθη",703104,37],["αὐτῷ",702165,50],["Ιωακιμ",706887,4],["δοῦλος",703817,4],["τρία",712927,27],["ἔτη",705543,42],["καὶ",707031,7],["ἐπέστρεψεν",705278,2],["καὶ",707031,7],["ἠθέτησεν",700369,2],["ἐν",704639,0],["αὐτῷ",702165,50]],"In his days went up Nabuchodonosor king of Babylon, and Joakim became his servant three years; and [then] he turned and revolted from him."],["2",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["αὐτῷ",702165,50],["τοὺς",709436,58],["μονοζώνους",708997,60],["τῶν",709436,80],["Χαλδαίων",713678,81],["καὶ",707031,7],["τοὺς",709436,58],["μονοζώνους",708997,60],["Συρίας",712533,17],["καὶ",707031,7],["τοὺς",709436,58],["μονοζώνους",708997,60],["Μωαβ",709085,18],["καὶ",707031,7],["τοὺς",709436,58],["μονοζώνους",708997,60],["υἱῶν",713075,81],["Αμμων",700847,18],["καὶ",707031,7],["ἐξαπέστειλεν",704872,2],["αὐτοὺς",702165,62],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["Ιουδα",706768,18],["τοῦ",709436,20],["κατισχῦσαι",707531,106],["κατὰ",707200,0],["τὸν",709436,5],["λόγον",708236,6],["κυρίου",707996,18],["ὃν",709781,112],["ἐλάλησεν",708071,2],["ἐν",704639,0],["χειρὶ",713787,1],["τῶν",709436,80],["δούλων",703817,81],["αὐτοῦ",702165,102],["τῶν",709436,80],["προφητῶν",711009,81]],"And the Lord sent against him the bands of the Chaldeans, and the bands of Syria, and the bands of Moab, and the bands of the children of Ammon, and sent them into the land of Juda to prevail [against it], according to the word of the Lord, which he spoke by his servants the prophets."],["3",[["πλὴν",710540,28],["ἐπὶ",705080,0],["τὸν",709436,5],["θυμὸν",706334,6],["κυρίου",707996,18],["ἦν",704093,13],["ἐν",704639,0],["τῷ",709436,113],["Ιουδα",706768,114],["ἀποστῆσαι",702214,106],["αὐτὸν",702165,85],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["ἐν",704639,0],["ἁμ