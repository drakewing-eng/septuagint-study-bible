ῦ",709436,35],["χειμάρρου",713783,18],["Αἰγύπτου",700401,17],["ἕως",705792,0],["τοῦ",709436,35],["ποταμοῦ",710693,18],["Εὐφράτου",705716,18],["πάντα",710177,195],["ὅσα",709788,619],["ἦν",704093,13],["τοῦ",709436,35],["βασιλέως",702580,18],["Αἰγύπτου",700401,17]],"And the king of Egypt came no more out of his land: for the king of Babylon took away all that belonged to the king of Egypt from the river of Egypt as far as the river Euphrates."],["8",[["υἱὸς",713075,4],["ὀκτωκαίδεκα",709556,59],["ἐτῶν",705543,44],["Ιωακιμ",706887,4],["ἐν",704639,0],["τῷ",709436,53],["βασιλεύειν",702581,55],["αὐτὸν",702165,556],["καὶ",707031,7],["τρίμηνον",712948,27],["ἐβασίλευσεν",702581,2],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["ὄνομα",709666,15],["τῇ",709436,100],["μητρὶ",708892,1],["αὐτοῦ",702165,559],["Νεσθα",709263,12],["θυγάτηρ",706320,12],["Ελλαναθαν",704510,18],["ἐξ",704132,0],["Ιερουσαλημ",706644,17]],"Eighteen years old [was] Joachim when he began to reign, and he reigned three months in Jerusalem: and his mother's name [was] Nestha, daughter of Ellanastham, of Jerusalem."],["9",[["καὶ",707031,7],["ἐποίησεν",710582,2],["τὸ",709436,24],["πονηρὸν",710660,46],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["κυρίου",707996,18],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,620],["ἐποίησεν",710582,2],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτοῦ",702165,559]],"And he did that which was evil in the sight of the Lord, according to all that his father did."],["10",[["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["ἀνέβη",700905,2],["Ναβουχοδονοσορ",709149,4],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,17],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["ἦλθεν",705453,2],["ἡ",709436,10],["πόλις",710612,12],["ἐν",704639,0],["περιοχῇ",710359,204]],"At that time went up Nabuchodonosor king of Babylon to Jerusalem, and the city was besieged."],["11",[["καὶ",707031,7],["εἰσῆλθεν",704114,2],["Ναβουχοδονοσορ",709149,4],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,17],["εἰς",704105,0],["τὴν",709436,8],["πόλιν",710612,9],["καὶ",707031,7],["οἱ",709436,136],["παῖδες",709932,52],["αὐτοῦ",702165,559],["ἐπολιόρκουν",710608,137],["ἐπ᾿",705080,0],["αὐτήν",702165,551]],"And Nabuchodonosor king of Babylon came against the city, and his servants besieged it."],["12",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["Ιωακιμ",706887,4],["βασιλεὺς",702580,4],["Ιουδα",706768,18],["ἐπὶ",705080,0],["βασιλέα",702580,6],["Βαβυλῶνος",702352,17],["αὐτὸς",702165,561],["καὶ",707031,7],["οἱ",709436,136],["παῖδες",709932,52],["αὐτοῦ",702165,559],["καὶ",707031,7],["ἡ",709436,10],["μήτηρ",708892,12],["αὐτοῦ",702165,559],["καὶ",707031,7],["οἱ",709436,136],["ἄρχοντες",701862,52],["αὐτοῦ",702165,559],["καὶ",707031,7],["οἱ",709436,136],["εὐνοῦχοι",705651,52],["αὐτοῦ",702165,559],["καὶ",707031,7],["ἔλαβεν",708076,2],["αὐτὸν",702165,556],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,17],["ἐν",704639,0],["ἔτει",705543,54],["ὀγδόῳ",709444,97],["τῆς",709436,16],["βασιλείας",702577,17],["αὐτοῦ",702165,559]],"And Joachim king of Juda came forth to the king of Babylon, he and his servants, and his mother, and his princes, and his eunuchs; and the king of Babylon took him in the eighth year of his reign."],["13",[["καὶ",707031,7],["ἐξήνεγκεν",704356,2],["ἐκεῖθεν",704182,28],["πάντας",710177,60],["τοὺς",709436,58],["θησαυροὺς",706258,57],["οἴκου",709516,18],["κυρίου",707996,18],["καὶ",707031,7],["τοὺς",709436,58],["θησαυροὺς",706258,57],["οἴκου",709516,18],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["συνέκοψεν",712230,2],["πάντα",710177,68],["τὰ",709436,41],["σκεύη",711844,42],["τὰ",709436,41],["χρυσᾶ",713971,68],["ἃ",709781,69],["ἐποίησεν",710582,2],["Σαλωμων",711430,4],["βασιλεὺς",702580,4],["Ισραηλ",706839,18],["ἐν",704639,0],["τῷ",709436,113],["ναῷ",709191,114],["κυρίου",707996,18],["κατὰ",707200,0],["τὸ",709436,24],["ῥῆμα",711246,25],["κυρίου",707996,18]],"And he brought forth thence all the treasures of the house of the Lord, and the treasures of the king's house, and he cut up all the golden vessels which Solomon the king of Israel [had] made in the temple of the Lord, according to the word of the Lord."],["14",[["καὶ",707031,7],["ἀπῴκισεν",701464,2],["τὴν",709436,8],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["πάντας",710177,60],["τοὺς",709436,58],["ἄρχοντας",701862,57],["καὶ",707031,7],["τοὺς",709436,58],["δυνατοὺς",703845,60],["ἰσχύι",706858,1],["αἰχμαλωσίας",700499,17],["δέκα",703333,59],["χιλιάδας",713858,39],["αἰχμαλωτίσας",700501,621],["καὶ",707031,7],["πᾶν",710177,27],["τέκτονα",712766,6],["καὶ",707031,7],["τὸν",709436,5],["συγκλείοντα",712223,183],["καὶ",707031,7],["οὐχ",709805,28],["ὑπελείφθη",713212,37],["πλὴν",710540,28],["οἱ",709436,136],["πτωχοὶ",711076,52],["τῆς",709436,16],["γῆς",703083,17]],"And he carried away [the inhabitants of] Jerusalem, and all the captains, and the mighty men, taking captive ten thousand prisoners, and every artificer and smith: and only the poor of the land were left."],["15",[["καὶ",707031,7],["ἀπῴκισεν",701464,2],["τὸν",709436,5],["Ιωακιμ",706887,6],["εἰς",704105,0],["Βαβυλῶνα",702352,9],["καὶ",707031,7],["τὴν",709436,8],["μητέρα",708892,9],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["τὰς",709436,38],["γυναῖκας",703209,39],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["τοὺς",709436,58],["εὐνούχους",705651,57],["αὐτοῦ",702165,559],["καὶ",707031,7],["τοὺς",709436,58],["ἰσχυροὺς",706855,60],["τῆς",709436,16],["γῆς",703083,17],["ἀπήγαγεν",701324,2],["ἀποικεσίαν",701462,9],["ἐξ",704132,0],["Ιερουσαλημ",706644,17],["εἰς",704105,0],["Βαβυλῶνα",702352,9]],"And he carried Joachim away to Babylon, and the king's mother, and the king's wives, and his eunuchs: and he carried away the mighty men of the land into captivity from Jerusalem to Babylon."],["16",[["καὶ",707031,7],["πάντας",710177,60],["τοὺς",709436,58],["ἄνδρας",701150,57],["τῆς",709436,16],["δυνάμεως",703839,17],["ἑπτακισχιλίους",705363,60],["καὶ",707031,7],["τὸν",709436,5],["τέκτονα",712766,6],["καὶ",707031,7],["τὸν",709436,5],["συγκλείοντα",712223,183],["χιλίους",713859,60],["πάντες",710177,138],["δυνατοὶ",703845,138],["ποιοῦντες",710582,146],["πόλεμον",710605,6],["καὶ",707031,7],["ἤγαγεν",700209,2],["αὐτοὺς",702165,622],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,17],["μετοικεσίαν",708832,9],["εἰς",704105,0],["Βαβυλῶνα",702352,9]],"And all the men of might, even seven thousand, and one thousand artificers and smiths: all [were] mighty [men] fit for war; and the king of Babylon carried them captive to Babylon."],["17",[["καὶ",707031,7],["ἐβασίλευσεν",702581,2],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,17],["τὸν",709436,5],["Μαθθανιαν",708379,6],["υἱὸν",713075,6],["αὐτοῦ",702165,559],["ἀντ᾿",701227,0],["αὐτοῦ",702165,559],["καὶ",707031,7],["ἐπέθηκεν",705304,2],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,559],["Σεδεκια",711617,4]],"And the king of Babylon made Batthanias his son king in his stead, and called his name Sedekias."],["18",[["υἱὸς",713075,4],["εἴκοσι",704085,59],["καὶ",707031,7],["ἑνὸς",704106,116],["ἐνιαυτοῦ",704745,18],["Σεδεκιας",711618,4],["ἐν",704639,0],["τῷ",709436,53],["βασιλεύειν",702581,55],["αὐτὸν",702165,556],["καὶ",707031,7],["ἕνδεκα",704675,59],["ἔτη",705543,42],["ἐβασίλευσεν",702581,2],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["ὄνομα",709666,15],["τῇ",709436,100],["μητρὶ",708892,1],["αὐτοῦ",702165,559],["Αμιταλ",700829,12],["θυγάτηρ",706320,12],["Ιερεμιου",706611,18]],"Twenty and one years old [was] Sedekias when he began to reign, and he reigned eleven years in Jerusalem: and his mother's name [was] Amital, daughter of Jeremias."],["19",[["καὶ",707031,7],["ἐποίησεν",710582,2],["τὸ",709436,24],["πονηρὸν",710660,46],["ἐνώπιον",704823,0],["κυρίου",707996,18],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἐποίησεν",710582,2],["Ιωακιμ",706887,4]],"And he did that which was evil in the sight of the Lord, according to all that Joachim did."],["20",[["ὅτι",709803,7],["ἐπὶ",705080,0],["τὸν",709436,5],["θυμὸν",706334,6],["κυρίου",707996,18],["ἦν",704093,13],["ἐπὶ",705080,0],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["Ιουδα",706768,114],["ἕως",705792,0],["ἀπέρριψεν",701563,2],["αὐτοὺς",702165,622],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,559],["καὶ",707031,7],["ἠθέτησεν",700369,2],["Σεδεκιας",711618,4],["ἐν",704639,0],["τῷ",709436,113],["βασιλεῖ",702580,114],["Βαβυλῶνος",702352,17]],"For it was according to the Lord's anger against Jerusalem and on Juda, until he cast them out of his presence, that Sedekias revolted against the king of Babylon."]]