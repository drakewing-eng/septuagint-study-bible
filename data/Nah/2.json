[["1",[["ἰδοὺ",706497,88],["ἐπὶ",705080,0],["τὰ",709436,41],["ὄρη",709768,42],["οἱ",709436,136],["πόδες",710707,52],["εὐαγγελιζομένου",705547,262],["καὶ",707031,28],["ἀπαγγέλλοντος",701321,152],["εἰρήνην",704098,9],["ἑόρταζε",704988,240],["Ιουδα",706768,153],["τὰς",709436,38],["ἑορτάς",704990,39],["σου",711945,133],["ἀπόδος",701449,176],["τὰς",709436,38],["εὐχάς",705726,39],["σου",711945,133],["διότι",703734,7],["οὐ",709805,28],["μὴ",708851,28],["προσθήσωσιν",710965,234],["ἔτι",705538,28],["τοῦ",709436,20],["διελθεῖν",703673,106],["διὰ",703417,0],["σοῦ",711945,133],["εἰς",704105,0],["παλαίωσιν",709937,234],["συντετέλεσται",712510,187],["ἐξῆρται",704839,187]],"Behold upon the mountains the feet of him that brings glad tidings, and publishes peace! O Juda, keep thy feasts, pay thy vows: for they shall no more pass through thee to [thy] decay."],["2",[["ἀνέβη",700905,2],["ἐμφυσῶν",704636,72],["εἰς",704105,0],["πρόσωπόν",710986,25],["σου",711945,133],["ἐξαιρούμενος",704838,122],["ἐκ",704132,0],["θλίψεως",706276,17],["σκόπευσον",711873,176],["ὁδόν",709458,9],["κράτησον",707879,176],["ὀσφύος",709800,17],["ἄνδρισαι",701104,300],["τῇ",709436,100],["ἰσχύι",706858,1],["σφόδρα",712586,28]],"It is all over with him, he has been removed, [one] who has been delivered from affliction has come up panting into thy presence, watch the way, strengthen [thy] loins, be very valiant in [thy] strength."],["3",[["διότι",703734,7],["ἀπέστρεψεν",701598,2],["κύριος",707996,4],["τὴν",709436,8],["ὕβριν",713051,9],["Ιακωβ",706401,18],["καθὼς",707030,28],["ὕβριν",713051,9],["τοῦ",709436,35],["Ισραηλ",706839,18],["διότι",703734,7],["ἐκτινάσσοντες",704334,146],["ἐξετίναξαν",704334,150],["αὐτοὺς",702165,62],["καὶ",707031,7],["τὰ",709436,41],["κλήματα",707720,42],["αὐτῶν",702165,40],["διέφθειραν",703624,150]],"For the Lord has turned aside the pride of Jacob, as the pride of Israel: for they have utterly rejected them, and have destroyed their branches."],["4",[["ὅπλα",709704,42],["δυναστείας",703841,17],["αὐτῶν",702165,40],["ἐξ",704132,0],["ἀνθρώπων",701163,81],["ἄνδρας",701150,57],["δυνατοὺς",703845,60],["ἐμπαίζοντας",704583,235],["ἐν",704639,0],["πυρί",711088,54],["αἱ",709436,190],["ἡνίαι",706007,191],["τῶν",709436,43],["ἁρμάτων",701768,44],["αὐτῶν",702165,40],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["ἑτοιμασίας",705540,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["οἱ",709436,136],["ἱππεῖς",706786,52],["θορυβηθήσονται",706292,144]],"[They have destroyed] the arms of their power from among men, their mighty men sporting with fire: the reins of their chariots [shall be destroyed] in the day of his preparation, and the horsemen shall be thrown into confusion"],["5",[["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["καὶ",707031,7],["συγχυθήσονται",712243,144],["τὰ",709436,41],["ἅρματα",701768,42],["καὶ",707031,7],["συμπλακήσονται",712334,144],["ἐν",704639,0],["ταῖς",709436,75],["πλατείαις",710509,291],["ἡ",709436,10],["ὅρασις",709721,12],["αὐτῶν",702165,40],["ὡς",714148,7],["λαμπάδες",708079,191],["πυρὸς",711088,21],["καὶ",707031,7],["ὡς",714148,7],["ἀστραπαὶ",702021,191],["διατρέχουσαι",703614,306]],"in the ways, and the chariots shall clash together, and shall be entangled in each other in the broad ways: their appearance is as lamps of fire, and as gleaming lightnings."],["6",[["καὶ",707031,7],["μνησθήσονται",708923,144],["οἱ",709436,136],["μεγιστᾶνες",708657,52],["αὐτῶν",702165,40],["καὶ",707031,7],["φεύξονται",713433,135],["ἡμέρας",705984,39],["καὶ",707031,7],["ἀσθενήσουσιν",701938,218],["ἐν",704639,0],["τῇ",709436,100],["πορείᾳ",710665,1],["αὐτῶν",702165,40],["καὶ",707031,7],["σπεύσουσιν",712011,218],["ἐπὶ",705080,0],["τὰ",709436,41],["τείχη",712759,42],["καὶ",707031,7],["ἑτοιμάσουσιν",705539,218],["τὰς",709436,38],["προφυλακὰς",711012,39],["αὐτῶν",702165,40]],"And their mighty men shall bethink themselves and flee by day; and they shall be weak as they go; and they shall hasten to her walls, and shall prepare their defences."],["7",[["πύλαι",711082,191],[