[["1",[["λῆμμα",708175,15],["Νινευη",709312,1],["βιβλίον",702719,15],["ὁράσεως",709721,17],["Ναουμ",709192,18],["τοῦ",709436,35],["Ελκεσαίου",704505,18]],"The burden of Nineve: the book of the vision of Naum the Elkesite."],["2",[["θεὸς",706192,4],["ζηλωτὴς",705875,4],["καὶ",707031,7],["ἐκδικῶν",704174,72],["κύριος",707996,4],["ἐκδικῶν",704174,72],["κύριος",707996,4],["μετὰ",708780,0],["θυμοῦ",706334,18],["ἐκδικῶν",704174,72],["κύριος",707996,4],["τοὺς",709436,58],["ὑπεναντίους",713109,60],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐξαίρων",704839,72],["αὐτὸς",702165,121],["τοὺς",709436,58],["ἐχθροὺς",705779,57],["αὐτοῦ",702165,102]],"God is jealous, and the Lord avenges; the Lord avenges with wrath; the Lord takes vengeance on his adversaries, and he cuts off his enemies."],["3",[["κύριος",707996,4],["μακρόθυμος",708420,14],["καὶ",707031,7],["μεγάλη",708653,29],["ἡ",709436,10],["ἰσχὺς",706858,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀθῳῶν",700391,72],["οὐκ",709805,28],["ἀθῳώσει",700391,127],["κύριος",707996,4],["ἐν",704639,0],["συντελείᾳ",712509,1],["καὶ",707031,7],["ἐν",704639,0],["συσσεισμῷ",712553,114],["ἡ",709436,10],["ὁδὸς",709458,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["νεφέλαι",709277,191],["κονιορτὸς",707815,4],["ποδῶν",710707,81],["αὐτοῦ",702165,102]],"The Lord is long-suffering, and his power is great, and the Lord will not hold any guiltless: his way is in destruction and in the whirlwind, and the clouds are the dust of his feet."],["4",[["ἀπειλῶν",701374,72],["θαλάσσῃ",706069,1],["καὶ",707031,7],["ξηραίνων",709419,72],["αὐτὴν",702165,104],["καὶ",707031,7],["πάντας",710177,60],["τοὺς",709436,58],["ποταμοὺς",710693,57],["ἐξερημῶν",704907,72],["ὠλιγώθη",709576,37],["ἡ",709436,10],["Βασανῖτις",702569,4],["καὶ",707031,7],["ὁ",709436,3],["Κάρμηλος",707161,4],["καὶ",707031,7],["τὰ",709436,63],["ἐξανθοῦντα",704864,242],["τοῦ",709436,35],["Λιβάνου",708185,18],["ἐξέλιπεν",704237,2]],"He threatens the sea, and dries it up, and exhausts all the rivers: the land of Basan, and Carmel are brought low, and the flourishing [trees] of Libanus have come to nought."],["5",[["τὰ",709436,63],["ὄρη",709768,64],["ἐσείσθησαν",711633,99],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["οἱ",709436,136],["βουνοὶ",702797,52],["ἐσαλεύθησαν",711403,99],["καὶ",707031,7],["ἀνεστάλη",701056,37],["ἡ",709436,10],["γῆ",703083,12],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["ἡ",709436,10],["σύμπασα",712324,29],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["κατοικοῦντες",707534,146],["ἐν",704639,0],["αὐτῇ",702165,105]],"The mountains quake at him, and the hills are shaken, and the earth recoils at his presence, [even] the world, and all that dwell in it."],["6",[["ἀπὸ",701425,0],["προσώπου",710986,21],["ὀργῆς",709728,17],["αὐτοῦ",702165,102],["τίς",712867,158],["ὑποστήσεται",713281,93],["καὶ",707031,7],["τίς",712867,158],["ἀντιστήσεται",701154,93],["ἐν",704639,0],["ὀργῇ",709728,1],["θυμοῦ",706334,18],["αὐτοῦ",702165,102],["ὁ",709436,3],["θυμὸς",706334,4],["αὐτοῦ",702165,102],["τήκει",712839,91],["ἀρχάς",701836,39],["καὶ",707031,7],["αἱ",709436,190],["πέτραι",710443,191],["διεθρύβησαν",703457,99],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102]],"Who shall stand before his anger? and who shall withstand in the anger of his wrath? his wrath brings to nought kingdoms, and the rocks are burst asunder by him."],["7",[["χρηστὸς",713958,14],["κύριος",707996,4],["τοῖς",709436,147],["ὑπομένουσιν",713219,349],["αὐτὸν",702165,85],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["θλίψεως",706276,17],["καὶ",707031,7],["γινώσκων",703105,72],["τοὺς",709436,58],["εὐλαβουμένους",705627,236],["αὐτόν",702165,85]],"The Lord is good to them that wait on him in the day of affliction; and he knows them that reverence him."],["8",[["καὶ",707031,7],["ἐν",704639,0],["κατακλυσμῷ",707279,114],["πορείας",710665,17],["συντέλειαν",712509,9],["ποιήσεται",710582,93],["τοὺς",709436,58],["ἐπεγειρομένους",705053,236],["καὶ",707031,7],["τοὺς",709436,58],["ἐχθροὺς",705779,57],["αὐτοῦ",702165,102],["διώξεται",703768,93],["σκότος",711889,15]],"But with an overrunning flood he will make an utter end: darkness shall pursue those that rise up against [him] and his enemies."],["9",[["τί",712867,126],["λογίζεσθε",708232,374],["ἐπὶ",705080,0],["τὸν",709436,5],["κύριον",707996,6],["συντέλειαν",712509,9],["αὐτὸς",702165,121],["ποιήσεται",710582,93],["οὐκ",709805,28],["ἐκδικήσει",704174,127],["δὶς",703741,28],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτὸ",702165,129],["ἐν",704639,0],["θλίψει",706276,1]],"What do ye devise against the Lord? he will make a complete end: he will not take vengeance by affliction twice at the same time."],["10",[["ὅτι",709803,7],["ἕως",705792,0],["θεμελίου",706181,21],["αὐτῶν",702165,40],["χερσωθήσεται",713835,134],["καὶ",707031,28],["ὡς",714148,7],["σμῖλαξ",711912,12],["περιπλεκομένη",710365,211],["βρωθήσεται",702722,134],["καὶ",707031,28],["ὡς",714148,7],["καλάμη",707079,12],["ξηρασίας",709420,17],["μεστή",708777,29]],"For [the enemy] shall be laid bare even to the foundation, and shall be devoured as twisted yew, and as stubble fully dry."],["11",[["ἐκ",704132,0],["σοῦ",711945,133],["ἐξελεύσεται",704909,93],["λογισμὸς",708234,4],["κατὰ",707200,0],["τοῦ",709436,35],["κυρίου",707996,18],["πονηρὰ",710660,68],["λογιζόμενος",708232,122],["ἐναντία",704656,68]],"Out of thee shall proceed a device against the Lord, counselling evil things hostile [to him]."],["12",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["κατάρχων",707411,72],["ὑδάτων",713071,44],["πολλῶν",710646,83],["καὶ",707031,28],["οὕτως",709859,28],["διασταλήσονται",703588,144],["καὶ",707031,7],["ἡ",709436,10],["ἀκοή",700561,12],["σου",711945,133],["οὐκ",709805,28],["ἐνακουσθήσεται",704649,134],["ἔτι",705538,28]],"Thus saith the Lord who rules over many waters, Even thus shall they be sent away, and the report of thee shall not be heard any more."],["13",[["καὶ",707031,7],["νῦν",709384,28],["συντρίψω",712520,165],["τὴν",709436,8],["ῥάβδον",711135,9],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["σοῦ",711945,133],["καὶ",707031,7],["τοὺς",709436,58],["δεσμούς",703372,57],["σου",711945,133],["διαρρήξω",703565,165]],"And now will I break his rod from off thee, and will burst [thy] bonds."],["14",[["καὶ",707031,7],["ἐντελεῖται",704791,117],["ὑπὲρ",713111,0],["σοῦ",711945,133],["κύριος",707996,4],["οὐ",709805,28],["σπαρήσεται",712006,134],["ἐκ",704132,0],["τοῦ",709436,20],["ὀνόματός",709666,21],["σου",711945,133],["ἔτι",705538,28],["ἐξ",704132,0],["οἴκου",709516,18],["θεοῦ",706192,18],["σου",711945,133],["ἐξολεθρεύσω",704956,165],["τὰ",709436,41],["γλυπτὰ",703117,68],["καὶ",707031,7],["χωνευτά",714009,68],["θήσομαι",712849,181],["ταφήν",712736,9],["σου",711945,133],["ὅτι",709803,7],["ταχεῖς",712750,68]],"And the Lord shall give a command concerning thee; there shall no more of thy name be scattered: I will utterly destroy the graven [images] out of the house of thy god, and the molten [images]: I will make thy grave; for [they are] swift."]]