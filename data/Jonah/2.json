[["1",[["καὶ",707031,7],["προσέταξεν",710962,2],["κύριος",707996,4],["κήτει",707664,54],["μεγάλῳ",708653,97],["καταπιεῖν",707374,106],["τὸν",709436,5],["Ιωναν",706931,6],["καὶ",707031,7],["ἦν",704093,13],["Ιωνας",706931,4],["ἐν",704639,0],["τῇ",709436,100],["κοιλίᾳ",707761,1],["τοῦ",709436,20],["κήτους",707664,21],["τρεῖς",712927,119],["ἡμέρας",705984,39],["καὶ",707031,7],["τρεῖς",712927,119],["νύκτας",709386,39]],"Now the Lord had commanded a great whale to swallow up Jonas: and Jonas was in the belly of the whale three days and three nights."],["2",[["καὶ",707031,7],["προσηύξατο",710893,23],["Ιωνας",706931,4],["πρὸς",710844,0],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["αὐτοῦ",702165,102],["ἐκ",704132,0],["τῆς",709436,16],["κοιλίας",707761,17],["τοῦ",709436,20],["κήτους",707664,21]],"And Jonas prayed to the Lord his God out of the belly of the whale,"],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["ἐβόησα",702743,155],["ἐν",704639,0],["θλίψει",706276,1],["μου",709032,133],["πρὸς",710844,0],["κύριον",707996,6],["τὸν",709436,5],["θεόν",706192,6],["μου",709032,133],["καὶ",707031,7],["εἰσήκουσέν",704108,2],["μου",709032,133],["ἐκ",704132,0],["κοιλίας",707761,17],["ᾅδου",700255,18],["κραυγῆς",707886,17],["μου",709032,133],["ἤκουσας",700587,162],["φωνῆς",713640,17],["μου",709032,133]],"and said, I cried in my affliction to the Lord my God, and he hearkened to me, [even] to my cry out of the belly of hell: thou heardest my voice."],["4",[["ἀπέρριψάς",701563,162],["με",708618,163],["εἰς",704105,0],["βάθη",702376,42],["καρδίας",707141,17],["θαλάσσης",706069,17],["καὶ",707031,7],["ποταμοί",710693,52],["με",708618,163],["ἐκύκλωσαν",707958,150],["πάντες",710177,138],["οἱ",709436,136],["μετεωρισμοί",708830,52],["σου",711945,133],["καὶ",707031,7],["τὰ",709436,63],["κύματά",707968,64],["σου",711945,133],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["διῆλθον",703673,150]],"Thou didst cast me into the depths of the heart of the sea, and the floods compassed me: all thy billows and thy waves have passed upon me."],["5",[["καὶ",707031,7],["ἐγὼ",704018,164],["εἶπα",705373,155],["ἀπῶσμαι",701659,584],["ἐξ",704132,0],["ὀφθαλμῶν",709870,81],["σου",711945,133],["ἆρα",701667,11],["προσθήσω",710965,165],["τοῦ",709436,20],["ἐπιβλέψαι",705088,106],["πρὸς",710844,0],["τὸν",709436,5],["ναὸν",709191,6],["τὸν",709436,5],["ἅγιόν",700159,27],["σου",711945,133]],"And I said, I am cast out of thy presence: shall I indeed look again toward thy holy temple?"],["6",[["περιεχύθη",710420,37],["ὕδωρ",713071,15],["μοι",708974,159],["ἕως",705792,0],["ψυχῆς",714070,17],["ἄβυσσος",700098,12],["ἐκύκλωσέν",707958,2],["με",708618,163],["ἐσχάτη",705519,29],["ἔδυ",703848,2],["ἡ",709436,10],["κεφαλή",707639,12],["μου",709032,133],["εἰς",704105,0],["σχισμὰς",712607,39],["ὀρέων",709768,44]],"Water was poured around me to the soul: the lowest deep compassed me, my head went down"],["7",[["κατέβην",707202,155],["εἰς",704105,0],["γῆν",703083,9],["ἧς",709781,167],["οἱ",709436,136],["μοχλοὶ",709040,52],["αὐτῆς",702165,86],["κάτοχοι",707555,138],["αἰώνιοι",700505,138],["καὶ",707031,7],["ἀναβήτω",700905,45],["φθορὰ",713451,12],["ζωῆς",705910,17],["μου",709032,133],["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133]],"to the clefts of the mountains; I went down into the earth, whose bars are the everlasting barriers: yet, O Lord my God, let my ruined life be restored."],["8",[["ἐν",704639,0],["τῷ",709436,53],["ἐκλείπειν",704237,55],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["τοῦ",709436,35],["κυρίου",707996,18],["ἐμνήσθην",708960,156],["καὶ",707031,7],["ἔλθοι",705453,225],["πρὸς",710844,0],["σὲ",711598,163],["ἡ",709436,10],["προσευχή",710892,12],["μου",709032,133],["εἰς",704105,0],["ναὸν",709191,6],["ἅγιόν",700159,27],["σου",711945,133]],"When my soul was failing me, I remembered the Lord; and may my prayer come to thee into thy holy temple."],["9",[["φυλασσόμενοι",713619,348],["μάταια",708575,68],["καὶ",707031,7],["ψευδῆ",714036,68],["ἔλεος",704426,25],["αὐτῶν",702165,40],["ἐγκατέλιπον",703967,150]],"They that observe vanities and lies have forsaken their own mercy."],["10",[["ἐγὼ",704018,164],["δὲ",703303,11],["μετὰ",708780,0],["φωνῆς",713640,17],["αἰνέσεως",700457,17],["καὶ",707031,7],["ἐξομολογήσεως",704961,17],["θύσω",706349,165],["σοι",711925,159],["ὅσα",709788,68],["ηὐξάμην",705727,161],["ἀποδώσω",701449,165],["σοι",711925,159],["σωτηρίου",712659,21],["τῷ",709436,113],["κυρίῳ",707996,114]],"But I will sacrifice to thee with the voice of praise and thanksgiving: all that I have vowed I will pay to thee, the Lord of [my] salvation."],["11",[["καὶ",707031,7],["προσετάγη",710962,37],["τῷ",709436,53],["κήτει",707664,54],["καὶ",707031,7],["ἐξέβαλεν",704145,2],["τὸν",709436,5],["Ιωναν",706931,6],["ἐπὶ",705080,0],["τὴν",709436,8],["ξηράν",709421,36]],"And the whale was commanded by the Lord, and it cast up Jonas on the dry [land]."]]