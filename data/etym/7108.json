{"710844":{"t":"From Proto-Indo-European *próti, *préti. Cognates include Sanskrit प्रति (práti), Latin pretium, and Old Church Slavonic противъ (protivŭ).","d":[]},"710892":{"t":"From προσεύχομαι (proseúkhomai, “pray”) + -η (-ē, suffix forming action nouns). By surface analysis, προσ- (pros-, “toward”) + εὐχή (eukhḗ, “prayer, wish”).","d":[]},"710868":{"t":"From προσβάλλω (prosbállō, “to apply”) + -η (-ē).","d":[]},"710877":{"t":"From προσδοκάω (prosdokáō, “I expect”).","d":[]},"710813":{"t":"From προκόπτω (prokóptō, “to advance”) + -η (-ē).","d":["Προκόπιος"]},"710831":{"t":"From προ- (pro-) + οἶμος (oîmos, “way, road, path”) + -ιον (-ĭon).","d":[]},"710890":{"t":"From προσ- (pros-, “to, toward”) + ἔρχομαι (érkhomai, “to come, go”).","d":["προσήλυτος"]},"710893":{"t":"From προσ- (pros-) + εὔχομαι (eúkhomai, “to pray, vow”).","d":[]},"710895":{"t":"From πρός (prós, “to, towards, with”) + ἔχω (ékhō, “to have, hold”).","d":["παραπροσέχω"]},"710817":{"t":"From προ- (pro-, “before”) + λαμβάνω (lambánō, “to take”)","d":["προλαβόντως","προλαμβανόντως","πρόλημμα"]},"710876":{"t":"From πρός (prós, “to, towards, with”) + δοκεύω (dokeúō, “to watch”).","d":["προσδοκία","προσδόκιμος"]},"710881":{"t":"προσ- (pros-) + εἶπον (eîpon)","d":[]},"710871":{"t":"προσ- (pros-) + γράφω (grắphō)","d":[]},"710825":{"t":"From προνοέω (pronoéō, “to perceive before, foresee”) + -ια (-ĭă).","d":[]},"710820":{"t":"πρό (pró, “before”) + λοβός (lobós, “lobe”)","d":[]},"710823":{"t":"προ- (“before”) + μηνύω (“inform; disclose”)","d":[]},"710800":{"t":"πρόθυμος (próthūmos, “eager”) + -ως (-ōs, adverbial suffix)","d":[]},"710891":{"t":"Univerbation of πρός (prós, “in addition”) and ἔτι (éti, “yet”).","d":[]},"710865":{"t":"προσ- (pros-, “towards, against”) + βάλλω (bắllō, “to throw”).","d":["προσβολή"]},"710812":{"t":"From προ- (pro-) + κεῖμαι (keîmai).","d":[]},"710801":{"t":"προ- (pro-) + θύρη (thúrē)","d":[]},"710832":{"t":"προ- (pro-) + ὁράω (horáō)","d":[]},"710830":{"t":"προ- (pro-) + οἶδα (oîda)","d":[]},"710833":{"t":"From προ- (pro-, before) + πάππος (páppos, “grandfather”).","d":[]},"710835":{"t":"προ- (pro-) + πέμπω (pémpō)","d":[]},"710809":{"t":"From προ- (pro-, “against”) + καταλαμβάνω (katalambánō, “to seize”).","d":[]},"710808":{"t":"From προ- (pro-, “to, towards, with”) + καλέω (kaléō, “to call”).","d":["πρόκλησις"]},"710818":{"t":"From προ- (pro-, “before”) + λέγω (légō, “to say”).","d":["προλεγόμεναι","προλεγομένη"]},"710824":{"t":"From πρόνοος (prónoos) + -έω (-éō).","d":[]},"710897":{"t":"From προσ- (pros-) + ἥκω (hḗkō).","d":["ἐπιπροσήκω","προσήκων"]},"710874":{"t":"From προσ- (pros-) + δέχομαι (dékhomai)","d":[]},"710847":{"t":"From προσ- (pros-, “towards”) + ἀγορεύω (agoreúō, “to speak”)","d":[]},"710848":{"t":"From προσ- (pros-, “toward”) + ἄγω (ágō, “to go, lead”).","d":["προσαγωγή"]},"710864":{"t":"From προσ- (pros-) + βαίνω (baínō)","d":[]},"710822":{"t":"From προμάχομαι (promákhomai, “to fight in front”), from προ- (pro-) + μάχομαι (mákhomai, “to fight, do battle”); closely related to πρόμαχος (prómakhos).","d":[]},"710803":{"t":"From προ- (pro-) + ἵστημι (hístēmi).","d":["προστάτης"]}}