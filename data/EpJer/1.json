[["0",[["ἀντίγραφον",701229,15],["ἐπιστολῆς",705272,17],["ἧς",709781,167],["ἀπέστειλεν",701592,2],["Ιερεμιας",706611,4],["πρὸς",710844,0],["τοὺς",709436,58],["ἀχθησομένους",700209,786],["αἰχμαλώτους",700503,60],["εἰς",704105,0],["Βαβυλῶνα",702352,9],["ὑπὸ",713184,0],["τοῦ",709436,35],["βασιλέως",702580,18],["τῶν",709436,80],["Βαβυλωνίων",702355,81],["ἀναγγεῖλαι",700921,106],["αὐτοῖς",702165,151],["καθότι",707021,7],["ἐπετάγη",705294,37],["αὐτῷ",702165,50],["ὑπὸ",713184,0],["τοῦ",709436,35],["θεοῦ",706192,18]],"A copy of an epistle, which Jeremy sent unto them which were to be led captives into Babylon by the king of the Babylonians, to certify them, as it was commanded him of God.",{"s":"m","br":"1:1","q":1.0}],["1",[["διὰ",703417,0],["τὰς",709436,38],["ἁμαρτίας",700775,39],["ἃς",709781,193],["ἡμαρτήκατε",700773,330],["ἐναντίον",704654,0],["τοῦ",709436,35],["θεοῦ",706192,18],["ἀχθήσεσθε",700209,261],["εἰς",704105,0],["Βαβυλῶνα",702352,9],["αἰχμάλωτοι",700503,138],["ὑπὸ",713184,0],["Ναβουχοδονοσορ",709149,18],["βασιλέως",702580,18],["τῶν",709436,80],["Βαβυλωνίων",702355,81]],"Because of the sins which ye have committed before God, ye shall be led away captives into Babylon by Nabuchodonosor king of the Babylonians.",{"s":"m","br":"1:2","q":1.0}],["2",[["εἰσελθόντες",704114,196],["οὖν",709835,11],["εἰς",704105,0],["Βαβυλῶνα",702352,9],["ἔσεσθε",704093,124],["ἐκεῖ",704181,28],["ἔτη",705543,42],["πλείονα",710514,68],["καὶ",707031,7],["χρόνον",713969,6],["μακρὸν",708421,27],["ἕως",705792,0],["γενεῶν",703037,65],["ἑπτά",705357,59],["μετὰ",708780,0],["τοῦτο",709858,129],["δὲ",703303,11],["ἐξάξω",704834,165],["ὑμᾶς",713080,194],["ἐκεῖθεν",704182,28],["μετ᾿",708780,0],["εἰρήνης",704098,17]],"So when ye be come unto Babylon, ye shall remain there many years, and for a long season, namely, seven generations: and after that I will bring you away peaceably from thence.",{"s":"m","br":"1:3","q":1.0}],["3",[["νυνὶ",709385,28],["δὲ",703303,11],["ὄψεσθε",709725,124],["ἐν",704639,0],