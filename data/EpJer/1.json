οὐ",709805,28],["δύνανται",703838,269],["λαλεῖν",708071,55]],"As for their tongue, it is polished by the workman, and they themselves are gilded and laid over with gold; yet are they but false, and cannot speak.",{"s":"m","br":"1:8","q":0.89}],["8",[["καὶ",707031,7],["ὥσπερ",714163,28],["παρθένῳ",710148,1],["φιλοκόσμῳ",713480,101],["λαμβάνοντες",708076,146],["χρυσίον",713972,25],["κατασκευάζουσιν",707419,197],["στεφάνους",712083,57],["ἐπὶ",705080,0],["τὰς",709436,38],["κεφαλὰς",707639,39],["τῶν",709436,80],["θεῶν",706192,81],["αὐτῶν",702165,40]],"And taking gold, as it were for a virgin that loveth to go gay, they make crowns for the heads of their gods.",{"s":"m","br":"1:9","q":1.0}],["9",[["ἔστι",704093,91],["δὲ",703303,11],["καὶ",707031,28],["ὅτε",709802,28],["ὑφαιρούμενοι",713276,348],["οἱ",709436,136],["ἱερεῖς",706614,52],["ἀπὸ",701425,0],["τῶν",709436,80],["θεῶν",706192,81],["αὐτῶν",702165,40],["χρυσίον",713972,25],["καὶ",707031,7],["ἀργύριον",701707,25],["εἰς",704105,0],["ἑαυτοὺς",703917,62],["καταναλώσουσιν",707338,218],["δώσουσιν",703654,218],["δὲ",703303,11],["ἀπ᾿",701425,0],["αὐτῶν",702165,70],["καὶ",707031,28],["ταῖς",709436,75],["ἐπὶ",705080,0],["τοῦ",709436,20],["τέγους",712752,21],["πόρναις",710675,76]],"Sometimes also the priests convey from their gods gold and silver, and bestow it upon themselves.",{"s":"m","br":"1:10","q":0.63,"gd":0.65}],["10",[["κοσμοῦσί",707847,197],["τε",712751,11],["αὐτοὺς",702165,62],["ὡς",714148,7],["ἀνθρώπους",701163,57],["τοῖς",709436,95],["ἐνδύμασιν",704698,96],["θεοὺς",706192,57],["ἀργυροῦς",701705,60],["καὶ",707031,7],["χρυσοῦς",713971,60],["καὶ",707031,7],["ξυλίνους",709425,60],["οὗτοι",709858,201],["δὲ",703303,11],["οὐ",709805,28],["διασῴζονται",703599,269],["ἀπὸ",701425,0],["ἰοῦ",706764,18],["καὶ",707031,7],["βρωμάτων",702823,44]],"Yea, they will give thereof to the common harlots, and deck them as men with garments, [being] gods of silver, and gods of gold, and wood.",{"s":"m","br":"1:11","q":0.62,"gd":0.65}],["11",[["περιβεβλημένων",710294,445],["αὐτῶν",702165,40],["ἱματισμὸν",706744,6],["πορφυροῦν",710686,27],["ἐκμάσσονται",704257,269],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτῶν",702165,40],["διὰ",703417,0],["τὸν",709436,5],["ἐκ",704132,0],["τῆς",709436,16],["οἰκίας",709505,17],["κονιορτόν",707815,6],["ὅς",709781,213],["ἐστιν",704093,91],["πλείων",710646,14],["ἐπ᾿",705080,0],["αὐτοῖς",702165,151]],"They wipe their faces because of the dust of the temple, when there is much upon them.",{"s":"m","br":"1:13","q":0.74}],["12",[["καὶ",707031,7],["σκῆπτρον",711851,25],["ἔχει",705785,91],["ὡς",714148,7],["ἄνθρωπος",701163,4],["κριτὴς",707910,4],["χώρας",714011,17],["ὃς",709781,213],["τὸν",709436,5],["εἰς",704105,0],["αὐτὸν",702165,85],["ἁμαρτάνοντα",700773,183],["οὐκ",709805,28],["ἀνελεῖ",700962,127]],"And he that cannot put to death one that offendeth him holdeth a sceptre, as though he were a judge of the country.",{"s":"m","br":"1:14","q":1.0}],["13",[["ἔχει",705785,91],["δὲ",703303,11],["ἐγχειρίδιον",704013,25],["ἐν",704639,0],["δεξιᾷ",703360,101],["καὶ",707031,7],["πέλεκυν",710237,6],["ἑαυτὸν",703917,85],["δὲ",703303,11],["ἐκ",704132,0],["πολέμου",710605,18],["καὶ",707031,7],["λῃστῶν",708181,81],["οὐκ",709805,28],["ἐξελεῖται",704838,93]],"He hath also in his right hand a dagger and an axe: but cannot deliver himself from war and thieves.",{"s":"m","br":"1:15","q":0.93}],["14",[["ὅθεν",709486,28],["γνώριμοί",703136,138],["εἰσιν",704093,197],["οὐκ",709805,28],["ὄντες",704093,146],["θεοί",706192,52],["μὴ",708851,28],["οὖν",709835,11],["φοβηθῆτε",713532,394],["αὐτούς",702165,62]],"Whereby they are known not to be gods: therefore fear them not.",{"s":"m","br":"1:16","q":1.0}],["15",[["ὥσπερ",714163,28],["γὰρ",702963,11],["σκεῦος",711844,15],["ἀνθρώπου",701163,18],["συντριβὲν",712520,418],["ἀχρεῖον",702309,26],["γίνεται",703104,117],["τοιοῦτοι",712878,138],["ὑπάρχουσιν",713104,197],["οἱ",709436,136],["θεοὶ",706192,52],["αὐτῶν",702165,40],["καθιδρυμένων",707004,445],["αὐτῶν",702165,40],["ἐν",704639,0],["τοῖς",709436,147],["οἴκοις",709516,148]],"For like as a vessel that a man useth is nothing worth when it is broken; even so it is with their gods: when they be set up in the temple, their eyes be full of dust through the feet of them that come in.",{"s":"m","br":"1:17","q":0.61,"gd":0.61}],["16",[["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["αὐτῶν",702165,40],["πλήρεις",710541,138],["εἰσὶν",704093,197],["κονιορτοῦ",707815,18],["ἀπὸ",701425,0],["τῶν",709436,80],["ποδῶν",710707,81],["τῶν",709436,80],["εἰσπορευομένων",704124,299]],null,{"s":"h"}],["17",[["καὶ",707031,7],["ὥσπερ",714163,28],["τινὶ",712866,435],["ἠδικηκότι",700269,514],["βασιλέα",702580,6],["περιπεφραγμέναι",710412,423],["εἰσὶν",704093,197],["αἱ",709436,190],["αὐλαὶ",702137,191],["ὡς",714148,7],["ἐπὶ",705080,0],["θανάτῳ",706096,114],["ἀπηγμένῳ",701324,516],["τοὺς",709436,58],["οἴκους",709516,57],["αὐτῶν",702165,40],["ὀχυροῦσιν",709890,197],["οἱ",709436,136],["ἱερεῖς",706614,52],["θυρώμασίν",706343,96],["τε",712751,11],["καὶ",707031,7],["κλείθροις",707708,96],["καὶ",707031,7],["μοχλοῖς",709040,148],["ὅπως",709719,7],["ὑπὸ",713184,0],["τῶν",709436,80],["λῃστῶν",708181,81],["μὴ",708851,28],["συληθῶσι",712260,272]],"And as the doors are made sure on every side upon him that offendeth the king, as being committed to suffer death; even so the priests make fast their temples with doors, with locks, and bars, lest [their gods] be spoiled with robbers.",{"s":"m","br":"1:18","q":1.0}],["18",[["λύχνους",708287,57],["καίουσιν",707049,197],["καὶ",707031,28],["πλείους",710514,60],["ἢ",705924,7],["ἑαυτοῖς",703917,151],["ὧν",709781,252],["οὐδένα",709817,27],["δύνανται",703838,269],["ἰδεῖν",709725,106]],"They light them candles, yea, more than for themselves, whereof they cannot see one.",{"s":"m","br":"1:19","q":1.0}],["19",[["ἔστιν",704093,91],["μὲν",708730,11],["ὥσπερ",714163,28],["δοκὸς",703781,12],["τῶν",709436,130],["ἐκ",704132,0],["τῆς",709436,16],["οἰκίας",709505,17],["τὰς",709436,38],["δὲ",703303,11],["καρδίας",707141,39],["αὐτῶν",702165,40],["φασιν",713437,197],["ἐκλείχεσθαι",704238,395],["τῶν",709436,43],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["ἑρπετῶν",705441,44],["κατεσθόντων",707519,84],["αὐτούς",702165,62],["τε",712751,11],["καὶ",707031,7],["τὸν",709436,5],["ἱματισμὸν",706744,6],["αὐτῶν",702165,40],["οὐκ",709805,28],["αἰσθάνονται",700476,269]],"They are as one of the beams of the temple, yet they say their hearts are gnawed upon by things creeping out of the earth; and when they eat them and their clothes, they feel it not.",{"s":"m","br":"1:20","q":0.96}],["20",[["μεμελανωμένοι",708694,429],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["τοῦ",709436,35],["καπνοῦ",707132,18],["τοῦ",709436,35],["ἐκ",704132,0],["τῆς",709436,16],["οἰκίας",709505,17]],"Their faces are blacked through the smoke that cometh out of the temple.",{"s":"m","br":"1:21","q":1.0}],["21",[["ἐπὶ",705080,0],["τὸ",709436,24],["σῶμα",712635,25],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπὶ",705080,0],["τὴν",709436,8],["κεφαλὴν",707639,9],["ἐφίπτανται",705224,269],["νυκτερίδες",709376,191],["χελιδόνες",713809,191],["καὶ",707031,7],["τὰ",709436,63],["ὄρνεα",709762,64],["ὡσαύτως",714158,28],["δὲ",703303,11],["καὶ",707031,7],["οἱ",709436,136],["αἴλουροι",700437,52]],"Upon their bodies and heads sit bats, swallows, and birds, and the cats also.",{"s":"m","br":"1:22","q":0.95}],["22",[["ὅθεν",709486,28],["γνώσεσθε",703105,124],["ὅτι",709803,7],["οὔκ",709805,28],["εἰσιν",704093,197],["θεοί",706192,52],["μὴ",708851,28],["οὖν",709835,11],["φοβεῖσθε",713532,73],["αὐτά",702165,71]],"By this ye may know that they are no gods: therefore fear them not.",{"s":"m","br":"1:23","q":0.9}],["23",[["τὸ",709436,24],["γὰρ",702963,11],["χρυσίον",713972,25],["ὃ",709781,128],["περίκεινται",710329,269],["εἰς",704105,0],["κάλλος",707093,25],["ἐὰν",703912,7],["μή",708851,28],["τις",712866,158],["ἐκμάξῃ",704257,172],["τὸν",709436,5],["ἰόν",706764,6],["οὐ",709805,28],["μὴ",708851,28],["στίλψωσιν",712106,234],["οὐδὲ",709816,7],["γάρ",702963,11],["ὅτε",709802,28],["ἐχωνεύοντο",714010,667],["ᾐσθάνοντο",700476,139]],"Notwithstanding the gold that is about them to make them beautiful, except they wipe off the rust, they will not shine: for neither when they were molten did they feel it.",{"s":"m","br":"1:24","q":1.0}],["24",[["ἐκ",704132,0],["πάσης",710177,82],["τιμῆς",712856,17],["ἠγορασμένα",700184,443],["ἐστίν",704093,91],["ἐν",704639,0],["οἷς",709781,295],["οὐκ",709805,28],["ἔστιν",704093,91],["πνεῦμα",710566,15]],"The things wherein there is no breath are bought for a most high price.",{"s":"m","br":"1:25","q":0.9}],["25",[["ἄνευ",701137,0],["ποδῶν",710707,81],["ἐπ᾿",705080,0],["ὤμοις",714114,148],["φέρονται",713428,699],["ἐνδεικνύμενοι",704673,348],["τὴν",709436,8],["ἑαυτῶν",703917,40],["ἀτιμίαν",702094,9],["τοῖς",709436,147],["ἀνθρώποις",701163,148],["αἰσχύνονταί",700485,269],["τε",712751,11],["καὶ",707031,28],["οἱ",709436,136],["θεραπεύοντες",706200,146],["αὐτὰ",702165,71],["διὰ",703417,0],["τό",709436,24],["μήποτε",708882,28],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["πέσῃ",710481,172],["δι᾿",703417,0],["αὐτῶν",702165,40],["ἀνίστασθαι",701173,110]],null,{"s":"j","with":"1:25"}],["26",[["μήτε",708891,7],["ἐάν",703912,7],["τις",712866,158],["αὐτὸ",702165,129],["ὀρθὸν",709738,46],["στήσῃ",706846,172],["δι᾿",703417,0],["ἑαυτοῦ",703917,49],["κινηθήσεται",707679,134],["μήτε",708891,7],["ἐὰν",703912,7],["κλιθῇ",707738,384],["οὐ",709805,28],["μὴ",708851,28],["ὀρθωθῇ",709740,384],["ἀλλ᾿",700680,7],["ὥσπερ",714163,28],["νεκροῖς",709247,148],["τὰ",709436,63],["δῶρα",703907,64],["αὐτοῖς",702165,206],["παρατίθεται",710111,391]],"They also that serve them are ashamed: for if they fall to the ground at any time, they cannot rise up again of themselves: neither, if one set them upright, can they move of themselves: neither, if they be bowed down, can they make themselves straight: but they set gifts before them, as unto dead men.",{"s":"m","br":"1:27","q":0.56,"gd":0.53}],["27",[["τὰς",709436,38],["δὲ",703303,11],["θυσίας",706345,39],["αὐτῶν",702165,40],["ἀποδόμενοι",701449,317],["οἱ",709436,136],["ἱερεῖς",706614,52],["αὐτῶν",702165,40],["καταχρῶνται",707492,269],["ὡσαύτως",714158,28],["δὲ",703303,11],["καὶ",707031,28],["αἱ",709436,190],["γυναῖκες",703209,191],["αὐτῶν",702165,40],["ἀπ᾿",701425,0],["αὐτῶν",702165,284],["ταριχεύουσαι",712725,306],["οὔτε",709857,7],["πτωχῷ",711076,114],["οὔτε",709857,7],["ἀδυνάτῳ",700297,30],["μεταδιδόασιν",708791,197],["τῶν",709436,130],["θυσιῶν",706345,65],["αὐτῶν",702165,40],["ἀποκαθημένη",701469,211],["καὶ",707031,7],["λεχὼ",708170,1],["ἅπτονται",701654,269]],"As for the things that are sacrificed unto them, their priests sell and abuse; in like manner their wives lay up part thereof in salt; but unto the poor and impotent they give nothing of it.",{"s":"m","br":"1:28","q":0.73}],["28",[["γνόντες",703105,196],["οὖν",709835,11],["ἀπὸ",701425,0],["τούτων",709858,70],["ὅτι",709803,7],["οὔκ",709805,28],["εἰσιν",704093,197],["θεοί",706192,52],["μὴ",708851,28],["φοβηθῆτε",713532,394],["αὐτούς",702165,62]],null,{"s":"h"}],["29",[["πόθεν",710580,28],["γὰρ",702963,11],["κληθείησαν",707084,393],["θεοί",706192,52],["ὅτι",709803,7],["γυναῖκες",703209,191],["παρατιθέασιν",710111,197],["θεοῖς",706192,148],["ἀργυροῖς",701705,230],["καὶ",707031,7],["χρυσοῖς",713971,230],["καὶ",707031,7],["ξυλίνοις",709425,230]],"For how can they be called gods? because women set meat before the gods of silver, gold, and wood.",{"s":"m","br":"1:30","q":1.0}],["30",[["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["οἴκοις",709516,148],["αὐτῶν",702165,40],["οἱ",709436,136],["ἱερεῖς",706614,52],["διφρεύουσιν",703754,197],["ἔχοντες",705785,146],["τοὺς",709436,58],["χιτῶνας",713869,57],["διερρωγότας",703565,277],["καὶ",707031,7],["τὰς",709436,38],["κεφαλὰς",707639,39],["καὶ",707031,7],["τοὺς",709436,58],["πώγωνας",711115,57],["ἐξυρημένους",709431,458],["ὧν",709781,252],["αἱ",709436,190],["κεφαλαὶ",707639,191],["ἀκάλυπτοί",700513,192],["εἰσιν",704093,197]],"And the priests sit in their temples, having their clothes rent, and their heads and beards shaven, and nothing upon their heads.",{"s":"m","br":"1:31","q":1.0}],["31",[["ὠρύονται",714142,269],["δὲ",703303,11],["βοῶντες",702743,146],["ἐναντίον",704654,0],["τῶν",709436,80],["θεῶν",706192,81],["αὐτῶν",702165,40],["ὥσπερ",714163,28],["τινὲς",712866,392],["ἐν",704639,0],["περιδείπνῳ",710305,54],["νεκροῦ",709247,18]],"They roar and cry before their gods, as men do at the feast when one is dead.",{"s":"m","br":"1:32","q":1.0}],["32",[["ἀπὸ",701425,0],["τοῦ",709436,35],["ἱματισμοῦ",706744,18],["αὐτῶν",702165,40],["ἀφελόμενοι",702177,317],["οἱ",709436,136],["ἱερεῖς",706614,52],["ἐνδύουσιν",704701,197],["τὰς",709436,38],["γυναῖκας",703209,39],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,41],["παιδία",709927,42]],"The priests also take off their garments, and clothe their wives and children.",{"s":"m","br":"1:33","q":0.93}],["33",[["οὔτε",709857,7],["ἐὰν",703912,7],["κακὸν",707066,46],["πάθωσιν",710183,234],["ὑπό",713184,0],["τινος",712866,308],["οὔτε",709857,7],["ἐὰν",703912,7],["ἀγαθόν",700106,46],["δυνήσονται",703838,135],["ἀνταποδοῦναι",701215,106],["οὔτε",709857,7],["καταστῆσαι",707011,106],["βασιλέα",702580,6],["δύνανται",703838,269],["οὔτε",709857,7],["ἀφελέσθαι",702177,109]],"Whether it be evil that one doeth unto them, or good, they are not able to recompense it: they can neither set up a king, nor put him down.",{"s":"m","br":"1:34","q":1.0}],["34",[["ὡσαύτως",714158,28],["οὔτε",709857,7],["πλοῦτον",710563,6],["οὔτε",709857,7],["χαλκὸν",713695,6],["οὐ",709805,28],["μὴ",708851,28],["δύνωνται",703838,380],["διδόναι",703654,55],["ἐάν",703912,7],["τις",712866,158],["αὐτοῖς",702165,151],["εὐχὴν",705726,9],["εὐξάμενος",705727,248],["μὴ",708851,28],["ἀποδῷ",701449,172],["οὐ",709805,28],["μὴ",708851,28],["ἐπιζητήσωσιν",705135,234]],"In like manner, they can neither give riches nor money: though a man make a vow unto them, and keep it not, they will not require it.",{"s":"m","br":"1:35","q":1.0}],["35",[["ἐκ",704132,0],["θανάτου",706096,18],["ἄνθρωπον",701163,6],["οὐ",709805,28],["μὴ",708851,28],["ῥύσωνται",711309,232],["οὔτε",709857,7],["ἥττονα",706042,27],["ἀπὸ",701425,0],["ἰσχυροῦ",706855,116],["οὐ",709805,28],["μὴ",708851,28],["ἐξέλωνται",704838,232]],"They can save no man from death, neither deliver the weak from the mighty.",{"s":"m","br":"1:36","q":0.92}],["36",[["ἄνθρωπον",701163,6],["τυφλὸν",713031,27],["εἰς",704105,0],["ὅρασιν",709721,9],["οὐ",709805,28],["μὴ",708851,28],["περιστήσωσιν",710320,234],["ἐν",704639,0],["ἀνάγκῃ",700925,1],["ἄνθρωπον",701163,6],["ὄντα",704093,183],["οὐ",709805,28],["μὴ",708851,28],["ἐξέλωνται",704838,232]],"They cannot restore a blind man to his sight, nor help any man in his distress.",{"s":"m","br":"1:37","q":1.0}],["37",[["χήραν",713848,9],["οὐ",709805,28],["μὴ",708851,28],["ἐλεήσωσιν",704418,234],["οὔτε",709857,7],["ὀρφανὸν",709779,27],["εὖ",705544,28],["ποιήσουσιν",710582,218]],"They can shew no mercy to the widow, nor do good to the fatherless.",{"s":"m","br":"1:38","q":1.0}],["38",[["τοῖς",709436,147],["ἀπὸ",701425,0],["τοῦ",709436,20],["ὄρους",709768,21],["λίθοις",708196,148],["ὡμοιωμένοι",709628,429],["εἰσὶν",704093,197],["τὰ",709436,63],["ξύλινα",709425,195],["καὶ",707031,7],["τὰ",709436,63],["περίχρυσα",710421,195],["καὶ",707031,7],["τὰ",709436,63],["περιάργυρα",710291,195],["οἱ",709436,136],["δὲ",703303,11],["θεραπεύοντες",706200,146],["αὐτὰ",702165,71],["καταισχυνθήσονται",707257,144]],"Their gods of wood, and which are overlaid with gold and silver, are like the stones that be hewn out of the mountain: they that worship them shall be confounded.",{"s":"m","br":"1:39","q":0.95}],["39",[["πῶς",711121,28],["οὖν",709835,11],["νομιστέον",709343,26],["ἢ",705924,7],["κλητέον",707731,26],["αὐτοὺς",702165,62],["ὑπάρχειν",713104,55],["θεούς",706192,57]],null,{"s":"h"}],["40",[["ἔτι",705538,28],["δὲ",703303,11],["καὶ",707031,28],["αὐτῶν",702165,40],["τῶν",709436,80],["Χαλδαίων",713678,81],["ἀτιμαζόντων",702092,170],["αὐτά",702165,71],["οἵ",709781,250],["ὅταν",709801,28],["ἴδωσιν",709725,234],["ἐνεὸν",704758,27],["οὐ",709805,28],["δυνάμενον",703838,212],["λαλῆσαι",708071,106],["προσενεγκάμενοι",710974,317],["τὸν",709436,5],["Βῆλον",702697,6],["ἀξιοῦσιν",701309,197],["φωνῆσαι",713639,106],["ὡς",714148,7],["δυνατοῦ",703845,116],["ὄντος",704093,152],["αὐτοῦ",702165,102],["αἰσθέσθαι",700476,109]],"How should a man then think and say that they are gods, when even the Chaldeans themselves dishonour them? Who if they shall see one dumb that cannot speak, they bring him, and intreat Bel that he may speak, as though he were able to understand.",{"s":"m","br":"1:40 1:41","q":0.73}],["41",[["καὶ",707031,7],["οὐ",709805,28],["δύνανται",703838,269],["αὐτοὶ",702165,201],["νοήσαντες",709327,196],["καταλιπεῖν",707305,106],["αὐτά",702165,71],["αἴσθησιν",700477,9],["γὰρ",702963,11],["οὐκ",709805,28],["ἔχουσιν",705785,197]],"Yet they cannot understand this themselves, and leave them: for they have no knowledge.",{"s":"m","br":"1:42","q":1.0}],["42",[["αἱ",709436,190],["δὲ",703303,11],["γυναῖκες",703209,191],["περιθέμεναι",710403,402],["σχοινία",712610,42],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["ἐγκάθηνται",703952,269],["θυμιῶσαι",706332,306],["τὰ",709436,41],["πίτυρα",710489,42]],null,{"s":"h"}],["43",[["ὅταν",709801,28],["δέ",703303,11],["τις",712866,359],["αὐτῶν",702165,284],["ἐφελκυσθεῖσα",705745,307],["ὑπό",713184,0],["τινος",712866,308],["τῶν",709436,80],["παραπορευομένων",710094,299],["κοιμηθῇ",707767,384],["τὴν",709436,8],["πλησίον",710547,28],["ὀνειδίζει",709655,91],["ὅτι",709803,7],["οὐκ",709805,28],["ἠξίωται",701309,187],["ὥσπερ",714163,28],["καὶ",707031,28],["αὐτὴ",702165,107],["οὔτε",709857,7],["τὸ",709436,34],["σχοινίον",712610,15],["αὐτῆς",702165,86],["διερράγη",703565,37]],"The women also with cords about them, sitting in the ways, burn bran for perfume: but if any of them, drawn by some that passeth by, lie with him, she reproacheth her fellow, that she was not thought as worthy as herself, nor her cord broken.",{"s":"d","q":0.66}],["44",[["πάντα",710177,195],["τὰ",709436,63],["γινόμενα",703104,210],["αὐτοῖς",702165,151],["ἐστιν",704093,91],["ψευδῆ",714036,195],["πῶς",711121,28],["οὖν",709835,11],["νομιστέον",709343,26],["ἢ",705924,7],["κλητέον",707731,26],["ὥστε",714164,7],["θεοὺς",706192,57],["αὐτοὺς",702165,62],["ὑπάρχειν",713104,55]],"Whatsoever is done among them is false: how may it then be thought or said that they are gods?"],["45",[["ὑπὸ",713184,0],["τεκτόνων",712766,81],["καὶ",707031,7],["χρυσοχόων",713979,81],["κατεσκευασμένα",707419,443],["εἰσίν",704093,197],["οὐθὲν",709817,46],["ἄλλο",700697,129],["μὴ",708851,28],["γένωνται",703104,232],["ἢ",705924,7],["ὃ",709781,128],["βούλονται",702795,269],["οἱ",709436,136],["τεχνῖται",712832,52],["αὐτὰ",702165,71],["γενέσθαι",703104,109]],"They are made of carpenters and goldsmiths: they can be nothing else than the workmen will have them to be."],["46",[["αὐτοί",702165,201],["τε",712751,11],["οἱ",709436,136],["κατασκευάζοντες",707419,146],["αὐτὰ",702165,71],["οὐ",709805,28],["μὴ",708851,28],["γένωνται",703104,232],["πολυχρόνιοι",710652,138],["πῶς",711121,28],["τε",712751,11],["δὴ",703395,11],["μέλλει",708705,91],["τὰ",709436,63],["ὑπ᾿",713184,0],["αὐτῶν",702165,40],["κατασκευασθέντα",707419,352],["εἶναι",704093,55],["θεοί",706192,52]],"And they themselves that made them can never continue long; how should then the things that are made of them be gods?"],["47",[["κατέλιπον",707305,150],["γὰρ",702963,11],["ψεύδη",714036,68],["καὶ",707031,7],["ὄνειδος",709658,25],["τοῖς",709436,147],["ἐπιγινομένοις",705103,341]],"For they left lies and reproaches to them that come after."],["48",[["ὅταν",709801,28],["γὰρ",702963,11],["ἐπέλθῃ",705068,172],["ἐπ᾿",705080,0],["αὐτὰ",702165,71],["πόλεμος",710605,4],["καὶ",707031,7],["κακά",707066,195],["βουλεύονται",702791,269],["πρὸς",710844,0],["ἑαυτοὺς",703917,62],["οἱ",709436,136],["ἱερεῖς",706614,52],["ποῦ",710706,28],["συναποκρυβῶσι",712401,272],["μετ᾿",708780,0],["αὐτῶν",702165,70]],"For when there cometh any war or plague upon them, the priests consult with themselves, where they may be hidden with them."],["49",[["πῶς",711121,28],["οὖν",709835,11],["οὐκ",709805,28],["ἔστιν",704093,91],["αἰσθέσθαι",700476,109],["ὅτι",709803,7],["οὔκ",709805,28],["εἰσιν",704093,197],["θεοί",706192,52],["οἳ",709781,250],["οὔτε",709857,7],["σῴζουσιν",712627,197],["ἑαυτοὺς",703917,62],["ἐκ",704132,0],["πολέμου",710605,18],["οὔτε",709857,7],["ἐκ",704132,0],["κακῶν",707066,83]],"How then cannot men perceive that they be no gods, which can neither save themselves from war, nor from plague?"],["50",[["ὑπάρχοντα",713102,242],["γὰρ",702963,11],["ξύλινα",709425,195],["καὶ",707031,7],["περίχρυσα",710421,195],["καὶ",707031,7],["περιάργυρα",710291,195],["γνωσθήσεται",703105,134],["μετὰ",708780,0],["ταῦτα",709858,71],["ὅτι",709803,7],["ἐστὶν",704093,91],["ψευδῆ",714036,195],["τοῖς",709436,95],["ἔθνεσι",704068,96],["πᾶσι",710177,94],["τοῖς",709436,147],["τε",712751,11],["βασιλεῦσι",702580,148],["φανερὸν",713342,26],["ἔσται",704093,93],["ὅτι",709803,7],["οὔκ",709805,28],["εἰσι",704093,197],["θεοὶ",706192,52],["ἀλλὰ",700680,7],["ἔργα",705396,64],["χειρῶν",713787,65],["ἀνθρώπων",701163,81],["καὶ",707031,7],["οὐδὲν",709817,26],["θεοῦ",706192,18],["ἔργον",705396,15],["ἐν",704639,0],["αὐτοῖς",702165,206],["ἐστιν",704093,91]],"For seeing they be but of wood, and overlaid with silver and gold, it shall be known hereafter that they are false: and it shall manifestly appear to all nations and kings that they are no gods, but the works of men's hands, and that there is no work of God in them.",{"s":"m","br":"1:50 1:51","q":0.94}],["51",[["τίνι",712867,435],["οὖν",709835,11],["γνωστέον",703139,26],["ἐστὶν",704093,91],["ὅτι",709803,7],["οὔκ",709805,28],["εἰσιν",704093,197],["θεοί",706192,52]],"Who then may not know that they are no gods?",{"s":"m","br":"1:52","q":0.88}],["52",[["βασιλέα",702580,6],["γὰρ",702963,11],["χώρας",714011,17],["οὐ",709805,28],["μὴ",708851,28],["ἀναστήσωσιν",701173,234],["οὔτε",709857,7],["ὑετὸν",713074,6],["ἀνθρώποις",701163,148],["οὐ",709805,28],["μὴ",708851,28],["δῶσιν",703654,234]],"For neither can they set up a king in the land, nor give rain unto men.",{"s":"m","br":"1:53","q":0.92}],["53",[["κρίσιν",707908,9],["τε",712751,11],["οὐ",709805,28],["μὴ",708851,28],["διακρίνωσιν",703488,234],["αὐτῶν",702165,40],["οὐδὲ",709816,7],["μὴ",708851,28],["ῥύσωνται",711309,232],["ἀδικούμενον",700269,464],["ἀδύνατοι",700297,138],["ὄντες",704093,146],["ὥσπερ",714163,28],["γὰρ",702963,11],["κορῶναι",707845,191],["ἀνὰ",700902,0],["μέσον",708768,27],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["τῆς",709436,16],["γῆς",703083,17]],"Neither can they judge their own cause, nor redress a wrong, being unable: for they are as crows between heaven and earth.",{"s":"m","br":"1:54","q":0.82}],["54",[["καὶ",707031,7],["γὰρ",702963,11],["ὅταν",709801,28],["ἐμπέσῃ",704593,172],["εἰς",704105,0],["οἰκίαν",709505,9],["θεῶν",706192,81],["ξυλίνων",709425,169],["ἢ",705924,7],["περιχρύσων",710421,169],["ἢ",705924,7],["περιαργύρων",710291,169],["πῦρ",711088,15],["οἱ",709436,136],["μὲν",708730,11],["ἱερεῖς",706614,52],["αὐτῶν",702165,70],["φεύξονται",713433,135],["καὶ",707031,7],["διασωθήσονται",703599,144],["αὐτοὶ",702165,201],["δὲ",703303,11],["ὥσπερ",714163,28],["δοκοὶ",703781,191],["μέσοι",708768,138],["κατακαυθήσονται",707258,144]],"Whereupon when fire falleth upon the house of gods of wood, or laid over with gold or silver, their priests will flee away, and escape: but they themselves shall be burned asunder like beams.",{"s":"m","br":"1:55","q":0.96}],["55",[["βασιλεῖ",702580,114],["δὲ",703303,11],["καὶ",707031,7],["πολεμίοις",710603,230],["οὐ",709805,28],["μὴ",708851,28],["ἀντιστῶσιν",701154,234]],null,{"s":"h"}],["56",[["πῶς",711121,28],["οὖν",709835,11],["ἐκδεκτέον",704163,26],["ἢ",705924,7],["νομιστέον",709343,26],["ὅτι",709803,7],["εἰσὶν",704093,197],["θεοί",706192,52]],"Moreover they cannot withstand any king or enemies: how can it then be thought or said that they be gods?",{"s":"d","q":0.47}],["57",[["οὔτε",709857,7],["ἀπὸ",701425,0],["κλεπτῶν",707714,81],["οὔτε",709857,7],["ἀπὸ",701425,0],["λῃστῶν",708181,81],["οὐ",709805,28],["μὴ",708851,28],["διασωθῶσιν",703599,272],["θεοὶ",706192,52],["ξύλινοι",709425,138],["καὶ",707031,7],["περιάργυροι",710291,138],["καὶ",707031,7],["περίχρυσοι",710421,138],["ὧν",709781,252],["οἱ",709436,136],["ἰσχύοντες",706859,146],["περιελοῦνται",710288,135],["τὸ",709436,24],["χρυσίον",713972,25],["καὶ",707031,7],["τὸ",709436,24],["ἀργύριον",701707,25],["καὶ",707031,7],["τὸν",709436,5],["ἱματισμὸν",706744,6],["τὸν",709436,5],["περικείμενον",710329,212],["αὐτοῖς",702165,151],["ἀπελεύσονται",701398,135],["ἔχοντες",705785,146],["οὔτε",709857,7],["ἑαυτοῖς",703917,151],["οὐ",709805,28],["μὴ",708851,28],["βοηθήσωσιν",702746,234]],"Neither are those gods of wood, and laid over with silver or gold, able to escape either from thieves or robbers. Whose gold, and silver, and garments wherewith they are clothed, they that are strong do take, and go away withal: neither are they able to help themselves.",{"s":"m","br":"1:57 1:58","q":1.0}],["58",[["ὥστε",714164,7],["κρεῖσσον",707890,26],["εἶναι",704093,55],["βασιλέα",702580,6],["ἐπιδεικνύμενον",705112,212],["τὴν",709436,8],["ἑαυτοῦ",703917,102],["ἀνδρείαν",701100,9],["ἢ",705924,7],["σκεῦος",711844,25],["ἐν",704639,0],["οἰκίᾳ",709505,1],["χρήσιμον",713953,46],["ἐφ᾿",705080,0],["ᾧ",709781,209],["χρήσεται",713937,93],["ὁ",709436,3],["κεκτημένος",707932,419],["ἢ",705924,7],["οἱ",709436,136],["ψευδεῖς",714036,138],["θεοί",706192,52],["ἢ",705924,7],["καὶ",707031,28],["θύρα",706337,12],["ἐν",704639,0],["οἰκίᾳ",709505,1],["διασῴζουσα",703599,188],["τὰ",709436,41],["ἐν",704639,0],["αὐτῇ",702165,105],["ὄντα",704093,237],["ἢ",705924,7],["οἱ",709436,136],["ψευδεῖς",714036,138],["θεοί",706192,52],["καὶ",707031,7],["ξύλινος",709425,14],["στῦλος",712179,4],["ἐν",704639,0],["βασιλείοις",702578,96],["ἢ",705924,7],["οἱ",709436,136],["ψευδεῖς",714036,138],["θεοί",706192,52]],"Therefore it is better to be a king that sheweth his power, or else a profitable vessel in an house, which the owner shall have use of, than such false gods; or to be a door in an house, to keep such things safe as be therein, than such false gods; or a pillar of wood in a palace, than such false gods.",{"s":"m","br":"1:59","q":0.98}],["59",[["ἥλιος",705974,4],["μὲν",708730,11],["γὰρ",702963,11],["καὶ",707031,7],["σελήνη",711650,12],["καὶ",707031,7],["ἄστρα",702024,64],["ὄντα",704093,242],["λαμπρὰ",708082,195],["καὶ",707031,7],["ἀποστελλόμενα",701592,210],["ἐπὶ",705080,0],["χρείας",713938,17],["εὐήκοά",705583,195],["εἰσιν",704093,197]],"For sun, moon, and stars, being bright, and sent to do their offices, are obedient.",{"s":"m","br":"1:60","q":1.0}],["60",[["ὡσαύτως",714158,28],["καὶ",707031,28],["ἀστραπή",702021,12],["ὅταν",709801,28],["ἐπιφανῇ",705317,384],["εὔοπτός",705656,29],["ἐστιν",704093,91],["τὸ",709436,24],["δ᾿",703303,11],["αὐτὸ",702165,129],["καὶ",707031,28],["πνεῦμα",710566,15],["ἐν",704639,0],["πάσῃ",710177,101],["χώρᾳ",714011,1],["πνεῖ",710571,91]],null,{"s":"h"}],["61",[["καὶ",707031,7],["νεφέλαις",709277,76],["ὅταν",709801,28],["ἐπιταγῇ",705294,384],["ὑπὸ",713184,0],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐπιπορεύεσθαι",705232,110],["ἐφ᾿",705080,0],["ὅλην",709597,36],["τὴν",709436,8],["οἰκουμένην",709517,173],["συντελοῦσι",712510,197],["τὸ",709436,24],["ταχθέν",712730,377],["τό",709436,34],["τε",712751,11],["πῦρ",711088,15],["ἐξαποσταλὲν",704872,418],["ἄνωθεν",701298,28],["ἐξαναλῶσαι",704861,106],["ὄρη",709768,42],["καὶ",707031,7],["δρυμοὺς",703836,57],["ποιεῖ",710582,91],["τὸ",709436,24],["συνταχθέν",712508,377]],null,{"s":"h"}],["62",[["ταῦτα",709858,290],["δὲ",703303,11],["οὔτε",709857,7],["ταῖς",709436,75],["ἰδέαις",706483,76],["οὔτε",709857,7],["ταῖς",709436,75],["δυνάμεσιν",703839,76],["αὐτῶν",702165,40],["ἀφωμοιωμένα",702223,443],["ἐστίν",704093,91]],null,{"s":"h"}],["63",[["ὅθεν",709486,28],["οὔτε",709857,7],["νομιστέον",709343,26],["οὔτε",709857,7],["κλητέον",707731,26],["ὑπάρχειν",713104,55],["αὐτοὺς",702165,62],["θεούς",706192,57],["οὐ",709805,28],["δυνατῶν",703845,83],["ὄντων",704093,84],["αὐτῶν",702165,70],["οὔτε",709857,7],["κρίσιν",707908,9],["κρῖναι",707905,106],["οὔτε",709857,7],["εὖ",705544,28],["ποιεῖν",710582,55],["ἀνθρώποις",701163,148]],"Wherefore it is neither to be supposed nor said that they are gods, seeing they are able neither to judge causes, nor to do good unto men.",{"s":"m","br":"1:64","q":0.89}],["64",[["γνόντες",703105,196],["οὖν",709835,11],["ὅτι",709803,7],["οὔκ",709805,28],["εἰσιν",704093,197],["θεοί",706192,52],["μὴ",708851,28],["φοβηθῆτε",713532,394],["αὐτούς",702165,62]],"Knowing therefore that they are no gods, fear them not.",{"s":"m","br":"1:65","q":0.89}],["65",[["οὔτε",709857,7],["γὰρ",702963,11],["βασιλεῦσιν",702580,148],["οὐ",709805,28],["μὴ",708851,28],["καταράσωνται",707396,232],["οὔτε",709857,7],["μὴ",708851,28],["εὐλογήσωσι",705631,234]],"For they can neither curse nor bless kings:",{"s":"m","br":"1:66","q":1.0}],["66",[["σημεῖά",711748,42],["τε",712751,11],["ἐν",704639,0],["ἔθνεσιν",704068,96],["ἐν",704639,0],["οὐρανῷ",709844,114],["οὐ",709805,28],["μὴ",708851,28],["δείξωσιν",703314,234],["οὐδὲ",709816,7],["ὡς",714148,7],["ὁ",709436,3],["ἥλιος",705974,4],["λάμψουσιν",708085,218],["οὐδὲ",709816,7],["φωτίσουσιν",713646,218],["ὡς",714148,7],["σελήνη",711650,12]],"neither can they shew signs in the heavens among the heathen, nor shine as the sun, nor give light as the moon.",{"s":"m","br":"1:67","q":0.84}],["67",[["τὰ",709436,63],["θηρία",706252,64],["ἐστὶν",704093,91],["κρείττω",707891,195],["αὐτῶν",702165,40],["ἃ",709781,371],["δύνανται",703838,269],["ἐκφυγόντα",704357,773],["εἰς",704105,0],["σκέπην",711839,9],["ἑαυτὰ",703917,71],["ὠφελῆσαι",714171,106]],"The beasts are better than they: for they can get under a covert, and help themselves.",{"s":"m","br":"1:68","q":0.92}],["68",[["κατ᾿",707200,0],["οὐδένα",709817,27],["οὖν",709835,11],["τρόπον",712980,6],["ἐστὶν",704093,91],["ἡμῖν",705994,90],["φανερὸν",713342,26],["ὅτι",709803,7],["εἰσὶν",704093,197],["θεοί",706192,52],["διὸ",703714,7],["μὴ",708851,28],["φοβηθῆτε",713532,394],["αὐτούς",702165,62]],"It is then by no means manifest unto us that they are gods: therefore fear them not.",{"s":"m","br":"1:69","q":0.86}],["69",[["ὥσπερ",714163,28],["γὰρ",702963,11],["ἐν",704639,0],["σικυηράτῳ",711787,54],["προβασκάνιον",710766,15],["οὐδὲν",709817,46],["φυλάσσον",713619,32],["οὕτως",709859,28],["οἱ",709436,136],["θεοὶ",706192,52],["αὐτῶν",702165,40],["εἰσιν",704093,197],["ξύλινοι",709425,138],["καὶ",707031,7],["περίχρυσοι",710421,138],["καὶ",707031,7],["περιάργυροι",710291,138]],"For as a scarecrow in a garden of cucumbers keepeth nothing: so are their gods of wood, and laid over with silver and gold.",{"s":"m","br":"1:70","q":0.88}],["70",[["τὸν",709436,5],["αὐτὸν",702165,85],["τρόπον",712980,6],["καὶ",707031,28],["τῇ",709436,100],["ἐν",704639,0],["κήπῳ",707654,114],["ῥάμνῳ",711172,1],["ἐφ᾿",705080,0],["ἧς",709781,167],["πᾶν",710177,26],["ὄρνεον",709762,15],["ἐπικάθηται",705149,117],["ὡσαύτως",714158,28],["δὲ",703303,11],["καὶ",707031,28],["νεκρῷ",709247,114],["ἐρριμμένῳ",711267,463],["ἐν",704639,0],["σκότει",711889,54],["ἀφωμοίωνται",702223,255],["οἱ",709436,136],["θεοὶ",706192,52],["αὐτῶν",702165,40],["ξύλινοι",709425,138],["καὶ",707031,7],["περίχρυσοι",710421,138],["καὶ",707031,7],["περιάργυροι",710291,138]],"And likewise their gods of wood, and laid over with silver and gold, are like to a white thorn in an orchard, that every bird sitteth upon; as also to a dead body, that is cast into the dark.",{"s":"m","br":"1:71","q":1.0}],["71",[["ἀπό",701425,0],["τε",712751,11],["τῆς",709436,16],["πορφύρας",710682,17],["καὶ",707031,7],["τῆς",709436,16],["μαρμάρου",708516,17],["τῆς",709436,16],["ἐπ᾿",705080,0],["αὐτοῖς",702165,151],["σηπομένης",711754,422],["γνώσεσθε",703105,124],["ὅτι",709803,7],["οὔκ",709805,28],["εἰσιν",704093,197],["θεοί",706192,52],["αὐτά",702165,290],["τε",712751,11],["ἐξ",704132,0],["ὑστέρου",713274,542],["βρωθήσονται",702722,144],["καὶ",707031,7],["ἔσται",704093,93],["ὄνειδος",709658,15],["ἐν",704639,0],["τῇ",709436,100],["χώρᾳ",714011,1]],"And ye shall know them to be no gods by the bright purple that rotteth upon them: and they themselves afterward shall be eaten, and shall be a reproach in the country.",{"s":"m","br":"1:72","q":0.89}],["72",[["κρείσσων",707891,14],["οὖν",709835,11],["ἄνθρωπος",701163,4],["δίκαιος",703694,14],["οὐκ",709805,28],["ἔχων",705785,72],["εἴδωλα",704079,42],["ἔσται",704093,93],["γὰρ",702963,11],["μακρὰν",708411,28],["ἀπὸ",701425,0],["ὀνειδισμοῦ",709657,18]],"Better therefore is the just man that hath no idols: for he shall be far from reproach.",{"s":"m","br":"1:73","q":0.92}]]