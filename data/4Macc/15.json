[["1",[["ὦ",714081,88],["λογισμὲ",708234,153],["τέκνων",712761,44],["παθῶν",709918,44],["τύραννε",713026,153],["καὶ",707031,7],["εὐσέβεια",705685,12],["μητρὶ",708892,1],["τέκνων",712761,44],["ποθεινοτέρα",710579,178]],"O reasoning of the sons, lord over the passions, and religion more desirable to a mother than progeny!"],["2",[["μήτηρ",708892,12],["δυεῖν",703849,59],["προκειμένων",710812,522],["εὐσεβείας",705685,17],["καὶ",707031,7],["τῆς",709436,16],["ἑπτὰ",705357,59],["υἱῶν",713075,81],["σωτηρίας",712658,17],["προσκαίρου",710910,82],["κατὰ",707200,0],["τὴν",709436,8],["τοῦ",709436,35],["τυράννου",713026,18],["ὑπόσχεσιν",713249,9]],"The mother, when two things were set before her, religion and the safety of her seven sons for a time, on the conditional promise of a tyrant,"],["3",[["τὴν",709436,8],["εὐσέβειαν",705685,9],["μᾶλλον",708448,28],["ἠγάπησεν",700120,2],["τὴν",709436,8],["σῴζουσαν",712627,78],["εἰς",704105,0],["αἰωνίαν",700505,36],["ζωὴν",705910,9],["κατὰ",707200,0],["θεόν",706192,6]],"rather elected the religion which according to God preserves to eternal life."],["4",[["ὦ",714081,88],["τίνα",712867,356],["τρόπον",712980,6],["ἠθολογήσαιμι",705954,346],["φιλότεκνα",713500,68],["γονέων",703169,81],["πάθη",709918,42],["ψυχῆς",714070,17],["τε",712751,11],["καὶ",707031,7],["μορφῆς",709018,17],["ὁμοιότητα",709627,9],["εἰς",704105,0],["μικρὸν",708915,27],["παιδὸς",709932,18],["χαρακτῆρα",713727,6],["θαυμάσιον",706136,27],["ἐναποσφραγίζομεν",704660,243],["μάλιστα",708446,28],["διὰ",703417,0],["τὸ",709436,24],["τῶν",709436,43],["παθῶν",709918,44],["τοῖς",709436,147],["γεννηθεῖσιν",703051,477],["τὰς",709436,38],["μητέρας",708892,39],["τῶν",709436,80],["πατέρων",710189,81],["καθεστάναι",707011,115],["συμπαθεστέρας",712317,366]],"O in what way can I describe ethically the affections of parents toward their children, the resemblance of soul and of form engrafted into the small type of a child in a wonderful manner, especially through the greater sympathy of mothers with the feelings of those born of them!"],["5",[["ὅσῳ",709788,30],["γὰρ",702963,11],["καὶ",707031,7],["ἀσθενόψυχοι",701940,192],["καὶ",707031,7],["πολυγονώτεραι",710622,481],["ὑπάρχουσιν",713104,197],["αἱ",709436,190],["μητέρες",708892,191],["τοσούτῳ",712907,30],["μᾶλλόν",708448,28],["εἰσιν",704093,197],["φιλοτεκνότεραι",713500,481]],"for by how much mothers are by nature weak in disposition and prolific in offspring, by so much the fonder they are of children."],["6",[["πασῶν",710177,198],["δὲ",703303,11],["τῶν",709436,130],["μητέρων",708892,65],["ἐγένετο",703104,23],["ἡ",709436,10],["τῶν",709436,80],["ἑπτὰ",705357,59],["παίδων",709932,81],["μήτηρ",708892,12],["φιλοτεκνοτέρα",713500,178],["ἥτις",709793,412],["ἑπτὰ",705357,59],["κυοφορίαις",707980,76],["τὴν",709436,8],["πρὸς",710844,0],["αὐτοὺς",702165,62],["ἐπιφυτευομένη",705327,211],["φιλοστοργίαν",713496,9]],"And of all mothers the mother of the seven was the fondest of children, who in seven childbirths had deeply engendered love toward them;"],["7",[["καὶ",707031,7],["διὰ",703417,0],["πολλὰς",710646,119],["τὰς",709436,38],["καθ᾿",707200,0],["ἕκαστον",704133,27],["αὐτῶν",702165,40],["ὠδῖνας",714094,39],["ἠναγκασμένη",700923,203],["τὴν",709436,8],["εἰς",704105,0],["αὐτοὺς",702165,62],["ἔχειν",705785,55],["συμπάθειαν",712315,9]],"and through her many pains undergone in connection with each one, was compelled to feel sympathy with them;"],["8",[["διὰ",703417,0],["τὸν",709436,5],["πρὸς",710844,0],["τὸν",709436,5],["θεὸν",706192,6],["φόβον",713534,6],["ὑπερεῖδεν",713154,2],["τὴν",709436,8],["τῶν",709436,43],["τέκνων",712761,44],["πρόσκαιρον",710910,36],["σωτηρίαν",712658,9]],"yet, through fear of God, she neglected the temporary salvation of her children."],["9",[["οὐ",709805,28],["μὴν",708873,11],["δὲ",703303,11],["ἀλλὰ",700680,7],["καὶ",707031,28],["διὰ",703417,0],["τὴν",709436,8],["καλοκἀγαθίαν",707096,9],["τῶν",709436,80],["υἱῶν",713075,81],["καὶ",707031,7],["τὴν",709436,8],["πρὸς",710844,0],["τὸν",709436,5],["νόμον",709349,6],["αὐτῶν",702165,40],["εὐπείθειαν",705661,9],["μείζω",708653,36],["τὴν",709436,8],["ἐν",704639,0],["αὐτοῖς",702165,151],["ἔσχεν",705785,2],["φιλοστοργίαν",713496,9]],"Not but that, on account of the excellent disposition of her sons, and their obedience to the law, her maternal affection toward them was increased."],["10",[["δίκαιοί",703694,138],["τε",712751,11],["γὰρ",702963,11],["ἦσαν",704093,137],["καὶ",707031,7],["σώφρονες",712675,138],["καὶ",707031,7],["ἀνδρεῖοι",701101,138],["καὶ",707031,7],["μεγαλόψυχοι",708645,138],["καὶ",707031,7],["φιλάδελφοι",713459,138],["καὶ",707031,7],["φιλομήτορες",713484,52],["οὕτως",709859,28],["ὥστε",714164,7],["καὶ",707031,28],["μέχρι",708849,0],["θανάτου",706096,18],["τὰ",709436,41],["νόμιμα",709340,68],["φυλάσσοντας",713619,235],["πείθεσθαι",710221,110],["αὐτῇ",702165,105]],"For they were both just and temperate, and manly, and high-minded, and fond of their brethren, and so fond of their mother that even unto death they obeyed her by observing the law."],["11",[["ἀλλ᾿",700680,7],["ὅμως",709652,7],["καίπερ",707045,7],["τοσούτων",712907,169],["ὄντων",704093,170],["τῶν",709436,80],["περὶ",710285,0],["τὴν",709436,8],["φιλοτεκνίαν",713499,9],["εἰς",704105,0],["συμπάθειαν",712315,9],["ἑλκόντων",704508,170],["τὴν",709436,8],["μητέρα",708892,9],["ἐπ᾿",705080,0],["οὐδενὸς",709817,116],["αὐτῶν",702165,40],["τὸν",709436,5],["λογισμὸν",708234,6],["αὐτῆς",702165,86],["αἱ",709436,190],["παμποίκιλοι",709952,192],["βάσανοι",702570,191],["ἴσχυσαν",706859,150],["μετατρέψαι",708821,106]],"And yet, though there were so many circumstances connected with love of children to draw on a mother to sympathy, in the case of none of them were the various tortures able to pervert her principle."],["12",[["ἀλλὰ",700680,7],["καὶ",707031,28],["καθ᾿",707200,0],["ἕνα",704106,27],["παῖδα",709932,6],["καὶ",707031,7],["ὁμοῦ",709644,116],["πάντας",710177,60],["ἡ",709436,10],["μήτηρ",708892,12],["ἐπὶ",705080,0],["τὸν",709436,5],["τῆς",709436,16],["εὐσεβείας",705685,17],["προετρέπετο",710996,19],["θάνατον",706096,6]],"But she inclined each one separately and all together to death for religion."],["13",[["ὦ",714081,88],["φύσις",713633,258],["ἱερὰ",706633,602],["καὶ",707031,7],["φίλτρα",713507,589],["γονέων",703169,81],["καὶ",707031,7],["γένεσι",703057,96],["φιλόστοργε",713497,719],["καὶ",707031,7],["τροφεία",712982,589],["καὶ",707031,7],["μητέρων",708892,65],["ἀδάμαστα",700226,720],["πάθη",709918,589]],"O holy nature and parental feeling, and reward of bringing up children, and unconquerable maternal affection!"],["14",[["καθένα",707200,721],["στρεβλούμενον",712155,464],["καὶ",707031,7],["φλεγόμενον",713518,464],["ὁρῶσα",709725,188],["μήτηρ",708892,12],["οὐ",709805,28],["μετεβάλλετο",708782,19],["διὰ",703417,0],["τὴν",709436,8],["εὐσέβειαν",705685,9]],"At the racking and roasting of each one of them, the observant mother was prevented by religion from changing."],["15",[["τὰς",709436,38],["σάρκας",711537,39],["τῶν",709436,43],["τέκνων",712761,44],["ἑώρα",709725,13],["περὶ",710285,0],["τὸ",709436,24],["πῦρ",711088,25],["τηκομένας",712839,714],["καὶ",707031,7],["τοὺς",709436,58],["τῶν",709436,80],["ποδῶν",710707,81],["καὶ",707031,7],["χειρῶν",713787,65],["δακτύλους",703259,57],["ἐπὶ",705080,0],["γῆς",703083,17],["σπαίροντας",711989,235],["καὶ",707031,7],["τὰς",709436,38],["τῶν",709436,130],["κεφαλῶν",707639,65],["μέχρι",708849,0],["τῶν",709436,130],["περὶ",710285,0],["τὰ",709436,41],["γένεια",703040,42],["σάρκας",711537,39],["ὥσπερ",714163,28],["προσωπεῖα",710985,42],["προκειμένας",710812,312]],"She beheld her children's flesh dissolving around the fire; and their extremities quivering on the ground, and the flesh of their heads dropped forwards down to their beards, like masks."],["16",[["ὦ",714081,88],["πικροτέρων",710475,527],["νῦν",709384,28],["πόνων",710661,81],["πειρασθεῖσα",710225,722],["μήτηρ",708892,258],["ἤπερ",706014,7],["τῶν",709436,130],["ἐπ᾿",705080,0],["αὐτοῖς",702165,151],["ὠδίνων",714094,65]],"O thou mother, who wast tried at this time with bitterer pangs than those of parturition!"],["17",[["ὦ",714081,88],["μόνη",709003,602],["γύναι",703209,258],["τὴν",709436,8],["εὐσέβειαν",705685,9],["ὁλόκληρον",709591,36],["ἀποκυήσασα",701499,723]],"O thou only woman who hast brought forth perfect holiness!"],["18",[["οὐ",709805,28],["μετέτρεψέν",708821,2],["σε",711598,163],["πρωτοτόκος",711046,14],["ἀποπνέων",701550,72],["οὐδὲ",709816,7],["δεύτερος",703389,14],["εἰς",704105,0],["σὲ",711598,163],["οἰκτρὸν",709524,27],["βλέπων",702740,72],["ἐν",704639,0],["βασάνοις",702570,76],["οὐ",709805,28],["τρίτος",712968,14],["ἀποψύχων",701642,72]],"Thy first-born, expiring, turned thee not; nor the second, looking miserable in his torments; nor the third, breathing out his soul."],["19",[["οὐδὲ",709816,7],["τοὺς",709436,58],["ὀφθαλμοὺς",709870,57],["ἑνὸς",704106,116],["ἑκάστου",704133,116],["θεωροῦσα",706226,188],["ταυρηδὸν",712733,28],["ἐπὶ",705080,0],["τῶν",709436,130],["βασάνων",702570,65],["ὁρῶντας",709725,235],["τὸν",709436,5],["αὐτὸν",702165,85],["αἰκισμὸν",700427,6],["καὶ",707031,7],["τοὺς",709436,58],["μυκτῆρας",709051,57],["προσημειουμένους",710902,236],["τὸν",709436,5],["θάνατον",706096,6],["αὐτῶν",702165,40],["οὐκ",709805,28],["ἔκλαυσας",707703,162]],"Nor when thou didst behold the eyes of each of them looking sternly upon their tortures, and their nostrils foreboding death, didst thou weep!"],["20",[["ἐπὶ",705080,0],["σαρξὶν",711537,76],["τέκνων",712761,44],["ὁρῶσα",709725,188],["σάρκας",711537,39],["τέκνων",712761,44],["ἀποκαιομένας",701471,312],["καὶ",707031,7],["ἐπὶ",705080,0],["χερσὶν",713787,76],["χεῖρας",713787,39],["ἀποτεμνομένας",701611,714],["καὶ",707031,7],["ἐπὶ",705080,0],["κεφαλαῖς",707639,76],["κεφαλὰς",707639,39],["ἀποδειροτομουμένας",701440,714],["καὶ",707031,7],["ἐπὶ",705080,0],["νεκροῖς",709247,148],["νεκροὺς",709247,57],["πίπτοντας",710481,235],["καὶ",707031,7],["πολυάνδριον",710621,25],["ὁρῶσα",709725,188],["τῶν",709436,43],["τέκνων",712761,44],["τὸ",709436,24],["χωρίον",714015,25],["διὰ",703417,0],["τῶν",709436,130],["βασάνων",702570,65],["οὐκ",709805,28],["ἐδάκρυσας",703256,162]],"When thou didst see children's flesh heaped upon children's flesh that had been torn off, hands upon hands cut off, heads decapitated upon heads, dead falling upon the dead, and a choir of children turned through torture into a burying-ground, thou lamentedst not."],["21",[["οὐχ",709805,28],["οὕτως",709859,28],["σειρήνιοι",711628,192],["μελῳδίαι",708722,191],["οὐδὲ",709816,7],["κύκνειοι",707962,138],["πρὸς",710844,0],["φιληκοΐαν",713472,9],["φωναὶ",713640,191],["τοὺς",709436,58],["ἀκούοντας",700587,235],["ἐφέλκονται",705745,269],["ὡς",714148,7],["τέκνων",712761,44],["φωναὶ",713640,191],["μετὰ",708780,0],["βασάνων",702570,65],["μητέρα",708892,9],["φωνούντων",713639,66]],"Not so do siren melodies, or songs of swans, attract the hearers to listening, O voices of children calling upon your mother in the midst of torments!"],["22",[["πηλίκαις",710455,291],["καὶ",707031,7],["πόσαις",710692,291],["τότε",712908,28],["ἡ",709436,10],["μήτηρ",708892,12],["τῶν",709436,80],["υἱῶν",713075,81],["βασανιζομένων",702566,682],["τροχοῖς",712994,148],["τε",712751,11],["καὶ",707031,7],["καυτηρίοις",707568,96],["ἐβασανίζετο",702566,530],["βασάνοις",702570,76]],"With what and what manner of torments was the mother herself tortured, as her sons were undergoing the wheel and the fires!"],["23",[["ἀλλὰ",700680,7],["τὰ",709436,41],["σπλάγχνα",712018,42],["αὐτῆς",702165,86],["ὁ",709436,3],["εὐσεβὴς",705687,14],["λογισμὸς",708234,4],["ἐν",704639,0],["αὐτοῖς",702165,206],["τοῖς",709436,95],["πάθεσιν",709918,96],["ἀνδρειώσας",701102,182],["ἐπέτεινεν",705296,2],["τὴν",709436,8],["πρόσκαιρον",710910,36],["φιλοτεκνίαν",713499,9],["παριδεῖν",710125,106]],"But religious reasoning, having strengthened her courage in the midst of sufferings, enabled her to forego, for the time, parental love."],["24",[["καίπερ",707045,7],["ἑπτὰ",705357,59],["τέκνων",712761,44],["ὁρῶσα",709725,188],["ἀπώλειαν",701660,9],["καὶ",707031,7],["τὴν",709436,8],["τῶν",709436,130],["στρεβλῶν",712153,65],["πολύπλοκον",710643,36],["ποικιλίαν",710586,9],["ἁπάσας",701362,119],["ἡ",709436,10],["γενναία",703048,29],["μήτηρ",708892,12],["ἐξέλυσεν",704254,2],["διὰ",703417,0],["τὴν",709436,8],["πρὸς",710844,0],["θεὸν",706192,6],["πίστιν",710484,9]],"Although beholding the destruction of seven children, the noble mother, after one embrace, stripped off [her feelings] through faith in God.",{"s":"d","q":0.62}],["25",[["καθάπερ",706984,28],["γὰρ",702963,11],["ἐν",704639,0],["βουλευτηρίῳ",702788,54],["τῇ",709436,100],["ἑαυτῆς",703917,86],["ψυχῇ",714070,1],["δεινοὺς",703328,60],["ὁρῶσα",709725,188],["συμβούλους",712295,57],["φύσιν",713633,9],["καὶ",707031,7],["γένεσιν",703043,9],["καὶ",707031,7],["φιλοτεκνίαν",713499,9],["καὶ",707031,7],["τέκνων",712761,44],["στρέβλας",712153,39]],"For just as in a council-room, beholding in her own soul vehement counsellors, nature and parentage and love of her children, and the racking of her children,"],["26",[["δύο",703849,59],["ψήφους",714052,39],["κρατοῦσα",707879,188],["μήτηρ",708892,12],["θανατηφόρον",706095,36],["τε",712751,11],["καὶ",707031,7],["σωτήριον",712659,36],["ὑπὲρ",713111,0],["τέκνων",712761,44]],"she holding two votes, one for the death, the other for the preservation of her children,"],["27",[["οὐκ",709805,28],["ἐπέγνω",705104,2],["τὴν",709436,8],["σῴζουσαν",712627,78],["ἑπτὰ",705357,59],["υἱοὺς",713075,57],["πρὸς",710844,0],["ὀλίγον",709568,27],["χρόνον",713969,6],["σωτηρίαν",712658,9]],"did not lean to that which would have saved her children for the safety of a brief space."],["28",[["ἀλλὰ",700680,7],["τῆς",709436,16],["θεοσεβοῦς",706194,82],["Αβρααμ",700091,18],["καρτερίας",707179,17],["ἡ",709436,10],["θυγάτηρ",706320,12],["ἐμνήσθη",708960,37]],"But this daughter of Abraham remembered his holy fortitude."],["29",[["ὦ",714081,88],["μήτηρ",708892,12],["ἔθνους",704068,21],["ἔκδικε",704177,602],["τοῦ",709436,35],["νόμου",709349,18],["καὶ",707031,7],["ὑπερασπίστρια",713124,258],["τῆς",709436,16],["εὐσεβείας",705685,17],["καὶ",707031,7],["τοῦ",709436,35],["διὰ",703417,0],["σπλάγχνων",712018,44],["ἀγῶνος",700211,18],["ἀθλοφόρε",700380,602]],"O mother of a nation, avenger of the law, and defender of religion, and prime bearer in the battle of the affections!"],["30",[["ὦ",714081,88],["ἀρρένων",701818,81],["πρὸς",710844,0],["καρτερίαν",707179,9],["γενναιοτέρα",703048,178],["καὶ",707031,7],["ἀνδρῶν",701150,81],["πρὸς",710844,0],["ὑπομονὴν",713226,9],["ἀνδρειοτέρα",701101,178]],"O thou nobler in endurance than males, and more manly than men in patience!"],["31",[["καθάπερ",706984,28],["γὰρ",702963,11],["ἡ",709436,10],["Νωε",709395,18],["κιβωτὸς",707667,12],["ἐν",704639,0],["τῷ",709436,113],["κοσμοπληθεῖ",707849,30],["κατακλυσμῷ",707279,114],["κοσμοφοροῦσα",707852,188],["καρτερῶς",707182,28],["ὑπέμεινεν",713219,2],["τοὺς",709436,58],["κλύδωνας",707744,57]],"For as the ark of Noah, bearing the world in the world-filling flood, bore up against the waves,"],["32",[["οὕτως",709859,28],["σὺ",712181,164],["ἡ",709436,10],["νομοφύλαξ",709350,12],["πανταχόθεν",709975,28],["ἐν",704639,0],["τῷ",709436,113],["τῶν",709436,43],["παθῶν",709918,44],["περιαντλουμένη",710289,211],["κατακλυσμῷ",707279,114],["καὶ",707031,7],["καρτεροῖς",707180,230],["ἀνέμοις",701123,148],["ταῖς",709436,75],["τῶν",709436,80],["υἱῶν",713075,81],["βασάνοις",702570,76],["συνεχομένη",712469,211],["γενναίως",703050,28],["ὑπέμεινας",713219,162],["τοὺς",709436,58],["ὑπὲρ",713111,0],["τῆς",709436,16],["εὐσεβείας",705685,17],["χειμῶνας",713786,57]],"so thou, the guardian of the law, when surrounded on every side by the flood of passions, and straitened by violent storms which were the torments of thy children, didst bear up nobly against the storms against religion."]]