[["1",[["ὦ",714081,88],["τῶν",709436,43],["Αβραμιαίων",700094,83],["σπερμάτων",712008,44],["ἀπόγονοι",701435,138],["παῖδες",709932,52],["Ισραηλῖται",706840,138],["πείθεσθε",710221,73],["τῷ",709436,113],["νόμῳ",709349,114],["τούτῳ",709858,50],["καὶ",707031,7],["πάντα",710177,27],["τρόπον",712980,6],["εὐσεβεῖτε",705686,335]],"O Israelitish children, descendants of the seed of Abraham, obey this law, and in every way be religious."],["2",[["γινώσκοντες",703105,146],["ὅτι",709803,7],["τῶν",709436,43],["παθῶν",709918,44],["ἐστιν",704093,91],["δεσπότης",703379,4],["ὁ",709436,3],["εὐσεβὴς",705687,14],["λογισμὸς",708234,4],["καὶ",707031,7],["οὐ",709805,28],["μόνον",709001,28],["τῶν",709436,80],["ἔνδοθεν",704691,28],["ἀλλὰ",700680,7],["καὶ",707031,28],["τῶν",709436,80],["ἔξωθεν",704984,28],["πόνων",710661,81]],"Knowing that religious reasoning is lord of the passions, and those not only inward but outward."],["3",[["ἀνθ᾿",701227,0],["ὧν",709781,252],["διὰ",703417,0],["τὴν",709436,8],["εὐσέβειαν",705685,9],["προέμενοι",710802,317],["τὰ",709436,41],["σώματα",712635,42],["τοῖς",709436,147],["πόνοις",710661,148],["ἐκεῖνοι",704183,201],["οὐ",709805,28],["μόνον",709001,28],["ὑπὸ",713184,0],["τῶν",709436,80],["ἀνθρώπων",701163,81],["ἐθαυμάσθησαν",706135,99],["ἀλλὰ",700680,7],["καὶ",707031,28],["θείας",706154,82],["μερίδος",708748,17],["κατηξιώθησαν",707353,99]],"Whence those persons giving up their bodies to pains for the sake of religion, were not only admired by men, but were deemed worthy of a divine portion."],["4",[["καὶ",707031,7],["δι᾿",703417,0],["αὐτοὺς",702165,62],["εἰρήνευσεν",704097,2],["τὸ",709436,24],["ἔθνος",704068,25],["καὶ",707031,7],["τὴν",709436,8],["εὐνομίαν",705649,9],["τὴν",709436,8],["ἐπὶ",705080,0],["τῆς",709436,16],["πατρίδος",710196,17],["ἀνανεωσάμενοι",701011,317],["ἐκπεπόρθηκαν",704294,353],["τοὺς",709436,58],["πολεμίους",710603,60]],"And the nation through them obtained peace, and having renewed the observance of the law in their country, drove the enemy out of the land."],["5",[["καὶ",707031,7],["ὁ",709436,3],["τύραννος",713026,4],["Ἀντίοχος",701257,4],["καὶ",707031,28],["ἐπὶ",705080,0],["γῆς",703083,17],["τετιμώρηται",712861,403],["καὶ",707031,7],["ἀποθανὼν",701461,182],["κολάζεται",707786,391],["ὡς",714148,7],["γὰρ",702963,11],["οὐδὲν",709817,46],["οὐδαμῶς",709814,28],["ἴσχυσεν",706859,2],["ἀναγκάσαι",700923,106],["τοὺς",709436,58],["Ιεροσολυμίτας",706635,57],["ἀλλοφυλῆσαι",700704,106],["καὶ",707031,7],["τῶν",709436,80],["πατρίων",710195,169],["ἐθῶν",704069,44],["ἐκδιαιτηθῆναι",704169,179],["τότε",712908,28],["ἀπάρας",701329,182],["ἀπὸ",701425,0],["τῶν",709436,80],["Ιεροσολύμων",706636,81],["ἐστράτευσεν",712140,2],["ἐπὶ",705080,0],["Πέρσας",710431,303]],"And the tyrant Antiochus was both punished upon earth, and is punished now he is dead; for when he was quite unable to compel the Israelites to adopt foreign customs, and to desert the manner of life of their fathers,"],["6",[["ἔλεγεν",708124,13],["δὲ",703303,11],["ἡ",709436,10],["μήτηρ",708892,12],["τῶν",709436,80],["ἑπτὰ",705357,59],["παίδων",709932,81],["καὶ",707031,7],["ταῦτα",709858,71],["τὰ",709436,41],["δικαιώματα",703697,42],["τοῖς",709436,95],["τέκνοις",712761,96]],"then, departing from Jerusalem, he made war against the Persians."],["7",[["ὅτι",709803,7],["ἐγὼ",704018,164],["ἐγενήθην",703104,156],["παρθένος",710148,12],["ἁγνὴ",700178,29],["οὐδὲ",709816,7],["ὑπερέβην",713125,155],["πατρικὸν",710194,27],["οἶκον",709516,6],["ἐφύλασσον",713619,137],["δὲ",703303,11],["τὴν",709436,8],["ᾠκοδομημένην",714104,725],["πλευράν",710524,9]],"And the righteous mother of the seven children spake also as follows to her offspring: I was a pure virgin, and went not beyond my father's house; but I took care of the built-up rib."],["8",[["οὐδὲ",709816,7],["ἔφθειρέν",713445,13],["με",708618,163],["λυμεὼν",708271,4],["ἐρημίας",705417,17],["φθορεὺς",713452,4],["ἐν",704639,0],["πεδίῳ",710215,54],["οὐδὲ",709816,7],["ἐλυμήνατό",708270,23],["μου",709032,133],["τὰ",709436,41],["ἁγνὰ",700178,68],["τῆς",709436,16],["παρθενίας",710146,17],["λυμεὼν",708271,4],["ἀπάτης",701365,17],["ὄφις",709875,4]],"No destroyer of the desert, [or] ravisher of the plain, injured me; nor did the destructive, deceitful, snake, make spoil of my chaste virginity; and I remained with my husband during the period of my prime."],["9",[["ἔμεινα",708736,155],["δὲ",703303,11],["χρόνον",713969,6],["ἀκμῆς",700559,17],["σὺν",712372,0],["ἀνδρί",701150,114],["τούτων",709858,40],["δὲ",703303,11],["ἐνηλίκων",704729,81],["γενομένων",703104,490],["ἐτελεύτησεν",712781,2],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτῶν",702165,40],["μακάριος",708397,14],["μὲν",708730,11],["ἐκεῖνος",704183,121],["τὸν",709436,5],["γὰρ",702963,11],["τῆς",709436,16],["εὐτεκνίας",705704,17],["βίον",702724,6],["ἐπιζήσας",705132,182],["τὸν",709436,5],["τῆς",709436,16],["ἀτεκνίας",702079,17],["οὐκ",709805,28],["ὠδυνήθη",709462,37],["καιρόν",707047,6]],"And these my children, having arrived at maturity, their father died: blessed was he! for having sought out a life of fertility in children, he was not grieved with a period of loss of children."],["10",[["ὃς",709781,213],["ἐδίδασκεν",703649,13],["ὑμᾶς",713080,194],["ἔτι",705538,28],["ὢν",704093,72],["σὺν",712372,0],["ὑμῖν",713084,90],["τὸν",709436,5],["νόμον",709349,6],["καὶ",707031,7],["τοὺς",709436,58],["προφήτας",711009,57]],"And he used to teach you, when yet with you, the law and the prophets."],["11",[["τὸν",709436,5],["ἀναιρεθέντα",700962,260],["Αβελ",700040,6],["ὑπὸ",713184,0],["Καιν",707035,18],["ἀνεγίνωσκέν",700922,13],["τε",712751,11],["ὑμῖν",713084,90],["καὶ",707031,7],["τὸν",709436,5],["ὁλοκαρπούμενον",709585,464],["Ισαακ",706799,6],["καὶ",707031,7],["τὸν",709436,5],["ἐν",704639,0],["φυλακῇ",713613,1],["Ιωσηφ",706948,6]],"He used to read to you the slaying of Abel by Cain, and the offering up of Isaac, and the imprisonment of Joseph."],["12",[["ἔλεγεν",708124,13],["δὲ",703303,11],["ὑμῖν",713084,90],["τὸν",709436,5],["ζηλωτὴν",705876,36],["Φινεες",713510,18],["ἐδίδασκέν",703649,13],["τε",712751,11],["ὑμᾶς",713080,194],["τοὺς",709436,58],["ἐν",704639,0],["πυρὶ",711088,54],["Ανανιαν",701016,6],["καὶ",707031,7],["Αζαριαν",700328,6],["καὶ",707031,7],["Μισαηλ",708930,6]],"And he used to tell you of the zealous Phinehas; and informed you of Ananias and Azarias, and Misael in the fire."],["13",[["ἐδόξαζεν",703792,13],["δὲ",703303,11],["καὶ",707031,28],["τὸν",709436,5],["ἐν",704639,0],["λάκκῳ",708067,114],["λεόντων",708171,81],["Δανιηλ",703283,6],["ὃν",709781,112],["ἐμακάριζεν",708396,13]],"And he used to glorify Daniel, who was in the den of lions, and pronounce him blessed."],["14",[["ὑπεμίμνῃσκεν",713220,13],["δὲ",703303,11],["ὑμᾶς",713080,194],["καὶ",707031,28],["τὴν",709436,8],["Ησαιου",706026,18],["γραφὴν",703191,9],["τὴν",709436,8],["λέγουσαν",708124,78],["κἂν",707120,459],["διὰ",703417,0],["πυρὸς",711088,21],["διέλθῃς",703673,175],["φλὸξ",713524,12],["οὐ",709805,28],["κατακαύσει",707258,127],["σε",711598,163]],"And he used to put you in mind of the scripture of Esaias, which saith, Even if thou pass through the fire, it shall not burn thee."],["15",[["τὸν",709436,5],["ὑμνογράφον",713088,6],["ἐμελῴδει",708721,13],["ὑμῖν",713084,90],["Δαυιδ",703232,6],["λέγοντα",708124,183],["πολλαὶ",710646,192],["αἱ",709436,190],["θλίψεις",706276,191],["τῶν",709436,80],["δικαίων",703694,169]],"He chanted to you David, the hymn-writer, who saith, Many are the afflictions of the just."],["16",[["τὸν",709436,5],["Σαλωμῶντα",711432,6],["ἐπαροιμίαζεν",710161,13],["ὑμῖν",713084,90],["λέγοντα",708124,183],["ξύλον",709427,15],["ζωῆς",705910,17],["ἐστιν",704093,91],["τοῖς",709436,147],["ποιοῦσιν",710582,197],["αὐτοῦ",702165,102],["τὸ",709436,24],["θέλημα",706170,25]],"He declared the proverbs of Solomon, who saith, He is a tree of life to all those who do His will."],["17",[["τὸν",709436,5],["Ιεζεκιηλ",706539,6],["ἐπιστοποίει",710485,13],["τὸν",709436,5],["λέγοντα",708124,183],["εἰ",704071,7],["ζήσεται",705851,93],["τὰ",709436,63],["ὀστᾶ",709792,64],["τὰ",709436,63],["ξηρὰ",709421,195],["ταῦτα",709858,290]],"He used to verify Ezekiel, who said, Shall these dry bones live?"],["18",[["ᾠδὴν",714091,9],["μὲν",708730,11],["γάρ",702963,11],["ἣν",709781,131],["ἐδίδαξεν",703649,2],["Μωυσῆς",709112,4],["οὐκ",709805,28],["ἐπελάθετο",705187,23],["διδάσκων",703649,72],["τὴν",709436,8],["λέγουσαν",708124,78]],"For he did not forget the song which Moses taught, proclaiming, I will kill, and I will make to live."],["19",[["ἐγὼ",704018,164],["ἀποκτενῶ",701498,165],["καὶ",707031,7],["ζῆν",705851,55],["ποιήσω",710582,207],["αὕτη",709858,107],["ἡ",709436,10],["ζωὴ",705910,12],["ὑμῶν",713091,145],["καὶ",707031,7],["ἡ",709436,10],["μακρότης",708423,12],["τῶν",709436,130],["ἡμερῶν",705984,65]],"This is our life, and the length of our days."],["20",[["ὦ",714081,88],["πικρᾶς",710475,82],["τῆς",709436,16],["τότε",712908,28],["ἡμέρας",705984,17],["καὶ",707031,7],["οὐ",709805,28],["πικρᾶς",710475,82],["ὅτε",709802,28],["ὁ",709436,3],["πικρὸς",710475,14],["Ἑλλήνων",704515,286],["τύραννος",713026,4],["πῦρ",711088,25],["πυρὶ",711088,54],["σβέσας",711596,182],["λέβησιν",708121,148],["ὠμοῖς",714114,148],["καὶ",707031,7],["ζέουσι",705869,349],["θυμοῖς",706334,148],["ἀγαγὼν",700209,182],["ἐπὶ",705080,0],["τὸν",709436,5],["καταπέλτην",707357,6],["καὶ",707031,7],["πάλιν",709942,28],["τὰς",709436,38],["βασάνους",702570,39],["αὐτοῦ",702165,102],["τοὺς",709436,58],["ἑπτὰ",705357,59],["παῖδας",709932,57],["τῆς",709436,16],["Αβρααμίτιδος",700092,17]],"O that bitter, and yet not bitter, day when the bitter tyrant of the Greeks, quenching fire with fire in his cruel caldrons, brought with boiling rage the seven sons of the daughter of Abraham to the catapelt, and to all his torments!"],["21",[["τὰς",709436,38],["τῶν",709436,43],["ὀμμάτων",709616,44],["κόρας",707836,39],["ἐπήρωσεν",710461,2],["καὶ",707031,7],["γλώσσας",703120,39],["ἐξέτεμεν",704324,2],["καὶ",707031,7],["βασάνοις",702570,76],["ποικίλαις",710589,291],["ἀπέκτεινεν",701498,2]],"He pierced the balls of their eyes, and cut out their tongues, and put them to death with varied tortures."],["22",[["ὑπὲρ",713111,0],["ὧν",709781,199],["ἡ",709436,10],["θεία",706154,29],["δίκη",703702,12],["μετῆλθεν",708827,2],["καὶ",707031,7],["μετελεύσεται",708827,93],["τὸν",709436,5],["ἀλάστορα",700636,6],["τύραννον",713026,6]],"Wherefore divine retribution pursued and will pursue the pestilent wretch."],["23",[["οἱ",709436,136],["δὲ",703303,11],["Αβραμιαῖοι",700094,138],["παῖδες",709932,52],["σὺν",712372,0],["τῇ",709436,100],["ἀθλοφόρῳ",700380,101],["μητρὶ",708892,1],["εἰς",704105,0],["πατέρων",710189,81],["χορὸν",713915,6],["συναγελάζονται",712373,699],["ψυχὰς",714070,39],["ἁγνὰς",700178,119],["καὶ",707031,7],["ἀθανάτους",700358,119],["ἀπειληφότες",701504,268],["παρὰ",709995,0],["τοῦ",709436,35],["θεοῦ",706192,18]],"But the children of Abraham, with their victorious mother, are assembled together to the choir of their fathers; having received pure and immortal souls from God."],["24",[["ᾧ",709781,309],["ἡ",709436,10],["δόξα",703791,12],["εἰς",704105,0],["τοὺς",709436,58],["αἰῶνας",700504,57],["τῶν",709436,80],["αἰώνων",700504,81],["αμην",700818,88]],"To whom be glory for ever and ever. Amen."]]