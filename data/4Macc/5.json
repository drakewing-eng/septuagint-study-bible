[["1",[["προκαθίσας",710806,182],["γέ",702985,11],["τοι",712873,11],["μετὰ",708780,0],["τῶν",709436,80],["συνέδρων",712430,81],["ὁ",709436,3],["τύραννος",713026,4],["Ἀντίοχος",701257,4],["ἐπί",705080,0],["τινος",712866,308],["ὑψηλοῦ",713285,116],["τόπου",712903,18],["καὶ",707031,7],["τῶν",709436,43],["στρατευμάτων",712139,44],["αὐτῷ",702165,50],["παρεστηκότων",710152,461],["κυκλόθεν",707956,28],["ἐνόπλων",704776,83]],"The tyrant Antiochus, therefore, sitting in public state with his assessors upon a certain lofty place, with his armed troops standing in a circle round him,",{"s":"d","q":0.63}],["2",[["παρεκέλευεν",710045,13],["τοῖς",709436,147],["δορυφόροις",703807,148],["ἕνα",704106,27],["ἕκαστον",704133,27],["Εβραῖον",703933,6],["ἐπισπᾶσθαι",705258,110],["καὶ",707031,7],["κρεῶν",707889,44],["ὑείων",713072,83],["καὶ",707031,7],["εἰδωλοθύτων",704078,83],["ἀναγκάζειν",700923,55],["ἀπογεύεσθαι",701433,110]],"commanded his spearbearers to seize every one of the Hebrews, and to compel them to taste swine's flesh, and things offered to idols.",{"s":"d","q":0.57}],["3",[["εἰ",704071,7],["δέ",703303,11],["τινες",712866,392],["μὴ",708851,28],["θέλοιεν",706176,701],["μιαροφαγῆσαι",708907,106],["τούτους",709858,62],["τροχισθέντας",712991,460],["ἀναιρεθῆναι",700962,179]],"And should any of them be unwilling to eat the accursed food, they were to be tortured on the wheel, and so killed."],["4",[["πολλῶν",710646,169],["δὲ",703303,11],["συναρπασθέντων",712406,249],["εἷς",704106,596],["πρῶτος",711041,140],["ἐκ",704132,0],["τῆς",709436,16],["ἀγέλης",700148,17],["ὀνόματι",709666,54],["Ελεαζαρος",704408,4],["τὸ",709436,34],["γένος",703057,15],["ἱερεύς",706614,4],["τὴν",709436,8],["ἐπιστήμην",705267,9],["νομικὸς",709339,14],["καὶ",707031,7],["τὴν",709436,8],["ἡλικίαν",705971,9],["προήκων",710794,72],["καὶ",707031,7],["πολλοῖς",710646,230],["τῶν",709436,80],["περὶ",710285,0],["τὸν",709436,5],["τύραννον",713026,6],["διὰ",703417,0],["τὴν",709436,8],["ἡλικίαν",705971,9],["γνώριμος",703136,14],["παρήχθη",710007,37],["πλησίον",710547,28],["αὐτοῦ",702165,102]],"And when many had been seized, a foremost man of the assembly, a Hebrew, by name Eleazar, a priest by family, by profession a lawyer, and advanced in years, and for this reason known to many of the king's followers, was brought near to him."],["5",[["καὶ",707031,7],["αὐτὸν",702165,85],["ἰδὼν",709725,182],["ὁ",709436,3],["Ἀντίοχος",701257,4],["ἔφη",713437,13]],"And Antiochus seeing him, said,"],["6",[["ἐγὼ",704018,164],["πρὶν",710742,28],["ἄρξασθαι",701860,109],["τῶν",709436,130],["κατὰ",707200,0],["σοῦ",711945,133],["βασάνων",702570,65],["ὦ",714081,88],["πρεσβῦτα",710736,153],["συμβουλεύσαιμ᾿",712292,346],["ἄν",700900,11],["σοι",711925,159],["ταῦτα",709858,71],["ὅπως",709719,7],["ἀπογευσάμενος",701433,248],["τῶν",709436,43],["ὑείων",713072,83],["σῴζοιο",712627,703]],null,{"s":"j","with":"5:7"}],["7",[["αἰδοῦμαι",700404,254],["γάρ",702963,11],["σου",711945,133],["τὴν",709436,8],["ἡλικίαν",705971,9],["καὶ",707031,7],["τὴν",709436,8],["πολιάν",710607,9],["ἣν",709781,131],["μετὰ",708780,0],["τοσοῦτον",712907,27],["ἔχων",705785,72],["χρόνον",713969,6],["οὔ",709805,28],["μοι",708974,159],["δοκεῖς",703775,154],["φιλοσοφεῖν",713493,55],["τῇ",709436,100],["Ιουδαίων",706772,81],["χρώμενος",713936,122],["θρησκείᾳ",706310,1]],"I would counsel thee, old man, before thy tortures begin, to taste the swine's flesh, and save your life; for I feel respect for your age and hoary head, which since you have had so long, you appear to me to be no philosopher in retaining the superstition of the Jews.",{"s":"m","br":"5:6","q":0.54,"gd":0.53}],["8",[["διὰ",703417,0],["τί",712867,126],["γὰρ",702963,11],["τῆς",709436,16],["φύσεως",713633,17],["κεχαρισμένης",713734,446],["καλλίστην",707097,506],["τὴν",709436,8],["τοῦδε",709446,102],["τοῦ",709436,20],["ζῴου",705916,21],["σαρκοφαγίαν",711536,9],["βδελύττῃ",702608,278]],"For wherefore, since nature has conferred upon you the most excellent flesh of this animal, do you loathe it?",{"s":"m","br":"5:7","q":0.85}],["9",[["καὶ",707031,7],["γὰρ",702963,11],["ἀνόητον",701184,26],["τοῦτο",709858,132],["τὸ",709436,34],["μὴ",708851,28],["ἀπολαύειν",701506,55],["τῶν",709436,80],["χωρὶς",714016,28],["ὀνείδους",709658,21],["ἡδέων",705945,169],["καὶ",707031,7],["ἄδικον",700272,26],["ἀποστρέφεσθαι",701598,110],["τὰς",709436,38],["τῆς",709436,16],["φύσεως",713633,17],["χάριτας",713735,39]],"It seems senseless not to enjoy what is pleasant, yet not disgraceful; and from notions of sinfulness, to reject the boons of nature.",{"s":"m","br":"5:8","q":0.95}],["10",[["σὺ",712181,164],["δέ",703303,11],["μοι",708974,159],["καὶ",707031,28],["ἀνοητότερον",701184,385],["ποιήσειν",710582,296],["δοκεῖς",703775,154],["εἰ",704071,7],["κενοδοξῶν",707609,72],["περὶ",710285,0],["τὸ",709436,24],["ἀληθὲς",700658,46],["ἔτι",705538,28],["κἀμοῦ",707034,704],["καταφρονήσεις",707482,166],["ἐπὶ",705080,0],["τῇ",709436,100],["ἰδίᾳ",706493,101],["τιμωρίᾳ",712863,1]],"And you will be acting, I think, still more senselessly, if you follow vain conceits about the truth. And you will, moreover, be despising me to your own punishment.",{"s":"m","br":"5:9 5:10","q":0.73}],["11",[["οὐκ",709805,28],["ἐξυπνώσεις",704981,166],["ἀπὸ",701425,0],["τῆς",709436,16],["φλυάρου",713525,18],["φιλοσοφίας",713494,17],["ὑμῶν",713091,145],["καὶ",707031,7],["ἀποσκεδάσεις",701571,166],["τῶν",709436,80],["λογισμῶν",708234,81],["σου",711945,133],["τὸν",709436,5],["λῆρον",708177,6],["καὶ",707031,7],["ἄξιον",701308,27],["τῆς",709436,16],["ἡλικίας",705971,17],["ἀναλαβὼν",700984,182],["νοῦν",709374,6],["φιλοσοφήσεις",713493,166],["τὴν",709436,8],["τοῦ",709436,35],["συμφέροντος",712353,152],["ἀλήθειαν",700656,9]],"Will you not awake from your trifling philosophy? and give up the folly of your notions; and, regaining understanding worthy of your age, search into the truth of an expedient course?",{"s":"d","q":0.68}],["12",[["καὶ",707031,7],["προσκυνήσας",710925,182],["μου",709032,133],["τὴν",709436,8],["φιλάνθρωπον",713463,36],["παρηγορίαν",710144,9],["οἰκτιρήσεις",709518,166],["τὸ",709436,24],["σεαυτοῦ",711599,102],["γῆρας",703089,25]],"and, reverencing my kindly admonition, have pity upon your own years?"],["13",[["καὶ",707031,7],["γὰρ",702963,11],["ἐνθυμήθητι",704739,244],["ὡς",714148,7],["εἰ",704071,7],["καί",707031,7],["τίς",712866,158],["ἐστιν",704093,91],["τῆσδε",709446,86],["τῆς",709436,16],["θρησκείας",706310,17],["ὑμῶν",713091,145],["ἐποπτικὴ",705351,29],["δύναμις",703839,12],["συγγνωμονήσειεν",712189,225],["ἄν",700900,11],["σοι",711925,159],["ἐπὶ",705080,0],["πάσῃ",710177,101],["δι᾿",703417,0],["ἀνάγκην",700925,9],["παρανομίᾳ",710079,1],["γινομένῃ",703104,585]],"For, bear in mind, that if there be any power which watches over this religion of yours, it will pardon you for all transgressions of the law which you commit through compulsion."],["14",[["τοῦτον",709858,85],["τὸν",709436,5],["τρόπον",712980,6],["ἐπὶ",705080,0],["τὴν",709436,8],["ἔκθεσμον",704196,36],["σαρκοφαγίαν",711536,9],["ἐποτρύνοντος",705354,152],["τοῦ",709436,35],["τυράννου",713026,18],["λόγον",708236,6],["ᾔτησεν",700489,2],["ὁ",709436,3],["Ελεαζαρος",704408,4]],"While the tyrant incited him in this manner to the unlawful eating of flesh, Eleazar begged permission to speak."],["15",[["καὶ",707031,7],["λαβὼν",708076,182],["τοῦ",709436,20],["λέγειν",708124,55],["ἐξουσίαν",704974,9],["ἤρξατο",701860,23],["δημηγορεῖν",703406,55],["οὕτως",709859,28]],"And having received power to speak, he began thus to deliver himself:"],["16",[["ἡμεῖς",705983,219],["Ἀντίοχε",701257,153],["θείῳ",706154,30],["πεπεισμένοι",710221,429],["νόμῳ",709349,114],["πολιτεύεσθαι",710615,110],["οὐδεμίαν",709817,36],["ἀνάγκην",700925,9],["βιαιοτέραν",702714,36],["εἶναι",704093,55],["νομίζομεν",709338,243],["τῆς",709436,16],["πρὸς",710844,0],["τὸν",709436,5],["νόμον",709349,6],["ἡμῶν",705999,145],["εὐπειθείας",705661,39]],"We, O Antiochus, who are persuaded that we live under a divine law, consider no compulsion to be so forcible as obedience to that law;"],["17",[["διὸ",703714,7],["δὴ",703395,11],["κατ᾿",707200,0],["οὐδένα",709817,27],["τρόπον",712980,6],["παρανομεῖν",710078,55],["ἀξιοῦμεν",701309,243]],"wherefore we consider that we ought not in any point to transgress the law."],["18",[["καίτοι",707048,7],["εἰ",704071,7],["κατὰ",707200,0],["ἀλήθειαν",700656,9],["μὴ",708851,28],["ἦν",704093,13],["ὁ",709436,3],["νόμος",709349,4],["ἡμῶν",705999,145],["ὡς",714148,7],["ὑπολαμβάνεις",713210,154],["θεῖος",706154,14],["ἄλλως",700711,28],["δὲ",703303,11],["ἐνομίζομεν",709338,421],["αὐτὸν",702165,85],["εἶναι",704093,55],["θεῖον",706154,27],["οὐδὲ",709816,7],["οὕτως",709859,28],["ἐξὸν",704910,32],["ἦν",704093,13],["ἡμῖν",705994,90],["τὴν",709436,8],["ἐπὶ",705080,0],["τῇ",709436,100],["εὐσεβείᾳ",705685,1],["δόξαν",703791,9],["ἀκυρῶσαι",700618,106]],"And indeed, were our law (as you suppose) not truly divine, and if we wrongly think it divine, we should have no right even in that case to destroy our sense of religion."],["19",[["μὴ",708851,28],["μικρὰν",708915,36],["οὖν",709835,11],["εἶναι",704093,55],["νομίσῃς",709338,175],["ταύτην",709858,104],["εἰ",704071,7],["μιαροφαγήσαιμεν",708907,383],["ἁμαρτίαν",700775,9]],"Think not eating the unclean, then, a trifling offence."],["20",[["τὸ",709436,34],["γὰρ",702963,11],["ἐπὶ",705080,0],["μικροῖς",708915,230],["καὶ",707031,7],["μεγάλοις",708653,230],["παρανομεῖν",710078,55],["ἰσοδύναμόν",706825,26],["ἐστιν",704093,91]],"For transgression of the law, whether in small or great matters, is of equal moment;"],["21",[["δι᾿",703417,0],["ἑκατέρου",704134,92],["γὰρ",702963,11],["ὡς",714148,7],["ὁμοίως",709630,28],["ὁ",709436,3],["νόμος",709349,4],["ὑπερηφανεῖται",713137,391]],"for in either case the law is equally slighted."],["22",[["χλευάζεις",713873,154],["δὲ",703303,11],["ἡμῶν",705999,145],["τὴν",709436,8],["φιλοσοφίαν",713494,9],["ὥσπερ",714163,28],["οὐ",709805,28],["μετὰ",708780,0],["εὐλογιστίας",705634,17],["ἐν",704639,0],["αὐτῇ",702165,105],["βιούντων",702727,170]],"But thou deridest our philosophy, as though we lived irrationally in it."],["23",[["σωφροσύνην",712674,9],["τε",712751,11],["γὰρ",702963,11],["ἡμᾶς",705981,194],["ἐκδιδάσκει",704170,91],["ὥστε",714164,7],["πασῶν",710177,198],["τῶν",709436,130],["ἡδονῶν",705942,65],["καὶ",707031,7],["ἐπιθυμιῶν",705147,65],["κρατεῖν",707879,55],["καὶ",707031,7],["ἀνδρείαν",701100,9],["ἐξασκεῖ",704885,91],["ὥστε",714164,7],["πάντα",710177,27],["πόνον",710661,6],["ἑκουσίως",704270,28],["ὑπομένειν",713219,55]],"Yet it instructs us in temperance, so that we are superior to all pleasures and lusts; and it exercises us in manliness, so that we cheerfully undergo every grievance."],["24",[["καὶ",707031,7],["δικαιοσύνην",703695,9],["παιδεύει",709926,91],["ὥστε",714164,7],["διὰ",703417,0],["πάντων",710177,83],["τῶν",709436,43],["ἠθῶν",705955,44],["ἰσονομεῖν",706828,55],["καὶ",707031,7],["εὐσέβειαν",705685,9],["ἐκδιδάσκει",704170,91],["ὥστε",714164,7],["μόνον",709001,28],["τὸν",709436,5],["ὄντα",704093,183],["θεὸν",706192,6],["σέβειν",711609,55],["μεγαλοπρεπῶς",708634,28]],"And it instructs us in justice, so that in all our dealings we render what is due; and it teaches us piety, so that we worship the one only God becomingly."],["25",[["διὸ",703714,7],["οὐ",709805,28],["μιαροφαγοῦμεν",708907,243],["πιστεύοντες",710483,146],["γὰρ",702963,11],["θεοῦ",706192,18],["καθεστάναι",707011,115],["τὸν",709436,5],["νόμον",709349,6],["οἴδαμεν",709492,314],["ὅτι",709803,7],["κατὰ",707200,0],["φύσιν",713633,9],["ἡμῖν",705994,90],["συμπαθεῖ",712316,91],["νομοθετῶν",709346,72],["ὁ",709436,3],["τοῦ",709436,35],["κόσμου",707851,18],["κτίστης",707941,4]],"Wherefore it is that we eat not the unclean; for believing that the law was established by God, we are convinced that the Creator of the world, in giving his laws, sympathises with our nature."],["26",[["τὰ",709436,41],["μὲν",708730,11],["οἰκειωθησόμενα",709495,705],["ἡμῶν",705999,145],["ταῖς",709436,75],["ψυχαῖς",714070,76],["ἐπέτρεψεν",705311,2],["ἐσθίειν",705495,55],["τὰ",709436,41],["δὲ",703303,11],["ἐναντιωθησόμενα",704657,705],["ἐκώλυσεν",708020,2],["σαρκοφαγεῖν",711535,55]],"Those things which are convenient to our souls, he has directed us to eat; but those which are repugnant to them, he has interdicted."],["27",[["τυραννικὸν",713024,26],["δὲ",703303,11],["οὐ",709805,28],["μόνον",709001,28],["ἀναγκάζειν",700923,55],["ἡμᾶς",705981,194],["παρανομεῖν",710078,55],["ἀλλὰ",700680,7],["καὶ",707031,28],["ἐσθίειν",705495,55],["ὅπως",709719,7],["τῇ",709436,100],["ἐχθίστῃ",705779,215],["ἡμῶν",705999,145],["μιαροφαγίᾳ",708908,1],["ταύτῃ",709858,105],["ἐπεγγελάσῃς",705052,175]],"But, tyrant-like, thou not only forcest us to break the law, but also to eat, that thou mayest ridicule us as we thus profanely eat:"],["28",[["ἀλλ᾿",700680,7],["οὐ",709805,28],["γελάσεις",703019,166],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["τοῦτον",709858,85],["τὸν",709436,5],["γέλωτα",703032,6]],"but thou shalt not have this cause of laughter against me;"],["29",[["οὔτε",709857,7],["τοὺς",709436,58],["ἱεροὺς",706633,60],["τῶν",709436,80],["προγόνων",710777,81],["περὶ",710285,0],["τοῦ",709436,20],["φυλάξαι",713619,106],["τὸν",709436,5],["νόμον",709349,6],["ὅρκους",709753,57],["οὐ",709805,28],["παρήσω",710149,165]],"nor will I transgress the sacred oaths of my forefathers to keep the law."],["30",[["οὐδ᾿",709816,7],["ἂν",700900,11],["ἐκκόψειάς",704225,657],["μου",709032,133],["τὰ",709436,41],["ὄμματα",709616,42],["καὶ",707031,7],["τὰ",709436,41],["σπλάγχνα",712018,42],["μου",709032,133],["τήξειας",712839,657]],"No, not if you pluck out my eyes, and consume my entrails."],["31",[["οὐχ",709805,28],["οὕτως",709859,28],["εἰμὶ",704093,157],["γέρων",703065,4],["ἐγὼ",704018,164],["καὶ",707031,7],["ἄνανδρος",701008,14],["ὥστε",714164,7],["μοι",708974,159],["διὰ",703417,0],["τὴν",709436,8],["εὐσέβειαν",705685,9],["μὴ",708851,28],["νεάζειν",709228,55],["τὸν",709436,5],["λογισμόν",708234,6]],"I am not so old, and void of manliness, but that my rational powers are youthful in defence of my religion."],["32",[["πρὸς",710844,0],["ταῦτα",709858,71],["τροχοὺς",712994,57],["εὐτρέπιζε",705712,13],["καὶ",707031,7],["τὸ",709436,24],["πῦρ",711088,25],["ἐκφύσα",704366,240],["σφοδρότερον",712587,61]],"Now then; prepare your wheels, and kindle a fiercer flame."],["33",[["οὐχ",709805,28],["οὕτως",709859,28],["οἰκτίρομαι",709518,254],["τὸ",709436,24],["ἐμαυτοῦ",704545,102],["γῆρας",703089,25],["ὥστε",714164,7],["δι᾿",703417,0],["ἐμαυτοῦ",704545,102],["τὸν",709436,5],["πάτριον",710195,27],["καταλῦσαι",707323,106],["νόμον",709349,6]],"I will not so compassionate my old age, as on my account to break the law of my country."],["34",[["οὐ",709805,28],["ψεύσομαί",714045,181],["σε",711598,163],["παιδευτὰ",709925,153],["νόμε",709349,153],["οὐδὲ",709816,7],["ἐξομοῦμαί",704958,181],["σε",711598,163],["φίλη",713492,29],["ἐγκράτεια",703987,12]],"I will not belie thee, O law, my instructor! or forsake thee, O beloved self-control."],["35",[["οὐδὲ",709816,7],["καταισχυνῶ",707257,157],["σε",711598,163],["φιλόσοφε",713495,153],["λόγε",708236,153],["οὐδὲ",709816,7],["ἐξαρνήσομαί",704879,181],["σε",711598,163],["ἱερωσύνη",706650,258],["τιμία",712858,602],["καὶ",707031,7],["νομοθεσίας",709344,17],["ἐπιστήμη",705267,258]],"I will not put thee to shame, O philosopher Reason; or deny thee, O honoured priesthood, and science of the law."],["36",[["οὐδὲ",709816,7],["μιανεῖς",708900,166],["μου",709032,133],["τὸ",709436,24],["σεμνὸν",711682,46],["γήρως",703089,21],["στόμα",712125,25],["οὐδὲ",709816,7],["νομίμου",709340,116],["βίου",702724,18],["ἡλικίαν",705971,9]],"Mouth! thou shalt not pollute my old age, nor the full stature of a perfect life."],["37",[["ἁγνόν",700178,27],["με",708618,163],["οἱ",709436,136],["πατέρες",710189,52],["εἰσδέξονται",704111,135],["μὴ",708851,28],["φοβηθέντα",713532,260],["σου",711945,133],["τὰς",709436,38],["μέχρι",708849,0],["θανάτου",706096,18],["ἀνάγκας",700925,39]],"My fathers shall receive me pure, not having quailed before your compulsion, though unto death."],["38",[["ἀσεβῶν",701909,169],["μὲν",708730,11],["γὰρ",702963,11],["τυραννήσεις",713023,166],["τῶν",709436,80],["δὲ",703303,11],["ἐμῶν",704578,169],["ὑπὲρ",713111,0],["τῆς",709436,16],["εὐσεβείας",705685,17],["λογισμῶν",708234,81],["οὔτε",709857,7],["λόγοις",708236,148],["δεσπόσεις",703376,166],["οὔτε",709857,7],["δι᾿",703417,0],["ἔργων",705396,44]],"For over the ungodly thou shalt tyrannize; but thou shalt not lord it over my thoughts about religion, either by thy arguments, or through deeds."]]