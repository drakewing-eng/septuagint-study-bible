[["1",[["ἔλεγον",708124,137],["δὲ",703303,11],["καὶ",707031,7],["τῶν",709436,80],["δορυφόρων",703807,81],["τινὲς",712866,392],["ὅτι",709803,7],["ὡς",714148,7],["ἔμελλεν",708705,13],["συλλαμβάνεσθαι",712262,395],["καὶ",707031,28],["αὐτὴ",702165,107],["πρὸς",710844,0],["θάνατον",706096,6],["ἵνα",706747,7],["μὴ",708851,28],["ψαύσειέν",714032,225],["τις",712866,158],["τοῦ",709436,20],["σώματος",712635,21],["αὐτῆς",702165,86],["ἑαυτὴν",703917,104],["ἔρριψε",711267,2],["κατὰ",707200,0],["τῆς",709436,16],["πυρᾶς",711089,17]],"And some of the spearbearers said, that when she herself was about to be seized for the purpose of being put to death, she threw herself upon the pile, rather than that they should touch her person."],["2",[["ὦ",714081,88],["μήτηρ",708892,12],["σὺν",712372,0],["ἑπτὰ",705357,59],["παισὶν",709932,148],["καταλύσασα",707323,149],["τὴν",709436,8],["τοῦ",709436,35],["τυράννου",713026,18],["βίαν",702712,9],["καὶ",707031,7],["ἀκυρώσασα",700618,149],["τὰς",709436,38],["κακὰς",707066,119],["ἐπινοίας",705215,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["δείξασα",703314,149],["τὴν",709436,8],["τῆς",709436,16],["πίστεως",710484,17],["γενναιότητα",703049,9]],"O thou mother, who together with seven children didst destroy the violence of the tyrant, and render void his wicked intentions, and exhibit the nobleness of faith!"],["3",[["καθάπερ",706984,28],["γὰρ",702963,11],["σὺ",712181,164],["στέγη",712057,12],["ἐπὶ",705080,0],["τοὺς",709436,58],["στύλους",712179,57],["τῶν",709436,80],["παίδων",709932,81],["γενναίως",703050,28],["ἱδρυμένη",706507,203],["ἀκλινὴς",700556,29],["ὑπήνεγκας",713256,162],["τὸν",709436,5],["διὰ",703417,0],["τῶν",709436,130],["βασάνων",702570,65],["σεισμόν",711632,6]],"For thou, as a house bravely built upon the pillar of thy children, didst bear without swaying, the shock of tortures."],["4",[["θάρρει",706122,240],["τοιγαροῦν",712874,11],["ὦ",714081,88],["μήτηρ",708892,12],["ἱερόψυχε",706646,602],["τὴν",709436,8],["ἐλπίδα",704530,9],["τῆς",709436,16],["ὑπομονῆς",713226,17],["βεβαίαν",702609,36],["ἔχουσα",705785,188],["πρὸς",710844,0],["τὸν",709436,5],["θεόν",706192,6]],"Be of good cheer, therefore, O holy-minded mother! holding the firm [substance of the] hope of your steadfastness with God."],["5",[["οὐχ",709805,28],["οὕτως",709859,28],["σελήνη",711650,12],["κατ᾿",707200,0],["οὐρανὸν",709844,6],["σὺν",712372,0],["ἄστροις",702024,96],["σεμνὴ",711682,29],["καθέστηκεν",707011,171],["ὡς",714148,7],["σὺ",712181,164],["τοὺς",709436,58],["ἰσαστέρους",706809,60],["ἑπτὰ",705357,59],["παῖδας",709932,57],["φωταγωγήσασα",713644,149],["πρὸς",710844,0],["τὴν",709436,8],["εὐσέβειαν",705685,9],["ἔντιμος",704798,29],["καθέστηκας",707011,266],["θεῷ",706192,114],["καὶ",707031,7],["ἐστήρισαι",712098,724],["σὺν",712372,0],["αὐτοῖς",702165,151],["ἐν",704639,0],["οὐρανῷ",709844,114]],"Not so gracious does the moon appear with the stars in heaven, as thou art established honourable before God, and fixed in the firmament with thy sons whom thou didst illuminate with religion to the stars."],["6",[["ἦν",704093,13],["γὰρ",702963,11],["ἡ",709436,10],["παιδοποιία",709930,12],["σου",711945,133],["ἀπὸ",701425,0],["Αβρααμ",700091,18],["τοῦ",709436,35],["πατρός",710189,18]],"For thy bearing of children was after the fashion of a child of Abraham."],["7",[["εἰ",704071,7],["δὲ",703303,11],["ἐξὸν",704910,32],["ἡμῖν",705994,90],["ἦν",704093,13],["ὥσπερ",714163,28],["ἐπί",705080,0],["τινος",712866,340],["ζωγραφῆσαι",705903,106],["τὴν",709436,8],["τῆς",709436,16],["εὐσεβείας",705685,17],["σου",711945,133],["ἱστορίαν",706849,9],["οὐκ",709805,28],["ἂν",700900,11],["ἔφριττον",713585,137],["οἱ",709436,136],["θεωροῦντες",706226,146],["ὁρῶντες",709725,146],["μητέρα",708892,9],["ἑπτὰ",705357,59],["τέκνων",712761,44],["δι᾿",703417,0],["εὐσέβειαν",705685,9],["ποικίλας",710589,119],["βασάνους",702570,39],["μέχρι",708849,0],["θανάτου",706096,18],["ὑπομείνασαν",713219,610]],"And, were it lawful for us to paint as on a tablet the religion of thy story, the spectators would not shudder at beholding the mother of seven children enduring for the sake of religion various tortures even unto death."],["8",[["καὶ",707031,7],["γὰρ",702963,11],["ἄξιον",701308,27],["ἦν",704093,13],["καὶ",707031,7],["ἐπ᾿",705080,0],["αὐτοῦ",702165,102],["τοῦ",709436,20],["ἐπιταφίου",705295,21],["ἀναγράψαι",700932,106],["καὶ",707031,7],["ταῦτα",709858,71],["τοῖς",709436,147],["ἀπὸ",701425,0],["τοῦ",709436,20],["ἔθνους",704068,21],["εἰς",704105,0],["μνείαν",708961,9],["λεγόμενα",708124,67]],"And it had been a worthy thing to have inscribed upon the tomb itself these words as a memorial to those of the nation,"],["9",[["ἐνταῦθα",704787,28],["γέρων",703065,4],["ἱερεὺς",706614,4],["καὶ",707031,7],["γυνὴ",703209,12],["γεραιὰ",703058,29],["καὶ",707031,7],["ἑπτὰ",705357,59],["παῖδες",709932,52],["ἐγκεκήδευνται",703974,408],["διὰ",703417,0],["τυράννου",713026,18],["βίαν",702712,9],["τὴν",709436,8],["Εβραίων",703933,81],["πολιτείαν",710613,9],["καταλῦσαι",707323,106],["θέλοντος",706176,152]],"Here an aged priest, and an aged woman, and seven sons, are buried through the violence of a tyrant, who wished to destroy the polity of the Hebrews."],["10",[["οἳ",709781,250],["καὶ",707031,7],["ἐξεδίκησαν",704174,150],["τὸ",709436,24],["γένος",703057,25],["εἰς",704105,0],["θεὸν",706192,6],["ἀφορῶντες",702224,146],["καὶ",707031,7],["μέχρι",708849,0],["θανάτου",706096,18],["τὰς",709436,38],["βασάνους",702570,39],["ὑπομείναντες",713219,196]],"These also avenged their nation, looking unto God, and enduring torments unto death."],["11",[["ἀληθῶς",700662,28],["γὰρ",702963,11],["ἦν",704093,13],["ἀγὼν",700211,4],["θεῖος",706154,14],["ὁ",709436,3],["δι᾿",703417,0],["αὐτῶν",702165,40],["γεγενημένος",703104,419]],"For it was a truly divine contest which was carried through by them."],["12",[["ἠθλοθέτει",700378,13],["γὰρ",702963,11],["τότε",712908,28],["ἀρετὴ",701727,12],["δι᾿",703417,0],["ὑπομονῆς",713226,17],["δοκιμάζουσα",703776,188],["τὸ",709436,24],["νῖκος",709311,25],["ἀφθαρσία",702205,12],["ἐν",704639,0],["ζωῇ",705910,1],["πολυχρονίῳ",710652,101]],"For at that time virtue presided over the contest, approving the victory through endurance, namely, immortality, eternal life."],["13",[["Ελεαζαρ",704408,4],["δὲ",703303,11],["προηγωνίζετο",710749,19],["ἡ",709436,10],["δὲ",703303,11],["μήτηρ",708892,12],["τῶν",709436,80],["ἑπτὰ",705357,59],["παίδων",709932,81],["ἐνήθλει",704645,13],["οἱ",709436,136],["δὲ",703303,11],["ἀδελφοὶ",700249,52],["ἠγωνίζοντο",700214,139]],"Eleazar was the first to contend: and the mother of the seven children entered the contest; and the brethren contended."],["14",[["ὁ",709436,3],["τύραννος",713026,4],["ἀντηγωνίζετο",701205,19],["ὁ",709436,3],["δὲ",703303,11],["κόσμος",707851,4],["καὶ",707031,7],["ὁ",709436,3],["τῶν",709436,80],["ἀνθρώπων",701163,81],["βίος",702724,4],["ἐθεώρει",706226,13]],"The tyrant was the opposite; and the world and living men were the spectators."],["15",[["θεοσέβεια",706193,12],["δὲ",703303,11],["ἐνίκα",709309,13],["τοὺς",709436,58],["ἑαυτῆς",703917,86],["ἀθλητὰς",700376,57],["στεφανοῦσα",712084,188]],"And reverence for God conquered, and crowned her own athletes."],["16",[["τίνες",712867,392],["οὐκ",709805,28],["ἐθαύμασαν",706135,150],["τοὺς",709436,58],["τῆς",709436,16],["θείας",706154,82],["νομοθεσίας",709344,17],["ἀθλητάς",700376,57],["τίνες",712867,392],["οὐκ",709805,28],["ἐξεπλάγησαν",704287,99]],"Who did not admire those champions of true legislation? who were not astonied?"],["17",[["αὐτός",702165,121],["γέ",702985,11],["τοι",712873,11],["ὁ",709436,3],["τύραννος",713026,4],["καὶ",707031,7],["ὅλον",709597,46],["τὸ",709436,24],["συμβούλιον",712294,25],["ἐθαύμασαν",706135,150],["αὐτῶν",702165,40],["τὴν",709436,8],["ὑπομονήν",713226,9]],"The tyrant himself, and all their council, admired their endurance;"],["18",[["δι᾿",703417,0],["ἣν",709781,131],["καὶ",707031,7],["τῷ",709436,113],["θείῳ",706154,30],["νῦν",709384,28],["παρεστήκασιν",710152,353],["θρόνῳ",706315,114],["καὶ",707031,7],["τὸν",709436,5],["μακάριον",708397,27],["βιοῦσιν",702727,197],["αἰῶνα",700504,6]],"through which, also, they now stand beside the divine throne, and live a blessed life."],["19",[["καὶ",707031,7],["γάρ",702963,11],["φησιν",713437,91],["ὁ",709436,3],["Μωυσῆς",709112,4],["καὶ",707031,28],["πάντες",710177,138],["οἱ",709436,136],["ἡγιασμένοι",700153,429],["ὑπὸ",713184,0],["τὰς",709436,38],["χεῖράς",713787,39],["σου",711945,133]],"For Moses saith, And all the saints are under thy hands."],["20",[["καὶ",707031,7],["οὗτοι",709858,201],["οὖν",709835,11],["ἁγιασθέντες",700153,247],["διὰ",703417,0],["θεὸν",706192,6],["τετίμηνται",712855,408],["οὐ",709805,28],["μόνον",709001,28],["ταύτῃ",709858,105],["τῇ",709436,100],["τιμῇ",712856,1],["ἀλλὰ",700680,7],["καὶ",707031,28],["τῷ",709436,113],["δι᾿",703417,0],["αὐτοὺς",702165,62],["τὸ",709436,24],["ἔθνος",704068,25],["ἡμῶν",705999,145],["τοὺς",709436,58],["πολεμίους",710603,60],["μὴ",708851,28],["ἐπικρατῆσαι",705176,106]],"These, therefore, having been sanctified through God, have been honoured not only with this honour, but that also by their means the enemy did not overcome our nation;"],["21",[["καὶ",707031,7],["τὸν",709436,5],["τύραννον",713026,6],["τιμωρηθῆναι",712861,179],["καὶ",707031,7],["τὴν",709436,8],["πατρίδα",710196,9],["καθαρισθῆναι",706985,179],["ὥσπερ",714163,28],["ἀντίψυχον",701280,26],["γεγονότας",703104,277],["τῆς",709436,16],["τοῦ",709436,20],["ἔθνους",704068,21],["ἁμαρτίας",700775,17]],"and that the tyrant was punished, and their country purified."],["22",[["καὶ",707031,7],["διὰ",703417,0],["τοῦ",709436,20],["αἵματος",700442,21],["τῶν",709436,80],["εὐσεβῶν",705687,169],["ἐκείνων",704183,40],["καὶ",707031,7],["τοῦ",709436,20],["ἱλαστηρίου",706730,21],["τοῦ",709436,35],["θανάτου",706096,18],["αὐτῶν",702165,40],["ἡ",709436,10],["θεία",706154,29],["πρόνοια",710825,12],["τὸν",709436,5],["Ισραηλ",706839,6],["προκακωθέντα",710807,260],["διέσωσεν",703599,2]],"For they became the antipoise to the sin of the nation; and the Divine Providence saved Israel, aforetime afflicted, by the blood of those pious ones, and their propitiatory death."],["23",[["πρὸς",710844,0],["γὰρ",702963,11],["τὴν",709436,8],["ἀνδρείαν",701101,36],["αὐτῶν",702165,40],["τῆς",709436,16],["ἀρετῆς",701727,17],["καὶ",707031,7],["τὴν",709436,8],["ἐπὶ",705080,0],["ταῖς",709436,75],["βασάνοις",702570,76],["αὐτῶν",702165,40],["ὑπομονὴν",713226,9],["ὁ",709436,3],["τύραννος",713026,4],["ἀπιδὼν",702224,182],["ἀνεκήρυξεν",700971,2],["ὁ",709436,3],["Ἀντίοχος",701257,4],["τοῖς",709436,147],["στρατιώταις",712146,148],["αὐτοῦ",702165,102],["εἰς",704105,0],["ὑπόδειγμα",713191,25],["τὴν",709436,8],["ἐκείνων",704183,40],["ὑπομονὴν",713226,9]],"For the tyrant Antiochus, looking to their manly virtue, and to their endurance in torture, proclaimed that endurance as an example to his soldiers."],["24",[["ἔσχεν",705785,2],["τε",712751,11],["αὐτοὺς",702165,62],["γενναίους",703048,60],["καὶ",707031,7],["ἀνδρείους",701101,60],["εἰς",704105,0],["πεζομαχίαν",710218,9],["καὶ",707031,7],["πολιορκίαν",710610,9],["καὶ",707031,7],["ἐκπορθήσας",704294,182],["ἐνίκησεν",709309,2],["πάντας",710177,60],["τοὺς",709436,58],["πολεμίους",710603,60]],"And they proved to be to him noble and brave for land battles and sieges; and he conquered and stormed the towns of all his enemies."]]