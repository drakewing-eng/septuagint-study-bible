[["1",[["τί",712867,126],["μέλλεις",708705,154],["ὦ",714081,88],["τύραννε",713026,153],["ἕτοιμοι",705541,138],["γάρ",702963,11],["ἐσμεν",704093,243],["ἀποθνῄσκειν",701461,55],["ἢ",705924,7],["παραβαίνειν",709996,55],["τὰς",709436,38],["πατρίους",710195,119],["ἡμῶν",705999,145],["ἐντολάς",704802,39]],"Why delayest thou, O tyrant? for we are readier to die than to transgress the injunctions of our fathers."],["2",[["αἰσχυνόμεθα",700485,378],["γὰρ",702963,11],["τοὺς",709436,58],["προγόνους",710777,57],["ἡμῶν",705999,145],["εἰκότως",704087,28],["εἰ",704071,7],["μὴ",708851,28],["τῇ",709436,100],["τοῦ",709436,35],["νόμου",709349,18],["εὐπειθείᾳ",705661,1],["καὶ",707031,7],["συμβούλῳ",712295,114],["Μωυσεῖ",709112,114],["χρησαίμεθα",713937,708]],"And we should be disgracing our fathers if we did not obey the law, and take knowledge for our guide."],["3",[["σύμβουλε",712295,153],["τύραννε",713026,153],["παρανομίας",710079,17],["μὴ",708851,28],["ἡμᾶς",705981,194],["μισῶν",708935,72],["ὑπὲρ",713111,0],["αὐτοὺς",702165,62],["ἡμᾶς",705981,194],["ἐλέα",704412,240]],"O tyrant, counsellor of law-breaking, do not, hating us as thou dost, pity us more than we pity ourselves."],["4",[["χαλεπώτερον",713682,61],["γὰρ",702963,11],["αὐτοῦ",702165,102],["τοῦ",709436,35],["θανάτου",706096,18],["νομίζομεν",709338,243],["εἶναί",704093,55],["σου",711945,133],["τὸν",709436,5],["ἐπὶ",705080,0],["τῇ",709436,100],["παρανόμῳ",710080,101],["σωτηρίᾳ",712658,1],["ἡμῶν",705999,145],["ἔλεον",704426,6]],"For we account your pity of us on the terms of unlawful escape to be worse than death."],["5",[["ἐκφοβεῖς",704360,154],["δὲ",703303,11],["ἡμᾶς",705981,194],["τὸν",709436,5],["διὰ",703417,0],["τῶν",709436,130],["βασάνων",702570,65],["θάνατον",706096,6],["ἡμῖν",705994,90],["ἀπειλῶν",701374,72],["ὥσπερ",714163,28],["οὐχὶ",709862,28],["πρὸ",710747,0],["βραχέως",702807,28],["παρ᾿",709995,0],["Ελεαζαρου",704408,18],["μαθών",708480,182]],"And you think to scare us, by threatening us with death by tortures, as though thou hadst learned nothing by the death of Eleazar."],["6",[["εἰ",704071,7],["δ᾿",703303,11],["οἱ",709436,136],["γέροντες",703065,52],["τῶν",709436,80],["Εβραίων",703933,81],["διὰ",703417,0],["τὴν",709436,8],["εὐσέβειαν",705685,9],["καὶ",707031,7],["βασανισμοὺς",702567,57],["ὑπομείναντες",713219,196],["εὐσέβησαν",705686,150],["ἀποθάνοιμεν",701461,383],["ἂν",700900,11],["δικαιότερον",703694,61],["ἡμεῖς",705983,219],["οἱ",709436,136],["νέοι",709256,138],["τὰς",709436,38],["βασάνους",702570,39],["τῶν",709436,130],["σῶν",711943,198],["ἀναγκῶν",700925,65],["ὑπεριδόντες",713154,196],["ἃς",709781,193],["καὶ",707031,7],["ὁ",709436,3],["παιδευτὴς",709925,4],["ἡμῶν",705999,145],["γέρων",703065,4],["ἐνίκησεν",709309,2]],"But if aged men of the Hebrews have died in the cause of religion after enduring torture, more rightly should we younger men die, scorning your cruel tortures, which our aged instructor overcame."],["7",[["πείραζε",710225,240],["τοιγαροῦν",712874,11],["τύραννε",713026,153],["καὶ",707031,7],["τὰς",709436,38],["ἡμῶν",705999,145],["ψυχὰς",714070,39],["εἰ",704071,7],["θανατώσεις",706097,166],["διὰ",703417,0],["τὴν",709436,8],["εὐσέβειαν",705685,9],["μὴ",708851,28],["νομίσῃς",709338,175],["ἡμᾶς",705981,194],["βλάπτειν",702732,55],["βασανίζων",702566,72]],"Make the attempt, then, O tyrant; and if thou puttest us to death for our religion, think not that thou harmest us by torturing us."],["8",[["ἡμεῖς",705983,219],["μὲν",708730,11],["γὰρ",702963,11],["διὰ",703417,0],["τῆσδε",709446,86],["τῆς",709436,16],["κακοπαθείας",707060,17],["καὶ",707031,7],["ὑπομονῆς",713226,17],["τὰ",709436,41],["τῆς",709436,16],["ἀρετῆς",701727,17],["ἆθλα",700379,42],["ἕξομεν",705785,275],["καὶ",707031,7],["ἐσόμεθα",704093,141],["παρὰ",709995,0],["θεῷ",706192,114],["δι᾿",703417,0],["ὃν",709781,112],["καὶ",707031,28],["πάσχομεν",710183,243]],"For we through this ill-treatment and endurance shall bear off the rewards of virtue.",{"s":"d","q":0.62}],["9",[["σὺ",712181,164],["δὲ",703303,11],["διὰ",703417,0],["τὴν",709436,8],["ἡμῶν",705999,145],["μιαιφονίαν",708901,9],["αὐτάρκη",702157,68],["καρτερήσεις",707178,166],["ὑπὸ",713184,0],["τῆς",709436,16],["θείας",706154,82],["δίκης",703702,17],["αἰώνιον",700505,36],["βάσανον",702570,9],["διὰ",703417,0],["πυρός",711088,21]],"But thou, for the wicked and despotic slaughter of us, shalt, from the Divine vengeance, endure eternal torture by fire."],["10",[["ταῦτα",709858,71],["αὐτῶν",702165,40],["εἰπόντων",705415,221],["οὐ",709805,28],["μόνον",709001,28],["ὡς",714148,7],["κατὰ",707200,0],["ἀπειθούντων",701370,170],["ἐχαλέπαινεν",713681,13],["ὁ",709436,3],["τύραννος",713026,4],["ἀλλὰ",700680,7],["καὶ",707031,28],["ὡς",714148,7],["κατὰ",707200,0],["ἀχαρίστων",702252,169],["ὠργίσθη",709729,37]],"When they had thus spoken, the tyrant was not only exasperated against them as being refractory, but enraged with them as being ungrateful."],["11",[["ὅθεν",709486,28],["τὸν",709436,5],["πρεσβύτατον",710734,534],["αὐτῶν",702165,40],["κελευσθέντες",707601,247],["παρῆγον",710007,137],["οἱ",709436,136],["ὑπασπισταὶ",713105,52],["καὶ",707031,7],["διαρρήξαντες",703565,196],["τὸν",709436,5],["χιτῶνα",713869,6],["διέδησαν",703445,150],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["τοὺς",709436,58],["βραχίονας",702808,57],["ἱμᾶσιν",706741,148],["ἑκατέρωθεν",704135,28]],"So that, at his bidding, the torturers brought forth the eldest of them, and tearing through his tunic, bound his hands and arms on each side with thongs."],["12",[["ὡς",714148,7],["δὲ",703303,11],["τύπτοντες",713022,146],["ταῖς",709436,75],["μάστιξιν",708568,76],["ἐκοπίασαν",707824,150],["μηδὲν",708857,46],["ἀνύοντες",701294,146],["ἀνέβαλον",700906,150],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["τὸν",709436,5],["τροχόν",712994,6]],"And when they had laboured hard without effect in scourging him, they hurled him upon the wheel."],["13",[["περὶ",710285,0],["ὃν",709781,112],["κατατεινόμενος",707454,122],["ὁ",709436,3],["εὐγενὴς",705559,14],["νεανίας",709229,4],["ἔξαρθρος",704875,14],["ἐγίνετο",703104,19]],"And the noble youth, extended upon this, became dislocated."],["14",[["καὶ",707031,7],["κατὰ",707200,0],["πᾶν",710177,46],["μέλος",708707,25],["κλώμενος",707707,466],["ἐκακηγόρει",707053,13],["λέγων",708124,72]],"And with every member disjointed, he exclaimed in expostulation,"],["15",[["τύραννε",713026,153],["μιαρώτατε",708906,710],["καὶ",707031,7],["τῆς",709436,16],["οὐρανίου",709842,116],["δίκης",703702,17],["ἐχθρὲ",705779,564],["καὶ",707031,7],["ὠμόφρων",714117,564],["οὐκ",709805,28],["ἀνδροφονήσαντά",701109,365],["με",708618,163],["τοῦτον",709858,85],["καταικίζεις",707256,154],["τὸν",709436,5],["τρόπον",712980,6],["οὐδὲ",709816,7],["ἀσεβήσαντα",701906,365],["ἀλλὰ",700680,7],["θείου",706154,116],["νόμου",709349,18],["προασπίζοντα",710761,183]],"O most accursed tyrant, and enemy of heavenly justice, and cruel-hearted, I am no murderer, nor sacrilegious man, whom thou thus ill-usest; but a defender of the Divine law."],["16",[["καὶ",707031,7],["τῶν",709436,80],["δορυφόρων",703807,81],["λεγόντων",708124,170],["ὁμολόγησον",709632,176],["φαγεῖν",713296,106],["ὅπως",709719,7],["ἀπαλλαγῇς",701333,175],["τῶν",709436,130],["βασάνων",702570,65]],"And when the spearmen said, Consent to eat, that you may be released from your tortures,—"],["17",[["ὁ",709436,3],["δὲ",703303,11],["εἶπεν",705373,2],["οὐχ",709805,28],["οὕτως",709859,28],["ἰσχυρὸς",706855,14],["ὑμῶν",713091,145],["ἐστιν",704093,91],["ὁ",709436,3],["τροχός",712994,4],["ὦ",714081,88],["μιαροὶ",708906,538],["διάκονοι",703478,274],["ὥστε",714164,7],["μου",709032,133],["τὸν",709436,5],["λογισμὸν",708234,6],["ἄγξαι",700207,106],["τέμνετέ",712791,335],["μου",709032,133],["τὰ",709436,41],["μέλη",708707,42],["καὶ",707031,7],["πυροῦτέ",711103,335],["μου",709032,133],["τὰς",709436,38],["σάρκας",711537,39],["καὶ",707031,7],["στρεβλοῦτε",712155,335],["τὰ",709436,41],["ἄρθρα",701736,42]],"he answered, Not so powerful, O accursed ministers, is your wheel, as to stifle my reasoning; cut my limbs, and burn my flesh, and twist my joints."],["18",[["διὰ",703417,0],["πασῶν",710177,198],["γὰρ",702963,11],["ὑμᾶς",713080,194],["πείσω",710221,165],["τῶν",709436,130],["βασάνων",702570,65],["ὅτι",709803,7],["μόνοι",709003,138],["παῖδες",709932,52],["Εβραίων",703933,81],["ὑπὲρ",713111,0],["ἀρετῆς",701727,17],["εἰσιν",704093,197],["ἀνίκητοι",701170,138]],"For through all my torments I will convince you that the children of the Hebrews are alone unconquered in behalf of virtue."],["19",[["ταῦτα",709858,71],["λέγοντι",708124,379],["ὑπέστρωσαν",713247,150],["πῦρ",711088,25],["καὶ",707031,7],["τὸ",709436,24],["διερεθίζον",703670,47],["τὸν",709436,5],["τροχὸν",712994,6],["προσεπικατέτεινον",710887,137]],"While he was saying this, they heaped up fuel, and setting fire to it, strained him upon the wheel still more."],["20",[["ἐμολύνετο",708987,19],["δὲ",703303,11],["πάντοθεν",709984,28],["αἵματι",700442,54],["ὁ",709436,3],["τροχός",712994,4],["καὶ",707031,7],["ὁ",709436,3],["σωρὸς",712650,4],["τῆς",709436,16],["ἀνθρακιᾶς",701158,17],["τοῖς",709436,147],["τῶν",709436,80],["ἰχώρων",706874,81],["ἐσβέννυτο",711596,19],["σταλαγμοῖς",712044,148],["καὶ",707031,7],["περὶ",710285,0],["τοὺς",709436,58],["ἄξονας",701312,57],["τοῦ",709436,20],["ὀργάνου",709727,21],["περιέρρεον",710376,137],["αἱ",709436,190],["σάρκες",711537,191]],"And the wheel was defiled all over with blood, and the hot ashes were quenched by the droppings of gore, and pieces of flesh were scattered about the axles of the machine."],["21",[["καὶ",707031,7],["περιτετμημένον",710402,448],["ἤδη",705939,28],["ἔχων",705785,72],["τὸ",709436,24],["τῶν",709436,43],["ὀστέων",709792,44],["πῆγμα",710451,25],["ὁ",709436,3],["μεγαλόφρων",708644,4],["καὶ",707031,7],["Αβραμιαῖος",700094,14],["νεανίας",709229,4],["οὐκ",709805,28],["ἐστέναξεν",712066,2]],"And although the framework of his bones was now destroyed, the high-minded and Abrahamic youth did not groan."],["22",[["ἀλλ᾿",700680,7],["ὥσπερ",714163,28],["ἐν",704639,0],["πυρὶ",711088,54],["μετασχηματιζόμενος",708819,122],["εἰς",704105,0],["ἀφθαρσίαν",702205,9],["ὑπέμεινεν",713219,2],["εὐγενῶς",705561,28],["τὰς",709436,38],["στρέβλας",712153,39]],"But, as though transformed by fire into immortality, he nobly endured the rackings, saying,"],["23",[["μιμήσασθέ",708921,186],["με",708618,163],["ἀδελφοί",700249,274],["λέγων",708124,72],["μή",708851,28],["μου",709032,133],["τὸν",709436,5],["ἀγῶνα",700211,6],["λειποτακτήσητε",708130,125],["μηδὲ",708855,7],["ἐξομόσησθέ",704958,142],["μου",709032,133],["τὴν",709436,8],["τῆς",709436,16],["εὐψυχίας",705730,17],["ἀδελφότητα",700250,9]],"Imitate me, O brethren, nor ever desert your station, nor abjure my brotherhood in courage: fight the holy and honourable fight of religion;",{"s":"d","q":0.58}],["24",[["ἱερὰν",706633,36],["καὶ",707031,7],["εὐγενῆ",705559,36],["στρατείαν",712138,9],["στρατεύσασθε",712140,186],["περὶ",710285,0],["τῆς",709436,16],["εὐσεβείας",705685,17],["δι᾿",703417,0],["ἧς",709781,167],["ἵλεως",706732,29],["ἡ",709436,10],["δικαία",703694,29],["καὶ",707031,7],["πάτριος",710195,29],["ἡμῶν",705999,145],["πρόνοια",710825,12],["τῷ",709436,53],["ἔθνει",704068,54],["γενηθεῖσα",703104,307],["τιμωρήσειεν",712861,225],["τὸν",709436,5],["ἀλάστορα",700636,6],["τύραννον",713026,6]],"by which means our just and paternal Providence, becoming merciful to the nation, will punish the pestilent tyrant.",{"s":"d","q":0.65}],["25",[["καὶ",707031,7],["ταῦτα",709858,71],["εἰπὼν",705373,182],["ὁ",709436,3],["ἱεροπρεπὴς",706632,14],["νεανίας",709229,4],["ἀπέρρηξεν",701561,2],["τὴν",709436,8],["ψυχήν",714070,9]],"And saying this, the revered youth abruptly closed his life."],["26",[["θαυμασάντων",706135,221],["δὲ",703303,11],["πάντων",710177,169],["τὴν",709436,8],["καρτεροψυχίαν",707181,9],["αὐτοῦ",702165,102],["ἦγον",700209,137],["οἱ",709436,136],["δορυφόροι",703807,52],["τὸν",709436,5],["καθ᾿",707200,0],["ἡλικίαν",705971,9],["τοῦ",709436,35],["προτέρου",711041,229],["δεύτερον",703389,27],["καὶ",707031,7],["σιδηρᾶς",711771,119],["ἐναρμοσάμενοι",704663,317],["χεῖρας",713787,39],["ὀξέσι",709682,230],["τοῖς",709436,147],["ὄνυξιν",709673,148],["ὀργάνῳ",709727,54],["καὶ",707031,7],["καταπέλτῃ",707357,114],["προσέδησαν",710873,150],["αὐτόν",702165,85]],"And when all admired his courageous soul, the spearmen brought forward him who was second in point of age, and having put on iron hands, bound him with pointed hooks to the catapelt."],["27",[["ὡς",714148,7],["δ᾿",703303,11],["εἰ",704071,7],["φαγεῖν",713296,106],["βούλοιτο",702795,700],["πρὶν",710742,28],["βασανίζεσθαι",702566,110],["πυνθανόμενοι",711085,348],["τὴν",709436,8],["εὐγενῆ",705559,36],["γνώμην",703134,9],["ἤκουσαν",700587,150]],"And when, on enquiring whether he would eat before he was tortured, they heard his noble sentiment,"],["28",[["ἀπὸ",701425,0],["τῶν",709436,80],["τενόντων",712792,81],["ταῖς",709436,75],["σιδηραῖς",711771,291],["χερσὶν",713787,76],["ἐπισπασάμενοι",705258,317],["μέχρι",708849,0],["τῶν",709436,43],["γενείων",703040,44],["τὴν",709436,8],["σάρκα",711537,9],["πᾶσαν",710177,36],["καὶ",707031,7],["τὴν",709436,8],["τῆς",709436,16],["κεφαλῆς",707639,17],["δορὰν",703797,9],["οἱ",709436,136],["παρδάλεοι",710121,138],["θῆρες",706243,52],["ἀπέσυρον",701603,137],["ὁ",709436,3],["δὲ",703303,11],["ταύτην",709858,104],["βαρέως",702534,28],["τὴν",709436,8],["ἀλγηδόνα",700639,9],["καρτερῶν",707178,72],["ἔλεγεν",708124,13]],"after they with the iron hands had violently dragged all the flesh from the neck to the chin, the panther-like beasts tore off the very skin of his head: but he, bearing with firmness this misery, said,"],["29",[["ὡς",714148,7],["ἡδὺς",705945,14],["πᾶς",710177,14],["θανάτου",706096,18],["τρόπος",712980,4],["διὰ",703417,0],["τὴν",709436,8],["πάτριον",710195,36],["ἡμῶν",705999,145],["εὐσέβειαν",705685,9],["ἔφη",713437,13],["τε",712751,11],["πρὸς",710844,0],["τὸν",709436,5],["τύραννον",713026,6]],"How sweet is every form of death for the religion of our fathers! and he said to the tyrant,"],["30",[["οὐ",709805,28],["δοκεῖς",703775,154],["πάντων",710177,169],["ὠμότατε",714114,710],["τύραννε",713026,153],["πλέον",710540,46],["ἐμοῦ",704580,133],["σε",711598,163],["βασανίζεσθαι",702566,395],["ὁρῶν",709769,81],["σου",711945,133],["νικώμενον",709309,464],["τὸν",709436,5],["τῆς",709436,16],["τυραννίδος",713025,17],["ὑπερήφανον",713139,27],["λογισμὸν",708234,6],["ὑπὸ",713184,0],["τῆς",709436,16],["διὰ",703417,0],["τὴν",709436,8],["εὐσέβειαν",705685,9],["ἡμῶν",705999,145],["ὑπομονῆς",713226,17]],"Thinkest thou not, most cruel of all tyrants, that thou art now tortured more than I, finding thy overweening conception of tyranny conquered by our patience in behalf of our religion?"],["31",[["ἐγὼ",704018,164],["μὲν",708730,11],["γὰρ",702963,11],["ταῖς",709436,75],["διὰ",703417,0],["τὴν",709436,8],["ἀρετὴν",701727,9],["ἡδοναῖς",705942,76],["τὸν",709436,5],["πόνον",710661,6],["ἐπικουφίζομαι",705173,254]],"For I lighten my suffering by the pleasures which are connected with virtue."],["32",[["σὺ",712181,164],["δὲ",703303,11],["ἐν",704639,0],["ταῖς",709436,75],["τῆς",709436,16],["ἀσεβείας",701904,17],["ἀπειλαῖς",701375,76],["βασανίζῃ",702566,491],["οὐκ",709805,28],["ἐκφεύξῃ",704357,123],["δέ",703303,11],["μιαρώτατε",708906,710],["τύραννε",713026,153],["τὰς",709436,38],["τῆς",709436,16],["θείας",706154,82],["ὀργῆς",709728,17],["δίκας",703702,39]],"But thou art tortured with threatenings for impiety; and thou shalt not escape, most corrupt tyrant, the vengeance of Divine wrath."]]