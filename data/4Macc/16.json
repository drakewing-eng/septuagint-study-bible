[["1",[["εἰ",704071,7],["δὲ",703303,11],["τοίνυν",712875,11],["καὶ",707031,7],["γυνὴ",703209,12],["καὶ",707031,7],["γεραιὰ",703058,29],["καὶ",707031,7],["ἑπτὰ",705357,59],["παίδων",709932,81],["μήτηρ",708892,12],["ὑπέμεινεν",713219,2],["τὰς",709436,38],["μέχρι",708849,0],["θανάτου",706096,18],["βασάνους",702570,39],["τῶν",709436,43],["τέκνων",712761,44],["ὁρῶσα",709725,188],["ὁμολογουμένως",709635,28],["αὐτοκράτωρ",702162,4],["ἐστὶν",704093,91],["τῶν",709436,43],["παθῶν",709918,44],["ὁ",709436,3],["εὐσεβὴς",705687,14],["λογισμός",708234,4]],"If, then, even a woman, and that an aged one, and the mother of seven children, endured to see her children's torments even unto death, confessedly religious reasoning is master even of the passions."],["2",[["ἀπέδειξα",701438,155],["οὖν",709835,11],["ὅτι",709803,7],["οὐ",709805,28],["μόνον",709001,28],["ἄνδρες",701150,52],["τῶν",709436,43],["παθῶν",709918,44],["ἐκράτησαν",707879,150],["ἀλλὰ",700680,7],["καὶ",707031,28],["γυνὴ",703209,12],["τῶν",709436,130],["μεγίστων",708653,665],["βασάνων",702570,65],["ὑπερεφρόνησεν",713167,2]],"I have proved, then, that not only men have obtained the mastery of their passions, but also that a woman despised the greatest torments."],["3",[["καὶ",707031,7],["οὐχ",709805,28],["οὕτως",709859,28],["οἱ",709436,136],["περὶ",710285,0],["Δανιηλ",703283,18],["λέοντες",708171,52],["ἦσαν",704093,137],["ἄγριοι",700191,138],["οὐδὲ",709816,7],["ἡ",709436,10],["Μισαηλ",708930,18],["ἐκφλεγομένη",704359,211],["κάμινος",707113,4],["λαβροτάτῳ",708047,633],["πυρί",711088,54],["ὡς",714148,7],["ἡ",709436,10],["τῆς",709436,16],["φιλοτεκνίας",713499,17],["περιέκαιεν",710326,13],["ἐκείνην",704183,104],["φύσις",713633,12],["ὁρῶσαν",709725,78],["αὐτῆς",702165,86],["οὕτως",709859,28],["ποικίλως",710593,28],["βασανιζομένους",702566,507],["τοὺς",709436,58],["ἑπτὰ",705357,59],["υἱούς",713075,57]],"And not so fierce were the lions round Daniel, nor the furnace of Misael burning with most vehement fire, as that natural love of children burned within her, when she beheld her seven sons tortured."],["4",[["ἀλλὰ",700680,7],["τῷ",709436,113],["λογισμῷ",708234,114],["τῆς",709436,16],["εὐσεβείας",705685,17],["κατέσβεσεν",707412,2],["τὰ",709436,41],["τοσαῦτα",712907,71],["καὶ",707031,7],["τηλικαῦτα",712843,71],["πάθη",709918,42],["ἡ",709436,10],["μήτηρ",708892,12]],"But with the reasoning of religion the mother quenched passions so great and powerful."],["5",[["καὶ",707031,7],["γὰρ",702963,11],["τοῦτο",709858,129],["ἐπιλογίσασθε",705193,186],["ὅτι",709803,7],["δειλόψυχος",703325,29],["εἰ",704071,7],["ἦν",704093,13],["ἡ",709436,10],["γυνὴ",703209,12],["καίπερ",707045,7],["μήτηρ",708892,12],["οὖσα",704093,188],["ὠλοφύρετο",709602,19],["ἂν",700900,11],["ἐπ᾿",705080,0],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἴσως",706860,28],["ἂν",700900,11],["ταῦτα",709858,71],["εἶπεν",705373,2]],"For we must consider also this: that, had the woman been faint-hearted, as being their mother, she would have lamented over them; and perhaps might have spoken thus:"],["6",[["ὦ",714081,88],["μελέα",708697,29],["ἔγωγε",704018,713],["καὶ",707031,7],["πολλάκις",710617,28],["τρισαθλία",712954,29],["ἥτις",709793,412],["ἑπτὰ",705357,59],["παῖδας",709932,57],["τεκοῦσα",712853,149],["οὐδενὸς",709817,116],["μήτηρ",708892,12],["γεγένημαι",703104,326]],"Ah! wretched I, and many times miserable; who having born seven sons, have become the mother of none."],["7",[["ὦ",714081,88],["μάταιοι",708575,192],["ἑπτὰ",705357,59],["κυοφορίαι",707980,191],["καὶ",707031,7],["ἀνόνητοι",701196,138],["ἑπτὰ",705357,59],["δεκάμηνοι",703337,52],["καὶ",707031,7],["ἄκαρποι",700522,192],["τιθηνίαι",712851,191],["καὶ",707031,7],["ταλαίπωροι",712696,192],["γαλακτοτροφίαι",702928,191]],"O seven useless childbirths, and seven profitless periods of labour, and fruitless givings of suck, and miserable nursings at the breast."],["8",[["μάτην",708582,28],["δὲ",703303,11],["ἐφ᾿",705080,0],["ὑμῖν",713084,90],["ὦ",714081,88],["παῖδες",709932,274],["πολλὰς",710646,119],["ὑπέμεινα",713219,155],["ὠδῖνας",714094,39],["καὶ",707031,7],["χαλεπωτέρας",713682,366],["φροντίδας",713591,39],["ἀνατροφῆς",701077,17]],"Vainly, for your sakes, O sons, have I endured many pangs, and the more difficult anxieties of rearing."],["9",[["ὦ",714081,88],["τῶν",709436,80],["ἐμῶν",704578,169],["παίδων",709932,81],["οἱ",709436,136],["μὲν",708730,11],["ἄγαμοι",700117,138],["οἱ",709436,136],["δὲ",703303,11],["γήμαντες",702953,196],["ἀνόνητοι",701196,138],["οὐκ",709805,28],["ὄψομαι",709725,181],["ὑμῶν",713091,145],["τέκνα",712761,42],["οὐδὲ",709816,7],["μάμμη",708457,12],["κληθεῖσα",707084,307],["μακαρισθήσομαι",708396,180]],"Alas, of my children, some of you unmarried, and some who have married to no profit, I shall not see your children, nor be felicitated as a grandmother."],["10",[["ὦ",714081,88],["ἡ",709436,10],["πολύπαις",710635,12],["καὶ",707031,7],["καλλίπαις",707090,12],["ἐγὼ",704018,164],["γυνὴ",703209,12],["χήρα",713848,12],["καὶ",707031,7],["μόνη",709003,29],["πολύθρηνος",710628,29]],"Ah, that I who had many and fair children, should be a lone widow full of sorrows!"],["11",[["οὐδ᾿",709816,7],["ἂν",700900,11],["ἀποθάνω",701461,207],["θάπτοντα",706103,183],["τῶν",709436,80],["υἱῶν",713075,81],["ἕξω",705785,165],["τινά",712866,356]],"Nor, should I die, shall I have a son to bury me. But with such a lament as this the holy and God-fearing mother bewailed none of them."],["12",[["ἀλλὰ",700680,7],["τούτῳ",709858,50],["τῷ",709436,113],["θρήνῳ",706309,114],["οὐδένα",709817,27],["ὠλοφύρετο",709602,19],["ἡ",709436,10],["ἱερὰ",706633,29],["καὶ",707031,7],["θεοσεβὴς",706194,29],["μήτηρ",708892,12],["οὐδ᾿",709816,7],["ἵνα",706747,7],["μὴ",708851,28],["ἀποθάνωσιν",701461,234],["ἀπέτρεπεν",701622,13],["αὐτῶν",702165,40],["τινα",712866,356],["οὐδ᾿",709816,7],["ὡς",714148,7],["ἀποθνῃσκόντων",701461,170],["ἐλυπήθη",708272,37]],"Nor did she divert any of them from death, nor grieve for them as for the dead."],["13",[["ἀλλ᾿",700680,7],["ὥσπερ",714163,28],["ἀδαμάντινον",700224,27],["ἔχουσα",705785,188],["τὸν",709436,5],["νοῦν",709374,6],["καὶ",707031,7],["εἰς",704105,0],["ἀθανασίαν",700357,9],["ἀνατίκτουσα",701069,188],["τὸν",709436,5],["τῶν",709436,80],["υἱῶν",713075,81],["ἀριθμὸν",701744,6],["μᾶλλον",708448,28],["ὑπὲρ",713111,0],["τῆς",709436,16],["εὐσεβείας",705685,17],["ἐπὶ",705080,0],["τὸν",709436,5],["θάνατον",706096,6],["αὐτοὺς",702165,62],["προετρέπετο",710996,19],["ἱκετεύουσα",706716,188]],"But as one possessed with an adamantine mind, and as one bringing forth again her full number of sons to immortality, she rather with supplications exhorted them to death in behalf of religion."],["14",[["ὦ",714081,88],["μῆτερ",708892,258],["δι᾿",703417,0],["εὐσέβειαν",705685,9],["θεοῦ",706192,18],["στρατιῶτι",712147,258],["πρεσβῦτι",710737,258],["καὶ",707031,7],["γύναι",703209,258],["διὰ",703417,0],["καρτερίαν",707179,9],["καὶ",707031,28],["τύραννον",713026,6],["ἐνίκησας",709309,162],["καὶ",707031,7],["ἔργοις",705396,96],["δυνατωτέρα",703845,484],["καὶ",707031,7],["λόγοις",708236,148],["εὑρέθης",705676,168],["ἀνδρός",701150,18]],"O woman, soldier of God for religion, thou, aged and a female, hast conquered through endurance even a tyrant; and though but weak, hast been found more powerful in deeds and words."],["15",[["καὶ",707031,7],["γὰρ",702963,11],["ὅτε",709802,28],["συνελήμφθης",712262,168],["μετὰ",708780,0],["τῶν",709436,80],["παίδων",709932,81],["εἱστήκεις",706846,508],["τὸν",709436,5],["Ελεαζαρον",704408,6],["ὁρῶσα",709725,188],["βασανιζόμενον",702566,464],["καὶ",707031,7],["ἔλεγες",708124,363],["τοῖς",709436,147],["παισὶν",709932,148],["ἐν",704639,0],["τῇ",709436,100],["Εβραΐδι",703934,101],["φωνῇ",713640,1]],"For when thou wast seized along with thy children, thou stoodest looking upon Eleazar in torments, and saidst to thy sons in the Hebrew tongue,"],["16",[["ὦ",714081,88],["παῖδες",709932,274],["γενναῖος",703048,14],["ὁ",709436,3],["ἀγών",700211,4],["ἐφ᾿",705080,0],["ὃν",709781,112],["κληθέντες",707084,247],["ὑπὲρ",713111,0],["τῆς",709436,16],["διαμαρτυρίας",703512,17],["τοῦ",709436,20],["ἔθνους",704068,21],["ἐναγωνίσασθε",704643,186],["προθύμως",710800,28],["ὑπὲρ",713111,0],["τοῦ",709436,35],["πατρῴου",710199,116],["νόμου",709349,18]],"O sons, noble is the contest; to which you being called as a witness for the nation, strive zealously for the laws of your country."],["17",[["καὶ",707031,7],["γὰρ",702963,11],["αἰσχρὸν",700481,27],["τὸν",709436,5],["μὲν",708730,11],["γέροντα",703065,6],["τοῦτον",709858,85],["ὑπομένειν",713219,55],["τὰς",709436,38],["διὰ",703417,0],["τὴν",709436,8],["εὐσέβειαν",705685,9],["ἀλγηδόνας",700639,39],["ὑμᾶς",713080,194],["δὲ",703303,11],["τοὺς",709436,58],["νεανίσκους",709232,57],["καταπλαγῆναι",707380,179],["τὰς",709436,38],["βασάνους",702570,39]],"For it were disgraceful that this old man should endure pains for the sake of righteousness, and that you who are younger should be afraid of the tortures."],["18",[["ἀναμνήσθητε",701002,394],["ὅτι",709803,7],["διὰ",703417,0],["τὸν",709436,5],["θεὸν",706192,6],["τοῦ",709436,35],["κόσμου",707851,18],["μετελάβετε",708800,265],["καὶ",707031,7],["τοῦ",709436,35],["βίου",702724,18],["ἀπελαύσατε",701506,265]],"Remember that through God ye obtained existence, and have enjoyed it."],["19",[["καὶ",707031,7],["διὰ",703417,0],["τοῦτο",709858,129],["ὀφείλετε",709865,87],["πάντα",710177,27],["πόνον",710661,6],["ὑπομένειν",713219,55],["διὰ",703417,0],["τὸν",709436,5],["θεόν",706192,6]],"And on this account ye ought to bear every affliction because of God."],["20",[["δι᾿",703417,0],["ὃν",709781,112],["καὶ",707031,28],["ὁ",709436,3],["πατὴρ",710189,4],["ἡμῶν",705999,145],["Αβρααμ",700091,4],["ἔσπευδεν",712011,13],["τὸν",709436,5],["ἐθνοπάτορα",704066,6],["υἱὸν",713075,6],["σφαγιάσαι",712569,106],["Ισαακ",706799,6],["καὶ",707031,7],["τὴν",709436,8],["πατρῴαν",710199,36],["χεῖρα",713787,9],["ξιφηφόρον",709422,36],["καταφερομένην",707471,173],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["ὁρῶν",709725,72],["οὐκ",709805,28],["ἔπτηξεν",711060,2]],"For whom also our father Abraham was forward to sacrifice Isaac our progenitor, and shuddered not at the sight of his own paternal hand descending down with the sword upon him."],["21",[["καὶ",707031,7],["Δανιηλ",703283,4],["ὁ",709436,3],["δίκαιος",703694,14],["εἰς",704105,0],["λέοντας",708171,57],["ἐβλήθη",702487,37],["καὶ",707031,7],["Ανανιας",701016,4],["καὶ",707031,7],["Αζαριας",700328,4],["καὶ",707031,7],["Μισαηλ",708930,4],["εἰς",704105,0],["κάμινον",707113,6],["πυρὸς",711088,21],["ἀπεσφενδονήθησαν",701605,99],["καὶ",707031,7],["ὑπέμειναν",713219,150],["διὰ",703417,0],["τὸν",709436,5],["θεόν",706192,6]],"And the righteous Daniel was cast unto the lions; and Ananias, and Azarias, and Misael, were slung out into a furnace of fire; yet they endured through God."],["22",[["καὶ",707031,7],["ὑμεῖς",713081,219],["οὖν",709835,11],["τὴν",709436,8],["αὐτὴν",702165,104],["πίστιν",710484,9],["πρὸς",710844,0],["τὸν",709436,5],["θεὸν",706192,6],["ἔχοντες",705785,146],["μὴ",708851,28],["χαλεπαίνετε",713681,335]],"You, then, having the same faith towards God, be not troubled."],["23",[["ἀλόγιστον",700719,26],["γὰρ",702963,11],["εἰδότας",704075,235],["εὐσέβειαν",705685,9],["μὴ",708851,28],["ἀνθίστασθαι",701154,110],["τοῖς",709436,147],["πόνοις",710661,148]],"For it is unreasonable that they who know religion should not stand up against troubles."],["24",[["διὰ",703417,0],["τούτων",709858,40],["τῶν",709436,80],["λόγων",708236,81],["ἡ",709436,10],["ἑπταμήτωρ",705367,12],["ἕνα",704106,27],["ἕκαστον",704133,27],["τῶν",709436,80],["υἱῶν",713075,81],["παρακαλοῦσα",710039,188],["ἀποθανεῖν",701461,106],["ἔπεισεν",710221,2],["μᾶλλον",708448,28],["ἢ",705924,7],["παραβῆναι",709996,106],["τὴν",709436,8],["ἐντολὴν",704802,9],["τοῦ",709436,35],["θεοῦ",706192,18]],"With these arguments, the mother of seven, exhorting each of her sons, over-persuaded them from transgressing the commandment of God."],["25",[["ἔτι",705538,28],["δὲ",703303,11],["καὶ",707031,28],["ταῦτα",709858,71],["εἰδότες",704075,146],["ὅτι",709803,7],["οἱ",709436,136],["διὰ",703417,0],["τὸν",709436,5],["θεὸν",706192,6],["ἀποθνῄσκοντες",701461,146],["ζῶσιν",705851,197],["τῷ",709436,113],["θεῷ",706192,114],["ὥσπερ",714163,28],["Αβρααμ",700091,4],["καὶ",707031,7],["Ισαακ",706799,4],["καὶ",707031,7],["Ιακωβ",706401,4],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["πατριάρχαι",710193,52]],"And they saw this, too, that they who die for God, live to God; as Abraham, and Isaac, and Jacob, and all the patriarchs."]]