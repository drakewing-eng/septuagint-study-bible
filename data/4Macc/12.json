[["1",[["ὡς",714148,7],["δὲ",703303,11],["καὶ",707031,28],["οὗτος",709858,121],["μακαρίως",708400,28],["ἀπέθανεν",701461,2],["καταβληθεὶς",707203,217],["εἰς",704105,0],["λέβητα",708121,6],["ὁ",709436,3],["ἕβδομος",703925,14],["παρεγίνετο",710006,19],["πάντων",710177,169],["νεώτερος",709256,224]],"When he, too, had undergone blessed martyrdom, and died in the caldron into which he had been thrown, the seventh, the youngest of all, came forward:"],["2",[["ὃν",709781,112],["κατοικτίρας",707541,182],["ὁ",709436,3],["τύραννος",713026,4],["καίπερ",707045,7],["δεινῶς",703329,28],["ὑπὸ",713184,0],["τῶν",709436,80],["ἀδελφῶν",700249,81],["αὐτοῦ",702165,102],["κακισθείς",707055,217],["ὁρῶν",709725,72],["ἤδη",705939,28],["τὰ",709436,41],["δεσμὰ",703372,42],["περικείμενα",710329,67],["πλησιέστερον",710547,61],["αὐτὸν",702165,85],["μετεπέμψατο",708814,23],["καὶ",707031,7],["παρηγορεῖν",710143,55],["ἐπειρᾶτο",710230,19],["λέγων",708124,72]],"whom the tyrant pitying, though he had been dreadfully reproached by his brethren,",{"s":"d","q":0.65}],["3",[["τῆς",709436,16],["μὲν",708730,11],["τῶν",709436,80],["ἀδελφῶν",700249,81],["σου",711945,133],["ἀπονοίας",701535,17],["τὸ",709436,24],["τέλος",712787,25],["ὁρᾷς",709725,154],["διὰ",703417,0],["γὰρ",702963,11],["ἀπείθειαν",701369,9],["στρεβλωθέντες",712155,247],["τεθνᾶσιν",706278,353]],null,{"s":"h"}],["4",[["σὺ",712181,164],["δὲ",703303,11],["εἰ",704071,7],["μὲν",708730,11],["μὴ",708851,28],["πεισθείης",710221,716],["τάλας",712698,14],["βασανισθεὶς",702566,217],["καὶ",707031,28],["αὐτὸς",702165,121],["τεθνήξῃ",706278,123],["πρὸ",710747,0],["ὥρας",714128,17]],"Thou seest the end of the madness of thy brethren: for they have died in torture through disobedience; and you, if disobedient, having been miserably tormented, will yourself perish prematurely.",{"s":"d","q":0.43}],["5",[["πεισθεὶς",710221,217],["δὲ",703303,11],["φίλος",713492,14],["ἔσῃ",704093,123],["καὶ",707031,7],["τῶν",709436,43],["ἐπὶ",705080,0],["τῆς",709436,16],["βασιλείας",702577,17],["ἀφηγήσῃ",702203,123],["πραγμάτων",710708,44]],"But if you obey, you shall be my friend, and have a charge over the affairs of the kingdom."],["6",[["καὶ",707031,7],["ταῦτα",709858,71],["παρακαλῶν",710039,72],["τὴν",709436,8],["μητέρα",708892,9],["τοῦ",709436,35],["παιδὸς",709932,18],["μετεπέμψατο",708814,23],["ὅπως",709719,7],["αὐτὴν",702165,104],["ἐλεήσας",704418,182],["τοσούτων",712907,169],["υἱῶν",713075,81],["στερηθεῖσαν",712076,406],["παρορμήσειεν",710170,225],["ἐπὶ",705080,0],["τὴν",709436,8],["σωτήριον",712659,36],["εὐπείθειαν",705661,9],["τὸν",709436,5],["περιλειπόμενον",710343,212]],"And having thus exhorted him, he sent for the mother of the boy; that, by condoling with her for the loss of so many sons, he might incline her, through the hope of safety, to render the survivor obedient."],["7",[["ὁ",709436,3],["δὲ",703303,11],["τῆς",709436,16],["μητρὸς",708892,17],["τῇ",709436,100],["Εβραΐδι",703934,101],["φωνῇ",713640,1],["προτρεψαμένης",710996,638],["αὐτόν",702165,85],["ὡς",714148,7],["ἐροῦμεν",705415,275],["μετὰ",708780,0],["μικρὸν",708915,27],["ὕστερον",713273,28]],"And he, after his mother had urged him on in the Hebrew tongue, (as we shall soon relate) says,"],["8",[["λύσατέ",708288,74],["μέ",704018,163],["φησιν",713437,91],["εἴπω",705373,207],["τῷ",709436,113],["βασιλεῖ",702580,114],["καὶ",707031,7],["τοῖς",709436,147],["σὺν",712372,0],["αὐτῷ",702165,50],["φίλοις",713492,230],["πᾶσιν",710177,230]],"Release me, that I may speak to the king and all his friends."],["9",[["καὶ",707031,7],["ἐπιχαρέντες",705330,247],["μάλιστα",708446,28],["ἐπὶ",705080,0],["τῇ",709436,100],["ἐπαγγελίᾳ",704991,1],["τοῦ",709436,35],["παιδὸς",709932,18],["ταχέως",712743,28],["ἔλυσαν",708288,150],["αὐτόν",702165,85]],"And they, rejoicing exceedingly at the promise of the youth, quickly let him go."],["10",[["καὶ",707031,7],["δραμὼν",712931,182],["ἐπὶ",705080,0],["πλησίον",710547,28],["τῶν",709436,43],["τηγάνων",712835,44]],"And he, running up to the pans, said,",{"s":"d","q":0.62}],["11",[["ἀνόσιέ",701199,564],["φησιν",713437,91],["καὶ",707031,7],["πάντων",710177,169],["πονηρῶν",710660,169],["ἀσεβέστατε",701909,710],["τύραννε",713026,153],["οὐκ",709805,28],["ᾐδέσθης",700404,168],["παρὰ",709995,0],["τοῦ",709436,35],["θεοῦ",706192,18],["λαβὼν",708076,182],["τὰ",709436,41],["ἀγαθὰ",700106,68],["καὶ",707031,7],["τὴν",709436,8],["βασιλείαν",702577,9],["τοὺς",709436,58],["θεράποντας",706201,57],["αὐτοῦ",702165,102],["κατακτεῖναι",707294,106],["καὶ",707031,7],["τοὺς",709436,58],["τῆς",709436,16],["εὐσεβείας",705685,17],["ἀσκητὰς",701966,57],["στρεβλῶσαι",712155,106]],"Impious tyrant, and most blasphemous man, wert thou not ashamed, having received prosperity and a kingdom from God, to slay His servants, and to rack the doers of godliness?"],["12",[["ἀνθ᾿",701227,0],["ὧν",709781,252],["ταμιεύσεταί",712702,93],["σε",711598,163],["ἡ",709436,10],["δίκη",703702,12],["πυκνοτέρῳ",711081,97],["καὶ",707031,7],["αἰωνίῳ",700505,97],["πυρὶ",711088,54],["καὶ",707031,7],["βασάνοις",702570,76],["αἳ",709781,256],["εἰς",704105,0],["ὅλον",709597,27],["τὸν",709436,5],["αἰῶνα",700504,6],["οὐκ",709805,28],["ἀνήσουσίν",701169,218],["σε",711598,163]],"Wherefore the divine vengeance is reserving thee for eternal fire and torments, which shall cling to thee for all time."],["13",[["οὐκ",709805,28],["ᾐδέσθης",700404,168],["ἄνθρωπος",701163,4],["ὤν",704093,72],["θηριωδέστατε",706254,710],["τοὺς",709436,58],["ὁμοιοπαθεῖς",709625,138],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,43],["αὐτῶν",702165,40],["γεγονότας",703104,277],["στοιχείων",712117,44],["γλωττοτομῆσαι",703123,106],["καὶ",707031,7],["τοῦτον",709858,85],["καταικίσας",707256,182],["τὸν",709436,5],["τρόπον",712980,6],["βασανίσαι",702566,106]],"Wert thou not ashamed, man as thou art, yet most savage, to cut out the tongues of men of like feeling and origin, and having thus abused to torture them?"],["14",[["ἀλλ᾿",700680,7],["οἱ",709436,136],["μὲν",708730,11],["εὐγενῶς",705561,28],["ἀποθανόντες",701461,196],["ἐπλήρωσαν",710543,150],["τὴν",709436,8],["εἰς",704105,0],["τὸν",709436,5],["θεὸν",706192,6],["εὐσέβειαν",705685,9],["σὺ",712181,164],["δὲ",703303,11],["κακῶς",707074,28],["οἰμώξεις",709527,166],["τοὺς",709436,58],["τῆς",709436,16],["ἀρετῆς",701727,17],["ἀγωνιστὰς",700215,57],["ἀναιτίως",700964,28],["ἀποκτεῖνας",701498,182]],"But they, bravely dying, fulfilled their religion towards God. But thou shalt groan according to thy deserts for having slain without cause the champions of virtue.",{"s":"m","br":"12:14 12:15","q":0.86}],["15",[["ὅθεν",709486,28],["καὶ",707031,28],["αὐτὸς",702165,121],["ἀποθνῄσκειν",701461,55],["μέλλων",708705,72],["ἔφη",713437,13]],"Wherefore, he continued, I myself, being about to die,",{"s":"m","br":"12:16","q":1.0}],["16",[["οὐκ",709805,28],["ἀπαυτομολῶ",701368,157],["τῆς",709436,16],["τῶν",709436,80],["ἀδελφῶν",700249,81],["μου",709032,133],["ἀριστείας",701748,17]],"will not forsake the testimony of my brethren.",{"s":"m","br":"12:17","q":0.86}],["17",[["ἐπικαλοῦμαι",705153,254],["δὲ",703303,11],["τὸν",709436,5],["πατρῷον",710199,27],["θεὸν",706192,6],["ὅπως",709719,7],["ἵλεως",706732,14],["γένηται",703104,239],["τῷ",709436,53],["ἔθνει",704068,54],["ἡμῶν",705999,145]],"And I call upon the God of my fathers to be merciful to my race.",{"s":"m","br":"12:18","q":0.64,"gd":0.64}],["18",[["σὲ",711598,163],["δὲ",703303,11],["καὶ",707031,28],["ἐν",704639,0],["τῷ",709436,113],["νῦν",709384,28],["βίῳ",702724,114],["καὶ",707031,7],["θανόντα",706278,365],["τιμωρήσεται",712861,93]],"But thee, both living and dead, he will punish.",{"s":"m","br":"12:19","q":1.0}],["19",[["καὶ",707031,7],["ταῦτα",709858,71],["κατευξάμενος",707525,248],["ἑαυτὸν",703917,85],["ἔρριψε",711267,2],["κατὰ",707200,0],["τῶν",709436,43],["τηγάνων",712835,44],["καὶ",707031,7],["οὕτως",709859,28],["ἀπέδωκεν",701449,2]],"Thus having prayed, he hurled himself into the pans; and so expired.",{"s":"m","br":"12:20","q":0.82}]]