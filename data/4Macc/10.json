[["1",[["καὶ",707031,7],["τούτου",709858,102],["τὸν",709436,5],["ἀοίδιμον",701314,27],["θάνατον",706096,6],["καρτερήσαντος",707178,500],["ὁ",709436,3],["τρίτος",712968,14],["ἤγετο",700209,19],["παρακαλούμενος",710039,466],["πολλὰ",710646,68],["ὑπὸ",713184,0],["πολλῶν",710646,169],["ὅπως",709719,7],["ἀπογευσάμενος",701433,248],["σῴζοιτο",712627,700]],"Now this one, having endured this praiseworthy death, the third was brought along, and exhorted by many to taste and save his life."],["2",[["ὁ",709436,3],["δὲ",703303,11],["ἀναβοήσας",700915,182],["ἔφη",713437,13],["ἀγνοεῖτε",700175,87],["ὅτι",709803,7],["αὑτός",703917,121],["με",708618,163],["τοῖς",709436,147],["ἀποθανοῦσιν",701461,349],["ἔσπειρεν",712006,2],["πατήρ",710189,4],["καὶ",707031,7],["ἡ",709436,10],["αὐτὴ",702165,107],["μήτηρ",708892,12],["ἐγέννησεν",703051,2],["καὶ",707031,7],["ἐπὶ",705080,0],["τοῖς",709436,95],["αὐτοῖς",702165,206],["ἀνετράφην",701074,156],["δόγμασιν",703773,96]],"But he cried out and said, Know ye not, that the father of those who are dead, begat me also; and that the same mother bare me; and that I was brought up in the same tenets?"],["3",[["οὐκ",709805,28],["ἐξόμνυμαι",704958,254],["τὴν",709436,8],["εὐγενῆ",705559,36],["τῆς",709436,16],["ἀδελφότητος",700250,17],["συγγένειαν",712184,9]],"I abjure not the noble relationship of my brethren."],["5",[["οἱ",709436,136],["δὲ",703303,11],["πικρῶς",710476,28],["ἐνέγκαντες",713428,196],["τὴν",709436,8],["παρρησίαν",710173,9],["τοῦ",709436,35],["ἀνδρὸς",701150,18],["ἀρθρεμβόλοις",701735,96],["ὀργάνοις",709727,96],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["τοὺς",709436,58],["πόδας",710707,57],["ἐξήρθρουν",704876,137],["καὶ",707031,7],["ἐξ",704132,0],["ἁρμῶν",701778,81],["ἀναμοχλεύοντες",701005,146],["ἐξεμέλιζον",704259,137]],"But they, highly incensed at his boldness of speech, dislocated his hands and feet with racking engines, and wrenching them from their sockets, dismembered him."],["6",[["τοὺς",709436,58],["δακτύλους",703259,57],["καὶ",707031,7],["τοὺς",709436,58],["βραχίονας",702808,57],["καὶ",707031,7],["τὰ",709436,41],["σκέλη",711831,42],["καὶ",707031,7],["τοὺς",709436,58],["ἀγκῶνας",700166,57],["περιέκλων",710332,137]],"And they dragged round his fingers, and his arms, and his legs, and his ankles."],["7",[["καὶ",707031,7],["κατὰ",707200,0],["μηδένα",708857,27],["τρόπον",712980,6],["ἰσχύοντες",706859,146],["αὐτὸν",702165,85],["ἄγξαι",700207,106],["περιλύσαντες",710347,196],["τὰ",709436,41],["ὄργανα",709727,42],["σὺν",712372,0],["ἄκραις",700610,291],["ταῖς",709436,75],["τῶν",709436,80],["δακτύλων",703259,81],["κορυφαῖς",707844,76],["ἀπεσκύθιζον",701580,137]],"And not being able by any means to strangle him, they tore off his skin, together with the extreme tips of his fingers, flayed him, and then haled him to the wheel;",{"s":"d","q":0.61}],["8",[["καὶ",707031,7],["εὐθέως",705593,28],["ἦγον",700209,137],["ἐπὶ",705080,0],["τὸν",709436,5],["τροχόν",712994,6],["περὶ",710285,0],["ὃν",709781,112],["ἐκ",704132,0],["σπονδύλων",712026,81],["ἐκμελιζόμενος",704259,466],["ἑώρα",709725,13],["τὰς",709436,38],["ἑαυτοῦ",703917,102],["σάρκας",711537,39],["περιλακιζομένας",710341,714],["καὶ",707031,7],["κατὰ",707200,0],["σπλάγχνων",712018,44],["σταγόνας",712036,39],["αἵματος",700442,21],["ἀπορρεούσας",701559,338]],"around which his vertebral joints were loosened, and he saw his own flesh torn to shreds, and streams of blood flowing from his entrails.",{"s":"d","q":0.68}],["9",[["μέλλων",708705,72],["δὲ",703303,11],["ἀποθνῄσκειν",701461,55],["ἔφη",713437,13]],"And when about to die, he said,"],["10",[["ἡμεῖς",705983,219],["μέν",708730,11],["ὦ",714081,88],["μιαρώτατε",708906,710],["τύραννε",713026,153],["διὰ",703417,0],["παιδείαν",709924,9],["καὶ",707031,7],["ἀρετὴν",701727,9],["θεοῦ",706192,18],["ταῦτα",709858,71],["πάσχομεν",710183,243]],"We, O accursed tyrant, suffer this for the sake of Divine education and virtue."],["11",[["σὺ",712181,164],["δὲ",703303,11],["διὰ",703417,0],["τὴν",709436,8],["ἀσέβειαν",701904,9],["καὶ",707031,7],["μιαιφονίαν",708901,9],["ἀκαταλύτους",700525,119],["καρτερήσεις",707178,166],["βασάνους",702570,39]],"But thou, for thy impiety and blood-shedding, shalt endure indissoluble torments."],["12",[["καὶ",707031,7],["τούτου",709858,102],["θανόντος",706278,500],["ἀδελφοπρεπῶς",700248,28],["τὸν",709436,5],["τέταρτον",712811,27],["ἐπεσπῶντο",705258,139],["λέγοντες",708124,146]],"And thus having died worthily of his brethren, they dragged forward the fourth, saying,"],["13",[["μὴ",708851,28],["μανῇς",708389,279],["καὶ",707031,28],["σὺ",712181,164],["τοῖς",709436,147],["ἀδελφοῖς",700249,148],["σου",711945,133],["τὴν",709436,8],["αὐτὴν",702165,104],["μανίαν",708482,9],["ἀλλὰ",700680,7],["πεισθεὶς",710221,217],["τῷ",709436,113],["βασιλεῖ",702580,114],["σῷζε",712627,240],["σεαυτόν",711599,85]],"Do not thou share the madness of thy brethren: but give regard to the king, and save thyself."],["14",[["ὁ",709436,3],["δὲ",703303,11],["αὐτοῖς",702165,151],["ἔφη",713437,13],["οὐχ",709805,28],["οὕτως",709859,28],["καυστικώτερον",707566,489],["ἔχετε",705785,87],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["τὸ",709436,24],["πῦρ",711088,25],["ὥστε",714164,7],["με",708618,163],["δειλανδρῆσαι",703317,106]],"But he said to them, You have not a fire so scorching as to make me play the coward."],["15",[["μὰ",708295,11],["τὸν",709436,5],["μακάριον",708397,27],["τῶν",709436,80],["ἀδελφῶν",700249,81],["μου",709032,133],["θάνατον",706096,6],["καὶ",707031,7],["τὸν",709436,5],["αἰώνιον",700505,27],["τοῦ",709436,35],["τυράννου",713026,18],["ὄλεθρον",709563,6],["καὶ",707031,7],["τὸν",709436,5],["ἀΐδιον",700406,27],["τῶν",709436,80],["εὐσεβῶν",705687,169],["βίον",702724,6],["οὐκ",709805,28],["ἀρνήσομαι",701781,165],["τὴν",709436,8],["εὐγενῆ",705559,36],["ἀδελφότητα",700250,9]],"By the blessed death of my brethren, and the eternal punishment of the tyrant, and the glorious life of the pious, I will not repudiate the noble brotherhood."],["16",[["ἐπινόει",705214,240],["τύραννε",713026,153],["βασάνους",702570,39],["ἵνα",706747,7],["καὶ",707031,28],["δι᾿",703417,0],["αὐτῶν",702165,40],["μάθῃς",708480,175],["ὅτι",709803,7],["ἀδελφός",700249,4],["εἰμι",704093,157],["τῶν",709436,80],["προβασανισθέντων",710765,249]],"Invent, O tyrant, tortures; that you may learn, even through them, that I am the brother of those tormented before."],["17",[["ταῦτα",709858,71],["ἀκούσας",700587,182],["ὁ",709436,3],["αἱμοβόρος",700448,14],["καὶ",707031,7],["φονώδης",713550,14],["καὶ",707031,7],["παμμιαρώτατος",709949,140],["Ἀντίοχος",701257,4],["ἐκέλευσεν",707601,2],["τὴν",709436,8],["γλῶτταν",703120,9],["αὐτοῦ",702165,102],["ἐκτεμεῖν",704324,296]],"When he had said this, the bloodthirsty, and murderous, and unhallowed Antiochus ordered his tongue to be cut out."],["18",[["ὁ",709436,3],["δὲ",703303,11],["ἔφη",713437,13],["κἂν",707120,459],["ἀφέλῃς",702177,175],["τὸ",709436,24],["τῆς",709436,16],["φωνῆς",713640,17],["ὄργανον",709727,25],["καὶ",707031,7],["σιωπώντων",711818,170],["ἀκούει",700587,91],["ὁ",709436,3],["θεός",706192,4]],"But he said, Even if you take away the organ of speech, yet God hears the silent."],["19",[["ἰδοὺ",709725,300],["προκεχάλασται",711015,403],["ἡ",709436,10],["γλῶσσα",703120,12],["τέμνε",712791,240],["οὐ",709805,28],["γὰρ",702963,11],["παρὰ",709995,0],["τοῦτο",709858,129],["τὸν",709436,5],["λογισμὸν",708234,6],["ἡμῶν",705999,145],["γλωττοτομήσεις",703123,166]],"Behold, my tongue is extended, cut it off; for not for that shalt thou extirpate our reasoning."],["20",[["ἡδέως",705938,28],["ὑπὲρ",713111,0],["τοῦ",709436,35],["θεοῦ",706192,18],["τὰ",709436,41],["τοῦ",709436,20],["σώματος",712635,21],["μέλη",708707,42],["ἀκρωτηριαζόμεθα",700613,715]],"Gladly do we lose our limbs in behalf of God."],["21",[["σὲ",711598,163],["δὲ",703303,11],["ταχέως",712743,28],["μετελεύσεται",708827,93],["ὁ",709436,3],["θεός",706192,4],["τὴν",709436,8],["γὰρ",702963,11],["τῶν",709436,80],["θείων",706154,169],["ὕμνων",713089,81],["μελῳδὸν",708723,36],["γλῶτταν",703120,9],["ἐκτέμνεις",704324,154]],"But God shall speedily find you, since you cut off the tongue, the instrument of divine melody."]]