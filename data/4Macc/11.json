[["1",[["ὡς",714148,7],["δὲ",703303,11],["καὶ",707031,28],["οὗτος",709858,121],["ταῖς",709436,75],["βασάνοις",702570,76],["καταικισθεὶς",707256,217],["ἐναπέθανεν",704659,2],["ὁ",709436,3],["πέμπτος",710245,14],["παρεπήδησεν",710086,2],["λέγων",708124,72]],"And when he had died, disfigured in his torments, the fifth leaped forward, and said,"],["2",[["οὐ",709805,28],["μέλλω",708705,157],["τύραννε",713026,153],["πρὸς",710844,0],["τὸν",709436,5],["ὑπὲρ",713111,0],["τῆς",709436,16],["ἀρετῆς",701727,17],["βασανισμὸν",702567,6],["παραιτεῖσθαι",710033,110]],"I intend not, O tyrant, to get excused from the torment which is in behalf of virtue."],["3",[["αὐτὸς",702165,121],["δ᾿",703303,11],["ἀπ᾿",701425,0],["ἐμαυτοῦ",704545,102],["παρῆλθον",710141,150],["ὅπως",709719,7],["κἀμὲ",706969,318],["κατακτείνας",707294,182],["περὶ",710285,0],["πλειόνων",710514,83],["ἀδικημάτων",700270,44],["ὀφειλήσῃς",709865,175],["τῇ",709436,100],["οὐρανίῳ",709842,101],["δίκῃ",703702,1],["τιμωρίαν",712863,9]],"But I have come of my own accord, that by the death of me, you may owe heavenly vengeance a punishment for more crimes."],["4",[["ὦ",714081,88],["μισάρετε",708932,564],["καὶ",707031,7],["μισάνθρωπε",708931,564],["τί",712867,126],["δράσαντας",703828,454],["ἡμᾶς",705981,194],["τοῦτον",709858,85],["πορθεῖς",710669,154],["τὸν",709436,5],["τρόπον",712980,6]],"O thou hater of virtue and of men, what have we done that thou thus revellest in our blood?"],["5",[["ὅτι",709803,7],["τὸν",709436,5],["πάντων",710177,169],["κτίστην",707941,6],["εὐσεβοῦμεν",705686,243],["καὶ",707031,7],["κατὰ",707200,0],["τὸν",709436,5],["ἐνάρετον",704661,27],["αὐτοῦ",702165,102],["ζῶμεν",705851,243],["νόμον",709349,6]],"Does it seem evil to thee that we worship the Founder of all things, and live according to his surpassing law?"],["6",[["ἀλλὰ",700680,7],["ταῦτα",709858,290],["τιμῶν",712856,65],["οὐ",709805,28],["βασάνων",702570,65],["ἐστὶν",704093,91],["ἄξια",701308,195]],"But this is worthy of honours, not of torments;"],["9",[["τοιαῦτα",712878,68],["δὲ",703303,11],["λέγοντα",708124,183],["οἱ",709436,136],["δορυφόροι",703807,52],["δήσαντες",703394,196],["αὐτὸν",702165,85],["εἷλκον",704508,137],["ἐπὶ",705080,0],["τὸν",709436,5],["καταπέλτην",707357,6]],"As he said this, the spearbearers bound him, and drew him to the catapelt:"],["10",[["ἐφ᾿",705080,0],["ὃν",709781,112],["δήσαντες",703394,196],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["τὰ",709436,41],["γόνατα",703172,42],["καὶ",707031,7],["ταῦτα",709858,71],["ποδάγραις",710576,76],["σιδηραῖς",711771,291],["ἐφαρμόσαντες",705744,196],["τὴν",709436,8],["ὀσφὺν",709800,9],["αὐτοῦ",702165,102],["περὶ",710285,0],["τροχιαῖον",712989,27],["σφῆνα",712581,6],["κατέκαμψαν",707261,150],["περὶ",710285,0],["ὃν",709781,112],["ὅλος",709597,14],["περὶ",710285,0],["τὸν",709436,5],["τροχὸν",712994,6],["σκορπίου",711882,17],["τρόπον",712980,6],["ἀνακλώμενος",700972,466],["ἐξεμελίζετο",704259,530]],"to which binding him at his knees, and fastening them with iron fetters, they bent down his loins upon the wedge of the wheel; and his body was then dismembered, scorpion-fashion."],["11",[["κατὰ",707200,0],["τοῦτον",709858,85],["τὸν",709436,5],["τρόπον",712980,6],["καὶ",707031,7],["τὸ",709436,24],["πνεῦμα",710566,25],["στενοχωρούμενος",712070,122],["καὶ",707031,7],["τὸ",709436,24],["σῶμα",712635,25],["ἀγχόμενος",700207,122]],"With his breath thus confined, and his body strangled, he said,"],["12",[["καλάς",707097,119],["ἔλεγεν",708124,13],["ἄκων",700622,14],["ὦ",714081,88],["τύραννε",713026,153],["χάριτας",713735,39],["ἡμῖν",705994,90],["χαρίζῃ",713734,259],["διὰ",703417,0],["γενναιοτέρων",703048,527],["πόνων",710661,81],["ἐπιδείξασθαι",705112,109],["παρέχων",710142,72],["τὴν",709436,8],["εἰς",704105,0],["τὸν",709436,5],["νόμον",709349,6],["ἡμῶν",705999,145],["καρτερίαν",707179,9]],"A great favour thou bestowest upon us, O tyrant, by enabling us to manifest our adherence to the law by means of nobler sufferings."],["13",[["τελευτήσαντος",712781,500],["δὲ",703303,11],["καὶ",707031,7],["τούτου",709858,102],["ὁ",709436,3],["ἕκτος",704340,14],["ἤγετο",700209,19],["μειρακίσκος",708686,4],["ὃς",709781,213],["πυνθανομένου",711085,262],["τοῦ",709436,35],["τυράννου",713026,18],["εἰ",704071,7],["βούλοιτο",702795,700],["φαγὼν",705495,182],["ἀπολύεσθαι",701524,110],["ὁ",709436,3],["δὲ",703303,11],["ἔφη",713437,13]],"He also being dead, the sixth, quite a youth, was brought out; and on the tyrant asking him whether he would eat and be delivered, he said,"],["14",[["ἐγὼ",704018,164],["τῇ",709436,100],["μὲν",708730,11],["ἡλικίᾳ",705971,1],["τῶν",709436,80],["ἀδελφῶν",700249,81],["μού",709032,133],["εἰμι",704093,157],["νεώτερος",709256,224],["τῇ",709436,100],["δὲ",703303,11],["διανοίᾳ",703531,1],["ἡλικιώτης",705972,4]],"I am indeed younger than my brothers, but in understanding I am as old;"],["15",[["εἰς",704105,0],["ταὐτὰ",709436,71],["γὰρ",702963,11],["γεννηθέντες",703051,247],["καὶ",707031,7],["ἀνατραφέντες",701074,247],["ὑπὲρ",713111,0],["τῶν",709436,80],["αὐτῶν",702165,40],["καὶ",707031,28],["ἀποθνῄσκειν",701461,55],["ὀφείλομεν",709865,243],["ὁμοίως",709630,28]],"for having been born and reared unto the same end, we are bound to die also in behalf of the same cause."],["16",[["ὥστε",714164,7],["εἴ",704071,7],["σοι",711925,159],["δοκεῖ",703775,91],["βασανίζειν",702566,55],["μὴ",708851,28],["μιαροφαγοῦντα",708907,183],["βασάνιζε",702566,240]],"So that if thou think proper to torment us for not eating the unclean;—torment!"],["17",[["ταῦτα",709858,71],["αὐτὸν",702165,85],["εἰπόντα",705373,365],["παρῆγον",710007,137],["ἐπὶ",705080,0],["τὸν",709436,5],["τροχόν",712994,6]],"As he said this, they brought him to the wheel."],["18",[["ἐφ᾿",705080,0],["οὗ",709781,48],["κατατεινόμενος",707454,466],["ἐπιμελῶς",705200,28],["καὶ",707031,7],["ἐκσπονδυλιζόμενος",704313,466],["ὑπεκαίετο",713202,530]],"Extended upon which, with limbs racked and dislocated, he was gradually roasted from beneath.",{"s":"d","q":0.67}],["19",[["καὶ",707031,7],["ὀβελίσκους",709440,57],["ὀξεῖς",709682,60],["πυρώσαντες",711103,196],["τοῖς",709436,95],["νώτοις",709403,96],["προσέφερον",710974,137],["καὶ",707031,7],["τὰ",709436,41],["πλευρὰ",710525,42],["διαπείραντες",703541,196],["αὐτοῦ",702165,102],["τὰ",709436,41],["σπλάγχνα",712018,42],["διέκαιον",703465,137]],"And having heated sharp spits, they approached them to his back; and having transfixed his sides, they burned away his entrails."],["20",[["ὁ",709436,3],["δὲ",703303,11],["βασανιζόμενος",702566,466],["ὦ",714081,88],["ἱεροπρεποῦς",706632,116],["ἀγῶνος",700211,18],["ἔλεγεν",708124,13],["ἐφ᾿",705080,0],["ὃν",709781,112],["διὰ",703417,0],["τὴν",709436,8],["εὐσέβειαν",705685,9],["εἰς",704105,0],["γυμνασίαν",703200,9],["πόνων",710661,81],["ἀδελφοὶ",700249,52],["τοσοῦτοι",712907,138],["κληθέντες",707084,247],["οὐκ",709805,28],["ἐνικήθημεν",709309,485]],"And he, while tormented, said, O period good and holy, in which, for the sake of religion, we brothers have been called to the contest of pain, and have not been conquered."],["21",[["ἀνίκητος",701170,29],["γάρ",702963,11],["ἐστιν",704093,91],["ὦ",714081,88],["τύραννε",713026,153],["ἡ",709436,10],["εὐσεβὴς",705687,29],["ἐπιστήμη",705267,12]],"For religious understanding, O tyrant, is unconquered."],["22",[["καλοκἀγαθίᾳ",707096,1],["καθωπλισμένος",707018,419],["τεθνήξομαι",712753,181],["κἀγὼ",706969,288],["μετὰ",708780,0],["τῶν",709436,80],["ἀδελφῶν",700249,81],["μου",709032,133]],"Armed with upright virtue, I also shall depart with my brethren."],["23",[["μέγαν",708653,27],["σοὶ",711925,159],["καὶ",707031,7],["αὐτὸς",702165,121],["προσβάλλων",710865,72],["ἀλάστορα",700636,6],["καινουργὲ",707044,564],["τῶν",709436,130],["βασάνων",702570,65],["καὶ",707031,7],["πολέμιε",710603,564],["τῶν",709436,80],["ἀληθῶς",700662,28],["εὐσεβούντων",705686,170]],"I, too, bearing with me a great avenger, O deviser of tortures, and enemy of the truly pious."],["24",[["ἓξ",704828,59],["μειράκια",708685,64],["καταλελύκαμέν",707323,314],["σου",711945,133],["τὴν",709436,8],["τυραννίδα",713025,9]],"We six youths have destroyed thy tyranny."],["25",[["τὸ",709436,24],["γὰρ",702963,11],["μὴ",708851,28],["δυνηθῆναί",703838,179],["σε",711598,163],["μεταπεῖσαι",708813,106],["τὸν",709436,5],["λογισμὸν",708234,6],["ἡμῶν",705999,145],["μήτε",708891,7],["βιάσασθαι",702713,109],["πρὸς",710844,0],["τὴν",709436,8],["μιαροφαγίαν",708908,9],["οὐ",709805,28],["κατάλυσίς",707321,12],["ἐστίν",704093,91],["σου",711945,133]],"For is not your inability to overrule our reasoning, and to compel us to eat the unclean, thy destruction?"],["26",[["τὸ",709436,34],["πῦρ",711088,15],["σου",711945,133],["ψυχρὸν",714075,26],["ἡμῖν",705994,90],["καὶ",707031,7],["ἄπονοι",701536,138],["οἱ",709436,136],["καταπέλται",707357,52],["καὶ",707031,7],["ἀδύνατος",700297,29],["ἡ",709436,10],["βία",702712,12],["σου",711945,133]],"Your fire is cold to us, your catapelts are painless, and your violence harmless."],["27",[["οὐ",709805,28],["γὰρ",702963,11],["τυράννου",713026,18],["ἀλλὰ",700680,7],["θείου",706154,116],["νόμου",709349,18],["προεστήκασιν",710803,353],["ἡμῶν",705999,145],["οἱ",709436,136],["δορυφόροι",703807,52],["διὰ",703417,0],["τοῦτο",709858,129],["ἀνίκητον",701170,27],["ἔχομεν",705785,243],["τὸν",709436,5],["λογισμόν",708234,6]],"For the guards not of a tyrant but of a divine law are our defenders: through this we keep our reasoning unconquered."]]