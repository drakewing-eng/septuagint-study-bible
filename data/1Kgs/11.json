[["1",[["καὶ",707031,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["Σαλωμων",711430,4],["ἦν",704093,13],["φιλογύναιος",713478,14],["καὶ",707031,7],["ἦσαν",704093,137],["αὐτῷ",702165,50],["ἄρχουσαι",701860,306],["ἑπτακόσιαι",705365,192],["καὶ",707031,7],["παλλακαὶ",709943,191],["τριακόσιαι",712936,192],["καὶ",707031,7],["ἔλαβεν",708076,2],["γυναῖκας",703209,39],["ἀλλοτρίας",700699,119],["καὶ",707031,7],["τὴν",709436,8],["θυγατέρα",706320,9],["Φαραω",713360,18],["Μωαβίτιδας",709089,39],["Αμμανίτιδας",700840,39],["Σύρας",712532,39],["καὶ",707031,7],["Ιδουμαίας",706503,39],["Χετταίας",713837,39],["καὶ",707031,7],["Αμορραίας",700864,39]],"And king Solomon was a lover of women. And he had seven hundred wives, princesses, and three hundred concubines. And he took strange women, as well as the daughter of Pharao, Moabitish, Ammanitish women, Syrians and Idumeans, Chettites, and Amorites;"],["2",[["ἐκ",704132,0],["τῶν",709436,43],["ἐθνῶν",704068,44],["ὧν",709781,103],["ἀπεῖπεν",701378,2],["κύριος",707996,4],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["οὐκ",709805,28],["εἰσελεύσεσθε",704114,124],["εἰς",704105,0],["αὐτούς",702165,62],["καὶ",707031,7],["αὐτοὶ",702165,201],["οὐκ",709805,28],["εἰσελεύσονται",704114,135],["εἰς",704105,0],["ὑμᾶς",713080,194],["μὴ",708851,28],["ἐκκλίνωσιν",704220,271],["τὰς",709436,38],["καρδίας",707141,39],["ὑμῶν",713091,145],["ὀπίσω",709697,0],["εἰδώλων",704079,44],["αὐτῶν",702165,40],["εἰς",704105,0],["αὐτοὺς",702165,62],["ἐκολλήθη",707791,37],["Σαλωμων",711430,4],["τοῦ",709436,20],["ἀγαπῆσαι",700120,106]],"of the nations concerning whom the Lord forbade the children of Israel, [saying], Ye shall not go in to them, and they shall not come in to you, lest they turn away your hearts after their idols: Solomon clave to these in love."],["4",[["καὶ",707031,7],["ἐγενήθη",703104,37],["ἐν",704639,0],["καιρῷ",707047,114],["γήρους",703089,21],["Σαλωμων",711430,18],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ἡ",709436,10],["καρδία",707141,12],["αὐτοῦ",702165,102],["τελεία",712769,68],["μετὰ",708780,0],["κυρίου",707996,18],["θεοῦ",706192,18],["αὐτοῦ",702165,102],["καθὼς",707030,28],["ἡ",709436,10],["καρδία",707141,12],["Δαυιδ",703232,18],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐξέκλιναν",704220,150],["αἱ",709436,190],["γυναῖκες",703209,191],["αἱ",709436,190],["ἀλλότριαι",700699,192],["τὴν",709436,8],["καρδίαν",707141,9],["αὐτοῦ",702165,102],["ὀπίσω",709697,0],["θεῶν",706192,81],["αὐτῶν",702165,40]],"And it came to pass in the time of the old age of Solomon, that his heart was not perfect with the Lord his God, as [was] the heart of David his father. And the strange women turned away his heart after their gods."],["5",[["τότε",712908,28],["ᾠκοδόμησεν",709509,2],["Σαλωμων",711430,4],["ὑψηλὸν",713285,27],["τῷ",709436,113],["Χαμως",713707,114],["εἰδώλῳ",704079,54],["Μωαβ",709085,18],["καὶ",707031,7],["τῷ",709436,113],["βασιλεῖ",702580,114],["αὐτῶν",702165,40],["εἰδώλῳ",704079,54],["υἱῶν",713075,81],["Αμμων",700847,18]],"Then Solomon built a high place to Chamos the idol of Moab, and to their king the idol of the children of Ammon,"],["6",[["καὶ",707031,7],["τῇ",709436,100],["Ἀστάρτῃ",702008,1],["βδελύγματι",702604,54],["Σιδωνίων",711776,81]],"and to Astarte the abomination of the Sidonians."],["7",[["καὶ",707031,7],["οὕτως",709859,28],["ἐποίησεν",710582,2],["πάσαις",710177,291],["ταῖς",709436,75],["γυναιξὶν",703209,76],["αὐτοῦ",702165,102],["ταῖς",709436,75],["ἀλλοτρίαις",700699,291],["ἐθυμίων",706329,137],["καὶ",707031,7],["ἔθυον",706349,137],["τοῖς",709436,95],["εἰδώλοις",704079,96],["αὐτῶν",702165,40]],"And thus he acted towards all his strange wives, who burnt incense and sacrificed to their idols."],["8",[["καὶ",707031,7],["ἐποίησεν",710582,2],["Σαλωμων",711430,4],["τὸ",709436,24],["πονηρὸν",710660,46],["ἐνώπιον",704823,0],["κυρίου",707996,18],["οὐκ",709805,28],["ἐπορεύθη",710667,37],["ὀπίσω",709697,0],["κυρίου",707996,18],["ὡς",714148,7],["Δαυιδ",703232,4],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτοῦ",702165,102]],"And Solomon did that which was evil in the sight of the Lord: he went not after the Lord, as David his father."],["9",[["καὶ",707031,7],["ὠργίσθη",709729,37],["κύριος",707996,4],["ἐπὶ",705080,0],["Σαλωμων",711430,18],["ὅτι",709803,7],["ἐξέκλινεν",704220,13],["καρδίαν",707141,9],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["κυρίου",707996,18],["θεοῦ",706192,18],["Ισραηλ",706839,18],["τοῦ",709436,35],["ὀφθέντος",709725,319],["αὐτῷ",702165,50],["δὶς",703741,28]],"And the Lord was angry with Solomon, because he turned away his heart from the Lord God of Israel, who had appeared twice to him,"],["10",[["καὶ",707031,7],["ἐντειλαμένου",704791,292],["αὐτῷ",702165,50],["ὑπὲρ",713111,0],["τοῦ",709436,35],["λόγου",708236,18],["τούτου",709858,102],["τὸ",709436,24],["παράπαν",710083,28],["μὴ",708851,28],["πορευθῆναι",710667,179],["ὀπίσω",709697,0],["θεῶν",706192,81],["ἑτέρων",705535,169],["καὶ",707031,7],["φυλάξασθαι",713619,109],["ποιῆσαι",710582,106],["ἃ",709781,69],["ἐνετείλατο",704791,23],["αὐτῷ",702165,50],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4]],"and charged him concerning this matter, by no means to go after other gods, but to take heed to do what the Lord God commanded him; neither was his heart perfect with the Lord, according to the heart of David his father.",{"s":"d","q":0.64}],["11",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Σαλωμων",711430,6],["ἀνθ᾿",701227,0],["ὧν",709781,252],["ἐγένετο",703104,23],["ταῦτα",709858,71],["μετὰ",708780,0],["σοῦ",711945,133],["καὶ",707031,7],["οὐκ",709805,28],["ἐφύλαξας",713619,162],["τὰς",709436,38],["ἐντολάς",704802,39],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,41],["προστάγματά",710959,42],["μου",709032,133],["ἃ",709781,69],["ἐνετειλάμην",704791,161],["σοι",711925,159],["διαρρήσσων",703565,72],["διαρρήξω",703565,165],["τὴν",709436,8],["βασιλείαν",702577,9],["σου",711945,133],["ἐκ",704132,0],["χειρός",713787,17],["σου",711945,133],["καὶ",707031,7],["δώσω",703654,165],["αὐτὴν",702165,104],["τῷ",709436,113],["δούλῳ",703817,114],["σου",711945,133]],"And the Lord said to Solomon, Because it has been thus with thee, and thou hast not kept my commandments and my ordinances which I commanded thee, I will surely rend thy kingdom out of thy hand, and give it to thy servant."],["12",[["πλὴν",710540,28],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["σου",711945,133],["οὐ",709805,28],["ποιήσω",710582,207],["αὐτὰ",702165,71],["διὰ",703417,0],["Δαυιδ",703232,6],["τὸν",709436,5],["πατέρα",710189,6],["σου",711945,133],["ἐκ",704132,0],["χειρὸς",713787,17],["υἱοῦ",713075,18],["σου",711945,133],["λήμψομαι",708076,181],["αὐτήν",702165,104]],"Only in thy days I will not do it for David thy father's sake: [but] I will take it out of the hand of thy son."],["13",[["πλὴν",710540,28],["ὅλην",709597,36],["τὴν",709436,8],["βασιλείαν",702577,9],["οὐ",709805,28],["μὴ",708851,28],["λάβω",708076,207],["σκῆπτρον",711851,25],["ἓν",704106,46],["δώσω",703654,165],["τῷ",709436,113],["υἱῷ",713075,114],["σου",711945,133],["διὰ",703417,0],["Δαυιδ",703232,6],["τὸν",709436,5],["δοῦλόν",703817,6],["μου",709032,133],["καὶ",707031,7],["διὰ",703417,0],["Ιερουσαλημ",706644,9],["τὴν",709436,8],["πόλιν",710612,9],["ἣν",709781,131],["ἐξελεξάμην",704236,161]],"Only I will not take away the whole kingdom: I will give one tribe to thy son for David my servant's sake, and for the sake of Jerusalem, the city which I have chosen."],["14",[["καὶ",707031,7],["ἤγειρεν",703949,13],["κύριος",707996,4],["σαταν",711549,6],["τῷ",709436,113],["Σαλωμων",711430,114],["τὸν",709436,5],["Αδερ",700252,6],["τὸν",709436,5],["Ιδουμαῖον",706504,6],["καὶ",707031,7],["τὸν",709436,5],["Εσρωμ",705510,6],["υἱὸν",713075,6],["Ελιαδαε",704449,18],["τὸν",709436,5],["ἐν",704639,0],["Ραεμμαθ",711150,111],["Αδραζαρ",700289,6],["βασιλέα",702580,6],["Σουβα",711948,118],["κύριον",707996,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["συνηθροίσθησαν",712378,99],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["ἄνδρες",701150,52],["καὶ",707031,7],["ἦν",704093,13],["ἄρχων",701862,4],["συστρέμματος",712561,21],["καὶ",707031,7],["προκατελάβετο",710809,23],["τὴν",709436,8],["Δαμασεκ",703273,9],["καὶ",707031,7],["ἦσαν",704093,137],["σαταν",711549,4],["τῷ",709436,113],["Ισραηλ",706839,114],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["Σαλωμων",711430,18],["καὶ",707031,7],["Αδερ",700252,4],["ὁ",709436,3],["Ιδουμαῖος",706504,4],["ἐκ",704132,0],["τοῦ",709436,20],["σπέρματος",712008,21],["τῆς",709436,16],["βασιλείας",702577,17],["ἐν",704639,0],["Ιδουμαίᾳ",706503,1]],"And the Lord raised up an enemy to Solomon, Ader the Idumæan, and Esrom son of Eliadaë who [dwelt] in Raama, [and] Adadezer king of Suba his master; (and men gathered to him, and he was head of the conspiracy, and he seized on Damasec,) and they were adversaries to Israel all the days of Solomon: and Ader the Idumæan [was] of the seed royal in Idumæa."],["15",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["τῷ",709436,53],["ἐξολεθρεῦσαι",704956,106],["Δαυιδ",703232,6],["τὸν",709436,5],["Εδωμ",704041,6],["ἐν",704639,0],["τῷ",709436,113],["πορευθῆναι",710667,179],["Ιωαβ",706877,6],["ἄρχοντα",701862,6],["τῆς",709436,16],["στρατιᾶς",712145,17],["θάπτειν",706103,55],["τοὺς",709436,58],["τραυματίας",712921,57],["ἔκοψαν",707829,150],["πᾶν",710177,26],["ἀρσενικὸν",701817,27],["ἐν",704639,0],["τῇ",709436,100],["Ιδουμαίᾳ",706503,1]],"And it happened, that while David was utterly destroying Edom, while Joab captain of the host was going to bury the dead, when they slew every male in Idumæa;"],["16",[["ὅτι",709803,7],["ἓξ",704828,59],["μῆνας",708874,57],["ἐνεκάθητο",703952,13],["ἐκεῖ",704181,28],["Ιωαβ",706877,4],["καὶ",707031,7],["πᾶς",710177,14],["Ισραηλ",706839,4],["ἐν",704639,0],["τῇ",709436,100],["Ιδουμαίᾳ",706503,1],["ἕως",705792,0],["ὅτου",709793,581],["ἐξωλέθρευσεν",704956,2],["πᾶν",710177,46],["ἀρσενικὸν",701817,46],["ἐκ",704132,0],["τῆς",709436,16],["Ιδουμαίας",706503,17]],"(for Joab and all Israel abode there six months in Idumæa, until he utterly destroyed every male in Idumæa;)"],["17",[["καὶ",707031,7],["ἀπέδρα",701448,2],["Αδερ",700252,4],["αὐτὸς",702165,121],["καὶ",707031,7],["πάντες",710177,138],["ἄνδρες",701150,52],["Ιδουμαῖοι",706504,52],["τῶν",709436,80],["παίδων",709932,81],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἰσῆλθον",704114,150],["εἰς",704105,0],["Αἴγυπτον",700401,9],["καὶ",707031,7],["Αδερ",700252,4],["παιδάριον",709923,15],["μικρόν",708915,14]],"that Ader ran away, he and all the Idumæans of the servants of his father with him; and they went into Egypt; and Ader [was then] a little child."],["18",[["καὶ",707031,7],["ἀνίστανται",701173,269],["ἄνδρες",701150,52],["ἐκ",704132,0],["τῆς",709436,16],["πόλεως",710612,17],["Μαδιαμ",708355,18],["καὶ",707031,7],["ἔρχονται",705453,269],["εἰς",704105,0],["Φαραν",713358,227],["καὶ",707031,7],["λαμβάνουσιν",708076,197],["ἄνδρας",701150,57],["μετ᾿",708780,0],["αὐτῶν",702165,40],["καὶ",707031,7],["ἔρχονται",705453,269],["πρὸς",710844,0],["Φαραω",713360,6],["βασιλέα",702580,6],["Αἰγύπτου",700401,17],["καὶ",707031,7],["εἰσῆλθεν",704114,2],["Αδερ",700252,4],["πρὸς",710844,0],["Φαραω",713360,6],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["οἶκον",709516,6],["καὶ",707031,7],["ἄρτους",701829,57],["διέταξεν",703603,2],["αὐτῷ",702165,50]],"And there rise up men out of the city of Madiam, and they come to Pharan, and take men with them, and come to Pharao king of Egypt: and Ader went in to Pharao, and he gave him a house, and appointed him provision."],["19",[["καὶ",707031,7],["εὗρεν",705676,2],["Αδερ",700252,4],["χάριν",713735,9],["ἐναντίον",704654,0],["Φαραω",713360,18],["σφόδρα",712586,28],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["γυναῖκα",703209,9],["ἀδελφὴν",700244,9],["τῆς",709436,16],["γυναικὸς",703209,17],["αὐτοῦ",702165,102],["ἀδελφὴν",700244,9],["Θεκεμινας",706157,17],["τὴν",709436,8],["μείζω",708653,27]],"And Ader found great favour in the sight of Pharao, and he gave him his wife's sister in marriage, the elder sister of Thekemina.",{"s":"d","q":0.62}],["20",[["καὶ",707031,7],["ἔτεκεν",712853,2],["αὐτῷ",702165,50],["ἡ",709436,10],["ἀδελφὴ",700244,12],["Θεκεμινας",706157,17],["τῷ",709436,113],["Αδερ",700252,114],["τὸν",709436,5],["Γανηβαθ",702961,6],["υἱὸν",713075,6],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐξέθρεψεν",704342,2],["αὐτὸν",702165,85],["Θεκεμινα",706157,12],["ἐν",704639,0],["μέσῳ",708768,97],["υἱῶν",713075,81],["Φαραω",713360,18],["καὶ",707031,7],["ἦν",704093,13],["Γανηβαθ",702961,4],["ἐν",704639,0],["μέσῳ",708768,97],["υἱῶν",713075,81],["Φαραω",713360,18]],"And the sister of Thekemina bore to him, [even] to Ader, Ganebath her son; and Thekemina brought him up in the midst of the sons of Pharao, and Ganebath was in the midst of the sons of Pharao.",{"s":"d","q":0.55}],["21",[["καὶ",707031,7],["Αδερ",700252,4],["ἤκουσεν",700587,2],["ἐν",704639,0],["Αἰγύπτῳ",700401,1],["ὅτι",709803,7],["κεκοίμηται",707767,187],["Δαυιδ",703232,4],["μετὰ",708780,0],["τῶν",709436,80],["πατέρων",710189,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὅτι",709803,7],["τέθνηκεν",706278,171],["Ιωαβ",706877,4],["ὁ",709436,3],["ἄρχων",701862,4],["τῆς",709436,16],["στρατιᾶς",712145,17],["καὶ",707031,7],["εἶπεν",705373,2],["Αδερ",700252,4],["πρὸς",710844,0],["Φαραω",713360,6],["ἐξαπόστειλόν",704872,176],["με",708618,163],["καὶ",707031,7],["ἀποστρέψω",701598,165],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["μου",709032,133]],"And Ader heard in Egypt that David slept with his fathers, and that Joab the captain of the host was dead; and Ader said to Pharao, Let me go, and I will return to my country."],["22",[["καὶ",707031,7],["εἶπεν",705373,2],["Φαραω",713360,4],["τῷ",709436,113],["Αδερ",700252,114],["τίνι",712867,356],["σὺ",712181,164],["ἐλαττονῇ",704392,204],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["ἰδοὺ",706497,88],["σὺ",712181,