 David his father."],["28",[["καὶ",707031,7],["ὁ",709436,3],["ἄνθρωπος",701163,4],["Ιεροβοαμ",706629,4],["ἰσχυρὸς",706855,14],["δυνάμει",703839,1],["καὶ",707031,7],["εἶδεν",709725,2],["Σαλωμων",711430,4],["τὸ",709436,24],["παιδάριον",709923,25],["ὅτι",709803,7],["ἀνὴρ",701150,4],["ἔργων",705396,44],["ἐστίν",704093,91],["καὶ",707031,7],["κατέστησεν",707011,2],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["τὰς",709436,38],["ἄρσεις",701820,39],["οἴκου",709516,18],["Ιωσηφ",706948,18]],"And the man Jeroboam was very strong; and Solomon saw the young man that he was active, and he set him over the levies of the house of Joseph."],["29",[["καὶ",707031,7],["ἐγενήθη",703104,37],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["καὶ",707031,7],["Ιεροβοαμ",706629,4],["ἐξῆλθεν",704909,2],["ἐξ",704132,0],["Ιερουσαλημ",706644,17],["καὶ",707031,7],["εὗρεν",705676,2],["αὐτὸν",702165,85],["Αχιας",702265,4],["ὁ",709436,3],["Σηλωνίτης",711742,4],["ὁ",709436,3],["προφήτης",711009,4],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["καὶ",707031,7],["ἀπέστησεν",702214,2],["αὐτὸν",702165,85],["ἐκ",704132,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["καὶ",707031,7],["ὁ",709436,3],["Αχιας",702265,4],["περιβεβλημένος",710294,419],["ἱματίῳ",706742,54],["καινῷ",707042,97],["καὶ",707031,7],["ἀμφότεροι",700892,138],["ἐν",704639,0],["τῷ",709436,53],["πεδίῳ",710215,54]],"And it came to pass at that time, that Jeroboam went forth from Jerusalem, and Achia the Selonite the prophet found him in the way, and caused him to turn aside out of the way: and Achia was clad with a new garment, and they two [were] alone in the field."],["30",[["καὶ",707031,7],["ἐπελάβετο",705185,23],["Αχια",702262,4],["τοῦ",709436,20],["ἱματίου",706742,21],["αὐτοῦ",702165,102],["τοῦ",709436,20],["καινοῦ",707042,92],["τοῦ",709436,20],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["καὶ",707031,7],["διέρρηξεν",703565,2],["αὐτὸ",702165,129],["δώδεκα",703887,59],["ῥήγματα",711242,42]],"And Achia laid hold of his new garment that was upon him, and tore it [into] twelve pieces:"],["31",[["καὶ",707031,7],["εἶπεν",705373,2],["τῷ",709436,113],["Ιεροβοαμ",706629,114],["λαβὲ",708076,176],["σεαυτῷ",711599,50],["δέκα",703333,59],["ῥήγματα",711242,42],["ὅτι",709803,7],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ῥήσσω",711243,157],["τὴν",709436,8],["βασιλείαν",702577,9],["ἐκ",704132,0],["χειρὸς",713787,17],["Σαλωμων",711430,18],["καὶ",707031,7],["δώσω",703654,165],["σοι",711925,159],["δέκα",703333,59],["σκῆπτρα",711851,42]],"and he said to Jeroboam, Take to thyself ten pieces, for thus saith the Lord God of Israel, Behold, I rend the kingdom out of the hand of Solomon, and will give thee ten tribes."],["32",[["καὶ",707031,7],["δύο",703849,59],["σκῆπτρα",711851,42],["ἔσονται",704093,135],["αὐτῷ",702165,50],["διὰ",703417,0],["τὸν",709436,5],["δοῦλόν",703817,6],["μου",709032,133],["Δαυιδ",703232,6],["καὶ",707031,7],["διὰ",703417,0],["Ιερουσαλημ",706644,9],["τὴν",709436,8],["πόλιν",710612,9],["ἣν",709781,131],["ἐξελεξάμην",704236,161],["ἐν",704639,0],["αὐτῇ",702165,105],["ἐκ",704132,0],["πασῶν",710177,198],["φυλῶν",713620,65],["Ισραηλ",706839,18]],"Yet he shall have two tribes, for my servant David's sake, and for the sake of Jerusalem, the city which I have chosen out of all the tribes of Israel."],["33",[["ἀνθ᾿",701227,0],["ὧν",709781,252],["κατέλιπέν",707305,2],["με",708618,163],["καὶ",707031,7],["ἐποίησεν",710582,2],["τῇ",709436,100],["Ἀστάρτῃ",702008,1],["βδελύγματι",702604,54],["Σιδωνίων",711776,81],["καὶ",707031,7],["τῷ",709436,113],["Χαμως",713707,114],["καὶ",707031,7],["τοῖς",709436,95],["εἰδώλοις",704079,96],["Μωαβ",709085,18],["καὶ",707031,7],["τῷ",709436,113],["βασιλεῖ",702580,114],["αὐτῶν",702165,40],["προσοχθίσματι",710946,54],["υἱῶν",713075,81],["Αμμων",700847,18],["καὶ",707031,7],["οὐκ",709805,28],["ἐπορεύθη",710667,37],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["μου",709032,133],["τοῦ",709436,20],["ποιῆσαι",710582,106],["τὸ",709436,24],["εὐθὲς",705596,46],["ἐνώπιον",704823,0],["ἐμοῦ",704580,133],["ὡς",714148,7],["Δαυιδ",703232,4],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτοῦ",702165,102]],"Because he forsook me, and sacrificed to Astarte the abomination of the Sidonians, and to Chamos, and to the idols of Moab, and to their king the abomination of the children of Ammon, and he walked not in my ways, to do that which was right before me, as David his father [did]."],["34",[["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["λάβω",708076,207],["ὅλην",709597,36],["τὴν",709436,8],["βασιλείαν",702577,9],["ἐκ",704132,0],["χειρὸς",713787,17],["αὐτοῦ",702165,102],["διότι",703734,7],["ἀντιτασσόμενος",701276,122],["ἀντιτάξομαι",701276,181],["αὐτῷ",702165,50],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["τῆς",709436,16],["ζωῆς",705910,17],["αὐτοῦ",702165,102],["διὰ",703417,0],["Δαυιδ",703232,6],["τὸν",709436,5],["δοῦλόν",703817,6],["μου",709032,133],["ὃν",709781,112],["ἐξελεξάμην",704236,161],["αὐτόν",702165,85]],"Howbeit I will not take the whole kingdom out of his hand, (for I will certainly resist him all the days of his life,) for David my servant's sake, whom I have chosen."],["35",[["καὶ",707031,7],["λήμψομαι",708076,181],["τὴν",709436,8],["βασιλείαν",702577,9],["ἐκ",704132,0],["χειρὸς",713787,17],["τοῦ",709436,35],["υἱοῦ",713075,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["δώσω",703654,165],["σοι",711925,159],["τὰ",709436,41],["δέκα",703333,59],["σκῆπτρα",711851,42]],"But I will take the kingdom out of the hand of his son, and give thee ten tribes."],["36",[["τῷ",709436,113],["δὲ",703303,11],["υἱῷ",713075,114],["αὐτοῦ",702165,102],["δώσω",703654,165],["τὰ",709436,41],["δύο",703849,59],["σκῆπτρα",711851,42],["ὅπως",709719,7],["ᾖ",704093,204],["θέσις",706223,12],["τῷ",709436,113],["δούλῳ",703817,114],["μου",709032,133],["Δαυιδ",703232,114],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["ἐνώπιον",704823,