[["1",[["καὶ",707031,7],["εἶπεν",705373,2],["Ηλιου",705975,4],["ὁ",709436,3],["προφήτης",711009,4],["ὁ",709436,3],["Θεσβίτης",706221,4],["ἐκ",704132,0],["Θεσβων",706222,118],["τῆς",709436,16],["Γαλααδ",702920,17],["πρὸς",710844,0],["Αχααβ",702243,6],["ζῇ",705851,91],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,130],["δυνάμεων",703839,65],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ᾧ",709781,309],["παρέστην",710152,155],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["εἰ",704071,7],["ἔσται",704093,93],["τὰ",709436,41],["ἔτη",705543,42],["ταῦτα",709858,71],["δρόσος",703835,12],["καὶ",707031,7],["ὑετὸς",713074,4],["ὅτι",709803,7],["εἰ",704071,7],["μὴ",708851,28],["διὰ",703417,0],["στόματος",712125,21],["λόγου",708236,18],["μου",709032,133]],"And Eliu the prophet, the Thesbite of Thesbæ of Galaad, said to Achaab, As the Lord God of hosts, the God of Israel, lives, before whom I stand, there shall not be these years dew nor rain, except by the word of my mouth."],["2",[["καὶ",707031,7],["ἐγένετο",703104,23],["ῥῆμα",711246,15],["κυρίου",707996,18],["πρὸς",710844,0],["Ηλιου",705975,6]],"And the word of the Lord came to Eliu, [saying],"],["3",[["πορεύου",710667,240],["ἐντεῦθεν",704793,28],["κατὰ",707200,0],["ἀνατολὰς",701071,39],["καὶ",707031,7],["κρύβηθι",707923,244],["ἐν",704639,0],["τῷ",709436,113],["χειμάρρῳ",713783,114],["Χορραθ",713916,118],["τοῦ",709436,35],["ἐπὶ",705080,0],["προσώπου",710986,21],["τοῦ",709436,35],["Ιορδάνου",706763,18]],"Depart hence eastward, and hide thee by the brook of Chorrath, that is before Jordan."],["4",[["καὶ",707031,7],["ἔσται",704093,93],["ἐκ",704132,0],["τοῦ",709436,35],["χειμάρρου",713783,18],["πίεσαι",710478,176],["ὕδωρ",713071,25],["καὶ",707031,7],["τοῖς",709436,147],["κόραξιν",707831,148],["ἐντελοῦμαι",704791,254],["διατρέφειν",703613,55],["σε",711598,163],["ἐκεῖ",704181,28]],"And it shall be [that] thou shalt drink water of the brook, and I will charge the ravens to feed thee there."],["5",[["καὶ",707031,7],["ἐποίησεν",710582,2],["Ηλιου",705975,4],["κατὰ",707200,0],["τὸ",709436,24],["ῥῆμα",711246,25],["κυρίου",707996,18],["καὶ",707031,7],["ἐκάθισεν",707006,2],["ἐν",704639,0],["τῷ",709436,113],["χειμάρρῳ",713783,114],["Χορραθ",713916,18],["ἐπὶ",705080,0],["προσώπου",710986,21],["τοῦ",709436,35],["Ιορδάνου",706763,18]],"And Eliu did according to the word of the Lord, and he sat by the brook of Chorrath before Jordan."],["6",[["καὶ",707031,7],["οἱ",709436,136],["κόρακες",707831,52],["ἔφερον",713428,137],["αὐτῷ",702165,50],["ἄρτους",701829,57],["τὸ",709436,24],["πρωὶ",711021,28],["καὶ",707031,7],["κρέα",707889,42],["τὸ",709436,24],["δείλης",703318,17],["καὶ",707031,7],["ἐκ",704132,0],["τοῦ",709436,35],["χειμάρρου",713783,18],["ἔπινεν",710478,13],["ὕδωρ",713071,25]],"And the ravens brought him loaves in the morning, and flesh in the evening, and he drank water of the brook."],["7",[["καὶ",707031,7],["ἐγένετο",703104,23],["μετὰ",708780,0],["ἡμέρας",705984,39],["καὶ",707031,7],["ἐξηράνθη",709419,37],["ὁ",709436,3],["χειμάρρους",713783,4],["ὅτι",709803,7],["οὐκ",709805,28],["ἐγένετο",703104,23],["ὑετὸς",713074,4],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"And it came to pass after some time, that the brook was dried up, because there had been no rain upon the earth."],["8",[["καὶ",707031,7],["ἐγένετο",703104,23],["ῥῆμα",711246,15],["κυρίου",707996,18],["πρὸς",710844,0],["Ηλιου",705975,6]],"And the word of the Lord came to Eliu, [saying],"],["9",[["ἀνάστηθι",701173,244],["καὶ",707031,7],["πορεύου",710667,253],["εἰς",704105,0],["Σαρεπτα",711529,9],["τῆς",709436,16],["Σιδωνίας",711776,17],["ἰδοὺ",706497,88],["ἐντέταλμαι",704791,326],["ἐκεῖ",704181,28],["γυναικὶ",703209,1],["χήρᾳ",713848,1],["τοῦ",709436,20],["διατρέφειν",703613,55],["σε",711598,163]],"Arise, and go to Sarepta of the Sidonian [land]: behold, I have there commanded a widow-woman to maintain thee."],["10",[["καὶ",707031,7],["ἀνέστη",701173,2],["καὶ",707031,7],["ἐπορεύθη",710667,37],["εἰς",704105,0],