[["1",[["καὶ",707031,7],["ἐχορήγουν",713911,137],["οἱ",709436,136],["καθεσταμένοι",707011,429],["οὕτως",709859,28],["τῷ",709436,113],["βασιλεῖ",702580,114],["Σαλωμων",711430,114],["καὶ",707031,7],["πάντα",710177,195],["τὰ",709436,63],["διαγγέλματα",703433,64],["ἐπὶ",705080,0],["τὴν",709436,8],["τράπεζαν",712919,9],["τοῦ",709436,35],["βασιλέως",702580,18],["ἕκαστος",704133,14],["μῆνα",708874,6],["αὐτοῦ",702165,102],["οὐ",709805,28],["παραλλάσσουσιν",710066,197],["λόγον",708236,6],["καὶ",707031,7],["τὰς",709436,38],["κριθὰς",707900,39],["καὶ",707031,7],["τὸ",709436,24],["ἄχυρον",702316,25],["τοῖς",709436,147],["ἵπποις",706790,148],["καὶ",707031,7],["τοῖς",709436,95],["ἅρμασιν",701768,96],["ᾖρον",700473,137],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["οὗ",709781,48],["ἂν",700900,11],["ᾖ",704093,204],["ὁ",709436,3],["βασιλεύς",702580,4],["ἕκαστος",704133,14],["κατὰ",707200,0],["τὴν",709436,8],["σύνταξιν",712506,9],["αὐτοῦ",702165,102]],"And thus the officers provided king Solomon: and [they execute] every one in his month all the orders for the table of the king, they omit nothing. And they carried the barley and the straw for the horses and the chariots to the place where the king might be, each according to his charge."],["2",[["καὶ",707031,7],["ταῦτα",709858,290],["τὰ",709436,63],["δέοντα",703312,242],["τῷ",709436,113],["Σαλωμων",711430,114],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["μιᾷ",704106,101],["τριάκοντα",712934,59],["κόροι",707841,52],["σεμιδάλεως",711675,17],["καὶ",707031,7],["ἑξήκοντα",704922,59],["κόροι",707841,52],["ἀλεύρου",700653,21],["κεκοπανισμένου",707820,441]],"And these [were] the requisite supplies for Solomon: in one day thirty measures of fine flour, and sixty measures of fine pounded meal,"],["3",[["καὶ",707031,7],["δέκα",703333,59],["μόσχοι",709029,52],["ἐκλεκτοὶ",704240,138],["καὶ",707031,7],["εἴκοσι",704085,59],["βόες",702798,52],["νομάδες",709334,52],["καὶ",707031,7],["ἑκατὸν",704136,59],["πρόβατα",710768,64],["ἐκτὸς",704339,0],["ἐλάφων",704398,81],["καὶ",707031,7],["δορκάδων",703801,65],["καὶ",707031,7],["ὀρνίθων",709767,81],["ἐκλεκτῶν",704240,169],["σιτευτά",711807,68]],"and ten choice calves, and twenty pastured oxen, and a hundred sheep, besides stags, and choice fatted does."],["4",[["ὅτι",709803,7],["ἦν",704093,13],["ἄρχων",701860,72],["πέραν",710280,0],["τοῦ",709436,35],["ποταμοῦ",710693,18],["καὶ",707031,7],["ἦν",704093,13],["αὐτῷ",702165,50],["εἰρήνη",704098,12],["ἐκ",704132,0],["πάντων",710177,83],["τῶν",709436,43],["μερῶν",708752,44],["κυκλόθεν",707956,28]],"For he had dominion on this side the river, and he was at peace on all sides round about."],["9",[["καὶ",707031,7],["ἔδωκεν",703654,2],["κύριος",707996,4],["φρόνησιν",713588,9],["τῷ",709436,113],["Σαλωμων",711430,114],["καὶ",707031,7],["σοφίαν",711981,9],["πολλὴν",710646,36],["σφόδρα",712586,28],["καὶ",707031,7],["χύμα",713986,25],["καρδίας",707141,17],["ὡς",714148,7],["ἡ",709436,10],["ἄμμος",700845,12],["ἡ",709436,10],["παρὰ",709995,0],["τὴν",709436,8],["θάλασσαν",706069,9]],"And the Lord gave understanding to Solomon, and very much wisdom, and enlargement of heart, as the sand on the seashore."],["10",[["καὶ",707031,7],["ἐπληθύνθη",710530,37],["Σαλωμων",711430,4],["σφόδρα",712586,28],["ὑπὲρ",713111,0],["τὴν",709436,8],["φρόνησιν",713588,9],["πάντων",710177,169],["ἀρχαίων",701835,169],["ἀνθρώπων",701163,81],["καὶ",707031,7],["ὑπὲρ",713111,0],["πάντας",710177,60],["φρονίμους",713589,60],["Αἰγύπτου",700401,17]],"And Solomon abounded greatly beyond the wisdom of all the ancients, and beyond all the wise men of Egypt."],["11",[["καὶ",707031,7],["ἐσοφίσατο",711982,23],["ὑπὲρ",713111,0],["πάντας",710177,60],["τοὺς",709436,58],["ἀνθρώπους",701163,57],["καὶ",707031,7],["ἐσοφίσατο",711982,23],["ὑπὲρ",713111,0],["Γαιθαν",702912,6],["τὸν",709436,5],["Εζραΐτην",704052,6],["καὶ",707031,7],["τὸν",709436,5],["Αιμαν",700444,6],["καὶ",707031,7],["τὸν",709436,5],["Χαλκαλ",713687,6],["καὶ",707031,7],["Δαρδα",703290,6],["υἱοὺς",713075,57],["Μαλ",708431,18]],"And he was wiser than all [other] men: and he was wiser than Gæthan the Zarite, and [than] Ænan, and [than] Chalcad and Darala the sons of Mal."],["12",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["Σαλωμων",711430,4],["τρισχιλίας",712964,119],["παραβολάς",710003,39],["καὶ",707031,7],["ἦσαν",704093,137],["ᾠδαὶ",714091,191],["αὐτοῦ",702165,102],["πεντακισχίλιαι",710260,192]],"And Solomon spoke three thousand proverbs, and his songs were five thousand."],["13",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["περὶ",710285,0],["τῶν",709436,43],["ξύλων",709427,44],["ἀπὸ",701425,0],["τῆς",709436,16],["κέδρου",707590,17],["τῆς",709436,16],["ἐν",704639,0],["τῷ",709436,113],["Λιβάνῳ",708185,114],["καὶ",707031,7],["ἕως",705792,0],["τῆς",709436,16],["ὑσσώπου",713269,17],["τῆς",709436,16],["ἐκπορευομένης",704293,422],["διὰ",703417,0],["τοῦ",709436,35],["τοίχου",712879,18],["καὶ",707031,7],["ἐλάλησεν",708071,2],["περὶ",710285,0],["τῶν",709436,43],["κτηνῶν",707934,44],["καὶ",707031,7],["περὶ",710285,0],["τῶν",709436,43],["πετεινῶν",710439,44],["καὶ",707031,7],["περὶ",710285,0],["τῶν",709436,43],["ἑρπετῶν",705441,44],["καὶ",707031,7],["περὶ",710285,0],["τῶν",709436,80],["ἰχθύων",706870,81]],"And he spoke of trees, from the cedar in Libanus even to the hyssop which comes out through the wall: he spoke also of cattle, and of birds, and of reptiles, and of fishes."],["14",[["καὶ",707031,7],["παρεγίνοντο",710006,139],["πάντες",710177,138],["οἱ",709436,136],["λαοὶ",708094,52],["ἀκοῦσαι",700587,106],["τῆς",709436,16],["σοφίας",711981,17],["Σαλωμων",711430,18],["καὶ",707031,7],["ἐλάμβανεν",708076,13],["δῶρα",703907,42],["παρὰ",709995,0],["πάντων",710177,169],["τῶν",709436,80],["βασιλέων",702580,81],["τῆς",709436,16],["γῆς",703083,17],["ὅσοι",709788,138],["ἤκουον",700587,137],["τῆς",709436,16],["σοφίας",711981,17],["αὐτοῦ",702165,102]],"And all the nations came to hear the wisdom of Solomon, and [ambassadors] from all the kings of the earth, as many as heard of his wisdom."],["14a",[["καὶ",