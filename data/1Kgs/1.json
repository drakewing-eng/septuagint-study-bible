[["1",[["καὶ",707031,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["Δαυιδ",703232,4],["πρεσβύτερος",710735,4],["προβεβηκὼς",710763,270],["ἡμέραις",705984,76],["καὶ",707031,7],["περιέβαλλον",710294,137],["αὐτὸν",702165,85],["ἱματίοις",706742,96],["καὶ",707031,7],["οὐκ",709805,28],["ἐθερμαίνετο",706213,19]],"And king David [was] old and advanced in days, and they covered him with clothes, and he was not warmed."],["2",[["καὶ",707031,7],["εἶπον",705373,150],["οἱ",709436,136],["παῖδες",709932,52],["αὐτοῦ",702165,102],["ζητησάτωσαν",705879,264],["τῷ",709436,113],["κυρίῳ",707996,114],["ἡμῶν",705999,145],["τῷ",709436,113],["βασιλεῖ",702580,114],["παρθένον",710148,9],["νεάνιδα",709231,9],["καὶ",707031,7],["παραστήσεται",710152,93],["τῷ",709436,113],["βασιλεῖ",702580,114],["καὶ",707031,7],["ἔσται",704093,93],["αὐτὸν",702165,85],["θάλπουσα",706075,149],["καὶ",707031,7],["κοιμηθήσεται",707767,134],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["θερμανθήσεται",706213,134],["ὁ",709436,3],["κύριος",707996,4],["ἡμῶν",705999,145],["ὁ",709436,3],["βασιλεύς",702580,4]],"And his servants said, Let them seek for the king a young virgin, and she shall wait on the king, and cherish him, and lie with him, and my lord the king shall be warmed."],["3",[["καὶ",707031,7],["ἐζήτησαν",705879,150],["νεάνιδα",709231,9],["καλὴν",707097,36],["ἐκ",704132,0],["παντὸς",710177,92],["ὁρίου",709749,21],["Ισραηλ",706839,18],["καὶ",707031,7],["εὗρον",705676,150],["τὴν",709436,8],["Αβισακ",700075,9],["τὴν",709436,8],["Σωμανῖτιν",712637,9],["καὶ",707031,7],["ἤνεγκαν",713428,150],["αὐτὴν",702165,104],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6]],"So they sought for a fair damsel out of all the coasts of Israel; and they found Abisag the Somanite, and they brought her to the king."],["4",[["καὶ",707031,7],["ἡ",709436,10],["νεᾶνις",709231,12],["καλὴ",707097,29],["ἕως",705792,0],["σφόδρα",712586,28],["καὶ",707031,7],["ἦν",704093,13],["θάλπουσα",706075,188],["τὸν",709436,5],["βασιλέα",702580,6],["