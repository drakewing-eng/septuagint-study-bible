680,7],["ὁ",709436,3],["υἱός",713075,4],["μου",709032,133],["ὁ",709436,3],["ζῶν",705851,72],["καὶ",707031,7],["ὁ",709436,3],["υἱός",713075,4],["σου",711945,133],["ὁ",709436,3],["τεθνηκώς",706278,270]],"And the king said to them, Thou sayest, This [is] my son, [even] the living [one], and this woman's son [is] the dead one: and thou sayest, No, but the living [is] my son, and the dead [is] thy son."],["24",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεύς",702580,4],["λάβετέ",708076,74],["μοι",708974,159],["μάχαιραν",708593,9],["καὶ",707031,7],["προσήνεγκαν",710974,150],["τὴν",709436,8],["μάχαιραν",708593,9],["ἐνώπιον",704823,0],["τοῦ",709436,35],["βασιλέως",702580,18]],"And the king said, Fetch a sword. And they brought a sword before the king."],["25",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεύς",702580,4],["διέλετε",703459,74],["τὸ",709436,24],["παιδίον",709927,25],["τὸ",709436,24],["θηλάζον",706233,47],["τὸ",709436,24],["ζῶν",705851,72],["εἰς",704105,0],["δύο",703849,59],["καὶ",707031,7],["δότε",703654,74],["τὸ",709436,24],["ἥμισυ",705998,46],["αὐτοῦ",702165,102],["ταύτῃ",709858,105],["καὶ",707031,7],["τὸ",709436,24],["ἥμισυ",705998,46],["αὐτοῦ",702165,102],["ταύτῃ",709858,105]],"And the king said, Divide the live child, the suckling, in two; and give half of it to one, and half of it to the other."],["26",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["ἡ",709436,10],["γυνή",703209,12],["ἧς",709781,167],["ἦν",704093,13],["ὁ",709436,3],["υἱὸς",713075,4],["ὁ",709436,3],["ζῶν",705851,72],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["ὅτι",709803,7],["ἐταράχθη",712721,37],["ἡ",709436,10],["μήτρα",708894,12],["αὐτῆς",702165,86],["ἐπὶ",705080,0],["τῷ",709436,113],["υἱῷ",713075,114],["αὐτῆς",702165,86],["καὶ",707031,7],["εἶπεν",705373,2],["ἐν",704639,0],["ἐμοί",704577,159],["κύριε",707996,153],["δότε",703654,74],["αὐτῇ",702165,105],["τὸ",709436,24],["παιδίον",709927,25],["καὶ",707031,7],["θανάτῳ",706096,114],["μὴ",708851,28],["θανατώσητε",706097,125],["αὐτόν",702165,85],["καὶ",707031,7],["αὕτη",709858,107],["εἶπεν",705373,2],["μήτε",708891,7],["ἐμοὶ",704577,159],["μήτε",708891,7],["αὐτῇ",702165,105],["ἔστω",704093,31],["διέλετε",703459,74]],"And the woman whose the living child was, answered and said to the king, (for her bowels yearned over her son) and she said, I pray thee, [my] lord, give her the child, and in nowise slay it. But the other said, Let it be neither mine nor hers; divide [it]."],["27",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["εἶπεν",705373,2],["δότε",703654,74],["τὸ",709436,24],["παιδίον",709927,25],["τῇ",709436,100],["εἰπούσῃ",705415,603],["δότε",703654,74],["αὐτῇ",702165,105],["αὐτὸ",702165,129],["καὶ",707031,7],["θανάτῳ",706096,114],["μὴ",708851,28],["θανατώσητε",706097,125],["αὐτόν",702165,85],["αὐτὴ",702165,107],["ἡ",709436,10],["μήτηρ",708892,12],["αὐτοῦ",702165,102]],"Then the king answered and said, Give the child to her that said, ‘Give it to her, and by no means slay it:’ she [is] its mother."],["28",[["καὶ",707031,7],["ἤκουσαν",700587,150],["πᾶς",710177,14],["Ισραηλ",706839,4],["τὸ",709436,24],["κρίμα",707903,25],["τοῦτο",709858,129],["ὃ",709781,128],["ἔκρινεν",707905,2],["ὁ",709436,3],["βασιλεύς",702580,4],["καὶ",707031,7],["ἐφοβήθησαν",713532,99],["ἀπὸ",701425,0],["προσώπου",710986,21],["τοῦ",709436,35],["βασιλέως",702580,18],["ὅτι",709803,7],["εἶδον",709725,150],["ὅτι",709803,7],["φρόνησις",713588,12],["θεοῦ",706192,18],["ἐν",704639,0],["αὐτῷ",702165,50],["τοῦ",709436,20],["ποιεῖν",710582,55],["δικαίωμα",703697,25]],"And all Israel heard this judgment which the king judged, and they feared before the king; because they saw that the wisdom of God [was] in him, to execute judgment."]]