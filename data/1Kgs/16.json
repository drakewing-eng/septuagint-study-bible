[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["ἐν",704639,0],["χειρὶ",713787,1],["Ιου",706765,18],["υἱοῦ",713075,18],["Ανανι",701015,18],["πρὸς",710844,0],["Βαασα",702350,6]],"And the word of the Lord came by the hand of Ju son of Anani to Baasa, [saying],"],["2",[["ἀνθ᾿",701227,0],["ὧν",709781,252],["ὕψωσά",713289,155],["σε",711598,163],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἔδωκά",703654,155],["σε",711598,163],["ἡγούμενον",705931,212],["ἐπὶ",705080,0],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["Ισραηλ",706839,6],["καὶ",707031,7],["ἐπορεύθης",710667,168],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["Ιεροβοαμ",706629,18],["καὶ",707031,7],["ἐξήμαρτες",704859,162],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["τὸν",709436,5],["Ισραηλ",706839,6],["τοῦ",709436,20],["παροργίσαι",710167,106],["με",708618,163],["ἐν",704639,0],["τοῖς",709436,147],["ματαίοις",708575,230],["αὐτῶν",702165,40]],"Forasmuch as I lifted thee up from the earth, and made thee ruler over my people Israel; and thou hast walked in the way of Jeroboam, and hast caused my people Israel to sin, to provoke me with their vanities;"],["3",[["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐξεγείρω",704889,207],["ὀπίσω",709697,0],["Βαασα",702350,18],["καὶ",707031,7],["ὄπισθεν",709691,28],["τοῦ",709436,35],["οἴκου",709516,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["δώσω",703654,165],["τὸν",709436,5],["οἶκόν",709516,6],["σου",711945,133],["ὡς",714148,7],["τὸν",709436,5],["οἶκον",709516,6],["Ιεροβοαμ",706629,18],["υἱοῦ",713075,18],["Ναβατ",709134,18]],"Behold, I raise up [enemies] after Baasa, and after his house; and I will make thy house as the house of Jeroboam son of Nabat."],["4",[["τὸν",709436,5],["τεθνηκότα",706278,427],["τοῦ",709436,35],["Βαασα",702350,18],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["καταφάγονται",707519,135],["αὐτὸν",702165,85],["οἱ",709436,136],["κύνες",708004,52],["καὶ",707031,7],["τὸν",709436,5],["τεθνηκότα",706278,427],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,53],["πεδίῳ",710215,54],["καταφάγονται",707519,135],["αὐτὸν",702165,85],["τὰ",709436,63],["πετεινὰ",710439,64],["τοῦ",709436,35],["οὐρανοῦ",709844,18]],"Him that dies of Baasa in the city the dogs shall devour, and him that dies of his in the field the birds of the sky shall devour."],["5",[["καὶ",707031,7],["τὰ",709436,63],["λοιπὰ",708248,195],["τῶν",709436,80],["λόγων",708236,81],["Βαασα",702350,18],["καὶ",707031,7],["πάντα",710177,68],["ἃ",709781,69],["ἐποίησεν",710582,2],["καὶ",707031,7],["αἱ",709436,190],["δυναστεῖαι",703841,191],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἰδοὺ",706497,88],["ταῦτα",709858,290],["γεγραμμένα",703194,443],["ἐν",704639,0],["βιβλίῳ",702719,54],["λόγων",708236,81],["τῶν",709436,130],["ἡμερῶν",705984,65],["τῶν",709436,80],["βασιλέων",702580,81],["Ισραηλ",706839,18]],"Now the rest of the history of Baasa, and all that he did, and his mighty acts, behold, are not these written in the book of the chronicles of the kings of Israel?"],["6",[["καὶ",707031,7],["ἐκοιμήθη",707767,37],["Βαασα",702350,4],["μετὰ",708780,0],["τῶν",709436,80],["πατέρων",710189,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["θάπτεται",706103,391],["ἐν",704639,0],["Θερσα",706220,1],["καὶ",707031,7],["βασιλεύει",702581,91],["Ηλα",705957,4],["υἱὸς",713075,4],["αὐτοῦ",702165,102],["ἀντ᾿",701227,0],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,53],["εἰκοστῷ",704086,97],["ἔτει",705543,54],["βασιλέως",702580,18],["Ασα",701870,18]],"And Baasa slept with his fathers, and they bury him in Thersa; and Ela his son reigns in his stead."],["7",[["καὶ",707031,7],["ἐν",704639,0],["χειρὶ",713787,1],["Ιου",706765,18],["υἱοῦ",713075,18],["Ανανι",701015,18],["ἐλάλησεν",708071,2],["κύριος",707996,4],["ἐπὶ",705080,0],["Βαασα",702350,6],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸν",709436,5],["οἶκον",709516,6],["αὐτοῦ",702165,102],["πᾶσαν",710177,36],["τὴν",709436,8],["κακίαν",707054,9],["ἣν",709781,131],["ἐποίησεν",710582,2],["ἐνώπιον",704823,0],["κυρίου",707996,18],["τοῦ",709436,20],["παροργίσαι",710167,106],["αὐτὸν",702165,85],["ἐν",704639,0],["τοῖς",709436,95],["ἔργοις",705396,96],["τῶν",709436,130],["χειρῶν",713787,65],["αὐτοῦ",702165,102],["τοῦ",709436,20],["εἶναι",704093,55],["κατὰ",707200,0],["τὸν",709436,5],["οἶκον",709516,6],["Ιεροβοαμ",706629,18],["καὶ",707031,7],["ὑπὲρ",713111,0],["τοῦ",709436,20],["πατάξαι",710185,106],["αὐτόν",702165,85]],"And the Lord spoke by Ju the son of Anani against Baasa, and against his house, [even] all the evil which he wrought before the Lord to provoke him to anger by the works of his hands, in being like the house of Jeroboam; and because he smote him."],["8",[["καὶ",707031,7],["Ηλα",705957,4],["υἱὸς",713075,4],["Βαασα",702350,18],["ἐβασίλευσεν",702581,2],["ἐπὶ",705080,0],["Ισραηλ",706839,6],["δύο",703849,59],["ἔτη",705543,42],["ἐν",704639,0],["Θερσα",706220,1]],"And Ela son of Baasa reigned over Israel two years in Thersa."],["9",[["καὶ",707031,7],["συνέστρεψεν",712562,2],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["Ζαμβρι",705831,4],["ὁ",709436,3],["ἄρχων",701860,72],["τῆς",709436,16],["ἡμίσους",705998,82],["τῆς",709436,16],["ἵππου",706790,18],["καὶ",707031,7],["αὐτὸς",702165,121],["ἦν",704093,13],["ἐν",704639,0],["Θερσα",706220,1],["πίνων",710478,72],["μεθύων",708676,72],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["Ωσα",714149,18],["τοῦ",709436,35],["οἰκονόμου",709514,18],["ἐν",704639,0],["Θερσα",706220,1]],"And Zambri, captain of half his cavalry, conspired against him, while he was in Thersa, drinking himself drunk in the house of Osa the steward at Thersa."],["10",[["καὶ",707031,7],["εἰσῆλθεν",704114,2],["Ζαμβρι",705831,4],["καὶ",707031,7],["ἐπάταξεν",710185,2],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐθανάτωσεν",706097,2],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐβασίλευσεν",702581,2],["ἀντ᾿",701227,0],["αὐτοῦ",702165,102]],"And Zambri went in and smote him and slew him, and reigned in his stead."],["11",[["καὶ",707031,7],["ἐγενήθη",703104,37],["ἐν",704639,0],["τῷ",709436,53],["βασιλεῦσαι",702581,106],["αὐτὸν",702165,85],["ἐν",704639,0],["τῷ",709436,53],["καθίσαι",707006,106],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["τοῦ",709436,35],["θρόνου",706315,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπάταξεν",710185,2],["ὅλον",709597,27],["τὸν",709436,5],["οἶκον",709516,6],["Βαασα",702350,18]],"And it came to pass when he reigned, when he sat upon his throne,"],["12",[["κατὰ",707200,0],["τὸ",709436,24],["ῥῆμα",711246,25],["ὃ",709781,128],["ἐλάλησεν",708071,2],["κύριος",707996,4],["ἐπὶ",705080,0],["τὸν",709436,5],["οἶκον",709516,6],["Βαασα",702350,18],["πρὸς",710844,0],["Ιου",706765,6],["τὸν",709436,5],["προφήτην",711009,6]],"that he smote all the house of Baasa, according to the word which the Lord spoke against the house of Baasa, and to Ju the prophet,"],["13",[["περὶ",710285,0],["πασῶν",710177,198],["τῶν",709436,130],["ἁμαρτιῶν",700775,65],["Βαασα",702350,18],["καὶ",707031,7],["Ηλα",705957,18],["τοῦ",709436,35],["υἱοῦ",713075,18],["αὐτοῦ",702165,102],["ὡς",714148,7],["ἐξήμαρτεν",704859,2],["τὸν",709436,5],["Ισραηλ",706839,6],["τοῦ",709436,20],["παροργίσαι",710167,106],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["Ισραηλ",706839,18],["ἐν",704639,0],["τοῖς",709436,147],["ματαίοις",708575,230],["αὐτῶν",702165,40]],"for all the sins of Baasa and Ela his son, as he led Israel astray to sin, to provoke the Lord God of Israel with their vanities."],["14",[["καὶ",707031,7],["τὰ",709436,63],["λοιπὰ",708248,195],["τῶν",709436,80],["λόγων",708236,81],["Ηλα",705957,18],["καὶ",707031,7],["πάντα",710177,68],["ἃ",709781,69],["ἐποίησεν",710582,2],["οὐκ",709805,28],["ἰδοὺ",706497,88],["ταῦτα",709858,290],["γεγραμμένα",703194,443],["ἐν",704639,0],["βιβλίῳ",702719,54],["λόγων",708236,81],["τῶν",709436,130],["ἡμερῶν",705984,65],["τῶν",709436,80],["βασιλέων",702580,81],["Ισραηλ",706839,18]],"And the rest of the deeds of Ela which he did, behold, are not these written in the book of the chronicles of the kings of Israel?"],["15",[["καὶ",707031,7],["Ζαμβρι",705831,4],["ἐβασίλευσεν",702581,2],["ἑπτὰ",705357,59],["ἡμέρας",705984,17],["ἐν",704639,0],["Θερσα",706220,1],["καὶ",707031,7],["ἡ",709436,10],["παρεμβολὴ",710133,12],["Ισραηλ",706839,18],["ἐπὶ",705080,0],["Γαβαθων",702856,9],["τὴν",709436,8],["τῶν",709436,80],["ἀλλοφύλων",700706,81]],"And Zambri reigned in Thersa seven days: and the army of Israel [was] encamped against Gabathon of the Philistines."],["16",[["καὶ",707031,7],["ἤκουσεν",700587,2],["ὁ",709436,3],["λαὸς",708094,4],["ἐν",704639,0],["τῇ",709436,100],["παρεμβολῇ",710133,1],["λεγόντων",708124,170],["συνεστράφη",712562,37],["Ζαμβρι",705831,4],["καὶ",707031,7],["ἔπαισεν",709933,2],["τὸν",709436,5],["βασιλέα",702580,6],["καὶ",707031,7],["ἐβασίλευσαν",702581,150],["ἐν",704639,0],["Ισραηλ",706839,114],["τὸν",709436,5],["Αμβρι",700795,6],["τὸν",709436,5],["ἡγούμενον",705931,212],["τῆς",709436,16],["στρατιᾶς",712145,17],["ἐπὶ",705080,0],["Ισραηλ",706839,6],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἐν",704639,0],["τῇ",709436,100],["παρεμβολῇ",710133,1]],"And the people heard in the army, saying, Zambri has conspired and smitten the king: and the people of Israel made Ambri the captain of the host king in that day in the camp over Israel."],["17",[["καὶ",707031,7],["ἀνέβη",700905,2],["Αμβρι",700795,4],["καὶ",707031,7],["πᾶς",710177,14],["Ισραηλ",706839,4],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἐκ",704132,0],["Γαβαθων",702856,17],["καὶ",707031,7],["περιεκάθισαν",710325,150],["ἐπὶ",705080,0],["Θερσα",706220,9]],"And Ambri went up, and all Israel with him, out of Gabathon; and they besieged Thersa."],["18",[["καὶ",707031,7],["ἐγενήθη",703104,37],["ὡς",714148,7],["εἶδεν",709725,2],["Ζαμβρι",705831,4],["ὅτι",709803,7],["προκατείλημπται",710809,322],["αὐτοῦ",702165,102],["ἡ",709436,10],["πόλις",710612,12],["καὶ",707031,7],["εἰσπορεύεται",704124,117],["εἰς",704105,0],["ἄντρον",701283,25],["τοῦ",709436,35],["οἴκου",709516,18],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["ἐνεπύρισεν",704622,2],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["βασιλέως",702580,18],["ἐν",704639,0],["πυρὶ",711088,54],["καὶ",707031,7],["ἀπέθανεν",701461,2]],"And it came to pass when Zambri saw that his city was taken, that he goes into the inner chamber of the house of the king, and burnt the king's house over him, and died."],["19",[["ὑπὲρ",713111,0],["τῶν",709436,130],["ἁμαρτιῶν",700775,65],["αὐτοῦ",702165,102],["ὧν",709781,252],["ἐποίησεν",710582,2],["τοῦ",709436,20],["ποιῆσαι",710582,106],["τὸ",709436,24],["πονηρὸν",710660,46],["ἐνώπιον",704823,0],["κυρίου",707996,18],["πορευθῆναι",710667,179],["ἐν",704639,0],["ὁδῷ",709458,1],["Ιεροβοαμ",706629,18],["υἱοῦ",713075,18],["Ναβατ",709134,18],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἁμαρτίαις",700775,76],["αὐτοῦ",702165,102],["ὡς",714148,7],["ἐξήμαρτεν",704859,2],["τὸν",709436,5],["Ισραηλ",706839,6]],"Because of his sins which he committed, doing that which was evil in the sight of the Lord, so as to walk in the way of Jeroboam the son of Nabat, and in his sins wherein he caused Israel to sin."],["20",[["καὶ",707031,7],["τὰ",709436,63],["λοιπὰ",708248,195],["τῶν",709436,80],["λόγων",708236,81],["Ζαμβρι",705831,18],["καὶ",707031,7],["τὰς",709436,38],["συνάψεις",712412,39],["αὐτοῦ",702165,102],["ἃς",709781,193],["συνῆψεν",712404,2],["οὐκ",709805,28],["ἰδοὺ",706497,88],["ταῦτα",709858,290],["γεγραμμένα",703194,443],["ἐν",704639,0],["βιβλίῳ",702719,54],["λόγων",708236,81],["τῶν",709436,80],["ἡμερῶν",705984,65],["τῶν",709436,80],["βασιλέων",702580,81],["Ισραηλ",706839,18]],"And the rest of the history of Zambri, and his conspiracies wherein he conspired, behold, are not these written in the book of the chronicles of the kings of Israel?"],["21",[["τότε",712908,28],["μερίζεται",708744,117],["ὁ",709436,3],["λαὸς",708094,4],["Ισραηλ",706839,18],["ἥμισυ",705998,26],["τοῦ",709436,35],["λαοῦ",708094,18],