4639,0],["Ιερουσαλημ",706644,1],["τριάκοντα",712934,59],["τρία",712927,68],["ἔτη",705543,42]],"And the days which David reigned over Israel [were] forty years; he reigned seven years in Chebron, and thirty-three years in Jerusalem."],["12",[["καὶ",707031,7],["Σαλωμων",711430,4],["ἐκάθισεν",707006,2],["ἐπὶ",705080,0],["τοῦ",709436,35],["θρόνου",706315,18],["Δαυιδ",703232,18],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["υἱὸς",713075,4],["ἐτῶν",705543,44],["δώδεκα",703887,59],["καὶ",707031,7],["ἡτοιμάσθη",705539,37],["ἡ",709436,10],["βασιλεία",702577,12],["αὐτοῦ",702165,102],["σφόδρα",712586,28]],"And Solomon sat on the throne of his father David, and his kingdom was established greatly."],["13",[["καὶ",707031,7],["εἰσῆλθεν",704114,2],["Αδωνιας",700304,4],["υἱὸς",713075,4],["Αγγιθ",700143,18],["πρὸς",710844,0],["Βηρσαβεε",702702,9],["μητέρα",708892,9],["Σαλωμων",711430,18],["καὶ",707031,7],["προσεκύνησεν",710925,2],["αὐτῇ",702165,105],["ἡ",709436,10],["δὲ",703303,11],["εἶπεν",705373,2],["εἰρήνη",704098,12],["ἡ",709436,10],["εἴσοδός",704119,12],["σου",711945,133],["καὶ",707031,7],["εἶπεν",705373,2],["εἰρήνη",704098,12]],"And Adonias the son of Aggith came in to Bersabee the mother of Solomon, and did obeisance to her: and she said, Dost thou enter peaceably? and he said, Peaceably:"],["14",[["λόγος",708236,4],["μοι",708974,159],["πρὸς",710844,0],["σέ",711598,163],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["λάλησον",708071,176]],"I have business with thee. And she said to him, Say on."],["15",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῇ",702165,105],["σὺ",712181,164],["οἶδας",709492,266],["ὅτι",709803,7],["ἐμοὶ",704577,159],["ἦν",704093,13],["ἡ",709436,10],["βασιλεία",702577,12],["καὶ",707031,7],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ἔθετο",712849,23],["πᾶς",710177,14],["Ισραηλ",706839,4],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["εἰς",704105,0],["βασιλέα",702580,6],["καὶ",707031,7],["ἐστράφη",712160,37],["ἡ",709436,10],["β