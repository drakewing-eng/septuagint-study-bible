,4],["βασιλεὺς",702580,4],["Ισραηλ",706839,18],["ἐπὶ",705080,0],["Ιουδαν",706775,6],["καὶ",707031,7],["ᾠκοδόμησεν",709509,2],["τὴν",709436,8],["Ραμα",711163,9],["τοῦ",709436,20],["μὴ",708851,28],["εἶναι",704093,55],["ἐκπορευόμενον",704293,212],["καὶ",707031,7],["εἰσπορευόμενον",704124,212],["τῷ",709436,113],["Ασα",701870,114],["βασιλεῖ",702580,114],["Ιουδα",706768,18]],"And Baasa king of Israel went up against Juda, and built Rama, so that no one should go out or come in for Asa king of Juda."],["18",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Ασα",701870,4],["τὸ",709436,24],["ἀργύριον",701707,25],["καὶ",707031,7],["τὸ",709436,24],["χρυσίον",713972,25],["τὸ",709436,24],["εὑρεθὲν",705676,418],["ἐν",704639,0],["τοῖς",709436,147],["θησαυροῖς",706258,148],["τοῦ",709436,35],["οἴκου",709516,18],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτὰ",702165,71],["εἰς",704105,0],["χεῖρας",713787,39],["παίδων",709932,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐξαπέστειλεν",704872,2],["αὐτοὺς",702165,62],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ασα",701870,4],["πρὸς",710844,0],["υἱὸν",713075,6],["Αδερ",700252,18],["υἱὸν",713075,6],["Ταβερεμμαν",712686,18],["υἱοῦ",713075,18],["Αζιν",700338,18],["βασιλέως",702580,18],["Συρίας",712533,17],["τοῦ",709436,35],["κατοικοῦντος",707534,152],["ἐν",704639,0],["Δαμασκῷ",703275,1],["λέγων",708124,72]],"And Asa took all the silver and the gold that was found in the treasures of the house of the Lord, and in the treasures of the king's house, and gave them into the hands of his servants; and king Asa sent them out to the son of Ader, the son of Taberema son of Azin king of Syria, who dwelt in Damascus, saying,"],["19",[["διάθου",703609,300],["διαθήκην",703456,9],["ἀνὰ",700902,0],["μέσον",708768,46],["ἐμοῦ",704580,133],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,46],["σοῦ",711945,133],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,46],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133],["καὶ",707031,7],