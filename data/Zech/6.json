[["1",[["καὶ",707031,7],["ἐπέστρεψα",705278,155],["καὶ",707031,7],["ἦρα",700473,155],["τοὺς",709436,58],["ὀφθαλμούς",709870,57],["μου",709032,133],["καὶ",707031,7],["εἶδον",709725,150],["καὶ",707031,7],["ἰδοὺ",706497,88],["τέσσαρα",712808,68],["ἅρματα",701768,42],["ἐκπορευόμενα",704293,67],["ἐκ",704132,0],["μέσου",708768,92],["δύο",703849,59],["ὀρέων",709768,44],["καὶ",707031,7],["τὰ",709436,63],["ὄρη",709768,64],["ἦν",704093,13],["ὄρη",709768,64],["χαλκᾶ",713690,195]],"And I turned, and lifted up mine eyes, and looked, and, behold, four chariots coming out from between two mountains; and the mountains were brazen mountains."],["2",[["ἐν",704639,0],["τῷ",709436,53],["ἅρματι",701768,54],["τῷ",709436,53],["πρώτῳ",711041,633],["ἵπποι",706790,52],["πυρροί",711108,138],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἅρματι",701768,54],["τῷ",709436,53],["δευτέρῳ",703389,97],["ἵπποι",706790,52],["μέλανες",708695,138]],"In the first chariot [were] red horses; and in the second chariot black horses;"],["3",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἅρματι",701768,54],["τῷ",709436,53],["τρίτῳ",712968,30],["ἵπποι",706790,52],["λευκοί",708165,138],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἅρματι",701768,54],["τῷ",709436,53],["τετάρτῳ",712811,97],["ἵπποι",706790,52],["ποικίλοι",710589,138],["ψαροί",714031,138]],"and in the third chariot white horses; and in the fourth chariot piebald [and] ash-coloured horses."],["4",[["καὶ",707031,7],["ἀπεκρίθην",701492,156],["καὶ",707031,7],["εἶπα",705373,155],["πρὸς",710844,0],["τὸν",709436,5],["ἄγγελον",700140,6],["τὸν",709436,5],["λαλοῦντα",708071,183],["ἐν",704639,0],["ἐμοί",704577,159],["τί",712867,642],["ἐστιν",704093,91],["ταῦτα",709858,290],["κύριε",707996,153]],"And I answered and said to the angel that talked with me, What are these, my lord?"],["5",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["ὁ",709436,3],["ἄγγελος",700140,4],["ὁ",709436,3],["λαλῶν",708071,72],["ἐν",704639,0],["ἐμοὶ",704577,159],["καὶ",707031,7