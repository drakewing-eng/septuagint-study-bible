[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["παντοκράτορος",709986,18],["λέγων",708124,72]],"And the word of the Lord Almighty came, saying,"],["2",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["παντοκράτωρ",709986,4],["ἐζήλωσα",705873,155],["τὴν",709436,8],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["τὴν",709436,8],["Σιων",711816,9],["ζῆλον",705871,6],["μέγαν",708653,27],["καὶ",707031,7],["θυμῷ",706334,114],["μεγάλῳ",708653,30],["ἐζήλωσα",705873,155],["αὐτήν",702165,104]],"Thus saith the Lord Almighty; I have been jealous for Jerusalem and for Sion with great jealousy, and I have been jealous for her with great fury."],["3",[["τάδε",709446,290],["λέγει",708124,91],["κύριος",707996,4],["καὶ",707031,28],["ἐπιστρέψω",705278,165],["ἐπὶ",705080,0],["Σιων",711816,9],["καὶ",707031,7],["κατασκηνώσω",707423,165],["ἐν",704639,0],["μέσῳ",708768,97],["Ιερουσαλημ",706644,17],["καὶ",707031,7],["κληθήσεται",707084,134],["ἡ",709436,10],["Ιερουσαλημ",706644,12],["πόλις",710612,12],["ἡ",709436,10],["ἀληθινὴ",700659,29],["καὶ",707031,7],["τὸ",709436,34],["ὄρος",709768,15],["κυρίου",707996,18],["παντοκράτορος",709986,18],["ὄρος",709768,15],["ἅγιον",700159,26]],"Thus saith the Lord; I will return to Sion, and dwell in the midst of Jerusalem: and Jerusalem shall be called a true city, and the mountain of the Lord Almighty a holy mountain."],["4",[["τάδε",709446,290],["λέγει",708124,91],["κύριος",707996,4],["παντοκράτωρ",709986,4],["ἔτι",705538,28],["καθήσονται",707007,135],["πρεσβύτεροι",710735,138],["καὶ",707031,7],["πρεσβύτεραι",710735,481],["ἐν",704639,0],["ταῖς",709436,75],["πλατείαις",710509,291],["Ιερουσαλημ",706644,17],["ἕκαστος",704133,14],["τὴν",709436,8],["ῥάβδον",711135,9],["αὐτοῦ",702165,102],["ἔχων",705785,72],["ἐν",704639,0],["τῇ",709436,100],["χειρὶ",713787,1],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["πλήθους",710529,21],["ἡμερῶν",705984,65]],"Thus saith the Lord Almighty; There shall yet dwell old men and old women in the streets of Jerusalem, every one holding his staff in his hand for age."],["5",[["καὶ",707031,7],["αἱ",709436,190],["πλατεῖαι",710509,192],["τῆς",709436,16],["πόλεως",710612,17],["πλησθήσονται",710532,144],["παιδαρίων",709923,44],["καὶ",707031,7],["κορασίων",707832,44],["παιζόντων",709931,84],["ἐν",704639,0],["ταῖς",709436,75],["πλατείαις",710509,291],["αὐτῆς",702165,86]],"And the broad places of the city shall be filled with boys and girls playing in the streets thereof."],["6",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["παντοκράτωρ",709986,4],["διότι",703734,7],["εἰ",704071,7],["ἀδυνατήσει",700296,127],["ἐνώπιον",704823,0],["τῶν",709436,80],["καταλοίπων",707317,169],["τοῦ",709436,35],["λαοῦ",708094,18],["τούτου",709858,102],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["μὴ",708851,28],["καὶ",707031,7],["ἐνώπιον",704823,0],["ἐμοῦ",704580,133],["ἀδυνατήσει",700296,127],["λέγει",708124,91],["κύριος",707996,4],["παντοκράτωρ",709986,4]],"Thus saith the Lord Almighty; If it shall be impossible in the sight of the remnant of this people in those days, shall it also be impossible in my sight? saith the Lord Almighty."],["7",[["τάδε",709446,290],["λέγει",708124,91],["κύριος",707996,4],["παντοκράτωρ",709986,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἀνασῴζω",701064,157],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["ἀπὸ",701425,0],["γῆς",703083,17],["ἀνατολῶν",701071,65],["καὶ",707031,7],["ἀπὸ",701425,0],["γῆς",703083,17],["δυσμῶν",703865,65]],"Thus saith the Lord Almighty; Behold, I [will] save my people from the east country, and the west country;"],["8",[["καὶ",707031,7],["εἰσάξω",704107,165],["αὐτοὺς",702165,62],["καὶ",707031,7],["κατασκηνώσω",707423,165],["ἐν",704639,0],["μέσῳ",708768,97],["Ιερουσαλημ",706644,17],["καὶ",707031,7],["ἔσονταί",704093,135],["μοι",708974,159],["εἰς",704105,0],["λαόν",708094,6],["καὶ",707031,7],["ἐγὼ",704018,164],["ἔσομαι",704093,181],["αὐτοῖς",702165,151],["εἰς",704105,0],["θεὸν",706192,6],["ἐν",704639,0],["ἀληθείᾳ",700656,1],["καὶ",707031,7],["ἐν",704639,0],["δικαιοσύνῃ",703695,1]],"and I will bring them in, and cause [them] to dwell in the midst of Jerusalem: and they shall be to me a people, and I will be to them a God, in truth and in righteousness."],["9",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["παντοκράτωρ",709986,4],["κατισχυέτωσαν",707531,56],["αἱ",709436,190],["χεῖρες",713787,191],["ὑμῶν",713091,145],["τῶν",709436,80],["ἀκουόντων",700587,170],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ταύταις",709858,200],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["ἐκ",704132,0],["στόματος",712125,21],["τῶν",709436,80],["προφητῶν",711009,81],["ἀφ᾿",701425,0],["ἧς",709781,167],["ἡμέρας",705984,17],["τεθεμελίωται",706182,187],["ὁ",709436,3],["οἶκος",709516,4],["κυρίου",707996,18],["παντοκράτορος",709986,18],["καὶ",707031,7],["ὁ",709436,3],["ναὸς",709191,4],["ἀφ᾿",701425,0],["οὗ",709781,48],["ᾠκοδόμηται",709509,187]],"Thus saith the Lord Almighty; Let your hands be strong, [ye that] hear in these days these words out of the mouth of the prophets, from the day that the house of the Lord Almighty was founded, and from the time that the temple was built."],["10",[["διότι",703734,7],["πρὸ",710747,0],["τῶν",709436,130],["ἡμερῶν",705984,65],["ἐκείνων",704183,284],["ὁ",709436,3],["μισθὸς",708939,4],["τῶν",709436,80],["ἀνθρώπων",701163,81],["οὐκ",709805,28],["ἔσται",704093,93],["εἰς",704105,0],["ὄνησιν",709660,9],["καὶ",707031,7],["ὁ",709436,3],["μισθὸς",708939,4],["τῶν",709436,43],["κτηνῶν",707934,44],["οὐχ",709805,28],["ὑπάρξει",713104,127],["καὶ",707031,7],["τῷ",709436,113],["ἐκπορευομένῳ",704293,241],["καὶ",707031,7],["τῷ",709436,113],["εἰσπορευομένῳ",704124,241],["οὐκ",709805,28],["ἔσται",704093,93],["εἰρήνη",704098,12],["ἀπὸ",701425,0],["τῆς",709436,16],["θλίψεως",706276,17],["καὶ",707031,7],["ἐξαποστελῶ",704872,165],["πάντας",710177,60],["τοὺς",709436,58],["ἀνθρώπους",701163,57],["ἕκαστον",704133,27],["ἐπὶ",705080,0],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102]],"For before those days the wages of men could not be profitable, and there could be no hire of cattle, and there could be no peace by reason of the affliction to him that went out or to him that came in: for I would have let loose all men, every one against his neighbour."],["11",[["καὶ",707031,7],["νῦν",709384,28],["οὐ",709805,28],["κατὰ",707200,0],["τὰς",709436,38],["ἡμέρας",705984,17],["τὰς",709436,38],["ἔμπροσθεν",704618,28],["ἐγὼ",704018,164],["ποιῶ",710582,157],["τοῖς",709436,147],["καταλοίποις",707317,230],["τοῦ",709436,35],["λαοῦ",708094,18],["τούτου",709858,102],["λέγει",708124,91],["κύριος",707996,4],["παντοκράτωρ",709986,4]],"But now I [will] not do to the remnant of this people according to the former days, saith the Lord Almighty."],["12",[["ἀλλ᾿",700680,7],["ἢ",705924,7],["δείξω",703314,165],["εἰρήνην",704098,9],["ἡ",709436,10],["ἄμπελος",700870,12],["δώσει",703654,127],["τὸν",709436,5],["καρπὸν",707169,6],["αὐτῆς",702165,86],["καὶ",707031,7],["ἡ",709436,10],["γῆ",703083,12],["δώσει",703654,127],["τὰ",709436,41],["γενήματα",703052,42],["αὐτῆς",702165,86],["καὶ",707031,7],["ὁ",709436,3],["οὐρανὸς",709844,4],["δώσει",703654,127],["τὴν",709436,8],["δρόσον",703835,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["κατακληρονομήσω",707274,165],["τοῖς",709436,147],["καταλοίποις",707317,230],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133],["πάντα",710177,68],["ταῦτα",709858,71]],"But I will shew peace: the vine shall yield her fruit, and the land shall yield her produce, and the heaven shall give its dew: and I will give as an inheritance all these things to the remnant of my people."],["13",[["καὶ",707031,7],["ἔσται",704093,93],["ὃν",709781,112],["τρόπον",712980,6],["ἦτε",704093,399],["ἐν",704639,0],["κατάρᾳ",707395,1],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["οἶκος",709516,153],["Ιουδα",706768,18],["καὶ",707031,7],["οἶκος",709516,4],["Ισραηλ",706839,18],["οὕτως",709859,28],["διασώσω",703599,165],["ὑμᾶς",713080,194],["καὶ",707031,7],["ἔσεσθε",704093,124],["ἐν",704639,0],["εὐλογίᾳ",705633,1],["θαρσεῖτε",706122,335],["καὶ",707031,7],["κατισχύετε",707531,335],["ἐν",704639,0],["ταῖς",709436,75],["χερσὶν",713787,76],["ὑμῶν",713091,145]],"And it shall come to pass, as ye were a curse among the nations, O house of Juda, and house of Israel; so will I save you, and ye shall be a blessing: be of good courage, and strengthen your hands."],["14",[["διότι",703734,7],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["παντοκράτωρ",709986,4],["ὃν",709781,112],["τρόπον",712980,6],["διενοήθην",703528,156],["τοῦ",709436,20],["κακῶσαι",707073,106],["ὑμᾶς",713080,194],["ἐν",704639,0],["τῷ",709436,53],["παροργίσαι",710167,106],["με",708618,163],["τοὺς",709436,58],["πατέρας",710189,57],["ὑμῶν",713091,145],["λέγει",708124,91],["κύριος",707996,4],["παντοκράτωρ",709986,4],["καὶ",707031,7],["οὐ",709805,28],["μετενόησα",708809,155]],"For thus saith the Lord Almighty; As I took counsel to afflict you when your fathers provoked me, saith the Lord Almighty, and I repented not:"],["15",[["οὕτως",709859,28],["παρατέταγμαι",710108,326],["καὶ",707031,7],["διανενόημαι",703528,326],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ταύταις",709858,200],["τοῦ",709436,20],["καλῶς",707106,28],["ποιῆσαι",710582,106],["τὴν",709436,8],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["τὸν",709436,5],["οἶκον",709516,6],["Ιουδα",706768,18],["θαρσεῖτε",706122,335]],"so have I prepared and taken counsel in these days to do good to Jerusalem and to the house of Juda: be ye of good courage."],["16",[["οὗτοι",709858,201],["οἱ",709436,136],["λόγοι",708236,52],["οὓς",709781,298],["ποιήσετε",710582,337],["λαλεῖτε",708071,335],["ἀλήθειαν",700656,9],["ἕκαστος",704133,564],["πρὸς",710844,0],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102],["καὶ",707031,7],["κρίμα",707903,25],["εἰρηνικὸν",704099,27],["κρίνατε",707905,74],["ἐν",704639,0],["ταῖς",709436,75],["πύλαις",711082,76],["ὑμῶν",713091,145]],"These [are] the things which ye shall do; speak truth every one with his neighbour; judge truth and peaceable judgment in your gates:"],["17",[["καὶ",707031,7],["ἕκαστος",704133,14],["τὴν",709436,8],["κακίαν",707054,9],["τοῦ",709436,35],["πλησίον",710547,28],["αὐτοῦ",702165,102],["μὴ",708851,28],["λογίζεσθε",708232,73],["ἐν",704639,0],["ταῖς",709436,75],["καρδίαις",707141,76],["ὑμῶν",713091,145],["καὶ",707031,7],["ὅρκον",709753,6],["ψευδῆ",714036,27],["μὴ",708851,28],["ἀγαπᾶτε",700120,87],["διότι",703734,7],["ταῦτα",709858,71],["πάντα",710177,68],["ἐμίσησα",708935,155],["λέγει",708124,91],["κύριος",707996,4],["παντοκράτωρ",709986,4]],"and let none of you devise evil in his heart against his neighbour; and love not a false oath: for all these things I hate, saith the Lord Almighty."],["18",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κύριου",707996,18],["παντοκράτορος",709986,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72]],"And the word of the Lord Almighty came to me, saying,"],["19",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["παντοκράτωρ",709986,4],["νηστεία",709303,12],["ἡ",709436,10],["τετρὰς",712824,12],["καὶ",707031,7],["νηστεία",709303,12],["ἡ",709436,10],["πέμπτη",710245,29],["καὶ",707031,7],["νηστεία",709303,12],["ἡ",709436,10],["ἑβδόμη",703925,29],["καὶ",707031,7],["νηστεία",709303,12],["ἡ",709436,10],["δεκάτη",703343,29],["ἔσονται",704093,135],["τῷ",709436,113],["οἴκῳ",709516,114],["Ιουδα",706768,18],["εἰς",704105,0],["χαρὰν",713719,9],["καὶ",707031,7],["εἰς",704105,0],["εὐφροσύνην",705717,9],["καὶ",707031,7],["εἰς",704105,0],["ἑορτὰς",704990,39],["ἀγαθὰς",700106,119],["καὶ",707031,7],["εὐφρανθήσεσθε",705715,261],["καὶ",707031,7],["τὴν",709436,8],["ἀλήθειαν",700656,9],["καὶ",707031,7],["τὴν",709436,8],["εἰρήνην",704098,9],["ἀγαπήσατε",700120,74]],"Thus saith the Lord Almighty, The fourth fast, and the fifth fast, and the seventh fast, and the tenth fast, shall be to the house of Juda for joy and gladness, and for good feasts; and ye shall rejoice; and love ye the truth and peace."],["20",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["παντοκράτωρ",709986,4],["ἔτι",705538,28],["ἥξουσιν",705956,218],["λαοὶ",708094,52],["πολλοὶ",710646,138],["καὶ",707031,7],["κατοικοῦντες",707534,146],["πόλεις",710612,39],["πολλάς",710646,119]],"Thus saith the Lord Almighty; Yet shall many peoples come, and the inhabitants of many cities;"],["21",[["καὶ",707031,7],["συνελεύσονται",712458,135],["κατοικοῦντες",707534,146],["πέντε",710266,59],["πόλεις",710612,39],["εἰς",704105,0],["μίαν",704106,36],["πόλιν",710612,9],["λέγοντες",708124,146],["πορευθῶμεν",710667,283],["δεηθῆναι",703394,179],["τοῦ",709436,20],["προσώπου",710986,21],["κυρίου",707996,18],["καὶ",707031,7],["ἐκζητῆσαι",704187,106],["τὸ",709436,24],["πρόσωπον",710986,25],["κυρίου",707996,18],["παντοκράτορος",709986,18],["πορεύσομαι",710667,181],["κἀγώ",706969,288]],"and the inhabitants of five cities shall come together to one city, saying, Let us go to make supplication to the Lord, and to seek the face of the Lord Almighty; I will go also."],["22",[["καὶ",707031,7],["ἥξουσιν",705956,218],["λαοὶ",708094,52],["πολλοὶ",710646,138],["καὶ",707031,7],["ἔθνη",704068,64],["πολλὰ",710646,195],["ἐκζητῆσαι",704187,106],["τὸ",709436,24],["πρόσωπον",710986,25],["κυρίου",707996,18],["παντοκράτορος",709986,18],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["τοῦ",709436,20],["ἐξιλάσκεσθαι",704932,110],["τὸ",709436,24],["πρόσωπον",710986,25],["κυρίου",707996,18]],"And many peoples and many nations shall come to seek earnestly the face of the Lord Almighty in Jerusalem, and to obtain favour of the Lord."],["23",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["παντοκράτωρ",709986,4],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["ἐὰν",703912,7],["ἐπιλάβωνται",705185,232],["δέκα",703333,59],["ἄνδρες",701150,52],["ἐκ",704132,0],["πασῶν",710177,198],["τῶν",709436,130],["γλωσσῶν",703120,65],["τῶν",709436,43],["ἐθνῶν",704068,44],["καὶ",707031,7],["ἐπιλάβωνται",705185,232],["τοῦ",709436,20],["κρασπέδου",707872,21],["ἀνδρὸς",701150,18],["Ιουδαίου",706772,18],["λέγοντες",708124,146],["πορευσόμεθα",710667,141],["μετὰ",708780,0],["σοῦ",711945,133],["διότι",703734,7],["ἀκηκόαμεν",700587,314],["ὅτι",709803,7],["ὁ",709436,3],["θεὸς",706192,4],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["ἐστιν",704093,91]],"Thus saith the Lord Almighty; In those days [my word shall be fulfilled] if ten men of all the languages of the nations should take hold—even take hold of the hem of a Jew, saying, We will go with thee; for we have heard that God is with you."]]