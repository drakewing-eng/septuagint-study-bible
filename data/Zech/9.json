[["1",[["λῆμμα",708175,25],["λόγου",708236,18],["κυρίου",707996,18],["ἐν",704639,0],["γῇ",703083,1],["Σεδραχ",711622,18],["καὶ",707031,7],["Δαμασκοῦ",703275,17],["θυσία",706345,12],["αὐτοῦ",702165,102],["διότι",703734,7],["κύριος",707996,4],["ἐφορᾷ",705057,91],["ἀνθρώπους",701163,57],["καὶ",707031,7],["πάσας",710177,119],["φυλὰς",713620,39],["τοῦ",709436,35],["Ισραηλ",706839,18]],"The burden of the word of the Lord in the land of Sedrach, and his sacrifice [shall be] in Damascus; for the Lord looks upon men, and upon all the tribes of Israel."],["2",[["καὶ",707031,7],["Εμαθ",704541,120],["ἐν",704639,0],["τοῖς",709436,95],["ὁρίοις",709749,96],["αὐτῆς",702165,86],["Τύρος",713028,12],["καὶ",707031,7],["Σιδών",711775,120],["διότι",703734,7],["ἐφρόνησαν",713586,150],["σφόδρα",712586,28]],"And in Emath, [even] in her coasts, [are] Tyre and Sidon, because they were very wise."],["3",[["καὶ",707031,7],["ᾠκοδόμησεν",709509,2],["Τύρος",713028,12],["ὀχυρώματα",709891,42],["ἑαυτῇ",703917,105],["καὶ",707031,7],["ἐθησαύρισεν",706256,2],["ἀργύριον",701707,25],["ὡς",714148,7],["χοῦν",713930,6],["καὶ",707031,7],["συνήγαγεν",712375,2],["χρυσίον",713972,25],["ὡς",714148,7],["πηλὸν",710457,6],["ὁδῶν",709458,65]],"And Tyrus built strong-holds for herself, and heaped up silver as dust, and gathered gold as the mire of the ways."],["4",[["διὰ",703417,0],["τοῦτο",709858,129],["κύριος",707996,4],["κληρονομήσει",707724,127],["αὐτὴν",702165,104],["καὶ",707031,7],["πατάξει",710185,127],["εἰς",704105,0],["θάλασσαν",706069,9],["δύναμιν",703839,9],["αὐτῆς",702165,86],["καὶ",707031,7],["αὕτη",709858,107],["ἐν",704639,0],["πυρὶ",711088,54],["καταναλωθήσεται",707338,134]],"And therefore the Lord will take them for a possession, and will smite her power in the sea; and she shall be consumed with fire."],["5",[["ὄψεται",709725,93],["Ἀσκαλὼν",701962,12],["καὶ",707031,7],["φοβηθήσεται",713532,134],["καὶ",707031,7],["Γάζα",702884,12],["καὶ",707031,7],["ὀδυνηθήσεται",709462,134],["σφόδρα",712586,28],["καὶ",707031,7],["Ακκαρων",700549,120],["ὅτι",709803,7],["ᾐσχύνθη",700485,37],["ἐπὶ",705080,0],["τῷ",709436,53],["παραπτώματι",710095,54],["αὐτῆς",702165,86],["καὶ",707031,7],["ἀπολεῖται",701513,93],["βασιλεὺς",702580,4],["ἐκ",704132,0],["Γάζης",702884,17],["καὶ",707031,7],["Ἀσκαλὼν",701962,12],["οὐ",709805,28],["μὴ",708851,28],["κατοικηθῇ",707534,384]],"Ascalon shall see, and fear; Gaza also, and shall be greatly pained, and Accaron; for she is ashamed at her trespass; and the king shall perish from Gaza, and Ascalon shall not be inhabited."],["6",[["καὶ",707031,7],["κατοικήσουσιν",707534,218],["ἀλλογενεῖς",700690,138],["ἐν",704639,0],["Ἀζώτῳ",700351,1],["καὶ",707031,7],["καθελῶ",706982,165],["ὕβριν",713051,9],["ἀλλοφύλων",700706,169]],"And aliens shall dwell in Azotus, and I will bring down the pride of the Philistines."],["7",[["καὶ",707031,7],["ἐξαρῶ",704839,165],["τὸ",709436,24],["αἷμα",700442,25],["αὐτῶν",702165,40],["ἐκ",704132,0],["στόματος",712125,21],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,41],["βδελύγματα",702604,42],["αὐτῶν",702165,40],["ἐκ",704132,0],["μέσου",708768,92],["ὀδόντων",709461,81],["αὐτῶν",702165,40],["καὶ",707031,7],["ὑπολειφθήσεται",713212,134],["καὶ",707031,7],["οὗτος",709858,121],["τῷ",709436,113],["θεῷ",706192,114],["ἡμῶν",705999,145],["καὶ",707031,7],["ἔσονται",704093,135],["ὡς",714148,7],["χιλίαρχος",713857,4],["ἐν",704639,0],["Ιουδα",706768,114],["καὶ",707031,7],["Ακκαρων",700549,120],["ὡς",714148,7],["ὁ",709436,3],["Ιεβουσαῖος",706519,4]],"And I will take their blood out of their mouth, and their abominations from between their teeth; and these also shall be left to our God, and they shall be as a captain of a thousand in Juda, and Accaron as a Jebusite."],["8",[["καὶ",707031,7],["ὑποστήσομαι",713281,181],["τῷ",709436,113],["οἴκῳ",709516,114],["μου",709032,133],["ἀνάστημα",701058,25],["τοῦ",709436,20],["μὴ",708851,28],["διαπορεύεσθαι",703551,110],["μηδὲ",708855,7],["ἀνακάμπτειν",700969,55],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἐπέλθῃ",705068,172],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["οὐκέτι",709827,28],["ἐξελαύνων",704896,72],["διότι",703734,7],["νῦν",709384,28],["ἑώρακα",709725,89],["ἐν",704639,0],["τοῖς",709436,147],["ὀφθαλμοῖς",709870,148],["μου",709032,133]],"And I will set up a defence for my house, that they may not pass through, nor turn back, neither shall there any more come upon them one to drive them away: for now have I seen with mine eyes."],["9",[["χαῖρε",713665,240],["σφόδρα",712586,28],["θύγατερ",706320,258],["Σιων",711816,17],["κήρυσσε",707662,240],["θύγατερ",706320,258],["Ιερουσαλημ",706644,17],["ἰδοὺ",706497,88],["ὁ",709436,3],["βασιλεύς",702580,4],["σου",711945,133],["ἔρχεταί",705453,117],["σοι",711925,159],["δίκαιος",703694,14],["καὶ",707031,7],["σῴζων",712627,72],["αὐτός",702165,121],["πραῢς",710725,14],["καὶ",707031,7],["ἐπιβεβηκὼς",705082,270],["ἐπὶ",705080,0],["ὑποζύγιον",713198,25],["καὶ",707031,7],["πῶλον",711117,6],["νέον",709256,27]],"Rejoice greatly, O daughter of Sion; proclaim [it] aloud, O daughter of Jerusalem; behold, the King is coming to thee, just, and a Saviour; he is meek and riding on an ass, and a young foal."],["10",[["καὶ",707031,7],["ἐξολεθρεύσει",704956,127],["ἅρματα",701768,42],["ἐξ",704132,0],["Εφραιμ",705769,18],["καὶ",707031,7],["ἵππον",706790,6],["ἐξ",704132,0],["Ιερουσαλημ",706644,17],["καὶ",707031,7],["ἐξολεθρευθήσεται",704956,134],["τόξον",712898,15],["πολεμικόν",710602,26],["καὶ",707031,7],["πλῆθος",710529,25],["καὶ",707031,7],["εἰρήνη",704098,12],["ἐξ",704132,0],["ἐθνῶν",704068,44],["καὶ",707031,7],["κατάρξει",707411,127],["ὑδάτων",713071,44],["ἕως",705792,0],["θαλάσσης",706069,17],["καὶ",707031,7],["ποταμῶν",710693,81],["διεκβολὰς",703658,39],["γῆς",703083,17]],"And he shall destroy the chariots out of Ephraim, and the horse out of Jerusalem, and the bow of war shall be utterly destroyed; and [there shall be] abundance and peace out of the nations; and he shall rule over the waters as far as the sea, and the rivers [to] the ends of the earth."],["11",[["καὶ",707031,7],["σὺ",712181,164],["ἐν",704639,0],["αἵματι",700442,54],["διαθήκης",703456,17],["ἐξαπέστειλας",704872,162],["δεσμίους",703371,60],["σου",711945,133],["ἐκ",704132,0],["λάκκου",708067,18],["οὐκ",709805,28],["ἔχοντος",705785,152],["ὕδωρ",713071,15]],"And thou by the blood of thy covenant hast sent forth thy prisoners out of the pit that has no water."],["12",[["καθήσεσθε",707000,124],["ἐν",704639,0],["ὀχυρώματι",709891,54],["δέσμιοι",703371,274],["τῆς",709436,16],["συναγωγῆς",712376,17],["καὶ",707031,7],["ἀντὶ",701227,0],["μιᾶς",704106,82],["ἡμέρας",705984,17],["παροικεσίας",710155,17],["σου",711945,133],["διπλᾶ",703740,68],["ἀνταποδώσω",701215,165],["σοι",711925,159]],"Ye shall dwell in strongholds, ye prisoners of the congregation: and for one day of thy captivity I will recompense thee double."],["13",[["διότι",703734,7],["ἐνέτεινά",704790,155],["σε",711598,163],["Ιουδα",706768,153],["ἐμαυτῷ",704545,50],["τόξον",712898,25],["ἔπλησα",710532,155],["τὸν",709436,5],["Εφραιμ",705769,6],["καὶ",707031,7],["ἐπεγερῶ",705053,165],["τὰ",709436,41],["τέκνα",712761,42],["σου",711945,133],["Σιων",711816,258],["ἐπὶ",705080,0],["τὰ",709436,41],["τέκνα",712761,42],["τῶν",709436,80],["Ἑλλήνων",704515,81],["καὶ",707031,7],["ψηλαφήσω",714047,165],["σε",711598,163],["ὡς",714148,7],["ῥομφαίαν",711291,9],["μαχητοῦ",708602,18]],"For I have bent thee, O Juda, for myself [as] a bow, I have filled Ephraim; and I will raise up thy children, O Sion, against the children of the Greeks, and I will handle thee as the sword of a warrior."],["14",[["καὶ",707031,7],["κύριος",707996,4],["ἔσται",704093,93],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἐξελεύσεται",704909,93],["ὡς",714148,7],["ἀστραπὴ",702021,12],["βολίς",702756,12],["καὶ",707031,7],["κύριος",707996,4],["παντοκράτωρ",709986,4],["ἐν",704639,0],["σάλπιγγι",711424,1],["σαλπιεῖ",711425,127],["καὶ",707031,7],["πορεύσεται",710667,93],["ἐν",704639,0],["σάλῳ",711420,114],["ἀπειλῆς",701375,17],["αὐτοῦ",702165,102]],"And the Lord shall be over them, and [his] arrow shall go forth as lightning: and the Lord Almighty shall blow with the trumpet; and shall proceed with the tumult of his threatening."],["15",[["κύριος",707996,4],["παντοκράτωρ",709986,4],["ὑπερασπιεῖ",713121,127],["αὐτῶν",702165,40],["καὶ",707031,7],["καταναλώσουσιν",707338,218],["αὐτοὺς",702165,62],["καὶ",707031,7],["καταχώσουσιν",707498,218],["αὐτοὺς",702165,62],["ἐν",704639,0],["λίθοις",708196,148],["σφενδόνης",712578,17],["καὶ",707031,7],["ἐκπίονται",704283,135],["αὐτοὺς",702165,62],["ὡς",714148,7],["οἶνον",709530,6],["καὶ",707031,7],["πλήσουσιν",710532,218],["ὡς",714148,7],["φιάλας",713453,39],["θυσιαστήριον",706348,25]],"The Lord Almighty shall protect them, and they shall destroy them, and overwhelm them with sling-stones; and they shall swallow them down as wine, and fill the bowls as the altar."],["16",[["καὶ",707031,7],["σώσει",712627,127],["αὐτοὺς",702165,62],["κύριος",707996,4],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ὡς",714148,7],["πρόβατα",710768,42],["λαὸν",708094,6],["αὐτοῦ",702165,102],["διότι",703734,7],["λίθοι",708196,52],["ἅγιοι",700159,138],["κυλίονται",707967,269],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["αὐτοῦ",702165,102]],"And the Lord their God shall save them in that day, [even] his people as a flock; for holy stones are rolled upon his land."],["17",[["ὅτι",709803,7],["εἴ",704071,7],["τι",712866,273],["ἀγαθὸν",700106,26],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἴ",704071,7],["τι",712866,273],["καλὸν",707097,26],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["σῖτος",711814,4],["νεανίσκοις",709232,148],["καὶ",707031,7],["οἶνος",709530,4],["εὐωδιάζων",705735,72],["εἰς",704105,0],["παρθένους",710148,39]],"For if he has anything good, and if he has anything fair, the young [men shall have] corn, and [there shall be] fragrant wine to the virgins."]]