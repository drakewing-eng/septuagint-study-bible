,["μήτηρ",708892,12],["αὐτοῦ",702165,102],["οἱ",709436,136],["γεννήσαντες",703051,196],["αὐτὸν",702165,85],["ἐν",704639,0],["τῷ",709436,53],["προφητεύειν",711008,55],["αὐτόν",702165,85]],"And it shall come to pass, if a man will yet prophesy, that his father and his mother which gave birth to him shall say to him, Thou shalt not live; for thou hast spoken lies in the name of the Lord: and his father and his mother who gave him birth shall bind him as he is prophesying."],["4",[["καὶ",707031,7],["ἔσται",704093,93],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["καταισχυνθήσονται",707257,144],["οἱ",709436,136],["προφῆται",711009,52],["ἕκαστος",704133,14],["ἐκ",704132,0],["τῆς",709436,16],["ὁράσεως",709721,17],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,53],["προφητεύειν",711008,55],["αὐτόν",702165,85],["καὶ",707031,7],["ἐνδύσονται",704701,135],["δέρριν",703365,9],["τριχίνην",712971,36],["ἀνθ᾿",701227,0],["ὧν",709781,103],["ἐψεύσαντο",714045,189]],"And it shall come to pass in that day, [that] the prophets shall be ashamed every one of his vision when he prophesies; and they shall clothe themselves with a garment of hair, because they have lied."],["5",[["καὶ",707031,7],["ἐρεῖ",705415,127],["οὔκ",709805,28],["εἰμι",704093,157],["προφήτης",711009,4],["ἐγώ",704018,164],["διότι",703734,7],["ἄνθρωπος",701163,4],["ἐργαζόμενος",705383,122],["τὴν",709436,8],["γῆν",703083,9],["ἐγώ",704018,164],["εἰμι",704093,157],["ὅτι",709803,7],["ἄνθρωπος",701163,4],["ἐγέννησέν",703051,2],["με",708618,163],["ἐκ",704132,0],["νεότητός",709258,17],["μου",709032,133]],"And [one] shall say, I am not a prophet, for I am a tiller of the ground, for a man brought me up [thus] from my youth."],["6",[["καὶ",707031,7],["ἐρῶ",705415,165],["πρὸς",710844,0],["αὐτόν",702165,85],["τί",712867,273],["αἱ",709436,190],["πληγαὶ",710527,191],["αὗται",709858,202],["ἀνὰ",700902,0],["μέσον",708768,46],["τῶν",709436,130],["χειρῶν",713787,65],["σου",711945,133],["καὶ",707031,7],["ἐρεῖ",705415,127],["ἃς",709781,193],["ἐπλήγην",710550,156],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["τῷ",709436,113],["ἀγαπητῷ",700124,30],["μου",709032,133]],"And I will say to him, What are these wounds between thine hands? and he shall say, [Those] with which I was wounded in my beloved house."],["7",[["ῥομφαία",711291,258],["ἐξεγέρθητι",704889,244],["ἐπὶ",705080,0],["τοὺς",709436,58],["ποιμένας",710596,57],["μου",709032,133],["καὶ",707031,7],["ἐπ᾿",705080,0],["ἄνδρα",701150,6],["πολίτην",710616,6],["μου",709032,133],["λέγει",708124,91],["κύριος",707996,4],["παντοκράτωρ",709986,4],["πατάξατε",710185,74],["τοὺς",709436,58],["ποιμένας",710596,57],["καὶ",707031,7],["ἐκσπάσατε",704311,74],["τὰ",709436,41],["πρόβατα",710768,42],["καὶ",707031,7],["ἐπάξω",704994,165],["τὴν",709436,8],["χεῖρά",713787,9],["μου",709032,133],["ἐπὶ",705080,0],["τοὺς",709436,58],["ποιμένας",710596,57]],"Awake, O sword, against my shepherds, and against the man [who is] my citizen, saith the Lord Almighty: smite the shepherds, and draw out the sheep: and I will bring mine hand upon the little ones."],["8",[["καὶ",707031,7],["ἔσται",704093,93],["ἐν",704639,0],["πάσῃ",710177,101],["τῇ",709436,100],["γῇ",703083,1],["λέγει",708124,91],["κύριος",707996,4],["τὰ",709436,63],["δύο",703849,59],["μέρη",708752,64],["ἐξολεθρευθήσεται",704956,134],["καὶ",707031,7],["ἐκλείψει",704237,127],["τὸ",709436,34],["δὲ",703303,11],["τρίτον",712968,14],["ὑπολειφθήσεται",713212,134],["ἐν",704639,0],["αὐτῇ",702165,105]],"And it shall come to pass, [that] in all the land, saith the Lord, two parts thereof shall be cut off and perish; but the third shall be left therein."],["9",[["καὶ",707031,7],["διάξω",703442,165],["τὸ",709436,24],["τρίτον",712968,26],["διὰ",703417,0],["πυρὸς",711088,21],["καὶ",707031,7],["πυρώσω",711103,165],["αὐτούς",702165,62],["ὡς",714148,7],["πυροῦται",711103,117],["τὸ",709436,34],["ἀργύριον",701707,15],["καὶ",707031,7],["δοκιμῶ",703776,165],["αὐτούς",702165,62],["ὡς",714148,7],["δοκιμά