71],["με",708618,163],["ἐπὶ",705080,0],["τὰ",709436,41],["ἔθνη",704068,42],["τὰ",709436,41],["σκυλεύσαντα",711900,373],["ὑμᾶς",713080,194],["διότι",703734,7],["ὁ",709436,3],["ἁπτόμενος",701654,122],["ὑμῶν",713091,145],["ὡς",714148,7],["ἁπτόμενος",701654,122],["τῆς",709436,16],["κόρης",707836,17],["τοῦ",709436,35],["ὀφθαλμοῦ",709870,18],["αὐτοῦ",702165,102]],"For thus saith the Lord Almighty; After the glory has he sent me to the nations that spoiled you: for he that touches you is as one that touches the apple of his eye."],["13",[["διότι",703734,7],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐπιφέρω",705322,157],["τὴν",709436,8],["χεῖρά",713787,9],["μου",709032,133],["ἐπ᾿",705080,0],["αὐτούς",702165,62],["καὶ",707031,7],["ἔσονται",704093,135],["σκῦλα",711902,64],["τοῖς",709436,147],["δουλεύουσιν",703814,349],["αὐτοῖς",702165,151],["καὶ",707031,7],["γνώσεσθε",703105,124],["διότι",703734,7],["κύριος",707996,4],["παντοκράτωρ",709986,4],["ἀπέσταλκέν",701592,171],["με",708618,163]],"For, behold, I bring my hand upon them, and they shall be a spoil to them that serve them: and ye shall know that the Lord Almighty has sent me."],["14",[["τέρπου",712804,253],["καὶ",707031,7],["εὐφραίνου",705715,253],["θύγατερ",706320,258],["Σιων",711816,17],["διότι",703734,7],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἔρχομαι",705453,254],["καὶ",707031,7],["κατασκηνώσω",707423,165],["ἐν",704639,0],["μέσῳ",708768,97],["σου",711945,133],["λέγει",708124,91],["κύριος",707996,4]],"Rejoice and be glad, O daughter of Sion: for, behold, I come, and will dwell in the midst of thee, saith the Lord."],["15",[["καὶ",707031,7],["καταφεύξονται",707472,135],["ἔθνη",704068,64],["πολλὰ",710646,195],["ἐπὶ",705080,0],["τὸν",709436,5],["κύριον",707996,6],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["καὶ",707031,7],["ἔσονται",704093,135],["αὐτῷ",702165,50],["εἰς",704105,0],["λαὸν",708094,6],["καὶ",707031,7],["κατασκηνώσουσιν",707423,218],["ἐν",704639,0],["μέσῳ",708768,97],["σου",711945,133],["καὶ",707031,7],["ἐπιγνώσῃ",705104,123],["ὅτι",709803,7],["κύριος",707996,4],["παντοκράτωρ",709986,4],["ἐξαπέσταλκέν",704872,171],["με",708618,163],["πρὸς",710844,0],["σέ",711598,163]],"And many nations shall flee for refuge to the Lord in that day, and they shall be for a people to him, and they shall dwell in the midst of thee: and thou shalt know that the Lord Almighty has sent me to thee."],["16",[["καὶ",707031,7],["κατακληρονομήσει",707274,127],["κύριος",707996,4],["τὸν",709436,5],["Ιουδαν",706775,6],["τὴν",709436,8],["μερίδα",708748,9],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["τὴν",709436,8],["ἁγίαν",700159,36],["καὶ",707031,7],["αἱρετιεῖ",700469,127],["ἔτι",705538,28],["τὴν",709436,8],["Ιερουσαλημ",706644,9]],"And the Lord shall inherit Juda his portion in the holy [land], and he will yet choose Jerusalem."],["17",[["εὐλαβείσθω",705627,407],["πᾶσα",710177,29],["σὰρξ",711537,12],["ἀπὸ",701425,0],["προσώπου",710986,21],["κυρίου",707996,18],["διότι",703734,7],["ἐξεγήγερται",704889,187],["ἐκ",704132,0],["νεφελῶν",709277,65],["ἁγίων",700159,198],["αὐτοῦ",702165,102]],"Let all flesh fear before the Lord: for he has risen up from his holy clouds."]]