[["1",[["καὶ",707031,7],["ἦρα",700473,155],["τοὺς",709436,58],["ὀφθαλμούς",709870,57],["μου",709032,133],["καὶ",707031,7],["εἶδον",709725,150],["καὶ",707031,7],["ἰδοὺ",706497,88],["τέσσαρα",712808,68],["κέρατα",707625,42]],"And I lifted up mine eyes and looked, and behold four horns."],["2",[["καὶ",707031,7],["εἶπα",705373,155],["πρὸς",710844,0],["τὸν",709436,5],["ἄγγελον",700140,6],["τὸν",709436,5],["λαλοῦντα",708071,183],["ἐν",704639,0],["ἐμοί",704577,159],["τί",712867,273],["ἐστιν",704093,91],["ταῦτα",709858,290],["κύριε",707996,153],["καὶ",707031,7],["εἶπεν",705373,2],["πρός",710844,0],["με",708618,163],["ταῦτα",709858,290],["τὰ",709436,63],["κέρατα",707625,64],["τὰ",709436,63],["διασκορπίσαντα",703579,773],["τὸν",709436,5],["Ιουδαν",706775,6],["καὶ",707031,7],["τὸν",709436,5],["Ισραηλ",706839,6]],"And I said to the angel that spoke with me, What are these things, [my] lord? And he said to me, These are the horns that have scattered Juda, and Israel, and Jerusalem."],["3",[["καὶ",707031,7],["ἔδειξέν",703314,2],["μοι",708974,159],["κύριος",707996,4],["τέσσαρας",712808,60],["τέκτονας",712766,57]],"And the Lord shewed me four artificers."],["4",[["καὶ",707031,7],["εἶπα",705373,155],["τί",712867,126],["οὗτοι",709858,201],["ἔρχονται",705453,269],["ποιῆσαι",710582,106],["καὶ",707031,7],["εἶπεν",705373,2],["πρός",710844,0],["με",708618,163],["ταῦτα",709858,290],["τὰ",709436,63],["κέρατα",707625,64],["τὰ",709436,63],["διασκορπίσαντα",703579,773],["τὸν",709436,5],["Ιουδαν",706775,6],["καὶ",707031,7],["τὸν",709436,5],["Ισραηλ",706839,6],["κατέαξαν",707227,150],["καὶ",707031,7],["οὐδεὶς",709817,14],["αὐτῶν",702165,40],["ἦρεν",700473,2],["κεφαλήν",707639,9],["καὶ",707031,7],["εἰσῆλθον",704114,150],["οὗτοι",709858,201],["τοῦ",709436,20],["ὀξῦναι",709681,106],["αὐτὰ",702165,71],["εἰς",704105,0],["χεῖρας",713787,39],["αὐτῶν",702165,40],["τὰ",709436,41],["τέσσαρα",712808,68],["κέρατα",707625,42],["τὰ",709436,41],["ἔθνη",704068,42],["τὰ",709436,41],["ἐπαιρόμενα",705002,67],["κέρ