[["1",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["2",[["ποίησον",710582,176],["σεαυτῷ",711599,50],["δύο",703849,59],["σάλπιγγας",711424,39],["ἀργυρᾶς",701705,119],["ἐλατὰς",704389,39],["ποιήσεις",710582,166],["αὐτάς",702165,231],["καὶ",707031,7],["ἔσονταί",704093,135],["σοι",711925,159],["ἀνακαλεῖν",700967,55],["τὴν",709436,8],["συναγωγὴν",712376,9],["καὶ",707031,7],["ἐξαίρειν",704839,55],["τὰς",709436,38],["παρεμβολάς",710133,39]],"Make to thyself two silver trumpets: thou shalt make them of beaten work; and they shall be to thee for the purpose of calling the assembly, and of removing the camps."],["3",[["καὶ",707031,7],["σαλπίσεις",711425,166],["ἐν",704639,0],["αὐταῖς",702165,200],["καὶ",707031,7],["συναχθήσεται",712375,134],["πᾶσα",710177,29],["ἡ",709436,10],["συναγωγὴ",712376,12],["ἐπὶ",705080,0],["τὴν",709436,8],["θύραν",706337,9],["τῆς",709436,16],["σκηνῆς",711845,17],["τοῦ",709436,20],["μαρτυρίου",708525,21]],"And thou shalt sound with them, and all the congregation shall be gathered to the door of the tabernacle of witness."],["4",[["ἐὰν",703912,7],["δὲ",703303,11],["ἐν",704639,0],["μιᾷ",704106,101],["σαλπίσωσιν",711425,234],["προσελεύσονται",710890,135],["πρὸς",710844,0],["σὲ",711598,163],["πάντες",710177,138],["οἱ",709436,136],["ἄρχοντες",701862,52],["ἀρχηγοὶ",701838,52],["Ισραηλ",706839,18]],"And if they shall sound with one, all the rulers even the princes of Israel shall come to thee."],["5",[["καὶ",707031,7],["σαλπιεῖτε",711425,337],["σημασίαν",711746,9],["καὶ",707031,7],["ἐξαροῦσιν",704839,218],["αἱ",709436,190],["παρεμβολαὶ",710133,191],["αἱ",709436,190],["παρεμβάλλουσαι",710132,306],["ἀνατολάς",701071,39]],"And ye shall sound an alarm, and the camps pitched eastward shall begin to move."],["6",[["καὶ",707031,7],["σαλπιεῖτε",711425,337],["σημασίαν",711746,9],["δευτέραν",703389,36],["καὶ",707031,7],["ἐξαροῦσιν",704839,218],["αἱ",709436,190],["παρεμβολαὶ",710133,191],["αἱ",709436,190],["παρεμβάλλουσαι",710132,306],["λίβα",708224,6],["καὶ",707031,7],["σαλπιεῖτε",711425,337],["σημασίαν",711746,9],["τρίτην",712968,36],["καὶ",707031,7],["ἐξαροῦσιν",704839,218],["αἱ",709436,190],["παρεμβολαὶ",710133,191],["αἱ",709436,190],["παρεμβάλλουσαι",710132,306],["παρὰ",709995,0],["θάλασσαν",706069,9],["καὶ",707031,7],["σαλπιεῖτε",711425,337],["σημασίαν",711746,9],["τετάρτην",712811,36],["καὶ",707031,7],["ἐξαροῦσιν",704839,218],["αἱ",709436,190],["παρεμβολαὶ",710133,191],["αἱ",709436,190],["παρεμβάλλουσαι",710132,306],["πρὸς",710844,0],["βορρᾶν",702765,6],["σημασίᾳ",711746,1],["σαλπιοῦσιν",711425,218],["ἐν",704639,0],["τῇ",709436,100],["ἐξάρσει",704881,1],["αὐτῶν",702165,40]],"And ye shall sound a second alarm, and the camps pitched southward shall move; and ye shall sound a third alarm, and the camps pitched westward shall move forward; and ye shall sound a fourth alarm, and they that encamp toward the north shall move forward: they shall sound an alarm at their departure."],["7",[["καὶ",707031,7],["ὅταν",709801,28],["συναγάγητε",712375,125],["τὴν",709436,8],["συναγωγήν",712376,9],["σαλπιεῖτε",711425,337],["καὶ",707031,7],["οὐ",709805,28],["σημασίᾳ",711746,1]],"And whenever ye shall gather the assembly, ye shall sound, but not an alarm."],["8",[["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["Ααρων",700005,18],["οἱ",709436,136],["ἱερεῖς",706614,52],["σαλπιοῦσιν",711425,218],["ταῖς",709436,75],["σάλπιγξιν",711424,76],["καὶ",707031,7],["ἔσται",704093,93],["ὑμῖν",713084,90],["νόμιμον",709340,26],["αἰώνιον",700505,26],["εἰς",704105,0],["τὰς",709436,38],["γενεὰς",703037,39],["ὑμῶν",713091,145]],"And the priests the sons of Aaron shall sound with the trumpets; and it shall be a perpetual ordinance for you throughout your generations."],["9",[["ἐὰν",703912,7],["δὲ",703303,11],["ἐξέλθητε",704909,125],["εἰς",704105,0],["πόλεμον",710605,6],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ὑμῶν",713091,145],["πρὸς",710844,0],["τοὺς",709436,58],["ὑπεναντίους",713109,60],["τοὺς",709436,58],["ἀνθεστηκότας",701154,277],["ὑμῖν",713084,90],["καὶ",707031,7],["σημανεῖτε",711745,337],["ταῖς",709436,75],["σάλπιγξιν",711424,76],["καὶ",707031,7],["ἀναμνησθήσεσθε",701002,261],["ἔναντι",704653,0],["κυρίου",707996,18],["καὶ",707031,7],["διασωθήσεσθε",703599,261],["ἀπὸ",701425,0],["τῶν",709436,80],["ἐχθρῶν",705779,81],["ὑμῶν",713091,145]],"And if ye shall go forth to war in your land against your enemies that are opposed to you, then shall ye sound with the trumpets; and ye shall be had in remembrance before the Lord, and ye shall be saved from your enemies."],["10",[["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["τῆς",709436,16],["εὐφροσύνης",705717,17],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἑορταῖς",704990,76],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["νουμηνίαις",709371,76],["ὑμῶν",713091,145],["σαλπιεῖτε",711425,337],["ταῖς",709436,75],["σάλπιγξιν",711424,76],["ἐπὶ",705080,0],["τοῖς",709436,95],["ὁλοκαυτώμασιν",709589,96],["καὶ",707031,7],["ἐπὶ",705080,0],["ταῖς",709436,75],["θυσίαις",706345,76],["τῶν",709436,80],["σωτηρίων",712659,44],["ὑμῶν",713091,145],["καὶ",707031,7],["ἔσται",704093,93],["ὑμῖν",713084,90],["ἀνάμνησις",701004,12],["ἔναντι",704653,0],["τοῦ",709436,35],["θεοῦ",706192,18],["ὑμῶν",713091,145],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"And in the days of your gladness, and in your feasts, and in your new moons, ye shall sound with the trumpets at your whole-burnt-offerings, and at the sacrifices of your peace-offerings; and there shall be a memorial for you before your God: I [am] the Lord your God."],["11",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["τῷ",709436,113],["ἐνιαυτῷ",704745,114],["τῷ",709436,113],["δευτέρῳ",703389,30],["ἐν",704639,0],["τῷ",709436,113],["μηνὶ",708874,114],["τῷ",709436,113],["δευτέρῳ",703389,30],["εἰκάδι",704082,1],["τοῦ",709436,35],["μηνὸς",708874,18],["ἀνέβη",700905,2],["ἡ",709436,10],["νεφέλη",709277,12],["ἀπὸ",701425,0],["τῆς",709436,16],["σκηνῆς",711845,17],["τοῦ",709436,20],["μαρτυρίου",708525,21]],"And it came to pass in the second year, in the second month, on the twentieth day of the month, the cloud went up from the tabernacle of witness."],["12",[["καὶ",707031,7],["ἐξῆραν",704839,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["σὺν",712372,0],["ἀπαρτίαις",701358,76],["αὐτῶν",702165,40],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["Σινα",711794,118],["καὶ",707031,7],["ἔστη",706846,2],["ἡ",709436,10],["νεφέλη",709277,12],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["τοῦ",709436,483],["Φαραν",713358,118]],"And the children of Israel set forward with their baggage in the wilderness of Sina; and the cloud rested in the wilderness of Pharan."],["13",[["καὶ",707031,7],["ἐξῆραν",704839,150],["πρῶτοι",711041,480],["διὰ",703417,0],["φωνῆς",713640,17],["κυρίου",707996,18],["ἐν",704639,0],["χειρὶ",713787,1],["Μωυσῆ",709112,18]],"And the first rank departed by the word of the Lord by the hand of Moses."],["14",[["καὶ",707031,7],["ἐξῆραν",704839,150],["τάγμα",712689,25],["παρεμβολῆς",710133,17],["υἱῶν",713075,81],["Ιουδα",706768,18],["πρῶτοι",711041,480],["σὺν",712372,0],["δυνάμει",703839,1],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["δυνάμεως",703839,17],["αὐτῶν",702165,40],["Ναασσων",709127,4],["υἱὸς",713075,4],["Αμιναδαβ",700824,18]],"And they first set in motion the order of the camp of the children of Juda with their host; and over their host [was] Naasson, son of Aminadab."],["15",[["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["δυνάμεως",703839,17],["φυλῆς",713620,17],["υἱῶν",713075,81],["Ισσαχαρ",706843,18],["Ναθαναηλ",709165,4],["υἱὸς",713075,4],["Σωγαρ",712625,18]],"And over the host of the tribe of the sons of Issachar, [was] Nathanael son of Sogar."],["16",[["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["δυνάμεως",703839,17],["φυλῆς",713620,17],["υἱῶν",713075,81],["Ζαβουλων",705813,18],["Ελιαβ",704446,4],["υἱὸς",713075,4],["Χαιλων",713661,18]],"And over the host of the tribe of the sons of Zabulon, [was] Eliab the son of Chælon."],["17",[["καὶ",707031,7],["καθελοῦσιν",706982,218],["τὴν",709436,8],["σκηνὴν",711845,9],["καὶ",707031,7],["ἐξαροῦσιν",704839,218],["οἱ",709436,136],["υἱοὶ",713075,52],["Γεδσων",702999,18],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["Μεραρι",708739,18],["αἴροντες",700473,146],["τὴν",709436,8],["σκηνήν",711845,9]],"And they shall take down the tabernacle, and the sons of Gedson shall set forward, and the sons of Merari, who bear the tabernacle."],["18",[["καὶ",707031,7],["ἐξῆραν",704839,150],["τάγμα",712689,25],["παρεμβολῆς",710133,17],["Ρουβην",711295,18],["σὺν",712372,0],["δυνάμει",703839,1],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["δυνάμεως",703839,17],["αὐτῶν",702165,40],["Ελισουρ",704489,4],["υἱὸς",713075,4],["Σεδιουρ",711621,18]],"And the order of the camp of Ruben set forward with their host; and over their host [was] Elisur the son of Sediur."],["19",[["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["δυνάμεως",703839,17],["φυλῆς",713620,17],["υἱῶν",713075,81],["Συμεων",712297,18],["Σαλαμιηλ",711399,4],["υἱὸς",713075,4],["Σουρισαδαι",711966,18]],"And over the host of the tribe of the sons of Symeon, [was] Salamiel son of Surisadai."],["20",[["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["δυνάμεως",703839,17],["φυλῆς",713620,17],["υἱῶν",713075,81],["Γαδ",702872,18],["Ελισαφ",704486,4],["ὁ",709436,3],["τοῦ",709436,35],["Ραγουηλ",711144,18]],"And over the host of the tribe of the children of Gad, [was] Elisaph the son of Raguel."],["21",[["καὶ",707031,7],["ἐξαροῦσιν",704839,218],["οἱ",709436,136],["υἱοὶ",713075,52],["Κααθ",706961,18],["αἴροντες",700473,146],["τὰ",709436,41],["ἅγια",700159,68],["καὶ",707031,7],["στήσουσιν",706846,218],["τὴν",709436,8],["σκηνήν",711845,9],["ἕως",705792,7],["παραγένωνται",710006,232]],"And the sons of Caath shall set forward bearing the holy things, and [the others] shall set up the tabernacle until they arrive."],["22",[["καὶ",707031,7],["ἐξαροῦσιν",704839,218],["τάγμα",712689,25],["παρεμβολῆς",710133,17],["Εφραιμ",705769,18],["σὺν",712372,0],["δυνάμει",703839,1],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["δυνάμεως",703839,17],["αὐτῶν",702165,40],["Ελισαμα",704484,4],["υἱὸς",713075,4],["Εμιουδ",704565,18]],"And the order of the camp of Ephraim shall set forward with their forces; and over their forces [was] Elisama the son of Semiud."],["23",[["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["δυνάμεως",703839,17],["φυλῆς",713620,17],["υἱῶν",713075,81],["Μανασση",708470,18],["Γαμαλιηλ",702945,4],["ὁ",709436,3],["τοῦ",709436,35],["Φαδασσουρ",713303,18]],"And over the forces of the tribe of the sons of Manasse, [was] Gamaliel the [son] of Phadassur."],["24",[["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["δυνάμεως",703839,17],["φυλῆς",713620,17],["υἱῶν",713075,81],["Βενιαμιν",702650,18],["Αβιδαν",700061,4],["ὁ",709436,3],["τοῦ",709436,35],["Γαδεωνι",702879,18]],"And over the forces of the tribe of the children of Benjamin, [was] Abidan the [son] of Gadeoni."],["25",[["καὶ",707031,7],["ἐξαροῦσιν",704839,218],["τάγμα",712689,25],["παρεμβολῆς",710133,17],["υἱῶν",713075,81],["Δαν",703276,18],["ἔσχατοι",705519,138],["πασῶν",710177,198],["τῶν",709436,130],["παρεμβολῶν",710133,65],["σὺν",712372,0],["δυνάμει",703839,1],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["δυνάμεως",703839,17],["αὐτῶν",702165,40],["Αχιεζερ",702268,4],["ὁ",709436,3],["τοῦ",709436,35],["Αμισαδαι",700826,18]],"And the order of the camp of the sons of Dan shall set forward the last of all the camps, with their forces: and over their forces [was] Achiezer the [son] of Amisadai."],["26",[["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["δυνάμεως",703839,17],["φυλῆς",713620,17],["υἱῶν",713075,81],["Ασηρ",701934,18],["Φαγαιηλ",713294,4],["υἱὸς",713075,4],["Εχραν",705784,18]],"And over the forces of the tribe of the sons of Aser, [was] Phageel the son of Echran."],["27",[["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["δυνάμεως",703839,17],["φυλῆς",713620,17],["υἱῶν",713075,81],["Νεφθαλι",709279,18],["Αχιρε",702291,4],["υἱὸς",713075,4],["Αιναν",700455,18]],"And over the forces of the tribe of the sons of Nephthali, [was] Achire the son of Ænan."],["28",[["αὗται",709858,202],["αἱ",709436,190],["στρατιαὶ",712145,191],["υἱῶν",713075,81],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐξῆραν",704839,150],["σὺν",712372,0],["δυνάμει",703839,1],["αὐτῶν",702165,40]],"These [are] the armies of the children of Israel; and they set forward with their forces."],["29",[["καὶ",707031,7],["εἶπεν",705373,2],["Μωυσῆς",709112,4],["τῷ",709436,113],["Ιωβαβ",706904,114],["υἱῷ",713075,114],["Ραγουηλ",711144,18],["τῷ",709436,113],["Μαδιανίτῃ",708356,114],["τῷ",709436,113],["γαμβρῷ",702950,114],["Μωυσῆ",709112,18],["ἐξαίρομεν",704839,243],["ἡμεῖς",705983,219],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["ὃν",709781,112],["εἶπεν",705373,2],["κύριος",707996,4],["τοῦτον",709858,129],["δώσω",703654,165],["ὑμῖν",713084,90],["δεῦρο",703382,28],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["καὶ",707031,7],["εὖ",705544,28],["σε",711598,163],["ποιήσομεν",710582,275],["ὅτι",709803,7],["κύριος",707996,4],["ἐλάλησεν",708071,2],["καλὰ",707097,68],["περὶ",710285,0],["Ισραηλ",706839,18]],"And Moses said to Obab the son of Raguel the Madianite, the father-in-law of Moses, We are going forward to the place concerning which the Lord said, This will I give to you: Come with us, and we will do thee good, for the Lord has spoken good concerning Israel."],["30",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτόν",702165,85],["οὐ",709805,28],["πορεύσομαι",710667,181],["ἀλλὰ",700680,7],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["μου",709032,133],["καὶ",707031,7],["εἰς",704105,0],["τὴν",709436,8],["γενεάν",703037,9],["μου",709032,133]],"And he said to him, I will not go, but [I will go] to my land and to my kindred."],["31",[["καὶ",707031,7],["εἶπεν",705373,2],["μὴ",708851,28],["ἐγκαταλίπῃς",703967,175],["ἡμᾶς",705981,194],["οὗ",709781,48],["εἵνεκεν",704709,0],["ἦσθα",704093,363],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["καὶ",707031,7],["ἔσῃ",704093,123],["ἐν",704639,0],["ἡμῖν",705994,90],["πρεσβύτης",710736,4]],"And he said, Leave us not, because thou hast been with us in the wilderness, and thou shalt be an elder among us."],["32",[["καὶ",707031,7],["ἔσται",704093,93],["ἐὰν",703912,7],["πορευθῇς",710667,279],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["καὶ",707031,7],["ἔσται",704093,93],["τὰ",709436,41],["ἀγαθὰ",700106,68],["ἐκεῖνα",704183,71],["ὅσα",709788,68],["ἐὰν",703912,7],["ἀγαθοποιήσῃ",700104,172],["κύριος",707996,4],["ἡμᾶς",705981,194],["καὶ",707031,7],["εὖ",705544,28],["σε",711598,163],["ποιήσομεν",710582,275]],"And it shall come to pass if thou wilt go with us, it shall even come to pass that in whatsoever things the Lord shall do us good, we will also do thee good."],["33",[["καὶ",707031,7],["ἐξῆραν",704839,150],["ἐκ",704132,0],["τοῦ",709436,20],["ὄρους",709768,21],["κυρίου",707996,18],["ὁδὸν",709458,9],["τριῶν",712927,198],["ἡμερῶν",705984,65],["καὶ",707031,7],["ἡ",709436,10],["κιβωτὸς",707667,12],["τῆς",709436,16],["διαθήκης",703456,17],["κυρίου",707996,18],["προεπορεύετο",710839,19],["προτέρα",710992,484],["αὐτῶν",702165,40],["ὁδὸν",709458,9],["τριῶν",712927,198],["ἡμερῶν",705984,65],["κατασκέψασθαι",707418,109],["αὐτοῖς",702165,151],["ἀνάπαυσιν",701026,9]],"And they departed from the mount of the Lord a three days' journey; and the ark of the covenant of the Lord went before them a three days' journey to provide rest for them."],["34",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["τῷ",709436,53],["ἐξαίρειν",704839,55],["τὴν",709436,