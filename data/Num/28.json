5,114],["τῷ",709436,113],["ἑνὶ",704106,30],["τοῖς",709436,147],["ἑπτὰ",705357,59],["ἀμνοῖς",700855,148]],"A tenth for each lamb separately, for the seven lambs; and a kid of the goats,"],["30",[["καὶ",707031,7],["χίμαρον",713864,6],["ἐξ",704132,0],["αἰγῶν",700464,81],["ἕνα",704106,27],["περὶ",710285,0],["ἁμαρτίας",700775,17],["ἐξιλάσασθαι",704932,109],["περὶ",710285,0],["ὑμῶν",713091,145]],"for a sin-offering, to make atonement for you; beside the perpetual whole-burnt-offering: and",{"s":"d","q":0.67}],["31",[["πλὴν",710540,0],["τοῦ",709436,20],["ὁλοκαυτώματος",709589,21],["τοῦ",709436,20],["διὰ",703417,0],["παντός",710177,92],["καὶ",707031,7],["τὴν",709436,8],["θυσίαν",706345,9],["αὐτῶν",702165,70],["ποιήσετέ",710582,337],["μοι",708974,159],["ἄμωμοι",700895,138],["ἔσονται",704093,135],["ὑμῖν",713084,90],["καὶ",707031,7],["τὰς",709436,38],["σπονδὰς",712025,39],["αὐτῶν",702165,70]],"ye shall offer to me their meat-offering. They shall be to you unblemished, and ye shall offer their drink-offerings.",{"s":"d","q":0.68}]]