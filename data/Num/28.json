[["1",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["2",[["ἔντειλαι",704791,300],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐρεῖς",705415,166],["πρὸς",710844,0],["αὐτοὺς",702165,62],["λέγων",708124,72],["τὰ",709436,41],["δῶρά",703907,42],["μου",709032,133],["δόματά",703789,42],["μου",709032,133],["καρπώματά",707174,42],["μου",709032,133],["εἰς",704105,0],["ὀσμὴν",709786,9],["εὐωδίας",705734,17],["διατηρήσετε",703607,337],["προσφέρειν",710974,55],["ἐμοὶ",704577,159],["ἐν",704639,0],["ταῖς",709436,75],["ἑορταῖς",704990,76],["μου",709032,133]],"Charge the children of Israel, and thou shalt speak to them, saying, Ye shall observe to offer to me in my feasts my gifts, my presents, my burnt-offerings for a sweet-smelling savour."],["3",[["καὶ",707031,7],["ἐρεῖς",705415,166],["πρὸς",710844,0],["αὐτούς",702165,62],["ταῦτα",709858,290],["τὰ",709436,63],["καρπώματα",707174,64],["ὅσα",709788,68],["προσάξετε",710848,337],["κυρίῳ",707996,114],["ἀμνοὺς",700855,57],["ἐνιαυσίους",704744,60],["ἀμώμους",700895,60],["δύο",703849,59],["τὴν",709436,8],["ἡμέραν",705984,9],["εἰς",704105,0],["ὁλοκαύτωσιν",709590,9],["ἐνδελεχῶς",704681,28]],"And thou shalt say to them, These are the burnt-offerings, all that ye shall bring to the Lord; two lambs of a year old without blemish daily, for a whole-burnt offering perpetually."],["4",[["τὸν",709436,5],["ἀμνὸν",700855,6],["τὸν",709436,5],["ἕνα",704106,27],["ποιήσεις",710582,166],["τὸ",709436,24],["πρωὶ",711021,28],["καὶ",707031,7],["τὸν",709436,5],["ἀμνὸν",700855,6],["τὸν",709436,5],["δεύτερον",703389,27],["ποιήσεις",710582,166],["τὸ",709436,24],["πρὸς",710844,0],["ἑσπέραν",705500,9]],"Thou shalt offer one lamb in the morning, and thou shalt offer the second lamb towards evening."],["5",[["καὶ",707031,7],["ποιήσεις",710582,166],["τὸ",709436,24],["δέκατον",703343,46],["τοῦ",709436,35],["οιφι",709538,21],["σεμίδαλιν",711675,9],["εἰς",704105,0],["θυσίαν",706345,9],["ἀναπεποιημένην",701040,436],["ἐν",704639,0],["ἐλαίῳ",704380,54],["ἐν",704639,0],["τετάρτῳ",712811,30],["τοῦ",709436,35],["ιν",706746,21]],"And thou shalt offer the tenth part of an ephah of fine flour for a meat-offering, mingled with oil, with the fourth part of a hin."],["6",[["ὁλοκαύτωμα",709589,15],["ἐνδελεχισμοῦ",704680,18],["ἡ",709436,10],["γενομένη",703104,357],["ἐν",704639,0],["τῷ",709436,53],["ὄρει",709768,54],["Σινα",711794,118],["εἰς",704105,0],["ὀσμὴν",709786,9],["εὐωδίας",705734,17],["κυρίῳ",707996,114]],"[It is] a perpetual whole-burnt-offering, a sacrifice offered in the mount of Sina for a sweet-smelling savour to the Lord."],["7",[["καὶ",707031,7],["σπονδὴν",712025,9],["αὐτοῦ",702165,102],["τὸ",709436,24],["τέταρτον",712811,46],["τοῦ",709436,35],["ιν",706746,21],["τῷ",709436,113],["ἀμνῷ",700855,114],["τῷ",709436,113],["ἑνί",704106,30],["ἐν",704639,0],["τῷ",709436,53],["ἁγίῳ",700159,97],["σπείσεις",712007,166],["σπονδὴν",712025,9],["σικερα",711781,25],["κυρίῳ",707996,114]],"And its drink-offering, the fourth part of a hin to each lamb; in the holy place shalt thou pour strong drink as a drink-offering to the Lord."],["8",[["καὶ",707031,7],["τὸν",709436,5],["ἀμνὸν",700855,6],["τὸν",709436,5],["δεύτερον",703389,27],["ποιήσεις",710582,166],["τὸ",709436,24],["πρὸς",710844,0],["ἑσπέραν",705500,9],["κατὰ",707200,0],["τὴν",709436,8],["θυσίαν",706345,9],["αὐτοῦ",702165,49],["καὶ",707031,7],["κατὰ",707200,0],["τὴν",709436,8],["σπονδὴν",712025,9],["αὐτοῦ",702165,49],["ποιήσετε",710582,337],["εἰς",704105,0],["ὀσμὴν",709786,9],["εὐωδίας",705734,17],["κυρίῳ",707996,114]],"And the second lamb thou shalt offer toward evening; thou shalt offer it according to its meat-offering and according to its drink-offering for a smell of sweet savour to the Lord."],["9",[["καὶ",707031,7],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῶν",709436,43],["σαββάτων",711350,44],["προσάξετε",710848,337],["δύο",703849,59],["ἀμ