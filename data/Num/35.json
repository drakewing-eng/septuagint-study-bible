[["1",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["ἐπὶ",705080,0],["δυσμῶν",703865,65],["Μωαβ",709085,18],["παρὰ",709995,0],["τὸν",709436,5],["Ιορδάνην",706763,6],["κατὰ",707200,0],["Ιεριχω",706620,6],["λέγων",708124,72]],"And the Lord spoke to Moses to the west of Moab by Jordan near Jericho, saying,"],["2",[["σύνταξον",712508,176],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["καὶ",707031,7],["δώσουσιν",703654,218],["τοῖς",709436,147],["Λευίταις",708160,148],["ἀπὸ",701425,0],["τῶν",709436,80],["κλήρων",707727,81],["κατασχέσεως",707451,17],["αὐτῶν",702165,40],["πόλεις",710612,39],["κατοικεῖν",707534,55],["καὶ",707031,7],["τὰ",709436,41],["προάστεια",710762,42],["τῶν",709436,130],["πόλεων",710612,65],["κύκλῳ",707959,114],["αὐτῶν",702165,40],["δώσουσιν",703654,218],["τοῖς",709436,147],["Λευίταις",708160,148]],"Give orders to the children of Israel, and they shall give to the Levites cities to dwell in from the lot of their possession, and they shall give to the Levites the suburbs of the cities round about them."],["3",[["καὶ",707031,7],["ἔσονται",704093,135],["αὐτοῖς",702165,151],["αἱ",709436,190],["πόλεις",710612,191],["κατοικεῖν",707534,55],["καὶ",707031,7],["τὰ",709436,63],["ἀφορίσματα",702228,64],["αὐτῶν",702165,40],["ἔσται",704093,93],["τοῖς",709436,95],["κτήνεσιν",707934,96],["αὐτῶν",702165,40],["καὶ",707031,7],["πᾶσι",710177,94],["τοῖς",709436,95],["τετράποσιν",712823,94],["αὐτῶν",702165,40]],"And the cities shall be for them to dwell in, and their enclosures shall be for their cattle and all their beasts."],["4",[["καὶ",707031,7],["τὰ",709436,41],["συγκυροῦντα",712241,237],["τῶν",709436,130],["πόλεων",710612,65],["ἃς",709781,193],["δώσετε",703654,337],["τοῖς",709436,147],["Λευίταις",708160,148],["ἀπὸ",701425,0],["τείχους",712759,21],["τῆς",709436,16],["πόλεως",710612,17],["καὶ",707031,7],["ἔξω",704983,28],["δισχιλίους",703747,60],["πήχεις",710462,57],["κύκλῳ",707959,114]],"And the suburbs of the cities which ye shall give to the Levites, shall be from the wall of the city and outwards two thousand cubits round about."],["5",[["καὶ",707031,7],["μετρήσεις",708840,166],["ἔξω",704983,0],["τῆς",709436,16],["πόλεως",710612,17],["τὸ",709436,24],["κλίτος",707740,25],["τὸ",709436,24],["πρὸς",710844,0],["ἀνατολὰς",701071,39],["δισχιλίους",703747,60],["πήχεις",710462,57],["καὶ",707031,7],["τὸ",709436,24],["κλίτος",707740,25],["τὸ",709436,24],["πρὸς",710844,0],["λίβα",708224,6],["δισχιλίους",703747,60],["πήχεις",710462,57],["καὶ",707031,7],["τὸ",709436,24],["κλίτος",707740,25],["τὸ",709436,24],["πρὸς",710844,0],["θάλασσαν",706069,9],["δισχιλίους",703747,60],["πήχεις",710462,57],["καὶ",707031,7],["τὸ",709436,24],["κλίτος",707740,25],["τὸ",709436,24],["πρὸς",710844,0],["βορρᾶν",702765,6],["δισχιλίους",703747,60],["πήχεις",710462,57],["καὶ",707031,7],["ἡ",709436,10],["πόλις",710612,12],["μέσον",708768,27],["τούτου",709858,49],["ἔσται",704093,93],["ὑμῖν",713084,90],["καὶ",707031,7],["τὰ",709436,41],["ὅμορα",709642,68],["τῶν",709436,130],["πόλεων",710612,65]],"And thou shalt measure outside the city on the east side two thousand cubits, and on the south side two thousand cubits, and on the west side two thousand cubits, and on the north side two thousand cubits; and your city shall be in the midst of this, and the suburbs of the cities [as described]."],["6",[["καὶ",707031,7],["τὰς",709436,38],["πόλεις",710612,39],["δώσετε",703654,337],["τοῖς",709436,147],["Λευίταις",708160,148],["τὰς",709436,38],["ἓξ",704828,59],["πόλεις",710612,39],["τῶν",709436,43],["φυγαδευτηρίων",713605,44],["ἃς",709781,193],["δώσετε",703654,337],["φεύγειν",713433,55],["ἐκεῖ",704181,28],["τῷ",709436,113],["φονεύσαντι",713546,350],["καὶ",707031,7],["πρὸς",710844,0],["ταύταις",709858,200],["τεσσαράκοντα",712806,59],["καὶ",707031,7],["δύο",703849,59],["πόλεις",710612,39]],"And ye shall give the cities to the Levites, the six cities of refuge which ye shall give for the slayer to flee thither, and in addition to these, forty-two cities."],["7",[["πάσας",710177,119],["τὰς",709436,38],["πόλεις",710612,39],["δώσετε",703654,337],["τοῖς",709436,147],["Λευίταις",708160,148],["τεσσαράκοντα",712806,59],["καὶ",707031,7],["ὀκτὼ",709555,59],["πόλεις",710612,39],["ταύτας",709858,231],["καὶ",707031,7],["τὰ",709436,41],["προάστεια",710762,42],["αὐτῶν",702165,40]],"Ye shall give to the Levites in all forty-eight cities, them and their suburbs."],["8",[["καὶ",707031,7],["τὰς",709436,38],["πόλεις",710612,39],["ἃς",709781,193],["δώσετε",703654,337],["ἀπὸ",701425,0],["τῆς",709436,16],["κατασχέσεως",707451,17],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ἀπὸ",701425,0],["τῶν",709436,80],["τὰ",709436,41],["πολλὰ",710646,68],["πολλὰ",710646,68],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,80],["ἐλαττόνων",704388,169],["ἐλάττω",704388,27],["ἕκαστος",704133,14],["κατὰ",707200,0],["τὴν",709436,8],["κληρονομίαν",707725,9],["αὐτοῦ",702165,102],["ἣν",709781,131],["κληρονομήσουσιν",707724,218],["δώσουσιν",703654,218],["ἀπὸ",701425,0],["τῶν",709436,130],["πόλεων",710612,65],["τοῖς",709436,147],["Λευίταις",708160,148]],"And as for the cities which ye shall give out of the possession of the children of Israel, from those [that have] much [ye shall give] much, and from those that have less ye shall give less: they shall give of their cities to the Levites each one according to his inheritance which they shall inherit."],["9",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["10",[["λάλησον",708071,176],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐρεῖς",705415,166],["πρὸς",710844,0],["αὐτούς",702165,62],["ὑμεῖς",713081,219],["διαβαίνετε",703419,87],["τὸν",709436,5],["Ιορδάνην",706763,6],["εἰς",704105,0],["γῆν",703083,9],["Χανααν",713708,118]],"Speak to the children of Israel, and thou shalt say to them, Ye are to cross over Jordan into the land of Chanaan."],["11",[["καὶ",707031,7],["διαστελεῖτε",703588,337],["ὑμῖν",713084,90],["αὐτοῖς",702165,151],["πόλεις",710612,39],["φυγαδευτήρια",713605,64],["ἔσται",704093,93],["ὑμῖν",713084,90],["φυγεῖν",713433,106],["ἐκεῖ",704181,28],["τὸν",709436,5],["φονευτήν",713545,6],["πᾶς",710177,14],["ὁ",709436,3],["πατάξας",710185,182],["ψυχὴν",714070,9],["ἀκουσίως",700583,28]],"And ye shall appoint to yourselves cities: they shall be to you cities of refuge for the slayer to flee to, every one who has killed another unintentionally."],["12",[["καὶ",707031,7],["ἔσονται",704093,135],["αἱ",709436,190],["πόλεις",710612,191],["ὑμῖν",713084,90],["φυγαδευτήρια",713605,64],["ἀπὸ",701425,0],["ἀγχιστεύοντος",700205,152],["τὸ",709436,24],["αἷμα",700442,25],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἀποθάνῃ",701461,172],["ὁ",709436,3],["φονεύων",713546,72],["ἕως",705792,7],["ἂν",700900,11],["στῇ",706846,172],["ἔναντι",704653,0],["τῆς",709436,16],["συναγωγῆς",712376,17],["εἰς",704105,0],["κρίσιν",707908,9]],"And the cities shall be to you places of refuge from the avenger of blood, and the slayer shall not die until he stands before the congregation for judgment."],["13",[["καὶ",707031,7],["αἱ",709436,190],["πόλεις",710612,191],["ἃς",709781,193],["δώσετε",703654,337],["τὰς",709436,38],["ἓξ",704828,59],["πόλεις",710612,39],["φυγαδευτήρια",713605,64],["ἔσονται",704093,135],["ὑμῖν",713084,90]],"And the cities which ye shall assign, [even] the six cities, shall be places of refuge for you."],["14",[["τὰς",709436,38],["τρεῖς",712927,119],["πόλεις",710612,39],["δώσετε",703654,337],["ἐν",704639,0],["τῷ",709436,113],["πέραν",710280,28],["τοῦ",709436,35],["Ιορδάνου",706763,18],["καὶ",707031,7],["τὰς",709436,38],["τρεῖς",712927,119],["πόλεις",710612,39],["δώσετε",703654,337],["ἐν",704639,0],["γῇ",703083,1],["Χανααν",713708,118]],"Ye shall assign three cities on the other side of Jordan, and ye shall assign three cities in the land of Chanaan."],["15",[["φυγάδιον",713607,15],["ἔσται",704093,93],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["καὶ",707031,7],["τῷ",709436,113],["προσηλύτῳ",710900,114],["καὶ",707031,7],["τῷ",709436,113],["παροίκῳ",710159,30],["τῷ",709436,113],["ἐν",704639,0],["ὑμῖν",713084,90],["ἔσονται",704093,135],["αἱ",709436,190],["πόλεις",710612,191],["αὗται",709858,202],["εἰς",704105,0],["φυγαδευτήριον",713605,25],["φυγεῖν",713433,106],["ἐκεῖ",704181,28],["παντὶ",710177,30],["πατάξαντι",710185,350],["ψυχὴν",714070,9],["ἀκουσίως",700583,28]],"It shall be a place of refuge for the children of Israel, and for the stranger, and for him that sojourns among you; these cities shall be for a place of refuge, for every one to flee thither who has killed a man unintentionally."],["16",[["ἐὰν",703912,7],["δὲ",703303,11],["ἐν",704639,0],["σκεύει",711844,54],["σιδήρου",711774,18],["πατάξῃ",710185,172],["αὐτόν",702165,85],["καὶ",707031,7],["τελευτήσῃ",712781,172],["φονευτής",713545,4],["ἐστιν",704093,91],["θανάτῳ",706096,114],["θανατούσθω",706097,407],["ὁ",709436,3],["φονευτής",713545,4]],"And if he should smite him with an iron instrument, and the man should die, he is a murderer; let the murderer by all means be put to death."],["17",[["ἐὰν",703912,7],["δὲ",703303,11],["ἐν",704639,0],["λίθῳ",708196,114],["ἐκ",704132,0],["χειρός",713787,17],["ἐν",704639,0],["ᾧ",709781,309],["ἀποθανεῖται",701461,93],["ἐν",704639,0],["αὐτῷ",702165,50],["πατάξῃ",710185,172],["αὐτόν",702165,85],["καὶ",707031,7],["ἀποθάνῃ",701461,172],["φονευτής",713545,4],["ἐστιν",704093,91],["θανάτῳ",706096,114],["θανατούσθω",706097,407],["ὁ",709436,3],["φονευτής",713545,4]],"And if he should smite him with a stone [thrown] from his hand, whereby a man may die, and he [thus] die, he is a murderer; let the murderer by all means be put to death."],["18",[["ἐὰν",703912,7],["δὲ",703303,11],["ἐν",704639,0],["σκεύει",711844,54],["ξυλίνῳ",709425,97],["ἐκ",704132,0],["χειρός",713787,17],["ἐξ",704132,0],["οὗ",709781,48],["ἀποθανεῖται",701461,93],["ἐν",704639,0],["αὐτῷ",702165,50],["πατάξῃ",710185,172],["αὐτόν",702165,85],["καὶ",707031,7],["ἀποθάνῃ",701461,172],["φονευτής",713545,4],["ἐστιν",704093,91],["θανάτῳ",706096,114],["θανατούσθω",706097,407],["ὁ",709436,3],["φονευτής",713545,4]],"And if he should smite him with an instrument of wood from his hand, whereby he may die, and he [thus] die, he is a murderer; let the murderer by all means be put to death."],["19",[["ὁ",709436,3],["ἀγχιστεύων",700205,72],["τὸ",709436,24],["αἷμα",700442,25],["οὗτος",709858,121],["ἀποκτενεῖ",701498,127],["τὸν",709436,5],["φονεύσαντα",713546,365],["ὅταν",709801,28],["συναντήσῃ",712394,172],["αὐτῷ",702165,50],["οὗτος",709858,121],["ἀποκτενεῖ",701498,127],["αὐτόν",702165,85]],"The avenger of blood himself shall slay the murderer: whensoever he shall meet him he shall slay him."],["20",[["ἐὰν",703912,7],["δὲ",703303,11],["δι᾿",703417,0],["ἔχθραν",705775,9],["ὤσῃ",714100,172],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐπιρρίψῃ",705238,172],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["πᾶν",710177,46],["σκεῦος",711844,25],["ἐξ",704132,0],["ἐνέδρου",704704,21],["καὶ",707031,7],["ἀποθάνῃ",701461,172]],"And if he should thrust him through enmity, or cast any thing upon him from an ambuscade, and the man should die,"],["21",[["ἢ",705924,7],["διὰ",703417,0],["μῆνιν",708878,9],["ἐπάταξεν",710185,2],["αὐτὸν",702165,85],["τῇ",709436,100],["χειρί",713787,1],["καὶ",707031,7],["ἀποθάνῃ",701461,172],["θανάτῳ",706096,114],["θανατούσθω",706097,407],["ὁ",709436,3],["πατάξας",710185,182],["φονευτής",713545,4],["ἐστιν",704093,91],["θανάτῳ",706096,114],["θανατούσθω",706097,407],["ὁ",709436,3],["φονεύων",713546,72],["ὁ",709436,3],["ἀγχιστεύων",700205,72],["τὸ",709436,24],["αἷμα",700442,25],["ἀποκτενεῖ",701498,127],["τὸν",709436,5],["φονεύσαντα",713546,365],["ἐν",704639,0],["τῷ",709436,113],["συναντῆσαι",712394,106],["αὐτῷ",702165,50]],"or if he have smitten him with his hand through anger, and the man should die, let the man that smote him be put to death by all means, he is a murderer: let the murderer by all means be put to death: the avenger of blood shall slay the murderer when he meets him."],["22",[["ἐὰν",703912,7],["δὲ",703303,11],["ἐξάπινα",704868,28],["οὐ",709805,28],["δι᾿",703417,0],["ἔχθραν",705775,9],["ὤσῃ",714100,172],["αὐτὸν",702165,85],["ἢ",705924,7],["ἐπιρρίψῃ",705238,172],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["πᾶν",710177,46],["σκεῦος",711844,25],["οὐκ",709805,28],["ἐξ",704132,0],["ἐνέδρου",704704,21]],"But if he should thrust him suddenly, not through enmity, or cast any thing upon him, not from an ambuscade,"],["23",[["ἢ",705924,7],["παντὶ",710177,30],["λίθῳ",708196,114],["ἐν",704639,0],["ᾧ",709781,309],["ἀποθανεῖται",701461,93],["ἐν",704639,0],["αὐτῷ",702165,50],["οὐκ",709805,28],["εἰδώς",709492,270],["καὶ",707031,7],["ἐπιπέσῃ",705225,172],["ἐπ᾿",705080,0],["αὐτόν",702165,85],["καὶ",707031,7],["ἀποθάνῃ",701461,172],["αὐτὸς",702165,121],["δὲ",703303,11],["οὐκ",709805,28],["ἐχθρὸς",705779,4],["αὐτοῦ",702165,102],["ἦν",704093,13],["οὐδὲ",709816,7],["ζητῶν",705879,72],["κακοποιῆσαι",707062,106],["αὐτόν",702165,85]],"or [smite him] with any stone, whereby a man may die, unawares, and it should fall upon him, and he should die, but he was not his enemy, nor sought to hurt him;"],["24",[["καὶ",707031,7],["κρινεῖ",707905,127],["ἡ",709436,10],["συναγωγὴ",712376,12],["ἀνὰ",700902,0],["μέσον",708768,27],["τοῦ",709436,35],["πατάξαντος",710185,500],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,27],["τοῦ",709436,35],["ἀγχιστεύοντος",700205,152],["τὸ",709436,24],["αἷμα",700442,25],["κατὰ",707200,0],["τὰ",709436,41],["κρίματα",707903,42],["ταῦτα",709858,71]],"then the assembly shall judge between the smiter and the avenger of blood, according to these judgments."],["25",[["καὶ",707031,7],["ἐξελεῖται",704838,93],["ἡ",709436,10],["συναγωγὴ",712376,12],["τὸν",709436,5],["φονεύσαντα",713546,365],["ἀπὸ",701425,0],["τοῦ",709436,35],["ἀγχιστεύοντος",700205,152],["τὸ",709436,24],["αἷμα",700442,25],["καὶ",707031,7],["ἀποκαταστήσουσιν",701470,218],["α