[["1",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["Μαριαμ",708506,12],["καὶ",707031,7],["Ααρων",700005,4],["κατὰ",707200,0],["Μωυσῆ",709112,18],["ἕνεκεν",704709,0],["τῆς",709436,16],["γυναικὸς",703209,17],["τῆς",709436,16],["Αἰθιοπίσσης",700420,9],["ἣν",709781,131],["ἔλαβεν",708076,2],["Μωυσῆς",709112,4],["ὅτι",709803,7],["γυναῖκα",703209,9],["Αἰθιόπισσαν",700420,9],["ἔλαβεν",708076,2]],"And Mariam and Aaron spoke against Moses, because of the Ethiopian woman whom Moses took; for he had taken an Ethiopian woman."],["2",[["καὶ",707031,7],["εἶπαν",705373,150],["μὴ",708851,28],["Μωυσῇ",709112,114],["μόνῳ",709003,30],["λελάληκεν",708071,171],["κύριος",707996,4],["οὐχὶ",709862,28],["καὶ",707031,28],["ἡμῖν",705994,90],["ἐλάλησεν",708071,2],["καὶ",707031,7],["ἤκουσεν",700587,2],["κύριος",707996,4]],"And they said, Has the Lord spoken to Moses only? has he not also spoken to us? and the Lord heard it."],["3",[["καὶ",707031,7],["ὁ",709436,3],["ἄνθρωπος",701163,4],["Μωυσῆς",709112,4],["πραῢς",710725,14],["σφόδρα",712586,28],["παρὰ",709995,0],["πάντας",710177,60],["τοὺς",709436,58],["ἀνθρώπους",701163,57],["τοὺς",709436,58],["ὄντας",704093,235],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"And the man Moses was very meek beyond all the men that were upon the earth."],["4",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["παραχρῆμα",710119,25],["πρὸς",710844,0],["Μωυσῆν",709112,6],["καὶ",707031,7],["Μαριαμ",708506,9],["καὶ",707031,7],["Ααρων",700005,6],["ἐξέλθατε",704909,74],["ὑμεῖς",713081,219],["οἱ",709436,136],["τρεῖς",712927,138],["εἰς",704105,0],["τὴν",709436,8],["σκηνὴν",711845,9],["τοῦ",709436,20],["μαρτυρίου",708525,21],["καὶ",707031,7],["ἐξῆλθον",704909,150],["οἱ",709436,136],["τρεῖς",712927,138],["εἰς",704105,0],["τὴν",709436,8],["σκηνὴν",711845,9],["τοῦ",709436,20],["μαρτυρίου",708525,21]],"And the Lord said immediately to Moses and Aaron and Mariam, Come forth all three of you to the tabernacle of witness.",{"s":"d","q":0.6}],["5",[["καὶ",707031,7],["κατέβη",707202,2],["κύριος",707996,4],["ἐν",704639,0],["στύλῳ",712179,114],["νεφέλης",709277,17],["καὶ",707031,7],["ἔστη",706846,2],["ἐπὶ",705080,0],["τῆς",709436,16],["θύρας",706337,17],["τῆς",709436,16],["σκηνῆς",711845,17],["τοῦ",709436,20],["μαρτυρίου",708525,21],["καὶ",707031,7],["ἐκλήθησαν",707084,99],["Ααρων",700005,6],["καὶ",707031,7],["Μαριαμ",708506,9],["καὶ",707031,7],["ἐξήλθοσαν",704909,150],["ἀμφότεροι",700892,138]],"And the three came forth to the tabernacle of witness; and the Lord descended in a pillar of a cloud, and stood at the door of the tabernacle of witness; and Aaron and Mariam were called; and both came forth."],["6",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτούς",702165,62],["ἀκούσατε",700587,74],["τῶν",709436,80],["λόγων",708236,81],["μου",709032,133],["ἐὰν",703912,7],["γένηται",703104,239],["προφήτης",711009,4],["ὑμῶν",713091,145],["κυρίῳ",707996,114],["ἐν",704639,0],["ὁράματι",709720,54],["αὐτῷ",702165,50],["γνωσθήσομαι",703105,180],["καὶ",707031,7],["ἐν",704639,0],["ὕπνῳ",713181,114],["λαλήσω",708071,165],["αὐτῷ",702165,50]],"And he said to them, Hear my words: If there should be of you a prophet to the Lord, I will be made known to him in a vision, and in sleep will I speak to him."],["7",[["οὐχ",709805,28],["οὕτως",709859,28],["ὁ",709436,3],["θεράπων",706201,4],["μου",709032,133],["Μωυσῆς",709112,4],["ἐν",704639,0],["ὅλῳ",709597,30],["τῷ",709436,113],["οἴκῳ",709516,114],["μου",709032,133],["πιστός",710486,14],["ἐστιν",704093,91]],"My servant Moses [is] not so; he is faithful in all my house."],["8",[["στόμα",712125,25],["κατὰ",707200,0],["στόμα",712125,25],["λαλήσω",708071,165],["αὐτῷ",702165,50],["ἐν",704639,0],["εἴδει",704074,54],["καὶ",707031,7],["οὐ",709805,28],["δι᾿",703417,0],["αἰνιγμάτων",700460,44],["καὶ",707031,7],["τὴν",709436,8],["δόξαν",703791,9],["κυρίου",707996,18],["εἶδεν",709725,2],["καὶ",707031,7],["διὰ",703417,0],["τί",712867,126],["οὐκ",709805,28],["ἐφοβήθητε",713532,472],["καταλαλῆσαι",707298,106],["κατὰ",707200,0],["τοῦ",709436,35],["θεράποντός",706201,18],["μου",709032,133],["Μωυσῆ",709112,18]],"I will speak to him mouth to mouth apparently, and not in dark speeches; and he has seen the glory of the Lord; and why were ye not afraid to speak against my servant Moses?"],["9",[["καὶ",707031,7],["ὀργὴ",709728,12],["θυμοῦ",706334,18],["κυρίου",707996,18],["ἐπ᾿",705080,0],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἀπῆλθεν",701398,2]],"And the great anger of the Lord [was] upon them, and he departed."],["10",[["καὶ",707031,7],["ἡ",709436,10],["νεφέλη",709277,12],["ἀπέστη",702214,2],["ἀπὸ",701425,0],["τῆς",709436,16],["σκηνῆς",711845,17],["καὶ",707031,7],["ἰδοὺ",706497,88],["Μαριαμ",708506,12],["λεπρῶσα",708150,188],["ὡσεὶ",714159,28],["χιών",713870,12],["καὶ",707031,7],["ἐπέβλεψεν",705088,2],["Ααρων",700005,4],["ἐπὶ",705080,0],["Μαριαμ",708506,9],["καὶ",707031,7],["ἰδοὺ",706497,88],["λεπρῶσα",708150,188]],"And the cloud departed from the tabernacle; and, behold, Mariam was leprous, [white] as snow; and Aaron looked upon Mariam, and, behold, she [was] leprous."],["11",[["καὶ",707031,7],["εἶπεν",705373,2],["Ααρων",700005,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["δέομαι",703361,254],["κύριε",707996,153],["μὴ",708851,28],["συνεπιθῇ",712453,420],["ἡμῖν",705994,90],["ἁμαρτίαν",700775,9],["διότι",703734,7],["ἠγνοήσαμεν",700175,289],["καθότι",707021,28],["ἡμάρτομεν",700773,289]],"And Aaron said to Moses, I beseech thee, my lord, do not lay sin upon us, for we were ignorant wherein we sinned."],["12",[["μὴ",708851,28],["γένηται",703104,239],["ὡσεὶ",714159,28],["ἴσον",706832,27],["θανάτῳ",706096,114],["ὡσεὶ",714159,28],["ἔκτρωμα",704348,15],["ἐκπορευόμενον",704293,208],["ἐκ",704132,0],["μήτρας",708894,17],["μητρὸς",708892,17],["καὶ",707031,7],["κατεσθίει",707519,91],["τὸ",709436,24],["ἥμισυ",705998,46],["τῶν",709436,130],["σαρκῶν",711537,65],["αὐτῆς",702165,86]],"Let her not be as it were like death, as an abortion coming out of his mother's womb, when [the disease] devours the half of the flesh."],["13",[["καὶ",707031,7],["ἐβόησεν",702743,2],["Μωυσῆς",709112,4],["πρὸς",710844,0],["κύριον",707996,6],["λέγων",708124,72],["ὁ",709436,3],["θεός",706192,4],["δέομαί",703361,254],["σου",711945,133],["ἴασαι",706424,300],["αὐτήν",702165,104]],"And Moses cried to the Lord, saying, O God, I beseech thee, heal her."],["14",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["εἰ",704071,7],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτῆς",702165,86],["πτύων",711070,72],["ἐνέπτυσεν",704621,2],["εἰς",704105,0],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτῆς",702165,86],["οὐκ",709805,28],["ἐντραπήσεται",704805,134],["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["ἀφορισθήτω",702227,22],["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["ἔξω",704983,0],["τῆς",709436,16],["παρεμβολῆς",710133,17],["καὶ",707031,7],["μετὰ",708780,0],["ταῦτα",709858,71],["εἰσελεύσεται",704114,93]],"And the Lord said to Moses, If her father had only spit in her face, would she not be ashamed seven days? let her be set apart seven days without the camp, and afterwards she shall come in."],["15",[["καὶ",707031,7],["ἀφωρίσθη",702227,37],["Μαριαμ",708506,12],["ἔξω",704983,0],["τῆς",709436,16],["παρεμβολῆς",710133,17],["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["καὶ",707031,7],["ὁ",709436,3],["λαὸς",708094,4],["οὐκ",709805,28],["ἐξῆρεν",704839,2],["ἕως",705792,7],["ἐκαθαρίσθη",706985,37],["Μαριαμ",708506,12]],"And Mariam was separated without the camp seven days; and the people moved not forward till Mariam was cleansed."],["16",[["καὶ",707031,7],["μετὰ",708780,0],["ταῦτα",709858,71],["ἐξῆρεν",704839,2],["ὁ",709436,3],["λαὸς",708094,4],["ἐξ",704132,0],["Ασηρωθ",701935,118],["καὶ",707031,7],["παρενέβαλον",710132,150],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["τοῦ",709436,35],["Φαραν",713358,18]],"And afterwards the people set forth from Aseroth, and encamped in the wilderness of Pharan."]]