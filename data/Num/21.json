[["1",[["καὶ",707031,7],["ἤκουσεν",700587,2],["ὁ",709436,3],["Χανανις",713713,4],["βασιλεὺς",702580,4],["Αραδ",701677,118],["ὁ",709436,3],["κατοικῶν",707534,72],["κατὰ",707200,0],["τὴν",709436,8],["ἔρημον",705420,9],["ἦλθεν",705453,2],["γὰρ",702963,11],["Ισραηλ",706839,4],["ὁδὸν",709458,9],["Αθαριν",700361,118],["καὶ",707031,7],["ἐπολέμησεν",710601,2],["πρὸς",710844,0],["Ισραηλ",706839,6],["καὶ",707031,7],["κατεπρονόμευσαν",707391,150],["ἐξ",704132,0],["αὐτῶν",702165,40],["αἰχμαλωσίαν",700499,9]],"And Arad the Chananitish king who dwelt by the wilderness, heard that Israel came by the way of Atharin; and he made war on Israel, and carried off some of them captives."],["2",[["καὶ",707031,7],["ηὔξατο",705727,23],["Ισραηλ",706839,4],["εὐχὴν",705726,9],["κυρίῳ",707996,114],["καὶ",707031,7],["εἶπεν",705373,2],["ἐάν",703912,7],["μοι",708974,159],["παραδῷς",710014,175],["τὸν",709436,5],["λαὸν",708094,6],["τοῦτον",709858,85],["ὑποχείριον",713258,27],["ἀναθεματιῶ",700951,165],["αὐτὸν",702165,85],["καὶ",707031,7],["τὰς",709436,38],["πόλεις",710612,39],["αὐτοῦ",702165,102]],"And Israel vowed a vow to the Lord, and said, If thou wilt deliver this people into my power, I will devote it and its cities [to thee]."],["3",[["καὶ",707031,7],["εἰσήκουσεν",704108,2],["κύριος",707996,4],["τῆς",709436,16],["φωνῆς",713640,17],["Ισραηλ",706839,18],["καὶ",707031,7],["παρέδωκεν",710014,2],["τὸν",709436,5],["Χανανιν",713713,6],["ὑποχείριον",713258,27],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀνεθεμάτισεν",700951,2],["αὐτὸν",702165,85],["καὶ",707031,7],["τὰς",709436,38],["πόλεις",710612,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπεκάλεσαν",705153,150],["τὸ",709436,24],["ὄνομα",709666,25],["τοῦ",709436,35],["τόπου",712903,18],["ἐκείνου",704183,102],["ἀνάθεμα",700950,25]],"And the Lord hearkened to the voice of Israel, and delivered the Chananite into his power; and [Israel] devoted him and his cities, and they called the name of that place Anathema."],["4",[["καὶ",707031,7],["ἀπάραντες",701329,196],["ἐξ",704132,0],["Ωρ",714127,118],["τοῦ",709436,20],["ὄρους",709768,21],["ὁδὸν",709458,9],["ἐπὶ",705080,0],["θάλασσαν",706069,9],["ἐρυθρὰν",705447,36],["περιεκύκλωσαν",710339,150],["γῆν",703083,9],["Εδωμ",704041,118],["καὶ",707031,7],["ὠλιγοψύχησεν",709575,2],["ὁ",709436,3],["λαὸς",708094,4],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1]],"And having departed from mount Or by the way [leading] to the Red Sea, they compassed the land of Edom, and the people lost courage by the way."],["5",[["καὶ",707031,7],["κατελάλει",707298,13],["ὁ",709436,3],["λαὸς",708094,4],["πρὸς",710844,0],["τὸν",709436,5],["θεὸν",706192,6],["καὶ",707031,7],["κατὰ",707200,0],["Μωυσῆ",709112,18],["λέγοντες",708124,146],["ἵνα",706747,7],["τί",712867,273],["ἐξήγαγες",704834,162],["ἡμᾶς",705981,194],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["ἀποκτεῖναι",701498,106],["ἡμᾶς",705981,194],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἄρτος",701829,4],["οὐδὲ",709816,7],["ὕδωρ",713071,15],["ἡ",709436,10],["δὲ",703303,11],["ψυχὴ",714070,12],["ἡμῶν",705999,145],["προσώχθισεν",710945,2],["ἐν",704639,0],["τῷ",709436,113],["ἄρτῳ",701829,114],["τῷ",709436,113],["διακένῳ",703470,114]],"And the people spoke against God and against Moses, saying, Why is this? Hast thou brought us ought of Egypt to slay us in the wilderness? for there is not bread nor water; and our soul loathes this light bread."],["6",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["κύριος",707996,4],["εἰς",704105,0],["τὸν",709436,5],["λαὸν",708094,6],["τοὺς",709436,58],["ὄφεις",709875,57],["τοὺς",709436,58],["θανατοῦντας",706097,235],["καὶ",707031,7],["ἔδακνον",703254,137],["τὸν",709436,5],["λαόν",708094,6],["καὶ",707031,7],["ἀπέθανεν",701461,2],["λαὸς",708094,4],["πολὺς",710646,14],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18]],"And the Lord sent among the people deadly serpents, and they bit the people, and much people of the children of Israel died."],["7",[["καὶ",707031,7],["παραγενόμενος",710006,248],["ὁ",709436,3],["λαὸς",708094,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["ἔλεγον",708124,137],["ὅτι",709803,7],["ἡμάρτομεν",700773,289],["ὅτι",709803,7],["κατελαλήσαμεν",707298,289],["κατὰ",707200,0],["τοῦ",709436,35],["κυρίου",707996,18],["καὶ",707031,7],["κατὰ",707200,0],["σοῦ",711945,133],["εὖξαι",705727,106],["οὖν",709835,11],["πρὸς",710844,0],["κύριον",707996,6],["καὶ",707031,7],["ἀφελέτω",702177,45],["ἀφ᾿",701425,0],["ἡμῶν",705999,145],["τὸν",709436,5],["ὄφιν",709875,6],["καὶ",707031,7],["ηὔξατο",705727,23],["Μωυσῆς",709112,4],["πρὸς",710844,0],["κύριον",707996,6],["περὶ",710285,0],["τοῦ",709436,35],["λαοῦ",708094,18]],"And the people came to Moses and said, We have sinned, for we have spoken against the Lord, and against thee: pray therefore to the Lord, and let him take away the serpent from us."],["8",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["ποίησον",710582,176],["σεαυτῷ",711599,50],["ὄφιν",709875,6],["καὶ",707031,7],["θὲς",712849,176],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["σημείου",711748,21],["καὶ",707031,7],["ἔσται",704093,93],["ἐὰν",703912,7],["δάκῃ",703254,172],["ὄφις",709875,4],["ἄνθρωπον",701163,6],["πᾶς",710177,14],["ὁ",709436,3],["δεδηγμένος",703254,419],["ἰδὼν",709725,182],["αὐτὸν",702165,85],["ζήσεται",705851,93]],"And Moses prayed to the Lord for the people; and the Lord said to Moses, Make thee a serpent, and put it on a signal-[staff]; and it shall come to pass that whenever a serpent shall bite a man, every one [so] bitten that looks upon it shall live."],["9",[["καὶ",707031,7],["ἐποίησεν",710582,2],["Μωυσῆς",709112,4],["ὄφιν",709875,6],["χαλκοῦν",713690,27],["καὶ",707031,7],["ἔστησεν",706846,2],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["σημείου",711748,21],["καὶ",707031,7],["ἐγένετο",703104,23],["ὅταν",709801,28],["ἔδακνεν",703254,13],["ὄφις",709875,4],["ἄνθρωπον",701163,6],["καὶ",707031,7],["ἐπέβλεψεν",705088,2],["ἐπὶ",705080,0],["τὸν",709436,5],["ὄφιν",709875,6],["τὸν",709436,5],["χαλκοῦν",713690,27],["καὶ",707031,7],["ἔζη",705851,13]],"And Moses made a serpent of brass, and put it upon a signal-[staff]: and it came to pass that whenever a serpent bit a man, and he looked on the brazen serpent, he lived."],["10",[["καὶ",707031,7],["ἀπῆραν",701329,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["καὶ",707031,7],["παρενέβαλον",710132,150],["ἐν",704639,0],["Ωβωθ",714087,111]],"And the children of Israel departed, and encamped in Oboth."],["11",[["καὶ",707031,7],["ἐξάραντες",704839,196],["ἐξ",704132,0],["Ωβωθ",714087,118],["παρενέβαλον",710132,150],["ἐν",704639,0],["Αχελγαι",702257,111],["ἐκ",704132,0],["τοῦ",709436,35],["πέραν",710280,28],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["ἥ",709781,177],["ἐστιν",704093,91],["κατὰ",707200,0],["πρόσωπον",710986,25],["Μωαβ",709085,18],["κατὰ",707200,0],["ἀνατολὰς",701071,39],["ἡλίου",705974,18]],"And having departed from Oboth, they encamped in Achalgai, on the farther side in the wilderness, which is opposite Moab, toward the east."],["12",[["ἐκεῖθεν",704182,28],["ἀπῆραν",701329,150],["καὶ",707031,7],["παρενέβαλον",710132,150],["εἰς",704105,0],["φάραγγα",713351,9],["Ζαρετ",705842,118]],"And thence they departed, and encamped in the valley of Zared."],["13",[["καὶ",707031,7],["ἐκεῖθεν",704182,28],["ἀπάραντες",701329,196],["παρενέβαλον",710132,150],["εἰς",704105,0],["τὸ",709436,24],["πέραν",710280,28],["Αρνων",701783,18],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["τὸ",709436,24],["ἐξέχον",704917,47],["ἀπὸ",701425,0],["τῶν",709436,43],["ὁρίων",709749,44],["τῶν",709436,80],["Αμορραίων",700865,81],["ἔστιν",704093,91],["γὰρ",702963,11],["Αρνων",701783,120],["ὅρια",709749,64],["Μωαβ",709085,18],["ἀνὰ",700902,0],["μέσον",708768,27],["Μωαβ",709085,18],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,27],["τοῦ",709436,35],["Αμορραίου",700865,18]],"And they departed thence and encamped on the other side of Arnon in the wilderness, [the country] which extends from the coasts of the Amorites; for Arnon is the borders of Moab, between Moab and the Amorites."],["14",[["διὰ",703417,0],["τοῦτο",709858,129],["λέγεται",708124,117],["ἐν",704639,0],["βιβλίῳ",702719,54],["πόλεμος",710605,4],["τοῦ",709436,35],["κυρίου",707996,18],["τὴν",709436,8],["Ζωοβ",705914,9],["ἐφλόγισεν",713521,2],["καὶ",707031,7],["τοὺς",709436,58],["χειμάρρους",713783,57],["Αρνων",701783,184]],"Therefore it is said in a book, A war of the Lord has set on fire Zoob, and the brooks of Arnon."],["15",[["καὶ",707031,7],["τοὺς",709436,58],["χειμάρρους",713783,57],["κατέστησεν",707011,2],["κατοικίσαι",707538,106],["Ηρ",706016,111],["καὶ",707031,7],["πρόσκειται",710916,117],["τοῖς",709436,95],["ὁρίοις",709749,96],["Μωαβ",709085,18]],"And he has appointed brooks to cause Er to dwell [there]; and it lies near to the coasts of Moab."],["16",[["καὶ",707031,7],["ἐκεῖθεν",704182,28],["τὸ",709436,34],["φρέαρ",713576,15],["τοῦτό",709858,132],["ἐστιν",704093,91],["τὸ",709436,34],["φρέαρ",713576,15],["ὃ",709781,128],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["συνάγαγε",712375,176],["τὸν",709436,5],["λαόν",708094,6],["καὶ",707031,7],["δώσω",703654,165],["αὐτοῖς",702165,151],["ὕδωρ",713071,15],["πιεῖν",710478,106]],"And thence [they came to] the well; this [is] the well of which the Lord said to Moses, Gather the people, and I will give them water to drink."],["17",[["τότε",712908,28],["ᾖσεν",700299,2],["Ισραηλ",706839,4],["τὸ",709436,24],["ᾆσμα",701970,25],["τοῦτο",709858,129],["ἐπὶ",705080,0],["τοῦ",709436,20],["φρέατος",713576,21],["ἐξάρχετε",704883,87],["αὐτῷ",702165,280]],"Then Israel sang this song at the well, Begin [to sing] of the well;"],["18",[["φρέαρ",713576,15],["ὤρυξαν",709775,150],["αὐτὸ",702165,129],["ἄρχοντες",701862,52],["ἐξελατόμησαν",704235,150],["αὐτὸ",702165,129],["βασιλεῖς",702580,52],["ἐθνῶν",704068,44],["ἐν",704639,0],["τῇ",709436,100],["βασιλείᾳ",702577,1],["αὐτῶν",702165,40],["ἐν",704639,0],["τῷ",709436,53],["κυριεῦσαι",707995,106],["αὐτῶν",702165,40],["καὶ",707031,7],["ἀπὸ",701425,0],["φρέατος",713576,21],["εἰς",704105,0],["Μανθαναιν",708478,354]],"the princes digged it, the kings of the nations in their kingdom, in their lordship sank it in the rock: and [they went] from the well to Manthanain,"],["19",[["καὶ",707031,7],["ἀπὸ",701425,0],["Μανθαναιν",708478,228],["εἰς",704105,0],["Νααλιηλ",709119,227],["καὶ",707031,7],["ἀπὸ",701425,0],["Νααλιηλ",709119,118],["εἰς",704105,0],["Βαμωθ",702498,227]],"and from Manthanain to Naaliel, and from Naaliel to Bamoth, and from Bamoth to Janen, which is in the plain of Moab [as seen] from the top of the quarried [rock] that looks toward the wilderness."],["20",[["καὶ",707031,7],["ἀπὸ",701425,0],["Βαμωθ",702498,118],["εἰς",704105,0],["νάπην",709193,9],["ἥ",709781,177],["ἐστιν",704093,91],["ἐν",704639,0],["τῷ",709436,53],["πεδίῳ",710215,54],["Μωαβ",709085,18],["ἀπὸ",701425,0],["κορυφῆς",707844,17],["τοῦ",709436,20],["λελαξευμένου",708092,441],["τὸ",709436,24],["βλέπον",702740,47],["κατὰ",707200,0],["πρόσωπον",710986,25],["τῆς",709436,16],["ἐρήμου",705420,17]],"And Moses sent ambassadors to Seon king of the Amorites, with peaceable words, saying,"],["21",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Μωυσῆς",709112,4],["πρέσβεις",710733,57],["πρὸς",710844,0],["Σηων",711759,6],["βασιλέα",702580,6],["Αμορραίων",700865,81],["λόγοις",708236,148],["εἰρηνικοῖς",704099,230],["λέγων",708124,72]],"We will pass through thy land, we will go by the road; we will not turn aside to the field or to the vineyard."],["22",[["παρελευσόμεθα",710141,141],["διὰ",703417,0],["τῆς",709436,16],["γῆς",703083,17],["σου",711945,133],["τῇ",709436,100],["ὁδῷ",709458,1],["πορευσόμεθα",710667,141],["οὐκ",709805,28],["ἐκκλινοῦμεν",704220,275],["οὔτε",709857,7],["εἰς",704105,0],["ἀγρὸν",700196,6],["οὔτε",709857,7],["εἰς",704105,0],["ἀμπελῶνα",700872,6],["οὐ",709805,28],["πιόμεθα",710478,141],["ὕδωρ",713071,15],["ἐκ",704132,0],["φρέατός",713576,21],["σου",711945,133],["ὁδῷ",709458,1],["βασιλικῇ",702582,101],["πορευσόμεθα",710667,141],["ἕως",705792,7],["παρέλθωμεν",710141,79],["τὰ",709436,41],["ὅριά",709749,42],["σου",711945,133]],"We will not drink water out of thy well; we will go by the king's highway, until we have past thy boundaries."],["23",[["καὶ",707031,7],["οὐκ",709805,28],["ἔδωκεν",703654,2],["Σηων",711759,4],["τῷ",709436,113],["Ισραηλ",706839,114],["παρελθεῖν",710141,106],["διὰ",703417,0],["τῶν",709436,43],["ὁρίων",709749,44],["αὐτοῦ",702165,102],["καὶ",707031,7],["συνήγαγεν",712375,2],["Σηων",711759,4],["πάντα",710177,27],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐξῆλθεν",704909,2],["παρατάξασθαι",710108,109],["τῷ",709436,113],["Ισραηλ",706839,114],["εἰς",704105,0],["τὴν",709436,8],["ἔρημον",705420,9],["καὶ",707031,7],["ἦλθεν",705453,2],["εἰς",704105,0],["Ιασσα",706452,227],["καὶ",707031,7],["παρετάξατο",710108,23],["τῷ",709436,113],["Ισραηλ",706839,114]],"And Seon did not allow Israel to pass through his borders, and Seon gathered all his people, and went out to set the battle in array against Israel into the wilderness; and he came to Jassa, and set the battle in array against Israel."],["24",[["καὶ",707031,7],["ἐπάταξεν",710185,2],["αὐτὸν",702165,85],["Ισραηλ",706839,4],["φόνῳ",713549,114],["μαχαίρης",708593,17],["καὶ",707031,7],["κατεκυρίευσαν",707297,150],["τῆς",709436,16],["γῆς",703083,17],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["Αρνων",701783,118],["ἕως",705792,0],["Ιαβοκ",706369,118],["ἕως",705792,0],["υἱῶν",713075,81],["Αμμαν",700833,18],["ὅτι",709803,7],["Ιαζηρ",706382,120],["ὅρια",709749,64],["υἱῶν",713075,81],["Αμμων",700847,18],["ἐστίν",704093,91]],"And Israel smote him with the slaughter of the sword, and they became possessors of his land, from Arnon to Jaboc, as far as the children of Amman, for Jazer is the borders of the children of Amman."],["25",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Ισραηλ",706839,4],["πάσας",710177,119],["τὰς",709436,38],["πόλεις",710612,39],["ταύτας",709858,231],["καὶ",707031,7],["κατῴκησεν",707534,2],["Ισραηλ",706839,4],["ἐν",704639,0],["πάσαις",710177,291],["ταῖς",709436,75],["πόλεσιν",710612,76],["τῶν",709436,80],["Αμορραίων",700865,81],["ἐν",704639,0],["Εσεβων",705473,111],["καὶ",707031,7],["ἐν",704639,0],["πάσαις",710177,291],["ταῖς",709436,75],["συγκυρούσαις",712241,495],["αὐτῇ",702165,105]],"And Israel took all their cities, and Israel dwelt in all the cities of the Amorites, in Esebon, and in all cities belonging to it."],["26",[["ἔστιν",704093,91],["γὰρ",702963,11],["Εσεβων",705473,120],["πόλις",710612,12],["Σηων",711759,18],["τοῦ",709436,35],["βασιλέως",702580,18],["τῶν",709436,80],["Αμορραίων",700865,81],["καὶ",707031,7],["οὗτος",709858,121],["ἐπολέμησεν",710601,2],["βασιλέα",702580,6],["Μωαβ",709085,18],["τὸ",709436,24],["πρότερον",710991,46],["καὶ",707031,7],["ἔλαβον",708076,150],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["Αροηρ",701787,118],["ἕως",705792,0],["Αρνων",701783,118]],"For Esebon is the city of Seon king of the Amorites; and he before fought against the king of Moab, and they took all his land, from Aroer to Arnon."],["27",[["διὰ",703417,0],["τοῦτο",709858,129],["ἐροῦσιν",705415,218],["οἱ",709436,136],["αἰνιγματισταί",700461,52],["ἔλθετε",705453,74],["εἰς",704105,0],["Εσεβων",705473,227],["ἵνα",706747,7],["οἰκοδομηθῇ",709509,384],["καὶ",707031,7],["κατασκευασθῇ",707419,384],["πόλις",710612,12],["Σηων",711759,18]],"Therefore say they who deal in dark speeches, Come to Esebon, that the city of Seon may be built and prepared."],["28",[["ὅτι",709803,7],["πῦρ",711088,25],["ἐξῆλθεν",704909,2],["ἐξ",704132,0],["Εσεβων",705473,118],["φλὸξ",713524,12],["ἐκ",704132,0],["πόλεως",710612,17],["Σηων",711759,18],["καὶ",707031,7],["κατέφαγεν",707519,2],["ἕως",705792,0],["Μωαβ",709085,18],["καὶ",707031,7],["κατέπιεν",707374,2],["στήλας",712092,39],["Αρνων",701783,118]],"For a fire has gone forth from Esebon, a flame from the city of Seon, and has consumed as far as Moab, and devoured the pillars of Arnon."],["29",[["οὐαί",709807,88],["σοι",711925,159],["Μωαβ",709085,153],["ἀπώλου",701513,174],["λαὸς",708094,4],["Χαμως",713707,118],["ἀπεδόθησαν",701449,99],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτῶν",702165,40],["διασῴζεσθαι",703599,110],["καὶ",707031,7],["αἱ",709436,190],["θυγατέρες",706320,191],["αὐτῶν",702165,40],["αἰχμάλωτοι",700503,138],["τῷ",709436,113],["βασιλεῖ",702580,114],["τῶν",709436,80],["Αμορραίων",700865,81],["Σηων",711759,18]],"Woe to thee, Moab; thou art lost, thou people of Chamos: their sons are sold for preservation, and their daughters are captives to Seon king of the Amorites."],["30",[["καὶ",707031,7],["τὸ",709436,34],["σπέρμα",712008,15],["αὐτῶν",702165,40],["ἀπολεῖται",701513,93],["Εσεβων",705473,184],["ἕως",705792,0],["Δαιβων",703247,118],["καὶ",707031,7],["αἱ",709436,190],["γυναῖκες",703209,191],["ἔτι",705538,28],["προσεξέκαυσαν",710882,150],["πῦρ",711088,25],["ἐπὶ",705080,0],["Μωαβ",709085,397]],"And their seed shall perish [from] Esebon to Dæbon; and their women have yet farther kindled a fire against Moab."],["31",[["κατῴκησεν",707534,2],["δὲ",703303,11],["Ισραηλ",706839,4],["ἐν",704639,0],["πάσαις",710177,291],["ταῖς",709436,75],["πόλεσιν",710612,76],["τῶν",709436,80],["Αμορραίων",700865,81]],"And Israel dwelt in all the cities of the Amorites."],["32",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Μωυσῆς",709112,4],["κατασκέψασθαι",707418,109],["τὴν",709436,8],["Ιαζηρ",706382,9],["καὶ",707031,7],["κατελάβοντο",707300,189],["αὐτὴν",702165,104],["καὶ",707031,7],["τὰς",709436,38],["κώμας",708022,39],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐξέβαλον",704145,150],["τὸν",709436,5],["Αμορραῖον",700865,6],["τὸν",709436,5],["κατοικοῦντα",707534,183],["ἐκεῖ",704181,28]],"And Moses sent to spy out Jazer; and they took it, and its villages, and cast out the Amorite that dwelt there."],["33",[["καὶ",707031,7],["ἐπιστρέψαντες",705278,196],["ἀνέβησαν",700905,150],["ὁδὸν",709458,9],["τὴν",709436,