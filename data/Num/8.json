[["1",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["2",[["λάλησον",708071,176],["τῷ",709436,113],["Ααρων",700005,114],["καὶ",707031,7],["ἐρεῖς",705415,166],["πρὸς",710844,0],["αὐτόν",702165,85],["ὅταν",709801,28],["ἐπιτιθῇς",705304,205],["τοὺς",709436,58],["λύχνους",708287,57],["ἐκ",704132,0],["μέρους",708752,21],["κατὰ",707200,0],["πρόσωπον",710986,25],["τῆς",709436,16],["λυχνίας",708286,17],["φωτιοῦσιν",713646,218],["οἱ",709436,136],["ἑπτὰ",705357,59],["λύχνοι",708287,52]],"Speak to Aaron, and thou shalt say to him, Whenever thou shalt set the lamps in order, the seven lamps shall give light opposite the candlestick."],["3",[["καὶ",707031,7],["ἐποίησεν",710582,2],["οὕτως",709859,28],["Ααρων",700005,4],["ἐκ",704132,0],["τοῦ",709436,20],["ἑνὸς",704106,92],["μέρους",708752,21],["κατὰ",707200,0],["πρόσωπον",710986,25],["τῆς",709436,16],["λυχνίας",708286,17],["ἐξῆψεν",704874,2],["τοὺς",709436,58],["λύχνους",708287,57],["αὐτῆς",702165,86],["καθὰ",706979,28],["συνέταξεν",712508,2],["κύριος",707996,4],["τῷ",709436,113],["Μωυσῇ",709112,114]],"And Aaron did so: on one side opposite the candlestick he lighted its lamps, as the Lord appointed Moses."],["4",[["καὶ",707031,7],["αὕτη",709858,107],["ἡ",709436,10],["κατασκευὴ",707421,12],["τῆς",709436,16],["λυχνίας",708286,17],["στερεὰ",712075,29],["χρυσῆ",713971,29],["ὁ",709436,3],["καυλὸς",707563,4],["αὐτῆς",702165,86],["καὶ",707031,7],["τὰ",709436,63],["κρίνα",707904,64],["αὐτῆς",702165,86],["στερεὰ",712075,29],["ὅλη",709597,29],["κατὰ",707200,0],["τὸ",709436,24],["εἶδος",704074,25],["ὃ",709781,33],["ἔδειξεν",703314,2],["κύριος",707996,4],["τῷ",709436,113],["Μωυσῇ",709112,114],["οὕτως",709859,28],["ἐποίησεν",710582,2],["τὴν",709436,8],["λυχνίαν",708286,9]],"And this [is] the construction of the candlestick: [it is] solid, golden—its stem, and its lilies—all solid: according to the pattern which the Lord shewed Moses, so he made the candlestick."],["5",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["6",[["λαβὲ",708076,176],["τοὺς",709436,58],["Λευίτας",708160,57],["ἐκ",704132,0],["μέσου",708768,116],["υἱῶν",713075,81],["Ισραηλ",706839,18],["καὶ",707031,7],["ἀφαγνιεῖς",702173,166],["αὐτούς",702165,62]],"Take the Levites out of the midst of the children of Israel, and thou shalt purify them."],["7",[["καὶ",707031,7],["οὕτως",709859,28],["ποιήσεις",710582,166],["αὐτοῖς",702165,151],["τὸν",709436,5],["ἁγνισμὸν",700174,6],["αὐτῶν",702165,40],["περιρρανεῖς",710374,166],["αὐτοὺς",702165,62],["ὕδωρ",713071,15],["ἁγνισμοῦ",700174,18],["καὶ",707031,7],["ἐπελεύσεται",705068,93],["ξυρὸν",709433,25],["ἐπὶ",705080,0],["πᾶν",710177,46],["τὸ",709436,24],["σῶμα",712635,25],["αὐτῶν",702165,40],["καὶ",707031,7],["πλυνοῦσιν",710564,218],["τὰ",709436,41],["ἱμάτια",706742,42],["αὐτῶν",702165,40],["καὶ",707031,7],["καθαροὶ",706988,138],["ἔσονται",704093,135]],"And thus shalt thou perform their purification: thou shalt sprinkle them with water of purification, and a razor shall come upon the whole of their body, and they shall wash their garments, and shall be clean."],["8",[["καὶ",707031,7],["λήμψονται",708076,135],["μόσχον",709029,6],["ἕνα",704106,27],["ἐκ",704132,0],["βοῶν",702798,81],["καὶ",707031,7],["τούτου",709858,102],["θυσίαν",706345,9],["σεμιδάλεως",711675,17],["ἀναπεποιημένην",701040,436],["ἐν",704639,0],["ἐλαίῳ",704380,54],["καὶ",707031,7],["μόσχον",709029,6],["ἐνιαύσιον",704744,27],["ἐκ",704132,0],["βοῶν",702798,81],["λήμψῃ",708076,123],["περὶ",710285,0],["ἁμαρτίας",700775,17]],"And they shall take one calf of the herd, and its meat-offering, fine flour mingled with oil: and thou shalt take a calf of a year old of the herd for a sin-offering."],["9",[["καὶ",707031,7],["προσάξεις",710848,166],["τοὺς",709436,58],["Λευίτας",708160,57],["ἔναντι",704653,0],["τῆς",709436,16],["σκηνῆς",711845,17],["τοῦ",709436,20],["μαρτυρίου",708525,21],["καὶ",707031,7],["συνάξεις",712375,166],["πᾶσαν",710177,36],["συναγωγὴν",712376,9],["υἱῶν",713075,81],["Ισραηλ",706839,18]],"And thou shalt bring the Levites before the tabernacle of witness; and thou shalt assemble all the congregation of the sons of Israel."],["10",[["καὶ",707031,7],["προσάξεις",710848,166],["τοὺς",709436,58],["Λευίτας",708160,57],["ἔναντι",704653,0],["κυρίου",707996,18],["καὶ",707031,7],["ἐπιθήσουσιν",705304,218],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτῶν",702165,40],["ἐπὶ",705080,0],["τοὺς",709436,58],["Λευίτας",708160,57]],"And thou shalt bring the Levites before the Lord; and the sons of Israel shall lay their hands upon the Levites."],["11",[["καὶ",707031,7],["ἀφοριεῖ",702227,127],["Ααρων",700005,4],["τοὺς",709436,58],["Λευίτας",708160,57],["ἀπόδομα",701452,25],["ἔναντι",704653,0],["κυρίου",707996,18],["παρὰ",709995,0],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["καὶ",707031,7],["ἔσονται",704093,135],["ὥστε",714164,7],["ἐργάζεσθαι",705383,110],["τὰ",709436,41],["ἔργα",705396,42],["κυρίου",707996,18]],"And Aaron shall separate the Levites for a gift before the Lord from the children of Israel: and they shall be prepared to perform the works of the Lord."],["12",[["οἱ",709436,136],["δὲ",703303,11],["Λευῖται",708160,52],["ἐπιθήσουσιν",705304,218],["τὰς",709436,38],["χεῖρας",713787,39],["ἐπὶ",705080,0],["τὰς",709436,38],["κεφαλὰς",707639,39],["τῶν",709436,80],["μόσχων",709029,81],["καὶ",707031,7],["ποιήσει",710582,127],["τὸν",709436,5],["ἕνα",704106,27],["περὶ",710285,0],["ἁμαρτίας",700775,17],["καὶ",707031,7],["τὸν",709436,5],["ἕνα",704106,27],["εἰς",704105,0],["ὁλοκαύτωμα",709589,25],["κυρίῳ",707996,114],["ἐξιλάσασθαι",704932,109],["περὶ",710285,0],["αὐτῶν",702165,40]],"And the Levites shall lay their hands on the heads of the calves; and thou shalt offer one for a sin-offering, and the other for a whole-burnt-offering to the Lord, to make atonement for them."],["13",[["καὶ",707031,7],["στήσεις",706846,166],["τοὺς",709436,58],["Λευίτας",708160,57],["ἔναντι",704653,0],["κυρίου",707996,18],["καὶ",707031,7],["ἔναντι",704653,0],["Ααρων",700005,18],["καὶ",707031,7],["ἔναντι",704653,0],["τῶν",709436,80],["υἱῶν",713075,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀποδώσεις",701449,166],["αὐτοὺς",702165,62],["ἀπόδομα",701452,25],["ἔναντι",704653,0],["κυρίου",707996,18]],"And thou shalt set the Levites before the Lord, and before Aaron, and before his sons; and thou shalt give them as a gift before the Lord."],["14",[["καὶ",707031,7],["διαστελεῖς",703588,166],["τοὺς",709436,58],["Λευίτας",708160,57],["ἐκ",704132,0],["μέσου",708768,116],["υἱῶν",713075,81],["Ισραηλ",706839,18],["καὶ",707031,7],["ἔσονται",704093,135],["ἐμοί",704577,159]],"And thou shalt separate the Levites from the midst of the sons of Israel, and they shall be mine."],["15",[["καὶ",707031,7],["μετὰ",708780,0],["ταῦτα",709858,71],["εἰσελεύσονται",704114,135],["οἱ",709436,136],["Λευῖται",708160,52],["ἐργάζεσθαι",705383,110],["τὰ",709436,41],["ἔργα",705396,42],["τῆς",709436,16],["σκηνῆς",711845,17],["τοῦ",709436,20],["μαρτυρίου",708525,21],["καὶ",707031,7],["καθαριεῖς",706985,166],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἀποδώσεις",701449,166],["αὐτοὺς",702165,62],["ἔναντι",704653,0],["κυρίου",707996,18]],"And afterwards the Levites shall go in to perform the works of the tabernacle of witness; and thou shalt purify them, and present them before the Lord."],["16",[["ὅτι",709803,7],["ἀπόδομα",701452,15],["ἀποδεδομένοι",701449,429],["οὗτοί",709858,201],["μοί",708974,159],["εἰσιν",704093,197],["ἐκ",704132,0],["μέσου",708768,116],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ἀντὶ",701227,0],["τῶν",709436,80],["διανοιγόντων",703532,170],["πᾶσαν",710177,36],["μήτραν",708894,9],["πρωτοτόκων",711046,169],["πάντων",710177,169],["ἐκ",704132,0],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["εἴληφα",708076,89],["αὐτοὺς",702165,62],["ἐμοί",704577,159]],"For these are given to me for a present out of the midst of the children of Israel: I have taken them to myself instead of all the first-born of the sons of Israel that open every womb."],["17",[["ὅτι",709803,7],["ἐμοὶ",704577,159],["πᾶν",710177,46],["πρωτότοκον",711046,46],["ἐν",704639,0],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["ἀπὸ",701425,0],["ἀνθρώπου",701163,18],["ἕως",705792,0],["κτήνους",707934,21],["ᾗ",709781,108],["ἡμέρᾳ",705984,1],["ἐπάταξα",710185,155],["πᾶν",710177,46],["πρωτότοκον",711046,46],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτῳ",700401,1],["ἡγίασα",700153,155],["αὐτοὺς",702165,62],["ἐμοὶ",704577,159]],"For every first-born among the children of Israel [is] mine, whether of man or beast: in the day in which I smote every first-born in the land of Egypt, I sanctified them to myself."],["18",[["καὶ",707031,7],["ἔλαβον",708076,150],["τοὺς",709436,58],["Λευίτας",708160,57],["ἀντὶ",701227,0],["παντὸς",710177,92],["πρωτοτόκου",711046,92],["ἐν",704639,0],["υἱοῖς",713075,148],["Ισραηλ",706839,18]],"And I took the Levites in the place of every first-born among the children of Israel."],["19",[["καὶ",707031,7],["ἀπέδωκα",701449,155],["τοὺς",709436,58],["Λευίτας",708160,57],["ἀπόδομα",701452,25],["δεδομένους",703654,360],["Ααρων",700005,114],["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτοῦ",702165,102],["ἐκ",704132,0],["μέσου",708768,116],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ἐργάζεσθαι",705383,110],["τὰ",709436,41],["ἔργα",705396,42],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ἐν",704639,0],["τῇ",709436,100],["σκηνῇ",711845,1],["τοῦ",709436,20],["μαρτυρίου",708525,21],["καὶ",707031,7],["ἐξιλάσκεσθαι",704932,110],["περὶ",710285,0],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ἐν",704639,0],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["προσεγγίζων",710878,72],["πρὸς",710844,0],["τὰ",709436,41],["ἅγια",700159,68]],"And I gave the Levites presented as a gift to Aaron and his sons out of the midst of the children of Israel, to do the service of the children of Israel in the tabernacle of witness, and to make atonement for the children of Israel: thus there shall be none among the sons of Israel to draw nigh to the holy things."],["20",[["καὶ",707031,7],["ἐποίησεν",710582,2],["Μωυσῆς",709112,4],["καὶ",707031,7],["Ααρων",700005,4],["καὶ",707031,7],["πᾶσα",710177,29],["συναγωγὴ",712376,12],["υἱῶν",713075,81],["Ισραηλ",706839,18],["τοῖς",709436,147],["Λευίταις",708160,148],["καθὰ",706979,28],["ἐνετείλατο",704791,23],["κύριος",707996,4],["τῷ",709436,113],["Μωυσῇ",709112,114],["περὶ",710285,0],["τῶν",709436,80],["Λευιτῶν",708160,81],["οὕτως",709859,28],["ἐποίησαν",710582,150],["αὐτοῖς",702165,151],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18]],"And Moses and Aaron, and all the congregation of the children of Israel, did to the Levites as the Lord commanded Moses concerning the Levites, so the sons of Israel did to them."],["21",[["καὶ",707031,7],["ἡγνίσαντο",700172,189],["οἱ",709436,136],["Λευῖται",708160,52],["καὶ",707031,7],["ἐπλύναντο",710564,189],["τὰ",709436,41],["ἱμάτια",706742,42],["καὶ",707031,7],["ἀπέδωκεν",701449,2],["αὐτοὺς",702165,62],["Ααρων",700005,4],["ἀπόδομα",701452,25],["ἔναντι",704653,0],["κυρίου",707996,18],["καὶ",707031,7],["ἐξιλάσατο",704932,23],["περὶ",710285,0],["αὐτῶν",702165,40],["Ααρων",700005,4],["ἀφαγνίσασθαι",702173,109],["αὐτούς",702165,62]],"So the Levites purified themselves and washed their garments; and Aaron presented them as a gift before the Lord, and Aaron made atonement for them to purify them."],["22",[["καὶ",707031,7],["μετὰ",708780,0],["ταῦτα",709858,71],["εἰσῆλθον",704114,150],["οἱ",709436,136],["Λευῖται",708160,52],["λειτουργεῖν",708132,55],["τὴν",709436,8],["λειτουργίαν",708135,9],["αὐτῶν",702165,40],["ἐν",704639,0],["τῇ",709436,100],["σκηνῇ",711845,1],["τοῦ",709436,20],["μαρτυρίου",708525,21],["ἔναντι",704653,0],["Ααρων",700005,18],["καὶ",707031,7],["ἔναντι",704653,0],["τῶν",709436,80],["υἱῶν",713075,81],["αὐτοῦ",702165,102],["καθὼς",707030,28],["συνέταξεν",712508,2],["κύριος",707996,4],["τῷ",709436,113],["Μωυσῇ",709112,114],["περὶ",710285,0],["τῶν",709436,80],["Λευιτῶν",708160,81],["οὕτως",709859,28],["ἐποίησαν",710582,150],["αὐτοῖς",702165,151]],"And afterwards the Levites went in to minister in their service in the tabernacle of witness before Aaron, and before his sons; as the Lord appointed Moses concerning the Levites, so they did to them."],["23",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["24",[["τοῦτό",709858,132],["ἐστιν",704093,91],["τὸ",709436,34],["περὶ",710285,0],["τῶν",709436,80],["Λευιτῶν",708160,81],["ἀπὸ",701425,0],["πεντεκαιεικοσαετοῦς",710269,18],["καὶ",707031,7],["ἐπάνω",705030,28],["εἰσελεύσονται",704114,135],["ἐνεργεῖν",704718,55],["ἐν",704639,0],["τῇ",709436,100],["σκηνῇ",711845,1],["τοῦ",709436,20],["μαρτυρίου",708525,21]],"This is the [ordinance] for the Levites; From five and twenty years old and upward, they shall go in to minister in the tabernacle of witness."],["25",[["καὶ",707031,7],["ἀπὸ",701425,0],["πεντηκονταετοῦς",710271,116],["ἀποστήσεται",702214,93],["ἀπὸ",701425,0],["τῆς",709436,16],["λειτουργίας",708135,17],["καὶ",707031,7],["οὐκ",709805,28],["ἐργᾶται",705383,93],["ἔτι",705538,28]],"And from fifty years old [the Levite] shall cease from the ministry, and shall not work any longer."],["26",[["καὶ",707031,7],["λειτουργήσει",708132,127],["ὁ",709436,3],["ἀδελφὸς",700249,4],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῇ",709436,100],["σκηνῇ",711845,1],["τοῦ",709436,20],["μαρτυρίου",708525,21],["φυλάσσειν",713619,55],["φυλακάς",713613,39],["ἔργα",705396,42],["δὲ",703303,11],["οὐκ",709805,28],["ἐργᾶται",705383,93],["οὕτως",709859,28],["ποιήσεις",710582,166],["τοῖς",709436,147],["Λευίταις",708160,148],["ἐν",704639,0],["ταῖς",709436,75],["φυλακαῖς",713613,76],["αὐτῶν",702165,40]],"And his brother shall serve in the tabernacle of witness to keep charges, but he shall not do works: so shalt thou do to the Levites in their charges."]]