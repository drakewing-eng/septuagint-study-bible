165,201],["καὶ",707031,7],["ὅσα",709788,68],["ἐστὶν",704093,91],["αὐτῶν",702165,40],["ζῶντα",705851,183],["εἰς",704105,0],["ᾅδου",700255,18],["καὶ",707031,7],["ἐκάλυψεν",707102,2],["αὐτοὺς",702165,62],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["ἀπώλοντο",701513,189],["ἐκ",704132,0],["μέσου",708768,116],["τῆς",709436,16],["συναγωγῆς",712376,17]],"And they went down and all that they had, alive into Hades; and the ground covered them, and they perished from the midst of the congregation."],["34",[["καὶ",707031,7],["πᾶς",710177,14],["Ισραηλ",706839,4],["οἱ",709436,136],["κύκλῳ",707959,114],["αὐτῶν",702165,40],["ἔφυγον",713433,150],["ἀπὸ",701425,0],["τῆς",709436,16],["φωνῆς",713640,17],["αὐτῶν",702165,40],["ὅτι",709803,7],["λέγοντες",708124,146],["μήποτε",708882,28],["καταπίῃ",707374,123],["ἡμᾶς",705981,194],["ἡ",709436,10],["γῆ",703083,12]],"And all Israel round about them fled from the sound of them, for they said, Lest the earth swallow us up [also]."],["35",[["καὶ",707031,7],["πῦρ",711088,25],["ἐξῆλθεν",704909,2],["παρὰ",709995,0],["κυρίου",707996,18],["καὶ",707031,7],["κατέφαγεν",707519,2],["τοὺς",709436,58],["πεντήκοντα",710270,59],["καὶ",707031,7],["διακοσίους",703482,60],["ἄνδρας",701150,57],["τοὺς",709436,58],["προσφέροντας",710974,235],["τὸ",709436,24],["θυμίαμα",706330,25]],"And fire went forth from the Lord, and devoured the two hundred and fifty men that offered incense."]]