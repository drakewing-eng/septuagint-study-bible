[["1",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["2",[["ἐκδίκει",704174,240],["τὴν",709436,8],["ἐκδίκησιν",704175,9],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ἐκ",704132,0],["τῶν",709436,80],["Μαδιανιτῶν",708358,81],["καὶ",707031,7],["ἔσχατον",705519,46],["προστεθήσῃ",710965,364],["πρὸς",710844,0],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133]],"Avenge the wrongs of the children of Israel on the Madianites, and afterwards thou shalt be added to thy people."],["3",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["Μωυσῆς",709112,4],["πρὸς",710844,0],["τὸν",709436,5],["λαὸν",708094,6],["λέγων",708124,72],["ἐξοπλίσατε",704964,74],["ἐξ",704132,0],["ὑμῶν",713091,145],["ἄνδρας",701150,57],["παρατάξασθαι",710108,109],["ἔναντι",704653,0],["κυρίου",707996,18],["ἐπὶ",705080,0],["Μαδιαν",708355,9],["ἀποδοῦναι",701449,106],["ἐκδίκησιν",704175,9],["παρὰ",709995,0],["τοῦ",709436,35],["κυρίου",707996,18],["τῇ",709436,100],["Μαδιαν",708355,1]],"And Moses spoke to the people, saying, Arm some of you, and set yourselves in array before the Lord against Madian, to inflict vengeance on Madian from the Lord."],["4",[["χιλίους",713859,60],["ἐκ",704132,0],["φυλῆς",713620,17],["χιλίους",713859,60],["ἐκ",704132,0],["φυλῆς",713620,17],["ἐκ",704132,0],["πασῶν",710177,198],["φυλῶν",713620,65],["Ισραηλ",706839,18],["ἀποστείλατε",701592,74],["παρατάξασθαι",710108,109]],"Send a thousand of each tribe from all the tribes of the children of Israel to set themselves in array."],["5",[["καὶ",707031,7],["ἐξηρίθμησαν",704877,150],["ἐκ",704132,0],["τῶν",709436,130],["χιλιάδων",713858,65],["Ισραηλ",706839,18],["χιλίους",713859,60],["ἐκ",704132,0],["φυλῆς",713620,17],["δώδεκα",703887,59],["χιλιάδες",713858,191],["ἐνωπλισμένοι",704775,429],["εἰς",704105,0],["παράταξιν",710107,9]],"And they numbered of the thousands of Israel a thousand of [each] tribe, twelve thousands; [these were] armed for war."],["6",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["αὐτοὺς",702165,62],["Μωυσῆς",709112,4],["χιλίους",713859,60],["ἐκ",704132,0],["φυλῆς",713620,17],["χιλίους",713859,60],["ἐκ",704132,0],["φυλῆς",713620,17],["σὺν",712372,0],["δυνάμει",703839,1],["αὐτῶν",702165,40],["καὶ",707031,7],["Φινεες",713510,6],["υἱὸν",713075,6],["Ελεαζαρ",704407,18],["υἱοῦ",713075,18],["Ααρων",700005,18],["τοῦ",709436,35],["ἱερέως",706614,18],["καὶ",707031,7],["τὰ",709436,41],["σκεύη",711844,42],["τὰ",709436,41],["ἅγια",700159,68],["καὶ",707031,7],["αἱ",709436,190],["σάλπιγγες",711424,191],["τῶν",709436,130],["σημασιῶν",711746,65],["ἐν",704639,0],["ταῖς",709436,75],["χερσὶν",713787,76],["αὐτῶν",702165,40]],"And Moses sent them away a thousand of every tribe with their forces, and Phinees the son of Eleazar the son of Aaron the priest: and the holy instruments, and the signal trumpets [were] in their hands."],["7",[["καὶ",707031,7],["παρετάξαντο",710108,189],["ἐπὶ",705080,0],["Μαδιαν",708355,9],["καθὰ",706979,28],["ἐνετείλατο",704791,23],["κύριος",707996,4],["τῷ",709436,113],["Μωυσῇ",709112,114],["καὶ",707031,7],["ἀπέκτειναν",701498,150],["πᾶν",710177,46],["ἀρσενικόν",701817,46]],"And they set themselves in array against Madian, as the Lord commanded Moses; and they slew every male."],["8",[["καὶ",707031,7],["τοὺς",709436,58],["βασιλεῖς",702580,52],["Μαδιαν",708355,17],["ἀπέκτειναν",701498,150],["ἅμα",700745,28],["τοῖς",709436,147],["τραυματίαις",712921,148],["αὐτῶν",702165,40],["καὶ",707031,7],["τὸν",709436,5],["Ευιν",705610,6],["καὶ",707031,7],["τὸν",709436,5],["Σουρ",711962,6],["καὶ",707031,7],["τὸν",709436,5],["Ροκομ",711288,6],["καὶ",707031,7],["τὸν",709436,5],["Ουρ",709838,6],["καὶ",707031,7],["τὸν",709436,5],["Ροβοκ",711277,6],["πέντε",710266,59],["βασιλεῖς",702580,52],["Μαδιαν",708355,17],["καὶ",707031,7],["τὸν",709436,5],["Βαλααμ",702468,6],["υἱὸν",713075,6],["Βεωρ",702671,6],["ἀπέκτειναν",701498,150],["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["σὺν",712372,0],["τοῖς",709436,147],["τραυματίαις",712921,148],["αὐτῶν",702165,40]],"And they slew the kings of Madian together with their slain [subjects]; even Evi and Rocon, and Sur, and Ur, and Roboc, five kings of Madian; and they slew with the sword Balaam the son of Beor with their [other] slain."],["9",[["καὶ",707031,7],["ἐπρονόμευσαν",710826,150],["τὰς",709436,38],["γυναῖκας",703209,39],["Μαδιαν",708355,17],["καὶ",707031,7],["τὴν",709436,8],["ἀποσκευὴν",701573,9],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,41],["κτήνη",707934,42],["αὐτῶν",702165,40],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["ἔγκτητα",703997,68],["αὐτῶν",702165,40],["καὶ",707031,7],["τὴν",709436,8],["δύναμιν",703839,9],["αὐτῶν",702165,40],["ἐπρονόμευσαν",710826,150]],"And they made a prey of the women of Madian, and their store, and their cattle, and all their possessions: and they spoiled their forces."],["10",[["καὶ",707031,7],["πάσας",710177,119],["τὰς",709436,38],["πόλεις",710612,39],["αὐτῶν",702165,40],["τὰς",709436,38],["ἐν",704639,0],["ταῖς",709436,75],["οἰκίαις",709505,76],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰς",709436,38],["ἐπαύλεις",705048,39],["αὐτῶν",702165,40],["ἐνέπρησαν",704592,150],["ἐν",704639,0],["πυρί",711088,54]],"And they burnt with fire all their cities in the places of their habitation, and they burnt their villages with fire."],["11",[["καὶ",707031,7],["ἔλαβον",708076,150],["πᾶσαν",710177,36],["τὴν",709436,8],["προνομὴν",710827,9],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["σκῦλα",711902,42],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["ἀνθρώπου",701163,18],["ἕως",705792,0],["κτήνους",707934,21]],"And they took all their plunder, and all their spoils, both man and beast."],["12",[["καὶ",707031,7],["ἤγαγον",700209,150],["πρὸς",710844,0],["Μωυσῆν",709112,6],["καὶ",707031,7],["πρὸς",710844,0],["Ελεαζαρ",704407,6],["τὸν",709436,5],["ἱερέα",706614,6],["καὶ",707031,7],["πρὸς",710844,0],["πάντας",710177,60],["υἱοὺς",713075,57],["Ισραηλ",706839,18],["τὴν",709436,8],["αἰχμαλωσίαν",700499,9],["καὶ",707031,7],["τὰ",709436,41],["σκῦλα",711902,42],["καὶ",707031,7],["τὴν",709436,8],["προνομὴν",710827,9],["εἰς",704105,0],["τὴν",709436,8],["παρεμβολὴν",710133,9],["εἰς",704105,0],["Αραβωθ",701675,6],["Μωαβ",709085,18],["ἥ",709781,177],["ἐστιν",704093,91],["ἐπὶ",705080,0],["τοῦ",709436,35],["Ιορδάνου",706763,18],["κατὰ",707200,0],["Ιεριχω",706620,6]],"And they brought to Moses and to Eleazar the priest, and to all the children of Israel, the captives, and the spoils, and the plunder, to the camp to Araboth Moab, which is at Jordan by Jericho."],["13",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["Μωυσῆς",709112,4],["καὶ",707031,7],["Ελεαζαρ",704407,4],["ὁ",709436,3],["ἱερεὺς",706614,4],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["ἄρχοντες",701862,52],["τῆς",709436,16],["συναγωγῆς",712376,17],["εἰς",704105,0],["συνάντησιν",712397,9],["αὐτοῖς",702165,151],["ἔξω",704983,0],["τῆς",709436,16],["παρεμβολῆς",710133,17]],"And Moses and Eleazar the priest and all the rulers of the synagogue went forth out of the camp to meet them."],["14",[["καὶ",707031,7],["ὠργίσθη",709729,37],["Μωυσῆς",709112,4],["ἐπὶ",705080,0],["τοῖς",709436,147],["ἐπισκόποις",705256,148],["τῆς",709436,16],["δυνάμεως",703839,17],["χιλιάρχοις",713857,148],["καὶ",707031,7],["ἑκατοντάρχοις",704140,148],["τοῖς",709436,147],["ἐρχομένοις",705453,341],["ἐκ",704132,0],["τῆς",709436,16],["παρατάξεως",710107,17],["τοῦ",709436,35],["πολέμου",710605,18]],"And Moses was angry with the captains of the host, the heads of thousands and the heads of hundreds who came from the battle-array."],["15",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["Μωυσῆς",709112,4],["ἵνα",706747,7],["τί",712867,126],["ἐζωγρήσατε",705906,265],["πᾶν",710177,46],["θῆλυ",706237,46]],"And Moses said to them, Why have ye saved every female alive?"],["16",[["αὗται",709858,202],["γὰρ",702963,11],["ἦσαν",704093,137],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["κατὰ",707200,0],["τὸ",709436,24],["ῥῆμα",711246,25],["Βαλααμ",702468,18],["τοῦ",709436,20],["ἀποστῆσαι",702214,106],["καὶ",707031,7],["ὑπεριδεῖν",713154,106],["τὸ",709436,24],["ῥῆμα",711246,25],["κυρίου",707996,18],["ἕνεκεν",704709,0],["Φογωρ",713535,118],["καὶ",707031,7],["ἐγένετο",703104,23],["ἡ",709436,10],["πληγὴ",710527,12],["ἐν",704639,0],["τῇ",709436,100],["συναγωγῇ",712376,1],["κυρίου",707996,18]],"For they were [the occasion] to the children of Israel by the word of Balaam of their revolting and despising the word of the Lord, because of Phogor; and there was a plague in the congregation of the Lord."],["17",[["καὶ",707031,7],["νῦν",709384,28],["ἀποκτείνατε",701498,74],["πᾶν",710177,46],["ἀρσενικὸν",701817,46],["ἐν",704639,0],["πάσῃ",710177,101],["τῇ",709436,100],["ἀπαρτίᾳ",701358,1],["καὶ",707031,7],["πᾶσαν",710177,36],["γυναῖκα",703209,9],["ἥτις",709793,412],["ἔγνωκεν",703105,171],["κοίτην",707781,9],["ἄρσενος",701818,116],["ἀποκτείνατε",701498,74]],"Now then slay every male in all the spoil, slay every woman, who has known the lying with man."],["18",[["πᾶσαν",710177,36],["τὴν",709436,8],["ἀπαρτίαν",701358,9],["τῶν",709436,130],["γυναικῶν",703209,65],["ἥτις",709793,412],["οὐκ",709805,28],["οἶδεν",709492,171],["κοίτην",707781,9],["ἄρσενος",701818,116],["ζωγρήσατε",705906,74],["αὐτάς",702165,231]],"And as for all the captivity of women, who have not known the lying with man, save ye them alive."],["19",[["καὶ",707031,7],["ὑμεῖς",713081,219],["παρεμβάλετε",710132,74],["ἔξω",704983,0],["τῆς",709436,16],["παρεμβολῆς",710133,17],["ἑπτὰ",705357,59],["ἡμέρας",705984,17],["πᾶς",710177,14],["ὁ",709436,3],["ἀνελὼν",700962,182],["καὶ",707031,7],["ὁ",709436,3],["ἁπτόμενος",701654,122],["τοῦ",709436,20],["τετρωμένου",712871,441],["ἁγνισθήσεται",700172,134],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["τρίτῃ",712968,101],["καὶ",707031,7],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["ἑβδόμῃ",703925,101],["ὑμεῖς",713081,219],["καὶ",707031,7],["ἡ",709436,10],["αἰχμαλωσία",700499,12],["ὑμῶν",713091,145]],"And ye shall encamp outside the [great] camp seven days; every one who has slain and who touches a dead body, shall be purified on the third day, and ye and your captivity [shall purify yourselves] on the seventh day."],["20",[["καὶ",707031,7],["πᾶν",710177,46],["περίβλημα",710298,46],["καὶ",707031,7],["πᾶν",710177,46],["σκεῦος",711844,25],["δερμάτινον",703364,46],["καὶ",707031,7],["πᾶσαν",710177,36],["ἐργασίαν",705385,9],["ἐξ",704132,0],["αἰγείας",700395,82],["καὶ",707031,7],["πᾶν",710177,46],["σκεῦος",711844,25],["ξύλινον",709425,46],["ἀφαγνιεῖτε",702173,337]],"And ye shall purify every garment and every leathern utensil, and all furniture of goat skin, and every wooden vessel."],["21",[["καὶ",707031,7],["εἶπεν",705373,2],["Ελεαζαρ",704407,4],["ὁ",709436,3],["ἱερεὺς",706614,4],["πρὸς",710844,0],["τοὺς",709436,58],["ἄνδρας",701150,57],["τῆς",709436,16],["δυνάμεως",703839,17],["τοὺς",709436,58],["ἐρχομένους",705453,236],["ἐκ",704132,0],["τῆς",709436,16],["παρατάξεως",710107,17],["τοῦ",709436,35],["πολέμου",710605,18],["τοῦτο",709858,132],["τὸ",709436,34],["δικαίωμα",703697,15],["τοῦ",709436,35],["νόμου",709349,18],["ὃ",709781,33],["συνέταξεν",712508,2],["κύριος",707996,4],["τῷ",709436,113],["Μωυσῇ",709112,114]],"And Eleazar the priest said to the men of the host that came from the battle-array, This [is] the ordinance of the law which the Lord has commanded Moses."],["22",[["πλὴν",710540,0],["τοῦ",709436,20],["χρυσίου",713972,21],["καὶ",707031,7],["τοῦ",709436,20],["ἀργυρίου",701707,21],["καὶ",707031,7],["χαλκοῦ",713695,18],["καὶ",707031,7],["σιδήρου",711774,18],["καὶ",707031,7],["μολίβου",708981,18],["καὶ",707031,7],["κασσιτέρου",707198,18]],"Beside the gold, and the silver, and the brass, and the iron, and lead, and tin,"],["23",[["πᾶν",710177,46],["πρᾶγμα",710708,25],["ὃ",709781,33],["διελεύσεται",703673,93],["ἐν",704639,0],["πυρί",711088,54],["καὶ",707031,7],["καθαρισθήσεται",706985,134],["ἀλλ᾿",700680,7],["ἢ",705924,7],["τῷ",709436,53],["ὕδατι",7130