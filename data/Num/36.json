,86],["ἔσονται",704093,135],["γυναῖκες",703209,191],["ἵνα",706747,7],["ἀγχιστεύσωσιν",700205,234],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["ἕκαστος",704133,14],["τὴν",709436,8],["κληρονομίαν",707725,9],["τὴν",709436,8],["πατρικὴν",710194,36],["αὐτοῦ",702165,102]],"And whatever daughter is heiress to a property of the tribes of the children of Israel, [such] women shall be married each to one of her father's tribe, that the sons of Israel may each inherit the property of his father's tribe."],["9",[["καὶ",707031,7],["οὐ",709805,28],["περιστραφήσεται",710395,134],["κλῆρος",707727,4],["ἐκ",704132,0],["φυλῆς",713620,17],["ἐπὶ",705080,0],["φυλὴν",713620,9],["ἑτέραν",705535,36],["ἀλλὰ",700680,7],["ἕκαστος",704133,14],["ἐν",704639,0],["τῇ",709436,100],["κληρονομίᾳ",707725,1],["αὐτοῦ",702165,102],["προσκολληθήσονται",710921,144],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18]],"And the inheritance shall not go about from one tribe to another, but the children of Israel shall steadfastly continue each in his own inheritance."],["10",[["ὃν",709781,112],["τρόπον",712980,6],["συνέταξεν",712508,2],["κύριος",707996,4],["Μωυσῇ",709112,114],["οὕτως",709859,28],["ἐποίησαν",710582,150],["θυγατέρες",706320,191],["Σαλπααδ",711423,18]],"As the Lord commanded Moses, so did they to the daughters of Salpaad."],["11",[["καὶ",707031,7],["ἐγένοντο",703104,189],["Θερσα",706220,12],["καὶ",707031,7],["Εγλα",704005,12],["καὶ",707031,7],["Μελχα",708708,12],["καὶ",707031,7],["Νουα",709365,12],["καὶ",707031,7],["Μααλα",708298,12],["θυγατέρες",706320,191],["Σαλπααδ",711423,18],["τοῖς",709436,147],["ἀνεψιοῖς",701141,148],["αὐτῶν",702165,284]],"So Thersa, and Egla, and Melcha, and Nua, and Malaa, the daughters of Salpaad, married their cousins;"],["12",[["ἐκ",704132,0],["τοῦ",709436,35],["δήμου",703411,18],["τοῦ",709436,35],["Μανασση",708470,18],["υἱῶν",713075,81],["Ιωσηφ",706948,18],["ἐγενήθησαν",703104,99],["γυναῖκες",703209,191],["καὶ",707031,7],["ἐγένετο",703104,23],["ἡ"