",713091,145],["καὶ",707031,7],["ἐξαρεῖτε",704839,337],["τὰς",709436,38],["σκοπιὰς",711876,39],["αὐτῶν",702165,40],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["εἴδωλα",704079,42],["τὰ",709436,41],["χωνευτὰ",714009,68],["αὐτῶν",702165,40],["ἀπολεῖτε",701513,337],["αὐτὰ",702165,71],["καὶ",707031,7],["πάσας",710177,119],["τὰς",709436,38],["στήλας",712092,39],["αὐτῶν",702165,40],["ἐξαρεῖτε",704839,337]],"And ye shall destroy all that dwell in the land before your face, and ye shall abolish their high places, and all their molten images ye shall destroy, and ye shall demolish all their pillars."],["53",[["καὶ",707031,7],["ἀπολεῖτε",701513,337],["πάντας",710177,60],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["κατοικήσετε",707534,337],["ἐν",704639,0],["αὐτῇ",702165,105],["ὑμῖν",713084,90],["γὰρ",702963,11],["δέδωκα",703654,89],["τὴν",709436,8],["γῆν",703083,9],["αὐτῶν",702165,40],["ἐν",704639,0],["κλήρῳ",707727,114]],"And ye shall destroy all the inhabitants of the land, and ye shall dwell in it, for I have given their land to you for an inheritance."],["54",[["καὶ",707031,7],["κατακληρονομήσετε",707274,337],["τὴν",709436,8],["γῆν",703083,9],["αὐτῶν",702165,40],["ἐν",704639,0],["κλήρῳ",707727,114],["κατὰ",707200,0],["φυλὰς",713620,39],["ὑμῶν",713091,145],["τοῖς",709436,147],["πλείοσιν",710514,230],["πληθυνεῖτε",710530,337],["τὴν",709436,8],["κατάσχεσιν",707451,9],["αὐτῶν",702165,40],["καὶ",707031,7],["τοῖς",709436,147],["ἐλάττοσιν",704388,230],["ἐλαττώσετε",704394,337],["τὴν",709436,8],["κατάσχεσιν",707451,9],["αὐτῶν",702165,40],["εἰς",704105,0],["ὃ",709781,128],["ἐὰν",703912,7],["ἐξέλθῃ",704909,172],["τὸ",709436,34],["ὄνομα",709666,15],["αὐτοῦ",702165,102],["ἐκεῖ",704181,28],["αὐτοῦ",702165,102],["ἔσται",704093,93],["κατὰ",707200,0],["φυλὰς",713620,39],["πατριῶν",710192,65],["ὑμῶν",713091,145],["κληρονομήσετε",707724,337]],"And ye shall inherit their land according to your tribes; to the greater number ye shall give the larger possession, and to the smaller ye shall give the less possession; to whatsoever [part] a man's name shall go forth [by lot], there shall be his [property]: ye shall inherit according to the tribes of your families."],["55",[["ἐὰν",703912,7],["δὲ",703303,11],["μὴ",708851,28],["ἀπολέσητε",701513,125],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ἀπὸ",701425,0],["προσώπου",710986,21],["ὑμῶν",713091,145],["καὶ",707031,7],["ἔσται",704093,93],["οὓς",709781,298],["ἐὰν",703912,7],["καταλίπητε",707305,125],["ἐξ",704132,0],["αὐτῶν",702165,40],["σκόλοπες",711871,52],["ἐν",704639,0],["τοῖς",709436,147],["ὀφθαλμοῖς",709870,148],["ὑμῶν",713091,145],["καὶ",707031,7],["βολίδες",702756,191],["ἐν",704639,0],["ταῖς",709436,75],["πλευραῖς",710524,76],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐχθρεύσουσιν",705777,218],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ἐφ᾿",705080,0],["ἣν",709781,131],["ὑμεῖς",713081,219],["κατοικήσετε",707534,337]],"But if ye will not destroy the dwellers in the land from before you, then it shall come to pass that whomsoever of them ye shall leave shall be thorns in your eyes, and darts in your sides, and they shall be enemies to you on the land on which ye shall dwell;"],["56",[["καὶ",707031,7],["ἔσται",704093,93],["καθότι",707021,28],["διεγνώκειν",703435,499],["ποιῆσαι",710582,106],["αὐτούς",702165,62],["ποιήσω",710582,207],["ὑμῖν",713084,90]],"and it shall come to pass that as I had determined to do to them, so I will do to you."]]