,709802,28],["εἰσεπορεύοντο",704124,139],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18]],"And Arad the Chananitish king (he too dwelt in the land of Chanaan) having heard when the children of Israel were entering [the land]—"],["41",[["καὶ",707031,7],["ἀπῆραν",701329,150],["ἐξ",704132,0],["Ωρ",714127,18],["τοῦ",709436,20],["ὄρους",709768,21],["καὶ",707031,7],["παρενέβαλον",710132,150],["εἰς",704105,0],["Σελμωνα",711660,6]],"then they departed from mount Or, and encamped in Selmona."],["42",[["καὶ",707031,7],["ἀπῆραν",701329,150],["ἐκ",704132,0],["Σελμωνα",711660,17],["καὶ",707031,7],["παρενέβαλον",710132,150],["εἰς",704105,0],["Φινω",713512,6]],"And they departed from Selmona, and encamped in Phino."],["43",[["καὶ",707031,7],["ἀπῆραν",701329,150],["ἐκ",704132,0],["Φινω",713512,18],["καὶ",707031,28],["παρενέβαλον",710132,150],["εἰς",704105,0],["Ωβωθ",714087,6]],"And they departed from Phino, and encamped in Oboth."],["44",[["καὶ",707031,7],["ἀπῆραν",701329,150],["ἐξ",704132,0],["Ωβωθ",714087,18],["καὶ",707031,28],["παρενέβαλον",710132,150],["ἐν",704639,0],["Γαι",702900,1],["ἐν",704639,0],["τῷ",709436,113],["πέραν",710280,28],["ἐπὶ",705080,0],["τῶν",709436,43],["ὁρίων",709749,44],["Μωαβ",709085,18]],"And they departed from Oboth, and encamped in Gai, on the other side [Jordan] on the borders of Moab."],["45",[["καὶ",707031,7],["ἀπῆραν",701329,150],["ἐκ",704132,0],["Γαι",702900,17],["καὶ",707031,28],["παρενέβαλον",710132,150],["εἰς",704105,0],["Δαιβων",703247,6],["Γαδ",702872,6]],"And they departed from Gai, and encamped in Dæbon Gad."],["46",[["καὶ",707031,7],["ἀπῆραν",701329,150],["ἐκ",704132,0],["Δαιβων",703247,18],["Γαδ",702872,18],["καὶ",707031,7],["παρενέβαλον",710132,150],["ἐν",704639,0],["Γελμων",703024,114],["Δεβλαθαιμ",703309,114]],"And they departed from Dæbon Gad, and encamped in Gelmon Deblathaim."],["47",[["καὶ",707031,7],["ἀπῆραν",701329,150],["ἐκ",704132,0],["Γελμων",703024,18],["Δεβλαθαιμ",703309,18],["καὶ",707031,7],["παρενέβαλον",710132,15