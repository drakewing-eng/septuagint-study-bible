24,7],["μὴν",708873,11],["ὃν",709781,112],["τρόπον",712980,6],["λελαλήκατε",708071,330],["εἰς",704105,0],["τὰ",709436,41],["ὦτά",709852,42],["μου",709032,133],["οὕτως",709859,28],["ποιήσω",710582,207],["ὑμῖν",713084,90]],"Say to them, [As] I live, saith the Lord: surely as ye spoke into my ears, so will I do to you."],["29",[["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["ταύτῃ",709858,105],["πεσεῖται",710481,93],["τὰ",709436,41],["κῶλα",708017,42],["ὑμῶν",713091,145],["καὶ",707031,7],["πᾶσα",710177,29],["ἡ",709436,10],["ἐπισκοπὴ",705255,12],["ὑμῶν",713091,145],["καὶ",707031,7],["οἱ",709436,136],["κατηριθμημένοι",707402,429],["ὑμῶν",713091,145],["ἀπὸ",701425,0],["εἰκοσαετοῦς",704084,116],["καὶ",707031,7],["ἐπάνω",705030,28],["ὅσοι",709788,138],["ἐγόγγυσαν",703144,150],["ἐπ᾿",705080,0],["ἐμοί",704577,159]],"Your carcases shall fall in this wilderness; and all those of you that were reviewed, and those of you that were numbered from twenty years old and upward, all that murmured against me,"],["30",[["εἰ",704071,7],["ὑμεῖς",713081,219],["εἰσελεύσεσθε",704114,124],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ἐφ᾿",705080,0],["ἣν",709781,131],["ἐξέτεινα",704322,155],["τὴν",709436,8],["χεῖρά",713787,9],["μου",709032,133],["κατασκηνῶσαι",707423,106],["ὑμᾶς",713080,194],["ἐπ᾿",705080,0],["αὐτῆς",702165,86],["ἀλλ᾿",700680,7],["ἢ",705924,7],["Χαλεβ",713680,4],["υἱὸς",713075,4],["Ιεφοννη",706687,18],["καὶ",707031,7],["Ἰησοῦς",706701,4],["ὁ",709436,3],["τοῦ",709436,35],["Ναυη",709206,18]],"ye shall not enter into the land for which I stretched out my hand to establish you upon it; except only Chaleb the son of Jephonne, and Joshua the [son] of Naue."],["31",[["καὶ",707031,7],["τὰ",709436,41],["παιδία",709927,42],["ἃ",709781,69],["εἴπατε",705373,265],["ἐν",704639,0],["διαρπαγῇ",703561,1],["ἔσεσθαι",704093,492],["εἰσάξω",704107,165],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["κληρονομήσουσιν",707724,218],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["ὑμεῖς",713081,219],["ἀπέστητε",702214,265],["ἀπ᾿",701425,0],["αὐτῆς",702165,86]],"And your little ones, who ye said should be a prey, them will I bring into the land; and they shall inherit the land, which ye rejected."],["32",[["καὶ",707031,7],["τὰ",709436,41],["κῶλα",708017,42],["ὑμῶν",713091,145],["πεσεῖται",710481,93],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["ταύτῃ",709858,105]],"And your carcases shall fall in this wilderness."],["33",[["οἱ",709436,136],["δὲ",703303,11],["υἱοὶ",713075,52],["ὑμῶν",713091,145],["ἔσονται",704093,135],["νεμόμενοι",709253,348],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["τεσσαράκοντα",712806,59],["ἔτη",705543,42],["καὶ",707031,7],["ἀνοίσουσιν",701083,218],["τὴν",709436,8],["πορνείαν",710672,9],["ὑμῶν",713091,145],["ἕως",705792,7],["ἂν",700900,11],["ἀναλωθῇ",700992,384],["τὰ",709436,41],["κῶλα",708017,42],["ὑμῶν",713091,145],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1]],"And your sons shall be fed in the wilderness forty years, and they shall bear your fornication, until your carcases be consumed in the wilderness."],["34",[["κατὰ",707200,0],["τὸν",709436,5],["ἀριθμὸν",701744,6],["τῶν",709436,130],["ἡμερῶν",705984,65],["ὅσας",709788,119],["κατεσκέψασθε",707418,345],["τὴν",709436,8],["γῆν",703083,9],["τεσσαράκοντα",712806,59],["ἡμέρας",705984,39],["ἡμέραν",705984,9],["τοῦ",709436,35],["ἐνιαυτοῦ",704745,18],["λήμψεσθε",708076,124],["τὰς",709436,38],["ἁμαρτίας",700775,39],["ὑμῶν",713091,145],["τεσσαράκοντα",712806,59],["ἔτη",705543,42],["καὶ",707031,7],["γνώσεσθε",703105,124],["τὸν",709436,5],["θυμὸν",706334,6],["τῆς",709436,16],["ὀργῆς",709728,17],["μου",709032,133]],"According to the number of the days during which ye spied the land, forty days, a day for a year, ye shall bear your sins forty years, and ye shall know my fierce anger."],["35",[["ἐγὼ",704018,164],["κύριος",707996,4],["ἐλάλησα",708071,155],["ἦ",705924,7],["μὴν",708873,11],["οὕτως",709859,28],["ποιήσω",710582,207],["τῇ",709436,100],["συναγωγῇ",712376,1],["τῇ",709436,100],["πονηρᾷ",710660,101],["ταύτῃ",709858,105],["τῇ",709436,100],["ἐπισυνεσταμένῃ",705283,455],["ἐπ᾿",705080,0],["ἐμέ",704555,163],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["ταύτῃ",709858,105],["ἐξαναλωθήσονται",704861,144],["καὶ",707031,7],["ἐκεῖ",704181,28],["ἀποθανοῦνται",701461,135]],"I the Lord have spoken, Surely will I do thus to this evil congregation that has risen up together against me: in this wilderness they shall be utterly consumed, and there they shall die."],["36",[["καὶ",707031,7],["οἱ",709436,136],["ἄνθρωποι",701163,52],["οὓς",709781,298],["ἀπέστειλεν",701592,2],["Μωυσῆς",709112,4],["κατασκέψασθαι",707418,109],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["παραγενηθέντες",710006,247],["διεγόγγυσαν",703438,150],["κατ᾿",707200,0],["αὐτῆς",702165,86],["πρὸς",710844,0],["τὴν",709436,8],["συναγωγὴν",712376,9],["ἐξενέγκαι",704356,106],["ῥήματα",711246,42],["πονηρὰ",710660,68],["περὶ",710285,0],["τῆς",709436,16],["γῆς",703083,17]],"And the men whom Moses sent to spy out the land, and who came and murmured against it to the assembly so as to bring out evil words concerning the land,—"],["37",[["καὶ",707031,7],["ἀπέθανον",701461,150],["οἱ",709436,136],["ἄνθρωποι",701163,52],["οἱ",709436,136],["κατείπαντες",707504,196],["κατὰ",707200,0],["τῆς",709436,16],["γῆς",703083,17],["πονηρὰ",710660,68],["ἐν",704639,0],["τῇ",709436,100],["πληγῇ",710527,1],["ἔναντι",704653,0],["κυρίου",707996,18]],"the men that spoke evil reports against the land, even died of the plague before the Lord."],["38",[["καὶ",707031,7],["Ἰησοῦς",706701,4],["υἱὸς",713075,4],["Ναυη",709206,18],["καὶ",707031,7],["Χαλεβ",713680,4],["υἱὸς",713075,4],["Ιεφοννη",706687,18],["ἔζησαν",705851,150],["ἀπὸ",701425,0],["τῶν",709436,80],["ἀνθρώπων",701163,81],["ἐκείνων",704183,40],["τῶν",709436,80],["πεπορευμένων",710667,445],["κατασκέψασθαι",707418,109],["τὴν",709436,8],["γῆν",703083,9]],"And Joshua the son of Naue and Chaleb the son of Jephonne [still] lived of those men that went to spy out the land."],["39",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["Μωυσῆς",709112,4],["τὰ",709436,41],["ῥήματα",711246,42],["ταῦτα",709858,71],["πρὸς",710844,0],["πάντας",710177,60],["υἱοὺς",713075,57],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐπένθησεν",710251,2],["ὁ",709436,3],["λαὸς",708094,4],["σφόδρα",712586,28]],"And Moses spoke these words to all the children of Israel; and the people mourned exceedingly."],["40",[["καὶ",707031,7],["ὀρθρίσαντες",709742,196],["τὸ",709436,24],["πρωὶ",711021,28],["ἀνέβησαν",700905,150],["εἰς",704105,0],["τὴν",709436,8],["κορυφὴν",707844,9],["τοῦ",709436,20],["ὄρους",709768,21],["λέγοντες",708124,146],["ἰδοὺ",706497,88],["οἵδε",709446,201],["ἡμεῖς",705983,219],["ἀναβησόμεθα",700905,141],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["ὃν",709781,112],["εἶπεν",705373,2],["κύριος",707996,4],["ὅτι",709803,7],["ἡμάρτομεν",700773,289]],"And they rose early in the morning and went up to the top of the mountain, saying, Behold, we that are here will go up to the place of which the Lord has spoken, because we have sinned."],["41",[["καὶ",707031,7],["εἶπεν",705373,2],["Μωυσῆς",709112,4],["ἵνα",706747,7],["τί",712867,126],["ὑμεῖς",713081,219],["παραβαίνετε",709996,87],["τὸ",709436,24],["ῥῆμα",711246,25],["κυρίου",707996,18],["οὐκ",709805,28],["εὔοδα",705653,195],["ἔσται",704093,93],["ὑμῖν",713084,90]],"And Moses said, Why do ye transgress the word of the Lord? ye shall not prosper."],["42",[["μὴ",708851,28],["ἀναβαίνετε",700905,87],["οὐ",709805,28],["γάρ",702963,11],["ἐστιν",704093,91],["κύριος",707996,4],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["καὶ",707031,7],["πεσεῖσθε",710481,124],["πρὸ",710747,0],["προσώπου",710986,21],["τῶν",709436,80],["ἐχθρῶν",705779,81],["ὑμῶν",713091,145]],"Go not up, for the Lord is not with you; so shall ye fall before the face of your enemies."],["43",[["ὅτι",709803,7],["ὁ",709436,3],["Αμαληκ",700759,4],["καὶ",707031,7],["ὁ",709436,3],["Χαναναῖος",713711,4],["ἐκεῖ",704181,28],["ἔμπροσθεν",704618,0],["ὑμῶν",713091,145],["καὶ",707031,7],["πεσεῖσθε",710481,124],["μαχαίρᾳ",708593,1],["οὗ",709781,48],["εἵνεκεν",704709,0],["ἀπεστράφητε",701598,472],["ἀπειθοῦντες",701370,146],["κυρίῳ",707996,114],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["κύριος",707996,4],["ἐν",704639,0],["ὑμῖν",713084,90]],"For Amalec and the Chananite [are] there before you, and ye shall fall by the sword; because ye have disobeyed the Lord and turned aside, and the Lord will not be among you."],["44",[["καὶ",707031,7],["διαβιασάμενοι",703423,317],["ἀνέβησαν",700905,150],["ἐπὶ",705080,0],["τὴν",709436,8],["κορυφὴν",707844,9],["τοῦ",709436,20],["ὄρους",709768,21],["ἡ",709436,10],["δὲ",703303,11],["κιβωτὸς",707667,12],["τῆς",709436,16],["διαθήκης",703456,17],["κυρίου",707996,18],["καὶ",707031,7],["Μωυσῆς",709112,4],["οὐκ",709805,28],["ἐκινήθησαν",707679,99],["ἐκ",704132,0],["τῆς",709436,16],["παρεμβολῆς",710133,17]],"And having forced their passage, they went up to the top of the mountain; but the ark of the covenant of the Lord and Moses stirred not out of the camp."],["45",[["καὶ",707031,7],["κατέβη",707202,2],["ὁ",709436,3],["Αμαληκ",700759,4],["καὶ",707031,7],["ὁ",709436,3],["Χαναναῖος",713711,4],["ὁ",709436,3],["ἐγκαθήμενος",703952,122],["ἐν",704639,0],["τῷ",709436,53],["ὄρει",709768,54],["ἐκείνῳ",704183,280],["καὶ",707031,7],["ἐτρέψαντο",712929,189],["αὐτοὺς",702165,62],["καὶ",707031,7],["κατέκοψαν",707285,150],["αὐτοὺς",702165,62],["ἕως",705792,0],["Ερμαν",705432,18],["καὶ",707031,7],["ἀπεστράφησαν",701598,99],["εἰς",704105,0],["τὴν",709436,8],["παρεμβολήν",710133,9]],"And Amalec and the Chananite that dwelt in that mountain came down, and routed them, and destroyed them unto Herman; and they returned to the camp."]]