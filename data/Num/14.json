[["1",[["καὶ",707031,7],["ἀναλαβοῦσα",700984,149],["πᾶσα",710177,29],["ἡ",709436,10],["συναγωγὴ",712376,12],["ἔδωκεν",703654,2],["φωνήν",713640,9],["καὶ",707031,7],["ἔκλαιεν",707703,13],["ὁ",709436,3],["λαὸς",708094,4],["ὅλην",709597,36],["τὴν",709436,8],["νύκτα",709386,9],["ἐκείνην",704183,104]],"And all the congregation lifted up their voice and cried; and the people wept all that night."],["2",[["καὶ",707031,7],["διεγόγγυζον",703438,137],["ἐπὶ",705080,0],["Μωυσῆν",709112,6],["καὶ",707031,7],["Ααρων",700005,6],["πάντες",710177,138],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["καὶ",707031,7],["εἶπαν",705373,150],["πρὸς",710844,0],["αὐτοὺς",702165,62],["πᾶσα",710177,29],["ἡ",709436,10],["συναγωγή",712376,12],["ὄφελον",709866,293],["ἀπεθάνομεν",701461,289],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτῳ",700401,1],["ἢ",705924,7],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["ταύτῃ",709858,105],["εἰ",704071,7],["ἀπεθάνομεν",701461,289]],"And all the children of Israel murmured against Moses and Aaron; and all the congregation said to them,",{"s":"d","q":0.56}],["3",[["καὶ",707031,7],["ἵνα",706747,7],["τί",712867,126],["κύριος",707996,4],["εἰσάγει",704107,91],["ἡμᾶς",705981,194],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104],["πεσεῖν",710481,106],["ἐν",704639,0],["πολέμῳ",710605,114],["αἱ",709436,190],["γυναῖκες",703209,191],["ἡμῶν",705999,145],["καὶ",707031,7],["τὰ",709436,63],["παιδία",709927,64],["ἔσονται",704093,135],["εἰς",704105,0],["διαρπαγήν",703561,9],["νῦν",709384,28],["οὖν",709835,11],["βέλτιον",702647,46],["ἡμῖν",705994,90],["ἐστιν",704093,91],["ἀποστραφῆναι",701598,179],["εἰς",704105,0],["Αἴγυπτον",700401,9]],"Would we had died in the land of Egypt! or in this wilderness, would we had died! and why does the Lord bring us into this land to fall in war? our wives and our children shall be for a prey: now then it is better to return into Egypt."],["4",[["καὶ",707031,7],["εἶπαν",705373,150],["ἕτερος",705535,14],["τῷ",709436,113],["ἑτέρῳ",705535,30],["δῶμεν",703654,79],["ἀρχηγὸν",701838,6],["καὶ",707031,7],["ἀποστρέψωμεν",701598,79],["εἰς",704105,0],["Αἴγυπτον",700401,9]],"And they said one to another, Let us make a ruler, and return into Egypt."],["5",[["καὶ",707031,7],["ἔπεσεν",710481,2],["Μωυσῆς",709112,4],["καὶ",707031,7],["Ααρων",700005,4],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["ἐναντίον",704654,0],["πάσης",710177,82],["συναγωγῆς",712376,17],["υἱῶν",713075,81],["Ισραηλ",706839,18]],"And Moses and Aaron fell upon their face before all the congregation of the children of Israel."],["6",[["Ἰησοῦς",706701,4],["δὲ",703303,11],["ὁ",709436,3],["τοῦ",709436,35],["Ναυη",709206,18],["καὶ",707031,7],["Χαλεβ",713680,4],["ὁ",709436,3],["τοῦ",709436,35],["Ιεφοννη",706687,18],["τῶν",709436,80],["κατασκεψαμένων",707418,490],["τὴν",709436,8],["γῆν",703083,9],["διέρρηξαν",703565,150],["τὰ",709436,41],["ἱμάτια",706742,42],["αὐτῶν",702165,40]],"But Joshua the [son] of Naue, and Chaleb the [son] of Jephonne, of [the number of] them that spied out the land, rent their garments,"],["7",[["καὶ",707031,7],["εἶπαν",705373,150],["πρὸς",710844,0],["πᾶσαν",710177,36],["συναγωγὴν",712376,9],["υἱῶν",713075,81],["Ισραηλ",706839,18],["λέγοντες",708124,146],["ἡ",709436,10],["γῆ",703083,12],["ἣν",709781,131],["κατεσκεψάμεθα",707418,316],["αὐτήν",702165,104],["ἀγαθή",700106,29],["ἐστιν",704093,91],["σφόδρα",712586,28],["σφόδρα",712586,28]],"and spoke to all the congregation of the children of Israel, saying, The land which we surveyed is indeed extremely good."],["8",[["εἰ",704071,7],["αἱρετίζει",700469,91],["ἡμᾶς",705981,194],["κύριος",707996,4],["εἰσάξει",704107,127],["ἡμᾶς",705981,194],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104],["καὶ",707031,7],["δώσει",703654,127],["αὐτὴν",702165,104],["ἡμῖν",705994,90],["γῆ",703083,12],["ἥτις",709793,412],["ἐστὶν",704093,91],["ῥέουσα",711241,188],["γάλα",702919,25],["καὶ",707031,7],["μέλι",708700,25]],"If the Lord choose us, he will bring us into this land, and give it us; a land which flows with milk and honey."],["9",[["ἀλλὰ",700680,7],["ἀπὸ",701425,0],["τοῦ",709436,35],["κυρίου",707996,18],["μὴ",708851,28],["ἀποστάται",701590,52],["γίνεσθε",703104,73],["ὑμεῖς",713081,219],["δὲ",703303,11],["μὴ",708851,28],["φοβηθῆτε",713532,372],["τὸν",709436,5],["λαὸν",708094,6],["τῆς",709436,16],["γῆς",703083,17],["ὅτι",709803,7],["κατάβρωμα",707217,25],["ἡμῖν",705994,90],["ἐστιν",704093,91],["ἀφέστηκεν",702214,171],["γὰρ",702963,11],["ὁ",709436,3],["καιρὸς",707047,4],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["ὁ",709436,3],["δὲ",703303,11],["κύριος",707996,4],["ἐν",704639,0],["ἡμῖν",705994,90],["μὴ",708851,28],["φοβηθῆτε",713532,394],["αὐτούς",702165,62]],"Only depart not from the Lord; and fear ye not the people of the land, for they are meat for us; for the season [of prosperity] is departed from them, but the Lord [is] among us: fear them not."],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["πᾶσα",710177,29],["ἡ",709436,10],["συναγωγὴ",712376,12],["καταλιθοβολῆσαι",707311,106],["αὐτοὺς",702165,62],["ἐν",704639,0],["λίθοις",708196,148],["καὶ",707031,7],["ἡ",709436,10],["δόξα",703791,12],["κυρίου",707996,18],["ὤφθη",709725,37],["ἐν",704639,0],["νεφέλῃ",709277,1],["ἐπὶ",705080,0],["τῆς",709436,16],["σκηνῆς",711845,17],["τοῦ",709436,20],["μαρτυρίου",708525,21],["ἐν",704639,0],["πᾶσι",710177,230],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18]],"And all the congregation bade stone them with stones; and the glory of the Lord appeared in the cloud on the tabernacle of witness to all the children of Israel."],["11",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["ἕως",705792,0],["τίνος",712867,340],["παροξύνει",710164,91],["με",708618,163],["ὁ",709436,3],["λαὸς",708094,4],["οὗτος",709858,121],["καὶ",707031,7],["ἕως",705792,0],["τίνος",712867,340],["οὐ",709805,28],["πιστεύουσίν",710483,197],["μοι",708974,159],["ἐν",704639,0],["πᾶσιν",710177,94],["τοῖς",709436,95],