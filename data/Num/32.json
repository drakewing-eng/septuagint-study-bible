[["1",[["καὶ",707031,7],["κτήνη",707934,64],["πλῆθος",710529,15],["ἦν",704093,13],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ρουβην",711295,18],["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["Γαδ",702872,18],["πλῆθος",710529,25],["σφόδρα",712586,28],["καὶ",707031,7],["εἶδον",709725,150],["τὴν",709436,8],["χώραν",714011,9],["Ιαζηρ",706382,18],["καὶ",707031,7],["τὴν",709436,8],["χώραν",714011,9],["Γαλααδ",702920,118],["καὶ",707031,7],["ἦν",704093,13],["ὁ",709436,3],["τόπος",712903,4],["τόπος",712903,4],["κτήνεσιν",707934,96]],"And the children of Ruben and the children of Gad had a multitude of cattle, very great; and they saw the land of Jazer, and the land of Galaad; and the place was a place for cattle:"],["2",[["καὶ",707031,7],["προσελθόντες",710890,196],["οἱ",709436,136],["υἱοὶ",713075,52],["Ρουβην",711295,18],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["Γαδ",702872,18],["εἶπαν",705373,150],["πρὸς",710844,0],["Μωυσῆν",709112,6],["καὶ",707031,7],["πρὸς",710844,0],["Ελεαζαρ",704407,6],["τὸν",709436,5],["ἱερέα",706614,6],["καὶ",707031,7],["πρὸς",710844,0],["τοὺς",709436,58],["ἄρχοντας",701862,57],["τῆς",709436,16],["συναγωγῆς",712376,17],["λέγοντες",708124,146]],"and the children of Ruben and the children of Gad came, and spoke to Moses, and to Eleazar the priest, and to the princes of the congregation, saying,"],["3",[["Αταρωθ",702075,4],["καὶ",707031,7],["Δαιβων",703247,4],["καὶ",707031,7],["Ιαζηρ",706382,4],["καὶ",707031,7],["Ναμβρα",709182,4],["καὶ",707031,7],["Εσεβων",705473,4],["καὶ",707031,7],["Ελεαλη",704409,4],["καὶ",707031,7],["Σεβαμα",711600,4],["καὶ",707031,7],["Ναβαυ",709137,4],["καὶ",707031,7],["Βαιαν",702384,4]],"Ataroth, and Dæbon, and Jazer, and Namra, and Esebon, and Eleale, and Sebama, and Nabau, and Bæan,"],["4",[["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["παρέδωκεν",710014,2],["κύριος",707996,4],["ἐνώπιον",704823,0],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["γῆ",703083,12],["κτηνοτρόφος",707935,14],["ἐστίν",704093,91],["καὶ",707031,7],["τοῖς",709436,147],["παισίν",709932,148],["σου",711945,133],["κτήνη",707934,42],["ὑπάρχει",713104,91]],"the land which the Lord has delivered up before the children of Israel, is pasture land, and thy servants have cattle."],["5",[["καὶ",707031,7],["ἔλεγον",708124,137],["εἰ",704071,7],["εὕρομεν",705676,289],["χάριν",713735,9],["ἐνώπιόν",704823,0],["σου",711945,133],["δοθήτω",703654,22],["ἡ",709436,10],["γῆ",703083,12],["αὕτη",709858,107],["τοῖς",709436,147],["οἰκέταις",709496,148],["σου",711945,133],["ἐν",704639,0],["κατασχέσει",707451,1],["καὶ",707031,7],["μὴ",708851,28],["διαβιβάσῃς",703424,175],["ἡμᾶς",705981,194],["τὸν",709436,5],["Ιορδάνην",706763,6]],"And they said, If we have found grace in thy sight, let this land be given to thy servants for a possession, and do not cause us to pass over Jordan."],["6",[["καὶ",707031,7],["εἶπεν",705373,2],["Μωυσῆς",709112,4],["τοῖς",709436,147],["υἱοῖς",713075,148],["Γαδ",702872,18],["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ρουβην",711295,18],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["ὑμῶν",713091,145],["πορεύονται",710667,269],["εἰς",704105,0],["πόλεμον",710605,6],["καὶ",707031,7],["ὑμεῖς",713081,219],["καθήσεσθε",707007,124],["αὐτοῦ",702165,102]],"And Moses said to the sons of Gad and the sons of Ruben, Shall your brethren go to war, and shall ye sit here?"],["7",[["καὶ",707031,7],["ἵνα",706747,7],["τί",712867,126],["διαστρέφετε",703592,87],["τὰς",709436,38],["διανοίας",703531,39],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["μὴ",708851,28],["διαβῆναι",703419,106],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["κύριος",707996,4],["δίδωσιν",703654,91],["αὐτοῖς",702165,151]],"And why do ye pervert the minds of the children of Israel, that they should not cross over into the land, which the Lord gives them?"],["8",[["οὐχ",709805,28],["οὕτως",709859,28],["ἐποίησαν",710582,150],["οἱ",709436,136],["πατέρες",710189,52],["ὑμῶν",713091,145],["ὅτε",709802,28],["ἀπέστειλα",701592,155],["αὐτοὺς",702165,62],["ἐκ",704132,0],["Καδης",706973,18],["Βαρνη",702541,18],["κατανοῆσαι",707341,106],["τὴν",709436,8],["γῆν",703083,9]],"Did not your fathers thus, when I sent them from Cades Barne to spy out the land?"],["9",[["καὶ",707031,7],["ἀνέβησαν",700905,150],["Φάραγγα",713351,9],["βότρυος",702775,18],["καὶ",707031,7],["κατενόησαν",707341,150],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἀπέστησαν",702214,150],["τὴν",709436,8],["καρδίαν",707141,9],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ὅπως",709719,7],["μὴ",708851,28],["εἰσέλθωσιν",704114,234],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["ἔδωκεν",703654,2],["κύριος",707996,4],["αὐτοῖς",702165,151]],"and they went up to the valley of the cluster, and spied the land, and turned aside the heart of the children of Israel, that they should not go into the land, which the Lord gave them."],["10",[["καὶ",707031,7],["ὠργίσθη",709729,37],["θυμῷ",706334,114],["κύριος",707996,4],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["καὶ",707031,7],["ὤμοσεν",709620,2],["λέγων",708124,72]],"And the Lord was very angry in that day, and sware, saying,"],["11",[["εἰ",704071,7],["ὄψονται",709725,135],["οἱ",709436,136],["ἄνθρωποι",701163,52],["οὗτοι",709858,201],["οἱ",709436,136],["ἀναβάντες",700905,196],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["ἀπὸ",701425,0],["εἰκοσαετοῦς",704084,116],["καὶ",707031,7],["ἐπάνω",705030,28],["οἱ",709436,136],["ἐπιστάμενοι",705264,348],["τὸ",709436,24],["κακὸν",707066,46],["καὶ",707031,7],["τὸ",709436,24],["ἀγαθὸν",700106,46],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["ὤμοσα",709620,155],["τῷ",709436,113],["Αβρααμ",700091,114],["καὶ",707031,7],["Ισαακ",706799,114],["καὶ",707031,7],["Ιακωβ",706401,114],["οὐ",709805,28],["γὰρ",702963,11],["συνεπηκολούθησαν",712449,150],["ὀπίσω",709697,0],["μου",709032,133]],"Surely these men who came up out of Egypt from twenty years old and upward, who know good and evil, shall not see the land which I sware [to give] to Abraam and Isaac and Jacob, for they have not closely followed after me:"],["12",[["πλὴν",710540,28],["Χαλεβ",713680,4],["υἱὸς",713075,4],["Ιεφοννη",706687,18],["ὁ",709436,3],["διακεχωρισμένος",703640,419],["καὶ",707031,7],["Ἰησοῦς",706701,4],["ὁ",709436,3],["τοῦ",709436,35],["Ναυη",709206,18],["ὅτι",709803,7],["συνεπηκολούθησεν",712449,2],["ὀπίσω",709697,0],["κυρίου",707996,18]],"save Caleb the son of Jephonne, who was set apart, and Joshua the son of Naue, for they closely followed after the Lord."],["13",[["καὶ",707031,7],["ὠργίσθη",709729,37],["θυμῷ",706334,114],["κύριος",707996,4],["ἐπὶ",705080,0],["τὸν",709436,5],["Ισραηλ",706839,6],["καὶ",707031,7],["κατερρόμβευσεν",707403,2],["αὐτοὺς",702165,62],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["τεσσαράκοντα",712806,59],["ἔτη",705543,42],["ἕως",705792,7],["ἐξανηλώθη",704861,37],["πᾶσα",710177,29],["ἡ",709436,10],["γενεὰ",703037,12],["οἱ",709436,136],["ποιοῦντες",710582,146],["τὰ",709436,41],["πονηρὰ",710660,68],["ἔναντι",704653,0],["κυρίου",707996,18]],"And the Lord was very angry with Israel; and for forty years he caused them to wander in the wilderness, until all the generation which did evil in the sight of the Lord was extinct."],["14",[["ἰδοὺ",706497,88],["ἀνέστητε",701173,265],["ἀντὶ",701227,0],["τῶν",709436,80],["πατέρων",710189,81],["ὑμῶν",713091,145],["σύστρεμμα",712561,15],["ἀνθρώπων",701163,81],["ἁμαρτωλῶν",700776,169],["προσθεῖναι",710965,106],["ἔτι",705538,28],["ἐπὶ",705080,0],["τὸν",709436,5],["θυμὸν",706334,6],["τῆς",709436,16],["ὀργῆς",709728,17],["κυρίου",707996,18],["ἐπὶ",705080,0],["Ισραηλ",706839,6]],"Behold, ye are risen up in the room of your fathers, a combination of sinful men, to increase yet farther the fierce wrath of the Lord against Israel."],["15",[["ὅτι",709803,7],["ἀποστραφήσεσθε",701598,261],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["προσθεῖναι",710965,106],["ἔτι",705538,28],["καταλ