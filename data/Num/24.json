[["1",[["καὶ",707031,7],["ἰδὼν",709725,182],["Βαλααμ",702468,4],["ὅτι",709803,7],["καλόν",707097,46],["ἐστιν",704093,91],["ἔναντι",704653,0],["κυρίου",707996,18],["εὐλογεῖν",705631,55],["τὸν",709436,5],["Ισραηλ",706839,6],["οὐκ",709805,28],["ἐπορεύθη",710667,37],["κατὰ",707200,0],["τὸ",709436,24],["εἰωθὸς",704070,409],["εἰς",704105,0],["συνάντησιν",712397,9],["τοῖς",709436,147],["οἰωνοῖς",709545,148],["καὶ",707031,7],["ἀπέστρεψεν",701598,2],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὴν",709436,8],["ἔρημον",705420,9]],"And when Balaam saw that it pleased God to bless Israel, he did not go according to his custom to meet the omens, but turned his face toward the wilderness."],["2",[["καὶ",707031,7],["ἐξάρας",704839,182],["Βαλααμ",702468,4],["τοὺς",709436,58],["ὀφθαλμοὺς",709870,57],["αὐτοῦ",702165,102],["καθορᾷ",707019,91],["τὸν",709436,5],["Ισραηλ",706839,6],["ἐστρατοπεδευκότα",712150,427],["κατὰ",707200,0],["φυλάς",713620,39],["καὶ",707031,7],["ἐγένετο",703104,23],["πνεῦμα",710566,15],["θεοῦ",706192,18],["ἐν",704639,0],["αὐτῷ",702165,50]],"And Balaam lifted up his eyes, and sees Israel encamped by their tribes; and the Spirit of God came upon him."],["3",[["καὶ",707031,7],["ἀναλαβὼν",700984,182],["τὴν",709436,8],["παραβολὴν",710003,9],["αὐτοῦ",702165,102],["εἶπεν",705373,2],["φησὶν",713437,91],["Βαλααμ",702468,4],["υἱὸς",713075,4],["Βεωρ",702671,18],["φησὶν",713437,91],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ὁ",709436,3],["ἀληθινῶς",700660,28],["ὁρῶν",709725,72]],"And he took up his parable and said, Balaam son of Beor says, the man who sees truly says,"],["4",[["φησὶν",713437,91],["ἀκούων",700587,72],["λόγια",708233,42],["θεοῦ",706192,18],["ὅστις",709793,425],["ὅρασιν",709721,9],["θεοῦ",706192,18],["εἶδεν",709725,2],["ἐν",704639,0],["ὕπνῳ",713181,114],["ἀποκεκαλυμμένοι",701474,429],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["αὐτοῦ",702165,102]],"he says who hears the oracle of the Mighty One, who saw a vision of God in sleep; his eyes were opened:"],["5",[["ὡς",714148,7],["καλοί",707097,138],["σου",711945,133],["οἱ",709436,136],["οἶκοι",709516,52],["Ιακωβ",706401,153],["αἱ",709436,190],["σκηναί",711845,191],["σου",711945,133],["Ισραηλ",706839,153]],"How goodly [are] thy habitations, Jacob, and thy tents, Israel!"],["6",[["ὡσεὶ",714159,28],["νάπαι",709193,191],["σκιάζουσαι",711855,306],["καὶ",707031,7],["ὡσεὶ",714159,28],["παράδεισοι",710012,52],["ἐπὶ",705080,0],["ποταμῶν",710693,81],["καὶ",707031,7],["ὡσεὶ",714159,28],["σκηναί",711845,191],["ἃς",709781,193],["ἔπηξεν",710452,2],["κύριος",707996,4],["ὡσεὶ",714159,28],["κέδροι",707590,191],["παρ᾿",709995,0],["ὕδατα",713071,42]],"as shady groves, and as gardens by a river, and as tents which God pitched, and as cedars by the waters."],["7",[["ἐξελεύσεται",704909,93],["ἄνθρωπος",701163,4],["ἐκ",704132,0],["τοῦ",709436,20],["σπέρματος",712008,21],["αὐτοῦ",702165,102],["καὶ",707031,7],["κυριεύσει",707995,127],["ἐθνῶν",704068,44],["πολλῶν",710646,169],["καὶ",707031,7],["ὑψωθήσεται",713289,134],["ἢ",705924,7],["Γωγ",703213,227],["βασιλεία",702577,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["αὐξηθήσεται",702144,134],["ἡ",709436,10],["βασιλεία",702577,12],["αὐτοῦ",702165,102]],"There shall come a man out of his seed, and he shall rule over many nations; and the kingdom of Gog shall be exalted, and his kingdom shall be increased."],["8",[["θεὸς",706192,4],["ὡδήγησεν",709448,2],["αὐτὸν",702165,85],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["ὡς",714148,7],["δόξα",703791,12],["μονοκέρωτος",708999,18],["αὐτῷ",702165,50],["ἔδεται",705495,93],["ἔθνη",704068,42],["ἐχθρῶν",705779,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["πάχη",710204,42],["αὐτῶν",702165,40],["ἐκμυελιεῖ",704262,127],["καὶ",707031,7],["ταῖς",709436,75],["βολίσιν",702756,76],["αὐτοῦ",702165,102],["κατατοξεύσει",707462,127],["ἐχθρόν",705779,6]],"God led him out of Egypt; he has as it were the glory of a unicorn: he shall consume the nations of his enemies, and he shall drain their marrow, and with his darts he shall shoot through the enemy."],["9",[["κατακλιθεὶς",707276,217],["ἀνεπαύσατο",701027,23],["ὡς",714148,7],["λέων",708171,4],["καὶ",707031,7],["ὡς",714148,7],["σκύμνος",711903,4],["τίς",712867,158],["ἀναστήσει",701173,127],["αὐτόν",702165,85],["οἱ",709436,136],["εὐλογοῦντές",705631,146],["σε",711598,163],["εὐλόγηνται",705631,255],["καὶ",707031,7],["οἱ",709436,136],["καταρώμενοί",707396,348],["σε",711598,163],["κεκατήρανται",707396,255]],"He lay down, he rested as a lion, and as a young lion; who shall stir him up? they that bless thee are blessed, and they that curse thee are cursed."],["10",[["καὶ",707031,7],["ἐθυμώθη",706335,37],["Βαλακ",702474,4],["ἐπὶ",705080,0],["Βαλααμ",702468,114],["καὶ",707031,7],["συνεκρότησεν",712235,2],["ταῖς",709436,75],["χερσὶν",713787,76],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["Βαλακ",702474,4],["πρὸς",710844,0],["Βαλααμ",702468,6],["καταρᾶσθαι",707396,110],["τὸν",709436,5],["ἐχθρόν",705779,6],["μου",709032,133],["κέκληκά",707084,89],["σε",711598,163],["καὶ",707031,7],["ἰδοὺ",706497,88],["εὐλογῶν",705631,72],["εὐλόγησας",705631,162],["τρίτον",712968,46],["τοῦτο",709858,129]],"And Balac was angry with Balaam, and clapped his hands together; and Balac said to Balaam, I called thee to curse my enemy, and behold thou hast decidedly blessed [him] this third time."],["11",[["νῦν",709384,28],["οὖν",709835,11],["φεῦγε",713433,240],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["σου",711945,133],["εἶπα",705373,155],["τιμήσω",712855,165],["σε",711598,163],["καὶ",707031,7],["νῦν",709384,28],["ἐστέρησέν",712076,2],["σε",711598,163],["κύριος",707996,4],["τῆς",709436,16],["δόξης",703791,17]],"Now therefore flee to thy place: I said, I will honour thee, but now the Lord has deprived thee of glory."],["12",[["καὶ",707031,7],["εἶπεν",705373,2],["Βαλααμ",702468,4],["πρὸς",710844,0],["Βαλακ",702474,6],["οὐχὶ",709862,28],["καὶ",707031,7],["τοῖς",709436,147],["ἀγγέλοις",700140,148],["σου",711945,133],["οὓς",709781,298],["ἀπέστειλας",701592,162],["πρός",710844,0],["με",708618,163],["ἐλάλησα",708071,155],["λέγων",708124,72]],"And Balaam said to Balac, Did I not speak to thy messengers also whom thou sentest to me, saying,"],["13",[["ἐάν",703912,7],["μοι",708974,159],["δῷ",703654,172],["Βαλακ",702474,4],["πλήρη",710541,68],["τὸν",709436,5],["οἶκον",709516,6],["αὐτοῦ",702165,102],["ἀργυρίου",701707,21],["καὶ",707031,7],["χρυσίου",713972,21],["οὐ",709805,28],["δυνήσομαι",703838,181],["παραβῆναι",709996,106],["τὸ",709436,24],["ῥῆμα",711246,25],["κυρίου",707996,18],["ποιῆσαι",710582,106],["αὐτὸ",702165,129],["πονηρὸν",710660,46],["ἢ",705924,7],["καλὸν",707097,46],["παρ᾿",709995,0],["ἐμαυτοῦ",704545,102],["ὅσα",709788,68],["ἐὰν",703912,7],["εἴπῃ",705373,172],["ὁ",709436,3],["θεός",706192,4],["ταῦτα",709858,71],["ἐρῶ",705415,165]],"If Balac should give me his house full of silver and gold, I shall not be able to transgress the word of the Lord to make it good or bad by myself; whatsoever things God shall say, them will I speak."],["14",[["καὶ",707031,7],["νῦν",709384,28],["ἰδοὺ",706497,88],["ἀποτρέχω",701623,157],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["μου",709032,133],["δεῦρο",703382,28],["συμβουλεύσω",712292,165],["σοι",711925,159],["τί",712867,126],["ποιήσει",710582,127],["ὁ",709436,3],["λαὸς",708094,4],["οὗτος",709858,121],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133],["ἐπ᾿",705080,0],["ἐσχάτου",705519,92],["τῶν",709436,130],["ἡμερῶν",705984,65]],"And now, behold, I return to my place; come, I will advise thee of what this people shall do to thy people in the last days."],["15",[["καὶ",707031,7],["ἀναλαβὼν",700984,182],["τὴν",709436,8],["παραβολὴν",710003,9],["αὐτοῦ",702165,102],["εἶπεν",705373,2],["φησὶν",713437,91],["Βαλααμ",702468,4],["υἱὸς",713075,4],["Βεωρ",702671,18],["φησὶν",713437,91],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ὁ",709436,3],["ἀληθινῶς",700660,28],["ὁρῶν",709725,72]],"And he took up his parable and said, Balaam the son of Beor says, the man who sees truly says,",{"s":"d","q":0.31}],["16",[["ἀκούων",700587,72],["λόγια",708233,42],["θεοῦ",706192,18],["ἐπιστάμενος",705264,122],["ἐπιστήμην",705267,9],["παρὰ",709995,0],["ὑψίστου",713287,116],["καὶ",707031,7],["ὅρασιν",709721,9],["θεοῦ",706192,18],["ἰδὼν",709725,182],["ἐν",704639,0],["ὕπνῳ",713181,114],["ἀποκεκαλυμμένοι",701474,429],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["αὐτοῦ",702165,102]],"hearing the oracles of God, receiving knowledge from the Most High, and having seen a vision of God in sleep; his eyes were opened."],["17",[["δείξω",703314,165],["αὐτῷ",702165,50],["καὶ",707031,7],["οὐχὶ",709862,28],["νῦν",709384,28],["μακαρίζω",708396,157],["καὶ",707031,7],["οὐκ",709805,28],["ἐγγίζει",703939,91],["ἀνατελεῖ",701066,127],["ἄστρον",702024,25],["ἐξ",704132,0],["Ιακωβ",706401,18],["καὶ",707031,7],["ἀναστήσεται",701173,93],["ἄνθρωπος",701163,4],["ἐξ",704132,0],["Ισραηλ",706839,18],["καὶ",707031,7],["θραύσει",706304,127],["τοὺς",709436,58],["ἀρχηγοὺς",701838,57],["Μωαβ",709085,18],["καὶ",707031,7],["προνομεύσει",710826,127],["πάντας",710177,60],["υἱοὺς",713075,57],["Σηθ",711733,18]],"I will point to him, but not now; I bless him, but he draws not near: a star shall rise out of Jacob, a man shall spring out of Israel; and shall crush the princes of Moab, and shall spoil all the sons of Seth."],["18",[["καὶ",707031,7],["ἔσται",704093,93],["Εδωμ",704041,120],["κληρονομία",707725,12],["καὶ",707031,7],["ἔσται",704093,93],["κληρονομία",707725,12],["Ησαυ",706030,4],["ὁ",709436,3],["ἐχθρὸς",705779,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["Ισραηλ",706839,4],["ἐποίησεν",710582,2],["ἐν",704639,0],["ἰσχύι",706858,1]],"And Edom shall be an inheritance, and Esau his enemy shall be an inheritance [of Israel], and Israel wrought valiantly."],["19",[["καὶ",707031,7],["ἐξεγερθήσεται",704889,134],["ἐξ",704132,0],["Ιακωβ",706401,18],["καὶ",707031,7],["ἀπολεῖ",701513,127],["σῳζόμενον",712627,212],["ἐκ",704132,0],["πόλεως",710612,17]],"And [one] shall arise out of Jacob, and destroy out of the city him that escapes."],["20",[["καὶ",707031,7],["ἰδὼν",709725,182],["τὸν",709436,5],["Αμαληκ",700759,6],["καὶ",707031,7],["ἀναλαβὼν",700984,182],["τὴν",709436,8],["παραβολὴν",710003,9],["αὐτοῦ",702165,102],["εἶπεν",705373,2],["ἀρχὴ",701836,12],["ἐθνῶν",704068,44],["Αμαληκ",700759,4],["καὶ",707031,7],["τὸ",709436,24],["σπέρμα",712008,15],["αὐτῶν",702165,40],["ἀπολεῖται",701513,93]],"And having seen Amalec, he took up his parable and said, Amalec [is] the first of the nations; yet his seed shall perish."],["21",[["καὶ",707031,7],["ἰδὼν",709725,182],["τὸν",709436,5],["Καιναῖον",707037,6],["καὶ",707031,7],["ἀναλαβὼν",700984,182],["τὴν",709436,8],["παραβολὴν",710003,9],["αὐτοῦ",702165,102],["εἶπεν",705373,2],["ἰσχυρὰ",706855,68],["ἡ",709436,10],["κατοικία",707537,12],["σου",711945,133],["καὶ",707031,7],["ἐὰν",703912,7],["θῇς",712849,175],["ἐν",704639,0],["πέτρᾳ",710443,1],["τὴν",709436,8],["νοσσιάν",709360,9],["σου",711945,133]],"And having seen the Kenite, he took up his parable and said, Thy dwelling-place [is] strong; yet though thou shouldest put thy nest in a rock,"],["22",[["καὶ",707031,7],["ἐὰν",703912,7],["γένηται",703104,239],["τῷ",709436,113],["Βεωρ",702671,114],["νεοσσιὰ",709360,12],["πανουργίας",709971,17],["Ἀσσύριοί",702004,52],["σε",711598,163],["αἰχμαλωτεύσουσιν",700500,218]],"and though Beor should have a skilfully contrived hiding-place, the Assyrians shall carry thee away captive."],["23",[["καὶ",707031,7],["ἰδὼν",709725,182],["τὸν",709436,5],["Ωγ",714088,6],["καὶ",707031,7],["ἀναλαβὼν",700984,182],["τὴν",709436,8],["παραβολὴν",710003,9],["αὐτοῦ",702165,102],["εἶπεν",705373,2],["ὦ",714081,88],["ὦ",714081,88],["τίς",712867,158],["ζήσεται",705851,93],["ὅταν",709801,28],["θῇ",712849,172],["ταῦτα",709858,71],["ὁ",709436,3],["θεός",706192,4]],"And he looked upon Og, and took up his parable and said, Oh, oh, who shall live, when God shall do these things?"],["24",[["καὶ",707031,7],["ἐξελεύσεται",704909,93],["ἐκ",704132,0],["χειρὸς",713787,17],["Κιτιαίων",707696,81],["καὶ",707031,7],["κακώσουσιν",707073,218],["Ασσουρ",702001,227],["καὶ",707031,7],["κακώσουσιν",707073,218],["Εβραίους",703933,57],["καὶ",707031,7],["αὐτοὶ",702165,201],["ὁμοθυμαδὸν",709624,28],["ἀπολοῦνται",701513,135]],"And one shall come forth from the hands of the Citians, and shall afflict Assur, and shall afflict the Hebrews, and they shall perish together."],["25",[["καὶ",707031,7],["ἀναστὰς",701173,182],["Βαλααμ",702468,4],["ἀπῆλθεν",701398,2],["ἀποστραφεὶς",701598,217],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["Βαλακ",702474,4],["ἀπῆλθεν",701398,2],["πρὸς",710844,0],["ἑαυτόν",703917,85]],"And Balaam rose up and departed and returned to his place, and Balac went to his own home."]]