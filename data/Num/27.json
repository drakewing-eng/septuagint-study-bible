ν",700775,9],["αὐτοῦ",702165,102],["ἀπέθανεν",701461,2],["καὶ",707031,7],["υἱοὶ",713075,52],["οὐκ",709805,28],["ἐγένοντο",703104,189],["αὐτῷ",702165,50]],"Our father died in the wilderness, and he was not in the midst of the congregation that rebelled against the Lord in the gathering of Core; for he died for his own sin, and he had no sons. Let not the name of our father be blotted out of the midst of his people, because he has no son: give us an inheritance in the midst of our father's brethren."],["4",[["μὴ",708851,28],["ἐξαλειφθήτω",704852,22],["τὸ",709436,24],["ὄνομα",709666,25],["τοῦ",709436,35],["πατρὸς",710189,18],["ἡμῶν",705999,145],["ἐκ",704132,0],["μέσου",708768,116],["τοῦ",709436,35],["δήμου",703411,18],["αὐτοῦ",702165,102],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["αὐτῷ",702165,50],["υἱός",713075,4],["δότε",703654,74],["ἡμῖν",705994,90],["κατάσχεσιν",707451,9],["ἐν",704639,0],["μέσῳ",708768,30],["ἀδελφῶν",700249,81],["πατρὸς",710189,18],["ἡμῶν",705999,145]],"And Moses brought their case before the Lord."],["5",[["καὶ",707031,7],["προσήγαγεν",710848,2],["Μωυσῆς",709112,4],["τὴν",709436,8],["κρίσιν",707908,9],["αὐτῶν",702165,40],["ἔναντι",704653,0],["κυρίου",707996,18]],"And the Lord spoke to Moses, saying,"],["6",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"The daughters of Salpaad have spoken rightly: thou shalt surely give them a possession of inheritance in the midst of their father's brethren, and thou shalt assign their father's inheritance to them."],["7",[["ὀρθῶς",709746,28],["θυγατέρες",706320,191],["Σαλπααδ",711423,18],["λελαλήκασιν",708071,353],["δόμα",703789,25],["δώσεις",703654,166],["αὐταῖς",702165,200],["κατάσχεσιν",707451,9],["κληρονομίας",707725,17],["ἐν",704639,0],["μέσῳ",708768,30],["ἀδελφῶν",700249,81],["πατρὸς",710189,18],["αὐτῶν",702165,284],["καὶ",707031,7],["περιθήσεις",710403,166],["τὸν",709436,5],["κλῆρον",707727,6],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτῶν",702165,284],["αὐταῖς",702165,200]],"And thou shalt speak to the children of Israel, saying,"],["8",[["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["λαλήσεις",708071,166],["λέγων",708124,72],["ἄνθρωπος",701163,4],["ἐὰν",703912,7],["ἀποθάνῃ",701461,172],["καὶ",707031,7],["υἱὸς",713075,4],["μὴ",708851,28],["ᾖ",704093,204],["αὐτῷ",702165,50],["περιθήσετε",710403,337],["τὴν",709436,8],["κληρονομίαν",707725,9],["αὐτοῦ",702165,102],["τῇ",709436,100],["θυγατρὶ",706320,1],["αὐτοῦ",702165,102]],"If a man die, and have no son, ye shall assign his inheritance to his daughter."],["9",[["ἐὰν",703912,7],["δὲ",703303,11],["μὴ",708851,28],["ᾖ",704093,204],["θυγάτηρ",706320,12],["αὐτῷ",702165,50],["δώσετε",703654,337],["τὴν",709436,8],["κληρονομίαν",707725,9],["τῷ",709436,113],["ἀδελφῷ",700249,114],["αὐτοῦ",702165,102]],"And if he have no daughter, ye shall give his inheritance to his brother."],["10",[["ἐὰν",703912,7],["δὲ",703303,11],["μὴ",708851,28],["ὦσιν",704093,271],["αὐτῷ",702165,50],["ἀδελφοί",700249,52],["δώσετε",703654,337],["τὴν",709436,8],["κληρονομίαν",707725,9],["τῷ",709436,113],["ἀδελφῷ",700249,114],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102]],"And if he have no brethren, ye shall give his inheritance to his father's brother."],["11",[["ἐὰν",703912,7],["δὲ",703303,11],["μὴ",708851,28],["ὦσιν",704093,271],["ἀδελφοὶ",700249,52],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["δώσετε",703654,337],["τὴν",709436,8],["κληρονομίαν",707725,9],["τῷ",709436,113],["οἰκείῳ",709493,30],["τῷ",709436,113],["ἔγγιστα",703948,28],["αὐτοῦ",702165,102],["ἐκ",704132,0],["τῆς",709436,16],["φυλῆς",713620,17],["αὐτοῦ",702165,102],["κληρονομήσει",707724,127],["τὰ",709436,41],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔσται",704093,93],["τοῦτο",709858,132],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["δικαίωμα",703697,15],["κρίσεως",707908,17],["καθὰ",706979,28],["συνέταξεν",712508,2],["κύριος",707996,4],["τῷ",709436,113],["Μωυσῇ",709112,114]],"And if there be no brethren of his father, ye shall give the inheritance to his nearest relation of his tribe, to inherit his possessions; and this shall be to the children of Israel an ordinance of judgment, as the Lord commanded Moses."],["12",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["ἀνάβηθι",700905,176],["εἰς",704105,0],["τὸ",709436,24],["ὄρος",709768,25],["τὸ",709436,24],["ἐν",704639,0],["τῷ",709436,53],["πέραν",710280,28],["τοῦτο",709858,132],["ὄρος",709768,15],["Ναβαυ",709137,120],["καὶ",707031,7],["ἰδὲ",709725,176],["τὴν",709436,8],["γῆν",703083,9],["Χανααν",713708,118],["ἣν",709781,131],["ἐγὼ",704018,164],["δίδωμι",703654,157],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["ἐν",704639,0],["κατασχέσει",707451,1]],"And the Lord said to Moses, Go up to the mountain that is in the country beyond Jordan, this mount Nabau, and behold the land Chanaan, which I give to the sons of Israel for a possession."],["13",[["καὶ",707031,7],["ὄψει",709725,123],["αὐτὴν",702165,104],["καὶ",707031,7],["προστεθήσῃ",710965,364],["πρὸς",710844,0],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133],["καὶ",707031,7],["σύ",712181,164],["καθὰ",706979,28],["προσετέθη",710965,37],["Ααρων",700005,4],["ὁ",709436,3],["ἀδελφός",700249,4],["σου",711945,133],["ἐν",704639,0],["Ωρ",714127,111],["τῷ",709436,53],["ὄρει",709768,54]],"And thou shalt see it, and thou also shalt be added to thy people, as Aaron thy brother was added [to them] in mount Or:"],["14",[["διότι",703734,7],["παρέβητε",709996,265],["τὸ",709436,24],["ῥῆμά",711246,25],["μου",709032,133],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["Σιν",711793,118],["ἐν",704639,0],["τῷ",709436,53],["ἀντιπίπτειν",701265,55],["τὴν",709436,8],["συναγωγὴν",712376,9],["ἁγιάσαι",700153,106],["με",708618,163],["οὐχ",709805,28],["ἡγιάσατέ",700153,265],["με",708618,163],["ἐπὶ",705080,0],["τῷ",709436,53],["ὕδατι",713071,54],["ἔναντι",704653,0],["αὐτῶν",702165,40],["τοῦτό",709858,129],["ἐστιν",704093,91],["ὕδωρ",713071,15],["ἀντιλογίας",701249,17],["Καδης",706973,118],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["Σιν",711793,118]],"because ye transgressed my commandment in the wilderness of Sin, when the congregation resisted [and refused] to sanctify me; ye sanctified me not at the water before them. This is the water of Strife in Cades in the wilderness of Sin."],["15",[["καὶ",707031,7],["εἶπεν",705373,2],["Μωυσῆς",709112,4],["πρὸς",710844,0],["κύριον",707996,6]],"And Moses said to the Lord,"],["16",[["ἐπισκεψάσθω",705250,315],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,43],["πνευμάτων",710566,44],["καὶ",707031,7],["πάσης",710177,82],["σαρκὸς",711537,17],["ἄνθρωπον",701163,6],["ἐπὶ",705080,0],["τῆς",709436,16],["συναγωγῆς",712376,17],["ταύτης",709858,86]],"Let the Lord God of spirits and of all flesh look out for a man over this congregation,"],["17",[["ὅστις",709793,425],["ἐξελεύσεται",704909,93],["πρὸ",710747,0],["προσώπου",710986,21],["αὐτῶν",702165,40],["καὶ",707031,7],["ὅστις",709793,425],["εἰσελεύσεται",704114,93],["πρὸ",710747,0],["προσώπου",710986,21],["αὐτῶν",702165,40],["καὶ",707031,7],["ὅστις",709793,425],["ἐξάξει",704834,127],["αὐτοὺς",702165,62],["καὶ",707031,7],["ὅστις",709793,425],["εἰσάξει",704107,127],["αὐτούς",702165,62],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ἡ",709436,10],["συναγωγὴ",712376,12],["κυρίου",707996,18],["ὡσεὶ",714159,28],["πρόβατα",710768,42],["οἷς",709781,311],["οὐκ",709805,28],["ἔστιν",704093,91],["ποιμήν",710596,4]],"who shall go out before them, and who shall come in before them, and who shall lead them out, and who shall bring them in; so the congregation of the Lord shall not be as sheep without a shepherd."],["18",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72],["λαβὲ",708076,176],["πρὸς",710844,0],["σεαυτὸν",711599,85],["τὸν",709436,5],["Ἰησοῦν",706701,6],["υἱὸν",713075,6],["Ναυη",709206,18],["ἄνθρωπον",701163,6],["ὃς",709781,213],["ἔχει",705785,91],["πνεῦμα",710566,25],["ἐν",704639,0],["ἑαυτῷ",703917,50],["καὶ",707031,7],["ἐπιθήσεις",705304,166],["τὰς",709436,38],["χεῖράς",713787,39],["σου",711945,133],["ἐπ᾿",705080,0],["αὐτὸν",702165,85]],"And the Lord spoke to Moses, saying, Take to thyself Joshua the son of Naue, a man who has the Spirit in him, and thou shalt lay thy hands upon him."],["19",[["καὶ",707031,7],["στήσεις",706846,166],["αὐτὸν",702165,85],["ἔναντι",704653,0],["Ελεαζαρ",704407,18],["τοῦ",709436,35],["ἱερέως",706614,18],["καὶ",707031,7],["ἐντελῇ",704791,123],["αὐτῷ",702165,50],["ἔναντι",704653,0],["πάσης",710177,82],["συναγωγῆς",712376,17],["καὶ",707031,7],["ἐντελῇ",704791,123],["περὶ",710285,0],["αὐτοῦ",702165,102],["ἐναντίον",704654,0],["αὐτῶν",702165,40]],"And thou shalt set him before Eleazar the priest, and thou shalt give him a charge before all the congregation, and thou shalt give a charge concerning him before them."],["20",[["καὶ",707031,7],["δώσεις",703654,166],["τῆς",709436,16],["δόξης",703791,17],["σου",711945,133],["ἐπ᾿",705080,0],["αὐτόν",702165,85],["ὅπως",709719,7],["ἂν",700900,11],["εἰσακούσωσιν",704108,234],["αὐτοῦ",702165,102],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18]],"And thou shalt put of thy glory upon him, that the children of Israel may hearken to him."],["21",[["καὶ",707031,7],["ἔναντι",704653,0],["Ελεαζαρ",704407,18],["τοῦ",709436,35],["ἱερέως",706614,18],["στήσεται",706846,93],["καὶ",707031,7],["ἐπερωτήσουσιν",705069,218],["αὐτὸν",702165,85],["τὴν",709436,8],["κρίσιν",707908,9],["τῶν",709436,80],["δήλων",703401,169],["ἔναντι",704653,0],["κυρίου",707996,18],["ἐπὶ",705080,0],["τῷ",709436,53],["στόματι",712125,54],["αὐτοῦ",702165,102],["ἐξελεύσονται",704909,135],["καὶ",707031,7],["ἐπὶ",705080,0],["τῷ",709436,53],["στόματι",712125,54],["αὐτοῦ",702165,102],["εἰσελεύσονται",704114,135],["αὐτὸς",702165,121],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["ὁμοθυμαδὸν",709624,28],["καὶ",707031,7],["πᾶσα",710177,29],["ἡ",709436,10],["συναγωγή",712376,12]],"And he shall stand before Eleazar the priest, and they shall ask of him before the Lord the judgment of the Urim: they shall go forth at his word, and at his word they shall come in, he and the children of Israel with one accord, and all the congregation."],["22",[["καὶ",707031,7],["ἐποίησεν",710582,2],["Μωυσῆς",709112,4],["καθὰ",706979,28],["ἐνετείλατο",704791,23],["αὐτῷ",702165,50],["κύριος",707996,4],["καὶ",707031,7],["λαβὼν",708076,182],["τὸν",709436,5],["Ἰησοῦν",706701,6],["ἔστησεν",706846,2],["αὐτὸν",702165,85],["ἐναντίον",704654,0],["Ελεαζαρ",704407,18],["τοῦ",709436,35],["ἱερέως",706614,18],["καὶ",707031,7],["ἔναντι",704653,0],["πάσης",710177,82],["συναγωγῆς",712376,17]],"And Moses did as the Lord commanded him; and he took Joshua, and set him before Eleazar the priest, and before all the congregation."],["23",[["καὶ",707031,7],["ἐπέθηκεν",705304,2],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτοῦ",702165,102],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["καὶ",707031,7],["συνέστησεν",712482,2],["αὐτόν",702165,85],["καθάπερ",706984,28],["συνέταξεν",712508,2],["κύριος",707996,4],["τῷ",709436,113],["Μωυσῇ",709112,114]],"And he laid his hands on him, and appointed him as the Lord ordered Moses."]]