",709436,35],["Βαρνη",702541,18],["καὶ",707031,7],["ἐξελεύσεται",704909,93],["εἰς",704105,0],["ἔπαυλιν",705048,9],["Αραδ",701677,18],["καὶ",707031,7],["παρελεύσεται",710141,93],["Ασεμωνα",701917,1]],"And your border shall go round you from the south to the ascent of Acrabin, and shall proceed by Ennac, and the going forth of it shall be southward to Cades Barne, and it shall go forth to the village of Arad, and shall proceed by Asemona."],["5",[["καὶ",707031,7],["κυκλώσει",707958,127],["τὰ",709436,41],["ὅρια",709749,42],["ἀπὸ",701425,0],["Ασεμωνα",701917,17],["χειμάρρουν",713783,6],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["διέξοδος",703668,12],["ἡ",709436,10],["θάλασσα",706069,12]],"And the border shall compass from Asemona to the river of Egypt, and the sea shall be the termination."],["6",[["καὶ",707031,7],["τὰ",709436,41],["ὅρια",709749,42],["τῆς",709436,16],["θαλάσσης",706069,17],["ἔσται",704093,93],["ὑμῖν",713084,90],["ἡ",709436,10],["θάλασσα",706069,12],["ἡ",709436,10],["μεγάλη",708653,29],["ὁριεῖ",709748,127],["τοῦτο",709858,132],["ἔσται",704093,93],["ὑμῖν",713084,90],["τὰ",709436,63],["ὅρια",709749,64],["τῆς",709436,16],["θαλάσσης",706069,17]],"And ye shall have your border on the west, the great sea shall be the boundary: this shall be to you the border on the west."],["7",[["καὶ",707031,7],["τοῦτο",709858,132],["ἔσται",704093,93],["τὰ",709436,63],["ὅρια",709749,64],["ὑμῖν",713084,90],["πρὸς",710844,0],["βορρᾶν",702765,6],["ἀπὸ",701425,0],["τῆς",709436,16],["θαλάσσης",706069,17],["τῆς",709436,16],["μεγάλης",708653,82],["καταμετρήσετε",707330,337],["ὑμῖν",713084,90],["αὐτοῖς",702165,151],["παρὰ",709995,0],["τὸ",709436,24],["ὄρος",709768,25],["τὸ",709436,24],["ὄρος",709768,25]],"And this shall be your northern border; from the great sea ye shall measure to yourselves, by the side of the mountain."],["8",[["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,20],["ὄρους",709768,21],["τὸ",709436,24],["ὄρος",709768,25],["καταμετρήσετε",707330,337],["αὐτοῖς",702165,151],["εἰσπορευομένων",704124,299],["εἰς",704105,0],["Εμαθ",704541,6],["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["διέξοδος",703668,12],["αὐτοῦ",702165,102],["τὰ",709436,41],["ὅρια",709749,42],["Σαραδα",711513,17]],"And ye shall measure to yourselves the mountain from mount [Hor] at the entering in to Emath, and the termination of it shall be the coasts of Saradac."],["9",[["καὶ",707031,7],["ἐξελεύσεται",704909,93],["τὰ",709436,41],["ὅρια",709749,42],["Δεφρωνα",703392,17],["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["διέξοδος",703668,12],["αὐτοῦ",702165,102],["Ασερναιν",701925,4],["τοῦτο",709858,132],["ἔσται",704093,93],["ὑμῖν",713084,90],["ὅρια",709749,64],["ἀπὸ",701425,0],["βορρᾶ",702765,18]],"And the border shall go out to Dephrona, and its termination shall be at Arsenain; this shall be your border from the north."],["10",[["καὶ",707031,7],["καταμετρήσετε",707330,337],["ὑμῖν",713084,90],["αὐτοῖς",702165,151],["τὰ",709436,41],["ὅρια",709749,42],["ἀνατολῶν",701071,65],["ἀπὸ",701425,0],["Ασερναιν",701925,18],["Σεπφαμα",711695,114]],"And ye shall measure to yourselves the eastern border from Arsenain to Sepphamar."],["11",[["καὶ",707031,7],["καταβήσεται",707202,93],["τὰ",709436,63],["ὅρια",709749,64],["ἀπὸ",701425,0],["Σεπφαμ",711694,18],["Αρβηλα",701697,18],["ἀπὸ",701425,0],["ἀνατολῶν",701071,65],["ἐπὶ",705080,0],["πηγάς",710450,39],["καὶ",707031,7],["καταβήσεται",707202,93],["τὰ",709436,63],["ὅρια",709749,64],["Βηλα",702695,18],["ἐπὶ",705080,0],["νώτου",709403,21],["θαλάσσης",706069,17],["Χεναρα",713824,17],["ἀπὸ",701425,0],["ἀνατολῶν",701071,65]],"And the border shall go down from Sepphamar to Bela eastward to the fountains, and the border shall go down from Bela behind the sea Chenereth eastward."],["12",[["καὶ",707031,7],["καταβήσεται",707202,93],["τὰ",709436,63],["ὅρια",709749,64],["ἐπὶ",705080,0],["τὸν",709436,5],["Ιορδάνην",706763,6],["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["διέξοδος",703668,12],["θάλασσα",706069,12],["ἡ",709436,10],["ἁλυκή",700732,29],["αὕτη",709858,107],["ἔσται",704093,93],["ὑμῖν",713084,90],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["τὰ",709436,63],["ὅρια",709749,64],["αὐτῆς",702165,86],["κύκλῳ",707959,114]],"And the border shall go down to Jordan, and the termination shall be the salt sea; this shall be your land and its borders round about."],["13",[["καὶ",707031,7],["ἐνετείλατο",704791,23],["Μωυσῆς",709112,4],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["λέγων",708124,72],["αὕτη",709858,107],["ἡ",709436,10],["γῆ",703083,12],["ἣν",709781,131],["κατακληρονομήσετε",707274,337],["αὐτὴν",702165,104],["μετὰ",708780,0],["κλήρου",707727,18],["ὃν",709781,112],["τρόπον",712980,6],["συνέταξεν",712508,2],["κύριος",707996,4],["τῷ",709436,113],["Μωυσῇ",709112,114],["δοῦναι",703654,106],["αὐτὴν",702165,104],["ταῖς",709436,75],["ἐννέα",704754,59],["φυλαῖς",713620,76],["καὶ",707031,7],["τῷ",709436,113],["ἡμίσει",705998,30],["φυλῆς",713620,17],["Μανασση",708470,18]],"And Moses charged the children of Israel, saying, This [is] the land which ye shall inherit by lot, even as the Lord commanded us to give it to the nine tribes and the half-tribe of Manasse."],["14",[["ὅτι",709803,7],["ἔλαβεν",708076,2],["φυλὴ",713620,12],["υἱῶν",713075,81],["Ρουβην",711295,18],["καὶ",707031,7],["φυλὴ",713620,12],["υἱῶν",713075,81],["Γαδ",702872,18],["κατ᾿",707200,0],["οἴκους",709516,57],["πατριῶν",710192,65],["αὐτῶν",702165,40],["καὶ",707031,7],["τὸ",709436,34],["ἥμισυ",705998,26],["φυλῆς",713620,17],["Μανασση",708470,18],["ἀπέλαβον",701504,150],["τοὺς",709436,58],["κλήρους",707727,57],["αὐτῶν",702165,40]],"For the tribe of the children of Ruben, and the tribe of the children of Gad have received [their inheritance] according to their families; and the half-tribe of Manasse have received their inheritances."],["15",[["δύο",703849,59],["φυλαὶ",713620,191],["καὶ",707031,7],["ἥμισυ",705998,46],["φυλῆς",713620,17],["ἔλαβον",708076,150],["τοὺς",709436,58],["κλήρους",707727,57],["αὐτῶν",702165,40],["πέραν",710280,28],["τοῦ",709436,35],["Ιορδάνου",706763,18],["κατὰ",707200,0],["Ιεριχω",706620,6],["ἀπὸ",701425,0],["νότου",709364,18],["κατ᾿",707200,0],["ἀνατολάς",701071,39]],"Two tribes and half a tribe have received their inheritance beyond Jordan by Jericho from the south eastwards."],["16",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["17",[["ταῦτα",709858,290],["τὰ",709436,63],["ὀνόματα",709666,64],["τῶν",709436,80],["ἀνδρῶν",701150,81],["οἳ",709781,250],["κληρονομήσουσιν",707724,218],["ὑμῖν",713084,90],["τὴν",709436,8],["γῆν",703083,9],["Ελεαζαρ",704407,4],["ὁ",709436,3],["ἱερεὺς",706614,4],["καὶ",707031,7],["Ἰησοῦς",706701,4],["ὁ",709436,3],["τοῦ",709436,35],["Ναυη",709206,18]],"These [are] the names of the men who shall divide the land to you for an inheritance; Eleazar the priest and Joshua the [son] of Naue."],["18",[["καὶ",707031,7],["ἄρχοντα",701862,6],["ἕνα",704106,27],["ἐκ",704132,0],["φυλῆς",713620,17],["λήμψεσθε",708076,124],["κατακληρονομῆσαι",707274,106],["ὑμῖν",713084,90],["τὴν",709436,8],["γῆν",703083,9]],"And ye shall take one ruler from [each] tribe to divide the land to you by lot."],["19",[["καὶ",707031,7],["ταῦτα",709858,290],["τὰ",709436,63],["ὀνόματα",709666,64],["τῶν",709436,80],["ἀνδρῶν",701150,81],["τῆς",709436,16],["φυλῆς",713620,17],["Ιουδα",706768,18],["Χαλεβ",713680,4],["υἱὸς",713075,4],["Ιεφοννη",706687,18]],"And these [are] the names of the men; of the tribe of Juda, Chaleb the son of Jephonne."],["20",[["τῆς",709436,16],["φυλῆς",713620,17],["Συμεων",712297,18],["Σαλαμιηλ",711399,4],["υἱὸς",713075,4],["Εμιουδ",704565,18]],"Of the tribe of Symeon, Salamiel the son of Semiud."],["21",[["τῆς",709436,16],["φυλῆς",713620,17],["Βενιαμιν",702650,18],["Ελδαδ",704404,4],["υἱὸς",713075,4],["Χασλων",713766,18]],"Of the tribe of Benjamin, Eldad the son of Chaslon."],["22",[["τῆς",709436,16],["φυλῆς",713620,17],["Δαν",703276,18],["ἄρχων",701862,4],["Βακχιρ",702462,4],["υἱὸς",713075,4],["Εγλι",704007,18]],"Of the tribe of Dan the prince [was] Bacchir the son of Egli."],["23",[["τῶν",709436,80],["υἱῶν",713075,81],["Ιωσηφ",706948,18],["φυλῆς",713620,17],["υἱῶν",713075,81],["Μανασση",708470,18],["ἄρχων",701862,4],["Ανιηλ",701168,4],["υἱὸς",713075,4],["Ουφι",709860,18]],"Of the sons of Joseph of the tribe of the sons of Manasse, the prince was Aniel the son of Suphi."],["24",[["τῆς",709436,16],["φυλῆς",713620,17],["υἱῶν",713075,81],["Εφραιμ",705769,18],["ἄρχων",701862,4],["Καμουηλ",707116,4],["υἱὸς",713075,4],["Σαβαθα",711333,18]],"Of the tribe of the sons of Ephraim, the prince was Camuel the son of Sabathan."],["25",[["τῆς",709436,16],["φυλῆς",713620,17],["Ζαβουλων",705813,18],["ἄρχων",701862,4],["Ελισαφαν",704487,4],["υἱὸς",713075,4],["Φαρναχ",713371,18]],"Of the tribe of Zabulon, the prince was Elisaphan the son of Pharnac."],["26",[["τῆς",709436,16],["φυλῆς",713620,17],["υἱῶν",713075,81],["Ισσαχαρ",706843,18],["ἄρχων",701862,4],["Φαλτιηλ",713340,4],["υἱὸς",713075,4],["Οζα",709467,18]],"Of the tribe of the sons of Issachar, the prince was Phaltiel the son of Oza."],["27",[["τῆς",709436,16],["φυλῆς",713620,17],["υἱῶν",713075,81],["Ασηρ",701934,18],["ἄρχων",701862,4],["Αχιωρ",702301,4],["υἱὸς",713075,4],["Σελεμι",711640,18]],"Of the tribe of the children of Aser, the prince was Achior the son of Selemi."],["28",[["τῆς",709436,16],["φυλῆς",713620,17],["Νεφθαλι",709279,18],["ἄρχων",701862,4],["Φαδαηλ",713298,4],["υἱὸς",713075,4],["Βεναμιουδ",702648,18]],"Of the tribe of Nephthali, the prince was Phadael the son of Jamiud."],["29",[["οὗτοι",709858,201],["οἷς",709781,311],["ἐνετείλατο",704791,23],["κύριος",707996,4],["καταμερίσαι",707327,106],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["ἐν",704639,0],["γῇ",703083,1],["Χανααν",713708,118]],"These did the Lord command to distribute [the inheritances] to the children of Israel in the land of Chanaan."]]