ὴρ",701150,4],["Ισραηλ",706839,18],["μετ᾿",708780,0],["αὐτοῦ",702165,102]],"And David passed over to Manaim: and Abessalom crossed over Jordan, he and all the men of Israel with him."],["25",[["καὶ",707031,7],["τὸν",709436,5],["Αμεσσαϊ",700812,6],["κατέστησεν",707011,2],["Αβεσσαλωμ",700052,4],["ἀντὶ",701227,0],["Ιωαβ",706877,18],["ἐπὶ",705080,0],["τῆς",709436,16],["δυνάμεως",703839,17],["καὶ",707031,7],["Αμεσσαϊ",700812,4],["υἱὸς",713075,4],["ἀνδρὸς",701150,18],["καὶ",707031,7],["ὄνομα",709666,15],["αὐτῷ",702165,50],["Ιοθορ",706756,4],["ὁ",709436,3],["Ισραηλίτης",706840,4],["οὗτος",709858,121],["εἰσῆλθεν",704114,2],["πρὸς",710844,0],["Αβιγαιαν",700058,9],["θυγατέρα",706320,9],["Ναας",709126,18],["ἀδελφὴν",700244,9],["Σαρουιας",711540,17],["μητρὸς",708892,17],["Ιωαβ",706877,18]],"And Abessalom appointed Amessai in the room of Joab over the host. And Amessai was the son of a man whose name was Jether of Jezrael: he went in to Abigaia the daughter of Naas, the sister of Saruia the mother of Joab."],["26",[["καὶ",707031,7],["παρενέβαλεν",710132,2],["πᾶς",710177,14],["Ισραηλ",706839,4],["καὶ",707031,7],["Αβεσσαλωμ",700052,4],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["Γαλααδ",702920,17]],"And all Israel and Abessalom encamped in the land of Galaad."],["27",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἡνίκα",706008,28],["ἦλθεν",705453,2],["Δαυιδ",703232,4],["εἰς",704105,0],["Μαναϊμ",708468,303],["Ουεσβι",709822,4],["υἱὸς",713075,4],["Ναας",709126,18],["ἐκ",704132,0],["Ραββαθ",711132,228],["υἱῶν",713075,81],["Αμμων",700847,18],["καὶ",707031,7],["Μαχιρ",708604,4],["υἱὸς",713075,4],["Αμιηλ",700823,18],["ἐκ",704132,0],["Λωδαβαρ",708289,228],["καὶ",707031,7],["Βερζελλι",702657,4],["ὁ",709436,3],["Γαλααδίτης",702922,4],["ἐκ",704132,0],["Ρωγελλιμ",711315,286]],"And it came to pass when David came to Manaim, that Uesbi the son of Naas of Rabbath of the sons of Ammon, and Machir son of Amiel of Lodabar, and Berzelli the Galaadite of Rogellim,"],["28",[["ἤνεγκαν",713428,150],