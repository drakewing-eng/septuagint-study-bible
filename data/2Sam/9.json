,702165,50],["τὴν",709436,8],["γῆν",703083,9],["σὺ",712181,164],["καὶ",707031,7],["οἱ",709436,136],["υἱοί",713075,52],["σου",711945,133],["καὶ",707031,7],["οἱ",709436,136],["δοῦλοί",703817,52],["σου",711945,133],["καὶ",707031,7],["εἰσοίσεις",704127,166],["τῷ",709436,113],["υἱῷ",713075,114],["τοῦ",709436,35],["κυρίου",707996,18],["σου",711945,133],["ἄρτους",701829,57],["καὶ",707031,7],["ἔδεται",705495,93],["αὐτούς",702165,62],["καὶ",707031,7],["Μεμφιβοσθε",708726,4],["υἱὸς",713075,4],["τοῦ",709436,35],["κυρίου",707996,18],["σου",711945,133],["φάγεται",713296,93],["διὰ",703417,0],["παντὸς",710177,116],["ἄρτον",701829,6],["ἐπὶ",705080,0],["τῆς",709436,16],["τραπέζης",712919,17],["μου",709032,133],["καὶ",707031,7],["τῷ",709436,113],["Σιβα",711765,114],["ἦσαν",704093,137],["πεντεκαίδεκα",710267,59],["υἱοὶ",713075,52],["καὶ",707031,7],["εἴκοσι",704085,59],["δοῦλοι",703817,52]],"And thou, and thy sons, and thy servants, shall till the land for him; and thou shalt bring in bread to the son of thy lord, and he shall eat bread: and Memphibosthe the son of thy lord shall eat bread continually at my table. Now Siba had fifteen sons and twenty servants."],["11",[["καὶ",707031,7],["εἶπεν",705373,2],["Σιβα",711765,4],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἐντέταλται",704791,187],["ὁ",709436,3],["κύριός",707996,4],["μου",709032,133],["ὁ",709436,3],["βασιλεὺς",702580,4],["τῷ",709436,113],["δούλῳ",703817,114],["αὐτοῦ",702165,102],["οὕτως",709859,28],["ποιήσει",710582,127],["ὁ",709436,3],["δοῦλός",703817,4],["σου",711945,133],["καὶ",707031,7],["Μεμφιβοσθε",708726,4],["ἤσθιεν",705495,13],["ἐπὶ",705080,0],["τῆς",709436,16],["τραπέζης",712919,17],["Δαυιδ",703232,18],["καθὼς",707030,28],["εἷς",704106,596],["τῶν",709436,80],["υἱῶν",713075,81],["τοῦ",709436,35],["βασιλέως",702580,18]],"And Siba said to the king, According to all that my lord the king has commanded his servant, so will thy servant do. And Memphibosthe did eat at the table of David, as one of the sons of the king."],["12",[["καὶ",707031,7],["τῷ",709436,113],["Μεμφιβοσθε",708726,114],["υἱὸς",713075,4],["μικρὸς",708915,14],["καὶ",707031,7],["ὄνομα",709666,15],["αὐτῷ",702165,50],["Μιχα",708952,4],["καὶ",707031,7],["πᾶσα",710177,29],["ἡ",709436,10],["κατοίκησις",707535,12],["τοῦ",709436,35],["οἴκου",709516,18],["Σιβα",711765,18],["δοῦλοι",703817,52],["τοῦ",709436,35],["Μεμφιβοσθε",708726,18]],"And Memphibosthe had a little son, and his name [was] Micha: and all the household of Siba [were] servants to Memphibosthe."],["13",[["καὶ",707031,7],["Μεμφιβοσθε",708726,4],["κατῴκει",707534,13],["ἐν",704639,0],["Ιερουσαλημ",706644,114],["ὅτι",709803,7],["ἐπὶ",705080,0],["τῆς",709436,16],["τραπέζης",712919,17],["τοῦ",709436,35],["βασιλέως",702580,18],["διὰ",703417,0],["παντὸς",710177,116],["ἤσθιεν",705495,13],["καὶ",707031,7],["αὐτὸς",702165,121],["ἦν",704093,13],["χωλὸς",713999,14],["ἀμφοτέροις",700892,230],["τοῖς",709436,147],["ποσὶν",710707,148],["αὐτοῦ",702165,102]],"And Memphibosthe dwelt in Jerusalem, for he continually ate at the table of the king; and he was lame in both his feet."]]