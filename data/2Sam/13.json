[["1",[["καὶ",707031,7],["ἐγενήθη",703104,37],["μετὰ",708780,0],["ταῦτα",709858,71],["καὶ",707031,7],["τῷ",709436,113],["Αβεσσαλωμ",700052,114],["υἱῷ",713075,114],["Δαυιδ",703232,18],["ἀδελφὴ",700244,12],["καλὴ",707097,29],["τῷ",709436,53],["εἴδει",704074,54],["σφόδρα",712586,28],["καὶ",707031,7],["ὄνομα",709666,25],["αὐτῇ",702165,105],["Θημαρ",706239,9],["καὶ",707031,7],["ἠγάπησεν",700120,2],["αὐτὴν",702165,104],["Αμνων",700856,4],["υἱὸς",713075,4],["Δαυιδ",703232,4]],"And it happened after this that Abessalom the son of David had a very beautiful sister, and her name [was] Themar; and Amnon the son of David loved her."],["2",[["καὶ",707031,7],["ἐθλίβετο",706274,19],["Αμνων",700856,4],["ὥστε",714164,7],["ἀρρωστεῖν",701811,55],["διὰ",703417,0],["Θημαρ",706239,9],["τὴν",709436,8],["ἀδελφὴν",700244,9],["αὐτοῦ",702165,102],["ὅτι",709803,7],["παρθένος",710148,12],["ἦν",704093,13],["αὐτή",702165,107],["καὶ",707031,7],["ὑπέρογκον",713152,27],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["Αμνων",700856,18],["τοῦ",709436,20],["ποιῆσαί",710582,106],["τι",712866,126],["αὐτῇ",702165,105]],"And Amnon was distressed even to sickness, because of Themar his sister; for she was a virgin, and it seemed very difficult for Amnon to do anything to her."],["3",[["καὶ",707031,7],["ἦν",704093,13],["τῷ",709436,113],["Αμνων",700856,114],["ἑταῖρος",705529,4],["καὶ",707031,7],["ὄνομα",709666,25],["αὐτῷ",702165,50],["Ιωναδαβ",706924,6],["υἱὸς",713075,4],["Σαμαα",711434,18],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["Δαυιδ",703232,18],["καὶ",707031,7],["Ιωναδαβ",706924,4],["ἀνὴρ",701150,4],["σοφὸς",711985,14],["σφόδρα",712586,28]],"And Amnon had a friend, and his name [was] Jonadab, the son of Samaa the brother of David: and Jonadab [was] a very cunning man."],["4",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["τί",712867,273],["σοι",711925,159],["ὅτι",709803,7],["σὺ",712181,164],["οὕτως",709859,28],["ἀσθενής",701939,14],["υἱὲ",713075,153],["τοῦ",709436,35],["βασιλέως",702580,18],["τὸ",709