μνων",700856,4],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["ἐλθέτω",705453,31],["δὴ",703395,11],["Θημαρ",706239,12],["ἡ",709436,10],["ἀδελφή",700244,12],["μου",709032,133],["πρός",710844,0],["με",708618,163],["καὶ",707031,7],["κολλυρισάτω",707793,45],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["μου",709032,133],["δύο",703849,59],["κολλυρίδας",707795,39],["καὶ",707031,7],["φάγομαι",705495,181],["ἐκ",704132,0],["τῆς",709436,16],["χειρὸς",713787,17],["αὐτῆς",702165,86]],"So Amnon lay down, and made himself sick; and the king came in to see him: and Amnon said to the king, Let, I pray thee, my sister Themar come to me, and make a couple of cakes in my sight, and I will eat them at her hand."],["7",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Δαυιδ",703232,4],["πρὸς",710844,0],["Θημαρ",706239,9],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["λέγων",708124,72],["πορεύθητι",710667,244],["δὴ",703395,11],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["Αμνων",700856,18],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["σου",711945,133],["καὶ",707031,7],["ποίησον",710582,176],["αὐτῷ",702165,50],["βρῶμα",702823,25]],"And David sent to Themar to the house, saying, Go now to thy brother's house, and dress him food."],["8",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["Θημαρ",706239,4],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["Αμνων",700856,18],["ἀδελφοῦ",700249,18],["αὐτῆς",702165,86],["καὶ",707031,7],["αὐτὸς",702165,121],["κοιμώμενος",707767,122],["καὶ",707031,7],["ἔλαβεν",708076,2],["τὸ",709436,24],["σταῖς",712042,25],["καὶ",707031,7],["ἐφύρασεν",713626,2],["καὶ",707031,7],["ἐκολλύρισεν",707793,2],["κατ᾿",707200,0],["ὀφθαλμοὺς",709870,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἥψησεν",705788,2],["τὰς",709436,38],["κολλυρίδας",707795,39]],"And Themar went to the house of her brother Amnon, and he [was] lying down: and she took the dough and kneaded it, and made cakes in his sight, and baked the cakes."],["9",[["καὶ",707031,7],["ἔλαβεν",708076,2],["τὸ",709436,24],["τήγανον",712835,25],["καὶ",707031,7],["κατεκένωσεν",707268,2],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ἠθέλησεν",706176,2],["φαγεῖν",713296,106],["καὶ",707031,7],["εἶπεν",705373,2],["Αμνων",700856,4],["ἐξαγάγετε",704834,74],["πάντα",710177,27],["ἄνδρα",701150,6],["ἐπάνωθέν",705031,28],["μου",709032,133],["καὶ",707031,7],["ἐξήγαγον",704834,150],["πάντα",710177,27],["ἄνδρα",701150,6],["ἀπὸ",701425,0],["ἐπάνωθεν",705031,28],["αὐτοῦ",702165,102]],"And she took the frying-pan and poured them out before him, but he would not eat. And Amnon said, Send out every man from about me. And they removed every man from about him."],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["Αμνων",700856,4],["πρὸς",710844,0],["Θημαρ",706239,9],["εἰσένεγκε",704127,2],["τὸ",709436,24],["βρῶμα",702823,25],["εἰς",704105,0],["τὸ",709436,24],["ταμίειον",712700,25],["καὶ",707031,7],["φάγομαι",705495,181],["ἐκ",704132,0],["τῆς",709436,16],["χειρός",713787,17],["σου",711945,133],["καὶ",707031,7],["ἔλαβεν",708076,2],["Θημαρ",706239,4],["τὰς",709436,38],["κολλυρίδας",707795,39],["ἃς",709781,193],["ἐποίησεν",710582,2],["καὶ",707031,7],["εἰσήνεγκεν",704127,2],["τῷ",709436,113],["Αμνων",700856,114],["ἀδελφῷ",700249,114],["αὐτῆς",702165,86],["εἰς",704105,0],["τὸν",709436,5],["κοιτῶνα",707782,6]],"And Amnon said to Themar, Bring in the food into the closet, and I will eat of thy hand. And Themar took the cakes which she had made, and brought them to her brother Amnon into the chamber."],["11",[["καὶ",707031,7],["προσήγαγεν",710848,2],["αὐτῷ",702165,50],["τοῦ",709436,20],["φαγεῖν",713296,106],["καὶ",707031,7],["ἐπελάβετο",705185,23],["αὐτῆς",702165,86],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῇ",702165,105],["δεῦρο",703382,28],["κοιμήθητι",707767,244],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["ἀδελφή",700244,12],["μου",709032,133]],"And she brought [them] to him to eat, and he caught hold of her, and said to her, Come, lie with me, my sister."],["12",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["μή",708851,28],["ἄδελφέ",700249,153],["μου",709032,133],["μὴ",708851,28],["ταπεινώσῃς",712717,175],["με",708618,163],["διότι",703734,7],["οὐ",709805,28],["ποιηθήσεται",710582,134],["οὕτως",709859,28],["ἐν",704639,0],["Ισραηλ",706839,1],["μὴ",708851,28],["ποιήσῃς",710582,175],["τὴν",709436,8],["ἀφροσύνην",702235,9],["ταύτην",709858,104]],"And she said to him, Nay, my brother, do not humble me, for it ought not to be so done in Israel; do not this folly."],["13",[["καὶ",707031,7],["ἐγὼ",704018,164],["ποῦ",710706,28],["ἀποίσω",701632,165],["τὸ",709436,24],["ὄνειδός",709658,25],["μου",709032,133],["καὶ",707031,7],["σὺ",712181,164],["ἔσῃ",704093,123],["ὡς",714148,7],["εἷς",704106,596],["τῶν",709436,80],["ἀφρόνων",702236,169],["ἐν",704639,0],["Ισραηλ",706839,1],["καὶ",707031,7],["νῦν",709384,28],["λάλησον",708071,577],["δὴ",703395,11],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["ὅτι",709803,7],["οὐ",709805,28],["μὴ",708851,28],["κωλύσῃ",708020,123],["με",708618,163],["ἀπὸ",701425,0],["σοῦ",711945,133]],"And I, whither shall I remove my reproach? and thou shalt be as one of the fools in Israel. And now, speak, I pray thee, to the king, for surely he will not keep me from thee."],["14",[["καὶ",707031,7],["οὐκ",709805,28],["ἠθέλησεν",706176,2],["Αμνων",700856,4],["τοῦ",709436,20],["ἀκοῦσαι",700587,106],["τῆς",709436,16],["φωνῆς",713640,17],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐκραταίωσεν",707875,2],["ὑπὲρ",713111,0],["αὐτὴν",702165,104],["καὶ",707031,7],["ἐταπείνωσεν",712717,2],["αὐτὴν",702165,104],["καὶ",707031,7],["ἐκοιμήθη",707767,37],["μετ᾿",708780,0],["αὐτῆς",702165,86]],"But Amnon would not hearken to her voice; and he prevailed against her, and humbled her, and lay with her."],["15",[["καὶ",707031,7],["ἐμίσησεν",708935,2],["αὐτὴν",702165,104],["Αμνων",700856,4],["μῖσος",708947,25],["μέγα",708653,46],["σφόδρα",712586,28],["ὅτι",709803,7],["μέγα",708653,46],["τὸ",709436,24],["μῖσος",708947,25],["ὃ",709781,33],[