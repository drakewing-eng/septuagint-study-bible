36,58],["λόγους",708236,57],["τοῦ",709436,35],["πολέμου",710605,18]],"And Joab sent, and reported to David all the events of the war, so as to tell them to the king."],["19",[["καὶ",707031,7],["ἐνετείλατο",704791,23],["τῷ",709436,113],["ἀγγέλῳ",700140,114],["λέγων",708124,72],["ἐν",704639,0],["τῷ",709436,53],["συντελέσαι",712510,106],["σε",711598,163],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["τοῦ",709436,35],["πολέμου",710605,18],["λαλῆσαι",708071,106],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6]],"And he charged the messenger, saying, When thou hast finished reporting all the events of the war to the king,"],["20",[["καὶ",707031,7],["ἔσται",704093,93],["ἐὰν",703912,7],["ἀναβῇ",700905,172],["ὁ",709436,3],["θυμὸς",706334,4],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["εἴπῃ",705373,172],["σοι",711925,159],["τί",712867,273],["ὅτι",709803,7],["ἠγγίσατε",703939,265],["πρὸς",710844,0],["τὴν",709436,8],["πόλιν",710612,9],["πολεμῆσαι",710601,106],["οὐκ",709805,28],["ᾔδειτε",709492,510],["ὅτι",709803,7],["τοξεύσουσιν",712896,218],["ἀπάνωθεν",701349,28],["τοῦ",709436,20],["τείχους",712759,21]],"then it shall come to pass if the anger of the king shall arise, and he shall say to thee, Why did ye draw nigh to the city to fight? knew ye not that they would shoot from off the wall?"],["21",[["τίς",712867,158],["ἐπάταξεν",710185,2],["τὸν",709436,5],["Αβιμελεχ",700068,6],["υἱὸν",713075,6],["Ιεροβααλ",706627,118],["οὐχὶ",709862,28],["γυνὴ",703209,12],["ἔρριψεν",711267,2],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["κλάσμα",707704,15],["μύλου",709056,18],["ἐπάνωθεν",705031,28],["τοῦ",709436,20],["τείχους",712759,21],["καὶ",707031,7],["ἀπέθανεν",701461,2],["ἐν",704639,0],["Θαμασι",706079,111],["ἵνα",706747,7],["τί",712867,126],["προσηγάγετε",710848,265],["πρὸς",710844,0],["τὸ",709436,24],["τεῖχος",712759,25],["καὶ",707031,7],["ἐρεῖς",705415,166],["καί",707031,7],["γε",702985,11],["Ουριας",709848,4],["ὁ",709436,3],["δοῦλός",703817,4],["σου",711945,133],["ὁ",709436,3],["Χετταῖος",713838,4],["ἀπέθανεν",701461,2]],"Who smote Abimelech the son of Jerobaal son of Ner? did not a woman cast a piece of a millstone upon him from above the wall, and he died in Thamasi? why did ye draw near to the wall? then thou shalt say, Thy servant Urias the Chettite is also dead."],["22",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["ὁ",709436,3],["ἄγγελος",700140,4],["Ιωαβ",706877,4],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["παρεγένετο",710006,23],["καὶ",707031,7],["ἀπήγγειλεν",701321,2],["τῷ",709436,113],["Δαυιδ",703232,114],["πάντα",710177,68],["ὅσα",709788,68],["ἀπήγγειλεν",701321,2],["αὐτῷ",702165,50],["Ιωαβ",706877,4],["πάντα",710177,27],["τὰ",709436,41],["ῥήματα",711246,42],["τοῦ",709436,35],["πολέμου",710605,18],["καὶ",707031,7],["ἐθυμώθη",706335,37],["Δαυιδ",703232,4],["πρὸς",710844,0],["Ιωαβ",706877,6],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["τὸν",709436,5],["ἄγγελον",700140,6],["ἵνα",706747,28],["τί",712867,126],["προσηγάγετε",710848,265],["πρὸς",710844,0],["τὴν",709436,8],["πόλιν",710612,9],["τοῦ",709436,20],["πολεμῆσαι",710601,106],["οὐκ",709805,28],["ᾔδειτε",709492,510],["ὅτι",709803,7],["πληγήσεσθε",710550,261],["ἀπὸ",701425,0],["τοῦ",709436,20],["τείχους",712759,21],["τίς",712867,158],["ἐπάταξεν",710185,2],["τὸν",709436,5],["Αβιμελεχ",700068,6],["υἱὸν",713075,6],["Ιεροβααλ",706627,118],["οὐχὶ",709862,28],["γυνὴ",703209,12],["ἔρριψεν",711267,2],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["κλάσμα",707704,15],["μύλου",709056,18],["ἀπὸ",701425,0],["τοῦ",709436,20],["τείχους",712759,21],["καὶ",707031,7],["ἀπέθανεν",701461,2],["ἐν",704639,0],["Θαμασι",706079,111],["ἵνα",706747,7],["τί",712867,126],["προσηγάγετε",710848,265],["πρὸς",710844,0],["τὸ",709436,24],["τεῖχος",712759,25]],"And the messenger of Joab went to the king to Jerusalem, and he came and reported to David all that Joab told him, all the affairs of the war. And David was very angry with Joab, and said to the messenger, Why did ye draw nigh to the wall to fight? knew ye not that ye would be wounded from off the wall? Who smote Abimelech the son of Jerobaal? did not a woman cast upon him a piece of millstone from the wall, and he died in Thamasi? why did ye draw near to the wall?"],["23",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["ἄγγελος",700140,4],["πρὸς",710844,0],["Δαυιδ",703232,6],["ὅτι",709803,7],["ἐκραταίωσαν",707875,150],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["οἱ",709436,136],["ἄνδρες",701150,52],["καὶ",707031,7],["ἐξῆλθαν",704909,150],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["εἰς",704105,0],["τὸν",709436,5],["ἀγρόν",700196,6],["καὶ",707031,7],["ἐγενήθημεν",703104,485],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["ἕως",705792,7],["τῆς",709436,16],["θύρας",706337,17],["τῆς",709436,16],["πύλης",711082,17]],"And the messenger said to David, The men prevailed against us, and they came out against us into the field, and we came upon them even to the door of the gate."],["24",[["καὶ",707031,7],["ἐτόξευσαν",712896,150],["οἱ",709436,136],["τοξεύοντες",712896,146],["πρὸς",710844,0],["τοὺς",709436,58],["παῖδάς",709932,57],["σου",711945,133],["ἀπάνωθεν",701349,28],["τοῦ",709436,20],["τείχους",712759,21],["καὶ",707031,7],["ἀπέθαναν",701461,150],["τῶν",709436,80],["παίδων",709932,81],["τοῦ",709436,35],["βασιλέως",702580,18],["καί",707031,7],["γε",702985,11],["ὁ",709436,3],["δοῦλός",703817,4],["σου",711945,133],["Ουριας",709848,4],["ὁ",709436,3],["Χετταῖος",713838,4],["ἀπέθανεν",701461,2]],"And the archers shot at thy servants from off the wall, and some of the king's servants died, and thy servant Urias the Chettite is dead also."],["25",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["πρὸς",710844,0],["τὸν",709436,5],["ἄγγελον",700140,6],["τάδε",709446,132],["ἐρεῖς",705415,166],["πρὸς",710844,0],["Ιωαβ",706877,6],["μὴ",708851,28],["πονηρὸν",710660,27],["ἔστω",704093,31],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["σου",711945,133],["τὸ",