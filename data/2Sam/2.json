[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["μετὰ",708780,0],["ταῦτα",709858,71],["καὶ",707031,7],["ἐπηρώτησεν",705069,2],["Δαυιδ",703232,4],["ἐν",704639,0],["κυρίῳ",707996,114],["λέγων",708124,72],["εἰ",704071,7],["ἀναβῶ",700905,207],["εἰς",704105,0],["μίαν",704106,36],["τῶν",709436,130],["πόλεων",710612,65],["Ιουδα",706768,18],["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["αὐτόν",702165,85],["ἀνάβηθι",700905,244],["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["ποῦ",710706,28],["ἀναβῶ",700905,172],["καὶ",707031,7],["εἶπεν",705373,2],["εἰς",704105,0],["Χεβρων",713777,227]],"And it came to pass after this that David enquired of the Lord, saying, Shall I go up into one of the cities of Juda? and the Lord said to him, Go up. And David said, Whither shall I go up? and he said, To Chebron."],["2",[["καὶ",707031,7],["ἀνέβη",700905,2],["ἐκεῖ",704181,28],["Δαυιδ",703232,4],["εἰς",704105,0],["Χεβρων",713777,227],["καὶ",707031,7],["ἀμφότεραι",700892,192],["αἱ",709436,190],["γυναῖκες",703209,191],["αὐτοῦ",702165,102],["Αχινοομ",702288,12],["ἡ",709436,10],["Ιεζραηλῖτις",706550,12],["καὶ",707031,7],["Αβιγαια",700057,12],["ἡ",709436,10],["γυνὴ",703209,12],["Ναβαλ",709132,18],["τοῦ",709436,35],["Καρμηλίου",707159,18]],"And David went up thither to Chebron, [he] and both his wives, Achinaam the Jezraelitess, and Abigaia the wife of Nabal the Carmelite,"],["3",[["καὶ",707031,7],["οἱ",709436,136],["ἄνδρες",701150,52],["οἱ",709436,136],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἕκαστος",704133,14],["καὶ",707031,7],["ὁ",709436,3],["οἶκος",709516,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["κατῴκουν",707534,137],["ἐν",704639,0],["ταῖς",709436,75],["πόλεσιν",710612,76],["Χεβρων",713777,118]],"and the men that were with him, every one and his family; and they dwelt in the cities of Chebron."],["4",[["καὶ",707031,7],["ἔρχονται",705453,269],["ἄνδρες",701150,52],["τῆς",709436,16],["Ιουδαίας",706769,17],["καὶ",707031,7],["χρίουσιν",713965,197],["τὸν",709436,5],["Δαυιδ",703232,6],["ἐκεῖ",704181,28],["τοῦ",709436,20],["βασιλεύειν",702581,55],["ἐπὶ",705080,0],["τὸν",709436,5],["οἶκον",709516,6],["Ιουδα",706768,18],["καὶ",707031,7],["ἀπήγγειλαν",701321,150],["τῷ",709436,113],["Δαυιδ",703232,114],["λέγοντες",708124,146],["ὅτι",709803,7],["οἱ",709436,136],["ἄνδρες",701150,52],["Ιαβις",706366,118],["τῆς",709436,16],["Γαλααδίτιδος",702923,17],["ἔθαψαν",706103,150],["τὸν",709436,5],["Σαουλ",711499,6]],"And the men of Judea come, and anoint David there to reign over the house of Juda; and they reported to David, saying, The men of Jabis of the country of Galaad have buried Saul."],["5",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Δαυιδ",703232,4],["ἀγγέλους",700140,57],["πρὸς",710844,0],["τοὺς",709436,58],["ἡγουμένους",705931,236],["Ιαβις",706366,118],["τῆς",709436,16],["Γαλααδίτιδος",702923,17],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτούς",702165,62],["εὐλογημένοι",705631,362],["ὑμεῖς",713081,219],["τῷ",709436,113],["κυρίῳ",707996,114],["ὅτι",709803,7],["πεποιήκατε",710582,330],["τὸ",709436,24],["ἔλεος",704426,25],["τοῦτο",709858,129],["ἐπὶ",705080,0],["τὸν",709436,5],["κύριον",707996,6],["ὑμῶν",713091,145],["ἐπὶ",705080,0],["Σαουλ",711499,114],["τὸν",709436,5],["χριστὸν",713964,6],["κυρίου",707996,18],["καὶ",707031,7],["ἐθάψατε",706103,265],["αὐτὸν",702165,85],["καὶ",707031,7],["Ιωναθαν",706927,6],["τὸν",709436,5],["υἱὸν",713075,6],["αὐτοῦ",702165,102]],"And David sent messengers to the rulers of Jabis of the country of Galaad, and David said to them, Blessed be ye of the Lord, because ye have wrought this mercy toward your lord, even toward Saul the anointed of the Lord, and ye have buried him and Jonathan his son."],["6",[["καὶ",707031,7],["νῦν",709384,28],["ποιήσαι",710582,225],["κύριος",707996,4],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["ἔλεος",704426,4],["καὶ",707031,7],["ἀλήθειαν",700656,9],["καί",707031,7],["γε",702985,11],["ἐγὼ",704018,164],["ποιήσω",710582,207],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["τὰ",709436,41],["ἀγαθὰ",700106,68],["ταῦτα",709858,71],["ὅτι",709803,7],["ἐποιήσατε",710582,265],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129]],"And now may the Lord deal in mercy and truth towards you: and I also will requite towards you this good deed, because ye have done this."],["7",[["καὶ",707031,7],["νῦν",709384,28],["κραταιούσθωσαν",707875,77],["αἱ",709436,190],["χεῖρες",713787,191],["ὑμῶν",713091,145],["καὶ",707031,7],["γίνεσθε",703104,73],["εἰς",704105,0],["υἱοὺς",713075,57],["δυνατούς",703845,60],["ὅτι",709803,7],["τέθνηκεν",706278,171],["ὁ",709436,3],["κύριος",707996,4],["ὑμῶν",713091,145],["Σαουλ",711499,4],["καί",707031,7],["γε",702985,11],["ἐμὲ",704555,163],["κέχρικεν",713965,171],["ὁ",709436,3],["οἶκος",709516,4],["Ιουδα",706768,18],["ἐφ᾿",705080,0],["ἑαυτοὺς",703917,62],["εἰς",704105,0],["βασιλέα",702580,6]],"And now let your hands be made strong, and be valiant; for your master Saul is dead, and moreover the house of Juda have anointed me to be king over them."],["8",[["καὶ",707031,7],["Αβεννηρ",700049,4],["υἱὸς",713075,4],["Νηρ",709297,18],["ἀρχιστράτηγος",701853,4],["τοῦ",709436,35],["Σαουλ",711499,18],["ἔλαβεν",708076,2],["τὸν",709436,5],["Ιεβοσθε",706516,6],["υἱὸν",713075,6],["Σαουλ",711499,18],["καὶ",707031,7],["ἀνεβίβασεν",700910,2],["αὐτὸν",702165,85],["ἐκ",704132,0],["τῆς",709436,16],["παρεμβολῆς",710133,17],["εἰς",704105,0],["Μαναεμ",708465,6]],"But Abenner, the son of Ner, the commander-in-chief of Saul's army, took Jebosthe son of Saul, and brought him up from the camp to Manaem"],["9",[["καὶ",707031,7],["ἐβασίλευσεν",702581,2],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["τὴν",709436,8],["Γαλααδῖτιν",702924,9],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸν",709436,5],["Θασιρι",706129,6],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸν",709436,5],["Ιεζραελ",706547,6],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸν",709436,5],["Εφραιμ",705769,6],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸν",709436,5],["Βενιαμιν",702650,6],["καὶ",707031,7],["ἐπὶ",705080,0],["πάντα",710177,27],["Ισραηλ",706839,6]],"and made him king over the land of Galaad, and over Thasiri, and over Jezrael, and over Ephraim, and over Benjamin, and over all Israel."],["10",[["τεσσαράκοντα",712806,59],["ἐτῶν",705543,44],["Ιεβοσθε",706516,4],["υἱὸς",713075,4],["Σαουλ",711499,18],["ὅτε",709802,28],["ἐβασίλευσεν",702581,2],["ἐπὶ",705080,0],["τὸν",709436,5],["Ισραηλ",706839,6],["καὶ",707031,7],["δύο",703849,591],["ἔτη",705543,42],["ἐβασίλευσεν",702581,2],["πλὴν",710540,28],["τοῦ",709436,35],["οἴκου",709516,18],["Ιουδα",706768,18],["οἳ",709781,250],["ἦσαν",704093,137],["ὀπίσω",709697,28],["Δαυιδ",703232,6]],"Jebosthe, Saul's son [was] forty years old, when he reigned over Israel; and he reigned two years, but not over the house of Juda, who followed David."],["11",[["καὶ",707031,7],["ἐγένοντο",703104,189],["αἱ",709436,190],["ἡμέραι",705984,191],["ἃς",709781,193],["Δαυιδ",703232,4],["ἐβασίλευσεν",702581,2],["ἐν",704639,0],["Χεβρων",713777,111],["ἐπὶ",705080,0],["τὸν",709436,5],["οἶκον",709516,6],["Ιουδα",706768,18],["ἑπτὰ",705357,59],["ἔτη",705543,42],["καὶ",707031,7],["ἓξ",704828,59],["μῆνας",708874,57]],"And the days which David reigned in Chebron over the house of Juda were seven years and six months."],["12",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["Αβεννηρ",700049,4],["υἱὸς",713075,4],["Νηρ",709297,18],["καὶ",707031,7],["οἱ",709436,136],["παῖδες",709932,52],["Ιεβοσθε",706516,18],["υἱοῦ",713075,18],["Σαουλ",711499,18],["ἐκ",704132,0],["Μαναεμ",708465,118],["εἰς",704105,0],["Γαβαων",702858,227]],"And Abenner the son of Ner went forth, and the servants of Jebosthe the son of Saul, from Manaem to Gabaon."],["13",[["καὶ",707031,7],["Ιωαβ",706877,4],["υἱὸς",713075,4],["Σαρουιας",711540,18],["καὶ",707031,7],["οἱ",709436,136],["παῖδες",709932,52],["Δαυιδ",703232,18],["ἐξήλθοσαν",704909,150],["ἐκ",704132,0],["Χεβρων",713777,118],["καὶ",707031,7],["συναντῶσιν",712394,197],["αὐτοῖς",702165,151],["ἐπὶ",705080,0],["τὴν",709436,8],["κρήνην",707896,9],["τὴν",709436,8],["Γαβαων",702858,9],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτό",702165,129],["καὶ",707031,7],["ἐκάθισαν",707006,150],["οὗτοι",709858,201],["ἐπὶ",705080,0],["τὴν",709436,8],["κρήνην",707896,9],["τὴν",709436,8],["Γαβαων",702858,9],["ἐντεῦθεν",704793,28],["καὶ",707031,7],["οὗτοι",709858,201],["ἐπὶ",705080,0],["τὴν",709436,8],["κρήνην",707896,9],["ἐντεῦθεν",704793,28]],"And Joab the son of Saruia, and the servants of David, went forth from Chebron, and met them at the fountain of Gabaon, at the same place: and these sat down by the fountain on this side, and those by the fountain on that side."],["14",[["καὶ",707031,7],["εἶπεν",705373,2],["Αβεννερ",700048,4],["πρὸς",710844,0],["Ιωαβ",706877,6],["ἀναστήτωσαν",701173,264],["δὴ",703395,11],["τὰ",709436,41],["παιδάρια",709923,42],["καὶ",707031,7],["παιξάτωσαν",709931,264],["ἐνώπιον",704823,0],["ἡμῶν",705999,145],["καὶ",707031,7],["εἶπεν",705373,2],["Ιωαβ",706877,4],["ἀναστήτωσαν",701173,264]],"And Abenner said to Joab, Let now the young men arise, and play before us. And Joab said, Let them arise."],["15",[["καὶ",707031,7],["ἀνέστησαν",701173,150],["καὶ",707031,7],["παρῆλθον",710141,150],["ἐν",704639,0],["ἀριθμῷ",701744,114],["τῶν",709436,80],["παίδων",709932,81],["Βενιαμιν",702650,18],["δώδεκα",703887,59],["τῶν",709436,80],["Ιεβοσθε",706516,18],["υἱοῦ",713075,18],["Σαουλ",711499,18],["καὶ",707031,7],["δώδεκα",703887,59],["ἐκ",704132,0],["τῶν",709436,80],["παίδων",709932,81],["Δαυιδ",703232,118]],"And there arose and passed over by number twelve of the children of Benjamin, belonging to Jebosthe the son of Saul, and twelve of the servants of David."],["16",[["καὶ",707031,7],["ἐκράτησαν",707879,150],["ἕκαστος",704133,14],["τῇ",709436,100],["χειρὶ",713787,1],["τὴν",709436,8],["κεφαλὴν",707639,9],["τοῦ",709436,35],["πλησίον",710547,28],["αὐτοῦ",702165,102],["καὶ",707031,7],["μάχαιρα",708593,12],["αὐτοῦ",702165,102],["εἰς",704105,0],["πλευρὰν",710524,9],["τοῦ",709436,35],["πλησίον",710547,28],["αὐτοῦ",702165,102],["καὶ",707031,7],["πίπτουσιν",710481,197],["κατὰ",707200,0],["τὸ",709436,24],["αὐτό",702165,129],["καὶ",707031,7],["ἐκλήθη",707084,37],["τὸ",709436,24],["ὄνομα",709666,25],["τοῦ",709436,35],["τόπου",712903,18],["ἐκείνου",704183,102],["μερὶς",708748,12],["τῶν",709436,80],["ἐπιβούλων",705095,65],["ἥ",709781,177],["ἐστιν",704093,91],["ἐν",704639,0],["Γαβαων",702858,1]],"And they seized every one the head of his neighbour with his hand, and his sword [was thrust] into the side of his neighbour, and they fall down together: and the name of that place was called The portion of the treacherous ones, which is in Gabaon."],["17",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὁ",709436,3],["πόλεμος",710605,4],["σκληρὸς",711861,14],["ὥστε",714164,7],["λίαν",708184,28],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["καὶ",707031,7],["ἔπταισεν",711048,2],["Αβεννηρ",700049,4],["καὶ",707031,7],["ἄνδρες",701150,52],["Ισραηλ",706839,18],["ἐνώπιον",704823,0],["παίδων",709932,81],["Δαυιδ",703232,18]],"And the battle was very severe on that day; and Abenner and the men of Israel were worsted before the servants of David."],["18",[["καὶ",707031,7],["ἐγένοντο",703104,189],["ἐκεῖ",704181,28],["τρεῖς",712927,592],["υἱοὶ",713075,52],["Σαρουιας",711540,18],["Ιωαβ",706877,4],["καὶ",707031,7],["Αβεσσα",700051,4],["καὶ",707031,7],["Ασαηλ",701877,4],["καὶ",707031,28],["Ασαηλ",701877,4],["κοῦφος",707863,14],["τοῖς",709436,147],["ποσὶν",710707,148],["αὐτοῦ",702165,102],["ὡσεὶ",714159,28],["μία",704106,29],["δορκὰς",703801,12],["ἐν",704639,0],["ἀγρῷ",700196,114]],"And there were there the three sons of Saruia, Joab, and Abessa, and Asael: and Asael was swift in his feet as a roe in the field."],["19",[["καὶ",707031,7],["κατεδίωξεν",707243,2],["Ασαηλ",701877,4],["ὀπίσω",709697,28],["Αβεννηρ",700049,6],["καὶ",707031,7],["οὐκ",709805,28],["ἐξέκλινεν",704220,13],["τοῦ",709436,20],["πορεύεσθαι",710667,110],["εἰς",704105,0],["δεξιὰ",703360,68],["οὐδὲ",709816,7],["εἰς",704105,0],["ἀριστερὰ",701749,68],["κατόπισθεν",707544,28],["Αβεννηρ",700049,6]],"And Asael followed after Abenner, and turned not to go to the right hand or to the left from following Abenner."],["20",[["καὶ",707031,7],["ἐπέβλεψεν",705088,2],["Αβεννηρ",700049,4],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,28],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["εἰ",704071,11],["σὺ",712181,164],["εἶ",704093,154],["αὐτὸς",702165,121],["Ασαηλ",701877,4],["καὶ",707031,7],["εἶπεν",705373,2],["ἐγώ",704018,164],["εἰμι",704093,157]],"And Abenner looked behind him, and said, Art thou Asael himself? and he said, I am."],["21",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["Αβεννηρ",700049,4],["ἔκκλινον",704220,176],["σὺ",712181,164],["εἰς",704105,0],["τὰ",709436,41],["δεξιὰ",703360,68],["ἢ",705924,7],["εἰς",704105,0],["τὰ",709436,41],["ἀριστερὰ",701749,68],["καὶ",707031,7],["κάτασχε",707526,176],["σαυτῷ",711599,50],["ἓν",704106,46],["τῶν",709436,43],["παιδαρίων",709923,44],["καὶ",707031,7],["λαβὲ",708076,176],["σεαυτῷ",711599,50],["τὴν",709436,8],["πανοπλίαν",709968,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ἠθέλησεν",706176,2],["Ασαηλ",701877,4],["ἐκκλῖναι",704220,106],["ἐκ",704132,0],["τῶν",709436,80],["ὄπισθεν",709691,28],["αὐτοῦ",702165,102]],"And Abenner said to him, Turn thou to the right hand or to the left, and lay hold for thyself on one of the young men, and take to thyself his armour: but Asael would not turn back from following him."],["22",[["καὶ",707031,7],["προσέθετο",710965,23],["ἔτι",705538,28],["Αβεννηρ",700049,4],["λέγων",708124,72],["τῷ",709436,113],["Ασαηλ",701877,114],["ἀπόστηθι",702214,22],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["ἵνα",706747,7],["μὴ",708851,28],["πατάξω",710185,207],["σε",711598,163],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["πῶς",711121,28],["ἀρῶ",700473,165],["τὸ",709436,24],["πρόσωπόν",710986,25],["μου",709032,133],["πρὸς",710844,0],["Ιωαβ",706877,6],["καὶ",707031,7],["ποῦ",710706,28],["ἐστιν",704093,91],