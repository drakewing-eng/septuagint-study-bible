[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["μετὰ",708780,0],["τὸ",709436,24],["ἀποθανεῖν",701461,106],["Σαουλ",711499,6],["καὶ",707031,7],["Δαυιδ",703232,6],["ἀνέστρεψεν",701060,2],["τύπτων",713022,72],["τὸν",709436,5],["Αμαληκ",700759,6],["καὶ",707031,7],["ἐκάθισεν",707006,2],["Δαυιδ",703232,6],["ἐν",704639,0],["Σεκελακ",711635,76],["ἡμέρας",705984,39],["δύο",703849,588]],"And it came to pass after Saul was dead, that David returned from smiting Amalec, and David abode two days in Sekelac."],["2",[["καὶ",707031,7],["ἐγενήθη",703104,37],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["τρίτῃ",712968,101],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἀνὴρ",701150,4],["ἦλθεν",705453,2],["ἐκ",704132,0],["τῆς",709436,16],["παρεμβολῆς",710133,17],["ἐκ",704132,0],["τοῦ",709436,35],["λαοῦ",708094,18],["Σαουλ",711499,18],["καὶ",707031,7],["τὰ",709436,63],["ἱμάτια",706742,64],["αὐτοῦ",702165,102],["διερρωγότα",703565,586],["καὶ",707031,7],["γῆ",703083,12],["ἐπὶ",705080,0],["τῆς",709436,16],["κεφαλῆς",707639,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["τῷ",709436,53],["εἰσελθεῖν",704114,106],["αὐτὸν",702165,85],["πρὸς",710844,0],["Δαυιδ",703232,6],["καὶ",707031,7],["ἔπεσεν",710481,2],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["προσεκύνησεν",710925,2],["αὐτῷ",702165,50]],"And it came to pass on the third day, that, behold, a man came from the camp, from the people of Saul, and his garments were rent, and earth [was] upon his head: and it came to pass when he went in to David, that he fell upon the earth, and did obeisance to him."],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["Δαυιδ",703232,4],["πόθεν",710580,28],["σὺ",712181,164],["παραγίνῃ",710006,278],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτόν",702165,85],["ἐκ",704132,0],["τῆς",709436,16],["παρεμβολῆς",710133,17],["Ισραηλ",706839,118],["ἐγὼ",704018,164],["διασέσῳσμαι",703599,326]],"And David said to him, Whence comest thou? and he said to him, I have escaped out of the camp of Israel."],["4",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["Δαυιδ",703232,4],["τίς",712867,158],["ὁ",709436,3],["λόγος",708236,4],["οὗτος",709858,121],["ἀπάγγειλόν",701321,176],["μοι",708974,159],["καὶ",707031,7],["εἶπεν",705373,2],["ὅτι",709803,7],["ἔφυγεν",713433,2],["ὁ",709436,3],["λαὸς",708094,4],["ἐκ",704132,0],["τοῦ",709436,35],["πολέμου",710605,18],["καὶ",707031,7],["πεπτώκασι",710481,353],["πολλοὶ",710646,138],["ἐκ",704132,0],["τοῦ",709436,35],["λαοῦ",708094,18],["καὶ",707031,7],["ἀπέθανον",701461,150],["καὶ",707031,28],["ἀπέθανεν",701461,2],["καὶ",707031,7],["Σαουλ",711499,4],["καὶ",707031,7],["Ιωναθαν",706927,4],["ὁ",709436,3],["υἱὸς",713075,4],["αὐτοῦ",702165,102],["ἀπέθανεν",701461,2]],"And David said to him, What [is] the matter? tell me. And he said, The people fled out of the battle, and many of the people have fallen and are dead, and Saul and Jonathan his son are dead."],["5",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["τῷ",709436,53],["παιδαρίῳ",709923,54],["τῷ",709436,53],["ἀπαγγέλλοντι",701321,98],["αὐτῷ",702165,50],["πῶς",711121,28],["οἶδας",709492,266],["ὅτι",709803,7],["τέθνηκεν",706278,171],["Σαουλ",711499,4],["καὶ",707031,7],["Ιωναθαν",706927,4],["ὁ",709436,3],["υἱὸς",713075,4],["αὐτοῦ",702165,102]],"And David said to the young man who brought him the tidings, How knowest thou that Saul and Jonathan his son are dead?"],["6",[["καὶ",707031,7],["εἶπεν",705373,2],["τὸ",709436,34],["παιδάριον",709923,15],["τὸ",709436,34],["ἀπαγγέλλον",701321,32],["αὐτῷ",702165,50],["περιπτώματι",710373,54],["περιέπεσον",710364,155],["ἐν",704639,0],["τῷ",709436,53],["ὄρει",709768,54],["τῷ",709436,113],["Γελβουε",703020,114],["καὶ",707031,7],["ἰδοὺ",706497,88],["Σαουλ",711499,4],["ἐπεστήρικτο",705270,19],["ἐπὶ",705080,0],["τὸ",709436,24],["δόρυ",703804,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἰδοὺ",706497,88],["τὰ",709436,63],["ἅρματα",701768,64],["καὶ",707031,7],["οἱ",709436,136],["ἱππάρχαι",706784,52],["συνῆψαν",712404,150],["αὐτῷ",702165,50]],"And the young man that brought the tidings, said to him, I happened accidentally to be upon mount Gelbue; and, behold, Saul was leaning upon his spear, and, behold, the chariots and captains of horse pressed hard upon him."],["7",[["καὶ",707031,7],["ἐπέβλεψεν",705088,2],["ἐπὶ",705080,0],["τὰ",709436,41],["ὀπίσω",709697,28],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶδέν",709725,2],["με",708618,163],["καὶ",707031,7],["ἐκάλεσέν",707084,2],["με",708618,163],["καὶ",707031,7],["εἶπα",705373,155],["ἰδοὺ",706497,88],["ἐγώ",704018,164]],"And he looked behind him, and saw me, and called me; and I said, Behold, [here am] I."],["8",[["καὶ",707031,7],["εἶπέν",705373,2],["μοι",708974,159],["τίς",712867,158],["εἶ",704093,154],["σύ",712181,164],["καὶ",707031,7],["εἶπα",705373,155],["Αμαληκίτης",700760,4],["ἐγώ",704018,164],["εἰμι",704093,157]],"And he said to me, Who art thou? and I said, I am an Amalekite."],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["πρός",710844,0],["με",708618,163],["στῆθι",706846,244],["δὴ",703395,11],["ἐπάνω",705030,28],["μου",709032,133],["καὶ",707031,7],["θανάτωσόν",706097,176],["με",708618,163],["ὅτι",709803,7],["κατέσχεν",707526,2],["με",708618,163],["σκότος",711889,25],["δεινόν",703328,46],["ὅτι",709803,7],["πᾶσα",710177,29],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ἐν",704639,0],["ἐμοί",704577,159]],"And he said to me, Stand, I pray thee, over me, and slay me, for a dreadful darkness has come upon me, for all my life [is] in me."],["10",[["καὶ",707031,7],["ἐπέστην",705756,155],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐθανάτωσα",706097,155],["αὐτόν",702165,85],["ὅτι",709803,7],["ᾔδειν",709492,499],["ὅτι",709803,7],["οὐ",709805,28],["ζήσεται",705851,93],["μετὰ",708780,0],["τὸ",709436,24],["πεσεῖν",710481,106],["αὐτόν",702165,85],["καὶ",707031,7],["ἔλαβον",708076,155],["τὸ",709436,24],["βασίλειον",702578,25],["τὸ",709436,24],["ἐπὶ",705080,0],["τὴν",709436,8],["κεφαλὴν",707639,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὸν",709436,5],["χλιδῶνα",713876,6],["τὸν",709436,5],["ἐπὶ",705080,0],["τοῦ",709436,35],["βραχίονος",702808,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐνήνοχα",713428,89],["αὐτὰ",702165,71],["τῷ",709436,113],["κυρίῳ",707996,114],["μου",709032,133],["ὧδε",714090,28]],"So I stood over him and slew him, because I knew he would not live after he was fallen; and I took the crown that was upon his head, and the bracelet that was upon his arm, and I have brought them hither to my lord."],["11",[["καὶ",707031,7],["ἐκράτησεν",707879,2],["Δαυιδ",703232,4],["τῶν",709436,43],["ἱματίων",706742,44],["αὐτοῦ",702165,102],["καὶ",707031,7],["διέρρηξεν",703565,2],["αὐτά",702165,71],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["ἄνδρες",701150,52],["οἱ",709436,136],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["διέρρηξαν",703565,150],["τὰ",709436,41],["ἱμάτια",706742,42],["αὐτῶν",702165,40]],"And David laid hold of his garments, and rent them; and all the men who were with him rent their garments."],["12",[["καὶ",707031,7],["ἐκόψαντο",707829,189],["καὶ",707031,7],["ἔκλαυσαν",707703,150],["καὶ",707031,7],["ἐνήστευσαν",709304,150],["ἕως",705792,7],["δείλης",703324,82],["ἐπὶ",705080,0],["Σαουλ",711499,114],["καὶ",707031,7],["ἐπὶ",705080,0],["Ιωναθαν",706927,114],["τὸν",709436,5],["υἱὸν",713075,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸν",709436,5],["λαὸν",708094,6],["Ιουδα",706768,118],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸν",709436,5],["οἶκον",709516,6],["Ισραηλ",706839,118],["ὅτι",709803,7],["ἐπλήγησαν",710550,99],["ἐν",704639,0],["ῥομφαίᾳ",711291,1]],"And they lamented, and wept, and fasted till evening, for Saul and for Jonathan his son, and for the people of Juda, and for the house of Israel, because they were smitten with the sword."],["13",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["τῷ",709436,53],["παιδαρίῳ",709923,54],["τῷ",709436,53],["ἀπαγγέλλοντι",701321,98],["αὐτῷ",702165,50],["πόθεν",710580,28],["εἶ",704093,154],["σύ",712181,164],["καὶ",707031,7],["εἶπεν",705373,2],["υἱὸς",713075,4],["ἀνδρὸς",701150,18],["παροίκου",710159,116],["Αμαληκίτου",700760,18],["ἐγώ",704018,164],["εἰμι",704093,157]],"And David said to the young man who brought the tidings to him, Whence art thou? and he said, I am the son of an Amalekite sojourner."],["14",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["Δαυιδ",703232,4],["πῶς",711121,28],["οὐκ",709805,28],["ἐφοβήθης",713532,168],["ἐπενεγκεῖν",705322,106],["χεῖρά",713787,9],["σου",711945,133],["διαφθεῖραι",703624,106],["τὸν",709436,5],["χριστὸν",713964,6],["κυρίου",707996,18]],"And David said to him, How was it thou wast not afraid to lift thy hand to destroy the anointed of the Lord?"],["15",[["καὶ",707031,7],["ἐκάλεσεν",707084,2],["Δαυιδ",703232,4],["ἓν",704106,46],["τῶν",709436,43],["παιδαρίων",709923,44],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["προσελθὼν",710890,182],["ἀπάντησον",701345,176],["αὐτῷ",702165,50],["καὶ",707031,7],["ἐπάταξεν",710185,2],["αὐτόν",702165,85],["καὶ",707031,7],["ἀπέθανεν",701461,2]],"And David called one of his young men, and said, Go and fall upon him: and he smote him, and he died."],["16",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["πρὸς",710844,0],["αὐτόν",702165,85],["τὸ",709436,34],["αἷμά",700442,15],["σου",711945,133],["ἐπὶ",705080,0],["τὴν",709436,8],["κεφαλήν",707639,9],["σου",711945,133],["ὅτι",709803,7],["τὸ",709436,34],["στόμα",712125,15],["σου",711945,133],["ἀπεκρίθη",701492,37],["κατὰ",707200,0],["σοῦ",711945,133],["λέγων",708124,72],["ὅτι",709803,7],["ἐγὼ",704018,164],["ἐθανάτωσα",706097,155],["τὸν",709436,5],["χριστὸν",713964,6],["κυρίου",707996,18]],"And David said to him, Thy blood [be] upon thine own head; for thy mouth has testified against thee, saying, I have slain the anointed of the Lord."],["17",[["καὶ",707031,7],["ἐθρήνησεν",706306,2],["Δαυιδ",703232,4],["τὸν",709436,5],["θρῆνον",706309,6],["τοῦτον",709858,85],["ἐπὶ",705080,0],["Σαουλ",711499,6],["καὶ",707031,7],["ἐπὶ",705080,0],["Ιωναθαν",706927,6],["τὸν",709436,5],["υἱὸν",713075,6],["αὐτοῦ",702165,102]],"And David lamented with this lamentation over Saul and over Jonathan his son."],["18",[["καὶ",707031,7],["εἶπεν",705373,2],["τοῦ",709436,20],["διδάξαι",703649,106],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ιουδα",706768,18],["ἰδοὺ",706497,88],["γέγραπται",703194,187],["ἐπὶ",705080,0],["βιβλίου",702719,21],["τοῦ",709436,35],["εὐθοῦς",705596,116]],"And he gave orders to teach it the sons of Juda: behold, it is written in the book of Right."],["19",[["στήλωσον",712094,176],["Ισραηλ",706839,4],["ὑπὲρ",713111,0],["τῶν",709436,80],["τεθνηκότων",706278,387],["ἐπὶ",705080,0],["τὰ",709436,41],["ὕψη",713288,42],["σου",711945,133],["τραυματιῶν",712921,81],["πῶς",711121,28],["ἔπεσαν",710481,150],["δυνατοί",703845,138]],"Set up a pillar, O Israel, for the slain that died upon thy high places: how are the mighty fallen!"],["20",[["μὴ",708851,28],["ἀναγγείλητε",700921,125],["ἐν",704639,0],["Γεθ",703005,111],["καὶ",707031,7],["μὴ",708851,28],["εὐαγγελίσησθε",705547,142],["ἐν",704639,0],["ταῖς",709436,75],["ἐξόδοις",704948,76],["Ἀσκαλῶνος",701962,118],["μήποτε",708882,28],["εὐφρανθῶσιν",705715,272],["θυγατέρες",706320,191],["ἀλλοφύλων",700706,169],["μήποτε",708882,28],["ἀγαλλιάσωνται",700114,232],["θυγατέρες",706320,191],["τῶν",709436,80],["ἀπεριτμήτων",701397,169]],"Tell it not in Geth, and tell it not as glad tidings in the streets of Ascalon, lest the daughters of the Philistines rejoice, lest the daughters of the uncircumcised triumph."],["21",[["ὄρη",709768,589],["τὰ",709436,590],["ἐν",704639,0],["Γελβουε",703020,111],["μὴ",708851,28],["καταβῇ",707202,172],["δρόσος",703835,12],["καὶ",707031,7],["μὴ",708851,28],["ὑετὸς",713074,4],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["καὶ",707031,7],["ἀγροὶ",700196,52],["ἀπαρχῶν",701359,65],["ὅτι",709803,7],["ἐκεῖ",704181,28],["προσωχθίσθη",710945,37],["θυρεὸς",706338,4],["δυνατῶν",703845,169],["θυρεὸς",706338,4],["Σαουλ",711499,18],["οὐκ",709805,28],["ἐχρίσθη",713965,37],["ἐν",704639,0],["ἐλαίῳ",704380,54]],"Ye mountains of Gelbue, let not dew nor rain descend upon you, nor fields of first-fruits [be upon you], for there the shield of the mighty ones has been grievously assailed; the shield of Saul was not anointed with oil."],["22",[["ἀφ᾿",701425,0],["αἵματος",700442,21],["τραυματιῶν",712921,81],["ἀπὸ",701425,0],["στέατος",712054,21],["δυνατῶν",703845,169],["τόξον",712898,15],["Ιωναθαν",706927,6],["οὐκ",709805,28],["ἀπεστράφη",701598,37],["κενὸν",707612,27],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,28],["καὶ",707031,7],["ῥομφαία",711291,12],["Σαουλ",711499,18],["οὐκ",709805,28],["ἀνέκαμψεν",700969,2],["κενή",707612,29]],"From the blood of the slain, and from the fat of the mighty, the bow of Jonathan returned not empty; and the sword of Saul turned not back empty."],["23",[["Σαουλ",711499,4],["καὶ",707031,7],["Ιωναθαν",706927,4],["οἱ",709436,136],["ἠγαπημένοι",700120,429],["καὶ",707031,7],["ὡραῖοι",714132,138],["οὐ",709805,28],["διακεχωρισμένοι",703640,429],["εὐπρεπεῖς",705667,138],["ἐν",704639,0],["τῇ",709436,100],["ζωῇ",705910,1],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["θανάτῳ",706096,114],["αὐτῶν",702165,40],["οὐ",709805,28],["διεχωρίσθησαν",703640,99],["ὑπὲρ",713111,0],["ἀετοὺς",700318,57],["κοῦφοι",707863,138],["καὶ",707031,7],["ὑπὲρ",713111,0],["λέοντας",708171,57],["ἐκραταιώθησαν",707875,99]],"Saul and Jonathan, the beloved and the beautiful, were not divided: comely [were they] in their life, and in their death they were not divided: [they were] swifter than eagles, and they were stronger than lions."],["24",[["θυγατέρες",706320,191],["Ισραηλ",706839,18],["ἐπὶ",705080,0],["Σαουλ",711499,114],["κλαύσατε",707703,74],["τὸν",709436,5],["ἐνδιδύσκοντα",704688,183],["ὑμᾶς",713080,194],["κόκκινα",707783,68],["μετὰ",708780,0],["κόσμου",707851,18],["ὑμῶν",713091,145],["τὸν",709436,5],["ἀναφέροντα",701083,183],["κόσμον",707851,6],["χρυσοῦν",713971,27],["ἐπὶ",705080,0],["τὰ",709436,41],["ἐνδύματα",704698,42],["ὑμῶν",713091,145]],"Daughters of Israel, weep for Saul, who clothed you with scarlet together with your adorning, who added golden ornaments to your apparel."],["25",[["πῶς",711121,28],["ἔπεσαν",710481,150],["δυνατοὶ",703845,138],["ἐν",704639,0],["μέσῳ",708768,30],["τοῦ",709436,35],["πολέμου",710605,18],["Ιωναθαν",706925,4],["ἐπὶ",705080,0],["τὰ",709436,41],["ὕψη",713288,42],["σου",711945,133],["τραυματίας",712921,4]],"How are the mighty fallen in the midst of the battle! O Jonathan, even the slain ones upon thy high places!"],["26",[["ἀλγῶ",700638,157],["ἐπὶ",705080,0],["σοί",711925,159],["ἄδελφέ",700249,153],["μου",709032,133],["Ιωναθαν",706925,153],["ὡραιώθης",714131,168],["μοι",708974,159],["σφόδρα",712586,28],["ἐθαυμαστώθη",706135,37],["ἡ",709436,10],["ἀγάπησίς",700123,12],["σου",711945,133],["ἐμοὶ",704577,159],["ὑπὲρ",713111,0],["ἀγάπησιν",700123,9],["γυναικῶν",703209,65]],"I am grieved for thee, my brother Jonathan; thou wast very lovely to me; thy love to me was wonderful beyond the love of women."],["27",[["πῶς",711121,28],["ἔπεσαν",710481,150],["δυνατοὶ",703845,138],["καὶ",707031,7],["ἀπώλοντο",701513,189],["σκεύη",711844,64],["πολεμικά",710602,195]],"How are the mighty fallen, and the weapons of war perished!"]]