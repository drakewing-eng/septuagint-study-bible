[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["μετὰ",708780,0],["ταῦτα",709858,71],["καὶ",707031,7],["ἐπάταξεν",710185,2],["Δαυιδ",703232,4],["τοὺς",709436,58],["ἀλλοφύλους",700706,60],["καὶ",707031,7],["ἐτροπώσατο",712981,23],["αὐτούς",702165,62],["καὶ",707031,7],["ἔλαβεν",708076,2],["Δαυιδ",703232,4],["τὴν",709436,8],["ἀφωρισμένην",702227,444],["ἐκ",704132,0],["χειρὸς",713787,17],["τῶν",709436,80],["ἀλλοφύλων",700706,169]],"And it came to pass after this, that David smote the Philistines, and put them to flight, and David took the tribute from out of the hand of the Philistines."],["2",[["καὶ",707031,7],["ἐπάταξεν",710185,2],["Δαυιδ",703232,4],["τὴν",709436,8],["Μωαβ",709085,227],["καὶ",707031,7],["διεμέτρησεν",703520,2],["αὐτοὺς",702165,62],["ἐν",704639,0],["σχοινίοις",712610,96],["κοιμίσας",707769,182],["αὐτοὺς",702165,62],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἐγένετο",703104,23],["τὰ",709436,63],["δύο",703849,597],["σχοινίσματα",712611,64],["τοῦ",709436,20],["θανατῶσαι",706097,106],["καὶ",707031,7],["τὰ",709436,41],["δύο",703849,591],["σχοινίσματα",712611,42],["ἐζώγρησεν",705906,2],["καὶ",707031,7],["ἐγένετο",703104,23],["Μωαβ",709085,313],["τῷ",709436,113],["Δαυιδ",703232,114],["εἰς",704105,0],["δούλους",703817,57],["φέροντας",713428,235],["ξένια",709410,42]],"And David smote Moab, and measured them out with lines, having laid them down on the ground: and there were two lines for slaying, and two lines he kept alive: and Moab became servants to David, yielding tribute."],["3",[["καὶ",707031,7],["ἐπάταξεν",710185,2],["Δαυιδ",703232,4],["τὸν",709436,5],["Αδρααζαρ",700288,6],["υἱὸν",713075,6],["Ρααβ",711123,18],["βασιλέα",702580,6],["Σουβα",711948,118],["πορευομένου",710667,262],["αὐτοῦ",702165,102],["ἐπιστῆσαι",705756,106],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τὸν",709436,5],["ποταμὸν",710693,6],["Εὐφράτην",705716,227]],"And David smote Adraazar the son of Raab king of Suba, as he went to extend his power to the river Euphrates."],["4",[["καὶ",707031,7],["προκατελάβετο",710809,23],["Δαυιδ",703232,4],["τῶν",709436,80],["αὐτοῦ",702165,102],["χίλια",713859,68],["ἅρματα",701768,42],["καὶ",707031,7],["ἑπτὰ",705357,59],["χιλιάδας",713858,39],["ἱππέων",706786,81],["καὶ",707031,7],["εἴκοσι",704085,59],["χιλιάδας",713858,39],["ἀνδρῶν",701150,81],["πεζῶν",710219,169],["καὶ",707031,7],["παρέλυσεν",710070,2],["Δαυιδ",703232,4],["πάντα",710177,68],["τὰ",709436,41],["ἅρματα",701768,42],["καὶ",707031,7],["ὑπελίπετο",713212,23],["ἐξ",704132,0],["αὐτῶν",702165,40],["ἑκατὸν",704136,59],["ἅρματα",701768,42]],"And David took a thousand of his chariots, and seven thousand horsemen, and twenty thousand footmen: and David houghed all his chariot [horses], and he reserved to himself a hundred chariots."],["5",[["καὶ",707031,7],["παραγίνεται",710006,117],["Συρία",712533,52],["Δαμασκοῦ",703275,17],["βοηθῆσαι",702746,106],["τῷ",709436,113],["Αδρααζαρ",700288,114],["βασιλεῖ",702580,114],["Σουβα",711948,118],["καὶ",707031,7],["ἐπάταξεν",710185,2],["Δαυιδ",703232,4],["ἐν",704639,0],["τῷ",709436,113],["Σύρῳ",712541,114],["εἴκοσι",704085,59],["δύο",703849,588],["χιλιάδας",713858,39],["ἀνδρῶν",701150,81]],"And Syria of Damascus comes to help Adraazar king of Suba, and David smote twenty-two thousand men belonging to the Syrian."],["6",[["καὶ",707031,7],["ἔθετο",712849,23],["Δαυιδ",703232,4],["φρουρὰν",713593,9],["ἐν",704639,0],["Συρίᾳ",712533,114],["τῇ",709436,100],["κατὰ",707200,0],["Δαμασκόν",703275,9],["καὶ",707031,7],["ἐγένετο",703104,23],["ὁ",709436,3],["Σύρος",712541,4],["τῷ",709436,113],["Δαυιδ",703232,114],["εἰς",704105,0],["δούλους",703817,57],["φέροντας",713428,235],["ξένια",709410,42],["καὶ",707031,7],["ἔσωσεν",712627,2],["κύριος",707996,4],["τὸν",709436,5],["Δαυιδ",703232,6],["ἐν",704639,0],["πᾶσιν",710177,230],["οἷς",709781,311],["ἐπορεύετο",710667,19]],"And David placed a garrison in Syria near Damascus, and the Syrians became servants and tributaries to David: and the Lord preserved David whithersoever he went."],["7",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Δαυιδ",703232,4],["τοὺς",709436,58],["χλιδῶνας",713876,57],["τοὺς",709436,58],["χρυσοῦς",713971,14],["οἳ",709781,250],["ἦσαν",704093,137],["ἐπὶ",705080,0],["τῶν",709436,80],["παίδων",709932,81],["τῶν",709436,80],["Αδρααζαρ",700288,18],["βασιλέως",702580,18],["Σουβα",711948,18],["καὶ",707031,7],["ἤνεγκεν",713428,2],["αὐτὰ",702165,71],["εἰς",704105,0],["Ιερουσαλημ",706644,6],["καὶ",707031,7],["ἔλαβεν",708076,2],["αὐτὰ",702165,71],["Σουσακιμ",711968,4],["βασιλεὺς",702580,4],["Αἰγύπτου",700401,18],["ἐν",704639,0],["τῷ",709436,53],["ἀναβῆναι",700905,106],["αὐτὸν",702165,85],["εἰς",704105,0],["Ιερουσαλημ",706644,6],["ἐν",704639,0],["ἡμέραις",705984,76],["Ροβοαμ",711276,18],["υἱοῦ",713075,18],["Σολομῶντος",711929,18]],"And David took the golden bracelets which were on the servants of Adraazar king of Suba, and brought them to Jerusalem. And Susakim king of Egypt took them, when he went up to Jerusalem in the days of Roboam son of Solomon."],["8",[["καὶ",707031,7],["ἐκ",704132,0],["τῆς",709436,16],["Μασβακ",708540,17],["ἐκ",704132,0],["τῶν",709436,130],["ἐκλεκτῶν",704240,198],["πόλεων",710612,65],["τοῦ",709436,35],["Αδρααζαρ",700288,18],["ἔλαβεν",708076,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["Δαυιδ",703232,4],["χαλκὸν",713695,6],["πολὺν",710646,27],["σφόδρα",712586,28],["ἐν",704639,0],["αὐτῷ",702165,50],["ἐποίησεν",710582,2],["Σαλωμων",711430,4],["τὴν",709436,8],["θάλασσαν",706069,9],["τὴν",709436,8],["χαλκῆν",713690,36],["καὶ",707031,7],["τοὺς",709436,58],["στύλους",712179,57],["καὶ",707031,7],["τοὺς",709436,58],["λουτῆρας",708256,57],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["σκεύη",711844,42]],"And king David took from Metebac, and from the choice cities of Adraazar, very much brass: with that Solomon made the brazen sea, and the pillars, and the lavers, and all the furniture."],["9",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Θοου",706290,4],["ὁ",709436,3],["βασιλεὺς",70