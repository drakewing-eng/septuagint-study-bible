4148,7],["ἡμεῖς",705983,219],["δέκα",703333,59],["χιλιάδες",713858,191],["καὶ",707031,7],["νῦν",709384,28],["ἀγαθὸν",700106,46],["ὅτι",709803,7],["ἔσῃ",704093,123],["ἡμῖν",705994,90],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["βοήθεια",702745,12],["τοῦ",709436,20],["βοηθεῖν",702746,55]],"And they said, Thou shalt not go out: for if we should indeed flee, they will not care for us; and if half of us should die, they will not mind us; for thou [art] as ten thousand of us: and now [it is] well that thou shalt be to us an aid to help us in the city."],["4",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτοὺς",702165,62],["ὁ",709436,3],["βασιλεύς",702580,4],["ὃ",709781,33],["ἐὰν",703912,7],["ἀρέσῃ",701722,123],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["ὑμῶν",713091,145],["ποιήσω",710582,165],["καὶ",707031,7],["ἔστη",706846,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἀνὰ",700902,0],["χεῖρα",713787,9],["τῆς",709436,16],["πύλης",711082,17],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["ἐξεπορεύετο",704293,19],["εἰς",704105,0],["ἑκατοντάδας",704141,39],["καὶ",707031,7],["εἰς",704105,0],["χιλιάδας",713858,39]],"And the king said to them, Whatsoever shall seem good in your eyes I will do. And the king stood by the side of the gate, and all the people went out by hundreds and by thousands."],["5",[["καὶ",707031,7],["ἐνετείλατο",704791,23],["ὁ",709436,3],["βασιλεὺς",702580,4],["τῷ",709436,113],["Ιωαβ",706877,114],["καὶ",707031,7],["τῷ",709436,113],["Αβεσσα",700051,114],["καὶ",707031,7],["τῷ",709436,113],["Εθθι",704059,114],["λέγων",708124,72],["φείσασθέ",713406,186],["μοι",708974,159],["τοῦ",709436,20],["παιδαρίου",709923,21],["τοῦ",709436,35],["Αβεσσαλωμ",700052,18],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["ἤκουσεν",700587,2],["ἐντελλομένου",704791,262],["τοῦ",709436,35],["βασιλέως",702580,18],["πᾶσιν",710177,230],["τοῖς",709436,147],["ἄρχουσιν",701862,148],["ὑπὲρ",713111,0],["Αβεσσαλωμ",700052,18]],"And the king commanded Joab and Abessa and Ethi, saying, Spare for my sake the young man Abessalom. And all the people heard the king charging all the commanders concerning Abessalom."],["6",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["εἰς",704105,0],["τὸν",709436,5],["δρυμὸν",703836,6],["ἐξ",704132,0],["ἐναντίας",704656,82],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐγένετο",703104,23],["ὁ",709436,3],["πόλεμος",710605,4],["ἐν",704639,0],["τῷ",709436,113],["δρυμῷ",703836,114],["Εφραιμ",705769,118]],"And all the people went out into the wood against Israel; and the battle was in the wood of Ephraim."],["7",[["καὶ",707031,7],["ἔπταισεν",711048,2],["ἐκεῖ",704181,28],["ὁ",709436,3],["λαὸς",708094,4],["Ισραηλ",706839,18],["ἐνώπιον",704823,0],["τῶν",709436,80],["παίδων",709932,81],["Δαυιδ",703232,18],["καὶ",707031,7],["ἐγένετο",703104,23],["ἡ",709436,10],["θραῦσις",706301,12],["μεγάλη",708653,29],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["εἴκοσι",704085,59],["χιλιάδες",713858,191],["ἀνδρῶν",701150,81]],"And the people of Israel fell down there before the servants of David, and there was a great slaughter in that day, [even] twenty thousand men."],["8",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐκεῖ",704181,28],["ὁ",709436,3],["πόλεμος",710605,4],["διεσπαρμένος",703584,251],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["πάσης",710177,82],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἐπλεόνασεν",710516,2],["ὁ",709436,3],["δρυμὸς",703836,4],["τοῦ",709436,35],["καταφαγεῖν",707519,106],["ἐκ",704132,0],["τοῦ",709436,35],["λαοῦ",708094,18],["ὑπὲρ",713111,0],["οὓς",709781,298],["κατέφαγεν",707519,2],["ἐν",704639,0],["τῷ",709436,113],["λαῷ",708094,114],["ἡ",709436,10],["μάχαιρα",708593,12],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105]],"And the battle there was scattered over the face of all the land: and the wood consumed more of the people than the sword consumed among the people in that day."],["9",[["καὶ",707031,7],["συνήντησεν",712394,2],["Αβεσσαλωμ",700052,4],["ἐνώπιον",704823,0],["τῶν",709436,80],["παίδων",709932,81],["Δαυιδ",703232,4],["καὶ",707031,7],["Αβεσσαλωμ",700052,4],["ἐπιβεβηκὼς",705082,270],["ἐπὶ",705080,0],["τοῦ",709436,35],["ἡμιόνου",705995,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἰσῆλθεν",704114,2],["ὁ",709436,3],["ἡμίονος",705995,4],["ὑπὸ",713184,0],["τὸ",709436,24],["δάσος",703297,25],["τῆς",709436,16],["δρυὸς",703837,17],["τῆς",709436,16],["μεγάλης",708653,82],["καὶ",707031,7],["ἐκρεμάσθη",707892,37],["ἡ",709436,10],["κεφαλὴ",707639,12],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῇ",709436,100],["δρυί",703837,1],["καὶ",707031,7],["ἐκρεμάσθη",707892,37],["ἀνὰ",700902,0],["μέσον",708768,46],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,46],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ὁ",709436,3],["ἡμίονος",705995,4],["ὑποκάτω",713204,28],["αὐτοῦ",702165,102],["παρῆλθεν",710141,2]],"And Abessalom went to meet the servants of David: and Abessalom was mounted on his mule, and the mule came under the thick boughs of a great oak; and his head was entangled in the oak, and he was suspended between heaven and earth; and the mule passed on from under him."],["10",[["καὶ",707031,7],["εἶδεν",709725,2],["ἀνὴρ",701150,4],["εἷς",704106,596],["καὶ",707031,7],["ἀνήγγειλεν",700921,2],["Ιωαβ",706877,114],["καὶ",707031,7],["εἶπεν",705373,2],["ἰδοὺ",706497,88],["ἑώρακα",709725,89],["τὸν",709436,5],["Αβεσσαλωμ",700052,6],["κρεμάμενον",707892,212],["ἐν",704639,0],["τῇ",709436,100],["δρυί",703837,1]],"And a man saw it, and reported to Joab, and said, Behold, I saw Abessalom hanging in an oak."],["11",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιωαβ",706877,4],["τῷ",709436,113],["ἀνδρὶ",701150,114],["τῷ",709436,113],["ἀπαγγέλλοντι",701321,379],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἑόρακας",709725,266],["τί",712867,273],["ὅτι",709803,7],["οὐκ",709805,28],["ἐπάταξας",710185,162],["αὐτὸν",702165,85],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἐγὼ",704018,164],["ἂν",700900,11],["δεδώκειν",703654,115],["σοι",711925,159],["δέκα",703333,59],["ἀργυρίου",701707,21],["καὶ",707031,7],["παραζώνην",710022,9],["μίαν",704106,36]],"And Joab said to the man who reported it to him, And, behold, thou didst see him: why didst thou not smite him there to the ground? and I would have given thee ten [pieces] of silver, and a girdle."],["12",[["εἶπεν",705373,2],["δὲ",703303,11],["ὁ",709436,3],["ἀνὴρ",701150,4],["πρὸς",710844,0],["Ιωαβ",706877,6],["καὶ",707031,7],["ἐγώ",704018,164],["εἰμι",704093,157],["ἵστημι",706846,157],["ἐπὶ",705080,0],["τὰς",709436,38],["χεῖράς",713787,39],["μου",709032,133],["χιλίους",713859,60],["σίκλους",711786,57],["ἀργυρίου",701707,21],["οὐ",709805,28],["μὴ",708851,28],["ἐπιβάλω",705083,207],["χεῖρά",713787,9],["μου",709032,133],["ἐπὶ",705080,0],["τὸν",709436,5],["υἱὸν",713075,6],["τοῦ",709436,35],["βασιλέως",702580,18],["ὅτι",709803,7],["ἐν",704639,0],["τοῖς",709436,95],["ὠσὶν",709852,96],["ἡμῶν",705999,145],["ἐνετείλατο",704791,23],["ὁ",709436,3],["βασιλεὺς",702580,4],["σοὶ",711925,159],["καὶ",707031,7],["Αβεσσα",700051,114],["καὶ",707031,7],["τῷ",709436,113],["Εθθι",704059,114],["λέγων",708124,72],["φυλάξατέ",713619,74],["μοι",708974,159],["τὸ",709436,24],["παιδάριον",709923,25],["τὸν",709436,5],["Αβεσσαλωμ",700052,6]],"And the man said to Joab, Were I even to receive a thousand shekels of silver, I would not lift my hand against the king's son; for in our ears the king charged thee and Abessa and Ethi, saying, Take care of the young man Abessalom for me,"],["13",[["μὴ",708851,28],["ποιῆσαι",710582,106],["ἐν",704639,0],["τῇ",709436,100],["ψυχῇ",714070,1],["αὐτοῦ",702165,102],["ἄδικον",700272,46],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["λόγος",708236,4],["οὐ",709805,28],["λήσεται",708088,93],["ἀπὸ",701425,0],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["σὺ",712181,164],["στήσῃ",706846,123],["ἐξ",704132,0],["ἐναντίας",704656,82]],"so as to do no harm to his life: and nothing of the matter will be concealed from the king, and thou wilt set thyself against me."],["14",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιωαβ",706877,4],["τοῦτο",709858,129],["ἐγὼ",704018,164],["ἄρξομαι",701860,181],["οὐχ",709805,28],["οὕτως",709859,28],["μενῶ",708736,165],["ἐνώπιόν",704823,0],["σου",711945,133],["καὶ",707031,7],["ἔλαβεν",708076,2],["Ιωαβ",706877,4],["τρία",712927,68,46],["βέλη",702644,42],["ἐν",704639,0],["τῇ",709436,100],["χειρὶ",713787,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐνέπηξεν",704590,2],["αὐτὰ",702165,71],["ἐν",704639,0],["τῇ",709436,100],["καρδίᾳ",707141,1],["Αβεσσαλωμ",700052,18],["ἔτι",705538,28],["αὐτοῦ",702165,102],["ζῶντος",705851,152],["ἐν",704639,0],["τῇ",709436,100],["καρδίᾳ",707141,1],["τῆς",709436,16],["δρυὸς",703837,17]],"And Joab said, I will begin this; I will not thus remain with thee. And Joab took three darts in his hand, and thrust them into the heart of Abessalom, while he was yet alive in the heart of the oak."],["15",[["καὶ",707031,7],["ἐκύκλωσαν",707958,150],["δέκα",703333,59],["παιδάρια",709923,64],["αἴροντα",700473,242],["τὰ",709436,41],["σκεύη",711844,42],["Ιωαβ",706877,18],["καὶ",707031,7],["ἐπάταξαν",710185,150],["τὸν",709436,5],["Αβεσσαλωμ",700052,6],["καὶ",707031,7],["ἐθανάτωσαν",706097,150],["αὐτόν",702165,85]],"And ten young men that bore Joab's armour compassed Abessalom, and smote him and slew him."],["16",[["καὶ",707031,7],["ἐσάλπισεν",711425,2],["Ιωαβ",706877,4],["ἐν",704639,0],["κερατίνῃ",707629,1],["καὶ",707031,7],["ἀπέστρεψεν",701598,2],["ὁ",709436,3],["λαὸς",708094,4],["τοῦ",709436,20],["μὴ",708851,28],["διώκειν",703768,55],["ὀπίσω",709697,28],["Ισραηλ",706839,18],["ὅτι",709803,7],["ἐφείδετο",713406,19],["Ιωαβ",706877,4],["τοῦ",709436,35],["λαοῦ",708094,18]],"And Joab blew the trumpet, and the people returned from pursuing Israel, for Joab spared the people."],["17",[["καὶ",707031,7],["ἔλαβεν",708076,2],["τὸν",709436,5],["Αβεσσαλωμ",700052,6],["καὶ",707031,7],["ἔρριψεν",711267,2],["αὐτὸν",702165,85],["εἰς",704105,0],["χάσμα",713768,25],["μέγα",708653,46],["ἐν",704639,0],["τῷ",709436,113],["δρυμῷ",703836,114],["εἰς",704105,0],["τὸν",709436,5],["βόθυνον",702750,6],["τὸν",709436,5],["μέγαν",708653,27],["καὶ",707031,7],["ἐστήλωσεν",712094,2],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["σωρὸν",712650,6],["λίθων",708196,81],["μέγαν",708653,27],["σφόδρα",712586,28],["καὶ",707031,7],["πᾶς",710177,14],["Ισραηλ",706839,4],["ἔφυγεν",713433,2],["ἀνὴρ",701150,4],["εἰς",704105,0],["τὸ",709436,24],["σκήνωμα",711849,25],["αὐτοῦ",702165,102]],"And he took Abessalom, and cast him into a great cavern in the wood, into a deep pit, and set up over him a very great heap of stones: and all Israel fled every man to his tent."],["18",[["καὶ",707031,7],["Αβεσσαλωμ",700052,4],["ἔτι",705538,28],["ζῶν",705851,72],["καὶ",707031,7],["ἔστησεν",706846,2],["ἑαυτῷ",703917,50],["τὴν",709436,8],["στήλην",712092,9],["ἐν",704639,0],["ᾗ",709781,108],["ἐλήμφθη",708076,37],["καὶ",707031,7],["ἐστήλωσεν",712094,2],["αὐτὴν",702165,104],["λαβεῖν",708076,106],["τὴν",709436,8],["στήλην",712092,9],["τὴν",709436,8],["ἐν",704639,0],["τῇ",709436,100],["κοιλάδι",707758,1],["τοῦ",709436,35],["βασιλέως",702580,18],["ὅτι",709803,7],["εἶπεν",705373,2],["οὐκ",709805,28],["ἔστιν",704093,91],["αὐτῷ",702165,50],["υἱὸς",713075,4],["ἕνεκεν",704709,0],["τοῦ",709436,35],["ἀναμνῆσαι",701002,106],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐκάλεσεν",707084,2],["τὴν",709436,8],["στήλην",712092,9],["Χεὶρ",713787,12],["Αβεσσαλωμ",700052,18],["ἕως",705792,7],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86]],"Now Abessalom while yet alive had taken and set up for himself the pillar near which he was taken, and set it up so as to have the pillar in the king's dale; for he said he had no son to keep his name in remembrance: and he called the pillar, Abessalom's hand, until this day."],["19",[["καὶ",707031,7],["Αχιμαας",702280,4],["υἱὸς",713075,4],["Σαδωκ",711375,18],["εἶπεν",705373,2],["δράμω",712931,207],["δὴ",703395,11],["καὶ",707031,7],["εὐαγγελιῶ",705547,165],["τῷ",709436,113],["βασιλεῖ",702580,114],["ὅτι",709803,7],["ἔκρινεν",707905,2],["αὐτῷ",702165,50],["κύριος",707996,4],["ἐκ",704132,0],["χειρὸς",713787,17],["τῶν",709436,80],["ἐχθρῶν",705779,169],["αὐτοῦ",702165,102]],"And Achimaas the son of Sadoc said, Let me run now and carry glad tidings to the king, for the Lord has delivered him from the hand of his enemies."],["20",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["Ιωαβ",706877,4],["οὐκ",709805,28],["ἀνὴρ",701150,4],["εὐαγγελίας",705546,17],["σὺ",712181,164],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ταύτῃ",709858,105],["καὶ",707031,7],["εὐαγγελιῇ",705547,123],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["ἄλλῃ",700697,105],["ἐν",704639,0],["δὲ",703303,11],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ταύτῃ",709858,105],["οὐκ",709805,28],["εὐαγγελιῇ",705547,123],["οὗ",709781,48],["εἵνεκεν",704709,0],["ὁ",709436,3],["υἱὸς",713075,4],["τοῦ",709436,35],["βασιλέως",702580,18],["ἀπέθανεν",701461,2]],"And Joab said to him, Thou [shalt] not [be] a messenger of glad tidings this day; thou shalt bear them another day; but on this day thou shalt bear no tidings, because the king's son is dead."],["21",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιωαβ",706877,4],["τῷ",709436,113],["Χουσι",713933,114],["βαδίσας",702367,182],["ἀνάγγειλον",700921,176],["τῷ",709436,113],["βασιλεῖ",702580,114],["ὅσα",709788,68],["εἶδες",709725,162],["καὶ",707031,7],["προσεκύνησεν",710925,2],["Χουσι",713933,4],["τῷ",709436,113],["Ιωαβ",706877,114],["καὶ",707031,7],["ἐξῆλθεν",704909,2]],"And Joab said to Chusi, Go, report to the king all that thou hast seen. And Chusi did obeisance to Joab, and went out."],["22",[["καὶ",707031,7],["προσέθετο",710965,23],["ἔτι",705538,28],["Αχιμαας",702280,4],["υἱὸς",713075,4],["Σαδωκ",711375,18],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["Ιωαβ",706877,6],["καὶ",7