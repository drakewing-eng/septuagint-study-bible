[["1",[["καὶ",707031,7],["Δαυιδ",703232,4],["παρῆλθεν",710141,2],["βραχύ",702809,46],["τι",712866,126],["ἀπὸ",701425,0],["τῆς",709436,16],["Ροως",711303,17],["καὶ",707031,7],["ἰδοὺ",709725,300],["Σιβα",711765,4],["τὸ",709436,34],["παιδάριον",709923,15],["Μεμφιβοσθε",708726,18],["εἰς",704105,0],["ἀπαντὴν",701346,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ζεῦγος",705865,25],["ὄνων",709671,81],["ἐπισεσαγμένων",705242,387],["καὶ",707031,7],["ἐπ᾿",705080,0],["αὐτοῖς",702165,151],["διακόσιοι",703482,138],["ἄρτοι",701829,52],["καὶ",707031,7],["ἑκατὸν",704136,59],["σταφίδες",712051,191],["καὶ",707031,7],["ἑκατὸν",704136,59],["φοίνικες",713541,52],["καὶ",707031,7],["Νεβελ",709233,354],["οἴνου",709530,18]],"And David passed on a little way from Ros; and, behold, Siba the servant of Memphibosthe [came] to meet him; and he had a couple of asses laden, and upon them two hundred loaves, and a hundred [bunches of] raisins, and a hundred [cakes of] dates, and a bottle of wine."],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["πρὸς",710844,0],["Σιβα",711765,6],["τί",712867,273],["ταῦτά",709858,71],["σοι",711925,159],["καὶ",707031,7],["εἶπεν",705373,2],["Σιβα",711765,4],["τὰ",709436,63],["ὑποζύγια",713198,64],["τῇ",709436,100],["οἰκίᾳ",709505,1],["τοῦ",709436,35],["βασιλέως",702580,18],["τοῦ",709436,20],["ἐπικαθῆσθαι",705149,110],["καὶ",707031,7],["οἱ",709436,136],["ἄρτοι",701829,52],["καὶ",707031,7],["οἱ",709436,136],["φοίνικες",713541,52],["εἰς",704105,0],["βρῶσιν",702825,9],["τοῖς",709436,95],["παιδαρίοις",709923,96],["καὶ",707031,7],["ὁ",709436,3],["οἶνος",709530,4],["πιεῖν",710478,106],["τοῖς",709436,147],["ἐκλελυμένοις",704254,521],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1]],"And the king said to Siba, What meanest thou by these? and Siba said, The asses [are] for the household of the king to sit upon, and the loaves and the dates [are] for the young men to eat, and the wine [is] for them that are faint in the wilderness to drink."],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεύς",702580,4],["καὶ",707031,7],["ποῦ",710706,28],["ὁ",709436,3],["υἱὸς",713075,4],["τοῦ",709436,35],["κυρίου",707996,18],["σου",711945,133],["καὶ",707031,7],["εἶπεν",705373,2],["Σιβα",711765,4],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["ἰδοὺ",706497,88],["κάθηται",707000,117],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["ὅτι",709803,7],["εἶπεν",705373,2],["σήμερον",711751,28],["ἐπιστρέψουσίν",705278,218],["μοι",708974,159],["ὁ",709436,3],["οἶκος",709516,4],["Ισραηλ",706839,18],["τὴν",709436,8],["βασιλείαν",702577,9],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133]],"And the king said, And where [is] the son of thy master? and Siba said to the king, Behold, he remains in Jerusalem; for he said, To-day shall the house of Israel restore to me the kingdom of my father."],["4",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["τῷ",709436,113],["Σιβα",711765,114],["ιδοὺ",706497,88],["σοὶ",711925,159],["πάντα",710177,68],["ὅσα",709788,68],["ἐστὶν",704093,91],["τῷ",709436,113],["Μεμφιβοσθε",708726,114],["καὶ",707031,7],["εἶπεν",705373,2],["Σιβα",711765,4],["προσκυνήσας",710925,182],["εὕροιμι",705676,346],["χάριν",713735,9],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["σου",711945,133],["κύριέ",707996,153],["μου",709032,133],["βασιλεῦ",702580,153]],"And the king said to Siba, Behold, all Memphibosthe's property [is] thine. And Siba did obeisance and said, My lord, O king, let me find grace in thine eyes."],["5",[["καὶ",707031,7],["ἦλθεν",705453,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["Δαυιδ",703232,4],["ἕως",705792,7],["Βαουριμ",702514,227],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἐκεῖθεν",704182,28],["ἀνὴρ",701150,4],["ἐξεπορεύετο",704293,19],["ἐκ",704132,0],["συγγενείας",712184,17],["οἴκου",709516,18],["Σαουλ",711499,18],["καὶ",707031,7],["ὄνομα",709666,25],["αὐτῷ",702165,50],["Σεμεϊ",711666,4],["υἱὸς",713075,4],["Γηρα",703088,18],["ἐξῆλθεν",704909,2],["ἐκπορευόμενος",704293,122],["καὶ",707031,7],["καταρώμενος",707396,122]],"And king David came to Baurim; and, behold, there came out from thence a man of the family of the house of Saul, and his name [was] Semei the son of Gera. He came forth and cursed as he went,"],["6",[["καὶ",707031,7],["λιθάζων",708192,72],["ἐν",704639,0],["λίθοις",708196,148],["τὸν",709436,5],["Δαυιδ",703232,6],["καὶ",707031,7],["πάντας",710177,60],["τοὺς",709436,58],["παῖδας",709932,57],["τοῦ",709436,35],["βασιλέως",702580,18],["Δαυιδ",703232,18],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["ἦν",704093,13],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["δυνατοὶ",703845,138],["ἐκ",704132,0],["δεξιῶν",703360,169],["καὶ",707031,7],["ἐξ",704132,0],["εὐωνύμων",705736,169],["τοῦ",709436,35],["βασιλέως",702580,18]],"and cast stones at David, and at all the servants of king David: and all the people and all the mighty men were on the right and left hand of the king."],["7",[["καὶ",707031,7],["οὕτως",709859,28],["ἔλεγεν",708124,13],["Σεμεϊ",711666,4],["ἐν",704639,0],["τῷ",709436,53],["καταρᾶσθαι",707396,110],["αὐτόν",702165,85],["ἔξελθε",704909,176],["ἔξελθε",704909,176],["ἀνὴρ",701150,4],["αἱμάτων",700442,44],["καὶ",707031,7],["ἀνὴρ",701150,4],["ὁ",709436,3],["παράνομος",710080,14]],"And thus Semei said when he cursed him, Go out, go out, thou bloody man, and man of sin."],["8",[["ἐπέστρεψεν",705278,2],["ἐπὶ",705080,0],["σὲ",711598,163],["κύριος",707996,4],["πάντα",710177,68],["τὰ",709436,41],["αἵματα",700442,42],["τοῦ",709436,35],["οἴκου",709516,18],["Σαουλ",711499,18],["ὅτι",709803,7],["ἐβασίλευσας",702581,162],["ἀντ᾿",701227,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔδωκεν",703654,2],["κύριος",707996,4],["τὴν",709436,8],["βασιλείαν",702577,9],["ἐν",704639,0],["χειρὶ",713787,1],["Αβεσσαλωμ",700052,18],["τοῦ",709436,35],["υἱοῦ",713075,18],["σου",711945,133],["καὶ",707031,7],["ἰδοὺ",706497,88],["σὺ",712181,164],["ἐν",704639,0],["τῇ",709436,100],["κακίᾳ",707054,1],["σου",711945,133],["ὅτι",709803,7],["ἀνὴρ",701150,4],["αἱμάτων",700442,44],["σύ",712181,164]],"The Lord has returned upon thee all the blood of the house of Saul, because thou hast reigned in his stead; and the Lord has given the kingdom into the hand of Abessalom thy son: and, behold, thou [art taken] in thy mischief, because thou [art] a bloody man."],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["Αβεσσα",700051,4],["υἱὸς",713075,4],["Σαρουιας",711540,18],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["ἵνα",706747,7],["τί",712867,273],["καταρᾶται",707396,117],["ὁ",709436,3],["κύων",708004,4],["ὁ",709436,3],["τεθνηκὼς",706278,270],["οὗτος",709858,121],["τὸν",709436,5],["κύριόν",707996,6],["μου",709032,133],["τὸν",709436,5],["βασιλέα",702580,6],["διαβήσομαι",703419,181],["δὴ",703395,11],["καὶ",707031,7],["ἀφελῶ",702177,165],["τὴν",709436,8],["κεφαλὴν",707639,9],["αὐτοῦ",702165,102]],"And Abessa the son of Saruia said to the king, Why does this dead dog curse my lord the king? let me go over now and take off his head."],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεύς",702580,4],["τί",712867,273],["ἐμοὶ",704577,159],["καὶ",707031,7],["ὑμῖν",713084,90],["υἱοὶ",713075,52],["Σαρουιας",711540,18],["ἄφετε",702211,74],["αὐτὸν",702165,85],["καὶ",707031,7],["οὕτως",709859,28],["καταράσθω",707396,407],["ὅτι",709803,7],["κύριος",707996,4],["εἶπεν",705373,2],["αὐτῷ",702165,50],["καταρᾶσθαι",707396,110],["τὸν",709436,5],["Δαυιδ",703232,6],["καὶ",707031,7],["τίς",712867,158],["ἐρεῖ",705415,127],["ὡς",714148,7],["τί",712867,126],["ἐποίησας",710582,162],["οὕτως",709859,28]],"And the king said, What have I to do with you, ye sons of Saruia? even let him alone, and so let him curse, for the Lord has told him to curse David: and who shall say, Why hast thou done thus?"],["11",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["πρὸς",710844,0],["Αβεσσα",700051,6],["καὶ",707031,7],["πρὸς",710844,0],["πάντας",710177,60],["τοὺς",709436,58],["παῖδας",709932,57],["αὐτοῦ",702165,102],["ἰδοὺ",706497,88],["ὁ",709436,3],["υἱός",713075,4],["μου",709032,133],["ὁ",709436,3],["ἐξελθὼν",704909,182],["ἐκ",704132,0],["τῆς",709436,16],["κοιλίας",707761,17],["μου",709032,133],["ζητεῖ",705879,91],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["καὶ",707031,7],["προσέτι",710891,28],["νῦν",709384,28],["ὁ",709436,3],["υἱὸς",713075,4],["τοῦ",709436,35],["Ιεμινι",706586,18],["ἄφετε",702211,74],["αὐτὸν",702165,85],["καταρᾶσθαι",707396,110],["ὅτι",709803,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["κύριος",707996,4]],"And David said to Abessa and to all his servants, Behold, my son who came forth out of my bowels seeks my life; still more now may the son of Benjamin: let him curse, because the Lord has told him."],["12",[["εἴ",704071,7],["πως",711120,28],["ἴδοι",709725,225],["κύριος",707996,4],["ἐν",704639,0],["τῇ",709436,100],["ταπεινώσει",712719,1],["μου",709032,133],["καὶ",707031,7],["ἐπιστρέψει",705278,127],["μοι",708974,159],["ἀγαθὰ",700106,68],["ἀντὶ",701227,0],["τῆς",709436,16],["κατάρας",707395,17],["αὐτοῦ",702165,102],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ταύτῃ",709858,105]],"If by any means the Lord may look on my affliction, thus shall he return me good for his cursing this day."],["13",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["Δαυιδ",703232,4],["καὶ",707031,7],["οἱ",709436,136],["ἄνδρες",701150,52],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["καὶ",707031,7],["Σεμεϊ",711666,4],["ἐπορεύετο",710667,19],["ἐκ",704132,0],["πλευρᾶς",710524,17],["τοῦ",709436,20],["ὄρους",709768,21],["ἐχόμενα",705785,67],["αὐτοῦ",702165,102],["πορευόμενος",710667,122],["καὶ",707031,7],["καταρώμενος",701686,122],["καὶ",707031,7],["λιθάζων",708192,72],["ἐν",704639,0],["λίθοις",708196,148],["ἐκ",704132,0],["πλαγίων",710493,169],["αὐτοῦ",702165,102],["καὶ",707031,7],["τῷ",709436,113],["χοῒ",713930,114],["πάσσων",710179,72]],"And David and all the men with him went on the way: and Semei went by the side of the hill next to him, cursing as he went, and casting stones at him, and sprinkling him with dirt."],["14",[["καὶ",707031,7],["ἦλθεν",705453,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["αὐτοῦ",702165,102],["ἐκλελυμένοι",704254,429],["καὶ",707031,7],["ἀνέψυξαν",701095,150],["ἐκεῖ",704181,28]],"And the king, and all the people with him, came away and refreshed themselves there."],["15",[["καὶ",707031,7],["Αβεσσαλωμ",700052,4],["καὶ",707031,7],["πᾶς",710177,14],["ἀνὴρ",701150,4],["Ισραηλ",706839,18],["εἰσῆλθον",704114,150],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["Αχιτοφελ",702296,4],["μετ᾿",708780,0],["αὐτοῦ",702165,102]],"And Abessalom and all the men of Israel went into Jerusalem, and Achitophel with him."],["16",[["καὶ",707031,7],["ἐγενήθη",703104,37],["ἡνίκα",706008,28],["ἦλθεν",705453,2],["Χουσι",713933,4],["ὁ",709436,3],["Αρχι",701840,4],["ἑταῖρος",705529,4],["Δαυιδ",703232,18],["πρὸς",710844,0],["Αβεσσαλωμ",700052,6],["καὶ",707031,7],["εἶπεν",705373,2],["Χουσι",713933,4],["πρὸς",710844,0],["Αβεσσαλωμ",700052,6],["ζήτω",705851,31],["ὁ",709436,3],["βασιλεύς",702580,4]],"And it came to pass when Chusi the chief friend of David came to Abessalom, that Chusi said to Abessalom, Let the king live."],["17",[["καὶ",707031,7],["εἶπεν",705373,2],["Αβεσσαλωμ",700052,4],["πρὸς",710844,0],["Χουσι",713933,6],["τοῦτο",709858,132],["τὸ",709436,34],["ἔλεός",704426,15],["σου",711945,133],["μετὰ",708780,0],["τοῦ",709436,35],["ἑταίρου",705529,18],["σου",711945,133],["ἵνα",706747,7],["τί",712867,126],["οὐκ",709805,28],["ἀπῆλθες",701398,162],["μετὰ",708780,0],["τοῦ",709436,35],["ἑταίρου",705529,18],["σου",711945,133]],"And Abessalom said to Chusi, [Is] this thy kindness to thy friend? why wentest thou not forth with thy friend?"],["18",[["καὶ",707031,7],["εἶπεν",705373,2],["Χουσι",713933,4],["πρὸς",710844,0],["Αβεσσαλωμ",700052,6],["οὐχί",709862,28],["ἀλλὰ",700680,7],["κατόπισθεν",707544,28],["οὗ",709781,48],["ἐξελέξατο",704236,23],["κ