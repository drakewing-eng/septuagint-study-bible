[["1",[["καὶ",707031,7],["ἔγνω",703105,2],["Ιωαβ",706877,4],["υἱὸς",713075,4],["Σαρουιας",711540,18],["ὅτι",709803,7],["ἡ",709436,10],["καρδία",707141,12],["τοῦ",709436,35],["βασιλέως",702580,18],["ἐπὶ",705080,0],["Αβεσσαλωμ",700052,114]],"And Joab the son of Saruia knew that the heart of the king was toward Abessalom."],["2",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Ιωαβ",706877,4],["εἰς",704105,0],["Θεκωε",706162,227],["καὶ",707031,7],["ἔλαβεν",708076,2],["ἐκεῖθεν",704182,28],["γυναῖκα",703209,9],["σοφὴν",711985,36],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτήν",702165,104],["πένθησον",710251,176],["δὴ",703395,11],["καὶ",707031,7],["ἔνδυσαι",704701,106],["ἱμάτια",706742,42],["πενθικὰ",710252,68],["καὶ",707031,7],["μὴ",708851,28],["ἀλείψῃ",700644,172],["ἔλαιον",704380,25],["καὶ",707031,7],["ἔσῃ",704093,123],["ὡς",714148,7],["γυνὴ",703209,12],["πενθοῦσα",710251,188],["ἐπὶ",705080,0],["τεθνηκότι",706278,514],["τοῦτο",709858,129],["ἡμέρας",705984,17],["πολλὰς",710646,119]],"And Joab sent to Thecoe, and took thence a cunning woman, and said to her, Mourn, I pray thee, and put on mourning apparel, and anoint thee not with oil, and thou shalt be as a woman mourning for one that is dead thus for many days."],["3",[["καὶ",707031,7],["ἐλεύσῃ",705453,123],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["καὶ",707031,7],["λαλήσεις",708071,166],["πρὸς",710844,0],["αὐτὸν",702165,85],["κατὰ",707200,0],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["καὶ",707031,7],["ἔθηκεν",712849,2],["Ιωαβ",706877,4],["τοὺς",709436,58],["λόγους",708236,57],["ἐν",704639,0],["τῷ",709436,53],["στόματι",712125,54],["αὐτῆς",702165,86]],"And thou shalt go to the king, and speak to him according to this word. And Joab put the words in her mouth."],["4",[["καὶ",707031,7],["εἰσῆλθεν",704114,2],["ἡ",709436,10],["γυνὴ",703209,12],["ἡ",709436,10],["Θεκωῖτις",706166,12],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["καὶ",707031,7],["ἔπεσεν",710481,2],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["αὐτῆς",702165,86],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["προσεκύνησεν",710925,2],["αὐτῷ",702165,50],["καὶ",707031,7],["εἶπεν",705373,2],["Σῶσον",712655,4],["βασιλεῦ",702580,153],["σῶσον",712627,577]],"So the woman of Thecoe went in to the king and fell upon her face to the earth, and did him obeisance, and said, Help, O king, help."],["5",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτὴν",702165,104],["ὁ",709436,3],["βασιλεύς",702580,4],["τί",712867,273],["ἐστίν",704093,91],["σοι",711925,159],["ἡ",709436,10],["δὲ",703303,11],["εἶπεν",705373,2],["καὶ",707031,7],["μάλα",708433,28],["γυνὴ",703209,12],["χήρα",713848,12],["ἐγώ",704018,164],["εἰμι",704093,157],["καὶ",707031,7],["ἀπέθανεν",701461,2],["ὁ",709436,3],["ἀνήρ",701150,4],["μου",709032,133]],"And the king said to her, What is the matter with thee? And she said, I am indeed a widow woman, and my husband is dead."],["6",[["καί",707031,7],["γε",702985,11],["τῇ",709436,100],["δούλῃ",703815,1],["σου",711945,133],["δύο",703849,59],["υἱοί",713075,52],["καὶ",707031,7],["ἐμαχέσαντο",708610,189],["ἀμφότεροι",700892,138],["ἐν",704639,0],["τῷ",709436,113],["ἀγρῷ",700196,114],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ὁ",709436,3],["ἐξαιρούμενος",704838,122],["ἀνὰ",700902,0],["μέσον",708768,27],["αὐτῶν",702165,40],["καὶ",707031,7],["ἔπαισεν",709933,2],["ὁ",709436,3],["εἷς",704106,596],["τὸν",709436,5],["ἀδελφὸν",700249,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐθανάτωσεν",706097,2],["αὐτόν",702165,85]],"And moreover thy handmaid had two sons, and they fought together in the field, and there was no one to part them; and the one smote the other his brother, and slew him."],["7",[["καὶ",707031,7],["ἰδοὺ",709725,300],["ἐπανέστη",705026,2],["ὅλη",709597,29],["ἡ",709436,10],["πατριὰ",710192,12],["πρὸς",710844,0],["τὴν",709436,8],["δούλην",703815,9],["σου",711945,133],["καὶ",707031,7],["εἶπαν",705373,150],["δὸς",703654,176],["τὸν",709436,5],["παίσαντα",709931,365],["τὸν",709436,5],["ἀδελφὸν",700249,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["θανατώσομεν",706097,275],["αὐτὸν",702165,85],["ἀντὶ",701227,0],["τῆς",709436,16],["ψυχῆς",714070,17],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["αὐτοῦ",702165,102],["οὗ",709781,48],["ἀπέκτεινεν",701498,2],["καὶ",707031,7],["ἐξαροῦμεν",704839,275],["καί",707031,7],["γε",702985,11],["τὸν",709436,5],["κληρονόμον",707726,6],["ὑμῶν",713091,145],["καὶ",707031,7],["σβέσουσιν",711596,218],["τὸν",709436,5],["ἄνθρακά",701160,6],["μου",709032,133],["τὸν",709436,5],["καταλειφθέντα",707305,260],["ὥστε",714164,7],["μὴ",708851,28],["θέσθαι",712849,109],["τῷ",709436,113],["ἀνδρί",701150,114],["μου",709032,133],["κατάλειμμα",707304,25],["καὶ",707031,7],["ὄνομα",709666,25],["ἐπὶ",705080,0],["προσώπου",710986,21],["τῆς",709436,16],["γῆς",703083,17]],"And behold the whole family rose up against thine handmaid, and they said, Give up the one that smote his brother, and we will put him to death for the life of his brother, whom he slew, and we will take away even your heir: so they will quench my coal that is left, so as not to leave my husband remnant or name on the face of the earth."],["8",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεύς",702580,4],["ὑγιαίνουσα",713057,188],["βάδιζε",702367,240],["εἰς",704105,0],["τὸν",709436,5],["οἶκόν",709516,6],["σου",711945,133],["κἀγὼ",706969,288],["ἐντελοῦμαι",704791,254],["περὶ",710285,0],["σοῦ",711945,133]],"And the king said to the woman, Go in peace to thy house, and I will give commandment concerning thee."],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["ἡ",709436,10],["γυνὴ",703209,12],["ἡ",709436,10],["Θεκωῖτις",706166,118],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["ἐπ᾿",705080,0],["ἐμέ",704555,163],["κύριέ",707996,153],["μου",709032,133],["βασιλεῦ",702580,153],["ἡ",709436,10],["ἀνομία",701192,12],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133],["καὶ",707031,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["ὁ",709436,3],["θρόνος",706315,4],["αὐτοῦ",702165,102],["ἀθῷος",700390,14]],"And the woman of Thecoe said to the king, On me, my lord, O king, and on my father's house [be] the iniquity, and the king and his throne [be] guiltless."],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεύς",702580,4],["τίς",712867,158],["ὁ",709436,3],["λαλῶν",708071,72],["πρὸς",710844,0],["σέ",711598,163],["καὶ",707031,7],["ἄξεις",700209,166],["αὐτὸν",702165,85],["πρὸς",710844,0],["ἐμέ",704555,163],["καὶ",707031,7],["οὐ",709805,28],["προσθήσει",710965,127],["ἔτι",705538,28],["ἅψασθαι",701654,109],["αὐτοῦ",702165,102]],"And the king said, Who was it that spoke to thee? thou shalt even bring him to me, and [one] shall not touch him any more."],["11",[["καὶ",707031,7],["εἶπεν",705373,2],["μνημονευσάτω",708965,45],["δὴ",703395,11],["ὁ",709436,3],["βασιλεὺς",702580,4],["τὸν",709436,5],["κύριον",707996,6],["θεὸν",706192,6],["αὐτοῦ",702165,102],["πληθυνθῆναι",710530,179],["ἀγχιστέα",700203,6],["τοῦ",709436,20],["αἵματος",700442,21],["τοῦ",709436,20],["διαφθεῖραι",703624,106],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἐξάρωσιν",704839,234],["τὸν",709436,5],["υἱόν",713075,6],["μου",709032,133],["καὶ",707031,7],["εἶπεν",705373,2],["ζῇ",705851,91],["κύριος",707996,4],["εἰ",704071,7],["πεσεῖται",710481,127],["ἀπὸ",701425,0],["τῆς",709436,16],["τριχὸς",706312,17],["τοῦ",709436,35],["υἱοῦ",713075,18],["σου",711945,133],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9]],"And she said, Let now the king remember concerning his Lord God in that the avenger of blood is multiplied to destroy, and let them not take away my son. And he said, [As] the Lord lives, not a hair of thy son shall fall to the ground."],["12",[["καὶ",707031,7],["εἶπεν",705373,2],["ἡ",709436,10],["γυνή",703209,12],["λαλησάτω",708071,45],["δὴ",703395,11],["ἡ",709436,10],["δούλη",703815,12],["σου",711945,133],["πρὸς",710844,0],["τὸν",709436,5],["κύριόν",707996,6],["μου",709032,133],["τὸν",709436,5],["βασιλέα",702580,6],["ῥῆμα",711246,25],["καὶ",707031,7],["εἶπεν",705373,2],["λάλησον",708071,176]],"And the woman said, Let now thy servant speak a word to my lord the king. And he said, Say on."],["13",[["καὶ",707031,7],["εἶπεν",705373,2],["ἡ",709436,10],["γυνή",703209,12],["ἵνα",706747,7],["τί",712867,126],["ἐλογίσω",708232,174],["τοιοῦτο",712878,129],["ἐπὶ",705080,0],["λαὸν",708094,6],["θεοῦ",706192,18],["ἦ",705925,28],["ἐκ",704132,0],["στόματος",712125,21],["τοῦ",709436,35],["βασιλέως",702580,18],["ὁ",709436,3],["λόγος",708236,4],["οὗτος",709858,121],["ὡς",714148,7],["πλημμέλεια",710533,12],["τοῦ",709436,20],["μὴ",708851,28],["ἐπιστρέψαι",705278,106],["τὸν",709436,5],["βασιλέα",702580,6],["τὸν",709436,5],["ἐξωσμένον",704985,424],["αὐτοῦ",702165,102]],"And the woman said, Why hast thou devised this thing against the people of God? or [is] this word out of the king's mouth as a transgression, so that the king should not bring back his banished?"],["14",[["ὅτι",709803,7],["θανάτῳ",706096,114],["ἀποθανούμεθα",701461,141],["καὶ",707031,7],["ὥσπερ",714163,28],["τὸ",709436,34],["ὕδωρ",713071,15],["τὸ",709436,24],["καταφερόμενον",707471,214],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ὃ",709781,33],["οὐ",709805,28],["συναχθήσεται",712375,134],["καὶ",707031,7],["λήμψεται",708076,93],["ὁ",709436,3],["θεὸς",706192,4],["ψυχήν",714070,9],["καὶ",707031,7],["λογιζόμενος",708232,122],["τοῦ",709436,20],["ἐξῶσαι",704985,106],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["ἐξωσμένον",704985,424]],"For we shall surely die, and be as water poured upon the earth, which shall not be gathered up, and God shall take the life, even as he devises to thrust forth from him his outcast."],["15",[["καὶ",707031,7],["νῦν",709384,28],["ὃ",709781,33],["ἦλθον",705453,155],["λαλῆσαι",708071,106],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["τὸν",709436,5],["κύριόν",707996,6],["μου",709032,133],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["ὅτι",709803,7],["ὄψεταί",709725,93],["με",708618,163],["ὁ",709436,3],["λαός",708094,4],["καὶ",707031,7],["ἐρεῖ",705415,127],["ἡ",709436,10],["δούλη",703815,12],["σου",711945,133],["λαλησάτω",708071,45],["δὴ",703395,11],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["εἴ",704071,7],["πως",711120,28],["ποιήσει",710582,127],["ὁ",709436,3],["βασιλεὺς",702580,4],["τὸ",709436,24],["ῥῆμα",711246,25],["τῆς",709436,16],["δούλης",703815,17],["αὐτοῦ",702165,102]],"And now whereas I came to speak this word to my lord the king, [the reason is] that the people will see me, and thy handmaid will say, Let one now speak to my lord the king, if peradventure the king will perform the request of his handmaid;"],["16",[["ὅτι",709803,7],["ἀκούσει",700587,127],["ὁ",709436,3],["βασιλεὺς",702580,4],["ῥύσασθαι",711309,109],["τὴν",709436,8],["δούλην",703815,9],["αὐτοῦ",702165,102],["ἐκ",704132,0],["χειρὸς",713787,17],["τοῦ",709436,35],["ἀνδρὸς",701150,18],["τοῦ",709436,35],["ζητοῦντος",705879,152],["ἐξᾶραί",704839,106],["με",708618,163],["καὶ",707031,7],["τὸν",709436,5],["υἱόν",713075,6],["μου",709032,133],["ἀπὸ",701425,0],["κληρονομίας",707725,17],["θεοῦ",706192,18]],"for the king will hear. Let him rescue his handmaid out of the hand of the man that seeks to cast out me and my son from the inheritance of God."],["17",[["καὶ",707031,7],["εἶπεν",705373,2],["ἡ",709436,10],["γυνή",703209,12],["εἴη",704093,301],["δὴ",703395,11],["ὁ",709436,3],["λόγος",708236,4],["τοῦ",709436,35],["κυρίου",707996,18],["μου",709032,133],["τοῦ",709436,35],["βασιλέως",702580,18],["εἰς",704105,0],["θυσίαν",706345,9],["ὅτι",709803,7],["καθὼς",707030,28],["ἄγγελος",700140,4],["θεοῦ",706192,18],["οὕτως",709859,28],["ὁ",709436,3],["κύριός",707996,4],["μου",709032,133],["ὁ",709436,3],["βασιλεὺς",702580,4],["τοῦ",709436,20],["ἀκούειν",700587,55],["τὸ",709436,24],["ἀγαθὸν",700106,27],["καὶ",707031,7],["τὸ",709436,24],["πονηρόν",710660,27],["καὶ",707031,7],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ἔσται",704093,93],["μετὰ",708780,0],["σοῦ",711945,133]],"And the woman said, If now the word of my lord the king be gracious,—[well]: for as an angel of God, so [is] my lord the king, to hear good and evil: and the Lord thy God shall be with thee."],["18",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["τὴν",709436,8],["γυναῖκα",703209,9],["μὴ",708851,28],["δὴ",703395,11],["κρύψῃς",707923,175],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["ῥῆμα",711246,25],["ὃ",709781,33],["ἐγὼ",704018,164],["ἐπερωτῶ",705069,157],["σε",711598,163],["καὶ",707031,7],["εἶπεν",705373,2],["ἡ",709436,10],["γυνή",703209,12],["λαλησάτω",708071,45],["δὴ",703395,11],["ὁ",709436,3],["κύριός",707996,4],["μου",709032,133],["ὁ",709436,3],["βασιλεύς",702580,4]],"And the king answered, and said to the woman, Hide not from me, I pray thee, the matter which I ask thee. And the woman said, Let my lord the king by all means speak."],["19",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεύς",702580,4],["μὴ",708851,28],["ἡ",709436,10],["χεὶρ",713787,12],["Ιωαβ",706877,18],["ἐν",704639,0],["παντὶ",710177,30],["τούτῳ",709858,50],["μετὰ",708780,0],["σοῦ",711945,133],["καὶ",707031,7],["εἶπεν",705373,2],["ἡ",709436,10],["γυνὴ",703209,12],["τῷ",709436,113],["βασιλεῖ",702580,114],["ζῇ",705851,91],["ἡ",709436,10],["ψυχή",714070,12],["σου",711945,133],["κύριέ",707996,153],["μου",709032,133],["βασιλεῦ",702580,153],["εἰ",704071,7],["ἔστιν",704093,91],["εἰς",704105,0],["τὰ",709436,41],["δεξιὰ",703360,68],["ἢ",705924,7],["εἰς",704105,0],["τὰ",709436,41],["ἀριστερὰ",701749,68],["ἐκ",704132,0],["πάντων",710177,169],["ὧν",709781,252],["ἐλάλησεν",708071,2],["ὁ",709436,3],["κύριός",707996,4],["μου",709032,133],["ὁ",709436,3],["βασιλεύς",702580,4],["ὅτι",709803,7],["ὁ",709436,3],["δοῦλός",703817,4],["σου",711945,133],["Ιωαβ",706877,4],["αὐτὸς",702165,121],["ἐνετείλατό",704791,23],["μοι",708974,159],["καὶ",707031,7],["αὐτὸς",702165,121],["ἔθετο",712849,23],["ἐν",704639,0],["τῷ",709436,53],["στόματι",712125,54],["τῆς",709436,16],["δούλης",703815,17],["σου",711945,133],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62]],"And the king said, [Is] not the hand of Joab in all this matter with thee? and the woman said to the king, [As] thy soul lives, my lord, O king, there is no turning to the right hand or to the left from all that my lord the king has spoken; for thy servant Joab himself charged me, and he put all these words in the mouth of thine handmaid."],["20",[["ἕνεκεν",704709,0],["τοῦ",709436,20],["περιελθεῖν",710314,106],["τὸ",709436,24],["πρόσωπον",710986,25],["τοῦ",709436,20],["ῥήματος",711246,21],["τούτου",709858,102],["ἐποίησεν",710582,2],["ὁ",709436,3],["δοῦλός",703817,4],["σου",711945,133],["Ιωαβ",706877,4],["τὸν",709436,5],["λόγον",708236,6],["τοῦτον",709858,85],["καὶ",707031,7],["ὁ",709436,3],["κύριός",707996,4],["μου",709032,133],["σοφὸς",711985,14],["καθὼς",707030,28],["σοφία",711981,12],["ἀγγέλου",700140,18],["τοῦ",709436,35],["θεοῦ",706192,18],["τοῦ",709436,20],["γνῶναι",703105,106],["πάντα",710177,68],["τὰ",709436,41],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1]],"In order that this form of speech might come about [it was] that thy servant Joab has framed this matter: and my lord is wise as [is] the wisdom of an angel of God, to know all things that are in the earth."],["21",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["πρὸς",710844,0],["Ιωαβ",706877,6],["ἰδοὺ",706497,88],["δὴ",703395,11],["ἐποίησά",710582,155],["σοι",711925,159],["κατὰ",707200,0],["τὸν",709436,5],["λόγον",708236,6],["σου",711945,133],["τοῦτον",709858,85],["πορεύου",710667,253],["ἐπίστρεψον",705278,176],["τὸ",709436,24],["παιδάριον",709923,25],["τὸν",709436,5],["Αβεσσαλωμ",700052,6]],"And the king said to Joab, Behold now, I have done to thee according to this thy word: go, bring back the young man Abessalom."],["22",[["καὶ",707031,7],["ἔπεσεν",710481,2],["Ιωαβ",706877,4],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["προσεκύνησεν",710925,2],["καὶ",707031,7],["εὐλόγησεν",705631,2],["τὸν",709436,5],["βασιλέα",702580,6],["καὶ",707031,7],["εἶπεν",705373,2],["Ιωαβ",706877,4],["σήμερον",711751,28],["ἔγνω",703105,2],["ὁ",709436,3],["δοῦλός",703817,4],["σου",711945,133],["ὅτι",709803,7],["εὗρον",705676,155],["χάριν",713735,9],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["σου",711945,133],["κύριέ",707996,153],["μου",709032,133],["βασιλεῦ",702580,153],["ὅτι",709803,7],["ἐποίησεν",710582,2],["ὁ",709436,3],["κύριός",707996,4],["μου",709032,133],["ὁ",709436,3],["βασιλεὺς",702580,4],["τὸν",709436,5],["λόγον",708236,6],["τοῦ",709436,35],["δούλου",703817,18],["αὐτοῦ",702165,102]],"And Joab fell on his face to the ground, and did obeisance, and blessed the king: and Joab said, To-day thy servant knows that I have found grace in thy sight, my lord, O king, for my lord the king has performed the request of his servant."],["23",[["καὶ",707031,7],["ἀνέστη",701173,2],["Ιωαβ",706877,4],["καὶ",707031,7],["ἐπορεύθη",710667,37],["εἰς",704105,0],["Γεδσουρ",702998,227],["καὶ",707031,7],["ἤγαγεν",700209,2],["τὸν",709436,5],["Αβεσσαλωμ",700052,6],["εἰς",704105,0],["Ιερουσαλημ",706644,9]],"And Joab arose, and went to Gedsur, and brought Abessalom to Jerusalem."],["24",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεύς",702580,4],["ἀποστραφήτω",701598,45],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὸ",709436,24],["πρόσωπόν",710986,25],["μου",709032,133],["μὴ",708851,28],["βλεπέτω",702740,31],["καὶ",707031,7],["ἀπέστρεψεν",701598,2],["Αβεσσαλωμ",700052,4],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὸ",709436,24],["πρόσωπον",710986,25],["τοῦ",709436,35],["βασιλέως",702580,18],["οὐκ",709805,28],["εἶδεν",709725,2]],"And the king said, Let him return to his house, and not see my face. And Abessalom returned to his house, and saw not the king's face."],["25",[["καὶ",707031,7],["ὡς",714148,7],["Αβεσσαλωμ",700052,4],["οὐκ",709805,28],["ἦν",704093,13],["ἀνὴρ",701150,4],["ἐν",704639,0],["παντὶ",710177,30],["Ισραηλ",706839,18],["αἰνετὸς",700458,14],["σφόδρα",712586,28],["ἀπὸ",701425,0],["ἴχνους",706873,21],["ποδὸς",710707,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἕως",705792,7],["κορυφῆς",707844,17],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἦν",704093,13],["ἐν",704639,0],["αὐτῷ",702165,50],["μῶμος",709102,4]],"And there was not a man in Israel so very comely as Abessalom: from the sole of his foot even to the crown of his head there was no blemish in him."],["26",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["κείρεσθαι",707597,110],["αὐτὸν",702165,85],["τὴν",709436,8],["κεφαλὴν",707639,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐγένετο",703104,23],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["ἡμερῶν",705984,65],["εἰς",704105,0],["ἡμέρας",705984,17],["ὡς",714148,7],["ἂν",700900,11],["ἐκείρετο",707597,19],["ὅτι",709803,7],["κατεβαρύνετο",707204,19],["ἐπ᾿",705080,0],["αὐτόν",702165,85],["καὶ",707031,7],["κειρόμενος",707597,122],["αὐτὴν",702165,104],["ἔστησεν",706846,2],["τὴν",709436,8],["τρίχα",706312,9],["τῆς",709436,16],["κεφαλῆς",707639,17],["αὐτοῦ",702165,102],["διακοσίους",703482,60],["σίκλους",711786,57],["ἐν",704639,0],["τῷ",709436,113],["σίκλῳ",711786,114],["τῷ",709436,113],["βασιλικῷ",702582,30]],"And when he polled his head, (and it was at the beginning of every year that he polled it, because it grew heavy upon him,) even when he polled it, he weighed the hair of his head, two hundred shekels according to the royal shekel."],["27",[["καὶ",707031,7],["ἐτέχθησαν",712853,99],["τῷ",709436,113],["Αβεσσαλωμ",700052,114],["τρεῖς",712927,592],["υἱοὶ",713075,52],["καὶ",707031,7],["θυγάτηρ",706320,12],["μία",704106,68],["καὶ",707031,7],["ὄνομα",709666,25],["αὐτῇ",702165,105],["Θ