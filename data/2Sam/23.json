[["1",[["καὶ",707031,7],["οὗτοι",709858,201],["οἱ",709436,136],["λόγοι",708236,52],["Δαυιδ",703232,18],["οἱ",709436,136],["ἔσχατοι",705519,138],["πιστὸς",710486,14],["Δαυιδ",703232,4],["υἱὸς",713075,4],["Ιεσσαι",706668,18],["καὶ",707031,7],["πιστὸς",710486,14],["ἀνήρ",701150,4],["ὃν",709781,112],["ἀνέστησεν",701173,2],["κύριος",707996,4],["ἐπὶ",705080,0],["χριστὸν",713964,27],["θεοῦ",706192,18],["Ιακωβ",706401,18],["καὶ",707031,7],["εὐπρεπεῖς",705667,138],["ψαλμοὶ",714022,52],["Ισραηλ",706839,18]],"And these [are] the last words of David. Faithful [is] David the son of Jessæ, and faithful the man whom the Lord raised up to be the anointed of the God of Jacob, and beautiful [are] the psalms of Israel."],["2",[["πνεῦμα",710566,25],["κυρίου",707996,18],["ἐλάλησεν",708071,2],["ἐν",704639,0],["ἐμοί",704577,159],["καὶ",707031,7],["ὁ",709436,3],["λόγος",708236,4],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["γλώσσης",703120,17],["μου",709032,133]],"The Spirit of the Lord spoke by me, and his word [was] upon my tongue."],["3",[["λέγει",708124,91],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ἐμοὶ",704577,159],["ἐλάλησεν",708071,2],["φύλαξ",713616,4],["Ισραηλ",706839,18],["παραβολὴν",710003,9],["εἰπόν",705373,155],["ἐν",704639,0],["ἀνθρώπῳ",701163,114],["πῶς",711121,28],["κραταιώσητε",707875,125],["φόβον",713534,6],["θεοῦ",706192,18]],"The God of Israel says, A watchman out of Israel spoke to me a parable: I said among men, How will ye strengthen the fear of the anointed?"],["4",[["καὶ",707031,7],["ἐν",704639,0],["θεῷ",706192,114],["φωτὶ",713642,54],["πρωίας",711025,82],["ἀνατείλαι",701066,106],["ἥλιος",705974,4],["τὸ",709436,24],["πρωὶ",711021,28],["οὐ",709805,28],["παρῆλθεν",710141,2],["ἐκ",704132,0],["φέγγους",713404,21],["καὶ",707031,7],["ὡς",714148,7],["ἐξ",704132,0],["ὑετοῦ",713074,18],["χλόης",713877,17],["ἀπὸ",701425,0],["γῆς",703083,17]],"And in the morning light of God, let the sun arise in the morning, from the light of which the Lord passed on, and as it were from the rain of the tender grass upon the earth."],["5",[["οὐ",709805,28],["γὰρ",702963,11],["οὕτως",709859,28],["ὁ",709436,3],["οἶκός",709516,4],["μου",709032,133],["μετὰ",708780,0],["ἰσχυροῦ",706855,116],["διαθήκην",703456,9],["γὰρ",702963,11],["αἰώνιον",700505,36],["ἔθετό",712849,23],["μοι",708974,159],["ἑτοίμην",705541,36],["ἐν",704639,0],["παντὶ",710177,30],["καιρῷ",707047,114],["πεφυλαγμένην",713619,436],["ὅτι",709803,7],["πᾶσα",710177,29],["σωτηρία",712658,12],["μου",709032,133],["καὶ",707031,7],["πᾶν",710177,26],["θέλημα",706170,15],["ὅτι",709803,7],["οὐ",709805,28],["μὴ",708851,28],["βλαστήσῃ",702733,172],["ὁ",709436,3],["παράνομος",710080,14]],"For my house [is] not so with the Mighty One: for he has made an everlasting covenant with me, ready, guarded at every time; for all my salvation and all my desire [is], that the wicked should not flourish."],["6",[["ὥσπερ",714163,28],["ἄκανθα",700517,12],["ἐξωσμένη",704985,451],["πάντες",710177,138],["αὐτοί",702165,201],["ὅτι",709803,7],["οὐ",709805,28],["χειρὶ",713787,1],["λημφθήσονται",708076,144]],"All these [are] as a thorn thrust forth, for they shall not be taken with the hand,"],["7",[["καὶ",707031,7],["ἀνὴρ",701150,4],["οὐ",709805,28],["κοπιάσει",707824,127],["ἐν",704639,0],["αὐτοῖς",702165,151],["καὶ",707031,7],["πλῆρες",710541,26],["σιδήρου",711774,18],["καὶ",707031,7],["ξύλον",709427,15],["δόρατος",703804,21],["καὶ",707031,7],["ἐν",704639,0],["πυρὶ",711088,54],["καύσει",707049,127],["καυθήσονται",707049,144],["αἰσχύνῃ",700483,1],["αὐτῶν",702165,40]],"and a man shall not labour among them; and [one shall have] that which is fully armed with iron, and the staff of a spear, and he shall burn them with fire, and they shall be burnt in their shame."],["8",[["ταῦτα",709858,290],["τὰ",709436,63],["ὀνόματα",709666,64],["τῶν",709436,80],["δυνατῶν",703845,169],["Δαυιδ",703232,18],["Ιεβοσθε",706516,4],["ὁ",709436,3],["Χαναναῖος",713711,4],["ἄρχων",701862,4],["τοῦ",709436,20],["τρίτου",712968,92],["ἐστίν",704093,9