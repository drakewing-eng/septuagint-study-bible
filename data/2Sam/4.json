[["1",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Μεμφιβοσθε",708726,4],["υἱὸς",713075,4],["Σαουλ",711499,18],["ὅτι",709803,7],["τέθνηκεν",706278,171],["Αβεννηρ",700049,4],["ἐν",704639,0],["Χεβρων",713777,227],["καὶ",707031,7],["ἐξελύθησαν",704254,99],["αἱ",709436,190],["χεῖρες",713787,191],["αὐτοῦ",702165,102],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["ἄνδρες",701150,52],["Ισραηλ",706839,4],["παρείθησαν",710149,99]],"And Jebosthe the son of Saul heard that Abenner the son of Ner had died in Chebron; and his hands were paralysed, and all the men of Israel grew faint."],["2",[["καὶ",707031,7],["δύο",703849,543],["ἄνδρες",701150,52],["ἡγούμενοι",705931,348],["συστρεμμάτων",712561,44],["τῷ",709436,113],["Μεμφιβοσθε",708726,114],["υἱῷ",713075,114],["Σαουλ",711499,18],["ὄνομα",709666,15],["τῷ",709436,113],["ἑνὶ",704106,30],["Βαανα",702348,4],["καὶ",707031,7],["ὄνομα",709666,15],["τῷ",709436,113],["δευτέρῳ",703389,30],["Ρηχαβ",711256,4],["υἱοὶ",713075,52],["Ρεμμων",711233,18],["τοῦ",709436,35],["Βηρωθαίου",702709,118],["ἐκ",704132,0],["τῶν",709436,80],["υἱῶν",713075,81],["Βενιαμιν",702650,18],["ὅτι",709803,7],["Βηρωθ",702706,120],["ἐλογίζετο",708232,19],["τοῖς",709436,147],["υἱοῖς",713075,148],["Βενιαμιν",702650,18]],"And Jebosthe the son of Saul had two men that were captains of bands: the name of the one [was] Baana, and the name of the other Rechab, sons of Remmon the Berothite of the children of Benjamin; for Beroth was reckoned to the children of Benjamin."],["3",[["καὶ",707031,7],["ἀπέδρασαν",701448,150],["οἱ",709436,136],["Βηρωθαῖοι",702708,52],["εἰς",704105,0],["Γεθθαιμ",703009,227],["καὶ",707031,7],["ἦσαν",704093,137],["ἐκεῖ",704181,28],["παροικοῦντες",710156,146],["ἕως",705792,7],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86]],"And the Berothites ran away to Gethaim, and were sojourners there until this day."],["4",[["καὶ",707031,7],["τῷ",709436,113],["Ιωναθαν",706927,114],["υἱῷ",713075,114],["Σαουλ",711499,18],["υἱὸς",713075,4],["πεπλη