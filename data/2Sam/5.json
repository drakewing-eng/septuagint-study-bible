[["1",[["καὶ",707031,7],["παραγίνονται",710006,269],["πᾶσαι",710177,192],["αἱ",709436,190],["φυλαὶ",713620,191],["Ισραηλ",706839,18],["πρὸς",710844,0],["Δαυιδ",703232,6],["εἰς",704105,0],["Χεβρων",713777,227],["καὶ",707031,7],["εἶπαν",705373,150],["αὐτῷ",702165,50],["ἰδοὺ",706497,88],["ὀστᾶ",709792,64],["σου",711945,133],["καὶ",707031,7],["σάρκες",711537,191],["σου",711945,133],["ἡμεῖς",705983,219]],"And all the tribes of Israel come to David to Chebron, and they said to him, Behold, we [are] thy bone and thy flesh."],["2",[["καὶ",707031,7],["ἐχθὲς",713853,28],["καὶ",707031,7],["τρίτην",712968,36],["ὄντος",704093,152],["Σαουλ",711499,18],["βασιλέως",702580,18],["ἐφ᾿",705080,0],["ἡμῖν",705994,90],["σὺ",712181,164],["ἦσθα",704093,363],["ὁ",709436,3],["ἐξάγων",704834,72],["καὶ",707031,7],["εἰσάγων",704107,72],["τὸν",709436,5],["Ισραηλ",706839,6],["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["σέ",711598,163],["σὺ",712181,561],["ποιμανεῖς",710594,166],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["τὸν",709436,5],["Ισραηλ",706839,6],["καὶ",707031,7],["σὺ",712181,164],["ἔσει",704093,166],["εἰς",704105,0],["ἡγούμενον",705931,212],["ἐπὶ",705080,0],["τὸν",709436,5],["Ισραηλ",706839,6]],"And heretofore Saul being king over us, thou wast he that didst lead out and bring in Israel: and the Lord said to thee, Thou shalt feed my people Israel, and thou shalt be for a leader to my people Israel."],["3",[["καὶ",707031,7],["ἔρχονται",705453,269],["πάντες",710177,138],["οἱ",709436,136],["πρεσβύτεροι",710735,52],["Ισραηλ",706839,18],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["εἰς",704105,0],["Χεβρων",713777,227],["καὶ",707031,7],["διέθετο",703609,23],["αὐτοῖς",702165,151],["ὁ",709436,3],["βασιλεὺς",702580,4],["Δαυιδ",703232,4],["διαθήκην",703456,9],["ἐν",704639,0],["Χεβρων",713777,111],["ἐνώπιον",704823,0],["κυρίου",707996,18],["καὶ",707031,7],["χρίουσιν",713965,197],["τὸν",709436,5],["Δαυιδ",703232,6],["εἰς",704105,0],["βασιλέα",702580,6],["ἐπὶ",705080,0],["πάντα",710177,27],["Ισραηλ",706839,18]],"And all the elders of Israel come to the king to Chebron; and king David made a covenant with them in Chebron before the Lord; and they anoint David king over all Israel."],["4",[["υἱὸς",713075,4],["τριάκοντα",712934,59],["ἐτῶν",705543,44],["Δαυιδ",703232,4],["ἐν",704639,0],["τῷ",709436,53],["βασιλεῦσαι",702581,106],["αὐτὸν",702165,85],["καὶ",707031,7],["τεσσαράκοντα",712806,59],["ἔτη",705543,42],["ἐβασίλευσεν",702581,2]],"David [was] thirty years old when he began to reign, and he reigned forty years."],["5",[["ἑπτὰ",705357,59],["ἔτη",705543,42],["καὶ",707031,7],["ἓξ",704828,59],["μῆνας",708874,57],["ἐβασίλευσεν",702581,2],["ἐν",704639,0],["Χεβρων",713777,111],["ἐπὶ",705080,0],["τὸν",709436,5],["Ιουδαν",706775,6],["καὶ",707031,7],["τριάκοντα",712934,59],["τρία",712927,68],["ἔτη",705543,42],["ἐβασίλευσεν",702581,2],["ἐπὶ",705080,0],["πάντα",710177,27],["Ισραηλ",706839,6],["καὶ",707031,7],["Ιουδαν",706775,6],["ἐν",704639,0],["Ιερουσαλημ",706644,1]],"Seven years and six months he reigned in Chebron over Juda, and thirty-three years he reigned over all Israel and Juda in Jerusalem."],["6",[["καὶ",707031,7],["ἀπῆλθεν",701398,2],["Δαυιδ",703232,4],["καὶ",707031,7],["οἱ",709436,136],["ἄνδρες",701150,52],["αὐτοῦ",702165,102],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["πρὸς",710844,0],["τὸν",709436,5],["Ιεβουσαῖον",706519,6],["τὸν",709436,5],["κατοικοῦντα",707534,183],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἐρρέθη",705415,37],["τῷ",709436,113],["Δαυιδ",703232,114],["οὐκ",709805,28],["εἰσελεύσει",704114,166],["ὧδε",714090,28],["ὅτι",709803,7],["ἀντέστησαν",701154,150],["οἱ",709436,136],["τυφλοὶ",713031,138],["καὶ",707031,7],["οἱ",709436,136],["χωλοί",713999,138],["λέγοντες",708124,146],["ὅτι",709803,7],["οὐκ",709805,28],["εἰσελεύσεται",704114,93],["Δαυιδ",703232,4],["ὧδε",714090,28]],"And David and his men departed to Jerusalem, to the Jebusite that inhabited the land: and it was said to David, Thou shalt not come in hither: for the blind and the lame withstood him, saying, David shall not come in hither."],["7",[["καὶ",707031,7],["κατελάβετο",707300,23],["Δαυιδ",703232,4],["τὴν",709436,8],["περιοχὴν",710360,9],["Σιων",711816,118],["αὕτη",709858,107],["ἡ",709436,10],["πόλις",710612,12],["τοῦ",709436,35],["Δαυιδ",703232,18]],"And David took first the hold of Sion: this [is] the city of David."],["8",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["πᾶς",710177,14],["τύπτων",713022,72],["Ιεβουσαῖον",706519,57],["ἁπτέσθω",701654,407],["ἐν",704639,0],["παραξιφίδι",710082,1],["καὶ",707031,7],["τοὺς",709436,58],["χωλοὺς",713999,60],["καὶ",707031,7],["τοὺς",709436,58],["τυφλοὺς",713031,60],["καὶ",707031,7],["τοὺς",709436,58],["μισοῦντας",708935,235],["τὴν",709436,8],["ψυχὴν",714070,9],["Δαυιδ",703232,18],["διὰ",703417,0],["τοῦτο",709858,129],["ἐροῦσιν",705415,218],["τυφλοὶ",713031,138],["καὶ",707031,7],["χωλοὶ",713999,138],["οὐκ",709805,28],["εἰσελεύσονται",704114,135],["εἰς",704105,0],["οἶκον",709516,6],["κυρίου",707996,18]],"And David said on that day, Every one that smites the Jebusite, let him attack with the dagger both the lame and the blind, and those that hate the soul of David. Therefore they say, The lame and the blind shall not enter into the house of the Lord."],["9",[["καὶ",707031,7],["ἐκάθισεν",707006,2],["Δαυιδ",703232,4],["ἐν",704639,0],["τῇ",709436,100],["περιοχῇ",710360,1],["καὶ",707031,7],["ἐκλήθη",707084,37],["αὕτη",709858,107],["ἡ",709436,10],["πόλις",710612,12],["Δαυιδ",703232,18],["καὶ",707031,7],["ᾠκοδόμησεν",709509,2],["τὴν",709436,8],["πόλιν",710612,9],["κύκλῳ",707959,114],["ἀπὸ",701425,0],["τῆς",709436,16],["ἄκρας",700588,17],["καὶ",707031,7],["τὸν",709436,5],["οἶκον",709516,6],["αὐτοῦ",702165,102]],"And David dwelt in the hold, and it was called the city of David, and he built the city itself round about from the citadel, and [he built] his own house."],["10",[["καὶ",70703