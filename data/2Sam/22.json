[["1",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["Δαυιδ",703232,4],["τῷ",709436,113],["κυρίῳ",707996,114],["τοὺς",709436,58],["λόγους",708236,57],["τῆς",709436,16],["ᾠδῆς",714091,17],["ταύτης",709858,86],["ἐν",704639,0],["ᾗ",709781,108],["ἡμέρᾳ",705984,1],["ἐξείλατο",704838,23],["αὐτὸν",702165,85],["κύριος",707996,4],["ἐκ",704132,0],["χειρὸς",713787,17],["πάντων",710177,169],["τῶν",709436,80],["ἐχθρῶν",705779,169],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐκ",704132,0],["χειρὸς",713787,17],["Σαουλ",711499,18]],"And David spoke to the Lord the words of this song, in the day in which the Lord rescued him out of the hand of all his enemies, and out of the hand of Saul."],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριε",707996,153],["πέτρα",710443,12],["μου",709032,133],["καὶ",707031,7],["ὀχύρωμά",709891,15],["μου",709032,133],["καὶ",707031,7],["ἐξαιρούμενός",704838,122],["με",708618,163],["ἐμοί",704577,159]],"And the song was thus: O Lord, my rock, and my fortress, and my deliverer,"],["3",[["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["φύλαξ",713616,4],["ἔσται",704093,93],["μου",709032,133],["πεποιθὼς",710221,270],["ἔσομαι",704093,181],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["ὑπερασπιστής",713123,4],["μου",709032,133],["καὶ",707031,7],["κέρας",707625,15],["σωτηρίας",712658,17],["μου",709032,133],["ἀντιλήμπτωρ",701246,4],["μου",709032,133],["καὶ",707031,7],["καταφυγή",707485,12],["μου",709032,133],["σωτηρίας",712658,17],["μου",709032,133],["ἐξ",704132,0],["ἀδίκου",700272,116],["σώσεις",712627,166],["με",708618,163]],"my God; he shall be to me my guard, I will trust in him: [he is] my protector, and the horn of my salvation, my helper, and my sure refuge; thou shalt save me from the unjust man."],["4",[["αἰνετὸν",700458,27],["ἐπικαλέσομαι",705153,181],["κύριον",707996,6],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,80],["ἐχθρῶν",705779,169],["μου",709032,133],["σωθήσομαι",712627,180]],"I will call upon the Lord who is worthy to be praised, and I shall be saved from my enemies."],["5",[["ὅτι",709803,7],["περιέσχον",710315,150],["με",708618,163],["συντριμμοὶ",712522,52],["θανάτου",706096,18],["χείμαρροι",713783,52],["ἀνομίας",701192,17],["ἐθάμβησάν",706081,150],["με",708618,163]],"For the troubles of death compassed me, the floods of iniquity amazed me:"],["6",[["ὠδῖνες",714094,191],["θανάτου",706096,18],["ἐκύκλωσάν",707958,150],["με",708618,163],["προέφθασάν",711011,150],["με",708618,163],["σκληρότητες",711862,191],["θανάτου",706096,18]],"the pangs of death surrounded me, the agonies of death prevented me."],["7",[["ἐν",704639,0],["τῷ",709436,53],["θλίβεσθαί",706274,110],["με",708618,163],["ἐπικαλέσομαι",705153,181],["κύριον",707996,6],["καὶ",707031,7],["πρὸς",710844,0],["τὸν",709436,5],["θεόν",706192,6],["μου",709032,133],["βοήσομαι",702743,181],["καὶ",707031,7],["ἐπακούσεται",705009,93],["ἐκ",704132,0],["ναοῦ",709191,18],["αὐτοῦ",702165,102],["φωνῆς",713640,17],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["κραυγή",707886,12],["μου",709032,133],["ἐν",704639,0],["τοῖς",709436,95],["ὠσὶν",709852,96],["αὐτοῦ",702165,102]],"When I am afflicted I will call upon the Lord, and will cry to my God, and he shall hear my voice out of his temple, and my cry shall come into his ears."],["8",[["καὶ",707031,7],["ἐταράχθη",712721,37],["καὶ",707031,7],["ἐσείσθη",711633,37],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["τὰ",709436,63],["θεμέλια",706181,64],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["συνεταράχθησαν",712507,99],["καὶ",707031,7],["ἐσπαράχθησαν",711994,99],["ὅτι",709803,7],["ἐθυμώθη",706335,37],["κύριος",707996,4],["αὐτοῖς",702165,206]],"And the earth was troubled and quaked, and the foundations of heaven were confounded and torn asunder, because the Lord was wroth with them."],["9",[["ἀνέβη",700905,2],["καπνὸς",707132,4],["ἐν",704639,0],["τῇ",709436,100],["ὀργῇ",709728,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["πῦρ",711088,15],["ἐκ",704132,0],["στόματος",712125,21],["αὐτοῦ",702165,102],["κατέδεται",707519,93],["ἄνθρακες",701160,52],["ἐξεκαύθησαν",704205,99],["ἀπ᾿",701425,0],["αὐτοῦ",702165,49]],"There went up a smoke in his wrath, and fire out of his mouth devours: coals were kindled at it."],["10",[["καὶ",707031,7],["ἔκλινεν",707738,2],["οὐρανοὺς",709844,57],["καὶ",707031,7],["κατέβη",707202,2],["καὶ",707031,7],["γνόφος",703131,4],["ὑποκάτω",713204,28],["τῶν",709436,80],["ποδῶν",710707,81],["αὐτοῦ",702165,102]],"And he bowed the heavens, and came down, and [there was] darkness under his feet."],["11",[["καὶ",707031,7],["ἐπεκάθισεν",705150,2],["ἐπὶ",705080,0],["Χερουβιν",713830,81],["καὶ",707031,7],["ἐπετάσθη",710435,37],["καὶ",707031,7],["ὤφθη",709725,37],["ἐπὶ",705080,0],["πτερύγων",711057,65],["ἀνέμου",701123,18]],"And he rode upon the cherubs and did fly, and was seen upon the wings of the wind."],["12",[["καὶ",707031,7],["ἔθετο",712849,23],["σκότος",711889,25],["ἀποκρυφὴν",701496,9],["αὐτοῦ",702165,102],["κύκλῳ",707959,114],["αὐτοῦ",702165,102],["ἡ",709436,10],["σκηνὴ",711845,12],["αὐτοῦ",702165,102],["σκότος",711889,12],["ὑδάτων",713071,44],["ἐπάχυνεν",710205,2],["ἐν",704639,0],["νεφέλαις",709277,76],["ἀέρος",700354,18]],"And he made darkness his hiding-place; his tabernacle round about him was the darkness of waters, he condensed it with the clouds of the air."],["13",[["ἀπὸ",701425,0],["τοῦ",709436,20],["φέγγους",713404,21],["ἐναντίον",704656,0],["αὐτοῦ",702165,102],["ἐξεκαύθησαν",704205,99],["ἄνθρακες",701160,52],["πυρός",711101,4]],"At the brightness before him coals of fire were kindled."],["14",[["ἐβρόντησεν",702815,2],["ἐξ",704132,0],["οὐρανοῦ",709844,18],["κύριος",707996,4],["καὶ",707031,7],["ὁ",709436,3],["ὕψιστος",713287,14],["ἔδωκεν",703654,2],["φωνὴν",713640,9],["αὐτοῦ",702165,102]],"The Lord thundered out of heaven, and the Most High uttered his voice."],["15",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["βέλη",702644,42],["καὶ",707031,7],["ἐσκόρπισεν",711881,2],["αὐτούς",702165,62],["ἀστραπὴν",702021,9],["καὶ",707031,7],["ἐξέστησεν",704940,2],["αὐτούς",702165,62]],"And he sent forth arrows, and scattered them, and he flashed lightning, and dismayed them."],["16",[["καὶ",707031,7],["ὤφθησαν",709725,99],["ἀφέσεις",702199,191],["θαλάσσης",706069,17],["καὶ",707031,7],["ἀπεκαλύφθη",701474,37],["θεμέλια",706181,42],["τῆς",709436,16],["οἰκουμένης",709517,422],["ἐν",704639,0],["τῇ",709436,100],["ἐπιτιμήσει",705306,1],["κυρίου",707996,18],["ἀπὸ",701425,0],["πνοῆς",710574,17],["πνεύματος",710566,21],["θυμοῦ",706334,18],["αὐτοῦ",702165,102]],"And the channels of the sea were seen, and the foundations of the world were discovered, at the rebuke of the Lord, at the blast of the breath of his anger."],["17",[["ἀπέστειλεν",701592,2],["ἐξ",704132,0],["ὕψους",713288,21],["καὶ",707031,7],["ἔλαβέν",708076,2],["με",708618,163],["εἵλκυσέν",704508,2],["με",708618,163],["ἐξ",704132,0],["ὑδάτων",713071,44],["πολλῶν",710646,83]],"He sent from above and took me; he drew me out of many waters."],["18",[["ἐρρύσατό",711309,23],["με",708618,163],["ἐξ",704132,0],["ἐχθρῶν",705779,169],["μου",709032,133],["ἰσχύος",706858,17],["ἐκ",704132,0],["τῶν",709436,80],["μισούντων",708935,170],["με",708618,163],["ὅτι",709803,7],["ἐκραταιώθησαν",707875,99],["ὑπὲρ",713111,0],["ἐμέ",704555,163]],"He delivered me from my strong enemies, from them that hated me, for they were stronger than I."],["19",[["προέφθασάν",711011,150],["με",708618,163],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["θλίψεώς",706276,17],["μου",709032,133],["καὶ",707031,7],["ἐγένετο",703104,23],["κύριος",707996,4],["ἐπιστήριγμά",705269,15],["μου",709032,133]],"The days of my affliction prevented me; but the Lord was my stay."],["20",[["καὶ",707031,7],["ἐξήγαγέν",704834,2],["με",708618,163],["εἰς",704105,0],["πλατυσμὸν",710510,6],["καὶ",707031,7],["ἐξείλατό",704838,23],["με",708618,163],["ὅτι",709803,7],["εὐδόκησεν",705565,2],["ἐν",704639,0],["ἐμοί",704577,159]],"And he brought me into a wide place, and rescued me, because he delighted in me."],["21",[["καὶ",707031,7],["ἀνταπέδωκέν",701215,2],["μοι",708974,159],["κύριος",707996,4],["κατὰ",707200,0],["τὴν",709436,8],["δικαιοσύνην",703695,9],["μου",709032,133],["κατὰ",707200,0],["τὴν",709436,8],["καθαριότητα",706986,9],["τῶν",709436,130],["χειρῶν",713787,65],["μου",709032,133],["ἀνταπέδωκέν",701215,2],["μοι",708974,159]],"And the Lord recompensed me according to my righteousness; even according to the purity of my hands did he recompense me."],["22",[["ὅτι",709803,7],["ἐφύλαξα",713619,155],["ὁδοὺς",709458,39],["κυρίου",707996,18],["καὶ",707031,7],["οὐκ",709805,28],["ἠσέβησα",701906,155],["ἀπὸ",701425,0],["τοῦ",709436,35],["θεοῦ",706192,18],["μου",709032,133]],"Because I kept the ways of the Lord, and did not wickedly depart from my God."],["23",[["ὅτι",709803,7],["πάντα",710177,195],["τὰ",709436,63],["κρίματα",707903,64],["αὐτοῦ",702165,102],["κατεναντίον",707509,28],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,63],["δικαιώματα",703697,64],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἀπέστην",702214,155],["ἀπ᾿",701425,0],["αὐτῶν",702165,70]],"For all his judgments and his ordinances [were] before me: I departed not from them."],["24",[["καὶ",707031,7],["ἔσομαι",704093,181],["ἄμωμος",700895,14],["αὐτῷ",702165,50],["καὶ",707031,7],["προφυλάξομαι",711014,181],["ἀπὸ",701425,0],["τῆς",709436,16],["ἀνομίας",701192,17],["μου",709032,133]],"And I shall be blameless before him, and will keep myself from my iniquity."],["25",[["καὶ",707031,7],["ἀποδώσει",701449,127],["μοι",708974,159],["κύριος",707996,4],["κατὰ",707200,0],["τὴν",709436,8],["δικαιοσύνην",703695,9],["μου",709032,133],["καὶ",707031,7],["κατὰ",707200,0],["τὴν",709436,8],["καθαριότητα",706986,9],["τῶν",709436,130],["χειρῶν",713787,65],["μου",709032,133],["ἐνώπιον",704823,0],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["αὐτοῦ",702165,102]],"And the Lord will recompense me according to my righteousness, and according to the purity of my hands in his eye-sight."],["26",[["μετὰ",708780,0],["ὁσίου",709782,116],["ὁσιωθήσῃ",709784,364],["καὶ",707031,7],["μετὰ",708780,0],["ἀνδρὸς",701150,18],["τελείου",712769,116],["τελειωθήσῃ",712771,364]],"With the holy thou wilt be holy, and with the perfect man thou wilt be perfect,"],["27",[["καὶ",707031,7],["μετὰ",708780,0],["ἐκλεκτοῦ",704240,116],["ἐκλεκτὸς",704240,14],["ἔσῃ",704093,123],["καὶ",707031,7],["μετὰ",708780,0],["στρεβλοῦ",712154,116],["στρεβλωθήσῃ",712155,364]],"and with the excellent thou wilt be excellent, and with the froward thou wilt be froward."],["28",[["καὶ",707031,7],["τὸν",709436,5],["λαὸν",708094,6],["τὸν",709436,5],["πτωχὸν",711076,6],["σώσεις",712627,166],["καὶ",707031,7],["ὀφθαλμοὺς",709870,57],["ἐπὶ",705080,0],["μετεώρων",708831,83],["ταπεινώσεις",712717,166]],"And thou wilt save the poor people, and wilt bring down the eyes of the haughty."],["29",[["ὅτι",709803,7],["σὺ",712181,164],["ὁ",709436,3],["λύχνος",708287,4],["μου",709032,133],["κύριε",707996,153],["καὶ",707031,7],["κύριος",707996,4],["ἐκλάμψει",704233,127],["μοι",708974,159],["τὸ",709436,24],["σκότος",711889,25],["μου",709032,133]],"For thou, Lord, [art] my lamp, and the Lord shall shine forth to me in my darkness."],["30",[["ὅτι",709803,7],["ἐν",704639,0],["σοὶ",711925,159],["δραμοῦμαι",712931,181],["μονόζωνος",708997,14],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["θεῷ",706192,114],["μου",709032,133],["ὑπερβήσομαι",713125,181],["τεῖχος",712759,25]],"For by thee shall I run [as] a girded man, and by my God shall I leap over a wall."],["31",[["ὁ",709436,3],["ἰσχυρός",706855,14],["ἄμωμος",700895,14],["ἡ",709436,10],["ὁδὸς",709458,12],["αὐτοῦ",702165,102],["τὸ",709436,34],["ῥῆμα",711246,15],["κυρίου",707996,18],["κραταιόν",707873,27],["πεπυρωμένον",711103,251],["ὑπερασπιστής",713123,4],["ἐστιν",704093,91],["πᾶσιν",710177,230],["τοῖς",709436,147],["πεποιθόσιν",710221,536],["ἐπ᾿",705080,0],["αὐτῷ",702165,50]],"As for the Mighty One, his way [is] blameless: the word of the Lord [is] strong [and] tried in the fire: he is a protector to all that put their trust in him."],["32",[["τίς",712867,158],["ἰσχυρὸς",706855,14],["πλὴν",710540,28],["κυρίου",707996,18],["καὶ",707031,7],["τίς",712867,158],["κτίστης",707941,4],["ἔσται",704093,93],["πλὴν",710540,28],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145]],"Who [is] strong, but the Lord? and who will be a Creator except our God?"],["33",[["ὁ",709436,3],["ἰσχυρὸς",706855,14],["ὁ",709436,3],["κραταιῶν",707873,169],["με",708618,163],["δυνάμει",703839,1],["καὶ",707031,7],["ἐξετίναξεν",704334,2],["ἄμωμον",700895,36],["τὴν",709436,8],["ὁδόν",709458,9],["μου",709032,133]],"[It is] the Mighty One who strengthens me with might, and has prepared my way without fault."],["34",[["τιθεὶς",712849,72],["τοὺς",709436,58],["πόδας",710707,57],["μου",709032,133],["ὡς",714148,7],["ἐλάφων",704398,81],["καὶ",707031,7],["ἐπὶ",705080,0],["τὰ",709436,41],["ὕψη",713288,42],["ἱστῶν",706846,72],["με",708618,163]],"He makes my feet like harts' feet, and sets me upon the high places."],["35",[["διδάσκων",703649,72],["χεῖράς",713787,39],["μου",709032,133],["εἰς",704105,0],["πόλεμον",710605,6],["καὶ",707031,7],["κατάξας",707227,182],["τόξον",712898,25],["χαλκοῦν",713690,46],["ἐν",704639,0],["βραχίονί",702808,114],["μου",709032,133]],"He teaches my hands to war, and has broken a brazen bow by my arm."],["36",[["καὶ",707031,7],["ἔδωκάς",703654,162],["μοι",708974,159],["ὑπερασπισμὸν",713122,6],["σωτηρίας",712658,17],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["ὑπακοή",713095,12],["σου",711945,133],["ἐπλήθυνέν",710530,13],["με",708618,163]],"And thou hast given me the shield of my salvation, and thy propitious dealing has increased me,"],["37",[["εἰς",704105,0],["πλατυσμὸν",710510,6],["εἰς",704105,0],["τὰ",709436,41],["διαβήματά",703422,42],["μου",709032,133],["ὑποκάτω",713204,28],["μου",709032,133],["καὶ",707031,7],["οὐκ",709805,28],["ἐσαλεύθησαν",711403,99],["τὰ",709436,63],["σκέλη",711831,64],["μου",709032,133]],"so as to make room under me for my going, and my legs did not totter."],["38",[["διώξω",703768,165],["ἐχθρούς",705779,60],["μου",709032,133],["καὶ",707031,7],["ἀφανιῶ",702182,165],["αὐτοὺς",702165,62],["καὶ",707031,7],["οὐκ",709805,28],["ἀναστρέψω",701060,165],["ἕως",705792,7],["συντελέσω",712510,165],["αὐτούς",702165,62]],"I will pursue my enemies, and will utterly destroy them; and I will not turn again till I have consumed them."],["39",[["καὶ",707031,7],["θλάσω",706273,165],["αὐτούς",702165,62],["καὶ",707031,7],["οὐκ",709805,28],["ἀναστήσονται",701173,135],["καὶ",707031,7],["πεσοῦνται",710481,135],["ὑπὸ",713184,0],["τοὺς",709436,58],["πόδας",710707,57],["μου",709032,133]],"And I will crush them, and they shall not rise; and they shall fall under my feet."],["40",[["καὶ",707031,7],["ἐνισχύσεις",704750,166],["με",708618,163],["δυνάμει",703839,1],["εἰς",704105,0],["πόλεμον",710605,6],["κάμψεις",707118,166],["τοὺς",709436,58],["ἐπανιστανομένους",705026,360],["μοι",708974,159],["ὑποκάτω",713204,28],["μου",709032,133]],"And thou shalt strengthen me with power for the war; thou shalt cause them that rise up against me to bow down under me."],["41",[["καὶ",707031,7],["τοὺς",709436,58],["ἐχθρούς",705779,60],["μου",709032,133],["ἔδωκάς",703654,162],["μοι",708974,159],["νῶτον",709403,25],["τοὺς",709436,58],["μισοῦντάς",708935,235],["με",708618,163],["καὶ",707031,7],["ἐθανάτωσας",706097,162],["αὐτούς",702165,62]],"And thou hast caused mine enemies to flee before me, even them that hated me, and thou hast slain them."],["42",[["βοήσονται",702743,135],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["βοηθός",702748,4],["πρὸς",710844,0],["κύριον",707996,6],["καὶ",707031,7],["οὐχ",709805,28],["ὑπήκουσεν",713096,2],["αὐτῶν",702165,40]],"They shall cry, and there shall be no helper; to the Lord, but he hearkens not to them."],["43",[["καὶ",707031,7],["ἐλέανα",708118,155],["αὐτοὺς",702165,62],["ὡς",714148,7],["χοῦν",713930,6],["γῆς",703083,17],["ὡς",714148,7],["πηλὸν",710457,6],["ἐξόδων",704948,65],["ἐλέπτυνα",708154,155],["αὐτούς",702165,62]],"And I ground them as the dust of the earth, I beat them small as the mire of the streets."],["44",[["καὶ",707031,7],["ῥύσῃ",711309,123],["με",708618,163],["ἐκ",704132,0],["μάχης",708601,17],["λαῶν",708094,81],["φυλάξεις",713619,166],["με",708618,163],["εἰς",704105,0],["κεφαλὴν",707639,9],["ἐθνῶν",704068,44],["λαός",708094,4],["ὃν",709781,112],["οὐκ",709805,28],["ἔγνων",703105,155],["ἐδούλευσάν",703814,150],["μοι",708974,159]],"And thou shalt deliver me from the striving of the peoples, thou shalt keep me [to be] the head of the Gentiles: a people which I knew not served me."],["45",[["υἱοὶ",713075,52],["ἀλλότριοι",700699,138],["ἐψεύσαντό",714045,189],["μοι",708974,159],["εἰς",704105,0],["ἀκοὴν",700561,9],["ὠτίου",714165,21],["ἤκουσάν",700587,150],["μου",709032,133]],"The strange children feigned [obedience] to me; they hearkened to me as soon as they heard."],["46",[["υἱοὶ",713075,52],["ἀλλότριοι",700699,138],["ἀπορριφήσονται",701563,144],["καὶ",707031,7],["σφαλοῦσιν",712575,218],["ἐκ",704132,0],["τῶν",709436,80],["συγκλεισμῶν",712220,81],["αὐτῶν",702165,40]],"The strange children shall be cast away, and shall be overthrown out of their hiding-places."],["47",[["ζῇ",705851,91],["κύριος",707996,4],["καὶ",707031,7],["εὐλογητὸς",705632,14],["ὁ",709436,3],["φύλαξ",713616,4],["μου",709032,133],["καὶ",707031,7],["ὑψωθήσεται",713289,134],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["ὁ",709436,3],["φύλαξ",713616,4],["τῆς",709436,16],["σωτηρίας",712658,17],["μου",709032,133]],"The Lord lives, and blessed [be] my guardian, and my God, my strong keeper, shall be exalted."],["48",[["ἰσχυρὸς",706855,14],["κύριος",707996,4],["ὁ",709436,3],["διδοὺς",703654,72],["ἐκδικήσεις",704175,39],["ἐμοί",704577,159],["παιδεύων",709926,72],["λαοὺς",708094,57],["ὑποκάτω",713204,28],["μου",709032,133]],"The Lord who avenges me [is] strong, chastening the nations under me,"],["49",[["καὶ",707031,7],["ἐξάγων",704834,72],["με",708618,163],["ἐξ",704132,0],["ἐχθρῶν",705779,169],["μου",709032,133],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,80],["ἐπεγειρομένων",705053,299],["μοι",708974,159],["ὑψώσεις",713289,166],["με",708618,163],["ἐξ",704132,0],["ἀνδρὸς",701150,18],["ἀδικημάτων",700270,44],["ῥύσῃ",711309,123],["με",708618,163]],"and bringing me out from my enemies: and thou shalt set me on high from among those that rise up against me: thou shalt deliver me from the violent man."],["50",[["διὰ",703417,0],["τοῦτο",709858,129],["ἐξομολογήσομαί",704960,181],["σοι",711925,159],["κύριε",707996,153],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["ψαλῶ",714021,165]],"Therefore will I confess to thee, O Lord, among the Gentiles, and sing to thy name."],["51",[["μεγαλύνων",708647,72],["σωτηρίας",712658,39],["βασιλέως",702580,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ποιῶν",710582,72],["ἔλεος",704426,15],["τῷ",709436,113],["χριστῷ",713964,30],["αὐτοῦ",702165,102],["τῷ",709436,113],["Δαυιδ",703232,114],["καὶ",707031,7],["τῷ",709436,53],["σπέρματι",712008,54],["αὐτοῦ",702165,102],["ἕως",705792,7],["αἰῶνος",700504,18]],"He magnifies the salvation of his king, and works mercy for his anointed, even for David and for his seed for ever."]]