,7],["αἰῶνος",700504,18]],"Let thy name be magnified for ever."],["27",[["κύριε",707996,153],["παντοκράτωρ",709986,4],["θεὸς",706192,4],["Ισραηλ",706839,18],["ἀπεκάλυψας",701474,162],["τὸ",709436,24],["ὠτίον",714165,25],["τοῦ",709436,35],["δούλου",703817,18],["σου",711945,133],["λέγων",708124,72],["οἶκον",709516,6],["οἰκοδομήσω",709509,165],["σοι",711925,159],["διὰ",703417,0],["τοῦτο",709858,129],["εὗρεν",705676,2],["ὁ",709436,3],["δοῦλός",703817,4],["σου",711945,133],["τὴν",709436,8],["καρδίαν",707141,9],["ἑαυτοῦ",703917,102],["τοῦ",709436,20],["προσεύξασθαι",710893,109],["πρὸς",710844,0],["σὲ",711598,163],["τὴν",709436,8],["προσευχὴν",710892,9],["ταύτην",709858,104]],"Almighty Lord God of Israel, thou hast uncovered the ear of thy servant, saying, I will build thee a house: therefore thy servant has found [in] his heart to pray this prayer to thee."],["28",[["καὶ",707031,7],["νῦν",709384,28],["κύριέ",707996,153],["μου",709032,133],["κύριε",707996,153],["σὺ",712181,164],["εἶ",704093,154],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["οἱ",709436,136],["λόγοι",708236,52],["σου",711945,133],["ἔσονται",704093,135],["ἀληθινοί",700659,138],["καὶ",707031,7],["ἐλάλησας",708071,162],["ὑπὲρ",713111,0],["τοῦ",709436,35],["δούλου",703817,18],["σου",711945,133],["τὰ",709436,41],["ἀγαθὰ",700106,68],["ταῦτα",709858,71]],"And now, O Lord my Lord, thou art God; and thy words will be true, and thou hast spoken these good things concerning thy servant."],["29",[["καὶ",707031,7],["νῦν",709384,28],["ἄρξαι",701860,225],["καὶ",707031,7],["εὐλόγησον",705631,176],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["δούλου",703817,18],["σου",711945,133],["τοῦ",709436,35],["εἶναι",704093,55],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἐνώπιόν",704823,0],["σου",711945,133],["ὅτι",709803,7],["σὺ",712181,164],["εἶ",704093,154],["κύριέ",707996,153],["μου",709032,133],["κύριε",707996,153],["ἐλάλησας",708071,162],["καὶ",707031,7],["ἀπὸ",701425,0],["τῆς",709436,16],["εὐλογίας",70