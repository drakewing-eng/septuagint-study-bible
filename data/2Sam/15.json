οι",711925,159],["παρὰ",709995,0],["τοῦ",709436,35],["βασιλέως",702580,18]],"And Abessalom said to him, See, thy affairs [are] right and clear, yet thou hast no one [appointed] of the king to hear thee."],["4",[["καὶ",707031,7],["εἶπεν",705373,2],["Αβεσσαλωμ",700052,4],["τίς",712867,158],["με",708618,163],["καταστήσει",707011,127],["κριτὴν",707910,6],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["καὶ",707031,7],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ἐλεύσεται",705453,93],["πᾶς",710177,14],["ἀνήρ",701150,4],["ᾧ",709781,309],["ἐὰν",703912,7],["ᾖ",704093,204],["ἀντιλογία",701249,12],["καὶ",707031,7],["κρίσις",707908,12],["καὶ",707031,7],["δικαιώσω",703696,165],["αὐτόν",702165,85]],"And Abessalom said, O that one would make me a judge in the land; then every man who had a dispute or a cause would come to me, and I would judge him!"],["5",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["τῷ",709436,53],["ἐγγίζειν",703939,55],["ἄνδρα",701150,6],["τοῦ",709436,20],["προσκυνῆσαι",710925,106],["αὐτῷ",702165,50],["καὶ",707031,7],["ἐξέτεινεν",704322,2],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπελαμβάνετο",705185,19],["αὐτοῦ",702165,102],["καὶ",707031,7],["κατεφίλησεν",707476,2],["αὐτόν",702165,85]],"And it came to pass when a man came near to do him obeisance, that he stretched out his hand, and took hold of him, and kissed him."],["6",[["καὶ",707031,7],["ἐποίησεν",710582,2],["Αβεσσαλωμ",700052,4],["κατὰ",707200,0],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["παντὶ",710177,30],["Ισραηλ",706839,18],["τοῖς",709436,147],["παραγινομένοις",710006,341],["εἰς",704105,0],["κρίσιν",707908,9],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["καὶ",707031,7],["ἰδιοποιεῖτο",706492,19],["Αβεσσαλωμ",700052,4],["τὴν",709436,8],["καρδίαν",707141,9],["ἀνδρῶν",701150,81],["Ισραηλ",706839,18]],"And Abessalom did after this manner to all Israel that came to the king for judgment; and Abessalom gained the hearts of the men of Israel."],["7",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἀπὸ",701425,0],["τέλους",712787,21],["τεσσαράκοντα",712806,59],["ἐτῶν",705543,44],["καὶ",707031,7],["εἶπεν",705373,2],["Αβεσσαλωμ",700052,4],["πρὸς",710844,0],["τὸν",709436,5],["πατέρα",710189,6],["αὐτοῦ",702165,102],["πορεύσομαι",710667,181],["δὴ",703395,11],["καὶ",707031,7],["ἀποτείσω",701618,165],["τὰς",709436,38],["εὐχάς",705726,39],["μου",709032,133],["ἃς",709781,193],["ηὐξάμην",705727,161],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐν",704639,0],["Χεβρων",713777,111]],"And it came to pass after forty years, that Abessalom said to his father, I will go now, and pay my vows, which I vowed to the Lord in Chebron."],["8",[["ὅτι",709803,7],["εὐχὴν",705726,9],["ηὔξατο",705727,23],["ὁ",709436,3],["δοῦλός",703817,4],["σου",711945,133],["ἐν",704639,0],["τῷ",709436,53],["οἰκεῖν",709499,55],["με",708618,163],["ἐν",704639,0],["Γεδσουρ",702998,111],["ἐν",704639,0],["Συρίᾳ",712533,111],["λέγων",708124,72],["ἐὰν",703912,7],["ἐπιστρέφων",705278,72],["ἐπιστρέψῃ",705278,123],["με",708618,163],["κύριος",707996,4],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["λατρεύσω",708108,165],["τῷ",709436,113],["κυρίῳ",707996,114]],"For thy servant vowed a vow when I dwelt at Gedsur in Syria, saying, If the Lord should indeed restore me to Jerusalem, then will I serve the Lord."],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["ὁ",709436,3],["βασιλεύς",702580,4],["βάδιζε",702367,240],["εἰς",704105,0],["εἰρήνην",704098,9],["καὶ",707031,7],["ἀναστὰς",701173,182],["ἐπορεύθη",710667,37],["εἰς",704105,0],["Χεβρων",713777,227]],"And the king said to him, Go in peace. And he arose and went to Chebron."],["10",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Αβεσσαλωμ",700052,4],["κατασκόπους",707427,57],["ἐν",704639,0],["πάσαις",710177,291],["φυλαῖς",713620,76],["Ισραηλ",706839,18],["λέγων",708124,72],["ἐν",704639,0],["τῷ",709436,53],["ἀκοῦσαι",700587,106],["ὑμᾶς",713080,194],["τὴν",709436,8],["φωνὴν",713640,9],["τῆς",709436,