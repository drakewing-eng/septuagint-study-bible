[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["μετὰ",708780,0],["ταῦτα",709858,71],["καὶ",707031,7],["ἀπέθανεν",701461,2],["βασιλεὺς",702580,4],["υἱῶν",713075,81],["Αμμων",700847,18],["καὶ",707031,7],["ἐβασίλευσεν",702581,2],["Αννων",701183,4],["υἱὸς",713075,4],["αὐτοῦ",702165,102],["ἀντ᾿",701227,0],["αὐτοῦ",702165,102]],"And it came to pass after this that the king of the children of Ammon died, and Annon his son reigned in his stead."],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["ποιήσω",710582,165],["ἔλεος",704426,4],["μετὰ",708780,0],["Αννων",701183,18],["υἱοῦ",713075,18],["Ναας",709126,18],["ὃν",709781,112],["τρόπον",712980,6],["ἐποίησεν",710582,2],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτοῦ",702165,102],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["ἔλεος",704426,4],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Δαυιδ",703232,4],["παρακαλέσαι",710039,106],["αὐτὸν",702165,85],["ἐν",704639,0],["χειρὶ",713787,1],["τῶν",709436,80],["δούλων",703817,81],["αὐτοῦ",702165,102],["περὶ",710285,0],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["παρεγένοντο",710006,189],["οἱ",709436,136],["παῖδες",709932,52],["Δαυιδ",703232,18],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["υἱῶν",713075,81],["Αμμων",700847,18]],"And David said, I will shew mercy to Annon the son of Naas, as his father dealt mercifully with me. And David sent to comfort him concerning his father by the hand of his servants; and the servants of David came into the land of the children of Ammon."],["3",[["καὶ",707031,7],["εἶπον",705373,150],["οἱ",709436,136],["ἄρχοντες",701862,52],["υἱῶν",713075,81],["Αμμων",700847,18],["πρὸς",710844,0],["Αννων",701183,6],["τὸν",709436,5],["κύριον",707996,6],["αὐτῶν",702165,40],["μὴ",708851,28],["παρὰ",709995,0],["τὸ",709436,24],["δοξάζειν",703792,55],["Δαυιδ",703232,4],["τὸν",709436,5],["πατέρα",710189,6],["σου",711945,133],["ἐνώπιόν",704823,28],["σου",711945,133],["ὅτι",709803,7],["ἀπέστειλέν",701592,2],["σοι",711925,159],["παρακαλοῦντας",710039,235],["ἀλλ᾿",700680,7],["οὐχὶ",709862,28],["ὅπως",709719,7],["ἐρευνήσωσιν",705412,234],["τὴν",709436,8],["πόλιν",710612,9],["καὶ",707031,7],["κατασκοπήσωσιν",707426,234],["αὐτὴν",702165,104],["καὶ",707031,7],["τοῦ",709436,20],["κατασκέψασθαι",707418,109],["αὐτὴν",702165,104],["ἀπέστειλεν",701592,2],["Δαυιδ",703232,4],["τοὺς",709436,58],["παῖδας",709932,57],["αὐτοῦ",702165,102],["πρὸς",710844,0],["σέ",711598,163]],"And the princes of the children of Ammon said to Annon their lord, [Is it] to honour thy father before thee that David has sent comforters to thee? Has not David rather sent his servants to thee that they should search the city, and spy it out and examine it?"],["4",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Αννων",701183,4],["τοὺς",709436,58],["παῖδας",709932,57],["Δαυιδ",703232,18],["καὶ",707031,7],["ἐξύρησεν",709431,2],["τοὺς",709436,58],["πώγωνας",711115,57],["αὐτῶν",702165,40],["καὶ",707031,7],["ἀπέκοψεν",701489,2],["τοὺς",709436,58],["μανδύας",708475,57],["αὐτῶν",702165,40],["ἐν",704639,0],["τῷ",709436,113],["ἡμίσει",705998,30],["ἕως",705792,7],["τῶν",709436,80],["ἰσχίων",706853,44],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐξαπέστειλεν",704872,2],["αὐτούς",702165,62]],"And Annon took the servants of David, and shaved their beards, and cut off their garments in the midst as far as their haunches, and sent them away."],["5",[["καὶ",707031,7],["ἀνήγγειλαν",700921,150],["τῷ",709436,113],["Δαυιδ",703232,114],["ὑπὲρ",713111,0],["τῶν",709436,80],["ἀνδρῶν",701150,81],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["εἰς",704105,0],["ἀπαντὴν",701346,9],["αὐτῶν",702165,40],["ὅτι",709803,7],["ἦσαν",704093,137],["οἱ",709436,136],["ἄνδρες",701150,52],["ἠτιμασμένοι",702092,429],["σφόδρα",712586,28],["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεύς",702580,4],["καθίσατε",707006,74],["ἐν",704639,0],["Ιεριχω",706620,111],["ἕως",705792,7],["τοῦ",709436,20],["ἀνατεῖλαι",701066,106],["τοὺς",709436,58],["πώγωνας",711115,57],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐπιστραφήσεσθε",705278,261]],"And they brought David word concerning the men; and he sent to meet them, for the men were greatly dishonoured: and the king said, Remain in Jericho till your beards have grown, and [then] ye shall return."],["6",[["καὶ",707031,7],["εἶδαν",709725,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Αμμων",700847,18],["ὅτι",709803,7],["κατῃσχύνθησαν",707257,99],["ὁ",709436,3],["λαὸς",708094,4],["Δαυιδ",703232,18],["καὶ",707031,7],["ἀπέστειλαν",701592,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Αμμων",700847,18],["καὶ",707031,7],["ἐμισθώσαντο",708940,189],["τὴν",709436,8],["Συρίαν",712533,9],["Βαιθροωβ",702428,118],["εἴκοσι",704085,59],["χιλιάδας",713858,39],["πεζῶν",710219,169],["καὶ",707031,7],["τὸν",709436,5],["βασιλέα",702580,6],["Μααχα",708318,118],["χιλίους",713859,60],["ἄνδρας",701150,57],["καὶ",707031,7],["Ιστωβ",706851,118],["δώδεκα",703887,59],["χιλιάδας",713858,39],["ἀνδρῶν",701150,81]],"And the children of Ammon saw that the people of David were ashamed; and the children of Ammon sent, and hired the Syrians of Bæthraam, and the Syrians of Suba, and Roob, twenty thousand footmen, and the king of Amalec with a thousand men, and Istob with twelve thousand men."],["7",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Δαυιδ",703232,4],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["τὸν",709436,5],["Ιωαβ",706877,6],["καὶ",707031,7],["πᾶσαν",710177,36],["τὴν",709436,8],["δύναμιν",703839,9],["τοὺς",709436,58],["δυνατούς",703845,60]],"And David heard, and sent Joab and all his host, [even] the mighty men."],["8",[["καὶ",707031,7],["ἐξῆλθαν",704909,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Αμμων",700847,118],["καὶ",707031,7],["παρετάξαντο",710108,189],["πόλεμον",710605,6],["παρὰ",709995,0],["τῇ",709436,100],["θύρᾳ",706337,1],["τῆς",709436,16],["πύλης",711082,17],["καὶ",707031,7],["Συρία",712533,12],["Σουβα",711948,118],["καὶ",707031,7],["Ροωβ",711300,118],["καὶ",707031,7],["Ιστωβ",706851,120],["καὶ",707031,7],["Μααχα",708318,120],["μόνοι",709003,138],["ἐν",704639,0],["ἀγρῷ",700196,114]],"And the children of Ammon went forth, and set the battle in array by the door of the gate: [those] of Syria, Suba, and Roob, and Istob, and Amalec, being by themselves in the field."],["9",[["καὶ",707031,7],["εἶδεν",709725,2],["Ιωαβ",706877,4],["ὅτι",709803,7],["ἐγενήθη",703104,37],["πρὸς",710844,0],["αὐτὸν",702165,85],["ἀντιπρόσωπον",701270,27],["τοῦ",709436,35],["πολέμου",710605,18],["ἐκ",704132,0],["τοῦ",709436,35],["κατὰ",707200,0],["πρόσωπον",710986,25],["ἐξ",704132,0],["ἐναντίας",704656,82],["καὶ",707031,7],["ἐκ",704132,0],["τοῦ",709436,35],["ὄπισθεν",709691,28],["καὶ",707031,7],["ἐπέλεξεν",705188,2],["ἐκ",704132,0],["πάντων",710177,169],["τῶν",709436,80],["νεανίσκων",709232,81],["Ισραηλ",706839,18],["καὶ",707031,7],["παρετάξαντο",710108,189],["ἐξ",704132,0],["ἐναντίας",704656,82],["Συρίας",712533,17]],"And Joab saw that the front of the battle was against him from that which was opposed in front and from behind, and he chose out [some] of all the young men of Israel, and they set themselves in array against Syria."],["10",[["καὶ",707031,7],["τὸ",709436,24],["κατάλοιπον",707317,46],["τοῦ",709436,35],["λαοῦ",708094,18],["ἔδωκεν",703654,2],["ἐν",704639,0],["χειρὶ",713787,1],["Αβεσσα",700051,18],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["παρετάξαντο",710108,189],["ἐξ",704132,0],["ἐναντίας",704656,82],["υἱῶν",713075,81],["Αμμων",700847,118]],"And the rest of the people he gave into the hand of Abessa his brother, and they set the battle in array opposite to the children of Ammon."],["11",[["καὶ",707031,7],["εἶπεν",705373,2],["ἐὰν",703912,28],["κραταιωθῇ",707875,384],["Συρία",712533,12],["ὑπὲρ",713111,0],["ἐμέ",704555,163],["καὶ",707031,7],["ἔσεσθέ",704093,124],["μοι",708974,159],["εἰς",704105,0],["σωτηρίαν",712658,9],["καὶ",707031,7],["ἐὰν",703912,7],["υἱοὶ",713075,52],["Αμμων",700847,118],["κραταιωθῶσιν",707875,272],["ὑπὲρ",713111,0],["σέ",711598,163],["καὶ",707031,7],["ἐσόμεθα",704093,141],["τοῦ",709436,20],["σῶσαί",712627,106],["σε",711598,163]],"And he said, If Syria be too strong for me, then shall ye help me: and if the children of Ammon be too strong for thee, then will we be ready to help thee."],["12",[["ἀνδρίζου",701104,253],["καὶ",707031,7],["κραταιωθῶμεν",707875,283],["ὑπὲρ",713111,0],["τοῦ",709436,35],["λαοῦ",708094,18],["ἡμῶν",705999,145],["καὶ",707031,7],["περὶ",710285,0],["τῶν",709436,130],["πόλεων",710612,65],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["καὶ",707031,7],["κύριος",707996,4],["ποιήσει",710582,127],["τὸ",709436,24],["ἀγαθὸν",700106,46],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["αὐτοῦ",702165,102]],"Be thou courageous, and let us be strong for our people, and for the sake of the cities of our God, and the Lord shall do that which is good in his eyes."],["13",[["καὶ",707031,7],["προσῆλθεν",710890,2],["Ιωαβ",706877,4],["καὶ",707031,7],["ὁ",709436,3],["λαὸς",708094,4],["αὐτοῦ",702165,102],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["εἰς",704105,0],["πόλεμον",710605,6],["πρὸς",710844,0],["Συρίαν",712533,9],["καὶ",707031,7],["ἔφυγαν",713433,150],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102]],"And Joab and his people with him advanced to battle against Syria, and they fled from before him."],["14",[["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["Αμμων",700847,118],["εἶδαν",709725,150],["ὅτι",709803,7],["ἔφυγεν",713433,2],["Συρία",712533,12],["καὶ",707031,7],["ἔφυγαν",713433,150],["ἀπὸ",701425,0],["προσώπου",710986,21],["Αβεσσα",700051,118],["καὶ",707031,7],["εἰσῆλθαν",704114,150],["εἰς",704105,0],["τὴν",709436,8],["πόλιν",710612,9],["καὶ",707031,7],["ἀνέστρεψεν",701060,2],["Ιωαβ",706877,4],["ἀπὸ",701425,0],["τῶν",709436,80],["υἱῶν",713075,81],["Αμμων",700847,118],["καὶ",707031,7],["παρεγένοντο",710006,189],["εἰς",704105,0],["Ιερουσαλημ",706644,9]],"And the children of Ammon saw that the Syrians were fled, and they fled from before Abessa, and entered into the city: and Joab returned from the children of Ammon, and came to Jerusalem."],["15",[["καὶ",707031,7],["εἶδεν",709725,2],["Συρία",712533,12],["ὅτι",709803,7],["ἔπταισεν",711048,2],["ἔμπροσθεν",704618,0],["Ισραηλ",706839,18],["καὶ",707031,7],["συνήχθησαν",712375,99],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτό",702165,129]],"And the Syrians saw that they were worsted before Israel, and they gathered themselves together."],["16",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Αδρααζαρ",700288,4],["καὶ",707031,7],["συνήγαγεν",712375,2],["τὴν",709436,8],["Συρίαν",712533,9],["τὴν",709436,8],["ἐκ",704132,0],["τοῦ",709436,35],["πέραν",710280,28],["τοῦ",709436,35],["ποταμοῦ",710693,18],["Χαλαμακ",713669,118],["καὶ",707031,7],["παρεγένοντο",710006,189],["Αιλαμ",700430,227],["καὶ",707031,7],["Σωβακ",712621,18],["ἄρχων",701860,72],["τῆς",709436,16],["δυνάμεως",703839,17],["Αδρααζαρ",700288,114],["ἔμπροσθεν",704618,0],["αὐτῶν",702165,40]],"And Adraazar sent and gathered the Syrians from the other side of the river Chalamak, and they came to Ælam; and Sobac the captain of the host of Adraazar [was] at their head."],["17",[["καὶ",707031,7],["ἀνηγγέλη",700921,37],["τῷ",709436,113],["Δαυιδ",703232,114],["καὶ",707031,7],["συνήγαγεν",712375,2],["τὸν",709436,5],["πάντα",710177,27],["Ισραηλ",706839,18],["καὶ",707031,7],["διέβη",703419,2],["τὸν",709436,5],["Ιορδάνην",706763,6],["καὶ",707031,7],["παρεγένοντο",710006,189],["εἰς",704105,0],["Αιλαμ",700430,227],["καὶ",707031,7],["παρετάξατο",710108,23],["Συρία",712533,12],["ἀπέναντι",701389,28],["Δαυιδ",703232,18],["καὶ",707031,7],["ἐπολέμησαν",710601,150],["μετ᾿",708780,0],["αὐτοῦ",702165,102]],"And it was reported to David, and he gathered all Israel, and went over Jordan, and came to Ælam: and the Syrians set the battle in array against David, and fought with him."],["18",[["καὶ",707031,7],["ἔφυγεν",713433,2],["Συρία",712533,12],["ἀπὸ",701425,0],["προσώπου",710986,21],["Ισραηλ",706839,18],["καὶ",707031,7],["ἀνεῖλεν",700962,2],["Δαυιδ",703232,4],["ἐκ",704132,0],["τῆς",709436,16],["Συρίας",712533,17],["ἑπτακόσια",705365,68],["ἅρματα",701768,42],["καὶ",707031,7],["τεσσαράκοντα",712806,59],["χιλιάδας",713858,39],["ἱππέων",706786,81],["καὶ",707031,7],["τὸν",709436,5],["Σωβακ",712621,6],["τὸν",709436,5],["ἄρχοντα",701862,6],["τῆς",709436,16],["δυνάμεως",703839,17],["αὐτοῦ",702165,102],["ἐπάταξεν",710185,2],["καὶ",707031,7],["ἀπέθανεν",701461,2],["ἐκεῖ",704181,28]],"And Syria fled from before Israel, and David destroyed of Syria seven hundred chariots, and forty thousand horsemen, and he smote Sobac the captain of his host, and he died there."],["19",[["καὶ",707031,7],["εἶδαν",709725,150],["πάντες",710177,138],["οἱ",709436,136],["βασιλεῖς",702580,52],["οἱ",709436,136],["δοῦλοι",703817,52],["Αδρααζαρ",700288,18],["ὅτι",709803,7],["ἔπταισαν",711048,150],["ἔμπροσθεν",704618,0],["Ισραηλ",706839,18],["καὶ",707031,7],["ηὐτομόλησαν",702164,150],["μετὰ",708780,0],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐδούλευσαν",703814,150],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἐφοβήθη",713532,37],["Συρία",712533,12],["τοῦ",709436,20],["σῶσαι",712627,106],["ἔτι",705538,28],["τοὺς",709436,58],["υἱοὺς",713075,57],["Αμμων",700847,118]],"And all the kings the servants of Adraazar saw that they were put to the worse before Israel, and they went over to Israel, and served them: and Syria was afraid to help the children of Ammon any more."]]