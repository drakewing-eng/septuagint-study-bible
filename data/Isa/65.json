[["1",[["ἐμφανὴς",704627,14],["ἐγενόμην",703104,161],["τοῖς",709436,147],["ἐμὲ",704555,163],["μὴ",708851,28],["ζητοῦσιν",705879,197],["εὑρέθην",705676,156],["τοῖς",709436,147],["ἐμὲ",704555,163],["μὴ",708851,28],["ἐπερωτῶσιν",705069,197],["εἶπα",705373,155],["ἰδού",706497,88],["εἰμι",704093,157],["τῷ",709436,53],["ἔθνει",704068,54],["οἳ",709781,250],["οὐκ",709805,28],["ἐκάλεσάν",707084,150],["μου",709032,133],["τὸ",709436,24],["ὄνομα",709666,25]],"I became manifest to them that asked not for me; I was found of them that sought me not: I said, Behold, I am [here], to a nation, who called not on my name."],["2",[["ἐξεπέτασα",704278,155],["τὰς",709436,38],["χεῖράς",713787,39],["μου",709032,133],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["πρὸς",710844,0],["λαὸν",708094,6],["ἀπειθοῦντα",701370,183],["καὶ",707031,7],["ἀντιλέγοντα",701245,183],["οἳ",709781,250],["οὐκ",709805,28],["ἐπορεύθησαν",710667,99],["ὁδῷ",709458,1],["ἀληθινῇ",700659,101],["ἀλλ᾿",700680,7],["ὀπίσω",709697,28],["τῶν",709436,130],["ἁμαρτιῶν",700775,65],["αὐτῶν",702165,40]],"I have stretched forth my hands all day to a disobedient and gainsaying people, to them that walked in a way that was not good, but after their sins."],["3",[["ὁ",709436,3],["λαὸς",708094,4],["οὗτος",709858,121],["ὁ",709436,3],["παροξύνων",710164,72],["με",708618,163],["ἐναντίον",704654,28],["ἐμοῦ",704580,133],["διὰ",703417,0],["παντός",710177,116],["αὐτοὶ",702165,201],["θυσιάζουσιν",706346,197],["ἐν",704639,0],["τοῖς",709436,147],["κήποις",707654,148],["καὶ",707031,7],["θυμιῶσιν",706332,197],["ἐπὶ",705080,0],["ταῖς",709436,75],["πλίνθοις",710554,76],["τοῖς",709436,147],["δαιμονίοις",703249,96],["ἃ",709781,371],["οὐκ",709805,28],["ἔστιν",704093,91]],"This is the people that provokes me continually in my presence; they offer sacrifices in gardens, and burn incense on bricks to devils, which exist not."],["4",[["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["μνήμασιν",708962,96],["καὶ",707031,7],["ἐν",704639,0],["τοῖ