[["1",[["οὐαὶ",709807,88],["τῷ",709436,113],["στεφάνῳ",712083,114],["τῆς",709436,16],["ὕβρεως",713051,17],["οἱ",709436,136],["μισθωτοὶ",708942,138],["Εφραιμ",705769,18],["τὸ",709436,34],["ἄνθος",701157,15],["τὸ",709436,34],["ἐκπεσὸν",704284,293],["ἐκ",704132,0],["τῆς",709436,16],["δόξης",703791,17],["ἐπὶ",705080,0],["τῆς",709436,16],["κορυφῆς",707844,17],["τοῦ",709436,20],["ὄρους",709768,21],["τοῦ",709436,20],["παχέος",710206,92],["οἱ",709436,136],["μεθύοντες",708676,146],["ἄνευ",701137,0],["οἴνου",709530,18]],"Woe to the crown of pride, the hirelings of Ephraim, the flower that has fallen from the glory of the top of the fertile mountain, they that are drunken without wine."],["2",[["ἰδοὺ",706497,88],["ἰσχυρὸν",706855,26],["καὶ",707031,7],["σκληρὸν",711861,26],["ὁ",709436,3],["θυμὸς",706334,4],["κυρίου",707996,18],["ὡς",714148,28],["χάλαζα",713667,12],["καταφερομένη",707471,211],["οὐκ",709805,28],["ἔχουσα",705785,188],["σκέπην",711839,9],["βίᾳ",702712,1],["καταφερομένη",707471,211],["ὡς",714148,28],["ὕδατος",713071,21],["πολὺ",710646,46],["πλῆθος",710529,25],["σῦρον",712543,511],["χώραν",714011,9],["τῇ",709436,100],["γῇ",703083,1],["ποιήσει",710582,127],["ἀνάπαυσιν",701026,9],["ταῖς",709436,75],["χερσίν",713787,76]],"Behold, the anger of the Lord is strong and severe, as descending hail where there is no shelter, violently descending; as a great body of water sweeping away the soil, he shall make rest for the land."],["3",[["καὶ",707031,7],["τοῖς",709436,147],["ποσὶν",710707,148],["καταπατηθήσεται",707360,134],["ὁ",709436,3],["στέφανος",712083,4],["τῆς",709436,16],["ὕβρεως",713051,17],["οἱ",709436,136],["μισθωτοὶ",708942,138],["τοῦ",709436,35],["Εφραιμ",705769,18]],"The crown of pride, the hirelings of Ephraim, shall be beaten down with the hands and with the feet."],["4",[["καὶ",707031,7],["ἔσται",704093,93],["τὸ",709436,34],["ἄνθος",701157,15],["τὸ",709436,34],["ἐκπεσὸν",704284,293],["τῆς",709436,16],["ἐλπίδος",704530,17],["τῆς",709436,16],["δόξης",703791,17],["ἐπ᾿",705080,0],["ἄκρου",700608,92],["τοῦ",709436,20],["ὄρους",709768,21],["τοῦ",709436,20],["ὑψηλοῦ",713285,92],["ὡς",714148,28],["πρόδρομος",710784,92],["σύκου",712255,21],["ὁ",709436,3],["ἰδὼν",709725,182],["αὐτὸ",702165,129],["πρὶν",710742,28],["ἢ",705924,7],["εἰς",704105,0],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["λαβεῖν",708076,106],["θελήσει",706176,127],["αὐτὸ",702165,129],["καταπιεῖν",707374,106]],"And the fading flower of the glorious hope on the top of the high mountain shall be as the early fig; he that sees it, before he takes it into his hand, will desire to swallow it down."],["5",[["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἔσται",704093,93],["κύριος",707996,4],["σαβαωθ",711346,228],["ὁ",709436,3],["στέφανος",712083,4],["τῆς",709436,16],["ἐλπίδος",704530,17],["ὁ",709436,3],["πλακεὶς",710515,217],["τῆς",709436,16],["δόξης",703791,17],["τῷ",709436,113],["καταλειφθέντι",707305,238],["μου",709032,133],["λαῷ",708094,114]],"In that day the Lord of hosts shall be the crown of hope, the woven [crown] of glory, to the remnant of the people."],["6",[["καταλειφθήσονται",707305,144],["ἐπὶ",705080,0],["πνεύματι",710566,54],["κρίσεως",707908,17],["ἐπὶ",705080,0],["κρίσιν",707908,9],["καὶ",707031,7],["ἰσχὺν",706858,9],["κωλύων",708020,72],["ἀνελεῖν",700962,106]],"They shall be left in the spirit of judgment for judgment, and for the strength of them that hinder slaying."],["7",[["οὗτοι",709858,201],["γὰρ",702963,11],["οἴνῳ",709530,114],["πεπλανημένοι",710495,429],["εἰσίν",704093,197],["ἐπλανήθησαν",710495,99],["διὰ",703417,0],["τὸ",709436,24],["σικερα",711781,25],["ἱερεὺς",706614,4],["καὶ",707031,7],["προφήτης",711009,4],["ἐξέστησαν",704940,150],["διὰ",703417,0],["τὸν",709436,5],["οἶνον",709530,6],["ἐσείσθησαν",711633,99],["ἀπὸ",701425,0],["τῆς",709436,16],["μέθης",708667,17],["τοῦ",709436,35],["σικερα",711781,25],["ἐπλανήθησαν",710495,99],["τοῦτ᾿",709858,132],["ἔστι",704093,91],["φάσμα",713385,15]],"For these have trespassed through wine; they have erred through strong drink: the priest and the prophet are mad through strong drink, they are swallowed up by reason of wine, they have staggered through drunkenness; they have erred: this is [their] vision."],["8",[["ἀρὰ",701665,12],["ἔδεται",705495,93],["ταύτην",709858,104],["τὴν",709436,8],["βουλήν",702792,9],["αὕτη",709858,107],["γὰρ",702963,11],["ἡ",709436,10],["βουλὴ",702792,12],["ἕνεκεν",704709,0],["πλεονεξίας",710523,17]],"A curse shall devour this counsel, for this [is their] counsel for the sake of covetousness."],["9",[["τίνι",712867,432],["ἀνηγγείλαμεν",700921,289],["κακὰ",707066,68],["καὶ",707031,7],["τίνι",712867,435],["ἀνηγγείλαμεν",700921,289],["ἀγγελίαν",700139,9],["οἱ",709436,136],["ἀπογεγαλακτισμένοι",701432,362],["ἀπὸ",701425,0],["γάλακτος",702919,21],["οἱ",709436,136],["ἀπεσπασμένοι",701583,429],["ἀπὸ",701425,0],["μαστοῦ",708569,18]],"To whom have we reported evils? and to whom have we reported a message? [even to those] that are weaned from the milk, who are drawn from the breast."],["10",[["θλῖψιν",706276,9],["ἐπὶ",705080,0],["θλῖψιν",706276,9],["προσδέχου",710874,253],["ἐλπίδα",704530,9],["ἐπ᾿",705080,0],["ἐλπίδι",704530,1],["ἔτι",705538,28],["μικρὸν",708915,27],["ἔτι",705538,28],["μικρὸν",708915,27]],"Expect thou affliction on affliction, hope upon hope: yet a little, [and] yet a little,"],["11",[["διὰ",703417,0],["φαυλισμὸν",713396,6],["χειλέων",713781,44],["διὰ",703417,0],["γλώσσης",703120,17],["ἑτέρας",705535,82],["ὅτι",709803,7],["λαλήσουσιν",708071,218],["τῷ",709436,113],["λαῷ",708094,114],["τούτῳ",709858,50]],"by reason of the contemptuous [words] of the lips, by means of another language: for they shall speak to this people, saying to them,"],["12",[["λέγοντες",708124,146],["αὐτῷ",702165,50],["τοῦτο",709858,132],["τὸ",709436,34],["ἀνάπαυμα",701025,15],["τῷ",709436,113],["πεινῶντι",710222,379],["καὶ",707031,7],["τοῦτο",709858,132],["τὸ",709436,34],["σύντριμμα",712521,15],["καὶ",707031,7],["οὐκ",709805,28],["ἠθέλησαν",706176,150],["ἀκούειν",700587,55]],"This is the rest to him that is hungry, and this is the calamity: but they would not hear."],["13",[["καὶ",707031,7],["ἔσται",704093,93],["αὐτοῖς",702165,151],["τὸ",709436,34],["λόγιον",708233,15],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["θλῖψις",706276,12],["ἐπὶ",705080,0],["θλῖψιν",706276,9],["ἐλπὶς",704530,12],["ἐπ᾿",705080,0],["ἐλπίδι",704530,1],["ἔτι",705538,28],["μικρὸν",708915,27],["ἔτι",705538,28],["μικρόν",708915,27],["ἵνα",706747,7],["πορευθῶσιν",710667,272],["καὶ",707031,7],["πέσωσιν",710481,234],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,28],["καὶ",707031,7],["κινδυνεύσουσιν",707677,218],["καὶ",707031,7],["συντριβήσονται",712520,144],["καὶ",707031,7],["ἁλώσονται",700673,135]],"Therefore the oracle of God shall be to them affliction on affliction, hope on hope, yet a little, [and] yet a little, that they may go and fall backward; and they shall be crushed and shall be in danger, and shall be taken."],["14",[["διὰ",703417,0],["τοῦτο",709858,129],["ἀκούσατε",700587,74],["λόγον",708236,6],["κυρίου",707996,18],["ἄνδρες",701150,52],["τεθλιμμένοι",706274,429],["καὶ",707031,7],["ἄρχοντες",701862,52],["τοῦ",709436,35],["λαοῦ",708094,18],["τούτου",709858,102],["τοῦ",709436,35],["ἐν",704639,0],["Ιερουσαλημ",706644,1]],"Therefore hear ye the word of the Lord, ye afflicted men, and ye princes of this people that is in Jerusalem."],["15",[["ὅτι",709803,7],["εἴπατε",705373,265],["ἐποιήσαμεν",710582,289],["διαθήκην",703456,9],["μετὰ",708780,0],["τοῦ",709436,35],["ᾅδου",700255,18],["καὶ",707031,7],["μετὰ",708780,0],["τοῦ",709436,35],["θανάτου",706096,18],["συνθήκας",712477,39],["καταιγὶς",707254,12],["φερομένη",713428,211],["ἐὰν",703912,7],["παρέλθῃ",710141,172],["οὐ",709805,28],["μὴ",708851,28],["ἔλθῃ",705453,172],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["ἐθήκαμεν",712849,289],["ψεῦδος",714044,25],["τὴν",709436,8],["ἐλπίδα",704530,9],["ἡμῶν",705999,145],["καὶ",707031,7],["τῷ",709436,53],["ψεύδει",714044,54],["σκεπασθησόμεθα",711832,347]],"Because ye have said, We have made a covenant with Hades, and agreements with death; if the rushing storm should pass, it shall not come upon us: we have made falsehood our hope, and by falsehood shall we be protected:"],["16",[["διὰ",703417,0],["τοῦτο",709858,129],["οὕτως",709859,28],["λέγει",708124,91],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐμβαλῶ",704547,165],["εἰς",704105,0],["τὰ",709436,41],["θεμέλια",706181,42],["Σιων",711816,17],["λίθον",708196,6],["πολυτελῆ",710647,27],["ἐκλεκτὸν",704240,27],["ἀκρογωνιαῖον",700606,27],["ἔντιμον",704798,27],["εἰς",704105,0],["τὰ",709436,41],["θεμέλια",706181,42],["αὐτῆς",702165,86],["καὶ",707031,7],["ὁ",709436,3],["πιστεύων",710483,72],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["οὐ",709805,28],["μὴ",708851,28],["καταισχυνθῇ",707257,384]],"therefore thus saith the Lord, [even] the Lord, Behold, I lay for the foundations of Sion a costly stone, a choice, a corner-stone, a precious [stone], for its foundations; and he that believes [on him] shall by no means be ashamed."],["17",[["καὶ",707031,7],["θήσω",712849,165],["κρίσιν",707908,9],["εἰς",704105,0],["ἐλπίδα",704530,9],["ἡ",709436,10],["δὲ",703303,11],["ἐλεημοσύνη",704421,12],["μου",709032,133],["εἰς",704105,0],["σταθμούς",712040,57],["καὶ",707031,7],["οἱ",709436,136],["πεποιθότες",710221,268],["μάτην",708582,28],["ψεύδει",714044,114],["ὅτι",709803,7],["οὐ",709805,28],["μὴ",708851,28],["παρέλθῃ",710141,172],["ὑμᾶς",713080,194],["καταιγίς",707254,12]],"And I will cause judgment [to be] for hope, and my compassion shall be for [just] measures, and ye that trust vainly in falsehood [shall fall]: for the storm shall by no means pass by you,"],["18",[["μὴ",708851,28],["καὶ",707031,7],["ἀφέλῃ",702177,172],["ὑμῶν",713091,145],["τὴν",709436,8],["διαθήκην",703456,9],["τοῦ",709436,35],["θανάτου",706096,18],["καὶ",707031,7],["ἡ",709436,10],["ἐλπὶς",704530,12],["ὑμῶν",713091,145],["ἡ",709436,10],["πρὸς",710844,0],["τὸν",709436,5],["ᾅδην",700255,6],["οὐ",709805,28],["μὴ",708851,28],["ἐμμείνῃ",704570,172],["καταιγὶς",707254,12],["φερομένη",713428,211],["ἐὰν",703912,7],["ἐπέλθῃ",705068,172],["ἔσεσθε",704093,124],["αὐτῇ",702165,105],["εἰς",704105,0],["καταπάτημα",707361,25]],"except it also take away your covenant of death, and your trust in Hades shall by no means stand: if the rushing storm should come upon you, ye shall be beaten down by it."],["19",[["ὅταν",709801,28],["παρέλθῃ",710141,172],["λήμψεται",708076,93],["ὑμᾶς",713080,194],["πρωὶ",711021,28],["πρωὶ",711021,28],["παρελεύσεται",710141,93],["ἡμέρας",705984,17],["καὶ",707031,7],["ἐν",704639,0],["νυκτὶ",709386,1],["ἔσται",704093,93],["ἐλπὶς",704530,12],["πονηρά",710660,68],["μάθετε",708480,74],["ἀκούειν",700587,55]],"Whenever it shall pass by, it shall take you; morning by morning it shall pass by in the day, and in the night there shall be an evil hope. Learn to hear,"],["20",[["στενοχωρούμενοι",712070,348],["οὐ",709805,28],["δυνάμεθα",703838,378],["μάχεσθαι",708610,110],["αὐτοὶ",702165,201],["δὲ",703303,11],["ἀσθενοῦμεν",701938,243],["τοῦ",709436,35],["ἡμᾶς",705981,194],["συναχθῆναι",712375,179]],"ye that are distressed; we cannot fight, but we are ourselves too weak for you to be gathered."],["21",[["ὥσπερ",714163,28],["ὄρος",709768,25],["ἀσεβῶν",701909,169],["ἀναστήσεται",701173,93],["καὶ",707031,7],["ἔσται",704093,93],["ἐν",704639,0],["τῇ",709436,100],["φάραγγι",713351,1],["Γαβαων",702858,118],["μετὰ",708780,0],["θυμοῦ",706334,18],["ποιήσει",710582,127],["τὰ",709436,41],["ἔργα",705396,42],["αὐτοῦ",702165,102],["πικρίας",710472,17],["ἔργον",705396,25],["ὁ",709436,3],["δὲ",703303,11],["θυμὸς",706334,4],["αὐτοῦ",702165,102],["ἀλλοτρίως",700702,28],["χρήσεται",713937,93],["καὶ",707031,7],["ἡ",709436,10],["πικρία",710472,12],["αὐτοῦ",702165,102],["ἀλλοτρία",700699,29]],"The Lord shall rise up as a mountain of ungodly [men], and shall be in the valley of Gabaon; he shall perform his works with wrath, [even] a work of bitterness, and his wrath shall deal strangely, and his destruction shall be strange."],["22",[["καὶ",707031,7],["ὑμεῖς",713081,219],["μὴ",708851,28],["εὐφρανθείητε",705715,531],["μηδὲ",708855,7],["ἰσχυσάτωσαν",706859,264],["ὑμῶν",713091,145],["οἱ",709436,136],["δεσμοί",703372,52],["διότι",703734,7],["συντετελεσμένα",712510,388],["καὶ",707031,7],["συντετμημένα",712511,388],["πράγματα",710708,42],["ἤκουσα",700587,155],["παρὰ",709995,0],["κυρίου",707996,18],["σαβαωθ",711346,228],["ἃ",709781,69],["ποιήσει",710582,127],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9]],"Therefore do not ye rejoice, neither let your bands be made strong; for I have heard of works finished and cut short by the Lord of hosts, which he will execute upon all the earth."],["23",[["ἐνωτίζεσθε",704825,73],["καὶ",707031,7],["ἀκούετε",700587,335],["τῆς",709436,16],["φωνῆς",713640,17],["μου",709032,133],["προσέχετε",710895,335],["καὶ",707031,7],["ἀκούετε",700587,335],["τοὺς",709436,58],["λόγους",708236,57],["μου",709032,133]],"Hearken, and hear my voice; attend, and hear my words."],["24",[["μὴ",708851,28],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["μέλλει",708705,91],["ὁ",709436,3],["ἀροτριῶν",701791,72],["ἀροτριᾶν",701791,55],["ἢ",705924,7],["σπόρον",712030,6],["προετοιμάσει",710790,127],["πρὶν",710742,28],["ἐργάσασθαι",705383,109],["τὴν",709436,8],["γῆν",703083,9]],"Will the ploughman plough all the day? or will he prepare the seed beforehand, before he tills the ground?"],["25",[["οὐχ",709805,28],["ὅταν",709801,28],["ὁμαλίσῃ",709607,172],["αὐτῆς",702165,86],["τὸ",709436,24],["πρόσωπον",710986,25],["τότε",712908,28],["σπείρει",712006,91],["μικρὸν",708915,46],["μελάνθιον",708692,25],["καὶ",707031,7],["κύμινον",707973,25],["καὶ",707031,7],["πάλιν",709942,28],["σπείρει",712006,91],["πυρὸν",711101,6],["καὶ",707031,7],["κριθὴν",707900,9],["καὶ",707031,7],["ζέαν",705852,9],["ἐν",704639,0],["τοῖς",709436,95],["ὁρίοις",709749,96],["σου",711945,133]],"Does he not, when he has levelled the surface thereof, then sow the small black poppy, or cumin, and afterward sow wheat, and barley, and millet, and bread-corn in thy borders?"],["26",[["καὶ",707031,7],["παιδευθήσῃ",709926,364],["κρίματι",707903,54],["θεοῦ",706192,18],["σου",711945,133],["καὶ",707031,7],["εὐφρανθήσῃ",705715,364]],"So thou shalt be chastened by the judgment of thy God, and shalt rejoice."],["27",[["οὐ",709805,28],["γὰρ",702963,11],["μετὰ",708780,0],["σκληρότητος",711862,17],["καθαίρεται",706983,117],["τὸ",709436,24],["μελάνθιον",708692,25],["οὐδὲ",709816,7],["τροχὸς",712994,4],["ἁμάξης",700766,17],["περιάξει",710287,127],["ἐπὶ",705080,0],["τὸ",709436,24],["κύμινον",707973,25],["ἀλλὰ",700680,7],["ῥάβδῳ",711135,1],["ἐκτινάσσεται",704334,93],["τὸ",709436,24],["μελάνθιον",708692,25],["τὸ",709436,24],["δὲ",703303,11],["κύμινον",707973,25]],"For the black poppy is not cleansed with harsh treatment, nor will a waggon-wheel pass over the cumin; but the black poppy is threshed with a rod, and the cumin shall be eaten with bread;"],["28",[["μετὰ",708780,0],["ἄρτου",701829,18],["βρωθήσεται",702722,134],["οὐ",709805,28],["γὰρ",702963,11],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἐγὼ",704018,164],["ὑμῖν",713084,90],["ὀργισθήσομαι",709729,180],["οὐδὲ",709816,7],["φωνὴ",713640,12],["τῆς",709436,16],["πικρίας",710472,17],["μου",709032,133],["καταπατήσει",707360,127],["ὑμᾶς",713080,194]],"for I will not be wroth with you for ever, neither shall the voice of my anger crush you."],["29",[["καὶ",707031,7],["ταῦτα",709858,290],["παρὰ",709995,0],["κυρίου",707996,18],["σαβαωθ",711346,228],["ἐξῆλθεν",704909,2],["τὰ",709436,63],["τέρατα",712793,15],["βουλεύσασθε",702791,186],["ὑψώσατε",713289,74],["ματαίαν",708575,36],["παράκλησιν",710047,9]],"And these signs came forth from the Lord of hosts. Take counsel, exalt vain comfort."]]