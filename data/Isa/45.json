[["1",[["οὕτως",709859,28],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τῷ",709436,113],["χριστῷ",713964,30],["μου",709032,133],["Κύρῳ",707997,114],["οὗ",709781,48],["ἐκράτησα",707879,155],["τῆς",709436,16],["δεξιᾶς",703360,82],["ἐπακοῦσαι",705009,106],["ἔμπροσθεν",704618,0],["αὐτοῦ",702165,102],["ἔθνη",704068,42],["καὶ",707031,7],["ἰσχὺν",706858,9],["βασιλέων",702580,81],["διαρρήξω",703565,165],["ἀνοίξω",701186,207],["ἔμπροσθεν",704618,0],["αὐτοῦ",702165,102],["θύρας",706337,39],["καὶ",707031,7],["πόλεις",710612,191],["οὐ",709805,28],["συγκλεισθήσονται",712223,144]],"Thus saith the Lord God to my anointed Cyrus, whose right hand I have held, that nations might be obedient before him; and I will break through the strength of kings; I will open doors before him, and cities shall not be closed."],["2",[["ἐγὼ",704018,164],["ἔμπροσθέν",704618,0],["σου",711945,133],["πορεύσομαι",710667,181],["καὶ",707031,7],["ὄρη",709768,42],["ὁμαλιῶ",709607,165],["θύρας",706337,39],["χαλκᾶς",713690,119],["συντρίψω",712520,165],["καὶ",707031,7],["μοχλοὺς",709040,57],["σιδηροῦς",711774,57],["συγκλάσω",712216,165]],"I will go before thee, and will level mountains: I will break to pieces brazen doors, and will burst iron bars."],["3",[["καὶ",707031,7],["δώσω",703654,165],["σοι",711925,159],["θησαυροὺς",706258,57],["σκοτεινούς",711885,60],["ἀποκρύφους",701497,60],["ἀοράτους",701318,60],["ἀνοίξω",701186,207],["σοι",711925,159],["ἵνα",706747,7],["γνῷς",703105,175],["ὅτι",709803,7],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["καλῶν",707084,72],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["θεὸς",706192,4],["Ισραηλ",706839,18]],"And I will give thee the treasures of darkness, I will open to thee hidden, unseen [treasures], that thou mayest know that I, the Lord thy God, that call thee by name, am the God of Israel."],["4",[["ἕνεκεν",704709,0],["Ιακωβ",706401,18],["τοῦ",709436,35],["παιδός",709932,18],["μου",709032,133],["καὶ",707031,7],["Ισραηλ",706839,18],["τοῦ",709436,35],["ἐκλεκτοῦ",704240,116],["μου",709032,133],["ἐγὼ",704018,164],["καλέσω",707084,165],["σε",711598,163],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["καὶ",707031,7],["προσδέξομαί",710874,181],["σε",711598,163],["σὺ",712181,164],["δὲ",703303,11],["οὐκ",709805,28],["ἔγνως",703105,162],["με",708618,163]],"For the sake of my servant Jacob, and Israel mine elect, I will call thee by thy name, and accept thee: but thou hast not known me."],["5",[["ὅτι",709803,7],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἔτι",705538,28],["πλὴν",710540,0],["ἐμοῦ",704580,133],["θεός",706192,4],["καὶ",707031,7],["οὐκ",709805,28],["ᾔδεις",709492,508],["με",708618,163]],"For I am the Lord God, and there is no other God beside me; I strengthened thee, and thou hast not known me."],["6",[["ἵνα",706747,7],["γνῶσιν",703105,234],["οἱ",709436,136],["ἀπὸ",701425,0],["ἀνατολῶν",701071,65],["ἡλίου",705974,18],["καὶ",707031,7],["οἱ",709436,136],["ἀπὸ",701425,0],["δυσμῶν",703865,65],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["πλὴν",710540,0],["ἐμοῦ",704580,133],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἔτι",705538,28]],"That they that [come] from the east and they that [come] from the west may know that there is no God but me. I am the Lord God, and there is none beside."],["7",[["ἐγὼ",704018,164],["ὁ",709436,3],["κατασκευάσας",707419,182],["φῶς",713642,25],["καὶ",707031,7],["ποιήσας",710582,182],["σκότος",711889,25],["ὁ",709436,3],["ποιῶν",710582,72],["εἰρήνην",704098,9],["καὶ",707031,7],["κτίζων",707938,72],["κακά",707066,68],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["ποιῶν",710582,72],["ταῦτα",709858,71],["πάντα",710177,68]],"I am he that prepared light, and formed darkness; who make peace, and create evil; I am the Lord God, that does all these things."],["8",[["εὐφρανθήτω",705715,22],["ὁ",709436,3],["οὐρανὸς",709844,4],["ἄνωθεν",701298,28],["καὶ",707031,7],["αἱ",709436,190],["νεφέλαι",709277,191],["ῥανάτωσαν",711158,264],["δικαιοσύνην",703695,9],["ἀνατειλάτω",701066,45],["ἡ",709436,10],["γῆ",703083,12],["ἔλεος",704426,25],["καὶ",707031,7],["δικαιοσύνην",703695,9],["ἀνατειλάτω",701066,45],["ἅμα",700745,28],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["ὁ",709436,3],["κτίσας",707938,182],["σε",711598,163]],"Let the heaven rejoice from above, and let the clouds rain righteousness: let the earth bring forth, and blossom [with] mercy, and bring forth righteousness likewise: I am the Lord that created thee."],["9",[["ποῖον",710599,46],["βέλτιον",702647,46],["κατεσκεύασα",707419,155],["ὡς",714148,28],["πηλὸν",710457,6],["κεραμέως",707619,18],["μὴ",708851,28],["ὁ",709436,3],["ἀροτριῶν",701791,72],["ἀροτριάσει",701791,127],["τὴν",709436,8],["γῆν",703083,9],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["μὴ",708851,28],["ἐρεῖ",705415,127],["ὁ",709436,3],["πηλὸς",710457,4],["τῷ",709436,113],["κεραμεῖ",707619,114],["τί",712867,126],["ποιεῖς",710582,154],["ὅτι",709803,7],["οὐκ",709805,28],["ἐργάζῃ",705383,259],["οὐδὲ",709816,7],["ἔχεις",705785,154],["χεῖρας",713787,39]],"What excellent thing have I prepared as clay of the potter? Will the ploughman plough the earth all day? shall the clay say to the potter, What art thou doing that thou dost not work, nor hast hands? shall the thing formed answer him that formed it?"],["10",[["ὁ",709436,3],["λέγων",708124,72],["τῷ",709436,113],["πατρί",710189,114],["τί",712867,126],["γεννήσεις",703051,166],["καὶ",707031,7],["τῇ",709436,100],["μητρί",708892,1],["τί",712867,126],["ὠδινήσεις",714095,166]],"As though one should say to [his] father, What wilt thou beget me? and to his mother, What art thou bringing forth?"],["11",[["ὅτι",709803,7],["οὕτως",709859,28],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["ἅγιος",700159,14],["Ισραηλ",706839,18],["ὁ",709436,3],["ποιήσας",710582,182],["τὰ",709436,41],["ἐπερχόμενα",705068,67],["ἐρωτήσατέ",705459,74],["με",708618,163],["περὶ",710285,0],["τῶν",709436,80],["υἱῶν",713075,81],["μου",709032,133],["καὶ",707031,7],["περὶ",710285,0],["τῶν",709436,130],["θυγατέρων",706320,65],["μου",709032,133],["καὶ",707031,7],["περὶ",710285,0],["τῶν",709436,43],["ἔργων",705396,44],["τῶν",709436,130],["χειρῶν",713787,65],["μου",709032,133],["ἐντείλασθέ",704791,186],["μοι",708974,159]],"For thus saith the Lord God, the Holy One of Israel, who has formed the things that are to come, Enquire of me concerning my sons, and concerning the works of my hands command me."],["12",[["ἐγὼ",704018,164],["ἐποίησα",710582,155],["γῆν",703083,9],["καὶ",707031,7],["ἄνθρωπον",701163,6],["ἐπ᾿",705080,0],["αὐτῆς",702165,86],["ἐγὼ",704018,164],["τῇ",709436,100],["χειρί",713787,1],["μου",709032,133],["ἐστερέωσα",712076,155],["τὸν",709436,5],["οὐρανόν",709844,6],["ἐγὼ",704018,164],["πᾶσι",710177,94],["τοῖς",709436,95],["ἄστροις",702024,96],["ἐνετειλάμην",704791,161]],"I have made the earth, and man upon it: I with my hand have established the heaven; I have given commandment to all the stars."],["13",[["ἐγὼ",704018,164],["ἤγειρα",703949,155],["αὐτὸν",702165,85],["μετὰ",708780,0],["δικαιοσύνης",703695,17],["βασιλέα",702580,6],["καὶ",707031,7],["πᾶσαι",710177,192],["αἱ",709436,190],["ὁδοὶ",709458,191],["αὐτοῦ",702165,102],["εὐθεῖαι",705602,192],["οὗτος",709858,121],["οἰκοδομήσει",709509,127],["τὴν",709436,8],["πόλιν",710612,9],["μου",709032,133],["καὶ",707031,7],["τὴν",709436,8],["αἰχμαλωσίαν",700499,9],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133],["ἐπιστρέψει",705278,127],["οὐ",709805,28],["μετὰ",708780,0],["λύτρων",708281,44],["οὐδὲ",709816,7],["μετὰ",708780,0],["δώρων",703907,44],["εἶπεν",705373,2],["κύριος",707996,4],["σαβαωθ",711346,228]],"I have raised him up [to be] a king with righteousness, and all his ways are right: he shall build my city, and shall turn the captivity of my people, not for ransoms, nor for rewards, saith the Lord of hosts."],["14",[["οὕτως",709859,28],["λέγει",708124,91],["κύριος",707996,4],["σαβαωθ",711346,228],["ἐκοπίασεν",707824,2],["Αἴγυπτος",700401,12],["καὶ",707031,7],["ἐμπορία",704612,12],["Αἰθιόπων",700420,81],["καὶ",707031,7],["οἱ",709436,136],["Σεβωιν",711613,52],["ἄνδρες",701150,52],["ὑψηλοὶ",713285,138],["ἐπὶ",705080,0],["σὲ",711598,163],["διαβήσονται",703419,135],["καὶ",707031,7],["σοὶ",711925,159],["ἔσονται",704093,135],["δοῦλοι",703817,52],["καὶ",707031,7],["ὀπίσω",709697,28],["σου",711945,133],["ἀκολουθήσουσιν",700566,218],["δεδεμένοι",703394,429],["χειροπέδαις",713795,76],["καὶ",707031,7],["προσκυνήσουσίν",710925,218],["σοι",711925,159],["καὶ",707031,7],["ἐν",704639,0],["σοὶ",711925,159],["προσεύξονται",710893,135],["ὅτι",709803,7],["ἐν",704639,0],["σοὶ",711925,159],["ὁ",709436,3],["θεός",706192,4],["ἐστιν",704093,91],["καὶ",707031,7],["ἐροῦσιν",705415,218],["οὐκ",709805,28],["ἔστιν",704093,91],["θεὸς",706192,4],["πλὴν",710540,0],["σοῦ",711945,133]],"Thus saith the Lord of hosts, Egypt has laboured [for thee]; and the merchandise of the Ethiopians, and the Sabeans, men of stature, shall pass over to thee, and shall be thy servants; and they shall follow after thee bound in fetters, and shall pass over to thee, and shall do obeisance to thee, and make supplication to thee: because God is in thee; and there is no God beside thee, [O Lord]."],["15",[["σὺ",712181,164],["γὰρ",702963,11],["εἶ",704093,154],["θεός",706192,4],["καὶ",707031,7],["οὐκ",709805,28],["ᾔδειμεν",709492,376],["ὁ",709436,3],["θεὸς",706192,4],["τοῦ",709436,35],["Ισραηλ",706839,18],["σωτήρ",712657,4]],"For thou art God, yet we knew [it] not, the God of Israel, the Saviour."],["16",[["αἰσχυνθήσονται",700485,144],["καὶ",707031,7],["ἐντραπήσονται",704805,144],["πάντες",710177,138],["οἱ",709436,136],["ἀντικείμενοι",701240,348],["αὐτῷ",702165,50],["καὶ",707031,7],["πορεύσονται",710667,135],["ἐν",704639,0],["αἰσχύνῃ",700483,1],["ἐγκαινίζεσθε",703956,186],["πρός",710844,0],["με",708618,163],["νῆσοι",709302,191]],"All that are opposed to him shall be ashamed and confounded, and shall walk in shame: ye isles, keep a feast to me."],["17",[["Ισραηλ",706839,4],["σῴζεται",712627,117],["ὑπὸ",713184,0],["κυρίου",707996,18],["σωτηρίαν",712658,9],["αἰώνιον",700505,36],["οὐκ",709805,28],["αἰσχυνθήσονται",700485,144],["οὐδὲ",709816,7],["μὴ",708851,28],["ἐντραπῶσιν",704805,234],["ἕως",705792,0],["τοῦ",709436,35],["αἰῶνος",700504,18]],"Israel is saved by the Lord with an everlasting salvation: they shall not be ashamed nor confounded for evermore."],["18",[["οὕτως",709859,28],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["ποιήσας",710582,182],["τὸν",709436,5],["οὐρανόν",709844,6],["οὗτος",709858,121],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["καταδείξας",707235,182],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ποιήσας",710582,182],["αὐτήν",702165,104],["αὐτὸς",702165,121],["διώρισεν",703730,2],["αὐτήν",702165,104],["οὐκ",709805,28],["εἰς",704105,0],["κενὸν",707612,27],["ἐποίησεν",710582,2],["αὐτὴν",702165,104],["ἀλλὰ",700680,7],["κατοικεῖσθαι",707534,110],["ἐγώ",704018,781],["εἰμι",704093,157],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἔτι",705538,28]],"Thus saith the Lord that made the heaven, this God that created the earth, and made it; he marked it out, he made it not in vain, but formed it to be inhabited: I am the Lord, and there is none beside."],["19",[["οὐκ",709805,28],["ἐν",704639,0],["κρυφῇ",707929,28],["λελάληκα",708071,89],["οὐδὲ",709816,7],["ἐν",704639,0],["τόπῳ",712903,114],["γῆς",703083,17],["σκοτεινῷ",711885,30],["οὐκ",709805,28],["εἶπα",705373,155],["τῷ",709436,53],["σπέρματι",712008,54],["Ιακωβ",706401,18],["μάταιον",708575,27],["ζητήσατε",705879,74],["ἐγώ",704018,164],["εἰμι",704093,157],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["λαλῶν",708071,72],["δικαιοσύνην",703695,9],["καὶ",707031,7],["ἀναγγέλλων",700921,72],["ἀλήθειαν",700656,9]],"I have not spoken in secret, nor in a dark place of the earth: I said not to the seed of Jacob, Seek vanity: I, even I, am the Lord, speaking righteousness, and proclaiming truth."],["20",[["συνάχθητε",712375,372],["καὶ",707031,7],["ἥκετε",705956,335],["βουλεύσασθε",702791,186],["ἅμα",700745,28],["οἱ",709436,136],["σῳζόμενοι",712627,645],["ἀπὸ",701425,0],["τῶν",709436,43],["ἐθνῶν",704068,44],["οὐκ",709805,28],["ἔγνωσαν",703105,150],["οἱ",709436,136],["αἴροντες",700473,146],["τὸ",709436,24],["ξύλον",709427,25],["γλύμμα",703116,25],["αὐτῶν",702165,40],["καὶ",707031,7],["προσευχόμενοι",710893,348],["ὡς",714148,28],["πρὸς",710844,0],["θεούς",706192,57],["οἳ",709781,250],["οὐ",709805,28],["σῴζουσιν",712627,197]],"Assemble yourselves and come; take counsel together, ye that escape of the nations: they that set up wood, [even] their graven image, have no knowledge, nor they who pray to gods that do not save."],["21",[["εἰ",704071,11],["ἀναγγελοῦσιν",700921,218],["ἐγγισάτωσαν",703939,264],["ἵνα",706747,7],["γνῶσιν",703105,234],["ἅμα",700745,28],["τίς",712867,158],["ἀκουστὰ",700584,68],["ἐποίησεν",710582,2],["ταῦτα",709858,71],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["τότε",712908,28],["ἀνηγγέλη",700921,37],["ὑμῖν",713084,90],["ἐγὼ",704018,164],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἄλλος",700697,121],["πλὴν",710540,0],["ἐμοῦ",704580,133],["δίκαιος",703694,14],["καὶ",707031,7],["σωτὴρ",712657,4],["οὐκ",709805,28],["ἔστιν",704093,91],["πάρεξ",710136,0],["ἐμοῦ",704580,133]],"If they will declare, let them draw nigh, that they may know together, who has caused these things to be heard from the beginning: then was it told you. I am God, and there is not another beside me; a just [God] and a Saviour; there is none but me."],["22",[["ἐπιστράφητε",705278,372],["πρός",710844,0],["με",708618,163],["καὶ",707031,7],["σωθήσεσθε",712627,261],["οἱ",709436,136],["ἀπ᾿",701425,0],["ἐσχάτου",705519,116],["τῆς",709436,16],["γῆς",703083,17],["ἐγώ",704018,164],["εἰμι",704093,157],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἄλλος",700697,121]],"Turn ye to me, and ye shall be saved, ye that [come] from the end of the earth: I am God, and there is none other."],["23",[["κατ᾿",707200,0],["ἐμαυτοῦ",704545,102],["ὀμνύω",709620,157],["ἦ",705925,11],["μὴν",708873,11],["ἐξελεύσεται",704909,93],["ἐκ",704132,0],["τοῦ",709436,20],["στόματός",712125,21],["μου",709032,133],["δικαιοσύνη",703695,12],["οἱ",709436,136],["λόγοι",708236,52],["μου",709032,133],["οὐκ",709805,28],["ἀποστραφήσονται",701598,144],["ὅτι",709803,7],["ἐμοὶ",704577,159],["κάμψει",707118,127],["πᾶν",710177,26],["γόνυ",703172,15],["καὶ",707031,7],["ἐξομολογήσεται",704960,93],["πᾶσα",710177,29],["γλῶσσα",703120,12],["τῷ",709436,113],["θεῷ",706192,114]],"By myself I swear, righteousness shall surely proceed out of my mouth; my words shall not be frustrated; that to me every knee shall bend, and every tongue shall swear by God,"],["24",[["λέγων",708124,72],["δικαιοσύνη",703695,12],["καὶ",707031,7],["δόξα",703791,12],["πρὸς",710844,0],["αὐτὸν",702165,85],["ἥξουσιν",705956,218],["καὶ",707031,7],["αἰσχυνθήσονται",700485,144],["πάντες",710177,138],["οἱ",709436,136],["ἀφορίζοντες",702227,146],["ἑαυτούς",703917,62]],"saying, Righteousness and glory shall come to him: and all that remove them from their borders shall be ashamed."],["25",[["ἀπὸ",701425,0],["κυρίου",707996,18],["δικαιωθήσονται",703696,144],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["θεῷ",706192,114],["ἐνδοξασθήσονται",704693,144],["πᾶν",710177,26],["τὸ",709436,34],["σπέρμα",712008,15],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18]],"By the Lord shall they be justified, and in God shall all the seed of the children of Israel be glorified."]]