[["1",[["παρακαλεῖτε",710039,335],["παρακαλεῖτε",710039,335],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["λέγει",708124,91],["ὁ",709436,3],["θεός",706192,4]],"Comfort ye, comfort ye my people, saith God."],["2",[["ἱερεῖς",706614,52],["λαλήσατε",708071,74],["εἰς",704105,0],["τὴν",709436,8],["καρδίαν",707141,9],["Ιερουσαλημ",706644,9],["παρακαλέσατε",710039,74],["αὐτήν",702165,104],["ὅτι",709803,7],["ἐπλήσθη",710532,37],["ἡ",709436,10],["ταπείνωσις",712719,12],["αὐτῆς",702165,86],["λέλυται",708288,187],["αὐτῆς",702165,86],["ἡ",709436,10],["ἁμαρτία",700775,12],["ὅτι",709803,7],["ἐδέξατο",703393,23],["ἐκ",704132,0],["χειρὸς",713787,17],["κυρίου",707996,18],["διπλᾶ",703740,68],["τὰ",709436,41],["ἁμαρτήματα",700774,42],["αὐτῆς",702165,86]],"Speak, ye priests, to the heart of Jerusalem; comfort her, for her humiliation is accomplished, her sin is put away: for she has received of the Lord's hand double [the amount of] her sins."],["3",[["φωνὴ",713640,12],["βοῶντος",702743,152],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["ἑτοιμάσατε",705539,74],["τὴν",709436,8],["ὁδὸν",709458,9],["κυρίου",707996,18],["εὐθείας",705602,82],["ποιεῖτε",710582,335],["τὰς",709436,38],["τρίβους",712939,39],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145]],"The voice of one crying in the wilderness, Prepare ye the way of the Lord, make straight the paths of our God."],["4",[["πᾶσα",710177,29],["φάραγξ",713351,12],["πληρωθήσεται",710543,134],["καὶ",707031,7],["πᾶν",710177,26],["ὄρος",709768,15],["καὶ",707031,7],["βουνὸς",702797,4],["ταπεινωθήσεται",712717,134],["καὶ",707031,7],["ἔσται",704093,93],["πάντα",710177,195],["τὰ",709436,63],["σκολιὰ",711868,195],["εἰς",704105,0],["εὐθεῖαν",705602,36],["καὶ",707031,7],["ἡ",709436,10],["τραχεῖα",712925,29],["εἰς",704105,0],["πεδία",710215,42]],"Every valley shall be filled, and every mountain and hill shall be brought low: and all the crooked [ways] shall become straight, and the rough [places] plains."],["5",[["καὶ",707031,7],["ὀφθήσεται",709725,134],["ἡ",709436,10],["δόξα",703791,12],["κυρίου",707996,18],["καὶ",707031,7],["ὄψεται",709725,93],["πᾶσα",710177,29],["σὰρξ",711537,12],["τὸ",709436,24],["σωτήριον",712659,25],["τοῦ",709436,35],["θεοῦ",706192,18],["ὅτι",709803,7],["κύριος",707996,4],["ἐλάλησεν",708071,2]],"And the glory of the Lord shall appear, and all flesh shall see the salvation of God: for the Lord has spoken [it]."],["6",[["φωνὴ",713640,12],["λέγοντος",708124,152],["βόησον",702743,176],["καὶ",707031,7],["εἶπα",705373,155],["τί",712867,126],["βοήσω",702743,165],["πᾶσα",710177,29],["σὰρξ",711537,12],["χόρτος",713923,4],["καὶ",707031,7],["πᾶσα",710177,29],["δόξα",703791,12],["ἀνθρώπου",701163,18],["ὡς",714148,28],["ἄνθος",701157,25],["χόρτου",713923,18]],"The voice of one saying, Cry; and I said, What shall I cry? All flesh is grass, and all the glory of man as the flower of grass."],["7",[["ἐξηράνθη",709419,37],["ὁ",709436,3],["χόρτος",713923,4],["καὶ",707031,7],["τὸ",709436,34],["ἄνθος",701157,15],["ἐξέπεσεν",704284,2]],"The grass withers, and the flower fades:"],["8",[["τὸ",709436,34],["δὲ",703303,11],["ῥῆμα",711246,15],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["μένει",708736,91],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"but the word of our God abides for ever."],["9",[["ἐπ᾿",705080,0],["ὄρος",709768,25],["ὑψηλὸν",713285,46],["ἀνάβηθι",700905,176],["ὁ",709436,3],["εὐαγγελιζόμενος",705547,122],["Σιων",711816,9],["ὕψωσον",713289,176],["τῇ",709436,100],["ἰσχύι",706858,1],["τὴν",709436,8],["φωνήν",713640,9],["σου",711945,133],["ὁ",709436,3],["εὐαγγελιζόμενος",705547,122],["Ιερουσαλημ",706644,9],["ὑψώσατε",713289,74],["μὴ",708851,28],["φοβεῖσθε",713532,73],["εἰπὸν",705373,176],["ταῖς",709436,75],["πόλεσιν",710612,76],["Ιουδα",706768,18],["ἰδοὺ",706497,88],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"O thou that bringest glad tidings to Zion, go up on the high mountain; lift up thy voice with strength, thou that bringest glad tidings to Jerusalem; lift it up, fear not; say unto the cities of Juda, Behold your God!"],["10",[["ἰδοὺ",706497,88],["κύριος",707996,4],["μετὰ",708780,0],["ἰσχύος",706858,17],["ἔρχεται",705453,117],["καὶ",707031,7],["ὁ",709436,3],["βραχίων",702808,4],["μετὰ",708780,0],["κυριείας",707994,17],["ἰδοὺ",706497,88],["ὁ",709436,3],["μισθὸς",708939,4],["αὐτοῦ",702165,102],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὸ",709436,34],["ἔργον",705396,15],["ἐναντίον",704654,28],["αὐτοῦ",702165,102]],"Behold the Lord! The Lord is coming with strength, and [his] arm is with power: behold, his reward is with him, and [his] work before him."],["11",[["ὡς",714148,28],["ποιμὴν",710596,4],["ποιμανεῖ",710594,127],["τὸ",709436,24],["ποίμνιον",710598,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["τῷ",709436,113],["βραχίονι",702808,114],["αὐτοῦ",702165,102],["συνάξει",712375,127],["ἄρνας",701731,57],["καὶ",707031,7],["ἐν",704639,0],["γαστρὶ",702976,1],["ἐχούσας",705785,338],["παρακαλέσει",710039,127]],"He shall tend his flock as a shepherd, and he shall gather the lambs with his arm, and shall soothe them that are with young."],["12",[["τίς",712867,158],["ἐμέτρησεν",708840,2],["τῇ",709436,100],["χειρὶ",713787,1],["τὸ",709436,24],["ὕδωρ",713071,25],["καὶ",707031,7],["τὸν",709436,5],["οὐρανὸν",709844,6],["σπιθαμῇ",712013,1],["καὶ",707031,7],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9],["δρακί",703824,1],["τίς",712867,158],["ἔστησεν",706846,2],["τὰ",709436,41],["ὄρη",709768,42],["σταθμῷ",712040,114],["καὶ",707031,7],["τὰς",709436,38],["νάπας",709193,39],["ζυγῷ",705894,114]],"Who has measured the water in his hand, and the heaven with a span, and all the earth in a handful? Who has weighed the mountains in scales, and the forests in a balance?"],["13",[["τίς",712867,158],["ἔγνω",703105,2],["νοῦν",709374,6],["κυρίου",707996,18],["καὶ",707031,7],["τίς",712867,158],["αὐτοῦ",702165,102],["σύμβουλος",712295,4],["ἐγένετο",703104,23],["ὃς",709781,213],["συμβιβᾷ",712280,127],["αὐτόν",702165,85]],"Who has known the mind of the Lord? and who has been his counsellor, to instruct him?"],["14",[["ἢ",705924,7],["πρὸς",710844,0],["τίνα",712867,356],["συνεβουλεύσατο",712292,23],["καὶ",707031,7],["συνεβίβασεν",712280,2],["αὐτόν",702165,85],["ἢ",705924,7],["τίς",712867,158],["ἔδειξεν",703314,2],["αὐτῷ",702165,50],["κρίσιν",707908,9],["ἢ",705924,7],["ὁδὸν",709458,9],["συνέσεως",712460,17],["τίς",712867,158],["ἔδειξεν",703314,2],["αὐτῷ",702165,50]],"Or with whom has he taken counsel, and he has instructed him? or who has taught him judgment, or who has taught him the way of understanding;"],["15",[["εἰ",704071,7],["πάντα",710177,195],["τὰ",709436,63],["ἔθνη",704068,64],["ὡς",714148,28],["σταγὼν",712036,12],["ἀπὸ",701425,0],["κάδου",706978,18],["καὶ",707031,7],["ὡς",714148,28],["ῥοπὴ",711294,12],["ζυγοῦ",705894,18],["ἐλογίσθησαν",708232,99],["καὶ",707031,7],["ὡς",714148,28],["σίελος",711778,4],["λογισθήσονται",708232,144]],"since all the nations are counted as a drop from a bucket, and as the turning of a balance, [and] shall be counted as spittle?"],["16",[["ὁ",709436,3],["δὲ",703303,11],["Λίβανος",708185,4],["οὐχ",709805,28],["ἱκανὸς",706710,14],["εἰς",704105,0],["καῦσιν",707565,9],["καὶ",707031,7],["πάντα",710177,195],["τὰ",709436,63],["τετράποδα",712823,195],["οὐχ",709805,28],["ἱκανὰ",706710,68],["εἰς",704105,0],["ὁλοκάρπωσιν",709587,9]],"And Libanus is not enough to burn, nor all beasts enough for a whole-burnt offering:"],["17",[["καὶ",707031,7],["πάντα",710177,195],["τὰ",709436,63],["ἔθνη",704068,64],["ὡς",714148,28],["οὐδέν",709817,46],["εἰσι",704093,197],["καὶ",707031,7],["εἰς",704105,0],["οὐθὲν",709817,46],["ἐλογίσθησαν",708232,99]],"and all the nations are as nothing, and counted as nothing."],["18",[["τίνι",712867,435],["ὡμοιώσατε",709628,265],["κύριον",707996,6],["καὶ",707031,7],["τίνι",712867,432],["ὁμοιώματι",709629,54],["ὡμοιώσατε",709628,265],["αὐτόν",702165,85]],"To whom have ye compared the Lord? and with what likeness have ye compared him?"],["19",[["μὴ",708851,28],["εἰκόνα",704089,9],["ἐποίησεν",710582,2],["τέκτων",712766,4],["ἢ",705924,7],["χρυσοχόος",713979,4],["χωνεύσας",714010,182],["χρυσίον",713972,25],["περιεχρύσωσεν",710422,2],["αὐτόν",702165,85],["ὁμοίωμα",709629,25],["κατεσκεύασεν",707419,2],["αὐτόν",702165,85]],"Has not the artificer made an image, or the goldsmith having melted gold, gilt it over, [and] made it a similitude?"],["20",[["ξύλον",709427,25],["γὰρ",702963,11],["ἄσηπτον",701933,27],["ἐκλέγεται",704236,117],["τέκτων",712766,4],["καὶ",707031,7],["σοφῶς",711986,28],["ζητεῖ",705879,91],["πῶς",711121,28],["στήσει",706846,127],["αὐτοῦ",702165,102],["εἰκόνα",704089,9],["καὶ",707031,7],["ἵνα",706747,7],["μὴ",708851,28],["σαλεύηται",711403,428]],"For the artificer chooses out a wood that will not rot, and will wisely enquire how he shall set up his image, and [that so] that it should not be moved."],["21",[["οὐ",709805,28],["γνώσεσθε",703105,124],["οὐκ",709805,28],["ἀκούσεσθε",700587,124],["οὐκ",709805,28],["ἀνηγγέλη",700921,37],["ἐξ",704132,0],["ἀρχῆς",701836,17],["ὑμῖν",713084,90],["οὐκ",709805,28],["ἔγνωτε",703105,265],["τὰ",709436,41],["θεμέλια",706181,42],["τῆς",709436,16],["γῆς",703083,17]],"Will ye not know? will ye not hear? has it not been told you of old? Have ye not known the foundations of the earth?"],["22",[["ὁ",709436,3],["κατέχων",707526,72],["τὸν",709436,5],["γῦρον",703210,6],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["οἱ",709436,136],["ἐνοικοῦντες",704772,146],["ἐν",704639,0],["αὐτῇ",702165,105],["ὡς",714148,28],["ἀκρίδες",700599,191],["ὁ",709436,3],["στήσας",706846,182],["ὡς",714148,28],["καμάραν",707108,9],["τὸν",709436,5],["οὐρανὸν",709844,6],["καὶ",707031,7],["διατείνας",703604,182],["ὡς",714148,28],["σκηνὴν",711845,9],["κατοικεῖν",707534,55]],"[It is] he that comprehends the circle of the earth, and the inhabitants in it are as grasshoppers; he that set up the heaven as a chamber, and stretched [it] out as a tent to dwell in:"],["23",[["ὁ",709436,3],["διδοὺς",703654,72],["ἄρχοντας",701862,57],["εἰς",704105,0],["οὐδὲν",709817,46],["ἄρχειν",701860,55],["τὴν",709436,8],["δὲ",703303,11],["γῆν",703083,9],["ὡς",714148,28],["οὐδὲν",709817,46],["ἐποίησεν",710582,2]],"he that appoints princes to rule as nothing, and has made the earth as nothing."],["24",[["οὐ",709805,28],["γὰρ",702963,11],["μὴ",708851,28],["σπείρωσιν",712006,218],["οὐδὲ",709816,7],["μὴ",708851,28],["φυτεύσωσιν",713636,234],["οὐδὲ",709816,7],["μὴ",708851,28],["ῥιζωθῇ",711261,384],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ἡ",709436,10],["ῥίζα",711260,12],["αὐτῶν",702165,40],["ἔπνευσεν",710571,2],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἐξηράνθησαν",709419,99],["καὶ",707031,7],["καταιγὶς",707254,12],["ὡς",714148,28],["φρύγανα",713601,42],["ἀναλήμψεται",700984,93],["αὐτούς",702165,62]],"For they shall not plant, neither shall they sow, neither shall their root be fixed in the ground: he has blown upon them, and they are withered, and a storm shall carry them away like sticks."],["25",[["νῦν",709384,28],["οὖν",709835,11],["τίνι",712867,435],["με",708618,163],["ὡμοιώσατε",709628,265],["καὶ",707031,7],["ὑψωθήσομαι",713289,180],["εἶπεν",705373,2],["ὁ",709436,3],["ἅγιος",700159,14]],"Now then to whom have ye compared me, that I may be exalted? saith the Holy One."],["26",[["ἀναβλέψατε",700913,74],["εἰς",704105,0],["ὕψος",713288,25],["τοὺς",709436,58],["ὀφθαλμοὺς",709870,57],["ὑμῶν",713091,145],["καὶ",707031,7],["ἴδετε",709725,74],["τίς",712867,158],["κατέδειξεν",707235,2],["πάντα",710177,68],["ταῦτα",709858,71],["ὁ",709436,3],["ἐκφέρων",704356,72],["κατὰ",707200,0],["ἀριθμὸν",701744,6],["τὸν",709436,5],["κόσμον",707851,6],["αὐτοῦ",702165,102],["πάντας",710177,60],["ἐπ᾿",705080,0],["ὀνόματι",709666,54],["καλέσει",707084,127],["ἀπὸ",701425,0],["πολλῆς",710646,82],["δόξης",703791,17],["καὶ",707031,7],["ἐν",704639,0],["κράτει",707883,54],["ἰσχύος",706858,17],["οὐδέν",709817,46],["σε",711598,163],["ἔλαθεν",708088,2]],"Lift up your eyes on high, and see, who has displayed all these things? [even] he that brings forth his host by number: he shall call them all by name by [means of his] great glory, and by the power of his might: nothing has escaped thee."],["27",[["μὴ",708851,28],["γὰρ",702963,11],["εἴπῃς",705373,175],["Ιακωβ",706401,153],["καὶ",707031,7],["τί",712867,126],["ἐλάλησας",708071,162],["Ισραηλ",706839,153],["ἀπεκρύβη",701495,37],["ἡ",709436,10],["ὁδός",709458,12],["μου",709032,133],["ἀπὸ",701425,0],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["τὴν",709436,8],["κρίσιν",707908,9],["ἀφεῖλεν",702177,2],["καὶ",707031,7],["ἀπέστη",702214,2]],"For say not thou, O Jacob, and why hast thou spoken, Israel, [saying], My way is hid from God, and my God has taken away [my] judgment, and has departed?"],["28",[["καὶ",707031,7],["νῦν",709384,28],["οὐκ",709805,28],["ἔγνως",703105,162],["εἰ",704071,7],["μὴ",708851,28],["ἤκουσας",700587,162],["θεὸς",706192,4],["αἰώνιος",700505,14],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["κατασκευάσας",707419,182],["τὰ",709436,41],["ἄκρα",700608,68],["τῆς",709436,16],["γῆς",703083,17],["οὐ",709805,28],["πεινάσει",710222,127],["οὐδὲ",709816,7],["κοπιάσει",707824,127],["οὐδὲ",709816,7],["ἔστιν",704093,91],["ἐξεύρεσις",704915,12],["τῆς",709436,16],["φρονήσεως",713588,17],["αὐτοῦ",702165,102]],"And now, hast thou not known? hast thou not heard? the eternal God, the God that formed the ends of the earth, shall not hunger, nor be weary, and there is no searching of his understanding."],["29",[["διδοὺς",703654,72],["τοῖς",709436,147],["πεινῶσιν",710222,197],["ἰσχὺν",706858,9],["καὶ",707031,7],["τοῖς",709436,147],["μὴ",708851,28],["ὀδυνωμένοις",709462,341],["λύπην",708273,9]],"He gives strength to the hungry, and sorrow to them that are not suffering."],["30",[["πεινάσουσιν",710222,218],["γὰρ",702963,11],["νεώτεροι",709256,267],["καὶ",707031,7],["κοπιάσουσιν",707824,218],["νεανίσκοι",709232,52],["καὶ",707031,7],["ἐκλεκτοὶ",704240,138],["ἀνίσχυες",701174,363],["ἔσονται",704093,135]],"For the young [men] shall hunger, and the youths shall be weary, and the choice [men] shall be powerless:"],["31",[["οἱ",709436,136],["δὲ",703303,11],["ὑπομένοντες",713219,146],["τὸν",709436,5],["θεὸν",706192,6],["ἀλλάξουσιν",700683,218],["ἰσχύν",706858,9],["πτεροφυήσουσιν",711055,218],["ὡς",714148,28],["ἀετοί",700318,52],["δραμοῦνται",712931,135],["καὶ",707031,7],["οὐ",709805,28],["κοπιάσουσιν",707824,218],["βαδιοῦνται",702367,135],["καὶ",707031,7],["οὐ",709805,28],["πεινάσουσιν",710222,218]],"but they that wait on God shall renew [their] strength; they shall put forth new feathers like eagles; they shall run, and not be weary; they shall walk, and not hunger."]]