[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["τοῦ",709436,35],["ἐνιαυτοῦ",704745,18],["οὗ",709781,48],["ἀπέθανεν",701461,2],["Οζιας",709474,4],["ὁ",709436,3],["βασιλεύς",702580,4],["εἶδον",709725,155],["τὸν",709436,5],["κύριον",707996,6],["καθήμενον",707000,212],["ἐπὶ",705080,0],["θρόνου",706315,18],["ὑψηλοῦ",713285,116],["καὶ",707031,7],["ἐπηρμένου",705002,292],["καὶ",707031,7],["πλήρης",710541,14],["ὁ",709436,3],["οἶκος",709516,4],["τῆς",709436,16],["δόξης",703791,17],["αὐτοῦ",702165,102]],"And it came to pass in the year in which king Ozias died, [that] I saw the Lord sitting on a high and exalted throne, and the house was full of his glory."],["2",[["καὶ",707031,7],["σεραφιν",711702,313],["εἱστήκεισαν",706846,263],["κύκλῳ",707959,114],["αὐτοῦ",702165,102],["ἓξ",704828,59],["πτέρυγες",711057,191],["τῷ",709436,113],["ἑνὶ",704106,30],["καὶ",707031,7],["ἓξ",704828,59],["πτέρυγες",711057,191],["τῷ",709436,113],["ἑνί",704106,30],["καὶ",707031,7],["ταῖς",709436,75],["μὲν",708730,11],["δυσὶν",703849,442],["κατεκάλυπτον",707260,137],["τὸ",709436,24],["πρόσωπον",710986,25],["καὶ",707031,7],["ταῖς",709436,75],["δυσὶν",703849,442],["κατεκάλυπτον",707260,137],["τοὺς",709436,58],["πόδας",710707,57],["καὶ",707031,7],["ταῖς",709436,75],["δυσὶν",703849,442],["ἐπέταντο",710441,137]],"And seraphs stood round about him: each one had six wings: and with two they covered [their] face, and with two they covered [their] feet, and with two they flew."],["3",[["καὶ",707031,7],["ἐκέκραγον",707868,137],["ἕτερος",705535,14],["πρὸς",710844,0],["τὸν",709436,5],["ἕτερον",705535,27],["καὶ",707031,7],["ἔλεγον",708124,137],["ἅγιος",700159,14],["ἅγιος",700159,14],["ἅγιος",700159,14],["κύριος",707996,4],["σαβαωθ",711346,228],["πλήρης",710541,14],["πᾶσα",710177,29],["ἡ",709436,10],["γῆ",703083,12],["τῆς",709436,16],["δόξης",703791,17],["αὐτοῦ",702165,102]],"And one cried to the other, and they said, Holy, holy, holy, [is the] Lord of hosts: the whole earth is full of his glory."],["4",[["καὶ",707031,7],["ἐπήρθη",705002,37],["τὸ",709436,24],["ὑπέρθυρον",713142,25],["ἀπὸ",701425,0],["τῆς",709436,16],["φωνῆς",713640,17],["ἧς",709781,167],["ἐκέκραγον",704226,137],["καὶ",707031,7],["ὁ",709436,3],["οἶκος",709516,4],["ἐπλήσθη",710532,37],["καπνοῦ",707132,18]],"And the lintel shook at the voice they uttered, and the house was filled with smoke."],["5",[["καὶ",707031,7],["εἶπα",705373,155],["ὦ",714081,88],["τάλας",712698,14],["ἐγώ",704018,164],["ὅτι",709803,7],["κατανένυγμαι",707347,326],["ὅτι",709803,7],["ἄνθρωπος",701163,4],["ὢν",704093,72],["καὶ",707031,7],["ἀκάθαρτα",700508,68],["χείλη",713781,42],["ἔχων",705785,72],["ἐν",704639,0],["μέσῳ",708768,97],["λαοῦ",708094,18],["ἀκάθαρτα",700508,68],["χείλη",713781,42],["ἔχοντος",705785,152],["ἐγὼ",704018,164],["οἰκῶ",709499,157],["καὶ",707031,7],["τὸν",709436,5],["βασιλέα",702580,6],["κύριον",707996,6],["σαβαωθ",711346,228],["εἶδον",709725,155],["τοῖς",709436,147],["ὀφθαλμοῖς",709870,148],["μου",709032,133]],"And I said, Woe is me, for I am pricked to the heart; for being a man, and having unclean lips, I dwell in the midst of a people having unclean lips; and I have seen with mine eyes the King, the Lord of hosts."],["6",[["καὶ",707031,7],["ἀπεστάλη",701592,37],["πρός",710844,0],["με",708618,163],["ἓν",704106,46],["τῶν",709436,80],["σεραφιν",711702,81],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["χειρὶ",713787,1],["εἶχεν",705785,13],["ἄνθρακα",701160,25],["ὃν",709781,112],["τῇ",709436,100],["λαβίδι",708046,1],["ἔλαβεν",708076,2],["ἀπὸ",701425,0],["τοῦ",709436,35],["θυσιαστηρίου",706348,21]],"And there was sent to me one of the seraphs, and he had in his hand a coal, which he had taken off the altar with the tongs:"],["7",[["καὶ",707031,7],["ἥψατο",701654,23],["τοῦ",709436,35],["στόματός",712125,21],["μου",709032,133],["καὶ",707031,7],["εἶπεν",705373,2],["ἰδοὺ",706497,88],["ἥψατο",701654,23],["τοῦτο",709858,129],["τῶν",709436,43],["χειλέων",713781,44],["σου",711945,133],["καὶ",707031,7],["ἀφελεῖ",702177,127],["τ