[["1",[["ἰδοὺ",706497,88],["γὰρ",702963,11],["βασιλεὺς",702580,4],["δίκαιος",703694,14],["βασιλεύσει",702581,127],["καὶ",707031,7],["ἄρχοντες",701862,52],["μετὰ",708780,0],["κρίσεως",707908,17],["ἄρξουσιν",701860,218]],"For, behold, a righteous king shall reign, and princes shall govern with judgment."],["2",[["καὶ",707031,7],["ἔσται",704093,93],["ὁ",709436,3],["ἄνθρωπος",701163,4],["κρύπτων",707923,72],["τοὺς",709436,58],["λόγους",708236,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["κρυβήσεται",707923,134],["ὡς",714148,28],["ἀφ᾿",701425,0],["ὕδατος",713071,21],["φερομένου",713428,262],["καὶ",707031,7],["φανήσεται",713311,134],["ἐν",704639,0],["Σιων",711816,1],["ὡς",714148,28],["ποταμὸς",710693,4],["φερόμενος",713428,122],["ἔνδοξος",704694,14],["ἐν",704639,0],["γῇ",703083,1],["διψώσῃ",703763,220]],"And a man shall hide his words, and be hidden, as from rushing water, and shall appear in Sion as a rushing river, glorious in a thirsty land."],["3",[["καὶ",707031,7],["οὐκέτι",709827,28],["ἔσονται",704093,135],["πεποιθότες",710221,268],["ἐπ᾿",705080,0],["ἀνθρώποις",701163,148],["ἀλλὰ",700680,7],["τὰ",709436,41],["ὦτα",709852,25],["δώσουσιν",703654,218],["ἀκούειν",700587,55]],"And they shall no more trust in men, but they shall incline their ears to hear."],["4",[["καὶ",707031,7],["ἡ",709436,10],["καρδία",707141,12],["τῶν",709436,80],["ἀσθενούντων",701938,170],["προσέξει",710895,127],["τοῦ",709436,35],["ἀκούειν",700587,55],["καὶ",707031,7],["αἱ",709436,190],["γλῶσσαι",703120,191],["αἱ",709436,190],["ψελλίζουσαι",714035,306],["ταχὺ",712748,661],["μαθήσονται",708480,135],["λαλεῖν",708071,55],["εἰρήνην",704098,9]],"And the heart of the weak ones shall attend to hear, and the stammering tongues shall soon learn to speak peace."],["5",[["καὶ",707031,7],["οὐκέτι",709827,28],["μὴ",708851,28],["εἴπωσιν",705373,234],["τῷ",709436,113],["μωρῷ",709110,30],["ἄρχειν",701860,55],["καὶ",707031,7],["οὐκέτι",709827,28],["μὴ",708851,28],["εἴπωσιν",705373,234],["οἱ",709436,136],["ὑπηρέται",713179,52],["σου",711945,133],["σίγα",711767,240]],"And they shall no more at all tell a fool to rule, and thy servants shall no more at all say, Be silent."],["6",[["ὁ",709436,3],["γὰρ",702963,11],["μωρὸς",709110,14],["μωρὰ",709110,68],["λαλήσει",708071,127],["καὶ",707031,7],["ἡ",709436,10],["καρδία",707141,12],["αὐτοῦ",702165,102],["μάταια",708575,68],["νοήσει",709327,127],["τοῦ",709436,20],["συντελεῖν",712510,55],["ἄνομα",701194,68],["καὶ",707031,7],["λαλεῖν",708071,55],["πρὸς",710844,0],["κύριον",707996,6],["πλάνησιν",710497,9],["τοῦ",709436,20],["διασπεῖραι",703584,106],["ψυχὰς",714070,39],["πεινώσας",710222,338],["καὶ",707031,7],["τὰς",709436,38],["ψυχὰς",714070,39],["τὰς",709436,38],["διψώσας",703763,338],["κενὰς",707612,119],["ποιῆσαι",710582,106]],"For the fool shall speak foolish words, and his heart shall meditate vanities, and to perform lawless deeds and to speak error against the Lord, to scatter hungry souls, and he will cause the thirsty souls to be empty."],["7",[["ἡ",709436,10],["γὰρ",702963,11],["βουλὴ",702792,12],["τῶν",709436,80],["πονηρῶν",710660,169],["ἄνομα",701194,68],["βουλεύσεται",702791,93],["καταφθεῖραι",707474,106],["ταπεινοὺς",712714,60],["ἐν",704639,0],["λόγοις",708236,148],["ἀδίκοις",700272,230],["καὶ",707031,7],["διασκεδάσαι",703575,106],["λόγους",708236,57],["ταπεινῶν",712714,169],["ἐν",704639,0],["κρίσει",707908,1]],"For the counsel of the wicked will devise iniquity, to destroy the poor with unjust words, and ruin the cause of the poor in judgment."],["8",[["οἱ",709436,136],["δὲ",703303,11],["εὐσεβεῖς",705687,138],["συνετὰ",712464,68],["ἐβουλεύσαντο",702791,189],["καὶ",707031,7],["αὕτη",709858,107],["ἡ",709436,10],["βουλὴ",702792,12],["μενεῖ",708736,127]],"But the godly have devised wise [measures], and this counsel shall stand."],["9",[["γυναῖκες",703209,191],["πλούσιαι",710560,192],["ἀνάστητε",701173,74],["καὶ",707031,7],["ἀκούσατε",700587,74],["τῆς",709436,16],["φωνῆς",713640,17],["μου",709032,133],["θυγατέρες",706320,191],["ἐν",704639,0],["ἐλπίδι",704530,1],["ἀκούσατε",700587,74],["τοὺς",709436,58],["λόγους",708236,57],["μου",709032,133]],"Rise up, ye rich women, and hear my voice; ye confident daughters, hearken to my words."],["10",[["ἡμέρας",705984,17],["ἐνιαυτοῦ",704745,18],["μνείαν",708961,9],["ποιήσασθε",710582,186],["ἐν",704639,0],["ὀδύνῃ",709463,1],["μετ᾿",708780,0],["ἐλπίδος",704530,17],["ἀνήλωται",700992,403],["ὁ",709436,3],["τρύγητος",712998,4],["πέπαυται",710202,187],["ὁ",709436,3],["σπόρος",712030,4],["καὶ",707031,7],["οὐκέτι",709827,28],["μὴ",708851,28],["ἔλθῃ",705453,172]],"Remember for a full year in pain, yet with hope: the vintage has been cut off, it has ceased, it shall by no means come again."],["11",[["ἔκστητε",704940,74],["λυπήθητε",708272,372],["αἱ",709436,190],["πεποιθυῖαι",710221,570],["ἐκδύσασθε",704180,186],["γυμναὶ",703202,192],["γένεσθε",703104,186],["περιζώσασθε",710317,186],["σάκκους",711386,57],["τὰς",709436,38],["ὀσφύας",709800,39]],"Be amazed, be pained, ye confident ones: strip you, bare yourselves, gird your loins;"],["12",[["καὶ",707031,7],["ἐπὶ",705080,0],["τῶν",709436,80],["μαστῶν",708569,81],["κόπτεσθε",707829,73],["ἀπὸ",701425,0],["ἀγροῦ",700196,18],["ἐπιθυμήματος",705142,21],["καὶ",707031,7],["ἀμπέλου",700870,17],["γενήματος",703052,21]],"and beat on your breasts, because of the pleasant field, and the fruit of the vine."],["13",[["ἡ",709436,10],["γῆ",703083,12],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133],["ἄκανθα",700517,12],["καὶ",707031,7],["χόρτος",713923,4],["ἀναβήσεται",700905,93],["καὶ",707031,7],["ἐκ",704132,0],["πάσης",710177,82],["οἰκίας",709505,17],["εὐφροσύνη",705717,12],["ἀρθήσεται",700473,134],["πόλις",710612,12],["πλουσία",710560,29]],"[As for] the land of my people, the thorn and grass shall come upon [it], and joy shall be removed from every house."],["14",[["οἶκοι",709516,52],["ἐγκαταλελειμμένοι",703967,429],["πλοῦτον",710563,6],["πόλεως",710612,17],["καὶ",707031,7],["οἴκους",709516,57],["ἐπιθυμητοὺς",705146,60],["ἀφήσουσιν",702211,218],["καὶ",707031,7],["ἔσονται",704093,135],["αἱ",709436,190],["κῶμαι",708022,191],["σπήλαια",712012,42],["ἕως",705792,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["εὐφροσύνη",705717,12],["ὄνων",709671,81],["ἀγρίων",700191,169],["βοσκήματα",702766,64],["ποιμένων",710596,81]],"[As for] the rich city, the houses are deserted; they shall abandon the wealth of the city, [and] the pleasant houses: and the villages shall be caves for ever, the joy of wild asses, shepherds' pastures;"],["15",[["ἕως",705792,0],["ἂν",700900,11],["ἐπέλθῃ",705068,172],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["πνεῦμα",710566,15],["ἀφ᾿",701425,0],["ὑψηλοῦ",713285,116],["καὶ",707031,7],["ἔσται",704093,93],["ἔρημος",705420,12],["ὁ",709436,3],["Χερμελ",713829,4],["καὶ",707031,7],["ὁ",709436,3],["Χερμελ",713829,4],["εἰς",704105,0],["δρυμὸν",703836,6],["λογισθήσεται",708232,134]],"until the Spirit shall come upon you from on high, and Chermel shall be desert, and Chermel shall be counted for a forest."],["16",[["καὶ",707031,7],["ἀναπαύσεται",701027,93],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["κρίμα",707903,15],["καὶ",707031,7],["δικαιοσύνη",703695,12],["ἐν",704639,0],["τῷ",709436,113],["Καρμήλῳ",707161,114],["κατοικήσει",707534,127]],"Then judgment shall abide in the wilderness, and righteousness shall dwell in Carmel."],["17",[["καὶ",707031,7],["ἔσται",704093,93],["τὰ",709436,63],["ἔργα",705396,64],["τῆς",709436,16],["δικαιοσύνης",703695,17],["εἰρήνη",704098,12],["καὶ",707031,7],["κρατήσει",707879,127],["ἡ",709436,10],["δικαιοσύνη",703695,12],["ἀνάπαυσιν",701026,9],["καὶ",707031,7],["πεποιθότες",710221,268],["ἕως",705792,0],["τοῦ",709436,35],["αἰῶνος",700504,18]],"And the works of righteousness shall be peace; and righteousness shall ensure rest, and [the righteous] shall be confident for ever."],["18",[["καὶ",707031,7],["κατοικήσει",707534,127],["ὁ",709436,3],["λαὸς",708094,4],["αὐτοῦ",702165,102],["ἐν",704639,0],["πόλει",710612,1],["εἰρήνης",704098,17],["καὶ",707031,7],["ἐνοικήσει",704772,127],["πεποιθώς",710221,270],["καὶ",707031,7],["ἀναπαύσονται",701027,135],["μετὰ",708780,0],["πλούτου",710563,18]],"And his people shall inhabit a city of peace, and dwell in [it] in confidence, and they shall rest with wealth."],["19",[["ἡ",709436,10],["δὲ",703303,11],["χάλαζα",713667,12],["ἐὰν",703912,7],["καταβῇ",707202,172],["οὐκ",709805,28],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["ἥξει",705956,127],["καὶ",707031,7],["ἔσονται",704093,135],["οἱ",709436,136],["ἐνοικοῦντες",704772,146],["ἐν",704639,0],["τοῖς",709436,147],["δρυμοῖς",703836,148],["πεποιθότες",710221,268],["ὡς",714148,28],["οἱ",709436,136],["ἐν",704639,0],["τῇ",709436,100],["πεδινῇ",710214,101]],"And if the hail should come down, it shall not come upon you; and they that dwell in the forests shall be in confidence, as those in the plain country."],["20",[["μακάριοι",708397,138],["οἱ",709436,136],["σπείροντες",712006,146],["ἐπὶ",705080,0],["πᾶν",710177,26],["ὕδωρ",713071,15],["οὗ",709781,28],["βοῦς",702798,4],["καὶ",707031,7],["ὄνος",709671,4],["πατεῖ",710187,91]],"Blessed are they that sow by every water, where the ox and ass tread."]]