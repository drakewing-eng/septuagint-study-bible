[["1",[["ἀποστελῶ",701592,165],["ὡς",714148,11],["ἑρπετὰ",705441,42],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["μὴ",708851,28],["πέτρα",710443,12],["ἔρημός",705420,12],["ἐστιν",704093,91],["τὸ",709436,34],["ὄρος",709768,15],["Σιων",711816,17]],"I will send as it were reptiles on the land: is [not] the mount of the daughter of Sion a desolate rock?"],["2",[["ἔσῃ",704093,123],["γὰρ",702963,11],["ὡς",714148,11],["πετεινοῦ",710439,21],["ἀνιπταμένου",701172,478],["νεοσσὸς",709257,4],["ἀφῃρημένος",702177,419],["θύγατερ",706320,258],["Μωαβ",709085,118],["ἔπειτα",705061,28],["δέ",703303,11],["Αρνων",701783,766]],"For thou shalt be as a young bird taken away from a bird that has flown: [even] thou shalt be [so], daughter of Moab: and then do thou, O Arnon,"],["3",[["πλείονα",710514,27],["βουλεύου",702791,253],["ποιεῖτε",710582,335],["σκέπην",711839,9],["πένθους",710253,21],["αὐτῇ",702165,105],["διὰ",703417,0],["παντός",710177,116],["ἐν",704639,0],["μεσημβρινῇ",708759,101],["σκοτίᾳ",711886,1],["φεύγουσιν",713433,197],["ἐξέστησαν",704940,150],["μὴ",708851,28],["ἀπαχθῇς",701324,279]],"take farther counsel, and continually make thou a shelter from grief: they flee in darkness at mid-day; they are amazed; be not thou led captive."],["4",[["παροικήσουσίν",710156,218],["σοι",711925,159],["οἱ",709436,136],["φυγάδες",713608,52],["Μωαβ",709085,118],["ἔσονται",704093,135],["σκέπη",711839,12],["ὑμῖν",713084,90],["ἀπὸ",701425,0],["προσώπου",710986,21],["διώκοντος",703768,152],["ὅτι",709803,7],["ἤρθη",700473,37],["ἡ",709436,10],["συμμαχία",712299,12],["σου",711945,133],["καὶ",707031,7],["ὁ",709436,3],["ἄρχων",701862,4],["ἀπώλετο",701513,23],["ὁ",709436,3],["καταπατῶν",707360,72],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"The fugitives of Moab shall sojourn with thee; they shall be to you a shelter from the face of the pursuer: for thine alliance has been taken away, and the oppressing ruler has perished from off the earth."],["5",[["καὶ",707031,7],["διορθωθήσεται",703728,134],["μετ᾿",708780,0],["ἐλέους",704426,42],["θρόνος",706315,4],["καὶ",707031,7],["καθίεται",707006,93],["ἐπ᾿",705080,0],["αὐτοῦ",702165,102],["μετὰ",708780,0],["ἀληθείας",700656,17],["ἐν",704639,0],["σκηνῇ",711845,1],["Δαυιδ",703232,18],["κρίνων",707905,72],["καὶ",707031,7],["ἐκζητῶν",704187,72],["κρίμα",707903,25],["καὶ",707031,7],["σπεύδων",712011,72],["δικαιοσύνην",703695,9]],"And a throne shall be established with mercy; and one shall sit upon it with truth in the tabernacle of David, judging, and earnestly seeking judgments, and hasting righteousness."],["6",[["ἠκούσαμεν",700587,289],["τὴν",709436,8],["ὕβριν",713051,9],["Μωαβ",709085,118],["ὑβριστὴς",713052,18],["σφόδρα",712586,28],["τὴν",709436,8],["ὑπερηφανίαν",713138,9],["ἐξῆρας",709421,119],["οὐχ",709805,28],["οὕτως",709859,28],["ἡ",709436,10],["μαντεία",708488,12],["σου",711945,133]],"We have heard of the pride of Moab; he is very proud. I have cut off his pride: thy prophecy shall not be thus, [no] not thus."],["7",[["οὐχ",709805,28],["οὕτως",709859,28],["ὀλολύξει",709593,127],["Μωαβ",709085,120],["ἐν",704639,0],["γὰρ",702963,11],["τῇ",709436,100],["Μωαβίτιδι",709089,1],["πάντες",710177,138],["ὀλολύξουσιν",709593,218],["τοῖς",709436,147],["κατοικοῦσιν",707534,349],["Δεσεθ",703367,227],["μελετήσεις",708698,166],["καὶ",707031,7],["οὐκ",709805,28],["ἐντραπήσῃ",704805,168]],"Moab shall howl; for all shall howl in the land of Moab: but thou shalt care for them that dwell in Seth, and thou shalt not be ashamed."],["8",[["τὰ",709436,63],["πεδία",710215,64],["Εσεβων",705473,120],["πενθήσει",710251,127],["ἄμπελος",700870,12],["Σεβαμα",711600,118],["καταπίνοντες",707374,146],["τὰ",709436,41],["ἔθνη",704068,42],["καταπατήσατε",707360,74],["τὰς",709436,38],["ἀμπέλους",700870,39],["αὐτῆς",702165,86],["ἕως",705792,28],["Ιαζηρ",706382,118],["οὐ",709805,28],["μὴ",708851,28],["συνάψητε",712404,125],["πλανήθητε",710495,394],["τὴν",709436,8],["ἔρημον",705420,9],["οἱ",709436,136],["ἀπεσταλμένοι",701592,429],["ἐγκατελείφθησαν",703967,99],["διέβησαν",703419,150],["γὰρ",702963,11],["τὴν",709436,8],["ἔρημον",705420,9]],"The plains of Esebon shall mourn, the vine of Sebama: swallowing up the nations, trample ye her vines, even to Jazer: ye shall not come together; wander ye in the desert: they that were sent are deserted, for they have gone over to the sea."],["9",[["διὰ",703417,0],["τοῦτο",709858,129],["κλαύσομαι",707703,181],["ὡς",714148,28],["τὸν",709436,5],["κλαυθμὸν",707705,6],["Ιαζηρ",706382,118],["ἄμπελον",700870,9],["Σεβαμα",711600,118],["τὰ",709436,41],["δένδρα",703353,42],["σου",711945,133],["κατέβαλεν",707203,2],["Εσεβων",705473,118],["καὶ",707031,7],["Ελεαλη",704409,118],["ὅτι",709803,7],["ἐπὶ",705080,0],["τῷ",709436,113],["θερισμῷ",706208,114],["καὶ",707031,7],["ἐπὶ",705080,0],["τῷ",709436,113],["τρυγήτῳ",712998,114],["σου",711945,133],["καταπατήσω",707360,165],["καὶ",707031,7],["πάντα",710177,68],["πεσοῦνται",710481,93]],"Therefore will I weep as with the weeping of Jazer for the vine of Sebama; Esebon and Eleale have cast down thy trees; for I will trample on thy harvest and on thy vintages, and all [thy plants] shall fall."],["10",[["καὶ",707031,7],["ἀρθήσεται",700473,134],["εὐφροσύνη",705717,12],["καὶ",707031,7],["ἀγαλλίαμα",700112,15],["ἐκ",704132,0],["τῶν",709436,80],["ἀμπελώνων",700872,81],["σου",711945,133],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["ἀμπελῶσίν",700872,148],["σου",711945,133],["οὐ",709805,28],["μὴ",708851,28],["εὐφρανθήσονται",705715,144],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["πατήσουσιν",710187,218],["οἶνον",709530,6],["εἰς",704105,0],["τὰ",709436,41],["ὑπολήνια",713214,42],["πέπαυται",710202,187],["γάρ",702963,11]],"And gladness and rejoicing shall be taken away from the vineyards; and they shall not rejoice at all in thy vineyards; and they shall not at all tread wine into the vats; for [the vintage] has ceased."],["11",[["διὰ",703417,0],["τοῦτο",709858,129],["ἡ",709436,10],["κοιλία",707761,12],["μου",709032,133],["ἐπὶ",705080,0],["Μωαβ",709085,118],["ὡς",714148,28],["κιθάρα",707669,12],["ἠχήσει",706045,127],["καὶ",707031,7],["τὰ",709436,63],["ἐντός",704804,28],["μου",709032,133],["ὡσεὶ",714159,28],["τεῖχος",712759,25],["ὃ",709781,213],["ἐνεκαίνισας",703956,162]],"Therefore my belly shall sound as a harp for Moab, and thou hast repaired my inward parts as a wall."],["12",[["καὶ",707031,7],["ἔσται",704093,93],["εἰς",704105,0],["τὸ",709436,24],["ἐντραπῆναί",704805,179],["σε",711598,163],["ὅτι",709803,7],["ἐκοπίασεν",707824,2],["Μωαβ",709085,120],["ἐπὶ",705080,0],["τοῖς",709436,147],["βωμοῖς",702840,148],["καὶ",707031,7],["εἰσελεύσεται",704114,93],["εἰς",704105,0],["τὰ",709436,41],["χειροποίητα",713796,68],["αὐτῆς",702165,86],["ὥστε",714164,7],["προσεύξασθαι",710893,109],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["δύνηται",703838,428],["ἐξελέσθαι",704838,109],["αὐτόν",702165,85]],"And it shall be to thy shame, (for Moab is wearied at the altars,) that he shall go in to the idols thereof to pray, but they shall not be at all able to deliver him."],["13",[["τοῦτο",709858,132],["τὸ",709436,34],["ῥῆμα",711246,15],["ὃ",709781,213],["ἐλάλησεν",708071,2],["κύριος",707996,4],["ἐπὶ",705080,0],["Μωαβ",709085,227],["ὁπότε",709709,28],["καὶ",707031,28],["ἐλάλησεν",708071,2]],"This is the word which the Lord spoke against Moab, when he spoke."],["14",[["καὶ",707031,7],["νῦν",709384,28],["λέγω",708124,157],["ἐν",704639,0],["τρισὶν",712927,94],["ἔτεσιν",705543,96],["ἐτῶν",705543,44],["μισθωτοῦ",708942,116],["ἀτιμασθήσεται",702092,134],["ἡ",709436,10],["δόξα",703791,12],["Μωαβ",709085,118],["ἐν",704639,0],["παντὶ",710177,30],["τῷ",709436,113],["πλούτῳ",710563,114],["τῷ",709436,113],["πολλῷ",710646,30],["καὶ",707031,7],["καταλειφθήσεται",707305,134],["ὀλιγοστὸς",709569,140],["καὶ",707031,7],["οὐκ",709805,28],["ἔντιμος",704798,14]],"And now I say, In three years, of the years of an hireling, the glory of Moab shall be dishonoured [with] all his great wealth; and he shall be left few in number, and not honoured."]]