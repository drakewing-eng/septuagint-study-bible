[["1",[["οὕτως",709859,28],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["οὐρανός",709844,4],["μοι",708974,159],["θρόνος",706315,4],["ἡ",709436,10],["δὲ",703303,11],["γῆ",703083,12],["ὑποπόδιον",713233,15],["τῶν",709436,80],["ποδῶν",710707,81],["μου",709032,133],["ποῖον",710599,27],["οἶκον",709516,6],["οἰκοδομήσετέ",709509,337],["μοι",708974,159],["ἢ",705924,7],["ποῖος",710599,14],["τόπος",712903,4],["τῆς",709436,16],["καταπαύσεώς",707364,17],["μου",709032,133]],"Thus saith the Lord, Heaven is my throne, and the earth is my footstool: what kind of a house will ye build me? and of what kind [is to be] the place of my rest?"],["2",[["πάντα",710177,68],["γὰρ",702963,11],["ταῦτα",709858,71],["ἐποίησεν",710582,2],["ἡ",709436,10],["χείρ",713787,12],["μου",709032,133],["καὶ",707031,7],["ἔστιν",704093,91],["ἐμὰ",704578,68],["πάντα",710177,195],["ταῦτα",709858,290],["λέγει",708124,91],["κύριος",707996,4],["καὶ",707031,7],["ἐπὶ",705080,0],["τίνα",712867,356],["ἐπιβλέψω",705088,165],["ἀλλ᾿",700680,7],["ἢ",705924,7],["ἐπὶ",705080,0],["τὸν",709436,5],["ταπεινὸν",712714,27],["καὶ",707031,7],["ἡσύχιον",706036,27],["καὶ",707031,7],["τρέμοντα",712928,183],["τοὺς",709436,58],["λόγους",708236,57],["μου",709032,133]],"For all these things are mine, saith the Lord: and to whom will I have respect, but to the humble and meek, and the [man] that trembles [at] my words?"],["3",[["ὁ",709436,3],["δὲ",703303,11],["ἄνομος",701194,14],["ὁ",709436,3],["θύων",706349,72],["μοι",708974,159],["μόσχον",709029,6],["ὡς",714148,28],["ὁ",709436,3],["ἀποκτέννων",701498,72],["κύνα",708004,6],["ὁ",709436,3],["δὲ",703303,11],["ἀναφέρων",701083,72],["σεμίδαλιν",711675,9],["ὡς",714148,28],["αἷμα",700442,25],["ὕειον",713072,25],["ὁ",709436,3],["διδοὺς",703654,72],["λίβανον",708186,6],["εἰς",704105,0],["μνημόσυνον",708966,25],["ὡς",714148,28],["βλάσφημος",702739,14],["καὶ",707031,7],["οὗτοι",709858,201],["ἐξελέξαντο",704236,189],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,41],["βδελύγματα",702604,42],["αὐτῶν",702165,40],["ἃ",709781,69],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτῶν",702165,40],["ἠθέλησεν",706176,2]],"But the transgressor that sacrifices a calf to me, is as he that kills a dog; and he that offers fine flour, as [one that offers] swine's blood; he that gives frankincense for a memorial, is as a blasphemer. Yet they have chosen their own ways, and their soul has delighted in their abominations."],["4",[["κἀγὼ",706969,288],["ἐκλέξομαι",704236,181],["τὰ",709436,41],["ἐμπαίγματα",704581,42],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰς",709436,38],["ἁμαρτίας",700775,39],["ἀνταποδώσω",701215,165],["αὐτοῖς",702165,151],["ὅτι",709803,7],["ἐκάλεσα",707084,155],["αὐτοὺς",702165,62],["καὶ",707031,7],["οὐχ",709805,28],["ὑπήκουσάν",713096,150],["μου",709032,133],["ἐλάλησα",708071,155],["καὶ",707031,7],["οὐκ",709805,28],["ἤκουσαν",700587,150],["καὶ",707031,7],["ἐποίησαν",710582,150],["τὸ",709436,24],["πονηρὸν",710660,46],["ἐναντίον",704654,28],["μου",709032,133],["καὶ",707031,7],["ἃ",709781,69],["οὐκ",709805,28],["ἐβουλόμην",702795,334],["ἐξελέξαντο",704236,189]],"I also will choose their mockeries, and will recompense their sins upon them; because I called them, and they did not hearken to me; I spoke, and they heard not: and they did evil before me, and chose the things wherein I delighted not."],["5",[["ἀκούσατε",700587,74],["τὸ",709436,24],["ῥῆμα",711246,25],["κυρίου",707996,18],["οἱ",709436,136],["τρέμοντες",712928,146],["τὸν",709436,5],["λόγον",708236,6],["αὐτοῦ",702165,102],["εἴπατε",705373,74],["ἀδελφοὶ",700249,52],["ἡμῶν",705999,145],["τοῖς",709436,147],["μισοῦσιν",708935,197],["ἡμᾶς",705981,194],["καὶ",707031,7],["βδελυσσομένοις",702608,341],["ἵνα",706747,7],["τὸ",709436,34],["ὄνομα",709666,15],["κυρίου",707996,18],["δοξασθῇ",703792,384],["καὶ",707031,7],["ὀφθῇ",709725,384],["ἐν",704639,0],["τῇ",709436,100],["εὐφροσύνῃ",705717,1],["αὐτῶν",702165,40],["κἀκεῖνοι",707052,762],["αἰσχυνθήσονται",700485,144]],"Hear the words of the Lord, ye that tremble at his word; speak ye, our brethren, to them that hate you and abominate you, that the name of the Lord may be glorified, and may appear their joy; but they shall be ashamed."],["6",[["φωνὴ",713640,12],["κραυγῆς",707886,17],["ἐκ",704132,0],["πόλεως",710612,17],["φωνὴ",713640,12],["ἐκ",704132,0],["ναοῦ",709191,18],["φωνὴ",713640,12],["κυρίου",707996,18],["ἀνταποδιδόντος",701215,152],["ἀνταπόδοσιν",701217,9],["τοῖς",709436,147],["ἀντικειμένοις",701240,341]],"A voice of a cry from the city, a voice from the temple, a voice of the Lord rendering recompence to [his] adversaries."],["7",[["πρὶν",710742,28],["ἢ",705924,7],["τὴν",709436,8],["ὠδίνουσαν",714095,78],["τεκεῖν",712853,106],["πρὶν",710742,28],["ἐλθεῖν",705453,106],["τὸν",709436,5],["πόνον",710661,6],["τῶν",709436,130],["ὠδίνων",714094,65],["ἐξέφυγεν",704357,2],["καὶ",707031,7],["ἔτεκεν",712853,2],["ἄρσεν",701818,46]],"Before she that travailed brought forth, before the travail-pain came on, she escaped [it] and brought forth a male."],["8",[["τίς",712867,158],["ἤκουσεν",700587,2],["τοιοῦτο",712878,684],["καὶ",707031,7],["τίς",712867,158],["ἑώρακεν",709725,171],["οὕτως",709859,28],["ἦ",705924,7],["ὤδινεν",714095,2],["γῆ",703083,12],["ἐν",704639,0],["μιᾷ",704106,101],["ἡμέρᾳ",705984,1],["ἢ",705924,7],["καὶ",707031,7],["ἐτέχθη",712853,37],["ἔθνος",704068,15],["εἰς",704105,0],["ἅπαξ",701350,28],["ὅτι",709803,7],["ὤδινεν",714095,2],["καὶ",707031,7],["ἔτεκεν",712853,2],["Σιων",711816,12],["τὰ",709436,41],["παιδία",709924,42],["αὐτῆς",702165,86]],"Who has heard such a thing? and who has seen after this manner? Has the earth travailed in one day? or has even a nation been born at once, that Sion has travailed, and brought forth her children?"],["9",[["ἐγὼ",704018,164],["δὲ",703303,11],["ἔδωκα",703654,155],["τὴν",709436,8],["προσδοκίαν",710877,9],["ταύτην",709858,104],["καὶ",707031,7],["οὐκ",709805,28],["ἐμνήσθης",708923,168],["μου",709032,133],["εἶπεν",705373,2],["κύριος",707996,4],["οὐκ