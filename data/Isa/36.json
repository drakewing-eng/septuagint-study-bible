[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["τοῦ",709436,20],["τεσσαρεσκαιδεκάτου",712809,92],["ἔτους",705543,21],["βασιλεύοντος",702581,152],["Εζεκιου",704044,18],["ἀνέβη",700905,2],["Σενναχηριμ",711693,4],["βασιλεὺς",702580,4],["Ἀσσυρίων",702004,81],["ἐπὶ",705080,0],["τὰς",709436,38],["πόλεις",710612,39],["τῆς",709436,16],["Ιουδαίας",706769,17],["τὰς",709436,38],["ὀχυρὰς",709889,119],["καὶ",707031,7],["ἔλαβεν",708076,2],["αὐτάς",702165,231]],"Now it came to pass in the fourteenth year of the reign of Ezekias, [that] Sennacherim, king of the Assyrians, came up against the strong cities of Judea, and took them."],["2",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["βασιλεὺς",702580,4],["Ἀσσυρίων",702004,18],["Ραψακην",711210,6],["ἐκ",704132,0],["Λαχις",708116,118],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["Εζεκιαν",704044,6],["μετὰ",708780,0],["δυνάμεως",703839,17],["πολλῆς",710646,82],["καὶ",707031,7],["ἔστη",706846,2],["ἐν",704639,0],["τῷ",709436,113],["ὑδραγωγῷ",713065,114],["τῆς",709436,16],["κολυμβήθρας",707802,17],["τῆς",709436,16],["ἄνω",701296,28],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["τοῦ",709436,35],["ἀγροῦ",700196,18],["τοῦ",709436,35],["γναφέως",703127,18]],"And the king of the Assyrians sent Rabsaces out of Laches to Jerusalem to king Ezekias with a large force: and he stood by the conduit of the upper pool in the way of the fuller's field."],["3",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["πρὸς",710844,0],["αὐτὸν",702165,85],["Ελιακιμ",704454,4],["ὁ",709436,3],["τοῦ",709436,35],["Χελκιου",713815,18],["ὁ",709436,3],["οἰκονόμος",709514,4],["καὶ",707031,7],["Σομνας",711936,4],["ὁ",709436,3],["γραμματεὺς",703185,4],["καὶ",707031,7],["Ιωαχ",706898,4],["ὁ",709436,3],["τοῦ",709436,35],["Ασαφ",701894,18],["ὁ",709436,3],["ὑπομνηματογράφος",713224,4]],"And there went forth to him Heliakim the steward, the [son] of Chelcias, and Somnas the scribe, and Joach the [son] of Asaph, the recorder."],["4",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["Ραψακης",711210,4],["εἴπατε",705373,74],["Εζεκια",704044,114],["τάδε",709446,71],["λέγει",708124,91],["ὁ",709436,3],["βασιλεὺς",702580,4],["ὁ",709436,3],["μέγας",708653,14],["βασιλεὺς",702580,4],["Ἀσσυρίων",702004,81],["τί",712867,126],["πεποιθὼς",710221,270],["εἶ",704093,154]],"And Rabsaces said to them, Say to Ezekias, Thus says the great king, the king of the Assyrians, Why art thou secure?"],["5",[["μὴ",708851,28],["ἐν",704639,0],["βουλῇ",702792,1],["ἢ",705924,7],["λόγοις",708236,148],["χειλέων",713781,44],["παράταξις",710107,12],["γίνεται",703104,117],["καὶ",707031,7],["νῦν",709384,28],["ἐπὶ",705080,0],["τίνι",712867,435],["πέποιθας",710221,266],["ὅτι",709803,7],["ἀπειθεῖς",701370,154],["μοι",708974,159]],"Is war carried on with counsel and [mere] words of the lips? and now on whom dost thou trust, that thou rebellest against me?"],["6",[["ἰδοὺ",706497,88],["πεποιθὼς",710221,270],["εἶ",704093,154],["ἐπὶ",705080,0],["τὴν",709436,8],["ῥάβδον",711135,9],["τὴν",709436,8],["καλαμίνην",707080,36],["τὴν",709436,8],["τεθλασμένην",706273,725],["ταύτην",709858,104],["ἐπ᾿",705080,0],["Αἴγυπτον",700401,9],["ὃς",709781,213],["ἂν",700900,11],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["ἐπιστηρισθῇ",705270,384],["εἰσελεύσεται",704114,93],["εἰς",704105,0],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["οὕτως",709859,28],["ἐστὶν",704093,91],["Φαραω",713360,4],["βασιλεὺς",702580,4],["Αἰγύπτου",700401,17],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["πεποιθότες",710221,268],["ἐπ᾿",705080,0],["αὐτῷ",702165,50]],"Behold, thou trustest on this bruised staff of reed, on Egypt: [as soon] as a man leans upon it, it shall go into his hand, and pierce it: so is Pharao king of Egypt and all that trust in him."],["7",[["εἰ",704071,7],["δὲ",703303,11],["λέγετε",708124,87],["ἐπὶ",705080,0],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["ἡμῶν",705999,145],["πεποίθαμεν",710221,314]],"But if ye say, We trust in the Lord our God;"],["8",[["νῦν",709384,28],["μείχθητε",708911,372],["τῷ",709436,113],["κυρίῳ",707996,114],["μου",709032,133],["τῷ",709436,113],["βασιλεῖ",702580,114],["Ἀσσυρίων",702004,81],["καὶ",707031,7],["δώσω",703654,165],["ὑμῖν",713084,90],["δισχιλίαν",703748,36],["ἵππον",706790,6],["εἰ",704071,7],["δυνήσεσθε",703838,124],["δοῦναι",703654,106],["ἀναβάτας",700909,57],["ἐπ᾿",705080,0],["αὐτούς",702165,62]],"yet now make an agreement with my lord the king of the Assyrians, and I will give you two thousand horses, if ye shall be able to set riders upon them."],["9",[["καὶ",707031,7],["πῶς",711121,88],["δύνασθε",703838,374],["ἀποστρέψαι",701598,106],["εἰς",704105,0],["πρόσωπον",710986,25],["τοπάρχου",712901,18],["ἑνός",704106,116],["οἰκέται",709496,52],["εἰσὶν",704093,197],["οἱ",709436,136],["πεποιθότες",710221,268],["ἐπ᾿",705080,0],["Αἰγυπτίοις",700400,148],["εἰς",704105,0],["ἵππον",706790,6],["καὶ",707031,7],["ἀναβάτην",700909,6]],"And how can ye [then] turn to the face of the satraps? They that trust on the Egyptians for horse and rider are [our] servants."],["10",[["καὶ",707031,7],["νῦν",709384,28],["μὴ",708851,28],["ἄνευ",701137,0],["κυρίου",707996,18],["ἀνέβημεν",700905,289],["ἐπὶ",705080,0],["τὴν",709436,8],["χώραν",714011,9],["ταύτην",709858,104],["πολεμῆσαι",710601,106],["αὐτήν",702165,104]],"And now, Have we come up against this land to fight against it without the Lord? The Lord said to me, Go up against this land, and destroy it.",{"s":"d","q":0.52}],["11",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτὸν",702165,85],["Ελιακιμ",704454,4],["καὶ",707031,7],["Σομνας",711936,4],["καὶ",707031,7],["Ιωαχ",706898,4],["λάλησον",708071,176],["πρὸς",710844,0],["τοὺς",709436,58],["παῖδάς",709932,57],["σου",711945,133],["Συριστί",712540,28],["ἀκούομεν",700587,243],["γὰρ",702963,11],["ἡμεῖς",705983,219],["καὶ",707031,7],["μὴ",708851,28],["λάλει",708071,240],["πρὸς",710844,0],["ἡμᾶς",705981,194],["Ιουδαϊστί",706774,28],["καὶ",707031,7],["ἵνα",706747,7],["τί",712867,126],["λαλεῖς",708071,154],["εἰς",704105,0],["τὰ",709436,41],["ὦτα",709852,25],["τῶν",709436,80],["ἀνθρώπων",701163,81],["τῶν",709436,80],["ἐπὶ",705080,0],["τῷ",709436,53],["τείχει",712759,54]],"Then Eliakim and Somnas and Joach said to him, Speak to thy servants in the Syrian tongue; for we understand [it]: and speak not to us in the Jewish tongue: and wherefore speakest thou in the ears of the men on the wall?"],["12",[["καὶ",707031,7],["εἶπεν",705373,2],["Ραψακης",711210,4],["πρὸς",710844,0],["αὐτούς",702165,62],["μὴ",708851,28],["πρὸς",710844,0],["τὸν",709436,5],["κύριον",707996,6],["ὑμῶν",713091,145],["ἢ",705924,7],["πρὸς",710844,0],["ὑμᾶς",713080,194],["ἀπέσταλκέν",701592,171],["με",708618,163],["ὁ",709436,3],["κύριός",707996,4],["μου",709032,133],["λαλῆσαι",708071,106],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["οὐχὶ",709862,28],["πρὸς",710844,0],["τοὺς",709436,58],["ἀνθρώπους",701163,57],["τοὺς",709436,58],["καθημένους",707000,236],["ἐπὶ",705080,0],["τῷ",709436,53],["τείχει",712759,54],["ἵνα",706747,7],["φάγωσιν",713296,234],["κόπρον",707828,9],["καὶ",707031,7],["πίωσιν",710478,234],["οὖρον",709851,25],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["ἅμα",700745,28]],"And Rabsaces said to them, Has my lord sent me to your lord or to you, to speak these words? [has he] not [sent] me to the men that sit on the wall, that they may eat dung, and drink [their] water together with you?"],["13",[["καὶ",707031,7],["ἔστη",706846,2],["Ραψακης",711210,4],["καὶ",707031,7],["ἐβόησεν",702743,2],["φωνῇ",713640,1],["μεγάλῃ",708653,101],["Ιουδαϊστὶ",706774,28],["καὶ",707031,7],["εἶπεν",705373,2],["ἀκούσατε",700587,74],["τοὺς",709436,58],["λόγους",708236,57],["τοῦ",709436,35],["βασιλέως",702580,18],["τοῦ",709436,35],["μεγάλου",708653,116],["βασιλέως",702580,18],["Ἀσσυρίων",702004,81]],"And Rabsaces stood, and cried with a loud voice in the Jewish language, and said, Hear ye the words of the great king, the king of the Assyrians:"],["14",[["τάδε",709446,71],["λέγει",708124,91],["ὁ",709436,3],["βασιλεύς",702580,4],["μὴ",708851,28],["ἀπατάτω",701364,31],["ὑμᾶς",713080,194],["Εζεκιας",704044,4],["λόγοις",708236,148],["οἳ",709781,250],["οὐ",709805,28],["δυνήσονται",703838,135],["ῥύσασθαι",711309,109],["ὑμᾶς",713080,194]],"thus says the king, Let not Ezekias deceive you with words: he will not be able to deliver you."],["15",[["καὶ",707031,7],["μὴ",708851,28],["λεγέτω",708124,31],["ὑμῖν",713084,90],["Εζεκιας",704044,4],["ὅτι",709803,7],["ῥύσεται",711309,93],["ὑμᾶς",713080,194],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["παραδοθῇ",710014,384],["ἡ",709436,10],["πόλις",710612,12],["αὕτη",709858,107],["ἐν",704639,0],["χειρὶ",713787,1],["βασιλέως",702580,18],["Ἀσσυρίων",702004,81]],"And let not Ezekias say to you, That God will deliver you, and this city will not at all be delivered into the hand of the king of the Assyrians."],["16",[["μὴ",708851,28],["ἀκούετε",700587,335],["Εζεκιου",704044,18],["τάδε",709446,71],["λέγει",708124,91],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ἀσσυρίων",702004,81],["εἰ",704071,11],["βούλεσθε",702795,374],["εὐλογηθῆναι",705631,179],["ἐκπορεύεσθε",704293,374],["πρός",710844,0],["με",708618,163],["καὶ",707031,7],["φάγεσθε",705495,124],["ἕκαστος",704133,14],["τὴν",709436,8],["ἄμπελον",700870,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰς",709436,38],["συκᾶς",712254,39],["καὶ",707031,7],["πίεσθε",710478,124],["ὕδωρ",713071,15],["τοῦ",709436,35],["λάκκου",708067,18],["ὑμῶν",713091,145]],"Hearken not to Ezekias: thus says the king of the Assyrians, If ye wish to be blessed, come out to me: and ye shall eat every one [of] his vine and his fig-trees, and ye shall drink water out of your own cisterns;"],["17",[["ἕως",705792,7],["ἂν",700900,11],["ἔλθω",705453,207],["καὶ",707031,7],["λάβω",708076,207],["ὑμᾶς",713080,194],["εἰς",704105,0],["γῆν",703083,9],["ὡς",714148,28],["ἡ",709436,10],["γῆ",703083,12],["ὑμῶν",713091,145],["γῆ",703083,12],["σίτου",711814,18],["καὶ",707031,7],["οἴνου",709530,18],["καὶ",707031,7],["ἄρτων",701829,81],["καὶ",707031,7],["ἀμπελώνων",700872,81]],"until I come and take you to a land, like your own land, a land of corn and wine, and bread and vineyards."],["18",[["μὴ",708851,28],["ὑμᾶς",713080,194],["ἀπατάτω",701364,31],["Εζεκιας",704044,4],["λέγων",708124,72],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["ῥύσεται",711309,93],["ὑμᾶς",713080,194],["μὴ",708851,28],["ἐρρύσαντο",711309,189],["οἱ",709436,136],["θεοὶ",706192,52],["τῶν",709436,43],["ἐθνῶν",704068,44],["ἕκαστος",704133,14],["τὴν",709436,8],["ἑαυτοῦ",703917,86],["χώραν",714011,9],["ἐκ",704132,0],["χειρὸς",713787,17],["βασιλέως",702580,18],["Ἀσσυρίων",702004,81]],"Let not Ezekias deceive you, saying, God will deliver you. Have the gods of the nations delivered each one his own land out of the hand of the king of the Assyrians?"],["19",[["ποῦ",710706,28],["ἐστιν",704093,91],["ὁ",709436,3],["θεὸς",706192,4],["Αιμαθ",700443,118],["καὶ",707031,7],["Αρφαθ",701831,118],["καὶ",707031,7],["ποῦ",710706,28],["ὁ",709436,3],["θεὸς",706192,4],["τῆς",709436,16],["πόλεως",710612,17],["Σεπφαριμ",711696,118],["μὴ",708851,28],["ἐδύναντο",703838,139],["ῥύσασθαι",711309,109],["Σαμάρειαν",711449,9],["ἐκ",704132,0],["χειρός",713787,17],["μου",709032,133]],"Where is the god of Emath, and Arphath? and where is the god of Eppharuaim? have they been able to deliver Samaria out of my hand?"],["20",[["τίς",712867,158],["τῶν",709436,80],["θεῶν",706192,81],["πάντων",710177,83],["τῶν",709436,43],["ἐθνῶν",704068,44],["τούτων",709858,70],["ἐρρύσατο",711309,23],["τὴν",709436,8],["γῆν",703083,9],["αὐτοῦ",702165,102],["ἐκ",704132,0],["τῆς",709436,16],["χειρός",713787,17],["μου",709032,133],["ὅτι",709803,7],["ῥύσεται",711309,93],["ὁ",709436,3],["θεὸς",706192,4],["Ιερουσαλημ",706644,17],["ἐκ",704132,0],["χειρός",713787,17],["μου",709032,133]],"Which is the god of all these nations, that has delivered his land out of my hand, that God should deliver Jerusalem out of my hand?"],["21",[["καὶ",707031,7],["ἐσιώπησαν",711818,150],["καὶ",707031,7],["οὐδεὶς",709817,14],["ἀπεκρίθη",701492,37],["αὐτῷ",702165,50],["λόγον",708236,6],["διὰ",703417,0],["τὸ",709436,24],["προστάξαι",710962,106],["τὸν",709436,5],["βασιλέα",702580,6],["μηδένα",708857,46],["ἀποκριθῆναι",701492,179]],"And they were silent, and none answered him a word; because the king had commanded that none should answer."],["22",[["καὶ",707031,7],["εἰσῆλθεν",704114,2],["Ελιακιμ",704454,4],["ὁ",709436,3],["τοῦ",709436,35],["Χελκιου",713815,18],["ὁ",709436,3],["οἰκονόμος",709514,4],["καὶ",707031,7],["Σομνας",711936,4],["ὁ",709436,3],["γραμματεὺς",703185,4],["τῆς",709436,16],["δυνάμεως",703839,17],["καὶ",707031,7],["Ιωαχ",706898,4],["ὁ",709436,3],["τοῦ",709436,35],["Ασαφ",701894,18],["ὁ",709436,3],["ὑπομνηματογράφος",713224,4],["πρὸς",710844,0],["Εζεκιαν",704044,6],["ἐσχισμένοι",712604,429],["τοὺς",709436,58],["χιτῶνας",713869,57],["καὶ",707031,7],["ἀπήγγειλαν",701321,150],["αὐτῷ",702165,50],["τοὺς",709436,58],["λόγους",708236,57],["Ραψακου",711210,18]],"And Heliakim the [son] of Chelcias, the steward, and Somnas the military scribe, and Joach the [son] of Asaph, the recorder, came in to Ezekias, having their garments rent, and they reported to him the words of Rabsaces."]]