[["1",[["φωτίζου",713646,253],["φωτίζου",713646,253],["Ιερουσαλημ",706644,12],["ἥκει",705956,91],["γάρ",702963,11],["σου",711945,133],["τὸ",709436,34],["φῶς",713642,15],["καὶ",707031,7],["ἡ",709436,10],["δόξα",703791,12],["κυρίου",707996,18],["ἐπὶ",705080,0],["σὲ",711598,163],["ἀνατέταλκεν",701066,171]],"Be enlightened, be enlightened, O Jerusalem, for thy light is come, and the glory of the Lord is risen upon thee."],["2",[["ἰδοὺ",706497,88],["σκότος",711889,6],["καὶ",707031,7],["γνόφος",703131,4],["καλύψει",707102,127],["γῆν",703083,9],["ἐπ᾿",705080,0],["ἔθνη",704068,42],["ἐπὶ",705080,0],["δὲ",703303,11],["σὲ",711598,163],["φανήσεται",713311,134],["κύριος",707996,4],["καὶ",707031,7],["ἡ",709436,10],["δόξα",703791,12],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["σὲ",711598,163],["ὀφθήσεται",709725,134]],"Behold, darkness shall cover the earth, and [there shall be] gross darkness on the nations: but the Lord shall appear upon thee, and his glory shall be seen upon thee."],["3",[["καὶ",707031,7],["πορεύσονται",710667,135],["βασιλεῖς",702580,52],["τῷ",709436,53],["φωτί",713642,54],["σου",711945,133],["καὶ",707031,7],["ἔθνη",704068,64],["τῇ",709436,100],["λαμπρότητί",708083,1],["σου",711945,133]],"And kings shall walk in thy light, and nations in thy brightness."],["4",[["ἆρον",700473,176],["κύκλῳ",707959,114],["τοὺς",709436,58],["ὀφθαλμούς",709870,57],["σου",711945,133],["καὶ",707031,7],["ἰδὲ",709725,176],["συνηγμένα",712375,388],["τὰ",709436,41],["τέκνα",712761,42],["σου",711945,133],["ἰδοὺ",706497,88],["ἥκασιν",705956,197],["πάντες",710177,138],["οἱ",709436,136],["υἱοί",713075,52],["σου",711945,133],["μακρόθεν",708417,28],["καὶ",707031,7],["αἱ",709436,190],["θυγατέρες",706320,191],["σου",711945,133],["ἐπ᾿",705080,0],["ὤμων",714114,81],["ἀρθήσονται",700473,144]],"Lift up thine eyes round about, and behold thy children gathered: all thy sons have come from far, and thy daughters shall be borne on [men's] shoulders."],["5",[["τότε",712908,28],["ὄψῃ",709725,123],["καὶ",707031,7],["φοβηθήσῃ",713532,364],["καὶ",707031,7],["ἐκστήσῃ",704940,364],["τῇ",709436,100],["καρδίᾳ",707141,1],["ὅτι",709803,7],["μεταβαλεῖ",708782,127],["εἰς",704105,0],["σὲ",711598,163],["πλοῦτος",710563,4],["θαλάσσης",706069,17],["καὶ",707031,7],["ἐθνῶν",704068,44],["καὶ",707031,7],["λαῶν",708094,81],["καὶ",707031,7],["ἥξουσίν",705956,218],["σοι",711925,159]],"Then shalt thou see, and fear, and be amazed in thine heart; for the wealth of the sea shall come round to thee, and of nations and peoples; and herds of camels shall come to thee,"],["6",[["ἀγέλαι",700148,191],["καμήλων",707110,81],["καὶ",707031,7],["καλύψουσίν",707102,218],["σε",711598,163],["κάμηλοι",707110,52],["Μαδιαμ",708355,118],["καὶ",707031,7],["Γαιφα",702917,118],["πάντες",710177,138],["ἐκ",704132,0],["Σαβα",711332,118],["ἥξουσιν",705956,218],["φέροντες",713428,146],["χρυσίον",713972,25],["καὶ",707031,7],["λίβανον",708186,6],["οἴσουσιν",713428,218],["καὶ",707031,7],["τὸ",709436,24],["σωτήριον",712659,25],["κυρίου",707996,18],["εὐαγγελιοῦνται",705547,135]],"and the camels of Madiam and Gæpha shall cover thee: all from Saba shall come bearing gold, and shall bring frankincense, and they shall publish the salvation of the Lord."],["7",[["καὶ",707031,7],["πάντα",710177,195],["τὰ",709436,63],["πρόβατα",710768,64],["Κηδαρ",707645,118],["συναχθήσονταί",712375,144],["σοι",711925,159],["καὶ",707031,7],["κριοὶ",707906,52],["Ναβαιωθ",709131,118],["ἥξουσίν",705956,218],["σοι",711925,159],["καὶ",707031,7],["ἀνενεχθήσεται",701083,134],["δεκτὰ",703348,68],["ἐπὶ",705080,0],["τὸ",709436,24],["θυσιαστήριόν",706348,25],["μου",709032,133],["καὶ",707031,7],["ὁ",709436,3],["οἶκος",709516,4],["τῆς",709436,16],["προσευχῆς",710892,17],["μου",709032,133],["δοξασθήσεται",703792,134]],"And all the flocks of Kedar shall be gathered, and the rams of Nabæoth shall come; and acceptable sacrifices shall be offered on my altar, and my house of prayer shall be glorified."],["8",[["τίνες",712867,392],["οἵδε",709446,201],["ὡς",714148,11],["νεφέλαι",709277,191],["πέτανται",710441,269],["καὶ",707031,7],["ὡς",714148,11],["περιστεραὶ",710391,191],["σὺν",712372,0],["νεοσσοῖς",709257,148]],"Who are these [that] fly as clouds, and as doves with young ones to me?",{"s":"d","q":0.58}],["9",[["ἐμὲ",704555,163],["νῆσοι",709302,191],["ὑπέμειναν",713219,150],["καὶ",707031,7],["πλοῖα",710556,42],["Θαρσις",706124,118],["ἐν",704639,0],["πρώτοις",711041,343],["ἀγαγεῖν",700209,106],["τὰ",709436,41],["τέκνα",712761,42],["σου",711945,133],["μακρόθεν",708417,0],["καὶ",707031,7],["τὸν",709436,5],["ἄργυρον",701711,6],["καὶ",707031,7],["τὸν",709436,5],["χρυσὸν",713975,27],["μετ᾿",708780,0],["αὐτῶν",702165,40],["διὰ",703417,0],["τὸ",709436,24],["ὄνομα",709666,25],["κυρίου",707996,18],["τὸ",709436,24,5],["ἅγιον",700159,27],["καὶ",707031,7],["διὰ",703417,0],["τὸ",709436,24],["τὸν",709436,5],["ἅγιον",700159,27],["τοῦ",709436,35],["Ισραηλ",706839,18],["ἔνδοξον",704694,27],["εἶναι",704093,55]],"The isles have waited for me, and the ships of Tharsis among the first, to bring thy children from afar, and their silver and their gold with them, and [that] for the sake of the holy name of the Lord, and because the Holy One of Israel is glorified."],["10",[["καὶ",707031,7],["οἰκοδομήσουσιν",709509,218],["ἀλλογενεῖς",700690,138],["τὰ",709436,41],["τείχη",712759,42],["σου",711945,133],["καὶ",707031,7],["οἱ",709436,136],["βασιλεῖς",702580,52],["αὐτῶν",702165,40],["παραστήσονταί",710152,135],["σοι",711925,159],["διὰ",703417,0],["γὰρ",702963,11],["ὀργήν",709728,9],["μου",709032,133],["ἐπάταξά",710185,155],["σε",711598,163],["καὶ",707031,7],["διὰ",703417,0],["ἔλεον",704426,25],["ἠγάπησά",700120,155],["σε",711598,163]],"And strangers shall build thy walls, and their kings shall wait upon thee: for by reason of my wrath I smote thee, and by reason of mercy I loved thee."],["11",[["καὶ",707031,7],["ἀνοιχθήσονται",701186,144],["αἱ",709436,190],["πύλαι",711082,191],["σου",711945,133],["διὰ",703417,0],["παντός",710177,116],["ἡμέρας",705984,17],["καὶ",707031,7],["νυκτὸς",709386,17],["οὐ",709805,28],["κλεισθήσονται",707710,144],["εἰσαγαγεῖν",704107,106],["πρὸς",710844,0],["σὲ",711598,163],["δύναμιν",703839,9],["ἐθνῶν",704068,44],["καὶ",707031,7],["βασιλεῖς",702580,57],["ἀγομένους",700209,236]],"And thy gates shall be opened continually; they shall not be shut day nor night; to bring in to thee the power of the Gentiles, and their kings as captives."],["12",[["τὰ",709436,63],["γὰρ",702963,11],["ἔθνη",704068,64],["καὶ",707031,7],["οἱ",709436,136],["βασιλεῖς",702580,52],["οἵτινες",709793,450],["οὐ",709805,28],["δουλεύσουσίν",703814,218],["σοι",711925,159],["ἀπολοῦνται",701513,135],["καὶ",707031,7],["τὰ",709436,63],["ἔθνη",704068,64],["ἐρημίᾳ",705417,1],["ἐρημωθήσονται",705421,144]],"For the nations and the kings which will not serve thee shall perish; and those nations shall be made utterly desolate."],["13",[["καὶ",707031,7],["ἡ",709436,10],["δόξα",703791,12],["τοῦ",709436,35],["Λιβάνου",708185,18],["πρὸς",710844,0],["σὲ",711598,163],["ἥξει",705956,127],["ἐν",704639,0],["κυπαρίσσῳ",707982,1],["καὶ",707031,7],["πεύκῃ",710447,1],["καὶ",707031,7],["κέδρῳ",707590,1],["ἅμα",700745,28],["δοξάσαι",703792,106],["τὸν",709436,5],["τόπον",712903,6],["τὸν",709436,5],["ἅγιόν",700159,27],["μου",709032,133]],"And the glory of Libanus shall come to thee, with the cypress, and pine, and cedar together, to glorify my holy place."],["14",[["καὶ",707031,7],["πορεύσονται",710667,135],["πρὸς",710844,0],["σὲ",711598,163],["δεδοικότες",703313,268],["υἱοὶ",713075,52],["ταπεινωσάντων",712717,221],["σε",711598,163],["καὶ",707031,7],["παροξυνάντων",710164,221],["σε",711598,163],["καὶ",707031,7],["κληθήσῃ",707084,364],["πόλις",710612,12],["κυρίου",707996,18],["Σιων",711816,12],["ἁγίου",700159,116],["Ισραηλ",706839,18]],"And the sons of them that afflicted thee, and of them that provoked thee, shall come to thee in fear; and thou shalt be called Sion, the city of the Holy One of Israel."],["15",[["διὰ",703417,0],["τὸ",709436,24],["γεγενῆσθαί",703104,431],["σε",711598,163],["ἐγκαταλελειμμένην",703967,444],["καὶ",707031,7],["μεμισημένην",708935,444],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ὁ",709436,3],["βοηθῶν",702746,72],["καὶ",707031,7],["θήσω",712849,165],["σε",711598,163],["ἀγαλλίαμα",700112,25],["αἰώνιον",700505,46],["εὐφροσύνην",705717,9],["γενεῶν",703037,65],["γενεαῖς",703037,76]],"Because thou hast become desolate and hated, and there was no helper, therefore I will make thee a perpetual gladness, a joy of many generations."],["16",[["καὶ",707031,7],["θηλάσεις",706233,166],["γάλα",702919,25],["ἐθνῶν",704068,44],["καὶ",707031,7],["πλοῦτον",710563,6],["βασιλέων",702580,81],["φάγεσαι",713296,166],["καὶ",707031,7],["γνώσῃ",703105,123],["ὅτι",709803,7],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["σῴζων",712627,72],["σε",711598,163],["καὶ",707031,7],["ἐξαιρούμενός",704838,122],["σε",711598,163],["θεὸς",706192,4],["Ισραηλ",706839,18]],"And thou shalt suck the milk of the Gentiles, and shalt eat the wealth of kings: and shalt know that I am the Lord that saves thee and delivers thee, the Holy One of Israel."],["17",[["καὶ",707031,7],["ἀντὶ",701227,0],["χαλκοῦ",713695,116],["οἴσω",713428,165],["σοι",711925,159],["χρυσίον",713972,25],["ἀντὶ",701227,0],["δὲ",703303,11],["σιδήρου",711774,18],["οἴσω",713428,165],["σοι",711925,159],["ἀργύριον",701707,25],["ἀντὶ",701227,0],["δὲ",703303,11],["ξύλων",709427,44],["οἴσω",713428,165],["σοι",711925,159],["χαλκόν",713695,6],["ἀντὶ",701227,0],["δὲ",703303,11],["λίθων",708196,81],["σίδηρον",711774,6],["καὶ",707031,7],["δώσω",703654,165],["τοὺς",709436,58],["ἄρχοντάς",701862,57],["σου",711945,133],["ἐν",704639,0],["εἰρήνῃ",704098,1],["καὶ",707031,7],["τοὺς",709436,58],["ἐπισκόπους",705256,57],["σου",711945,133],["ἐν",704639,0],["δικαιοσύνῃ",703695,1]],"And for brass I will bring thee gold, and for iron I will bring thee silver, and instead of wood I will bring thee brass, and instead of stones, iron; and I will make thy princes peaceable, and thine overseers righteous."],["18",[["καὶ",707031,7],["οὐκ",709805,28],["ἀκουσθήσεται",700587,134],["ἔτι",705538,28],["ἀδικία",700271,12],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["σου",711945,133],["οὐδὲ",709816,7],["σύντριμμα",712521,15],["οὐδὲ",709816,7],["ταλαιπωρία",712695,12],["ἐν",704639,0],["τοῖς",709436,95],["ὁρίοις",709749,96],["σου",711945,133],["ἀλλὰ",700680,7],["κληθήσεται",707084,134],["σωτήριον",712659,15],["τὰ",709436,63],["τείχη",712759,64],["σου",711945,133],["καὶ",707031,7],["αἱ",709436,190],["πύλαι",711082,191],["σου",711945,133],["γλύμμα",703116,15]],"And injustice shall no more be heard in thy land, nor destruction nor misery in thy coasts; but thy walls shall be called Salvation, and thy gates Sculptured Work."],["19",[["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["σοι",711925,159],["ὁ",709436,3],["ἥλιος",705974,4],["εἰς",704105,0],["φῶς",713642,25],["ἡμέρας",705984,17],["οὐδὲ",709816,7],["ἀνατολὴ",701071,12],["σελήνης",711650,17],["φωτιεῖ",713646,127],["σοι",711925,159],["τὴν",709436,8],["νύκτα",709386,9],["ἀλλ᾿",700680,7],["ἔσται",704093,93],["σοι",711925,159],["κύριος",707996,4],["φῶς",713642,25],["αἰώνιον",700505,46],["καὶ",707031,7],["ὁ",709436,3],["θεὸς",706192,4],["δόξα",703791,12],["σου",711945,133]],"And thou shalt no more have the sun for a light by day, nor shall the rising of the moon lighten thy night; but the Lord shall be thine everlasting light, and God thy glory."],["20",[["οὐ",709805,28],["γὰρ",702963,11],["δύσεται",703848,93],["ὁ",709436,3],["ἥλιός",705974,4],["σοι",711925,159],["καὶ",707031,7],["ἡ",709436,10],["σελήνη",711650,12],["σοι",711925,159],["οὐκ",709805,28],["ἐκλείψει",704237,127],["ἔσται",704093,93],["γὰρ",702963,11],["κύριός",707996,4],["σοι",711925,159],["φῶς",713642,25],["αἰώνιον",700505,27],["καὶ",707031,7],["ἀναπληρωθήσονται",701035,144],["αἱ",709436,190],["ἡμέραι",705984,191],["τοῦ",709436,20],["πένθους",710253,21],["σου",711945,133]],"For the sun shall no more set, nor shall the moon be eclipsed; for the Lord shall be thine everlasting light, and the days of thy mourning shall be completed."],["21",[["καὶ",707031,7],["ὁ",709436,3],["λαός",708094,4],["σου",711945,133],["πᾶς",710177,14],["δίκαιος",703694,14],["καὶ",707031,7],["δι᾿",703417,0],["αἰῶνος",700504,18],["κληρονομήσουσιν",707724,218],["τὴν",709436,8],["γῆν",703083,9],["φυλάσσων",713619,72],["τὸ",709436,24],["φύτευμα",713635,25],["ἔργα",705396,42],["χειρῶν",713787,65],["αὐτοῦ",702165,102],["εἰς",704105,0],["δόξαν",703791,9]],"Thy people also shall be all righteous; they shall inherit the land for ever, preserving that which they have planted, [even] the works of their hands, for glory."],["22",[["ὁ",709436,3],["ὀλιγοστὸς",709569,140],["ἔσται",704093,93],["εἰς",704105,0],["χιλιάδας",713858,39],["καὶ",707031,7],["ὁ",709436,3],["ἐλάχιστος",704400,140],["εἰς",704105,0],["ἔθνος",704068,25],["μέγα",708653,46],["ἐγὼ",704018,164],["κύριος",707996,4],["κατὰ",707200,0],["καιρὸν",707047,6],["συνάξω",712375,165],["αὐτούς",702165,62]],"The little one shall become thousands, and the least a great nation; I the Lord will gather them in [due] time."]]