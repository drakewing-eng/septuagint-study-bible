[["1",[["ἰδοὺ",706497,88],["δὴ",703395,11],["ὁ",709436,3],["δεσπότης",703379,4],["κύριος",707996,4],["σαβαωθ",711346,228],["ἀφελεῖ",702177,127],["ἀπὸ",701425,0],["τῆς",709436,16],["Ιουδαίας",706769,17],["καὶ",707031,7],["ἀπὸ",701425,0],["Ιερουσαλημ",706644,17],["ἰσχύοντα",706859,183],["καὶ",707031,7],["ἰσχύουσαν",706859,78],["ἰσχὺν",706858,46],["ἄρτου",701829,18],["καὶ",707031,7],["ἰσχὺν",706858,46],["ὕδατος",713071,21]],"Behold now, the Lord, the Lord of hosts, will take away from Jerusalem and from Judea the mighty man and mighty woman, the strength of bread, and the strength of water,"],["2",[["γίγαντα",703101,6],["καὶ",707031,7],["ἰσχύοντα",706859,235],["καὶ",707031,7],["ἄνθρωπον",701163,6],["πολεμιστὴν",710604,6],["καὶ",707031,7],["δικαστὴν",703701,6],["καὶ",707031,7],["προφήτην",711009,6],["καὶ",707031,7],["στοχαστὴν",712131,6],["καὶ",707031,7],["πρεσβύτερον",710735,6]],"the great and mighty man, the warrior and the judge, and the prophet, and the counsellor, and the elder,"],["3",[["καὶ",707031,7],["πεντηκόνταρχον",710272,25],["καὶ",707031,7],["θαυμαστὸν",706138,27],["σύμβουλον",712295,6],["καὶ",707031,7],["σοφὸν",711985,27],["ἀρχιτέκτονα",701857,6],["καὶ",707031,7],["συνετὸν",712464,27],["ἀκροατήν",700604,6]],"the captain of fifty also, and the honourable counsellor, and the wise artificer, and the intelligent hearer."],["4",[["καὶ",707031,7],["ἐπιστήσω",705756,165],["νεανίσκους",709232,57],["ἄρχοντας",701862,57],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐμπαῖκται",704584,52],["κυριεύσουσιν",707995,218],["αὐτῶν",702165,40]],"And I will make youths their princes, and mockers shall have dominion over them."],["5",[["καὶ",707031,7],["συμπεσεῖται",712332,93],["ὁ",709436,3],["λαός",708094,4],["ἄνθρωπος",701163,4],["πρὸς",710844,0],["ἄνθρωπον",701163,6],["καὶ",707031,7],["ἄνθρωπος",701163,4],["πρὸς",710844,0],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102],["προσκόψει",710923,127],["τὸ",709436,24],["παιδίον",709927,25],["πρὸς",710844,0],["τὸν",709436,5],["πρεσβύτην",710736,6],["ὁ",709436,3],["ἄτιμος",702095,14],["πρὸς",710844,0],["τὸν",709436,5],["ἔντιμον",704798,27]],"And the people shall fall, man upon man, and [every] man upon his neighbour: the child shall insult the elder man, and the base the honourable."],["6",[["ὅτι",709803,7],["ἐπιλήμψεται",705185,93],["ἄνθρωπος",701163,4],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["αὐτοῦ",702165,102],["ἢ",705924,7],["τοῦ",709436,35],["οἰκείου",709493,116],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["λέγων",708124,72],["ἱμάτιον",706742,25],["ἔχεις",705785,154],["ἀρχηγὸς",701838,4],["ἡμῶν",705999,145],["γενοῦ",703104,300],["καὶ",707031,7],["τὸ",709436,24],["βρῶμα",702823,25],["τὸ",709436,24],["ἐμὸν",704578,46],["ὑπὸ",713184,0],["σὲ",711598,163],["ἔστω",704093,31]],"For a man shall lay hold of his brother, as one of his father's household, saying, Thou hast raiment, be thou our ruler, and let my meat be under thee."],["7",[["καὶ",707031,7],["ἀποκριθεὶς",701492,217],["ἐρεῖ",705415,127],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["οὐκ",709805,28],["ἔσομαί",704093,181],["σου",711945,133],["ἀρχηγός",701838,4],["οὐ",709805,28],["γὰρ",702963,11],["ἔστιν",704093,91],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["μου",709032,133],["ἄρτος",701829,4],["οὐδὲ",709816,7],["ἱμάτιον",706742,25],["οὐκ",709805,28],["ἔσομαι",704093,181],["ἀρχηγὸς",701838,4],["τοῦ",709436,35],["λαοῦ",708094,18],["τούτου",709858,102]],"And he shall answer in that day, and say, I will not be thy ruler; for I have no bread in my house, nor raiment: I will not be the ruler of this people."],["8",[["ὅτι",709803,7],["ἀνεῖται",700962,187],["Ιερουσαλημ",706644,12],["καὶ",707031,7],["ἡ",709436,10],["Ιουδαία",706769,12],["συμπέπτωκεν",712332,171],["καὶ",707031,7],["αἱ",709436,190],["γλῶσσαι",703120,191],["αὐτῶν",702165,284],["μετὰ",708780,0],["ἀνομίας",701192,17],["τὰ",709436,41],["πρὸς",710844,0],["κύριον",707996,6],["ἀπειθοῦντες",701370,146],["διότι",703734,7],["νῦν",709384,28],["ἐταπεινώθη",712717,37],["ἡ",709436,10],["δόξα",703791,12],["αὐτῶν",702165,40]],"For Jerusalem is ruined, and Judea has fallen, and their tongues [have spoken] with iniquity, disobedient [as they are] towards the Lord."],["9",[["καὶ",707031,7],["ἡ",709436,10],["αἰσχύνη",700483,12],["τοῦ",709436,20],["προσώπου",710986,21],["αὐτῶν",702165,40],["ἀντέστη",701154,2],["αὐτοῖς",702165,151],["τὴν",709436,8],["δὲ",703303,11],["ἁμαρτίαν",700775,9],["αὐτῶν",702165,40],["ὡς",714148,28],["Σοδομων",711923,9],["ἀνήγγειλαν",700921,150],["καὶ",707031,7],["ἐνεφάνισαν",704628,150],["οὐαὶ",709807,88],["τῇ",709436,100],["ψυχῇ",714070,1],["αὐτῶν",702165,40],["διότι",703734,7],["βεβούλευνται",702791,255],["βουλὴν",702792,9],["πονηρὰν",710660,36],["καθ᾿",707200,28],["ἑαυτῶν",703917,40]],"Wherefore now their glory has been brought low, and the shame of their countenance has withstood them, and they have proclaimed their sin as Sodom, and made it manifest."],["10",[["εἰπόντες",705373,196],["δήσωμεν",703394,79],["τὸν",709436,5],["δίκαιον",703694,27],["ὅτι",709803,7],["δύσχρηστος",703883,14],["ἡμῖν",705994,90],["ἐστιν",704093,91],["τοίνυν",712875,11],["τὰ",709436,41],["γενήματα",703052,42],["τῶν",709436,43],["ἔργων",705396,44],["αὐτῶν",702165,40],["φάγονται",713296,135]],"Woe to their soul, for they have devised an evil counsel against themselves, saying against themselves, Let us bind the just, for he is burdensome to us: therefore shall they eat the fruits of their works."],["11",[["οὐαὶ",709807,88],["τῷ",709436,113],["ἀνόμῳ",701194,30],["πονηρὰ",710660,195],["κατὰ",707200,28],["τὰ",709436,41],["ἔργα",705396,42],["τῶν",709436,130],["χειρῶν",713787,65],["αὐτοῦ",702165,102],["συμβήσεται",712277,93],["αὐτῷ",702165,50]],"Woe to the transgressor! evils shall happen to him according to the works of his hands."],["12",[["λαός",708094,153],["μου",709032,133],["οἱ",709436,136],["πράκτορες",710713,52],["ὑμῶν",713091,145],["καλαμῶνται",707078,269],["ὑμᾶς",713080,194],["καὶ",707031,7],["οἱ",709436,136],["ἀπαιτοῦντες",701330,146],["κυριεύουσιν",707995,197],["ὑμῶν",713091,145],["λαός",708094,4],["μου",709032,133],["οἱ",709436,136],["μακαρίζοντες",708396,146],["ὑμᾶς",713080,194],["πλανῶσιν",710495,197],["ὑμᾶς",713080,194],["καὶ",707031,7],["τὸν",709436,5],["τρίβον",712939,6],["τῶν",709436,80],["ποδῶν",710707,81],["ὑμῶν",713091,145],["ταράσσουσιν",712721,197]],"O my people, your exactors strip you, and extortioners rule over you: O my people, they that pronounce you blessed lead you astray, and pervert the path of your feet."],["13",[["ἀλλὰ",700680,7],["νῦν",709384,28],["καταστήσεται",707011,93],["εἰς",704105,0],["κρίσιν",707908,9],["κύριος",707996,4],["καὶ",707031,7],["στήσει",706846,127],["εἰς",704105,0],["κρίσιν",707908,9],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102]],"But now the Lord will stand up for judgment, and will enter into judgment with his people."],["14",[["αὐτὸς",702165,121],["κύριος",707996,4],["εἰς",704105,0],["κρίσιν",707908,9],["ἥξει",705956,127],["μετὰ",708780,0],["τῶν",709436,80],["πρεσβυτέρων",710735,81],["τοῦ",709436,35],["λαοῦ",708094,18],["καὶ",707031,7],["μετὰ",708780,0],["τῶν",709436,80],["ἀρχόντων",701862,81],["αὐτοῦ",702165,102],["ὑμεῖς",713081,219],["δὲ",703303,11],["τί",712867,126],["ἐνεπυρίσατε",704622,265],["τὸν",709436,5],["ἀμπελῶνά",700872,6],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["ἁρπαγὴ",701802,12],["τοῦ",709436,35],["πτωχοῦ",711076,18],["ἐν",704639,0],["τοῖς",709436,147],["οἴκοις",709516,148],["ὑμῶν",713091,145]],"The Lord himself shall enter into judgment with the elders of the people, and with their rulers: but why have ye set my vineyard on fire, and [why is] the spoil of the poor in your houses?"],["15",[["τί",712867,126],["ὑμεῖς",713081,219],["ἀδικεῖτε",700269,87],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["καὶ",707031,7],["τὸ",709436,24],["πρόσωπον",710986,25],["τῶν",709436,80],["πτωχῶν",711076,81],["καταισχύνετε",707257,87]],"Why do ye wrong my people, and shame the face of the poor?"],["16",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἀνθ᾿",701227,0],["ὧν",709781,252],["ὑψώθησαν",713289,99],["αἱ",709436,190],["θυγατέρες",706320,191],["Σιων",711816,17],["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["ὑψηλῷ",713285,30],["τραχήλῳ",712924,114],["καὶ",707031,7],["ἐν",704639,0],["νεύμασιν",709272,148],["ὀφθαλμῶν",709870,81],["καὶ",707031,7],["τῇ",709436,100],["πορείᾳ",710665,1],["τῶν",709436,80],["ποδῶν",710707,81],["ἅμα",700745,28],["σύρουσαι",712543,305],["τοὺς",709436,58],["χιτῶνας",713869,57],["καὶ",707031,7],["τοῖς",709436,147],["ποσὶν",710707,148],["ἅμα",700745,28],["παίζουσαι",709931,306]],"Thus saith the Lord, Because the daughters of Sion are haughty, and have walked with an outstretched neck, and with winking of the eyes, and motion of the feet, at the same time drawing their garments in trains, and at the same time sporting with their feet:"],["17",[["καὶ",707031,7],["ταπεινώσει",712717,127],["ὁ",709436,3],["θεὸς",706192,4],["ἀρχούσας",701860,338],["θυγατέρας",706320,39],["Σιων",711816,17],["καὶ",707031,7],["κύριος",707996,4],["ἀποκαλύψει",701474,127],["τὸ",709436,24],["σχῆμα",712601,25],["αὐτῶν",702165,40]],"therefore the Lord will humble the chief daughters of Sion, and the Lord will expose their form in that day;"],["18",[["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["καὶ",707031,7],["ἀφελεῖ",702177,127],["κύριος",707996,4],["τὴν",709436,8],["δόξαν",703791,9],["τοῦ",709436,35],["ἱματισμοῦ",706744,18],["αὐτῶν",702165,40],["καὶ",707031,7],["τοὺς",709436,58],["κόσμους",707851,57],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,41],["ἐμπλόκια",704599,42],["καὶ",707031,7],["τοὺς",709436,58],["κοσύμβους",707853,57],["καὶ",707031,7],["τοὺς",709436,58],["μηνίσκους",708879,57]],"and the Lord will take away the glory of their raiment, the curls and the fringes, and the crescents,"],["19",[["καὶ",707031,7],["τὸ",709436,24],["κάθεμα",706995,25],["καὶ",707031,7],["τὸν",709436,5],["κόσμον",707851,6],["τοῦ",709436,20],["προσώπου",710986,21],["αὐτῶν",702165,40]],"and the chains, and the ornaments of their faces,"],["20",[["καὶ",707031,7],["τὴν",709436,8],["σύνθεσιν",712475,9],["τοῦ",709436,35],["κόσμου",707851,18],["τῆς",709436,16],["δόξης",703791,17],["καὶ",707031,7],["τοὺς",709436,58],["χλιδῶνας",713876,39],["καὶ",707031,7],["τὰ",709436,41],["ψέλια",714034,42],["καὶ",707031,7],["τὸ",709436,24],["ἐμπλόκιον",704599,25],["καὶ",707031,7],["τὰ",709436,41],["περιδέξια",710306,42],["καὶ",707031,7],["τοὺς",709436,58],["δακτυλίους",703258,57],["καὶ",707031,7],["τὰ",709436,41],["ἐνώτια",704826,68]],"and the array of glorious ornaments, and the armlets, and the bracelets, and the wreathed work, and the finger-rings, and the ornaments for the right hand, and the ear-rings,"],["21",[["καὶ",707031,7],["τὰ",709436,41],["περιπόρφυρα",710371,68],["καὶ",707031,7],["τὰ",709436,41],["μεσοπόρφυρα",708766,68]],"and the garments with scarlet borders, and the garments with purple grounds,"],["22",[["καὶ",707031,7],["τὰ",709436,41],["ἐπιβλήματα",705089,42],["τὰ",709436,41],["κατὰ",707200,28],["τὴν",709436,8],["οἰκίαν",709505,9],["καὶ",707031,7],["τὰ",709436,41],["διαφανῆ",703620,68],["λακωνικὰ",708070,119]],"and the shawls to be worn in the house, and the Spartan transparent dresses,"],["23",[["καὶ",707031,7],["τὰ",709436,41],["βύσσινα",702833,68],["καὶ",707031,7],["τὰ",709436,41],["ὑακίνθινα",713047,68],["καὶ",707031,7],["τὰ",709436,41],["κόκκινα",707783,68],["καὶ",707031,7],["τὴν",709436,8],["βύσσον",702834,9],["σὺν",712372,0],["χρυσίῳ",713972,54],["καὶ",707031,7],["ὑακίνθῳ",713048,1],["συγκαθυφασμένα",712197,437],["καὶ",707031,7],["θέριστρα",706210,42],["κατάκλιτα",707277,42]],"and those made of fine linen, and the purple [ones], and the scarlet [ones], and the fine linen, interwoven with gold and purple, and the light coverings for couches."],["24",[["καὶ",707031,7],["ἔσται",704093,93],["ἀντὶ",701227,0],["ὀσμῆς",709786,17],["ἡδείας",705945,82],["κονιορτός",707815,4],["καὶ",707031,7],["ἀντὶ",701227,0],["ζώνης",705912,17],["σχοινίῳ",712610,54],["ζώσῃ",705913,123],["καὶ",707031,7],["ἀντὶ",701227,0],["τοῦ",709436,35],["κόσμου",707851,18],["τῆς",709436,16],["κεφαλῆς",707639,17],["τοῦ",709436,20],["χρυσίου",713972,21],["φαλάκρωμα",713324,25],["ἕξεις",705785,166],["διὰ",703417,0],["τὰ",709436,41],["ἔργα",705396,42],["σου",711945,133],["καὶ",707031,7],["ἀντὶ",701227,0],["τοῦ",709436,35],["χιτῶνος",713869,18],["τοῦ",709436,35],["μεσοπορφύρου",708766,18],["περιζώσῃ",710317,123],["σάκκον",711386,6]],"And there shall be instead of a sweet smell, dust; and instead of a girdle, thou shalt gird thyself with a rope; and instead of a golden ornament for the head, thou shalt have baldness on account of thy works; and instead of a tunic with a scarlet ground, thou shalt gird thyself with sackcloth."],["25",[["καὶ",707031,7],["ὁ",709436,3],["υἱός",713075,4],["σου",711945,133],["ὁ",709436,3],["κάλλιστος",707097,140],["ὃν",709781,112],["ἀγαπᾷς",700120,154],["μαχαίρᾳ",708593,1],["πεσεῖται",710481,93],["καὶ",707031,7],["οἱ",709436,136],["ἰσχύοντες",706859,146],["ὑμῶν",713091,145],["μαχαίρᾳ",708593,1],["πεσοῦνται",710481,135]],"And thy most beautiful son whom thou lovest shall fall by the sword; and your mighty men shall fall by the sword, and shall be brought low."],["26",[["καὶ",707031,7],["ταπεινωθήσονται",712717,144],["καὶ",707031,7],["πενθήσουσιν",710251,218],["αἱ",709436,190],["θῆκαι",706232,191],["τοῦ",709436,35],["κόσμου",707851,18],["ὑμῶν",713091,145],["καὶ",707031,7],["καταλειφθήσῃ",707305,364],["μόνη",709003,29],["καὶ",707031,7],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ἐδαφισθήσῃ",704021,364]],"And the stores of your ornaments shall mourn, and thou shalt be left alone, and shalt be levelled with the ground."]]