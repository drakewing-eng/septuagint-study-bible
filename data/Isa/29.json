[["1",[["οὐαὶ",709807,88],["πόλις",710612,12],["Αριηλ",701739,12],["ἣν",709781,131],["Δαυιδ",703232,4],["ἐπολέμησεν",710601,2],["συναγάγετε",712375,74],["γενήματα",703052,42],["ἐνιαυτὸν",704745,6],["ἐπ᾿",705080,0],["ἐνιαυτόν",704745,6],["φάγεσθε",705495,124],["γὰρ",702963,11],["σὺν",712372,0],["Μωαβ",709085,114]],"Alas for the city Ariel, which David besieged. Gather ye fruits year by year; eat ye, for ye shall eat with Moab."],["2",[["ἐκθλίψω",704199,165],["γὰρ",702963,11],["Αριηλ",701739,9],["καὶ",707031,7],["ἔσται",704093,93],["αὐτῆς",702165,86],["ἡ",709436,10],["ἰσχὺς",706858,12],["καὶ",707031,7],["τὸ",709436,34],["πλοῦτος",710563,15],["ἐμοί",704577,159]],"For I will grievously afflict Ariel: and her strength and her wealth shall be mine."],["3",[["καὶ",707031,7],["κυκλώσω",707958,165],["ὡς",714148,28],["Δαυιδ",703232,6],["ἐπὶ",705080,0],["σὲ",711598,163],["καὶ",707031,7],["βαλῶ",702487,165],["περὶ",710285,0],["σὲ",711598,163],["χάρακα",713729,25],["καὶ",707031,7],["θήσω",712849,165],["περὶ",710285,0],["σὲ",711598,163],["πύργους",711092,57]],"And I will compass thee about like David, and will raise a mound about thee, and set up towers round thee."],["4",[["καὶ",707031,7],["ταπεινωθήσονται",712717,144],["οἱ",709436,136],["λόγοι",708236,52],["σου",711945,133],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["οἱ",709436,136],["λόγοι",708236,52],["σου",711945,133],["δύσονται",703848,135],["καὶ",707031,7],["ἔσται",704093,93],["ὡς",714148,28],["οἱ",709436,136],["φωνοῦντες",713639,146],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17],["ἡ",709436,10],["φωνή",713640,12],["σου",711945,133],["καὶ",707031,7],["πρὸς",710844,0],["τὸ",709436,24],["ἔδαφος",704022,25],["ἡ",709436,10],["φωνή",713640,12],["σου",711945,133],["ἀσθενήσει",701938,127]],"And thy words shall be brought down to the earth, and thy words shall sink down to the earth, and thy voice shall be as they that speak out of the earth, and thy voice shall be lowered to the ground."],["5",[["καὶ",707031,7],["ἔσται",704093,93],["ὡς",714148,28],["κονιορτὸς",707815,4],["ἀπὸ",701425,0],["τροχοῦ",712994,18],["ὁ",709436,3],["πλοῦτος",710563,4],["τῶν",709436,80],["ἀσεβῶν",701909,169],["καὶ",707031,7],["ὡς",714148,28],["χνοῦς",713883,4],["φερόμενος",713428,122],["καὶ",707031,7],["ἔσται",704093,93],["ὡς",714148,28],["στιγμὴ",712104,12],["παραχρῆμα",710119,28]],"But the wealth of the ungodly shall be as dust from a wheel, and the multitude of them that oppress thee as flying chaff, and it shall be suddenly as a moment,"],["6",[["παρὰ",709995,0],["κυρίου",707996,18],["σαβαωθ",711346,228],["ἐπισκοπὴ",705255,12],["γὰρ",702963,11],["ἔσται",704093,93],["μετὰ",708780,0],["βροντῆς",702816,17],["καὶ",707031,7],["σεισμοῦ",711632,18],["καὶ",707031,7],["φωνῆς",713640,17],["μεγάλης",708653,82],["καταιγὶς",707254,12],["φερομένη",713428,211],["καὶ",707031,7],["φλὸξ",713524,12],["πυρὸς",711088,21],["κατεσθίουσα",707519,188]],"from the Lord of hosts: for there shall be a visitation with thunder, and earthquake, and a loud noise, a rushing tempest, and devouring flame of fire."],["7",[["καὶ",707031,7],["ἔσται",704093,93],["ὡς",714148,28],["ὁ",709436,3],["ἐνυπνιαζόμενος",704815,122],["ἐν",704639,0],["ὕπνῳ",713181,114],["ὁ",709436,3],["πλοῦτος",710563,4],["τῶν",709436,43],["ἐθνῶν",704068,44],["πάντων",710177,83],["ὅσοι",709788,138],["ἐπεστράτευσαν",705275,150],["ἐπὶ",705080,0],["Αριηλ",701739,9],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["στρατευσάμενοι",712140,317],["ἐπὶ",705080,0],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["συνηγμένοι",712375,429],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["καὶ",707031,7],["θλίβοντες",706274,146],["αὐτήν",702165,104]],"And the wealth of all the nations together, as many as have fought against Ariel, and all they that war against Jerusalem, and all who are gathered against her, and they that distress her, shall be as one that dreams in sleep by night."],["8",[["καὶ",707031,7],["ἔσονται",704093,135],["ὡς",714148,28],["οἱ",709436,136],["ἐν",704639,0],["ὕπνῳ",713181,114],["πίνοντες",710478,146],["καὶ",707031,7],["ἔσθοντες",705495,146],["καὶ",707031,7],["ἐξαναστάντων",704865,196],["μάταιον",708575,26],["αὐτῶν",702165,40],["τὸ",709436,34],["ἐνύπνιον",704818,15],["καὶ",707031,7],["ὃν",709781,112],["τρόπον",712980,6],["ἐνυπνιάζεται",704815,117],["ὁ",709436,3],["διψῶν",703763,72],["ὡς",714148,28],["πίνων",710478,72],["καὶ",707031,7],["ἐξαναστὰς",704865,182],["ἔτι",705538,28],["διψᾷ",703763,91],["ἡ",709436,10],["δὲ",703303,11],["ψυχὴ",714070,12],["αὐτοῦ",702165,102],["εἰς",704105,0],["κενὸν",707612,27],["ἤλπισεν",704529,2],["οὕτως",709859,28],["ἔσται",704093,93],["ὁ",709436,3],["πλοῦτος",710563,4],["πάντων",710177,83],["τῶν",709436,43],["ἐθνῶν",704068,44],["ὅσοι",709788,138],["ἐπεστράτευσαν",705275,150],["ἐπὶ",705080,0],["τὸ",709436,24],["ὄρος",709768,25],["Σιων",711816,9]],"And as men drink and eat in sleep, and when they have arisen, the dream is vain: and as a thirsty man dreams as if he drank, and having arisen is still thirsty, and his soul has desired in vain: so shall be the wealth of all the nations, as many as have fought against the mount Sion."],["9",[["ἐκλύθητε",704254,394],["καὶ",707031,7],["ἔκστητε",704940,125],["καὶ",707031,7],["κραιπαλήσατε",707869,265],["οὐκ",709805,28],["ἀπὸ",701425,0],["σικερα",711781,25],["οὐδὲ",709816,7],["ἀπὸ",701425,0],["οἴνου",709530,18]],"Faint ye, and be amazed, and be overpowered, not with strong drink nor with wine."],["10",[["ὅτι",709803,7],["πεπότικεν",710700,171],["ὑμᾶς",713080,194],["κύριος",707996,4],["πνεύματι",710566,54],["κατανύξεως",707346,17],["καὶ",707031,7],["καμμύσει",707114,127],["τοὺς",709436,58],["ὀφθαλμοὺς",709870,57],["αὐτῶν",702165,40],["καὶ",707031,7],["τῶν",709436,80],["προφητῶν",711009,81],["αὐτῶν",702165,40],["καὶ",707031,7],["τῶν",709436,80],["ἀρχόντων",701862,81],["αὐτῶν",702165,40],["οἱ",709436,136],["ὁρῶντες",709725,146],["τὰ",709436,41],["κρυπτά",707922,68]],"For the Lord has made you to drink a spirit of deep sleep; and he shall close their eyes, and [the eyes] of their prophets and of their rulers, who see secret things."],["11",[["καὶ",707031,7],["ἔσονται",704093,135],["ὑμῖν",713084,90],["πάντα",710177,195],["τὰ",709436,63],["ῥήματα",711246,64],["ταῦτα",709858,290],["ὡς",714148,28],["οἱ",709436,136],["λόγοι",708236,52],["τοῦ",709436,20],["βιβλίου",702719,21],["τοῦ",709436,20],["ἐσφραγισμένου",712590,441],["τούτου",709858,102],["ὃ",709781,33],["ἐὰν",703912,7],["δῶσιν",703654,234],["αὐτὸ",702165,129],["ἀνθρώπῳ",701163,114],["ἐπισταμένῳ",705264,241],["γράμματα",703183,42],["λέγοντες",708124,146],["ἀνάγνωθι",700922,176],["ταῦτα",709858,71],["καὶ",707031,7],["ἐρεῖ",705415,127],["οὐ",709805,28],["δύναμαι",703838,254],["ἀναγνῶναι",700922,106],["ἐσφράγισται",712590,187],["γάρ",702963,11]],"And all these things shall be to you as the words of this sealed book, which if they shall give to a learned man, saying, Read this, he shall then say, I cannot read [it], for it is sealed."],["12",[["καὶ",707031,7],["δοθήσεται",703654,134],["τὸ",709436,34],["βιβλίον",702719,15],["τοῦτο",709858,132],["εἰς",704105,0],["χεῖρας",713787,39],["ἀνθρώπου",701163,18],["μὴ",708851,28],["ἐπισταμένου",705264,262],["γράμματα",703183,42],["καὶ",707031,7],["ἐρεῖ",705415,127],["αὐτῷ",702165,50],["ἀνάγνωθι",700922,176],["τοῦτο",709858,129],["καὶ",707031,7],["ἐρεῖ",705415,127],["οὐκ",709805,28],["ἐπίσταμαι",705264,254],["γράμματα",703183,42]],"And this book shall be given into the hands of a man that is unlearned, and [one] shall say to him, Read this; and he shall say, I am not learned."],["13",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["ἐγγίζει",703939,91],["μοι",708974,159],["ὁ",709436,3],["λαὸς",708094,4],["οὗτος",709858,121],["τοῖς",709436,95],["χείλεσιν",713781,96],["αὐτῶν",702165,40],["τιμῶσίν",712855,197],["με",708618,163],["ἡ",709436,10],["δὲ",703303,11],["καρδία",707141,12],["αὐτῶν",702165,40],["πόρρω",710680,28],["ἀπέχει",701405,91],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["μάτην",708582,28],["δὲ",703303,11],["σέβονταί",711609,269],["με",708618,163],["διδάσκοντες",703649,146],["ἐντάλματα",704785,42],["ἀνθρώπων",701163,81],["καὶ",707031,7],["διδασκαλίας",703647,39]],"And the Lord has said, This people draw nigh to me with their mouth, and they honour me with their lips, but their heart is far from me: but in vain do they worship me, teaching the commandments and doctrines of men."],["14",[["διὰ",703417,0],["τοῦτο",709858,129],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["προσθήσω",710965,165],["τοῦ",709436,20],["μεταθεῖναι",708820,106],["τὸν",709436,5],["λαὸν",708094,6],["τοῦτον",709858,85],["καὶ",707031,7],["μεταθήσω",708820,165],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἀπολῶ",701513,165],["τὴν",709436,8],["σοφίαν",711981,9],["τῶν",709436,80],["σοφῶν",711985,169],["καὶ",707031,7],["τὴν",709436,8],["σύνεσιν",712460,9],["τῶν",709436,80],["συνετῶν",712464,169],["κρύψω",707923,165]],"Therefore behold I will proceed to remove this people, and I will remove them: and I will destroy the wisdom of the wise, and will hide the understanding of the prudent."],["15",[["οὐαὶ",709807,88],["οἱ",709436,136],["βαθέως",702381,28],["βουλὴν",702792,9],["ποιοῦντες",710582,146],["καὶ",707031,7],["οὐ",709805,28],["διὰ",703417,0],["κυρίου",707996,18],["οὐαὶ",709807,88],["οἱ",709436,136],["ἐν",704639,0],["κρυφῇ",707929,28],["βουλὴν",702792,9],["ποιοῦντες",710582,146],["καὶ",707031,7],["ἔσται",704093,93],["ἐν",704639,0],["σκότει",711889,114],["τὰ",709436,63],["ἔργα",705396,64],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐροῦσιν",705415,218],["τίς",712867,158],["ἡμᾶς",705981,194],["ἑώρακεν",709725,171],["καὶ",707031,7],["τίς",712867,158],["ἡμᾶς",705981,194],["γνώσεται",703105,93],["ἢ",705924,7],["ἃ",709781,69],["ἡμεῖς",705983,219],["ποιοῦμεν",710582,243]],"Woe to them that deepen their counsel, and not by the Lord. Woe to them that take secret counsel, and whose works are in darkness, and they say, Who has seen us? and who shall know us, or what we do?"],["16",[["οὐχ",709805,28],["ὡς",714148,28],["ὁ",709436,3],["πηλὸς",710457,4],["τοῦ",709436,35],["κεραμέως",707619,18],["λογισθήσεσθε",708232,261],["μὴ",708851,28],["ἐρεῖ",705415,127],["τὸ",709436,34],["πλάσμα",710502,15],["τῷ",709436,113],["πλάσαντι",710503,350],["οὐ",709805,28],["σύ",712181,164],["με",708618,163],["ἔπλασας",710503,162],["ἢ",705924,7],["τὸ",709436,34],["ποίημα",710583,15],["τῷ",709436,113],["ποιήσαντι",710582,350],["οὐ",709805,28],["συνετῶς",712465,28],["με",708618,163],["ἐποίησας",710582,162]],"Shall ye not be counted as clay of the potter? Shall the thing formed say to him that formed it, Thou didst not form me? or the work to the maker, Thou hast not made me wisely?"],["17",[["οὐκέτι",709827,28],["μικρὸν",708915,27],["καὶ",707031,7],["μετατεθήσεται",708820,134],["ὁ",709436,3],["Λίβανος",708185,4],["ὡς",714148,28],["τὸ",709436,24],["ὄρος",709768,25],["τὸ",709436,24],["Χερμελ",713829,25],["καὶ",707031,7],["τὸ",709436,34],["ὄρος",709768,15],["τὸ",709436,34],["Χερμελ",713829,15],["εἰς",704105,0],["δρυμὸν",703836,6],["λογισθήσεται",708232,134]],"[Is it] not yet a little while, and Libanus shall be changed as the mountain of Chermel, and Chermel shall be reckoned as a forest?"],["18",[["καὶ",707031,7],["ἀκούσονται",700587,135],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["κωφοὶ",708033,138],["λόγους",708236,57],["βιβλίου",702719,21],["καὶ",707031,7],["οἱ",709436,136],["ἐν",704639,0],["τῷ",709436,113],["σκότει",711889,114],["καὶ",707031,7],["οἱ",709436,136],["ἐν",704639,0],["τῇ",709436,100],["ὁμίχλῃ",709615,1],["ὀφθαλμοὶ",709870,52],["τυφλῶν",713031,169],["βλέψονται",702740,135]],"And in that day the deaf shall hear the words of the book, and they that are in darkness, and they that are in mist: the eyes of the blind shall see,"],["19",[["καὶ",707031,7],["ἀγαλλιάσονται",700114,135],["πτωχοὶ",711076,52],["διὰ",703417,0],["κύριον",707996,6],["ἐν",704639,0],["εὐφροσύνῃ",705717,1],["καὶ",707031,7],["οἱ",709436,136],["ἀπηλπισμένοι",701388,317],["τῶν",709436,80],["ἀνθρώπων",701163,81],["ἐμπλησθήσονται",704592,144],["εὐφροσύνης",705717,17]],"and the poor shall rejoice with joy because of the Lord, and they that had no hope among men shall be filled with joy."],["20",[["ἐξέλιπεν",704237,2],["ἄνομος",701194,14],["καὶ",707031,7],["ἀπώλετο",701513,23],["ὑπερήφανος",713139,14],["καὶ",707031,7],["ἐξωλεθρεύθησαν",704956,99],["οἱ",709436,136],["ἀνομοῦντες",701190,651],["ἐπὶ",705080,0],["κακίᾳ",707054,1]],"The lawless man has come to nought, and the proud man has perished, and they that transgress mischievously have been utterly destroyed:"],["21",[["καὶ",707031,7],["οἱ",709436,136],["ποιοῦντες",710582,146],["ἁμαρτεῖν",700773,106],["ἀνθρώπους",701163,57],["ἐν",704639,0],["λόγῳ",708236,114],["πάντας",710177,60],["δὲ",703303,11],["τοὺς",709436,58],["ἐλέγχοντας",704416,235],["ἐν",704639,0],["πύλαις",711082,76],["πρόσκομμα",710922,25],["θήσουσιν",712849,218],["καὶ",707031,7],["ἐπλαγίασαν",710494,150],["ἐν",704639,0],["ἀδίκοις",700272,230],["δίκαιον",703694,27]],"and they that cause men to sin by a word: and men shall make all that reprove in the gates an offence, because they have unjustly turned aside the righteous."],["22",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἐπὶ",705080,0],["τὸν",709436,5],["οἶκον",709516,6],["Ιακωβ",706401,18],["ὃν",709781,112],["ἀφώρισεν",702227,2],["ἐξ",704132,0],["Αβρααμ",700091,18],["οὐ",709805,28],["νῦν",709384,28],["αἰσχυνθήσεται",700485,134],["Ιακωβ",706401,4],["οὐδὲ",709816,7],["νῦν",709384,28],["τὸ",709436,24],["πρόσωπον",710986,25],["μεταβαλεῖ",708782,127],["Ισραηλ",706839,18]],"Therefore thus saith the Lord concerning the house of Jacob, whom he set apart from Abraam, Jacob shall not now be ashamed, neither shall he now change countenance."],["23",[["ἀλλ᾿",700680,7],["ὅταν",709801,28],["ἴδωσιν",709725,234],["τὰ",709436,63],["τέκνα",712761,64],["αὐτῶν",702165,40],["τὰ",709436,41],["ἔργα",705396,42],["μου",709032,133],["δι᾿",703417,0],["ἐμὲ",704555,163],["ἁγιάσουσιν",700153,218],["τὸ",709436,24],["ὄνομά",709666,25],["μου",709032,133],["καὶ",707031,7],["ἁγιάσουσιν",700153,218],["τὸν",709436,5],["ἅγιον",700159,27],["Ιακωβ",706401,18],["καὶ",707031,7],["τὸν",709436,5],["θεὸν",706192,6],["τοῦ",709436,35],["Ισραηλ",706839,18],["φοβηθήσονται",713532,144]],"But when their children shall have seen my works, they shall sanctify my name for my sake, and they shall sanctify the Holy One of Jacob, and shall fear the God of Israel."],["24",[["καὶ",707031,7],["γνώσονται",703105,135],["οἱ",709436,136],["τῷ",709436,53],["πνεύματι",710566,54],["πλανώμενοι",710495,348],["σύνεσιν",712460,9],["οἱ",709436,136],["δὲ",703303,11],["γογγύζοντες",703144,146],["μαθήσονται",708480,135],["ὑπακούειν",713096,55],["καὶ",707031,7],["αἱ",709436,190],["γλώσσαι",703120,191],["αἱ",709436,190],["ψελλίζουσαι",714035,306],["μαθήσονται",708480,135],["λαλεῖν",708071,55],["εἰρήνην",704098,9]],"And they that erred in spirit shall know understanding, and the murmurers shall learn obedience, and the stammering tongues shall learn to speak peace."]]