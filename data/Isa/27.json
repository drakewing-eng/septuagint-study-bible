[["1",[["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἐπάξει",704994,127],["ὁ",709436,3],["θεὸς",706192,4],["τὴν",709436,8],["μάχαιραν",708593,9],["τὴν",709436,8],["ἁγίαν",700159,36],["καὶ",707031,7],["τὴν",709436,8],["μεγάλην",708653,36],["καὶ",707031,7],["τὴν",709436,8],["ἰσχυρὰν",706855,36],["ἐπὶ",705080,0],["τὸν",709436,5],["δράκοντα",703822,6],["ὄφιν",709875,6],["φεύγοντα",713433,183],["ἐπὶ",705080,0],["τὸν",709436,5],["δράκοντα",703822,6],["ὄφιν",709875,6],["σκολιὸν",711868,27],["καὶ",707031,7],["ἀνελεῖ",700962,127],["τὸν",709436,5],["δράκοντα",703822,6]],"In that day God shall bring [his] holy and great and strong sword upon the dragon, even the serpent that flees, upon the dragon, the crooked serpent: he shall destroy the dragon."],["2",[["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἀμπελὼν",700872,4],["καλός",707097,14],["ἐπιθύμημα",705142,25],["ἐξάρχειν",704883,55],["κατ᾿",707200,0],["αὐτῆς",702165,86]],"In that day [there shall be] a fair vineyard, [and] a desire to commence [a song] concerning it."],["3",[["ἐγὼ",704018,164],["πόλις",710612,12],["ἰσχυρά",706855,29],["πόλις",710612,12],["πολιορκουμένη",710608,211],["μάτην",708582,28],["ποτιῶ",710700,165],["αὐτήν",702165,104],["ἁλώσεται",700673,93],["γὰρ",702963,11],["νυκτός",709386,17],["ἡμέρας",705984,17],["δὲ",703303,11],["πεσεῖται",710481,93],["τὸ",709436,24],["τεῖχος",712759,15]],"I am a strong city, a city in a siege: in vain shall I water it; for it shall be taken by night, and by day the wall shall fall."],["4",[["οὐκ",709805,28],["ἔστιν",704093,91],["ἣ",709781,177],["οὐκ",709805,28],["ἐπελάβετο",705185,23],["αὐτῆς",702165,86],["τίς",712867,158],["με",708618,163],["θήσει",712849,127],["φυλάσσειν",713619,55],["καλάμην",707079,9],["ἐν",704639,0],["ἀγρῷ",700196,114],["διὰ",703417,0],["τὴν",709436,8],["πολεμίαν",710603,36],["ταύτην",709858,104],["ἠθέτηκα",712849,89],["αὐτήν",702165,104],["τοίνυν",712875,11],["διὰ",703417,0],["τοῦτο",709858,129],["ἐποίησεν",710582,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["πάντα",710177,68],["ὅσα",709788,68],["συνέταξεν",712508,2],["κατακέκαυμαι",707258,326]],"There is no woman that has not taken hold of it; who will set me to watch stubble in the field? because of this enemy I have set her aside; therefore on this account the Lord has done all that he appointed."],["5",[["βοήσονται",702743,135],["οἱ",709436,136],["ἐνοικοῦντες",704772,146],["ἐν",704639,0],["αὐτῇ",702165,105],["ποιήσωμεν",710582,79],["εἰρήνην",704098,9],["αὐτῷ",702165,50],["ποιήσωμεν",710582,79],["εἰρήνην",704098,9]],"I am burnt up; they that dwell in her shall cry, Let us make peace with him, let us make peace,"],["6",[["οἱ",709436,136],["ἐρχόμενοι",705453,348],["τέκνα",712761,64],["Ιακωβ",706401,18],["βλαστήσει",702733,127],["καὶ",707031,7],["ἐξανθήσει",704864,127],["Ισραηλ",706839,4],["καὶ",707031,7],["ἐμπλησθήσεται",704592,134],["ἡ",709436,10],["οἰκουμένη",709517,211],["τοῦ",709436,35],["καρποῦ",707169,18],["αὐτοῦ",702165,102]],"they that are coming are the children of Jacob. Israel shall bud and blossom, and the world shall be filled with his fruit."],["7",[["μὴ",708851,28],["ὡς",714148,28],["αὐτὸς",702165,121],["ἐπάταξεν",710185,2],["καὶ",707031,7],["αὐτὸς",702165,121],["οὕτως",709859,28],["πληγήσεται",710550,134],["καὶ",707031,7],["ὡς",714148,28],["αὐτὸς",702165,121],["ἀνεῖλεν",700962,2],["οὕτως",709859,28],["ἀναιρεθήσεται",700962,134]],"Shall he himself be thus smitten, even as he smote? and as he slew, shall he be thus slain?"],["8",[["μαχόμενος",708610,122],["καὶ",707031,7],["ὀνειδίζων",709655,72],["ἐξαποστελεῖ",704872,127],["αὐτούς",702165,62],["οὐ",709805,28],["σὺ",712181,164],["ἦσθα",704093,363],["ὁ",709436,3],["μελετῶν",708698,72],["τῷ",709436,53],["πνεύματι",710566,54],["τῷ",709436,53],["σκληρῷ",711861,97],["ἀνελεῖν",700962,106],["αὐτοὺς",702165,62],["πνεύματι",710566,54],["θυμοῦ",706334,18]],"Fighting and reproaching he will dismiss them; didst thou not meditate with a harsh spirit, to slay them with a wrathful spirit?"],["9",[["διὰ",703417,0],["τοῦτο",709858,129],["ἀφαιρεθήσεται",702177,134],["ἡ",709436,10],["ἀνομία",701192,12],["Ιακωβ",706401,18],["καὶ",707031,7],["τοῦτό",709858,129],["ἐστιν",704093,91],["ἡ",709436,10],["εὐλογία",705633,12],["αὐτοῦ",702165,102],["ὅταν",709801,28],["ἀφέλωμαι",702177,410],["αὐτοῦ",702165,102],["τὴν",709436,8],["ἁμαρτίαν",700775,9],["ὅταν",709801,28],["θῶσιν",712849,234],["πάντας",710177,60],["τοὺς",709436,58],["λίθους",708196,57],["τῶν",709436,80],["βωμῶν",702840,81],["κατακεκομμένους",707285,360],["ὡς",714148,28],["κονίαν",707811,9],["λεπτήν",708153,36],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["μείνῃ",708736,172],["τὰ",709436,63],["δένδρα",703353,64],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,63],["εἴδωλα",704079,64],["αὐτῶν",702165,40],["ἐκκεκομμένα",704225,388],["ὥσπερ",714163,28],["δρυμὸς",703836,4],["μακράν",708411,28]],"Therefore shall the iniquity of Jacob be taken away; and this is his blessing, when I shall have taken away his sin; when they shall have broken to pieces all the stones of the altars as fine dust, and their trees shall not remain, and their idols shall be cut off, as a thicket afar off."],["10",[["τὸ",709436,34],["κατοικούμενον",707534,208],["ποίμνιον",710598,15],["ἀνειμένον",701169,439],["ἔσται",704093,93],["ὡς",714148,28],["ποίμνιον",710598,25],["καταλελειμμένον",707305,414],["καὶ",707031,7],["ἔσται",704093,93],["πολὺν",710646,27],["χρόνον",713969,6],["εἰς",704105,0],["βόσκημα",702766,25],["καὶ",707031,7],["ἐκεῖ",704181,28],["ἀναπαύσονται",701027,135]],"The flock that dwelt [there] shall be left, as a deserted flock; and [the ground] shall be for a long time for pasture, and there shall flocks lie down to rest."],["11",[["καὶ",707031,7],["μετὰ",708780,0],["χρόνον",713969,6],["οὐκ",709805,28],["ἔσται",704093,93],["ἐν",704639,0],["αὐτῇ",702165,105],["πᾶν",710177,46],["χλωρὸν",713880,46],["διὰ",703417,0],["τὸ",709436,24],["ξηρανθῆναι",709419,179],["γυναῖκες",703209,191],["ἐρχόμεναι",705453,305],