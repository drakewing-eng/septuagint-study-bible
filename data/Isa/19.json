[["1",[["ὅρασις",709721,12],["Αἰγύπτου",700401,17],["ἰδοὺ",706497,88],["κύριος",707996,4],["κάθηται",707000,117],["ἐπὶ",705080,0],["νεφέλης",709277,17],["κούφης",707863,82],["καὶ",707031,7],["ἥξει",705956,127],["εἰς",704105,0],["Αἴγυπτον",700401,9],["καὶ",707031,7],["σεισθήσεται",711633,134],["τὰ",709436,41],["χειροποίητα",713796,68],["Αἰγύπτου",700401,17],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἡ",709436,10],["καρδία",707141,12],["αὐτῶν",702165,40],["ἡττηθήσεται",706040,134],["ἐν",704639,0],["αὐτοῖς",702165,151]],"The Vision of Egypt. Behold, the Lord sits on a swift cloud, and shall come to Egypt: and the idols of Egypt shall be moved at his presence, and their heart shall faint within them."],["2",[["καὶ",707031,7],["ἐπεγερθήσονται",705053,144],["Αἰγύπτιοι",700400,52],["ἐπ᾿",705080,0],["Αἰγυπτίους",700400,57],["καὶ",707031,7],["πολεμήσει",710601,127],["ἄνθρωπος",701163,4],["τὸν",709436,5],["ἀδελφὸν",700249,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἄνθρωπος",701163,4],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102],["πόλις",710612,12],["ἐπὶ",705080,0],["πόλιν",710612,9],["καὶ",707031,7],["νομὸς",709349,4],["ἐπὶ",705080,0],["νομόν",709348,6]],"And the Egyptians shall be stirred up against the Egyptians: and a man shall fight against his brother, and a man against his neighbour, city against city, and law against law."],["3",[["καὶ",707031,7],["ταραχθήσεται",712721,134],["τὸ",709436,34],["πνεῦμα",710566,15],["τῶν",709436,80],["Αἰγυπτίων",700400,81],["ἐν",704639,0],["αὐτοῖς",702165,151],["καὶ",707031,7],["τὴν",709436,8],["βουλὴν",702792,9],["αὐτῶν",702165,40],["διασκεδάσω",703575,165],["καὶ",707031,7],["ἐπερωτήσουσιν",705069,218],["τοὺς",709436,58],["θεοὺς",706192,57],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,41],["ἀγάλματα",700116,42],["αὐτῶν",702165,40],["καὶ",707031,7],["τοὺς",709436,58],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17],["φωνοῦντας",713639,235],["καὶ",707031,7],["τοὺς",709436,58],["ἐγγαστριμύθους",703938,60]],"And the spirit of the Egyptians shall be troubled within them; and I will frustrate their counsel: and they shall enquire of their gods and their images, and them that speak out of the earth, and them that have in them a divining spirit."],["4",[["καὶ",707031,7],["παραδώσω",710014,165],["Αἴγυπτον",700401,9],["εἰς",704105,0],["χεῖρας",713787,39],["ἀνθρώπων",701163,81],["κυρίων",707996,81],["σκληρῶν",711861,169],["καὶ",707031,7],["βασιλεῖς",702580,52],["σκληροὶ",711861,138],["κυριεύσουσιν",707995,218],["αὐτῶν",702165,40],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["σαβαωθ",711346,228]],"And I will deliver Egypt into the hands of men, of cruel lords; and cruel kings shall rule over them: thus saith the Lord of hosts."],["5",[["καὶ",707031,7],["πίονται",710478,135],["οἱ",709436,136],["Αἰγύπτιοι",700400,52],["ὕδωρ",713071,25],["τὸ",709436,24],["παρὰ",709995,0],["θάλασσαν",706069,9],["ὁ",709436,3],["δὲ",703303,11],["ποταμὸς",710693,4],["ἐκλείψει",704237,127],["καὶ",707031,7],["ξηρανθήσεται",709419,134]],"And the Egyptians shall drink the water that is by the sea, but the river shall fail, and be dried up."],["6",[["καὶ",707031,7],["ἐκλείψουσιν",704237,218],["οἱ",709436,136],["ποταμοὶ",710693,52],["καὶ",707031,7],["αἱ",709436,190],["διώρυγες",703770,191],["τοῦ",709436,35],["ποταμοῦ",710693,18],["καὶ",707031,7],["ξηρανθήσεται",709419,134],["πᾶσα",710177,29],["συναγωγὴ",712376,12],["ὕδατος",713071,21],["καὶ",707031,7],["ἐν",704639,0],["παντὶ",710177,97],["ἕλει",704527,54],["καλάμου",707082,18],["καὶ",707031,7],["παπύρου",709994,18]],"And the streams shall fail, and the canals of the river; and every reservoir of water shall be dried up, in every marsh also of reed and papyrus."],["7",[["καὶ",707031,7],["τὸ",709436,24],["ἄχι",702261,25],["τὸ",709436,24],["χλωρὸν",713880,46],["πᾶν",710177,26],["τὸ",709436,24],["κύκλῳ",707959,114],["τοῦ",709436,35],["ποταμοῦ",710693,18],["καὶ",707031,7],["πᾶν",710177,46],["τὸ",709436,24],["σπειρόμενον",712006,214],["διὰ",703417,0],["τοῦ",709436,35],["ποταμοῦ",710693,18],["ξηρανθήσεται",709419,134],["ἀνεμόφθορον",701125,46]],"And all the green herbage round about the river, and everything sown by the side of the river, shall be blasted with the wind and dried up."],["8",[["καὶ",707031,7],["στενάξουσιν",712066,218],["οἱ",709436,136],["ἁλεεῖς",700665,52],["καὶ",707031,7],["στενάξουσιν",712066,218],["πάντες",710177,138],["οἱ",709436,136],["βάλλοντες",702487,146],["ἄγκιστρον",700164,25],["εἰς",704105,0],["τὸν",709436,5],["ποταμόν",710693,6],["καὶ",707031,7],["οἱ",709436,136],["βάλλοντες",702487,146],["σαγήνας",711365,39],["καὶ",707031,7],["οἱ",709436,136],["ἀμφιβολεῖς",700885,52],["πενθήσουσιν",710251,218]],"And the fishermen shall groan, and all that cast a hook into the river shall groan; they also that cast nets, and the anglers shall mourn."],["9",[["καὶ",707031,7],["αἰσχύνη",700483,12],["λήμψεται",708076,93],["τοὺς",709436,58],["ἐργαζομένους",705383,236],["τὸ",709436,24],["λίνον",708213,25],["τὸ",709436,24],["σχιστὸν",712609,46],["καὶ",707031,7],["τοὺς",709436,58],["ἐργαζομένους",705383,236],["τὴν",709436,8],["βύσσον",702834,9]],"And shame shall come upon them that work fine flax, and them that make fine linen."],["10",[["καὶ",707031,7],["ἔσονται",704093,135],["οἱ",709436,136],["διαζόμενοι",703453,348],["αὐτὰ",702165,71],["ἐν",704639,0],["ὀδύνῃ",709463,1],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["τὸν",709436,5],["ζῦθον",705896,6],["ποιοῦντες",710582,146],["λυπηθήσονται",708272,144],["καὶ",707031,7],["τὰς",709436,38],["ψυχὰς",714070,39],["πονέσουσιν",710656,218]],"And they that work at them shall be in pain, and all that make beer shall be grieved, and be pained in their souls."],["11",[["καὶ",707031,7],["μωροὶ",709110,138],["ἔσονται",704093,135],["οἱ",709436,136],["ἄρχοντες",701862,52],["Τάνεως",712708,17],["οἱ",709436,136],["σοφοὶ",711985,138],["σύμβουλοι",712295,52],["τοῦ",709436,35],["βασιλέως",702580,18],["ἡ",709436,10],["βουλὴ",702792,12],["αὐτῶν",702165,40],["μωρανθήσεται",709105,134],["πῶς",711121,28],["ἐρεῖτε",705415,337],["τῷ",709436,113],["βασιλεῖ",702580,114],["υἱοὶ",713075,52],["συνετῶν",712464,169],["ἡμεῖς",705983,219],["υἱοὶ",713075,52],["βασιλέων",702580,81],["τῶν",709436,80],["ἐξ",704132,0],["ἀρχῆς",701836,17]],"And the princes of Tanis shall be fools: [as for] the king's wise counsellors, their counsel shall be turned into folly: how will ye say to the king, We are sons of wise men, sons of ancient kings?"],["12",[["ποῦ",710706,28],["εἰσιν",704093,197],["νῦν",709384,28],["οἱ",709436,136],["σοφοί",711985,138],["σου",711945,133],["καὶ",707031,7],["ἀναγγειλάτωσάν",700921,264],["σοι",711925,159],["καὶ",707031,7],["εἰπάτωσαν",705373,264],["τί",712867,126],["βεβούλευται",702791,187],["κύριος",707996,4],["σαβαωθ",711346,228],["ἐπ᾿",705080,0],["Αἴγυπτον",700401,9]],"Where are now thy wise men? and let them declare to thee, and say, What has the Lord of hosts purposed upon Egypt?"],["13",[["ἐξέλιπον",704237,150],["οἱ",709436,136],["ἄρχοντες",701862,52],["Τάνεως",712708,17],["καὶ",707031,7],["ὑψώθησαν",713289,99],["οἱ",709436,136],["ἄρχοντες",701862,52],["Μέμφεως",708727,17],["καὶ",707031,7],["πλανήσουσιν",710495,218],["Αἴγυπτον",700401,9],["κατὰ",707200,0],["φυλάς",713620,39]],"The princes of Tanis have failed, and the princes of Memphis are lifted up [with pride], and they shall cause Egypt to wander by tribes."],["14",[["κύριος",707996,4],["γὰρ",702963,11],["ἐκέρασεν",707623,2],["αὐτοῖς",702165,151],["πνεῦμα",710566,25],["πλανήσεως",710497,17],["καὶ",707031,7],["ἐπλάνησαν",710495,150],["Αἴγυπτον",700401,9],["ἐν",704639,0],["πᾶσι",710177,94],["τοῖς",709436,95],["ἔργοις",705396,96],["αὐτῶν",702165,284],["ὡς",714148,28],["πλανᾶται",710495,117],["ὁ",709436,3],["μεθύων",708676,72],["καὶ",707031,7],["ὁ",709436,3],["ἐμῶν",704578,169],["ἅμα",700745,28]],"For the Lord has prepared for them a spirit of error, and they have caused Egypt to err in all their works, as one staggers who is drunken and vomits also."],["15",[["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["τοῖς",709436,147],["Αἰγυπτίοις",700400,148],["ἔργον",705396,25],["ὃ",709781,213],["ποιήσει",710582,127],["κεφαλὴν",707639,9],["καὶ",707031,7],["οὐράν",709839,9],["ἀρχὴν",701836,9],["καὶ",707031,7],["τέλος",712787,25]],"And there shall be no work to the Egyptians, which shall make head or tail, or beginning or end."],["16",[["τῇ",709436,100],["δὲ",703303,11],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἔσονται",704093,135],["οἱ",709436,136],["Αἰγύπτιοι",700400,52],["ὡς",714148,7],["γυναῖκες",703209,191],["ἐν",704639,0],["φόβῳ",713534,114],["καὶ",707031,7],["ἐν",704639,0],["τρόμῳ",712975,114],["ἀπὸ",701425,0],["προσώπου",710986,21],["τῆς",709436,16],["χειρὸς",713787,17],["κυρίου",707996,18],["σαβαωθ",711346,228],["ἣν",709781,131],["αὐτὸς",702165,121],["ἐπιβαλεῖ",705083,127],["αὐτοῖς",702165,151]],"But in that day the Egyptians shall be as women, in fear and in trembling because of the hand of the Lord of hosts, which he shall bring upon them."],["17",[["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["χώρα",714011,12],["τῶν",709436,80],["Ιουδαίων",706772,81],["τοῖς",709436,147],["Αἰγυπτίοις",700400,148],["εἰς",704105,0],["φόβητρον",713533,25],["πᾶς",710177,14],["ὃς",709781,213],["ἐὰν",703912,7],["ὀνομάσῃ",709667,172],["αὐτὴν",702165,104],["αὐτοῖς",702165,151],["φοβηθήσονται",713532,144],["διὰ",703417,0],["τὴν",709436,8],["βουλήν",702792,9],["ἣν",709781,131],["βεβούλευται",702791,187],["κύριος",707996,4],["ἐπ᾿",705080,0],["αὐτήν",702165,104]],"And the land of the Jews shall be for a terror to the Egyptians: whosoever shall name it to them, they shall fear, because of the counsel which the Lord of hosts has purposed concerning it."],["18",[["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἔσονται",704093,135],["πέντε",710266,59],["πόλεις",710612,191],["ἐν",704639,0],["Αἰγύπτῳ",700401,1],["λαλοῦσαι",708071,306],["τῇ",709436,100],["γλώσσῃ",703120,1],["τῇ",709436,100],["Χανανίτιδι",713715,1],["καὶ",707031,7],["ὀμνύουσαι",709620,306],["τῷ",709436,113],["ὀνόματι",709666,54],["κυρίου",707996,18],["πόλιςασεδεκ",710612,12],["κληθήσεται",707084,134],["ἡ",709436,10],["μία",704106,29],["πόλις",710612,12]],"In that day there shall be five cities in Egypt speaking the language of Chanaan, and swearing by the name of the Lord of hosts; one city shall be called the city of Asedec."],["19",[["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἔσται",704093,93],["θυσιαστήριον",706348,15],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐν",704639,0],["χώρᾳ",714011,1],["Αἰγυπτίων",700400,81],["καὶ",707031,7],["στήλη",712092,12],["πρὸς",710844,0],["τὸ",709436,24],["ὅριον",709749,25],["αὐτῆς",702165,86],["τῷ",709436,113],["κυρίῳ",707996,114]],"In that day there shall be an altar to the Lord in the land of the Egyptians, and a pillar to the Lord by its border."],["20",[["καὶ",707031,7],["ἔσται",704093,93],["εἰς",704105,0],["σημεῖον",711748,25],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["κυρίῳ",707996,114],["ἐν",704639,0],["χώρᾳ",714011,1],["Αἰγύπτου",700401,17],["ὅτι",709803,7],["κεκράξονται",707868,135],["πρὸς",710844,0],["κύριον",707996,6],["διὰ",703417,0],["τοὺς",709436,58],["θλίβοντας",706274,235],["αὐτούς",702165,62],["καὶ",707031,7],["ἀποστελεῖ",701592,127],["αὐτοῖς",702165,151],["κύριος",707996,4],["ἄνθρωπον",701163,6],["ὃς",709781,213],["σώσει",712627,127],["αὐτούς",702165,62],["κρίνων",707905,72],["σώσει",712627,127],["αὐτούς",702165,62]],"And it shall be for a sign to the Lord for ever in the land of Egypt: for they shall presently cry to the Lord by reason of them that afflict them, and he shall send them a man who shall save them; he shall judge and save them."],["21",[["καὶ",707031,7],["γνωστὸς",703141,14],["ἔσται",704093,93],["κύριος",707996,4],["τοῖς",709436,147],["Αἰγυπτίοις",700400,148],["καὶ",707031,7],["γνώσονται",703105,135],["οἱ",709436,136],["Αἰγύπτιοι",700400,52],["τὸν",709436,5],["κύριον",707996,6],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["καὶ",707031,7],["ποιήσουσιν",710582,218],["θυσίας",706345,39],["καὶ",707031,7],["εὔξονται",705727,135],["εὐχὰς",705726,39],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["ἀποδώσουσιν",701449,218]],"And the Lord shall be known to the Egyptians, and the Egyptians shall know the Lord in that day; and they shall offer sacrifices, and shall vow vows to the Lord, and pay [them]."],["22",[["καὶ",707031,7],["πατάξει",710185,127],["κύριος",707996,4],["τοὺς",709436,58],["Αἰγυπτίους",700400,57],["πληγῇ",710527,1],["μεγάλῃ",708653,101],["καὶ",707031,7],["ἰάσεται",706424,127],["αὐτοὺς",702165,62],["ἰάσει",706444,1],["καὶ",707031,7],["ἐπιστραφήσονται",705278,144],["πρὸς",710844,0],["κύριον",707996,6],["καὶ",707031,7],["εἰσακούσεται",704108,93],["αὐτῶν",702165,40],["καὶ",707031,7],["ἰάσεται",706424,93],["αὐτούς",702165,62]],"And the Lord shall smite the Egyptians with a stroke, and shall completely heal them: and they shall return to the Lord, and he shall hear them, and thoroughly heal them."],["23",[["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἔσται",704093,93],["ὁδὸς",709458,12],["Αἰγύπτου",700401,17],["πρὸς",710844,0],["Ἀσσυρίους",702004,57],["καὶ",707031,7],["εἰσελεύσονται",704114,135],["Ἀσσύριοι",702004,52],["εἰς",704105,0],["Αἴγυπτον",700401,9],["καὶ",707031,7],["Αἰγύπτιοι",700400,52],["πορεύσονται",710667,135],["πρὸς",710844,0],["Ἀσσυρίους",702004,57],["καὶ",707031,7],["δουλεύσουσιν",703814,218],["οἱ",709436,136],["Αἰγύπτιοι",700400,52],["τοῖς",709436,147],["Ἀσσυρίοις",702004,148]],"In that day there shall be a way from Egypt to the Assyrians, and the Assyrians shall enter into Egypt, and the Egyptians shall go to the Assyrians, and the Egyptians shall serve the Assyrians."],["24",[["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἔσται",704093,93],["Ισραηλ",706839,4],["τρίτος",712968,14],["ἐν",704639,0],["τοῖς",709436,147],["Ἀσσυρίοις",702004,148],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["Αἰγυπτίοις",700400,148],["εὐλογημένος",705631,419],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1]],"In that day shall Israel be third with the Egyptians and the Assyrians, blessed in the land which the Lord of hosts has blessed,"],["25",[["ἣν",709781,131],["εὐλόγησεν",705631,2],["κύριος",707996,4],["σαβαωθ",711346,228],["λέγων",708124,72],["εὐλογημένος",705631,251],["ὁ",709436,3],["λαός",708094,4],["μου",709032,133],["ὁ",709436,3],["ἐν",704639,0],["Αἰγύπτῳ",700401,1],["καὶ",707031,7],["ὁ",709436,3],["ἐν",704639,0],["Ἀσσυρίοις",702004,148],["καὶ",707031,7],["ἡ",709436,10],["κληρονομία",707725,12],["μου",709032,133],["Ισραηλ",706839,6]],"saying, Blessed be my people that is in Egypt, and that is among the Assyrians, and Israel mine inheritance."]]