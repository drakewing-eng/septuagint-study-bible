[["1",[["ἀκούσατε",700587,74],["ταῦτα",709858,71],["οἶκος",709516,4],["Ιακωβ",706401,18],["οἱ",709436,136],["κεκλημένοι",707084,429],["τῷ",709436,53],["ὀνόματι",709666,54],["Ισραηλ",706839,18],["καὶ",707031,7],["οἱ",709436,136],["ἐξ",704132,0],["Ιουδα",706768,18],["ἐξελθόντες",704909,196],["οἱ",709436,136],["ὀμνύοντες",709620,146],["τῷ",709436,113],["ὀνόματι",709666,54],["κυρίου",707996,18],["θεοῦ",706192,18],["Ισραηλ",706839,18],["μιμνῃσκόμενοι",708923,348],["οὐ",709805,28],["μετὰ",708780,0],["ἀληθείας",700656,17],["οὐδὲ",709816,7],["μετὰ",708780,0],["δικαιοσύνης",703695,17]],"Hear these [words], ye house of Jacob, who are called by the name of Israel, and have come forth out of Juda, who swear by the name of the Lord God of Israel, making mention [of it, but] not with truth, nor with righteousness;"],["2",[["καὶ",707031,7],["ἀντεχόμενοι",701225,348],["τῷ",709436,53],["ὀνόματι",709666,54],["τῆς",709436,16],["πόλεως",710612,17],["τῆς",709436,16],["ἁγίας",700159,82],["καὶ",707031,7],["ἐπὶ",705080,0],["τῷ",709436,113],["θεῷ",706192,114],["τοῦ",709436,35],["Ισραηλ",706839,18],["ἀντιστηριζόμενοι",701275,348],["κύριος",707996,4],["σαβαωθ",711346,228],["ὄνομα",709666,15],["αὐτῷ",702165,50]],"maintaining also the name of the holy city, and staying themselves on the God of Israel: the Lord of hosts is his name. The former things I have already declared;"],["3",[["τὰ",709436,41],["πρότερα",710992,68],["ἔτι",705538,28],["ἀνήγγειλα",700921,155],["καὶ",707031,7],["ἐκ",704132,0],["τοῦ",709436,20],["στόματός",712125,21],["μου",709032,133],["ἐξῆλθεν",704909,2],["καὶ",707031,7],["ἀκουστὸν",700584,27],["ἐγένετο",703104,23],["ἐξάπινα",704868,28],["ἐποίησα",710582,155],["καὶ",707031,7],["ἐπῆλθεν",705068,2]],"and they have proceeded out of my mouth, and it became well known; I wrought suddenly, and [the events] came to pass."],["4",[["γινώσκω",703105,157],["ἐγὼ",704018,164],["ὅτι",709803,7],["σκληρὸς",711861,14],["εἶ",704093,154],["καὶ",707031,7],["νεῦρον",709275,15],["σιδηροῦν",711771,26],["ὁ",709436,3],["τράχηλός",712924,4],["σου",711945,133],["καὶ",707031,7],["τὸ",709436,34],["μέτωπόν",708847,15],["σου",711945,133],["χαλκοῦν",713690,26]],"I know that thou art stubborn, and thy neck is an iron sinew, and thy forehead brazen."],["5",[["καὶ",707031,7],["ἀνήγγειλά",700921,155],["σοι",711925,159],["πάλαι",709935,28],["πρὶν",710742,28],["ἐλθεῖν",705453,106],["ἐπὶ",705080,0],["σὲ",711598,163],["ἀκουστόν",700584,27],["σοι",711925,159],["ἐποίησα",710582,155],["μὴ",708851,28],["εἴπῃς",705373,175],["ὅτι",709803,7],["τὰ",709436,63],["εἴδωλά",704079,64],["μου",709032,133],["ἐποίησαν",710582,150],["καὶ",707031,7],["μὴ",708851,28],["εἴπῃς",705373,175],["ὅτι",709803,7],["τὰ",709436,63],["γλυπτὰ",703117,195],["καὶ",707031,7],["τὰ",709436,63],["χωνευτὰ",714009,195],["ἐνετείλατό",704791,23],["μοι",708974,159]],"And I told thee of old what [should be] before it came upon thee; I made it known to thee, lest thou shouldest say, [My] idols have done [it] for me; and shouldest say, [My] graven and molten images have commanded me."],["6",[["ἠκούσατε",700587,265],["πάντα",710177,195],["καὶ",707031,7],["ὑμεῖς",713081,219],["οὐκ",709805,28],["ἔγνωτε",703105,265],["ἀλλὰ",700680,7],["καὶ",707031,7],["ἀκουστά",700584,68],["σοι",711925,159],["ἐποίησα",710582,155],["τὰ",709436,41],["καινὰ",707042,68],["ἀπὸ",701425,0],["τοῦ",709436,35],["νῦν",709384,28],["ἃ",709781,69],["μέλλει",708705,91],["γίνεσθαι",703104,110],["καὶ",707031,7],["οὐκ",709805,28],["εἶπας",705373,162]],"Ye have heard all this, but ye have not known: yet I have made known to thee the new things from henceforth, which are coming to pass, and thou saidst not,"],["7",[["νῦν",709384,28],["γίνεται",703104,117],["καὶ",707031,7],["οὐ",709805,28],["πάλαι",709935,28],["καὶ",707031,7],["οὐ",709805,28],["προτέραις",710992,291],["ἡμέραις",705984,76],["ἤκουσας",700587,162],["αὐτά",702165,71],["μὴ",708851,28],["εἴπῃς",705373,175],["ὅτι",709803,7],["ναί",709173,11],["γινώσκω",703105,157],["αὐτά",702165,71]],"Now they come to pass, and not formerly: and thou heardest not of them in former days: say not thou, Yea, I know them."],["8",[["οὔτε",709857,7],["ἔγνως",703105,162],["οὔτε",709857,7],["ἠπίστω",705264,266],["οὔτε",709857,7],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["ἤνοιξά",701186,155],["σου",711945,133],["τὰ",709436,41],["ὦτα",709852,42],["ἔγνων",703105,155],["γὰρ",702963,11],["ὅτι",709803,7],["ἀθετῶν",700369,72],["ἀθετήσεις",700369,166],["καὶ",707031,7],["ἄνομος",701194,14],["ἔτι",705538,28],["ἐκ",704132,0],["κοιλίας",707761,17],["κληθήσῃ",707084,364]],"Thou hast neither known, nor understood, neither from the beginning have I opened thine ears: for I knew that thou wouldest surely deal treacherously, and wouldest be called a transgressor even from the womb."],["9",[["ἕνεκεν",704709,0],["τοῦ",709436,20],["ἐμοῦ",704580,133],["ὀνόματος",709666,21],["δείξω",703314,165],["σοι",711925,159],["τὸν",709436,5],["θυμόν",706334,6],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,41],["ἔνδοξά",704694,68],["μου",709032,133],["ἐπάξω",704994,165],["ἐπὶ",705080,0],["σοί",711925,159],["ἵνα",706747,7],["μὴ",708851,28],["ἐξολεθρεύσω",704956,207],["σε",711598,163]],"For mine own sake will I shew thee my wrath, and will bring before thee my glorious acts, that I may not utterly destroy thee."],["10",[["ἰδοὺ",706497,88],["πέπρακά",710480,89],["σε",711598,163],["οὐχ",709805,28],["ἕνεκεν",704709,0],["ἀργυρίου",701707,21],["ἐξειλάμην",704838,161],["δέ",703303,11],["σε",711598,163],["ἐκ",704132,0],["καμίνου",707113,18],["πτωχείας",711073,17]],"Behold, I have sold thee, [but] not for silver; but I have rescued thee from the furnace of affliction."],["11",[["ἕνεκεν",704709,0],["ἐμοῦ",704580,133],["ποιήσω",710582,207],["σοι",711925,159],["ὅτι",709803,7],["τὸ",709436,34],["ἐμὸν",704578,14],["ὄνομα",709666,15],["βεβηλοῦται",702614,391],["καὶ",707031,7],["τὴν",709436,8],["δόξαν",703791,9],["μου",709032,133],["ἑτέρῳ",705535,30],["οὐ",709805,28],["δώσω",703654,165]],"For mine own sake I will do [this] for thee, because my name is profaned; and I will not give my glory to another."],["12",[["ἄκουέ",700587,240],["μου",709032,133],["Ιακωβ",706401,4],["καὶ",707031,7],["Ισραηλ",706839,4],["ὃν",709781,112],["ἐγὼ",704018,164],["καλῶ",707084,157],["ἐγώ",704018,164],["εἰμι",704093,157],["πρῶτος",711041,14],["καὶ",707031,7],["ἐγώ",704018,164],["εἰμι",704093,157],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"Hear me, O Jacob, and Israel whom I call; I am the first, and I endure for ever."],["13",[["καὶ",707031,7],["ἡ",709436,10],["χείρ",713787,12],["μου",709032,133],["ἐθεμελίωσεν",706182,2],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἡ",709436,10],["δεξιά",703360,29],["μου",709032,133],["ἐστερέωσεν",712076,2],["τὸν",709436,5],["οὐρανόν",709844,6],["καλέσω",707084,165],["αὐτούς",702165,62],["καὶ",707031,7],["στήσονται",706846,135],["ἅμα",700745,28]],"My hand also has founded the earth, and my right hand has fixed the sky: I will call them, and they shall stand together."],["14",[["καὶ",707031,7],["συναχθήσονται",712375,144],["πάντες",710177,138],["καὶ",707031,7],["ἀκούσονται",700587,135],["τίς",712867,158],["αὐτοῖς",702165,151],["ἀνήγγειλεν",700921,2],["ταῦτα",709858,71],["ἀγαπῶν",700120,72],["σε",711598,163],["ἐποίησα",710582,155],["τὸ",709436,24],["θέλημά",706170,25],["σου",711945,133],["ἐπὶ",705080,0],["Βαβυλῶνα",702352,9],["τοῦ",709436,20],["ἆραι",700473,106],["σπέρμα",712008,25],["Χαλδαίων",713678,81]],"And all shall be gathered, and shall hear: who has told them these things? Out of love to thee I have fulfilled thy desire on Babylon, to abolish the seed of the Chaldeans."],["15",[["ἐγὼ",704018,164],["ἐλάλησα",708071,155],["ἐγὼ",704018,164],["ἐκάλεσα",707084,155],["ἤγαγον",700209,155],["αὐτὸν",702165,85],["καὶ",707031,7],["εὐόδωσα",705654,155],["τὴν",709436,8],["ὁδὸν",709458,9],["αὐτοῦ",702165,102]],"I have spoken, I have called, I have brought him, and made his way prosperous."],["16",[["προσαγάγετε",710848,74],["πρός",710844,0],["με",708618,163],["καὶ",707031,7],["ἀκούσατε",700587,74],["ταῦτα",709858,71],["οὐκ",709805,28],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["ἐν",704639,0],["κρυφῇ",707929,28],["ἐλάλησα",708071,155],["οὐδὲ",709816,7],["ἐν",704639,0],["τόπῳ",712903,114],["γῆς",703083,17],["σκοτεινῷ",711885,30],["ἡνίκα",706008,28],["ἐγένετο",703104,23],["ἐκεῖ",704181,28],["ἤμην",704578,36],["καὶ",707031,7],["νῦν",709384,28],["κύριος",707996,4],["ἀπέσταλκέν",701592,171],["με",708618,163],["καὶ",707031,7],["τὸ",709436,34],["πνεῦμα",710566,15],["αὐτοῦ",702165,102]],"Draw nigh to me, and hear ye these words; I have not spoken in secret from the beginning: when it took place, there was I, and now the Lord, [even] the Lord, and his Spirit, hath sent me."],["17",[["οὕτως",709859,28],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["ῥυσάμενός",711309,248],["σε",711598,163],["ὁ",709436,3],["ἅγιος",700159,14],["Ισραηλ",706839,18],["ἐγώ",704018,164],["εἰμι",704093,157],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["δέδειχά",703314,89],["σοι",711925,159],["τοῦ",709436,20],["εὑρεῖν",705676,106],["σε",711598,163],["τὴν",709436,8],["ὁδόν",709458,9],["ἐν",704639,0],["ᾗ",709781,108],["πορεύσῃ",710667,123],["ἐν",704639,0],["αὐτῇ",702165,105]],"Thus saith the Lord that delivered thee, the Holy One of Israel; I am thy God, I have shewn thee how thou shouldest find the way wherein thou shouldest walk."],["18",[["καὶ",707031,7],["εἰ",704071,7],["ἤκουσας",700587,162],["τῶν",709436,130],["ἐντολῶν",704802,65],["μου",709032,133],["ἐγένετο",703104,23],["ἂν",700900,11],["ὡσεὶ",714159,11],["ποταμὸς",710693,4],["ἡ",709436,10],["εἰρήνη",704098,12],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["δικαιοσύνη",703695,12],["σου",711945,133],["ὡς",714148,11],["κῦμα",707968,15],["θαλάσσης",706069,17]],"And if thou hadst hearkened to my commandments, [then] would thy peace have been like a river, and thy righteousness as a wave of the sea."],["19",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἂν",700900,11],["ὡς",714148,11],["ἡ",709436,10],["ἄμμος",700845,12],["τὸ",709436,34],["σπέρμα",712008,15],["σου",711945,133],["καὶ",707031,7],["τὰ",709436,63],["ἔκγονα",704159,195],["τῆς",709436,16],["κοιλίας",707761,17],["σου",711945,133],["ὡς",714148,11],["ὁ",709436,3],["χοῦς",713930,4],["τῆς",709436,16],["γῆς",703083,17],["οὐδὲ",709816,7],["νῦν",709384,28],["οὐ",709805,28],["μὴ",708851,28],["ἐξολεθρευθῇς",704956,279],["οὐδὲ",709816,7],["ἀπολεῖται",701513,93],["τὸ",709436,34],["ὄνομά",709666,15],["σου",711945,133],["ἐνώπιόν",704823,0],["μου",709032,133]],"Thy seed also would have been as the sand, and the offspring of thy belly as the dust of the ground: neither now shalt thou by any means be utterly destroyed, neither shall thy name perish before me."],["20",[["ἔξελθε",704909,176],["ἐκ",704132,0],["Βαβυλῶνος",702352,17],["φεύγων",713433,72],["ἀπὸ",701425,0],["τῶν",709436,80],["Χαλδαίων",713678,81],["φωνὴν",713640,9],["εὐφροσύνης",705717,17],["ἀναγγείλατε",700921,74],["καὶ",707031,7],["ἀκουστὸν",700584,46],["γενέσθω",703104,315],["τοῦτο",709858,129],["ἀπαγγείλατε",701321,74],["ἕως",705792,0],["ἐσχάτου",705519,116],["τῆς",709436,16],["γῆς",703083,17],["λέγετε",708124,335],["ἐρρύσατο",711309,23],["κύριος",707996,4],["τὸν",709436,5],["δοῦλον",703817,6],["αὐτοῦ",702165,102],["Ιακωβ",706401,6]],"Go forth of Babylon, thou that fleest from the Chaldeans: utter aloud a voice of joy, and let this be made known, proclaim it to the end of the earth; say ye, The Lord hath delivered his servant Jacob."],["21",[["καὶ",707031,7],["ἐὰν",703912,7],["διψήσωσιν",703763,234],["δι᾿",703417,0],["ἐρήμου",705420,17],["ἄξει",700209,127],["αὐτούς",702165,62],["ὕδωρ",713071,25],["ἐκ",704132,0],["πέτρας",710443,17],["ἐξάξει",704834,127],["αὐτοῖς",702165,151],["σχισθήσεται",712604,134],["πέτρα",710443,9],["καὶ",707031,7],["ῥυήσεται",711241,93],["ὕδωρ",713071,15],["καὶ",707031,7],["πίεται",710478,93],["ὁ",709436,3],["λαός",708094,4],["μου",709032,133]],"And if they shall thirst, he shall lead them through the desert; he shall bring forth water to them out of the rock: the rock shall be cloven, and the water shall flow forth, and my people shall drink."],["22",[["οὐκ",709805,28],["ἔστιν",704093,91],["χαίρειν",713665,55],["τοῖς",709436,147],["ἀσεβέσιν",701909,230],["λέγει",708124,91],["κύριος",707996,4]],"There is no joy, saith the Lord, to the ungodly."]]