[["1",[["ὡς",714148,28],["κηρὸς",707659,4],["ἀπὸ",701425,0],["πυρὸς",711088,15],["τήκεται",712839,117],["καὶ",707031,7],["κατακαύσει",707258,127],["πῦρ",711088,15],["τοὺς",709436,58],["ὑπεναντίους",713109,60],["καὶ",707031,7],["φανερὸν",713342,26],["ἔσται",704093,93],["τὸ",709436,34],["ὄνομα",709666,15],["κυρίου",707996,18],["ἐν",704639,0],["τοῖς",709436,147],["ὑπεναντίοις",713109,230],["ἀπὸ",701425,0],["προσώπου",710986,21],["σου",711945,133],["ἔθνη",704068,42],["ταραχθήσονται",712721,144]],"as wax melts before the fire; and fire shall burn up the enemies, and thy name shall be manifest among the adversaries: at thy presence the nations shall be troubled,"],["2",[["ὅταν",709801,28],["ποιῇς",710582,205],["τὰ",709436,41],["ἔνδοξα",704694,68],["τρόμος",712975,4],["λήμψεται",708076,93],["ἀπὸ",701425,0],["σοῦ",711945,133],["ὄρη",709768,42]],"whenever thou shalt work gloriously; trembling from thee shall take hold upon the mountains."],["3",[["ἀπὸ",701425,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["οὐκ",709805,28],["ἠκούσαμεν",700587,289],["οὐδὲ",709816,7],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["ἡμῶν",705999,145],["εἶδον",709725,150],["θεὸν",706192,6],["πλὴν",710540,0],["σοῦ",711945,133],["καὶ",707031,7],["τὰ",709436,41],["ἔργα",705396,42],["σου",711945,133],["ἃ",709781,69],["ποιήσεις",710582,166],["τοῖς",709436,147],["ὑπομένουσιν",713219,197],["ἔλεον",704426,25]],"From of old we have not heard, neither have our eyes seen a God beside thee, and thy works which thou wilt perform to them that wait for mercy."],["4",[["συναντήσεται",712394,93],["γὰρ",702963,11],["τοῖς",709436,147],["ποιοῦσιν",710582,197],["τὸ",709436,24],["δίκαιον",703694,46],["καὶ",707031,7],["τῶν",709436,130],["ὁδῶν",709458,65],["σου",711945,133],["μνησθήσονται",708923,144],["ἰδοὺ",706497,88],["σὺ",712181,164],["ὠργίσθης",709729,168],["καὶ",707031,7],["ἡμεῖς",705983,219],["ἡμάρτομεν",700773,289],["διὰ",703417,0],["τοῦτο",709858,129],["ἐπλανήθημεν",710495,485]],"For [these blessings] shall happen to them that work righteousness, and they shall remember thy ways: behold, thou wast angry and we have sinned; therefore we have erred,"],["5",[["καὶ",707031,7],["ἐγενήθημεν",703104,485],["ὡς",714148,28],["ἀκάθαρτοι",700508,138],["πάντες",710177,138],["ἡμεῖς",705983,219],["ὡς",714148,28],["ῥάκος",711160,15],["ἀποκαθημένης",701469,422],["πᾶσα",710177,29],["ἡ",709436,10],["δικαιοσύνη",703695,12],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐξερρύημεν",704300,289],["ὡς",714148,28],["φύλλα",713622,42],["διὰ",703417,0],["τὰς",709436,38],["ἀνομίας",701192,39],["ἡμῶν",705999,145],["οὕτως",709859,28],["ἄνεμος",701123,4],["οἴσει",713428,127],["ἡμᾶς",705981,194]],"and we are all become as unclean, and all our righteousness as a filthy rag: and we have fallen as leaves because of our iniquities; thus the wind shall carry us [away]."],["6",[["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ὁ",709436,3],["ἐπικαλούμενος",705153,122],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["καὶ",707031,7],["ὁ",709436,3],["μνησθεὶς",708923,217],["ἀντιλαβέσθαι",701243,109],["σου",711945,133],["ὅτι",709803,7],["ἀπέστρεψας",701598,162],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["ἀφ᾿",701425,0],["ἡμῶν",705999,145],["καὶ",707031,7],["παρέδωκας",710014,162],["ἡμᾶς",705981,194],["διὰ",703417,0],["τὰς",709436,38],["ἁμαρτίας",700775,39],["ἡμῶν",705999,145]],"And there is none that calls upon thy name, or that remembers to take hold on thee: for thou hast turned thy face away from us, and hast delivered us up because of our sins."],["7",[["καὶ",707031,7],["νῦν",709384,28],["κύριε",707996,153],["πατὴρ",710189,4],["ἡμῶν",705999,145],["σύ",712181,164],["ἡμεῖς",705983,219],["δὲ",703303,11],["πηλὸς",710457,4],["ἔργον",705396,15],["τῶν",709436,130],["χειρῶν",713787,65],["σου",711945,133],["πάντες",710177,138]],"And now, O Lord, thou art our Father, and we are clay, all [of us] the work of thine hands."],["8",[["μὴ",708851,28],["ὀργίζου",709729,253],["ἡμῖν",705994,90],["σφόδρα",712586,28],["καὶ",707031,7],["μὴ",708851,28],["ἐν",704639,0],["καιρῷ",707047,114],["μνησθῇς",708960,279],["ἁμαρτιῶν",700775,65],["ἡμῶν",705999,145],["καὶ",707031,7],["νῦν",709384,28],["ἐπίβλεψον",705088,176],["ὅτι",709803,7],["λαός",708094,4],["σου",711945,133],["πάντες",710177,138],["ἡμεῖς",705983,219]],"Be not very wroth with us, and remember not our sins for ever; but now look on [us], for we are all thy people."],["9",[["πόλις",710612,12],["τοῦ",709436,35],["ἁγίου",700159,116],["σου",711945,133],["ἐγενήθη",703104,37],["ἔρημος",705420,12],["Σιων",711816,12],["ὡς",714148,28],["ἔρημος",705420,12],["ἐγενήθη",703104,37],["Ιερουσαλημ",706644,12],["εἰς",704105,0],["κατάραν",707395,9]],"The city of thy holiness has become desolate, Sion has become as a wilderness, Jerusalem a curse."],["10",[["ὁ",709436,3],["οἶκος",709516,4],["τὸ",709436,34],["ἅγιον",700159,14],["ἡμῶν",705999,145],["καὶ",707031,7],["ἡ",709436,10],["δόξα",703791,12],["ἣν",709781,131],["ηὐλόγησαν",705631,150],["οἱ",709436,136],["πατέρες",710189,52],["ἡμῶν",705999,145],["ἐγενήθη",703104,37],["πυρίκαυστος",711096,14],["καὶ",707031,7],["πάντα",710177,195],["τὰ",709436,63],["ἔνδοξα",704694,195],["συνέπεσεν",712332,2]],"The house, our sanctuary, and the glory which our fathers blessed, has been burnt with fire: and all our glorious things have gone to ruin."],["11",[["καὶ",707031,7],["ἐπὶ",705080,0],["πᾶσι",710177,230],["τούτοις",709858,151],["ἀνέσχου",701140,174],["κύριε",707996,153],["καὶ",707031,7],["ἐσιώπησας",711818,162],["καὶ",707031,7],["ἐταπείνωσας",712717,162],["ἡμᾶς",705981,194],["σφόδρα",712586,28]],"And for all these things thou, O Lord, hast withholden thyself, and been silent, and hast brought us very low."]]