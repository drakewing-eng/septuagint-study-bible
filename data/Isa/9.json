[["1",[["ὁ",709436,3],["λαὸς",708094,4],["ὁ",709436,3],["πορευόμενος",710667,122],["ἐν",704639,0],["σκότει",711889,54],["ἴδετε",709725,74],["φῶς",713642,25],["μέγα",708653,46],["οἱ",709436,136],["κατοικοῦντες",707534,146],["ἐν",704639,0],["χώρᾳ",714011,1],["καὶ",707031,7],["σκιᾷ",711852,1],["θανάτου",706096,18],["φῶς",713642,25],["λάμψει",708085,127],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194]],"O people walking in darkness, behold a great light: ye that dwell in the region [and] shadow of death, a light shall shine upon you."],["2",[["τὸ",709436,24],["πλεῖστον",710513,534],["τοῦ",709436,35],["λαοῦ",708094,18],["ὃ",709781,33],["κατήγαγες",707232,162],["ἐν",704639,0],["εὐφροσύνῃ",705717,1],["σου",711945,133],["καὶ",707031,7],["εὐφρανθήσονται",705715,144],["ἐνώπιόν",704823,28],["σου",711945,133],["ὡς",714148,28],["οἱ",709436,136],["εὐφραινόμενοι",705715,348],["ἐν",704639,0],["ἀμήτῳ",700819,114],["καὶ",707031,7],["ὃν",709781,112],["τρόπον",712980,6],["οἱ",709436,136],["διαιρούμενοι",703459,348],["σκῦλα",711902,42]],"The multitude of the people which thou hast brought down in thy joy, they shall even rejoice before thee as they that rejoice in harvest, and as they that divide the spoil."],["3",[["διότι",703734,7],["ἀφῄρηται",702177,187],["ὁ",709436,3],["ζυγὸς",705894,4],["ὁ",709436,3],["ἐπ᾿",705080,0],["αὐτῶν",702165,40],["κείμενος",707595,122],["καὶ",707031,7],["ἡ",709436,10],["ῥάβδος",711135,12],["ἡ",709436,10],["ἐπὶ",705080,0],["τοῦ",709436,35],["τραχήλου",712924,18],["αὐτῶν",702165,40],["τὴν",709436,8],["γὰρ",702963,11],["ῥάβδον",711135,9],["τῶν",709436,80],["ἀπαιτούντων",701330,170],["διεσκέδασεν",703575,2],["κύριος",707996,4],["ὡς",714148,28],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["ἐπὶ",705080,0],["Μαδιαμ",708355,118]],"Because the yoke that was laid upon them has been taken away, and the rod that was on their neck: for he has broken the rod of the exactors, as in the day of Madiam."],["4",[["ὅτι",709803,7],["πᾶσαν",710177,36],["στολὴν",712120,9],["ἐπισυνηγμένην",705280,444],["δόλῳ",703787,114],["καὶ",707031,7],["ἱμάτιον",706742,25],["μετὰ",708780,0],["καταλλαγῆς",707314,17],["ἀποτείσουσιν",701618,218],["καὶ",707031,7],["θελήσουσιν",706176,218],["εἰ",704071,7],["ἐγενήθησαν",703104,99],["πυρίκαυστοι",711096,138]],"For they shall compensate for every garment that has been acquired by deceit, and [all] raiment with restitution; and they shall be willing, [even] if they were burnt with fire."],["5",[["ὅτι",709803,7],["παιδίον",709927,25],["ἐγεννήθη",703051,37],["ἡμῖν",705994,90],["υἱὸς",713075,4],["καὶ",707031,7],["ἐδόθη",703654,37],["ἡμῖν",705994,90],["οὗ",709781,48],["ἡ",709436,10],["ἀρχὴ",701836,12],["ἐγενήθη",703104,37],["ἐπὶ",705080,0],["τοῦ",709436,35],["ὤμου",714114,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["καλεῖται",707084,117],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["μεγάλης",708653,82],["βουλῆς",702792,17],["ἄγγελος",700140,4],["ἐγὼ",704018,164],["γὰρ",702963,11],["ἄξω",700209,165],["εἰρήνην",704098,9],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἄρχοντας",701862,57],["εἰρήνην",704098,9],["καὶ",707031,7],["ὑγίειαν",713058,9],["αὐτῷ",702165,50]],"For a child is born to us, and a son is given to us, whose government is upon his shoulder: and his name is called the Messenger of great counsel: for I will bring peace upon the princes, and health to him."],["6",[["μεγάλη",708653,29],["ἡ",709436,10],["ἀρχὴ",701836,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["τῆς",709436,16],["εἰρήνης",704098,17],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἔστιν",704093,91],["ὅριον",709749,25],["ἐπὶ",705080,0],["τὸν",709436,5],["θρόνον",706315,6],["Δαυιδ",703232,18],["καὶ",707031,7],["τὴν",709436,8],["βασιλείαν",702577,9],["αὐτοῦ",702165,102],["κατορθῶσαι",707548,300],["αὐτὴν",702165,104],["καὶ",707031,7],["ἀντιλαβέσθαι",701243,109],["αὐτῆς",702165,86],["ἐν",704639,0],["δικαιοσύνῃ",703695,1],["καὶ",707031,7],["ἐν",704639,0],["κρίματι",707903,54],["ἀπὸ",701425,0],["τοῦ",709436,35],["νῦν",709384,28],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["χρόνον",713969,6],["ὁ",709436,3],["ζῆλος",705871,4],["κυρίου",707996,18],["σαβαωθ",711346,228],["ποιήσει",710582,127],["ταῦτα",709858,71]],"His government shall be great, and of his peace there is no end: [it shall be] upon the throne of David, and [upon] his kingdom, to establish it, and to support [it] with judgment and with righteousness, from henceforth and for ever. The zeal of the Lord of hosts shall perform this."],["7",[["θάνατον",706096,6],["ἀπέστειλεν",701592,2],["κύριος",707996,4],["ἐπὶ",705080,0],["Ιακωβ",706401,6],["καὶ",707031,7],["ἦλθεν",705453,2],["ἐπὶ",705080,0],["Ισραηλ",706839,6]],"The Lord has sent death upon Jacob, and it has come upon Israel."],["8",[["καὶ",707031,7],["γνώσονται",703105,135],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["τοῦ",709436,35],["Εφραιμ",705769,18],["καὶ",707031,7],["οἱ",709436,136],["ἐγκαθήμενοι",703952,348],["ἐν",704639,0],["Σαμαρείᾳ",711449,1],["ἐφ᾿",705080,0],["ὕβρει",713051,1],["καὶ",707031,7],["ὑψηλῇ",713285,101],["καρδίᾳ",707141,1],["λέγοντες",708124,146]],"And all the people of Ephraim, and they that dwelt in Samaria shall know, who say in their pride and lofty heart,"],["9",[["πλίνθοι",710554,191],["πεπτώκασιν",710481,353],["ἀλλὰ",700680,7],["δεῦτε",703383,28],["λαξεύσωμεν",708092,79],["λίθους",708196,57],["καὶ",707031,7],["ἐκκόψωμεν",704225,79],["συκαμίνους",712253,39],["καὶ",707031,7],["κέδρους",707590,39],["καὶ",707031,7],["οἰκοδομήσωμεν",709509,79],["ἑαυτοῖς",703917,151],["πύργον",711092,6]],"The bricks are fallen down, but come, let us hew stones, and cut down sycamores and cedars, and let us build for ourselves a tower."],["10",[["καὶ",707031,7],["ῥάξει",711191,127],["ὁ",709436,3],["θεὸς",706192,4],["τοὺς",709436,58],["ἐπανιστανομένους",701173,360],["ἐπ᾿",705080,0],["ὄρος",709768,25],["Σιων",711816,9],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["καὶ",707031,7],["τοὺς",709436,58],["ἐχθροὺς",705779,57],["αὐτῶν",702165,40],["διασκεδάσει",703575,127]],"And God shall dash down them that rise up against him on mount Sion, and shall scatter his enemies;"],["11",[["Συρίαν",712533,25],["ἀφ᾿",701425,0],["ἡλίου",705974,18],["ἀνατολῶν",701071,65],["καὶ",707031,7],["τοὺς",709436,58],["Ἕλληνας",704515,57],["ἀφ᾿",701425,0],["ἡλίου",705974,18],["δυσμῶν",703865,65],["τοὺς",709436,58],["κατεσθίοντας",707519,235],["τὸν",709436,5],["Ισραηλ",706839,6],["ὅλῳ",709597,30],["τῷ",709436,113],["στόματι",712125,54],["ἐπὶ",705080,0],["τούτοις",709858,151],["πᾶσιν",710177,230],["οὐκ",709805,28],["ἀπεστράφη",701598,37],["ὁ",709436,3],["θυμός",706334,4],["ἀλλ᾿",700680,7],["ἔτι",705538,28],["ἡ",709436,10],["χεὶρ",713787,12],["ὑψηλή",713285,29]],"[even] Syria from the rising of the sun, and the Greeks from the setting of the sun, who devour Israel with open mouth. For all this [his] anger is not turned away, but still [his] hand is exalted."],["12",[["καὶ",707031,7],["ὁ",709436,3],["λαὸς",708094,4],["οὐκ",709805,28],["ἀπεστράφη",701598,37],["ἕως",705792,28],["ἐπλήγη",710550,37],["καὶ",707031,7],["τὸν",709436,5],["κύριον",707996,6],["οὐκ",709805,28],["ἐξεζήτησαν",704187,150]],"But the people turned not until they were smitten, and they sought not the Lord."],["13",[["καὶ",707031,7],["ἀφεῖλεν",702177,2],["κύριος",707996,4],["ἀπὸ",701425,0],["Ισραηλ",706839,18],["κεφαλὴν",707639,9],["καὶ",707031,7],["οὐράν",709839,9],["μέγαν",708653,27],["καὶ",707031,7],["μικρὸν",708915,27],["ἐν",704639,0],["μιᾷ",704106,101],["ἡμέρᾳ",705984,1]],"So the Lord took away from Israel the head and tail, great and small, in one day:",{"s":"d","q":0.59}],["14",[["πρεσβύτην",710736,6],["καὶ",707031,7],["τοὺς",709436,58],["τὰ",709436,41],["πρόσωπα",710986,42],["θαυμάζοντας",706135,235],["αὕτη",709858,107],["ἡ",709436,10],["ἀρχή",701836,12],["καὶ",707031,7],["προφήτην",711009,6],["διδάσκοντα",703649,183],["ἄνομα",701194,68],["οὗτος",709858,121],["ἡ",709436,10],["οὐρά",709839,12]],"the old man, and them that respect persons, this is the head; and the prophet teaching unlawful things, he is the tail.",{"s":"d","q":0.44}],["15",[["καὶ",707031,7],["ἔσονται",704093,135],["οἱ",709436,136],["μακαρίζοντες",708396,146],["τὸν",709436,5],["λαὸν",708094,6],["τοῦτον",709858,85],["πλανῶντες",710495,146],["καὶ",707031,7],["πλανῶσιν",710495,197],["ὅπως",709719,7],["καταπίωσιν",707374,234],["αὐτούς",702165,62]],"And they that pronounce this people blessed shall mislead them; and they mislead them that they may devour them."],["16",[["διὰ",703417,0],["τοῦτο",709858,129],["ἐπὶ",705080,0],["τοὺς",709436,58],["νεανίσκους",709232,57],["αὐτῶν",702165,40],["οὐκ",709805,28],["εὐφρανθήσεται",705715,134],["ὁ",709436,3],["θεὸς",706192,4],["καὶ",707031,7],["τοὺς",709436,58],["ὀρφανοὺς",709779,60],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰς",709436,38],["χήρας",713848,39],["αὐτῶν",702165,40],["οὐκ",709805,28],["ἐλεήσει",704418,127],["ὅτι",709803,7],["πάντες",710177,138],["ἄνομοι",701194,138],["καὶ",707031,7],["πονηροί",710660,138],["καὶ",707031,7],["πᾶν",710177,26],["στόμα",712125,15],["λαλεῖ",708071,91],["ἄδικα",700272,661],["ἐπὶ",705080,0],["πᾶσιν",710177,230],["τούτοις",709858,151],["οὐκ",709805,28],["ἀπεστράφη",701598,37],["ὁ",709436,3],["θυμός",706334,4],["ἀλλ᾿",700680,7],["ἔτι",705538,28],["ἡ",709436,10],["χεὶρ",713787,12],["ὑψηλή",713285,29]],"Therefore the Lord shall not take pleasure in their young men, neither shall he have pity on their orphans or on their widows: for they are all transgressors and wicked, and every mouth speaks unjustly. For all this [his] anger is not turned away, but [his] hand is yet exalted."],["17",[["καὶ",707031,7],["καυθήσεται",707049,134],["ὡς",714148,28],["πῦρ",711088,25],["ἡ",709436,10],["ἀνομία",701192,12],["καὶ",707031,7],["ὡς",714148,28],["ἄγρωστις",700199,12],["ξηρὰ",709421,29],["βρωθήσεται",702722,134],["ὑπὸ",713184,0],["πυρός",711088,21],["καὶ",707031,7],["καυθήσεται",707049,134],["ἐν",704639,0],["τοῖς",709436,147],["δάσεσι",703297,96],["τοῦ",709436,35],["δρυμοῦ",703836,18],["καὶ",707031,7],["συγκαταφάγεται",712209,93],["τὰ",709436,41],["κύκλῳ",707959,114],["τῶν",709436,80],["βουνῶν",702797,81],["πάντα",710177,68]],"And iniquity shall burn as fire, and shall be devoured by fire as dry grass: and it shall burn in the thickets of the wood, and shall devour all that is round about the hills."],["18",[["διὰ",703417,0],["θυμὸν",706334,6],["ὀργῆς",709728,17],["κυρίου",707996,18],["συγκέκαυται",712198,187],["ἡ",709436,10],["γῆ",703083,12],["ὅλη",709597,29],["καὶ",707031,7],["ἔσται",704093,93],["ὁ",709436,3],["λαὸς",708094,4],["ὡς",714148,28],["ὑπὸ",713184,0],["πυρὸς",711088,18],["κατακεκαυμένος",707258,419],["ἄνθρωπος",701163,4],["τὸν",709436,5],["ἀδελφὸν",700249,6],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐλεήσει",704418,127]],"The whole earth is set on fire because of the fierce anger of the Lord, and the people shall be as men burnt by fire: no man shall pity his brother."],["19",[["ἀλλὰ",700680,7],["ἐκκλινεῖ",704220,127],["εἰς",704105,0],["τὰ",709436,41],["δεξιά",703360,68],["ὅτι",709803,7],["πεινάσει",710222,127],["καὶ",707031,7],["φάγεται",713296,93],["ἐκ",704132,0],["τῶν",709436,80],["ἀριστερῶν",701749,169],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἐμπλησθῇ",704592,384],["ἄνθρωπος",701163,4],["ἔσθων",705495,72],["τὰς",709436,38],["σάρκας",711537,39],["τοῦ",709436,35],["βραχίονος",702808,18],["αὐτοῦ",702165,102]],"But [one] shall turn aside to the right hand, for he shall be hungry; and shall eat on the left, and a man shall by no means be satisfied with eating the flesh of his own arm."],["20",[["φάγεται",713296,93],["γὰρ",702963,11],["Μανασση",708470,4],["τοῦ",709436,35],["Εφραιμ",705769,18],["καὶ",707031,7],["Εφραιμ",705769,4],["τοῦ",709436,35],["Μανασση",708470,18],["ὅτι",709803,7],["ἅμα",700745,28],["πολιορκήσουσιν",710608,218],["τὸν",709436,5],["Ιουδαν",706775,6],["ἐπὶ",705080,0],["τούτοις",709858,151],["πᾶσιν",710177,230],["οὐκ",709805,28],["ἀπεστράφη",701598,37],["ὁ",709436,3],["θυμός",706334,4],["ἀλλ᾿",700680,7],["ἔτι",705538,28],["ἡ",709436,10],["χεὶρ",713787,12],["ὑψηλή",713285,29]],"For Manasses shall eat [the flesh] of Ephraim, and Ephraim [the flesh] of Manasses; for they shall besiege Juda together. For all this [his] anger is not turned away, but [his] hand is yet exalted."]]