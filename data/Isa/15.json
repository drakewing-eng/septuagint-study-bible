[["1",[["τὸ",709436,24],["ῥῆμα",711246,25],["τὸ",709436,24],["κατὰ",707200,28],["τῆς",709436,16],["Μωαβίτιδος",709089,17],["νυκτὸς",709386,17],["ἀπολεῖται",701513,93],["ἡ",709436,10],["Μωαβῖτις",709089,9],["νυκτὸς",709386,17],["γὰρ",702963,11],["ἀπολεῖται",701513,93],["τὸ",709436,24],["τεῖχος",712759,25],["τῆς",709436,16],["Μωαβίτιδος",709089,17]],"The Word against the Land of Moab. By night the land of Moab shall be destroyed; for by night the wall of the land of Moab shall be destroyed."],["2",[["λυπεῖσθε",708272,73],["ἐφ᾿",705080,0],["ἑαυτοῖς",703917,151],["ἀπολεῖται",701513,93],["γὰρ",702963,11],["καὶ",707031,7],["Δηβων",703396,120],["οὗ",709806,28],["ὁ",709436,3],["βωμὸς",702840,4],["ὑμῶν",713091,145],["ἐκεῖ",704181,28],["ἀναβήσεσθε",700905,124],["κλαίειν",707703,55],["ἐπὶ",705080,0],["Ναβαυ",709137,227],["τῆς",709436,16],["Μωαβίτιδος",709089,17],["ὀλολύζετε",709593,335],["ἐπὶ",705080,0],["πάσης",710177,82],["κεφαλῆς",707639,17],["φαλάκρωμα",713324,15],["πάντες",710177,138],["βραχίονες",702808,52],["κατατετμημένοι",707455,429]],"Grieve for yourselves; for even Debon, where your altar is, shall be destroyed: thither shall ye go up to weep, over Nabau of the land of Moab: howl ye: baldness shall be on every head, [and] all arms [shall be] wounded."],["3",[["ἐν",704639,0],["ταῖς",709436,75],["πλατείαις",710509,291],["αὐτῆς",702165,86],["περιζώσασθε",710317,186],["σάκκους",711386,57],["καὶ",707031,7],["κόπτεσθε",707829,73],["ἐπὶ",705080,0],["τῶν",709436,43],["δωμάτων",703896,44],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ῥύμαις",711308,76],["αὐτῆς",702165,86],["πάντες",710177,138],["ὀλολύζετε",709593,335],["μετὰ",708780,0],["κλαυθμοῦ",707705,18]],"Gird yourselves with sackcloth in her streets: and lament upon her roofs, and in her streets, and in her ways; howl all of you with weeping."],["4",[["ὅτι",709803,7],["κέκραγεν",707868,171],["Εσεβων",705473,120],["καὶ",707031,7],["Ελεαλη",704409,120],["ἕως",705792,0],["Ιασσα",706452,118],["ἠκούσθη",700587,37],["ἡ",709436,10],["φωνὴ",713640,12],["αὐτῶν",702165,40],["διὰ",703417,0],["τοῦτο",709858,129],["ἡ",709436,10],["ὀσφὺς",709800,12],["τῆς",709436,16],["Μωαβίτιδος",709089,17],["βοᾷ",702743,91],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτῆς",702165,86],["γνώσεται",703105,93]],"For Esebon and Eleale have cried: their voice was heard to Jassa: therefore the loins of the region of Moab cry aloud; her soul shall know."],["5",[["ἡ",709436,10],["καρδία",707141,12],["τῆς",709436,16],["Μωαβίτιδος",709089,17],["βοᾷ",702743,91],["ἐν",704639,0],["αὐτῇ",702165,105],["ἕως",705792,0],["Σηγωρ",711731,118],["δάμαλις",703271,12],["γάρ",702963,11],["ἐστιν",704093,91],["τριετής",712942,29],["ἐπὶ",705080,0],["δὲ",703303,11],["τῆς",709436,16],["ἀναβάσεως",700907,17],["τῆς",709436,16],["Λουιθ",708253,118],["πρὸς",710844,0],["σὲ",711598,163],["κλαίοντες",707703,146],["ἀναβήσονται",700905,135],["τῇ",709436,100],["ὁδῷ",709458,1],["Αρωνιιμ",701869,118],["βοᾷ",702743,91],["σύντριμμα",712521,25],["καὶ",707031,7],["σεισμός",711632,4]],"The heart of the region of Moab cries within her to Segor; for it is [as] a heifer of three years old: and on the ascent of Luith they shall go up to thee weeping by the way of Aroniim: she cries, Destruction, and trembling."],["6",[["τὸ",709436,34],["ὕδωρ",713071,15],["τῆς",709436,16],["Νεμριμ",709252,17],["ἔρημον",705420,9],["ἔσται",704093,93],["καὶ",707031,7],["ὁ",709436,3],["χόρτος",713923,18],["αὐτῆς",702165,86],["ἐκλείψει",704237,127],["χόρτος",713923,18],["γὰρ",702963,11],["χλωρὸς",713880,14],["οὐκ",709805,28],["ἔσται",704093,93]],"The water of Nemerim shall be desolate, and the grass thereof shall fail: for there shall be no green grass."],["7",[["μὴ",708851,28],["καὶ",707031,7],["οὕτως",709859,28],["μέλλει",708705,91],["σωθῆναι",712627,179],["ἐπάξω",704994,165],["γὰρ",702963,11],["ἐπὶ",705080,0],["τὴν",709436,8],["φάραγγα",713351,9],["Ἄραβας",701694,39],["καὶ",707031,7],["λήμψονται",708076,135],["αὐτήν",702165,104]],"Shall [Moab] even thus be delivered? for I [will] bring the Arabians upon the valley, and they shall take it."],["8",[["συνῆψεν",712404,2],["γὰρ",702963,11],["ἡ",709436,10],["βοὴ",702744,12],["τὸ",709436,24],["ὅριον",709749,25],["τῆς",709436,16],["Μωαβίτιδος",709089,17],["τῆς",709436,16],["Αγαλλιμ",700115,17],["καὶ",707031,7],["ὀλολυγμὸς",709592,4],["αὐτῆς",702165,86],["ἕως",705792,0],["τοῦ",709436,20],["φρέατος",713576,21],["τοῦ",709436,35],["Αιλιμ",700436,17]],"For the cry has reached the border of the region of Moab, [even] of Agalim; and her howling [has gone] as far as the well of Ælim."],["9",[["τὸ",709436,34],["δὲ",703303,11],["ὕδωρ",713071,15],["τὸ",709436,34],["Ρεμμων",711233,18],["πλησθήσεται",710532,134],["αἵματος",700442,21],["ἐπάξω",704994,165],["γὰρ",702963,11],["ἐπὶ",705080,0],["Ρεμμων",711233,227],["Ἄραβας",701694,57],["καὶ",707031,7],["ἀρῶ",700473,165],["τὸ",709436,24],["σπέρμα",712008,25],["Μωαβ",709085,118],["καὶ",707031,7],["Αριηλ",701739,18],["καὶ",707031,7],["τὸ",709436,24],["κατάλοιπον",707317,46],["Αδαμα",700223,18]],"And the water of Dimon shall be filled with blood: for I will bring Arabians upon Dimon, and I will take away the seed of Moab, and Ariel, and the remnant of Adama."]]