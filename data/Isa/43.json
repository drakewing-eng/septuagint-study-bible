[["1",[["καὶ",707031,7],["νῦν",709384,28],["οὕτως",709859,28],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["ποιήσας",710582,182],["σε",711598,163],["Ιακωβ",706401,153],["ὁ",709436,3],["πλάσας",710503,182],["σε",711598,163],["Ισραηλ",706839,153],["μὴ",708851,28],["φοβοῦ",713532,253],["ὅτι",709803,7],["ἐλυτρωσάμην",708282,161],["σε",711598,163],["ἐκάλεσά",707084,155],["σε",711598,163],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["ἐμὸς",704578,14],["εἶ",704093,154],["σύ",712181,164]],"And now thus saith the Lord God that made thee, O Jacob, and formed thee, O Israel, Fear not: for I have redeemed thee, I have called thee [by] thy name; thou art mine."],["2",[["καὶ",707031,7],["ἐὰν",703912,11],["διαβαίνῃς",703419,205],["δι᾿",703417,0],["ὕδατος",713071,21],["μετὰ",708780,0],["σοῦ",711945,133],["εἰμι",704093,157],["καὶ",707031,7],["ποταμοὶ",710693,52],["οὐ",709805,28],["συγκλύσουσίν",712226,218],["σε",711598,163],["καὶ",707031,7],["ἐὰν",703912,11],["διέλθῃς",703673,175],["διὰ",703417,0],["πυρός",711088,21],["οὐ",709805,28],["μὴ",708851,28],["κατακαυθῇς",707258,279],["φλὸξ",713524,12],["οὐ",709805,28],["κατακαύσει",707258,127],["σε",711598,163]],"And if thou pass through water, I am with thee; and the rivers shall not overflow thee: and if thou go through fire, thou shalt not be burned; the flame shall not burn thee."],["3",[["ὅτι",709803,7],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ὁ",709436,3],["ἅγιος",700159,14],["Ισραηλ",706839,18],["ὁ",709436,3],["σῴζων",712627,72],["σε",711598,163],["ἐποίησά",710582,155],["σου",711945,133],["ἄλλαγμα",700682,25],["Αἴγυπτον",700401,9],["καὶ",707031,7],["Αἰθιοπίαν",700419,9],["καὶ",707031,7],["Σοήνην",711924,9],["ὑπὲρ",713111,0],["σοῦ",711945,133]],"For I am the Lord thy God, the Holy One of Israel, that saves thee: I have made Egypt and Ethiopia thy ransom, and [given] Soene for thee."],["4",[["ἀφ᾿",701425,0],["οὗ",709781,48],["ἔν