[["1",[["οὕτως",709859,28],["λέγει",708124,91],["κύριος",707996,4],["ποῖον",710599,26],["τὸ",709436,34],["βιβλίον",702719,15],["τοῦ",709436,20],["ἀποστασίου",701587,21],["τῆς",709436,16],["μητρὸς",708892,17],["ὑμῶν",713091,145],["ᾧ",709781,209],["ἐξαπέστειλα",704872,155],["αὐτήν",702165,104],["ἢ",705924,7],["τίνι",712867,435],["ὑπόχρεῳ",713260,30],["πέπρακα",710480,89],["ὑμᾶς",713080,194],["ἰδοὺ",706497,88],["ταῖς",709436,75],["ἁμαρτίαις",700775,76],["ὑμῶν",713091,145],["ἐπράθητε",710480,472],["καὶ",707031,7],["ταῖς",709436,75],["ἀνομίαις",701192,76],["ὑμῶν",713091,145],["ἐξαπέστειλα",704872,155],["τὴν",709436,8],["μητέρα",708892,9],["ὑμῶν",713091,145]],"Thus saith the Lord, Of what kind is your mother's bill of divorcement, by which I put her away? or to which debtor have I sold you? Behold, ye are sold for your sins, and for your iniquities have I put your mother away."],["2",[["τί",712867,126],["ὅτι",709803,7],["ἦλθον",705453,155],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ἄνθρωπος",701163,4],["ἐκάλεσα",707084,155],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ὁ",709436,3],["ὑπακούων",713096,72],["μὴ",708851,28],["οὐκ",709805,28],["ἰσχύει",706859,91],["ἡ",709436,10],["χείρ",713787,12],["μου",709032,133],["τοῦ",709436,20],["ῥύσασθαι",711309,109],["ἢ",705924,7],["οὐκ",709805,28],["ἰσχύω",706859,157],["τοῦ",709436,20],["ἐξελέσθαι",704838,109],["ἰδοὺ",706497,88],["τῇ",709436,100],["ἀπειλῇ",701375,1],["μου",709032,133],["ἐξερημώσω",704907,165],["τὴν",709436,8],["θάλασσαν",706069,9],["καὶ",707031,7],["θήσω",712849,165],["ποταμοὺς",710693,57],["ἐρήμους",705420,60],["καὶ",707031,7],["ξηρανθήσονται",709419,144],["οἱ",709436,136],["ἰχθύες",706870,52],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["τοῦ",709436,20],["μὴ",708851,28],["εἶναι",704093,55],["ὕδωρ",713071,25],["καὶ",707031,7],["ἀποθανοῦνται",701461,135],["ἐν",704639,0],["δίψει",703764,54]],"Why did I come, and there was no man? [why] did I call, and there was none to hearken? Is not my hand strong to redeem? or can I not deliver? behold, by my rebuke I will dry up the sea, and make rivers a wilderness; and their fish shall be dried up because there is no water, and shall die for thirst."],["3",[["καὶ",707031,7],["ἐνδύσω",704701,165],["τὸν",709436,5],["οὐρανὸν",709844,6],["σκότος",711889,6],["καὶ",707031,7],["θήσω",712849,165],["ὡς",714148,7],["σάκκον",711386,6],["τὸ",709436,24],["περιβόλαιον",710300,25],["αὐτοῦ",702165,102]],"I will clothe the sky with darkness, and will make its covering as sackcloth."],["4",[["κύριος",707996,4],["δίδωσίν",703654,91],["μοι",708974,159],["γλῶσσαν",703120,9],["παιδείας",709924,17],["τοῦ",709436,20],["γνῶναι",703105,106],["ἐν",704639,0],["καιρῷ",707047,114],["ἡνίκα",706008,28],["δεῖ",703312,91],["εἰπεῖν",705373,106],["λόγον",708236,6],["ἔθηκέν",712849,2],["μοι",708974,159],["πρωί",711021,28],["προσέθηκέν",710965,2],["μοι",708974,159],["ὠτίον",714165,25],["ἀκούειν",700587,55]],"The Lord [even] God gives me the tongue of instruction, to know when it is fit to speak a word: he has appointed for me early, he has given me an ear to hear:"],["5",[["καὶ",707031,7],["ἡ",709436,10],["παιδεία",709924,12],["κυρίου",707996,18],["ἀνοίγει",701186,91],["μου",709032,133],["τὰ",709436,41],["ὦτα",709852,42],["ἐγὼ",704018,164],["δὲ",703303,11],["οὐκ",709805,28],["ἀπειθῶ",701370,157],["οὐδὲ",709816,7],["ἀντιλέγω",701245,157]],"and the instruction of the Lord, even the Lord, opens mine ears, and I do not disobey, nor dispute."],["6",[["τὸν",709436,5],["νῶτόν",709403,6],["μου",709032,133],["δέδωκα",703654,89],["εἰς",704105,0],["μάστιγας",708568,39],["τὰς",709436,38],["δὲ",703303,11],["σιαγόνας",711763,39],["μου",709032,133],["εἰς",704105,0],["ῥαπίσματα",711183,42],["τὸ",709436,24],["δὲ",703303,11],["πρόσωπόν",710986,25],["μου",709032,133],["οὐκ",709805,28],["ἀπέστρεψα",701598,155],["ἀπὸ",701425,0],["αἰσχύνης",700483,17],["ἐμπτυσμάτων",705372,44]],"I gave my back to scourges, and my cheeks to blows; and I turned not away my face from the shame of spitting:"],["7",[["καὶ",707031,7],["κύριος",707996,4],["βοηθός",702748,4],["μου",709032,133],["ἐγενήθη",703104,37],["διὰ",703417,0],["τοῦτο",709858,129],["οὐκ",709805,28],["ἐνετράπην",704805,156],["ἀλλὰ",700680,7],["ἔθηκα",712849,155],["τὸ",709436,24],["πρόσωπόν",710986,25],["μου",709032,133],["ὡς",714148,7],["στερεὰν",712075,36],["πέτραν",710443,9],["καὶ",707031,7],["ἔγνων",703105,155],["ὅτι",709803,7],["οὐ",709805,28],["μὴ",708851,28],["αἰσχυνθῶ",700485,321]],"but the Lord God became my helper; therefore I was not ashamed, but I set my face as a solid rock; and I know that I shall never be ashamed,"],["8",[["ὅτι",709803,7],["ἐγγίζει",703939,91],["ὁ",709436,3],["δικαιώσας",703696,182],["με",708618,163],["τίς",712867,158],["ὁ",709436,3],["κρινόμενός",707905,122],["μοι",708974,159],["ἀντιστήτω",701154,45],["μοι",708974,159],["ἅμα",700745,28],["καὶ",707031,7],["τίς",712867,158],["ὁ",709436,3],["κρινόμενός",707905,122],["μοι",708974,159],["ἐγγισάτω",703939,45],["μοι",708974,159]],"for he that has justified me draws near; who is he that pleads with me? let him stand up against me at the same time: yea, who is he that pleads with me? let him draw nigh to me."],["9",[["ἰδοὺ",706497,88],["κύριος",707996,4],["βοηθεῖ",702746,91],["μοι",708974,159],["τίς",712867,158],["κακώσει",707073,127],["με",708618,163],["ἰδοὺ",706497,88],["πάντες",710177,138],["ὑμεῖς",713081,219],["ὡς",714148,28],["ἱμάτιον",706742,25],["παλαιωθήσεσθε",709937,261],["καὶ",707031,7],["ὡς",714148,28],["σὴς",711756,4],["καταφάγεται",707519,93],["ὑμᾶς",713080,194]],"Behold, the Lord, the Lord, will help me; who will hurt me? behold, all ye shall wax old as a garment, and a moth shall devour you."],["10",[["τίς",712867,158],["ἐν",704639,0],["ὑμῖν",713084,90],["ὁ",709436,3],["φοβούμενος",713532,122],["τὸν",709436,5],["κύριον",707996,6],["ἀκουσάτω",700587,45],["τῆς",709436,16],["φωνῆς",713640,17],["τοῦ",709436,35],["παιδὸς",709932,18],["αὐτοῦ",702165,102],["οἱ",709436,136],["πορευόμενοι",710667,348],["ἐν",704639,0],["σκότει",711889,114],["οὐκ",709805,28],["ἔστιν",704093,91],["αὐτοῖς",702165,151],["φῶς",713642,15],["πεποίθατε",710221,330],["ἐπὶ",705080,0],["τῷ",709436,53],["ὀνόματι",709666,54],["κυρίου",707996,18],["καὶ",707031,7],["ἀντιστηρίσασθε",701275,186],["ἐπὶ",705080,0],["τῷ",709436,113],["θεῷ",706192,114]],"Who is among you that fears the Lord? let him hearken to the voice of his servant: ye that walk in darkness, and have no light, trust in the name of the Lord, and stay upon God."],["11",[["ἰδοὺ",706497,88],["πάντες",710177,138],["ὑμεῖς",713081,219],["πῦρ",711088,25],["καίετε",707049,87],["καὶ",707031,7],["κατισχύετε",707531,87],["φλόγα",713524,9],["πορεύεσθε",710667,374],["τῷ",709436,53],["φωτὶ",713642,54],["τοῦ",709436,20],["πυρὸς",711088,21],["ὑμῶν",713091,145],["καὶ",707031,7],["τῇ",709436,100],["φλογί",713524,1],["ᾗ",709781,108],["ἐξεκαύσατε",704205,265],["δι᾿",703417,0],["ἐμὲ",704555,163],["ἐγένετο",703104,23],["ταῦτα",709858,71],["ὑμῖν",713084,90],["ἐν",704639,0],["λύπῃ",708273,1],["κοιμηθήσεσθε",707767,261]],"Behold, ye all kindle a fire, and feed a flame: walk in the light of your fire, and in the flame which ye have kindled. This has happened to you for my sake; ye shall lie down in sorrow."]]