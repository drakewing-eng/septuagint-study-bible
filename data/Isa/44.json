[["1",[["νῦν",709384,28],["δὲ",703303,11],["ἄκουσον",700587,176],["παῖς",709932,4],["μου",709032,133],["Ιακωβ",706401,153],["καὶ",707031,7],["Ισραηλ",706839,153],["ὃν",709781,112],["ἐξελεξάμην",704236,161]],"But now hear, Jacob my servant; and Israel, whom I have chosen."],["2",[["οὕτως",709859,28],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["ποιήσας",710582,182],["σε",711598,163],["καὶ",707031,7],["ὁ",709436,3],["πλάσας",710503,182],["σε",711598,163],["ἐκ",704132,0],["κοιλίας",707761,17],["ἔτι",705538,28],["βοηθηθήσῃ",702746,364],["μὴ",708851,28],["φοβοῦ",713532,253],["παῖς",709932,4],["μου",709032,133],["Ιακωβ",706401,4],["καὶ",707031,7],["ὁ",709436,3],["ἠγαπημένος",700120,419],["Ισραηλ",706839,4],["ὃν",709781,112],["ἐξελεξάμην",704236,161]],"Thus saith the Lord God that made thee, and he that formed thee from the womb; Thou shalt yet be helped: fear not, my servant Jacob; and beloved Israel, whom I have chosen."],["3",[["ὅτι",709803,7],["ἐγὼ",704018,164],["δώσω",703654,165],["ὕδωρ",713071,25],["ἐν",704639,0],["δίψει",703764,114],["τοῖς",709436,147],["πορευομένοις",710667,341],["ἐν",704639,0],["ἀνύδρῳ",701285,101],["ἐπιθήσω",705304,165],["τὸ",709436,24],["πνεῦμά",710566,25],["μου",709032,133],["ἐπὶ",705080,0],["τὸ",709436,24],["σπέρμα",712008,25],["σου",711945,133],["καὶ",707031,7],["τὰς",709436,38],["εὐλογίας",705633,39],["μου",709032,133],["ἐπὶ",705080,0],["τὰ",709436,41],["τέκνα",712761,42],["σου",711945,133]],"For I will give water to the thirsty that walk in a dry land: I will put my Spirit upon thy seed, and my blessings upon thy children:"],["4",[["καὶ",707031,7],["ἀνατελοῦσιν",701066,218],["ὡσεὶ",714159,28],["χόρτος",713923,4],["ἀνὰ",700902,0],["μέσον",708768,46],["ὕδατος",713071,21],["καὶ",707031,7],["ὡς",714148,28],["ἰτέα",706866,12],["ἐπὶ",705080,0],["παραρρέον",710098,47],["ὕδωρ",713071,25]],"and they shall spring up as grass between brooks, and as willows on [the banks of] running water."],["5",[["οὗτος",709858,121],["ἐρεῖ",705415,127],["τοῦ",709436,35],["θεοῦ",706192,18],["εἰμι",704093,157],["καὶ",707031,7],["οὗτος",709858,121],["βοήσεται",702743,93],["ἐπὶ",705080,0],["τῷ",709436,53],["ὀνόματι",709666,54],["Ιακωβ",706401,18],["καὶ",707031,7],["ἕτερος",705535,14],["ἐπιγράψει",705110,127],["τοῦ",709436,35],["θεοῦ",706192,18],["εἰμι",704093,157],["ἐπὶ",705080,0],["τῷ",709436,53],["ὀνόματι",709666,54],["Ισραηλ",706839,18]],"One shall say, I am God's; and another shall call himself by the name of Jacob; and another shall write with his hand, I am God's, and shall call himself by the name of Israel."],["6",[["οὕτως",709859,28],["λέγει",708124,91],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["βασιλεὺς",702580,4],["τοῦ",709436,35],["Ισραηλ",706839,18],["ὁ",709436,3],["ῥυσάμενος",711309,248],["αὐτὸν",702165,85],["θεὸς",706192,4],["σαβαωθ",711346,228],["ἐγὼ",704018,164],["πρῶτος",711041,140],["καὶ",707031,7],["ἐγὼ",704018,164],["μετὰ",708780,0],["ταῦτα",709858,71],["πλὴν",710540,0],["ἐμοῦ",704580,133],["οὐκ",709805,28],["ἔστιν",704093,91],["θεός",706192,4]],"Thus saith God the King of Israel, and the God of hosts that delivered him; I am the first, and I am hereafter: beside me there is no God."],["7",[["τίς",712867,158],["ὥσπερ",714163,28],["ἐγώ",704018,164],["στήτω",706846,45],["καλεσάτω",707084,45],["καὶ",707031,7],["ἑτοιμασάτω",705539,45],["μοι",708974,159],["ἀφ᾿",701425,0],["οὗ",709781,48],["ἐποίησα",710582,155],["ἄνθρωπον",701163,6],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["τὰ",709436,41],["ἐπερχόμενα",705068,67],["πρὸ",710747,0],["τοῦ",709436,20],["ἐλθεῖν",705453,106],["ἀναγγειλάτωσαν",700921,264],["ὑμῖν",713084,90]],"Who is like me? let him stand, and call, and declare, and prepare for me from the time that I made man for ever; and let them tell you the things that are coming before they arrive."],["8",[["μὴ",708851,28],["παρακαλύπτεσθε",710041,73],["οὐκ",709805,28],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["ἠνωτίσασθε",704825,345],["καὶ",707031,7],["ἀπήγγειλα",701321,155],["ὑμῖν",713084,90],["μάρτυρες",708527,52],["ὑμεῖς",713081,219],["ἐστε",704093,87],["εἰ",704071,7],["ἔστιν",704093,91],["θεὸς",706192,4],["πλὴν",710540,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["οὐκ",709805,28],["ἦσαν",704093,137],["τότε",712908,28]],"Hide not yourselves, nor go astray: have ye not heard from the beginning, and [have not] I told you? ye are witnesses if there is a God beside me."],["9",[["οἱ",709436,136],["πλάσσοντες",710503,146],["καὶ",707031,7],["γλύφοντες",703119,146],["πάντες",710177,138],["μάταιοι",708575,138],["οἱ",709436,136],["ποιοῦντες",710582,146],["τὰ",709436,41],["καταθύμια",707253,68],["αὐτῶν",702165,40],["ἃ",709781,69],["οὐκ",709805,28],["ὠφελήσει",714171,127],["αὐτούς",702165,62],["ἀλλὰ",700680,7],["αἰσχυνθήσονται",700485,144]],"But they that framed [false gods] did not then hearken; and they that graved [images] are all vain, performing their own desires, which shall not profit them, but they shall be ashamed"],["10",[["πάντες",710177,138],["οἱ",709436,136],["πλάσσοντες",710503,146],["θεὸν",706192,6],["καὶ",707031,7],["γλύφοντες",703119,146],["ἀνωφελῆ",701303,68]],"that form a god, and all that grave worthless things:"],["11",[["καὶ",707031,7],["πάντες",710177,138],["ὅθεν",709486,28],["ἐγένοντο",703104,189],["ἐξηράνθησαν",709419,99],["καὶ",707031,7],["κωφοὶ",708033,138],["ἀπὸ",701425,0],["ἀνθρώπων",701163,81],["συναχθήτωσαν",712375,51],["πάντες",710177,138],["καὶ",707031,7],["στήτωσαν",706846,264],["ἅμα",700745,28],["ἐντραπήτωσαν",704805,51],["καὶ",707031,7],["αἰσχυνθήτωσαν",700485,51],["ἅμα",700745,28]],"and all by whom they were made are withered: yea, let all the deaf be gathered from [among] men, and let them stand together; and let them be ashamed and confounded together:"],["12",[["ὅτι",709803,7],["ὤξυνεν",709681,2],["τέκτων",712766,4],["σίδηρον",711774,6],["σκεπάρνῳ",711834,54],["εἰργάσατο",705383,23],["αὐτὸ",702165,129],["καὶ",707031,7],["ἐν",704639,0],["τερέτρῳ",712800,54],["ἔτρησεν",712814,2],["αὐτό",702165,129],["εἰργάσατο",705383,23],["αὐτὸ",702165,129],["ἐν",704639,0],["τῷ",709436,113],["βραχίονι",702808,114],["τῆς",709436,16],["ἰσχύος",706858,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["πεινάσει",710222,127],["καὶ",707031,7],["ἀσθενήσει",701938,127],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["πίῃ",710478,172],["ὕδωρ",713071,25],["ἐκλεξάμενος",704236,248]],"For the artificer sharpens the iron; he fashions [the idol] with an axe, and fixes it with an awl, and fashions it with the strength of his arm: and he will be hungry and weak, and will drink no water."],["13",[["τέκτων",712766,4],["ξύλον",709427,25],["ἔστησεν",706846,2],["αὐτὸ",702165,129],["ἐν",704639,0],["μέτρῳ",708846,54],["καὶ",707031,7],["ἐν",704639,0],["κόλλῃ",707792,1],["ἐρρύθμισεν",711306,2],["αὐτό",702165,129],["ἐποίησεν",710582,2],["αὐτὸ",702165,129],["ὡς",714148,28],["μορφὴν",709018,9],["ἀνδρὸς",701150,18],["καὶ",707031,7],["ὡς",714148,28],["ὡραιότητα",714133,6],["ἀνθρώπου",701163,18],["στῆσαι",706846,106],["αὐτὸ",702165,129],["ἐν",704639,0],["οἴκῳ",709516,114]],"The artificer having chosen a piece of wood, marks it out with a rule, and fits it with glue, and makes it as the form of a man, and as the beauty of a man, to set it up in the house."],["14",[["ὃ",709781,213],["ἔκοψεν",707829,2],["ξύλον",709427,25],["ἐκ",704132,0],["τοῦ",709436,35],["δρυμοῦ",703836,18],["ὃ",709781,213],["ἐφύτευσεν",713636,2],["κύριος",707996,4],["καὶ",707031,7],["ὑετὸς",713074,4],["ἐμήκυνεν",708869,13]],"He cuts wood out of the forest, which the Lord planted, [even] a pine tree, and the rain made it grow,"],["15",[["ἵνα",706747,7],["ᾖ",704093,204],["ἀνθρώποις",701163,148],["εἰς",704105,0],["καῦσιν",707565,9],["καὶ",707031,7],["λαβὼν",708076,182],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["ἐθερμάνθη",706213,37],["καὶ",707031,7],["καύσαντες",707049,196],["ἔπεψαν",710432,150],["ἄρτους",701829,57],["ἐπ᾿",705080,0],["αὐτῶν",702165,70],["τὸ",709436,24],["δὲ",703303,11],["λοιπὸν",708247,46],["εἰργάσαντο",705383,189],["εἰς",704105,0],["θεούς",706192,57],["καὶ",707031,7],["προσκυνοῦσιν",710925,197],["αὐτούς",702165,62]],"that it might be for men to burn: and having taken part of it he warms himself; yea, they burn part of it, and bake loaves thereon; and [of] the rest they make for themselves gods, and they worship them."],["16",[["οὗ",709781,48],["τὸ",709436,24],["ἥμισυ",705998,46],["αὐτοῦ",702165,49],["κατέκαυσαν",707258,150],["ἐν",704639,0],["πυρὶ",711088,54],["καὶ",707031,7],["καύσαντες",707049,196],["ἔπεψαν",710432,150],["ἄρτους",701829,57],["ἐπ᾿",705080,0],["αὐτῶν",702165,70],["καὶ",707031,7],["ἐπ᾿",705080,0],["αὐτοῦ",702165,49],["κρέας",707889,25],["ὀπτήσας",709715,182],["ἔφαγεν",713296,2],["καὶ",707031,7],["ἐνεπλήσθη",704592,37],["καὶ",707031,7],["θερμανθεὶς",706213,217],["εἶπεν",705373,2],["ἡδύ",705945,26],["μοι",708974,159],["ὅτι",709803,7],["ἐθερμάνθην",706213,156],["καὶ",707031,7],["εἶδον",709725,155],["πῦρ",711088,25]],"Half thereof he burns in the fire, and with half of it he bakes loaves on the coals; and having roasted flesh on it he eats, and is satisfied, and having warmed himself he says, I am comfortable, for I have warmed myself, and have seen the fire."],["17",[["τὸ",709436,24],["δὲ",703303,11],["λοιπὸν",708247,46],["ἐποίησεν",710582,2],["εἰς",704105,0],["θεὸν",706192,6],["γλυπτὸν",703117,27],["καὶ",707031,7],["προσκυνεῖ",710925,91],["αὐτῷ",702165,50],["καὶ",707031,7],["προσεύχεται",710893,117],["λέγων",708124,72],["ἐξελοῦ",704838,253],["με",708618,163],["ὅτι",709803,7],["θεός",706192,4],["μου",709032,133],["εἶ",704093,154],["σύ",712181,164]],"And the rest he makes a graven god, and worships, and prays, saying, Deliver me; for thou art my God."],["18",[["οὐκ",709805,28],["ἔγνωσαν",703105,150],["φρονῆσαι",713586,106],["ὅτι",709803,7],["ἀπημαυρώθησαν",701339,99],["τοῦ",709436,35],["βλέπειν",702740,55],["τοῖς",709436,147],["ὀφθαλμοῖς",709870,148],["αὐτῶν",702165,40],["καὶ",707031,7],["τοῦ",709436,20],["νοῆσαι",709327,106],["τῇ",709436,100],["καρδίᾳ",707141,1],["αὐτῶν",702165,40]],"They have no understanding to perceive; for they have been blinded so that they should not see with their eyes, nor perceive with their heart."],["19",[["καὶ",707031,7],["οὐκ",709805,28],["ἐλογίσατο",708232,23],["τῇ",709436,100],["καρδίᾳ",707141,1],["αὐτοῦ",702165,102],["οὐδὲ",709816,7],["ἀνελογίσατο",700993,23],["ἐν",704639,0],["τῇ",709436,100],["ψυχῇ",714070,1],["αὐτοῦ",702165,102],["οὐδὲ",709816,7],["ἔγνω",703105,2],["τῇ",709436,100],["φρονήσει",713588,1],["ὅτι",709803,7],["τὸ",709436,24],["ἥμισυ",705998,46],["αὐτοῦ",702165,49],["κατέκαυσεν",707258,2],["ἐν",704639,0],["πυρὶ",711088,54],["καὶ",707031,7],["ἔπεψεν",710432,2],["ἐπὶ",705080,0],["τῶν",709436,80],["ἀνθράκων",701160,81],["αὐτοῦ",702165,49],["ἄρτους",701829,57],["καὶ",707031,7],["ὀπτήσας",709715,182],["κρέας",707889,25],["ἔφαγεν",713296,2],["καὶ",707031,7],["τὸ",709436,24],["λοιπὸν",708247,46],["αὐτοῦ",702165,49],["εἰς",704105,0],["βδέλυγμα",702604,25],["ἐποίησεν",710582,2],["καὶ",707031,7],["προσκυνοῦσιν",710925,197],["αὐτῷ",702165,280]],"And one has not considered in his mind, nor known in his understanding, that he has burnt up half of it in the fire, and baked loaves on the coals thereof and has roasted and eaten flesh, and of the rest of it he has made an abomination, and they worship it."],["20",[["γνῶτε",703105,74],["ὅτι",709803,7],["σποδὸς",712022,12],["ἡ",709436,10],["καρδία",707141,12],["αὐτῶν",702165,70],["καὶ",707031,7],["πλανῶνται",710495,269],["καὶ",707031,7],["οὐδεὶς",709817,26],["δύναται",703838,117],["ἐξελέσθαι",704838,109],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,49],["ἴδετε",709725,74],["οὐκ",709805,28],["ἐρεῖτε",705415,337],["ὅτι",709803,7],["ψεῦδος",714044,15],["ἐν",704639,0],["τῇ",709436,100],["δεξιᾷ",703360,101],["μου",709032,133]],"Know thou that their heart is ashes, and they err, and no one is able to deliver his soul: see, ye will not say, [There is] a lie in my right hand."],["21",[["μνήσθητι",708960,244],["ταῦτα",709858,71],["Ιακωβ",706401,4],["καὶ",707031,7],["Ισραηλ",706839,4],["ὅτι",709803,7],["παῖς",709932,4],["μου",709032,133],["εἶ",704093,154],["σύ",712181,164],["ἔπλασά",710503,155],["σε",711598,163],["παῖδά",709932,6],["μου",709032,133],["καὶ",707031,7],["σύ",712181,164],["Ισραηλ",706839,4],["μὴ",708851,28],["ἐπιλανθάνου",705187,253],["μου",709032,133]],"Remember these things, O Jacob and Israel; for thou art my servant; I have formed thee [to be] my servant: and do thou, Israel, not forget me."],["22",[["ἰδοὺ",706497,88],["γὰρ",702963,11],["ἀπήλειψα",701332,155],["ὡς",714148,28],["νεφέλην",709277,9],["τὰς",709436,38],["ἀνομίας",701192,39],["σου",711945,133],["καὶ",707031,7],["ὡς",714148,28],["γνόφον",703131,6],["τὰς",709436,38],["ἁμαρτίας",700775,39],["σου",711945,133],["ἐπιστράφητι",705278,244],["πρός",710844,0],["με",708618,163],["καὶ",707031,7],["λυτρώσομαί",708282,181],["σε",711598,163]],"For behold, I have blotted out as a cloud thy transgressions, and thy sin as darkness: turn to me, and I will redeem thee."],["23",[["εὐφράνθητε",705715,394],["οὐρανοί",709844,52],["ὅτι",709803,7],["ἠλέησεν",704418,2],["ὁ",709436,3],["θεὸς",706192,4],["τὸν",709436,5],["Ισραηλ",706839,6],["σαλπίσατε",711425,74],["θεμέλια",706181,64],["τῆς",709436,16],["γῆς",703083,17],["βοήσατε",702743,74],["ὄρη",709768,64],["εὐφροσύνην",705717,9],["οἱ",709436,136],["βουνοὶ",702797,52],["καὶ",707031,7],["πάντα",710177,195],["τὰ",709436,63],["ξύλα",709427,64],["τὰ",709436,63],["ἐν",704639,0],["αὐτοῖς",702165,151],["ὅτι",709803,7],["ἐλυτρώσατο",708282,23],["ὁ",709436,3],["θεὸς",706192,4],["τὸν",709436,5],["Ιακωβ",706401,6],["καὶ",707031,7],["Ισραηλ",706839,4],["δοξασθήσεται",703792,134]],"Rejoice, ye heavens; for God has had mercy upon Israel: sound the trumpet, ye foundations of the earth: ye mountains, shout [with] joy, ye hills, and all the trees therein: for God has redeemed Jacob, and Israel shall be glorified."],["24",[["οὕτως",709859,28],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["λυτρούμενός",708282,122],["σε",711598,163],["καὶ",707031,7],["ὁ",709436,3],["πλάσσων",710503,72],["σε",711598,163],["ἐκ",704132,0],["κοιλίας",707761,17],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["συντελῶν",712510,72],["πάντα",710177,68],["ἐξέτεινα",704322,155],["τὸν",709436,5],["οὐρανὸν",709844,6],["μόνος",709003,661],["καὶ",707031,7],["ἐστερέωσα",712076,155],["τὴν",709436,8],["γῆν",703083,9],["τίς",712867,158],["ἕτερος",705535,14]],"Thus saith the Lord that redeems thee, and who formed thee from the womb, I am the Lord that performs all things: I stretched out the heaven alone, and established the earth."],["25",[["διασκεδάσει",703575,127],["σημεῖα",711748,42],["ἐγγαστριμύθων",703938,169],["καὶ",707031,7],["μαντείας",708488,39],["ἀπὸ",701425,0],["καρδίας",707141,17],["ἀποστρέφων",701598,72],["φρονίμους",713589,60],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,28],["καὶ",707031,7],["τὴν",709436,8],["βουλὴν",702792,9],["αὐτῶν",702165,40],["μωρεύων",709107,72]],"Who else will frustrate the tokens of those that have divining spirits, and prophecies from the heart [of man]? turning the wise back, and making their counsel foolishness;"],["26",[["καὶ",707031,7],["ἱστῶν",706846,72],["ῥήματα",711246,42],["παιδὸς",709932,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὴν",709436,8],["βουλὴν",702792,9],["τῶν",709436,80],["ἀγγέλων",700140,81],["αὐτοῦ",702165,102],["ἀληθεύων",700657,72],["ὁ",709436,3],["λέγων",708124,72],["Ιερουσαλημ",706644,1],["κατοικηθήσῃ",707534,364],["καὶ",707031,7],["ταῖς",709436,75],["πόλεσιν",710612,76],["τῆς",709436,16],["Ιουδαίας",706769,17],["οἰκοδομηθήσεσθε",709509,261],["καὶ",707031,7],["τὰ",709436,41],["ἔρημα",705420,68],["αὐτῆς",702165,86],["ἀνατελεῖ",701066,127]],"and confirming the word of his servant, and verifying the counsel of his messengers: who says to Jerusalem, Thou shalt be inhabited; and to the cities of Idumea, Ye shall be built, and her desert places shall spring forth."],["27",[["ὁ",709436,3],["λέγων",708124,72],["τῇ",709436,100],["ἀβύσσῳ",