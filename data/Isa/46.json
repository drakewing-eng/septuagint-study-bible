[["1",[["ἔπεσε",710481,2],["Βηλ",702694,4],["συνετρίβη",712520,37],["Δαγων",703240,4],["ἐγένετο",703104,23],["τὰ",709436,41],["γλυπτὰ",703117,68],["αὐτῶν",702165,40],["εἰς",704105,0],["θηρία",706252,42],["καὶ",707031,7],["κτήνη",707934,42],["αἴρετε",700473,87],["αὐτὰ",702165,71],["καταδεδεμένα",707239,388],["ὡς",714148,28],["φορτίον",713563,25],["κοπιῶντι",707824,98]],"Bel has fallen, Nabo is broken to pieces, their graven images are gone to the wild beasts and the cattle: ye take them packed up as a burden to the weary, exhausted, hungry, and [at the same time] helpless man;"],["2",[["καὶ",707031,7],["πεινῶντι",710222,379],["καὶ",707031,7],["ἐκλελυμένῳ",704254,516],["οὐκ",709805,28],["ἰσχύοντι",706859,379],["ἅμα",700745,28],["οἳ",709781,250],["οὐ",709805,28],["δυνήσονται",703838,135],["σωθῆναι",712627,179],["ἀπὸ",701425,0],["πολέμου",710605,18],["αὐτοὶ",702165,201],["δὲ",703303,11],["αἰχμάλωτοι",700503,138],["ἤχθησαν",700209,99]],"who will not be able to save themselves from war, but they themselves are led [away] captive."],["3",[["ἀκούσατέ",700587,74],["μου",709032,133],["οἶκος",709516,4],["τοῦ",709436,35],["Ιακωβ",706401,18],["καὶ",707031,7],["πᾶν",710177,26],["τὸ",709436,34],["κατάλοιπον",707317,26],["τοῦ",709436,35],["Ισραηλ",706839,18],["οἱ",709436,136],["αἰρόμενοι",700473,645],["ἐκ",704132,0],["κοιλίας",707761,17],["καὶ",707031,7],["παιδευόμενοι",709926,645],["ἐκ",704132,0],["παιδίου",709927,21]],"Hear me, O house of Jacob, and all the remnant of Israel, who are borne [by me] from the womb, and taught [by me] from infancy, [even] to old age:"],["4",[["ἕως",705792,0],["γήρους",703089,21],["ἐγώ",704018,164],["εἰμι",704093,157],["καὶ",707031,7],["ἕως",705792,0],["ἂν",700900,11],["καταγηράσητε",707224,125],["ἐγώ",704018,164],["εἰμι",704093,157],["ἐγὼ",704018,164],["ἀνέχομαι",701140,254],["ὑμῶν",713091,145],["ἐγὼ",704018,164],["ἐποίησα",710582,155],["καὶ",707031,7],["ἐγὼ",704018,164],["ἀνήσω",701169,165],["ἐγὼ",704018,164],["ἀναλήμψομαι",700984,181],["καὶ",707031,7],["σώσω",712627,165],["ὑμᾶς",713080,194]],"I am [he]; and until ye shall have grown old, I am [he]: I bear you, I have made, and I will relieve, I will take up and save you."],["5",[["τίνι",712867,432],["με",708618,163],["ὡμοιώσατε",709628,265],["ἴδετε",709725,74],["τεχνάσασθε",712829,186],["οἱ",709436,136],["πλανώμενοι",710495,348]],"To whom have ye compared me? see, consider, ye that go astray."],["6",[["οἱ",709436,136],["συμβαλλόμενοι",712278,348],["χρυσίον",713972,25],["ἐκ",704132,0],["μαρσιππίου",708521,21],["καὶ",707031,7],["ἀργύριον",701707,25],["ἐν",704639,0],["ζυγῷ",705894,114],["στήσουσιν",706846,218],["ἐν",704639,0],["σταθμῷ",712040,114],["καὶ",707031,7],["μισθωσάμενοι",708940,317],["χρυσοχόον",713979,6],["ἐποίησαν",710582,150],["χειροποίητα",713796,68],["καὶ",707031,7],["κύψαντες",707989,196],["προσκυνοῦσιν",710925,197],["αὐτοῖς",702165,206]],"They that furnish gold out of a purse, and silver by weight, will weigh it in a scale, and they hire a goldsmith and make idols, and bow down, and worship them."],["7",[["αἴρουσιν",700473,197],["αὐτὸ",702165,129],["ἐπὶ",705080,0],["τῶν",709436,80],["ὤμων",714114,81],["καὶ",707031,7],["πορεύονται",710667,269],["ἐὰν",703912,7],["δὲ",703303,11],["θῶσιν",712849,234],["αὐτό",702165,129],["ἐπὶ",705080,0],["τοῦ",709436,35],["τόπου",712903,18],["αὐτοῦ",702165,49],["μένει",708736,91],["οὐ",709805,28],["μὴ",708851,28],["κινηθῇ",707679,384],["καὶ",707031,7],["ὃς",709781,213],["ἂν",700900,11],["βοήσῃ",702743,172],["πρὸς",710844,0],["αὐτόν",702165,85],["οὐ",709805,28],["μὴ",708851,28],["εἰσακούσῃ",704108,172],["ἀπὸ",701425,0],["κακῶν",707066,169],["οὐ",709805,28],["μὴ",708851,28],["σώσῃ",712627,172],["αὐτόν",702165,85]],"They bear it upon the shoulder, and go; and if they put it upon its place, it remains, it cannot move: and whosoever shall cry to it, it cannot hear; it cannot save him from trouble."],["8",[["μνήσθητε",708960,372],["ταῦτα",709858,71],["καὶ",707031,7],["στενάξατε",712066,74],["μετανοήσατε",708809,74],["οἱ",709436,136],["πεπλανημένοι",710495,429],["ἐπιστρέψατε",705278,74],["τῇ",709436,100],["καρδίᾳ",707141,1]],"Remember ye these things, and groan: repent, ye that have gone astray, return in your heart;"],["9",[["καὶ",707031,7],["μνήσθητε",708960,372],["τὰ",709436,41],["πρότερα",710992,68],["ἀπὸ",701425,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["ὅτι",709803,7],["ἐγώ",704018,164],["εἰμι",704093,157],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἔτι",705538,28],["πλὴν",710540,0],["ἐμοῦ",704580,133]],"and remember the former things [that were] of old: for I am God, and there is none other beside me,"],["10",[["ἀναγγέλλων",700921,72],["πρότερον",710991,28],["τὰ",709436,41],["ἔσχατα",705519,68],["πρὶν",710742,28],["αὐτὰ",702165,71],["γενέσθαι",703104,109],["καὶ",707031,7],["ἅμα",700745,28],["συνετελέσθη",712510,37],["καὶ",707031,7],["εἶπα",705373,155],["πᾶσά",710177,29],["μου",709032,133],["ἡ",709436,10],["βουλὴ",702792,12],["στήσεται",706846,93],["καὶ",707031,7],["πάντα",710177,68],["ὅσα",709788,68],["βεβούλευμαι",702791,326],["ποιήσω",710582,165]],"telling beforehand the latter events before they come to pass, and they are accomplished together: and I said, All my counsel shall stand, and I will do all things that I have planned:"],["11",[["καλῶν",707084,72],["ἀπ᾿",701425,0],["ἀνατολῶν",701071,65],["πετεινὸν",710439,25],["καὶ",707031,7],["ἀπὸ",701425,0],["γῆς",703083,17],["πόρρωθεν",710681,28],["περὶ",710285,0],["ὧν",709781,252],["βεβούλευμαι",702791,326],["ἐλάλησα",708071,155],["καὶ",707031,7],["ἤγαγον",700209,155],["ἔκτισα",707938,155],["καὶ",707031,7],["ἐποίησα",710582,155],["ἤγαγον",700209,155],["αὐτὸν",702165,85],["καὶ",707031,7],["εὐόδωσα",705654,155],["τὴν",709436,8],["ὁδὸν",709458,9],["αὐτοῦ",702165,102]],"calling a bird from the east, and from a land afar off, for the things which I have planned: I have spoken, and brought [him]; I have created and made [him]; I have brought him, and prospered his way."],["12",[["ἀκούσατέ",700587,74],["μου",709032,133],["οἱ",709436,136],["ἀπολωλεκότες",701513,586],["τὴν",709436,8],["καρδίαν",707141,9],["οἱ",709436,136],["μακρὰν",708411,28],["ἀπὸ",701425,0],["τῆς",709436,16],["δικαιοσύνης",703695,17]],"Hearken to me, ye senseless ones, that are far from righteousness:"],["13",[["ἤγγισα",703939,155],["τὴν",709436,8],["δικαιοσύνην",703695,9],["μου",709032,133],["καὶ",707031,7],["τὴν",709436,8],["σωτηρίαν",712658,9],["τὴν",709436,8],["παρ᾿",709995,0],["ἐμοῦ",704580,133],["οὐ",709805,28],["βραδυνῶ",702806,165],["δέδωκα",703654,89],["ἐν",704639,0],["Σιων",711816,1],["σωτηρίαν",712658,9],["τῷ",709436,113],["Ισραηλ",706839,114],["εἰς",704105,0],["δόξασμα",703793,25]],"I have brought near my righteousness, and I will not be slow with the salvation that is from me: I have given salvation in Sion to Israel for glory."]]