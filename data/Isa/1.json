[["1",[["ὅρασις",709721,12],["ἣν",709781,131],["εἶδεν",709725,2],["Ησαιας",706026,4],["υἱὸς",713075,4],["Αμως",700898,18],["ἣν",709781,131],["εἶδεν",709725,2],["κατὰ",707200,28],["τῆς",709436,16],["Ιουδαίας",706769,17],["καὶ",707031,7],["κατὰ",707200,28],["Ιερουσαλημ",706644,17],["ἐν",704639,0],["βασιλείᾳ",702577,1],["Οζιου",709474,18],["καὶ",707031,7],["Ιωαθαμ",706885,18],["καὶ",707031,7],["Αχαζ",702245,18],["καὶ",707031,7],["Εζεκιου",704044,18],["οἳ",709781,250],["ἐβασίλευσαν",702581,150],["τῆς",709436,16],["Ιουδαίας",706769,17]],"The vision which Esaias the son of Amos saw, which he saw against Juda and against Jerusalem, in the reign of Ozias, and Joatham, and Achaz, and Ezekias, who reigned over Judea."],["2",[["ἄκουε",700587,240],["οὐρανέ",709844,153],["καὶ",707031,7],["ἐνωτίζου",704825,253],["γῆ",703083,258],["ὅτι",709803,7],["κύριος",707996,4],["ἐλάλησεν",708071,2],["υἱοὺς",713075,57],["ἐγέννησα",703051,155],["καὶ",707031,7],["ὕψωσα",713289,155],["αὐτοὶ",702165,201],["δέ",703303,11],["με",708618,163],["ἠθέτησαν",700369,150]],"Hear, O heaven, and hearken, O earth: for the Lord has spoken, [saying], I have begotten and reared up children, but they have rebelled against me."],["3",[["ἔγνω",703105,2],["βοῦς",702798,4],["τὸν",709436,5],["κτησάμενον",707932,424],["καὶ",707031,7],["ὄνος",709671,4],["τὴν",709436,8],["φάτνην",713391,9],["τοῦ",709436,35],["κυρίου",707996,18],["αὐτοῦ",702165,102],["Ισραηλ",706839,4],["δέ",703303,11],["με",708618,163],["οὐκ",709805,28],["ἔγνω",703105,2],["καὶ",707031,7],["ὁ",709436,3],["λαός",708094,4],["με",708618,163],["οὐ",709805,28],["συνῆκεν",712481,2]],"The ox knows his owner, and the ass his master's crib: but Israel does not know me, and the people has not regarded me."],["4",[["οὐαὶ",709807,88],["ἔθνος",704068,15],["ἁμαρτωλόν",700776,26],["λαὸς",708094,4],["πλήρης",710541,14],["ἁμαρτιῶν",700775,65],["σπέρμα",712008,15],["πονηρόν",710660,26],["υἱοὶ",713075,52],["ἄνομοι",701194,138],["ἐγκατελίπατε",703967,265],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["παρωργίσατε",710167,265],["τὸν",709436,5],["ἅγιον",700159,27],["τοῦ",709436,35],["Ισραηλ",706839,18]],"Ah sinful nation, a people full of sins, an evil seed, lawless children: ye have forsaken the Lord, and provoked the Holy One of Israel."],["5",[["τί",712867,126],["ἔτι",705538,28],["πληγῆτε",710550,394],["προστιθέντες",710965,146],["ἀνομίαν",701192,9],["πᾶσα",710177,29],["κεφαλὴ",707639,12],["εἰς",704105,0],["πόνον",710661,6],["καὶ",707031,7],["πᾶσα",710177,29],["καρδία",707141,12],["εἰς",704105,0],["λύπην",708273,9]],"Why should ye be smitten [any] more, transgressing more and more? the whole head is pained, and the whole heart sad."],["6",[["ἀπὸ",701425,0],["ποδῶν",710707,81],["ἕως",705792,7],["κεφαλῆς",707639,17],["οὔτε",709857,7],["τραῦμα",712920,15],["οὔτε",709857,7],["μώλωψ",709099,4],["οὔτε",709857,7],["πληγὴ",710527,12],["φλεγμαίνουσα",713516,188],["οὐκ",709805,28],["ἔστιν",704093,91],["μάλαγμα",708434,25],["ἐπιθεῖναι",705304,106],["οὔτε",709857,7],["ἔλαιον",704380,25],["οὔτε",709857,7],["καταδέσμους",707237,42]],"From the feet to the head, there is no soundness in them; neither wound, nor bruise, nor festering ulcer [are healed]: it is not possible to apply a plaister, nor oil, nor bandages."],["7",[["ἡ",709436,10],["γῆ",703083,12],["ὑμῶν",713091,145],["ἔρημος",705420,12],["αἱ",709436,190],["πόλεις",710612,191],["ὑμῶν",713091,145],["πυρίκαυστοι",711096,52],["τὴν",709436,8],["χώραν",714011,9],["ὑμῶν",713091,145],["ἐνώπιον",704823,0],["ὑμῶν",713091,145],["ἀλλότριοι",700699,138],["κατεσθίουσιν",707519,197],["αὐτήν",702165,104],["καὶ",707031,7],["ἠρήμωται",705421,23],["κατεστραμμένη",707444,203],["ὑπὸ",713184,0],["λαῶν",708094,81],["ἀλλοτρίων",700699,169]],"Your land is desolate, your cities burned with fire: your land, strangers devour it in your presence, and it is made desolate, overthrown by strange nations."],["8",[["ἐγκαταλειφθήσεται",703967,134],["ἡ",709436,10],["θυγάτηρ",706320,12],["Σιων",711816,17],["ὡς",714148,28],["σκηνὴ",711845,12],["ἐν",704639,0],["ἀμπελῶνι",700872,114],["καὶ",707031,7],["ὡς",714148,28],["ὀπωροφυλάκιον",709718,15],["ἐν",704639,0],["σικυηράτῳ",711787,54],["ὡς",714148,28],["πόλις",710612,12],["πολιορκουμένη",710608,211]],"The daughter of Sion shall be deserted as a tent in a vineyard, and as a storehouse of fruits in a garden of cucumbers, as a besieged city."],["9",[["καὶ",707031,7],["εἰ",704071,7],["μὴ",708851,28],["κύριος",707996,4],["σαβαωθ",711346,228],["ἐγκατέλιπεν",703967,2],["ἡμῖν",705994,90],["σπέρμα",712008,25],["ὡς",714148,28],["Σοδομα",711920,9],["ἂν",700900,11],["ἐγενήθημεν",703104,485],["καὶ",707031,7],["ὡς",714148,28],["Γομορρα",703165,9],["ἂν",700900,11],["ὡμοιώθημεν",709628,485]],"And if the Lord of Sabaoth had not left us a seed, we should have been as Sodoma, and we should have been made like to Gomorrha."],["10",[["ἀκούσατε",700587,74],["λόγον",708236,6],["κυρίου",707996,18],["ἄρχοντες",701862,52],["Σοδομων",711920,17],["προσέχετε",710895,335],["νόμον",709349,6],["θεοῦ",706192,18],["λαὸς",708094,4],["Γομορρας",703165,17]],"Hear the word of the Lord, ye rulers of Sodoma; attend to the law of God, thou people of Gomorrha."],["11",[["τί",712867,126],["μοι",708974,159],["πλῆθος",710529,4],["τῶν",709436,130],["θυσιῶν",706345,65],["ὑμῶν",713091,145],["λέγει",708124,91],["κύριος",707996,4],["πλήρης",710541,29],["εἰμὶ",704093,157],["ὁλοκαυτωμάτων",709589,44],["κριῶν",707906,81],["καὶ",707031,7],["στέαρ",712054,25],["ἀρνῶν",701731,81],["καὶ",707031,7],["αἷμα",700442,25],["ταύρων",712734,81],["καὶ",707031,7],["τράγων",712917,81],["οὐ",709805,28],["βούλομαι",702795,254]],"Of what [value] to me is the abundance of your sacrifices? saith the Lord: I am full of whole-burnt-offerings of rams; and I delight not in the fat of lambs, and the blood of bulls and goats:"],["12",[["οὐδ᾿",709816,7],["ἐὰν",703912,7],["ἔρχησθε",705453,375],["ὀφθῆναί",709725,179],["μοι",708974,159],["τίς",712867,158],["γὰρ",702963,11],["ἐξεζήτησεν",704187,2],["ταῦτα",709858,71],["ἐκ",704132,0],["τῶν",709436,130],["χειρῶν",713787,65],["ὑμῶν",713091,145],["πατεῖν",710187,55],["τὴν",709436,8],["αὐλήν",702137,9],["μου",709032,133]],"neither shall ye come [with these] to appear before me; for who has required these things at your hands? Ye shall no more tread my court."],["13",[["οὐ",709805,28],["προσθήσεσθε",710965,124],["ἐὰν",703912,7],["φέρητε",713428,355],["σεμίδαλιν",711675,9],["μάταιον",708575,46],["θυμίαμα",706330,25],["βδέλυγμά",702604,15],["μοί",708974,159],["ἐστιν",704093,91],["τὰς",709436,38],["νουμηνίας",709371,39],["ὑμῶν",713091,145],["καὶ",707031,7],["τὰ",709436,63],["σάββατα",711350,64],["καὶ",707031,7],["ἡμέραν",705984,9],["μεγάλην",708653,36],["οὐκ",709805,28],["ἀνέχομαι",701140,254],["νηστείαν",709303,9],["καὶ",707031,7],["ἀργίαν",701702,9]],"Though ye bring fine flour, [it is] vain; incense is an abomination to me; I cannot bear your new moons, and your sabbaths, and the great day;"],["14",[["καὶ",707031,7],["τὰς",709436,38],["νουμηνίας",709371,39],["ὑμῶν",713091,145],["καὶ",707031,7],["τὰς",709436,38],["ἑορτὰς",704990,39],["ὑμῶν",713091,145],["μισεῖ",708935,91],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ἐγενήθητέ",703104,472],["μοι",708974,159],["εἰς",704105,0],["πλησμονήν",710549,9],["οὐκέτι",709827,28],["ἀνήσω",701169,165],["τὰς",709436,38],["ἁμαρτίας",700775,39],["ὑμῶν",713091,145]],"[your] fasting, and rest from work, your new moons also, and your feasts my soul hates: ye have become loathsome to me; I will no more pardon your sins."],["15",[["ὅταν",709801,28],["τὰς",709436,38],["χεῖρας",713787,39],["ἐκτείνητε",704322,125],["πρός",710844,0],["με",708618,163],["ἀποστρέψω",701598,165],["τοὺς",709436,58],["ὀφθαλμούς",709870,57],["μου",709032,133],["ἀφ᾿",701425,0],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐὰν",703912,7],["πληθύνητε",710530,355],["τὴν",709436,8],["δέησιν",703311,9],["οὐκ",709805,28],["εἰσακούσομαι",704108,181],["ὑμῶν",713091,145],["αἱ",709436,190],["γὰρ",702963,11],["χεῖρες",713787,191],["ὑμῶν",713091,145],["αἵματος",700442,21],["πλήρεις",710541,138]],"When ye stretch forth your hands, I will turn away mine eyes from you: and though ye make many supplications, I will not hearken to you; for your hands are full of blood."],["16",[["λούσασθε",708258,186],["καθαροὶ",706988,138],["γένεσθε",703104,186],["ἀφέλετε",702177,74],["τὰς",709436,38],["πονηρίας",710659,39],["ἀπὸ",701425,0],["τῶν",709436,130],["ψυχῶν",714070,65],["ὑμῶν",713091,145],["ἀπέναντι",701389,28],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["μου",709032,133],["παύσασθε",710202,186],["ἀπὸ",701425,0],["τῶν",709436,130],["πονηριῶν",710659,65],["ὑμῶν",713091,145]],"Wash you, be clean; remove your iniquities from your souls before mine eyes; cease from your iniquities;"],["17",[["μάθετε",708480,74],["καλὸν",707097,27],["ποιεῖν",710582,55],["ἐκζητήσατε",704187,74],["κρίσιν",707908,9],["ῥύσασθε",711309,372],["ἀδικούμενον",700269,212],["κρίνατε",707905,74],["ὀρφανῷ",709779,30],["καὶ",707031,7],["δικαιώσατε",703696,74],["χήραν",713848,9]],"learn to do well; diligently seek judgment, deliver him that is suffering wrong, plead for the orphan, and obtain justice for the widow."],["18",[["καὶ",707031,7],["δεῦτε",703383,28],["καὶ",707031,7],["διελεγχθῶμεν",703661,79],["λέγει",708124,91],["κύριος",707996,4],["καὶ",707031,7],["ἐὰν",703912,7],["ὦσιν",704093,234],["αἱ",709436,190],["ἁμαρτίαι",700775,191],["ὑμῶν",713091,145],["ὡς",714148,28],["φοινικοῦν",713539,26],["ὡς",714148,28],["χιόνα",713866,36],["λευκανῶ",708162,165],["ἐὰν",703912,7],["δὲ",703303,11],["ὦσιν",704093,271],["ὡς",714148,28],["κόκκινον",707783,27],["ὡς",714148,28],["ἔριον",705426,25],["λευκανῶ",708162,165]],"And come, let us reason together, saith the Lord: and though your sins be as purple, I will make them white as snow; and though they be as scarlet, I will make [them] white as wool."],["19",[["καὶ",707031,7],["ἐὰν",703912,7],["θέλητε",706176,355],["καὶ",707031,7],["εἰσακούσητέ",704108,125],["μου",709032,133],["τὰ",709436,41],["ἀγαθὰ",700106,68],["τῆς",709436,16],["γῆς",703083,17],["φάγεσθε",705495,124]],"And if ye be willing, and hearken to me, ye shall eat the good of the land:"],["20",[["ἐὰν",703912,7],["δὲ",703303,11],["μὴ",708851,28],["θέλητε",706176,355],["μηδὲ",708855,7],["εἰσακούσητέ",704108,125],["μου",709032,133],["μάχαιρα",708593,12],["ὑμᾶς",713080,194],["κατέδεται",707519,93],["τὸ",709436,24],["γὰρ",702963,11],["στόμα",712125,15],["κυρίου",707996,18],["ἐλάλησεν",708071,2],["ταῦτα",709858,71]],"but if ye be not willing, nor hearken to me, a sword shall devour you: for the mouth of the Lord has spoken this."],["21",[["πῶς",711121,28],["ἐγένετο",703104,23],["πόρνη",710675,12],["πόλις",710612,12],["πιστὴ",710486,29],["Σιων",711816,12],["πλήρης",710541,14],["κρίσεως",707908,17],["ἐν",704639,0],["ᾗ",709781,108],["δικαιοσύνη",703695,12],["ἐκοιμήθη",707767,37],["ἐν",704639,0],["αὐτῇ",702165,105],["νῦν",709384,28],["δὲ",703303,11],["φονευταί",713545,52]],"How has the faithful city Sion, [once] full of judgment, become a harlot! wherein righteousness lodged, but now murderers."],["22",[["τὸ",709436,24],["ἀργύριον",701707,15],["ὑμῶν",713091,145],["ἀδόκιμον",700280,14],["οἱ",709436,136],["κάπηλοί",707129,52],["σου",711945,133],["μίσγουσι",708934,197],["τὸν",709436,5],["οἶνον",709530,6],["ὕδατι",713071,54]],"Your silver is worthless, thy wine merchants mix the wine with water."],["23",[["οἱ",709436,136],["ἄρχοντές",701862,52],["σου",711945,133],["ἀπειθοῦσιν",701370,197],["κοινωνοὶ",707777,52],["κλεπτῶν",707714,81],["ἀγαπῶντες",700120,146],["δῶρα",703907,42],["διώκοντες",703768,146],["ἀνταπόδομα",701216,25],["ὀρφανοῖς",709779,230],["οὐ",709805,28],["κρίνοντες",707905,146],["καὶ",707031,7],["κρίσιν",707908,9],["χηρῶν",713848,65],["οὐ",709805,28],["προσέχοντες",710895,146]],"Thy princes are rebellious, companions of thieves, loving bribes, seeking after rewards; not pleading for orphans, and not heeding the cause of widows."],["24",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["ὁ",709436,3],["δεσπότης",703379,4],["κύριος",707996,4],["σαβαωθ",711346,228],["οὐαὶ",709807,88],["οἱ",709436,136],["ἰσχύοντες",706859,146],["Ισραηλ",706839,18],["οὐ",709805,28],["παύσεται",710202,93],["γάρ",702963,11],["μου",709032,133],["ὁ",709436,3],["θυμὸς",706334,4],["ἐν",704639,0],["τοῖς",709436,147],["ὑπεναντίοις",713109,230],["καὶ",707031,7],["κρίσιν",707908,9],["ἐκ",704132,0],["τῶν",709436,80],["ἐχθρῶν",705779,81],["μου",709032,133],["ποιήσω",710582,165]],"Therefore thus saith the Lord, the Lord of hosts, Woe to the mighty [men] of Israel; for my wrath shall not cease against mine adversaries, and I will execute judgment on mine enemies."],["25",[["καὶ",707031,7],["ἐπάξω",704994,165],["τὴν",709436,8],["χεῖρά",713787,9],["μου",709032,133],["ἐπὶ",705080,0],["σὲ",711598,163],["καὶ",707031,7],["πυρώσω",711103,165],["σε",711598,163],["εἰς",704105,0],["καθαρόν",706988,27],["τοὺς",709436,58],["δὲ",703303,11],["ἀπειθοῦντας",701370,235],["ἀπολέσω",701513,207],["καὶ",707031,7],["ἀφελῶ",702177,165],["πάντας",710177,60],["ἀνόμους",701194,60],["ἀπὸ",701425,0],["σοῦ",711945,133],["καὶ",707031,7],["πάντας",710177,60],["ὑπερηφάνους",713139,60],["ταπεινώσω",712717,165]],"And I will bring my hand upon thee, and purge thee completely, and I will destroy the rebellious, and will take away from thee all transgressors."],["26",[["καὶ",707031,7],["ἐπιστήσω",705756,165],["τοὺς",709436,58],["κριτάς",707910,57],["σου",711945,133],["ὡς",714148,28],["τὸ",709436,24],["πρότερον",710991,14],["καὶ",707031,7],["τοὺς",709436,58],["συμβούλους",712295,57],["σου",711945,133],["ὡς",714148,28],["τὸ",709436,24],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["καὶ",707031,7],["μετὰ",708780,0],["ταῦτα",709858,71],["κληθήσῃ",707084,364],["πόλις",710612,12],["δικαιοσύνης",703695,17],["μητρόπολις",708895,12],["πιστὴ",710486,29],["Σιων",711816,9]],"And I will establish thy judges as before, and thy counsellors as at the beginning: and afterward thou shalt be called the city of righteousness, the faithful mother-city Sion."],["27",[["μετὰ",708780,0],["γὰρ",702963,11],["κρίματος",707903,21],["σωθήσεται",712627,134],["ἡ",709436,10],["αἰχμαλωσία",700499,12],["αὐτῆς",702165,86],["καὶ",707031,7],["μετὰ",708780,0],["ἐλεημοσύνης",704421,17]],"For her captives shall be saved with judgment, and with mercy."],["28",[["καὶ",707031,7],["συντριβήσονται",712520,144],["οἱ",709436,136],["ἄνομοι",701194,138],["καὶ",707031,7],["οἱ",709436,136],["ἁμαρτωλοὶ",700776,138],["ἅμα",700745,28],["καὶ",707031,7],["οἱ",709436,136],["ἐγκαταλείποντες",703967,146],["τὸν",709436,5],["κύριον",707996,6],["συντελεσθήσονται",712510,144]],"And the transgressors and the sinners shall be crushed together, and they that forsake the Lord shall be utterly consumed."],["29",[["διότι",703734,7],["αἰσχυνθήσονται",700485,144],["ἐπὶ",705080,0],["τοῖς",709436,95],["εἰδώλοις",704079,96],["αὐτῶν",702165,40],["ἃ",709781,69],["αὐτοὶ",702165,201],["ἠβούλοντο",702795,189],["καὶ",707031,7],["ἐπῃσχύνθησαν",705003,99],["ἐπὶ",705080,0],["τοῖς",709436,147],["κήποις",707654,148],["αὐτῶν",702165,40],["ἃ",709781,69],["ἐπεθύμησαν",705141,150]],"For they shall be ashamed of their idols, which they delighted in, and they are made ashamed of the gardens which they coveted."],["30",[["ἔσονται",704093,135],["γὰρ",702963,11],["ὡς",714148,28],["τερέβινθος",712798,12],["ἀποβεβληκυῖα",701427,287],["τὰ",709436,41],["φύλλα",713622,42],["καὶ",707031,7],["ὡς",714148,28],["παράδεισος",710012,4],["ὕδωρ",713071,15],["μὴ",708851,28],["ἔχων",705785,72]],"For they shall be as a turpentine tree that has cast its leaves, and as a garden that has no water."],["31",[["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["ἰσχὺς",706858,12],["αὐτῶν",702165,284],["ὡς",714148,28],["καλάμη",707079,12],["στιππύου",712111,92],["καὶ",707031,7],["αἱ",709436,190],["ἐργασίαι",705385,191],["αὐτῶν",702165,284],["ὡς",714148,28],["σπινθῆρες",712015,42],["πυρός",711088,21],["καὶ",707031,7],["κατακαυθήσονται",707258,144],["οἱ",709436,136],["ἄνομοι",701194,138],["καὶ",707031,7],["ο