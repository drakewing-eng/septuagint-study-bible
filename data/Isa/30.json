[["1",[["οὐαὶ",709807,88],["τέκνα",712761,64],["ἀποστάται",701590,52],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἐποιήσατε",710582,265],["βουλὴν",702792,9],["οὐ",709805,28],["δι᾿",703417,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["συνθήκας",712477,39],["οὐ",709805,28],["διὰ",703417,0],["τοῦ",709436,35],["πνεύματός",710566,21],["μου",709032,133],["προσθεῖναι",710965,106],["ἁμαρτίας",700775,17],["ἐφ᾿",705080,0],["ἁμαρτίαις",700775,76]],"Woe to the apostate children, saith the Lord: ye have framed counsel, not by me, and covenants not by my Spirit, to add sins to sins:"],["2",[["οἱ",709436,136],["πορευόμενοι",710667,348],["καταβῆναι",707202,106],["εἰς",704105,0],["Αἴγυπτον",700401,9],["ἐμὲ",704555,163],["δὲ",703303,11],["οὐκ",709805,28],["ἐπηρώτησαν",705069,150],["τοῦ",709436,20],["βοηθηθῆναι",702746,179],["ὑπὸ",713184,0],["Φαραω",713360,18],["καὶ",707031,7],["σκεπασθῆναι",711832,179],["ὑπὸ",713184,0],["Αἰγυπτίων",700400,65]],"[even] they that proceed to go down into Egypt, but they have not enquired of me, that they might be helped by Pharao, and protected by the Egyptians."],["3",[["ἔσται",704093,93],["γὰρ",702963,11],["ὑμῖν",713084,90],["ἡ",709436,10],["σκέπη",711839,12],["Φαραω",713360,18],["εἰς",704105,0],["αἰσχύνην",700483,9],["καὶ",707031,7],["τοῖς",709436,147],["πεποιθόσιν",710221,536],["ἐπ᾿",705080,0],["Αἴγυπτον",700401,9],["ὄνειδος",709658,25]],"For the protection of Pharao shall be to you a disgrace, and [there shall be] a reproach to them that trust in Egypt."],["4",[["ὅτι",709803,7],["εἰσὶν",704093,197],["ἐν",704639,0],["Τάνει",712708,1],["ἀρχηγοὶ",701838,52],["ἄγγελοι",700140,52],["πονηροί",710660,138],["μάτην",708582,28],["κοπιάσουσιν",707824,218]],"For there are princes in Tanes, evil messengers."],["5",[["πρὸς",710844,0],["λαόν",708094,6],["ὃς",709781,213],["οὐκ",709805,28],["ὠφελήσει",714171,127],["αὐτοὺς",702165,62],["οὔτε",709857,7],["εἰς",704105,0],["βοήθειαν",702745,9],["οὔτε",709857,7],["εἰς",704105,0],["ὠφέλειαν",714170,9],["ἀλλὰ",700680,7],["εἰς",704105,0],["αἰσχύνην",700483,9],["καὶ",707031,7],["ὄνειδος",709658,25]],"In vain shall they labour [in seeking] to a people, which shall not profit them for help, but [shall be] for a shame and reproach."],["6",[["ἡ",709436,10],["ὅρασις",709721,12],["τῶν",709436,80],["τετραπόδων",712823,169],["τῶν",709436,80],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,101],["ἐν",704639,0],["τῇ",709436,100],["θλίψει",706276,1],["καὶ",707031,7],["τῇ",709436,100],["στενοχωρίᾳ",712071,1],["λέων",708171,4],["καὶ",707031,7],["σκύμνος",711903,4],["λέοντος",708171,18],["ἐκεῖθεν",704182,28],["καὶ",707031,7],["ἀσπίδες",701991,191],["καὶ",707031,7],["ἔκγονα",704159,195],["ἀσπίδων",701991,65],["πετομένων",710441,522],["οἳ",709781,250],["ἔφερον",713428,137],["ἐπ᾿",705080,0],["ὄνων",709671,81],["καὶ",707031,7],["καμήλων",707110,81],["τὸν",709436,5],["πλοῦτον",710563,6],["αὐτῶν",702165,40],["πρὸς",710844,0],["ἔθνος",704068,25],["ὃ",709781,213],["οὐκ",709805,28],["ὠφελήσει",714171,127],["αὐτοὺς",702165,62],["εἰς",704105,0],["βοήθειαν",702745,9],["ἀλλὰ",700680,7],["εἰς",704105,0],["αἰσχύνην",700483,9],["καὶ",707031,7],["ὄνειδος",709658,25]],"The Vision of the Quadrupeds in the Desert. In affliction and distress, [where are] the lion and lion's whelp, thence [come] also asps, and the young of flying asps, [there shall they be] who bore their wealth on asses and camels to a nation which shall not profit them.",{"s":"d","q":0.69}],["7",[["Αἰγύπτιοι",700400,52],["μάταια",708575,195],["καὶ",707031,7],["κενὰ",707612,195],["ὠφελήσουσιν",714171,218],["ὑμᾶς",713080,194],["ἀπάγγειλον",701321,176],["αὐτοῖς",702165,151],["ὅτι",709803,7],["ματαία",708575,29],["ἡ",709436,10],["παράκλησις",710047,12],["ὑμῶν",713091,145],["αὕτη",709858,107]],"The Egyptians shall help you utterly in vain: tell them, This your consolation is vain."],["8",[["νῦν",709384,28],["οὖν",709835,11],["καθίσας",707006,182],["γράψον",703194,176],["ἐπὶ",705080,0],["πυξίου",711086,21],["ταῦτα",709858,71],["καὶ",707031,7],["εἰς",704105,0],["βιβλίον",702719,25],["ὅτι",709803,7],["ἔσται",704093,93],["εἰς",704105,0],["ἡμέρας",705984,17],["καιρῶν",707047,81],["ταῦτα",709858,71],["καὶ",707031,7],["ἕως",705792,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"Now then sit down and write these words on a tablet, and in a book; for these things shall be for [many long] days, and even for ever."],["9",[["ὅτι",709803,7],["λαὸς",708094,4],["ἀπειθής",701371,14],["ἐστιν",704093,91],["υἱοὶ",713075,52],["ψευδεῖς",714036,138],["οἳ",709781,250],["οὐκ",709805,28],["ἠβούλοντο",702795,139],["ἀκούειν",700587,55],["τὸν",709436,5],["νόμον",709349,6],["τοῦ",709436,35],["θεοῦ",706192,18]],"For the people is disobedient, false children, who would not hear the law of God:"],["10",[["οἱ",709436,136],["λέγοντες",708124,146],["τοῖς",709436,147],["προφήταις",711009,148],["μὴ",708851,28],["ἀναγγέλλετε",700921,335],["ἡμῖν",705994,90],["καὶ",707031,7],["τοῖς",709436,147],["τὰ",709436,41],["ὁράματα",709720,42],["ὁρῶσιν",709725,197],["μὴ",708851,28],["λαλεῖτε",708071,335],["ἡμῖν",705994,90],["ἀλλὰ",700680,7],["ἡμῖν",705994,90],["λαλεῖτε",708071,335],["καὶ",707031,7],["ἀναγγέλλετε",700921,335],["ἡμῖν",705994,90],["ἑτέραν",705535,36],["πλάνησιν",710497,9]],"who say to the prophets, Report not to us; and to them that see visions, Speak [them] not to us, but speak and report to us another error;"],["11",[["καὶ",707031,7],["ἀποστρέψατε",701598,74],["ἡμᾶς",705981,194],["ἀπὸ",701425,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["ταύτης",709858,86],["ἀφέλετε",702177,74],["ἀφ᾿",701425,0],["ἡμῶν",705999,145],["τὸν",709436,5],["τρίβον",712939,6],["τοῦτον",709858,85],["καὶ",707031,7],["ἀφέλετε",702177,74],["ἀφ᾿",701425,0],["ἡμῶν",705999,145],["τὸν",709436,5],["ἅγιον",700159,27],["τοῦ",709436,35],["Ισραηλ",706839,18]],"and turn us aside from this way; remove from us this path, and remove from us the oracle of Israel."],["12",[["διὰ",703417,0],["τοῦτο",709858,129],["οὕτως",709859,28],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["ἅγιος",700159,14],["τοῦ",709436,35],["Ισραηλ",706839,18],["ὅτι",709803,7],["ἠπειθήσατε",701370,265],["τοῖς",709436,147],["λόγοις",708236,148],["τούτοις",709858,151],["καὶ",707031,7],["ἠλπίσατε",704529,265],["ἐπὶ",705080,0],["ψεύδει",714044,54],["καὶ",707031,7],["ὅτι",709803,7],["ἐγόγγυσας",703144,162],["καὶ",707031,7],["πεποιθὼς",710221,270],["ἐγένου",703104,174],["ἐπὶ",705080,0],["τῷ",709436,113],["λόγῳ",708236,114],["τούτῳ",709858,50]],"Therefore thus saith the Holy One of Israel, Because ye have refused to obey these words, and have trusted in falsehood; and because thou hast murmured, and been confident in this respect:"],["13",[["διὰ",703417,0],["τοῦτο",709858,129],["ἔσται",704093,93],["ὑμῖν",713084,90],["ἡ",709436,10],["ἁμαρτία",700775,12],["αὕτη",709858,107],["ὡς",714148,28],["τεῖχος",712759,25],["πῖπτον",710481,47],["παραχρῆμα",710119,28],["πόλεως",710612,17],["ὀχυρᾶς",709889,82],["ἑαλωκυίας",700673,479],["ἧς",709781,167],["παραχρῆμα",710119,28],["πάρεστιν",710126,91],["τὸ",709436,34],["πτῶμα",711071,15]],"therefore shall this sin be to you as a wall suddenly falling when a strong city has been taken, of which the fall is very near at hand."],["14",[["καὶ",707031,7],["τὸ",709436,34],["πτῶμα",711071,15],["αὐτῆς",702165,86],["ἔσται",704093,93],["ὡς",714148,28],["σύντριμμα",712521,25],["ἀγγείου",700138,21],["ὀστρακίνου",709795,92],["ἐκ",704132,0],["κεραμίου",707621,21],["λεπτὰ",708153,68],["ὥστε",714164,7],["μὴ",708851,28],["εὑρεῖν",705676,106],["ἐν",704639,0],["αὐτοῖς",702165,206],["ὄστρακον",709796,25],["ἐν",704639,0],["ᾧ",709781,209],["πῦρ",711088,25],["ἀρεῖς",700473,166],["καὶ",707031,7],["ἐν",704639,0],["ᾧ",709781,209],["ἀποσυριεῖς",701602,166],["ὕδωρ",713071,25],["μικρόν",708915,46]],"And the fall thereof shall be as the breaking of an earthen vessel, [as] small fragments of a pitcher, so that thou shouldest not find among them a sherd, with which thou mightest take up fire, and with which thou shouldest draw a little water."],["15",[["οὕτω",709859,28],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["ἅγιος",700159,14],["τοῦ",709436,35],["Ισραηλ",706839,18],["ὅταν",709801,28],["ἀποστραφεὶς",701598,217],["στενάξῃς",712066,175],["τότε",712908,28],["σωθήσῃ",712627,364],["καὶ",707031,7],["γνώσῃ",703105,123],["ποῦ",710706,28],["ἦσθα",704093,363],["ὅτε",709802,28],["ἐπεποίθεις",710221,508],["ἐπὶ",705080,0],["τοῖς",709436,95],["ματαίοις",708575,94],["ματαία",708575,29],["ἡ",709436,10],["ἰσχὺς",706858,12],["ὑμῶν",713091,145],["ἐγενήθη",703104,37],["καὶ",707031,7],["οὐκ",709805,28],["ἠβούλεσθε",702795,501],["ἀκούειν",700587,55]],"Thus saith the Lord, the Holy Lord of Israel; When thou shalt turn and mourn, then thou shalt be saved; and thou shalt know where thou wast, when thou didst trust in vanities: [then] your strength became vain, yet ye would not hearken:"],["16",[["ἀλλ᾿",700680,7],["εἴπατε",705373,265],["ἐφ᾿",705080,0],["ἵππων",706790,81],["φευξόμεθα",713433,141],["διὰ",703417,0],["τοῦτο",709858,129],["φεύξεσθε",713433,124],["καὶ",707031,7],["εἴπατε",705373,265],["ἐπὶ",705080,0],["κούφοις",707863,230],["ἀναβάται",700909,52],["ἐσόμεθα",704093,141],["διὰ",703417,0],["τοῦτο",709858,129],["κοῦφοι",707863,138],["ἔσονται",704093,135],["οἱ",709436,136],["διώκοντες",703768,146],["ὑμᾶς",713080,194]],"but ye said, We will flee upon horses; therefore shall ye flee: and, We will be aided by swift riders; therefore shall they that pursue you be swift."],["17",[["διὰ",703417,0],["φωνὴν",713640,9],["ἑνὸς",704106,116],["φεύξονται",713433,135],["χίλιοι",713859,138],["καὶ",707031,7],["διὰ",703417,0],["φωνὴν",713640,9],["πέντε",710266,59],["φεύξονται",713433,135],["πολλοί",710646,138],["ἕως",705792,7],["ἂν",700900,11],["καταλειφθῆτε",707305,394],["ὡς",714148,28],["ἱστὸς",706850,4],["ἐπ᾿",705080,0],["ὄρους",709768,21],["καὶ",707031,7],["ὡς",714148,28],["σημαίαν",711744,9],["φέρων",713428,72],["ἐπὶ",705080,0],["βουνοῦ",702797,18]],"A thousand shall flee because of the voice of one, and many shall flee on account of the voice of five; until ye be left as a signal-post upon a mountain, and as one bearing an ensign upon a hill."],["18",[["καὶ",707031,7],["πάλιν",709942,28],["μενεῖ",708736,127],["ὁ",709436,3],["θεὸς",706192,4],["τοῦ",709436,35],["οἰκτιρῆσαι",709518,106],["ὑμᾶς",713080,194],["καὶ",707031,7],["διὰ",703417,0],["τοῦτο",709858,129],["ὑψωθήσεται",713289,134],["τοῦ",709436,35],["ἐλεῆσαι",704418,106],["ὑμᾶς",713080,194],["διότι",703734,7],["κριτὴς",707910,4],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["ἐστιν",704093,91],["καὶ",707031,7],["ποῦ",710706,28],["καταλείψετε",707305,337],["τὴν",709436,8],["δόξαν",703791,9],["ὑμῶν",713091,145],["μακάριοι",708397,138],["οἱ",709436,136],["ἐμμένοντες",704570,146],["ἐν",704639,0],["αὐτῷ",702165,50]],"And the Lord will again wait, that he may pity you, and will therefore be exalted that he may have mercy upon you: because the Lord your God is a judge: blessed are they that stay themselves upon him."],["19",[["διότι",703734,7],["λαὸς",708094,4],["ἅγιος",700159,14],["ἐν",704639,0],["Σιων",711816,1],["οἰκήσει",709499,127],["καὶ",707031,7],["Ιερουσαλημ",706644,12],["κλαυθμῷ",707705,114],["ἔκλαυσεν",707703,2],["ἐλέησόν",704418,176],["με",708618,163],["ἐλεήσει",704418,127],["σε",711598,163],["τὴν",709436,8],["φωνὴν",713640,9],["τῆς",709436,16],["κραυγῆς",707886,17],["σου",711945,133],["ἡνίκα",706008,28],["εἶδεν",709725,2],["ἐπήκουσέν",705009,2],["σου",711945,133]],"For the holy people shall dwell in Sion: and [whereas] Jerusalem has wept bitterly, [saying], Pity me; he shall pity thee: when he perceived the voice of thy cry, he hearkened to thee."],["20",[["καὶ",707031,7],["δώσει",703654,127],["κύριος",707996,4],["ὑμῖν",713084,90],["ἄρτον",701829,6],["θλίψεως",706276,17],["καὶ",707031,7],["ὕδωρ",713071,25],["στενόν",712068,46],["καὶ",707031,7],["οὐκέτι",709827,28],["μὴ",708851,28],["ἐγγίσωσίν",703939,234],["σοι",711925,159],["οἱ",709436,136],["πλανῶντές",710495,146],["σε",711598,163],["ὅτι",709803,7],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["σου",711945,133],["ὄψονται",709725,135],["τοὺς",709436,58],["πλανῶντάς",710495,235],["σε",711598,163]],"And [though] the Lord shall give you the bread of affliction and scant water, yet they that cause thee to err shall no more at all draw nigh to thee; for thine eyes shall see those that cause thee to err,"],["21",[["καὶ",707031,7],["τὰ",709436,63],["ὦτά",709852,64],["σου",711945,133],["ἀκούσονται",700587,135],["τοὺς",709436,58],["λόγους",708236,57],["τῶν",709436,80],["ὀπίσω",709697,28],["σε",711598,163],["πλανησάντων",710495,221],["οἱ",709436,136],["λέγοντες",708124,146],["αὕτη",709858,107],["ἡ",709436,10],["ὁδός",709458,12],["πορευθῶμεν",710667,283],["ἐν",704639,0],["αὐτῇ",702165,105],["εἴτε",704130,738],["δεξιὰ",703360,29],["εἴτε",704130,738],["ἀριστερά",701749,29]],"and thine ears shall hear the words of them that went after thee to lead thee astray, who say, This [is] the way, let us walk in it, whether to the right or to the left."],["22",[["καὶ",707031,7],["ἐξαρεῖς",704839,166],["τὰ",709436,41],["εἴδωλα",704079,42],["τὰ",709436,41],["περιηργυρωμένα",710292,388],["καὶ",707031,7],["τὰ",709436,41],["περικεχρυσωμένα",710422,388],["λεπτὰ",708153,68],["ποιήσεις",710582,166],["καὶ",707031,7],["λικμήσεις",708202,166,337],["ὡς",714148,28],["ὕδωρ",713071,15],["ἀποκαθημένης",701469,422],["καὶ",707031,7],["ὡς",714148,28],["κόπρον",707828,9],["ὤσεις",714100,166],["αὐτά",702165,71]],"And thou shalt pollute the plated idols, and thou shalt grind to powder the gilt ones, and shalt scatter them as the water of a removed [woman], and thou shalt thrust them forth as dung."],["23",[["τότε",712908,28],["ἔσται",704093,93],["ὁ",709436,3],["ὑετὸς",713074,4],["τῷ",709436,53],["σπέρματι",712008,54],["τῆς",709436,16],["γῆς",703083,17],["σου",711945,133],["καὶ",707031,7],["ὁ",709436,3],["ἄρτος",701829,4],["τοῦ",709436,20],["γενήματος",703052,21],["τῆς",709436,16],["γῆς",703083,17],["σου",711945,133],["ἔσται",704093,93],["πλησμονὴ",710549,12],["καὶ",707031,7],["λιπαρός",708216,14],["καὶ",707031,7],["βοσκηθήσεταί",702767,134],["σου",711945,133],["τὰ",709436,63],["κτήνη",707934,64],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["τόπον",712903,6],["πίονα",710491,27],["καὶ",707031,7],["εὐρύχωρον",705681,27]],"Then shall there be rain to the seed of thy land; and the bread of the fruit of thy land shall be plenteous and rich: and thy cattle shall feed in that day in a fertile and spacious place."],["24",[["οἱ",709436,136],["ταῦροι",712734,52],["ὑμῶν",713091,145],["καὶ",707031,7],["οἱ",709436,136],["βόες",702798,52],["οἱ",709436,136],["ἐργαζόμενοι",705383,348],["τὴν",709436,8],["γῆν",703083,9],["φάγονται",713296,135],["ἄχυρα",702316,42],["ἀναπεποιημένα",701040,388],["ἐν",704639,0],["κριθῇ",707900,1],["λελικμημένα",708202,388]],"Your bulls and your oxen that till the ground, shall eat chaff mixed with winnowed barley."],["25",[["καὶ",707031,7],["ἔσται",704093,93],["ἐπὶ",705080,0],["παντὸς",710177,92],["ὄρους",709768,21],["ὑψηλοῦ",713285,92],["καὶ",707031,7],["ἐπὶ",705080,0],["παντὸς",710177,116],["βουνοῦ",702797,18],["μετεώρου",708831,116],["ὕδωρ",713071,15],["διαπορευόμενον",703551,208],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ὅταν",709801,28],["ἀπόλωνται",701513,232],["πολλοὶ",710646,138],["καὶ",707031,7],["ὅταν",709801,28],["πέσωσιν",710481,218],["πύργοι",711092,52]],"And there shall be upon every lofty mountain and upon every high hill, water running in that day, when many shall perish, and when the towers shall fall."],["26",[["καὶ",707031,7],["ἔσται",704093,93],["τὸ",709436,34],["φῶς",713642,15],["τῆς",709436,16],["σελήνης",711650,17],["ὡς",714148,28],["τὸ",709436,24],["φῶς",713642,25],["τοῦ",709436,35],["ἡλίου",705974,18],["καὶ",707031,7],["τὸ",709436,34],["φῶς",713642,15],["τοῦ",709436,35],["ἡλίου",705974,18],["ἔσται",704093,93],["ἑπταπλάσιον",705368,26],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ὅταν",709801,28],["ἰάσηται",706424,239],["κύριος",707996,4],["