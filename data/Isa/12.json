[["1",[["καὶ",707031,7],["ἐρεῖς",705415,166],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["εὐλογήσω",705631,165],["σε",711598,163],["κύριε",707996,153],["διότι",703734,7],["ὠργίσθης",709729,168],["μοι",708974,159],["καὶ",707031,7],["ἀπέστρεψας",701598,162],["τὸν",709436,5],["θυμόν",706334,6],["σου",711945,133],["καὶ",707031,7],["ἠλέησάς",704418,162],["με",708618,163]],"And in that day thou shalt say, I [will] bless thee, O Lord; for thou wast angry with me, but thou hast turned aside thy wrath, and hast pitied me."],["2",[["ἰδοὺ",706497,88],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["σωτήρ",712657,4],["μου",709032,133],["κύριος",707996,4],["πεποιθὼς",710221,270],["ἔσομαι",704093,181],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["καὶ",707031,7],["σωθήσομαι",712627,180],["ἐν",704639,0],["αὐτῷ",702165,50],["καὶ",707031,7],["οὐ",709805,28],["φοβηθήσομαι",713532,180],["διότι",703734,7],["ἡ",709436,10],["δόξα",703791,12],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["αἴνεσίς",700457,12],["μου",709032,133],["κύριος",707996,4],["καὶ",707031,7],["ἐγένετό",703104,23],["μοι",708974,159],["εἰς",704105,0],["σωτηρίαν",712658,9]],"Behold, my God is my Saviour; I will trust in him, and not be afraid: for the Lord is my glory and my praise, and is become my salvation."],["3",[["καὶ",707031,7],["ἀντλήσετε",701281,74],["ὕδωρ",713071,15],["μετ᾿",708780,0],["εὐφροσύνης",705717,17],["ἐκ",704132,0],["τῶν",709436,130],["πηγῶν",710450,65],["τοῦ",709436,20],["σωτηρίου",712659,21]],"Draw ye therefore water with joy out of the wells of salvation."],["4",[["καὶ",707031,7],["ἐρεῖς",705415,166],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ὑμνεῖτε",713085,335],["κύριον",707996,6],["βοᾶτε",702743,335],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["ἀναγγείλατε",700921,74],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["τὰ",709436,41],["ἔνδοξα",704694,68],["αὐτοῦ",702165,102],["μιμνῄσκεσθε",708923,73],["ὅτι",709803,7],["ὑψώθη",713289,37],["τὸ",709436,34],["ὄνομα",709666,15],["αὐτοῦ",702165,102]],"And in that day thou shalt say, Sing to the Lord, call aloud upon his name, proclaim his glorious [deeds] among the Gentiles; make mention that his name is exalted."],["5",[["ὑμνήσατε",713085,74],["τὸ",709436,24],["ὄνομα",709666,25],["κυρίου",707996,18],["ὅτι",709803,7],["ὑψηλὰ",713285,68],["ἐποίησεν",710582,2],["ἀναγγείλατε",700921,74],["ταῦτα",709858,71],["ἐν",704639,0],["πάσῃ",710177,101],["τῇ",709436,100],["γῇ",703083,1]],"Sing praise to the name of the Lord; for he has done great [things]: declare this in all the earth."],["6",[["ἀγαλλιᾶσθε",700114,186],["καὶ",707031,7],["εὐφραίνεσθε",705715,73],["οἱ",709436,136],["κατοικοῦντες",707534,146],["Σιων",711816,9],["ὅτι",709803,7],["ὑψώθη",713289,37],["ὁ",709436,3],["ἅγιος",700159,14],["τοῦ",709436,35],["Ισραηλ",706839,18],["ἐν",704639,0],["μέσῳ",708768,97],["αὐτῆς",702165,86]],"Exalt and rejoice, ye that dwell in Sion: for the Holy One of Israel is exalted in the midst of her."]]