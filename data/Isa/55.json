[["1",[["οἱ",709436,136],["διψῶντες",703763,146],["πορεύεσθε",710667,374],["ἐφ᾿",705080,0],["ὕδωρ",713071,25],["καὶ",707031,7],["ὅσοι",709788,138],["μὴ",708851,28],["ἔχετε",705785,87],["ἀργύριον",701707,25],["βαδίσαντες",702367,196],["ἀγοράσατε",700184,74],["καὶ",707031,7],["πίετε",710478,74],["ἄνευ",701137,0],["ἀργυρίου",701707,21],["καὶ",707031,7],["τιμῆς",712856,17],["οἴνου",709530,18],["καὶ",707031,7],["στέαρ",712054,25]],"Ye that thirst, go to the water, and all that have no money, go [and] buy; and eat [and drink] wine and fat without money or price."],["2",[["ἵνα",706747,7],["τί",712867,126],["τιμᾶσθε",712855,374],["ἀργυρίου",701707,21],["καὶ",707031,7],["τὸν",709436,5],["μόχθον",709039,6],["ὑμῶν",713091,145],["οὐκ",709805,28],["εἰς",704105,0],["πλησμονήν",710549,9],["ἀκούσατέ",700587,74],["μου",709032,133],["καὶ",707031,7],["φάγεσθε",705495,124],["ἀγαθά",700106,68],["καὶ",707031,7],["ἐντρυφήσει",704810,127],["ἐν",704639,0],["ἀγαθοῖς",700106,94],["ἡ",709436,10],["ψυχὴ",714070,12],["ὑμῶν",713091,145]],"Wherefore do ye value at the price of money, and [give] your labour for that which will not satisfy? hearken to me, and ye shall eat that which is good, and your soul shall feast itself on good things."],["3",[["προσέχετε",710895,335],["τοῖς",709436,95],["ὠτίοις",714165,96],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐπακολουθήσατε",705007,74],["ταῖς",709436,75],["ὁδοῖς",709458,76],["μου",709032,133],["ἐπακούσατέ",705009,74],["μου",709032,133],["καὶ",707031,7],["ζήσεται",705851,93],["ἐν",704639,0],["ἀγαθοῖς",700106,94],["ἡ",709436,10],["ψυχὴ",714070,12],["ὑμῶν",713091,145],["καὶ",707031,7],["διαθήσομαι",703609,181],["ὑμῖν",713084,90],["διαθήκην",703456,9],["αἰώνιον",700505,36],["τὰ",709436,41],["ὅσια",709782,68],["Δαυιδ",703232,18],["τὰ",709436,41],["πιστά",710486,68]],"Give heed with your ears, and follow my ways: hearken to me, and your soul shall live in prosperity; and I will make with you an everlasting covenant, the sure mercies of David."],["4",[["ἰδοὺ",706497,88],["μαρτύριον",708525,25],["ἐν",704639,0],["ἔθνεσιν",704068,96],["δέδωκα",703654,89],["αὐτόν",702165,85],["ἄρχοντα",701862,6],["καὶ",707031,7],["προστάσσοντα",710962,183],["ἔθνεσιν",704068,96]],"Behold, I have made him a testimony among the Gentiles, a prince and commander to the Gentiles."],["5",[["ἔθνη",704068,64],["ἃ",709781,371],["οὐκ",709805,28],["ᾔδεισάν",704075,150],["σε",711598,163],["ἐπικαλέσονταί",705153,135],["σε",711598,163],["καὶ",707031,7],["λαοί",708094,52],["οἳ",709781,250],["οὐκ",709805,28],["ἐπίστανταί",705264,269],["σε",711598,163],["ἐπὶ",705080,0],["σὲ",711598,163],["καταφεύξονται",707472,135],["ἕνεκεν",704709,0],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133],["τοῦ",709436,35],["ἁγίου",700159,116],["Ισραηλ",706839,18],["ὅτι",709803,7],["ἐδόξασέν",703792,2],["σε",711598,163]],"Nations which know thee not, shall call upon thee, and peoples which are not acquainted with thee, shall flee to thee for refuge, for the sake of the Lord thy God, the Holy One of Israel; for he has glorified thee."],["6",[["ζητήσατε",705879,74],["τὸν",709436,5],["θεὸν",706192,6],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["εὑρίσκειν",705676,55],["αὐτὸν",702165,85],["ἐπικαλέσασθε",705153,186],["ἡνίκα",706008,28],["δ᾿",703303,11],["ἂν",700900,11],["ἐγγίζῃ",703939,204],["ὑμῖν",713084,90]],"Seek ye the Lord, and when ye find him, call upon him; and when he shall draw nigh to you,"],["7",[["ἀπολιπέτω",701508,45],["ὁ",709436,3],["ἀσεβὴς",701909,14],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀνὴρ",701150,4],["ἄνομος",701194,14],["τὰς",709436,38],["βουλὰς",702792,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπιστραφήτω",705278,22],["ἐπὶ",705080,0],["κύριον",707996,6],["καὶ",707031,7],["ἐλεηθήσεται",704418,134],["ὅτι",709803,7],["ἐπὶ",705080,0],["πολὺ",710646,46],["ἀφήσει",702211,127],["τὰς",709436,38],["ἁμαρτίας",700775,39],["ὑμῶν",713091,145]],"let the ungodly leave his ways, and the transgressor his counsels: and let him return to the Lord, and he shall find mercy; for he shall abundantly pardon your sins."],["8",[["οὐ",709805,28],["γάρ",702963,11],["εἰσιν",704093,197],["αἱ",709436,190],["βουλαί",702792,191],["μου",709032,133],["ὥσπερ",714163,28],["αἱ",709436,190],["βουλαὶ",702792,191],["ὑμῶν",713091,145],["οὐδὲ",709816,7],["ὥσπερ",714163,28],["αἱ",709436,190],["ὁδοὶ",709458,191],["ὑμῶν",713091,145],["αἱ",709436,190],["ὁδοί",709458,191],["μου",709032,133],["λέγει",708124,91],["κύριος",707996,4]],"For my counsels are not as your counsels, nor are my ways as your ways, saith the Lord."],["9",[["ἀλλ᾿",700680,7],["ὡς",714148,11],["ἀπέχει",701405,91],["ὁ",709436,3],["οὐρανὸς",709844,4],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["οὕτως",709859,28],["ἀπέχει",701405,91],["ἡ",709436,10],["ὁδός",709458,12],["μου",709032,133],["ἀπὸ",701425,0],["τῶν",709436,130],["ὁδῶν",709458,65],["ὑμῶν",713091,145],["καὶ",707031,7],["τὰ",709436,63],["διανοήματα",703529,64],["ὑμῶν",713091,145],["ἀπὸ",701425,0],["τῆς",709436,16],["διανοίας",703531,17],["μου",709032,133]],"But as the heaven is distant from the earth, so is my way distant from your ways, and your thoughts from my mind."],["10",[["ὡς",714148,7],["γὰρ",702963,11],["ἐὰν",703912,7],["καταβῇ",707202,172],["ὑετὸς",713074,4],["ἢ",705924,7],["χιὼν",713870,12],["ἐκ",704132,0],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἀποστραφῇ",701598,384],["ἕως",705792,7],["ἂν",700900,11],["μεθύσῃ",708676,172],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἐκτέκῃ",704331,172],["καὶ",707031,7],["ἐκβλαστήσῃ",704150,172],["καὶ",707031,7],["δῷ",703654,172],["σπέρμα",712008,25],["τῷ",709436,113],["σπείροντι",712006,379],["καὶ",707031,7],["ἄρτον",701829,6],["εἰς",704105,0],["βρῶσιν",702825,9]],"For as rain shall come down, or snow, from heaven, and shall not return until it have saturated the earth, and it bring forth, and bud, and give seed to the sower, and bread for food:"],["11",[["οὕτως",709859,28],["ἔσται",704093,93],["τὸ",709436,34],["ῥῆμά",711246,15],["μου",709032,133],["ὃ",709781,213],["ἐὰν",703912,7],["ἐξέλθῃ",704909,172],["ἐκ",704132,0],["τοῦ",709436,20],["στόματός",712125,21],["μου",709032,133],["οὐ",709805,28],["μὴ",708851,28],["ἀποστραφῇ",701598,384],["ἕως",705792,7],["ἂν",700900,11],["συντελεσθῇ",712510,384],["ὅσα",709788,68],["ἠθέλησα",706176,155],["καὶ",707031,7],["εὐοδώσω",705654,165],["τὰς",709436,38],["ὁδούς",709458,39],["σου",711945,133],["καὶ",707031,7],["τὰ",709436,41],["ἐντάλματά",704785,42],["μου",709032,133]],"so shall my word be, whatever shall proceed out of my mouth, it shall by no means turn back, until all the things which I willed shall have been accomplished; and I will make thy ways prosperous, and [will effect] my commands."],["12",[["ἐν",704639,0],["γὰρ",702963,11],["εὐφροσύνῃ",705717,1],["ἐξελεύσεσθε",704909,124],["καὶ",707031,7],["ἐν",704639,0],["χαρᾷ",713719,1],["διδαχθήσεσθε",703649,261],["τὰ",709436,63],["γὰρ",702963,11],["ὄρη",709768,64],["καὶ",707031,7],["οἱ",709436,136],["βουνοὶ",702797,52],["ἐξαλοῦνται",704856,135],["προσδεχόμενοι",710874,348],["ὑμᾶς",713080,194],["ἐν",704639,0],["χαρᾷ",713719,1],["καὶ",707031,7],["πάντα",710177,195],["τὰ",709436,63],["ξύλα",709427,64],["τοῦ",709436,35],["ἀγροῦ",700196,18],["ἐπικροτήσει",705180,127],["τοῖς",709436,147],["κλάδοις",707702,148]],"For ye shall go forth with joy, and shall be taught with gladness: for the mountains and the hills shall exult to welcome you with joy, and all the trees of the field shall applaud with their branches."],["13",[["καὶ",707031,7],["ἀντὶ",701227,0],["τῆς",709436,16],["στοιβῆς",712116,17],["ἀναβήσεται",700905,93],["κυπάρισσος",707982,12],["ἀντὶ",701227,0],["δὲ",703303,11],["τῆς",709436,16],["κονύζης",707818,17],["ἀναβήσεται",700905,93],["μυρσίνη",709073,12],["καὶ",707031,7],["ἔσται",704093,93],["κύριος",707996,4],["εἰς",704105,0],["ὄνομα",709666,25],["καὶ",707031,7],["εἰς",704105,0],["σημεῖον",711748,25],["αἰώνιον",700505,46],["καὶ",707031,7],["οὐκ",709805,28],["ἐκλείψει",704237,127]],"And instead of the bramble shall come up the cypress, and instead of the nettle shall come up the myrtle: and the Lord shall be for a name, and for an everlasting sign, and shall not fail."]]