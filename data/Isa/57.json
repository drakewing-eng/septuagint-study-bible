[["1",[["ἴδετε",709725,74],["ὡς",714148,7],["ὁ",709436,3],["δίκαιος",703694,14],["ἀπώλετο",701513,23],["καὶ",707031,7],["οὐδεὶς",709817,14],["ἐκδέχεται",704165,117],["τῇ",709436,100],["καρδίᾳ",707141,1],["καὶ",707031,7],["ἄνδρες",701150,52],["δίκαιοι",703694,138],["αἴρονται",700473,699],["καὶ",707031,7],["οὐδεὶς",709817,14],["κατανοεῖ",707341,91],["ἀπὸ",701425,0],["γὰρ",702963,11],["προσώπου",710986,21],["ἀδικίας",700271,17],["ἦρται",700473,403],["ὁ",709436,3],["δίκαιος",703694,14]],"See how the just man has perished, and no one lays [it] to heart: and righteous men are taken away, and no one considers: for the righteous has been removed out of the way of injustice."],["2",[["ἔσται",704093,93],["ἐν",704639,0],["εἰρήνῃ",704098,1],["ἡ",709436,10],["ταφὴ",712736,12],["αὐτοῦ",702165,102],["ἦρται",700473,403],["ἐκ",704132,0],["τοῦ",709436,20],["μέσου",708768,92]],"His burial shall be in peace: he has been removed out of the way."],["3",[["ὑμεῖς",713081,219],["δὲ",703303,11],["προσαγάγετε",710848,74],["ὧδε",714090,28],["υἱοὶ",713075,52],["ἄνομοι",701194,138],["σπέρμα",712008,15],["μοιχῶν",708980,81],["καὶ",707031,7],["πόρνης",710675,17]],"But draw ye near hither, ye lawless children, the seed of adulterers and the harlot."],["4",[["ἐν",704639,0],["τίνι",712867,432],["ἐνετρυφήσατε",704810,265],["καὶ",707031,7],["ἐπὶ",705080,0],["τίνα",712867,356],["ἠνοίξατε",701186,265],["τὸ",709436,24],["στόμα",712125,25],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐπὶ",705080,0],["τίνα",712867,356],["ἐχαλάσατε",713674,265],["τὴν",709436,8],["γλῶσσαν",703120,9],["ὑμῶν",713091,145],["οὐχ",709805,28],["ὑμεῖς",713081,219],["ἐστε",704093,87],["τέκνα",712761,64],["ἀπωλείας",701660,17],["σπέρμα",712008,15],["ἄνομον",701194,14]],"Wherein have ye been rioting? and against whom have ye opened your mouth, and against whom have ye loosed your tongue? are ye not children of perdition? a lawless seed?"],["5",[["οἱ",709436,136],["παρακαλοῦντες",710039,146],["ἐπὶ",705080,0],["τὰ",709436,41],["εἴδωλα",704079,42],["ὑπὸ",713184,0],["δένδρα",703353,42],["δασέα",703299,68],["σφάζοντες",712571,146],["τὰ",709436,41],["τέκνα",712761,42],["αὐτῶν",702165,40],["ἐν",704639,0],["ταῖς",709436,75],["φάραγξιν",713351,76],["ἀνὰ",700902,0],["μέσον",708768,46],["τῶν",709436,80],["πετρῶν",710446,81]],"who call upon idols under the leafy trees, slaying your children in the valleys among the rocks?"],["6",[["ἐκείνη",704183,107],["σου",711945,133],["ἡ",709436,10],["μερίς",708748,12],["οὗτός",709858,121],["σου",711945,133],["ὁ",709436,3],["κλῆρος",707727,4],["κἀκείνοις",707052,782],["ἐξέχεας",704368,162],["σπονδὰς",712025,39],["κἀκείνοις",707052,782],["ἀνήνεγκας",701083,162],["θυσίας",706345,39],["ἐπὶ",705080,0],["τούτοις",709858,151],["οὖν",709835,11],["οὐκ",709805,28],["ὀργισθήσομαι",709729,180]],"That is thy portion, this is thy lot: and to them hast thou poured forth drink-offerings, and to these hast thou offered meat-offerings. Shall I not therefore be angry for these things?"],["7",[["ἐπ᾿",705080,0],["ὄρος",709768,25],["ὑψηλὸν",713285,46],["καὶ",707031,7],["μετέωρον",708831,46],["ἐκεῖ",704181,28],["σου",711945,133],["ἡ",709436,10],["κοίτη",707781,12],["κἀκεῖ",707051,28],["ἀνεβίβασας",700910,162],["θυσίας",706345,39]],"On a lofty and high mountain, there is thy bed, and thither thou carriedst up thy meat-offerings:"],["8",[["καὶ",707031,7],["ὀπίσω",709697,28],["τῶν",709436,80],["σταθμῶν",712040,81],["τῆς",709436,16],["θύρας",706337,17],["σου",711945,133],["ἔθηκας",712849,162],["μνημόσυνά",708966,42],["σου",711945,133],["ᾤου",709534,497],["ὅτι",709803,7],["ἐὰν",703912,7],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["ἀποστῇς",702214,175],["πλεῖόν",710514,46],["τι",712866,126],["ἕξεις",705785,166],["ἠγάπησας",700120,162],["τοὺς",709436,58],["κοιμωμένους",707767,236],["μετὰ",708780,0],["σοῦ",711945,133]],"and behind the posts of thy door thou didst place thy memorials. Didst thou think that if thou shouldest depart from me, thou wouldest gain? thou hast loved those that lay with thee;"],["9",[["καὶ",707031,7],["ἐπλήθυνας",710530,162],["τὴν",709436,8],["πορνείαν",710672,9],["σου",711945,133],["μετ᾿",708780,0],["αὐτῶν",702165,40],["καὶ",707031,7],["πολλοὺς",710646,60],["ἐποίησας",710582,162],["τοὺς",709436,58],["μακρὰν",708411,28],["ἀπὸ",701425,0],["σοῦ",711945,133],["καὶ",707031,7],["ἀπέστειλας",701592,162],["πρέσβεις",710733,57],["ὑπὲρ",713111,0],["τὰ",709436,41],["ὅριά",709749,42],["σου",711945,133],["καὶ",707031,7],["ἀπέστρεψας",701598,162],["καὶ",707031,7],["ἐταπεινώθης",712717,168],["ἕως",705792,7],["ᾅδου",700255,18]],"and thou hast multiplied thy whoredom with them, and thou hast increased the number of them that are far from thee, and hast sent ambassadors beyond thy borders, and hast been debased even to hell."],["10",[["ταῖς",709436,75],["πολυοδίαις",710632,76],["σου",711945,133],["ἐκοπίασας",707824,162],["καὶ",707031,7],["οὐκ",709805,28],["εἶπας",705373,162],["παύσομαι",710202,181],["ἐνισχύουσα",704750,188],["ὅτι",709803,7],["ἔπραξας",710721,162],["ταῦτα",709858,71],["διὰ",703417,0],["τοῦτο",709858,129],["οὐ",709805,28],["κατεδεήθης",707239,168],["μου",709032,133]],"Thou hast wearied thyself with thy many ways; yet thou saidst not, I will cease to strengthen myself: for thou hast done these things; therefore thou hast not supplicated me."],["11",[["σύ",712181,164],["τίνα",712867,356],["εὐλαβηθεῖσα",705627,307],["ἐφοβήθης",713532,168],["καὶ",707031,7],["ἐψεύσω",714045,174],["με",708618,163],["καὶ",707031,7],["οὐκ",709805,28],["ἐμνήσθης",708923,168],["μου",709032,133],["οὐδὲ",709816,7],["ἔλαβές",708076,162],["με",708618,163],["εἰς",704105,0],["τὴν",709436,8],["διάνοιαν",703531,9],["οὐδὲ",709816,7],["εἰς",704105,0],["τὴν",709436,8],["καρδίαν",707141,9],["σου",711945,133],["κἀγώ",706969,288],["σε",711598,163],["ἰδὼν",709725,182],["παρορῶ",710125,157],["καὶ",707031,7],["ἐμὲ",704555,163],["οὐκ",709805,28],["ἐφοβήθης",713532,168]],"Through dread of whom hast thou feared, and lied against me, and hast not remembered, nor considered me, nor regarded me, yea, though when I see thee I pass thee by, yet thou hast not feared me."],["12",[["κἀγὼ",706969,288],["ἀπαγγελῶ",701321,165],["τὴν",709436,8],["δικαιοσύνην",703695,9],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,41],["κακά",707066,68],["σου",711945,133],["ἃ",709781,69],["οὐκ",709805,28],["ὠφελήσουσίν",714171,218],["σε",711598,163]],"And I will declare thy righteousness, and thy sins, which shall not profit thee."],["13",[["ὅταν",709801,28],["ἀναβοήσῃς",700915,175],["ἐξελέσθωσάν",704838,486],["σε",711598,163],["ἐν",704639,0],["τῇ",709436,100],["θλίψει",706276,1],["σου",711945,133],["τούτους",709858,62],["γὰρ",702963,11],["πάντας",710177,60],["ἄνεμος",701123,4],["λήμψεται",708076,93],["καὶ",707031,7],["ἀποίσει",701632,127],["καταιγίς",707254,12],["οἱ",709436,136],["δὲ",703303,11],["ἀντεχόμενοί",701225,348],["μου",709032,133],["κτήσονται",707932,135],["γῆν",703083,9],["καὶ",707031,7],["κληρονομήσουσιν",707724,218],["τὸ",709436,24],["ὄρος",709768,25],["τὸ",709436,24],["ἅγιόν",700159,46],["μου",709032,133]],"When thou criest out, let them deliver thee in thine affliction: for all these the wind shall take, and the tempest shall carry [them] away: but they that cleave to me shall possess the land, and shall inherit my holy mountain."],["14",[["καὶ",707031,7],["ἐροῦσιν",705415,218],["καθαρίσατε",706985,74],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["ὁδοὺς",709458,39],["καὶ",707031,7],["ἄρατε",700473,74],["σκῶλα",711906,42],["ἀπὸ",701425,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133]],"And they shall say, Clear the ways before him, and take up the stumbling-blocks out of the way of my people."],["15",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["ὕψιστος",713287,14],["ὁ",709436,3],["ἐν",704639,0],["ὑψηλοῖς",713285,230],["κατοικῶν",707534,72],["τὸν",709436,5],["αἰῶνα",700504,6],["ἅγιος",700159,14],["ἐν",704639,0],["ἁγίοις",700159,230],["ὄνομα",709666,15],["αὐτῷ",702165,50],["κύριος",707996,4],["ὕψιστος",713287,14],["ἐν",704639,0],["ἁγίοις",700159,230],["ἀναπαυόμενος",701027,122],["καὶ",707031,7],["ὀλιγοψύχοις",709574,148],["διδοὺς",703654,72],["μακροθυμίαν",708419,9],["καὶ",707031,7],["διδοὺς",703654,72],["ζωὴν",705910,9],["τοῖς",709436,147],["συντετριμμένοις",712520,521],["τὴν",709436,8],["καρδίαν",707141,9]],"Thus saith the Most High, who dwells on high for ever, Holy in the holies, is his name, the Most High resting in the holies, and giving patience to the faint-hearted, and giving life to the broken-hearted:"],["16",[["οὐκ",709805,28],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἐκδικήσω",704174,165],["ὑμᾶς",713080,194],["οὐδὲ",709816,7],["διὰ",703417,0],["παντὸς",710177,116],["ὀργισθήσομαι",709729,180],["ὑμῖν",713084,90],["πνεῦμα",710566,15],["γὰρ",702963,11],["παρ᾿",709995,0],["ἐμοῦ",704580,133],["ἐξελεύσεται",704909,93],["καὶ",707031,7],["πνοὴν",710574,9],["πᾶσαν",710177,36],["ἐγὼ",704018,164],["ἐποίησα",710582,155]],"I will not take vengeance on you for ever, neither will I be always angry with you: for my Spirit shall go forth from me, and I have created all breath."],["17",[["δι᾿",703417,0],["ἁμαρτίαν",700775,9],["βραχύ",702809,661],["τι",712866,126],["ἐλύπησα",708272,155],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐπάταξα",710185,155],["αὐτὸν",702165,85],["καὶ",707031,7],["ἀπέστρεψα",701598,155],["τὸ",709436,24],["πρόσωπόν",710986,25],["μου",709032,133],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐλυπήθη",708272,37],["καὶ",707031,7],["ἐπορεύθη",710667,37],["στυγνὸς",712178,14],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["αὐτοῦ",702165,102]],"On account of sin for a little while I grieved him, and smote him, and turned away my face from him; and he was grieved, and he went on sorrowful in his ways."],["18",[["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτοῦ",702165,102],["ἑώρακα",709725,89],["καὶ",707031,7],["ἰασάμην",706424,161],["αὐτὸν",702165,85],["καὶ",707031,7],["παρεκάλεσα",710039,155],["αὐτὸν",702165,85],["καὶ",707031,7],["ἔδωκα",703654,155],["αὐτῷ",702165,50],["παράκλησιν",710047,9],["ἀληθινήν",700659,36]],"I have seen his ways, and healed him, and comforted him, and given him true comfort;"],["19",[["εἰρήνην",704098,9],["ἐπ᾿",705080,0],["εἰρήνην",704098,9],["τοῖς",709436,147],["μακρὰν",708411,28],["καὶ",707031,7],["τοῖς",709436,147],["ἐγγὺς",703948,28],["οὖσιν",704093,349],["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["ἰάσομαι",706424,181],["αὐτούς",702165,62]],"peace upon peace to them that are far off, and to them that are nigh: and the Lord has said, I will heal them."],["20",[["οἱ",709436,136],["δὲ",703303,11],["ἄδικοι",700272,138],["οὕτως",709859,28],["κλυδωνισθήσονται",707745,144],["καὶ",707031,7],["ἀναπαύσασθαι",701027,109],["οὐ",709805,28],["δυνήσονται",703838,135]],"But the unrighteous shall be tossed as troubled waves, and shall not be able to rest."],["21",[["οὐκ",709805,28],["ἔστιν",704093,91],["χαίρειν",713665,55],["τοῖς",709436,147],["ἀσεβέσιν",701909,230],["εἶπεν",705373,2],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4]],"There is no joy to the ungodly, said God."]]