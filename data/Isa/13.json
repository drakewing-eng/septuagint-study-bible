[["1",[["ὅρασις",709721,9],["ἣν",709781,131],["εἶδεν",709725,2],["Ησαιας",706026,4],["υἱὸς",713075,4],["Αμως",700898,18],["κατὰ",707200,28],["Βαβυλῶνος",702352,17]],"The Vision which Esaias son of Amos saw against Babylon."],["2",[["ἐπ᾿",705080,0],["ὄρους",709768,21],["πεδινοῦ",710214,92],["ἄρατε",700473,74],["σημεῖον",711748,25],["ὑψώσατε",713289,74],["τὴν",709436,8],["φωνὴν",713640,9],["αὐτοῖς",702165,151],["μὴ",708851,28],["φοβεῖσθε",713532,73],["παρακαλεῖτε",710039,335],["τῇ",709436,100],["χειρί",713787,1],["ἀνοίξατε",701186,74],["οἱ",709436,136],["ἄρχοντες",701862,52]],"Lift up a standard on the mountain of the plain, exalt the voice to them, beckon with the hand, open [the gates], ye rulers."],["3",[["ἐγὼ",704018,164],["συντάσσω",712508,157],["καὶ",707031,7],["ἐγὼ",704018,164],["ἄγω",700209,157],["αὐτούς",702165,62],["ἡγιασμένοι",700153,429],["εἰσίν",704093,197],["καὶ",707031,7],["ἐγὼ",704018,164],["ἄγω",700209,157],["αὐτούς",702165,62],["γίγαντες",703101,52],["ἔρχονται",705453,269],["πληρῶσαι",710543,106],["τὸν",709436,5],["θυμόν",706334,6],["μου",709032,133],["χαίροντες",713665,146],["ἅμα",700745,28],["καὶ",707031,7],["ὑβρίζοντες",713050,146]],"I give command, and I bring them: giants are coming to fulfil my wrath, rejoicing at the same time and insulting."],["4",[["φωνὴ",713640,12],["ἐθνῶν",704068,44],["πολλῶν",710646,83],["ἐπὶ",705080,0],["τῶν",709436,43],["ὀρέων",709768,44],["ὁμοία",709626,195],["ἐθνῶν",704068,44],["πολλῶν",710646,83],["φωνὴ",713640,12],["βασιλέων",702580,81],["καὶ",707031,7],["ἐθνῶν",704068,44],["συνηγμένων",712375,635],["κύριος",707996,4],["σαβαωθ",711346,228],["ἐντέταλται",704791,187],["ἔθνει",704068,54],["ὁπλομάχῳ",709703,114]],"A voice of many nations on the mountains, [even] like [to that] of many nations; a voice of kings and nations gathered together: the Lord of hosts has given command to a war-like nation,"],["5",[["ἔρχεσθαι",705453,110],["ἐκ",704132,0],["γῆς",703083,17],["πόρρωθεν",710681,28],["ἀπ᾿",701425,0],["ἄκρου",700608,92],["θεμελίου",706181,21],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["κύριος",707996,4],["καὶ",707031,7],["οἱ",709436,136],["ὁπλομάχοι",709703,52],["αὐτοῦ",702165,102],["τοῦ",709436,20],["καταφθεῖραι",707474,106],["τὴν",709436,8],["οἰκουμένην",709517,173],["ὅλην",709597,36]],"to come from a land afar off, from the utmost foundation of heaven; the Lord and his warriors [are coming] to destroy all the world."],["6",[["ὀλολύζετε",709593,335],["ἐγγὺς",703948,28],["γὰρ",702963,11],["ἡ",709436,10],["ἡμέρα",705984,12],["κυρίου",707996,18],["καὶ",707031,7],["συντριβὴ",712519,12],["παρὰ",709995,0],["τοῦ",709436,35],["θεοῦ",706192,18],["ἥξει",705956,127]],"Howl ye, for the day of the Lord is near, and destruction from God shall arrive."],["7",[["διὰ",703417,0],["τοῦτο",709858,129],["πᾶσα",710177,29],["χεὶρ",713787,12],["ἐκλυθήσεται",704254,134],["καὶ",707031,7],["πᾶσα",710177,29],["ψυχὴ",714070,12],["ἀνθρώπου",701163,18],["δειλιάσει",703321,127]],"Therefore every hand shall become powerless, and every soul of man shall be dismayed."],["8",[["καὶ",707031,7],["ταραχθήσονται",712721,144],["οἱ",709436,136],["πρέσβεις",710733,52],["καὶ",707031,7],["ὠδῖνες",714094,191],["αὐτοὺς",702165,62],["ἕξουσιν",705785,218],["ὡς",714148,28],["γυναικὸς",703209,17],["τικτούσης",712853,222],["καὶ",707031,7],["συμφοράσουσιν",712358,218],["ἕτερος",705535,14],["πρὸς",710844,0],["τὸν",709436,5],["ἕτερον",705535,27],["καὶ",707031,7],["ἐκστήσονται",704940,135],["καὶ",707031,7],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτῶν",702165,40],["ὡς",714148,28],["φλὸξ",713524,12],["μεταβαλοῦσιν",708782,218]],"The elders shall be troubled, and pangs shall seize them, as of a woman in travail: and they shall mourn one to another, and shall be amazed, and shall change their countenance as a flame."],["9",[["ἰδοὺ",706497,88],["γὰρ",702963,11],["ἡμέρα",705984,12],["κυρίου",707996,18],["ἀνίατος",701166,29],["ἔρχεται",705453,117],["θυμοῦ",706334,18],["καὶ",707031,7],["ὀργῆς",709728,17],["θεῖναι",712849,106],["τὴν",709436,8],["οἰκουμένην",709517,173],["ὅλην",709597,36],["ἔρημον",705420,9],["καὶ",707031,7],["τοὺς",709436,58],["ἁμαρτωλοὺς",700776,60],["ἀπολέσαι",701513,106],["ἐξ",704132,0],["αὐτῆς",702165,86]],"For behold! the day of the Lord is coming which cannot be escaped, [a day] of wrath and anger, to make the world desolate, and to destroy sinners out of it."],["10",[["οἱ",709436,136],["γὰρ",702963,11],["ἀστέρες",702017,52],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["ὁ",709436,3],["Ὠρίων",714140,4],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["κόσμος",707851,4],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["τὸ",709436,24],["φῶς",713642,25],["οὐ",709805,28],["δώσουσιν",703654,218],["καὶ",707031,7],["σκοτισθήσεται",711887,134],["τοῦ",709436,35],["ἡλίου",705974,18],["ἀνατέλλοντος",701066,152],["καὶ",707031,7],["ἡ",709436,10],["σελήνη",711650,12],["οὐ",709805,28],["δώσει",703654,127],["τὸ",709436,24],["φῶς",713642,25],["αὐτῆς",702165,86]],"For the stars of heaven, and Orion, and all the host of heaven, shall not give their light; and it shall be dark at sunrise, and the moon shall not give her light."],["11",[["καὶ",707031,7],["ἐντελοῦμαι",704791,254],["τῇ",709436,100],["οἰκουμένῃ",709517,585],["ὅλῃ",709597,101],["κακὰ",707066,68],["καὶ",707031,7],["τοῖς",709436,147],["ἀσεβέσιν",701909,230],["τὰς",709436,38],["ἁμαρτίας",700775,39],["αὐτῶν",702165,40],["καὶ",707031,7],["ἀπολῶ",701513,165],["ὕβριν",713051,9],["ἀνόμων",701194,169],["καὶ",707031,7],["ὕβριν",713051,9],["ὑπερηφάνων",713139,169],["ταπεινώσω",712717,165]],"And I will command evils for the whole world, and [will visit] their sins on the ungodly: and I will destroy the pride of transgressors, and will bring low the pride of the haughty."],["12",[["καὶ",707031,7],["ἔσονται",704093,135],["οἱ",709436,136],["καταλελειμμένοι",707305,429],["ἔντιμοι",704798,138],["μᾶλλον",708448,28],["ἢ",705924,7],["τὸ",709436,24],["χρυσίον",713972,25],["τὸ",709436,24],["ἄπυρον",701656,46],["καὶ",707031,7],["ὁ",709436,3],["ἄνθρωπος",701163,4],["μᾶλλον",708448,28],["ἔντιμος",704798,14],["ἔσται",704093,93],["ἢ",705924,7],["ὁ",709436,3],["λίθος",708196,4],["ὁ",709436,3],["ἐκ",704132,0],["Σουφιρ",711980,118]],"And they that are left shall be more precious than gold tried in the fire; and a man shall be more precious than the stone that is in Suphir."],["13",[["ὁ",709436,3],["γὰρ",702963,11],["οὐρανὸς",709844,4],["θυμωθήσεται",706335,134],["καὶ",707031,7],["ἡ",709436,10],["γῆ",703083,12],["σεισθήσεται",711633,134],["ἐκ",704132,0],["τῶν",709436,43],["θεμελίων",706181,44],["αὐτῆς",702165,86],["διὰ",703417,0],["θυμὸν",706334,6],["ὀργῆς",709728,17],["κυρίου",707996,18],["σαβαωθ",711346,228],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ᾗ",709781,108],["ἂν",700900,11],["ἐπέλθῃ",705068,172],["ὁ",709436,3],["θυμὸς",706334,4],["αὐτοῦ",702165,102]],"For the heaven shall be enraged, and the earth shall be shaken from her foundation, because of the fierce anger of the Lord of hosts, in the day in which his wrath shall come on."],["14",[["καὶ",707031,7],["ἔσονται",704093,135],["οἱ",709436,136],["καταλελειμμένοι",707305,429],["ὡς",714148,28],["δορκάδιον",703800,25],["φεῦγον",713433,47],["καὶ",707031,7],["ὡς",714148,28],["πρόβατον",710768,25],["πλανώμενον",710495,214],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ὁ",709436,3],["συνάγων",712375,72],["ὥστε",714164,7],["ἄνθρωπον",701163,6],["εἰς",704105,0],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["ἀποστραφῆναι",701598,179],["καὶ",707031,7],["ἄνθρωπον",701163,6],["εἰς",704105,0],["τὴν",709436,8],["χώραν",714011,9],["αὐτοῦ",702165,102],["διῶξαι",703768,106]],"And they that are left shall be as a fleeing fawn, and as a stray sheep, and there shall be none to gather [them]: so that a man shall turn back to his people, and a man shall flee to his own land."],["15",[["ὃς",709781,213],["γὰρ",702963,11],["ἂν",700900,11],["ἁλῷ",700673,172],["ἡττηθήσεται",706040,134],["καὶ",707031,7],["οἵτινες",709793,450],["συνηγμένοι",712375,429],["εἰσίν",704093,197],["μαχαίρᾳ",708593,1],["πεσοῦνται",710481,135]],"For whosoever shall be taken shall be overcome; and they that are gathered together shall fall by the sword."],["16",[["καὶ",707031,7],["τὰ",709436,41],["τέκνα",712761,42],["αὐτῶν",702165,40],["ἐνώπιον",704823,28],["αὐτῶν",702165,40],["ῥάξουσιν",711191,218],["καὶ",707031,7],["τὰς",709436,38],["οἰκίας",709505,39],["αὐτῶν",702165,40],["προνομεύσουσιν",710826,218],["καὶ",707031,7],["τὰς",709436,38],["γυναῖκας",703209,39],["αὐτῶν",702165,40],["ἕξουσιν",705785,218]],"And they shall dash their children before their eyes; and they shall spoil their houses, and shall take their wives."],["17",[["ἰδοὺ",706497,88],["ἐπεγείρω",705053,157],["ὑμῖν",713084,90],["τοὺς",709436,58],["Μήδους",708864,57],["οἳ",709781,250],["οὐ",709805,28],["λογίζονται",708232,269],["ἀργύριον",701707,25],["οὐδὲ",709816,7],["χρυσίου",713972,21],["χρείαν",713938,9],["ἔχουσιν",705785,197]],"Behold, I will stir up against you the Medes, who do not regard silver, neither have they need of gold."],["18",[["τοξεύματα",712895,57],["νεανίσκων",709232,81],["συντρίψουσιν",712520,218],["καὶ",707031,7],["τὰ",709436,41],["τέκνα",712761,42],["ὑμῶν",713091,145],["οὐ",709805,28],["μὴ",708851,28],["ἐλεήσωσιν",704418,218],["οὐδὲ",709816,7],["ἐπὶ",705080,0],["τοῖς",709436,95],["τέκνοις",712761,96],["οὐ",709805,28],["φείσονται",713406,135],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["αὐτῶν",702165,40]],"They shall break the bows of the young men; and they shall have no mercy on your children; nor shall their eyes spare thy children."],["19",[["καὶ",707031,7],["ἔσται",704093,93],["Βαβυλών",702352,12],["ἣ",709781,177],["καλεῖται",707084,391],["ἔνδοξος",704694,14],["ὑπὸ",713184,0],["βασιλέως",702580,18],["Χαλδαίων",713678,81],["ὃν",709781,112],["τρόπον",712980,6],["κατέστρεψεν",707444,2],["ὁ",709436,3],["θεὸς",706192,4],["Σοδομα",711920,9],["καὶ",707031,7],["Γομορρα",703165,9]],"And Babylon, which is called glorious by the king of the Chaldeans, shall be as [when] God overthrew Sodoma and Gomorrha."],["20",[["οὐ",709805,28],["κατοικηθήσεται",707534,134],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["χρόνον",713969,6],["οὐδὲ",709816,7],["μὴ",708851,28],["εἰσέλθωσιν",704114,234],["εἰς",704105,0],["αὐτὴν",702165,104],["διὰ",703417,0],["πολλῶν",710646,198],["γενεῶν",703037,65],["οὐδὲ",709816,7],["μὴ",708851,28],["διέλθωσιν",703673,234],["αὐτὴν",702165,104],["Ἄραβες",701694,313],["οὐδὲ",709816,7],["ποιμένες",710596,52],["οὐ",709805,28],["μὴ",708851,28],["ἀναπαύσωνται",701027,232],["ἐν",704639,0],["αὐτῇ",702165,105]],"It shall never be inhabited, neither shall any enter into it for many generations: neither shall the Arabians pass through it; nor shall shepherds at all rest in it."],["21",[["καὶ",707031,7],["ἀναπαύσονται",701027,135],["ἐκεῖ",704181,28],["θηρία",706252,64],["καὶ",707031,7],["ἐμπλησθήσονται",704592,144],["αἱ",709436,190],["οἰκίαι",709505,191],["ἤχου",706046,18],["καὶ",707031,7],["ἀναπαύσονται",701027,135],["ἐκεῖ",704181,28],["σειρῆνες",711627,64],["καὶ",707031,7],["δαιμόνια",703249,64],["ἐκεῖ",704181,28],["ὀρχήσονται",709780,135]],"But wild beasts shall rest there; and the houses shall be filled with howling; and monsters shall rest there, and devils shall dance there,"],["22",[["καὶ",707031,7],["ὀνοκένταυροι",709664,52],["ἐκεῖ",704181,28],["κατοικήσουσιν",707534,218],["καὶ",707031,7],["νοσσοποιήσουσιν",709362,218],["ἐχῖνοι",705780,52],["ἐν",704639,0],["τοῖς",709436,147],["οἴκοις",709516,148],["αὐτῶν",702165,40],["ταχὺ",712748,661],["ἔρχεται",705453,117],["καὶ",707031,7],["οὐ",709805,28],["χρονιεῖ",713967,127]],"and satyrs shall dwell there; and hedgehogs shall make their nests in their houses. It will come soon, and will not tarry."]]