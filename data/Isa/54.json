[["1",[["εὐφράνθητι",705715,244],["στεῖρα",712060,12],["ἡ",709436,10],["οὐ",709805,28],["τίκτουσα",712853,188],["ῥῆξον",711243,176],["καὶ",707031,7],["βόησον",702743,176],["ἡ",709436,10],["οὐκ",709805,28],["ὠδίνουσα",714095,188],["ὅτι",709803,7],["πολλὰ",710646,195],["τὰ",709436,63],["τέκνα",712761,64],["τῆς",709436,16],["ἐρήμου",705420,17],["μᾶλλον",708448,28],["ἢ",705924,7],["τῆς",709436,16],["ἐχούσης",705785,222],["τὸν",709436,5],["ἄνδρα",701150,6],["εἶπεν",705373,2],["γὰρ",702963,11],["κύριος",707996,4]],"Rejoice, thou barren that bearest not; break forth and cry, thou that dost not travail: for more are the children of the desolate than of her that has a husband: for the Lord has said,"],["2",[["πλάτυνον",710508,176],["τὸν",709436,5],["τόπον",712903,6],["τῆς",709436,16],["σκηνῆς",711845,17],["σου",711945,133],["καὶ",707031,7],["τῶν",709436,130],["αὐλαιῶν",702133,65],["σου",711945,133],["πῆξον",710452,176],["μὴ",708851,28],["φείσῃ",713406,420],["μάκρυνον",708428,176],["τὰ",709436,41],["σχοινίσματά",712611,42],["σου",711945,133],["καὶ",707031,7],["τοὺς",709436,58],["πασσάλους",710178,57],["σου",711945,133],["κατίσχυσον",707531,176]],"Enlarge the place of thy tent, and of thy curtains: fix [the pins], spare not, lengthen thy cords, and strengthen thy pins;"],["3",[["ἔτι",705538,28],["εἰς",704105,0],["τὰ",709436,41],["δεξιὰ",703360,68],["καὶ",707031,7],["εἰς",704105,0],["τὰ",709436,41],["ἀριστερὰ",701749,68],["ἐκπέτασον",704277,176],["καὶ",707031,7],["τὸ",709436,34],["σπέρμα",712008,15],["σου",711945,133],["ἔθνη",704068,42],["κληρονομήσει",707724,127],["καὶ",707031,7],["πόλεις",710612,39],["ἠρημωμένας",705421,503],["κατοικιεῖς",707538,166]],"spread forth [thy tent] yet to the right and the left: for thy seed shall inherit the Gentiles, and thou shalt make the desolate cities to be inhabited."],["4",[["μὴ",708851,28],["φοβοῦ",713532,253],["ὅτι",709803,7],["κατῃσχύνθης",707257,168],["μηδὲ",708855,7],["ἐντραπῇς",704805,175],["ὅτι",709803,7],["ὠνειδίσθης",709655,168],["ὅτι",709803,7],["αἰσχύνην",700483,9],["αἰώνιον",700505,36],["ἐπιλήσῃ",705187,123],["καὶ",707031,7],["ὄνειδος",709658,25],["τῆς",709436,16],["χηρείας",713850,82],["σου",711945,133],["οὐ",709805,28],["μὴ",708851,28],["μνησθήσῃ",708923,364]],"Fear not, because thou hast been put to shame, neither be confounded, because thou wast reproached: for thou shalt forget thy former shame, and shalt no more at all remember the reproach of thy widowhood."],["5",[["ὅτι",709803,7],["κύριος",707996,4],["ὁ",709436,3],["ποιῶν",710582,72],["σε",711598,163],["κύριος",707996,4],["σαβαωθ",711346,228],["ὄνομα",709666,15],["αὐτῷ",702165,50],["καὶ",707031,7],["ὁ",709436,3],["ῥυσάμενός",711309,248],["σε",711598,163],["αὐτὸς",702165,121],["θεὸς",706192,4],["Ισραηλ",706839,18],["πάσῃ",710177,101],["τῇ",709436,100],["γῇ",703083,1],["κληθήσεται",707084,134]],"For [it is] the Lord that made thee; the Lord of hosts is his name: and he that delivered thee, he is the God of Israel, [and] shall be called [so] by the whole earth."],["6",[["οὐχ",709805,28],["ὡς",714148,11],["γυναῖκα",703209,9],["καταλελειμμένην",707305,444],["καὶ",707031,7],["ὀλιγόψυχον",709574,36],["κέκληκέν",707084,171],["σε",711598,163],["κύριος",707996,4],["οὐδ᾿",709816,7],["ὡς",714148,11],["γυναῖκα",703209,9],["ἐκ",704132,0],["νεότητος",709258,17],["μεμισημένην",708935,444],["εἶπεν",705373,2],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133]],"The Lord has not called thee as a deserted and faint-hearted woman, nor as a woman hated from [her] youth, saith thy God."],["7",[["χρόνον",713969,6],["μικρὸν",708915,27],["κατέλιπόν",707305,155],["σε",711598,163],["καὶ",707031,7],["μετὰ",708780,0],["ἐλέους",704426,57],["μεγάλου",708653,116],["ἐλεήσω",704418,165],["σε",711598,163]],"For a little while I left thee: but with great mercy will I have compassion upon thee."],["8",[["ἐν",704639,0],["θυμῷ",706334,114],["μικρῷ",708915,30],["ἀπέστρεψα",701598,155],["τὸ",709436,24],["πρόσωπόν",710986,25],["μου",709032,133],["ἀπὸ",701425,0],["σοῦ",711945,133],["καὶ",707031,7],["ἐν",704639,0],["ἐλέει",704426,54],["αἰωνίῳ",700505,97],["ἐλεήσω",704418,165],["σε",711598,163],["εἶπεν",705373,2],["ὁ",709436,3],["ῥυσάμενός",711309,182],["σε",711598,163],["κύριος",707996,4]],"In a little wrath I turned away my face from thee; but with everlasting mercy will I have compassion upon thee, saith the Lord that delivers thee."],["9",[["ἀπὸ",701425,0],["τοῦ",709436,20],["ὕδατος",713071,21],["τοῦ",709436,20],["ἐπὶ",705080,0],["Νωε",709395,246],["τοῦτό",709858,132],["μοί",708974,159],["ἐστιν",704093,91],["καθότι",707021,7],["ὤμοσα",709620,155],["αὐτῷ",702165,50],["ἐν",704639,0],["τῷ",709436,113],["χρόνῳ",713969,114],["ἐκείνῳ",704183,50],["τῇ",709436,100],["γῇ",703083,1],["μὴ",708851,28],["θυμωθήσεσθαι",706335,681],["ἐπὶ",705080,0],["σοὶ",711925,159],["ἔτι",705538,28],["μηδὲ",708855,7],["ἐν",704639,0],["ἀπειλῇ",701374,204],["σου",711945,133]],"From the time of the water of Noe this is my [purpose]: as I sware to him at that time, [saying] of the earth, I will no more be wroth with thee, neither when thou art threatened,"],["10",[["τὰ",709436,41],["ὄρη",709768,42],["μεταστήσεσθαι",708668,492],["οὐδὲ",709816,7],["οἱ",709436,136],["βουνοί",702797,52],["σου",711945,133],["μετακινηθήσονται",708797,144],["οὕτως",709859,28],["οὐδὲ",709816,7],["τὸ",709436,34],["παρ᾿",709995,0],["ἐμοῦ",704580,133],["σοι",711925,159],["ἔλεος",704426,15],["ἐκλείψει",704237,127],["οὐδὲ",709816,7],["ἡ",709436,10],["διαθήκη",703456,12],["τῆς",709436,16],["εἰρήνης",704098,17],["σου",711945,133],["οὐ",709805,28],["μὴ",708851,28],["μεταστῇ",708668,172],["εἶπεν",705373,2],["γὰρ",702963,11],["κύριος",707996,4],["ἵλεώς",706732,4],["σοι",711925,159]],"shall the mountains depart, nor shall thy hills be removed: so neither shall my mercy fail thee, nor shall the covenant of thy peace be at all removed: for the Lord [who is] gracious to thee has spoken [it]."],["11",[["ταπεινὴ",712714,29],["καὶ",707031,7],["ἀκατάστατος",700532,29],["οὐ",709805,28],["παρεκλήθης",710039,168],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἑτοιμάζω",705539,157],["σοὶ",711925,159],["ἄνθρακα",701160,6],["τὸν",709436,5],["λίθον",708196,6],["σου",711945,133],["καὶ",707031,7],["τὰ",709436,41],["θεμέλιά",706181,42],["σου",711945,133],["σάπφειρον",711505,9]],"Afflicted and outcast thou hast not been comforted: behold, I [will] prepare carbuncle [for] thy stones, and sapphire for thy foundations;"],["12",[["καὶ",707031,7],["θήσω",712849,165],["τὰς",709436,38],["ἐπάλξεις",705012,39],["σου",711945,133],["ἴασπιν",706451,9],["καὶ",707031,7],["τὰς",709436,38],["πύλας",711082,39],["σου",711945,133],["λίθους",708196,57],["κρυστάλλου",707926,18],["καὶ",707031,7],["τὸν",709436,5],["περίβολόν",710302,6],["σου",711945,133],["λίθους",708196,57],["ἐκλεκτοὺς",704240,60]],"and I will make thy buttresses jasper, and thy gates crystal, and thy border precious stones."],["13",[["καὶ",707031,7],["πάντας",710177,60],["τοὺς",709436,58],["υἱούς",713075,57],["σου",711945,133],["διδακτοὺς",703646,60],["θεοῦ",706192,18],["καὶ",707031,7],["ἐν",704639,0],["πολλῇ",710646,101],["εἰρήνῃ",704098,1],["τὰ",709436,41],["τέκνα",712761,42],["σου",711945,133]],"And [I will cause] all thy sons [to be] taught of God, and thy children [to be] in great peace."],["14",[["καὶ",707031,7],["ἐν",704639,0],["δικαιοσύνῃ",703695,1],["οἰκοδομηθήσῃ",709509,364],["ἀπέχου",701225,253],["ἀπὸ",701425,0],["ἀδίκου",700272,116],["καὶ",707031,7],["οὐ",709805,28],["φοβηθήσῃ",713532,364],["καὶ",707031,7],["τρόμος",712975,4],["οὐκ",709805,28],["ἐγγιεῖ",703939,127],["σοι",711925,159]],"And thou shalt be built in righteousness: abstain from injustice, and thou shalt not fear; and trembling shall not come nigh thee."],["15",[["ἰδοὺ",706497,88],["προσήλυτοι",710900,52],["προσελεύσονταί",710890,135],["σοι",711925,159],["δι᾿",703417,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["ἐπὶ",705080,0],["σὲ",711598,163],["καταφεύξονται",707472,135]],"Behold, strangers shall come to thee by me, and shall sojourn with thee, and shall run to thee for refuge.",{"s":"d","q":0.69}],["16",[["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["κτίζω",707938,157],["σε",711598,163],["οὐχ",709805,28],["ὡς",714148,11],["χαλκεὺς",713691,4],["φυσῶν",713631,72],["ἄνθρακας",701160,57],["καὶ",707031,7],["ἐκφέρων",704356,72],["σκεῦος",711844,25],["εἰς",704105,0],["ἔργον",705396,25],["ἐγὼ",704018,164],["δὲ",703303,11],["ἔκτισά",707938,155],["σε",711598,163],["οὐκ",709805,28],["εἰς",704105,0],["ἀπώλειαν",701660,9],["φθεῖραι",713445,106]],"Behold, I have created thee, not as the coppersmith blowing coals, and bringing out a vessel [fit] for work; but I have created thee, not for ruin, that [I] should destroy [thee]."],["17",[["πᾶν",710177,46],["σκεῦος",711844,25],["φθαρτόν",713441,46],["ἐπὶ",705080,0],["σὲ",711598,163],["οὐκ",709805,28],["εὐοδώσω",705654,165],["καὶ",707031,7],["πᾶσα",710177,29],["φωνὴ",713640,12],["ἀναστήσεται",701173,93],["ἐπὶ",705080,0],["σὲ",711598,163],["εἰς",704105,0],["κρίσιν",707908,9],["πάντας",710177,60],["αὐτοὺς",702165,62],["ἡττήσεις",706040,166],["οἱ",709436,136],["δὲ",703303,11],["ἔνοχοί",704781,138],["σου",711945,133],["ἔσονται",704093,135],["ἐν",704639,0],["αὐτῇ",702165,105],["ἔστιν",704093,91],["κληρονομία",707725,12],["τοῖς",709436,147],["θεραπεύουσιν",706200,197],["κύριον",707996,6],["καὶ",707031,7],["ὑμεῖς",713081,219],["ἔσεσθέ",704093,124],["μοι",708974,159],["δίκαιοι",703694,138],["λέγει",708124,91],["κύριος",707996,4]],"I will not suffer any weapon formed against thee to prosper; and every voice that shall rise up against thee for judgment, thou shalt vanquish them all; and thine adversaries shall be [condemned] thereby. There is an inheritance to them that serve the Lord, and ye shall be righteous before me, saith the Lord."]]