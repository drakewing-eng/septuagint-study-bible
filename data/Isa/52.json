[["1",[["ἐξεγείρου",704889,253],["ἐξεγείρου",704889,253],["Σιων",711816,12],["ἔνδυσαι",704701,300],["τὴν",709436,8],["ἰσχύν",706858,9],["σου",711945,133],["Σιων",711816,12],["καὶ",707031,7],["ἔνδυσαι",704701,300],["τὴν",709436,8],["δόξαν",703791,9],["σου",711945,133],["Ιερουσαλημ",706644,12],["πόλις",710612,12],["ἡ",709436,10],["ἁγία",700159,68],["οὐκέτι",709827,28],["προστεθήσεται",710965,134],["διελθεῖν",703673,106],["διὰ",703417,0],["σοῦ",711945,133],["ἀπερίτμητος",701397,14],["καὶ",707031,7],["ἀκάθαρτος",700508,14]],"Awake, awake, Sion; put on thy strength, O Sion; and do thou put on thy glory, Jerusalem the holy city: there shall no more pass through thee the uncircumcised and unclean."],["2",[["ἐκτίναξαι",704334,300],["τὸν",709436,5],["χοῦν",713930,6],["καὶ",707031,7],["ἀνάστηθι",701173,176],["κάθισον",707006,176],["Ιερουσαλημ",706644,12],["ἔκδυσαι",704180,300],["τὸν",709436,5],["δεσμὸν",703372,6],["τοῦ",709436,35],["τραχήλου",712924,18],["σου",711945,133],["ἡ",709436,10],["αἰχμάλωτος",700503,29],["θυγάτηρ",706320,12],["Σιων",711816,17]],"Shake off the dust and arise; sit down, Jerusalem: put off the band of thy neck, captive daughter of Sion."],["3",[["ὅτι",709803,7],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["δωρεὰν",703900,9],["ἐπράθητε",710480,472],["καὶ",707031,7],["οὐ",709805,28],["μετὰ",708780,0],["ἀργυρίου",701707,21],["λυτρωθήσεσθε",708282,261]],"For thus saith the Lord, Ye have been sold for nought; and ye shall not be ransomed with silver."],["4",[["οὕτως",709859,28],["λέγει",708124,91],["κύριος",707996,4],["εἰς",704105,0],["Αἴγυπτον",700401,9],["κατέβη",707202,2],["ὁ",709436,3],["λαός",708094,4],["μου",709032,133],["τὸ",709436,24],["πρότερον",710991,46],["παροικῆσαι",710156,106],["ἐκεῖ",704181,28],["καὶ",707031,7],["εἰς",704105,0],["Ἀσσυρίους",702004,57],["βίᾳ",702712,1],["ἤχθησαν",700209,99]],"Thus saith the Lord, My people went down before to Egypt to sojourn there; and were carried away forcibly to the Assyrians."],["5",[["καὶ",707031,7],["νῦν",709384,28],["τί",712867,126],["ὧδέ",714090,28],["ἐστε",704093,87],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὅτι",709803,7],["ἐλήμφθη",708076,37],["ὁ",709436,3],["λαός",708094,4],["μου",709032,133],["δωρεάν",703901,9],["θαυμάζετε",706135,335],["καὶ",707031,7],["ὀλολύζετε",709593,335],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["δι᾿",703417,0],["ὑμᾶς",713080,194],["διὰ",703417,0],["παντὸς",710177,116],["τὸ",709436,24],["ὄνομά",709666,25],["μου",709032,133],["βλασφημεῖται",702737,391],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96]],"And now why are ye here? Thus saith the Lord, Because my people was taken for nothing, wonder ye and howl. Thus saith the Lord, On account of you my name is continually blasphemed among the Gentiles."],["6",[["διὰ",703417,0],["τοῦτο",709858,129],["γνώσεται",703105,93],["ὁ",709436,3],["λαός",708094,4],["μου",709032,133],["τὸ",709436,24],["ὄνομά",709666,25],["μου",709032,133],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ὅτι",709803,7],["ἐγώ",704018,164],["εἰμι",704093,157],["αὐτὸς",702165,121],["ὁ",709436,3],["λαλῶν",708071,72],["πάρειμι",710126,157]],"Therefore shall my people know my name in that day, for I am he that speaks: I am present,"],["7",[["ὡς",714148,11],["ὥρα",714128,12],["ἐπὶ",705080,0],["τῶν",709436,43],["ὀρέων",709768,44],["ὡς",714148,11],["πόδες",710707,52],["εὐαγγελιζομένου",705547,262],["ἀκοὴν",700561,9],["εἰρήνης",704098,17],["ὡς",714148,11],["εὐαγγελιζόμενος",705547,122],["ἀγαθά",700106,68],["ὅτι",709803,7],["ἀκουστὴν",700584,36],["ποιήσω",710582,165],["τὴν",709436,8],["σωτηρίαν",712658,9],["σου",711945,133],["λέγων",708124,72],["Σιων",711816,258],["βασιλεύσει",702581,127],["σου",711945,133],["ὁ",709436,3],["θεός",706192,4]],"as a season of beauty upon the mountains, as the feet of one preaching glad tidings of peace, as one preaching good news: for I will publish thy salvation, saying, O Sion, thy God shall reign."],["8",[["ὅτι",709803,7],["φωνὴ",713640,12],["τῶν",709436,80],["φυλασσόντων",713619,170],["σε",711598,163],["ὑψώθη",713289,37],["καὶ",707031,7],["τῇ",709436,100],["φωνῇ",713640,1],["ἅμα",700745,28],["εὐφρανθήσονται",705715,144],["ὅτι",709803,7],["ὀφθαλμοὶ",709870,52],["πρὸς",710844,0],["ὀφθαλμοὺς",709870,57],["ὄψονται",709725,135],["ἡνίκα",706008,28],["ἂν",700900,11],["ἐλεήσῃ",704418,172],["κύριος",707996,4],["τὴν",709436,8],["Σιων",711816,9]],"For the voice of them that guard thee is exalted, and with the voice together they shall rejoice: for eyes shall look to eyes, when the Lord shall have mercy upon Sion."],["9",[["ῥηξάτω",711243,45],["εὐφροσύνην",705717,9],["ἅμα",700745,28],["τὰ",709436,63],["ἔρημα",705420,195],["Ιερουσαλημ",706644,17],["ὅτι",709803,7],["ἠλέησεν",704418,2],["κύριος",707996,4],["αὐτὴν",702165,104],["καὶ",707031,7],["ἐρρύσατο",711309,23],["Ιερουσαλημ",706644,9]],"Let the waste places of Jerusalem break forth [in] joy together, because the Lord has had mercy upon her, and has delivered Jerusalem."],["10",[["καὶ",707031,7],["ἀποκαλύψει",701474,127],["κύριος",707996,4],["τὸν",709436,5],["βραχίονα",702808,6],["αὐτοῦ",702165,102],["τὸν",709436,5],["ἅγιον",700159,27],["ἐνώπιον",704823,28],["πάντων",710177,83],["τῶν",709436,43],["ἐθνῶν",704068,44],["καὶ",707031,7],["ὄψονται",709725,135],["πάντα",710177,195],["τὰ",709436,63],["ἄκρα",700610,195],["τῆς",709436,16],["γῆς",703083,17],["τὴν",709436,8],["σωτηρίαν",712658,9],["τὴν",709436,8],["παρὰ",709995,0],["τοῦ",709436,35],["θεοῦ",706192,18]],"And the Lord shall reveal his holy arm in the sight of all the nations; and all the ends of the earth shall see the salvation that [comes] from our God."],["11",[["ἀπόστητε",702214,74],["ἀπόστητε",702214,74],["ἐξέλθατε",704909,74],["ἐκεῖθεν",704182,28],["καὶ",707031,7],["ἀκαθάρτου",700508,92],["μὴ",708851,28],["ἅπτεσθε",701654,73],["ἐξέλθατε",704909,74],["ἐκ",704132,0],["μέσου",708768,116],["αὐτῆς",702165,86],["ἀφορίσθητε",702227,372],["οἱ",709436,136],["φέροντες",713428,146],["τὰ",709436,41],["σκεύη",711844,42],["κυρίου",707996,18]],"Depart ye, depart, go out from thence, and touch not the unclean thing; go ye out from the midst of her; separate yourselves, ye that bear the vessels of the Lord."],["12",[["ὅτι",709803,7],["οὐ",709805,28],["μετὰ",708780,0],["ταραχῆς",712722,17],["ἐξελεύσεσθε",704909,124],["οὐδὲ",709816,7],["φυγῇ",713609,1],["πορεύσεσθε",710667,124],["πορεύσεται",710667,93],["γὰρ",702963,11],["πρότερος",710992,14],["ὑμῶν",713091,145],["κύριος",707996,4],["καὶ",707031,7],["ὁ",709436,3],["ἐπισυνάγων",705280,72],["ὑμᾶς",713080,194],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18]],"For ye shall not go forth with tumult, neither go by flight: for the Lord shall go first in advance of you; and the God of Israel shall be he that brings up your rear."],["13",[["ἰδοὺ",706497,88],["συνήσει",712481,127],["ὁ",709436,3],["παῖς",709932,4],["μου",709032,133],["καὶ",707031,7],["ὑψωθήσεται",713289,134],["καὶ",707031,7],["δοξασθήσεται",703792,134],["σφόδρα",712586,28]],"Behold, my servant shall understand, and be exalted, and glorified exceedingly."],["14",[["ὃν",709781,112],["τρόπον",712980,6],["ἐκστήσονται",704940,135],["ἐπὶ",705080,0],["σὲ",711598,163],["πολλοί",710646,138],["οὕτως",709859,28],["ἀδοξήσει",700284,127],["ἀπὸ",701425,0],["ἀνθρώπων",701163,81],["τὸ",709436,34],["εἶδός",704074,15],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["δόξα",703791,12],["σου",711945,133],["ἀπὸ",701425,0],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"As many shall be amazed at thee, so shall thy face be without glory from men, and thy glory [shall not be honoured] by the sons of men."],["15",[["οὕτως",709859,28],["θαυμάσονται",706135,135],["ἔθνη",704068,64],["πολλὰ",710646,195],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["καὶ",707031,7],["συνέξουσιν",712469,218],["βασιλεῖς",702580,52],["τὸ",709436,24],["στόμα",712125,25],["αὐτῶν",702165,40],["ὅτι",709803,7],["οἷς",709781,311],["οὐκ",709805,28],["ἀνηγγέλη",700921,37],["περὶ",710285,0],["αὐτοῦ",702165,102],["ὄψονται",709725,135],["καὶ",707031,7],["οἳ",709781,250],["οὐκ",709805,28],["ἀκηκόασιν",700587,353],["συνήσουσιν",712481,218]],"Thus shall many nations wonder at him; and kings shall keep their mouths shut: for they to whom no report was brought concerning him, shall see; and they who have not heard, shall consider."]]