[["1",[["ἐγένετο",703104,23],["δὲ",703303,11],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["ἐμαλακίσθη",708437,37],["Εζεκιας",704044,4],["ἕως",705792,0],["θανάτου",706096,18],["καὶ",707031,7],["ἦλθεν",705453,2],["πρὸς",710844,0],["αὐτὸν",702165,85],["Ησαιας",706026,4],["υἱὸς",713075,4],["Αμως",700898,18],["ὁ",709436,3],["προφήτης",711009,4],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτόν",702165,85],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["τάξαι",712730,300],["περὶ",710285,0],["τοῦ",709436,35],["οἴκου",709516,18],["σου",711945,133],["ἀποθνῄσκεις",701461,154],["γὰρ",702963,11],["σὺ",712181,164],["καὶ",707031,7],["οὐ",709805,28],["ζήσῃ",705851,123]],"And it came to pass at that time, [that] Ezekias was sick even to death. And Esaias the prophet the son of Amos came to him, and said to him, Thus saith the Lord, Give orders concerning thy house: for thou shalt die, and not live."],["2",[["καὶ",707031,7],["ἀπέστρεψεν",701598,2],["Εζεκιας",704044,4],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["πρὸς",710844,0],["τὸν",709436,5],["τοῖχον",712879,6],["καὶ",707031,7],["προσηύξατο",710893,23],["πρὸς",710844,0],["κύριον",707996,6]],"And Ezekias turned his face to the wall, and prayed to the Lord, saying,"],["3",[["λέγων",708124,72],["μνήσθητι",708960,244],["κύριε",707996,153],["ὡς",714148,28],["ἐπορεύθην",710667,156],["ἐνώπιόν",704823,28],["σου",711945,133],["μετὰ",708780,0],["ἀληθείας",700656,17],["ἐν",704639,0],["καρδίᾳ",707141,1],["ἀληθινῇ",700659,101],["καὶ",707031,7],["τὰ",709436,41],["ἀρεστὰ",701723,68],["ἐνώπιόν",704823,28],["σου",711945,133],["ἐποίησα",710582,155],["καὶ",707031,7],["ἔκλαυσεν",707703,2],["Εζεκιας",704044,4],["κλαυθμῷ",707705,114],["μεγάλῳ",708653,30]],"Remember, O Lord, how I have walked before thee in truth, with a true heart, and have done that which was pleasing in thy sight. And Ezekias wept bitterly."],["4",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρὸς",710844,0],["Ησαιαν",706026,6],["λέγων",708124,72]],"And the word of the Lord came to Esaias, saying, Go, and say to Ezekias,"],["5",[["πορεύθητι",710667,300],["καὶ",707031,7],["εἰπὸν",705373,176],["Εζεκια",704044,6],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Δαυιδ",703232,18],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["ἤκουσα",700587,155],["τῆς",709436,16],["φωνῆς",713640,17],["τῆς",709436,16],["προσευχῆς",710892,17],["σου",711945,133],["καὶ",707031,7],["εἶδον",709725,150],["τὰ",709436,41],["δάκρυά",703255,42],["σου",711945,133],["ἰδοὺ",706497,88],["προστίθημι",710965,157],["πρὸς",710844,0],["τὸν",709436,5],["χρόνον",713969,6],["σου",711945,133],["ἔτη",705543,42],["δέκα",703333,59],["πέντε",710266,59]],"Thus saith the Lord, the God of David thy father, I have heard thy prayer, and seen thy tears: behold, I [will] add to thy time fifteen years."],["6",[["καὶ",707031,7],["ἐκ",704132,0],["χειρὸς",713787,17],["βασιλέως",702580,18],["Ἀσσυρίων",702004,81],["σώσω",712627,165],["σε",711598,163],["καὶ",707031,7],["ὑπὲρ",713111,0],["τῆς",709436,16],["πόλεως",710612,17],["ταύτης",709858,86],["ὑπερασπιῶ",713121,165]],"And I will deliver thee and this city out of the hand of the king of the Assyrians: and I will defend this city.",{"s":"d","q":0.69}],["7",[["τοῦτο",709858,132],["δέ",703303,11],["σοι",711925,159],["τὸ",709436,34],["σημεῖον",711748,15],["παρὰ",709995,0],["κυρίου",707996,18],["ὅτι",709803,7],["ὁ",709436,3],["θεὸς",706192,4],["ποιήσει",710582,127],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129]],"And this [shall be] a sign to thee from the Lord, that God will do this thing;"],["8",[["τὴν",709436,8],["σκιὰν",711852,9],["τῶν",709436,80],["ἀναβαθμῶν",700904,81],["οὓς",709781,298],["κατέβη",707202,2],["ὁ",709436,3],["ἥλιος",705974,4],["τοὺς",709436,58],["δέκα",703333,59],["ἀναβαθμοὺς",700904,57],["τοῦ",709436,35],["οἴκου",709516,18],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["ἀποστρέψω",701598,165],["τὸν",709436,5],["ἥλιον",705974,6],["τοὺς",709436,58],["δέκα",703333,59],["ἀναβαθμούς",700904,57],["καὶ",707031,7],["ἀνέβη",700905,2],["ὁ",709436,3],["ἥλιος",705974,4],["τοὺς",709436,58],["δέκα",703333,59],["ἀναβαθμούς",700904,57],["οὓς",709781,298],["κατέβη",707202,2],["ἡ",709436,10],["σκιά",711852,12]],"behold, I will turn back the shadow of the degrees [of the dial] by which ten degrees on the house of thy father the sun has gone down—I will turn back the sun the ten degrees; so the sun went back the ten degrees by which the shadow had gone down."],["9",[["προσευχὴ",710892,12],["Εζεκιου",704044,18],["βασιλέως",702580,18],["τῆς",709436,16],["Ιουδαίας",706769,17],["ἡνίκα",706008,28],["ἐμαλακίσθη",708437,37],["καὶ",707031,7],["ἀνέστη",701173,2],["ἐκ",704132,0],["τῆς",709436,16],["μαλακίας",708435,17],["αὐτοῦ",702165,102]],"The Prayer of Ezekias king of Judea, when he had been sick, and was recovered from his sickness."],["10",[["ἐγὼ",704018,164],["εἶπα",705373,155],["ἐν",704639,0],["τῷ",709436,53],["ὕψει",713288,54],["τῶν",709436,130],["ἡμερῶν",705984,65],["μου",709032,133],["ἐν",704639,0],["πύλαις",711082,76],["ᾅδου",700255,18],["καταλείψω",707305,165],["τὰ",709436,41],["ἔτη",705543,42],["τὰ",709436,41],["ἐπίλοιπα",705194,68]],"I said in the end of my days, I shall go to the gates of the grave: I shall part with the remainder of my years."],["11",[["εἶπα",705373,155],["οὐκέτι",709827,28],["μὴ",708851,28],["ἴδω",709725,207],["τὸ",709436,24],["σωτήριον",712659,25],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["οὐκέτι",709827,28],["μὴ",708851,28],["ἴδω",709725,207],["ἄνθρωπον",701163,6]],"I said, I shall no more at all see the salvation of God in the land of the living: I shall no more at all see the salvation of Israel on the earth: I shall no more at all see man.",{"s":"d","q":0.58}],["12",[["ἐκ",704132,0],["τῆς",709436,16],["συγγενείας",712184,17],["μου",709032,133],["κατέλιπον",707305,150],["τὸ",709436,24],["λοιπὸν",708247,46],["τῆς",709436,16],["ζωῆς",705910,17],["μου",709032,133],["ἐξῆλθεν",704909,2],["καὶ",707031,7],["ἀπῆλθεν",701398,2],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["ὥσπερ",714163,28],["ὁ",709436,3],["καταλύων",707323,72],["σκηνὴν",711845,9],["πήξας",710452,182],["τὸ",709436,24],["πνεῦμά",710566,25],["μου",709032,133],["παρ᾿",709995,0],["ἐμοὶ",704577,159],["ἐγένετο",703104,23],["ὡς",714148,28],["ἱστὸς",706850,4],["ἐρίθου",705425,17],["ἐγγιζούσης",703939,222],["ἐκτεμεῖν",704324,296],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["παρεδόθην",710014,156]],"[My life] has failed from among my kindred: I have parted with the remainder of my life: it has gone forth and departed from me, as one that having pitched a tent takes it down [again]: my breath was with me as a weaver's web, when she that weaves draws nigh to cut off [the] thread."],["13",[["ἕως",705792,7],["πρωὶ",711021,28],["ὡς",714148,28],["λέοντι",708171,114],["οὕτως",709859,28],["τὰ",709436,41],["ὀστᾶ",709792,42],["μου",709032,133],["συνέτριψεν",712520,2],["ἀπὸ",701425,0],["γὰρ",702963,11],["τῆς",709436,16],["ἡμέρας",705984,17],["ἕως",705792,0],["τῆς",709436,16],["νυκτὸς",709386,17],["παρεδόθην",710014,156]],"In that day I was given up as to a lion until the morning: so has he broken all my bones: for I was so given up from day [even] to night."],["14",[["ὡς",714148,28],["χελιδών",713809,12],["οὕτως",709859,28],["φωνήσω",713639,165],["καὶ",707031,7],["ὡς",714148,28],["περιστερά",710391,12],["οὕτως",709859,28],["μελετήσω",708698,165],["ἐξέλιπον",704237,150],["γάρ",702963,11],["μου",709032,133],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["τοῦ",709436,20],["βλέπειν",702740,55],["εἰς",704105,0],["τὸ",709436,24],["ὕψος",713288,25],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["πρὸς",710844,0],["τὸν",709436,5],["κύριον",707996,6],["ὃς",709781,213],["ἐξείλατό",704838,2],["με",708618,163]],"As a swallow, so will I cry, and as a dove, so do I mourn: for mine eyes have failed with looking to the height of heaven to the Lord, who has delivered me,"],["15",[["καὶ",707031,7],["ἀφείλατό",702177,23],["μου",709032,133],["τὴν",709436,8],["ὀδύνην",709463,9],["τῆς",709436,16],["ψυχῆς",714070,17]],"and removed the sorrow of my soul."],["16",[["κύριε",707996,153],["περὶ",710285,0],["αὐτῆς",702165,86],["γὰρ",702963,11],["ἀνηγγέλη",700921,37],["σοι",711925,159],["καὶ",707031,7],["ἐξήγειράς",704889,162],["μου",709032,133],["τὴν",709436,8],["πνοήν",710574,9],["καὶ",707031,7],["παρακληθεὶς",710039,217],["ἔζησα",705851,155]],"[Yea], O Lord, for it was told thee concerning this; and thou hast revived my breath; and I am comforted, and live."],["17",[["εἵλου",700472,174],["γάρ",702963,11],["μου",709032,133],["τὴν",709436,8],["ψυχήν",714070,9],["ἵνα",706747,7],["μὴ",708851,28],["ἀπόληται",701513,239],["καὶ",707031,7],["ἀπέρριψας",701563,162],["ὀπίσω",709697,28],["μου",709032,133],["πάσας",710177,119],["τὰς",709436,38],["ἁμαρτίας",700775,39],["μου",709032,133]],"For thou hast chosen my soul, that it should not perish: and thou hast cast all [my] sins behind me."],["18",[["οὐ",709805,28],["γὰρ",702963,11],["οἱ",709436,136],["ἐν",704639,0],["ᾅδου",700255,18],["αἰνέσουσίν",700459,218],["σε",711598,163],["οὐδὲ",709816,7],["οἱ",709436,136],["ἀποθανόντες",701461,196],["εὐλογήσουσίν",705631,218],["σε",711598,163],["οὐδὲ",709816,7],["ἐλπιοῦσιν",704529,218],["οἱ",709436,136],["ἐν",704639,0],["ᾅδου",700255,18],["τὴν",709436,8],["ἐλεημοσύνην",704421,9],["σου",711945,133]],"For they that are in the grave shall not praise thee, neither shall the dead bless thee, neither shall they that are in Hades hope for thy mercy."],["19",[["οἱ",709436,136],["ζῶντως",705851,146],["εὐλογήσουσίν",705631,218],["σε",711598,163],["ὃν",709781,112],["τρόπον",712980,6],["κἀγώ",706969,288],["ἀπὸ",701425,0],["γὰρ",702963,11],["τῆς",709436,16],["σήμερον",711751,28],["παιδία",709927,42],["ποιήσω",710582,165],["ἃ",709781,69],["ἀναγγελοῦσιν",700921,218],["τὴν",709436,8],["δικαιοσύνην",703695,9],["σου",711945,133]],"The living shall bless thee, as I also [do]: for from this day shall I beget children, who shall declare thy righteousness,"],["20",[["κύριε",707996,153],["τῆς",709436,16],["σωτηρίας",712658,17],["μου",709032,133],["καὶ",707031,7],["οὐ",709805,28],["παύσομαι",710202,181],["εὐλογῶν",705631,72],["σε",711598,163],["μετὰ",708780,0],["ψαλτηρίου",714023,21],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["τῆς",709436,16],["ζωῆς",705910,17],["μου",709032,133],["κατέναντι",707507,28],["τοῦ",709436,35],["οἴκου",709516,18],["τοῦ",709436,35],["θεοῦ",706192,18]],"O God of my salvation; and I will not cease blessing thee with the psaltery all the days of my life before the house of God."],["21",[["καὶ",707031,7],["εἶπεν",705373,2],["Ησαιας",706026,4],["πρὸς",710844,0],["Εζεκιαν",704044,6],["λαβὲ",708076,240],["παλάθην",709934,9],["ἐκ",704132,0],["σύκων",712254,65],["καὶ",707031,7],["τρῖψον",712940,176],["καὶ",707031,7],["κατάπλασαι",707377,300],["καὶ",707031,7],["ὑγιὴς",713059,14],["ἔσῃ",704093,123]],"Now Esaias had said to Ezekias; Take a cake of figs, and mash them, and apply them as a plaister, and thou shalt be well."],["22",[["καὶ",707031,7],["εἶπεν",705373,2],["Εζεκιας",704044,4],["τοῦτο",709858,85],["τὸ",709436,24],["σημεῖον",711748,25],["ὅτι",709803,7],["ἀναβήσομαι",700905,181],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18]],"And Ezekias said, This is a sign to Ezekias, that I shall go up to the house of God."]]