[["1",[["προσαγάγετε",710848,74],["ἔθνη",704068,64],["καὶ",707031,7],["ἀκούσατε",700587,74],["ἄρχοντες",701862,52],["ἀκουσάτω",700587,45],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["οἱ",709436,136],["ἐν",704639,0],["αὐτῇ",702165,105],["ἡ",709436,10],["οἰκουμένη",709517,211],["καὶ",707031,7],["ὁ",709436,3],["λαὸς",708094,4],["ὁ",709436,3],["ἐν",704639,0],["αὐτῇ",702165,105]],"Draw near, ye nations; and hearken, ye princes; let the earth hear, and they that are in it; the world, and the people that are therein."],["2",[["διότι",703734,7],["θυμὸς",706334,4],["κυρίου",707996,18],["ἐπὶ",705080,0],["πάντα",710177,46],["τὰ",709436,41],["ἔθνη",704068,42],["καὶ",707031,7],["ὀργὴ",709728,12],["ἐπὶ",705080,0],["τὸν",709436,5],["ἀριθμὸν",701744,6],["αὐτῶν",702165,70],["τοῦ",709436,20],["ἀπολέσαι",701513,106],["αὐτοὺς",702165,62],["καὶ",707031,7],["παραδοῦναι",710014,106],["αὐτοὺς",702165,62],["εἰς",704105,0],["σφαγήν",712568,9]],"For the wrath of the Lord is upon all nations, and [his] anger upon the number of them, to destroy them, and give them up to slaughter."],["3",[["οἱ",709436,136],["δὲ",703303,11],["τραυματίαι",712921,52],["αὐτῶν",702165,70],["ῥιφήσονται",711267,144],["καὶ",707031,7],["οἱ",709436,136],["νεκροί",709247,52],["καὶ",707031,7],["ἀναβήσεται",700905,93],["αὐτῶν",702165,70],["ἡ",709436,10],["ὀσμή",709786,12],["καὶ",707031,7],["βραχήσεται",702812,134],["τὰ",709436,63],["ὄρη",709768,64],["ἀπὸ",701425,0],["τοῦ",709436,20],["αἵματος",700442,21],["αὐτῶν",702165,70]],"And their slain shall be cast forth, and their corpses; and their [ill] savour shall come up, and the mountains shall be made wet with their blood."],["4",[["καὶ",707031,7],["ἑλιγήσεται",704491,134],["ὁ",709436,3],["οὐρανὸς",709844,4],["ὡς",714148,28],["βιβλίον",702719,25],["καὶ",707031,7],["πάντα",710177,195],["τὰ",709436,63],["ἄστρα",702024,64],["πεσεῖται",710481,93],["ὡς",714148,28],["φύλλα",713622,42],["ἐξ",704132,0],["ἀμπέλου",700870,17],["καὶ",707031,7],["ὡς",714148,28],["πίπτει",710481,91],["φύλλα",713622,42],["ἀπὸ",701425,0],["συκῆς",712254,17]],"And all the powers of the heavens shall melt, and the sky shall be rolled up like a scroll: and all the stars shall fall like leaves from a vine, and as leaves fall from a fig-tree."],["5",[["ἐμεθύσθη",708676,37],["ἡ",709436,10],["μάχαιρά",708593,12],["μου",709032,133],["ἐν",704639,0],["τῷ",709436,113],["οὐρανῷ",709844,114],["ἰδοὺ",706497,88],["ἐπὶ",705080,0],["τὴν",709436,8],["Ιδουμαίαν",706503,9],["καταβήσεται",707202,93],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸν",709436,5],["λαὸν",708094,6],["τῆς",709436,16],["ἀπωλείας",701660,17],["μετὰ",708780,0],["κρίσεως",707908,17]],"My sword has been made drunk in heaven: behold, it shall come down upon Idumea, and with judgment upon the people doomed to destruction."],["6",[["ἡ",709436,10],["μάχαιρα",708593,12],["κυρίου",707996,18],["ἐνεπλήσθη",704592,37],["αἵματος",700442,21],["ἐπαχύνθη",710205,37],["ἀπὸ",701425,0],["στέατος",712054,21],["ἀρνῶν",701731,81],["καὶ",707031,7],["ἀπὸ",701425,0],["στέατος",712054,21],["τράγων",712917,81],["καὶ",707031,7],["κριῶν",707906,81],["ὅτι",709803,7],["θυσία",706345,12],["κυρίῳ",707996,114],["ἐν",704639,0],["Βοσορ",702768,114],["καὶ",707031,7],["σφαγὴ",712568,12],["μεγάλη",708653,29],["ἐν",704639,0],["τῇ",709436,100],["Ιδουμαίᾳ",706503,1]],"The sword of the Lord is filled with blood, it is glutted with fat, with the blood of goats and lambs, and with the fat of goats and rams: for the Lord has a sacrifice in Bosor, and a great slaughter in Idumea."],["7",[["καὶ",707031,7],["συμπεσοῦνται",712332,135],["οἱ",709436,136],["ἁδροὶ",700292,138],["μετ᾿",708780,0],["αὐτῶν",702165,40],["καὶ",707031,7],["οἱ",709436,136],["κριοὶ",707906,52],["καὶ",707031,7],["οἱ",709436,136],["ταῦροι",712734,52],["καὶ",707031,7],["μεθυσθήσεται",708676,134],["ἡ",709436,10],["γῆ",703083,12],["ἀπὸ",701425,0],["τοῦ",709436,20],["αἵματος",700442,21],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,20],["στέατος",712054,21],["αὐτῶν",702165,40],["ἐμπλησθήσεται",704592,134]],"And the mighty ones shall fall with them, and the rams and the bulls; and the land shall be soaked with blood, and shall be filled with their fat."],["8",[["ἡμέρα",705984,12],["γὰρ",702963,11],["κρίσεως",707908,17],["κυρίου",707996,18],["καὶ",707031,7],["ἐνιαυτὸς",704745,4],["ἀνταποδόσεως",701217,17],["κρίσεως",707908,17],["Σιων",711816,17]],"For it is the day of the judgment of the Lord, and the year of the recompence of Sion in judgment."],["9",[["καὶ",707031,7],["στραφήσονται",712160,144],["αὐτῆς",702165,86],["αἱ",709436,190],["φάραγγες",713351,191],["εἰς",704105,0],["πίσσαν",710482,9],["καὶ",707031,7],["ἡ",709436,10],["γῆ",703083,12],["αὐτῆς",702165,86],["εἰς",704105,0],["θεῖον",706154,27],["καὶ",707031,7],["ἔσται",704093,93],["αὐτῆς",702165,86],["ἡ",709436,10],["γῆ",703083,12],["καιομένη",707049,211],["ὡς",714148,28],["πίσσα",710482,12]],"And her valleys shall be turned into pitch, and her land into sulphur; and her land shall be as pitch burning night and day;"],["10",[["νυκτὸς",709386,17],["καὶ",707031,7],["ἡμέρας",705984,17],["καὶ",707031,7],["οὐ",709805,28],["σβεσθήσεται",711596,134],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["χρόνον",713969,6],["καὶ",707031,7],["ἀναβήσεται",700905,93],["ὁ",709436,3],["καπνὸς",707132,4],["αὐτῆς",702165,86],["ἄνω",701296,28],["εἰς",704105,0],["γενεὰς",703037,39],["ἐρημωθήσεται",705421,134],["καὶ",707031,7],["εἰς",704105,0],["χρόνον",713969,6],["πολύν",710646,27]],"and it shall never be quenched, and her smoke shall go up: it shall be made desolate throughout her generations,"],["11",[["καὶ",707031,7],["κατοικήσουσιν",707534,218],["ἐν",704639,0],["αὐτῇ",702165,105],["ὄρνεα",709762,64],["καὶ",707031,7],["ἐχῖνοι",705780,52],["καὶ",707031,7],["ἴβεις",706474,191],["καὶ",707031,7],["κόρακες",707831,52],["καὶ",707031,7],["ἐπιβληθήσεται",705083,134],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["σπαρτίον",711999,25],["γεωμετρίας",703077,17],["ἐρήμου",705420,17],["καὶ",707031,7],["ὀνοκένταυροι",709664,52],["οἰκήσουσιν",709499,218],["ἐν",704639,0],["αὐτῇ",702165,105]],"and for a long time birds and hedgehogs, and ibises and ravens shall dwell in it: and the measuring line of desolation shall be cast over it, and satyrs shall dwell in it."],["12",[["οἱ",709436,136],["ἄρχοντες",701862,52],["αὐτῆς",702165,86],["οὐκ",709805,28],["ἔσονται",704093,135],["οἱ",709436,136],["γὰρ",702963,11],["βασιλεῖς",702580,52],["αὐτῆς",702165,86],["καὶ",707031,7],["οἱ",709436,136],["ἄρχοντες",701862,52],["αὐτῆς",702165,86],["καὶ",707031,7],["οἱ",709436,136],["μεγιστᾶνες",708657,52],["αὐτῆς",702165,86],["ἔσονται",704093,135],["εἰς",704105,0],["ἀπώλειαν",701660,9]],"Her princes shall be no more; for her kings and her great men shall be destroyed."],["13",[["καὶ",707031,7],["ἀναφύσει",701088,127],["εἰς",704105,0],["τὰς",709436,38],["πόλεις",710612,39],["αὐτῶν",702165,40],["ἀκάνθινα",700518,68],["ξύλα",709427,42],["καὶ",707031,7],["εἰς",704105,0],["τὰ",709436,41],["ὀχυρώματα",709891,42],["αὐτῆς",702165,86],["καὶ",707031,7],["ἔσται",704093,93],["ἔπαυλις",705048,12],["σειρήνων",711627,65],["καὶ",707031,7],["αὐλὴ",702137,12],["στρουθῶν",712167,81]],"And thorns shall spring up in their cities, and in her strong holds: and they shall be habitations of monsters, and a court for ostriches."],["14",[["καὶ",707031,7],["συναντήσουσιν",712394,218],["δαιμόνια",703249,64],["ὀνοκενταύροις",709664,148],["καὶ",707031,7],["βοήσουσιν",702743,218],["ἕτερος",705535,14],["πρὸς",710844,0],["τὸν",709436,5],["ἕτερον",705535,27],["ἐκεῖ",704181,28],["ἀναπαύσονται",701027,135],["ὀνοκένταυροι",709664,52],["εὗρον",705676,150],["γὰρ",702963,11],["αὑτοῖς",703917,151],["ἀνάπαυσιν",701026,9]],"And devils shall meet with satyrs, and they shall cry one to the other: there shall satyrs rest, having found for themselves [a place of] rest."],["15",[["ἐκεῖ",704181,28],["ἐνόσσευσεν",709359,2],["ἐχῖνος",705780,4],["καὶ",707031,7],["ἔσωσεν",712627,2],["ἡ",709436,10],["γῆ",703083,12],["τὰ",709436,41],["παιδία",709927,42],["αὐτῆς",702165,86],["μετὰ",708780,0],["ἀσφαλείας",702039,17],["ἐκεῖ",704181,28],["ἔλαφοι",704398,52],["συνήντησαν",712394,150],["καὶ",707031,7],["εἶδον",709725,150],["τὰ",709436,41],["πρόσωπα",710986,42],["ἀλλήλων",700689,40]],"There has the hedgehog made its nest, and the earth has safely preserved its young: there have the deer met, and seen one another's faces."],["16",[["ἀριθμῷ",701744,114],["παρῆλθον",710141,150],["καὶ",707031,7],["μία",704106,29],["αὐτῶν",702165,40],["οὐκ",709805,28],["ἀπώλετο",701513,23],["ἑτέρα",705535,29],["τὴν",709436,8],["ἑτέραν",705535,36],["οὐκ",709805,28],["ἐζήτησαν",705879,150],["ὅτι",709803,7],["κύριος",707996,4],["ἐνετείλατο",704791,23],["αὐτοῖς",702165,151],["καὶ",707031,7],["τὸ",709436,24],["πνεῦμα",710566,25],["αὐτοῦ",702165,102],["συνήγαγεν",712375,2],["αὐτάς",702165,231]],"They passed by in [full] number, and not one of them perished: they sought not one another; for the Lord commanded them, and his Spirit gathered them."],["17",[["καὶ",707031,7],["αὐτὸς",702165,121],["ἐπιβαλεῖ",705083,127],["αὐτοῖς",702165,151],["κλήρους",707727,57],["καὶ",707031,7],["ἡ",709436,10],["χεὶρ",713787,12],["αὐτοῦ",702165,102],["διεμέρισεν",703518,2],["βόσκεσθαι",702767,110],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["χρόνον",713969,6],["κληρονομήσετε",707724,337],["εἰς",704105,0],["γενεὰς",703037,39],["γενεῶν",703037,65],["ἀναπαύσονται",701027,135],["ἐπ᾿",705080,0],["αὐτῆς",702165,86]],"And he shall cast lots for them, and his hand has portioned out [their] pasture, [saying], Ye shall inherit [the land] for ever: they shall rest on it [through] all generations."]]