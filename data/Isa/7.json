[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["Αχαζ",702245,18],["τοῦ",709436,35],["Ιωαθαμ",706885,18],["τοῦ",709436,35],["υἱοῦ",713075,18],["Οζιου",709479,18],["βασιλέως",702580,18],["Ιουδα",706768,18],["ἀνέβη",700905,2],["Ραασσων",711127,4],["βασιλεὺς",702580,4],["Αραμ",701682,18],["καὶ",707031,7],["Φακεε",713315,4],["υἱὸς",713075,4],["Ρομελιου",711289,18],["βασιλεὺς",702580,4],["Ισραηλ",706839,18],["ἐπὶ",705080,0],["Ιερουσαλημ",706644,9],["πολεμῆσαι",710601,106],["αὐτὴν",702165,104],["καὶ",707031,7],["οὐκ",709805,28],["ἠδυνήθησαν",703838,99],["πολιορκῆσαι",710608,300],["αὐτήν",702165,104]],"And it came to pass in the days of Achaz [the son] of Joatham, the son of Ozias, king of Juda, there came up Rasin king of Aram, and Phakee son of Romelias, king of Israel, against Jerusalem to war against it, but they could not take it."],["2",[["καὶ",707031,7],["ἀνηγγέλη",700921,37],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["Δαυιδ",703232,18],["λέγοντες",708124,146],["συνεφώνησεν",712366,2],["Αραμ",701682,4],["πρὸς",710844,0],["τὸν",709436,5],["Εφραιμ",705769,6],["καὶ",707031,7],["ἐξέστη",704940,2],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἡ",709436,10],["ψυχὴ",714070,12],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτοῦ",702165,102],["ὃν",709781,112],["τρόπον",712980,6],["ὅταν",709801,28],["ἐν",704639,0],["δρυμῷ",703836,114],["ξύλον",709427,25],["ὑπὸ",713184,0],["πνεύματος",710566,21],["σαλευθῇ",711403,384]],"And a message was brought to the house of David, saying, Aram has conspired with Ephraim. And his soul was amazed, and the soul of his people, as in a wood a tree is moved by the wind."],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Ησαιαν",706026,6],["ἔξελθε",704909,176],["εἰς",704105,0],["συνάντησιν",712397,9],["Αχαζ",702245,6],["σὺ",712181,164],["καὶ",707031,7],["ὁ",709436,3],["καταλειφθεὶς",707305,217],["Ιασουβ",706447,4],["ὁ",709436,3],["υἱός",713075,4],["σου",711945,133],["πρὸς",710844,0],["τὴν",709436,8],["κολυμβήθραν",707802,9],["τῆς",709436,16],["ἄνω",701296,28],["ὁδοῦ",709458,17],["τοῦ",709436,35],["ἀγροῦ",700196,18],["τοῦ",709436,35],["γναφέως",703127,18]],"And the Lord said to Esaias, Go forth to meet Achaz, thou, and thy son Jasub who is left, to the pool of the upper way of the fuller's field."],["4",[["καὶ",707031,7],["ἐρεῖς",705415,166],["αὐτῷ",702165,50],["φύλαξαι",713619,300],["τοῦ",709436,20],["ἡσυχάσαι",706033,106],["καὶ",707031,7],["μὴ",708851,28],["φοβοῦ",713532,253],["μηδὲ",708855,7],["ἡ",709436,10],["ψυχή",714070,12],["σου",711945,133],["ἀσθενείτω",701938,31],["ἀπὸ",701425,0],["τῶν",709436,43],["δύο",703849,59],["ξύλων",709427,44],["τῶν",709436,80],["δαλῶν",703268,81],["τῶν",709436,80],["καπνιζομένων",707131,299],["τούτων",709858,40],["ὅταν",709801,28],["γὰρ",702963,11],["ὀργὴ",709728,12],["τοῦ",709436,35],["θυμοῦ",706334,18],["μου",709032,133],["γένηται",703104,239],["πάλιν",709942,28],["ἰάσομαι",706424,181]],"And thou shalt say to him, Take care to be quiet, and fear not, neither let thy soul be disheartened because of these two smoking firebrands: for when my fierce anger is over, I will heal again."],["5",[["καὶ",707031,7],["ὁ",709436,3],["υἱὸς",713075,4],["τοῦ",709436,35],["Αραμ",701682,18],["καὶ",707031,7],["ὁ",709436,3],["υἱὸς",713075,4],["τοῦ",709436,35],["Ρομελιου",711289,18],["ὅτι",709803,7],["ἐβουλεύσαντο",702791,189],["βουλὴν",702792,9],["πονηρὰν",710660,36],["περὶ",710285,0],["σοῦ",711945,133],["λέγοντες",708124,146]],"And [as for] the son of Aram, and the son of Romelias, forasmuch as they have devised an evil counsel, [saying],"],["6",[["ἀναβησόμεθα",700905,141],["εἰς",704105,0],["τὴν",709436,8],["Ιουδαίαν",706769,9],["καὶ",707031,7],["συλλαλήσαντες",712261,196],["αὐτοῖς",702165,151],["ἀποστρέψομεν",701598,275],["αὐτοὺς",702165,62],["πρὸς",710844,0],["ἡμᾶς",705981,194],["καὶ",707031,7],["βασιλεύσομεν",702581,275],["αὐτῆς",702165,86],["τὸν",709436,5],["υἱὸν",713075,6],["Ταβεηλ",712683,18]],"We will go up against Judea, and having conferred with them we will turn them away to our side, and we will make the son of Tabeel king of it;"],["7",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["σαβαωθ",711346,228],["οὐ",709805,28],["μὴ",708851,28],["ἐμμείνῃ",704570,172],["ἡ",709436,10],["βουλὴ",702792,12],["αὕτη",709858,107],["οὐδὲ",709816,7],["ἔσται",704093,93]],"thus saith the Lord of hosts, This counsel shall not abide, nor come to pass."],["8",[["ἀλλ᾿",700680,7],["ἡ",709436,10],["κεφαλὴ",707639,12],["Αραμ",701682,18],["Δαμασκός",703275,4],["ἀλλ᾿",700680,7],["ἔτι",705538,28],["ἑξήκοντα",704922,59],["καὶ",707031,7],["πέντε",710266,59],["ἐτῶν",705543,44],["ἐκλείψει",704237,127],["ἡ",709436,10],["βασιλεία",702577,12],["Εφραιμ",705769,18],["ἀπὸ",701425,0],["λαοῦ",708094,18]],"But the head of Aram is Damascus, and the head of Damascus, Rasim; and yet within sixty and five years the kingdom of Ephraim shall cease from [being] a people.",{"s":"d","q":0.59}],["9",[["καὶ",707031,7],["ἡ",709436,10],["κεφαλὴ",707639,12],["Εφραιμ",705769,18],["Σομορων",711937,12],["καὶ",707031,7],["ἡ",709436,10],["κεφαλὴ",707639,12],["Σομορων",711937,17],["υἱὸς",713075,4],["τοῦ",709436,35],["Ρομελιου",711289,18],["καὶ",707031,7],["ἐὰν",703912,7],["μὴ",708851,28],["πιστεύσητε",710483,125],["οὐδὲ",709816,7],["μὴ",708851,28],["συνῆτε",712481,776]],"And the head of Ephraim is Somoron, and the head of Somoron the son of Romelias: but if ye believe not, neither will ye at all understand."],["10",[["καὶ",707031,7],["προσέθετο",710965,23],["κύριος",707996,4],["λαλῆσαι",708071,106],["τῷ",709436,113],["Αχαζ",702245,114],["λέγων",708124,72]],"And the Lord again spoke to Achaz, saying,"],["11",[["αἴτησαι",700489,300],["σεαυτῷ",711599,50],["σημεῖον",711748,25],["παρὰ",709995,0],["κυρίου",707996,18],["θεοῦ",706192,18],["σου",711945,133],["εἰς",704105,0],["βάθος",702376,25],["ἢ",705924,7],["εἰς",704105,0],["ὕψος",713288,25]],"Ask for thyself a sign of the Lord thy God, in the depth or in the height."],["12",[["καὶ",707031,7],["εἶπεν",705373,2],["Αχαζ",702245,4],["οὐ",709805,28],["μὴ",708851,28],["αἰτήσω",700489,165],["οὐδ᾿",709816,7],["οὐ",709805,28],["μὴ",708851,28],["πειράσω",710225,165],["κύριον",707996,6]],"And Achaz said, I will not ask, neither will I tempt the Lord."],["13",[["καὶ",707031,7],["εἶπεν",705373,2],["ἀκούσατε",700587,74],["δή",703395,11],["οἶκος",709516,4],["Δαυιδ",703232,18],["μὴ",708851,28],["μικρὸν",708915,27],["ὑμῖν",713084,90],["ἀγῶνα",700211,6],["παρέχειν",710142,55],["ἀνθρώποις",701163,148],["καὶ",707031,7],["πῶς",711121,28],["κυρίῳ",707996,114],["παρέχετε",710142,87],["ἀγῶνα",700211,6]],"And he said, Hear ye now, O house of David; is it a little thing for you to contend with men? and how do ye contend against the Lord?"],["14",[["διὰ",703417,0],["τοῦτο",709858,129],["δώσει",703654,127],["κύριος",707996,4],["αὐτὸς",702165,121],["ὑμῖν",713084,90],["σημεῖον",711748,25],["ἰδοὺ",706497,88],["ἡ",709436,10],["παρθένος",710148,12],["ἐν",704639,0],["γαστρὶ",702976,1],["ἕξει",704937,1],["καὶ",707031,7],["τέξεται",712853,93],["υἱόν",713075,6],["καὶ",707031,7],["καλέσεις",707084,166],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["Εμμανουηλ",704568,4]],"Therefore the Lord himself shall give you a sign; behold, a virgin shall conceive in the womb, and shall bring forth a son, and thou shalt call his name Emmanuel."],["15",[["βούτυρον",702800,25],["καὶ",707031,7],["μέλι",708700,25],["φάγεται",713296,93],["πρὶν",710742,28],["ἢ",705924,7],["γνῶναι",703105,106],["αὐτὸν",702165,85],["ἢ",705924,7],["προελέσθαι",710752,109],["πονηρὰ",710660,68],["ἐκλέξεται",704236,93],["τὸ",709436,24],["ἀγαθόν",700106,46]],"Butter and honey shall he eat, before he knows either to prefer evil, [or] choose the good."],["16",[["διότι",703734,7],["πρὶν",710742,28],["ἢ",705924,7],["γνῶναι",703105,106],["τὸ",709436,24],["παιδίον",709927,25],["ἀγαθὸν",700106,46],["ἢ",705924,7],["κακὸν",707066,46],["ἀπειθεῖ",701371,30],["πονηρίᾳ",710659,1],["τοῦ",709436,20],["ἐκλέξασθαι",704236,109],["τὸ",709436,24],["ἀγαθόν",700106,46],["καὶ",707031,7],["καταλειφθήσεται",707305,134],["ἡ",709436,10],["γῆ",703083,12],["ἣν",709781,131],["σὺ",712181,164],["φοβῇ",713532,278],["ἀπὸ",701425,0],["προσώπου",710986,21],["τῶν",709436,80],["δύο",703849,59],["βασιλέων",702580,81]],"For before the child shall know good or evil, he refuses evil, to choose the good; and the land shall be forsaken which thou art afraid of because of the two kings."],["17",[["ἀλλὰ",700680,7],["ἐπάξει",704994,127],["ὁ",709436,3],["θεὸς",706192,4],["ἐπὶ",705080,0],["σὲ",711598,163],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["ἡμέρας",705984,39],["αἳ",709781,256],["οὔπω",709837,28],["ἥκασιν",705956,197],["ἀφ᾿",701425,0],["ἧς",709781,167],["ἡμέρας",705984,17],["ἀφεῖλεν",702177,2],["Εφραιμ",705769,4],["ἀπὸ",701425,0],["Ιουδα",706768,18],["τὸν",709436,5],["βασιλέα",702580,6],["τῶν",709436,80],["Ἀσσυρίων",702004,81]],"But God shall bring upon thee, and upon thy people, and upon the house of thy father, days which have never come, from the day that Ephraim took away from Juda the king of the Assyrians."],["18",[["καὶ",707031,7],["ἔσται",704093,93],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["συριεῖ",712538,127],["κύριος",707996,4],["μυίαις",709050,76],["ὃ",709781,33],["κυριεύει",707995,127],["μέρους",708752,21],["ποταμοῦ",710693,18],["Αἰγύπτου",700401,17],["καὶ",707031,7],["τῇ",709436,100],["μελίσσῃ",708702,1],["ἥ",709781,177],["ἐστιν",704093,91],["ἐν",704639,0],["χώρᾳ",714011,1],["Ἀσσυρίων",702004,81]],"And it shall come to pass in that day that the Lord shall hiss for the flies, which [insect] shall rule over a part of the river of Egypt, and for the bee which is in the land of the Assyrians."],["19",[["καὶ",707031,7],["ἐλεύσονται",705453,135],["πάντες",710177,138],["καὶ",707031,7],["ἀναπαύσονται",701027,135],["ἐν",704639,0],["ταῖς",709436,75],["φάραγξι",713351,76],["τῆς",709436,16],["χώρας",714011,17],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["τρώγλαις",713013,76],["τῶν",709436,80],["πετρῶν",710446,81],["καὶ",707031,7],["εἰς",704105,0],["τὰ",709436,41],["σπήλαια",712012,42],["καὶ",707031,7],["εἰς",704105,0],["πᾶσαν",710177,36],["ῥαγάδα",711137,9,39],["καὶ",707031,7],["ἐν",704639,0],["παντὶ",710177,97],["ξύλῳ",709427,54]],"And they all shall enter into the clefts of the land, and into the holes of the rocks, and into the caves, and into every ravine."],["20",[["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ξυρήσει",709431,127],["κύριος",707996,4],["τῷ",709436,53],["ξυρῷ",709433,54],["τῷ",709436,53],["μεγάλῳ",708653,97],["καὶ",707031,7],["μεμεθυσμένῳ",708676,447],["ὅ",709781,213],["ἐστιν",704093,91],["πέραν",710280,28],["τοῦ",709436,35],["ποταμοῦ",710693,18],["βασιλέως",702580,18],["Ἀσσυρίων",702004,18],["τὴν",709436,8],["κεφαλὴν",707639,9],["καὶ",707031,7],["τὰς",709436,38],["τρίχας",706312,39],["τῶν",709436,80],["ποδῶν",710707,81],["καὶ",707031,7],["τὸν",709436,5],["πώγωνα",711115,6],["ἀφελεῖ",702177,127]],"In that day the Lord shall shave with the hired razor of the king of Assyria beyond the river the head, and the hairs of the feet, and will remove the beard."],["21",[["καὶ",707031,7],["ἔσται",704093,127],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["θρέψει",712930,127],["ἄνθρωπος",701163,4],["δάμαλιν",703271,9],["βοῶν",702798,81],["καὶ",707031,7],["δύο",703849,59],["πρόβατα",710768,42]],"And it shall come to pass in that day, [that] a man shall rear a heifer, and two sheep."],["22",[["καὶ",707031,7],["ἔσται",704093,93],["ἀπὸ",701425,0],["τοῦ",709436,35],["πλεῖστον",710513,534],["ποιεῖν",710582,55],["γάλα",702919,25],["βούτυρον",702800,25],["καὶ",707031,7],["μέλι",708700,25],["φάγεται",713296,93],["πᾶς",710177,14],["ὁ",709436,3],["καταλειφθεὶς",707305,217],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"And it shall come to pass from their drinking an abundance of milk, [that] every one that is left on the land shall eat butter and honey."],["23",[["καὶ",707031,7],["ἔσται",704093,93],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["πᾶς",710177,14],["τόπος",712903,4],["οὗ",709781,48],["ἐὰν",703912,7],["ὦσιν",709852,96],["χίλιαι",713859,192],["ἄμπελοι",700870,191],["χιλίων",713859,198],["σίκλων",711786,81],["εἰς",704105,0],["χέρσον",713834,9],["ἔσονται",704093,135],["καὶ",707031,7],["εἰς",704105,0],["ἄκανθαν",700517,9]],"And it shall come to pass in that day, [for] every place where there shall be a thousand vines at a thousand shekels, they shall become barren land and thorns."],["24",[["μετὰ",708780,0],["βέλους",702644,21],["καὶ",707031,7],["τοξεύματος",712895,18],["εἰσελεύσονται",704114,135],["ἐκεῖ",704181,28],["ὅτι",709803,7],["χέρσος",713834,12],["καὶ",707031,7],["ἄκανθα",700517,12],["ἔσται",704093,93],["πᾶσα",710177,29],["ἡ",709436,10],["γῆ",703083,12]],"[Men] shall enter thither with arrow and bow; for all the land shall be [barren] ground and thorns."],["25",[["καὶ",707031,7],["πᾶν",710177,26],["ὄρος",709768,25],["ἀροτριώμενον",701791,212],["ἀροτριαθήσεται",701791,134],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἐπέλθῃ",705068,172],["ἐκεῖ",704181,28],["φόβος",713534,4],["ἔσται",704093,93],["γὰρ",702963,11],["ἀπὸ",701425,0],["τῆς",709436,16],["χέρσου",713834,17],["καὶ",707031,7],["ἀκάνθης",700517,17],["εἰς",704105,0],["βόσκημα",702766,15],["προβάτου",710768,21],["καὶ",707031,7],["εἰς",704105,0],["καταπάτημα",707361,15],["βοός",702798,18]],"And every mountain shall be certainly ploughed: there shall no fear come thither: for there shall be from [among] the [barren] ground and thorns that whereon cattle shall feed and oxen shall tread."]]