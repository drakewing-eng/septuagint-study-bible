[["1",[["τὸ",709436,34],["ῥῆμα",711246,15],["τῆς",709436,16],["φάραγγος",713351,17],["Σιων",711816,17],["τί",712867,273],["ἐγένετό",703104,23],["σοι",711925,159],["νῦν",709384,28],["ὅτι",709803,7],["ἀνέβητε",700905,265],["πάντες",710177,138],["εἰς",704105,0],["δώματα",703896,42]],"The Word of the Valley of Sion. What has happened to thee, that now ye are all gone up to the housetops which help you not?",{"s":"d","q":0.69}],["2",[["μάταια",708575,68],["ἐνεπλήσθη",704592,37],["ἡ",709436,10],["πόλις",710612,12],["βοώντων",702743,170],["οἱ",709436,136],["τραυματίαι",712921,52],["σου",711945,133],["οὐ",709805,28],["τραυματίαι",712921,52],["μαχαίρας",708593,17],["οὐδὲ",709816,7],["οἱ",709436,136],["νεκροί",709247,52],["σου",711945,133],["νεκροὶ",709247,52],["πολέμου",710605,18]],"The city is filled with shouting [men]: thy slain are not slain with swords, nor are thy dead those who have died in battle."],["3",[["πάντες",710177,138],["οἱ",709436,136],["ἄρχοντές",701862,52],["σου",711945,133],["πεφεύγασιν",713433,353],["καὶ",707031,7],["οἱ",709436,136],["ἁλόντες",700673,196],["σκληρῶς",711865,28],["δεδεμένοι",703394,429],["εἰσίν",704093,197],["καὶ",707031,7],["οἱ",709436,136],["ἰσχύοντες",706859,146],["ἐν",704639,0],["σοὶ",711925,159],["πόρρω",710680,28],["πεφεύγασιν",713433,353]],"All thy princes have fled, and [thy] captives are tightly bound, and the mighty [men] in thee have fled far away."],["4",[["διὰ",703417,0],["τοῦτο",709858,129],["εἶπα",705373,155],["ἄφετέ",702211,74],["με",708618,163],["πικρῶς",710476,28],["κλαύσομαι",707703,181],["μὴ",708851,28],["κατισχύσητε",707531,125],["παρακαλεῖν",710039,55],["με",708618,163],["ἐπὶ",705080,0],["τὸ",709436,24],["σύντριμμα",712521,25],["τῆς",709436,16],["θυγατρὸς",706320,17],["τοῦ",709436,20],["γένους",703057,21],["μου",709032,133]],"Therefore I said, Let me alone, I will weep bitterly; labour not to comfort me for the breach of the daughter of my people."],["5",[["ὅτι",709803,7],["ἡμέρα",705984,12],["ταραχῆς",712722,17],["καὶ",707031,7],["ἀπωλείας",701660,17],["καὶ",707031,7],["καταπατήματος",707361,18],["καὶ",707031,7],["πλάνησις",710497,12],["παρὰ",709995,0],["κυρίου",707996,18],["σαβαωθ",711346,228],["ἐν",704639,0],["φάραγγι",713351,1],["Σιων",711816,17],["πλανῶνται",710495,269],["ἀπὸ",701425,0],["μικροῦ",708915,116],["ἕως",705792,0],["μεγάλου",708653,116],["πλανῶνται",710495,269],["ἐπὶ",705080,0],["τὰ",709436,41],["ὄρη",709768,42]],"For [it is] a day of trouble, and of destruction, and of treading down, and [there is] perplexity [sent] from the Lord of hosts: they wander in the valley of Sion; they wander from the least to the greatest on the mountains."],["6",[["οἱ",709436,136],["δὲ",703303,11],["Αιλαμῖται",700433,52],["ἔλαβον",708076,150],["φαρέτρας",713364,39],["ἀναβάται",700909,52],["ἄνθρωποι",701163,52],["ἐφ᾿",705080,0],["ἵπποις",706790,148],["καὶ",707031,7],["συναγωγὴ",712376,12],["παρατάξεως",710107,17]],"And the Elamites took [their] quivers, and [there were] men mounted on horses, and [there was] a gathering for battle."],["7",[["καὶ",707031,7],["ἔσονται",704093,135],["αἱ",709436,190],["ἐκλεκταὶ",704240,192],["φάραγγές",713351,191],["σου",711945,133],["πλησθήσονται",710532,144],["ἁρμάτων",701768,44],["οἱ",709436,136],["δὲ",703303,11],["ἱππεῖς",706786,52],["ἐμφράξουσι",704635,218],["τὰς",709436,38],["πύλας",711082,39],["σου",711945,133]],"And it shall be [that] thy choice valleys shall be filled with chariots, and horsemen shall block up thy gates."],["8",[["καὶ",707031,7],["ἀνακαλύψουσιν",700968,218],["τὰς",709436,38],["πύλας",711082,39],["Ιουδα",706768,18],["καὶ",707031,7],["ἐμβλέψονται",704551,135],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["εἰς",704105,0],["τοὺς",709436,58],["ἐκλεκτοὺς",704240,60],["οἴκους",709516,57],["τῆς",709436,16],["πόλεως",710612,17]],"And they shall uncover the gates of Juda, and they shall look in that day on the choice houses of the city."],["9",[["καὶ",707031,7],["ἀνακαλύψουσιν",700968,218],["τὰ",709436,41],["κρυπτὰ",707922,68],["τῶν",709436,80],["οἴκων",709516,81],["τῆς",709436,16],["ἄκρας",700610,82],["Δαυιδ",703232,18],["καὶ",707031,7],["εἴδοσαν",709725,150],["ὅτι",709803,7],["πλείους",710514,138],["εἰσὶν",704093,197],["καὶ",707031,7],["ὅτι",709803,7],["ἀπέστρεψαν",701598,150],["τὸ",709436,24],["ὕδωρ",713071,25],["τῆς",709436,16],["ἀρχαίας",701835,82],["κολυμβήθρας",707802,17],["εἰς",704105,0],["τὴν",709436,8],["πόλιν",710612,9]],"And they shall uncover the secret places of the houses of the citadel of David: and they saw that they were many, and that one [had] turned the water of the old pool into the city;"],["10",[["καὶ",707031,7],["ὅτι",709803,7],["καθείλοσαν",706982,150],["τοὺς",709436,58],["οἴκους",709516,57],["Ιερουσαλημ",706644,17],["εἰς",704105,0],["ὀχύρωμα",709891,25],["τοῦ",709436,20],["τείχους",712759,21],["τῇ",709436,100],["πόλει",710612,1]],"and that they [had] pulled down the houses of Jerusalem, to fortify the wall of the city."],["11",[["καὶ",707031,7],["ἐποιήσατε",710582,265],["ἑαυτοῖς",703917,151],["ὕδωρ",713071,25],["ἀνὰ",700902,0],["μέσον",708768,46],["τῶν",709436,43],["δύο",703849,59],["τειχέων",712759,44],["ἐσώτερον",705525,0],["τῆς",709436,16],["κολυμβήθρας",707802,17],["τῆς",709436,16],["ἀρχαίας",701835,82],["καὶ",707031,7],["οὐκ",709805,28],["ἐνεβλέψατε",704551,265],["εἰς",704105,0],["τὸν",709436,5],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["ποιήσαντα",710582,365],["αὐτὴν",702165,104],["καὶ",707031,7],["τὸν",709436,5],["κτίσαντα",707938,365],["αὐτὴν",702165,104],["οὐκ",709805,28],["εἴδετε",709725,265]],"And ye procured to yourselves water between the two walls within the ancient pool: but ye looked not to him that made it from the beginning, and regarded not him that created it."],["12",[["καὶ",707031,7],["ἐκάλεσεν",707084,2],["κύριος",707996,4],["σαβαωθ",711346,228],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["κλαυθμὸν",707705,6],["καὶ",707031,7],["κοπετὸν",707821,6],["καὶ",707031,7],["ξύρησιν",709432,9],["καὶ",707031,7],["ζῶσιν",705922,9],["σάκκων",711386,81]],"And the Lord, the Lord of hosts, called in that day for weeping, and lamentation, and baldness, and for girding with sackcloth:"],["13",[["αὐτοὶ",702165,201],["δὲ",703303,11],["ἐποιήσαντο",710582,189],["εὐφροσύνην",705717,9],["καὶ",707031,7],["ἀγαλλίαμα",700112,25],["σφάζοντες",712571,146],["μόσχους",709029,57],["καὶ",707031,7],["θύοντες",706349,146],["πρόβατα",710768,42],["ὥστε",714164,7],["φαγεῖν",713296,106],["κρέα",707889,42],["καὶ",707031,7],["πιεῖν",710478,106],["οἶνον",709530,6],["λέγοντες",708124,146],["φάγωμεν",713296,79],["καὶ",707031,7],["πίωμεν",710478,79],["αὔριον",702149,28],["γὰρ",702963,11],["ἀποθνῄσκομεν",701461,243]],"but they engaged in joy and gladness, slaying calves, and killing sheep, so as to eat flesh, and drink wine; saying, Let us eat and drink; for to-morrow we die."],["14",[["καὶ",707031,7],["ἀνακεκαλυμμένα",700968,388],["ταῦτά",709858,71],["ἐστιν",704093,91],["ἐν",704639,0],["τοῖς",709436,95],["ὠσὶν",709852,96],["κυρίου",707996,18],["σαβαωθ",711346,228],["ὅτι",709803,7],["οὐκ",709805,28],["ἀφεθήσεται",702211,134],["ὑμῖν",713084,90],["αὕτη",709858,107],["ἡ",709436,10],["ἁμαρτία",700775,12],["ἕως",705792,0],["ἂν",700900,11],["ἀποθάνητε",701461,125]],"And these things are revealed in the ears of the Lord of hosts: for this sin shall not be forgiven you, until ye die."],["15",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["σαβαωθ",711346,228],["πορεύου",710667,240],["εἰς",704105,0],["τὸ",709436,24],["παστοφόριον",710181,25],["πρὸς",710844,0],["Σομναν",711936,6],["τὸν",709436,5],["ταμίαν",712701,6],["καὶ",707031,7],["εἰπὸν",705373,150],["αὐτῷ",702165,50]],"Thus saith the Lord of hosts, Go into the chamber, to Somnas the treasurer, and say to him, Why art thou here?"],["16",[["τί",712867,126],["σὺ",712181,164],["ὧδε",714090,28],["καὶ",707031,7],["τί",712867,126],["σοί",711925,159],["ἐστιν",704093,91],["ὧδε",714090,28],["ὅτι",709803,7],["ἐλατόμησας",708102,162],["σεαυτῷ",711599,50],["ὧδε",714090,28],["μνημεῖον",708963,25],["καὶ",707031,7],["ἐποίησας",710582,162],["σεαυτῷ",711599,50],["ἐν",704639,0],["ὑψηλῷ",713285,30],["μνημεῖον",708963,25],["καὶ",707031,7],["ἔγραψας",703194,162],["σεαυτῷ",711599,50],["ἐν",704639,0],["πέτρᾳ",710443,1],["σκηνήν",711845,9]],"and what hast thou to do here, that thou hast here hewn thyself a sepulchre, and madest thyself a sepulchre on high, and hast graven for thyself a dwelling in the rock?"],["17",[["ἰδοὺ",706497,88],["δὴ",703395,11],["κύριος",707996,4],["σαβαωθ",711346,228],["ἐκβαλεῖ",704145,127],["καὶ",707031,7],["ἐκτρίψει",704345,127],["ἄνδρα",701150,6],["καὶ",707031,7],["ἀφελεῖ",702177,127],["τὴν",709436,8],["στολήν",712120,9],["σου",711945,133]],"Behold now, the Lord of hosts casts forth and will utterly destroy [such] a man, and will take away thy robe and thy glorious crown,"],["18",[["καὶ",707031,7],["τὸν",709436,5],["στέφανόν",712083,6],["σου",711945,133],["τὸν",709436,5],["ἔνδοξον",704694,27],["καὶ",707031,7],["ῥίψει",711267,127],["σε",711598,163],["εἰς",704105,0],["χώραν",714011,9],["μεγάλην",708653,36],["καὶ",707031,7],["ἀμέτρητον",700816,46],["καὶ",707031,7],["ἐκεῖ",704181,28],["ἀποθανῇ",701461,166],["καὶ",707031,7],["θήσει",712849,127],["τὸ",709436,24],["ἅρμα",701768,25],["σου",711945,133],["τὸ",709436,24],["καλὸν",707097,46],["εἰς",704105,0],["ἀτιμίαν",702094,9],["καὶ",707031,7],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["ἄρχοντός",701862,18],["σου",711945,133],["εἰς",704105,0],["καταπάτημα",707361,25]],"and will cast thee into a great and unmeasured land, and there thou shalt die: and he will bring thy fair chariot to shame, and the house of thy prince to be trodden down."],["19",[["καὶ",707031,7],["ἀφαιρεθήσῃ",702177,364],["ἐκ",704132,0],["τῆς",709436,16],["οἰκονομίας",709513,17],["σου",711945,133],["καὶ",707031,7],["ἐκ",704132,0],["τῆς",709436,16],["στάσεώς",712049,17],["σου",711945,133]],"And thou shalt be removed from thy stewardship, and from thy place."],["20",[["καὶ",707031,7],["ἔσται",704093,93],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["καλέσω",707084,165],["τὸν",709436,5],["παῖδά",709932,6],["μου",709032,133],["Ελιακιμ",704454,6],["τὸν",709436,5],["τοῦ",709436,35],["Χελκιου",713815,18]],"And it shall come to pass in that day, that I will call my servant Eliakim the son of Chelcias:"],["21",[["καὶ",707031,7],["ἐνδύσω",704701,165],["αὐτὸν",702165,85],["τὴν",709436,8],["στολήν",712120,9],["σου",711945,133],["καὶ",707031,7],["τὸν",709436,5],["στέφανόν",712083,6],["σου",711945,133],["δώσω",703654,165],["αὐτῷ",702165,50],["καὶ",707031,7],["τὸ",709436,24],["κράτος",707883,25],["καὶ",707031,7],["τὴν",709436,8],["οἰκονομίαν",709513,9],["σου",711945,133],["δώσω",703654,165],["εἰς",704105,0],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔσται",704093,93],["ὡς",714148,28],["πατὴρ",710189,4],["τοῖς",709436,147],["ἐνοικοῦσιν",704772,197],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["τοῖς",709436,147],["ἐνοικοῦσιν",704772,197],["ἐν",704639,0],["Ιουδα",706768,114]],"and I will put on him thy robe, and I will grant him thy crown with power, and I will give thy stewardship into his hands: and he shall be as a father to them that dwell in Jerusalem, and to them that dwell in Juda."],["22",[["καὶ",707031,7],["δώσω",703654,165],["τὴν",709436,8],["δόξαν",703791,9],["Δαυιδ",703232,18],["αὐτῷ",702165,50],["καὶ",707031,7],["ἄρξει",701860,127],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ὁ",709436,3],["ἀντιλέγων",701245,72]],"And I will give him the glory of David; and he shall rule, and there shall be none to speak against him: and I will give him the key of the house of David [upon] his shoulder; and he shall open, and there shall be none to shut; and he shall shut, and there shall be none to open.",{"s":"d","q":0.34}],["23",[["καὶ",707031,7],["στήσω",706846,165],["αὐτὸν",702165,85],["ἄρχοντα",701862,6],["ἐν",704639,0],["τόπῳ",712903,114],["πιστῷ",710486,30],["καὶ",707031,7],["ἔσται",704093,93],["εἰς",704105,0],["θρόνον",706315,6],["δόξης",703791,17],["τοῦ",709436,35],["οἴκου",709516,18],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102]],"And I will make him a ruler in a sure place, and he shall be for a glorious throne of his father's house."],["24",[["καὶ",707031,7],["ἔσται",704093,93],["πεποιθὼς",710221,270],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["πᾶς",710177,14],["ἔνδοξος",704694,14],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["μικροῦ",708915,116],["ἕως",705792,7],["μεγάλου",708653,116],["καὶ",707031,7],["ἔσονται",704093,135],["ἐπικρεμάμενοι",705178,348],["αὐτῷ",702165,50]],"And every one that is glorious in the house of his father shall trust in him, from the least to the greatest; and they shall depend upon him in that day."],["25",[["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["σαβαωθ",711346,228],["κινηθήσεται",707679,134],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ὁ",709436,3],["ἐστηριγμένος",712098,419],["ἐν",704639,0],["τόπῳ",712903,114],["πιστῷ",710486,30],["καὶ",707031,7],["πεσεῖται",710481,127],["καὶ",707031,7],["ἀφαιρεθήσεται",702177,134],["ἡ",709436,10],["δόξα",703791,12],["ἡ",709436,10],["ἐπ᾿",705080,0],["αὐτόν",702165,85],["ὅτι",709803,7],["κύριος",707996,4],["ἐλάλησεν",708071,2]],"Thus saith the Lord of hosts, The man that is fastened in the sure place shall be removed and be taken away, and shall fall; and the glory that is upon him shall be utterly destroyed: for the Lord has spoken it."]]