[["1",[["μὴ",708851,28],["οὐκ",709805,28],["ἰσχύει",706859,91],["ἡ",709436,10],["χεὶρ",713787,12],["κυρίου",707996,18],["τοῦ",709436,20],["σῶσαι",712627,106],["ἢ",705924,7],["ἐβάρυνεν",702553,13],["τὸ",709436,24],["οὖς",709852,25],["αὐτοῦ",702165,102],["τοῦ",709436,20],["μὴ",708851,28],["εἰσακοῦσαι",704108,106]],"Has the hand of the Lord no power to save? or has he made his ear heavy, so that he should not hear?"],["2",[["ἀλλὰ",700680,7],["τὰ",709436,63],["ἁμαρτήματα",700774,64],["ὑμῶν",713091,145],["διιστῶσιν",703690,271],["ἀνὰ",700902,0],["μέσον",708768,46],["ὑμῶν",713091,145],["καὶ",707031,7],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["διὰ",703417,0],["τὰς",709436,38],["ἁμαρτίας",700775,39],["ὑμῶν",713091,145],["ἀπέστρεψεν",701598,2],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["ἀφ᾿",701425,0],["ὑμῶν",713091,145],["τοῦ",709436,20],["μὴ",708851,28],["ἐλεῆσαι",704418,106]],"Nay, your iniquities separate between you and God, and because of your sins has he turned away [his] face from you, so as not to have mercy [upon you]."],["3",[["αἱ",709436,190],["γὰρ",702963,11],["χεῖρες",713787,191],["ὑμῶν",713091,145],["μεμολυμμέναι",708987,415],["αἵματι",700442,54],["καὶ",707031,7],["οἱ",709436,136],["δάκτυλοι",703259,52],["ὑμῶν",713091,145],["ἐν",704639,0],["ἁμαρτίαις",700775,76],["τὰ",709436,63],["δὲ",703303,11],["χείλη",713781,64],["ὑμῶν",713091,145],["ἐλάλησεν",708071,2],["ἀνομίαν",701192,9],["καὶ",707031,7],["ἡ",709436,10],["γλῶσσα",703120,12],["ὑμῶν",713091,145],["ἀδικίαν",700271,9],["μελετᾷ",708698,91]],"For your hands are defiled with blood, and your fingers with sins; your lips also have spoken iniquity, and your tongue meditates unrighteousness."],["4",[["οὐδεὶς",709817,14],["λαλεῖ",708071,91],["δίκαια",703694,68],["οὐδὲ",709816,7],["ἔστιν",704093,91],["κρίσις",707908,12],["ἀληθινή",700659,29],["πεποίθασιν",710221,353],["ἐπὶ",705080,0],["ματαίοις",708575,230],["καὶ",707031,7],["λαλοῦσιν",708071,197],["κενά",707612,68],["ὅτι",709803,7],["κύουσιν",708003,197],["πόνον",710661,6],["καὶ",707031,7],["τίκτουσιν",712853,197],["ἀνομίαν",701192,9]],"None speaks justly, neither is there true judgment: they trust in vanities, and speak empty [words]; for they conceive trouble, and bring forth iniquity."],["5",[["ᾠὰ",714125,42],["ἀσπίδων",701991,65],["ἔρρηξαν",711243,150],["καὶ",707031,7],["ἱστὸν",706850,6],["ἀράχνης",701693,17],["ὑφαίνουσιν",713275,197],["καὶ",707031,7],["ὁ",709436,3],["μέλλων",708705,72],["τῶν",709436,43],["ᾠῶν",714125,44],["αὐτῶν",702165,40],["φαγεῖν",713296,106],["συντρίψας",712520,182],["οὔριον",709850,46],["εὗρεν",705676,2],["καὶ",707031,7],["ἐν",704639,0],["αὐτῷ",702165,50],["βασιλίσκος",702583,6]],"They have hatched asps' eggs, and weave a spider's web: and he that is going to eat of their eggs, having crushed an addled egg, has found also in it a basilisk."],["6",[["ὁ",709436,3],["ἱστὸς",706850,4],["αὐτῶν",702165,40],["οὐκ",709805,28],["ἔσται",704093,93],["εἰς",704105,0],["ἱμάτιον",706742,25],["οὐδὲ",709816,7],["μὴ",708851,28],["περιβάλωνται",710294,232],["ἀπὸ",701425,0],["τῶν",709436,43],["ἔργων",705396,44],["αὐτῶν",702165,40],["τὰ",709436,63],["γὰρ",702963,11],["ἔργα",705396,64],["αὐτῶν",702165,40],["ἔργα",705396,64],["ἀνομίας",701192,17]],"Their web shall not become a garment, nor shall they at all clothe themselves with their works; for their works are works of iniquity."],["7",[["οἱ",709436,136],["δὲ",703303,11],["πόδες",710707,52],["αὐτῶν",702165,40],["ἐπὶ",705080,0],["πονηρίαν",710659,9],["τρέχουσιν",712931,197],["ταχινοὶ",712744,138],["ἐκχέαι",704368,106],["αἷμα",700442,25],["καὶ",707031,7],["οἱ",709436,136],["διαλογισμοὶ",703506,52],["αὐτῶν",702165,40],["διαλογισμοὶ",703506,52],["ἀφρόνων",702236,169],["σύντριμμα",712521,15],["καὶ",707031,7],["ταλαιπωρία",712695,12],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["αὐτῶν",702165,40]],"And their feet run to wickedness, swift to shed blood; their thoughts also are thoughts of murder; destruction and misery are in their ways;"],["8",[["καὶ",707031,7],["ὁδὸν",709458,9],["εἰρήνης",704098,17],["οὐκ",709805,28],["οἴδασιν",709492,353],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["κρίσις",707908,12],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["αὐτῶν",702165,40],["αἱ",709436,190],["γὰρ",702963,11],["τρίβοι",712939,191],["αὐτῶν",702165,40],["διεστραμμέναι",703592,423],["ἃς",709781,193],["διοδεύουσιν",703715,197],["καὶ",707031,7],["οὐκ",709805,28],["οἴδασιν",709492,353],["εἰρήνην",704098,9]],"and the way of peace they know not, neither is there judgment in their ways; for their paths by which they go are crooked, and they know not peace."],["9",[["διὰ",703417,0],["τοῦτο",709858,129],["ἀπέστη",702214,2],["ἡ",709436,10],["κρίσις",707908,12],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["καταλάβῃ",707300,172],["αὐτοὺς",702165,62],["δικαιοσύνη",703695,12],["ὑπομεινάντων",713219,221],["αὐτῶν",702165,40],["φῶς",713642,25],["ἐγένετο",703104,23],["αὐτοῖς",702165,151],["σκότος",711889,6],["μείναντες",708736,196],["αὐγὴν",702121,9],["ἐν",704639,0],["ἀωρίᾳ",702328,1],["περιεπάτησαν",710362,150]],"Therefore has judgment departed from them, and righteousness shall not overtake them: while they waited for light, darkness came upon them; while they waited for brightness, they walked in perplexity."],["10",[["ψηλαφήσουσιν",714047,218],["ὡς",714148,11],["τυφλοὶ",713031,138],["τοῖχον",712879,6],["καὶ",707031,7],["ὡς",714148,11],["οὐχ",709805,28],["ὑπαρχόντων",713102,170],["ὀφθαλμῶν",709870,81],["ψηλαφήσουσιν",714047,218],["καὶ",707031,7],["πεσοῦνται",710481,135],["ἐν",704639,0],["μεσημβρίᾳ",708758,1],["ὡς",714148,11],["ἐν",704639,0],["μεσονυκτίῳ",708765,54],["ὡς",714148,11],["ἀποθνῄσκοντες",701461,146],["στενάξουσιν",712066,218]],"They shall feel for the wall as blind [men], and shall feel [for it] as if they had no eyes: and they shall feel at noon-day as at midnight; they shall groan as dying men."],["11",[["ὡς",714148,11],["ἄρκος",701766,4],["καὶ",707031,7],["ὡς",714148,11],["περιστερὰ",710391,12],["ἅμα",700745,28],["πορεύσονται",710667,135],["ἀνεμείναμεν",701000,289],["κρίσιν",707908,9],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["σωτηρία",712658,12],["μακρὰν",708411,28],["ἀφέστηκεν",702214,171],["ἀφ᾿",701425,0],["ἡμῶν",705999,145]],"They shall proceed together as a bear and as a dove: we have waited for judgment, and there is no salvation, it is gone far from us."],["12",[["πολλὴ",710646,29],["γὰρ",702963,11],["ἡμῶν",705999,145],["ἡ",709436,10],["ἀνομία",701192,12],["ἐναντίον",704654,0],["σου",711945,133],["καὶ",707031,7],["αἱ",709436,190],["ἁμαρτίαι",700775,191],["ἡμῶν",705999,145],["ἀντέστησαν",701154,150],["ἡμῖν",705994,90],["αἱ",709436,190],["γὰρ",702963,11],["ἀνομίαι",701192,191],["ἡμῶν",705999,145],["ἐν",704639,0],["ἡμῖν",705994,90],["καὶ",707031,7],["τὰ",709436,41],["ἀδικήματα",700270,42],["ἡμῶν",705999,145],["ἔγνωμεν",703105,289]],"For our iniquity is great before thee, and our sins have risen up against us: for our iniquities are in us, and we know our unrighteous deeds."],["13",[["ἠσεβήσαμεν",701906,289],["καὶ",707031,7],["ἐψευσάμεθα",714045,316],["καὶ",707031,7],["ἀπέστημεν",702214,289],["ἀπὸ",701425,0],["ὄπισθεν",709691,28],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["ἐλαλήσαμεν",708071,289],["ἄδικα",700272,68],["καὶ",707031,7],["ἠπειθήσαμεν",701370,289],["ἐκύομεν",708003,289],["καὶ",707031,7],["ἐμελετήσαμεν",708698,289],["ἀπὸ",701425,0],["καρδίας",707141,17],["ἡμῶν",705999,145],["λόγους",708236,57],["ἀδίκους",700272,60]],"We have sinned, and dealt falsely, and revolted from our God: we have spoken unrighteous words, and have been disobedient; we have conceived and uttered from our heart unrighteous words."],["14",[["καὶ",707031,7],["ἀπεστήσαμεν",702214,289],["ὀπίσω",709697,28],["τὴν",709436,8],["κρίσιν",707908,9],["καὶ",707031,7],["ἡ",709436,10],["δικαιοσύνη",703695,12],["μακρὰν",708411,28],["ἀφέστηκεν",702214,171],["ὅτι",709803,7],["καταναλώθη",707338,37],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["αὐτῶν",702165,40],["ἡ",709436,10],["ἀλήθεια",700656,12],["καὶ",707031,7],["δι᾿",703417,0],["εὐθείας",705602,82],["οὐκ",709805,28],["ἠδύναντο",703838,139],["διελθεῖν",703673,106]],"And we have turned judgment back, and righteousness has departed afar off: for truth is consumed in their ways, and they could not pass by a straight [path]."],["15",[["καὶ",707031,7],["ἡ",709436,10],["ἀλήθεια",700656,12],["ἦρται",700473,403],["καὶ",707031,7],["μετέστησαν",708668,150],["τὴν",709436,8],["διάνοιαν",703531,9],["τοῦ",709436,20],["συνιέναι",712481,55],["καὶ",707031,7],["εἶδεν",709725,2],["κύριος",707996,4],["καὶ",707031,7],["οὐκ",709805,28],["ἤρεσεν",701722,2],["αὐτῷ",702165,50],["ὅτι",709803,7],["οὐκ",709805,28],["ἦν",704093,13],["κρίσις",707908,12]],"And truth has been taken away, and they have turned aside [their] mind from understanding. And the Lord saw it, and it pleased him not that there was no judgment."],["16",[["καὶ",707031,7],["εἶδεν",709725,2],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ἀνήρ",701150,4],["καὶ",707031,7],["κατενόησεν",707341,2],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ὁ",709436,3],["ἀντιλημψόμενος",701243,626],["καὶ",707031,7],["ἠμύνατο",700880,23],["αὐτοὺς",702165,62],["τῷ",709436,113],["βραχίονι",702808,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["τῇ",709436,100],["ἐλεημοσύνῃ",704421,1],["ἐστηρίσατο",712098,23]],"And he looked, and there was no man, and he observed, and there was none to help: so he defended them with his arm, and stablished [them] with [his] mercy."],["17",[["καὶ",707031,7],["ἐνεδύσατο",704701,23],["δικαιοσύνην",703695,9],["ὡς",714148,11],["θώρακα",706356,57],["καὶ",707031,7],["περιέθετο",710403,23],["περικεφαλαίαν",710331,9],["σωτηρίου",712659,21],["ἐπὶ",705080,0],["τῆς",709436,16],["κεφαλῆς",707639,17],["καὶ",707031,7],["περιεβάλετο",710294,23],["ἱμάτιον",706742,25],["ἐκδικήσεως",704175,17],["καὶ",707031,7],["τὸ",709436,24],["περιβόλαιον",710300,25]],"And he put on righteousness as a breast-plate, and placed the helmet of salvation on his head; and he clothed himself with the garment of vengeance, and with his cloak,"],["18",[["ὡς",714148,7],["ἀνταποδώσων",701215,512],["ἀνταπόδοσιν",701217,9],["ὄνειδος",709658,25],["τοῖς",709436,147],["ὑπεναντίοις",713109,230]],"as one about to render a recompence, [even] reproach to his adversaries."],["19",[["καὶ",707031,7],["φοβηθήσονται",713532,144],["οἱ",709436,136],["ἀπὸ",701425,0],["δυσμῶν",703865,65],["τὸ",709436,24],["ὄνομα",709666,25],["κυρίου",707996,18],["καὶ",707031,7],["οἱ",709436,136],["ἀπ᾿",701425,0],["ἀνατολῶν",701071,65],["ἡλίου",705974,18],["τὸ",709436,24],["ὄνομα",709666,25],["τὸ",709436,24],["ἔνδοξον",704694,27],["ἥξει",705956,127],["γὰρ",702963,11],["ὡς",714148,11],["ποταμὸς",710693,4],["βίαιος",702714,14],["ἡ",709436,10],["ὀργὴ",709728,12],["παρὰ",709995,0],["κυρίου",707996,18],["ἥξει",705956,127],["μετὰ",708780,0],["θυμοῦ",706334,18]],"So shall they of the west fear the name of the Lord, and they [that come] from the rising of the sun his glorious name: for the wrath of the Lord shall come as a mighty river, it shall come with fury."],["20",[["καὶ",707031,7],["ἥξει",705956,127],["ἕνεκεν",704709,0],["Σιων",711816,17],["ὁ",709436,3],["ῥυόμενος",711309,122],["καὶ",707031,7],["ἀποστρέψει",701598,127],["ἀσεβείας",701904,17],["ἀπὸ",701425,0],["Ιακωβ",706401,18]],"And the deliverer shall come for Sion's sake, and shall turn away ungodliness from Jacob."],["21",[["καὶ",707031,7],["αὕτη",709858,107],["αὐτοῖς",702165,151],["ἡ",709436,10],["παρ᾿",709995,0],["ἐμοῦ",704580,133],["διαθήκη",703456,12],["εἶπεν",705373,2],["κύριος",707996,4],["τὸ",709436,34],["πνεῦμα",710566,15],["τὸ",709436,34],["ἐμόν",704578,26],["ὅ",709781,33],["ἐστιν",704093,91],["ἐπὶ",705080,0],["σοί",711925,159],["καὶ",707031,7],["τὰ",709436,63],["ῥήματα",711246,64],["ἃ",709781,69],["ἔδωκα",703654,155],["εἰς",704105,0],["τὸ",709436,24],["στόμα",712125,25],["σου",711945,133],["οὐ",709805,28],["μὴ",708851,28],["ἐκλίπῃ",704237,172],["ἐκ",704132,0],["τοῦ",709436,20],["στόματός",712125,21],["σου",711945,133],["καὶ",707031,7],["ἐκ",704132,0],["τοῦ",709436,20],["στόματος",712125,21],["τοῦ",709436,20],["σπέρματός",712008,21],["σου",711945,133],["εἶπεν",705373,2],["γὰρ",702963,11],["κύριος",707996,4],["ἀπὸ",701425,0],["τοῦ",709436,35],["νῦν",709384,28],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"And this shall be my covenant with them, said the Lord; My Spirit which is upon thee, and the words which I have put in thy mouth, shall never fail from thy mouth, nor from the mouth of thy seed, for the Lord has spoken it, henceforth and for ever."]]