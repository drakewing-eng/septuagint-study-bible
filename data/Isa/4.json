[["1",[["καὶ",707031,7],["ἐπιλήμψονται",705185,135],["ἑπτὰ",705357,59],["γυναῖκες",703209,191],["ἀνθρώπου",701163,18],["ἑνὸς",704106,116],["λέγουσαι",708124,306],["τὸν",709436,5],["ἄρτον",701829,6],["ἡμῶν",705999,145],["φαγόμεθα",705495,141],["καὶ",707031,7],["τὰ",709436,41],["ἱμάτια",706742,42],["ἡμῶν",705999,145],["περιβαλούμεθα",710294,141],["πλὴν",710540,28],["τὸ",709436,24],["ὄνομα",709666,25],["τὸ",709436,24],["σὸν",711943,684],["κεκλήσθω",707084,678],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["ἄφελε",702177,176],["τὸν",709436,5],["ὀνειδισμὸν",709657,6],["ἡμῶν",705999,145]],"And seven women shall take hold of one man, saying, We will eat our own bread, and wear our own raiment: only let thy name be called upon us, [and] take away our reproach."],["2",[["τῇ",709436,100],["δὲ",703303,11],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἐπιλάμψει",705186,127],["ὁ",709436,3],["θεὸς",706192,4],["ἐν",704639,0],["βουλῇ",702792,1],["μετὰ",708780,0],["δόξης",703791,17],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["τοῦ",709436,20],["ὑψῶσαι",713289,106],["καὶ",707031,7],["δοξάσαι",703792,106],["τὸ",709436,24],["καταλειφθὲν",707305,32],["τοῦ",709436,35],["Ισραηλ",706839,18]],"And in that day God shall shine gloriously in counsel on the earth, to exalt and glorify the remnant of Israel."],["3",[["καὶ",707031,7],["ἔσται",704093,93],["τὸ",709436,24],["ὑπολειφθὲν",713212,134],["ἐν",704639,0],["Σιων",711816,1],["καὶ",707031,7],["τὸ",709436,24],["καταλειφθὲν",707305,32],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["ἅγιοι",700159,138],["κληθήσονται",707084,144],["πάντες",710177,138],["οἱ",709436,136],["γραφέντες",703194,247],["εἰς",704105,0],["ζωὴν",705910,9],["ἐν",704639,0],["Ιερουσαλημ",706644,1]],"And it shall be, [that] the remnant left in Sion, and the remnant left in Jerusalem, [even] all that are appointed to life in Jerusalem, shall be called holy."],["4",[["ὅτι",709803,7],["ἐκπλυνεῖ",704288,127],["κύριος",707996,4],["τὸν",709436,5],["ῥύπον",711311,6],["τῶν",709436,80],["υἱῶν",713075,81],["καὶ",707031,7],["τῶν",709436,130],["θυγατέρων",706320,65],["Σιων",711816,17],["καὶ",707031,7],["τὸ",709436,24],["αἷμα",700442,25],["ἐκκαθαριεῖ",704202,127],["ἐκ",704132,0],["μέσου",708768,92],["αὐτῶν",702165,40],["ἐν",704639,0],["πνεύματι",710566,54],["κρίσεως",707908,17],["καὶ",707031,7],["πνεύματι",710566,54],["καύσεως",707565,17]],"For the Lord shall wash away the filth of the sons and daughters of Sion, and shall purge out the blood from the midst of them, with the spirit of judgment, and the spirit of burning."],["5",[["καὶ",707031,7],["ἥξει",705956,127],["καὶ",707031,7],["ἔσται",704093,93],["πᾶς",710177,14],["τόπος",712903,4],["τοῦ",709436,20],["ὄρους",709768,21],["Σιων",711816,17],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["περικύκλῳ",710340,28],["αὐτῆς",702165,86],["σκιάσει",711855,127],["νεφέλη",709277,12],["ἡμέρας",705984,17],["καὶ",707031,7],["ὡς",714148,28],["καπνοῦ",707132,18],["καὶ",707031,7],["ὡς",714148,28],["φωτὸς",713642,21],["πυρὸς",711088,21],["καιομένου",707049,262],["νυκτός",709386,17],["πάσῃ",710177,101],["τῇ",709436,100],["δόξῃ",703791,1],["σκεπασθήσεται",711832,134]],"And he shall come, and it shall be with regard to every place of mount Sion, yea, all the region round about it shall a cloud overshadow by day, and [there shall be] as it were the smoke and light of fire burning by night: and upon all the glory shall be a defence."],["6",[["καὶ",707031,7],["ἔσται",704093,93],["εἰς",704105,0],["σκιὰν",711852,9],["ἀπὸ",701425,0],["καύματος",707564,21],["καὶ",707031,7],["ἐν",704639,0],["σκέπῃ",711839,1],["καὶ",707031,7],["ἐν",704639,0],["ἀποκρύφῳ",701497,114],["ἀπὸ",701425,0],["σκληρότητος",711862,17],["καὶ",707031,7],["ὑετοῦ",713074,18]],"And it shall be for a shadow from the heat, and as a shelter and a hiding-place from inclemency [of weather] and from rain."]]