[["1",[["τίς",712867,158],["οὗτος",709858,121],["ὁ",709436,3],["παραγινόμενος",710006,122],["ἐξ",704132,0],["Εδωμ",704041,18],["ἐρύθημα",705444,25],["ἱματίων",706742,44],["ἐκ",704132,0],["Βοσορ",702768,18],["οὕτως",709859,28],["ὡραῖος",714132,14],["ἐν",704639,0],["στολῇ",712120,1],["βίᾳ",702712,1],["μετὰ",708780,0],["ἰσχύος",706858,17],["ἐγὼ",704018,164],["διαλέγομαι",703495,254],["δικαιοσύνην",703695,9],["καὶ",707031,7],["κρίσιν",707908,9],["σωτηρίου",712659,21]],"Who is this that is come from Edom, [with] red garments from Bosor? thus fair in his apparel, with mighty strength? I speak of righteousness and saving judgment."],["2",[["διὰ",703417,0],["τί",712867,126],["σου",711945,133],["ἐρυθρὰ",705447,68],["τὰ",709436,41],["ἱμάτια",706742,42],["καὶ",707031,7],["τὰ",709436,41],["ἐνδύματά",704698,42],["σου",711945,133],["ὡς",714148,28],["ἀπὸ",701425,0],["πατητοῦ",710190,116],["ληνοῦ",708176,17]],"Wherefore are thy garments red, and thy raiment as [if fresh] from a trodden wine-press?"],["3",[["πλήρης",710541,14],["καταπεπατημένης",707360,422],["καὶ",707031,7],["τῶν",709436,43],["ἐθνῶν",704068,44],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀνὴρ",701150,4],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["κατεπάτησα",707360,155],["αὐτοὺς",702165,62],["ἐν",704639,0],["θυμῷ",706334,114],["καὶ",707031,7],["κατέθλασα",707252,155],["αὐτοὺς",702165,62],["ὡς",714148,28],["γῆν",703083,9],["καὶ",707031,7],["κατήγαγον",707232,150],["τὸ",709436,24],["αἷμα",700442,25],["αὐτῶν",702165,40],["εἰς",704105,0],["γῆν",703083,9]],"I am full of trodden [grape], and of the nations there is not a man with me; and I trampled them in my fury, and dashed them to pieces as earth, and brought down their blood to the earth."],["4",[["ἡμέρα",705984,12],["γὰρ",702963,11],["ἀνταποδόσεως",701217,17],["ἐπῆλθεν",705068,2],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἐνιαυτὸς",704745,4],["λυτρώσεως",708284,17],["πάρεστιν",710126,91]],"For the day of recompence has come upon them, and the year of redemption is at hand."],["5",[["καὶ",707031,7],["ἐπέβλεψα",705088,155],["καὶ",707031,7],["οὐδεὶς",709817,14],["βοηθός",702748,4],["καὶ",707031,7],["προσενόησα",710937,155],["καὶ",707031,7],["οὐθεὶς",709817,14],["ἀντελαμβάνετο",701243,19],["καὶ",707031,7],["ἐρρύσατο",711309,23],["αὐτοὺς",702165,62],["ὁ",709436,3],["βραχίων",702808,4],["μου",709032,133],["καὶ",707031,7],["ὁ",709436,3],["θυμός",706334,4],["μου",709032,133],["ἐπέστη",705756,2]],"And I looked, and there was no helper; and I observed, and none upheld: therefore my arm delivered them, and mine anger drew nigh."],["6",[["καὶ",707031,7],["κατεπάτησα",707360,155],["αὐτοὺς",702165,62],["τῇ",709436,100],["ὀργῇ",709728,1],["μου",709032,133],["καὶ",707031,7],["κατήγαγον",707232,155],["τὸ",709436,24],["αἷμα",700442,25],["αὐτῶν",702165,40],["εἰς",704105,0],["γῆν",703083,9]],"And I trampled them in mine anger, and brought down their blood to the earth."],["7",[["τὸν",709436,5],["ἔλεον",704426,25],["κυρίου",707996,18],["ἐμνήσθην",708960,156],["τὰς",709436,38],["ἀρετὰς",701727,39],["κυρίου",707996,18],["ἐν",704639,0],["πᾶσιν",710177,230],["οἷς",709781,311],["ὁ",709436,3],["κύριος",707996,4],["ἡμῖν",705994,90],["ἀνταποδίδωσιν",701215,91],["κύριος",707996,4],["κριτὴς",707910,4],["ἀγαθὸς",700106,14],["τῷ",709436,113],["οἴκῳ",709516,114],["Ισραηλ",706839,18],["ἐπάγει",704994,91],["ἡμῖν",705994,90],["κατὰ",707200,0],["τὸ",709436,24],["ἔλεος",704426,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["κατὰ",707200,0],["τὸ",709436,24],["πλῆθος",710529,25],["τῆς",709436,16],["δικαιοσύνης",703695,17],["αὐτοῦ",702165,102]],"I remembered the mercy of the Lord, the praises of the Lord in all things wherein he recompenses us. The Lord is a good judge to the house of Israel; he deals with us according to his mercy, and according to the abundance of his righteousness."],["8",[["καὶ",707031,7],["εἶπεν",705373,2],["οὐχ",709805,28],["ὁ",709436,3],["λαός",708094,4],["μου",709032,133],["τέκνα",712761,64],["οὐ",709805,28],["μὴ",708851,28],["ἀθετήσωσιν",700369,218],["καὶ",707031,7],["ἐγένετο",703104,23],["αὐτοῖς",702165,151],["εἰς",704105,0],["σωτηρίαν",712658,9]],"And he said, Is it not my people? the children surely will not be rebellious: and he became to them deliverance"],["9",[["ἐκ",704132,0],["πάσης",710177,82],["θλίψεως",706276,17],["οὐ",709805,28],["πρέσβυς",710733,4],["οὐδὲ",709816,7],["ἄγγελος",700140,4],["ἀλλ᾿",700680,7],["αὐτὸς",702165,121],["κύριος",707996,4],["ἔσωσεν",712627,2],["αὐτοὺς",702165,62],["διὰ",703417,0],["τὸ",709436,24],["ἀγαπᾶν",700120,55],["αὐτοὺς",702165,62],["καὶ",707031,7],["φείδεσθαι",713406,110],["αὐτῶν",702165,40],["αὐτὸς",702165,121],["ἐλυτρώσατο",708282,23],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἀνέλαβεν",700984,2],["αὐτοὺς",702165,62],["καὶ",707031,7],["ὕψωσεν",713289,2],["αὐτοὺς",702165,62],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,17],["τοῦ",709436,35],["αἰῶνος",700504,18]],"out of all their affliction: not an ambassador, nor a messenger, but himself saved them, because he loved them and spared them: he himself redeemed them, and took them up, and lifted them up all the days of old."],["10",[["αὐτοὶ",702165,201],["δὲ",703303,11],["ἠπείθησαν",701370,150],["καὶ",707031,7],["παρώξυναν",710164,150],["τὸ",709436,24],["πνεῦμα",710566,25],["τὸ",709436,24],["ἅγιον",700159,46],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐστράφη",712160,37],["αὐτοῖς",702165,151],["εἰς",704105,0],["ἔχθραν",705775,9],["καὶ",707031,7],["αὐτὸς",702165,121],["ἐπολέμησεν",710601,2],["αὐτούς",702165,62]],"But they disobeyed, and provoked his Holy Spirit: so he turned to be an enemy, he himself contended against them."],["11",[["καὶ",707031,7],["ἐμνήσθη",708960,37],["ἡμερῶν",705984,65],["αἰωνίων",700505,198],["ὁ",709436,3],["ἀναβιβάσας",700910,182],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17],["τὸν",709436,5],["ποιμένα",710596,6],["τῶν",709436,43],["προβάτων",710768,44],["ποῦ",710706,28],["ἐστιν",704093,91],["ὁ",709436,3],["θεὶς",712849,182],["ἐν",704639,0],["αὐτοῖς",702165,151],["τὸ",709436,24],["πνεῦμα",710566,25],["τὸ",709436,24],["ἅγιον",700159,46]],"Then he remembered the ancient days, [saying], Where is he that brought up from the sea the shepherd of the sheep? where is he that put his Holy Spirit in them?"],["12",[["ὁ",709436,3],["ἀγαγὼν",700209,182],["τῇ",709436,100],["δεξιᾷ",703360,101],["Μωυσῆν",709112,6],["ὁ",709436,3],["βραχίων",702808,4],["τῆς",709436,16],["δόξης",703791,17],["αὐτοῦ",702165,102],["κατίσχυσεν",707531,2],["ὕδωρ",713071,25],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["ποιῆσαι",710582,106],["αὐτῷ",702165,50],["ὄνομα",709666,25],["αἰώνιον",700505,46]],"who led Moses with his right hand, the arm of his glory? he forced the water [to separate] from before him, to make himself an everlasting name."],["13",[["ἤγαγεν",700209,2],["αὐτοὺς",702165,62],["διὰ",703417,0],["τῆς",709436,16],["ἀβύσσου",700098,17],["ὡς",714148,28],["ἵππον",706790,6],["δι᾿",703417,0],["ἐρήμου",705420,17],["καὶ",707031,7],["οὐκ",709805,28],["ἐκοπίασαν",707824,150]],"He led them through the deep, as a horse through the wilderness, and they fainted not,"],["14",[["καὶ",707031,7],["ὡς",714148,28],["κτήνη",707934,42],["διὰ",703417,0],["πεδίου",710215,21],["κατέβη",707202,2],["πνεῦμα",710566,25],["παρὰ",709995,0],["κυρίου",707996,18],["καὶ",707031,7],["ὡδήγησεν",709448,2],["αὐτούς",702165,62],["οὕτως",709859,28],["ἤγαγες",700209,162],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133],["ποιῆσαι",710582,106],["σεαυτῷ",711599,50],["ὄνομα",709666,25],["δόξης",703791,17]],"and as cattle through a plain: the Spirit came down from the Lord, and guided them: thus thou leddest thy people, to make thyself a glorious name."],["15",[["ἐπίστρεψον",705278,176],["ἐκ",704132,0],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["ἰδὲ",709725,176],["ἐκ",704132,0],["τοῦ",709436,35],["οἴκου",709516,18],["τοῦ",709436,35],["ἁγίου",700159,116],["σου",711945,133],["καὶ",707031,7],["δόξης",703791,17],["ποῦ",710706,28],["ἐστιν",704093,91],["ὁ",709436,3],["ζῆλός",705871,4],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["ἰσχύς",706858,12],["σου",711945,133],["ποῦ",710706,28],["ἐστιν",704093,91],["τὸ",709436,24],["πλῆθος",710529,25],["τοῦ",709436,20],["ἐλέους",704426,21],["σου",711945,133],["καὶ",707031,7],["τῶν",709436,80],["οἰκτιρμῶν",709520,81],["σου",711945,133],["ὅτι",709803,7],["ἀνέσχου",701140,174],["ἡμῶν",705999,145]],"Turn from heaven, and look from thy holy habitation and [from] thy glory: where is thy zeal and thy strength? where is the abundance of thy mercy and of thy compassions, that thou hast withholden thyself from us?"],["16",[["σὺ",712181,164],["γὰρ",702963,11],["ἡμῶν",705999,145],["εἶ",704093,154],["πατήρ",710189,4],["ὅτι",709803,7],["Αβρααμ",700091,4],["οὐκ",709805,28],["ἔγνω",703105,2],["ἡμᾶς",705981,194],["καὶ",707031,7],["Ισραηλ",706839,4],["οὐκ",709805,28],["ἐπέγνω",705104,2],["ἡμᾶς",705981,194],["ἀλλὰ",700680,7],["σύ",712181,164],["κύριε",707996,153],["πατὴρ",710189,4],["ἡμῶν",705999,145],["ῥῦσαι",711309,109],["ἡμᾶς",705981,194],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["τὸ",709436,34],["ὄνομά",709666,15],["σου",711945,133],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["ἐστιν",704093,91]],"For thou art our Father; for [though] Abraham knew us not, and Israel did not acknowledge us, yet do thou, O Lord, our Father, deliver us: thy name has been upon us from the beginning."],["17",[["τί",712867,126],["ἐπλάνησας",710495,162],["ἡμᾶς",705981,194],["κύριε",707996,153],["ἀπὸ",701425,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["σου",711945,133],["ἐσκλήρυνας",711864,162],["ἡμῶν",705999,145],["τὰς",709436,38],["καρδίας",707141,39],["τοῦ",709436,20],["μὴ",708851,28],["φοβεῖσθαί",713532,110],["σε",711598,163],["ἐπίστρεψον",705278,176],["διὰ",703417,0],["τοὺς",709436,58],["δούλους",703817,57],["σου",711945,133],["διὰ",703417,0],["τὰς",709436,38],["φυλὰς",713620,39],["τῆς",709436,16],["κληρονομίας",707725,17],["σου",711945,133]],"Why hast thou caused us to err, O Lord, from thy way? [and] hast hardened our hearts, that we should not fear thee? Return for thy servants' sake, for the sake of the tribes of thine inheritance,"],["18",[["ἵνα",706747,7],["μικρὸν",708915,27],["κληρονομήσωμεν",707724,79],["τοῦ",709436,20],["ὄρους",709768,21],["τοῦ",709436,20],["ἁγίου",700159,92],["σου",711945,133],["οἱ",709436,136],["ὑπεναντίοι",713109,138],["ἡμῶν",705999,145],["κατεπάτησαν",707360,150],["τὸ",709436,24],["ἁγίασμά",700154,25],["σου",711945,133]],"that we may inherit a small part of thy holy mountain.",{"s":"d","q":0.53}],["19",[["ἐγενόμεθα",703104,316],["ὡς",714148,28],["τὸ",709436,24],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["ὅτε",709802,28],["οὐκ",709805,28],["ἦρξας",701860,162],["ἡμῶν",705999,145],["οὐδὲ",709816,7],["ἐπεκλήθη",705153,37],["τὸ",709436,34],["ὄνομά",709666,15],["σου",711945,133],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["ἐὰν",703912,7],["ἀνοίξῃς",701186,175],["τὸν",709436,5],["οὐρανόν",709844,6],["τρόμος",712975,4],["λήμψεται",708076,93],["ἀπὸ",701425,0],["σοῦ",711945,133],["ὄρη",709768,42],["καὶ",707031,7],["τακήσονται",712839,135]],"We are become as at the beginning, when thou didst not rule over us, and thy name was not called upon us. If thou wouldest open the heaven, trembling will take hold upon the mountains from thee, and they shall melt,"]]