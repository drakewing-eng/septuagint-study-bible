[["1",[["ᾄσω",700299,165],["δὴ",703395,11],["τῷ",709436,113],["ἠγαπημένῳ",700120,516],["ᾆσμα",701970,25],["τοῦ",709436,35],["ἀγαπητοῦ",700124,116],["τῷ",709436,113],["ἀμπελῶνί",700872,114],["μου",709032,133],["ἀμπελὼν",700872,4],["ἐγενήθη",703104,37],["τῷ",709436,113],["ἠγαπημένῳ",700120,516],["ἐν",704639,0],["κέρατι",707625,54],["ἐν",704639,0],["τόπῳ",712903,114],["πίονι",710491,30]],"Now I will sing to [my] beloved a song of my beloved concerning my vineyard. [My] beloved had a vineyard on a high hill in a fertile place."],["2",[["καὶ",707031,7],["φραγμὸν",713572,6],["περιέθηκα",710403,155],["καὶ",707031,7],["ἐχαράκωσα",713726,155],["καὶ",707031,7],["ἐφύτευσα",713636,155],["ἄμπελον",700870,9],["σωρηχ",712645,36],["καὶ",707031,7],["ᾠκοδόμησα",709509,155],["πύργον",711092,6],["ἐν",704639,0],["μέσῳ",708768,97],["αὐτοῦ",702165,102],["καὶ",707031,7],["προλήνιον",710819,25],["ὤρυξα",709775,155],["ἐν",704639,0],["αὐτῷ",702165,50],["καὶ",707031,7],["ἔμεινα",708736,155],["τοῦ",709436,20],["ποιῆσαι",710582,106],["σταφυλήν",712052,9],["ἐποίησεν",710582,2],["δὲ",703303,11],["ἀκάνθας",700517,39]],"And I made a hedge round it, and dug a trench, and planted a choice vine, and built a tower in the midst of it, and dug a place for the wine-vat in it: and I waited [for it] to bring forth grapes, and it brought forth thorns."],["3",[["καὶ",707031,7],["νῦν",709384,28],["ἄνθρωπος",701163,4],["τοῦ",709436,35],["Ιουδα",706768,18],["καὶ",707031,7],["οἱ",709436,136],["ἐνοικοῦντες",704772,146],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["κρίνατε",707905,74],["ἐν",704639,0],["ἐμοὶ",704577,159],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,46],["τοῦ",709436,35],["ἀμπελῶνός",700872,18],["μου",709032,133]],"And now, ye dwellers in Jerusalem, and [every] man of Juda, judge between me and my vineyard."],["4",[["τί",712867,126],["ποιήσω",710582,165],["ἔτι",705538,28],["τῷ",709436,113],["ἀμπελῶνί",700872,114],["μου",709032,133],["καὶ",707031,7],["οὐκ",709805,28],["ἐποίησα",710582,155],["αὐτῷ",702165,50],["διότι",703734,7],["ἔμεινα",708736,155],["τοῦ",709436,20],["ποιῆσαι",710582,106],["σταφυλήν",712052,9],["ἐποίησεν",710582,2],["δὲ",703303,11],["ἀκάνθας",700517,39]],"What shall I do any more to my vineyard, that I have not done to it? Whereas I expected [it] to bring forth grapes, but it has brought forth thorns."],["5",[["νῦν",709384,28],["δὲ",703303,11],["ἀναγγελῶ",700921,165],["ὑμῖν",713084,90],["τί",712867,126],["ποιήσω",710582,165],["τῷ",709436,113],["ἀμπελῶνί",700872,114],["μου",709032,133],["ἀφελῶ",702177,165],["τὸν",709436,5],["φραγμὸν",713572,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔσται",704093,93],["εἰς",704105,0],["διαρπαγήν",703561,9],["καὶ",707031,7],["καθελῶ",706982,165],["τὸν",709436,5],["τοῖχον",712879,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔσται",704093,93],["εἰς",704105,0],["καταπάτημα",707361,46]],"And now I will tell you what I will do to my vineyard: I will take away its hedge, and it shall be for a spoil; and I will pull down its walls, and it shall be [left] to be trodden down."],["6",[["καὶ",707031,7],["ἀνήσω",701169,165],["τὸν",709436,5],["ἀμπελῶνά",700872,6],["μου",709032,133],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["τμηθῇ",712791,384],["οὐδὲ",709816,7],["μὴ",708851,28],["σκαφῇ",711826,134],["καὶ",707031,7],["ἀναβήσεται",700905,93],["εἰς",704105,0],["αὐτὸν",702165,85],["ὡς",714148,28],["εἰς",704105,0],["χέρσον",713834,9],["ἄκανθα",700517,9],["καὶ",707031,7],["ταῖς",709436,75],["νεφέλαις",709277,76],["ἐντελοῦμαι",704791,181],["τοῦ",709436,20],["μὴ",708851,28],["βρέξαι",702812,106],["εἰς",704105,0],["αὐτὸν",702165,85],["ὑετόν",713074,6]],"And I will forsake my vineyard; and it shall not be pruned, nor dug, and thorns shall come up upon it as on barren land; and I will command the clouds to rain no rain upon it."],["7",[["ὁ",709436,3],["γὰρ",702963,11],["ἀμπελὼν",700872,4],["κυρίου",707996,18],["σαβαωθ",711346,228],["οἶκος",709516,4],["τοῦ",709436,35],["Ισραηλ",706839,18],["ἐστίν",704093,91],["καὶ",707031,7],["ἄνθρωπος",701163,4],["τοῦ",709436,35],["Ιουδα",706768,18],["νεόφυτον",709260,26],["ἠγαπημένον",700120,439],["ἔμεινα",708736,155],["τοῦ",709436,20],["ποιῆσαι",710582,106],["κρίσιν",707908,9],["ἐποίησεν",710582,2],["δὲ",703303,11],["ἀνομίαν",701192,9],["καὶ",707031,7],["οὐ",709805,28],["δικαιοσύνην",703695,9],["ἀλλὰ",700680,7],["κραυγήν",707886,9]],"For the vineyard of the Lord of hosts is the house of Israel, and the men of Juda [his] beloved plant: I expected [it] to bring forth judgment, and it brought forth iniquity; and not righteousness, but a cry."],["8",[["οὐαὶ",709807,88],["οἱ",709436,136],["συνάπτοντες",712404,146],["οἰκίαν",709505,9],["πρὸς",710844,0],["οἰκίαν",709505,9],["καὶ",707031,7],["ἀγρὸν",700196,6],["πρὸς",710844,0],["ἀγρὸν",700196,6],["ἐγγίζοντες",703939,146],["ἵνα",706747,7],["τοῦ",709436,35],["πλησίον",710547,28],["ἀφέλωνταί",702177,232],["τι",712866,126],["μὴ",708851,28],["οἰκήσετε",709499,337],["μόνοι",709003,138],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"Woe [to them] that join house to house, and add field to field, that they may take away something of their neighbour's: will ye dwell alone upon the land?"],["9",[["ἠκούσθη",700587,37],["γὰρ",702963,11],["εἰς",704105,0],["τὰ",709436,41],["ὦτα",709852,42],["κυρίου",707996,18],["σαβαωθ",711346,228],["ταῦτα",709858,71],["ἐὰν",703912,7],["γὰρ",702963,11],["γένωνται",703104,232],["οἰκίαι",709505,191],["πολλαί",710646,192],["εἰς",704105,0],["ἔρημον",705420,9],["ἔσονται",704093,135],["μεγάλαι",708653,192],["καὶ",707031,7],["καλαί",707097,192],["καὶ",707031,7],["οὐκ",709805,28],["ἔσονται",704093,135],["οἱ",709436,136],["ἐνοικοῦντες",704772,146],["ἐν",704639,0],["αὐταῖς",702165,200]],"For these things have reached the ears of the Lord of hosts: for though many houses should be built, many and fair houses shall be desolate, and there shall be no inhabitants in them."],["10",[["οὗ",709806,28],["γὰρ",702963,11],["ἐργῶνται",705383,269],["δέκα",703333,59],["ζεύγη",705865,42],["βοῶν",702798,81],["ποιήσει",710582,127],["κεράμιον",707621,25],["ἕν",704106,46],["καὶ",707031,7],["ὁ",709436,3],["σπείρων",712006,72],["ἀρτάβας",701823,39],["ἓξ",704828,59],["ποιήσει",710582,127],["μέτρα",708846,42],["τρία",712927,68]],"For where ten yoke of oxen plough [the land] shall yield one jar-full, and he that sows six homers shall produce three measures."],["11",[["οὐαὶ",709807,88],["οἱ",709436,136],["ἐγειρόμενοι",703949,348],["τὸ",709436,24],["πρωὶ",711021,28],["καὶ",707031,7],["τὸ",709436,24],["σικερα",711781,25],["διώκοντες",703768,146],["οἱ",709436,136],["μένοντες",708736,146],["τὸ",709436,24],["ὀψέ",709896,28],["ὁ",709436,3],["γὰρ",702963,11],["οἶνος",709530,4],["αὐτοὺς",702165,62],["συγκαύσει",712198,127]],"Woe [to them] that rise up in the morning, and follow strong drink; who wait [at it till] the evening: for the wine shall inflame them."],["12",[["μετὰ",708780,0],["γὰρ",702963,11],["κιθάρας",707669,17],["καὶ",707031,7],["ψαλτηρίου",714023,21],["καὶ",707031,7],["τυμπάνων",713019,44],["καὶ",707031,7],["αὐλῶν",702139,81],["τὸν",709436,5],["οἶνον",709530,6],["πίνουσιν",710478,197],["τὰ",709436,41],["δὲ",703303,11],["ἔργα",705396,42],["κυρίου",707996,18],["οὐκ",709805,28],["ἐμβλέπουσιν",704551,197],["καὶ",707031,7],["τὰ",709436,41],["ἔργα",705396,42],["τῶν",709436,130],["χειρῶν",713787,65],["αὐτοῦ",702165,102],["οὐ",709805,28],["κατανοοῦσιν",707341,197]],"For they drink wine with harp, and psaltery, and drums, and pipes: but they regard not the works of the Lord, and consider not the works of his hands."],["13",[["τοίνυν",712875,11],["αἰχμάλωτος",700503,14],["ὁ",709436,3],["λαός",708094,4],["μου",709032,133],["ἐγενήθη",703104,37],["διὰ",703417,0],["τὸ",709436,24],["μὴ",708851,28],["εἰδέναι",709492,115],["αὐτοὺς",702165,62],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["πλῆθος",710529,25],["ἐγενήθη",703104,37],["νεκρῶν",709247,81],["διὰ",703417,0],["λιμὸν",708210,6],["καὶ",707031,7],["δίψαν",703762,9],["ὕδατος",713071,21]],"Therefore my people have been taken captive, because they know not the Lord: and there has been a multitude of dead [bodies], because of hunger and of thirst for water."],["14",[["καὶ",707031,7],["ἐπλάτυνεν",710508,13],["ὁ",709436,3],["ᾅδης",700255,4],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["διήνοιξεν",703532,2],["τὸ",709436,24],["στόμα",712125,25],["αὐτοῦ",702165,102],["τοῦ",709436,20],["μὴ",708851,28],["διαλιπεῖν",703496,106],["καὶ",707031,7],["καταβήσονται",707202,135],["οἱ",709436,136],["ἔνδοξοι",704694,138],["καὶ",707031,7],["οἱ",709436,136],["μεγάλοι",708653,138],["καὶ",707031,7],["οἱ",709436,136],["πλούσιοι",710560,138],["καὶ",707031,7],["οἱ",709436,136],["λοιμοὶ",708245,138],["αὐτῆς",702165,86]],"Therefore hell has enlarged its desire and opened its mouth without ceasing: and her glorious and great, and her rich and her pestilent men shall go down [into it]."],["15",[["καὶ",707031,7],["ταπεινωθήσεται",712717,134],["ἄνθρωπος",701163,4],["καὶ",707031,7],["ἀτιμασθήσεται",702092,134],["ἀνήρ",701150,4],["καὶ",707031,7],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["οἱ",709436,136],["μετέωροι",708831,138],["ταπεινωθήσονται",712717,144]],"And the mean man shall be brought low, and the great man shall be disgraced, and the lofty eyes shall be brought low."],["16",[["καὶ",707031,7],["ὑψωθήσεται",713289,134],["κύριος",707996,4],["σαβαωθ",711346,228],["ἐν",704639,0],["κρίματι",707903,54],["καὶ",707031,7],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["ἅγιος",700159,14],["δοξασθήσεται",703792,134],["ἐν",704639,0],["δικαιοσύνῃ",703695,1]],"But the Lord of hosts shall be exalted in judgment, and the holy God shall be glorified in righteousness."],["17",[["καὶ",707031,7],["βοσκηθήσονται",702767,144],["οἱ",709436,136],["διηρπασμένοι",703562,429],["ὡς",714148,28],["ταῦροι",712734,52],["καὶ",707031,7],["τὰς",709436,38],["ἐρήμους",705420,39],["τῶν",709436,80],["ἀπειλημμένων",701504,445],["ἄρνες",701731,52],["φάγονται",713296,135]],"And they that were spoiled shall be fed as bulls, and lambs shall feed on the waste places of them that are taken away."],["18",[["οὐαὶ",709807,88],["οἱ",709436,136],["ἐπισπώμενοι",705258,348],["τὰς",709436,38],["ἁμαρτίας",700775,39],["ὡς",714148,28],["σχοινίῳ",712610,54],["μακρῷ",708421,97],["καὶ",707031,7],["ὡς",714148,28],["ζυγοῦ",705894,18],["ἱμάντι",706741,114],["δαμάλεως",703271,17],["τὰς",709436,38],["ἀνομίας",701192,39]],"Woe [to them] that draw sins to them as with a long rope, and iniquities as with a thong of the heifer's yoke:"],["19",[["οἱ",709436,136],["λέγοντες",708124,146],["τὸ",709436,24],["τάχος",712747,25],["ἐγγισάτω",703939,45],["ἃ",709781,69],["ποιήσει",710582,127],["ἵνα",706747,7],["ἴδωμεν",709725,79],["καὶ",707031,7],["ἐλθάτω",705453,45],["ἡ",709436,10],["βουλὴ",702792,12],["τοῦ",709436,35],["ἁγίου",700159,116],["Ισραηλ",706839,18],["ἵνα",706747,7],["γνῶμεν",703105,79]],"who say, Let him speedily hasten what he will do, that we may see [it]: and let the counsel of the Holy One of Israel come, that we may know [it]."],["20",[["οὐαὶ",709807,88],["οἱ",709436,136],["λέγοντες",708124,146],["τὸ",709436,24],["πονηρὸν",710660,46],["καλὸν",707097,46],["καὶ",707031,7],["τὸ",709436,24],["καλὸν",707097,46],["πονηρόν",710660,46],["οἱ",709436,136],["τιθέντες",712849,146],["τὸ",709436,24],["σκότος",711889,25],["φῶς",713642,25],["καὶ",707031,7],["τὸ",709436,24],["φῶς",713642,25],["σκότος",711889,25],["οἱ",709436,136],["τιθέντες",712849,146],["τὸ",709436,24],["πικρὸν",710475,27],["γλυκὺ",703114,46],["καὶ",707031,7],["τὸ",709436,24],["γλυκὺ",703114,46],["πικρόν",710475,46]],"Woe [to them] that call evil good, and good evil; who make darkness light, and light darkness; who make bitter sweet, and sweet bitter."],["21",[["οὐαὶ",709807,88],["οἱ",709436,136],["συνετοὶ",712464,138],["ἐν",704639,0],["ἑαυτοῖς",703917,151],["καὶ",707031,7],["ἐνώπιον",704823,0],["ἑαυτῶν",703917,40],["ἐπιστήμονες",705268,138]],"Woe [to them] that are wise in their own conceit, and knowing in their own sight."],["22",[["οὐαὶ",709807,88],["οἱ