[["1",[["τὸ",709436,34],["ῥῆμα",711246,15],["τὸ",709436,34],["κατὰ",707200,0],["Δαμασκοῦ",703275,18],["ἰδοὺ",706497,88],["Δαμασκὸς",703275,18],["ἀρθήσεται",700473,134],["ἀπὸ",701425,0],["πόλεων",710612,65],["καὶ",707031,7],["ἔσται",704093,93],["εἰς",704105,0],["πτῶσιν",711072,9]],"The Word against Damascus. Behold, Damascus shall be taken away from among cities, and shall become a ruin;"],["2",[["καταλελειμμένη",707305,203],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["εἰς",704105,0],["κοίτην",707781,9],["ποιμνίων",710598,44],["καὶ",707031,7],["ἀνάπαυσιν",701026,9],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ὁ",709436,3],["διώκων",703768,72]],"abandoned for ever, to [be] a fold and resting-place for flocks, and there shall be none to go after them."],["3",[["καὶ",707031,7],["οὐκέτι",709827,28],["ἔσται",704093,93],["ὀχυρὰ",709889,68],["τοῦ",709436,20],["καταφυγεῖν",707472,106],["Εφραιμ",705769,6],["καὶ",707031,7],["οὐκέτι",709827,28],["ἔσται",704093,93],["βασιλεία",702577,12],["ἐν",704639,0],["Δαμασκῷ",703275,114],["καὶ",707031,7],["τὸ",709436,34],["λοιπὸν",708247,14],["τῶν",709436,80],["Σύρων",712541,81],["ἀπολεῖται",701513,93],["οὐ",709805,28],["γὰρ",702963,11],["σὺ",712181,164],["βελτίων",702647,14],["εἶ",704093,154],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["καὶ",707031,7],["τῆς",709436,16],["δόξης",703791,17],["αὐτῶν",702165,40],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["σαβαωθ",711346,228]],"And she shall no longer be a strong place for Ephraim to flee to, and there shall no longer be a kingdom in Damascus, or a remnant of Syrians; for thou art no better than the children of Israel, [even] than their glory; thus saith the Lord of hosts."],["4",[["ἔσται",704093,93],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἔκλειψις",704239,12],["τῆς",709436,16],["δόξης",703791,17],["Ιακωβ",706401,18],["καὶ",707031,7],["τὰ",709436,41],["πίονα",710491,68],["τῆς",709436,16],["δόξης",703791,17],["αὐτοῦ",702165,102],["σεισθήσεται",711633,134]],"There shall be in that day a failure of the glory of Jacob, and the riches of his glory shall be shaken."],["5",[["καὶ",707031,7],["ἔσται",704093,93],["ὃν",709781,112],["τρόπον",712980,6],["ἐάν",703912,7],["τις",712866,158],["συναγάγῃ",712375,172],["ἀμητὸν",700819,6],["ἑστηκότα",706846,427],["καὶ",707031,7],["σπέρμα",712008,25],["σταχύων",712053,81],["ἐν",704639,0],["τῷ",709436,113],["βραχίονι",702808,114],["αὐτοῦ",702165,102],["ἀμήσῃ",700789,172],["καὶ",707031,7],["ἔσται",704093,93],["ὃν",709781,112],["τρόπον",712980,6],["ἐάν",703912,7],["τις",712866,158],["συναγάγῃ",712375,172],["στάχυν",712053,6],["ἐν",704639,0],["φάραγγι",713351,1],["στερεᾷ",712075,101]],"And it shall be as if one should gather standing corn, and reap the grain of the ears; and it shall be as if one should gather ears in a rich valley;"],["6",[["καὶ",707031,7],["καταλειφθῇ",707305,384],["ἐν",704639,0],["αὐτῇ",702165,105],["καλάμη",707079,12],["ἢ",705924,7],["ὡς",714148,28],["ῥῶγες",711324,39],["ἐλαίας",704376,17],["δύο",703849,59],["ἢ",705924,7],["τρεῖς",712927,592],["ἐπ᾿",705080,0],["ἄκρου",700608,116],["μετεώρου",708831,116],["ἢ",705924,7],["τέσσαρες",712808,138],["ἢ",705924,7],["πέντε",710266,59],["ἐπὶ",705080,0],["τῶν",709436,80],["κλάδων",707702,81],["αὐτῶν",702165,40],["καταλειφθῇ",707305,384],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18]],"and [as if] there should be left stubble therein, or [as it were] the berries of an olive tree, two or three on the topmost bough, or [as if] four or five should be left on their branches; thus saith the Lord, the God of Israel."],["7",[["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["πεποιθὼς",710221,270],["ἔσται",704093,93],["ἄνθρωπος",701163,4],["ἐπὶ",705080,0],["τῷ",709436,113],["ποιήσαντι",710582,350],["αὐτόν",702165,85],["οἱ",709436,136],["δὲ",703303,11],["ὀφθαλμοὶ",709870,52],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὸν",709436,5],["ἅγιον",700159,27],["τοῦ",709436,35],["Ισραηλ",706839,18],["ἐμβλέψονται",704551,135]],"In that day a man shall trust in him that made him, and his eyes shall have respect to the Holy One of Israel."],["8",[["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["πεποιθότες",710221,268],["ὦσιν",709852,96],["ἐπὶ",705080,0],["τοῖς",709436,147],["βωμοῖς",702840,148],["οὐδὲ",709816,7],["ἐπὶ",705080,0],["τοῖς",709436,95],["ἔργοις",705396,96],["τῶν",709436,130],["χειρῶν",713787,65],["αὐτῶν",702165,40],["ἃ",709781,69],["ἐποίησαν",710582,150],["οἱ",709436,136],["δάκτυλοι",703259,52],["αὐτῶν",702165,40],["καὶ",707031,7],["οὐκ",709805,28],["ὄψονται",709725,135],["τὰ",709436,41],["δένδρα",703353,42],["αὐτῶν",702165,40],["οὐδὲ",709816,7],["τὰ",709436,41],["βδελύγματα",702604,42],["αὐτῶν",702165,40]],"And they shall not at all trust in their altars, nor in the works of their hands, which their fingers made; and they shall not look to the trees, nor to their abominations."],["9",[["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἔσονται",704093,135],["αἱ",709436,190],["πόλεις",710612,191],["σου",711945,133],["ἐγκαταλελειμμέναι",703967,423],["ὃν",709781,112],["τρόπον",712980,6],["ἐγκατέλιπον",703967,150],["οἱ",709436,136],["Αμορραῖοι",700865,52],["καὶ",707031,7],["οἱ",709436,136],["Ευαῖοι",705549,52],["ἀπὸ",701425,0],["προσώπου",710986,21],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["καὶ",707031,7],["ἔσονται",704093,135],["ἔρημοι",705420,191]],"In that day thy cities shall be deserted, as the Amorites and the Evæans deserted [theirs], because of the children of Israel; and they shall be desolate."],["10",[["διότι",703734,7],["κατέλιπες",707305,162],["τὸν",709436,5],["θεὸν",706192,6],["τὸν",709436,5],["σωτῆρά",712657,6],["σου",711945,133],["καὶ",707031,7],["κυρίου",707996,18],["τοῦ",709436,35],["βοηθοῦ",702748,18],["σου",711945,133],["οὐκ",709805,28],["ἐμνήσθης",708923,168],["διὰ",703417,0],["τοῦτο",709858,129],["φυτεύσεις",713636,166],["φύτευμα",713635,25],["ἄπιστον",701413,46],["καὶ",707031,7],["σπέρμα",712008,25],["ἄπιστον",701413,46]],"Because thou hast forsaken God thy Saviour, and hast not been mindful of the Lord thy helper; therefore shalt thou plant a false plant, and a false seed."],["11",[["τῇ",709436,100],["δὲ",703303,11],["ἡμέρᾳ",705984,1],["ᾗ",709781,108],["ἂν",700900,11],["φυτεύσῃς",713636,175],["πλανηθήσῃ",710495,364],["τὸ",709436,24],["δὲ",703303,11],["πρωί",711021,28],["ἐὰν",703912,7],["σπείρῃς",712006,175],["ἀνθήσει",701152,127],["εἰς",704105,0],["ἀμητὸν",700819,6],["ᾗ",709781,108],["ἂν",700900,11],["ἡμέρᾳ",705984,1],["κληρώσῃ",707728,166],["καὶ",707031,7],["ὡς",714148,28],["πατὴρ",710189,4],["ἀνθρώπου",701163,18],["κληρώσῃ",707728,166],["τοῖς",709436,147],["υἱοῖς",713075,148],["σου",711945,133]],"In the day wherein thou shalt plant thou shalt be deceived; but if thou sow in the morning, [the seed] shall spring up for a crop in the day wherein thou shalt obtain an inheritance, and as a man's father, thou shalt obtain an inheritance for thy sons."],["12",[["οὐαὶ",709807,88],["πλῆθος",710529,25],["ἐθνῶν",704068,44],["πολλῶν",710646,83],["ὡς",714148,28],["θάλασσα",706069,12],["κυμαίνουσα",707969,188],["οὕτως",709859,28],["ταραχθήσεσθε",712721,261],["καὶ",707031,7],["νῶτος",709403,4],["ἐθνῶν",704068,44],["πολλῶν",710646,83],["ὡς",714148,28],["ὕδωρ",713071,15],["ἠχήσει",706045,127]],"Woe [to] the multitude of many nations, as the swelling sea, so shall ye be confounded; and the force of many nations shall sound like water;"],["13",[["ὡς",714148,28],["ὕδωρ",713071,25],["πολὺ",710646,46],["ἔθνη",704068,42],["πολλά",710646,68],["ὡς",714148,28],["ὕδατος",713071,21],["πολλοῦ",710646,92],["βίᾳ",702712,1],["καταφερομένου",707471,262],["καὶ",707031,7],["ἀποσκορακιεῖ",701578,127],["αὐτὸν",702165,85],["καὶ",707031,7],["πόρρω",710680,28],["αὐτὸν",702165,85],["διώξεται",703768,93],["ὡς",714148,28],["χνοῦν",713882,6],["ἀχύρου",702316,21],["λικμώντων",708202,170],["ἀπέναντι",701389,28],["ἀνέμου",701123,18],["καὶ",707031,7],["ὡς",714148,28],["κονιορτὸν",707815,6],["τροχοῦ",712994,18],["καταιγὶς",707254,9],["φέρουσα",713428,188]],"many nations like much water, as when much water rushes violently: and they shall drive him away, and pursue him afar, as the dust of chaff when men winnow before the wind, and as a storm whirling the dust of the wheel."],["14",[["πρὸς",710844,0],["ἑσπέραν",705500,9],["ἔσται",704093,93],["πένθος",710253,25],["πρὶν",710742,28],["ἢ",705924,7],["πρωὶ",711021,28],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["αὕτη",709858,107],["ἡ",709436,10],["μερὶς",708748,12],["τῶν",709436,80],["ὑμᾶς",713080,194],["προνομευσάντων",710826,221],["καὶ",707031,7],["κληρονομία",707725,12],["τοῖς",709436,147],["ὑμᾶς",713080,194],["κληρονομήσασιν",707724,456]],"Toward evening, and there shall be grief; before the morning, and he shall not be. This is the portion of them that spoiled you, and the inheritance to them that robbed you of your inheritance."]]