[["1",[["τὸ",709436,34],["ὅραμα",709720,15],["τῆς",709436,16],["ἐρήμου",705420,17],["ὡς",714148,28],["καταιγὶς",707254,12],["δι᾿",703417,0],["ἐρήμου",705420,17],["διέλθοι",703673,225],["ἐξ",704132,0],["ἐρήμου",705420,17],["ἐρχομένη",705453,211],["ἐκ",704132,0],["γῆς",703083,17],["φοβερὸν",713530,46]],"The Vision of the Desert. As though a whirlwind should pass through the desert, coming from a desert, [even] from such a land,"],["2",[["τὸ",709436,24],["ὅραμα",709720,25],["καὶ",707031,7],["σκληρὸν",711861,46],["ἀνηγγέλη",700921,37],["μοι",708974,159],["ὁ",709436,3],["ἀθετῶν",700369,72],["ἀθετεῖ",700369,91],["ὁ",709436,3],["ἀνομῶν",701190,72],["ἀνομεῖ",701190,91],["ἐπ᾿",705080,0],["ἐμοὶ",704577,159],["οἱ",709436,136],["Αιλαμῖται",700433,52],["καὶ",707031,7],["οἱ",709436,136],["πρέσβεις",710733,52],["τῶν",709436,80],["Περσῶν",710429,81],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ἔρχονται",705453,269],["νῦν",709384,28],["στενάξω",712066,165],["καὶ",707031,7],["παρακαλέσω",710039,165],["ἐμαυτόν",704545,85]],"[so] a fearful and a grievous vision was declared to me: he that is treacherous deals treacherously, the transgressor transgresses. The Elamites are upon me, and the ambassadors of the Persians come against me: now will I groan and comfort myself."],["3",[["διὰ",703417,0],["τοῦτο",709858,129],["ἐνεπλήσθη",704592,37],["ἡ",709436,10],["ὀσφύς",709800,12],["μου",709032,133],["ἐκλύσεως",704252,17],["καὶ",707031,7],["ὠδῖνες",714094,191],["ἔλαβόν",708076,150],["με",708618,163],["ὡς",714148,28],["τὴν",709436,8],["τίκτουσαν",712853,78],["ἠδίκησα",700269,155],["τὸ",709436,24],["μὴ",708851,28],["ἀκοῦσαι",700587,106],["ἐσπούδασα",712031,155],["τὸ",709436,24],["μὴ",708851,28],["βλέπειν",702740,55]],"Therefore are my loins filled with feebleness, and pangs have seized me as a travailing woman: I dealt wrongfully that I might not hear; I hasted that I might not see."],["4",[["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["πλανᾶται",710495,117],["καὶ",707031,7],["ἡ",709436,10],["ἀνομία",701192,12],["με",708618,163],["βαπτίζει",702515,91],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ἐφέστηκεν",705756,171],["εἰς",704105,0],["φόβον",713534,6]],"My heart wanders, and transgression overwhelms me; my soul is occupied with fear."],["5",[["ἑτοίμασον",705539,176],["τὴν",709436,8],["τράπεζαν",712919,9],["πίετε",710478,74],["φάγετε",713296,74],["ἀναστάντες",701173,196],["οἱ",709436,136],["ἄρχοντες",701862,52],["ἑτοιμάσατε",705539,74],["θυρεούς",706338,57]],"Prepare the table, eat, drink: arise, ye princes, and prepare [your] shields."],["6",[["ὅτι",709803,7],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["βαδίσας",702367,162],["σεαυτῷ",711599,50],["στῆσον",706846,176],["σκοπὸν",711877,6],["καὶ",707031,7],["ὃ",709781,213],["ἂν",700900,11],["ἴδῃς",709725,175],["ἀνάγγειλον",700921,176]],"For thus said the Lord to me, Go and station a watchman for thyself, and declare whatever thou shalt see."],["7",[["καὶ",707031,7],["εἶδον",709725,155],["ἀναβάτας",700909,57],["ἱππεῖς",706786,52],["δύο",703849,59],["ἀναβάτην",700909,6],["ὄνου",709671,18],["καὶ",707031,7],["ἀναβάτην",700909,6],["καμήλου",707110,18],["ἀκρόασαι",700602,106],["ἀκρόασιν",700603,9],["πολλὴν",710646,36]],"And I saw two mounted horsemen, and a rider on an ass, and a rider on a camel."],["8",[["καὶ",707031,7],["κάλεσον",707084,176],["Ουριαν",709848,6],["εἰς",704105,0],["τὴν",709436,8],["σκοπιὰν",711876,9],["κυρίου",707996,18],["καὶ",707031,7],["εἶπεν",705373,2],["ἔστην",706846,155],["διὰ",703417,0],["παντὸς",710177,116],["ἡμέρας",705984,39],["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["παρεμβολῆς",710133,17],["ἔστην",706846,155],["ὅλην",709597,36],["τὴν",709436,8],["νύκτα",709386,9]],"Hearken with great attention, and call thou Urias to the watch-tower: the Lord has spoken. I stood continually during the day, and I stood in the camp all the night:"],["9",[["καὶ",707031,7],["ἰδοὺ",706497,88],["αὐτὸς",702165,121],["ἔρχεται",705453,117],["ἀναβάτης",700909,4],["συνωρίδος",712531,17],["καὶ",707031,7],["ἀποκριθεὶς",701492,217],["εἶπεν",705373,2],["πέπτωκεν",710481,91],["Βαβυλών",702352,12],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["ἀγάλματα",700116,42],["αὐτῆς",702165,86],["καὶ",707031,7],["τὰ",709436,41],["χειροποίητα",713796,68],["αὐτῆς",702165,86],["συνετρίβησαν",712520,99],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9]],"and, behold, he comes riding in a chariot and pair: and he answered and said, Babylon is fallen, is fallen; and all her images and her idols have been crushed to the ground."],["10",[["ἀκούσατε",700587,74],["οἱ",709436,136],["καταλελειμμένοι",707305,429],["καὶ",707031,7],["οἱ",709436,136],["ὀδυνώμενοι",709462,348],["ἀκούσατε",700587,74],["ἃ",709781,69],["ἤκουσα",705956,188],["παρὰ",709995,0],["κυρίου",707996,18],["σαβαωθ",711346,228],["ὁ",709436,3],["θεὸς",706192,4],["τοῦ",709436,35],["Ισραηλ",706839,18],["ἀνήγγειλεν",700921,2],["ἡμῖν",705994,90]],"Hear, ye that are left, and ye that are in pain, hear what things I have heard of the Lord of hosts [which] the God of Israel has declared to us."],["11",[["τὸ",709436,24],["ὅραμα",709720,25],["τῆς",709436,16],["Ιδουμαίας",706503,17],["πρὸς",710844,0],["ἐμὲ",704555,163],["καλεῖ",707084,91],["παρὰ",709995,0],["τοῦ",709436,35],["Σηιρ",711734,18],["φυλάσσετε",713619,335],["ἐπάλξεις",705012,39]],"The Vision of Idumea. Call to me out of Seir; guard ye the bulwarks."],["12",[["φυλάσσω",713619,157],["τὸ",709436,24],["πρωὶ",711021,28],["καὶ",707031,7],["τὴν",709436,8],["νύκτα",709386,9],["ἐὰν",703912,7],["ζητῇς",705879,205],["ζήτει",705879,240],["καὶ",707031,7],["παρ᾿",709995,0],["ἐμοὶ",704577,159],["οἴκει",709499,240]],"I watch in the morning and the night: if thou wouldest enquire, enquire, and dwell by me."],["13",[["ἐν",704639,0],["τῷ",709436,113],["δρυμῷ",703836,114],["ἑσπέρας",705500,17],["κοιμηθήσῃ",707767,364],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["Δαιδαν",703248,118]],"Thou mayest lodge in the forest in the evening, or in the way of Dædan."],["14",[["εἰς",704105,0],["συνάντησιν",712397,9],["διψῶντι",703763,379],["ὕδωρ",713071,15],["φέρετε",713428,335],["οἱ",709436,136],["ἐνοικοῦντες",704772,146],["ἐν",704639,0],["χώρᾳ",714011,1],["Θαιμαν",706062,118],["ἄρτοις",701829,148],["συναντᾶτε",712394,335],["τοῖς",709436,147],["φεύγουσιν",713433,197]],"Ye that dwell in the country of Thæman, bring water to meet him that is thirsty;"],["15",[["διὰ",703417,0],["τὸ",709436,24],["πλῆθος",710529,25],["τῶν",709436,80],["φευγόντων",713433,170],["καὶ",707031,7],["διὰ",703417,0],["τὸ",709436,24],["πλῆθος",710529,25],["τῶν",709436,80],["πλανωμένων",710495,299],["καὶ",707031,7],["διὰ",703417,0],["τὸ",709436,24],["πλῆθος",710529,25],["τῆς",709436,16],["μαχαίρας",708593,17],["καὶ",707031,7],["διὰ",703417,0],["τὸ",709436,24],["πλῆθος",710529,25],["τῶν",709436,80],["τοξευμάτων",712895,81],["τῶν",709436,80],["διατεταμένων",703604,445],["καὶ",707031,7],["διὰ",703417,0],["τὸ",709436,24],["πλῆθος",710529,25],["τῶν",709436,80],["πεπτωκότων",710481,387],["ἐν",704639,0],["τῷ",709436,113],["πολέμῳ",710605,114]],"meet the fugitives with bread, because of the multitude of the slain, and because of the multitude of them that lose their way, and because of the multitude of swords, and because of the multitude of bent bows, and because of the multitude of them that have fallen in war."],["16",[["ὅτι",709803,7],["οὕτως",709859,28],["εἶπέν",705373,2],["μοι",708974,159],["κύριος",707996,4],["ἔτι",705538,28],["ἐνιαυτὸς",704745,4],["ὡς",714148,28],["ἐνιαυτὸς",704745,4],["μισθωτοῦ",708942,116],["ἐκλείψει",704237,127],["ἡ",709436,10],["δόξα",703791,12],["τῶν",709436,80],["υἱῶν",713075,81],["Κηδαρ",707645,118]],"For thus said the Lord to me, Yet a year, as the year of an hireling, [and] the glory of the sons of Kedar shall fail:"],["17",[["καὶ",707031,7],["τὸ",709436,34],["κατάλοιπον",707317,26],["τῶν",709436,80],["τοξευμάτων",712895,81],["τῶν",709436,80],["ἰσχυρῶν",706855,169],["υἱῶν",713075,81],["Κηδαρ",707645,118],["ἔσται",704093,93],["ὀλίγον",709568,26],["διότι",703734,7],["κύριος",707996,4],["ἐλάλησεν",708071,2],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18]],"and the remnant of the strong bows of the sons of Kedar shall be small: for the Lord God of Israel has spoken [it]."]]