[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["τῷ",709436,113],["ἀκοῦσαι",700587,106],["τὸν",709436,5],["βασιλέα",702580,6],["Εζεκιαν",704044,6],["ἔσχισεν",712604,2],["τὰ",709436,41],["ἱμάτια",706742,42],["καὶ",707031,7],["σάκκον",711386,6],["περιεβάλετο",710294,23],["καὶ",707031,7],["ἀνέβη",700905,2],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["κυρίου",707996,18]],"And it came to pass, when king Ezekias heard [it, that] he rent his clothes, and put on sackcloth, and went up to the house of the Lord."],["2",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Ελιακιμ",704454,4],["τὸν",709436,5],["οἰκονόμον",709514,6],["καὶ",707031,7],["Σομναν",711936,6],["τὸν",709436,5],["γραμματέα",703185,6],["καὶ",707031,7],["τοὺς",709436,58],["πρεσβυτέρους",710735,57],["τῶν",709436,80],["ἱερέων",706614,81],["περιβεβλημένους",710294,360],["σάκκους",711386,57],["πρὸς",710844,0],["Ησαιαν",706026,6],["υἱὸν",713075,6],["Αμως",700898,18],["τὸν",709436,5],["προφήτην",711009,6]],"And he sent Heliakim the steward, and Somnas the scribe, and the elders of the priests clothed with sackcloth, to Esaias the son of Amos, the prophet. And they said to him, Thus says Ezekias,"],["3",[["καὶ",707031,7],["εἶπαν",705373,150],["αὐτῷ",702165,50],["τάδε",709446,71],["λέγει",708124,91],["Εζεκιας",704044,4],["ἡμέρα",705984,12],["θλίψεως",706276,17],["καὶ",707031,7],["ὀνειδισμοῦ",709657,18],["καὶ",707031,7],["ἐλεγμοῦ",704413,18],["καὶ",707031,7],["ὀργῆς",709728,17],["ἡ",709436,10],["σήμερον",711751,28],["ἡμέρα",705984,12],["ὅτι",709803,7],["ἥκει",705956,91],["ἡ",709436,10],["ὠδὶν",714094,12],["τῇ",709436,100],["τικτούσῃ",712853,220],["ἰσχὺν",706858,9],["δὲ",703303,11],["οὐκ",709805,28],["ἔχει",705785,91],["τοῦ",709436,35],["τεκεῖν",712853,106]],"To-day is a day of affliction, and reproach, and rebuke, and anger: for the pangs are come upon the travailing [woman], but she has not strength to bring forth."],["4",[["εἰσακούσαι",704108,172],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["τοὺς",709436,58],["λόγους",708236,57],["Ραψακου",711210,18],["οὓς",709781,298],["ἀπέστειλεν",701592,2],["βασιλεὺς",702580,4],["Ἀσσυρίων",702004,81],["ὀνειδίζειν",709655,55],["θεὸν",706192,6],["ζῶντα",705851,183],["καὶ",707031,7],["ὀνειδίζειν",709655,55],["λόγους",708236,57],["οὓς",709781,298],["ἤκουσεν",700587,2],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["καὶ",707031,7],["δεηθήσῃ",703394,364],["πρὸς",710844,0],["κύριον",707996,6],["τὸν",709436,5],["θεόν",706192,6],["σου",711945,133],["περὶ",710285,0],["τῶν",709436,80],["καταλελειμμένων",707305,445],["τούτων",709858,40]],"May the Lord thy God hear the words of Rabsaces, which the king of the Assyrians has sent, to reproach the living God, even to reproach with the words which the Lord thy God has heard: therefore thou shalt pray to thy Lord for these that are left."],["5",[["καὶ",707031,7],["ἦλθον",705453,150],["οἱ",709436,136],["παῖδες",709932,52],["τοῦ",709436,35],["βασιλέως",702580,18],["πρὸς",710844,0],["Ησαιαν",706026,6]],"So the servants of king Ezekias came to Esaias."],["6",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["Ησαιας",706026,4],["οὕτως",709859,28],["ἐρεῖτε",705415,337],["πρὸς",710844,0],["τὸν",709436,5],["κύριον",707996,6],["ὑμῶν",713091,145],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["μὴ",708851,28],["φοβηθῇς",713532,279],["ἀπὸ",701425,0],["τῶν",709436,80],["λόγων",708236,81],["ὧν",709781,252],["ἤκουσας",700587,162],["οὓς",709781,298],["ὠνείδισάν",709655,150],["με",708618,163],["οἱ",709436,136],["πρέσβεις",710733,52],["βασιλέως",702580,18],["Ἀσσυρίων",702004,81]],"And Esaias said to them, Thus shall ye say to your master, Thus saith the Lord, Be not thou afraid at the words which thou hast heard, wherewith the ambassadors of the king of the Assyrians have reproached me."],["7",[["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐμβαλῶ",704547,165],["εἰς",704105,0],["αὐτὸν",702165,85],["πνεῦμα",710566,25],["καὶ",707031,7],["ἀκούσας",700587,182],["ἀγγελίαν",700139,9],["ἀποστραφήσεται",701598,134],["εἰς",704105,0],["τὴν",709436,8],["χώραν",714011,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["πεσεῖται",710481,93],["μαχαίρᾳ",708593,1],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["αὐτοῦ",702165,102]],"Behold, I [will] send a blast upon him, and he shall hear a report, and return to his own country, and he shall fall by the sword in his own land."],["8",[["καὶ",707031,7],["ἀπέστρεψεν",701598,2],["Ραψακης",711210,4],["καὶ",707031,7],["κατέλαβεν",707300,2],["πολιορκοῦντα",710608,183],["τὸν",709436,5],["βασιλέα",702580,6],["Λομναν",708249,6],["καὶ",707031,7],["ἤκουσεν",700587,2],["βασιλεὺς",702580,4],["Ἀσσυρίων",702004,81],["ὅτι",709803,7]],"So Rabsaces returned, and found the king of the Assyrians besieging Lobna: for he had heard that he had departed from Lachis."],["9",[["ἐξῆλθεν",704909,2],["Θαρακα",706107,4],["βασιλεὺς",702580,4],["Αἰθιόπων",700420,81],["πολιορκῆσαι",710608,106],["αὐτόν",702165,85],["καὶ",707031,7],["ἀκούσας",700587,182],["ἀπέστρεψεν",701598,2],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["ἀγγέλους",700140,57],["πρὸς",710844,0],["Εζεκιαν",704044,6],["λέγων",708124,72]],"And Tharaca king of the Ethiopians went forth to attack him. And when he heard it, he turned aside, and sent messengers to Ezekias, saying,"],["10",[["οὕτως",709859,28],["ἐρεῖτε",705415,337],["Εζεκια",704044,114],["βασιλεῖ",702580,114],["τῆς",709436,16],["Ιουδαίας",706769,17],["μή",708851,28],["σε",711598,163],["ἀπατάτω",701364,31],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ἐφ᾿",705080,0],["ᾧ",709781,309],["πεποιθὼς",710221,270],["εἶ",704093,154],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["λέγων",708124,72],["οὐ",709805,28],["μὴ",708851,28],["παραδοθῇ",710014,384],["Ιερουσαλημ",706644,9],["εἰς",704105,0],["χεῖρας",713787,39],["βασιλέως",702580,18],["Ἀσσυρίων",702004,81]],"Thus shall ye say to Ezekias king of Judea, Let not thy God, in whom thou trustest, deceive thee, saying, Jerusalem shall not be delivered into the hand of the king of the Assyrians."],["11",[["ἢ",705924,7],["οὐκ",709805,28],["ἤκουσας",700587,162],["ἃ",709781,69],["ἐποίησαν",710582,150],["βασιλεῖς",702580,52],["Ἀσσυρίων",702004,81],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9],["ὡς",714148,28],["ἀπώλεσαν",701513,150]],"Hast thou not heard what the kings of the Assyrians have done, how they have destroyed the whole earth? and shalt thou be delivered?"],["12",[["μὴ",708851,28],["ἐρρύσαντο",711309,189],["αὐτοὺς",702165,62],["οἱ",709436,136],["θεοὶ",706192,52],["τῶν",709436,43],["ἐθνῶν",704068,44],["οὓς",709781,298],["οἱ",709436,136],["πατέρες",710189,52],["μου",709032,133],["ἀπώλεσαν",701513,150],["τήν",709436,8],["τε",712751,11],["Γωζαν",703214,9],["καὶ",707031,7],["Χαρραν",713750,9],["καὶ",707031,7],["Ραφες",711199,227],["αἵ",709781,256],["εἰσιν",704093,197],["ἐν",704639,0],["χώρᾳ",714011,1],["Θεμαδ",706179,184]],"Have the gods of the nations which my fathers destroyed delivered them, both Gozan, and Charrhan, and Rapheth, which are in the land of Theemath?"],["13",[["ποῦ",710706,28],["εἰσιν",704093,197],["οἱ",709436,136],["βασιλεῖς",702580,52],["Αιμαθ",700443,118],["καὶ",707031,7],["Αρφαθ",701831,118],["καὶ",707031,7],["πόλεως",710612,17],["Σεπφαριμ",711696,118],["Αναγ",700920,118],["Ουγαυα",709811,118]],"Where are the kings of Emath? and where [is the king of] Arphath? and where [is the king] of the city of Eppharuaim, [and of] Anagugana?"],["14",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Εζεκιας",704044,4],["τὸ",709436,24],["βιβλίον",702719,25],["παρὰ",709995,0],["τῶν",709436,80],["ἀγγέλων",700140,81],["καὶ",707031,7],["ἤνοιξεν",701186,2],["αὐτὸ",702165,129],["ἐναντίον",704654,0],["κυρίου",707996,18]],"And Ezekias received the letter from the messengers, and read it, and went up to the house of the Lord, and opened it before the Lord."],["15",[["καὶ",707031,7],["προσεύξατο",710893,23],["Εζεκιας",704044,4],["πρὸς",710844,0],["κύριον",707996,6],["λέγων",708124,72]],"And Ezekias prayed to the Lord, saying,"],["16",[["κύριε",707996,153],["σαβαωθ",711346,228],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ὁ",709436,3],["καθήμενος",707000,122],["ἐπὶ",705080,0],["τῶν",709436,80],["χερουβιν",713830,44],["σὺ",712181,164],["θεὸς",706192,4],["μόνος",709003,14],["εἶ",704093,154],["πάσης",710177,82],["βασιλείας",702577,17],["τῆς",709436,16],["οἰκουμένης",709517,422],["σὺ",712181,164],["ἐποίησας",710582,162],["τὸν",709436,5],["οὐρανὸν",709844,6],["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9]],"O Lord of hosts, God of Israel, who sittest upon the cherubs, thou alone art the God of every kingdom of the world: thou hast made heaven and earth."],["17",[["εἰσάκουσον",704108,176],["κύριε",707996,153],["εἴσβλεψον",704110,176],["κύριε",707996,153],["καὶ",707031,7],["ἰδὲ",709725,176],["τοὺς",709436,58],["λόγους",708236,57],["οὓς",709781,298],["ἀπέστειλεν",701592,2],["Σενναχηριμ",711693,4],["ὀνειδίζειν",709655,55],["θεὸν",706192,6],["ζῶντα",705851,183]],"Incline thine ear, O Lord, hearken, O Lord; open thine eyes, O Lord, look, O Lord: and behold the words of Sennacherim, which he has sent to reproach the living God."],["18",[["ἐπ᾿",705080,0],["ἀληθείας",700656,17],["γὰρ",702963,11],["ἠρήμωσαν",705421,150],["βασιλεῖς",702580,52],["Ἀσσυρίων",702004,81],["τὴν",709436,8],["οἰκουμένην",709517,173],["ὅλην",709597,36],["καὶ",707031,7],["τὴν",709436,8],["χώραν",714011,9],["αὐτῶν",702165,40]],"For of a truth, Lord, the kings of the Assyrians have laid waste the whole world, and the countries thereof,"],["19",[["καὶ",707031,7],["ἐνέβαλον",704547,150],["τὰ",709436,41],["εἴδωλα",704079,42],["αὐτῶν",702165,40],["εἰς",704105,0],["τὸ",709436,24],["πῦρ",711088,25],["οὐ",709805,28],["γὰρ",702963,11],["θεοὶ",706192,52],["ἦσαν",704093,137],["ἀλλὰ",700680,7],["ἔργα",705396,64],["χειρῶν",713787,65],["ἀνθρώπων",701163,81],["ξύλα",709427,64],["καὶ",707031,7],["λίθοι",708196,52],["καὶ",707031,7],["ἀπώλεσαν",701513,150],["αὐτούς",702165,71]],"and have cast their idols into the fire: for they were no gods, but the work of men's hands, wood and stone; and they have cast them away."],["20",[["σὺ",712181,164],["δέ",703303,11],["κύριε",707996,153],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["σῶσον",712627,176],["ἡμᾶς",705981,194],["ἐκ",704132,0],["χειρὸς",713787,17],["αὐτῶν",702165,40],["ἵνα",706747,7],["γνῷ",703105,172],["πᾶσα",710177,29],["βασιλεία",702577,12],["τῆς",709436,16],["γῆς",703083,17],["ὅτι",709803,7],["σὺ",712181,164],["εἶ",704093,154],["ὁ",709436,3],["θεὸς",706192,4],["μόνος",709003,14]],"But now, O Lord our God, deliver us from his hands, that every kingdom of the earth may know that thou art God alone."],["21",[["καὶ",707031,7],["ἀπεστάλη",701592,37],["Ησαιας",706026,4],["υἱὸς",713075,4],["Αμως",700898,18],["πρὸς",710844,0],["Εζεκιαν",704044,6],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ἤκουσα",700587,155],["ἃ",709781,69],["προσηύξω",710893,174],["πρός",710844,0],["με",708618,163],["περὶ",710285,0],["Σενναχηριμ",711693,18],["βασιλέως",702580,18],["Ἀσσυρίων",702004,81]],"And Esaias the son of Amos was sent to Ezekias, and said to him, Thus saith the Lord, the God of Israel, I have heard thy prayer to me concerning Sennacherim king of the Assyrians."],["22",[["οὗτος",709858,121],["ὁ",709436,3],["λόγος",708236,4],["ὃν",709781,112],["ἐλάλησεν",708071,2],["περὶ",710285,0],["αὐτοῦ",702165,102],["ὁ",709436,3],["θεός",706192,4],["ἐφαύλισέν",713394,2],["σε",711598,163],["καὶ",707031,7],["ἐμυκτήρισέν",709052,2],["σε",711598,163],["παρθένος",710148,12],["θυγάτηρ",706320,12],["Σιων",711816,17],["ἐπὶ",705080,0],["σοὶ",711925,159],["κεφαλὴν",707639,9],["ἐκίνησεν",707679,2],["θυγάτηρ",706320,12],["Ιερουσαλημ",706644,17]],"This is the word which God has spoken concerning him; The virgin daughter of Sion has despised thee, and mocked thee; the daughter of Jerusalem has shaken her head at thee."],["23",[["τίνα",712867,356],["ὠνείδισας",709655,162],["καὶ",707031,7],["παρώξυνας",710164,162],["ἢ",705924,7],["πρὸς",710844,0],["τίνα",712867,356],["ὕψωσας",713289,162],["τὴν",709436,8],["φωνήν",713640,9],["σου",711945,133],["καὶ",707031,7],["οὐκ",709805,28],["ἦρας",700473,162],["εἰς",704105,0],["ὕψος",713288,25],["τοὺς",709436,58],["ὀφθαλμούς",709870,57],["σου",711945,133],["εἰς",704105,0],["τὸν",709436,5],["ἅγιον",700159,27],["τοῦ",709436,35],["Ισραηλ",706839,18]],"Whom hast thou reproached and provoked? and against whom hast thou lifted up thy voice? and hast thou not lifted up thine eyes on high against the Holy One of Israel?"],["24",[["ὅτι",709803,7],["δι᾿",703417,0],["ἀγγέλων",700140,81],["ὠνείδισας",709655,162],["κύριον",707996,6],["σὺ",712181,164],["γὰρ",702963,11],["εἶπας",705373,162],["τῷ",709436,53],["πλήθει",710529,54],["τῶν",709436,43],["ἁρμάτων",701768,44],["ἐγὼ",704018,164],["ἀνέβην",700905,155],["εἰς",704105,0],["ὕψος",713288,25],["ὀρέων",709768,44],["καὶ",707031,7],["εἰς",704105,0],["τὰ",709436,41],["ἔσχατα",705519,68],["τοῦ",709436,35],["Λιβάνου",708185,18],["καὶ",707031,7],["ἔκοψα",707829,155],["τὸ",709436,24],["ὕψος",713288,25],["τῆς",709436,16],["κέδρου",707590,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὸ",709436,24],["κάλλος",707093,25],["τῆς",709436,16],["κυπαρίσσου",707982,17],["καὶ",707031,7],["εἰσῆλθον",704114,150],["εἰς",704105,0],["ὕψος",713288,25],["μέρους",708752,21],["τοῦ",709436,35],["δρυμοῦ",703836,18]],"For thou hast reproached the Lord by messengers; for thou hast said, With the multitude of chariots have I ascended to the height of mountains, and to the sides of Libanus; and I have cropped the height of his cedars and the beauty of his cypresses; and I entered into the height of the forest region:"],["25",[["καὶ",707031,7],["ἔθηκα",712849,155],["γέφυραν",703075,9],["καὶ",707031,7],["ἠρήμωσα",705421,155],["ὕδατα",713071,25],["καὶ",707031,7],["πᾶσαν",710177,36],["συναγωγὴν",712376,9],["ὕδατος",713071,21]],"and I have made a bridge, and dried up the waters, and every pool of water."],["26",[["οὐ",709805,28],["ταῦτα",709858,71],["ἤκουσας",700587,162],["πάλαι",709935,28],["ἃ",709781,69],["ἐγὼ",704018,164],["ἐποίησα",710582,155],["ἐξ",704132,0],["ἀρχαίων",701835,169],["ἡμερῶν",705984,65],["συνέταξα",712508,155],["νῦν",709384,28],["δὲ",703303,11],["ἐπέδειξα",705112,155],["ἐξερημῶσαι",704907,106],["ἔθνη",704068,42],["ἐν",704639,0],["ὀχυροῖς",709889,230],["καὶ",707031,7],["ἐνοικοῦντας",704772,235],["ἐν",704639,0],["πόλεσιν",710612,76],["ὀχυραῖς",709889,291]],"Hast thou not heard of these things which I did of old? I appointed [them] from ancient times; but now have I manifested [my purpose] of desolating nations in [their] strong holds, and them that dwell in strong cities."],["27",[["ἀνῆκα",701169,155],["τὰς",709436,38],["χεῖρας",713787,39],["καὶ",707031,7],["ἐξηράνθησαν",709419,99],["καὶ",707031,7],["ἐγένοντο",703104,189],["ὡς",714148,28],["χόρτος",713923,18],["ξηρὸς",709421,14],["ἐπὶ",705080,0],["δωμάτων",703896,44],["καὶ",707031,7],["ὡς",714148,28],["ἄγρωστις",700199,12]],"I weakened [their] hands, and they withered; and they became as dry grass on the house-tops, and as grass."],["28",[["νῦν",709384,28],["δὲ",703303,11],["τὴν",709436,8],["ἀνάπαυσίν",701026,9],["σου",711945,133],["καὶ",707031,7],["τὴν",709436,8],["ἔξοδόν",704948,9],["σου",711945,133],["καὶ",707031,7],["τὴν",709436,8],["εἴσοδόν",704119,9],["σου",711945,133],["ἐγὼ",704018,164],["ἐπίσταμαι",705264,254]],"But now I know thy rest, and thy going out, and thy coming in."],["29",[["ὁ",709436,3],["δὲ",703303,11],["θυμός",706334,4],["σου",711945,133],["ὃν",709781,112],["ἐθυμώθης",706335,168],["καὶ",707031,7],["ἡ",709436,10],["πικρία",710472,12],["σου",711945,133],["ἀνέβη",700905,2],["πρός",710844,0],["με",708618,163],["καὶ",707031,7],["ἐμβαλῶ",704547,165],["φιμὸν",713508,6],["εἰς",704105,0],["τὴν",709436,8],["ῥῖνά",711268,9],["σου",711945,133],["καὶ",707031,7],["χαλινὸν",713685,6],["εἰς",704105,0],["τὰ",709436,41],["χείλη",713781,42],["σου",711945,133],["κα