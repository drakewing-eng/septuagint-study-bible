[["1",[["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ᾄσονται",700299,135],["τὸ",709436,24],["ᾆσμα",701970,25],["τοῦτο",709858,129],["ἐπὶ",705080,0],["γῆς",703083,17],["Ιουδα",706768,18],["λέγοντες",708124,146],["ἰδοὺ",706497,88],["πόλις",710612,12],["ὀχυρά",709889,29],["καὶ",707031,7],["σωτήριον",712659,25],["ἡμῶν",705999,145],["θήσει",712849,127],["τεῖχος",712759,25],["καὶ",707031,7],["περίτειχος",710401,25]],"In that day they shall sing this song in the land of Judea; Behold a strong city; and he shall make salvation [its] wall and bulwark."],["2",[["ἀνοίξατε",701186,74],["πύλας",711082,39],["εἰσελθάτω",704114,45],["λαὸς",708094,4],["φυλάσσων",713619,72],["δικαιοσύνην",703695,9],["καὶ",707031,7],["φυλάσσων",713619,72],["ἀλήθειαν",700656,9]],"Open ye the gates, let the nation enter that keeps righteousness, and keeps truth,"],["3",[["ἀντιλαμβανόμενος",701243,122],["ἀληθείας",700656,17],["καὶ",707031,7],["φυλάσσων",713619,72],["εἰρήνην",704098,9],["ὅτι",709803,7],["ἐπὶ",705080,0],["σοὶ",711925,159]],"supporting truth, and keeping peace: for on thee, O Lord,"],["4",[["ἤλπισαν",704529,150],["κύριε",707996,153],["ἕως",705792,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["μέγας",708653,14],["ὁ",709436,3],["αἰώνιος",700505,14]],"they have trusted with confidence for ever, the great, the eternal God;"],["5",[["ὃς",709781,213],["ταπεινώσας",712717,182],["κατήγαγες",707232,162],["τοὺς",709436,58],["ἐνοικοῦντας",704772,235],["ἐν",704639,0],["ὑψηλοῖς",713285,230],["πόλεις",710612,39],["ὀχυρὰς",709889,119],["καταβαλεῖς",707203,166],["καὶ",707031,7],["κατάξεις",707232,166],["ἕως",705792,0],["ἐδάφους",704022,21]],"who hast humbled and brought down them that dwell on high, thou shalt cast down strong cities, and bring them to the ground."],["6",[["καὶ",707031,7],["πατήσουσιν",710187,218],["αὐτοὺς",702165,62],["πόδες",710707,52],["πραέων",710725,169],["καὶ",707031,7],["ταπεινῶν",712714,169]],"And the feet of the meek and lowly shall trample them."],["7",[["ὁδὸς",709458,12],["εὐσεβῶν",705687,169],["εὐθεῖα",705602,29],["ἐγένετο",703104,23],["καὶ",707031,7],["παρεσκευασμένη",710103,203],["ἡ",709436,10],["ὁδὸς",709458,12],["τῶν",709436,80],["εὐσεβῶν",705687,169]],"The way of the godly is made straight: the way of the godly is also prepared."],["8",[["ἡ",709436,10],["γὰρ",702963,11],["ὁδὸς",709458,12],["κυρίου",707996,18],["κρίσις",707908,12],["ἠλπίσαμεν",704529,289],["ἐπὶ",705080,0],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["καὶ",707031,7],["ἐπὶ",705080,0],["τῇ",709436,100],["μνείᾳ",708961,1]],"For the way of the Lord is judgment: we have hoped in thy name, and on the remembrance [of thee],"],["9",[["ᾗ",709781,108],["ἐπιθυμεῖ",705141,91],["ἡ",709436,10],["ψυχὴ",714070,12],["ἡμῶν",705999,145],["ἐκ",704132,0],["νυκτὸς",709386,17],["ὀρθρίζει",709742,91],["τὸ",709436,34],["πνεῦμά",710566,15],["μου",709032,133],["πρὸς",710844,0],["σέ",711598,163],["ὁ",709436,630],["θεός",706192,153],["διότι",703734,7],["φῶς",713642,15],["τὰ",709436,63],["προστάγματά",710959,64],["σου",711945,133],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["δικαιοσύνην",703695,9],["μάθετε",708480,74],["οἱ",709436,136],["ἐνοικοῦντες",704772,146],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"which our soul longs for: my spirit seeks thee very early in the morning, O God, for thy commandments are a light on the earth: learn righteousness, ye that dwell upon the earth."],["10",[["πέπαυται",710202,403],["γὰρ",702963,11],["ὁ",709436,3],["ἀσεβής",701909,14],["οὐ",709805,28],["μὴ",708851,28],["μάθῃ",708480,172],["δικαιοσύνην",703695,9],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ἀλήθειαν",700656,9],["οὐ",709805,28],["μὴ",708851,28],["ποιήσῃ",710582,172],["ἀρθήτω",700473,22],["ὁ",709436,3],["ἀσεβής",701909,14],["ἵνα",706747,7],["μὴ",708851,28],["ἴδῃ",709725,172],["τὴν",709436,8],["δόξαν",703791,9],["κυρίου",707996,18]],"For the ungodly one is put down: no one who will not learn righteousness on the earth, shall be able to do the truth: let the ungodly be taken away, that he see not the glory of the Lord."],["11",[["κύριε",707996,153],["ὑψηλός",713285,14],["σου",711945,133],["ὁ",709436,3],["βραχίων",702808,4],["καὶ",707031,7],["οὐκ",709805,28],["ᾔδεισαν",709492,263],["γνόντες",703105,196],["δὲ",703303,11],["αἰσχυνθήσονται",700485,144],["ζῆλος",705871,4],["λήμψεται",708076,93],["λαὸν",708094,6],["ἀπαίδευτον",701328,27],["καὶ",707031,7],["νῦν",709384,28],["πῦρ",711088,15],["τοὺς",709436,58],["ὑπεναντίους",713109,60],["ἔδεται",705495,93]],"O Lord, thine arm is exalted, yet they knew it not: but when they know they shall be ashamed: jealousy shall seize upon an untaught nation, and now fire shall devour the adversaries."],["12",[["κύριε",707996,153],["ὁ",709436,630],["θεὸς",706192,153],["ἡμῶν",705999,145],["εἰρήνην",704098,9],["δὸς",703654,176],["ἡμῖν",705994,90],["πάντα",710177,68],["γὰρ",702963,11],["ἀπέδωκας",701449,162],["ἡμῖν",705994,90]],"O Lord our God, give us peace: for thou hast rendered to us all things."],["13",[["κύριε",707996,153],["ὁ",709436,630],["θεὸς",706192,153],["ἡμῶν",705999,145],["κτῆσαι",707932,300],["ἡμᾶς",705981,194],["κύριε",707996,153],["ἐκτὸς",704339,0],["σοῦ",711945,133],["ἄλλον",700697,85],["οὐκ",709805,28],["οἴδαμεν",709492,314],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["ὀνομάζομεν",709667,243]],"O Lord our God, take possession of us: O Lord, we know not [any] other beside thee: we name thy name."],["14",[["οἱ",709436,136],["δὲ",703303,11],["νεκροὶ",709247,52],["ζωὴν",705910,9],["οὐ",709805,28],["μὴ",708851,28],["ἴδωσιν",709725,234],["οὐδὲ",709816,7],["ἰατροὶ",706459,52],["οὐ",709805,28],["μὴ",708851,28],["ἀναστήσωσιν",701173,234],["διὰ",703417,0],["τοῦτο",709858,129],["ἐπήγαγες",704994,162],["καὶ",707031,7],["ἀπώλεσας",701513,162],["καὶ",707031,7],["ἦρας",700473,162],["πᾶν",710177,46,27],["ἄρσεν",701818,46],["αὐτῶν",702165,40]],"But the dead shall not see life, neither shall physicians by any means raise [them] up: therefore thou hast brought [wrath] upon [them], and slain [them], and hast taken away every male of them. Bring more evils upon them, O Lord;"],["15",[["πρόσθες",710965,176],["αὐτοῖς",702165,151],["κακά",707066,68],["κύριε",707996,153],["πρόσθες",710965,176],["κακὰ",707066,68],["πᾶσιν",710177,230],["τοῖς",709436,147],["ἐνδόξοις",704694,230],["τῆς",709436,16],["γῆς",703083,17]],"bring more evils on the glorious ones of the earth."],["16",[["κύριε",707996,153],["ἐν",704639,0],["θλίψει",706276,1],["ἐμνήσθην",708960,156],["σου",711945,133],["ἐν",704639,0],["θλίψει",706276,1],["μικρᾷ",708915,101],["ἡ",709436,10],["παιδεία",709924,12],["σου",711945,133],["ἡμῖν",705994,90]],"Lord, in affliction I remembered thee; thy chastening was to us with small affliction."],["17",[["καὶ",707031,7],["ὡς",714148,28],["ἡ",709436,10],["ὠδίνουσα",714095,188],["ἐγγίζει",703939,91],["τοῦ",709436,20],["τεκεῖν",712853,106],["καὶ",707031,7],["ἐπὶ",705080,0],["τῇ",709436,100],["ὠδῖνι",714094,1],["αὐτῆς",702165,86],["ἐκέκραξεν",707868,2],["οὕτως",709859,28],["ἐγενήθημεν",703104,485],["τῷ",709436,113],["ἀγαπητῷ",700124,30],["σου",711945,133],["διὰ",703417,0],["τὸν",709436,5],["φόβον",713534,6],["σου",711945,133],["κύριε",707996,153]],"And as a woman in travail draws nigh to be delivered, [and] cries out in her pain; so have we been to thy beloved.",{"s":"d","q":0.7}],["18",[["ἐν",704639,0],["γαστρὶ",702976,1],["ἐλάβομεν",708076,289],["καὶ",707031,7],["ὠδινήσαμεν",714095,289],["καὶ",707031,7],["ἐτέκομεν",712853,289],["πνεῦμα",710566,25],["σωτηρίας",712658,17],["σου",711945,133],["ἐποιήσαμεν",710582,289],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ἀλλὰ",700680,7],["πεσοῦνται",710481,218],["οἱ",709436,136],["ἐνοικοῦντες",704772,146],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"We have conceived, O Lord, because of thy fear, and have been in pain, and have brought forth the breath of thy salvation, which we have wrought upon the earth: we shall not fall, but all that dwell upon the land shall fall."],["19",[["ἀναστήσονται",701173,135],["οἱ",709436,136],["νεκροί",709247,52],["καὶ",707031,7],["ἐγερθήσονται",703949,144],["οἱ",709436,136],["ἐν",704639,0],["τοῖς",709436,147],["μνημείοις",708963,96],["καὶ",707031,7],["εὐφρανθήσονται",705715,144],["οἱ",709436,136],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ἡ",709436,10],["γὰρ",702963,11],["δρόσος",703835,12],["ἡ",709436,10],["παρὰ",709995,0],["σοῦ",711945,133],["ἴαμα",706405,15],["αὐτοῖς",702165,151],["ἐστιν",704093,91],["ἡ",709436,10],["δὲ",703303,11],["γῆ",703083,12],["τῶν",709436,80],["ἀσεβῶν",701909,169],["πεσεῖται",710481,93]],"The dead shall rise, and they that are in the tombs shall be raised, and they that are in the earth shall rejoice: for the dew from thee is healing to them: but the land of the ungodly shall perish."],["20",[["βάδιζε",702367,240],["λαός",708094,4],["μου",709032,133],["εἴσελθε",704114,176],["εἰς",704105,0],["τὰ",709436,41],["ταμίειά",712700,42],["σου",711945,133],["ἀπόκλεισον",701484,176],["τὴν",709436,8],["θύραν",706337,9],["σου",711945,133],["ἀποκρύβηθι",701495,244],["μικρὸν",708915,27],["ὅσον",709788,27],["ὅσον",709788,27],["ἕως",705792,0],["ἂν",700900,11],["παρέλθῃ",710141,172],["ἡ",709436,10],["ὀργὴ",709728,12],["κυρίου",707996,18]],"Go, my people, enter into thy closets, shut thy door, hide thyself for a little season, until the anger of the Lord have passed away."],["21",[["ἰδοὺ",706497,88],["γὰρ",702963,11],["κύριος",707996,4],["ἀπὸ",701425,0],["τοῦ",709436,35],["ἁγίου",700159,116],["ἐπάγει",704994,91],["τὴν",709436,8],["ὀργὴν",709728,9],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἐνοικοῦντας",704772,235],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἀνακαλύψει",700968,127],["ἡ",709436,10],["γῆ",703083,12],["τὸ",709436,24],["αἷμα",700442,25],["αὐτῆς",702165,86],["καὶ",707031,7],["οὐ",709805,28],["κατακαλύψει",707260,127],["τοὺς",709436,58],["ἀνῃρημένους",700962,360]],"For, behold, the Lord is bringing wrath from [his] holy place upon the dwellers on the earth: the earth also shall disclose her blood, and shall not cover her slain."]]