]],"Will a woman forget her child, so as not to have compassion upon the offspring of her womb? but if a woman should even forget these, yet I will not forget thee, saith the Lord."],["16",[["ἰδοὺ",706497,88],["ἐπὶ",705080,0],["τῶν",709436,130],["χειρῶν",713787,65],["μου",709032,133],["ἐζωγράφησά",705903,155],["σου",711945,133],["τὰ",709436,41],["τείχη",712759,42],["καὶ",707031,7],["ἐνώπιόν",704823,0],["μου",709032,133],["εἶ",704093,154],["διὰ",703417,0],["παντός",710177,116]],"Behold, I have painted thy walls on my hands, and thou art continually before me."],["17",[["καὶ",707031,7],["ταχὺ",712748,661],["οἰκοδομηθήσῃ",709509,364],["ὑφ᾿",713184,0],["ὧν",709781,252],["καθῃρέθης",706982,168],["καὶ",707031,7],["οἱ",709436,136],["ἐρημώσαντές",705421,196],["σε",711598,163],["ἐκ",704132,0],["σοῦ",711945,133],["ἐξελεύσονται",704909,135]],"And thou shalt soon be built by those by whom thou wert destroyed, and they that made thee desolate shall go forth of thee."],["18",[["ἆρον",700473,176],["κύκλῳ",707959,114],["τοὺς",709436,58],["ὀφθαλμούς",709870,57],["σου",711945,133],["καὶ",707031,7],["ἰδὲ",709725,176],["πάντας",710177,60],["ἰδοὺ",706497,88],["συνήχθησαν",712375,99],["καὶ",707031,7],["ἤλθοσαν",705453,150],["πρὸς",710844,0],["σέ",711598,163],["ζῶ",705851,157],["ἐγώ",704018,164],["λέγει",708124,91],["κύριος",707996,4],["ὅτι",709803,7],["πάντας",710177,60],["αὐτοὺς",702165,62],["ἐνδύσῃ",704701,123],["καὶ",707031,7],["περιθήσῃ",710403,123],["αὐτοὺς",702165,62],["ὡς",714148,28],["κόσμον",707851,6],["νύμφης",709381,17]],"Lift up thine eyes round about, and look on them all; behold, they are gathered together, and are come to thee. [As] I live, saith the Lord, thou shalt clothe thyself with them all as with an ornament, and put them on as a bride her attire."],["19",[["ὅτι",709803,7],["τὰ",709436,63],["ἔρημά",705420,195],["σου",711945,133],["καὶ",707031,7],["τὰ",709436,63],["διεφθαρμένα",703624,370],["καὶ",707031,7],["τὰ",709436,63],["πεπτωκότα",710481,586],["νῦν",709384,28],[