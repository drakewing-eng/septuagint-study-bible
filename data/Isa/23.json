[["1",[["τὸ",709436,34],["ὅραμα",709720,15],["Τύρου",713028,18],["ὀλολύζετε",709593,335],["πλοῖα",710556,64],["Καρχηδόνος",707191,18],["ὅτι",709803,7],["ἀπώλετο",701513,23],["καὶ",707031,7],["οὐκέτι",709827,28],["ἔρχονται",705453,269],["ἐκ",704132,0],["γῆς",703083,17],["Κιτιαίων",707696,81],["ἦκται",700209,187],["αἰχμάλωτος",700503,14]],"The Word concerning Tyre. Howl, ye ships of Carthage; for she has perished, and [men] no longer arrive from the land of the Citians: she is led captive."],["2",[["τίνι",712867,432],["ὅμοιοι",709626,138],["γεγόνασιν",703104,353],["οἱ",709436,136],["ἐνοικοῦντες",704772,146],["ἐν",704639,0],["τῇ",709436,100],["νήσῳ",709302,1],["μεταβόλοι",708786,52],["Φοινίκης",713538,17],["διαπερῶντες",703543,146],["τὴν",709436,8],["θάλασσαν",706069,9]],"To whom are the dwellers in the island become like, the merchants of Phœnice, passing over the sea"],["3",[["ἐν",704639,0],["ὕδατι",713071,54],["πολλῷ",710646,97],["σπέρμα",712008,25],["μεταβόλων",708784,81],["ὡς",714148,28],["ἀμητοῦ",700819,18],["εἰσφερομένου",704127,262],["οἱ",709436,136],["μεταβόλοι",708786,52],["τῶν",709436,43],["ἐθνῶν",704068,44]],"in great waters, a generation of merchants? as when the harvest is gathered in, [so are] these traders with the nations."],["4",[["αἰσχύνθητι",700485,244],["Σιδών",711775,258],["εἶπεν",705373,2],["ἡ",709436,10],["θάλασσα",706069,12],["ἡ",709436,10],["δὲ",703303,11],["ἰσχὺς",706858,12],["τῆς",709436,16],["θαλάσσης",706069,17],["εἶπεν",705373,2],["οὐκ",709805,28],["ὤδινον",714095,155],["οὐδὲ",709816,7],["ἔτεκον",712853,155],["οὐδὲ",709816,7],["ἐξέθρεψα",704342,155],["νεανίσκους",709232,57],["οὐδὲ",709816,7],["ὕψωσα",713289,188],["παρθένους",710148,39]],"Be ashamed, O Sidon: the sea has said, yea, the strength of the sea has said, I have not travailed, nor brought forth, nor have I brought up young men, nor reared virgins."],["5",[["ὅταν",709801,28],["δὲ",703303,11],["ἀκουστὸν",700584,46],["γένηται",703104,239],["Αἰγύπτῳ",700401,1],["λήμψεται",708076,93],["αὐτοὺς",702165,62],["ὀδύνη",709463,12],["περὶ",710285,0],["Τύρου",713028,18]],"Moreover when it shall be heard in Egypt, sorrow shall seize them for Tyre."],["6",[["ἀπέλθατε",701398,74],["εἰς",704105,0],["Καρχηδόνα",707191,227],["ὀλολύξατε",709593,74],["οἱ",709436,136],["ἐνοικοῦντες",704772,146],["ἐν",704639,0],["τῇ",709436,100],["νήσῳ",709302,1],["ταύτῃ",709858,105]],"Depart ye to Carthage; howl, ye that dwell in this island."],["7",[["οὐχ",709805,28],["αὕτη",709858,107],["ἦν",704093,13],["ὑμῶν",713091,145],["ἡ",709436,10],["ὕβρις",713051,12],["ἡ",709436,10],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["πρὶν",710742,28],["ἢ",705924,7],["παραδοθῆναι",710014,179],["αὐτήν",702165,104]],"Was not this your pride from the beginning, before she was given up?"],["8",[["τίς",712867,158],["ταῦτα",709858,71],["ἐβούλευσεν",702791,2],["ἐπὶ",705080,0],["Τύρον",713028,6],["μὴ",708851,28],["ἥσσων",706042,14],["ἐστὶν",704093,91],["ἢ",705924,7],["οὐκ",709805,28],["ἰσχύει",706859,91],["οἱ",709436,136],["ἔμποροι",704614,52],["αὐτῆς",702165,86],["ἔνδοξοι",704694,138],["ἄρχοντες",701862,52],["τῆς",709436,16],["γῆς",703083,17]],"Who has devised this counsel against Tyre? Is she inferior? or has she no strength? her merchants were the glorious princes of the earth."],["9",[["κύριος",707996,4],["σαβαωθ",711346,228],["ἐβουλεύσατο",702791,23],["παραλῦσαι",710070,106],["πᾶσαν",710177,36],["τὴν",709436,8],["ὕβριν",713051,9],["τῶν",709436,80],["ἐνδόξων",704694,169],["καὶ",707031,7],["ἀτιμάσαι",702092,106],["πᾶν",710177,46,27],["ἔνδοξον",704694,27],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"The Lord of hosts has purposed to bring down all the pride of the glorious ones, and to disgrace every glorious thing on the earth."],["10",[["ἐργάζου",705383,253],["τὴν",709436,8],["γῆν",703083,9],["σου",711945,133],["καὶ",707031,7],["γὰρ",702963,11],["πλοῖα",710556,64],["οὐκέτι",709827,28],["ἔρχεται",705453,117],["ἐκ",704132,0],["Καρχηδόνος",707191,118]],"Till thy land; for ships no more come out of Carthage."],["11",[["ἡ",709436,10],["δὲ",703303,11],["χείρ",713787,12],["σου",711945,133],["οὐκέτι",709827,28],["ἰσχύει",706859,91],["κατὰ",707200,0],["θάλασσαν",706069,9],["ἡ",709436,10],["παροξύνουσα",710164,188],["βασιλεῖς",702580,57],["κύριος",707996,4],["σαβαωθ",711346,228],["ἐνετείλατο",704791,23],["περὶ",710285,0],["Χανααν",713708,118],["ἀπολέσαι",701513,106],["αὐτῆς",702165,86],["τὴν",709436,8],["ἰσχύν",706858,9]],"And thy hand prevails no more by sea, which troubled kings: the Lord of hosts has given a command concerning Chanaan, to destroy the strength thereof."],["12",[["καὶ",707031,7],["ἐροῦσιν",705415,218],["οὐκέτι",709827,7],["μὴ",708851,28],["προσθῆτε",710965,125],["τοῦ",709436,35],["ὑβρίζειν",713050,55],["καὶ",707031,7],["ἀδικεῖν",700269,55],["τὴν",709436,8],["θυγατέρα",706320,9],["Σιδῶνος",711775,17],["καὶ",707031,7],["ἐὰν",703912,7],["ἀπέλθῃς",701398,175],["εἰς",704105,0],["Κιτιεῖς",707697,303],["οὐδὲ",709816,7],["ἐκεῖ",704181,28],["σοι",711925,159],["ἀνάπαυσις",701026,12],["ἔσται",704093,93]],"And [men] shall say, Ye shall no longer at all continue to insult and injure the daughter of Sidon: and if thou depart to the Citians, neither there shalt thou have rest."],["13",[["καὶ",707031,7],["εἰς",704105,0],["γῆν",703083,9],["Χαλδαίων",713678,81],["καὶ",707031,7],["αὕτη",709858,107],["ἠρήμωται",705421,403],["ἀπὸ",701425,0],["τῶν",709436,80],["Ἀσσυρίων",702004,81],["οὐδὲ",709816,7],["ἐκεῖ",704181,28],["σοι",711925,159],["ἀνάπαυσις",701026,12],["ἔσται",704093,93],["ὅτι",709803,7],["ὁ",709436,3],["τοῖχος",712879,4],["αὐτῆς",702165,86],["πέπτωκεν",710481,171]],"And [if thou depart] to the land of the Chaldeans, this also is laid waste by the Assyrians, for her wall is fallen."],["14",[["ὀλολύζετε",709593,335],["πλοῖα",710556,64],["Καρχηδόνος",707191,118],["ὅτι",709803,7],["ἀπώλετο",701513,23],["τὸ",709436,24],["ὀχύρωμα",709891,25],["ὑμῶν",713091,145]],"Howl, ye ships of Carthage: for your strong hold is destroyed."],["15",[["καὶ",707031,7],["ἔσται",704093,93],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["καταλειφθήσεται",707305,134],["Τύρος",713028,4],["ἔτη",705543,42],["ἑβδομήκοντα",703922,59],["ὡς",714148,28],["χρόνος",713969,4],["βασιλέως",702580,18],["ὡς",714148,28],["χρόνος",713969,4],["ἀνθρώπου",701163,18],["καὶ",707031,7],["ἔσται",704093,93],["μετὰ",708780,0],["ἑβδομήκοντα",703922,59],["ἔτη",705543,42],["ἔσται",704093,93],["Τύρος",713028,4],["ὡς",714148,28],["ᾆσμα",701970,25],["πόρνης",710675,17]],"And it shall come to pass in that day, [that] Tyre shall be left seventy years, as the time of a king, as the time of a man: and it shall come to pass after seventy years, [that] Tyre shall be as the song of a harlot."],["16",[["λαβὲ",708076,240],["κιθάραν",707669,9],["ῥέμβευσον",711227,176],["πόλεις",710612,258],["πόρνη",710675,12],["ἐπιλελησμένη",705187,451],["καλῶς",707106,28],["κιθάρισον",707670,176],["πολλὰ",710646,68],["ᾆσον",700299,176],["ἵνα",706747,7],["σου",711945,133],["μνεία",708961,12],["γένηται",703104,239]],"Take a harp, go about, O city, thou harlot that hast been forgotten; play well on the harp, sing many [songs], that thou mayest be remembered."],["17",[["καὶ",707031,7],["ἔσται",704093,93],["μετὰ",708780,0],["ἑβδομήκοντα",703922,59],["ἔτη",705543,42],["ἐπισκοπὴν",705255,9],["ποιήσει",710582,127],["ὁ",709436,3],["θεὸς",706192,4],["Τύρου",713028,18],["καὶ",707031,7],["πάλιν",709942,28],["ἀποκατασταθήσεται",701470,134],["εἰς",704105,0],["τὸ",709436,24],["ἀρχαῖον",701835,46],["καὶ",707031,7],["ἔσται",704093,93],["ἐμπόριον",704613,25],["πάσαις",710177,291],["ταῖς",709436,75],["βασιλείαις",702577,76],["τῆς",709436,16],["οἰκουμένης",709517,422]],"And it shall come to pass after the seventy years, [that] God will visit Tyre, and she shall be again restored to her primitive state, and she shall be a mart for all the kingdoms of the world on the face of the earth."],["18",[["καὶ",707031,7],["ἔσται",704093,93],["αὐτῆς",702165,86],["ἡ",709436,10],["ἐμπορία",704612,12],["καὶ",707031,7],["ὁ",709436,3],["μισθὸς",708939,4],["ἅγιον",700159,27],["τῷ",709436,113],["κυρίῳ",707996,114],["οὐκ",709805,28],["αὐτοῖς",702165,151],["συναχθήσεται",712375,134],["ἀλλὰ",700680,7],["τοῖς",709436,147],["κατοικοῦσιν",707534,349],["ἔναντι",704653,28],["κυρίου",707996,18],["πᾶσα",710177,29],["ἡ",709436,10],["ἐμπορία",704612,12],["αὐτῆς",702165,86],["φαγεῖν",713296,106],["καὶ",707031,7],["πιεῖν",710478,106],["καὶ",707031,7],["ἐμπλησθῆναι",704592,179],["εἰς",704105,0],["συμβολὴν",712287,25],["μνημόσυνον",708966,25],["ἔναντι",704653,28],["κυρίου",707996,18]],"And her trade and her gain shall be holiness to the Lord: it shall not be gathered for them, but for those that dwell before the Lord, [even] all her trade, to eat and drink and be filled, and for a covenant [and] a memorial before the Lord."]]