ποιήσεται",710367,93],["καὶ",707031,7],["σώσει",712627,127]],"As birds flying, so shall the Lord of hosts defend; he shall defend Jerusalem, and he shall rescue, and save and deliver."],["6",[["ἐπιστράφητε",705278,372],["οἱ",709436,136],["τὴν",709436,8],["βαθεῖαν",702381,36],["βουλὴν",702792,9],["βουλευόμενοι",702791,348],["καὶ",707031,7],["ἄνομον",701194,36]],"Turn, ye children of Israel, who devise a deep and sinful counsel."],["7",[["ὅτι",709803,7],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἀπαρνήσονται",701356,135],["οἱ",709436,136],["ἄνθρωποι",701163,52],["τὰ",709436,41],["χειροποίητα",713796,68],["αὐτῶν",702165,40],["τὰ",709436,41],["ἀργυρᾶ",701705,68],["καὶ",707031,7],["τὰ",709436,41],["χρυσᾶ",713971,68],["ἃ",709781,69],["ἐποίησαν",710582,150],["αἱ",709436,190],["χεῖρες",713787,191],["αὐτῶν",702165,40]],"For in that day men shall renounce their silver idols and [their] golden idols, which their hands made."],["8",[["καὶ",707031,7],["πεσεῖται",710481,127],["Ασσουρ",702001,4],["οὐ",709805,28],["μάχαιρα",708593,12],["ἀνδρὸς",701150,18],["οὐδὲ",709816,7],["μάχαιρα",708593,12],["ἀνθρώπου",701163,18],["καταφάγεται",707519,93],["αὐτόν",702165,85],["καὶ",707031,7],["φεύξεται",713433,93],["οὐκ",709805,28],["ἀπὸ",701425,0],["προσώπου",710986,21],["μαχαίρας",708593,39],["οἱ",709436,136],["δὲ",703303,11],["νεανίσκοι",709232,52],["ἔσονται",704093,135],["εἰς",704105,0],["ἥττημα",706041,25]],"And the Assyrian shall fall: not the sword of a great man, nor the sword of a mean man shall devour him; neither shall he flee from the face of the sword: but the young men shall be overthrown:"],["9",[["πέτρᾳ",710443,1],["γὰρ",702963,11],["περιλημφθήσονται",710342,144],["ὡς",714148,28],["χάρακι",713729,114],["καὶ",707031,7],["ἡττηθήσονται",706040,144],["ὁ",709436,3],["δὲ",703303,11],["φεύγων",713433,72],["ἁλώσεται",700673,93],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["μακάριος",708397,14],["ὃς",709781,213],["ἔχει",705785,91],["ἐν",704639,0],["Σιων",711816,1],["σπέρμα",712008,25],["καὶ",707031,7],["οἰκείους",709493,60],["ἐν",704639,0],["Ιερουσαλημ",706644,1]],"for they shall be compassed with rocks as with a trench, and shall be worsted; and he that flees shall be taken. Thus saith the Lord, Blessed is he that has a seed in Sion, and household friends in Jerusalem."]]