[["1",[["ἰδοὺ",706497,88],["κύριος",707996,4],["καταφθείρει",707474,91],["τὴν",709436,8],["οἰκουμένην",709517,173],["καὶ",707031,7],["ἐρημώσει",705421,127],["αὐτὴν",702165,104],["καὶ",707031,7],["ἀνακαλύψει",700968,127],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτῆς",702165,86],["καὶ",707031,7],["διασπερεῖ",703584,127],["τοὺς",709436,58],["ἐνοικοῦντας",704772,235],["ἐν",704639,0],["αὐτῇ",702165,105]],"Behold, the Lord is about to lay waste the world, and will make it desolate, and will lay bare the surface of it, and scatter them that dwell therein."],["2",[["καὶ",707031,7],["ἔσται",704093,93],["ὁ",709436,3],["λαὸς",708094,4],["ὡς",714148,28],["ὁ",709436,3],["ἱερεὺς",706614,4],["καὶ",707031,7],["ὁ",709436,3],["παῖς",709932,4],["ὡς",714148,28],["ὁ",709436,3],["κύριος",707996,4],["καὶ",707031,7],["ἡ",709436,10],["θεράπαινα",706198,12],["ὡς",714148,28],["ἡ",709436,10],["κυρία",707993,12],["ἔσται",704093,93],["ὁ",709436,3],["ἀγοράζων",700184,72],["ὡς",714148,28],["ὁ",709436,3],["πωλῶν",711116,72],["καὶ",707031,7],["ὁ",709436,3],["δανείζων",703277,72],["ὡς",714148,28],["ὁ",709436,3],["δανειζόμενος",703277,466],["καὶ",707031,7],["ὁ",709436,3],["ὀφείλων",709865,72],["ὡς",714148,28],["ᾧ",709781,309],["ὀφείλει",709865,91]],"And the people shall be as the priest, and the servant as the lord, and the maid as the mistress; the buyer shall be as the seller, the lender as the borrower, and the debtor as his creditor."],["3",[["φθορᾷ",713451,1],["φθαρήσεται",713445,134],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["προνομῇ",710827,1],["προνομευθήσεται",710826,134],["ἡ",709436,10],["γῆ",703083,12],["τὸ",709436,34],["γὰρ",702963,11],["στόμα",712125,15],["κυρίου",707996,18],["ἐλάλησεν",708071,2],["ταῦτα",709858,71]],"The earth shall be completely laid waste, and the earth shall be utterly spoiled: for the mouth of the Lord has spoken these things."],["4",[["ἐπένθησεν",710251,2],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["ἐφθάρη",713445,37],["ἡ",709436,10],["οἰκουμένη",709517,211],["ἐπένθησαν",710251,150],["οἱ",709436,136],["ὑψηλοὶ",713285,138],["τῆς",709436,16],["γῆς",703083,17]],"The earth mourns, and the world is ruined, the lofty ones of the earth are mourning."],["5",[["ἡ",709436,10],["δὲ",703303,11],["γῆ",703083,12],["ἠνόμησεν",701190,2],["διὰ",703417,0],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["αὐτήν",702165,104],["διότι",703734,7],["παρέβησαν",709996,150],["τὸν",709436,5],["νόμον",709349,6],["καὶ",707031,7],["ἤλλαξαν",700683,150],["τὰ",709436,41],["προστάγματα",710959,42],["διαθήκην",703456,9],["αἰώνιον",700505,36]],"And she has sinned by reason of her inhabitants; because they have transgressed the law, and changed the ordinances, [even] the everlasting covenant."],["6",[["διὰ",703417,0],["τοῦτο",709858,129],["ἀρὰ",701665,12],["ἔδεται",705495,93],["τὴν",709436,8],["γῆν",703083,9],["ὅτι",709803,7],["ἡμάρτοσαν",700773,150],["οἱ",709436,136],["κατοικοῦντες",707534,146],["αὐτήν",702165,104],["διὰ",703417,0],["τοῦτο",709858,129],["πτωχοὶ",711076,52],["ἔσονται",704093,135],["οἱ",709436,136],["ἐνοικοῦντες",704772,146],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["καὶ",707031,7],["καταλειφθήσονται",707305,144],["ἄνθρωποι",701163,52],["ὀλίγοι",709568,138]],"Therefore a curse shall consume the earth, because the inhabitants thereof have sinned: therefore the dwellers in the earth shall be poor, and few men shall be left."],["7",[["πενθήσει",710251,127],["οἶνος",709530,4],["πενθήσει",710251,127],["ἄμπελος",700870,12],["στενάξουσιν",712066,218],["πάντες",710177,138],["οἱ",709436,136],["εὐφραινόμενοι",705715,348],["τὴν",709436,8],["ψυχήν",714070,9]],"The wine shall mourn, the vine shall mourn, all the merry-hearted shall sigh."],["8",[["πέπαυται",710202,187],["εὐφροσύνη",705717,12],["τυμπάνων",713019,44],["πέπαυται",710202,187],["αὐθάδεια",702124,12],["καὶ",707031,7],["πλοῦτος",710563,4],["ἀσεβῶν",701909,198],["πέπαυται",710202,187],["φωνὴ",713640,12],["κιθάρας",707669,17]],"The mirth of timbrels has ceased, the sound of the harp has ceased.",{"s":"d","q":0.55}],["9",[["ᾐσχύνθησαν",700485,99],["οὐκ",709805,28],["ἔπιον",710478,150],["οἶνον",709530,6],["πικρὸν",710475,27],["ἐγένετο",703104,23],["τὸ",709436,24],["σικερα",711781,25],["τοῖς",709436,147],["πίνουσιν",710478,197]],"They are ashamed, they have not drunk wine; strong drink has become bitter to them that drink [it]."],["10",[["ἠρημώθη",705421,37],["πᾶσα",710177,29],["πόλις",710612,12],["κλείσει",707710,127],["οἰκίαν",709505,9],["τοῦ",709436,35],["μὴ",708851,28],["εἰσελθεῖν",704114,106]],"All the city has become desolate: one shall shut his house so that none shall enter."],["11",[["ὀλολύζετε",709593,335],["περὶ",710285,0],["τοῦ",709436,35],["οἴνου",709530,18],["πανταχῇ",709976,28],["πέπαυται",710202,187],["πᾶσα",710177,29],["εὐφροσύνη",705717,12],["τῆς",709436,16],["γῆς",703083,17]],"There is a howling for the wine everywhere; all the mirth of the land has ceased, all the mirth of the land has departed.",{"s":"d","q":0.64}],["12",[["καὶ",707031,7],["καταλειφθήσονται",707305,144],["πόλεις",710612,191],["ἔρημοι",705420,191],["καὶ",707031,7],["οἶκοι",709516,52],["ἐγκαταλελειμμένοι",703967,429],["ἀπολοῦνται",701513,135]],"And cities shall be left desolate, and houses being left shall fall to ruin."],["13",[["ταῦτα",709858,132],["πάντα",710177,26],["ἔσται",704093,93],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ἐν",704639,0],["μέσῳ",708768,30],["τῶν",709436,43],["ἐθνῶν",704068,44],["ὃν",709781,112],["τρόπον",712980,6],["ἐάν",703912,7],["τις",712866,158],["καλαμήσηται",707078,239],["ἐλαίαν",704376,9],["οὕτως",709859,28],["καλαμήσονται",707078,135],["αὐτούς",702165,62],["καὶ",707031,7],["ἐὰν",703912,7],["παύσηται",710202,239],["ὁ",709436,3],["τρύγητος",712998,4]],"All this shall be in the land in the midst of the nations, as if one should strip an olive tree, so shall they strip them; but when the vintage is done,"],["14",[["οὗτοι",709858,201],["φωνῇ",713640,1],["βοήσονται",702743,135],["οἱ",709436,136],["δὲ",703303,11],["κατα