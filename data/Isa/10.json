[["1",[["οὐαὶ",709807,88],["τοῖς",709436,147],["γράφουσιν",703194,349],["πονηρίαν",710659,9],["γράφοντες",703194,146],["γὰρ",702963,11],["πονηρίαν",710659,9],["γράφουσιν",703194,349]],"Woe to them that write wickedness; for when they write they do write wickedness,"],["2",[["ἐκκλίνοντες",704220,146],["κρίσιν",707908,9],["πτωχῶν",711076,81],["ἁρπάζοντες",701804,146],["κρίμα",707903,25],["πενήτων",710248,81],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133],["ὥστε",714164,7],["εἶναι",704093,55],["αὐτοῖς",702165,151],["χήραν",713848,9],["εἰς",704105,0],["ἁρπαγὴν",701802,9],["καὶ",707031,7],["ὀρφανὸν",709779,27],["εἰς",704105,0],["προνομήν",710827,9]],"perverting the cause of the poor, violently wresting the judgment of the needy ones of my people, that the widow may be a prey to them, and the orphan a spoil."],["3",[["καὶ",707031,7],["τί",712867,126],["ποιήσουσιν",710582,218],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῆς",709436,16],["ἐπισκοπῆς",705255,17],["ἡ",709436,10],["γὰρ",702963,11],["θλῖψις",706276,12],["ὑμῖν",713084,90],["πόρρωθεν",710681,28],["ἥξει",705956,127],["καὶ",707031,7],["πρὸς",710844,0],["τίνα",712867,126],["καταφεύξεσθε",707472,124],["τοῦ",709436,35],["βοηθηθῆναι",702746,179],["καὶ",707031,7],["ποῦ",710706,28],["καταλείψετε",707305,337],["τὴν",709436,8],["δόξαν",703791,9],["ὑμῶν",713091,145]],"And what will they do in the day of visitation? for affliction shall come to you from afar: and to whom will ye flee for help? and where will ye leave your glory,"],["4",[["τοῦ",709436,20],["μὴ",708851,28],["ἐμπεσεῖν",704593,106],["εἰς",704105,0],["ἐπαγωγήν",704995,9],["ἐπὶ",705080,0],["πᾶσι",710177,230],["τούτοις",709858,151],["οὐκ",709805,28],["ἀπεστράφη",701598,37],["ὁ",709436,3],["θυμός",706334,4],["ἀλλ᾿",700680,7],["ἔτι",705538,28],["ἡ",709436,10],["χεὶρ",713787,12],["ὑψηλή",713285,29]],"that ye may not fall into captivity? For all this [his] wrath is not turned away, but [his] hand is yet exalted.",{"s":"d","q":0.56}],["5",[["οὐαὶ",709807,88],["Ἀσσυρίοις",702004,148],["ἡ",709436,10],["ῥάβδος",711135,12],["τοῦ",709436,35],["θυμοῦ",706334,18],["μου",709032,133],["καὶ",707031,7],["ὀργῆς",709728,17],["ἐστιν",704093,91],["ἐν",704639,0],["ταῖς",709436,75],["χερσὶν",713787,76],["αὐτῶν",702165,40]],"Woe to the Assyrians; the rod of my wrath, and anger are in their hands."],["6",[["τὴν",709436,8],["ὀργήν",709728,9],["μου",709032,133],["εἰς",704105,0],["ἔθνος",704068,25],["ἄνομον",701194,46],["ἀποστελῶ",701592,165],["καὶ",707031,7],["τῷ",709436,113],["ἐμῷ",704578,30],["λαῷ",708094,114],["συντάξω",712508,165],["ποιῆσαι",710582,106],["σκῦλα",711902,42],["καὶ",707031,7],["προνομὴν",710827,9],["καὶ",707031,7],["καταπατεῖν",707360,55],["τὰς",709436,38],["πόλεις",710612,39],["καὶ",707031,7],["θεῖναι",712849,106],["αὐτὰς",702165,231],["εἰς",704105,0],["κονιορτόν",707815,6]],"I will send my wrath against a sinful nation, and I will charge my people to take plunder and spoil, and to trample the cities, and to make them dust."],["7",[["αὐτὸς",702165,121],["δὲ",703303,11],["οὐχ",709805,28],["οὕτως",709859,28],["ἐνεθυμήθη",704739,37],["καὶ",707031,7],["τῇ",709436,100],["ψυχῇ",714070,1],["οὐχ",709805,28],["οὕτως",709859,28],["λελόγισται",708232,431],["ἀλλὰ",700680,7],["ἀπαλλάξει",701333,127],["ὁ",709436,3],["νοῦς",709374,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["τοῦ",709436,20],["ἔθνη",704068,42],["ἐξολεθρεῦσαι",704956,106],["οὐκ",709805,28],["ὀλίγα",709568,68]],"But he meant not thus, neither did he devise thus in his soul: but his mind shall change, and [that] to destroy nations not a few."],["8",[["καὶ",707031,7],["ἐὰν",703912,7],["εἴπωσιν",705373,234],["αὐτῷ",702165,50],["σὺ",712181,164],["μόνος",709003,14],["εἶ",704093,154],["ἄρχων",701862,4]],"And if they should say to him, Thou alone art ruler;"],["9",[["καὶ",707031,7],["ἐρεῖ",705415,127],["οὐκ",709805,28],["ἔλαβον",708076,155],["τὴν",709436,8],["χώραν",714011,9],["τὴν",709436,8],["ἐπάνω",705030,28],["Βαβυλῶνος",702352,17],["καὶ",707031,7],["Χαλαννη",713670,18],["οὗ",709806,28],["ὁ",709436,3],["πύργος",711092,4],["ᾠκοδομήθη",709509,37],["καὶ",707031,7],["ἔλαβον",708076,155],["Ἀραβίαν",701673,227],["καὶ",707031,7],["Δαμασκὸν",703275,6],["καὶ",707031,7],["Σαμάρειαν",711449,9]],"then shall he say, Have I not taken the country above Babylon and Chalanes, where the tower was built? and have I [not] taken Arabia, and Damascus, and Samaria?"],["10",[["ὃν",709781,112],["τρόπον",712980,6],["ταύτας",709858,231],["ἔλαβον",708076,155],["ἐν",704639,0],["τῇ",709436,100],["χειρί",713787,1],["μου",709032,133],["καὶ",707031,7],["πάσας",710177,119],["τὰς",709436,38],["ἀρχὰς",701836,39],["λήμψομαι",708076,181],["ὀλολύξατε",709593,74],["τὰ",709436,41],["γλυπτὰ",703117,68],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["ἐν",704639,0],["Σαμαρείᾳ",711449,1]],"As I have taken them, I will also take all the kingdoms: howl, ye idols in Jerusalem, and in Samaria."],["11",[["ὃν",709781,112],["τρόπον",712980,6],["γὰρ",702963,11],["ἐποίησα",710582,155],["Σαμαρείᾳ",711449,1],["καὶ",707031,7],["τοῖς",709436,147],["χειροποιήτοις",713796,230],["αὐτῆς",702165,86],["οὕτως",709859,28],["ποιήσω",710582,165],["καὶ",707031,7],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["τοῖς",709436,95],["εἰδώλοις",704079,96],["αὐτῆς",702165,86]],"For as I did to Samaria and her idols, so will I do also to Jerusalem and her idols."],["12",[["καὶ",707031,7],["ἔσται",704093,93],["ὅταν",709801,28],["συντελέσῃ",712510,777],["κύριος",707996,4],["πάντα",710177,27],["ποιῶν",710599,169],["ἐν",704639,0],["τῷ",709436,53],["ὄρει",709768,54],["Σιων",711816,9],["καὶ",707031,7],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["ἐπάξει",704994,127],["ἐπὶ",705080,0],["τὸν",709436,5],["νοῦν",709374,6],["τὸν",709436,5],["μέγαν",708653,27],["τὸν",709436,5],["ἄρχοντα",701862,6],["τῶν",709436,80],["Ἀσσυρίων",702004,81],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸ",709436,24],["ὕψος",713288,25],["τῆς",709436,16],["δόξης",703791,17],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["αὐτοῦ",702165,102]],"And it shall come to pass, when the Lord shall have finished doing all things on mount Sion and Jerusalem, [that] I will visit upon the proud heart, [even] upon the ruler of the Assyrians, and upon the boastful haughtiness of his eyes."],["13",[["εἶπεν",705373,2],["γάρ",702963,11],["τῇ",709436,105],["ἰσχύι",706858,1],["ποιήσω",710582,165],["καὶ",707031,7],["τῇ",709436,100],["σοφίᾳ",711981,1],["τῆς",709436,16],["συνέσεως",712460,17],["ἀφελῶ",702177,165],["ὅρια",709749,42],["ἐθνῶν",704068,44],["καὶ",707031,7],["τὴν",709436,8],["ἰσχὺν",706858,9],["αὐτῶν",702165,40],["προνομεύσω",710826,166],["καὶ",707031,7],["σείσω",711633,165],["πόλεις",710612,39],["κατοικουμένας",707534,312]],"For he said, I will act in strength, and in the wisdom of [my] understanding I will remove the boundaries of nations, and will spoil their strength."],["14",[["καὶ",707031,7],["τὴν",709436,8],["οἰκουμένην",709517,173],["ὅλην",709597,36],["καταλήμψομαι",707300,181],["τῇ",709436,100],["χειρὶ",713787,1],["ὡς",714148,28],["νοσσιὰν",709360,9],["καὶ",707031,7],["ὡς",714148,28],["καταλελειμμένα",707305,388],["ᾠὰ",714125,42],["ἀρῶ",700473,165],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ὃς",709781,213],["διαφεύξεταί",703623,93],["με",708618,163],["ἢ",705924,7],["ἀντείπῃ",701223,93],["μοι",708974,159]],"And I will shake the inhabited cities: and I will take with my hand all the world as a nest: and I will even take them as eggs that have been left; and there is none that shall escape me, or contradict me."],["15",[["μὴ",708851,28],["δοξασθήσεται",703792,134],["ἀξίνη",701306,12],["ἄνευ",701137,0],["τοῦ",709436,35],["κόπτοντος",707829,152],["ἐν",704639,0],["αὐτῇ",702165,105],["ἢ",705924,7],["ὑψωθήσεται",713289,134],["πρίων",710746,4],["ἄνευ",701137,0],["τοῦ",709436,35],["ἕλκοντος",704508,152],["αὐτόν",702165,85],["ὡσαύτως",714158,28],["ἐάν",703912,7],["τις",712866,158],["ἄρῃ",700473,172],["ῥάβδον",711135,9],["ἢ",705924,7],["ξύλον",709427,25]],"Shall the axe glorify itself without him that hews with it? or shall the saw lift up itself without him that uses it, as if one should lift a rod or staff? but it shall not be so;"],["16",[["καὶ",707031,7],["οὐχ",709805,28],["οὕτως",709859,28],["ἀλλὰ",700680,7],["ἀποστελεῖ",701592,127],["κύριος",707996,4],["σαβαωθ",711346,228],["εἰς",704105,0],["τὴν",709436,8],["σὴν",711943,36],["τιμὴν",712856,9],["ἀτιμίαν",702094,9],["καὶ",707031,7],["εἰς",704105,0],["τὴν",709436,8],["σὴν",711943,36],["δόξαν",703791,9],["πῦρ",711088,25],["καιόμενον",707049,212],["καυθήσεται",707049,134]],"but the Lord of hosts shall send dishonour upon thine honour, and burning fire shall be kindled upon thy glory."],["17",[["καὶ",707031,7],["ἔσται",704093,93],["τὸ",709436,34],["φῶς",713642,15],["τοῦ",709436,35],["Ισραηλ",706839,18],["εἰς",704105,0],["πῦρ",711088,25],["καὶ",707031,7],["ἁγιάσει",700153,127],["αὐτὸν",702165,85],["ἐν",704639,0],["πυρὶ",711088,54],["καιομένῳ",707049,241],["καὶ",707031,7],["φάγεται",713296,93],["ὡσεὶ",714159,28],["χόρτον",713923,25],["τὴν",709436,8],["ὕλην",713077,9],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105]],"And the light of Israel shall be for a fire, and he shall sanctify him with burning fire, and it shall devour the wood as grass."],["18",[["ἀποσβεσθήσεται",701567,134],["τὰ",709436,63],["ὄρη",709768,64],["καὶ",707031,7],["οἱ",709436,136],["βουνοὶ",702797,52],["καὶ",707031,7],["οἱ",709436,136],["δρυμοί",703836,52],["καὶ",707031,7],["καταφάγεται",707519,93],["ἀπὸ",701425,0],["ψυχῆς",714070,17],["ἕως",705792,7],["σαρκῶν",711537,65],["καὶ",707031,7],["ἔσται",704093,93],["ὁ",709436,3],["φεύγων",713433,72],["ὡς",714148,28],["ὁ",709436,3],["φεύγων",713433,72],["ἀπὸ",701425,0],["φλογὸς",713524,17],["καιομένης",707049,422]],"In that day the mountains shall be consumed, and the hills, and the forests, and [fire] shall devour [both] soul and body: and he that flees shall be as one fleeing from burning flame."],["19",[["καὶ",707031,7],["οἱ",709436,136],["καταλειφθέντες",707305,247],["ἀπ᾿",701425,0],["αὐτῶν",702165,40