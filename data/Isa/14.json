μμά",707259,25],["σου",711945,133],["σκώληξ",711905,4]],"Thy glory has come down to Hades, and thy great mirth: under thee they shall spread corruption, and the worm shall be thy covering."],["12",[["πῶς",711121,28],["ἐξέπεσεν",704284,2],["ἐκ",704132,0],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["ὁ",709436,3],["ἑωσφόρος",705793,4],["ὁ",709436,3],["πρωὶ",711021,28],["ἀνατέλλων",701066,72],["συνετρίβη",712520,37],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ὁ",709436,3],["ἀποστέλλων",701592,72],["πρὸς",710844,0],["πάντα",710177,68],["τὰ",709436,41],["ἔθνη",704068,42]],"How has Lucifer, that rose in the morning, fallen from heaven! He that sent [orders] to all the nations is crushed to the earth."],["13",[["σὺ",712181,164],["δὲ",703303,11],["εἶπας",705373,162],["ἐν",704639,0],["τῇ",709436,100],["διανοίᾳ",703531,1],["σου",711945,133],["εἰς",704105,0],["τὸν",709436,5],["οὐρανὸν",709844,6],["ἀναβήσομαι",700905,181],["ἐπάνω",705030,28],["τῶν",709436,43],["ἄστρων",702024,44],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["θήσω",712849,165],["τὸν",709436,5],["θρόνον",706315,6],["μου",709032,133],["καθιῶ",707006,165],["ἐν",704639,0],["ὄρει",709768,54],["ὑψηλῷ",713285,97],["ἐπὶ",705080,0],["τὰ",709436,41],["ὄρη",709768,42],["τὰ",709436,41],["ὑψηλὰ",713285,68],["τὰ",709436,41],["πρὸς",710844,0],["βορρᾶν",702765,6]],"But thou saidst in thine heart, I will go up to heaven, I will set my throne above the stars of heaven: I will sit on a lofty mount, on the lofty mountains toward the north:"],["14",[["ἀναβήσομαι",700905,181],["ἐπάνω",705030,28],["τῶν",709436,130],["νεφελῶν",709277,65],["ἔσομαι",704093,181],["ὅμοιος",709626,14],["τῷ",709436,113],["ὑψίστῳ",713287,30]],"I will go up above the clouds; I will be like the Most High."],["15",[["νῦν",709384,28],["δὲ",703303,11],["εἰς",704105,0],["ᾅδου",700255,18],["καταβήσῃ",707202,123],["καὶ",707031,7],["εἰς",704105,0],["τὰ",709436,41],["θεμέλια",706181,42],["τῆς",709436,16],["γῆς",703083,17]],"But now thou shalt go down to hell, even to the foundations of the earth."],["16",[["οἱ",709436,136],["ἰδόντες",709725,196],["σε",711598,163],["θαυμάσουσιν",706135,218],["ἐπὶ",705080,0],["σοὶ",711925,159],["καὶ",707031,7],["ἐροῦσιν",705415,218],["οὗτος",709858,121],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ὁ",709436,3],["παροξύνων",710164,72],["τὴν",709436,8],["γῆν",703083,9],["σείων",711633,72],["βασιλεῖς",702580,52]],"They that see thee shall wonder at thee, and say, This is the man that troubled the earth, that made kings to shake;"],["17",[["ὁ",709436,3],["θεὶς",712849,182],["τὴν",709436,8],["οἰκουμένην",709517,173],["ὅλην",709597,36],["ἔρημον",705420,9],["καὶ",707031,7],["τὰς",709436,38],["πόλεις",710612,39],["καθεῖλεν",706982,2],["τοὺς",709436,58],["ἐν",704639,0],["ἐπαγωγῇ",704995,1],["οὐκ",709805,28],["ἔλυσεν",708288,2]],"that made the whole world desolate, and destroyed its cities; he loosed not those who were in captivity."],["18",[["πάντες",710177,138],["οἱ",709436,136],["βασιλεῖς",702580,52],["τῶν",709436,43],["ἐθνῶν",704068,44],["ἐκοιμήθησαν",707767,99],["ἐν",704639,0],["τιμῇ",712856,1],["ἄνθρωπος",701163,4],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["αὐτοῦ",702165,102]],"All the kings of the nations lie in honour, [every] man in his house."],["19",[["σὺ",712181,164],["δὲ",703303,11],["ῥιφήσῃ",711267,364],["ἐν",704639,0],["τοῖς",709436,95],["ὄρεσιν",709768,96],["ὡς",714148,28],["νεκρὸς",709247,4],["ἐβδελυγμένος",702608,419],["μετὰ",708780,0],["πολλῶν",710646,169],["τεθνηκότων",706278,387],["ἐκκεκεντημένων",704211,445],["μαχαίραις",708593,76],["καταβαινόντων",707202,170],["εἰς",704105,0],["ᾅδου",700255,18],["ὃν",709781,112],["τρόπον",712980,6],["ἱμάτιον",706742,25],["ἐν",704639,0],["αἵματι",700442,54],["πεφυρμένον",713629,439],["οὐκ",709805,28],["ἔσται",704093,93],["καθαρόν",706988,27]],"But thou shalt be cast forth on the mountains, as a loathed carcase, with many dead who have been pierced with swords, going down to the grave."],["20",[["οὕτως",709859,28],["οὐδὲ",709816,7],["σὺ",712181,164],["ἔσῃ",704093,123],["καθαρός",706988,14],["διότι",703734,7],["τὴν",709436,8],["γῆν",703083,9],["μου",709032,133],["ἀπώλεσας",701513,162],["καὶ",707031,7],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["ἀπέκτεινας",701498,162],["οὐ",709805,28],["μὴ",708851,28],["μείνῃς",708736,175],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["χρόνον",713969,6],["σπέρμα",712008,25],["πονηρόν",710660,46]],"As a garment defiled with blood shall not be pure, so neither shalt thou be pure; because thou hast destroyed my land, and hast slain my people: thou shalt not endure for ever,—[thou] an evil seed."],["21",[["ἑτοίμασον",705539,176],["τὰ",709436,41],["τέκνα",712761,42],["σου",711945,133],["σφαγῆναι",712571,179],["ταῖς",709436,75],["ἁμαρτίαις",700775,76],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["ἵνα",706747,7],["μὴ",708851,28],["ἀναστῶσιν",701173,234],["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9],["κληρονομήσωσιν",707724,234],["καὶ",707031,7],["ἐμπλήσωσι",704592,234],["τὴν",709436,8],["γῆν",703083,9],["πόλεων",710612,65]],"Prepare thy children to be slain for the sins of their father; that they arise not, and inherit the earth, nor fill the earth with wars."],["22",[["καὶ",707031,7],["ἐπαναστήσομαι",705026,181],["αὐτοῖς",702165,151],["λέγει",708124,91],["κύριος",707996,4],["σαβαωθ",711346,228],["καὶ",707031,7],["ἀπολῶ",701513,165],["αὐτῶν",702165,40],["ὄνομα",709666,25],["καὶ",707031,7],["κατάλειμμα",707304,25],["καὶ",707031,7],["σπέρμα",712008,25],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4]],"And I will rise up against them, saith the Lord of hosts, and I will destroy their name, and remnant, and seed: thus saith the Lord."],["23",[["καὶ",707031,7],["θήσω",712849,165],["τὴν",709436,8],["Βαβυλωνίαν",702353,9],["ἔρημον",705420,9],["ὥστε",714164,7],["κατοικεῖν",707534,55],["ἐχίνους",705780,42],["καὶ",707031,7],["ἔσται",704093,93],["εἰς",704105,0],["οὐδέν",709817,46],["καὶ",707031,7],["θήσω",712849,165],["αὐτὴν",702165,104],["πηλοῦ",710457,18],["βάραθρον",702521,25],["εἰς",704105,0],["ἀπώλειαν",701660,9]],"And I will make the region of Babylon desert, so that hedgehogs shall dwell [there], and it shall come to nothing: and I will make it a pit of clay for destruction."],["24",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["σαβαωθ",711346,228],["ὃν",709781,85],["τρόπον",712980,6],["εἴρηκα",705415,89],["οὕτως",709859,28],["ἔσται",704093,93],["καὶ",707031,7],["ὃν",709781,112],["τρόπον",712980,6],["βεβούλευμαι",702791,326],["οὕτως",709859,28],["μενεῖ",708736,127]],"Thus saith the Lord of hosts, As I have said, so it shall be: and as I have purposed, so [the matter] shall remain:"],["25",[["τοῦ",709436,20],["ἀπολέσαι",701513,106],["τοὺς",709436,58],["Ἀσσυρίους",702004,57],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["τῆς",709436,16],["ἐμῆς",704578,82],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,43],["ὀρέων",709768,44],["μου",709032,133],["καὶ",707031,7],["ἔσονται",704093,135],["εἰς",704105,0],["καταπάτημα",707361,25],["καὶ",707031,7],["ἀφαιρεθήσεται",702177,134],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["ὁ",709436,3],["ζυγὸς",705894,4],["αὐτῶν",702165,40],["καὶ",707031,7],["τὸ",709436,34],["κῦδος",707952,15],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["τῶν",709436,80],["ὤμων",714114,81],["ἀφαιρεθήσεται",702177,134]],"[even] to destroy the Assyrians upon my land, and upon my mountains: and they shall be for trampling; and their yoke shall be taken away from them, and their glory shall be taken away from their shoulders."],["26",[["αὕτη",709858,107],["ἡ",709436,10],["βουλή",702792,12],["ἣν",709781,131],["βεβούλευται",702791,187],["κύριος",707996,4],["ἐπὶ",705080,0],["τὴν",709436,8],["οἰκουμένην",709517,173],["ὅλην",709597,36],["καὶ",707031,7],["αὕτη",709858,107],["ἡ",709436,10],["χεὶρ",713787,12],["ἡ",709436,10],["ὑψηλὴ",713285,29],["ἐπὶ",705080,0],["πάντα",710177,68],["τὰ",709436,41],["ἔθνη",704068,42],["τῆς",709436,16],["οἰκουμένης",709517,422]],"This is the purpose which the Lord has purposed upon the whole earth: and this the hand that is uplifted against all the nations."],["27",[["ἃ",709781,69],["γὰρ",702963,11],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["ἅγιος",700159,14],["βεβούλευται",702791,187],["τίς",712867,158],["διασκεδάσει",703575,127],["καὶ",707031,7],["τὴν",709436,8],["χεῖρα",713787,9],["τὴν",709436,8],["ὑψηλὴν",713285,36],["τίς",712867,158],["ἀποστρέψει",701598,127]],"For what the Holy God has purposed, who shall frustrate? and who shall turn back his uplifted hand?"],["28",[["τοῦ",709436,20],["ἔτους",705543,21],["οὗ",709781,160],["ἀπέθανεν",701461,2],["Αχαζ",702245,4],["ὁ",709436,3],["βασιλεύς",702580,4],["ἐγενήθη",703104,37],["τὸ",709436,34],["ῥῆμα",711246,15],["τοῦτο",709858,132]],"In the year in which king Achaz died this word came."],["29",[["μὴ",708851,28],["εὐφρανθείητε",705715,531],["πάντες",710177,138],["οἱ",709436,136],["ἀλλόφυλοι",700706,138],["συνετρίβη",712520,37],["γὰρ",702963,11],["ὁ",709436,3],["ζυγὸς",705894,4],["τοῦ",709436,35],["παίοντος",709933,152],["ὑμᾶς",713080,194],["ἐκ",704132,0],["γὰρ",702963,11],["σπέρματος",712008,21],["ὄφεων",709875,81],["ἐξελεύσεται",704909,93],["ἔκγονα",704159,68],["ἀσπίδων",701991,65],["καὶ",707031,7],["τὰ",709436,63],["ἔκγονα",704159,195],["αὐτῶν",702165,284],["ἐξελεύσονται",704909,135],["ὄφεις",709875,52],["πετόμενοι",710441,348]],"Rejoice not, all ye Philistines, because the yoke of him that smote you is broken: for out of the seed of the serpent shall come forth the young of asps, and their young shall come forth flying serpents."],["30",[["καὶ",707031,7],["βοσκηθήσονται",702767,144],["πτωχοὶ",711076,52],["δι᾿",703417,0],["αὐτοῦ",702165,102],["πτωχοὶ",711076,52],["δὲ",703303,11],["ἄνδρες",701150,52],["ἐπ᾿",705080,0],["εἰρήνης",704098,17],["ἀναπαύσονται",701027,135],["ἀνελεῖ",700962,127],["δὲ",703303,11],["λιμῷ",708210,114],["τὸ",709436,24],["σπέρμα",712008,25],["σου",711945,133],["καὶ",707031,7],["τὸ",709436,24],["κατάλειμμά",707304,25],["σου",711945,133],["ἀνελεῖ",700962,127]],"And the poor shall be fed by him, and poor men shall rest in peace: but he shall destroy thy seed with hunger, and shall destroy thy remnant."],["31",[["ὀλολύζετε",709593,335],["πύλαι",711082,191],["πόλεων",710612,65],["κεκραγέτωσαν",707868,779],["πόλεις",710612,191],["τεταραγμέναι",712721,423],["οἱ",709436,136],["ἀλλόφυλοι",700706,138],["πάντες",710177,138],["ὅτι",709803,7],["καπνὸς",707132,4],["ἀπὸ",701425,0],["βορρᾶ",702765,18],["ἔρχεται",705453,117],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["τοῦ",709436,20],["εἶναι",704093,55]],"Howl, ye gates of cities; let the cities be troubled and cry, [even] all the Philistines: for smoke is coming from the north, and there is no [possibility] of living."],["32",[["καὶ",707031,7],["τί",712867,126],["ἀποκριθήσονται",701492,144],["βασιλεῖς",702580,52],["ἐθνῶν",704068,44],["ὅτι",709803,7],["κύριος",707996,4],["ἐθεμελίωσεν",706182,2],["Σιων",711816,9],["καὶ",707031,7],["δι᾿",703417,0],["αὐτοῦ",702165,102],["σωθήσονται",712627,144],["οἱ",709436,136],["ταπεινοὶ",712714,138],["τοῦ",709436,35],["λαοῦ",708094,18]],"And what shall the kings of the nations answer? That the Lord has founded Sion, and by him the poor of the people shall be saved."]]