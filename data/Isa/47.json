[["1",[["κατάβηθι",707202,244],["κάθισον",707006,176],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["παρθένος",710148,12],["θυγάτηρ",706320,12],["Βαβυλῶνος",702352,17],["εἴσελθε",704114,176],["εἰς",704105,0],["τὸ",709436,24],["σκότος",711889,25],["θυγάτηρ",706320,12],["Χαλδαίων",713678,81],["ὅτι",709803,7],["οὐκέτι",709827,28],["προστεθήσῃ",710965,364],["κληθῆναι",707084,179],["ἁπαλὴ",701336,29],["καὶ",707031,7],["τρυφερά",713006,29]],"Come down, sit on the ground, O virgin daughter of Babylon: sit on the ground, O daughter of the Chaldeans: for thou shalt no more be called tender and luxurious."],["2",[["λαβὲ",708076,176],["μύλον",709056,6],["ἄλεσον",700655,176],["ἄλευρον",700653,25],["ἀποκάλυψαι",701474,300],["τὸ",709436,24],["κατακάλυμμά",707259,25],["σου",711945,133],["ἀνακάλυψαι",700968,176],["τὰς",709436,38],["πολιάς",710607,39],["ἀνάσυραι",701062,176],["τὰς",709436,38],["κνήμας",707750,39],["διάβηθι",703419,244],["ποταμούς",710693,57]],"Take a millstone, grind meal: remove thy veil, uncover thy white hairs, make bare the leg, pass through the rivers."],["3",[["ἀνακαλυφθήσεται",700968,134],["ἡ",709436,10],["αἰσχύνη",700483,12],["σου",711945,133],["φανήσονται",713311,144],["οἱ",709436,136],["ὀνειδισμοί",709657,52],["σου",711945,133],["τὸ",709436,24],["δίκαιον",703694,46],["ἐκ",704132,0],["σοῦ",711945,133],["λήμψομαι",708076,181],["οὐκέτι",709827,28],["μὴ",708851,28],["παραδῶ",710014,207],["ἀνθρώποις",701163,148]],"Thy shame shall be uncovered, thy reproaches shall be brought to light: I will exact of thee due vengeance, I will no longer deliver thee to men."],["4",[["εἶπεν",705373,2],["ὁ",709436,3],["ῥυσάμενός",711309,122],["σε",711598,163],["κύριος",707996,4],["σαβαωθ",711346,228],["ὄνομα",709666,15],["αὐτῷ",702165,50],["ἅγιος",700159,14],["Ισραηλ",706839,18]],"Thy deliverer is the Lord of hosts, the Holy One of Israel is his name."],["5",[["κάθισον",707006,176],["κατανενυγμένη",707347,451],["εἴσελθε",704114,176],["εἰς",704105,0],["τὸ",709436,24],["σκότος",711889,25],["θυγάτηρ",706320,12],["Χαλδαίων",713678,81],["οὐκέτι",709827,28],["μὴ",708851,28],["κληθῇς",707084,279],["ἰσχὺς",706858,12],["βασιλείας",702577,17]],"Sit thou down pierced with woe, go into darkness, O daughter of the Chaldeans: thou shalt no more be called the strength of a kingdom."],["6",[["παρωξύνθην",710164,156],["ἐπὶ",705080,0],["τῷ",709436,113],["λαῷ",708094,114],["μου",709032,133],["ἐμίανας",708900,162],["τὴν",709436,8],["κληρονομίαν",707725,9],["μου",709032,133],["ἐγὼ",704018,164],["ἔδωκα",703654,155],["εἰς",704105,0],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133],["σὺ",712181,164],["δὲ",703303,11],["οὐκ",709805,28],["ἔδωκας",703654,162],["αὐτοῖς",702165,151],["ἔλεος",704426,25],["τοῦ",709436,35],["πρεσβυτέρου",710735,18],["ἐβάρυνας",702553,162],["τὸν",709436,5],["ζυγὸν",705894,6],["σφόδρα",712586,28]],"I have been provoked with my people; thou hast defiled mine inheritance: I gave them into thy hand, but thou didst not extend mercy to them: thou madest the yoke of the aged man very heavy,"],["7",[["καὶ",707031,7],["εἶπας",705373,162],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἔσομαι",704093,181],["ἄρχουσα",701860,188],["οὐκ",709805,28],["ἐνόησας",709327,162],["ταῦτα",709858,71],["ἐν",704639,0],["τῇ",709436,100],["καρδίᾳ",707141,1],["σου",711945,133],["οὐδὲ",709816,7],["ἐμνήσθης",708923,168],["τὰ",709436,41],["ἔσχατα",705519,68]],"and saidst, I shall be a princess for ever: thou didst not perceive these things in thine heart, nor didst thou remember the latter end."],["8",[["νῦν",709384,28],["δὲ",703303,11],["ἄκουσον",700587,176],["ταῦτα",709858,71],["ἡ",709436,10],["τρυφερὰ",713006,29],["ἡ",709436,10],["καθημένη",707000,211],["πεποιθυῖα",710221,287],["ἡ",709436,10],["λέγουσα",708124,188],["ἐν",704639,0],["τῇ",709436,100],["καρδίᾳ",707141,1],["αὐτῆς",702165,86],["ἐγώ",704018,164],["εἰμι",704093,157],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἑτέρα",705535,68],["οὐ",709805,28],["καθιῶ",707006,165],["χήρα",713848,12],["οὐδὲ",709816,7],["γνώσομαι",703105,181],["ὀρφανείαν",709778,9]],"But now hear these words, thou luxurious one, [who art] the one that sits [at ease], that is secure, that says in her heart, I am, and there is not another; I shall not sit a widow, neither shall I know bereavement."],["9",[["νῦν",709384,28],["δὲ",703303,11],["ἥξει",705956,127],["ἐξαίφνης",704842,28],["ἐπὶ",705080,0],["σὲ",711598,163],["τὰ",709436,63],["δύο",703849,59],["ταῦτα",709858,290],["ἐν",704639,0],["μιᾷ",704106,101],["ἡμέρᾳ",705984,1],["χηρεία",713849,12],["καὶ",707031,7],["ἀτεκνία",702079,12],["ἥξει",705956,127],["ἐξαίφνης",704842,28],["ἐπὶ",705080,0],["σὲ",711598,163],["ἐν",704639,0],["τῇ",709436,100],["φαρμακείᾳ",713368,1],["σου",711945,133],["ἐν",704639,0],["τῇ",709436,100],["ἰσχύι",706858,1],["τῶν",709436,80],["ἐπαοιδῶν",705035,81],["σου",711945,133],["σφόδρα",712586,28]],"But now these two things shall come upon thee suddenly in one day, the loss of children and widowhood shall come suddenly upon thee, for thy sorcery, for the strength of thine enchantments,"],["10",[["τῇ",709436,100],["ἐλπίδι",704530,1],["τῆς",709436,16],["πονηρίας",710659,17],["σου",711945,133],["σὺ",712181,164],["γὰρ",702963,11],["εἶπας",705373,162],["ἐγώ",704018,164],["εἰμι",704093,157],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἑτέρα",705535,68],["γνῶθι",703105,176],["ὅτι",709803,7],["ἡ",709436,10],["σύνεσις",712460,12],["τούτων",709858,70],["καὶ",707031,7],["ἡ",709436,10],["πορνεία",710672,12],["σου",711945,133],["ἔσται",704093,93],["σοι",711925,159],["αἰσχύνη",700483,12],["καὶ",707031,7],["εἶπας",705373,162],["τῇ",709436,100],["καρδίᾳ",707141,1],["σου",711945,133],["ἐγώ",704018,164],["εἰμι",704093,157],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἑτέρα",705535,68]],"for thy trusting in wickedness: for thou saidst, I am, and there is not another: know thou, the understanding of these things and thy harlotry shall be thy shame; for thou saidst in thy heart, I am, and there is not another."],["11",[["καὶ",707031,7],["ἥξει",705956,127],["ἐπὶ",705080,0],["σὲ",711598,163],["ἀπώλεια",701660,12],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["γνῷς",703105,175],["βόθυνος",702750,4],["καὶ",707031,7],["ἐμπεσῇ",704593,123],["εἰς",704105,0],["αὐτόν",702165,85],["καὶ",707031,7],["ἥξει",705956,127],["ἐπὶ",705080,0],["σὲ",711598,163],["ταλαιπωρία",712695,12],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["δυνήσῃ",703838,123],["καθαρὰ",706988,68],["γενέσθαι",703104,109],["καὶ",707031,7],["ἥξει",705956,127],["ἐπὶ",705080,0],["σὲ",711598,163],["ἐξαπίνης",704869,28],["ἀπώλεια",701660,12],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["γνῷς",703105,175]],"And destruction shall come upon thee, and thou shalt not be aware; [there shall be] a pit, and thou shalt fall into it: and grief shall come upon thee, and thou shalt not be able to be clear; and destruction shall come suddenly upon thee, and thou shalt not know."],["12",[["στῆθι",706846,176],["νῦν",709384,28],["ἐν",704639,0],["ταῖς",709436,75],["ἐπαοιδαῖς",705034,76],["σου",711945,133],["καὶ",707031,7],["τῇ",709436,100],["πολλῇ",710646,101],["φαρμακείᾳ",713368,1],["σου",711945,133],["ἃ",709781,69],["ἐμάνθανες",708480,363],["ἐκ",704132,0],["νεότητός",709258,17],["σου",711945,133],["εἰ",704071,11],["δυνήσῃ",703838,123],["ὠφεληθῆναι",714171,179]],"Stand now with thine enchantments, and with the abundance of thy sorcery, which thou hast learned from thy youth; if thou canst be profited."],["13",[["κεκοπίακας",707824,266],["ἐν",704639,0],["ταῖς",709436,75],["βουλαῖς",702792,76],["σου",711945,133],["στήτωσαν",706846,264],["καὶ",707031,7],["σωσάτωσάν",712627,264],["σε",711598,163],["οἱ",709436,136],["ἀστρολόγοι",702023,52],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["οἱ",709436,136],["ὁρῶντες",709725,146],["τοὺς",709436,58],["ἀστέρας",702017,57],["ἀναγγειλάτωσάν",700921,264],["σοι",711925,159],["τί",712867,126],["μέλλει",708705,91],["ἐπὶ",705080,0],["σὲ",711598,163],["ἔρχεσθαι",705453,110]],"Thou art wearied in thy counsels. Let now the astrologers of the heaven stand and deliver thee, let them that see the stars tell thee what is about to come upon thee."],["14",[["ἰδοὺ",706497,88],["πάντες",710177,138],["ὡς",714148,28],["φρύγανα",713601,42],["ἐπὶ",705080,0],["πυρὶ",711088,54],["κατακαήσονται",707258,144],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἐξέλωνται",704838,232],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτῶν",702165,40],["ἐκ",704132,0],["φλογός",713524,17],["ὅτι",709803,7],["ἔχεις",705785,154],["ἄνθρακας",701160,57],["πυρός",711088,21],["κάθισαι",707006,106],["ἐπ᾿",705080,0],["αὐτούς",702165,62]],"Behold, they all shall be burnt up as sticks in the fire; neither shall they at all deliver their life from the flame. Because thou hast coals of fire, sit thou upon them;"],["15",[["οὗτοι",709858,201],["ἔσονταί",704093,135],["σοι",711925,159],["βοήθεια",702745,12],["ἐκοπίασας",707824,162],["ἐν",704639,0],["τῇ",709436,100],["μεταβολῇ",708784,1],["σου",711945,133],["ἐκ",704132,0],["νεότητος",709258,17],["ἄνθρωπος",701163,4],["καθ᾿",707200,0],["ἑαυτὸν",703917,85],["ἐπλανήθη",710495,37],["σοὶ",711925,159],["δὲ",703303,11],["οὐκ",709805,28],["ἔσται",704093,93],["σωτηρία",712658,12]],"these shall be thy help. Thou hast wearied thyself with traffic from thy youth: every man has wandered to his own home, but thou shalt have no deliverance."]]