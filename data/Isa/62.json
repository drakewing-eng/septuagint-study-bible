[["1",[["διὰ",703417,0],["Σιων",711816,17],["οὐ",709805,28],["σιωπήσομαι",711818,181],["καὶ",707031,7],["διὰ",703417,0],["Ιερουσαλημ",706644,17],["οὐκ",709805,28],["ἀνήσω",701169,165],["ἕως",705792,7],["ἂν",700900,11],["ἐξέλθῃ",704909,172],["ὡς",714148,11],["φῶς",713642,25],["ἡ",709436,10],["δικαιοσύνη",703695,12],["μου",709032,133],["τὸ",709436,34],["δὲ",703303,11],["σωτήριόν",712659,15],["μου",709032,133],["ὡς",714148,11],["λαμπὰς",708079,12],["καυθήσεται",707049,134]],"For Sion's sake I will not hold my peace, and for Jerusalem's sake I will not rest, until her righteousness go forth as light, and my salvation burn as a torch."],["2",[["καὶ",707031,7],["ὄψονται",709725,135],["ἔθνη",704068,64],["τὴν",709436,8],["δικαιοσύνην",703695,9],["σου",711945,133],["καὶ",707031,7],["βασιλεῖς",702580,52],["τὴν",709436,8],["δόξαν",703791,9],["σου",711945,133],["καὶ",707031,7],["καλέσει",707084,127],["σε",711598,163],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["τὸ",709436,24],["καινόν",707042,46],["ὃ",709781,128],["ὁ",709436,3],["κύριος",707996,4],["ὀνομάσει",709667,127],["αὐτό",702165,129]],"And the Gentiles shall see thy righteousness, and kings thy glory: and one shall call thee [by] a new name, which the Lord shall name."],["3",[["καὶ",707031,7],["ἔσῃ",704093,123],["στέφανος",712083,4],["κάλλους",707093,21],["ἐν",704639,0],["χειρὶ",713787,1],["κυρίου",707996,18],["καὶ",707031,7],["διάδημα",703447,15],["βασιλείας",702577,17],["ἐν",704639,0],["χειρὶ",713787,1],["θεοῦ",706192,18],["σου",711945,133]],"And thou shalt be a crown of beauty in the hand of the Lord, and a royal diadem in the hand of thy God."],["4",[["καὶ",707031,7],["οὐκέτι",709827,28],["κληθήσῃ",707084,364],["καταλελειμμένη",707305,203],["καὶ",707031,7],["ἡ",709436,10],["γῆ",703083,12],["σου",711945,133],["οὐ",709805,28],["κληθήσεται",707084,134],["ἔρημος",705420,29],["σοὶ",711925,159],["γὰρ",702963,11],["κληθήσεται",707084,134],["θέλημα",706170,15],["ἐμόν",704578,27],["καὶ",707031,7],["τῇ",709436,100],["γῇ",703083,1],["σου",711945,133],["οἰκουμένη",709517,211]],"And thou shalt no more be called Forsaken; and thy land shall no more be called Desert: for thou shalt be called My Pleasure, and thy land Inhabited: for the Lord has taken pleasure in thee, and thy land shall be inhabited.",{"s":"d","q":0.68}],["5",[["καὶ",707031,7],["ὡς",714148,11],["συνοικῶν",712493,72],["νεανίσκος",709232,4],["παρθένῳ",710148,1],["οὕτως",709859,28],["κατοικήσουσιν",707534,218],["οἱ",709436,136],["υἱοί",713075,52],["σου",711945,133],["μετὰ",708780,0],["σοῦ",711945,133],["καὶ",707031,7],["ἔσται",704093,93],["ὃν",709781,112],["τρόπον",712980,6],["εὐφρανθήσεται",705715,134],["νυμφίος",709382,4],["ἐπὶ",705080,0],["νύμφῃ",709381,1],["οὕτως",709859,28],["εὐφρανθήσεται",705715,134],["κύριος",707996,4],["ἐπὶ",705080,0],["σοί",711925,159]],"And as a young man lives with a virgin, so shall thy sons dwell in [thee]: and it shall come to pass [that] as a bridegroom will rejoice over a bride, so will the Lord rejoice over thee."],["6",[["καὶ",707031,7],["ἐπὶ",705080,0],["τῶν",709436,43],["τειχέων",712759,44],["σου",711945,133],["Ιερουσαλημ",706644,258],["κατέστησα",707011,155],["φύλακας",713616,57],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["καὶ",707031,7],["ὅλην",709597,36],["τὴν",709436,8],["νύκτα",709386,9],["οἳ",709781,250],["διὰ",703417,0],["τέλους",712787,21],["οὐ",709805,28],["σιωπήσονται",711818,135],["μιμνῃσκόμενοι",708923,348],["κυρίου",707996,18]],"And on thy walls, O Jerusalem, have I set watchmen all day and all night, who shall never cease making mention of the Lord."],["7",[["οὐκ",709805,28],["ἔστιν",704093,91],["γὰρ",702963,11],["ὑμῖν",713084,90],["ὅμοιος",709626,14],["ἐὰν",703912,7],["διορθώσῃ",703728,172],["καὶ",707031,7],["ποιήσῃ",710582,172],["Ιερουσαλημ",706644,9],["ἀγαυρίαμα",700131,25],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"For there is none like you, when he shall have established, and made Jerusalem a praise on the earth."],["8",[["ὤμοσεν",709620,2],["κύριος",707996,4],["κατὰ",707200,0],["τῆς",709436,16],["δεξιᾶς",703360,82],["αὐτοῦ",702165,102],["καὶ",707031,7],["κατὰ",707200,0],["τῆς",709436,16],["ἰσχύος",706858,17],["τοῦ",709436,35],["βραχίονος",702808,18],["αὐτοῦ",702165,102],["εἰ",704071,7],["ἔτι",705538,28],["δώσω",703654,165],["τὸν",709436,5],["σῖτόν",711814,6],["σου",711945,133],["καὶ",707031,7],["τὰ",709436,41],["βρώματά",702823,42],["σου",711945,133],["τοῖς",709436,147],["ἐχθροῖς",705779,148],["σου",711945,133],["καὶ",707031,7],["εἰ",704071,7],["ἔτι",705538,28],["πίονται",710478,135],["υἱοὶ",713075,52],["ἀλλότριοι",700699,138],["τὸν",709436,5],["οἶνόν",709530,6],["σου",711945,133],["ἐφ᾿",705080,0],["ᾧ",709781,309],["ἐμόχθησας",709037,162]],"For the Lord has sworn by his glory, and by the might of his arm, I will no more give thy corn and thy provisions to thine enemies; nor shall strangers any more drink thy wine, for which thou hast laboured."],["9",[["ἀλλ᾿",700680,7],["ἢ",705924,7],["οἱ",709436,136],["συνάγοντες",712375,146],["φάγονται",713296,135],["αὐτὰ",702165,71],["καὶ",707031,7],["αἰνέσουσιν",700459,218],["κύριον",707996,6],["καὶ",707031,7],["οἱ",709436,136],["συνάγοντες",712375,146],["πίονται",710478,135],["αὐτὰ",702165,71],["ἐν",704639,0],["ταῖς",709436,75],["ἐπαύλεσιν",705048,76],["ταῖς",709436,75],["ἁγίαις",700159,291],["μου",709032,133]],"But they that have gathered them shall eat them, and they shall praise the Lord; and they that have gathered [the grapes] shall drink thereof in my holy courts."],["10",[["πορεύεσθε",710667,374],["διὰ",703417,0],["τῶν",709436,130],["πυλῶν",711082,65],["μου",709032,133],["καὶ",707031,7],["ὁδοποιήσατε",709456,74],["τῷ",709436,113],["λαῷ",708094,114],["μου",709032,133],["καὶ",707031,7],["τοὺς",709436,58],["λίθους",708196,57],["τοὺς",709436,58],["ἐκ",704132,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["διαρρίψατε",703567,74],["ἐξάρατε",704839,74],["σύσσημον",712555,25],["εἰς",704105,0],["τὰ",709436,41],["ἔθνη",704068,42]],"Go through my gates, and make a way for my people; and cast the stones out of the way; lift up a standard for the Gentiles."],["11",[["ἰδοὺ",706497,88],["γὰρ",702963,11],["κύριος",707996,4],["ἐποίησεν",710582,2],["ἀκουστὸν",700584,27],["ἕως",705792,7],["ἐσχάτου",705519,116],["τῆς",709436,16],["γῆς",703083,17],["εἴπατε",705373,74],["τῇ",709436,100],["θυγατρὶ",706320,1],["Σιων",711816,17],["ἰδού",706497,88],["σοι",711925,159],["ὁ",709436,3],["σωτὴρ",712657,4],["παραγίνεται",710006,117],["ἔχων",705785,72],["τὸν",709436,5],["ἑαυτοῦ",703917,102],["μισθὸν",708939,6],["καὶ",707031,7],["τὸ",709436,24],["ἔργον",705396,25],["πρὸ",710747,0],["προσώπου",710986,21],["αὐτοῦ",702165,102]],"For behold, the Lord has proclaimed to the end of the earth, say ye to the daughter of Sion, Behold, thy Saviour has come to thee, having his reward and his work before his face."],["12",[["καὶ",707031,7],["καλέσει",707084,127],["αὐτὸν",702165,85],["λαὸν",708094,6],["ἅγιον",700159,27],["λελυτρωμένον",708282,439],["ὑπὸ",713184,0],["κυρίου",707996,18],["σὺ",712181,164],["δὲ",703303,11],["κληθήσῃ",707084,364],["ἐπιζητουμένη",705135,211],["πόλις",710612,12],["καὶ",707031,7],["οὐκ",709805,28],["ἐγκαταλελειμμένη",703967,203]],"And one shall call them the holy people, the redeemed of the Lord: and thou shalt be called a city sought out, and not forsaken."]]