[["1",[["ἐγὼ",704018,164],["ἀνὴρ",701150,4],["ὁ",709436,3],["βλέπων",702740,72],["πτωχείαν",711073,9],["ἐν",704639,0],["ῥάβδῳ",711135,1],["θυμοῦ",706334,18],["αὐτοῦ",702165,102],["ἐπ᾿",705080,0],["ἐμέ",704555,163]],"Aleph. I am the man that sees poverty, through the rod of his wrath upon me."],["2",[["παρέλαβέν",710059,2],["με",708618,163],["καὶ",707031,7],["ἀπήγαγεν",701324,2],["εἰς",704105,0],["σκότος",711889,6],["καὶ",707031,7],["οὐ",709805,28],["φῶς",713642,25]],"He has taken me, and led me away into darkness, and not [into] light."],["3",[["πλὴν",710540,28],["ἐν",704639,0],["ἐμοὶ",704577,159],["ἐπέστρεψεν",705278,2],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9]],"Nay, against me has he turned his hand all the day."],["4",[["ἐπαλαίωσεν",709937,2],["σάρκας",711537,39],["μου",709032,133],["καὶ",707031,7],["δέρμα",703363,25],["μου",709032,133],["ὀστέα",709792,42],["μου",709032,133],["συνέτριψεν",712520,2]],"He has made old my flesh and my skin; he has broken my bones."],["5",[["ἀνῳκοδόμησεν",701187,2],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["ἐκύκλωσεν",707958,2],["κεφαλήν",707639,9],["μου",709032,133],["καὶ",707031,7],["ἐμόχθησεν",709037,2]],"Beth. He has built against me, and compassed my head, and brought travail [upon me]."],["6",[["ἐν",704639,0],["σκοτεινοῖς",711885,230],["ἐκάθισέν",707006,2],["με",708618,163],["ὡς",714148,7],["νεκροὺς",709247,57],["αἰῶνος",700504,18]],"He has set me in dark places, as them that have long been dead."],["7",[["ἀνῳκοδόμησεν",701187,2],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["οὐκ",709805,28],["ἐξελεύσομαι",704909,181],["ἐβάρυνεν",702553,2],["χαλκόν",713695,6],["μου",709032,133]],"He has builded against me, and I cannot come forth: he has made my brazen [chain] heavy."],["8",[["καί",707031,7],["γε",702985,11],["κεκράξομαι",707868,181],["καὶ",707031,7],["βοήσω",702743,165],["ἀπέφραξεν",701636,2],["προσευχήν",710892,9],["μου",709032,133]],"Gimel. Yea, [though] I cry and shout, he shuts out my prayer."],["9",[["ἀνῳκοδόμησεν",701187,2],["ὁδούς",709458,39],["μου",709032,133],["ἐνέφραξεν",704635,2],["τρίβους",712939,39],["μου",709032,133],["ἐτάραξεν",712721,2]],"Daleth. He has built up my ways, he has hedged my paths;"],["10",[["ἄρκος",701766,4],["ἐνεδρεύουσα",704703,188],["αὐτός",702165,121],["μοι",708974,159],["λέων",708171,4],["ἐν",704639,0],["κρυφαίοις",707927,230]],"he has troubled me, [as] a she-bear lying in wait: he is to me [as] a lion in secret places."],["11",[["κατεδίωξεν",707243,2],["ἀφεστηκότα",702214,427],["καὶ",707031,7],["κατέπαυσέν",707365,2],["με",708618,163],["ἔθετό",712849,23],["με",708618,163],["ἠφανισμένην",702182,639]],"He pursued [me] after I departed, and brought me to a stand: he has utterly ruined me."],["12",[["ἐνέτεινεν",704790,2],["τόξον",712898,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐστήλωσέν",712094,2],["με",708618,163],["ὡς",714148,7],["σκοπὸν",711877,6],["εἰς",704105,0],["βέλος",702644,25]],"He. He has bent his bow, and set me as a mark for the arrow."],["13",[["εἰσήγαγεν",704107,2],["τοῖς",709436,147],["νεφροῖς",709282,148],["μου",709032,133],["ἰοὺς",706764,57],["φαρέτρας",713364,17],["αὐτοῦ",702165,102]],"He has caused the arrows of his quiver to enter into my reins."],["14",[["ἐγενήθην",703104,156],["γέλως",703032,4],["παντὶ",710177,30],["λαῷ",708094,114],["μου",709032,133],["ψαλμὸς",714022,4],["αὐτῶν",702165,40],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9]],"I became a laughing-stock to all my people; and their song all the day."],["15",[["ἐχόρτασέν",713919,2],["με",708618,163],["πικρίας",710472,17],["ἐμέθυσέν",708676,2],["με",708618,163],["χολῆς",713900,17]],"Vau. He has filled me with bitterness, he has drenched me with gall."],["16",[["καὶ",707031,7],["ἐξέβαλεν",704145,2],["ψήφῳ",714052,1],["ὀδόντας",709461,57],["μου",709032,133],["ἐψώμισέν",714077,2],["με",708618,163],["σποδόν",712022,9]],"And he has dashed out my teeth with gravel, he has fed me with ashes."],["17",[["καὶ",707031,7],["ἀπώσατο",701659,23],["ἐξ",704132,0],["εἰρήνης",704098,17],["ψυχήν",714070,9],["μου",709032,133],["ἐπελαθόμην",705187,161],["ἀγαθὰ",700106,68]],"He has also removed my soul from peace: I forgot prosperity."],["18",[["καὶ",707031,7],["εἶπα",705373,155],["ἀπώλετο",701513,2],["νεῖκός",709246,25],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["ἐλπίς",704530,12],["μου",709032,133],["ἀπὸ",701425,0],["κυρίου",707996,18]],"Therefore my success has perished, and my hope from the Lord."],["19",[["ἐμνήσθην",708960,156],["ἀπὸ",701425,0],["πτωχείας",711073,17],["μου",709032,133],["καὶ",707031,7],["ἐκ",704132,0],["διωγμοῦ",703766,18],["μου",709032,133],["πικρίας",710472,17],["καὶ",707031,7],["χολῆς",713900,17],["μου",709032,133]],"Zain. I remembered by reason of my poverty, and because of persecution my bitterness and gall shall be remembered;"],["20",[["μνησθήσεται",708923,134],["καὶ",707031,7],["καταδολεσχήσει",707244,127],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133]],"and my soul shall meditate with me."],["21",[["ταύτην",709858,104],["τάξω",712730,165],["εἰς",704105,0],["τὴν",709436,8],["καρδίαν",707141,9],["μου",709032,133],["διὰ",703417,0],["τοῦτο",709858,129],["ὑπομενῶ",713219,165]],"This will I lay up in my heart, therefore will I endure."],["25",[["ἀγαθὸς",700106,14],["κύριος",707996,4],["τοῖς",709436,147],["ὑπομένουσιν",713219,197],["αὐτόν",702165,85],["ψυχῇ",714070,1],["ἣ",709781,177],["ζητήσει",705879,127],["αὐτὸν",702165,85],["ἀγαθὸν",700106,27]],"Teth. The Lord is good to them that wait for him: the soul which shall seek him"],["26",[["καὶ",707031,7],["ὑπομενεῖ",713219,127],["καὶ",707031,7],["ἡσυχάσει",706033,2],["εἰς",704105,0],["τὸ",709436,24],["σωτήριον",712659,25],["κυρίου",707996,18]],"[is] good, and shall wait for, and quietly expect salvation of the Lord."],["27",[["ἀγαθὸν",700106,27],["ἀνδρὶ",701150,114],["ὅταν",709801,28],["ἄρῃ",700473,172],["ζυγὸν",705894,25],["ἐν",704639,0],["νεότητι",709258,1],["αὐτοῦ",702165,102]],"Teth. [It is] good for a man when he bears a yoke in his youth."],["28",[["καθήσεται",707000,93],["κατὰ",707200,0],["μόνας",709003,119],["καὶ",707031,7],["σιωπήσεται",711818,93],["ὅτι",709803,7],["ἦρεν",700473,2],["ἐφ᾿",705080,0],["ἑαυτῷ",703917,50]],"He will sit alone, and be silent, because he has borne [it] upon him."],["30",[["δώσει",703654,127],["τῷ",709436,113],["παίοντι",709933,379],["αὐτὸν",702165,85],["σιαγόνα",711763,6],["χορτασθήσεται",713919,134],["ὀνειδισμῶν",709657,81]],"Jod. He will give [his] cheek to him that smites him: he will be filled full with reproaches."],["31",[["ὅτι",709803,7],["οὐκ",709805,28],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἀπώσεται",701659,93],["κύριος",707996,4]],"For the Lord will not reject for ever."],["32",[["ὅτι",709803,7],["ὁ",709436,3],["ταπεινώσας",712717,182],["οἰκτιρήσει",709518,127],["κατὰ",707200,0],["τὸ",709436,24],["πλῆθος",710529,25],["τοῦ",709436,35],["ἐλέους",704426,18],["αὐτοῦ",702165,102]],"Chaph. For he that has brought down will pity, and [that] according to the abundance of his mercy."],["33",[["ὅτι",709803,7],["οὐκ",709805,28],["ἀπεκρίθη",701492,37],["ἀπὸ",701425,0],["καρδίας",707141,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐταπείνωσεν",712717,2],["υἱοὺς",713075,57],["ἀνδρός",701150,18]],"He has not answered [in anger] from his heart, though he has brought low the children of a man."],["34",[["τοῦ",709436,20],["ταπεινῶσαι",712717,106],["ὑπὸ",713184,0],["τοὺς",709436,58],["πόδας",710707,57],["αὐτοῦ",702165,102],["πάντας",710177,60],["δεσμίους",703371,57],["γῆς",703083,17]],"Lamed. To bring down under his feet all the prisoners of the earth,"],["35",[["τοῦ",709436,20],["ἐκκλῖναι",704220,106],["κρίσιν",707908,9],["ἀνδρὸς",701150,18],["κατέναντι",707507,28],["προσώπου",710986,21],["ὑψίστου",713287,116]],"to turn aside the judgment of a man before the face of the Most High,"],["36",[["καταδικάσαι",707241,106],["ἄνθρωπον",701163,6],["ἐν",704639,0],["τῷ",709436,53],["κρίνεσθαι",707905,110],["αὐτὸν",702165,85],["κύριος",707996,4],["οὐκ",709805,28],["εἶπεν",705373,2]],"to condemn a man [unjustly] in his judgment, the Lord has not given commandment."],["37",[["τίς",712867,158],["οὕτως",709859,28],["εἶπεν",705373,2],["καὶ",707031,7],["ἐγενήθη",703104,37],["κύριος",707996,4],["οὐκ",709805,28],["ἐνετείλατο",704791,23]],"Who has thus spoken, and it has come to pass? the Lord has not commanded it."],["38",[["ἐκ",704132,0],["στόματος",712125,21],["ὑψίστου",713287,116],["οὐκ",709805,28],["ἐξελεύσεται",704909,93],["τὰ",709436,41],["κακὰ",707066,68],["καὶ",707031,7],["τὸ",709436,24],["ἀγαθόν",700106,46]],"Out of the mouth of the Most High there shall not come forth evil and good."],["39",[["τί",712867,126],["γογγύσει",703144,127],["ἄνθρωπος",701163,4],["ζῶν",705851,72],["ἀνὴρ",701150,4],["περὶ",710285,0],["τῆς",709436,16],["ἁμαρτίας",700775,17],["αὐτοῦ",702165,102]],"Mem. Why should a living man complain, a man concerning his sin?"],["40",[["ἐξηρευνήθη",704905,37],["ἡ",709436,10],["ὁδὸς",709458,12],["ἡμῶν",705999,145],["καὶ",707031,7],["ἠτάσθη",705526,37],["καὶ",707031,7],["ἐπιστρέψωμεν",705278,79],["ἕως",705792,7],["κυρίου",707996,18]],"Nun. Our way has been searched out and examined, and we will turn to the Lord."],["41",[["ἀναλάβωμεν",700984,79],["καρδίας",707141,39],["ἡμῶν",705999,145],["ἐπὶ",705080,0],["χειρῶν",713787,65],["πρὸς",710844,0],["ὑψηλὸν",713285,27],["ἐν",704639,0],["οὐρανῷ",709844,114]],"Let us lift up our hearts with [our] hands to the lofty One in heaven."],["42",[["ἡμαρτήσαμεν",700773,289],["ἠσεβήσαμεν",701906,289],["καὶ",707031,7],["οὐχ",709805,28],["ἱλάσθης",706728,168]],"We have sinned, we have transgressed; and thou hast not pardoned."],["43",[["ἐπεσκέπασας",705249,162],["ἐν",704639,0],["θυμῷ",706334,114],["καὶ",707031,7],["ἀπεδίωξας",701450,162],["ἡμᾶς",705981,194],["ἀπέκτεινας",701498,162],["οὐκ",709805,28],["ἐφείσω",713406,174]],"Samech. Thou hast visited [us] in wrath, and driven us away: thou hast slain, thou hast not pitied."],["44",[["ἐπεσκέπασας",705249,162],["νεφέλην",709277,9],["σεαυτῷ",711599,50],["εἵνεκεν",704709,28],["προσευχῆς",710892,17]],"Thou hast veiled thyself with a cloud because of prayer, that I might be blind,"],["45",[["καμμύσαι",707114,106],["με",708618,163],["καὶ",707031,7],["ἀπωσθῆναι",701659,109],["ἔθηκας",712849,162],["ἡμᾶς",705981,194],["ἐν",704639,0],["μέσῳ",708768,30],["τῶν",709436,80],["λαῶν",708094,81]],"and be cast off. Ain. Thou hast set us [alone] in the midst of the nations."],["46",[["διήνοιξαν",703532,150],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["τὸ",709436,24],["στόμα",712125,25],["αὐτῶν",702165,40],["πάντες",710177,138],["οἱ",709436,136],["ἐχθροὶ",705779,138],["ἡμῶν",705999,145]],"All our enemies have opened their mouth against us."],["47",[["φόβος",713534,4],["καὶ",707031,7],["θυμὸς",706334,4],["ἐγενήθη",703104,37],["ἡμῖν",705994,90],["ἔπαρσις",705041,12],["καὶ",707031,7],["συντριβή",712519,12]],"Fear and wrath are come upon us, suspense and destruction."],["48",[["ἀφέσεις",702199,191],["ὑδάτων",713071,44],["κατάξει",707232,127],["ὁ",709436,3],["ὀφθαλμός",709870,4],["μου",709032,133],["ἐπὶ",705080,0],["τὸ",709436,24],["σύντριμμα",712521,25],["τῆς",709436,16],["θυγατρὸς",706320,17],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133]],"Mine eye shall pour down torrents of water, for the destruction of the daughter of my people."],["49",[["ὁ",709436,3],["ὀφθαλμός",709870,4],["μου",709032,133],["κατεπόθη",707374,37],["καὶ",707031,7],["οὐ",709805,28],["σιγήσομαι",711767,181],["τοῦ",709436,20],["μὴ",708851,28],["εἶναι",704093,55],["ἔκνηψιν",704266,9]],"Phe. Mine eye is drowned [with tears], and I will not be silent, so that there shall be no rest,"],["50",[["ἕως",705792,7],["οὗ",709781,48],["διακύψῃ",703491,172],["καὶ",707031,7],["ἴδῃ",709725,172],["κύριος",707996,4],["ἐξ",704132,0],["οὐρανοῦ",709844,18]],"until the Lord look down, and behold from heaven."],["51",[["ὁ",709436,3],["ὀφθαλμός",709870,4],["μου",709032,133],["ἐπιφυλλιεῖ",705325,127],["ἐπὶ",705080,0],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["παρὰ",709995,0],["πάσας",710177,119],["θυγατέρας",706320,39],["πόλεως",710612,17]],"Mine eye shall prey upon my soul, because of all the daughters of the city."],["52",[["θηρεύοντες",706248,146],["ἐθήρευσάν",706248,150],["με",708618,163],["ὡς",714148,7],["στρουθίον",712166,15],["οἱ",709436,136],["ἐχθροί",705779,138],["μου",709032,133],["δωρεάν",703901,9]],"Tsade. The fowlers chased me as a sparrow, all mine enemies destroyed my life in a pit without cause,"],["53",[["ἐθανάτωσαν",706097,150],["ἐν",704639,0],["λάκκῳ",708067,114],["ζωήν",705910,9],["μου",709032,133],["καὶ",707031,7],["ἐπέθηκαν",705304,150],["λίθον",708196,6],["ἐπ᾿",705080,0],["ἐμοί",704577,159]],"and laid a stone upon me."],["54",[["ὑπερεχύθη",713170,37],["ὕδωρ",713071,15],["ἐπὶ",705080,0],["κεφαλήν",707639,9],["μου",709032,133],["εἶπα",705373,155],["ἀπῶσμαι",701659,254]],"Water flowed over my head: I said, I am cut off."],["55",[["ἐπεκαλεσάμην",705153,161],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["κύριε",707996,153],["ἐκ",704132,0],["λάκκου",708067,18],["κατωτάτου",707560,116]],"Koph. I called upon thy name, O Lord, out of the lowest dungeon."],["56",[["φωνήν",713640,9],["μου",709032,133],["ἤκουσας",700587,162],["μὴ",708851,28],["κρύψῃς",707923,175],["τὰ",709436,41],["ὦτά",709852,25],["σου",711945,133],["εἰς",704105,0],["τὴν",709436,8],["δέησίν",703311,9],["μου",709032,133]],"Thou heardest my voice: close not thine ears to my supplication."],["57",[["εἰς",704105,0],["τὴν",709436,8],["βοήθειάν",702745,9],["μου",709032,133],["ἤγγισας",703939,162],["ἐν",704639,0],["ᾗ",709781,108],["σε",711598,163],["ἡμέρᾳ",705984,1],["ἐπεκαλεσάμην",705153,161],["εἶπάς",705415,162],["μοι",708974,159],["μὴ",708851,28],["φοβοῦ",713532,253]],"Thou drewest nigh to my help: in the day wherein I called upon thee thou saidst to me, Fear not."],["58",[["ἐδίκασας",703691,162],["κύριε",707996,153],["τὰς",709436,38],["δίκας",703702,39],["τῆς",709436,16],["ψυχῆς",714070,17],["μου",709032,133],["ἐλυτρώσω",708282,174],["τὴν",709436,8],["ζωήν",705910,9],["μου",709032,133]],"Rechs. O Lord, thou hast pleaded the causes of my soul; thou hast redeemed my life."],["59",[["εἶδες",709725,162],["κύριε",707996,153],["τὰς",709436,38],["ταραχάς",712722,39],["μου",709032,133],["ἔκρινας",707905,162],["τὴν",709436,8],["κρίσιν",707908,9],["μου",709032,133]],"Thou hast seen, O Lord, my troubles: thou hast judged my cause."],["60",[["εἶδες",709725,162],["πᾶσαν",710177,36],["τὴν",709436,8],["ἐκδίκησιν",704175,9],["αὐτῶν",702165,40],["εἰς",704105,0],["πάντας",710177,60],["διαλογισμοὺς",703506,57],["αὐτῶν",702165,40],["ἐν",704639,0],["ἐμοί",704577,159]],"Thou hast seen all their vengeance, [thou hast looked] on all their devices against me."],["61",[["ἤκουσας",700587,162],["τὸν",709436,5],["ὀνειδισμὸν",709657,6],["αὐτῶν",702165,40],["πάντας",710177,60],["τοὺς",709436,58],["διαλογισμοὺς",703506,57],["αὐτῶν",702165,40],["κατ᾿",707200,0],["ἐμοῦ",704580,133]],"Chsen. Thou hast heard their reproach [and] all their devices against me;"],["62",[["χείλη",713781,42],["ἐπανιστανομένων",705026,299],["μοι",708974,159],["καὶ",707031,7],["μελέτας",708699,39],["αὐτῶν",702165,40],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9]],"the lips of them that rose up against me, and their plots against me all the day;"],["63",[["καθέδραν",706992,9],["αὐτῶν",702165,40],["καὶ",707031,7],["ἀνάστασιν",701054,9],["αὐτῶν",702165,40],["ἐπίβλεψον",705088,176],["ἐπὶ",705080,0],["τοὺς",709436,58],["ὀφθαλμοὺς",709870,57],["αὐτῶν",702165,40]],"their sitting down and their rising up: look thou upon their eyes."],["64",[["ἀποδώσεις",701449,166],["αὐτοῖς",702165,151],["ἀνταπόδομα",701216,25],["κύριε",707996,153],["κατὰ",707200,0],["τὰ",709436,41],["ἔργα",705396,42],["τῶν",709436,130],["χειρῶν",713787,65],["αὐτῶν",702165,40]],"Thou wilt render them a recompence, O Lord, according to the works of their hands."],["65",[["ἀποδώσεις",701449,166],["αὐτοῖς",702165,151],["ὑπερασπισμὸν",713122,6],["καρδίας",707141,17],["μόχθον",709039,6],["σου",711945,133],["αὐτοῖς",702165,151]],"Thau. Thou wilt give them [as] a covering, the grief of my heart."],["66",[["καταδιώξεις",707243,166],["ἐν",704639,0],["ὀργῇ",709728,1],["καὶ",707031,7],["ἐξαναλώσεις",704861,166],["αὐτοὺς",702165,62],["ὑποκάτω",713204,28],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["κύριε",707996,153]],"Thou wilt persecute them in anger, and wilt consume them from under the heaven, O Lord."]]