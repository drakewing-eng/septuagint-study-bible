[["1",[["μνήσθητι",708960,244],["κύριε",707996,153],["ὅ",709781,213],["τι",712866,126],["ἐγενήθη",703104,37],["ἡμῖν",705994,90],["ἐπίβλεψον",705088,176],["καὶ",707031,7],["ἰδὲ",709725,176],["τὸν",709436,5],["ὀνειδισμὸν",709657,6],["ἡμῶν",705999,145]],"Remember, O Lord, what has happened to us: behold, and look on our reproach."],["2",[["κληρονομία",707725,12],["ἡμῶν",705999,145],["μετεστράφη",708817,37],["ἀλλοτρίοις",700699,230],["οἱ",709436,136],["οἶκοι",709516,52],["ἡμῶν",705999,145],["ξένοις",709415,230]],"Our inheritance has been turned away to aliens, our houses to strangers:"],["3",[["ὀρφανοὶ",709779,138],["ἐγενήθημεν",703104,485],["οὐχ",709805,28],["ὑπάρχει",713104,91],["πατήρ",710189,4],["μητέρες",708892,191],["ἡμῶν",705999,145],["ὡς",714148,7],["αἱ",709436,190],["χῆραι",713848,191]],"we are become orphans, we have no father, our mothers are as widows."],["4",[["ἐξ",704132,0],["ἡμερῶν",705984,65],["ἡμῶν",705999,145],["ξύλα",709427,64],["ἡμῶν",705999,145],["ἐν",704639,0],["ἀλλάγματι",700682,54],["ἦλθεν",705453,2]],"We have drunk our water for money; our wood is sold to us [for a burden] on our neck:"],["5",[["ἐπὶ",705080,0],["τὸν",709436,5],["τράχηλον",712924,6],["ἡμῶν",705999,145],["ἐδιώχθημεν",703772,485],["ἐκοπιάσαμεν",707823,289],["οὐκ",709805,28],["ἀνεπαύθημεν",701027,485]],"we have been persecuted, we have laboured, we have had no rest."],["6",[["Αἴγυπτος",700401,1],["ἔδωκεν",703654,2],["χεῖρα",713787,9],["Ασσουρ",702001,1],["εἰς",704105,0],["πλησμονὴν",710549,9],["αὐτῶν",702165,284]],"Egypt gave the hand [to us], Assur to their own satisfaction."],["7",[["οἱ",709436,136],["πατέρες",710189,52],["ἡμῶν",705999,145],["ἥμαρτον",700773,150],["οὐχ",709805,28],["ὑπάρχουσιν",713104,197],["ἡμεῖς",705983,219],["τὰ",709436,41],["ἀνομήματα",701191,42],["αὐτῶν",702165,40],["ὑπέσχομεν",713175,289]],"Our fathers sinned, [and] are not: we have borne their iniquities."],["8",[["δοῦλοι",703817,52],["ἐκυρίευσαν",707995,150],["ἡμῶν",705999,145],["λυτρούμενος",708282,122],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐκ",704132,0],["τῆς",709436,16],["χειρὸς",713787,17],["αὐτῶν",702165,40]],"Servants have ruled over us: there is none to ransom [us] out of their hand."],["9",[["ἐν",704639,0],["ταῖς",709436,75],["ψυχαῖς",714070,76],["ἡμῶν",705999,145],["εἰσοίσομεν",704127,275],["ἄρτον",701829,6],["ἡμῶν",705999,145],["ἀπὸ",701425,0],["προσώπου",710986,21],["ῥομφαίας",711291,17],["τῆς",709436,16],["ἐρήμου",705420,17]],"We shall bring in our bread with [danger of] our lives, because of the sword of the wilderness."],["10",[["τὸ",709436,34],["δέρμα",703363,15],["ἡμῶν",705999,145],["ὡς",714148,7],["κλίβανος",707733,14],["ἐπελειώθη",710238,37],["συνεσπάσθησαν",712552,99],["ἀπὸ",701425,0],["προσώπου",710986,21],["καταιγίδων",707254,65],["λιμοῦ",708210,18]],"Our skin is blackened like an oven; they are convulsed, because of the storms of famine."],["11",[["γυναῖκας",703209,39],["ἐν",704639,0],["Σιων",711816,1],["ἐταπείνωσαν",712717,150],["παρθένους",710148,39],["ἐν",704639,0],["πόλεσιν",710612,76],["Ιουδα",706768,18]],"They humbled the women in Sion, the virgins in the cities of Juda."],["12",[["ἄρχοντες",701862,52],["ἐν",704639,0],["χερσὶν",713787,76],["αὐτῶν",702165,40],["ἐκρεμάσθησαν",707892,99],["πρεσβύτεροι",710735,267],["οὐκ",709805,28],["ἐδοξάσθησαν",703792,99]],"Princes were hanged up by their hands: the elders were not honoured."],["13",[["ἐκλεκτοὶ",704240,138],["κλαυθμὸν",707705,6],["ἀνέλαβον",700984,150],["καὶ",707031,7],["νεανίσκοι",709232,52],["ἐν",704639,0],["ξύλῳ",709427,54],["ἠσθένησαν",701938,150]],"The chosen men lifted up [the voice in] weeping, and the youths fainted under the wood."],["14",[["καὶ",707031,7],["πρεσβῦται",710736,52],["ἀπὸ",701425,0],["πύλης",711082,17],["κατέπαυσαν",707365,150],["ἐκλεκτοὶ",704240,138],["ἐκ",704132,0],["ψαλμῶν",714022,81],["αὐτῶν",702165,40],["κατέπαυσαν",707365,150]],"And the elders ceased from the gate, the chosen men ceased from their music."],["15",[["κατέλυσεν",707323,2],["χαρὰ",713719,12],["καρδίας",707141,17],["ἡμῶν",705999,145],["ἐστράφη",712160,37],["εἰς",704105,0],["πένθος",710253,25],["ὁ",709436,3],["χορὸς",713915,4],["ἡμῶν",705999,145]],"The joy of our heart has ceased; our dance is turned into mourning."],["16",[["ἔπεσεν",710481,2],["ὁ",709436,3],["στέφανος",712083,4],["τῆς",709436,16],["κεφαλῆς",707639,17],["ἡμῶν",705999,145],["οὐαὶ",709807,88],["δὴ",703395,11],["ἡμῖν",705994,90],["ὅτι",709803,7],["ἡμάρτομεν",700773,289]],"The crown has fallen [from] our head: yea, woe to us! for we have sinned."],["17",[["περὶ",710285,0],["τούτου",709858,102],["ἐγενήθη",703104,37],["ὀδυνηρὰ",709464,29],["ἡ",709436,10],["καρδία",707141,12],["ἡμῶν",705999,145],["περὶ",710285,0],["τούτου",709858,102],["ἐσκότασαν",711884,150],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["ἡμῶν",705999,145]],"For this has grief come; our heart is sorrowful: for this our eyes are darkened."],["18",[["ἐπ᾿",705080,0],["ὄρος",709768,25],["Σιων",711816,17],["ὅτι",709803,7],["ἠφανίσθη",702182,37],["ἀλώπεκες",700743,191],["διῆλθον",703673,150],["ἐν",704639,0],["αὐτῇ",702165,105]],"Over the mountain of Sion, because it is made desolate, foxes have walked therein."],["19",[["σὺ",712181,164],["δέ",703303,11],["κύριε",707996,153],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["κατοικήσεις",707534,166],["ὁ",709436,3],["θρόνος",706315,4],["σου",711945,133],["εἰς",704105,0],["γενεὰν",703037,9],["καὶ",707031,7],["γενεάν",703037,9]],"But thou, O Lord, shalt dwell for ever; thy throne [shall endure] to generation and generation."],["20",[["ἵνα",706747,7],["τί",712867,126],["εἰς",704105,0],["νεῖκος",709246,25],["ἐπιλήσῃ",705187,123],["ἡμῶν",705999,145],["καταλείψεις",707305,166],["ἡμᾶς",705981,194],["εἰς",704105,0],["μακρότητα",708423,18],["ἡμερῶν",705984,65]],"Wherefore wilt thou utterly forget us, and abandon us a long time?"],["21",[["ἐπίστρεψον",705278,176],["ἡμᾶς",705981,194],["κύριε",707996,153],["πρὸς",710844,0],["σέ",711598,163],["καὶ",707031,7],["ἐπιστραφησόμεθα",705278,347],["καὶ",707031,7],["ἀνακαίνισον",700965,176],["ἡμέρας",705984,17],["ἡμῶν",705999,145],["καθὼς",707030,28],["ἔμπροσθεν",704618,28]],"Turn us, O Lord, to thee, and we shall be turned; and renew our days as before."],["22",[["ὅτι",709803,7],["ἀπωθούμενος",701659,122],["ἀπώσω",701659,207],["ἡμᾶς",705981,194],["ὠργίσθης",709729,168],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["ἕως",705792,7],["σφόδρα",712586,28]],"For thou hast indeed rejected us; thou hast been very wroth against us."]]