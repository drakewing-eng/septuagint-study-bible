[["1",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["2",[["καὶ",707031,28],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["λαλήσεις",708071,166],["ἐάν",703912,7],["τις",712866,158],["ἀπὸ",701425,0],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ἢ",705924,7],["ἀπὸ",701425,0],["τῶν",709436,80],["προσγεγενημένων",710870,445],["προσηλύτων",710900,81],["ἐν",704639,0],["Ισραηλ",706839,114],["ὃς",709781,213],["ἂν",700900,11],["δῷ",703654,172],["τοῦ",709436,20],["σπέρματος",712008,21],["αὐτοῦ",702165,102],["ἄρχοντι",701862,114],["θανάτῳ",706096,114],["θανατούσθω",706097,407],["τὸ",709436,34],["ἔθνος",704068,15],["τὸ",709436,34],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["λιθοβολήσουσιν",708194,218],["αὐτὸν",702165,85],["ἐν",704639,0],["λίθοις",708196,148]],"Thou shalt also say to the children of Israel, If [there shall be] any of the children of Israel, or of those who have become proselytes in Israel, who shall give of his seed to Moloch, let him be surely put to death; the nation upon the land shall stone him with stones."],["3",[["καὶ",707031,7],["ἐγὼ",704018,164],["ἐπιστήσω",705756,165],["τὸ",709436,24],["πρόσωπόν",710986,25],["μου",709032,133],["ἐπὶ",705080,0],["τὸν",709436,5],["ἄνθρωπον",701163,6],["ἐκεῖνον",704183,85],["καὶ",707031,7],["ἀπολῶ",701513,165],["αὐτὸν",702165,85],["ἐκ",704132,0],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτοῦ",702165,102],["ὅτι",709803,7],["τοῦ",709436,20],["σπέρματος",712008,21],["αὐτοῦ",702165,102],["ἔδωκεν",703654,2],["ἄρχοντι",701862,114],["ἵνα",706747,7],["μιάνῃ",708900,172],["τὰ",709436,41],["ἅγιά",700159,68],["μου",709032,133],["καὶ",707031,7],["βεβηλώσῃ",702614,172],["τὸ",709436,24],["ὄνομα",709666,25],["τῶν",709436,80],["ἡγιασμένων",700153,398],["μοι",708974,159]],"And I will set my face against that man, and will cut him off from his people, because he has given of his seed to Moloch, to defile my sanctuary, and profane the name of them that are consecrated to me."],["4",[["ἐὰν",703912,7],["δὲ",703303,11],["ὑπερόψει",713156,1],["ὑπερίδωσιν",713154,234],["οἱ",709436,136],["αὐτόχθονες",702168,52],["τῆς",709436,16],["γῆς",703083,17],["τοῖς",709436,147],["ὀφθαλμοῖς",709870,148],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["ἐκείνου",704183,102],["ἐν",704639,0],["τῷ",709436,53],["δοῦναι",703654,106],["αὐτὸν",702165,85],["τοῦ",709436,20],["σπέρματος",712008,21],["αὐτοῦ",702165,102],["ἄρχοντι",701862,114],["τοῦ",709436,20],["μὴ",708851,28],["ἀποκτεῖναι",701498,106],["αὐτόν",702165,85]],"And if the natives of the land should in anywise overlook that man in giving of his seed to Moloch, so as not to put him to death;"],["5",[["καὶ",707031,7],["ἐπιστήσω",705756,165],["τὸ",709436,24],["πρόσωπόν",710986,25],["μου",709032,133],["ἐπὶ",705080,0],["τὸν",709436,5],["ἄνθρωπον",701163,6],["ἐκεῖνον",704183,85],["καὶ",707031,7],["τὴν",709436,8],["συγγένειαν",712184,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀπολῶ",701513,165],["αὐτὸν",702165,85],["καὶ",707031,7],["πάντας",710177,60],["τοὺς",709436,58],["ὁμονοοῦντας",709638,235],["αὐτῷ",702165,50],["ὥστε",714164,7],["ἐκπορνεύειν",704295,55],["αὐτὸν",702165,85],["εἰς",704105,0],["τοὺς",709436,58],["ἄρχοντας",701862,57],["ἐκ",704132,0],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτῶν",702165,40]],"then will I set my face against that man and his family, and I will destroy him, and all who have been of one mind with him, so that he should go a whoring to the princes, from their people."],["6",[["καὶ",707031,7],["ψυχή",714070,12],["ἣ",709781,177],["ἐὰν",703912,7],["ἐπακολουθήσῃ",705007,172],["ἐγγαστριμύθοις",703938,230],["ἢ",705924,7],["ἐπαοιδοῖς",705035,148],["ὥστε",714164,7],["ἐκπορνεῦσαι",704295,106],["ὀπίσω",709697,0],["αὐτῶν",702165,40],["ἐπιστήσω",705756,165],["τὸ",709436,24],["πρόσωπόν",710986,25],["μου",709032,133],["ἐπὶ",705080,0],["τὴν",709436,8],["ψυχὴν",714070,9],["ἐκείνην",704183,104],["καὶ",707031,7],["ἀπολῶ",701513,165],["αὐτὴν",702165,104],["ἐκ",704132,0],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτῆς",702165,86]],"And the soul that shall follow those who have in them divining spirits, or enchanters, so as to go a whoring after them; I will set my face against that soul, and will destroy it from among its people."],["7",[["καὶ",707031,7],["ἔσεσθε",704093,124],["ἅγιοι",700159,138],["ὅτι",709803,7],["ἅγιος",700159,14],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"And ye shall be holy, for I the Lord your God [am] holy."],["8",[["καὶ",707031,7],["φυλάξεσθε",713619,124],["τὰ",709436,41],["προστάγματά",710959,42],["μου",709032,133],["καὶ",707031,7],["ποιήσετε",710582,337],["αὐτά",702165,71],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["ἁγιάζων",700153,72],["ὑμᾶς",713080,194]],"And ye shall observe my ordinances, and do them: I [am] the Lord that sanctifies you."],["9",[["ἄνθρωπος",701163,4],["ἄνθρωπος",701163,4],["ὃς",709781,213],["ἂν",700900,11],["κακῶς",707074,28],["εἴπῃ",705373,172],["τὸν",709436,5],["πατέρα",710189,6],["αὐτοῦ",702165,102],["ἢ",705924,7],["τὴν",709436,8],["μητέρα",708892,9],["αὐτοῦ",702165,102],["θανάτῳ",706096,114],["θανατούσθω",706097,407],["πατέρα",710189,6],["αὐτοῦ",702165,102],["ἢ",705924,7],["μητέρα",708892,9],["αὐτοῦ",702165,102],["κακῶς",707074,28],["εἶπεν",705373,2],["ἔνοχος",704781,14],["ἔσται",704093,93]],"Every man who shall speak evil of his father or of his mother, let him die the death; has he spoken evil of his father or his mother? he shall be guilty."],["10",[["ἄνθρωπος",701163,4],["ὃς",709781,213],["ἂν",700900,11],["μοιχεύσηται",708979,239],["γυναῖκα",703209,9],["ἀνδρὸς",701150,18],["ἢ",705924,7],["ὃς",709781,213],["ἂν",700900,11],["μοιχεύσηται",708979,239],["γυναῖκα",703209,9],["τοῦ",709436,35],["πλησίον",710547,28],["θανάτῳ",706096,114],["θανατούσθωσαν",706097,77],["ὁ",709436,3],["μοιχεύων",708979,72],["καὶ",707031,7],["ἡ",709436,10],["μοιχευομένη",708979,473]],"Whatever man shall commit adultery with the wife of a man, or whoever shall commit adultery with the wife of his neighbour, let them die the death, the adulterer and the adulteress."],["11",[["ἐάν",703912,7],["τις",712866,158],["κοιμηθῇ",707767,384],["μετὰ",708780,0],["γυναικὸς",703209,17],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["ἀσχημοσύνην",702054,9],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["ἀπεκάλυψεν",701474,2],["θανάτῳ",706096,114],["θανατούσθωσαν",706097,77],["ἀμφότεροι",700892,138],["ἔνοχοί",704781,138],["εἰσιν",704093,197]],"And if any one should lie with his father's wife, he has uncovered his father's nakedness: let them both die the death, they are guilty."],["12",[["καὶ",707031,7],["ἐάν",703912,7],["τις",712866,158],["κοιμηθῇ",707767,384],["μετὰ",708780,0],["νύμφης",709381,17],["αὐτοῦ",702165,102],["θανάτῳ",706096,114],["θανατούσθωσαν",706097,77],["ἀμφότεροι",700892,138],["ἠσεβήκασιν",701906,353],["γάρ",702963,11],["ἔνοχοί",704781,138],["εἰσιν",704093,197]],"And if any one should lie with his daughter-in-law, let them both be put to death; for they have wrought impiety, they are guilty."],["13",[["καὶ",707031,7],["ὃς",709781,213],["ἂν",700900,11],["κοιμηθῇ",707767,384],["μετὰ",708780,0],["ἄρσενος",701818,92],["κοίτην",707781,9],["γυναικός",703209,17],["βδέλυγμα",702604,25],["ἐποίησαν",710582,150],["ἀμφότεροι",700892,138],["θανατούσθωσαν",706097,77],["ἔνοχοί",704781,138],["εἰσιν",704093,197]],"And whoever shall lie with a male as with a woman, they have both wrought abomination; let them die the death, they are guilty."],["14",[["ὃς",709781,213],["ἐὰν",703912,7],["λάβῃ",708076,172],["γυναῖκα",703209,9],["καὶ",707031,7],["τὴν",709436,8],["μητέρα",708892,9],["αὐτῆς",702165,86],["ἀνόμημά",701191,15],["ἐστιν",704093,91],["ἐν",704639,0],["πυρὶ",711088,54],["κατακαύσουσιν",707258,218],["αὐτὸν",702165,85],["καὶ",707031,7],["αὐτάς",702165,231],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ἀνομία",701192,12],["ἐν",704639,0],["ὑμῖν",713084,90]],"Whosoever shall take a woman and her mother, it is iniquity: they shall burn him and them with fire; so there shall not be iniquity among you."],["15",[["καὶ",707031,7],["ὃς",709781,213],["ἂν",700900,11],["δῷ",703654,172],["κοιτασίαν",707780,9],["αὐτοῦ",702165,102],["ἐν",704639,0],["τετράποδι",712823,97],["θανάτῳ",706096,114],["θανατούσθω",706097,407],["καὶ",707031,7],["τὸ",709436,24],["τετράπουν",712823,46],["ἀποκτενεῖτε",701498,337]],"And whosoever shall lie with a beast, let him die the death; and ye shall kill the beast."],["16",[["καὶ",707031,7],["γυνή",703209,12],["ἥτις",709793,412],["προσελεύσεται",710890,93],["πρὸς",710844,0],["πᾶν",710177,46],["κτῆνος",707934,25],["βιβασθῆναι",702716,179],["αὐτὴν",702165,104],["ὑπ᾿",713184,0],["αὐτοῦ",702165,49],["ἀποκτενεῖτε",701498,337],["τὴν",709436,8],["γυναῖκα",703209,9],["καὶ",707031,7],["τὸ",709436,24],["κτῆνος",707934,25],["θανάτῳ",706096,114],["θανατούσθωσαν",706097,77],["ἔνοχοί",704781,138],["εἰσιν",704093,197]],"And whatever woman shall approach any beast, so as to have connexion with it, ye shall kill the woman and the beast: let them die the death, they are guilty."],["17",[["ὃς",709781,213],["ἐὰν",703912,7],["λάβῃ",708076,172],["τὴν",709436,8],["ἀδελφὴν",700244,9],["αὐτοῦ",702165,102],["ἐκ",704132,0],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["ἢ",705924,7],["ἐκ",704132,0],["μητρὸς",708892,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἴδῃ",709725,172],["τὴν",709436,8],["ἀσχημοσύνην",702054,9],["αὐτῆς",702165,86],["καὶ",707031,7],["αὕτη",709858,107],["ἴδῃ",709725,172],["τὴν",709436,8],["ἀσχημοσύνην",702054,9],["αὐτοῦ",702165,102],["ὄνειδός",709658,15],["ἐστιν",704093,91],["ἐξολεθρευθήσονται",704956,144],["ἐνώπιον",704823,0],["υἱῶν",713075,81],["γένους",703057,21],["αὐτῶν",702165,40],["ἀσχημοσύνην",702054,9],["ἀδελφῆς",700244,17],["αὐτοῦ",702165,102],["ἀπεκάλυψεν",701474,2],["ἁμαρτίαν",700775,9],["κομιοῦνται",707805,135]],"Whosoever shall take his sister by his father or by his mother, and shall see her nakedness, and she see his nakedness, it is a reproach: they shall be destroyed before the children of their family; he has uncovered his sister's nakedness, they shall bear their sin."],["18",[["καὶ",707031,7],["ἀνήρ",701150,4],["ὃς",709781,213],["ἂν",700900,11],["κοιμηθῇ",707767,384],["μετὰ",708780,0],["γυναικὸς",703209,17],["ἀποκαθημένης",701469,422],["καὶ",707031,7],["ἀποκαλύψῃ",701474,172],["τὴν",709436,8],["ἀσχημοσύνην",702054,9],["αὐτῆς",702165,86],["τὴν",709436,8],["πηγὴν",710450,9],["αὐτῆς",702165,86],["ἀπεκάλυψεν",701474,2],["καὶ",707031,7],["αὕτη",709858,107],["ἀπεκάλυψεν",701474,2],["τὴν",709436,8],["ῥύσιν",711312,9],["τοῦ",709436,20],["αἵματος",700442,21],["αὐτῆς",702165,86],["ἐξολεθρευθήσονται",704956,144],["ἀμφότεροι",700892,138],["ἐκ",704132,0],["τοῦ",709436,20],["γένους",703057,21],["αὐτῶν",702165,40]],"And whatever man shall lie with a woman that is set apart [for a flux], and shall uncover her nakedness, he has uncovered her fountain, and she has uncovered the flux of her blood: they shall both be destroyed from among their generation."],["19",[["καὶ",707031,7],["ἀσχημοσύνην",702054,9],["ἀδελφῆς",700244,17],["πατρός",710189,18],["σου",711945,133],["καὶ",707031,7],["ἀδελφῆς",700244,17],["μητρός",708892,17],["σου",711945,133],["οὐκ",709805,28],["ἀποκαλύψεις",701475,166],["τὴν",709436,8],["γὰρ",702963,11],["οἰκειότητα",709494,9],["ἀπεκάλυψεν",701474,2],["ἁμαρτίαν",700775,9],["ἀποίσονται",701632,135]],"And thou shalt not uncover the nakedness of thy father's sister, or of the sister of thy mother; for that man has uncovered the nakedness of one near akin: they shall bear their iniquity."],["20",[["ὃς",709781,213],["ἂν",700900,11],["κοιμηθῇ",707767,384],["μετὰ",708780,0],["τῆς",709436,16],["συγγενοῦς",712185,82],["αὐτοῦ",702165,102],["ἀσχημοσύνην",702054,9],["τῆς",709436,16],["συγγενείας",712184,17],["αὐτοῦ",702165,102],["ἀπεκάλυψεν",701474,2],["ἄτεκνοι",702080,138],["ἀποθανοῦνται",701461,135]],"Whosoever shall lie with his near kinswoman, has uncovered the nakedness of one near akin to him: they shall die childless."],["21",[["ὃς",709781,213],["ἂν",700900,11],["λάβῃ",708076,172],["τὴν",709436,8],["γυναῖκα",703209,9],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["αὐτοῦ",702165,102],["ἀκαθαρσία",700507,12],["ἐστίν",704093,91],["ἀσχημοσύνην",702054,9],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["αὐτοῦ",702165,102],["ἀπεκάλυψεν",701474,2],["ἄτεκνοι",702080,138],["ἀποθανοῦνται",701461,135]],"Whoever shall take his brother's wife, it is uncleanness; he has uncovered his brother's nakedness; they shall die childless."],["22",[["καὶ",707031,7],["φυλάξασθε",713619,186],["πάντα",710177,68],["τὰ",709436,41],["προστάγματά",710959,42],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,41],["κρίματά",707903,42],["μου",709032,133],["καὶ",707031,7],["ποιήσετε",710582,337],["αὐτά",702165,71],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["προσοχθίσῃ",710945,172],["ὑμῖν",713084,90],["ἡ",709436,10],["γῆ",703083,12],["εἰς",704105,0],["ἣν",709781,131],["ἐγὼ",704018,164],["εἰσάγω",704107,157],["ὑμᾶς",713080,194],["ἐκεῖ",704181,28],["κατοικεῖν",707534,55],["ἐπ᾿",705080,0],["αὐτῆς",702165,86]],"And keep ye all my ordinances, and my judgments; and ye shall do them, and the land shall not be aggrieved with you, into which I bring you to dwell upon it."],["23",[["καὶ",707031,7],["οὐχὶ",709862,28],["πορεύεσθε",710667,73],["τοῖς",709436,147],["νομίμοις",709340,230],["τῶν",709436,43],["ἐθνῶν",704068,44],["οὓς",709781,298],["ἐξαποστέλλω",704872,157],["ἀφ᾿",701425,0],["ὑμῶν",713091,145],["ὅτι",709803,7],["ταῦτα",709858,71],["πάντα",710177,68],["ἐποίησαν",710582,150],["καὶ",707031,7],["ἐβδελυξάμην",702608,161],["αὐτούς",702165,62]],"And walk ye not in the customs of the nations which I drive out from before you; for they have done all these things, and I have abhorred them:"],["24",[["καὶ",707031,7],["εἶπα",705373,155],["ὑμῖν",713084,90],["ὑμεῖς",713081,219],["κληρονομήσατε",707724,74],["τὴν",709436,8],["γῆν",703083,9],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐγὼ",704018,164],["δώσω",703654,165],["ὑμῖν",713084,90],["αὐτὴν",702165,104],["ἐν",704639,0],["κτήσει",707937,1],["γῆν",703083,9],["ῥέουσαν",711241,78],["γάλα",702919,25],["καὶ",707031,7],["μέλι",708700,25],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["ὃς",709781,213],["διώρισα",703730,155],["ὑμᾶς",713080,194],["ἀπὸ",701425,0],["πάντων",710177,83],["τῶν",709436,43],["ἐθνῶν",704068,44]],"and I said to you, Ye shall inherit their land, and I will give it to you for a possession, [even] a land flowing with milk and honey: I [am] the Lord your God, who have separated you from all people."],["25",[["καὶ",707031,7],["ἀφοριεῖτε",702227,337],["αὐτοὺς",702165,62],["ἀνὰ",700902,0],["μέσον",708768,46],["τῶν",709436,43],["κτηνῶν",707934,44],["τῶν",709436,43],["καθαρῶν",706988,83],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,46],["τῶν",709436,43],["κτηνῶν",707934,44],["τῶν",709436,43],["ἀκαθάρτων",700508,83],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,46],["τῶν",709436,43],["πετεινῶν",710438,44],["τῶν",709436,43],["καθαρῶν",706988,83],["καὶ",707031,7],["τῶν",709436,43],["ἀκαθάρτων",700508,83],["καὶ",707031,7],["οὐ",709805,28],["βδελύξετε",702608,337],["τὰς",709436,38],["ψυχὰς",714070,39],["ὑμῶν",713091,145],["ἐν",704639,0],["τοῖς",709436,95],["κτήνεσιν",707934,96],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["πετεινοῖς",710438,96],["καὶ",707031,7],["ἐν",704639,0],["πᾶσιν",710177,94],["τοῖς",709436,95],["ἑρπετοῖς",705441,96],["τῆς",709436,16],["γῆς",703083,17],["ἃ",709781,69],["ἐγὼ",704018,164],["ἀφώρισα",702227,155],["ὑμῖν",713084,90],["ἐν",704639,0],["ἀκαθαρσίᾳ",700507,1]],"And ye shall make a distinction between the clean and the unclean cattle, and between clean and unclean birds; and ye shall not defile your souls with cattle, or with birds, or with any creeping things of the earth, which I have separated for you by reason of uncleanness."],["26",[["καὶ",707031,7],["ἔσεσθέ",704093,124],["μοι",708974,159],["ἅγιοι",700159,138],["ὅτι",709803,7],["ἐγὼ",704018,164],["ἅγιος",700159,14],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["ὁ",709436,3],["ἀφορίσας",702227,182],["ὑμᾶς",713080,194],["ἀπὸ",701425,0],["πάντων",710177,83],["τῶν",709436,43],["ἐθνῶν",704068,44],["εἶναι",704093,55],["ἐμοί",704577,159]],"And ye shall be holy to me; because I the Lord your God [am] holy, who separated you from all nations, to be mine."],["27",[["καὶ",707031,7],["ἀνὴρ",701150,4],["ἢ",705924,7],["γυνή",703209,12],["ὃς",709781,213],["ἂν",700900,11],["γένηται",703104,239],["αὐτῶν",702165,40],["ἐγγαστρίμυθος",703938,14],["ἢ",705924,7],["ἐπαοιδός",705035,4],["θανάτῳ",706096,114],["θανατούσθωσαν",706097,77],["ἀμφότεροι",700892,138],["λίθοις",708196,148],["λιθοβολήσατε",708194,74],["αὐτούς",702165,62],["ἔνοχοί",704781,138],["εἰσιν",704093,197]],"And [as for] a man or woman whosoever of them shall have in them a divining spirit, or be an enchanter, let them both die the death: ye shall stone them with stones, they are guilty."]]