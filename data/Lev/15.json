[["1",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["καὶ",707031,7],["Ααρων",700005,6],["λέγων",708124,72]],"And the Lord spoke to Moses and Aaron, saying,"],["2",[["λάλησον",708071,176],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐρεῖς",705415,166],["αὐτοῖς",702165,151],["ἀνδρὶ",701150,114],["ἀνδρί",701150,114],["ᾧ",709781,309],["ἐὰν",703912,7],["γένηται",703104,239],["ῥύσις",711312,12],["ἐκ",704132,0],["τοῦ",709436,20],["σώματος",712635,21],["αὐτοῦ",702165,102],["ἡ",709436,10],["ῥύσις",711312,12],["αὐτοῦ",702165,102],["ἀκάθαρτός",700508,29],["ἐστιν",704093,91]],"Speak to the children of Israel, and thou shalt say to them, Whatever man shall have an issue out of his body, his issue is unclean."],["3",[["καὶ",707031,7],["οὗτος",709858,121],["ὁ",709436,3],["νόμος",709349,4],["τῆς",709436,16],["ἀκαθαρσίας",700507,17],["αὐτοῦ",702165,102],["ῥέων",711241,72],["γόνον",703171,6],["ἐκ",704132,0],["σώματος",712635,21],["αὐτοῦ",702165,102],["ἐκ",704132,0],["τῆς",709436,16],["ῥύσεως",711312,17],["ἧς",709781,167],["συνέστηκεν",712482,171],["τὸ",709436,34],["σῶμα",712635,15],["αὐτοῦ",702165,102],["διὰ",703417,0],["τῆς",709436,16],["ῥύσεως",711312,17],["αὕτη",709858,107],["ἡ",709436,10],["ἀκαθαρσία",700507,12],["αὐτοῦ",702165,102],["ἐν",704639,0],["αὐτῷ",702165,50],["πᾶσαι",710177,192],["αἱ",709436,190],["ἡμέραι",705984,191],["ῥύσεως",711312,17],["σώματος",712635,21],["αὐτοῦ",702165,102],["ᾗ",709781,108],["συνέστηκεν",712482,171],["τὸ",709436,34],["σῶμα",712635,15],["αὐτοῦ",702165,102],["διὰ",703417,0],["τῆς",709436,16],["ῥύσεως",711312,17],["ἀκαθαρσία",700507,12],["αὐτοῦ",702165,102],["ἐστιν",704093,91]],"And this [is] the law of his uncleanness; whoever has a gonorrhœa out of his body, this is his uncleanness in him by reason of the issue, by which his body is affected through the issue: all the days of the issue of his body, by which his body is affected through the issue, there is his uncleanness."],["4",[["πᾶσα",710177,29],["κοίτη",707781,12],["ἐφ᾿",705080,0],["ᾗ",709781,108],["ἐὰν",703912,7],["κοιμηθῇ",707767,384],["ἐπ᾿",705080,0],["αὐτῆς",702165,86],["ὁ",709436,3],["γονορρυής",703170,14],["ἀκάθαρτός",700508,29],["ἐστιν",704093,91],["καὶ",707031,7],["πᾶν",710177,26],["σκεῦος",711844,15],["ἐφ᾿",705080,0],["ὃ",709781,128],["ἐὰν",703912,7],["καθίσῃ",707006,172],["ἐπ᾿",705080,0],["αὐτὸ",702165,129],["ὁ",709436,3],["γονορρυής",703170,14],["ἀκάθαρτον",700508,26],["ἔσται",704093,93]],"Every bed on which he that has the issue shall happen to lie, is unclean; and every seat on which he that has the issue may happen to sit, shall be unclean.",{"s":"d","q":0.68}],["5",[["καὶ",707031,7],["ἄνθρωπος",701163,4],["ὃς",709781,213],["ἂν",700900,11],["ἅψηται",701654,239],["τῆς",709436,16],["κοίτης",707781,17],["αὐτοῦ",702165,102],["πλυνεῖ",710564,127],["τὰ",709436,41],["ἱμάτια",706742,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["λούσεται",708258,93],["ὕδατι",713071,54],["καὶ",707031,7],["ἀκάθαρτος",700508,14],["ἔσται",704093,93],["ἕως",705792,0],["ἑσπέρας",705500,17]],"And the man who shall touch his bed, shall wash his garments, and bathe himself in water, and shall be unclean till evening."],["6",[["καὶ",707031,7],["ὁ",709436,3],["καθήμενος",707000,122],["ἐπὶ",705080,0],["τοῦ",709436,20],["σκεύους",711844,21],["ἐφ᾿",705080,0],["ὃ",709781,128],["ἐὰν",703912,7],["καθίσῃ",707006,172],["ὁ",709436,3],["γονορρυής",703170,14],["πλυνεῖ",710564,127],["τὰ",709436,41],["ἱμάτια",706742,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["λούσεται",708258,93],["ὕδατι",713071,54],["καὶ",707031,7],["ἀκάθαρτος",700508,14],["ἔσται",704093,93],["ἕως",705792,0],["ἑσπέρας",705500,17]],"And whosoever sits on the seat on which he that has the issue may have sat, shall wash his garments, and bathe himself in water, and shall be unclean until evening."],["7",[["καὶ",707031,7],["ὁ",709436,3],["ἁπτόμενος",701654,122],["τοῦ",709436,35],["χρωτὸς",713983,18],["τοῦ",709436,35],["γονορρυοῦς",703170,116],["πλυνεῖ",710564,127],["τὰ",709436,41],["ἱμάτια",706742,42],["καὶ",707031,7],["λούσεται",708258,93],["ὕδατι",713071,54],["καὶ",707031,7],["ἀκάθαρτος",700508,14],["ἔσται",704093,93],["ἕως",705792,0],["ἑσπέρας",705500,17]],"And he that touches the skin of him that has the issue, shall wash his garments and bathe himself in water, and shall be unclean till evening."],["8",[["ἐὰν",703912,7],["δὲ",703303,11],["προσσιελίσῃ",710957,172],["ὁ",709436,3],["γονορρυὴς",703170,14],["ἐπὶ",705080,0],["τὸν",709436,5],["καθαρόν",706988,27],["πλυνεῖ",710564,127],["τὰ",709436,41],["ἱμάτια",706742,42],["καὶ",707031,7],["λούσεται",708258,93],["ὕδατι",713071,54],["καὶ",707031,7],["ἀκάθαρτος",700508,14],["ἔσται",704093,93],["ἕως",705792,0],["ἑσπέρας",705500,17]],"And if he that has the issue should spit upon one that is clean, [that person] shall wash his garments, and bathe himself in water, and be unclean until evening."],["9",[["καὶ",707031,7],["πᾶν",710177,26],["ἐπίσαγμα",705241,15],["ὄνου",709671,18],["ἐφ᾿",705080,0],["ὃ",709781,128],["ἂν",700900,11],["ἐπιβῇ",705082,172],["ἐπ᾿",705080,0],["αὐτὸ",702165,129],["ὁ",709436,3],["γονορρυής",703170,14],["ἀκάθαρτον",700508,26],["ἔσται",704093,93],["ἕως",705792,0],["ἑσπέρας",705500,17]],"And every ass's saddle, on which the man with the issue shall have mounted, shall be unclean till evening."],["10",[["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["ἁπτόμενος",701654,122],["ὅσα",709788,195],["ἐὰν",703912,7],["ᾖ",704093,204],["ὑποκάτω",713204,0],["αὐτοῦ",702165,102],["ἀκάθαρτος",700508,14],["ἔσται",704093,93],["ἕως",705792,0],["ἑσπέρας",705500,17],["καὶ",707031,7],["ὁ",709436,3],["αἴρων",700473,72],["αὐτὰ",702165,71],["πλυνεῖ",710564,127],["τὰ",709436,41],["ἱμάτια",706742,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["λούσεται",708258,93],["ὕδατι",713071,54],["καὶ",707031,7],["ἀκάθαρτος",700508,14],["ἔσται",704093,93],["ἕως",705792,0],["ἑσπέρας",705500,17]],"And every one that touches whatsoever shall have been under him shall be unclean until evening; and he that takes them up shall wash his garments, and bathe himself in water, and shall be unclean until evening."],["11",[["καὶ",707031,7],["ὅσων",709788,169],["ἐὰν",703912,7],["ἅψηται",701654,239],["ὁ",709436,3],["γονορρυὴς",703170,14],["καὶ",707031,7],["τὰς",709436,38],["χεῖρας",713787,39],["οὐ",709805,28],["νένιπται",709314,187],["πλυνεῖ",710564,127],["τὰ",709436,41],["ἱμάτια",706742,42],["καὶ",707031,7],["λούσεται",708258,93],["τὸ",709436,24],["σῶμα",712635,25],["ὕδατι",713071,54],["καὶ",707031,7],["ἀκάθαρτος",700508,14],["ἔσται",704093,93],["ἕως",705792,0],["ἑσπέρας",705500,17]],"And whomsoever he that has the issue shall touch, if he have not rinsed his hands in water, he shall wash his garments, and bathe his body in water, and shall be unclean until evening."],["12",[["καὶ",707031,7],["σκεῦος",711844,15],["ὀστράκινον",709795,26],["οὗ",709781,160],["ἂν",700900,11],["ἅψηται",701654,239],["ὁ",709436,3],["γονορρυής",703170,14],["συντριβήσεται",712520,134],["καὶ",707031,7],["σκεῦος",711844,15],["ξύλινον",709425,26],["νιφήσεται",709314,134],["ὕδατι",713071,54],["καὶ",707031,7],["καθαρὸν",706988,26],["ἔσται",704093,93]],"And the earthen vessel which he that has the issue shall happen to touch, shall be broken; and a wooden vessel shall be washed with water, and shall be clean."],["13",[["ἐὰν",703912,7],["δὲ",703303,11],["καθαρισθῇ",706985,384],["ὁ",709436,3],["γονορρυὴς",703170,14],["ἐκ",704132,0],["τῆς",709436,16],["ῥύσεως",711312,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐξαριθμήσεται",704877,93],["αὐτῷ",702165,50],["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["εἰς",704105,0],["τὸν",709436,5],["καθαρισμὸν",706987,6],["καὶ",707031,7],["πλυνεῖ",710564,127],["τὰ",709436,41],["ἱμάτια",706742,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["λούσεται",708258,93],["τὸ",709436,24],["σῶμα",712635,25],["ὕδατι",713071,54],["καὶ",707031,7],["καθαρὸς",706988,14],["ἔσται",704093,93]],"And if he that has the issue should be cleansed of his issue, then shall he number to himself seven days for his purification; and he shall wash his garments, and bathe his body in water, and shall be clean."],["14",[["καὶ",707031,7],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["ὀγδόῃ",709444,101],["λήμψεται",708076,93],["ἑαυτῷ",703917,50],["δύο",703849,59],["τρυγόνας",713000,39],["ἢ",705924,7],["δύο",703849,59],["νεοσσοὺς",709257,57],["περιστερῶν",710391,65],["καὶ",707031,7],["οἴσει",713428,127],["αὐτὰ",702165,71],["ἔναντι",704653,0],["κυρίου",707996,18],["ἐπὶ",705080,0],["τὰς",709436,38],["θύρας",706337,39],["τῆς",709436,16],["σκηνῆς",711845,17],["τοῦ",709436,20],["μαρτυρίου",708525,21],["καὶ",707031,7],["δώσει",703654,127],["αὐτὰ",702165,71],["τῷ",709436,113],["ἱερεῖ",706614,114]],"And on the eighth day he shall take to himself two turtle-doves or two young pigeons, and he shall bring them before the Lord to the doors of the tabernacle of witness, and shall give them to the priest."],["15",[["καὶ",707031,7],["ποιήσει",710582,127],["αὐτὰ",702165,71],["ὁ",709436,3],["ἱερεύς",706614,4],["μίαν",704106,36],["περὶ",710285,0],["ἁμαρτίας",700775,17],["καὶ",707031,7],["μίαν",704106,36],["εἰς",704105,0],["ὁλοκαύτωμα",709589,25],["καὶ",707031,7],["ἐξιλάσεται",704932,93],["περὶ",710285,0],["αὐτοῦ",702165,102],["ὁ",709436,3],["ἱερεὺς",706614,4],["ἔναντι",704653,0],["κυρίου",707996,18],["ἀπὸ",701425,0],["τῆς",709436,16],["ῥύσεως",711312,17],["αὐτοῦ",702165,102]],"And the priest shall offer them one for a sin-offering, and the other for a whole-burnt-offering; and the priest shall make atonement for him before the Lord for his issue."],["16",[["καὶ",707031,7],["ἄνθρωπος",701163,4],["ᾧ",709781,309],["ἐὰν",703912,7],["ἐξέλθῃ",704909,172],["ἐξ",704132,0],["αὐτοῦ",702165,102],["κοίτη",707781,12],["σπέρματος",712008,21],["καὶ",707031,7],["λούσεται",708258,93],["ὕδατι",713071,54],["πᾶν",710177,46],["τὸ",709436,24],["σῶμα",712635,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀκάθαρτος",700508,14],["ἔσται",704093,93],["ἕως",705792,0],["ἑσπέρας",705500,17]],"And the man whose seed of copulation shall happen to go forth from him, shall then wash his whole body, and shall be unclean until evening."],["17",[["καὶ",707031,7],["πᾶν",710177,26],["ἱμάτιον",706742,15],["καὶ",707031,7],["πᾶν",710177,26],["δέρμα",703363,15],["ἐφ᾿",705080,0],["ὃ",709781,128],["ἐὰν",703912,7],["ᾖ",704093,204],["ἐπ᾿",705080,0],["αὐτὸ",702165,129],["κοίτη",707781,12],["σπέρματος",712008,21],["καὶ",707031,7],["πλυθήσεται",710564,134],["ὕδατι",713071,54],["καὶ",707031,7],["ἀκάθαρτον",700508,26],["ἔσται",704093,93],["ἕως",705792,0],["ἑσπέρας",705500,17]],"And every garment, and every skin on which there shall be the seed of copulation shall both be washed with water, and be unclean until evening."],["18",[["καὶ",707031,7],["γυνή",703209,12],["ἐὰν",703912,7],["κοιμηθῇ",707767,384],["ἀνὴρ",701150,4],["μετ᾿",708780,0],["αὐτῆς",702165,86],["κοίτην",707781,9],["σπέρματος",712008,21],["καὶ",707031,7],["λούσονται",708258,135],["ὕδατι",713071,54],["καὶ",707031,7],["ἀκάθαρτοι",700508,138],["ἔσονται",704093,135],["ἕως",705792,0],["ἑσπέρας",705500,17]],"And a woman, if a man shall lie with her with seed of copulation—they shall both bathe themselves in water and shall be unclean until evening."],["19",[["καὶ",707031,7],["γυνή",703209,12],["ἥτις",709793,412],["ἐὰν",703912,7],["ᾖ",704093,204],["ῥέουσα",711241,188],["αἵματι",700442,54],["ἔσται",704093,93],["ἡ",709436,10],["ῥύσις",711312,12],["αὐτῆς",702165,86],["ἐν",704639,0],["τῷ",709436,53],["σώματι",712635,54],["αὐτῆς",702165,86],["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["ἔσται",704093,93],["ἐν",704639,0],["τῇ",709436,100],["ἀφέδρῳ",702191,1],["αὐτῆς",702165,86],["πᾶς",710177,14],["ὁ",709436,3],["ἁπτόμενος",701654,122],["αὐτῆς",702165,86],["ἀκάθαρτος",700508,14],["ἔσται",704093,93],["ἕως",705792,0],["ἑσπέρας",705500,17]],"And the woman whosoever shall have an issue of blood, when her issue shall be in her body, shall be seven days in her separation; every one that touches her shall be unclean until evening."],["20",[["καὶ",707031,7],["πᾶν",710177,26],["ἐφ᾿",705080,0],["ὃ",709781,128],["ἂν",700900,11],["κοιτάζηται",707779,428],["ἐπ᾿",705080,0],["αὐτὸ",702165,129],["ἐν",704639,0],["τῇ",709436,100],["ἀφέδρῳ",702191,1],["αὐτῆς",702165,86],["ἀκάθαρτον",700508,26],["ἔσται",704093,93],["καὶ",707031,7],["πᾶν",710177,26],["ἐφ᾿",705080,0],["ὃ",709781,128],["ἂν",700900,11],["ἐπικαθίσῃ",705150,172],["ἐπ᾿",705080,0],["αὐτό",702165,129],["ἀκάθαρτον",700508,26],["ἔσται",704093,93]],"And every thing whereon she shall lie in her separation, shall be unclean; and whatever she shall sit upon, shall be unclean."],["21",[["καὶ",707031,7],["πᾶς",710177,14],["ὃς",709781,213],["ἐὰν",703912,7],["ἅψηται",701654,239],["τῆς",709436,16],["κοίτης",707781,17],["αὐτῆς",702165,86],["πλυνεῖ",710564,127],["τὰ",709436,41],["ἱμάτια",706742,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["λούσεται",708258,93],["τὸ",709436,24],["σῶμα",712635,25],["αὐτοῦ",702165,102],["ὕδατι",713071,54],["καὶ",707031,7],["ἀκάθαρτος",700508,14],["ἔσται",704093,93],["ἕως",705792,0],["ἑσπέρας",705500,17]],"And whosoever shall touch her bed shall wash his garments, and bathe his body in water, and shall be unclean until evening."],["22",[["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["ἁπτόμενος",701654,122],["παντὸς",710177,92],["σκεύους",711844,21],["οὗ",709806,28],["ἐὰν",703912,7],["καθίσῃ",707006,172],["ἐπ᾿",705080,0],["αὐτό",702165,129],["πλυνεῖ",710564,127],["τὰ",709436,41],["ἱμάτια",706742,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["λούσεται",708258,93],["ὕδατι",713071,54],["καὶ",707031,7],["ἀκάθαρτος",700508,14],["ἔσται",704093,93],["ἕως",705792,0],["ἑσπέρας",705500,17]],"And every one that touches any vessel on which she shall sit, shall wash his garments and bathe himself in water, and shall be unclean until evening."],["23",[["ἐὰν",703912,7],["δὲ",703303,11],["ἐν",704639,0],["τῇ",709436,100],["κοίτῃ",707781,1],["αὐτῆς",702165,86],["οὔσης",704093,222],["ἢ",705924,7],["ἐπὶ",705080,0],["τοῦ",709436,20],["σκεύους",711844,21],["οὗ",709806,28],["ἐὰν",703912,7],["καθίσῃ",707006,172],["ἐπ᾿",705080,0],["αὐτῷ",702165,280],["ἐν",704639,0],["τῷ",709436,53],["ἅπτεσθαι",701654,110],["αὐτὸν",702165,85],["αὐτῆς",702165,86],["ἀκάθαρτος",700508,14],["ἔσται",704093,93],["ἕως",705792,0],["ἑσπέρας",705500,17]],"And whether it be while she is on her bed, or on a seat which she may happen to sit upon when he touches her, he shall be unclean till evening."],["24",[["ἐὰν",703912,7],["δὲ",703303,11],["κοίτῃ",707781,1],["τις",712866,158],["κοιμηθῇ",707767,384],["μετ᾿",708780,0],["αὐτῆς",702165,86],["καὶ",707031,7],["γένηται",703104,239],["ἡ",709436,10],["ἀκαθαρσία",700507,12],["αὐτῆς",702165,86],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["καὶ",707031,7],["ἀκάθαρτος",700508,14],["ἔσται",704093,93],["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["καὶ",707031,7],["πᾶσα",710177,29],["κοίτη",707781,12],["ἐφ᾿",705080,0],["ᾗ",709781,108],["ἂν",700900,11],["κοιμηθῇ",707767,384],["ἐπ᾿",705080,0],["αὐτῆς",702165,86],["ἀκάθαρτος",700508,29],["ἔσται",704093,93]],"And if any one shall lie with her, and her uncleanness be upon him, he shall be unclean seven days; and every bed on which he shall have lain shall be unclean."],["25",[["καὶ",707031,7],["γυνή",703209,12],["ἐὰν",703912,7],["ῥέῃ",711241,204],["ῥύσει",711312,1],["αἵματος",700442,21],["ἡμέρας",705984,39],["πλείους",710514,119],["οὐκ",709805,28],["ἐν",704639,0],["καιρῷ",707047,114],["τῆς",709436,16],["ἀφέδρου",702191,17],["αὐτῆς",702165,86],["ἐὰν",703912,7],["καὶ",707031,7],["ῥέῃ",711241,204],["μετὰ",708780,0],["τὴν",709436,8],["ἄφεδρον",702191,9],["αὐτῆς",702165,86],["πᾶσαι",710177,192],["αἱ",709436,190],["ἡμέραι",705984,191],["ῥύσεως",711312,17],["ἀκαθαρσίας",700507,17],["αὐτῆς",702165,86],["καθάπερ",706984,28],["αἱ",709436,190],["ἡμέραι",705984,191],["τῆς",709436,16],["ἀφέδρου",702191,17],["ἀκάθαρτος",700508,29],["ἔσται",704093,93]],"And if a woman have an issue of blood many days, not in the time of her separation; if the blood should also flow after her separation, all the days of the issue of her uncleanness [shall be] as the days of her separation: she shall be unclean."],["26",[["καὶ",707031,7],["πᾶσαν",710177,36],["κοίτην",707781,9],["ἐφ᾿",705080,0],["ἣν",709781,131],["ἂν",700900,11],["κοιμηθῇ",707767,384],["ἐπ᾿",705080,0],["αὐτῆς",702165,86],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["τῆς",709436,16],["ῥύσεως",711312,17],["κατὰ",707200,0],["τὴν",709436,8],["κοίτην",707781,9],["τῆς",709436,16],["ἀφέδρου",702191,17],["ἔσται",704093,93],["αὐτῇ",702165,105],["καὶ",707031,7],["πᾶν",710177,26],["σκεῦος",711844,15],["ἐφ᾿",705080,0],["ὃ",709781,128],["ἐὰν",703912,7],["καθίσῃ",707006,172],["ἐπ᾿",705080,0],["αὐτό",702165,129],["ἀκάθαρτον",700508,26],["ἔσται",704093,93],["κατὰ",707200,0],["τὴν",709436,8],["ἀκαθαρσίαν",700507,9],["τῆς",709436,16],["ἀφέδρου",702191,17]],"And every bed on which she shall lie all the days of her flux shall be to her as the bed of her separation, and every seat whereon she shall sit shall be unclean according to the uncleanness of her separation."],["27",[["πᾶς",710177,14],["ὁ",709436,3],["ἁπτόμενος",701654,122],["αὐτῆς",702165,86],["ἀκάθαρτος",700508,14],["ἔσται",704093,93],["καὶ",707031,7],["πλυνεῖ",710564,127],["τὰ",709436,41],["ἱμάτια",706742,42],["καὶ",707031,7],["λούσεται",708258,93],["τὸ",709436,24],["σῶμα",712635,25],["ὕδατι",713071,54],["καὶ",707031,7],["ἀκάθαρτος",700508,14],["ἔσται",704093,93],["ἕως",705792,0],["ἑσπέρας",705500,17]],"Every one that touches it shall be unclean; and he shall wash his garments, and bathe his body in water, and shall be unclean till evening."],["28",[["ἐὰν",703912,7],["δὲ",703303,11],["καθαρισθῇ",706985,384],["ἀπὸ",701425,0],["τῆς",709436,16],["ῥύσεως",711312,17],["καὶ",707031,7],["ἐξαριθμήσεται",704877,93],["αὐτῇ",702165,105],["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["καὶ",707031,7],["μετὰ",708780,0],["ταῦτα",709858,71],["καθαρισθήσεται",706985,134]],"But if she shall be cleansed from her flux, then she shall number to herself seven days, and afterwards she shall be esteemed clean."],["29",[["καὶ",707031,7],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["ὀγδόῃ",709444,101],["λήμψεται",708076,93],["αὐτῇ",702165,105],["δύο",703849,59],["τρυγόνας",713000,39],["ἢ",705924,7],["δύο",703849,59],["νεοσσοὺς",709257,57],["περιστερῶν",710391,65],["καὶ",707031,7],["οἴσει",713428,127],["αὐτὰ",702165,71],["πρὸς",710844,0],["τὸν",709436,5],["ἱερέα",706614,6],["ἐπὶ",705080,0],["τὴν",709436,8],["θύραν",706337,9],["τῆς",709436,16],["σκηνῆς",711845,17],["τοῦ",709436,20],["μαρτυρίου",708525,21]],"And on the eighth day she shall take two turtle-doves, or two young pigeons, and shall bring them to the priest, to the door of the tabernacle of witness."],["30",[["καὶ",707031,7],["ποιήσει",710582,127],["ὁ",709436,3],["ἱερεὺς",706614,4],["τὴν",709436,8],["μίαν",704106,36],["περὶ",710285,0],["ἁμαρτίας",700775,17],["καὶ",707031,7],["τὴν",709436,8],["μίαν",704106,36],["εἰς",704105,0],["ὁλοκαύτωμα",709589,25],["καὶ",707031,7],["ἐξιλάσεται",704932,93],["περὶ",710285,0],["αὐτῆς",702165,86],["ὁ",709436,3],["ἱερεὺς",706614,4],["ἔναντι",704653,0],["κυρίου",707996,18],["ἀπὸ",701425,0],["ῥύσεως",711312,17],["ἀκαθαρσίας",700507,17],["αὐτῆς",702165,86]],"And the priest shall offer one for a sin-offering, and the other for a whole-burnt-offering, and the priest shall make atonement for her before the Lord for her unclean flux."],["31",[["καὶ",707031,7],["εὐλαβεῖς",705628,138],["ποιήσετε",710582,337],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ισραηλ",706839,18],["ἀπὸ",701425,0],["τῶν",709436,130],["ἀκαθαρσιῶν",700507,65],["αὐτῶν",702165,40],["καὶ",707031,7],["οὐκ",709805,28],["ἀποθανοῦνται",701461,135],["διὰ",703417,0],["τὴν",709436,8],["ἀκαθαρσίαν",700507,9],["αὐτῶν",702165,40],["ἐν",704639,0],["τῷ",709436,53],["μιαίνειν",708900,55],["αὐτοὺς",702165,62],["τὴν",709436,8],["σκηνήν",711845,9],["μου",709032,133],["τὴν",709436,8],["ἐν",704639,0],["αὐτοῖς",702165,151]],"And ye shall cause the children of Israel to beware of their uncleannesses; so they shall not die for their uncleanness, in polluting my tabernacle that is among them."],["32",[["οὗτος",709858,121],["ὁ",709436,3],["νόμος",709349,4],["τοῦ",709436,35],["γονορρυοῦς",703170,116],["καὶ",707031,7],["ἐάν",703912,7],["τινι",712866,435],["ἐξέλθῃ",704909,172],["ἐξ",704132,0],["αὐτοῦ",702165,102],["κοίτη",707781,12],["σπέρματος",712008,21],["ὥστε",714164,7],["μιανθῆναι",708900,179],["ἐν",704639,0],["αὐτῇ",702165,105]],"This is the law of the man who has an issue, and if one discharge seed of copulation, so that he should be polluted by it."],["33",[["καὶ",707031,7],["τῇ",709436,100],["αἱμορροούσῃ",700449,220],["ἐν",704639,0],["τῇ",709436,100],["ἀφέδρῳ",702191,1],["αὐτῆς",702165,86],["καὶ",707031,7],["ὁ",709436,3],["γονορρυὴς",703170,14],["ἐν",704639,0],["τῇ",709436,100],["ῥύσει",711312,1],["αὐτοῦ",702165,102],["τῷ",709436,113],["ἄρσενι",701818,30],["ἢ",705924,7],["τῇ",709436,100],["θηλείᾳ",706237,101],["καὶ",707031,7],["τῷ",709436,113],["ἀνδρί",701150,114],["ὃς",709781,213],["ἂν",700900,11],["κοιμηθῇ",707767,384],["μετὰ",708780,0],["ἀποκαθημένης",701469,422]],"And [this is the law] for her that has the issue of blood in her separation, and as to the person who has an issue of seed, in his issue: [it is a law] for the male and the female, and for the man who shall have lain with her that is set apart."]]