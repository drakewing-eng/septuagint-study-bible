[["1",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["2",[["εἰπὸν",705373,176],["Ααρων",700005,114],["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτοῦ",702165,102],["καὶ",707031,7],["προσεχέτωσαν",710895,56],["ἀπὸ",701425,0],["τῶν",709436,43],["ἁγίων",700159,83],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["καὶ",707031,7],["οὐ",709805,28],["βεβηλώσουσιν",702614,218],["τὸ",709436,24],["ὄνομα",709666,25],["τὸ",709436,24],["ἅγιόν",700159,46],["μου",709032,133],["ὅσα",709788,68],["αὐτοὶ",702165,201],["ἁγιάζουσίν",700153,197],["μοι",708974,159],["ἐγὼ",704018,164],["κύριος",707996,4]],"Speak to Aaron and to his sons, and let them take heed concerning the holy things of the children of Israel, so they shall not profane my holy name in any of the things which they consecrate to me: I [am] the Lord."],["3",[["εἰπὸν",705373,176],["αὐτοῖς",702165,151],["εἰς",704105,0],["τὰς",709436,38],["γενεὰς",703037,39],["ὑμῶν",713091,145],["πᾶς",710177,14],["ἄνθρωπος",701163,4],["ὃς",709781,213],["ἂν",700900,11],["προσέλθῃ",710890,172],["ἀπὸ",701425,0],["παντὸς",710177,92],["τοῦ",709436,20],["σπέρματος",712008,21],["ὑμῶν",713091,145],["πρὸς",710844,0],["τὰ",709436,41],["ἅγια",700159,68],["ὅσα",709788,68],["ἂν",700900,11],["ἁγιάζωσιν",700153,271],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["ἡ",709436,10],["ἀκαθαρσία",700507,12],["αὐτοῦ",702165,102],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["ἐξολεθρευθήσεται",704956,134],["ἡ",709436,10],["ψυχὴ",714070,12],["ἐκείνη",704183,107],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"Say to them, Every man throughout your generations, whoever of all your seed shall approach to the holy things, whatsoever the children of Israel shall consecrate to the Lord, while his uncleanness is upon him, that soul shall be cut off from me: I [am] the Lord your God."],["4",[["καὶ",707031,7],["ἄνθρωπος",701163,4],["ἐκ",704132,0],["τοῦ",709436,20],["σπέρματος",712008,21],["Ααρων",700005,18],["τοῦ",709436,35],["ἱερέως",706614,18],["καὶ",707031,7],["οὗτος",709858,121],["λεπρᾷ",708150,91],["ἢ",705924,7],["γονορρυής",703170,14],["τῶν",709436,43],["ἁγίων",700159,83],["οὐκ",709805,28],["ἔδεται",705495,93],["ἕως",705792,7],["ἂν",700900,11],["καθαρισθῇ",706985,384],["καὶ",707031,7],["ὁ",709436,3],["ἁπτόμενος",701654,122],["πάσης",710177,82],["ἀκαθαρσίας",700507,17],["ψυχῆς",714070,17],["ἢ",705924,7],["ἄνθρωπος",701163,4],["ᾧ",709781,309],["ἂν",700900,11],["ἐξέλθῃ",704909,172],["ἐξ",704132,0],["αὐτοῦ",702165,102],["κοίτη",707781,12],["σπέρματος",712008,21]],"And the man of the seed of Aaron the priest, if he should have leprosy or issue of the reins, shall not eat of the holy things, until he be cleansed; and he that touches any uncleanness of a dead body, or the man whose seed of copulation shall have gone out from him,"],["5",[["ἢ",705924,7],["ὅστις",709793,425],["ἂν",700900,11],["ἅψηται",701654,239],["παντὸς",710177,92],["ἑρπετοῦ",705441,21],["ἀκαθάρτου",700508,92],["ὃ",709781,33],["μιανεῖ",708900,127],["αὐτόν",702165,85],["ἢ",705924,7],["ἐπ᾿",705080,0],["ἀνθρώπῳ",701163,114],["ἐν",704639,0],["ᾧ",709781,309],["μιανεῖ",708900,127],["αὐτὸν",702165,85],["κατὰ",707200,0],["πᾶσαν",710177,36],["ἀκαθαρσίαν",700507,9],["αὐτοῦ",702165,102]],"or whosoever shall touch any unclean reptile, which will defile him, or [who shall touch] a man, whereby he shall defile him according to all his uncleanness:"],["6",[["ψυχή",714070,12],["ἥτις",709793,412],["ἂν",700900,11],["ἅψηται",701654,239],["αὐτῶν",702165,40],["ἀκάθαρτος",700508,14],["ἔσται",704093,93],["ἕως",705792,0],["ἑσπέρας",705500,17],["οὐκ",709805,28],["ἔδεται",705495,93],["ἀπὸ",701425,0],["τῶν",709436,43],["ἁγίων",700159,83],["ἐὰν",703912,7],["μὴ",708851,28],["λούσηται",708258,239],["τὸ",709436,24],["σῶμα",712635,25],["αὐτοῦ",702165,102],["ὕδατι",713071,54]],"whatsoever soul shall touch them shall be unclean until evening; he shall not eat of the holy things, unless he bathe his body in water,"],["7",[["καὶ",707031,7],["δύῃ",703848,204],["ὁ",709436,3],["ἥλιος",705974,4],["καὶ",707031,7],["καθαρὸς",706988,14],["ἔσται",704093,93],["καὶ",707031,7],["τότε",712908,28],["φάγεται",713296,93],["τῶν",709436,43],["ἁγίων",700159,83],["ὅτι",709803,7],["ἄρτος",701829,4],["ἐστὶν",704093,91],["αὐτοῦ",702165,102]],"and the sun go down, and then he shall be clean; and then shall he eat of all the holy things, for they are his bread."],["8",[["θνησιμαῖον",706277,46],["καὶ",707031,7],["θηριάλωτον",706250,46],["οὐ",709805,28],["φάγεται",713296,93],["μιανθῆναι",708900,179],["αὐτὸν",702165,85],["ἐν",704639,0],["αὐτοῖς",702165,206],["ἐγὼ",704018,164],["κύριος",707996,4]],"He shall not eat that which dies of itself, or is taken of beasts, so that he should be polluted by them: I [am] the Lord."],["9",[["καὶ",707031,7],["φυλάξονται",713619,135],["τὰ",709436,41],["φυλάγματά",713612,42],["μου",709032,133],["ἵνα",706747,7],["μὴ",708851,28],["λάβωσιν",708076,234],["δι᾿",703417,0],["αὐτὰ",702165,71],["ἁμαρτίαν",700775,9],["καὶ",707031,7],["ἀποθάνωσιν",701461,234],["δι᾿",703417,0],["αὐτά",702165,71],["ἐὰν",703912,7],["βεβηλώσωσιν",702614,234],["αὐτά",702165,71],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["ἁγιάζων",700153,72],["αὐτούς",702165,62]],"And they shall keep my ordinances, that they do not bear iniquity because of them, and die because of them, if they shall profane them: I [am] the Lord God that sanctifies them."],["10",[["καὶ",707031,7],["πᾶς",710177,14],["ἀλλογενὴς",700690,14],["οὐ",709805,28],["φάγεται",713296,93],["ἅγια",700159,68],["πάροικος",710159,14],["ἱερέως",706614,18],["ἢ",705924,7],["μισθωτὸς",708942,14],["οὐ",709805,28],["φάγεται",713296,93],["ἅγια",700159,68]],"And no stranger shall eat the holy things: one that sojourns with a priest, or a hireling, shall not eat the holy things."],["11",[["ἐὰν",703912,7],["δὲ",703303,11],["ἱερεὺς",706614,4],["κτήσηται",707932,239],["ψυχὴν",714070,9],["ἔγκτητον",703997,36],["ἀργυρίου",701707,21],["οὗτος",709858,121],["φάγεται",713296,93],["ἐκ",704132,0],["τῶν",709436,80],["ἄρτων",701829,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["οἱ",709436,136],["οἰκογενεῖς",709508,138],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὗτοι",709858,201],["φάγονται",713296,135],["τῶν",709436,80],["ἄρτων",701829,81],["αὐτοῦ",702165,102]],"But if a priest should have a soul purchased for money, he shall eat of his bread; and they that are born in his house, they also shall eat of his bread."],["12",[["καὶ",707031,7],["θυγάτηρ",706320,12],["ἀνθρώπου",701163,18],["ἱερέως",706614,18],["ἐὰν",703912,7],["γένηται",703104,239],["ἀνδρὶ",701150,114],["ἀλλογενεῖ",700690,30],["αὐτὴ",702165,107],["τῶν",709436,130],["ἀπαρχῶν",701359,65],["τῶν",709436,43],["ἁγίων",700159,83],["οὐ",709805,28],["φάγεται",713296,93]],"And if the daughter of a priest should marry a stranger, she shall not eat of the offerings of the sanctuary."],["13",[["καὶ",707031,7],["θυγάτηρ",706320,12],["ἱερέως",706614,18],["ἐὰν",703912,7],["γένηται",703104,239],["χήρα",713848,12],["ἢ",705924,7],["ἐκβεβλημένη",704145,451],["σπέρμα",712008,15],["δὲ",703303,11],["μὴ",708851,28],["ἦν",704093,13],["αὐτῇ",702165,105],["ἐπαναστρέψει",705020,127],["ἐπὶ",705080,0],["τὸν",709436,5],["οἶκον",709516,6],["τὸν",709436,5],["πατρικὸν",710194,27],["κατὰ",707200,0],["τὴν",709436,8],["νεότητα",709258,9],["αὐτῆς",702165,86],["ἀπὸ",701425,0],["τῶν",709436,80],["ἄρτων",701829,81],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτῆς",702165,86],["φάγεται",713296,93],["καὶ",707031,7],["πᾶς",710177,14],["ἀλλογενὴς",700690,14],["οὐ",709805,28],["φάγεται",713296,93],["ἀπ᾿",701425,0],["αὐτῶν",702165,40]],"And if the daughter of a priest should be a widow, or put away, and have no seed, she shall return to her father's house, as in her youth: she shall eat of her father's bread, but no stranger shall eat of it."],["14",[["καὶ",707031,7],["ἄνθρωπος",701163,4],["ὃς",709781,213],["ἂν",700900,11],["φάγῃ",713296,172],["ἅγια",700159,68],["κατὰ",707200,0],["ἄγνοιαν",700177,9],["καὶ",707031,7],["προσθήσει",710965,127],["τὸ",709436,24],["ἐπίπεμπτον",705222,46],["αὐτοῦ",702165,49],["ἐπ᾿",705080,0],["αὐτὸ",702165,129],["καὶ",707031,7],["δώσει",703654,127],["τῷ",709436,113],["ἱερεῖ",706614,114],["τὸ",709436,24],["ἅγιον",700159,46]],"And the man who shall ignorantly eat holy things, shall add the fifth part to it, and give the holy thing to the priest."],["15",[["καὶ",707031,7],["οὐ",709805,28],["βεβηλώσουσιν",702614,218],["τὰ",709436,41],["ἅγια",700159,68],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ἃ",709781,69],["αὐτοὶ",702165,201],["ἀφαιροῦσιν",702177,197],["τῷ",709436,113],["κυρίῳ",707996,114]],"And they shall not profane the holy things of the children of Israel, which they offer to the Lord."],["16",[["καὶ",707031,7],["ἐπάξουσιν",704994,218],["ἐφ᾿",705080,0],["ἑαυτοὺς",703917,62],["ἀνομίαν",701192,9],["πλημμελείας",710533,17],["ἐν",704639,0],["τῷ",709436,53],["ἐσθίειν",705495,55],["αὐτοὺς",702165,62],["τὰ",709436,41],["ἅγια",700159,68],["αὐτῶν",702165,40],["ὅτι",709803,7],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["ἁγιάζων",700153,72],["αὐτούς",702165,62]],"So should they bring upon themselves the iniquity of trespass in their eating their holy things: for I [am] the Lord that sanctifies them."],["17",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["18",[["λάλησον",708071,176],["Ααρων",700005,114],["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτοῦ",702165,102],["καὶ",707031,7],["πάσῃ",710177,101],["συναγωγῇ",712376,1],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐρεῖς",705415,166],["πρὸς",710844,0],["αὐτούς",702165,62],["ἄνθρωπος",701163,4],["ἄνθρωπος",701163,4],["ἀπὸ",701425,0],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ἢ",705924,7],["τῶν",709436,80],["υἱῶν",713075,81],["τῶν",709436,80],["προσηλύτων",710900,81],["τῶν",709436,80],["προσκειμένων",710916,299],["πρὸς",710844,0],["αὐτοὺς",702165,62],["ἐν",704639,0],["Ισραηλ",706839,114],["ὃς",709781,213],["ἂν",700900,11],["προσενέγκῃ",710974,172],["τὰ",709436,41],["δῶρα",703907,42],["αὐτοῦ",702165,102],["κατὰ",707200,0],["πᾶσαν",710177,36],["ὁμολογίαν",709633,9],["αὐτῶν",702165,40],["ἢ",705924,7],["κατὰ",707200,0],["πᾶσαν",710177,36],["αἵρεσιν",700468,9],["αὐτῶν",702165,40],["ὅσα",709788,195],["ἂν",700900,11],["προσενέγκωσιν",710974,234],["τῷ",709436,113],["θεῷ",706192,114],["εἰς",704105,0],["ὁλοκαύτωμα",709589,25]],"Speak to Aaron and his sons, and to all the congregation of Israel, and thou shalt say to them, Any man of the children of Israel, or of the strangers that abide among them in Israel, who shall offer his gifts according to all their confession and according to all their choice, whatsoever they may bring to the Lord for whole-burnt-offerings—"],["19",[["δεκτὰ",703348,195],["ὑμῖν",713084,90],["ἄμωμα",700895,195],["ἄρσενα",701818,195],["ἐκ",704132,0],["τῶν",709436,43],["βουκολίων",702786,44],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,43],["προβάτων",710768,44],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,80],["αἰγῶν",700464,81]],"your free-will-offerings [shall] be males without blemish of the herds, or of the sheep, or of the goats."],["20",[["πάντα",710177,68],["ὅσα",709788,195],["ἂν",700900,11],["ἔχῃ",705785,204],["μῶμον",709102,6],["ἐν",704639,0],["αὐτῷ",702165,280],["οὐ",709805,28],["προσάξουσιν",710848,218],["κυρίῳ",707996,114],["διότι",703734,7],["οὐ",709805,28],["δεκτὸν",703348,26],["ἔσται",704093,93],["ὑμῖν",713084,90]],"They shall not bring to the Lord anything that has a blemish in it, for it shall not be acceptable for you."],["21",[["καὶ",707031,7],["ἄνθρωπος",701163,4],["ὃς",709781,213],["ἂν",700900,11],["προσενέγκῃ",710974,172],["θυσίαν",706345,9],["σωτηρίου",712659,21],["τῷ",709436,113],["κυρίῳ",707996,114],["διαστείλας",703588,182],["εὐχὴν",705726,9],["κατὰ",707200,0],["αἵρεσιν",700468,9],["ἢ",705924,7],["ἐν",704639,0],["ταῖς",709436,75],["ἑορταῖς",704990,76],["ὑμῶν",713091,145],["ἐκ",704132,0],["τῶν",709436,43],["βουκολίων",702786,44],["ἢ",705924,7],["ἐκ",704132,0],["τῶν",709436,43],["προβάτων",710768,44],["ἄμωμον",700895,26],["ἔσται",704093,93],["εἰς",704105,0],["δεκτόν",703348,46],["πᾶς",710177,14],["μῶμος",709102,4],["οὐκ",709805,28],["ἔσται",704093,93],["ἐν",704639,0],["αὐτῷ",702165,280]],"And whatsoever man shall offer a peace-offering to the Lord, discharging a vow, or in the way of free-will-offering, or an offering in your feasts, of the herds or of the sheep, it shall be without blemish for acceptance: there shall be no blemish in it."],["22",[["τυφλὸν",713031,46],["ἢ",705924,7],["συντετριμμένον",712520,448],["ἢ",705924,7],["γλωσσότμητον",703122,46],["ἢ",705924,7],["μυρμηκιῶντα",709068,237],["ἢ",705924,7],["ψωραγριῶντα",714080,237],["ἢ",705924,7],["λιχῆνας",708138,57],["ἔχοντα",705785,237],["οὐ",709805,28],["προσάξουσιν",710848,218],["ταῦτα",709858,71],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["εἰς",704105,0],["κάρπωσιν",707175,9],["οὐ",709805,28],["δώσετε",703654,337],["ἀπ᾿",701425,0],["αὐτῶν",702165,70],["ἐπὶ",705080,0],["τὸ",709436,24],["θυσιαστήριον",706348,25],["τῷ",709436,113],["κυρίῳ",707996,114]],"One that is blind, or broken, or has its tongue cut out, or is troubled with warts, or has a malignant ulcer, or tetters, they shall not offer these to the Lord; neither shall ye offer any of them for a burnt-offering on the altar of the Lord."],["23",[["καὶ",707031,7],["μόσχον",709029,6],["ἢ",705924,7],["πρόβατον",710768,25],["ὠτότμητον",714166,46],["ἢ",705924,7],["κολοβόκερκον",707796,46],["σφάγια",712570,42],["ποιήσεις",710582,166],["αὐτὰ",702165,71],["σεαυτῷ",711599,50],["εἰς",704105,0],["δὲ",703303,11],["εὐχήν",705726,9],["σου",711945,133],["οὐ",709805,28],["δεχθήσεται",703393,134]],"And a calf or a sheep with the ears cut off, or that has lost its tail, thou shalt slay them for thyself; but they shall not be accepted for thy vow."],["24",[["θλαδίαν",706271,6],["καὶ",707031,7],["ἐκτεθλιμμένον",704199,448],["καὶ",707031,7],["ἐκτομίαν",704337,6],["καὶ",707031,7],["ἀπεσπασμένον",701583,448],["οὐ",709805,28],["προσάξεις",710848,166],["αὐτὰ",702165,71],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ὑμῶν",713091,145],["οὐ",709805,28],["ποιήσετε",710582,337]],"That which has broken testicles, or is crushed or gelt or mutilated,—thou shalt not offer them to the Lord, neither shall ye sacrifice them upon your land."],["25",[["καὶ",707031,7],["ἐκ",704132,0],["χειρὸς",713787,17],["ἀλλογενοῦς",700690,116],["οὐ",709805,28],["προσοίσετε",710974,337],["τὰ",709436,41],["δῶρα",703907,42],["τοῦ",709436,35],["θεοῦ",706192,18],["ὑμῶν",713091,145],["ἀπὸ",701425,0],["πάντων",710177,83],["τούτων",709858,70],["ὅτι",709803,7],["φθάρματά",713440,64],["ἐστιν",704093,91],["ἐν",704639,0],["αὐτοῖς",702165,206],["μῶμος",709102,4],["ἐν",704639,0],["αὐτοῖς",702165,206],["οὐ",709805,28],["δεχθήσεται",703393,134],["ταῦτα",709858,290],["ὑμῖν",713084,90]],"Neither shall ye offer the gifts of your God of all these things by the hand of a stranger, because there is corruption in them, a blemish in them: these shall not be accepted for you."],["26",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["27",[["μόσχον",709029,6],["ἢ",705924,7],["πρόβατον",710768,25],["ἢ",705924,7],["αἶγα",700464,6],["ὡς",714148,7],["ἂν",700900,11],["τεχθῇ",712853,384],["καὶ",707031,7],["ἔσται",704093,93],["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["ὑπὸ",713184,0],["τὴν",709436,8],["μητέρα",708892,9],["τῇ",709436,100],["δὲ",703303,11],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["ὀγδόῃ",709444,101],["καὶ",707031,7],["ἐπέκεινα",705062,28],["δεχθήσεται",703393,134],["εἰς",704105,0],["δῶρα",703907,42],["κάρπωμα",707174,25],["κυρίῳ",707996,114]],"As for a calf, or a sheep, or a goat, whenever it is born, then shall it be seven days under its mother; and on the eighth day and after they shall be accepted for sacrifices, a burnt-offering to the Lord."],["28",[["καὶ",707031,7],["μόσχον",709029,6],["ἢ",705924,7],["πρόβατον",710768,25],["αὐτὴν",702165,104],["καὶ",707031,7],["τὰ",709436,41],["παιδία",709927,42],["αὐτῆς",702165,86],["οὐ",709805,28],["σφάξεις",712571,166],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["μιᾷ",704106,101]],"And a bullock and a ewe, it and its young, thou shalt not kill in one day."],["29",[["ἐὰν",703912,7],["δὲ",703303,11],["θύσῃς",706349,175],["θυσίαν",706345,9],["εὐχὴν",705726,9],["χαρμοσύνης",713746,17],["κυρίῳ",707996,114],["εἰς",704105,0],["δεκτὸν",703348,46],["ὑμῖν",713084,90],["θύσετε",706349,337],["αὐτό",702165,129]],"And if thou shouldest offer a sacrifice, a vow of rejoicing to the Lord, ye shall offer it so as to be accepted for you."],["30",[["αὐτῇ",702165,105],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["βρωθήσεται",702722,134],["οὐκ",709805,28],["ἀπολείψετε",701508,337],["ἀπὸ",701425,0],["τῶν",709436,43],["κρεῶν",707889,44],["εἰς",704105,0],["τὸ",709436,24],["πρωί",711021,28],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4]],"In that same day it shall be eaten; ye shall not leave of the flesh till the morrow: I am the Lord."],["31",[["καὶ",707031,7],["φυλάξετε",713619,337],["τὰς",709436,38],["ἐντολάς",704802,39],["μου",709032,133],["καὶ",707031,7],["ποιήσετε",710582,337],["αὐτάς",702165,231]],"And ye shall keep my commandments and do them."],["32",[["καὶ",707031,7],["οὐ",709805,28],["βεβηλώσετε",702614,337],["τὸ",709436,24],["ὄνομα",709666,25],["τοῦ",709436,20],["ἁγίου",700159,92],["καὶ",707031,7],["ἁγιασθήσομαι",700153,180],["ἐν",704639,0],["μέσῳ",708768,30],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["ἁγιάζων",700153,72],["ὑμᾶς",713080,194]],"And ye shall not profane the name of the Holy One, and I will be sanctified in the midst of the children of Israel. I [am] the Lord that sanctifies you,"],["33",[["ὁ",709436,3],["ἐξαγαγὼν",704834,182],["ὑμᾶς",713080,194],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["ὥστε",714164,7],["εἶναι",704093,55],["ὑμῶν",713091,145],["θεός",706192,4],["ἐγὼ",704018,164],["κύριος",707996,4]],"who brought you out of the land of Egypt, to be your God: I [am] the Lord."]]