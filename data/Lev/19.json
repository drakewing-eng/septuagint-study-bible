[["1",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["2",[["λάλησον",708071,176],["τῇ",709436,100],["συναγωγῇ",712376,1],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐρεῖς",705415,166],["πρὸς",710844,0],["αὐτούς",702165,62],["ἅγιοι",700159,138],["ἔσεσθε",704093,124],["ὅτι",709803,7],["ἐγὼ",704018,164],["ἅγιος",700159,14],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"Speak to the congregation of the children of Israel, and thou shalt say to them, Ye shall be holy; for I the Lord your God [am] holy."],["3",[["ἕκαστος",704133,14],["πατέρα",710189,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["μητέρα",708892,9],["αὐτοῦ",702165,102],["φοβείσθω",713532,407],["καὶ",707031,7],["τὰ",709436,41],["σάββατά",711350,42],["μου",709032,133],["φυλάξεσθε",713619,124],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"Let every one of you reverence his father and his mother; and ye shall keep my sabbaths: I [am] the Lord your God."],["4",[["οὐκ",709805,28],["ἐπακολουθήσετε",705007,337],["εἰδώλοις",704079,96],["καὶ",707031,7],["θεοὺς",706192,57],["χωνευτοὺς",714009,60],["οὐ",709805,28],["ποιήσετε",710582,337],["ὑμῖν",713084,90],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"Ye shall not follow idols, and ye shall not make to yourselves molten gods: I [am] the Lord your God."],["5",[["καὶ",707031,7],["ἐὰν",703912,7],["θύσητε",706349,125],["θυσίαν",706345,9],["σωτηρίου",712659,21],["τῷ",709436,113],["κυρίῳ",707996,114],["δεκτὴν",703348,36],["ὑμῶν",713091,145],["θύσετε",706349,337]],"And if ye will sacrifice a peace-offering to the Lord, ye shall offer it acceptable from yourselves."],["6",[["ᾗ",709781,108],["ἂν",700900,11],["ἡμέρᾳ",705984,1],["θύσητε",706349,125],["βρωθήσεται",702722,134],["καὶ",707031,7],["τῇ",709436,100],["αὔριον",702149,28],["καὶ",707031,7],["ἐὰν",703912,7],["καταλειφθῇ",707305,384],["ἕως",705792,0],["ἡμέρας",705984,17],["τρίτης",712968,82],["ἐν",704639,0],["πυρὶ",711088,54],["κατακαυθήσεται",707258,134]],"In what day soever ye shall sacrifice it, it shall be eaten; and on the following day, and if any of it should be left till the third day, it shall be thoroughly burnt with fire."],["7",[["ἐὰν",703912,7],["δὲ",703303,11],["βρώσει",702825,1],["βρωθῇ",702722,384],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["τρίτῃ",712968,101],["ἄθυτόν",700389,26],["ἐστιν",704093,91],["οὐ",709805,28],["δεχθήσεται",703393,134]],"And if it should be at all eaten on the third day, it is unfit for sacrifice: it shall not be accepted."],["8",[["ὁ",709436,3],["δὲ",703303,11],["ἔσθων",705495,72],["αὐτὸ",702165,129],["ἁμαρτίαν",700775,9],["λήμψεται",708076,93],["ὅτι",709803,7],["τὰ",709436,41],["ἅγια",700159,68],["κυρίου",707996,18],["ἐβεβήλωσεν",702614,2],["καὶ",707031,7],["ἐξολεθρευθήσονται",704956,144],["αἱ",709436,190],["ψυχαὶ",714070,191],["αἱ",709436,190],["ἔσθουσαι",705495,306],["ἐκ",704132,0],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτῶν",702165,40]],"And he that eats it shall bear his iniquity, because he has profaned the holy things of the Lord; and the souls that eat it shall be destroyed from among their people."],["9",[["καὶ",707031,7],["ἐκθεριζόντων",704194,170],["ὑμῶν",713091,145],["τὸν",709436,5],["θερισμὸν",706208,6],["τῆς",709436,16],["γῆς",703083,17],["ὑμῶν",713091,145],["οὐ",709805,28],["συντελέσετε",712510,337],["τὸν",709436,5],["θερισμὸν",706208,6],["ὑμῶν",713091,145],["τοῦ",709436,35],["ἀγροῦ",700196,18],["ἐκθερίσαι",704194,106],["καὶ",707031,7],["τὰ",709436,41],["ἀποπίπτοντα",701546,237],["τοῦ",709436,35],["θερισμοῦ",706208,18],["σου",711945,133],["οὐ",709805,28],["συλλέξεις",712263,166]],"And when ye reap the harvest of your land, ye shall not complete the reaping of your field with exactness, and thou shalt not gather that which falls from thy reaping."],["10",[["καὶ",707031,7],["τὸν",709436,5],["ἀμπελῶνά",700872,6],["σου",711945,133],["οὐκ",709805,28],["ἐπανατρυγήσεις",705021,166],["οὐδὲ",709816,7],["τοὺς",709436,58],["ῥῶγας",711324,57],["τοῦ",709436,35],["ἀμπελῶνός",700872,18],["σου",711945,133],["συλλέξεις",712263,166],["τῷ",709436,113],["πτωχῷ",711076,114],["καὶ",707031,7],["τῷ",709436,113],["προσηλύτῳ",710900,114],["καταλείψεις",707305,166],["αὐτά",702165,71],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"And thou shalt not go over the gathering of thy vineyard, neither shalt thou gather the remaining grapes of thy vineyard: thou shalt leave them for the poor and the stranger: I am the Lord your God."],["11",[["οὐ",709805,28],["κλέψετε",707715,337],["οὐ",709805,28],["ψεύσεσθε",714045,124],["οὐ",709805,28],["συκοφαντήσει",712256,127],["ἕκαστος",704133,14],["τὸν",709436,5],["πλησίον",710547,28]],"Ye shall not steal, ye shall not lie, neither shall one bear false witness as an informer against his neighbour."],["12",[["καὶ",707031,7],["οὐκ",709805,28],["ὀμεῖσθε",709620,124],["τῷ",709436,53],["ὀνόματί",709666,54],["μου",709032,133],["ἐπ᾿",705080,0],["ἀδίκῳ",700272,30],["καὶ",707031,7],["οὐ",709805,28],["βεβηλώσετε",702614,337],["τὸ",709436,24],["ὄνομα",709666,25],["τοῦ",709436,35],["θεοῦ",706192,18],["ὑμῶν",713091,145],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"And ye shall not swear unjustly by my name, and ye shall not profane the holy name of your God: I am the Lord your God."],["13",[["οὐκ",709805,28],["ἀδικήσεις",700269,166],["τὸν",709436,5],["πλησίον",710547,28],["καὶ",707031,7],["οὐχ",709805,28],["ἁρπάσεις",701804,166],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["κοιμηθήσεται",707767,134],["ὁ",709436,3],["μισθὸς",708939,4],["τοῦ",709436,35],["μισθωτοῦ",708942,116],["παρὰ",709995,0],["σοὶ",711925,159],["ἕως",705792,7],["πρωί",711021,28]],"Thou shalt not injure thy neighbour, neither do thou rob [him], neither shall the wages of thy hireling remain with thee until the morning."],["14",[["οὐ",709805,28],["κακῶς",707074,28],["ἐρεῖς",705415,166],["κωφὸν",708033,27],["καὶ",707031,7],["ἀπέναντι",701389,0],["τυφλοῦ",713031,116],["οὐ",709805,28],["προσθήσεις",710965,166],["σκάνδαλον",711825,25],["καὶ",707031,7],["φοβηθήσῃ",713532,364],["κύριον",707996,6],["τὸν",709436,5],["θεόν",706192,6],["σου",711945,133],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"Thou shalt not revile the deaf, neither shalt thou put a stumbling-block in the way of the blind; and thou shalt fear the Lord thy God: I am the Lord your God."],["15",[["οὐ",709805,28],["ποιήσετε",710582,337],["ἄδικον",700272,27],["ἐν",704639,0],["κρίσει",707908,1],["οὐ",709805,28],["λήμψῃ",708076,123],["πρόσωπον",710986,25],["πτωχοῦ",711076,18],["οὐδὲ",709816,7],["θαυμάσεις",706135,166],["πρόσωπον",710986,25],["δυνάστου",703844,18],["ἐν",704639,0],["δικαιοσύνῃ",703695,1],["κρινεῖς",707905,166],["τὸν",709436,5],["πλησίον",710547,28],["σου",711945,133]],"Thou shalt not act unjustly in judgment: thou shalt not accept the person of the poor, nor admire the person of the mighty; with justice shalt thou judge thy neighbour."],["16",[["οὐ",709805,28],["πορεύσῃ",710667,123],["δόλῳ",703787,114],["ἐν",704639,0],["τῷ",709436,53],["ἔθνει",704068,54],["σου",711945,133],["οὐκ",709805,28],["ἐπισυστήσῃ",705283,123],["ἐφ᾿",705080,0],["αἷμα",700442,25],["τοῦ",709436,35],["πλησίον",710547,28],["σου",711945,133],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"Thou shalt not walk deceitfully among thy people; thou shalt not rise up against the blood of thy neighbour: I am the Lord your God."],["17",[["οὐ",709805,28],["μισήσεις",708935,166],["τὸν",709436,5],["ἀδελφόν",700249,6],["σου",711945,133],["τῇ",709436,100],["διανοίᾳ",703531,1],["σου",711945,133],["ἐλεγμῷ",704413,114],["ἐλέγξεις",704416,166],["τὸν",709436,5],["πλησίον",710547,28],["σου",711945,133],["καὶ",707031,7],["οὐ",709805,28],["λήμψῃ",708076,123],["δι᾿",703417,0],["αὐτὸν",702165,85],["ἁμαρτίαν",700775,9]],"Thou shalt not hate thy brother in thine heart: thou shalt in any wise rebuke thy neighbour, so thou shalt not bear sin on his account."],["18",[["καὶ",707031,7],["οὐκ",709805,28],["ἐκδικᾶταί",704173,93],["σου",711945,133],["ἡ",709436,10],["χείρ",713787,12],["καὶ",707031,7],["οὐ",709805,28],["μηνιεῖς",708880,166],["τοῖς",709436,147],["υἱοῖς",713075,148],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133],["καὶ",707031,7],["ἀγαπήσεις",700120,166],["τὸν",709436,5],["πλησίον",710547,28],["σου",711945,133],["ὡς",714148,7],["σεαυτόν",711599,85],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4]],"And thy hand shall not avenge thee; and thou shalt not be angry with the children of thy people; and thou shalt love thy neighbour as thyself; I am the Lord."],["19",[["τὸν",709436,5],["νόμον",709349,6],["μου",709032,133],["φυλάξεσθε",713619,124],["τὰ",709436,41],["κτήνη",707934,42],["σου",711945,133],["οὐ",709805,28],["κατοχεύσεις",707553,166],["ἑτεροζύγῳ",705533,97],["καὶ",707031,7],["τὸν",709436,5],["ἀμπελῶνά",700872,6],["σου",711945,133],["οὐ",709805,28],["κατασπερεῖς",707432,166],["διάφορον",703630,46],["καὶ",707031,7],["ἱμάτιον",706742,25],["ἐκ",704132,0],["δύο",703849,59],["ὑφασμένον",713275,448],["κίβδηλον",707666,46],["οὐκ",709805,28],["ἐπιβαλεῖς",705083,166],["σεαυτῷ",711599,50]],"Ye shall observe my law: thou shalt not let thy cattle gender with one of a different kind, and thou shalt not sow thy vineyard with diverse seed; and thou shalt not put upon thyself a mingled garment woven of two [materials]."],["20",[["καὶ",707031,7],["ἐάν",703912,7],["τις",712866,158],["κοιμηθῇ",707767,384],["μετὰ",708780,0],["γυναικὸς",703209,17],["κοίτην",707781,9],["σπέρματος",712008,21],["καὶ",707031,7],["αὐτὴ",702165,107],["οἰκέτις",709498,12],["διαπεφυλαγμένη",703632,451],["ἀνθρώπῳ",701163,114],["καὶ",707031,7],["αὐτὴ",702165,107],["λύτροις",708281,96],["οὐ",709805,28],["λελύτρωται",708282,403],["ἢ",705924,7],["ἐλευθερία",704427,12],["οὐκ",709805,28],["ἐδόθη",703654,37],["αὐτῇ",702165,105],["ἐπισκοπὴ",705255,12],["ἔσται",704093,93],["αὐτοῖς",702165,151],["οὐκ",709805,28],["ἀποθανοῦνται",701461,135],["ὅτι",709803,7],["οὐκ",709805,28],["ἀπηλευθερώθη",701387,37]],"And if any one lie carnally with a woman, and she should be a home-servant kept for a man, and she has not been ransomed, [and] her freedom has not been given to her, they shall be visited [with punishment]; but they shall not die, because she was not set at liberty."],["21",[["καὶ",707031,7],["προσάξει",710848,127],["τῆς",709436,16],["πλημμελείας",710533,17],["αὐτοῦ",702165,102],["τῷ",709436,113],["κυρίῳ",707996,114],["παρὰ",709995,0],["τὴν",709436,8],["θύραν",706337,9],["τῆς",709436,16],["σκηνῆς",711845,17],["τοῦ",709436,20],["μαρτυρίου",708525,21],["κριὸν",707906,6],["πλημμελείας",710533,17]],"And he shall bring for his trespass to the Lord to the door of the tabernacle of witness, a ram for a trespass-offering."],["22",[["καὶ",707031,7],["ἐξιλάσεται",704932,93],["περὶ",710285,0],["αὐτοῦ",702165,102],["ὁ",709436,3],["ἱερεὺς",706614,4],["ἐν",704639,0],["τῷ",709436,113],["κριῷ",707906,114],["τῆς",709436,16],["πλημμελείας",710533,17],["ἔναντι",704653,0],["κυρίου",707996,18],["περὶ",710285,0],["τῆς",709436,16],["ἁμαρτίας",700775,17],["ἧς",709781,167],["ἥμαρτεν",700773,2],["καὶ",707031,7],["ἀφεθήσεται",702211,134],["αὐτῷ",702165,50],["ἡ",709436,10],["ἁμαρτία",700775,12],["ἣν",709781,131],["ἥμαρτεν",700773,2]],"And the priest shall make atonement for him with the ram of the trespass-offering, before the Lord, for the sin which he sinned; and the sin which he sinned shall be forgiven him."],["23",[["ὅταν",709801,28],["δὲ",703303,11],["εἰσέλθητε",704114,125],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["δίδωσιν",703654,91],["ὑμῖν",713084,90],["καὶ",707031,7],["καταφυτεύσετε",707487,337],["πᾶν",710177,46],["ξύλον",709427,25],["βρώσιμον",702824,46],["καὶ",707031,7],["περικαθαριεῖτε",710322,337],["τὴν",709436,8],["ἀκαθαρσίαν",700507,9],["αὐτοῦ",702165,49],["ὁ",709436,3],["καρπὸς",707169,4],["αὐτοῦ",702165,49],["τρία",712927,68],["ἔτη",705543,42],["ἔσται",704093,93],["ὑμῖν",713084,90],["ἀπερικάθαρτος",701395,14],["οὐ",709805,28],["βρωθήσεται",702722,134]],"And whenever ye shall enter into the land which the Lord your God gives you, and shall plant any fruit-tree, then shall ye purge away its uncleanness; its fruit shall be three years uncleansed to you, it shall not be eaten."],["24",[["καὶ",707031,7],["τῷ",709436,53],["ἔτει",705543,54],["τῷ",709436,53],["τετάρτῳ",712811,97],["ἔσται",704093,93],["πᾶς",710177,14],["ὁ",709436,3],["καρπὸς",707169,4],["αὐτοῦ",702165,102],["ἅγιος",700159,14],["αἰνετὸς",700458,14],["τῷ",709436,113],["κυρίῳ",707996,114]],"And in the fourth year all its fruit shall be holy, a subject of praise to the Lord."],["25",[["ἐν",704639,0],["δὲ",703303,11],["τῷ",709436,53],["ἔτει",705543,54],["τῷ",709436,53],["πέμπτῳ",710245,97],["φάγεσθε",705495,124],["τὸν",709436,5],["καρπόν",707169,6],["πρόσθεμα",710904,15],["ὑμῖν",713084,90],["τὰ",709436,63],["γενήματα",703052,64],["αὐτοῦ",702165,102],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"And in the fifth year ye shall eat the fruit, its produce is an increase to you. I am the Lord your God."],["26",[["μὴ",708851,28],["ἔσθετε",705495,335],["ἐπὶ",705080,0],["τῶν",709436,43],["ὀρέων",709768,44],["καὶ",707031,7],["οὐκ",709805,28],["οἰωνιεῖσθε",709540,124],["οὐδὲ",709816,7],["ὀρνιθοσκοπήσεσθε",709765,124]],"Eat not on the mountains, nor shall ye employ auguries, nor divine by inspection of birds."],["27",[["οὐ",709805,28],["ποιήσετε",710582,337],["σισόην",711805,9],["ἐκ",704132,0],["τῆς",709436,16],["κόμης",707803,17],["τῆς",709436,16],["κεφαλῆς",707639,17],["ὑμῶν",713091,145],["οὐδὲ",709816,7],["φθερεῖτε",713445,337],["τὴν",709436,8],["ὄψιν",709901,9],["τοῦ",709436,35],["πώγωνος",711115,18],["ὑμῶν",713091,145]],"Ye shall not make a round cutting of the hair of your head, nor disfigure your beard."],["28",[["καὶ",707031,7],["ἐντομίδας",704803,39],["ἐπὶ",705080,0],["ψυχῇ",714070,1],["οὐ",709805,28],["ποιήσετε",710582,337],["ἐν",704639,0],["τῷ",709436,53],["σώματι",712635,54],["ὑμῶν",713091,145],["καὶ",707031,7],["γράμματα",703183,42],["στικτὰ",712105,68],["οὐ",709805,28],["ποιήσετε",710582,337],["ἐν",704639,0],["ὑμῖν",713084,90],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"And ye shall not make cuttings in your body for a [dead] body, and ye shall not inscribe on yourselves any marks. I am the Lord your God."],["29",[["οὐ",709805,28],["βεβηλώσεις",702614,166],["τὴν",709436,8],["θυγατέρα",706320,9],["σου",711945,133],["ἐκπορνεῦσαι",704295,106],["αὐτήν",702165,104],["καὶ",707031,7],["οὐκ",709805,28],["ἐκπορνεύσει",704295,127],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["ἡ",709436,10],["γῆ",703083,12],["πλησθήσεται",710532,134],["ἀνομίας",701192,17]],"Thou shalt not profane thy daughter to prostitute her; so the land shall not go a whoring, and the land be filled with iniquity."],["30",[["τὰ",709436,41],["σάββατά",711350,42],["μου",709032,133],["φυλάξεσθε",713619,124],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,43],["ἁγίων",700159,83],["μου",709032,133],["φοβηθήσεσθε",713532,261],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4]],"Ye shall keep my sabbaths, and reverence my sanctuaries: I am the Lord."],["31",[["οὐκ",709805,28],["ἐπακολουθήσετε",705007,337],["ἐγγαστριμύθοις",703938,230],["καὶ",707031,7],["τοῖς",709436,147],["ἐπαοιδοῖς",705035,148],["οὐ",709805,28],["προσκολληθήσεσθε",710921,261],["ἐκμιανθῆναι",704261,179],["ἐν",704639,0],["αὐτοῖς",702165,151],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"Ye shall not attend to those who have in them divining spirits, nor attach yourselves to enchanters, to pollute yourselves with them: I am the Lord your God."],["32",[["ἀπὸ",701425,0],["προσώπου",710986,21],["πολιοῦ",710611,116],["ἐξαναστήσῃ",704865,123],["καὶ",707031,7],["τιμήσεις",712855,166],["πρόσωπον",710986,25],["πρεσβυτέρου",710735,229],["καὶ",707031,7],["φοβηθήσῃ",713532,364],["τὸν",709436,5],["θεόν",706192,6],["σου",711945,133],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"Thou shalt rise up before the hoary head, and honour the face of the old man, and shalt fear thy God: I am the Lord your God."],["33",[["ἐὰν",703912,7],["δέ",703303,11],["τις",712866,158],["προσέλθῃ",710890,172],["προσήλυτος",710900,4],["ὑμῖν",713084,90],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ὑμῶν",713091,145],["οὐ",709805,28],["θλίψετε",706274,337],["αὐτόν",702165,85]],"And if there should come to you a stranger in your land, ye shall not afflict him."],["34",[["ὡς",714148,7],["ὁ",709436,3],["αὐτόχθων",702168,4],["ἐν",704639,0],["ὑμῖν",713084,90],["ἔσται",704093,93],["ὁ",709436,3],["προσήλυτος",710900,4],["ὁ",709436,3],["προσπορευόμενος",710954,122],["πρὸς",710844,0],["ὑμᾶς",713080,194],["καὶ",707031,7],["ἀγαπήσεις",700120,166],["αὐτὸν",702165,85],["ὡς",714148,7],["σεαυτόν",711599,85],["ὅτι",709803,7],["προσήλυτοι",710900,52],["ἐγενήθητε",703104,472],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτῳ",700401,1],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"The stranger that comes to you shall be among you as the native, and thou shalt love him as thyself; for ye were strangers in the land of Egypt: I am the Lord your God."],["35",[["οὐ",709805,28],["ποιήσετε",710582,337],["ἄδικον",700272,27],["ἐν",704639,0],["κρίσει",707908,1],["ἐν",704639,0],["μέτροις",708846,96],["καὶ",707031,7],["ἐν",704639,0],["σταθμίοις",712039,96],["καὶ",707031,7],["ἐν",704639,0],["ζυγοῖς",705894,96]],"Ye shall not act unrighteously in judgment, in measures and weights and scales."],["36",[["ζυγὰ",705894,64],["δίκαια",703694,195],["καὶ",707031,7],["στάθμια",712039,64],["δίκαια",703694,195],["καὶ",707031,7],["χοῦς",713930,4],["δίκαιος",703694,14],["ἔσται",704093,93],["ὑμῖν",713084,90],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["ὁ",709436,3],["ἐξαγαγὼν",704834,182],["ὑμᾶς",713080,194],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17]],"There shall be among you just balances and just weights and a just liquid measure. I am the Lord your God, who brought you out of the land of Egypt."],["37",[["καὶ",707031,7],["φυλάξεσθε",713619,124],["πάντα",710177,27],["τὸν",709436,5],["νόμον",709349,6],["μου",709032,133],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["προστάγματά",710959,42],["μου",709032,133],["καὶ",707031,7],["ποιήσετε",710582,337],["αὐτά",702165,71],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"And ye shall keep all my law and all my ordinances, and ye shall do them: I am the Lord your God."]]