[["1",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["2",[["λάλησον",708071,176],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐρεῖς",705415,166],["αὐτοῖς",702165,151],["ὃς",709781,213],["ἂν",700900,11],["εὔξηται",705727,239],["εὐχὴν",705726,9],["ὥστε",714164,7],["τιμὴν",712856,9],["τῆς",709436,16],["ψυχῆς",714070,17],["αὐτοῦ",702165,102],["τῷ",709436,113],["κυρίῳ",707996,114]],"Speak to the children of Israel, and thou shalt say to them, Whosoever shall vow a vow as the valuation of his soul for the Lord,"],["3",[["ἔσται",704093,93],["ἡ",709436,10],["τιμὴ",712856,12],["τοῦ",709436,35],["ἄρσενος",701818,116],["ἀπὸ",701425,0],["εἰκοσαετοῦς",704084,116],["ἕως",705792,0],["ἑξηκονταετοῦς",704923,116],["ἔσται",704093,93],["αὐτοῦ",702165,102],["ἡ",709436,10],["τιμὴ",712856,12],["πεντήκοντα",710270,59],["δίδραχμα",703651,64],["ἀργυρίου",701707,21],["τῷ",709436,113],["σταθμῷ",712040,114],["τῷ",709436,113],["ἁγίῳ",700159,30]],"the valuation of a male from twenty years old to sixty years old shall be—his valuation shall be fifty didrachms of silver by the standard of the sanctuary."],["4",[["τῆς",709436,16],["δὲ",703303,11],["θηλείας",706237,82],["ἔσται",704093,93],["ἡ",709436,10],["συντίμησις",712514,12],["τριάκοντα",712934,59],["δίδραχμα",703651,64]],"And the valuation of a female shall be thirty didrachms."],["5",[["ἐὰν",703912,7],["δὲ",703303,11],["ἀπὸ",701425,0],["πενταετοῦς",710258,116],["ἕως",705792,0],["εἴκοσι",704085,59],["ἐτῶν",705543,44],["ἔσται",704093,93],["ἡ",709436,10],["τιμὴ",712856,12],["τοῦ",709436,35],["ἄρσενος",701818,116],["εἴκοσι",704085,59],["δίδραχμα",703651,64],["τῆς",709436,16],["δὲ",703303,11],["θηλείας",706237,82],["δέκα",703333,59],["δίδραχμα",703651,64]],"And if it be from five years old to twenty, the valuation of a male shall be twenty didrachms, and of a female ten didrachms."],["6",[["ἀπὸ",701425,0],["δὲ",703303,11],["μηνιαίου",708875,116],["ἕως",705792,0],["πενταετοῦς",710258,116],["ἔσται",704093,93],["ἡ",709436,10],["τιμὴ",712856,12],["τοῦ",709436,35],["ἄρσενος",701818,116],["πέντε",710266,59],["δίδραχμα",703651,64],["ἀργυρίου",701707,21],["τῆς",709436,16],["δὲ",703303,11],["θηλείας",706237,82],["τρία",712927,195],["δίδραχμα",703651,64]],"And from a month old to five years old, the valuation of a male shall be five didrachms, and of a female, three didrachms of silver."],["7",[["ἐὰν",703912,7],["δὲ",703303,11],["ἀπὸ",701425,0],["ἑξηκονταετῶν",704923,169],["καὶ",707031,7],["ἐπάνω",705030,28],["ἐὰν",703912,7],["μὲν",708730,11],["ἄρσεν",701818,26],["ᾖ",704093,204],["ἔσται",704093,93],["ἡ",709436,10],["τιμὴ",712856,12],["πεντεκαίδεκα",710267,59],["δίδραχμα",703651,64],["ἀργυρίου",701707,21],["ἐὰν",703912,7],["δὲ",703303,11],["θήλεια",706237,29],["δέκα",703333,59],["δίδραχμα",703651,64]],"And if from sixty years [old] and upward, if it be a male, his valuation shall be fifteen didrachms of silver, and if a female, ten didrachms."],["8",[["ἐὰν",703912,7],["δὲ",703303,11],["ταπεινὸς",712714,14],["ᾖ",704093,204],["τῇ",709436,100],["τιμῇ",712856,1],["στήσεται",706846,93],["ἐναντίον",704654,0],["τοῦ",709436,35],["ἱερέως",706614,18],["καὶ",707031,7],["τιμήσεται",712855,93],["αὐτὸν",702165,85],["ὁ",709436,3],["ἱερεύς",706614,4],["καθάπερ",706984,28],["ἰσχύει",706859,91],["ἡ",709436,10],["χεὶρ",713787,12],["τοῦ",709436,35],["εὐξαμένου",705727,292],["τιμήσεται",712855,93],["αὐτὸν",702165,85],["ὁ",709436,3],["ἱερεύς",706614,4]],"And if the man be too poor for the valuation, he shall stand before the priest; and the priest shall value him: according to what the man who has vowed can afford, the priest shall value him."],["9",[["ἐὰν",703912,7],["δὲ",703303,11],["ἀπὸ",701425,0],["τῶν",709436,43],["κτηνῶν",707934,44],["τῶν",709436,43],["προσφερομένων",710974,369],["ἀπ᾿",701425,0],["αὐτῶν",702165,70],["δῶρον",703907,15],["τῷ",709436,113],["κυρίῳ",707996,114],["ὃς",709781,213],["ἂν",700900,11],["δῷ",703654,172],["ἀπὸ",701425,0],["τούτων",709858,70],["τῷ",709436,113],["κυρίῳ",707996,114],["ἔσται",704093,93],["ἅγιον",700159,26]],"And if it be from the cattle that are offered as a gift to the Lord, whoever shall offer one of these to the Lord, it shall be holy."],["10",[["οὐκ",709805,28],["ἀλλάξει",700683,127],["αὐτὸ",702165,129],["καλὸν",707097,46],["πονηρῷ",710660,97],["οὐδὲ",709816,7],["πονηρὸν",710660,46],["καλῷ",707097,97],["ἐὰν",703912,7],["δὲ",703303,11],["ἀλλάσσων",700683,72],["ἀλλάξῃ",700683,172],["αὐτὸ",702165,129],["κτῆνος",707934,25],["κτήνει",707934,54],["ἔσται",704093,93],["αὐτὸ",702165,132],["καὶ",707031,7],["τὸ",709436,34],["ἄλλαγμα",700682,15],["ἅγια",700159,195]],"He shall not change it, a good for a bad, or a bad for a good; and if he do at all change it, a beast for a beast, it and the substitute shall be holy."],["11",[["ἐὰν",703912,7],["δὲ",703303,11],["πᾶν",710177,26],["κτῆνος",707934,15],["ἀκάθαρτον",700508,26],["ἀφ᾿",701425,0],["ὧν",709781,103],["οὐ",709805,28],["προσφέρεται",710974,391],["ἀπ᾿",701425,0],["αὐτῶν",702165,70],["δῶρον",703907,15],["τῷ",709436,113],["κυρίῳ",707996,114],["στήσει",706846,127],["τὸ",709436,34],["κτῆνος",707934,15],["ἔναντι",704653,0],["τοῦ",709436,35],["ἱερέως",706614,18]],"And if it be any unclean beast, of which none are offered as a gift to the Lord, he shall set the beast before the priest."],["12",[["καὶ",707031,7],["τιμήσεται",712855,93],["αὐτὸ",702165,129],["ὁ",709436,3],["ἱερεὺς",706614,4],["ἀνὰ",700902,0],["μέσον",708768,46],["καλοῦ",707097,92],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,46],["πονηροῦ",710660,92],["καὶ",707031,7],["καθότι",707021,28],["ἂν",700900,11],["τιμήσεται",712855,93],["ὁ",709436,3],["ἱερεύς",706614,4],["οὕτως",709859,28],["στήσεται",706846,93]],"And the priest shall make a valuation between the good and the bad, and accordingly as the priest shall value it, so shall it stand."],["13",[["ἐὰν",703912,7],["δὲ",703303,11],["λυτρούμενος",708282,122],["λυτρώσηται",708282,239],["αὐτό",702165,129],["προσθήσει",710965,127],["τὸ",709436,24],["ἐπίπεμπτον",705222,46],["πρὸς",710844,0],["τὴν",709436,8],["τιμὴν",712856,9],["αὐτοῦ",702165,49]],"And if [the worshipper] will at all redeem it, he shall add the fifth part to its value."],["14",[["καὶ",707031,7],["ἄνθρωπος",701163,4],["ὃς",709781,213],["ἂν",700900,11],["ἁγιάσῃ",700153,172],["τὴν",709436,8],["οἰκίαν",709505,9],["αὐτοῦ",702165,102],["ἁγίαν",700159,36],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["τιμήσεται",712855,93],["αὐτὴν",702165,104],["ὁ",709436,3],["ἱερεὺς",706614,4],["ἀνὰ",700902,0],["μέσον",708768,46],["καλῆς",707097,82],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,46],["πονηρᾶς",710660,82],["ὡς",714148,7],["ἂν",700900,11],["τιμήσεται",712855,93],["αὐτὴν",702165,104],["ὁ",709436,3],["ἱερεύς",706614,4],["οὕτως",709859,28],["σταθήσεται",706846,134]],"And whatsoever man shall consecrate his house as holy to the Lord, the priest shall make a valuation of it between the good and the bad: as the priest shall value it, so shall it stand."],["15",[["ἐὰν",703912,7],["δὲ",703303,11],["ὁ",709436,3],["ἁγιάσας",700153,182],["αὐτὴν",702165,104],["λυτρῶται",708282,428],["τὴν",709436,8],["οἰκίαν",709505,9],["αὐτοῦ",702165,102],["προσθήσει",710965,127],["ἐπ᾿",705080,0],["αὐτὸ",702165,129],["τὸ",709436,24],["ἐπίπεμπτον",705222,46],["τοῦ",709436,20],["ἀργυρίου",701707,21],["τῆς",709436,16],["τιμῆς",712856,17],["καὶ",707031,7],["ἔσται",704093,93],["αὐτῷ",702165,50]],"And if he that has sanctified it should redeem his house, he shall add to it the fifth part of the money of the valuation, and it shall be his."],["16",[["ἐὰν",703912,7],["δὲ",703303,11],["ἀπὸ",701425,0],["τοῦ",709436,35],["ἀγροῦ",700196,18],["τῆς",709436,16],["κατασχέσεως",707451,17],["αὐτοῦ",702165,102],["ἁγιάσῃ",700153,172],["ἄνθρωπος",701163,4],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["τιμὴ",712856,12],["κατὰ",707200,0],["τὸν",709436,5],["σπόρον",712030,6],["αὐτοῦ",702165,102],["κόρου",707841,18],["κριθῶν",707900,65],["πεντήκοντα",710270,59],["δίδραχμα",703651,64],["ἀργυρίου",701707,21]],"And if a man should hallow to the Lord a part of the field of his possession, then the valuation shall be according to its seed, fifty didrachms of silver for a homer of barley."],["17",[["ἐὰν",703912,7],["δὲ",703303,11],["ἀπὸ",701425,0],["τοῦ",709436,35],["ἐνιαυτοῦ",704745,18],["τῆς",709436,16],["ἀφέσεως",702199,17],["ἁγιάσῃ",700153,172],["τὸν",709436,5],["ἀγρὸν",700196,6],["αὐτοῦ",702165,102],["κατὰ",707200,0],["τὴν",709436,8],["τιμὴν",712856,9],["αὐτοῦ",702165,102],["στήσεται",706846,93]],"And if he should sanctify his field from the year of release, it shall stand according to his valuation."],["18",[["ἐὰν",703912,7],["δὲ",703303,11],["ἔσχατον",705519,27],["μετὰ",708780,0],["τὴν",709436,8],["ἄφεσιν",702199,9],["ἁγιάσῃ",700153,172],["τὸν",709436,5],["ἀγρὸν",700196,6],["αὐτοῦ",702165,102],["προσλογιεῖται",710931,93],["αὐτῷ",702165,50],["ὁ",709436,3],["ἱερεὺς",706614,4],["τὸ",709436,24],["ἀργύριον",701707,25],["ἐπὶ",705080,0],["τὰ",709436,41],["ἔτη",705543,42],["τὰ",709436,41],["ἐπίλοιπα",705194,68],["ἕως",705792,7],["εἰς",704105,0],["τὸν",709436,5],["ἐνιαυτὸν",704745,6],["τῆς",709436,16],["ἀφέσεως",702199,17],["καὶ",707031,7],["ἀνθυφαιρεθήσεται",701164,134],["ἀπὸ",701425,0],["τῆς",709436,16],["συντιμήσεως",712514,17],["αὐτοῦ",702165,102]],"And if he should sanctify his field in the latter time after the release, the priest shall reckon to him the money for the remaining years, until the [next] year of release, and it shall be deducted as an equivalent from his full valuation."],["19",[["ἐὰν",703912,7],["δὲ",703303,11],["λυτρῶται",708282,428],["τὸν",709436,5],["ἀγρὸν",700196,6],["ὁ",709436,3],["ἁγιάσας",700153,182],["αὐτόν",702165,85],["προσθήσει",710965,127],["τὸ",709436,24],["ἐπίπεμπτον",705222,46],["τοῦ",709436,20],["ἀργυρίου",701707,21],["πρὸς",710844,0],["τὴν",709436,8],["τιμὴν",712856,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔσται",704093,93],["αὐτῷ",702165,50]],"And if he that sanctified the field would redeem it, he shall add to its value the fifth part of the money, and it shall be his."],["20",[["ἐὰν",703912,7],["δὲ",703303,11],["μὴ",708851,28],["λυτρῶται",708282,428],["τὸν",709436,5],["ἀγρὸν",700196,6],["καὶ",707031,7],["ἀποδῶται",701449,239],["τὸν",709436,5],["ἀγρὸν",700196,6],["ἀνθρώπῳ",701163,114],["ἑτέρῳ",705535,30],["οὐκέτι",709827,28],["μὴ",708851,28],["λυτρώσηται",708282,239],["αὐτόν",702165,85]],"And if he do not redeem the field, but should sell the field to another man, he shall not after redeem it."],["21",[["ἀλλ᾿",700680,7],["ἔσται",704093,93],["ὁ",709436,3],["ἀγρὸς",700196,4],["ἐξεληλυθυίας",704909,479],["τῆς",709436,16],["ἀφέσεως",702199,17],["ἅγιος",700159,14],["τῷ",709436,113],["κυρίῳ",707996,114],["ὥσπερ",714163,28],["ἡ",709436,10],["γῆ",703083,12],["ἡ",709436,10],["ἀφωρισμένη",702227,451],["τῷ",709436,113],["ἱερεῖ",706614,114],["ἔσται",704093,93],["κατάσχεσις",707451,12]],"But the field shall be holy to the Lord after the release, as separated land; the priest shall have possession of it."],["22",[["ἐὰν",703912,7],["δὲ",703303,11],["ἀπὸ",701425,0],["τοῦ",709436,35],["ἀγροῦ",700196,18],["οὗ",709781,48],["κέκτηται",707932,187],["ὃς",709781,213],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀπὸ",701425,0],["τοῦ",709436,35],["ἀγροῦ",700196,18],["τῆς",709436,16],["κατασχέσεως",707451,17],["αὐτοῦ",702165,102],["ἁγιάσῃ",700153,172],["τῷ",709436,113],["κυρίῳ",707996,114]],"And if he should consecrate to the Lord of a field which he has bought, which is not of the field of his possession,"],["23",[["λογιεῖται",708232,93],["πρὸς",710844,0],["αὐτὸν",702165,85],["ὁ",709436,3],["ἱερεὺς",706614,4],["τὸ",709436,24],["τέλος",712787,25],["τῆς",709436,16],["τιμῆς",712856,17],["ἐκ",704132,0],["τοῦ",709436,35],["ἐνιαυτοῦ",704745,18],["τῆς",709436,16],["ἀφέσεως",702199,17],["καὶ",707031,7],["ἀποδώσει",701449,127],["τὴν",709436,8],["τιμὴν",712856,9],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἅγιον",700159,46],["τῷ",709436,113],["κυρίῳ",707996,114]],"the priest shall reckon to him the full valuation from the year of release, and he shall pay the valuation in that day [as] holy to the Lord."],["24",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["ἐνιαυτῷ",704745,114],["τῆς",709436,16],["ἀφέσεως",702199,17],["ἀποδοθήσεται",701449,134],["ὁ",709436,3],["ἀγρὸς",700196,4],["τῷ",709436,113],["ἀνθρώπῳ",701163,114],["παρ᾿",709995,0],["οὗ",709781,48],["κέκτηται",707932,187],["αὐτόν",702165,85],["οὗ",709781,48],["ἦν",704093,13],["ἡ",709436,10],["κατάσχεσις",707451,12],["τῆς",709436,16],["γῆς",703083,17]],"And in the year of release the land shall be restored to the man of whom the other bought it, whose the possession of the land was."],["25",[["καὶ",707031,7],["πᾶσα",710177,29],["τιμὴ",712856,12],["ἔσται",704093,93],["σταθμίοις",712039,96],["ἁγίοις",700159,94],["εἴκοσι",704085,59],["ὀβολοὶ",709441,52],["ἔσται",704093,93],["τὸ",709436,34],["δίδραχμον",703651,15]],"And every valuation shall be by holy weights: the didrachm shall be twenty oboli."],["26",[["καὶ",707031,7],["πᾶν",710177,26],["πρωτότοκον",711046,26],["ὃ",709781,33],["ἂν",700900,11],["γένηται",703104,239],["ἐν",704639,0],["τοῖς",709436,95],["κτήνεσίν",707934,96],["σου",711945,133],["ἔσται",704093,93],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["οὐ",709805,28],["καθαγιάσει",706980,127],["οὐθεὶς",709817,14],["αὐτό",702165,129],["ἐάν",703912,7],["τε",712751,11],["μόσχον",709029,6],["ἐάν",703912,7],["τε",712751,11],["πρόβατον",710768,25],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐστίν",704093,91]],"And every first-born which shall be produced among thy cattle shall be the Lord's, and no man shall sanctify it: whether calf or sheep, it is the Lord's."],["27",[["ἐὰν",703912,7],["δὲ",703303,11],["τῶν",709436,80],["τετραπόδων",712823,169],["τῶν",709436,80],["ἀκαθάρτων",700508,169],["ἀλλάξει",700683,127],["κατὰ",707200,0],["τὴν",709436,8],["τιμὴν",712856,9],["αὐτοῦ",702165,49],["καὶ",707031,7],["προσθήσει",710965,127],["τὸ",709436,24],["ἐπίπεμπτον",705222,46],["πρὸς",710844,0],["αὐτό",702165,129],["καὶ",707031,7],["ἔσται",704093,93],["αὐτῷ",702165,50],["ἐὰν",703912,7],["δὲ",703303,11],["μὴ",708851,28],["λυτρῶται",708282,428],["πραθήσεται",710480,134],["κατὰ",707200,0],["τὸ",709436,24],["τίμημα",712857,25],["αὐτοῦ",702165,49]],"But if he should redeem an unclean beast, according to its valuation, then he shall add the fifth part to it, and it shall be his; and if he redeem it not, it shall be sold according to its valuation."],["28",[["πᾶν",710177,26],["δὲ",703303,11],["ἀνάθεμα",700950,15],["ὃ",709781,128],["ἐὰν",703912,7],["ἀναθῇ",701068,172],["ἄνθρωπος",701163,4],["τῷ",709436,113],["κυρίῳ",707996,114],["ἀπὸ",701425,0],["πάντων",710177,83],["ὅσα",709788,195],["αὐτῷ",702165,50],["ἐστιν",704093,91],["ἀπὸ",701425,0],["ἀνθρώπου",701163,18],["ἕως",705792,0],["κτήνους",707934,21],["καὶ",707031,7],["ἀπὸ",701425,0],["ἀγροῦ",700196,18],["κατασχέσεως",707451,17],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἀποδώσεται",701449,93],["οὐδὲ",709816,7],["λυτρώσεται",708282,93],["πᾶν",710177,26],["ἀνάθεμα",700950,15],["ἅγιον",700159,26],["ἁγίων",700159,83],["ἔσται",704093,93],["τῷ",709436,113],["κυρίῳ",707996,114]],"And every dedicated thing which a man shall dedicate to the Lord of all that he has, whether man or beast, or of the field of his possession, he shall not sell it, nor redeem it: every devoted thing shall be most holy to the Lord."],["29",[["καὶ",707031,7],["πᾶν",710177,26],["ὃ",709781,33],["ἐὰν",703912,7],["ἀνατεθῇ",701068,384],["ἀπὸ",701425,0],["τῶν",709436,80],["ἀνθρώπων",701163,81],["οὐ",709805,28],["λυτρωθήσεται",708282,134],["ἀλλὰ",700680,7],["θανάτῳ",706096,114],["θανατωθήσεται",706097,134]],"And whatever shall be dedicated of men, shall not be ransomed, but shall be surely put to death."],["30",[["πᾶσα",710177,29],["δεκάτη",703343,29],["τῆς",709436,16],["γῆς",703083,17],["ἀπὸ",701425,0],["τοῦ",709436,20],["σπ