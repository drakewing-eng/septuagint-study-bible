6,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["ὁ",709436,3],["ἐξαγαγὼν",704834,182],["ὑμᾶς",713080,194],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["ὄντων",704093,170],["ὑμῶν",713091,145],["δούλων",703817,81],["καὶ",707031,7],["συνέτριψα",712520,155],["τὸν",709436,5],["δεσμὸν",703372,6],["τοῦ",709436,20],["ζυγοῦ",705894,21],["ὑμῶν",713091,145],["καὶ",707031,7],["ἤγαγον",700209,155],["ὑμᾶς",713080,194],["μετὰ",708780,0],["παρρησίας",710173,17]],"I am the Lord your God, who brought you out of the land of Egypt, where ye were slaves; and I broke the band of your yoke, and brought you forth openly."],["14",[["ἐὰν",703912,7],["δὲ",703303,11],["μὴ",708851,28],["ὑπακούσητέ",713096,125],["μου",709032,133],["μηδὲ",708855,7],["ποιήσητε",710582,125],["τὰ",709436,41],["προστάγματά",710959,42],["μου",709032,133],["ταῦτα",709858,71]],"But if ye will not hearken to me, nor obey these my ordinances,"],["15",[["ἀλλὰ",700680,7],["ἀπειθήσητε",701370,125],["αὐτοῖς",702165,206],["καὶ",707031,7],["τοῖς",709436,95],["κρίμασίν",707903,96],["μου",709032,133],["προσοχθίσῃ",710945,172],["ἡ",709436,10],["ψυχὴ",714070,12],["ὑμῶν",713091,145],["ὥστε",714164,7],["ὑμᾶς",713080,194],["μὴ",708851,28],["ποιεῖν",710582,55],["πάσας",710177,119],["τὰς",709436,38],["ἐντολάς",704802,39],["μου",709032,133],["ὥστε",714164,7],["διασκεδάσαι",703575,106],["τὴν",709436,8],["διαθήκην",703456,9],["μου",709032,133]],"but disobey them, and your soul should loathe my judgments, so that ye should not keep all my commands, so as to break my covenant,"],["16",[["καὶ",707031,7],["ἐγὼ",704018,164],["ποιήσω",710582,165],["οὕτως",709859,28],["ὑμῖν",713084,90],["καὶ",707031,7],["ἐπισυστήσω",705283,165],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["τὴν",709436,8],["ἀπορίαν",701560,9],["τήν",709436,8],["τε",712751,11],["ψώραν",714079,9],["καὶ",707031,7],["τὸν",709436,5],["ἴκτερον",706720,6],["καὶ",707031,7],["σφακελίζοντας",712573,235],["τοὺς",709436,58],["ὀφθαλμοὺς",709870,57],["ὑμῶν",713091,145],["καὶ",707031,7],["τὴν"