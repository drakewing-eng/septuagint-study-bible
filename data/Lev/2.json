[["1",[["ἐὰν",703912,7],["δὲ",703303,11],["ψυχὴ",714070,12],["προσφέρῃ",710974,204],["δῶρον",703907,25],["θυσίαν",706345,9],["τῷ",709436,113],["κυρίῳ",707996,114],["σεμίδαλις",711675,12],["ἔσται",704093,93],["τὸ",709436,34],["δῶρον",703907,15],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπιχεεῖ",705337,127],["ἐπ᾿",705080,0],["αὐτὸ",702165,129],["ἔλαιον",704380,25],["καὶ",707031,7],["ἐπιθήσει",705304,127],["ἐπ᾿",705080,0],["αὐτὸ",702165,129],["λίβανον",708186,6],["θυσία",706345,12],["ἐστίν",704093,91]],"And if a soul bring a gift, a sacrifice to the Lord, his gift shall be fine flour; and he shall pour oil upon it, and shall put frankincense on it: it is a sacrifice."],["2",[["καὶ",707031,7],["οἴσει",713428,127],["πρὸς",710844,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ααρων",700005,18],["τοὺς",709436,58],["ἱερεῖς",706614,57],["καὶ",707031,7],["δραξάμενος",703826,248],["ἀπ᾿",701425,0],["αὐτῆς",702165,86],["πλήρη",710541,36],["τὴν",709436,8],["δράκα",703824,9],["ἀπὸ",701425,0],["τῆς",709436,16],["σεμιδάλεως",711675,17],["σὺν",712372,0],["τῷ",709436,53],["ἐλαίῳ",704380,54],["καὶ",707031,7],["πάντα",710177,27],["τὸν",709436,5],["λίβανον",708186,6],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐπιθήσει",705304,127],["ὁ",709436,3],["ἱερεὺς",706614,4],["τὸ",709436,24],["μνημόσυνον",708966,25],["αὐτῆς",702165,86],["ἐπὶ",705080,0],["τὸ",709436,24],["θυσιαστήριον",706348,25],["θυσία",706345,12],["ὀσμὴ",709786,12],["εὐωδίας",705734,17],["τῷ",709436,113],["κυρίῳ",707996,114]],"And he shall bring it to the priests the sons of Aaron: and having taken from it a handful of the fine flour with the oil, and all its frankincense, then the priest shall put the memorial of it on the altar: [it is] a sacrifice, an odour of sweet savour to the Lord."],["3",[["καὶ",707031,7],["τὸ",709436,34],["λοιπὸν",708247,26],["ἀπὸ",701425,0],["τῆς",709436,16],["θυσίας",706345,17],["Ααρων",700005,114],["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτοῦ",702165,102],["ἅγιον",700159,26],["τῶν",709436,43],["ἁγίων",700159,83],["ἀπὸ",701425,0],["τῶν",709436,130],["θυσιῶν",706345,65],["κυρίου",707996,18]],"And the remainder of the sacrifice shall be for Aaron and his sons, a most holy portion from the sacrifices of the Lord."],["4",[["ἐὰν",703912,7],["δὲ",703303,11],["προσφέρῃ",710974,204],["δῶρον",703907,25],["θυσίαν",706345,9],["πεπεμμένην",710432,436],["ἐν",704639,0],["κλιβάνῳ",707733,114],["δῶρον",703907,25],["κυρίῳ",707996,114],["ἐκ",704132,0],["σεμιδάλεως",711675,17],["ἄρτους",701829,57],["ἀζύμους",700345,60],["πεφυραμένους",713626,458],["ἐν",704639,0],["ἐλαίῳ",704380,54],["καὶ",707031,7],["λάγανα",708051,42],["ἄζυμα",700345,68],["διακεχρισμένα",703637,437],["ἐν",704639,0],["ἐλαίῳ",704380,54]],"And if he bring as a gift a sacrifice baked from the oven, a gift to the Lord of fine flour, [he shall bring] unleavened bread kneaded with oil, and unleavened cakes anointed with oil."],["5",[["ἐὰν",703912,7],["δὲ",703303,11],["θυσία",706345,12],["ἀπὸ",701425,0],["τηγάνου",712835,21],["τὸ",709436,34],["δῶρόν",703907,15],["σου",711945,133],["σεμίδαλις",711675,12],["πεφυραμένη",713626,451],["ἐν",704639,0],["ἐλαίῳ",704380,54],["ἄζυμα",700345,195],["ἔσται",704093,93]],"And if thy gift [be] a sacrifice from a pan, it is fine flour mingled with oil, unleavened [offerings]."],["6",[["καὶ",707031,7],["διαθρύψεις",703457,166],["αὐτὰ",702165,71],["κλάσματα",707704,42],["καὶ",707031,7],["ἐπιχεεῖς",705337,166],["ἐπ᾿",705080,0],["αὐτὰ",702165,71],["ἔλαιον",704380,25],["θυσία",706345,12],["ἐστὶν",704093,91],["κυρίῳ",707996,114]],"And thou shalt break them into fragments and pour oil upon them: it is a sacrifice to the Lord."],["7",[["ἐὰν",703912,7],["δὲ",703303,11],["θυσία",706345,12],["ἀπὸ",701425,0],["ἐσχάρας",705514,17],["τὸ",709436,34],["δῶρόν",703907,15],["σου",711945,133],["σεμίδαλις",711675,12],["ἐν",704639,0],["ἐλαίῳ",704380,54],["ποιηθήσεται",710582,134]],"And if thy gift be a sacrifice from the hearth, it shall be made of fine flour with oil."],["8",[["καὶ",707031,7],["προ