[["1",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["2",[["λάλησον",708071,176],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐρεῖς",705415,166],["πρὸς",710844,0],["αὐτούς",702165,62],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"Speak to the children of Israel, and thou shalt say to them, I [am] the Lord your God."],["3",[["κατὰ",707200,0],["τὰ",709436,41],["ἐπιτηδεύματα",705301,42],["γῆς",703083,17],["Αἰγύπτου",700401,17],["ἐν",704639,0],["ᾗ",709781,108],["κατῳκήσατε",707534,265],["ἐπ᾿",705080,0],["αὐτῇ",702165,105],["οὐ",709805,28],["ποιήσετε",710582,337],["καὶ",707031,7],["κατὰ",707200,0],["τὰ",709436,41],["ἐπιτηδεύματα",705301,42],["γῆς",703083,17],["Χανααν",713708,118],["εἰς",704105,0],["ἣν",709781,131],["ἐγὼ",704018,164],["εἰσάγω",704107,157],["ὑμᾶς",713080,194],["ἐκεῖ",704181,28],["οὐ",709805,28],["ποιήσετε",710582,337],["καὶ",707031,7],["τοῖς",709436,95],["νομίμοις",709340,94],["αὐτῶν",702165,40],["οὐ",709805,28],["πορεύσεσθε",710667,124]],"Ye shall not do according to the devices of Egypt, in which ye dwelt: and according to the devices of the land of Chanaan, into which I bring you, ye shall not do; and ye shall not walk in their ordinances."],["4",[["τὰ",709436,41],["κρίματά",707903,42],["μου",709032,133],["ποιήσετε",710582,337],["καὶ",707031,7],["τὰ",709436,41],["προστάγματά",710959,42],["μου",709032,133],["φυλάξεσθε",713619,124],["πορεύεσθαι",710667,110],["ἐν",704639,0],["αὐτοῖς",702165,206],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"Ye shall observe my judgments, and shall keep my ordinances, and shall walk in them: I [am] the Lord your God."],["5",[["καὶ",707031,7],["φυλάξεσθε",713619,124],["πάντα",710177,68],["τὰ",709436,41],["προστάγματά",710959,42],["μου",709032,133],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["κρίματά",707903,42],["μου",709032,133],["καὶ",707031,7],["ποιήσετε",710582,337],["αὐτά",702165,71],["ἃ",709781,69],["ποιήσας",710582,182],["ἄνθρωπος",701163,4],["ζήσεται",705851,93],["ἐν",704639,0],["αὐτοῖς",702165,206],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"So ye shall keep all my ordinances, and all my judgments, and do them; which if a man do, he shall live in them: I [am] the Lord your God."],["6",[["ἄνθρωπος",701163,4],["ἄνθρωπος",701163,4],["πρὸς",710844,0],["πάντα",710177,68],["οἰκεῖα",709493,68],["σαρκὸς",711537,17],["αὐτοῦ",702165,102],["οὐ",709805,28],["προσελεύσεται",710890,93],["ἀποκαλύψαι",701474,106],["ἀσχημοσύνην",702054,9],["ἐγὼ",704018,164],["κύριος",707996,4]],"No man shall draw nigh to any of his near kindred to uncover their nakedness; I [am] the Lord."],["7",[["ἀσχημοσύνην",702054,9],["πατρός",710189,18],["σου",711945,133],["καὶ",707031,7],["ἀσχημοσύνην",702054,9],["μητρός",708892,17],["σου",711945,133],["οὐκ",709805,28],["ἀποκαλύψεις",701475,166],["μήτηρ",708892,12],["γάρ",702963,11],["σού",711945,133],["ἐστιν",704093,91],["καὶ",707031,7],["οὐκ",709805,28],["ἀποκαλύψεις",701475,166],["τὴν",709436,8],["ἀσχημοσύνην",702054,9],["αὐτῆς",702165,86]],"Thou shalt not uncover the nakedness of thy father, or the nakedness of thy mother, for she is thy mother; thou shalt not uncover her nakedness."],["8",[["ἀσχημοσύνην",702054,9],["γυναικὸς",703209,17],["πατρός",710189,18],["σου",711945,133],["οὐκ",709805,28],["ἀποκαλύψεις",701475,166],["ἀσχημοσύνη",702054,12],["πατρός",710189,18],["σού",711945,133],["ἐστιν",704093,91]],"Thou shalt not uncover the nakedness of thy father's wife; it is thy father's nakedness."],["9",[["ἀσχημοσύνην",702054,9],["τῆς",709436,16],["ἀδελφῆς",700244,17],["σου",711945,133],["ἐκ",704132,0],["πατρός",710189,18],["σου",711945,133],["ἢ",705924,7],["ἐκ",704132,0],["μητρός",708892,17],["σου",711945,133],["ἐνδογενοῦς",704690,82],["ἢ",705924,7],["γεγεννημένης",703051,440],["ἔξω",704983,28],["οὐκ",709805,28],["ἀποκαλύψεις",701475,166],["ἀσχημοσύνην",702054,9],["αὐτῆς",702165,86]],"The nakedness of thy sister by thy father or by thy mother, born at home or abroad, their nakedness thou shalt not uncover."],["10",[["ἀσχημοσύνην",702054,9],["θυγατρὸς",706320,17],["υἱοῦ",713075,18],["σου",711945,133],["ἢ",705924,7],["θυγατρὸς",706320,17],["θυγατρός",706320,17],["σου",711945,133],["οὐκ",709805,28],["ἀποκαλύψεις",701475,166],["τὴν",709436,8],["ἀσχημοσύνην",702054,9],["αὐτῶν",702165,284],["ὅτι",709803,7],["σὴ",711943,29],["ἀσχημοσύνη",702054,12],["ἐστίν",704093,91]],"The nakedness of thy son's daughter, or thy daughter's daughter, their nakedness thou shalt not uncover; because it is thy nakedness."],["11",[["ἀσχημοσύνην",702054,9],["θυγατρὸς",706320,17],["γυναικὸς",703209,17],["πατρός",710189,18],["σου",711945,133],["οὐκ",709805,28],["ἀποκαλύψεις",701475,166],["ὁμοπατρία",709640,29],["ἀδελφή",700244,12],["σού",711945,133],["ἐστιν",704093,91],["οὐκ",709805,28],["ἀποκαλύψεις",701475,166],["τὴν",709436,8],["ἀσχημοσύνην",702054,9],["αὐτῆς",702165,86]],"Thou shalt not uncover the nakedness of the daughter of thy father's wife; she is thy sister by the same father: thou shalt not uncover her nakedness."],["12",[["ἀσχημοσύνην",702054,9],["ἀδελφῆς",700244,17],["πατρός",710189,18],["σου",711945,133],["οὐκ",709805,28],["ἀποκαλύψεις",701475,166],["οἰκεία",709493,29],["γὰρ",702963,11],["πατρός",710189,18],["σού",711945,133],["ἐστιν",704093,91]],"Thou shalt not uncover the nakedness of thy father's sister, for she is near akin to thy father."],["13",[["ἀσχημοσύνην",702054,9],["ἀδελφῆς",700244,17],["μητρός",708892,17],["σου",711945,133],["οὐκ",709805,28],["ἀποκαλύψεις",701475,166],["οἰκεία",709493,29],["γὰρ",702963,11],["μητρός",708892,17],["σού",711945,133],["ἐστιν",704093,91]],"Thou shalt not uncover the nakedness of thy mother's sister, for she is near akin to thy mother."],["14",[["ἀσχημοσύνην",702054,9],["ἀδελφοῦ",700249,18],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["οὐκ",709805,28],["ἀποκαλύψεις",701475,166],["καὶ",707031,7],["πρὸς",710844,0],["τὴν",709436,8],["γυναῖκα",703209,9],["αὐτοῦ",702165,102],["οὐκ",709805,28],["εἰσελεύσῃ",704114,123],["συγγενὴς",712185,29],["γάρ",702963,11],["σού",711945,133],["ἐστιν",704093,91]],"Thou shalt not uncover the nakedness of thy father's brother, and thou shalt not go in to his wife; for she is thy relation."],["15",[["ἀσχημοσύνην",702054,9],["νύμφης",709381,17],["σου",711945,133],["οὐκ",709805,28],["ἀποκαλύψεις",701475,166],["γυνὴ",703209,12],["γὰρ",702963,11],["υἱοῦ",713075,18],["σού",711945,133],["ἐστιν",704093,91],["οὐκ",709805,28],["ἀποκαλύψεις",701475,166],["τὴν",709436,8],["ἀσχημοσύνην",702054,9],["αὐτῆς",702165,86]],"Thou shalt not uncover the nakedness of thy daughter-in-law, for she is thy son's wife, thou shalt not uncover her nakedness."],["16",[["ἀσχημοσύνην",702054,9],["γυναικὸς",703209,17],["ἀδελφοῦ",700249,18],["σου",711945,133],["οὐκ",709805,28],["ἀποκαλύψεις",701475,166],["ἀσχημοσύνη",702054,12],["ἀδελφοῦ",700249,18],["σού",711945,133],["ἐστιν",704093,91]],"Thou shalt not uncover the nakedness of thy brother's wife: it is thy brother's nakedness."],["17",[["ἀσχημοσύνην",702054,9],["γυναικὸς",703209,17],["καὶ",707031,7],["θυγατρὸς",706320,17],["αὐτῆς",702165,86],["οὐκ",709805,28],["ἀποκαλύψεις",701475,166],["τὴν",709436,8],["θυγατέρα",706320,9],["τοῦ",709436,35],["υἱοῦ",713075,18],["αὐτῆς",702165,86],["καὶ",707031,7],["τὴν",709436,8],["θυγατέρα",706320,9],["τῆς",709436,16],["θυγατρὸς",706320,17],["αὐτῆς",702165,86],["οὐ",709805,28],["λήμψῃ",708076,123],["ἀποκαλύψαι",701474,106],["τὴν",709436,8],["ἀσχημοσύνην",702054,9],["αὐτῶν",702165,284],["οἰκεῖαι",709493,192],["γάρ",702963,11],["σού",711945,133],["εἰσιν",704093,197],["ἀσέβημά",701908,15],["ἐστιν",704093,91]],"The nakedness of a woman and her daughter shalt thou not uncover; her son's daughter, and her daughter's daughter, shalt thou not take, to uncover their nakedness, for they are thy kinswomen: it is impiety."],["18",[["γυναῖκα",703209,9],["ἐπὶ",705080,0],["ἀδελφῇ",700244,1],["αὐτῆς",702165,86],["οὐ",709805,28],["λήμψῃ",708076,123],["ἀντίζηλον",701235,9],["ἀποκαλύψαι",701474,106],["τὴν",709436,8],["ἀσχημοσύνην",702054,9],["αὐτῆς",702165,86],["ἐπ᾿",705080,0],["αὐτῇ",702165,105],["ἔτι",705538,28],["ζώσης",705851,222],["αὐτῆς",702165,86]],"Thou shalt not take a wife in addition to her sister, as a rival, to uncover her nakedness in opposition to her, while she is yet living."],["19",[["καὶ",707031,7],["πρὸς",710844,0],["γυναῖκα",703209,9],["ἐν",704639,0],["χωρισμῷ",714017,114],["ἀκαθαρσίας",700507,17],["αὐτῆς",702165,86],["οὐ",709805,28],["προσελεύσῃ",710890,123],["ἀποκαλύψαι",701474,106],["τὴν",709436,8],["ἀσχημοσύνην",702054,9],["αὐτῆς",702165,86]],"And thou shalt not go in to a woman under separation for her uncleanness, to uncover her nakedness."],["20",[["καὶ",707031,7],["πρὸς",710844,0],["τὴν",709436,8],["γυναῖκα",703209,9],["τοῦ",709436,35],["πλησίον",710547,28],["σου",711945,133],["οὐ",709805,28],["δώσεις",703654,166],["κοίτην",707781,9],["σπέρματός",712008,21],["σου",711945,133],["ἐκμιανθῆναι",704261,179],["πρὸς",710844,0],["αὐτήν",702165,104]],"And thou shalt not lie with thy neighbour's wife, to defile thyself with her."],["21",[["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,20],["σπέρματός",712008,21],["σου",711945,133],["οὐ",709805,28],["δώσεις",703654,166],["λατρεύειν",708108,55],["ἄρχοντι",701862,114],["καὶ",707031,7],["οὐ",709805,28],["βεβηλώσεις",702614,166],["τὸ",709436,24],["ὄνομα",709666,25],["τὸ",709436,24],["ἅγιον",700159,46],["ἐγὼ",704018,164],["κύριος",707996,4]],"And thou shalt not give of thy seed to serve a ruler; and thou shalt not profane my holy name; I [am] the Lord."],["22",[["καὶ",707031,7],["μετὰ",708780,0],["ἄρσενος",701818,92],["οὐ",709805,28],["κοιμηθήσῃ",707767,364],["κοίτην",707781,9],["γυναικός",703209,17],["βδέλυγμα",702604,15],["γάρ",702963,11],["ἐστιν",704093,91]],"And thou shalt not lie with a man as with a woman, for it is an abomination."],["23",[["καὶ",707031,7],["πρὸς",710844,0],["πᾶν",710177,46],["τετράπουν",712823,46],["οὐ",709805,28],["δώσεις",703654,166],["τὴν",709436,8],["κοίτην",707781,9],["σου",711945,133],["εἰς",704105,0],["σπερματισμὸν",712010,6],["ἐκμιανθῆναι",704261,179],["πρὸς",710844,0],["αὐτό",702165,129],["καὶ",707031,7],["γυνὴ",703209,12],["οὐ",709805,28],["στήσεται",706846,93],["πρὸς",710844,0],["πᾶν",710177,46],["τετράπουν",712823,46],["βιβασθῆναι",702716,179],["μυσερὸν",709077,26],["γάρ",702963,11],["ἐστιν",704093,91]],"Neither shalt thou lie with any quadruped for copulation, to be polluted with it: neither shall a woman present herself before any quadruped to have connexion with it; for it is an abomination."],["24",[["μὴ",708851,28],["μιαίνεσθε",708900,374],["ἐν",704639,0],["πᾶσιν",710177,94],["τούτοις",709858,206],["ἐν",704639,0],["πᾶσι",710177,94],["γὰρ",702963,11],["τούτοις",709858,206],["ἐμιάνθησαν",708900,99],["τὰ",709436,63],["ἔθνη",704068,64],["ἃ",709781,69],["ἐγὼ",704018,164],["ἐξαποστέλλω",704872,157],["πρὸ",710747,0],["προσώπου",710986,21],["ὑμῶν",713091,145]],"Do not defile yourselves with any of these things; for in all these things the nations are defiled, which I drive out before you,"],["25",[["καὶ",707031,7],["ἐμιάνθη",708900,37],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["ἀνταπέδωκα",701215,155],["ἀδικίαν",700271,9],["αὐτοῖς",702165,151],["δι᾿",703417,0],["αὐτήν",702165,104],["καὶ",707031,7],["προσώχθισεν",710945,2],["ἡ",709436,10],["γῆ",703083,12],["τοῖς",709436,147],["ἐγκαθημένοις",703952,341],["ἐπ᾿",705080,0],["αὐτῆς",702165,86]],"and the land is polluted; and I have recompensed their iniquity to them because of it, and the land is aggrieved with them that dwell upon it."],["26",[["καὶ",707031,7],["φυλάξεσθε",713619,124],["πάντα",710177,68],["τὰ",709436,41],["νόμιμά",709340,68],["μου",709032,133],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["προστάγματά",710959,42],["μου",709032,133],["καὶ",707031,7],["οὐ",709805,28],["ποιήσετε",710582,337],["ἀπὸ",701425,0],["πάντων",710177,83],["τῶν",709436,43],["βδελυγμάτων",702604,44],["τούτων",709858,70],["ὁ",709436,3],["ἐγχώριος",704017,14],["καὶ",707031,7],["ὁ",709436,3],["προσγενόμενος",710870,248],["προσήλυτος",710900,4],["ἐν",704639,0],["ὑμῖν",713084,90]],"And ye shall keep all my statutes and all my ordinances, and ye shall do none of these abominations; neither the native, nor the stranger that joins himself with you:"],["27",[["πάντα",710177,68],["γὰρ",702963,11],["τὰ",709436,41],["βδελύγματα",702604,42],["ταῦτα",709858,71],["ἐποίησαν",710582,150],["οἱ",709436,136],["ἄνθρωποι",701163,52],["τῆς",709436,16],["γῆς",703083,17],["οἱ",709436,136],["ὄντες",704093,146],["πρότεροι",710992,138],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐμιάνθη",708900,37],["ἡ",709436,10],["γῆ",703083,12]],"(for all these abominations the men of the land did who were before you, and the land was defiled,)"],["28",[["καὶ",707031,7],["ἵνα",706747,7],["μὴ",708851,28],["προσοχθίσῃ",710945,172],["ὑμῖν",713084,90],["ἡ",709436,10],["γῆ",703083,12],["ἐν",704639,0],["τῷ",709436,53],["μιαίνειν",708900,55],["ὑμᾶς",713080,194],["αὐτήν",702165,104],["ὃν",709781,112],["τρόπον",712980,6],["προσώχθισεν",710945,2],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["τοῖς",709436,95],["πρὸ",710747,0],["ὑμῶν",713091,145]],"and lest the land be aggrieved with you in your polluting it, as it was aggrieved with the nations before you."],["29",[["ὅτι",709803,7],["πᾶς",710177,14],["ὃς",709781,213],["ἂν",700900,11],["ποιήσῃ",710582,172],["ἀπὸ",701425,0],["πάντων",710177,83],["τῶν",709436,43],["βδελυγμάτων",702604,44],["τούτων",709858,70],["ἐξολεθρευθήσονται",704956,144],["αἱ",709436,190],["ψυχαὶ",714070,191],["αἱ",709436,190],["ποιοῦσαι",710582,306],["ἐκ",704132,0],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτῶν",702165,40]],"For whosoever shall do any of these abominations, the souls that do them shall be destroyed from among their people."],["30",[["καὶ",707031,7],["φυλάξετε",713619,337],["τὰ",709436,41],["προστάγματά",710959,42],["μου",709032,133],["ὅπως",709719,7],["μὴ",708851,28],["ποιήσητε",710582,125],["ἀπὸ",701425,0],["πάντων",710177,83],["τῶν",709436,43],["νομίμων",709340,83],["τῶν",709436,43],["ἐβδελυγμένων",702608,471],["ἃ",709781,69],["γέγονεν",703104,171],["πρὸ",710747,0],["τοῦ",709436,35],["ὑμᾶς",713080,194],["καὶ",707031,7],["οὐ",709805,28],["μιανθήσεσθε",708900,261],["ἐν",704639,0],["αὐτοῖς",702165,206],["ὅτι",709803,7],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145]],"And ye shall keep mine ordinances, that ye may not do any of the abominable practices, which have taken place before your time: and ye shall not be polluted in them; for I [am] the Lord your God."]]