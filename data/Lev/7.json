[["1",[["καὶ",707031,7],["οὗτος",709858,121],["ὁ",709436,3],["νόμος",709349,4],["τοῦ",709436,35],["κριοῦ",707906,18],["τοῦ",709436,35],["περὶ",710285,0],["τῆς",709436,16],["πλημμελείας",710533,17],["ἅγια",700159,195],["ἁγίων",700159,83],["ἐστίν",704093,91]],"And this [is] the law of the ram for the trespass-offering; it is most holy."],["2",[["ἐν",704639,0],["τόπῳ",712903,114],["οὗ",709806,28],["σφάζουσιν",712571,197],["τὸ",709436,24],["ὁλοκαύτωμα",709589,25],["σφάξουσιν",712571,218],["τὸν",709436,5],["κριὸν",707906,6],["τῆς",709436,16],["πλημμελείας",710533,17],["ἔναντι",704653,0],["κυρίου",707996,18],["καὶ",707031,7],["τὸ",709436,24],["αἷμα",700442,25],["προσχεεῖ",710980,127],["ἐπὶ",705080,0],["τὴν",709436,8],["βάσιν",702585,9],["τοῦ",709436,20],["θυσιαστηρίου",706348,21],["κύκλῳ",707959,114]],"In the place where they slay the whole-burnt-offering, they shall slay the ram of the trespass-offering before the Lord, and he shall pour out the blood at the bottom of the altar round about."],["3",[["καὶ",707031,7],["πᾶν",710177,46],["τὸ",709436,24],["στέαρ",712054,25],["αὐτοῦ",702165,102],["προσοίσει",710974,127],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὴν",709436,8],["ὀσφὺν",709800,9],["καὶ",707031,7],["πᾶν",710177,46],["τὸ",709436,24],["στέαρ",712054,25],["τὸ",709436,24],["κατακαλύπτον",707260,47],["τὰ",709436,41],["ἐνδόσθια",704696,42],["καὶ",707031,7],["πᾶν",710177,46],["τὸ",709436,24],["στέαρ",712054,25],["τὸ",709436,24],["ἐπὶ",705080,0],["τῶν",709436,43],["ἐνδοσθίων",704696,44]],"And he shall offer all the fat from it; and the loins, and all the fat that covers the inwards, and all the fat that is upon the inwards,"],["4",[["καὶ",707031,7],["τοὺς",709436,58],["δύο",703849,59],["νεφροὺς",709282,57],["καὶ",707031,7],["τὸ",709436,24],["στέαρ",712054,25],["τὸ",709436,24],["ἐπ᾿",705080,0],["αὐτῶν",702165,40],["τὸ",709436,24],["ἐπὶ",705080,0],["τῶν",709436,43],["μηρίων",708884,44],["καὶ",707031,7],["τὸν",709436,5],["λοβὸν",708229,6],["τὸν",709436,5],["ἐ