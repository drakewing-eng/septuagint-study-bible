[["1",[["ἐπίστρεφε",705278,240],["ἐπίστρεφε",705278,240],["ἡ",709436,747],["Σουλαμῖτις",711957,258],["ἐπίστρεφε",705278,240],["ἐπίστρεφε",705278,240],["καὶ",707031,7],["ὀψόμεθα",709725,141],["ἐν",704639,0],["σοί",711925,159],["τί",712867,126],["ὄψεσθε",709725,124],["ἐν",704639,0],["τῇ",709436,100],["Σουλαμίτιδι",711957,1],["ἡ",709436,10],["ἐρχομένη",705453,211],["ὡς",714148,7],["χοροὶ",713915,52],["τῶν",709436,130],["παρεμβολῶν",710133,65]],"Return, return, O Sunamite; return, return, and we will look at thee. What will ye see in the Sunamite? She comes as bands of armies."],["2",[["τί",712867,126],["ὡραιώθησαν",714134,99],["διαβήματά",703422,64],["σου",711945,133],["ἐν",704639,0],["ὑποδήμασιν",713195,96],["θύγατερ",706320,258],["Ναδαβ",709156,18],["ῥυθμοὶ",711307,52],["μηρῶν",708885,81],["σου",711945,133],["ὅμοιοι",709626,138],["ὁρμίσκοις",709758,148],["ἔργῳ",705396,54],["χειρῶν",713787,65],["τεχνίτου",712832,18]],"Thy steps are beautiful in shoes, O daughter of the prince: the joints of [thy] thighs are like chains, the work of the craftsman."],["3",[["ὀμφαλός",709650,4],["σου",711945,133],["κρατὴρ",707880,4],["τορευτὸς",712904,14],["μὴ",708851,28],["ὑστερούμενος",713270,122],["κρᾶμα",707870,25],["κοιλία",707761,12],["σου",711945,133],["θιμωνιὰ",706266,12],["σίτου",711814,18],["πεφραγμένη",713575,203],["ἐν",704639,0],["κρίνοις",707904,96]],"Thy navel is [as] a turned bowl, not wanting liquor; thy belly is [as] a heap of wheat set about with lilies."],["4",[["δύο",703849,59],["μαστοί",708569,52],["σου",711945,133],["ὡς",714148,7],["δύο",703849,59],["νεβροὶ",709236,52],["δίδυμοι",703653,138],["δορκάδος",703801,17]],"Thy two breasts are as two twin fawns."],["5",[["τράχηλός",712924,4],["σου",711945,133],["ὡς",714148,7],["πύργος",711092,4],["ἐλεφάντινος",704436,14],["ὀφθαλμοί",709870,52],["σου",711945,133],["ὡς",714148,7],["λίμναι",708208,191],["ἐν",704639,0],["Εσεβων",705473,111],["ἐν",704639,0],["πύλαις",711082,76],["θυγατρὸς",706320,17],["πολλῶν",710646,169],["μυκτήρ",709051,4],["σου",711945,133],["ὡς",714148,7],["πύργος",711092,4],["τοῦ",709436,35],["Λιβάνου",708185,18],["σκοπεύων",711873,72],["πρόσωπον",710986,25],["Δαμασκοῦ",703275,118]],"Thy neck is as an ivory tower; thine eyes are as pools in Esebon, by the gates of the daughter of many: thy nose is as the tower of Libanus, looking toward Damascus."],["6",[["κεφαλή",707639,12],["σου",711945,133],["ἐπὶ",705080,0],["σὲ",711598,163],["ὡς",714148,7],["Κάρμηλος",707161,120],["καὶ",707031,7],["πλόκιον",710559,15],["κεφαλῆς",707639,17],["σου",711945,133],["ὡς",714148,7],["πορφύρα",710682,12],["βασιλεὺς",702580,4],["δεδεμένος",703394,419],["ἐν",704639,0],["παραδρομαῖς",710019,76]],"Thy head upon thee is as Carmel, and the curls of thy hair like scarlet; the king is bound in the galleries."],["7",[["τί",712867,126],["ὡραιώθης",714134,168],["καὶ",707031,7],["τί",712867,126],["ἡδύνθης",705943,168],["ἀγάπη",700122,258],["ἐν",704639,0],["τρυφαῖς",713008,76],["σου",711945,133]],"How beautiful art thou, and how sweet art thou, [my] love!"],["8",[["τοῦτο",709858,132],["μέγεθός",708656,15],["σου",711945,133],["ὡμοιώθη",709628,37],["τῷ",709436,113],["φοίνικι",713541,114],["καὶ",707031,7],["οἱ",709436,136],["μαστοί",708569,52],["σου",711945,133],["τοῖς",709436,147],["βότρυσιν",702775,148]],"This is thy greatness in thy delights: thou wast made like a palm tree, and thy breasts to clusters."],["9",[["εἶπα",705373,155],["ἀναβήσομαι",700905,181],["ἐν",704639,0],["τῷ",709436,113],["φοίνικι",713541,114],["κρατήσω",707879,165],["τῶν",709436,43],["ὕψεων",713288,44],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔσονται",704093,135],["δὴ",703395,11],["μαστοί",708569,52],["σου",711945,133],["ὡς",714148,7],["βότρυες",702775,52],["τῆς",709436,16],["ἀμπέλου",700870,17],["καὶ",707031,7],["ὀσμὴ",709786,12],["ῥινός",711268,17],["σου",711945,133],["ὡς",714148,7],["μῆλα",708870,64]],"I said, I will go up to the palm tree, I will take hold of its high boughs: and now shall thy breasts be as clusters of the vine, and the smell of thy nose as apples;"],["10",[["καὶ",707031,7],["λάρυγξ",708098,4],["σου",711945,133],["ὡς",714148,7],["οἶνος",709530,4],["ὁ",709436,3],["ἀγαθὸς",700106,14],["πορευόμενος",710667,122],["τῷ",709436,113],["ἀδελφιδῷ",700245,114],["μου",709032,133],["εἰς",704105,0],["εὐθύθητα",705603,9],["ἱκανούμενος",706711,122],["χείλεσίν",713781,96],["μου",709032,133],["καὶ",707031,7],["ὀδοῦσιν",709461,148]],"and thy throat as good wine, going well with my kinsman, suiting my lips and teeth."],["11",[["ἐγὼ",704018,164],["τῷ",709436,113],["ἀδελφιδῷ",700245,114],["μου",709032,133],["καὶ",707031,7],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ἡ",709436,10],["ἐπιστροφὴ",705279,12],["αὐτοῦ",702165,102]],"I am my kinsman's, and his desire is toward me."],["12",[["ἐλθέ",705453,176],["ἀδελφιδέ",700245,153],["μου",709032,133],["ἐξέλθωμεν",704909,79],["εἰς",704105,0],["ἀγρόν",700196,6],["αὐλισθῶμεν",702138,283],["ἐν",704639,0],["κώμαις",708022,76]],"Come, my kinsman, let us go forth into the field; let us lodge in the villages."],["13",[["ὀρθρίσωμεν",709742,79],["εἰς",704105,0],["ἀμπελῶνας",700872,57],["ἴδωμεν",709725,79],["εἰ",704071,7],["ἤνθησεν",701152,2],["ἡ",709436,10],["ἄμπελος",700870,12],["ἤνθησεν",701152,2],["ὁ",709436,3],["κυπρισμός",707986,4],["ἤνθησαν",701152,150],["αἱ",709436,190],["ῥόαι",711272,191],["ἐκεῖ",704181,28],["δώσω",703654,165],["τοὺς",709436,58],["μαστούς",708569,57],["μου",709032,133],["σοί",711925,159]],"Let us go early into the vineyards; let us see if the vine has flowered, [if] the blossoms have appeared, if the pomegranates have blossomed; there will I give thee my breasts."],["14",[["οἱ",709436,136],["μανδραγόραι",708474,52],["ἔδωκαν",703654,150],["ὀσμήν",709786,9],["καὶ",707031,7],["ἐπὶ",705080,0],["θύραις",706337,76],["ἡμῶν",705999,145],["πάντα",710177,195],["ἀκρόδρυα",700607,64],["νέα",709256,195],["πρὸς",710844,0],["παλαιά",709936,68],["ἀδελφιδέ",700245,153],["μου",709032,133],["ἐτήρησά",712844,155],["σοι",711925,159]],"The mandrakes have given a smell, and at our doors [are] all kinds of choice fruits, new and old. O my kinsman, I have kept [them] for thee."]]