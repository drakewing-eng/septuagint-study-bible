[["1",[["ᾆσμα",701970,15],["ᾀσμάτων",701970,44],["ὅ",709781,33],["ἐστιν",704093,91],["τῷ",709436,113],["Σαλωμων",711430,18]],"The Song of songs, which is Solomon's."],["2",[["φιλησάτω",713471,45],["με",708618,163],["ἀπὸ",701425,0],["φιλημάτων",713473,44],["στόματος",712125,21],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ἀγαθοὶ",700106,138],["μαστοί",708569,52],["σου",711945,133],["ὑπὲρ",713111,0],["οἶνον",709530,6]],"Let him kiss me with the kisses of his mouth: for thy breasts are better than wine."],["3",[["καὶ",707031,7],["ὀσμὴ",709786,12],["μύρων",709072,44],["σου",711945,133],["ὑπὲρ",713111,0],["πάντα",710177,68],["τὰ",709436,41],["ἀρώματα",701867,42],["μύρον",709072,15],["ἐκκενωθὲν",704210,418],["ὄνομά",709666,15],["σου",711945,133],["διὰ",703417,0],["τοῦτο",709858,129],["νεάνιδες",709231,191],["ἠγάπησάν",700120,150],["σε",711598,163]],"And the smell of thine ointments is better than all spices: thy name is ointment poured forth; therefore do the young maidens love thee."],["4",[["εἵλκυσάν",704508,150],["σε",711598,163],["ὀπίσω",709697,0],["σου",711945,133],["εἰς",704105,0],["ὀσμὴν",709786,9],["μύρων",709072,44],["σου",711945,133],["δραμοῦμεν",712931,275],["εἰσήνεγκέν",704127,2],["με",708618,163],["ὁ",709436,3],["βασιλεὺς",702580,4],["εἰς",704105,0],["τὸ",709436,24],["ταμίειον",712700,25],["αὐτοῦ",702165,102],["ἀγαλλιασώμεθα",700114,276],["καὶ",707031,7],["εὐφρανθῶμεν",705715,283],["ἐν",704639,0],["σοί",711925,159],["ἀγαπήσομεν",700120,275],["μαστούς",708569,57],["σου",711945,133],["ὑπὲρ",713111,0],["οἶνον",709530,6],["εὐθύτης",705603,12],["ἠγάπησέν",700120,2],["σε",711598,163]],"They have drawn thee: we will run after thee, for the smell of thine ointments: the king has brought me into his closet: let us rejoice and be glad in thee; we will love thy breasts more than wine: righteousness loves thee."],["5",[["μέλαινά",708695,29],["εἰμι",704093,157],["καὶ",707031,7],["καλή",707097,29],["θυγατέρες",706320,185],["Ιερουσαλημ",706644,17],["ὡς",714148,7],["σκηνώματα",711849,64],["Κηδαρ",707645,118],["ὡς",714148,7],["δέρρεις",703365,191],["Σαλωμων",711430,18]],"I am black, but beautiful, ye daughters of Jerusalem, as the tents of Kedar, as the curtains of Solomon."],["6",[["μὴ",708851,28],["βλέψητέ",702740,125],["με",708618,163],["ὅτι",709803,7],["ἐγώ",704018,164],["εἰμι",704093,157],["μεμελανωμένη",708694,451],["ὅτι",709803,7],["παρέβλεψέν",710002,2],["με",708618,163],["ὁ",709436,3],["ἥλιος",705974,4],["υἱοὶ",713075,52],["μητρός",708892,17],["μου",709032,133],["ἐμαχέσαντο",708610,189],["ἐν",704639,0],["ἐμοί",704577,159],["ἔθεντό",712849,189],["με",708618,163],["φυλάκισσαν",713615,9],["ἐν",704639,0],["ἀμπελῶσιν",700872,148],["ἀμπελῶνα",700872,6],["ἐμὸν",704578,27],["οὐκ",709805,28],["ἐφύλαξα",713619,155]],"Look not upon me, because I am dark, because the sun has looked unfavourably upon me: my mother's sons strove with me; they made me keeper in the vineyards; I have not kept my own vineyard."],["7",[["ἀπάγγειλόν",701321,176],["μοι",708974,159],["ὃν",709781,112],["ἠγάπησεν",700120,2],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ποῦ",710706,28],["ποιμαίνεις",710594,154],["ποῦ",710706,28],["κοιτάζεις",707779,154],["ἐν",704639,0],["μεσημβρίᾳ",708758,1],["μήποτε",708882,28],["γένωμαι",703104,410],["ὡς",714148,7],["περιβαλλομένη",710294,211],["ἐπ᾿",705080,0],["ἀγέλαις",700148,76],["ἑταίρων",705529,81],["σου",711945,133]],"Tell me, [thou] whom my soul loves, where thou tendest thy flock, where thou causest [them] to rest at noon, lest I become as one that is veiled by the flocks of thy companions."],["8",[["ἐὰν",703912,7],["μὴ",708851,28],["γνῷς",703105,175],["σεαυτήν",711599,104],["ἡ",709436,747],["καλὴ",707097,602],["ἐν",704639,0],["γυναιξίν",703209,76],["ἔξελθε",704909,176],["σὺ",712181,164],["ἐν",704639,0],["πτέρναις",711051,76],["τῶν",709436,43],["ποιμνίων",710598,44],["καὶ",707031,7],["ποίμαινε",710594,240],["τὰς",709436,38],["ἐρίφους",705429,57],["σου",711945,133],["ἐπὶ",705080,0],["σκηνώμασιν",711849,96],["τῶν",709436,80],["ποιμένων",710596,81]],"If thou know not thyself, thou fair one among women, go thou forth by the footsteps of the flocks, and feed thy kids by the shepherds' tents."],["9",[["τῇ",709436,100],["ἵππῳ",706790,1],["μου",709032,133],["ἐν",704639,0],["ἅρμασιν",701768,96],["Φαραω",713360,18],["ὡμοίωσά",709628,155],["σε",711598,163],["ἡ",709436,747],["πλησίον",710547,28],["μου",709032,133]],"I have likened thee, my companion, to my horses in the chariots of Pharao."],["10",[["τί",712867,126],["ὡραιώθησαν",714134,99],["σιαγόνες",711763,191],["σου",711945,133],["ὡς",714148,7],["τρυγόνες",713000,191],["τράχηλός",712924,4],["σου",711945,133],["ὡς",714148,7],["ὁρμίσκοι",709758,52]],"How are thy cheeks beautiful as [those] of a dove, thy neck as chains!"],["11",[["ὁμοιώματα",709629,42],["χρυσίου",713972,21],["ποιήσομέν",710582,275],["σοι",711925,159],["μετὰ",708780,0],["στιγμάτων",712103,44],["τοῦ",709436,20],["ἀργυρίου",701707,21]],"We will make thee figures of gold with studs of silver."],["12",[["ἕως",705792,28],["οὗ",709781,48],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐν",704639,0],["ἀνακλίσει",700974,1],["αὐτοῦ",702165,102],["νάρδος",709195,12],["μου",709032,133],["ἔδωκεν",703654,2],["ὀσμὴν",709786,9],["αὐτοῦ",702165,102]],"So long as the king was at table, my spikenard gave forth its smell."],["13",[["ἀπόδεσμος",701444,4],["τῆς",709436,16],["στακτῆς",712043,17],["ἀδελφιδός",700245,4],["μου",709032,133],["ἐμοί",704577,159],["ἀνὰ",700902,0],["μέσον",708768,46],["τῶν",709436,80],["μαστῶν",708569,81],["μου",709032,133],["αὐλισθήσεται",702138,134]],"My kinsman is to me a bundle of myrrh; he shall lie between my breasts."],["14",[["βότρυς",702775,4],["τῆς",709436,16],["κύπρου",707988,17],["ἀδελφιδός",700245,4],["μου",709032,133],["ἐμοὶ",704577,159],["ἐν",704639,0],["ἀμπελῶσιν",700872,148],["Εγγαδδι",703937,118]],"My kinsman is to me a cluster of camphor in the vineyards of Engaddi."],["15",[["ἰδοὺ",706497,88],["εἶ",704093,154],["καλή",707097,29],["ἡ",709436,747],["πλησίον",710547,28],["μου",709032,133],["ἰδοὺ",706497,88],["εἶ",704093,154],["καλή",707097,29],["ὀφθαλμοί",709870,52],["σου",711945,133],["περιστεραί",710391,191]],"Behold, thou art fair, my companion; behold, thou art fair; thine eyes are doves."],["16",[["ἰδοὺ",706497,88],["εἶ",704093,154],["καλός",707097,14],["ὁ",709436,3],["ἀδελφιδός",700245,4],["μου",709032,133],["καί",707031,7],["γε",702985,11],["ὡραῖος",714132,14],["πρὸς",710844,28],["κλίνη",707737,12],["ἡμῶν",705999,145],["σύσκιος",712550,29]],"Behold, thou art fair, my kinsman, yea, beautiful, overshadowing our bed."],["17",[["δοκοὶ",703781,191],["οἴκων",709516,81],["ἡμῶν",705999,145],["κέδροι",707590,191],["φατνώματα",713393,64],["ἡμῶν",705999,145],["κυπάρισσοι",707982,191]],"The beams of our house are cedars, our ceilings are of cypress."]]