[["1",[["τίς",712867,158],["δῴη",703654,225],["σε",711598,163],["ἀδελφιδόν",700245,6],["μου",709032,133],["θηλάζοντα",706233,183],["μαστοὺς",708569,57],["μητρός",708892,17],["μου",709032,133],["εὑροῦσά",705676,149],["σε",711598,163],["ἔξω",704983,28],["φιλήσω",713471,207],["σε",711598,163],["καί",707031,7],["γε",702985,11],["οὐκ",709805,28],["ἐξουδενώσουσίν",704969,218],["μοι",708974,159]],"I would that thou, O my kinsman, wert he that sucked the breasts of my mother; when I found thee without, I would kiss thee; yea, they should not despise me."],["2",[["παραλήμψομαί",710059,181],["σε",711598,163],["εἰσάξω",704107,165],["σε",711598,163],["εἰς",704105,0],["οἶκον",709516,6],["μητρός",708892,17],["μου",709032,133],["καὶ",707031,7],["εἰς",704105,0],["ταμίειον",712700,25],["τῆς",709436,16],["συλλαβούσης",712262,222],["με",708618,163],["ποτιῶ",710700,165],["σε",711598,163],["ἀπὸ",701425,0],["οἴνου",709530,18],["τοῦ",709436,35],["μυρεψικοῦ",709060,116],["ἀπὸ",701425,0],["νάματος",709181,21],["ῥοῶν",711272,65],["μου",709032,133]],"I would take thee, I would bring thee into my mother's house, and into the chamber of her that conceived me; I would make thee to drink of spiced wine, of the juice of my pomegranates."],["3",[["εὐώνυμος",705736,14],["αὐτοῦ",702165,102],["ὑπὸ",713184,0],["τὴν",709436,8],["κεφαλήν",707639,9],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["δεξιὰ",703360,29],["αὐτοῦ",702165,102],["περιλήμψεταί",710342,93],["με",708618,163]],"His left hand [should be] under my head, and his right hand should embrace me."],["4",[["ὥρκισα",709751,155],["ὑμᾶς",713080,194],["θυγατέρες",706320,185],["Ιερουσαλημ",706644,17],["ἐν",704639,0],["ταῖς",709436,75],["δυνάμεσιν",703839,76],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἰσχύσεσιν",706858,76],["τοῦ",709436,35],["ἀγροῦ",700196,18],["τί",712867,126],["ἐγείρητε",703949,125],["καὶ",707031,7],["τί",712867,126],["ἐξεγείρητε",704889,125],["τὴν",709436,8],["ἀγάπην",700122,9],["ἕως",705792,7],["ἂν",700900,11],["θελήσῃ",706176,172]],"I have charged you, ye daughters of Jerusalem, by the virtues of the field, that ye stir not up, nor awake [my] love, until he please."],["5",[["τίς",712867,359],["αὕτη",709858,107],["ἡ",709436,10],["ἀναβαίνουσα",700905,188],["λελευκανθισμένη",708163,203],["ἐπιστηριζομένη",705270,211],["ἐπὶ",705080,0],["τὸν",709436,5],["ἀδελφιδὸν",700245,6],["αὐτῆς",702165,86],["ὑπὸ",713184,0],["μῆλον",708870,25],["ἐξήγειρά",704889,155],["σε",711598,163],["ἐκεῖ",704181,28],["ὠδίνησέν",714095,2],["σε",711598,163],["ἡ",709436,10],["μήτηρ",708892,12],["σου",711945,133],["ἐκεῖ",704181,28],["ὠδίνησέν",714095,2],["σε",711598,163],["ἡ",709436,10],["τεκοῦσά",712853,149],["σου",711945,133]],"Who is this that comes up all white, leaning on her kinsman? I raised thee up under an apple-tree; there thy mother brought thee forth; there she that bore thee brought thee forth."],["6",[["θές",712849,176],["με",708618,163],["ὡς",714148,7],["σφραγῖδα",712591,9],["ἐπὶ",705080,0],["τὴν",709436,8],["καρδίαν",707141,9],["σου",711945,133],["ὡς",714148,7],["σφραγῖδα",712591,9],["ἐπὶ",705080,0],["τὸν",709436,5],["βραχίονά",702808,6],["σου",711945,133],["ὅτι",709803,7],["κραταιὰ",707873,29],["ὡς",714148,7],["θάνατος",706096,4],["ἀγάπη",700122,12],["σκληρὸς",711861,14],["ὡς",714148,7],["ᾅδης",700255,4],["ζῆλος",705871,4],["περίπτερα",710372,195],["αὐτῆς",702165,86],["περίπτερα",710372,195],["πυρός",711088,21],["φλόγες",713524,191],["αὐτῆς",702165,86]],"Set me as a seal upon thy heart, as a seal upon thine arm; for love is strong as death; jealousy is cruel as the grave, her shafts are shafts of fire, [even] the flames thereof."],["7",[["ὕδωρ",713071,15],["πολὺ",710646,26],["οὐ",709805,28],["δυνήσεται",703838,93],["σβέσαι",711596,106],["τὴν",709436,8],["ἀγάπην",700122,9],["καὶ",707031,7],["ποταμοὶ",710693,52],["οὐ",709805,28],["συγκλύσουσιν",712226,218],["αὐτήν",702165,104],["ἐὰν",703912,7],["δῷ",703654,172],["ἀνὴρ",701150,4],["τὸν",709436,5],["πάντα",710177,27],["βίον",702724,6],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῇ",709436,100],["ἀγάπῃ",700122,1],["ἐξουδενώσει",704971,1],["ἐξουδενώσουσιν",704969,218],["αὐτόν",702165,85]],"Much water will not be able to quench love, and rivers shall not drown it; if a man would give all his substance for love, [men] would utterly despise it."],["8",[["ἀδελφὴ",700244,12],["ἡμῖν",705994,90],["μικρὰ",708915,29],["καὶ",707031,7],["μαστοὺς",708569,57],["οὐκ",709805,28],["ἔχει",705785,91],["τί",712867,126],["ποιήσωμεν",710582,79],["τῇ",709436,100],["ἀδελφῇ",700244,1],["ἡμῶν",705999,145],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["ᾗ",709781,108],["ἐὰν",703912,7],["λαληθῇ",708071,384],["ἐν",704639,0],["αὐτῇ",702165,105]],"Our sister is little, and has no breasts; what shall we do for our sister, in the day wherein she shall be spoken for?"],["9",[["εἰ",704071,7],["τεῖχός",712759,15],["ἐστιν",704093,91],["οἰκοδομήσωμεν",709509,79],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["ἐπάλξεις",705012,39],["ἀργυρᾶς",701705,119],["καὶ",707031,7],["εἰ",704071,7],["θύρα",706337,12],["ἐστίν",704093,91],["διαγράψωμεν",703441,79],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["σανίδα",711491,9],["κεδρίνην",707589,36]],"If she is a wall, let us build upon her silver bulwarks; and if she is a door, let us carve for her cedar panels."],["10",[["ἐγὼ",704018,164],["τεῖχος",712759,15],["καὶ",707031,7],["μαστοί",708569,52],["μου",709032,133],["ὡς",714148,7],["πύργοι",711092,52],["ἐγὼ",704018,164],["ἤμην",704093,333],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["αὐτοῦ",702165,102],["ὡς",714148,7],["εὑρίσκουσα",705676,188],["εἰρήνην",704098,9]],"I am a wall, and my breasts are as towers; I was in their eyes as one that found peace."],["11",[["ἀμπελὼν",700872,4],["ἐγενήθη",703104,37],["τῷ",709436,113],["Σαλωμων",711430,114],["ἐν",704639,0],["Βεελαμων",702618,111],["ἔδωκεν",703654,2],["τὸν",709436,5],["ἀμπελῶνα",700872,6],["αὐτοῦ",702165,102],["τοῖς",709436,147],["τηροῦσιν",712844,349],["ἀνὴρ",701150,4],["οἴσει",713428,127],["ἐν",704639,0],["καρπῷ",707169,114],["αὐτοῦ",702165,102],["χιλίους",713859,60],["ἀργυρίου",701707,21]],"Solomon had a vineyard in Beelamon; he let his vineyard to keepers; every one was to bring for its fruit a thousand [pieces] of silver."],["12",[["ἀμπελών",700872,4],["μου",709032,133],["ἐμὸς",704578,14],["ἐνώπιόν",704823,0],["μου",709032,133],["οἱ",709436,136],["χίλιοι",713859,138],["σοί",711925,159],["Σαλωμων",711430,153],["καὶ",707031,7],["οἱ",709436,136],["διακόσιοι",703482,138],["τοῖς",709436,147],["τηροῦσι",712844,349],["τὸν",709436,5],["καρπὸν",707169,6],["αὐτοῦ",702165,102]],"My vineyard, even mine, is before me; Solomon [shall have] a thousand, and they that keep its fruit two hundred."],["13",[["ὁ",709436,3],["καθήμενος",707000,122],["ἐν",704639,0],["κήποις",707654,148],["ἑταῖροι",705529,52],["προσέχοντες",710895,146],["τῇ",709436,100],["φωνῇ",713640,1],["σου",711945,133],["ἀκούτισόν",700585,176],["με",708618,163]],"Thou that dwellest in the gardens, the companions hearken to thy voice: make me hear [it]."],["14",[["φύγε",713433,176],["ἀδελφιδέ",700245,153],["μου",709032,133],["καὶ",707031,7],["ὁμοιώθητι",709628,244],["τῇ",709436,100],["δορκάδι",703801,1],["ἢ",705924,7],["τῷ",709436,113],["νεβρῷ",709236,114],["τῶν",709436,80],["ἐλάφων",704398,81],["ἐπὶ",705080,0],["ὄρη",709768,42],["ἀρωμάτων",701867,44]],"Away, my kinsman, and be like a doe or a fawn on the mountains of spices."]]