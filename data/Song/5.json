[["1",[["εἰσῆλθον",704114,155],["εἰς",704105,0],["κῆπόν",707654,6],["μου",709032,133],["ἀδελφή",700244,258],["μου",709032,133],["νύμφη",709381,258],["ἐτρύγησα",712996,155],["σμύρναν",711914,9],["μου",709032,133],["μετὰ",708780,0],["ἀρωμάτων",701867,44],["μου",709032,133],["ἔφαγον",713296,155],["ἄρτον",701829,6],["μου",709032,133],["μετὰ",708780,0],["μέλιτός",708700,21],["μου",709032,133],["ἔπιον",710478,155],["οἶνόν",709530,6],["μου",709032,133],["μετὰ",708780,0],["γάλακτός",702919,21],["μου",709032,133],["φάγετε",713296,337],["πλησίοι",710548,274],["καὶ",707031,7],["πίετε",710478,74],["καὶ",707031,7],["μεθύσθητε",708676,372],["ἀδελφοί",700249,274]],"Let my kinsman come down into his garden, and eat the fruit of his choice berries. I am come into my garden, my sister, [my] spouse: I have gathered my myrrh with my spices; I have eaten my bread with my honey; I have drunk my wine with my milk. Eat, O friends, and drink; yea, brethren, drink abundantly."],["2",[["ἐγὼ",704018,164],["καθεύδω",706996,157],["καὶ",707031,7],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["ἀγρυπνεῖ",700197,91],["φωνὴ",713640,12],["ἀδελφιδοῦ",700245,18],["μου",709032,133],["κρούει",707920,91],["ἐπὶ",705080,0],["τὴν",709436,8],["θύραν",706337,9],["ἄνοιξόν",701186,176],["μοι",708974,159],["ἀδελφή",700244,258],["μου",709032,133],["ἡ",709436,747],["πλησίον",710547,28],["μου",709032,133],["περιστερά",710391,258],["μου",709032,133],["τελεία",712769,602],["μου",709032,133],["ὅτι",709803,7],["ἡ",709436,10],["κεφαλή",707639,12],["μου",709032,133],["ἐπλήσθη",710532,37],["δρόσου",703835,17],["καὶ",707031,7],["οἱ",709436,136],["βόστρυχοί",702771,52],["μου",709032,133],["ψεκάδων",714033,65],["νυκτός",709386,17]],"I sleep, but my heart is awake: the voice of my kinsman knocks at the door, [saying], Open, open to me, my companion, my sister, my dove, my perfect one: for my head is filled with dew, and my locks with the drops of the night."],["3",[["ἐξεδυσάμην",704180,161],["τὸν",709436,5],["χιτῶνά",713869,6],["μου",709032,133],["πῶς",711121,28],["ἐνδύσωμαι",704701,410],["αὐτόν",702165,85],["ἐνιψάμην",709314,161],["τοὺς",709436,58],["πόδας",710707,57],["μου",709032,133],["πῶς",711121,28],["μολυνῶ",708987,207],["αὐτούς",702165,62]],"I have put off my coat; how shall I put it on? I have washed my feet, how shall I defile them?"],["4",[["ἀδελφιδός",700245,4],["μου",709032,133],["ἀπέστειλεν",701592,2],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["τῆς",709436,16],["ὀπῆς",709688,17],["καὶ",707031,7],["ἡ",709436,10],["κοιλία",707761,12],["μου",709032,133],["ἐθροήθη",706313,37],["ἐπ᾿",705080,0],["αὐτόν",702165,85]],"My kinsman put forth his hand by the hole [of the door], and my belly was moved for him."],["5",[["ἀνέστην",701173,155],["ἐγὼ",704018,164],["ἀνοῖξαι",701186,106],["τῷ",709436,113],["ἀδελφιδῷ",700245,114],["μου",709032,133],["χεῖρές",713787,191],["μου",709032,133],["ἔσταξαν",712038,150],["σμύρναν",711914,9],["δάκτυλοί",703259,52],["μου",709032,133],["σμύρναν",711914,9],["πλήρη",710541,36],["ἐπὶ",705080,0],["χεῖρας",713787,39],["τοῦ",709436,20],["κλείθρου",707708,21]],"I rose up to open to my kinsman; my hands dropped myrrh, my fingers choice myrrh, on the handles of the lock."],["6",[["ἤνοιξα",701186,155],["ἐγὼ",704018,164],["τῷ",709436,113],["ἀδελφιδῷ",700245,114],["μου",709032,133],["ἀδελφιδός",700245,4],["μου",709032,133],["παρῆλθεν",710141,2],["ψυχή",714070,12],["μου",709032,133],["ἐξῆλθεν",704909,2],["ἐν",704639,0],["λόγῳ",708236,114],["αὐτοῦ",702165,102],["ἐζήτησα",705879,155],["αὐτὸν",702165,85],["καὶ",707031,7],["οὐχ",709805,28],["εὗρον",705676,155],["αὐτόν",702165,85],["ἐκάλεσα",707084,155],["αὐτόν",702165,85],["καὶ",707031,7],["οὐχ",709805,28],["ὑπήκουσέν",713096,2],["μου",709032,133]],"I opened to my kinsman; my kinsman was gone: my soul failed at his speech: I sought him, but found him not; I called him, but he answered me not."],["7",[["εὕροσάν",705676,150],["με",708618,163],["οἱ",709436,136],["φύλακες",713616,52],["οἱ",709436,136],["κυκλοῦντες",707958,146],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["ἐπάταξάν",710185,150],["με",708618,163],["ἐτραυμάτισάν",712922,150],["με",708618,163],["ἦραν",700473,150],["τὸ",709436,24],["θέριστρόν",706210,25],["μου",709032,133],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["φύλακες",713616,52],["τῶν",709436,43],["τειχέων",712759,44]],"The watchmen that go their rounds in the city found me, they smote me, they wounded me; the keepers of the walls took away my veil from me."],["8",[["ὥρκισα",709751,155],["ὑμᾶς",713080,194],["θυγατέρες",706320,185],["Ιερουσαλημ",706644,17],["ἐν",704639,0],["ταῖς",709436,75],["δυνάμεσιν",703839,76],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἰσχύσεσιν",706858,76],["τοῦ",709436,35],["ἀγροῦ",700196,18],["ἐὰν",703912,7],["εὕρητε",705676,125],["τὸν",709436,5],["ἀδελφιδόν",700245,6],["μου",709032,133],["τί",712867,126],["ἀπαγγείλητε",701321,125],["αὐτῷ",702165,50],["ὅτι",709803,7],["τετρωμένη",712871,451],["ἀγάπης",700122,17],["εἰμὶ",704093,157],["ἐγώ",704018,164]],"I have charged you, O daughters of Jerusalem, by the powers and the virtues of the field: if ye should find my kinsman, what are ye to say to him? That I am wounded with love."],["9",[["τί",712867,273],["ἀδελφιδός",700245,4],["σου",711945,133],["ἀπὸ",701425,0],["ἀδελφιδοῦ",700245,18],["ἡ",709436,747],["καλὴ",707097,602],["ἐν",704639,0],["γυναιξίν",703209,76],["τί",712867,126],["ἀδελφιδός",700245,4],["σου",711945,133],["ἀπὸ",701425,0],["ἀδελφιδοῦ",700245,18],["ὅτι",709803,7],["οὕτως",709859,28],["ὥρκισας",709751,162],["ἡμᾶς",705981,194]],"What is thy kinsman [more] than [another] kinsman, O thou beautiful among women? what is thy kinsman [more] than [another] kinsman, that thou hast so charged us?"],["10",[["ἀδελφιδός",700245,4],["μου",709032,133],["λευκὸς",708165,14],["καὶ",707031,7],["πυρρός",711108,14],["ἐκλελοχισμένος",704251,251],["ἀπὸ",701425,0],["μυριάδων",709062,65]],"My kinsman is white and ruddy, chosen out from myriads."],["11",[["κεφαλὴ",707639,12],["αὐτοῦ",702165,102],["χρυσίον",713972,15],["καὶ",707031,7],["φαζ",713306,323],["βόστρυχοι",702771,52],["αὐτοῦ",702165,102],["ἐλάται",704389,191],["μέλανες",708695,138],["ὡς",714148,7],["κόραξ",707831,4]],"His head is [as] very fine gold, his locks are flowing, black as a raven."],["12",[["ὀφθαλμοὶ",709870,52],["αὐτοῦ",702165,102],["ὡς",714148,7],["περιστεραὶ",710391,191],["ἐπὶ",705080,0],["πληρώματα",710544,42],["ὑδάτων",713071,44],["λελουσμέναι",708258,415],["ἐν",704639,0],["γάλακτι",702919,54],["καθήμεναι",707000,305],["ἐπὶ",705080,0],["πληρώματα",710544,42],["ὑδάτων",713071,44]],"His eyes are as doves, by the pools of waters, washed with milk, sitting by the pools."],["13",[["σιαγόνες",711763,191],["αὐτοῦ",702165,102],["ὡς",714148,7],["φιάλαι",713453,191],["τοῦ",709436,20],["ἀρώματος",701867,21],["φύουσαι",713638,306],["μυρεψικά",709060,68],["χείλη",713781,64],["αὐτοῦ",702165,102],["κρίνα",707904,64],["στάζοντα",712038,242],["σμύρναν",711914,9],["πλήρη",710541,36]],"His cheeks are as bowls of spices pouring forth perfumes: his lips are lilies, dropping choice myrrh."],["14",[["χεῖρες",713787,191],["αὐτοῦ",702165,102],["τορευταὶ",712904,192],["χρυσαῖ",713971,192],["πεπληρωμέναι",710543,415],["θαρσις",706125,228],["κοιλία",707761,12],["αὐτοῦ",702165,102],["πυξίον",711086,15],["ἐλεφάντινον",704436,26],["ἐπὶ",705080,0],["λίθου",708196,18],["σαπφείρου",711505,17]],"His hands are as turned gold set with beryl: his belly is an ivory tablet on a sapphire stone."],["15",[["κνῆμαι",707750,191],["αὐτοῦ",702165,102],["στῦλοι",712179,52],["μαρμάρινοι",708515,138],["τεθεμελιωμένοι",706182,362],["ἐπὶ",705080,0],["βάσεις",702585,39],["χρυσᾶς",713971,119],["εἶδος",704074,15],["αὐτοῦ",702165,102],["ὡς",714148,7],["Λίβανος",708185,4],["ἐκλεκτὸς",704240,14],["ὡς",714148,7],["κέδροι",707590,191]],"His legs are marble pillars set on golden sockets: his form is as Libanus, choice as the cedars."],["16",[["φάρυγξ",713375,4],["αὐτοῦ",702165,102],["γλυκασμοὶ",703112,52],["καὶ",707031,7],["ὅλος",709597,14],["ἐπιθυμία",705147,12],["οὗτος",709858,121],["ἀδελφιδός",700245,4],["μου",709032,133],["καὶ",707031,7],["οὗτος",709858,121],["πλησίον",710547,28],["μου",709032,133],["θυγατέρες",706320,185],["Ιερουσαλημ",706644,17]],"His throat is most sweet, and altogether desirable. This is my kinsman, and this is my companion, O daughters of Jerusalem."]]