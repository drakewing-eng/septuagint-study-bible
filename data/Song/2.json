[["1",[["ἐγὼ",704018,164],["ἄνθος",701157,15],["τοῦ",709436,20],["πεδίου",710215,21],["κρίνον",707904,15],["τῶν",709436,130],["κοιλάδων",707758,65]],"I am a flower of the plain, a lily of the valleys."],["2",[["ὡς",714148,7],["κρίνον",707904,15],["ἐν",704639,0],["μέσῳ",708768,97],["ἀκανθῶν",700517,65],["οὕτως",709859,28],["ἡ",709436,10],["πλησίον",710547,28],["μου",709032,133],["ἀνὰ",700902,0],["μέσον",708768,46],["τῶν",709436,130],["θυγατέρων",706320,65]],"As a lily among thorns, so is my companion among the daughters."],["3",[["ὡς",714148,7],["μῆλον",708870,15],["ἐν",704639,0],["τοῖς",709436,95],["ξύλοις",709427,96],["τοῦ",709436,35],["δρυμοῦ",703836,18],["οὕτως",709859,28],["ἀδελφιδός",700245,4],["μου",709032,133],["ἀνὰ",700902,0],["μέσον",708768,46],["τῶν",709436,80],["υἱῶν",713075,81],["ἐν",704639,0],["τῇ",709436,100],["σκιᾷ",711852,1],["αὐτοῦ",702165,102],["ἐπεθύμησα",705141,155],["καὶ",707031,7],["ἐκάθισα",707006,155],["καὶ",707031,7],["καρπὸς",707169,4],["αὐτοῦ",702165,102],["γλυκὺς",703114,14],["ἐν",704639,0],["λάρυγγί",708098,114],["μου",709032,133]],"As the apple among the trees of the wood, so is my kinsman among the sons. I desired his shadow, and sat down, and his fruit was sweet in my throat."],["4",[["εἰσαγάγετέ",704107,74],["με",708618,163],["εἰς",704105,0],["οἶκον",709516,6],["τοῦ",709436,35],["οἴνου",709530,18],["τάξατε",712730,74],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ἀγάπην",700122,9]],"Bring me into the wine house; set love before me."],["5",[["στηρίσατέ",712098,74],["με",708618,163],["ἐν",704639,0],["ἀμόραις",700863,291],["στοιβάσατέ",712115,74],["με",708618,163],["ἐν",704639,0],["μήλοις",708870,96],["ὅτι",709803,7],["τετρωμένη",712871,451],["ἀγάπης",700122,17],["ἐγώ",704018,164]],"Strengthen me with perfumes, stay me with apples: for I [am] wounded with love."],["6",[["εὐώνυμος",705736,14],["αὐτοῦ",702165,102],["ὑπὸ",713184,0],["τὴν",709436,8],["κεφαλήν",707639,9],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["δεξιὰ",703360,29],["αὐτοῦ",702165,102],["περιλήμψεταί",710342,93],["με",708618,163]],"His left [hand shall be] under my head, and his right hand shall embrace me."],["7",[["ὥρκισα",709751,155],["ὑμᾶς",713080,194],["θυγατέρες",706320,185],["Ιερουσαλημ",706644,17],["ἐν",704639,0],["ταῖς",709436,75],["δυνάμεσιν",703839,76],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἰσχύσεσιν",706858,76],["τοῦ",709436,35],["ἀγροῦ",700196,18],["ἐὰν",703912,7],["ἐγείρητε",703949,125],["καὶ",707031,7],["ἐξεγείρητε",704889,125],["τὴν",709436,8],["ἀγάπην",700122,9],["ἕως",705792,0],["οὗ",709781,48],["θελήσῃ",706176,172]],"I have charged you, ye daughters of Jerusalem, by the powers and by the virtues of the field, that ye do not rouse or wake [my] love, until he please."],["8",[["φωνὴ",713640,12],["ἀδελφιδοῦ",700245,18],["μου",709032,133],["ἰδοὺ",706497,88],["οὗτος",709858,121],["ἥκει",705956,91],["πηδῶν",710454,72],["ἐπὶ",705080,0],["τὰ",709436,41],["ὄρη",709768,42],["διαλλόμενος",703503,122],["ἐπὶ",705080,0],["τοὺς",709436,58],["βουνούς",702797,57]],"The voice of my kinsman! behold, he comes leaping over the mountains, bounding over the hills."],["9",[["ὅμοιός",709626,14],["ἐστιν",704093,91],["ἀδελφιδός",700245,4],["μου",709032,133],["τῇ",709436,100],["δορκάδι",703801,1],["ἢ",705924,7],["νεβρῷ",709236,114],["ἐλάφων",704398,81],["ἐπὶ",705080,0],["τὰ",709436,41],["ὄρη",709768,42],["Βαιθηλ",702412,118],["ἰδοὺ",706497,88],["οὗτος",709858,121],["ἕστηκεν",706846,171],["ὀπίσω",709697,0],["τοῦ",709436,35],["τοίχου",712879,18],["ἡμῶν",705999,145],["παρακύπτων",710057,72],["διὰ",703417,0],["τῶν",709436,130],["θυρίδων",706340,65],["ἐκκύπτων",704229,72],["διὰ",703417,0],["τῶν",709436,43],["δικτύων",703703,44]],"My kinsman is like a roe or a young hart on the mountains of Bæthel: behold, he is behind our wall, looking through the windows, peeping through the lattices."],["10",[["ἀποκρίνεται",701492,117],["ἀδελφιδός",700245,4],["μου",709032,133],["καὶ",707031,7],["λέγει",708124,91],["μοι",708974,159],["ἀνάστα",701173,176],["ἐλθέ",705453,176],["ἡ",709436,747],["πλησίον",710547,28],["μου",709032,133],["καλή",707097,602],["μου",709032,133],["περιστερά",710391,258],["μου",709032,133]],"My kinsman answers, and says to me, Rise up, come, my companion, my fair one, my dove."],["11",[["ὅτι",709803,7],["ἰδοὺ",706497,88],["ὁ",709436,3],["χειμὼν",713786,4],["παρῆλθεν",710141,2],["ὁ",709436,3],["ὑετὸς",713074,4],["ἀπῆλθεν",701398,2],["ἐπορεύθη",710667,37],["ἑαυτῷ",703917,50]],"For, behold, the winter is past, the rain is gone, it has departed."],["12",[["τὰ",709436,63],["ἄνθη",701157,64],["ὤφθη",709725,37],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["καιρὸς",707047,4],["τῆς",709436,16],["τομῆς",712890,17],["ἔφθακεν",713439,171],["φωνὴ",713640,12],["τοῦ",709436,35],["τρυγόνος",713000,17],["ἠκούσθη",700587,37],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ἡμῶν",705999,145]],"The flowers are seen in the land; the time of pruning has arrived; the voice of the turtle-dove has been heard in our land."],["13",[["ἡ",709436,10],["συκῆ",712254,12],["ἐξήνεγκεν",704356,2],["ὀλύνθους",709604,57],["αὐτῆς",702165,86],["αἱ",709436,190],["ἄμπελοι",700870,191],["κυπρίζουσιν",707984,197],["ἔδωκαν",703654,150],["ὀσμήν",709786,9],["ἀνάστα",701173,176],["ἐλθέ",705453,176],["ἡ",709436,747],["πλησίον",710547,28],["μου",709032,133],["καλή",707097,602],["μου",709032,133],["περιστερά",710391,258],["μου",709032,133]],"The fig-tree has put forth its young figs, the vines put forth the tender grape, they yield a smell: arise, come, my companion, my fair one, my dove; yea, come."],["14",[["καὶ",707031,7],["ἐλθὲ",705453,176],["σύ",712181,164],["περιστερά",710391,258],["μου",709032,133],["ἐν",704639,0],["σκέπῃ",711839,1],["τῆς",709436,16],["πέτρας",710443,17],["ἐχόμενα",705785,208],["τοῦ",709436,20],["προτειχίσματος",710989,21],["δεῖξόν",703314,176],["μοι",708974,159],["τὴν",709436,8],["ὄψιν",709901,9],["σου",711945,133],["καὶ",707031,7],["ἀκούτισόν",700585,176],["με",708618,163],["τὴν",709436,8],["φωνήν",713640,9],["σου",711945,133],["ὅτι",709803,7],["ἡ",709436,10],["φωνή",713640,12],["σου",711945,133],["ἡδεῖα",705945,29],["καὶ",707031,7],["ἡ",709436,10],["ὄψις",709901,12],["σου",711945,133],["ὡραία",714132,68]],"[Thou art] my dove, in the shelter of the rock, near the wall: shew me thy face, and cause me to hear thy voice; for thy voice is sweet, and thy countenance is beautiful."],["15",[["πιάσατε",710463,74],["ἡμῖν",705994,90],["ἀλώπεκας",700743,39],["μικροὺς",708915,60],["ἀφανίζοντας",702182,235],["ἀμπελῶνας",700872,57],["καὶ",707031,7],["αἱ",709436,190],["ἄμπελοι",700870,191],["ἡμῶν",705999,145],["κυπρίζουσιν",707984,197]],"Take us the little foxes that spoil the vines: for our vines put forth tender grapes."],["16",[["ἀδελφιδός",700245,4],["μου",709032,133],["ἐμοί",704577,159],["κἀγὼ",706969,288],["αὐτῷ",702165,50],["ὁ",709436,3],["ποιμαίνων",710594,72],["ἐν",704639,0],["τοῖς",709436,95],["κρίνοις",707904,96]],"My kinsman is mine, and I am his: he feeds [his flock] among the lilies."],["17",[["ἕως",705792,0],["οὗ",709781,48],["διαπνεύσῃ",703549,172],["ἡ",709436,10],["ἡμέρα",705984,12],["καὶ",707031,7],["κινηθῶσιν",707679,272],["αἱ",709436,190],["σκιαί",711852,191],["ἀπόστρεψον",701598,176],["ὁμοιώθητι",709628,244],["σύ",712181,164],["ἀδελφιδέ",700245,153],["μου",709032,133],["τῷ",709436,113],["δόρκωνι",703803,114],["ἢ",705924,7],["νεβρῷ",709236,114],["ἐλάφων",704398,81],["ἐπὶ",705080,0],["ὄρη",709768,42],["κοιλωμάτων",707766,44]],"Until the day dawn, and the shadows depart, turn, my kinsman, be thou like to a roe or young hart on the mountains of the ravines."]]