[["1",[["ποῦ",710706,28],["ἀπῆλθεν",701398,2],["ὁ",709436,3],["ἀδελφιδός",700245,4],["σου",711945,133],["ἡ",709436,747],["καλὴ",707097,602],["ἐν",704639,0],["γυναιξίν",703209,76],["ποῦ",710706,28],["ἀπέβλεψεν",701430,2],["ὁ",709436,3],["ἀδελφιδός",700245,4],["σου",711945,133],["καὶ",707031,7],["ζητήσομεν",705879,275],["αὐτὸν",702165,85],["μετὰ",708780,0],["σοῦ",711945,133]],"Whither is thy kinsman gone, thou beautiful among women? whither has thy kinsman turned aside? [tell us], and we will seek him with thee."],["2",[["ἀδελφιδός",700245,4],["μου",709032,133],["κατέβη",707202,2],["εἰς",704105,0],["κῆπον",707654,6],["αὐτοῦ",702165,102],["εἰς",704105,0],["φιάλας",713453,39],["τοῦ",709436,20],["ἀρώματος",701867,21],["ποιμαίνειν",710594,55],["ἐν",704639,0],["κήποις",707654,148],["καὶ",707031,7],["συλλέγειν",712263,55],["κρίνα",707904,42]],"My kinsman is gone down to his garden, to the beds of spice, to feed [his flock] in the gardens, and to gather lilies."],["3",[["ἐγὼ",704018,164],["τῷ",709436,113],["ἀδελφιδῷ",700245,114],["μου",709032,133],["καὶ",707031,7],["ἀδελφιδός",700245,4],["μου",709032,133],["ἐμοὶ",704577,159],["ὁ",709436,3],["ποιμαίνων",710594,72],["ἐν",704639,0],["τοῖς",709436,95],["κρίνοις",707904,96]],"I am my kinsman's, and my kinsman is mine, who feeds among the lilies."],["4",[["καλὴ",707097,29],["εἶ",704093,154],["ἡ",709436,747],["πλησίον",710547,28],["μου",709032,133],["ὡς",714148,7],["εὐδοκία",705566,12],["ὡραία",714132,29],["ὡς",714148,7],["Ιερουσαλημ",706644,12],["θάμβος",706082,15],["ὡς",714148,7],["τεταγμέναι",712730,423]],"Thou art fair, my companion, as Pleasure, beautiful as Jerusalem, terrible as [armies] set in array."],["5",[["ἀπόστρεψον",701598,176],["ὀφθαλμούς",709870,57],["σου",711945,133],["ἀπεναντίον",701390,28],["μου",709032,133],["ὅτι",709803,7],["αὐτοὶ",702165,201],["ἀνεπτέρωσάν",701041,150],["με",708618,163],["τρίχωμά",712972,15],["σου",711945,133],["ὡς",714148,7],["ἀγέλαι",700148,191],["τῶν",709436,130],["αἰγῶν",700464,65],["αἳ",709781,256],["ἀνεφάνησαν",701080,99],["ἀπὸ",701425,0],["τοῦ",709436,35],["Γαλααδ",702920,118]],"Turn away thine eyes from before me, for they have ravished me: thy hair is as flocks of goats which have appeared from Galaad."],["6",[["ὀδόντες",709461,52],["σου",711945,133],["ὡς",714148,7],["ἀγέλαι",700148,191],["τῶν",709436,130],["κεκαρμένων",707597,748],["αἳ",709781,256],["ἀνέβησαν",700905,150],["ἀπὸ",701425,0],["τοῦ",709436,20],["λουτροῦ",708257,21],["αἱ",709436,190],["πᾶσαι",710177,192],["διδυμεύουσαι",703652,306],["καὶ",707031,7],["ἀτεκνοῦσα",702081,188],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐν",704639,0],["αὐταῖς",702165,200]],"Thy teeth are as flocks of shorn [sheep], that have gone up from the washing, all of them bearing twins, and there is none barren among them: thy lips are as a thread of scarlet, and thy speech is comely.",{"s":"d","q":0.65}],["7",[["ὡς",714148,7],["σπαρτίον",711999,15],["τὸ",709436,34],["κόκκινον",707783,26],["χείλη",713781,64],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["λαλιά",708074,12],["σου",711945,133],["ὡραία",714132,29],["ὡς",714148,7],["λέπυρον",708155,15],["τῆς",709436,16],["ῥόας",711272,17],["μῆλόν",708870,15],["σου",711945,133],["ἐκτὸς",704339,0],["τῆς",709436,16],["σιωπήσεώς",711820,17],["σου",711945,133]],"Thy cheek is like the rind of a pomegranate, [being seen] without thy veil.",{"s":"d","q":0.43}],["8",[["ἑξήκοντά",704922,59],["εἰσιν",704093,197],["βασίλισσαι",702584,191],["καὶ",707031,7],["ὀγδοήκοντα",709442,59],["παλλακαί",709943,191],["καὶ",707031,7],["νεάνιδες",709231,191],["ὧν",709781,199],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀριθμός",701744,4]],"There are sixty queens, and eighty concubines, and maidens without number."],["9",[["μία",704106,29],["ἐστὶν",704093,91],["περιστερά",710391,12],["μου",709032,133],["τελεία",712769,29],["μου",709032,133],["μία",704106,29],["ἐστὶν",704093,91],["τῇ",709436,100],["μητρὶ",708892,1],["αὐτῆς",702165,86],["ἐκλεκτή",704240,29],["ἐστιν",704093,91],["τῇ",709436,100],["τεκούσῃ",712853,603],["αὐτῆς",702165,86],["εἴδοσαν",709725,150],["αὐτὴν",702165,104],["θυγατέρες",706320,191],["καὶ",707031,7],["μακαριοῦσιν",708396,197],["αὐτήν",702165,104],["βασίλισσαι",702584,191],["καὶ",707031,7],["παλλακαὶ",709943,191],["καὶ",707031,28],["αἰνέσουσιν",700459,218],["αὐτήν",702165,104]],"My dove, my perfect one is one; she is the [only] one of her mother; she is the choice of her that bore her. The daughters saw her, and the queens will pronounce her blessed, yea, and the concubines, and they will praise her."],["10",[["τίς",712867,359],["αὕτη",709858,107],["ἡ",709436,10],["ἐκκύπτουσα",704229,188],["ὡσεὶ",714159,0],["ὄρθρος",709745,4],["καλὴ",707097,29],["ὡς",714148,7],["σελήνη",711650,12],["ἐκλεκτὴ",704240,29],["ὡς",714148,7],["ὁ",709436,3],["ἥλιος",705974,4],["θάμβος",706082,15],["ὡς",714148,7],["τεταγμέναι",712730,423]],"Who is this that looks forth as the morning, fair as the moon, choice as the sun, terrible as [armies] set in array?"],["11",[["εἰς",704105,0],["κῆπον",707654,6],["καρύας",707183,17],["κατέβην",707202,155],["ἰδεῖν",709725,106],["ἐν",704639,0],["γενήμασιν",703052,96],["τοῦ",709436,35],["χειμάρρου",713783,18],["ἰδεῖν",709725,106],["εἰ",704071,7],["ἤνθησεν",701152,2],["ἡ",709436,10],["ἄμπελος",700870,12],["ἐξήνθησαν",704864,150],["αἱ",709436,190],["ῥόαι",711272,191],["ἐκεῖ",704181,28],["δώσω",703654,165],["τοὺς",709436,58],["μαστούς",708569,57],["μου",709032,133],["σοί",711925,159]],"I went down to the garden of nuts, to look at the fruits of the valley, to see if the vine flowered, [if] the pomegranates blossomed.",{"s":"d","q":0.7}],["12",[["οὐκ",709805,28],["ἔγνω",703105,2],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ἔθετό",712849,23],["με",708618,163],["ἅρματα",701768,42],["Αμιναδαβ",700824,118]],"There I will give thee my breasts: my soul knew [it] not: it made me as the chariots of Aminadab.",{"s":"d","q":0.62}]]