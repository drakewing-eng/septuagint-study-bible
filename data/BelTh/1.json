[["1",[["καὶ",707031,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ἀστυάγης",702025,4],["προσετέθη",710965,37],["πρὸς",710844,0],["τοὺς",709436,58],["πατέρας",710189,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["παρέλαβεν",710059,2],["Κῦρος",707997,4],["ὁ",709436,3],["Πέρσης",710429,4],["τὴν",709436,8],["βασιλείαν",702577,9],["αὐτοῦ",702165,102]],"And king Astyages was gathered to his fathers, and Cyrus of Persia received his kingdom."],["2",[["καὶ",707031,7],["ἦν",704093,13],["Δανιηλ",703283,4],["συμβιωτὴς",712283,4],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["ἔνδοξος",704694,14],["ὑπὲρ",713111,0],["πάντας",710177,60],["τοὺς",709436,58],["φίλους",713492,60],["αὐτοῦ",702165,102]],"And Daniel conversed with the king, and was honoured above all his friends."],["3",[["καὶ",707031,7],["ἦν",704093,13],["εἴδωλον",704079,15],["τοῖς",709436,147],["Βαβυλωνίοις",702355,148],["ᾧ",709781,209],["ὄνομα",709666,15],["Βηλ",702694,4],["καὶ",707031,7],["ἐδαπανῶντο",703286,667],["εἰς",704105,0],["αὐτὸν",702165,85],["ἑκάστης",704133,82],["ἡμέρας",705984,17],["σεμιδάλεως",711675,17],["ἀρτάβαι",701823,191],["δώδεκα",703887,59],["καὶ",707031,7],["πρόβατα",710768,64],["τεσσαράκοντα",712806,59],["καὶ",707031,7],["οἴνου",709530,18],["μετρηταὶ",708842,52],["ἕξ",704828,59]],"Now the Babylonians had an idol, called Bel, and there were spent upon him every day twelve great measures of fine flour, and forty sheep, and six vessels of wine."],["4",[["καὶ",707031,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐσέβετο",711609,19],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐπορεύετο",710667,19],["καθ᾿",707200,0],["ἑκάστην",704133,36],["ἡμέραν",705984,9],["προσκυνεῖν",710925,55],["αὐτῷ",702165,50],["Δανιηλ",703283,4],["δὲ",703303,11],["προσεκύνει",710925,13],["τῷ",709436,113],["θεῷ",706192,114],["αὐτοῦ",702165,102]],"And the king worshipped it, and went daily to adore it: but Daniel worshipped his own God. And the king said unto him, Why dost not thou worship Bel?"],["5",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["ὁ",709436,3],["βασιλεύς",702580,4],["διὰ",703417,0],["τί",712867,126],["οὐ",709805,28],["προσκυνεῖς",710925,154],["τῷ",709436,113],["Βηλ",702694,114],["ὁ",709436,3],["δὲ",703303,11],["εἶπεν",705373,2],["ὅτι",709803,7],["οὐ",709805,28],["σέβομαι",711609,254],["εἴδωλα",704079,42],["χειροποίητα",713796,68],["ἀλλὰ",700680,7],["τὸν",709436,5],["ζῶντα",705851,183],["θεὸν",706192,6],["τὸν",709436,5],["κτίσαντα",707938,365],["τὸν",709436,5],["οὐρανὸν",709844,6],["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἔχοντα",705785,183],["πάσης",710177,82],["σαρκὸς",711537,17],["κυριείαν",707994,9]],"Who answered and said, Because I may not worship idols made with hands, but the living God, who hath created the heaven and the earth, and hath sovereignty over all flesh."],["6",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["ὁ",709436,3],["βασιλεύς",702580,4],["οὐ",709805,28],["δοκεῖ",703775,91],["σοι",711925,159],["Βηλ",702694,6],["εἶναι",704093,55],["ζῶν",705851,72],["θεός",706192,4],["ἦ",705924,7],["οὐχ",709805,28],["ὁρᾷς",709725,154],["ὅσα",709788,68],["ἐσθίει",705495,91],["καὶ",707031,7],["πίνει",710478,91],["καθ᾿",707200,0],["ἑκάστην",704133,36],["ἡμέραν",705984,9]],"Then said the king unto him, Thinkest thou not that Bel is a living god? seest thou not how much he eateth and drinketh every day?"],["7",[["καὶ",707031,7],["εἶπεν",705373,2],["Δανιηλ",703283,4],["γελάσας",703019,182],["μὴ",708851,28],["πλανῶ",710495,157],["βασιλεῦ",702580,153],["οὗτος",709858,121],["γὰρ",702963,11],["ἔσωθεν",705523,28],["μέν",708730,11],["ἐστι",704093,91],["πηλὸς",710457,4],["ἔξωθεν",704984,28],["δὲ",703303,11],["χαλκὸς",713695,4],["καὶ",707031,7],["οὐ",709805,28],["βέβρωκεν",702722,171],["οὐδὲ",709816,7],["πέπωκεν",710478,171],["πώποτε",711118,28]],"Then Daniel smiled, and said, O king, be not deceived: for this is but clay within, and brass without, and did never eat or drink any thing."],["8",[["καὶ",707031,7],["θυμωθεὶς",706335,217],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐκάλεσεν",707084,2],["τοὺς",709436,58],["ἱερεῖς",706614,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["ἐὰν",703912,7],["μὴ",708851,28],["εἴπητέ",705373,125],["μοι",708974,159],["τίς",712867,158],["ὁ",709436,3],["κατέσθων",707519,72],["τὴν",709436,8],["δαπάνην",703287,9],["ταύτην",709858,104],["ἀποθανεῖσθε",701461,124],["ἐὰν",703912,7],["δὲ",703303,11],["δείξητε",703314,125],["ὅτι",709803,7],["Βηλ",702694,4],["κατεσθίει",707519,91],["αὐτά",702165,71],["ἀποθανεῖται",701461,123],["Δανιηλ",703283,4],["ὅτι",709803,7],["ἐβλασφήμησεν",702737,2],["εἰς",704105,0],["τὸν",709436,5],["Βηλ",702694,6]],"So the king was wroth, and called for his priests, and said unto them, If ye tell me not who this is that devoureth these expences, ye shall die."],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["Δανιηλ",703283,4],["τῷ",709436,113],["βασιλεῖ",702580,114],["γινέσθω",703104,407],["κατὰ",707200,0],["τὸ",709436,24],["ῥῆμά",711246,25],["σου",711945,133],["καὶ",707031,7],["ἦσαν",704093,137],["ἱερεῖς",706614,52],["τοῦ",709436,35],["Βηλ",702694,18],["ἑβδομήκοντα",703922,59],["ἐκτὸς",704339,0],["γυναικῶν",703209,65],["καὶ",707031,7],["τέκνων",712761,44]],"But if ye can certify me that Bel devoureth them, then Daniel shall die: for he hath spoken blasphemy against Bel. And Daniel said unto the king, Let it be according to thy word."],["10",[["καὶ",707031,7],["ἦλθεν",705453,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["μετὰ",708780,0],["Δανιηλ",703283,18],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["Βηλ",702694,18]],"Now the priests of Bel were threescore and ten, beside their wives and children. And the king went with Daniel into the temple of Bel."],["11",[["καὶ",707031,7],["εἶπαν",705373,150],["οἱ",709436,136],["ἱερεῖς",706614,52],["τοῦ",709436,35],["Βηλ",702694,18],["ἰδοὺ",706497,88],["ἡμεῖς",705983,219],["ἀποτρέχομεν",701623,243],["ἔξω",704983,28],["σὺ",712181,164],["δέ",703303,11],["βασιλεῦ",702580,153],["παράθες",710111,176],["τὰ",709436,41],["βρώματα",702823,42],["καὶ",707031,7],["τὸν",709436,5],["οἶνον",709530,6],["κεράσας",707623,182],["θὲς",712849,176],["καὶ",707031,7],["ἀπόκλεισον",701484,176],["τὴν",709436,8],["θύραν",706337,9],["καὶ",707031,7],["σφράγισον",712590,176],["τῷ",709436,113],["δακτυλίῳ",703258,114],["σου",711945,133],["καὶ",707031,7],["ἐλθὼν",705453,182],["πρωὶ",711021,28],["ἐὰν",703912,7],["μὴ",708851,28],["εὕρῃς",705676,175],["πάντα",710177,68],["βεβρωμένα",702722,437],["ὑπὸ",713184,0],["τοῦ",709436,35],["Βηλ",702694,18],["ἀποθανούμεθα",701461,141],["ἢ",705924,7],["Δανιηλ",703283,4],["ὁ",709436,3],["ψευδόμενος",714040,122],["καθ᾿",707200,0],["ἡμῶν",705999,145]],"So Bel's priests said, Lo, we go out: but thou, O king, set on the meat, and make ready the wine, and shut the door fast, and seal it with thine own signet;"],["12",[["αὐτοὶ",702165,201],["δὲ",703303,11],["κατεφρόνουν",707482,137],["ὅτι",709803,7],["πεποιήκεισαν",710582,263],["ὑπὸ",713184,0],["τὴν",709436,8],["τράπεζαν",712919,9],["κεκρυμμένην",707923,444],["εἴσοδον",704119,9],["καὶ",707031,7],["δι᾿",703417,0],["αὐτῆς",702165,86],["εἰσεπορεύοντο",704124,139],["διόλου",703722,28],["καὶ",707031,7],["ἀνήλουν",700992,137],["αὐτά",702165,71]],"and to-morrow when thou comest in, if thou findest not that Bel hath eaten up all, we will suffer death: or else Daniel, that speaketh falsely against us."],["13",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὡς",714148,7],["ἐξήλθοσαν",704909,150],["ἐκεῖνοι",704183,201],["καὶ",707031,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["παρέθηκεν",710111,2],["τὰ",709436,41],["βρώματα",702823,42],["τῷ",709436,113],["Βηλ",702694,114]],"And they little regarded it: for under the table they had made a privy entrance, whereby they entered in continually, and consumed those things."],["14",[["καὶ",707031,7],["ἐπέταξεν",705294,2],["Δανιηλ",703283,4],["τοῖς",709436,95],["παιδαρίοις",709923,96],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἤνεγκαν",713428,150],["τέφραν",