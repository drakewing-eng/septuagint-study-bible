[["1",[["καὶ",707031,7],["ἀνέστη",701173,2],["Δαυιδ",703232,4],["καὶ",707031,7],["ἀπῆλθεν",701398,2],["καὶ",707031,7],["Ιωναθαν",706927,4],["εἰσῆλθεν",704114,2],["εἰς",704105,0],["τὴν",709436,8],["πόλιν",710612,9]],"And David arose and departed, and Jonathan went into the city."],["2",[["καὶ",707031,7],["ἔρχεται",705453,117],["Δαυιδ",703232,4],["εἰς",704105,0],["Νομβα",709335,227],["πρὸς",710844,0],["Αβιμελεχ",700068,6],["τὸν",709436,5],["ἱερέα",706614,6],["καὶ",707031,7],["ἐξέστη",704940,2],["Αβιμελεχ",700068,4],["τῇ",709436,100],["ἀπαντήσει",701348,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["τί",712867,579],["ὅτι",709803,7],["σὺ",712181,164],["μόνος",709003,14],["καὶ",707031,7],["οὐθεὶς",709817,195],["μετὰ",708780,0],["σοῦ",711945,133]],"And David comes to Nomba to Abimelech the priest: and Abimelech was amazed at meeting him, and said to him, Why [art] thou alone, and nobody with thee?"],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["τῷ",709436,113],["ἱερεῖ",706614,114],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐντέταλταί",704791,187],["μοι",708974,159],["ῥῆμα",711246,25],["σήμερον",711751,28],["καὶ",707031,7],["εἶπέν",705373,2],["μοι",708974,159],["μηδεὶς",708857,26],["γνώτω",703105,45],["τὸ",709436,24],["ῥῆμα",711246,25],["περὶ",710285,0],["οὗ",709781,160],["ἐγὼ",704018,164],["ἀποστέλλω",701592,157],["σε",711598,163],["καὶ",707031,7],["ὑπὲρ",713111,0],["οὗ",709781,48],["ἐντέταλμαί",704791,326],["σοι",711925,159],["καὶ",707031,7],["τοῖς",709436,95],["παιδαρίοις",709923,96],["διαμεμαρτύρημαι",703513,326],["ἐν",704639,0],["τῷ",709436,113],["τόπῳ",712903,114],["τῷ",709436,113],["λεγομένῳ",708124,241],["θεοῦ",706192,18],["πίστις",710484,12],["Φελλανι",713417,4],["Αλεμωνι",700649,4]],"And David said to the priest, The king gave me a command to-day, and said to me, Let no one know the matter on which I send thee, and concerning which I have charged thee: and I have charged my servants [to be] in the place that is called, The faithfulness of God, phellani maemoni."],["4",[["καὶ",707031,7],["νῦν",709384,28],["εἰ",704071,7],["εἰσὶν",704093,197],["ὑπὸ",713184,0],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133],["πέντε",710266,59],["ἄρτοι",701829,52],["δὸς",703654,176],["εἰς",704105,0],["χεῖρά",713787,9],["μου",709032,133],["τὸ",709436,24],["εὑρεθέν",705676,377]],"And now if there are under thy hand five loaves, give into my hand what is ready."],["5",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["ὁ",709436,3],["ἱερεὺς",706614,4],["τῷ",709436,113],["Δαυιδ",703232,114],["καὶ",707031,7],["εἶπεν",705373,2],["οὐκ",709805,28],["εἰσὶν",704093,197],["ἄρτοι",701829,52],["βέβηλοι",702613,138],["ὑπὸ",713184,0],["τὴν",709436,8],["χεῖρά",713787,9],["μου",709032,133],["ὅτι",709803,7],["ἀλλ᾿",700680,7],["ἢ",705924,7],["ἄρτοι",701829,52],["ἅγιοι",700159,138],["εἰσίν",704093,197],["εἰ",704071,7],["πεφυλαγμένα",713619,388],["τὰ",709436,41],["παιδάριά",709923,42],["ἐστιν",704093,91],["ἀπὸ",701425,0],["γυναικός",703209,17],["καὶ",707031,7],["φάγεται",713296,93]],"And the priest answered David, and said, There are no common loaves under my hand, for I have none but holy loaves: if the young men have been kept at least from women, then they shall eat [them]."],["6",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["Δαυιδ",703232,4],["τῷ",709436,113],["ἱερεῖ",706614,114],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["ἀλλὰ",700680,7],["ἀπὸ",701425,0],["γυναικὸς",703209,17],["ἀπεσχήμεθα",701225,580],["ἐχθὲς",713853,28],["καὶ",707031,7],["τρίτην",712968,36],["ἡμέραν",705984,9],["ἐν",704639,0],["τῷ",709436,53],["ἐξελθεῖν",704909,106],["με",708618,163],["εἰς",704105,0],["ὁδὸν",709458,9],["γέγονε",703104,171],["πάντα",710177,68],["τὰ",709436,41],["παιδάρια",709923,42],["ἡγνισμένα",700172,388],["καὶ",707031,7],["αὐτὴ",702165,107],["ἡ",709436,10],["ὁδὸς",709458,12],["βέβηλος",702613,29],["διότι",703734,7],["ἁγιασθήσεται",700153,134],["σήμερον",711751,28],["διὰ",703417,0],["τὰ",709436,41],["σκεύη",711844,42],["μου",709032,133]],"And David answered the priest, and said to him, Yea, we have been kept from women for three days: when I came forth for the journey all the young men were purified; but this expedition is unclean, wherefore it shall be sanctified this day because of my weapons."],["7",[["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["Αβιμελεχ",700068,4],["ὁ",709436,3],["ἱερεὺς",706614,4],["τοὺς",709436,58],["ἄρτους",701829,57],["τῆς",709436,16],["προθέσεως",710796,17],["ὅτι",709803,7],["οὐκ",709805,28],["ἦν",704093,13],["ἐκεῖ",704181,28],["ἄρτος",701829,4],["ὅτι",709803,7],["ἀλλ᾿",700680,7],["ἢ",705924,7],["ἄρτοι",701829,52],["τοῦ",709436,20],["προσώπου",710986,21],["οἱ",709436,136],["ἀφῃρημένοι",702177,429],["ἐκ",704132,0],["προσώπου",710986,21],["κυρίου",707996,18],["παρατεθῆναι",710111,179],["ἄρτον",701829,6],["θερμὸν",706217,27],["ᾗ",709781,108],["ἡμέρᾳ",705984,1],["ἔλαβεν",708076,2],["αὐτούς",702165,62]],"So Abimelech the priest gave him the shewbread; for there were no loaves there, but only the presence loaves which had been removed from the presence of the Lord, in order that hot bread should be set on, on the day on which he took them."],["8",[["καὶ",707031,7],["ἐκεῖ",704181,28],["ἦν",704093,13],["ἓν",704106,46],["τῶν",709436,43],["παιδαρίων",709923,44],["τοῦ",709436,35],["Σαουλ",711499,18],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["συνεχόμενος",712469,122],["νεεσσαραν",709244,4],["ἐνώπιον",704823,0],["κυρίου",707996,18],["καὶ",707031,7],["ὄνομα",709666,25],["αὐτῷ",702165,50],["Δωηκ",703893,4],["ὁ",709436,3],["Σύρος",712541,4],["νέμων",709253,72],["τὰς",709436,38],["ἡμιόνους",705995,39],["Σαουλ",711499,18]],"And there was there on that day one of Saul's servants detained before the Lord, and his name [was] Doec the Syrian, tending the mules of Saul."],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["πρὸς",710844,0],["Αβιμελεχ",700068,6],["ἰδὲ",709725,176],["εἰ",704071,7],["ἔστιν",704093,91],["ἐνταῦθα",704787,28],["ὑπὸ",713184,0],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133],["δόρυ",703804,15],["ἢ",705924,7],["ῥομφαία",711291,12],["ὅτι",709803,7],["τὴν",709436,8],["ῥομφαίαν",711291,9],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,41],["σκεύη",711844,42],["οὐκ",709805,28],["εἴληφα",708076,89],["ἐν",704639,0],["τῇ",709436,100],["χειρί",713787,1],["μου",709032,133],["ὅτι",709803,7],["ἦν",704093,13],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦ",709436,35],["βασιλέως",702580,18],["κατὰ",707200,0],["σπουδήν",712035,9]],"And David said to Abimelech, See if there is here under thy hand spear or sword, for I have not brought in my hand my sword or my weapons, for the word of the king was urgent."],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["ἱερεύς",706614,4],["ἰδοὺ",706497,88],["ἡ",709436,10],["ῥομφαία",711291,12],["Γολιαθ",703161,18],["τοῦ",709436,35],["ἀλλοφύλου",700706,116],["ὃν",709781,112],["ἐπάταξας",710185,162],["ἐν",704639,0],["τῇ",709436,100],["κοιλάδι",707758,1],["Ηλα",705957,18],["καὶ",707031,7],["αὐτὴ",702165,107],["ἐνειλημένη",704706,203],["ἐν",704639,0],["ἱματίῳ",706742,54],["εἰ",704071,7],["ταύτην",709858,104],["λήμψῃ",708076,123],["σεαυτῷ",711599,50],["λαβέ",708076,176],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἑτέρα",705535,68],["πάρεξ",710136,0],["ταύτης",709858,86],["ἐνταῦθα",704787,28],["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["ἰδοὺ",706497,88],["οὐκ",709805,28],["ἔστιν",704093,91],["ὥσπερ",714163,28],["αὐτή",702165,107],["δός",703654,176],["μοι",708974,159],["αὐτήν",702165,104]],"And the priest said, Behold the sword of Goliath the Philistine, whom thou smotest in the valley of Ela; and it is wrapt in a cloth: if thou wilt take it, take it for thyself, for there is no other except it here. And David said, Behold, there is none like it; give it me."],["11",[["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτὴν",702165,104],["αὐτῷ",702165,50],["καὶ",707031,7],["ἀνέστη",701173,2],["Δαυιδ",703232,4],["καὶ",707031,7],["ἔφυγεν",713433,2],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἐκ",704132,0],["προσώπου",710986,21],["Σαουλ",711499,18],["καὶ",707031,7],["ἦλθεν",705453,2],["Δαυιδ",703232,4],["πρὸς",710844,0],["Αγχους",700206,6],["βασιλέα",702580,6],["Γεθ",703005,9]],"And he gave it him; and David arose, and fled in that day from the presence of Saul: and David came to Anchus king of Geth."],["12",[["καὶ",707031,7],["εἶπαν",705373,150],["οἱ",709436,136],["παῖδες",709932,52],["Αγχους",700206,18],["πρὸς",710844,0],["αὐτόν",702165,85],["οὐχὶ",709862,28],["οὗτος",709858,121],["Δαυιδ",703232,4],["ὁ",709436,3],["βασιλεὺς",702580,4],["τῆς",709436,16],["γῆς",703083,17],["οὐχὶ",709862,28],["τούτῳ",709858,50],["ἐξῆρχον",704883,137],["αἱ",709436,190],["χορεύουσαι",713909,389],["λέγουσαι",708124,306],["ἐπάταξεν",710185,2],["Σαουλ",711499,4],["ἐν",704639,0],["χιλιάσιν",713858,76],["αὐτοῦ",702165,102],["καὶ",707031,7],["Δαυιδ",703232,4],["ἐν",704639,0],["μυριάσιν",709062,76],["αὐτοῦ",702165,102]],"And the servants of Anchus said to him, [Is] not this David the king of the land? Did not the dancing women begin the song to him, saying, Saul has smitten his thousands, and David his ten thousands?"],["13",[["καὶ",707031,7],["ἔθετο",712849,23],["Δαυιδ",703232,4],["τὰ",709436,41],["ῥήματα",711246,42],["ἐν",704639,0],["τῇ",709436,100],["καρδίᾳ",707141,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐφοβήθη",713532,37],["σφόδρα",712586,28],["ἀπὸ",701425,0],["προσώπου",710986,21],["Αγχους",700206,18],["βασιλέως",702580,18],["Γεθ",703005,17]],"And David laid up the words in his heart, and was greatly afraid of Anchus king of Geth."],["14",[["καὶ",707031,7],["ἠλλοίωσεν",700694,2],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["προσεποιήσατο",710953,23],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["καὶ",707031,7],["ἐτυμπάνιζεν",713017,2],["ἐπὶ",705080,0],["ταῖς",709436,75],["θύραις",706337,76],["τῆς",709436,16],["πόλεως",710612,17],["καὶ",707031,7],["παρεφέρετο",710114,19],["ἐν",704639,0],["ταῖς",709436,75],["χερσὶν",713787,76],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔπιπτεν",710481,13],["ἐπὶ",705080,0],["τὰς",709436,38],["θύρας",706337,17],["τῆς",709436,16],["πύλης",711082,17],["καὶ",707031,7],["τὰ",709436,41],["σίελα",711777,42],["αὐτοῦ",702165,102],["κατέρρει",707406,91],["ἐπὶ",705080,0],["τὸν",709436,5],["πώγωνα",711115,6],["αὐτοῦ",702165,102]],"And he changed his appearance before him, and feigned himself a false character in that day; and drummed upon the doors of the city, and used extravagant gestures with his hands, and fell against the doors of the gate, and his spittle ran down upon his beard."],["15",[["καὶ",707031,7],["εἶπεν",705373,2],["Αγχους",700206,4],["πρὸς",710844,0],["τοὺς",709436,58],["παῖδας",709932,57],["αὐτοῦ",702165,102],["ἰδοὺ",706497,88],["ἴδετε",709725,74],["ἄνδρα",701150,6],["ἐπίλημπτον",705191,27],["ἵνα",706747,7],["τί",712867,126],["εἰσηγάγετε",704107,265],["αὐτὸν",702165,85],["πρός",710844,0],["με",708618,163]],"And Anchus said to his servants, Lo! ye see the man [is] mad: why have ye brought him in to me?"],["16",[["ἦ",705924,7],["ἐλαττοῦμαι",704394,254],["ἐπιλήμπτων",705191,169],["ἐγώ",704018,164],["ὅτι",709803,7],["εἰσαγειόχατε",704107,330],["αὐτὸν",702165,85],["ἐπιλημπτεύεσθαι",705190,109],["πρός",710844,0],["με",708618,163],["οὗτος",709858,121],["οὐκ",709805,28],["εἰσελεύσεται",704114,93],["εἰς",704105,0],["οἰκίαν",709505,9]],"[Am] I in want of madmen, that ye have brought him in to me to play the madman? he shall not come into the house."]]