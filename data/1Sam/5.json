31,7],["οἱ",709436,136],["ζῶντες",705851,146],["καὶ",707031,7],["οὐκ",709805,28],["ἀποθανόντες",701461,196],["ἐπλήγησαν",710550,99],["εἰς",704105,0],["τὰς",709436,38],["ἕδρας",704036,39],["καὶ",707031,7],["ἀνέβη",700905,2],["ἡ",709436,10],["κραυγὴ",707886,12],["τῆς",709436,16],["πόλεως",710612,17],["εἰς",704105,0],["τὸν",709436,5],["οὐρανόν",709844,6]],"For there was a very great confusion in all the city, when the ark of the God of Israel entered there; and those who lived and died not were smitten with emerods; and the cry of the city went up to heaven."]]