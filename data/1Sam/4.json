86,17],["καὶ",707031,7],["εἶπον",705373,150],["οἱ",709436,136],["ἀλλόφυλοι",700706,52],["τίς",712867,126],["ἡ",709436,10],["κραυγὴ",707886,12],["ἡ",709436,10],["μεγάλη",708653,29],["αὕτη",709858,107],["ἐν",704639,0],["παρεμβολῇ",710133,1],["τῶν",709436,80],["Εβραίων",703933,81],["καὶ",707031,7],["ἔγνωσαν",703105,150],["ὅτι",709803,7],["κιβωτὸς",707667,12],["κυρίου",707996,18],["ἥκει",705956,91],["εἰς",704105,0],["τὴν",709436,8],["παρεμβολήν",710133,9]],"And the Philistines heard the cry, and the Philistines said, What [is] this great cry in the camp of the Hebrews: and they understood that the ark of the Lord was come into the camp."],["7",[["καὶ",707031,7],["ἐφοβήθησαν",713532,99],["οἱ",709436,136],["ἀλλόφυλοι",700706,52],["καὶ",707031,7],["εἶπον",705373,150],["οὗτοι",709858,201],["οἱ",709436,136],["θεοὶ",706192,52],["ἥκασιν",705956,197],["πρὸς",710844,0],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὴν",709436,8],["παρεμβολήν",710133,9],["οὐαὶ",709807,88],["ἡμῖν",705994,90],["ἐξελοῦ",704838,300],["ἡμᾶς",705981,194],["κύριε",707996,153],["σήμερον",711751,28],["ὅτι",709803,7],["οὐ",709805,28],["γέγονεν",703104,171],["τοιαύτη",712878,29],["ἐχθὲς",713853,28],["καὶ",707031,7],["τρίτην",712968,36]],"And the Philistines feared, and said, These are the Gods that are come to them into the camp."],["8",[["οὐαὶ",709807,88],["ἡμῖν",705994,90],["τίς",712867,158],["ἐξελεῖται",704838,93],["ἡμᾶς",705981,194],["ἐκ",704132,0],["χειρὸς",713787,17],["τῶν",709436,80],["θεῶν",706192,81],["τῶν",709436,80],["στερεῶν",712075,169],["τούτων",709858,40],["οὗτοι",709858,201],["οἱ",709436,136],["θεοὶ",706192,52],["οἱ",709436,136],["πατάξαντες",710185,196],["τὴν",709436,8],["Αἴγυπτον",700401,9],["ἐν",704639,0],["πάσῃ",710177,101],["πληγῇ",710527,1],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1]],"Woe to us, O Lord, deliver us to-day, for such a thing has not happened aforetime: woe to us, who shall deliver us out of the hand of these mighty Gods? these [are] the Gods that smote Egypt with every plague, and in the wilderness."],["9",[["κραταιοῦσθε",707875,73],["καὶ",707031,7],["γίνεσθε",703104,73],["εἰς",704105,0],["ἄνδρας",701150,57],["ἀλλόφυλοι",700706,52],["μήποτε",708882,28],["δουλεύσητε",703814,125],["τοῖς",709436,147],["Εβραίοις",703933,148],["καθὼς",707030,28],["ἐδούλευσαν",703814,150],["ἡμῖν",705994,90],["καὶ",707031,7],["ἔσεσθε",704093,124],["εἰς",704105,0],["ἄνδρας",701150,57],["καὶ",707031,7],["πολεμήσατε",710601,74],["αὐτούς",702165,62]],"Strengthen yourselves and behave yourselves like men, O ye Philistines, that ye may not serve the Hebrews as they have served us, but be ye men and fight with them."],["10",[["καὶ",707031,7],["ἐπολέμησαν",710601,150],["αὐτούς",702165,62],["καὶ",707031,7],["πταίει",711048,91],["ἀνὴρ",701150,4],["Ισραηλ",706839,18],["καὶ",707031,7],["ἔφυγεν",713433,2],["ἕκαστος",704133,14],["εἰς",704105,0],["σκήνωμα",711849,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐγένετο",703104,23],["πληγὴ",710527,12],["μεγάλη",708653,29],["σφόδρα",712586,28],["καὶ",707031,7],["ἔπεσαν",710481,150],["ἐξ",704132,0],["Ισραηλ",706839,18],["τριάκοντα",712934,59],["χιλιάδες",713858,191],["ταγμάτων",712689,44]],"And they fought with them; and the men of Israel fall, and they fled every man to his tent; and there was a very great slaughter; and there fell of Israel thirty thousand fighting men."],["11",[["καὶ",707031,7],["κιβωτὸς",707667,12],["θεοῦ",706192,18],["ἐλήμφθη",708076,37],["καὶ",707031,7],["ἀμφότεροι",700892,138],["υἱοὶ",713075,52],["Ηλι",705965,18],["ἀπέθανον",701461,150],["Οφνι",709878,6],["καὶ",707031,7],["Φινεες",713510,6]],"And the ark of God was taken, and both the sons of Heli, Ophni and Phinees, died."],["12",[["καὶ",707031,7],["ἔδραμεν",712931,2],["ἀνὴρ",701150,4],["Ιεμιναῖος",706585,4],["ἐκ",704132,0],["τῆς",709436,16],["παρατάξεως",710107,17],["καὶ",707031,7],["ἦλθεν",705453,2],["εἰς",704105,0],["Σηλωμ",711739,227],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["καὶ",707031,7],["τὰ