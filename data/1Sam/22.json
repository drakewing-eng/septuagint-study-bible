09436,24],["ὠτίον",714165,25],["μου",709032,133],["ὅτι",709803,7],["ἐπήγειρεν",704993,13],["ὁ",709436,3],["υἱός",713075,4],["μου",709032,133],["τὸν",709436,5],["δοῦλόν",703817,6],["μου",709032,133],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["εἰς",704105,0],["ἐχθρὸν",705779,6],["ὡς",714148,7],["ἡ",709436,10],["ἡμέρα",705984,12],["αὕτη",709858,107]],"that ye are all conspiring against me, and there is no one that informs me, whereas my son has made a covenant with the son of Jessæ, and there is no one of you that is sorry for me, or informs me that my son has stirred up my servant against me for an enemy, as [it is] this day?"],["9",[["καὶ",707031,7],["ἀποκρίνεται",701492,117],["Δωηκ",703893,4],["ὁ",709436,3],["Σύρος",712541,4],["ὁ",709436,3],["καθεστηκὼς",707011,270],["ἐπὶ",705080,0],["τὰς",709436,38],["ἡμιόνους",705995,39],["Σαουλ",711499,18],["καὶ",707031,7],["εἶπεν",705373,2],["ἑόρακα",709725,89],["τὸν",709436,5],["υἱὸν",713075,6],["Ιεσσαι",706668,18],["παραγινόμενον",710006,212],["εἰς",704105,0],["Νομβα",709335,227],["πρὸς",710844,0],["Αβιμελεχ",700068,6],["υἱὸν",713075,6],["Αχιτωβ",702297,18],["τὸν",709436,5],["ἱερέα",706614,6]],"And Doec the Syrian who was over the mules of Saul answered and said, I saw the son of Jessæ as he came to Nomba to Abimelech son of Achitob the priest."],["10",[["καὶ",707031,7],["ἠρώτα",705459,155],["αὐτῷ",702165,50],["διὰ",703417,0],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["ἐπισιτισμὸν",705247,6],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["καὶ",707031,7],["τὴν",709436,8],["ῥομφαίαν",711291,9],["Γολιαδ",703160,18],["τοῦ",709436,35],["ἀλλοφύλου",700706,116],["ἔδωκεν",703654,2],["αὐτῷ",702165,50]],"And [the priest] enquired of God for him, and gave him provisions, and gave him the sword of Goliath the Philistine."],["11",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["καλέσαι",707084,106],["τὸν",709436,5],["Αβιμελεχ",700068,6],["υἱὸν",713075,6],["Αχιτωβ",702297,18],["καὶ",707031,7],["πάντας",710177,60],["τοὺς",709436,58],["υἱοὺς",713075,57],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["τοὺς",709436,58],["ἱερεῖς",706614,57],["τοὺς",709436,58],["ἐν",704639,0],["Νομβα",709335,111],["καὶ",707031,7],["παρεγένοντο",710006,189],["πάντες",710177,138],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6]],"And the king sent to call Abimelech son of Achitob and all his father's sons, the priests that were in Nomba; and they all came to the king."],["12",[["καὶ",707031,7],["εἶπεν",705373,2],["Σαουλ",711499,4],["ἄκουε",700587,240],["δή",703395,11],["υἱὲ",713075,153],["Αχιτωβ",702297,18],["καὶ",707031,7],["εἶπεν",705373,2],["ἰδοὺ",706497,88],["ἐγώ",704018,164],["λάλει",708071,240],["κύριε",707996,153]],"And Saul said, Hear now, thou son of Achitob. And he said, Lo! I [am here], speak, [my] lord."],["13",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["Σαουλ",711499,4],["ἵνα",706747,7],["τί",712867,126],["συνέθου",712513,174],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["σὺ",712181,164],["καὶ",707031,7],["ὁ",709436,3],["υἱὸς",713075,4],["Ιεσσαι",706668,18],["δοῦναί",703654,106],["σε",711598,163],["αὐτῷ",702165,50],["ἄρτον",701829,6],["καὶ",707031,7],["ῥομφαίαν",711291,9],["καὶ",707031,7],["ἐρωτᾶν",705459,55],["αὐτῷ",702165,50],["διὰ",703417,0],["τοῦ",709436,35],["θεοῦ",706192,18],["θέσθαι",712849,109],["αὐτὸν",702165,85],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["εἰς",704105,0],["ἐχθρὸν",705779,6],["ὡς",714148,7],["ἡ",709436,10],["ἡμέρα",705984,12],["αὕτη",709858,107]],"And Saul said to him, Why have thou and the son of Jessæ conspired against me, that thou shouldest give him bread and a sword, and shouldest enquire of God for him, to raise him up against me as an enemy, as [he is] this day?"],["14",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["τῷ",709436,113],["βασιλεῖ",702580,114],["καὶ",707031,7],["εἶπεν",705373,2],["καὶ",707031,28],["τίς",712867,158],["ἐν",704639,0],["πᾶσιν",710177,230],["τοῖς",709436,147],["δούλοις",703817,148],["σου",711945,133],["ὡς",714