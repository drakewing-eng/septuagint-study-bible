[["1",[["καὶ",707031,7],["οἱ",709436,136],["ἀλλόφυλοι",700706,138],["ἐπολέμουν",710601,137],["ἐπὶ",705080,0],["Ισραηλ",706839,6],["καὶ",707031,7],["ἔφυγον",713433,150],["οἱ",709436,136],["ἄνδρες",701150,52],["Ισραηλ",706839,18],["ἐκ",704132,0],["προσώπου",710986,21],["τῶν",709436,80],["ἀλλοφύλων",700706,169],["καὶ",707031,7],["πίπτουσιν",710481,197],["τραυματίαι",712921,52],["ἐν",704639,0],["τῷ",709436,53],["ὄρει",709768,54],["τῷ",709436,523],["Γελβουε",703020,111]],"And the Philistines fought with Israel: and the men of Israel fled from before the Philistines, and they fall down wounded in the mountain of Gelbue."],["2",[["καὶ",707031,7],["συνάπτουσιν",712404,197],["ἀλλόφυλοι",700706,138],["τῷ",709436,113],["Σαουλ",711499,114],["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτοῦ",702165,102],["καὶ",707031,7],["τύπτουσιν",713022,197],["ἀλλόφυλοι",700706,138],["τὸν",709436,5],["Ιωναθαν",706927,6],["καὶ",707031,7],["τὸν",709436,5],["Αμιναδαβ",700824,6],["καὶ",707031,7],["τὸν",709436,5],["Μελχισα",708716,6],["υἱοὺς",713075,57],["Σαουλ",711499,18]],"And the Philistines press closely on Saul and his sons, and the Philistines smite Jonathan, and Aminadab, and Melchisa son of Saul."],["3",[["καὶ",707031,7],["βαρύνεται",702553,117],["ὁ",709436,3],["πόλεμος",710605,4],["ἐπὶ",705080,0],["Σαουλ",711499,6],["καὶ",707031,7],["εὑρίσκουσιν",705676,197],["αὐτὸν",702165,85],["οἱ",709436,136],["ἀκοντισταί",700572,52],["ἄνδρες",701150,52],["τοξόται",712899,52],["καὶ",707031,7],["ἐτραυματίσθη",712922,37],["εἰς",704105,0],["τὰ",709436,41],["ὑποχόνδρια",713259,42]],"And the battle prevails against Saul, and the shooters with arrows, even the archers find him, and he was wounded under the ribs."],["4",[["καὶ",707031,7],["εἶπεν",705373,2],["Σαουλ",711499,4],["πρὸς",710844,0],["τὸν",709436,5],["αἴροντα",700473,183],["τὰ",709436,41],["σκεύη",711844,42],["αὐτοῦ",702165,102],["σπάσαι",712003,300],["τὴν",709436,8],["ῥομφαίαν",711291,9],["σου",711945,133],["καὶ",707031,7],["ἀποκέντη