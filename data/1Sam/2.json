[["1",[["καὶ",707031,7],["εἶπεν",705373,2],["ἐστερεώθη",712076,37],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["ἐν",704639,0],["κυρίῳ",707996,114],["ὑψώθη",713289,37],["κέρας",707625,15],["μου",709032,133],["ἐν",704639,0],["θεῷ",706192,114],["μου",709032,133],["ἐπλατύνθη",710508,37],["ἐπὶ",705080,0],["ἐχθροὺς",705779,57],["τὸ",709436,34],["στόμα",712125,15],["μου",709032,133],["εὐφράνθην",705715,156],["ἐν",704639,0],["σωτηρίᾳ",712658,1],["σου",711945,133]],"My heart is established in the Lord, my horn is exalted in my God; my mouth is enlarged over my enemies, I have rejoiced in thy salvation."],["2",[["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἅγιος",700159,14],["ὡς",714148,7],["κύριος",707996,4],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["δίκαιος",703694,14],["ὡς",714148,7],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["οὐκ",709805,28],["ἔστιν",704093,91],["ἅγιος",700159,14],["πλὴν",710540,28],["σοῦ",711945,133]],"For there is none holy as the Lord, and there is none righteous as our God: there is none holy beside thee."],["3",[["μὴ",708851,28],["καυχᾶσθε",707569,73],["καὶ",707031,7],["μὴ",708851,28],["λαλεῖτε",708071,87],["ὑψηλά",713285,68],["μὴ",708851,28],["ἐξελθάτω",704909,22],["μεγαλορρημοσύνη",708638,12],["ἐκ",704132,0],["τοῦ",709436,20],["στόματος",712125,21],["ὑμῶν",713091,145],["ὅτι",709803,7],["θεὸς",706192,4],["γνώσεων",703138,65],["κύριος",707996,4],["καὶ",707031,7],["θεὸς",706192,4],["ἑτοιμάζων",705539,72],["ἐπιτηδεύματα",705301,42],["αὐτοῦ",702165,102]],"Boast not, and utter not high things; let not high-sounding words come out of your mouth, for the Lord [is] a God of knowledge, and God prepares his own designs."],["4",[["τόξον",712898,25],["δυνατῶν",703845,169],["ἠσθένησεν",701938,2],["καὶ",707031,7],["ἀσθενοῦντες",701938,146],["περιεζώσαντο",710317,189],["δύναμιν",703839,9]],"The bow of the mighty has waxed feeble, and the weak have girded themselves with strength."],["5",[["πλήρεις",710541,138],["ἄρτων",701829,81],["ἠλαττώθησαν",700635,99],["καὶ",707031,7],["οἱ",709436,136],["πεινῶντες",710222,146],["παρῆκαν",710149,150],["γῆν",703083,9],["ὅτι",709803,7],["στεῖρα",712060,12],["ἔτεκεν",712853,2],["ἑπτά",705357,59],["καὶ",707031,7],["ἡ",709436,10],["πολλὴ",710646,29],["ἐν",704639,0],["τέκνοις",712761,96],["ἠσθένησεν",701938,2]],"They that were full of bread are brought low; and the hungry have forsaken the land; for the barren has born seven, and she that abounded in children has waxed feeble."],["6",[["κύριος",707996,4],["θανατοῖ",706097,91],["καὶ",707031,7],["ζωογονεῖ",705915,91],["κατάγει",707232,91],["εἰς",704105,0],["ᾅδου",700255,18],["καὶ",707031,7],["ἀνάγει",700933,91]],"The Lord kills and makes alive; he brings down to the grave, and brings up."],["7",[["κύριος",707996,4],["πτωχίζει",711075,569],["καὶ",707031,7],["πλουτίζει",710562,91],["ταπεινοῖ",712717,91],["καὶ",707031,7],["ἀνυψοῖ",701293,91]],"The Lord makes poor, and makes rich; he brings low, and lifts up."],["8",[["ἀνιστᾷ",701173,91],["ἀπὸ",701425,0],["γῆς",703083,17],["πένητα",710248,6],["καὶ",707031,7],["ἀπὸ",701425,0],["κοπρίας",707827,17],["ἐγείρει",703949,91],["πτωχὸν",711076,6],["καθίσαι",707006,106],["μετὰ",708780,0],["δυναστῶν",703844,81],["λαῶν",708094,81],["καὶ",707031,7],["θρόνον",706315,6],["δόξης",703791,17],["κατακληρονομῶν",707274,72],["αὐτοῖς",702165,151]],"He lifts up the poor from the earth, and raises the needy from the dunghill; to seat him with the princes of the people, and causing them to inherit the throne of glory:"],["9",[["διδοὺς",703654,72],["εὐχὴν",705726,9],["τῷ",709436,113],["εὐχομένῳ",705727,241],["καὶ",707031,7],["εὐλόγησεν",705631,2],["ἔτη",705543,42],["δικαίου",703694,116],["ὅτι",709803,7],["οὐκ",709805,28],["ἐν",704639,0],["ἰσχύι",706858,1],["δυνατὸς",703845,14],["ἀνήρ",701150,4]],"granting his petition to him that prays; and he blesses the years of the righteous, for by strength cannot man prevail."],["10",[["κύριος",707996,4],["ἀσθενῆ",701939,68],["ποιήσει",710582,127],["ἀντίδικον",701233,6],["αὐτοῦ",702165,102],["κύριος",707996,4],["ἅγιος",700159,14],["μὴ",708851,28],["καυχάσθω",707569,407],["ὁ",709436,3],["φρόνιμος",713589,14],["ἐν",704639,0],["τῇ",709436,100],["φρονήσει",713588,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["μὴ",708851,28],["καυχάσθω",707569,407],["ὁ",709436,3],["δυνατὸς",703845,14],["ἐν",704639,0],["τῇ",709436,100],["δυνάμει",703839,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["μὴ",708851,28],["καυχάσθω",707569,407],["ὁ",709436,3],["πλούσιος",710560,14],["ἐν",704639,0],["τῷ",709436,113],["πλούτῳ",710563,114],["αὐτοῦ",702165,102],["ἀλλ᾿",700680,7],["ἢ",705924,7],["ἐν",704639,0],["τούτῳ",709858,50],["καυχάσθω",707569,407],["ὁ",709436,3],["καυχώμενος",707569,122],["συνίειν",712481,55],["καὶ",707031,7],["γινώσκειν",703105,55],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["ποιεῖν",710582,55],["κρίμα",707903,25],["καὶ",707031,7],["δικαιοσύνην",703695,9],["ἐν",704639,0],["μέσῳ",708768,97],["τῆς",709436,16],["γῆς",703083,17],["κύριος",707996,4],["ἀνέβη",700905,2],["εἰς",704105,0],["οὐρανοὺς",709844,57],["καὶ",707031,7],["ἐβρόντησεν",702815,2],["αὐτὸς",702165,121],["κρινεῖ",707905,127],["ἄκρα",700608,68],["γῆς",703083,17],["καὶ",707031,7],["δίδωσιν",703654,91],["ἰσχὺν",706858,9],["τοῖς",709436,147],["βασιλεῦσιν",702580,148],["ἡμῶν",705999,145],["καὶ",707031,7],["ὑψώσει",713289,127],["κέρας",707625,25],["χριστοῦ",713964,116],["αὐτοῦ",702165,102]],"The Lord will weaken his adversary; the Lord [is] holy. Let not the wise man boast in his wisdom, nor let the mighty man boast in his strength, and let not the rich man boast in his wealth; but let him that boasts boast in this, to understand and know the Lord, and to execute judgment and justice in the midst of the earth. The Lord has gone up to the heavens, and has thundered: he will judge the extremities of the earth, and he gives strength to our kings, and will exalt the horn of his Christ. And she left him there before the Lord,"],["11",[["καὶ",707031,7],["κατέλιπον",707305,150],["αὐτὸν",702165,85],["ἐκεῖ",704181,28],["ἐνώπιον",704823,0],["κυρίου",707996,18],["καὶ",707031,7],["ἀπῆλθον",701398,150],["εἰς",704105,0],["Αρμαθαιμ",701769,227],["καὶ",707031,7],["τὸ",709436,34],["παιδάριον",709923,15],["ἦν",704093,13],["λειτουργῶν",708132,72],["τῷ",709436,53],["προσώπῳ",710986,54],["κυρίου",707996,18],["ἐνώπιον",704823,0],["Ηλι",705965,18],["τοῦ",709436,35],["ἱερέως",706614,18]],"and departed to Armathaim: and the child ministered in the presence of the Lord before Heli the priest."],["12",[["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["Ηλι",705965,18],["τοῦ",709436,35],["ἱερέως",706614,18],["υἱοὶ",713075,52],["λοιμοὶ",708245,138],["οὐκ",709805,28],["εἰδότες",704075,196],["τὸν",709436,5],["κύριον",707996,6]],"And the sons of Heli the priest [were] evil sons, not knowing the Lord."],["13",[["καὶ",707031,7],["τὸ",709436,24],["δικαίωμα",703697,25],["τοῦ",709436,35],["ἱερέως",706614,18],["παρὰ",709995,0],["τοῦ",709436,35],["λαοῦ",708094,18],["παντὸς",710177,116],["τοῦ",709436,35],["θύοντος",706349,152],["καὶ",707031,7],["ἤρχετο",705453,19],["τὸ",709436,24],["παιδάριον",709923,25],["τοῦ",709436,35],["ἱερέως",706614,18],["ὡς",714148,7],["ἂν",700900,11],["ἡψήθη",706048,37],["τὸ",709436,24],["κρέας",707889,25],["καὶ",707031,7],["κρεάγρα",707887,12],["τριόδους",712949,27],["ἐν",704639,0],["τῇ",709436,100],["χειρὶ",713787,1],["αὐτοῦ",702165,102]],"And the priest's claim from every one of the people that sacrificed [was this]: the servant of the priest came when the flesh was in seething, and a flesh-hook of three teeth [was] in his hand."],["14",[["καὶ",707031,7],["ἐπάταξεν",710185,2],["αὐτὴν",702165,104],["εἰς",704105,0],["τὸν",709436,5],["λέβητα",708121,6],["τὸν",709436,5],["μέγαν",708653,27],["ἢ",705924,7],["εἰς",704105,0],["τὸ",709436,24],["χαλκίον",713693,25],["ἢ",705924,7],["εἰς",704105,0],["τὴν",709436,8],["κύθραν",707954,9],["πᾶν",710177,46],["ὃ",709781,128],["ἐὰν",703912,7],["ἀνέβη",700905,2],["ἐν",704639,0],["τῇ",709436,100],["κρεάγρᾳ",707887,1],["ἐλάμβανεν",708076,13],["ἑαυτῷ",703917,50],["ὁ",709436,3],["ἱερεύς",706614,4],["κατὰ",707200,0],["τάδε",709446,290],["ἐποίουν",710582,137],["παντὶ",710177,30],["Ισραηλ",706839,114],["τοῖς",709436,147],["ἐρχομένοις",705453,341],["θῦσαι",706349,106],["κυρίῳ",707996,114],["ἐν",704639,0],["Σηλωμ",711739,111]],"And he struck it into the great caldron, or into the brazen vessel, or into the pot, and whatever came up with the flesh-hook, the priest took for himself: so they did to all Israel that came to sacrifice to the Lord in Selom."],["15",[["καὶ",707031,7],["πρὶν",710742,28],["θυμιαθῆναι",706332,179],["τὸ",709436,24],["στέαρ",712054,25],["ἤρχετο",705453,19],["τὸ",709436,34],["παιδάριον",709923,15],["τοῦ",709436,35],["ἱερέως",706614,18],["καὶ",707031,7],["ἔλεγεν",708124,13],["τῷ",709436,113],["ἀνδρὶ",701150,114],["τῷ",709436,113],["θύοντι",706349,379],["δὸς",703654,176],["κρέας",707889,25],["ὀπτῆσαι",709715,106],["τῷ",709436,113],["ἱερεῖ",706614,114],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["λάβω",708076,207],["παρὰ",709995,0],["σοῦ",711945,133],["ἑφθὸν",705753,27],["ἐκ",704132,0],["τοῦ",709436,35],["λέβητος",708121,18]],"And before the fat was burnt for a sweet savour, the servant of the priest would come, and say to the man that sacrificed, Give flesh to roast for the priest, and I will by no means take of thee sodden flesh out of the caldron."],["16",[["καὶ",707031,7],["ἔλεγεν",708124,13],["ὁ",709436,3],["ἀνὴρ",701150,4],["ὁ",709436,3],["θύων",706349,72],["θυμιαθήτω",706332,22],["πρῶτον",711041,534],["ὡς",714148,7],["καθήκει",706998,91],["τὸ",709436,24],["στέαρ",712054,25],["καὶ",707031,7],["λαβὲ",708076,176],["σεαυτῷ",711599,50],["ἐκ",704132,0],["πάντων",710177,169],["ὧν",709781,252],["ἐπιθυμεῖ",705141,91],["ἡ",709436,10],["ψυχή",714070,12],["σου",711945,133],["καὶ",707031,7],["εἶπεν",705373,2],["οὐχί",709862,28],["ὅτι",709803,7],["νῦν",709384,28],["δώσεις",703654,166],["καὶ",707031,7],["ἐὰν",703912,7],["μή",708851,28],["λήμψομαι",708076,181],["κραταιῶς",707877,28]],"And [if] the man that sacrificed said, First let the fat be burned, as it is fit, and take for thyself of all things which thy soul desires: then he would say, Nay, for thou shalt give it me now; and if not, I will take it by force."],["17",[["καὶ",707031,7],["ἦν",704093,13],["ἡ",709436,10],["ἁμαρτία",700775,12],["τῶν",709436,43],["παιδαρίων",709923,44],["ἐνώπιον",704823,0],["κυρίου",707996,18],["μεγάλη",708653,29],["σφόδρα",712586,28],["ὅτι",709803,7],["ἠθέτουν",700369,137],["τὴν",709436,8],["θυσίαν",706345,9],["κυρίου",707996,18]],"So the sin of the young men was very great before the Lord, for they set at nought the offering of the Lord."],["18",[["καὶ",707031,7],["Σαμουηλ",711473,4],["ἦν",704093,13],["λειτουργῶν",708132,72],["ἐνώπιον",704823,0],["κυρίου",707996,18],["παιδάριον",709923,15],["περιεζωσμένον",710317,426],["εφουδ",705761,25],["βαρ",702518,46]],"And Samuel ministered before the Lord, a child girt with a linen ephod."],["19",[["καὶ",707031,7],["διπλοΐδα",703739,9],["μικρὰν",708915,36],["ἐποίησεν",710582,2],["αὐτῷ",702165,50],["ἡ",709436,10],["μήτηρ",708892,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀνέφερεν",701083,13],["αὐτῷ",702165,50],["ἐξ",704132,0],["ἡμερῶν",705984,65],["εἰς",704105,0],["ἡμέρας",705984,39],["ἐν",704639,0],["τῷ",709436,53],["ἀναβαίνειν",700905,55],["αὐτὴν",702165,104],["μετὰ",708780,0],["τοῦ",709436,35],["ἀνδρὸς",701150,18],["αὐτῆς",702165,86],["θῦσαι",706349,106],["τὴν",709436,8],["θυσίαν",706345,9],["τῶν",709436,130],["ἡμερῶν",705984,65]],"And his mother made him a little doublet, and brought it to him from year to year, in her going up in company with her husband to offer the yearly sacrifice."],["20",[["καὶ",707031,7],["εὐλόγησεν",705631,2],["Ηλι",705965,4],["τὸν",709436,5],["Ελκανα",704504,6],["καὶ",707031,7],["τὴν",709436,8],["γυναῖκα",703209,9],["αὐτοῦ",702165,102],["λέγων",708124,72],["ἀποτείσαι",701609,106],["σοι",711925,159],["κύριος",707996,4],["σπέρμα",712008,25],["ἐκ",704132,0],["τῆς",709436,16],["γυναικὸς",703209,17],["ταύτης",709858,86],["ἀντὶ",701227,0],["τοῦ",709436,20],["χρέους",713943,21],["οὗ",709781,160],["ἔχρησας",713936,162],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["ἀπῆλθεν",701398,2],["ὁ",709436,3],["ἄνθρωπος",701163,4],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["αὐτοῦ",702165,102]],"And Heli blessed Helcana and his wife, saying, The Lord recompense to thee seed of this woman, in return for the loan which thou hast lent to the Lord: and the man returned to his place."],["21",[["καὶ",707031,7],["ἐπεσκέψατο",705250,23],["κύριος",707996,4],["τὴν",709436,8],["Ανναν",701177,9],["καὶ",707031,7],["ἔτεκεν",712853,2],["ἔτι",705538,28],["τρεῖς",712927,138],["υἱοὺς",713075,57],["καὶ",707031,7],["δύο",703849,59],["θυγατέρας",706320,39],["καὶ",707031,7],["ἐμεγαλύνθη",708647,37],["τὸ",709436,34],["παιδάριον",709923,15],["Σαμουηλ",711473,4],["ἐνώπιον",704823,0],["κυρίου",707996,18]],"And the Lord visited Anna, and she bore yet three sons, and two daughters. And the child Samuel grew before the Lord."],["22",[["καὶ",707031,7],["Ηλι",705965,4],["πρεσβύτης",710736,4],["σφόδρα",712586,28],["καὶ",707031,7],["ἤκουσεν",700587,2],["ἃ",709781,69],["ἐποίουν",710582,137],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτοῦ",702165,102],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18]],"And Heli [was] very old, and he heard what his sons did to the children of Israel."],["23",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["ἵνα",706747,7],["τί",712867,126],["ποιεῖτε",710582,87],["κατὰ",707200,0],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["ὃ",709781,128],["ἐγὼ",704018,164],["ἀκούω",700587,157],["ἐκ",704132,0],["στόματος",712125,21],["παντὸς",710177,116],["τοῦ",709436,35],["λαοῦ",708094,18],["κυρίου",707996,18]],"And he said to them, Why do ye according to this thing, which I hear from the mouth of all the people of the Lord?"],["24",[["μή",708851,28],["τέκνα",712761,42],["ὅτι",709803,7],["οὐκ",709805,28],["ἀγαθὴ",700106,29],["ἡ",709436,10],["ἀκοή",700561,12],["ἣν",709781,131],["ἐγὼ",704018,164],["ἀκούω",700587,157],["μὴ",708851,28],["ποιεῖτε",710582,87],["οὕτως",709859,28],["ὅτι",709803,7],["οὐκ",709805,28],["ἀγαθαὶ",700106,192],["αἱ",709436,190],["ἀκοαί",700561,191],["ἃς",709781,193],["ἐγὼ",704018,164],["ἀκούω",700587,157],["τοῦ",709436,20],["μὴ",708851,28],["δουλεύειν",703814,55],["λαὸν",708094,6],["θεῷ",706192,114]],"Nay [my] sons, for the report which I hear [is] not good; do not so, for the reports which I hear [are] not good, so that the people do not serve God."],["25",[["ἐὰν",703912,7],["ἁμαρτάνων",700773,72],["ἁμάρτῃ",700773,172],["ἀνὴρ",701150,4],["εἰς",704105,0],["ἄνδρα",701150,6],["καὶ",707031,7],["προσεύξονται",710893,135],["ὑπὲρ",713111,0],["αὐτοῦ",702165,102],["πρὸς",710844,0],["κύριον",707996,6],["καὶ",707031,7],["ἐὰν",703912,7],["τῷ",709436,113],["κυρίῳ",707996,114],["ἁμάρτῃ",700773,172],["τίς",712867,126],["προσεύξεται",710893,93],["ὑπὲρ",713111,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ἤκουον",700587,137],["τῆς",709436,16],["φωνῆς",713640,17],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτῶν",702165,40],["ὅτι",709803,7],["βουλόμενος",702795,122],["ἐβούλετο",702795,19],["κύριος",707996,4],["διαφθεῖραι",703624,106],["αὐτούς",702165,62]],"If a man should at all sin against another, then shall they pray for him to the Lord; but if a man sin against the Lord, who shall intreat for him? But they hearkened not to the voice of their father, because the Lord would by all means destroy them."],["26",[["καὶ",707031,7],["τὸ",709436,34],["παιδάριον",709923,15],["Σαμουηλ",711473,4],["ἐπορεύετο",710667,19],["καὶ",707031,7],["ἐμεγαλύνετο",708647,19],["καὶ",707031,7],["ἀγαθὸν",700106,27],["καὶ",707031,7],["μετὰ",708780,0],["κυρίου",707996,18],["καὶ",707031,7],["μετὰ",708780,0],["ἀνθρώπων",701163,81]],"And the child Samuel advanced, and was in favour with God and with men."],["27",[["καὶ",707031,7],["ἦλθεν",705453,2],["ἄνθρωπος",701163,4],["θεοῦ",706192,18],["πρὸς",710844,0],["Ηλι",705965,6],["καὶ",707031,7],["εἶπεν",705373,2],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἀποκαλυφθεὶς",701474,217],["ἀπεκαλύφθην",701474,161],["πρὸς",710844,0],["οἶκον",709516,6],["πατρός",710189,18],["σου",711945,133],["ὄντων",704093,170],["αὐτῶν",702165,40],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτῳ",700401,1],["δούλων",703817,81],["τῷ",709436,113],["οἴκῳ",709516,114],["Φαραω",713360,18]],"And a man of God came to Heli, and said, Thus says the Lord, I plainly revealed myself to the house of thy father, when they were servants in Egypt to the house of Pharao."],["28",[["καὶ",707031,7],["ἐξελεξάμην",704236,161],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["ἐκ",704132,0],["πάντων",710177,83],["τῶν",709436,43],["σκήπτρων",711851,44],["Ισραηλ",706839,18],["ἐμοὶ",704577,159],["ἱερατεύειν",706607,55],["καὶ",707031,7],["ἀναβαίνειν",700905,55],["ἐπὶ",705080,0],["θυσιαστήριόν",706348,25],["μου",709032,133],["καὶ",707031,7],["θυμιᾶν",706329,55],["θυμίαμα",706330,25],["καὶ",707031,7],["αἴρειν",700473,55],["εφουδ",705761,25],["καὶ",707031,7],["ἔδωκα",703654,155],["τῷ",709436,113],["οἴκῳ",709516,114],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["τὰ",709436,41],["πάντα",710177,68],["τοῦ",709436,20],["πυρὸς",711088,21],["υἱῶν",713075,81],["Ισραηλ",706839,18],["εἰς",704105,0],["βρῶσιν",702825,9]],"And I chose the house of thy father out of all the tribes of Israel to minister to me in the priest's office, to go up to my altar, and to burn incense, and to wear an ephod. And I gave to the house of thy father all the offerings by fire of the children of Israel for food."],["29",[["καὶ",707031,7],["ἵνα",706747,7],["τί",712867,126],["ἐπέβλεψας",705088,162],["ἐπὶ",705080,0],["τὸ",709436,24],["θυμίαμά",706330,25],["μου",709032,133],["καὶ",707031,7],["εἰς",704105,0],["τὴν",709436,8],["θυσίαν",706345,9],["μου",709032,133],["ἀναιδεῖ",700959,30],["ὀφθαλμῷ",709870,114],["καὶ",707031,7],["ἐδόξασας",703792,162],["τοὺς",709436,58],["υἱούς",713075,57],["σου",711945,133],["ὑπὲρ",713111,0],["ἐμὲ",704555,163],["ἐνευλογεῖσθαι",704720,110],["ἀπαρχῆς",701359,17],["πάσης",710177,82],["θυσίας",706345,17],["Ισραηλ",706839,18],["ἔμπροσθέν",704618,0],["μου",709032,133]],"And wherefore hast thou looked upon my incense-offering and my meat-offering with a shameless eye, and hast honoured thy sons above me, so that they should bless themselves with the first-fruits of every sacrifice of Israel before me?"],["30",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["εἶπεν",705373,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["εἶπα",705373,155],["ὁ",709436,3],["οἶκός",709516,4],["σου",711945,133],["καὶ",707031,7],["ὁ",709436,3],["οἶκος",709516,4],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["διελεύσεται",703673,93],["ἐνώπιόν",704823,0],["μου",709032,133],["ἕως",705792,0],["αἰῶνος",700504,18],["καὶ",707031,7],["νῦν",709384,28],["φησιν",713437,91],["κύριος",707996,4],["μηδαμῶς",708854,28],["ἐμοί",704577,159],["ὅτι",709803,7],["ἀλλ᾿",700680,7],["ἢ",705924,7],["τοὺς",709436,58],["δοξάζοντάς",703792,235],["με",708618,163],["δοξάσω",703792,165],["καὶ",707031,7],["ὁ",709436,3],["ἐξουθενῶν",704969,72],["με",708618,163],["ἀτιμωθήσεται",702096,134]],"Therefore thus says the Lord God of Israel, I said, Thy house and the house of thy father shall pass before me for ever: but now the Lord says, That be far from me; for I will only honour them that honour me, and he that sets me at nought shall be despised."],["31",[["ἰδοὺ",706497,88],["ἡμέραι",705984,191],["ἔρχονται",705453,269],["καὶ",707031,7],["ἐξολεθρεύσω",704956,207],["τὸ",709436,24],["σπέρμα",712008,25],["σου",711945,133],["καὶ",707031,7],["τὸ",709436,24],["σπέρμα",712008,25],["οἴκου",709516,18],["πατρός",710189,18],["σου",711945,133]],"Behold, the days come when I will destroy thy seed and the seed of thy father's house."],["32",[["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["σου",711945,133],["πρεσβύτης",710736,4],["ἐν",704639,0],["οἴκῳ",709516,114],["μου",709032,133],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39]],"And thou shalt not have an old man in my house for ever."],["33",[["καὶ",707031,7],["ἄνδρα",701150,6],["οὐκ",709805,28],["ἐξολεθρεύσω",704956,207],["σοι",711925,159],["ἀπὸ",701425,0],["τοῦ",709436,20],["θυσιαστηρίου",706348,21],["μου",709032,133],["ἐκλιπεῖν",704237,106],["τοὺς",709436,58],["ὀφθαλμοὺς",709870,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["καταρρεῖν",707406,55],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["πᾶς",710177,14],["περισσεύων",710386,72],["οἴκου",709516,18],["σου",711945,133],["πεσοῦνται",710481,135],["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["ἀνδρῶν",701150,81]],"And [if] I do not destroy a man of thine from my altar, [it shall be] that his eyes may fail and his soul may perish; and every one that remains in thy house shall fall by the sword of men."],["34",[["καὶ",707031,7],["τοῦτό",709858,132],["σοι",711925,159],["τὸ",709436,34],["σημεῖον",711748,15],["ὃ",709781,128],["ἥξει",705956,127],["ἐπὶ",705080,0],["τοὺς",709436,58],["δύο",703849,59],["υἱούς",713075,57],["σου",711945,133],["τούτους",709858,62],["Οφνι",709878,6],["καὶ",707031,7],["Φινεες",713510,6],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["μιᾷ",704106,101],["ἀποθανοῦνται",701461,135],["ἀμφότεροι",700892,138]],"And this which shall come upon thy two sons Ophni and Phinees shall be a sign to thee; in one day they shall both die."],["35",[["καὶ",707031,7],["ἀναστήσω",701173,207],["ἐμαυτῷ",704545,50],["ἱερέα",706614,6],["πιστόν",710486,27],["ὃς",709781,213],["πάντα",710177,68],["τὰ",709436,41],["ἐν",704639,0],["τῇ",709436,100],["καρδίᾳ",707141,1],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,41],["ἐν",704639,0],["τῇ",709436,100],["ψυχῇ",714070,1],["μου",709032,133],["ποιήσει",710582,127],["καὶ",707031,7],["οἰκοδομήσω",709509,165],["αὐτῷ",702165,50],["οἶκον",709516,6],["πιστόν",710486,27],["καὶ",707031,7],["διελεύσεται",703673,93],["ἐνώπιον",704823,0],["χριστοῦ",713964,116],["μου",709032,133],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39]],"And I will raise up to myself a faithful priest, who shall do all that is in my heart and in my soul; and I will build him a sure house, and he shall walk before my Christ for ever."],["36",[["καὶ",707031,7],["ἔσται",704093,93],["ὁ",709436,3],["περισσεύων",710386,72],["ἐν",704639,0],["οἴκῳ",709516,114],["σου",711945,133],["ἥξει",705956,127],["προσκυνεῖν",710925,55],["αὐτῷ",702165,50],["ὀβολοῦ",709441,18],["ἀργυρίου",701707,21],["λέγων",708124,72],["παράρριψόν",710099,176],["με",708618,163],["ἐπὶ",705080,0],["μίαν",704106,36],["τῶν",709436,80],["ἱερατειῶν",706606,65],["σου",711945,133],["φαγεῖν",713296,106],["ἄρτον",701829,6]],"And it shall come to pass that he that survives in thy house, shall come to do obeisance before him for a little piece of silver, saying, Put me into one of thy priests' offices to eat bread."]]