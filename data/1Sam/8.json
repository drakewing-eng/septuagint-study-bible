[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὡς",714148,7],["ἐγήρασεν",703090,2],["Σαμουηλ",711473,4],["καὶ",707031,7],["κατέστησεν",707011,2],["τοὺς",709436,58],["υἱοὺς",713075,57],["αὐτοῦ",702165,102],["δικαστὰς",703701,57],["τῷ",709436,113],["Ισραηλ",706839,114]],"And it came to pass when Samuel was old, that he made his sons judges over Israel."],["2",[["καὶ",707031,7],["ταῦτα",709858,71],["τὰ",709436,41],["ὀνόματα",709666,42],["τῶν",709436,80],["υἱῶν",713075,81],["αὐτοῦ",702165,102],["πρωτότοκος",711046,14],["Ιωηλ",706916,4],["καὶ",707031,7],["ὄνομα",709666,15],["τοῦ",709436,35],["δευτέρου",703389,116],["Αβια",700054,4],["δικασταὶ",703701,52],["ἐν",704639,0],["Βηρσαβεε",702702,111]],"And these [are] the names of his sons; Joel the first-born, and the name of the second Abia, judges in Bersabee."],["3",[["καὶ",707031,7],["οὐκ",709805,28],["ἐπορεύθησαν",710667,99],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτοῦ",702165,102],["ἐν",704639,0],["ὁδῷ",709458,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐξέκλιναν",704220,150],["ὀπίσω",709697,0],["τῆς",709436,16],["συντελείας",712509,17],["καὶ",707031,7],["ἐλάμβανον",708076,137],["δῶρα",703907,42],["καὶ",707031,7],["ἐξέκλινον",704220,137],["δικαιώματα",703697,42]],"And his sons did not walk in his way; and they turned aside after gain, and took gifts, and perverted judgments."],["4",[["καὶ",707031,7],["συναθροίζονται",712378,269],["ἄνδρες",701150,52],["Ισραηλ",706839,18],["καὶ",707031,7],["παραγίνονται",710006,269],["εἰς",704105,0],["Αρμαθαιμ",701769,227],["πρὸς",710844,0],["Σαμουηλ",711473,6]],"And the men of Israel gather themselves together, and come to Armathaim to Samuel,"],["5",[["καὶ",707031,7],["εἶπαν",705373,150],["αὐτῷ",702165,50],["ἰδοὺ",706497,88],["σὺ",712181,164],["γεγήρακας",703090,266],["καὶ",707031,7],["οἱ",709436,136],["υἱοί",713075,52],["σου",711945,133],["οὐ",709805,28],["πορεύονται",710667,269],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["σου",711945,133],["καὶ",707031,7],["νῦν",709384,28],["κατάστησον",707011,176],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["βασιλέα",702580,6],["δικάζειν",703691,55],["ἡμᾶς",705981,194],["καθὰ",706979,28],["καὶ",707031,7],["τὰ",709436,41],["λοιπὰ",708248,68],["ἔθνη",704068,42]],"and they said to him, Behold, thou art grown old, and thy sons walk not in thy way; and now set over us a king to judge us, as also the other nations [have]."],["6",[["καὶ",707031,7],["ἦν",704093,13],["πονηρὸν",710660,46],["τὸ",709436,24],["ῥῆμα",711246,25],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["Σαμουηλ",711473,18],["ὡς",714148,7],["εἶπαν",705373,150],["δὸς",703654,176],["ἡμῖν",705994,90],["βασιλέα",702580,6],["δικάζειν",703691,55],["ἡμᾶς",705981,194],["καὶ",707031,7],["προσηύξατο",710893,23],["Σαμουηλ",711473,4],["πρὸς",710844,0],["κύριον",707996,6]],"And the thing [was] evil in the eyes of Samuel, when they said, Give us a king to judge us: and Samuel prayed to the Lord."],["7",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Σαμουηλ",711473,6],["ἄκουε",700587,240],["τῆς",709436,16],["φωνῆς",713640,17],["τοῦ",709436,35],["λαοῦ",708094,18],["καθὰ",706979,28],["ἂν",700900,11],["λαλήσωσίν",708071,234],["σοι",711925,159],["ὅτι",709803,7],["οὐ",709805,28],["σὲ",711598,163],["ἐξουθενήκασιν",704969,353],["ἀλλ᾿",700680,7],["ἢ",705924,7],["ἐμὲ",704555,163],["ἐξουδενώκασιν",704969,353],["τοῦ",709436,20],["μὴ",708851,28],["βασιλεύειν",702581,55],["ἐπ᾿",705080,0],["αὐτῶν",702165,40]],"And the Lord said to Samuel, Hear the voice of the people, in whatever they shall say to thee; for they have not rejected thee, but they have rejected me from reigning over them."],["8",[["κατὰ",707200,0],["πάντα",710177,68],["τὰ",709436,41],["ποιήματα",710583,42],["ἃ",709781,69],["ἐποίησάν",710582,150],["μοι",708974,159],["ἀφ᾿",701425,0],["ἧς",709781,167],["ἡμέρας",705984,17],["ἀνήγαγον",700933,150],["αὐτοὺς",702165,62],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["ἕως",705792,0],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86],["καὶ",707031,7],["ἐγκατέλιπόν",703967,150],["με",708618,163],["καὶ",707031,7],["ἐδούλευον",703814,137],["θεοῖς",706192,148],["ἑτέροις",705535,230],["οὕτως",709859,28],["αὐτοὶ",702165,201],["ποιοῦσιν",710582,197],["καὶ",707031,7],["σοί",711925,159]],"According to all their doings which they have done to me, from the day that I brought them out of Egypt until this day, even [as] they have deserted me, and served other gods, so they do also to thee."],["9",[["καὶ",707031,7],["νῦν",709384,28],["ἄκουε",700587,240],["τῆς",709436,16],["φωνῆς",713640,17],["αὐτῶν",702165,40],["πλὴν",710540,28],["ὅτι",709803,7],["διαμαρτυρόμενος",703513,122],["διαμαρτύρῃ",703513,278],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἀπαγγελεῖς",701321,166],["αὐτοῖς",702165,151],["τὸ",709436,24],["δικαίωμα",703697,25],["τοῦ",709436,35],["βασιλέως",702580,18],["ὃς",709781,213],["βασιλεύσει",702581,127],["ἐπ᾿",705080,0],["αὐτούς",702165,62]],"And now hearken to their voice; only thou shalt solemnly testify to them, and thou shalt describe to them the manner of the king who shall reign over them."],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["Σαμουηλ",711473,4],["πᾶν",710177,46],["τὸ",709436,24],["ῥῆμα",711246,25],["κυρίου",707996,18],["πρὸς",710844,0],["τὸν",709436,5],["λαὸν",708094,6],["τοὺς",709436,58],["αἰτοῦντας",700489,235],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["βασιλέα",702580,6]],"And Samuel spoke every word of the Lord to the people who asked of him a king."],["11",[["καὶ",707031,7],["εἶπεν",705373,2],["τοῦτο",709858,132],["ἔσται",704093,93],["τὸ",709436,24],["δικαίωμα",703697,25],["τοῦ",709436,35],["βασιλέως",702580,18],["ὃς",709781,213],["βασιλεύσει",702581,127],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["τοὺς",709436,58],["υἱοὺς",713075,57],["ὑμῶν",713091,145],["λήμψεται",708076,93],["καὶ",707031,7],["θήσεται",712849,93],["αὐτοὺς",702165,62],["ἐν",704639,0],["ἅρμασιν",701768,96],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἱππεῦσιν",706786,148],["αὐτοῦ",702165,102],["καὶ",707031,7],["προτρέχοντας",710997,235],["τῶν",709436,43],["ἁρμάτων",701768,44],["αὐτοῦ",702165,102]],"And he said, This shall be the manner of the king that shall rule over you: he shall take your sons, and put them in his chariots, and among his horsemen, and running before his chariots,"],["12",[["καὶ",707031,7],["θέσθαι",712849,109],["αὐτοὺς",702165,62],["ἑαυτῷ",703917,50],["χιλιάρχους",713857,57],["καὶ",707031,7],["ἑκατοντάρχους",704140,57],["καὶ",707031,7],["θερίζειν",706206,55],["θερισμὸν",706208,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["τρυγᾶν",712996,55],["τρυγητὸν",712998,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ποιεῖν",710582,55],["σκεύη",711844,42],["πολεμικὰ",710602,68],["αὐτοῦ",702165,102],["καὶ",707031,7],["σκεύη",711844,42],["ἁρμάτων",701768,44],["αὐτοῦ",702165,102]],"and [his manner shall be] to make them to himself captains of hundreds and captains of thousands; and to reap his harvest, and gather his vintage, and prepare his instruments of war, and the implements of his chariots."],["13",[["καὶ",707031,7],["τὰς",709436,38],["θυγατέρας",706320,39],["ὑμῶν",713091,145],["λήμψεται",708076,93],["εἰς",704105,0],["μυρεψοὺς",709061,57],["καὶ",707031,7],["εἰς",704105,0],["μαγειρίσσας",708343,39],["καὶ",707031,7],["εἰς",704105,0],["πεσσούσας",710432,338]],"And he will take your daughters to be perfumers, and cooks, and bakers."],["14",[["καὶ",707031,7],["τοὺς",709436,58],["ἀγροὺς",700196,57],["ὑμῶν",713091,145],["καὶ",707031,7],["τοὺς",709436,58],["ἀμπελῶνας",700872,57],["ὑμῶν",713091,145],["καὶ",707031,7],["τοὺς",709436,58],["ἐλαιῶνας",704381,57],["ὑμῶν",713091,145],["τοὺς",709436,58],["ἀγαθοὺς",700106,60],["λήμψεται",708076,93],["καὶ",707031,7],["δώσει",703654,127],["τοῖς",709436,147],["δούλοις",703817,148],["αὐτοῦ",702165,102]],"And he will take your fields, and your vineyards, and your good oliveyards, and give them to his servants."],["15",[["καὶ",707031,7],["τὰ",709436,41],["σπέρματα",712008,42],["ὑμῶν",713091,145],["καὶ",707031,7],["τοὺς",709436,58],["ἀμπελῶνας",700872,57],["ὑμῶν",713091,145],["ἀποδεκατώσει",701442,127],["καὶ",707031,7],["δώσει",703654,127],["τοῖς",709436,147],["εὐνούχοις",705651,148],["αὐτοῦ",702165,102],["καὶ",707031,7],["τοῖς",709436,147],["δούλοις",703817,148],["αὐτοῦ",702165,102]],"And he will take the tithe of your seeds and your vineyards, and give [it] to his eunuchs, and to his servants."],["16",[["καὶ",707031,7],["τοὺς",709436,58],["δούλους",703817,57],["ὑμῶν",713091,145],["καὶ",707031,7],["τὰς",709436,38],["δούλας",703815,39],["ὑμῶν",713091,145],["καὶ",707031,7],["τὰ",709436,41],["βουκόλια",702786,42],["ὑμῶν",713091,145],["τὰ",709436,41],["ἀγαθὰ",700106,68],["καὶ",707031,7],["τοὺς",709436,58],["ὄνους",709671,39],["ὑμῶν",713091,145],["λήμψεται",708076,93],["καὶ",707031,7],["ἀποδεκατώσει",701442,127],["εἰς",704105,0],["τὰ",709436,41],["ἔργα",705396,42],["αὐτοῦ",702165,102]],"And he will take your servants, and your handmaids, and your good herds and your asses, and will take the tenth of them for his works."],["17",[["καὶ",707031,7],["τὰ",709436,41],["ποίμνια",710598,42],["ὑμῶν",713091,145],["ἀποδεκατώσει",701442,127],["καὶ",707031,7],["ὑμεῖς",713081,219],["ἔσεσθε",704093,124],["αὐτῷ",702165,50],["δοῦλοι",703817,52]],"And he will tithe your flocks; and ye shall be his servants."],["18",[["καὶ",707031,7],["βοήσεσθε",702743,124],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἐκ",704132,0],["προσώπου",710986,21],["βασιλέως",702580,18],["ὑμῶν",713091,145],["οὗ",709781,48],["ἐξελέξασθε",704236,345],["ἑαυτοῖς",703917,151],["καὶ",707031,7],["οὐκ",709805,28],["ἐπακούσεται",705009,93],["κύριος",707996,4],["ὑμῶν",713091,145],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["ὅτι",709803,7],["ὑμεῖς",713081,219],["ἐξελέξασθε",704236,345],["ἑαυτοῖς",703917,151],["βασιλέα",702580,6]],"And ye shall cry out in that day because of your king whom ye have chosen to yourselves, and the Lord shall not hear you in those days, because ye have chosen to yourselves a king."],["19",[["καὶ",707031,7],["οὐκ",709805,28],["ἠβούλετο",700088,13],["ὁ",709436,3],["λαὸς",708094,4],["ἀκοῦσαι",700587,106],["τοῦ",709436,35],["Σαμουηλ",711473,18],["καὶ",707031,7],["εἶπαν",705373,150],["αὐτῷ",702165,50],["οὐχί",709862,28],["ἀλλ᾿",700680,7],["ἢ",705924,7],["βασιλεὺς",702580,4],["ἔσται",704093,93],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194]],"But the people would not hearken to Samuel; and they said to him, Nay, but there shall be a king over us."],["20",[["καὶ",707031,7],["ἐσόμεθα",704093,141],["καὶ",707031,7],["ἡμεῖς",705983,219],["κατὰ",707200,0],["πάντα",710177,68],["τὰ",709436,41],["ἔθνη",704068,42],["καὶ",707031,7],["δικάσει",703691,127],["ἡμᾶς",705981,194],["βασιλεὺς",702580,4],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐξελεύσεται",704909,93],["ἔμπροσθεν",704618,0],["ἡμῶν",705999,145],["καὶ",707031,7],["πολεμήσει",710601,127],["τὸν",709436,5],["πόλεμον",710605,6],["ἡμῶν",705999,145]],"And we also will be like all the nations; and our king shall judge us, and shall go out before us, and fight our battles."],["21",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Σαμουηλ",711473,4],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["τοῦ",709436,35],["λαοῦ",708094,18],["καὶ",707031,7],["ἐλάλησεν",708071,2],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὰ",709436,41],["ὦτα",709852,42],["κυρίου",707996,18]],"And Samuel heard all the words of the people, and spoke them in the ears of the Lord."],["22",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Σαμουηλ",711473,6],["ἄκουε",700587,240],["τῆς",709436,16],["φωνῆς",713640,17],["αὐτῶν",702165,40],["καὶ",707031,7],["βασίλευσον",702581,176],["αὐτοῖς",702165,151],["βασιλέα",702580,6],["καὶ",707031,7],["εἶπεν",705373,2],["Σαμουηλ",711473,4],["πρὸς",710844,0],["ἄνδρας",701150,57],["Ισραηλ",706839,18],["ἀποτρεχέτω",701623,240],["ἕκαστος",704133,14],["εἰς",704105,0],["τὴν",709436,8],["πόλιν",710612,9],["αὐτοῦ",702165,102]],"And the Lord said to Samuel, Hearken to their voice, and appoint them a king. And Samuel said to the men of Israel, Let each man depart to his city."]]