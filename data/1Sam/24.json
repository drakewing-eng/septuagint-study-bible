[["1",[["καὶ",707031,7],["ἀνέβη",700905,2],["Δαυιδ",703232,4],["ἐκεῖθεν",704182,28],["καὶ",707031,7],["ἐκάθισεν",707006,2],["ἐν",704639,0],["τοῖς",709436,147],["στενοῖς",712068,230],["Εγγαδδι",703937,118]],"And David rose up from thence, and dwelt in the narrow passes of Engaddi."],["2",[["καὶ",707031,7],["ἐγενήθη",703104,37],["ὡς",714148,7],["ἀνέστρεψεν",701060,2],["Σαουλ",711499,4],["ἀπὸ",701425,0],["ὄπισθεν",709691,28],["τῶν",709436,80],["ἀλλοφύλων",700706,169],["καὶ",707031,7],["ἀπηγγέλη",701321,37],["αὐτῷ",702165,50],["λεγόντων",708124,170],["ὅτι",709803,7],["Δαυιδ",703232,4],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["Εγγαδδι",703937,118]],"And it came to pass when Saul returned from pursuing after the Philistines, that it was reported to him, saying, David [is] in the wilderness of Engaddi."],["3",[["καὶ",707031,7],["ἔλαβεν",708076,2],["μεθ᾿",708780,0],["ἑαυτοῦ",703917,102],["τρεῖς",712927,119],["χιλιάδας",713858,39],["ἀνδρῶν",701150,81],["ἐκλεκτοὺς",704240,60],["ἐκ",704132,0],["παντὸς",710177,116],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐπορεύθη",710667,37],["ζητεῖν",705879,55],["τὸν",709436,5],["Δαυιδ",703232,6],["καὶ",707031,7],["τοὺς",709436,58],["ἄνδρας",701150,57],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["Σαδαιεμ",711367,118]],"And he took with him three thousand men, chosen out of all Israel, and went to seek David and his men in front of Saddæem."],["4",[["καὶ",707031,7],["ἦλθεν",705453,2],["εἰς",704105,0],["τὰς",709436,38],["ἀγέλας",700148,39],["τῶν",709436,43],["ποιμνίων",710598,44],["τὰς",709436,38],["ἐπὶ",705080,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["καὶ",707031,7],["ἦν",704093,13],["ἐκεῖ",704181,28],["σπήλαιον",712012,25],["καὶ",707031,7],["Σαουλ",711499,4],["εἰσῆλθεν",704114,2],["παρασκευάσασθαι",710103,109],["καὶ",707031,7],["Δαυιδ",703232,4],["καὶ",707031,7],["οἱ",709436,136],["ἄνδρες",701150,52],["αὐτοῦ",702165,102],["ἐσώτερον",705525,28],["τοῦ",709436,20],["σπηλαίου",712012,21],["ἐκάθηντο",707000,139]],"And he came to the flocks of sheep that were by the way, and there was a cave there; and Saul went in to make preparation, and David and his men were sitting in the inner part of the cave."],["5",[["καὶ",707031,7],["εἶπον",705373,150],["οἱ",709436,136],["ἄνδρες",701150,52],["Δαυιδ",703232,18],["πρὸς",710844,0],["αὐτόν",702165,85],["ἰδοὺ",706497,88],["ἡ",709436,10],["ἡμέρα",705984,12],["αὕτη",709858,107],["ἣν",709781,131],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["σὲ",711598,163],["παραδοῦναι",710014,106],["τὸν",709436,5],["ἐχθρόν",705779,6],["σου",711945,133],["εἰς",704105,0],["τὰς",709436,38],["χεῖράς",713787,39],["σου",711945,133],["καὶ",707031,7],["ποιήσεις",710582,166],["αὐτῷ",702165,50],["ὡς",714148,7],["ἀγαθὸν",700106,27],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["σου",711945,133],["καὶ",707031,7],["ἀνέστη",701173,2],["Δαυιδ",703232,4],["καὶ",707031,7],["ἀφεῖλεν",702177,2],["τὸ",709436,24],["πτερύγιον",711056,25],["τῆς",709436,16],["διπλοΐδος",703739,17],["τῆς",709436,16],["Σαουλ",711499,17],["λαθραίως",708059,28]],"And the men of David said to him, Behold, this [is] the day of which the Lord spoke to thee, that he would deliver thine enemy into thy hands; and thou shalt do to him as [it is] good in thy sight. So David arose and cut off the skirt of Saul's garment secretly."],["6",[["καὶ",707031,7],["ἐγενήθη",703104,37],["μετὰ",708780,0],["ταῦτα",709858,71],["καὶ",707031,7],["ἐπάταξεν",710185,2],["καρδία",707141,12],["Δαυιδ",703232,18],["αὐτόν",702165,85],["ὅτι",709803,7],["ἀφεῖλεν",702177,2],["τὸ",709436,24],["πτερύγιον",711056,25],["τῆς",709436,16],["διπλοΐδος",703739,17],["αὐτοῦ",702165,102]],"And it came to pass after this that David's heart smote him, because he had cut off the skirt of his garment."],["7",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["πρὸς",710844,0],["τοὺς",709436,58],["ἄνδρας",701150,57],["αὐτοῦ",702165,102],["μηδαμῶς",708854,28],["μοι",708974,159],["παρὰ",709995,0],["κυρίου",707996,18],["εἰ",704071,7],["ποιήσω",710582,207],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["τῷ",709436,113],["κυρίῳ",707996,114],["μου",709032,133],["τῷ",709436,113],["χριστῷ",713964,30],["κυρίου",707996,18],["ἐπενέγκαι",705322,106],["χεῖρά",713787,9],["μου",709032,133],["ἐπ᾿",705080,0],["αὐτόν",702165,85],["ὅτι",709803,7],["χριστὸς",713964,14],["κυρίου",707996,18],["ἐστὶν",704093,91],["οὗτος",709858,121]],"And David said to his men, The Lord forbid it me, that I should do this thing to my lord the anointed of the Lord, to lift my hand against him; for he is the anointed of the Lord."],["8",[["καὶ",707031,7],["ἔπεισεν",710221,2],["Δαυιδ",703232,4],["τοὺς",709436,58],["ἄνδρας",701150,57],["αὐτοῦ",702165,102],["ἐν",704639,0],["λόγοις",708236,148],["καὶ",707031,7],["οὐκ",709805,28],["ἔδωκεν",703654,2],["αὐτοῖς",702165,151],["ἀναστάντας",701173,454],["θανατῶσαι",706097,106],["τὸν",709436,5],["Σαουλ",711499,6],["καὶ",707031,7],["ἀνέστη",701173,2],["Σαουλ",711499,4],["καὶ",707031,7],["κατέβη",707202,2],["εἰς",704105,0],["τὴν",709436,8],["ὁδόν",709458,9]],"So David persuaded his men by [his] words, and did not suffer them to arise and slay Saul: and Saul arose and went his way."],["9",[["καὶ",707031,7],["ἀνέστη",701173,2],["Δαυιδ",703232,4],["ὀπίσω",709697,0],["αὐτοῦ",702165,102],["ἐκ",704132,0],["τοῦ",709436,20],["σπηλαίου",712012,21],["καὶ",707031,7],["ἐβόησεν",702743,2],["Δαυιδ",703232,4],["ὀπίσω",709697,0],["Σαουλ",711499,18],["λέγων",708124,72],["κύριε",707996,153],["βασιλεῦ",702580,153],["καὶ",707031,7],["ἐπέβλεψεν",705088,2],["Σαουλ",711499,4],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔκυψεν",707989,2],["Δαυιδ",703232,4],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["προσεκύνησεν",710925,2],["αὐτῷ",702165,50]],"And David rose up [and went] after him out of the cave: and David cried after Saul, saying, [My] lord, [O] king! and Saul looked behind him, and David bowed with his face to the ground, and did obeisance to him."],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["πρὸς",710844,0],["Σαουλ",711499,6],["ἵνα",706747,7],["τί",712867,126],["ἀκούεις",700587,154],["τῶν",709436,80],["λόγων",708236,81],["τοῦ",709436,35],["λαοῦ",708094,18],["λεγόντων",708124,170],["ἰδοὺ",706497,88],["Δαυιδ",703232,4],["ζητεῖ",705879,91],["τὴν",709436,8],["ψυχήν",714070,9],["σου",711945,133]],"And David said to Saul, Why dost thou hearken to the words of the people, saying, Behold, David seeks thy life?"],["11",[["ἰδοὺ",706497,88],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ταύτῃ",709858,105],["ἑοράκασιν",709725,353],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["σου",711945,133],["ὡς",714148,7],["παρέδωκέν",710014,2],["σε",711598,163],["κύριος",707996,4],["σήμερον",711751,28],["εἰς",704105,0],["χεῖρά",713787,9],["μου",709032,133],["ἐν",704639,0],["τῷ",709436,53],["σπηλαίῳ",712012,54],["καὶ",707031,7],["οὐκ",709805,28],["ἠβουλήθην",700088,156],["ἀποκτεῖναί",701498,106],["σε",711598,163],["καὶ",707031,7],["ἐφεισάμην",713406,161],["σου",711945,133],["καὶ",707031,7],["εἶπα",705373,155],["οὐκ",709805,28],["ἐποίσω",705322,165],["χεῖρά",713787,9],["μου",709032,133],["ἐπὶ",705080,0],["κύριόν",707996,6],["μου",709032,133],["ὅτι",709803,7],["χριστὸς",713964,14],["κυρίου",707996,18],["οὗτός",709858,121],["ἐστιν",704093,91]],"Behold, thine eyes have seen this day how that the Lord has delivered thee this day into my hands in the cave; and I would not slay thee, but spared thee, and said, I will not lift up my hand against my lord, for he is the Lord's anointed."],["12",[["καὶ",707031,7],["ἰδοὺ",706497,88],["τὸ",709436,34],["πτερύγιον",711056,15],["τῆς",709436,16],["διπλοΐδος",703739,17],["σου",711945,133],["ἐν",704639,0],["τῇ",709436,100],["χειρί",713787,1],["μου",709032,133],["ἐγὼ",704018,164],["ἀφῄρηκα",702177,89],["τὸ",709436,24],["πτερύγιον",711056,25],["καὶ",707031,7],["οὐκ",709805,28],["ἀπέκταγκά",701498,89],["σε",711598,163],["καὶ",707031,7],["γνῶθι",703105,176],["καὶ",707031,7],["ἰδὲ",709725,176],["σήμερον",711751,28],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["κακία",707054,12],["ἐν",704639,0],["τῇ",709436,100],["χειρί",713787,1],["μου",709032,133],["οὐδὲ",709816,7],["ἀσέβεια",701904,12],["καὶ",707031,7],["ἀθέτησις",700371,12],["καὶ",707031,7],["οὐχ",709805,28],["ἡμάρτηκα",700773,89],["εἰς",704105,0],["σέ",711598,163],["καὶ",707031,7],["σὺ",712181,164],["δεσμεύεις",703369,154],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["λαβεῖν",708076,106],["αὐτήν",702165,104]],"And behold, the skirt of thy mantle [is] in my hand, I cut off the skirt, and did not slay thee: know then and see to-day, there is no evil in my hand, nor impiety, nor rebellion; and I have not sinned against thee, yet thou layest snares for my soul to take it."],["13",[["δικάσαι",703691,517],["κύριος",707996,4],["ἀνὰ",700902,0],["μέσον",708768,46],["ἐμοῦ",704580,133],["καὶ",707031,7],["σοῦ",711945,133],["καὶ",707031,7],["ἐκδικήσαι",704174,382],["με",708618,163],["κύριος",707996,4],["ἐκ",704132,0],["σοῦ",711945,133],["καὶ",707031,7],["ἡ",709436,10],["χείρ",713787,12],["μου",709032,133],["οὐκ",709805,28],["ἔσται",704093,93],["ἐπὶ",705080,0],["σοί",711925,159]],"The Lord judge between me and thee, and the Lord requite thee on thyself: but my hand shall not be upon thee."],["14",[["καθὼς",707030,28],["λέγεται",708124,117],["ἡ",709436,10],["παραβολὴ",710003,12],["ἡ",709436,10],["ἀρχαία",701835,29],["ἐξ",704132,0],["ἀνόμων",701194,169],["ἐξελεύσεται",704909,93],["πλημμέλεια",710533,12],["καὶ",707031,7],["ἡ",709436,10],["χείρ",713787,12],["μου",709032,133],["οὐκ",709805,28],["ἔσται",704093,93],["ἐπὶ",705080,0],["σέ",711598,163]],"As the old proverb says, Transgression will proceed from the wicked ones: but my hand shall not be upon thee."],["15",[["καὶ",707031,7],["νῦν",709384,28],["ὀπίσω",709697,0],["τίνος",712867,340],["σὺ",712181,164],["ἐκπορεύῃ",704293,204],["βασιλεῦ",702580,153],["Ισραηλ",706839,18],["ὀπίσω",709697,0],["τίνος",712867,340],["καταδιώκεις",707243,154],["σύ",712181,164],["ὀπίσω",709697,0],["κυνὸς",708004,18],["τεθνηκότος",706278,310],["καὶ",707031,7],["ὀπίσω",709697,0],["ψύλλου",714068,18],["ἑνός",704106,116]],"And now after whom dost thou come forth, O king of Israel? after whom dost thou pursue? after a dead dog, and after a flea?"],["16",[["γένοιτο",703104,382],["κύριος",707996,4],["εἰς",704105,0],["κριτὴν",707910,6],["καὶ",707031,7],["δικαστὴν",703701,6],["ἀνὰ",700902,0],["μέσον",708768,46],["ἐμοῦ",704580,133],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,46],["σοῦ",711945,133],["ἴδοι",709725,225],["κύριος",707996,4],["καὶ",707031,7],["κρίναι",707905,225],["τὴν",709436,8],["κρίσιν",707908,9],["μου",709032,133],["καὶ",707031,7],["δικάσαι",703691,106],["μοι",708974,159],["ἐκ",704132,0],["χειρός",713787,17],["σου",711945,133]],"The Lord be judge and umpire between me and thee, the Lord look upon and judge my cause, and rescue me out of thy hand."],["17",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὡς",714148,7],["συνετέλεσεν",712510,2],["Δαυιδ",703232,4],["τὰ",709436,41],["ῥήματα",711246,42],["ταῦτα",709858,71],["λαλῶν",708071,72],["πρὸς",710844,0],["Σαουλ",711499,6],["καὶ",707031,7],["εἶπεν",705373,2],["Σαουλ",711499,4],["ἦ",704093,13],["φωνή",713640,12],["σου",711945,133],["αὕτη",709858,107],["τέκνον",712761,25],["Δαυιδ",703232,18],["καὶ",707031,7],["ἦρεν",700473,2],["τὴν",709436,8],["φωνὴν",713640,9],["αὐτοῦ",702165,102],["Σαουλ",711499,4],["καὶ",707031,7],["ἔκλαυσεν",707703,2]],"And it came to pass when David had finished speaking these words to Saul, that Saul said, [Is] this thy voice, son David? and Saul lifted up his voice, and wept."],["18",[["καὶ",707031,7],["εἶπεν",705373,2],["Σαουλ",711499,4],["πρὸς",710844,0],["Δαυιδ",703232,6],["δίκαιος",703694,14],["σὺ",712181,164],["ὑπὲρ",713111,0],["ἐμέ",704555,163],["ὅτι",709803,7],["σὺ",712181,164],["ἀνταπέδωκάς",701215,162],["μοι",708974,159],["ἀγαθά",700106,68],["ἐγὼ",704018,164],["δὲ",703303,11],["ἀνταπέδωκά",701215,155],["σοι",711925,159],["κακά",707066,68]],"And Saul said to David, Thou [art] more righteous than I, for thou hast recompensed me good, but I have recompensed thee evil."],["19",[["καὶ",707031,7],["σὺ",712181,164],["ἀπήγγειλάς",701321,162],["μοι",708974,159],["σήμερον",711751,28],["ἃ",709781,69],["ἐποίησάς",710582,162],["μοι",708974,159],["ἀγαθά",700106,68],["ὡς",714148,7],["ἀπέκλεισέν",701484,2],["με",708618,163],["κύριος",707996,4],["σήμερον",711751,28],["εἰς",704105,0],["χεῖράς",713787,39],["σου",711945,133],["καὶ",707031,7],["οὐκ",709805,28],["ἀπέκτεινάς",701498,162],["με",708618,163]],"And thou hast told me to-day what good thou hast done me, how the Lord shut me up into thy hands to-day, and thou didst not slay me."],["20",[["καὶ",707031,7],["ὅτι",709803,7],["εἰ",704071,7],["εὕροιτό",705676,382],["τις",712866,356],["τὸν",709436,5],["ἐχθρὸν",705779,6],["αὐτοῦ",702165,102],["ἐν",704639,0],["θλίψει",706276,1],["καὶ",707031,7],["ἐκπέμψαι",704274,106],["αὐτὸν",702165,85],["ἐν",704639,0],["ὁδῷ",709458,1],["ἀγαθῇ",700106,101],["καὶ",707031,7],["κύριος",707996,4],["ἀνταποτείσει",701222,127],["αὐτῷ",702165,50],["ἀγαθά",700106,68],["καθὼς",707030,28],["πεποίηκας",710582,266],["σήμερον",711751,28]],"And if any one should find his enemy in distress, and should send him forth in a good way, then the Lord will reward him good, as thou hast done this day."],["21",[["καὶ",707031,7],["νῦν",709384,28],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["γινώσκω",703105,157],["ὅτι",709803,7],["βασιλεύων",702581,72],["βασιλεύσεις",702581,166],["καὶ",707031,7],["στήσεται",706846,93],["ἐν",704639,0],["χερσίν",713787,76],["σου",711945,133],["βασιλεία",702577,12],["Ισραηλ",706839,18]],"And now, behold, I know that thou shalt surely reign, and the kingdom of Israel shall be established in thy hand."],["22",[["καὶ",707031,7],["νῦν",709384,28],["ὄμοσόν",709620,176],["μοι",708974,159],["ἐν",704639,0],["κυρίῳ",707996,114],["ὅτι",709803,7],["οὐκ",709805,28],["ἐξολεθρεύσεις",704956,166],["τὸ",709436,24],["σπέρμα",712008,25],["μου",709032,133],["ὀπίσω",709697,0],["μου",709032,133],["καὶ",707031,7],["οὐκ",709805,28],["ἀφανιεῖς",702182,166],["τὸ",709436,24],["ὄνομά",709666,25],["μου",709032,133],["ἐκ",704132,0],["τοῦ",709436,35],["οἴκου",709516,18],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133]],"Now then swear to me by the Lord, that thou wilt not destroy my seed after me, that thou wilt not blot out my name from the house of my father."],["23",[["καὶ",707031,7],["ὤμοσεν",709620,2],["Δαυιδ",703232,4],["τῷ",709436,113],["Σαουλ",711499,114],["καὶ",707031,7],["ἀπῆλθεν",701398,2],["Σαουλ",711499,4],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["Δαυιδ",703232,4],["καὶ",707031,7],["οἱ",709436,136],["ἄνδρες",701150,52],["αὐτοῦ",702165,102],["ἀνέβησαν",700905,150],["εἰς",704105,0],["τὴν",709436,8],["Μεσσαρα",708775,9],["στενήν",712068,36]],"So David swore to Saul: and Saul departed to his place, and David and his men went up to the strong-hold of Messera."]]