,711291,1],["καὶ",707031,7],["ἐν",704639,0],["δόρατι",703804,54],["καὶ",707031,7],["ἐν",704639,0],["ἀσπίδι",701991,1],["κἀγὼ",706969,288],["πορεύομαι",710667,254],["πρὸς",710844,0],["σὲ",711598,163],["ἐν",704639,0],["ὀνόματι",709666,54],["κυρίου",707996,18],["σαβαωθ",711346,18],["θεοῦ",706192,18],["παρατάξεως",710107,17],["Ισραηλ",706839,17],["ἣν",709781,131],["ὠνείδισας",709655,162],["σήμερον",711751,28]],"And David said to the Philistine, Thou comest to me with sword, and with spear, and with shield; but I come to thee in the name of the Lord God of hosts of the army of Israel, which thou hast defied"],["46",[["καὶ",707031,7],["ἀποκλείσει",701484,127],["σε",711598,163],["κύριος",707996,4],["σήμερον",711751,28],["εἰς",704105,0],["τὴν",709436,8],["χεῖρά",713787,9],["μου",709032,133],["καὶ",707031,7],["ἀποκτενῶ",701498,165],["σε",711598,163],["καὶ",707031,7],["ἀφελῶ",702177,165],["τὴν",709436,8],["κεφαλήν",707639,9],["σου",711945,133],["ἀπὸ",701425,0],["σοῦ",711945,133],["καὶ",707031,7],["δώσω",703654,165],["τὰ",709436,41],["κῶλά",708017,42],["σου",711945,133],["καὶ",707031,7],["τὰ",709436,41],["κῶλα",708017,42],["παρεμβολῆς",710133,17],["ἀλλοφύλων",700706,169],["ἐν",704639,0],["ταύτῃ",709858,105],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τοῖς",709436,95],["πετεινοῖς",710438,96],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["τοῖς",709436,95],["θηρίοις",706252,96],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["γνώσεται",703105,93],["πᾶσα",710177,29],["ἡ",709436,10],["γῆ",703083,12],["ὅτι",709803,7],["ἔστιν",704093,91],["θεὸς",706192,4],["ἐν",704639,0],["Ισραηλ",706839,114]],"this day. And the Lord shall deliver thee this day into my hand; and I will slay thee, and take away thy head from off thee, and will give thy limbs and the limbs of the army of the Philistines this day to the birds of the sky, and to the wild beasts of the earth; and all the earth shall know that there is a God in Israel."],["47",[["καὶ",707031,7],["γνώσεται",703105,93],["πᾶσα",710177,29],["ἡ",709436,10],["ἐκκλησία",704216,12],["αὕτη",709858,107],["ὅτι",709803,7],["οὐκ",709805,28],["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["καὶ",707031,7],["δόρατι",703804,54],["σῴζει",712627,91],["κύριος",707996,4],["ὅτι",709803,7],["τοῦ",709436,35],["κυρίου",707996,18],["ὁ",709436,3],["πόλεμος",710605,4],["καὶ",707031,7],["παραδώσει",710014,127],["κύριος",707996,4],["ὑμᾶς",713080,194],["εἰς",704105,0],["χεῖρας",713787,39],["ἡμῶν",705999,145]],"And all this assembly shall know that the Lord delivers not by sword or spear, for the battle [is] the Lord's, and the Lord will deliver you into our hands."],["48",[["καὶ",707031,7],["ἀνέστη",701173,2],["ὁ",709436,3],["ἀλλόφυλος",700706,14],["καὶ",707031,7],["ἐπορεύθη",710667,37],["εἰς",704105,0],["συνάντησιν",712397,9],["Δαυιδ",703232,6]],"And the Philistine arose and went to meet David."],["49",[["καὶ",707031,7],["ἐξέτεινεν",704322,2],["Δαυιδ",703232,4],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὸ",709436,24],["κάδιον",706975,25],["καὶ",707031,7],["ἔλαβεν",708076,2],["ἐκεῖθεν",704182,28],["λίθον",708196,6],["ἕνα",704106,27],["καὶ",707031,7],["ἐσφενδόνησεν",712577,2],["καὶ",707031,7],["ἐπάταξεν",710185,2],["τὸν",709436,5],["ἀλλόφυλον",700706,27],["ἐπὶ",705080,0],["τὸ",709436,24],["μέτωπον",708847,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["διέδυ",703451,2],["ὁ",709436,3],["λίθος",708196,4],["διὰ",703417,0],["τῆς",709436,16],["περικεφαλαίας",710331,17],["εἰς",704105,0],["τὸ",709436,24],["μέτωπον",708847,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔπεσεν",710481,2],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9]],"And David stretched out his hand to his scrip, and took thence a stone, and slang it, and smote the Philistine on his forehead, and the stone penetrated through the helmet into his forehead, and he fell upon his face to the ground."],["51",[["καὶ",707031,7],["ἔδραμεν",712931,2],["Δαυιδ",703232,4],["καὶ",707031,7],["