[["1",[["καὶ",707031,7],["συνάγουσιν",712375,197],["ἀλλόφυλοι",700706,52],["τὰς",709436,38],["παρεμβολὰς",710133,39],["αὐτῶν",702165,40],["εἰς",704105,0],["πόλεμον",710605,6],["καὶ",707031,7],["συνάγονται",712375,269],["εἰς",704105,0],["Σοκχωθ",711926,227],["τῆς",709436,16],["Ιουδαίας",706769,17],["καὶ",707031,7],["παρεμβάλλουσιν",710132,197],["ἀνὰ",700902,0],["μέσον",708768,46],["Σοκχωθ",711926,118],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,46],["Αζηκα",700334,118],["ἐν",704639,0],["Εφερμεμ",705746,111]],"And the Philistines gather their armies to battle, and gather themselves to Socchoth of Judæa, and encamp between Socchoth and Azeca Ephermen."],["2",[["καὶ",707031,7],["Σαουλ",711499,4],["καὶ",707031,7],["οἱ",709436,136],["ἄνδρες",701150,52],["Ισραηλ",706839,18],["συνάγονται",712375,269],["καὶ",707031,7],["παρεμβάλλουσιν",710132,197],["ἐν",704639,0],["τῇ",709436,100],["κοιλάδι",707758,1],["αὐτοὶ",702165,201],["παρατάσσονται",710108,269],["εἰς",704105,0],["πόλεμον",710605,6],["ἐξ",704132,0],["ἐναντίας",704656,82],["ἀλλοφύλων",700706,81]],"And Saul and the men of Israel gather together, and they encamp in the valley, and set the battle in array against the Philistines."],["3",[["καὶ",707031,7],["ἀλλόφυλοι",700706,52],["ἵστανται",706846,269],["ἐπὶ",705080,0],["τοῦ",709436,20],["ὄρους",709768,21],["ἐνταῦθα",704787,28],["καὶ",707031,7],["Ισραηλ",706839,4],["ἵσταται",706846,117],["ἐπὶ",705080,0],["τοῦ",709436,20],["ὄρους",709768,21],["ἐνταῦθα",704787,28],["καὶ",707031,7],["ὁ",709436,3],["αὐλὼν",702141,4],["ἀνὰ",700902,0],["μέσον",708768,46],["αὐτῶν",702165,40]],"And the Philistines stand on the mountain on one side, and Israel stands on the mountain on the other side, and the valley was between them."],["4",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["ἀνὴρ",701150,4],["δυνατὸς",703845,14],["ἐκ",704132,0],["τῆς",709436,16],["παρατάξεως",710107,17],["τῶν",709436,80],["ἀλλοφύλων",700706,81],["Γολιαθ",703161,4],["ὄνομα",709666,15],["αὐτῷ",702165,50],["ἐκ",704132,0],["Γεθ",703005,17],["ὕψος",713288,15],["αὐτοῦ",702165,102],["τεσσάρων",712808,169],["πήχεων",710462,169],["καὶ",707031,7],["σπιθαμῆς",712013,17]],"And there went forth a mighty man out of the army of the Philistines, Goliath by name, out of Geth, his height [was] four cubits and a span."],["5",[["καὶ",707031,7],["περικεφαλαία",710331,12],["ἐπὶ",705080,0],["τῆς",709436,16],["κεφαλῆς",707639,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["θώρακα",706356,6],["ἁλυσιδωτὸν",700733,27],["αὐτὸς",702165,121],["ἐνδεδυκώς",704701,270],["καὶ",707031,7],["ὁ",709436,3],["σταθμὸς",712040,4],["τοῦ",709436,35],["θώρακος",706356,18],["αὐτοῦ",702165,102],["πέντε",710266,59],["χιλιάδες",713858,191],["σίκλων",711786,81],["χαλκοῦ",713690,116],["καὶ",707031,7],["σιδήρου",711774,18]],"And [he had] a helmet upon his head, and he wore a breastplate of chain armour; and the weight of his breastplate [was] five thousand shekels of brass and iron."],["6",[["καὶ",707031,7],["κνημῖδες",707751,191],["χαλκαῖ",713690,192],["ἐπάνω",705030,28],["τῶν",709436,43],["σκελῶν",711831,44],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀσπὶς",701991,12],["χαλκῆ",713690,29],["ἀνὰ",700902,0],["μέσον",708768,46],["τῶν",709436,80],["ὤμων",714114,81],["αὐτοῦ",702165,102]],"And greaves of brass [were] upon his legs, and a brazen target [was] between his shoulders."],["7",[["καὶ",707031,7],["ὁ",709436,3],["κοντὸς",707817,4],["τοῦ",709436,20],["δόρατος",703804,21],["αὐτοῦ",702165,102],["ὡσεὶ",714159,28],["μέσακλον",708756,15],["ὑφαινόντων",713275,170],["καὶ",707031,7],["ἡ",709436,10],["λόγχη",708237,12],["αὐτοῦ",702165,102],["ἑξακοσίων",704847,169],["σίκλων",711786,81],["σιδήρου",711774,18],["καὶ",707031,7],["ὁ",709436,3],["αἴρων",700473,72],["τὰ",709436,41],["ὅπλα",709704,42],["αὐτοῦ",702165,102],["προεπορεύετο",710839,19],["αὐτοῦ",702165,102]],"And the staff of his spear [was] like a weavers' beam, and the spear's head [was formed] of six hundred shekels of iron; and his armour-bearer went before him."],["8",[["καὶ",707031,7],["ἔστη",706846,2],["καὶ",707031,7],["ἀνεβόησεν",700915,2],["εἰς",704105,0],["τὴν",709436,8],["παράταξιν",710107,9],["Ισραηλ",706839,18],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["τί",712867,578],["ἐκπορεύεσθε",704293,374],["παρατάξασθαι",710108,109],["πολέμῳ",710605,114],["ἐξ",704132,0],["ἐναντίας",704656,82],["ἡμῶν",705999,145],["οὐκ",709805,28],["ἐγώ",704018,164],["εἰμι",704093,157],["ἀλλόφυλος",700706,4],["καὶ",707031,7],["ὑμεῖς",713081,219],["Εβραῖοι",703933,52],["τοῦ",709436,35],["Σαουλ",711499,18],["ἐκλέξασθε",704236,186],["ἑαυτοῖς",703917,151],["ἄνδρα",701150,6],["καὶ",707031,7],["καταβήτω",707202,45],["πρός",710844,0],["με",708618,163]],"And he stood and cried to the army of Israel, and said to them, Why are ye come forth to set yourselves in battle array against us? Am not I a Philistine, and ye Hebrews of Saul? choose for yourselves a man, and let him come down to me."],["9",[["καὶ",707031,7],["ἐὰν",703912,7],["δυνηθῇ",703838,384],["πρὸς",710844,0],["ἐμὲ",704555,163],["πολεμῆσαι",710601,106],["καὶ",707031,7],["ἐὰν",703912,7],["πατάξῃ",710185,123],["με",708618,163],["καὶ",707031,7],["ἐσόμεθα",704093,141],["ὑμῖν",713084,90],["εἰς",704105,0],["δούλους",703817,57],["ἐὰν",703912,7],["δὲ",703303,11],["ἐγὼ",704018,164],["δυνηθῶ",703838,321],["καὶ",707031,7],["πατάξω",710185,165],["αὐτόν",702165,85],["ἔσεσθε",704093,124],["ἡμῖν",705994,90],["εἰς",704105,0],["δούλους",703817,57],["καὶ",707031,7],["δουλεύσετε",703814,337],["ἡμῖν",705994,90]],"And if he shall be able to fight against me, and shall smite me, then will we be your servants: but if I should prevail and smite him, ye shall be our servants, and serve us."],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["ἀλλόφυλος",700706,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ὠνείδισα",709655,155],["τὴν",709436,8],["παράταξιν",710107,9],["Ισραηλ",706839,18],["σήμερον",711751,28],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ταύτῃ",709858,105],["δότε",703654,74],["μοι",708974,159],["ἄνδρα",701150,6],["καὶ",707031,7],["μονομαχήσομεν",709000,275],["ἀμφότεροι",700892,138]],"And the Philistine said, Behold, I have defied the armies of Israel this very day: give me a man, and we will both of us fight in single combat."],["11",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Σαουλ",711499,4],["καὶ",707031,7],["πᾶς",710177,14],["Ισραηλ",706839,4],["τὰ",709436,41],["ῥήματα",711246,42],["τοῦ",709436,35],["ἀλλοφύλου",700706,18],["ταῦτα",709858,71],["καὶ",707031,7],["ἐξέστησαν",704940,150],["καὶ",707031,7],["ἐφοβήθησαν",713532,99],["σφόδρα",712586,28]],"And Saul and all Israel heard these words of the Philistine, and they were dismayed, and greatly terrified."],["32",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["πρὸς",710844,0],["Σαουλ",711499,6],["μὴ",708851,28],["δὴ",703395,11],["συμπεσέτω",712332,45],["ἡ",709436,10],["καρδία",707141,12],["τοῦ",709436,35],["κυρίου",707996,18],["μου",709032,133],["ἐπ᾿",705080,0],["αὐτόν",702165,85],["ὁ",709436,3],["δοῦλός",703817,4],["σου",711945,133],["πορεύσεται",710667,93],["καὶ",707031,7],["πολεμήσει",710601,127],["μετὰ",708780,0],["τοῦ",709436,35],["ἀλλοφύλου",700706,18],["τούτου",709858,102]],"And David said to Saul, Let not, I pray thee, the heart of my lord be dejected within him: thy servant will go, and fight with this Philistine."],["33",[["καὶ",707031,7],["εἶπεν",705373,2],["Σαουλ",711499,4],["πρὸς",710844,0],["Δαυιδ",703232,6],["οὐ",709805,28],["μὴ",708851,28],["δυνήσῃ",703838,123],["πορευθῆναι",710667,179],["πρὸς",710844,0],["τὸν",709436,5],["ἀλλόφυλον",700706,6],["τοῦ",709436,35],["πολεμεῖν",710601,55],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ὅτι",709803,7],["παιδάριον",709923,15],["εἶ",704093,154],["σύ",712181,164],["καὶ",707031,7],["αὐτὸς",702165,121],["ἀνὴρ",701150,4],["πολεμιστὴς",710604,18],["ἐκ",704132,0],["νεότητος",709258,17],["αὐτοῦ",702165,102]],"And Saul said to David, Thou wilt not in anywise be able to go against this Philistine to fight with him, for thou art a mere youth, and he a man of war from his youth."],["34",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["πρὸς",710844,0],["Σαουλ",711499,6],["ποιμαίνων",710594,72],["ἦν",704093,13],["ὁ",709436,3],["δοῦλός",703817,4],["σου",711945,133],["τῷ",709436,113],["πατρὶ",710189,114],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,113],["ποιμνίῳ",710598,54],["καὶ",707031,7],["ὅταν",709801,28],["ἤρχετο",705453,19],["ὁ",709436,3],["λέων",708171,4],["καὶ",707031,7],["ἡ",709436,10],["ἄρκος",701766,12],["καὶ",707031,7],["ἐλάμβανεν",708076,13],["πρόβατον",710768,25],["ἐκ",704132,0],["τῆς",709436,16],["ἀγέλης",700148,17]],"And David said to Saul, Thy servant was tending the flock for his father; and when a lion came and a she-bear, and took a sheep out of the flock,"],["35",[["καὶ",707031,7],["ἐξεπορευόμην",704293,334],["ὀπίσω",709697,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπάταξα",710185,155],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐξέσπασα",704311,155],["ἐκ",704132,0],["τοῦ",709436,20],["στόματος",712125,21],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἰ",704071,7],["ἐπανίστατο",705026,19],["ἐπ᾿",705080,0],["ἐμέ",704555,163],["καὶ",707031,7],["ἐκράτησα",707879,155],["τοῦ",709436,35],["φάρυγγος",713375,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπάταξα",710185,155],["καὶ",707031,7],["ἐθανάτωσα",706097,155],["αὐτόν",702165,85]],"then I went forth after him, and smote him, and drew [the spoil] out of his mouth: and as he rose up against me, then I caught hold of his throat, and smote him, and slew him."],["36",[["καὶ",707031,7],["τὴν",709436,8],["ἄρκον",701766,9],["ἔτυπτεν",713022,13],["ὁ",709436,3],["δοῦλός",703817,4],["σου",711945,133],["καὶ",707031,7],["τὸν",709436,5],["λέοντα",708171,6],["καὶ",707031,7],["ἔσται",704093,93],["ὁ",709436,3],["ἀλλόφυλος",700706,4],["ὁ",709436,3],["ἀπερίτμητος",701397,14],["ὡς",714148,7],["ἓν",704106,46],["τούτων",709858,40],["οὐχὶ",709862,28],["πορεύσομαι",710667,181],["καὶ",707031,7],["πατάξω",710185,165],["αὐτὸν",702165,85],["καὶ",707031,7],["ἀφελῶ",702177,165],["σήμ