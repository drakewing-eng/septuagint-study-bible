[["1",[["καὶ",707031,7],["ἀπηγγέλη",701321,37],["τῷ",709436,113],["Δαυιδ",703232,114],["λέγοντες",708124,146],["ἰδοὺ",706497,88],["οἱ",709436,136],["ἀλλόφυλοι",700706,138],["πολεμοῦσιν",710601,197],["ἐν",704639,0],["τῇ",709436,100],["Κεϊλα",707593,1],["καὶ",707031,7],["αὐτοὶ",702165,201],["διαρπάζουσιν",703562,197],["καταπατοῦσιν",707360,197],["τοὺς",709436,58],["ἅλω",700741,57]],"And it was told David, saying, Behold, the Philistines war in Keila, and they rob, they trample on the threshing-floors."],["2",[["καὶ",707031,7],["ἐπηρώτησεν",705069,2],["Δαυιδ",703232,4],["διὰ",703417,0],["τοῦ",709436,35],["κυρίου",707996,18],["λέγων",708124,72],["εἰ",704071,7],["πορευθῶ",710667,321],["καὶ",707031,7],["πατάξω",710185,165],["τοὺς",709436,58],["ἀλλοφύλους",700706,60],["τούτους",709858,62],["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πορεύου",710667,240],["καὶ",707031,7],["πατάξεις",710185,166],["ἐν",704639,0],["τοῖς",709436,147],["ἀλλοφύλοις",700706,230],["τούτοις",709858,151],["καὶ",707031,7],["σώσεις",712627,166],["τὴν",709436,8],["Κεϊλα",707593,9]],"And David enquired of the Lord, saying, Shall I go and smite these Philistines? And the Lord said, Go, and thou shalt smite these Philistines, and shalt save Keila."],["3",[["καὶ",707031,7],["εἶπαν",705373,150],["οἱ",709436,136],["ἄνδρες",701150,52],["τοῦ",709436,35],["Δαυιδ",703232,18],["πρὸς",710844,0],["αὐτόν",702165,85],["ἰδοὺ",706497,88],["ἡμεῖς",705983,219],["ἐνταῦθα",704787,28],["ἐν",704639,0],["τῇ",709436,100],["Ιουδαίᾳ",706769,1],["φοβούμεθα",713532,378],["καὶ",707031,7],["πῶς",711121,28],["ἔσται",704093,93],["ἐὰν",703912,7],["πορευθῶμεν",710667,283],["εἰς",704105,0],["Κεϊλα",707593,9],["εἰς",704105,0],["τὰ",709436,41],["σκῦλα",711902,42],["τῶν",709436,80],["ἀλλοφύλων",700706,169],["εἰσπορευσόμεθα",704124,141]],"And the men of David said to him, Behold, we are afraid here in Judea; and how shall it be if we go to Keila? shall we go after the spoils of the Philistines?"],["4",[["καὶ",707031,7],["προσέθετο",710965,23],["Δαυιδ",703232,4],["ἐρωτῆσαι",705459,106],["ἔτι",705538,28],["διὰ",703417,0],["τοῦ",709436,35],["κυρίου",707996,18],["καὶ",707031,7],["ἀπεκρίθη",701492,37],["αὐτῷ",702165,50],["κύριος",707996,4],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτόν",702165,85],["ἀνάστηθι",701173,176],["καὶ",707031,7],["κατάβηθι",707202,176],["εἰς",704105,0],["Κεϊλα",707593,9],["ὅτι",709803,7],["ἐγὼ",704018,164],["παραδίδωμι",710014,157],["τοὺς",709436,58],["ἀλλοφύλους",700706,60],["εἰς",704105,0],["χεῖράς",713787,39],["σου",711945,133]],"And David enquired yet again of the Lord; and the Lord answered him, and said to him, Arise and go down to Keila, for I will deliver the Philistines into thy hands."],["5",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["Δαυιδ",703232,4],["καὶ",707031,7],["οἱ",709436,136],["ἄνδρες",701150,52],["οἱ",709436,136],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["εἰς",704105,0],["Κεϊλα",707593,9],["καὶ",707031,7],["ἐπολέμησεν",710601,2],["ἐν",704639,0],["τοῖς",709436,147],["ἀλλοφύλοις",700706,230],["καὶ",707031,7],["ἔφυγον",713433,150],["ἐκ",704132,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀπήγαγεν",701324,2],["τὰ",709436,41],["κτήνη",707934,42],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπάταξεν",710185,2],["ἐν",704639,0],["αὐτοῖς",702165,151],["πληγὴν",710527,9],["μεγάλην",708653,36],["καὶ",707031,7],["ἔσωσεν",712627,2],["Δαυιδ",703232,4],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["Κεϊλα",707593,17]],"So David and his men with him went to Keila, and fought with the Philistines; and they fled from before him, and he carried off their cattle, and smote them with a great slaughter, and David rescued the inhabitants of Keila."],["6",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["τῷ",709436,53],["φυγεῖν",713433,106],["Αβιαθαρ",700055,25],["υἱὸν",713075,6],["Αβιμελεχ",700068,18],["πρὸς",710844,0],["Δαυιδ",703232,6],["καὶ",707031,7],["αὐτὸς",702165,121],["μετὰ",708780,0],["Δαυιδ",703232,18],["εἰς",704105,0],["Κεϊλα",707593,9],["κατέβη",707202,2],["ἔχων",705785,72],["εφουδ",705761,25],["ἐν",704639,0],["τῇ",709436,100],["χειρὶ",713787,1],["αὐτοῦ",702165,102]],"And it came to pass when Abiathar the son of Achimelech fled to David, that he went down with David to Keila, having an ephod in his hand."],["7",[["καὶ",707031,7],["ἀπηγγέλη",701321,37],["τῷ",709436,113],["Σαουλ",711499,114],["ὅτι",709803,7],["ἥκει",705956,91],["Δαυιδ",703232,4],["εἰς",704105,0],["Κεϊλα",707593,9],["καὶ",707031,7],["εἶπεν",705373,2],["Σαουλ",711499,4],["πέπρακεν",710480,171],["αὐτὸν",702165,85],["ὁ",709436,3],["θεὸς",706192,4],["εἰς",704105,0],["χεῖράς",713787,39],["μου",709032,133],["ὅτι",709803,7],["ἀποκέκλεισται",701484,187],["εἰσελθὼν",704114,182],["εἰς",704105,0],["πόλιν",710612,9],["θυρῶν",706337,65],["καὶ",707031,7],["μοχλῶν",709040,81]],"And it was told Saul that David was come to Keila: and Saul said, God has sold him into my hands, for he is shut up, having entered into a city that has gates and bars."],["8",[["καὶ",707031,7],["παρήγγειλεν",710004,2],["Σαουλ",711499,4],["παντὶ",710177,30],["τῷ",709436,113],["λαῷ",708094,114],["εἰς",704105,0],["πόλεμον",710605,6],["καταβαίνειν",707202,55],["εἰς",704105,0],["Κεϊλα",707593,9],["συνέχειν",712469,55],["τὸν",709436,5],["Δαυιδ",703232,6],["καὶ",707031,7],["τοὺς",709436,58],["ἄνδρας",701150,57],["αὐτοῦ",702165,102]],"And Saul charged all the people to go down to war to Keila, to besiege David and his men."],["9",[["καὶ",707031,7],["ἔγνω",703105,2],["Δαυιδ",703232,4],["ὅτι",709803,7],["οὐ",709805,28],["παρασιωπᾷ",710102,91],["Σαουλ",711499,4],["περὶ",710285,0],["αὐτοῦ",702165,102],["τὴν",709436,8],["κακίαν",707054,9],["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["πρὸς",710844,0],["Αβιαθαρ",700055,6],["τὸν",709436,5],["ἱερέα",706614,6],["προσάγαγε",710848,176],["τὸ",709436,24],["εφουδ",705761,25],["κυρίου",707996,18]],"And David knew that Saul spoke openly of mischief against him: and David said to Abiathar the priest, Bring the ephod of the Lord."],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["κύριε",707996,153],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ἀκούων",700587,72],["ἀκήκοεν",700587,171],["ὁ",709436,3],["δοῦλός",703817,4],["σου",711945,133],["ὅτι",709803,7],["ζητεῖ",705879,91],["Σαουλ",711499,4],["ἐλθεῖν",705453,106],["ἐπὶ",705080,0],["Κεϊλα",707593,9],["διαφθεῖραι",703624,106],["τὴν",709436,8],["πόλιν",710612,9],["δι᾿",703417,0],["ἐμέ",704555,163]],"And David said, Lord God of Israel, thy servant has indeed heard, that Saul seeks to come against Keila to destroy the city on my account."],["11",[["εἰ",704071,7],["ἀποκλεισθήσεται",701484,134],["καὶ",707031,7],["νῦν",709384,28],["εἰ",704071,7],["καταβήσεται",707202,93],["Σαουλ",711499,4],["καθὼς",707030,28],["ἤκουσεν",700587,2],["ὁ",709436,3],["δοῦλός",703817,4],["σου",711945,133],["κύριε",707996,153],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ἀπάγγειλον",701321,176],["τῷ",709436,113],["δούλῳ",703817,114],["σου",711945,133],["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["ἀποκλεισθήσεται",701484,134]],"Will [the place] be shut up? and now will Saul come down, as thy servant has heard? Lord God of Israel, tell thy servant. And the Lord said, It will be shut up."],["13",[["καὶ",707031,7],["ἀνέστη",701173,2],["Δαυιδ",703232,4],["καὶ",707031,7],["οἱ",709436,136],["ἄνδρες",701150,52],["οἱ",709436,136],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ὡς",714148,7],["τετρακόσιοι",712817,138],["καὶ",707031,7],["ἐξῆλθον",704909,150],["ἐκ",704132,0],["Κεϊλα",707593,17],["καὶ",707031,7],["ἐπορεύοντο",710667,139],["οὗ",709806,28],["ἐὰν",703912,7],["ἐπορεύθησαν",710667,99],["καὶ",707031,7],["τῷ",709436,113],["Σαουλ",711499,114],["ἀπηγγέλη",701321,37],["ὅτι",709803,7],["διασέσωται",703599,187],["Δαυιδ",703232,4],["ἐκ",704132,0],["Κεϊλα",707593,17],["καὶ",707031,7],["ἀνῆκεν",701169,2],["τοῦ",709436,20],["ἐξελθεῖν",704909,106]],"And David arose, and the men with him, in number about four hundred, and they went forth from Keila, and went whithersoever they could go: and it was told Saul that David had escaped from Keila, and he forbore to come."],["14",[["καὶ",707031,7],["ἐκάθισεν",707006,2],["Δαυιδ",703232,4],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["ἐν",704639,0],["Μασερεμ",708547,1],["ἐν",704639,0],["τοῖς",709436,147],["στενοῖς",712068,230],["καὶ",707031,7],["ἐκάθητο",707000,19],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["ἐν",704639,0],["τῷ",709436,53],["ὄρει",709768,54],["Ζιφ",705883,54],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["τῇ",709436,100],["αὐχμώδει",702171,101],["καὶ",707031,7],["ἐζήτει",705879,13],["αὐτὸν",702165,85],["Σαουλ",711499,4],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,17],["καὶ",707031,7],["οὐ",709805,28],["παρέδωκεν",710014,2],["αὐτὸν",702165,85],["κύριος",707996,4],["εἰς",704105,0],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτοῦ",702165,102]],"And he dwelt in Maserem in the wilderness, in the narrow [passes]; and dwelt in the wilderness in mount Ziph, in the dry country. And Saul sought him continually, but the Lord delivered him not into his hands."],["15",[["καὶ",707031,7],["εἶδεν",709725,2],["Δαυιδ",703232,4],["ὅτι",709803,7],["ἐξέρχεται",704909,117],["Σαουλ",711499,4],["τοῦ",709436,20],["ζητεῖν",705879,55],["τὸν",709436,5],["Δαυιδ",703232,6],["καὶ",707031,7],["Δαυιδ",703232,4],["ἐν",704639,0],["τῷ",709436,53],["ὄρει",709768,54],["τῷ",709436,113],["αὐχμώδει",702171,30],["ἐν",704639,0],["τῇ",709436,100],["Καινῇ",707040,1],["Ζιφ",705883,1]],"And David perceived that Saul went forth to seek David; and David was in the dry mountain in the New Ziph."],["16",[["καὶ",707031,7],["ἀνέστη",701173,2],["Ιωναθαν",706927,4],["υἱὸς",713075,4],["Σαουλ",711499,18],["καὶ",707031,7],["ἐπορεύθη",710667,37],["πρὸς",710844,0],["Δαυιδ",703232,6],["εἰς",704105,0],["Καινὴν",707040,9],["καὶ",707031,7],["ἐκραταίωσεν",707875,2],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτοῦ",702165,102],["ἐν",704639,0],["κυρίῳ",707996,114]],"And Jonathan