[["1",[["καὶ",707031,7],["γίνεται",703104,117],["ἡμέρα",705984,12],["καὶ",707031,7],["εἶπεν",705373,2],["Ιωναθαν",706927,4],["υἱὸς",713075,4],["Σαουλ",711499,18],["τῷ",709436,53],["παιδαρίῳ",709923,54],["τῷ",709436,53],["αἴροντι",700473,98],["τὰ",709436,41],["σκεύη",711844,42],["αὐτοῦ",702165,102],["δεῦρο",703382,28],["καὶ",707031,7],["διαβῶμεν",703419,79],["εἰς",704105,0],["μεσσαβ",708774,9],["τῶν",709436,80],["ἀλλοφύλων",700706,81],["τὴν",709436,8],["ἐν",704639,0],["τῷ",709436,113],["πέραν",710280,0],["ἐκείνῳ",704183,50],["καὶ",707031,7],["τῷ",709436,113],["πατρὶ",710189,114],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἀπήγγειλεν",701321,2]],"And when a certain day arrived, Jonathan the son of Saul said to the young man that bore his armour, Come, and let us go over to Messab of the Philistines that is on the other side yonder; but he told not his father."],["2",[["καὶ",707031,7],["Σαουλ",711499,4],["ἐκάθητο",707000,19],["ἐπ᾿",705080,0],["ἄκρου",700608,116],["τοῦ",709436,35],["βουνοῦ",702797,18],["ὑπὸ",713184,0],["τὴν",709436,8],["ῥόαν",711273,9],["τὴν",709436,8],["ἐν",704639,0],["Μαγδων",708334,111],["καὶ",707031,7],["ἦσαν",704093,137],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ὡς",714148,7],["ἑξακόσιοι",704847,138],["ἄνδρες",701150,52]],"And Saul sat on the top of the hill under the pomegranate tree that is in Magdon, and there were with him about six hundred men."],["3",[["καὶ",707031,7],["Αχια",702262,4],["υἱὸς",713075,4],["Αχιτωβ",702297,18],["ἀδελφοῦ",700249,18],["Ιωχαβηδ",706957,18],["υἱοῦ",713075,18],["Φινεες",713510,18],["υἱοῦ",713075,18],["Ηλι",705965,18],["ἱερεὺς",706614,4],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐν",704639,0],["Σηλωμ",711739,111],["αἴρων",700473,72],["εφουδ",705761,25],["καὶ",707031,7],["ὁ",709436,3],["λαὸς",708094,4],["οὐκ",709805,28],["ᾔδει",704074,54],["ὅτι",709803,7],["πεπόρευται",710667,187],["Ιωναθαν",706927,4]],"And Achia son of Achitob, the brother of Jochabed the son of Phinees, the son of Heli, [was] the priest of God in Selom wear