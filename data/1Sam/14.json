,53],["ὄρει",709768,54],["Εφραιμ",705769,18]],"And the battle extended itself to every city in the mount Ephraim."],["24",[["καὶ",707031,7],["Σαουλ",711499,4],["ἠγνόησεν",700175,2],["ἄγνοιαν",700177,9],["μεγάλην",708653,36],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["καὶ",707031,7],["ἀρᾶται",701686,117],["τῷ",709436,113],["λαῷ",708094,114],["λέγων",708124,72],["ἐπικατάρατος",705159,14],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ὃς",709781,213],["φάγεται",713296,93],["ἄρτον",701829,6],["ἕως",705792,0],["ἑσπέρας",705500,17],["καὶ",707031,7],["ἐκδικήσω",704174,165],["τὸν",709436,5],["ἐχθρόν",705779,6],["μου",709032,133],["καὶ",707031,7],["οὐκ",709805,28],["ἐγεύσατο",703074,23],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["ἄρτου",701829,18]],"And Saul committed a great trespass of ignorance in that day, and he lays a curse on the people, saying, Cursed [is] the man who shall eat bread before the evening; so I will avenge myself on my enemy: and none of the people tasted bread, though all the land was dining."],["25",[["καὶ",707031,7],["πᾶσα",710177,29],["ἡ",709436,10],["γῆ",703083,12],["ἠρίστα",701747,171],["καὶ",707031,7],["ιααρ",706361,120],["δρυμὸς",703836,4],["ἦν",704093,13],["μελισσῶνος",708703,18],["κατὰ",707200,0],["πρόσωπον",710986,25],["τοῦ",709436,35],["ἀγροῦ",700196,18]],"And Jaal was a wood abounding in swarms of bees on the face of the ground."],["26",[["καὶ",707031,7],["εἰσῆλθεν",704114,2],["ὁ",709436,3],["λαὸς",708094,4],["εἰς",704105,0],["τὸν",709436,5],["μελισσῶνα",708703,6],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἐπορεύετο",710667,19],["λαλῶν",708071,72],["καὶ",707031,7],["ἰδοὺ",706497,88],["οὐκ",709805,28],["ἦν",704093,13],["ἐπιστρέφων",705278,72],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὸ",709436,24],["στόμα",712125,25],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ἐφοβήθη",713532,37],["ὁ",709436,3],["λαὸς",708094,4],["τὸν",709436,5],["ὅρκον",709753,6],["κυρίου",707996,18]],"And the people went into the place of the bees, and, behold, they continued speaking; and, behold, there was none that put his hand to his mouth, for the people feared the oath of the Lord."],["27",[["καὶ",707031,7],["Ιωναθαν",706927,4],["οὐκ",709805,28],["ἀκηκόει",700587,171],["ἐν",704639,0],["τῷ",709436,53],["ὁρκίζειν",709751,55],["τὸν",709436,5],["πατέρα",710189,6],["αὐτοῦ",702165,102],["τὸν",709436,5],["λαόν",708094,6],["καὶ",707031,7],["ἐξέτεινεν",704322,2],["τὸ",709436,24],["ἄκρον",700608,46],["τοῦ",709436,20],["σκήπτρου",711851,21],["αὐτοῦ",702165,102],["τοῦ",709436,20],["ἐν",704639,0],["τῇ",709436,100],["χειρὶ",713787,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔβαψεν",702517,2],["αὐτὸ",702165,129],["εἰς",704105,0],["τὸ",709436,24],["κηρίον",707657,25],["τοῦ",709436,20],["μέλιτος",708700,21],["καὶ",707031,7],["ἐπέστρεψεν",705278,2],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὸ",709436,24],["στόμα",712125,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀνέβλεψαν",700913,150],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["αὐτοῦ",702165,102]],"And Jonathan had not heard when his father adjured the people; and he reached forth the end of the staff that was in his hand, and dipped it into the honeycomb, and returned his hand to his mouth, and his eyes recovered their sight."],["28",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["εἷς",704106,14],["ἐκ",704132,0],["τοῦ",709436,35],["λαοῦ",708094,18],["καὶ",707031,7],["εἶπεν",705373,2],["ὁρκίσας",709751,182],["ὥρκισεν",709751,2],["ὁ",709436,3],["πατήρ",710189,4],["σου",711945,133],["τὸν",709436,5],["λαὸν",708094,6],["λέγων",708124,72],["ἐπικατάρατος",705159,14],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ὃς",709781,213],["φάγεται",713296,93],["ἄρτον",701829,6],["σήμερον",711751,28],["καὶ",707031,7],["ἐξελύθη",704254,37],["ὁ",709436,3],["λαός",708094,4]],"And one of the people answered and said, Thy father solemnly adjured the people, saying, Cursed [is] the man who shall eat bread to-day. And the people were very faint,"],["29",[["καὶ",707031,7],["ἔγνω",703105,2],["Ιωναθαν",706927,4],["καὶ",707031,7],["εἶπεν",705373,2],["ἀπήλλαχεν",701333,171],["ὁ",709436,3],["πατήρ",710189,4],["μου",709032,133],["τὴν",709436,8],["γῆν",703083,9],["ἰδὲ",709725,176],["δὴ",703395,11],["ὅτι",709803,7],["εἶδον",709725,150],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["μου",709032,133],["ὅτι",709803,7],["ἐγευσάμην",703074,161],["βραχὺ",702809,46],["τοῦ",709436,20],["μέλιτος",708700,21],["τούτου",709858,49]],"and Jonathan knew it, and said, My father has destroyed the land: see how my eyes have received sight [now] that I have tasted a little of this honey."],["30",[["ἀλλ᾿",700680,7],["ὅτι",709803,7],["εἰ",704071,11],["ἔφαγεν",713296,2],["ἔσθων",705495,72],["ὁ",709436,3],["λαὸς",708094,4],["σήμερον",711751,28],["τῶν",709436,43],["σκύλων",711902,44],["τῶν",709436,80],["ἐχθρῶν",705779,81],["αὐτῶν",702165,40],["ὧν",709781,252],["εὗρεν",705676,2],["ὅτι",709803,7],["νῦν",709384,28],["ἂν",700900,11],["μείζων",708682,14],["ἦν",704093,13],["ἡ",709436,10],["πληγὴ",710527,12],["ἐν",704639,0],["τοῖς",709436,147],["ἀλλοφύλοις",700706,148]],"Surely if the people had this day eaten freely of the spoils of their enemies which they found, the slaughter among the Philistines would have been greater."],["31",[["καὶ",707031,7],["ἐπάταξεν",710185,2],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἐκ",704132,0],["τῶν",709436,80],["ἀλλοφύλων",700706,81],["ἐν",704639,0],["Μαχεμας",708599,111],["καὶ",707031,7],["ἐκοπίασεν",707824,2],["ὁ",709436,3],["λαὸς",708094,4],["σφόδρα",712586,28]],"And on that day he smote some of the Philistines in Machmas; and the people were very weary."],["32",[["καὶ",707031,7],["ἐκλίθη",707738,37],["ὁ",709436,3],["λαὸς",708094,4],["εἰς",704105,0],["τὰ",709436,41],["σκῦλα",711902,42],["καὶ",707031,7],["ἔλαβεν",708076,2],["ὁ",709436,3],["λαὸς",708094,4],["ποίμνια",710598,42],["καὶ",707031,7],["βουκόλια",702786,42],["καὶ",707031,7],["τέκνα",712761,42],["βοῶν",702798,81],["