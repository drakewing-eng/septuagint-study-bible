[["1",[["καὶ",707031,7],["ἐγενήθη",703104,37],["ὡς",714148,7],["μετὰ",708780,0],["μῆνα",708874,6],["καὶ",707031,7],["ἀνέβη",700905,2],["Ναας",709126,4],["ὁ",709436,3],["Αμμανίτης",700839,4],["καὶ",707031,7],["παρεμβάλλει",710132,91],["ἐπὶ",705080,0],["Ιαβις",706366,227],["Γαλααδ",702920,227],["καὶ",707031,7],["εἶπον",705373,150],["πάντες",710177,138],["οἱ",709436,136],["ἄνδρες",701150,52],["Ιαβις",706366,118],["πρὸς",710844,0],["Ναας",709126,6],["τὸν",709436,5],["Αμμανίτην",700838,6],["διάθου",703609,300],["ἡμῖν",705994,90],["διαθήκην",703456,9],["καὶ",707031,7],["δουλεύσομέν",703814,275],["σοι",711925,159]],"And it came to pass about a month after this, that Naas the Ammanite went up, and encamped against Jabis Galaad: and all the men of Jabis said to Naas the Ammanite, Make a covenant with us, and we will serve thee."],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτοὺς",702165,62],["Ναας",709126,4],["ὁ",709436,3],["Αμμανίτης",700839,4],["ἐν",704639,0],["ταύτῃ",709858,105],["διαθήσομαι",703609,181],["ὑμῖν",713084,90],["διαθήκην",703456,9],["ἐν",704639,0],["τῷ",709436,53],["ἐξορύξαι",704967,106],["ὑμῶν",713091,145],["πάντα",710177,27],["ὀφθαλμὸν",709870,6],["δεξιόν",703360,27],["καὶ",707031,7],["θήσομαι",712849,181],["ὄνειδος",709658,25],["ἐπὶ",705080,0],["Ισραηλ",706839,6]],"And Naas the Ammanite said to them, On these terms will I make a covenant with you, that I should put out all your right eyes, and I will lay a reproach upon Israel."],["3",[["καὶ",707031,7],["λέγουσιν",708124,197],["αὐτῷ",702165,50],["οἱ",709436,136],["ἄνδρες",701150,52],["Ιαβις",706366,118],["ἄνες",701169,176],["ἡμῖν",705994,90],["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["καὶ",707031,7],["ἀποστελοῦμεν",701592,275],["ἀγγέλους",700140,57],["εἰς",704105,0],["πᾶν",710177,46],["ὅριον",709749,25],["Ισραηλ",706839,18],["ἐὰν",703912,7],["μὴ",708851,28],["ᾖ",704093,204],["ὁ",709436,3],["σῴζων",712627,72],["ἡμᾶς",705981,194],["ἐξελευσόμεθα",704909,141],["πρὸς",710844,0],["ὑμᾶς",713080,194]],"And the men of Jabis say to him, Allow us seven days, and we will send messengers into all the coasts of Israel: if there should be no one to deliver us, we will come out to you."],["4",[["καὶ",707031,7],["ἔρχονται",705453,269],["οἱ",709436,136],["ἄγγελοι",700140,52],["εἰς",704105,0],["Γαβαα",702849,227],["πρὸς",710844,0],["Σαουλ",711499,6],["καὶ",707031,7],["λαλοῦσιν",708071,197],["τοὺς",709436,58],["λόγους",708236,57],["εἰς",704105,0],["τὰ",709436,41],["ὦτα",709852,42],["τοῦ",709436,35],["λαοῦ",708094,18],["καὶ",707031,7],["ἦραν",700473,150],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["τὴν",709436,8],["φωνὴν",713640,9],["αὐτῶν",702165,40],["καὶ",707031,7],["ἔκλαυσαν",707703,150]],"And the messengers came to Gabaa to Saul, and they speak the words into the ears of the people; and all the people lifted up their voice, and wept."],["5",[["καὶ",707031,7],["ἰδοὺ",706497,88],["Σαουλ",711499,4],["ἤρχετο",705453,19],["μετὰ",708780,0],["τὸ",709436,24],["πρωὶ",711021,28],["ἐξ",704132,0],["ἀγροῦ",700196,18],["καὶ",707031,7],["εἶπεν",705373,2],["Σαουλ",711499,4],["τί",712867,126],["ὅτι",709803,7],["κλαίει",707703,91],["ὁ",709436,3],["λαός",708094,4],["καὶ",707031,7],["διηγοῦνται",703679,269],["αὐτῷ",702165,50],["τὰ",709436,41],["ῥήματα",711246,42],["τῶν",709436,80],["υἱῶν",713075,81],["Ιαβις",706366,18]],"And, behold, Saul came after the early morning out of the field: and Saul said, Why does the people weep? and they tell him the words of the men of Jabis."],["6",[["καὶ",707031,7],["ἐφήλατο",705741,23],["πνεῦμα",710566,15],["κυρίου",707996,18],["ἐπὶ",705080,0],["Σαουλ",711499,6],["ὡς",714148,7],["ἤκουσεν",700587,2],["τὰ",709436,41],["ῥήματα",711246,42],["ταῦτα",709858,71],["καὶ",707031,7],["ἐθυμώθη",706335,37],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["ὀργὴ",709728,12],["αὐτοῦ",702165,102],["σφόδρα",712586,28]],"And the Spirit of the Lord came upon Saul when he heard these words, and his anger was greatly kindled against them."],["7",[["καὶ",707031,7],["ἔλαβεν",708076,2],["δύο",703849,59],["βόας",702798,57],["καὶ",707031,7],["ἐμέλισεν",708701,2],["αὐτὰς",702165,231],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["εἰς",704105,0],["πᾶν",710177,46],["ὅριον",709749,25],["Ισραηλ",706839,18],["ἐν",704639,0],["χειρὶ",713787,1],["ἀγγέλων",700140,81],["λέγων",708124,72],["ὃς",709781,213],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐκπορευόμενος",704293,122],["ὀπίσω",709697,0],["Σαουλ",711499,18],["καὶ",707031,7],["ὀπίσω",709697,0],["Σαμουηλ",711473,18],["κατὰ",707200,0],["τάδε",709446,71],["ποιήσουσιν",710582,218],["τοῖς",709436,147],["βουσὶν",702798,148],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπῆλθεν",705068,2],["ἔκστασις",704314,12],["κυρίου",707996,18],["ἐπὶ",705080,0],["τὸν",709436,5],["λαὸν",708094,6],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐβόησαν",702743,150],["ὡς",714148,7],["ἀνὴρ",701150,4],["εἷς",704106,14]],"And he took two cows, and cut them in pieces, and sent them into all the coasts of Israel by the hand of messengers, saying, Whoso comes not forth after Saul and after Samuel, so shall they do to his oxen: and a transport from the Lord came upon the people of Israel, and they came out to battle as one man."],["8",[["καὶ",707031,7],["ἐπισκέπτεται",705250,117],["αὐτοὺς",702165,62],["Αβιεζεκ",700062,4],["ἐν",704639,0],["Βαμα",702493,1],["πᾶν",710177,26],["ἄνδρα",701150,6],["Ισραηλ",706839,18],["ἑξακοσίας",704847,119],["χιλιάδας",713858,39],["καὶ",707031,7],["ἄνδρας",701150,57],["Ιουδα",706768,18],["ἑβδομήκοντα",703922,59],["χιλιάδας",713858,39]],"And he reviews them at Bezec in Bama, every man of Israel six hundred thousand, and the men of Juda seventy thousand."],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["τοῖς",709436,147],["ἀγγέλοις",700140,148],["τοῖς",709436,147],["ἐρχομένοις",705453,341],["τάδε",709446,572],["ἐρεῖτε",705415,337],["τοῖς",709436,147],["ἀνδράσιν",701150,148],["Ιαβις",706366,118],["αὔριον",702149,28],["ὑμῖν",713084,90],["ἡ",709436,10],["σωτηρία",712658,12],["διαθερμάναντος",703454,500],["τοῦ",709436,35],["ἡλίου",705974,18],["καὶ",707031,7],["ἦλθον",705453,150],["οἱ",709436,136],["ἄγγελοι",700140,52],["εἰς",704105,0],["τὴν",709436,8],["πόλιν",710612,9],["καὶ",707031,7],["ἀπαγγέλλουσιν",701321,197],["τοῖς",709436,147],["ἀνδράσιν",701150,148],["Ιαβις",706366,118],["καὶ",707031,7],["εὐφράνθησαν",705715,99]],"And he said to the messengers that came, Thus shall ye say to the men of Jabis, To-morrow ye shall have deliverance when the sun is hot; and the messengers came to the city, and told the men of Jabis, and they rejoiced."],["10",[["καὶ",707031,7],["εἶπαν",705373,150],["οἱ",709436,136],["ἄνδρες",701150,52],["Ιαβις",706366,118],["πρὸς",710844,0],["Ναας",709126,227],["τὸν",709436,5],["Αμμανίτην",700839,6],["αὔριον",702149,28],["ἐξελευσόμεθα",704909,141],["πρὸς",710844,0],["ὑμᾶς",713080,194],["καὶ",707031,7],["ποιήσετε",710582,337],["ἡμῖν",705994,90],["τὸ",709436,24],["ἀγαθὸν",700106,46],["ἐνώπιον",704823,0],["ὑμῶν",713091,145]],"And the men of Jabis said to Naas the Ammanite, To-morrow we will come forth to you, and ye shall do to us what seems good in your sight."],["11",[["καὶ",707031,7],["ἐγενήθη",703104,37],["μετὰ",708780,0],["τὴν",709436,8],["αὔριον",702149,28],["καὶ",707031,7],["ἔθετο",712849,23],["Σαουλ",711499,4],["τὸν",709436,5],["λαὸν",708094,6],["εἰς",704105,0],["τρεῖς",712927,119],["ἀρχάς",701836,39],["καὶ",707031,7],["εἰσπορεύονται",704124,269],["μέσον",708768,46],["τῆς",709436,16],["παρεμβολῆς",710133,17],["ἐν",704639,0],["φυλακῇ",713613,1],["τῇ",709436,100],["πρωινῇ",711024,101],["καὶ",707031,7],["ἔτυπτον",713022,137],["τοὺς",709436,58],["υἱοὺς",713075,57],["Αμμων",700847,18],["ἕως",705792,0],["διεθερμάνθη",703454,37],["ἡ",709436,10],["ἡμέρα",705984,12],["καὶ",707031,7],["ἐγενήθησαν",703104,99],["οἱ",709436,136],["ὑπολελειμμένοι",713212,429],["διεσπάρησαν",703584,99],["καὶ",707031,7],["οὐχ",709805,28],["ὑπελείφθησαν",713212,99],["ἐν",704639,0],["αὐτοῖς",702165,151],["δύο",703849,59],["κατὰ",707200,0],["τὸ",709436,24],["αὐτό",702165,129]],"And it came to pass on the morrow, that Saul divided the people into three companies, and they go into the midst of the camp in the morning watch, and they smote the children of Ammon until the day was hot; and it came to pass that those who were left were scattered, and there were not left among them two together."],["12",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["λαὸς",708094,4],["πρὸς",710844,0],["Σαμουηλ",711473,6],["τίς",712867,126],["ὁ",709436,3],["εἴπας",705373,162],["ὅτι",709803,7],["Σαουλ",711499,4],["οὐ",709805,28],["βασιλεύσει",702581,127],["ἡμῶν",705999,145],["παράδος",710014,176],["τοὺς",709436,58],["ἄνδρας",701150,57],["καὶ",707031,7],["θανατώσομεν",706097,275],["αὐτούς",702165,62]],"And the people said to Samuel, Who has said that Saul shall not reign over us? Give up the men, and we will put them to death."],["13",[["καὶ",707031,7],["εἶπεν",705373,2],["Σαουλ",711499,4],["οὐκ",709805,28],["ἀποθανεῖται",701461,93],["οὐδεὶς",709817,14],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ταύτῃ",709858,105],["ὅτι",709803,7],["σήμερον",711751,28],["κύριος",707996,4],["ἐποίησεν",710582,2],["σωτηρίαν",712658,9],["ἐν",704639,0],["Ισραηλ",706839,114]],"And Saul said, No man shall die this day, for to-day the Lord has wrought deliverance in Israel."],["14",[["καὶ",707031,7],["εἶπεν",705373,2],["Σαμουηλ",711473,4],["πρὸς",710844,0],["τὸν",709436,5],["λαὸν",708094,6],["λέγων",708124,72],["πορευθῶμεν",710667,233],["εἰς",704105,0],["Γαλγαλα",702933,9],["καὶ",707031,7],["ἐγκαινίσωμεν",703956,79],["ἐκεῖ",704181,28],["τὴν",709436,8],["βασιλείαν",702577,9]],"And Samuel spoke to the people, saying, Let us go to Galgala, and there renew the kingdom."],["15",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["εἰς",704105,0],["Γαλγαλα",702933,9],["καὶ",707031,7],["ἔχρισεν",713965,2],["Σαμουηλ",711473,4],["ἐκεῖ",704181,28],["τὸν",709436,5],["Σαουλ",711499,6],["εἰς",704105,0],["βασιλέα",702580,6],["ἐνώπιον",704823,0],["κυρίου",707996,18],["ἐν",704639,0],["Γαλγαλοις",702933,76],["καὶ",707031,7],["ἔθυσεν",706349,2],["ἐκεῖ",704181,28],["θυσίας",706345,39],["καὶ",707031,7],["εἰρηνικὰς",704099,119],["ἐνώπιον",704823,0],["κυρίου",707996,18],["καὶ",707031,7],["εὐφράνθη",705715,37],["Σαμουηλ",711473,4],["καὶ",707031,7],["πᾶς",710177,14],["Ισραηλ",706839,4],["ὥστε",714164,7],["λίαν",708184,28]],"And all the people went to Galgala, and Samuel anointed Saul there to be king before the Lord in Galgala, and there he offered meat-offerings and peace-offerings before the Lord: and Samuel and all Israel rejoiced exceedingly."]]