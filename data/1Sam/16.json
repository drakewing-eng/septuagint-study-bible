[["1",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Σαμουηλ",711473,6],["ἕως",705792,7],["πότε",710696,11],["σὺ",712181,164],["πενθεῖς",710251,154],["ἐπὶ",705080,0],["Σαουλ",711499,6],["κἀγὼ",706969,288],["ἐξουδένωκα",704969,89],["αὐτὸν",702165,85],["μὴ",708851,28],["βασιλεύειν",702581,55],["ἐπὶ",705080,0],["Ισραηλ",706839,114],["πλῆσον",710532,176],["τὸ",709436,24],["κέρας",707625,25],["σου",711945,133],["ἐλαίου",704380,21],["καὶ",707031,7],["δεῦρο",703382,28],["ἀποστείλω",701592,207],["σε",711598,163],["πρὸς",710844,0],["Ιεσσαι",706668,6],["ἕως",705792,0],["εἰς",704105,0],["Βηθλεεμ",702688,227],["ὅτι",709803,7],["ἑόρακα",709725,89],["ἐν",704639,0],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτοῦ",702165,102],["ἐμοὶ",704577,159],["βασιλεύειν",702581,55]],"And the Lord said to Samuel, How long dost thou mourn for Saul, whereas I have rejected him from reigning over Israel? Fill thy horn with oil, and come, I will send thee to Jessæ, to Bethleem; for I have seen among his sons a king for me."],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["Σαμουηλ",711473,4],["πῶς",711121,28],["πορευθῶ",710667,321],["καὶ",707031,7],["ἀκούσεται",700587,93],["Σαουλ",711499,4],["καὶ",707031,7],["ἀποκτενεῖ",701498,127],["με",708618,163],["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["δάμαλιν",703271,9],["βοῶν",702798,81],["λαβὲ",708076,176],["ἐν",704639,0],["τῇ",709436,100],["χειρί",713787,1],["σου",711945,133],["καὶ",707031,7],["ἐρεῖς",705415,166],["θῦσαι",706349,106],["τῷ",709436,113],["κυρίῳ",707996,114],["ἥκω",705956,157]],"And Samuel said, How can I go? whereas Saul will hear of it, and slay me: and the Lord said, Take a heifer in thine hand and thou shalt say, I am come to sacrifice to the Lord."],["3",[["καὶ",707031,7],["καλέσεις",707084,166],["τὸν",709436,5],["Ιεσσαι",706668,6],["εἰς",704105,0],["τὴν",709436,8],["θυσίαν",706345,9],["καὶ",707031,7],["γνωριῶ",703135,165],["σοι",711925,159],["ἃ",709781,69],["ποιήσεις",710582,166],["καὶ",707031,7],["χρίσεις",713965,166],["ὃν",709781,112],["ἐὰν",703912,7],["εἴπω",705373,207],["πρὸς",710844,0],["σέ",711598,163]],"And thou shalt call Jessæ to the sacrifice, and I will make known to thee what thou shalt do; and thou shalt anoint him whom I shall mention to thee."],["4",[["καὶ",707031,7],["ἐποίησεν",710582,2],["Σαμουηλ",711473,4],["πάντα",710177,68],["ἃ",709781,69],["ἐλάλησεν",708071,2],["αὐτῷ",702165,50],["κύριος",707996,4],["καὶ",707031,7],["ἦλθεν",705453,2],["εἰς",704105,0],["Βηθλεεμ",702688,6],["καὶ",707031,7],["ἐξέστησαν",704940,150],["οἱ",709436,136],["πρεσβύτεροι",710735,52],["τῆς",709436,16],["πόλεως",710612,17],["τῇ",709436,100],["ἀπαντήσει",701348,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπαν",705373,150],["εἰρήνη",704098,12],["ἡ",709436,10],["εἴσοδός",704119,12],["σου",711945,133],["ὁ",709436,3],["βλέπων",702740,72]],"And Samuel did all that the Lord told him; and he came to Bethleem: and the elders of the city were amazed at meeting him, and said, Dost thou come peaceably, thou Seer?"],["5",[["καὶ",707031,7],["εἶπεν",705373,2],["εἰρήνη",704098,12],["θῦσαι",706349,106],["τῷ",709436,113],["κυρίῳ",707996,114],["ἥκω",705956,157],["ἁγιάσθητε",700153,394],["καὶ",707031,7],["εὐφράνθητε",705715,372],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["σήμερον",711751,28],["καὶ",707031,7],["ἡγίασεν",700153,2],["τὸν",709436,5],["Ιεσσαι",706668,4],["καὶ",707031,7],["τοὺς",709436,58],["υἱοὺς",713075,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐκάλεσεν",707084,2],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὴν",709436,8],["θυσίαν",706345,9]],"And he said, Peaceably: I am come to sacrifice to the Lord. Sanctify yourselves, and rejoice with me this day: and he sanctified Jessæ and his sons, and he called them to the sacrifice."],["6",[["καὶ",707031,7],["ἐγενήθη",703104,37],["ἐν",704639,0],["τῷ",709436,113],["αὐτοὺς",702165,62],["εἰσιέναι",704113,55],["καὶ",707031,7],["εἶδεν",709725,2],["τὸν",709436,5],["Ελιαβ",704446,6],["καὶ",707031,7],["εἶπεν",705373,2],["ἀλλὰ",700680,7],["καὶ",707031,7],["ἐνώπιον",704823,0],["κυρίου",707996,18],["χριστὸς",713964,14],["αὐτοῦ",702165,102]],"And it came to pass when they came in, that he saw Eliab, and said, Surely the Lord's anointed [is] before him."],["7",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Σαμουηλ",711473,6],["μὴ",708851,28],["ἐπιβλέψῃς",705088,175],["ἐπὶ",705080,0],["τὴν",709436,8],["ὄψιν",709901,9],["αὐτοῦ",702165,102],["μηδὲ",708855,7],["εἰς",704105,0],["τὴν",709436,8],["ἕξιν",704937,9],["μεγέθους",708656,21],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ἐξουδένωκα",704969,89],["αὐτόν",702165,85],["ὅτι",709803,7],["οὐχ",709805,28],["ὡς",714148,7],["ἐμβλέψεται",704551,93],["ἄνθρωπος",701163,4],["ὄψεται",709725,93],["ὁ",709436,3],["θεός",706192,4],["ὅτι",709803,7],["ἄνθρωπος",701163,4],["ὄψεται",709725,93],["εἰς",704105,0],["πρόσωπον",710986,25],["ὁ",709436,3],["δὲ",703303,11],["θεὸς",706192,4],["ὄψεται",709725,93],["εἰς",704105,0],["καρδίαν",707141,9]],"But the Lord said to Samuel, Look not on his appearance, nor on his stature, for I have rejected him; for God sees not as a man looks; for man looks at the outward appearance, but God looks at the heart."],["8",[["καὶ",707031,7],["ἐκάλεσεν",707084,2],["Ιεσσαι",706668,4],["τὸν",709436,5],["Αμιναδαβ",700824,6],["καὶ",707031,7],["παρῆλθεν",710141,2],["κατὰ",707200,0],["πρόσωπον",710986,25],["Σαμουηλ",711473,18],["καὶ",707031,7],["εἶπεν",705373,2],["οὐδὲ",709816,7],["τοῦτον",709858,85],["ἐξελέξατο",704236,23],["κύριος",707996,4]],"And Jessæ called Aminadab, and he passed before Samuel: and he said, Neither has God chosen this one."],["9",[["καὶ",707031,7],["παρήγαγεν",710007,2],["Ιεσσαι",706668,4],["τὸν",709436,5],["Σαμα",711433,6],["καὶ",707031,7],["εἶπεν",705373,2],["καὶ",707031,28],["ἐν",704639,0],["τούτῳ",709858,50],["οὐκ",709805,28],["ἐξελέξατο",704236,23],["κύριος",707996,4]],"And Jessæ caused Sama to pass by: and he said, Neither has God chosen this one."],["10",[["καὶ",707031,7],["παρήγαγεν",710007,2],["Ιεσσαι",7