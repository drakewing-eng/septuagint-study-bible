06096,114],["ἀποθάνω",701461,207]],"And if indeed I continue to live, then shalt thou deal mercifully with me; and if I indeed die,"],["15",[["οὐκ",709805,28],["ἐξαρεῖς",704839,166],["ἔλεός",704426,4],["σου",711945,133],["ἀπὸ",701425,0],["τοῦ",709436,35],["οἴκου",709516,18],["μου",709032,133],["ἕως",705792,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["καὶ",707031,7],["εἰ",704071,7],["μὴ",708851,28],["ἐν",704639,0],["τῷ",709436,53],["ἐξαίρειν",704839,55],["κύριον",707996,6],["τοὺς",709436,58],["ἐχθροὺς",705779,57],["Δαυιδ",703232,18],["ἕκαστον",704133,27],["ἀπὸ",701425,0],["προσώπου",710986,21],["τῆς",709436,16],["γῆς",703083,17]],"thou shalt not withdraw thy mercy from my house for ever: and if thou doest not, when the Lord cuts off the enemies of David each from the face of the earth,"],["16",[["ἐξαρθῆναι",704839,179],["τὸ",709436,24],["ὄνομα",709666,25],["τοῦ",709436,35],["Ιωναθαν",706927,18],["ἀπὸ",701425,0],["τοῦ",709436,35],["οἴκου",709516,18],["Δαυιδ",703232,18],["καὶ",707031,7],["ἐκζητήσαι",704187,106],["κύριος",707996,4],["ἐχθροὺς",705779,57],["τοῦ",709436,35],["Δαυιδ",703232,18]],"[should it happen] that the name of Jonathan be discovered by the house of David, then let the Lord seek out the enemies of David."],["17",[["καὶ",707031,7],["προσέθετο",710965,23],["ἔτι",705538,28],["Ιωναθαν",706927,4],["ὀμόσαι",709620,106],["τῷ",709436,113],["Δαυιδ",703232,114],["ὅτι",709803,7],["ἠγάπησεν",700120,2],["ψυχὴν",714070,9],["ἀγαπῶντος",700120,152],["αὐτόν",702165,85]],"And Jonathan swore yet again to David, because he loved the soul of him that loved him."],["18",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιωναθαν",706927,4],["αὔριον",702149,28],["νουμηνία",709371,12],["καὶ",707031,7],["ἐπισκεπήσῃ",705250,166],["ὅτι",709803,7],["ἐπισκεπήσεται",705250,134],["καθέδρα",706992,12],["σου",711945,133]],"And Jonathan said, To-morrow [is] the new moon, and thou wilt be enquired for, because thy seat will be observed as vacant."],["19",[["καὶ",707031,7],["τρισσεύσεις",712959,166],["