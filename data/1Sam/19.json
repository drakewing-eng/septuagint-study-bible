,["ταῖς",709436,75],["χερσὶν",713787,76],["αὐτοῦ",702165,102]],"And an evil spirit from God was upon Saul, and he was resting in his house, and a spear [was] in his hand, and David was playing on the harp with his hands."],["10",[["καὶ",707031,7],["ἐζήτει",705879,13],["Σαουλ",711499,4],["πατάξαι",710185,106],["τὸ",709436,24],["δόρυ",703804,25],["εἰς",704105,0],["Δαυιδ",703232,6],["καὶ",707031,7],["ἀπέστη",702214,2],["Δαυιδ",703232,4],["ἐκ",704132,0],["προσώπου",710986,21],["Σαουλ",711499,18],["καὶ",707031,7],["ἐπάταξεν",710185,2],["τὸ",709436,24],["δόρυ",703804,25],["εἰς",704105,0],["τὸν",709436,5],["τοῖχον",712879,6],["καὶ",707031,7],["Δαυιδ",703232,4],["ἀνεχώρησεν",701092,2],["καὶ",707031,7],["διεσώθη",703599,37]],"And Saul sought to smite David with the spear; and David withdrew [suddenly] from the presence of Saul; and he drove the spear into the wall; and David retreated and escaped."],["11",[["καὶ",707031,7],["ἐγενήθη",703104,37],["ἐν",704639,0],["τῇ",709436,100],["νυκτὶ",709386,1],["ἐκείνῃ",704183,105],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Σαουλ",711499,4],["ἀγγέλους",700140,57],["εἰς",704105,0],["οἶκον",709516,6],["Δαυιδ",703232,18],["φυλάξαι",713619,106],["αὐτὸν",702165,85],["τοῦ",709436,20],["θανατῶσαι",706097,106],["αὐτὸν",702165,85],["πρωί",711021,28],["καὶ",707031,7],["ἀπήγγειλεν",701321,2],["τῷ",709436,113],["Δαυιδ",703232,114],["Μελχολ",708719,12],["ἡ",709436,10],["γυνὴ",703209,12],["αὐτοῦ",702165,102],["λέγουσα",708124,188],["ἐὰν",703912,7],["μὴ",708851,28],["σὺ",712181,164],["σώσῃς",712627,175],["τὴν",709436,8],["ψυχὴν",714070,9],["σαυτοῦ",711599,102],["τὴν",709436,8],["νύκτα",709386,9],["ταύτην",709858,104],["αὔριον",702149,28],["θανατωθήσῃ",706097,364]],"And it came to pass in that night, that Saul sent messengers to the house of David to watch him, in order to slay him in the morning; and Melchol David's wife told him, saying, Unless thou save thy life this night, to-morrow thou shalt be slain."],["12",[["καὶ",707031,7],["κατάγει",707232,91],["ἡ",709436,10],["Μελχολ",708719,12],["τὸν",709436,5],["Δαυιδ",703232,6],["διὰ",703417,0],["τῆς",709436,16],["θυρίδος",706340,17],["καὶ",707031,7],["ἀπῆλθεν",701398,2],["καὶ",707031,7],["ἔφυγεν",713433,2],["καὶ",707031,7],["σῴζεται",712627,117]],"So Melchol lets David down by the window, and he departed, and fled, and escaped."],["13",[["καὶ",707031,7],["ἔλαβεν",708076,2],["ἡ",709436,10],["Μελχολ",708719,12],["τὰ",709436,41],["κενοτάφια",707613,42],["καὶ",707031,7],["ἔθετο",712849,23],["ἐπὶ",705080,0],["τὴν",709436,8],["κλίνην",707737,9],["καὶ",707031,7],["ἧπαρ",706012,15],["τῶν",709436,80],["αἰγῶν",700464,81],["ἔθετο",712849,23],["πρὸς",710844,0],["κεφαλῆς",707639,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐκάλυψεν",707102,2],["αὐτὰ",702165,71],["ἱματίῳ",706742,54]],"And Melchol took images, and laid them on the bed, and she put the liver of a goat by his head, and covered them with clothes."],["14",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Σαουλ",711499,4],["ἀγγέλους",700140,57],["λαβεῖν",708076,106],["τὸν",709436,5],["Δαυιδ",703232,6],["καὶ",707031,7],["λέγουσιν",708124,197],["ἐνοχλεῖσθαι",704780,109],["αὐτόν",702165,85]],"And Saul sent messengers to take David; and they say that he is sick."],["15",[["καὶ",707031,7],["ἀποστέλλει",701592,91],["ἐπὶ",705080,0],["τὸν",709436,5],["Δαυιδ",703232,6],["λέγων",708124,72],["ἀγάγετε",700209,171],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["τῆς",709436,16],["κλίνης",707737,17],["πρός",710844,0],["με",708618,163],["τοῦ",709436,20],["θανατῶσαι",706097,106],["αὐτόν",702165,85]],"And he sends to David, saying, Bring him to me on the bed, that I may slay him."],["16",[["καὶ",707031,7],["ἔρχονται",705453,269],["οἱ",709436,136],["ἄγγελοι",700140,52],["καὶ",707031,7],["ἰδοὺ",706497,88],["τὰ",709436,41],["κενοτάφια",707613,42],["ἐπὶ",705080,0],["τῆς",709436,16],["κλίνης",707737,17],["καὶ",707031,7],["ἧπαρ",706012,15],["τῶν",709436,80],["αἰγῶν",700464,81],["πρὸς",710844,0],["κεφαλῆς",707639,17],["αὐτοῦ",702165,102]],"And the messengers