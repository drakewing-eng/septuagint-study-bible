,709803,7],["κείρουσίν",707597,197],["σοι",711925,159],["νῦν",709384,28],["οἱ",709436,136],["ποιμένες",710596,52],["σου",711945,133],["οἳ",709781,250],["ἦσαν",704093,137],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["καὶ",707031,7],["οὐκ",709805,28],["ἀπεκωλύσαμεν",701501,289],["αὐτοὺς",702165,62],["καὶ",707031,7],["οὐκ",709805,28],["ἐνετειλάμεθα",704791,316],["αὐτοῖς",702165,151],["οὐθὲν",709817,46],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["ὄντων",704093,170],["αὐτῶν",702165,40],["ἐν",704639,0],["Καρμήλῳ",707161,111]],"And now, behold, I have heard that thy shepherds who were with us in the wilderness are shearing thy sheep, and we hindered them not, neither did we demand any thing from them all the time they were in Carmel."],["8",[["ἐρώτησον",705459,176],["τὰ",709436,41],["παιδάριά",709923,42],["σου",711945,133],["καὶ",707031,7],["ἀπαγγελοῦσίν",701321,218],["σοι",711925,159],["καὶ",707031,7],["εὑρέτωσαν",705676,264],["τὰ",709436,41],["παιδάρια",709923,42],["χάριν",713735,9],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["σου",711945,133],["ὅτι",709803,7],["ἐφ᾿",705080,0],["ἡμέραν",705984,9],["ἀγαθὴν",700106,36],["ἥκομεν",705956,243],["δὸς",703654,176],["δὴ",703395,11],["ὃ",709781,128],["ἐὰν",703912,7],["εὕρῃ",705676,172],["ἡ",709436,10],["χείρ",713787,12],["σου",711945,133],["τῷ",709436,113],["υἱῷ",713075,114],["σου",711945,133],["τῷ",709436,113],["Δαυιδ",703232,114]],"Ask thy servants, and they will tell thee. Let then thy servants find grace in thine eyes, for we are come on a good day; give, we pray thee, whatsoever thy hand may find, to thy son David."],["9",[["καὶ",707031,7],["ἔρχονται",705453,269],["τὰ",709436,63],["παιδάρια",709923,64],["καὶ",707031,7],["λαλοῦσιν",708071,197],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["πρὸς",710844,0],["Ναβαλ",709132,114],["κατὰ",707200,0],["πάντα",710177,68],["τὰ",709436,41],["ῥήματα",711246,42],["ταῦτα",709858,71],["ἐν",704639,0],["τῷ",709436,53],["ὀνόματι",709666,54],["Δαυιδ",703232,18],["καὶ",707031,7],["ἀνεπήδησεν",701031,2]],"So the servants come and speak these words to Nabal, according to all these words in the name of David."],["10",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["Ναβαλ",709132,4],["τοῖς",709436,147],["παισὶν",709932,148],["Δαυιδ",703232,18],["καὶ",707031,7],["εἶπεν",705373,2],["τίς",712867,158],["ὁ",709436,3],["Δαυιδ",703232,4],["καὶ",707031,7],["τίς",712867,158],["ὁ",709436,3],["υἱὸς",713075,4],["Ιεσσαι",706668,18],["σήμερον",711751,28],["πεπληθυμμένοι",710530,429],["εἰσὶν",704093,197],["οἱ",709436,136],["δοῦλοι",703817,52],["ἀναχωροῦντες",701092,146],["ἕκαστος",704133,14],["ἐκ",704132,0],["προσώπου",710986,21],["τοῦ",709436,35],["κυρίου",707996,18],["αὐτοῦ",702165,102]],"And Nabal sprang up, and answered the servants of David, and said, Who [is] David? and who [is] the son of Jessæ? now-a-days there is abundance of servants who depart every one from his master."],["11",[["καὶ",707031,7],["λήμψομαι",708076,181],["τοὺς",709436,58],["ἄρτους",701829,57],["μου",709032,133],["καὶ",707031,7],["τὸν",709436,5],["οἶνόν",709530,6],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,41],["θύματά",706327,42],["μου",709032,133],["ἃ",709781,69],["τέθυκα",706349,89],["τοῖς",709436,147],["κείρουσίν",707597,349],["μου",709032,133],["τὰ",709436,41],["πρόβατα",710768,42],["καὶ",707031,7],["δώσω",703654,165],["αὐτὰ",702165,71],["ἀνδράσιν",701150,148],["οἷς",709781,311],["οὐκ",709805,28],["οἶδα",709492,89],["πόθεν",710580,28],["εἰσίν",704093,197]],"And shall I take my bread, and my wine, and my beasts that I have slain for my shearers, and shall I give them to men of whom I know not whence they are?"],["12",[["καὶ",707031,7],["ἀπεστράφησαν",701598,99],["τὰ",709436,63],["παιδάρια",709923,64],["Δαυιδ",703232,18],["εἰς",704105,0],["ὁδὸν",709458,9],["αὐτῶν",702165,40],["καὶ",707031,7],["ἀνέστρεψαν",701060,150],["καὶ",707031,7],["ἦλθον",705453,150],["καὶ",707031,7],["ἀνήγγειλαν",700921,150],["τῷ",709436,113],[