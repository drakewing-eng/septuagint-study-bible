αβεῖν",708076,106],["ἐκ",704132,0],["πάντων",710177,83],["τῶν",709436,43],["αὐτοῦ",702165,102],["οὐθέν",709817,46],["καὶ",707031,7],["ἀνταπέδωκέν",701215,2],["μοι",708974,159],["πονηρὰ",710660,68],["ἀντὶ",701227,0],["ἀγαθῶν",700106,169]],"And David said, Perhaps I have kept all his possessions in the wilderness that he should wrong me, and we did not order the taking any thing of all his goods; yet he has rewarded me evil for good."],["22",[["τάδε",709446,71],["ποιήσαι",710582,106],["ὁ",709436,3],["θεὸς",706192,4],["τῷ",709436,113],["Δαυιδ",703232,114],["καὶ",707031,7],["τάδε",709446,290],["προσθείη",710965,225],["εἰ",704071,7],["ὑπολείψομαι",713212,181],["ἐκ",704132,0],["πάντων",710177,83],["τῶν",709436,43],["τοῦ",709436,35],["Ναβαλ",709132,18],["ἕως",705792,0],["πρωὶ",711021,28],["οὐροῦντα",709845,183],["πρὸς",710844,0],["τοῖχον",712879,6]],"So God do to David and more also, if I leave one male of all that belong to Nabal until the morning."],["23",[["καὶ",707031,7],["εἶδεν",709725,2],["Αβιγαια",700057,12],["τὸν",709436,5],["Δαυιδ",703232,6],["καὶ",707031,7],["ἔσπευσεν",712011,2],["καὶ",707031,7],["κατεπήδησεν",707372,2],["ἀπὸ",701425,0],["τῆς",709436,16],["ὄνου",709671,17],["καὶ",707031,7],["ἔπεσεν",710481,2],["ἐνώπιον",704823,0],["Δαυιδ",703232,18],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["αὐτῆς",702165,86],["καὶ",707031,7],["προσεκύνησεν",710925,2],["αὐτῷ",702165,50],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9]],"And Abigaia saw David, and she hasted, and alighted from her ass; and she fell before David on her face, and did obeisance to him, [bowing] to the ground"],["24",[["ἐπὶ",705080,0],["τοὺς",709436,58],["πόδας",710707,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["ἐν",704639,0],["ἐμοί",704577,159],["κύριέ",707996,153],["μου",709032,133],["ἡ",709436,10],["ἀδικία",700271,12],["λαλησάτω",708071,45],["δὴ",703395,11],["ἡ",709436,10],["δούλη",703815,12],["σου",711945,133],["εἰς",704105,0],["τὰ",709436,41],["ὦτά",709852,42],["σου",711945,133],["καὶ",707031,7],["ἄκουσον",700587,176],["τῆς",709436,16],["δούλης",703815,17],["σου",711945,133],["λόγον",708236,6]],"[even] to his feet, and said, On me, my lord, be my wrong: let, I pray thee, thy servant speak in thine ears, and hear thou the words of thy servant."],["25",[["μὴ",708851,28],["δὴ",703395,11],["θέσθω",712849,315],["ὁ",709436,3],["κύριός",707996,4],["μου",709032,133],["καρδίαν",707141,9],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τὸν",709436,5],["ἄνθρωπον",701163,6],["τὸν",709436,5],["λοιμὸν",708245,27],["τοῦτον",709858,85],["ὅτι",709803,7],["κατὰ",707200,0],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["οὕτως",709859,28],["ἐστίν",704093,91],["Ναβαλ",709132,4],["ὄνομα",709666,25],["αὐτῷ",702165,50],["καὶ",707031,7],["ἀφροσύνη",702235,12],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐγὼ",704018,164],["ἡ",709436,10],["δούλη",703815,12],["σου",711945,133],["οὐκ",709805,28],["εἶδον",709725,150],["τὰ",709436,41],["παιδάριά",709923,42],["σου",711945,133],["ἃ",709781,69],["ἀπέστειλας",701592,162]],"Let not my lord, I pray thee, take to heart this pestilent man, for according to his name, so is he; Nabal [is] his name, and folly [is] with him: but I thy handmaid saw not the servants of my lord whom thou didst send."],["26",[["καὶ",707031,7],["νῦν",709384,28],["κύριε",707996,153],["ζῇ",705851,204],["κύριος",707996,4],["καὶ",707031,7],["ζῇ",705851,204],["ἡ",709436,10],["ψυχή",714070,12],["σου",711945,133],["καθὼς",707030,28],["ἐκώλυσέν",708020,2],["σε",711598,163],["κύριος",707996,4],["τοῦ",709436,20],["μὴ",708851,28],["ἐλθεῖν",705453,106],["εἰς",704105,0],["αἷμα",700442,25],["ἀθῷον",700390,46],["καὶ",707031,7],["σῴζειν",712627,55],["τὴν",709436,8],["χεῖρά",713787,9],["σού",711945,133],["σοι",711925,159],["καὶ",707031,7],["νῦν",709384,28],["γένοιντο",703104,529],["ὡς",714148,7],["Ναβαλ",709132,4],["οἱ",709436,136],["ἐχθροί",705779,52],["σου",711945,133],["καὶ",707031,7],["οἱ",709436,136],["ζητοῦντες",705879,146],["τῷ",709436,113],["κυρίῳ",707996,114],["μου",709032,133],["κακά",707066,68]],"And now, my lord, [as] the Lord lives, and thy soul lives, as the Lord has kept thee from coming against innocent blood, and from executing vengeance for thyself, now therefore let thine enemies, and those that seek evil against my lord, become as Nabal."],["27",[["καὶ",707031,7],["νῦν",709384,28],["λαβὲ",708076,176],["τὴν",709436,8],["εὐλογίαν",705633,9],["ταύτην",709858,104],["ἣν",709781,131],["ἐνήνοχεν",713428,171],["ἡ",709436,10],["δούλη",703815,12],["σου",711945,133],["τῷ",709436,113],["κυρίῳ",707996,114],["μου",709032,133],["καὶ",707031,7],["δώσεις",703654,166],["τοῖς",709436,95],["παιδαρίοις",709923,96],["τοῖς",709436,95],["παρεστηκόσιν",710152,582],["τῷ",709436,113],["κυρίῳ",707996,114],["μου",709032,133]],"And now accept this token of goodwill, which thy servant has brought to my lord, and thou shalt give it to the servants that wait on my lord."],["28",[["ἆρον",700473,176],["δὴ",703395,11],["τὸ",709436,24],["ἀνόμημα",701191,25],["τῆς",709436,16],["δούλης",703815,17],["σου",711945,133],["ὅτι",709803,7],["ποιῶν",710582,72],["ποιήσει",710582,127],["κύριος",707996,4],["τῷ",709436,113],["κυρίῳ",707996,114],["μου",709032,133],["οἶκον",709516,6],["πιστόν",710486,27],["ὅτι",709803,7],["πόλεμον",710605,6],["κυρίου",707996,18],["ὁ",709436,3],["κύριός",707996,4],["μου",709032,133],["πολεμεῖ",710601,91],["καὶ",707031,7],["κακία",707054,12],["οὐχ",709805,28],["εὑρεθήσεται",705676,134],["ἐν",704639,0],["σοὶ",711925,159],["πώποτε",711118,28]],"Remove, I pray thee, the trespass of thy servant; for the Lord will surely make for my lord a sure house, for the Lord fights the battles of my lord, and there shall no evil be ever found in thee."],["29",[["καὶ",707031,7],["ἀναστήσεται",701173,93],["ἄνθρωπος",701163,4],["καταδιώκων",707243,72],["σε",711598,163],["καὶ",707031,7],["ζητῶν",705879,72],["τὴν",709436,8],["ψυχήν",714070,9],["σου",711945,133],["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["ψυχὴ",714070,12],["κυρίου",707996,18],["μου",709032,133],["ἐνδεδεμένη",704685,203],["ἐν",704639,0],["δεσμῷ",703372,114],["τῆς",709436,16],["ζωῆς",705910,17],["παρὰ",709995,0],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["καὶ",707031,7],["ψυχὴν",714070,9],["ἐχθρῶν",705779,81],["σου",711945,133],["σφενδονήσεις",712577,166],["ἐν",704639,0],["μέσῳ",708768,97],["τῆς",709436,16],["σφενδόνης",712578,17]],"And [if] a man shall rise up persecuting thee and seeking thy life, yet shall the life of my lord be bound up in the bundle of life with the Lord God, and thou shalt whirl the life of thine enemies [as] in the midst of a sling."],["30",[["καὶ",707031,7],["ἔσται",704093,93],["ὅτι",709803,7],["ποιήσει",710582,127],["κύριος",707996,4],["τῷ",709436,113],["κυρίῳ",707996,114],["μου",709032,133],["πάντα",710177,68],["ὅσα",709788,68],["ἐλάλησεν",708071,2],["ἀγαθὰ",700106,68],["ἐπὶ",705080,0],["σέ",711598,163],["καὶ",707031,7],["ἐντελεῖταί",704791,93],["σοι",711925,159],["κύριος",707996,4],["εἰς",704105,0],["ἡγούμενον",705931,212],["ἐπὶ",705080,0],["Ισραηλ",706839,6]],"And it shall be when the Lord shall have wrought for my lord all the good things he has spoken concerning thee, and shall appoint thee to be ruler over Israel;"],["31",[["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["σοι",711925,159],["τοῦτο",709858,129],["βδελυγμὸς",702605,25],["καὶ",707031,7],["σκάνδαλον",711825,25],["τῷ",709436,113],["κυρίῳ",707996,114],["μου",709032,133],["ἐκχέαι",704368,106],["αἷμα",700442,25],["ἀθῷον",700390,46],["δωρεὰν",703900,9],["καὶ",707031,7],["σῶσαι",712627,106],["χεῖρα",713787,9],["κυρίου",707996,18],["μου",709032,133],["αὐτῷ",702165,50],["καὶ",707031,7],["ἀγαθώσει",700108,127],["κύριος",707996,4],["τῷ",709436,113],["κυρίῳ",707996,114],["μου",709032,133],["καὶ",707031,7],["μνησθήσῃ",708923,364],["τῆς",709436,16],["δούλης",703815,17],["σου",711945,133],["ἀγαθῶσαι",700108,106],["αὐτῇ",702165,105]],"then this shall not be an abomination and offence to my lord, to have shed innocent blood without cause, and for my lord to have avenged himself: and so may the Lord do good to my lord, and thou shalt remember thine handmaid to do her good."],["32",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["τῇ",709436,100],["Αβιγαια",700057,1],["εὐλογητὸς",705632,14],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ὃς",709781,213],["ἀπέστειλέν",701592,2],["σε",711598,163],["σήμερον",711751,28],["ἐν",704639,0],["ταύτῃ",709858,105],["εἰς",704105,0],["ἀπάντησίν",701348,9],["μου",709032,133]],"And David said to Abigaia, Blessed [be] the Lord God of Israel, who sent thee this very day to meet me:"],["33",[["καὶ",707031,7],["εὐλογητὸς",705632,14],["ὁ",709436,3],["τρόπος",712980,4],["σου",711945,133],["καὶ",707031,7],["εὐλογημένη",705631,203],["σὺ",712181,164],["ἡ",709436,10],["ἀποκωλύσασά",701501,149],["με",708618,163],["σήμερον",711751,28],["ἐν",704639,0],["ταύτῃ",709858,105],["μὴ",708851,28],["ἐλθεῖν",705453,106],["εἰς",704105,0],["αἵματα",700442,42],["καὶ",707031,7],["σῶσαι",712627,106],["χεῖρά",713787,9],["μου",709032,133],["ἐμοί",704577,159]],"and blessed [be] thy conduct, and blessed [be] thou, who hast hindered me this very day from coming to shed blood, and from avenging myself."],["34",[["πλὴν",710540,28],["ὅτι",709803,7],["ζῇ",705851,204],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ὃς",709781,213],["ἀπεκώλυσέν",701501,2],["με",708618,163],["σήμερον",711751,28],["τοῦ",709436,20],["κακοποιῆσαί",707062,106],["σε",711598,163],["ὅτι",709803,7],["εἰ",704071,7],["μὴ",708851,28],["ἔσπευσας",712011,162],["καὶ",707031,7],["παρεγένου",710006,174],["εἰς",704105,0],["ἀπάντησίν",701348,9],["μοι",708974,159],["τότε",712908,28],["εἶπα",705373,155],["εἰ",704071,7],["ὑπολειφθήσεται",713212,134],["τῷ",709436,113],["Ναβαλ",709132,114],["ἕως",705792,0],["φωτὸς",713642,21],["τοῦ",709436,20],["πρωὶ",711021,28],["οὐρῶν",709839,65],["πρὸς",710844,0],["τοῖχον",712879,6]],"But surely as the Lord God of Israel lives, who hindered me this day from doing thee harm, if thou hadst not hasted and come to meet me, then I said, There shall [surely] not be left to Nabal till the morning one male."],["35",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Δαυιδ",703232,4],["ἐκ",704132,0],["χειρὸς",713787,17],["αὐτῆς",702165,86],["πάντα",710177,68],["ἃ",709781,69],["ἔφερεν",713428,13],["αὐτῷ",702165,50],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῇ",702165,105],["ἀνάβηθι",700905,176],["εἰς",704105,0],["εἰρήνην",704098,9],["εἰς",704105,0],["οἶκόν",709516,6],["σου",711945,133],["βλέπε",702740,240],["ἤκουσα",700587,155],["τῆς",709436,16],["φωνῆς",713640,17],["σου",711945,133],["καὶ",707031,7],["ᾑρέτισα",700469,155],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133]],"And David took of her hand all that she brought to him, and said to her, Go in peace to thy house: see, I have hearkened to thy voice, and accepted thy petition."],["36",[["καὶ",707031,7],["παρεγενήθη",710006,37],["Αβιγαια",700057,4],["πρὸς",710844,0],["Ναβαλ",709132,6],["καὶ",707031,7],["ἰδοὺ",706497,88],["αὐτῷ",702165,50],["πότος",710704,4],["ἐν",704639,0],["οἴκῳ",709516,114],["αὐτοῦ",702165,102],["ὡς",714148,7],["πότος",710704,4],["βασιλέως",702580,18],["καὶ",707031,7],["ἡ",709436,10],["καρδία",707141,12],["Ναβαλ",709132,18],["ἀγαθὴ",700106,29],["ἐπ᾿",705080,0],["αὐτόν",702165,85],["καὶ",707031,7],["αὐτὸς",702165,121],["μεθύων",708676,72],["ἕως",705792,0],["σφόδρα",712586,28],["καὶ",707031,7],["οὐκ",709805,28],["ἀπήγγειλεν",701321,2],["αὐτῷ",702165,50],["ῥῆμα",711246,25],["μικρὸν",708915,46],["ἢ",705924,7],["μέγα",708653,46],["ἕως",705792,0],["φωτὸς",713642,21],["τοῦ",709436,20],["πρωί",711021,28]],"And Abigaia came to Nabal: and, behold, he had a banquet in his house, as the banquet of a king, and the heart of Nabal [was] merry within him, and he [was] very drunken: and she told him nothing great or small till the morning light."],["37",[["καὶ",707031,7],["ἐγένετο",703104,23],["πρωί",711021,28],["ὡς",714148,7],["ἐξένηψεν",704265,2],["ἀπὸ",701425,0],["τοῦ",709436,35],["οἴνου",709530,18],["Ναβαλ",709132,4],["ἀπήγγειλεν",701321,2],["αὐτῷ",702165,50],["ἡ",709436,10],["γυνὴ",703209,12],["αὐτοῦ",702165,102],["τὰ",709436,41],["ῥήματα",711246,42],["ταῦτα",709858,71],["καὶ",707031,7],["ἐναπέθανεν",704659,2],["ἡ",709436,10],["καρδία",707141,12],["αὐτοῦ",702165,102],["ἐν",704639,0],["αὐτῷ",702165,50],["καὶ",707031,7],["αὐτὸς",702165,121],["γίνεται",703104,117],["ὡς",714148,7],["λίθος",708196,4]],"And it came to pass in the morning, when Nabal recovered from his wine, his wife told him these words; and his heart died within him, and he became as a stone."],["38",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὡσεὶ",714159,28],["δέκα",703333,59],["ἡμέραι",705984,191],["καὶ",707031,7],["ἐπάταξεν",710185,2],["κύριος",707996,4],["τὸν",709436,5],["Ναβαλ",709132,6],["καὶ",707031,7],["ἀπέθανεν",701461,2]],"And it came to pass after about ten days, that the Lord smote Nabal, and he died."],["39",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Δαυιδ",703232,4],["καὶ",707031,7],["εἶπεν",705373,2],["εὐλογητὸς",705632,14],["κύριος",707996,4],["ὃς",709781,213],["ἔκρινεν",707905,2],["τὴν",709436,8],["κρίσιν",707908,9],["τοῦ",709436,35],["ὀνειδισμοῦ",709657,18],["μου",709032,133],["ἐκ",704132,0],["χειρὸς",713787,17],["Ναβαλ",709132,18],["καὶ",707031,7],["τὸν",709436,5],["δοῦλον",703817,6],["αὐτοῦ",702165,102],["περιεποιήσατο",710367,23],["ἐκ",704132,0],["χειρὸς",713787,17],["κακῶν",707066,198],["καὶ",707031,7],["τὴν",709436,8],["κακίαν",707054,9],["Ναβαλ",709132,6],["ἀπέστρεψεν",701598,2],["κύριος",707996,4],["εἰς",704105,0],["κεφαλὴν",707639,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Δαυιδ",703232,4],["καὶ",707031,7],["ἐλάλησεν",708071,2],["περὶ",710285,0],["Αβιγαιας",700059,17],["λαβεῖν",708076,106],["αὐτὴν",702165,104],["ἑαυτῷ",703917,50],["εἰς",704105,0],["γυναῖκα",703209,9]],"And David heard it and said, Blessed [be] the Lord, who has judged the cause of my reproach at the hand of Nabal, and has delivered his servant from the power of evil; and the Lord has returned the mischief of Nabal upon his own head. And David sent and spoke concerning Abigaia, to take her to himself for a wife."],["40",[["καὶ",707031,7],["ἦλθον",705453,150],["οἱ",709436,136],["παῖδες",709932,52],["Δαυιδ",703232,18],["πρὸς",710844,0],["Αβιγαιαν",700058,9],["εἰς",704105,0],["Κάρμηλον",707161,9],["καὶ",707031,7],["ἐλάλησαν",708071,150],["αὐτῇ",702165,105],["λέγοντες",708124,146],["Δαυιδ",703232,4],["ἀπέστειλεν",701592,2],["ἡμᾶς",705981,194],["πρὸς",710844,0],["σὲ",711598,163],["λαβεῖν",708076,106],["σε",711598,163],["αὐτῷ",702165,50],["εἰς",704105,0],["γυναῖκα",703209,9]],"So the servants of David came to Abigaia to Carmel, and spoke to her, saying, David has sent us to thee, to take thee to himself for a wife."],["41",[["καὶ",707031,7],["ἀνέστη",701173,2],["καὶ",707031,7],["προσεκύνησεν",710925,2],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["καὶ",707031,7],["εἶπεν",705373,2],["ἰδοὺ",706497,88],["ἡ",709436,10],["δούλη",703815,12],["σου",711945,133],["εἰς",704105,0],["παιδίσκην",709928,9],["νίψαι",709314,106],["πόδας",710707,57],["τῶν",709436,80],["παίδων",709932,81],["σου",711945,133]],"And she arose, and did reverence with her face to the earth, and said, Behold, thy servant [is] for an handmaid to wash the feet of thy servants."],["42",[["καὶ",707031,7],["ἀνέστη",701173,2],["Αβιγαια",700057,12],["καὶ",707031,7],["ἐπέβη",705082,2],["ἐπὶ",705080,0],["τὴν",709436,8],["ὄνον",709671,9],["καὶ",707031,7],["πέντε",710266,59],["κοράσια",707832,64],["ἠκολούθουν",700566,137],["αὐτῇ",702165,105],["καὶ",707031,7],["ἐπορεύθη",710667,37],["ὀπίσω",709697,0],["τῶν",709436,80],["παίδων",709932,81],["Δαυιδ",703232,18],["καὶ",707031,7],["γίνεται",703104,117],["αὐτῷ",702165,50],["εἰς",704105,0],["γυναῖκα",703209,9]],"And Abigaia arose, and mounted her ass, and five damsels followed her: and she went after the servants of David, and became his wife."],["43",[["καὶ",707031,7],["τὴν",709436,8],["Αχινααμ",702285,9],["ἔλαβεν",708076,2],["Δαυιδ",703232,4],["ἐξ",704132,0],["Ιεζραελ",706547,118],["καὶ",707031,7],["ἀμφότεραι",700892,192],["ἦσαν",704093,137],["αὐτῷ",702165,50],["γυναῖκες",703209,191]],"And David took Achinaam out of Jezrael, and they were both his wives."],["44",[["καὶ",707031,7],["Σαουλ",711499,4],["ἔδωκεν",703654,2],["Μελχολ",708719,9],["τὴν",709436,8],["θυγατέρα",706320,9],["αὐτοῦ",702165,102],["τὴν",709436,8],["γυναῖκα",703209,9],["Δαυιδ",703232,18],["τῷ",709436,113],["Φαλτι",713337,114],["υἱῷ",713075,114],["Λαις",708063,18],["τῷ",709436,113],["ἐκ",704132,0],["Ρομμα",711290,118]],"And Saul gave Melchol his daughter, David's wife, to Phalti the son of Amis who was of Romma."]]