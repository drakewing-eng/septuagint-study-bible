[["1",[["καὶ",707031,7],["Εζεκιας",704044,4],["ἐβασίλευσεν",702581,2],["ὢν",704093,72],["εἴκοσι",704085,59],["καὶ",707031,7],["πέντε",710266,59],["ἐτῶν",705543,44],["καὶ",707031,7],["εἴκοσι",704085,59],["καὶ",707031,7],["ἐννέα",704754,59],["ἔτη",705543,42],["ἐβασίλευσεν",702581,2],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["ὄνομα",709666,15],["τῇ",709436,100],["μητρὶ",708892,1],["αὐτοῦ",702165,102],["Αββα",700025,12],["θυγάτηρ",706320,12],["Ζαχαρια",705847,18]],"And Ezekias began to reign at the age of twenty-five years, and he reigned twenty-nine years in Jerusalem: and his mother's name was Abia, daughter of Zacharias."],["2",[["καὶ",707031,7],["ἐποίησεν",710582,2],["τὸ",709436,24],["εὐθὲς",705596,46],["ἐνώπιον",704823,0],["κυρίου",707996,18],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἐποίησεν",710582,2],["Δαυιδ",703232,4],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτοῦ",702165,102]],"And he did that which was right in the sight of the Lord, according to all that his father David had done."],["3",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὡς",714148,7],["ἔστη",706846,2],["ἐπὶ",705080,0],["τῆς",709436,16],["βασιλείας",702577,17],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,113],["πρώτῳ",711041,339],["μηνὶ",708874,114],["ἀνέῳξεν",701186,2],["τὰς",709436,38],["θύρας",706337,39],["οἴκου",709516,18],["κυρίου",707996,18],["καὶ",707031,7],["ἐπεσκεύασεν",705251,2],["αὐτάς",702165,231]],"And it came to pass, when he was established over his kingdom, in the first month, he opened the doors of the house of the Lord, and repaired them."],["4",[["καὶ",707031,7],["εἰσήγαγεν",704107,2],["τοὺς",709436,58],["ἱερεῖς",706614,57],["καὶ",707031,7],["τοὺς",709436,58],["Λευίτας",708160,57],["καὶ",707031,7],["κατέστησεν",707011,2],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὸ",709436,24],["κλίτος",707740,25],["τὸ",709436,24],["πρὸς",710844,0],["ἀνατολὰς",701071,17]],"And he brought in the priests and the Levites, and put them on the east side,"],["5",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["ἀκούσατε",700587,74],["οἱ",709436,136],["Λευῖται",708160,52],["νῦν",709384,28],["ἁγνίσθητε",700172,372],["καὶ",707031,7],["ἁγνίσατε",700172,74],["τὸν",709436,5],["οἶκον",709516,6],["κυρίου",707996,18],["θεοῦ",706192,18],["τῶν",709436,80],["πατέρων",710189,81],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐκβάλετε",704145,74],["τὴν",709436,8],["ἀκαθαρσίαν",700507,9],["ἐκ",704132,0],["τῶν",709436,43],["ἁγίων",700159,169]],"and said to them, Hear, ye Levites: now sanctify yourselves, and sanctify the house of the Lord God of your fathers, and cast out the impurity from the holy places."],["6",[["ὅτι",709803,7],["ἀπέστησαν",702214,150],["οἱ",709436,136],["πατέρες",710189,52],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐποίησαν",710582,150],["τὸ",709436,24],["πονηρὸν",710660,46],["ἐναντίον",704654,0],["κυρίου",707996,18],["καὶ",707031,7],["ἐγκατέλιπαν",703967,150],["αὐτὸν",702165,85],["καὶ",707031,7],["ἀπέστρεψαν",701598,150],["τὸ",709436,24],["πρόσωπον",710986,25],["ἀπὸ",701425,0],["τῆς",709436,16],["σκηνῆς",711845,17],["κυρίου",707996,18],["καὶ",707031,7],["ἔδωκαν",703654,150],["αὐχένα",702169,6]],"For our fathers have revolted, and done that which was evil before the Lord our God, and have forsaken him, and have turned away their face from the tabernacle of the Lord, and have turned [their] back."],["7",[["καὶ",707031,7],["ἀπέκλεισαν",701484,150],["τὰς",709436,38],["θύρας",706337,39],["τοῦ",709436,35],["ναοῦ",709191,18],["καὶ",707031,7],["ἔσβεσαν",711596,150],["τοὺς",709436,58],["λύχνους",708287,57],["καὶ",707031,7],["θυμίαμα",706330,25],["οὐκ",709805,28],["ἐθυμίασαν",706332,150],["καὶ",707031,7],["ὁλοκαυτώματα",709589,42],["οὐ",709805,28],["προσήνεγκαν",710974,150],["ἐν",704639,0],["τῷ",709436,53],["ἁγίῳ",700159,30],["θεῷ",706192,114],["Ισραηλ",706839,18]],"And they have shut up the doors of the temple, and put out the lamps, and have not burnt incense, and have not offered whole-burnt-offerings in the holy [place] to the God of I