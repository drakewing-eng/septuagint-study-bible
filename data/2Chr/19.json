[["1",[["καὶ",707031,7],["ἀπέστρεψεν",701598,2],["Ιωσαφατ",706942,4],["βασιλεὺς",702580,4],["Ιουδα",706768,18],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["αὐτοῦ",702165,102],["ἐν",704639,0],["εἰρήνῃ",704098,1],["εἰς",704105,0],["Ιερουσαλημ",706644,1]],"And Josaphat king of Juda returned to his house at Jerusalem."],["2",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["εἰς",704105,0],["ἀπάντησιν",701348,9],["αὐτοῦ",702165,102],["Ιου",706765,4],["ὁ",709436,3],["τοῦ",709436,35],["Ανανι",701015,18],["ὁ",709436,3],["προφήτης",711009,4],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["βασιλεῦ",702580,153],["Ιωσαφατ",706942,153],["εἰ",704071,7],["ἁμαρτωλῷ",700776,30],["σὺ",712181,164],["βοηθεῖς",702746,154],["ἢ",705924,7],["μισουμένῳ",708935,241],["ὑπὸ",713184,0],["κυρίου",707996,18],["φιλιάζεις",713475,154],["διὰ",703417,0],["τοῦτο",709858,129],["ἐγένετο",703104,23],["ἐπὶ",705080,0],["σὲ",711598,163],["ὀργὴ",709728,12],["παρὰ",709995,0],["κυρίου",707996,18]],"And there went out to meet him Jeu the prophet the son of Anani, and said to him, King Josaphat, dost thou help a sinner, or act friendly towards one hated of the Lord? Therefore has wrath come upon thee from the Lord."],["3",[["ἀλλ᾿",700680,7],["ἢ",705924,7],["λόγοι",708236,52],["ἀγαθοὶ",700106,138],["ηὑρέθησαν",705676,99],["ἐν",704639,0],["σοί",711925,159],["ὅτι",709803,7],["ἐξῆρας",704839,162],["τὰ",709436,41],["ἄλση",700729,42],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["Ιουδα",706768,18],["καὶ",707031,7],["κατηύθυνας",707521,162],["τὴν",709436,8],["καρδίαν",707141,9],["σου",711945,133],["ἐκζητῆσαι",704187,106],["τὸν",709436,5],["κύριον",707996,6]],"Nevertheless [some] good things have been found in thee, forasmuch as thou didst remove the groves from the land of Juda, and didst direct thine heart to seek after the Lord."],["4",[["καὶ",707031,7],["κατῴκησεν",707534,2],["Ιωσαφατ",706942,4],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["πάλιν",709942,28],["ἐξῆλθεν",704909,2],["εἰς",704105,0],["τὸν",709436,5],["λαὸν",708094,6],["ἀπὸ",701425,0],["Βηρσαβεε",702702,118],["ἕως",705792,0],["ὄρους",709768,21],["Εφραιμ",705769,18],["καὶ",707031,7],["ἐπέστρεψεν",705278,2],["αὐτοὺς",702165,62],["ἐπὶ",705080,0],["κύριον",707996,6],["θεὸν",706192,6],["τῶν",709436,80],["πατέρων",710189,81],["αὐτῶν",702165,40]],"And Josaphat dwelt in Jerusalem: and he again went out among the people from Bersabee to the mount of Ephraim, and turned them back to the Lord God of their fathers."],["5",[["καὶ",707031,7],["κατέστησεν",707011,2],["κριτὰς",707910,57],["ἐν",704639,0],["πάσαις",710177,291],["ταῖς",709436,75],["πόλεσιν",710612,76],["Ιουδα",706768,18],["ταῖς",709436,75],["ὀχυραῖς",709889,291],["ἐν",704639,0],["πόλει",710612,1],["καὶ",707031,7],["πόλει",710612,1]],"And he appointed judges in all the strong cities of Juda, city by city."],["6",[["καὶ",707031,7],["εἶπεν",705373,2],["τοῖς",709436,147],["κριταῖς",707910,148],["ἴδετε",709725,74],["τί",712867,126],["ὑμεῖς",713081,219],["ποιεῖτε",710582,87],["ὅτι",709803,7],["οὐκ",709805,28],["ἀνθρώπῳ",701163,114],["ὑμεῖς",713081,219],["κρίνετε",707905,87],["ἀλλ᾿",700680,7],["ἢ",705924,7],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["λόγοι",708236,52],["τῆς",709436,16],["κρίσεως",707908,17]],"And he said to the judges, Take good heed what ye do: for ye judge not for man, but for the Lord, and with you are matters of judgment."],["7",[["καὶ",707031,7],["νῦν",709384,28],["γενέσθω",703104,315],["φόβος",713534,4],["κυρίου",707996,18],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["καὶ",707031,7],["φυλάσσετε",713619,87],["καὶ",707031,7],["ποιήσετε",710582,337],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["μετὰ",708780,0],["κυρίου",707996,18],["θεοῦ",706192,18],["ἡμῶν",705999,145],["ἀδικία",700271,12],["οὐδὲ",709816,7],["θαυμάσαι",706135,106],["πρόσωπον",710986,25],["οὐδὲ",709816,7],["λαβεῖν",708076,106],["δῶρα",703907,42]],"And now let the fear of the Lord be upon you, and be wary, and do [your duty]: for there is no unrighteousness with the Lord our God, neither [is it for him] to respect persons, nor to take bribes."],["8",[["καὶ",707031,7],["γὰρ",702963,11],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["κατέστησεν",707011,2],["Ιωσαφατ",706942,4],["τῶν",709436,80],["ἱερέων",706614,81],["καὶ",707031,7],["τῶν",709436,80],["Λευιτῶν",708160,81],["καὶ",707031,7],["τῶν",709436,80],["πατριαρχῶν",710193,81],["Ισραηλ",706839,18],["εἰς",704105,0],["κρίσιν",707908,9],["κυρίου",707996,18],["καὶ",707031,7],["κρίνειν",707905,55],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["ἐν",704639,0],["Ιερουσαλημ",706644,1]],"Moreover Josaphat appointed in Jerusalem some of the priests, and Levites, and heads of houses of Israel, for the judgment of the Lord, and to judge the dwellers in Jerusalem."],["9",[["καὶ",707031,7],["ἐνετείλατο",704791,23],["πρὸς",710844,0],["αὐτοὺς",702165,62],["λέγων",708124,72],["οὕτως",709859,28],["ποιήσετε",710582,337],["ἐν",704639,0],["φόβῳ",713534,114],["κυρίου",707996,18],["ἐν",704639,0],["ἀληθείᾳ",700656,1],["καὶ",707031,7],["ἐν",704639,0],["πλήρει",710541,101],["καρδίᾳ",707141,1]],"And he charged them, saying, Thus shall ye do in the fear of the Lord, in truth and with a perfect heart."],["10",[["πᾶς",710177,14],["ἀνὴρ",701150,4],["κρίσιν",707908,9],["τὴν",709436,8],["ἐλθοῦσαν",705453,610],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["τῶν",709436,80],["ἀδελφῶν",700249,81],["ὑμῶν",713091,145],["τῶν",709436,80],["κατοικούντων",707534,170],["ἐν",704639,0],["ταῖς",709436,75],["πόλεσιν",710612,76],["αὐτῶν",702165,40],["ἀνὰ",700902,0],["μέσον",708768,46],["αἵματος",700442,21],["αἷμα",700442,25],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,46],["προστάγματος",710959,21],["καὶ",707031,7],["ἐντολῆς",704802,17],["καὶ",707031,7],["δικαιώματα",703697,42],["καὶ",707031,7],["κρίματα",707903,42],["καὶ",707031,7],["διαστελεῖσθε",703588,124],["αὐτοῖς",702165,151],["καὶ",707031,7],["οὐχ",709805,28],["ἁμαρτήσονται",700773,135],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["ὀργὴ",709728,12],["καὶ",707031,7],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἀδελφοὺς",700249,57],["ὑμῶν",713091,145],["οὕτως",709859,28],["ποιήσετε",710582,337],["καὶ",707031,7],["οὐχ",709805,28],["ἁμαρτήσεσθε",700773,124]],"Whatsoever man of your brethren that dwell in their cities [shall bring] the cause that comes before you, between blood [and] blood, and between precept and commandment, and ordinances and judgments, ye shall even decide for them; so they shall not sin against the Lord, and there shall not be wrath upon you, and upon your brethren: thus ye shall do, and ye shall not sin."],["11",[["καὶ",707031,7],["ἰδοὺ",706497,88],["Αμαριας",700772,4],["ὁ",709436,3],["ἱερεὺς",706614,4],["ἡγούμενος",705931,122],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["εἰς",704105,0],["πᾶν",710177,27],["λόγον",708236,6],["κυρίου",707996,18],["καὶ",707031,7],["Ζαβδιας",705804,4],["υἱὸς",713075,4],["Ισμαηλ",706818,18],["ὁ",709436,3],["ἡγούμενος",705931,122],["εἰς",704105,0],["οἶκον",709516,6],["Ιουδα",706768,18],["πρὸς",710844,0],["πᾶν",710177,27],["λόγον",708236,6],["βασιλέως",702580,18],["καὶ",707031,7],["οἱ",709436,136],["γραμματεῖς",703185,52],["καὶ",707031,7],["οἱ",709436,136],["Λευῖται",708160,52],["πρὸ",710747,0],["προσώπου",710986,21],["ὑμῶν",713091,145],["ἰσχύσατε",706859,74],["καὶ",707031,7],["ποιήσατε",710582,74],["καὶ",707031,7],["ἔσται",704093,93],["κύριος",707996,4],["μετὰ",708780,0],["τοῦ",709436,35],["ἀγαθοῦ",700106,116]],"And, behold, Amarias the priest is head over you in every matter of the Lord; and Zabdias the son of Ismael is head over the house of Juda in every matter of the king; and the scribes and Levites are before you: be strong and active, and the Lord shall be with the good."]]