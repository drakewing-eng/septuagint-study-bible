[["1",[["καὶ",707031,7],["ἤρξατο",701860,23],["Σαλωμων",711430,4],["τοῦ",709436,20],["οἰκοδομεῖν",709509,55],["τὸν",709436,5],["οἶκον",709516,6],["κυρίου",707996,18],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["ἐν",704639,0],["ὄρει",709768,54],["τοῦ",709436,35],["Αμορια",700860,18],["οὗ",709781,48],["ὤφθη",709725,37],["κύριος",707996,4],["τῷ",709436,113],["Δαυιδ",703232,114],["πατρὶ",710189,114],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,113],["τόπῳ",712903,114],["ᾧ",709781,309],["ἡτοίμασεν",705539,2],["Δαυιδ",703232,4],["ἐν",704639,0],["ἅλῳ",700741,111],["Ορνα",709760,18],["τοῦ",709436,35],["Ιεβουσαίου",706519,18]],"And Solomon began to build the house of the Lord in Jerusalem in the mount of Amoria, where the Lord appeared to his father David, in the place which David had prepared in the threshing-floor of Orna the Jebusite."],["2",[["καὶ",707031,7],["ἤρξατο",701860,23],["οἰκοδομῆσαι",709509,106],["ἐν",704639,0],["τῷ",709436,113],["μηνὶ",708874,114],["τῷ",709436,113],["δευτέρῳ",703389,30],["ἐν",704639,0],["τῷ",709436,53],["ἔτει",705543,54],["τῷ",709436,53],["τετάρτῳ",712811,97],["τῆς",709436,16],["βασιλείας",702577,17],["αὐτοῦ",702165,102]],"And he began to build in the second month, in the fourth year of his reign."],["3",[["καὶ",707031,7],["ταῦτα",709858,290],["ἤρξατο",701860,23],["Σαλωμων",711430,4],["τοῦ",709436,20],["οἰκοδομῆσαι",709509,106],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["θεοῦ",706192,18],["μῆκος",708868,15],["πήχεων",710462,81],["ἡ",709436,10],["διαμέτρησις",703521,12],["ἡ",709436,10],["πρώτη",711041,417],["πήχεων",710462,81],["ἑξήκοντα",704922,59],["καὶ",707031,7],["εὖρος",705677,15],["πήχεων",710462,81],["εἴκοσι",704085,59]],"And thus Solomon began to build the house of God: the length in cubits—even the first measurement from end to end, was sixty cubits, and the breadth twenty cubits."],["4",[["καὶ",707031,7],["αιλαμ",700431,120],["κατὰ",707200,0],["πρόσωπον",710986,25],["τοῦ",709436,35],["οἴκου",709516,18],["μῆκος",708868,15