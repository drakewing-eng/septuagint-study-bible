[["1",[["καὶ",707031,7],["ἦλθεν",705453,2],["Ροβοαμ",711276,4],["εἰς",704105,0],["Συχεμ",712565,227],["ὅτι",709803,7],["εἰς",704105,0],["Συχεμ",712565,227],["ἤρχετο",705453,19],["πᾶς",710177,14],["Ισραηλ",706839,4],["βασιλεῦσαι",702581,106],["αὐτόν",702165,85]],"And Roboam came to Sychem: for all Israel came to Sychem to make him king."],["2",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὡς",714148,7],["ἤκουσεν",700587,2],["Ιεροβοαμ",706629,4],["υἱὸς",713075,4],["Ναβατ",709134,18],["καὶ",707031,7],["αὐτὸς",702165,121],["ἐν",704639,0],["Αἰγύπτῳ",700401,1],["ὡς",714148,7],["ἔφυγεν",713433,2],["ἀπὸ",701425,0],["προσώπου",710986,21],["Σαλωμων",711430,18],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["κατῴκησεν",707534,2],["Ιεροβοαμ",706629,4],["ἐν",704639,0],["Αἰγύπτῳ",700401,1],["καὶ",707031,7],["ἀπέστρεψεν",701598,2],["Ιεροβοαμ",706629,4],["ἐξ",704132,0],["Αἰγύπτου",700401,17]],"And it came to pass when Jeroboam the son of Nabat heard [it], (now he was in Egypt, forasmuch as he had fled thither from the face of king Solomon, and Jeroboam dwelt in Egypt,) that Jeroboam returned out of Egypt."],["3",[["καὶ",707031,7],["ἀπέστειλαν",701592,150],["καὶ",707031,7],["ἐκάλεσαν",707084,150],["αὐτόν",702165,85],["καὶ",707031,7],["ἦλθεν",705453,2],["Ιεροβοαμ",706629,4],["καὶ",707031,7],["πᾶσα",710177,29],["ἡ",709436,10],["ἐκκλησία",704216,12],["Ισραηλ",706839,18],["πρὸς",710844,0],["Ροβοαμ",711276,6],["λέγοντες",708124,146]],"And they sent and called him: and Jeroboam and all the congregation came to Roboam, saying,"],["4",[["ὁ",709436,3],["πατήρ",710189,4],["σου",711945,133],["ἐσκλήρυνεν",711864,2],["τὸν",709436,5],["ζυγὸν",705894,6],["ἡμῶν",705999,145],["καὶ",707031,7],["νῦν",709384,28],["ἄφες",702211,176],["ἀπὸ",701425,0],["τῆς",709436,16],["δουλείας",703813,17],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["τῆς",709436,16],["σκληρᾶς",711861,82],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,35],["ζυγοῦ",705894,18],["αὐτοῦ",702165,102],["τοῦ",709436,35],["βαρέος",702554,116],["οὗ",709781,48],["ἔδωκεν",703654,2],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["καὶ",707031,7],["δουλεύσομέν",703814,275],["σοι",711925,159]],"Thy father made our yoke grievous: now then abate [somewhat] of thy father's grievous rule, and of his heavy yoke which he put upon us, and we will serve thee."],["5",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["πορεύεσθε",710667,73],["ἕως",705792,0],["τριῶν",712927,198],["ἡμερῶν",705984,65],["καὶ",707031,7],["ἔρχεσθε",705453,374],["πρός",710844,0],["με",708618,163],["καὶ",707031,7],["ἀπῆλθεν",701398,2],["ὁ",709436,3],["λαός",708094,4]],"And he said to them, Go away for three days, and [then] come to me. So the people departed."],["6",[["καὶ",707031,7],["συνήγαγεν",712375,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ροβοαμ",711276,4],["τοὺς",709436,58],["πρεσβυτέρους",710735,57],["τοὺς",709436,58],["ἑστηκότας",706846,277],["ἐναντίον",704654,0],["Σαλωμων",711430,18],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,53],["ζῆν",705851,55],["αὐτὸν",702165,85],["λέγων",708124,72],["πῶς",711121,28],["ὑμεῖς",713081,219],["βουλεύεσθε",702791,374],["τοῦ",709436,20],["ἀποκριθῆναι",701492,179],["τῷ",709436,113],["λαῷ",708094,114],["τούτῳ",709858,50],["λόγον",708236,6]],"And king Roboam assembled the elders that stood before his father Solomon in his life-time, saying, How do ye counsel [me] to return an answer to this people?"],["7",[["καὶ",707031,7],["ἐλάλησαν",708071,150],["αὐτῷ",702165,50],["λέγοντες",708124,146],["ἐὰν",703912,7],["ἐν",704639,0],["τῇ",709436,100],["σήμερον",711751,28],["γένῃ",703104,172],["εἰς",704105,0],["ἀγαθὸν",700106,27],["τῷ",709436,113],["λαῷ",708094,114],["τούτῳ",709858,50],["καὶ",707031,7],["εὐδοκήσῃς",705565,175],["καὶ",707031,7],["λαλήσῃς",708071,175],["αὐτοῖς",702165,151],["λόγους",708236,57],["ἀγαθούς",700106,60],["καὶ",707031,7],["ἔσονταί",704093,135],["σοι",711925,159],["παῖδες",709932,52],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39]],"And they spoke to him, saying, If thou wouldest this day befriend this people, and be kind to them, and speak to them good words, then will they be thy servants for ever."],["8",[["καὶ",707031,7],["κατέλιπεν",707305,2],["τὴν",709436,8],["βουλὴν",702792,9],["τῶν",709436,80],["πρεσβυτέρων",710735,81],["οἳ",709781,250],["συνεβουλεύσαντο",712292,189],["αὐτῷ",702165,50],["καὶ",707031,7],["συνεβουλεύσατο",712292,23],["μετὰ",708780,0],["τῶν",709436,43],["παιδαρίων",709923,44],["τῶν",709436,43],["συνεκτραφέντων",712441,505],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["τῶν",709436,43],["ἑστηκότων",706846,461],["ἐναντίον",704654,0],["αὐτοῦ",702165,102]],"But he forsook the advice of the old men, who took counsel with him, and he took counsel with the young men who had been brought up with him, who stood before him."],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,206],["τί",712867,126],["ὑμεῖς",713081,219],["βουλεύεσθε",702791,374],["καὶ",707031,7],["ἀποκριθήσομαι",701492,180],["λόγον",708236,6],["τῷ",709436,113],["λαῷ",708094,114],["τούτῳ",709858,50],["οἳ",709781,250],["ἐλάλησαν",708071,150],["πρός",710844,0],["με",708618,163],["λέγοντες",708124,146],["ἄνες",701169,176],["ἀπὸ",701425,0],["τοῦ",709436,35],["ζυγοῦ",705894,18],["οὗ",709781,48],["ἔδωκεν",703654,2],["ὁ",709436,3],["πατήρ",710189,4],["σου",711945,133],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194]],"And he said to them, What do ye advise that I should answer this people, who spoke to me, saying, Ease [somewhat] of the yoke which thy father laid upon us?"],["10",[["καὶ",707031,7],["ἐλάλησαν",708071,150],["αὐτῷ",702165,50],["τὰ",709436,63],["παιδάρια",709923,64],["τὰ",709436,63],["ἐκτραφέντα",704342,352],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["οὕτως",709859,28],["λαλήσεις",708071,166],["τῷ",709436,113],["λαῷ",708094,114],["τῷ",709436,113],["λαλήσαντι",708071,350],["πρὸς",710844,0],["σὲ",711598,163],["λέγων",708124,72],["ὁ",709436,3],["πατήρ",710189,4],["σου",711945,133],["ἐβάρυνεν",702553,13],["τὸν",709436,5],["ζυγὸν",705894,6],["ἡμῶν",705999,145],["καὶ",707031,7],["σὺ",712181,164],["ἄφες",702211,176],["ἀφ᾿",701425,0],["ἡμῶν",705999,145],["οὕτως",709859,28],["ἐρεῖς",705415,166],["ὁ",709436,3],["μικρὸς",708915,14],["δάκτυλός",703259,4],["μου",709032,133],["παχύτερος",710206,224],["τῆς",709436,16],["ὀσφύος",709800,17],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133]],"And the young men that had been brought up with him spoke to him, saying, Thus shalt thou speak to the people that spoke to thee, saying, Thy father made our yoke heavy, and do thou lighten [somewhat of it] from us; thus shalt thou say, My little finger [shall be] thicker than my father's loins."],["11",[["καὶ",707031,7],["νῦν",709384,28],["ὁ",709436,3],["πατήρ",710189,4],["μου",709032,133],["ἐπαίδευσεν",709926,2],["ὑμᾶς",713080,194],["ζυγῷ",705894,114],["βαρεῖ",702554,30],["καὶ",707031,7],["ἐγὼ",704018,164],["προσθήσω",710965,165],["ἐπὶ",705080,0],["τὸν",709436,5],["ζυγὸν",705894,6],["ὑμῶν",713091,145],["ὁ",709436,3],["πατήρ",710189,4],["μου",709032,133],["ἐπαίδευσεν",709926,2],["ὑμᾶς",713080,194],["ἐν",704639,0],["μάστιγξιν",708568,76],["καὶ",707031,7],["ἐγὼ",704018,164],["παιδεύσω",709926,165],["ὑμᾶς",713080,194],["ἐν",704639,0],["σκορπίοις",711882,148]],"And whereas my father chastised you with a heavy yoke, I will also add to your yoke: my father chastised you with whips, and I will chastise you with scorpions."],["12",[["καὶ",707031,7],["ἦλθεν",705453,2],["Ιεροβοαμ",706629,4],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["πρὸς",710844,0],["Ροβοαμ",711276,6],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["τρίτῃ",712968,101],["ὡς",714148,7],["ἐλάλησεν",708071,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["λέγων",708124,72],["ἐπιστρέψατε",705278,74],["πρός",710844,0],["με",708618,163],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["τρίτῃ",712968,101]],"And Jeroboam and all the people came to Roboam on the third day, as the king had spoken, saying, Return to me on the third day."],["13",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["ὁ",709436,3],["βασιλεὺς",702580,4],["σκληρά",711861,28],["καὶ",707031,7],["ἐγκατέλιπεν",703967,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ροβοαμ",711276,4],["τὴν",709436,8],["βουλὴν",702792,9],["τῶν",709436,80],["πρεσβυτέρων",710735,81]],"And the king answered harshly; and king Roboam forsook the counsel of the old men,"],["14",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["πρὸς",710844,0],["αὐτοὺς",702165,62],["κατὰ",707200,0],["τὴν",709436,8],["βουλὴν",702792,9],["τῶν",709436,80],["νεωτέρων",709256,169],["λέγων",708124,72],["ὁ",709436,3],["πατήρ",710189,4],["μου",709032,133],["ἐβάρυνεν",702553,13],["τὸν",709436,5],["ζυγὸν",705894,6],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐγὼ",704018,164],["προσθήσω",710965,165],["ἐπ᾿",705080,0],["αὐτόν",702165,85],["ὁ",709436,3],["πατήρ",710189,4],["μου",709032,133],["ἐπαίδευσεν",709926,2],["ὑμᾶς",713080,194],["ἐν",704639,0],["μάστιγξιν",708568,76],["καὶ",707031,7],["ἐγὼ",704018,164],["παιδεύσω",709926,165],["ὑμᾶς",713080,194],["ἐν",704639,0],["σκορπίοις",711882,148]],"and spoke to them according to the counsel of the young men, saying, My father made your yoke heavy, but I will add to it: my father chastised you with whips, but I will chastise you with scorpions."],["15",[["καὶ",707031,7],["οὐκ",709805,28],["ἤκουσεν",700587,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["τοῦ",709436,35],["λαοῦ",708094,18],["ὅτι",709803,7],["ἦν",704093,13],["μεταστροφὴ",708818,12],["παρὰ",709995,0],["τοῦ",709436,35],["θεοῦ",706192,18],["λέγων",708124,72],["ἀνέστησεν",701173,2],["κύριος",707996,4],["τὸν",709436,5],["λόγον",708236,6],["αὐτοῦ",702165,102],["ὃν",709781,112],["ἐλάλησεν",708071,2],["ἐν",704639,0],["χειρὶ",713787,1],["Αχια",702262,18],["τοῦ",709436,35],["Σηλωνίτου",711742,18],["περὶ",710285,0],["Ιεροβοαμ",706629,18],["υἱοῦ",713075,18],["Ναβατ",709134,18]],"And the king hearkened not to the people, for there was a change [of their minds] from God, saying, The Lord has confirmed his word, which he spoke by the hand of Achia the Selonite concerning Jeroboam the son of Nabat, and [concerning] all Israel;"],["16",[["καὶ",707031,7],["παντὸς",710177,116],["Ισραηλ",706839,18],["ὅτι",709803,7],["οὐκ",709805,28],["ἤκουσεν",700587,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["αὐτῶν",702165,40],["καὶ",707031,7],["ἀπεκρίθη",701492,37],["ὁ",709436,3],["λαὸς",708094,4],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["λέγων",708124,72],["τίς",712867,359],["ἡμῖν",705994,90],["μερὶς",708748,12],["ἐν",704639,0],["Δαυιδ",703232,114],["καὶ",707031,7],["κληρονομία",707725,12],["ἐν",704639,0],["υἱῷ",713075,114],["Ιεσσαι",706668,18],["εἰς",704105,0],["τὰ",709436,41],["σκηνώματά",711849,42],["σου",711945,133],["Ισραηλ",706839,153],["νῦν",709384,28],["βλέπε",702740,240],["τὸν",709436,5],["οἶκόν",709516,6],["σου",711945,133],["Δαυιδ",703232,153],["καὶ",707031,7],["ἐπορεύθη",710667,37],["πᾶς",710177,14],["Ισραηλ",706839,4],["εἰς",704105,0],["τὰ",709436,41],["σκηνώματα",711849,42],["αὐτοῦ",702165,102]],"for the king did not hearken to them. And the people answered the king, saying, What portion have we in David, or inheritance in the son of Jessæ? to thy tents, O Israel: now see to thine own house, David. So all Israel went to their tents."],["17",[["καὶ",707031,7],["ἄνδρες",701150,52],["Ισραηλ",706839,18],["οἱ",709436,136],["κατοικοῦντες",707534,146],["ἐν",704639,0],["πόλεσιν",710612,76],["Ιουδα",706768,18],["καὶ",707031,7],["ἐβασίλευσεν",702581,2],["ἐπ᾿",705080,0],["αὐτῶν",702165,40],["Ροβοαμ",711276,4]],"But the men of Israel, even those who dwelt in the cities of Juda, [remained] and made Roboam king over them."],["18",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ροβοαμ",711276,4],["τὸν",709436,5],["Αδωνιραμ",700307,6],["τὸν",709436,5],["ἐπὶ",705080,0],["τοῦ",709436,35],["φόρου",713561,18],["καὶ",707031,7],["ἐλιθοβόλησαν",708194,150],["αὐτὸν",702165,85],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["λίθοις",708196,148],["καὶ",707031,7],["ἀπέθανεν",701461,2],["καὶ",707031,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ροβοαμ",711276,4],["ἔσπευσεν",712011,2],["τοῦ",709436,20],["ἀναβῆναι",700905,106],["εἰς",704105,0],["τὸ",709436,24],["ἅρμα",701768,25],["τοῦ",709436,20],["φυγεῖν",713433,106],["εἰς",704105,0],["Ιερουσαλημ",706644,1]],"And king Roboam sent to them Adoniram that was over the tribute; and the children of Israel stoned him with stones, and he died. And king Roboam hasted to mount [his] chariot, to flee to Jerusalem."],["19",[["καὶ",707031,7],["ἠθέτησεν",700369,2],["Ισραηλ",706839,4],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["Δαυιδ",703232,18],["ἕως",705792,0],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86]],"So Israel rebelled against the house of David until this day.",{"s":"d","q":0.67}]]