5453,2],["Σαλωμων",711430,4],["ἐκ",704132,0],["βαμα",702494,17],["τῆς",709436,16],["ἐν",704639,0],["Γαβαων",702858,111],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["ἀπὸ",701425,0],["προσώπου",710986,21],["σκηνῆς",711845,17],["μαρτυρίου",708525,21],["καὶ",707031,7],["ἐβασίλευσεν",702581,2],["ἐπὶ",705080,0],["Ισραηλ",706839,18]],"And Solomon came from the high place that was in Gabaon to Jerusalem, [from] before the tabernacle of witness, and reigned over Israel."],["14",[["καὶ",707031,7],["συνήγαγεν",712375,2],["Σαλωμων",711430,4],["ἅρματα",701768,42],["καὶ",707031,7],["ἱππεῖς",706786,57],["καὶ",707031,7],["ἐγένοντο",703104,189],["αὐτῷ",702165,50],["χίλια",713859,195],["καὶ",707031,7],["τετρακόσια",712817,195],["ἅρματα",701768,64],["καὶ",707031,7],["δώδεκα",703887,59],["χιλιάδες",713858,191],["ἱππέων",706786,81],["καὶ",707031,7],["κατέλιπεν",707305,2],["αὐτὰ",702165,71],["ἐν",704639,0],["πόλεσιν",710612,76],["τῶν",709436,43],["ἁρμάτων",701768,44],["καὶ",707031,7],["ὁ",709436,3],["λαὸς",708094,4],["μετὰ",708780,0],["τοῦ",709436,35],["βασιλέως",702580,18],["ἐν",704639,0],["Ιερουσαλημ",706644,1]],"And Solomon collected chariots and horsemen: and he had fourteen hundred chariots, and twelve thousand horsemen: and he set them in the cities of chariots, and the people [were] with the king in Jerusalem."],["15",[["καὶ",707031,7],["ἔθηκεν",712849,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["τὸ",709436,24],["χρυσίον",713972,25],["καὶ",707031,7],["τὸ",709436,24],["ἀργύριον",701707,25],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["ὡς",714148,11],["λίθους",708196,57],["καὶ",707031,7],["τὰς",709436,38],["κέδρους",707590,39],["ἐν",704639,0],["τῇ",709436,100],["Ιουδαίᾳ",706769,1],["ὡς",714148,11],["συκαμίνους",712253,39],["τὰς",709436,38],["ἐν",704639,0],["τῇ",709436,100],["πεδινῇ",710214,101],["εἰς",704105,0],["πλῆθος",710529,25]],"And the king made silver and gold in Jerusalem [to be] as stones, and cedars in Judea as sycamores in the plain for multitude."],["16",[["καὶ",707031,7],["ἡ",709436,10],["ἔξοδος",704948,12],["τῶν",709436,80],["ἵππων",706790,81],["τῶν",709436,80],["Σαλωμων",711430,18],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ἡ",709436,10],["τιμὴ",712856,12],["τῶν",709436,80],["ἐμπόρων",704614,81],["τοῦ",709436,35],["βασιλέως",702580,18],["ἐμπορεύεσθαι",704611,110],["ἠγόραζον",700184,137]],"And Solomon imported horses from Egypt, and the charge of the king's merchants for going [was as follows], and they traded,"],["17",[["καὶ",707031,7],["ἀνέβαινον",700905,137],["καὶ",707031,7],["ἐξῆγον",704834,137],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["ἅρμα",701768,25],["ἓν",704106,629],["ἑξακοσίων",704847,83],["ἀργυρίου",701707,21],["καὶ",707031,7],["ἵππον",706790,6],["ἑκατὸν",704136,59],["καὶ",707031,7],["πεντήκοντα",710270,59],["καὶ",707031,7],["οὕτως",709859,28],["πᾶσιν",710177,230],["τοῖς",709436,147],["βασιλεῦσιν",702580,148],["τῶν",709436,80],["Χετταίων",713838,81],["καὶ",707031,7],["βασιλεῦσιν",702580,148],["Συρίας",712533,17],["ἐν",704639,0],["χερσὶν",713787,76],["αὐτῶν",702165,40],["ἔφερον",713428,137]],"and went and brought out of Egypt a chariot for six hundred [pieces] of silver, and a horse for a hundred and fifty [pieces] of silver: and so they brought for all the kings of the Chettites, and for the kings of Syria by their means."],["18",[["καὶ",707031,7],["εἶπεν",705373,2],["Σαλωμων",711430,4],["τοῦ",709436,20],["οἰκοδομῆσαι",709509,106],["οἶκον",709516,6],["τῷ",709436,53],["ὀνόματι",709666,54],["κυρίου",707996,18],["καὶ",707031,7],["οἶκον",709516,6],["τῇ",709436,100],["βασιλείᾳ",702577,1],["αὐτοῦ",702165,102]],"And Solomon said that he would build a house to the name of the Lord, and a house for his kingdom."]]