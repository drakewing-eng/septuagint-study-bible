[["1",[["υἱὸς",713075,4],["εἴκοσι",704085,59],["ἐτῶν",705543,44],["Αχαζ",702245,4],["ἐν",704639,0],["τῷ",709436,53],["βασιλεῦσαι",702581,106],["αὐτὸν",702165,85],["καὶ",707031,7],["δέκα",703333,59],["ἓξ",704828,59],["ἔτη",705543,42],["ἐβασίλευσεν",702581,2],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["οὐκ",709805,28],["ἐποίησεν",710582,2],["τὸ",709436,24],["εὐθὲς",705596,46],["ἐνώπιον",704823,0],["κυρίου",707996,18],["ὡς",714148,28],["Δαυιδ",703232,4],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτοῦ",702165,102]],"Achaz was five and twenty years old when he began to reign, and he reigned sixteen years in Jerusalem: and he did not that which was right in the sight of the Lord, as David his father."],["2",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["κατὰ",707200,0],["τὰς",709436,38],["ὁδοὺς",709458,39],["βασιλέων",702580,81],["Ισραηλ",706839,18],["καὶ",707031,7],["γὰρ",702963,11],["γλυπτὰ",703117,68],["ἐποίησεν",710582,2],["τοῖς",709436,95],["εἰδώλοις",704079,96],["αὐτῶν",702165,40]],"But he walked in the ways of the kings of Israel, for he made graven images."],["3",[["καὶ",707031,7],["ἔθυεν",706349,13],["ἐν",704639,0],["Γαιβενενομ",702908,111],["καὶ",707031,7],["διῆγεν",703442,13],["τὰ",709436,41],["τέκνα",712761,42],["αὐτοῦ",702165,102],["διὰ",703417,0],["πυρὸς",711088,18],["κατὰ",707200,0],["τὰ",709436,41],["βδελύγματα",702604,42],["τῶν",709436,43],["ἐθνῶν",704068,44],["ὧν",709781,103],["ἐξωλέθρευσεν",704956,2],["κύριος",707996,4],["ἀπὸ",701425,0],["προσώπου",710986,21],["υἱῶν",713075,81],["Ισραηλ",706839,18]],"And [he sacrificed] to their idols in the valley of Benennom, and passed his children through the fire, according to the abominations of the heathen, whom the Lord cast out from before the children of Israel."],["4",[["καὶ",707031,7],["ἐθυμία",706332,13],["ἐπὶ",705080,0],["τῶν",709436,80],["ὑψηλῶν",713285,169],["καὶ",707031,7],["ἐπὶ",705080,0],["τῶν",709436,43],["δωμάτων",703896,44],["καὶ",707031,7],["ὑποκάτω",713204,28],["παντὸς",710177,92],["ξύλου",709427,21],["ἀλσώδους",700730,42]],"And he burnt incense upon the high places, and upon the roofs, and under every shady tree."],["5",[["καὶ",707031,7],["παρέδωκεν",710014,2],["αὐτὸν",702165,85],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["αὐτοῦ",702165,102],["διὰ",703417,0],["χειρὸς",713787,17],["βασιλέως",702580,18],["Συρίας",712533,17],["καὶ",707031,7],["ἐπάταξεν",710185,2],["ἐν",704639,0],["αὐτῷ",702165,50],["καὶ",707031,7],["ᾐχμαλώτευσεν",700500,2],["ἐξ",704132,0],["αὐτῶν",702165,40],["αἰχμαλωσίαν",700499,9],["πολλὴν",710646,36],["καὶ",707031,7],["ἤγαγεν",700209,2],["εἰς",704105,0],["Δαμασκόν",703275,6],["καὶ",707031,7],["γὰρ",702963,11],["εἰς",704105,0],["τὰς",709436,38],["χεῖρας",713787,39],["βασιλέως",702580,18],["Ισραηλ",706839,18],["παρέδωκεν",710014,2],["αὐτόν",702165,85],["καὶ",707031,7],["ἐπάταξεν",710185,2],["ἐν",704639,0],["αὐτῷ",702165,50],["πληγὴν",710527,9],["μεγάλην",708653,36]],"And the Lord his God delivered him into the hand of the king of Syria; and he smote him, and took captive of them a great band of prisoners, and carried him to Damascus. Also [God] delivered him into the hands of the king of Israel, who smote him with a great slaughter."],["6",[["καὶ",707031,7],["ἀπέκτεινεν",701498,2],["Φακεε",713315,4],["ὁ",709436,3],["τοῦ",709436,35],["Ρομελια",711289,18],["βασιλεὺς",702580,4],["Ισραηλ",706839,18],["ἐν",704639,0],["Ιουδα",706768,114],["ἐν",704639,0],["μιᾷ",704106,101],["ἡμέρᾳ",705984,1],["ἑκατὸν",704136,59],["εἴκοσι",704085,59],["χιλιάδας",713858,39],["ἀνδρῶν",701150,81],["δυνατῶν",703845,169],["ἰσχύι",706858,1],["ἐν",704639,0],["τῷ",709436,53],["αὐτοὺς",702165,62],["καταλιπεῖν",707305,106],["τὸν",709436,5],["κύριον",707996,6],["θεὸν",706192,6],["τῶν",709436,80],["πατέρων",710189,81],["αὐτῶν",702165,40]],"And Phakee the son of Romelias king of Israel, slew in Juda in one day a hundred and twenty thousand mighty men; because they had forsaken the Lord God of their fathers."],["7",[["καὶ",707031,7],["ἀπέκτεινεν",701498,2],["Εζεκρι",704046,4],["ὁ",709436,3],["δυνατὸς",703845,14],["τοῦ",709436,35],["Εφραιμ",705769,18],["τὸν",709436,5],["Μαασαιαν",708310,6],["τὸν",709436,5],["υἱὸν",713075,6],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["τὸν",709436,5],["Εσδρικαμ",705469,6],["ἡγούμενον",705931,212],["τοῦ",709436,35],["οἴκου",709516,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὸν",709436,5],["Ελκανα",704504,6],["τὸν",709436,5],["διάδοχον",703450,6],["τοῦ",709436,35],["βασιλέως",702580,18]],"And Zechri, a mighty man of Ephraim, slew Maasias the king's son, and Ezrican the chief of his house, and Elcana the king's deputy."],["8",[["καὶ",707031,7],["ᾐχμαλώτισαν",700501,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["ἀπὸ",701425,0],["τῶν",709436,80],["ἀδελφῶν",700249,81],["αὐτῶν",702165,40],["τριακοσίας",712936,119],["χιλιάδας",713858,39],["γυναῖκας",703209,39],["υἱοὺς",713075,57],["καὶ",707031,7],["θυγατέρας",706320,39],["καὶ",707031,7],["σκῦλα",711902,42],["πολλὰ",710646,68],["ἐσκύλευσαν",711900,150],["ἐξ",704132,0],["αὐτῶν",702165,40],["καὶ",707031,7],["ἤνεγκαν",713428,150],["τὰ",709436,41],["σκῦλα",711902,42],["εἰς",704105,0],["Σαμάρειαν",711449,9]],"And the children of Israel took captive of their brethren three hundred thousand, women, and sons, and daughters, and they spoiled them of much property, and brought the spoils to Samaria."],["9",[["καὶ",707031,7],["ἐκεῖ",704181,28],["ἦν",704093,13],["ὁ",709436,3],["προφήτης",711009,4],["τοῦ",709436,35],["κυρίου",707996,18],["Ωδηδ",714092,4],["ὄνομα",709666,25],["αὐτῷ",702165,50],["καὶ",707031,7],["ἐξῆλθεν",704909,2],["εἰς",704105,0],["ἀπάντησιν",701348,9],["τῆς",709436,16],["δυνάμεως",703839,17],["τῶν",709436,80],["ἐρχομένων",705453,299],["εἰς",704105,0],["Σαμάρειαν",711449,9],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["ἰδοὺ",706497,88],["ὀργὴ",709728,12],["κυρίου",707996,18],["θεοῦ",706192,18],["τῶν",709436,80],["πατέρων",710189,81],["ὑμῶν",713091,145],["ἐπὶ",705080,0],["τὸν",709436,5],["Ιουδαν",706775,6],["καὶ",707031,7],["παρέδωκεν",710014,2],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὰς",709436,38],["χεῖρας",713787,39],["ὑμῶν",713091,145],["καὶ",707031,7],["ἀπεκτείνατε",701498,265],["ἐν",704639,0],["αὐτοῖς",702165,151],["ἐν",704639,0],["ὀργῇ",709728,1],["ἕως",705792,0],["τῶν",709436,80],["οὐρανῶν",709844,81],["ἔφθακεν",713439,171]],"And there was there a prophet of the Lord, his name [was] Oded: and he went out to meet the host that were coming to Samaria, and said to them, Behold, the wrath of the Lord God of your fathers [is] upon Juda, and he has delivered them into your hands, and ye have slain them in wrath, and it has reached even to heaven."],["10",[["καὶ",707031,7],["νῦν",709384,28],["υἱοὺς",713075,57],["Ιουδα",706768,18],["καὶ",707031,7],["Ιερουσαλημ",706644,18],["ὑμεῖς",713081,219],["λέγετε",708124,87],["κατακτήσεσθαι",707293,492],["εἰς",704105,0],["δούλους",703817,57],["καὶ",707031,7],["δούλας",703815,39],["οὐκ",709805,28],["ἰδού",706497,88],["εἰμι",704093,157],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["μαρτυρῆσαι",708523,106],["κυρίῳ",707996,114],["θεῷ",706192,114],["ὑμῶν",713091,145]],"And now ye talk of keeping the children of Juda and Jerusalem for servants and handmaidens. Lo, am I not with you to testify for the Lord your God?"],["11",[["καὶ",707031,7],["νῦν",709384,28],["ἀκούσατέ",700587,74],["μου",709032,133],["καὶ",707031,7],["ἀποστρέψατε",701598,74],["τὴν",709436,8],["αἰχμαλωσίαν",700499,9],["ἣν",709781,131],["ᾐχμαλωτεύσατε",700500,265],["τῶν",709436,80],["ἀδελφῶν",700249,81],["ὑμῶν",713091,145],["ὅτι",709803,7],["ὀργὴ",709728,12],["θυμοῦ",706334,18],["κυρίου",707996,18],["ἐφ᾿",705080,0],["ὑμῖν",713084,90]],"And now hearken to me, and restore the prisoners of your brethren whom ye have taken: for the fierce anger of the Lord [is] upon you."],["12",[["καὶ",707031,7],["ἀνέστησαν",701173,150],["ἄρχοντες",701862,52],["ἀπὸ",701425,0],["τῶν",709436,80],["υἱῶν",713075,81],["Εφραιμ",705769,18],["Ουδια",709820,4],["ὁ",709436,3],["τοῦ",709436,35],["Ιωανου",706893,18],["καὶ",707031,7],["Βαραχιας",702526,4],["ὁ",709436,3],["τοῦ",709436,35],["Μοσολαμωθ",709021,18],["καὶ",707031,7],["Εζεκιας",704044,4],["ὁ",709436,3],["τοῦ",709436,35],["Σελλημ",711653,18],["καὶ",707031,7],["Αμασιας",700784,4],["ὁ",709436,3],["τοῦ",709436,35],["Χοδλι",713890,18],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἐρχομένους",705453,236],["ἀπὸ",701425,0],["τοῦ",709436,35],["πολέμου",710605,18]],"And the chiefs of the sons of Ephraim rose up, Udias the son of Joanas, and Barachias the son of Mosolamoth, and Ezekias the son of Sellem, and Amasias the son of Eldai, against those that came from the war,"],["13",[["καὶ",707031,7],["εἶπαν",705373,150],["αὐτοῖς",702165,151],["οὐ",709805,28],["μὴ",708851,28],["εἰσαγάγητε",704107,125],["τὴν",709436,8],["αἰχμαλωσίαν",700499,9],["ὧδε",714090,28],["πρὸς",710844,0],["ἡμᾶς",705981,194],["ὅτι",709803,7],["εἰς",704105,0],["τὸ",709436,24],["ἁμαρτάνειν",700773,55],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["ὑμεῖς",713081,219],["λέγετε",708124,87],["προσθεῖναι",710965,106],["ἐπὶ",705080,0],["ταῖς",709436,75],["ἁμαρτίαις",700775,76],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐπὶ",705080,0],["τὴν",709436,8],["ἄγνοιαν",700177,9],["ὅτι",709803,7],["πολλὴ",710646,29],["ἡ",709436,10],["ἁμαρτία",700775,12],["ἡμῶν",705999,145],["καὶ",707031,7],["ὀργὴ",709728,12],["θυμοῦ",706334,18],["κυρίου",707996,18],["ἐπὶ",705080,0],["τὸν",709436,5],["Ισραηλ",706839,6]],"and said to them, Ye shall not bring in hither the prisoners to us, for whereas sin against the Lord [is] upon us, ye mean to add to our sins, and to our trespass: for our sin [is] great, and the fierce anger of the Lord [is] upon Israel."],["14",[["καὶ",707031,7],["ἀφῆκαν",702211,150],["οἱ",709436,136],["πολεμισταὶ",710604,52],["τὴν",709436,8],["αἰχμαλωσίαν",700499,9],["καὶ",707031,7],["τὰ",709436,41],["σκῦλα",711902,42],["ἐναντίον",704654,0],["τῶν",709436,80],["ἀρχόντων",701862,81],["καὶ",707031,7],["πάσης",710177,82],["τῆς",709436,16],["ἐκκλησίας",704216,17]],"So the warriors left the prisoners and the spoils before the princes and all the congregation."],["15",[["καὶ",707031,7],["ἀνέστησαν",701173,150],["ἄνδρες",701150,52],["οἳ",709781,250],["ἐπεκλήθησαν",705153,99],["ἐν",704639,0],["ὀνόματι",709666,54],["καὶ",707031,7],["ἀντελάβοντο",701243,189],["τῆς",709436,16],["αἰχμαλωσίας",700499,17],["καὶ",707031,7],["πάντας",710177,60],["τοὺς",709436,58],["γυμνοὺς",703202,60],["περιέβαλον",710294,150],["ἀπὸ",701425,0],["τῶν",709436,43],["σκύλων",711902,44],["καὶ",707031,7],["ἐνέδυσαν",704701,150],["αὐτοὺς",702165,62],["καὶ",707031,7],["ὑπέδησαν",713194,150],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἔδωκαν",703654,150],["φαγεῖν",713296,106],["καὶ",707031,7],["ἀλείψασθαι",700644,109],["καὶ",707031,7],["ἀντελάβοντο",701243,189],["ἐν",704639,0],["ὑποζυγίοις",713198,96],["παντὸς",710177,116],["ἀσθενοῦντος",701938,152],["καὶ",707031,7],["κατέστησαν",707011,150],["αὐτοὺς",702165,62],["εἰς",704105,0],["Ιεριχω",706620,227],["πόλιν",710612,9],["φοινίκων",713541,81],["πρὸς",710844,0],["τοὺς",709436,58],["ἀδελφοὺς",700249,57],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπέστρεψαν",705278,150],["εἰς",704105,0],["Σαμάρειαν",711449,9]],"And the men who were called by name rose up, and took hold of the prisoners, and clothed all the naked from the spoils, and gave them garments and shoes, and gave them [food] to eat, and [oil] to anoint themselves [with], and they helped also every one that was weak with asses, and placed them in Jericho, the city of palm-trees, with their brethren; and they returned to Samaria."],["16",[["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["ἀπέστειλεν",701592,2],["Αχαζ",702245,4],["πρὸς",710844,0],["βασιλέα",702580,6],["Ασσουρ",702001,18],["βοηθῆσαι",702746,106],["αὐτῷ",702165,50]],"At that time king Achaz sent to the king of Assyria to help him, and on this occasion,"],["17",[["καὶ",707031,7],["ἐν",704639,0],["τούτῳ",709858,50],["ὅτι",709803,7],["Ιδουμαῖοι",706503,191],["ἐπέ