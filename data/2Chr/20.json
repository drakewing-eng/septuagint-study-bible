[["1",[["καὶ",707031,7],["μετὰ",708780,0],["ταῦτα",709858,71],["ἦλθον",705453,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Μωαβ",709085,18],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["Αμμων",700847,18],["καὶ",707031,7],["μετ᾿",708780,0],["αὐτῶν",702165,40],["ἐκ",704132,0],["τῶν",709436,80],["Μιναίων",708924,81],["πρὸς",710844,0],["Ιωσαφατ",706942,6],["εἰς",704105,0],["πόλεμον",710605,6]],"And after this came the children of Moab, and the children of Ammon, and with them [some] of the Minæans, against Josaphat to battle."],["2",[["καὶ",707031,7],["ἦλθον",705453,150],["καὶ",707031,7],["ὑπέδειξαν",713192,150],["τῷ",709436,113],["Ιωσαφατ",706942,114],["λέγοντες",708124,146],["ἥκει",705956,91],["ἐπὶ",705080,0],["σὲ",711598,163],["πλῆθος",710529,15],["πολὺ",710646,26],["ἐκ",704132,0],["πέραν",710280,28],["τῆς",709436,16],["θαλάσσης",706069,17],["ἀπὸ",701425,0],["Συρίας",712533,17],["καὶ",707031,7],["ἰδού",706497,88],["εἰσιν",704093,197],["ἐν",704639,0],["Ασασανθαμαρ",701893,111],["αὕτη",709858,107],["ἐστὶν",704093,91],["Ενγαδδι",704670,12]],"And they came and told Josaphat, saying, There is come against thee a great multitude from Syria, from beyond the sea; and, behold, they are in Asasan Thamar, this is Engadi."],["3",[["καὶ",707031,7],["ἐφοβήθη",713532,37],["καὶ",707031,7],["ἔδωκεν",703654,2],["Ιωσαφατ",706942,4],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["ἐκζητῆσαι",704187,106],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["ἐκήρυξεν",707662,2],["νηστείαν",709303,9],["ἐν",704639,0],["παντὶ",710177,30],["Ιουδα",706768,114]],"And Josaphat was alarmed, and set his face to seek the Lord earnestly, and he proclaimed a fast in all Juda."],["4",[["καὶ",707031,7],["συνήχθη",712375,37],["Ιουδας",706775,4],["ἐκζητῆσαι",704187,106],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["ἀπὸ",701425,0],["πασῶν",710177,198],["τῶν",709436,130],["πόλεων",710612,65],["Ιουδα",706768,18],["ἦλθον",705453,150],["ζητῆσαι",705879,106],["τὸν",709436,5],["κύριον",707996,6]],"And Juda gathered themselves together to seek after the Lord: even from all the cities of Juda they came to seek the Lord."],["5",[["καὶ",707031,7],["ἀνέστη",701173,2],["Ιωσαφατ",706942,4],["ἐν",704639,0],["ἐκκλησίᾳ",704216,1],["Ιουδα",706768,18],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18],["κατὰ",707200,0],["πρόσωπον",710986,25],["τῆς",709436,16],["αὐλῆς",702137,17],["τῆς",709436,16],["καινῆς",707042,82]],"And Josaphat stood up in the assembly of Juda in Jerusalem, in the house of the Lord, in front of the new court."],["6",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριε",707996,153],["ὁ",709436,630],["θεὸς",706192,153],["τῶν",709436,80],["πατέρων",710189,81],["ἡμῶν",705999,145],["οὐχὶ",709862,28],["σὺ",712181,164],["εἶ",704093,154],["θεὸς",706192,4],["ἐν",704639,0],["οὐρανῷ",709844,114],["καὶ",707031,7],["σὺ",712181,164],["κυριεύεις",707995,154],["πασῶν",710177,198],["τῶν",709436,130],["βασιλειῶν",702577,65],["τῶν",709436,43],["ἐθνῶν",704068,44],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["χειρί",713787,1],["σου",711945,133],["ἰσχὺς",706858,12],["δυναστείας",703841,17],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["πρὸς",710844,0],["σὲ",711598,163],["ἀντιστῆναι",701154,106]],"And he said, O Lord God of my fathers, art not thou God in heaven above, and art not thou Lord of all the kingdoms of the nations? and [is there] not in thy hand the might of dominion, and there is no one who can resist thee?"],["7",[["οὐχὶ",709862,28],["σὺ",712181,164],["εἶ",704093,154],["ὁ",709436,3],["κύριος",707996,4],["ὁ",709436,3],["ἐξολεθρεύσας",704956,182],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104],["ἀπὸ",701425,0],["προσώπου",710986,21],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133],["Ισραηλ",706839,18],["καὶ",707031,7],["ἔδωκας",703654,162],["αὐτὴν",702165,104],["σπέρματι",712008,54],["Αβρααμ",700091,18],["τῷ",709436,113],["ἠγ