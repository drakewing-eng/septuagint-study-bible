[["1",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Εζεκιας",704044,4],["ἐπὶ",705080,0],["πάντα",710177,27],["Ισραηλ",706839,6],["καὶ",707031,7],["Ιουδαν",706775,6],["καὶ",707031,7],["ἐπιστολὰς",705272,39],["ἔγραψεν",703194,2],["ἐπὶ",705080,0],["τὸν",709436,5],["Εφραιμ",705769,6],["καὶ",707031,7],["Μανασση",708470,6],["ἐλθεῖν",705453,106],["εἰς",704105,0],["οἶκον",709516,6],["κυρίου",707996,18],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["ποιῆσαι",710582,106],["τὸ",709436,24],["φασεκ",713379,25],["τῷ",709436,113],["κυρίῳ",707996,114],["θεῷ",706192,114],["Ισραηλ",706839,18]],"And Ezekias sent to all Israel and Juda, and wrote letters to Ephraim and Manasse, that they should come into the house of the Lord to Jerusalem, to keep the passover to the Lord God of Israel."],["2",[["καὶ",707031,7],["ἐβουλεύσατο",702791,23],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["οἱ",709436,136],["ἄρχοντες",701862,52],["καὶ",707031,7],["πᾶσα",710177,29],["ἡ",709436,10],["ἐκκλησία",704216,12],["ἡ",709436,10],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["ποιῆσαι",710582,106],["τὸ",709436,24],["φασεκ",713379,25],["τῷ",709436,113],["μηνὶ",708874,114],["τῷ",709436,113],["δευτέρῳ",703389,30]],"For the king, and the princes, and all the congregation in Jerusalem, designed to keep the passover in the second month."],["3",[["οὐ",709805,28],["γὰρ",702963,11],["ἠδυνάσθησαν",703838,99],["αὐτὸ",702165,129],["ποιῆσαι",710582,106],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["ὅτι",709803,7],["οἱ",709436,136],["ἱερεῖς",706614,52],["οὐχ",709805,28],["ἡγνίσθησαν",700172,99],["ἱκανοί",706710,138],["καὶ",707031,7],["ὁ",709436,3],["λαὸς",708094,4],["οὐ",709805,28],["συνήχθη",712375,37],["εἰς",704105,0],["Ιερουσαλημ",706644,9]],"For they could not keep it at that time, because a sufficient number of priests had not purified themselves, and the people was not gathered to Jerusalem."],["4",[["καὶ",707031,7],["ἤρεσεν",701722,2],["ὁ",709436,3],["λόγος",708236,4],["ἐναντίον",704654,0],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["ἐναντίον",704654,0],["τῆς",709436,16],["ἐκκλησίας",704216,17]],"And the proposal pleased the king and the congregation."],["5",[["καὶ",707031,7],["ἔστησαν",706846,150],["λόγον",708236,6],["διελθεῖν",703673,106],["κήρυγμα",707660,25],["ἐν",704639,0],["παντὶ",710177,30],["Ισραηλ",706839,114],["ἀπὸ",701425,0],["Βηρσαβεε",702702,18],["ἕως",705792,0],["Δαν",703276,18],["ἐλθόντας",705453,454],["ποιῆσαι",710582,106],["τὸ",709436,24],["φασεκ",713379,25],["κυρίῳ",707996,114],["θεῷ",706192,114],["Ισραηλ",706839,18],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["ὅτι",709803,7],["πλῆθος",710529,15],["οὐκ",709805,28],["ἐποίησεν",710582,2],["κατὰ",707200,0],["τὴν",709436,8],["γραφήν",703191,9]],"And they established a decree that a proclamation should go through all Israel, from Bersabee to Dan, that they should come and keep the passover to the Lord God of Israel at Jerusalem: for the multitude had not done it lately according to the scripture."],["6",[["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["οἱ",709436,136],["τρέχοντες",712931,146],["σὺν",712372,0],["ταῖς",709436,75],["ἐπιστολαῖς",705272,1],["παρὰ",709995,0],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["τῶν",709436,80],["ἀρχόντων",701862,81],["εἰς",704105,0],["πάντα",710177,27],["Ισραηλ",706839,6],["καὶ",707031,7],["Ιουδαν",706775,6],["κατὰ",707200,0],["τὸ",709436,24],["πρόσταγμα",710959,25],["τοῦ",709436,35],["βασιλέως",702580,18],["λέγοντες",708124,146],["υἱοὶ",713075,274],["Ισραηλ",706839,18],["ἐπιστρέψατε",705278,74],["πρὸς",710844,0],["θεὸν",706192,6],["Αβρααμ",700091,18],["καὶ",707031,7],["Ισαακ",706799,18],["καὶ",707031,7],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐπιστρέψει",705278,127],["τοὺς",709436,58],["ἀνασεσῳσμένους",701064,458],["τοὺς",709436,58],["καταλειφθέντας",707305,460],["ἀπὸ",701425,0],["χειρὸς",713787,17],["βασιλέως",702580,18],["Ασσουρ",702001,18]],"And the posts went with the letters from the king and the princes to all Israel and Juda, according to the command of the king, saying, Children of Israel, return to the Lord God of Abraam, and Isaac, and Israel, and bring back them that have escaped [even] those that were left of the hand of the king of Assyria."],["7",[["καὶ",707031,7],["μὴ",708851,28],["γίνεσθε",703104,73],["καθὼς",707030,28],["οἱ",709436,136],["πατέρες",710189,52],["ὑμῶν",713091,145],["καὶ",707031,7],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["ὑμῶν",713091,145],["οἳ",709781,250],["ἀπέστησαν",702214,150],["ἀπὸ",701425,0],["κυρίου",707996,18],["θεοῦ",706192,18],["πατέρων",710189,81],["αὐτῶν",702165,40],["καὶ",707031,7],["παρέδωκεν",710014,2],["αὐτοὺς",702165,62],["εἰς",704105,0],["ἐρήμωσιν",705422,9],["καθὼς",707030,28],["ὑμεῖς",713081,219],["ὁρᾶτε",709725,87]],"And be not as your fathers, and your brethren, who revolted from the Lord God of their fathers, and he gave them up to desolation, as ye see."],["8",[["καὶ",707031,7],["νῦν",709384,28],["μὴ",708851,28],["σκληρύνητε",711864,125],["τοὺς",709436,58],["τραχήλους",712924,57],["ὑμῶν",713091,145],["δότε",703654,74],["δόξαν",703791,9],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["καὶ",707031,7],["εἰσέλθατε",704114,74],["εἰς",704105,0],["τὸ",709436,24],["ἁγίασμα",700154,25],["αὐτοῦ",702165,102],["ὃ",709781,213],["ἡγίασεν",700153,2],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["δουλεύσατε",703814,74],["τῷ",709436,113],["κυρίῳ",707996,114],["θεῷ",706192,114],["ὑμῶν",713091,145],["καὶ",707031,7],["ἀποστρέψει",701598,127],["ἀφ᾿",701425,0],["ὑμῶν",713091,145],["θυμὸν",706334,6],["ὀργῆς",709728,17]],"And now harden not your hearts, as your fathers [did]: give glory to the Lord God, and enter into his sanctuary, which he has sanctified for ever: and serve the Lord your God, and he shall turn away [his] fierce anger from you."],["9",[["ὅτι",709803,7],["ἐν",704639,0],["τῷ",709436,53],["ἐπιστρέφειν",705278,55],["ὑμᾶς",713080,194],["πρὸς",710844,0],["κύριον",707996,6],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["ὑμῶν",713091,145],["καὶ",707031,7],["τὰ",709436,63],["τέκνα",712761,64],["ὑμῶν",713091,145],["ἔσονται",704093,135],["ἐν",704639,0],["οἰκτιρμοῖς",709520,148],["ἔναντι",704653,0],["πάντων",710177,169],["τῶν",709436,80],["αἰχμαλωτισάντων",700501,221],["αὐτούς",702165,62],["καὶ",707031,7],["ἀποστρέψει",701598,127],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104],["ὅτι",709803,7],["ἐλεήμων",704422,14],["καὶ",707031,7],["οἰκτίρμων",709521,14],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["καὶ",707031,7],["οὐκ",709805,28],["ἀποστρέψει",701598,127],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["ἀφ᾿",701425,0],["ἡμῶν",705999,145],["ἐὰν",703912,7],["ἐπιστρέψωμεν",705278,79],["πρὸς",710844,0],["αὐτόν",702165,85]],"For when ye turn to the Lord, your brethren and your children shall be pitied before all that have carried them captives, and he will restore [you] to this land: for the Lord our God is merciful and pitiful, and will not turn away his face from you, if we return to him."],["10",[["καὶ",707031,7],["ἦσαν",704093,137],["οἱ",709436,136],["τρέχοντες",712931,146],["διαπορευόμενοι",703551,348],["πόλιν",710612,9],["ἐκ",704132,0],["πόλεως",710612,17],["ἐν",704639,0],["τῷ",709436,53],["ὄρει",709768,54],["Εφραιμ",705769,18],["καὶ",707031,7],["Μανασση",708470,18],["καὶ",707031,7],["ἕως",705792,0],["Ζαβουλων",705813,18],["καὶ",707031,7],["ἐγένοντο",703104,189],["ὡς",714148,7],["καταγελῶντες",707222,146],["αὐτῶν",702165,40],["καὶ",707031,7],["καταμωκώμενοι",707335,348]],"So the posts went through from city to city in mount Ephraim, and Manasse, and as far as Zabulon: and they as it were laughed them to scorn, and mocked them."],["11",[["ἀλλὰ",700680,7],["ἄνθρωποι",701163,52],["Ασηρ",701934,18],["καὶ",707031,7],["ἀπὸ",701425,0],["Μανασση",708470,18],["καὶ",707031,7],["ἀπὸ",701425,0],["Ζαβουλων",705813,18],["ἐνετράπησαν",704805,99],["καὶ",707031,7],["ἦλθον",705453,150],["εἰς",704105,0],["Ιερουσαλημ",706644,9]],"But the men of Aser, and [some] of Manasses and of Zabulon, were ashamed, and came to Jerusalem and Juda."],["12",[["καὶ",707031,7],["ἐν",704639,0],["Ιουδα",706768,114],["ἐγένετο",703104,23],["χεὶρ",713787,12],["κυρίου",707996,18],["δοῦναι",703654,106],["αὐτοῖς",702165,151],["καρδίαν",707141,9],["μίαν",704106,36],["ἐλθεῖν",705453,106],["τοῦ",709436,20],["ποιῆσαι",710582,106],["κατὰ",707200,0],["τὸ",709436,24],["πρόσταγμα",710959,25],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["τῶν",709436,80],["ἀρχόντων",701862,81],["ἐν",704639,0],["λόγῳ",708236,114],["κυρίου",707996,18]],"And the hand of the Lord was [present] to give them one heart to come, to do according to the commands of the king and of the princes, by the word of the Lord."],["13",[["καὶ",707031,7],["συνήχθησαν",712375,99],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["λαὸς",708094,4],["πολὺς",710646,14],["τοῦ",709436,20],["ποιῆσαι",710582,106],["τὴν",709436,8],["ἑορτὴν",704990,9],["τῶν",709436,80],["ἀζύμων",700345,169],["ἐν",704639,0],["τῷ",709436,113],["μηνὶ",708874,114],["τῷ",709436,113],["δευτέρῳ",703389,30],["ἐκκλησία",704216,12],["πολλὴ",710646,29],["σφόδρα",712586,28]],"And a great multitude were gathered to Jerusalem to keep the feast of unleavened bread in the second month, a very great congregation."],["14",[["καὶ",707031,7],["ἀνέστησαν",701173,150],["καὶ",707031,7],["καθεῖλαν",706982,396],["τὰ",709436,41],["θυσιαστήρια",706348,42],["τὰ",709436,41],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["πάντα",710177,27],["ἐν",704639,0],["οἷς",709781,311],["ἐθυμιῶσαν",706332,150],["τοῖς",709436,147],["ψευδέσιν",714036,230],["κατέσπασαν",707431,150],["καὶ",707031,7],["ἔρριψαν",711267,150],["εἰς",704105,0],["τὸν",709436,5],["χειμάρρουν",713783,27],["Κεδρων",707591,118]],"And they arose, and took away the altars that were in Jerusalem, and all on which they burnt incense to false [gods] they tore down and cast into the brook Kedron."],["15",[["καὶ",707031,7],["ἔθυσαν",706349,150],["τὸ",709436,24],["φασεκ",713379,25],["τῇ",709436,100],["τεσσαρεσκαιδεκάτῃ",712809,101],["τοῦ",709436,35],["μηνὸς",708874,18],["τοῦ",709436,35],["δευτέρου",703389,116],["καὶ",707031,7],["οἱ",709436,136],["ἱερεῖς",706614,52],["καὶ",707031,7],["οἱ",709436,136],["Λευῖται",708160,52],["ἐνετράπησαν",704805,99],["καὶ",707031,7],["ἡγνίσθησαν",700172,99],["καὶ",707031,7],["εἰσήνεγκαν",704127,150],["ὁλοκαυτώματα",709589,42],["εἰς",704105,0],["οἶκον",709516,6],["κυρίου",707996,18]],"Then they killed the passover on the fourteenth day of the second month: and the priests and the Levites repented, and purified [themselves], and brought whole-burnt-offerings into the house of the Lord."],["16",[["καὶ",707031,7],["ἔστησαν",706846,150],["ἐπὶ",705080,0],["τὴν",709436,8],["στάσιν",712049,9],["αὐτῶν",702165,40],["κατὰ",707200,0],["τὸ",709436,24],["κρίμα",707903,25],["αὐτῶν",702165,40],["κατὰ",707200,0],["τὴν",709436,8],["ἐντολὴν",704802,9],["Μωυσῆ",709112,18],["ἀνθρώπου",701163,18],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["οἱ",709436,136],["ἱερεῖς",706614,52],["ἐδέχοντο",703393,139],["τὰ",709436,41],["αἵματα",700442,42],["ἐκ",704132,0],["χειρὸς",713787,17],["τῶν",709436,80],["Λευιτῶν",708160,81]],"And they stood at their post, according to their ordinance, according to the commandment of Moses the man of God: and the priests received the blood from the hand of the Levites."],["17",[["ὅτι",709803,7],["πλῆθος",710529,15],["τῆς",709436,16],["ἐκκλησίας",704216,17],["οὐχ",709805,28],["ἡγνίσθη",700172,37],["καὶ",707031,7],["οἱ",709436,136],["Λευῖται",708160,52],["ἦσαν",704093,137],["τοῦ",709436,20],["θύειν",706349,55],["τὸ",709436,24],["φασεκ",713379,25],["παντὶ",710177,30],["τῷ",709436,113],["μὴ",708851,28],["δυναμένῳ",703838,241],["ἁγνισθῆναι",700172,179],["τῷ",709436,113],["κυρίῳ",707996,114]],"For a great part of the congregation was not sanctified; and the Levites were [ready] to kill the passover for every one who could not sanctify himself to the Lord."],["18",[["ὅτι",709803,7],["τὸ",709436,24],["πλεῖστον",710513,534],["τοῦ",709436,35],["λαοῦ",708094,18],["ἀπὸ",701425,0],["Εφραιμ",705769,18],["καὶ",707031,7],["Μανασση",708470,18],["καὶ",707031,7],["Ισσαχαρ",706843,18],["καὶ",707031,7],["Ζαβουλων",705813,18],["οὐχ",709805,28],["ἡγνίσθησαν",700172,99],["ἀλλὰ",700680,7],["ἔφαγον",713296,150],["τὸ",709436,24],["φασεκ",713379,25],["παρὰ",709995,0],["τὴν",709436,8],["γραφήν",703191,9],["καὶ",707031,7],["προσηύξατο",710893,23],["Εζεκιας",704044,4],["περὶ",710285,0],["αὐτῶν",702165,40],["λέγων",708124,72],["κύριος",707996,4],["ὁ",709436,3],["ἀγαθὸς",700106,14],["ἐξιλασάσθω",704932,315],["ὑπὲρ",713111,0]],"For the greatest part of the people of Ephraim, and Manasse, and Issachar, and Zabulon, had not purified [themselves], but ate the passover contrary to the scripture. On this account also Ezekias prayed concerning them, saying,"],["19",[["πάσης",710177,82],["καρδίας",707141,17],["κατευθυνούσης",707521,493],["ἐκζητῆσαι",704187,106],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["τῶν",709436,80],["πατέρων",710189,81],["αὐτῶν",702165,40],["καὶ",707031,7],["οὐ",709805,28],["κατὰ",707200,0],["τὴν",709436,8],["ἁγνείαν",700171,9],["τῶν",709436,80],["ἁγίων",700159,169]],"The good Lord be merciful with regard to every heart that sincerely seeks the Lord God of their fathers, and [is] not [purified] according to the purification of the sanctuary."],["20",[["καὶ",707031,7],["ἐπήκουσεν",705009,2],["κύριος",707996,4],["τῷ",709436,113],["Εζεκια",704044,114],["καὶ",707031,7],["ἰάσατο",706424,23],["τὸν",709436,5],["λαόν",708094,6]],"And the Lord hearkened to Ezekias, and healed the people."],["21",[["καὶ",707031,7],["ἐποίησαν",710582,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["οἱ",709436,136],["εὑρεθέντες",705676,247],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["τὴν",709436,8],["ἑορτὴν",704990,9],["τῶν",709436,80],["ἀζύμων",700345,169],["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["ἐν",704639,0],["εὐφροσύνῃ",705717,1],["μεγάλῃ",708653,101],["καὶ",707031,7],["καθυμνοῦντες",707024,146],["τῷ",709436,113],["κυρίῳ",707996,114],["ἡμέραν",705984,9],["καθ᾿",707200,0],["ἡμέραν",705984,9],["καὶ",707031,7],["οἱ",709436,136],["ἱερεῖς",706614,52],["καὶ",707031,7],["οἱ",709436,136],["Λευῖται",708160,52],["ἐν",704639,0],["ὀργάνοις",709727,96],["τῷ",709436,113],["κυρίῳ",707996,114]],"And the children of Israel who were present in Jerusalem kept the feast of unleavened bread seven days with great joy; and they continued to sing hymns to the Lord daily, and the priests and the Levites [played] on instruments to the Lord."],["22",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["Εζεκιας",704044,4],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["καρδίαν",707141,9],["τῶν",709436,80],["Λευιτῶν",708160,81],["καὶ",707031,7],["τῶν",709436,80],["συνιόντων",712435,170],["σύνεσιν",712460,9],["ἀγαθὴν",700106,36],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["συνετέλεσαν",712510,150],["τὴν",709436,8],["ἑορτὴν",704990,9],["τῶν",709436,80],["ἀζύμων",700345,169],["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["θύοντες",706349,146],["θυσίας",706345,39],["σωτηρίου",712659,21],["καὶ",707031,7],["ἐξομολογούμενοι",704960,348],["τῷ",709436,113],["κυρίῳ",707996,114],["θεῷ",706192,114],["τῶν",709436,80],["πατέρων",710189,81],["αὐτῶν",702165,40]],"And Ezekias encouraged all the Levites, and those that had good understanding of the Lord: and they completely kept the feast of unleavened bread seven days, offering peace-offerings, and confessing to the Lord God of their fathers."],["23",[["καὶ",707031,7],["ἐβουλεύσατο",702791,23],["ἡ",709436,10],["ἐκκλησία",704216,12],["ἅμα",700745,28],["ποιῆσαι",710582,106],["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["ἄλλας",700697,231],["καὶ",707031,7],["ἐποίησαν",710582,150],["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["ἐν",704639,0],["εὐφροσύνῃ",705717,1]],"And the congregation purposed together to keep other seven days: and they kept seven days with gladness."],["24",[["ὅτι",709803,7],["Εζεκιας",704044,4],["ἀπήρξατο",