,709436,3],["βασιλεὺς",702580,4],["Ιωσιας",706950,4],["εἰς",704105,0],["συνάντησιν",712397,9],["αὐτῷ",702165,50]],"And Pharao Nechao king of Egypt went up against the king of the Assyrians to the river Euphrates, and king Josias went to meet him."],["21",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["πρὸς",710844,0],["αὐτὸν",702165,85],["ἀγγέλους",700140,57],["λέγων",708124,72],["τί",712867,579],["ἐμοὶ",704577,159],["καὶ",707031,7],["σοί",711925,159],["βασιλεῦ",702580,153],["Ιουδα",706768,18],["οὐκ",709805,28],["ἐπὶ",705080,0],["σὲ",711598,163],["ἥκω",705956,157],["σήμερον",711751,28],["πόλεμον",710605,6],["ποιῆσαι",710582,106],["καὶ",707031,7],["ὁ",709436,3],["θεὸς",706192,4],["εἶπεν",705373,2],["κατασπεῦσαί",707433,106],["με",708618,163],["πρόσεχε",710895,240],["ἀπὸ",701425,0],["τοῦ",709436,35],["θεοῦ",706192,18],["τοῦ",709436,35],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["μὴ",708851,28],["καταφθείρῃ",707474,204],["σε",711598,163]],"And he sent messengers to him, saying, What have I to do with thee, O king of Juda? I am not come to-day to war against thee; and God has told me to hasten: beware of the God that is with me, lest he destroy thee."],["22",[["καὶ",707031,7],["οὐκ",709805,28],["ἀπέστρεψεν",701598,2],["Ιωσιας",706950,4],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["ἀλλ᾿",700680,7],["ἢ",705924,7],["πολεμεῖν",710601,55],["αὐτὸν",702165,85],["ἐκραταιώθη",707875,37],["καὶ",707031,7],["οὐκ",709805,28],["ἤκουσεν",700587,2],["τῶν",709436,80],["λόγων",708236,81],["Νεχαω",709284,18],["διὰ",703417,0],["στόματος",712125,21],["θεοῦ",706192,18],["καὶ",707031,7],["ἦλθεν",705453,2],["τοῦ",709436,20],["πολεμῆσαι",710601,106],["ἐν",704639,0],["τῷ",709436,53],["πεδίῳ",710215,54],["Μαγεδων",708340,118]],"However Josias turned not his face from him, but strengthened himself to fight against him, and hearkened not to the words of Nechao by the mouth of God, and he came to fight in the plain of Mageddo."],["23",[["καὶ",707031,7],["ἐτόξευσαν",712896,150],["οἱ",709436,136],["τοξόται",712899,52],["ἐπὶ",705080,0],["βασιλέα",702580,6],["Ιωσιαν",706950,6],["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["τοῖς",709436,147],["παισὶν",709932,148],["αὐτοῦ",702165,102],["ἐξαγάγετέ",704834,335],["με",708618,163],["ὅτι",709803,7],["ἐπόνεσα",710656,155],["σφόδρα",712586,28]],"And the archers shot at king Josias; and the king said to his servants, Take me away, for I am severely wounded."],["24",[["καὶ",707031,7],["ἐξήγαγον",704834,150],["αὐτὸν",702165,85],["οἱ",709436,136],["παῖδες",709932,52],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["τοῦ",709436,20],["ἅρματος",701768,21],["καὶ",707031,7],["ἀνεβίβασαν",700910,150],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["τὸ",709436,24],["ἅρμα",701768,25],["τὸ",709436,24],["δευτερεῦον",703384,47],["ὃ",709781,213],["ἦν",704093,13],["αὐτῷ",702165,50],["καὶ",707031,7],["ἤγαγον",700209,150],["αὐτὸν",702165,85],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["ἀπέθανεν",701461,2],["καὶ",707031,7],["ἐτάφη",706103,37],["μετὰ",708780,0],["τῶν",709436,80],["πατέρων",710189,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["πᾶς",710177,14],["Ιουδα",706768,4],["καὶ",707031,7],["Ιερουσαλημ",706644,12],["ἐπένθησαν",710251,150],["ἐπὶ",705080,0],["Ιωσιαν",706950,6]],"And his servants lifted him out of the chariot, and put him in the second chariot which he had, and brought him to Jerusalem; and he died, and was buried with his fathers: and all Juda and Jerusalem lamented over Josias."],["25",[["καὶ",707031,7],["ἐθρήνησεν",706306,2],["Ιερεμιας",706611,4],["ἐπὶ",705080,0],["Ιωσιαν",706950,6],["καὶ",707031,7],["εἶπαν",705373,150],["πάντες",710177,138],["οἱ",709436,136],["ἄρχοντες",701862,52],["καὶ",707031,7],["αἱ",709436,190],["ἄρχουσαι",701860,306],["θρῆνον",706309,6],["ἐπὶ",705080,0],["Ιωσιαν",706950,6],["ἕως",705792,0],["τῆς",709436,16],["σήμερον",711751,28],["καὶ",707031,7],["ἔδωκαν",703654,150],["αὐτὸν",702165,85],["εἰς",704105,0],["πρόσταγμα",710959,25],["ἐπὶ",705080,0],["Ισραηλ",706839,6],["καὶ",707031,7],["ἰδοὺ",706497,88],["γέγραπται",703194,187],["ἐπὶ",705080,0],["τῶν",709436,80],["θρήνων",706309,81]],"And Jeremias mourned over Josias, and all the chief men and chief women uttered a lamentation over Josias until this day: and they made it an ordinance for Israel, and, behold, it is written in the lamentations."],["26",[["καὶ",707031,7],["ἦσαν",704093,137],["οἱ",709436,136],["λόγοι",708236,52],["Ιωσια",706950,18],["καὶ",707031,7],["ἡ",709436,10],["ἐλπὶς",704530,12],["αὐτοῦ",702165,102],["γεγραμμένα",703194,388],["ἐν",704639,0],["νόμῳ",709349,114],["κυρίου",707996,18]],"And the rest of the acts of Josias, and his hope, are written in the law of the Lord."],["27",[["καὶ",707031,7],["οἱ",709436,136],["λόγοι",708236,52],["αὐτοῦ",702165,102],["οἱ",709436,136],["πρῶτοι",711041,480],["καὶ",707031,7],["οἱ",709436,136],["ἔσχατοι",705519,138],["ἰδοὺ",706497,88],["γεγραμμένοι",703194,429],["ἐπὶ",705080,0],["βιβλίῳ",702719,54],["βασιλέων",702580,81],["Ισραηλ",706839,18],["καὶ",707031,7],["Ιουδα",706768,18]],"And his acts, the first and the last, behold, [they are] written in the book of the kings of Israel and Juda."]]