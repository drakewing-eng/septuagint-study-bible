[["1",[["καὶ",707031,7],["ἐποίησεν",710582,2],["Ιωσιας",706950,4],["τὸ",709436,24],["φασεχ",713380,25],["τῷ",709436,113],["κυρίῳ",707996,114],["θεῷ",706192,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔθυσαν",706349,150],["τὸ",709436,24],["φασεχ",713380,25],["τῇ",709436,100],["τεσσαρεσκαιδεκάτῃ",712809,101],["τοῦ",709436,35],["μηνὸς",708874,18],["τοῦ",709436,35],["πρώτου",711041,216]],"And Josias kept a passover to the Lord his God; and sacrificed the passover on the fourteenth day of the first month."],["2",[["καὶ",707031,7],["ἔστησεν",706846,2],["τοὺς",709436,58],["ἱερεῖς",706614,57],["ἐπὶ",705080,0],["τὰς",709436,38],["φυλακὰς",713613,39],["αὐτῶν",702165,40],["καὶ",707031,7],["κατίσχυσεν",707531,2],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὰ",709436,41],["ἔργα",705396,42],["οἴκου",709516,18],["κυρίου",707996,18]],"And he appointed the priests at their charges, and encouraged them for the services of the house of the Lord."],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["τοῖς",709436,147],["Λευίταις",708160,148],["τοῖς",709436,147],["δυνατοῖς",703845,230],["ἐν",704639,0],["παντὶ",710177,30],["Ισραηλ",706839,114],["τοῦ",709436,20],["ἁγιασθῆναι",700153,179],["αὐτοὺς",702165,62],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["ἔθηκαν",712849,150],["τὴν",709436,8],["κιβωτὸν",707667,9],["τὴν",709436,8],["ἁγίαν",700159,36],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["ὃν",709781,112],["ᾠκοδόμησεν",709509,2],["Σαλωμων",711430,4],["υἱὸς",713075,4],["Δαυιδ",703232,18],["τοῦ",709436,35],["βασιλέως",702580,18],["Ισραηλ",706839,18],["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεύς",702580,4],["οὐκ",709805,28],["ἔστιν",704093,91],["ὑμῖν",713084,90],["ἆραι",700473,106],["ἐπ᾿",705080,0],["ὤμων",714114,81],["οὐθέν",709817,46],["νῦν",709384,28],["οὖν",709835,11],["λειτουργήσατε",708132,74],["τῷ",709436,113],["κυρίῳ",707996,114],["θεῷ",706192,114],["ὑμῶν",713091,145],["καὶ",707031,7],["τῷ",709436,113],["λαῷ",708094,114],["αὐτοῦ",702165,102],["Ισραηλ",706839,114]],"And he told the Levites that were able [to act] in all Israel, that they should consecrate themselves to the Lord: and they put the holy ark in the house which Solomon the son of David king of Israel built: and the king said, Ye must not carry anything on your shoulders: now then minister to the Lord your God, and to his people Israel."],["4",[["καὶ",707031,7],["ἑτοιμάσθητε",705539,372],["κατ᾿",707200,0],["οἴκους",709516,57],["πατριῶν",710192,65],["ὑμῶν",713091,145],["καὶ",707031,7],["κατὰ",707200,0],["τὰς",709436,38],["ἐφημερίας",705752,39],["ὑμῶν",713091,145],["κατὰ",707200,0],["τὴν",709436,8],["γραφὴν",703191,9],["Δαυιδ",703232,18],["βασιλέως",702580,18],["Ισραηλ",706839,18],["καὶ",707031,7],["διὰ",703417,0],["χειρὸς",713787,17],["Σαλωμων",711430,18],["υἱοῦ",713075,18],["αὐτοῦ",702165,102]],"And prepare yourselves according to the houses of your families, and according to your daily courses, according to the writing of David king of Israel, and [the order] by the hand of his son Solomon."],["5",[["καὶ",707031,7],["στῆτε",706846,125],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["κατὰ",707200,0],["τὰς",709436,38],["διαιρέσεις",703458,39],["οἴκων",709516,81],["πατριῶν",710192,65],["ὑμῶν",713091,145],["τοῖς",709436,147],["ἀδελφοῖς",700249,148],["ὑμῶν",713091,145],["υἱοῖς",713075,148],["τοῦ",709436,35],["λαοῦ",708094,18],["καὶ",707031,7],["μερὶς",708748,12],["οἴκου",709516,18],["πατριᾶς",710192,17],["τοῖς",709436,147],["Λευίταις",708160,148]],"And stand ye in the house according to the divisions of the houses of your families for your brethren the sons of the people; [so] also let there be for the Levites a division of the house of their family."],["6",[["καὶ",707031,7],["θύσατε",706349,74],["τὸ",709436,24],["φασεχ",713380,25],["καὶ",707031,7],["τὰ",709436,41],["ἅγια",700159,68],["ἑτοιμάσατε",705539,74],["τοῖς",709436,147],["ἀδελφοῖς",700249,148],["ὑμῶν",713091,145],["τοῦ",709436,20],["ποιῆσαι",710582,106],["κατὰ",707200,0],["τὸν",709436,5],["λόγον",708236,6],["κυρίου",707996,18],["διὰ",703417,0],["χειρὸς",713787,17],["Μωυσῆ",709112,18]],"And kill ye the passover, and prepare [it] for your brethren, to do according to the word of the Lord, by the hand of Moses."],["7",[["καὶ",707031,7],["ἀπήρξατο",701361,23],["Ιωσιας",706950,4],["τοῖς",709436,147],["υἱοῖς",713075,148],["τοῦ",709436,35],["λαοῦ",708094,18],["πρόβατα",710768,42],["καὶ",707031,7],["ἀμνοὺς",700855,57],["καὶ",707031,7],["ἐρίφους",705429,57],["ἀπὸ",701425,0],["τῶν",709436,43],["τέκνων",712761,44],["τῶν",709436,80],["αἰγῶν",700464,81],["πάντα",710177,27],["εἰς",704105,0],["τὸ",709436,24],["φασεχ",713380,25],["εἰς",704105,0],["πάντας",710177,60],["τοὺς",709436,58],["εὑρεθέντας",705676,460],["εἰς",704105,0],["ἀριθμὸν",701744,6],["τριάκοντα",712934,59],["χιλιάδας",713858,39],["καὶ",707031,7],["μόσχων",709029,81],["τρεῖς",712927,524],["χιλιάδας",713858,39],["ταῦτα",709858,71],["ἀπὸ",701425,0],["τῆς",709436,16],["ὑπάρξεως",713101,17],["τοῦ",709436,35],["βασιλέως",702580,18]],"And Josias gave as an offering to the children of the people, sheep, and lambs, and kids of the young of the goats, all for the passover, [even for] all that were found, in number [amounting to] thirty thousand, and three thousand calves, these [were] of the substance of the king."],["8",[["καὶ",707031,7],["οἱ",709436,136],["ἄρχοντες",701862,52],["αὐτοῦ",702165,102],["ἀπήρξαντο",701361,189],["τῷ",709436,113],["λαῷ",708094,114],["καὶ",707031,7],["τοῖς",709436,147],["ἱερεῦσιν",706614,148],["καὶ",707031,7],["Λευίταις",708160,148],["ἔδωκεν",703654,2],["Χελκιας",713815,4],["καὶ",707031,7],["Ζαχαριας",705847,4],["καὶ",707031,7],["Ιιηλ",706707,4],["οἱ",709436,136],["ἄρχοντες",701862,52],["οἴκου",709516,18],["τοῦ",709436,35],["θεοῦ",706192,18],["τοῖς",709436,147],["ἱερεῦσιν",706614,148],["καὶ",707031,7],["ἔδωκαν",703654,150],["εἰς",704105,0],["τὸ",709436,24],["φασεχ",713380,25],["πρόβατα",710768,42],["καὶ",707031,7],["ἀμνοὺς",700855,57],["καὶ",707031,7],["ἐρίφους",705429,57],["δισχίλια",703747,68],["ἑξακόσια",704847,68],["καὶ",707031,7],["μόσχους",709029,57],["τριακοσίους",712936,60]],"And his princes gave an offering to the people, and to the priests, and to the Levites: and Chelcias and Zacharias and Jeiel the chief men gave to the priests of the house of God, they even gave for the passover sheep, and lambs, and kids, two thousand six hundred, and three hundred calves."],["9",[["καὶ",707031,7],["Χωνενιας",714004,4],["καὶ",707031,7],["Βαναιας",702502,4],["καὶ",707031,7],["Σαμαιας",711441,4],["καὶ",707031,7],["Ναθαναηλ",709165,4],["ἀδελφὸς",700249,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["Ασαβια",701873,4],["καὶ",707031,7],["Ιιηλ",706707,4],["καὶ",707031,7],["Ιωζαβαδ",706912,4],["ἄρχοντες",701862,52],["τῶν",709436,80],["Λευιτῶν",708160,81],["ἀπήρξαντο",701361,189],["τοῖς",709436,147],["Λευίταις",708160,148],["εἰς",704105,0],["τὸ",709436,24],["φασεχ",713380,25],["πρόβατα",710768,42],["πεντακισχίλια",710260,68],["καὶ",707031,7],["μόσχους",709029,57],["πεντακοσίους",710261,60]],"And Chonenias, and Banæas, and Samæas, and Nathanael his brother, and Asabias, and Jeiel, and Jozabad, heads of the Levites, gave an offering to the Levites for the passover, of five thousand sheep and five hundred calves."],["10",[["καὶ",707031,7],["κατωρθώθη",707548,37],["ἡ",709436,10],["λειτουργία",708135,12],["καὶ",707031,7],["ἔστησαν",706846,150],["οἱ",709436,136],["ἱερεῖς",706614,52],["ἐπὶ",705080,0],["τὴν",709436,8],["στάσιν",712049,9],["αὐτῶν",702165,40],["καὶ",707031,7],["οἱ",709436,136],["Λευῖται",708160,52],["ἐπὶ",705080,0],["τὰς",709436,38],["διαιρέσεις",703458,39],["αὐτῶν",702165,40],["κατὰ",707200,0],["τὴν",709436,8],["ἐντολὴν",704802,9],["τοῦ",709436,35],["βασιλέως",702580,18]],"And the service was duly ordered, and the priests stood in their place, and the Levites in their divisions, according to the command of the king."],["11",[["καὶ",707031,7],["ἔθυσαν",706349,150],["τὸ",709436,24],["φασεχ",713380,25],["καὶ",707031,7],["προσέχεαν",710980,150],["οἱ",709436,136],["ἱερεῖς",706614,52],["τὸ",709436,24],["αἷμα",700442,25],["ἐκ",704132,0],["χειρὸς",713787,17],["αὐτῶν",702165,40],["καὶ",707031,7],["οἱ",709436,136],["Λευῖται",708160,52],["ἐξέδειραν",704164,150]],"And they slew the passover, and the priests sprinkled the blood from their hand, and the Levites flayed [the victims]."],["12",[["καὶ",707031,7],["ἡτοίμασαν",705539,150],["τὴν",709436,8],["ὁλοκαύτωσιν",709590,9],["παραδοῦναι",710014,106],["αὐτοῖς",702165,151],["κατὰ",707200,0],["τὴν",709436,8],["διαίρεσιν",703458,9],["κατ᾿",707200,0],["οἴκους",709516,57],["πατριῶν",710192,65],["τοῖς",709436,147],["υἱοῖς",713075,148],["τοῦ",709436,35],["λαοῦ",708094,18],["τοῦ",709436,20],["προσάγειν",710848,55],["τῷ",709436,113],["κυρίῳ",707996,114],["ὡς",714148,28],["γέγραπται",703194,187],["ἐν",704639,0],["βιβλίῳ",702719,54],["Μωυσῆ",709112,18],["καὶ",707031,7],["οὕτως",709859,28],["εἰς",704105,0],["τὸ",709436,24],["πρωί",711021,28]],"And they prepared the whole-burnt-offering to give to them, according to the division by the houses of families, [even] to the sons of the people, to offer to the Lord, as it is written in the book of Moses."],["13",[["καὶ",707031,7],["ὤπτησαν",709715,150],["τὸ",709436,24],["φασεχ",713380,25],["ἐν",704639,0],["πυρὶ",711088,54],["κατὰ",707200,0],["τὴν",709436,8],["κρίσιν",707908,9],["καὶ",707031,7],["τὰ",709436,41],["ἅγια",700159,68],["ἥψησαν",705788,150],["ἐν",704639,0],["τοῖς",709436,147],["χαλκείοις",713689,230],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["λέβησιν",708121,148],["καὶ",707031,7],["εὐοδώθη",705654,37],["καὶ",707031,7],["ἔδραμον",712931,150],["πρὸς",710844,0],["πάντας",710177,60],["τοὺς",709436,58],["υἱοὺς",713075,57],["τοῦ",709436,35],["λαοῦ",708094,18]],"And thus [they did] till the morning. And they roasted the passover with fire according to the ordinance; and boiled the holy [pieces] in copper vessels and caldrons, and [the feast] went on well, and they quickly served all the children of the people."],["14",[["καὶ",707031,7],["