01598,99],["τοῦ",709436,20],["μὴ",708851,28],["πορευθῆναι",710667,179],["ἐπὶ",705080,0],["Ιεροβοαμ",706629,6]],"Thus saith the Lord, Ye shall not go up, and ye shall not war against your brethren: return every one to his home; for this thing is of me. And they hearkened to the word of the Lord, and returned from going against Jeroboam."],["5",[["καὶ",707031,7],["κατῴκησεν",707534,2],["Ροβοαμ",711276,4],["εἰς",704105,0],["Ιερουσαλημ",706644,6],["καὶ",707031,7],["ᾠκοδόμησεν",709509,2],["πόλεις",710612,39],["τειχήρεις",712756,119],["ἐν",704639,0],["τῇ",709436,100],["Ιουδαίᾳ",706769,1]],"And Roboam dwelt in Jerusalem, and he built walled cities in Judæa."],["6",[["καὶ",707031,7],["ᾠκοδόμησεν",709509,2],["τὴν",709436,8],["Βαιθλεεμ",702420,9],["καὶ",707031,7],["τὴν",709436,8],["Αιταμ",700487,9],["καὶ",707031,7],["τὴν",709436,8],["Θεκωε",706162,9]],"And he built Bethleem, and Ætan and Thecoe,"],["7",[["καὶ",707031,7],["τὴν",709436,8],["Βαιθσουρα",702436,9],["καὶ",707031,7],["τὴν",709436,8],["Σοκχωθ",711926,9],["καὶ",707031,7],["τὴν",709436,8],["Οδολλαμ",709452,9]],"and Bæthsura, and Sochoth, and Odollam,"],["8",[["καὶ",707031,7],["τὴν",709436,8],["Γεθ",703005,9],["καὶ",707031,7],["τὴν",709436,8],["Μαρισαν",708511,9],["καὶ",707031,7],["τὴν",709436,8],["Ζιφ",705883,9]],"and Geth, and Marisa, and Ziph,"],["9",[["καὶ",707031,7],["τὴν",709436,8],["Αδωραιμ",700309,9],["καὶ",707031,7],["τὴν",709436,8],["Λαχις",708116,9],["καὶ",707031,7],["τὴν",709436,8],["Αζηκα",700334,9]],"and Adorai, and Lachis, and Azeca,"],["10",[["καὶ",707031,7],["τὴν",709436,8],["Σαραα",711508,9],["καὶ",707031,7],["τὴν",709436,8],["Αιαλων",700393,9],["καὶ",707031,7],["τὴν",709436,8],["Χεβρων",713777,9],["ἥ",709781,177],["ἐστιν",704093,91],["τοῦ",709436,35],["Ιουδα",706768,18],["καὶ",707031,7],["Βενιαμιν",702650,18],["πόλεις",710612,39],["τειχήρεις",712756,119]],"and Saraa, and Ælom, and Chebron, which belongs to Juda and Benjamin, walled cities."],["11",[["καὶ",707031,7],["ὠχύρωσεν",709890,2],["αὐτὰς",70216