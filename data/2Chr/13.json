[["1",[["ἐν",704639,0],["τῷ",709436,53],["ὀκτωκαιδεκάτῳ",709557,97],["ἔτει",705543,54],["τῆς",709436,16],["βασιλείας",702577,17],["Ιεροβοαμ",706629,18],["ἐβασίλευσεν",702581,2],["Αβια",700054,4],["ἐπὶ",705080,0],["Ιουδαν",706775,6]],"In the eighteenth year of the reign of Jeroboam Abia began to reign over Juda."],["2",[["ἔτη",705543,42],["τρία",712927,68],["ἐβασίλευσεν",702581,2],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["ὄνομα",709666,15],["τῇ",709436,100],["μητρὶ",708892,1],["αὐτοῦ",702165,102],["Μααχα",708318,12],["θυγάτηρ",706320,12],["Ουριηλ",709849,18],["ἀπὸ",701425,0],["Γαβαων",702858,118],["καὶ",707031,7],["πόλεμος",710605,4],["ἦν",704093,13],["ἀνὰ",700902,0],["μέσον",708768,27],["Αβια",700054,18],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,27],["Ιεροβοαμ",706629,18]],"He reigned three years in Jerusalem. And his mother's name [was] Maacha, daughter of Uriel of Gabaon. And there was war between Abia and Jeroboam."],["3",[["καὶ",707031,7],["παρετάξατο",710108,23],["Αβια",700054,4],["τὸν",709436,5],["πόλεμον",710605,6],["ἐν",704639,0],["δυνάμει",703839,1],["πολεμισταῖς",710604,148],["δυνάμεως",703839,17],["τετρακοσίαις",712817,291],["χιλιάσιν",713858,76],["ἀνδρῶν",701150,81],["δυνατῶν",703845,169],["καὶ",707031,7],["Ιεροβοαμ",706629,4],["παρετάξατο",710108,23],["πρὸς",710844,0],["αὐτὸν",702165,85],["πόλεμον",710605,6],["ἐν",704639,0],["ὀκτακοσίαις",709553,291],["χιλιάσιν",713858,76],["δυνατοὶ",703845,138],["πολεμισταὶ",710604,52],["δυνάμεως",703839,17]],"And Abia set the battle in array with an army, with mighty men of war, [even] four hundred thousand mighty men: and Jeroboam set the battle in array against him with eight hundred thousand, [they were] mighty warriors of the host."],["4",[["καὶ",707031,7],["ἀνέστη",701173,2],["Αβια",700054,4],["ἀπὸ",701425,0],["τοῦ",709436,20],["ὄρους",709768,21],["Σομορων",711937,18],["ὅ",709781,33],["ἐστιν",704093,91],["ἐν",704639,0],["τῷ",709436,53],["ὄρει",709768,54],["Εφραιμ",705769,18],["καὶ",707031,7],["εἶπεν",705373,2],["ἀκούσατε",700587,74],["Ιεροβοαμ",706629,153],["καὶ",707031,7],["πᾶς",710177,564],["Ισραηλ",706839,153]],"And Abia rose up from the mount Somoron, which is in mount Ephraim, and said, Hear ye, Jeroboam, and all Israel:"],["5",[["οὐχ",709805,28],["ὑμῖν",713084,90],["γνῶναι",703105,106],["ὅτι",709803,7],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ἔδωκεν",703654,2],["βασιλείαν",702577,9],["ἐπὶ",705080,0],["τὸν",709436,5],["Ισραηλ",706839,6],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τῷ",709436,113],["Δαυιδ",703232,114],["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτοῦ",702165,102],["διαθήκην",703456,9],["ἁλός",700728,18]],"[Is it] not for you to know that the Lord God of Israel has given a king over Israel for ever to David, and to his sons, by a covenant of salt?"],["6",[["καὶ",707031,7],["ἀνέστη",701173,2],["Ιεροβοαμ",706629,4],["ὁ",709436,3],["τοῦ",709436,35],["Ναβατ",709134,18],["ὁ",709436,3],["παῖς",709932,4],["Σαλωμων",711430,18],["τοῦ",709436,35],["Δαυιδ",703232,18],["καὶ",707031,7],["ἀπέστη",702214,2],["ἀπὸ",701425,0],["τοῦ",709436,35],["κυρίου",707996,18],["αὐτοῦ",702165,102]],"But Jeroboam the [son] of Nabat, the servant of Solomon [the son] of David, is risen up, and has revolted from his master:"],["7",[["καὶ",707031,7],["συνήχθησαν",712375,99],["πρὸς",710844,0],["αὐτὸν",702165,85],["ἄνδρες",701150,52],["λοιμοὶ",708245,52],["υἱοὶ",713075,52],["παράνομοι",710080,138],["καὶ",707031,7],["ἀντέστη",701154,2],["πρὸς",710844,0],["Ροβοαμ",711276,6],["τὸν",709436,5],["τοῦ",709436,35],["Σαλωμων",711430,18],["καὶ",707031,7],["Ροβοαμ",711276,4],["ἦν",704093,13],["νεώτερος",709256,14],["καὶ",707031,7],["δειλὸς",703324,14],["τῇ",709436,100],["καρδίᾳ",707141,1],["καὶ",707031,7],["οὐκ",709805,28],["ἀντέστη",701154,2],["κατὰ",707200,0],["πρόσωπον",710986,25],["αὐτοῦ",702165,102]],"and there are gathered to him pestilent men, transgressors, and he has risen up against Roboam the [son] of Solomon, while Roboam was young and fearful in heart, and he withstood him not."],["8",[["καὶ",707031,7],["νῦν",709384,28],["λέγετε",708124,87],["ὑμεῖς",713081,219],["ἀντιστῆναι",701154,106],["κατὰ",707200,0],["πρόσωπον",710986,25],["βασιλείας",702577,17],["κυρίου",707996,18],["διὰ",703417,0],["χειρὸς",713787,17],["υἱῶν",713075,81],["Δαυιδ",703232,18],["καὶ",707031,7],["ὑμεῖς",713081,219],["πλῆθος",710529,15],["πολύ",710646,26],["καὶ",707031,7],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["μόσχοι",709029,52],["χρυσοῖ",713971,138],["οὓς",709781,298],["ἐποίησεν",710582,2],["ὑμῖν",713084,90],["Ιεροβοαμ",706629,4],["εἰς",704105,0],["θεούς",706192,57]],"And now ye profess to resist the kingdom of the Lord in the hand of the sons of David; and ye [are] a great multitude, and with you are golden calves, which Jeroboam made you for gods."],["9",[["ἦ",705924,7],["οὐκ",709805,28],["ἐξεβάλετε",704145,265],["τοὺς",709436,58],["ἱερεῖς",706614,57],["κυρίου",707996,18],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ααρων",700005,18],["καὶ",707031,7],["τοὺς",709436,58],["Λευίτας",708160,57],["καὶ",707031,7],["ἐποιήσατε",710582,265],["ἑαυτοῖς",703917,151],["ἱερεῖς",706614,57],["ἐκ",704132,0],["τοῦ",709436,35],["λαοῦ",708094,18],["τῆς",709436,16],["γῆς",703083,17],["πᾶς",710177,14],["ὁ",709436,3],["προσπορευόμενος",710954,122],["πληρῶσαι",710543,106],["τὰς",709436,38],["χεῖρας",713787,39],["ἐν",704639,0],["μόσχῳ",709029,114],["ἐκ",704132,0],["βοῶν",702798,81],["καὶ",707031,7],["κριοῖς",707906,148],["ἑπτὰ",705357,59],["καὶ",707031,7],["ἐγίνετο",703104,19],["εἰς",704105,0],["ἱερέα",706614,6],["τῷ",709436,113],["μὴ",708851,28],["ὄντι",704093,379],["θεῷ",706192,114]],"Did ye not cast out the priests of the Lord, the sons of Aaron, and the Levites, and make to yourselves priests of the people of any [other] land? whoever came to consecrate himself with a calf of the herd and seven rams, he forthwith became a priest to that which is no god."],["10",[["καὶ",707031,7],["ἡμεῖς",705983,219],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["ἡμῶν",705999,145],["οὐκ",709805,28],["ἐγκατελίπομεν",703967,289],["καὶ",707031,7],["οἱ",709436,136],["ἱερεῖς",706614,52],["αὐτοῦ",702165,102],["λειτουργοῦσιν",708132,197],["τῷ",709436,113],["κυρίῳ",707996,114],["οἱ",709436,136],["υἱοὶ",713075,52],["Ααρων",700005,18],["καὶ",707031,7],["οἱ",709436,136],["Λευῖται",708160,52],["ἐν",704639,0],["ταῖς",709436,75],["ἐφημερίαις",705752,76],["αὐτῶν",702165,40]],"But we have not forsaken the Lord our God, and his priests, the sons of Aaron, and the Levites, minister to the Lord; and in their daily courses"],["11",[["θυμιῶσιν",706332,197],["τῷ",709436,113],["κυρίῳ",707996,114],["ὁλοκαυτώματα",709589,42],["πρωὶ",711021,28],["καὶ",707031,7],["δείλης",703318,17],["καὶ",707031,7],["θυμίαμα",706330,25],["συνθέσεως",712475,17],["καὶ",707031,7],["προθέσεις",710796,39],["ἄρτων",701829,81],["ἐπὶ",705080,0],["τῆς",709436,16],["τραπέζης",712919,17],["τῆς",709436,16],["καθαρᾶς",706988,82],["καὶ",707031,7],["ἡ",709436,10],["λυχνία",708286,12],["ἡ",709436,10],["χρυσῆ",713971,29],["καὶ",707031,7],["οἱ",709436,136],["λυχνοὶ",708287,52],["τῆς",709436,16],["καύσεως",707565,17],["ἀνάψαι",701044,106],["δείλης",703318,17],["ὅτι",709803,7],["φυλάσσομεν",713619,243],["ἡμεῖς",705983,219],["τὰς",709436,38],["φυλακὰς",713613,39],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["τῶν",709436,80],["πατέρων",710189,81],["ἡμῶν",705999,145],["καὶ",707031,7],["ὑμεῖς",713081,219],["ἐγκατελίπετε",703967,265],["αὐτόν",702165,85]],"they sacrifice to the Lord whole-burnt-offering, morning and evening, and compound incense, and [set] the shewbread on the pure table; and [there is] the golden candlestick, and the lamps for burning, to light in the evening: for we keep the charge of the Lord God of our fathers; but ye have forsaken him."],["12",[["καὶ",707031,7],["ἰδοὺ",706497,88],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["ἐν",704639,0],["ἀρχῇ",701836,1],["κύριος",707996,4],["καὶ",707031,7],["οἱ",709436,136],["ἱερεῖς",706614,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["αἱ",709436,190],["σάλπιγγες",711424,191],["τῆς",709436,16],["σημασίας",711746,17],["τοῦ",709436,20],["σημαίνειν",711745,55],["ἐφ᾿",705080,0],["ὑμᾶς",713080,552],["οἱ",709436,136],["υἱοὶ",713075,52],["τοῦ",709436,35],["Ισραηλ",706839,18],["πολεμήσετε",710601,337],["πρὸς",710844,0],["κύριον",707996,6],["θεὸν",706192,6],["τῶν",709436,80],["πατέρων",710189,81],["ἡμῶν",705999,145],["ὅτι",709803,7],["οὐκ",709805,28],["εὐοδωθήσεται",705654,134],["ὑμῖν",713084,90]],"And, behold, the Lord and his priests are with us at our head, and the signal trumpets to sound an alarm over us. Children of Israel, fight not against the Lord God of our fathers; for ye shall not prosper."],["13",[["καὶ",707031,7],["Ιεροβοαμ",706629,4],["ἀπέστρεψεν",701598,2],["τὸ",709436,24],["ἔνεδρον",704704,25],["ἐλθεῖν",705453,106],["αὐτῶν",702165,40],["ἐκ",704132,0],["τῶν",709436,80],["ὄπισθεν",709691,0],["καὶ",707031,7],["ἐγένετο",703104,23],["ἔμπροσθεν",704618,0],["Ιουδα",706768,18],["καὶ",707031,7],["τὸ",709436,24],["ἔνεδρον",704704,25],["ἐκ",704132,0],["τῶν",709436,80],["ὄπισθεν",709691,0]],"Now Jeroboam had caused an ambush to come round upon him from behind: and he [himself] was before Juda, and the ambush behind."],["14",[["καὶ",707031,7],["ἀπέστρεψεν",701598,2],["Ιουδας",706775,4],["καὶ",707031,7],["ἰδοὺ",706497,88],["αὐτοῖς",702165,151],["ὁ",709436,3],["πόλεμος",710605,4],["ἐκ",704132,0],["τῶν",709436,80],["ἔμπροσθεν",704618,28],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,80],["ὄπισθεν",709691,0],["καὶ",707031,7],["ἐβόησαν",702743,150],["πρὸς",710844,0],["κύριον",707996,6],["καὶ",707031,7],["οἱ",709436,136],["ἱερεῖς",706614,52],["ἐσάλπισαν",711425,150],["ταῖς",709436,75],["σάλπιγξιν",711424,76]],"And Juda looked back, and, behold, the battle [was] against them before and behind: and they cried to the Lord, and the priests sounded with the trumpets."],["15",[["καὶ",707031,7],["ἐβόησαν",702743,150],["ἄνδρες",701150,52],["Ιουδα",706768,18],["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["τῷ",709436,53],["βοᾶν",702743,55],["ἄνδρας",701150,57],["Ιουδα",706768,18],["καὶ",707031,7],["κύριος",707996,4],["ἐπάταξεν",710185,2],["τὸν",709436,5],["Ιεροβοαμ",706629,6],["καὶ",707031,7],["τὸν",709436,5],["Ισραηλ",706839,6],["ἐναντίον",704654,0],["Αβια",700054,18],["καὶ",707031,7],["Ιουδα",706768,18]],"And the men of Juda shouted: and it came to pass, when the men of Juda shouted, that the Lord smote Jeroboam and Israel before Abia and Juda."],["16",[["καὶ",707031,7],["ἔφυγον",713433,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["ἀπὸ",701425,0],["προσώπου",710986,21],["Ιουδα",706768,18],["καὶ",707031,7],["παρέδωκεν",710014,2],["αὐτοὺς",702165,62],["κύριος",707996,4],["εἰς",704105,0],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτῶν",702165,40]],"And the children of Israel fled from before Juda; and the Lord delivered them into their hands."],["17",[["καὶ",707031,7],["ἐπάταξεν",710185,2],["ἐν",704639,0],["αὐτοῖς",702165,151],["Αβια",700054,4],["καὶ",707031,7],["ὁ",709436,3],["λαὸς",708094,4],["αὐτοῦ",702165,102],["πληγὴν",710527,9],["μεγάλην",708653,36],["καὶ",707031,7],["ἔπεσον",710481,150],["τραυματίαι",712921,52],["ἀπὸ",701425,0],["Ισραηλ",706839,18],["πεντακόσιαι",710261,192],["χιλιάδες",713858,191],["ἄνδρες",701150,52],["δυνατοί",703845,138]],"And Abia and his people smote them with a great slaughter: and there fell slain of Israel five hundred thousand mighty men."],["18",[["καὶ",707031,7],["ἐταπεινώθησαν",712717,99],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["καὶ",707031,7],["κατίσχυσαν",707531,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ιουδα",706768,18],["ὅτι",709803,7],["ἤλπισαν",704529,150],["ἐπὶ",705080,0],["κύριον",707996,6],["θεὸν",706192,6],["τῶν",709436,80],["πατέρων",710189,81],["αὐτῶν",702165,40]],"So the children of Israel were brought low in that day, and the children of Juda prevailed, because they trusted on the Lord God of their fathers."],["19",[["καὶ",707031,7],["κατεδίωξεν",707243,2],["Αβια",700054,4],["ὀπίσω",709697,28],["Ιεροβοαμ",706629,6],["καὶ",707031,7],["προκατελάβετο",710809,23],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["πόλεις",710612,39],["τὴν",709436,8],["Βαιθηλ",702412,9],["καὶ",707031,7],["τὰς",709436,38],["κώμας",708022,39],["αὐτῆς",702165,86],["καὶ",707031,7],["τὴν",709436,8],["Ισανα",706807,9],["καὶ",707031,7],["τὰς",709436,38],["κώμας",708022,39],["αὐτῆς",702165,86],["καὶ",707031,7],["τὴν",709436,8],["Εφρων",705770,9],["καὶ",707031,7],["τὰς",709436,38],["κώμας",708022,39],["αὐτῆς",702165,86]],"And Abia pursued after Jeroboam, and he took from him the cities, Bæthel and her towns, and Jesyna and her towns, and Ephron and her towns."],["20",[["καὶ",707031,7],["οὐκ",709805,28],["ἔσχεν",705785,2],["ἰσχὺν",706858,9],["Ιεροβοαμ",706629,4],["ἔτι",705538,28],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["Αβια",700054,18],["καὶ",707031,7],["ἐπάταξεν",710185,2],["αὐτὸν",702165,85],["κύριος",707996,4],["καὶ",707031,7],["ἐτελεύτησεν",712781,2]],"And Jeroboam did not recover strength again all the days of Abia: and the Lord smote him, and he died."],["21",[["καὶ",707031,7],["κατίσχυσεν",707531,2],["Αβια",700054,4],["καὶ",707031,7],["ἔλαβεν",708076,2],["ἑαυτῷ",703917,50],["γυναῖκας",703209,39],["δέκα",703333,59],["τέσσαρας",712808,119],["καὶ",707031,7],["ἐγέννησεν",703051,2],["υἱοὺς",713075,57],["εἴκοσι",704085,59],["δύο",703849,59],["καὶ",707031,7],["θυγατέρας",706320,39],["δέκα",703333,59],["ἕξ",704828,59]],"But Abia strengthened himself, and took to himself fourteen wives, and he begot twenty-two sons, and sixteen daughters."],["22",[["καὶ",707031,7],["οἱ",709436,136],["λοιποὶ",708248,138],["λόγοι",708236,52],["Αβια",700054,18],["καὶ",707031,7],["αἱ",709436,190],["πράξεις",710714,191],["αὐτοῦ",702165,102],["καὶ",707031,7],["οἱ",709436,136],["λόγοι",708236,52],["αὐτοῦ",702165,102],["γεγραμμένοι",703194,429],["ἐπὶ",705080,0],["βιβλίῳ",702719,54],["τοῦ",709436,35],["προφήτου",711009,18],["Αδδω",700241,18]],"And the rest of the acts of Abia, and his deeds, and his sayings, are written in the book of the prophet Addo."],["23",[["καὶ",707031,7],["ἀπέθανεν",701461,2],["Αβια",700054,4],["μετὰ",708780,0],["τῶν",709436,80],["πατέρων",710189,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔθαψαν",706103,150],["αὐτὸν",702165,85],["ἐν",704639,0],["πόλει",710612,1],["Δαυιδ",703232,18],["καὶ",707031,7],["ἐβασίλευσεν",702581,2],["Ασα",701870,4],["υἱὸς",713075,4],["αὐτοῦ",702165,102],["ἀντ᾿",701227,0],["αὐτοῦ",702165,102],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["Ασα",701870,18],["ἡσύχασεν",706033,2],["ἡ",709436,10],["γῆ",703083,12],["Ιουδα",706768,18],["ἔτη",705543,42],["δέκα",703333,59]],"And Abia died with his fathers, and they buried him in the city of David; and Asa his son reigned in his stead. In the days of Asa the land of Juda had rest ten years."]]