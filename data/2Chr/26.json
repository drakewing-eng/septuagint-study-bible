[["1",[["καὶ",707031,7],["ἔλαβεν",708076,2],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["τῆς",709436,16],["γῆς",703083,17],["τὸν",709436,5],["Οζιαν",709474,6],["καὶ",707031,7],["αὐτὸς",702165,121],["δέκα",703333,59],["καὶ",707031,7],["ἓξ",704828,59],["ἐτῶν",705543,44],["καὶ",707031,7],["ἐβασίλευσαν",702581,150],["αὐτὸν",702165,85],["ἀντὶ",701227,0],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["Αμασιου",700784,18]],"Then all the people of the land took Ozias, and he was sixteen years old, and they made him king in the room of his father Amasias."],["2",[["αὐτὸς",702165,121],["ᾠκοδόμησεν",709509,2],["τὴν",709436,8],["Αιλαθ",700429,9],["αὐτὸς",702165,121],["ἐπέστρεψεν",705278,2],["αὐτὴν",702165,104],["τῷ",709436,113],["Ιουδα",706768,114],["μετὰ",708780,0],["τὸ",709436,24],["κοιμηθῆναι",707767,179],["τὸν",709436,5],["βασιλέα",702580,6],["μετὰ",708780,0],["τῶν",709436,80],["πατέρων",710189,81],["αὐτοῦ",702165,102]],"He built Ælath, he recovered it to Juda, after the king slept with his fathers."],["3",[["υἱὸς",713075,4],["δέκα",703333,59],["ἓξ",704828,59],["ἐτῶν",705543,44],["ἐβασίλευσεν",702581,2],["Οζιας",709474,4],["καὶ",707031,7],["πεντήκοντα",710270,59],["καὶ",707031,7],["δύο",703849,59],["ἔτη",705543,42],["ἐβασίλευσεν",702581,2],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["ὄνομα",709666,15],["τῇ",709436,100],["μητρὶ",708892,1],["αὐτοῦ",702165,102],["Χαλια",713684,12],["ἀπὸ",701425,0],["Ιερουσαλημ",706644,17]],"Ozias began to reign at the age of sixteen years, and he reigned fifty-two years in Jerusalem: and his mother's name was Jechelia of Jerusalem."],["4",[["καὶ",707031,7],["ἐποίησεν",710582,2],["τὸ",709436,24],["εὐθὲς",705596,46],["ἐνώπιον",704823,0],["κυρίου",707996,18],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἐποίησεν",710582,2],["Αμασιας",700784,4],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτοῦ",702165,102]],"And he did that which was right in the sight of the Lord, according to all that Amasias his father did."],["5",[["καὶ",707031,7],["ἦν",704093,13],["ἐκζητῶν",704187,72],["τὸν",709436,5],["κύριον",707996,6],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["Ζαχαριου",705847,18],["τοῦ",709436,35],["συνίοντος",712435,152],["ἐν",704639,0],["φόβῳ",713534,114],["κυρίου",707996,18],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["αὐτοῦ",702165,102],["ἐζήτησεν",705879,2],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["εὐόδωσεν",705654,2],["αὐτῷ",702165,50],["κύριος",707996,4]],"And he sought the Lord in the days of Zacharias, who understood the fear of the Lord; and in his days he sought the Lord, and the Lord prospered him."],["6",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["καὶ",707031,7],["ἐπολέμησεν",710601,2],["πρὸς",710844,0],["τοὺς",709436,58],["ἀλλοφύλους",700706,60],["καὶ",707031,7],["κατέσπασεν",707431,2],["τὰ",709436,41],["τείχη",712759,42],["Γεθ",703005,118],["καὶ",707031,7],["τὰ",709436,41],["τείχη",712759,42],["Ιαβνη",706367,118],["καὶ",707031,7],["τὰ",709436,41],["τείχη",712759,42],["Ἀζώτου",700351,18],["καὶ",707031,7],["ᾠκοδόμησεν",709509,2],["πόλεις",710612,39],["Ἀζώτου",700351,18],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["ἀλλοφύλοις",700706,230]],"And he went out and fought against the Philistines, and pulled down the walls of Geth, and the walls of Jabner, and the walls of Azotus, and he built cities [near] Azotus, and among the Philistines."],["7",[["καὶ",707031,7],["κατίσχυσεν",707531,2],["αὐτὸν",702165,85],["κύριος",707996,4],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἀλλοφύλους",700706,60],["καὶ",707031,7],["ἐπὶ",705080,0],["τοὺς",709436,58],["Ἄραβας",701694,57],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["ἐπὶ",705080,0],["τῆς",709436,16],["πέτρας",710443,17],["καὶ",707031,7],["ἐπὶ",705080,0],["τοὺς",709436,58],["Μιναίους",708925,57]],"And the Lord strengthened him against the Philistines, and against the Arabians that dwelt on the rock, and against the Minæans."],["8",[["καὶ",707031,7],["ἔδωκαν",703654,150],["οἱ",709436,136],["Μιναῖοι",708925,52],["δῶρα",703907,42],["τῷ",709436,113],["Οζια",709474,114],["καὶ",707031,7],["ἦν",704093,13],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["ἕως",705792,0],["εἰσόδου",704119,17],["Αἰγύπτου",700401,17],["ὅτι",709803,7],["κατίσχυσεν",707531,2],["ἕως",705792,0],["ἄνω",701296,28]],"And the Minæans gave gifts to Ozias; and his fame spread as far as the entering in of Egypt, for he strengthened [himself] exceedingly."],["9",[["καὶ",707031,7],["ᾠκοδόμησεν",709509,2],["Οζιας",709474,4],["πύργους",711092,57],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["ἐπὶ",705080,0],["τὴν",709436,8],["πύλην",711082,9],["τῆς",709436,16],["γωνίας",703226,17],["καὶ",707031,7],["ἐπὶ",705080,0],["τὴν",709436,8],["πύλην",711082,9],["τῆς",709436,16],["φάραγγος",713351,17],["καὶ",707031,7],["ἐπὶ",705080,0],["τῶν",709436,130],["γωνιῶν",703226,65],["καὶ",707031,7],["κατίσχυσεν",707531,2]],"And Ozias built towers in Jerusalem, both at the gate of the corner and at the valley gate, and at the corners, and he fortified them."],["10",[["καὶ",707031,7],["ᾠκοδόμησεν",709509,2],["πύργους",711092,57],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["καὶ",707031,7],["ἐλατόμησεν",708102,2],["λάκκους",708067,57],["πολλούς",710646,60],["ὅτι",709803,7],["κτήνη",707934,42],["πολλὰ",710646,68],["ὑπῆρχεν",713104,13],["αὐτῷ",702165,50],["ἐν",704639,0],["Σεφηλα",711721,1],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["πεδινῇ",710214,101],["καὶ",707031,7],["ἀμπελουργοὶ",700871,52],["ἐν",704639,0],["τῇ",709436,100],["ὀρεινῇ",709733,1],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["Καρμήλῳ",707161,114],["ὅτι",709803,7],["φιλογέωργος",713477,4],["ἦν",704093,13]],"And he built towers in the wilderness, and dug many wells, for he had many cattle in the low country and in the plain; and vinedressers in the mountain country and in Carmel: for he was a husbandman."],["11",[["καὶ",707031,7],["ἐγένετο",703104,23],["τῷ",709436,53],["Οζια",709474,114],["δυνάμεις",703839,191],["ποιοῦσαι",710582,306],["πόλεμον",710605,6],["καὶ",707031,7],["ἐκπορευόμεναι",704293,305],["εἰς",704105,0],["παράταξιν",710107,9],["εἰς",704105,0],["ἀριθμόν",701744,6],["καὶ",707031,7],["ὁ",709436,3],["ἀριθμὸς",701744,4],["αὐτῶν",702165,40],["διὰ",703417,0],["χειρὸς",713787,17],["Ιιηλ",706707,18],["τοῦ",709436,35],["γραμματέως",703185,18],["καὶ",707031,7],["Μαασαιου",708311,18],["τοῦ",709436,35],["κριτοῦ",707910,18],["διὰ",703417,0],["χειρὸς",713787,17],["Ανανιου",701016,18],["τοῦ",709436,35],["διαδόχου",703450,18],["τοῦ",709436,35],["βασιλέως",702580,18]],"And Ozias had a host of warriors, and that went out orderly to war, and returned orderly in number; and their number was [made] by the hand of Jeiel the scribe, and Maasias the judge, by the hand of Ananias the king's deputy."],["12",[["πᾶς",710177,14],["ὁ",709436,3],["ἀριθμὸς",701744,4],["τῶν",709436,80],["πατριαρχῶν",710193,81],["τῶν",709436,80],["δυνατῶν",703845,169],["εἰς",704105,0],["πόλεμον",710605,6],["δισχίλιοι",703747,138],["ἑξακόσιοι",704847,138]],"The whole number of the chiefs of families of the mighty men of war [was] two thousand six hundred;"],["13",[["καὶ",707031,7],["μετ᾿",708780,0],["αὐτῶν",702165,40],["δύναμις",703839,12],["πολεμικὴ",710602,29],["τριακόσιαι",712936,192],["χιλιάδες",713858,191],["καὶ",707031,7],["ἑπτακισχίλιοι",705363,138],["πεντακόσιοι",710261,138],["οὗτοι",709858,201],["οἱ",709436,136],["ποιοῦντες",710582,146],["πόλεμον",710605,6],["ἐν",704639,0],["δυνάμει",703839,1],["ἰσχύος",706858,17],["βοηθῆσαι",702746,106],["τῷ",709436,113],["βασιλεῖ",702580,114],["ἐπὶ",705080,0],["τοὺς",709436,58],["ὑπεναντίους",713109,60]],"and with them was a warrior force, three hundred thousand and seven thousand and five hundred: these waged war mightily to help the king against [his] enemies."],["14",[["καὶ",707031,7],["ἡτοίμαζεν",705539,13],["αὐτοῖς",702165,151],["Οζιας",709474,4],["πάσῃ",710177,101],["τῇ",709436,100],["δυνάμει",703839,1],["θυρεοὺς",706338,57],["κ