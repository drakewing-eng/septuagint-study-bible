[["1",[["ὢν",704093,72],["ἑπτὰ",705357,59],["ἐτῶν",705543,44],["Ιωας",706896,4],["ἐν",704639,0],["τῷ",709436,53],["βασιλεῦσαι",702581,106],["αὐτὸν",702165,85],["καὶ",707031,7],["τεσσαράκοντα",712806,68],["ἔτη",705543,42],["ἐβασίλευσεν",702581,2],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["ὄνομα",709666,15],["τῇ",709436,100],["μητρὶ",708892,1],["αὐτοῦ",702165,102],["Σαβια",711358,12],["ἐκ",704132,0],["Βηρσαβεε",702702,118]],"Joas was seven years old when he began to reign, and he reigned forty years in Jerusalem: and his mother's name was Sabia of Beersabee."],["2",[["καὶ",707031,7],["ἐποίησεν",710582,2],["Ιωας",706896,4],["τὸ",709436,24],["εὐθὲς",705596,46],["ἐνώπιον",704823,0],["κυρίου",707996,18],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["Ιωδαε",706908,18],["τοῦ",709436,35],["ἱερέως",706614,18]],"And Joas did that which was right in the sight of the Lord all the days of Jodae the priest."],["3",[["καὶ",707031,7],["ἔλαβεν",708076,2],["αὐτῷ",702165,50],["Ιωδαε",706908,4],["γυναῖκας",703209,39],["δύο",703849,59],["καὶ",707031,7],["ἐγέννησεν",703051,2],["υἱοὺς",713075,57],["καὶ",707031,7],["θυγατέρας",706320,39]],"And Jodae took to himself two wives, and they bore sons and daughters."],["4",[["καὶ",707031,7],["ἐγένετο",703104,23],["μετὰ",708780,0],["ταῦτα",709858,71],["καὶ",707031,7],["ἐγένετο",703104,23],["ἐπὶ",705080,0],["καρδίαν",707141,9],["Ιωας",706896,18],["ἐπισκευάσαι",705251,106],["τὸν",709436,5],["οἶκον",709516,6],["κυρίου",707996,18]],"And it came to pass afterward that it came into the heart of Joas to repair the house of the Lord."],["5",[["καὶ",707031,7],["συνήγαγεν",712375,2],["τοὺς",709436,58],["ἱερεῖς",706614,52],["καὶ",707031,7],["τοὺς",709436,58],["Λευίτας",708160,57],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["ἐξέλθατε",704909,74],["εἰς",704105,0],["τὰς",709436,38],["πόλεις",710612,39],["Ιουδα",706768,18],["καὶ",707031,7],["συναγάγετε",712375,74],["ἀπὸ",701425,0],["παντὸς",710177,116],["Ισραηλ",706839,18],["ἀργύριον",701707,25],["κατισχῦσαι",707531,106],["τὸν",709436,5],["οἶκον",709516,6],["κυρίου",707996,18],["ἐνιαυτὸν",704745,6],["κατ᾿",707200,0],["ἐνιαυτὸν",704745,6],["καὶ",707031,7],["σπεύσατε",712011,74],["λαλῆσαι",708071,106],["καὶ",707031,7],["οὐκ",709805,28],["ἔσπευσαν",712011,150],["οἱ",709436,136],["Λευῖται",708160,52]],"And he gathered the priests and the Levites, and said to them, Go out into the cities of Juda, and collect money of all Israel to repair the house of the Lord from year to year, and make haste to speak [of it]. But the Levites hasted not."],["6",[["καὶ",707031,7],["ἐκάλεσεν",707084,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ιωας",706896,4],["τὸν",709436,5],["Ιωδαε",706908,6],["τὸν",709436,5],["ἄρχοντα",701862,6],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["διὰ",703417,0],["τί",712867,126],["οὐκ",709805,28],["ἐπεσκέψω",705250,174],["περὶ",710285,0],["τῶν",709436,80],["Λευιτῶν",708160,81],["τοῦ",709436,20],["εἰσενέγκαι",704127,106],["ἀπὸ",701425,0],["Ιουδα",706768,18],["καὶ",707031,7],["Ιερουσαλημ",706644,17],["τὸ",709436,24],["κεκριμένον",707905,439],["ὑπὸ",713184,0],["Μωυσῆ",709112,18],["ἀνθρώπου",701163,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ὅτε",709802,28],["ἐξεκκλησίασεν",704217,2],["τὸν",709436,5],["Ισραηλ",706839,6],["εἰς",704105,0],["τὴν",709436,8],["σκηνὴν",711845,9],["τοῦ",709436,20],["μαρτυρίου",708525,21]],"And king Joas called Jodae the chief, and said to him, Why hast thou not looked after the Levites, so that they should bring from Juda and Jerusalem that which was prescribed by Moses the man of God, when he assembled Israel at the tabernacle of witness?"],["7",[["ὅτι",709803,7],["Γοθολια",703154,12],["ἦν",704093,13],["ἡ",709436,10],["ἄνομος",701194,29],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτῆς",702165,86],["κατέσπασαν",707431,150],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["γὰρ",702963,11],["τὰ",709436,41],["ἅγια",700159,68],["οἴκου",709516,18],["κυρίου",707996,18],["ἐποίησαν",710582,150],["ταῖς",709436,75],["Βααλιμ",702333,76]],"For Gotholia was a transgressor, and her sons tore down the house of God; for they offered the holy things of the house of the Lord to Baalim."],["8",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεύς",702580,4],["γενηθήτω",703104,22],["γλωσσόκομον",703121,25],["καὶ",707031,7],["τεθήτω",712849,22],["ἐν",704639,0],["πύλῃ",711082,1],["οἴκου",709516,18],["κυρίου",707996,18],["ἔξω",704983,28]],"And the king said, Let a box be made, and let it be put at the gate of the house of the Lord without."],["9",[["καὶ",707031,7],["κηρυξάτωσαν",707662,264],["ἐν",704639,0],["Ιουδα",706768,114],["καὶ",707031,7],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["εἰσενέγκαι",704127,106],["κυρίῳ",707996,114],["καθὼς",707030,28],["εἶπεν",705373,2],["Μωυσῆς",709112,4],["παῖς",709932,4],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐπὶ",705080,0],["τὸν",709436,5],["Ισραηλ",706839,6],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1]],"And let [men] proclaim in Juda and in Jerusalem, that [the people] should bring to the Lord, as Moses the servant of God spoke concerning Israel in the wilderness."],["10",[["καὶ",707031,7],["ἔδωκαν",703654,150],["πάντες",710177,138],["ἄρχοντες",701862,52],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["καὶ",707031,7],["εἰσέφερον",704127,137],["καὶ",707031,7],["ἐνέβαλλον",704547,137],["εἰς",704105,0],["τὸ",709436,24],["γλωσσόκομον",703121,25],["ἕως",705792,0],["οὗ",709781,48],["ἐπληρώθη",710543,37]],"And all the princes and all the people gave, and brought in, and cast into the box until it was filled."],["11",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὡς",714148,7],["εἰσέφερον",704127,137],["τὸ",709436,24],["γλωσσόκομον",703121,25],["πρὸς",710844,0],["τοὺς",709436,58],["προστάτας",710964,57],["τοῦ",709436,35],["βασιλέως",702580,18],["διὰ",703417,0],["χειρὸς",713787,17],["τῶν",709436,80],["Λευιτῶν",708160,81],["καὶ",707031,7],["ὡς",714148,7],["εἶδον",704075,150],["ὅτι",709803,7],["ἐπλεόνασεν",710516,2],["τὸ",709436,34],["ἀργύριον",701707,15],["καὶ",707031,7],["ἦλθεν",705453,2],["ὁ",709436,3],["γραμματεὺς",703185,4],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["ὁ",709436,3],["προστάτης",710964,4],["τοῦ",709436,35],["ἱερέως",706614,18],["τοῦ",709436,35],["μεγάλου",708653,116],["καὶ",707031,7],["ἐξεκένωσαν",704210,150],["τὸ",709436,24],["γλωσσόκομον",703121,25],["καὶ",707031,7],["κατέστησαν",707011,150],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["αὐτοῦ",702165,49],["οὕτως",709859,28],["ἐποίουν",710582,137],["ἡμέραν",705984,9],["ἐξ",704132,0],["ἡμέρας",705984,17],["καὶ",707031,7],["συνήγαγον",712375,150],["ἀργύριον",701707,25],["πολύ",710646,46]],"And it came to pass, when they brought in the box to the officers of the king by the hand of the Levites, and when they saw that the money was more than sufficient, then came the king's scribe, and the officer of the high priest, and emptied the box, and restored it to its place. Thus they did day by day, and collected much money."],["12",[["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτὸ",702165,129],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["Ιωδαε",706908,4],["ὁ",709436,3],["ἱερεὺς",706614,4],["τοῖς",709436,147],["ποιοῦσιν",710582,197],["τὰ",709436,41],["ἔργα",705396,42],["εἰς",704105,0],["τὴν",709436,8],["ἐργασίαν",705385,9],["οἴκου",709516,18],["κυρίου",707996,18],["καὶ",707031,7],["ἐμισθοῦντο",708937,139,19],["λατόμους",708104,57],["καὶ",707031,7],["τέκτονας",712766,57],["ἐπισκευάσαι",705251,106],["τὸν",709436,5],["οἶκον",709516,6],["κυρίου",707996,18],["καὶ",707031,7],["χαλκεῖς",713691,52],["σιδήρου",711774,18],["καὶ",707031,7],["χαλκοῦ",713690,116],["ἐπισκευάσαι",705251,106],["τὸν",709436,5],["οἶκον",709516,6],["κυρίου",707996,18]],"And the king and Jodae the priest gave it to the workmen employed in the service of the house of the Lord, and they hired masons and carpenters to repair the house of the Lord, also smiths and braziers 