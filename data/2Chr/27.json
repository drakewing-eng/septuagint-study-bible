[["1",[["υἱὸς",713075,4],["εἴκοσι",704085,59],["πέντε",710266,59],["ἐτῶν",705543,44],["Ιωαθαμ",706885,4],["ἐν",704639,0],["τῷ",709436,53],["βασιλεῦσαι",702581,106],["αὐτὸν",702165,85],["καὶ",707031,7],["δέκα",703333,59],["ἓξ",704828,59],["ἔτη",705543,42],["ἐβασίλευσεν",702581,2],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["ὄνομα",709666,15],["τῆς",709436,16],["μητρὸς",708892,17],["αὐτοῦ",702165,102],["Ιερουσα",706643,12],["θυγάτηρ",706320,12],["Σαδωκ",711375,18]],"Joatham [was] twenty and five years old when he began to reign, and he reigned sixteen years in Jerusalem: and his mother's name [was] Jerusa, daughter of Sadoc."],["2",[["καὶ",707031,7],["ἐποίησεν",710582,2],["τὸ",709436,24],["εὐθὲς",705596,46],["ἐνώπιον",704823,0],["κυρίου",707996,18],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἐποίησεν",710582,2],["Οζιας",709474,4],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτοῦ",702165,102],["ἀλλ᾿",700680,7],["οὐκ",709805,28],["εἰσῆλθεν",704114,2],["εἰς",704105,0],["τὸν",709436,5],["ναὸν",709191,6],["κυρίου",707996,18],["καὶ",707031,7],["ἔτι",705538,28],["ὁ",709436,3],["λαὸς",708094,4],["κατεφθείρετο",707474,19]],"And he did that which was right in the sight of the Lord, according to all that his father Ozias did: but he went not into the temple of the Lord. And still the people corrupted themselves."],["3",[["αὐτὸς",702165,121],["ᾠκοδόμησεν",709509,2],["τὴν",709436,8],["πύλην",711082,9],["οἴκου",709516,18],["κυρίου",707996,18],["τὴν",709436,8],["ὑψηλὴν",713285,36],["καὶ",707031,7],["ἐν",704639,0],["τείχει",712759,54],["τοῦ",709436,35],["Οφλα",709876,18],["ᾠκοδόμησεν",709509,2],["πολλά",710646,68]],"He built the high gate of the house of the Lord, and he built much in the wall of Opel."],["4",[["καὶ",707031,7],["πόλεις",710612,39],["ᾠκοδόμησεν",709509,2],["ἐν",704639,0],["ὄρει",709768,54],["Ιουδα",706768,18],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["δρυμοῖς",703836,148],["καὶ",707031,7],["οἰκήσεις",709501,39],["καὶ",707031,7],["πύργους",711092,57]],"In the mountain of Juda, and in the woods, [he built] both dwelling-places and towers."],["5",[["αὐτὸς",702165,121],["ἐμαχέσατο",708610,23],["πρὸς",710844,0],["βασιλέα",702580,6],["υἱῶν",713075,81],["Αμμων",700847,18],["καὶ",707031,7],["κατίσχυσεν",707531,2],["ἐπ᾿",705080,0],["αὐτόν",702165,85],["καὶ",707031,7],["ἐδίδουν",703654,139],["αὐτῷ",702165,50],["οἱ",709436,136],["υἱοὶ",713075,52],["Αμμων",700847,18],["κατ᾿",707200,0],["ἐνιαυτὸν",704745,6],["ἑκατὸν",704136,59],["τάλαντα",712697,42],["ἀργυρίου",701707,21],["καὶ",707031,7],["δέκα",703333,59],["χιλιάδας",713858,39],["κόρων",707841,81],["πυροῦ",711101,18],["καὶ",707031,7],["κριθῶν",707900,65],["δέκα",703333,59],["χιλιάδας",713858,39],["ταῦτα",709858,71],["ἔφερεν",713428,13],["αὐτῷ",702165,50],["βασιλεὺς",702580,4],["Αμμων",700847,18],["κατ᾿",707200,0],["ἐνιαυτὸν",704745,6],["ἐν",704639,0],["τῷ",709436,53],["πρώτῳ",711041,633],["ἔτει",705543,54],["καὶ",707031,7],["τῷ",709436,53],["δευτέρῳ",703389,97],["καὶ",707031,7],["τῷ",709436,53],["τρίτῳ",712968,97]],"He fought against the king of the children of Ammon, and prevailed against him: and the children of Ammon gave him even annually a hundred talents of silver, and ten thousand measures of wheat, and ten thousand of barley. These the king of the children of Ammon brought to him annually in the first and second and third years."],["6",[["καὶ",707031,7],["κατίσχυσεν",707531,2],["Ιωαθαμ",706885,4],["ὅτι",709803,7],["ἡτοίμασεν",705539,2],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτοῦ",702165,102],["ἔναντι",704653,0],["κυρίου",707996,18],["θεοῦ",706192,18],["αὐτοῦ",702165,102]],"Joatham grew strong, because he prepared his ways before the Lord his God."],["7",[["καὶ",707031,7],["οἱ",709436,136],["λοιποὶ",708248,138],["λόγοι",708236,52],["Ιωαθαμ",706885,18],["καὶ",707031,7],["ὁ",709436,3],["πόλεμος",710605,4],["καὶ",707031,7],["αἱ",709436,190],["πράξεις",710714,191],["αὐτοῦ",702165,102],["ἰδοὺ",706497,88],["γεγραμμένοι",703194,362],["ἐπὶ",705080,0],["βιβλίῳ",702719,54],["βασιλέων",702580,81],["Ιουδα",706768,18],["καὶ",707031,7],["Ισραηλ",706839,18]],"And the rest of the acts of Joatham, and his war, and his deeds, behold, [they are] written in the book of the kings of Juda and Israel."],["9",[["καὶ",707031,7],["ἐκοιμήθη",707767,37],["Ιωαθαμ",706885,4],["μετὰ",708780,0],["τῶν",709436,80],["πατέρων",710189,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐτάφη",706103,37],["ἐν",704639,0],["πόλει",710612,1],["Δαυιδ",703232,18],["καὶ",707031,7],["ἐβασίλευσεν",702581,2],["Αχαζ",702245,4],["υἱὸς",713075,4],["αὐτοῦ",702165,102],["ἀντ᾿",701227,0],["αὐτοῦ",702165,102]],"And Joatham slept with his fathers, and was buried in the city of David: and Achaz his son reigned in his stead."]]