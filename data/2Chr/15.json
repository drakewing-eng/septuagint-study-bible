07031,7],["τὰ",709436,41],["ἅγια",700159,68],["οἴκου",709516,18],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ἀργύριον",701707,25],["καὶ",707031,7],["χρυσίον",713972,25],["καὶ",707031,7],["σκεύη",711844,42]],"And he brought in the holy things of David his father, and the holy things of the house of God, silver, and gold, and vessels."],["19",[["καὶ",707031,7],["πόλεμος",710605,4],["οὐκ",709805,28],["ἦν",704093,13],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἕως",705792,0],["τοῦ",709436,35],["πέμπτου",710245,116],["καὶ",707031,7],["τριακοστοῦ",712937,92],["ἔτους",705543,21],["τῆς",709436,16],["βασιλείας",702577,17],["Ασα",701870,18]],"And there was no war [waged] with him until the thirty-fifth year of the reign of Asa."]]