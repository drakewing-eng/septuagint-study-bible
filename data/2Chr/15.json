[["1",[["καὶ",707031,7],["Αζαριας",700328,4],["υἱὸς",713075,4],["Ωδηδ",714092,18],["ἐγένετο",703104,23],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["πνεῦμα",710566,15],["κυρίου",707996,18]],"And Azarias the son of Oded—upon him came the Spirit of the Lord,"],["2",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["εἰς",704105,0],["ἀπάντησιν",701348,9],["Ασα",701870,114],["καὶ",707031,7],["παντὶ",710177,30],["Ιουδα",706768,114],["καὶ",707031,7],["Βενιαμιν",702650,114],["καὶ",707031,7],["εἶπεν",705373,2],["ἀκούσατέ",700587,74],["μου",709032,133],["Ασα",701870,153],["καὶ",707031,7],["πᾶς",710177,564],["Ιουδα",706768,153],["καὶ",707031,7],["Βενιαμιν",702650,153],["κύριος",707996,4],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["ἐν",704639,0],["τῷ",709436,53],["εἶναι",704093,55],["ὑμᾶς",713080,194],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐὰν",703912,7],["ἐκζητήσητε",704187,125],["αὐτόν",702165,85],["εὑρεθήσεται",705676,134],["ὑμῖν",713084,90],["καὶ",707031,7],["ἐὰν",703912,7],["ἐγκαταλίπητε",703967,125],["αὐτόν",702165,85],["ἐγκαταλείψει",703967,127],["ὑμᾶς",713080,194]],"and he went out to meet Asa, and all Juda and Benjamin, and said, Hear me, Asa, and all Juda and Benjamin. The Lord [is] with you, while ye are with him; and if ye seek him out, he will be found of you; but if ye forsake him, he will forsake you."],["3",[["καὶ",707031,7],["ἡμέραι",705984,191],["πολλαὶ",710646,192],["τῷ",709436,113],["Ισραηλ",706839,114],["ἐν",704639,0],["οὐ",709805,28],["θεῷ",706192,114],["ἀληθινῷ",700659,30],["καὶ",707031,7],["οὐχ",709805,28],["ἱερέως",706614,18],["ὑποδεικνύοντος",713192,152],["καὶ",707031,7],["ἐν",704639,0],["οὐ",709805,28],["νόμῳ",709349,114]],"And Israel [has been] a long time without the true God, and without a priest to expound [the truth], and without the law."],["4",[["καὶ",707031,7],["ἐπιστρέψει",705278,127],["ἐπὶ",705080,0],["κύριον",707996,6],["θεὸν",706192,6],["Ισραηλ",706839,18],["καὶ",707031,7],["εὑρεθήσεται",705676,134],["αὐτοῖς",702165,151]],"But he shall turn them to the Lord God of Israel, and he will be found of them."],["5",[["καὶ",707031,7],["ἐν",704639,0],["ἐκείνῳ",704183,50],["τῷ",709436,113],["καιρῷ",707047,114],["οὐκ",709805,28],["ἔστιν",704093,91],["εἰρήνη",704098,12],["τῷ",709436,113],["ἐκπορευομένῳ",704293,241],["καὶ",707031,7],["τῷ",709436,113],["εἰσπορευομένῳ",704124,241],["ὅτι",709803,7],["ἔκστασις",704314,12],["κυρίου",707996,18],["ἐπὶ",705080,0],["πάντας",710177,60],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["τὰς",709436,38],["χώρας",714011,39]],"And in that time there is no peace to one going out, or to one coming in, for the terror of the Lord is upon all that inhabit the lands."],["6",[["καὶ",707031,7],["πολεμήσει",710601,127],["ἔθνος",704068,15],["πρὸς",710844,0],["ἔθνος",704068,25],["καὶ",707031,7],["πόλις",710612,12],["πρὸς",710844,0],["πόλιν",710612,9],["ὅτι",709803,7],["ὁ",709436,3],["θεὸς",706192,4],["ἐξέστησεν",704940,2],["αὐτοὺς",702165,62],["ἐν",704639,0],["πάσῃ",710177,101],["θλίψει",706276,1]],"And nation shall fight against nation, and city against city; for God has confounded them with every [kind of] affliction."],["7",[["καὶ",707031,7],["ὑμεῖς",713081,219],["ἰσχύσατε",706859,74],["καὶ",707031,7],["μὴ",708851,28],["ἐκλυέσθωσαν",704254,77],["αἱ",709436,190],["χεῖρες",713787,191],["ὑμῶν",713091,145],["ὅτι",709803,7],["ἔστιν",704093,91],["μισθὸς",708939,4],["τῇ",709436,100],["ἐργασίᾳ",705385,1],["ὑμῶν",713091,145]],"But be ye strong, and let not your hands be weakened: for there is a reward for your work."],["8",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἀκοῦσαι",700587,106],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["καὶ",707031,7],["τὴν",709436,8],["προφητείαν",711007,9],["Αδαδ",700217,18],["τοῦ",709436,35],["προφήτου",711009,18],["καὶ",707031,7],["κατίσχυσεν",707531,2],["καὶ",707031,7],["ἐξέβαλεν",704145,2],["τὰ",709436,41],["βδελύγματα",702604,42],["ἀπὸ",701425,0],["πάσης",710177,82],["τῆς",709436,16],["γῆς",703083,17],["Ιουδα",706768,18],["καὶ",707031,7],["Βενιαμιν",702650,18],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,130],["πόλεων",710612,65],["ὧν",709781,199],["κατέσχεν",707526,2],["ἐν",704639,0],["ὄρει",709768,54],["Εφραιμ",705769,18],["καὶ",707031,7],["ἐνεκαίνισεν",703956,2],["τὸ",709436,24],["θυσιαστήριον",706348,25],["κυρίου",707996,18],["ὃ",709781,33],["ἦν",704093,13],["ἔμπροσθεν",704618,0],["τοῦ",709436,35],["ναοῦ",709191,18],["κυρίου",707996,18]],"And when [Asa] heard these words, and the prophecy of Adad the prophet, then he strengthened himself, and cast out the abominations from all the land of Juda and Benjamin, and from the cities which Jeroboam possessed, in mount Ephraim, and he renewed the altar of the Lord, which was before the temple of the Lord."],["9",[["καὶ",707031,7],["ἐξεκκλησίασεν",704217,2],["τὸν",709436,5],["Ιουδαν",706775,6],["καὶ",707031,7],["Βενιαμιν",702650,6],["καὶ",707031,7],["τοὺς",709436,58],["προσηλύτους",710900,57],["τοὺς",709436,58],["παροικοῦντας",710156,235],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["Εφραιμ",705769,18],["καὶ",707031,7],["ἀπὸ",701425,0],["Μανασση",708470,18],["καὶ",707031,7],["ἀπὸ",701425,0],["Συμεων",712297,18],["ὅτι",709803,7],["προσετέθησαν",710965,99],["πρὸς",710844,0],["αὐτὸν",702165,85],["πολλοὶ",710646,138],["τοῦ",709436,35],["Ισραηλ",706839,18],["ἐν",704639,0],["τῷ",709436,53],["ἰδεῖν",709725,106],["αὐτοὺς",702165,62],["ὅτι",709803,7],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["αὐτοῦ",702165,102],["μετ᾿",708780,0],["αὐτοῦ",702165,102]],"And he assembled Juda and Benjamin, and the strangers that dwelt with him, of Ephraim, and of Manasse, and of Symeon: for many of Israel were joined to him, when they saw that the Lord his God was with him."],["10",[["καὶ",707031,7],["συνήχθησαν",712375,99],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["ἐν",704639,0],["τῷ",709436,113],["μηνὶ",708874,114],["τῷ",709436,113],["τρίτῳ",712968,30],["ἐν",704639,0],["τῷ",709436,53],["πεντεκαιδεκάτῳ",710268,97],["ἔτει",705543,54],["τῆς",709436,16],["βασιλείας",702577,17],["Ασα",701870,18]],"And they assembled at Jerusalem in the third month, in the fifteenth year of the reign of Asa."],["11",[["καὶ",707031,7],["ἔθυσεν",706349,2],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐν",704639,0],["ἐκείνῃ",704183,105],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἀπὸ",701425,0],["τῶν",709436,43],["σκύλων",711902,44],["ὧν",709781,103],["ἤνεγκαν",713428,150],["μόσχους",709029,57],["ἑπτακοσίους",705365,60],["καὶ",707031,7],["πρόβατα",710768,42],["ἑπτακισχίλια",705363,68]],"And he sacrificed to the Lord in that day of the spoils which they brought, seven hundred calves and seven thousand sheep."],["12",[["καὶ",707031,7],["διῆλθεν",703673,2],["ἐν",704639,0],["διαθήκῃ",703456,1],["ζητῆσαι",705879,106],["κύριον",707996,6],["θεὸν",706192,6],["τῶν",709436,80],["πατέρων",710189,81],["αὐτῶν",702165,40],["ἐξ",704132,0],["ὅλης",709597,82],["τῆς",709436,16],["καρδίας",707141,17],["καὶ",707031,7],["ἐξ",704132,0],["ὅλης",709597,82],["τῆς",709436,16],["ψυχῆς",714070,17]],"And he entered into a covenant that they should seek the Lord God of their fathers with all their heart and with all their soul."],["13",[["καὶ",707031,7],["πᾶς",710177,14],["ὃς",709781,213],["ἐὰν",703912,7],["μὴ",708851,28],["ἐκζητήσῃ",704187,172],["κύριον",707996,6],["θεὸν",706192,6],["Ισραηλ",706839,18],["ἀποθανεῖται",701461,93],["ἀπὸ",701425,0],["νεωτέρου",709256,229],["ἕως",705792,0],["πρεσβυτέρου",710735,18],["ἀπὸ",701425,0],["ἀνδρὸς",701150,18],["ἕως",705792,0],["γυναικός",703209,17]],"And that whoever should not seek the Lord God of Israel, should die, whether young or old, whether man or woman."],["14",[["καὶ",707031,7],["ὤμοσαν",709620,150],["ἐν",704639,0],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐν",704639,0],["φωνῇ",713640,1],["μεγάλῃ",708653,101],["καὶ",707031,7],["ἐν",704639,0],["σάλπιγξιν",711424,76],["καὶ",707031,7],["ἐν",704639,0],["κερατίναις",707629,76]],"And they swore to the Lord with a loud voice, and with trumpets, and with cornets."],["15",[["καὶ",707031,