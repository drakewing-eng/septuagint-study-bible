me and worship toward this place;—"],["33",[["καὶ",707031,7],["εἰσακούσῃ",704108,166],["ἐκ",704132,0],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["ἐξ",704132,0],["ἑτοίμου",705541,92],["κατοικητηρίου",707536,21],["σου",711945,133],["καὶ",707031,7],["ποιήσεις",710582,166],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἐὰν",703912,7],["ἐπικαλέσηταί",705153,239],["σε",711598,163],["ὁ",709436,3],["ἀλλότριος",700699,14],["ὅπως",709719,7],["γνῶσιν",703105,234],["πάντες",710177,138],["οἱ",709436,136],["λαοὶ",708094,52],["τῆς",709436,16],["γῆς",703083,17],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["καὶ",707031,7],["τοῦ",709436,20],["φοβεῖσθαί",713532,110],["σε",711598,163],["ὡς",714148,7],["ὁ",709436,3],["λαός",708094,4],["σου",711945,133],["Ισραηλ",706839,4],["καὶ",707031,7],["τοῦ",709436,20],["γνῶναι",703105,106],["ὅτι",709803,7],["ἐπικέκληται",705153,187],["τὸ",709436,34],["ὄνομά",709666,15],["σου",711945,133],["ἐπὶ",705080,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦτον",709858,85],["ὃν",709781,112],["ᾠκοδόμησα",709509,155]],"then shalt thou hearken out of heaven, out of thy prepared dwelling-place, and shalt do according to all that the stranger shall call upon thee for; that all the nations of the earth may know thy name, and that they may fear thee, as thy people Israel [do], and that they may know that thy name is called upon this house which I have built."],["34",[["ἐὰν",703912,7],["δὲ",703303,11],["ἐξέλθῃ",704909,172],["ὁ",709436,3],["λαός",708094,4],["σου",711945,133],["εἰς",704105,0],["πόλεμον",710605,6],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἐχθροὺς",705779,60],["αὐτοῦ",702165,102],["ἐν",704639,0],["ὁδῷ",709458,1],["ᾗ",709781,108],["ἀποστελεῖς",701592,166],["αὐτούς",702165,62],["καὶ",707031,7],["προσεύξωνται",710893,232],["πρὸς",710844,0],["σὲ",711598,163],["κατὰ",707200,0],["τὴν",709436,8],["ὁδὸν",709458,9],["τῆς",709436,16],["πόλεως",710612,17],["ταύτης",709858,86],["ἣν",709781,131],["ἐξελέξω",704236,174],["ἐν",704639,0],["αὐτῇ",702165,105],["καὶ",707031,7],["οἴκου",709516,18],["οὗ",709781,48],["ᾠκοδόμησα",709509,155],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133]],"And if thy people shall go forth to war against their enemies by the way by which thou shalt send them, and shall pray to thee toward this city which thou hast chosen, and [toward] the house which I have built to thy name;"],["35",[["καὶ",707031,7],["ἀκούσῃ",700587,166],["ἐκ",704132,0],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["τῆς",709436,16],["δεήσεως",703311,17],["αὐτῶν",702165,40],["καὶ",707031,7],["τῆς",709436,16],["προσευχῆς",710892,17],["αὐτῶν",702165,40],["καὶ",707031,7],["ποιήσεις",710582,166],["τὸ",709436,24],["δικαίωμα",703697,25],["αὐτῶν",702165,40]],"then shalt thou hear out of heaven their prayer and their supplication, and maintain their cause."],["36",[["ὅτι",709803,7],["ἁμαρτήσονταί",700773,135],["σοι",711925,159],["ὅτι",709803,7],["οὐκ",709805,28],["ἔσται",704093,93],["ἄνθρωπος",701163,4],["ὃς",709781,213],["οὐχ",709805,28],["ἁμαρτήσεται",700773,93],["καὶ",707031,7],["πατάξεις",710185,166],["αὐτοὺς",702165,62],["καὶ",707031,7],["παραδώσεις",710014,166],["αὐτοὺς",702165,62],["κατὰ",707200,0],["πρόσωπον",710986,25],["ἐχθρῶν",705779,169],["καὶ",707031,7],["αἰχμαλωτεύσουσιν",700500,218],["οἱ",709436,136],["αἰχμαλωτεύοντες",700500,146],["αὐτοὺς",702165,62],["εἰς",704105,0],["γῆν",703083,9],["ἐχθρῶν",705779,169],["εἰς",704105,0],["γῆν",703083,9],["μακρὰν",708411,28],["ἢ",705924,7],["ἐγγὺς",703948,28]],"Whereas if they shall sin against thee, (for there is no man who will not sin,) and thou shalt smite them, and deliver them up before their enemies, and they that take them captive shall carry them away into a land of enemies, to a land far off or near;"],["37",[["καὶ",707031,7],["ἐπιστρέψωσιν",705278,234],["καρδίαν",707141,9],["αὐτῶν",702165,40],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["αὐτῶν",702165,40],["οὗ",709781,48],["μετήχθησαν",708789,99],["ἐκεῖ",704181,28],["καί",707031,7],["γε",702985,11],["ἐπιστρέψωσιν",705278,234],["καὶ",707031,7],["δεηθῶσίν",703394,272],["σου",711945,133],["ἐν",704639,0],["τῇ",709436,100],["αἰχμαλωσίᾳ",700499,1],["αὐτῶν",702165,40],["λέγοντες",708124,146],["ἡμάρτομεν",700773,289],["ἠδικήσαμεν",700269,289],["ἠνομήσαμεν",701190,289]],"and [if] they shall repent in their land whither they were carried captive, and shall also turn and make supplication to thee in their captivity, saying, We have sinned, we have transgressed, we have wrought unrighteously;"],["38",[["καὶ",707031,7],["ἐπιστρέψωσιν",705278,234],["πρὸς",710844,0],["σὲ",711598,163],["ἐν",704639,0],["ὅλῃ",709597,101],["καρδίᾳ",707141,1],["καὶ",707031,7],["ἐν",704639,0],["ὅλῃ",709597,101],["ψυχῇ",714070,1],["αὐτῶν",702165,40],["ἐν",704639,0],["γῇ",703083,1],["αἰχμαλωτευσάντων",700500,221],["αὐτοὺς",702165,62],["καὶ",707031,7],["προσεύξωνται",710893,232],["ὁδὸν",709458,9],["γῆς",703083,17],["αὐτῶν",702165,40],["ἧς",709781,167],["ἔδωκας",703654,162],["τοῖς",709436,147],["πατράσιν",710189,148],["αὐτῶν",702165,40],["καὶ",707031,7],["τῆς",709436,16],["πόλεως",710612,17],["ἧς",709781,167],["ἐξελέξω",704236,174],["καὶ",707031,7],["τοῦ",709436,35],["οἴκου",709516,18],["οὗ",709781,48],["ᾠκοδόμησα",709509,155],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133]],"and [if] they shall turn to thee with all their heart and all their soul in the land of them that carried them captives, whither they carried them captives, and shall pray toward their land which thou gavest to their fathers, and the city which thou didst choose, and the house which I built to thy name:—"],["39",[["καὶ",707031,7],["ἀκούσῃ",700587,166],["ἐκ",704132,0],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["ἐξ",704132,0],["ἑτοίμου",705541,92],["κατοικητηρίου",707536,21],["σου",711945,133],["τῆς",709436,16],["προσευχῆς",710892,17],["αὐτῶν",702165,40],["καὶ",707031,7],["τῆς",709436,16],["δεήσεως",703311,17],["αὐτῶν",702165,40],["καὶ",707031,7],["ποιήσεις",710582,166],["κρίματα",707903,42],["καὶ",707031,7],["ἵλεως",706732,14],["ἔσῃ",704093,123],["τῷ",709436,113],["λαῷ",708094,114],["τῷ",709436,113],["ἁμαρτόντι",700773,350],["σοι",711925,159]],"then shalt thou hear out of heaven, out of thy prepared dwelling-place, their prayer and their supplication, and thou shalt execute justice, and shalt be merciful to thy people that sin against thee."],["40",[["νῦν",709384,28],["κύριε",707996,153],["ἔστωσαν",704093,56],["δὴ",703395,11],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["σου",711945,133],["ἀνεῳγμένοι",701186,429],["καὶ",707031,7],["τὰ",709436,41],["ὦτά",709852,42],["σου",711945,133],["ἐπήκοα",705077,195],["εἰς",704105,0],["τὴν",709436,8],["δέησιν",703311,9],["τοῦ",709436,35],["τόπου",712903,18],["τούτου",709858,102]],"And now, Lord, let, I pray thee, thine eyes be opened, and thine ears be attentive to the petition [made in] this place."],["41",[["καὶ",707031,7],["νῦν",709384,28],["ἀνάστηθι",701173,176],["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["εἰς",704105,0],["τὴν",709436,8],["κατάπαυσίν",707364,9],["σου",711945,133],["σὺ",712181,164],["καὶ",707031,7],["ἡ",709436,10],["κιβωτὸς",707667,12],["τῆς",709436,16],["ἰσχύος",706858,17],["σου",711945,133],["οἱ",709436,136],["ἱερεῖς",706614,52],["σου",711945,133],["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["ἐνδύσαιντο",704701,529],["σωτηρίαν",712658,9],["καὶ",707031,7],["οἱ",709436,136],["υἱοί",713075,52],["σου",711945,133],["εὐφρανθήτωσαν",705715,51],["ἐν",704639,0],["ἀγαθοῖς",700106,230]],"And now, O Lord God, arise into thy resting-place, thou, and the ark of thy strength: let thy priests, O Lord God, clothe themselves with salvation, and thy sons rejoice in prosperity."],["42",[["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["μὴ",708851,28],["ἀποστρέψῃς",701598,175],["τὸ",709436,24],["πρόσωπον",710986,25],["τοῦ",709436,35],["χριστοῦ",713964,116],["σου",711945,133],["μνήσθητι",708960,244],["τὰ",709436,41],["ἐλέη",704426,42],["Δαυιδ",703232,18],["τοῦ",709436,35],["δούλου",703817,18],["σου",711945,133]],"O Lord God, turn not away the face of thine anointed: remember the mercies of thy servant David."]]