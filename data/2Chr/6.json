],["19",[["καὶ",707031,7],["ἐπιβλέψῃ",705088,172],["ἐπὶ",705080,0],["τὴν",709436,8],["προσευχὴν",710892,9],["παιδός",709932,18],["σου",711945,133],["καὶ",707031,7],["ἐπὶ",705080,0],["τὴν",709436,8],["δέησίν",703311,9],["μου",709032,133],["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["τοῦ",709436,20],["ἐπακοῦσαι",705009,106],["τῆς",709436,16],["δεήσεως",703311,17],["καὶ",707031,7],["τῆς",709436,16],["προσευχῆς",710892,17],["ἧς",709781,167],["ὁ",709436,3],["παῖς",709932,4],["σου",711945,133],["προσεύχεται",710893,117],["ἐναντίον",704654,0],["σου",711945,133],["σήμερον",711751,28]],"Yet thou shalt have respect to the prayer of thy servant, and to my petition, O Lord God, so as to hearken to the petition and the prayer which thy servant prays before thee this day:"],["20",[["τοῦ",709436,20],["εἶναι",704093,55],["ὀφθαλμούς",709870,57],["σου",711945,133],["ἀνεῳγμένους",701186,360],["ἐπὶ",705080,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦτον",709858,85],["ἡμέρας",705984,17],["καὶ",707031,7],["νυκτός",709386,17],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["τοῦτον",709858,85],["ὃν",709781,112],["εἶπας",705373,162],["ἐπικληθῆναι",705153,179],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["ἐκεῖ",704181,28],["τοῦ",709436,20],["ἀκοῦσαι",700587,106],["τῆς",709436,16],["προσευχῆς",710892,17],["ἧς",709781,167],["ὁ",709436,3],["παῖς",709932,4],["σου",711945,133],["προσεύχεται",710893,117],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["τοῦτον",709858,85]],"so that thine eyes should be open over this house by day and by night, towards this place, whereon thou saidst thy name should be called, so as to hear the prayer which thy servant prays towards this house."],["21",[["καὶ",707031,7],["ἀκούσῃ",700587,166],["τῆς",709436,16],["δεήσεως",703311,17],["τοῦ",709436,35],["παιδός",709932,18],["σου",711945,133],["καὶ",707031,7],["λαοῦ",708094,18],["σου",711945,133],["Ισραηλ",706839,18],["ἃ",709781,69],["ἂν",700900,11],["προσεύξωνται",710893,232],["εἰς",704