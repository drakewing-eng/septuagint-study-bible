[["1",[["τότε",712908,28],["εἶπεν",705373,2],["Σαλωμων",711430,4],["κύριος",707996,4],["εἶπεν",705373,2],["τοῦ",709436,20],["κατασκηνῶσαι",707422,106],["ἐν",704639,0],["γνόφῳ",703131,114]],"Then said Solomon, The Lord said that he would dwell in thick darkness."],["2",[["καὶ",707031,7],["ἐγὼ",704018,164],["ᾠκοδόμηκα",709509,89],["οἶκον",709516,6],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["ἅγιόν",700159,27],["σοι",711925,159],["καὶ",707031,7],["ἕτοιμον",705541,27],["τοῦ",709436,20],["κατασκηνῶσαι",707422,106],["εἰς",704105,0],["τοὺς",709436,58],["αἰῶνας",700504,57]],"But I have built a house to thy name, holy to thee, and prepared [for thee] to dwell in for ever."],["3",[["καὶ",707031,7],["ἐπέστρεψεν",705278,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["εὐλόγησεν",705631,2],["τὴν",709436,8],["πᾶσαν",710177,36],["ἐκκλησίαν",704216,9],["Ισραηλ",706839,18],["καὶ",707031,7],["πᾶσα",710177,29],["ἐκκλησία",704216,12],["Ισραηλ",706839,18],["παρειστήκει",710152,171]],"And the king turned his face, and blessed all the congregation of Israel: and all the congregation of Israel stood by."],["4",[["καὶ",707031,7],["εἶπεν",705373,2],["εὐλογητὸς",705632,14],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ὃς",709781,213],["ἐλάλησεν",708071,2],["ἐν",704639,0],["στόματι",712125,54],["αὐτοῦ",702165,102],["πρὸς",710844,0],["Δαυιδ",703232,6],["τὸν",709436,5],["πατέρα",710189,6],["μου",709032,133],["καὶ",707031,7],["ἐν",704639,0],["χερσὶν",713787,76],["αὐτοῦ",702165,102],["ἐπλήρωσεν",710543,2],["λέγων",708124,72]],"And he said, Blessed [be] the Lord God of Israel: he has even fulfilled with his hands as he spoke with his mouth to my father David, saying,"],["5",[["ἀπὸ",701425,0],["τῆς",709436,16],["ἡμέρας",705984,17],["ἧς",709781,167],["ἀνήγαγον",700933,333],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["ο