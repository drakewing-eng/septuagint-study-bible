[["1",[["ὢν",704093,72],["ὀκτὼ",709555,59],["ἐτῶν",705543,44],["Ιωσιας",706950,4],["ἐν",704639,0],["τῷ",709436,53],["βασιλεῦσαι",702581,106],["αὐτὸν",702165,85],["καὶ",707031,7],["τριάκοντα",712934,59],["ἓν",704106,629],["ἔτος",705543,25],["ἐβασίλευσεν",702581,2],["ἐν",704639,0],["Ιερουσαλημ",706644,1]],"Josias was eight years old when he began to reign, and he reigned thirty-one years in Jerusalem."],["2",[["καὶ",707031,7],["ἐποίησεν",710582,2],["τὸ",709436,24],["εὐθὲς",705596,46],["ἐναντίον",704654,0],["κυρίου",707996,18],["καὶ",707031,7],["ἐπορεύθη",710667,37],["ἐν",704639,0],["ὁδοῖς",709458,76],["Δαυιδ",703232,18],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ἐξέκλινεν",704220,13],["δεξιὰ",703360,68],["καὶ",707031,7],["ἀριστερά",701749,68]],"And he did that which was right in the sight of the Lord, and walked in the ways of his father David, and turned not aside to the right hand or to the left."],["3",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ὀγδόῳ",709444,97],["ἔτει",705543,54],["τῆς",709436,16],["βασιλείας",702577,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["αὐτὸς",702165,121],["ἔτι",705538,28],["παιδάριον",709923,25],["ἤρξατο",701860,23],["τοῦ",709436,20],["ζητῆσαι",705879,106],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["Δαυιδ",703232,18],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["δωδεκάτῳ",703890,97],["ἔτει",705543,54],["τῆς",709436,16],["βασιλείας",702577,17],["αὐτοῦ",702165,102],["ἤρξατο",701860,23],["τοῦ",709436,20],["καθαρίσαι",706985,106],["τὸν",709436,5],["Ιουδαν",706775,6],["καὶ",707031,7],["τὴν",709436,8],["Ιερουσαλημ",706644,9],["ἀπὸ",701425,0],["τῶν",709436,80],["ὑψηλῶν",713285,169],["καὶ",707031,7],["τῶν",709436,43],["ἄλσεων",700729,44],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,80],["χωνευτῶν",714009,169]],"And in the eighth year of his reign, and he [being] yet a youth, he began to seek the Lord God of his father David: and in the twelfth year of his reign he began to purge Juda and Jerusalem from the high places, and the groves, and the ornaments for the altars, and the molten images."],["4",[["καὶ",707031,7],["κατέσπασεν",707431,2],["κατὰ",707200,0],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["τὰ",709436,41],["θυσιαστήρια",706348,42],["τῶν",709436,130],["Βααλιμ",702342,65],["καὶ",707031,7],["τὰ",709436,41],["ὑψηλὰ",713285,68],["τὰ",709436,41],["ἐπ᾿",705080,0],["αὐτῶν",702165,284],["καὶ",707031,7],["ἔκοψεν",707829,2],["τὰ",709436,41],["ἄλση",700729,42],["καὶ",707031,7],["τὰ",709436,41],["γλυπτὰ",703117,68],["καὶ",707031,7],["τὰ",709436,41],["χωνευτὰ",714009,68],["συνέτριψεν",712520,2],["καὶ",707031,7],["ἐλέπτυνεν",708154,2],["καὶ",707031,7],["ἔρριψεν",711267,2],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["τῶν",709436,43],["μνημάτων",708962,44],["τῶν",709436,80],["θυσιαζόντων",706346,170],["αὐτοῖς",702165,151]],"And he pulled down the altars of Baalim that were before his face, and the high places that were above them; and he cut down the groves, and the graven images, and broke in pieces the molten images, and reduced them to powder, and cast [it] upon the surface of the tombs of those who [had] sacrificed to them."],["5",[["καὶ",707031,7],["ὀστᾶ",709792,42],["ἱερέων",706614,81],["κατέκαυσεν",707258,2],["ἐπὶ",705080,0],["τὰ",709436,41],["θυσιαστήρια",706348,42],["καὶ",707031,7],["ἐκαθάρισεν",706985,2],["τὸν",709436,5],["Ιουδαν",706775,6],["καὶ",707031,7],["τὴν",709436,8],["Ιερουσαλημ",706644,9]],"And he burnt the bones of the priests upon the altars, and purged Juda and Jerusalem."],["6",[["καὶ",707031,7],["ἐν",704639,0],["πόλεσιν",710612,76],["Εφραιμ",705769,18],["καὶ",707031,7],["Μανασση",708470,18],["καὶ",707031,7],["Συμεων",712297,18],["καὶ",707031,7],["Νεφθαλι",709279,18],["καὶ",707031,7],["τοῖς",709436,147],["τόποις",712903,148],["αὐτῶν",702165,40],["κύκλῳ",707959,114]],"And [he did so] in the cities of Manasse, and Ephraim, and Symeon, and Nephthali, and the places round about them."],["7",[["καὶ",707031,7],["κατέσπασεν",707431,2],["τὰ",709436,41],["ἄλση",700729,42],["καὶ",707031,7],["τὰ",709436,41],["θυσιαστήρια",706348,42],["καὶ",707031,7],["τὰ",709436,41],["εἴδωλα",704079,42],["κατέκοψεν",707285,2],["λεπτὰ",708153,68],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["ὑψηλὰ",713285,68],["ἔκοψεν",707829,2],["ἀπὸ",701425,0],["πάσης",710177,82],["τῆς",709436,16],["γῆς",703083,17],["Ισραηλ",706839,18],["καὶ",707031,7],["ἀπέστρεψεν",701598,2],["εἰς",704105,0],["Ιερουσαλημ",706644,9]],"And he pulled down the altars and the groves, and he cut the idols in small pieces, and cut off all the high places from all the land of Israel, and returned to Jerusalem."],["8",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ὀκτωκαιδεκάτῳ",709557,97],["ἔτει",705543,54],["τῆς",709436,16],["βασιλείας",702577,17],["αὐτοῦ",702165,102],["τοῦ",709436,20],["καθαρίσαι",706985,106],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["τὸν",709436,5],["οἶκον",709516,6],["ἀπέστειλεν",701592,2],["τὸν",709436,5],["Σαφαν",711569,6],["υἱὸν",713075,6],["Εσελια",705476,18],["καὶ",707031,7],["τὸν",709436,5],["Μαασιαν",708314,6],["ἄρχοντα",701862,6],["τῆς",709436,16],["πόλεως",710612,17],["καὶ",707031,7],["τὸν",709436,5],["Ιουαχ",706766,6],["υἱὸν",713075,6],["Ιωαχαζ",706900,18],["τὸν",709436,5],["ὑπομνηματογράφον",713224,6],["αὐτοῦ",702165,102],["κραταιῶσαι",707875,106],["τὸν",709436,5],["οἶκον",709516,6],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["αὐτοῦ",702165,102]],"And in the eighteenth year of his reign, after having cleansed the land, and the house, he sent Saphan the son of Ezelias, and Maasa prefect of the city, and Juach son of Joachaz his recorder, to repair the house of the Lord his God."],["9",[["καὶ",707031,7],["ἦλθον",705453,150],["πρὸς",710844,0],["Χελκιαν",713815,6],["τὸν",709436,5],["ἱερέα",706614,6],["τὸν",709436,5],["μέγαν",708653,27],["καὶ",707031,7],["ἔδωκαν",703654,150],["τὸ",709436,24],["ἀργύριον",701707,25],["τὸ",709436,24],["εἰσενεχθὲν",704127,377],["εἰς",704105,0],["οἶκον",709516,6],["θεοῦ",706192,18],["ὃ",709781,213],["συνήγαγον",712375,150],["οἱ",709436,136],["Λευῖται",708160,52],["φυλάσσοντες",713619,146],["τὴν",709436,8],["πύλην",711082,9],["ἐκ",704132,0],["χειρὸς",713787,17],["Μανασση",708470,18],["καὶ",707031,7],["Εφραιμ",705769,18],["καὶ",707031,7],["τῶν",709436,80],["ἀρχόντων",701862,81],["καὶ",707031,7],["ἀπὸ",701425,0],["παντὸς",710177,116],["καταλοίπου",707317,116],["ἐν",704639,0],["Ισραηλ",706839,114],["καὶ",707031,7],["υἱῶν",713075,81],["Ιουδα",706768,18],["καὶ",707031,7],["Βενιαμιν",702650,18],["καὶ",707031,7],["οἰκούντων",709499,170],["ἐν",704639,0],["Ιερουσαλημ",706644,1]],"And they came to Chelcias the high priest, and gave the money that was brought into the house of God, which the Levites who kept the gate collected of the hand of Manasse and Ephraim, and of the princes, and of every one that was left in Israel, and of the children of Juda and Benjamin, and of the dwellers in Jerusalem."],["10",[["καὶ",707031,7],["ἔδωκαν",703654,150],["αὐτὸ",702165,129],["ἐπὶ",705080,0],["χεῖρα",713787,9],["ποιούντων",710582,170],["τὰ",709436,41],["ἔργα",705396,42],["οἱ",709436,136],["καθεσταμένοι",707011,429],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18],["καὶ",707031,7],["ἔδωκαν",703654,150],["αὐτὸ",702165,129],["ποιοῦσι",710582,197],["τὰ",709436,41],["ἔργα",705396,42],["οἳ",709781,250],["ἐποίουν",710582,137],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18],["ἐπισκευάσαι",705251,106],["κατισχῦσαι",707531,106],["τὸν",709436,5],["οἶκον",709516,6]],"And they gave it into the hand of the workmen, who were appointed in the house of the Lord, and they gave it to the workmen who wrought in the house of the Lord, to repair and strengthen the house."],["11",[["καὶ",707031,7],["ἔδωκαν",703654,150],["τοῖς",709436,147],["τέκτοσι",712766,148],["καὶ",707031,7],["τοῖς",709436,147],["οἰκοδόμοις",709511,148],["ἀγοράσαι",700184,106],["λίθους",708196,57],["τετραπέδους",712821,60],["καὶ",707031,7],["ξύλα",709427,42],["εἰς",704105,0],["δοκοὺς",703781,39],["στεγάσαι",712056,106],["τοὺς",709436,58],["οἴκους",709516,57],["οὓς",709781,298],["ἐξωλέθρευσαν",704956,150],["βασιλεῖς",702580,52],["Ιουδα",706768,18]],"They gave [it] also to the carpenters and builders, to buy squared stones, and timber for beams to cover the houses which the kings of Juda had destroyed."],["12",[["καὶ",707031,7],["οἱ",709436,136],["ἄνδρες",701150,52],["ἐν",704639,0],["πίστει",710484,1],["ἐπὶ",705080,0],["τῶν",709436,43],["ἔργων",705396,44],["καὶ",707031,7],["ἐπ᾿",705080,0],["αὐτῶν",702165,40],["ἐπίσκοποι",705256,52],["Ιεθ",706556,4],["καὶ",707031,7],["Αβδιας",700032,4],["οἱ",709436,136],["Λευῖται",708160,52],["ἐξ",704132,0],["υἱῶν",713075,81],["Μεραρι",708739,4],["καὶ",707031,7],["Ζαχαριας",705847,4],["καὶ",707031,7],["Μοσολλαμ",709022,4],["ἐκ",704132,0],["τῶν",709436,80],["υἱῶν",713075,81],["Κααθ",706961,4],["ἐπισκοπεῖν",705254,55],["καὶ",707031,7],["πᾶς",710177,14],["Λευίτης",708160,4],["πᾶς",710177,14],["συνίων",712481,72],["ἐν",704639,0],["ὀργάνοις",709727,96],["ᾠδῶν",714091,65]],"And the men [were] faithfully [engaged] in the works: and over them were superintendents, Jeth and Abdias, Levites of the sons of Merari, and Zacharias and Mosollam, of the sons of Caath, [appointed] to oversee; and every Levite, and every one that understood [how] to play on musical instruments."],["13",[["καὶ",707031,7],["ἐπὶ",705080,0],["τῶν",709436,80],["νωτοφόρων",709404,169],["καὶ",707031,7],["ἐπὶ",705080,0],["πάντων",710177,169],["τῶν",709436,80],["ποιούντων",710582,170],["τὰ",709436,41],["ἔργα",705396,42],["ἐργασίᾳ",705385,1],["καὶ",707031,7],["ἐργασίᾳ",705385,1],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,80],["Λευιτῶν",708160,81],["γραμματεῖς",703185,52],["καὶ",707031,7],["κριταὶ",707910,52],["καὶ",707031,7],["πυλωροί",711084,52]],"And [overseers were] over the burden-bearers, and over all the workmen in the respective works; and of the Levites [were appointed] scribes, and judges, and porters."],["14",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἐκφέρειν",704356,55],["αὐτοὺς",702165,62],["τὸ",709436,24],["ἀργύριον",701707,25],["τὸ",709436,24],["εἰσοδιασθὲν",704117,377],["εἰς",704105,0],["οἶκον",709516,6],["κυρίου",707996,18],["εὗρεν",705676,2],["Χελκιας",713815,4],["ὁ",709436,3],["ἱερεὺς",706614,4],["βιβλίον",702719,25],["νόμου",709349,18],["κυρίου",707996,18],["διὰ",703417,0],["χειρὸς",713787,17],["Μωυσῆ",709112,18]],"And when they brought forth the money that had been brought into the house of the Lord, Chelcias the priest found a book of the law of the Lord [given] by the hand of Moses."],["15",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["Χελκιας",713815,4],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["Σαφαν",711569,6],["τὸν",709436,5],["γραμματέα",703185,6],["βιβλίον",702719,15],["νόμου",709349,18],["εὗρον",705676,155],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18],["καὶ",707031,7],["ἔδωκεν",703654,2],["Χελκιας",713815,4],["τὸ",709436,24],["βιβλίον",702719,25],["τῷ",709436,113],["Σαφαν",711569,114]],"And Chelcias answered and said to Saphan the scribe, I have found a book of the law in the house of the Lord. And Chelcias gave the book to Saphan."],["16",[["καὶ",707031,7],["εἰσήνεγκεν",704127,2],["Σαφαν",711569,4],["τὸ",709436,24],["βιβλίον",702719,25],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["καὶ",707031,7],["ἀπέδωκεν",701449,2],["ἔτι",705538,28],["τῷ",709436,113],["βασιλεῖ",702580,114],["λόγον",708236,6],["πᾶν",710177,46,27],["τὸ",709436,24],["δοθὲν",703654,377],["ἀργύριον",701707,25],["ἐν",704639,0],["χειρὶ",713787,1],["τῶν",709436,80],["παίδων",709932,81],["σου",711945,133],["τῶν",709436,80],["ποιούντων",710582,170],["τὸ",709436,24],["ἔργον",705396,25]],"And Saphan brought in the book to the king, and moreover gave an account to the king, [saying, This is] all the money given into the hand of thy servants that work."],["17",[["καὶ",707031,7],["ἐχώνευσαν",714010,150],["τὸ",709436,24],["ἀργύριον",701707,25],["τὸ",709436,24],["εὑρεθὲν",705676,377],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18],["καὶ",707031,7],["ἔδωκαν",703654,150],["ἐπὶ",705080,0],["χεῖρα",713787,9],["τῶν",709436,80],["ἐπισκόπων",705256,81],["καὶ",707031,7],["ἐπὶ",705080,0],["χεῖρα",713787,9],["τῶν",709436,80],["ποιούντων",710582,170],["ἐργασίαν",705385,9]],"And they have collected the money that was found in the house of the Lord, and given it into the hand of the overseers, and into the hand of them that do the work."],["18",[["καὶ",707031,7],["ἀπήγγειλεν",701321,2],["Σαφαν",711569,4],["ὁ",709436,3],["γραμματεὺς",703185,4],["τῷ",709436,113],["βασιλεῖ",702580,114],["λέγων",708124,72],["βιβλίον",702719,25],["ἔδωκέν",703654,2],["μοι",708974,159],["Χελκιας",713815,4],["ὁ",709436,3],["ἱερεύς",706614,4],["καὶ",707031,7],["ἀνέγνω",700922,2],["αὐτὸ",702165,129],["Σαφαν",711569,4],["ἐναντίον",704654,0],["τοῦ",709436,35],["βασιλέως",702580,18]],"And Saphan the scribe brought word to the king, saying, Chelcias the priest has given me a book. And Saphan read it before the king."],["19",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὡς",714148,7],["ἤκουσεν",700587,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["τοὺς",709436,58],["λόγους",708236,57],["τοῦ",709436,35],["νόμου",709349,18],["καὶ",707031,7],["διέρρηξεν",703565,2],["τὰ",709436,41],["ἱμάτια",706742,42],["αὐτοῦ",702165,102]],"And it came to pass, when the king heard the words of the law, that he rent his garments."],["20",[["καὶ",707031,7],["ἐνετείλατο",704791,23],["ὁ",709436,3],["βασιλεὺς",702580,4],["τῷ",709436,113],["Χελκια",713815,114],["καὶ",707031,7],["τῷ",709436,113],["Αχικαμ",702272,114],["υἱῷ",713075,114],["Σαφαν",711569,18],["καὶ",707031,7],["τῷ",709436,113],["Αβδων",700035,114],["υἱῷ",713075,114],["Μιχαια",708954,18],["καὶ",707031,7],["τῷ",709436,113],["Σαφαν",711569,114],["τῷ",709436,113],["γραμματεῖ",703185,114],["καὶ",707031,7],["τῷ",709436,113],["Ασαια",701879,114],["παιδὶ",709932,114],["τοῦ",709436,35],["βασιλέως",702580,18],["λέγων",708124,72]],"And the king commanded Chelcias, and Achicam the son of Saphan, and Abdom the son of Michaias, and Saphan the scribe, and Asaia the servant of the king, saying,"],["21",[["πορεύθητε",710667,372],["ζητήσατε",705879,74],["τὸν",709436,5],["κύριον",707996,6],["περὶ",710285,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["περὶ",710285,0],["παντὸς",710177,116],["τοῦ",709436,35],["καταλειφθέντος",707305,319],["ἐν",704639,0],["Ισραηλ",706839,114],["καὶ",707031,7],["Ιουδα",706768,114],["περὶ",710285,0],["τῶν",709436,80],["λόγων",708236,81],["τοῦ",709436,20],["βιβλίου",702719,21],["τοῦ",709436,20],["εὑρεθέντος",705676,401],["ὅτι",709803,7],["μέγας",708653,14],["ὁ",709436,3],["θυμὸς",706334,4],["κυρίου",707996,18],["ἐκκέκαυται",704205,187],["ἐν",704639,0],["ἡμῖν",705994,90],["διότι",703734,7],["οὐκ",709805,28],["εἰσήκουσαν",704108,150],["οἱ",709436,136],["πατέρες",710189,52],["ἡμῶν",705999,145],["τῶν",709436,80],["λόγων",708236,81],["κυρίου",707996,18],["τοῦ",709436,20],["ποιῆσαι",710582,106],["κατὰ",707200,0],["πάντα",710177,68],["τὰ",709436,41],["γεγραμμένα",703194,388],["ἐν",704639,0],["τῷ",709436,53],["βιβλίῳ",702719,54],["τούτῳ",709858,280]],"Go, enquire of the Lord for me, and for every one that is left in Israel and Juda, concerning the words of the book that is found: for great is the wrath of the Lord [which] has been kindled amongst us, because our fathers have not hearkened to the words of the Lord, to do according to all the things written in this book."],["22",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["Χελκιας",713815,4],["καὶ",707031,7],["οἷς",709781,295],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["πρὸς",710844,0],["Ολδαν",709559,9],["τὴν",709436,8],["προφῆτιν",711010,9],["γυναῖκα",703209,9],["Σελλημ",711653,18],["υἱοῦ",713075,18],["Θακουαθ",706066,18],["υἱοῦ",713075,18],["Χελλης",713817,18],["φυλάσσουσαν",713619,78],["τὰς",709436,38],["στολάς",712120,39],["καὶ",707031,7],["αὕτη",709858,107],["κατῴκει",707534,13],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["ἐν",704639,0],["μασανα",708539,111],["καὶ",707031,7],["ἐλάλησαν",708071,150],["αὐτῇ",702165,105],["κατὰ",707200,0],["ταῦτα",709858,71]],"And Chelcias went, and [the others] whom the king told, to Olda the prophetess, the wife of Sellem son of Thecoe, son of Aras, who kept the commandments; and she dwelt in Jerusalem in the second [quarter]: and they spoke to her accordingly."],["23",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["εἴπατε",705373,74],["τῷ",709436,113],["ἀνδρὶ",701150,114],["τῷ",709436,113],["ἀποστείλαντι",701592,350],["ὑμᾶς",713080,194],["πρός",710844,0],["με",708618,163]],"And she said to them, Thus has the Lord God of Israel said, Tell the man who sent you to me,"],["24",[["οὕτως",709859,28],["λέγει",708124,91],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐπάγω",704994,157],["κακὰ",707066,68],["ἐπὶ",705080,0],["τὸν",709436,5],["τόπον",712903,6],["τοῦτον",709858,85],["τοὺς",709436,58],["πάντας",710177,60],["λόγους",708236,57],["τοὺς",709436,58],["γεγραμμένους",703194,360],["ἐν",704639,0],["τῷ",709436,53],["βιβλίῳ",702719,54],["τῷ",709436,53],["ἀνεγνωσμένῳ",700922,447],["ἐναντίον",704654,0],["τοῦ",709436,35],["βασιλέως",702580,18],["Ιουδα",706768,18]],"Thus saith the Lord, Behold, I bring evil upon this place, [even] all the words that are written in the book that was read before the king of Juda:"],["25",[["ἀνθ᾿",701227,0],["ὧν",709781,252],["ἐγκατέλιπόν",703967,150],["με",708618,163],["καὶ",707031,7],["ἐθυμίασαν",706332,150],["θεοῖς",706192,148],["ἀλλοτρίοις",700699,230],["ἵνα",706747,7],["παροργίσωσίν",710167,234],["με",708618,163],["ἐν",704639,0],["πᾶσιν",710177,94],["τοῖς",709436,95],["ἔργοις",705396,96],["τῶν",709436,130],["χειρῶν",713787,65],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐξεκαύθη",704205,37],["ὁ",709436,3],["θυμός",706334,4],["μου",709032,133],["ἐν",704639,0],["τῷ",709436,113],["τόπῳ",712903,114],["τούτῳ",709858,50],["καὶ",707031,7],["οὐ",709805,28],["σβεσθήσεται",711596,134]],"because they have forsaken me, and burnt incense to strange gods, that they might provoke me by all the works of their hands; and my wrath is kindled against this place, and it shall not be quenched."],["26",[["καὶ",707031,7],["ἐπὶ",705080,0],["βασιλέα",702580,6],["Ιουδα",706768,18],["τὸν",709436,5],["ἀποστείλαντα",701592,365],["ὑμᾶς",713080,194],["τοῦ",709436,20],["ζητῆσαι",705879,106],["τὸν",709436,5],["κύριον",707996,6],["οὕτως",709859,28],["ἐρεῖτε",705415,337],["αὐτῷ",702165,50],["οὕτως",709859,28],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["τοὺς",709436,58],["λόγους",708236,57],["οὓς",709781,298],["ἤκουσας",700587,162]],"And concerning the king of Juda, who sent you to seek the Lord,—thus shall ye say to him, Thus saith the Lord God of Israel, [As for] the words which thou hast heard,"],["27",[["καὶ",707031,7],["ἐνετράπη",704805,37],["ἡ",709436,10],["καρδία",707141,12],["σου",711945,133],["καὶ",707031,7],["ἐταπεινώθης",712717,168],["ἀπὸ",701425,0],["προσώπου",710986,21],["μου",709032,133],["ἐν",704639,0],["τῷ",709436,53],["ἀκοῦσαί",700587,106],["σε",711598,163],["τοὺς",709436,58],["λόγους",708236,57],["μου",709032,133],["ἐπὶ",705080,0],["τὸν",709436,5],["τόπον",712903,6],["τοῦτον",709858,85],["καὶ",707031,7],["ἐπὶ",705080,0],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐταπεινώθης",712717,168],["ἐναντίον",704654,0],["μου",709032,133],["καὶ",707031,7],["διέρρηξας",703565,162],["τὰ",709436,41],["ἱμάτιά",706742,42],["σου",711945,133],["καὶ",707031,7],["ἔκλαυσας",707703,162],["κατεναντίον",707508,28],["μου",709032,133],["καὶ",707031,7],["ἐγὼ",704018,164],["ἤκουσά",700587,155],["φησιν",713437,91],["κύριος",707996,4]],"forasmuch as thy heart was ashamed, and thou wast humbled before me when thou heardest my words against this place, and against the inhabitants of it, and thou wast humbled before me, and didst rend thy garments, and didst weep before me; I also have heard, saith the Lord."],["28",[["ἰδοὺ",706497,88],["προστίθημί",710965,157],["σε",711598,163],["πρὸς",710844,0],["τοὺς",709436,58],["πατέρας",710189,57],["σου",711945,133],["καὶ",707031,7],["προστεθήσῃ",710965,364],["πρὸς",710844,0],["τὰ",709436,41],["μνήματά",708962,42],["σου",711945,133],["ἐν",704639,0],["εἰρήνῃ",704098,1],["καὶ",707031,7],["οὐκ",709805,28],["ὄψονται",709725,135],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["σου",711945,133],["ἐν",704639,0],["πᾶσιν",710177,230],["τοῖς",709436,147],["κακοῖς",707066,230],["οἷς",709781,311],["ἐγὼ",704018,164],["ἐπάγω",704994,157],["ἐπὶ",705080,0],["τὸν",709436,5],["τόπον",712903,6],["τοῦτον",709858,85],["καὶ",707031,7],["ἐπὶ",705080,0],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["αὐτόν",702165,85],["καὶ",707031,7],["ἀπέδωκαν",701449,150],["τῷ",709436,113],["βασιλεῖ",702580,114],["λόγον",708236,6]],"Behold, I [will] gather thee to thy fathers, and thou shalt be gathered to thy grave in peace, and thine eyes shall not look upon all the evils which I am bringing upon this place, and upon the inhabitants of it. And they brought back word to the king."],["29",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["συνήγαγεν",712375,2],["τοὺς",709436,58],["πρεσβυτέρους",710735,57],["Ιουδα",706768,18],["καὶ",707031,7],["Ιερουσαλημ",706644,18]],"And the king sent and gathered the elders of Juda and Jerusalem."],["30",[["καὶ",707031,7],["ἀνέβη",700905,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["εἰς",704105,0],["οἶκον",709516,6],["κυρίου",707996,18],["καὶ",707031,7],["πᾶς",710177,14],["Ιουδα",706768,4],["καὶ",707031,7],["οἱ",709436,136],["κατοικοῦντες",707534,146],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["οἱ",709436,136],["ἱερεῖς",706614,52],["καὶ",707031,7],["οἱ",709436,136],["Λευῖται",708160,52],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["ἀπὸ",701425,0],["μεγάλου",708653,116],["ἕως",705792,0],["μικροῦ",708915,116],["καὶ",707031,7],["ἀνέγνω",700922,2],["ἐν",704639,0],["ὠσὶν",709852,96],["αὐτῶν",702165,40],["τοὺς",709436,58],["πάντας",710177,60],["λόγους",708236,57],["βιβλίου",702719,21],["τῆς",709436,16],["διαθήκης",703456,17],["τοῦ",709436,35],["εὑρεθέντος",705676,319],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18]],"And the king went up to the house of the Lord, [he] and all Juda, and the inhabitants of Jerusalem, and the priests, and the Levites, and all the people great and small: and he read in their ears all the words of the book of the covenant that were found in the house of the Lord."],["31",[["καὶ",707031,7],["ἔστη",706846,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐπὶ",705080,0],["τὸν",709436,5],["στῦλον",712179,6],["καὶ",707031,7],["διέθετο",703609,23],["διαθήκην",703456,9],["ἐναντίον",704654,0],["κυρίου",707996,18],["τοῦ",709436,20],["πορευθῆναι",710667,179],["ἐνώπιον",704823,0],["κυρίου",707996,18],["τοῦ",709436,20],["φυλάσσειν",713619,55],["τὰς",709436,38],["ἐντολὰς",704802,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["μαρτύρια",708525,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["προστάγματα",710959,42],["αὐτοῦ",702165,102],["ἐν",704639,0],["ὅλῃ",709597,101],["καρδίᾳ",707141,1],["καὶ",707031,7],["ἐν",704639,0],["ὅλῃ",709597,101],["ψυχῇ",714070,1],["τοὺς",709436,58],["λόγους",708236,57],["τῆς",709436,16],["διαθήκης",703456,17],["τοὺς",709436,58],["γεγραμμένους",703194,360],["ἐπὶ",705080,0],["τῷ",709436,53],["βιβλίῳ",702719,54],["τούτῳ",709858,280]],"And the king stood at a pillar, and made a covenant before the Lord, to walk before the Lord, to keep his commandments and testimonies, and his ordinances, with all [his] heart and with all [his] soul, so as to perform the words of the covenant that were written in this book."],["32",[["καὶ",707031,7],["ἔστησεν",706846,2],["πάντας",710177,60],["τοὺς",709436,58],["εὑρεθέντας",705676,460],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["Βενιαμιν",702650,114],["καὶ",707031,7],["ἐποίησαν",710582,150],["οἱ",709436,136],["κατοικοῦντες",707534,146],["Ιερουσαλημ",706644,1],["διαθήκην",703456,9],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18],["θεοῦ",706192,18],["πατέρων",710189,81],["αὐτῶν",702165,40]],"And he caused all that were found in Jerusalem and Benjamin to stand; and the inhabitants of Jerusalem made a covenant in the house of the Lord God of their fathers."],["33",[["καὶ",707031,7],["περιεῖλεν",710288,2],["Ιωσιας",706950,4],["τὰ",709436,41],["πάντα",710177,68],["βδελύγματα",702604,42],["ἐκ",704132,0],["πάσης",710177,82],["τῆς",709436,16],["γῆς",703083,17],["ἣ",709781,177],["ἦν",704093,13],["υἱῶν",713075,81],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐποίησεν",710582,2],["πάντας",710177,60],["τοὺς",709436,58],["εὑρεθέντας",705676,460],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["ἐν",704639,0],["Ισραηλ",706839,114],["τοῦ",709436,20],["δουλεύειν",703814,55],["κυρίῳ",707996,114],["θεῷ",706192,114],["αὐτῶν",702165,40],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐξέκλινεν",704220,13],["ἀπὸ",701425,0],["ὄπισθεν",709691,28],["κυρίου",707996,18],["θεοῦ",706192,18],["πατέρων",710189,81],["αὐτοῦ",702165,102]],"And Josias removed all the abominations out of the whole land which belonged to the children of Israel, and caused all that were found in Jerusalem and in Israel, to serve the Lord their God all his days: he departed not from following the Lord God of his fathers."]]