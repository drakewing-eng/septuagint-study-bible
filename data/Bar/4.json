[["1",[["αὕτη",709858,107],["ἡ",709436,10],["βίβλος",702721,12],["τῶν",709436,43],["προσταγμάτων",710959,44],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["ὁ",709436,3],["νόμος",709349,4],["ὁ",709436,3],["ὑπάρχων",713104,72],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["πάντες",710177,138],["οἱ",709436,136],["κρατοῦντες",707879,146],["αὐτῆς",702165,86],["εἰς",704105,0],["ζωήν",705910,9],["οἱ",709436,136],["δὲ",703303,11],["καταλείποντες",707305,146],["αὐτὴν",702165,104],["ἀποθανοῦνται",701461,135]],"This is the book of the commandments of God, and the law that endureth for ever: all they that keep it [shall come] to life; but such as leave it shall die."],["2",[["ἐπιστρέφου",705278,253],["Ιακωβ",706401,153],["καὶ",707031,7],["ἐπιλαβοῦ",705185,300],["αὐτῆς",702165,86],["διόδευσον",703715,176],["πρὸς",710844,0],["τὴν",709436,8],["λάμψιν",708086,9],["κατέναντι",707507,28],["τοῦ",709436,20],["φωτὸς",713642,21],["αὐτῆς",702165,86]],"Turn thee, O Jacob, and take hold of it: walk in the presence of the light thereof, that thou mayest be illuminated."],["3",[["μὴ",708851,28],["δῷς",703654,175],["ἑτέρῳ",705535,30],["τὴν",709436,8],["δόξαν",703791,9],["σου",711945,133],["καὶ",707031,7],["τὰ",709436,41],["συμφέροντά",712353,47],["σοι",711925,159],["ἔθνει",704068,54],["ἀλλοτρίῳ",700699,97]],"Give not thine honour to another, nor the things that are profitable unto thee to a strange nation."],["4",[["μακάριοί",708397,138],["ἐσμεν",704093,243],["Ισραηλ",706839,153],["ὅτι",709803,7],["τὰ",709436,63],["ἀρεστὰ",701723,195],["τῷ",709436,113],["θεῷ",706192,114],["ἡμῖν",705994,90],["γνωστά",703141,195],["ἐστιν",704093,91]],"O Israel, happy are we: for things that are pleasing to God are made known unto us."],["5",[["θαρσεῖτε",706122,335],["λαός",708094,4],["μου",709032,133],["μνημόσυνον",708966,15],["Ισραηλ",706839,18]],"Be of good cheer, my people, the memorial of Israel."],["6",[["ἐπράθητε",710480,472],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["οὐκ",709805,28],["εἰς",704105,0],["ἀπώλειαν",701660,9],["διὰ",703417,0],["δὲ",703303,11],["τὸ",709436,24],["παροργίσαι",710167,106],["ὑμᾶς",713080,194],["τὸν",709436,5],["θεὸν",706192,6],["παρεδόθητε",710014,472],["τοῖς",709436,147],["ὑπεναντίοις",713109,230]],"Ye were sold to the nations, not for [your] destruction: but because ye moved God to wrath, ye were delivered unto the enemies."],["7",[["παρωξύνατε",710164,265],["γὰρ",702963,11],["τὸν",709436,5],["ποιήσαντα",710582,365],["ὑμᾶς",713080,194],["θύσαντες",706349,196],["δαιμονίοις",703249,96],["καὶ",707031,7],["οὐ",709805,28],["θεῷ",706192,114]],"For ye provoked him that made you by sacrificing unto devils and not to God."],["8",[["ἐπελάθεσθε",705187,345],["δὲ",703303,11],["τὸν",709436,5],["τροφεύσαντα",712983,365],["ὑμᾶς",713080,194],["θεὸν",706192,6],["αἰώνιον",700505,27],["ἐλυπήσατε",708272,265],["δὲ",703303,11],["καὶ",707031,7],["τὴν",709436,8],["ἐκθρέψασαν",704342,610],["ὑμᾶς",713080,194],["Ιερουσαλημ",706644,9]],"Ye have forgotten the everlasting God, that brought you up; and ye have grieved Jerusalem, that nursed you."],["9",[["εἶδεν",709725,2],["γὰρ",702963,11],["τὴν",709436,8],["ἐπελθοῦσαν",705068,610],["ὑμῖν",713084,90],["ὀργὴν",709728,9],["παρὰ",709995,0],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["εἶπεν",705373,2],["ἀκούσατε",700587,74],["αἱ",709436,190],["πάροικοι",710159,192],["Σιων",711816,17],["ἐπήγαγέν",704994,2],["μοι",708974,159],["ὁ",709436,3],["θεὸς",706192,4],["πένθος",710253,25],["μέγα",708653,46]],"For when she saw the wrath of God coming upon you, she said, Hearken, O ye that dwell about Sion: God hath brought upon me great mourning;"],["10",[["εἶδον",709725,150],["γὰρ",702963,11],["τὴν",709436,8],["αἰχμαλωσίαν",700499,9],["τῶν",709436,80],["υἱῶν",713075,81],["μου",709032,133],["καὶ",707031,7],["τῶν",709436,130],["θυγατέρων",706320,65],["ἣν",709781,131],["ἐπήγαγεν",704994,2],["αὐτοῖς",702165,151],["ὁ",709436,3],["αἰώνιος",700505,14]],"for I saw the captivity of my sons and daughters, which the Everlasting brought upon them."],["11",[["ἔθρεψα",712930,155],["γὰρ",702963,11],["αὐτοὺς",702165,62],["μετ᾿",708780,0],["εὐφροσύνης",705717,17],["ἐξαπέστειλα",704872,155],["δὲ",703303,11],["μετὰ",708780,0],["κλαυθμοῦ",707705,18],["καὶ",707031,7],["πένθους",710253,21]],"With joy did I nourish them; but sent them away with weeping and mourning."],["12",[["μηδεὶς",708857,14],["ἐπιχαιρέτω",705330,31],["μοι",708974,159],["τῇ",709436,100],["χήρᾳ",713848,1],["καὶ",707031,7],["καταλειφθείσῃ",707305,696],["ὑπὸ",713184,0],["πολλῶν",710646,169],["ἠρημώθην",705421,156],["διὰ",703417,0],["τὰς",709436,38],["ἁμαρτίας",700775,39],["τῶν",709436,43],["τέκνων",712761,44],["μου",709032,133],["διότι",703734,7],["ἐξέκλιναν",704220,150],["ἐκ",704132,0],["νόμου",709349,18],["θεοῦ",706192,18]],"Let no man rejoice over me, a widow, and forsaken of many, who for the sins of my children am left desolate; because they departed from the law of God."],["13",[["δικαιώματα",703697,42],["δὲ",703303,11],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἔγνωσαν",703105,150],["οὐδὲ",709816,7],["ἐπορεύθησαν",710667,99],["ὁδοῖς",709458,76],["ἐντολῶν",704802,65],["θεοῦ",706192,18],["οὐδὲ",709816,7],["τρίβους",712939,39],["παιδείας",709924,17],["ἐν",704639,0],["δικαιοσύνῃ",703695,1],["αὐτοῦ",702165,102],["ἐπέβησαν",705082,150]],"They knew not his statutes, nor walked in the ways of his commandments, nor trod in the paths of discipline in his righteousness."],["14",[["ἐλθάτωσαν",705453,264],["αἱ",709436,190],["πάροικοι",710159,192],["Σιων",711816,17],["καὶ",707031,7],["μνήσθητε",708960,394],["τὴν",709436,8],["αἰχμαλωσίαν",700499,9],["τῶν",709436,80],["υἱῶν",713075,81],["μου",709032,133],["καὶ",707031,7],["θυγατέρων",706320,65],["ἣν",709781,131],["ἐπήγαγεν",704994,2],["αὐτοῖς",702165,151],["ὁ",709436,3],["αἰώνιος",700505,14]],"Let them that dwell about Sion come, and remember ye the captivity of my sons and daughters, which the Everlasting hath brought upon them."],["15",[["ἐπήγαγεν",704994,2],["γὰρ",702963,11],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["ἔθνος",704068,25],["μακρόθεν",708417,28],["ἔθνος",704068,25],["ἀναιδὲς",700959,46],["καὶ",707031,7],["ἀλλόγλωσσον",700691,46],["οἳ",709781,250],["οὐκ",709805,28],["ᾐσχύνθησαν",700485,99],["πρεσβύτην",710736,6],["οὐδὲ",709816,7],["παιδίον",709927,25],["ἠλέησαν",704418,150]],"For he hath brought a nation upon them from far, a shameless nation, and of a strange language, who neither reverenced old man, nor pitied child,"],["16",[["καὶ",707031,7],["ἀπήγαγον",701324,150],["τοὺς",709436,58],["ἀγαπητοὺς",700124,60],["τῆς",709436,16],["χήρας",713848,17],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,130],["θυγατέρων",706320,65],["τὴν",709436,8],["μόνην",709003,36],["ἠρήμωσαν",705421,150]],"and they have carried away the dear beloved children of the widow, and left her that was alone desolate without daughters."],["17",[["ἐγὼ",704018,164],["δὲ",703303,11],["τί",712867,126],["δυνατὴ",703845,29],["βοηθῆσαι",702746,106],["ὑμῖν",713084,90]],"But what can I help you?",{"s":"d","q":0.35}],["18",[["ὁ",709436,3],["γὰρ",702963,11],["ἐπαγαγὼν",704994,182],["τὰ",709436,41],["κακὰ",707066,68],["ὑμῖν",713084,90],["ἐξελεῖται",704838,93],["ὑμᾶς",713080,194],["ἐκ",704132,0],["χειρὸς",713787,17],["ἐχθρῶν",705779,81],["ὑμῶν",713091,145]],null,{"s":"h"}],["19",[["βαδίζετε",702367,87],["τέκνα",712761,589],["βαδίζετε",702367,87],["ἐγὼ",704018,164],["γὰρ",702963,11],["κατελείφθην",707305,156],["ἔρημος",705420,12]],"For he that brought these plagues upon you will deliver you from the hands of your enemies.",{"s":"m","br":"4:18","q":1.0}],["20",[["ἐξεδυσάμην",704180,161],["τὴν",709436,8],["στολὴν",712120,9],["τῆς",709436,16],["εἰρήνης",704098,17],["ἐνεδυσάμην",704701,161],["δὲ",703303,11],["σάκκον",711386,6],["τῆς",709436,16],["δεήσεώς",703311,17],["μου",709032,133],["κεκράξομαι",707868,181],["πρὸς",710844,0],["τὸν",709436,5],["αἰώνιον",700505,27],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["μου",709032,133]],"I have put off the clothing of peace, and put upon me the sackcloth of my prayer: I will cry unto the Everlasting in my days."],["21",[["θαρσεῖτε",706122,87],["τέκνα",712761,589],["βοήσατε",702743,74],["πρὸς",710844,0],["τὸν",709436,5],["θεόν",706192,6],["καὶ",707031,7],["ἐξελεῖται",704838,93],["ὑμᾶς",713080,194],["ἐκ",704132,0],["δυναστείας",703841,17],["ἐκ",704132,0],["χειρὸς",713787,17],["ἐχθρῶν",705779,81]],"Be of good cheer, O my children, cry unto the Lord, and he shall deliver you from the power and hand of the enemies."],["22",[["ἐγὼ",704018,164],["γὰρ",702963,11],["ἤλπισα",704529,155],["ἐπὶ",705080,0],["τῷ",709436,113],["αἰωνίῳ",700505,30],["τὴν",709436,8],["σωτηρίαν",712658,9],["ὑμῶν",713091,145],["καὶ",707031,7],["ἦλθέν",705453,2],["μοι",708974,159],["χαρὰ",713719,12],["παρὰ",709995,0],["τοῦ",709436,35],["ἁγίου",700159,116],["ἐπὶ",705080,0],["τῇ",709436,100],["ἐλεημοσύνῃ",704421,1],["ἣ",709781,177],["ἥξει",705956,127],["ὑμῖν",713084,90],["ἐν",704639,0],["τάχει",712750,30],["παρὰ",709995,0],["τοῦ",709436,35],["αἰωνίου",700505,116],["σωτῆρος",712657,18],["ὑμῶν",713091,145]],"For my hope is in the Everlasting, that he will save you: and joy is come unto me from the Holy One, because of the mercy which shall soon come unto you from the Everlasting your Saviour."],["23",[["ἐξέπεμψα",704274,155],["γὰρ",702963,11],["ὑμᾶς",713080,194],["μετὰ",708780,0],["πένθους",710253,21],["καὶ",707031,7],["κλαυθμοῦ",707705,18],["ἀποδώσει",701449,127],["δέ",703303,11],["μοι",708974,159],["ὁ",709436,3],["θεὸς",706192,4],["ὑμᾶς",713080,194],["μετὰ",708780,0],["χαρμοσύνης",713747,82],["καὶ",707031,7],["εὐφροσύνης",705717,17],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"For I sent you out with mourning and weeping: but God will give you to me again with joy and gladness for ever."],["24",[["ὥσπερ",714163,28],["γὰρ",702963,11],["νῦν",709384,28],["ἑωράκασιν",709725,353],["αἱ",709436,190],["πάροικοι",710159,138],["Σιων",711816,17],["τὴν",709436,8],["ὑμετέραν",713083,36],["αἰχμαλωσίαν",700499,9],["οὕτως",709859,28],["ὄψονται",709725,135],["ἐν",704639,0],["τάχει",712750,30],["τὴν",709436,8],["παρὰ",709995,0],["τοῦ",709436,35],["θεοῦ",706192,18],["ὑμῶν",713091,145],["σωτηρίαν",712658,9],["ἣ",709781,177],["ἐπελεύσεται",705068,93],["ὑμῖν",713084,90],["μετὰ",708780,0],["δόξης",703791,17],["μεγάλης",708653,82],["καὶ",707031,7],["λαμπρότητος",708083,17],["τοῦ",709436,35],["αἰωνίου",700505,116]],"Like as now the neighbours of Sion have seen your captivity: so shall they see shortly your salvation from your God, which shall come upon you with great glory, and brightness of the Everlasting."],["25",[["τέκνα",712761,589],["μακροθυμήσατε",708418,74],["τὴν",709436,8],["παρὰ",709995,0],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐπελθοῦσαν",705068,610],["ὑμῖν",713084,90],["ὀργήν",709728,9],["κατεδίωξέν",707243,2],["σε",711598,163],["ὁ",709436,3],["ἐχθρός",705779,4],["σου",711945,133],["καὶ",707031,7],["ὄψει",709901,1],["αὐτοῦ",702165,102],["τὴν",709436,8],["ἀπώλειαν",701660,9],["ἐν",704639,0],["τάχει",712750,30],["καὶ",707031,7],["ἐπὶ",705080,0],["τραχήλους",712924,57],["αὐτῶν",702165,40],["ἐπιβήσῃ",705082,123]],"My children, suffer patiently the wrath that is come upon you from God: for thine enemy hath persecuted thee; but shortly thou shalt see his destruction, and shalt tread upon his neck."],["26",[["οἱ",709436,136],["τρυφεροί",713006,138],["μου",709032,133],["ἐπορεύθησαν",710667,99],["ὁδοὺς",709458,39],["τραχείας",712925,119],["ἤρθησαν",700473,99],["ὡς",714148,7],["ποίμνιον",710598,25],["ἡρπασμένον",701804,448],["ὑπὸ",713184,0],["ἐχθρῶν",705779,81]],"My delicate ones have gone rough ways, and were taken away as a flock caught of the enemies."],["27",[["θαρσήσατε",706122,74],["τέκνα",712761,589],["καὶ",707031,7],["βοήσατε",702743,74],["πρὸς",710844,0],["τὸν",709436,5],["θεόν",706192,6],["ἔσται",704093,93],["γὰρ",702963,11],["ὑμῶν",713091,145],["ὑπὸ",713184,0],["τοῦ",709436,35],["ἐπάγοντος",704994,152],["μνεία",708961,12]],"Be of good comfort, O my children, and cry unto God: for ye shall be remembered of him that brought these things upon you."],["28",[["ὥσπερ",714163,28],["γὰρ",702963,11],["ἐγένετο",703104,23],["ἡ",709436,10],["διάνοια",703531,12],["ὑμῶν",713091,145],["εἰς",704105,0],["τὸ",709436,24],["πλανηθῆναι",710495,179],["ἀπὸ",701425,0],["τοῦ",709436,35],["θεοῦ",706192,18],["δεκαπλασιάσατε",703339,74],["ἐπιστραφέντες",705278,247],["ζητῆσαι",705879,106],["αὐτόν",702165,85]],"For as it was your mind to go astray from God: so, being returned, seek him ten times more."],["29",[["ὁ",709436,3],["γὰρ",702963,11],["ἐπαγαγὼν",704994,182],["ὑμῖν",713084,90],["τὰ",709436,41],["κακὰ",707066,68],["ἐπάξει",704994,127],["ὑμῖν",713084,90],["τὴν",709436,8],["αἰώνιον",700505,36],["εὐφροσύνην",705717,9],["μετὰ",708780,0],["τῆς",709436,16],["σωτηρίας",712658,17],["ὑμῶν",713091,145]],"For he that hath brought these plagues upon you shall bring you everlasting joy again with your salvation."],["30",[["θάρσει",706122,240],["Ιερουσαλημ",706644,258],["παρακαλέσει",710039,127],["σε",711598,163],["ὁ",709436,3],["ὀνομάσας",709667,182],["σε",711598,163]],"Take a good heart, O Jerusalem: for he that gave thee that name will comfort thee."],["31",[["δείλαιοι",703316,138],["οἱ",709436,136],["σὲ",711598,163],["κακώσαντες",707073,196],["καὶ",707031,7],["ἐπιχαρέντες",705330,247],["τῇ",709436,100],["σῇ",711943,101],["πτώσει",711072,1]],"Miserable are they that afflicted thee, and rejoiced at thy fall."],["32",[["δείλαιαι",703316,192],["αἱ",709436,190],["πόλεις",710612,191],["αἷς",709781,281],["ἐδούλευσαν",703814,150],["τὰ",709436,63],["τέκνα",712761,64],["σου",711945,133],["δειλαία",703316,29],["ἡ",709436,10],["δεξαμένη",703393,357],["τοὺς",709436,58],["υἱούς",713075,57],["σου",711945,133]],"Miserable are the cities which thy children served: miserable is she that received thy sons."],["33",[["ὥσπερ",714163,28],["γὰρ",702963,11],["ἐχάρη",713665,37],["ἐπὶ",705080,0],["τῇ",709436,100],["σῇ",711943,101],["πτώσει",711072,1],["καὶ",707031,7],["εὐφράνθη",705715,37],["ἐπὶ",705080,0],["τῷ",709436,53],["πτώματί",711071,54],["σου",711945,133],["οὕτως",709859,28],["λυπηθήσεται",708272,134],["ἐπὶ",705080,0],["τῇ",709436,100],["ἑαυτῆς",703917,86],["ἐρημίᾳ",705417,1]],"For as she rejoiced at thy ruin, and was glad of thy fall: so shall she be grieved for her own desolation."],["34",[["καὶ",707031,7],["περιελῶ",710288,165],["αὐτῆς",702165,86],["τὸ",709436,24],["ἀγαλλίαμα",700112,25],["τῆς",709436,16],["πολυοχλίας",710634,17],["καὶ",707031,7],["τὸ",709436,34],["ἀγαυρίαμα",700131,15],["αὐτῆς",702165,86],["ἔσται",704093,93],["εἰς",704105,0],["πένθος",710253,25]],"For I will take away the rejoicing of her great multitude, and her pride shall be turned into mourning."],["35",[["πῦρ",711088,15],["γὰρ",702963,11],["ἐπελεύσεται",705068,93],["αὐτῇ",702165,105],["παρὰ",709995,0],["τοῦ",709436,35],["αἰωνίου",700505,116],["εἰς",704105,0],["ἡμέρας",705984,39],["μακράς",708421,119],["καὶ",707031,7],["κατοικηθήσεται",707534,134],["ὑπὸ",713184,0],["δαιμονίων",703249,44],["τὸν",709436,5],["πλείονα",710514,27],["χρόνον",713969,6]],"For fire shall come upon her from the Everlasting, long to endure; and she shall be inhabited of devils for a great time."],["36",[["περίβλεψαι",710297,300],["πρὸς",710844,0],["ἀνατολάς",701071,39],["Ιερουσαλημ",706644,258],["καὶ",707031,7],["ἰδὲ",709725,176],["τὴν",709436,8],["εὐφροσύνην",705717,9],["τὴν",709436,8],["παρὰ",709995,0],["τοῦ",709436,35],["θεοῦ",706192,18],["σοι",711925,159],["ἐρχομένην",705453,173]],"O Jerusalem, look about thee toward the east, and behold the joy that cometh unto thee from God."],["37",[["ἰδοὺ",706497,88],["ἔρχονται",705453,269],["οἱ",709436,136],["υἱοί",713075,52],["σου",711945,133],["οὓς",709781,298],["ἐξαπέστειλας",704872,162],["ἔρχονται",705453,269],["συνηγμένοι",712375,429],["ἀπ᾿",701425,0],["ἀνατολῶν",701071,65],["ἕως",705792,0],["δυσμῶν",703865,65],["τῷ",709436,53],["ῥήματι",711246,54],["τοῦ",709436,35],["ἁγίου",700159,116],["χαίροντες",713665,146],["τῇ",709436,100],["τοῦ",709436,35],["θεοῦ",706192,18],["δόξῃ",703791,1]],"Lo, thy sons come, whom thou sentest away, they come gathered together from the east to the west by the word of the Holy One, rejoicing in the glory of God."]]