[["1",[["κύριε",707996,153],["παντοκράτωρ",709986,153],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ψυχὴ",714070,12],["ἐν",704639,0],["στενοῖς",712068,230],["καὶ",707031,7],["πνεῦμα",710566,25],["ἀκηδιῶν",700537,65],["κέκραγεν",707868,171],["πρὸς",710844,0],["σέ",711598,163]],"O Lord Almighty, God of Israel, the soul in anguish, the troubled spirit, crieth unto thee."],["2",[["ἄκουσον",700587,176],["κύριε",707996,153],["καὶ",707031,7],["ἐλέησον",704418,176],["ὅτι",709803,7],["ἡμάρτομεν",700773,289],["ἐναντίον",704654,0],["σου",711945,133]],"Hear, O Lord, and have mercy; for thou art merciful: and have pity upon us, because we have sinned before thee."],["3",[["ὅτι",709803,7],["σὺ",712181,164],["καθήμενος",707000,122],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["ἡμεῖς",705983,219],["ἀπολλύμενοι",701513,348],["τὸν",709436,5],["αἰῶνα",700504,6]],"For thou endurest for ever, and we perish utterly."],["4",[["κύριε",707996,153],["παντοκράτωρ",709986,153],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ἄκουσον",700587,176],["δὴ",703395,11],["τῆς",709436,16],["προσευχῆς",710892,17],["τῶν",709436,80],["τεθνηκότων",706278,387],["Ισραηλ",706839,18],["καὶ",707031,7],["υἱῶν",713075,81],["τῶν",709436,80],["ἁμαρτανόντων",700773,170],["ἐναντίον",704654,0],["σου",711945,133],["οἳ",709781,250],["οὐκ",709805,28],["ἤκουσαν",700587,150],["τῆς",709436,16],["φωνῆς",713640,17],["κυρίου",707996,18],["θεοῦ",706192,18],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐκολλήθη",707791,37],["ἡμῖν",705994,90],["τὰ",709436,63],["κακά",707066,195]],"O Lord Almighty, thou God of Israel, hear now the prayers of the dead Israelites, and of their children, which have sinned before thee, and not hearkened unto the voice of thee their God: for the which cause these plagues cleave unto us."],["5",[["μὴ",708851,28],["μνησθῇς",708960,279],["ἀδικιῶν",700271,65],["πατέρων",710189,81],["ἡμῶν",705999,145],["ἀλλὰ",700680,7],["μνήσθητι",708960,244],["χειρός",713787,17],["σου",711945,133],["καὶ",707031,7],["ὀνόματός",709666,21],["σου",711945,133],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["τούτῳ",709858,50]],"Remember not the iniquities of our forefathers: but think upon thy power and thy name now at this time."],["6",[["ὅτι",709803,7],["σὺ",712181,164],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["καὶ",707031,7],["αἰνέσομέν",700459,275],["σε",711598,163],["κύριε",707996,153]],"For thou art the Lord our God, and thee, O Lord, will we praise."],["7",[["ὅτι",709803,7],["διὰ",703417,0],["τοῦτο",709858,129],["ἔδωκας",703654,162],["τὸν",709436,5],["φόβον",713534,6],["σου",711945,133],["ἐπὶ",705080,0],["καρδίαν",707141,9],["ἡμῶν",705999,145],["τοῦ",709436,20],["ἐπικαλεῖσθαι",705153,110],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["καὶ",707031,7],["αἰνέσομέν",700459,275],["σε",711598,163],["ἐν",704639,0],["τῇ",709436,100],["ἀποικίᾳ",701463,1],["ἡμῶν",705999,145],["ὅτι",709803,7],["ἀπεστρέψαμεν",701598,289],["ἀπὸ",701425,0],["καρδίας",707141,17],["ἡμῶν",705999,145],["πᾶσαν",710177,36],["ἀδικίαν",700271,9],["πατέρων",710189,81],["ἡμῶν",705999,145],["τῶν",709436,80],["ἡμαρτηκότων",700773,387],["ἐναντίον",704654,0],["σου",711945,133]],"And for this cause thou hast put thy fear in our hearts, to the intent that we should call upon thy name, and praise thee in our captivity: for we have called to mind all the iniquity of our forefathers, that sinned before thee."],["8",[["ἰδοὺ",706497,88],["ἡμεῖς",705983,219],["σήμερον",711751,28],["ἐν",704639,0],["τῇ",709436,100],["ἀποικίᾳ",701463,1],["ἡμῶν",705999,145],["οὗ",709781,48],["διέσπειρας",703584,162],["ἡμᾶς",705981,194],["ἐκεῖ",704181,28],["εἰς",704105,0],["ὀνειδισμὸν",709657,6],["καὶ",707031,7],["εἰς",704105,0],["ἀρὰν",701665,9],["καὶ",707031,7],["εἰς",704105,0],["ὄφλησιν",709877,9],["κατὰ",707200,0],["πάσας",710177,119],["τὰς",709436,38],["ἀδικίας",700271,39],["πατέρων",710189,81],["ἡμῶν",705999,145],["οἳ",709781,250],["ἀπέστησαν",702214,150],["ἀπὸ",701425,0],["κυρίου",707996,18],["θεοῦ",706192,18],["ἡμῶν",705999,145]],"Behold, we are yet this day in our captivity, where thou hast scattered us, for a reproach and a curse, and to be subject to payments, according to all the iniquities of our fathers, which departed from the Lord our God."],["9",[["ἄκουε",700587,240],["Ισραηλ",706839,153],["ἐντολὰς",704802,39],["ζωῆς",705910,17],["ἐνωτίσασθε",704825,186],["γνῶναι",703105,106],["φρόνησιν",713588,9]],"Hear, Israel, the commandments of life: give ear to understand wisdom."],["10",[["τί",712867,126],["ἐστιν",704093,91],["Ισραηλ",706839,153],["τί",712867,126],["ὅτι",709803,7],["ἐν",704639,0],["γῇ",703083,1],["τῶν",709436,80],["ἐχθρῶν",705779,81],["εἶ",704093,154],["ἐπαλαιώθης",709937,168],["ἐν",704639,0],["γῇ",703083,1],["ἀλλοτρίᾳ",700699,101]],"How happeneth it, Israel, that thou art in thine enemies' land, that thou art waxen old in a strange country, that thou art defiled with the dead,"],["11",[["συνεμιάνθης",712305,168],["τοῖς",709436,147],["νεκροῖς",709247,148],["προσελογίσθης",710931,168],["μετὰ",708780,0],["τῶν",709436,80],["εἰς",704105,0],["ᾅδου",700255,18]],"that thou art counted with them that go down into the grave?"],["12",[["ἐγκατέλιπες",703967,162],["τὴν",709436,8],["πηγὴν",710450,9],["τῆς",709436,16],["σοφίας",711981,17]],"Thou hast forsaken the fountain of wisdom."],["13",[["τῇ",709436,100],["ὁδῷ",709458,1],["τοῦ",709436,35],["θεοῦ",706192,18],["εἰ",704071,7],["ἐπορεύθης",710667,168],["κατῴκεις",707534,363],["ἂν",700900,11],["ἐν",704639,0],["εἰρήνῃ",704098,1],["τὸν",709436,5],["αἰῶνα",700504,6]],"For if thou hadst walked in the way of God, thou shouldest have dwelled in peace for ever."],["14",[["μάθε",708480,176],["ποῦ",710706,28],["ἐστιν",704093,91],["φρόνησις",713588,12],["ποῦ",710706,28],["ἐστιν",704093,91],["ἰσχύς",706858,12],["ποῦ",710706,28],["ἐστιν",704093,91],["σύνεσις",712460,12],["τοῦ",709436,20],["γνῶναι",703105,106],["ἅμα",700745,28],["ποῦ",710706,28],["ἐστιν",704093,91],["μακροβίωσις",708413,12],["καὶ",707031,7],["ζωή",705910,12],["ποῦ",710706,28],["ἐστιν",704093,91],["φῶς",713642,15],["ὀφθαλμῶν",709870,81],["καὶ",707031,7],["εἰρήνη",704098,12]],"Learn where is wisdom, where is strength, where is understanding; that thou mayest know also where is length of days, and life, where is the light of the eyes, and peace."],["15",[["τίς",712867,158],["εὗρεν",705676,2],["τὸν",709436,5],["τόπον",712903,6],["αὐτῆς",702165,86],["καὶ",707031,7],["τίς",712867,158],["εἰσῆλθεν",704114,2],["εἰς",704105,0],["τοὺς",709436,58],["θησαυροὺς",706258,57],["αὐτῆς",702165,86]],"Who hath found out her place? or who hath come into her treasures?"],["16",[["ποῦ",710706,28],["εἰσιν",704093,197],["οἱ",709436,136],["ἄρχοντες",701862,52],["τῶν",709436,43],["ἐθνῶν",704068,44],["καὶ",707031,7],["οἱ",709436,136],["κυριεύοντες",707995,146],["τῶν",709436,43],["θηρίων",706252,44],["τῶν",709436,43],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"Where are the princes of the heathen, and such as ruled the beasts upon the earth;"],["17",[["οἱ",709436,136],["ἐν",704639,0],["τοῖς",709436,95],["ὀρνέοις",709762,96],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["ἐμπαίζοντες",704583,146],["καὶ",707031,7],["τὸ",709436,24],["ἀργύριον",701707,25],["θησαυρίζοντες",706256,146],["καὶ",707031,7],["τὸ",709436,24],["χρυσίον",713972,25],["ᾧ",709781,309],["ἐπεποίθεισαν",710221,263],["ἄνθρωποι",701163,52],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["τέλος",712787,15],["τῆς",709436,16],["κτήσεως",707937,17],["αὐτῶν",702165,40]],"they that had their pastime with the fowls of the air, and they that hoarded up silver and gold, wherein men trust, and made no end of their getting?"],["18",[["οἱ",709436,136],["τὸ",709436,24],["ἀργύριον",701707,25],["τεκταίνοντες",712764,146],["καὶ",707031,7],["μεριμνῶντες",708746,146],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐξεύρεσις",704915,12],["τῶν",709436,43],["ἔργων",705396,44],["αὐτῶν",702165,40]],"For they that wrought in silver, and were so careful, and whose works are unsearchable,"],["19",[["ἠφανίσθησαν",702182,99],["καὶ",707031,7],["εἰς",704105,0],["ᾅδου",700255,18],["κατέβησαν",707202,150],["καὶ",707031,7],["ἄλλοι",700697,201],["ἀντανέστησαν",701214,150],["ἀντ᾿",701227,0],["αὐτῶν",702165,40]],"they are vanished and gone down to the grave, and others are come up in their stead."],["20",[["νεώτεροι",709256,267],["εἶδον",709725,150],["φῶς",713642,25],["καὶ",707031,7],["κατῴκησαν",707534,150],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ὁδὸν",709458,9],["δὲ",703303,11],["ἐπιστήμης",705267,17],["οὐκ",709805,28],["ἔγνωσαν",703105,150]],"Young men have seen light, and dwelt upon the earth; but the way of knowledge have they not known,"],["21",[["οὐδὲ",709816,7],["συνῆκαν",712481,150],["τρίβους",712939,39],["αὐτῆς",702165,86],["οὐδὲ",709816,7],["ἀντελάβοντο",701243,189],["αὐτῆς",702165,86],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["αὐτῶν",702165,40],["πόρρω",710680,28],["ἐγενήθησαν",703104,99]],"nor understood the paths thereof, nor laid hold of it: their children were far off from that way."],["22",[["οὐδὲ",709816,7],["ἠκούσθη",700587,37],["ἐν",704639,0],["Χανααν",713708,114],["οὐδὲ",709816,7],["ὤφθη",709725,37],["ἐν",704639,0],["Θαιμαν",706062,1]],"It hath not been heard of in Chanaan, neither hath it been seen in Theman."],["23",[["οὔτε",709857,7],["υἱοὶ",713075,52],["Αγαρ",700125,18],["οἱ",709436,136],["ἐκζητοῦντες",704187,146],["τὴν",709436,8],["σύνεσιν",712460,9],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["οἱ",709436,136],["ἔμποροι",704614,52],["τῆς",709436,16],["Μερραν",708754,17],["καὶ",707031,7],["Θαιμαν",706062,17],["οἱ",709436,136],["μυθολόγοι",709048,52],["καὶ",707031,7],["οἱ",709436,136],["ἐκζητηταὶ",704188,52],["τῆς",709436,16],["συνέσεως",712460,17],["ὁδὸν",709458,9],["τῆς",709436,16],["σοφίας",711981,17],["οὐκ",709805,28],["ἔγνωσαν",703105,150],["οὐδὲ",709816,7],["ἐμνήσθησαν",708960,99],["τὰς",709436,38],["τρίβους",712939,39],["αὐτῆς",702165,86]],"The Agarenes that seek wisdom upon earth, the merchants of Meran and of Theman, the authors of fables, and searchers out of understanding; none of these have known the way of wisdom, or remembered her paths."],["24",[["ὦ",714081,88],["Ισραηλ",706839,153],["ὡς",714148,28],["μέγας",708653,14],["ὁ",709436,3],["οἶκος",709516,4],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["ἐπιμήκης",705202,14],["ὁ",709436,3],["τόπος",712903,4],["τῆς",709436,16],["κτήσεως",707937,17],["αὐτοῦ",702165,102]],"O Israel, how great is the house of God! and how large is the place of his possession!"],["25",[["μέγας",708653,14],["καὶ",707031,7],["οὐκ",709805,28],["ἔχει",705785,91],["τελευτήν",712782,9],["ὑψηλὸς",713285,14],["καὶ",707031,7],["ἀμέτρητος",700816,14]],"Great, and hath none end; high, and unmeasurable."],["26",[["ἐκεῖ",704181,28],["ἐγεννήθησαν",703051,99],["οἱ",709436,136],["γίγαντες",703101,52],["οἱ",709436,136],["ὀνομαστοὶ",709669,52],["οἱ",709436,136],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["γενόμενοι",703104,317],["εὐμεγέθεις",705637,138],["ἐπιστάμενοι",705264,348],["πόλεμον",710605,6]],"There were the giants famous from the beginning, that were of so great stature, and so expert in war."],["27",[["οὐ",709805,28],["τούτους",709858,62],["ἐξελέξατο",704236,23],["ὁ",709436,3],["θεὸς",706192,4],["οὐδὲ",709816,7],["ὁδὸν",709458,9],["ἐπιστήμης",705267,17],["ἔδωκεν",703654,2],["αὐτοῖς",702165,151]],"Those did not the Lord choose, neither gave he the way of knowledge unto them:"],["28",[["καὶ",707031,7],["ἀπώλοντο",701513,189],["παρὰ",709995,0],["τὸ",709436,24],["μὴ",708851,28],["ἔχειν",705785,55],["φρόνησιν",713588,9],["ἀπώλοντο",701513,189],["διὰ",703417,0],["τὴν",709436,8],["ἀβουλίαν",700089,9],["αὐτῶν",702165,40]],"but they were destroyed, because they had no wisdom, and perished through their own foolishness."],["29",[["τίς",712867,158],["ἀνέβη",700905,2],["εἰς",704105,0],["τὸν",709436,5],["οὐρανὸν",709844,6],["καὶ",707031,7],["ἔλαβεν",708076,2],["αὐτὴν",702165,104],["καὶ",707031,7],["κατεβίβασεν",707208,2],["αὐτὴν",702165,104],["ἐκ",704132,0],["τῶν",709436,130],["νεφελῶν",709277,65]],"Who hath gone up into heaven, and taken her, and brought her down from the clouds?"],["30",[["τίς",712867,158],["διέβη",703419,2],["πέραν",710280,0],["τῆς",709436,16],["θαλάσσης",706069,17],["καὶ",707031,7],["εὗρεν",705676,2],["αὐτὴν",702165,104],["καὶ",707031,7],["οἴσει",713428,127],["αὐτὴν",702165,104],["χρυσίου",713972,21],["ἐκλεκτοῦ",704240,92]],"Who hath gone over the sea, and found her, and will bring her for pure gold?"],["31",[["οὐκ",709805,28],["ἔστιν",704093,91],["ὁ",709436,3],["γινώσκων",703105,72],["τὴν",709436,8],["ὁδὸν",709458,9],["αὐτῆς",702165,86],["οὐδὲ",709816,7],["ὁ",709436,3],["ἐνθυμούμενος",704739,122],["τὴν",709436,8],["τρίβον",712939,9],["αὐτῆς",702165,86]],"No man knoweth her way, nor thinketh of her path."],["32",[["ἀλλὰ",700680,7],["ὁ",709436,3],["εἰδὼς",709492,270],["τὰ",709436,41],["πάντα",710177,68],["γινώσκει",703105,91],["αὐτήν",702165,104],["ἐξεῦρεν",704916,2],["αὐτὴν",702165,104],["τῇ",709436,100],["συνέσει",712460,1],["αὐτοῦ",702165,102],["ὁ",709436,3],["κατασκευάσας",707419,182],["τὴν",709436,8],["γῆν",703083,9],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["χρόνον",713969,6],["ἐνέπλησεν",704592,2],["αὐτὴν",702165,104],["κτηνῶν",707934,44],["τετραπόδων",712823,83]],"But he that knoweth all things knoweth her, and hath found her out with his understanding: he that prepared the earth for evermore hath filled it with fourfooted beasts:"],["33",[["ὁ",709436,3],["ἀποστέλλων",701592,72],["τὸ",709436,24],["φῶς",713642,25],["καὶ",707031,7],["πορεύεται",710667,117],["ἐκάλεσεν",707084,2],["αὐτό",702165,129],["καὶ",707031,7],["ὑπήκουσεν",713096,2],["αὐτῷ",702165,50],["τρόμῳ",712975,114]],"he that sendeth forth light, and it goeth, calleth it [again], and it obeyeth him with fear."],["34",[["οἱ",709436,136],["δὲ",703303,11],["ἀστέρες",702017,52],["ἔλαμψαν",708085,150],["ἐν",704639,0],["ταῖς",709436,75],["φυλακαῖς",713613,76],["αὐτῶν",702165,40],["καὶ",707031,7],["εὐφράνθησαν",705715,99]],"The stars shined in their watches, and rejoiced: when he calleth them, they say, Here we be; and so with cheerfulness they shewed light unto him that made them."],["35",[["ἐκάλεσεν",707084,2],["αὐτοὺς",702165,62],["καὶ",707031,7],["εἶπον",705373,150],["πάρεσμεν",710126,243],["ἔλαμψαν",704383,150],["μετ᾿",708780,0],["εὐφροσύνης",705717,17],["τῷ",709436,113],["ποιήσαντι",710582,350],["αὐτούς",702165,62]],"This is our God, and there shall none other be accounted of in comparison of him."],["36",[["οὗτος",709858,121],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["οὐ",709805,28],["λογισθήσεται",708232,134],["ἕτερος",705535,14],["πρὸς",710844,0],["αὐτόν",702165,85]],"He hath found out all the way of knowledge, and hath given it unto Jacob his servant, and to Israel his beloved."],["37",[["ἐξεῦρεν",704916,2],["πᾶσαν",710177,36],["ὁδὸν",709458,9],["ἐπιστήμης",705267,17],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτὴν",702165,104],["Ιακωβ",706401,114],["τῷ",709436,113],["παιδὶ",709932,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["Ισραηλ",706839,114],["τῷ",709436,113],["ἠγαπημένῳ",700120,516],["ὑπ᾿",713184,0],["αὐτοῦ",702165,102]],"Afterward did he shew himself upon earth, and conversed with men."],["38",[["μετὰ",708780,0],["τοῦτο",709858,129],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ὤφθη",709725,37],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["ἀνθρώποις",701163,148],["συνανεστράφη",712390,37]],null]]