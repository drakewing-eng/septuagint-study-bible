6],["περὶ",710285,0],["ἡμῶν",705999,145],["πρὸς",710844,0],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["ἡμῶν",705999,145],["ὅτι",709803,7],["ἡμάρτομεν",700773,289],["τῷ",709436,113],["κυρίῳ",707996,114],["θεῷ",706192,114],["ἡμῶν",705999,145],["καὶ",707031,7],["οὐκ",709805,28],["ἀπέστρεψεν",701598,2],["ὁ",709436,3],["θυμὸς",706334,4],["κυρίου",707996,18],["καὶ",707031,7],["ἡ",709436,10],["ὀργὴ",709728,12],["αὐτοῦ",702165,102],["ἀφ᾿",701425,0],["ἡμῶν",705999,145],["ἕως",705792,0],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86]],"Pray for us also unto the Lord our God, for we have sinned against the Lord our God; and unto this day the fury of the Lord and his wrath is not turned from us."],["14",[["καὶ",707031,7],["ἀναγνώσεσθε",700922,785],["τὸ",709436,24],["βιβλίον",702719,25],["τοῦτο",709858,129],["ὃ",709781,128],["ἀπεστείλαμεν",701592,289],["πρὸς",710844,0],["ὑμᾶς",713080,194],["ἐξαγορεῦσαι",704831,106],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["ἑορτῆς",704990,17],["καὶ",707031,7],["ἐν",704639,0],["ἡμέραις",705984,76],["καιροῦ",707047,18]],"And ye shall read this book which we have sent unto you, to make confession in the house of the Lord, upon the feasts and solemn days."],["15",[["καὶ",707031,7],["ἐρεῖτε",705415,337],["τῷ",709436,113],["κυρίῳ",707996,114],["θεῷ",706192,114],["ἡμῶν",705999,145],["ἡ",709436,10],["δικαιοσύνη",703695,12],["ἡμῖν",705994,90],["δὲ",703303,11],["αἰσχύνη",700483,12],["τῶν",709436,43],["προσώπων",710986,44],["ὡς",714148,28],["ἡ",709436,10],["ἡμέρα",705984,12],["αὕτη",709858,107],["ἀνθρώπῳ",701163,114],["Ιουδα",706768,18],["καὶ",707031,7],["τοῖς",709436,147],["κατοικοῦσιν",707534,349],["Ιερουσαλημ",706644,9]],"And ye shall say, To the Lord our God [belongeth] righteousness, but unto us the confusion of faces, as [it is come to pass] this day, unto them of Juda, and to the inhabitants of Jerusalem,"],["16",[["καὶ",707031,7],["τοῖς",709436,147],["βασιλεῦσιν",702580,148],["ἡμῶν",705999,145],["καὶ",707031,7],["τοῖς",709436,147],["ἄρχουσιν",701860,197],["ἡμῶν",705999,145],["καὶ",707031,7],["τοῖς",709436,147],["ἱερεῦσιν",706614,148],["ἡμῶν",705999,145],["καὶ",707031,7],["τοῖς",709436,147],["προφήταις",711009,148],["ἡμῶν",705999,145],["καὶ",707031,7],["τοῖς",709436,147],["πατράσιν",710189,148],["ἡμῶν",705999,145]],"and to our kings, and to our princes, and to our priests, and to our prophets, and to our fathers:"],["17",[["ὧν",709781,252],["ἡμάρτομεν",700773,289],["ἔναντι",704653,0],["κυρίου",707996,18]],"for we have sinned before the Lord,"],["18",[["καὶ",707031,7],["ἠπειθήσαμεν",701370,289],["αὐτῷ",702165,50],["καὶ",707031,7],["οὐκ",709805,28],["ἠκούσαμεν",700587,289],["τῆς",709436,16],["φωνῆς",713640,17],["κυρίου",707996,18],["θεοῦ",706192,18],["ἡμῶν",705999,145],["πορεύεσθαι",710667,110],["τοῖς",709436,95],["προστάγμασιν",710959,96],["κυρίου",707996,18],["οἷς",709781,295],["ἔδωκεν",703654,2],["κατὰ",707200,0],["πρόσωπον",710986,25],["ἡμῶν",705999,145]],"and disobeyed him, and have not hearkened unto the voice of the Lord our God, to walk in the commandments that he gave us openly:"],["19",[["ἀπὸ",701425,0],["τῆς",709436,16],["ἡμέρας",705984,17],["ἧς",709781,167],["ἐξήγαγεν",704834,2],["κύριος",707996,4],["τοὺς",709436,58],["πατέρας",710189,57],["ἡμῶν",705999,145],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ἕως",705792,0],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86],["ἤμεθα",704093,502],["ἀπειθοῦντες",701370,146],["πρὸς",710844,0],["κύριον",707996,6],["θεὸν",706192,6],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐσχεδιάζομεν",711829,421],["πρὸς",710844,0],["τὸ",709436,24],["μὴ",708851,28],["ἀκούειν",700587,55],["τῆς",709436,16],["φωνῆς",713640,17],["αὐτοῦ",702165,102]],"since the day that the Lord brought our forefathers out of the land of Egypt, unto this present day, we have been disobedient unto the Lord our God, and we have been negligent in not hearing his voice."],["20",[["καὶ",707031,7],["ἐκολλήθη",707791,37],["εἰς",704105,0],["ἡμᾶς",705981,194],["τὰ",709436,63],["κακὰ",707066,195],["καὶ",707031,7],["ἡ",709436,10],["ἀρά",701665,12],["ἣν",709781,131],["συνέταξεν",712508,2],["κύριος",707996,4],["τῷ",709436,113],["Μωυσῇ",709112,114],["παιδὶ",709932,114],["αὐτοῦ",702165,102],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["ᾗ",709781,108],["ἐξήγαγεν",704834,2],["τοὺς",709436,58],["πατέρας",710189,57],["ἡμῶν",705999,145],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["δοῦναι",703654,106],["ἡμῖν",705994,90],["γῆν",703083,9],["ῥέουσαν",711241,78],["γάλα",702919,25],["καὶ",707031,7],["μέλι",708700,25],["ὡς",714148,28],["ἡ",709436,10],["ἡμέρα",705984,12],["αὕτη",709858,107]],"Wherefore the evils cleaved unto us, and the curse, which the Lord appointed by Moses his servant at the time that he brought our fathers out of the land of Egypt, to give us a land that floweth with milk and honey, like as [it is to see] this day."],["21",[["καὶ",707031,7],["οὐκ",709805,28],["ἠκούσαμεν",700587,289],["τῆς",709436,16],["φωνῆς",713640,17],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["κατὰ",707200,0],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["τῶν",709436,80],["προφητῶν",711009,81],["ὧν",709781,252],["ἀπέστειλεν",701592,2],["πρὸς",710844,0],["ἡμᾶς",705981,194]],"Nevertheless we have not hearkened unto the voice of the Lord our God, according unto all the words of the prophets, whom he sent unto us:"],["22",[["καὶ",707031,7],["ᾠχόμεθα",709539,502],["ἕκαστος",704133,14],["ἐν",704639,0],["διανοίᾳ",703531,1],["καρδίας",707141,17],["αὐτοῦ",702165,102],["τῆς",709436,16],["πονηρᾶς",710660,82],["ἐργάζεσθαι",705383,110],["θεοῖς",706192,148],["ἑτέροις",705535,230],["ποιῆσαι",710582,106],["τὰ",709436,41],["κακὰ",707066,68],["κατ᾿",707200,0],["ὀφθαλμοὺς",709870,57],["κυρίου",707996,18],["θεοῦ",706192,18],["ἡμῶν",705999,145]],"but every man followed the imagination of his own wicked heart, to serve strange gods, and to do evil in the sight of the Lord our God."]]