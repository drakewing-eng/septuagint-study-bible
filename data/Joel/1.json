[["1",[["λόγος",708236,4],["κυρίου",707996,18],["ὃς",709781,213],["ἐγενήθη",703104,37],["πρὸς",710844,0],["Ιωηλ",706916,6],["τὸν",709436,5],["τοῦ",709436,35],["Βαθουηλ",702377,18]],"The word of the Lord which came to Joel the son of Bathuel."],["2",[["ἀκούσατε",700587,74],["δὴ",703395,11],["ταῦτα",709858,71],["οἱ",709436,136],["πρεσβύτεροι",710735,138],["καὶ",707031,7],["ἐνωτίσασθε",704825,186],["πάντες",710177,138],["οἱ",709436,136],["κατοικοῦντες",707534,146],["τὴν",709436,8],["γῆν",703083,9],["εἰ",704071,7],["γέγονεν",703104,171],["τοιαῦτα",712878,195],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ὑμῶν",713091,145],["ἢ",705924,7],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["τῶν",709436,80],["πατέρων",710189,81],["ὑμῶν",713091,145]],"Hear these [words], ye elders, and hearken all ye that inhabit the land. Have such things happened in your days, or in the days of your fathers?"],["3",[["ὑπὲρ",713111,0],["αὐτῶν",702165,40],["τοῖς",709436,95],["τέκνοις",712761,96],["ὑμῶν",713091,145],["διηγήσασθε",703679,186],["καὶ",707031,7],["τὰ",709436,63],["τέκνα",712761,64],["ὑμῶν",713091,145],["τοῖς",709436,95],["τέκνοις",712761,96],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,63],["τέκνα",712761,64],["αὐτῶν",702165,40],["εἰς",704105,0],["γενεὰν",703037,9],["ἑτέραν",705535,36]],"Tell your children concerning them, and [let] your children [tell] their children, and their children another generation."],["4",[["τὰ",709436,41],["κατάλοιπα",707317,68],["τῆς",709436,16],["κάμπης",707117,17],["κατέφαγεν",707519,2],["ἡ",709436,10],["ἀκρίς",700599,12],["καὶ",707031,7],["τὰ",709436,41],["κατάλοιπα",707317,68],["τῆς",709436,16],["ἀκρίδος",700599,17],["κατέφαγεν",707519,2],["ὁ",709436,3],["βροῦχος",702818,4],["καὶ",707031,7],["τὰ",709436,41],["κατάλοιπα",707317,68],["τοῦ",709436,35],["βρούχου",702818,18],["κατέφαγεν",707519,2],["ἡ",709436,10],["ἐρυσίβη",705450,12]],"The leavings of the caterpillar has the locust eaten, and the leavings of the locust has the palmerworm eaten, and the leavings of the palmerworm has the cankerworm eaten."],["5",[["ἐκνήψατε",704265,74],["οἱ",709436,136],["μεθύοντες",708676,146],["ἐξ",704132,0],["οἴνου",709530,18],["αὐτῶν",702165,40],["καὶ",707031,7],["κλαύσατε",707703,74],["θρηνήσατε",706306,74],["πάντες",710177,138],["οἱ",709436,136],["πίνοντες",710478,146],["οἶνον",709530,6],["εἰς",704105,0],["μέθην",708667,9],["ὅτι",709803,7],["ἐξῆρται",704839,187],["ἐκ",704132,0],["στόματος",712125,21],["ὑμῶν",713091,145],["εὐφροσύνη",705717,12],["καὶ",707031,7],["χαρά",713719,12]],"Awake, ye drunkards, from your wine, and weep: mourn, all ye that drink wine to drunkenness: for joy and gladness are removed from your mouth."],["6",[["ὅτι",709803,7],["ἔθνος",704068,15],["ἀνέβη",700905,2],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["μου",709032,133],["ἰσχυρὸν",706855,26],["καὶ",707031,7],["ἀναρίθμητον",701047,26],["οἱ",709436,136],["ὀδόντες",709461,52],["αὐτοῦ",702165,102],["ὀδόντες",709461,52],["λέοντος",708171,18],["καὶ",707031,7],["αἱ",709436,190],["μύλαι",709054,191],["αὐτοῦ",702165,102],["σκύμνου",711903,18]],"For a strong and innumerable nation is come up against my land, their teeth are lion's teeth, and their back teeth those of a [lion's] whelp."],["7",[["ἔθετο",712849,23],["τὴν",709436,8],["ἄμπελόν",700870,9],["μου",709032,133],["εἰς",704105,0],["ἀφανισμὸν",702183,6],["καὶ",707031,7],["τὰς",709436,38],["συκᾶς",712254,39],["μου",709032,133],["εἰς",704105,0],["συγκλασμόν",712217,6],["ἐρευνῶν",705412,72],["ἐξηρεύνησεν",704905,2],["αὐτὴν",702165,104],["καὶ",707031,7],["ἔρριψεν",711267,2],["ἐλεύκανεν",708162,13],["κλήματα",707720,42],["αὐτῆς",702165,86]],"He has ruined my vine, and utterly broken my fig-trees: he has utterly searched [my vine], and cast it down; he has peeled its branches."],["8",[["θρήνησον",706306,176],["πρός",710844,0],["με",708618,163],["ὑπὲρ",713111,0],["νύμφην",709381,9],["περιεζωσμένην",710317,444],["σάκκον",711386,6],["ἐπὶ",705080,0],["τὸν",709436,5],["ἄνδρα",701150,6],["αὐτῆς",702165,86],["τὸν",709436,5],["παρθενικόν",710147,6]],"Lament to me more than a virgin girded with sackcloth for the husband of her youth."],["9",[["ἐξῆρται",704839,187],["θυσία",706345,12],["καὶ",707031,7],["σπονδὴ",712025,12],["ἐξ",704132,0],["οἴκου",709516,18],["κυρίου",707996,18],["πενθεῖτε",710251,335],["οἱ",709436,136],["ἱερεῖς",706614,52],["οἱ",709436,136],["λειτουργοῦντες",708132,146],["θυσιαστηρίῳ",706348,54]],"The meat-offering and drink-offering are removed from the house of the Lord: mourn, ye priests that serve at the altar of the Lord."],["10",[["ὅτι",709803,7],["τεταλαιπώρηκεν",712694,171],["τὰ",709436,63],["πεδία",710215,64],["πενθείτω",710251,31],["ἡ",709436,10],["γῆ",703083,12],["ὅτι",709803,7],["τεταλαιπώρηκεν",712694,171],["σῖτος",711814,4],["ἐξηράνθη",709419,37],["οἶνος",709530,4],["ὠλιγώθη",709576,37],["ἔλαιον",704380,15]],"For the plains languish: let the land mourn, for the corn languishes; the wine is dried up, the oil becomes scarce;"],["11",[["ἐξηράνθησαν",709419,99],["οἱ",709436,136],["γεωργοί",703082,52],["θρηνεῖτε",706306,335],["κτήματα",707933,42],["ὑπὲρ",713111,0],["πυροῦ",711101,18],["καὶ",707031,7],["κριθῆς",707900,17],["ὅτι",709803,7],["ἀπόλωλεν",701513,171],["τρυγητὸς",712998,4],["ἐξ",704132,0],["ἀγροῦ",700196,18]],"the husbandmen are consumed: mourn your property on account of the wheat and barley; for the harvest has perished from off the field."],["12",[["ἡ",709436,10],["ἄμπελος",700870,12],["ἐξηράνθη",709419,37],["καὶ",707031,7],["αἱ",709436,190],["συκαῖ",712254,191],["ὠλιγώθησαν",709576,99],["ῥόα",711273,12],["καὶ",707031,7],["φοῖνιξ",713541,4],["καὶ",707031,7],["μῆλον",708870,15],["καὶ",707031,7],["πάντα",710177,195],["τὰ",709436,63],["ξύλα",709427,64],["τοῦ",709436,35],["ἀγροῦ",700196,18],["ἐξηράνθησαν",709419,99],["ὅτι",709803,7],["ᾔσχυναν",700485,150],["χαρὰν",713719,9],["οἱ",709436,136],["υἱοὶ",713075,52],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"The vine is dried up, and the fig-trees are become few; the pomegranate, and palm-tree, and apple, and all the trees of the field are dried up: for the sons of men have abolished joy."],["13",[["περιζώσασθε",710317,186],["καὶ",707031,7],["κόπτεσθε",707829,73],["οἱ",709436,136],["ἱερεῖς",706614,52],["θρηνεῖτε",706306,87],["οἱ",709436,136],["λειτουργοῦντες",708132,146],["θυσιαστηρίῳ",706348,54],["εἰσέλθατε",704114,74],["ὑπνώσατε",713182,74],["ἐν",704639,0],["σάκκοις",711386,148],["λειτουργοῦντες",708132,146],["θεῷ",706192,114],["ὅτι",709803,7],["ἀπέσχηκεν",701225,171],["ἐξ",704132,0],["οἴκου",709516,18],["θεοῦ",706192,18],["ὑμῶν",713091,145],["θυσία",706345,12],["καὶ",707031,7],["σπονδή",712025,12]],"Gird yourselves [with sackcloth], and lament, ye priests: mourn, ye that serve at the altar: go in, sleep in sackcloths, ye that minister to God: for the meat-offering and drink-offering are withheld from the house of your God."],["14",[["ἁγιάσατε",700153,74],["νηστείαν",709303,9],["κηρύξατε",707662,74],["θεραπείαν",706199,9],["συναγάγετε",712375,74],["πρεσβυτέρους",710735,60],["πάντας",710177,60],["κατοικοῦντας",707534,235],["γῆν",703083,9],["εἰς",704105,0],["οἶκον",709516,6],["θεοῦ",706192,18],["ὑμῶν",713091,145],["καὶ",707031,7],["κεκράξατε",707868,74],["πρὸς",710844,0],["κύριον",707996,6],["ἐκτενῶς",704328,28]],"Sanctify a fast, proclaim a [solemn] service, gather the elders [and] all the inhabitants of the land into the house of your God, and cry earnestly to the Lord,"],["15",[["οἴμμοι",709525,88],["οἴμμοι",709525,88],["οἴμμοι",709525,88],["εἰς",704105,0],["ἡμέραν",705984,9],["ὅτι",709803,7],["ἐγγὺς",703948,28],["ἡμέρα",705984,12],["κυρίου",707996,18],["καὶ",707031,7],["ὡς",714148,7],["ταλαιπωρία",712695,12],["ἐκ",704132,0],["ταλαιπωρίας",712695,17],["ἥξει",705956,127]],"Alas, alas, alas for the day! for the day of the Lord is nigh, and it will come as trouble upon trouble."],["16",[["κατέναντι",707507,28],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["ὑμῶν",713091,145],["βρώματα",702823,64],["ἐξωλεθρεύθη",704956,37],["ἐξ",704132,0],["οἴκου",709516,18],["θεοῦ",706192,18],["ὑμῶν",713091,145],["εὐφροσύνη",705717,12],["καὶ",707031,7],["χαρά",713719,12]],"[Your] meat has been destroyed before your eyes, joy and gladness from out of the house of your God."],["17",[["ἐσκίρτησαν",711857,150],["δαμάλεις",703271,191],["ἐπὶ",705080,0],["ταῖς",709436,75],["φάτναις",713391,76],["αὐτῶν",702165,40],["ἠφανίσθησαν",702182,99],["θησαυροί",706258,52],["κατεσκάφησαν",707416,99],["ληνοί",708176,191],["ὅτι",709803,7],["ἐξηράνθη",709419,37],["σῖτος",711814,4]],"The heifers have started at their mangers, the treasures are abolished, the wine-presses are broken down; for the corn is withered."],["18",[["τί",712867,126],["ἀποθήσομεν",701613,275],["ἑαυτοῖς",703917,151],["ἔκλαυσαν",707703,150],["βουκόλια",702786,64],["βοῶν",702798,81],["ὅτι",709803,7],["οὐχ",709805,28],["ὑπῆρχεν",713104,13],["νομὴ",709337,12],["αὐτοῖς",702165,151],["καὶ",707031,7],["τὰ",709436,63],["ποίμνια",710598,64],["τῶν",709436,43],["προβάτων",710768,44],["ἠφανίσθησαν",702182,99]],"What shall we store up for ourselves? the herds of cattle have mourned, because they had no pasture; and the flocks of sheep have been utterly destroyed."],["19",[["πρὸς",710844,0],["σέ",711598,163],["κύριε",707996,153],["βοήσομαι",702743,181],["ὅτι",709803,7],["πῦρ",711088,15],["ἀνήλωσεν",700992,2],["τὰ",709436,41],["ὡραῖα",714132,68],["τῆς",709436,16],["ἐρήμου",705420,17],["καὶ",707031,7],["φλὸξ",713524,12],["ἀνῆψεν",701044,2],["πάντα",710177,68],["τὰ",709436,41],["ξύλα",709427,42],["τοῦ",709436,35],["ἀγροῦ",700196,18]],"To thee, O Lord, will I cry: for fire has devoured the fair places of the wilderness, and a flame has burnt up all the trees of the field."],["20",[["καὶ",707031,28],["τὰ",709436,63],["κτήνη",707934,64],["τοῦ",709436,20],["πεδίου",710215,21],["ἀνέβλεψαν",700913,150],["πρὸς",710844,0],["σέ",711598,163],["ὅτι",709803,7],["ἐξηράνθησαν",709419,99],["ἀφέσεις",702199,191],["ὑδάτων",713071,44],["καὶ",707031,7],["πῦρ",711088,15],["κατέφαγεν",707519,2],["τὰ",709436,41],["ὡραῖα",714132,68],["τῆς",709436,16],["ἐρήμου",705420,17]],"And the cattle of the field have looked up to thee: for the fountains of waters have been dried up, and fire has devoured the fair places of the wilderness."]]