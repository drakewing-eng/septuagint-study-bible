[["1",[["διότι",703734,7],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["ὅταν",709801,28],["ἐπιστρέψω",705278,165],["τὴν",709436,8],["αἰχμαλωσίαν",700499,9],["Ιουδα",706768,18],["καὶ",707031,7],["Ιερουσαλημ",706644,17]],"For, behold, in those days and at that time, when I shall have turned the captivity of Juda and Jerusalem,"],["2",[["καὶ",707031,7],["συνάξω",712375,165],["πάντα",710177,68],["τὰ",709436,41],["ἔθνη",704068,42],["καὶ",707031,7],["κατάξω",707232,165],["αὐτὰ",702165,71],["εἰς",704105,0],["τὴν",709436,8],["κοιλάδα",707758,9],["Ιωσαφατ",706942,18],["καὶ",707031,7],["διακριθήσομαι",703488,180],["πρὸς",710844,0],["αὐτοὺς",702165,62],["ἐκεῖ",704181,28],["ὑπὲρ",713111,0],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133],["καὶ",707031,7],["τῆς",709436,16],["κληρονομίας",707725,17],["μου",709032,133],["Ισραηλ",706839,18],["οἳ",709781,250],["διεσπάρησαν",703584,99],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9],["μου",709032,133],["καταδιείλαντο",707240,189]],"I will also gather all the Gentiles, and bring them down to the valley of Josaphat, and will plead with them there for my people and my heritage Israel, who have been dispersed among the Gentiles; and [these Gentiles] have divided my land,"],["3",[["καὶ",707031,7],["ἐπὶ",705080,0],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["ἔβαλον",702487,150],["κλήρους",707727,57],["καὶ",707031,7],["ἔδωκαν",703654,150],["τὰ",709436,41],["παιδάρια",709923,42],["πόρναις",710675,76],["καὶ",707031,7],["τὰ",709436,41],["κοράσια",707832,42],["ἐπώλουν",711116,137],["ἀντὶ",701227,0],["οἴνου",709530,18],["καὶ",707031,7],["ἔπινον",710478,137]],"and cast lots over my people, and have given [their] boys to harlots, and sold [their] girls for wine, and have drunk."],["4",[["καὶ",707031,7],["τί",712867,126],["καὶ",707031,7],["ὑμεῖς",713081,219],["ἐμοί",704577,159],["Τύρος",713028,12],["καὶ",707031,7],["Σιδὼν",711775,120],["καὶ",707031,7],["πᾶσα",710177,29],["Γαλιλαία",702940,12],["ἀλλοφύλων",700706,169],["μὴ",708851,28],["ἀνταπόδομα",701216,25],["ὑμεῖς",713081,219],["ἀνταποδίδοτέ",701215,87],["μοι",708974,159],["ἢ",705924,7],["μνησικακεῖτε",708967,87],["ὑμεῖς",713081,219],["ἐπ᾿",705080,0],["ἐμοὶ",704577,159],["ὀξέως",709677,28],["καὶ",707031,7],["ταχέως",712743,28],["ἀνταποδώσω",701215,165],["τὸ",709436,24],["ἀνταπόδομα",701216,25],["ὑμῶν",713091,145],["εἰς",704105,0],["κεφαλὰς",707639,39],["ὑμῶν",713091,145]],"And what have ye to do with me, O Tyre, and Sidon, and all Galilee of the Gentiles? do ye render me a recompense? or do ye bear malice against me? quickly and speedily will I return your recompense on your own heads:"],["5",[["ἀνθ᾿",701227,0],["ὧν",709781,252],["τὸ",709436,24],["ἀργύριόν",701707,25],["μου",709032,133],["καὶ",707031,7],["τὸ",709436,24],["χρυσίον",713972,25],["μου",709032,133],["ἐλάβετε",708076,265],["καὶ",707031,7],["τὰ",709436,41],["ἐπίλεκτά",705189,68],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,41],["καλὰ",707097,68],["εἰσηνέγκατε",704127,265],["εἰς",704105,0],["τοὺς",709436,58],["ναοὺς",709191,57],["ὑμῶν",713091,145]],"because ye have taken my silver and my gold, and ye have brought my choice ornaments into your temples;"],["6",[["καὶ",707031,7],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ιουδα",706768,18],["καὶ",707031,7],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ιερουσαλημ",706644,17],["ἀπέδοσθε",701449,345],["τοῖς",709436,147],["υἱοῖς",713075,148],["τῶν",709436,130],["Ἑλλήνων",704515,65],["ὅπως",709719,7],["ἐξώσητε",704985,125],["αὐτοὺς",702165,62],["ἐκ",704132,0],["τῶν",709436,43],["ὁρίων",709749,44],["αὐτῶν",702165,40]],"and ye have sold the children of Juda and the children of Jerusalem to the children of the Greeks, that ye might expel them from their coasts."],["7",[["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐξεγείρω",704889,157],["αὐτοὺς",702165,62],["ἐκ",704132,0],["τοῦ",709436,35],["τόπου",712903,18],["οὗ",709781,48],["ἀπέδοσθε",701449,345],["αὐτοὺς",702165,62],["ἐκεῖ",704181,28],["καὶ",707031,7],["ἀνταποδώσω",701215,165],["τὸ",709436,24],["ἀνταπόδομα",701216,25],["ὑμῶν",713091,145],["εἰς",704105,0],["κεφαλὰς",707639,39],["ὑμῶν",713091,145]],"Therefore, behold, I [will] raise them up out of the place whither ye have sold them, and I will return your recompense on your own heads."],["8",[["καὶ",707031,7],["ἀποδώσομαι",701449,181],["τοὺς",709436,58],["υἱοὺς",713075,57],["ὑμῶν",713091,145],["καὶ",707031,7],["τὰς",709436,38],["θυγατέρας",706320,39],["ὑμῶν",713091,145],["εἰς",704105,0],["χεῖρας",713787,39],["υἱῶν",713075,81],["Ιουδα",706768,18],["καὶ",707031,7],["ἀποδώσονται",701449,135],["αὐτοὺς",702165,62],["εἰς",704105,0],["αἰχμαλωσίαν",700499,9],["εἰς",704105,0],["ἔθνος",704068,25],["μακρὰν",708411,28],["ἀπέχον",701225,47],["ὅτι",709803,7],["κύριος",707996,4],["ἐλάλησεν",708071,2]],"And I will sell your sons and your daughters into the hands of the children of Juda, and they shall sell them into captivity to a far distant nation: for the Lord has spoken [it]."],["9",[["κηρύξατε",707662,74],["ταῦτα",709858,71],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["ἁγιάσατε",700153,74],["πόλεμον",710605,6],["ἐξεγείρατε",704889,74],["τοὺς",709436,58],["μαχητάς",708602,57],["προσαγάγετε",710848,74],["καὶ",707031,7],["ἀναβαίνετε",700905,335],["πάντες",710177,138],["ἄνδρες",701150,52],["πολεμισταί",710604,52]],"Proclaim these things among the Gentiles; declare war, arouse the warriors, draw near and go up, all ye men of war."],["10",[["συγκόψατε",712230,74],["τὰ",709436,41],["ἄροτρα",701792,42],["ὑμῶν",713091,145],["εἰς",704105,0],["ῥομφαίας",711291,39],["καὶ",707031,7],["τὰ",709436,41],["δρέπανα",703830,42],["ὑμῶν",713091,145],["εἰς",704105,0],["σειρομάστας",711629,57],["ὁ",709436,3],["ἀδύνατος",700297,14],["λεγέτω",708124,31],["ὅτι",709803,7],["ἰσχύω",706859,91],["ἐγώ",704018,164]],"Beat your ploughshares into swords, and your sickles into spears: let the weak say, I am strong."],["11",[["συναθροίζεσθε",712378,73],["καὶ",707031,7],["εἰσπορεύεσθε",704124,73],["πάντα",710177,46],["τὰ",709436,41],["ἔθνη",704068,42],["κυκλόθεν",707956,28],["καὶ",707031,7],["συνάχθητε",712375,372],["ἐκεῖ",704181,28],["ὁ",709436,3],["πραῢς",710725,4],["ἔστω",704093,31],["μαχητής",708602,4]],"Gather yourselves together, and go in, all ye nations round about, and gather yourselves there: let the timid become a warrior."],["12",[["ἐξεγειρέσθωσαν",704889,77],["καὶ",707031,7],["ἀναβαινέτωσαν",700905,56],["πάντα",710177,195],["τὰ",709436,63],["ἔθνη",704068,64],["εἰς",704105,0],["τὴν",709436,8],["κοιλάδα",707758,9],["Ιωσαφατ",706942,114],["διότι",703734,7],["ἐκεῖ",704181,28],["καθιῶ",707006,165],["τοῦ",709436,20],["διακρῖναι",703488,106],["πάντα",710177,68],["τὰ",709436,41],["ἔθνη",704068,42],["κυκλόθεν",707956,28]],"Let them be aroused, let all the nations go up to the valley of Josaphat: for there will I sit to judge all the Gentiles round about."],["13",[["ἐξαποστείλατε",704872,74],["δρέπανα",703830,42],["ὅτι",709803,7],["παρέστηκεν",710152,171],["τρύγητος",712998,4],["εἰσπορεύεσθε",704124,73],["πατεῖτε",710187,335],["διότι",703734,7],["πλήρης",710541,29],["ἡ",709436,10],["ληνός",708176,12],["ὑπερεκχεῖται",713132,117],["τὰ",709436,63],["ὑπολήνια",713214,64],["ὅτι",709803,7],["πεπλήθυνται",710530,255],["τὰ",709436,63],["κακὰ",707066,195],["αὐτῶν",702165,40]],"Bring forth the sickles, for the vintage is come: go in, tread [the grapes], for the press is full: cause the vats to overflow; for their wickedness is multiplied."],["14",[["ἦχοι",706046,52],["ἐξήχησαν",704928,150],["ἐν",704639,0],["τῇ",709436,100],["κοιλάδι",707758,1],["τῆς",709436,16],["δίκης",703702,17],["ὅτι",709803,7],["ἐγγὺς",703948,28],["ἡμέρα",705984,12],["κυρίου",707996,18],["ἐν",704639,0],["τῇ",709436,100],["κοιλάδι",707758,1],["τῆς",709436,16],["δίκης",703702,17]],"Noises have resounded in the valley of judgment: for the day of the Lord is near in the valley of judgment."],["15",[["ὁ",709436,3],["ἥλιος",705974,4],["καὶ",707031,7],["ἡ",709436,10],["σελήνη",711650,12],["συσκοτάσουσιν",712551,218],["καὶ",707031,7],["οἱ",709436,136],["ἀστέρες",702017,52],["δύσουσιν",703848,218],["φέγγος",713404,25],["αὐτῶν",702165,40]],"The sun and the moon shall be darkened, and the stars shall withdraw their light."],["16",[["ὁ",709436,3],["δὲ",703303,11],["κύριος",707996,4],["ἐκ",704132,0],["Σιων",711816,18],["ἀνακεκράξεται",700979,93],["καὶ",707031,7],["ἐξ",704132,0],["Ιερουσαλημ",706644,17],["δώσει",703654,127],["φωνὴν",713640,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["σεισθήσεται",711633,134],["ὁ",709436,3],["οὐρανὸς",709844,4],["καὶ",707031,7],["ἡ",709436,10],["γῆ",703083,12],["ὁ",709436,3],["δὲ",703303,11],["κύριος",707996,4],["φείσεται",713406,93],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐνισχύσει",704750,127],["κύριος",707996,4],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ισραηλ",706839,18]],"And the Lord shall cry out of Sion, and shall utter his voice from Jerusalem; and the heaven and the earth shall be shaken, but the Lord shall spare his people, and shall strengthen the children of Israel."],["17",[["καὶ",707031,7],["ἐπιγνώσεσθε",705104,124],["διότι",703734,7],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["ὁ",709436,3],["κατασκηνῶν",707423,72],["ἐν",704639,0],["Σιων",711816,114],["ἐν",704639,0],["ὄρει",709768,54],["ἁγίῳ",700159,97],["μου",709032,133],["καὶ",707031,7],["ἔσται",704093,93],["Ιερουσαλημ",706644,12],["πόλις",710612,12],["ἁγία",700159,29],["καὶ",707031,7],["ἀλλογενεῖς",700690,138],["οὐ",709805,28],["διελεύσονται",703673,135],["δι᾿",703417,0],["αὐτῆς",702165,86],["οὐκέτι",709827,28]],"And ye shall know that I am the Lord your God, who dwell in Sion my holy mountain: and Jerusalem shall be holy, and strangers shall not pass through her any more."],["18",[["καὶ",707031,7],["ἔσται",704093,93],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἀποσταλάξει",701585,127],["τὰ",709436,63],["ὄρη",709768,64],["γλυκασμόν",703112,6],["καὶ",707031,7],["οἱ",709436,136],["βουνοὶ",702797,52],["ῥυήσονται",711241,135],["γάλα",702919,25],["καὶ",707031,7],["πᾶσαι",710177,192],["αἱ",709436,190],["ἀφέσεις",702199,191],["Ιουδα",706768,18],["ῥυήσονται",711241,135],["ὕδατα",713071,42],["καὶ",707031,7],["πηγὴ",710450,12],["ἐξ",704132,0],["οἴκου",709516,18],["κυρίου",707996,18],["ἐξελεύσεται",704909,93],["καὶ",707031,7],["ποτιεῖ",710700,127],["τὸν",709436,5],["χειμάρρουν",713783,27],["τῶν",709436,80],["σχοίνων",712613,81]],"And it shall come to pass in that day [that] the mountains shall drop sweet wine, and the hills shall flow with milk, and all the fountains of Juda shall flow with water, and a fountain shall go forth of the house of the Lord, and water the valley of flags."],["19",[["Αἴγυπτος",700401,12],["εἰς",704105,0],["ἀφανισμὸν",702183,6],["ἔσται",704093,93],["καὶ",707031,7],["ἡ",709436,10],["Ιδουμαία",706503,12],["εἰς",704105,0],["πεδίον",710215,25],["ἀφανισμοῦ",702183,18],["ἔσται",704093,93],["ἐξ",704132,0],["ἀδικιῶν",700271,65],["υἱῶν",713075,81],["Ιουδα",706768,18],["ἀνθ᾿",701227,0],["ὧν",709781,252],["ἐξέχεαν",704368,150],["αἷμα",700442,25],["δίκαιον",703694,46],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["αὐτῶν",702165,40]],"Egypt shall be a desolation, and Idumea shall be a desolate plain, because of the wrongs of the children of Juda, because they have shed righteous blood in their land."],["20",[["ἡ",709436,10],["δὲ",703303,11],["Ιουδαία",706769,12],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["κατοικηθήσεται",707534,134],["καὶ",707031,7],["Ιερουσαλημ",706644,12],["εἰς",704105,0],["γενεὰς",703037,39],["γενεῶν",703037,65]],"But Judea shall be inhabited for ever, and Jerusalem to all generations."],["21",[["καὶ",707031,7],["ἐκδικήσω",704174,165],["τὸ",709436,24],["αἷμα",700442,25],["αὐτῶν",702165,40],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἀθῳώσω",700391,165],["καὶ",707031,7],["κύριος",707996,4],["κατασκηνώσει",707423,127],["ἐν",704639,0],["Σιων",711816,114]],"And I will make inquisition for their blood, and will by no means leave it unavenged: and the Lord shall dwell in Sion."]]