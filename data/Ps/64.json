[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114],["ᾠδή",714091,12],["Ιερεμιου",706611,18],["καὶ",707031,7],["Ιεζεκιηλ",706539,18],["ἐκ",704132,0],["τοῦ",709436,35],["λόγου",708236,18],["τῆς",709436,16],["παροικίας",710158,17],["ὅτε",709802,28],["ἔμελλον",708705,137],["ἐκπορεύεσθαι",704293,110]],"For the end, a Psalm [and] Song of David.",{"s":"d","q":0.4}],["2",[["σοὶ",711925,159],["πρέπει",710728,91],["ὕμνος",713089,4],["ὁ",709436,3],["θεός",706192,4],["ἐν",704639,0],["Σιων",711816,1],["καὶ",707031,7],["σοὶ",711925,159],["ἀποδοθήσεται",701449,134],["εὐχὴ",705726,12],["ἐν",704639,0],["Ιερουσαλημ",706644,1]],"Praise becomes thee, O God, in Sion; and to thee shall the vow be performed."],["3",[["εἰσάκουσον",704108,176],["προσευχῆς",710892,17],["μου",709032,133],["πρὸς",710844,0],["σὲ",711598,163],["πᾶσα",710177,29],["σὰρξ",711537,12],["ἥξει",705956,127]],"Hear my prayer; to thee all flesh shall come."],["4",[["λόγοι",708236,52],["ἀνομιῶν",701192,65],["ὑπερεδυνάμωσαν",713129,150],["ἡμᾶς",705981,194],["καὶ",707031,7],["τὰς",709436,38],["ἀσεβείας",701904,39],["ἡμῶν",705999,145],["σὺ",712181,164],["ἱλάσῃ",706728,123]],"The words of transgressors have overpowered us; but do thou pardon our sins."],["5",[["μακάριος",708397,14],["ὃν",709781,112],["ἐξελέξω",704236,174],["καὶ",707031,7],["προσελάβου",710930,174],["κατασκηνώσει",707423,127],["ἐν",704639,0],["ταῖς",709436,75],["αὐλαῖς",702137,76],["σου",711945,133],["πλησθησόμεθα",710532,347],["ἐν",704639,0],["τοῖς",709436,147],["ἀγαθοῖς",700106,230],["τοῦ",709436,35],["οἴκου",709516,18],["σου",711945,133],["ἅγιος",700159,14],["ὁ",709436,3],["ναός",709191,4],["σου",711945,133],["θαυμαστὸς",706138,14],["ἐν",704639,0],["δικαιοσύνῃ",703695,1]],"Blessed [is he] whom thou hast chosen and adopted; he shall dwell in thy courts; we shall be filled with the good things of thy house; thy temple is holy."],["6",[["ἐπάκουσον",705009,176],["ἡμῶν",705999,145],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["σωτὴρ",712657,4],["ἡμῶν",705999,145],["ἡ",709436,10],["ἐλπὶς",704530,12],["πάντων",710177,83],["τῶν",709436,43],["περάτων",710281,44],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἐν",704639,0],["θαλάσσῃ",706069,1],["μακράν",708411,28]],"[Thou art] wonderful in righteousness. Hearken to us, O God our Saviour; the hope of all the ends of the earth, and of them [that are] on the sea afar off:"],["7",[["ἑτοιμάζων",705539,72],["ὄρη",709768,42],["ἐν",704639,0],["τῇ",709436,100],["ἰσχύι",706858,1],["αὐτοῦ",702165,102],["περιεζωσμένος",710317,419],["ἐν",704639,0],["δυναστείᾳ",703841,1]],"who dost establish the mountains in thy strength, being girded about with power;"],["8",[["ὁ",709436,3],["συνταράσσων",712507,72],["τὸ",709436,24],["κύτος",708000,25],["τῆς",709436,16],["θαλάσσης",706069,17],["ἤχους",706046,57],["κυμάτων",707968,44],["αὐτῆς",702165,86],["ταραχθήσονται",712721,144],["τὰ",709436,63],["ἔθνη",704068,64]],"who troublest the depth of the sea, the sounds of its waves."],["9",[["καὶ",707031,7],["φοβηθήσονται",713532,144],["οἱ",709436,136],["κατοικοῦντες",707534,146],["τὰ",709436,41],["πέρατα",710281,42],["ἀπὸ",701425,0],["τῶν",709436,80],["σημείων",711748,44],["σου",711945,133],["ἐξόδους",704948,39],["πρωίας",711025,17],["καὶ",707031,7],["ἑσπέρας",705500,17],["τέρψεις",712804,166]],"The nations shall be troubled, and they that inhabit the ends [of the earth] shall be afraid of thy signs; thou wilt cause the outgoings of morning and evening to rejoice."],["10",[["ἐπεσκέψω",705250,174],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἐμέθυσας",708676,162],["αὐτήν",702165,104],["ἐπλήθυνας",710530,162],["τοῦ",709436,20],["πλουτίσαι",710562,106],["αὐτήν",702165,104],["ὁ",709436,3],["ποταμὸς",710693,4],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐπληρώθη",710543,37],["ὑδάτων",713071,44],["ἡτοίμασας",705539,162],["τὴν",709436,8],["τροφὴν",712984,9],["αὐτῶν",702165,40],["ὅτι",709803,7],["οὕτως",709859,28],["ἡ",709436,10],["ἑτοιμασία",705540,12],["σου",711945,133]],"Thou hast visited the earth, and saturated it; thou hast abundantly enriched it. The river of God is filled with water; thou hast prepared their food, for thus is the preparation [of it]."],["11",[["τοὺς",709436,58],["αὔλακας",702134,57],["αὐτῆς",702165,86],["μέθυσον",708676,176],["πλήθυνον",710530,176],["τὰ",709436,41],["γενήματα",703052,42],["αὐτῆς",702165,86],["ἐν",704639,0],["ταῖς",709436,75],["σταγόσιν",712036,76],["αὐτῆς",702165,86],["εὐφρανθήσεται",705715,134],["ἀνατέλλουσα",701066,188]],"Saturate her furrows, multiply her fruits; [the crop] springing up shall rejoice in its drops."],["12",[["εὐλογήσεις",705631,166],["τὸν",709436,5],["στέφανον",712083,6],["τοῦ",709436,35],["ἐνιαυτοῦ",704745,18],["τῆς",709436,16],["χρηστότητός",713959,17],["σου",711945,133],["καὶ",707031,7],["τὰ",709436,63],["πεδία",710215,64],["σου",711945,133],["πλησθήσονται",710532,144],["πιότητος",710479,17]],"Thou wilt bless the crown of the year [because] of thy goodness; and thy plains shall be filled with fatness."],["13",[["πιανθήσονται",710464,144],["τὰ",709436,41],["ὡραῖα",714132,68],["τῆς",709436,16],["ἐρήμου",705420,17],["καὶ",707031,7],["ἀγαλλίασιν",700113,9],["οἱ",709436,136],["βουνοὶ",702797,52],["περιζώσονται",710317,135]],"The mountains of the wilderness shall be enriched; and the hills shall gird themselves with joy."],["14",[["ἐνεδύσαντο",704701,189],["οἱ",709436,136],["κριοὶ",707906,52],["τῶν",709436,43],["προβάτων",710768,44],["καὶ",707031,7],["αἱ",709436,190],["κοιλάδες",707758,191],["πληθυνοῦσι",710530,218],["σῖτον",711814,6],["κεκράξονται",707868,135],["καὶ",707031,7],["γὰρ",702963,11],["ὑμνήσουσιν",713085,218]],"The rams of the flock are clothed [with wool], and the valleys shall abound in corn; they shall cry aloud, yea they shall sing hymns."]]