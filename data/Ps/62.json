[["1",[["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114],["ἐν",704639,0],["τῷ",709436,53],["εἶναι",704093,55],["αὐτὸν",702165,85],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["τῆς",709436,16],["Ιουδαίας",706769,17]],"A Psalm of David, when he was in the wilderness of Idumea."],["2",[["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["πρὸς",710844,0],["σὲ",711598,163],["ὀρθρίζω",709742,157],["ἐδίψησέν",703763,2],["σοι",711925,159],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ποσαπλῶς",710688,28],["σοι",711925,159],["ἡ",709436,10],["σάρξ",711537,12],["μου",709032,133],["ἐν",704639,0],["γῇ",703083,1],["ἐρήμῳ",705420,1],["καὶ",707031,7],["ἀβάτῳ",700023,101],["καὶ",707031,7],["ἀνύδρῳ",701285,101]],"O God, my God, I cry to thee early; my soul has thirsted for thee: how often has my flesh [longed] after thee, in a barren and trackless and dry land!"],["3",[["οὕτως",709859,28],["ἐν",704639,0],["τῷ",709436,113],["ἁγίῳ",700159,30],["ὤφθην",709725,156],["σοι",711925,159],["τοῦ",709436,20],["ἰδεῖν",709725,106],["τὴν",709436,8],["δύναμίν",703839,9],["σου",711945,133],["καὶ",707031,7],["τὴν",709436,8],["δόξαν",703791,9],["σου",711945,133]],"Thus have I appeared before thee in the sanctuary, that I might see thy power and thy glory."],["4",[["ὅτι",709803,7],["κρεῖσσον",707890,26],["τὸ",709436,34],["ἔλεός",704426,15],["σου",711945,133],["ὑπὲρ",713111,0],["ζωάς",705910,39],["τὰ",709436,63],["χείλη",713781,64],["μου",709032,133],["ἐπαινέσουσίν",705000,218],["σε",711598,163]],"For thy mercy is better than life: my lips shall praise thee."],["5",[["οὕτως",709859,28],["εὐλογήσω",705631,165],["σε",711598,163],["ἐν",704639,0],["τῇ",709436,100],["ζωῇ",705910,1],["μου",709032,133],["ἐν",704639,0],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["ἀρῶ",700473,165],["τὰς",709436,38],["χεῖράς",713787,39],["μου",709032,133]],"Thus will I bless thee during my life: I will lift up my hands in thy name."],["6",[["ὡσεὶ",714159,7],["στέατος",712054,21],["καὶ",707031,7],["πιότητος",710479,17],["ἐμπλησθείη",704592,528],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["καὶ",707031,7],["χείλη",713781,64],["ἀγαλλιάσεως",700113,17],["αἰνέσει",700459,127],["τὸ",709436,34],["στόμα",712125,15],["μου",709032,133]],"Let my soul be filled as with marrow and fatness; and [my] joyful lips shall praise thy name."],["7",[["εἰ",704071,7],["ἐμνημόνευόν",708965,137],["σου",711945,133],["ἐπὶ",705080,0],["τῆς",709436,16],["στρωμνῆς",712174,17],["μου",709032,133],["ἐν",704639,0],["τοῖς",709436,147],["ὄρθροις",709745,148],["ἐμελέτων",708698,137],["εἰς",704105,0],["σέ",711598,163]],"Forasmuch as I have remembered thee on my bed: in the early seasons I have meditated on thee."],["8",[["ὅτι",709803,7],["ἐγενήθης",703104,168],["βοηθός",702748,4],["μου",709032,133],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["σκέπῃ",711839,1],["τῶν",709436,130],["πτερύγων",711057,65],["σου",711945,133],["ἀγαλλιάσομαι",700114,181]],"For thou hast been my helper, and in the shelter of thy wings will I rejoice."],["9",[["ἐκολλήθη",707791,37],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ὀπίσω",709697,0],["σου",711945,133],["ἐμοῦ",704580,133],["ἀντελάβετο",701243,23],["ἡ",709436,10],["δεξιά",703360,29],["σου",711945,133]],"My soul has kept very close behind thee: thy right hand has upheld me."],["10",[["αὐτοὶ",702165,201],["δὲ",703303,11],["εἰς",704105,0],["μάτην",708582,28],["ἐζήτησαν",705879,150],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["εἰσελεύσονται",704114,135],["εἰς",704105,0],["τὰ",709436,41],["κατώτατα",707560,42],["τῆς",709436,16],["γῆς",703083,17]],"But they vainly sought after my soul; they shall go into the lowest parts of the earth."],["11",[["παραδοθήσονται",710014,144],["εἰς",704105,0],["χεῖρας",713787,39],["ῥομφαίας",711291,17],["μερίδες",708748,191],["ἀλωπέκων",700743,65],["ἔσονται",704093,135]],"They shall be delivered up to the power of the sword; they shall be portions for foxes."],["12",[["ὁ",709436,3],["δὲ",703303,11],["βασιλεὺς",702580,4],["εὐφρανθήσεται",705715,134],["ἐπὶ",705080,0],["τῷ",709436,113],["θεῷ",706192,114],["ἐπαινεσθήσεται",705000,134],["πᾶς",710177,14],["ὁ",709436,3],["ὀμνύων",709620,72],["ἐν",704639,0],["αὐτῷ",702165,50],["ὅτι",709803,7],["ἐνεφράγη",704635,2],["στόμα",712125,25],["λαλούντων",708071,170],["ἄδικα",700272,68]],"But the king shall rejoice in God; every one that swears by him shall be praised; for the mouth of them that speak unjust things has been stopped."]]