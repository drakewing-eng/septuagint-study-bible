[["1",[["αλληλουια",700688,88],["ἐξομολογεῖσθε",704960,73],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["ἐπικαλεῖσθε",705153,73],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["ἀπαγγείλατε",701321,74],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["τὰ",709436,41],["ἔργα",705396,42],["αὐτοῦ",702165,102]],"Alleluia. Give thanks to the Lord, and call upon his name; declare his works among the heathen."],["2",[["ᾄσατε",700299,74],["αὐτῷ",702165,50],["καὶ",707031,7],["ψάλατε",714021,74],["αὐτῷ",702165,50],["διηγήσασθε",703679,186],["πάντα",710177,68],["τὰ",709436,41],["θαυμάσια",706136,68],["αὐτοῦ",702165,102]],"Sing to him, yea, sing praises to him: tell forth all his wonderful works."],["3",[["ἐπαινεῖσθε",705000,374],["ἐν",704639,0],["τῷ",709436,53],["ὀνόματι",709666,54],["τῷ",709436,113],["ἁγίῳ",700159,30],["αὐτοῦ",702165,102],["εὐφρανθήτω",705715,22],["καρδία",707141,12],["ζητούντων",705879,170],["τὸν",709436,5],["κύριον",707996,6]],"Glory in his holy name: let the heart of them that seek the Lord rejoice."],["4",[["ζητήσατε",705879,74],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["κραταιώθητε",707875,372],["ζητήσατε",705879,74],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["διὰ",703417,0],["παντός",710177,116]],"Seek ye the Lord, and be strengthened; seek his face continually."],["5",[["μνήσθητε",708960,125],["τῶν",709436,80],["θαυμασίων",706136,169],["αὐτοῦ",702165,102],["ὧν",709781,252],["ἐποίησεν",710582,2],["τὰ",709436,41],["τέρατα",712793,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["κρίματα",707903,42],["τοῦ",709436,20],["στόματος",712125,21],["αὐτοῦ",702165,102]],"Remember his wonderful works that he has done; his wonders, and the judgments of his mouth;"],["6",[["σπέρμα",712008,15],["Αβρααμ",700091,18],["δοῦλοι",703817,52],["αὐτοῦ",702165,102],["υἱοὶ",713075,52],["Ιακωβ",706401,18],["ἐκλεκτοὶ",704240,138],["αὐτοῦ",702165,102]],"[ye] seed of Abraam, his servants, [ye] children of Jacob, his chosen ones."],["7",[["αὐτὸς",702165,121],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["ἐν",704639,0],["πάσῃ",710177,101],["τῇ",709436,100],["γῇ",703083,1],["τὰ",709436,63],["κρίματα",707903,64],["αὐτοῦ",702165,102]],"He is the Lord our God; his judgments are in all the earth."],["8",[["ἐμνήσθη",708960,2],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["διαθήκης",703456,17],["αὐτοῦ",702165,102],["λόγου",708236,18],["οὗ",709781,48],["ἐνετείλατο",704791,23],["εἰς",704105,0],["χιλίας",713859,119],["γενεάς",703037,39]],"He has remembered his covenant for ever, the word which he commanded for a thousand generations:"],["9",[["ὃν",709781,112],["διέθετο",703609,23],["τῷ",709436,113],["Αβρααμ",700091,114],["καὶ",707031,7],["τοῦ",709436,35],["ὅρκου",709753,18],["αὐτοῦ",702165,102],["τῷ",709436,113],["Ισαακ",706799,114]],"which he established as a covenant to Abraam, and [he remembered] his oath to Isaac."],["10",[["καὶ",707031,7],["ἔστησεν",706846,2],["αὐτὴν",702165,104],["τῷ",709436,113],["Ιακωβ",706401,114],["εἰς",704105,0],["πρόσταγμα",710959,25],["καὶ",707031,7],["τῷ",709436,113],["Ισραηλ",706839,114],["διαθήκην",703456,9],["αἰώνιον",700505,36]],"And he established it to Jacob for an ordinance, and to Israel for an everlasting covenant;"],["11",[["λέγων",708124,72],["σοὶ",711925,159],["δώσω",703654,165],["τὴν",709436,8],["γῆν",703083,9],["Χανααν",713708,9],["σχοίνισμα",712611,25],["κληρονομίας",707725,17],["ὑμῶν",713091,145]],"saying, To thee will I give the land of Chanaan, the line of your inheritance:"],["12",[["ἐν",704639,0],["τῷ",709436,53],["εἶναι",704093,55],["αὐτοὺς",702165,62],["ἀριθμῷ",701744,114],["βραχεῖς",702809,60],["ὀλιγοστοὺς",709569,60],["καὶ",707031,7],["παροίκους",710159,60],["ἐν",704639,0],["αὐτῇ",702165,105]],"when they were few in number, very few, and sojourners in it."],["13",[["καὶ",707031,7],["διῆλθον",703673,150],["ἐξ",704132,0],["ἔθνους",704068,21],["εἰς",704105,0],["ἔθνος",704068,25],["ἐκ",704132,0],["βασιλείας",702577,17],["εἰς",704105,0],["λαὸν",708094,6],["ἕτερον",705535,27]],"And they went from nation to nation, and from [one] kingdom to another people."],["14",[["οὐκ",709805,28],["ἀφῆκεν",702211,2],["ἄνθρωπον",701163,6],["ἀδικῆσαι",700269,106],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἤλεγξεν",704416,2],["ὑπὲρ",713111,0],["αὐτῶν",702165,40],["βασιλεῖς",702580,57]],"He suffered no man to wrong them; and he rebuked kings for their sakes:"],["15",[["μὴ",708851,28],["ἅπτεσθε",701654,374],["τῶν",709436,80],["χριστῶν",713964,169],["μου",709032,133],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["προφήταις",711009,148],["μου",709032,133],["μὴ",708851,28],["πονηρεύεσθε",710657,374]],"[saying], Touch not my anointed ones; and do my prophets no harm."],["16",[["καὶ",707031,7],["ἐκάλεσεν",707084,2],["λιμὸν",708210,6],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["πᾶν",710177,46],["στήριγμα",712097,25],["ἄρτου",701829,18],["συνέτριψεν",712520,2]],"Moreover he called for a famine upon the land; he broke the whole support of bread."],["17",[["ἀπέστειλεν",701592,2],["ἔμπροσθεν",704618,0],["αὐτῶν",702165,40],["ἄνθρωπον",701163,6],["εἰς",704105,0],["δοῦλον",703817,6],["ἐπράθη",710480,37],["Ιωσηφ",706948,4]],"He sent a man before them; Joseph was sold for a slave."],["18",[["ἐταπείνωσαν",712717,150],["ἐν",704639,0],["πέδαις",710210,76],["τοὺς",709436,58],["πόδας",710707,57],["αὐτοῦ",702165,102],["σίδηρον",711774,6],["διῆλθεν",703673,2],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτοῦ",702165,102]],"They hurt his feet with fetters; his soul passed into iron,"],["19",[["μέχρι",708849,0],["τοῦ",709436,20],["ἐλθεῖν",705453,106],["τὸν",709436,5],["λόγον",708236,6],["αὐτοῦ",702165,102],["τὸ",709436,24],["λόγιον",708233,25],["κυρίου",707996,18],["ἐπύρωσεν",711103,2],["αὐτόν",702165,85]],"until the time that his cause came on; the word of the Lord tried him as fire."],["20",[["ἀπέστειλεν",701592,2],["βασιλεὺς",702580,4],["καὶ",707031,7],["ἔλυσεν",708288,2],["αὐτόν",702165,85],["ἄρχων",701862,4],["λαῶν",708094,81],["καὶ",707031,7],["ἀφῆκεν",702211,2],["αὐτόν",702165,85]],"The king sent and loosed him; [even] the prince of the people, and let him go free."],["21",[["κατέστησεν",707011,2],["αὐτὸν",702165,85],["κύριον",707996,6],["τοῦ",709436,35],["οἴκου",709516,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἄρχοντα",701862,6],["πάσης",710177,82],["τῆς",709436,16],["κτήσεως",707937,17],["αὐτοῦ",702165,102]],"He made him lord over his house, and ruler of all his substance;"],["22",[["τοῦ",709436,20],["παιδεῦσαι",709926,106],["τοὺς",709436,58],["ἄρχοντας",701862,57],["αὐτοῦ",702165,102],["ὡς",714148,11],["ἑαυτὸν",703917,85],["καὶ",707031,7],["τοὺς",709436,58],["πρεσβυτέρους",710735,57],["αὐτοῦ",702165,102],["σοφίσαι",711982,106]],"to chastise his rulers at his pleasure, and to teach his elders wisdom."],["23",[["καὶ",707031,7],["εἰσῆλθεν",704114,2],["Ισραηλ",706839,4],["εἰς",704105,0],["Αἴγυπτον",700401,9],["καὶ",707031,7],["Ιακωβ",706401,4],["παρῴκησεν",710156,2],["ἐν",704639,0],["γῇ",703083,1],["Χαμ",713699,118]],"Israel also came into Egypt, and Jacob sojourned in the land of Cham."],["24",[["καὶ",707031,7],["ηὔξησεν",702144,2],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["σφόδρα",712586,28],["καὶ",707031,7],["ἐκραταίωσεν",707875,2],["αὐτὸν",702165,85],["ὑπὲρ",713111,0],["τοὺς",709436,58],["ἐχθροὺς",705779,57],["αὐτοῦ",702165,102]],"And he increased his people greatly, and made them stronger than their enemies."],["25",[["μετέστρεψεν",708817,2],["τὴν",709436,8],["καρδίαν",707141,9],["αὐτῶν",702165,40],["τοῦ",709436,20],["μισῆσαι",708935,106],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["τοῦ",709436,20],["δολιοῦσθαι",703785,110],["ἐν",704639,0],["τοῖς",709436,147],["δούλοις",703817,148],["αὐτοῦ",702165,102]],"And he turned their heart to hate his people, to deal craftily with his servants."],["26",[["ἐξαπέστειλεν",704872,2],["Μωυσῆν",709112,6],["τὸν",709436,5],["δοῦλον",703817,6],["αὐτοῦ",702165,102],["Ααρων",700005,6],["ὃν",709781,112],["ἐξελέξατο",704236,23],["αὐτόν",702165,85]],"He sent forth Moses his servant, [and] Aaron whom he had chosen."],["27",[["ἔθετο",712849,23],["ἐν",704639,0],["αὐτοῖς",702165,151],["τοὺς",709436,58],["λόγους",708236,57],["τῶν",709436,43],["σημείων",711748,44],["αὐτοῦ",702165,102],["καὶ",707031,7],["τῶν",709436,43],["τεράτων",712793,44],["ἐν",704639,0],["γῇ",703083,1],["Χαμ",713699,118]],"He established among them his signs, and [his] wonders in the land of Cham."],["28",[["ἐξαπέστειλεν",704872,2],["σκότος",711889,25],["καὶ",707031,7],["ἐσκότασεν",711887,2],["καὶ",707031,7],["παρεπίκραναν",710087,150],["τοὺς",709436,58],["λόγους",708236,57],["αὐτοῦ",702165,102]],"He sent forth darkness, and made it dark; yet they rebelled against his words."],["29",[["μετέστρεψεν",708817,2],["τὰ",709436,41],["ὕδατα",713071,42],["αὐτῶν",702165,40],["εἰς",704105,0],["αἷμα",700442,25],["καὶ",707031,7],["ἀπέκτεινεν",701498,2],["τοὺς",709436,58],["ἰχθύας",706870,57],["αὐτῶν",702165,40]],"He turned their waters into blood, and slew their fish."],["30",[["ἐξῆρψεν",704908,2],["ἡ",709436,10],["γῆ",703083,12],["αὐτῶν",702165,40],["βατράχους",702599,57],["ἐν",704639,0],["τοῖς",709436,95],["ταμιείοις",712700,96],["τῶν",709436,80],["βασιλέων",702580,81],["αὐτῶν",702165,40]],"Their land produced frogs abundantly, in the chambers of their kings."],["31",[["εἶπεν",705373,2],["καὶ",707031,7],["ἦλθεν",705453,2],["κυνόμυια",707978,12],["καὶ",707031,7],["σκνῖπες",711866,52],["ἐν",704639,0],["πᾶσι",710177,94],["τοῖς",709436,95],["ὁρίοις",709749,96],["αὐτῶν",702165,40]],"He spoke, and the dog-fly came, and lice in all their coasts."],["32",[["ἔθετο",712849,23],["τὰς",709436,38],["βροχὰς",702819,39],["αὐτῶν",702165,40],["χάλαζαν",713667,9],["πῦρ",711088,25],["καταφλέγον",707477,47],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["αὐτῶν",702165,40]],"He turned their rain into hail, [and sent] flaming fire in their land."],["33",[["καὶ",707031,7],["ἐπάταξεν",710185,2],["τὰς",709436,38],["ἀμπέλους",700870,39],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰς",709436,38],["συκᾶς",712254,39],["αὐτῶν",702165,40],["καὶ",707031,7],["συνέτριψεν",712520,2],["πᾶν",710177,46],["ξύλον",709427,25],["ὁρίου",709749,21],["αὐτῶν",702165,40]],"And he smote their vines and their fig-trees; and broke every tree of their coast."],["34",[["εἶπεν",705373,2],["καὶ",707031,7],["ἦλθεν",705453,2],["ἀκρὶς",700599,12],["καὶ",707031,7],["βροῦχος",702818,4],["οὗ",709781,48],["οὐκ",709805,28],["ἦν",704093,13],["ἀριθμός",701744,4]],"He spoke, and the locust came, and caterpillars innumerable,"],["35",[["καὶ",707031,7],["κατέφαγεν",707519,2],["πάντα",710177,27],["τὸν",709436,5],["χόρτον",713923,6],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["αὐτῶν",702165,40],["καὶ",707031,7],["κατέφαγεν",707519,2],["τὸν",709436,5],["καρπὸν",707169,6],["τῆς",709436,16],["γῆς",703083,17],["αὐτῶν",702165,40]],"and devoured all the grass in their land, and devoured the fruit of their ground."],["36",[["καὶ",707031,7],["ἐπάταξεν",710185,2],["πᾶν",710177,26],["πρωτότοκον",711046,27],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["αὐτῶν",702165,40],["ἀπαρχὴν",701359,9],["παντὸς",710177,116],["πόνου",710661,18],["αὐτῶν",702165,40]],"He smote also every first-born of their land, the first-fruits of all their labour."],["37",[["καὶ",707031,7],["ἐξήγαγεν",704834,2],["αὐτοὺς",702165,62],["ἐν",704639,0],["ἀργυρίῳ",701707,54],["καὶ",707031,7],["χρυσίῳ",713972,54],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ἐν",704639,0],["ταῖς",709436,75],["φυλαῖς",713620,76],["αὐτῶν",702165,40],["ἀσθενῶν",701939,169]],"And he brought them out with silver and gold; and there was not a feeble one among their tribes."],["38",[["εὐφράνθη",705715,37],["Αἴγυπτος",700401,12],["ἐν",704639,0],["τῇ",709436,100],["ἐξόδῳ",704948,1],["αὐτῶν",702165,40],["ὅτι",709803,7],["ἐπέπεσεν",705225,2],["ὁ",709436,3],["φόβος",713534,4],["αὐτῶν",702165,40],["ἐπ᾿",705080,0],["αὐτούς",702165,62]],"Egypt rejoiced at their departing; for the fear of them fell upon them."],["39",[["διεπέτασεν",703545,2],["νεφέλην",709277,9],["εἰς",704105,0],["σκέπην",711839,9],["αὐτοῖς",702165,151],["καὶ",707031,7],["πῦρ",711088,25],["τοῦ",709436,20],["φωτίσαι",713646,106],["αὐτοῖς",702165,151],["τὴν",709436,8],["νύκτα",709386,9]],"He spread out a cloud for a covering to them, and fire to give them light by night."],["40",[["ᾔτησαν",700489,150],["καὶ",707031,7],["ἦλθεν",705453,2],["ὀρτυγομήτρα",709773,12],["καὶ",707031,7],["ἄρτον",701829,6],["οὐρανοῦ",709844,18],["ἐνέπλησεν",704592,2],["αὐτούς",702165,62]],"They asked, and the quail came, and he satisfied them with the bread of heaven."],["41",[["διέρρηξεν",703565,2],["πέτραν",710443,9],["καὶ",707031,7],["ἐρρύησαν",711241,150],["ὕδατα",713071,25],["ἐπορεύθησαν",710667,99],["ἐν",704639,0],["ἀνύδροις",701285,230],["ποταμοί",710693,52]],"He clave the rock, and the waters flowed; rivers ran in dry places."],["42",[["ὅτι",709803,7],["ἐμνήσθη",708960,2],["τοῦ",709436,35],["λόγου",708236,18],["τοῦ",709436,35],["ἁγίου",700159,116],["αὐτοῦ",702165,102],["τοῦ",709436,35],["πρὸς",710844,0],["Αβρααμ",700091,6],["τὸν",709436,5],["δοῦλον",703817,6],["αὐτοῦ",702165,102]],"For he remembered his holy word, which [he promised] to Abraam his servant."],["43",[["καὶ",707031,7],["ἐξήγαγεν",704834,2],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["ἐν",704639,0],["ἀγαλλιάσει",700113,1],["καὶ",707031,7],["τοὺς",709436,58],["ἐκλεκτοὺς",704240,60],["αὐτοῦ",702165,102],["ἐν",704639,0],["εὐφροσύνῃ",705717,1]],"And he brought out his people with exultation, and his chosen with joy;"],["44",[["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτοῖς",702165,151],["χώρας",714011,39],["ἐθνῶν",704068,44],["καὶ",707031,7],["πόνους",710661,57],["λαῶν",708094,81],["ἐκληρονόμησαν",707724,150]],"and gave them the lands of the heathen; and they inherited the labours of the people;"],["45",[["ὅπως",709719,7],["ἂν",700900,11],["φυλάξωσιν",713619,234],["τὰ",709436,41],["δικαιώματα",703697,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὸν",709436,5],["νόμον",709349,6],["αὐτοῦ",702165,102],["ἐκζητήσωσιν",704187,234]],"that they might keep his ordinances, and diligently seek his law."]]