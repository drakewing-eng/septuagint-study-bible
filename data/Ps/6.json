[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ἐν",704639,0],["ὕμνοις",713089,148],["ὑπὲρ",713111,0],["τῆς",709436,16],["ὀγδόης",709444,82],["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, a Psalm of David among the Hymns for the eighth."],["2",[["κύριε",707996,153],["μὴ",708851,28],["τῷ",709436,113],["θυμῷ",706334,114],["σου",711945,133],["ἐλέγξῃς",704416,175],["με",708618,163],["μηδὲ",708855,7],["τῇ",709436,100],["ὀργῇ",709728,1],["σου",711945,133],["παιδεύσῃς",709926,175],["με",708618,163]],"O Lord, rebuke me not in thy wrath, neither chasten me in thine anger."],["3",[["ἐλέησόν",704418,176],["με",708618,163],["κύριε",707996,153],["ὅτι",709803,7],["ἀσθενής",701939,14],["εἰμι",704093,157],["ἴασαί",706424,300],["με",708618,163],["κύριε",707996,153],["ὅτι",709803,7],["ἐταράχθη",712721,37],["τὰ",709436,63],["ὀστᾶ",709792,64],["μου",709032,133]],"Pity me, O Lord; for I am weak: heal me, O Lord; for my bones are vexed."],["4",[["καὶ",707031,7],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ἐταράχθη",712721,37],["σφόδρα",712586,28],["καὶ",707031,7],["σύ",712181,164],["κύριε",707996,153],["ἕως",705792,0],["πότε",710696,11]],"My soul also is grievously vexed: but thou, O Lord, how long?"],["5",[["ἐπίστρεψον",705278,176],["κύριε",707996,153],["ῥῦσαι",711309,300],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["σῶσόν",712627,176],["με",708618,163],["ἕνεκεν",704709,0],["τοῦ",709436,20],["ἐλέους",704426,21],["σου",711945,133]],"Return, O Lord, deliver my soul: save me for thy mercy's sake."],["6",[["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐν",704639,0],["τῷ",709436,113],["θανάτῳ",706096,114],["ὁ",709436,3],["μνημονεύων",708965,72],["σου",711945,133],["ἐν",704639,0],["δὲ",703303,11],["τῷ",709436,113],["ᾅδῃ",700255,114],["τίς",712867,158],["ἐξομολογήσεταί",704960,93],["σοι",711925,159]],"For in death no man remembers thee: and who will give thee thanks in Hades?"],["7",[["ἐκοπίασα",707824,155],["ἐν",704639,0],["τῷ",709436,113],["στεναγμῷ",712065,114],["μου",709032,133],["λούσω",708258,165],["καθ᾿",707200,0],["ἑκάστην",704133,36],["νύκτα",709386,9],["τὴν",709436,8],["κλίνην",707737,9],["μου",709032,133],["ἐν",704639,0],["δάκρυσίν",703255,96],["μου",709032,133],["τὴν",709436,8],["στρωμνήν",712174,9],["μου",709032,133],["βρέξω",702812,165]],"I am wearied with my groaning; I shall wash my bed every night; I shall water my couch with my tears."],["8",[["ἐταράχθη",712721,37],["ἀπὸ",701425,0],["θυμοῦ",706334,18],["ὁ",709436,3],["ὀφθαλμός",709870,4],["μου",709032,133],["ἐπαλαιώθην",709937,156],["ἐν",704639,0],["πᾶσιν",710177,230],["τοῖς",709436,147],["ἐχθροῖς",705779,148],["μου",709032,133]],"Mine eye is troubled because of my wrath; I am worn out because of all my enemies."],["9",[["ἀπόστητε",702214,74],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["πάντες",710177,138],["οἱ",709436,136],["ἐργαζόμενοι",705383,348],["τὴν",709436,8],["ἀνομίαν",701192,9],["ὅτι",709803,7],["εἰσήκουσεν",704108,2],["κύριος",707996,4],["τῆς",709436,16],["φωνῆς",713640,17],["τοῦ",709436,35],["κλαυθμοῦ",707705,18],["μου",709032,133]],"Depart from me, all ye that work iniquity; for the Lord has heard the voice of my weeping."],["10",[["εἰσήκουσεν",704108,2],["κύριος",707996,4],["τῆς",709436,16],["δεήσεώς",703311,17],["μου",709032,133],["κύριος",707996,4],["τὴν",709436,8],["προσευχήν",710892,9],["μου",709032,133],["προσεδέξατο",710874,23]],"The Lord has hearkened to my petition; the Lord has accepted my prayer."],["11",[["αἰσχυνθείησαν",700485,393],["καὶ",707031,7],["ταραχθείησαν",712721,393],["σφόδρα",712586,28],["πάντες",710177,138],["οἱ",709436,136],["ἐχθροί",705779,52],["μου",709032,133],["ἀποστραφείησαν",701598,393],["καὶ",707031,7],["καταισχυνθείησαν",707257,393],["σφόδρα",712586,28],["διὰ",703417,0],["τάχους",712747,21]],"Let all mine enemies be put to shame and sore troubled: let them be turned back and grievously put to shame speedily."]]