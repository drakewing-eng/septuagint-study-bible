[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["τῷ",709436,113],["Δαυιδ",703232,114],["ψαλμὸς",714022,4],["ᾠδῆς",714091,17]],"For the end, a Psalm of a Song by David."],["2",[["ἀναστήτω",701173,45],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["διασκορπισθήτωσαν",703579,51],["οἱ",709436,136],["ἐχθροὶ",705779,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["φυγέτωσαν",713433,264],["οἱ",709436,136],["μισοῦντες",708935,146],["αὐτὸν",702165,85],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102]],"Let God arise, and let his enemies be scattered; and let them that hate him flee from before him."],["3",[["ὡς",714148,7],["ἐκλείπει",704237,91],["καπνός",707132,4],["ἐκλιπέτωσαν",704237,264],["ὡς",714148,7],["τήκεται",712839,117],["κηρὸς",707659,4],["ἀπὸ",701425,0],["προσώπου",710986,21],["πυρός",711088,21],["οὕτως",709859,28],["ἀπόλοιντο",701513,529],["οἱ",709436,136],["ἁμαρτωλοὶ",700776,138],["ἀπὸ",701425,0],["προσώπου",710986,21],["τοῦ",709436,35],["θεοῦ",706192,18]],"As smoke vanishes, let them vanish: as wax melts before the fire, so let the sinners perish from before God."],["4",[["καὶ",707031,7],["οἱ",709436,136],["δίκαιοι",703694,138],["εὐφρανθήτωσαν",705715,51],["ἀγαλλιάσθωσαν",700114,77],["ἐνώπιον",704823,0],["τοῦ",709436,35],["θεοῦ",706192,18],["τερφθήτωσαν",712804,51],["ἐν",704639,0],["εὐφροσύνῃ",705717,1]],"But let the righteous rejoice; let them exult before God: let them be delighted with joy."],["5",[["ᾄσατε",700299,74],["τῷ",709436,113],["θεῷ",706192,114],["ψάλατε",714028,74],["τῷ",709436,53],["ὀνόματι",709666,54],["αὐτοῦ",702165,102],["ὁδοποιήσατε",709456,74],["τῷ",709436,113],["ἐπιβεβηκότι",705082,514],["ἐπὶ",705080,0],["δυσμῶν",703865,65],["κύριος",707996,4],["ὄνομα",709666,15],["αὐτῷ",702165,50],["καὶ",707031,7],["ἀγαλλιᾶσθε",700114,374],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["ταραχθήσονται",712721,144],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102]],"Sing to God, sing praises to his name: make a way for him that rides upon the west (the Lord is his name) and exult before him. They shall be troubled before the face of him,"],["6",[["τοῦ",709436,35],["πατρὸς",710189,18],["τῶν",709436,80],["ὀρφανῶν",709779,169],["καὶ",707031,7],["κριτοῦ",707910,18],["τῶν",709436,130],["χηρῶν",713848,65],["ὁ",709436,3],["θεὸς",706192,4],["ἐν",704639,0],["τόπῳ",712903,114],["ἁγίῳ",700159,30],["αὐτοῦ",702165,102]],"[who is] the father of the orphans, and judge of the widows: [such is] God in his holy place."],["7",[["ὁ",709436,3],["θεὸς",706192,4],["κατοικίζει",707538,91],["μονοτρόπους",709004,60],["ἐν",704639,0],["οἴκῳ",709516,114],["ἐξάγων",704834,72],["πεπεδημένους",710208,458],["ἐν",704639,0],["ἀνδρείᾳ",701101,101],["ὁμοίως",709630,28],["τοὺς",709436,58],["παραπικραίνοντας",710087,235],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["ἐν",704639,0],["τάφοις",712738,148]],"God settles the solitary in a house; leading forth prisoners mightily, also them that act provokingly, [even] them that dwell in tombs."],["8",[["ὁ",709436,3],["θεός",706192,4],["ἐν",704639,0],["τῷ",709436,53],["ἐκπορεύεσθαί",704293,110],["σε",711598,163],["ἐνώπιον",704823,0],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133],["ἐν",704639,0],["τῷ",709436,53],["διαβαίνειν",703419,55],["σε",711598,163],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["διάψαλμα",703641,15]],"O God, when thou wentest forth before thy people, when thou wentest through the wilderness; Pause:"],["9",[["γῆ",703083,12],["ἐσείσθη",711633,37],["καὶ",707031,7],["γὰρ",702963,11],["οἱ",709436,136],["οὐρανοὶ",709844,52],["ἔσταξαν",712038,150],["ἀπὸ",701425,0],["προσώπου",710986,21],["τοῦ",709436,35],["θεοῦ",706192,18],["τοῦτο",709858,132],["Σινα",711794,15],["ἀπὸ",701425,0],["προσώπου",710986,21],["τοῦ",709436,35],["θεοῦ",706192,18],["Ισραηλ",706839,18]],"the earth quaked, yea, the heavens dropped [water] at the presence of the God of Sina, at the presence of the God of Israel."],["10",[["βροχὴν",702819,9],["ἑκούσιον",704269,27],["ἀφοριεῖς",702227,166],["ὁ",709436,3],["θεός",706192,4],["τῇ",709436,100],["κληρονομίᾳ",707725,1],["σου",711945,133],["καὶ",707031,7],["ἠσθένησεν",701938,2],["σὺ",712181,164],["δὲ",703303,11],["κατηρτίσω",707410,174],["αὐτήν",702165,104]],"O God, thou wilt grant to thine inheritance a gracious rain; for it was weary, but thou didst refresh it."],["11",[["τὰ",709436,63],["ζῷά",705916,64],["σου",711945,133],["κατοικοῦσιν",707534,197],["ἐν",704639,0],["αὐτῇ",702165,105],["ἡτοίμασας",705539,162],["ἐν",704639,0],["τῇ",709436,100],["χρηστότητί",713959,1],["σου",711945,133],["τῷ",709436,113],["πτωχῷ",711076,114],["ὁ",709436,3],["θεός",706192,4]],"Thy creatures dwell in it: thou hast in thy goodness prepared for the poor."],["12",[["κύριος",707996,4],["δώσει",703654,127],["ῥῆμα",711246,25],["τοῖς",709436,147],["εὐαγγελιζομένοις",705547,341],["δυνάμει",703839,1],["πολλῇ",710646,101]],"The Lord God will give a word to them that preach [it] in a great company."],["13",[["ὁ",709436,3],["βασιλεὺς",702580,4],["τῶν",709436,130],["δυνάμεων",703839,65],["τοῦ",709436,35],["ἀγαπητοῦ",700124,116],["καὶ",707031,7],["ὡραιότητι",714133,1],["τοῦ",709436,35],["οἴκου",709516,18],["διελέσθαι",703459,109],["σκῦλα",711902,42]],"The king of the forces of the beloved, of the beloved, [will] even [grant them] for the beauty of the house to divide the spoils."],["14",[["ἐὰν",703912,7],["κοιμηθῆτε",707767,394],["ἀνὰ",700902,0],["μέσον",708768,27],["τῶν",709436,80],["κλήρων",707727,81],["πτέρυγες",711057,191],["περιστερᾶς",710391,17],["περιηργυρωμέναι",710292,423],["καὶ",707031,7],["τὰ",709436,41],["μετάφρενα",708824,42],["αὐτῆς",702165,86],["ἐν",704639,0],["χλωρότητι",713881,1],["χρυσίου",713972,21],["διάψαλμα",703641,15]],"Even if ye should lie among the lots, [ye shall have] the wings of a dove covered with silver, and her breast with yellow gold."],["15",[["ἐν",704639,0],["τῷ",709436,53],["διαστέλλειν",703588,55],["τὸν",709436,5],["ἐπουράνιον",705355,27],["βασιλεῖς",702580,52],["ἐπ᾿",705080,0],["αὐτῆς",702165,86],["χιονωθήσονται",713867,144],["ἐν",704639,0],["Σελμων",711659,111]],"When the heavenly One scatters kings upon it, they shall be made snow-white in Selmon."],["16",[["ὄρος",709768,15],["τοῦ",709436,35],["θεοῦ",706192,18],["ὄρος",709768,15],["πῖον",710478,293],["ὄρος",709768,15],["τετυρωμένον",713030,413],["ὄρος",709768,15],["πῖον",710478,293]],"The mountain of God is a rich mountain; a swelling mountain, a rich mountain."],["17",[["ἵνα",706747,7],["τί",712867,126],["ὑπολαμβάνετε",713210,87],["ὄρη",709768,64],["τετυρωμένα",713030,443],["τὸ",709436,34],["ὄρος",709768,15],["ὃ",709781,128],["εὐδόκησεν",705565,2],["ὁ",709436,3],["θεὸς",706192,4],["κατοικεῖν",707534,55],["ἐν",704639,0],["αὐτῷ",702165,50],["καὶ",707031,7],["γὰρ",702963,11],["ὁ",709436,3],["κύριος",707996,4],["κατασκηνώσει",707423,127],["εἰς",704105,0],["τέλος",712787,25]],"Wherefore do ye conceive [evil], ye swelling mountains? [this is] the mountain which God has delighted to dwell in; yea, the Lord will dwell [in it] for ever."],["18",[["τὸ",709436,34],["ἅρμα",701768,15],["τοῦ",709436,35],["θεοῦ",706192,18],["μυριοπλάσιον",709064,26],["χιλιάδες",713858,191],["εὐθηνούντων",705594,170],["ὁ",709436,3],["κύριος",707996,4],["ἐν",704639,0],["αὐτοῖς",702165,151],["ἐν",704639,0],["Σινα",711794,111],["ἐν",704639,0],["τῷ",709436,113],["ἁγίῳ",700159,30]],"The chariots of God are ten thousand fold, thousands of rejoicing ones: the Lord is among them, in Sina, in the holy place."],["19",[["ἀνέβης",700905,162],["εἰς",704105,0],["ὕψος",713288,25],["ᾐχμαλώτευσας",700500,162],["αἰχμαλωσίαν",700499,9],["ἔλαβες",708076,162],["δόματα",703789,42],["ἐν",704639,0],["ἀνθρώπῳ",701163,114],["καὶ",707031,7],["γὰρ",702963,11],["ἀπειθοῦντες",701370,146],["τοῦ",709436,20],["κατασκηνῶσαι",707423,106],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["εὐλογητός",705632,14]],"Thou art gone up on high, thou hast led captivity captive, thou hast received gifts for man, yea, for [they were] rebellious, that thou mightest dwell among them."],["20",[["εὐλογητὸς",705632,14],["κύριος",707996,4],["ἡμέραν",705984,9],["καθ᾿",707200,0],["ἡμέραν",705984,9],["κατευοδώσει",707523,127],["ἡμῖν",705994,90],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,43],["σωτηρίων",712659,44],["ἡμῶν",705999,145],["διάψαλμα",703641,15]],"Blessed be the Lord God, blessed be the Lord daily; and the God of our salvation shall prosper us. Pause.",{"s":"d","q":0.67}],["21",[["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["θεὸς",706192,4],["τοῦ",709436,20],["σῴζειν",712627,55],["καὶ",707031,7],["τοῦ",709436,35],["κυρίου",707996,18],["κυρίου",707996,18],["αἱ",709436,190],["διέξοδοι",703668,191],["τοῦ",709436,35],["θανάτου",706096,18]],"Our God is the God of salvation; and to the Lord belong the issues from death."],["22",[["πλὴν",710540,28],["ὁ",709436,3],["θεὸς",706192,4],["συνθλάσει",712479,127],["κεφαλὰς",707639,39],["ἐχθρῶν",705779,81],["αὐτοῦ",702165,102],["κορυφὴν",707844,9],["τριχὸς",706312,17],["διαπορευομένων",703551,299],["ἐν",704639,0],["πλημμελείαις",710533,76],["αὐτῶν",702165,40]],"But God shall crush the heads of his enemies; the hairy crown of them that go on in their trespasses."],["23",[["εἶπεν",705373,2],["κύριος",707996,4],["ἐκ",704132,0],["Βασαν",702564,118],["ἐπιστρέψω",705278,165],["ἐπιστρέψω",705278,165],["ἐν",704639,0],["βυθοῖς",702830,148],["θαλάσσης",706069,17]],"The Lord said, I will bring again from Basan, I will bring [my people] again through the depths of the sea."],["24",[["ὅπως",709719,7],["ἂν",700900,11],["βαφῇ",702517,384],["ὁ",709436,3],["πούς",710707,4,6],["σου",711945,133],["ἐν",704639,0],["αἵματι",700442,54],["ἡ",709436,10],["γλῶσσα",703120,12],["τῶν",709436,80],["κυνῶν",708004,81],["σου",711945,133],["ἐξ",704132,0],["ἐχθρῶν",705779,81],["παρ᾿",709995,0],["αὐτοῦ",702165,102]],"That thy foot may be dipped in blood, [and] the tongue of thy dogs [be stained] with that of [thine] enemies."],["25",[["ἐθεωρήθησαν",706226,99],["αἱ",709436,190],["πορεῖαί",710665,191],["σου",711945,133],["ὁ",709436,3],["θεός",706192,4],["αἱ",709436,190],["πορεῖαι",710665,191],["τοῦ",709436,35],["θεοῦ",706192,18],["μου",709032,133],["τοῦ",709436,35],["βασιλέως",702580,18],["τοῦ",709436,35],["ἐν",704639,0],["τῷ",709436,113],["ἁγίῳ",700159,30]],"Thy goings, O God, have been seen; the goings of my God, the king, in the sanctuary."],["26",[["προέφθασαν",711011,150],["ἄρχοντες",701862,52],["ἐχόμενοι",705785,348],["ψαλλόντων",714021,170],["ἐν",704639,0],["μέσῳ",708768,30],["νεανίδων",709231,65],["τυμπανιστριῶν",713018,65]],"The princes went first, next before the players on instruments, in the midst of damsels playing on timbrels."],["27",[["ἐν",704639,0],["ἐκκλησίαις",704216,76],["εὐλογεῖτε",705631,87],["τὸν",709436,5],["θεόν",706192,6],["τὸν",709436,5],["κύριον",707996,6],["ἐκ",704132,0],["πηγῶν",710450,65],["Ισραηλ",706839,18]],"Praise God in the congregations, the Lord from the fountains of Israel."],["28",[["ἐκεῖ",704181,28],["Βενιαμιν",702650,4],["νεώτερος",709256,224],["ἐν",704639,0],["ἐκστάσει",704314,1],["ἄρχοντες",701862,52],["Ιουδα",706768,18],["ἡγεμόνες",705930,52],["αὐτῶν",702165,40],["ἄρχοντες",701862,52],["Ζαβουλων",705813,18],["ἄρχοντες",701862,52],["Νεφθαλι",709279,18]],"There is Benjamin the younger [one] in ecstasy, the princes of Juda their rulers, the princes of Zabulon, the princes of Nephthali."],["29",[["ἔντειλαι",704791,300],["ὁ",709436,3],["θεός",706192,4],["τῇ",709436,100],["δυνάμει",703839,1],["σου",711945,133],["δυνάμωσον",703840,176],["ὁ",709436,3],["θεός",706192,4],["τοῦτο",709858,129],["ὃ",709781,128],["κατειργάσω",707515,174],["ἡμῖν",705994,90]],"O God, command thou thy strength: strengthen, O God, this which thou hast wrought in us."],["30",[["ἀπὸ",701425,0],["τοῦ",709436,35],["ναοῦ",709191,18],["σου",711945,133],["ἐπὶ",705080,0],["Ιερουσαλημ",706644,17],["σοὶ",711925,159],["οἴσουσιν",713428,218],["βασιλεῖς",702580,52],["δῶρα",703907,42]],"Because of thy temple at Jerusalem shall kings bring presents to thee."],["31",[["ἐπιτίμησον",705305,176],["τοῖς",709436,95],["θηρίοις",706252,96],["τοῦ",709436,35],["καλάμου",707082,18],["ἡ",709436,10],["συναγωγὴ",712376,12],["τῶν",709436,80],["ταύρων",712734,81],["ἐν",704639,0],["ταῖς",709436,75],["δαμάλεσιν",703271,76],["τῶν",709436,80],["λαῶν",708094,81],["τοῦ",709436,20],["μὴ",708851,28],["ἀποκλεισθῆναι",701484,179],["τοὺς",709436,58],["δεδοκιμασμένους",703776,458],["τῷ",709436,53],["ἀργυρίῳ",701707,54],["διασκόρπισον",703579,176],["ἔθνη",704068,42],["τὰ",709436,41],["τοὺς",709436,58],["πολέμους",710605,57],["θέλοντα",706176,237]],"Rebuke the wild beasts of the reed: let the crowd of bulls with the heifers of the nations [be rebuked], so that they who have been proved with silver may not be shut out: scatter thou the nations that wish for wars."],["32",[["ἥξουσιν",705956,218],["πρέσβεις",710733,52],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["Αἰθιοπία",700419,12],["προφθάσει",711011,127],["χεῖρα",713787,9],["αὐτῆς",702165,86],["τῷ",709436,113],["θεῷ",706192,114]],"Ambassadors shall arrive out of Egypt; Ethiopia shall hasten [to stretch out] her hand readily to God."],["33",[["αἱ",709436,190],["βασιλεῖαι",702577,191],["τῆς",709436,16],["γῆς",703083,17],["ᾄσατε",700299,74],["τῷ",709436,113],["θεῷ",706192,114],["ψάλατε",714028,74],["τῷ",709436,113],["κυρίῳ",707996,114],["διάψαλμα",703641,15]],"Sing to God, ye kingdoms of the earth; sing psalms to the Lord. Pause."],["34",[["ψάλατε",714028,74],["τῷ",709436,113],["θεῷ",706192,114],["τῷ",709436,113],["ἐπιβεβηκότι",705082,514],["ἐπὶ",705080,0],["τὸν",709436,5],["οὐρανὸν",709844,6],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["κατὰ",707200,0],["ἀνατολάς",701071,39],["ἰδοὺ",706497,88],["δώσει",703654,127],["ἐν",704639,0],["τῇ",709436,100],["φωνῇ",713640,1],["αὐτοῦ",702165,102],["φωνὴν",713640,9],["δυνάμεως",703839,17]],"Sing to God that rides on the heaven of heaven, eastward: lo, he will utter a mighty sound with his voice."],["35",[["δότε",703654,74],["δόξαν",703791,9],["τῷ",709436,113],["θεῷ",706192,114],["ἐπὶ",705080,0],["τὸν",709436,5],["Ισραηλ",706839,6],["ἡ",709436,10],["μεγαλοπρέπεια",708632,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἡ",709436,10],["δύναμις",703839,12],["αὐτοῦ",702165,102],["ἐν",704639,0],["ταῖς",709436,75],["νεφέλαις",709277,76]],"Give ye glory to God: his excellency is over Israel, and his power is in the clouds."],["36",[["θαυμαστὸς",706138,14],["ὁ",709436,3],["θεὸς",706192,4],["ἐν",704639,0],["τοῖς",709436,147],["ἁγίοις",700159,230],["αὐτοῦ",702165,102],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["αὐτὸς",702165,121],["δώσει",703654,127],["δύναμιν",703839,9],["καὶ",707031,7],["κραταίωσιν",707878,9],["τῷ",709436,113],["λαῷ",708094,114],["αὐτοῦ",702165,102],["εὐλογητὸς",705632,14],["ὁ",709436,3],["θεός",706192,4]],"God is wonderful in his holy [places], the God of Israel: he will give power and strength to his people: blessed be God."]]