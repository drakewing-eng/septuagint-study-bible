[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["τοῖς",709436,147],["υἱοῖς",713075,148],["Κορε",707833,18],["ψαλμός",714022,4]],"For the end, a Psalm for the sons of Core."],["2",[["εὐδόκησας",705565,162],["κύριε",707996,153],["τὴν",709436,8],["γῆν",703083,9],["σου",711945,133],["ἀπέστρεψας",701598,162],["τὴν",709436,8],["αἰχμαλωσίαν",700499,9],["Ιακωβ",706401,18]],"O Lord, thou hast taken pleasure in thy land: thou hast turned back the captivity of Jacob."],["3",[["ἀφῆκας",702211,162],["τὰς",709436,38],["ἀνομίας",701192,39],["τῷ",709436,113],["λαῷ",708094,114],["σου",711945,133],["ἐκάλυψας",707102,162],["πάσας",710177,119],["τὰς",709436,38],["ἁμαρτίας",700775,39],["αὐτῶν",702165,40],["διάψαλμα",703641,15]],"Thou hast forgiven thy people their transgressions; thou hast covered all their sins. Pause."],["4",[["κατέπαυσας",707365,162],["πᾶσαν",710177,36],["τὴν",709436,8],["ὀργήν",709728,9],["σου",711945,133],["ἀπέστρεψας",701598,162],["ἀπὸ",701425,0],["ὀργῆς",709728,17],["θυμοῦ",706334,18],["σου",711945,133]],"Thou hast caused all thy wrath to cease: thou hast turned from thy fierce anger."],["5",[["ἐπίστρεψον",705278,176],["ἡμᾶς",705981,194],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,43],["σωτηρίων",712659,44],["ἡμῶν",705999,145],["καὶ",707031,7],["ἀπόστρεψον",701598,176],["τὸν",709436,5],["θυμόν",706334,6],["σου",711945,133],["ἀφ᾿",701425,0],["ἡμῶν",705999,145]],"Turn us, O God of our salvation, and turn thine anger away from us."],["6",[["μὴ",708851,28],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ὀργισθήσῃ",709729,364],["ἡμῖν",705994,90],["ἢ",705924,7],["διατενεῖς",703604,166],["τὴν",709436,8],["ὀργήν",709728,9],["σου",711945,133],["ἀπὸ",701425,0],["γενεᾶς",703037,17],["εἰς",704105,0],["γενεάν",703037,9]],"Wouldest thou be angry with us for ever? or wilt thou continue thy wrath from generation to generation?"],["7",[["ὁ",709436,3],["θεός",706192,4],["σὺ",712181,164],["ἐπιστρέψας",705278,182],["ζωώσεις",705918,166],["ἡμᾶς",705981,194],["καὶ",707031,7],["ὁ",709436,3],["λαός",708094,4],["σου",711945,133],["εὐφρανθήσεται",705715,134],["ἐπὶ",705080,0],["σοί",711925,159]],"O God, thou wilt turn and quicken us; and thy people shall rejoice in thee."],["8",[["δεῖξον",703314,176],["ἡμῖν",705994,90],["κύριε",707996,153],["τὸ",709436,24],["ἔλεός",704426,25],["σου",711945,133],["καὶ",707031,7],["τὸ",709436,24],["σωτήριόν",712659,25],["σου",711945,133],["δῴης",703654,657],["ἡμῖν",705994,90]],"Shew us thy mercy, O Lord, and grant us thy salvation."],["9",[["ἀκούσομαι",700587,181],["τί",712867,126],["λαλήσει",708071,127],["ἐν",704639,0],["ἐμοὶ",704577,159],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["ὅτι",709803,7],["λαλήσει",708071,127],["εἰρήνην",704098,9],["ἐπὶ",705080,0],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπὶ",705080,0],["τοὺς",709436,58],["ὁσίους",709782,60],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἐπιστρέφοντας",705278,235],["πρὸς",710844,0],["αὐτὸν",702165,85],["καρδίαν",707141,9]],"I will hear what the Lord God will say concerning me: for he shall speak peace to his people, and to his saints, and to those that turn their heart toward him."],["10",[["πλὴν",710540,28],["ἐγγὺς",703948,28],["τῶν",709436,80],["φοβουμένων",713532,299],["αὐτὸν",702165,85],["τὸ",709436,24],["σωτήριον",712659,25],["αὐτοῦ",702165,102],["τοῦ",709436,35],["κατασκηνῶσαι",707423,106],["δόξαν",703791,9],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ἡμῶν",705999,145]],"Moreover his salvation is near them that fear him; that glory may dwell in our land."],["11",[["ἔλεος",704426,4],["καὶ",707031,7],["ἀλήθεια",700656,12],["συνήντησαν",712394,150],["δικαιοσύνη",703695,12],["καὶ",707031,7],["εἰρήνη",704098,12],["κατεφίλησαν",707476,150]],"Mercy and truth are met together: righteousness and peace have kissed [each other]."],["12",[["ἀλήθεια",700656,12],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17],["ἀνέτειλεν",701066,2],["καὶ",707031,7],["δικαιοσύνη",703695,12],["ἐκ",704132,0],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["διέκυψεν",703491,2]],"Truth has sprung out of the earth; and righteousness has looked down from heaven."],["13",[["καὶ",707031,7],["γὰρ",702963,11],["ὁ",709436,3],["κύριος",707996,4],["δώσει",703654,127],["χρηστότητα",713959,39],["καὶ",707031,7],["ἡ",709436,10],["γῆ",703083,12],["ἡμῶν",705999,145],["δώσει",703654,127],["τὸν",709436,5],["καρπὸν",707169,6],["αὐτῆς",702165,86]],"For the Lord will give goodness; and our land shall yield her fruit."],["14",[["δικαιοσύνη",703695,12],["ἐναντίον",704654,0],["αὐτοῦ",702165,102],["προπορεύσεται",710839,93],["καὶ",707031,7],["θήσει",712849,127],["εἰς",704105,0],["ὁδὸν",709458,9],["τὰ",709436,41],["διαβήματα",703422,42],["αὐτοῦ",702165,102]],"Righteousness shall go before him; and shall set his steps in the way."]]