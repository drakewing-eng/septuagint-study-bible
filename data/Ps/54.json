[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ἐν",704639,0],["ὕμνοις",713089,148],["συνέσεως",712460,17],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, among Hymns of instruction by David."],["2",[["ἐνώτισαι",704825,300],["ὁ",709436,3],["θεός",706192,4],["τὴν",709436,8],["προσευχὴν",710892,9],["μου",709032,133],["καὶ",707031,7],["μὴ",708851,28],["ὑπερίδῃς",713154,175],["τὴν",709436,8],["δέησίν",703311,9],["μου",709032,133]],"Hearken, O God, to my prayer; and disregard not my supplication."],["3",[["πρόσχες",710895,176],["μοι",708974,159],["καὶ",707031,7],["εἰσάκουσόν",704108,176],["μου",709032,133],["ἐλυπήθην",708272,156],["ἐν",704639,0],["τῇ",709436,100],["ἀδολεσχίᾳ",700282,1],["μου",709032,133],["καὶ",707031,7],["ἐταράχθην",712721,156]],"Attend to me, and hearken to me: I was grieved in my meditation, and troubled;"],["4",[["ἀπὸ",701425,0],["φωνῆς",713640,17],["ἐχθροῦ",705779,18],["καὶ",707031,7],["ἀπὸ",701425,0],["θλίψεως",706276,17],["ἁμαρτωλοῦ",700776,116],["ὅτι",709803,7],["ἐξέκλιναν",704220,150],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ἀνομίαν",701192,9],["καὶ",707031,7],["ἐν",704639,0],["ὀργῇ",709728,1],["ἐνεκότουν",703985,137],["μοι",708974,159]],"because of the voice of the enemy, and because of the oppression of the sinner: for they brought iniquity against me, and were wrathfully angry with me."],["5",[["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["ἐταράχθη",712721,37],["ἐν",704639,0],["ἐμοί",704577,159],["καὶ",707031,7],["δειλία",703319,12],["θανάτου",706096,18],["ἐπέπεσεν",705225,2],["ἐπ᾿",705080,0],["ἐμέ",704555,163]],"My heart was troubled within me; and the fear of death fell upon me."],["6",[["φόβος",713534,4],["καὶ",707031,7],["τρόμος",712975,4],["ἦλθεν",705453,2],["ἐπ᾿",705080,0],["ἐμέ",704555,163],["καὶ",707031,7],["ἐκάλυψέν",707102,2],["με",708618,163],["σκότος",711889,25]],"Fear and trembling came upon me, and darkness covered me."],["7",[["καὶ",707031,7],["εἶπα",705373,155],["τίς",712867,158],["δώσει",703654,127],["μοι",708974,159],["πτέρυγας",711057,39],["ὡσεὶ",714159,7],["περιστερᾶς",710391,17],["καὶ",707031,7],["πετασθήσομαι",710435,180],["καὶ",707031,7],["καταπαύσω",707365,165]],"And I said, O that I had wings as [those] of a dove! then would I flee away, and be at rest."],["8",[["ἰδοὺ",706497,88],["ἐμάκρυνα",708428,155],["φυγαδεύων",713606,72],["καὶ",707031,7],["ηὐλίσθην",702138,156],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["διάψαλμα",703641,15]],"Lo! I have fled afar off, and lodged in the wilderness. Pause."],["9",[["προσεδεχόμην",710874,334],["τὸν",709436,5],["σῴζοντά",712627,183],["με",708618,163],["ἀπὸ",701425,0],["ὀλιγοψυχίας",709573,17],["καὶ",707031,7],["καταιγίδος",707254,17]],"I waited for him that should deliver me from distress of spirit and tempest."],["10",[["καταπόντισον",707385,176],["κύριε",707996,153],["καὶ",707031,7],["καταδίελε",707240,176],["τὰς",709436,38],["γλώσσας",703120,39],["αὐτῶν",702165,40],["ὅτι",709803,7],["εἶδον",709725,155],["ἀνομίαν",701192,9],["καὶ",707031,7],["ἀντιλογίαν",701249,9],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1]],"Destroy, O Lord, and divide their tongues: for I have seen iniquity and gainsaying in the city."],["11",[["ἡμέρας",705984,17],["καὶ",707031,7],["νυκτὸς",709386,17],["κυκλώσει",707958,127],["αὐτὴν",702165,104],["ἐπὶ",705080,0],["τὰ",709436,41],["τείχη",712759,42],["αὐτῆς",702165,86],["ἀνομία",701192,12],["καὶ",707031,7],["κόπος",707825,4],["ἐν",704639,0],["μέσῳ",708768,30],["αὐτῆς",702165,86],["καὶ",707031,7],["ἀδικία",700271,12]],"Day and night he shall go round about it upon its walls: iniquity and sorrow and unrighteousness [are] in the midst of it;"],["12",[["καὶ",707031,7],["οὐκ",709805,28],["ἐξέλιπεν",704237,2],["ἐκ",704132,0],["τῶν",709436,130],["πλατειῶν",710509,198],["αὐτῆς",702165,86],["τόκος",712882,4],["καὶ",707031,7],["δόλος",703787,4]],"and usury and craft have not failed from its streets."],["13",[["ὅτι",709803,7],["εἰ",704071,7],["ἐχθρὸς",705779,4],["ὠνείδισέν",709655,2],["με",708618,163],["ὑπήνεγκα",713256,155],["ἄν",700900,11],["καὶ",707031,7],["εἰ",704071,7],["ὁ",709436,3],["μισῶν",708935,72],["με",708618,163],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ἐμεγαλορρημόνησεν",708637,2],["ἐκρύβην",707923,156],["ἂν",700900,11],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102]],"For if an enemy had reproached me, I would have endured it; and if one who hated [me] had spoken vauntingly against me, I would have hid myself from him."],["14",[["σὺ",712181,164],["δέ",703303,11],["ἄνθρωπε",701163,153],["ἰσόψυχε",706836,564],["ἡγεμών",705930,153],["μου",709032,133],["καὶ",707031,7],["γνωστέ",703141,564],["μου",709032,133]],"But thou, O man likeminded, my guide, and my acquaintance,"],["15",[["ὃς",709781,213],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτό",702165,129],["μοι",708974,159],["ἐγλύκανας",703110,162],["ἐδέσματα",704032,42],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐπορεύθημεν",710667,485],["ἐν",704639,0],["ὁμονοίᾳ",709639,1]],"who in companionship with me sweetened [our] food: we walked in the house of God in concord."],["16",[["ἐλθέτω",705453,45],["θάνατος",706096,4],["ἐπ᾿",705080,0],["αὐτούς",702165,62],["καὶ",707031,7],["καταβήτωσαν",707202,264],["εἰς",704105,0],["ᾅδου",700255,18],["ζῶντες",705851,146],["ὅτι",709803,7],["πονηρίαι",710659,191],["ἐν",704639,0],["ταῖς",709436,75],["παροικίαις",710158,76],["αὐτῶν",702165,40],["ἐν",704639,0],["μέσῳ",708768,30],["αὐτῶν",702165,40]],"Let death come upon them, and let them go down alive into Hades, for iniquity is in their dwellings, in the midst of them."],["17",[["ἐγὼ",704018,164],["δὲ",703303,11],["πρὸς",710844,0],["τὸν",709436,5],["θεὸν",706192,6],["ἐκέκραξα",707868,155],["καὶ",707031,7],["ὁ",709436,3],["κύριος",707996,4],["εἰσήκουσέν",704108,2],["μου",709032,133]],"I cried to God, and the Lord hearkened to me."],["18",[["ἑσπέρας",705500,17],["καὶ",707031,7],["πρωὶ",711021,28],["καὶ",707031,7],["μεσημβρίας",708758,17],["διηγήσομαι",703679,181],["ἀπαγγελῶ",701321,165],["καὶ",707031,7],["εἰσακούσεται",704108,93],["τῆς",709436,16],["φωνῆς",713640,17],["μου",709032,133]],"Evening, and morning, and at noon I will declare and make known [my wants]: and he shall hear my voice."],["19",[["λυτρώσεται",708282,93],["ἐν",704639,0],["εἰρήνῃ",704098,1],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἀπὸ",701425,0],["τῶν",709436,80],["ἐγγιζόντων",703939,170],["μοι",708974,159],["ὅτι",709803,7],["ἐν",704639,0],["πολλοῖς",710646,230],["ἦσαν",704093,137],["σὺν",712372,0],["ἐμοί",704577,159]],"He shall deliver my soul in peace from them that draw nigh to me: for they were with me in many [cases]."],["20",[["εἰσακούσεται",704108,93],["ὁ",709436,3],["θεὸς",706192,4],["καὶ",707031,7],["ταπεινώσει",712717,127],["αὐτούς",702165,62],["ὁ",709436,3],["ὑπάρχων",713104,72],["πρὸ",710747,0],["τῶν",709436,80],["αἰώνων",700504,81],["διάψαλμα",703641,15],["οὐ",709805,28],["γάρ",702963,11],["ἐστιν",704093,91],["αὐτοῖς",702165,151],["ἀντάλλαγμα",701209,15],["καὶ",707031,7],["οὐκ",709805,28],["ἐφοβήθησαν",713532,99],["τὸν",709436,5],["θεόν",706192,6]],"God shall hear, and bring them low, [even] he that has existed from eternity. Pause. For they suffer no reverse, and [therefore] they have not feared God."],["21",[["ἐξέτεινεν",704322,2],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,53],["ἀποδιδόναι",701449,55],["ἐβεβήλωσαν",702614,150],["τὴν",709436,8],["διαθήκην",703456,9],["αὐτοῦ",702165,102]],"He has reached forth his hand for retribution; they have profaned his covenant."],["22",[["διεμερίσθησαν",703518,99],["ἀπὸ",701425,0],["ὀργῆς",709728,17],["τοῦ",709436,20],["προσώπου",710986,21],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἤγγισεν",703939,2],["ἡ",709436,10],["καρδία",707141,12],["αὐτοῦ",702165,102],["ἡπαλύνθησαν",701338,99],["οἱ",709436,136],["λόγοι",708236,52],["αὐτοῦ",702165,102],["ὑπὲρ",713111,0],["ἔλαιον",704380,25],["καὶ",707031,7],["αὐτοί",702165,201],["εἰσιν",704093,197],["βολίδες",702756,191]],"They were scattered at the anger of his countenance, and his heart drew nigh them. His words were smoother than oil, yet are they darts."],["23",[["ἐπίρριψον",705238,176],["ἐπὶ",705080,0],["κύριον",707996,6],["τὴν",709436,8],["μέριμνάν",708745,9],["σου",711945,133],["καὶ",707031,7],["αὐτός",702165,121],["σε",711598,163],["διαθρέψει",703613,127],["οὐ",709805,28],["δώσει",703654,127],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["σάλον",711420,6],["τῷ",709436,113],["δικαίῳ",703694,30]],"Cast thy care upon the Lord, and he shall sustain thee; he shall never suffer the righteous to be moved."],["24",[["σὺ",712181,164],["δέ",703303,11],["ὁ",709436,3],["θεός",706192,4],["κατάξεις",707232,166],["αὐτοὺς",702165,62],["εἰς",704105,0],["φρέαρ",713576,25],["διαφθορᾶς",703625,17],["ἄνδρες",701150,52],["αἱμάτων",700442,44],["καὶ",707031,7],["δολιότητος",703784,17],["οὐ",709805,28],["μὴ",708851,28],["ἡμισεύσωσιν",705997,234],["τὰς",709436,38],["ἡμέρας",705984,39],["αὐτῶν",702165,40],["ἐγὼ",704018,164],["δὲ",703303,11],["ἐλπιῶ",704529,165],["ἐπὶ",705080,0],["σέ",711598,163],["κύριε",707996,153]],"But thou, O God, shalt bring them down to the pit of destruction; bloody and crafty men shall not live out half their days; but I will hope in thee, O Lord."]]