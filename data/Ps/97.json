[["1",[["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114],["ᾄσατε",700299,74],["τῷ",709436,113],["κυρίῳ",707996,114],["ᾆσμα",701970,25],["καινόν",707042,27],["ὅτι",709803,7],["θαυμαστὰ",706138,68],["ἐποίησεν",710582,2],["κύριος",707996,4],["ἔσωσεν",712627,2],["αὐτῷ",702165,50],["ἡ",709436,10],["δεξιὰ",703360,68],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὁ",709436,3],["βραχίων",702808,4],["ὁ",709436,3],["ἅγιος",700159,14],["αὐτοῦ",702165,102]],"A Psalm of David. Sing to the Lord a new song; for the Lord has wrought wonderful works, his right hand, and his holy arm, have wrought salvation for him."],["2",[["ἐγνώρισεν",703135,2],["κύριος",707996,4],["τὸ",709436,24],["σωτήριον",712659,25],["αὐτοῦ",702165,102],["ἐναντίον",704654,0],["τῶν",709436,43],["ἐθνῶν",704068,44],["ἀπεκάλυψεν",701474,2],["τὴν",709436,8],["δικαιοσύνην",703695,9],["αὐτοῦ",702165,102]],"The Lord has made known his salvation, he has revealed his righteousness in the sight of the nations."],["3",[["ἐμνήσθη",708960,37],["τοῦ",709436,20],["ἐλέους",704426,21],["αὐτοῦ",702165,102],["τῷ",709436,113],["Ιακωβ",706401,114],["καὶ",707031,7],["τῆς",709436,16],["ἀληθείας",700656,17],["αὐτοῦ",702165,102],["τῷ",709436,113],["οἴκῳ",709516,114],["Ισραηλ",706839,18],["εἴδοσαν",709725,150],["πάντα",710177,195],["τὰ",709436,63],["πέρατα",710281,64],["τῆς",709436,16],["γῆς",703083,17],["τὸ",709436,24],["σωτήριον",712659,25],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145]],"He has remembered his mercy to Jacob, and his truth to the house of Israel; all the ends of the earth have seen the salvation of our God."],["4",[["ἀλαλάξατε",700632,74],["τῷ",709436,113],["θεῷ",706192,114],["πᾶσα",710177,29],["ἡ",709436,10],["γῆ",703083,12],["ᾄσατε",700299,74],["καὶ",707031,7],["ἀγαλλιᾶσθε",700114,374],["καὶ",707031,7],["ψάλατε",714021,74]],"Shout to God, all the earth; sing, and exult, and sing psalms."],["5",[["ψάλατε",714021,74],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐν",704639,0],["κιθάρᾳ",707669,1],["ἐν",704639,0],["κιθάρᾳ",707669,1],["καὶ",707031,7],["φωνῇ",713640,1],["ψαλμοῦ",714022,18]],"Sing to the Lord with a harp, with a harp, and the voice of a psalm."],["6",[["ἐν",704639,0],["σάλπιγξιν",711424,76],["ἐλαταῖς",704389,76],["καὶ",707031,7],["φωνῇ",713640,1],["σάλπιγγος",711424,17],["κερατίνης",707629,17],["ἀλαλάξατε",700632,74],["ἐνώπιον",704823,0],["τοῦ",709436,35],["βασιλέως",702580,18],["κυρίου",707996,18]],"With trumpets of metal, and the sound of a trumpet of horn make a joyful noise to the Lord before the king."],["7",[["σαλευθήτω",711403,22],["ἡ",709436,10],["θάλασσα",706069,12],["καὶ",707031,7],["τὸ",709436,34],["πλήρωμα",710544,15],["αὐτῆς",702165,86],["ἡ",709436,10],["οἰκουμένη",709517,211],["καὶ",707031,7],["οἱ",709436,136],["κατοικοῦντες",707534,146],["ἐν",704639,0],["αὐτῇ",702165,105]],"Let the sea be moved, and the fulness of it; the world, and they that dwell in it."],["8",[["ποταμοὶ",710693,52],["κροτήσουσιν",707918,218],["χειρὶ",713787,1],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτό",702165,129],["τὰ",709436,41],["ὄρη",709768,42],["ἀγαλλιάσονται",700114,135]],"The rivers shall clap their hands together; the mountains shall exult."],["9",[["ὅτι",709803,7],["ἥκει",705956,91],["κρῖναι",707905,106],["τὴν",709436,8],["γῆν",703083,9],["κρινεῖ",707905,127],["τὴν",709436,8],["οἰκουμένην",709517,173],["ἐν",704639,0],["δικαιοσύνῃ",703695,1],["καὶ",707031,7],["λαοὺς",708094,57],["ἐν",704639,0],["εὐθύτητι",705603,1]],"For he is come to judge the earth; he shall judge the world in righteousness, and the nations in uprightness."]]