[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114]],null,{"s":"h"}],["2",[["ἐξελοῦ",704838,176],["με",708618,163],["κύριε",707996,153],["ἐξ",704132,0],["ἀνθρώπου",701163,18],["πονηροῦ",710660,116],["ἀπὸ",701425,0],["ἀνδρὸς",701150,18],["ἀδίκου",700272,116],["ῥῦσαί",711309,176],["με",708618,163]],"Rescue me, O Lord, from the evil man; deliver me from the unjust man."],["3",[["οἵτινες",709793,450],["ἐλογίσαντο",708232,189],["ἀδικίας",700271,39],["ἐν",704639,0],["καρδίᾳ",707141,1],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["παρετάσσοντο",710108,139],["πολέμους",710605,57]],"Who have devised injustice in their hearts; all the day they prepared war."],["4",[["ἠκόνησαν",700570,150],["γλῶσσαν",703120,9],["αὐτῶν",702165,565],["ὡσεὶ",714159,28],["ὄφεως",709875,18],["ἰὸς",706764,4],["ἀσπίδων",701991,65],["ὑπὸ",713184,0],["τὰ",709436,41],["χείλη",713781,42],["αὐτῶν",702165,565],["διάψαλμα",703641,15]],"They have sharpened their tongue as [the tongue] of a serpent; the poison of asps is under their lips. Pause."],["5",[["φύλαξόν",713619,176],["με",708618,163],["κύριε",707996,153],["ἐκ",704132,0],["χειρὸς",713787,17],["ἁμαρτωλοῦ",700776,116],["ἀπὸ",701425,0],["ἀνθρώπων",701163,81],["ἀδίκων",700272,169],["ἐξελοῦ",704838,300],["με",708618,163],["οἵτινες",709793,450],["ἐλογίσαντο",708232,189],["ὑποσκελίσαι",713239,106],["τὰ",709436,41],["διαβήματά",703422,42],["μου",709032,133]],"Keep me, O Lord, from the hand of the sinner; rescue me from unjust men; who have purposed to overthrow my goings."],["6",[["ἔκρυψαν",707923,150],["ὑπερήφανοι",713139,138],["παγίδα",709910,9],["μοι",708974,159],["καὶ",707031,7],["σχοινία",712610,42],["διέτειναν",703604,150],["παγίδας",709910,39],["τοῖς",709436,147],["ποσίν",710707,148],["μου",709032,133],["ἐχόμενα",705785,67],["τρίβου",712939,17],["σκάνδαλον",711825,25],["ἔθεντό",712849,189],["μοι",708974,159],["διάψαλμα",703641,15]],"The proud have hid a snare for me, and have stretched out ropes [for] snares for my feet; they set a stumbling-block for me near the path. Pause."],["7",[["εἶπα",705373,155],["τῷ",709436,113],["κυρίῳ",707996,114],["θεός",706192,4],["μου",709032,133],["εἶ",704093,154],["σύ",712181,164],["ἐνώτισαι",704825,176],["κύριε",707996,153],["τὴν",709436,8],["φωνὴν",713640,9],["τῆς",709436,16],["δεήσεώς",703311,17],["μου",709032,133]],"I said to the Lord, Thou art my God; hearken, O Lord, to the voice of my supplication."],["8",[["κύριε",707996,153],["κύριε",707996,153],["δύναμις",703839,12],["τῆς",709436,16],["σωτηρίας",712658,17],["μου",709032,133],["ἐπεσκίασας",705253,162],["ἐπὶ",705080,0],["τὴν",709436,8],["κεφαλήν",707639,9],["μου",709032,133],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["πολέμου",710605,18]],"O Lord God, the strength of my salvation; thou hast screened my head in the day of battle."],["9",[["μὴ",708851,28],["παραδῷς",710014,175],["με",708618,163],["κύριε",707996,153],["ἀπὸ",701425,0],["τῆς",709436,16],["ἐπιθυμίας",705147,17],["μου",709032,133],["ἁμαρτωλῷ",700776,30],["διελογίσαντο",703505,189],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["μὴ",708851,28],["ἐγκαταλίπῃς",703967,175],["με",708618,163],["μήποτε",708882,28],["ὑψωθῶσιν",713289,272],["διάψαλμα",703641,15]],"Deliver me not, O Lord, to the sinner, according to my desire: they have devised [mischief] against me; forsake me not, lest they should be exalted. Pause."],["10",[["ἡ",709436,10],["κεφαλὴ",707639,12],["τοῦ",709436,20],["κυκλώματος",707960,21],["αὐτῶν",702165,565],["κόπος",707825,4],["τῶν",709436,43],["χειλέων",713781,44],["αὐτῶν",702165,565],["καλύψει",707102,127],["αὐτούς",702165,622]],"[As for] the head of them that compass me, the mischief of their lips shall cover them."],["11",[["πεσοῦνται",710481,135],["ἐπ᾿",705080,0],["αὐτοὺς",702165,622],["ἄνθρακες",701160,52],["ἐν",704639,0],["πυρὶ",711088,54],["καταβαλεῖς",707203,166],["αὐτούς",702165,622],["ἐν",704639,0],["ταλαιπωρίαις",712695,76],["οὐ",709805,28],["μὴ",708851,28],["ὑποστῶσιν",713281,234]],"Coals of fire shall fall upon them on the earth; and thou shalt cast them down in afflictions: they shall not bear up [under them].",{"s":"d","q":0.62}],["12",[["ἀνὴρ",701150,4],["γλωσσώδης",703125,14],["οὐ",709805,28],["κατευθυνθήσεται",707521,134],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ἄνδρα",701150,6],["ἄδικον",700272,27],["κακὰ",707066,195],["θηρεύσει",706246,127],["εἰς",704105,0],["διαφθοράν",703625,9]],"A talkative man shall not prosper on the earth: evils shall hunt the unrighteous man to destruction."],["13",[["ἔγνων",703105,155],["ὅτι",709803,7],["ποιήσει",710582,127],["κύριος",707996,4],["τὴν",709436,8],["κρίσιν",707908,9],["τοῦ",709436,35],["πτωχοῦ",711076,18],["καὶ",707031,7],["τὴν",709436,8],["δίκην",703702,9],["τῶν",709436,80],["πενήτων",710248,81]],"I know that the Lord will maintain the cause of the poor, and the right of the needy ones."],["14",[["πλὴν",710540,28],["δίκαιοι",703694,138],["ἐξομολογήσονται",704960,135],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["καὶ",707031,7],["κατοικήσουσιν",707534,218],["εὐθεῖς",705602,138],["σὺν",712372,0],["τῷ",709436,53],["προσώπῳ",710986,54],["σου",711945,133]],"Surely the righteous shall give thanks to thy name: the upright shall dwell in thy presence."]]