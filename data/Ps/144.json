[["1",[["αἴνεσις",700457,12],["τῷ",709436,113],["Δαυιδ",703232,114],["ὑψώσω",713289,165],["σε",711598,163],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["ὁ",709436,3],["βασιλεύς",702580,4],["μου",709032,133],["καὶ",707031,7],["εὐλογήσω",705631,207],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18]],"David's [Psalm of] praise. I will exalt thee, my God, my king; and I will bless thy name for ever and ever."],["2",[["καθ᾿",707200,0],["ἑκάστην",704133,36],["ἡμέραν",705984,9],["εὐλογήσω",705631,207],["σε",711598,163],["καὶ",707031,7],["αἰνέσω",700459,207],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18]],"Every day will I bless thee, and I will praise thy name for ever and ever."],["3",[["μέγας",708653,14],["κύριος",707996,4],["καὶ",707031,7],["αἰνετὸς",700458,14],["σφόδρα",712586,28],["καὶ",707031,7],["τῆς",709436,16],["μεγαλωσύνης",708652,17],["αὐτοῦ",702165,559],["οὐκ",709805,28],["ἔστιν",704093,91],["πέρας",710281,15]],"The Lord is great, and greatly to be praised; and there is no end of his greatness."],["4",[["γενεὰ",703037,12],["καὶ",707031,7],["γενεὰ",703037,12],["ἐπαινέσει",705000,127],["τὰ",709436,41],["ἔργα",705396,42],["σου",711945,133],["καὶ",707031,7],["τὴν",709436,8],["δύναμίν",703839,9],["σου",711945,133],["ἀπαγγελοῦσιν",701321,218]],"Generation after generation shall praise thy works, and tell of thy power."],["5",[["τὴν",709436,8],["μεγαλοπρέπειαν",708632,9],["τῆς",709436,16],["δόξης",703791,17],["τῆς",709436,16],["ἁγιωσύνης",700161,17],["σου",711945,133],["λαλήσουσιν",708071,218],["καὶ",707031,7],["τὰ",709436,41],["θαυμάσιά",706136,68],["σου",711945,133],["διηγήσονται",703679,135]],"And they shall speak of the glorious majesty of thy holiness, and recount thy wonders."],["6",[["καὶ",707031,7],["τὴν",709436,8],["δύναμιν",703839,9],["τῶν",709436,80],["φοβερῶν",713530,169],["σου",711945,133],["ἐροῦσιν",705415,218],["καὶ",707031,7],["τὴν",709436,8],["μεγαλωσύνην",708652,9],["σου",711945,133],["διηγήσονται",703679,135]],"And they shall speak of the power of thy terrible [acts]; and recount thy greatness."],["7",[["μνήμην",708964,9],["τοῦ",709436,20],["πλήθους",710529,21],["τῆς",709436,16],["χρηστότητός",713959,17],["σου",711945,133],["ἐξερεύξονται",704904,135],["καὶ",707031,7],["τῇ",709436,100],["δικαιοσύνῃ",703695,1],["σου",711945,133],["ἀγαλλιάσονται",700114,135]],"They shall utter the memory of the abundance of thy goodness, and shall exult in thy righteousness."],["8",[["οἰκτίρμων",709520,81],["καὶ",707031,7],["ἐλεήμων",704422,14],["ὁ",709436,3],["κύριος",707996,4],["μακρόθυμος",708420,14],["καὶ",707031,7],["πολυέλεος",710624,14]],"The Lord is compassionate, and merciful; long-suffering, and abundant in mercy."],["9",[["χρηστὸς",713958,14],["κύριος",707996,4],["τοῖς",709436,147],["σύμπασιν",712324,230],["καὶ",707031,7],["οἱ",709436,136],["οἰκτιρμοὶ",709520,52],["αὐτοῦ",702165,559],["ἐπὶ",705080,0],["πάντα",710177,27],["τὰ",709436,41],["ἔργα",705396,42],["αὐτοῦ",702165,559]],"The Lord is good to those that wait [on him]; and his compassions are over all his works."],["10",[["ἐξομολογησάσθωσάν",704960,486],["σοι",711925,159],["κύριε",707996,153],["πάντα",710177,27],["τὰ",709436,41],["ἔργα",705396,42],["σου",711945,133],["καὶ",707031,7],["οἱ",709436,136],["ὅσιοί",709782,138],["σου",711945,133],["εὐλογησάτωσάν",705631,264],["σε",711598,163]],"Let all thy works, O Lord, give thanks to thee; and let thy saints bless thee."],["11",[["δόξαν",703791,9],["τῆς",709436,16],["βασιλείας",702577,17],["σου",711945,133],["ἐροῦσιν",705415,218],["καὶ",707031,7],["τὴν",709436,8],["δυναστείαν",703841,9],["σου",711945,133],["λαλήσουσιν",708071,218]],"They shall speak of the glory of thy kingdom, and talk of thy dominion;"],["12",[["τοῦ",709436,20],["γνωρίσαι",703135,106],["τοῖς",709436,147],["υἱοῖς",713075,148],["τῶν",709436,80],["ἀνθρώπων",701163,81],["τὴν",709436,8],["δυναστείαν",703841,9],["σου",711945,133],["καὶ",707031,7],["τὴν",709436,8],["δόξαν",703791,9],["τῆς",709436,16],["μεγαλοπρεπείας",708632,17],["τῆς",709436,16],["βασιλείας",702577,17],["σου",711945,133]],"to make known to the sons of men thy power, and the glorious majesty of thy kingdom."],["13",[["ἡ",709436,10],["βασιλεία",702577,12],["σου",711945,133],["βασιλεία",702577,12],["πάντων",710177,169],["τῶν",709436,80],["αἰώνων",700504,81],["καὶ",707031,7],["ἡ",709436,10],["δεσποτεία",703377,12],["σου",711945,133],["ἐν",704639,0],["πάσῃ",710177,101],["γενεᾷ",703037,1],["καὶ",707031,7],["γενεᾷ",703037,1]],"Thy kingdom is an everlasting kingdom, and thy dominion [endures] through all generations."],["13a",[["πιστὸς",710486,14],["κύριος",707996,4],["ἐν",704639,0],["τοῖς",709436,147],["λόγοις",708236,148],["αὐτοῦ",702165,559],["καὶ",707031,7],["ὅσιος",709782,14],["ἐν",704639,0],["πᾶσι",710177,230],["τοῖς",709436,95],["ἔργοις",705396,96],["αὐτοῦ",702165,559]],null],["14",[["ὑποστηρίζει",713245,91],["κύριος",707996,4],["πάντας",710177,60],["τοὺς",709436,58],["καταπίπτοντας",707375,235],["καὶ",707031,7],["ἀνορθοῖ",701197,91],["πάντας",710177,60],["τοὺς",709436,58],["κατερραγμένους",707407,360]],"The Lord supports all that are falling, and sets up all that are broken down."],["15",[["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["πάντων",710177,169],["εἰς",704105,0],["σὲ",711598,163],["ἐλπίζουσιν",704529,197],["καὶ",707031,7],["σὺ",712181,164],["δίδως",703654,154],["τὴν",709436,8],["τροφὴν",712984,9],["αὐτῶν",702165,565],["ἐν",704639,0],["εὐκαιρίᾳ",705611,1]],"The eyes of all wait upon thee; and thou givest [them] their food in due season."],["16",[["ἀνοίγεις",701186,154],["σὺ",712181,164],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133],["καὶ",707031,7],["ἐμπιπλᾷς",704592,154],["πᾶν",710177,46],["ζῷον",705916,25],["εὐδοκίας",705566,17]],"Thou openest thine hands, and fillest every living thing with pleasure."],["17",[["δίκαιος",703694,14],["κύριος",707996,4],["ἐν",704639,0],["πάσαις",710177,291],["ταῖς",709436,75],["ὁδοῖς",709458,76],["αὐτοῦ",702165,559],["καὶ",707031,7],["ὅσιος",709782,14],["ἐν",704639,0],["πᾶσιν",710177,94],["τοῖς",709436,95],["ἔργοις",705396,96],["αὐτοῦ",702165,559]],"The Lord is righteous in all his ways, and holy in all his works."],["18",[["ἐγγὺς",703948,28],["κύριος",707996,4],["πᾶσιν",710177,230],["τοῖς",709436,147],["ἐπικαλουμένοις",705153,341],["αὐτόν",702165,556],["πᾶσι",710177,230],["τοῖς",709436,147],["ἐπικαλουμένοις",705153,341],["αὐτὸν",702165,556],["ἐν",704639,0],["ἀληθείᾳ",700656,1]],"The Lord is near to all that call upon him, to all that call upon him in truth."],["19",[["θέλημα",706170,25],["τῶν",709436,80],["φοβουμένων",713532,299],["αὐτὸν",702165,556],["ποιήσει",710582,127],["καὶ",707031,7],["τῆς",709436,16],["δεήσεως",703311,17],["αὐτῶν",702165,565],["ἐπακούσεται",705009,93],["καὶ",707031,7],["σώσει",712627,127],["αὐτούς",702165,622]],"He will perform the desire of them that fear him: and he will hear their supplication, and save them."],["20",[["φυλάσσει",713619,91],["κύριος",707996,4],["πάντας",710177,60],["τοὺς",709436,58],["ἀγαπῶντας",700120,235],["αὐτὸν",702165,556],["καὶ",707031,7],["πάντας",710177,60],["τοὺς",709436,58],["ἁμαρτωλοὺς",700776,60],["ἐξολεθρεύσει",704956,127]],"The Lord preserves all that love him: but all sinners he will utterly destroy."],["21",[["αἴνεσιν",700457,9],["κυρίου",707996,18],["λαλήσει",708071,127],["τὸ",709436,34],["στόμα",712125,15],["μου",709032,133],["καὶ",707031,7],["εὐλογείτω",705631,31],["πᾶσα",710177,29],["σὰρξ",711537,12],["τὸ",709436,24],["ὄνομα",709666,25],["τὸ",709436,24],["ἅγιον",700159,27],["αὐτοῦ",702165,559],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18]],"My mouth shall speak the praise of the Lord: and let all flesh bless his holy name for ever and ever."]]