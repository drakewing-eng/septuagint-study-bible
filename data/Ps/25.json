[["1",[["τοῦ",709436,35],["Δαυιδ",703232,18],["κρῖνόν",707905,176],["με",708618,163],["κύριε",707996,153],["ὅτι",709803,7],["ἐγὼ",704018,164],["ἐν",704639,0],["ἀκακίᾳ",700511,1],["μου",709032,133],["ἐπορεύθην",710667,156],["καὶ",707031,7],["ἐπὶ",705080,0],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐλπίζων",704529,72],["οὐ",709805,28],["μὴ",708851,28],["ἀσθενήσω",701938,207]],"[A Psalm] of David. Judge me, O Lord; for I have walked in my innocence: and hoping in the Lord I shall not be moved."],["2",[["δοκίμασόν",703776,176],["με",708618,163],["κύριε",707996,153],["καὶ",707031,7],["πείρασόν",710225,176],["με",708618,163],["πύρωσον",711103,176],["τοὺς",709436,58],["νεφρούς",709282,57],["μου",709032,133],["καὶ",707031,7],["τὴν",709436,8],["καρδίαν",707141,9],["μου",709032,133]],"Prove me, O Lord, and try me; purify as with fire my reins and my heart."],["3",[["ὅτι",709803,7],["τὸ",709436,34],["ἔλεός",704426,15],["σου",711945,133],["κατέναντι",707507,0],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["μού",709032,133],["ἐστιν",704093,91],["καὶ",707031,7],["εὐηρέστησα",705554,155],["ἐν",704639,0],["τῇ",709436,100],["ἀληθείᾳ",700656,1],["σου",711945,133]],"For thy mercy is before mine eyes: and I am well pleased with thy truth."],["4",[["οὐκ",709805,28],["ἐκάθισα",707006,155],["μετὰ",708780,0],["συνεδρίου",712429,21],["ματαιότητος",708576,17],["καὶ",707031,7],["μετὰ",708780,0],["παρανομούντων",710078,170],["οὐ",709805,28],["μὴ",708851,28],["εἰσέλθω",704114,207]],"I have not sat with the council of vanity, and will in nowise enter in with transgressors."],["5",[["ἐμίσησα",708935,155],["ἐκκλησίαν",704216,9],["πονηρευομένων",710657,299],["καὶ",707031,7],["μετὰ",708780,0],["ἀσεβῶν",701909,169],["οὐ",709805,28],["μὴ",708851,28],["καθίσω",707006,165]],"I have hated the assembly of wicked doers; and will not sit with ungodly [men]."],["6",[["νίψομαι",709314,181],["ἐν",704639,0],["ἀθῴοις",700390,230],["τὰς",709436,38],["χεῖράς",713787,39],["μου",709032,133],["καὶ",707031,7],["κυκλώσω",707958,165],["τὸ",709436,24],["θυσιαστήριόν",706348,25],["σου",711945,133],["κύριε",707996,153]],"I will wash my hands in innocency, and compass thine altar, O Lord:"],["7",[["τοῦ",709436,20],["ἀκοῦσαι",700587,106],["φωνὴν",713640,9],["αἰνέσεως",700457,17],["καὶ",707031,7],["διηγήσασθαι",703679,109],["πάντα",710177,68],["τὰ",709436,41],["θαυμάσιά",706136,68],["σου",711945,133]],"to hear the voice of praise, and to declare all thy wonderful works."],["8",[["κύριε",707996,153],["ἠγάπησα",700120,155],["εὐπρέπειαν",705666,9],["οἴκου",709516,18],["σου",711945,133],["καὶ",707031,7],["τόπον",712903,6],["σκηνώματος",711849,21],["δόξης",703791,17],["σου",711945,133]],"O Lord, I have loved the beauty of thy house, and the place of the tabernacle of thy glory."],["9",[["μὴ",708851,28],["συναπολέσῃς",712402,175],["μετὰ",708780,0],["ἀσεβῶν",701909,169],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["καὶ",707031,7],["μετὰ",708780,0],["ἀνδρῶν",701150,81],["αἱμάτων",700442,44],["τὴν",709436,8],["ζωήν",705910,9],["μου",709032,133]],"Destroy not my soul together with the ungodly, nor my life with bloody men:"],["10",[["ὧν",709781,252],["ἐν",704639,0],["χερσὶν",713787,76],["ἀνομίαι",701192,191],["ἡ",709436,10],["δεξιὰ",703360,29],["αὐτῶν",702165,40],["ἐπλήσθη",710532,37],["δώρων",703907,44]],"in whose hands [are] iniquities, [and] their right hand is filled with bribes."],["11",[["ἐγὼ",704018,164],["δὲ",703303,11],["ἐν",704639,0],["ἀκακίᾳ",700511,1],["μου",709032,133],["ἐπορεύθην",710667,156],["λύτρωσαί",708282,300],["με",708618,163],["καὶ",707031,7],["ἐλέησόν",704418,176],["με",708618,163]],"But I have walked in my innocence: redeem me, and have mercy upon me."],["12",[["ὁ",709436,3],["γὰρ",702963,11],["πούς",710707,4],["μου",709032,133],["ἔστη",706846,2],["ἐν",704639,0],["εὐθύτητι",705603,1],["ἐν",704639,0],["ἐκκλησίαις",704216,76],["εὐλογήσω",705631,165],["σε",711598,163],["κύριε",707996,153]],"My foot stands in an even place: in the congregations will I bless thee, O Lord."]]