[["1",[["αλληλουια",700688,88],["ᾄσατε",700299,74],["τῷ",709436,113],["κυρίῳ",707996,114],["ᾆσμα",701970,25],["καινόν",707042,46],["ἡ",709436,10],["αἴνεσις",700457,12],["αὐτοῦ",702165,559],["ἐν",704639,0],["ἐκκλησίᾳ",704216,1],["ὁσίων",709782,169]],"Alleluia. Sing to the Lord a new song: his praise is in the assembly of the saints."],["2",[["εὐφρανθήτω",705715,22],["Ισραηλ",706839,4],["ἐπὶ",705080,0],["τῷ",709436,113],["ποιήσαντι",710582,350],["αὐτόν",702165,556],["καὶ",707031,7],["υἱοὶ",713075,52],["Σιων",711816,17],["ἀγαλλιάσθωσαν",700114,77],["ἐπὶ",705080,0],["τῷ",709436,113],["βασιλεῖ",702580,114],["αὐτῶν",702165,565]],"Let Israel rejoice in him that made him; and let the children of Sion exult in their king."],["3",[["αἰνεσάτωσαν",700459,264],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,559],["ἐν",704639,0],["χορῷ",713915,114],["ἐν",704639,0],["τυμπάνῳ",713019,54],["καὶ",707031,7],["ψαλτηρίῳ",714023,54],["ψαλάτωσαν",714021,264],["αὐτῷ",702165,560]],"Let them praise his name in the dance: let them sing praises to him with timbrel and psaltery."],["4",[["ὅτι",709803,7],["εὐδοκεῖ",705565,91],["κύριος",707996,4],["ἐν",704639,0],["λαῷ",708094,114],["αὐτοῦ",702165,559],["καὶ",707031,7],["ὑψώσει",713289,127],["πραεῖς",710725,60],["ἐν",704639,0],["σωτηρίᾳ",712658,1]],"For the Lord takes pleasure in his people; and will exalt the meek with salvation."],["5",[["καυχήσονται",707569,135],["ὅσιοι",709782,138],["ἐν",704639,0],["δόξῃ",703791,1],["καὶ",707031,7],["ἀγαλλιάσονται",700114,135],["ἐπὶ",705080,0],["τῶν",709436,130],["κοιτῶν",707781,65],["αὐτῶν",702165,565]],"The saints shall rejoice in glory; and shall exult on their beds."],["6",[["αἱ",709436,190],["ὑψώσεις",713291,191],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐν",704639,0],["τῷ",709436,113],["λάρυγγι",708098,114],["αὐτῶν",702165,565],["καὶ",707031,7],["ῥομφαῖαι",711291,191],["δίστομοι",703746,192],["ἐν",704639,0],["ταῖς",709436,75],["χερσὶν",713787,76],["αὐτῶν",702165,565]],"The high praises of God shall be 