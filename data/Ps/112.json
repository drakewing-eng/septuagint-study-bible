[["1",[["αλληλουια",700688,88],["αἰνεῖτε",700459,335],["παῖδες",709932,52],["κύριον",707996,6],["αἰνεῖτε",700459,335],["τὸ",709436,24],["ὄνομα",709666,25],["κυρίου",707996,18]],"Alleluia. Praise the Lord, ye servants [of his], praise the name of the Lord."],["2",[["εἴη",704093,301],["τὸ",709436,24],["ὄνομα",709666,25],["κυρίου",707996,18],["εὐλογημένον",705631,414],["ἀπὸ",701425,0],["τοῦ",709436,35],["νῦν",709384,28],["καὶ",707031,7],["ἕως",705792,0],["τοῦ",709436,35],["αἰῶνος",700504,18]],"Let the name of the Lord be blessed, from this present time and for ever."],["3",[["ἀπὸ",701425,0],["ἀνατολῶν",701071,65],["ἡλίου",705974,18],["μέχρι",708849,0],["δυσμῶν",703865,65],["αἰνεῖτε",700459,335],["τὸ",709436,24],["ὄνομα",709666,25],["κυρίου",707996,18]],"From the rising of the sun to his setting, the name of the Lord is to be praised."],["4",[["ὑψηλὸς",713285,14],["ἐπὶ",705080,0],["πάντα",710177,68],["τὰ",709436,41],["ἔθνη",704068,42],["ὁ",709436,3],["κύριος",707996,4],["ἐπὶ",705080,0],["τοὺς",709436,58],["οὐρανοὺς",709844,57],["ἡ",709436,10],["δόξα",703791,12],["αὐτοῦ",702165,102]],"The Lord is high above all the nations; his glory is above the heavens."],["5",[["τίς",712867,158],["ὡς",714148,11],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["ὁ",709436,3],["ἐν",704639,0],["ὑψηλοῖς",713285,230],["κατοικῶν",707534,72]],"Who is as the Lord our God? who dwells in the high places,"],["6",[["καὶ",707031,7],["τὰ",709436,41],["ταπεινὰ",712714,68],["ἐφορῶν",705057,72],["ἐν",704639,0],["τῷ",709436,113],["οὐρανῷ",709844,114],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1]],"and [yet] looks upon the low things in heaven, and on the earth:"],["7",[["ὁ",709436,3],["ἐγείρων",703949,72],["ἀπὸ",701425,0],["γῆς",703083,17],["πτωχὸν",711076,6],["καὶ",707031,7],["ἀπὸ",701425,0],["κοπρίας",707827,17],["ἀνυψῶν",701293,72],["πένητα",710248,6]],"who lifts up the poor from the earth, and raises up the needy from the dunghill;"],["8",[["τοῦ",709436