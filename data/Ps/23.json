[["1",[["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114],["τῆς",709436,16],["μιᾶς",704106,82],["σαββάτων",711350,44],["τοῦ",709436,35],["κυρίου",707996,18],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["τὸ",709436,34],["πλήρωμα",710544,15],["αὐτῆς",702165,86],["ἡ",709436,10],["οἰκουμένη",709517,211],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["κατοικοῦντες",707534,146],["ἐν",704639,0],["αὐτῇ",702165,105]],"A Psalm for David on the first day of the week. The earth is the Lord's and the fulness thereof; the world, and all that dwell in it."],["2",[["αὐτὸς",702165,121],["ἐπὶ",705080,0],["θαλασσῶν",706069,65],["ἐθεμελίωσεν",706182,2],["αὐτὴν",702165,104],["καὶ",707031,7],["ἐπὶ",705080,0],["ποταμῶν",710693,81],["ἡτοίμασεν",705539,2],["αὐτήν",702165,104]],"He has founded it upon the seas, and prepared it upon the rivers."],["3",[["τίς",712867,158],["ἀναβήσεται",700905,93],["εἰς",704105,0],["τὸ",709436,24],["ὄρος",709768,25],["τοῦ",709436,35],["κυρίου",707996,18],["καὶ",707031,7],["τίς",712867,158],["στήσεται",706846,93],["ἐν",704639,0],["τόπῳ",712903,114],["ἁγίῳ",700159,30],["αὐτοῦ",702165,102]],"Who shall go up to the mountain of the Lord, and who shall stand in his holy place?"],["4",[["ἀθῷος",700390,14],["χερσὶν",713787,76],["καὶ",707031,7],["καθαρὸς",706988,14],["τῇ",709436,100],["καρδίᾳ",707141,1],["ὃς",709781,213],["οὐκ",709805,28],["ἔλαβεν",708076,2],["ἐπὶ",705080,0],["ματαίῳ",708575,97],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ὤμοσεν",709620,2],["ἐπὶ",705080,0],["δόλῳ",703787,114],["τῷ",709436,113],["πλησίον",710547,28],["αὐτοῦ",702165,102]],"He that is innocent in his hands and pure in his heart; who has not lifted up his soul to vanity, nor sworn deceitfully to his neighbour."],["5",[["οὗτος",709858,121],["λήμψεται",708076,93],["εὐλογίαν",705633,9],["παρὰ",709995,0],["κυρίου",707996,18],["καὶ",707031,7],["ἐλεημοσύνην",704421,9],["παρὰ",709995,0],["θεοῦ",706192,18],["σωτῆρος",712657,18],["αὐτοῦ",702165,102]],"He shall receive a blessing from the Lord, and mercy from God his Saviour."],["6",[["αὕτη",709858,107],["ἡ",709436,10],["γενεὰ",703037,12],["ζητούντων",705879,170],["αὐτόν",702165,85],["ζητούντων",705879,170],["τὸ",709436,24],["πρόσωπον",710986,25],["τοῦ",709436,35],["θεοῦ",706192,18],["Ιακωβ",706401,18],["διάψαλμα",703641,15]],"This is the generation of them that seek him, that seek the face of the God of Jacob. Pause."],["7",[["ἄρατε",700473,74],["πύλας",711082,39],["οἱ",709436,136],["ἄρχοντες",701862,52],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐπάρθητε",705002,372],["πύλαι",711082,191],["αἰώνιοι",700505,192],["καὶ",707031,7],["εἰσελεύσεται",704114,93],["ὁ",709436,3],["βασιλεὺς",702580,4],["τῆς",709436,16],["δόξης",703791,17]],"Lift up your gates, ye princes, and be ye lifted up, ye everlasting doors; and the king of glory shall come in."],["8",[["τίς",712867,158],["ἐστιν",704093,91],["οὗτος",709858,121],["ὁ",709436,3],["βασιλεὺς",702580,4],["τῆς",709436,16],["δόξης",703791,17],["κύριος",707996,4],["κραταιὸς",707873,14],["καὶ",707031,7],["δυνατός",703845,14],["κύριος",707996,4],["δυνατὸς",703845,14],["ἐν",704639,0],["πολέμῳ",710605,114]],"Who is this king of glory? the Lord strong and mighty, the Lord mighty in battle."],["9",[["ἄρατε",700473,74],["πύλας",711082,39],["οἱ",709436,136],["ἄρχοντες",701862,52],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐπάρθητε",705002,372],["πύλαι",711082,191],["αἰώνιοι",700505,192],["καὶ",707031,7],["εἰσελεύσεται",704114,93],["ὁ",709436,3],["βασιλεὺς",702580,4],["τῆς",709436,16],["δόξης",703791,17]],"Lift up your gates, ye princes; and be ye lift up, ye everlasting doors; and the king of glory shall come in."],["10",[["τίς",712867,158],["ἐστιν",704093,91],["οὗτος",709858,121],["ὁ",709436,3],["βασιλεὺς",702580,4],["τῆς",709436,16],["δόξης",703791,17],["κύριος",707996,4],["τῶν",709436,130],["δυνάμεων",703839,65],["αὐτός",702165,121],["ἐστιν",704093,91],["ὁ",709436,3],["βασιλεὺς",702580,4],["τῆς",709436,16],["δόξη