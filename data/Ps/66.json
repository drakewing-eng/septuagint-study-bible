[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ἐν",704639,0],["ὕμνοις",713089,148],["ψαλμὸς",714022,4],["ᾠδῆς",714091,17]],"For the end, a Psalm of David among the Hymns."],["2",[["ὁ",709436,3],["θεὸς",706192,4],["οἰκτιρήσαι",709518,300],["ἡμᾶς",705981,194],["καὶ",707031,7],["εὐλογήσαι",705631,225],["ἡμᾶς",705981,194],["ἐπιφάναι",705317,300],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["διάψαλμα",703641,15]],"God be merciful to us, and bless us; [and] cause his face to shine upon us. Pause."],["3",[["τοῦ",709436,20],["γνῶναι",703105,106],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["τὴν",709436,8],["ὁδόν",709458,9],["σου",711945,133],["ἐν",704639,0],["πᾶσιν",710177,94],["ἔθνεσιν",704068,96],["τὸ",709436,24],["σωτήριόν",712659,25],["σου",711945,133]],"That [men] may know thy way on the earth, thy salvation among all nations."],["4",[["ἐξομολογησάσθωσάν",704960,486],["σοι",711925,159],["λαοί",708094,52],["ὁ",709436,3],["θεός",706192,4],["ἐξομολογησάσθωσάν",704960,486],["σοι",711925,159],["λαοὶ",708094,52],["πάντες",710177,138]],"Let the nations, O God, give thanks to thee; let all the nations give thanks to thee."],["5",[["εὐφρανθήτωσαν",705715,51],["καὶ",707031,7],["ἀγαλλιάσθωσαν",700114,77],["ἔθνη",704068,42],["ὅτι",709803,7],["κρινεῖς",707905,166],["λαοὺς",708094,57],["ἐν",704639,0],["εὐθύτητι",705603,1],["καὶ",707031,7],["ἔθνη",704068,42],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ὁδηγήσεις",709448,166],["διάψαλμα",703641,15]],"Let the nations rejoice and exult, for thou shalt judge the peoples in equity, and shalt guide the nations on the earth. Pause."],["6",[["ἐξομολογησάσθωσάν",704960,486],["σοι",711925,159],["λαοί",708094,52],["ὁ",709436,3],["θεός",706192,4],["ἐξομολογησάσθωσάν",704960,486],["σοι",711925,159],["λαοὶ",708094,52],["πάντες",710177,138]],"Let the peoples, O God, give thanks to thee; let all the peoples give thanks to thee."],["7",[["γῆ",703083,12],["ἔδωκεν",703654,2],["τὸν",709436,5],["καρπὸν",707169,6],["αὐτῆς",702165,86],["εὐλογήσαι",705631,225],["ἡμᾶς",705981,194],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145]],"The earth has yielded her fruit; let God, our God, bless us."],["8",[["εὐλογήσαι",705631,225],["ἡμᾶς",705981,194],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["φοβηθήτωσαν",713532,51],["αὐτὸν",702165,85],["πάντα",710177,195],["τὰ",709436,63],["πέρατα",710281,64],["τῆς",709436,16],["γῆς",703083,17]],"Let God bless us; and let all the ends of the earth fear him."]]