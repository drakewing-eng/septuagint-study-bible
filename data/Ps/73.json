[["1",[["συνέσεως",712460,17],["τῷ",709436,113],["Ασαφ",701894,114],["ἵνα",706747,7],["τί",712867,126],["ἀπώσω",701659,174],["ὁ",709436,3],["θεός",706192,4],["εἰς",704105,0],["τέλος",712787,25],["ὠργίσθη",709729,37],["ὁ",709436,3],["θυμός",706334,4],["σου",711945,133],["ἐπὶ",705080,0],["πρόβατα",710768,42],["νομῆς",709337,17],["σου",711945,133]],"[A Psalm] of instruction for Asaph. Wherefore hast thou rejected [us], O God, for ever? [wherefore] is thy wrath kindled against the sheep of thy pasture?"],["2",[["μνήσθητι",708960,244],["τῆς",709436,16],["συναγωγῆς",712376,17],["σου",711945,133],["ἧς",709781,167],["ἐκτήσω",707932,174],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["ἐλυτρώσω",708282,174],["ῥάβδον",711135,9],["κληρονομίας",707725,17],["σου",711945,133],["ὄρος",709768,15],["Σιων",711816,17],["τοῦτο",709858,132],["ὃ",709781,33],["κατεσκήνωσας",707423,162],["ἐν",704639,0],["αὐτῷ",702165,50]],"Remember thy congregation which thou hast purchased from the beginning; thou didst ransom the rod of thine inheritance; this mount Sion wherein thou hast dwelt."],["3",[["ἔπαρον",705002,176],["τὰς",709436,38],["χεῖράς",713787,39],["σου",711945,133],["ἐπὶ",705080,0],["τὰς",709436,38],["ὑπερηφανίας",713138,17],["αὐτῶν",702165,40],["εἰς",704105,0],["τέλος",712787,25],["ὅσα",709788,68],["ἐπονηρεύσατο",710657,23],["ὁ",709436,3],["ἐχθρὸς",705779,4],["ἐν",704639,0],["τοῖς",709436,147],["ἁγίοις",700159,230],["σου",711945,133]],"Lift up thine hands against their pride continually; [because of] all that the enemy has done wickedly in thy holy places."],["4",[["καὶ",707031,7],["ἐνεκαυχήσαντο",703971,189],["οἱ",709436,136],["μισοῦντές",708935,146],["σε",711598,163],["ἐν",704639,0],["μέσῳ",708768,30],["τῆς",709436,16],["ἑορτῆς",704990,17],["σου",711945,133],["ἔθεντο",712849,189],["τὰ",709436,41],["σημεῖα",711748,42],["αὐτῶν",702165,40],["σημεῖα",711748,42],["καὶ",707031,7],["οὐκ",709805,28],["ἔγνωσαν",703105,150]],"And they that hate thee have boasted in the midst of thy feast; they have set up their standards for signs,"],["5",[["ὡς",714148,7],["εἰς",704105,0],["τὴν",709436,8],["εἴσοδον",704119,9],["ὑπεράνω",713118,28]],"ignorantly as it were in the entrance above;"],["6",[["ὡς",714148,7],["ἐν",704639,0],["δρυμῷ",703836,114],["ξύλων",709427,44],["ἀξίναις",701306,76],["ἐξέκοψαν",704225,150],["τὰς",709436,38],["θύρας",706337,39],["αὐτῆς",702165,86],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτὸ",702165,129],["ἐν",704639,0],["πελέκει",710237,114],["καὶ",707031,7],["λαξευτηρίῳ",708090,54],["κατέρραξαν",707405,150],["αὐτήν",702165,104]],"they cut down its doors at once with axes as in a wood of trees; they have broken it down with hatchet and stone cutter."],["7",[["ἐνεπύρισαν",704622,150],["ἐν",704639,0],["πυρὶ",711088,54],["τὸ",709436,24],["ἁγιαστήριόν",700156,25],["σου",711945,133],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ἐβεβήλωσαν",702614,150],["τὸ",709436,24],["σκήνωμα",711849,25],["τοῦ",709436,20],["ὀνόματός",709666,21],["σου",711945,133]],"They have burnt thy sanctuary with fire to the ground; they have profaned the habitation of thy name."],["8",[["εἶπαν",705373,150],["ἐν",704639,0],["τῇ",709436,100],["καρδίᾳ",707141,1],["αὐτῶν",702165,40],["ἡ",709436,10],["συγγένεια",712184,12],["αὐτῶν",702165,40],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτό",702165,129],["δεῦτε",703383,28],["καὶ",707031,7],["κατακαύσωμεν",707258,79],["πάσας",710177,119],["τὰς",709436,38],["ἑορτὰς",704990,39],["τοῦ",709436,35],["θεοῦ",706192,18],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17]],"They have said in their heart, [even] all their kindred together, Come, let us abolish the feasts of the Lord from the earth."],["9",[["τὰ",709436,41],["σημεῖα",711748,42],["ἡμῶν",705999,145],["οὐκ",709805,28],["εἴδομεν",709725,289],["οὐκ",709805,28],["ἔστιν",704093,91],["ἔτι",705538,28],["προφήτης",711009,4],["καὶ",707031,7],["ἡμᾶς",705981,194],["οὐ",709805,28],["γνώσεται",703105,93],["ἔτι",705538,28]],"We have not seen our signs; there is no longer a prophet; and [God] will not know us any more."],["10",[["ἕως",705792,0],["πότε",710696,11],["ὁ",709436,3],["θεός",706192,4],["ὀνειδιεῖ",709655,127],["ὁ",709436,3],["ἐχθρός",705779,4],["παροξυνεῖ",710164,91],["ὁ",709436,3],["ὑπεναντίος",713109,14],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["εἰς",704105,0],["τέλος",712787,25]],"How long, O God, shall the enemy reproach? shall the enemy provoke thy name for ever?"],["11",[["ἵνα",706747,7],["τί",712867,126],["ἀποστρέφεις",701598,154],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133],["καὶ",707031,7],["τὴν",709436,8],["δεξιάν",703360,36],["σου",711945,133],["ἐκ",704132,0],["μέσου",708768,116],["τοῦ",709436,35],["κόλπου",707800,18],["σου",711945,133],["εἰς",704105,0],["τέλος",712787,25]],"Wherefore turnest thou away thine hand, and thy right hand from the midst of thy bosom for ever?"],["12",[["ὁ",709436,3],["δὲ",703303,11],["θεὸς",706192,4],["βασιλεὺς",702580,4],["ἡμῶν",705999,145],["πρὸ",710747,0],["αἰῶνος",700504,18],["εἰργάσατο",705383,23],["σωτηρίαν",712658,9],["ἐν",704639,0],["μέσῳ",708768,30],["τῆς",709436,16],["γῆς",703083,17]],"But God is our King of old; he has wrought salvation in the midst of the earth."],["13",[["σὺ",712181,164],["ἐκραταίωσας",707875,162],["ἐν",704639,0],["τῇ",709436,100],["δυνάμει",703839,1],["σου",711945,133],["τὴν",709436,8],["θάλασσαν",706069,9],["σὺ",712181,164],["συνέτριψας",712520,162],["τὰς",709436,38],["κεφαλὰς",707639,39],["τῶν",709436,80],["δρακόντων",703822,81],["ἐπὶ",705080,0],["τοῦ",709436,20],["ὕδατος",713071,21]],"Thou didst establish the sea, in thy might, thou didst break to pieces the heads of the dragons in the water."],["14",[["σὺ",712181,164],["συνέθλασας",712479,162],["τὰς",709436,38],["κεφαλὰς",707639,39],["τοῦ",709436,35],["δράκοντος",703822,18],["ἔδωκας",703654,162],["αὐτὸν",702165,85],["βρῶμα",702823,25],["λαοῖς",708094,148],["τοῖς",709436,147],["Αἰθίοψιν",700420,148]],"Thou didst break to pieces the heads of the dragon; thou didst give him [for] meat to the Ethiopian nations."],["15",[["σὺ",712181,164],["διέρρηξας",703565,162],["πηγὰς",710450,39],["καὶ",707031,7],["χειμάρρους",713783,57],["σὺ",712181,164],["ἐξήρανας",709419,162],["ποταμοὺς",710693,57],["Ηθαμ",705952,118]],"Thou didst cleave fountains and torrents; thou driedst up mighty rivers."],["16",[["σή",711943,29],["ἐστιν",704093,91],["ἡ",709436,10],["ἡμέρα",705984,12],["καὶ",707031,7],["σή",711943,29],["ἐστιν",704093,91],["ἡ",709436,10],["νύξ",709386,12],["σὺ",712181,164],["κατηρτίσω",707410,174],["φαῦσιν",713400,9],["καὶ",707031,7],["ἥλιον",705974,6]],"The day is thine, and the night is thine; thou hast prepared the sun and the moon."],["17",[["σὺ",712181,164],["ἐποίησας",710582,162],["πάντα",710177,68],["τὰ",709436,41],["ὅρια",709749,42],["τῆς",709436,16],["γῆς",703083,17],["θέρος",706219,25],["καὶ",707031,7],["ἔαρ",703914,25],["σὺ",712181,164],["ἔπλασας",710503,162],["αὐτά",702165,71]],"Thou hast made all the borders of the earth; thou hast made summer and spring."],["18",[["μνήσθητι",708960,244],["ταύτης",709858,86],["ἐχθρὸς",705779,4],["ὠνείδισεν",709655,2],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["λαὸς",708094,4],["ἄφρων",702236,14],["παρώξυνεν",710164,2],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133]],"Remember this thy creation: an enemy has reproached the Lord, and a foolish people has provoked thy name."],["19",[["μὴ",708851,28],["παραδῷς",710014,175],["τοῖς",709436,95],["θηρίοις",706252,96],["ψυχὴν",714070,9],["ἐξομολογουμένην",704960,173],["σοι",711925,159],["τῶν",709436,130],["ψυχῶν",714070,65],["τῶν",709436,80],["πενήτων",710248,81],["σου",711945,133],["μὴ",708851,28],["ἐπιλάθῃ",705187,172],["εἰς",704105,0],["τέλος",712787,25]],"Deliver not to the wild beasts a soul that gives praise to thee: forget not for ever the souls of thy poor."],["20",[["ἐπίβλεψον",705088,176],["εἰς",704105,0],["τὴν",709436,8],["διαθήκην",703456,9],["σου",711945,133],["ὅτι",709803,7],["ἐπληρώθησαν",710543,99],["οἱ",709436,136],["ἐσκοτισμένοι",711887,362],["τῆς",709436,16],["γῆς",703083,17],["οἴκων",709516,81],["ἀνομιῶν",701192,65]],"Look upon thy covenant: for the dark [places] of the earth are filled with the habitations of iniquity."],["21",[["μὴ",708851,28],["ἀποστραφήτω",701598,22],["τεταπεινωμένος",712717,251],["κατῃσχυμμένος",707257,251],["πτωχὸς",711076,4],["καὶ",707031,7],["πένης",710248,4],["αἰνέσουσιν",700459,218],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133]],"Let not the afflicted and shamed one be rejected: the poor and needy shall praise thy name."],["22",[["ἀνάστα",701173,176],["ὁ",709436,3],["θεός",706192,4],["δίκασον",703691,176],["τὴν",709436,8],["δίκην",703702,9],["σου",711945,133],["μνήσθητι",708960,244],["τῶν",709436,80],["ὀνειδισμῶν",709657,81],["σου",711945,133],["τῶν",709436,80],["ὑπὸ",713184,0],["ἄφρονος",702236,116],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9]],"Arise, O God, plead thy cause: remember thy reproaches that come from the foolish one all the day."],["23",[["μὴ",708851,28],["ἐπιλάθῃ",705187,172],["τῆς",709436,16],["φωνῆς",713640,17],["τῶν",709436,80],["ἱκετῶν",706718,81],["σου",711945,133],["ἡ",709436,10],["ὑπερηφανία",713138,12],["τῶν",709436,80],["μισούντων",708935,170],["σε",711598,163],["ἀνέβη",700905,2],["διὰ",703417,0],["παντὸς",710177,116],["πρὸς",710844,0],["σέ",711598,163]],"Forget not the voice of thy suppliants: let the pride of them that hate thee continually ascend before thee."]]