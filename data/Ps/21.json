[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ὑπὲρ",713111,0],["τῆς",709436,16],["ἀντιλήμψεως",701247,17],["τῆς",709436,16],["ἑωθινῆς",705790,82],["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, concerning the morning aid, a Psalm of David."],["2",[["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["πρόσχες",710895,176],["μοι",708974,159],["ἵνα",706747,7],["τί",712867,126],["ἐγκατέλιπές",703967,162],["με",708618,163],["μακρὰν",708411,28],["ἀπὸ",701425,0],["τῆς",709436,16],["σωτηρίας",712658,17],["μου",709032,133],["οἱ",709436,136],["λόγοι",708236,52],["τῶν",709436,43],["παραπτωμάτων",710095,44],["μου",709032,133]],"O God, my God, attend to me: why hast thou forsaken me? the account of my transgressions is far from my salvation."],["3",[["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["κεκράξομαι",707868,181],["ἡμέρας",705984,17],["καὶ",707031,7],["οὐκ",709805,28],["εἰσακούσῃ",704108,172],["καὶ",707031,7],["νυκτός",709386,17],["καὶ",707031,7],["οὐκ",709805,28],["εἰς",704105,0],["ἄνοιαν",701185,9],["ἐμοί",704577,159]],"O my God, I will cry to thee by day, but thou wilt not hear: and by night, and [it shall] not [be accounted] for folly to me."],["4",[["σὺ",712181,164],["δὲ",703303,11],["ἐν",704639,0],["ἁγίοις",700159,230],["κατοικεῖς",707534,154],["ὁ",709436,3],["ἔπαινος",705001,4],["Ισραηλ",706839,18]],"But thou, the praise of Israel, dwellest in a sanctuary."],["5",[["ἐπὶ",705080,0],["σοὶ",711925,159],["ἤλπισαν",704529,150],["οἱ",709436,136],["πατέρες",710189,52],["ἡμῶν",705999,145],["ἤλπισαν",704529,150],["καὶ",707031,7],["ἐρρύσω",711309,174],["αὐτούς",702165,62]],"Our fathers hoped in thee; they hoped, and thou didst deliver them."],["6",[["πρὸς",710844,0],["σὲ",711598,163],["ἐκέκραξαν",707868,150],["καὶ",707031,7],["ἐσώθησαν",712627,99],["ἐπὶ",705080,0],["σοὶ",711925,159],["ἤλπισαν",704529,150],["καὶ",707031,7],["οὐ",709805,28],["κατῃσχύνθησαν",707257,99]],"They cried to thee, and were saved: they hoped in thee, and were not ashamed."],["7",[["ἐγὼ",704018,164],["δέ",703303,11],["εἰμι",704093,157],["σκώληξ",711905,4],["καὶ",707031,7],["οὐκ",709805,28],["ἄνθρωπος",701163,4],["ὄνειδος",709658,15],["ἀνθρώπου",701163,18],["καὶ",707031,7],["ἐξουδένημα",704968,15],["λαοῦ",708094,18]],"But I am a worm, and not a man; a reproach of men, and scorn of the people."],["8",[["πάντες",710177,138],["οἱ",709436,136],["θεωροῦντές",706226,146],["με",708618,163],["ἐξεμυκτήρισάν",704263,150],["με",708618,163],["ἐλάλησαν",708071,150],["ἐν",704639,0],["χείλεσιν",713781,96],["ἐκίνησαν",707679,150],["κεφαλήν",707639,9]],"All that saw me mocked me: they spoke with [their] lips, they shook the head, [saying],"],["9",[["ἤλπισεν",704529,2],["ἐπὶ",705080,0],["κύριον",707996,6],["ῥυσάσθω",711309,315],["αὐτόν",702165,85],["σωσάτω",712627,45],["αὐτόν",702165,85],["ὅτι",709803,7],["θέλει",706176,91],["αὐτόν",702165,85]],"He hoped in the Lord: let him deliver him, let him save him, because he takes pleasure in him."],["10",[["ὅτι",709803,7],["σὺ",712181,164],["εἶ",704093,154],["ὁ",709436,3],["ἐκσπάσας",704311,182],["με",708618,163],["ἐκ",704132,0],["γαστρός",702976,17],["ἡ",709436,10],["ἐλπίς",704530,12],["μου",709032,133],["ἀπὸ",701425,0],["μαστῶν",708569,81],["τῆς",709436,16],["μητρός",708892,17],["μου",709032,133]],"For thou art he that drew me out of the womb; my hope from my mother's breasts."],["11",[["ἐπὶ",705080,0],["σὲ",711598,163],["ἐπερρίφην",705238,156],["ἐκ",704132,0],["μήτρας",708894,17],["ἐκ",704132,0],["κοιλίας",707761,17],["μητρός",708892,17],["μου",709032,133],["θεός",706192,4],["μου",709032,133],["εἶ",704093,154],["σύ",712181,164]],"I was cast on thee from the womb: thou art my God from my mother's belly."],["12",[["μὴ",708851,28],["ἀποστῇς",702214,175],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["ὅτι",709803,7],["θλῖψις",706276,12],["ἐγγύς",703948,28],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ὁ",709436,3],["βοηθῶν",702746,72]],"Stand not aloof from me; for affliction is near; for there is no helper."],["13",[["περιεκύκλωσάν",710339,150],["με",708618,163],["μόσχοι",709029,52],["πολλοί",710646,138],["ταῦροι",712734,52],["πίονες",710491,138],["περιέσχον",710315,150],["με",708618,163]],"Many bullocks have compassed me: fat bulls have beset me round."],["14",[["ἤνοιξαν",701186,150],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["τὸ",709436,24],["στόμα",712125,25],["αὐτῶν",702165,40],["ὡς",714148,7],["λέων",708171,4],["ὁ",709436,3],["ἁρπάζων",701804,72],["καὶ",707031,7],["ὠρυόμενος",714142,122]],"They have opened their mouth against me, as a ravening and roaring lion."],["15",[["ὡσεὶ",714159,28],["ὕδωρ",713071,15],["ἐξεχύθην",704368,156],["καὶ",707031,7],["διεσκορπίσθη",703579,37],["πάντα",710177,195],["τὰ",709436,63],["ὀστᾶ",709792,64],["μου",709032,133],["ἐγενήθη",703104,37],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["ὡσεὶ",714159,28],["κηρὸς",707659,4],["τηκόμενος",712839,122],["ἐν",704639,0],["μέσῳ",708768,30],["τῆς",709436,16],["κοιλίας",707761,17],["μου",709032,133]],"I am poured out like water, and all my bones are loosened: my heart in the midst of my belly is become like melting wax."],["16",[["ἐξηράνθη",709419,37],["ὡς",714148,7],["ὄστρακον",709796,15],["ἡ",709436,10],["ἰσχύς",706858,12],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["γλῶσσά",703120,12],["μου",709032,133],["κεκόλληται",707791,403],["τῷ",709436,113],["λάρυγγί",708098,114],["μου",709032,133],["καὶ",707031,7],["εἰς",704105,0],["χοῦν",713930,6],["θανάτου",706096,18],["κατήγαγές",707232,162],["με",708618,163]],"My strength is dried up like a potsherd; and my tongue is glued to my throat; and thou hast brought me down to the dust of death."],["17",[["ὅτι",709803,7],["ἐκύκλωσάν",707958,150],["με",708618,163],["κύνες",708004,52],["πολλοί",710646,138],["συναγωγὴ",712376,12],["πονηρευομένων",710657,299],["περιέσχον",710315,150],["με",708618,163],["ὤρυξαν",709775,150],["χεῖράς",713787,39],["μου",709032,133],["καὶ",707031,7],["πόδας",710707,57]],"For many dogs have compassed me: the assembly of the wicked doers has beset me round: they pierced my hands and my feet."],["18",[["ἐξηρίθμησα",704877,155],["πάντα",710177,68],["τὰ",709436,41],["ὀστᾶ",709792,42],["μου",709032,133],["αὐτοὶ",702165,201],["δὲ",703303,11],["κατενόησαν",707341,150],["καὶ",707031,7],["ἐπεῖδόν",705057,150],["με",708618,163]],"They counted all my bones; and they observed and looked upon me."],["19",[["διεμερίσαντο",703518,189],["τὰ",709436,41],["ἱμάτιά",706742,42],["μου",709032,133],["ἑαυτοῖς",703917,151],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸν",709436,5],["ἱματισμόν",706744,6],["μου",709032,133],["ἔβαλον",702487,150],["κλῆρον",707727,6]],"They parted my garments [among] themselves, and cast lots upon my raiment."],["20",[["σὺ",712181,164],["δέ",703303,11],["κύριε",707996,153],["μὴ",708851,28],["μακρύνῃς",708428,205],["τὴν",709436,8],["βοήθειάν",702745,9],["μου",709032,133],["εἰς",704105,0],["τὴν",709436,8],["ἀντίλημψίν",701247,9],["μου",709032,133],["πρόσχες",710895,176]],"But thou, O Lord, remove not my help afar off: be ready for mine aid."],["21",[["ῥῦσαι",711309,300],["ἀπὸ",701425,0],["ῥομφαίας",711291,17],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["καὶ",707031,7],["ἐκ",704132,0],["χειρὸς",713787,17],["κυνὸς",708004,18],["τὴν",709436,8],["μονογενῆ",708996,36],["μου",709032,133]],"Deliver my soul from the sword; my only-begotten one from the power of the dog."],["22",[["σῶσόν",712627,176],["με",708618,163],["ἐκ",704132,0],["στόματος",712125,21],["λέοντος",708171,18],["καὶ",707031,7],["ἀπὸ",701425,0],["κεράτων",707625,44],["μονοκερώτων",708999,81],["τὴν",709436,8],["ταπείνωσίν",712719,9],["μου",709032,133]],"Save me from the lion's mouth; and [regard] my lowliness from the horns of the unicorns."],["23",[["διηγήσομαι",703679,181],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["τοῖς",709436,147],["ἀδελφοῖς",700249,148],["μου",709032,133],["ἐν",704639,0],["μέσῳ",708768,30],["ἐκκλησίας",704216,17],["ὑμνήσω",713085,165],["σε",711598,163]],"I will declare thy name to my brethren: in the midst of the church will I sing praise to thee."],["24",[["οἱ",709436,136],["φοβούμενοι",713532,348],["κύριον",707996,6],["αἰνέσατε",700459,74],["αὐτόν",702165,85],["ἅπαν",701362,26],["τὸ",709436,34],["σπέρμα",712008,15],["Ιακωβ",706401,18],["δοξάσατε",703792,74],["αὐτόν",702165,85],["φοβηθήτωσαν",713532,51],["αὐτὸν",702165,85],["ἅπαν",701362,26],["τὸ",709436,34],["σπέρμα",712008,15],["Ισραηλ",706839,18]],"Ye that fear the Lord, praise him; all ye seed of Jacob, glorify him: let all the seed of Israel fear him."],["25",[["ὅτι",709803,7],["οὐκ",709805,28],["ἐξουδένωσεν",704969,2],["οὐδὲ",709816,7],["προσώχθισεν",710945,2],["τῇ",709436,100],["δεήσει",703311,1],["τοῦ",709436,35],["πτωχοῦ",711076,18],["οὐδὲ",709816,7],["ἀπέστρεψεν",701598,2],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["κεκραγέναι",707868,115],["με",708618,163],["πρὸς",710844,0],["αὐτὸν",702165,85],["εἰσήκουσέν",704108,2],["μου",709032,133]],"For he has not despised nor been angry at the supplication of the poor; nor turned away his face from me; but when I cried to him, he heard me."],["26",[["παρὰ",709995,0],["σοῦ",711945,133],["ὁ",709436,3],["ἔπαινός",705001,4],["μου",709032,133],["ἐν",704639,0],["ἐκκλησίᾳ",704216,1],["μεγάλῃ",708653,101],["τὰς",709436,38],["εὐχάς",705726,39],["μου",709032,133],["ἀποδώσω",701449,165],["ἐνώπιον",704823,0],["τῶν",709436,80],["φοβουμένων",713532,299],["αὐτόν",702165,85]],"My praise is of thee in the great congregation: I will pay my vows before them that fear him."],["27",[["φάγονται",713296,135],["πένητες",710248,52],["καὶ",707031,7],["ἐμπλησθήσονται",704592,144],["καὶ",707031,7],["αἰνέσουσιν",700459,218],["κύριον",707996,6],["οἱ",709436,136],["ἐκζητοῦντες",704187,146],["αὐτόν",702165,85],["ζήσονται",705851,135],["αἱ",709436,190],["καρδίαι",707141,191],["αὐτῶν",702165,40],["εἰς",704105,0],["αἰῶνα",700504,6],["αἰῶνος",700504,18]],"The poor shall eat and be satisfied; and they shall praise the Lord that seek him: their heart shall live for ever."],["28",[["μνησθήσονται",708923,144],["καὶ",707031,7],["ἐπιστραφήσονται",705278,144],["πρὸς",710844,0],["κύριον",707996,6],["πάντα",710177,195],["τὰ",709436,63],["πέρατα",710281,64],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["προσκυνήσουσιν",710925,218],["ἐνώπιόν",704823,0],["σου",711945,133],["πᾶσαι",710177,192],["αἱ",709436,190],["πατριαὶ",710192,191],["τῶν",709436,43],["ἐθνῶν",704068,44]],"All the ends of the earth shall remember and turn to the Lord: and all the kindreds of the nations shall worship before him."],["29",[["ὅτι",709803,7],["τοῦ",709436,35],["κυρίου",707996,18],["ἡ",709436,10],["βασιλεία",702577,12],["καὶ",707031,7],["αὐτὸς",702165,121],["δεσπόζει",703376,91],["τῶν",709436,43],["ἐθνῶν",704068,44]],"For the kingdom is the Lord's; and he is the governor of the nations."],["30",[["ἔφαγον",713296,150],["καὶ",707031,7],["προσεκύνησαν",710925,150],["πάντες",710177,138],["οἱ",709436,136],["πίονες",710491,138],["τῆς",709436,16],["γῆς",703083,17],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["προπεσοῦνται",710837,135],["πάντες",710177,138],["οἱ",709436,136],["καταβαίνοντες",707202,146],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["αὐτῷ",702165,50],["ζῇ",705851,91]],"All the fat ones of the earth have eaten and worshipped: all that go down to the earth shall fall down before him: my soul also lives to him."],["31",[["καὶ",707031,7],["τὸ",709436,34],["σπέρμα",712008,15],["μου",709032,133],["δουλεύσει",703814,127],["αὐτῷ",702165,50],["ἀναγγελήσεται",700921,134],["τῷ",709436,113],["κυρίῳ",707996,114],["γενεὰ",703037,12],["ἡ",709436,10],["ἐρχομένη",705453,211]],"And my seed shall serve him: the generation that is coming shall be reported to the Lord."],["32",[["καὶ",707031,7],["ἀναγγελοῦσιν",700921,218],["τὴν",709436,8],["δικαιοσύνην",703695,9],["αὐτοῦ",702165,102],["λαῷ",708094,114],["τῷ",709436,113],["τεχθησομένῳ",712853,726],["ὅτι",709803,7],["ἐποίησεν",710582,2],["ὁ",709436,3],["κύριος",707996,4]],"And they shall report his righteousness to the people that shall be born, whom the Lord has made."]]