[["1",[["αλληλουια",700688,88],["Αγγαιου",700135,18],["καὶ",707031,7],["Ζαχαριου",705847,18],["αἴνει",700459,240],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["τὸν",709436,5],["κύριον",707996,6]],"Alleluia, [a Psalm] of Aggæus and Zacharias. My soul, praise the Lord."],["2",[["αἰνέσω",700459,207],["κύριον",707996,6],["ἐν",704639,0],["ζωῇ",705910,1],["μου",709032,133],["ψαλῶ",714021,165],["τῷ",709436,113],["θεῷ",706192,114],["μου",709032,133],["ἕως",705792,0],["ὑπάρχω",713104,157]],"While I live will I praise the Lord: I will sing praises to my God as long as I exist."],["3",[["μὴ",708851,28],["πεποίθατε",710221,330],["ἐπ᾿",705080,0],["ἄρχοντας",701862,57],["καὶ",707031,7],["ἐφ᾿",705080,0],["υἱοὺς",713075,57],["ἀνθρώπων",701163,81],["οἷς",709781,311],["οὐκ",709805,28],["ἔστιν",704093,91],["σωτηρία",712658,12]],"Trust not in princes, nor in the children of men, in whom there is no safety."],["4",[["ἐξελεύσεται",704909,93],["τὸ",709436,24],["πνεῦμα",710566,25],["αὐτοῦ",702165,559],["καὶ",707031,7],["ἐπιστρέψει",705278,127],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["αὐτοῦ",702165,559],["ἐν",704639,0],["ἐκείνῃ",704183,105],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἀπολοῦνται",701513,135],["πάντες",710177,138],["οἱ",709436,136],["διαλογισμοὶ",703506,52],["αὐτῶν",702165,565]],"His breath shall go forth, and he shall return to his earth; in that day all his thoughts shall perish."],["5",[["μακάριος",708397,14],["οὗ",709781,48],["ὁ",709436,3],["θεὸς",706192,4],["Ιακωβ",706401,18],["βοηθός",702748,4],["ἡ",709436,10],["ἐλπὶς",704530,12],["αὐτοῦ",702165,559],["ἐπὶ",705080,0],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["αὐτοῦ",702165,559]],"Blessed is he whose helper is the God of Jacob, whose hope is in the Lord his God:"],["6",[["τὸν",709436,5],["ποιήσαντα",710582,365],["τὸν",709436,5],["οὐρανὸν",709844,6],["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9],["τὴν",709436,8],["θάλασσαν",706069,9],["καὶ",707031,7],["πάντα",710177,27],["τὰ",709436,41],