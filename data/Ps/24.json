[["1",[["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114],["πρὸς",710844,0],["σέ",711598,163],["κύριε",707996,153],["ἦρα",700473,155],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133]],"A Psalm of David. To thee, O Lord, have I lifted up my soul."],["2",[["ἐπὶ",705080,0],["σοὶ",711925,159],["πέποιθα",710221,89],["μὴ",708851,28],["καταισχυνθείην",707257,727],["μηδὲ",708855,7],["καταγελασάτωσάν",707222,264],["μου",709032,133],["οἱ",709436,136],["ἐχθροί",705779,52],["μου",709032,133]],"O my God, I have trusted in thee: let me not be confounded, neither let mine enemies laugh me to scorn."],["3",[["καὶ",707031,7],["γὰρ",702963,11],["πάντες",710177,138],["οἱ",709436,136],["ὑπομένοντές",713219,146],["σε",711598,163],["οὐ",709805,28],["μὴ",708851,28],["καταισχυνθῶσιν",707257,272],["αἰσχυνθήτωσαν",700485,51],["πάντες",710177,138],["οἱ",709436,136],["ἀνομοῦντες",701190,146],["διὰ",703417,0],["κενῆς",707612,82]],"For none of them that wait on thee shall in any wise be ashamed: let them be ashamed that transgress without cause."],["4",[["τὰς",709436,38],["ὁδούς",709458,39],["σου",711945,133],["κύριε",707996,153],["γνώρισόν",703135,176],["μοι",708974,159],["καὶ",707031,7],["τὰς",709436,38],["τρίβους",712939,39],["σου",711945,133],["δίδαξόν",703649,176],["με",708618,163]],"Shew me thy ways, O Lord; and teach me thy paths."],["5",[["ὁδήγησόν",709448,176],["με",708618,163],["ἐπὶ",705080,0],["τὴν",709436,8],["ἀλήθειάν",700656,9],["σου",711945,133],["καὶ",707031,7],["δίδαξόν",703649,176],["με",708618,163],["ὅτι",709803,7],["σὺ",712181,164],["εἶ",704093,154],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["σωτήρ",712657,4],["μου",709032,133],["καὶ",707031,7],["σὲ",711598,163],["ὑπέμεινα",713219,155],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9]],"Lead me in thy truth, and teach me: for thou art God my Saviour: and I have waited on thee all the day."],["6",[["μνήσθητι",708960,244],["τῶν",709436,80],["οἰκτιρμῶν",709520,81],["σου",711945,133],["κύριε",707996,153],["καὶ",707031,7],["τὰ",709436,41],["ἐλέη",704426,42],["σου",711945,133],["ὅτι",709803,7],["ἀπὸ",701425,0],["τοῦ",709436,35],["αἰῶνός",700504,18],["εἰσιν",704093,197]],"Remember thy compassions, O Lord, and thy mercies, for they are from everlasting."],["7",[["ἁμαρτίας",700775,17],["νεότητός",709258,17],["μου",709032,133],["καὶ",707031,7],["ἀγνοίας",700177,17],["μου",709032,133],["μὴ",708851,28],["μνησθῇς",708960,279],["κατὰ",707200,0],["τὸ",709436,24],["ἔλεός",704426,25],["σου",711945,133],["μνήσθητί",708960,244],["μου",709032,133],["σὺ",712181,164],["ἕνεκα",704709,0],["τῆς",709436,16],["χρηστότητός",713959,17],["σου",711945,133],["κύριε",707996,153]],"Remember not the sins of my youth, nor [my sins] of ignorance: remember me according to thy mercy, for thy goodness' sake, O Lord."],["8",[["χρηστὸς",713958,14],["καὶ",707031,7],["εὐθὴς",705596,14],["ὁ",709436,3],["κύριος",707996,4],["διὰ",703417,0],["τοῦτο",709858,129],["νομοθετήσει",709346,127],["ἁμαρτάνοντας",700773,235],["ἐν",704639,0],["ὁδῷ",709458,1]],"Good and upright is the Lord: therefore will he instruct sinners in [the] way."],["9",[["ὁδηγήσει",709448,127],["πραεῖς",710725,60],["ἐν",704639,0],["κρίσει",707908,1],["διδάξει",703649,127],["πραεῖς",710725,60],["ὁδοὺς",709458,39],["αὐτοῦ",702165,102]],"The meek will he guide in judgment: the meek will he teach his ways."],["10",[["πᾶσαι",710177,192],["αἱ",709436,190],["ὁδοὶ",709458,191],["κυρίου",707996,18],["ἔλεος",704426,15],["καὶ",707031,7],["ἀλήθεια",700656,12],["τοῖς",709436,147],["ἐκζητοῦσιν",704187,349],["τὴν",709436,8],["διαθήκην",703456,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["μαρτύρια",708525,42],["αὐτοῦ",702165,102]],"All the ways of the Lord are mercy and truth to them that seek his covenant and his testimonies."],["11",[["ἕνεκα",704709,0],["τοῦ",709436,20],["ὀνόματός",709666,21],["σου",711945,133],["κύριε",707996,153],["καὶ",707031,7],["ἱλάσῃ",706728,123],["τῇ",709436,100],["ἁμαρτίᾳ",700775,1],["μου",709032,133],["πολλὴ",710646,29],["γάρ",702963,11],["ἐστιν",704093,91]],"For thy name's sake, O Lord, do thou also be merciful to my sin; for it is great."],["12",[["τίς",712867,158],["ἐστιν",704093,91],["ἄνθρωπος",701163,4],["ὁ",709436,3],["φοβούμενος",713532,122],["τὸν",709436,5],["κύριον",707996,6],["νομοθετήσει",709346,127],["αὐτῷ",702165,50],["ἐν",704639,0],["ὁδῷ",709458,1],["ᾗ",709781,108],["ᾑρετίσατο",700469,23]],"Who is the man that fears the Lord? he shall instruct him in the way which he has chosen."],["13",[["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτοῦ",702165,102],["ἐν",704639,0],["ἀγαθοῖς",700106,230],["αὐλισθήσεται",702138,134],["καὶ",707031,7],["τὸ",709436,34],["σπέρμα",712008,15],["αὐτοῦ",702165,102],["κληρονομήσει",707724,127],["γῆν",703083,9]],"His soul shall dwell in prosperity; and his seed shall inherit the earth."],["14",[["κραταίωμα",707876,15],["κύριος",707996,4],["τῶν",709436,80],["φοβουμένων",713532,299],["αὐτόν",702165,85],["καὶ",707031,7],["τὸ",709436,34],["ὄνομα",709666,15],["κυρίου",707996,18],["τῶν",709436,80],["φοβουμένων",713532,299],["αὐτόν",702165,85],["καὶ",707031,7],["ἡ",709436,10],["διαθήκη",703456,12],["αὐτοῦ",702165,102],["τοῦ",709436,20],["δηλῶσαι",703402,106],["αὐτοῖς",702165,151]],"The Lord is the strength of them that fear him; and his covenant is to manifest [truth] to them.",{"s":"d","q":0.63}],["15",[["οἱ",709436,136],["ὀφθαλμοί",709870,52],["μου",709032,133],["διὰ",703417,0],["παντὸς",710177,116],["πρὸς",710844,0],["τὸν",709436,5],["κύριον",707996,6],["ὅτι",709803,7],["αὐτὸς",702165,121],["ἐκσπάσει",704311,127],["ἐκ",704132,0],["παγίδος",709910,17],["τοὺς",709436,58],["πόδας",710707,57],["μου",709032,133]],"Mine eyes are continually to the Lord; for he shall draw my feet out of the snare."],["16",[["ἐπίβλεψον",705088,176],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["καὶ",707031,7],["ἐλέησόν",704418,176],["με",708618,163],["ὅτι",709803,7],["μονογενὴς",708996,14],["καὶ",707031,7],["πτωχός",711076,4],["εἰμι",704093,157],["ἐγώ",704018,164]],"Look upon me, and have mercy upon me; for I am an only child and poor."],["17",[["αἱ",709436,190],["θλίψεις",706276,191],["τῆς",709436,16],["καρδίας",707141,17],["μου",709032,133],["ἐπλατύνθησαν",710508,99],["ἐκ",704132,0],["τῶν",709436,130],["ἀναγκῶν",700925,65],["μου",709032,133],["ἐξάγαγέ",704834,176],["με",708618,163]],"The afflictions of my heart have been multiplied; deliver me from my distresses."],["18",[["ἰδὲ",709725,176],["τὴν",709436,8],["ταπείνωσίν",712719,9],["μου",709032,133],["καὶ",707031,7],["τὸν",709436,5],["κόπον",707825,6],["μου",709032,133],["καὶ",707031,7],["ἄφες",702211,176],["πάσας",710177,119],["τὰς",709436,38],["ἁμαρτίας",700775,39],["μου",709032,133]],"Look upon mine affliction and my trouble; and forgive all my sins."],["19",[["ἰδὲ",709725,176],["τοὺς",709436,58],["ἐχθρούς",705779,57],["μου",709032,133],["ὅτι",709803,7],["ἐπληθύνθησαν",710530,99],["καὶ",707031,7],["μῖσος",708947,15],["ἄδικον",700272,26],["ἐμίσησάν",708935,150],["με",708618,163]],"Look upon mine enemies; for they have been multiplied; and they have hated me with unjust hatred."],["20",[["φύλαξον",713619,176],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["καὶ",707031,7],["ῥῦσαί",711309,300],["με",708618,163],["μὴ",708851,28],["καταισχυνθείην",707257,727],["ὅτι",709803,7],["ἤλπισα",704529,155],["ἐπὶ",705080,0],["σέ",711598,163]],"Keep my soul, and deliver me: let me not be ashamed; for I have hoped in thee."],["21",[["ἄκακοι",700512,138],["καὶ",707031,7],["εὐθεῖς",705602,138],["ἐκολλῶντό",707791,139],["μοι",708974,159],["ὅτι",709803,7],["ὑπέμεινά",713219,155],["σε",711598,163],["κύριε",707996,153]],"The harmless and upright joined themselves to me: for I waited for thee, O Lord."],["22",[["λύτρωσαι",708282,300],["ὁ",709436,3],["θεός",706192,4],["τὸν",709436,5],["Ισραηλ",706839,6],["ἐκ",704132,0],["πασῶν",710177,198],["τῶν",709436,130],["θλίψεων",706276,65],["αὐτοῦ",702165,102]],"Deliver Israel, O God, out of all his afflictions."]]