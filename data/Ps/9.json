[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ὑπὲρ",713111,0],["τῶν",709436,80],["κρυφίων",707930,169],["τοῦ",709436,35],["υἱοῦ",713075,18],["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, a Psalm of David, concerning the secrets of the Son."],["2",[["ἐξομολογήσομαί",704960,181],["σοι",711925,159],["κύριε",707996,153],["ἐν",704639,0],["ὅλῃ",709597,101],["καρδίᾳ",707141,1],["μου",709032,133],["διηγήσομαι",703679,181],["πάντα",710177,68],["τὰ",709436,41],["θαυμάσιά",706136,68],["σου",711945,133]],"I will give thanks to thee, O Lord, with my whole heart; I will recount all thy wonderful works."],["3",[["εὐφρανθήσομαι",705715,180],["καὶ",707031,7],["ἀγαλλιάσομαι",700114,181],["ἐν",704639,0],["σοί",711925,159],["ψαλῶ",714021,165],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["ὕψιστε",713287,564]],"I will be glad and exult in thee: I will sing to thy name, O thou Most High."],["4",[["ἐν",704639,0],["τῷ",709436,53],["ἀποστραφῆναι",701598,179],["τὸν",709436,5],["ἐχθρόν",705779,6],["μου",709032,133],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,0],["ἀσθενήσουσιν",701938,218],["καὶ",707031,7],["ἀπολοῦνται",701513,135],["ἀπὸ",701425,0],["προσώπου",710986,21],["σου",711945,133]],"When mine enemies are turned back, they shall be feeble and perish at thy presence."],["5",[["ὅτι",709803,7],["ἐποίησας",710582,162],["τὴν",709436,8],["κρίσιν",707908,9],["μου",709032,133],["καὶ",707031,7],["τὴν",709436,8],["δίκην",703702,9],["μου",709032,133],["ἐκάθισας",707006,162],["ἐπὶ",705080,0],["θρόνου",706315,18],["ὁ",709436,3],["κρίνων",707905,72],["δικαιοσύνην",703695,9]],"For thou hast maintained my cause and my right; thou satest on the throne, that judgest righteousness."],["6",[["ἐπετίμησας",705305,162],["ἔθνεσιν",704068,96],["καὶ",707031,7],["ἀπώλετο",701513,23],["ὁ",709436,3],["ἀσεβής",701909,14],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτῶν",702165,40],["ἐξήλειψας",704852,162],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18]],"Thou hast rebuked the nations, and the ungodly one has perished; thou hast blotted out their name for ever, even for ever and ever."],["7",[["τοῦ",709436,35],["ἐχθροῦ",705779,18],["ἐξέλιπον",704237,150],["αἱ",709436,190],["ῥομφαῖαι",711291,191],["εἰς",704105,0],["τέλος",712787,25],["καὶ",707031,7],["πόλεις",710612,39],["καθεῖλες",706982,162],["ἀπώλετο",701513,23],["τὸ",709436,34],["μνημόσυνον",708966,15],["αὐτῶν",702165,40],["μετ᾿",708780,0],["ἤχους",706046,57]],"The swords of the enemy have failed utterly; and thou hast destroyed cities: their memorial has been destroyed with a noise,"],["8",[["καὶ",707031,7],["ὁ",709436,3],["κύριος",707996,4],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["μένει",708736,91],["ἡτοίμασεν",705539,2],["ἐν",704639,0],["κρίσει",707908,1],["τὸν",709436,5],["θρόνον",706315,6],["αὐτοῦ",702165,102]],"but the Lord endures for ever: he has prepared his throne for judgment."],["9",[["καὶ",707031,7],["αὐτὸς",702165,121],["κρινεῖ",707905,127],["τὴν",709436,8],["οἰκουμένην",709517,173],["ἐν",704639,0],["δικαιοσύνῃ",703695,1],["κρινεῖ",707905,127],["λαοὺς",708094,57],["ἐν",704639,0],["εὐθύτητι",705603,1]],"And he will judge the world in righteousness, he will judge the nations in uprightness."],["10",[["καὶ",707031,7],["ἐγένετο",703104,23],["κύριος",707996,4],["καταφυγὴ",707485,12],["τῷ",709436,113],["πένητι",710248,114],["βοηθὸς",702748,4],["ἐν",704639,0],["εὐκαιρίαις",705611,76],["ἐν",704639,0],["θλίψει",706276,1]],"The Lord also is become a refuge for the poor, a seasonable help, in affliction."],["11",[["καὶ",707031,7],["ἐλπισάτωσαν",704529,264],["ἐπὶ",705080,0],["σὲ",711598,163],["οἱ",709436,136],["γινώσκοντες",703105,146],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["ὅτι",709803,7],["οὐκ",709805,28],["ἐγκατέλιπες",703967,162],["τοὺς",709436,58],["ἐκζητοῦντάς",704187,235],["σε",711598,163],["κύριε",707996,153]],"And let them that know thy name hope in thee: for thou, O Lord, hast not failed them that diligently seek thee."],["12",[["ψάλατε",714021,74],["τῷ",709436,113],["κυρίῳ",707996,114],["τῷ",709436,113],["κατοικοῦντι",707534,379],["ἐν",704639,0],["Σιων",711816,111],["ἀναγγείλατε",700921,74],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["τὰ",709436,41],["ἐπιτηδεύματα",705301,42],["αὐτοῦ",702165,102]],"Sing praises to the Lord, who dwells in Sion: declare his dealings among the nations."],["13",[["ὅτι",709803,7],["ἐκζητῶν",704187,72],["τὰ",709436,41],["αἵματα",700442,42],["αὐτῶν",702165,40],["ἐμνήσθη",708960,37],["οὐκ",709805,28],["ἐπελάθετο",705187,23],["τῆς",709436,16],["κραυγῆς",707886,17],["τῶν",709436,80],["πενήτων",710248,81]],"For he remembered them, [in] making inquisition for blood: he has not forgotten the supplication of the poor."],["14",[["ἐλέησόν",704418,176],["με",708618,163],["κύριε",707996,153],["ἰδὲ",709725,176],["τὴν",709436,8],["ταπείνωσίν",712719,9],["μου",709032,133],["ἐκ",704132,0],["τῶν",709436,80],["ἐχθρῶν",705779,81],["μου",709032,133],["ὁ",709436,3],["ὑψῶν",713289,72],["με",708618,163],["ἐκ",704132,0],["τῶν",709436,130],["πυλῶν",711082,65],["τοῦ",709436,35],["θανάτου",706096,18]],"Have mercy upon me, O Lord; look upon my affliction [which I suffer] of mine enemies, thou that liftest me up from the gates of death:"],["15",[["ὅπως",709719,7],["ἂν",700900,11],["ἐξαγγείλω",704829,207],["πάσας",710177,119],["τὰς",709436,38],["αἰνέσεις",700457,39],["σου",711945,133],["ἐν",704639,0],["ταῖς",709436,75],["πύλαις",711082,76],["τῆς",709436,16],["θυγατρὸς",706320,17],["Σιων",711816,118],["ἀγαλλιάσομαι",700114,181],["ἐπὶ",705080,0],["τῷ",709436,53],["σωτηρίῳ",712659,54],["σου",711945,133]],"that I may declare all thy praises in the gates of the daughter of Sion: I will exult in thy salvation."],["16",[["ἐνεπάγησαν",704590,99],["ἔθνη",704068,64],["ἐν",704639,0],["διαφθορᾷ",703625,1],["ᾗ",709781,108],["ἐποίησαν",710582,150],["ἐν",704639,0],["παγίδι",709910,1],["ταύτῃ",709858,105],["ᾗ",709781,108],["ἔκρυψαν",707923,150],["συνελήμφθη",712262,37],["ὁ",709436,3],["ποὺς",710707,4],["αὐτῶν",702165,40]],"The heathen are caught in the destruction which they planned: in the very snare which they hid is their foot taken."],["17",[["γινώσκεται",703105,117],["κύριος",707996,4],["κρίματα",707903,42],["ποιῶν",710582,72],["ἐν",704639,0],["τοῖς",709436,95],["ἔργοις",705396,96],["τῶν",709436,130],["χειρῶν",713787,65],["αὐτοῦ",702165,102],["συνελήμφθη",712262,37],["ὁ",709436,3],["ἁμαρτωλός",700776,14],["ᾠδὴ",714091,12],["διαψάλματος",703641,21]],"The Lord is known as executing judgments: the sinner is taken in the works of his hands. A song of Pause."],["18",[["ἀποστραφήτωσαν",701598,51],["οἱ",709436,136],["ἁμαρτωλοὶ",700776,138],["εἰς",704105,0],["τὸν",709436,5],["ᾅδην",700255,6],["πάντα",710177,195],["τὰ",709436,63],["ἔθνη",704068,64],["τὰ",709436,63],["ἐπιλανθανόμενα",705187,210],["τοῦ",709436,35],["θεοῦ",706192,18]],"Let sinners be driven away into Hades, [even] all the nations that forget God."],["19",[["ὅτι",709803,7],["οὐκ",709805,28],["εἰς",704105,0],["τέλος",712787,25],["ἐπιλησθήσεται",705187,134],["ὁ",709436,3],["πτωχός",711076,4],["ἡ",709436,10],["ὑπομονὴ",713226,12],["τῶν",709436,80],["πενήτων",710248,81],["οὐκ",709805,28],["ἀπολεῖται",701513,93],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"For the poor shall not be forgotten for ever: the patience of the needy ones shall not perish for ever."],["20",[["ἀνάστηθι",701173,176],["κύριε",707996,153],["μὴ",708851,28],["κραταιούσθω",707875,407],["ἄνθρωπος",701163,4],["κριθήτωσαν",707905,51],["ἔθνη",704068,64],["ἐνώπιόν",704823,0],["σου",711945,133]],"Arise, O Lord, let not man prevail: let the heathen be judged before thee."],["21",[["κατάστησον",707011,176],["κύριε",707996,153],["νομοθέτην",709347,6],["ἐπ᾿",705080,0],["αὐτούς",702165,62],["γνώτωσαν",703105,264],["ἔθνη",704068,42],["ὅτι",709803,7],["ἄνθρωποί",701163,52],["εἰσιν",704093,197],["διάψαλμα",703641,15]],"Appoint, O Lord, a lawgiver over them: let the heathen know that they are men. Pause."],["22",[["ἵνα",706747,7],["τί",712867,126],["κύριε",707996,153],["ἀφέστηκας",702214,266],["μακρόθεν",708417,28],["ὑπερορᾷς",713154,154],["ἐν",704639,0],["εὐκαιρίαις",705611,76],["ἐν",704639,0],["θλίψει",706276,1]],"Why standest thou afar off, O Lord? [why] dost thou overlook [us] in times of need, in affliction?"],["23",[["ἐν",704639,0],["τῷ",709436,53],["ὑπερηφανεύεσθαι",713136,110],["τὸν",709436,5],["ἀσεβῆ",701909,27],["ἐμπυρίζεται",704622,117],["ὁ",709436,3],["πτωχός",711076,4],["συλλαμβάνονται",712262,269],["ἐν",704639,0],["διαβουλίοις",703431,96],["οἷς",709781,311],["διαλογίζονται",703505,269]],"While the ungodly one acts proudly, the poor is hotly pursued: [the wicked] are taken in the crafty counsels which they imagine."],["24",[["ὅτι",709803,7],["ἐπαινεῖται",705000,117],["ὁ",709436,3],["ἁμαρτωλὸς",700776,14],["ἐν",704639,0],["ταῖς",709436,75],["ἐπιθυμίαις",705147,76],["τῆς",709436,16],["ψυχῆς",714070,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὁ",709436,3],["ἀδικῶν",700269,72],["ἐνευλογεῖται",704720,117]],"Because the sinner praises himself for the desires of his heart; and the unjust one blesses himself."],["25",[["παρώξυνεν",710164,2],["τὸν",709436,5],["κύριον",707996,6],["ὁ",709436,3],["ἁμαρτωλός",700776,14],["κατὰ",707200,0],["τὸ",709436,24],["πλῆθος",710529,25],["τῆς",709436,16],["ὀργῆς",709728,17],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐκζητήσει",704187,127],["οὐκ",709805,28],["ἔστιν",704093,91],["ὁ",709436,3],["θεὸς",706192,4],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102]],"The sinner has provoked the Lord: according to the abundance of his pride he will not seek after [him]: God is not before him."],["26",[["βεβηλοῦνται",702614,269],["αἱ",709436,190],["ὁδοὶ",709458,191],["αὐτοῦ",702165,102],["ἐν",704639,0],["παντὶ",710177,30],["καιρῷ",707047,114],["ἀνταναιρεῖται",701212,117],["τὰ",709436,41],["κρίματά",707903,42],["σου",711945,133],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["πάντων",710177,169],["τῶν",709436,80],["ἐχθρῶν",705779,81],["αὐτοῦ",702165,102],["κατακυριεύσει",707297,127]],"His ways are profane at all times; thy judgments are removed from before him: he will gain the mastery over all his enemies."],["27",[["εἶπεν",705373,2],["γὰρ",702963,11],["ἐν",704639,0],["καρδίᾳ",707141,1],["αὐτοῦ",702165,102],["οὐ",709805,28],["μὴ",708851,28],["σαλευθῶ",711403,321],["ἀπὸ",701425,0],["γενεᾶς",703037,17],["εἰς",704105,0],["γενεὰν",703037,9],["ἄνευ",701137,0],["κακοῦ",707066,116]],"For he has said in his heart, I shall not be moved, [continuing] without evil from generation to generation."],["28",[["οὗ",709781,48],["ἀρᾶς",701665,17],["τὸ",709436,24],["στόμα",712125,25],["αὐτοῦ",702165,102],["γέμει",703036,91],["καὶ",707031,7],["πικρίας",710472,17],["καὶ",707031,7],["δόλου",703787,18],["ὑπὸ",713184,0],["τὴν",709436,8],["γλῶσσαν",703120,9],["αὐτοῦ",702165,102],["κόπος",707825,4],["καὶ",707031,7],["πόνος",710661,4]],"Whose mouth is full of cursing, and bitterness, and fraud: under his tongue are trouble and pain."],["29",[["ἐγκάθηται",703952,117],["ἐνέδρᾳ",704702,1],["μετὰ",708780,0],["πλουσίων",710560,169],["ἐν",704639,0],["ἀποκρύφοις",701497,94],["ἀποκτεῖναι",701498,106],["ἀθῷον",700390,27],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὸν",709436,5],["πένητα",710248,6],["ἀποβλέπουσιν",701430,197]],"He lies in wait with rich [men] in secret places, in order to slay the innocent: his eyes are set against the poor."],["30",[["ἐνεδρεύει",704703,91],["ἐν",704639,0],["ἀποκρύφῳ",701497,97],["ὡς",714148,7],["λέων",708171,4],["ἐν",704639,0],["τῇ",709436,100],["μάνδρᾳ",708473,1],["αὐτοῦ",702165,102],["ἐνεδρεύει",704703,91],["τοῦ",709436,20],["ἁρπάσαι",701804,106],["πτωχόν",711076,6],["ἁρπάσαι",701804,106],["πτωχὸν",711076,6],["ἐν",704639,0],["τῷ",709436,53],["ἑλκύσαι",704508,106],["αὐτόν",702165,85]],"He lies in wait in secret as a lion in his den: he lies in wait to ravish the poor, to ravish the poor when he draws him [after him]: he will bring him down in his snare."],["31",[["ἐν",704639,0],["τῇ",709436,100],["παγίδι",709910,1],["αὐτοῦ",702165,102],["ταπεινώσει",712719,1],["αὐτόν",702165,85],["κύψει",707989,127],["καὶ",707031,7],["πεσεῖται",710481,93],["ἐν",704639,0],["τῷ",709436,53],["αὐτὸν",702165,85],["κατακυριεῦσαι",707297,106],["τῶν",709436,80],["πενήτων",710248,81]],"He will bow down and fall when he has mastered the poor."],["32",[["εἶπεν",705373,2],["γὰρ",702963,11],["ἐν",704639,0],["καρδίᾳ",707141,1],["αὐτοῦ",702165,102],["ἐπιλέλησται",705187,326],["ὁ",709436,3],["θεός",706192,4],["ἀπέστρεψεν",701598,2],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["τοῦ",709436,20],["μὴ",708851,28],["βλέπειν",702740,55],["εἰς",704105,0],["τέλος",712787,25]],"For he has said in his heart, God has forgotten: he has turned away his face so as never to look."],["33",[["ἀνάστηθι",701173,176],["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["ὑψωθήτω",713289,22],["ἡ",709436,10],["χείρ",713787,12],["σου",711945,133],["μὴ",708851,28],["ἐπιλάθῃ",705187,172],["τῶν",709436,80],["πενήτων",710248,81]],"Arise, O Lord God; let thy hand be lifted up: forget not the poor."],["34",[["ἕνεκεν",704709,0],["τίνος",712867,340],["παρώξυνεν",710164,2],["ὁ",709436,3],["ἀσεβὴς",701909,14],["τὸν",709436,5],["θεόν",706192,6],["εἶπεν",705373,2],["γὰρ",702963,11],["ἐν",704639,0],["καρδίᾳ",707141,1],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐκζητήσει",704187,127]],"Wherefore has the wicked provoked God? for he has said in his heart, He will not require [it]."],["35",[["βλέπεις",702740,154],["ὅτι",709803,7],["σὺ",712181,164],["πόνον",710661,6],["καὶ",707031,7],["θυμὸν",706334,6],["κατανοεῖς",707341,154],["τοῦ",709436,20],["παραδοῦναι",710014,106],["αὐτοὺς",702165,62],["εἰς",704105,0],["χεῖράς",713787,39],["σου",711945,133],["σοὶ",711925,159],["οὖν",709835,11],["ἐγκαταλέλειπται",703967,187],["ὁ",709436,3],["πτωχός",711076,4],["ὀρφανῷ",709779,30],["σὺ",712181,164],["ἦσθα",704093,363],["βοηθῶν",702748,81]],"Thou seest [it]; for thou dost observe trouble and wrath, to deliver them into thy hands: the poor has been left to thee; thou wast a helper to the orphan."],["36",[["σύντριψον",712520,176],["τὸν",709436,5],["βραχίονα",702808,6],["τοῦ",709436,35],["ἁμαρτωλοῦ",700776,116],["καὶ",707031,7],["πονηροῦ",710660,116],["ζητηθήσεται",705879,134],["ἡ",709436,10],["ἁμαρτία",700775,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["εὑρεθῇ",705676,384],["δι᾿",703417,0],["αὐτήν",702165,104]],"Break thou the arm of the sinner and wicked man: his sin shall be sought for, and shall not be found."],["37",[["βασιλεύσει",702581,127],["κύριος",707996,4],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18],["ἀπολεῖσθε",701513,124],["ἔθνη",704068,589],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17],["αὐτοῦ",702165,102]],"The Lord shall reign for ever, even for ever and ever: ye Gentiles shall perish out of his land."],["38",[["τὴν",709436,8],["ἐπιθυμίαν",705147,9],["τῶν",709436,80],["πενήτων",710248,81],["εἰσήκουσεν",704108,2],["κύριος",707996,4],["τὴν",709436,8],["ἑτοιμασίαν",705540,9],["τῆς",709436,16],["καρδίας",707141,17],["αὐτῶν",702165,40],["προσέσχεν",710895,2],["τὸ",709436,24],["οὖς",709852,25],["σου",711945,133]],"The Lord has heard the desire of the poor: thine ear has inclined to the preparation of their heart;"],["39",[["κρῖναι",707905,106],["ὀρφανῷ",709779,30],["καὶ",707031,7],["ταπεινῷ",712714,30],["ἵνα",706747,7],["μὴ",708851,28],["προσθῇ",710965,172],["ἔτι",705538,28],["τοῦ",709436,20],["μεγαλαυχεῖν",708623,55],["ἄνθρωπος",701163,4],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"to plead for the orphan and afflicted, that man may no more boast upon the earth."]]