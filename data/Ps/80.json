[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ὑπὲρ",713111,0],["τῶν",709436,130],["ληνῶν",708176,65],["τῷ",709436,113],["Ασαφ",701894,114],["ψαλμός",714022,4]],"For the end, a Psalm for Asaph, concerning the wine-presses."],["2",[["ἀγαλλιᾶσθε",700114,73],["τῷ",709436,113],["θεῷ",706192,114],["τῷ",709436,113],["βοηθῷ",702748,114],["ἡμῶν",705999,145],["ἀλαλάξατε",700632,74],["τῷ",709436,113],["θεῷ",706192,114],["Ιακωβ",706401,18]],"Rejoice ye in God our helper; shout aloud to the God of Jacob."],["3",[["λάβετε",708076,74],["ψαλμὸν",714022,6],["καὶ",707031,7],["δότε",703654,74],["τύμπανον",713019,25],["ψαλτήριον",714023,25],["τερπνὸν",712802,46],["μετὰ",708780,0],["κιθάρας",707669,17]],"Take a psalm, and produce the timbrel, the pleasant psaltery with the harp."],["4",[["σαλπίσατε",711425,74],["ἐν",704639,0],["νεομηνίᾳ",709371,1],["σάλπιγγι",711424,1],["ἐν",704639,0],["εὐσήμῳ",705688,101],["ἡμέρᾳ",705984,1],["ἑορτῆς",704990,17],["ἡμῶν",705999,145]],"Blow the trumpet at the new moon, in the glorious day of your feast."],["5",[["ὅτι",709803,7],["πρόσταγμα",710959,15],["τῷ",709436,113],["Ισραηλ",706839,114],["ἐστὶν",704093,91],["καὶ",707031,7],["κρίμα",707903,15],["τῷ",709436,113],["θεῷ",706192,114],["Ιακωβ",706401,114]],"For [this] is an ordinance for Israel, and a statute of the God of Jacob."],["6",[["μαρτύριον",708525,25],["ἐν",704639,0],["τῷ",709436,113],["Ιωσηφ",706948,114],["ἔθετο",712849,23],["αὐτὸν",702165,85],["ἐν",704639,0],["τῷ",709436,53],["ἐξελθεῖν",704909,106],["αὐτὸν",702165,85],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["γλῶσσαν",703120,9],["ἣν",709781,131],["οὐκ",709805,28],["ἔγνω",703105,2],["ἤκουσεν",700587,2]],"He made it [to be] a testimony in Joseph, when he came forth out of the land of Egypt: he heard a language which he understood not."],["7",[["ἀπέστησεν",702214,2],["ἀπὸ",701425,0],["ἄρσεων",701820,65],["τὸν",709436,5],["νῶτον",709403,25],["αὐτοῦ",702165,102],["αἱ",709436,190],["χεῖρες",713787,191],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,113],["κοφίνῳ",707865,114],["ἐδούλευσαν",703814,150]],"He removed his back from burdens: his hands slaved in making the baskets."],["8",[["ἐν",704639,0],["θλίψει",706276,1],["ἐπεκαλέσω",705153,174],["με",708618,163],["καὶ",707031,7],["ἐρρυσάμην",711309,161],["σε",711598,163],["ἐπήκουσά",705009,155],["σου",711945,133],["ἐν",704639,0],["ἀποκρύφῳ",701497,97],["καταιγίδος",707254,17],["ἐδοκίμασά",703776,155],["σε",711598,163],["ἐπὶ",705080,0],["ὕδατος",713071,21],["ἀντιλογίας",701249,17],["διάψαλμα",703641,15]],"Thou didst call upon me in trouble, and I delivered thee; I heard thee in the secret place of the storm: I proved thee at the water of Strife. Pause."],["9",[["ἄκουσον",700587,176],["λαός",708094,4],["μου",709032,133],["καὶ",707031,7],["διαμαρτύρομαί",703513,254],["σοι",711925,159],["Ισραηλ",706839,153],["ἐὰν",703912,7],["ἀκούσῃς",700587,175],["μου",709032,133]],"Hear, my people, and I will speak to thee, O Israel; and I will testify to thee: if thou wilt hearken to me;"],["10",[["οὐκ",709805,28],["ἔσται",704093,93],["ἐν",704639,0],["σοὶ",711925,159],["θεὸς",706192,4],["πρόσφατος",710972,14],["οὐδὲ",709816,7],["προσκυνήσεις",710925,166],["θεῷ",706192,114],["ἀλλοτρίῳ",700699,30]],"there shall be no new god in thee; neither shalt thou worship a strange god."],["11",[["ἐγὼ",704018,164],["γάρ",702963,11],["εἰμι",704093,157],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ὁ",709436,3],["ἀναγαγών",700933,182],["σε",711598,163],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["πλάτυνον",710508,176],["τὸ",709436,24],["στόμα",712125,25],["σου",711945,133],["καὶ",707031,7],["πληρώσω",710543,165],["αὐτό",702165,129]],"For I am the Lord thy God, that brought thee out of the land of Egypt: open thy mouth wide, and I will fill it."],["12",[["καὶ",707031,7],["οὐκ",709805,28],["ἤκουσεν",700587,2],["ὁ",709436,3],["λαός",708094,4],["μου",709032,133],["τῆς",709436,16],["φωνῆς",713640,17],["μου",709032,133],["καὶ",707031,7],["Ισραηλ",706839,4],["οὐ",709805,28],["προσέσχεν",710895,2],["μοι",708974,159]],"But my people hearkened not to my voice; and Israel gave no heed to me."],["13",[["καὶ",707031,7],["ἐξαπέστειλα",704872,155],["αὐτοὺς",702165,62],["κατὰ",707200,0],["τὰ",709436,41],["ἐπιτηδεύματα",705301,42],["τῶν",709436,130],["καρδιῶν",707141,65],["αὐτῶν",702165,40],["πορεύσονται",710667,135],["ἐν",704639,0],["τοῖς",709436,95],["ἐπιτηδεύμασιν",705301,96],["αὐτῶν",702165,40]],"So I let them go after the ways of their own hearts: they will go on in their own ways."],["14",[["εἰ",704071,7],["ὁ",709436,3],["λαός",708094,4],["μου",709032,133],["ἤκουσέν",700587,2],["μου",709032,133],["Ισραηλ",706839,4],["ταῖς",709436,75],["ὁδοῖς",709458,76],["μου",709032,133],["εἰ",704071,7],["ἐπορεύθη",710667,37]],"If my people had hearkened to me, if Israel had walked in my ways,"],["15",[["ἐν",704639,0],["τῷ",709436,113],["μηδενὶ",708857,30],["ἂν",700900,11],["τοὺς",709436,58],["ἐχθροὺς",705779,57],["αὐτῶν",702165,40],["ἐταπείνωσα",712717,155],["καὶ",707031,7],["ἐπὶ",705080,0],["τοὺς",709436,58],["θλίβοντας",706274,235],["αὐτοὺς",702165,62],["ἐπέβαλον",705083,150],["τὴν",709436,8],["χεῖρά",713787,9],["μου",709032,133]],"I should have put down their enemies very quickly, and should have laid my hand upon those that afflicted them."],["16",[["οἱ",709436,136],["ἐχθροὶ",705779,52],["κυρίου",707996,18],["ἐψεύσαντο",714040,189],["αὐτῷ",702165,50],["καὶ",707031,7],["ἔσται",704093,93],["ὁ",709436,3],["καιρὸς",707047,4],["αὐτῶν",702165,40],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"The Lord's enemies [should have] lied to him: but their time shall be for ever."],["17",[["καὶ",707031,7],["ἐψώμισεν",714077,2],["αὐτοὺς",702165,62],["ἐκ",704132,0],["στέατος",712054,21],["πυροῦ",711101,18],["καὶ",707031,7],["ἐκ",704132,0],["πέτρας",710443,17],["μέλι",708700,9],["ἐχόρτασεν",713919,2],["αὐτούς",702165,62]],"And he fed them with the fat of wheat; and satisfied them with honey out of the rock."]]