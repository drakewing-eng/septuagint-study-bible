[["1",[["αλληλουια",700688,88],["Αγγαιου",700135,18],["καὶ",707031,7],["Ζαχαριου",705847,18],["ἐπαίνει",705000,240],["Ιερουσαλημ",706644,258],["τὸν",709436,5],["κύριον",707996,6],["αἴνει",700459,240],["τὸν",709436,5],["θεόν",706192,6],["σου",711945,133],["Σιων",711816,258]],"Alleluia, [a Psalm] of Aggæus and Zacharias. Praise the Lord, O Jerusalem; praise thy God, O Sion."],["2",[["ὅτι",709803,7],["ἐνίσχυσεν",704750,2],["τοὺς",709436,58],["μοχλοὺς",709040,57],["τῶν",709436,130],["πυλῶν",711082,65],["σου",711945,133],["εὐλόγησεν",705631,2],["τοὺς",709436,58],["υἱούς",713075,57],["σου",711945,133],["ἐν",704639,0],["σοί",711925,159]],"For he has strengthened the bars of thy gates; he has blessed thy children within thee."],["3",[["ὁ",709436,3],["τιθεὶς",712849,72],["τὰ",709436,41],["ὅριά",709749,42],["σου",711945,133],["εἰρήνην",704098,9],["καὶ",707031,7],["στέαρ",712054,25],["πυροῦ",711101,18],["ἐμπιπλῶν",704592,72],["σε",711598,163]],"He makes thy borders peaceful, and fills thee with the flour of wheat."],["4",[["ὁ",709436,3],["ἀποστέλλων",701592,72],["τὸ",709436,24],["λόγιον",708233,25],["αὐτοῦ",702165,559],["τῇ",709436,100],["γῇ",703083,1],["ἕως",705792,0],["τάχους",712747,21],["δραμεῖται",712931,93],["ὁ",709436,3],["λόγος",708236,4],["αὐτοῦ",702165,559]],"He sends his oracle to the earth: his word will run swiftly."],["5",[["τοῦ",709436,35],["διδόντος",703654,152],["χιόνα",713870,9],["ὡσεὶ",714159,28],["ἔριον",705426,25],["ὁμίχλην",709615,9],["ὡσεὶ",714159,28],["σποδὸν",712022,9],["πάσσοντος",710179,152]],"He gives snow like wool: he scatters the mist like ashes."],["6",[["βάλλοντος",702487,152],["κρύσταλλον",707926,6],["αὐτοῦ",702165,559],["ὡσεὶ",714159,28],["ψωμούς",714078,57],["κατὰ",707200,0],["πρόσωπον",710986,25],["ψύχους",714073,21],["αὐτοῦ",702165,559],["τίς",712867,158],["ὑποστήσεται",713281,93]],"Casting [forth] his ice like morsels: who shall stand before his cold?"],["7",[["ἀποστελεῖ",701592,127],["τὸν",709436,5],["λόγον",708236,6],["αὐτοῦ",702165,559],["καὶ",707031,7],["τήξει",712839,127],["αὐτά",702165,71],["πνεύσει",710570,127],["τὸ",709436,24],["πνεῦμα",710566,25],["αὐτοῦ",702165,559],["καὶ",707031,7],["ῥυήσεται",711305,93],["ὕδατα",713071,25]],"He shall send out his word, and melt them: he shall blow [with] his wind, and the waters shall flow."],["8",[["ἀπαγγέλλων",701321,72],["τὸν",709436,5],["λόγον",708236,6],["αὐτοῦ",702165,559],["τῷ",709436,113],["Ιακωβ",706401,114],["δικαιώματα",703697,42],["καὶ",707031,7],["κρίματα",707903,42],["αὐτοῦ",702165,559],["τῷ",709436,113],["Ισραηλ",706839,114]],"He sends his word to Jacob, his ordinances and judgments to Israel."],["9",[["οὐκ",709805,28],["ἐποίησεν",710582,2],["οὕτως",709859,28],["παντὶ",710177,97],["ἔθνει",704068,54],["καὶ",707031,7],["τὰ",709436,41],["κρίματα",707903,42],["αὐτοῦ",702165,559],["οὐκ",709805,28],["ἐδήλωσεν",703402,2],["αὐτοῖς",702165,623]],"He has not done so to any [other] nation; and he has not shewn them his judgments."]]