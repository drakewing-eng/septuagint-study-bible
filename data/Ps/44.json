[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ὑπὲρ",713111,0],["τῶν",709436,80],["ἀλλοιωθησομένων",700694,728],["τοῖς",709436,147],["υἱοῖς",713075,148],["Κορε",707833,118],["εἰς",704105,0],["σύνεσιν",712460,9],["ᾠδὴ",714091,12],["ὑπὲρ",713111,0],["τοῦ",709436,35],["ἀγαπητοῦ",700124,116]],"For the end, for alternate [strains] by the sons of Core; for instruction, a Song concerning the beloved."],["2",[["ἐξηρεύξατο",704904,23],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["λόγον",708236,6],["ἀγαθόν",700106,27],["λέγω",708124,157],["ἐγὼ",704018,164],["τὰ",709436,41],["ἔργα",705396,42],["μου",709032,133],["τῷ",709436,113],["βασιλεῖ",702580,114],["ἡ",709436,10],["γλῶσσά",703120,12],["μου",709032,133],["κάλαμος",707082,4],["γραμματέως",703185,18],["ὀξυγράφου",709679,116]],"My heart has uttered a good matter: I declare my works to the king: my tongue is the pen of a quick writer."],["3",[["ὡραῖος",714132,14],["κάλλει",707093,54],["παρὰ",709995,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["τῶν",709436,80],["ἀνθρώπων",701163,81],["ἐξεχύθη",704368,37],["χάρις",713735,12],["ἐν",704639,0],["χείλεσίν",713781,96],["σου",711945,133],["διὰ",703417,0],["τοῦτο",709858,129],["εὐλόγησέν",705631,2],["σε",711598,163],["ὁ",709436,3],["θεὸς",706192,4],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"Thou art more beautiful than the sons of men: grace has been shed forth on thy lips: therefore God has blessed thee for ever."],["4",[["περίζωσαι",710317,300],["τὴν",709436,8],["ῥομφαίαν",711291,9],["σου",711945,133],["ἐπὶ",705080,0],["τὸν",709436,5],["μηρόν",708885,6],["σου",711945,133],["δυνατέ",703845,564],["τῇ",709436,100],["ὡραιότητί",714133,1],["σου",711945,133],["καὶ",707031,7],["τῷ",709436,53],["κάλλει",707093,54],["σου",711945,133]],"Gird thy sword upon thy thigh, O Mighty One, in thy comeliness, and in thy beauty;"],["5",[["καὶ",707031,7],["ἔντεινον",704790,176],["καὶ",707031,7],["κατευοδοῦ",707523,240],["καὶ",707031,7],["βασίλευε",702581,240],["ἕνεκεν",704709,0],["ἀληθείας",700656,17],["καὶ",707031,7],["πραΰτητος",710726,17],["καὶ",707031,7],["δικαιοσύνης",703695,17],["καὶ",707031,7],["ὁδηγήσει",709448,127],["σε",711598,163],["θαυμαστῶς",706140,28],["ἡ",709436,10],["δεξιά",703360,29],["σου",711945,133]],"and bend [thy bow], and prosper, and reign, because of truth and meekness and righteousness; and thy right hand shall guide thee wonderfully."],["6",[["τὰ",709436,63],["βέλη",702644,64],["σου",711945,133],["ἠκονημένα",700570,443],["δυνατέ",703845,564],["λαοὶ",708094,52],["ὑποκάτω",713204,0],["σου",711945,133],["πεσοῦνται",710481,135],["ἐν",704639,0],["καρδίᾳ",707141,1],["τῶν",709436,80],["ἐχθρῶν",705779,81],["τοῦ",709436,35],["βασιλέως",702580,18]],"Thy weapons are sharpened, Mighty One, (the nations shall fall under thee) [they are] in the heart of the king's enemies."],["7",[["ὁ",709436,3],["θρόνος",706315,4],["σου",711945,133],["ὁ",709436,3],["θεός",706192,4],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18],["ῥάβδος",711135,12],["εὐθύτητος",705603,17],["ἡ",709436,10],["ῥάβδος",711135,12],["τῆς",709436,16],["βασιλείας",702577,17],["σου",711945,133]],"Thy throne, O God, is for ever and ever: the sceptre of thy kingdom is a sceptre of righteousness."],["8",[["ἠγάπησας",700120,162],["δικαιοσύνην",703695,9],["καὶ",707031,7],["ἐμίσησας",708935,162],["ἀνομίαν",701192,9],["διὰ",703417,0],["τοῦτο",709858,129],["ἔχρισέν",713965,2],["σε",711598,163],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ἔλαιον",704380,25],["ἀγαλλιάσεως",700113,17],["παρὰ",709995,0],["τοὺς",709436,58],["μετόχους",708839,60],["σου",711945,133]],"Thou hast loved righteousness, and hated iniquity: therefore God, thy God, has anointed thee with the oil of gladness beyond thy fellows."],["9",[["σμύρνα",711914,12],["καὶ",707031,7],["στακτὴ",712043,12],["καὶ",707031,7],["κασία",707194,12],["ἀπὸ",701425,0],["τῶν",709436,43],["ἱματίων",706742,44],["σου",711945,133],["ἀπὸ",701425,0],["βάρεων",702542,65],["ἐλεφαντίνων",704436,169],["ἐξ",704132,0],["ὧν",709781,252],["ηὔφρανάν",705715,150],["σε",711598,163]],"Myrrh, and stacte, and cassia [are exhaled] from thy garments, [and] out of the ivory palaces,"],["10",[["θυγατέρες",706320,191],["βασιλέων",702580,81],["ἐν",704639,0],["τῇ",709436,100],["τιμῇ",712856,1],["σου",711945,133],["παρέστη",710152,2],["ἡ",709436,10],["βασίλισσα",702584,12],["ἐκ",704132,0],["δεξιῶν",703360,169],["σου",711945,133],["ἐν",704639,0],["ἱματισμῷ",706744,114],["διαχρύσῳ",703638,30],["περιβεβλημένη",710294,203],["πεποικιλμένη",710587,451]],"with which kings' daughters have gladdened thee for thine honour: the queen stood by on thy right hand, clothed in vesture wrought with gold, [and] arrayed in divers colours."],["11",[["ἄκουσον",700587,176],["θύγατερ",706320,258],["καὶ",707031,7],["ἰδὲ",709725,176],["καὶ",707031,7],["κλῖνον",707738,176],["τὸ",709436,24],["οὖς",709852,25],["σου",711945,133],["καὶ",707031,7],["ἐπιλάθου",705187,300],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133],["καὶ",707031,7],["τοῦ",709436,35],["οἴκου",709516,18],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133]],"Hear, O daughter, and see, and incline thine ear; forget also thy people, and thy father's house."],["12",[["ὅτι",709803,7],["ἐπεθύμησεν",705141,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["τοῦ",709436,20],["κάλλους",707093,21],["σου",711945,133],["ὅτι",709803,7],["αὐτός",702165,121],["ἐστιν",704093,91],["ὁ",709436,3],["κύριός",707996,4],["σου",711945,133]],"Because the king has desired thy beauty; for he is thy Lord."],["13",[["καὶ",707031,7],["προσκυνήσουσιν",710925,218],["αὐτῷ",702165,50],["θυγατέρες",706320,191],["Τύρου",713028,17],["ἐν",704639,0],["δώροις",703907,96],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["λιτανεύσουσιν",708221,218],["οἱ",709436,136],["πλούσιοι",710560,138],["τοῦ",709436,35],["λαοῦ",708094,18]],"And the daughter of Tyre shall adore him with gifts; the rich of the people of the land shall supplicate thy favour."],["14",[["πᾶσα",710177,29],["ἡ",709436,10],["δόξα",703791,12],["αὐτῆς",702165,86],["θυγατρὸς",706320,17],["βασιλέως",702580,18],["ἔσωθεν",705523,28],["ἐν",704639,0],["κροσσωτοῖς",707916,230],["χρυσοῖς",713971,230],["περιβεβλημένη",710294,203],["πεποικιλμένη",710587,451]],"All her glory [is that] of the daughter of the king of Esebon, robed [as she is] in golden fringed garments,"],["15",[["ἀπενεχθήσονται",701632,144],["τῷ",709436,113],["βασιλεῖ",702580,114],["παρθένοι",710148,191],["ὀπίσω",709697,0],["αὐτῆς",702165,86],["αἱ",709436,190],["πλησίον",710547,28],["αὐτῆς",702165,86],["ἀπενεχθήσονταί",701632,144],["σοι",711925,159]],"in embroidered [clothing]: virgins shall be brought to the king after her: her fellows shall be brought to thee."],["16",[["ἀπενεχθήσονται",701632,144],["ἐν",704639,0],["εὐφροσύνῃ",705717,1],["καὶ",707031,7],["ἀγαλλιάσει",700113,1],["ἀχθήσονται",700209,144],["εἰς",704105,0],["ναὸν",709191,6],["βασιλέως",702580,18]],"They shall be brought with gladness and exultation: they shall be led into the king's temple."],["17",[["ἀντὶ",701227,0],["τῶν",709436,80],["πατέρων",710189,81],["σου",711945,133],["ἐγενήθησάν",703104,99],["σοι",711925,159],["υἱοί",713075,52],["καταστήσεις",707011,166],["αὐτοὺς",702165,62],["ἄρχοντας",701862,57],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9]],"Instead of thy fathers children are born to thee: thou shalt make them princes over all the earth."],["18",[["μνησθήσονται",708923,144],["τοῦ",709436,20],["ὀνόματός",709666,21],["σου",711945,133],["ἐν",704639,0],["πάσῃ",710177,101],["γενεᾷ",703037,1],["καὶ",707031,7],["γενεᾷ",703037,1],["διὰ",703417,0],["τοῦτο",709858,129],["λαοὶ",708094,52],["ἐξομολογήσονταί",704960,135],["σοι",711925,159],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18]],"They shall make mention of thy name from generation to generation: therefore shall the nations give thanks to thee for ever, even for ever and ever."]]