[["1",[["τοῦ",709436,35],["Δαυιδ",703232,18],["μὴ",708851,28],["παραζήλου",710021,240],["ἐν",704639,0],["πονηρευομένοις",710657,341],["μηδὲ",708855,7],["ζήλου",705871,18],["τοὺς",709436,58],["ποιοῦντας",710582,235],["τὴν",709436,8],["ἀνομίαν",701192,9]],"[A Psalm] of David. Fret not thyself because of evil-doers, neither be envious of them that do iniquity."],["2",[["ὅτι",709803,7],["ὡσεὶ",714159,28],["χόρτος",713923,4],["ταχὺ",712748,195],["ἀποξηρανθήσονται",701539,144],["καὶ",707031,7],["ὡσεὶ",714159,28],["λάχανα",708114,64],["χλόης",713877,17],["ταχὺ",712748,195],["ἀποπεσοῦνται",701546,135]],"For they shall soon be withered as the grass, and shall soon fall away as the green herbs."],["3",[["ἔλπισον",704529,176],["ἐπὶ",705080,0],["κύριον",707996,6],["καὶ",707031,7],["ποίει",710582,240],["χρηστότητα",713959,9],["καὶ",707031,7],["κατασκήνου",707423,240],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ποιμανθήσῃ",710594,364],["ἐπὶ",705080,0],["τῷ",709436,113],["πλούτῳ",710563,114],["αὐτῆς",702165,86]],"Hope in the Lord, and do good; and dwell on the land, and thou shalt be fed with the wealth of it."],["4",[["κατατρύφησον",707465,176],["τοῦ",709436,35],["κυρίου",707996,18],["καὶ",707031,7],["δώσει",703654,127],["σοι",711925,159],["τὰ",709436,41],["αἰτήματα",700490,42],["τῆς",709436,16],["καρδίας",707141,17],["σου",711945,133]],"Delight [thyself] in the Lord; and he shall grant thee the requests of thine heart."],["5",[["ἀποκάλυψον",701474,176],["πρὸς",710844,0],["κύριον",707996,6],["τὴν",709436,8],["ὁδόν",709458,9],["σου",711945,133],["καὶ",707031,7],["ἔλπισον",704529,176],["ἐπ᾿",705080,0],["αὐτόν",702165,85],["καὶ",707031,7],["αὐτὸς",702165,121],["ποιήσει",710582,127]],"Disclose thy way to the Lord, and hope in him; and he shall bring [it] to pass."],["6",[["καὶ",707031,7],["ἐξοίσει",704356,127],["ὡς",714148,7],["φῶς",713642,25],["τὴν",709436,8],["δικαιοσύνην",703695,9],["σου",711945,133],["καὶ",707031,7],["τὸ",709436,24],["κρίμα",707903,25],["σου",711945,133],["ὡς",714148,7],["μεσημβρίαν",708758,9]],"And he shall bring forth thy righteousness as the light, and thy judgment as the noon-day."],["7",[["ὑποτάγηθι",713250,176],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["ἱκέτευσον",706716,176],["αὐτόν",702165,85],["μὴ",708851,28],["παραζήλου",710021,240],["ἐν",704639,0],["τῷ",709436,113],["κατευοδουμένῳ",707523,241],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["αὐτοῦ",702165,102],["ἐν",704639,0],["ἀνθρώπῳ",701163,114],["ποιοῦντι",710582,379],["παρανομίας",710079,39]],"Submit thyself to the Lord, and supplicate him: fret not thyself because of him that prospers in his way, at the man that does unlawful deeds."],["8",[["παῦσαι",710202,300],["ἀπὸ",701425,0],["ὀργῆς",709728,17],["καὶ",707031,7],["ἐγκατάλιπε",703967,176],["θυμόν",706334,6],["μὴ",708851,28],["παραζήλου",710021,240],["ὥστε",714164,7],["πονηρεύεσθαι",710657,110]],"Cease from anger, and forsake wrath: fret not thyself so as to do evil."],["9",[["ὅτι",709803,7],["οἱ",709436,136],["πονηρευόμενοι",710657,348],["ἐξολεθρευθήσονται",704956,144],["οἱ",709436,136],["δὲ",703303,11],["ὑπομένοντες",713219,146],["τὸν",709436,5],["κύριον",707996,6],["αὐτοὶ",702165,201],["κληρονομήσουσιν",707724,218],["γῆν",703083,9]],"For evil-doers shall be destroyed: but they that wait on the Lord, they shall inherit the land."],["10",[["καὶ",707031,7],["ἔτι",705538,28],["ὀλίγον",709568,27],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ὑπάρξῃ",713104,172],["ὁ",709436,3],["ἁμαρτωλός",700776,14],["καὶ",707031,7],["ζητήσεις",705879,166],["τὸν",709436,5],["τόπον",712903,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["εὕρῃς",705676,175]],"And yet a little while, and the sinner shall not be, and thou shalt seek for his place, and shalt not find [it]."],["11",[["οἱ",709436,136],["δὲ",703303,11],["πραεῖς",710725,138],["κληρονομήσουσιν",707724,218],["γῆν",703083,9],["καὶ",707031,7],["κατατρυφήσουσιν",707465,218],["ἐπὶ",705080,0],["πλήθει",710529,54],["εἰρήνης",704098,17]],"But the meek shall inherit the earth; and shall delight [themselves] in the abundance of peace."],["12",[["παρατηρήσεται",710110,93],["ὁ",709436,3],["ἁμαρτωλὸς",700776,14],["τὸν",709436,5],["δίκαιον",703694,27],["καὶ",707031,7],["βρύξει",702822,127],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["τοὺς",709436,58],["ὀδόντας",709461,57],["αὐτοῦ",702165,102]],"The sinner will watch for the righteous, and gnash his teeth upon him."],["13",[["ὁ",709436,3],["δὲ",703303,11],["κύριος",707996,4],["ἐκγελάσεται",704157,93],["αὐτόν",702165,85],["ὅτι",709803,7],["προβλέπει",710770,91],["ὅτι",709803,7],["ἥξει",705956,127],["ἡ",709436,10],["ἡμέρα",705984,12],["αὐτοῦ",702165,102]],"But the Lord shall laugh at him: for he foresees that his day will come."],["14",[["ῥομφαίαν",711291,9],["ἐσπάσαντο",712003,189],["οἱ",709436,136],["ἁμαρτωλοί",700776,138],["ἐνέτειναν",704790,150],["τόξον",712898,25],["αὐτῶν",702165,40],["τοῦ",709436,20],["καταβαλεῖν",707203,106],["πτωχὸν",711076,6],["καὶ",707031,7],["πένητα",710248,6],["τοῦ",709436,20],["σφάξαι",712571,106],["τοὺς",709436,58],["εὐθεῖς",705602,60],["τῇ",709436,100],["καρδίᾳ",707141,1]],"Sinners have drawn their swords, they have bent their bow, to cast down the poor and needy one, [and] to slay the upright in heart."],["15",[["ἡ",709436,10],["ῥομφαία",711291,12],["αὐτῶν",702165,40],["εἰσέλθοι",704114,225],["εἰς",704105,0],["τὴν",709436,8],["καρδίαν",707141,9],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,63],["τόξα",712898,64],["αὐτῶν",702165,40],["συντριβείησαν",712520,393]],"Let their sword enter into their [own] heart, and their bows be broken."],["16",[["κρεῖσσον",707890,26],["ὀλίγον",709568,26],["τῷ",709436,113],["δικαίῳ",703694,30],["ὑπὲρ",713111,0],["πλοῦτον",710563,6],["ἁμαρτωλῶν",700776,169],["πολύν",710646,27]],"A little is better to the righteous than abundant wealth of sinners."],["17",[["ὅτι",709803,7],["βραχίονες",702808,52],["ἁμαρτωλῶν",700776,169],["συντριβήσονται",712520,144],["ὑποστηρίζει",713245,91],["δὲ",703303,11],["τοὺς",709436,58],["δικαίους",703694,60],["κύριος",707996,4]],"For the arms of sinners shall be broken; but the Lord supports the righteous."],["18",[["γινώσκει",703105,91],["κύριος",707996,4],["τὰς",709436,38],["ὁδοὺς",709458,39],["τῶν",709436,80],["ἀμώμων",700895,169],["καὶ",707031,7],["ἡ",709436,10],["κληρονομία",707725,12],["αὐτῶν",702165,40],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἔσται",704093,93]],"The Lord knows the ways of the perfect; and their inheritance shall be for ever."],["19",[["οὐ",709805,28],["καταισχυνθήσονται",707257,144],["ἐν",704639,0],["καιρῷ",707047,114],["πονηρῷ",710660,30],["καὶ",707031,7],["ἐν",704639,0],["ἡμέραις",705984,76],["λιμοῦ",708210,18],["χορτασθήσονται",713919,144]],"They shall not be ashamed in an evil time; and in days of famine they shall be satisfied."],["20",[["ὅτι",709803,7],["οἱ",709436,136],["ἁμαρτωλοὶ",700776,138],["ἀπολοῦνται",701513,135],["οἱ",709436,136],["δὲ",703303,11],["ἐχθροὶ",705779,52],["τοῦ",709436,35],["κυρίου",707996,18],["ἅμα",700745,28],["τῷ",709436,53],["δοξασθῆναι",703792,179],["αὐτοὺς",702165,62],["καὶ",707031,7],["ὑψωθῆναι",713289,179],["ἐκλιπόντες",704237,196],["ὡσεὶ",714159,28],["καπνὸς",707132,4],["ἐξέλιπον",704237,150]],"For the sinners shall perish; and the enemies of the Lord at the moment of their being honoured and exalted have utterly vanished like smoke."],["21",[["δανείζεται",703277,391],["ὁ",709436,3],["ἁμαρτωλὸς",700776,14],["καὶ",707031,7],["οὐκ",709805,28],["ἀποτείσει",701618,127],["ὁ",709436,3],["δὲ",703303,11],["δίκαιος",703694,14],["οἰκτίρει",709518,91],["καὶ",707031,7],["διδοῖ",703654,91]],"The sinner borrows, and will not pay again: but the righteous has compassion, and gives."],["22",[["ὅτι",709803,7],["οἱ",709436,136],["εὐλογοῦντες",705631,146],["αὐτὸν",702165,85],["κληρονομήσουσι",707724,218],["γῆν",703083,9],["οἱ",709436,136],["δὲ",703303,11],["καταρώμενοι",707396,348],["αὐτὸν",702165,85],["ἐξολεθρευθήσονται",704956,144]],"For they that bless him shall inherit the earth; and they that curse him shall be utterly destroyed."],["23",[["παρὰ",709995,0],["κυρίου",707996,18],["τὰ",709436,41],["διαβήματα",703422,42],["ἀνθρώπου",701163,18],["κατευθύνεται",707521,391],["καὶ",707031,7],["τὴν",709436,8],["ὁδὸν",709458,9],["αὐτοῦ",702165,102],["θελήσει",706176,127]],"The steps of a man are rightly ordered by the Lord: and he will take pleasure in his way."],["24",[["ὅταν",709801,28],["πέσῃ",710481,123],["οὐ",709805,28],["καταραχθήσεται",707405,134],["ὅτι",709803,7],["κύριος",707996,4],["ἀντιστηρίζει",701275,91],["χεῖρα",713787,9],["αὐτοῦ",702165,102]],"When he falls, he shall not be ruined: for the Lord supports his hand."],["25",[["νεώτερος",709256,224],["ἐγενόμην",703104,161],["καὶ",707031,7],["γὰρ",702963,11],["ἐγήρασα",703090,155],["καὶ",707031,7],["οὐκ",709805,28],["εἶδον",709725,150],["δίκαιον",703694,27],["ἐγκαταλελειμμένον",703967,439],["οὐδὲ",709816,7],["τὸ",709436,24],["σπέρμα",712008,25],["αὐτοῦ",702165,102],["ζητοῦν",705879,47],["ἄρτους",701829,57]],"I was [once] young, indeed I am now old; yet I have not seen the righteous forsaken, nor his seed seeking bread."],["26",[["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["ἐλεᾷ",704412,91],["καὶ",707031,7],["δανείζει",703277,91],["καὶ",707031,7],["τὸ",709436,34],["σπέρμα",712008,15],["αὐτοῦ",702165,102],["εἰς",704105,0],["εὐλογίαν",705633,9],["ἔσται",704093,93]],"He is merciful, and lends continually; and his seed shall be blessed."],["27",[["ἔκκλινον",704220,176],["ἀπὸ",701425,0],["κακοῦ",707066,92],["καὶ",707031,7],["ποίησον",710582,176],["ἀγαθὸν",700106,46],["καὶ",707031,7],["κατασκήνου",707423,240],["εἰς",704105,0],["αἰῶνα",700504,6],["αἰῶνος",700504,18]],"Turn aside from evil, and do good; and dwell for ever."],["28",[["ὅτι",709803,7],["κύριος",707996,4],["ἀγαπᾷ",700120,91],["κρίσιν",707908,9],["καὶ",707031,7],["οὐκ",709805,28],["ἐγκαταλείψει",703967,127],["τοὺς",709436,58],["ὁσίους",709782,60],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["φυλαχθήσονται",713619,144],["ἄνομοι",701194,138],["δὲ",703303,11],["ἐκδιωχθήσονται",704178,144],["καὶ",707031,7],["σπέρμα",712008,15],["ἀσεβῶν",701909,169],["ἐξολεθρευθήσεται",704956,134]],"For the Lord loves judgment, and will not forsake his saints; they shall be preserved for ever: the blameless shall be avenged, but the seed of the ungodly shall be utterly destroyed."],["29",[["δίκαιοι",703694,138],["δὲ",703303,11],["κληρονομήσουσι",707724,218],["γῆν",703083,9],["καὶ",707031,7],["κατασκηνώσουσιν",707423,218],["εἰς",704105,0],["αἰῶνα",700504,6],["αἰῶνος",700504,18],["ἐπ᾿",705080,0],["αὐτῆς",702165,86]],"But the righteous shall inherit the earth, and dwell upon it for ever."],["30",[["στόμα",712125,15],["δικαίου",703694,116],["μελετήσει",708698,127],["σοφίαν",711981,9],["καὶ",707031,7],["ἡ",709436,10],["γλῶσσα",703120,12],["αὐτοῦ",702165,102],["λαλήσει",708071,127],["κρίσιν",707908,9]],"The mouth of the righteous will meditate wisdom, and his tongue will speak of judgment."],["31",[["ὁ",709436,3],["νόμος",709349,4],["τοῦ",709436,35],["θεοῦ",706192,18],["αὐτοῦ",702165,102],["ἐν",704639,0],["καρδίᾳ",707141,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐχ",709805,28],["ὑποσκελισθήσεται",713239,134],["τὰ",709436,63],["διαβήματα",703422,64],["αὐτοῦ",702165,102]],"The law of his God is in his heart; and his steps shall not slide."],["32",[["κατανοεῖ",707341,91],["ὁ",709436,3],["ἁμαρτωλὸς",700776,14],["τὸν",709436,5],["δίκαιον",703694,27],["καὶ",707031,7],["ζητεῖ",705879,91],["τοῦ",709436,20],["θανατῶσαι",706097,106],["αὐτόν",702165,85]],"The sinner watches the righteous, and seeks to slay him."],["33",[["ὁ",709436,3],["δὲ",703303,11],["κύριος",707996,4],["οὐ",709805,28],["μὴ",708851,28],["ἐγκαταλίπῃ",703967,172],["αὐτὸν",702165,85],["εἰς",704105,0],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτοῦ",702165,102],["οὐδὲ",709816,7],["μὴ",708851,28],["καταδικάσηται",707241,239],["αὐτόν",702165,85],["ὅταν",709801,28],["κρίνηται",707905,239],["αὐτῷ",702165,50]],"But the Lord will not leave him in his hands, nor by any means condemn him when he is judged."],["34",[["ὑπόμεινον",713219,176],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["φύλαξον",713619,176],["τὴν",709436,8],["ὁδὸν",709458,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὑψώσει",713289,127],["σε",711598,163],["τοῦ",709436,20],["κατακληρονομῆσαι",707274,106],["γῆν",703083,9],["ἐν",704639,0],["τῷ",709436,53],["ἐξολεθρεύεσθαι",704956,110],["ἁμαρτωλοὺς",700776,60],["ὄψῃ",709725,123]],"Wait on the Lord, and keep his way, and he shall exalt thee to inherit the land: when the wicked are destroyed, thou shalt see [it]."],["35",[["εἶδον",709725,150],["ἀσεβῆ",701909,27],["ὑπερυψούμενον",713163,464],["καὶ",707031,7],["ἐπαιρόμενον",705002,464],["ὡς",714148,7],["τὰς",709436,38],["κέδρους",707590,39],["τοῦ",709436,35],["Λιβάνου",708185,18]],"I saw the ungodly very highly exalting himself, and lifting himself up like the cedars of Libanus."],["36",[["καὶ",707031,7],["παρῆλθον",710141,150],["καὶ",707031,7],["ἰδοὺ",706497,88],["οὐκ",709805,28],["ἦν",704093,13],["καὶ",707031,7],["ἐζήτησα",705879,155],["αὐτόν",702165,85],["καὶ",707031,7],["οὐχ",709805,28],["εὑρέθη",705676,37],["ὁ",709436,3],["τόπος",712903,4],["αὐτοῦ",702165,102]],"Yet I passed by, and lo! he was not: and I sought him, but his place was not found."],["37",[["φύλασσε",713619,240],["ἀκακίαν",700511,9],["καὶ",707031,7],["ἰδὲ",709725,176],["εὐθύτητα",705603,9],["ὅτι",709803,7],["ἔστιν",704093,91],["ἐγκατάλειμμα",703965,15],["ἀνθρώπῳ",701163,114],["εἰρηνικῷ",704099,30]],"Maintain innocence, and behold uprightness: for there is a remnant to the peaceable man."],["38",[["οἱ",709436,136],["δὲ",703303,11],["παράνομοι",710080,138],["ἐξολεθρευθήσονται",704956,144],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτό",702165,129],["τὰ",709436,63],["ἐγκαταλείμματα",703966,64],["τῶν",709436,80],["ἀσεβῶν",701909,169],["ἐξολεθρευθήσονται",704956,144]],"But the transgressors shall be utterly destroyed together: the remnants of the ungodly shall be utterly destroyed.",{"s":"d","q":0.58}],["39",[["σωτηρία",712658,12],["δὲ",703303,11],["τῶν",709436,80],["δικαίων",703694,169],["παρὰ",709995,0],["κυρίου",707996,18],["καὶ",707031,7],["ὑπερασπιστὴς",713123,4],["αὐτῶν",702165,40],["ἐστιν",704093,91],["ἐν",704639,0],["καιρῷ",707047,114],["θλίψεως",706276,17]],"But the salvation of the righteous is of the Lord; and he is their defender in the time of affliction."],["40",[["καὶ",707031,7],["βοηθήσει",702746,127],["αὐτοῖς",702165,151],["κύριος",707996,4],["καὶ",707031,7],["ῥύσεται",711309,93],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἐξελεῖται",704838,93],["αὐτοὺς",702165,62],["ἐξ",704132,0],["ἁμαρτωλῶν",700776,169],["καὶ",707031,7],["σώσει",712627,127],["αὐτούς",702165,62],["ὅτι",709803,7],["ἤλπισαν",704529,150],["ἐπ᾿",705080,0],["αὐτόν",702165,85]],"And the Lord shall help them, and deliver them: and he shall rescue them from sinners, and save them, because they have hoped in him."]]