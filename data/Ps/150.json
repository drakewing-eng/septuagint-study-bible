[["1",[["αλληλουια",700688,88],["αἰνεῖτε",700459,335],["τὸν",709436,5],["θεὸν",706192,6],["ἐν",704639,0],["τοῖς",709436,147],["ἁγίοις",700159,230],["αὐτοῦ",702165,559],["αἰνεῖτε",700459,335],["αὐτὸν",702165,556],["ἐν",704639,0],["στερεώματι",712077,54],["δυνάμεως",703839,17],["αὐτοῦ",702165,559]],"Alleluia. Praise God in his holy places: praise him in the firmament of his power."],["2",[["αἰνεῖτε",700459,335],["αὐτὸν",702165,556],["ἐπὶ",705080,0],["ταῖς",709436,75],["δυναστείαις",703841,76],["αὐτοῦ",702165,559],["αἰνεῖτε",700459,335],["αὐτὸν",702165,556],["κατὰ",707200,0],["τὸ",709436,24],["πλῆθος",710529,25],["τῆς",709436,16],["μεγαλωσύνης",708652,17],["αὐτοῦ",702165,559]],"Praise him on [account of] his mighty acts: praise him according to his abundant greatness."],["3",[["αἰνεῖτε",700459,335],["αὐτὸν",702165,556],["ἐν",704639,0],["ἤχῳ",706046,114],["σάλπιγγος",711424,17],["αἰνεῖτε",700459,335],["αὐτὸν",702165,556],["ἐν",704639,0],["ψαλτηρίῳ",714023,54],["καὶ",707031,7],["κιθάρᾳ",707669,1]],"Praise him with the sound of a trumpet: praise him with psaltery and harp."],["4",[["αἰνεῖτε",700459,335],["αὐτὸν",702165,556],["ἐν",704639,0],["τυμπάνῳ",713019,54],["καὶ",707031,7],["χορῷ",713915,114],["αἰνεῖτε",700459,335],["αὐτὸν",702165,556],["ἐν",704639,0],["χορδαῖς",713907,76],["καὶ",707031,7],["ὀργάνῳ",709727,54]],"Praise him with timbrel and dance: praise him with stringed instruments and the organ."],["5",[["αἰνεῖτε",700459,335],["αὐτὸν",702165,556],["ἐν",704639,0],["κυμβάλοις",707972,96],["εὐήχοις",705587,94],["αἰνεῖτε",700459,335],["αὐτὸν",702165,556],["ἐν",704639,0],["κυμβάλοις",707972,96],["ἀλαλαγμοῦ",700631,18]],"Praise him with melodious cymbals: praise him with loud cymbals."],["6",[["πᾶσα",710177,29],["πνοὴ",710574,12],["αἰνεσάτω",700459,45],["τὸν",709436,5],["κύριον",707996,6],["αλληλουια",700688,88]],"Let every thing that has breath praise the Lord."]]