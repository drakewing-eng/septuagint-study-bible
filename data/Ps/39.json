[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["τῷ",709436,113],["Δαυιδ",703232,114],["ψαλμός",714022,4]],"For the end, a Psalm of David."],["2",[["ὑπομένων",713219,72],["ὑπέμεινα",713219,155],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["προσέσχεν",710895,2],["μοι",708974,159],["καὶ",707031,7],["εἰσήκουσεν",704108,2],["τῆς",709436,16],["δεήσεώς",703311,17],["μου",709032,133]],"I waited patiently for the Lord; and he attended to me, and hearkened to my supplication."],["3",[["καὶ",707031,7],["ἀνήγαγέν",700933,2],["με",708618,163],["ἐκ",704132,0],["λάκκου",708067,18],["ταλαιπωρίας",712695,17],["καὶ",707031,7],["ἀπὸ",701425,0],["πηλοῦ",710457,18],["ἰλύος",706736,17],["καὶ",707031,7],["ἔστησεν",706846,2],["ἐπὶ",705080,0],["πέτραν",710443,9],["τοὺς",709436,58],["πόδας",710707,57],["μου",709032,133],["καὶ",707031,7],["κατηύθυνεν",707521,2],["τὰ",709436,41],["διαβήματά",703422,42],["μου",709032,133]],"And he brought me up out of a pit of misery, and from miry clay: and he set my feet on a rock, and ordered my goings aright."],["4",[["καὶ",707031,7],["ἐνέβαλεν",704547,2],["εἰς",704105,0],["τὸ",709436,24],["στόμα",712125,25],["μου",709032,133],["ᾆσμα",701970,25],["καινόν",707042,46],["ὕμνον",713089,6],["τῷ",709436,113],["θεῷ",706192,114],["ἡμῶν",705999,145],["ὄψονται",709725,135],["πολλοὶ",710646,138],["καὶ",707031,7],["φοβηθήσονται",713532,144],["καὶ",707031,7],["ἐλπιοῦσιν",704529,218],["ἐπὶ",705080,0],["κύριον",707996,6]],"And he put a new song into my mouth, [even] a hymn to our God: many shall see [it], and fear, and shall hope in the Lord."],["5",[["μακάριος",708397,14],["ἀνήρ",701150,4],["οὗ",709781,48],["ἐστιν",704093,91],["τὸ",709436,34],["ὄνομα",709666,15],["κυρίου",707996,18],["ἐλπὶς",704530,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ἐνέβλεψεν",704551,2],["εἰς",704105,0],["ματαιότητας",708576,39],["καὶ",707031,7],["μανίας",708482,39],["ψευδεῖς",714036,60]],"Blessed [is] the man whose hope is the name of the Lord, and [who] has not regarded vanities and false frenzies."],["6",[["πολλὰ",710646,68],["ἐποίησας",710582,162],["σύ",712181,164],["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["τὰ",709436,41],["θαυμάσιά",706136,68],["σου",711945,133],["καὶ",707031,7],["τοῖς",709436,147],["διαλογισμοῖς",703506,148],["σου",711945,133],["οὐκ",709805,28],["ἔστιν",704093,91],["τίς",712867,158],["ὁμοιωθήσεταί",709628,134],["σοι",711925,159],["ἀπήγγειλα",701321,155],["καὶ",707031,7],["ἐλάλησα",708071,155],["ἐπληθύνθησαν",710530,99],["ὑπὲρ",713111,0],["ἀριθμόν",701744,6]],"O Lord my God, thou hast multiplied thy wonderful works, and in thy thoughts there is none who shall be likened to thee: I declared and spoke [of them]: they exceeded number."],["7",[["θυσίαν",706345,9],["καὶ",707031,7],["προσφορὰν",710976,9],["οὐκ",709805,28],["ἠθέλησας",706176,162],["ὠτία",714165,42],["δὲ",703303,11],["κατηρτίσω",707410,174],["μοι",708974,159],["ὁλοκαύτωμα",709589,25],["καὶ",707031,7],["περὶ",710285,0],["ἁμαρτίας",700775,17],["οὐκ",709805,28],["ᾔτησας",700489,162]],"Sacrifice and offering thou wouldest not; but a body hast thou prepared me: whole-burnt-offering and [sacrifice] for sin thou didst not require."],["8",[["τότε",712908,28],["εἶπον",705373,150],["ἰδοὺ",706497,88],["ἥκω",705956,174],["ἐν",704639,0],["κεφαλίδι",707640,1],["βιβλίου",702719,21],["γέγραπται",703194,187],["περὶ",710285,0],["ἐμοῦ",704580,133]],"Then I said, Behold, I come: in the volume of the book it is written concerning me,"],["9",[["τοῦ",709436,20],["ποιῆσαι",710582,106],["τὸ",709436,24],["θέλημά",706170,25],["σου",711945,133],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["ἐβουλήθην",702795,156],["καὶ",707031,7],["τὸν",709436,5],["νόμον",709349,6],["σου",711945,133],["ἐν",704639,0],["μέσῳ",708768,30],["τῆς",709436,16],["κοιλίας",707761,17],["μου",709032,133]],"I desired to do thy will, O my God, and thy law in the midst of mine heart."],["10",[["εὐηγγελισάμην",705547,161],["δικαιοσύνην",703695,9],["ἐν",704639,0],["ἐκκλησίᾳ",704216,1],["μεγάλῃ",708653,101],["ἰδοὺ",706497,88],["τὰ",709436,41],["χείλη",713781,42],["μου",709032,133],["οὐ",709805,28],["μὴ",708851,28],["κωλύσω",708020,207],["κύριε",707996,153],["σὺ",712181,164],["ἔγνως",703105,162]],"I have preached righteousness in the great congregation; lo! I will not refrain my lips; O Lord, thou knowest my righteousness."],["11",[["τὴν",709436,8],["δικαιοσύνην",703695,9],["σου",711945,133],["οὐκ",709805,28],["ἔκρυψα",707923,155],["ἐν",704639,0],["τῇ",709436,100],["καρδίᾳ",707141,1],["μου",709032,133],["τὴν",709436,8],["ἀλήθειάν",700656,9],["σου",711945,133],["καὶ",707031,7],["τὸ",709436,24],["σωτήριόν",712659,25],["σου",711945,133],["εἶπα",705373,155],["οὐκ",709805,28],["ἔκρυψα",707923,155],["τὸ",709436,24],["ἔλεός",704426,25],["σου",711945,133],["καὶ",707031,7],["τὴν",709436,8],["ἀλήθειάν",700656,9],["σου",711945,133],["ἀπὸ",701425,0],["συναγωγῆς",712376,17],["πολλῆς",710646,82]],"I have not hid thy truth within my heart, and I have declared thy salvation; I have not hid thy mercy and thy truth from the great congregation."],["12",[["σὺ",712181,164],["δέ",703303,11],["κύριε",707996,153],["μὴ",708851,28],["μακρύνης",708428,205],["τοὺς",709436,58],["οἰκτιρμούς",709520,57],["σου",711945,133],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["τὸ",709436,34],["ἔλεός",704426,15],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["ἀλήθειά",700656,12],["σου",711945,133],["διὰ",703417,0],["παντὸς",710177,116],["ἀντελάβοντό",701243,189],["μου",709032,133]],"But thou, Lord, remove not thy compassion far from me; thy mercy and thy truth have helped me continually."],["13",[["ὅτι",709803,7],["περιέσχον",710315,150],["με",708618,163],["κακά",707066,68],["ὧν",709781,252],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀριθμός",701744,4],["κατέλαβόν",707300,150],["με",708618,163],["αἱ",709436,190],["ἀνομίαι",701192,191],["μου",709032,133],["καὶ",707031,7],["οὐκ",709805,28],["ἠδυνήθην",703838,156],["τοῦ",709436,20],["βλέπειν",702740,55],["ἐπληθύνθησαν",710530,99],["ὑπὲρ",713111,0],["τὰς",709436,38],["τρίχας",706312,39],["τῆς",709436,16],["κεφαλῆς",707639,17],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["ἐγκατέλιπέν",703967,2],["με",708618,163]],"For innumerable evils have encompassed me; my transgressions have taken hold of me, and I could not see; they are multiplied more than the hairs of my head; and my heart has failed me."],["14",[["εὐδόκησον",705565,176],["κύριε",707996,153],["τοῦ",709436,20],["ῥύσασθαί",711309,109],["με",708618,163],["κύριε",707996,153],["εἰς",704105,0],["τὸ",709436,24],["βοηθῆσαί",702746,106],["μοι",708974,159],["πρόσχες",710895,176]],"Be pleased, O Lord, to deliver me; O Lord, draw nigh to help me."],["15",[["καταισχυνθείησαν",707257,393],["καὶ",707031,7],["ἐντραπείησαν",704805,393],["ἅμα",700745,28],["οἱ",709436,136],["ζητοῦντες",705879,146],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["τοῦ",709436,20],["ἐξᾶραι",704839,106],["αὐτήν",702165,104],["ἀποστραφείησαν",701598,393],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,0],["καὶ",707031,7],["ἐντραπείησαν",704805,393],["οἱ",709436,136],["θέλοντές",706176,146],["μοι",708974,159],["κακά",707066,68]],"Let those that seek my soul, to destroy it, be ashamed and confounded together; let those that wish me evil be turned backward and put to shame."],["16",[["κομισάσθωσαν",707805,486],["παραχρῆμα",710119,28],["αἰσχύνην",700483,9],["αὐτῶν",702165,40],["οἱ",709436,136],["λέγοντές",708124,146],["μοι",708974,159],["εὖγε",705557,28],["εὖγε",705557,28]],"Let those that say to me, Aha, aha, quickly receive shame for their reward."],["17",[["ἀγαλλιάσαιντο",700114,529],["καὶ",707031,7],["εὐφρανθείησαν",705715,393],["ἐπὶ",705080,0],["σοὶ",711925,159],["πάντες",710177,138],["οἱ",709436,136],["ζητοῦντές",705879,146],["σε",711598,163],["κύριε",707996,153],["καὶ",707031,7],["εἰπάτωσαν",705373,264],["διὰ",703417,0],["παντός",710177,116],["μεγαλυνθήτω",708647,22],["ὁ",709436,3],["κύριος",707996,4],["οἱ",709436,136],["ἀγαπῶντες",700120,146],["τὸ",709436,24],["σωτήριόν",712659,25],["σου",711945,133]],"Let all those that seek thee, O Lord, exult and rejoice in thee; and let them that love thy salvation say continually, The Lord be magnified."],["18",[["ἐγὼ",704018,164],["δὲ",703303,11],["πτωχός",711076,4],["εἰμι",704093,157],["καὶ",707031,7],["πένης",710248,4],["κύριος",707996,4],["φροντιεῖ",713590,127],["μου",709032,133],["βοηθός",702748,4],["μου",709032,133],["καὶ",707031,7],["ὑπερασπιστής",713123,4],["μου",709032,133],["σὺ",712181,164],["εἶ",704093,154],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["μὴ",708851,28],["χρονίσῃς",713967,175]],"But I am poor and needy; the Lord will take care of me; thou art my helper, and my defender, O my God, delay not."]]