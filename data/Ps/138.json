[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114],["κύριε",707996,153],["ἐδοκίμασάς",703776,162],["με",708618,163],["καὶ",707031,7],["ἔγνως",703105,162],["με",708618,163]],"For the end, a Psalm of David. O Lord, thou hast proved me, and known me."],["2",[["σὺ",712181,164],["ἔγνως",703105,162],["τὴν",709436,8],["καθέδραν",706992,9],["μου",709032,133],["καὶ",707031,7],["τὴν",709436,8],["ἔγερσίν",703950,9],["μου",709032,133],["σὺ",712181,164],["συνῆκας",712481,162],["τοὺς",709436,58],["διαλογισμούς",703506,57],["μου",709032,133],["ἀπὸ",701425,0],["μακρόθεν",708417,28]],"Thou knowest my down-sitting and mine up-rising: thou understandest my thoughts long before."],["3",[["τὴν",709436,8],["τρίβον",712941,36],["μου",709032,133],["καὶ",707031,7],["τὴν",709436,8],["σχοῖνόν",712613,9],["μου",709032,133],["σὺ",712181,164],["ἐξιχνίασας",704941,162],["καὶ",707031,7],["πάσας",710177,119],["τὰς",709436,38],["ὁδούς",709458,39],["μου",709032,133],["προεῖδες",710832,162]],"Thou hast traced my path and my bed, and hast foreseen all my ways."],["4",[["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["λόγος",708236,4],["ἐν",704639,0],["γλώσσῃ",703120,1],["μου",709032,133]],"For there is no unrighteous word in my tongue: behold, O Lord, thou hast known all things,",{"s":"d","q":0.5}],["5",[["ἰδού",706497,88],["κύριε",707996,153],["σὺ",712181,164],["ἔγνως",703105,162],["πάντα",710177,68],["τὰ",709436,41],["ἔσχατα",705519,68],["καὶ",707031,7],["τὰ",709436,41],["ἀρχαῖα",701835,68],["σὺ",712181,164],["ἔπλασάς",710503,162],["με",708618,163],["καὶ",707031,7],["ἔθηκας",712849,162],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133]],"the last and the first: thou hast fashioned me, and laid thine hand upon me."],["6",[["ἐθαυμαστώθη",706139,37],["ἡ",709436,10],["γνῶσίς",703138,12],["σου",711945,133],["ἐξ",704132,0],["ἐμοῦ",704580,133],["ἐκραταιώθη",707875,37],["οὐ",709805,28],["μὴ",708851,28],["δύνωμαι",703838,386],["πρὸς",710844,0],["αὐτήν",702165,551]],"The knowledge of thee is too wonderful for me; it is very difficult, I cannot [attain] to it."],["7",[["ποῦ",710706,28],["πορευθῶ",710667,321],["ἀπὸ",701425,0],["τοῦ",709436,20],["πνεύματός",710566,21],["σου",711945,133],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,20],["προσώπου",710986,21],["σου",711945,133],["ποῦ",710706,28],["φύγω",713433,207]],"Whither shall I go from thy Spirit? and whither shall I flee from thy presence?"],["8",[["ἐὰν",703912,7],["ἀναβῶ",700905,207],["εἰς",704105,0],["τὸν",709436,5],["οὐρανόν",709844,6],["σὺ",712181,164],["εἶ",704093,154],["ἐκεῖ",704181,28],["ἐὰν",703912,7],["καταβῶ",707202,207],["εἰς",704105,0],["τὸν",709436,5],["ᾅδην",700255,6],["πάρει",710126,154]],"If I should go up to heaven, thou art there: if I should go down to hell, thou art present."],["9",[["ἐὰν",703912,7],["ἀναλάβοιμι",700984,346],["τὰς",709436,38],["πτέρυγάς",711057,39],["μου",709032,133],["κατ᾿",707200,0],["ὄρθρον",709745,6],["καὶ",707031,7],["κατασκηνώσω",707423,207],["εἰς",704105,0],["τὰ",709436,41],["ἔσχατα",705519,68],["τῆς",709436,16],["θαλάσσης",706069,17]],"If I should spread my wings [to fly] straight forward, and sojourn at the extremity of the sea, [it would be vain],"],["10",[["καὶ",707031,7],["γὰρ",702963,11],["ἐκεῖ",704181,28],["ἡ",709436,10],["χείρ",713787,12],["σου",711945,133],["ὁδηγήσει",709448,127],["με",708618,163],["καὶ",707031,7],["καθέξει",707526,127],["με",708618,163],["ἡ",709436,10],["δεξιά",703360,68],["σου",711945,133]],"for even there thy hand would guide me, and thy right hand would hold me."],["11",[["καὶ",707031,7],["εἶπα",705373,155],["ἄρα",701666,11],["σκότος",711889,15],["καταπατήσει",707360,127],["με",708618,163],["καὶ",707031,7],["νὺξ",709386,12],["φωτισμὸς",713647,4],["ἐν",704639,0],["τῇ",709436,100],["τρυφῇ",713008,1],["μου",709032,133]],"When I said, Surely the darkness will cover me; even the night [was] light in my luxury."],["12",[["ὅτι",709803,7],["σκότος",711889,25],["οὐ",709805,28],["σκοτισθήσεται",711887,134],["ἀπὸ",701425,0],["σοῦ",711945,133],["καὶ",707031,7],["νὺξ",709386,12],["ὡς",714148,7],["ἡμέρα",705984,12],["φωτισθήσεται",713646,134],["ὡς",714148,7],["τὸ",709436,24],["σκότος",711889,25],["αὐτῆς",702165,547],["οὕτως",709859,28],["καὶ",707031,7],["τὸ",709436,24],["φῶς",713642,25],["αὐτῆς",702165,547]],"For darkness will not be darkness with thee; but night will be light as day: as its darkness, so shall its light [be to thee]."],["13",[["ὅτι",709803,7],["σὺ",712181,164],["ἐκτήσω",707932,174],["τοὺς",709436,58],["νεφρούς",709282,57],["μου",709032,133],["κύριε",707996,153],["ἀντελάβου",701243,174],["μου",709032,133],["ἐκ",704132,0],["γαστρὸς",702976,17],["μητρός",708892,17],["μου",709032,133]],"For thou, O Lord, hast possessed my reins; thou hast helped me from my mother's womb."],["14",[["ἐξομολογήσομαί",704960,181],["σοι",711925,159],["ὅτι",709803,7],["φοβερῶς",713531,28],["ἐθαυμαστώθην",706139,156],["θαυμάσια",706136,68],["τὰ",709436,41],["ἔργα",705396,42],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["γινώσκει",703105,91],["σφόδρα",712586,28]],"I will give thee thanks; for thou art fearfully wondrous; wondrous are thy works; and my soul knows [it] well."],["15",[["οὐκ",709805,28],["ἐκρύβη",707923,37],["τὸ",709436,24],["ὀστοῦν",709792,25],["μου",709032,133],["ἀπὸ",701425,0],["σοῦ",711945,133],["ὃ",709781,128],["ἐποίησας",710582,162],["ἐν",704639,0],["κρυφῇ",707929,28],["καὶ",707031,7],["ἡ",709436,10],["ὑπόστασίς",713241,12],["μου",709032,133],["ἐν",704639,0],["τοῖς",709436,147],["κατωτάτοις",707560,230],["τῆς",709436,16],["γῆς",703083,17]],"My bones which thou madest in secret were not hidden from thee, nor my substance, in the lowest parts of the earth."],["16",[["τὸ",709436,24],["ἀκατέργαστόν",700534,46],["μου",709032,133],["εἴδοσαν",709725,150],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["σου",711945,133],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸ",709436,24],["βιβλίον",702719,25],["σου",711945,133],["πάντες",710177,138],["γραφήσονται",703194,144],["ἡμέρας",705984,39],["πλασθήσονται",710503,144],["καὶ",707031,7],["οὐθεὶς",709817,14],["ἐν",704639,0],["αὐτοῖς",702165,623]],"Thine eyes saw my unwrought [substance], and all [men] shall be written in thy book; they shall be formed by day, though [there should for a time] be no one among them."],["17",[["ἐμοὶ",704577,159],["δὲ",703303,11],["λίαν",708184,28],["ἐτιμήθησαν",712855,99],["οἱ",709436,136],["φίλοι",713492,138],["σου",711945,133],["ὁ",709436,3],["θεός",706192,4],["λίαν",708184,28],["ἐκραταιώθησαν",707875,99],["αἱ",709436,190],["ἀρχαὶ",701836,191],["αὐτῶν",702165,565]],"But thy friends, O God, have been greatly honoured by me; their rule has been greatly strengthened."],["18",[["ἐξαριθμήσομαι",704877,181],["αὐτούς",702165,622],["καὶ",707031,7],["ὑπὲρ",713111,0],["ἄμμον",700845,9],["πληθυνθήσονται",710530,144],["ἐξηγέρθην",704889,156],["καὶ",707031,7],["ἔτι",705538,28],["εἰμὶ",704093,157],["μετὰ",708780,0],["σοῦ",711945,133]],"I will number them, and they shall be multiplied beyond the sand; I awake, and am still with thee."],["19",[["ἐὰν",703912,7],["ἀποκτείνῃς",701498,175],["ἁμαρτωλούς",700776,60],["ὁ",709436,3],["θεός",706192,4],["ἄνδρες",701150,52],["αἱμάτων",700442,44],["ἐκκλίνατε",704220,74],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133]],"Oh that thou wouldest slay the wicked, O God; depart from me, ye men of blood."],["20",[["ὅτι",709803,7],["ἐρεῖς",705415,166],["εἰς",704105,0],["διαλογισμόν",703506,6],["λήμψονται",708076,135],["εἰς",704105,0],["ματαιότητα",708576,9],["τὰς",709436,38],["πόλεις",710612,39],["σου",711945,133]],"For thou wilt say concerning [their] thought, [that] they shall take thy cities in vain."],["21",[["οὐχὶ",709862,28],["τοὺς",709436,58],["μισοῦντάς",708935,235],["σε",711598,163],["κύριε",707996,153],["ἐμίσησα",708935,155],["καὶ",707031,7],["ἐπὶ",705080,0],["τοῖς",709436,147],["ἐχθροῖς",705779,148],["σου",711945,133],["ἐξετηκόμην",704329,334]],"Have I not hated them, O Lord, that hate thee? and wasted away because of thine enemies?"],["22",[["τέλειον",712769,27],["μῖσος",708947,6],["ἐμίσουν",708935,137],["αὐτούς",702165,622],["εἰς",704105,0],["ἐχθροὺς",705779,57],["ἐγένοντό",703104,189],["μοι",708974,159]],"I have hated them with perfect hatred; they were counted my enemies."],["23",[["δοκίμασόν",703776,176],["με",708618,163],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["γνῶθι",703105,176],["τὴν",709436,8],["καρδίαν",707141,9],["μου",709032,133],["ἔτασόν",705526,176],["με",708618,163],["καὶ",707031,7],["γνῶθι",703105,176],["τὰς",709436,38],["τρίβους",712939,39],["μου",709032,133]],"Prove me, O God, and know my heart; examine me, and know my paths;"],["24",[["καὶ",707031,7],["ἰδὲ",709725,176],["εἰ",704071,7],["ὁδὸς",709458,12],["ἀνομίας",701192,17],["ἐν",704639,0],["ἐμοί",704577,159],["καὶ",707031,7],["ὁδήγησόν",709448,176],["με",708618,163],["ἐν",704639,0],["ὁδῷ",709458,1],["αἰωνίᾳ",700505,101]],"and see if [there is any] way of iniquity in me, and lead me in an everlasting way."]]