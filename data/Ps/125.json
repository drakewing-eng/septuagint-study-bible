[["1",[["ᾠδὴ",714091,12],["τῶν",709436,80],["ἀναβαθμῶν",700904,81],["ἐν",704639,0],["τῷ",709436,53],["ἐπιστρέψαι",705278,106],["κύριον",707996,6],["τὴν",709436,8],["αἰχμαλωσίαν",700499,9],["Σιων",711816,17],["ἐγενήθημεν",703104,485],["ὡς",714148,7],["παρακεκλημένοι",710039,429]],"A Song of Degrees. When the Lord turned the captivity of Sion, we became as comforted ones."],["2",[["τότε",712908,28],["ἐπλήσθη",710532,37],["χαρᾶς",713719,17],["τὸ",709436,34],["στόμα",712125,15],["ἡμῶν",705999,145],["καὶ",707031,7],["ἡ",709436,10],["γλῶσσα",703120,12],["ἡμῶν",705999,145],["ἀγαλλιάσεως",700113,17],["τότε",712908,28],["ἐροῦσιν",705415,218],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["ἐμεγάλυνεν",708647,2],["κύριος",707996,4],["τοῦ",709436,20],["ποιῆσαι",710582,106],["μετ᾿",708780,0],["αὐτῶν",702165,565]],"Then was our mouth filled with joy, and our tongue with exultation: then would they say among the Gentiles,"],["3",[["ἐμεγάλυνεν",708647,2],["κύριος",707996,4],["τοῦ",709436,20],["ποιῆσαι",710582,106],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["ἐγενήθημεν",703104,485],["εὐφραινόμενοι",705715,348]],"The Lord has done great things among them. The Lord has done great things for us, we became joyful."],["4",[["ἐπίστρεψον",705278,176],["κύριε",707996,153],["τὴν",709436,8],["αἰχμαλωσίαν",700499,9],["ἡμῶν",705999,145],["ὡς",714148,7],["χειμάρρους",713783,57],["ἐν",704639,0],["τῷ",709436,113],["νότῳ",709364,114]],"Turn, O Lord, our captivity, as the streams in the south."],["5",[["οἱ",709436,136],["σπείροντες",712006,146],["ἐν",704639,0],["δάκρυσιν",703255,96],["ἐν",704639,0],["ἀγαλλιάσει",700113,1],["θεριοῦσιν",706206,218]],"They that sow in tears shall reap in joy."],["6",[["πορευόμενοι",710667,348],["ἐπορεύοντο",710667,139],["καὶ",707031,7],["ἔκλαιον",707703,137],["αἴροντες",700473,146],["τὰ",709436,41],["σπέρματα",712008,42],["αὐτῶν",702165,565],["ἐρχόμενοι",705453,348],["δὲ",703303,11],["ἥξουσιν",705956,218],["ἐν",704639,0],["ἀγαλλιάσει",700114,127],["αἴροντες",700473,146],["τὰ",709436,41],["δράγματα",703820,42],["αὐτῶν",702165,565]],"They went on and wept as they cast their seeds; but they shall surely come with exultation, bringing their sheaves [with them]."]]