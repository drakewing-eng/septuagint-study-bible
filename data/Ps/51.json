[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["συνέσεως",712460,17],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, [a Psalm] of instruction by David,"],["2",[["ἐν",704639,0],["τῷ",709436,53],["ἐλθεῖν",705453,106],["Δωηκ",703893,6],["τὸν",709436,5],["Ιδουμαῖον",706504,6],["καὶ",707031,7],["ἀναγγεῖλαι",700921,106],["τῷ",709436,113],["Σαουλ",711499,114],["καὶ",707031,7],["εἰπεῖν",705373,106],["αὐτῷ",702165,50],["ἦλθεν",705453,2],["Δαυιδ",703232,4],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["Αβιμελεχ",700068,18]],"when Doec the Idumean came and told Saul, and said to him, David is gone to the house of Abimelech."],["3",[["τί",712867,126],["ἐγκαυχᾷ",703971,259],["ἐν",704639,0],["κακίᾳ",707054,1],["ὁ",709436,3],["δυνατός",703845,14],["ἀνομίαν",701192,9],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9]],"Why dost thou, O mighty man, boast of iniquity in [thy] mischief? All the day"],["4",[["ἀδικίαν",700271,9],["ἐλογίσατο",708232,23],["ἡ",709436,10],["γλῶσσά",703120,12],["σου",711945,133],["ὡσεὶ",714159,7],["ξυρὸν",709433,15],["ἠκονημένον",700570,327],["ἐποίησας",710582,162],["δόλον",703787,6]],"thy tongue has devised unrighteousness; like a sharpened razor thou hast wrought deceit."],["5",[["ἠγάπησας",700120,162],["κακίαν",707054,9],["ὑπὲρ",713111,0],["ἀγαθωσύνην",700111,9],["ἀδικίαν",700271,9],["ὑπὲρ",713111,0],["τὸ",709436,24],["λαλῆσαι",708071,106],["δικαιοσύνην",703695,9],["διάψαλμα",703641,15]],"Thou hast loved wickedness more than goodness; unrighteousness better than to speak righteousness. Pause."],["6",[["ἠγάπησας",700120,162],["πάντα",710177,68],["τὰ",709436,41],["ῥήματα",711246,42],["καταποντισμοῦ",707386,18],["γλῶσσαν",703120,9],["δολίαν",703783,36]],"Thou hast loved all words of destruction, [and] a deceitful tongue."],["7",[["διὰ",703417,0],["τοῦτο",709858,129],["ὁ",709436,3],["θεὸς",706192,4],["καθελεῖ",706982,127],["σε",711598,163],["εἰς",704105,0],["τέλος",712787,25],["ἐκτίλαι",704332,106],["σε",711598,163],["καὶ",707031,7],["μεταναστεύσαι",708807,106],["σε",711598,163],["ἀπὸ",701425,0],["σκηνώματος",711849,21],["καὶ",707031,7],["τὸ",709436,24],["ῥίζωμά",711262,25],["σου",711945,133],["ἐκ",704132,0],["γῆς",703083,17],["ζώντων",705851,170],["διάψαλμα",703641,15]],"Therefore may God destroy thee for ever, may he pluck thee up and utterly remove thee from [thy] dwelling, and thy root from the land of the living. Pause."],["8",[["καὶ",707031,7],["ὄψονται",709725,135],["δίκαιοι",703694,138],["καὶ",707031,7],["φοβηθήσονται",713532,144],["καὶ",707031,7],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["γελάσονται",703019,144],["καὶ",707031,7],["ἐροῦσιν",705415,218]],"And the righteous shall see, and fear, and shall laugh at him, and say,"],["9",[["ἰδοὺ",706497,88],["ἄνθρωπος",701163,4],["ὃς",709781,213],["οὐκ",709805,28],["ἔθετο",712849,23],["τὸν",709436,5],["θεὸν",706192,6],["βοηθὸν",702748,6],["αὐτοῦ",702165,102],["ἀλλ᾿",700680,7],["ἐπήλπισεν",705064,2],["ἐπὶ",705080,0],["τὸ",709436,24],["πλῆθος",710529,25],["τοῦ",709436,35],["πλούτου",710563,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐδυναμώθη",703840,37],["ἐπὶ",705080,0],["τῇ",709436,100],["ματαιότητι",708576,1],["αὐτοῦ",702165,102]],"Behold the man who made not God his help; but trusted in the abundance of his wealth, and strengthened himself in his vanity."],["10",[["ἐγὼ",704018,164],["δὲ",703303,11],["ὡσεὶ",714159,7],["ἐλαία",704376,12],["κατάκαρπος",707262,29],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["τοῦ",709436,35],["θεοῦ",706192,18],["ἤλπισα",704529,155],["ἐπὶ",705080,0],["τὸ",709436,24],["ἔλεος",704426,25],["τοῦ",709436,35],["θεοῦ",706192,18],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18]],"But I am as a fruitful olive in the house of God: I have trusted in the mercy of God for ever, even for evermore."],["11",[["ἐξομολογήσομαί",704960,181],["σοι",711925,159],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ὅτι",709803,7],["ἐποίησας",710582,162],["καὶ",707031,7],["ὑπομενῶ",713219,165],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["ὅτι",709803,7],["χρηστὸν",713958,26],["ἐναντίον",704654,0],["τῶν",709436,80],["ὁσίων",709782,169],["σου",711945,133]],"I will give thanks to thee for ever, for thou hast done [it]: and I will wait on thy name; for [it is] good before thy saints."]]