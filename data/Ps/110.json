[["1",[["αλληλουια",700688,88],["ἐξομολογήσομαί",704960,181],["σοι",711925,159],["κύριε",707996,153],["ἐν",704639,0],["ὅλῃ",709597,101],["καρδίᾳ",707141,1],["μου",709032,133],["ἐν",704639,0],["βουλῇ",702792,1],["εὐθείων",705602,198],["καὶ",707031,7],["συναγωγῇ",712376,1]],"Alleluia. I will give thee thanks, O Lord, with my whole heart, in the council of the upright, and [in] the congregation."],["2",[["μεγάλα",708653,195],["τὰ",709436,63],["ἔργα",705396,64],["κυρίου",707996,18],["ἐξεζητημένα",704187,370],["εἰς",704105,0],["πάντα",710177,68],["τὰ",709436,41],["θελήματα",706170,42],["αὐτοῦ",702165,102]],"The works of the Lord are great, sought out according to all his will."],["3",[["ἐξομολόγησις",704961,12],["καὶ",707031,7],["μεγαλοπρέπεια",708632,12],["τὸ",709436,34],["ἔργον",705396,15],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἡ",709436,10],["δικαιοσύνη",703695,12],["αὐτοῦ",702165,102],["μένει",708736,91],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18]],"His work is [worthy of] thanksgiving and honour: and his righteousness endures for ever and ever."],["4",[["μνείαν",708961,9],["ἐποιήσατο",710582,23],["τῶν",709436,80],["θαυμασίων",706136,169],["αὐτοῦ",702165,102],["ἐλεήμων",704422,14],["καὶ",707031,7],["οἰκτίρμων",709521,14],["ὁ",709436,3],["κύριος",707996,4]],"He has caused his wonderful works to be remembered: the Lord is merciful and compassionate."],["5",[["τροφὴν",712984,9],["ἔδωκεν",703654,2],["τοῖς",709436,147],["φοβουμένοις",713532,341],["αὐτόν",702165,85],["μνησθήσεται",708923,134],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["διαθήκης",703456,17],["αὐτοῦ",702165,102]],"He has given food to them that fear him: he will remember his covenant for ever."],["6",[["ἰσχὺν",706858,9],["ἔργων",705396,44],["αὐτοῦ",702165,102],["ἀνήγγειλεν",700921,2],["τῷ",709436,113],["λαῷ",708094,114],["αὐτοῦ",702165,102],["τοῦ",709436,20],["δοῦναι",703654,106],["αὐτοῖς",702165,151],["κληρονομίαν",707725,9],["ἐθνῶν",704068,44]],"He has declared to his people the power of his works, to give them the inheritance of the heathen."],["7",[["ἔργα",705396,64],["χειρῶν",713787,65],["αὐτοῦ",702165,102],["ἀλήθεια",700656,12],["καὶ",707031,7],["κρίσις",707908,12],["πισταὶ",710486,192],["πᾶσαι",710177,192],["αἱ",709436,190],["ἐντολαὶ",704802,191],["αὐτοῦ",702165,102]],"The works of his hands are truth and judgment: all his commandments are sure:"],["8",[["ἐστηριγμέναι",712098,423],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18],["πεποιημέναι",710582,423],["ἐν",704639,0],["ἀληθείᾳ",700656,1],["καὶ",707031,7],["εὐθύτητι",705603,1]],"established for ever and ever, done in truth and uprightness."],["9",[["λύτρωσιν",708284,9],["ἀπέστειλεν",701592,2],["τῷ",709436,113],["λαῷ",708094,114],["αὐτοῦ",702165,102],["ἐνετείλατο",704791,23],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["διαθήκην",703456,9],["αὐτοῦ",702165,102],["ἅγιον",700159,26],["καὶ",707031,7],["φοβερὸν",713530,26],["τὸ",709436,34],["ὄνομα",709666,15],["αὐτοῦ",702165,102]],"He sent redemption to his people: he commanded his covenant for ever: holy and fearful is his name."],["10",[["ἀρχὴ",701836,12],["σοφίας",711981,17],["φόβος",713534,4],["κυρίου",707996,18],["σύνεσις",712460,12],["ἀγαθὴ",700106,29],["πᾶσι",710177,230],["τοῖς",709436,147],["ποιοῦσιν",710582,197],["αὐτήν",702165,104],["ἡ",709436,10],["αἴνεσις",700457,12],["αὐτοῦ",702165,102],["μένει",708736,91],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18]],"The fear of the Lord is the beginning of wisdom, and all that act accordingly have a good understanding; his praise endures for ever and ever."]]