[["1",[["τῷ",709436,113],["Δαυιδ",703232,114],["ἀγαλλιᾶσθε",700114,73],["δίκαιοι",703694,138],["ἐν",704639,0],["τῷ",709436,113],["κυρίῳ",707996,114],["τοῖς",709436,147],["εὐθέσι",705602,230],["πρέπει",710728,91],["αἴνεσις",700457,12]],"[A Psalm] of David. Rejoice in the Lord, ye righteous; praise becomes the upright."],["2",[["ἐξομολογεῖσθε",704960,73],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐν",704639,0],["κιθάρᾳ",707669,1],["ἐν",704639,0],["ψαλτηρίῳ",714023,54],["δεκαχόρδῳ",703345,97],["ψάλατε",714021,74],["αὐτῷ",702165,50]],"Praise the Lord on the harp; play to him on a psaltery of ten strings."],["3",[["ᾄσατε",700299,74],["αὐτῷ",702165,50],["ᾆσμα",701970,25],["καινόν",707042,46],["καλῶς",707106,28],["ψάλατε",714021,74],["ἐν",704639,0],["ἀλαλαγμῷ",700631,114]],"Sing to him a new song; play skilfully with a loud noise."],["4",[["ὅτι",709803,7],["εὐθὴς",705596,14],["ὁ",709436,3],["λόγος",708236,4],["τοῦ",709436,35],["κυρίου",707996,18],["καὶ",707031,7],["πάντα",710177,195],["τὰ",709436,63],["ἔργα",705396,64],["αὐτοῦ",702165,102],["ἐν",704639,0],["πίστει",710484,1]],"For the word of the Lord is right; and all his works are faithful."],["5",[["ἀγαπᾷ",700120,91],["ἐλεημοσύνην",704421,9],["καὶ",707031,7],["κρίσιν",707908,9],["τοῦ",709436,20],["ἐλέους",704426,21],["κυρίου",707996,18],["πλήρης",710541,14],["ἡ",709436,10],["γῆ",703083,12]],"He loves mercy and judgment; the earth is full of the mercy of the Lord."],["6",[["τῷ",709436,113],["λόγῳ",708236,114],["τοῦ",709436,35],["κυρίου",707996,18],["οἱ",709436,136],["οὐρανοὶ",709844,52],["ἐστερεώθησαν",712076,99],["καὶ",707031,7],["τῷ",709436,53],["πνεύματι",710566,54],["τοῦ",709436,20],["στόματος",712125,21],["αὐτοῦ",702165,102],["πᾶσα",710177,29],["ἡ",709436,10],["δύναμις",703839,12],["αὐτῶν",702165,40]],"By the word of the Lord the heavens were established; and all the host of them by the breath of his [mouth]."],["7",[["συνάγων",712375,72],["ὡς",714148,7],["ἀσκὸν",701968,6],["ὕδατα",713071,25],["θαλάσσης",706069,17],["τιθεὶς",712849,72],["ἐν",704639,0],["θησαυροῖς",706258,148],["ἀβύσσους",700098,39]],"Who gathers the waters of the sea as [in] a bottle; who lays up the deeps in treasuries."],["8",[["φοβηθήτω",713532,22],["τὸν",709436,5],["κύριον",707996,6],["πᾶσα",710177,29],["ἡ",709436,10],["γῆ",703083,12],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["δὲ",703303,11],["σαλευθήτωσαν",711403,51],["πάντες",710177,138],["οἱ",709436,136],["κατοικοῦντες",707534,146],["τὴν",709436,8],["οἰκουμένην",709517,173]],"Let all the earth fear the Lord; and let all that dwell in the world be moved because of him."],["9",[["ὅτι",709803,7],["αὐτὸς",702165,121],["εἶπεν",705373,2],["καὶ",707031,7],["ἐγενήθησαν",703104,99],["αὐτὸς",702165,121],["ἐνετείλατο",704791,23],["καὶ",707031,7],["ἐκτίσθησαν",707938,99]],"For he spoke, and they were made; he commanded, and they were created."],["10",[["κύριος",707996,4],["διασκεδάζει",703575,91],["βουλὰς",702792,39],["ἐθνῶν",704068,44],["ἀθετεῖ",700369,91],["δὲ",703303,11],["λογισμοὺς",708234,57],["λαῶν",708094,81],["καὶ",707031,7],["ἀθετεῖ",700369,91],["βουλὰς",702792,39],["ἀρχόντων",701862,81]],"The Lord frustrates the counsels of the nations; he brings to nought also the reasonings of the peoples, and brings to nought the counsels of princes."],["11",[["ἡ",709436,10],["δὲ",703303,11],["βουλὴ",702792,12],["τοῦ",709436,35],["κυρίου",707996,18],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["μένει",708736,91],["λογισμοὶ",708234,52],["τῆς",709436,16],["καρδίας",707141,17],["αὐτοῦ",702165,102],["εἰς",704105,0],["γενεὰν",703037,9],["καὶ",707031,7],["γενεάν",703037,9]],"But the counsel of the Lord endures for ever, the thoughts of his heart from generation to generation."],["12",[["μακάριον",708397,26],["τὸ",709436,34],["ἔθνος",704068,15],["οὗ",709781,160],["ἐστιν",704093,91],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["αὐτοῦ",702165,102],["λαός",708094,4],["ὃν",709781,112],["ἐξελέξατο",704236,23],["εἰς",704105,0],["κληρονομίαν",707725,9],["ἑαυτῷ",703917,50]],"Blessed is the nation whose God is the Lord; the people whom he has chosen for his own inheritance."],["13",[["ἐξ",704132,0],["οὐρανοῦ",709844,18],["ἐπέβλεψεν",705088,2],["ὁ",709436,3],["κύριος",707996,4],["εἶδεν",709725,2],["πάντας",710177,60],["τοὺς",709436,58],["υἱοὺς",713075,57],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"The Lord looks out of heaven; he beholds all the sons of men."],["14",[["ἐξ",704132,0],["ἑτοίμου",705541,92],["κατοικητηρίου",707536,21],["αὐτοῦ",702165,102],["ἐπέβλεψεν",705088,2],["ἐπὶ",705080,0],["πάντας",710177,60],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["τὴν",709436,8],["γῆν",703083,9]],"He looks from his prepared habitation on all the dwellers on the earth;"],["15",[["ὁ",709436,3],["πλάσας",710503,182],["κατὰ",707200,0],["μόνας",709003,119],["τὰς",709436,38],["καρδίας",707141,17],["αὐτῶν",702165,40],["ὁ",709436,3],["συνιεὶς",712481,182],["εἰς",704105,0],["πάντα",710177,68],["τὰ",709436,41],["ἔργα",705396,42],["αὐτῶν",702165,40]],"who fashioned their hearts alone; who understands all their works."],["16",[["οὐ",709805,28],["σῴζεται",712627,117],["βασιλεὺς",702580,4],["διὰ",703417,0],["πολλὴν",710646,36],["δύναμιν",703839,9],["καὶ",707031,7],["γίγας",703101,4],["οὐ",709805,28],["σωθήσεται",712627,134],["ἐν",704639,0],["πλήθει",710529,54],["ἰσχύος",706858,17],["αὐτοῦ",702165,102]],"A king is not saved by reason of a great host; and a giant shall not be delivered by the greatness of his strength."],["17",[["ψευδὴς",714036,14],["ἵππος",706790,4],["εἰς",704105,0],["σωτηρίαν",712658,9],["ἐν",704639,0],["δὲ",703303,11],["πλήθει",710529,54],["δυνάμεως",703839,17],["αὐτοῦ",702165,102],["οὐ",709805,28],["σωθήσεται",712627,134]],"A horse is vain for safety; neither shall he be delivered by the greatness of his power."],["18",[["ἰδοὺ",706497,88],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["κυρίου",707996,18],["ἐπὶ",705080,0],["τοὺς",709436,58],["φοβουμένους",713532,236],["αὐτὸν",702165,85],["τοὺς",709436,58],["ἐλπίζοντας",704529,235],["ἐπὶ",705080,0],["τὸ",709436,24],["ἔλεος",704426,25],["αὐτοῦ",702165,102]],"Behold, the eyes of the Lord are on them that fear him, those that hope in his mercy;"],["19",[["ῥύσασθαι",711309,109],["ἐκ",704132,0],["θανάτου",706096,18],["τὰς",709436,38],["ψυχὰς",714070,39],["αὐτῶν",702165,40],["καὶ",707031,7],["διαθρέψαι",703613,106],["αὐτοὺς",702165,62],["ἐν",704639,0],["λιμῷ",708210,114]],"to deliver their souls from death, and to keep them alive in famine."],["20",[["ἡ",709436,10],["ψυχὴ",714070,12],["ἡμῶν",705999,145],["ὑπομένει",713219,91],["τῷ",709436,113],["κυρίῳ",707996,114],["ὅτι",709803,7],["βοηθὸς",702748,4],["καὶ",707031,7],["ὑπερασπιστὴς",713123,4],["ἡμῶν",705999,145],["ἐστιν",704093,91]],"Our soul waits on the Lord; for he is our helper and defender."],["21",[["ὅτι",709803,7],["ἐν",704639,0],["αὐτῷ",702165,50],["εὐφρανθήσεται",705715,134],["ἡ",709436,10],["καρδία",707141,12],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ὀνόματι",709666,54],["τῷ",709436,53],["ἁγίῳ",700159,97],["αὐτοῦ",702165,102],["ἠλπίσαμεν",704529,289]],"For our heart shall rejoice in him, and we have hoped in his holy name."],["22",[["γένοιτο",703104,382],["τὸ",709436,34],["ἔλεός",704426,15],["σου",711945,133],["κύριε",707996,153],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["καθάπερ",706984,28],["ἠλπίσαμεν",704529,289],["ἐπὶ",705080,0],["σέ",711598,163]],"Let thy mercy, O Lord, be upon us, according as we have hoped in thee."]]