[["1",[["στηλογραφία",712093,12],["τῷ",709436,113],["Δαυιδ",703232,114],["φύλαξόν",713619,176],["με",708618,163],["κύριε",707996,153],["ὅτι",709803,7],["ἐπὶ",705080,0],["σοὶ",711925,159],["ἤλπισα",704529,155]],"A writing of David. Keep me, O Lord; for I have hoped in thee."],["2",[["εἶπα",705373,155],["τῷ",709436,113],["κυρίῳ",707996,114],["κύριός",707996,4],["μου",709032,133],["εἶ",704093,154],["σύ",712181,164],["ὅτι",709803,7],["τῶν",709436,43],["ἀγαθῶν",700106,83],["μου",709032,133],["οὐ",709805,28],["χρείαν",713938,9],["ἔχεις",705785,154]],"I said to the Lord, Thou art my Lord; for thou hast no need of my goodness."],["3",[["τοῖς",709436,147],["ἁγίοις",700159,230],["τοῖς",709436,147],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["αὐτοῦ",702165,102],["ἐθαυμάστωσεν",706139,2],["πάντα",710177,195],["τὰ",709436,63],["θελήματα",706170,64],["αὐτοῦ",702165,102],["ἐν",704639,0],["αὐτοῖς",702165,151]],"On behalf of the saints that are in his land, he has magnified all his pleasure in them."],["4",[["ἐπληθύνθησαν",710530,99],["αἱ",709436,190],["ἀσθένειαι",701937,191],["αὐτῶν",702165,40],["μετὰ",708780,0],["ταῦτα",709858,71],["ἐτάχυναν",712749,150],["οὐ",709805,28],["μὴ",708851,28],["συναγάγω",712375,207],["τὰς",709436,38],["συναγωγὰς",712376,39],["αὐτῶν",702165,40],["ἐξ",704132,0],["αἱμάτων",700442,44],["οὐδὲ",709816,7],["μὴ",708851,28],["μνησθῶ",708960,321],["τῶν",709436,43],["ὀνομάτων",709666,44],["αὐτῶν",702165,40],["διὰ",703417,0],["χειλέων",713781,44],["μου",709032,133]],"Their weaknesses have been multiplied; afterward they hasted. I will by no means assemble their bloody meetings, neither will I make mention of their names with my lips."],["5",[["κύριος",707996,4],["ἡ",709436,10],["μερὶς",708748,12],["τῆς",709436,16],["κληρονομίας",707725,17],["μου",709032,133],["καὶ",707031,7],["τοῦ",709436,20],["ποτηρίου",710699,21],["μου",709032,133],["σὺ",712181,164],["εἶ",704093,154],["ὁ",709436,3],["ἀποκαθιστῶν",701470,72],["τὴν",709436,8],["κληρονομίαν",707725,9],["μου",709032,133],["ἐμοί",704577,159]],"The Lord is the portion of mine inheritance and of my cup: thou art he that restores my inheritance to me."],["6",[["σχοινία",712610,64],["ἐπέπεσάν",705225,150],["μοι",708974,159],["ἐν",704639,0],["τοῖς",709436,147],["κρατίστοις",707891,343],["καὶ",707031,7],["γὰρ",702963,11],["ἡ",709436,10],["κληρονομία",707725,12],["μου",709032,133],["κρατίστη",707891,417],["μοί",708974,159],["ἐστιν",704093,91]],"The lines have fallen to me in the best places, yea, I have a most excellent heritage."],["7",[["εὐλογήσω",705631,165],["τὸν",709436,5],["κύριον",707996,6],["τὸν",709436,5],["συνετίσαντά",712463,365],["με",708618,163],["ἔτι",705538,28],["δὲ",703303,11],["καὶ",707031,28],["ἕως",705792,0],["νυκτὸς",709386,17],["ἐπαίδευσάν",709926,150],["με",708618,163],["οἱ",709436,136],["νεφροί",709282,52],["μου",709032,133]],"I will bless the Lord who has instructed me; my reins too have chastened me even till night."],["8",[["προωρώμην",710832,334],["τὸν",709436,5],["κύριον",707996,6],["ἐνώπιόν",704823,0],["μου",709032,133],["διὰ",703417,0],["παντός",710177,116],["ὅτι",709803,7],["ἐκ",704132,0],["δεξιῶν",703360,169],["μού",709032,133],["ἐστιν",704093,91],["ἵνα",706747,7],["μὴ",708851,28],["σαλευθῶ",711403,321]],"I foresaw the Lord always before my face; for he is on my right hand, that I should not be moved."],["9",[["διὰ",703417,0],["τοῦτο",709858,129],["ηὐφράνθη",705715,37],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["καὶ",707031,7],["ἠγαλλιάσατο",700114,23],["ἡ",709436,10],["γλῶσσά",703120,12],["μου",709032,133],["ἔτι",705538,28],["δὲ",703303,11],["καὶ",707031,28],["ἡ",709436,10],["σάρξ",711537,12],["μου",709032,133],["κατασκηνώσει",707423,127],["ἐπ᾿",705080,0],["ἐλπίδι",704530,1]],"Therefore my heart rejoiced and my tongue exulted; moreover also my flesh shall rest in hope:"],["10",[["ὅτι",709803,7],["οὐκ",709805,28],["ἐγκαταλείψεις",703967,166],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["εἰς",704105,0],["ᾅδην",700255,6],["οὐδὲ",709816,7],["δώσεις",703654,166],["τὸν",709436,5],["ὅσιόν",709782,27],["σου",711945,133],["ἰδεῖν",709725,106],["διαφθοράν",703625,9]],"because thou wilt not leave my soul in hell, neither wilt thou suffer thine Holy One to see corruption."],["11",[["ἐγνώρισάς",703135,162],["μοι",708974,159],["ὁδοὺς",709458,39],["ζωῆς",705910,17],["πληρώσεις",710543,166],["με",708618,163],["εὐφροσύνης",705717,17],["μετὰ",708780,0],["τοῦ",709436,20],["προσώπου",710986,21],["σου",711945,133],["τερπνότητες",712803,191],["ἐν",704639,0],["τῇ",709436,100],["δεξιᾷ",703360,101],["σου",711945,133],["εἰς",704105,0],["τέλος",712787,25]],"Thou hast made known to me the ways of life; thou wilt fill me with joy with thy countenance: at thy right hand [there are] delights for ever."]]