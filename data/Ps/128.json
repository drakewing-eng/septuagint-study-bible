[["1",[["ᾠδὴ",714091,12],["τῶν",709436,80],["ἀναβαθμῶν",700904,81],["πλεονάκις",710517,28],["ἐπολέμησάν",710601,150],["με",708618,163],["ἐκ",704132,0],["νεότητός",709258,17],["μου",709032,133],["εἰπάτω",705373,45],["δὴ",703395,11],["Ισραηλ",706839,4]],"A Song of Degrees. Many a time have they warred against me from my youth, let Israel now say:"],["2",[["πλεονάκις",710517,28],["ἐπολέμησάν",710601,150],["με",708618,163],["ἐκ",704132,0],["νεότητός",709258,17],["μου",709032,133],["καὶ",707031,7],["γὰρ",702963,11],["οὐκ",709805,28],["ἠδυνήθησάν",700296,99],["μοι",708974,159]],"Many a time have they warred against me from my youth: and yet they prevailed not against me."],["3",[["ἐπὶ",705080,0],["τοῦ",709436,20],["νώτου",709403,21],["μου",709032,133],["ἐτέκταινον",712764,137],["οἱ",709436,136],["ἁμαρτωλοί",700776,138],["ἐμάκρυναν",708428,150],["τὴν",709436,8],["ἀνομίαν",701192,9],["αὐτῶν",702165,565]],"The sinners wrought upon my back: they prolonged their iniquity."],["4",[["κύριος",707996,4],["δίκαιος",703694,14],["συνέκοψεν",712230,2],["αὐχένας",702169,39],["ἁμαρτωλῶν",700776,169]],"The righteous Lord has cut asunder the necks of sinners."],["5",[["αἰσχυνθήτωσαν",700485,51],["καὶ",707031,7],["ἀποστραφήτωσαν",701598,51],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,0],["πάντες",710177,138],["οἱ",709436,136],["μισοῦντες",708935,146],["Σιων",711816,17]],"Let all that hate Sion be put to shame and turned back."],["6",[["γενηθήτωσαν",703104,51],["ὡς",714148,7],["χόρτος",713923,4],["δωμάτων",703896,44],["ὃς",709781,213],["πρὸ",710747,0],["τοῦ",709436,20],["ἐκσπασθῆναι",704311,179],["ἐξηράνθη",709419,37]],"Let them be as the grass of the house-tops, which withers before it is plucked up."],["7",[["οὗ",709781,48],["οὐκ",709805,28],["ἐπλήρωσεν",710543,2],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,559],["ὁ",709436,3],["θερίζων",706206,72],["καὶ",707031,7],["τὸν",709436,5],["κόλπον",707800,6],["αὐτοῦ",702165,559],["ὁ",709436,3],["τὰ",709436,41],["δράγματα",703820,42],["συλλέγων",712263,72]],"Wherewith the reaper fills not his hand, nor he that makes up the sheaves, his bosom."],["8",[["καὶ",707031,7],["οὐκ",709805,28],["εἶπαν",705373,150],["οἱ",709436,136],["παράγοντες",710007,146],["εὐλογία",705633,12],["κυρίου",707996,18],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["εὐλογήκαμεν",705631,314],["ὑμᾶς",713080,194],["ἐν",704639,0],["ὀνόματι",709666,54],["κυρίου",707996,18]],"Neither do they that go by say, The blessing of the Lord be upon you: we have blessed you in the name of the Lord."]]