[["1",[["αἶνος",700462,4],["ᾠδῆς",714091,17],["τῷ",709436,113],["Δαυιδ",703232,114],["δεῦτε",703383,28],["ἀγαλλιασώμεθα",700114,276],["τῷ",709436,113],["κυρίῳ",707996,114],["ἀλαλάξωμεν",700632,79],["τῷ",709436,113],["θεῷ",706192,114],["τῷ",709436,113],["σωτῆρι",712657,114],["ἡμῶν",705999,145]],"The praise of a Song by David. Come, let us exult in the Lord; let us make a joyful noise to God our Saviour."],["2",[["προφθάσωμεν",711011,207],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["ἐν",704639,0],["ἐξομολογήσει",704961,1],["καὶ",707031,7],["ἐν",704639,0],["ψαλμοῖς",714022,148],["ἀλαλάξωμεν",700632,79],["αὐτῷ",702165,50]],"Let us come before his presence with thanksgiving, and make a joyful noise to him with psalms."],["3",[["ὅτι",709803,7],["θεὸς",706192,4],["μέγας",708653,14],["κύριος",707996,4],["καὶ",707031,7],["βασιλεὺς",702580,4],["μέγας",708653,14],["ἐπὶ",705080,0],["πάντας",710177,60],["τοὺς",709436,58],["θεούς",706192,57]],"For the Lord is a great God, and a great king over all gods: for the Lord will not cast off his people."],["4",[["ὅτι",709803,7],["ἐν",704639,0],["τῇ",709436,100],["χειρὶ",713787,1],["αὐτοῦ",702165,102],["τὰ",709436,63],["πέρατα",710281,15],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["τὰ",709436,63],["ὕψη",713288,64],["τῶν",709436,80],["ὀρέων",709768,44],["αὐτοῦ",702165,102],["εἰσιν",704093,197]],"For the ends of the earth are in his hands; and the heights of the mountains are his."],["5",[["ὅτι",709803,7],["αὐτοῦ",702165,102],["ἐστιν",704093,91],["ἡ",709436,10],["θάλασσα",706069,12],["καὶ",707031,7],["αὐτὸς",702165,121],["ἐποίησεν",710582,2],["αὐτήν",702165,104],["καὶ",707031,7],["τὴν",709436,8],["ξηρὰν",709421,36],["αἱ",709436,190],["χεῖρες",713787,191],["αὐτοῦ",702165,102],["ἔπλασαν",710503,150]],"For the sea is his, and he made it: and his hands formed the dry land."],["6",[["δεῦτε",703383,28],["προσκυνήσωμεν",710925,79],["καὶ",707031,7],["προσπέσωμεν",710952,79],["αὐτῷ",702165,50],["καὶ",707031,7],["κλαύσωμεν",707703,79],["ἐναντίον",704654,0],["κυρίου",707996,18],["τοῦ",709436,35],["ποιήσαντος",710582,500],["ἡμᾶς",705981,194]],"Come, let us worship and fall down before him; and weep before the Lord that made us."],["7",[["ὅτι",709803,7],["αὐτός",702165,121],["ἐστιν",704093,91],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["καὶ",707031,7],["ἡμεῖς",705983,219],["λαὸς",708094,4],["νομῆς",709337,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["πρόβατα",710768,42],["χειρὸς",713787,17],["αὐτοῦ",702165,102],["σήμερον",711751,28],["ἐὰν",703912,7],["τῆς",709436,16],["φωνῆς",713640,17],["αὐτοῦ",702165,102],["ἀκούσητε",700587,125]],"For he is our God; and we are the people of his pasture, and the sheep of his hand."],["8",[["μὴ",708851,28],["σκληρύνητε",711864,125],["τὰς",709436,38],["καρδίας",707141,39],["ὑμῶν",713091,145],["ὡς",714148,7],["ἐν",704639,0],["τῷ",709436,113],["παραπικρασμῷ",710088,114],["κατὰ",707200,0],["τὴν",709436,8],["ἡμέραν",705984,9],["τοῦ",709436,35],["πειρασμοῦ",710226,18],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1]],"To-day, if ye will hear his voice, harden not your hearts, as in the provocation, according to the day of irritation in the wilderness:"],["9",[["οὗ",709781,48],["ἐπείρασαν",710225,150],["οἱ",709436,136],["πατέρες",710189,52],["ὑμῶν",713091,145],["ἐδοκίμασαν",703776,150],["καὶ",707031,7],["εἴδοσαν",709725,150],["τὰ",709436,41],["ἔργα",705396,42],["μου",709032,133]],"where your fathers tempted me, proved me, and saw my works."],["10",[["τεσσαράκοντα",712806,59],["ἔτη",705543,42],["προσώχθισα",710945,155],["τῇ",709436,100],["γενεᾷ",703037,1],["ἐκείνῃ",704183,105],["καὶ",707031,7],["εἶπα",705373,155],["ἀεὶ",700311,28],["πλανῶνται",710495,269],["τῇ",709436,100],["καρδίᾳ",707141,1],["καὶ",707031,7],["αὐτοὶ",702165,201],["οὐκ",709805,28],["ἔγνωσαν",703105,150],["τὰς",709436,38],["ὁδούς",709458,39],["μου",709032,133]],"Forty years was I grieved with this generation, and said, They do always err in their heart, and they have not known my ways."],["11",[["ὡς",714148,7],["ὤμοσα",709620,155],["ἐν",704639,0],["τῇ",709436,100],["ὀργῇ",709728,1],["μου",709032,133],["εἰ",704071,7],["εἰσελεύσονται",704114,135],["εἰς",704105,0],["τὴν",709436,8],["κατάπαυσίν",707364,9],["μου",709032,133]],"So I sware in my wrath, They shall not enter into my rest."]]