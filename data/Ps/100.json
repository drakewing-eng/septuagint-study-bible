[["1",[["τῷ",709436,113],["Δαυιδ",703232,114],["ψαλμός",714022,4],["ἔλεος",704426,25],["καὶ",707031,7],["κρίσιν",707908,9],["ᾄσομαί",700299,181],["σοι",711925,159],["κύριε",707996,153]],"A Psalm of David. I will sing to thee, O Lord, of mercy and judgment; I will sing a psalm,"],["2",[["ψαλῶ",714021,165],["καὶ",707031,7],["συνήσω",712481,165],["ἐν",704639,0],["ὁδῷ",709458,1],["ἀμώμῳ",700895,30],["πότε",710696,11],["ἥξεις",705956,166],["πρός",710844,0],["με",708618,163],["διεπορευόμην",703551,334],["ἐν",704639,0],["ἀκακίᾳ",700511,1],["καρδίας",707141,17],["μου",709032,133],["ἐν",704639,0],["μέσῳ",708768,30],["τοῦ",709436,35],["οἴκου",709516,18],["μου",709032,133]],"and I will be wise in a blameless way. When wilt thou come to me? I walked in the innocence of my heart, in the midst of my house."],["3",[["οὐ",709805,28],["προεθέμην",710993,161],["πρὸ",710747,0],["ὀφθαλμῶν",709870,81],["μου",709032,133],["πρᾶγμα",710708,25],["παράνομον",710080,46],["ποιοῦντας",710582,235],["παραβάσεις",709999,39],["ἐμίσησα",708935,155]],"I have not set before mine eyes any unlawful thing; I have hated transgressors."],["4",[["οὐκ",709805,28],["ἐκολλήθη",707791,37],["μοι",708974,159],["καρδία",707141,12],["σκαμβή",711823,29],["ἐκκλίνοντος",704220,152],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["τοῦ",709436,35],["πονηροῦ",710660,116],["οὐκ",709805,28],["ἐγίνωσκον",703105,333]],"A perverse heart has not cleaved to me; I have not known an evil man, forasmuch as he turns away from me.",{"s":"d","q":0.55}],["5",[["τὸν",709436,5],["καταλαλοῦντα",707298,183],["λάθρᾳ",708057,28],["τοῦ",709436,35],["πλησίον",710547,28],["αὐτοῦ",702165,102],["τοῦτον",709858,85],["ἐξεδίωκον",704178,333],["ὑπερηφάνῳ",713139,30],["ὀφθαλμῷ",709870,114],["καὶ",707031,7],["ἀπλήστῳ",701418,30],["καρδίᾳ",707141,1],["τούτῳ",709858,50],["οὐ",709805,28],["συνήσθιον",712459,333]],"Him that privily speaks against his neighbour, him have I driven from [me]: he that is proud in look and insatiable in heart,—with him I have not eaten."],["6",[["οἱ",709436,136],["ὀφθαλμοί",709870,52],["μου",709032,133],["ἐπὶ",705080,0],["τοὺς",709436,58],["πιστοὺς",710486,60],["τῆς",709436,16],["γῆς",703083,17],["τοῦ",709436,20],["συγκαθῆσθαι",712195,106],["αὐτοὺς",702165,62],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["πορευόμενος",710667,122],["ἐν",704639,0],["ὁδῷ",709458,1],["ἀμώμῳ",700895,101],["οὗτός",709858,121],["μοι",708974,159],["ἐλειτούργει",708132,13]],"Mine eyes [shall be] upon the faithful of the land, that they may dwell with me: he that walked in a perfect way, the same ministered to me."],["7",[["οὐ",709805,28],["κατῴκει",707534,13],["ἐν",704639,0],["μέσῳ",708768,30],["τῆς",709436,16],["οἰκίας",709505,17],["μου",709032,133],["ποιῶν",710582,72],["ὑπερηφανίαν",713138,9],["λαλῶν",708071,72],["ἄδικα",700272,68],["οὐ",709805,28],["κατεύθυνεν",707521,2],["ἐναντίον",704654,0],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["μου",709032,133]],"The proud doer dwelt not in the midst of my house; the unjust speaker prospered not in my sight."],["8",[["εἰς",704105,0],["τὰς",709436,38],["πρωίας",711025,39],["ἀπέκτεννον",701498,155],["πάντας",710177,60],["τοὺς",709436,58],["ἁμαρτωλοὺς",700776,60],["τῆς",709436,16],["γῆς",703083,17],["τοῦ",709436,35],["ἐξολεθρεῦσαι",704956,106],["ἐκ",704132,0],["πόλεως",710612,17],["κυρίου",707996,18],["πάντας",710177,60],["τοὺς",709436,58],["ἐργαζομένους",705383,235],["τὴν",709436,8],["ἀνομίαν",701192,9]],"Early did I slay all the sinners of the land, that I might destroy out of the city of the Lord all that work iniquity."]]