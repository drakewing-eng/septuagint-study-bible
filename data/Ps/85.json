,713640,1],["τῆς",709436,16],["δεήσεώς",703311,17],["μου",709032,133]],"Give ear to my prayer, O Lord; and attend to the voice of my supplication."],["7",[["ἐν",704639,0],["ἡμέρᾳ",705984,1],["θλίψεώς",706276,17],["μου",709032,133],["ἐκέκραξα",707868,155],["πρὸς",710844,0],["σέ",711598,163],["ὅτι",709803,7],["εἰσήκουσάς",704108,162],["μου",709032,133]],"In the day of my trouble I cried to thee: for thou didst hear me."],["8",[["οὐκ",709805,28],["ἔστιν",704093,91],["ὅμοιός",709626,14],["σοι",711925,159],["ἐν",704639,0],["θεοῖς",706192,148],["κύριε",707996,153],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["κατὰ",707200,0],["τὰ",709436,41],["ἔργα",705396,42],["σου",711945,133]],"There is none like to thee, O Lord, among the gods; and there are no [works] like to thy works."],["9",[["πάντα",710177,195],["τὰ",709436,63],["ἔθνη",704068,64],["ὅσα",709788,68],["ἐποίησας",710582,162],["ἥξουσιν",705956,218],["καὶ",707031,7],["προσκυνήσουσιν",710925,218],["ἐνώπιόν",704823,0],["σου",711945,133],["κύριε",707996,153],["καὶ",707031,7],["δοξάσουσιν",703792,218],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133]],"All nations whom thou hast made shall come, and shall worship before thee, O Lord; and shall glorify thy name."],["10",[["ὅτι",709803,7],["μέγας",708653,14],["εἶ",704093,154],["σὺ",712181,164],["καὶ",707031,7],["ποιῶν",710582,72],["θαυμάσια",706136,68],["σὺ",712181,164],["εἶ",704093,154],["ὁ",709436,3],["θεὸς",706192,4],["μόνος",709003,14],["ὁ",709436,3],["μέγας",708653,14]],"For thou art great, and doest wonders: thou art the only [and] the great God."],["11",[["ὁδήγησόν",709448,176],["με",708618,163],["κύριε",707996,153],["τῇ",709436,100],["ὁδῷ",709458,1],["σου",711945,133],["καὶ",707031,7],["πορεύσομαι",710667,181],["ἐν",704639,0],["τῇ",709436,100],["ἀληθείᾳ",700656,1],["σου",711945,133],["εὐφρανθήτω",705715,22],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["τοῦ",709436,20],["φοβεῖσθαι",713532,110],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133]],"Guide me, O Lord, in thy way, and I will walk in thy truth: let my heart rejoice, that I may fear thy name."],["12",[["ἐξομολογήσομαί",704960,181],["σοι",711925,159],["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["ἐν",704639,0],["ὅλῃ",709597,101],["καρδίᾳ",707141,1],["μου",709032,133],["καὶ",707031,7],["δοξάσω",703792,165],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"I will give thee thanks, O Lord my God, with all my heart; and I will glorify thy name for ever."],["13",[["ὅτι",709803,7],["τὸ",709436,34],["ἔλεός",704426,15],["σου",711945,133],["μέγα",708653,26],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["καὶ",707031,7],["ἐρρύσω",711309,174],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἐξ",704132,0],["ᾅδου",700255,18],["κατωτάτου",707560,116]],"For thy mercy is great toward me; and thou hast delivered my soul from the lowest hell."],["14",[["ὁ",709436,3],["θεός",706192,4],["παράνομοι",710080,138],["ἐπανέστησαν",705026,150],["ἐπ᾿",705080,0],["ἐμέ",704555,163],["καὶ",707031,7],["συναγωγὴ",712376,12],["κραταιῶν",707873,169],["ἐζήτησαν",705879,150],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["καὶ",707031,7],["οὐ",709805,28],["προέθεντό",710993,189],["σε",711598,163],["ἐνώπιον",704823,0],["αὐτῶν",702165,40]],"O God, transgressors have risen up against me, and an assembly of violent [men] have sought my life; and have not set thee before them."],["15",[["καὶ",707031,7],["σύ",712181,164],["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["οἰκτίρμων",709521,4],["καὶ",707031,7],["ἐλεήμων",704422,14],["μακρόθυμος",708420,14],["καὶ",707031,7],["πολυέλεος",710624,14],["καὶ",707031,7],["ἀληθινός",700659,14]],"But thou, O Lord God, art compassionate and merciful, long-suffering, and abundant in mercy and true."],["16",[["ἐπίβλεψον",705088,176],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["καὶ",707031,7],["ἐλέησόν",704418,176],["με",708618,163],["δὸς",703654,176],[