[["1",[["προσευχὴ",710892,12],["τοῦ",709436,35],["Μωυσῆ",709112,18],["ἀνθρώπου",701163,18],["τοῦ",709436,35],["θεοῦ",706192,18],["κύριε",707996,153],["καταφυγὴ",707485,12],["ἐγενήθης",703104,168],["ἡμῖν",705994,90],["ἐν",704639,0],["γενεᾷ",703037,1],["καὶ",707031,7],["γενεᾷ",703037,1]],"A Prayer of Moses the man of God. Lord, thou hast been our refuge in all generations."],["2",[["πρὸ",710747,0],["τοῦ",709436,20],["ὄρη",709768,42],["γενηθῆναι",703104,179],["καὶ",707031,7],["πλασθῆναι",710503,179],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["τὴν",709436,8],["οἰκουμένην",709517,173],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["ἕως",705792,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["σὺ",712181,164],["εἶ",704093,154]],"Before the mountains existed, and [before] the earth and the world were formed, even from age to age, Thou art."],["3",[["μὴ",708851,28],["ἀποστρέψῃς",701598,175],["ἄνθρωπον",701163,6],["εἰς",704105,0],["ταπείνωσιν",712719,9],["καὶ",707031,7],["εἶπας",705373,162],["ἐπιστρέψατε",705278,74],["υἱοὶ",713075,52],["ἀνθρώπων",701163,81]],"Turn not man back to [his] low place, whereas thou saidst, Return, ye sons of men?"],["4",[["ὅτι",709803,7],["χίλια",713859,195],["ἔτη",705543,64],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["σου",711945,133],["ὡς",714148,7],["ἡ",709436,10],["ἡμέρα",705984,12],["ἡ",709436,10],["ἐχθές",713853,28],["ἥτις",709793,412],["διῆλθεν",703673,2],["καὶ",707031,7],["φυλακὴ",713613,12],["ἐν",704639,0],["νυκτί",709386,1]],"For a thousand years in thy sight are as the yesterday which is past, and as a watch in the night."],["5",[["τὰ",709436,63],["ἐξουδενώματα",704970,64],["αὐτῶν",702165,40],["ἔτη",705543,64],["ἔσονται",704093,135],["τὸ",709436,34],["πρωὶ",711021,28],["ὡσεὶ",714159,11],["χλόη",713877,12],["παρέλθοι",710141,225]],"Years shall be vanity to them: let the morning pass away as grass."],["6",[["τὸ",709436,24],["πρωὶ",711021,28],["ἀνθήσαι",701152,106],["καὶ",707031,7],["παρέλθοι",710141,225],["τὸ",709436,24],["ἑσπέρας",705500,17],["ἀποπέσοι",701546,583],["σκληρυνθείη",711864,528],["καὶ",707031,7],["ξηρανθείη",709419,528]],"In the morning let it flower, and pass away: in the evening let it droop, let it be withered and dried up."],["7",[["ὅτι",709803,7],["ἐξελίπομεν",704237,289],["ἐν",704639,0],["τῇ",709436,100],["ὀργῇ",709728,1],["σου",711945,133],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["θυμῷ",706334,114],["σου",711945,133],["ἐταράχθημεν",712721,485]],"For we have perished in thine anger, and in thy wrath we have been troubled."],["8",[["ἔθου",712849,174],["τὰς",709436,38],["ἀνομίας",701192,39],["ἡμῶν",705999,145],["ἐνώπιόν",704823,0],["σου",711945,133],["ὁ",709436,3],["αἰὼν",700504,4],["ἡμῶν",705999,145],["εἰς",704105,0],["φωτισμὸν",713647,6],["τοῦ",709436,20],["προσώπου",710986,21],["σου",711945,133]],"Thou hast set our transgressions before thee: our age is in the light of thy countenance."],["9",[["ὅτι",709803,7],["πᾶσαι",710177,192],["αἱ",709436,190],["ἡμέραι",705984,191],["ἡμῶν",705999,145],["ἐξέλιπον",704237,150],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["ὀργῇ",709728,1],["σου",711945,133],["ἐξελίπομεν",704237,289],["τὰ",709436,63],["ἔτη",705543,64],["ἡμῶν",705999,145],["ὡς",714148,7],["ἀράχνην",701693,9],["ἐμελέτων",708698,137]],"For all our days are gone, and we have passed away in thy wrath: our years have spun out their tale as a spider."],["10",[["αἱ",709436,190],["ἡμέραι",705984,191],["τῶν",709436,43],["ἐτῶν",705543,44],["ἡμῶν",705999,145],["ἐν",704639,0],["αὐτοῖς",702165,151],["ἑβδομήκοντα",703922,59],["ἔτη",705543,64],["ἐὰν",703912,7],["δὲ",703303,11],["ἐν",704639,0],["δυναστείαις",703841,76],["ὀγδοήκοντα",709442,59],["ἔτη",705543,64],["καὶ",707031,7],["τὸ",709436,24],["πλεῖον",710514,46],["αὐτῶν",702165,40],["κόπος",707825,4],["καὶ",707031,7],["πόνος",710661,4],["ὅτι",709803,7],["ἐπῆλθεν",705068,2],["πραΰτης",710726,12],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["καὶ",707031,7],["παιδευθησόμεθα",709926,347]],"[As for] the days of our years, in them are seventy years; and if [men should be] in strength, eighty years: and the greater part of them would be labour and trouble; for weakness overtakes us, and we shall be chastened."],["11",[["τίς",712867,158],["γινώσκει",703105,91],["τὸ",709436,24],["κράτος",707883,25],["τῆς",709436,16],["ὀργῆς",709728,17],["σου",711945,133],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,35],["φόβου",713534,18],["σου",711945,133],["τὸν",709436,5],["θυμόν",706334,6],["σου",711945,133]],"Who knows the power of thy wrath?"],["12",[["ἐξαριθμήσασθαι",704877,109],["τὴν",709436,8],["δεξιάν",703360,36],["σου",711945,133],["οὕτως",709859,28],["γνώρισον",703135,176],["καὶ",707031,7],["τοὺς",709436,58],["πεπεδημένους",710208,360],["τῇ",709436,100],["καρδίᾳ",707141,1],["ἐν",704639,0],["σοφίᾳ",711981,1]],"and [who knows how] to number [his days] because of the fear of thy wrath? So manifest thy right hand, and those that are instructed in wisdom in the heart."],["13",[["ἐπίστρεψον",705278,176],["κύριε",707996,153],["ἕως",705792,0],["πότε",710696,11],["καὶ",707031,7],["παρακλήθητι",710039,244],["ἐπὶ",705080,0],["τοῖς",709436,147],["δούλοις",703817,148],["σου",711945,133]],"Return, O Lord, how long? and be intreated concerning thy servants."],["14",[["ἐνεπλήσθημεν",704592,485],["τὸ",709436,24],["πρωὶ",711021,28],["τοῦ",709436,20],["ἐλέους",704426,21],["σου",711945,133],["καὶ",707031,7],["ἠγαλλιασάμεθα",700114,316],["καὶ",707031,7],["εὐφράνθημεν",705715,485],["ἐν",704639,0],["πάσαις",710177,291],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἡμῶν",705999,145]],"We have been satisfied in the morning with thy mercy; and we did exult and rejoice:"],["15",[["εὐφράνθημεν",705715,485],["ἀνθ᾿",701227,0],["ὧν",709781,252],["ἡμερῶν",705984,65],["ἐταπείνωσας",712717,162],["ἡμᾶς",705981,194],["ἐτῶν",705543,44],["ὧν",709781,252],["εἴδομεν",709725,289],["κακά",707066,68]],"let us rejoice in all our days, in return for the days wherein thou didst afflict us, the years wherein we saw evil."],["16",[["καὶ",707031,7],["ἰδὲ",709725,176],["ἐπὶ",705080,0],["τοὺς",709436,58],["δούλους",703817,57],["σου",711945,133],["καὶ",707031,7],["τὰ",709436,41],["ἔργα",705396,42],["σου",711945,133],["καὶ",707031,7],["ὁδήγησον",709448,176],["τοὺς",709436,58],["υἱοὺς",713075,57],["αὐτῶν",702165,40]],"And look upon thy servants, and upon thy works; and guide their children."],["17",[["καὶ",707031,7],["ἔστω",704093,31],["ἡ",709436,10],["λαμπρότης",708083,12],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["καὶ",707031,7],["τὰ",709436,41],["ἔργα",705396,42],["τῶν",709436,80],["χειρῶν",713787,65],["ἡμῶν",705999,145],["κατεύθυνον",707521,176],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194]],"And let the brightness of the Lord our God be upon us: and do thou direct for us the works of our hands."]]