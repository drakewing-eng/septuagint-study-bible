[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["τοῖς",709436,147],["υἱοῖς",713075,148],["Κορε",707833,118],["ψαλμός",714022,4]],"For the end, a Psalm for the sons of Core."],["2",[["ἀκούσατε",700587,74],["ταῦτα",709858,71],["πάντα",710177,195],["τὰ",709436,63],["ἔθνη",704068,64],["ἐνωτίσασθε",704825,186],["πάντες",710177,138],["οἱ",709436,136],["κατοικοῦντες",707534,146],["τὴν",709436,8],["οἰκουμένην",709517,173]],"Hear these words, all ye nations, hearken, all ye that dwell upon the earth:"],["3",[["οἵ",709781,250],["τε",712751,11],["γηγενεῖς",703085,138],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["τῶν",709436,80],["ἀνθρώπων",701163,81],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτὸ",702165,129],["πλούσιος",710560,14],["καὶ",707031,7],["πένης",710248,4]],"both the sons of mean men, and sons of [great] men; the rich and poor [man] together."],["4",[["τὸ",709436,34],["στόμα",712125,15],["μου",709032,133],["λαλήσει",708071,127],["σοφίαν",711981,9],["καὶ",707031,7],["ἡ",709436,10],["μελέτη",708699,12],["τῆς",709436,16],["καρδίας",707141,17],["μου",709032,133],["σύνεσιν",712460,9]],"My mouth shall speak of wisdom; and the meditation of my heart shall bring [forth] understanding."],["5",[["κλινῶ",707738,165],["εἰς",704105,0],["παραβολὴν",710003,9],["τὸ",709436,24],["οὖς",709852,25],["μου",709032,133],["ἀνοίξω",701186,165],["ἐν",704639,0],["ψαλτηρίῳ",714023,54],["τὸ",709436,24],["πρόβλημά",710771,25],["μου",709032,133]],"I will incline mine ear to a parable: I will open my riddle on the harp."],["6",[["ἵνα",706747,7],["τί",712867,126],["φοβοῦμαι",713532,254],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["πονηρᾷ",710660,101],["ἡ",709436,10],["ἀνομία",701192,12],["τῆς",709436,16],["πτέρνης",711051,17],["μου",709032,133],["κυκλώσει",707958,127],["με",708618,163]],"Wherefore should I fear in the evil day? the iniquity of my heel shall compass me."],["7",[["οἱ",709436,136],["πεποιθότες",710221,268],["ἐπὶ",705080,0],["τῇ",709436,100],["δυνάμει",703839,1],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπὶ",705080,0],["τῷ",709436,53],["πλήθει",710529,54],["τοῦ",709436,35],["πλούτου",710563,18],["αὐτῶν",702165,40],["καυχώμενοι",707569,348]],"They that trust in their strength, and boast themselves in the multitude of their wealth—"],["8",[["ἀδελφὸς",700249,4],["οὐ",709805,28],["λυτροῦται",708282,117],["λυτρώσεται",708282,93],["ἄνθρωπος",701163,4],["οὐ",709805,28],["δώσει",703654,127],["τῷ",709436,113],["θεῷ",706192,114],["ἐξίλασμα",704933,25],["αὐτοῦ",702165,102]],"A brother does not redeem, shall a man redeem? he shall not give to God a ransom for himself,"],["9",[["καὶ",707031,7],["τὴν",709436,8],["τιμὴν",712856,9],["τῆς",709436,16],["λυτρώσεως",708284,17],["τῆς",709436,16],["ψυχῆς",714070,17],["αὐτοῦ",702165,102]],"or the price of the redemption of his soul, though he labour for ever,"],["10",[["καὶ",707031,7],["ἐκόπασεν",707819,2],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["ζήσεται",705851,93],["εἰς",704105,0],["τέλος",712787,25],["ὅτι",709803,7],["οὐκ",709805,28],["ὄψεται",709725,93],["καταφθοράν",707475,9],["ὅταν",709801,28],["ἴδῃ",709725,172],["σοφοὺς",711985,60],["ἀποθνῄσκοντας",701461,235]],"and live to the end, [so] that he should not see corruption."],["11",[["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτὸ",702165,129],["ἄφρων",702236,4],["καὶ",707031,7],["ἄνους",701203,4],["ἀπολοῦνται",701513,135],["καὶ",707031,7],["καταλείψουσιν",707305,218],["ἀλλοτρίοις",700699,230],["τὸν",709436,5],["πλοῦτον",710563,6],["αὐτῶν",702165,40]],"When he shall see wise men dying, the fool and the senseless one shall perish together; and they shall leave their wealth to strangers."],["12",[["καὶ",707031,7],["οἱ",709436,136],["τάφοι",712738,52],["αὐτῶν",702165,40],["οἰκίαι",709505,191],["αὐτῶν",702165,40],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["σκηνώματα",711849,64],["αὐτῶν",702165,40],["εἰς",704105,0],["γενεὰν",703037,9],["καὶ",707031,7],["γενεάν",703037,9],["ἐπεκαλέσαντο",705153,189],["τὰ",709436,41],["ὀνόματα",709666,42],["αὐτῶν",702165,40],["ἐπὶ",705080,0],["τῶν",709436,130],["γαιῶν",702903,65],["αὐτῶν",702165,40]],"And their sepulchres are their houses for ever, [even] their tabernacles to all generations: they have called their lands after their own names."],["13",[["καὶ",707031,7],["ἄνθρωπος",701163,4],["ἐν",704639,0],["τιμῇ",712856,1],["ὢν",704093,72],["οὐ",709805,28],["συνῆκεν",712481,2],["παρασυνεβλήθη",710106,37],["τοῖς",709436,95],["κτήνεσιν",707934,96],["τοῖς",709436,95],["ἀνοήτοις",701184,94],["καὶ",707031,7],["ὡμοιώθη",709628,37],["αὐτοῖς",702165,206]],"And man being in honour, understands not: he is compared to the senseless cattle, and is like to them."],["14",[["αὕτη",709858,107],["ἡ",709436,10],["ὁδὸς",709458,12],["αὐτῶν",702165,40],["σκάνδαλον",711825,15],["αὐτοῖς",702165,151],["καὶ",707031,7],["μετὰ",708780,0],["ταῦτα",709858,71],["ἐν",704639,0],["τῷ",709436,53],["στόματι",712125,54],["αὐτῶν",702165,40],["εὐδοκήσουσιν",705565,218],["διάψαλμα",703641,15]],"This their way is an offence to them: yet afterwards men will commend their sayings. Pause."],["15",[["ὡς",714148,7],["πρόβατα",710768,42],["ἐν",704639,0],["ᾅδῃ",700255,114],["ἔθεντο",712849,189],["θάνατος",706096,4],["ποιμαίνει",710594,91],["αὐτούς",702165,62],["καὶ",707031,7],["κατακυριεύσουσιν",707297,218],["αὐτῶν",702165,40],["οἱ",709436,136],["εὐθεῖς",705602,138],["τὸ",709436,24],["πρωί",711021,28],["καὶ",707031,7],["ἡ",709436,10],["βοήθεια",702745,12],["αὐτῶν",702165,40],["παλαιωθήσεται",709937,134],["ἐν",704639,0],["τῷ",709436,113],["ᾅδῃ",700255,114],["ἐκ",704132,0],["τῆς",709436,16],["δόξης",703791,17],["αὐτῶν",702165,40]],"They have laid [them] as sheep in Hades; death shall feed on them; and the upright shall have dominion over them in the morning, and their help shall fail in Hades from their glory."],["16",[["πλὴν",710540,28],["ὁ",709436,3],["θεὸς",706192,4],["λυτρώσεται",708282,93],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἐκ",704132,0],["χειρὸς",713787,17],["ᾅδου",700255,18],["ὅταν",709801,28],["λαμβάνῃ",708076,204],["με",708618,163],["διάψαλμα",703641,15]],"But God shall deliver my soul from the power of Hades, when he shall receive me. Pause."],["17",[["μὴ",708851,28],["φοβοῦ",713532,253],["ὅταν",709801,28],["πλουτήσῃ",710561,172],["ἄνθρωπος",701163,4],["καὶ",707031,7],["ὅταν",709801,28],["πληθυνθῇ",710530,384],["ἡ",709436,10],["δόξα",703791,12],["τοῦ",709436,35],["οἴκου",709516,18],["αὐτοῦ",702165,102]],"Fear not when a man is enriched, and when the glory of his house is increased."],["18",[["ὅτι",709803,7],["οὐκ",709805,28],["ἐν",704639,0],["τῷ",709436,53],["ἀποθνῄσκειν",701461,55],["αὐτὸν",702165,85],["λήμψεται",708076,93],["τὰ",709436,41],["πάντα",710177,68],["οὐδὲ",709816,7],["συγκαταβήσεται",712203,93],["αὐτῷ",702165,50],["ἡ",709436,10],["δόξα",703791,12],["αὐτοῦ",702165,102]],"For he shall take nothing when he dies; neither shall his glory descend with him."],["19",[["ὅτι",709803,7],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῇ",709436,100],["ζωῇ",705910,1],["αὐτοῦ",702165,102],["εὐλογηθήσεται",705631,134],["ἐξομολογήσεταί",704960,93],["σοι",711925,159],["ὅταν",709801,28],["ἀγαθύνῃς",700109,175],["αὐτῷ",702165,50]],"For his soul shall be blessed in his life: he shall give thanks to thee when thou dost well to him."],["20",[["εἰσελεύσεται",704114,93],["ἕως",705792,0],["γενεᾶς",703037,17],["πατέρων",710189,81],["αὐτοῦ",702165,102],["ἕως",705792,0],["αἰῶνος",700504,18],["οὐκ",709805,28],["ὄψεται",709725,93],["φῶς",713642,25]],"[Yet] he shall go in to the generation of his fathers; he shall never see light."],["21",[["ἄνθρωπος",701163,4],["ἐν",704639,0],["τιμῇ",712856,1],["ὢν",704093,72],["οὐ",709805,28],["συνῆκεν",712481,2],["παρασυνεβλήθη",710106,37],["τοῖς",709436,95],["κτήνεσιν",707934,96],["τοῖς",709436,147],["ἀνοήτοις",701184,230],["καὶ",707031,7],["ὡμοιώθη",709628,37],["αὐτοῖς",702165,151]],"Man that is in honour, understands not: he is compared to the senseless cattle, and is like them."]]