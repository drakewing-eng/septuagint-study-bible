[["1",[["ψαλμὸς",714022,4],["ᾠδῆς",714091,17],["εἰς",704105,0],["τὴν",709436,8],["ἡμέραν",705984,9],["τοῦ",709436,20],["σαββάτου",711350,21]],"A Psalm of a Song for the Sabbath-day."],["2",[["ἀγαθὸν",700106,46],["τὸ",709436,24],["ἐξομολογεῖσθαι",704960,110],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["ψάλλειν",714021,55],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["ὕψιστε",713287,564]],"It is a good thing to give thanks to the Lord, and to sing praises to thy name, O thou Most High;"],["3",[["τοῦ",709436,20],["ἀναγγέλλειν",700921,55],["τὸ",709436,24],["πρωὶ",711021,28],["τὸ",709436,24],["ἔλεός",704426,25],["σου",711945,133],["καὶ",707031,7],["τὴν",709436,8],["ἀλήθειάν",700656,9],["σου",711945,133],["κατὰ",707200,0],["νύκτα",709386,9]],"to proclaim thy mercy in the morning, and thy truth by night,"],["4",[["ἐν",704639,0],["δεκαχόρδῳ",703345,97],["ψαλτηρίῳ",714023,54],["μετ᾿",708780,0],["ᾠδῆς",714091,17],["ἐν",704639,0],["κιθάρᾳ",707669,1]],"on a psaltery of ten strings, with a song on the harp."],["5",[["ὅτι",709803,7],["εὔφρανάς",705715,162],["με",708618,163],["κύριε",707996,153],["ἐν",704639,0],["τῷ",709436,53],["ποιήματί",710583,54],["σου",711945,133],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["ἔργοις",705396,96],["τῶν",709436,130],["χειρῶν",713787,65],["σου",711945,133],["ἀγαλλιάσομαι",700114,181]],"For thou, O Lord, hast made me glad with thy work: and in the operations of thy hands will I exult."],["6",[["ὡς",714148,7],["ἐμεγαλύνθη",708647,37],["τὰ",709436,63],["ἔργα",705396,64],["σου",711945,133],["κύριε",707996,153],["σφόδρα",712586,28],["ἐβαθύνθησαν",702380,99],["οἱ",709436,136],["διαλογισμοί",703506,52],["σου",711945,133]],"How have thy works been magnified, O Lord! thy thoughts are very deep."],["7",[["ἀνὴρ",701150,4],["ἄφρων",702236,14],["οὐ",709805,28],["γνώσεται",703105,93],["καὶ",707031,7],["ἀσύνετος",702034,14],["οὐ",709805,28],["συνήσει",712481,127],["ταῦτα",709858,71]],"A foolish man will not know, and a senseless man will not understand this."],["8",[["ἐν",704639,0],["τῷ",709436,53],["ἀνατεῖλαι",701066,106],["τοὺς",709436,58],["ἁμαρτωλοὺς",700776,60],["ὡς",714148,7],["χόρτον",713923,6],["καὶ",707031,7],["διέκυψαν",703491,150],["πάντες",710177,138],["οἱ",709436,136],["ἐργαζόμενοι",705383,348],["τὴν",709436,8],["ἀνομίαν",701192,9],["ὅπως",709719,7],["ἂν",700900,11],["ἐξολεθρευθῶσιν",704956,272],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18]],"When the sinners spring up as the grass, and all the workers of iniquity have watched; [it is] that they may be utterly destroyed for ever."],["9",[["σὺ",712181,164],["δὲ",703303,11],["ὕψιστος",713287,14],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["κύριε",707996,153]],"But thou, O Lord, art most high for ever."],["10",[["ὅτι",709803,7],["ἰδοὺ",706497,88],["οἱ",709436,136],["ἐχθροί",705779,52],["σου",711945,133],["ἀπολοῦνται",701513,135],["καὶ",707031,7],["διασκορπισθήσονται",703579,144],["πάντες",710177,138],["οἱ",709436,136],["ἐργαζόμενοι",705383,348],["τὴν",709436,8],["ἀνομίαν",701192,9]],"For, behold, thine enemies shall perish; and all the workers of iniquity shall be scattered."],["11",[["καὶ",707031,7],["ὑψωθήσεται",713289,134],["ὡς",714148,7],["μονοκέρωτος",708999,18],["τὸ",709436,24],["κέρας",707625,25],["μου",709032,133],["καὶ",707031,7],["τὸ",709436,24],["γῆράς",703089,25],["μου",709032,133],["ἐν",704639,0],["ἐλαίῳ",704380,54],["πίονι",710491,97]],"But my horn shall be exalted as [the horn] of a unicorn; and mine old age with rich mercy."],["12",[["καὶ",707031,7],["ἐπεῖδεν",705057,2],["ὁ",709436,3],["ὀφθαλμός",709870,4],["μου",709032,133],["ἐν",704639,0],["τοῖς",709436,147],["ἐχθροῖς",705779,148],["μου",709032,133],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["ἐπανιστανομένοις",705026,521],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["πονηρευομένοις",710657,341],["ἀκούσεται",700587,93],["τὸ",709436,34],["οὖς",709852,15],["μου",709032,133]],"And mine eye has seen mine enemies, and mine ear shall hear the wicked that rise up against me."],["13",[["δίκαιος",703694,14],["ὡς",714148,7],["φοῖνιξ",713541,4],["ἀνθήσει",701152,127],["ὡσεὶ",714159,11],["κέδρος",707590,12],["ἡ",709436,10],["ἐν",704639,0],["τῷ",709436,113],["Λιβάνῳ",708185,114],["πληθυνθήσεται",710530,134]],"The righteous shall flourish as a palm-tree: he shall be increased as the cedar in Libanus."],["14",[["πεφυτευμένοι",713636,429],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["κυρίου",707996,18],["ἐν",704639,0],["ταῖς",709436,75],["αὐλαῖς",702137,76],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["ἐξανθήσουσιν",704864,218]],"They that are planted in the house of the Lord shall flourish in the courts of our God."],["15",[["ἔτι",705538,28],["πληθυνθήσονται",710530,144],["ἐν",704639,0],["γήρει",703089,54],["πίονι",710491,97],["καὶ",707031,7],["εὐπαθοῦντες",705657,146],["ἔσονται",704093,135]],"Then shall they be increased in a fine old age; and they shall be prosperous; that they may declare"],["16",[["τοῦ",709436,20],["ἀναγγεῖλαι",700921,106],["ὅτι",709803,7],["εὐθὴς",705596,14],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀδικία",700271,12],["ἐν",704639,0],["αὐτῷ",702165,50]],"that the Lord my God is righteous, and there is no iniquity in him."]]