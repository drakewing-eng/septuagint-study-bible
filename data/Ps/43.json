[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["τοῖς",709436,147],["υἱοῖς",713075,148],["Κορε",707833,118],["εἰς",704105,0],["σύνεσιν",712460,9],["ψαλμός",714022,4]],"For the end, a Psalm for instruction, for the sons of Core."],["2",[["ὁ",709436,3],["θεός",706192,4],["ἐν",704639,0],["τοῖς",709436,95],["ὠσὶν",709852,96],["ἡμῶν",705999,145],["ἠκούσαμεν",700587,289],["οἱ",709436,136],["πατέρες",710189,52],["ἡμῶν",705999,145],["ἀνήγγειλαν",700921,150],["ἡμῖν",705994,90],["ἔργον",705396,25],["ὃ",709781,128],["εἰργάσω",705383,174],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["αὐτῶν",702165,40],["ἐν",704639,0],["ἡμέραις",705984,76],["ἀρχαίαις",701835,291]],"O God, we have heard with our ears, our fathers have told us, the work which thou wroughtest in their days, in the days of old."],["3",[["ἡ",709436,10],["χείρ",713787,12],["σου",711945,133],["ἔθνη",704068,42],["ἐξωλέθρευσεν",704956,2],["καὶ",707031,7],["κατεφύτευσας",707487,162],["αὐτούς",702165,62],["ἐκάκωσας",707073,162],["λαοὺς",708094,57],["καὶ",707031,7],["ἐξέβαλες",704145,162],["αὐτούς",702165,62]],"Thine hand utterly destroyed the heathen, and thou didst plant them: thou didst afflict the nations, and cast them out."],["4",[["οὐ",709805,28],["γὰρ",702963,11],["ἐν",704639,0],["τῇ",709436,100],["ῥομφαίᾳ",711291,1],["αὐτῶν",702165,40],["ἐκληρονόμησαν",707724,150],["γῆν",703083,9],["καὶ",707031,7],["ὁ",709436,3],["βραχίων",702808,4],["αὐτῶν",702165,40],["οὐκ",709805,28],["ἔσωσεν",712627,2],["αὐτούς",702165,62],["ἀλλ᾿",700680,7],["ἡ",709436,10],["δεξιά",703360,29],["σου",711945,133],["καὶ",707031,7],["ὁ",709436,3],["βραχίων",702808,4],["σου",711945,133],["καὶ",707031,7],["ὁ",709436,3],["φωτισμὸς",713647,4],["τοῦ",709436,20],["προσώπου",710986,21],["σου",711945,133],["ὅτι",709803,7],["εὐδόκησας",705565,162],["ἐν",704639,0],["αὐτοῖς",702165,151]],"For they inherited not the land by their [own] sword, and their [own] arm did not deliver them; but thy right hand, and thine arm, and the light of thy countenance, because thou wert well pleased in them."],["5",[["σὺ",712181,164],["εἶ",704093,154],["αὐτὸς",702165,121],["ὁ",709436,3],["βασιλεύς",702580,4],["μου",709032,133],["καὶ",707031,7],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["ὁ",709436,3],["ἐντελλόμενος",704791,122],["τὰς",709436,38],["σωτηρίας",712658,39],["Ιακωβ",706401,18]],"Thou art indeed my King and my God, who commandest deliverances for Jacob."],["6",[["ἐν",704639,0],["σοὶ",711925,159],["τοὺς",709436,58],["ἐχθροὺς",705779,57],["ἡμῶν",705999,145],["κερατιοῦμεν",707628,275],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["ἐξουθενώσομεν",704973,275],["τοὺς",709436,58],["ἐπανιστανομένους",705026,360],["ἡμῖν",705994,90]],"In thee will we push down our enemies, and in thy name will we bring to nought them that rise up against us."],["7",[["οὐ",709805,28],["γὰρ",702963,11],["ἐπὶ",705080,0],["τῷ",709436,53],["τόξῳ",712898,54],["μου",709032,133],["ἐλπιῶ",704529,165],["καὶ",707031,7],["ἡ",709436,10],["ῥομφαία",711291,12],["μου",709032,133],["οὐ",709805,28],["σώσει",712627,127],["με",708618,163]],"For I will not trust in my bow, and my sword shall not save me."],["8",[["ἔσωσας",712627,162],["γὰρ",702963,11],["ἡμᾶς",705981,194],["ἐκ",704132,0],["τῶν",709436,80],["θλιβόντων",706274,170],["ἡμᾶς",705981,194],["καὶ",707031,7],["τοὺς",709436,58],["μισοῦντας",708935,235],["ἡμᾶς",705981,194],["κατῄσχυνας",707257,162]],"For thou hast saved us from them that afflicted us, and hast put to shame them that hated us."],["9",[["ἐν",704639,0],["τῷ",709436,113],["θεῷ",706192,114],["ἐπαινεσθησόμεθα",705000,347],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["ἐξομολογησόμεθα",704960,141],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["διάψαλμα",703641,15]],"In God will we make our boast all the day, and to thy name will we give thanks for ever. Pause."],["10",[["νυνὶ",709385,28],["δὲ",703303,11],["ἀπώσω",701659,174],["καὶ",707031,7],["κατῄσχυνας",707257,162],["ἡμᾶς",705981,194],["καὶ",707031,7],["οὐκ",709805,28],["ἐξελεύσῃ",704909,123],["ἐν",704639,0],["ταῖς",709436,75],["δυνάμεσιν",703839,76],["ἡμῶν",705999,145]],"But now thou hast cast off, and put us to shame; and thou wilt not go forth with our hosts."],["11",[["ἀπέστρεψας",701598,162],["ἡμᾶς",705981,194],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,0],["παρὰ",709995,0],["τοὺς",709436,58],["ἐχθροὺς",705779,57],["ἡμῶν",705999,145],["καὶ",707031,7],["οἱ",709436,136],["μισοῦντες",708935,146],["ἡμᾶς",705981,194],["διήρπαζον",703562,137],["ἑαυτοῖς",703917,151]],"Thou hast turned us back before our enemies; and they that hated us spoiled for themselves."],["12",[["ἔδωκας",703654,162],["ἡμᾶς",705981,194],["ὡς",714148,7],["πρόβατα",710768,42],["βρώσεως",702825,17],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["διέσπειρας",703584,162],["ἡμᾶς",705981,194]],"Thou madest us as sheep for meat; and thou scatteredst us among the nations."],["13",[["ἀπέδου",701446,497],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133],["ἄνευ",701137,0],["τιμῆς",712856,17],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["πλῆθος",710529,15],["ἐν",704639,0],["τοῖς",709436,95],["ἀλλάγμασιν",700682,96],["αὐτῶν",702165,40]],"Thou hast sold thy people without price, and there was no profit by their exchange."],["14",[["ἔθου",712849,174],["ἡμᾶς",705981,194],["ὄνειδος",709658,25],["τοῖς",709436,147],["γείτοσιν",703016,148],["ἡμῶν",705999,145],["μυκτηρισμὸν",709053,6],["καὶ",707031,7],["καταγέλωτα",707223,6],["τοῖς",709436,147],["κύκλῳ",707959,114],["ἡμῶν",705999,145]],"Thou hast made us a reproach to our neighbours, a scorn and derision to them that are round about us."],["15",[["ἔθου",712849,174],["ἡμᾶς",705981,194],["εἰς",704105,0],["παραβολὴν",710003,9],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["κίνησιν",707681,9],["κεφαλῆς",707639,17],["ἐν",704639,0],["τοῖς",709436,147],["λαοῖς",708094,148]],"Thou hast made us a proverb among the Gentiles, a shaking of the head among the nations."],["16",[["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["ἡ",709436,10],["ἐντροπή",704809,12],["μου",709032,133],["κατεναντίον",707508,0],["μού",709032,133],["ἐστιν",704093,91],["καὶ",707031,7],["ἡ",709436,10],["αἰσχύνη",700483,12],["τοῦ",709436,20],["προσώπου",710986,21],["μου",709032,133],["ἐκάλυψέν",707102,2],["με",708618,163]],"All the day my shame is before me, and the confusion of my face has covered me,"],["17",[["ἀπὸ",701425,0],["φωνῆς",713640,17],["ὀνειδίζοντος",709655,152],["καὶ",707031,7],["παραλαλοῦντος",710058,152],["ἀπὸ",701425,0],["προσώπου",710986,21],["ἐχθροῦ",705779,18],["καὶ",707031,7],["ἐκδιώκοντος",704178,152]],"because of the voice of the slanderer and reviler; because of the enemy and avenger."],["18",[["ταῦτα",709858,290],["πάντα",710177,195],["ἦλθεν",705453,2],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["καὶ",707031,7],["οὐκ",709805,28],["ἐπελαθόμεθά",705187,316],["σου",711945,133],["καὶ",707031,7],["οὐκ",709805,28],["ἠδικήσαμεν",700269,289],["ἐν",704639,0],["διαθήκῃ",703456,1],["σου",711945,133]],"All these things are come upon us: but we have not forgotten thee, neither have we dealt unrighteously in thy covenant."],["19",[["καὶ",707031,7],["οὐκ",709805,28],["ἀπέστη",702214,2],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,0],["ἡ",709436,10],["καρδία",707141,12],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐξέκλινας",704220,162],["τὰς",709436,38],["τρίβους",712939,39],["ἡμῶν",705999,145],["ἀπὸ",701425,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["σου",711945,133]],"And our heart has not gone back; but thou hast turned aside our paths from thy way."],["20",[["ὅτι",709803,7],["ἐταπείνωσας",712717,162],["ἡμᾶς",705981,194],["ἐν",704639,0],["τόπῳ",712903,114],["κακώσεως",707075,17],["καὶ",707031,7],["ἐπεκάλυψεν",705155,2],["ἡμᾶς",705981,194],["σκιὰ",711852,12],["θανάτου",706096,18]],"For thou hast laid us low in a place of affliction, and the shadow of death has covered us."],["21",[["εἰ",704071,7],["ἐπελαθόμεθα",705187,316],["τοῦ",709436,20],["ὀνόματος",709666,21],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["καὶ",707031,7],["εἰ",704071,7],["διεπετάσαμεν",703545,289],["χεῖρας",713787,39],["ἡμῶν",705999,145],["πρὸς",710844,0],["θεὸν",706192,6],["ἀλλότριον",700699,27]],"If we have forgotten the name of our God, and if we have spread out our hands to a strange god; shall not God search these things out?"],["22",[["οὐχὶ",709862,28],["ὁ",709436,3],["θεὸς",706192,4],["ἐκζητήσει",704187,127],["ταῦτα",709858,71],["αὐτὸς",702165,121],["γὰρ",702963,11],["γινώσκει",703105,91],["τὰ",709436,41],["κρύφια",707930,68],["τῆς",709436,16],["καρδίας",707141,17]],"for he knows the secrets of the heart."],["23",[["ὅτι",709803,7],["ἕνεκα",704709,0],["σοῦ",711945,133],["θανατούμεθα",706097,378],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["ἐλογίσθημεν",708232,485],["ὡς",714148,7],["πρόβατα",710768,64],["σφαγῆς",712568,17]],"For, for thy sake we are killed all the day long; we are counted as sheep for slaughter."],["24",[["ἐξεγέρθητι",704889,244],["ἵνα",706747,7],["τί",712867,126],["ὑπνοῖς",713182,154],["κύριε",707996,153],["ἀνάστηθι",701173,176],["καὶ",707031,7],["μὴ",708851,28],["ἀπώσῃ",701659,172],["εἰς",704105,0],["τέλος",712787,25]],"Awake, wherefore sleepest thou, O Lord? arise, and do not cast [us] off for ever."],["25",[["ἵνα",706747,7],["τί",712867,126],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["ἀποστρέφεις",701598,154],["ἐπιλανθάνῃ",705187,259],["τῆς",709436,16],["πτωχείας",711073,17],["ἡμῶν",705999,145],["καὶ",707031,7],["τῆς",709436,16],["θλίψεως",706276,17],["ἡμῶν",705999,145]],"Wherefore turnest thou thy face away, [and] forgettest our poverty and our affliction?"],["26",[["ὅτι",709803,7],["ἐταπεινώθη",712717,37],["εἰς",704105,0],["χοῦν",713930,6],["ἡ",709436,10],["ψυχὴ",714070,12],["ἡμῶν",705999,145],["ἐκολλήθη",707791,37],["εἰς",704105,0],["γῆν",703083,9],["ἡ",709436,10],["γαστὴρ",702976,12],["ἡμῶν",705999,145]],"For our soul has been brought down to the dust; our belly has cleaved to the earth."],["27",[["ἀνάστα",701173,176],["κύριε",707996,153],["βοήθησον",702746,176],["ἡμῖν",705994,90],["καὶ",707031,7],["λύτρωσαι",708282,300],["ἡμᾶς",705981,194],["ἕνεκεν",704709,0],["τοῦ",709436,20],["ὀνόματός",709666,21],["σου",711945,133]],"Arise, O Lord, help us, and redeem us for thy name's sake."]]