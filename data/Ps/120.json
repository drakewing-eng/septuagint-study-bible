[["1",[["ᾠδὴ",714091,12],["τῶν",709436,80],["ἀναβαθμῶν",700904,81],["ἦρα",700473,155],["τοὺς",709436,58],["ὀφθαλμούς",709870,57],["μου",709032,133],["εἰς",704105,0],["τὰ",709436,41],["ὄρη",709768,42],["πόθεν",710580,28],["ἥξει",705956,127],["ἡ",709436,10],["βοήθειά",702745,12],["μου",709032,133]],"A Song of Degrees. I lifted up mine eyes to the mountains, whence my help shall come."],["2",[["ἡ",709436,10],["βοήθειά",702745,12],["μου",709032,133],["παρὰ",709995,0],["κυρίου",707996,18],["τοῦ",709436,35],["ποιήσαντος",710582,500],["τὸν",709436,5],["οὐρανὸν",709844,6],["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9]],"My help [shall come] from the Lord, who made the heaven and the earth."],["3",[["μὴ",708851,28],["δῷς",703654,175],["εἰς",704105,0],["σάλον",711420,6],["τὸν",709436,5],["πόδα",710707,6],["σου",711945,133],["μηδὲ",708855,7],["νυστάξῃ",709390,172],["ὁ",709436,3],["φυλάσσων",713619,72],["σε",711598,163]],"Let not thy foot be moved; and let not thy keeper slumber."],["4",[["ἰδοὺ",706497,88],["οὐ",709805,28],["νυστάξει",709390,127],["οὐδὲ",709816,7],["ὑπνώσει",713182,127],["ὁ",709436,3],["φυλάσσων",713619,72],["τὸν",709436,5],["Ισραηλ",706839,6]],"Behold, he that keeps Israel shall not slumber nor sleep."],["5",[["κύριος",707996,4],["φυλάξει",713619,127],["σε",711598,163],["κύριος",707996,4],["σκέπη",711839,12],["σου",711945,133],["ἐπὶ",705080,0],["χεῖρα",713787,9],["δεξιάν",703360,36],["σου",711945,133]],"The Lord shall keep thee: the Lord is thy shelter upon thy right hand."],["6",[["ἡμέρας",705984,17],["ὁ",709436,3],["ἥλιος",705974,4],["οὐ",709805,28],["συγκαύσει",712198,127],["σε",711598,163],["οὐδὲ",709816,7],["ἡ",709436,10],["σελήνη",711650,12],["τὴν",709436,8],["νύκτα",709386,9]],"The sun shall not burn thee by day, neither the moon by night."],["7",[["κύριος",707996,4],["φυλάξει",713619,127],["σε",711598,163],["ἀπὸ",701425,0],["παντὸς",710177,116],["κακοῦ",707066,116],["φυλάξει",713619,127],["τὴν",709436,8],["ψυχήν",714070,9],["σου",711945,133]],"May the Lord preserve thee from all evil: the Lord shall keep thy soul."],["8",[["κύριος",707996,4],["φυλάξει",713619,127],["τὴν",709436,8],["εἴσοδόν",704119,9],["σου",711945,133],["καὶ",707031,7],["τὴν",709436,8],["ἔξοδόν",704948,9],["σου",711945,133],["ἀπὸ",701425,0],["τοῦ",709436,35],["νῦν",709384,28],["καὶ",707031,7],["ἕως",705792,0],["τοῦ",709436,35],["αἰῶνος",700504,18]],"The Lord shall keep thy coming in, and thy going out, from henceforth and even for ever."]]