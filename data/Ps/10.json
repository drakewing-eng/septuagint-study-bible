[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114],["ἐπὶ",705080,0],["τῷ",709436,113],["κυρίῳ",707996,114],["πέποιθα",710221,89],["πᾶς",710177,14],["ἐρεῖτε",705415,337],["τῇ",709436,100],["ψυχῇ",714070,1],["μου",709032,133],["μεταναστεύου",708807,253],["ἐπὶ",705080,0],["τὰ",709436,41],["ὄρη",709768,42],["ὡς",714148,7],["στρουθίον",712166,15]],"For the end, a Psalm of David. In the Lord I have put my trust: how will ye say to my soul, Flee to the mountains as a sparrow?"],["2",[["ὅτι",709803,7],["ἰδοὺ",706497,88],["οἱ",709436,136],["ἁμαρτωλοὶ",700776,138],["ἐνέτειναν",704790,150],["τόξον",712898,25],["ἡτοίμασαν",705539,150],["βέλη",702644,42],["εἰς",704105,0],["φαρέτραν",713364,9],["τοῦ",709436,20],["κατατοξεῦσαι",707462,106],["ἐν",704639,0],["σκοτομήνῃ",711888,1],["τοὺς",709436,58],["εὐθεῖς",705602,60],["τῇ",709436,100],["καρδίᾳ",707141,1]],"For behold the sinners have bent [their] bow, they have prepared their arrows for the quiver, to shoot privily at the upright in heart."],["3",[["ὅτι",709803,7],["ἃ",709781,69],["κατηρτίσω",707410,174],["καθεῖλον",706982,150],["ὁ",709436,3],["δὲ",703303,11],["δίκαιος",703694,14],["τί",712867,126],["ἐποίησεν",710582,2]],"For they have pulled down what thou didst frame, but what has the righteous done?"],["4",[["κύριος",707996,4],["ἐν",704639,0],["ναῷ",709191,114],["ἁγίῳ",700159,30],["αὐτοῦ",702165,102],["κύριος",707996,4],["ἐν",704639,0],["οὐρανῷ",709844,114],["ὁ",709436,3],["θρόνος",706315,4],["αὐτοῦ",702165,102],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὸν",709436,5],["πένητα",710248,6],["ἀποβλέπουσιν",701430,197],["τὰ",709436,63],["βλέφαρα",702741,64],["αὐτοῦ",702165,102],["ἐξετάζει",704911,91],["τοὺς",709436,58],["υἱοὺς",713075,57],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"The Lord is in his holy temple, as for the Lord, his throne is in heaven: his eyes look upon the poor, his eyelids try the sons of men."],["5",[["κύριος",707996,4],["ἐξετάζει",704911,91],["τὸν",709436,5],["δίκαιον",703694,27],["καὶ",707031,7],["τὸν",709436,5],["ἀσεβῆ",701909,60],["ὁ",709436,3],["δὲ",703303,11],["ἀγαπῶν",700120,72],["ἀδικίαν",700271,9],["μισεῖ",708935,91],["τὴν",709436,8],["ἑαυτοῦ",703917,102],["ψυχήν",714070,9]],"The Lord tries the righteous and the ungodly: and he that loves unrighteousness hates his own soul."],["6",[["ἐπιβρέξει",705097,127],["ἐπὶ",705080,0],["ἁμαρτωλοὺς",700776,60],["παγίδας",709910,39],["πῦρ",711088,25],["καὶ",707031,7],["θεῖον",706154,27],["καὶ",707031,7],["πνεῦμα",710566,25],["καταιγίδος",707254,17],["ἡ",709436,10],["μερὶς",708748,12],["τοῦ",709436,20],["ποτηρίου",710699,21],["αὐτῶν",702165,40]],"He shall rain upon sinners snares, fire, and brimstone, and a stormy blast [shall be] the portion of their cup."],["7",[["ὅτι",709803,7],["δίκαιος",703694,14],["κύριος",707996,4],["καὶ",707031,7],["δικαιοσύνας",703695,39],["ἠγάπησεν",700120,2],["εὐθύτητα",705603,9],["εἶδεν",709725,2],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102]],"For the Lord [is] righteous, and loves righteousness; his face beholds uprightness."]]