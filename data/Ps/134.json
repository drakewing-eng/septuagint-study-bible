[["1",[["αλληλουια",700688,88],["αἰνεῖτε",700459,335],["τὸ",709436,24],["ὄνομα",709666,25],["κυρίου",707996,18],["αἰνεῖτε",700459,335],["δοῦλοι",703817,52],["κύριον",707996,6]],"Alleluia. Praise ye the name of the Lord; praise the Lord, [ye his] servants,"],["2",[["οἱ",709436,136],["ἑστῶτες",706846,268],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18],["ἐν",704639,0],["αὐλαῖς",702137,76],["οἴκου",709516,18],["θεοῦ",706192,18],["ἡμῶν",705999,145]],"who stand in the house of the Lord, in the courts of the house of our God."],["3",[["αἰνεῖτε",700459,335],["τὸν",709436,5],["κύριον",707996,6],["ὅτι",709803,7],["ἀγαθὸς",700106,14],["κύριος",707996,4],["ψάλατε",714021,74],["τῷ",709436,53],["ὀνόματι",709666,54],["αὐτοῦ",702165,559],["ὅτι",709803,7],["καλόν",707097,27]],"Praise ye the Lord; for the Lord is good: sing praises to his name; for [it is] good."],["4",[["ὅτι",709803,7],["τὸν",709436,5],["Ιακωβ",706401,6],["ἐξελέξατο",704236,23],["ἑαυτῷ",703917,50],["ὁ",709436,3],["κύριος",707996,4],["Ισραηλ",706839,18],["εἰς",704105,0],["περιουσιασμὸν",710357,6],["αὐτοῦ",702165,559]],"For the Lord has chosen Jacob for himself, [and] Israel for his peculiar treasure."],["5",[["ὅτι",709803,7],["ἐγὼ",704018,164],["ἔγνων",703105,155],["ὅτι",709803,7],["μέγας",708653,14],["κύριος",707996,4],["καὶ",707031,7],["ὁ",709436,3],["κύριος",707996,4],["ἡμῶν",705999,145],["παρὰ",709995,0],["πάντας",710177,60],["τοὺς",709436,58],["θεούς",706192,57]],"For I know that the Lord is great, and our Lord is above all gods;"],["6",[["πάντα",710177,27],["ὅσα",709788,68],["ἠθέλησεν",706176,2],["ὁ",709436,3],["κύριος",707996,4],["ἐποίησεν",710582,2],["ἐν",704639,0],["τῷ",709436,113],["οὐρανῷ",709844,114],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ἐν",704639,0],["ταῖς",709436,75],["θαλάσσαις",706069,76],["καὶ",707031,7],["ἐν",704639,0],["πάσαις",710177,291],["ταῖς",709436,75],["ἀβύσσοις",700098,76]],"all that the Lord willed, he did in heaven, and on the earth, in the sea, and in all deeps."],["7",[["ἀνάγων",700933,72],["νεφέλας",709277,39],["ἐξ",704132,0],["ἐσχάτου",705519,116],["τῆς",709436,16],["γῆς",703083,17],["ἀστραπὰς",702021,39],["εἰς",704105,0],["ὑετὸν",713074,6],["ἐποίησεν",710582,2],["ὁ",709436,3],["ἐξάγων",704834,72],["ἀνέμους",701123,57],["ἐκ",704132,0],["θησαυρῶν",706258,81],["αὐτοῦ",702165,559]],"Who brings up clouds from the extremity of the earth: he has made lightnings for the rain: he brings winds out of his treasures."],["8",[["ὃς",709781,213],["ἐπάταξεν",710185,2],["τὰ",709436,41],["πρωτότοκα",711046,68],["Αἰγύπτου",700401,17],["ἀπὸ",701425,0],["ἀνθρώπου",701163,18],["ἕως",705792,0],["κτήνους",707934,21]],"Who smote the first-born of Egypt, both of man and beast."],["9",[["ἐξαπέστειλεν",704872,2],["σημεῖα",711748,42],["καὶ",707031,7],["τέρατα",712793,25],["ἐν",704639,0],["μέσῳ",708768,30],["σου",711945,133],["Αἴγυπτε",700401,258],["ἐν",704639,0],["Φαραω",713360,114],["καὶ",707031,7],["ἐν",704639,0],["πᾶσι",710177,230],["τοῖς",709436,147],["δούλοις",703817,148],["αὐτοῦ",702165,559]],"He sent signs and wonders into the midst of thee, O Egypt, on Pharao, and on all his servants."],["10",[["ὃς",709781,213],["ἐπάταξεν",710185,2],["ἔθνη",704068,42],["πολλὰ",710646,68],["καὶ",707031,7],["ἀπέκτεινεν",701498,2],["βασιλεῖς",702580,57],["κραταιούς",707873,60]],"Who smote many nations, and slew mighty kings;"],["11",[["τὸν",709436,5],["Σηων",711759,6],["βασιλέα",702580,6],["τῶν",709436,80],["Αμορραίων",700865,81],["καὶ",707031,7],["τὸν",709436,5],["Ωγ",714088,6],["βασιλέα",702580,6],["τῆς",709436,16],["Βασαν",702564,17],["καὶ",707031,7],["πάσας",710177,119],["τὰς",709436,38],["βασιλείας",702577,39],["Χανααν",713708,17]],"Seon king of the Amorites, and Og king of Basan, and all the kingdoms of Chanaan:"],["12",[["καὶ",707031,7],["ἔδωκεν",703654,2],["τὴν",709436,8],["γῆν",703083,9],["αὐτῶν",702165,565],["κληρονομίαν",707725,9],["κληρονομίαν",707725,9],["Ισραηλ",706839,18],["λαῷ",708094,114],["αὐτοῦ",702165,559]],"and gave their land [for] an inheritance, an inheritance to Israel his people."],["13",[["κύριε",707996,153],["τὸ",709436,34],["ὄνομά",709666,15],["σου",711945,133],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["κύριε",707996,153],["τὸ",709436,34],["μνημόσυνόν",708966,15],["σου",711945,133],["εἰς",704105,0],["γενεὰν",703037,9],["καὶ",707031,7],["γενεάν",703037,9]],"O Lord, thy name [endures] for ever, and thy memorial to all generations."],["14",[["ὅτι",709803,7],["κρινεῖ",707905,127],["κύριος",707996,4],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,559],["καὶ",707031,7],["ἐπὶ",705080,0],["τοῖς",709436,147],["δούλοις",703817,148],["αὐτοῦ",702165,559],["παρακληθήσεται",710039,134]],"For the Lord shall judge his people, and comfort himself concerning his servants."],["15",[["τὰ",709436,41],["εἴδωλα",704079,42],["τῶν",709436,43],["ἐθνῶν",704068,44],["ἀργύριον",701707,25],["καὶ",707031,7],["χρυσίον",713972,25],["ἔργα",705396,42],["χειρῶν",713787,65],["ἀνθρώπων",701163,81]],"The idols of the heathen are silver and gold, the works of men's hands."],["16",[["στόμα",712125,25],["ἔχουσιν",705785,197],["καὶ",707031,7],["οὐ",709805,28],["λαλήσουσιν",708071,218],["ὀφθαλμοὺς",709870,57],["ἔχουσιν",705785,197],["καὶ",707031,7],["οὐκ",709805,28],["ὄψονται",709725,135]],"They have a mouth, but they cannot speak; they have eyes, but they cannot see;"],["17",[["ὦτα",709852,25],["ἔχουσιν",705785,197],["καὶ",707031,7],["οὐκ",709805,28],["ἐνωτισθήσονται",704825,144],["ῥῖνας",711268,39],["ἔχουσιν",705785,197],["καὶ",707031,7],["οὐκ",709805,28],["ὀσφρανθήσονται",709798,144],["χεῖρας",713787,39],["ἔχουσιν",705785,197],["καὶ",707031,7],["οὐ",709805,28],["ψηλαφήσουσιν",714047,218],["πόδας",710707,57],["ἔχουσιν",705785,197],["καὶ",707031,7],["οὐ",709805,28],["περιπατήσουσιν",710362,218],["οὐ",709805,28],["φωνήσουσιν",713639,218],["ἐν",704639,0],["τῷ",709436,113],["λάρυγγι",708098,114],["αὐτῶν",702165,565],["οὐδὲ",709816,7],["γάρ",702963,11],["ἐστιν",704093,91],["πνεῦμα",710566,25],["ἐν",704639,0],["τῷ",709436,53],["στόματι",712125,54],["αὐτῶν",702165,565]],"they have ears, but they cannot hear; for there is no breath in their mouth.",{"s":"d","q":0.35}],["18",[["ὅμοιοι",709626,138],["αὐτοῖς",702165,623],["γένοιντο",703104,529],["οἱ",709436,136],["ποιοῦντες",710582,146],["αὐτὰ",702165,620],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["πεποιθότες",710221,268],["ἐπ᾿",705080,0],["αὐτοῖς",702165,623]],"Let those who make them be made like to them; and all those who trust in them."],["19",[["οἶκος",709516,4],["Ισραηλ",706839,18],["εὐλογήσατε",705631,74],["τὸν",709436,5],["κύριον",707996,6],["οἶκος",709516,4],["Ααρων",700005,18],["εὐλογήσατε",705631,74],["τὸν",709436,5],["κύριον",707996,6]],"O house of Israel, bless ye the Lord: O house of Aaron, bless ye the Lord:"],["20",[["οἶκος",709516,4],["Λευι",708158,18],["εὐλογήσατε",705631,74],["τὸν",709436,5],["κύριον",707996,6],["οἱ",709436,136],["φοβούμενοι",713532,348],["τὸν",709436,5],["κύριον",707996,6],["εὐλογήσατε",705631,74],["τὸν",709436,5],["κύριον",707996,6]],"O house of Levi, bless ye the Lord: ye that fear the Lord, bless the Lord."],["21",[["εὐλογητὸς",705632,14],["κύριος",707996,4],["ἐκ",704132,0],["Σιων",711816,17],["ὁ",709436,3],["κατοικῶν",707540,81],["Ιερουσαλημ",706644,17]],"Blessed in Sion be the Lord, who dwells in Jerusalem."]]