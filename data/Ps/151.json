[["1",[["οὗτος",709858,121],["ὁ",709436,3],["ψαλμὸς",714022,4],["ἰδιόγραφος",706491,14],["εἰς",704105,0],["Δαυιδ",703232,6],["καὶ",707031,7],["ἔξωθεν",704984,28],["τοῦ",709436,35],["ἀριθμοῦ",701744,18],["ὅτε",709802,28],["ἐμονομάχησεν",709000,2],["τῷ",709436,113],["Γολιαδ",703160,114],["μικρὸς",708915,14],["ἤμην",704093,334],["ἐν",704639,0],["τοῖς",709436,147],["ἀδελφοῖς",700249,148],["μου",709032,133],["καὶ",707031,7],["νεώτερος",709256,224],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133],["ἐποίμαινον",710594,137,421],["τὰ",709436,41],["πρόβατα",710768,42],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133]],"This Psalm is a genuine one of David, though supernumerary, [composed] when he fought in single combat with Goliad. I was small among my brethren, and youngest in my father's house: I tended my father's sheep."],["2",[["αἱ",709436,190],["χεῖρές",713787,191],["μου",709032,133],["ἐποίησαν",710582,150],["ὄργανον",709727,25],["οἱ",709436,136],["δάκτυλοί",703259,52],["μου",709032,133],["ἥρμοσαν",701775,150],["ψαλτήριον",714023,25]],"My hands formed a musical instrument, and my fingers tuned a psaltery."],["3",[["καὶ",707031,7],["τίς",712867,158],["ἀναγγελεῖ",700921,127],["τῷ",709436,113],["κυρίῳ",707996,114],["μου",709032,133],["αὐτὸς",702165,561],["κύριος",707996,4],["αὐτὸς",702165,561],["εἰσακούει",704108,91]],"And who shall tell my Lord? the Lord himself, he himself hears."],["4",[["αὐτὸς",702165,561],["ἐξαπέστειλεν",704872,2],["τὸν",709436,5],["ἄγγελον",700140,6],["αὐτοῦ",702165,559],["καὶ",707031,7],["ἦρέν",700473,2],["με",708618,163],["ἐκ",704132,0],["τῶν",709436,43],["προβάτων",710768,44],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133],["καὶ",707031,7],["ἔχρισέν",713965,2],["με",708618,163],["ἐν",704639,0],["τῷ",709436,53],["ἐλαίῳ",704380,54],["τῆς",709436,16],["χρίσεως",713962,17],["αὐτοῦ",702165,559]],"He sent forth his angel, and took me from my father's sheep, and he anointed me with the oil of his anointing."],["5",[["οἱ",709436,136],["ἀδελφοί",700249,52],["μου",709032,133],["καλοὶ",707097,138],["καὶ",707031,7],["μεγάλοι",708653,138],["καὶ",707031,7],["οὐκ",709805,28],["εὐδόκησεν",705565,2],["ἐν",704639,0],["αὐτοῖς",702165,623],["κύριος",707996,4]],"My brothers were handsome and tall; but the Lord did not take pleasure in them."],["6",[["ἐξῆλθον",704909,150],["εἰς",704105,0],["συνάντησιν",712397,9],["τῷ",709436,113],["ἀλλοφύλῳ",700706,30],["καὶ",707031,7],["ἐπικατηράσατό",705158,23],["με",708618,163],["ἐν",704639,0],["τοῖς",709436,95],["εἰδώλοις",704079,96],["αὐτοῦ",702165,559]],"I went forth to meet the Philistine; and he cursed me by his idols."],["7",[["ἐγὼ",704018,164],["δὲ",703303,11],["σπασάμενος",712003,248],["τὴν",709436,8],["παρ᾿",709995,0],["αὐτοῦ",702165,559],["μάχαιραν",708593,9],["ἀπεκεφάλισα",701480,155],["αὐτὸν",702165,556],["καὶ",707031,7],["ἦρα",700473,155],["ὄνειδος",709658,25],["ἐξ",704132,0],["υἱῶν",713075,81],["Ισραηλ",706839,18]],"But I drew his own sword, and beheaded him, and removed reproach from the children of Israel."]]