[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114]],null,{"s":"h"}],["2",[["εἰσάκουσον",704108,176],["ὁ",709436,3],["θεός",706192,4],["τῆς",709436,16],["φωνῆς",713640,17],["μου",709032,133],["ἐν",704639,0],["τῷ",709436,53],["δέεσθαί",703394,110],["με",708618,163],["ἀπὸ",701425,0],["φόβου",713534,18],["ἐχθροῦ",705779,18],["ἐξελοῦ",704838,300],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133]],"Hear my prayer, O God, when I make my petition to thee; deliver my soul from fear of the enemy."],["3",[["ἐσκέπασάς",711832,162],["με",708618,163],["ἀπὸ",701425,0],["συστροφῆς",712563,17],["πονηρευομένων",710657,299],["ἀπὸ",701425,0],["πλήθους",710529,21],["ἐργαζομένων",705383,299],["τὴν",709436,8],["ἀνομίαν",701192,9]],"Thou hast sheltered me from the conspiracy of them that do wickedly; from the multitude of them that work iniquity;"],["4",[["οἵτινες",709793,450],["ἠκόνησαν",700570,150],["ὡς",714148,7],["ῥομφαίαν",711291,9],["τὰς",709436,38],["γλώσσας",703120,39],["αὐτῶν",702165,40],["ἐνέτειναν",704790,150],["τόξον",712898,25],["αὐτῶν",702165,40],["πρᾶγμα",710708,25],["πικρὸν",710475,27]],"who have sharpened their tongues as a sword; they have bent their bow maliciously;"],["5",[["τοῦ",709436,20],["κατατοξεῦσαι",707462,106],["ἐν",704639,0],["ἀποκρύφοις",701497,230],["ἄμωμον",700895,27],["ἐξάπινα",704868,28],["κατατοξεύσουσιν",707462,218],["αὐτὸν",702165,85],["καὶ",707031,7],["οὐ",709805,28],["φοβηθήσονται",713532,144]],"to shoot in secret at the blameless; they will shoot him suddenly, and will not fear."],["6",[["ἐκραταίωσαν",707875,150],["ἑαυτοῖς",703917,151],["λόγον",708236,6],["πονηρόν",710660,27],["διηγήσαντο",703679,189],["τοῦ",709436,20],["κρύψαι",707923,106],["παγίδας",709910,39],["εἶπαν",705373,150],["τίς",712867,158],["ὄψεται",709725,93],["αὐτούς",702165,62]],"They have set up for themselves an evil matter, they have given counsel to hide snares; they have said, Who shall see them?"],["7",[["ἐ