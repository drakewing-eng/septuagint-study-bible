[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["τοῖς",709436,147],["ἀλλοιωθησομένοις",700694,729],["ἔτι",705538,28],["εἰς",704105,0],["στηλογραφίαν",712093,9],["τῷ",709436,113],["Δαυιδ",703232,114],["εἰς",704105,0],["διδαχήν",703650,9]],"For the end, for them that shall yet be changed; for an inscription by David for instruction,"],["2",[["ὁπότε",709709,28],["ἐνεπύρισεν",704622,2],["τὴν",709436,8],["Μεσοποταμίαν",708767,9],["Συρίας",712533,17],["καὶ",707031,7],["τὴν",709436,8],["Συρίαν",712533,9],["Σωβα",712618,9],["καὶ",707031,7],["ἐπέστρεψεν",705278,2],["Ιωαβ",706877,4],["καὶ",707031,7],["ἐπάταξεν",710185,2],["τὴν",709436,8],["φάραγγα",713351,9],["τῶν",709436,80],["ἁλῶν",700728,81],["δώδεκα",703887,59],["χιλιάδας",713858,39]],"when he [had] burned Mesopotamia of Syria, and Syria Sobal, and Joab [had] returned and smitten [in] the valley of salt twelve thousand."],["3",[["ὁ",709436,3],["θεός",706192,4],["ἀπώσω",701659,174],["ἡμᾶς",705981,194],["καὶ",707031,7],["καθεῖλες",706982,162],["ἡμᾶς",705981,194],["ὠργίσθης",709729,168],["καὶ",707031,7],["οἰκτίρησας",709518,162],["ἡμᾶς",705981,194]],"O God, thou hast rejected and destroyed us; thou hast been angry, yet hast pitied us."],["4",[["συνέσεισας",712554,162],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["συνετάραξας",712507,162],["αὐτήν",702165,104],["ἴασαι",706424,300],["τὰ",709436,41],["συντρίμματα",712521,42],["αὐτῆς",702165,86],["ὅτι",709803,7],["ἐσαλεύθη",711403,37]],"Thou hast shaken the earth, and troubled it; heal its breaches, for it has been shaken."],["5",[["ἔδειξας",703314,162],["τῷ",709436,113],["λαῷ",708094,114],["σου",711945,133],["σκληρά",711861,68],["ἐπότισας",710700,162],["ἡμᾶς",705981,194],["οἶνον",709530,6],["κατανύξεως",707346,17]],"Thou hast shewn thy people hard things: thou hast made us drink the wine of astonishment."],["6",[["ἔδωκας",703654,162],["τοῖς",709436,147],["φοβουμένοις",713532,341],["σε",711598,163],["σημείωσιν",711750,9],["τοῦ",709436,20],["φυγεῖν",713433,106],["ἀπὸ",701425,0],["προσώπου",710986,21],["τόξου",712898,21],["διάψαλμα",703641,15]],"Thou hast given a token to them that fear thee, that they might flee from the bow. Pause."],["7",[["ὅπως",709719,7],["ἂν",700900,11],["ῥυσθῶσιν",711309,272],["οἱ",709436,136],["ἀγαπητοί",700124,138],["σου",711945,133],["σῶσον",712627,176],["τῇ",709436,100],["δεξιᾷ",703360,101],["σου",711945,133],["καὶ",707031,7],["ἐπάκουσόν",705009,176],["μου",709032,133]],"That thy beloved ones may be delivered; save with thy right hand, and hear me."],["8",[["ὁ",709436,3],["θεὸς",706192,4],["ἐλάλησεν",708071,2],["ἐν",704639,0],["τῷ",709436,113],["ἁγίῳ",700159,30],["αὐτοῦ",702165,102],["ἀγαλλιάσομαι",700114,181],["καὶ",707031,7],["διαμεριῶ",703518,165],["Σικιμα",711783,227],["καὶ",707031,7],["τὴν",709436,8],["κοιλάδα",707758,9],["τῶν",709436,130],["σκηνῶν",711845,65],["διαμετρήσω",703520,165]],"God has spoken in his holiness; I will rejoice, and divide Sicima, and measure out the valley of tents."],["9",[["ἐμός",704578,14],["ἐστιν",704093,91],["Γαλααδ",702920,12],["καὶ",707031,7],["ἐμός",704578,14],["ἐστιν",704093,91],["Μανασση",708470,4],["καὶ",707031,7],["Εφραιμ",705769,4],["κραταίωσις",707878,12],["τῆς",709436,16],["κεφαλῆς",707639,17],["μου",709032,133],["Ιουδας",706775,4],["βασιλεύς",702580,4],["μου",709032,133]],"Galaad is mine, and Manasse is mine; and Ephraim is the strength of my head;"],["10",[["Μωαβ",709085,120],["λέβης",708121,4],["τῆς",709436,16],["ἐλπίδος",704530,17],["μου",709032,133],["ἐπὶ",705080,0],["τὴν",709436,8],["Ιδουμαίαν",706503,9],["ἐκτενῶ",704322,165],["τὸ",709436,24],["ὑπόδημά",713195,25],["μου",709032,133],["ἐμοὶ",704577,159],["ἀλλόφυλοι",700706,138],["ὑπετάγησαν",713250,150]],"Judas is my king; Moab is the caldron of my hope; over Idumea will I stretch out my shoe; the Philistines have been subjected to me."],["11",[["τίς",712867,158],["ἀπάξει",701324,127],["με",708618,163],["εἰς",704105,0],["πόλιν",710612,9],["περιοχῆς",710360,17],["τίς",712867,158],["ὁδηγήσει",709448,127],["με",708618,163],["ἕως",705792,0],["τῆς",709436,16],["Ιδουμαίας",706503,17]],"Who will lead me into the fortified city? who will guide me as far as Idumea?"],["12",[["οὐχὶ",709862,28],["σύ",712181,164],["ὁ",709436,3],["θεός",706192,4],["ὁ",709436,3],["ἀπωσάμενος",701659,248],["ἡμᾶς",705981,194],["καὶ",707031,7],["οὐκ",709805,28],["ἐξελεύσῃ",704909,123],["ὁ",709436,3],["θεός",706192,4],["ἐν",704639,0],["ταῖς",709436,75],["δυνάμεσιν",703839,76],["ἡμῶν",705999,145]],"Wilt not thou, O God, who hast cast us off? and wilt not thou, O God, go forth with our forces?"],["13",[["δὸς",703654,176],["ἡμῖν",705994,90],["βοήθειαν",702745,9],["ἐκ",704132,0],["θλίψεως",706276,17],["καὶ",707031,7],["ματαία",708575,29],["σωτηρία",712658,12],["ἀνθρώπου",701163,18]],"Give us help from trouble: for vain is the deliverance of man."],["14",[["ἐν",704639,0],["δὲ",703303,11],["τῷ",709436,113],["θεῷ",706192,114],["ποιήσομεν",710582,275],["δύναμιν",703839,9],["καὶ",707031,7],["αὐτὸς",702165,121],["ἐξουδενώσει",704969,127],["τοὺς",709436,58],["θλίβοντας",706274,235],["ἡμᾶς",705981,194]],"In God will we do valiantly; and he shall bring to nought them that harass us."]]