[["1",[["ᾠδὴ",714091,12],["τῶν",709436,80],["ἀναβαθμῶν",700904,81],["πρὸς",710844,0],["σὲ",711598,163],["ἦρα",700473,155],["τοὺς",709436,58],["ὀφθαλμούς",709870,57],["μου",709032,133],["τὸν",709436,5],["κατοικοῦντα",707534,183],["ἐν",704639,0],["τῷ",709436,113],["οὐρανῷ",709844,114]],"A Song of Degrees. Unto thee who dwellest in heaven have I lifted up mine eyes."],["2",[["ἰδοὺ",706497,88],["ὡς",714148,7],["ὀφθαλμοὶ",709870,52],["δούλων",703817,81],["εἰς",704105,0],["χεῖρας",713787,39],["τῶν",709436,80],["κυρίων",707996,81],["αὐτῶν",702165,565],["ὡς",714148,7],["ὀφθαλμοὶ",709870,52],["παιδίσκης",709928,17],["εἰς",704105,0],["χεῖρας",713787,39],["τῆς",709436,16],["κυρίας",707993,17],["αὐτῆς",702165,547],["οὕτως",709859,28],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["ἡμῶν",705999,145],["πρὸς",710844,0],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["ἡμῶν",705999,145],["ἕως",705792,0],["οὗ",709781,48],["οἰκτιρήσαι",709518,172],["ἡμᾶς",705981,194]],"Behold, as the eyes of servants [are directed] to the hands of their masters, [and] as the eyes of a maid-servant to the hands of her mistress; so our eyes [are directed] to the Lord our God, until he have mercy upon us."],["3",[["ἐλέησον",704418,176],["ἡμᾶς",705981,194],["κύριε",707996,153],["ἐλέησον",704418,176],["ἡμᾶς",705981,194],["ὅτι",709803,7],["ἐπὶ",705080,0],["πολὺ",710646,46],["ἐπλήσθημεν",710532,485],["ἐξουδενώσεως",704971,17]],"Have pity upon us, O Lord, have pity upon us: for we are exceedingly filled with contempt."],["4",[["ἐπὶ",705080,0],["πλεῖον",710514,46],["ἐπλήσθη",710532,37],["ἡ",709436,10],["ψυχὴ",714070,12],["ἡμῶν",705999,145],["τὸ",709436,24],["ὄνειδος",709658,25],["τοῖς",709436,147],["εὐθηνοῦσιν",705594,197],["καὶ",707031,7],["ἡ",709436,10],["ἐξουδένωσις",704971,12],["τοῖς",709436,147],["ὑπερηφάνοις",713139,230]],"[Yea], our soul has been exceedingly filled [with it]: [let] the reproach [be] to them that are at ease, and contempt to the proud."]]