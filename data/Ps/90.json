[["1",[["αἶνος",700462,4],["ᾠδῆς",714091,17],["τῷ",709436,113],["Δαυιδ",703232,114],["ὁ",709436,3],["κατοικῶν",707534,72],["ἐν",704639,0],["βοηθείᾳ",702745,1],["τοῦ",709436,35],["ὑψίστου",713287,116],["ἐν",704639,0],["σκέπῃ",711839,1],["τοῦ",709436,35],["θεοῦ",706192,18],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["αὐλισθήσεται",702138,134]],"Praise of a Song, by David. He that dwells in the help of the Highest, shall sojourn under the shelter of the God of heaven."],["2",[["ἐρεῖ",705415,127],["τῷ",709436,113],["κυρίῳ",707996,114],["ἀντιλήμπτωρ",701246,4],["μου",709032,133],["εἶ",704093,154],["καὶ",707031,7],["καταφυγή",707485,12],["μου",709032,133],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["ἐλπιῶ",704529,165],["ἐπ᾿",705080,0],["αὐτόν",702165,85]],"He shall say to the Lord, Thou art my helper and my refuge: my God; I will hope in him."],["3",[["ὅτι",709803,7],["αὐτὸς",702165,121],["ῥύσεταί",711309,93],["με",708618,163],["ἐκ",704132,0],["παγίδος",709910,17],["θηρευτῶν",706247,81],["καὶ",707031,7],["ἀπὸ",701425,0],["λόγου",708236,18],["ταραχώδους",712724,116]],"For he shall deliver thee from the snare of the hunters, from [every] troublesome matter."],["4",[["ἐν",704639,0],["τοῖς",709436,95],["μεταφρένοις",708824,96],["αὐτοῦ",702165,102],["ἐπισκιάσει",705253,127],["σοι",711925,159],["καὶ",707031,7],["ὑπὸ",713184,0],["τὰς",709436,38],["πτέρυγας",711057,39],["αὐτοῦ",702165,102],["ἐλπιεῖς",704529,166],["ὅπλῳ",709704,54],["κυκλώσει",707958,127],["σε",711598,163],["ἡ",709436,10],["ἀλήθεια",700656,12],["αὐτοῦ",702165,102]],"He shall overshadow thee with his shoulders, and thou shalt trust under his wings: his truth shall cover thee with a shield."],["5",[["οὐ",709805,28],["φοβηθήσῃ",713532,364],["ἀπὸ",701425,0],["φόβου",713534,18],["νυκτερινοῦ",709375,116],["ἀπὸ",701425,0],["βέλους",702644,21],["πετομένου",710441,478],["ἡμέρας",705984,17]],"Thou shalt not be afraid of terror by night; nor of the arrow flying by day;"],["6",[["ἀπὸ",701425,0],["πράγματος",710708,21],["διαπορευομένου",703551,478],["ἐν",704639,0],["σκότει",711889,54],["ἀπὸ",701425,0],["συμπτώματος",712351,21],["καὶ",707031,7],["δαιμονίου",703249,21],["μεσημβρινοῦ",708759,116]],"[nor] of the [evil] thing that walks in darkness; [nor] of calamity, and the evil spirit at noon-day."],["7",[["πεσεῖται",710481,93],["ἐκ",704132,0],["τοῦ",709436,20],["κλίτους",707740,21],["σου",711945,133],["χιλιὰς",713859,82],["καὶ",707031,7],["μυριὰς",709062,12],["ἐκ",704132,0],["δεξιῶν",703360,198],["σου",711945,133],["πρὸς",710844,0],["σὲ",711598,163],["δὲ",703303,11],["οὐκ",709805,28],["ἐγγιεῖ",703939,127]],"A thousand shall fall at thy side, and ten thousand at thy right hand; but it shall not come nigh thee."],["8",[["πλὴν",710540,28],["τοῖς",709436,147],["ὀφθαλμοῖς",709870,148],["σου",711945,133],["κατανοήσεις",707341,166],["καὶ",707031,7],["ἀνταπόδοσιν",701217,9],["ἁμαρτωλῶν",700776,169],["ὄψῃ",709725,123]],"Only with thine eyes shalt thou observe and see the reward of sinners."],["9",[["ὅτι",709803,7],["σύ",712181,164],["κύριε",707996,153],["ἡ",709436,10],["ἐλπίς",704530,12],["μου",709032,133],["τὸν",709436,5],["ὕψιστον",713287,27],["ἔθου",712849,174],["καταφυγήν",707485,9],["σου",711945,133]],"For thou, O Lord, art my hope: thou, my soul, hast made the Most High thy refuge."],["10",[["οὐ",709805,28],["προσελεύσεται",710890,93],["πρὸς",710844,0],["σὲ",711598,163],["κακά",707066,68],["καὶ",707031,7],["μάστιξ",708568,12],["οὐκ",709805,28],["ἐγγιεῖ",703939,127],["τῷ",709436,53],["σκηνώματί",711849,54],["σου",711945,133]],"No evils shall come upon thee, and no scourge shall draw nigh to thy dwelling."],["11",[["ὅτι",709803,7],["τοῖς",709436,147],["ἀγγέλοις",700140,148],["αὐτοῦ",702165,102],["ἐντελεῖται",704791,117],["περὶ",710285,0],["σοῦ",711945,133],["τοῦ",709436,20],["διαφυλάξαι",703632,106],["σε",711598,163],["ἐν",704639,0],["πάσαις",710177,291],["ταῖς",709436,75],["ὁδοῖς",709458,76],["σου",711945,133]],"For he shall give his angels charge concerning thee, to keep thee in all thy ways."],["12",[["ἐπὶ",705080,0],["χειρῶν",713787,65],["ἀροῦσίν",700473,218],["σε",711598,163],["μήποτε",708882,28],["προσκόψῃς",710923,175],["πρὸς",710844,0],["λίθον",708196,6],["τὸν",709436,5],["πόδα",710707,6],["σου",711945,133]],"They shall bear thee up on their hands, lest at any time thou dash thy foot against a stone."],["13",[["ἐπ᾿",705080,0],["ἀσπίδα",701991,9],["καὶ",707031,7],["βασιλίσκον",702583,27],["ἐπιβήσῃ",705082,123],["καὶ",707031,7],["καταπατήσεις",707360,166],["λέοντα",708171,6],["καὶ",707031,7],["δράκοντα",703822,6]],"Thou shalt tread on the asp and basilisk: and thou shalt trample on the lion and dragon."],["14",[["ὅτι",709803,7],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ἤλπισεν",704529,2],["καὶ",707031,7],["ῥύσομαι",711309,181],["αὐτόν",702165,85],["σκεπάσω",711832,165],["αὐτόν",702165,85],["ὅτι",709803,7],["ἔγνω",703105,2],["τὸ",709436,24],["ὄνομά",709666,25],["μου",709032,133]],"For he has hoped in me, and I will deliver him: I will protect him, because he has known my name."],["15",[["ἐπικαλέσεταί",705153,93],["με",708618,163],["καὶ",707031,7],["εἰσακούσομαι",704108,181],["αὐτοῦ",702165,102],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["εἰμι",704093,157],["ἐν",704639,0],["θλίψει",706276,1],["καὶ",707031,7],["ἐξελοῦμαι",704838,181],["καὶ",707031,7],["δοξάσω",703792,165],["αὐτόν",702165,85]],"He shall call upon me, and I will hearken to him: I am with him in affliction; and I will deliver him, and glorify him."],["16",[["μακρότητα",708423,9],["ἡμερῶν",705984,65],["ἐμπλήσω",704592,165],["αὐτὸν",702165,85],["καὶ",707031,7],["δείξω",703314,165],["αὐτῷ",702165,50],["τὸ",709436,24],["σωτήριόν",712659,25],["μου",709032,133]],"I will satisfy him with length of days, and shew him my salvation."]]