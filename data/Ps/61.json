[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ὑπὲρ",713111,0],["Ιδιθουν",706489,227],["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, a Psalm of David for Idithun."],["2",[["οὐχὶ",709862,28],["τῷ",709436,113],["θεῷ",706192,114],["ὑποταγήσεται",713250,134],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["γὰρ",702963,11],["τὸ",709436,24],["σωτήριόν",712659,25],["μου",709032,133]],"Shall not my soul be subjected to God? for of him is my salvation."],["3",[["καὶ",707031,7],["γὰρ",702963,11],["αὐτὸς",702165,121],["θεός",706192,4],["μου",709032,133],["καὶ",707031,7],["σωτήρ",712657,4],["μου",709032,133],["ἀντιλήμπτωρ",701246,4],["μου",709032,133],["οὐ",709805,28],["μὴ",708851,28],["σαλευθῶ",711403,321],["ἐπὶ",705080,0],["πλεῖον",710514,46]],"For he is my God and my Saviour; my helper, I shall not be moved very much."],["4",[["ἕως",705792,0],["πότε",710696,11],["ἐπιτίθεσθε",705304,374],["ἐπ᾿",705080,0],["ἄνθρωπον",701163,6],["φονεύετε",713546,87],["πάντες",710177,138],["ὡς",714148,7],["τοίχῳ",712879,114],["κεκλιμένῳ",707738,463],["καὶ",707031,7],["φραγμῷ",713572,114],["ὠσμένῳ",714100,463]],"How long will ye assault a man? ye are all slaughtering as with a bowed wall and a broken hedge."],["5",[["πλὴν",710540,28],["τὴν",709436,8],["τιμήν",712856,9],["μου",709032,133],["ἐβουλεύσαντο",702791,189],["ἀπώσασθαι",701659,109],["ἔδραμον",712931,150],["ἐν",704639,0],["ψεύδει",714040,91],["τῷ",709436,53],["στόματι",712125,54],["αὐτῶν",702165,40],["εὐλογοῦσαν",705631,78],["καὶ",707031,7],["τῇ",709436,100],["καρδίᾳ",707141,1],["αὐτῶν",702165,40],["κατηρῶντο",707396,139],["διάψαλμα",703641,15]],"They only took counsel to set at nought mine honour: I ran in thirst: with their mouth they blessed, but with their heart they cursed. Pause."],["6",[["πλὴν",710540,28],["τῷ",709436,113],["θεῷ",706192,114],["ὑποτάγηθι",713250,244],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ὅτι",709803,7],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["ἡ",709436,10],["ὑπομονή",713226,12],["μου",709032,133]],"Nevertheless do thou, my soul, be subjected to God; for of him [is] my patient hope."],["7",[["ὅτι",709803,7],["αὐτὸς",702165,121],["θεός",706192,4],["μου",709032,133],["καὶ",707031,7],["σωτήρ",712657,4],["μου",709032,133],["ἀντιλήμπτωρ",701246,4],["μου",709032,133],["οὐ",709805,28],["μὴ",708851,28],["μεταναστεύσω",708807,207]],"For he [is] my God and my Saviour; my helper, I shall not be moved."],["8",[["ἐπὶ",705080,0],["τῷ",709436,113],["θεῷ",706192,114],["τὸ",709436,24],["σωτήριόν",712659,25],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["δόξα",703791,12],["μου",709032,133],["ὁ",709436,3],["θεὸς",706192,4],["τῆς",709436,16],["βοηθείας",702745,17],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["ἐλπίς",704530,12],["μου",709032,133],["ἐπὶ",705080,0],["τῷ",709436,113],["θεῷ",706192,114]],"In God [is] my salvation and my glory: [he is] the God of my help, and my hope is in God."],["9",[["ἐλπίσατε",704529,74],["ἐπ᾿",705080,0],["αὐτόν",702165,85],["πᾶσα",710177,29],["συναγωγὴ",712376,12],["λαοῦ",708094,18],["ἐκχέετε",704368,87],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["τὰς",709436,38],["καρδίας",707141,39],["ὑμῶν",713091,145],["ὁ",709436,3],["θεὸς",706192,4],["βοηθὸς",702748,4],["ἡμῶν",705999,145],["διάψαλμα",703641,15]],"Hope in him, all ye congregation of the people; pour out your hearts before him, for God is our helper. Pause."],["10",[["πλὴν",710540,28],["μάταιοι",708575,138],["οἱ",709436,136],["υἱοὶ",713075,52],["τῶν",709436,80],["ἀνθρώπων",701163,81],["ψευδεῖς",714036,138],["οἱ",709436,136],["υἱοὶ",713075,52],["τῶν",709436,80],["ἀνθρώπων",701163,81],["ἐν",704639,0],["ζυγοῖς",705894,148],["τοῦ",709436,20],["ἀδικῆσαι",700269,106],["αὐτοὶ",702165,201],["ἐκ",704132,0],["ματαιότητος",708576,17],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτό",702165,129]],"But the sons of men are vain; the sons of men are false, so as to be deceitful in the balances; they are all alike [formed] out of vanity."],["11",[["μὴ",708851,28],["ἐλπίζετε",704529,87],["ἐπὶ",705080,0],["ἀδικίαν",700271,9],["καὶ",707031,7],["ἐπὶ",705080,0],["ἅρπαγμα",701803,25],["μὴ",708851,28],["ἐπιποθεῖτε",705228,87],["πλοῦτος",710563,4],["ἐὰν",703912,7],["ῥέῃ",711241,204],["μὴ",708851,28],["προστίθεσθε",710965,374],["καρδίαν",707141,9]],"Trust not in unrighteousness, and lust not after robberies: if wealth should flow in, set not your heart upon it."],["12",[["ἅπαξ",701350,28],["ἐλάλησεν",708071,2],["ὁ",709436,3],["θεός",706192,4],["δύο",703849,59],["ταῦτα",709858,71],["ἤκουσα",700587,155]],"God has spoken once, [and] I have heard these two things, that power is of God;"],["13",[["ὅτι",709803,7],["τὸ",709436,24],["κράτος",707883,25],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["σοί",711925,159],["κύριε",707996,153],["τὸ",709436,34],["ἔλεος",704426,15],["ὅτι",709803,7],["σὺ",712181,164],["ἀποδώσεις",701449,166],["ἑκάστῳ",704133,30],["κατὰ",707200,0],["τὰ",709436,41],["ἔργα",705396,42],["αὐτοῦ",702165,102]],"and mercy is thine, O Lord; for thou wilt recompense every one according to his works.",{"s":"d","q":0.67}]]