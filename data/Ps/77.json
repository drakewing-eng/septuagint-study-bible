[["1",[["συνέσεως",712460,17],["τῷ",709436,113],["Ασαφ",701894,114],["προσέχετε",710895,335],["λαός",708094,4],["μου",709032,133],["τὸν",709436,5],["νόμον",709349,6],["μου",709032,133],["κλίνατε",707738,74],["τὸ",709436,24],["οὖς",709852,25],["ὑμῶν",713091,145],["εἰς",704105,0],["τὰ",709436,41],["ῥήματα",711246,42],["τοῦ",709436,20],["στόματός",712125,21],["μου",709032,133]],"[A Psalm] of instruction for Asaph. Give heed, O my people, to my law: incline your ear to the words of my mouth."],["2",[["ἀνοίξω",701186,165],["ἐν",704639,0],["παραβολαῖς",710003,76],["τὸ",709436,24],["στόμα",712125,25],["μου",709032,133],["φθέγξομαι",713442,181],["προβλήματα",710771,42],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17]],"I will open my mouth in parables: I will utter dark sayings [which have been] from the beginning."],["3",[["ὅσα",709788,68],["ἠκούσαμεν",700587,289],["καὶ",707031,7],["ἔγνωμεν",703105,289],["αὐτὰ",702165,71],["καὶ",707031,7],["οἱ",709436,136],["πατέρες",710189,52],["ἡμῶν",705999,145],["διηγήσαντο",703679,189],["ἡμῖν",705994,90]],"All which we have heard and known, and our fathers have declared to us."],["4",[["οὐκ",709805,28],["ἐκρύβη",707923,37],["ἀπὸ",701425,0],["τῶν",709436,43],["τέκνων",712761,44],["αὐτῶν",702165,40],["εἰς",704105,0],["γενεὰν",703037,9],["ἑτέραν",705535,36],["ἀπαγγέλλοντες",701321,146],["τὰς",709436,38],["αἰνέσεις",700457,39],["τοῦ",709436,35],["κυρίου",707996,18],["καὶ",707031,7],["τὰς",709436,38],["δυναστείας",703841,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["θαυμάσια",706136,68],["αὐτοῦ",702165,102],["ἃ",709781,69],["ἐποίησεν",710582,2]],"They were not hid from their children to a second generation; [the fathers] declaring the praises of the Lord, and his mighty acts, and his wonders which he wrought."],["5",[["καὶ",707031,7],["ἀνέστησεν",701173,2],["μαρτύριον",708525,25],["ἐν",704639,0],["Ιακωβ",706401,114],["καὶ",707031,7],["νόμον",709349,6],["ἔθετο",712849,23],["ἐν",704639,0],["Ισραηλ",706839,114],["ὅσα",709788,68],["ἐνετείλατο",704791,23],["τοῖς",709436,147],["πατράσιν",710189,148],["ἡμῶν",705999,145],["τοῦ",709436,20],["γνωρίσαι",703135,106],["αὐτὰ",702165,71],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτῶν",702165,40]],"And he raised up a testimony in Jacob, and appointed a law in Israel, which he commanded our fathers, to make it known to their children:"],["6",[["ὅπως",709719,7],["ἂν",700900,11],["γνῷ",703105,172],["γενεὰ",703037,12],["ἑτέρα",705535,29],["υἱοὶ",713075,52],["οἱ",709436,136],["τεχθησόμενοι",712853,730],["καὶ",707031,7],["ἀναστήσονται",701173,135],["καὶ",707031,7],["ἀπαγγελοῦσιν",701321,218],["αὐτὰ",702165,71],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτῶν",702165,40]],"that another generation might know, even the sons which should be born; and they should arise and declare them to their children."],["7",[["ἵνα",706747,7],["θῶνται",712849,232],["ἐπὶ",705080,0],["τὸν",709436,5],["θεὸν",706192,6],["τὴν",709436,8],["ἐλπίδα",704530,9],["αὐτῶν",702165,40],["καὶ",707031,7],["μὴ",708851,28],["ἐπιλάθωνται",705187,232],["τῶν",709436,43],["ἔργων",705396,44],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["τὰς",709436,38],["ἐντολὰς",704802,39],["αὐτοῦ",702165,102],["ἐκζητήσουσιν",704187,218]],"That they might set their hope on God, and not forget the works of God, but diligently seek his commandments."],["8",[["ἵνα",706747,7],["μὴ",708851,28],["γένωνται",703104,232],["ὡς",714148,7],["οἱ",709436,136],["πατέρες",710189,52],["αὐτῶν",702165,40],["γενεὰ",703037,12],["σκολιὰ",711868,29],["καὶ",707031,7],["παραπικραίνουσα",710087,188],["γενεά",703037,12],["ἥτις",709793,412],["οὐ",709805,28],["κατηύθυνεν",707521,2],["τὴν",709436,8],["καρδίαν",707141,9],["αὐτῆς",702165,86],["καὶ",707031,7],["οὐκ",709805,28],["ἐπιστώθη",710487,37],["μετὰ",708780,0],["τοῦ",709436,35],["θεοῦ",706192,18],["τὸ",709436,24],["πνεῦμα",710566,25],["αὐτῆς",702165,86]],"That they should not be as their fathers, a perverse and provoking generation; a generation which set not its heart aright, and its spirit was not steadfast with God."],["9",[["υἱοὶ",713075,52],["Εφραιμ",705769,18],["ἐντείνοντες",704790,146],["καὶ",707031,7],["βάλλοντες",702487,146],["τόξοις",712898,96],["ἐστράφησαν",712160,99],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["πολέμου",710605,18]],"The children of Ephraim, bending and shooting [with] the bow, turned [back] in the day of battle."],["10",[["οὐκ",709805,28],["ἐφύλαξαν",713619,150],["τὴν",709436,8],["διαθήκην",703456,9],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["νόμῳ",709349,114],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἤθελον",706176,137],["πορεύεσθαι",710667,110]],"They kept not the covenant of God, and would not walk in his law."],["11",[["καὶ",707031,7],["ἐπελάθοντο",705187,189],["τῶν",709436,130],["εὐεργεσιῶν",705574,65],["αὐτοῦ",702165,102],["καὶ",707031,7],["τῶν",709436,80],["θαυμασίων",706136,169],["αὐτοῦ",702165,102],["ὧν",709781,252],["ἔδειξεν",703314,2],["αὐτοῖς",702165,151]],"And they forgot his benefits, and his miracles which he [had] shewed them;"],["12",[["ἐναντίον",704654,0],["τῶν",709436,80],["πατέρων",710189,81],["αὐτῶν",702165,40],["ἃ",709781,69],["ἐποίησεν",710582,2],["θαυμάσια",706136,68],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτῳ",700401,1],["ἐν",704639,0],["πεδίῳ",710215,54],["Τάνεως",712708,118]],"the miracles which he wrought before their fathers, in the land of Egypt, in the plain of Tanes."],["13",[["διέρρηξεν",703565,2],["θάλασσαν",706069,9],["καὶ",707031,7],["διήγαγεν",703442,2],["αὐτούς",702165,62],["ἔστησεν",706846,2],["ὕδατα",713071,25],["ὡσεὶ",714159,7],["ἀσκὸν",701968,6]],"He clave the sea, and led them through: he made the waters to stand as [in] a bottle."],["14",[["καὶ",707031,7],["ὡδήγησεν",709448,2],["αὐτοὺς",702165,62],["ἐν",704639,0],["νεφέλῃ",709277,1],["ἡμέρας",705984,17],["καὶ",707031,7],["ὅλην",709597,36],["τὴν",709436,8],["νύκτα",709386,9],["ἐν",704639,0],["φωτισμῷ",713647,114],["πυρός",711101,4]],"And he guided them with a cloud by day, and all the night with a light of fire."],["15",[["διέρρηξεν",703565,2],["πέτραν",710443,9],["ἐν",704639,0],["ἐρήμῳ",705420,1],["καὶ",707031,7],["ἐπότισεν",710700,2],["αὐτοὺς",702165,62],["ὡς",714148,7],["ἐν",704639,0],["ἀβύσσῳ",700098,1],["πολλῇ",710646,101]],"He clave a rock in the wilderness, and made them drink as in a great deep."],["16",[["καὶ",707031,7],["ἐξήγαγεν",704834,2],["ὕδωρ",713071,15],["ἐκ",704132,0],["πέτρας",710443,17],["καὶ",707031,7],["κατήγαγεν",707232,2],["ὡς",714148,7],["ποταμοὺς",710693,57],["ὕδατα",713071,42]],"And he brought water out of the rock, and caused waters to flow down as rivers."],["17",[["καὶ",707031,7],["προσέθεντο",710965,189],["ἔτι",705538,28],["τοῦ",709436,35],["ἁμαρτάνειν",700773,55],["αὐτῷ",702165,50],["παρεπίκραναν",710087,150],["τὸν",709436,5],["ὕψιστον",713287,27],["ἐν",704639,0],["ἀνύδρῳ",701285,97]],"And they sinned yet more against him; they provoked the Most High in the wilderness."],["18",[["καὶ",707031,7],["ἐξεπείρασαν",704273,150],["τὸν",709436,5],["θεὸν",706192,6],["ἐν",704639,0],["ταῖς",709436,75],["καρδίαις",707141,76],["αὐτῶν",702165,40],["τοῦ",709436,20],["αἰτῆσαι",700489,106],["βρώματα",702823,42],["ταῖς",709436,75],["ψυχαῖς",714070,76],["αὐτῶν",702165,40]],"And they tempted God in their hearts, in asking meat for [the desire of] their souls."],["19",[["καὶ",707031,7],["κατελάλησαν",707298,150],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["εἶπαν",705373,150],["μὴ",708851,28],["δυνήσεται",703838,93],["ὁ",709436,3],["θεὸς",706192,4],["ἑτοιμάσαι",705539,106],["τράπεζαν",712919,9],["ἐν",704639,0],["ἐρήμῳ",705420,1]],"They spoke also against God, and said, Will God be able to prepare a table in the wilderness?"],["20",[["ἐπεὶ",705054,7],["ἐπάταξεν",710185,2],["πέτραν",710443,9],["καὶ",707031,7],["ἐρρύησαν",711241,150],["ὕδατα",713071,25],["καὶ",707031,7],["χείμαρροι",713783,52],["κατεκλύσθησαν",707278,99],["μὴ",708851,28],["καὶ",707031,7],["ἄρτον",701829,6],["δύναται",703838,117],["δοῦναι",703654,106],["ἢ",705924,7],["ἑτοιμάσαι",705539,106],["τράπεζαν",712919,9],["τῷ",709436,113],["λαῷ",708094,114],["αὐτοῦ",702165,102]],"Forasmuch as he smote the rock, and the waters flowed, and the torrents ran abundantly; will he be able also to give bread, or prepare a table for his people?"],["21",[["διὰ",703417,0],["τοῦτο",709858,129],["ἤκουσεν",700587,2],["κύριος",707996,4],["καὶ",707031,7],["ἀνεβάλετο",700906,23],["καὶ",707031,7],["πῦρ",711088,15],["ἀνήφθη",701044,37],["ἐν",704639,0],["Ιακωβ",706401,114],["καὶ",707031,7],["ὀργὴ",709728,12],["ἀνέβη",700905,2],["ἐπὶ",705080,0],["τὸν",709436,5],["Ισραηλ",706839,6]],"Therefore the Lord heard, and was provoked: and fire was kindled in Jacob, and wrath went up against Israel."],["22",[["ὅτι",709803,7],["οὐκ",709805,28],["ἐπίστευσαν",710483,150],["ἐν",704639,0],["τῷ",709436,113],["θεῷ",706192,114],["οὐδὲ",709816,7],["ἤλπισαν",704529,150],["ἐπὶ",705080,0],["τὸ",709436,24],["σωτήριον",712659,25],["αὐτοῦ",702165,102]],"Because they believed not in God, and trusted not in his salvation."],["23",[["καὶ",707031,7],["ἐνετείλατο",704791,23],["νεφέλαις",709277,76],["ὑπεράνωθεν",713119,28],["καὶ",707031,7],["θύρας",706337,39],["οὐρανοῦ",709844,18],["ἀνέῳξεν",701186,2]],"Yet he commanded the clouds from above, and opened the doors of heaven,"],["24",[["καὶ",707031,7],["ἔβρεξεν",702812,2],["αὐτοῖς",702165,151],["μαννα",708486,25],["φαγεῖν",713296,106],["καὶ",707031,7],["ἄρτον",701829,6],["οὐρανοῦ",709844,18],["ἔδωκεν",703654,2],["αὐτοῖς",702165,151]],"and rained upon them manna to eat, and gave them the bread of heaven."],["25",[["ἄρτον",701829,6],["ἀγγέλων",700140,81],["ἔφαγεν",713296,2],["ἄνθρωπος",701163,4],["ἐπισιτισμὸν",705247,6],["ἀπέστειλεν",701592,2],["αὐτοῖς",702165,151],["εἰς",704105,0],["πλησμονήν",710549,9]],"Man ate angels' bread; he sent them provision to the full."],["26",[["ἀπῆρεν",701329,2],["νότον",709364,6],["ἐξ",704132,0],["οὐρανοῦ",709844,18],["καὶ",707031,7],["ἐπήγαγεν",704994,2],["ἐν",704639,0],["τῇ",709436,100],["δυναστείᾳ",703841,1],["αὐτοῦ",702165,102],["λίβα",708224,6]],"He removed the south wind from heaven; and by his might he brought in the south-west wind."],["27",[["καὶ",707031,7],["ἔβρεξεν",702812,2],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["ὡσεὶ",714159,7],["χοῦν",713930,6],["σάρκας",711537,39],["καὶ",707031,7],["ὡσεὶ",714159,7],["ἄμμον",700845,9],["θαλασσῶν",706069,65],["πετεινὰ",710439,42],["πτερωτά",711059,68]],"And he rained upon them flesh like dust, and feathered birds like the sand of the seas."],["28",[["καὶ",707031,7],["ἐπέπεσον",705225,150],["εἰς",704105,0],["μέσον",708768,27],["τῆς",709436,16],["παρεμβολῆς",710133,17],["αὐτῶν",702165,40],["κύκλῳ",707959,114],["τῶν",709436,43],["σκηνωμάτων",711849,44],["αὐτῶν",702165,40]],"And they fell into the midst of their camp, round about their tents."],["29",[["καὶ",707031,7],["ἐφάγοσαν",705495,150],["καὶ",707031,7],["ἐνεπλήσθησαν",704592,99],["σφόδρα",712586,28],["καὶ",707031,7],["τὴν",709436,8],["ἐπιθυμίαν",705147,9],["αὐτῶν",702165,40],["ἤνεγκεν",713428,2],["αὐτοῖς",702165,151]],"So they ate, and were completely filled; and he gave them their desire."],["30",[["οὐκ",709805,28],["ἐστερήθησαν",712076,99],["ἀπὸ",701425,0],["τῆς",709436,16],["ἐπιθυμίας",705147,17],["αὐτῶν",702165,40],["ἔτι",705538,28],["τῆς",709436,16],["βρώσεως",702825,17],["αὐτῶν",702165,40],["οὔσης",704093,222],["ἐν",704639,0],["τῷ",709436,53],["στόματι",712125,54],["αὐτῶν",702165,40]],"They were not disappointed of their desire: [but] when their food was yet in their mouth,"],["31",[["καὶ",707031,7],["ὀργὴ",709728,12],["τοῦ",709436,35],["θεοῦ",706192,18],["ἀνέβη",700905,2],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἀπέκτεινεν",701498,2],["ἐν",704639,0],["τοῖς",709436,147],["πίοσιν",710478,349],["αὐτῶν",702165,40],["καὶ",707031,7],["τοὺς",709436,58],["ἐκλεκτοὺς",704240,60],["τοῦ",709436,35],["Ισραηλ",706839,18],["συνεπόδισεν",712338,2]],"then the indignation of God rose up against them, and slew the fattest of them, and overthrew the choice men of Israel."],["32",[["ἐν",704639,0],["πᾶσιν",710177,230],["τούτοις",709858,151],["ἥμαρτον",700773,150],["ἔτι",705538,28],["καὶ",707031,7],["οὐκ",709805,28],["ἐπίστευσαν",710483,150],["ἐν",704639,0],["τοῖς",709436,147],["θαυμασίοις",706136,230],["αὐτοῦ",702165,102]],"In the midst of all this they sinned yet more, and believed not his miracles."],["33",[["καὶ",707031,7],["ἐξέλιπον",704237,150],["ἐν",704639,0],["ματαιότητι",708576,1],["αἱ",709436,190],["ἡμέραι",705984,191],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,63],["ἔτη",705543,64],["αὐτῶν",702165,40],["μετὰ",708780,0],["σπουδῆς",712035,17]],"And their days were consumed in vanity, and their years with anxiety."],["34",[["ὅταν",709801,28],["ἀπέκτεννεν",701498,2],["αὐτούς",702165,62],["ἐξεζήτουν",704187,137],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐπέστρεφον",705278,137],["καὶ",707031,7],["ὤρθριζον",709742,137],["πρὸς",710844,0],["τὸν",709436,5],["θεὸν",706192,6]],"When he slew them, they sought him: and they returned and called betimes upon God."],["35",[["καὶ",707031,7],["ἐμνήσθησαν",708960,99],["ὅτι",709803,7],["ὁ",709436,3],["θεὸς",706192,4],["βοηθὸς",702748,4],["αὐτῶν",702165,40],["ἐστιν",704093,91],["καὶ",707031,7],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["ὕψιστος",713287,14],["λυτρωτὴς",708285,4],["αὐτῶν",702165,40],["ἐστιν",704093,91]],"And they remembered that God was their helper, and the most high God was their redeemer."],["36",[["καὶ",707031,7],["ἠπάτησαν",701364,150],["αὐτὸν",702165,85],["ἐν",704639,0],["τῷ",709436,53],["στόματι",712125,54],["αὐτῶν",702165,40],["καὶ",707031,7],["τῇ",709436,100],["γλώσσῃ",703120,1],["αὐτῶν",702165,40],["ἐψεύσαντο",714040,189],["αὐτῷ",702165,50]],"Yet they loved him [only] with their mouth, and lied to him with their tongue."],["37",[["ἡ",709436,10],["δὲ",703303,11],["καρδία",707141,12],["αὐτῶν",702165,40],["οὐκ",709805,28],["εὐθεῖα",705602,29],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["οὐδὲ",709816,7],["ἐπιστώθησαν",710487,99],["ἐν",704639,0],["τῇ",709436,100],["διαθήκῃ",703456,1],["αὐτοῦ",702165,102]],"For their heart [was] not right with him, neither were they steadfast in his covenant."],["38",[["αὐτὸς",702165,121],["δέ",703303,11],["ἐστιν",704093,91],["οἰκτίρμων",709521,4],["καὶ",707031,7],["ἱλάσεται",706728,93],["ταῖς",709436,75],["ἁμαρτίαις",700775,76],["αὐτῶν",702165,40],["καὶ",707031,7],["οὐ",709805,28],["διαφθερεῖ",703624,127],["καὶ",707031,7],["πληθυνεῖ",710530,127],["τοῦ",709436,20],["ἀποστρέψαι",701598,106],["τὸν",709436,5],["θυμὸν",706334,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐχὶ",709862,28],["ἐκκαύσει",704205,127],["πᾶσαν",710177,36],["τὴν",709436,8],["ὀργὴν",709728,9],["αὐτοῦ",702165,102]],"But he is compassionate, and will forgive their sins, and will not destroy [them]: yea, he will frequently turn away his wrath, and will not kindle all his anger."],["39",[["καὶ",707031,7],["ἐμνήσθη",708960,37],["ὅτι",709803,7],["σάρξ",711537,12],["εἰσιν",704093,197],["πνεῦμα",710566,15],["πορευόμενον",710667,208],["καὶ",707031,7],["οὐκ",709805,28],["ἐπιστρέφον",705278,47]],"And he remembered that they are flesh; a wind that passes away, and returns not."],["40",[["ποσάκις",710687,28],["παρεπίκραναν",710087,150],["αὐτὸν",702165,85],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["παρώργισαν",710167,150],["αὐτὸν",702165,85],["ἐν",704639,0],["γῇ",703083,1],["ἀνύδρῳ",701285,101]],"How often did they provoke him in the wilderness, [and] anger him in a dry land!"],["41",[["καὶ",707031,7],["ἐπέστρεψαν",705278,150],["καὶ",707031,7],["ἐπείρασαν",710225,150],["τὸν",709436,5],["θεὸν",706192,6],["καὶ",707031,7],["τὸν",709436,5],["ἅγιον",700159,27],["τοῦ",709436,35],["Ισραηλ",706839,18],["παρώξυναν",710164,150]],"Yea, they turned back, and tempted God, and provoked the Holy One of Israel."],["42",[["οὐκ",709805,28],["ἐμνήσθησαν",708960,99],["τῆς",709436,16],["χειρὸς",713787,17],["αὐτοῦ",702165,102],["ἡμέρας",705984,17],["ἧς",709781,167],["ἐλυτρώσατο",708282,23],["αὐτοὺς",702165,62],["ἐκ",704132,0],["χειρὸς",713787,17],["θλίβοντος",706274,152]],"They remembered not his hand, the day in which he delivered them from the hand of the oppressor."],["43",[["ὡς",714148,7],["ἔθετο",712849,23],["ἐν",704639,0],["Αἰγύπτῳ",700401,1],["τὰ",709436,41],["σημεῖα",711748,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["τέρατα",712793,25],["αὐτοῦ",702165,102],["ἐν",704639,0],["πεδίῳ",710215,54],["Τάνεως",712708,118]],"How he had wrought his signs in Egypt, and his wonders in the field of Tanes:"],["44",[["καὶ",707031,7],["μετέστρεψεν",708817,2],["εἰς",704105,0],["αἷμα",700442,25],["τοὺς",709436,58],["ποταμοὺς",710693,57],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,41],["ὀμβρήματα",709610,42],["αὐτῶν",702165,40],["ὅπως",709719,7],["μὴ",708851,28],["πίωσιν",710478,234]],"and had changed their rivers into blood; and their streams, that they should not drink."],["45",[["ἐξαπέστειλεν",704872,2],["εἰς",704105,0],["αὐτοὺς",702165,62],["κυνόμυιαν",707978,9],["καὶ",707031,7],["κατέφαγεν",707519,2],["αὐτούς",702165,62],["καὶ",707031,7],["βάτραχον",702599,6],["καὶ",707031,7],["διέφθειρεν",703624,13],["αὐτούς",702165,62]],"He sent against them the dog-fly, and it devoured them; and the frog, and it spoiled them."],["46",[["καὶ",707031,7],["ἔδωκεν",703654,2],["τῇ",709436,100],["ἐρυσίβῃ",705450,1],["τὸν",709436,5],["καρπὸν",707169,6],["αὐτῶν",702165,40],["καὶ",707031,7],["τοὺς",709436,58],["πόνους",710661,57],["αὐτῶν",702165,40],["τῇ",709436,100],["ἀκρίδι",700599,1]],"And he gave their fruit to the canker worm, and their labours to the locust."],["47",[["ἀπέκτεινεν",701498,2],["ἐν",704639,0],["χαλάζῃ",713667,1],["τὴν",709436,8],["ἄμπελον",700870,9],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰς",709436,38],["συκαμίνους",712253,39],["αὐτῶν",702165,40],["ἐν",704639,0],["τῇ",709436,100],["πάχνῃ",710203,1]],"He killed their vines with hail, and their sycamores with frost."],["48",[["καὶ",707031,7],["παρέδωκεν",710014,2],["εἰς",704105,0],["χάλαζαν",713667,9],["τὰ",709436,41],["κτήνη",707934,42],["αὐτῶν",702165,40],["καὶ",707031,7],["τὴν",709436,8],["ὕπαρξιν",713101,9],["αὐτῶν",702165,40],["τῷ",709436,53],["πυρί",711088,54]],"And he gave up their cattle to hail, and their substance to the fire."],["49",[["ἐξαπέστειλεν",704872,2],["εἰς",704105,0],["αὐτοὺς",702165,62],["ὀργὴν",709728,9],["θυμοῦ",706334,18],["αὐτοῦ",702165,102],["θυμὸν",706334,6],["καὶ",707031,7],["ὀργὴν",709728,9],["καὶ",707031,7],["θλῖψιν",706276,9],["ἀποστολὴν",701596,9],["δι᾿",703417,0],["ἀγγέλων",700140,81],["πονηρῶν",710660,169]],"He sent out against them the fury of his anger, wrath, and indignation, and affliction, a message by evil angels."],["50",[["ὡδοποίησεν",709456,2],["τρίβον",712941,26],["τῇ",709436,100],["ὀργῇ",709728,1],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐφείσατο",713406,23],["ἀπὸ",701425,0],["θανάτου",706096,18],["τῶν",709436,130],["ψυχῶν",714070,65],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,41],["κτήνη",707934,42],["αὐτῶν",702165,40],["εἰς",704105,0],["θάνατον",706096,6],["συνέκλεισεν",712223,2]],"He made a way for his wrath; he spared not their souls from death, but consigned their cattle to death;"],["51",[["καὶ",707031,7],["ἐπάταξεν",710185,2],["πᾶν",710177,27],["πρωτότοκον",711046,27],["ἐν",704639,0],["Αἰγύπτῳ",700401,1],["ἀπαρχὴν",701359,9],["τῶν",709436,80],["πόνων",710661,81],["αὐτῶν",702165,40],["ἐν",704639,0],["τοῖς",709436,95],["σκηνώμασι",711849,96],["Χαμ",713699,118]],"and smote every first-born in the land of Egypt; the first-fruits of their labours in the tents of Cham."],["52",[["καὶ",707031,7],["ἀπῆρεν",701329,2],["ὡς",714148,7],["πρόβατα",710768,42],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀνήγαγεν",700933,2],["αὐτοὺς",702165,62],["ὡς",714148,7],["ποίμνιον",710598,25],["ἐν",704639,0],["ἐρήμῳ",705420,1]],"And he removed his people like sheep; he led them as a flock in the wilderness."],["53",[["καὶ",707031,7],["ὡδήγησεν",709448,2],["αὐτοὺς",702165,62],["ἐν",704639,0],["ἐλπίδι",704530,1],["καὶ",707031,7],["οὐκ",709805,28],["ἐδειλίασαν",703321,150],["καὶ",707031,7],["τοὺς",709436,58],["ἐχθροὺς",705779,57],["αὐτῶν",702165,40],["ἐκάλυψεν",707102,2],["θάλασσα",706069,12]],"And he guided them with hope, and they feared not: but the sea covered their enemies."],["54",[["καὶ",707031,7],["εἰσήγαγεν",704107,2],["αὐτοὺς",702165,62],["εἰς",704105,0],["ὅριον",709749,25],["ἁγιάσματος",700154,21],["αὐτοῦ",702165,102],["ὄρος",709768,25],["τοῦτο",709858,129],["ὃ",709781,128],["ἐκτήσατο",707932,23],["ἡ",709436,10],["δεξιὰ",703360,29],["αὐτοῦ",702165,102]],"And he brought them in to the mountain of his sanctuary, this mountain which his right hand had purchased."],["55",[["καὶ",707031,7],["ἐξέβαλεν",704145,2],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτῶν",702165,40],["ἔθνη",704068,42],["καὶ",707031,7],["ἐκληροδότησεν",707723,2],["αὐτοὺς",702165,62],["ἐν",704639,0],["σχοινίῳ",712610,54],["κληροδοσίας",707722,17],["καὶ",707031,7],["κατεσκήνωσεν",707423,2],["ἐν",704639,0],["τοῖς",709436,95],["σκηνώμασιν",711849,96],["αὐτῶν",702165,40],["τὰς",709436,38],["φυλὰς",713620,39],["τοῦ",709436,35],["Ισραηλ",706839,18]],"And he cast out the nations from before them, and made them to inherit by a line of inheritance, and made the tribes of Israel to dwell in their tents."],["56",[["καὶ",707031,7],["ἐπείρασαν",710225,150],["καὶ",707031,7],["παρεπίκραναν",710087,150],["τὸν",709436,5],["θεὸν",706192,6],["τὸν",709436,5],["ὕψιστον",713287,27],["καὶ",707031,7],["τὰ",709436,41],["μαρτύρια",708525,42],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐφυλάξαντο",713619,189]],"Yet they tempted and provoked the most high God, and kept not his testimonies."],["57",[["καὶ",707031,7],["ἀπέστρεψαν",701598,150],["καὶ",707031,7],["ἠσυνθέτησαν",702036,150],["καθὼς",707030,28],["καὶ",707031,28],["οἱ",709436,136],["πατέρες",710189,52],["αὐτῶν",702165,40],["καὶ",707031,7],["μετεστράφησαν",708817,99],["εἰς",704105,0],["τόξον",712898,25],["στρεβλὸν",712154,46]],"And they turned back, and broke covenant, even as also their fathers: they became like a crooked bow."],["58",[["καὶ",707031,7],["παρώργισαν",710167,150],["αὐτὸν",702165,85],["ἐν",704639,0],["τοῖς",709436,147],["βουνοῖς",702797,148],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["γλυπτοῖς",703117,230],["αὐτῶν",702165,40],["παρεζήλωσαν",710021,150],["αὐτόν",702165,85]],"And they provoked him with their high places, and moved him to jealousy with their graven images."],["59",[["ἤκουσεν",700587,2],["ὁ",709436,3],["θεὸς",706192,4],["καὶ",707031,7],["ὑπερεῖδεν",713154,2],["καὶ",707031,7],["ἐξουδένωσεν",704969,150],["σφόδρα",712586,28],["τὸν",709436,5],["Ισραηλ",706839,6]],"God heard and lightly regarded [them], and greatly despised Israel."],["60",[["καὶ",707031,7],["ἀπώσατο",701659,23],["τὴν",709436,8],["σκηνὴν",711845,9],["Σηλωμ",711739,118],["σκήνωμα",711849,25],["αὐτοῦ",702165,102],["οὗ",709781,48],["κατεσκήνωσεν",707423,2],["ἐν",704639,0],["ἀνθρώποις",701163,148]],"And he rejected the tabernacle of Selom, his tent where he dwelt among men."],["61",[["καὶ",707031,7],["παρέδωκεν",710014,2],["εἰς",704105,0],["αἰχμαλωσίαν",700499,9],["τὴν",709436,8],["ἰσχὺν",706858,9],["αὐτῶν",702165,40],["καὶ",707031,7],["τὴν",709436,8],["καλλονὴν",707092,9],["αὐτῶν",702165,40],["εἰς",704105,0],["χεῖρας",713787,39],["ἐχθροῦ",705779,18]],"And he gave their strength into captivity, and their beauty into the enemy's hand."],["62",[["καὶ",707031,7],["συνέκλεισεν",712223,2],["εἰς",704105,0],["ῥομφαίαν",711291,9],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὴν",709436,8],["κληρονομίαν",707725,9],["αὐτοῦ",702165,102],["ὑπερεῖδεν",713154,2]],"And he gave his people to the sword; and disdained his inheritance."],["63",[["τοὺς",709436,58],["νεανίσκους",709232,57],["αὐτῶν",702165,40],["κατέφαγεν",707519,2],["πῦρ",711088,15],["καὶ",707031,7],["αἱ",709436,190],["παρθένοι",710148,191],["αὐτῶν",702165,40],["οὐκ",709805,28],["ἐπενθήθησαν",710251,99]],"Fire devoured their young men; and their virgins mourned not."],["64",[["οἱ",709436,136],["ἱερεῖς",706614,52],["αὐτῶν",702165,40],["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["ἔπεσαν",710481,150],["καὶ",707031,7],["αἱ",709436,190],["χῆραι",713848,191],["αὐτῶν",702165,40],["οὐ",709805,28],["κλαυσθήσονται",707703,144]],"Their priests fell by the sword; and their widows shall not be wept for."],["65",[["καὶ",707031,7],["ἐξηγέρθη",704889,37],["ὡς",714148,7],["ὁ",709436,3],["ὑπνῶν",713181,81],["κύριος",707996,4],["ὡς",714148,7],["δυνατὸς",703845,14],["κεκραιπαληκὼς",707869,270],["ἐξ",704132,0],["οἴνου",709530,18]],"So the Lord awaked as one out of sleep, [and] as a mighty man who has been heated with wine."],["66",[["καὶ",707031,7],["ἐπάταξεν",710185,2],["τοὺς",709436,58],["ἐχθροὺς",705779,57],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,0],["ὄνειδος",709658,25],["αἰώνιον",700505,46],["ἔδωκεν",703654,2],["αὐτοῖς",702165,151]],"And he smote his enemies in the hinder parts: he brought on them a perpetual reproach."],["67",[["καὶ",707031,7],["ἀπώσατο",701659,23],["τὸ",709436,24],["σκήνωμα",711849,25],["Ιωσηφ",706948,18],["καὶ",707031,7],["τὴν",709436,8],["φυλὴν",713620,9],["Εφραιμ",705769,18],["οὐκ",709805,28],["ἐξελέξατο",704236,23]],"And he rejected the tabernacle of Joseph, and chose not the tribe of Ephraim;"],["68",[["καὶ",707031,7],["ἐξελέξατο",704236,23],["τὴν",709436,8],["φυλὴν",713620,9],["Ιουδα",706768,18],["τὸ",709436,24],["ὄρος",709768,25],["τὸ",709436,24],["Σιων",711816,17],["ὃ",709781,128],["ἠγάπησεν",700120,2]],"but chose the tribe of Juda, the mount Sion which he loved."],["69",[["καὶ",707031,7],["ᾠκοδόμησεν",709509,2],["ὡς",714148,7],["μονοκερώτων",708999,81],["τὸ",709436,24],["ἁγίασμα",700154,25],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ἐθεμελίωσεν",706182,2],["αὐτὴν",702165,104],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"And he built his sanctuary as [the place] of unicorns; he founded it for ever on the earth."],["70",[["καὶ",707031,7],["ἐξελέξατο",704236,23],["Δαυιδ",703232,4],["τὸν",709436,5],["δοῦλον",703817,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀνέλαβεν",700984,2],["αὐτὸν",702165,85],["ἐκ",704132,0],["τῶν",709436,43],["ποιμνίων",710598,44],["τῶν",709436,43],["προβάτων",710768,44]],"He chose David also his servant, and took him up from the flocks of sheep."],["71",[["ἐξόπισθεν",704962,28],["τῶν",709436,80],["λοχευομένων",708260,299],["ἔλαβεν",708076,2],["αὐτὸν",702165,85],["ποιμαίνειν",710594,55],["Ιακωβ",706401,6],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["Ισραηλ",706839,6],["τὴν",709436,8],["κληρονομίαν",707725,9],["αὐτοῦ",702165,102]],"He took him from following the ewes great with young, to be the shepherd of Jacob his servant, and Israel his inheritance."],["72",[["καὶ",707031,7],["ἐποίμανεν",710594,2],["αὐτοὺς",702165,62],["ἐν",704639,0],["τῇ",709436,100],["ἀκακίᾳ",700511,1],["τῆς",709436,16],["καρδίας",707141,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["συνέσεσι",712460,76],["τῶν",709436,130],["χειρῶν",713787,65],["αὐτοῦ",702165,102],["ὡδήγησεν",709448,2],["αὐτούς",702165,62]],"So he tended them in the innocency of his heart; and guided them by the skilfulness of his hands."]]