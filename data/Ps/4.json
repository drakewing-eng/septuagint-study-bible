[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ἐν",704639,0],["ψαλμοῖς",714022,148],["ᾠδὴ",714091,12],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, a Song of David among [the ]Psalms."],["2",[["ἐν",704639,0],["τῷ",709436,53],["ἐπικαλεῖσθαί",705153,110],["με",708618,163],["εἰσήκουσέν",704108,2],["μου",709032,133],["ὁ",709436,3],["θεὸς",706192,4],["τῆς",709436,16],["δικαιοσύνης",703695,17],["μου",709032,133],["ἐν",704639,0],["θλίψει",706276,1],["ἐπλάτυνάς",710508,162],["μοι",708974,159],["οἰκτίρησόν",709518,176],["με",708618,163],["καὶ",707031,7],["εἰσάκουσον",704108,176],["τῆς",709436,16],["προσευχῆς",710892,17],["μου",709032,133]],"When I called upon [him], the God of my righteousness heard me: thou hast made room for me in tribulation; pity me, and hearken to my prayer."],["3",[["υἱοὶ",713075,52],["ἀνθρώπων",701163,81],["ἕως",705792,0],["πότε",710696,28],["βαρυκάρδιοι",702552,138],["ἵνα",706747,7],["τί",712867,126],["ἀγαπᾶτε",700120,87],["ματαιότητα",708576,9],["καὶ",707031,7],["ζητεῖτε",705879,87],["ψεῦδος",714044,25],["διάψαλμα",703641,15]],"O ye sons of men, how long [will ye be] slow of heart? wherefore do ye love vanity, and seek falsehood? Pause."],["4",[["καὶ",707031,7],["γνῶτε",703105,74],["ὅτι",709803,7],["ἐθαυμάστωσεν",706139,2],["κύριος",707996,4],["τὸν",709436,5],["ὅσιον",709782,27],["αὐτοῦ",702165,102],["κύριος",707996,4],["εἰσακούσεταί",704108,93],["μου",709032,133],["ἐν",704639,0],["τῷ",709436,53],["κεκραγέναι",707868,115],["με",708618,163],["πρὸς",710844,0],["αὐτόν",702165,85]],"But know ye that the Lord has done wondrous things for his holy one: the Lord will hear me when I cry to him."],["5",[["ὀργίζεσθε",709729,73],["καὶ",707031,7],["μὴ",708851,28],["ἁμαρτάνετε",700773,335],["λέγετε",708124,335],["ἐν",704639,0],["ταῖς",709436,75],["καρδίαις",707141,76],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐπὶ",705080,0],["ταῖς",709436,75],["κοίταις",707781,76],["ὑμῶν",713091,145],["κατανύγητε",707347,372],["διάψαλμα",703641,15]],"Be ye angry, and sin not; feel compunction upon your beds for what ye say in your hearts. Pause."],["6",[["θύσατε",706349,74],["θυσίαν",706345,9],["δικαιοσύνης",703695,17],["καὶ",707031,7],["ἐλπίσατε",704529,74],["ἐπὶ",705080,0],["κύριον",707996,6]],"Offer the sacrifice of righteousness, and trust in the Lord."],["7",[["πολλοὶ",710646,138],["λέγουσιν",708124,197],["τίς",712867,158],["δείξει",703314,127],["ἡμῖν",705994,90],["τὰ",709436,41],["ἀγαθά",700106,68],["ἐσημειώθη",711749,37],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["τὸ",709436,34],["φῶς",713642,15],["τοῦ",709436,20],["προσώπου",710986,21],["σου",711945,133],["κύριε",707996,153]],"Many say, Who will shew us good things? the light of thy countenance, O Lord, has been manifested towards us."],["8",[["ἔδωκας",703654,162],["εὐφροσύνην",705717,9],["εἰς",704105,0],["τὴν",709436,8],["καρδίαν",707141,9],["μου",709032,133],["ἀπὸ",701425,0],["καιροῦ",707047,18],["σίτου",711814,18],["καὶ",707031,7],["οἴνου",709530,18],["καὶ",707031,7],["ἐλαίου",704380,21],["αὐτῶν",702165,40],["ἐπληθύνθησαν",710530,99]],"Thou hast put gladness into my heart: they have been satisfied with the fruit of their corn and wine and oil."],["9",[["ἐν",704639,0],["εἰρήνῃ",704098,1],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτὸ",702165,129],["κοιμηθήσομαι",707767,180],["καὶ",707031,7],["ὑπνώσω",713182,165],["ὅτι",709803,7],["σύ",712181,164],["κύριε",707996,153],["κατὰ",707200,0],["μόνας",709003,119],["ἐπ᾿",705080,0],["ἐλπίδι",704530,1],["κατῴκισάς",707538,162],["με",708618,163]],"I will both lie down in peace and sleep: for thou, Lord, only hast caused me to dwell securely."]]