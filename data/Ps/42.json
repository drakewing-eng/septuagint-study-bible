[["1",[["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114],["κρῖνόν",707905,176],["με",708618,163],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["δίκασον",703691,176],["τὴν",709436,8],["δίκην",703702,9],["μου",709032,133],["ἐξ",704132,0],["ἔθνους",704068,21],["οὐχ",709805,28],["ὁσίου",709782,92],["ἀπὸ",701425,0],["ἀνθρώπου",701163,18],["ἀδίκου",700272,116],["καὶ",707031,7],["δολίου",703783,116],["ῥῦσαί",711309,300],["με",708618,163]],"A Psalm of David. Judge me, O God, and plead my cause, against an ungodly nation: deliver me from the unjust and crafty man."],["2",[["ὅτι",709803,7],["σὺ",712181,164],["εἶ",704093,154],["ὁ",709436,3],["θεός",706192,4],["κραταίωμά",707876,15],["μου",709032,133],["ἵνα",706747,7],["τί",712867,126],["ἀπώσω",701659,165],["με",708618,163],["καὶ",707031,7],["ἵνα",706747,7],["τί",712867,126],["σκυθρωπάζων",711896,72],["πορεύομαι",710667,254],["ἐν",704639,0],["τῷ",709436,53],["ἐκθλίβειν",704199,55],["τὸν",709436,5],["ἐχθρόν",705779,6],["μου",709032,133]],"For thou, O God, art my strength: wherefore hast thou cast me off? and why do I go sad of countenance, while the enemy oppresses [me]?"],["3",[["ἐξαπόστειλον",704872,176],["τὸ",709436,24],["φῶς",713642,25],["σου",711945,133],["καὶ",707031,7],["τὴν",709436,8],["ἀλήθειάν",700656,9],["σου",711945,133],["αὐτά",702165,290],["με",708618,163],["ὡδήγησαν",709448,150],["καὶ",707031,7],["ἤγαγόν",700209,150],["με",708618,163],["εἰς",704105,0],["ὄρος",709768,25],["ἅγιόν",700159,46],["σου",711945,133],["καὶ",707031,7],["εἰς",704105,0],["τὰ",709436,41],["σκηνώματά",711849,42],["σου",711945,133]],"Send forth thy light and thy truth: they have led me, and brought me to thy holy mountain, and to thy tabernacles."],["4",[["καὶ",707031,7],["εἰσελεύσομαι",704114,181],["πρὸς",710844,0],["τὸ",709436,24],["θυσιαστήριον",706348,25],["τοῦ",709436,35],["θεοῦ",706192,18],["πρὸς",710844,0],["τὸν",709436,5],["θεὸν",706192,6],["τὸν",709436,5],["εὐφραίνοντα",705715,183],["τὴν",709436,8],["νεότητά",709258,9],["μου",709032,133],["ἐξομολογήσομαί",704960,181],["σοι",711925,159],["ἐν",704639,0],["κιθάρᾳ",707669,1],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133]],"And I will go in to the altar of God, to God who gladdens my youth: I will give thanks to thee on the harp, O God, my God."],["5",[["ἵνα",706747,7],["τί",712867,126],["περίλυπος",710346,14],["εἶ",704093,154],["ψυχή",714070,12],["καὶ",707031,7],["ἵνα",706747,7],["τί",712867,126],["συνταράσσεις",712507,154],["με",708618,163],["ἔλπισον",704529,176],["ἐπὶ",705080,0],["τὸν",709436,5],["θεόν",706192,6],["ὅτι",709803,7],["ἐξομολογήσομαι",704960,181],["αὐτῷ",702165,50],["σωτήριον",712659,15],["τοῦ",709436,35],["προσώπου",710986,21],["μου",709032,133],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133]],"Wherefore art thou very sad, O my soul? and wherefore dost thou trouble me? Hope in God; for I will give thanks to him, [who is] the health of my countenance, [and] my God."]]