[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ὑπὲρ",713111,0],["τῶν",709436,80],["υἱῶν",713075,81],["Κορε",707833,118],["ψαλμός",714022,4]],"For the end, a Psalm for the sons of Core."],["2",[["πάντα",710177,195],["τὰ",709436,63],["ἔθνη",704068,64],["κροτήσατε",707918,74],["χεῖρας",713787,39],["ἀλαλάξατε",700632,74],["τῷ",709436,113],["θεῷ",706192,114],["ἐν",704639,0],["φωνῇ",713640,1],["ἀγαλλιάσεως",700113,17]],"Clap your hands, all ye nations; shout to God with a voice of exultation."],["3",[["ὅτι",709803,7],["κύριος",707996,4],["ὕψιστος",713287,14],["φοβερός",713530,14],["βασιλεὺς",702580,4],["μέγας",708653,14],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9]],"For the Lord most high is terrible; [he is] a great king over all the earth."],["4",[["ὑπέταξεν",713250,2],["λαοὺς",708094,57],["ἡμῖν",705994,90],["καὶ",707031,7],["ἔθνη",704068,42],["ὑπὸ",713184,0],["τοὺς",709436,58],["πόδας",710707,57],["ἡμῶν",705999,145]],"He has subdued the peoples under us, and the nations under our feet."],["5",[["ἐξελέξατο",704236,23],["ἡμῖν",705994,90],["τὴν",709436,8],["κληρονομίαν",707725,9],["αὐτοῦ",702165,102],["τὴν",709436,8],["καλλονὴν",707092,9],["Ιακωβ",706401,18],["ἣν",709781,131],["ἠγάπησεν",700120,2],["διάψαλμα",703641,15]],"He has chosen out his inheritance for us, the beauty of Jacob which he loved. Pause."],["6",[["ἀνέβη",700905,2],["ὁ",709436,3],["θεὸς",706192,4],["ἐν",704639,0],["ἀλαλαγμῷ",700631,114],["κύριος",707996,4],["ἐν",704639,0],["φωνῇ",713640,1],["σάλπιγγος",711424,17]],"God is gone up with a shout, the Lord with a sound of a trumpet."],["7",[["ψάλατε",714028,74],["τῷ",709436,113],["θεῷ",706192,114],["ἡμῶν",705999,145],["ψάλατε",714028,74],["ψάλατε",714028,74],["τῷ",709436,113],["βασιλεῖ",702580,114],["ἡμῶν",705999,145],["ψάλατε",714028,74]],"Sing praises to our God, sing praises: sing praises to our King, sing praises."],["8",[["ὅτι",709803,7],["βασιλεὺς",702580,4],["πάσης",710177,82],["τῆς",709436,16],["γῆς",703083,17],["ὁ",709436,3],["θεός",706192,4],["ψάλατε",714028,74],["συνετῶς",712465,28]],"For God is king of all the earth: sing praises with understanding."],["9",[["ἐβασίλευσεν",702581,2],["ὁ",709436,3],["θεὸς",706192,4],["ἐπὶ",705080,0],["τὰ",709436,41],["ἔθνη",704068,42],["ὁ",709436,3],["θεὸς",706192,4],["κάθηται",707000,117],["ἐπὶ",705080,0],["θρόνου",706315,18],["ἁγίου",700159,116],["αὐτοῦ",702165,102]],"God reigns over the nations: God sits upon the throne of his holiness."],["10",[["ἄρχοντες",701862,52],["λαῶν",708094,81],["συνήχθησαν",712375,99],["μετὰ",708780,0],["τοῦ",709436,35],["θεοῦ",706192,18],["Αβρααμ",700091,18],["ὅτι",709803,7],["τοῦ",709436,35],["θεοῦ",706192,18],["οἱ",709436,136],["κραταιοὶ",707873,138],["τῆς",709436,16],["γῆς",703083,17],["σφόδρα",712586,28],["ἐπήρθησαν",705002,99]],"The rulers of the people are assembled with the God of Abraam: for God's mighty ones of the earth have been greatly exalted."]]