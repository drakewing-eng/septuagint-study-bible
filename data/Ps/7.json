[["1",[["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114],["ὃν",709781,112],["ᾖσεν",700299,2],["τῷ",709436,113],["κυρίῳ",707996,114],["ὑπὲρ",713111,0],["τῶν",709436,80],["λόγων",708236,81],["Χουσι",713933,18],["υἱοῦ",713075,18],["Ιεμενι",706583,18]],"A Psalm of David, which he sang to the Lord because of the words of Chusi the Benjamite."],["2",[["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["ἐπὶ",705080,0],["σοὶ",711925,159],["ἤλπισα",704529,155],["σῶσόν",712627,176],["με",708618,163],["ἐκ",704132,0],["πάντων",710177,169],["τῶν",709436,80],["διωκόντων",703768,170],["με",708618,163],["καὶ",707031,7],["ῥῦσαί",711309,300],["με",708618,163]],"O Lord my God, in thee have I trusted: save me from all them that persecute me, and deliver me."],["3",[["μήποτε",708882,28],["ἁρπάσῃ",701804,172],["ὡς",714148,7],["λέων",708171,4],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["μὴ",708851,28],["ὄντος",704093,152],["λυτρουμένου",708282,262],["μηδὲ",708855,7],["σῴζοντος",712627,152]],"Lest at any time [the enemy] seize my soul as a lion, while there is none to ransom, nor to save."],["4",[["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["εἰ",704071,7],["ἐποίησα",710582,155],["τοῦτο",709858,129],["εἰ",704071,7],["ἔστιν",704093,91],["ἀδικία",700271,12],["ἐν",704639,0],["χερσίν",713787,76],["μου",709032,133]],"O Lord my God, if I have done this; (if there is unrighteousness in my hands;)"],["5",[["εἰ",704071,7],["ἀνταπέδωκα",701215,155],["τοῖς",709436,147],["ἀνταποδιδοῦσίν",701215,349],["μοι",708974,159],["κακά",707066,68],["ἀποπέσοιν",701546,225],["ἄρα",701666,11],["ἀπὸ",701425,0],["τῶν",709436,80],["ἐχθρῶν",705779,81],["μου",709032,133],["κενός",707612,14]],"if I have requited with evil those who requited me [with good]; may I then perish empty by means of my enemies."],["6",[["καταδιώξαι",707243,300],["ἄρα",701666,11],["ὁ",709436,3],["ἐχθρὸς",705779,4],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["καὶ",707031,7],["καταλάβοι",707300,225],["καὶ",707031,7],["καταπατήσαι",707360,300],["εἰς",704105,0],["γῆν",703083,9],["τὴν",709436,8],["ζωήν",705910,9],["μου",709032,133],["καὶ",707031,7],["τὴν",709436,8],["δόξαν",703791,9],["μου",709032,133],["εἰς",704105,0],["χοῦν",713930,6],["κατασκηνώσαι",707423,300],["διάψαλμα",703641,15]],"Let the enemy persecute my soul, and take it; and let him trample my life on the ground, and lay my glory in the dust. Pause."],["7",[["ἀνάστηθι",701173,176],["κύριε",707996,153],["ἐν",704639,0],["ὀργῇ",709728,1],["σου",711945,133],["ὑψώθητι",713289,244],["ἐν",704639,0],["τοῖς",709436,95],["πέρασι",710281,96],["τῶν",709436,80],["ἐχθρῶν",705779,81],["μου",709032,133],["ἐξεγέρθητι",704889,244],["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["ἐν",704639,0],["προστάγματι",710959,54],["ᾧ",709781,209],["ἐνετείλω",704791,174]],"Arise, O Lord, in thy wrath; be exalted in the utmost boundaries of mine enemies: awake, O Lord my God, according to the decree which thou didst command."],["8",[["καὶ",707031,7],["συναγωγὴ",712376,12],["λαῶν",708094,81],["κυκλώσει",707958,127],["σε",711598,163],["καὶ",707031,7],["ὑπὲρ",713111,0],["ταύτης",709858,86],["εἰς",704105,0],["ὕψος",713288,25],["ἐπίστρεψον",705278,176]],"And the congregation of the nations shall compass thee: and for this cause do thou return on high."],["9",[["κύριος",707996,4],["κρινεῖ",707905,127],["λαούς",708094,57],["κρῖνόν",707905,176],["με",708618,163],["κύριε",707996,153],["κατὰ",707200,0],["τὴν",709436,8],["δικαιοσύνην",703695,9],["μου",709032,133],["καὶ",707031,7],["κατὰ",707200,0],["τὴν",709436,8],["ἀκακίαν",700511,9],["μου",709032,133],["ἐπ᾿",705080,0],["ἐμοί",704577,159]],"The Lord shall judge the nations: judge me, O Lord, according to my righteousness, and according to my innocence that is in me."],["10",[["συντελεσθήτω",712510,22],["δὴ",703395,11],["πονηρία",710659,12],["ἁμαρτωλῶν",700776,169],["καὶ",707031,7],["κατευθυνεῖς",707521,166],["δίκαιον",703694,27],["ἐτάζων",705526,72],["καρδίας",707141,39],["καὶ",707031,7],["νεφροὺς",709282,57],["ὁ",709436,3],["θεός",706192,4]],"Oh let the wickedness of sinners come to an end; and [then] thou shalt direct the righteous, O God that searchest the hearts and reins."],["11",[["δικαία",703694,29],["ἡ",709436,10],["βοήθειά",702745,12],["μου",709032,133],["παρὰ",709995,0],["τοῦ",709436,35],["θεοῦ",706192,18],["τοῦ",709436,35],["σῴζοντος",712627,152],["τοὺς",709436,58],["εὐθεῖς",705602,60],["τῇ",709436,100],["καρδίᾳ",707141,1]],"My help is righteous, [coming] from God who saves the upright in heart."],["12",[["ὁ",709436,3],["θεὸς",706192,4],["κριτὴς",707910,4],["δίκαιος",703694,14],["καὶ",707031,7],["ἰσχυρὸς",706855,14],["καὶ",707031,7],["μακρόθυμος",708420,14],["μὴ",708851,28],["ὀργὴν",709728,9],["ἐπάγων",704994,72],["καθ᾿",707200,0],["ἑκάστην",704133,36],["ἡμέραν",705984,9]],"God is a righteous judge, and strong, and patient, not inflicting vengeance every day."],["13",[["ἐὰν",703912,7],["μὴ",708851,28],["ἐπιστραφῆτε",705278,394],["τὴν",709436,8],["ῥομφαίαν",711291,9],["αὐτοῦ",702165,102],["στιλβώσει",712106,127],["τὸ",709436,24],["τόξον",712898,25],["αὐτοῦ",702165,102],["ἐνέτεινεν",704790,2],["καὶ",707031,7],["ἡτοίμασεν",705539,2],["αὐτὸ",702165,129]],"If ye will not repent, he will furbish his sword; he has bent his bow, and made it ready."],["14",[["καὶ",707031,7],["ἐν",704639,0],["αὐτῷ",702165,50],["ἡτοίμασεν",705539,2],["σκεύη",711844,42],["θανάτου",706096,18],["τὰ",709436,41],["βέλη",702644,42],["αὐτοῦ",702165,102],["τοῖς",709436,147],["καιομένοις",707049,341],["ἐξειργάσατο",704902,23]],"And on it he has fitted the instruments of death; he has completed his arrows for the raging ones."],["15",[["ἰδοὺ",706497,88],["ὠδίνησεν",714095,2],["ἀδικίαν",700271,9],["συνέλαβεν",712262,2],["πόνον",710661,6],["καὶ",707031,7],["ἔτεκεν",712853,2],["ἀνομίαν",701192,9]],"Behold, he has travailed with unrighteousness, he has conceived trouble, and brought forth iniquity."],["16",[["λάκκον",708067,6],["ὤρυξεν",709775,2],["καὶ",707031,7],["ἀνέσκαψεν",701051,2],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐμπεσεῖται",704593,93],["εἰς",704105,0],["βόθρον",702749,6],["ὃν",709781,112],["εἰργάσατο",705383,23]],"He has opened a pit, and dug it up, and he shall fall into the ditch which he has made."],["17",[["ἐπιστρέψει",705278,127],["ὁ",709436,3],["πόνος",710661,4],["αὐτοῦ",702165,102],["εἰς",704105,0],["κεφαλὴν",707639,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπὶ",705080,0],["κορυφὴν",707844,9],["αὐτοῦ",702165,102],["ἡ",709436,10],["ἀδικία",700271,12],["αὐτοῦ",702165,102],["καταβήσεται",707202,93]],"His trouble shall return on his own head, and his unrighteousness shall come down on his own crown."],["18",[["ἐξομολογήσομαι",704960,181],["κυρίῳ",707996,114],["κατὰ",707200,0],["τὴν",709436,8],["δικαιοσύνην",703695,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ψαλῶ",714021,165],["τῷ",709436,53],["ὀνόματι",709666,54],["κυρίου",707996,18],["τοῦ",709436,35],["ὑψίστου",713287,116]],"I will give thanks to the Lord according to his righteousness; I will sing to the name of the Lord most high."]]