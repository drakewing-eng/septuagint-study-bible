[["1",[["συνέσεως",712460,17],["τῷ",709436,113],["Δαυιδ",703232,114],["ἐν",704639,0],["τῷ",709436,53,20],["εἶναι",704093,55],["αὐτὸν",702165,556],["ἐν",704639,0],["τῷ",709436,53],["σπηλαίῳ",712012,54],["προσευχή",710892,12]],"[A Psalm] of instruction for David, when he was in the cave,—a Prayer."],["2",[["φωνῇ",713640,1],["μου",709032,133],["πρὸς",710844,0],["κύριον",707996,6],["ἐκέκραξα",707868,155],["φωνῇ",713640,1],["μου",709032,133],["πρὸς",710844,0],["κύριον",707996,6],["ἐδεήθην",703394,156]],"I cried to the Lord with my voice; with my voice I made supplication to the Lord."],["3",[["ἐκχεῶ",704368,165],["ἐναντίον",704654,0],["αὐτοῦ",702165,559],["τὴν",709436,8],["δέησίν",703311,9],["μου",709032,133],["τὴν",709436,8],["θλῖψίν",706276,9],["μου",709032,133],["ἐνώπιον",704823,0],["αὐτοῦ",702165,559],["ἀπαγγελῶ",701321,165]],"I will pour out before him my supplication: I will declare before him mine affliction."],["4",[["ἐν",704639,0],["τῷ",709436,53,20],["ἐκλείπειν",704237,55],["ἐξ",704132,0],["ἐμοῦ",704580,133],["τὸ",709436,24],["πνεῦμά",710566,25],["μου",709032,133],["καὶ",707031,7],["σὺ",712181,164],["ἔγνως",703105,162],["τὰς",709436,38],["τρίβους",712939,39],["μου",709032,133],["ἐν",704639,0],["ὁδῷ",709458,1],["ταύτῃ",709858,105],["ᾗ",709781,108],["ἐπορευόμην",710667,334],["ἔκρυψαν",707923,150],["παγίδα",709910,9],["μοι",708974,159]],"When my spirit was fainting within me, then thou knewest my paths; in the very way wherein I was walking, they hid a snare for me."],["5",[["κατενόουν",707341,137],["εἰς",704105,0],["τὰ",709436,41],["δεξιὰ",703360,68],["καὶ",707031,7],["ἐπέβλεπον",705088,333],["ὅτι",709803,7],["οὐκ",709805,28],["ἦν",704093,13],["ὁ",709436,3],["ἐπιγινώσκων",705104,72],["με",708618,163],["ἀπώλετο",701513,23],["φυγὴ",713609,12],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ὁ",709436,3],["ἐκζητῶν",704187,72],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133]],"I looked on [my] right hand, and behold,