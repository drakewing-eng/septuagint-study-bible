[["1",[["τῷ",709436,113],["Δαυιδ",703232,114],["ὁπότε",709709,28],["ἠλλοίωσεν",700694,2],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["ἐναντίον",704654,0],["Αβιμελεχ",700068,18],["καὶ",707031,7],["ἀπέλυσεν",701524,2],["αὐτόν",702165,85],["καὶ",707031,7],["ἀπῆλθεν",701398,2]],"[A Psalm] of David, when he changed his countenance before Abimelech; and he let him go, and he departed."],["2",[["εὐλογήσω",705631,165],["τὸν",709436,5],["κύριον",707996,6],["ἐν",704639,0],["παντὶ",710177,30],["καιρῷ",707047,114],["διὰ",703417,0],["παντὸς",710177,116],["ἡ",709436,10],["αἴνεσις",700457,12],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,53],["στόματί",712125,54],["μου",709032,133]],"I will bless the Lord at all times: his praise shall be continually in my mouth."],["3",[["ἐν",704639,0],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐπαινεσθήσεται",705000,134],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ἀκουσάτωσαν",700587,264],["πραεῖς",710725,138],["καὶ",707031,7],["εὐφρανθήτωσαν",705715,51]],"My soul shall boast herself in the Lord: let the meek hear, and rejoice."],["4",[["μεγαλύνατε",708647,74],["τὸν",709436,5],["κύριον",707996,6],["σὺν",712372,0],["ἐμοί",704577,159],["καὶ",707031,7],["ὑψώσωμεν",713289,79],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτό",702165,129]],"Magnify ye the Lord with me, and let us exalt his name together."],["5",[["ἐξεζήτησα",704187,155],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["ἐπήκουσέν",705009,2],["μου",709032,133],["καὶ",707031,7],["ἐκ",704132,0],["πασῶν",710177,198],["τῶν",709436,130],["παροικιῶν",710158,65],["μου",709032,133],["ἐρρύσατό",711309,23],["με",708618,163]],"I sought the Lord diligently, and he hearkened to me, and delivered me from all my sojournings."],["6",[["προσέλθατε",710890,74],["πρὸς",710844,0],["αὐτὸν",702165,85],["καὶ",707031,7],["φωτίσθητε",713646,372],["καὶ",707031,7],["τὰ",709436,63],["πρόσωπα",710986,64],["ὑμῶν",713091,145],["οὐ",709805,28],["μὴ",708851,28],["καταισχυνθῇ",707257,384]],"Draw near to him, and be enlightened: and your faces shall not [by any means] be ashamed."],["7",[["οὗτος",709858,121],["ὁ",709436,3],["πτωχὸς",711076,4],["ἐκέκραξεν",707868,2],["καὶ",707031,7],["ὁ",709436,3],["κύριος",707996,4],["εἰσήκουσεν",704108,2],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐκ",704132,0],["πασῶν",710177,198],["τῶν",709436,130],["θλίψεων",706276,65],["αὐτοῦ",702165,102],["ἔσωσεν",712627,2],["αὐτόν",702165,85]],"This poor man cried, and the Lord hearkened to him, and delivered him out of all his afflictions."],["8",[["παρεμβαλεῖ",710132,127],["ἄγγελος",700140,4],["κυρίου",707996,18],["κύκλῳ",707959,114],["τῶν",709436,80],["φοβουμένων",713532,299],["αὐτὸν",702165,85],["καὶ",707031,7],["ῥύσεται",711309,93],["αὐτούς",702165,62]],"The angel of the Lord will encamp round about them that fear him, and will deliver them."],["9",[["γεύσασθε",703074,186],["καὶ",707031,7],["ἴδετε",709725,74],["ὅτι",709803,7],["χρηστὸς",713958,14],["ὁ",709436,3],["κύριος",707996,4],["μακάριος",708397,14],["ἀνήρ",701150,4],["ὃς",709781,213],["ἐλπίζει",704529,91],["ἐπ᾿",705080,0],["αὐτόν",702165,85]],"Taste and see that the Lord is good: blessed is the man who hopes in him."],["10",[["φοβήθητε",713532,372],["τὸν",709436,5],["κύριον",707996,6],["οἱ",709436,136],["ἅγιοι",700159,138],["αὐτοῦ",702165,102],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ὑστέρημα",713271,15],["τοῖς",709436,147],["φοβουμένοις",713532,341],["αὐτόν",702165,85]],"Fear the Lord, all ye his saints: for there is no want to them that fear him."],["11",[["πλούσιοι",710560,138],["ἐπτώχευσαν",711074,150],["καὶ",707031,7],["ἐπείνασαν",710222,150],["οἱ",709436,136],["δὲ",703303,11],["ἐκζητοῦντες",704187,146],["τὸν",709436,5],["κύριον",707996,6],["οὐκ",709805,28],["ἐλαττωθήσονται",704387,144],["παντὸς",710177,116],["ἀγαθοῦ",700106,116],["διάψαλμα",703641,15]],"The rich have become poor and hungry: but they that seek the Lord diligently shall not want any good thing. Pause."],["12",[["δεῦτε",703383,28],["τέκνα",712761,64],["ἀκούσατέ",700587,74],["μου",709032,133],["φόβον",713534,6],["κυρίου",707996,18],["διδάξω",703649,165],["ὑμᾶς",713080,194]],"Come, ye children, hear me: I will teach you the fear of the Lord."],["13",[["τίς",712867,158],["ἐστιν",704093,91],["ἄνθρωπος",701163,4],["ὁ",709436,3],["θέλων",706176,72],["ζωὴν",705910,9],["ἀγαπῶν",700120,72],["ἡμέρας",705984,39],["ἰδεῖν",709725,106],["ἀγαθάς",700106,119]],"What man is there that desires life, loving to see good days?"],["14",[["παῦσον",710202,176],["τὴν",709436,8],["γλῶσσάν",703120,9],["σου",711945,133],["ἀπὸ",701425,0],["κακοῦ",707066,92],["καὶ",707031,7],["χείλη",713781,42],["σου",711945,133],["τοῦ",709436,20],["μὴ",708851,28],["λαλῆσαι",708071,106],["δόλον",703787,6]],"Keep thy tongue from evil, and thy lips from speaking guile."],["15",[["ἔκκλινον",704220,176],["ἀπὸ",701425,0],["κακοῦ",707066,92],["καὶ",707031,7],["ποίησον",710582,176],["ἀγαθόν",700106,46],["ζήτησον",705879,176],["εἰρήνην",704098,9],["καὶ",707031,7],["δίωξον",703768,176],["αὐτήν",702165,104]],"Turn away from evil, and do good; seek peace, and pursue it."],["16",[["ὀφθαλμοὶ",709870,52],["κυρίου",707996,18],["ἐπὶ",705080,0],["δικαίους",703694,60],["καὶ",707031,7],["ὦτα",709852,42],["αὐτοῦ",702165,102],["εἰς",704105,0],["δέησιν",703311,9],["αὐτῶν",702165,40]],"The eyes of the Lord are over the righteous, and his ears [are open] to their prayer:"],["17",[["πρόσωπον",710986,15],["δὲ",703303,11],["κυρίου",707996,18],["ἐπὶ",705080,0],["ποιοῦντας",710582,235],["κακὰ",707066,68],["τοῦ",709436,20],["ἐξολεθρεῦσαι",704956,106],["ἐκ",704132,0],["γῆς",703083,17],["τὸ",709436,24],["μνημόσυνον",708966,25],["αὐτῶν",702165,40]],"but the face of the Lord is against them that do evil, to destroy their memorial from the earth. The righteous cried, and the Lord hearkened to them,"],["18",[["ἐκέκραξαν",707868,150],["οἱ",709436,136],["δίκαιοι",703694,138],["καὶ",707031,7],["ὁ",709436,3],["κύριος",707996,4],["εἰσήκουσεν",704108,2],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐκ",704132,0],["πασῶν",710177,198],["τῶν",709436,130],["θλίψεων",706276,65],["αὐτῶν",702165,40],["ἐρρύσατο",711309,23],["αὐτούς",702165,62]],"and delivered them out of all their afflictions."],["19",[["ἐγγὺς",703948,28],["κύριος",707996,4],["τοῖς",709436,147],["συντετριμμένοις",712520,521],["τὴν",709436,8],["καρδίαν",707141,9],["καὶ",707031,7],["τοὺς",709436,58],["ταπεινοὺς",712714,60],["τῷ",709436,53],["πνεύματι",710566,54],["σώσει",712627,127]],"The Lord is near to them that are of a contrite heart; and will save the lowly in spirit."],["20",[["πολλαὶ",710646,192],["αἱ",709436,190],["θλίψεις",706276,191],["τῶν",709436,80],["δικαίων",703694,169],["καὶ",707031,7],["ἐκ",704132,0],["πασῶν",710177,198],["αὐτῶν",702165,284],["ῥύσεται",711309,93],["αὐτούς",702165,62]],"Many are the afflictions of the righteous: but out of them all the Lord will deliver them."],["21",[["κύριος",707996,4],["φυλάσσει",713619,91],["πάντα",710177,68],["τὰ",709436,41],["ὀστᾶ",709792,42],["αὐτῶν",702165,40],["ἓν",704106,46],["ἐξ",704132,0],["αὐτῶν",702165,70],["οὐ",709805,28],["συντριβήσεται",712520,134]],"He keeps all their bones: not one of them shall be broken."],["22",[["θάνατος",706096,4],["ἁμαρτωλῶν",700776,169],["πονηρός",710660,14],["καὶ",707031,7],["οἱ",709436,136],["μισοῦντες",708935,146],["τὸν",709436,5],["δίκαιον",703694,27],["πλημμελήσουσιν",710534,218]],"The death of sinners is evil: and they that hate righteousness will go wrong."],["23",[["λυτρώσεται",708282,93],["κύριος",707996,4],["ψυχὰς",714070,39],["δούλων",703817,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["πλημμελήσωσιν",710534,234],["πάντες",710177,138],["οἱ",709436,136],["ἐλπίζοντες",704529,146],["ἐπ᾿",705080,0],["αὐτόν",702165,85]],"The Lord will redeem the souls of his servants: and none of those that hope in him shall go wrong."]]