[["1",[["προσευχὴ",710892,12],["τῷ",709436,113],["πτωχῷ",711076,114],["ὅταν",709801,28],["ἀκηδιάσῃ",700539,172],["καὶ",707031,7],["ἐναντίον",704654,0],["κυρίου",707996,18],["ἐκχέῃ",704368,204],["τὴν",709436,8],["δέησιν",703311,9],["αὐτοῦ",702165,559]],"A Prayer for the Poor; when he is deeply afflicted, and pours out his supplication before the Lord."],["2",[["εἰσάκουσον",704108,176],["κύριε",707996,153],["τῆς",709436,16],["προσευχῆς",710892,17],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["κραυγή",707886,12],["μου",709032,133],["πρὸς",710844,0],["σὲ",711598,163],["ἐλθάτω",705453,45]],"Hear my prayer, O Lord, and let my cry come to thee."],["3",[["μὴ",708851,28],["ἀποστρέψῃς",701598,175],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["ἐν",704639,0],["ᾗ",709781,108],["ἂν",700900,11],["ἡμέρᾳ",705984,1],["θλίβωμαι",706274,386],["κλῖνον",707738,47],["τὸ",709436,24],["οὖς",709852,25],["σου",711945,133],["πρός",710844,0],["με",708618,163],["ἐν",704639,0],["ᾗ",709781,108],["ἂν",700900,11],["ἡμέρᾳ",705984,1],["ἐπικαλέσωμαί",705153,410],["σε",711598,163],["ταχὺ",712748,28],["εἰσάκουσόν",704108,176],["μου",709032,133]],"Turn not away thy face from me: in the day [when] I am afflicted, incline thine ear to me: in the day [when] I shall call upon thee, speedily hear me."],["4",[["ὅτι",709803,7],["ἐξέλιπον",704237,150],["ὡσεὶ",714159,11],["καπνὸς",707132,4],["αἱ",709436,190],["ἡμέραι",705984,191],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,63],["ὀστᾶ",709792,64],["μου",709032,133],["ὡσεὶ",714159,11],["φρύγιον",713602,15],["συνεφρύγησαν",712362,150]],"For my days have vanished like smoke, and my bones have been parched like a stick."],["5",[["ἐπλήγη",710527,12],["ὡσεὶ",714159,11],["χόρτος",713923,4],["καὶ",707031,7],["ἐξηράνθη",709419,37],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["ὅτι",709803,7],["ἐπελαθόμην",705187,161],["τοῦ",709436,20],["φαγεῖν",713296,106],["τὸν",709436,5],["ἄρτον",701829,6],["μου",709032,133]],"I am blighted like grass, and my heart is dried up; for I have forgotten to eat my bread."],["6",[["ἀπὸ",701425,0],["φωνῆς",713640,17],["τοῦ",709436,35],["στεναγμοῦ",712065,18],["μου",709032,133],["ἐκολλήθη",707791,37],["τὸ",709436,34],["ὀστοῦν",709792,15],["μου",709032,133],["τῇ",709436,100],["σαρκί",711537,1],["μου",709032,133]],"By reason of the voice of my groaning, my bone has cleaved to my flesh."],["7",[["ὡμοιώθην",709628,156],["πελεκᾶνι",710234,114],["ἐρημικῷ",705418,30],["ἐγενήθην",703104,156],["ὡσεὶ",714159,11],["νυκτικόραξ",709377,4],["ἐν",704639,0],["οἰκοπέδῳ",709515,54]],"I have become like a pelican of the wilderness;"],["8",[["ἠγρύπνησα",700197,155],["καὶ",707031,7],["ἐγενήθην",703104,156],["ὡσεὶ",714159,11],["στρουθίον",712166,25],["μονάζον",708991,47],["ἐπὶ",705080,0],["δώματι",703896,54]],"I have become like an owl in a ruined house. I have watched, and am become as a sparrow dwelling alone on a roof."],["9",[["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["ὠνείδιζόν",709655,137],["με",708618,163],["οἱ",709436,136],["ἐχθροί",705779,52],["μου",709032,133],["καὶ",707031,7],["οἱ",709436,136],["ἐπαινοῦντές",705000,146],["με",708618,163],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["ὤμνυον",709620,137]],"All the day long mine enemies have reproached me; and they that praised me have sworn against me."],["10",[["ὅτι",709803,7],["σποδὸν",712022,9],["ὡσεὶ",714159,11],["ἄρτον",701829,6],["ἔφαγον",713296,155],["καὶ",707031,7],["τὸ",709436,24],["πόμα",710654,25],["μου",709032,133],["μετὰ",708780,0],["κλαυθμοῦ",707705,18],["ἐκίρνων",707688,333]],"For I have eaten ashes as it were bread, and mingled my drink with weeping;"],["11",[["ἀπὸ",701425,0],["προσώπου",710986,21],["τῆς",709436,16],["ὀργῆς",709728,17],["σου",711945,133],["καὶ",707031,7],["τοῦ",709436,35],["θυμοῦ",706334,18],["σου",711945,133],["ὅτι",709803,7],["ἐπάρας",705002,162],["κατέρραξάς",707405,162],["με",708618,163]],"because of thine anger and thy wrath: for thou hast lifted me up, and dashed me down."],["12",[["αἱ",709436,190],["ἡμέραι",705984,191],["μου",709032,133],["ὡσεὶ",714159,11],["σκιὰ",711852,12],["ἐκλίθησαν",707738,99],["καὶ",707031,7],["ἐγὼ",704018,164],["ὡσεὶ",714159,11],["χόρτος",713923,4],["ἐξηράνθην",709419,156]],"My days have declined like a shadow; and I am withered like grass."],["13",[["σὺ",712181,164],["δέ",703303,11],["κύριε",707996,153],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["μένεις",708736,154],["καὶ",707031,7],["τὸ",709436,34],["μνημόσυνόν",708966,15],["σου",711945,133],["εἰς",704105,0],["γενεὰν",703037,9],["καὶ",707031,7],["γενεάν",703037,9]],"But thou, Lord, endurest for ever, and thy memorial to generation and generation."],["14",[["σὺ",712181,164],["ἀναστὰς",701173,182],["οἰκτιρήσεις",709518,166],["τὴν",709436,8],["Σιων",711816,9],["ὅτι",709803,7],["καιρὸς",707047,4],["τοῦ",709436,20],["οἰκτιρῆσαι",709518,106],["αὐτήν",702165,104],["ὅτι",709803,7],["ἥκει",705956,91],["καιρός",707047,4]],"Thou shalt arise, and have mercy upon Sion: for [it is] time to have mercy upon her, for the set time is come."],["15",[["ὅτι",709803,7],["εὐδόκησαν",705565,150],["οἱ",709436,136],["δοῦλοί",703817,52],["σου",711945,133],["τοὺς",709436,58],["λίθους",708196,57],["αὐτῆς",702165,86],["καὶ",707031,7],["τὸν",709436,5],["χοῦν",713930,6],["αὐτῆς",702165,86],["οἰκτιρήσουσιν",709518,218]],"For thy servants have taken pleasure in her stones, and they shall pity her dust."],["16",[["καὶ",707031,7],["φοβηθήσονται",713532,144],["τὰ",709436,63],["ἔθνη",704068,64],["τὸ",709436,24],["ὄνομα",709666,25],["κυρίου",707996,18],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["βασιλεῖς",702580,52],["τῆς",709436,16],["γῆς",703083,17],["τὴν",709436,8],["δόξαν",703791,9],["σου",711945,133]],"So the nations shall fear thy name, O Lord, and all kings thy glory."],["17",[["ὅτι",709803,7],["οἰκοδομήσει",709509,127],["κύριος",707996,4],["τὴν",709436,8],["Σιων",711816,9],["καὶ",707031,7],["ὀφθήσεται",709725,134],["ἐν",704639,0],["τῇ",709436,100],["δόξῃ",703791,1],["αὐτοῦ",702165,102]],"For the Lord shall build up Sion, and shall appear in his glory."],["18",[["ἐπέβλεψεν",705088,2],["ἐπὶ",705080,0],["τὴν",709436,8],["προσευχὴν",710892,9],["τῶν",709436,80],["ταπεινῶν",712714,169],["καὶ",707031,7],["οὐκ",709805,28],["ἐξουδένωσεν",704969,2],["τὴν",709436,8],["δέησιν",703311,9],["αὐτῶν",702165,40]],"He has had regard to the prayer of the lowly, and has not despised their petition."],["19",[["γραφήτω",703194,22],["αὕτη",709858,107],["εἰς",704105,0],["γενεὰν",703037,9],["ἑτέραν",705535,36],["καὶ",707031,7],["λαὸς",708094,4],["ὁ",709436,3],["κτιζόμενος",707938,122],["αἰνέσει",700457,1],["τὸν",709436,5],["κύριον",707996,6]],"Let this be written for another generation; and the people that shall be created shall praise the Lord."],["20",[["ὅτι",709803,7],["ἐξέκυψεν",704229,2],["ἐξ",704132,0],["ὕψους",713288,21],["ἁγίου",700159,92],["αὐτοῦ",702165,102],["κύριος",707996,4],["ἐξ",704132,0],["οὐρανοῦ",709844,18],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["ἐπέβλεψεν",705088,2]],"For he has looked out from the height of his sanctuary; the Lord looked upon the earth from heaven;"],["21",[["τοῦ",709436,20],["ἀκοῦσαι",700587,106],["τὸν",709436,5],["στεναγμὸν",712065,6],["τῶν",709436,80],["πεπεδημένων",710208,445],["τοῦ",709436,20],["λῦσαι",708288,106],["τοὺς",709436,58],["υἱοὺς",713075,57],["τῶν",709436,80],["τεθανατωμένων",706097,445]],"to hear the groaning of the fettered ones, to loosen the sons of the slain;"],["22",[["τοῦ",709436,20],["ἀναγγεῖλαι",700921,106],["ἐν",704639,0],["Σιων",711816,1],["τὸ",709436,24],["ὄνομα",709666,25],["κυρίου",707996,18],["καὶ",707031,7],["τὴν",709436,8],["αἴνεσιν",700457,9],["αὐτοῦ",702165,102],["ἐν",704639,0],["Ιερουσαλημ",706644,1]],"to proclaim the name of the Lord in Sion, and his praise in Jerusalem;"],["23",[["ἐν",704639,0],["τῷ",709436,53],["συναχθῆναι",712375,179],["λαοὺς",708094,57],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτὸ",702165,129],["καὶ",707031,7],["βασιλείας",702577,17],["τοῦ",709436,20],["δουλεύειν",703814,55],["τῷ",709436,113],["κυρίῳ",707996,114]],"when the people are gathered together, and the kings, to serve the Lord."],["24",[["ἀπεκρίθη",701492,37],["αὐτῷ",702165,50],["ἐν",704639,0],["ὁδῷ",709458,1],["ἰσχύος",706858,17],["αὐτοῦ",702165,102],["τὴν",709436,8],["ὀλιγότητα",709570,9],["τῶν",709436,130],["ἡμερῶν",705984,65],["μου",709032,133],["ἀνάγγειλόν",700921,176],["μοι",708974,159]],"He answered him in the way of his strength: tell me the fewness of my days."],["25",[["μὴ",708851,28],["ἀναγάγῃς",700933,175],["με",708618,163],["ἐν",704639,0],["ἡμίσει",705998,30],["ἡμερῶν",705984,65],["μου",709032,133],["ἐν",704639,0],["γενεᾷ",703037,1],["γενεῶν",703037,65],["τὰ",709436,41],["ἔτη",705543,42],["σου",711945,133]],"Take me not away in the midst of my days: thy years [are] through all generations."],["26",[["κατ᾿",707200,0],["ἀρχὰς",701836,39],["σύ",712181,164],["κύριε",707996,153],["τὴν",709436,8],["γῆν",703083,9],["ἐθεμελίωσας",706182,162],["καὶ",707031,7],["ἔργα",705396,64],["τῶν",709436,80],["χειρῶν",713787,65],["σού",711945,133],["εἰσιν",704093,197],["οἱ",709436,136],["οὐρανοί",709844,52]],"In the beginning thou, O Lord, didst lay the foundation of the earth; and the heavens are the works of thine hands."],["27",[["αὐτοὶ",702165,201],["ἀπολοῦνται",701513,135],["σὺ",712181,164],["δὲ",703303,11],["διαμενεῖς",703517,166],["καὶ",707031,7],["πάντες",710177,138],["ὡς",714148,11],["ἱμάτιον",706742,15],["παλαιωθήσονται",709937,144],["καὶ",707031,7],["ὡσεὶ",714159,11],["περιβόλαιον",710300,25],["ἀλλάξεις",700683,166],["αὐτούς",702165,62],["καὶ",707031,7],["ἀλλαγήσονται",700683,144]],"They shall perish, but thou remainest: and [they all] shall wax old as a garment; and as a vesture shalt thou fold them, and they shall be changed."],["28",[["σὺ",712181,164],["δὲ",703303,11],["ὁ",709436,3],["αὐτὸς",702165,121],["εἶ",704093,154],["καὶ",707031,7],["τὰ",709436,63],["ἔτη",705543,64],["σου",711945,133],["οὐκ",709805,28],["ἐκλείψουσιν",704237,218]],"But thou art the same, and thy years shall not fail."],["29",[["οἱ",709436,136],["υἱοὶ",713075,52],["τῶν",709436,80],["δούλων",703817,81],["σου",711945,133],["κατασκηνώσουσιν",707423,218],["καὶ",707031,7],["τὸ",709436,34],["σπέρμα",712008,15],["αὐτῶν",702165,40],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["κατευθυνθήσεται",707521,134]],"The children of thy servants shall dwell [securely], and their seed shall prosper for ever."]]