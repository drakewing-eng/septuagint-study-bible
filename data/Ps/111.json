[["1",[["αλληλουια",700688,88],["μακάριος",708397,14],["ἀνὴρ",701150,4],["ὁ",709436,3],["φοβούμενος",713532,122],["τὸν",709436,5],["κύριον",707996,6],["ἐν",704639,0],["ταῖς",709436,75],["ἐντολαῖς",704802,76],["αὐτοῦ",702165,102],["θελήσει",706176,127],["σφόδρα",712586,28]],"Alleluia. Blessed is the man that fears the Lord: he will delight greatly in his commandments."],["2",[["δυνατὸν",703845,27],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ἔσται",704093,93],["τὸ",709436,34],["σπέρμα",712008,15],["αὐτοῦ",702165,102],["γενεὰ",703037,12],["εὐθείων",705602,198],["εὐλογηθήσεται",705631,134]],"His seed shall be mighty in the earth: the generation of the upright shall be blessed."],["3",[["δόξα",703791,12],["καὶ",707031,7],["πλοῦτος",710563,4],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἡ",709436,10],["δικαιοσύνη",703695,12],["αὐτοῦ",702165,102],["μένει",708736,91],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18]],"Glory and riches shall be in his house; and his righteousness endures for evermore."],["4",[["ἐξανέτειλεν",704863,2],["ἐν",704639,0],["σκότει",711889,54],["φῶς",713642,25],["τοῖς",709436,147],["εὐθέσιν",705602,230],["ἐλεήμων",704422,14],["καὶ",707031,7],["οἰκτίρμων",709521,14],["καὶ",707031,7],["δίκαιος",703694,14]],"To the upright light has sprung up in darkness: he is pitiful, and merciful, and righteous."],["5",[["χρηστὸς",713958,14],["ἀνὴρ",701150,4],["ὁ",709436,3],["οἰκτίρων",709518,72],["καὶ",707031,7],["κιχρῶν",707700,72],["οἰκονομήσει",709512,127],["τοὺς",709436,58],["λόγους",708236,57],["αὐτοῦ",702165,102],["ἐν",704639,0],["κρίσει",707908,1]],"The good man is he that pities and lends: he will direct his affairs with judgment."],["6",[["ὅτι",709803,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["οὐ",709805,28],["σαλευθήσεται",711403,134],["εἰς",704105,0],["μνημόσυνον",708966,25],["αἰώνιον",700505,27],["ἔσται",704093,93],["δίκαιος",703694,14]],"For he shall not be moved for ever; the righteous shall be in everlasting remembrance."],["7",[["ἀπὸ",701425,0],["ἀκοῆς",700561,17],["πονηρᾶς",710660,82],["οὐ",709805,28],["φοβηθήσεται",713532,134],["ἑτοίμη",705541,29],["ἡ",709436,10],["καρδία",707141,12],["αὐτοῦ",702165,102],["ἐλπίζειν",704529,55],["ἐπὶ",705080,0],["κύριον",707996,6]],"He shall not be afraid of [any] evil report: his heart is ready to trust in the Lord."],["8",[["ἐστήρικται",712098,187],["ἡ",709436,10],["καρδία",707141,12],["αὐτοῦ",702165,102],["οὐ",709805,28],["μὴ",708851,28],["φοβηθῇ",713532,384],["ἕως",705792,0],["οὗ",709781,48],["ἐπίδῃ",705118,204],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἐχθροὺς",705779,57],["αὐτοῦ",702165,102]],"His heart is established, he shall not fear, till he shall see [his desire] upon his enemies."],["9",[["ἐσκόρπισεν",711881,2],["ἔδωκεν",703654,2],["τοῖς",709436,147],["πένησιν",710248,148],["ἡ",709436,10],["δικαιοσύνη",703695,12],["αὐτοῦ",702165,102],["μένει",708736,91],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18],["τὸ",709436,24],["κέρας",707625,25],["αὐτοῦ",702165,102],["ὑψωθήσεται",713289,134],["ἐν",704639,0],["δόξῃ",703791,1]],"He has dispersed abroad; he has given to the poor; his righteousness endures for evermore: his horn shall be exalted with honour."],["10",[["ἁμαρτωλὸς",700776,14],["ὄψεται",709725,93],["καὶ",707031,7],["ὀργισθήσεται",709729,134],["τοὺς",709436,58],["ὀδόντας",709461,57],["αὐτοῦ",702165,102],["βρύξει",702822,127],["καὶ",707031,7],["τακήσεται",712839,93],["ἐπιθυμία",705147,12],["ἁμαρτωλῶν",700776,169],["ἀπολεῖται",701513,93]],"The sinner shall see and be angry, he shall gnash his teeth, and consume away: the desire of the sinner shall perish."]]