[["1",[["τῷ",709436,113],["Δαυιδ",703232,114],["ψαλμός",714022,4],["εἶπεν",705373,2],["ὁ",709436,3],["κύριος",707996,4],["τῷ",709436,113],["κυρίῳ",707996,114],["μου",709032,133],["κάθου",707000,253],["ἐκ",704132,0],["δεξιῶν",703360,169],["μου",709032,133],["ἕως",705792,0],["ἂν",700900,11],["θῶ",712849,207],["τοὺς",709436,58],["ἐχθρούς",705779,57],["σου",711945,133],["ὑποπόδιον",713233,25],["τῶν",709436,80],["ποδῶν",710707,81],["σου",711945,133]],"A Psalm of David. The Lord said to my Lord, Sit thou on my right hand, until I make thine enemies thy footstool."],["2",[["ῥάβδον",711135,9],["δυνάμεώς",703839,17],["σου",711945,133],["ἐξαποστελεῖ",704872,127],["κύριος",707996,4],["ἐκ",704132,0],["Σιων",711816,17],["καὶ",707031,7],["κατακυρίευε",707297,240],["ἐν",704639,0],["μέσῳ",708768,30],["τῶν",709436,80],["ἐχθρῶν",705779,81],["σου",711945,133]],"The Lord shall send out a rod of power for thee out of Sion: rule thou in the midst of thine enemies."],["3",[["μετὰ",708780,0],["σοῦ",711945,133],["ἡ",709436,10],["ἀρχὴ",701836,12],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["τῆς",709436,16],["δυνάμεώς",703839,17],["σου",711945,133],["ἐν",704639,0],["ταῖς",709436,75],["λαμπρότησιν",708083,76],["τῶν",709436,80],["ἁγίων",700159,169],["ἐκ",704132,0],["γαστρὸς",702976,17],["πρὸ",710747,0],["ἑωσφόρου",705793,18],["ἐξεγέννησά",704158,155],["σε",711598,163]],"With thee is dominion in the day of thy power, in the splendours of thy saints: I have begotten thee from the womb before the morning."],["4",[["ὤμοσεν",709620,2],["κύριος",707996,4],["καὶ",707031,7],["οὐ",709805,28],["μεταμεληθήσεται",708805,134],["σὺ",712181,164],["εἶ",704093,154],["ἱερεὺς",706614,4],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["κατὰ",707200,0],["τὴν",709436,8],["τάξιν",712712,9],["Μελχισεδεκ",708717,18]],"The Lord sware, and will not repent, Thou art a priest for ever, after the order of Melchisedec."],["5",[["κύριος",707996,4],["ἐκ",704132,0],["δεξιῶν",703360,169],["σου",711945,133],["συνέθλασεν",712479,2],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["ὀργῆς",709728,17],["αὐτοῦ",702165,102],["βασιλεῖς",702580,52]],"The Lord at thy right hand has dashed in pieces kings in the day of his wrath."],["6",[["κρινεῖ",707905,127],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["πληρώσει",710543,127],["πτώματα",711071,42],["συνθλάσει",712479,127],["κεφαλὰς",707639,39],["ἐπὶ",705080,0],["γῆς",703083,17],["πολλῶν",710646,169]],"He shall judge among the nations, he shall fill up [the number of] corpses, he shall crush the heads of many on the earth."],["7",[["ἐκ",704132,0],["χειμάρρου",713783,18],["ἐν",704639,0],["ὁδῷ",709458,1],["πίεται",710478,93],["διὰ",703417,0],["τοῦτο",709858,129],["ὑψώσει",713289,127],["κεφαλήν",707639,9]],"He shall drink of the brook in the way; therefore shall he lift up the head."]]