[["1",[["ᾠδὴ",714091,12],["ψαλμοῦ",714022,18],["τῷ",709436,113],["Δαυιδ",703232,114]],"Song of a Psalm by David."],["2",[["ἑτοίμη",705541,29],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["ὁ",709436,3],["θεός",706192,4],["ἑτοίμη",705541,29],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["ᾄσομαι",700299,181],["καὶ",707031,7],["ψαλῶ",714021,165],["ἐν",704639,0],["τῇ",709436,100],["δόξῃ",703791,1],["μου",709032,133]],"O God, my heart is ready, my heart is ready; I will sing and sing psalms with my glory."],["3",[["ἐξεγέρθητι",704889,244],["ψαλτήριον",714023,15],["καὶ",707031,7],["κιθάρα",707669,12],["ἐξεγερθήσομαι",704889,180],["ὄρθρου",709745,18]],"Awake, psaltery and harp; I will awake early."],["4",[["ἐξομολογήσομαί",704960,181],["σοι",711925,159],["ἐν",704639,0],["λαοῖς",708094,148],["κύριε",707996,153],["καὶ",707031,7],["ψαλῶ",714021,165],["σοι",711925,159],["ἐν",704639,0],["ἔθνεσιν",704068,96]],"I will give thanks to thee, O Lord, among the people; I will sing praise to thee among the Gentiles."],["5",[["ὅτι",709803,7],["μέγα",708653,26],["ἐπάνω",705030,28],["τῶν",709436,80],["οὐρανῶν",709844,81],["τὸ",709436,34],["ἔλεός",704426,15],["σου",711945,133],["καὶ",707031,7],["ἕως",705792,0],["τῶν",709436,130],["νεφελῶν",709277,65],["ἡ",709436,10],["ἀλήθειά",700656,12],["σου",711945,133]],"For thy mercy is great above the heavens, and thy truth [reaches] to the clouds."],["6",[["ὑψώθητι",713289,244],["ἐπὶ",705080,0],["τοὺς",709436,58],["οὐρανούς",709844,57],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9],["ἡ",709436,10],["δόξα",703791,12],["σου",711945,133]],"Be thou exalted, O God, above the heavens; and thy glory above all the earth."],["7",[["ὅπως",709719,7],["ἂν",700900,11],["ῥυσθῶσιν",711309,731],["οἱ",709436,136],["ἀγαπητοί",700124,138],["σου",711945,133],["σῶσον",712627,176],["τῇ",709436,100],["δεξιᾷ",703360,101],["σου",711945,133],["καὶ",707031,7],["ἐπάκουσόν",705009,176],["μου",709032,133]],"That thy beloved [ones] may be delivered, save with thy right hand, and hear me. God has spoken in his sanctuary;"],["8",[["ὁ",709436,3],["θεὸς",706192,4],["ἐλάλησεν",708071,2],["ἐν",704639,0],["τῷ",709436,113],["ἁγίῳ",700159,30],["αὐτοῦ",702165,102],["ὑψωθήσομαι",713289,180],["καὶ",707031,7],["διαμεριῶ",703518,165],["Σικιμα",711783,9],["καὶ",707031,7],["τὴν",709436,8],["κοιλάδα",707758,9],["τῶν",709436,130],["σκηνῶν",711845,65],["διαμετρήσω",703520,165]],"I will be exalted, and will divide Sicima, and will measure out the valley of tents."],["9",[["ἐμός",704578,14],["ἐστιν",704093,91],["Γαλααδ",702920,12],["καὶ",707031,7],["ἐμός",704578,14],["ἐστιν",704093,91],["Μανασση",708470,4],["καὶ",707031,7],["Εφραιμ",705769,4],["ἀντίλημψις",701247,12],["τῆς",709436,16],["κεφαλῆς",707639,17],["μου",709032,133],["Ιουδας",706775,4],["βασιλεύς",702580,4],["μου",709032,133]],"Galaad is mine; and Manasses is mine; and Ephraim is the help of mine head; Judas is my king;"],["10",[["Μωαβ",709085,4],["λέβης",708121,4],["τῆς",709436,16],["ἐλπίδος",704530,17],["μου",709032,133],["ἐπὶ",705080,0],["τὴν",709436,8],["Ιδουμαίαν",706503,9],["ἐκτενῶ",704322,165],["τὸ",709436,24],["ὑπόδημά",713195,25],["μου",709032,133],["ἐμοὶ",704577,159],["ἀλλόφυλοι",700706,138],["ὑπετάγησαν",713250,150]],"Moab is the caldron of my hope; over Idumea will I cast my sandal; the Philistines are made subject to me."],["11",[["τίς",712867,158],["ἀπάξει",701324,127],["με",708618,163],["εἰς",704105,0],["πόλιν",710612,9],["περιοχῆς",710360,17],["τίς",712867,158],["ὁδηγήσει",709448,127],["με",708618,163],["ἕως",705792,0],["τῆς",709436,16],["Ιδουμαίας",706503,17]],"Who will bring me into the fortified city? or who will guide me to Idumea?"],["12",[["οὐχὶ",709862,28],["σύ",712181,164],["ὁ",709436,3],["θεός",706192,4],["ὁ",709436,3],["ἀπωσάμενος",701659,248],["ἡμᾶς",705981,194],["καὶ",707031,7],["οὐκ",709805,28],["ἐξελεύσῃ",704909,123],["ὁ",709436,3],["θεός",706192,4],["ἐν",704639,0],["ταῖς",709436,75],["δυνάμεσιν",703839,76],["ἡμῶν",705999,145]],"Wilt not thou, O God, who hast rejected us? and wilt not thou, O God, go forth with our hosts?"],["13",[["δὸς",703654,176],["ἡμῖν",705994,90],["βοήθειαν",702745,9],["ἐκ",704132,0],["θλίψεως",706276,17],["καὶ",707031,7],["ματαία",708575,29],["σωτηρία",712658,12],["ἀνθρώπου",701163,18]],"Give us help from tribulation: for vain is the help of man."],["14",[["ἐν",704639,0],["τῷ",709436,113],["θεῷ",706192,114],["ποιήσομεν",710582,275],["δύναμιν",703839,9],["καὶ",707031,7],["αὐτὸς",702165,121],["ἐξουδενώσει",704969,127],["τοὺς",709436,58],["ἐχθροὺς",705779,57],["ἡμῶν",705999,145]],"Through God we shall do valiantly; and he will bring to nought our enemies."]]