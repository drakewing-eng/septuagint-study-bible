[["1",[["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114],["ὁπότε",709709,28],["ἀπεδίδρασκεν",701448,13],["ἀπὸ",701425,0],["προσώπου",710986,21],["Αβεσσαλωμ",700052,18],["τοῦ",709436,35],["υἱοῦ",713075,18],["αὐτοῦ",702165,102]],"A Psalm of David, when he fled from the presence of his son Abessalom."],["2",[["κύριε",707996,153],["τί",712867,126],["ἐπληθύνθησαν",710530,99],["οἱ",709436,136],["θλίβοντές",706274,146],["με",708618,163],["πολλοὶ",710646,138],["ἐπανίστανται",705026,269],["ἐπ᾿",705080,0],["ἐμέ",704555,163]],"O Lord, why are they that afflict me multiplied? many rise up against me."],["3",[["πολλοὶ",710646,138],["λέγουσιν",708124,197],["τῇ",709436,100],["ψυχῇ",714070,1],["μου",709032,133],["οὐκ",709805,28],["ἔστιν",704093,91],["σωτηρία",712658,12],["αὐτῷ",702165,50],["ἐν",704639,0],["τῷ",709436,113],["θεῷ",706192,114],["αὐτοῦ",702165,102],["διάψαλμα",703641,15]],"Many say concerning my soul, There is no deliverance for him in his God. Pause."],["4",[["σὺ",712181,164],["δέ",703303,11],["κύριε",707996,153],["ἀντιλήμπτωρ",701246,4],["μου",709032,133],["εἶ",704093,154],["δόξα",703791,12],["μου",709032,133],["καὶ",707031,7],["ὑψῶν",713289,72],["τὴν",709436,8],["κεφαλήν",707639,9],["μου",709032,133]],"But thou, O Lord, art my helper: my glory, and the one that lifts up my head."],["5",[["φωνῇ",713640,1],["μου",709032,133],["πρὸς",710844,0],["κύριον",707996,6],["ἐκέκραξα",707868,155],["καὶ",707031,7],["ἐπήκουσέν",705009,2],["μου",709032,133],["ἐξ",704132,0],["ὄρους",709768,21],["ἁγίου",700159,92],["αὐτοῦ",702165,102],["διάψαλμα",703641,15]],"I cried to the Lord with my voice, and he heard me out of his holy mountain. Pause."],["6",[["ἐγὼ",704018,164],["ἐκοιμήθην",707767,156],["καὶ",707031,7],["ὕπνωσα",713182,155],["ἐξηγέρθην",704889,156],["ὅτι",709803,7],["κύριος",707996,4],["ἀντιλήμψεταί",701243,93],["μου",709032,133]],"I lay down and slept; I awaked; for the Lord will help me."],["7",[["οὐ",709805,28],["φοβηθήσομαι",713532,180],["ἀπὸ",701425,0],["μυριάδων",709062,65],["λαοῦ",708094,18],["τῶν",709436,80],["κύκλῳ",707959,114],["συνεπιτιθεμένων",712453,299],["μοι",708974,159]],"I will not be afraid of ten thousands of people, who beset me round about."],["8",[["ἀνάστα",701173,176],["κύριε",707996,153],["σῶσόν",712627,176],["με",708618,163],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["ὅτι",709803,7],["σὺ",712181,164],["ἐπάταξας",710185,162],["πάντας",710177,60],["τοὺς",709436,58],["ἐχθραίνοντάς",705776,454],["μοι",708974,159],["ματαίως",708579,28],["ὀδόντας",709461,57],["ἁμαρτωλῶν",700776,169],["συνέτριψας",712520,162]],"Arise, Lord; deliver me, my God: for thou hast smitten all who were without cause mine enemies; thou hast broken the teeth of sinners."],["9",[["τοῦ",709436,35],["κυρίου",707996,18],["ἡ",709436,10],["σωτηρία",712658,12],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133],["ἡ",709436,10],["εὐλογία",705633,12],["σου",711945,133]],"Deliverance is the Lord's, and thy blessing is upon thy people."]]