[["1",[["τῷ",709436,113],["Δαυιδ",703232,114],["ἐξομολογήσομαί",704960,181],["σοι",711925,159],["κύριε",707996,153],["ἐν",704639,0],["ὅλῃ",709597,101],["καρδίᾳ",707141,1],["μου",709032,133],["ὅτι",709803,7],["ἤκουσας",700587,162],["τὰ",709436,41],["ῥήματα",711246,42],["τοῦ",709436,20],["στόματός",712125,21],["μου",709032,133],["καὶ",707031,7],["ἐναντίον",704654,0],["ἀγγέλων",700140,81],["ψαλῶ",714021,165],["σοι",711925,159]],"A Psalm for David, of Aggæus and Zacharias. I will give thee thanks, O Lord, with my whole heart; and I will sing psalms to thee before the angels; for thou hast heard all the words of my mouth."],["2",[["προσκυνήσω",710925,207],["πρὸς",710844,0],["ναὸν",709191,6],["ἅγιόν",700159,27],["σου",711945,133],["καὶ",707031,7],["ἐξομολογήσομαι",704960,181],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["ἐπὶ",705080,0],["τῷ",709436,53],["ἐλέει",704426,54],["σου",711945,133],["καὶ",707031,7],["τῇ",709436,100],["ἀληθείᾳ",700656,1],["σου",711945,133],["ὅτι",709803,7],["ἐμεγάλυνας",708647,162],["ἐπὶ",705080,0],["πᾶν",710177,46],["ὄνομα",709666,25],["τὸ",709436,24],["λόγιόν",708233,25],["σου",711945,133]],"I will worship toward thy holy temple, and give thanks to thy name, on account of thy mercy and thy truth; for thou hast magnified thy holy name above every thing."],["3",[["ἐν",704639,0],["ᾗ",709781,108],["ἂν",700900,11],["ἡμέρᾳ",705984,1],["ἐπικαλέσωμαί",705153,410],["σε",711598,163],["ταχὺ",712748,46],["ἐπάκουσόν",705009,176],["μου",709032,133],["πολυωρήσεις",710653,166],["με",708618,163],["ἐν",704639,0],["ψυχῇ",714070,1],["μου",709032,133],["ἐν",704639,0],["δυνάμει",703839,1]],"In whatsoever day I shall call upon thee, hear me speedily; thou shalt abundantly provide me with thy power in my soul."],["4",[["ἐξομολογησάσθωσάν",704960,486],["σοι",711925,159],["κύριε",707996,153],["πάντες",710177,138],["οἱ",709436,136],["βασιλεῖς",702580,52],["τῆς",709436,16],["γῆς",703083,17],["ὅτι",709803,7],["ἤκουσαν",700587,150],["πάντα",710177,68],["τὰ",709436,41],["ῥήματα",711246,42],["τοῦ",709436,20],["στόματός",712125,21],["σου",711945,133]],"Let all the kings of the earth, O Lord, give thanks unto thee; for they have heard all the words of thy mouth."],["5",[["καὶ",707031,7],["ᾀσάτωσαν",700299,264],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["κυρίου",707996,18],["ὅτι",709803,7],["μεγάλη",708653,29],["ἡ",709436,10],["δόξα",703791,12],["κυρίου",707996,18]],"And let them sing in the ways of the Lord; for great is the glory of the Lord."],["6",[["ὅτι",709803,7],["ὑψηλὸς",713285,14],["κύριος",707996,4],["καὶ",707031,7],["τὰ",709436,41],["ταπεινὰ",712714,68],["ἐφορᾷ",713551,1],["καὶ",707031,7],["τὰ",709436,41],["ὑψηλὰ",713285,68],["ἀπὸ",701425,0],["μακρόθεν",708417,28],["γινώσκει",703105,91]],"For the Lord is high, and [yet] regards the lowly; and he knows high things from afar off."],["7",[["ἐὰν",703912,7],["πορευθῶ",710667,321],["ἐν",704639,0],["μέσῳ",708768,30],["θλίψεως",706276,17],["ζήσεις",705851,166],["με",708618,163],["ἐπ᾿",705080,0],["ὀργὴν",709728,9],["ἐχθρῶν",705779,81],["μου",709032,133],["ἐξέτεινας",704322,162],["χεῖρά",713787,9],["σου",711945,133],["καὶ",707031,7],["ἔσωσέν",712627,2],["με",708618,163],["ἡ",709436,10],["δεξιά",703360,68],["σου",711945,133]],"Though I should walk in the midst of affliction, thou wilt quicken me; thou hast stretched forth thine hands against the wrath of mine enemies, and thy right hand has saved me."],["8",[["κύριος",707996,4],["ἀνταποδώσει",701215,127],["ὑπὲρ",713111,0],["ἐμοῦ",704580,133],["κύριε",707996,153],["τὸ",709436,34],["ἔλεός",704426,4],["σου",711945,133],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τὰ",709436,41],["ἔργα",705396,42],["τῶν",709436,130],["χειρῶν",713787,65],["σου",711945,133],["μὴ",708851,28],["παρῇς",710126,205]],"O Lord, thou shalt recompense [them] on my behalf: thy mercy, O Lord, [endures] for ever: overlook not the works of thine hands."]]