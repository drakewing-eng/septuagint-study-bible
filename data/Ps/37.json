[["1",[["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114],["εἰς",704105,0],["ἀνάμνησιν",701004,9],["περὶ",710285,0],["σαββάτου",711350,21]],"A Psalm of David for remembrance concerning the Sabbath-day."],["2",[["κύριε",707996,153],["μὴ",708851,28],["τῷ",709436,113],["θυμῷ",706334,114],["σου",711945,133],["ἐλέγξῃς",704416,175],["με",708618,163],["μηδὲ",708855,7],["τῇ",709436,100],["ὀργῇ",709728,1],["σου",711945,133],["παιδεύσῃς",709926,175],["με",708618,163]],"O Lord, rebuke me not in thy wrath, neither chasten me in thine anger."],["3",[["ὅτι",709803,7],["τὰ",709436,63],["βέλη",702644,64],["σου",711945,133],["ἐνεπάγησάν",704590,99],["μοι",708974,159],["καὶ",707031,7],["ἐπεστήρισας",705270,162],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133]],"For thy weapons are fixed in me, and thou hast pressed thy hand heavily upon me."],["4",[["οὐκ",709805,28],["ἔστιν",704093,91],["ἴασις",706444,12],["ἐν",704639,0],["τῇ",709436,100],["σαρκί",711537,1],["μου",709032,133],["ἀπὸ",701425,0],["προσώπου",710986,21],["τῆς",709436,16],["ὀργῆς",709728,17],["σου",711945,133],["οὐκ",709805,28],["ἔστιν",704093,91],["εἰρήνη",704098,12],["τοῖς",709436,95],["ὀστέοις",709792,96],["μου",709032,133],["ἀπὸ",701425,0],["προσώπου",710986,21],["τῶν",709436,130],["ἁμαρτιῶν",700775,65],["μου",709032,133]],"For there is no health in my flesh because of thine anger; there is no peace to my bones because of my sins."],["5",[["ὅτι",709803,7],["αἱ",709436,190],["ἀνομίαι",701192,191],["μου",709032,133],["ὑπερῆραν",713116,150],["τὴν",709436,8],["κεφαλήν",707639,9],["μου",709032,133],["ὡσεὶ",714159,28],["φορτίον",713563,25],["βαρὺ",702554,46],["ἐβαρύνθησαν",702553,99],["ἐπ᾿",705080,0],["ἐμέ",704555,163]],"For my transgressions have gone over mine head: they have pressed heavily upon me like a weighty burden."],["6",[["προσώζεσαν",710940,150],["καὶ",707031,7],["ἐσάπησαν",711754,150],["οἱ",709436,136],["μώλωπές",709099,52],["μου",709032,133],["ἀπὸ",701425,0],["προσώπου",710986,21],["τῆς",709436,16],["ἀφροσύνης",702235,17],["μου",709032,133]],"My bruises have become noisome and corrupt, because of my foolishness."],["7",[["ἐταλαιπώρησα",712694,155],["καὶ",707031,7],["κατεκάμφθην",707261,156],["ἕως",705792,0],["τέλους",712787,21],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["σκυθρωπάζων",711896,72],["ἐπορευόμην",710667,334]],"I have been wretched and bowed down continually: I went with a mourning countenance all the day."],["8",[["ὅτι",709803,7],["αἱ",709436,190],["ψύαι",714065,191],["μου",709032,133],["ἐπλήσθησαν",710532,99],["ἐμπαιγμῶν",704582,81],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἴασις",706444,12],["ἐν",704639,0],["τῇ",709436,100],["σαρκί",711537,1],["μου",709032,133]],"For my soul is filled with mockings; and there is no health in my flesh."],["9",[["ἐκακώθην",707073,156],["καὶ",707031,7],["ἐταπεινώθην",712717,156],["ἕως",705792,0],["σφόδρα",712586,28],["ὠρυόμην",714142,334],["ἀπὸ",701425,0],["στεναγμοῦ",712065,18],["τῆς",709436,16],["καρδίας",707141,17],["μου",709032,133]],"I have been afflicted and brought down exceedingly: I have roared for the groaning of my heart."],["10",[["κύριε",707996,153],["ἐναντίον",704654,0],["σου",711945,133],["πᾶσα",710177,29],["ἡ",709436,10],["ἐπιθυμία",705147,12],["μου",709032,133],["καὶ",707031,7],["ὁ",709436,3],["στεναγμός",712065,4],["μου",709032,133],["ἀπὸ",701425,0],["σοῦ",711945,133],["οὐκ",709805,28],["ἐκρύβη",707923,37]],"But all my desire is before thee; and my groaning is not hidden from thee."],["11",[["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["ἐταράχθη",712721,37],["ἐγκατέλιπέν",703967,2],["με",708618,163],["ἡ",709436,10],["ἰσχύς",706858,12],["μου",709032,133],["καὶ",707031,7],["τὸ",709436,34],["φῶς",713642,15],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["μου",709032,133],["καὶ",707031,7],["αὐτὸ",702165,132],["οὐκ",709805,28],["ἔστιν",704093,91],["μετ᾿",708780,0],["ἐμοῦ",704580,133]],"My heart is troubled, my strength has failed me; and the light of mine eyes is not with me."],["12",[["οἱ",709436,136],["φίλοι",713492,138],["μου",709032,133],["καὶ",707031,7],["οἱ",709436,136],["πλησίον",710547,28],["μου",709032,133],["ἐξ",704132,0],["ἐναντίας",704656,82],["μου",709032,133],["ἤγγισαν",703939,150],["καὶ",707031,7],["ἔστησαν",706846,150],["καὶ",707031,7],["οἱ",709436,136],["ἔγγιστά",703940,28],["μου",709032,133],["ἀπὸ",701425,0],["μακρόθεν",708417,28],["ἔστησαν",706846,150]],"My friends and my neighbours drew near before me, and stood still; and my nearest of kin stood afar off."],["13",[["καὶ",707031,7],["ἐξεβιάσαντο",704149,189],["οἱ",709436,136],["ζητοῦντες",705879,146],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["καὶ",707031,7],["οἱ",709436,136],["ζητοῦντες",705879,146],["τὰ",709436,41],["κακά",707066,68],["μοι",708974,159],["ἐλάλησαν",708071,150],["ματαιότητας",708576,39],["καὶ",707031,7],["δολιότητας",703784,39],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["ἐμελέτησαν",708698,150]],"While they pressed hard upon me that sought my soul: and they that sought my hurt spoke vanities, and devised deceits all the day."],["14",[["ἐγὼ",704018,164],["δὲ",703303,11],["ὡσεὶ",714159,28],["κωφὸς",708033,14],["οὐκ",709805,28],["ἤκουον",700587,137],["καὶ",707031,7],["ὡσεὶ",714159,28],["ἄλαλος",700633,14],["οὐκ",709805,28],["ἀνοίγων",701186,72],["τὸ",709436,24],["στόμα",712125,25],["αὐτοῦ",702165,102]],"But I, as a deaf man, heard not; and was as a dumb man not opening his mouth."],["15",[["καὶ",707031,7],["ἐγενόμην",703104,161],["ὡσεὶ",714159,28],["ἄνθρωπος",701163,4],["οὐκ",709805,28],["ἀκούων",700587,72],["καὶ",707031,7],["οὐκ",709805,28],["ἔχων",705785,72],["ἐν",704639,0],["τῷ",709436,53],["στόματι",712125,54],["αὐτοῦ",702165,102],["ἐλεγμούς",704413,57]],"And I was as a man that hears not, and who has no reproofs in his mouth."],["16",[["ὅτι",709803,7],["ἐπὶ",705080,0],["σοί",711925,159],["κύριε",707996,153],["ἤλπισα",704529,155],["σὺ",712181,164],["εἰσακούσῃ",704108,172],["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133]],"For I hoped in thee, O Lord: thou wilt hear, O Lord my God."],["17",[["ὅτι",709803,7],["εἶπα",705373,155],["μήποτε",708882,28],["ἐπιχαρῶσίν",705330,272],["μοι",708974,159],["οἱ",709436,136],["ἐχθροί",705779,52],["μου",709032,133],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["σαλευθῆναι",711403,179],["πόδας",710707,57],["μου",709032,133],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ἐμεγαλορρημόνησαν",708637,150]],"For I said, Lest mine enemies rejoice against me: for when my feet were moved, they spoke boastingly against me."],["18",[["ὅτι",709803,7],["ἐγὼ",704018,164],["εἰς",704105,0],["μάστιγας",708568,39],["ἕτοιμος",705541,14],["καὶ",707031,7],["ἡ",709436,10],["ἀλγηδών",700639,12],["μου",709032,133],["ἐνώπιόν",704823,0],["μου",709032,133],["διὰ",703417,0],["παντός",710177,116]],"For I am ready for plagues, and my grief is continually before me."],["19",[["ὅτι",709803,7],["τὴν",709436,8],["ἀνομίαν",701192,9],["μου",709032,133],["ἐγὼ",704018,164],["ἀναγγελῶ",700921,165],["καὶ",707031,7],["μεριμνήσω",708746,165],["ὑπὲρ",713111,0],["τῆς",709436,16],["ἁμαρτίας",700775,17],["μου",709032,133]],"For I will declare mine iniquity, and be distressed for my sin."],["20",[["οἱ",709436,136],["δὲ",703303,11],["ἐχθροί",705779,52],["μου",709032,133],["ζῶσιν",705851,197],["καὶ",707031,7],["κεκραταίωνται",707875,255],["ὑπὲρ",713111,0],["ἐμέ",704555,163],["καὶ",707031,7],["ἐπληθύνθησαν",710530,99],["οἱ",709436,136],["μισοῦντές",708935,146],["με",708618,163],["ἀδίκως",700273,28]],"But mine enemies live, and are mightier than I: and they that hate me unjustly are multiplied."],["21",[["οἱ",709436,136],["ἀνταποδιδόντες",701215,146],["κακὰ",707066,68],["ἀντὶ",701227,0],["ἀγαθῶν",700106,169],["ἐνδιέβαλλόν",704686,137],["με",708618,163],["ἐπεὶ",705054,7],["κατεδίωκον",707243,137],["δικαιοσύνην",703695,9],["καὶ",707031,7],["ἀπέρριψάν",701563,150],["με",708618,163],["τὸν",709436,5],["ἀγαπητὸν",700124,27],["ὡσεὶ",714159,28],["νεκρὸν",709247,6],["ἐβδελυγμένον",702608,439]],"They that reward evil for good slandered me; because I followed righteousness.",{"s":"d","q":0.56}],["22",[["μὴ",708851,28],["ἐγκαταλίπῃς",703967,175],["με",708618,163],["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["μὴ",708851,28],["ἀποστῇς",702214,175],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133]],"Forsake me not, O Lord my God: depart not from me."],["23",[["πρόσχες",710895,176],["εἰς",704105,0],["τὴν",709436,8],["βοήθειάν",702745,9],["μου",709032,133],["κύριε",707996,153],["τῆς",709436,16],["σωτηρίας",712658,17],["μου",709032,133]],"Draw nigh to my help, O Lord of my salvation."]]