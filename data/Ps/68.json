[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ὑπὲρ",713111,0],["τῶν",709436,80],["ἀλλοιωθησομένων",700694,728],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, [a Psalm] of David, for alternate [strains]."],["2",[["σῶσόν",712627,176],["με",708618,163],["ὁ",709436,3],["θεός",706192,4],["ὅτι",709803,7],["εἰσήλθοσαν",704114,150],["ὕδατα",713071,25],["ἕως",705792,0],["ψυχῆς",714070,17],["μου",709032,133]],"Save me, O God; for the waters have come in to my soul."],["3",[["ἐνεπάγην",704590,156],["εἰς",704105,0],["ἰλὺν",706736,9],["βυθοῦ",702830,18],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ὑπόστασις",713241,12],["ἦλθον",705453,155],["εἰς",704105,0],["τὰ",709436,41],["βάθη",702376,42],["τῆς",709436,16],["θαλάσσης",706069,17],["καὶ",707031,7],["καταιγὶς",707254,12],["κατεπόντισέν",707385,2],["με",708618,163]],"I am stuck fast in deep mire, and there is no standing: I am come in to the depths of the sea, and a storm has overwhelmed me."],["4",[["ἐκοπίασα",707824,155],["κράζων",707868,72],["ἐβραγχίασεν",702803,2],["ὁ",709436,3],["λάρυγξ",708098,4],["μου",709032,133],["ἐξέλιπον",704237,150],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["μου",709032,133],["ἀπὸ",701425,0],["τοῦ",709436,20],["ἐλπίζειν",704529,55],["ἐπὶ",705080,0],["τὸν",709436,5],["θεόν",706192,6],["μου",709032,133]],"I am weary [of] crying, my throat has become hoarse; mine eyes have failed by my waiting on my God."],["5",[["ἐπληθύνθησαν",710530,99],["ὑπὲρ",713111,0],["τὰς",709436,38],["τρίχας",706312,39],["τῆς",709436,16],["κεφαλῆς",707639,17],["μου",709032,133],["οἱ",709436,136],["μισοῦντές",708935,146],["με",708618,163],["δωρεάν",703901,9],["ἐκραταιώθησαν",707875,99],["οἱ",709436,136],["ἐχθροί",705779,52],["μου",709032,133],["οἱ",709436,136],["ἐκδιώκοντές",704178,146],["με",708618,163],["ἀδίκως",700273,28],["ἃ",709781,69],["οὐχ",709805,28],["ἥρπασα",701804,155],["τότε",712908,28],["ἀπετίννυον",701617,137]],"They that hate me without a cause are more than the hairs of my head: my enemies that persecute me unrighteously are strengthened: then I restored that which I took not away."],["6",[["ὁ",709436,3],["θεός",706192,4],["σὺ",712181,164],["ἔγνως",703105,162],["τὴν",709436,8],["ἀφροσύνην",702235,9],["μου",709032,133],["καὶ",707031,7],["αἱ",709436,190],["πλημμέλειαί",710533,191],["μου",709032,133],["ἀπὸ",701425,0],["σοῦ",711945,133],["οὐκ",709805,28],["ἐκρύβησαν",707923,99]],"O God, thou knowest my foolishness; and my transgressions are not hidden from thee."],["7",[["μὴ",708851,28],["αἰσχυνθείησαν",700485,393],["ἐπ᾿",705080,0],["ἐμοὶ",704577,159],["οἱ",709436,136],["ὑπομένοντές",713219,146],["σε",711598,163],["κύριε",707996,153],["κύριε",707996,153],["τῶν",709436,130],["δυνάμεων",703839,65],["μὴ",708851,28],["ἐντραπείησαν",704805,393],["ἐπ᾿",705080,0],["ἐμοὶ",704577,159],["οἱ",709436,136],["ζητοῦντές",705879,146],["σε",711598,163],["ὁ",709436,3],["θεὸς",706192,4],["τοῦ",709436,35],["Ισραηλ",706839,18]],"Let not them that wait on thee, O Lord of hosts, be ashamed on my account: let not them that seek thee, be ashamed on my account, O God of Israel."],["8",[["ὅτι",709803,7],["ἕνεκα",704709,0],["σοῦ",711945,133],["ὑπήνεγκα",713256,155],["ὀνειδισμόν",709657,6],["ἐκάλυψεν",707102,2],["ἐντροπὴ",704809,12],["τὸ",709436,24],["πρόσωπόν",710986,25],["μου",709032,133]],"For I have suffered reproach for thy sake; shame has covered my face."],["9",[["ἀπηλλοτριωμένος",701334,251],["ἐγενήθην",703104,156],["τοῖς",709436,147],["ἀδελφοῖς",700249,148],["μου",709032,133],["καὶ",707031,7],["ξένος",709415,14],["τοῖς",709436,147],["υἱοῖς",713075,148],["τῆς",709436,16],["μητρός",708892,17],["μου",709032,133]],"I became strange to my brethren, and a stranger to my mother's children."],["10",[["ὅτι",709803,7],["ὁ",709436,3],["ζῆλος",705871,4],["τοῦ",709436,35],["οἴκου",709516,18],["σου",711945,133],["κατέφαγέν",707519,2],["με",708618,163],["καὶ",707031,7],["οἱ",709436,136],["ὀνειδισμοὶ",709657,52],["τῶν",709436,80],["ὀνειδιζόντων",709655,170],["σε",711598,163],["ἐπέπεσαν",705225,150],["ἐπ᾿",705080,0],["ἐμέ",704555,163]],"For the zeal of thine house has eaten me up; and the reproaches of them that reproached thee are fallen upon me."],["11",[["καὶ",707031,7],["συνέκαμψα",712202,155],["ἐν",704639,0],["νηστείᾳ",709303,1],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["καὶ",707031,7],["ἐγενήθη",703104,37],["εἰς",704105,0],["ὀνειδισμὸν",709657,6],["ἐμοί",704577,159]],"And I bowed down my soul with fasting, and that was made my reproach."],["12",[["καὶ",707031,7],["ἐθέμην",712849,161],["τὸ",709436,24],["ἔνδυμά",704698,25],["μου",709032,133],["σάκκον",711386,6],["καὶ",707031,7],["ἐγενόμην",703104,161],["αὐτοῖς",702165,151],["εἰς",704105,0],["παραβολήν",710003,9]],"And I put on sackcloth for my covering; and I became a proverb to them."],["13",[["κατ᾿",707200,0],["ἐμοῦ",704580,133],["ἠδολέσχουν",700281,137],["οἱ",709436,136],["καθήμενοι",707000,348],["ἐν",704639,0],["πύλῃ",711082,1],["καὶ",707031,7],["εἰς",704105,0],["ἐμὲ",704555,163],["ἔψαλλον",714021,137],["οἱ",709436,136],["πίνοντες",710478,146],["τὸν",709436,5],["οἶνον",709530,6]],"They that sit in the gate talked against me, and they that drank wine sang against me."],["14",[["ἐγὼ",704018,164],["δὲ",703303,11],["τῇ",709436,100],["προσευχῇ",710892,1],["μου",709032,133],["πρὸς",710844,0],["σέ",711598,163],["κύριε",707996,153],["καιρὸς",707047,4],["εὐδοκίας",705566,17],["ὁ",709436,3],["θεός",706192,4],["ἐν",704639,0],["τῷ",709436,53],["πλήθει",710529,54],["τοῦ",709436,20],["ἐλέους",704426,21],["σου",711945,133],["ἐπάκουσόν",705009,176],["μου",709032,133],["ἐν",704639,0],["ἀληθείᾳ",700656,1],["τῆς",709436,16],["σωτηρίας",712658,17],["σου",711945,133]],"But I [will cry] to thee, O Lord, in my prayer; O God, it is a propitious time: in the multitude of thy mercy hear me, in the truth of thy salvation."],["15",[["σῶσόν",712627,176],["με",708618,163],["ἀπὸ",701425,0],["πηλοῦ",710457,18],["ἵνα",706747,7],["μὴ",708851,28],["ἐμπαγῶ",704590,321],["ῥυσθείην",711309,727],["ἐκ",704132,0],["τῶν",709436,80],["μισούντων",708935,170],["με",708618,163],["καὶ",707031,7],["ἐκ",704132,0],["τοῦ",709436,20],["βάθους",702376,21],["τῶν",709436,43],["ὑδάτων",713071,44]],"Save me from the mire, that I stick not [in it]: let me be delivered from them that hate me, and from the deep waters."],["16",[["μή",708851,28],["με",708618,163],["καταποντισάτω",707385,45],["καταιγὶς",707254,12],["ὕδατος",713071,21],["μηδὲ",708855,7],["καταπιέτω",707374,45],["με",708618,163],["βυθός",702830,4],["μηδὲ",708855,7],["συσχέτω",712469,45],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["φρέαρ",713576,25],["τὸ",709436,34],["στόμα",712125,15],["αὐτοῦ",702165,102]],"Let not the waterflood drown me, nor let the deep swallow me up; neither let the well shut its mouth upon me."],["17",[["εἰσάκουσόν",704108,176],["μου",709032,133],["κύριε",707996,153],["ὅτι",709803,7],["χρηστὸν",713958,26],["τὸ",709436,34],["ἔλεός",704426,15],["σου",711945,133],["κατὰ",707200,0],["τὸ",709436,24],["πλῆθος",710529,25],["τῶν",709436,80],["οἰκτιρμῶν",709520,81],["σου",711945,133],["ἐπίβλεψον",705088,176],["ἐπ᾿",705080,0],["ἐμέ",704555,163]],"Hear me, O Lord; for thy mercy is good: according to the multitude of thy compassions look upon me."],["18",[["μὴ",708851,28],["ἀποστρέψῃς",701598,175],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["ἀπὸ",701425,0],["τοῦ",709436,35],["παιδός",709932,18],["σου",711945,133],["ὅτι",709803,7],["θλίβομαι",706274,254],["ταχὺ",712748,46],["ἐπάκουσόν",705009,176],["μου",709032,133]],"And turn not away thy face from thy servant; for I am afflicted: hear me speedily."],["19",[["πρόσχες",710895,176],["τῇ",709436,100],["ψυχῇ",714070,1],["μου",709032,133],["καὶ",707031,7],["λύτρωσαι",708282,300],["αὐτήν",702165,104],["ἕνεκα",704709,0],["τῶν",709436,80],["ἐχθρῶν",705779,81],["μου",709032,133],["ῥῦσαί",711309,300],["με",708618,163]],"Draw nigh to my soul and redeem it: deliver me because of mine enemies."],["20",[["σὺ",712181,164],["γὰρ",702963,11],["γινώσκεις",703105,154],["τὸν",709436,5],["ὀνειδισμόν",709657,6],["μου",709032,133],["καὶ",707031,7],["τὴν",709436,8],["αἰσχύνην",700483,9],["μου",709032,133],["καὶ",707031,7],["τὴν",709436,8],["ἐντροπήν",704809,9],["μου",709032,133],["ἐναντίον",704654,0],["σου",711945,133],["πάντες",710177,138],["οἱ",709436,136],["θλίβοντές",706274,146],["με",708618,163]],"For thou knowest my reproach, and my shame, and my confusion; all that afflict me are before thee."],["21",[["ὀνειδισμὸν",709657,6],["προσεδόκησεν",710876,2],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["καὶ",707031,7],["ταλαιπωρίαν",712695,9],["καὶ",707031,7],["ὑπέμεινα",713219,155],["συλλυπούμενον",712272,183],["καὶ",707031,7],["οὐχ",709805,28],["ὑπῆρξεν",713104,2],["καὶ",707031,7],["παρακαλοῦντας",710039,235],["καὶ",707031,7],["οὐχ",709805,28],["εὗρον",705676,150]],"My soul has waited for reproach and misery; and I waited for one to grieve with me, but there was none; and for one to comfort me, but I found none."],["22",[["καὶ",707031,7],["ἔδωκαν",703654,150],["εἰς",704105,0],["τὸ",709436,24],["βρῶμά",702823,25],["μου",709032,133],["χολὴν",713900,9],["καὶ",707031,7],["εἰς",704105,0],["τὴν",709436,8],["δίψαν",703762,9],["μου",709032,133],["ἐπότισάν",710700,150],["με",708618,163],["ὄξος",709678,25]],"They gave [me] also gall for my food, and made me drink vinegar for my thirst."],["23",[["γενηθήτω",703104,22],["ἡ",709436,10],["τράπεζα",712919,12],["αὐτῶν",702165,40],["ἐνώπιον",704823,0],["αὐτῶν",702165,40],["εἰς",704105,0],["παγίδα",709910,9],["καὶ",707031,7],["εἰς",704105,0],["ἀνταπόδοσιν",701217,9],["καὶ",707031,7],["εἰς",704105,0],["σκάνδαλον",711825,25]],"Let their table before them be for a snare, and for a recompence, and for a stumbling-block."],["24",[["σκοτισθήτωσαν",711887,51],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["αὐτῶν",702165,40],["τοῦ",709436,20],["μὴ",708851,28],["βλέπειν",702740,55],["καὶ",707031,7],["τὸν",709436,5],["νῶτον",709403,25],["αὐτῶν",702165,40],["διὰ",703417,0],["παντὸς",710177,116],["σύγκαμψον",712202,176]],"Let their eyes be darkened that they should not see; and bow down their back continually."],["25",[["ἔκχεον",704368,176],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["τὴν",709436,8],["ὀργήν",709728,9],["σου",711945,133],["καὶ",707031,7],["ὁ",709436,3],["θυμὸς",706334,4],["τῆς",709436,16],["ὀργῆς",709728,17],["σου",711945,133],["καταλάβοι",707300,225],["αὐτούς",702165,62]],"Pour out thy wrath upon them, and let the fury of thine anger take hold on them."],["26",[["γενηθήτω",703104,22],["ἡ",709436,10],["ἔπαυλις",705048,12],["αὐτῶν",702165,40],["ἠρημωμένη",705421,451],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["σκηνώμασιν",711849,96],["αὐτῶν",702165,40],["μὴ",708851,28],["ἔστω",704093,31],["ὁ",709436,3],["κατοικῶν",707534,72]],"Let their habitation be made desolate; and let there be no inhabitant in their tents:"],["27",[["ὅτι",709803,7],["ὃν",709781,112],["σὺ",712181,164],["ἐπάταξας",710185,162],["αὐτοὶ",702165,201],["κατεδίωξαν",707243,150],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸ",709436,24],["ἄλγος",700642,25],["τῶν",709436,80],["τραυματιῶν",712921,81],["σου",711945,133],["προσέθηκαν",710965,150]],"because they persecuted him whom thou hast smitten; and they have added to the grief of my wounds."],["28",[["πρόσθες",710965,176],["ἀνομίαν",701192,9],["ἐπὶ",705080,0],["τὴν",709436,8],["ἀνομίαν",701192,9],["αὐτῶν",702165,40],["καὶ",707031,7],["μὴ",708851,28],["εἰσελθέτωσαν",704114,264],["ἐν",704639,0],["δικαιοσύνῃ",703695,1],["σου",711945,133]],"Add iniquity to their iniquity; and let them not come into thy righteousness."],["29",[["ἐξαλειφθήτωσαν",704852,51],["ἐκ",704132,0],["βίβλου",702721,17],["ζώντων",705851,170],["καὶ",707031,7],["μετὰ",708780,0],["δικαίων",703694,169],["μὴ",708851,28],["γραφήτωσαν",703194,51]],"Let them be blotted out of the book of the living, and let them not be written with the righteous."],["30",[["πτωχὸς",711076,4],["καὶ",707031,7],["ἀλγῶν",700638,72],["εἰμι",704093,157],["ἐγώ",704018,164],["καὶ",707031,7],["ἡ",709436,10],["σωτηρία",712658,12],["τοῦ",709436,20],["προσώπου",710986,21],["σου",711945,133],["ὁ",709436,3],["θεός",706192,4],["ἀντελάβετό",701243,23],["μου",709032,133]],"I am poor and sorrowful; but the salvation of thy countenance has helped me."],["31",[["αἰνέσω",700459,165],["τὸ",709436,24],["ὄνομα",709666,25],["τοῦ",709436,35],["θεοῦ",706192,18],["μετ᾿",708780,0],["ᾠδῆς",714091,17],["μεγαλυνῶ",708647,165],["αὐτὸν",702165,85],["ἐν",704639,0],["αἰνέσει",700457,1]],"I will praise the name of my God with a song, I will magnify him with praise;"],["32",[["καὶ",707031,7],["ἀρέσει",701722,127],["τῷ",709436,113],["θεῷ",706192,114],["ὑπὲρ",713111,0],["μόσχον",709029,6],["νέον",709256,27],["κέρατα",707625,42],["ἐκφέροντα",704356,237],["καὶ",707031,7],["ὁπλάς",709698,39]],"and [this] shall please God more than a young calf having horns and hoofs."],["33",[["ἰδέτωσαν",709725,264],["πτωχοὶ",711076,52],["καὶ",707031,7],["εὐφρανθήτωσαν",705715,51],["ἐκζητήσατε",704187,74],["τὸν",709436,5],["θεόν",706192,6],["καὶ",707031,7],["ζήσεται",705851,93],["ἡ",709436,10],["ψυχὴ",714070,12],["ὑμῶν",713091,145]],"Let the poor see and rejoice; seek the Lord diligently, and ye shall live.",{"s":"d","q":0.67}],["34",[["ὅτι",709803,7],["εἰσήκουσεν",704108,2],["τῶν",709436,80],["πενήτων",710248,81],["ὁ",709436,3],["κύριος",707996,4],["καὶ",707031,7],["τοὺς",709436,58],["πεπεδημένους",710208,458],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐξουδένωσεν",704969,2]],"For the Lord hears the poor, and does not set at nought his fettered ones."],["35",[["αἰνεσάτωσαν",700459,264],["αὐτὸν",702165,85],["οἱ",709436,136],["οὐρανοὶ",709844,52],["καὶ",707031,7],["ἡ",709436,10],["γῆ",703083,12],["θάλασσα",706069,12],["καὶ",707031,7],["πάντα",710177,195],["τὰ",709436,63],["ἕρποντα",705442,242],["ἐν",704639,0],["αὐτοῖς",702165,151]],"Let the heavens and the earth praise him, the sea, and all things moving in them."],["36",[["ὅτι",709803,7],["ὁ",709436,3],["θεὸς",706192,4],["σώσει",712627,127],["τὴν",709436,8],["Σιων",711816,9],["καὶ",707031,7],["οἰκοδομηθήσονται",709509,144],["αἱ",709436,190],["πόλεις",710612,191],["τῆς",709436,16],["Ιουδαίας",706769,17],["καὶ",707031,7],["κατοικήσουσιν",707534,218],["ἐκεῖ",704181,28],["καὶ",707031,7],["κληρονομήσουσιν",707724,218],["αὐτήν",702165,104]],"For God will save Sion, and the cities of Judea shall be built; and [men] shall dwell there, and inherit it."],["37",[["καὶ",707031,7],["τὸ",709436,34],["σπέρμα",712008,15],["τῶν",709436,80],["δούλων",703817,81],["αὐτοῦ",702165,102],["καθέξουσιν",707526,218],["αὐτήν",702165,104],["καὶ",707031,7],["οἱ",709436,136],["ἀγαπῶντες",700120,146],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["κατασκηνώσουσιν",707423,218],["ἐν",704639,0],["αὐτῇ",702165,105]],"And the seed of his servants shall possess it, and they that love his name shall dwell therein."]]