[["1",[["ᾠδὴ",714091,12],["τῶν",709436,80],["ἀναβαθμῶν",700904,81],["μακάριοι",708397,138],["πάντες",710177,138],["οἱ",709436,136],["φοβούμενοι",713532,348],["τὸν",709436,5],["κύριον",707996,6],["οἱ",709436,136],["πορευόμενοι",710667,348],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["αὐτοῦ",702165,559]],"A Song of Degrees. Blessed are all they that fear the Lord; who walk in his ways."],["2",[["τοὺς",709436,58],["πόνους",710661,57],["τῶν",709436,80],["καρπῶν",707169,81],["σου",711945,133],["φάγεσαι",713296,123],["μακάριος",708397,14],["εἶ",704093,154],["καὶ",707031,7],["καλῶς",707106,28],["σοι",711925,159],["ἔσται",704093,93]],"Thou shalt eat the labours of thy hands: blessed art thou, and it shall be well with thee."],["3",[["ἡ",709436,10],["γυνή",703209,12],["σου",711945,133],["ὡς",714148,7],["ἄμπελος",700870,12],["εὐθηνοῦσα",705594,188],["ἐν",704639,0],["τοῖς",709436,95],["κλίτεσι",707740,96],["τῆς",709436,16],["οἰκίας",709505,17],["σου",711945,133],["οἱ",709436,136],["υἱοί",713075,52],["σου",711945,133],["ὡς",714148,7],["νεόφυτα",709260,68],["ἐλαιῶν",704376,65],["κύκλῳ",707959,114],["τῆς",709436,16],["τραπέζης",712919,17],["σου",711945,133]],"Thy wife shall be as a fruitful vine on the sides of thy house: thy children as young olive-plants round about thy table."],["4",[["ἰδοὺ",706497,88],["οὕτως",709859,28],["εὐλογηθήσεται",705631,134],["ἄνθρωπος",701163,4],["ὁ",709436,3],["φοβούμενος",713532,122],["τὸν",709436,5],["κύριον",707996,6]],"Behold, thus shall the man be blessed that fears the Lord."],["5",[["εὐλογήσαι",705631,225],["σε",711598,163],["κύριος",707996,4],["ἐκ",704132,0],["Σιων",711816,17],["καὶ",707031,7],["ἴδοις",709725,657],["τὰ",709436,41],["ἀγαθὰ",700106,68],["Ιερουσαλημ",706644,17],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["τῆς",709436,16],["ζωῆς",705910,17],["σου",711945,133]],"May the Lord bless thee out of Sion; and mayest thou see the prosperity of Jerusalem all the days of thy life."],["6",[["καὶ",707031,7],["ἴδοις",709725,657],["υἱοὺς",713075,57],["τῶν",709436,80],["υἱῶν",713075,81],["σου",711945,133],["εἰρήνη",704098,12],["ἐπὶ",705080,0],["τὸν",709436,5],["Ισραηλ",706839,6]],"And mayest thou see thy children's children. Peace be upon Israel."]]