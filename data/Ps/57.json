[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["μὴ",708851,28],["διαφθείρῃς",703624,205],["τῷ",709436,113],["Δαυιδ",703232,114],["εἰς",704105,0],["στηλογραφίαν",712093,9]],"For the end. Destroy not: by David, for a memorial."],["2",[["εἰ",704071,7],["ἀληθῶς",700662,28],["ἄρα",701666,11],["δικαιοσύνην",703695,9],["λαλεῖτε",708071,87],["εὐθεῖα",705602,29],["κρίνετε",707905,87],["οἱ",709436,136],["υἱοὶ",713075,52],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"If ye do indeed speak righteousness, [then] do ye judge rightly, ye sons of men."],["3",[["καὶ",707031,7],["γὰρ",702963,11],["ἐν",704639,0],["καρδίᾳ",707141,1],["ἀνομίας",701192,17],["ἐργάζεσθε",705383,374],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ἀδικίαν",700271,9],["αἱ",709436,190],["χεῖρες",713787,191],["ὑμῶν",713091,145],["συμπλέκουσιν",712334,197]],"For ye work iniquities in [your] hearts in the earth: your hands plot unrighteousness."],["4",[["ἀπηλλοτριώθησαν",701334,99],["οἱ",709436,136],["ἁμαρτωλοὶ",700776,138],["ἀπὸ",701425,0],["μήτρας",708894,17],["ἐπλανήθησαν",710495,99],["ἀπὸ",701425,0],["γαστρός",702976,17],["ἐλάλησαν",708071,150],["ψεύδη",714036,68]],"Sinners have gone astray from the womb: they go astray from the belly: they speak lies."],["5",[["θυμὸς",706334,4],["αὐτοῖς",702165,151],["κατὰ",707200,0],["τὴν",709436,8],["ὁμοίωσιν",709631,9],["τοῦ",709436,35],["ὄφεως",709875,18],["ὡσεὶ",714159,7],["ἀσπίδος",701991,17],["κωφῆς",708033,82],["καὶ",707031,7],["βυούσης",702835,188],["τὰ",709436,63],["ὦτα",709852,64],["αὐτῆς",702165,86]],"Their venom is like [that] of a serpent; as [that] of a deaf asp, and that stops her ears;"],["6",[["ἥτις",709793,412],["οὐκ",709805,28],["εἰσακούσεται",704108,93],["φωνὴν",713640,9],["ἐπᾳδόντων",704997,170],["φαρμάκου",713370,18],["τε",712751,11],["φαρμακευομένου",713367,465],["παρὰ",709995,0],["σοφοῦ",711985,116]],"which will not hear the voice of charmers, nor [heed] the charm prepared skilfully by the wise."],["7",[["ὁ",709436,3],["θεὸς",706192,4],["συνέτριψεν",712520,2],["τοὺς",709436,58],["ὀδόντας",709461,57],["αὐτῶν",702165,40],["ἐν",704639,0],["τῷ",709436,53],["στόματι",712125,54],["αὐτῶν",702165,40],["τὰς",709436,38],["μύλας",709054,39],["τῶν",709436,80],["λεόντων",708171,81],["συνέθλασεν",712479,2],["κύριος",707996,4]],"God has crushed their teeth in their mouth: God has broken the cheek-teeth of the lions."],["8",[["ἐξουδενωθήσονται",704969,144],["ὡς",714148,7],["ὕδωρ",713071,15],["διαπορευόμενον",703551,208],["ἐντενεῖ",704790,127],["τὸ",709436,24],["τόξον",712898,25],["αὐτοῦ",702165,102],["ἕως",705792,0],["οὗ",709781,48],["ἀσθενήσουσιν",701938,218]],"They shall utterly pass away like water running through: he shall bend his bow till they shall fail."],["9",[["ὡσεὶ",714159,7],["κηρὸς",707659,4],["ὁ",709436,3],["τακεὶς",712839,217],["ἀνταναιρεθήσονται",701212,144],["ἐπέπεσε",705225,2],["πῦρ",711088,25],["καὶ",707031,7],["οὐκ",709805,28],["εἶδον",709725,150],["τὸν",709436,5],["ἥλιον",705974,6]],"They shall be destroyed as melted wax: the fire has fallen and they have not seen the sun."],["10",[["πρὸ",710747,0],["τοῦ",709436,20],["συνιέναι",712481,55],["τὰς",709436,38],["ἀκάνθας",700517,39],["ὑμῶν",713091,145],["τὴν",709436,8],["ῥάμνον",711172,9],["ὡσεὶ",714159,7],["ζῶντας",705851,235],["ὡσεὶ",714159,7],["ἐν",704639,0],["ὀργῇ",709728,1],["καταπίεται",707374,93],["ὑμᾶς",713080,194]],"Before your thorns feel the white thorn, he shall swallow you up as living, as in his wrath."],["11",[["εὐφρανθήσεται",705715,134],["δίκαιος",703694,14],["ὅταν",709801,28],["ἴδῃ",709725,172],["ἐκδίκησιν",704175,9],["ἀσεβῶν",701909,169],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτοῦ",702165,102],["νίψεται",709314,93],["ἐν",704639,0],["τῷ",709436,53],["αἵματι",700442,54],["τοῦ",709436,35],["ἁμαρτωλοῦ",700776,116]],"The righteous shall rejoice when he sees the vengeance of the ungodly: he shall wash his hands in the blood of the sinner."],["12",[["καὶ",707031,7],["ἐρεῖ",705415,127],["ἄνθρωπος",701163,4],["εἰ",704071,7],["ἄρα",701666,11],["ἔστιν",704093,91],["καρπὸς",707169,4],["τῷ",709436,113],["δικαίῳ",703694,30],["ἄρα",701666,11],["ἐστὶν",704093,91],["ὁ",709436,3],["θεὸς",706192,4],["κρίνων",707905,72],["αὐτοὺς",702165,62],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1]],"And a man shall say, Verily then there is a reward for the righteous: verily there is a God that judges them in the earth."]]