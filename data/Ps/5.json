[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ὑπὲρ",713111,0],["τῆς",709436,16],["κληρονομούσης",707724,222],["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, a Psalm of David, concerning her that inherits."],["2",[["τὰ",709436,41],["ῥήματά",711246,42],["μου",709032,133],["ἐνώτισαι",704825,300],["κύριε",707996,153],["σύνες",712481,176],["τῆς",709436,16],["κραυγῆς",707886,17],["μου",709032,133]],"Hearken to my words, O Lord, attend to my cry."],["3",[["πρόσχες",710895,176],["τῇ",709436,100],["φωνῇ",713640,1],["τῆς",709436,16],["δεήσεώς",703311,17],["μου",709032,133],["ὁ",709436,3],["βασιλεύς",702580,4],["μου",709032,133],["καὶ",707031,7],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["ὅτι",709803,7],["πρὸς",710844,0],["σὲ",711598,163],["προσεύξομαι",710893,181],["κύριε",707996,153]],"Attend to the voice of my supplication, my King, and my God: for to thee, O Lord, will I pray."],["4",[["τὸ",709436,24],["πρωὶ",711021,28],["εἰσακούσῃ",704108,123],["τῆς",709436,16],["φωνῆς",713640,17],["μου",709032,133],["τὸ",709436,24],["πρωὶ",711021,28],["παραστήσομαί",710152,181],["σοι",711925,159],["καὶ",707031,7],["ἐπόψομαι",705057,181]],"In the morning thou shalt hear my voice: in the morning will I wait upon thee, and will look up."],["5",[["ὅτι",709803,7],["οὐχὶ",709862,28],["θεὸς",706192,4],["θέλων",706176,72],["ἀνομίαν",701192,9],["σὺ",712181,164],["εἶ",704093,154],["οὐδὲ",709816,7],["παροικήσει",710157,1],["σοι",711925,159],["πονηρευόμενος",710657,122]],"For thou art not a God that desires iniquity; neither shall the worker of wickedness dwell with thee."],["6",[["οὐ",709805,28],["διαμενοῦσιν",703517,218],["παράνομοι",710080,138],["κατέναντι",707507,0],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["σου",711945,133],["ἐμίσησας",708935,162],["πάντας",710177,60],["τοὺς",709436,58],["ἐργαζομένους",705383,236],["τὴν",709436,8],["ἀνομίαν",701192,9]],"Neither shall the transgressors continue in thy sight: thou hatest, O Lord, all them that work iniquity."],["7",[["ἀπολεῖς",701513,166],["πάντας",710177,60],["τοὺς",709436,58],["λαλοῦντας",708071,235],["τὸ",709436,24],["ψεῦδος",714044,25],["ἄνδρα",701150,6],["αἱμάτων",700442,44],["καὶ",707031,7],["δόλιον",703783,27],["βδελύσσεται",702608,117],["κύριος",707996,4]],"Thou wilt destroy all that speak falsehood: the Lord abhors the bloody and deceitful man."],["8",[["ἐγὼ",704018,164],["δὲ",703303,11],["ἐν",704639,0],["τῷ",709436,53],["πλήθει",710529,54],["τοῦ",709436,20],["ἐλέους",704426,21],["σου",711945,133],["εἰσελεύσομαι",704114,181],["εἰς",704105,0],["τὸν",709436,5],["οἶκόν",709516,6],["σου",711945,133],["προσκυνήσω",710925,165],["πρὸς",710844,0],["ναὸν",709191,6],["ἅγιόν",700159,27],["σου",711945,133],["ἐν",704639,0],["φόβῳ",713534,114],["σου",711945,133]],"But I will enter into thine house in the multitude of thy mercy: I will worship in thy fear toward thy holy temple."],["9",[["κύριε",707996,153],["ὁδήγησόν",709448,176],["με",708618,163],["ἐν",704639,0],["τῇ",709436,100],["δικαιοσύνῃ",703695,1],["σου",711945,133],["ἕνεκα",704709,0],["τῶν",709436,80],["ἐχθρῶν",705779,81],["μου",709032,133],["κατεύθυνον",707521,176],["ἐνώπιόν",704823,0],["μου",709032,133],["τὴν",709436,8],["ὁδόν",709458,9],["σου",711945,133]],"Lead me, O Lord, in thy righteousness because of mine enemies; make my way plain before thy face."],["10",[["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐν",704639,0],["τῷ",709436,53],["στόματι",712125,54],["αὐτῶν",702165,40],["ἀλήθεια",700656,12],["ἡ",709436,10],["καρδία",707141,12],["αὐτῶν",702165,40],["ματαία",708575,29],["τάφος",712738,4],["ἀνεῳγμένος",701186,419],["ὁ",709436,3],["λάρυγξ",708098,4],["αὐτῶν",702165,40],["ταῖς",709436,75],["γλώσσαις",703120,76],["αὐτῶν",702165,40],["ἐδολιοῦσαν",703785,150]],"For there is no truth in their mouth; their heart is vain; their throat is an open sepulchre; with their tongues they have used deceit."],["11",[["κρῖνον",707905,176],["αὐτούς",702165,62],["ὁ",709436,3],["θεός",706192,4],["ἀποπεσάτωσαν",701546,264],["ἀπὸ",701425,0],["τῶν",709436,130],["διαβουλίων",703430,65],["αὐτῶν",702165,40],["κατὰ",707200,0],["τὸ",709436,24],["πλῆθος",710529,25],["τῶν",709436,130],["ἀσεβειῶν",701904,65],["αὐτῶν",702165,40],["ἔξωσον",704985,176],["αὐτούς",702165,62],["ὅτι",709803,7],["παρεπίκρανάν",710087,150],["σε",711598,163],["κύριε",707996,153]],"Judge them, O God; let them fail of their counsels: cast them out according to the abundance of their ungodliness; for they have provoked thee, O Lord."],["12",[["καὶ",707031,7],["εὐφρανθήτωσαν",705715,51],["πάντες",710177,138],["οἱ",709436,136],["ἐλπίζοντες",704529,146],["ἐπὶ",705080,0],["σέ",711598,163],["εἰς",704105,0],["αἰῶνα",700504,6],["ἀγαλλιάσονται",700114,135],["καὶ",707031,7],["κατασκηνώσεις",707423,166],["ἐν",704639,0],["αὐτοῖς",702165,151],["καὶ",707031,7],["καυχήσονται",707569,135],["ἐν",704639,0],["σοὶ",711925,159],["πάντες",710177,138],["οἱ",709436,136],["ἀγαπῶντες",700120,146],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133]],"But let all that trust on thee be glad in thee: they shall exult for ever, and thou shalt dwell among them; and all that love thy name shall rejoice in thee."],["13",[["ὅτι",709803,7],["σὺ",712181,164],["εὐλογήσεις",705631,166],["δίκαιον",703694,27],["κύριε",707996,153],["ὡς",714148,7],["ὅπλῳ",709704,54],["εὐδοκίας",705566,17],["ἐστεφάνωσας",712084,162],["ἡμᾶς",705981,194]],"For thou, Lord, shalt bless the righteous: thou hast compassed us as with a shield of favour."]]