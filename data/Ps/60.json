[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ἐν",704639,0],["ὕμνοις",713089,148],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, among the Hymns of David."],["2",[["εἰσάκουσον",704108,176],["ὁ",709436,3],["θεός",706192,4],["τῆς",709436,16],["δεήσεώς",703311,17],["μου",709032,133],["πρόσχες",710895,176],["τῇ",709436,100],["προσευχῇ",710892,1],["μου",709032,133]],"O God, hearken to my petition; attend to my prayer."],["3",[["ἀπὸ",701425,0],["τῶν",709436,43],["περάτων",710281,44],["τῆς",709436,16],["γῆς",703083,17],["πρὸς",710844,0],["σὲ",711598,163],["ἐκέκραξα",707868,155],["ἐν",704639,0],["τῷ",709436,113],["ἀκηδιάσαι",700539,106],["τὴν",709436,8],["καρδίαν",707141,9],["μου",709032,133],["ἐν",704639,0],["πέτρᾳ",710443,1],["ὕψωσάς",713289,162],["με",708618,163]],"From the ends of the earth have I cried to thee, when my heart was in trouble: thou liftedst me up on a rock, thou didst guide me:"],["4",[["ὡδήγησάς",709448,162],["με",708618,163],["ὅτι",709803,7],["ἐγενήθης",703104,168],["ἐλπίς",704530,12],["μου",709032,133],["πύργος",711092,4],["ἰσχύος",706858,17],["ἀπὸ",701425,0],["προσώπου",710986,21],["ἐχθροῦ",705779,18]],"because thou wert my hope, a tower of strength from the face of the enemy."],["5",[["παροικήσω",710156,165],["ἐν",704639,0],["τῷ",709436,53],["σκηνώματί",711849,54],["σου",711945,133],["εἰς",704105,0],["τοὺς",709436,58],["αἰῶνας",700504,57],["σκεπασθήσομαι",711832,180],["ἐν",704639,0],["σκέπῃ",711839,1],["τῶν",709436,130],["πτερύγων",711057,65],["σου",711945,133],["διάψαλμα",703641,15]],"I will dwell in thy tabernacle for ever; I will shelter myself under the shadow of thy wings. Pause."],["6",[["ὅτι",709803,7],["σύ",712181,164],["ὁ",709436,3],["θεός",706192,4],["εἰσήκουσας",704108,162],["τῶν",709436,130],["εὐχῶν",705726,65],["μου",709032,133],["ἔδωκας",703654,162],["κληρονομίαν",707725,9],["τοῖς",709436,147],["φοβουμένοις",713532,341],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133]],"For thou, O God, hast heard my prayers; thou hast given an inheritance to them that fear thy name."],["7",[["ἡμέρας",705984,17],["ἐφ᾿",705080,0],["ἡμέρας",705984,17],["βασιλέως",702580,18],["προσθήσεις",710965,166],["ἔτη",705543,64],["αὐτοῦ",702165,102],["ἕως",705792,0],["ἡμέρας",705984,17],["γενεᾶς",703037,17],["καὶ",707031,7],["γενεᾶς",703037,17]],"Thou shalt add days to the days of the king; [thou shalt lengthen] his years to all generations."],["8",[["διαμενεῖ",703517,127],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἐνώπιον",704823,0],["τοῦ",709436,35],["θεοῦ",706192,18],["ἔλεος",704426,25],["καὶ",707031,7],["ἀλήθειαν",700656,9],["αὐτοῦ",702165,102],["τίς",712867,158],["ἐκζητήσει",704187,127]],"He shall endure for ever before God: which of them will seek out his mercy and truth?"],["9",[["οὕτως",709859,28],["ψαλῶ",714021,165],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18],["τοῦ",709436,20],["ἀποδοῦναί",701449,106],["με",708618,163],["τὰς",709436,38],["εὐχάς",705726,39],["μου",709032,133],["ἡμέραν",705984,9],["ἐξ",704132,0],["ἡμέρας",705984,17]],"So will I sing to thy name for ever and ever, that I may daily perform my vows."]]