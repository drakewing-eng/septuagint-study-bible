[["1",[["ψαλμὸς",714022,4],["τῷ",709436,113],["Ασαφ",701894,114],["ὁ",709436,3],["θεὸς",706192,4],["ἔστη",706846,2],["ἐν",704639,0],["συναγωγῇ",712376,1],["θεῶν",706192,81],["ἐν",704639,0],["μέσῳ",708768,30],["δὲ",703303,11],["θεοὺς",706192,57],["διακρίνει",703488,91]],"A Psalm for Asaph. God stands in the assembly of gods; and in the midst [of them] will judge gods."],["2",[["ἕως",705792,7],["πότε",710696,11],["κρίνετε",707905,87],["ἀδικίαν",700271,9],["καὶ",707031,7],["πρόσωπα",710986,42],["ἁμαρτωλῶν",700776,169],["λαμβάνετε",708076,87],["διάψαλμα",703641,15]],"How long will ye judge unrighteously, and accept the persons of sinners? Pause."],["3",[["κρίνατε",707905,74],["ὀρφανὸν",709779,27],["καὶ",707031,7],["πτωχόν",711076,6],["ταπεινὸν",712714,27],["καὶ",707031,7],["πένητα",710248,6],["δικαιώσατε",703696,74]],"Judge the orphan and poor: do justice to the low and needy."],["4",[["ἐξέλεσθε",704838,186],["πένητα",710248,6],["καὶ",707031,7],["πτωχόν",711076,6],["ἐκ",704132,0],["χειρὸς",713787,17],["ἁμαρτωλοῦ",700776,116],["ῥύσασθε",711309,186]],"Rescue the needy, and deliver the poor out of the hand of the sinner."],["5",[["οὐκ",709805,28],["ἔγνωσαν",703105,150],["οὐδὲ",709816,7],["συνῆκαν",712481,150],["ἐν",704639,0],["σκότει",711889,54],["διαπορεύονται",703551,269],["σαλευθήσονται",711403,144],["πάντα",710177,195],["τὰ",709436,63],["θεμέλια",706181,64],["τῆς",709436,16],["γῆς",703083,17]],"They know not, nor understand; they walk on in darkness: all the foundations of the earth shall be shaken."],["6",[["ἐγὼ",704018,164],["εἶπα",705373,155],["θεοί",706192,52],["ἐστε",704093,87],["καὶ",707031,7],["υἱοὶ",713075,52],["ὑψίστου",713287,116],["πάντες",710177,138]],"I have said, Ye are gods; and all [of you] children of the Most High."],["7",[["ὑμεῖς",713081,219],["δὲ",703303,11],["ὡς",714148,7],["ἄνθρωποι",701163,52],["ἀποθνῄσκετε",701461,87],["καὶ",707031,7],["ὡς",714148,7],["εἷς",704106,14],["τῶν",709436,80],["ἀρχόντων",701862,81],["πίπτετε",710481,87]],"But ye die as men, and fall as one of the princes."],["8",[["ἀνάστα",701173,176],["ὁ",709436,3],["θεός",706192,4],["κρῖνον",707905,176],["τὴν",709436,8],["γῆν",703083,9],["ὅτι",709803,7],["σὺ",712181,164],["κατακληρονομήσεις",707274,166],["ἐν",704639,0],["πᾶσιν",710177,94],["τοῖς",709436,95],["ἔθνεσιν",704068,96]],"Arise, O God, judge the earth: for thou shalt inherit all nations."]]