[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ᾠδὴ",714091,12],["ψαλμοῦ",714022,18],["ἀναστάσεως",701054,17],["ἀλαλάξατε",700632,74],["τῷ",709436,113],["θεῷ",706192,114],["πᾶσα",710177,29],["ἡ",709436,10],["γῆ",703083,12]],"For the end, a Song of a Psalm of resurrection. Shout unto God, all the earth."],["2",[["ψάλατε",714028,74],["δὴ",703395,11],["τῷ",709436,53],["ὀνόματι",709666,54],["αὐτοῦ",702165,102],["δότε",703654,74],["δόξαν",703791,9],["αἰνέσει",700457,1],["αὐτοῦ",702165,102]],"O sing praises to his name; give glory to his praise."],["3",[["εἴπατε",705373,265],["τῷ",709436,113],["θεῷ",706192,114],["ὡς",714148,7],["φοβερὰ",713530,195],["τὰ",709436,63],["ἔργα",705396,64],["σου",711945,133],["ἐν",704639,0],["τῷ",709436,53],["πλήθει",710529,54],["τῆς",709436,16],["δυνάμεώς",703839,17],["σου",711945,133],["ψεύσονταί",714040,135],["σε",711598,163],["οἱ",709436,136],["ἐχθροί",705779,52],["σου",711945,133]],"Say unto God, How awful are thy works! through the greatness of thy power thine enemies shall lie to thee."],["4",[["πᾶσα",710177,29],["ἡ",709436,10],["γῆ",703083,12],["προσκυνησάτωσάν",710925,264],["σοι",711925,159],["καὶ",707031,7],["ψαλάτωσάν",714028,264],["σοι",711925,159],["ψαλάτωσαν",714028,264],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["διάψαλμα",703641,15]],"Let all the earth worship thee, and sing to thee; let them sing to thy name. Pause."],["5",[["δεῦτε",703383,28],["καὶ",707031,7],["ἴδετε",709725,74],["τὰ",709436,41],["ἔργα",705396,42],["τοῦ",709436,35],["θεοῦ",706192,18],["φοβερὸς",713530,14],["ἐν",704639,0],["βουλαῖς",702792,76],["ὑπὲρ",713111,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"Come and behold the works of God; [he is] terrible in [his] counsels beyond the children of men."],["6",[["ὁ",709436,3],["μεταστρέφων",708817,72],["τὴν",709436,8],["θάλασσαν",706069,9],["εἰς",704105,0],["ξηράν",709421,36],["ἐν",704639,0],["ποταμῷ",710693,114],["διελεύσονται",703673,135],["ποδί",710707,114],["ἐκεῖ",704181,28],["εὐφρανθησόμεθα",705715,347],["ἐπ᾿",705080,0],["αὐτῷ",702165,50]],"Who turns the sea into dry land; they shall go through the river on foot; there shall we rejoice in him,"],["7",[["τῷ",709436,113],["δεσπόζοντι",703376,379],["ἐν",704639,0],["τῇ",709436,100],["δυναστείᾳ",703841,1],["αὐτοῦ",702165,102],["τοῦ",709436,35],["αἰῶνος",700504,18],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τὰ",709436,41],["ἔθνη",704068,42],["ἐπιβλέπουσιν",705088,197],["οἱ",709436,136],["παραπικραίνοντες",710087,146],["μὴ",708851,28],["ὑψούσθωσαν",713289,650],["ἐν",704639,0],["ἑαυτοῖς",703917,151],["διάψαλμα",703641,15]],"who by his power is Lord over the age, his eyes look upon the nations; let not them that provoke [him] be exalted in themselves. Pause."],["8",[["εὐλογεῖτε",705631,87],["ἔθνη",704068,42],["τὸν",709436,5],["θεὸν",706192,6],["ἡμῶν",705999,145],["καὶ",707031,7],["ἀκουτίσασθε",700585,186],["τὴν",709436,8],["φωνὴν",713640,9],["τῆς",709436,16],["αἰνέσεως",700457,17],["αὐτοῦ",702165,102]],"Bless our God, ye Gentiles, and make the voice of his praise to be heard;"],["9",[["τοῦ",709436,35],["θεμένου",712849,292],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["εἰς",704105,0],["ζωὴν",705910,9],["καὶ",707031,7],["μὴ",708851,28],["δόντος",703654,500],["εἰς",704105,0],["σάλον",711420,6],["τοὺς",709436,58],["πόδας",710707,57],["μου",709032,133]],"who quickens my soul in life, and does not suffer my feet to be moved."],["10",[["ὅτι",709803,7],["ἐδοκίμασας",703776,162],["ἡμᾶς",705981,194],["ὁ",709436,3],["θεός",706192,4],["ἐπύρωσας",711103,162],["ἡμᾶς",705981,194],["ὡς",714148,7],["πυροῦται",711103,117],["τὸ",709436,24],["ἀργύριον",701707,25]],"For thou, O God, hast proved us; thou hast tried us with fire as silver is tried."],["11",[["εἰσήγαγες",704107,162],["ἡμᾶς",705981,194],["εἰς",704105,0],["τὴν",709436,8],["παγίδα",709910,9],["ἔθου",712849,174],["θλίψεις",706276,39],["ἐπὶ",705080,0],["τὸν",709436,24],["νῶτον",709403,25],["ἡμῶν",705999,145]],"Thou broughtest us into the snare; thou laidest afflictions on our back."],["12",[["ἐπεβίβασας",705086,162],["ἀνθρώπους",701163,57],["ἐπὶ",705080,0],["τὰς",709436,38],["κεφαλὰς",707639,39],["ἡμῶν",705999,145],["διήλθομεν",703673,289],["διὰ",703417,0],["πυρὸς",711101,4],["καὶ",707031,7],["ὕδατος",713071,21],["καὶ",707031,7],["ἐξήγαγες",704834,162],["ἡμᾶς",705981,194],["εἰς",704105,0],["ἀναψυχήν",701094,9]],"Thou didst mount men upon our heads; we went through fire and water; but thou broughtest us out into [a place of] refreshment."],["13",[["εἰσελεύσομαι",704114,181],["εἰς",704105,0],["τὸν",709436,5],["οἶκόν",709516,6],["σου",711945,133],["ἐν",704639,0],["ὁλοκαυτώμασιν",709589,96],["ἀποδώσω",701449,165],["σοι",711925,159],["τὰς",709436,38],["εὐχάς",705726,39],["μου",709032,133]],"I will go into thine house with whole-burnt-offerings; I will pay thee my vows,"],["14",[["ἃς",709781,193],["διέστειλεν",703588,2],["τὰ",709436,63],["χείλη",713781,64],["μου",709032,133],["καὶ",707031,7],["ἐλάλησεν",708071,2],["τὸ",709436,34],["στόμα",712125,15],["μου",709032,133],["ἐν",704639,0],["τῇ",709436,100],["θλίψει",706276,1],["μου",709032,133]],"which my lips framed, and my mouth uttered in my affliction."],["15",[["ὁλοκαυτώματα",709589,42],["μεμυαλωμένα",709044,437],["ἀνοίσω",701083,165],["σοι",711925,159],["μετὰ",708780,0],["θυμιάματος",706330,21],["καὶ",707031,7],["κριῶν",707906,81],["ποιήσω",710582,165],["σοι",711925,159],["βόας",702798,57],["μετὰ",708780,0],["χιμάρων",713864,81],["διάψαλμα",703641,15]],"I will offer to thee whole-burnt-sacrifices full of marrow, with incense and rams; I will sacrifice to thee oxen with goats. Pause."],["16",[["δεῦτε",703383,28],["ἀκούσατε",700587,74],["καὶ",707031,7],["διηγήσομαι",703679,181],["πάντες",710177,138],["οἱ",709436,136],["φοβούμενοι",713532,348],["τὸν",709436,5],["θεόν",706192,6],["ὅσα",709788,68],["ἐποίησεν",710582,2],["τῇ",709436,100],["ψυχῇ",714070,1],["μου",709032,133]],"Come, hear, and I will tell, all ye that fear God, how great things he has done for my soul."],["17",[["πρὸς",710844,0],["αὐτὸν",702165,85],["τῷ",709436,53],["στόματί",712125,54],["μου",709032,133],["ἐκέκραξα",707868,155],["καὶ",707031,7],["ὕψωσα",713289,155],["ὑπὸ",713184,0],["τὴν",709436,8],["γλῶσσάν",703120,9],["μου",709032,133]],"I cried to him with my mouth, and exalted him with my tongue."],["18",[["ἀδικίαν",700271,9],["εἰ",704071,7],["ἐθεώρουν",706226,137],["ἐν",704639,0],["καρδίᾳ",707141,1],["μου",709032,133],["μὴ",708851,28],["εἰσακουσάτω",704108,45],["κύριος",707996,4]],"If I have regarded iniquity in my heart, let not the Lord hearken [to me]."],["19",[["διὰ",703417,0],["τοῦτο",709858,129],["εἰσήκουσέν",704108,2],["μου",709032,133],["ὁ",709436,3],["θεός",706192,4],["προσέσχεν",710895,2],["τῇ",709436,100],["φωνῇ",713640,1],["τῆς",709436,16],["δεήσεώς",703311,17],["μου",709032,133]],"Therefore God has hearkened to me; he has attended to the voice of my prayer."],["20",[["εὐλογητὸς",705632,14],["ὁ",709436,3],["θεός",706192,4],["ὃς",709781,213],["οὐκ",709805,28],["ἀπέστησεν",702214,2],["τὴν",709436,8],["προσευχήν",710892,9],["μου",709032,133],["καὶ",707031,7],["τὸ",709436,24],["ἔλεος",704426,25],["αὐτοῦ",702165,102],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133]],"Blessed be God, who has not turned away my prayer, nor his mercy from me."]]