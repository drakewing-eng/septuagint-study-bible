[["1",[["αλληλουια",700688,88],["ἐπίστευσα",710483,155],["διὸ",703714,7],["ἐλάλησα",708071,155],["ἐγὼ",704018,164],["δὲ",703303,11],["ἐταπεινώθην",712717,156],["σφόδρα",712586,28]],"Alleluia. I believed, wherefore I have spoken: but I was greatly afflicted."],["2",[["ἐγὼ",704018,164],["εἶπα",705373,155],["ἐν",704639,0],["τῇ",709436,100],["ἐκστάσει",704314,1],["μου",709032,133],["πᾶς",710177,14],["ἄνθρωπος",701163,4],["ψεύστης",714046,4]],"And I said in mine amazement, Every man is a liar."],["3",[["τί",712867,126],["ἀνταποδώσω",701215,165],["τῷ",709436,113],["κυρίῳ",707996,114],["περὶ",710285,0],["πάντων",710177,169],["ὧν",709781,252],["ἀνταπέδωκέν",701215,2],["μοι",708974,159]],"What shall I render to the Lord for all the things wherein he has rewarded me?"],["4",[["ποτήριον",710699,25],["σωτηρίου",712659,21],["λήμψομαι",708076,181],["καὶ",707031,7],["τὸ",709436,24],["ὄνομα",709666,25],["κυρίου",707996,18],["ἐπικαλέσομαι",705153,181]],"I will take the cup of salvation, and call upon the name of the Lord."],["6",[["τίμιος",712858,14],["ἐναντίον",704654,0],["κυρίου",707996,18],["ὁ",709436,3],["θάνατος",706096,4],["τῶν",709436,80],["ὁσίων",709782,169],["αὐτοῦ",702165,102]],"Precious in the sight of the Lord is the death of his saints."],["7",[["ὦ",714081,88],["κύριε",707996,153],["ἐγὼ",704018,164],["δοῦλος",703817,4],["σός",711943,14],["ἐγὼ",704018,164],["δοῦλος",703817,4],["σὸς",711943,14],["καὶ",707031,7],["υἱὸς",713075,4],["τῆς",709436,16],["παιδίσκης",709928,17],["σου",711945,133],["διέρρηξας",703565,162],["τοὺς",709436,58],["δεσμούς",703372,57],["μου",709032,133]],"O Lord, I am thy servant; I am thy servant, and the son of thine handmaid: thou hast burst my bonds asunder."],["8",[["σοὶ",711925,159],["θύσω",706349,165],["θυσίαν",706345,9],["αἰνέσεως",700457,17]],"I will offer to thee the sacrifice of praise, and will call upon the name of the Lord."],["9",[["τὰς",709436,38],["εὐχάς",705726,39],["μου",709032,133],["τῷ",709436,113],["κυρίῳ",707996,114],["ἀποδώσω",701449,165],["ἐναντίον",704654,0],["παντὸς",710177,116],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτοῦ",702165,102]],"I will pay my vows unto the Lord, in the presence of all his people,"],["10",[["ἐν",704639,0],["αὐλαῖς",702137,76],["οἴκου",709516,18],["κυρίου",707996,18],["ἐν",704639,0],["μέσῳ",708768,30],["σου",711945,133],["Ιερουσαλημ",706644,17]],"in the courts of the Lord's house, in the midst of thee, Jerusalem."]]