[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["τῷ",709436,113],["παιδὶ",709932,114],["κυρίου",707996,18],["τῷ",709436,113],["Δαυιδ",703232,114],["ἃ",709781,69],["ἐλάλησεν",708071,2],["τῷ",709436,113],["κυρίῳ",707996,114],["τοὺς",709436,58],["λόγους",708236,57],["τῆς",709436,16],["ᾠδῆς",714091,17],["ταύτης",709858,86],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["ᾗ",709781,108],["ἐρρύσατο",711309,23],["αὐτὸν",702165,85],["κύριος",707996,4],["ἐκ",704132,0],["χειρὸς",713787,17],["πάντων",710177,169],["τῶν",709436,80],["ἐχθρῶν",705779,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐκ",704132,0],["χειρὸς",713787,17],["Σαουλ",711499,18]],"For the end, [a Psalm] of David the servant of the Lord; [the words] which he spoke to the Lord, [even] the words of this Song, in the day in which the Lord delivered him out of the hand of all his enemies, and out of the hand of Saul: and he said:"],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["ἀγαπήσω",700120,165],["σε",711598,163],["κύριε",707996,153],["ἡ",709436,10],["ἰσχύς",706858,12],["μου",709032,133]],"I will love thee, O Lord, my strength."],["3",[["κύριος",707996,4],["στερέωμά",712077,15],["μου",709032,133],["καὶ",707031,7],["καταφυγή",707485,12],["μου",709032,133],["καὶ",707031,7],["ῥύστης",711313,4],["μου",709032,133],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["βοηθός",702748,4],["μου",709032,133],["καὶ",707031,7],["ἐλπιῶ",704529,165],["ἐπ᾿",705080,0],["αὐτόν",702165,85],["ὑπερασπιστής",713123,4],["μου",709032,133],["καὶ",707031,7],["κέρας",707625,15],["σωτηρίας",712658,17],["μου",709032,133],["ἀντιλήμπτωρ",701246,4],["μου",709032,133]],"The Lord is my firm support, and my refuge, and my deliverer; my God is my helper, I will hope in him; [he is] my defender, and the horn of my salvation, and my helper."],["4",[["αἰνῶν",700459,72],["ἐπικαλέσομαι",705153,181],["κύριον",707996,6],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,80],["ἐχθρῶν",705779,81],["μου",709032,133],["σωθήσομαι",712627,180]],"I will call upon the Lord with praises, and I shall be saved from mine enemies."],["5",[["περιέσχον",710315,150],["με",708618,163],["ὠδῖνες",714094,191],["θανάτου",706096,18],["καὶ",707031,7],["χείμαρροι",713783,52],["ἀνομίας",701192,17],["ἐξετάραξάν",704319,150],["με",708618,163]],"The pangs of death compassed me, and the torrents of ungodliness troubled me exceedingly."],["6",[["ὠδῖνες",714094,191],["ᾅδου",700255,18],["περιεκύκλωσάν",710339,150],["με",708618,163],["προέφθασάν",711011,150],["με",708618,163],["παγίδες",709910,191],["θανάτου",706096,18]],"The pangs of hell came round about me: the snares of death prevented me."],["7",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["θλίβεσθαί",706274,110],["με",708618,163],["ἐπεκαλεσάμην",705153,161],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["πρὸς",710844,0],["τὸν",709436,5],["θεόν",706192,6],["μου",709032,133],["ἐκέκραξα",707868,155],["ἤκουσεν",700587,2],["ἐκ",704132,0],["ναοῦ",709191,18],["ἁγίου",700159,116],["αὐτοῦ",702165,102],["φωνῆς",713640,17],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["κραυγή",707886,12],["μου",709032,133],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["εἰσελεύσεται",704114,93],["εἰς",704105,0],["τὰ",709436,41],["ὦτα",709852,42],["αὐτοῦ",702165,102]],"And when I was afflicted I called upon the Lord, and cried to my God: he heard my voice out of his holy temple, and my cry shall enter before him, [even] into his ears."],["8",[["καὶ",707031,7],["ἐσαλεύθη",711403,37],["καὶ",707031,7],["ἔντρομος",704808,29],["ἐγενήθη",703104,37],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["τὰ",709436,41],["θεμέλια",706181,42],["τῶν",709436,43],["ὀρέων",709768,44],["ἐταράχθησαν",712721,99],["καὶ",707031,7],["ἐσαλεύθησαν",711403,99],["ὅτι",709803,7],["ὠργίσθη",709729,37],["αὐτοῖς",702165,151],["ὁ",709436,3],["θεός",706192,4]],"Then the earth shook and quaked, and the foundations of the mountains were disturbed, and were shaken, because God was angry with them."],["9",[["ἀνέβη",700905,2],["καπνὸς",707132,4],["ἐν",704639,0],["ὀργῇ",709728,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["πῦρ",711088,15],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["κατεφλόγισεν",707478,2],["ἄνθρακες",701160,52],["ἀνήφθησαν",701044,99],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102]],"There went up a smoke in his wrath, and fire burst into a flame at his presence: coals were kindled at it."],["10",[["καὶ",707031,7],["ἔκλινεν",707738,13],["οὐρανὸν",709844,6],["καὶ",707031,7],["κατέβη",707202,2],["καὶ",707031,7],["γνόφος",703131,4],["ὑπὸ",713184,0],["τοὺς",709436,58],["πόδας",710707,57],["αὐτοῦ",702165,102]],"And he bowed the heaven, and came down: and thick darkness was under his feet."],["11",[["καὶ",707031,7],["ἐπέβη",705082,2],["ἐπὶ",705080,0],["χερουβιν",713830,42],["καὶ",707031,7],["ἐπετάσθη",710435,37],["ἐπετάσθη",710435,37],["ἐπὶ",705080,0],["πτερύγων",711057,65],["ἀνέμων",701123,81]],"And he mounted on cherubs and flew: he flew on the wings of winds."],["12",[["καὶ",707031,7],["ἔθετο",712849,23],["σκότος",711889,25],["ἀποκρυφὴν",701496,9],["αὐτοῦ",702165,102],["κύκλῳ",707959,114],["αὐτοῦ",702165,102],["ἡ",709436,10],["σκηνὴ",711845,12],["αὐτοῦ",702165,102],["σκοτεινὸν",711885,26],["ὕδωρ",713071,15],["ἐν",704639,0],["νεφέλαις",709277,76],["ἀέρων",700354,81]],"And he made darkness his secret place: round about him was his tabernacle, [even] dark water in the clouds of the air."],["13",[["ἀπὸ",701425,0],["τῆς",709436,16],["τηλαυγήσεως",712842,17],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["αἱ",709436,190],["νεφέλαι",709277,191],["διῆλθον",703673,150],["χάλαζα",713667,12],["καὶ",707031,7],["ἄνθρακες",701160,52],["πυρός",711101,4]],"At the brightness before him the clouds passed, hail and coals of fire."],["14",[["καὶ",707031,7],["ἐβρόντησεν",702815,2],["ἐξ",704132,0],["οὐρανοῦ",709844,18],["κύριος",707996,4],["καὶ",707031,7],["ὁ",709436,3],["ὕψιστος",713287,14],["ἔδωκεν",703654,2],["φωνὴν",713640,9],["αὐτοῦ",702165,102]],"The Lord also thundered from heaven, and the Highest uttered his voice."],["15",[["καὶ",707031,7],["ἐξαπέστειλεν",704872,2],["βέλη",702644,42],["καὶ",707031,7],["ἐσκόρπισεν",711881,2],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἀστραπὰς",702021,39],["ἐπλήθυνεν",710530,13],["καὶ",707031,7],["συνετάραξεν",712507,2],["αὐτούς",702165,62]],"And he sent forth [his] weapons, and scattered them; and multiplied lightnings, and routed them."],["16",[["καὶ",707031,7],["ὤφθησαν",709725,99],["αἱ",709436,190],["πηγαὶ",710450,191],["τῶν",709436,43],["ὑδάτων",713071,44],["καὶ",707031,7],["ἀνεκαλύφθη",700968,37],["τὰ",709436,41],["θεμέλια",706181,42],["τῆς",709436,16],["οἰκουμένης",709517,422],["ἀπὸ",701425,0],["ἐπιτιμήσεώς",705306,17],["σου",711945,133],["κύριε",707996,153],["ἀπὸ",701425,0],["ἐμπνεύσεως",704601,17],["πνεύματος",710566,21],["ὀργῆς",709728,17],["σου",711945,133]],"And the springs of waters appeared, and the foundations of the world were exposed, at thy rebuke, O Lord, at the blasting of the breath of thy wrath."],["17",[["ἐξαπέστειλεν",704872,2],["ἐξ",704132,0],["ὕψους",713288,21],["καὶ",707031,7],["ἔλαβέν",708076,2],["με",708618,163],["προσελάβετό",710930,23],["με",708618,163],["ἐξ",704132,0],["ὑδάτων",713071,44],["πολλῶν",710646,83]],"He sent from on high and took me, he drew me to himself out of many waters."],["18",[["ῥύσεταί",711309,93],["με",708618,163],["ἐξ",704132,0],["ἐχθρῶν",705779,81],["μου",709032,133],["δυνατῶν",703845,169],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,80],["μισούντων",708935,170],["με",708618,163],["ὅτι",709803,7],["ἐστερεώθησαν",712076,99],["ὑπὲρ",713111,0],["ἐμέ",704555,163]],"He will deliver me from my mighty enemies, and from them that hate me; for they are stronger than I."],["19",[["προέφθασάν",711011,150],["με",708618,163],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["κακώσεώς",707075,17],["μου",709032,133],["καὶ",707031,7],["ἐγένετο",703104,23],["κύριος",707996,4],["ἀντιστήριγμά",701274,15],["μου",709032,133]],"They prevented me in the day of mine affliction: but the Lord was my stay against [them]."],["20",[["καὶ",707031,7],["ἐξήγαγέν",704834,2],["με",708618,163],["εἰς",704105,0],["πλατυσμόν",710510,6],["ῥύσεταί",711309,93],["με",708618,163],["ὅτι",709803,7],["ἠθέλησέν",706176,2],["με",708618,163],["ῥύσεταί",711309,93],["με",708618,163],["ἐξ",704132,0],["ἐχθρῶν",705779,81],["μου",709032,133],["δυνατῶν",703845,169],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,80],["μισούντων",708935,170],["με",708618,163]],"And he brought me out into a wide place: he will deliver me, because he has pleasure in me."],["21",[["καὶ",707031,7],["ἀνταποδώσει",701215,127],["μοι",708974,159],["κύριος",707996,4],["κατὰ",707200,0],["τὴν",709436,8],["δικαιοσύνην",703695,9],["μου",709032,133],["καὶ",707031,7],["κατὰ",707200,0],["τὴν",709436,8],["καθαριότητα",706986,9],["τῶν",709436,130],["χειρῶν",713787,65],["μου",709032,133],["ἀνταποδώσει",701215,127],["μοι",708974,159]],"And the Lord will recompense me according to my righteousness; even according to the purity of my hands will he recompense me."],["22",[["ὅτι",709803,7],["ἐφύλαξα",713619,155],["τὰς",709436,38],["ὁδοὺς",709458,39],["κυρίου",707996,18],["καὶ",707031,7],["οὐκ",709805,28],["ἠσέβησα",701906,155],["ἀπὸ",701425,0],["τοῦ",709436,35],["θεοῦ",706192,18],["μου",709032,133]],"For I have kept the ways of the Lord and have not wickedly departed from my God."],["23",[["ὅτι",709803,7],["πάντα",710177,195],["τὰ",709436,63],["κρίματα",707903,64],["αὐτοῦ",702165,102],["ἐνώπιόν",704823,0],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,41],["δικαιώματα",703697,42],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἀπέστησα",702214,155],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133]],"For all his judgments were before me, and his ordinances departed not from me."],["24",[["καὶ",707031,7],["ἔσομαι",704093,181],["ἄμωμος",700895,14],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["φυλάξομαι",713619,181],["ἀπὸ",701425,0],["τῆς",709436,16],["ἀνομίας",701192,17],["μου",709032,133]],"And I shall be blameless with him, and shall keep myself from mine iniquity."],["25",[["καὶ",707031,7],["ἀνταποδώσει",701215,127],["μοι",708974,159],["κύριος",707996,4],["κατὰ",707200,0],["τὴν",709436,8],["δικαιοσύνην",703695,9],["μου",709032,133],["καὶ",707031,7],["κατὰ",707200,0],["τὴν",709436,8],["καθαριότητα",706986,9],["τῶν",709436,130],["χειρῶν",713787,65],["μου",709032,133],["ἐνώπιον",704823,0],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["αὐτοῦ",702165,102]],"And the Lord shall recompense me according to my righteousness, and according to the purity of my hands before his eyes."],["26",[["μετὰ",708780,0],["ὁσίου",709782,116],["ὁσιωθήσῃ",709784,364],["καὶ",707031,7],["μετὰ",708780,0],["ἀνδρὸς",701150,18],["ἀθῴου",700390,116],["ἀθῷος",700390,14],["ἔσῃ",704093,123]],"With the holy thou wilt be holy; and with the innocent man thou wilt be innocent."],["27",[["καὶ",707031,7],["μετὰ",708780,0],["ἐκλεκτοῦ",704240,116],["ἐκλεκτὸς",704240,14],["ἔσῃ",704093,123],["καὶ",707031,7],["μετὰ",708780,0],["στρεβλοῦ",712154,116],["διαστρέψεις",703592,166]],"And with the excellent [man] thou wilt be excellent; and with the perverse thou wilt shew frowardness."],["28",[["ὅτι",709803,7],["σὺ",712181,164],["λαὸν",708094,6],["ταπεινὸν",712714,27],["σώσεις",712627,166],["καὶ",707031,7],["ὀφθαλμοὺς",709870,57],["ὑπερηφάνων",713139,169],["ταπεινώσεις",712717,166]],"For thou wilt save the lowly people, and wilt humble the eyes of the proud."],["29",[["ὅτι",709803,7],["σὺ",712181,164],["φωτιεῖς",713646,166],["λύχνον",708287,6],["μου",709032,133],["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["φωτιεῖς",713646,166],["τὸ",709436,24],["σκότος",711889,25],["μου",709032,133]],"For thou, O Lord, wilt light my lamp: my God, thou wilt lighten my darkness."],["30",[["ὅτι",709803,7],["ἐν",704639,0],["σοὶ",711925,159],["ῥυσθήσομαι",711309,180],["ἀπὸ",701425,0],["πειρατηρίου",710228,21],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["θεῷ",706192,114],["μου",709032,133],["ὑπερβήσομαι",713125,181],["τεῖχος",712759,25]],"For by thee shall I be delivered from a troop; and by my God I will pass over a wall."],["31",[["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["ἄμωμος",700895,14],["ἡ",709436,10],["ὁδὸς",709458,12],["αὐτοῦ",702165,102],["τὰ",709436,63],["λόγια",708233,64],["κυρίου",707996,18],["πεπυρωμένα",711103,443],["ὑπερασπιστής",713123,4],["ἐστιν",704093,91],["πάντων",710177,169],["τῶν",709436,80],["ἐλπιζόντων",704529,170],["ἐπ᾿",705080,0],["αὐτόν",702165,85]],"[As for] my God, his way is perfect: the oracles of the Lord are tried in the fire; he is a protector of all them that hope in him."],["32",[["ὅτι",709803,7],["τίς",712867,158],["θεὸς",706192,4],["πλὴν",710540,28],["τοῦ",709436,35],["κυρίου",707996,18],["καὶ",707031,7],["τίς",712867,158],["θεὸς",706192,4],["πλὴν",710540,28],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145]],"For who is God but the Lord? and who is a God except our God?"],["33",[["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["περιζωννύων",710317,72],["με",708618,163],["δύναμιν",703839,9],["καὶ",707031,7],["ἔθετο",712849,23],["ἄμωμον",700895,27],["τὴν",709436,8],["ὁδόν",709458,9],["μου",709032,133]],"[It is] God that girds me with strength, and has made my way blameless:"],["34",[["ὁ",709436,3],["καταρτιζόμενος",707410,122],["τοὺς",709436,58],["πόδας",710707,57],["μου",709032,133],["ὡς",714148,7],["ἐλάφου",704398,18],["καὶ",707031,7],["ἐπὶ",705080,0],["τὰ",709436,41],["ὑψηλὰ",713285,68],["ἱστῶν",706846,72],["με",708618,163]],"who strengthens my feet as hart's feet, and sets me upon high places."],["35",[["διδάσκων",703649,72],["χεῖράς",713787,39],["μου",709032,133],["εἰς",704105,0],["πόλεμον",710605,6],["καὶ",707031,7],["ἔθου",712849,174],["τόξον",712898,25],["χαλκοῦν",713690,46],["τοὺς",709436,58],["βραχίονάς",702808,57],["μου",709032,133]],"He instructs my hands for war; and thou hast made my arms [as] a brazen bow."],["36",[["καὶ",707031,7],["ἔδωκάς",703654,162],["μοι",708974,159],["ὑπερασπισμὸν",713122,6],["σωτηρίας",712658,17],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["δεξιά",703360,29],["σου",711945,133],["ἀντελάβετό",701243,23],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["παιδεία",709924,12],["σου",711945,133],["ἀνώρθωσέν",701197,2],["με",708618,163],["εἰς",704105,0],["τέλος",712787,25],["καὶ",707031,7],["ἡ",709436,10],["παιδεία",709924,12],["σου",711945,133],["αὐτή",702165,107],["με",708618,163],["διδάξει",703649,127]],"And thou hast made me secure in my salvation: and thy right hand has helped me, and thy correction has upheld me to the end; yea, thy correction itself shall instruct me."],["37",[["ἐπλάτυνας",710508,162],["τὰ",709436,41],["διαβήματά",703422,42],["μου",709032,133],["ὑποκάτω",713204,0],["μου",709032,133],["καὶ",707031,7],["οὐκ",709805,28],["ἠσθένησαν",701938,150],["τὰ",709436,63],["ἴχνη",706873,64],["μου",709032,133]],"Thou hast made room for my goings under me, and my footsteps did not fail."],["38",[["καταδιώξω",707243,165],["τοὺς",709436,58],["ἐχθρούς",705779,57],["μου",709032,133],["καὶ",707031,7],["καταλήμψομαι",707300,181],["αὐτοὺς",702165,62],["καὶ",707031,7],["οὐκ",709805,28],["ἀποστραφήσομαι",701598,180],["ἕως",705792,0],["ἂν",700900,11],["ἐκλίπωσιν",704237,234]],"I will pursue mine enemies, and overtake them; and I will not turn back until they are consumed."],["39",[["ἐκθλίψω",704199,165],["αὐτούς",702165,62],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["δύνωνται",703838,380],["στῆναι",706846,106],["πεσοῦνται",710481,135],["ὑπὸ",713184,0],["τοὺς",709436,58],["πόδας",710707,57],["μου",709032,133]],"I will dash them to pieces and they shall not be able to stand: they shall fall under my feet."],["40",[["καὶ",707031,7],["περιέζωσάς",710317,162],["με",708618,163],["δύναμιν",703839,9],["εἰς",704105,0],["πόλεμον",710605,6],["συνεπόδισας",712338,162],["πάντας",710177,60],["τοὺς",709436,58],["ἐπανιστανομένους",705026,360],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ὑποκάτω",713204,0],["μου",709032,133]],"For thou hast girded me with strength for war: thou hast beaten down under me all that rose up against me."],["41",[["καὶ",707031,7],["τοὺς",709436,58],["ἐχθρούς",705779,57],["μου",709032,133],["ἔδωκάς",703654,162],["μοι",708974,159],["νῶτον",709403,25],["καὶ",707031,7],["τοὺς",709436,58],["μισοῦντάς",708935,235],["με",708618,163],["ἐξωλέθρευσας",704956,162]],"And thou hast made mine enemies turn their backs before me; and thou hast destroyed them that hated me."],["42",[["ἐκέκραξαν",707868,150],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ὁ",709436,3],["σῴζων",712627,72],["πρὸς",710844,0],["κύριον",707996,6],["καὶ",707031,7],["οὐκ",709805,28],["εἰσήκουσεν",704108,2],["αὐτῶν",702165,40]],"They cried, but there was no deliverer: [even] to the Lord, but he hearkened not to them."],["43",[["καὶ",707031,7],["λεπτυνῶ",708154,165],["αὐτοὺς",702165,62],["ὡς",714148,7],["χοῦν",713930,6],["κατὰ",707200,0],["πρόσωπον",710986,25],["ἀνέμου",701123,18],["ὡς",714148,7],["πηλὸν",710457,6],["πλατειῶν",710509,198],["λεανῶ",708118,165],["αὐτούς",702165,62]],"I will grind them as the mud of the streets: and I will beat them small as dust before the wind."],["44",[["ῥύσῃ",711309,123],["με",708618,163],["ἐξ",704132,0],["ἀντιλογιῶν",701249,65],["λαοῦ",708094,18],["καταστήσεις",707011,166],["με",708618,163],["εἰς",704105,0],["κεφαλὴν",707639,9],["ἐθνῶν",704068,44],["λαός",708094,4],["ὃν",709781,112],["οὐκ",709805,28],["ἔγνων",703105,155],["ἐδούλευσέν",703814,2],["μοι",708974,159]],"Deliver me from the gainsayings of the people: thou shalt make me head of the Gentiles: a people whom I knew not served me,"],["45",[["εἰς",704105,0],["ἀκοὴν",700561,9],["ὠτίου",714165,21],["ὑπήκουσέν",713096,2],["μοι",708974,159],["υἱοὶ",713075,52],["ἀλλότριοι",700699,138],["ἐψεύσαντό",714040,189],["μοι",708974,159]],"at the hearing of the ear they obeyed me: the strange children lied to me."],["46",[["υἱοὶ",713075,52],["ἀλλότριοι",700699,138],["ἐπαλαιώθησαν",709937,99],["καὶ",707031,7],["ἐχώλαναν",713998,150],["ἀπὸ",701425,0],["τῶν",709436,80],["τρίβων",712939,65],["αὐτῶν",702165,40]],"The strange children waxed old, and fell away from their paths through lameness."],["47",[["ζῇ",705851,91],["κύριος",707996,4],["καὶ",707031,7],["εὐλογητὸς",705632,14],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["καὶ",707031,7],["ὑψωθήτω",713289,22],["ὁ",709436,3],["θεὸς",706192,4],["τῆς",709436,16],["σωτηρίας",712658,17],["μου",709032,133]],"The Lord lives; and blessed [be] my God; and let the God of my salvation be exalted."],["48",[["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["διδοὺς",703654,72],["ἐκδικήσεις",704175,191],["ἐμοὶ",704577,159],["καὶ",707031,7],["ὑποτάξας",713250,182],["λαοὺς",708094,57],["ὑπ᾿",713184,0],["ἐμέ",704555,163]],"[It is] God that avenges me, and has subdued the nations under me;"],["49",[["ὁ",709436,3],["ῥύστης",711313,4],["μου",709032,133],["ἐξ",704132,0],["ἐχθρῶν",705779,81],["μου",709032,133],["ὀργίλων",709730,169],["ἀπὸ",701425,0],["τῶν",709436,80],["ἐπανιστανομένων",705026,445],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ὑψώσεις",713289,166],["με",708618,163],["ἀπὸ",701425,0],["ἀνδρὸς",701150,18],["ἀδίκου",700272,116],["ῥύσῃ",711309,123],["με",708618,163]],"my deliverer from angry enemies: thou shalt set me on high above them that rise up against me: thou shalt deliver me from the unrighteous man."],["50",[["διὰ",703417,0],["τοῦτο",709858,129],["ἐξομολογήσομαί",704960,181],["σοι",711925,159],["ἐν",704639,0],["ἔθνεσιν",704068,96],["κύριε",707996,153],["καὶ",707031,7],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["ψαλῶ",714021,165]],"Therefore will I confess to thee, O Lord, among the Gentiles, and sing to thy name."],["51",[["μεγαλύνων",708647,72],["τὰς",709436,38],["σωτηρίας",712658,39],["τοῦ",709436,35],["βασιλέως",702580,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ποιῶν",710582,72],["ἔλεος",704426,25],["τῷ",709436,113],["χριστῷ",713964,30],["αὐτοῦ",702165,102],["τῷ",709436,113],["Δαυιδ",703232,114],["καὶ",707031,7],["τῷ",709436,53],["σπέρματι",712008,54],["αὐτοῦ",702165,102],["ἕως",705792,0],["αἰῶνος",700504,18]],"[God] magnifies the deliverances of his king; and deals mercifully with David his anointed, and his seed, for ever."]]