[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["τῷ",709436,113],["δούλῳ",703817,114],["κυρίου",707996,18],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, by David the servant of the Lord."],["2",[["φησὶν",713437,91],["ὁ",709436,3],["παράνομος",710080,14],["τοῦ",709436,20],["ἁμαρτάνειν",700773,55],["ἐν",704639,0],["ἑαυτῷ",703917,50],["οὐκ",709805,28],["ἔστιν",704093,91],["φόβος",713534,4],["θεοῦ",706192,18],["ἀπέναντι",701389,28],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["αὐτοῦ",702165,102]],"The transgressor, that he may sin, says within himself, [that] there is no fear of God before his eyes."],["3",[["ὅτι",709803,7],["ἐδόλωσεν",703788,2],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["τοῦ",709436,20],["εὑρεῖν",705676,106],["τὴν",709436,8],["ἀνομίαν",701192,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["μισῆσαι",708935,106]],"For he has dealt craftily before him, to discover his iniquity and hate it."],["4",[["τὰ",709436,63],["ῥήματα",711246,64],["τοῦ",709436,35],["στόματος",712125,21],["αὐτοῦ",702165,102],["ἀνομία",701192,12],["καὶ",707031,7],["δόλος",703787,4],["οὐκ",709805,28],["ἐβουλήθη",702795,37],["συνιέναι",712481,55],["τοῦ",709436,20],["ἀγαθῦναι",700109,106]],"The words of his mouth are transgression and deceit: he is not inclined to understand [how] to do good."],["5",[["ἀνομίαν",701192,9],["διελογίσατο",703505,23],["ἐπὶ",705080,0],["τῆς",709436,16],["κοίτης",707781,17],["αὐτοῦ",702165,102],["παρέστη",710152,2],["πάσῃ",710177,101],["ὁδῷ",709458,1],["οὐκ",709805,28],["ἀγαθῇ",700106,101],["τῇ",709436,100],["δὲ",703303,11],["κακίᾳ",707054,1],["οὐ",709805,28],["προσώχθισεν",710945,2]],"He devises iniquity on his bed; he gives himself to every evil way; and does not abhor evil."],["6",[["κύριε",707996,153],["ἐν",704639,0],["τῷ",709436,113],["οὐρανῷ",709844,114],["τὸ",709436,34],["ἔλεός",704426,15],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["ἀλήθειά",700656,12],["σου",711945,133],["ἕως",705792,0],["τῶν",709436,130],["νεφελῶν",709277,65]],"O Lord, thy mercy is in the heaven; and thy truth [reaches] to the clouds."],["7",[["ἡ",709436,10],["δικαιοσύνη",703695,12],["σου",711945,133],["ὡσεὶ",714159,28],["ὄρη",709768,64],["θεοῦ",706192,18],["τὰ",709436,63],["κρίματά",707903,64],["σου",711945,133],["ἄβυσσος",700098,12],["πολλή",710646,29],["ἀνθρώπους",701163,57],["καὶ",707031,7],["κτήνη",707934,42],["σώσεις",712627,166],["κύριε",707996,153]],"Thy righteousness is as the mountains of God, thy judgments are as a great deep: O Lord, thou wilt preserve men and beasts."],["8",[["ὡς",714148,7],["ἐπλήθυνας",710530,162],["τὸ",709436,34],["ἔλεός",704426,15],["σου",711945,133],["ὁ",709436,3],["θεός",706192,4],["οἱ",709436,136],["δὲ",703303,11],["υἱοὶ",713075,52],["τῶν",709436,80],["ἀνθρώπων",701163,81],["ἐν",704639,0],["σκέπῃ",711839,1],["τῶν",709436,130],["πτερύγων",711057,65],["σου",711945,133],["ἐλπιοῦσιν",704529,218]],"How hast thou multiplied thy mercy, O God! so the children of men shall trust in the shelter of thy wings."],["9",[["μεθυσθήσονται",708676,144],["ἀπὸ",701425,0],["πιότητος",710479,17],["τοῦ",709436,35],["οἴκου",709516,18],["σου",711945,133],["καὶ",707031,7],["τὸν",709436,5],["χειμάρρουν",713783,27],["τῆς",709436,16],["τρυφῆς",713008,17],["σου",711945,133],["ποτιεῖς",710700,166],["αὐτούς",702165,62]],"They shall be fully satisfied with the fatness of thine house; and thou shalt cause them to drink of the full stream of thy delights."],["10",[["ὅτι",709803,7],["παρὰ",709995,0],["σοὶ",711925,159],["πηγὴ",710450,12],["ζωῆς",705910,17],["ἐν",704639,0],["τῷ",709436,53],["φωτί",713642,54],["σου",711945,133],["ὀψόμεθα",709725,141],["φῶς",713642,25]],"For with thee is the fountain of life: in thy light we shall see light."],["11",[["παράτεινον",710109,176],["τὸ",709436,24],["ἔλεός",704426,25],["σου",711945,133],["τοῖς",709436,147],["γινώσκουσίν",703105,349],["σε",711598,163],["καὶ",707031,7],["τὴν",709436,8],["δικαιοσύνην",703695,9],["σου",711945,133],["τοῖς",709436,147],["εὐθέσι",705602,230],["τῇ",709436,100],["καρδίᾳ",707141,1]],"Extend thy mercy to them that know thee; and thy righteousness to the upright in heart."],["12",[["μὴ",708851,28],["ἐλθέτω",705453,45],["μοι",708974,159],["ποὺς",710707,4],["ὑπερηφανίας",713138,17],["καὶ",707031,7],["χεὶρ",713787,12],["ἁμαρτωλῶν",700776,169],["μὴ",708851,28],["σαλεύσαι",711403,106],["με",708618,163]],"Let not the foot of pride come against me, and let not the hand of sinners move me."],["13",[["ἐκεῖ",704181,28],["ἔπεσον",710481,150],["οἱ",709436,136],["ἐργαζόμενοι",705383,348],["τὴν",709436,8],["ἀνομίαν",701192,9],["ἐξώσθησαν",704949,99],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["δύνωνται",703838,380],["στῆναι",706846,106]],"There have all the workers of iniquity fallen: they are cast out, and shall not be able to stand."]]