[["1",[["τῷ",709436,113],["Δαυιδ",703232,114],["εὐλόγει",705631,240],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["τὸν",709436,5],["κύριον",707996,6],["καί",707031,7],["πάντα",710177,195],["τὰ",709436,63],["ἐντός",704804,28],["μου",709032,133],["τὸ",709436,24],["ὄνομα",709666,25],["τὸ",709436,24],["ἅγιον",700159,46],["αὐτοῦ",702165,102]],"[A Psalm] of David. Bless the Lord, O my soul; and all [that is] within me, [bless] his holy name."],["2",[["εὐλόγει",705631,240],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["μὴ",708851,28],["ἐπιλανθάνου",705187,253],["πάσας",710177,119],["τὰς",709436,38],["ἀνταποδόσεις",701217,39],["αὐτοῦ",702165,102]],"Bless the Lord, O my soul, and forget not all his praises:"],["3",[["τὸν",709436,5],["εὐιλατεύοντα",705607,183],["πάσαις",710177,291],["ταῖς",709436,75],["ἀνομίαις",701192,76],["σου",711945,133],["τὸν",709436,5],["ἰώμενον",706424,212],["πάσας",710177,119],["τὰς",709436,38],["νόσους",709358,39],["σου",711945,133]],"who forgives all thy transgressions, who heals all thy diseases;"],["4",[["τὸν",709436,5],["λυτρούμενον",708282,212],["ἐκ",704132,0],["φθορᾶς",713451,17],["τὴν",709436,8],["ζωήν",705910,9],["σου",711945,133],["τὸν",709436,5],["στεφανοῦντά",712084,183],["σε",711598,163],["ἐν",704639,0],["ἐλέει",704426,54],["καὶ",707031,7],["οἰκτιρμοῖς",709520,148]],"who redeems thy life from corruption; who crowns thee with mercy and compassion;"],["5",[["τὸν",709436,5],["ἐμπιπλῶντα",704592,183],["ἐν",704639,0],["ἀγαθοῖς",700106,230],["τὴν",709436,8],["ἐπιθυμίαν",705147,9],["σου",711945,133],["ἀνακαινισθήσεται",700965,134],["ὡς",714148,11],["ἀετοῦ",700318,18],["ἡ",709436,10],["νεότης",709258,12],["σου",711945,133]],"who satisfies thy desire with good things: [so that] thy youth shall be renewed like [that] of the eagle."],["6",[["ποιῶν",710582,72],["ἐλεημοσύνας",704421,39],["ὁ",709436,3],["κύριος",707996,4],["καὶ",707031,7],["κρίμα",707903,25],["πᾶσι",710177,230],["τοῖς",709436,147],["ἀδικουμένοις",700269,341]],"The Lord executes mercy and judgment for all that are injured."],["7",[["ἐγνώρισεν",703135,2],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτοῦ",702165,102],["τῷ",709436,113],["Μωυσῇ",709112,114],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["τὰ",709436,41],["θελήματα",706170,42],["αὐτοῦ",702165,102]],"He made known his ways to Moses, his will to the children of Israel."],["8",[["οἰκτίρμων",709521,169],["καὶ",707031,7],["ἐλεήμων",704422,14],["ὁ",709436,3],["κύριος",707996,4],["μακρόθυμος",708420,14],["καὶ",707031,7],["πολυέλεος",710624,14]],"The Lord is compassionate and pitiful, long-suffering, and full of mercy."],["9",[["οὐκ",709805,28],["εἰς",704105,0],["τέλος",712787,25],["ὀργισθήσεται",709729,134],["οὐδὲ",709816,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["μηνιεῖ",708880,127]],"He will not be always angry; neither will he be wrathful for ever."],["10",[["οὐ",709805,28],["κατὰ",707200,0],["τὰς",709436,38],["ἁμαρτίας",700775,39],["ἡμῶν",705999,145],["ἐποίησεν",710582,2],["ἡμῖν",705994,90],["οὐδὲ",709816,7],["κατὰ",707200,0],["τὰς",709436,38],["ἀνομίας",701192,39],["ἡμῶν",705999,145],["ἀνταπέδωκεν",701215,2],["ἡμῖν",705994,90]],"He has not dealt with us according to our sins, nor recompensed us according to our iniquities."],["11",[["ὅτι",709803,7],["κατὰ",707200,0],["τὸ",709436,24],["ὕψος",713288,25],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["ἐκραταίωσεν",707875,2],["κύριος",707996,4],["τὸ",709436,34],["ἔλεος",704426,15],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τοὺς",709436,58],["φοβουμένους",713532,236],["αὐτόν",702165,85]],"For as the heaven is high above the earth, the Lord has [so] increased his mercy toward them that fear him."],["12",[["καθ᾿",707200,0],["ὅσον",709788,27],["ἀπέχουσιν",701405,197],["ἀνατολαὶ",701071,191],["ἀπὸ",701425,0],["δυσμῶν",703865,65],["ἐμάκρυνεν",708428,2],["ἀφ᾿",701425,0],["ἡμῶν",705999,145],["τὰς",709436,38],["ἀνομίας",701192,39],["ἡμῶν",705999,145]],"As far as the east is from the west, [so far] has he removed our transgressions from us."],["13",[["καθὼς",707030,28],["οἰκτίρει",709518,91],["πατὴρ",710189,4],["υἱούς",713075,57],["οἰκτίρησεν",709518,2],["κύριος",707996,4],["τοὺς",709436,58],["φοβουμένους",713532,236],["αὐτόν",702165,85]],"As a father pities [his] children, the Lord pities them that fear him."],["14",[["ὅτι",709803,7],["αὐτὸς",702165,121],["ἔγνω",703105,2],["τὸ",709436,24],["πλάσμα",710502,25],["ἡμῶν",705999,145],["μνήσθητι",708960,176],["ὅτι",709803,7],["χοῦς",713930,4],["ἐσμεν",704093,243]],"For he knows our frame: remember that we are dust."],["15",[["ἄνθρωπος",701163,4],["ὡσεὶ",714159,11],["χόρτος",713923,4],["αἱ",709436,190],["ἡμέραι",705984,191],["αὐτοῦ",702165,102],["ὡσεὶ",714159,11],["ἄνθος",701157,25],["τοῦ",709436,35],["ἀγροῦ",700196,18],["οὕτως",709859,28],["ἐξανθήσει",704864,127]],"[As for] man, his days are as grass; as a flower of the field, so shall he flourish."],["16",[["ὅτι",709803,7],["πνεῦμα",710566,15],["διῆλθεν",703673,2],["ἐν",704639,0],["αὐτῷ",702165,50],["καὶ",707031,7],["οὐχ",709805,28],["ὑπάρξει",713104,127],["καὶ",707031,7],["οὐκ",709805,28],["ἐπιγνώσεται",705104,93],["ἔτι",705538,28],["τὸν",709436,5],["τόπον",712903,6],["αὐτοῦ",702165,102]],"For the wind passes over it, and it shall not be; and it shall know its place no more."],["17",[["τὸ",709436,34],["δὲ",703303,11],["ἔλεος",704426,15],["τοῦ",709436,35],["κυρίου",707996,18],["ἀπὸ",701425,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["καὶ",707031,7],["ἕως",705792,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["ἐπὶ",705080,0],["τοὺς",709436,58],["φοβουμένους",713532,236],["αὐτόν",702165,85],["καὶ",707031,7],["ἡ",709436,10],["δικαιοσύνη",703695,12],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["υἱοὺς",713075,57],["υἱῶν",713075,81]],"But the mercy of the Lord is from generation to generation upon them that fear him, and his righteousness to children's children;"],["18",[["τοῖς",709436,147],["φυλάσσουσιν",713619,197],["τὴν",709436,8],["διαθήκην",703456,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["μεμνημένοις",708923,521],["τῶν",709436,130],["ἐντολῶν",704802,65],["αὐτοῦ",702165,102],["τοῦ",709436,20],["ποιῆσαι",710582,106],["αὐτάς",702165,231]],"to them that keep his covenant, and remember his commandments to do them."],["19",[["κύριος",707996,4],["ἐν",704639,0],["τῷ",709436,113],["οὐρανῷ",709844,114],["ἡτοίμασεν",705539,2],["τὸν",709436,5],["θρόνον",706315,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἡ",709436,10],["βασιλεία",702577,12],["αὐτοῦ",702165,102],["πάντων",710177,169],["δεσπόζει",703376,91]],"The Lord has prepared his throne in the heaven; and his kingdom rules over all."],["20",[["εὐλογεῖτε",705631,335],["τὸν",709436,5],["κύριον",707996,6],["πάντες",710177,138],["οἱ",709436,136],["ἄγγελοι",700140,52],["αὐτοῦ",702165,102],["δυνατοὶ",703845,138],["ἰσχύι",706858,1],["ποιοῦντες",710582,146],["τὸν",709436,5],["λόγον",708236,6],["αὐτοῦ",702165,102],["τοῦ",709436,20],["ἀκοῦσαι",700587,106],["τῆς",709436,16],["φωνῆς",713640,17],["τῶν",709436,80],["λόγων",708236,81],["αὐτοῦ",702165,102]],"Bless the Lord, all ye his angels, mighty in strength, who perform his bidding, [ready] to hearken to the voice of his words."],["21",[["εὐλογεῖτε",705631,335],["τὸν",709436,5],["κύριον",707996,6],["πᾶσαι",710177,192],["αἱ",709436,190],["δυνάμεις",703839,191],["αὐτοῦ",702165,102],["λειτουργοὶ",708137,52],["αὐτοῦ",702165,102],["ποιοῦντες",710582,146],["τὸ",709436,24],["θέλημα",706170,25],["αὐτοῦ",702165,102]],"Bless the Lord, all ye his hosts; [ye] ministers of his that do his will."],["22",[["εὐλογεῖτε",705631,335],["τὸν",709436,5],["κύριον",707996,6],["πάντα",710177,195],["τὰ",709436,63],["ἔργα",705396,64],["αὐτοῦ",702165,102],["ἐν",704639,0],["παντὶ",710177,30],["τόπῳ",712903,114],["τῆς",709436,16],["δεσποτείας",703377,17],["αὐτοῦ",702165,102],["εὐλόγει",705631,240],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["τὸν",709436,5],["κύριον",707996,6]],"Bless the 