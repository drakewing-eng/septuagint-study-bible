[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["μὴ",708851,28],["διαφθείρῃς",703624,205],["ψαλμὸς",714022,4],["τῷ",709436,113],["Ασαφ",701894,114],["ᾠδῆς",714091,17]],"For the end, Destroy not, a Psalm of a Song for Asaph."],["2",[["ἐξομολογησόμεθά",704960,141],["σοι",711925,159],["ὁ",709436,3],["θεός",706192,4],["ἐξομολογησόμεθα",704960,141],["καὶ",707031,7],["ἐπικαλεσόμεθα",705153,141],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133]],"We will give thanks to thee, O God, we will give thanks, and call upon thy name: I will declare all thy wonderful works.",{"s":"d","q":0.67}],["3",[["διηγήσομαι",703679,181],["πάντα",710177,68],["τὰ",709436,41],["θαυμάσιά",706136,68],["σου",711945,133],["ὅταν",709801,28],["λάβω",708076,207],["καιρόν",707047,6],["ἐγὼ",704018,164],["εὐθύτητας",705603,39],["κρινῶ",707905,165]],"When I shall take a set time, I will judge righteously.",{"s":"d","q":0.55}],["4",[["ἐτάκη",712839,37],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["κατοικοῦντες",707534,146],["ἐν",704639,0],["αὐτῇ",702165,105],["ἐγὼ",704018,164],["ἐστερέωσα",712076,155],["τοὺς",709436,58],["στύλους",712179,57],["αὐτῆς",702165,86],["διάψαλμα",703641,15]],"The earth is dissolved, and all that dwell in it: I have strengthened its pillars. Pause."],["5",[["εἶπα",705373,155],["τοῖς",709436,147],["παρανομοῦσιν",710078,197],["μὴ",708851,28],["παρανομεῖτε",710078,335],["καὶ",707031,7],["τοῖς",709436,147],["ἁμαρτάνουσιν",700773,197],["μὴ",708851,28],["ὑψοῦτε",713289,335],["κέρας",707625,25]],"I said unto the transgressors, Do not transgress; and to the sinners, Lift not up the horn."],["6",[["μὴ",708851,28],["ἐπαίρετε",705002,335],["εἰς",704105,0],["ὕψος",713288,25],["τὸ",709436,24],["κέρας",707625,25],["ὑμῶν",713091,145],["μὴ",708851,28],["λαλεῖτε",708071,335],["κατὰ",707200,0],["τοῦ",709436,35],["θεοῦ",706192,18],["ἀδικίαν",700271,9]],"Lift not up your horn on high; speak not unrighteousness against God."],["7",[["ὅτι",709803,7],["οὔτε",709857,7],["ἀπὸ",701425,0],["ἐξόδων",704948,65],["οὔτε",709857,7],["ἀπὸ",701425,0],["δυσμῶν",703865,65],["οὔτε",709857,7],["ἀπὸ",701425,0],["ἐρήμων",705420,65],["ὀρέων",709768,44]],"For [good comes] neither from the east, nor from the west, nor from the desert mountains."],["8",[["ὅτι",709803,7],["ὁ",709436,3],["θεὸς",706192,4],["κριτής",707910,4],["ἐστιν",704093,91],["τοῦτον",709858,85],["ταπεινοῖ",712717,91],["καὶ",707031,7],["τοῦτον",709858,85],["ὑψοῖ",713289,91]],"For God is the judge; he puts down one, and raises up another."],["9",[["ὅτι",709803,7],["ποτήριον",710699,15],["ἐν",704639,0],["χειρὶ",713787,1],["κυρίου",707996,18],["οἴνου",709530,18],["ἀκράτου",700593,116],["πλῆρες",710541,26],["κεράσματος",707626,21],["καὶ",707031,7],["ἔκλινεν",707738,13],["ἐκ",704132,0],["τούτου",709858,102],["εἰς",704105,0],["τοῦτο",709858,129],["πλὴν",710540,28],["ὁ",709436,3],["τρυγίας",712999,4],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐξεκενώθη",704210,37],["πίονται",710478,135],["πάντες",710177,138],["οἱ",709436,136],["ἁμαρτωλοὶ",700776,138],["τῆς",709436,16],["γῆς",703083,17]],"For [there is] a cup in the hand of the Lord, full of unmingled wine; and he has turned [it] from side to side, but its dregs have not been wholly poured out; all the sinners of the earth shall drink [them]."],["10",[["ἐγὼ",704018,164],["δὲ",703303,11],["ἀγαλλιάσομαι",700114,181],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ψαλῶ",714021,165],["τῷ",709436,113],["θεῷ",706192,114],["Ιακωβ",706401,18]],"But I will exult for ever: I will sing praises to the God of Jacob."],["11",[["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["κέρατα",707625,42],["τῶν",709436,80],["ἁμαρτωλῶν",700776,169],["συγκλάσω",712216,165],["καὶ",707031,7],["ὑψωθήσεται",713289,134],["τὰ",709436,41],["κέρατα",707625,42],["τοῦ",709436,35],["δικαίου",703694,116]],"And I will break all the horns of sinners; but the horns of the righteous one shall be exalted."]]