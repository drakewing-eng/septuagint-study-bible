[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, a Psalm of David."],["2",[["ἐπακούσαι",705009,300],["σου",711945,133],["κύριος",707996,4],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["θλίψεως",706276,17],["ὑπερασπίσαι",713121,300],["σου",711945,133],["τὸ",709436,24],["ὄνομα",709666,25],["τοῦ",709436,35],["θεοῦ",706192,18],["Ιακωβ",706401,18]],"The Lord hear thee in the day of trouble; the name of the God of Jacob defend thee."],["3",[["ἐξαποστείλαι",704872,106],["σοι",711925,159],["βοήθειαν",702745,9],["ἐξ",704132,0],["ἁγίου",700159,116],["καὶ",707031,7],["ἐκ",704132,0],["Σιων",711816,118],["ἀντιλάβοιτό",701243,382],["σου",711945,133]],"Send thee help from the sanctuary, and aid thee out of Sion."],["4",[["μνησθείη",708923,528],["πάσης",710177,82],["θυσίας",706345,17],["σου",711945,133],["καὶ",707031,7],["τὸ",709436,24],["ὁλοκαύτωμά",709589,25],["σου",711945,133],["πιανάτω",710464,45],["διάψαλμα",703641,15]],"Remember all thy sacrifice, and enrich thy whole-burnt-offering. Pause."],["5",[["δῴη",703654,225],["σοι",711925,159],["κατὰ",707200,0],["τὴν",709436,8],["καρδίαν",707141,9],["σου",711945,133],["καὶ",707031,7],["πᾶσαν",710177,36],["τὴν",709436,8],["βουλήν",702792,9],["σου",711945,133],["πληρώσαι",710543,300]],"Grant thee according to thy heart, and fulfil all thy desire."],["6",[["ἀγαλλιασόμεθα",700114,141],["ἐν",704639,0],["τῷ",709436,53],["σωτηρίῳ",712659,54],["σου",711945,133],["καὶ",707031,7],["ἐν",704639,0],["ὀνόματι",709666,54],["θεοῦ",706192,18],["ἡμῶν",705999,145],["μεγαλυνθησόμεθα",708647,347],["πληρώσαι",710543,300],["κύριος",707996,4],["πάντα",710177,27],["τὰ",709436,41],["αἰτήματά",700490,42],["σου",711945,133]],"We will exult in thy salvation, and in the name of our God shall we be magnified: the Lord fulfil all thy petitions."],["7",[["νῦν",709384,28],["ἔγνων",703105,155],["ὅτι",709803,7],["ἔσωσεν",712627,2],["κύριος",707996,4],["τὸν",709436,5],["χριστὸν",713964,27],["αὐτοῦ",702165,102],["ἐπακούσεται",705009,93],["αὐτοῦ",702165,102],["ἐξ",704132,0],["οὐρανοῦ",709844,18],["ἁγίου",700159,116],["αὐτοῦ",702165,102],["ἐν",704639,0],["δυναστείαις",703841,76],["ἡ",709436,10],["σωτηρία",712658,12],["τῆς",709436,16],["δεξιᾶς",703360,82],["αὐτοῦ",702165,102]],"Now I know that the Lord has saved his Christ: he shall hear him from his holy heaven: the salvation of his right hand is mighty."],["8",[["οὗτοι",709858,201],["ἐν",704639,0],["ἅρμασιν",701768,96],["καὶ",707031,7],["οὗτοι",709858,201],["ἐν",704639,0],["ἵπποις",706790,148],["ἡμεῖς",705983,219],["δὲ",703303,11],["ἐν",704639,0],["ὀνόματι",709666,54],["κυρίου",707996,18],["θεοῦ",706192,18],["ἡμῶν",705999,145],["μεγαλυνθησόμεθα",708647,347]],"Some [glory] in chariots, and some in horses: but we will glory in the name of the Lord our God."],["9",[["αὐτοὶ",702165,201],["συνεποδίσθησαν",712338,99],["καὶ",707031,7],["ἔπεσαν",710481,150],["ἡμεῖς",705983,219],["δὲ",703303,11],["ἀνέστημεν",701173,289],["καὶ",707031,7],["ἀνωρθώθημεν",701197,485]],"They are overthrown and fallen: but we are risen, and have been set upright."],["10",[["κύριε",707996,153],["σῶσον",712627,176],["τὸν",709436,5],["βασιλέα",702580,6],["σου",711945,133],["καὶ",707031,7],["ἐπάκουσον",705009,176],["ἡμῶν",705999,145],["ἐν",704639,0],["ᾗ",709781,108],["ἂν",700900,11],["ἡμέρᾳ",705984,1],["ἐπικαλεσώμεθά",705153,276],["σε",711598,163]],"O Lord, save the king: and hear us in whatever day we call upon thee."]]