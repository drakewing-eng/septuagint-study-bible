[["1",[["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114],["κύριος",707996,4],["ποιμαίνει",710594,91],["με",708618,163],["καὶ",707031,7],["οὐδέν",709817,26],["με",708618,163],["ὑστερήσει",713270,127]],"A Psalm of David. The Lord tends me as a shepherd, and I shall want nothing."],["2",[["εἰς",704105,0],["τόπον",712903,6],["χλόης",713877,17],["ἐκεῖ",704181,28],["με",708618,163],["κατεσκήνωσεν",707423,2],["ἐπὶ",705080,0],["ὕδατος",713071,21],["ἀναπαύσεως",701026,17],["ἐξέθρεψέν",704342,2],["με",708618,163]],"In a place of green grass, there he has made me dwell: he has nourished me by the water of rest."],["3",[["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἐπέστρεψεν",705278,2],["ὡδήγησέν",709448,2],["με",708618,163],["ἐπὶ",705080,0],["τρίβους",712939,39],["δικαιοσύνης",703695,17],["ἕνεκεν",704709,0],["τοῦ",709436,20],["ὀνόματος",709666,21],["αὐτοῦ",702165,102]],"He has restored my soul: he has guided me into the paths of righteousness, for his name's sake."],["4",[["ἐὰν",703912,7],["γὰρ",702963,11],["καὶ",707031,7],["πορευθῶ",710667,321],["ἐν",704639,0],["μέσῳ",708768,30],["σκιᾶς",711852,17],["θανάτου",706096,18],["οὐ",709805,28],["φοβηθήσομαι",713532,180],["κακά",707066,68],["ὅτι",709803,7],["σὺ",712181,164],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["εἶ",704093,154],["ἡ",709436,10],["ῥάβδος",711135,12],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["βακτηρία",702459,12],["σου",711945,133],["αὐταί",702165,202],["με",708618,163],["παρεκάλεσαν",710039,150]],"Yea, even if I should walk in the midst of the shadow of death, I will not be afraid of evils: for thou art with me; thy rod and thy staff, these have comforted me."],["5",[["ἡτοίμασας",705539,162],["ἐνώπιόν",704823,0],["μου",709032,133],["τράπεζαν",712919,9],["ἐξ",704132,0],["ἐναντίας",704656,82],["τῶν",709436,80],["θλιβόντων",706274,170],["με",708618,163],["ἐλίπανας",708215,162],["ἐν",704639,0],["ἐλαίῳ",704380,54],["τὴν",709436,8],["κεφαλήν",707639,9],["μου",709032,133],["καὶ",707031,7],["τὸ",709436,34],["ποτήριόν",710699,15],["σου",711945,133],["μεθύσκον",708676,32],["ὡς",714148,7],["κράτιστον",707891,654]],"Thou hast prepared a table before me in presence of them that afflict me: thou hast thoroughly anointed my head with oil; and thy cup cheers me like the best [wine]."],["6",[["καὶ",707031,7],["τὸ",709436,34],["ἔλεός",704426,15],["σου",711945,133],["καταδιώξεταί",707243,93],["με",708618,163],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["τῆς",709436,16],["ζωῆς",705910,17],["μου",709032,133],["καὶ",707031,7],["τὸ",709436,24],["κατοικεῖν",707534,55],["με",708618,163],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18],["εἰς",704105,0],["μακρότητα",708423,9],["ἡμερῶν",705984,65]],"Thy mercy also shall follow me all the days of my life: and my dwelling [shall be] in the house of the Lord for a very long time."]]