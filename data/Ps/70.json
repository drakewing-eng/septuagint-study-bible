[["1",[["τῷ",709436,113],["Δαυιδ",703232,114],["υἱῶν",713075,81],["Ιωναδαβ",706924,18],["καὶ",707031,7],["τῶν",709436,80],["πρώτων",711041,616],["αἰχμαλωτισθέντων",700501,249],["ὁ",709436,3],["θεός",706192,4],["ἐπὶ",705080,0],["σοὶ",711925,159],["ἤλπισα",704529,155],["μὴ",708851,28],["καταισχυνθείην",707257,727],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"By David, [a Psalm sung by] the sons of Jonadab, and the first that were taken captive. O Lord, I have hoped in thee: let me never be put to shame."],["2",[["ἐν",704639,0],["τῇ",709436,100],["δικαιοσύνῃ",703695,1],["σου",711945,133],["ῥῦσαί",711309,300],["με",708618,163],["καὶ",707031,7],["ἐξελοῦ",704838,300],["με",708618,163],["κλῖνον",707738,176],["πρός",710844,0],["με",708618,163],["τὸ",709436,24],["οὖς",709852,25],["σου",711945,133],["καὶ",707031,7],["σῶσόν",712627,176],["με",708618,163]],"In thy righteousness deliver me and rescue me: incline thine ear to me, and save me."],["3",[["γενοῦ",703104,300],["μοι",708974,159],["εἰς",704105,0],["θεὸν",706192,6],["ὑπερασπιστὴν",713123,6],["καὶ",707031,7],["εἰς",704105,0],["τόπον",712903,6],["ὀχυρὸν",709889,27],["τοῦ",709436,20],["σῶσαί",712627,106],["με",708618,163],["ὅτι",709803,7],["στερέωμά",712077,15],["μου",709032,133],["καὶ",707031,7],["καταφυγή",707485,12],["μου",709032,133],["εἶ",704093,154],["σύ",712181,164]],"Be to me a protecting God, and a strong hold to save me: for thou art my fortress and my refuge."],["4",[["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["ῥῦσαί",711309,300],["με",708618,163],["ἐκ",704132,0],["χειρὸς",713787,17],["ἁμαρτωλοῦ",700776,116],["ἐκ",704132,0],["χειρὸς",713787,17],["παρανομοῦντος",710078,152],["καὶ",707031,7],["ἀδικοῦντος",700269,152]],"Deliver me, O my God, from the hand of the sinner, from the hand of the transgressor and unjust man."],["5",[["ὅτι",709803,7],["σὺ",712181,164],["εἶ",704093,154],["ἡ",709436,10],["ὑπομονή",713226,12],["μου",709032,133],["κύριε",707996,153],["κύριος",707996,4],["ἡ",709436,10],["ἐλπίς",704530,12],["μου",709032,133],["ἐκ",704132,0],["νεότητός",709258,17],["μου",709032,133]],"For thou art my support, O Lord; O Lord, [thou art] my hope from my youth."],["6",[["ἐπὶ",705080,0],["σὲ",711598,163],["ἐπεστηρίχθην",705270,156],["ἀπὸ",701425,0],["γαστρός",702976,17],["ἐκ",704132,0],["κοιλίας",707761,17],["μητρός",708892,17],["μου",709032,133],["σύ",712181,164],["μου",709032,133],["εἶ",704093,154],["σκεπαστής",711836,4],["ἐν",704639,0],["σοὶ",711925,159],["ἡ",709436,10],["ὕμνησίς",713086,12],["μου",709032,133],["διὰ",703417,0],["παντός",710177,116]],"On thee have I been stayed from the womb: from the belly of my mother thou art my protector: of thee is my praise continually."],["7",[["ὡσεὶ",714159,7],["τέρας",712793,15],["ἐγενήθην",703104,156],["τοῖς",709436,147],["πολλοῖς",710646,230],["καὶ",707031,7],["σὺ",712181,164],["βοηθὸς",702748,4],["κραταιός",707873,14]],"I am become as it were a wonder to many; but thou art [my] strong helper."],["8",[["πληρωθήτω",710543,22],["τὸ",709436,24],["στόμα",712125,25],["μου",709032,133],["αἰνέσεως",700457,17],["ὅπως",709719,7],["ὑμνήσω",713085,165],["τὴν",709436,8],["δόξαν",703791,9],["σου",711945,133],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["τὴν",709436,8],["μεγαλοπρέπειάν",708632,9],["σου",711945,133]],"Let my mouth be filled with praise, that I may hymn thy glory, [and] thy majesty all the day."],["9",[["μὴ",708851,28],["ἀπορρίψῃς",701563,175],["με",708618,163],["εἰς",704105,0],["καιρὸν",707047,6],["γήρους",703089,21],["ἐν",704639,0],["τῷ",709436,53],["ἐκλείπειν",704237,55],["τὴν",709436,8],["ἰσχύν",706858,9],["μου",709032,133],["μὴ",708851,28],["ἐγκαταλίπῃς",703967,175],["με",708618,163]],"Cast me not off at the time of old age; forsake me not when my strength fails."],["10",[["ὅτι",709803,7],["εἶπαν",705373,150],["οἱ",709436,136],["ἐχθροί",705779,52],["μου",709032,133],["ἐμοὶ",704577,159],["καὶ",707031,7],["οἱ",709436,136],["φυλάσσοντες",713619,146],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἐβουλεύσαντο",702791,189],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτὸ",702165,129]],"For mine enemies have spoken against me; and they that lay wait for my soul have taken counsel together,"],["11",[["λέγοντες",708124,146],["ὁ",709436,3],["θεὸς",706192,4],["ἐγκατέλιπεν",703967,2],["αὐτόν",702165,85],["καταδιώξατε",707243,74],["καὶ",707031,7],["καταλάβετε",707300,74],["αὐτόν",702165,85],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ὁ",709436,3],["ῥυόμενος",711309,122]],"saying, God has forsaken him: persecute ye and take him; for there is none to deliver [him]."],["12",[["ὁ",709436,3],["θεός",706192,4],["μὴ",708851,28],["μακρύνῃς",708428,175],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["εἰς",704105,0],["τὴν",709436,8],["βοήθειάν",702745,9],["μου",709032,133],["πρόσχες",710895,176]],"O God, go not far from me, O my God, draw nigh to my help."],["13",[["αἰσχυνθήτωσαν",700485,51],["καὶ",707031,7],["ἐκλιπέτωσαν",704237,264],["οἱ",709436,136],["ἐνδιαβάλλοντες",704686,146],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["περιβαλέσθωσαν",710294,486],["αἰσχύνην",700483,9],["καὶ",707031,7],["ἐντροπὴν",704809,9],["οἱ",709436,136],["ζητοῦντες",705879,146],["τὰ",709436,41],["κακά",707066,68],["μοι",708974,159]],"Let those that plot against my soul be ashamed and utterly fail: let those that seek my hurt be clothed with shame and dishonour."],["14",[["ἐγὼ",704018,164],["δὲ",703303,11],["διὰ",703417,0],["παντὸς",710177,116],["ἐλπιῶ",704529,165],["καὶ",707031,7],["προσθήσω",710965,165],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["τὴν",709436,8],["αἴνεσίν",700457,9],["σου",711945,133]],"But I will hope continually, and will praise thee more and more."],["15",[["τὸ",709436,34],["στόμα",712125,15],["μου",709032,133],["ἐξαγγελεῖ",704829,127],["τὴν",709436,8],["δικαιοσύνην",703695,9],["σου",711945,133],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["τὴν",709436,8],["σωτηρίαν",712658,9],["σου",711945,133],["ὅτι",709803,7],["οὐκ",709805,28],["ἔγνων",703105,155],["γραμματείας",703184,39]],"My mouth shall declare thy righteousness openly, [and] thy salvation all the day; for I am not acquainted with the affairs [of men]."],["16",[["εἰσελεύσομαι",704114,181],["ἐν",704639,0],["δυναστείᾳ",703841,1],["κυρίου",707996,18],["κύριε",707996,153],["μνησθήσομαι",708923,180],["τῆς",709436,16],["δικαιοσύνης",703695,17],["σου",711945,133],["μόνου",709003,116]],"I will go on in the might of the Lord: O Lord, I will make mention of thy righteousness only."],["17",[["ἐδίδαξάς",703649,162],["με",708618,163],["ὁ",709436,3],["θεός",706192,4],["ἐκ",704132,0],["νεότητός",709258,17],["μου",709032,133],["καὶ",707031,7],["μέχρι",708849,0],["νῦν",709384,28],["ἀπαγγελῶ",701321,165],["τὰ",709436,41],["θαυμάσιά",706136,68],["σου",711945,133]],"O God, thou hast taught me from my youth, and until now will I declare thy wonders;"],["18",[["καὶ",707031,7],["ἕως",705792,0],["γήρους",703089,21],["καὶ",707031,7],["πρεσβείου",710730,21],["ὁ",709436,3],["θεός",706192,4],["μὴ",708851,28],["ἐγκαταλίπῃς",703967,175],["με",708618,163],["ἕως",705792,0],["ἂν",700900,11],["ἀπαγγείλω",701321,207],["τὸν",709436,5],["βραχίονά",702808,6],["σου",711945,133],["πάσῃ",710177,101],["τῇ",709436,100],["γενεᾷ",703037,1],["τῇ",709436,100],["ἐρχομένῃ",705453,585],["τὴν",709436,8],["δυναστείαν",703841,9],["σου",711945,133],["καὶ",707031,7],["τὴν",709436,8],["δικαιοσύνην",703695,9],["σου",711945,133]],"even until I am old and advanced in years. O God, forsake me not; until I shall have declared thine arm to all the generation that is to come:"],["19",[["ὁ",709436,3],["θεός",706192,4],["ἕως",705792,0],["ὑψίστων",713287,169],["ἃ",709781,69],["ἐποίησας",710582,162],["μεγαλεῖα",708625,68],["ὁ",709436,3],["θεός",706192,4],["τίς",712867,158],["ὅμοιός",709626,14],["σοι",711925,159]],"even thy power and thy righteousness, O God, up to the highest [heavens, even] the mighty works which thou hast done: O God, who is like to thee?"],["20",[["ὅσας",709788,119],["ἔδειξάς",703314,162],["μοι",708974,159],["θλίψεις",706276,39],["πολλὰς",710646,119],["καὶ",707031,7],["κακάς",707066,119],["καὶ",707031,7],["ἐπιστρέψας",705278,182],["ἐζωοποίησάς",705917,162],["με",708618,163],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,130],["ἀβύσσων",700098,65],["τῆς",709436,16],["γῆς",703083,17],["πάλιν",709942,28],["ἀνήγαγές",700933,162],["με",708618,163]],"What afflictions many and sore hast thou shewed me! yet thou didst turn and quicken me, and broughtest me again from the depths of the earth."],["21",[["ἐπλεόνασας",710516,162],["τὴν",709436,8],["μεγαλοσύνην",708642,9],["σου",711945,133],["καὶ",707031,7],["ἐπιστρέψας",705278,182],["παρεκάλεσάς",710039,162],["με",708618,163],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,130],["ἀβύσσων",700098,65],["τῆς",709436,16],["γῆς",703083,17],["πάλιν",709942,28],["ἀνήγαγές",700933,162],["με",708618,163]],"Thou didst multiply thy righteousness, and didst turn and comfort me, and broughtest me again out of the depths of the earth."],["22",[["καὶ",707031,7],["γὰρ",702963,11],["ἐγὼ",704018,164],["ἐξομολογήσομαί",704960,181],["σοι",711925,159],["ἐν",704639,0],["σκεύει",711844,54],["ψαλμοῦ",714022,18],["τὴν",709436,8],["ἀλήθειάν",700656,12],["σου",711945,133],["ὁ",709436,3],["θεός",706192,4],["ψαλῶ",714021,165],["σοι",711925,159],["ἐν",704639,0],["κιθάρᾳ",707669,1],["ὁ",709436,3],["ἅγιος",700159,14],["τοῦ",709436,35],["Ισραηλ",706839,18]],"I will also therefore give thanks to thee, O God, [because of] thy truth, on an instrument of psalmody: I will sing psalms to thee on the harp, O Holy One of Israel."],["23",[["ἀγαλλιάσονται",700114,135],["τὰ",709436,63],["χείλη",713781,64],["μου",709032,133],["ὅταν",709801,28],["ψάλω",714021,207],["σοι",711925,159],["καὶ",707031,7],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ἣν",709781,131],["ἐλυτρώσω",708282,174]],"My lips shall rejoice when I sing to thee; and my soul, which thou hast redeemed."],["24",[["ἔτι",705538,28],["δὲ",703303,11],["καὶ",707031,7],["ἡ",709436,10],["γλῶσσά",703120,12],["μου",709032,133],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["μελετήσει",708698,127],["τὴν",709436,8],["δικαιοσύνην",703695,9],["σου",711945,133],["ὅταν",709801,28],["αἰσχυνθῶσιν",700485,272],["καὶ",707031,7],["ἐντραπῶσιν",704805,234],["οἱ",709436,136],["ζητοῦντες",705879,146],["τὰ",709436,41],["κακά",707066,68],["μοι",708974,159]],"Moreover also my tongue shall dwell all the day upon thy righteousness; when they shall be ashamed and confounded that seek my hurt."]]