[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, a Psalm of David."],["2",[["οἱ",709436,136],["οὐρανοὶ",709844,52],["διηγοῦνται",703679,269],["δόξαν",703791,9],["θεοῦ",706192,18],["ποίησιν",710584,9],["δὲ",703303,11],["χειρῶν",713787,65],["αὐτοῦ",702165,102],["ἀναγγέλλει",700921,91],["τὸ",709436,34],["στερέωμα",712077,15]],"The heavens declare the glory of God; and the firmament proclaims the work of his hands."],["3",[["ἡμέρα",705984,12],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐρεύγεται",705410,117],["ῥῆμα",711246,25],["καὶ",707031,7],["νὺξ",709386,12],["νυκτὶ",709386,1],["ἀναγγέλλει",700921,91],["γνῶσιν",703138,9]],"Day to day utters speech, and night to night proclaims knowledge."],["4",[["οὐκ",709805,28],["εἰσὶν",704093,197],["λαλιαὶ",708074,191],["οὐδὲ",709816,7],["λόγοι",708236,52],["ὧν",709781,252],["οὐχὶ",709862,28],["ἀκούονται",700587,269],["αἱ",709436,190],["φωναὶ",713640,191],["αὐτῶν",702165,40]],"There are no speeches or words, in which their voices are not heard."],["5",[["εἰς",704105,0],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9],["ἐξῆλθεν",704909,2],["ὁ",709436,3],["φθόγγος",713447,4],["αὐτῶν",702165,40],["καὶ",707031,7],["εἰς",704105,0],["τὰ",709436,41],["πέρατα",710281,42],["τῆς",709436,16],["οἰκουμένης",709517,422],["τὰ",709436,63],["ῥήματα",711246,64],["αὐτῶν",702165,40],["ἐν",704639,0],["τῷ",709436,113],["ἡλίῳ",705974,114],["ἔθετο",712849,23],["τὸ",709436,24],["σκήνωμα",711849,25],["αὐτοῦ",702165,102]],"Their voice is gone out into all the earth, and their words to the ends of the world."],["6",[["καὶ",707031,7],["αὐτὸς",702165,121],["ὡς",714148,7],["νυμφίος",709382,4],["ἐκπορευόμενος",704293,122],["ἐκ",704132,0],["παστοῦ",710180,18],["αὐτοῦ",702165,102],["ἀγαλλιάσεται",700114,93],["ὡς",714148,7],["γίγας",703101,4],["δραμεῖν",712931,106],["ὁδὸν",709458,9],["αὐτοῦ",702165,102]],"In the sun he has set his tabernacle; and he comes forth as a bridegroom out of his chamber: he will exult as a giant to run his course."],["7",[["ἀπ᾿",701425,0],["ἄκρου",700608,116],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["ἡ",709436,10],["ἔξοδος",704948,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὸ",709436,34],["κατάντημα",707344,15],["αὐτοῦ",702165,102],["ἕως",705792,0],["ἄκρου",700608,116],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ὃς",709781,213],["ἀποκρυβήσεται",701495,134],["τὴν",709436,8],["θέρμην",706217,36],["αὐτοῦ",702165,102]],"His going forth is from the extremity of heaven, and his circuit to the [other] end of heaven: and no one shall be hidden from his heat."],["8",[["ὁ",709436,3],["νόμος",709349,4],["τοῦ",709436,35],["κυρίου",707996,18],["ἄμωμος",700895,14],["ἐπιστρέφων",705278,72],["ψυχάς",714070,39],["ἡ",709436,10],["μαρτυρία",708524,12],["κυρίου",707996,18],["πιστή",710486,29],["σοφίζουσα",711982,188],["νήπια",709295,68]],"The law of the Lord is perfect, converting souls: the testimony of the Lord is faithful, instructing babes."],["9",[["τὰ",709436,63],["δικαιώματα",703697,64],["κυρίου",707996,18],["εὐθεῖα",705602,29],["εὐφραίνοντα",705715,242],["καρδίαν",707141,9],["ἡ",709436,10],["ἐντολὴ",704802,12],["κυρίου",707996,18],["τηλαυγής",712841,29],["φωτίζουσα",713646,188],["ὀφθαλμούς",709870,57]],"The ordinances of the Lord are right, rejoicing the heart: the commandment of the Lord is bright, enlightening the eyes."],["10",[["ὁ",709436,3],["φόβος",713534,4],["κυρίου",707996,18],["ἁγνός",700178,14],["διαμένων",703517,72],["εἰς",704105,0],["αἰῶνα",700504,6],["αἰῶνος",700504,18],["τὰ",709436,63],["κρίματα",707903,64],["κυρίου",707996,18],["ἀληθινά",700659,195],["δεδικαιωμένα",703696,443],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτό",702165,129]],"The fear of the Lord is pure, enduring for ever and ever: the judgments of the Lord are true, [and] justified altogether."],["11",[["ἐπιθυμητὰ",705146,195],["ὑπὲρ",713111,0],["χρυσίον",713972,25],["καὶ",707031,7],["λίθον",708196,6],["τίμιον",712858,27],["πολὺν",710646,27],["καὶ",707031,7],["γλυκύτερα",703114,344],["ὑπὲρ",713111,0],["μέλι",708700,25],["καὶ",707031,7],["κηρίον",707657,25]],"To be desired more than gold, and much precious stone: sweeter also than honey and the honey-comb."],["12",[["καὶ",707031,7],["γὰρ",702963,11],["ὁ",709436,3],["δοῦλός",703817,4],["σου",711945,133],["φυλάσσει",713619,91],["αὐτά",702165,71],["ἐν",704639,0],["τῷ",709436,53],["φυλάσσειν",713619,55],["αὐτὰ",702165,71],["ἀνταπόδοσις",701217,12],["πολλή",710646,29]],"For thy servant keeps to them: in the keeping of them [there is] great reward."],["13",[["παραπτώματα",710095,64],["τίς",712867,158],["συνήσει",712481,127],["ἐκ",704132,0],["τῶν",709436,80],["κρυφίων",707930,169],["μου",709032,133],["καθάρισόν",706985,176],["με",708618,163]],"Who will understand [his] transgressions? purge thou me from my secret [sins]."],["14",[["καὶ",707031,7],["ἀπὸ",701425,0],["ἀλλοτρίων",700699,169],["φεῖσαι",713406,300],["τοῦ",709436,35],["δούλου",703817,18],["σου",711945,133],["ἐὰν",703912,7],["μή",708851,28],["μου",709032,133],["κατακυριεύσωσιν",707297,234],["τότε",712908,28],["ἄμωμος",700895,14],["ἔσομαι",704093,181],["καὶ",707031,7],["καθαρισθήσομαι",706985,180],["ἀπὸ",701425,0],["ἁμαρτίας",700775,17],["μεγάλης",708653,82]],"And spare thy servant [the attack] of strangers: if they do not gain the dominion over me, then shall I be blameless, and I shall be clear from great sin."],["15",[["καὶ",707031,7],["ἔσονται",704093,135],["εἰς",704105,0],["εὐδοκίαν",705566,9],["τὰ",709436,63],["λόγια",708233,64],["τοῦ",709436,20],["στόματός",712125,21],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["μελέτη",708699,12],["τῆς",709436,16],["καρδίας",707141,17],["μου",709032,133],["ἐνώπιόν",704823,0],["σου",711945,133],["διὰ",703417,0],["παντός",710177,116],["κύριε",707996,153],["βοηθέ",702748,153],["μου",709032,133],["καὶ",707031,7],["λυτρωτά",708285,153],["μου",709032,133]],"So shall the sayings of my mouth, and the meditation of my heart, be pleasing continually before thee, O Lord my helper, and my redeemer."]]