[["1",[["αλληλουια",700688,88],["ἐξομολογεῖσθε",704960,73],["τῷ",709436,113],["κυρίῳ",707996,114],["ὅτι",709803,7],["χρηστός",713958,14],["ὅτι",709803,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τὸ",709436,34],["ἔλεος",704426,15],["αὐτοῦ",702165,102]],"Alleluia. Give thanks to the Lord, for he is good; for his mercy [endures] for ever."],["2",[["εἰπάτωσαν",705373,264],["οἱ",709436,136],["λελυτρωμένοι",708282,429],["ὑπὸ",713184,0],["κυρίου",707996,18],["οὓς",709781,298],["ἐλυτρώσατο",708282,23],["ἐκ",704132,0],["χειρὸς",713787,17],["ἐχθροῦ",705779,18]],"Let them say [so] who have been redeemed by the Lord, whom he has redeemed from the hand of the enemy;"],["3",[["ἐκ",704132,0],["τῶν",709436,130],["χωρῶν",714011,65],["συνήγαγεν",712375,2],["αὐτοὺς",702165,62],["ἀπὸ",701425,0],["ἀνατολῶν",701071,65],["καὶ",707031,7],["δυσμῶν",703865,65],["καὶ",707031,7],["βορρᾶ",702765,18],["καὶ",707031,7],["θαλάσσης",706069,17]],"and gathered them out of the countries, from the east, and west, and north, and south."],["4",[["ἐπλανήθησαν",710495,99],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["ἐν",704639,0],["ἀνύδρῳ",701285,30],["ὁδὸν",709458,9],["πόλεως",710612,17],["κατοικητηρίου",707536,21],["οὐχ",709805,28],["εὗρον",705676,150]],"They wandered in the wilderness in a dry land; they found no way to a city of habitation."],["5",[["πεινῶντες",710222,146],["καὶ",707031,7],["διψῶντες",703763,146],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτῶν",702165,40],["ἐν",704639,0],["αὐτοῖς",702165,151],["ἐξέλιπεν",704237,2]],"Hungry and thirsty, their soul fainted in them."],["6",[["καὶ",707031,7],["ἐκέκραξαν",707868,150],["πρὸς",710844,0],["κύριον",707996,6],["ἐν",704639,0],["τῷ",709436,53],["θλίβεσθαι",706274,110],["αὐτούς",702165,62],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,130],["ἀναγκῶν",700925,65],["αὐτῶν",702165,40],["ἐρρύσατο",711309,23],["αὐτοὺς",702165,62]],"Then they cried to the Lord in their affliction, and he delivered them out of their distresses."],["7",[["καὶ",707031,7],["ὡδήγησεν",709448,2],["αὐτοὺς",702165,62],["εἰς",704105,0],["ὁδὸν",709458,9],["εὐθεῖαν",705602,36],["τοῦ",709436,20],["πορευθῆναι",710667,179],["εἰς",704105,0],["πόλιν",710612,9],["κατοικητηρίου",707536,21]],"And he guided them into a straight path, that they might go to a city of habitation."],["8",[["ἐξομολογησάσθωσαν",704960,486],["τῷ",709436,113],["κυρίῳ",707996,114],["τὰ",709436,41],["ἐλέη",704426,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["θαυμάσια",706136,68],["αὐτοῦ",702165,102],["τοῖς",709436,147],["υἱοῖς",713075,148],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"Let them acknowledge to the Lord his mercies, and his wonderful works to the children of men."],["9",[["ὅτι",709803,7],["ἐχόρτασεν",713919,2],["ψυχὴν",714070,9],["κενὴν",707612,36],["καὶ",707031,7],["ψυχὴν",714070,9],["πεινῶσαν",710222,78],["ἐνέπλησεν",704592,2],["ἀγαθῶν",700106,169]],"For he satisfies the empty soul, and fills the hungry [soul] with good things,"],["10",[["καθημένους",707000,236],["ἐν",704639,0],["σκότει",711889,54],["καὶ",707031,7],["σκιᾷ",711852,1],["θανάτου",706096,18],["πεπεδημένους",710208,360],["ἐν",704639,0],["πτωχείᾳ",711073,1],["καὶ",707031,7],["σιδήρῳ",711774,114]],"[even] them that sit in darkness and the shadow of death, fettered in poverty and iron;"],["11",[["ὅτι",709803,7],["παρεπίκραναν",710087,150],["τὰ",709436,41],["λόγια",708233,42],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["τὴν",709436,8],["βουλὴν",702792,9],["τοῦ",709436,35],["ὑψίστου",713287,116],["παρώξυναν",710164,150]],"because they rebelled against the words of God, and provoked the counsel of the Most High."],["12",[["καὶ",707031,7],["ἐταπεινώθη",712717,37],["ἐν",704639,0],["κόποις",707825,148],["ἡ",709436,10],["καρδία",707141,12],["αὐτῶν",702165,40],["ἠσθένησαν",701938,150],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ὁ",709436,3],["βοηθῶν",702746,72]],"So their heart was brought low with troubles; they were weak, and there was no helper."],["13",[["καὶ",707031,7],["ἐκέκραξαν",707868,150],["πρὸς",710844,0],["κύριον",707996,6],["ἐν",704639,0],["τῷ",709436,53],["θλίβεσθαι",706274,110],["αὐτούς",702165,62],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,130],["ἀναγκῶν",700925,65],["αὐτῶν",702165,40],["ἔσωσεν",712627,2],["αὐτοὺς",702165,62]],"Then they cried to the Lord in their affliction, and he saved them out of their distresses."],["14",[["καὶ",707031,7],["ἐξήγαγεν",704834,2],["αὐτοὺς",702165,62],["ἐκ",704132,0],["σκότους",711889,21],["καὶ",707031,7],["σκιᾶς",711852,17],["θανάτου",706096,18],["καὶ",707031,7],["τοὺς",709436,58],["δεσμοὺς",703372,57],["αὐτῶν",702165,40],["διέρρηξεν",703565,2]],"And he brought them out of darkness and the shadow of death, and broke their bonds asunder."],["15",[["ἐξομολογησάσθωσαν",704960,486],["τῷ",709436,113],["κυρίῳ",707996,114],["τὰ",709436,41],["ἐλέη",704426,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["θαυμάσια",706136,68],["αὐτοῦ",702165,102],["τοῖς",709436,147],["υἱοῖς",713075,148],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"Let them acknowledge to the Lord his mercies, and his wonders to the children of men."],["16",[["ὅτι",709803,7],["συνέτριψεν",712520,2],["πύλας",711082,39],["χαλκᾶς",713690,119],["καὶ",707031,7],["μοχλοὺς",709040,57],["σιδηροῦς",711771,60],["συνέκλασεν",712218,2]],"For he broke to pieces the brazen gates, and crushed the iron bars."],["17",[["ἀντελάβετο",701243,23],["αὐτῶν",702165,40],["ἐξ",704132,0],["ὁδοῦ",709458,17],["ἀνομίας",701192,17],["αὐτῶν",702165,40],["διὰ",703417,0],["γὰρ",702963,11],["τὰς",709436,38],["ἀνομίας",701192,39],["αὐτῶν",702165,40],["ἐταπεινώθησαν",712717,99]],"He helped them out of the way of their iniquity; for they were brought low because of their iniquities."],["18",[["πᾶν",710177,46],["βρῶμα",702823,25],["ἐβδελύξατο",702608,23],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτῶν",702165,40],["καὶ",707031,7],["ἤγγισαν",703939,150],["ἕως",705792,0],["τῶν",709436,130],["πυλῶν",711082,65],["τοῦ",709436,35],["θανάτου",706096,18]],"Their soul abhorred all meat; and they drew near to the gates of death."],["19",[["καὶ",707031,7],["ἐκέκραξαν",707868,150],["πρὸς",710844,0],["κύριον",707996,6],["ἐν",704639,0],["τῷ",709436,53],["θλίβεσθαι",706274,110],["αὐτούς",702165,62],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,130],["ἀναγκῶν",700925,65],["αὐτῶν",702165,40],["ἔσωσεν",712627,2],["αὐτούς",702165,62]],"Then they cried to the Lord in their affliction, and he saved them out of their distresses."],["20",[["ἀπέστειλεν",701592,2],["τὸν",709436,5],["λόγον",708236,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἰάσατο",706424,23],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἐρρύσατο",711309,23],["αὐτοὺς",702165,62],["ἐκ",704132,0],["τῶν",709436,130],["διαφθορῶν",703625,65],["αὐτῶν",702165,40]],"He sent his word, and healed them, and delivered them out of their destructions."],["21",[["ἐξομολογησάσθωσαν",704960,486],["τῷ",709436,113],["κυρίῳ",707996,114],["τὰ",709436,41],["ἐλέη",704426,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["θαυμάσια",706136,68],["αὐτοῦ",702165,102],["τοῖς",709436,147],["υἱοῖς",713075,148],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"Let them acknowledge to the Lord his mercies, and his wonderful works to the children of men."],["22",[["καὶ",707031,7],["θυσάτωσαν",706349,264],["θυσίαν",706345,9],["αἰνέσεως",700457,17],["καὶ",707031,7],["ἐξαγγειλάτωσαν",704829,264],["τὰ",709436,41],["ἔργα",705396,42],["αὐτοῦ",702165,102],["ἐν",704639,0],["ἀγαλλιάσει",700113,1]],"And let them offer to him the sacrifice of praise, and proclaim his works with exultation."],["23",[["οἱ",709436,136],["καταβαίνοντες",707202,146],["εἰς",704105,0],["τὴν",709436,8],["θάλασσαν",706069,9],["ἐν",704639,0],["πλοίοις",710556,96],["ποιοῦντες",710582,146],["ἐργασίαν",705385,9],["ἐν",704639,0],["ὕδασι",713071,96],["πολλοῖς",710646,94]],"They that go down to the sea in ships, doing business in many waters;"],["24",[["αὐτοὶ",702165,201],["εἴδοσαν",709725,150],["τὰ",709436,41],["ἔργα",705396,42],["κυρίου",707996,18],["καὶ",707031,7],["τὰ",709436,41],["θαυμάσια",706136,68],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,113],["βυθῷ",702830,114]],"these [men] have seen the works of the Lord, and his wonders in the deep."],["25",[["εἶπεν",705373,2],["καὶ",707031,7],["ἔστη",706846,2],["πνεῦμα",710566,15],["καταιγίδος",707254,17],["καὶ",707031,7],["ὑψώθη",713289,37],["τὰ",709436,63],["κύματα",707968,64],["αὐτῆς",702165,86]],"He speaks, and the stormy wind arises, and its waves are lifted up."],["26",[["ἀναβαίνουσιν",700905,197],["ἕως",705792,0],["τῶν",709436,80],["οὐρανῶν",709844,81],["καὶ",707031,7],["καταβαίνουσιν",707202,197],["ἕως",705792,0],["τῶν",709436,130],["ἀβύσσων",700098,65],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτῶν",702165,40],["ἐν",704639,0],["κακοῖς",707066,230],["ἐτήκετο",712839,19]],"They go up to the heavens, and go down to the depths; their soul melts because of troubles."],["27",[["ἐταράχθησαν",712721,99],["ἐσαλεύθησαν",711403,99],["ὡς",714148,11],["ὁ",709436,3],["μεθύων",708676,72],["καὶ",707031,7],["πᾶσα",710177,29],["ἡ",709436,10],["σοφία",711981,12],["αὐτῶν",702165,40],["κατεπόθη",707374,37]],"They are troubled, they stagger as a drunkard, and all their wisdom is swallowed up."],["28",[["καὶ",707031,7],["ἐκέκραξαν",707868,150],["πρὸς",710844,0],["κύριον",707996,6],["ἐν",704639,0],["τῷ",709436,53],["θλίβεσθαι",706274,110],["αὐτούς",702165,62],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,130],["ἀναγκῶν",700925,65],["αὐτῶν",702165,40],["ἐξήγαγεν",704834,2],["αὐτοὺς",702165,62]],"Then they cry to the Lord in their affliction, and he brings them out of their distresses."],["29",[["καὶ",707031,7],["ἐπέταξεν",705294,2],["τῇ",709436,100],["καταιγίδι",707254,1],["καὶ",707031,7],["ἔστη",706846,2],["εἰς",704105,0],["αὔραν",702146,9],["καὶ",707031,7],["ἐσίγησαν",711767,150],["τὰ",709436,41],["κύματα",707968,42],["αὐτῆς",702165,86]],"And he commands the storm, and it is calmed into a gentle breeze, and its waves are still."],["30",[["καὶ",707031,7],["εὐφράνθησαν",705715,99],["ὅτι",709803,7],["ἡσύχασαν",706033,150],["καὶ",707031,7],["ὡδήγησεν",709448,2],["αὐτοὺς",702165,62],["ἐπὶ",705080,0],["λιμένα",708207,6],["θελήματος",706170,21],["αὐτῶν",702165,40]],"And they are glad, because they are quiet; and he guides them to their desired haven."],["31",[["ἐξομολογησάσθωσαν",704960,486],["τῷ",709436,113],["κυρίῳ",707996,114],["τὰ",709436,41],["ἐλέη",704426,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["θαυμάσια",706136,68],["αὐτοῦ",702165,102],["τοῖς",709436,147],["υἱοῖς",713075,148],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"Let them acknowledge to the Lord his mercies, and his wonderful works to the children of men."],["32",[["ὑψωσάτωσαν",713289,264],["αὐτὸν",702165,85],["ἐν",704639,0],["ἐκκλησίᾳ",704216,1],["λαοῦ",708094,18],["καὶ",707031,7],["ἐν",704639,0],["καθέδρᾳ",706992,1],["πρεσβυτέρων",710735,81],["αἰνεσάτωσαν",700459,264],["αὐτόν",702165,85]],"Let them exalt him in the congregation of the people, and praise him in the seat of the elders."],["33",[["ἔθετο",712849,23],["ποταμοὺς",710693,57],["εἰς",704105,0],["ἔρημον",705420,9],["καὶ",707031,7],["διεξόδους",703668,39],["ὑδάτων",713071,44],["εἰς",704105,0],["δίψαν",703762,9]],"He turns rivers into a desert, and streams of water into a dry land;"],["34",[["γῆν",703083,9],["καρποφόρον",707172,36],["εἰς",704105,0],["ἅλμην",700713,9],["ἀπὸ",701425,0],["κακίας",707054,17],["τῶν",709436,80],["κατοικούντων",707534,170],["ἐν",704639,0],["αὐτῇ",702165,105]],"a fruitful land into saltness, for the wickedness of them that dwell in it."],["35",[["ἔθετο",712849,23],["ἔρημον",705420,9],["εἰς",704105,0],["λίμνας",708208,39],["ὑδάτων",713071,44],["καὶ",707031,7],["γῆν",703083,9],["ἄνυδρον",701285,36],["εἰς",704105,0],["διεξόδους",703668,39],["ὑδάτων",713071,44]],"He turns a wilderness into pools of water, and a dry land into streams of water."],["36",[["καὶ",707031,7],["κατῴκισεν",707534,2],["ἐκεῖ",704181,28],["πεινῶντας",710222,235],["καὶ",707031,7],["συνεστήσαντο",712482,189],["πόλιν",710612,9],["κατοικεσίας",707533,17]],"And there he causes the hungry to dwell, and they establish for themselves cities of habitation."],["37",[["καὶ",707031,7],["ἔσπειραν",712004,9],["ἀγροὺς",700196,57],["καὶ",707031,7],["ἐφύτευσαν",713636,150],["ἀμπελῶνας",700872,57],["καὶ",707031,7],["ἐποίησαν",710582,150],["καρπὸν",707169,6],["γενήματος",703052,21]],"And they sow fields, and plant vineyards, and they yield fruit of increase."],["38",[["καὶ",707031,7],["εὐλόγησεν",705631,2],["αὐτούς",702165,62],["καὶ",707031,7],["ἐπληθύνθησαν",710530,99],["σφόδρα",712586,28],["καὶ",707031,7],["τὰ",709436,41],["κτήνη",707934,42],["αὐτῶν",702165,40],["οὐκ",709805,28],["ἐσμίκρυνεν",711911,2]],"And he blesses them, and they multiply exceedingly, and he diminishes not the number of their cattle."],["39",[["καὶ",707031,7],["ὠλιγώθησαν",709576,99],["καὶ",707031,7],["ἐκακώθησαν",707073,99],["ἀπὸ",701425,0],["θλίψεως",706276,17],["κακῶν",707066,169],["καὶ",707031,7],["ὀδύνης",709463,17]],"Again they become few, and are brought low, by the pressure of evils and pain."],["40",[["ἐξεχύθη",704368,37],["ἐξουδένωσις",704971,12],["ἐπ᾿",705080,0],["ἄρχοντας",701862,57],["καὶ",707031,7],["ἐπλάνησεν",710495,2],["αὐτοὺς",702165,62],["ἐν",704639,0],["ἀβάτῳ",700023,30],["καὶ",707031,7],["οὐχ",709805,28],["ὁδῷ",709458,1]],"Contempt is poured upon their princes, and he causes them to wander in a desert and trackless land."],["41",[["καὶ",707031,7],["ἐβοήθησεν",702746,2],["πένητι",710248,114],["ἐκ",704132,0],["πτωχείας",711073,17],["καὶ",707031,7],["ἔθετο",712849,23],["ὡς",714148,11],["πρόβατα",710768,42],["πατριάς",710192,39]],"But he helps the poor out of poverty, and makes [him] families as a flock."],["42",[["ὄψονται",709725,135],["εὐθεῖς",705602,138],["καὶ",707031,7],["εὐφρανθήσονται",705715,144],["καὶ",707031,7],["πᾶσα",710177,29],["ἀνομία",701192,12],["ἐμφράξει",704635,127],["τὸ",709436,24],["στόμα",712125,25],["αὐτῆς",702165,86]],"The upright shall see and rejoice; and all iniquity shall stop her mouth."],["43",[["τίς",712867,158],["σοφὸς",711985,14],["καὶ",707031,7],["φυλάξει",713619,127],["ταῦτα",709858,71],["καὶ",707031,7],["συνήσουσιν",712481,218],["τὰ",709436,41],["ἐλέη",704426,42],["τοῦ",709436,35],["κυρίου",707996,18]],"Who is wise, and will observe these things, and understand the mercies of the Lord?"]]