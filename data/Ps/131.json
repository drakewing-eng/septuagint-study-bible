[["1",[["ᾠδὴ",714091,12],["τῶν",709436,80],["ἀναβαθμῶν",700904,81],["μνήσθητι",708960,176],["κύριε",707996,153],["τοῦ",709436,35],["Δαυιδ",703232,18],["καὶ",707031,7],["πάσης",710177,82],["τῆς",709436,16],["πραΰτητος",710726,17],["αὐτοῦ",702165,559]],"A Song of Degrees. Lord, remember David, and all his meekness:"],["2",[["ὡς",714148,7],["ὤμοσεν",709620,2],["τῷ",709436,113],["κυρίῳ",707996,114],["ηὔξατο",705727,23],["τῷ",709436,113],["θεῷ",706192,114],["Ιακωβ",706401,18]],"how he sware to the Lord, [and] vowed to the God of Jacob, [saying],"],["3",[["εἰ",704071,7],["εἰσελεύσομαι",704114,181],["εἰς",704105,0],["σκήνωμα",711849,25],["οἴκου",709516,18],["μου",709032,133],["εἰ",704071,7],["ἀναβήσομαι",700905,181],["ἐπὶ",705080,0],["κλίνης",707737,17],["στρωμνῆς",712174,17],["μου",709032,133]],"I will not go into the tabernacle of my house; I will not go up to the couch of my bed;"],["4",[["εἰ",704071,7],["δώσω",703654,165],["ὕπνον",713181,6],["τοῖς",709436,147],["ὀφθαλμοῖς",709870,148],["μου",709032,133],["καὶ",707031,7],["τοῖς",709436,95],["βλεφάροις",702741,96],["μου",709032,133],["νυσταγμὸν",709389,6],["καὶ",707031,7],["ἀνάπαυσιν",701026,9],["τοῖς",709436,147],["κροτάφοις",707917,148],["μου",709032,133]],"I will not give sleep to mine eyes, nor slumber to mine eyelids, nor rest to my temples,"],["5",[["ἕως",705792,0],["οὗ",709781,48],["εὕρω",705676,207],["τόπον",712903,6],["τῷ",709436,113],["κυρίῳ",707996,114],["σκήνωμα",711849,25],["τῷ",709436,113],["θεῷ",706192,114],["Ιακωβ",706401,18]],"until I find a place for the Lord, a tabernacle for the God of Jacob."],["6",[["ἰδοὺ",706497,88],["ἠκούσαμεν",700587,289],["αὐτὴν",702165,551],["ἐν",704639,0],["Εφραθα",705765,114],["εὕρομεν",705676,289],["αὐτὴν",702165,551],["ἐν",704639,0],["τοῖς",709436,95],["πεδίοις",710215,96],["τοῦ",709436,35],["δρυμοῦ",703836,18]],"Behold, we heard of it in Ephratha; we found it in the fields of the wood."],["7",[["εἰσελευσόμεθα",704114,141],["εἰς",704105,0],["τὰ",709436,41],["σκηνώματα",711849,42],["αὐτοῦ",702165,559],["προσκυνήσομεν",710925,275],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["οὗ",709781,48],["ἔστησαν",706846,150],["οἱ",709436,136],["πόδες",710707,52],["αὐτοῦ",702165,559]],"Let us enter into his tabernacles: let us worship at the place where his feet stood."],["8",[["ἀνάστηθι",701173,176],["κύριε",707996,153],["εἰς",704105,0],["τὴν",709436,8],["ἀνάπαυσίν",701026,9],["σου",711945,133],["σὺ",712181,164],["καὶ",707031,7],["ἡ",709436,10],["κιβωτὸς",707667,12],["τοῦ",709436,20],["ἁγιάσματός",700154,21],["σου",711945,133]],"Arise, O Lord, into thy rest; thou, and the ark of thine holiness."],["9",[["οἱ",709436,136],["ἱερεῖς",706614,52],["σου",711945,133],["ἐνδύσονται",704701,135],["δικαιοσύνην",703695,9],["καὶ",707031,7],["οἱ",709436,136],["ὅσιοί",709782,138],["σου",711945,133],["ἀγαλλιάσονται",700114,135]],"Thy priests shall clothe themselves with righteousness; and thy saints shall exult."],["10",[["ἕνεκεν",704709,0],["Δαυιδ",703232,18],["τοῦ",709436,35],["δούλου",703817,18],["σου",711945,133],["μὴ",708851,28],["ἀποστρέψῃς",701598,175],["τὸ",709436,24],["πρόσωπον",710986,25],["τοῦ",709436,35],["χριστοῦ",713964,116],["σου",711945,133]],"For the sake of thy servant David turn not away the face of thine anointed."],["11",[["ὤμοσεν",709620,2],["κύριος",707996,4],["τῷ",709436,113],["Δαυιδ",703232,114],["ἀλήθειαν",700656,9],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἀθετήσει",700369,127],["αὐτήν",702165,551],["ἐκ",704132,0],["καρποῦ",707169,18],["τῆς",709436,16],["κοιλίας",707761,17],["σου",711945,133],["θήσομαι",712849,181],["ἐπὶ",705080,0],["τὸν",709436,5],["θρόνον",706315,6],["σου",711945,133]],"The Lord sware [in] truth to David, and he will not annul it, [saying], Of the fruit of thy body will I set [a king] upon thy throne."],["12",[["ἐὰν",703912,7],["φυλάξωνται",713619,232],["οἱ",709436,136],["υἱοί",713075,52],["σου",711945,133],["τὴν",709436,8],["διαθήκην",703456,9],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,41],["μαρτύριά",708525,42],["μου",709032,133],["ταῦτα",709858,71],["ἃ",709781,69],["διδάξω",703649,207],["αὐτούς",702165,622],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτῶν",702165,565],["ἕως",705792,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["καθιοῦνται",707006,135],["ἐπὶ",705080,0],["τοῦ",709436,35],["θρόνου",706315,18],["σου",711945,133]],"If thy children will keep my covenant, and these my testimonies which I shall teach them, their children also shall sit upon thy throne for ever."],["13",[["ὅτι",709803,7],["ἐξελέξατο",704236,23],["κύριος",707996,4],["τὴν",709436,8],["Σιων",711816,9],["ᾑρετίσατο",700469,23],["αὐτὴν",702165,551],["εἰς",704105,0],["κατοικίαν",707537,9],["ἑαυτῷ",703917,50]],"For the Lord has elected Sion, he has chosen her for a habitation for himself, [saying],"],["14",[["αὕτη",709858,107],["ἡ",709436,10],["κατάπαυσίς",707364,12],["μου",709032,133],["εἰς",704105,0],["αἰῶνα",700504,6],["αἰῶνος",700504,18],["ὧδε",714090,28],["κατοικήσω",707534,165],["ὅτι",709803,7],["ᾑρετισάμην",700469,161],["αὐτήν",702165,551]],"This is my rest for ever: here will I dwell; for I have chosen it."],["15",[["τὴν",709436,8],["θήραν",706244,9],["αὐτῆς",702165,547],["εὐλογῶν",705631,72],["εὐλογήσω",705631,207],["τοὺς",709436,58],["πτωχοὺς",711076,57],["αὐτῆς",702165,547],["χορτάσω",713919,165],["ἄρτων",701829,81]],"I will surely bless her provision: I will satisfy her poor with bread."],["16",[["τοὺς",709436,58],["ἱερεῖς",706614,57],["αὐτῆς",702165,547],["ἐνδύσω",704701,165],["σωτηρίαν",712658,9],["καὶ",707031,7],["οἱ",709436,136],["ὅσιοι",709782,138],["αὐτῆς",702165,547],["ἀγαλλιάσει",700113,1],["ἀγαλλιάσονται",700114,135]],"I will clothe her priests with salvation; and her saints shall greatly exult."],["17",[["ἐκεῖ",704181,28],["ἐξανατελῶ",704863,165],["κέρας",707625,25],["τῷ",709436,113],["Δαυιδ",703232,114],["ἡτοίμασα",705539,155],["λύχνον",708287,6],["τῷ",709436,113],["χριστῷ",713964,30],["μου",709032,133]],"There will I cause to spring up a horn to David: I have prepared a lamp for mine anointed."],["18",[["τοὺς",709436,58],["ἐχθροὺς",705779,57],["αὐτοῦ",702165,559],["ἐνδύσω",704701,165],["αἰσχύνην",700483,9],["ἐπὶ",705080,0],["δὲ",703303,11],["αὐτὸν",702165,556],["ἐξανθήσει",704864,127],["τὸ",709436,24],["ἁγίασμά",700154,25],["μου",709032,133]],"His enemies will I clothe with shame; but upon himself shall my holiness flourish."]]