[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ἐν",704639,0],["ὕμνοις",713089,148],["συνέσεως",712460,17],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, among the Hymns of instruction by David,"],["2",[["ἐν",704639,0],["τῷ",709436,53],["ἐλθεῖν",705453,106],["τοὺς",709436,58],["Ζιφαίους",705884,57],["καὶ",707031,7],["εἰπεῖν",705373,106],["τῷ",709436,113],["σαουλ",711500,114],["οὐκ",709805,28],["ἰδοὺ",706497,88],["Δαυιδ",703232,4],["κέκρυπται",707923,187],["παρ᾿",709995,0],["ἡμῖν",705994,90]],"when the Ziphites came and said to Saul, Lo, is not David hid with us?"],["3",[["ὁ",709436,3],["θεός",706192,4],["ἐν",704639,0],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["σῶσόν",712627,176],["με",708618,163],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["δυνάμει",703839,1],["σου",711945,133],["κρῖνόν",707905,176],["με",708618,163]],"Save me, O God, by thy name, and judge me by thy might."],["4",[["ὁ",709436,3],["θεός",706192,4],["εἰσάκουσον",704108,176],["τῆς",709436,16],["προσευχῆς",710892,17],["μου",709032,133],["ἐνώτισαι",704825,300],["τὰ",709436,41],["ῥήματα",711246,42],["τοῦ",709436,20],["στόματός",712125,21],["μου",709032,133]],"O God, hear my prayer; hearken to the words of my mouth."],["5",[["ὅτι",709803,7],["ἀλλότριοι",700699,138],["ἐπανέστησαν",705026,150],["ἐπ᾿",705080,0],["ἐμέ",704555,163],["καὶ",707031,7],["κραταιοὶ",707873,138],["ἐζήτησαν",705879,150],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["οὐ",709805,28],["προέθεντο",710993,189],["τὸν",709436,5],["θεὸν",706192,6],["ἐνώπιον",704823,0],["αὐτῶν",702165,40],["διάψαλμα",703641,15]],"For strangers have risen up against me, and mighty men have sought my life: they have not set God before them. Pause."],["6",[["ἰδοὺ",706497,88],["γὰρ",702963,11],["ὁ",709436,3],["θεὸς",706192,4],["βοηθεῖ",702746,91],["μοι",708974,159],["καὶ",707031,7],["ὁ",709436,3],["κύριος",707996,4],["ἀντιλήμπτωρ",701246,4],["τῆς",709436,16],["ψυχῆς",714070,17],["μου",709032,133]],"For lo! God assists me; and the Lord is the helper of my soul."],["7",[["ἀποστρέψει",701598,127],["τὰ",709436,41],["κακὰ",707066,68],["τοῖς",709436,147],["ἐχθροῖς",705779,148],["μου",709032,133],["ἐν",704639,0],["τῇ",709436,100],["ἀληθείᾳ",700656,1],["σου",711945,133],["ἐξολέθρευσον",704956,176],["αὐτούς",702165,62]],"He shall return evil to mine enemies; utterly destroy them in thy truth."],["8",[["ἑκουσίως",704270,28],["θύσω",706349,165],["σοι",711925,159],["ἐξομολογήσομαι",704960,181],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["κύριε",707996,153],["ὅτι",709803,7],["ἀγαθόν",700106,27]],"I will willingly sacrifice to thee: I will give thanks to thy name, O Lord; for [it is] good."],["9",[["ὅτι",709803,7],["ἐκ",704132,0],["πάσης",710177,82],["θλίψεως",706276,17],["ἐρρύσω",711309,174],["με",708618,163],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["ἐχθροῖς",705779,148],["μου",709032,133],["ἐπεῖδεν",705057,2],["ὁ",709436,3],["ὀφθαλμός",709870,4],["μου",709032,133]],"For thou hast delivered me out of all affliction, and mine eye has seen [my desire] upon mine enemies."]]