[["1",[["ψαλμὸς",714022,4],["τῷ",709436,113],["Ασαφ",701894,114],["ὡς",714148,7],["ἀγαθὸς",700106,14],["τῷ",709436,113],["Ισραηλ",706839,114],["ὁ",709436,3],["θεός",706192,4],["τοῖς",709436,147],["εὐθέσι",705602,230],["τῇ",709436,100],["καρδίᾳ",707141,1]],"A Psalm for Asaph. How good is God to Israel, to the upright in heart!"],["2",[["ἐμοῦ",704580,133],["δὲ",703303,11],["παρὰ",709995,0],["μικρὸν",708915,27],["ἐσαλεύθησαν",711403,99],["οἱ",709436,136],["πόδες",710707,52],["παρ᾿",709995,0],["ὀλίγον",709568,27],["ἐξεχύθη",704368,37],["τὰ",709436,63],["διαβήματά",703422,64],["μου",709032,133]],"But my feet were almost overthrown; my goings very nearly slipped."],["3",[["ὅτι",709803,7],["ἐζήλωσα",705873,155],["ἐπὶ",705080,0],["τοῖς",709436,147],["ἀνόμοις",701194,230],["εἰρήνην",704098,9],["ἁμαρτωλῶν",700776,169],["θεωρῶν",706226,72]],"For I was jealous of the transgressors, beholding the tranquillity of sinners."],["4",[["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀνάνευσις",701012,12],["τῷ",709436,113],["θανάτῳ",706096,114],["αὐτῶν",702165,40],["καὶ",707031,7],["στερέωμα",712077,15],["ἐν",704639,0],["τῇ",709436,100],["μάστιγι",708568,1],["αὐτῶν",702165,40]],"For there is no sign of reluctance in their death: and [they have] firmness under their affliction."],["5",[["ἐν",704639,0],["κόποις",707825,148],["ἀνθρώπων",701163,81],["οὐκ",709805,28],["εἰσὶν",704093,197],["καὶ",707031,7],["μετὰ",708780,0],["ἀνθρώπων",701163,81],["οὐ",709805,28],["μαστιγωθήσονται",708566,144]],"They are not in the troubles of [other] men; and they shall not be scourged with [other] men."],["6",[["διὰ",703417,0],["τοῦτο",709858,129],["ἐκράτησεν",707879,2],["αὐτοὺς",702165,62],["ἡ",709436,10],["ὑπερηφανία",713138,12],["περιεβάλοντο",710294,189],["ἀδικίαν",700271,9],["καὶ",707031,7],["ἀσέβειαν",701904,9],["αὐτῶν",702165,40]],"Therefore pride has possessed them; they have clothed themselves with their injustice and ungodliness."],["7",[["ἐξελεύσεται",704909,93],["ὡς",714148,7],["ἐκ",704132,0],["στέατος",712054,21],["ἡ",709436,10],["ἀδικία",700271,12],["αὐτῶν",702165,40],["διήλθοσαν",703673,150],["εἰς",704105,0],["διάθεσιν",703455,9],["καρδίας",707141,17]],"Their injustice shall go forth as out of fatness: they have fulfilled their intention."],["8",[["διενοήθησαν",703528,99],["καὶ",707031,7],["ἐλάλησαν",708071,150],["ἐν",704639,0],["πονηρίᾳ",710659,1],["ἀδικίαν",700271,9],["εἰς",704105,0],["τὸ",709436,24],["ὕψος",713288,25],["ἐλάλησαν",708071,150]],"They have taken counsel and spoken in wickedness: they have uttered unrighteousness loftily."],["9",[["ἔθεντο",712849,189],["εἰς",704105,0],["οὐρανὸν",709844,6],["τὸ",709436,24],["στόμα",712125,25],["αὐτῶν",702165,40],["καὶ",707031,7],["ἡ",709436,10],["γλῶσσα",703120,12],["αὐτῶν",702165,40],["διῆλθεν",703673,2],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"They have set their mouth against heaven, and their tongue has gone through upon the earth."],["10",[["διὰ",703417,0],["τοῦτο",709858,129],["ἐπιστρέψει",705278,127],["ὁ",709436,3],["λαός",708094,4],["μου",709032,133],["ἐνταῦθα",704787,28],["καὶ",707031,7],["ἡμέραι",705984,191],["πλήρεις",710541,138],["εὑρεθήσονται",705676,144],["αὐτοῖς",702165,151]],"Therefore shall my people return hither: and full days shall be found with them."],["11",[["καὶ",707031,7],["εἶπαν",705373,150],["πῶς",711121,28],["ἔγνω",703105,2],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["εἰ",704071,7],["ἔστιν",704093,91],["γνῶσις",703138,12],["ἐν",704639,0],["τῷ",709436,113],["ὑψίστῳ",713287,30]],"And they said, How does God know? and is there knowledge in the Most High?"],["12",[["ἰδοὺ",706497,88],["οὗτοι",709858,201],["ἁμαρτωλοὶ",700776,138],["καὶ",707031,7],["εὐθηνοῦνται",705594,269],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["κατέσχον",707526,150],["πλούτου",710563,18]],"Behold, these [are] the sinners, and they that prosper always: they have possessed wealth."],["13",[["καὶ",707031,7],["εἶπα",705373,155],["ἄρα",701666,11],["ματαίως",708579,28],["ἐδικαίωσα",703696,155],["τὴν",709436,8],["καρδίαν",707141,9],["μου",709032,133],["καὶ",707031,7],["ἐνιψάμην",709314,161],["ἐν",704639,0],["ἀθῴοις",700390,230],["τὰς",709436,38],["χεῖράς",713787,39],["μου",709032,133]],"And I said, Verily in vain have I justified my heart, and washed my hands in innocency."],["14",[["καὶ",707031,7],["ἐγενόμην",703104,161],["μεμαστιγωμένος",708566,251],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["καὶ",707031,7],["ὁ",709436,3],["ἔλεγχός",704415,4],["μου",709032,133],["εἰς",704105,0],["τὰς",709436,38],["πρωίας",711025,39]],"For I was plagued all the day, and my reproof [was] every morning."],["15",[["εἰ",704071,7],["ἔλεγον",708124,333],["διηγήσομαι",703679,181],["οὕτως",709859,28],["ἰδοὺ",706497,88],["τῇ",709436,100],["γενεᾷ",703037,1],["τῶν",709436,80],["υἱῶν",713075,81],["σου",711945,133],["ἠσυνθέτηκα",702036,89]],"If I said, I will speak thus; behold, I [should] have broken covenant with the generation of thy children."],["16",[["καὶ",707031,7],["ὑπέλαβον",713210,155],["τοῦ",709436,20],["γνῶναι",703105,106],["τοῦτο",709858,129],["κόπος",707825,4],["ἐστὶν",704093,91],["ἐναντίον",704654,0],["μου",709032,133]],"And I undertook to understand this, [but] it is too hard for me,"],["17",[["ἕως",705792,0],["εἰσέλθω",704114,207],["εἰς",704105,0],["τὸ",709436,24],["ἁγιαστήριον",700156,25],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["συνῶ",712481,207],["εἰς",704105,0],["τὰ",709436,41],["ἔσχατα",705519,68],["αὐτῶν",702165,40]],"until I go into the sanctuary of God; [and so] understand the latter end."],["18",[["πλὴν",710540,28],["διὰ",703417,0],["τὰς",709436,38],["δολιότητας",703784,39],["ἔθου",712849,174],["αὐτοῖς",702165,151],["κατέβαλες",707203,162],["αὐτοὺς",702165,62],["ἐν",704639,0],["τῷ",709436,53],["ἐπαρθῆναι",705002,179]],"Surely thou hast appointed [judgments] to them because of their crafty dealings: thou hast cast them down when they were lifted up."],["19",[["πῶς",711121,28],["ἐγένοντο",703104,189],["εἰς",704105,0],["ἐρήμωσιν",705422,1],["ἐξάπινα",704868,28],["ἐξέλιπον",704237,150],["ἀπώλοντο",701513,189],["διὰ",703417,0],["τὴν",709436,8],["ἀνομίαν",701192,9],["αὐτῶν",702165,40]],"How have they become desolate! suddenly they have failed: they have perished because of their iniquity."],["20",[["ὡσεὶ",714159,7],["ἐνύπνιον",704818,15],["ἐξεγειρομένου",704889,262],["κύριε",707996,153],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["σου",711945,133],["τὴν",709436,8],["εἰκόνα",704089,9],["αὐτῶν",702165,40],["ἐξουδενώσεις",704969,166]],"As the dream of one awakening, O Lord, in thy city thou wilt despise their image."],["21",[["ὅτι",709803,7],["ἐξεκαύθη",704205,37],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["καὶ",707031,7],["οἱ",709436,136],["νεφροί",709282,52],["μου",709032,133],["ἠλλοιώθησαν",700694,99]],"For my heart has rejoiced, and my reins have been gladdened."],["22",[["καὶ",707031,7],["ἐγὼ",704018,164],["ἐξουδενωμένος",704969,251],["καὶ",707031,7],["οὐκ",709805,28],["ἔγνων",703105,155],["κτηνώδης",707936,14],["ἐγενόμην",703104,161],["παρὰ",709995,0],["σοί",711925,159]],"But I [was] vile and knew not: I became brutish before thee."],["23",[["καὶ",707031,7],["ἐγὼ",704018,164],["διὰ",703417,0],["παντὸς",710177,116],["μετὰ",708780,0],["σοῦ",711945,133],["ἐκράτησας",707879,162],["τῆς",709436,16],["χειρὸς",713787,17],["τῆς",709436,16],["δεξιᾶς",703360,82],["μου",709032,133]],"Yet I am continually with thee: thou hast holden my right hand."],["24",[["ἐν",704639,0],["τῇ",709436,100],["βουλῇ",702792,1],["σου",711945,133],["ὡδήγησάς",709448,162],["με",708618,163],["καὶ",707031,7],["μετὰ",708780,0],["δόξης",703791,17],["προσελάβου",710930,174],["με",708618,163]],"Thou hast guided me by thy counsel, and thou hast taken me to thyself with glory."],["25",[["τί",712867,126],["γάρ",702963,11],["μοι",708974,159],["ὑπάρχει",713104,91],["ἐν",704639,0],["τῷ",709436,113],["οὐρανῷ",709844,114],["καὶ",707031,7],["παρὰ",709995,0],["σοῦ",711945,133],["τί",712867,126],["ἠθέλησα",706176,155],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"For what have I in heaven [but thee]? and what have I desired upon the earth beside thee?"],["26",[["ἐξέλιπεν",704237,2],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["σάρξ",711537,12],["μου",709032,133],["ὁ",709436,3],["θεὸς",706192,4],["τῆς",709436,16],["καρδίας",707141,17],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["μερίς",708748,12],["μου",709032,133],["ὁ",709436,3],["θεὸς",706192,4],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"My heart and my flesh have failed: [but] God [is the strength] of my heart, and God is my portion for ever."],["27",[["ὅτι",709803,7],["ἰδοὺ",706497,88],["οἱ",709436,136],["μακρύνοντες",708428,146],["ἑαυτοὺς",703917,62],["ἀπὸ",701425,0],["σοῦ",711945,133],["ἀπολοῦνται",701513,135],["ἐξωλέθρευσας",704956,162],["πάντα",710177,27],["τὸν",709436,5],["πορνεύοντα",710674,183],["ἀπὸ",701425,0],["σοῦ",711945,133]],"For, behold, they that remove themselves far from thee shall perish: thou hast destroyed every one that goes a whoring from thee."],["28",[["ἐμοὶ",704577,159],["δὲ",703303,11],["τὸ",709436,24],["προσκολλᾶσθαι",710921,110],["τῷ",709436,113],["θεῷ",706192,114],["ἀγαθόν",700106,26],["ἐστιν",704093,91],["τίθεσθαι",712849,110],["ἐν",704639,0],["τῷ",709436,113],["κυρίῳ",707996,114],["τὴν",709436,8],["ἐλπίδα",704530,9],["μου",709032,133],["τοῦ",709436,20],["ἐξαγγεῖλαι",704829,106],["πάσας",710177,119],["τὰς",709436,38],["αἰνέσεις",700457,39],["σου",711945,133],["ἐν",704639,0],["ταῖς",709436,75],["πύλαις",711082,76],["τῆς",709436,16],["θυγατρὸς",706320,17],["Σιων",711816,17]],"But it is good for me to cleave close to God, to put my trust in the Lord; that I may proclaim all thy praises in the gates of the daughter of Sion."]]