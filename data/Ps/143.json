[["1",[["τῷ",709436,113],["Δαυιδ",703232,114],["πρὸς",710844,0],["τὸν",709436,5],["Γολιαδ",703160,6],["εὐλογητὸς",705632,14],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["ὁ",709436,3],["διδάσκων",703649,72],["τὰς",709436,38],["χεῖράς",713787,39],["μου",709032,133],["εἰς",704105,0],["παράταξιν",710107,9],["τοὺς",709436,58],["δακτύλους",703259,57],["μου",709032,133],["εἰς",704105,0],["πόλεμον",710605,6]],"[A Psalm] of David concerning Goliad. Blessed [be] the Lord my God, who instructs my hands for battle, [and] my fingers for war."],["2",[["ἔλεός",704426,4],["μου",709032,133],["καὶ",707031,7],["καταφυγή",707485,12],["μου",709032,133],["ἀντιλήμπτωρ",701246,4],["μου",709032,133],["καὶ",707031,7],["ῥύστης",711313,4],["μου",709032,133],["ὑπερασπιστής",713123,4],["μου",709032,133],["καὶ",707031,7],["ἐπ᾿",705080,0],["αὐτῷ",702165,560],["ἤλπισα",704529,155],["ὁ",709436,3],["ὑποτάσσων",713250,72],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["ὑπ᾿",713184,0],["ἐμέ",704555,163]],"My mercy, and my refuge; my helper, and my deliverer; my protector, in whom I have trusted; who subdues my people under me."],["3",[["κύριε",707996,153],["τί",712867,126],["ἐστιν",704093,91],["ἄνθρωπος",701163,4],["ὅτι",709803,7],["ἐγνώσθης",703105,168],["αὐτῷ",702165,560],["ἢ",705924,7],["υἱὸς",713075,4],["ἀνθρώπου",701163,18],["ὅτι",709803,7],["λογίζῃ",708232,278],["αὐτόν",702165,556]],"Lord, what is man, that thou art made known to him? or the son of man, that thou takest account of him?"],["4",[["ἄνθρωπος",701163,4],["ματαιότητι",708576,1],["ὡμοιώθη",709628,37],["αἱ",709436,190],["ἡμέραι",705984,191],["αὐτοῦ",702165,559],["ὡσεὶ",714159,28],["σκιὰ",711852,12],["παράγουσιν",710007,197]],"Man is like to vanity: his days pass as a shadow."],["5",[["κύριε",707996,153],["κλῖνον",707738,176],["οὐρανούς",709844,57],["σου",711945,133],["καὶ",707031,7],["κατάβηθι",707202,176],["ἅψαι",701654,420],["τῶν",709436,43],["ὀρέων",709768,44],["καὶ",707031,7],["καπνισθήσονται",707131,144]],"O Lord, bow thy heavens, and come down: touch the mountains, and they shall smoke."],["6",[["ἄστραψον",702022,176],["ἀστραπὴν",702021,9],["καὶ",707031,7],["σκορπιεῖς",711881,166],["αὐτούς",702165,622],["ἐξαπόστειλον",704872,176],["τὰ",709436,41],["βέλη",702644,42],["σου",711945,133],["καὶ",707031,7],["συνταράξεις",712507,166],["αὐτούς",702165,622]],"Send lightning, and thou shalt scatter them: send forth thine arrows, and thou shalt discomfit them."],["7",[["ἐξαπόστειλον",704872,176],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133],["ἐξ",704132,0],["ὕψους",713288,21],["ἐξελοῦ",704838,300],["με",708618,163],["καὶ",707031,7],["ῥῦσαί",711309,300],["με",708618,163],["ἐξ",704132,0],["ὑδάτων",713071,44],["πολλῶν",710646,83],["ἐκ",704132,0],["χειρὸς",713787,17],["υἱῶν",713075,81],["ἀλλοτρίων",700699,169]],"Send forth thine hand from on high; rescue me, and deliver me out of great waters, out of the hand of strange children;"],["8",[["ὧν",709781,252],["τὸ",709436,34],["στόμα",712125,15],["ἐλάλησεν",708071,2],["ματαιότητα",708576,9],["καὶ",707031,7],["ἡ",709436,10],["δεξιὰ",703360,29],["αὐτῶν",702165,565],["δεξιὰ",703360,29],["ἀδικίας",700271,17]],"whose mouth has spoken vanity, and their right hand is a right hand of iniquity."],["9",[["ὁ",709436,3],["θεός",706192,4],["ᾠδὴν",714091,9],["καινὴν",707042,36],["ᾄσομαί",700299,181],["σοι",711925,159],["ἐν",704639,0],["ψαλτηρίῳ",714023,54],["δεκαχόρδῳ",703345,97],["ψαλῶ",714021,165],["σοι",711925,159]],"O God, I will sing a new song to thee: I will play to thee on a psaltery of ten strings."],["10",[["τῷ",709436,113],["διδόντι",703654,379],["τὴν",709436,8],["σωτηρίαν",712658,9],["τοῖς",709436,147],["βασιλεῦσιν",702580,148],["τῷ",709436,113],["λυτρουμένῳ",708282,241],["Δαυιδ",703232,6],["τὸν",709436,5],["δοῦλον",703817,6],["αὐτοῦ",702165,559],["ἐκ",704132,0],["ῥομφαίας",711291,17],["πονηρᾶς",710660,82]],"[Even] to him who gives salvation to kings: who redeems his servant David from the hurtful sword."],["11",[["ῥῦσαί",711309,300],["με",708618,163],["καὶ",707031,7],["ἐξελοῦ",704838,300],["με",708618,163],["ἐκ",704132,0],["χειρὸς",713787,17],["υἱῶν",713075,81],["ἀλλοτρίων",700699,169],["ὧν",709781,252],["τὸ",709436,34],["στόμα",712125,15],["ἐλάλησεν",708071,2],["ματαιότητα",708576,9],["καὶ",707031,7],["ἡ",709436,10],["δεξιὰ",703360,29],["αὐτῶν",702165,565],["δεξιὰ",703360,29],["ἀδικίας",700271,17]],"Deliver me, and rescue me from the hand of strange children, whose mouth has spoken vanity, and their right hand is a right hand of iniquity;"],["12",[["ὧν",709781,252],["οἱ",709436,136],["υἱοὶ",713075,52],["ὡς",714148,7],["νεόφυτα",709260,68],["ἡδρυμμένα",700293,388],["ἐν",704639,0],["τῇ",709436,100],["νεότητι",709258,1],["αὐτῶν",702165,565],["αἱ",709436,190],["θυγατέρες",706320,191],["αὐτῶν",702165,565],["κεκαλλωπισμέναι",707095,423],["περικεκοσμημέναι",710337,423],["ὡς",714148,7],["ὁμοίωμα",709629,25],["ναοῦ",709191,18]],"whose children are as plants, strengthened in their youth: their daughters are beautiful, sumptuously adorned after the similitude of a temple."],["13",[["τὰ",709436,63],["ταμίεια",712700,64],["αὐτῶν",702165,565],["πλήρη",710541,195],["ἐξερευγόμενα",704904,210],["ἐκ",704132,0],["τούτου",709858,102],["εἰς",704105,0],["τοῦτο",709858,129],["τὰ",709436,63],["πρόβατα",710768,64],["αὐτῶν",702165,565],["πολυτόκα",710648,195],["πληθύνοντα",710530,242],["ἐν",704639,0],["ταῖς",709436,75],["ἐξόδοις",704948,76],["αὐτῶν",702165,565]],"Their garners are full, and bursting with one kind of store after another; their sheep are prolific, multiplying in their streets."],["14",[["οἱ",709436,136],["βόες",702798,52],["αὐτῶν",702165,565],["παχεῖς",710206,195],["οὐκ",709805,28],["ἔστιν",704093,91],["κατάπτωμα",707393,15],["φραγμοῦ",713572,18],["οὐδὲ",709816,7],["διέξοδος",703668,12],["οὐδὲ",709816,7],["κραυγὴ",707886,12],["ἐν",704639,0],["ταῖς",709436,75],["πλατείαις",710509,291],["αὐτῶν",702165,565]],"Their oxen are fat: there is no falling down of a hedge, nor going out, nor cry in their folds."],["15",[["ἐμακάρισαν",708396,150],["τὸν",709436,5],["λαόν",708094,6],["ᾧ",709781,309],["ταῦτά",709858,290],["ἐστιν",704093,91],["μακάριος",708397,14],["ὁ",709436,3],["λαός",708094,4],["οὗ",709781,48],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["αὐτοῦ",702165,559]],"Men bless the people to whom this lot belongs, [but] blessed is the people whose God is the Lord."]]