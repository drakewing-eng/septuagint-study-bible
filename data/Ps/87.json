[["1",[["ᾠδὴ",714091,12],["ψαλμοῦ",714022,18],["τοῖς",709436,147],["υἱοῖς",713075,148],["Κορε",707833,18],["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ὑπὲρ",713111,0],["μαελεθ",708364,6],["τοῦ",709436,35],["ἀποκριθῆναι",701492,179],["συνέσεως",712460,17],["Αιμαν",700444,18],["τῷ",709436,113],["Ισραηλίτῃ",706840,114]],"A song of a Psalm for the sons of Core for the end, upon Maeleth for responsive [strains], of instruction for Æman the Israelite."],["2",[["κύριε",707996,153],["ὁ",709436,3],["θεὸς",706192,4],["τῆς",709436,16],["σωτηρίας",712658,17],["μου",709032,133],["ἡμέρας",705984,17],["ἐκέκραξα",707868,155],["καὶ",707031,7],["ἐν",704639,0],["νυκτὶ",709386,1],["ἐναντίον",704654,0],["σου",711945,133]],"O Lord God of my salvation, I have cried by day and in the night before thee."],["3",[["εἰσελθάτω",704114,45],["ἐνώπιόν",704823,0],["σου",711945,133],["ἡ",709436,10],["προσευχή",710892,12],["μου",709032,133],["κλῖνον",707738,176],["τὸ",709436,24],["οὖς",709852,25],["σου",711945,133],["εἰς",704105,0],["τὴν",709436,8],["δέησίν",703311,9],["μου",709032,133],["κύριε",707996,153]],"Let my prayer come in before thee; incline thine ear to my supplication, O Lord."],["4",[["ὅτι",709803,7],["ἐπλήσθη",710532,37],["κακῶν",707066,169],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["ζωή",705910,12],["μου",709032,133],["τῷ",709436,113],["ᾅδῃ",700255,114],["ἤγγισεν",703939,2]],"For my soul is filled with troubles, and my life has drawn nigh to Hades."],["5",[["προσελογίσθην",710931,156],["μετὰ",708780,0],["τῶν",709436,80],["καταβαινόντων",707202,170],["εἰς",704105,0],["λάκκον",708067,6],["ἐγενήθην",703104,156],["ὡς",714148,7],["ἄνθρωπος",701163,4],["ἀβοήθητος",700084,14],["ἐν",704639,0],["νεκροῖς",709247,148],["ἐλεύθερος",704428,14]],"I have been reckoned with them that go down to the pit; I became as a man without help;"],["6",[["ὡσεὶ",714159,11],["τραυματίαι",712921,52],["ἐρριμμένοι",711267,348],["καθεύδοντες",706996,146],["ἐν",704639,0],["τάφῳ",712738,114],["ὧν",709781,252],["οὐκ",709805,28],["ἐμνήσθης",708923,168],["ἔτι",705538,28],["καὶ",707031,7],["αὐτοὶ",702165,201],["ἐκ",704132,0],["τῆς",709436,16],["χειρός",713787,17],["σου",711945,133],["ἀπώσθησαν",701659,99]],"free among the dead, as the slain ones cast out, who sleep in the tomb; whom thou rememberest no more; and they are rejected from thy hand."],["7",[["ἔθεντό",712849,189],["με",708618,163],["ἐν",704639,0],["λάκκῳ",708067,114],["κατωτάτῳ",707560,30],["ἐν",704639,0],["σκοτεινοῖς",711885,230],["καὶ",707031,7],["ἐν",704639,0],["σκιᾷ",711852,1],["θανάτου",706096,18]],"They laid me in the lowest pit, in dark [places], and in the shadow of death."],["8",[["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ἐπεστηρίχθη",705270,37],["ὁ",709436,3],["θυμός",706334,4],["σου",711945,133],["καὶ",707031,7],["πάντας",710177,60],["τοὺς",709436,58],["μετεωρισμούς",708830,57],["σου",711945,133],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ἐπήγαγες",704994,162],["διάψαλμα",703641,15]],"Thy wrath has pressed heavily upon me, and thou hast brought upon me all thy billows. Pause."],["9",[["ἐμάκρυνας",708428,162],["τοὺς",709436,58],["γνωστούς",703141,60],["μου",709032,133],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["ἔθεντό",712849,189],["με",708618,163],["βδέλυγμα",702604,25],["ἑαυτοῖς",703917,151],["παρεδόθην",710014,156],["καὶ",707031,7],["οὐκ",709805,28],["ἐξεπορευόμην",704293,334]],"Thou hast removed my acquaintance far from me; they have made me an abomination to themselves; I have been delivered up, and have not gone forth."],["10",[["οἱ",709436,136],["ὀφθαλμοί",709870,52],["μου",709032,133],["ἠσθένησαν",701938,150],["ἀπὸ",701425,0],["πτωχείας",711073,17],["ἐκέκραξα",707868,155],["πρὸς",710844,0],["σέ",711598,163],["κύριε",707996,153],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["διεπέτασα",703545,155],["πρὸς",710844,0],["σὲ",711598,163],["τὰς",709436,38],["χεῖράς",713787,39],["μου",709032,133]],"Mine eyes are dimmed from poverty; but I cried to thee, O Lord, all the day; I spread forth my hands to thee."],["11",[["μὴ",708851,28],["τοῖς",709436,147],["νεκροῖς",709247,148],["ποιήσεις",710582,166],["θαυμάσια",706136,68],["ἢ",705924,7],["ἰατροὶ",706459,52],["ἀναστήσουσιν",701173,218],["καὶ",707031,7],["ἐξομολογήσονταί",704960,135],["σοι",711925,159]],"Wilt thou work wonders for the dead? or shall physicians raise [them] up, that they shall praise thee?"],["12",[["μὴ",708851,28],["διηγήσεταί",703679,93],["τις",712866,158],["ἐν",704639,0],["τάφῳ",712738,114],["τὸ",709436,24],["ἔλεός",704426,25],["σου",711945,133],["καὶ",707031,7],["τὴν",709436,8],["ἀλήθειάν",700656,9],["σου",711945,133],["ἐν",704639,0],["τῇ",709436,100],["ἀπωλείᾳ",701660,1]],"Shall any one declare thy mercy in the tomb? and thy truth in destruction?"],["13",[["μὴ",708851,28],["γνωσθήσεται",703105,134],["ἐν",704639,0],["τῷ",709436,53],["σκότει",711889,54],["τὰ",709436,41],["θαυμάσιά",706136,68],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["δικαιοσύνη",703695,12],["σου",711945,133],["ἐν",704639,0],["γῇ",703083,1],["ἐπιλελησμένῃ",705187,470]],"Shall thy wonders be known in darkness? and thy righteousness in a forgotten land?"],["14",[["κἀγὼ",706969,288],["πρὸς",710844,0],["σέ",711598,163],["κύριε",707996,153],["ἐκέκραξα",707868,155],["καὶ",707031,7],["τὸ",709436,24],["πρωὶ",711021,28],["ἡ",709436,10],["προσευχή",710892,12],["μου",709032,133],["προφθάσει",711011,127],["σε",711598,163]],"But I cried to thee, O Lord; and in the morning shall my prayer prevent thee."],["15",[["ἵνα",706747,7],["τί",712867,126],["κύριε",707996,153],["ἀπωθεῖς",701659,154],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἀποστρέφεις",701598,154],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133]],"Wherefore, O Lord, dost thou reject my prayer, [and] turn thy face away from me?"],["16",[["πτωχός",711076,4],["εἰμι",704093,157],["ἐγὼ",704018,164],["καὶ",707031,7],["ἐν",704639,0],["κόποις",707825,148],["ἐκ",704132,0],["νεότητός",709258,17],["μου",709032,133],["ὑψωθεὶς",713289,217],["δὲ",703303,11],["ἐταπεινώθην",712717,156],["καὶ",707031,7],["ἐξηπορήθην",704871,156]],"I am poor and in troubles from my youth; and having been exalted, I was brought low and into despair."],["17",[["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["διῆλθον",703673,150],["αἱ",709436,190],["ὀργαί",709728,191],["σου",711945,133],["καὶ",707031,7],["οἱ",709436,136],["φοβερισμοί",713528,52],["σου",711945,133],["ἐξετάραξάν",704319,150],["με",708618,163]],"Thy wrath has passed over me; and thy terrors have greatly disquieted me."],["18",[["ἐκύκλωσάν",707958,150],["με",708618,163],["ὡς",714148,7],["ὕδωρ",713071,15],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["περιέσχον",710315,150],["με",708618,163],["ἅμα",700745,28]],"They compassed me like water; all the day they beset me together."],["19",[["ἐμάκρυνας",708428,162],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["φίλον",713492,27],["καὶ",707031,7],["πλησίον",710547,28],["καὶ",707031,7],["τοὺς",709436,58],["γνωστούς",703141,60],["μου",709032,133],["ἀπὸ",701425,0],["ταλαιπωρίας",712695,17]],"Thou hast put far from me [every] friend, and mine acquaintances because of [my] wretchedness."]]