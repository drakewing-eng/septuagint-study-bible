[["1",[["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114],["ὅτε",709802,28],["αὐτὸν",702165,556],["ὁ",709436,3],["υἱὸς",713075,4],["καταδιώκει",707243,91],["κύριε",707996,153],["εἰσάκουσον",704108,176],["τῆς",709436,16],["προσευχῆς",710892,17],["μου",709032,133],["ἐνώτισαι",704825,300],["τὴν",709436,8],["δέησίν",703311,9],["μου",709032,133],["ἐν",704639,0],["τῇ",709436,100],["ἀληθείᾳ",700656,1],["σου",711945,133],["ἐπάκουσόν",705009,176],["μου",709032,133],["ἐν",704639,0],["τῇ",709436,100],["δικαιοσύνῃ",703695,1],["σου",711945,133]],"A Psalm of David, when his son pursued him. O Lord, attend to my prayer: hearken to my supplication in thy truth; hear me in thy righteousness."],["2",[["καὶ",707031,7],["μὴ",708851,28],["εἰσέλθῃς",704114,175],["εἰς",704105,0],["κρίσιν",707908,9],["μετὰ",708780,0],["τοῦ",709436,35],["δούλου",703817,18],["σου",711945,133],["ὅτι",709803,7],["οὐ",709805,28],["δικαιωθήσεται",703696,134],["ἐνώπιόν",704823,0],["σου",711945,133],["πᾶς",710177,14],["ζῶν",705851,72]],"And enter not into judgment with thy servant, for in thy sight shall no [man] living be justified."],["3",[["ὅτι",709803,7],["κατεδίωξεν",707243,2],["ὁ",709436,3],["ἐχθρὸς",705779,4],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἐταπείνωσεν",712717,2],["εἰς",704105,0],["γῆν",703083,9],["τὴν",709436,8],["ζωήν",705910,9],["μου",709032,133],["ἐκάθισέν",707006,2],["με",708618,163],["ἐν",704639,0],["σκοτεινοῖς",711885,230],["ὡς",714148,7],["νεκροὺς",709247,57],["αἰῶνος",700504,18]],"For the enemy has persecuted my soul; he has brought my life down to the ground; he has made me to dwell in a dark [place], as those that have been long dead."],["4",[["καὶ",707031,7],["ἠκηδίασεν",700538,2],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["τὸ",709436,24],["πνεῦμά",710566,25],["μου",709032,133],["ἐν",704639,0],["ἐμοὶ",704577,159],["ἐταράχθη",712721,37],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133]],"Therefore my spirit was grieved in me; my heart was troubled within me."],["5",[["ἐμνήσθην",708960,156],["ἡμερῶν",705984,65],["ἀρχαίων",701835,198],["καὶ",707031,7],["ἐμελέτησα",708698,155],["ἐν",704639,0],["πᾶσι",710177,94],["τοῖς",709436,95],["ἔργοις",705396,96],["σου",711945,133],["ἐν",704639,0],["ποιήμασιν",710583,96],["τῶν",709436,130],["χειρῶν",713787,65],["σου",711945,133],["ἐμελέτων",708698,333]],"I remembered the days of old; and I meditated on all thy doings: [yea], I meditated on the works of thine hands."],["6",[["διεπέτασα",703544,155],["τὰς",709436,38],["χεῖράς",713787,39],["μου",709032,133],["πρὸς",710844,0],["σέ",711598,163],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ὡς",714148,7],["γῆ",703083,12],["ἄνυδρός",701285,29],["σοι",711925,159],["διάψαλμα",703641,15]],"I spread forth my hands to thee; my soul [thirsts] for thee, as a dry land. Pause."],["7",[["ταχὺ",712748,28],["εἰσάκουσόν",704108,176],["μου",709032,133],["κύριε",707996,153],["ἐξέλιπεν",704237,2],["τὸ",709436,34],["πνεῦμά",710566,15],["μου",709032,133],["μὴ",708851,28],["ἀποστρέψῃς",701598,175],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["ὁμοιωθήσομαι",709628,180],["τοῖς",709436,147],["καταβαίνουσιν",707202,197],["εἰς",704105,0],["λάκκον",708067,6]],"Hear me speedily, O Lord; my spirit has failed; turn not away thy face from me, else I shall be like to them that go down to the pit."],["8",[["ἀκουστὸν",700584,27],["ποίησόν",710582,176],["μοι",708974,159],["τὸ",709436,24],["πρωὶ",711021,28],["τὸ",709436,24],["ἔλεός",704426,25],["σου",711945,133],["ὅτι",709803,7],["ἐπὶ",705080,0],["σοὶ",711925,159],["ἤλπισα",704529,155],["γνώρισόν",703135,176],["μοι",708974,159],["κύριε",707996,153],["ὁδὸν",709458,9],["ἐν",704639,0],["ᾗ",709781,108],["πορεύσομαι",710667,181],["ὅτι",709803,7],["πρὸς",710844,0],["σὲ",711598,163],["ἦρα",700473,155],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133]],"Cause me to hear thy mercy in the morning; for I have hoped in thee; make known to me, O Lord, the way wherein I should walk; for I have lifted up my soul to thee."],["9",[["ἐξελοῦ",704838,300],["με",708618,163],["ἐκ",704132,0],["τῶν",709436,80],["ἐχθρῶν",705779,81],["μου",709032,133],["κύριε",707996,153],["ὅτι",709803,7],["πρὸς",710844,0],["σὲ",711598,163],["κατέφυγον",707472,155]],"Deliver me from mine enemies, O Lord; for I have fled to thee for refuge."],["10",[["δίδαξόν",703649,176],["με",708618,163],["τοῦ",709436,20],["ποιεῖν",710582,55],["τὸ",709436,24],["θέλημά",706170,25],["σου",711945,133],["ὅτι",709803,7],["σὺ",712181,164],["εἶ",704093,154],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["τὸ",709436,34],["πνεῦμά",710566,15],["σου",711945,133],["τὸ",709436,34],["ἀγαθὸν",700106,14],["ὁδηγήσει",709448,127],["με",708618,163],["ἐν",704639,0],["γῇ",703083,1],["εὐθείᾳ",705602,101]],"Teach me to do thy will; for thou art my God; thy good Spirit shall guide me in the straight [way]."],["11",[["ἕνεκα",704709,0],["τοῦ",709436,20],["ὀνόματός",709666,21],["σου",711945,133],["κύριε",707996,153],["ζήσεις",705851,166],["με",708618,163],["ἐν",704639,0],["τῇ",709436,100],["δικαιοσύνῃ",703695,1],["σου",711945,133],["ἐξάξεις",704834,166],["ἐκ",704132,0],["θλίψεως",706276,17],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133]],"Thou shalt quicken me, O Lord, for thy name's sake; in thy righteousness thou shalt bring my soul out of affliction."],["12",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἐλέει",704426,54],["σου",711945,133],["ἐξολεθρεύσεις",704956,166],["τοὺς",709436,58],["ἐχθρούς",705779,57],["μου",709032,133],["καὶ",707031,7],["ἀπολεῖς",701513,166],["πάντας",710177,60],["τοὺς",709436,58],["θλίβοντας",706274,235],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ὅτι",709803,7],["δοῦλός",703817,4],["σού",711945,133],["εἰμι",704093,157],["ἐγώ",704018,164]],"And in thy mercy thou wilt destroy mine enemies, and wilt destroy all those that afflict my soul; for I am thy servant."]]