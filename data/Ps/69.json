[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["τῷ",709436,113],["Δαυιδ",703232,114],["εἰς",704105,0],["ἀνάμνησιν",701004,9]],"For the end, by David for a remembrance, that the Lord may save me."],["2",[["εἰς",704105,0],["τὸ",709436,24],["σῶσαί",712627,106],["με",708618,163],["κύριον",707996,6],["ὁ",709436,3],["θεός",706192,4],["εἰς",704105,0],["τὴν",709436,8],["βοήθειάν",702745,9],["μου",709032,133],["πρόσχες",710895,176]],"Draw nigh, O God, to my help."],["3",[["αἰσχυνθείησαν",700485,393],["καὶ",707031,7],["ἐντραπείησαν",704805,393],["οἱ",709436,136],["ζητοῦντές",705879,146],["μου",709032,133],["τὴν",709436,8],["ψυχήν",714070,9],["ἀποστραφείησαν",701598,393],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,0],["καὶ",707031,7],["καταισχυνθείησαν",707257,393],["οἱ",709436,136],["βουλόμενοί",702795,348],["μοι",708974,159],["κακά",707066,68]],"Let them be ashamed and confounded that seek my soul: let them be turned backward and put to shame, that wish me evil."],["4",[["ἀποστραφείησαν",701598,393],["παραυτίκα",710113,28],["αἰσχυνόμενοι",700485,348],["οἱ",709436,136],["λέγοντές",708124,146],["μοι",708974,159],["εὖγε",705557,28],["εὖγε",705557,28]],"Let them that say to me, Aha, aha, be turned back and put to shame immediately."],["5",[["ἀγαλλιάσθωσαν",700114,77],["καὶ",707031,7],["εὐφρανθήτωσαν",705715,51],["ἐπὶ",705080,0],["σοὶ",711925,159],["πάντες",710177,138],["οἱ",709436,136],["ζητοῦντές",705879,146],["σε",711598,163],["καὶ",707031,7],["λεγέτωσαν",708124,56],["διὰ",703417,0],["παντός",710177,116],["μεγαλυνθήτω",708647,22],["ὁ",709436,3],["θεός",706192,4],["οἱ",709436,136],["ἀγαπῶντες",700120,146],["τὸ",709436,24],["σωτήριόν",712659,25],["σου",711945,133]],"Let all that seek thee exult and be glad in thee: and let those that love thy salvation say continually, Let God be magnified."],["6",[["ἐγὼ",704018,164],["δὲ",703303,11],["πτωχὸς",711076,4],["καὶ",707031,7],["πένης",710248,4],["ὁ",709436,3],["θεός",706192,4],["βοήθησόν",702746,176],["μοι",708974