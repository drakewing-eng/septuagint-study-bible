[["1",[["ᾠδὴ",714091,12],["τῶν",709436,80],["ἀναβαθμῶν",700904,81],["τῷ",709436,113],["Σαλωμων",711430,114],["ἐὰν",703912,7],["μὴ",708851,28],["κύριος",707996,4],["οἰκοδομήσῃ",709509,172],["οἶκον",709516,6],["εἰς",704105,0],["μάτην",708582,28],["ἐκοπίασαν",707824,150],["οἱ",709436,136],["οἰκοδομοῦντες",709509,146],["αὐτόν",702165,556],["ἐὰν",703912,7],["μὴ",708851,28],["κύριος",707996,4],["φυλάξῃ",713619,172],["πόλιν",710612,9],["εἰς",704105,0],["μάτην",708582,28],["ἠγρύπνησεν",700197,2],["ὁ",709436,3],["φυλάσσων",713619,72]],"A Song of Degrees. Except the Lord build the house, they that build labour in vain: except the Lord keep the city, the watchman watches in vain."],["2",[["εἰς",704105,0],["μάτην",708582,28],["ὑμῖν",713084,90],["ἐστιν",704093,91],["τοῦ",709436,20],["ὀρθρίζειν",709742,55],["ἐγείρεσθαι",703949,110],["μετὰ",708780,0],["τὸ",709436,24],["καθῆσθαι",707000,110],["οἱ",709436,136],["ἔσθοντες",705495,146],["ἄρτον",701829,6],["ὀδύνης",709463,17],["ὅταν",709801,28],["δῷ",703654,172],["τοῖς",709436,147],["ἀγαπητοῖς",700124,230],["αὐτοῦ",702165,559],["ὕπνον",713181,6]],"It is vain for you to rise early: ye rise up after resting, ye that eat the bread of grief; while he gives sleep to his beloved."],["3",[["ἰδοὺ",706497,88],["ἡ",709436,10],["κληρονομία",707725,12],["κυρίου",707996,18],["υἱοί",713075,52],["ὁ",709436,3],["μισθὸς",708939,4],["τοῦ",709436,35],["καρποῦ",707169,18],["τῆς",709436,16],["γαστρός",702976,17]],"Behold, the inheritance of the Lord, children, the reward of the fruit of the womb."],["4",[["ὡσεὶ",714159,11],["βέλη",702644,42],["ἐν",704639,0],["χειρὶ",713787,1],["δυνατοῦ",703845,116],["οὕτως",709859,28],["οἱ",709436,136],["υἱοὶ",713075,52],["τῶν",709436,80],["ἐκτετιναγμένων",704334,398]],"As arrows in the hand of a mighty man; so are the children of those who were outcasts."],["5",[["μακάριος",708397,14],["ἄνθρωπος",701163,4],["ὃς",709781,213],["πληρώσει",710543,127],["τὴν",709436,8],["ἐπιθυμίαν",705147,9],["αὐτοῦ",702165,559],["ἐξ",704132,0],["αὐτῶν",702165,565],["οὐ",709805,28],["καταισχυνθήσονται",707257,144],["ὅταν",709801,28],["λαλῶσι",708071,271],["τοῖς",709436,147],["ἐχθροῖς",705779,148],["αὐτῶν",702165,565],["ἐν",704639,0],["πύλῃ",711082,1]],"Blessed is the man who shall satisfy his desire with them: they shall not be ashamed when they shall speak to their enemies in the gates."]]