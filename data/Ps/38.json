[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["τῷ",709436,113],["Ιδιθουν",706489,111],["ᾠδὴ",714091,12],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, a Song of David, to Idithun."],["2",[["εἶπα",705373,155],["φυλάξω",713619,165],["τὰς",709436,38],["ὁδούς",709458,39],["μου",709032,133],["τοῦ",709436,35],["μὴ",708851,28],["ἁμαρτάνειν",700773,55],["ἐν",704639,0],["γλώσσῃ",703120,1],["μου",709032,133],["ἐθέμην",712849,161],["τῷ",709436,53],["στόματί",712125,54],["μου",709032,133],["φυλακὴν",713613,9],["ἐν",704639,0],["τῷ",709436,53],["συστῆναι",712482,106],["τὸν",709436,5],["ἁμαρτωλὸν",700776,27],["ἐναντίον",704654,0],["μου",709032,133]],"I said, I will take heed to my ways, that I sin not with my tongue: I set a guard on my mouth, while the sinner stood in my presence."],["3",[["ἐκωφώθην",708031,156],["καὶ",707031,7],["ἐταπεινώθην",712717,156],["καὶ",707031,7],["ἐσίγησα",711767,155],["ἐξ",704132,0],["ἀγαθῶν",700106,169],["καὶ",707031,7],["τὸ",709436,24],["ἄλγημά",700640,25],["μου",709032,133],["ἀνεκαινίσθη",700965,37]],"I was dumb, and humbled myself, and kept silence from good [words]; and my grief was renewed."],["4",[["ἐθερμάνθη",706213,37],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["ἐντός",704804,28],["μου",709032,133],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["μελέτῃ",708699,1],["μου",709032,133],["ἐκκαυθήσεται",704205,134],["πῦρ",711088,25],["ἐλάλησα",708071,155],["ἐν",704639,0],["γλώσσῃ",703120,1],["μου",709032,133]],"My heart grew hot within me, and a fire would kindle in my meditation: I spoke with my tongue,"],["5",[["γνώρισόν",703135,176],["μοι",708974,159],["κύριε",707996,153],["τὸ",709436,24],["πέρας",710281,15],["μου",709032,133],["καὶ",707031,7],["τὸν",709436,5],["ἀριθμὸν",701744,6],["τῶν",709436,130],["ἡμερῶν",705984,65],["μου",709032,133],["τίς",712867,158],["ἐστιν",704093,91],["ἵνα",706747,7],["γνῶ",703105,207],["τί",712867,126],["ὑστερῶ",713270,157],["ἐγώ",704018,164]],"O Lord, make me to know mine end, and the number of my days, what it is; that I may know what I lack."],["6",[["ἰδοὺ",706497,88],["παλαιστὰς",709938,39],["ἔθου",712849,174],["τὰς",709436,38],["ἡμέρας",705984,39],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["ὑπόστασίς",713241,12],["μου",709032,133],["ὡσεὶ",714159,28],["οὐθὲν",709817,26],["ἐνώπιόν",704823,0],["σου",711945,133],["πλὴν",710540,28],["τὰ",709436,41],["σύμπαντα",712324,68],["ματαιότης",708576,12],["πᾶς",710177,14],["ἄνθρωπος",701163,4],["ζῶν",705851,72],["διάψαλμα",703641,15]],"Behold, thou hast made my days old; and my existence [is] as nothing before thee: nay, every man living [is] altogether vanity. Pause."],["7",[["μέντοιγε",708735,11],["ἐν",704639,0],["εἰκόνι",704089,1],["διαπορεύεται",703551,117],["ἄνθρωπος",701163,4],["πλὴν",710540,28],["μάτην",708582,28],["ταράσσονται",712721,699],["θησαυρίζει",706256,91],["καὶ",707031,7],["οὐ",709805,28],["γινώσκει",703105,91],["τίνι",712867,432],["συνάξει",712375,127],["αὐτά",702165,71]],"Surely man walks in a shadow; nay, he is disquieted in vain: he lays up treasures, and knows not for whom he shall gather them."],["8",[["καὶ",707031,7],["νῦν",709384,28],["τίς",712867,158],["ἡ",709436,10],["ὑπομονή",713226,12],["μου",709032,133],["οὐχὶ",709862,28],["ὁ",709436,3],["κύριος",707996,4],["καὶ",707031,7],["ἡ",709436,10],["ὑπόστασίς",713241,12],["μου",709032,133],["παρὰ",709995,0],["σοῦ",711945,133],["ἐστιν",704093,91]],"And now what [is] my expectation? [is it] not the Lord? and my ground [of hope] is with thee. Pause."],["9",[["ἀπὸ",701425,0],["πασῶν",710177,198],["τῶν",709436,130],["ἀνομιῶν",701192,65],["μου",709032,133],["ῥῦσαί",711309,300],["με",708618,163],["ὄνειδος",709658,25],["ἄφρονι",702236,30],["ἔδωκάς",703654,162],["με",708618,163]],"Deliver me from all my transgressions: thou hast made me a reproach to the foolish."],["10",[["ἐκωφώθην",708031,156],["καὶ",707031,7],["οὐκ",709805,28],["ἤνοιξα",701186,155],["τὸ",709436,24],["στόμα",712125,25],["μου",709032,133],["ὅτι",709803,7],["σὺ",712181,164],["εἶ",704093,154],["ὁ",709436,3],["ποιήσας",710582,182],["με",708618,163]],"I was dumb, and opened not my mouth; for thou art he that made me."],["11",[["ἀπόστησον",702214,176],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["τὰς",709436,38],["μάστιγάς",708568,39],["σου",711945,133],["ἀπὸ",701425,0],["τῆς",709436,16],["ἰσχύος",706858,17],["τῆς",709436,16],["χειρός",713787,17],["σου",711945,133],["ἐγὼ",704018,164],["ἐξέλιπον",704237,155]],"Remove thy scourges from me: I have fainted by reason of the strength of thine hand."],["12",[["ἐν",704639,0],["ἐλεγμοῖς",704413,148],["ὑπὲρ",713111,0],["ἀνομίας",701192,17],["ἐπαίδευσας",709926,162],["ἄνθρωπον",701163,6],["καὶ",707031,7],["ἐξέτηξας",704329,162],["ὡς",714148,7],["ἀράχνην",701693,9],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["πλὴν",710540,28],["μάτην",708582,28],["ταράσσεται",712721,93],["πᾶς",710177,14],["ἄνθρωπος",701163,4],["διάψαλμα",703641,15]],"Thou chastenest man with rebukes for iniquity, and thou makest his life to consume away like a spider's web: nay, every man is disquieted in vain. Pause."],["13",[["εἰσάκουσον",704108,176],["τῆς",709436,16],["προσευχῆς",710892,17],["μου",709032,133],["κύριε",707996,153],["καὶ",707031,7],["τῆς",709436,16],["δεήσεώς",703311,17],["μου",709032,133],["ἐνώτισαι",704825,300],["τῶν",709436,43],["δακρύων",703255,44],["μου",709032,133],["μὴ",708851,28],["παρασιωπήσῃς",710102,175],["ὅτι",709803,7],["πάροικος",710159,14],["ἐγώ",704018,164],["εἰμι",704093,157],["παρὰ",709995,0],["σοὶ",711925,159],["καὶ",707031,7],["παρεπίδημος",710139,14],["καθὼς",707030,28],["πάντες",710177,138],["οἱ",709436,136],["πατέρες",710189,52],["μου",709032,133]],"O Lord, hearken to my prayer and my supplication: attend to my tears: be not silent, for I am a sojourner in the land, and a stranger, as all my fathers [were]."],["14",[["ἄνες",701169,176],["μοι",708974,159],["ἵνα",706747,7],["ἀναψύξω",701095,165],["πρὸ",710747,0],["τοῦ",709436,20],["με",708618,163],["ἀπελθεῖν",701398,106],["καὶ",707031,7],["οὐκέτι",709827,28],["μὴ",708851,28],["ὑπάρξω",713104,207]],"Spare me, that I may be refreshed, before I depart, and be no more."]]