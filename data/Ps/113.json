[["1",[["αλληλουια",700688,88],["ἐν",704639,0],["ἐξόδῳ",704948,1],["Ισραηλ",706839,18],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["οἴκου",709516,18],["Ιακωβ",706401,18],["ἐκ",704132,0],["λαοῦ",708094,18],["βαρβάρου",702528,116]],"Alleluia. At the going forth of Israel from Egypt, of the house of Jacob from a barbarous people,"],["2",[["ἐγενήθη",703104,37],["Ιουδαία",706769,12],["ἁγίασμα",700154,15],["αὐτοῦ",702165,102],["Ισραηλ",706839,4],["ἐξουσία",704974,12],["αὐτοῦ",702165,102]],"Judea became his sanctuary, [and] Israel his dominion."],["3",[["ἡ",709436,10],["θάλασσα",706069,12],["εἶδεν",709725,2],["καὶ",707031,7],["ἔφυγεν",713433,2],["ὁ",709436,3],["Ιορδάνης",706763,4],["ἐστράφη",712160,37],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,0]],"The sea saw and fled: Jordan was turned back."],["4",[["τὰ",709436,63],["ὄρη",709768,64],["ἐσκίρτησαν",711856,150],["ὡσεὶ",714159,11],["κριοὶ",707906,52],["καὶ",707031,7],["οἱ",709436,136],["βουνοὶ",702797,52],["ὡς",714148,11],["ἀρνία",701782,64],["προβάτων",710768,44]],"The mountains skipped like rams, and the hills like lambs."],["5",[["τί",712867,126],["σοί",711925,159],["ἐστιν",704093,91],["θάλασσα",706069,12],["ὅτι",709803,7],["ἔφυγες",713433,162],["καὶ",707031,7],["σοί",711925,159],["Ιορδάνη",706763,153],["ὅτι",709803,7],["ἀνεχώρησας",701092,162],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,0]],"What [ailed] thee, O sea, that thou fleddest? and thou Jordan, that thou wast turned back?"],["6",[["τὰ",709436,41],["ὄρη",709768,42],["ὅτι",709803,7],["ἐσκιρτήσατε",711856,265],["ὡσεὶ",714159,11],["κριοί",707906,52],["καὶ",707031,7],["οἱ",709436,136],["βουνοὶ",702797,52],["ὡς",714148,11],["ἀρνία",701782,64],["προβάτων",710768,44]],"[Ye] mountains, that ye skipped like rams, and [ye] hills, like lambs?"],["7",[["ἀπὸ",701425,0],["προσώπου",710986,21],["κυρίου",707996,18],["ἐσαλεύθη",711403,37],["ἡ",709436,10],["γῆ",703083,12],["ἀπὸ",701425,0],["προσώπου",710986,21],["τοῦ",709436,35],["θεοῦ",706192,18],["Ιακωβ",706401,18]],"The earth trembled at the presence of the Lord, at the presence of the God of Jacob;"],["8",[["τοῦ",709436,35],["στρέψαντος",712160,500],["τὴν",709436,8],["πέτραν",710443,9],["εἰς",704105,0],["λίμνας",708208,39],["ὑδάτων",713071,44],["καὶ",707031,7],["τὴν",709436,8],["ἀκρότομον",700611,36],["εἰς",704105,0],["πηγὰς",710450,39],["ὑδάτων",713071,44]],"who turned the rock into pools of water, and the flint into fountains of water."],["9",[["μὴ",708851,28],["ἡμῖν",705994,90],["κύριε",707996,153],["μὴ",708851,28],["ἡμῖν",705994,90],["ἀλλ᾿",700680,7],["ἢ",705924,7],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["δὸς",703654,176],["δόξαν",703791,9],["ἐπὶ",705080,0],["τῷ",709436,53],["ἐλέει",704426,54],["σου",711945,133],["καὶ",707031,7],["τῇ",709436,100],["ἀληθείᾳ",700656,1],["σου",711945,133]],"Not to us, O Lord, not to us, but to thy name give glory, because of thy mercy and thy truth;"],["10",[["μήποτε",708882,28],["εἴπωσιν",705373,234],["τὰ",709436,63],["ἔθνη",704068,64],["ποῦ",710706,28],["ἐστιν",704093,91],["ὁ",709436,3],["θεὸς",706192,4],["αὐτῶν",702165,40]],"lest at any time the nations should say, Where is their God?"],["11",[["ὁ",709436,3],["δὲ",703303,11],["θεὸς",706192,4],["ἡμῶν",705999,145],["ἐν",704639,0],["τῷ",709436,113],["οὐρανῷ",709844,114],["ἄνω",701296,28],["ἐν",704639,0],["τοῖς",709436,147],["οὐρανοῖς",709844,148],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["πάντα",710177,68],["ὅσα",709788,68],["ἠθέλησεν",706176,2],["ἐποίησεν",710582,2]],"But our God has done in heaven and on earth, whatsoever he has pleased."],["12",[["τὰ",709436,63],["εἴδωλα",704079,64],["τῶν",709436,43],["ἐθνῶν",704068,44],["ἀργύριον",701707,15],["καὶ",707031,7],["χρυσίον",713972,15],["ἔργα",705396,64],["χειρῶν",713787,65],["ἀνθρώπων",701163,81]],"The idols of the nations are silver and gold, the works of men's hands."],["13",[["στόμα",712125,25],["ἔχουσιν",705785,197],["καὶ",707031,7],["οὐ",709805,28],["λαλήσουσιν",708071,218],["ὀφθαλμοὺς",709870,57],["ἔχουσιν",705785,197],["καὶ",707031,7],["οὐκ",709805,28],["ὄψονται",709725,135]],"They have a mouth, but they cannot speak; they have eyes, but they cannot see:"],["14",[["ὦτα",709852,42],["ἔχουσιν",705785,197],["καὶ",707031,7],["οὐκ",709805,28],["ἀκούσονται",700587,135],["ῥῖνας",711268,39],["ἔχουσιν",705785,197],["καὶ",707031,7],["οὐκ",709805,28],["ὀσφρανθήσονται",709798,144]],"they have ears, but they cannot hear; they have noses, but they cannot smell;"],["15",[["χεῖρας",713787,39],["ἔχουσιν",705785,197],["καὶ",707031,7],["οὐ",709805,28],["ψηλαφήσουσιν",714047,218],["πόδας",710707,57],["ἔχουσιν",705785,197],["καὶ",707031,7],["οὐ",709805,28],["περιπατήσουσιν",710362,218],["οὐ",709805,28],["φωνήσουσιν",713639,218],["ἐν",704639,0],["τῷ",709436,113],["λάρυγγι",708098,114],["αὐτῶν",702165,40]],"they have hands, but they cannot handle; they have feet, but they cannot walk: they cannot speak through their throat."],["16",[["ὅμοιοι",709626,138],["αὐτοῖς",702165,151],["γένοιντο",703104,529],["οἱ",709436,136],["ποιοῦντες",710582,146],["αὐτὰ",702165,71],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["πεποιθότες",710221,268],["ἐπ᾿",705080,0],["αὐτοῖς",702165,151]],"Let those that make them become like to them, and all who trust in them."],["17",[["οἶκος",709516,4],["Ισραηλ",706839,18],["ἤλπισεν",704529,2],["ἐπὶ",705080,0],["κύριον",707996,6],["βοηθὸς",702748,4],["αὐτῶν",702165,40],["καὶ",707031,7],["ὑπερασπιστὴς",713123,4],["αὐτῶν",702165,40],["ἐστιν",704093,91]],"The house of Israel trusts in the Lord: he is their helper and defender."],["18",[["οἶκος",709516,4],["Ααρων",700005,18],["ἤλπισεν",704529,2],["ἐπὶ",705080,0],["κύριον",707996,6],["βοηθὸς",702748,4],["αὐτῶν",702165,40],["καὶ",707031,7],["ὑπερασπιστὴς",713123,4],["αὐτῶν",702165,40],["ἐστιν",704093,91]],"The house of Aaron trusts in the Lord: he is their helper and defender."],["19",[["οἱ",709436,136],["φοβούμενοι",713532,348],["τὸν",709436,5],["κύριον",707996,6],["ἤλπισαν",704529,150],["ἐπὶ",705080,0],["κύριον",707996,6],["βοηθὸς",702748,4],["αὐτῶν",702165,40],["καὶ",707031,7],["ὑπερασπιστὴς",713123,4],["αὐτῶν",702165,40],["ἐστιν",704093,91]],"They that fear the Lord trust in the Lord: he is their helper and defender."],["20",[["κύριος",707996,4],["ἐμνήσθη",708960,37],["ἡμῶν",705999,145],["καὶ",707031,7],["εὐλόγησεν",705631,2],["ἡμᾶς",705981,194],["εὐλόγησεν",705631,2],["τὸν",709436,5],["οἶκον",709516,6],["Ισραηλ",706839,18],["εὐλόγησεν",705631,2],["τὸν",709436,5],["οἶκον",709516,6],["Ααρων",700005,18]],"The Lord has remembered us, and blessed us: he has blessed the house of Israel, he has blessed the house of Aaron."],["21",[["εὐλόγησεν",705631,2],["τοὺς",709436,58],["φοβουμένους",713532,236],["τὸν",709436,5],["κύριον",707996,6],["τοὺς",709436,58],["μικροὺς",708915,60],["μετὰ",708780,0],["τῶν",709436,80],["μεγάλων",708653,169]],"He has blessed them that fear the Lord, both small and great."],["22",[["προσθείη",710965,225],["κύριος",707996,4],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["καὶ",707031,7],["ἐπὶ",705080,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["ὑμῶν",713091,145]],"The Lord add [blessings] to you and to your children."],["23",[["εὐλογημένοι",705631,429],["ὑμεῖς",713081,219],["τῷ",709436,113],["κυρίῳ",707996,114],["τῷ",709436,113],["ποιήσαντι",710582,350],["τὸν",709436,5],["οὐρανὸν",709844,6],["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9]],"Blessed are ye of the Lord, who made the heaven and the earth."],["24",[["ὁ",709436,3],["οὐρανὸς",709844,4],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["τῷ",709436,113],["κυρίῳ",707996,114],["τὴν",709436,8],["δὲ",703303,11],["γῆν",703083,9],["ἔδωκεν",703654,2],["τοῖς",709436,147],["υἱοῖς",713075,148],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"The heaven of heavens [belongs] to the Lord: but he has given the earth to the sons of men."],["25",[["οὐχ",709805,28],["οἱ",709436,136],["νεκροὶ",709247,52],["αἰνέσουσίν",700459,218],["σε",711598,163],["κύριε",707996,153],["οὐδὲ",709816,7],["πάντες",710177,138],["οἱ",709436,136],["καταβαίνοντες",707202,146],["εἰς",704105,0],["ᾅδου",700255,18]],"The dead shall not praise thee, O Lord, nor any that go down to Hades."],["26",[["ἀλλ᾿",700680,7],["ἡμεῖς",705983,219],["οἱ",709436,136],["ζῶντες",705851,146],["εὐλογήσομεν",705631,275],["τὸν",709436,5],["κύριον",707996,6],["ἀπὸ",701425,0],["τοῦ",709436,35],["νῦν",709384,28],["καὶ",707031,7],["ἕως",705792,0],["τοῦ",709436,35],["αἰῶνος",700504,18]],"But we, the living, will bless the Lord, from henceforth and for ever."]]