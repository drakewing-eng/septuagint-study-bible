[["1",[["τῷ",709436,113],["Δαυιδ",703232,114],["ὅτε",709802,28],["ἡ",709436,10],["γῆ",703083,12],["αὐτοῦ",702165,102],["καθίσταται",707011,134],["ὁ",709436,3],["κύριος",707996,4],["ἐβασίλευσεν",702581,2],["ἀγαλλιάσθω",700114,407],["ἡ",709436,10],["γῆ",703083,12],["εὐφρανθήτωσαν",705715,51],["νῆσοι",709302,191],["πολλαί",710646,192]],"For David, when his land is established. The Lord reigns, let the earth exult, let many islands rejoice."],["2",[["νεφέλη",709277,12],["καὶ",707031,7],["γνόφος",703131,4],["κύκλῳ",707959,114],["αὐτοῦ",702165,102],["δικαιοσύνη",703695,12],["καὶ",707031,7],["κρίμα",707903,15],["κατόρθωσις",707550,12],["τοῦ",709436,35],["θρόνου",706315,18],["αὐτοῦ",702165,102]],"Cloud and darkness are round about him; righteousness and judgment are the establishment of his throne."],["3",[["πῦρ",711088,25],["ἐναντίον",704654,0],["αὐτοῦ",702165,102],["προπορεύσεται",710839,93],["καὶ",707031,7],["φλογιεῖ",713521,127],["κύκλῳ",707959,114],["τοὺς",709436,58],["ἐχθροὺς",705779,57],["αὐτοῦ",702165,102]],"Fire shall go before him, and burn up his enemies round about."],["4",[["ἔφαναν",713311,150],["αἱ",709436,190],["ἀστραπαὶ",702021,191],["αὐτοῦ",702165,102],["τῇ",709436,100],["οἰκουμένῃ",709517,585],["εἶδεν",709725,2],["καὶ",707031,7],["ἐσαλεύθη",711403,37],["ἡ",709436,10],["γῆ",703083,12]],"His lightnings appeared to the world; the earth saw, and trembled."],["5",[["τὰ",709436,63],["ὄρη",709768,64],["ἐτάκησαν",712839,150],["ὡσεὶ",714159,11],["κηρὸς",707659,4],["ἀπὸ",701425,0],["προσώπου",710986,21],["κυρίου",707996,18],["ἀπὸ",701425,0],["προσώπου",710986,21],["κυρίου",707996,18],["πάσης",710177,82],["τῆς",709436,16],["γῆς",703083,17]],"The mountains melted like wax at the presence of the Lord, at the presence of the Lord of the whole earth."],["6",[["ἀνήγγειλαν",700921,150],["οἱ",709436,136],["οὐρανοὶ",709844,52],["τὴν",709436,8],["δικαιοσύνην",703695,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἴδοσαν",709725,150],["πάντες",710177,138],["οἱ",709436,136],["λαοὶ",708094,52],["τὴν",709436,8],["δόξαν",703791,9],["αὐτοῦ",702165,102]],"The heavens have declared his righteousness, and all the people have seen his glory."],["7",[["αἰσχυνθήτωσαν",700485,51],["πάντες",710177,138],["οἱ",709436,136],["προσκυνοῦντες",710925,146],["τοῖς",709436,147],["γλυπτοῖς",703117,230],["οἱ",709436,136],["ἐγκαυχώμενοι",703971,348],["ἐν",704639,0],["τοῖς",709436,95],["εἰδώλοις",704079,96],["αὐτῶν",702165,40],["προσκυνήσατε",710925,74],["αὐτῷ",702165,50],["πάντες",710177,138],["οἱ",709436,136],["ἄγγελοι",700140,52],["αὐτοῦ",702165,102]],"Let all that worship graven images be ashamed, who boast of their idols; worship him, all ye his angels."],["8",[["ἤκουσεν",700587,2],["καὶ",707031,7],["εὐφράνθη",705715,37],["Σιων",711816,12],["καὶ",707031,7],["ἠγαλλιάσαντο",700114,189],["αἱ",709436,190],["θυγατέρες",706320,191],["τῆς",709436,16],["Ιουδαίας",706769,17],["ἕνεκεν",704709,0],["τῶν",709436,43],["κριμάτων",707903,44],["σου",711945,133],["κύριε",707996,153]],"Sion heard and rejoiced; and the daughters of Judea exulted, because of thy judgments, O Lord."],["9",[["ὅτι",709803,7],["σὺ",712181,164],["εἶ",704093,154],["κύριος",707996,4],["ὁ",709436,3],["ὕψιστος",713287,14],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9],["σφόδρα",712586,28],["ὑπερυψώθης",713163,168],["ὑπὲρ",713111,0],["πάντας",710177,60],["τοὺς",709436,58],["θεούς",706192,57]],"For thou art Lord most high over all the earth; thou art greatly exalted above all gods."],["10",[["οἱ",709436,136],["ἀγαπῶντες",700120,146],["τὸν",709436,5],["κύριον",707996,6],["μισεῖτε",708935,87],["πονηρόν",710660,27],["φυλάσσει",713619,91],["κύριος",707996,4],["τὰς",709436,38],["ψυχὰς",714070,39],["τῶν",709436,80],["ὁσίων",709782,169],["αὐτοῦ",702165,102],["ἐκ",704132,0],["χειρὸς",713787,17],["ἁμαρτωλῶν",700776,169],["ῥύσεται",711309,93],["αὐτούς",702165,62]],"Ye that love the Lord, hate evil; the Lord preserves the souls of his saints; he shall deliver them from the hand of sinners."],["11",[["φῶς",713642,15],["ἀνέτειλεν",701066,2],["τῷ",709436,113],["δικαίῳ",703694,30],["καὶ",707031,7],["τοῖς",709436,147],["εὐθέσι",705602,230],["τῇ",709436,100],["καρδίᾳ",707141,1],["εὐφροσύνη",705717,12]],"Light is sprung up for the righteous, and gladness for the upright in heart."],["12",[["εὐφράνθητε",705715,394],["δίκαιοι",703694,138],["ἐπὶ",705080,0],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["ἐξομολογεῖσθε",704960,374],["τῇ",709436,100],["μνήμῃ",708964,1],["τῆς",709436,16],["ἁγιωσύνης",700161,17],["αὐτοῦ",702165,102]],"Rejoice in the Lord, ye righteous; and give thanks for a remembrance of his holiness."]]