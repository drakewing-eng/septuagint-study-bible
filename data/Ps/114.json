[["1",[["αλληλουια",700688,88],["ἠγάπησα",700120,155],["ὅτι",709803,7],["εἰσακούσεται",704108,93],["κύριος",707996,4],["τῆς",709436,16],["φωνῆς",713640,17],["τῆς",709436,16],["δεήσεώς",703311,17],["μου",709032,133]],"Alleluia. I am well pleased, because the Lord will hearken to the voice of my supplication."],["2",[["ὅτι",709803,7],["ἔκλινεν",707738,13],["τὸ",709436,24],["οὖς",709852,25],["αὐτοῦ",702165,102],["ἐμοί",704577,159],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["μου",709032,133],["ἐπικαλέσομαι",705153,181]],"Because he has inclined his ear to me, therefore will I call upon him while I live."],["3",[["περιέσχον",710315,150],["με",708618,163],["ὠδῖνες",714094,191],["θανάτου",706096,18],["κίνδυνοι",707678,52],["ᾅδου",700255,18],["εὕροσάν",705676,150],["με",708618,163],["θλῖψιν",706276,9],["καὶ",707031,7],["ὀδύνην",709463,9],["εὗρον",705676,155]],"The pangs of death compassed me; the dangers of hell found me: I found affliction and sorrow."],["4",[["καὶ",707031,7],["τὸ",709436,24],["ὄνομα",709666,25],["κυρίου",707996,18],["ἐπεκαλεσάμην",705153,161],["ὦ",714081,88],["κύριε",707996,153],["ῥῦσαι",711309,300],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133]],"Then I called on the name of the Lord: O Lord, deliver my soul."],["5",[["ἐλεήμων",704422,14],["ὁ",709436,3],["κύριος",707996,4],["καὶ",707031,7],["δίκαιος",703694,14],["καὶ",707031,7],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["ἐλεᾷ",704412,91]],"The Lord is merciful and righteous; yea, our God has pity."],["6",[["φυλάσσων",713619,72],["τὰ",709436,41],["νήπια",709295,68],["ὁ",709436,3],["κύριος",707996,4],["ἐταπεινώθην",712717,156],["καὶ",707031,7],["ἔσωσέν",712627,2],["με",708618,163]],"The Lord preserves the simple: I was brought low, and he delivered me."],["7",[["ἐπίστρεψον",705278,176],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["εἰς",704105,0],["τὴν",709436,8],["ἀνάπαυσίν",701026,9],["σου",711945,133],["ὅτι",709803,7],["κύριος",707996,4],["εὐηργέτησέν",705575,2],["σε",711598,163]],"Return to thy rest, O my soul; for the Lord has dealt bountifully with thee."],["8",[["ὅτι",709803,7],["ἐξείλατο",704838,23],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἐκ",704132,0],["θανάτου",706096,18],["τοὺς",709436,58],["ὀφθαλμούς",709870,57],["μου",709032,133],["ἀπὸ",701425,0],["δακρύων",703255,44],["καὶ",707031,7],["τοὺς",709436,58],["πόδας",710707,57],["μου",709032,133],["ἀπὸ",701425,0],["ὀλισθήματος",709580,21]],"For he has delivered my soul from death, mine eyes from tears, and my feet from falling."],["9",[["εὐαρεστήσω",705554,207],["ἐναντίον",704654,0],["κυρίου",707996,18],["ἐν",704639,0],["χώρᾳ",714011,1],["ζώντων",705851,170]],"I shall be well-pleasing before the Lord in the land of the living."]]