[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ὑπὲρ",713111,0],["Ιδιθουν",706489,227],["τῷ",709436,113],["Ασαφ",701894,114],["ψαλμός",714022,4]],"For the end, for Idithun, a Psalm of Asaph."],["2",[["φωνῇ",713640,1],["μου",709032,133],["πρὸς",710844,0],["κύριον",707996,6],["ἐκέκραξα",707868,155],["φωνῇ",713640,1],["μου",709032,133],["πρὸς",710844,0],["τὸν",709436,5],["θεόν",706192,6],["καὶ",707031,7],["προσέσχεν",710895,2],["μοι",708974,159]],"I cried to the Lord with my voice, yea, my voice [was addressed] to God; and he gave heed to me."],["3",[["ἐν",704639,0],["ἡμέρᾳ",705984,1],["θλίψεώς",706276,17],["μου",709032,133],["τὸν",709436,5],["θεὸν",706192,6],["ἐξεζήτησα",704187,155],["ταῖς",709436,75],["χερσίν",713787,76],["μου",709032,133],["νυκτὸς",709386,17],["ἐναντίον",704654,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ἠπατήθην",701364,156],["ἀπηνήνατο",701342,23],["παρακληθῆναι",710039,179],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133]],"In the day of mine affliction I earnestly sought the Lord; [even] with my hands by night before him, and I was not deceived; my soul refused to be comforted."],["4",[["ἐμνήσθην",708960,156],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["εὐφράνθην",705715,156],["ἠδολέσχησα",700281,155],["καὶ",707031,7],["ὠλιγοψύχησεν",709572,2],["τὸ",709436,24],["πνεῦμά",710566,25],["μου",709032,133],["διάψαλμα",703641,15]],"I remembered God, and rejoiced; I poured out my complaint, and my soul fainted. Pause."],["5",[["προκατελάβοντο",710809,189],["φυλακὰς",713613,39],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["μου",709032,133],["ἐταράχθην",712721,156],["καὶ",707031,7],["οὐκ",709805,28],["ἐλάλησα",708071,155]],"All mine enemies set a watch [against me]: I was troubled, and spoke not."],["6",[["διελογισάμην",703505,161],["ἡμέρας",705984,17],["ἀρχαίας",701835,82],["καὶ",707031,7],["ἔτη",705543,42],["αἰώνια",700505,68],["ἐμνήσθην",708960,156],["καὶ",707031,7],["ἐμελέτησα",708698,155]],"I considered the days of old, and remembered ancient years."],["7",[["νυκτὸς",709386,17],["μετὰ",708780,0],["τῆς",709436,16],["καρδίας",707141,17],["μου",709032,133],["ἠδολέσχουν",700281,137],["καὶ",707031,7],["ἔσκαλλεν",711822,2],["τὸ",709436,34],["πνεῦμά",710566,15],["μου",709032,133]],"And I meditated; I communed with my heart by night, and diligently searched my spirit, [saying],"],["8",[["μὴ",708851,28],["εἰς",704105,0],["τοὺς",709436,58],["αἰῶνας",700504,57],["ἀπώσεται",701659,93],["κύριος",707996,4],["καὶ",707031,7],["οὐ",709805,28],["προσθήσει",710965,127],["τοῦ",709436,20],["εὐδοκῆσαι",705565,106],["ἔτι",705538,28]],"Will the Lord cast off for ever? and will he be well pleased no more?"],["9",[["ἢ",705924,7],["εἰς",704105,0],["τέλος",712787,25],["τὸ",709436,34],["ἔλεος",704426,15],["αὐτοῦ",702165,102],["ἀποκόψει",701489,127],["ἀπὸ",701425,0],["γενεᾶς",703037,17],["εἰς",704105,0],["γενεάν",703037,9]],"Will he cut off his mercy for ever, even for ever and ever?"],["10",[["ἢ",705924,7],["ἐπιλήσεται",705187,93],["τοῦ",709436,20],["οἰκτιρῆσαι",709518,106],["ὁ",709436,3],["θεὸς",706192,4],["ἢ",705924,7],["συνέξει",712469,127],["ἐν",704639,0],["τῇ",709436,100],["ὀργῇ",709728,1],["αὐτοῦ",702165,102],["τοὺς",709436,58],["οἰκτιρμοὺς",709520,57],["αὐτοῦ",702165,102],["διάψαλμα",703641,15]],"Will God forget to pity? or will he shut up his compassions in his wrath? Pause."],["11",[["καὶ",707031,7],["εἶπα",705373,155],["νῦν",709384,28],["ἠρξάμην",701860,161],["αὕτη",709858,107],["ἡ",709436,10],["ἀλλοίωσις",700695,12],["τῆς",709436,16],["δεξιᾶς",703360,82],["τοῦ",709436,35],["ὑψίστου",713287,116]],"And I said, Now I have begun; this is the change of the right hand of the Most High."],["12",[["ἐμνήσθην",708960,156],["τῶν",709436,43],["ἔργων",705396,44],["κυρίου",707996,18],["ὅτι",709803,7],["μνησθήσομαι",708923,180],["ἀπὸ",701425,0],["τῆς",709436,16],["ἀρχῆς",701836,17],["τῶν",709436,80],["θαυμασίων",706136,169],["σου",711945,133]],"I remembered the works of the Lord; for I will remember thy wonders from the beginning."],["13",[["καὶ",707031,7],["μελετήσω",708698,165],["ἐν",704639,0],["πᾶσιν",710177,230],["τοῖς",709436,95],["ἔργοις",705396,96],["σου",711945,133],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["ἐπιτηδεύμασίν",705301,96],["σου",711945,133],["ἀδολεσχήσω",700281,165]],"And I will meditate on all thy works, and will consider thy doings."],["14",[["ὁ",709436,3],["θεός",706192,4],["ἐν",704639,0],["τῷ",709436,113],["ἁγίῳ",700159,30],["ἡ",709436,10],["ὁδός",709458,12],["σου",711945,133],["τίς",712867,158],["θεὸς",706192,4],["μέγας",708653,14],["ὡς",714148,7],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145]],"O God, thy way is in the sanctuary; who is a great God as our God?"],["15",[["σὺ",712181,164],["εἶ",704093,154],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["ποιῶν",710582,72],["θαυμάσια",706136,68],["ἐγνώρισας",703135,162],["ἐν",704639,0],["τοῖς",709436,147],["λαοῖς",708094,148],["τὴν",709436,8],["δύναμίν",703839,9],["σου",711945,133]],"Thou art the God that doest wonders; thou hast made known thy power among the nations."],["16",[["ἐλυτρώσω",708282,174],["ἐν",704639,0],["τῷ",709436,113],["βραχίονί",702808,114],["σου",711945,133],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ιακωβ",706401,18],["καὶ",707031,7],["Ιωσηφ",706948,18],["διάψαλμα",703641,15]],"Thou hast with thine arm redeemed thy people, the sons of Jacob and Joseph. Pause."],["17",[["εἴδοσάν",709725,150],["σε",711598,163],["ὕδατα",713071,25],["ὁ",709436,3],["θεός",706192,4],["εἴδοσάν",709725,150],["σε",711598,163],["ὕδατα",713071,25],["καὶ",707031,7],["ἐφοβήθησαν",713532,99],["καὶ",707031,7],["ἐταράχθησαν",712721,99],["ἄβυσσοι",700098,191],["πλῆθος",710529,25],["ἤχους",706046,57],["ὑδάτων",713071,44]],"The waters saw thee, O God, the waters saw thee, and feared; and the depths were troubled."],["18",[["φωνὴν",713640,9],["ἔδωκαν",703654,150],["αἱ",709436,190],["νεφέλαι",709277,191],["καὶ",707031,7],["γὰρ",702963,11],["τὰ",709436,41],["βέλη",702644,42],["σου",711945,133],["διαπορεύονται",703551,269]],"[There was] an abundant sound of waters: the clouds uttered a voice; for thine arrows went abroad."],["19",[["φωνὴ",713640,12],["τῆς",709436,16],["βροντῆς",702816,17],["σου",711945,133],["ἐν",704639,0],["τῷ",709436,113],["τροχῷ",712994,114],["ἔφαναν",713311,150],["αἱ",709436,190],["ἀστραπαί",702021,191],["σου",711945,133],["τῇ",709436,100],["οἰκουμένῃ",709517,585],["ἐσαλεύθη",711403,37],["καὶ",707031,7],["ἔντρομος",704808,29],["ἐγενήθη",703104,37],["ἡ",709436,10],["γῆ",703083,12]],"The voice of thy thunder was abroad, and around thy lightnings appeared to the world; the earth trembled and quaked."],["20",[["ἐν",704639,0],["τῇ",709436,100],["θαλάσσῃ",706069,1],["ἡ",709436,10],["ὁδός",709458,12],["σου",711945,133],["καὶ",707031,7],["αἱ",709436,190],["τρίβοι",712939,191],["σου",711945,133],["ἐν",704639,0],["ὕδασι",713071,96],["πολλοῖς",710646,94],["καὶ",707031,7],["τὰ",709436,63],["ἴχνη",706873,64],["σου",711945,133],["οὐ",709805,28],["γνωσθήσονται",703105,144]],"Thy way is in the sea, and thy paths in many waters, and thy footsteps cannot be known."],["21",[["ὡδήγησας",709448,162],["ὡς",714148,7],["πρόβατα",710768,42],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133],["ἐν",704639,0],["χειρὶ",713787,1],["Μωυσῆ",709112,18],["καὶ",707031,7],["Ααρων",700005,18]],"Thou didst guide thy people as sheep by the hand of Moses and Aaron."]]