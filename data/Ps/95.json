[["1",[["ὅτε",709802,28],["ὁ",709436,3],["οἶκος",709516,4],["ᾠκοδομεῖτο",709509,19],["μετὰ",708780,0],["τὴν",709436,8],["αἰχμαλωσίαν",700499,9],["ᾠδὴ",714091,12],["τῷ",709436,113],["Δαυιδ",703232,114],["ᾄσατε",700299,74],["τῷ",709436,113],["κυρίῳ",707996,114],["ᾆσμα",701970,25],["καινόν",707042,46],["ᾄσατε",700299,74],["τῷ",709436,113],["κυρίῳ",707996,114],["πᾶσα",710177,29],["ἡ",709436,10],["γῆ",703083,12]],"When the house was built after the Captivity, a Song by David. Sing to the Lord a new song; sing to the Lord, all the earth."],["2",[["ᾄσατε",700299,74],["τῷ",709436,113],["κυρίῳ",707996,114],["εὐλογήσατε",705631,74],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["εὐαγγελίζεσθε",705547,186],["ἡμέραν",705984,9],["ἐξ",704132,0],["ἡμέρας",705984,17],["τὸ",709436,24],["σωτήριον",712659,25],["αὐτοῦ",702165,102]],"Sing to the Lord, bless his name: proclaim his salvation from day to day."],["3",[["ἀναγγείλατε",700921,74],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["τὴν",709436,8],["δόξαν",703791,9],["αὐτοῦ",702165,102],["ἐν",704639,0],["πᾶσι",710177,230],["τοῖς",709436,147],["λαοῖς",708094,148],["τὰ",709436,41],["θαυμάσια",706136,68],["αὐτοῦ",702165,102]],"Publish his glory among the Gentiles, his wonderful works among all people."],["4",[["ὅτι",709803,7],["μέγας",708653,14],["κύριος",707996,4],["καὶ",707031,7],["αἰνετὸς",700458,14],["σφόδρα",712586,28],["φοβερός",713530,14],["ἐστιν",704093,91],["ἐπὶ",705080,0],["πάντας",710177,60],["τοὺς",709436,58],["θεούς",706192,57]],"For the Lord is great, and greatly to be praised: he is terrible above all gods."],["5",[["ὅτι",709803,7],["πάντες",710177,138],["οἱ",709436,136],["θεοὶ",706192,52],["τῶν",709436,43],["ἐθνῶν",704068,44],["δαιμόνια",703249,64],["ὁ",709436,3],["δὲ",703303,11],["κύριος",707996,4],["τοὺς",709436,58],["οὐρανοὺς",709844,57],["ἐποίησεν",710582,2]],"For all the gods of the heathen are devils: but the Lord made the heavens."],["6",[["ἐξομολόγησις",704961,12],["καὶ",707031,7],["ὡραιότης",714133,4],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["ἁγιωσύνη",700161,12],["καὶ",707031,7],["μεγαλοπρέπεια",708632,12],["ἐν",704639,0],["τῷ",709436,53],["ἁγιάσματι",700154,54],["αὐτοῦ",702165,102]],"Thanksgiving and beauty are before him: holiness and majesty are in his sanctuary."],["7",[["ἐνέγκατε",713428,74],["τῷ",709436,113],["κυρίῳ",707996,114],["αἱ",709436,190],["πατριαὶ",710192,191],["τῶν",709436,43],["ἐθνῶν",704068,44],["ἐνέγκατε",713428,74],["τῷ",709436,113],["κυρίῳ",707996,114],["δόξαν",703791,9],["καὶ",707031,7],["τιμήν",712856,9]],"Bring to the Lord, ye families of the Gentiles, bring to the Lord glory and honour."],["8",[["ἐνέγκατε",713428,74],["τῷ",709436,113],["κυρίῳ",707996,114],["δόξαν",703791,9],["ὀνόματι",709666,54],["αὐτοῦ",702165,102],["ἄρατε",700473,74],["θυσίας",706345,39],["καὶ",707031,7],["εἰσπορεύεσθε",704124,374],["εἰς",704105,0],["τὰς",709436,38],["αὐλὰς",702137,39],["αὐτοῦ",702165,102]],"Bring to the Lord the glory [becoming] his name: take offerings, and go into his courts."],["9",[["προσκυνήσατε",710925,74],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐν",704639,0],["αὐλῇ",702137,1],["ἁγίᾳ",700159,101],["αὐτοῦ",702165,102],["σαλευθήτω",711403,22],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["πᾶσα",710177,29],["ἡ",709436,10],["γῆ",703083,12]],"Worship the Lord in his holy court: let all the earth tremble before him."],["10",[["εἴπατε",705373,265],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["ὁ",709436,3],["κύριος",707996,4],["ἐβασίλευσεν",702581,2],["καὶ",707031,7],["γὰρ",702963,11],["κατώρθωσεν",707548,2],["τὴν",709436,8],["οἰκουμένην",709517,173],["ἥτις",709793,412],["οὐ",709805,28],["σαλευθήσεται",711403,134],["κρινεῖ",707905,127],["λαοὺς",708094,57],["ἐν",704639,0],["εὐθύτητι",705603,1]],"Say among the heathen, The Lord reigns: for he has established the world so that it shall not be moved: he shall judge the people in righteousness."],["11",[["εὐφραινέσθωσαν",705715,77],["οἱ",709436,136],["οὐρανοί",709844,52],["καὶ",707031,7],["ἀγαλλιάσθω",700114,407],["ἡ",709436,10],["γῆ",703083,12],["σαλευθήτω",711403,22],["ἡ",709436,10],["θάλασσα",706069,12],["καὶ",707031,7],["τὸ",709436,24],["πλήρωμα",710544,25],["αὐτῆς",702165,86]],"Let the heavens rejoice, and the earth exult; let the sea be moved, and the fulness of it."],["12",[["χαρήσεται",713665,134],["τὰ",709436,63],["πεδία",710215,64],["καὶ",707031,7],["πάντα",710177,195],["τὰ",709436,63],["ἐν",704639,0],["αὐτοῖς",702165,206],["τότε",712908,28],["ἀγαλλιάσονται",700114,135],["πάντα",710177,195],["τὰ",709436,63],["ξύλα",709427,64],["τοῦ",709436,35],["δρυμοῦ",703836,18]],"The plains shall rejoice, and all things in them: then shall all the trees of the wood exult before the presence of the Lord:"],["13",[["πρὸ",710747,0],["προσώπου",710986,21],["κυρίου",707996,18],["ὅτι",709803,7],["ἔρχεται",705453,117],["ὅτι",709803,7],["ἔρχεται",705453,117],["κρῖναι",707905,106],["τὴν",709436,8],["γῆν",703083,9],["κρινεῖ",707905,127],["τὴν",709436,8],["οἰκουμένην",709517,173],["ἐν",704639,0],["δικαιοσύνῃ",703695,1],["καὶ",707031,7],["λαοὺς",708094,57],["ἐν",704639,0],["τῇ",709436,100],["ἀληθείᾳ",700656,1],["αὐτοῦ",702165,102]],"for he comes, for he comes to judge the earth; he shall judge the world in righteousness, and the people with his truth."]]