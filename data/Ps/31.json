[["1",[["τῷ",709436,113],["Δαυιδ",703232,114],["συνέσεως",712460,17],["μακάριοι",708397,138],["ὧν",709781,252],["ἀφέθησαν",702211,99],["αἱ",709436,190],["ἀνομίαι",701192,191],["καὶ",707031,7],["ὧν",709781,252],["ἐπεκαλύφθησαν",705155,99],["αἱ",709436,190],["ἁμαρτίαι",700775,191]],"[A Psalm] of instruction by David. Blessed [are they] whose transgressions are forgiven, and whose sins are covered."],["2",[["μακάριος",708397,14],["ἀνήρ",701150,4],["οὗ",709781,48],["οὐ",709805,28],["μὴ",708851,28],["λογίσηται",708232,239],["κύριος",707996,4],["ἁμαρτίαν",700775,9],["οὐδὲ",709816,7],["ἔστιν",704093,91],["ἐν",704639,0],["τῷ",709436,53],["στόματι",712125,54],["αὐτοῦ",702165,102],["δόλος",703787,4]],"Blessed is the man to whom the Lord will not impute sin, and in whose mouth there is no guile."],["3",[["ὅτι",709803,7],["ἐσίγησα",711767,155],["ἐπαλαιώθη",709937,37],["τὰ",709436,63],["ὀστᾶ",709792,64],["μου",709032,133],["ἀπὸ",701425,0],["τοῦ",709436,20],["κράζειν",707868,55],["με",708618,163],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9]],"Because I kept silence, my bones waxed old, from my crying all the day."],["4",[["ὅτι",709803,7],["ἡμέρας",705984,17],["καὶ",707031,7],["νυκτὸς",709386,17],["ἐβαρύνθη",702553,37],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ἡ",709436,10],["χείρ",713787,12],["σου",711945,133],["ἐστράφην",712160,156],["εἰς",704105,0],["ταλαιπωρίαν",712695,9],["ἐν",704639,0],["τῷ",709436,53],["ἐμπαγῆναι",704590,179],["ἄκανθαν",700517,9],["διάψαλμα",703641,15]],"For day and night thy hand was heavy upon me: I became thoroughly miserable while a thorn was fastened in [me]. Pause."],["5",[["τὴν",709436,8],["ἁμαρτίαν",700775,9],["μου",709032,133],["ἐγνώρισα",703135,155],["καὶ",707031,7],["τὴν",709436,8],["ἀνομίαν",701192,9],["μου",709032,133],["οὐκ",709805,28],["ἐκάλυψα",707102,155],["εἶπα",705373,155],["ἐξαγορεύσω",704831,165],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["τὴν",709436,8],["ἀνομίαν",701192,9],["μου",709032,133],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["σὺ",712181,164],["ἀφῆκας",702211,162],["τὴν",709436,8],["ἀσέβειαν",701904,9],["τῆς",709436,16],["ἁμαρτίας",700775,17],["μου",709032,133],["διάψαλμα",703641,15]],"I acknowledged my sin, and hid not mine iniquity: I said, I will confess mine iniquity to the Lord against myself; and thou forgavest the ungodliness of my heart. Pause."],["6",[["ὑπὲρ",713111,0],["ταύτης",709858,86],["προσεύξεται",710893,93],["πᾶς",710177,14],["ὅσιος",709782,14],["πρὸς",710844,0],["σὲ",711598,163],["ἐν",704639,0],["καιρῷ",707047,114],["εὐθέτῳ",705592,30],["πλὴν",710540,28],["ἐν",704639,0],["κατακλυσμῷ",707279,114],["ὑδάτων",713071,44],["πολλῶν",710646,83],["πρὸς",710844,0],["αὐτὸν",702165,85],["οὐκ",709805,28],["ἐγγιοῦσιν",703939,218]],"Therefore shall every holy one pray to thee in a fit time: only in the deluge of many waters they shall not come nigh to him."],["7",[["σύ",712181,164],["μου",709032,133],["εἶ",704093,154],["καταφυγὴ",707485,12],["ἀπὸ",701425,0],["θλίψεως",706276,17],["τῆς",709436,16],["περιεχούσης",710315,222],["με",708618,163],["τὸ",709436,24],["ἀγαλλίαμά",700112,25],["μου",709032,133],["λύτρωσαί",708282,106],["με",708618,163],["ἀπὸ",701425,0],["τῶν",709436,80],["κυκλωσάντων",707958,221],["με",708618,163],["διάψαλμα",703641,15]],"Thou art my refuge from the affliction that encompasses me; my joy, to deliver me from them that have compassed me. Pause."],["8",[["συνετιῶ",712463,165],["σε",711598,163],["καὶ",707031,7],["συμβιβῶ",712280,165],["σε",711598,163],["ἐν",704639,0],["ὁδῷ",709458,1],["ταύτῃ",709858,105],["ᾗ",709781,108],["πορεύσῃ",710667,172],["ἐπιστηριῶ",705270,165],["ἐπὶ",705080,0],["σὲ",711598,163],["τοὺς",709436,58],["ὀφθαλμούς",709870,57],["μου",709032,133]],"I will instruct thee and guide thee in this way wherein thou shalt go: I will fix mine eyes upon thee."],["9",[["μὴ",708851,28],["γίνεσθε",703104,73],["ὡς",714148,7],["ἵππος",706790,4],["καὶ",707031,7],["ἡμίονος",705995,4],["οἷς",709781,311],["οὐκ",709805,28],["ἔστιν",704093,91],["σύνεσις",712460,12],["ἐν",704639,0],["χαλινῷ",713685,114],["καὶ",707031,7],["κημῷ",707653,114],["τὰς",709436,38],["σιαγόνας",711763,39],["αὐτῶν",702165,40],["ἄγξαι",700207,106],["τῶν",709436,80],["μὴ",708851,28],["ἐγγιζόντων",703939,170],["πρὸς",710844,0],["σέ",711598,163]],"Be ye not as horse and mule, which have no understanding: [but thou must] constrain their jaws with bit and curb, lest they should come nigh to thee."],["10",[["πολλαὶ",710646,192],["αἱ",709436,190],["μάστιγες",708568,191],["τοῦ",709436,35],["ἁμαρτωλοῦ",700776,116],["τὸν",709436,5],["δὲ",703303,11],["ἐλπίζοντα",704529,183],["ἐπὶ",705080,0],["κύριον",707996,6],["ἔλεος",704426,15],["κυκλώσει",707958,127]],"Many are the scourges of the sinner: but him that hopes in the Lord mercy shall compass about."],["11",[["εὐφράνθητε",705715,372],["ἐπὶ",705080,0],["κύριον",707996,6],["καὶ",707031,7],["ἀγαλλιᾶσθε",700114,73],["δίκαιοι",703694,138],["καὶ",707031,7],["καυχᾶσθε",707569,73],["πάντες",710177,138],["οἱ",709436,136],["εὐθεῖς",705602,138],["τῇ",709436,100],["καρδίᾳ",707141,1]],"Be glad in the Lord, and exult, ye righteous: and glory, all ye that are upright in heart."]]