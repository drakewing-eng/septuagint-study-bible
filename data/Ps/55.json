[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ὑπὲρ",713111,0],["τοῦ",709436,35],["λαοῦ",708094,18],["τοῦ",709436,35],["ἀπὸ",701425,0],["τῶν",709436,80],["ἁγίων",700159,169],["μεμακρυμμένου",708428,474],["τῷ",709436,113],["Δαυιδ",703232,114],["εἰς",704105,0],["στηλογραφίαν",712093,9],["ὁπότε",709709,28],["ἐκράτησαν",707879,150],["αὐτὸν",702165,85],["οἱ",709436,136],["ἀλλόφυλοι",700706,138],["ἐν",704639,0],["Γεθ",703005,111]],"For the end, concerning the people that were removed from the sanctuary, by David for a memorial, when the Philistines caught him in Geth."],["2",[["ἐλέησόν",704418,176],["με",708618,163],["κύριε",707996,153],["ὅτι",709803,7],["κατεπάτησέν",707360,2],["με",708618,163],["ἄνθρωπος",701163,4],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["πολεμῶν",710601,72],["ἔθλιψέν",706274,2],["με",708618,163]],"Have mercy upon me, O God; for man has trodden me down; all the day long he warring has afflicted me."],["3",[["κατεπάτησάν",707360,150],["με",708618,163],["οἱ",709436,136],["ἐχθροί",705779,52],["μου",709032,133],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["ὅτι",709803,7],["πολλοὶ",710646,138],["οἱ",709436,136],["πολεμοῦντές",710601,146],["με",708618,163],["ἀπὸ",701425,0],["ὕψους",713288,21]],"Mine enemies have trodden me down all the day from the dawning of the day; for there are many warring against me."],["4",[["ἡμέρας",705984,17],["φοβηθήσομαι",713532,180],["ἐγὼ",704018,164],["δὲ",703303,11],["ἐπὶ",705080,0],["σοὶ",711925,159],["ἐλπιῶ",704529,165]],"They shall be afraid, but I will trust in thee."],["5",[["ἐν",704639,0],["τῷ",709436,113],["θεῷ",706192,114],["ἐπαινέσω",705000,165],["τοὺς",709436,58],["λόγους",708236,57],["μου",709032,133],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["ἐπὶ",705080,0],["τῷ",709436,113],["θεῷ",706192,114],["ἤλπισα",704529,155],["οὐ",709805,28],["φοβηθήσομαι",713532,180],["τί",712867,126],["ποιήσει",710582,127],["μοι",708974,159],["σάρξ",711537,12]],"In God I will praise my words; all the day have I hoped in God; I will not fear what flesh shall do to me."],["6",[["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["τοὺς",709436,58],["λόγους",708236,57],["μου",709032,133],["ἐβδελύσσοντο",702608,139],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["πάντες",710177,138],["οἱ",709436,136],["διαλογισμοὶ",703506,52],["αὐτῶν",702165,40],["εἰς",704105,0],["κακόν",707066,46]],"All the day long they have abominated my words; all their devices [are] against me for evil."],["7",[["παροικήσουσιν",710156,218],["καὶ",707031,7],["κατακρύψουσιν",707292,218],["αὐτοὶ",702165,201],["τὴν",709436,8],["πτέρναν",711050,9],["μου",709032,133],["φυλάξουσιν",713619,218],["καθάπερ",706984,28],["ὑπέμειναν",713219,150],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133]],"They will dwell near and hide [themselves]; they will watch my steps, accordingly as I have waited patiently in my soul."],["8",[["ὑπὲρ",713111,0],["τοῦ",709436,35],["μηθενὸς",708857,116],["σώσεις",712627,166],["αὐτούς",702165,62],["ἐν",704639,0],["ὀργῇ",709728,1],["λαοὺς",708094,57],["κατάξεις",707232,166],["ὁ",709436,3],["θεός",706192,4]],"Thou wilt on no account save them; thou wilt bring down the people in wrath."],["9",[["τὴν",709436,8],["ζωήν",705910,9],["μου",709032,133],["ἐξήγγειλά",704829,155],["σοι",711925,159],["ἔθου",712849,174],["τὰ",709436,41],["δάκρυά",703255,42],["μου",709032,133],["ἐνώπιόν",704823,0],["σου",711945,133],["ὡς",714148,7],["καὶ",707031,28],["ἐν",704639,0],["τῇ",709436,100],["ἐπαγγελίᾳ",704991,1],["σου",711945,133]],"O God, I have declared my life to thee; thou hast set my tears before thee, even according to thy promise."],["10",[["ἐπιστρέψουσιν",705278,218],["οἱ",709436,136],["ἐχθροί",705779,52],["μου",709032,133],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,0],["ἐν",704639,0],["ᾗ",709781,108],["ἂν",700900,11],["ἡμέρᾳ",705984,1],["ἐπικαλέσωμαί",705153,410],["σε",711598,163],["ἰδοὺ",706497,88],["ἔγνων",703105,155],["ὅτι",709803,7],["θεός",706192,4],["μου",709032,133],["εἶ",704093,154],["σύ",712181,164]],"Mine enemies shall be turned back, in the day wherein I shall call upon thee; behold, I know that thou art my God."],["11",[["ἐπὶ",705080,0],["τῷ",709436,113],["θεῷ",706192,114],["αἰνέσω",700459,165],["ῥῆμα",711246,25],["ἐπὶ",705080,0],["τῷ",709436,113],["κυρίῳ",707996,114],["αἰνέσω",700459,165],["λόγον",708236,6]],"In God will I praise [his] word; in the Lord will I praise [his] saying."],["12",[["ἐπὶ",705080,0],["τῷ",709436,113],["θεῷ",706192,114],["ἤλπισα",704529,155],["οὐ",709805,28],["φοβηθήσομαι",713532,180],["τί",712867,126],["ποιήσει",710582,127],["μοι",708974,159],["ἄνθρωπος",701163,4]],"I have hoped in God; I will not be afraid of what man shall do to me."],["13",[["ἐν",704639,0],["ἐμοί",704577,159],["ὁ",709436,3],["θεός",706192,4],["αἱ",709436,190],["εὐχαὶ",705726,191],["ἃς",709781,193],["ἀποδώσω",701449,165],["αἰνέσεώς",700457,17],["σοι",711925,159]],"The vows of thy praise, O God, which I will pay, are upon me."],["14",[["ὅτι",709803,7],["ἐρρύσω",711309,174],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἐκ",704132,0],["θανάτου",706096,18],["καὶ",707031,7],["τοὺς",709436,58],["πόδας",710707,57],["μου",709032,133],["ἐξ",704132,0],["ὀλισθήματος",709580,21],["τοῦ",709436,20],["εὐαρεστῆσαι",705554,106],["ἐνώπιον",704823,0],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐν",704639,0],["φωτὶ",713642,54],["ζώντων",705851,170]],"For thou hast delivered my soul from death, and my feet from sliding, that I should be well-pleasing before God in the land of the living."]]