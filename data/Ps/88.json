[["1",[["συνέσεως",712460,17],["Αιθαν",700416,114],["τῷ",709436,113],["Ισραηλίτῃ",706840,114]],"[A Psalm] of instruction for Ætham the Israelite."],["2",[["τὰ",709436,63],["ἐλέη",704426,64],["σου",711945,133],["κύριε",707996,153],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ᾄσομαι",700299,181],["εἰς",704105,0],["γενεὰν",703037,9],["καὶ",707031,7],["γενεὰν",703037,9],["ἀπαγγελῶ",701321,165],["τὴν",709436,8],["ἀλήθειάν",700656,9],["σου",711945,133],["ἐν",704639,0],["τῷ",709436,53],["στόματί",712125,54],["μου",709032,133]],"I will sing of thy mercies, O Lord, for ever: I will declare thy truth with my mouth to all generations."],["3",[["ὅτι",709803,7],["εἶπας",705373,162],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἔλεος",704426,15],["οἰκοδομηθήσεται",709509,134],["ἐν",704639,0],["τοῖς",709436,147],["οὐρανοῖς",709844,148],["ἑτοιμασθήσεται",705539,134],["ἡ",709436,10],["ἀλήθειά",700656,12],["σου",711945,133]],"For thou hast said, Mercy shall be built up for ever: thy truth shall be established in the heavens."],["4",[["διεθέμην",703609,161],["διαθήκην",703456,9],["τοῖς",709436,147],["ἐκλεκτοῖς",704240,230],["μου",709032,133],["ὤμοσα",709620,155],["Δαυιδ",703232,114],["τῷ",709436,113],["δούλῳ",703817,114],["μου",709032,133]],"I made a covenant with my chosen ones, I sware unto David my servant."],["5",[["ἕως",705792,7],["τοῦ",709436,35],["αἰῶνος",700504,18],["ἑτοιμάσω",705539,165],["τὸ",709436,24],["σπέρμα",712008,25],["σου",711945,133],["καὶ",707031,7],["οἰκοδομήσω",709509,165],["εἰς",704105,0],["γενεὰν",703037,9],["καὶ",707031,7],["γενεὰν",703037,9],["τὸν",709436,5],["θρόνον",706315,6],["σου",711945,133],["διάψαλμα",703641,15]],"I will establish thy seed for ever, and build up thy throne to all generations. Pause."],["6",[["ἐξομολογήσονται",704960,135],["οἱ",709436,136],["οὐρανοὶ",709844,52],["τὰ",709436,41],["θαυμάσιά",706136,68],["σου",711945,133],["κύριε",707996,153],["καὶ",707031,7],["τὴν",709436,8],["ἀλήθειάν",700656,9],["σου",711945,133],["ἐν",704639,0],["ἐκκλησίᾳ",704216,1],["ἁγίων",700159,169]],"The heavens shall declare thy wonders, O Lord; and thy truth in the assembly of the saints."],["7",[["ὅτι",709803,7],["τίς",712867,158],["ἐν",704639,0],["νεφέλαις",709277,76],["ἰσωθήσεται",706837,134],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["τίς",712867,158],["ὁμοιωθήσεται",709628,134],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐν",704639,0],["υἱοῖς",713075,148],["θεοῦ",706192,18]],"For who in the heavens shall be compared to the Lord? and who shall be likened to the Lord among the sons of God?"],["8",[["ὁ",709436,3],["θεὸς",706192,4],["ἐνδοξαζόμενος",704693,122],["ἐν",704639,0],["βουλῇ",702792,1],["ἁγίων",700159,169],["μέγας",708653,14],["καὶ",707031,7],["φοβερὸς",713530,14],["ἐπὶ",705080,0],["πάντας",710177,60],["τοὺς",709436,58],["περικύκλῳ",710340,28],["αὐτοῦ",702165,102]],"God is glorified in the council of the saints; great and terrible toward all that are round about him."],["9",[["κύριε",707996,153],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,130],["δυνάμεων",703839,65],["τίς",712867,158],["ὅμοιός",709626,14],["σοι",711925,159],["δυνατὸς",703845,14],["εἶ",704093,154],["κύριε",707996,153],["καὶ",707031,7],["ἡ",709436,10],["ἀλήθειά",700656,12],["σου",711945,133],["κύκλῳ",707959,114],["σου",711945,133]],"O Lord God of hosts, who is like to thee? thou art mighty, O Lord, and thy truth is round about thee."],["10",[["σὺ",712181,164],["δεσπόζεις",703376,154],["τοῦ",709436,20],["κράτους",707883,21],["τῆς",709436,16],["θαλάσσης",706069,17],["τὸν",709436,5],["δὲ",703303,11],["σάλον",711420,6],["τῶν",709436,43],["κυμάτων",707968,44],["αὐτῆς",702165,86],["σὺ",712181,164],["καταπραΰνεις",707388,154]],"Thou rulest the power of the sea; and thou calmest the tumult of its waves."],["11",[["σὺ",712181,164],["ἐταπείνωσας",712717,162],["ὡς",714148,7],["τραυματίαν",712921,6],["ὑπερήφανον",713139,27],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["βραχίονι",702808,114],["τῆς",709436,16],["δυνάμεώς",703839,17],["σου",711945,133],["διεσκόρπισας",703579,162],["τοὺς",709436,58],["ἐχθρούς",705779,57],["σου",711945,133]],"Thou hast brought down the proud as one that is slain; and with the arm of thy power thou hast scattered thine enemies."],["12",[["σοί",711925,159],["εἰσιν",704093,197],["οἱ",709436,136],["οὐρανοί",709844,52],["καὶ",707031,7],["σή",711943,29],["ἐστιν",704093,91],["ἡ",709436,10],["γῆ",703083,12],["τὴν",709436,8],["οἰκουμένην",709517,173],["καὶ",707031,7],["τὸ",709436,24],["πλήρωμα",710544,25],["αὐτῆς",702165,86],["σὺ",712181,164],["ἐθεμελίωσας",706182,162]],"The heavens are thine, and the earth is thine: thou hast founded the world, and the fulness of it."],["13",[["τὸν",709436,5],["βορρᾶν",702765,6],["καὶ",707031,7],["θαλάσσας",706069,39],["σὺ",712181,164],["ἔκτισας",707938,162],["Θαβωρ",706055,120],["καὶ",707031,7],["Ερμων",705436,120],["ἐν",704639,0],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["ἀγαλλιάσονται",700114,135]],"Thou hast created the north and the west: Thabor and Hermon shall rejoice in thy name."],["14",[["σὸς",711943,14],["ὁ",709436,3],["βραχίων",702808,4],["μετὰ",708780,0],["δυναστείας",703841,17],["κραταιωθήτω",707875,22],["ἡ",709436,10],["χείρ",713787,12],["σου",711945,133],["ὑψωθήτω",713289,22],["ἡ",709436,10],["δεξιά",703360,68],["σου",711945,133]],"Thine is the mighty arm: let thy hand be strengthened, let thy right hand be exalted."],["15",[["δικαιοσύνη",703695,12],["καὶ",707031,7],["κρίμα",707903,15],["ἑτοιμασία",705540,12],["τοῦ",709436,35],["θρόνου",706315,18],["σου",711945,133],["ἔλεος",704426,15],["καὶ",707031,7],["ἀλήθεια",700656,12],["προπορεύσεται",710839,93],["πρὸ",710747,0],["προσώπου",710986,21],["σου",711945,133]],"Justice and judgment are the establishment of thy throne: mercy and truth shall go before thy face."],["16",[["μακάριος",708397,14],["ὁ",709436,3],["λαὸς",708094,4],["ὁ",709436,3],["γινώσκων",703105,72],["ἀλαλαγμόν",700631,6],["κύριε",707996,153],["ἐν",704639,0],["τῷ",709436,53],["φωτὶ",713642,54],["τοῦ",709436,20],["προσώπου",710986,21],["σου",711945,133],["πορεύσονται",710667,135]],"Blessed is the people that knows the joyful sound: they shall walk, O Lord, in the light of thy countenance."],["17",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["ἀγαλλιάσονται",700114,135],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["δικαιοσύνῃ",703695,1],["σου",711945,133],["ὑψωθήσονται",713289,144]],"And in thy name shall they rejoice all the day: and in thy righteousness shall they be exalted."],["18",[["ὅτι",709803,7],["τὸ",709436,34],["καύχημα",707570,15],["τῆς",709436,16],["δυνάμεως",703839,17],["αὐτῶν",702165,40],["εἶ",704093,154],["σύ",712181,164],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["εὐδοκίᾳ",705566,1],["σου",711945,133],["ὑψωθήσεται",713289,134],["τὸ",709436,34],["κέρας",707625,15],["ἡμῶν",705999,145]],"For thou art the boast of their strength; and in thy good pleasure shall our horn be exalted,"],["19",[["ὅτι",709803,7],["τοῦ",709436,35],["κυρίου",707996,18],["ἡ",709436,10],["ἀντίλημψις",701247,12],["καὶ",707031,7],["τοῦ",709436,35],["ἁγίου",700159,116],["Ισραηλ",706839,18],["βασιλέως",702580,18],["ἡμῶν",705999,145]],"for [our] help is of the Lord; and of the Holy One of Israel, our king."],["20",[["τότε",712908,28],["ἐλάλησας",708071,162],["ἐν",704639,0],["ὁράσει",709721,1],["τοῖς",709436,147],["ὁσίοις",709782,230],["σου",711945,133],["καὶ",707031,7],["εἶπας",705373,162],["ἐθέμην",712849,161],["βοήθειαν",702745,9],["ἐπὶ",705080,0],["δυνατόν",703845,27],["ὕψωσα",713289,188],["ἐκλεκτὸν",704240,27],["ἐκ",704132,0],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133]],"Then thou spokest in vision to thy children, and saidst, I have laid help on a mighty one; I have exalted one chosen out of my people."],["21",[["εὗρον",705676,155],["Δαυιδ",703232,6],["τὸν",709436,5],["δοῦλόν",703817,6],["μου",709032,133],["ἐν",704639,0],["ἐλαίῳ",704380,54],["ἁγίῳ",700159,97],["μου",709032,133],["ἔχρισα",713965,155],["αὐτόν",702165,85]],"I have found David my servant; I have anointed him by [my] holy mercy."],["22",[["ἡ",709436,10],["γὰρ",702963,11],["χείρ",713787,12],["μου",709032,133],["συναντιλήμψεται",712398,93],["αὐτῷ",702165,50],["καὶ",707031,7],["ὁ",709436,3],["βραχίων",702808,4],["μου",709032,133],["κατισχύσει",707531,127],["αὐτόν",702165,85]],"For my hand shall support him; and mine arm shall strengthen him."],["23",[["οὐκ",709805,28],["ὠφελήσει",714171,127],["ἐχθρὸς",705779,4],["ἐν",704639,0],["αὐτῷ",702165,50],["καὶ",707031,7],["υἱὸς",713075,4],["ἀνομίας",701192,17],["οὐ",709805,28],["προσθήσει",710965,127],["τοῦ",709436,20],["κακῶσαι",707073,106],["αὐτόν",702165,85]],"The enemy shall have no advantage against him; and the son of transgression shall not hurt him again."],["24",[["καὶ",707031,7],["συγκόψω",712230,165],["τοὺς",709436,58],["ἐχθροὺς",705779,57],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["καὶ",707031,7],["τοὺς",709436,58],["μισοῦντας",708935,235],["αὐτὸν",702165,85],["τροπώσομαι",712981,181]],"And I will hew down his foes before him, and put to flight those that hate him."],["25",[["καὶ",707031,7],["ἡ",709436,10],["ἀλήθειά",700656,12],["μου",709032,133],["καὶ",707031,7],["τὸ",709436,34],["ἔλεός",704426,15],["μου",709032,133],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ὀνόματί",709666,54],["μου",709032,133],["ὑψωθήσεται",713289,134],["τὸ",709436,24],["κέρας",707625,25],["αὐτοῦ",702165,102]],"But my truth and my mercy shall be with him; and in my name shall his horn be exalted."],["26",[["καὶ",707031,7],["θήσομαι",712849,181],["ἐν",704639,0],["θαλάσσῃ",706069,1],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["ποταμοῖς",710693,148],["δεξιὰν",703360,36],["αὐτοῦ",702165,102]],"And I will set his hand in the sea, and his right hand in the rivers."],["27",[["αὐτὸς",702165,121],["ἐπικαλέσεταί",705153,93],["με",708618,163],["πατήρ",710189,4],["μου",709032,133],["εἶ",704093,154],["σύ",712181,164],["θεός",706192,4],["μου",709032,133],["καὶ",707031,7],["ἀντιλήμπτωρ",701246,4],["τῆς",709436,16],["σωτηρίας",712658,17],["μου",709032,133]],"He shall call upon me, [saying], Thou art my Father, my God, and the helper of my salvation."],["28",[["κἀγὼ",706969,288],["πρωτότοκον",711046,27],["θήσομαι",712849,181],["αὐτόν",702165,85],["ὑψηλὸν",713285,27],["παρὰ",709995,0],["τοῖς",709436,147],["βασιλεῦσιν",702580,148],["τῆς",709436,16],["γῆς",703083,17]],"And I will make him [my] first-born, higher than the kings of the earth."],["29",[["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["φυλάξω",713619,165],["αὐτῷ",702165,50],["τὸ",709436,24],["ἔλεός",704426,25],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["διαθήκη",703456,12],["μου",709032,133],["πιστὴ",710486,29],["αὐτῷ",702165,50]],"I will keep my mercy for him for ever, and my covenant [shall be] firm with him."],["30",[["καὶ",707031,7],["θήσομαι",712849,181],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18],["τὸ",709436,24],["σπέρμα",712008,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὸν",709436,5],["θρόνον",706315,6],["αὐτοῦ",702165,102],["ὡς",714148,7],["τὰς",709436,38],["ἡμέρας",705984,39],["τοῦ",709436,35],["οὐρανοῦ",709844,18]],"And I will establish his seed for ever and ever, and his throne as the days of heaven."],["31",[["ἐὰν",703912,7],["ἐγκαταλίπωσιν",703967,234],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτοῦ",702165,102],["τὸν",709436,5],["νόμον",709349,6],["μου",709032,133],["καὶ",707031,7],["τοῖς",709436,95],["κρίμασίν",707903,96],["μου",709032,133],["μὴ",708851,28],["πορευθῶσιν",710667,272]],"If his children should forsake my law, and walk not in my judgments;"],["32",[["ἐὰν",703912,7],["τὰ",709436,41],["δικαιώματά",703697,42],["μου",709032,133],["βεβηλώσουσιν",702614,218],["καὶ",707031,7],["τὰς",709436,38],["ἐντολάς",704802,39],["μου",709032,133],["μὴ",708851,28],["φυλάξωσιν",713619,234]],"if they should profane my ordinances, and not keep my commandments;"],["33",[["ἐπισκέψομαι",705250,181],["ἐν",704639,0],["ῥάβδῳ",711135,1],["τὰς",709436,38],["ἀνομίας",701192,39],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐν",704639,0],["μάστιξιν",708568,76],["τὰς",709436,38],["ἁμαρτίας",700775,39],["αὐτῶν",702165,40]],"I will visit their transgressions with a rod, and their sins with scourges."],["34",[["τὸ",709436,24],["δὲ",703303,11],["ἔλεός",704426,15],["μου",709032,133],["οὐ",709805,28],["μὴ",708851,28],["διασκεδάσω",703575,207],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["οὐδὲ",709816,7],["μὴ",708851,28],["ἀδικήσω",700269,207],["ἐν",704639,0],["τῇ",709436,100],["ἀληθείᾳ",700656,1],["μου",709032,133]],"But my mercy I will not utterly remove from him, nor wrong my truth."],["35",[["οὐδὲ",709816,7],["μὴ",708851,28],["βεβηλώσω",702614,207],["τὴν",709436,8],["διαθήκην",703456,9],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,41],["ἐκπορευόμενα",704293,67],["διὰ",703417,0],["τῶν",709436,43],["χειλέων",713781,44],["μου",709032,133],["οὐ",709805,28],["μὴ",708851,28],["ἀθετήσω",700369,207]],"Neither will I by any means profane my covenant; and I will not make void the things that proceed out of my lips."],["36",[["ἅπαξ",701350,28],["ὤμοσα",709620,155],["ἐν",704639,0],["τῷ",709436,113],["ἁγίῳ",700159,30],["μου",709032,133],["εἰ",704071,7],["τῷ",709436,113],["Δαυιδ",703232,114],["ψεύσομαι",714040,181]],"Once have I sworn by my holiness, that I will not lie to David."],["37",[["τὸ",709436,24],["σπέρμα",712008,25],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["μενεῖ",708736,127],["καὶ",707031,7],["ὁ",709436,3],["θρόνος",706315,4],["αὐτοῦ",702165,102],["ὡς",714148,7],["ὁ",709436,3],["ἥλιος",705974,4],["ἐναντίον",704654,0],["μου",709032,133]],"His seed shall endure for ever, and his throne as the sun before me;"],["38",[["καὶ",707031,7],["ὡς",714148,7],["ἡ",709436,10],["σελήνη",711650,12],["κατηρτισμένη",707410,203],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["ὁ",709436,3],["μάρτυς",708527,4],["ἐν",704639,0],["οὐρανῷ",709844,114],["πιστός",710486,14],["διάψαλμα",703641,15]],"and as the moon [that is] established for ever, and as the faithful witness in heaven. Pause."],["39",[["σὺ",712181,164],["δὲ",703303,11],["ἀπώσω",701659,207],["καὶ",707031,7],["ἐξουδένωσας",704969,162],["ἀνεβάλου",700906,174],["τὸν",709436,5],["χριστόν",713964,27],["σου",711945,133]],"But thou hast cast off and set at nought, thou hast rejected thine anointed."],["40",[["κατέστρεψας",707444,162],["τὴν",709436,8],["διαθήκην",703456,9],["τοῦ",709436,35],["δούλου",703817,18],["σου",711945,133],["ἐβεβήλωσας",702614,162],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["τὸ",709436,24],["ἁγίασμα",700154,25],["αὐτοῦ",702165,102]],"Thou hast overthrown the covenant of thy servant; thou hast profaned his sanctuary, [casting it] to the ground."],["41",[["καθεῖλες",706982,162],["πάντας",710177,60],["τοὺς",709436,58],["φραγμοὺς",713572,57],["αὐτοῦ",702165,102],["ἔθου",712849,174],["τὰ",709436,41],["ὀχυρώματα",709891,42],["αὐτοῦ",702165,102],["δειλίαν",703319,9]],"Thou hast broken down all his hedges; thou hast made his strong holds a terror."],["42",[["διήρπασαν",703562,150],["αὐτὸν",702165,85],["πάντες",710177,138],["οἱ",709436,136],["διοδεύοντες",703715,146],["ὁδόν",709458,9],["ἐγενήθη",703104,37],["ὄνειδος",709658,15],["τοῖς",709436,147],["γείτοσιν",703016,148],["αὐτοῦ",702165,102]],"All that go by the way have spoiled him: he is become a reproach to his neighbours."],["43",[["ὕψωσας",713289,162],["τὴν",709436,8],["δεξιὰν",703360,36],["τῶν",709436,80],["ἐχθρῶν",705779,81],["αὐτοῦ",702165,102],["εὔφρανας",705715,162],["πάντας",710177,60],["τοὺς",709436,58],["ἐχθροὺς",705779,57],["αὐτοῦ",702165,102]],"Thou hast exalted the right hand of his enemies; thou hast made all his enemies to rejoice."],["44",[["ἀπέστρεψας",701598,162],["τὴν",709436,8],["βοήθειαν",702745,9],["τῆς",709436,16],["ῥομφαίας",711291,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ἀντελάβου",701243,174],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,113],["πολέμῳ",710605,114]],"Thou hast turned back the help of his sword, and hast not helped him in the battle."],["45",[["κατέλυσας",707323,162],["ἀπὸ",701425,0],["καθαρισμοῦ",706987,18],["αὐτόν",702165,85],["τὸν",709436,5],["θρόνον",706315,6],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["κατέρραξας",707407,162]],"Thou hast deprived him of glory: thou hast broken down his throne to the ground."],["46",[["ἐσμίκρυνας",711911,162],["τὰς",709436,38],["ἡμέρας",705984,39],["τοῦ",709436,35],["χρόνου",713969,18],["αὐτοῦ",702165,102],["κατέχεας",707491,162],["αὐτοῦ",702165,102],["αἰσχύνην",700483,9],["διάψαλμα",703641,15]],"Thou hast shortened the days of his throne: thou hast poured shame upon him. Pause."],["47",[["ἕως",705792,0],["πότε",710696,11],["κύριε",707996,153],["ἀποστρέψεις",701598,166],["εἰς",704105,0],["τέλος",712787,25],["ἐκκαυθήσεται",704205,134],["ὡς",714148,7],["πῦρ",711088,25],["ἡ",709436,10],["ὀργή",709728,12],["σου",711945,133]],"How long, O Lord, wilt thou turn away, for ever? shall thine anger flame out as fire?"],["48",[["μνήσθητι",708960,244],["τίς",712867,158],["μου",709032,133],["ἡ",709436,10],["ὑπόστασις",713241,12],["μὴ",708851,28],["γὰρ",702963,11],["ματαίως",708579,28],["ἔκτισας",707938,162],["πάντας",710177,60],["τοὺς",709436,58],["υἱοὺς",713075,57],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"Remember what my being is: for hast thou created all the sons of men in vain?"],["49",[["τίς",712867,158],["ἐστιν",704093,91],["ἄνθρωπος",701163,4],["ὃς",709781,213],["ζήσεται",705851,93],["καὶ",707031,7],["οὐκ",709805,28],["ὄψεται",709725,93],["θάνατον",706096,6],["ῥύσεται",711309,93],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["ἐκ",704132,0],["χειρὸς",713787,17],["ᾅδου",700255,18],["διάψαλμα",703641,15]],"What man is there who shall live, and not see death? shall [any one] deliver his soul from the hand of Hades? Pause."],["50",[["ποῦ",710706,28],["εἰσιν",704093,197],["τὰ",709436,63],["ἐλέη",704426,64],["σου",711945,133],["τὰ",709436,63],["ἀρχαῖα",701835,195],["κύριε",707996,153],["ἃ",709781,69],["ὤμοσας",709620,162],["τῷ",709436,113],["Δαυιδ",703232,114],["ἐν",704639,0],["τῇ",709436,100],["ἀληθείᾳ",700656,1],["σου",711945,133]],"Where are thine ancient mercies, O Lord, which thou swarest to David in thy truth?"],["51",[["μνήσθητι",708960,244],["κύριε",707996,153],["τοῦ",709436,35],["ὀνειδισμοῦ",709657,18],["τῶν",709436,80],["δούλων",703817,81],["σου",711945,133],["οὗ",709781,48],["ὑπέσχον",713175,150],["ἐν",704639,0],["τῷ",709436,113],["κόλπῳ",707800,114],["μου",709032,133],["πολλῶν",710646,83],["ἐθνῶν",704068,44]],"Remember, O Lord, the reproach of thy servants, which I have borne in my bosom, [even the reproach] of many nations;"],["52",[["οὗ",709781,48],["ὠνείδισαν",709655,150],["οἱ",709436,136],["ἐχθροί",705779,52],["σου",711945,133],["κύριε",707996,153],["οὗ",709781,48],["ὠνείδισαν",709655,150],["τὸ",709436,24],["ἀντάλλαγμα",701209,25],["τοῦ",709436,35],["χριστοῦ",713964,116],["σου",711945,133]],"wherewith thine enemies have reviled, O Lord: wherewith they have reviled the recompence of thine anointed."],["53",[["εὐλογητὸς",705632,14],["κύριος",707996,4],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["γένοιτο",703104,382],["γένοιτο",703104,382]],"Blessed be the Lord for ever. So be it, so be it."]]