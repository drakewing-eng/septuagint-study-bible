[["1",[["τοῦ",709436,35],["Δαυιδ",703232,18],["πρὸ",710747,0],["τοῦ",709436,20],["χρισθῆναι",713965,179],["κύριος",707996,4],["φωτισμός",713647,4],["μου",709032,133],["καὶ",707031,7],["σωτήρ",712657,4],["μου",709032,133],["τίνα",712867,356],["φοβηθήσομαι",713532,180],["κύριος",707996,4],["ὑπερασπιστὴς",713123,4],["τῆς",709436,16],["ζωῆς",705910,17],["μου",709032,133],["ἀπὸ",701425,0],["τίνος",712867,340],["δειλιάσω",703321,165]],"[A Psalm] of David, before he was anointed. The Lord is my light and my Saviour; whom shall I fear? the Lord is the defender of my life; of whom shall I be afraid?"],["2",[["ἐν",704639,0],["τῷ",709436,53],["ἐγγίζειν",703939,55],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["κακοῦντας",707073,235],["τοῦ",709436,20],["φαγεῖν",713296,106],["τὰς",709436,38],["σάρκας",711537,39],["μου",709032,133],["οἱ",709436,136],["θλίβοντές",706274,146],["με",708618,163],["καὶ",707031,7],["οἱ",709436,136],["ἐχθροί",705779,52],["μου",709032,133],["αὐτοὶ",702165,201],["ἠσθένησαν",701938,150],["καὶ",707031,7],["ἔπεσαν",710481,150]],"When evil-doers drew nigh against me to eat up my flesh, my persecutors and mine enemies, they fainted and fell."],["3",[["ἐὰν",703912,7],["παρατάξηται",710108,239],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["παρεμβολή",710133,12],["οὐ",709805,28],["φοβηθήσεται",713532,134],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["ἐὰν",703912,7],["ἐπαναστῇ",705026,172],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["πόλεμος",710605,4],["ἐν",704639,0],["ταύτῃ",709858,105],["ἐγὼ",704018,164],["ἐλπίζω",704529,157]],"Though an army should set itself in array against me, my heart shall not be afraid: though war should rise up against me, in this am I confident."],["4",[["μίαν",704106,36],["ᾐτησάμην",700489,161],["παρὰ",709995,0],["κυρίου",707996,18],["ταύτην",709858,104],["ἐκζητήσω",704187,165],["τοῦ",709436,20],["κατοικεῖν",707534,55],["με",708618,163],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["τῆς",709436,16],["ζωῆς",705910,17],["μου",709032,133],["τοῦ",709436,20],["θεωρεῖν",706226,55],["με",708618,163],["τὴν",709436,8],["τερπνότητα",712803,9],["τοῦ",709436,35],["κυρίου",707996,18],["καὶ",707031,7],["ἐπισκέπτεσθαι",705250,110],["τὸν",709436,5],["ναὸν",709191,6],["αὐτοῦ",702165,102]],"One thing have I asked of the Lord, this will I earnestly seek: that I should dwell in the house of the Lord all the days of my life, that I should behold the fair beauty of the Lord, and survey his temple."],["5",[["ὅτι",709803,7],["ἔκρυψέν",707923,2],["με",708618,163],["ἐν",704639,0],["σκηνῇ",711845,1],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["κακῶν",707066,83],["μου",709032,133],["ἐσκέπασέν",711832,2],["με",708618,163],["ἐν",704639,0],["ἀποκρύφῳ",701497,97],["τῆς",709436,16],["σκηνῆς",711845,17],["αὐτοῦ",702165,102],["ἐν",704639,0],["πέτρᾳ",710443,1],["ὕψωσέν",713289,2],["με",708618,163]],"For in the day of mine afflictions he hid me in his tabernacle: he sheltered me in the secret of his tabernacle; he set me up on a rock."],["6",[["καὶ",707031,7],["νῦν",709384,28],["ἰδοὺ",706497,88],["ὕψωσεν",713289,2],["τὴν",709436,8],["κεφαλήν",707639,9],["μου",709032,133],["ἐπ᾿",705080,0],["ἐχθρούς",705779,57],["μου",709032,133],["ἐκύκλωσα",707958,155],["καὶ",707031,7],["ἔθυσα",706349,155],["ἐν",704639,0],["τῇ",709436,100],["σκηνῇ",711845,1],["αὐτοῦ",702165,102],["θυσίαν",706345,9],["ἀλαλαγμοῦ",700631,18],["ᾄσομαι",700299,181],["καὶ",707031,7],["ψαλῶ",714021,165],["τῷ",709436,113],["κυρίῳ",707996,114]],"And now, behold, he has lifted up mine head over mine enemies: I went round and offered in his tabernacle the sacrifice of joy; I will sing, even sing psalms to the Lord."],["7",[["εἰσάκουσον",704108,176],["κύριε",707996,153],["τῆς",709436,16],["φωνῆς",713640,17],["μου",709032,133],["ἧς",709781,167],["ἐκέκραξα",704226,155],["ἐλέησόν",704418,176],["με",708618,163],["καὶ",707031,7],["εἰσάκουσόν",704108,176],["μου",709032,133]],"Hear, O Lord, my voice which I have uttered aloud: pity me, and hearken to me."],["8",[["σοὶ",711925,159],["εἶπεν",705373,2],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["ἐζήτησεν",705879,2],["τὸ",709436,24],["πρόσωπόν",710986,25],["μου",709032,133],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["κύριε",707996,153],["ζητήσω",705879,165]],"My heart said to thee, I have diligently sought thy face: thy face, O Lord, I will seek."],["9",[["μὴ",708851,28],["ἀποστρέψῃς",701598,175],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["μὴ",708851,28],["ἐκκλίνῃς",704220,205],["ἐν",704639,0],["ὀργῇ",709728,1],["ἀπὸ",701425,0],["τοῦ",709436,35],["δούλου",703817,18],["σου",711945,133],["βοηθός",702748,4],["μου",709032,133],["γενοῦ",703104,300],["μὴ",708851,28],["ἀποσκορακίσῃς",701578,175],["με",708618,163],["καὶ",707031,7],["μὴ",708851,28],["ἐγκαταλίπῃς",703967,175],["με",708618,163],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["σωτήρ",712657,4],["μου",709032,133]],"Turn not thy face away from me, turn not thou away from thy servant in anger: be thou my helper, forsake me not; and, O God my Saviour, overlook me not."],["10",[["ὅτι",709803,7],["ὁ",709436,3],["πατήρ",710189,4],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["μήτηρ",708892,12],["μου",709032,133],["ἐγκατέλιπόν",703967,150],["με",708618,163],["ὁ",709436,3],["δὲ",703303,11],["κύριος",707996,4],["προσελάβετό",710930,23],["με",708618,163]],"For my father and my mother have forsaken me, but the Lord has taken me to himself."],["11",[["νομοθέτησόν",709346,176],["με",708618,163],["κύριε",707996,153],["τῇ",709436,100],["ὁδῷ",709458,1],["σου",711945,133],["καὶ",707031,7],["ὁδήγησόν",709448,176],["με",708618,163],["ἐν",704639,0],["τρίβῳ",712939,1],["εὐθείᾳ",705602,101],["ἕνεκα",704709,0],["τῶν",709436,80],["ἐχθρῶν",705779,81],["μου",709032,133]],"Teach me, O Lord, in thy way, and guide me in a right path, because of mine enemies."],["12",[["μὴ",708851,28],["παραδῷς",710014,175],["με",708618,163],["εἰς",704105,0],["ψυχὰς",714070,39],["θλιβόντων",706274,170],["με",708618,163],["ὅτι",709803,7],["ἐπανέστησάν",705026,150],["μοι",708974,159],["μάρτυρες",708527,52],["ἄδικοι",700272,138],["καὶ",707031,7],["ἐψεύσατο",714040,23],["ἡ",709436,10],["ἀδικία",700271,12],["ἑαυτῇ",703917,105]],"Deliver me not over to the desire of them that afflict me; for unjust witnesses have risen up against me, and injustice has lied within herself."],["13",[["πιστεύω",710483,157],["τοῦ",709436,20],["ἰδεῖν",709725,106],["τὰ",709436,41],["ἀγαθὰ",700106,68],["κυρίου",707996,18],["ἐν",704639,0],["γῇ",703083,1],["ζώντων",705851,170]],"I believe that I shall see the goodness of the Lord in the land of the living."],["14",[["ὑπόμεινον",713219,176],["τὸν",709436,5],["κύριον",707996,6],["ἀνδρίζου",701104,253],["καὶ",707031,7],["κραταιούσθω",707875,407],["ἡ",709436,10],["καρδία",707141,12],["σου",711945,133],["καὶ",707031,7],["ὑπόμεινον",713219,176],["τὸν",709436,5],["κύριον",707996,6]],"Wait on the Lord: be of good courage, and let thy heart be strengthened: yea, wait on the Lord."]]