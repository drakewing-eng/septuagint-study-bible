[["1",[["τῷ",709436,113],["Δαυιδ",703232,114],["εὐλόγει",705631,240],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["τὸν",709436,5],["κύριον",707996,6],["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["ἐμεγαλύνθης",708647,168],["σφόδρα",712586,28],["ἐξομολόγησιν",704961,9],["καὶ",707031,7],["εὐπρέπειαν",705666,9],["ἐνεδύσω",704701,174]],"[A Psalm] of David. Bless the Lord, O my soul. O Lord my God, thou art very great; thou hast clothed thyself with praise and honour:"],["2",[["ἀναβαλλόμενος",700906,122],["φῶς",713642,25],["ὡς",714148,11],["ἱμάτιον",706742,25],["ἐκτείνων",704322,72],["τὸν",709436,5],["οὐρανὸν",709844,6],["ὡσεὶ",714159,11],["δέρριν",703365,9]],"who dost robe thyself with light as with a garment; spreading out the heaven as a curtain."],["3",[["ὁ",709436,3],["στεγάζων",712056,72],["ἐν",704639,0],["ὕδασιν",713071,96],["τὰ",709436,41],["ὑπερῷα",713172,42],["αὐτοῦ",702165,102],["ὁ",709436,3],["τιθεὶς",712849,72],["νέφη",709281,42],["τὴν",709436,8],["ἐπίβασιν",705084,9],["αὐτοῦ",702165,102],["ὁ",709436,3],["περιπατῶν",710362,72],["ἐπὶ",705080,0],["πτερύγων",711057,65],["ἀνέμων",701123,81]],"Who covers his chambers with waters; who makes the clouds his chariot; who walks on the wings of the wind."],["4",[["ὁ",709436,3],["ποιῶν",710582,72],["τοὺς",709436,58],["ἀγγέλους",700140,57],["αὐτοῦ",702165,102],["πνεύματα",710566,64],["καὶ",707031,7],["τοὺς",709436,58],["λειτουργοὺς",708137,57],["αὐτοῦ",702165,102],["πῦρ",711088,15],["φλέγον",713518,32]],"Who makes his angels spirits, and his ministers a flaming fire."],["5",[["ἐθεμελίωσεν",706182,2],["τὴν",709436,8],["γῆν",703083,9],["ἐπὶ",705080,0],["τὴν",709436,8],["ἀσφάλειαν",702039,9],["αὐτῆς",702165,86],["οὐ",709805,28],["κλιθήσεται",707738,134],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18]],"Who establishes the earth on her sure foundation: it shall not be moved for ever."],["6",[["ἄβυσσος",700098,12],["ὡς",714148,11],["ἱμάτιον",706742,15],["τὸ",709436,34],["περιβόλαιον",710300,15],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τῶν",709436,43],["ὀρέων",709768,44],["στήσονται",706846,135],["ὕδατα",713071,15]],"The deep, as it were a garment, is his covering: the waters shall stand on the hills."],["7",[["ἀπὸ",701425,0],["ἐπιτιμήσεώς",705306,17],["σου",711945,133],["φεύξονται",713433,135],["ἀπὸ",701425,0],["φωνῆς",713640,17],["βροντῆς",702816,17],["σου",711945,133],["δειλιάσουσιν",703321,218]],"At thy rebuke they shall flee; at the voice of thy thunder they shall be alarmed."],["8",[["ἀναβαίνουσιν",700905,197],["ὄρη",709768,42],["καὶ",707031,7],["καταβαίνουσιν",707202,197],["πεδία",710215,42],["εἰς",704105,0],["τόπον",712903,6],["ὃν",709781,112],["ἐθεμελίωσας",706182,162],["αὐτοῖς",702165,151]],"They go up to the mountains, and down to the plains, to the place which thou hast founded for them."],["9",[["ὅριον",709749,25],["ἔθου",712849,174],["ὃ",709781,128],["οὐ",709805,28],["παρελεύσονται",710141,135],["οὐδὲ",709816,7],["ἐπιστρέψουσιν",705278,218],["καλύψαι",707102,106],["τὴν",709436,8],["γῆν",703083,9]],"Thou hast set a bound which they shall not pass, neither shall they turn again to cover the earth."],["10",[["ὁ",709436,3],["ἐξαποστέλλων",704872,72],["πηγὰς",710450,39],["ἐν",704639,0],["φάραγξιν",713351,76],["ἀνὰ",700902,0],["μέσον",708768,27],["τῶν",709436,43],["ὀρέων",709768,44],["διελεύσονται",703673,135],["ὕδατα",713071,25]],"He sends forth his fountains among the valleys: the waters shall run between the mountains."],["11",[["ποτιοῦσιν",710700,218],["πάντα",710177,195],["τὰ",709436,63],["θηρία",706252,64],["τοῦ",709436,35],["ἀγροῦ",700196,18],["προσδέξονται",710874,135],["ὄναγροι",709653,52],["εἰς",704105,0],["δίψαν",703762,9],["αὐτῶν",702165,40]],"They shall give drink to all the wild beasts of the field: the wild asses shall take [of them] to [quench] their thirst."],["12",[["ἐπ᾿",705080,0],["αὐτὰ",702165,71],["τὰ",709436,41],["πετεινὰ",710439,42],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["κατασκηνώσει",707423,127],["ἐκ",704132,0],["μέσου",708768,116],["τῶν",709436,80],["πετρῶν",710446,81],["δώσουσιν",703654,218],["φωνήν",713640,9]],"By them shall the birds of the sky lodge: they shall utter a voice out of the midst of the rocks."],["13",[["ποτίζων",710700,72],["ὄρη",709768,42],["ἐκ",704132,0],["τῶν",709436,43],["ὑπερῴων",713172,44],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["καρποῦ",707169,18],["τῶν",709436,43],["ἔργων",705396,44],["σου",711945,133],["χορτασθήσεται",713919,134],["ἡ",709436,10],["γῆ",703083,12]],"He waters the mountains from his chambers: the earth shall be satisfied with the fruit of thy works."],["14",[["ἐξανατέλλων",704863,72],["χόρτον",713923,6],["τοῖς",709436,95],["κτήνεσιν",707934,96],["καὶ",707031,7],["χλόην",713877,9],["τῇ",709436,100],["δουλείᾳ",703813,1],["τῶν",709436,80],["ἀνθρώπων",701163,81],["τοῦ",709436,20],["ἐξαγαγεῖν",704834,106],["ἄρτον",701829,6],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17]],"He makes grass to grow for the cattle, and green herb for the service of men, to bring bread out of the earth;"],["15",[["καὶ",707031,7],["οἶνος",709530,4],["εὐφραίνει",705715,91],["καρδίαν",707141,9],["ἀνθρώπου",701163,18],["τοῦ",709436,20],["ἱλαρῦναι",706726,106],["πρόσωπον",710986,25],["ἐν",704639,0],["ἐλαίῳ",704380,54],["καὶ",707031,7],["ἄρτος",701829,4],["καρδίαν",707141,9],["ἀνθρώπου",701163,18],["στηρίζει",712098,91]],"and wine makes glad the heart of man, to make his face cheerful with oil: and bread strengthens man's heart."],["16",[["χορτασθήσεται",713919,134],["τὰ",709436,63],["ξύλα",709427,64],["τοῦ",709436,20],["πεδίου",710215,21],["αἱ",709436,190],["κέδροι",707590,191],["τοῦ",709436,35],["Λιβάνου",708185,18],["ἃς",709781,193],["ἐφύτευσεν",713636,2]],"The trees of the plain shall be full [of sap; even] the cedars of Libanus which he has planted."],["17",[["ἐκεῖ",704181,28],["στρουθία",712166,15],["ἐννοσσεύσουσιν",704759,218],["τοῦ",709436,35],["ἐρωδιοῦ",705455,18],["ἡ",709436,10],["οἰκία",709505,12],["ἡγεῖται",705931,117],["αὐτῶν",702165,40]],"There the sparrows will build their nests; and the house of the heron takes the lead among them."],["18",[["ὄρη",709768,64],["τὰ",709436,63],["ὑψηλὰ",713285,195],["ταῖς",709436,75],["ἐλάφοις",704398,291],["πέτρα",710443,12],["καταφυγὴ",707485,12],["τοῖς",709436,147],["χοιρογρυλλίοις",713895,148]],"The high mountains are a refuge for the stags, [and] the rock for the rabbits."],["19",[["ἐποίησεν",710582,2],["σελήνην",711650,9],["εἰς",704105,0],["καιρούς",707047,57],["ὁ",709436,3],["ἥλιος",705974,4],["ἔγνω",703105,2],["τὴν",709436,8],["δύσιν",703856,9],["αὐτοῦ",702165,102]],"He appointed the moon for seasons: the sun knows his going down."],["20",[["ἔθου",712849,174],["σκότος",711889,15],["καὶ",707031,7],["ἐγένετο",703104,23],["νύξ",709386,12],["ἐν",704639,0],["αὐτῇ",702165,105],["διελεύσονται",703673,135],["πάντα",710177,27],["τὰ",709436,63],["θηρία",706252,64],["τοῦ",709436,35],["δρυμοῦ",703836,18]],"Thou didst make darkness, and it was night; in it all the wild beasts of the forest will be abroad:"],["21",[["σκύμνοι",711903,52],["ὠρυόμενοι",714142,348],["ἁρπάσαι",701804,106],["καὶ",707031,7],["ζητῆσαι",705879,106],["παρὰ",709995,0],["τοῦ",709436,35],["θεοῦ",706192,18],["βρῶσιν",702825,9],["αὐτοῖς",702165,151]],"[even] young lions roaring for prey, and to seek meat for themselves from God."],["22",[["ἀνέτειλεν",701066,2],["ὁ",709436,3],["ἥλιος",705974,4],["καὶ",707031,7],["συνήχθησαν",712375,99],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["μάνδραις",708473,76],["αὐτῶν",702165,40],["κοιτασθήσονται",707779,144]],"The sun arises, and they shall be gathered together, and shall lie down in their dens."],["23",[["ἐξελεύσεται",704909,93],["ἄνθρωπος",701163,4],["ἐπὶ",705080,0],["τὸ",709436,24],["ἔργον",705396,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπὶ",705080,0],["τὴν",709436,8],["ἐργασίαν",705385,9],["αὐτοῦ",702165,102],["ἕως",705792,0],["ἑσπέρας",705500,17]],"Man shall go forth to his work, and to his labour till evening."],["24",[["ὡς",714148,11],["ἐμεγαλύνθη",708647,37],["τὰ",709436,63],["ἔργα",705396,64],["σου",711945,133],["κύριε",707996,153],["πάντα",710177,68],["ἐν",704639,0],["σοφίᾳ",711981,1],["ἐποίησας",710582,162],["ἐπληρώθη",710543,37],["ἡ",709436,10],["γῆ",703083,12],["τῆς",709436,16],["κτήσεώς",707937,17],["σου",711945,133]],"How great are thy works, O Lord! in wisdom hast thou wrought them all: the earth is filled with thy creation."],["25",[["αὕτη",709858,107],["ἡ",709436,10],["θάλασσα",706069,12],["ἡ",709436,10],["μεγάλη",708653,29],["καὶ",707031,7],["εὐρύχωρος",705681,14],["ἐκεῖ",704181,28],["ἑρπετά",705441,64],["ὧν",709781,252],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀριθμός",701744,4],["ζῷα",705916,64],["μικρὰ",708915,195],["μετὰ",708780,0],["μεγάλων",708653,169]],"[So is] this great and wide sea: there are things creeping innumerable, small animals and great."],["26",[["ἐκεῖ",704181,28],["πλοῖα",710556,42],["διαπορεύονται",703551,269],["δράκων",703822,4],["οὗτος",709858,121],["ὃν",709781,112],["ἔπλασας",710503,162],["ἐμπαίζειν",704583,55],["αὐτῷ",702165,50]],"There go the ships; [and] this dragon whom thou hast made to play in it."],["27",[["πάντα",710177,195],["πρὸς",710844,0],["σὲ",711598,163],["προσδοκῶσιν",710876,271],["δοῦναι",703654,106],["τὴν",709436,8],["τροφὴν",712984,9],["αὐτοῖς",702165,151],["εὔκαιρον",705612,27]],"All wait upon thee, to give them [their] food in due season."],["28",[["δόντος",703654,500],["σου",711945,133],["αὐτοῖς",702165,151],["συλλέξουσιν",712263,218],["ἀνοίξαντος",701186,500],["δέ",703303,11],["σου",711945,133],["τὴν",709436,8],["χεῖρα",713787,9],["τὰ",709436,63],["σύμπαντα",712324,195],["πλησθήσονται",710532,144],["χρηστότητος",713959,17]],"When thou hast given [it] them, they will gather [it]; and when thou hast opened thine hand, they shall all be filled with good."],["29",[["ἀποστρέψαντος",701598,500],["δέ",703303,11],["σου",711945,133],["τὸ",709436,34],["πρόσωπον",710986,15],["ταραχθήσονται",712721,144],["ἀντανελεῖς",701212,166],["τὸ",709436,24],["πνεῦμα",710566,25],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐκλείψουσιν",704237,218],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["χοῦν",713930,6],["αὐτῶν",702165,40],["ἐπιστρέψουσιν",705278,218]],"But when thou hast turned away thy face, they shall be troubled: thou wilt take away their breath, and they shall fail, and return to their dust."],["30",[["ἐξαποστελεῖς",704872,166],["τὸ",709436,24],["πνεῦμά",710566,25],["σου",711945,133],["καὶ",707031,7],["κτισθήσονται",707938,144],["καὶ",707031,7],["ἀνακαινιεῖς",700965,166],["τὸ",709436,24],["πρόσωπον",710986,25],["τῆς",709436,16],["γῆς",703083,17]],"Thou shalt send forth thy Spirit, and they shall be created; and thou shalt renew the face of the earth."],["31",[["ἤτω",704093,45],["ἡ",709436,10],["δόξα",703791,12],["κυρίου",707996,18],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["εὐφρανθήσεται",705715,134],["κύριος",707996,4],["ἐπὶ",705080,0],["τοῖς",709436,95],["ἔργοις",705396,96],["αὐτοῦ",702165,102]],"Let the glory of the Lord be for ever: the Lord shall rejoice in his works;"],["32",[["ὁ",709436,3],["ἐπιβλέπων",705088,72],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ποιῶν",710582,72],["αὐτὴν",702165,104],["τρέμειν",712928,55],["ὁ",709436,3],["ἁπτόμενος",701654,122],["τῶν",709436,43],["ὀρέων",709768,44],["καὶ",707031,7],["καπνίζονται",707131,269]],"who looks upon the earth, and makes it tremble; who touches the mountains, and they smoke."],["33",[["ᾄσω",700299,165],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐν",704639,0],["τῇ",709436,100],["ζωῇ",705910,1],["μου",709032,133],["ψαλῶ",714021,165],["τῷ",709436,113],["θεῷ",706192,114],["μου",709032,133],["ἕως",705792,0],["ὑπάρχω",713104,157]],"I will sing to the Lord while I live; I will sing praise to my God while I exist."],["34",[["ἡδυνθείη",705943,528],["αὐτῷ",702165,50],["ἡ",709436,10],["διαλογή",703504,12],["μου",709032,133],["ἐγὼ",704018,164],["δὲ",703303,11],["εὐφρανθήσομαι",705715,180],["ἐπὶ",705080,0],["τῷ",709436,113],["κυρίῳ",707996,114]],"Let my meditation be sweet to him: and I will rejoice in the Lord."],["35",[["ἐκλίποισαν",704237,396],["ἁμαρτωλοὶ",700776,138],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἄνομοι",701194,138],["ὥστε",714164,11],["μὴ",708851,28],["ὑπάρχειν",713104,55],["αὐτούς",702165,62],["εὐλόγει",705631,240],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["τὸν",709436,5],["κύριον",707996,6]],"Let the sinners fail from off the earth, and transgressors, so that they shall be no more. Bless the Lord, O my soul."]]