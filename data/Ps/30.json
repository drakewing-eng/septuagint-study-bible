[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114],["ἐκστάσεως",704314,17]],"For the end, a Psalm of David, [an utterance] of extreme fear."],["2",[["ἐπὶ",705080,0],["σοί",711925,159],["κύριε",707996,153],["ἤλπισα",704529,155],["μὴ",708851,28],["καταισχυνθείην",707257,727],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἐν",704639,0],["τῇ",709436,100],["δικαιοσύνῃ",703695,1],["σου",711945,133],["ῥῦσαί",711309,300],["με",708618,163],["καὶ",707031,7],["ἐξελοῦ",704838,300],["με",708618,163]],"O Lord, I have hoped in thee; let me never be ashamed: deliver me in thy righteousness and rescue me."],["3",[["κλῖνον",707738,47],["πρός",710844,0],["με",708618,163],["τὸ",709436,24],["οὖς",709852,25],["σου",711945,133],["τάχυνον",712749,176],["τοῦ",709436,20],["ἐξελέσθαι",704838,109],["με",708618,163],["γενοῦ",703104,300],["μοι",708974,159],["εἰς",704105,0],["θεὸν",706192,6],["ὑπερασπιστὴν",713123,6],["καὶ",707031,7],["εἰς",704105,0],["οἶκον",709516,6],["καταφυγῆς",707485,17],["τοῦ",709436,20],["σῶσαί",712627,106],["με",708618,163]],"Incline thine ear to me; make haste to rescue me: be thou to me for a protecting God, and for a house of refuge to save me."],["4",[["ὅτι",709803,7],["κραταίωμά",707876,15],["μου",709032,133],["καὶ",707031,7],["καταφυγή",707485,12],["μου",709032,133],["εἶ",704093,154],["σὺ",712181,164],["καὶ",707031,7],["ἕνεκεν",704709,0],["τοῦ",709436,20],["ὀνόματός",709666,21],["σου",711945,133],["ὁδηγήσεις",709448,166],["με",708618,163],["καὶ",707031,7],["διαθρέψεις",703613,166],["με",708618,163]],"For thou art my strength and my refuge; and thou shalt guide me for thy name's sake, and maintain me."],["5",[["ἐξάξεις",704834,166],["με",708618,163],["ἐκ",704132,0],["παγίδος",709910,17],["ταύτης",709858,86],["ἧς",709781,167],["ἔκρυψάν",707923,150],["μοι",708974,159],["ὅτι",709803,7],["σὺ",712181,164],["εἶ",704093,154],["ὁ",709436,3],["ὑπερασπιστής",713123,4],["μου",709032,133]],"Thou shalt bring me out of the snare which they have hidden for me; for thou, O Lord, art my defender."],["6",[["εἰς",704105,0],["χεῖράς",713787,39],["σου",711945,133],["παραθήσομαι",710111,181],["τὸ",709436,24],["πνεῦμά",710566,25],["μου",709032,133],["ἐλυτρώσω",708282,174],["με",708618,163],["κύριε",707996,153],["ὁ",709436,3],["θεὸς",706192,4],["τῆς",709436,16],["ἀληθείας",700656,17]],"Into thine hands I will commit my spirit: thou hast redeemed me, O Lord God of truth."],["7",[["ἐμίσησας",708935,162],["τοὺς",709436,58],["διαφυλάσσοντας",703632,235],["ματαιότητας",708576,39],["διὰ",703417,0],["κενῆς",707612,82],["ἐγὼ",704018,164],["δὲ",703303,11],["ἐπὶ",705080,0],["τῷ",709436,113],["κυρίῳ",707996,114],["ἤλπισα",704529,155]],"Thou hast hated them that idly persist in vanities: but I have hoped in the Lord."],["8",[["ἀγαλλιάσομαι",700114,181],["καὶ",707031,7],["εὐφρανθήσομαι",705715,180],["ἐπὶ",705080,0],["τῷ",709436,53],["ἐλέει",704426,54],["σου",711945,133],["ὅτι",709803,7],["ἐπεῖδες",705057,162],["τὴν",709436,8],["ταπείνωσίν",712719,9],["μου",709032,133],["ἔσωσας",712627,162],["ἐκ",704132,0],["τῶν",709436,130],["ἀναγκῶν",700925,65],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133]],"I will exult and be glad in thy mercy: for thou hast looked upon mine affliction; thou hast saved my soul from distresses."],["9",[["καὶ",707031,7],["οὐ",709805,28],["συνέκλεισάς",712223,162],["με",708618,163],["εἰς",704105,0],["χεῖρας",713787,39],["ἐχθροῦ",705779,18],["ἔστησας",706846,162],["ἐν",704639,0],["εὐρυχώρῳ",705681,97],["τοὺς",709436,58],["πόδας",710707,57],["μου",709032,133]],"And thou hast not shut me up into the hands of the enemy: thou hast set my feet in a wide place."],["10",[["ἐλέησόν",704418,176],["με",708618,163],["κύριε",707996,153],["ὅτι",709803,7],["θλίβομαι",706274,254],["ἐταράχθη",712721,37],["ἐν",704639,0],["θυμῷ",706334,114],["ὁ",709436,3],["ὀφθαλμός",709870,4],["μου",709032,133],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["γαστήρ",702976,12],["μου",709032,133]],"Pity me, O Lord, for I am afflicted: my eye is troubled with indignation, my soul and my belly."],["11",[["ὅτι",709803,7],["ἐξέλιπεν",704237,2],["ἐν",704639,0],["ὀδύνῃ",709463,1],["ἡ",709436,10],["ζωή",705910,12],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,63],["ἔτη",705543,64],["μου",709032,133],["ἐν",704639,0],["στεναγμοῖς",712065,148],["ἠσθένησεν",701938,2],["ἐν",704639,0],["πτωχείᾳ",711073,1],["ἡ",709436,10],["ἰσχύς",706858,12],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,63],["ὀστᾶ",709792,64],["μου",709032,133],["ἐταράχθησαν",712721,99]],"For my life is spent with grief, and my years with groanings: my strength has been weakened through poverty, and my bones are troubled."],["12",[["παρὰ",709995,0],["πάντας",710177,60],["τοὺς",709436,58],["ἐχθρούς",705779,57],["μου",709032,133],["ἐγενήθην",703104,156],["ὄνειδος",709658,15],["καὶ",707031,7],["τοῖς",709436,147],["γείτοσίν",703016,148],["μου",709032,133],["σφόδρα",712586,28],["καὶ",707031,7],["φόβος",713534,4],["τοῖς",709436,147],["γνωστοῖς",703141,230],["μου",709032,133],["οἱ",709436,136],["θεωροῦντές",706226,146],["με",708618,163],["ἔξω",704983,28],["ἔφυγον",713433,150],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133]],"I became a reproach among all mine enemies, but exceedingly so to my neighbours, and a fear to mine acquaintance: they that saw me without fled from me."],["13",[["ἐπελήσθην",705187,156],["ὡσεὶ",714159,28],["νεκρὸς",709247,4],["ἀπὸ",701425,0],["καρδίας",707141,17],["ἐγενήθην",703104,156],["ὡσεὶ",714159,28],["σκεῦος",711844,15],["ἀπολωλός",701513,426]],"I have been forgotten as a dead man out of mind: I am become as a broken vessel."],["14",[["ὅτι",709803,7],["ἤκουσα",700587,155],["ψόγον",714061,6],["πολλῶν",710646,169],["παροικούντων",710156,170],["κυκλόθεν",707956,28],["ἐν",704639,0],["τῷ",709436,53],["ἐπισυναχθῆναι",705280,179],["αὐτοὺς",702165,62],["ἅμα",700745,28],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["τοῦ",709436,20],["λαβεῖν",708076,106],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἐβουλεύσαντο",702791,189]],"For I heard the slander of many that dwelt round about: when they were gathered together against me, they took counsel to take my life."],["15",[["ἐγὼ",704018,164],["δὲ",703303,11],["ἐπὶ",705080,0],["σὲ",711598,163],["ἤλπισα",704529,155],["κύριε",707996,153],["εἶπα",705373,155],["σὺ",712181,164],["εἶ",704093,154],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133]],"But I hoped in thee, O Lord: I said, Thou art my God."],["16",[["ἐν",704639,0],["ταῖς",709436,75],["χερσίν",713787,76],["σου",711945,133],["οἱ",709436,136],["καιροί",707047,52],["μου",709032,133],["ῥῦσαί",711309,300],["με",708618,163],["ἐκ",704132,0],["χειρὸς",713787,17],["ἐχθρῶν",705779,81],["μου",709032,133],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,80],["καταδιωκόντων",707243,170],["με",708618,163]],"My lots are in thy hands: deliver me from the hand of mine enemies,"],["17",[["ἐπίφανον",705317,176],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["ἐπὶ",705080,0],["τὸν",709436,5],["δοῦλόν",703817,6],["σου",711945,133],["σῶσόν",712627,176],["με",708618,163],["ἐν",704639,0],["τῷ",709436,53],["ἐλέει",704426,54],["σου",711945,133]],"and from them that persecute me. Make thy face to shine upon thy servant: save me in thy mercy."],["18",[["κύριε",707996,153],["μὴ",708851,28],["καταισχυνθείην",707257,727],["ὅτι",709803,7],["ἐπεκαλεσάμην",705153,161],["σε",711598,163],["αἰσχυνθείησαν",700485,393],["οἱ",709436,136],["ἀσεβεῖς",701909,138],["καὶ",707031,7],["καταχθείησαν",707232,393],["εἰς",704105,0],["ᾅδου",700255,18]],"O Lord, let me not be ashamed, for I have called upon thee: let the ungodly be ashamed, and brought down to Hades."],["19",[["ἄλαλα",700633,195],["γενηθήτω",703104,22],["τὰ",709436,63],["χείλη",713781,64],["τὰ",709436,63],["δόλια",703783,195],["τὰ",709436,63],["λαλοῦντα",708071,242],["κατὰ",707200,0],["τοῦ",709436,35],["δικαίου",703694,116],["ἀνομίαν",701192,9],["ἐν",704639,0],["ὑπερηφανίᾳ",713138,1],["καὶ",707031,7],["ἐξουδενώσει",704971,1]],"Let the deceitful lips become dumb, which speak iniquity against the righteous with pride and scorn."],["20",[["ὡς",714148,7],["πολὺ",710646,26],["τὸ",709436,34],["πλῆθος",710529,15],["τῆς",709436,16],["χρηστότητός",713959,17],["σου",711945,133],["κύριε",707996,153],["ἧς",709781,167],["ἔκρυψας",707923,162],["τοῖς",709436,147],["φοβουμένοις",713532,341],["σε",711598,163],["ἐξειργάσω",704902,174],["τοῖς",709436,147],["ἐλπίζουσιν",704529,349],["ἐπὶ",705080,0],["σὲ",711598,163],["ἐναντίον",704654,0],["τῶν",709436,80],["υἱῶν",713075,81],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"How abundant is the multitude of thy goodness, O Lord, which thou hast laid up for them that fear thee! thou hast wrought [it] out for them that hope on thee, in the presence of the sons of men."],["21",[["κατακρύψεις",707292,166],["αὐτοὺς",702165,62],["ἐν",704639,0],["ἀποκρύφῳ",701497,97],["τοῦ",709436,20],["προσώπου",710986,21],["σου",711945,133],["ἀπὸ",701425,0],["ταραχῆς",712722,17],["ἀνθρώπων",701163,81],["σκεπάσεις",711832,166],["αὐτοὺς",702165,62],["ἐν",704639,0],["σκηνῇ",711845,1],["ἀπὸ",701425,0],["ἀντιλογίας",701249,17],["γλωσσῶν",703120,65]],"Thou wilt hide them in the secret of thy presence from the vexation of man: thou wilt screen them in a tabernacle from the contradiction of tongues."],["22",[["εὐλογητὸς",705632,14],["κύριος",707996,4],["ὅτι",709803,7],["ἐθαυμάστωσεν",706319,2],["τὸ",709436,34],["ἔλεος",704426,15],["αὐτοῦ",702165,102],["ἐν",704639,0],["πόλει",710612,1],["περιοχῆς",710360,17]],"Blessed be the Lord: for he has magnified his mercy in a fortified city."],["23",[["ἐγὼ",704018,164],["δὲ",703303,11],["εἶπα",705373,155],["ἐν",704639,0],["τῇ",709436,100],["ἐκστάσει",704314,1],["μου",709032,133],["ἀπέρριμμαι",701563,584],["ἄρα",701666,11],["ἀπὸ",701425,0],["προσώπου",710986,21],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["σου",711945,133],["διὰ",703417,0],["τοῦτο",709858,129],["εἰσήκουσας",704108,162],["τῆς",709436,16],["φωνῆς",713640,17],["τῆς",709436,16],["δεήσεώς",703311,17],["μου",709032,133],["ἐν",704639,0],["τῷ",709436,53],["κεκραγέναι",707868,115],["με",708618,163],["πρὸς",710844,0],["σέ",711598,163]],"But I said in my extreme fear, I am cast out from the sight of thine eyes: therefore thou didst hearken, O Lord, to the voice of my supplication when I cried to thee."],["24",[["ἀγαπήσατε",700120,74],["τὸν",709436,5],["κύριον",707996,6],["πάντες",710177,138],["οἱ",709436,136],["ὅσιοι",709782,138],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ἀληθείας",700656,17],["ἐκζητεῖ",704187,91],["κύριος",707996,4],["καὶ",707031,7],["ἀνταποδίδωσιν",701215,91],["τοῖς",709436,147],["περισσῶς",710388,28],["ποιοῦσιν",710582,349],["ὑπερηφανίαν",713138,9]],"Love the Lord, all ye his saints: for the Lord seeks for truth, and renders [a reward] to them that deal very proudly."],["25",[["ἀνδρίζεσθε",701104,73],["καὶ",707031,7],["κραταιούσθω",707875,407],["ἡ",709436,10],["καρδία",707141,12],["ὑμῶν",713091,145],["πάντες",710177,138],["οἱ",709436,136],["ἐλπίζοντες",704529,146],["ἐπὶ",705080,0],["κύριον",707996,6]],"Be of good courage, and let your heart be strengthened, all ye that hope in the Lord."]]