[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["τῷ",709436,113],["Δαυιδ",703232,114],["ψαλμός",714022,4],["ὁ",709436,3],["θεός",706192,4],["τὴν",709436,8],["αἴνεσίν",700457,9],["μου",709032,133],["μὴ",708851,28],["παρασιωπήσῃς",710102,175]],"For the end, a Psalm of David. O God, pass not over my praise in silence;"],["2",[["ὅτι",709803,7],["στόμα",712125,15],["ἁμαρτωλοῦ",700776,116],["καὶ",707031,7],["στόμα",712125,15],["δολίου",703783,116],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ἠνοίχθη",701186,37],["ἐλάλησαν",708071,150],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["γλώσσῃ",703120,1],["δολίᾳ",703783,101]],"for the mouth of the sinner and the mouth of the crafty [man] have been opened against me: they have spoken against me with a crafty tongue."],["3",[["καὶ",707031,7],["λόγοις",708236,148],["μίσους",708947,21,44],["ἐκύκλωσάν",707958,150],["με",708618,163],["καὶ",707031,7],["ἐπολέμησάν",710601,150],["με",708618,163],["δωρεάν",703901,9]],"And they have compassed me with words of hatred; and fought against me without a cause."],["4",[["ἀντὶ",701227,0],["τοῦ",709436,20],["ἀγαπᾶν",700120,55],["με",708618,163],["ἐνδιέβαλλόν",704686,137],["με",708618,163],["ἐγὼ",704018,164],["δὲ",703303,11],["προσευχόμην",710893,334]],"Instead of loving me, they falsely accused me: but I continued to pray."],["5",[["καὶ",707031,7],["ἔθεντο",712849,150],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["κακὰ",707066,68],["ἀντὶ",701227,0],["ἀγαθῶν",700106,169],["καὶ",707031,7],["μῖσος",708947,4],["ἀντὶ",701227,0],["τῆς",709436,16],["ἀγαπήσεώς",700123,17],["μου",709032,133]],"And they rewarded me evil for good, and hatred for my love."],["6",[["κατάστησον",707011,176],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["ἁμαρτωλόν",700776,27],["καὶ",707031,7],["διάβολος",703428,4],["στήτω",706846,45],["ἐκ",704132,0],["δεξιῶν",703360,169],["αὐτοῦ",702165,102]],"Set thou a sinner against him; and let the devil stand at his right hand."],["7",[["ἐν",704639,0],["τῷ",709436,53],["κρίνεσθαι",707905,110],["αὐτὸν",702165,85],["ἐξέλθοι",704909,225],["καταδεδικασμένος",707241,419],["καὶ",707031,7],["ἡ",709436,10],["προσευχὴ",710892,12],["αὐτοῦ",702165,102],["γενέσθω",703104,315],["εἰς",704105,0],["ἁμαρτίαν",700775,9]],"When he is judged, let him go forth condemned: and let his prayer become sin."],["8",[["γενηθήτωσαν",703104,51],["αἱ",709436,190],["ἡμέραι",705984,191],["αὐτοῦ",702165,102],["ὀλίγαι",709568,192],["καὶ",707031,7],["τὴν",709436,8],["ἐπισκοπὴν",705255,9],["αὐτοῦ",702165,102],["λάβοι",708076,225],["ἕτερος",705535,14]],"Let his days be few: and let another take his office of overseer."],["9",[["γενηθήτωσαν",703104,51],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτοῦ",702165,102],["ὀρφανοὶ",709779,138],["καὶ",707031,7],["ἡ",709436,10],["γυνὴ",703209,12],["αὐτοῦ",702165,102],["χήρα",713848,12]],"Let his children be orphans, and his wife a widow."],["10",[["σαλευόμενοι",711403,348],["μεταναστήτωσαν",708808,264],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπαιτησάτωσαν",705004,264],["ἐκβληθήτωσαν",704145,51],["ἐκ",704132,0],["τῶν",709436,80],["οἰκοπέδων",709515,169],["αὐτῶν",702165,40]],"Let his children wander without a dwelling-place, and beg: let them be cast out of their habitations."],["11",[["ἐξερευνησάτω",704905,45],["δανειστὴς",703280,4],["πάντα",710177,68],["ὅσα",709788,68],["ὑπάρχει",713104,91],["αὐτῷ",702165,50],["διαρπασάτωσαν",703562,264],["ἀλλότριοι",700699,138],["τοὺς",709436,58],["πόνους",710661,57],["αὐτοῦ",702165,102]],"Let [his] creditor exact all that belongs to him: and let strangers spoil his labours."],["12",[["μὴ",708851,28],["ὑπαρξάτω",713104,45],["αὐτῷ",702165,50],["ἀντιλήμπτωρ",701246,4],["μηδὲ",708855,7],["γενηθήτω",703104,22],["οἰκτίρμων",709521,14],["τοῖς",709436,147],["ὀρφανοῖς",709779,230],["αὐτοῦ",702165,102]],"Let him have no helper; neither let there be any one to have compassion on his fatherless children."],["13",[["γενηθήτω",703104,22],["τὰ",709436,63],["τέκνα",712761,64],["αὐτοῦ",702165,102],["εἰς",704105,0],["ἐξολέθρευσιν",704954,9],["ἐν",704639,0],["γενεᾷ",703037,1],["μιᾷ",704106,101],["ἐξαλειφθήτω",704852,22],["τὸ",709436,34],["ὄνομα",709666,15],["αὐτοῦ",702165,102]],"Let his children be [given up] to utter destruction: in one generation let his name be blotted out."],["14",[["ἀναμνησθείη",701002,528],["ἡ",709436,10],["ἀνομία",701192,12],["τῶν",709436,80],["πατέρων",710189,81],["αὐτοῦ",702165,102],["ἔναντι",704653,0],["κυρίου",707996,18],["καὶ",707031,7],["ἡ",709436,10],["ἁμαρτία",700775,12],["τῆς",709436,16],["μητρὸς",708892,17],["αὐτοῦ",702165,102],["μὴ",708851,28],["ἐξαλειφθείη",704852,528]],"Let the iniquity of his fathers be remembered before the Lord; and let not the sin of his mother be blotted out."],["15",[["γενηθήτωσαν",703104,51],["ἔναντι",704653,0],["κυρίου",707996,18],["διὰ",703417,0],["παντός",710177,116],["καὶ",707031,7],["ἐξολεθρευθείη",704956,528],["ἐκ",704132,0],["γῆς",703083,17],["τὸ",709436,34],["μνημόσυνον",708966,15],["αὐτῶν",702165,40]],"Let them be before the Lord continually; and let their memorial be blotted out from the earth."],["16",[["ἀνθ᾿",701227,0],["ὧν",709781,252],["οὐκ",709805,28],["ἐμνήσθη",708960,2],["τοῦ",709436,20],["ποιῆσαι",710582,106],["ἔλεος",704426,25],["καὶ",707031,7],["κατεδίωξεν",707243,2],["ἄνθρωπον",701163,6],["πένητα",710248,6],["καὶ",707031,7],["πτωχὸν",711076,6],["καὶ",707031,7],["κατανενυγμένον",707347,439],["τῇ",709436,100],["καρδίᾳ",707141,1],["τοῦ",709436,20],["θανατῶσαι",706097,106]],"Because he remembered not to shew mercy, but persecuted the needy and poor man, and [that] to slay him that was pricked in the heart."],["17",[["καὶ",707031,7],["ἠγάπησεν",700120,2],["κατάραν",707395,9],["καὶ",707031,7],["ἥξει",705956,127],["αὐτῷ",702165,50],["καὶ",707031,7],["οὐκ",709805,28],["ἠθέλησεν",706176,2],["εὐλογίαν",705633,9],["καὶ",707031,7],["μακρυνθήσεται",708428,134],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102]],"He loved cursing also, and it shall come upon him; and he took not pleasure in blessing, so it shall be removed far from him."],["18",[["καὶ",707031,7],["ἐνεδύσατο",704701,23],["κατάραν",707395,9],["ὡς",714148,11],["ἱμάτιον",706742,25],["καὶ",707031,7],["εἰσῆλθεν",704114,2],["ὡς",714148,11],["ὕδωρ",713071,15],["εἰς",704105,0],["τὰ",709436,41,24],["ἔγκατα",703964,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὡσεὶ",714159,11],["ἔλαιον",704380,25],["ἐν",704639,0],["τοῖς",709436,95],["ὀστέοις",709792,96],["αὐτοῦ",702165,102]],"Yea, he put on cursing as a garment, and it is come as water into his bowels, and as oil into his bones."],["19",[["γενηθήτω",703104,22],["αὐτῷ",702165,50],["ὡς",714148,11],["ἱμάτιον",706742,25],["ὃ",709781,128],["περιβάλλεται",710294,117],["καὶ",707031,7],["ὡσεὶ",714159,11],["ζώνη",705912,12],["ἣν",709781,131],["διὰ",703417,0],["παντὸς",710177,116],["περιζώννυται",710317,117]],"Let it be to him as a garment which he puts on, and as a girdle with which he girds himself continually."],["20",[["τοῦτο",709858,129],["τὸ",709436,24],["ἔργον",705396,25],["τῶν",709436,80],["ἐνδιαβαλλόντων",704686,170],["με",708618,163],["παρὰ",709995,0],["κυρίου",707996,18],["καὶ",707031,7],["τῶν",709436,80],["λαλούντων",708071,170],["πονηρὰ",710660,68],["κατὰ",707200,0],["τῆς",709436,16],["ψυχῆς",714070,17],["μου",709032,133]],"This is the dealing of the Lord with those who falsely accuse me, and of them that speak evil against my soul."],["21",[["καὶ",707031,7],["σύ",712181,164],["κύριε",707996,153],["κύριε",707996,153],["ποίησον",710582,176],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["ἔλεος",704426,25],["ἕνεκεν",704709,0],["τοῦ",709436,20],["ὀνόματός",709666,21],["σου",711945,133],["ὅτι",709803,7],["χρηστὸν",713958,26],["τὸ",709436,34],["ἔλεός",704426,15],["σου",711945,133]],"But thou, O Lord, Lord, deal [mercifully] with me, for thy name's sake: for thy mercy is good."],["22",[["ῥῦσαί",711309,176],["με",708618,163],["ὅτι",709803,7],["πτωχὸς",711076,4],["καὶ",707031,7],["πένης",710248,4],["ἐγώ",704018,164],["εἰμι",704093,157],["καὶ",707031,7],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["τετάρακται",712721,187],["ἐντός",704804,28],["μου",709032,133]],"Deliver me, for I am poor and needy; and my heart is troubled within me."],["23",[["ὡσεὶ",714159,11],["σκιὰ",711852,12],["ἐν",704639,0],["τῷ",709436,53],["ἐκκλῖναι",704220,106],["αὐτὴν",702165,104],["ἀντανῃρέθην",701212,156],["ἐξετινάχθην",704334,156],["ὡσεὶ",714159,11],["ἀκρίδες",700599,191]],"I am removed as a shadow in its going down: I am tossed up and down like locusts."],["24",[["τὰ",709436,41],["γόνατά",703172,42],["μου",709032,133],["ἠσθένησαν",701938,150],["ἀπὸ",701425,0],["νηστείας",709303,17],["καὶ",707031,7],["ἡ",709436,10],["σάρξ",711537,12],["μου",709032,133],["ἠλλοιώθη",700694,37],["δι᾿",703417,0],["ἔλαιον",704380,25]],"My knees are weakened through fasting, and my flesh is changed by reason of [the want of] oil."],["25",[["καὶ",707031,7],["ἐγὼ",704018,164],["ἐγενήθην",703104,156],["ὄνειδος",709658,15],["αὐτοῖς",702165,151],["εἴδοσάν",709725,150],["με",708618,163],["ἐσάλευσαν",711403,150],["κεφαλὰς",707639,39],["αὐτῶν",702165,40]],"I became also a reproach to them: [when] they saw me they shook their heads."],["26",[["βοήθησόν",702746,176],["μοι",708974,159],["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["σῶσόν",712627,176],["με",708618,163],["κατὰ",707200,0],["τὸ",709436,24],["ἔλεός",704426,25],["σου",711945,133]],"Help me, O Lord my God; and save me according to thy mercy."],["27",[["καὶ",707031,7],["γνώτωσαν",703105,264],["ὅτι",709803,7],["ἡ",709436,10],["χείρ",713787,12],["σου",711945,133],["αὕτη",709858,107],["καὶ",707031,7],["σύ",712181,164],["κύριε",707996,153],["ἐποίησας",710582,162],["αὐτήν",702165,104]],"And let them know that this is thy hand; and [that] thou, Lord, hast wrought it."],["28",[["καταράσονται",707396,135],["αὐτοί",702165,201],["καὶ",707031,7],["σὺ",712181,164],["εὐλογήσεις",705631,166],["οἱ",709436,136],["ἐπανιστανόμενοί",705026,348],["μοι",708974,159],["αἰσχυνθήτωσαν",700485,51],["ὁ",709436,3],["δὲ",703303,11],["δοῦλός",703817,4],["σου",711945,133],["εὐφρανθήσεται",705715,134]],"Let them curse, but thou shalt bless: let them that rise up against me be ashamed, but let thy servant rejoice."],["29",[["ἐνδυσάσθωσαν",704701,486],["οἱ",709436,136],["ἐνδιαβάλλοντές",704686,146],["με",708618,163],["ἐντροπὴν",704809,9],["καὶ",707031,7],["περιβαλέσθωσαν",710294,486],["ὡσεὶ",714159,11],["διπλοΐδα",703739,9],["αἰσχύνην",700483,9],["αὐτῶν",702165,40]],"Let those that falsely accuse me be clothed with shame, and let them cover themselves with their shame as with a mantle."],["30",[["ἐξομολογήσομαι",704960,181],["τῷ",709436,113],["κυρίῳ",707996,114],["σφόδρα",712586,28],["ἐν",704639,0],["τῷ",709436,53],["στόματί",712125,54],["μου",709032,133],["καὶ",707031,7],["ἐν",704639,0],["μέσῳ",708768,30],["πολλῶν",710646,169],["αἰνέσω",700459,207],["αὐτόν",702165,85]],"I will give thanks to the Lord abundantly with my mouth; and in the midst of many I will praise him."],["31",[["ὅτι",709803,7],["παρέστη",710152,2],["ἐκ",704132,0],["δεξιῶν",703360,169],["πένητος",710248,18],["τοῦ",709436,20],["σῶσαι",712627,106],["ἐκ",704132,0],["τῶν",709436,80],["καταδιωκόντων",707243,170],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133]],"For he stood on the right hand of the poor, to save [me] from them that persecute my soul."]]