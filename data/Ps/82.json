[["1",[["ᾠδὴ",714091,12],["ψαλμοῦ",714022,18],["τῷ",709436,113],["Ασαφ",701894,114]],"A Song of a Psalm for Asaph."],["2",[["ὁ",709436,3],["θεός",706192,4],["τίς",712867,158],["ὁμοιωθήσεταί",709628,134],["σοι",711925,159],["μὴ",708851,28],["σιγήσῃς",711767,175],["μηδὲ",708855,7],["καταπραΰνῃς",707388,175],["ὁ",709436,3],["θεός",706192,4]],"O God, who shall be compared to thee? be not silent, neither be still, O God."],["3",[["ὅτι",709803,7],["ἰδοὺ",706497,88],["οἱ",709436,136],["ἐχθροί",705779,52],["σου",711945,133],["ἤχησαν",706045,150],["καὶ",707031,7],["οἱ",709436,136],["μισοῦντές",708935,146],["σε",711598,163],["ἦραν",700473,150],["κεφαλήν",707639,9]],"For behold, thine enemies have made a noise; and they that hate thee have lifted up the head."],["4",[["ἐπὶ",705080,0],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133],["κατεπανουργεύσαντο",707358,189],["γνώμην",703134,9],["καὶ",707031,7],["ἐβουλεύσαντο",702791,189],["κατὰ",707200,0],["τῶν",709436,80],["ἁγίων",700159,169],["σου",711945,133]],"Against thy people they have craftily imagined a device, and have taken counsel against thy saints."],["5",[["εἶπαν",705373,150],["δεῦτε",703383,28],["καὶ",707031,7],["ἐξολεθρεύσωμεν",704956,79],["αὐτοὺς",702165,62],["ἐξ",704132,0],["ἔθνους",704068,21],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["μνησθῇ",708923,384],["τὸ",709436,24],["ὄνομα",709666,25],["Ισραηλ",706839,18],["ἔτι",705538,28]],"They have said, Come, and let us utterly destroy them out of the nation; and let the name of Israel be remembered no more at all."],["6",[["ὅτι",709803,7],["ἐβουλεύσαντο",702791,189],["ἐν",704639,0],["ὁμονοίᾳ",709639,1],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτό",702165,129],["κατὰ",707200,0],["σοῦ",711945,133],["διαθήκην",703456,9],["διέθεντο",703609,189]],"For they have taken counsel together with one consent: they have made a confederacy against thee;"],["7",[["τὰ",709436,63],["σκηνώματα",711849,64],["τῶν",709436,80],["Ιδουμαίων",706504,81],["καὶ",707031,7],["οἱ",709436,136],["Ισμαηλῖται",706819,52],["Μωαβ",709085,4],["καὶ",707031,7],["οἱ",709436,136],["Αγαρηνοί",700127,52]],"even the tents of the Idumeans, and the Ismaelites; Moab, and the Agarenes;"],["8",[["Γεβαλ",702986,4],["καὶ",707031,7],["Αμμων",700847,4],["καὶ",707031,7],["Αμαληκ",700759,4],["καὶ",707031,7],["ἀλλόφυλοι",700706,138],["μετὰ",708780,0],["τῶν",709436,80],["κατοικούντων",707534,170],["Τύρον",713028,6]],"Gebal, and Ammon, and Amalec; the Philistines also, with them that dwell at Tyre."],["9",[["καὶ",707031,7],["γὰρ",702963,11],["καὶ",707031,28],["Ασσουρ",702001,4],["συμπαρεγένετο",712319,23],["μετ᾿",708780,0],["αὐτῶν",702165,40],["ἐγενήθησαν",703104,99],["εἰς",704105,0],["ἀντίλημψιν",701247,9],["τοῖς",709436,147],["υἱοῖς",713075,148],["Λωτ",708293,18],["διάψαλμα",703641,15]],"Yea, Assur too is come with them: they have become a help to the children of Lot. Pause."],["10",[["ποίησον",710582,176],["αὐτοῖς",702165,151],["ὡς",714148,7],["τῇ",709436,100],["Μαδιαμ",708355,1],["καὶ",707031,7],["τῷ",709436,113],["Σισαρα",711803,114],["ὡς",714148,7],["ὁ",709436,3],["Ιαβιν",706365,4],["ἐν",704639,0],["τῷ",709436,113],["χειμάρρῳ",713783,114],["Κισων",707695,228]],"Do thou to them as to Madiam, and to Sisera; as to Jabin at the brook of Kison."],["11",[["ἐξωλεθρεύθησαν",704956,99],["ἐν",704639,0],["Αενδωρ",700314,245],["ἐγενήθησαν",703104,99],["ὡσεὶ",714159,7],["κόπρος",707828,12],["τῇ",709436,100],["γῇ",703083,1]],"They were utterly destroyed at Aendor: they became as dung for the earth."],["12",[["θοῦ",712849,300],["τοὺς",709436,58],["ἄρχοντας",701862,57],["αὐτῶν",702165,40],["ὡς",714148,7],["τὸν",709436,5],["Ωρηβ",714137,6],["καὶ",707031,7],["Ζηβ",705870,6],["καὶ",707031,7],["Ζεβεε",705853,6],["καὶ",707031,7],["Σαλμανα",711418,6],["πάντας",710177,60],["τοὺς",709436,58],["ἄρχοντας",701862,57],["αὐτῶν",702165,40]],"Make their princes as Oreb and Zeb, and Zebee and Salmana; [even] all their princes:"],["13",[["οἵτινες",709793,450],["εἶπαν",705373,150],["κληρονομήσωμεν",707724,79],["ἑαυτοῖς",703917,151],["τὸ",709436,24],["ἁγιαστήριον",700156,25],["τοῦ",709436,35],["θεοῦ",706192,18]],"who said, Let us take to ourselves the altar of God as an inheritance."],["14",[["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["θοῦ",712849,300],["αὐτοὺς",702165,62],["ὡς",714148,7],["τροχόν",712994,6],["ὡς",714148,7],["καλάμην",707079,9],["κατὰ",707200,0],["πρόσωπον",710986,25],["ἀνέμου",701123,18]],"O my God, make them as a wheel; as stubble before the face of the wind."],["15",[["ὡσεὶ",714159,7],["πῦρ",711088,25],["ὃ",709781,128],["διαφλέξει",703626,127],["δρυμόν",703836,6],["ὡς",714148,7],["εἰ",704071,7],["φλὸξ",713524,12],["κατακαύσαι",707258,106],["ὄρη",709768,42]],"As fire which shall burn up a wood, as the flame may consume the mountains;"],["16",[["οὕτως",709859,28],["καταδιώξεις",707243,166],["αὐτοὺς",702165,62],["ἐν",704639,0],["τῇ",709436,100],["καταιγίδι",707254,1],["σου",711945,133],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["ὀργῇ",709728,1],["σου",711945,133],["ταράξεις",712721,166],["αὐτούς",702165,62]],"so shalt thou persecute them with thy tempest, and trouble them in thine anger."],["17",[["πλήρωσον",710543,176],["τὰ",709436,41],["πρόσωπα",710986,42],["αὐτῶν",702165,40],["ἀτιμίας",702094,17],["καὶ",707031,7],["ζητήσουσιν",705879,218],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["κύριε",707996,153]],"Fill their faces with dishonour; so shall they seek thy name, O Lord."],["18",[["αἰσχυνθήτωσαν",700485,51],["καὶ",707031,7],["ταραχθήτωσαν",712721,51],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18],["καὶ",707031,7],["ἐντραπήτωσαν",704805,51],["καὶ",707031,7],["ἀπολέσθωσαν",701513,486]],"Let them be ashamed and troubled for evermore; yea, let them be confounded and destroyed."],["19",[["καὶ",707031,7],["γνώτωσαν",703105,264],["ὅτι",709803,7],["ὄνομά",709666,25],["σοι",711925,159],["κύριος",707996,4],["σὺ",712181,164],["μόνος",709003,14],["ὕψιστος",713287,14],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9]],"And let them know that thy name is Lord; that thou alone art Most High over all the earth."]]