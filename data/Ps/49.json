[["1",[["ψαλμὸς",714022,4],["τῷ",709436,113],["Ασαφ",701894,114],["θεὸς",706192,4],["θεῶν",706192,81],["κύριος",707996,4],["ἐλάλησεν",708071,2],["καὶ",707031,7],["ἐκάλεσεν",707084,2],["τὴν",709436,8],["γῆν",703083,9],["ἀπὸ",701425,0],["ἀνατολῶν",701071,65],["ἡλίου",705974,18],["καὶ",707031,7],["μέχρι",708849,0],["δυσμῶν",703865,65]],"A Psalm for Asaph. The God of gods, the Lord, has spoken, and called the earth from the rising of the sun to the going down [thereof]."],["2",[["ἐκ",704132,0],["Σιων",711816,17],["ἡ",709436,10],["εὐπρέπεια",705666,12],["τῆς",709436,16],["ὡραιότητος",714133,17],["αὐτοῦ",702165,102],["ὁ",709436,3],["θεὸς",706192,4],["ἐμφανῶς",704630,28],["ἥξει",705956,127]],"Out of Sion [comes] the excellence of his beauty."],["3",[["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["καὶ",707031,7],["οὐ",709805,28],["παρασιωπήσεται",710102,135],["πῦρ",711088,25],["ἐναντίον",704654,0],["αὐτοῦ",702165,102],["καυθήσεται",707049,134],["καὶ",707031,7],["κύκλῳ",707959,114],["αὐτοῦ",702165,102],["καταιγὶς",707254,12],["σφόδρα",712586,28]],"God, our God, shall come manifestly, and shall not keep silence: a fire shall be kindled before him, and round about him there shall be a very great tempest."],["4",[["προσκαλέσεται",710912,93],["τὸν",709436,5],["οὐρανὸν",709844,6],["ἄνω",701296,28],["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9],["διακρῖναι",703488,106],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102]],"He shall summon the heaven above, and the earth, that he may judge his people."],["5",[["συναγάγετε",712375,74],["αὐτῷ",702165,50],["τοὺς",709436,58],["ὁσίους",709782,60],["αὐτοῦ",702165,102],["τοὺς",709436,58],["διατιθεμένους",703609,236],["τὴν",709436,8],["διαθήκην",703456,9],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["θυσίαις",706345,76]],"Assemble ye his saints to him, those that have engaged in a covenant with him upon sacrifices."],["6",[["καὶ",707031,7],["ἀναγγελοῦσιν",700921,218],["οἱ",709436,136],["οὐρανοὶ",709844,52],["τὴν",709436,8],["δικαιοσύνην",703695,9],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ὁ",709436,3],["θεὸς",706192,4],["κριτής",707910,4],["ἐστιν",704093,91],["διάψαλμα",703641,15]],"And the heavens shall declare his righteousness: for God is judge. Pause."],["7",[["ἄκουσον",700587,176],["λαός",708094,4],["μου",709032,133],["καὶ",707031,7],["λαλήσω",708071,165],["σοι",711925,159],["Ισραηλ",706839,153],["καὶ",707031,7],["διαμαρτύρομαί",703513,254],["σοι",711925,159],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["θεός",706192,4],["σού",711945,133],["εἰμι",704093,157],["ἐγώ",704018,164]],"Hear, my people, and I will speak to thee, O Israel: and I will testify to thee: I am God, thy God."],["8",[["οὐκ",709805,28],["ἐπὶ",705080,0],["ταῖς",709436,75],["θυσίαις",706345,76],["σου",711945,133],["ἐλέγξω",704416,165],["σε",711598,163],["τὰ",709436,63],["δὲ",703303,11],["ὁλοκαυτώματά",709589,64],["σου",711945,133],["ἐνώπιόν",704823,0],["μού",709032,133],["ἐστιν",704093,91],["διὰ",703417,0],["παντός",710177,116]],"I will not reprove thee on account of thy sacrifices; for thy whole-burnt-offerings are before me continually."],["9",[["οὐ",709805,28],["δέξομαι",703393,181],["ἐκ",704132,0],["τοῦ",709436,35],["οἴκου",709516,18],["σου",711945,133],["μόσχους",709029,57],["οὐδὲ",709816,7],["ἐκ",704132,0],["τῶν",709436,43],["ποιμνίων",710598,44],["σου",711945,133],["χιμάρους",713864,57]],"I will take no bullocks out of thine house, nor he-goats out of thy flocks."],["10",[["ὅτι",709803,7],["ἐμά",704578,195],["ἐστιν",704093,91],["πάντα",710177,195],["τὰ",709436,63],["θηρία",706252,64],["τοῦ",709436,35],["δρυμοῦ",703836,18],["κτήνη",707934,64],["ἐν",704639,0],["τοῖς",709436,95],["ὄρεσιν",709768,96],["καὶ",707031,7],["βόες",702798,52]],"For all the wild beasts of the thicket are mine, the cattle on the mountains, and oxen."],["11",[["ἔγνωκα",703105,89],["πάντα",710177,68],["τὰ",709436,41],["πετεινὰ",710439,42],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["ὡραιότης",714133,12],["ἀγροῦ",700196,18],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["ἐστιν",704093,91]],"I know all the birds of the sky; and the beauty of the field is mine."],["12",[["ἐὰν",703912,7],["πεινάσω",710222,207],["οὐ",709805,28],["μή",708851,28],["σοι",711925,159],["εἴπω",705373,207],["ἐμὴ",704578,29],["γάρ",702963,11],["ἐστιν",704093,91],["ἡ",709436,10],["οἰκουμένη",709517,211],["καὶ",707031,7],["τὸ",709436,34],["πλήρωμα",710544,15],["αὐτῆς",702165,86]],"If I should be hungry, I will not tell thee: for the world is mine, and the fulness of it."],["13",[["μὴ",708851,28],["φάγομαι",705495,181],["κρέα",707889,42],["ταύρων",712734,81],["ἢ",705924,7],["αἷμα",700442,25],["τράγων",712917,81],["πίομαι",710478,181]],"Will I eat the flesh of bulls, or drink the blood of goats?"],["14",[["θῦσον",706349,176],["τῷ",709436,113],["θεῷ",706192,114],["θυσίαν",706345,9],["αἰνέσεως",700457,17],["καὶ",707031,7],["ἀπόδος",701449,176],["τῷ",709436,113],["ὑψίστῳ",713287,30],["τὰς",709436,38],["εὐχάς",705726,39],["σου",711945,133]],"Offer to God the sacrifice of praise; and pay thy vows to the Most High."],["15",[["καὶ",707031,7],["ἐπικάλεσαί",705153,300],["με",708618,163],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["θλίψεως",706276,17],["καὶ",707031,7],["ἐξελοῦμαί",704838,181],["σε",711598,163],["καὶ",707031,7],["δοξάσεις",703792,166],["με",708618,163],["διάψαλμα",703641,15]],"And call upon me in the day of affliction; and I will deliver thee, and thou shalt glorify me. Pause."],["16",[["τῷ",709436,113],["δὲ",703303,11],["ἁμαρτωλῷ",700776,30],["εἶπεν",705373,2],["ὁ",709436,3],["θεός",706192,4],["ἵνα",706747,7],["τί",712867,126],["σὺ",712181,164],["διηγῇ",703679,259],["τὰ",709436,41],["δικαιώματά",703697,42],["μου",709032,133],["καὶ",707031,7],["ἀναλαμβάνεις",700984,154],["τὴν",709436,8],["διαθήκην",703456,9],["μου",709032,133],["διὰ",703417,0],["στόματός",712125,21],["σου",711945,133]],"But to the sinner God has said, Why dost thou declare my ordinances, and take up my covenant in thy mouth?"],["17",[["σὺ",712181,164],["δὲ",703303,11],["ἐμίσησας",708935,162],["παιδείαν",709924,9],["καὶ",707031,7],["ἐξέβαλες",704145,162],["τοὺς",709436,58],["λόγους",708236,57],["μου",709032,133],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,0]],"Whereas thou hast hated instruction, and hast cast my words behind [thee]."],["18",[["εἰ",704071,7],["ἐθεώρεις",706226,363],["κλέπτην",707714,6],["συνέτρεχες",712518,363],["αὐτῷ",702165,50],["καὶ",707031,7],["μετὰ",708780,0],["μοιχῶν",708980,81],["τὴν",709436,8],["μερίδα",708748,9],["σου",711945,133],["ἐτίθεις",712849,363]],"If thou sawest a thief, thou rannest along with him, and hast cast in thy lot with adulterers."],["19",[["τὸ",709436,34],["στόμα",712125,15],["σου",711945,133],["ἐπλεόνασεν",710516,2],["κακίαν",707054,9],["καὶ",707031,7],["ἡ",709436,10],["γλῶσσά",703120,12],["σου",711945,133],["περιέπλεκεν",710365,2],["δολιότητα",703784,9]],"Thy mouth has multiplied wickedness, and thy tongue has framed deceit."],["20",[["καθήμενος",707000,122],["κατὰ",707200,0],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["σου",711945,133],["κατελάλεις",707298,363],["καὶ",707031,7],["κατὰ",707200,0],["τοῦ",709436,35],["υἱοῦ",713075,18],["τῆς",709436,16],["μητρός",708892,17],["σου",711945,133],["ἐτίθεις",712849,363],["σκάνδαλον",711825,25]],"Thou didst sit and speak against thy brother, and didst scandalise thy mother's son."],["21",[["ταῦτα",709858,71],["ἐποίησας",710582,162],["καὶ",707031,7],["ἐσίγησα",711767,155],["ὑπέλαβες",713210,162],["ἀνομίαν",701192,9],["ὅτι",709803,7],["ἔσομαί",704093,181],["σοι",711925,159],["ὅμοιος",709626,14],["ἐλέγξω",704416,165],["σε",711598,163],["καὶ",707031,7],["παραστήσω",710152,165],["κατὰ",707200,0],["πρόσωπόν",710986,25],["σου",711945,133]],"These things thou didst, and I kept silence: thou thoughtest wickedly that I should be like thee; [but] I will reprove thee, and set [thine offences] before thee."],["22",[["σύνετε",712481,335],["δὴ",703395,11],["ταῦτα",709858,71],["οἱ",709436,136],["ἐπιλανθανόμενοι",705187,348],["τοῦ",709436,35],["θεοῦ",706192,18],["μήποτε",708882,28],["ἁρπάσῃ",701804,172],["καὶ",707031,7],["μὴ",708851,28],["ᾖ",704093,204],["ὁ",709436,3],["ῥυόμενος",711309,122]],"Now consider these things, ye that forget God, lest he rend [you], and there be no deliverer."],["23",[["θυσία",706345,12],["αἰνέσεως",700457,17],["δοξάσει",703792,127],["με",708618,163],["καὶ",707031,7],["ἐκεῖ",704181,28],["ὁδός",709458,12],["ᾗ",709781,108],["δείξω",703314,165],["αὐτῷ",702165,50],["τὸ",709436,24],["σωτήριον",712659,25],["τοῦ",709436,35],["θεοῦ",706192,18]],"The sacrifice of praise will glorify me: and that is the way wherein I will shew to him the salvation of God."]]