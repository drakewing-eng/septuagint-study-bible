[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ὑπὲρ",713111,0],["μαελεθ",708364,227],["συνέσεως",712460,17],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, [a Psalm] of David upon Maeleth, of instruction."],["2",[["εἶπεν",705373,2],["ἄφρων",702236,14],["ἐν",704639,0],["καρδίᾳ",707141,1],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἔστιν",704093,91],["θεός",706192,4],["διεφθάρησαν",703624,99],["καὶ",707031,7],["ἐβδελύχθησαν",702608,99],["ἐν",704639,0],["ἀνομίαις",701192,76],["οὐκ",709805,28],["ἔστιν",704093,91],["ποιῶν",710582,72],["ἀγαθόν",700106,46]],"The fool has said in his heart, There is no God. They have corrupted [themselves], and become abominable in iniquities: there is none that does good."],["3",[["ὁ",709436,3],["θεὸς",706192,4],["ἐκ",704132,0],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["διέκυψεν",703491,2],["ἐπὶ",705080,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["τῶν",709436,80],["ἀνθρώπων",701163,81],["τοῦ",709436,20],["ἰδεῖν",709725,106],["εἰ",704071,7],["ἔστιν",704093,91],["συνίων",712481,72],["ἢ",705924,7],["ἐκζητῶν",704187,72],["τὸν",709436,5],["θεόν",706192,6]],"God looked down from heaven upon the sons of men, to see if there were any that understood, or sought after God."],["4",[["πάντες",710177,138],["ἐξέκλιναν",704220,150],["ἅμα",700745,28],["ἠχρεώθησαν",702311,99],["οὐκ",709805,28],["ἔστιν",704093,91],["ποιῶν",710582,72],["ἀγαθόν",700106,46],["οὐκ",709805,28],["ἔστιν",704093,91],["ἕως",705792,0],["ἑνός",704106,116]],"They have all gone out of the way, they are together become unprofitable; there is none that does good, there is not even one."],["5",[["οὐχὶ",709862,28],["γνώσονται",703105,135],["πάντες",710177,138],["οἱ",709436,136],["ἐργαζόμενοι",705383,348],["τὴν",709436,8],["ἀνομίαν",701192,9],["οἱ",709436,136],["ἔσθοντες",705495,146],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["βρώσει",702825,1],["ἄρτου",701829,18],["τὸν",709436,5],["θεὸν",706192,6],["οὐκ",709805,28],["ἐπεκαλέσαντο",705153,189]],"Will none of the workers of iniquity know, who devour my people as they would eat bread? they have not called upon God. There were they greatly afraid, where there was no fear:"],["6",[["ἐκεῖ",704181,28],["φοβηθήσονται",713532,144],["φόβον",713534,6],["οὗ",709781,48],["οὐκ",709805,28],["ἦν",704093,13],["φόβος",713534,4],["ὅτι",709803,7],["ὁ",709436,3],["θεὸς",706192,4],["διεσκόρπισεν",703579,2],["ὀστᾶ",709792,42],["ἀνθρωπαρέσκων",701161,81],["κατῃσχύνθησαν",707257,99],["ὅτι",709803,7],["ὁ",709436,3],["θεὸς",706192,4],["ἐξουδένωσεν",704969,2],["αὐτούς",702165,62]],"for God has scattered the bones of the men-pleasers; they were ashamed, for God despised them."],["7",[["τίς",712867,158],["δώσει",703654,127],["ἐκ",704132,0],["Σιων",711816,17],["τὸ",709436,24],["σωτήριον",712659,25],["τοῦ",709436,35],["Ισραηλ",706839,18],["ἐν",704639,0],["τῷ",709436,53],["ἐπιστρέψαι",705278,106],["κύριον",707996,6],["τὴν",709436,8],["αἰχμαλωσίαν",700499,9],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτοῦ",702165,102],["ἀγαλλιάσεται",700114,93],["Ιακωβ",706401,4],["καὶ",707031,7],["εὐφρανθήσεται",705715,134],["Ισραηλ",706839,4]],"Who will bring the salvation of Israel out of Sion? When the Lord turns the captivity of his people, Jacob shall exult, and Israel shall be glad."]]