[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ὑπὲρ",713111,0],["τῶν",709436,130],["ληνῶν",708176,65],["τοῖς",709436,147],["υἱοῖς",713075,148],["Κορε",707833,18],["ψαλμός",714022,4]],"For the end, a Psalm for the sons of Core, concerning the wine-presses."],["2",[["ὡς",714148,7],["ἀγαπητὰ",700124,195],["τὰ",709436,63],["σκηνώματά",711849,64],["σου",711945,133],["κύριε",707996,153],["τῶν",709436,130],["δυνάμεων",703839,65]],"How amiable are thy tabernacles, O Lord of hosts!"],["3",[["ἐπιποθεῖ",705228,91],["καὶ",707031,7],["ἐκλείπει",704237,91],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["εἰς",704105,0],["τὰς",709436,38],["αὐλὰς",702137,39],["τοῦ",709436,35],["κυρίου",707996,18],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["σάρξ",711537,12],["μου",709032,133],["ἠγαλλιάσαντο",700114,189],["ἐπὶ",705080,0],["θεὸν",706192,6],["ζῶντα",705851,183]],"My soul longs, and faints for the courts of the Lord: my heart and my flesh have exulted in the living God."],["4",[["καὶ",707031,7],["γὰρ",702963,11],["στρουθίον",712166,15],["εὗρεν",705676,2],["ἑαυτῷ",703917,50],["οἰκίαν",709505,9],["καὶ",707031,7],["τρυγὼν",713000,12],["νοσσιὰν",709360,9],["ἑαυτῇ",703917,105],["οὗ",709781,48],["θήσει",712849,127],["τὰ",709436,41],["νοσσία",709361,42],["αὐτῆς",702165,86],["τὰ",709436,41],["θυσιαστήριά",706348,42],["σου",711945,133],["κύριε",707996,153],["τῶν",709436,130],["δυνάμεων",703839,65],["ὁ",709436,3],["βασιλεύς",702580,4],["μου",709032,133],["καὶ",707031,7],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133]],"Yea, the sparrow has found himself a home, and the turtle-dove a nest for herself, where she may lay her young, [even] thine altars, O Lord of hosts, my King, and my God."],["5",[["μακάριοι",708397,138],["οἱ",709436,136],["κατοικοῦντες",707534,146],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["σου",711945,133],["εἰς",704105,0],["τοὺς",709436,58],["αἰῶνας",700504,57],["τῶν",709436,80],["αἰώνων",700504,81],["αἰνέσουσίν",700459,218],["σε",711598,163],["διάψαλμα",703641,15]],"Blessed are they that dwell in thy house: they will praise thee evermore. Pause."],["6",[["μακάριος",708397,14],["ἀνήρ",701150,4],["οὗ",709781,48],["ἐστιν",704093,91],["ἡ",709436,10],["ἀντίλημψις",701247,12],["αὐτοῦ",702165,102],["παρὰ",709995,0],["σοῦ",711945,133],["κύριε",707996,153],["ἀναβάσεις",700907,191],["ἐν",704639,0],["τῇ",709436,100],["καρδίᾳ",707141,1],["αὐτοῦ",702165,102],["διέθετο",703609,23]],"Blessed is the man whose help is of thee, O Lord; in his heart he has purposed to go up"],["7",[["ἐν",704639,0],["τῇ",709436,100],["κοιλάδι",707758,1],["τοῦ",709436,35],["κλαυθμῶνος",707706,18],["εἰς",704105,0],["τόπον",712903,6],["ὃν",709781,112],["ἔθετο",712849,23],["καὶ",707031,7],["γὰρ",702963,11],["εὐλογίας",705633,17],["δώσει",703654,127],["ὁ",709436,3],["νομοθετῶν",709346,72]],"the valley of weeping, to the place which he has appointed, for [there] the law-giver will grant blessings."],["8",[["πορεύσονται",710667,135],["ἐκ",704132,0],["δυνάμεως",703839,17],["εἰς",704105,0],["δύναμιν",703839,9],["ὀφθήσεται",709725,134],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,80],["θεῶν",706192,81],["ἐν",704639,0],["Σιων",711816,1]],"They shall go from strength to strength: the God of gods shall be seen in Sion."],["9",[["κύριε",707996,153],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,130],["δυνάμεων",703839,65],["εἰσάκουσον",704108,176],["τῆς",709436,16],["προσευχῆς",710892,17],["μου",709032,133],["ἐνώτισαι",704825,300],["ὁ",709436,3],["θεὸς",706192,4],["Ιακωβ",706401,18],["διάψαλμα",703641,15]],"O Lord God of hosts, hear my prayer: hearken, O God of Jacob. Pause."],["10",[["ὑπερασπιστὰ",713123,6],["ἡμῶν",705999,145],["ἰδέ",709725,176],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["ἐπίβλεψον",705088,176],["ἐπὶ",705080,0],["τὸ",709436,24],["πρόσωπον",710986,25],["τοῦ",709436,35],["χριστοῦ",713964,116],["σου",711945,133]],"Behold, O God our defender, and look upon the face of thine anointed."],["11",[["ὅτι",709803,7],["κρείσσων",707891,29],["ἡμέρα",705984,12],["μία",704106,29],["ἐν",704639,0],["ταῖς",709436,75],["αὐλαῖς",702137,76],["σου",711945,133],["ὑπὲρ",713111,0],["χιλιάδας",713858,39],["ἐξελεξάμην",704236,161],["παραρριπτεῖσθαι",710099,109],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["τοῦ",709436,35],["θεοῦ",706192,18],["μᾶλλον",708448,28],["ἢ",705924,7],["οἰκεῖν",709499,55],["ἐν",704639,0],["σκηνώμασιν",711849,96],["ἁμαρτωλῶν",700776,169]],"For one day in thy courts is better than thousands. I would rather be an abject in the house of God, than dwell in the tents of sinners."],["12",[["ὅτι",709803,7],["ἔλεον",704426,6],["καὶ",707031,7],["ἀλήθειαν",700656,9],["ἀγαπᾷ",700120,91],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["χάριν",713735,9],["καὶ",707031,7],["δόξαν",703791,9],["δώσει",703654,127],["κύριος",707996,4],["οὐ",709805,28],["στερήσει",712076,127],["τὰ",709436,41],["ἀγαθὰ",700106,68],["τοὺς",709436,58],["πορευομένους",710667,236],["ἐν",704639,0],["ἀκακίᾳ",700511,1]],"For the Lord loves mercy and truth: God will give grace and glory: the Lord will not withhold good things from them that walk in innocence."],["13",[["κύριε",707996,153],["τῶν",709436,130],["δυνάμεων",703839,65],["μακάριος",708397,14],["ἄνθρωπος",701163,4],["ὁ",709436,3],["ἐλπίζων",704529,72],["ἐπὶ",705080,0],["σέ",711598,163]],"O Lord of hosts, blessed is the man that trusts in thee."]]