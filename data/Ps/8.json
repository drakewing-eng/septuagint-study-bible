[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ὑπὲρ",713111,0],["τῶν",709436,130],["ληνῶν",708176,65],["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, concerning the wine-presses, a Psalm of David."],["2",[["κύριε",707996,153],["ὁ",709436,3],["κύριος",707996,4],["ἡμῶν",705999,145],["ὡς",714148,7],["θαυμαστὸν",706138,26],["τὸ",709436,34],["ὄνομά",709666,15],["σου",711945,133],["ἐν",704639,0],["πάσῃ",710177,101],["τῇ",709436,100],["γῇ",703083,1],["ὅτι",709803,7],["ἐπήρθη",705002,37],["ἡ",709436,10],["μεγαλοπρέπειά",708632,12],["σου",711945,133],["ὑπεράνω",713118,0],["τῶν",709436,80],["οὐρανῶν",709844,81]],"O Lord, our Lord, how wonderful is thy name in all the earth! for thy magnificence is exalted above the heavens."],["3",[["ἐκ",704132,0],["στόματος",712125,21],["νηπίων",709295,169],["καὶ",707031,7],["θηλαζόντων",706233,170],["κατηρτίσω",707410,174],["αἶνον",700462,6],["ἕνεκα",704709,0],["τῶν",709436,80],["ἐχθρῶν",705779,81],["σου",711945,133],["τοῦ",709436,20],["καταλῦσαι",707323,106],["ἐχθρὸν",705779,6],["καὶ",707031,7],["ἐκδικητήν",704176,6]],"Out of the mouth of babes and sucklings hast thou perfected praise, because of thine enemies; that thou mightest put down the enemy and avenger."],["4",[["ὅτι",709803,7],["ὄψομαι",709725,181],["τοὺς",709436,58],["οὐρανούς",709844,57],["ἔργα",705396,42],["τῶν",709436,80],["δακτύλων",703259,81],["σου",711945,133],["σελήνην",711650,9],["καὶ",707031,7],["ἀστέρας",702017,57],["ἃ",709781,69],["σὺ",712181,164],["ἐθεμελίωσας",706182,162]],"For I will regard the heavens, the work of thy fingers; the moon and stars, which thou hast established."],["5",[["τί",712867,273],["ἐστιν",704093,91],["ἄνθρωπος",701163,4],["ὅτι",709803,7],["μιμνῄσκῃ",708923,259],["αὐτοῦ",702165,102],["ἢ",705924,7],["υἱὸς",713075,4],["ἀνθρώπου",701163,18],["ὅτι",709803,7],["ἐπισκέπτῃ",705250,259],["αὐτόν",702165,85]],"What is man, that thou art mindful of him? or the son of man, that thou visitest him?"],["6",[["ἠλάττωσας",704394,162],["αὐτὸν",702165,85],["βραχύ",702809,46],["τι",712866,126],["παρ᾿",709995,0],["ἀγγέλους",700140,57],["δόξῃ",703791,1],["καὶ",707031,7],["τιμῇ",712856,1],["ἐστεφάνωσας",712084,162],["αὐτόν",702165,85]],"Thou madest him a little less than angels, thou hast crowned him with glory and honour;"],["7",[["καὶ",707031,7],["κατέστησας",707011,162],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["τὰ",709436,41],["ἔργα",705396,42],["τῶν",709436,130],["χειρῶν",713787,65],["σου",711945,133],["πάντα",710177,68],["ὑπέταξας",713250,162],["ὑποκάτω",713204,0],["τῶν",709436,80],["ποδῶν",710707,81],["αὐτοῦ",702165,102]],"and thou hast set him over the works of thy hands: thou hast put all things under his feet:"],["8",[["πρόβατα",710768,42],["καὶ",707031,7],["βόας",702798,39],["πάσας",710177,119],["ἔτι",705538,28],["δὲ",703303,11],["καὶ",707031,7],["τὰ",709436,41],["κτήνη",707934,42],["τοῦ",709436,20],["πεδίου",710215,21]],"sheep and all oxen, yea, and the cattle of the field;"],["9",[["τὰ",709436,41],["πετεινὰ",710439,42],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["τοὺς",709436,58],["ἰχθύας",706870,57],["τῆς",709436,16],["θαλάσσης",706069,17],["τὰ",709436,41],["διαπορευόμενα",703551,67],["τρίβους",712939,39],["θαλασσῶν",706069,65]],"the birds of the sky, and the fish of the sea, the [creatures] passing through the paths of the sea."],["10",[["κύριε",707996,153],["ὁ",709436,3],["κύριος",707996,4],["ἡμῶν",705999,145],["ὡς",714148,7],["θαυμαστὸν",706138,26],["τὸ",709436,34],["ὄνομά",709666,15],["σου",711945,133],["ἐν",704639,0],["πάσῃ",710177,101],["τῇ",709436,100],["γῇ",703083,1]],"O Lord our Lord, how wonderful is thy name in all the earth!"]]