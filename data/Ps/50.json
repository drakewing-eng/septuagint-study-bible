[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, a Psalm of David,"],["2",[["ἐν",704639,0],["τῷ",709436,53],["ἐλθεῖν",705453,106],["πρὸς",710844,0],["αὐτὸν",702165,85],["Ναθαν",709164,6],["τὸν",709436,5],["προφήτην",711009,6],["ἡνίκα",706008,28],["εἰσῆλθεν",704114,2],["πρὸς",710844,0],["Βηρσαβεε",702702,9]],"when Nathan the prophet came to him, when he had gone in to Bersabee."],["3",[["ἐλέησόν",704418,176],["με",708618,163],["ὁ",709436,3],["θεός",706192,4],["κατὰ",707200,0],["τὸ",709436,24],["μέγα",708653,46],["ἔλεός",704426,25],["σου",711945,133],["καὶ",707031,7],["κατὰ",707200,0],["τὸ",709436,24],["πλῆθος",710529,25],["τῶν",709436,80],["οἰκτιρμῶν",709520,81],["σου",711945,133],["ἐξάλειψον",704852,176],["τὸ",709436,24],["ἀνόμημά",701191,25],["μου",709032,133]],"Have mercy upon me, O God, according to thy great mercy; and according to the multitude of thy compassions blot out my transgression."],["4",[["ἐπὶ",705080,0],["πλεῖον",710514,46],["πλῦνόν",710564,176],["με",708618,163],["ἀπὸ",701425,0],["τῆς",709436,16],["ἀνομίας",701192,17],["μου",709032,133],["καὶ",707031,7],["ἀπὸ",701425,0],["τῆς",709436,16],["ἁμαρτίας",700775,17],["μου",709032,133],["καθάρισόν",706985,176],["με",708618,163]],"Wash me thoroughly from mine iniquity, and cleanse me from my sin."],["5",[["ὅτι",709803,7],["τὴν",709436,8],["ἀνομίαν",701192,9],["μου",709032,133],["ἐγὼ",704018,164],["γινώσκω",703105,157],["καὶ",707031,7],["ἡ",709436,10],["ἁμαρτία",700775,12],["μου",709032,133],["ἐνώπιόν",704823,0],["μού",709032,133],["ἐστιν",704093,91],["διὰ",703417,0],["παντός",710177,116]],"For I am conscious of mine iniquity; and my sin is continually before me."],["6",[["σοὶ",711925,159],["μόνῳ",709003,30],["ἥμαρτον",700773,155],["καὶ",707031,7],["τὸ",709436,24],["πονηρὸν",710660,46],["ἐνώπιόν",704823,0],["σου",711945,133],["ἐποίησα",710582,155],["ὅπως",709719,7],["ἂν",700900,11],["δικαιωθῇς",703696,279],["ἐν",704639,0],["τοῖς",709436,147],["λόγοις",708236,148],["σου",711945,133],["καὶ",707031,7],["νικήσῃς",709309,175],["ἐν",704639,0],["τῷ",709436,53],["κρίνεσθαί",707905,110],["σε",711598,163]],"Against thee only have I sinned, and done evil before thee: that thou mightest be justified in thy sayings, and mightest overcome when thou art judged."],["7",[["ἰδοὺ",706497,88],["γὰρ",702963,11],["ἐν",704639,0],["ἀνομίαις",701192,76],["συνελήμφθην",712262,156],["καὶ",707031,7],["ἐν",704639,0],["ἁμαρτίαις",700775,76],["ἐκίσσησέν",707692,2],["με",708618,163],["ἡ",709436,10],["μήτηρ",708892,12],["μου",709032,133]],"For, behold, I was conceived in iniquities, and in sins did my mother conceive me."],["8",[["ἰδοὺ",706497,88],["γὰρ",702963,11],["ἀλήθειαν",700656,9],["ἠγάπησας",700120,162],["τὰ",709436,41],["ἄδηλα",700254,68],["καὶ",707031,7],["τὰ",709436,41],["κρύφια",707930,68],["τῆς",709436,16],["σοφίας",711981,17],["σου",711945,133],["ἐδήλωσάς",703402,162],["μοι",708974,159]],"For, behold, thou lovest truth: thou hast manifested to me the secret and hidden things of thy wisdom."],["9",[["ῥαντιεῖς",711177,166],["με",708618,163],["ὑσσώπῳ",713269,114],["καὶ",707031,7],["καθαρισθήσομαι",706985,180],["πλυνεῖς",710564,166],["με",708618,163],["καὶ",707031,7],["ὑπὲρ",713111,0],["χιόνα",713870,9],["λευκανθήσομαι",708162,180]],"Thou shalt sprinkle me with hyssop, and I shall be purified: thou shalt wash me, and I shall be made whiter than snow."],["10",[["ἀκουτιεῖς",700585,166],["με",708618,163],["ἀγαλλίασιν",700113,9],["καὶ",707031,7],["εὐφροσύνην",705717,9],["ἀγαλλιάσονται",700114,135],["ὀστᾶ",709792,64],["τεταπεινωμένα",712717,443]],"Thou shalt cause me to hear gladness and joy: the afflicted bones shall rejoice."],["11",[["ἀπόστρεψον",701598,176],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["ἀπὸ",701425,0],["τῶν",709436,130],["ἁμαρτιῶν",700775,65],["μου",709032,133],["καὶ",707031,7],["πάσας",710177,119],["τὰς",709436,38],["ἀνομίας",701192,39],["μου",709032,133],["ἐξάλειψον",704852,176]],"Turn away thy face from my sins, and blot out all mine iniquities."],["12",[["καρδίαν",707141,9],["καθαρὰν",706988,36],["κτίσον",707938,176],["ἐν",704639,0],["ἐμοί",704577,159],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["πνεῦμα",710566,25],["εὐθὲς",705596,46],["ἐγκαίνισον",703956,176],["ἐν",704639,0],["τοῖς",709436,147],["ἐγκάτοις",703970,96],["μου",709032,133]],"Create in me a clean heart, O God; and renew a right spirit in my inward parts."],["13",[["μὴ",708851,28],["ἀπορρίψῃς",701563,175],["με",708618,163],["ἀπὸ",701425,0],["τοῦ",709436,20],["προσώπου",710986,21],["σου",711945,133],["καὶ",707031,7],["τὸ",709436,24],["πνεῦμα",710566,25],["τὸ",709436,24],["ἅγιόν",700159,46],["σου",711945,133],["μὴ",708851,28],["ἀντανέλῃς",701212,279],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133]],"Cast me not away from thy presence; and remove not thy Holy Spirit from me."],["14",[["ἀπόδος",701449,176],["μοι",708974,159],["τὴν",709436,8],["ἀγαλλίασιν",700113,9],["τοῦ",709436,20],["σωτηρίου",712659,21],["σου",711945,133],["καὶ",707031,7],["πνεύματι",710566,54],["ἡγεμονικῷ",705929,97],["στήρισόν",712098,176],["με",708618,163]],"Restore to me the joy of thy salvation: establish me with thy directing Spirit."],["15",[["διδάξω",703649,165],["ἀνόμους",701194,60],["τὰς",709436,38],["ὁδούς",709458,39],["σου",711945,133],["καὶ",707031,7],["ἀσεβεῖς",701909,138],["ἐπὶ",705080,0],["σὲ",711598,163],["ἐπιστρέψουσιν",705278,218]],"[Then] will I teach transgressors thy ways; and ungodly men shall turn to thee."],["16",[["ῥῦσαί",711309,300],["με",708618,163],["ἐξ",704132,0],["αἱμάτων",700442,44],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["θεὸς",706192,4],["τῆς",709436,16],["σωτηρίας",712658,17],["μου",709032,133],["ἀγαλλιάσεται",700114,93],["ἡ",709436,10],["γλῶσσά",703120,12],["μου",709032,133],["τὴν",709436,8],["δικαιοσύνην",703695,9],["σου",711945,133]],"Deliver me from blood-guiltiness, O God, the God of my salvation: [and] my tongue shall joyfully declare thy righteousness."],["17",[["κύριε",707996,153],["τὰ",709436,41],["χείλη",713781,42],["μου",709032,133],["ἀνοίξεις",701186,166],["καὶ",707031,7],["τὸ",709436,34],["στόμα",712125,15],["μου",709032,133],["ἀναγγελεῖ",700921,127],["τὴν",709436,8],["αἴνεσίν",700457,9],["σου",711945,133]],"O Lord, thou shalt open my lips; and my mouth shall declare thy praise."],["18",[["ὅτι",709803,7],["εἰ",704071,7],["ἠθέλησας",706176,162],["θυσίαν",706345,9],["ἔδωκα",703654,155],["ἄν",700900,11],["ὁλοκαυτώματα",709589,42],["οὐκ",709805,28],["εὐδοκήσεις",705565,166]],"For if thou desiredst sacrifice, I would have given [it]: thou wilt not take pleasure in whole-burnt-offerings."],["19",[["θυσία",706345,12],["τῷ",709436,113],["θεῷ",706192,114],["πνεῦμα",710566,15],["συντετριμμένον",712520,327],["καρδίαν",707141,9],["συντετριμμένην",712520,444],["καὶ",707031,7],["τεταπεινωμένην",712717,444],["ὁ",709436,3],["θεὸς",706192,4],["οὐκ",709805,28],["ἐξουθενώσει",704973,127]],"Sacrifice to God is a broken spirit: a broken and humbled heart God will not despise."],["20",[["ἀγάθυνον",700109,176],["κύριε",707996,153],["ἐν",704639,0],["τῇ",709436,100],["εὐδοκίᾳ",705566,1],["σου",711945,133],["τὴν",709436,8],["Σιων",711816,9],["καὶ",707031,7],["οἰκοδομηθήτω",709509,22],["τὰ",709436,63],["τείχη",712759,64],["Ιερουσαλημ",706644,17]],"Do good, O Lord, to Sion in thy good pleasure; and let the walls of Jerusalem be built."],["21",[["τότε",712908,28],["εὐδοκήσεις",705565,166],["θυσίαν",706345,9],["δικαιοσύνης",703695,17],["ἀναφορὰν",701085,9],["καὶ",707031,7],["ὁλοκαυτώματα",709589,42],["τότε",712908,28],["ἀνοίσουσιν",701083,218],["ἐπὶ",705080,0],["τὸ",709436,24],["θυσιαστήριόν",706348,25],["σου",711945,133],["μόσχους",709029,57]],"Then shalt thou be pleased with a sacrifice of righteousness, offering, and whole-burnt-sacrifices: then shall they offer calves upon thine altar."]]