[["1",[["εἰς",704105,0],["Σαλωμων",711430,6],["ὁ",709436,3],["θεός",706192,4],["τὸ",709436,24],["κρίμα",707903,25],["σου",711945,133],["τῷ",709436,113],["βασιλεῖ",702580,114],["δὸς",703654,176],["καὶ",707031,7],["τὴν",709436,8],["δικαιοσύνην",703695,9],["σου",711945,133],["τῷ",709436,113],["υἱῷ",713075,114],["τοῦ",709436,35],["βασιλέως",702580,18]],"For Solomon. O God, give thy judgment to the king, and thy righteousness to the king's son;"],["2",[["κρίνειν",707905,55],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133],["ἐν",704639,0],["δικαιοσύνῃ",703695,1],["καὶ",707031,7],["τοὺς",709436,58],["πτωχούς",711076,57],["σου",711945,133],["ἐν",704639,0],["κρίσει",707908,1]],"[that he may] judge thy people with righteousness, and thy poor with judgment."],["3",[["ἀναλαβέτω",700984,45],["τὰ",709436,63],["ὄρη",709768,64],["εἰρήνην",704098,9],["τῷ",709436,113],["λαῷ",708094,114],["σου",711945,133],["καὶ",707031,7],["οἱ",709436,136],["βουνοὶ",702797,52],["ἐν",704639,0],["δικαιοσύνῃ",703695,1]],"Let the mountains and the hills raise peace to thy people:"],["4",[["κρινεῖ",707905,127],["τοὺς",709436,58],["πτωχοὺς",711076,57],["τοῦ",709436,35],["λαοῦ",708094,18],["καὶ",707031,7],["σώσει",712627,127],["τοὺς",709436,58],["υἱοὺς",713075,57],["τῶν",709436,80],["πενήτων",710248,81],["καὶ",707031,7],["ταπεινώσει",712719,1],["συκοφάντην",712257,6]],"he shall judge the poor of the people in righteousness, and save the children of the needy; and shall bring low the false accuser."],["5",[["καὶ",707031,7],["συμπαραμενεῖ",712321,127],["τῷ",709436,113],["ἡλίῳ",705974,114],["καὶ",707031,7],["πρὸ",710747,0],["τῆς",709436,16],["σελήνης",711650,17],["γενεὰς",703037,39],["γενεῶν",703037,65]],"And he shall continue as long as the sun, and before the moon for ever."],["6",[["καὶ",707031,7],["καταβήσεται",707202,93],["ὡς",714148,7],["ὑετὸς",713074,4],["ἐπὶ",705080,0],["πόκον",710600,6],["καὶ",707031,7],["ὡσεὶ",714159,7],["σταγόνες",712036,191],["στάζουσαι",712038,306],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9]],"He shall come down as rain upon a fleece; and as drops falling upon the earth."],["7",[["ἀνατελεῖ",701066,127],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["αὐτοῦ",702165,102],["δικαιοσύνη",703695,12],["καὶ",707031,7],["πλῆθος",710529,15],["εἰρήνης",704098,17],["ἕως",705792,0],["οὗ",709781,48],["ἀνταναιρεθῇ",701212,384],["ἡ",709436,10],["σελήνη",711650,12]],"In his days shall righteousness spring up; and abundance of peace till the moon be removed."],["8",[["καὶ",707031,7],["κατακυριεύσει",707297,127],["ἀπὸ",701425,0],["θαλάσσης",706069,17],["ἕως",705792,0],["θαλάσσης",706069,17],["καὶ",707031,7],["ἀπὸ",701425,0],["ποταμοῦ",710693,18],["ἕως",705792,0],["περάτων",710281,44],["τῆς",709436,16],["οἰκουμένης",709517,422]],"And he shall have dominion from sea to sea, and from the river to the ends of the earth."],["9",[["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["προπεσοῦνται",710837,135],["Αἰθίοπες",700420,52],["καὶ",707031,7],["οἱ",709436,136],["ἐχθροὶ",705779,52],["αὐτοῦ",702165,102],["χοῦν",713930,6],["λείξουσιν",708139,218]],"The Ethiopians shall fall down before him; and his enemies shall lick the dust."],["10",[["βασιλεῖς",702580,52],["Θαρσις",706124,118],["καὶ",707031,7],["αἱ",709436,190],["νῆσοι",709302,191],["δῶρα",703907,42],["προσοίσουσιν",710974,218],["βασιλεῖς",702580,52],["Ἀράβων",701694,286],["καὶ",707031,7],["Σαβα",711332,118],["δῶρα",703907,42],["προσάξουσιν",710848,218]],"The kings of Tharsis, and the isles, shall bring presents: the kings of the Arabians and Saba shall offer gifts."],["11",[["καὶ",707031,7],["προσκυνήσουσιν",710925,218],["αὐτῷ",702165,50],["πάντες",710177,138],["οἱ",709436,136],["βασιλεῖς",702580,52],["πάντα",710177,195],["τὰ",709436,63],["ἔθνη",704068,64],["δουλεύσουσιν",703814,218],["αὐτῷ",702165,50]],"And all kings shall worship him; all the Gentiles shall serve him."],["12",[["ὅτι",709803,7],["ἐρρύσατο",711309,23],["πτωχὸν",711076,6],["ἐκ",704132,0],["χειρὸς",713787,17],["δυνάστου",703844,18],["καὶ",707031,7],["πένητα",710248,6],["ᾧ",709781,309],["οὐχ",709805,28],["ὑπῆρχεν",713104,13],["βοηθός",702748,4]],"For he has delivered the poor from the oppressor; and the needy who had no helper."],["13",[["φείσεται",713406,93],["πτωχοῦ",711076,18],["καὶ",707031,7],["πένητος",710248,18],["καὶ",707031,7],["ψυχὰς",714070,39],["πενήτων",710248,81],["σώσει",712627,127]],"He shall spare the poor and needy, and shall deliver the souls of the needy."],["14",[["ἐκ",704132,0],["τόκου",712882,18],["καὶ",707031,7],["ἐξ",704132,0],["ἀδικίας",700271,17],["λυτρώσεται",708282,93],["τὰς",709436,38],["ψυχὰς",714070,39],["αὐτῶν",702165,40],["καὶ",707031,7],["ἔντιμον",704798,26],["τὸ",709436,34],["ὄνομα",709666,15],["αὐτῶν",702165,40],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102]],"He shall redeem their souls from usury and injustice: and their name [shall be] precious before him."],["15",[["καὶ",707031,7],["ζήσεται",705851,93],["καὶ",707031,7],["δοθήσεται",703654,134],["αὐτῷ",702165,50],["ἐκ",704132,0],["τοῦ",709436,20],["χρυσίου",713972,21],["τῆς",709436,16],["Ἀραβίας",701673,17],["καὶ",707031,7],["προσεύξονται",710893,135],["περὶ",710285,0],["αὐτοῦ",702165,102],["διὰ",703417,0],["παντός",710177,116],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["εὐλογήσουσιν",705631,218],["αὐτόν",702165,85]],"And he shall live, and there shall be given him of the gold of Arabia: and [men] shall pray for him continually; [and] all the day shall they praise him."],["16",[["ἔσται",704093,93],["στήριγμα",712097,15],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ἐπ᾿",705080,0],["ἄκρων",700608,169],["τῶν",709436,43],["ὀρέων",709768,44],["ὑπεραρθήσεται",713116,134],["ὑπὲρ",713111,0],["τὸν",709436,5],["Λίβανον",708185,6],["ὁ",709436,3],["καρπὸς",707169,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐξανθήσουσιν",704864,218],["ἐκ",704132,0],["πόλεως",710612,17],["ὡσεὶ",714159,7],["χόρτος",713923,4],["τῆς",709436,16],["γῆς",703083,17]],"There shall be an establishment on the earth on the tops of the mountains: the fruit thereof shall be exalted above Libanus, and they of the city shall flourish as grass of the earth."],["17",[["ἔστω",704093,31],["τὸ",709436,34],["ὄνομα",709666,15],["αὐτοῦ",702165,102],["εὐλογημένον",705631,413],["εἰς",704105,0],["τοὺς",709436,58],["αἰῶνας",700504,57],["πρὸ",710747,0],["τοῦ",709436,35],["ἡλίου",705974,18],["διαμενεῖ",703517,127],["τὸ",709436,34],["ὄνομα",709666,15],["αὐτοῦ",702165,102],["καὶ",707031,7],["εὐλογηθήσονται",705631,144],["ἐν",704639,0],["αὐτῷ",702165,50],["πᾶσαι",710177,192],["αἱ",709436,190],["φυλαὶ",713620,191],["τῆς",709436,16],["γῆς",703083,17],["πάντα",710177,195],["τὰ",709436,63],["ἔθνη",704068,64],["μακαριοῦσιν",708396,218],["αὐτόν",702165,85]],"Let his name be blessed for ever: his name shall endure longer than the sun: and all the tribes of the earth shall be blessed in him: all nations shall call him blessed."],["18",[["εὐλογητὸς",705632,14],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ὁ",709436,3],["ποιῶν",710582,72],["θαυμάσια",706136,68],["μόνος",709003,14]],"Blessed is the Lord God of Israel, who alone does wonders."],["19",[["καὶ",707031,7],["εὐλογητὸν",705632,26],["τὸ",709436,34],["ὄνομα",709666,15],["τῆς",709436,16],["δόξης",703791,17],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18],["καὶ",707031,7],["πληρωθήσεται",710543,134],["τῆς",709436,16],["δόξης",703791,17],["αὐτοῦ",702165,102],["πᾶσα",710177,29],["ἡ",709436,10],["γῆ",703083,12],["γένοιτο",703104,382],["γένοιτο",703104,382]],"And blessed is his glorious name for ever, even for ever and ever: and all the earth shall be filled with his glory. So be it, so be it."],["20",[["ἐξέλιπον",704237,150],["οἱ",709436,136],["ὕμνοι",713089,52],["Δαυιδ",703232,18],["τοῦ",709436,35],["υἱοῦ",713075,18],["Ιεσσαι",706668,18]],"The hymns of David the son of Jessæ are ended."]]