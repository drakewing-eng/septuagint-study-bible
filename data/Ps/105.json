[["1",[["αλληλουια",700688,88],["ἐξομολογεῖσθε",704960,73],["τῷ",709436,113],["κυρίῳ",707996,114],["ὅτι",709803,7],["χρηστός",713958,14],["ὅτι",709803,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τὸ",709436,34],["ἔλεος",704426,15],["αὐτοῦ",702165,102]],"Alleluia. Give thanks to the Lord; for he is good: for his mercy [endures] for ever."],["2",[["τίς",712867,158],["λαλήσει",708071,127],["τὰς",709436,38],["δυναστείας",703841,39],["τοῦ",709436,35],["κυρίου",707996,18],["ἀκουστὰς",700584,119],["ποιήσει",710582,127],["πάσας",710177,119],["τὰς",709436,38],["αἰνέσεις",700457,39],["αὐτοῦ",702165,102]],"Who shall tell the mighty acts of the Lord? [who] shall cause all his praises to be heard?"],["3",[["μακάριοι",708397,138],["οἱ",709436,136],["φυλάσσοντες",713619,146],["κρίσιν",707908,9],["καὶ",707031,7],["ποιοῦντες",710582,146],["δικαιοσύνην",703695,9],["ἐν",704639,0],["παντὶ",710177,30],["καιρῷ",707047,114]],"Blessed are they that keep judgment, and do righteousness at all times."],["4",[["μνήσθητι",708960,176],["ἡμῶν",705999,145],["κύριε",707996,153],["ἐν",704639,0],["τῇ",709436,100],["εὐδοκίᾳ",705566,1],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133],["ἐπίσκεψαι",705250,300],["ἡμᾶς",705981,194],["ἐν",704639,0],["τῷ",709436,53],["σωτηρίῳ",712659,54],["σου",711945,133]],"Remember us, O Lord, with the favour [thou hast] to thy people: visit us with thy salvation;"],["5",[["τοῦ",709436,20],["ἰδεῖν",709725,106],["ἐν",704639,0],["τῇ",709436,100],["χρηστότητι",713959,1],["τῶν",709436,80],["ἐκλεκτῶν",704240,169],["σου",711945,133],["τοῦ",709436,20],["εὐφρανθῆναι",705715,179],["ἐν",704639,0],["τῇ",709436,100],["εὐφροσύνῃ",705717,1],["τοῦ",709436,20],["ἔθνους",704068,21],["σου",711945,133],["τοῦ",709436,20],["ἐπαινεῖσθαι",705000,110],["μετὰ",708780,0],["τῆς",709436,16],["κληρονομίας",707725,17],["σου",711945,133]],"that we may behold the good of thine elect, that we may rejoice in the gladness of thy nation, that we may glory with thine inheritance."],["6",[["ἡμάρτομεν",700773,289],["μετὰ",708780,0],["τῶν",709436,80],["πατέρων",710189,81],["ἡμῶν",705999,145],["ἠνομήσαμεν",701190,289],["ἠδικήσαμεν",700269,289]],"We have sinned with our fathers, we have transgressed, we have done unrighteously."],["7",[["οἱ",709436,136],["πατέρες",710189,52],["ἡμῶν",705999,145],["ἐν",704639,0],["Αἰγύπτῳ",700401,1],["οὐ",709805,28],["συνῆκαν",712481,150],["τὰ",709436,41],["θαυμάσιά",706136,68],["σου",711945,133],["οὐκ",709805,28],["ἐμνήσθησαν",708960,150],["τοῦ",709436,20],["πλήθους",710529,21],["τοῦ",709436,20],["ἐλέους",704426,42],["σου",711945,133],["καὶ",707031,7],["παρεπίκραναν",710087,150],["ἀναβαίνοντες",700905,146],["ἐν",704639,0],["τῇ",709436,100],["ἐρυθρᾷ",705447,101],["θαλάσσῃ",706069,1]],"Our fathers in Egypt understood not thy wonders, and remembered not the multitude of thy mercy; but provoked [him] as they went up by the Red Sea."],["8",[["καὶ",707031,7],["ἔσωσεν",712627,2],["αὐτοὺς",702165,62],["ἕνεκεν",704709,0],["τοῦ",709436,20],["ὀνόματος",709666,21],["αὐτοῦ",702165,102],["τοῦ",709436,20],["γνωρίσαι",703135,106],["τὴν",709436,8],["δυναστείαν",703841,9],["αὐτοῦ",702165,102]],"Yet he saved them for his name's sake, that he might cause his mighty power to be known."],["9",[["καὶ",707031,7],["ἐπετίμησεν",705305,2],["τῇ",709436,100],["ἐρυθρᾷ",705447,101],["θαλάσσῃ",706069,1],["καὶ",707031,7],["ἐξηράνθη",709419,37],["καὶ",707031,7],["ὡδήγησεν",709448,2],["αὐτοὺς",702165,62],["ἐν",704639,0],["ἀβύσσῳ",700098,1],["ὡς",714148,11],["ἐν",704639,0],["ἐρήμῳ",705420,1]],"And he rebuked the Red Sea, and it was dried up: so he led them through the deep as through the wilderness."],["10",[["καὶ",707031,7],["ἔσωσεν",712627,2],["αὐτοὺς",702165,62],["ἐκ",704132,0],["χειρὸς",713787,17],["μισούντων",708935,170],["καὶ",707031,7],["ἐλυτρώσατο",708282,23],["αὐτοὺς",702165,62],["ἐκ",704132,0],["χειρὸς",713787,17],["ἐχθροῦ",705779,18]],"And he saved them out of the hand of them that hated [them], and redeemed them out of the hand of the enemy."],["11",[["καὶ",707031,7],["ἐκάλυψεν",707102,2],["ὕδωρ",713071,15],["τοὺς",709436,58],["θλίβοντας",706274,235],["αὐτούς",702165,62],["εἷς",704106,14],["ἐξ",704132,0],["αὐτῶν",702165,40],["οὐχ",709805,28],["ὑπελείφθη",713212,37]],"The water covered those that oppressed them: there was not one of them left."],["12",[["καὶ",707031,7],["ἐπίστευσαν",710483,150],["ἐν",704639,0],["τοῖς",709436,147],["λόγοις",708236,148],["αὐτοῦ",702165,102],["καὶ",707031,7],["ᾖσαν",704094,137],["τὴν",709436,8],["αἴνεσιν",700457,9],["αὐτοῦ",702165,102]],"Then they believed his words, and celebrated his praise."],["13",[["ἐτάχυναν",712749,150],["ἐπελάθοντο",705187,189],["τῶν",709436,43],["ἔργων",705396,44],["αὐτοῦ",702165,102],["οὐχ",709805,28],["ὑπέμειναν",713219,150],["τὴν",709436,8],["βουλὴν",702792,9],["αὐτοῦ",702165,102]],"They made haste, they forgot his works; they waited not for his counsel."],["14",[["καὶ",707031,7],["ἐπεθύμησαν",705141,150],["ἐπιθυμίαν",705147,9],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["καὶ",707031,7],["ἐπείρασαν",710225,150],["τὸν",709436,5],["θεὸν",706192,6],["ἐν",704639,0],["ἀνύδρῳ",701285,30]],"And they lusted exceedingly in the wilderness, and tempted God in the dry [land]."],["15",[["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτοῖς",702165,151],["τὸ",709436,24],["αἴτημα",700490,25],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐξαπέστειλεν",704872,2],["πλησμονὴν",710549,9],["εἰς",704105,0],["τὰς",709436,38],["ψυχὰς",714070,39],["αὐτῶν",702165,40]],"And he gave them their request, and sent fulness into their souls."],["16",[["καὶ",707031,7],["παρώργισαν",710167,150],["Μωυσῆν",709112,6],["ἐν",704639,0],["τῇ",709436,100],["παρεμβολῇ",710133,1],["καὶ",707031,7],["Ααρων",700005,6],["τὸν",709436,5],["ἅγιον",700159,27],["κυρίου",707996,18]],"They provoked Moses also in the camp, and Aaron the holy one of the Lord."],["17",[["ἠνοίχθη",701186,37],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["κατέπιεν",707374,2],["Δαθαν",703244,4],["καὶ",707031,7],["ἐκάλυψεν",707102,2],["ἐπὶ",705080,0],["τὴν",709436,8],["συναγωγὴν",712376,9],["Αβιρων",700074,18]],"The earth opened and swallowed up Dathan, and closed upon the congregation of Abiron."],["18",[["καὶ",707031,7],["ἐξεκαύθη",704205,37],["πῦρ",711088,25],["ἐν",704639,0],["τῇ",709436,100],["συναγωγῇ",712376,1],["αὐτῶν",702165,40],["φλὸξ",713524,12],["κατέφλεξεν",707477,2],["ἁμαρτωλούς",700776,60]],"And a fire was kindled in their congregation, and a flame burnt up the sinners."],["19",[["καὶ",707031,7],["ἐποίησαν",710582,150],["μόσχον",709029,6],["ἐν",704639,0],["Χωρηβ",714013,111],["καὶ",707031,7],["προσεκύνησαν",710925,150],["τῷ",709436,113],["γλυπτῷ",703117,30]],"And they made a calf in Choreb, and worshipped the graven image,"],["20",[["καὶ",707031,7],["ἠλλάξαντο",700683,189],["τὴν",709436,8],["δόξαν",703791,9],["αὐτῶν",702165,40],["ἐν",704639,0],["ὁμοιώματι",709629,54],["μόσχου",709029,18],["ἔσθοντος",705495,152],["χόρτον",713923,6]],"and they changed their glory into the similitude of a calf that feeds on grass."],["21",[["ἐπελάθοντο",705187,189],["τοῦ",709436,35],["θεοῦ",706192,18],["τοῦ",709436,35],["σῴζοντος",712627,152],["αὐτούς",702165,62],["τοῦ",709436,35],["ποιήσαντος",710582,500],["μεγάλα",708653,68],["ἐν",704639,0],["Αἰγύπτῳ",700401,1]],"They forgot God that saved them, who had wrought great deeds in Egypt;"],["22",[["θαυμαστὰ",706138,68],["ἐν",704639,0],["γῇ",703083,1],["Χαμ",713699,118],["φοβερὰ",713530,68],["ἐπὶ",705080,0],["θαλάσσης",706069,17],["ἐρυθρᾶς",705447,82]],"wondrous [works] in the land of Cham, and terrible things at the Red Sea."],["23",[["καὶ",707031,7],["εἶπεν",705373,2],["τοῦ",709436,20],["ἐξολεθρεῦσαι",704956,106],["αὐτούς",702165,62],["εἰ",704071,7],["μὴ",708851,28],["Μωυσῆς",709112,4],["ὁ",709436,3],["ἐκλεκτὸς",704240,14],["αὐτοῦ",702165,102],["ἔστη",706846,2],["ἐν",704639,0],["τῇ",709436,100],["θραύσει",706301,1],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["τοῦ",709436,20],["ἀποστρέψαι",701598,106],["τὴν",709436,8],["ὀργὴν",709728,9],["αὐτοῦ",702165,102],["τοῦ",709436,20],["μὴ",708851,28],["ἐξολεθρεῦσαι",704956,106]],"So he said that he would have destroyed them, had not Moses his chosen stood before him in the breach, to turn [him] away from the fierceness of his anger, so that he should not destroy them."],["24",[["καὶ",707031,7],["ἐξουδένωσαν",704969,150],["γῆν",703083,9],["ἐπιθυμητήν",705144,36],["οὐκ",709805,28],["ἐπίστευσαν",710483,150],["τῷ",709436,113],["λόγῳ",708236,114],["αὐτοῦ",702165,102]],"Moreover they set at nought the desirable land, and believed not his word."],["25",[["καὶ",707031,7],["ἐγόγγυσαν",703144,150],["ἐν",704639,0],["τοῖς",709436,95],["σκηνώμασιν",711849,96],["αὐτῶν",702165,40],["οὐκ",709805,28],["εἰσήκουσαν",704108,150],["τῆς",709436,16],["φωνῆς",713640,17],["κυρίου",707996,18]],"And they murmured in their tents: they hearkened not to the voice of the Lord."],["26",[["καὶ",707031,7],["ἐπῆρεν",705002,2],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["αὐτοῖς",702165,151],["τοῦ",709436,20],["καταβαλεῖν",707203,296],["αὐτοὺς",702165,62],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1]],"So he lifted up his hand against them, to cast them down in the wilderness;"],["27",[["καὶ",707031,7],["τοῦ",709436,20],["καταβαλεῖν",707203,296],["τὸ",709436,24],["σπέρμα",712008,25],["αὐτῶν",702165,40],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["καὶ",707031,7],["διασκορπίσαι",703579,106],["αὐτοὺς",702165,62],["ἐν",704639,0],["ταῖς",709436,75],["χώραις",714011,76]],"and to cast down their seed among the nations, and to scatter them in the countries."],["28",[["καὶ",707031,7],["ἐτελέσθησαν",712783,99],["τῷ",709436,113],["Βεελφεγωρ",702627,114],["καὶ",707031,7],["ἔφαγον",713296,150],["θυσίας",706345,17],["νεκρῶν",709247,81]],"They were joined also to Beelphegor, and ate the sacrifices of the dead. And they provoked him with their devices;"],["29",[["καὶ",707031,7],["παρώξυναν",710164,150],["αὐτὸν",702165,85],["ἐν",704639,0],["τοῖς",709436,95],["ἐπιτηδεύμασιν",705301,96],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπληθύνθη",710530,37],["ἐν",704639,0],["αὐτοῖς",702165,151],["ἡ",709436,10],["πτῶσις",711072,12]],"and destruction was multiplied among them."],["30",[["καὶ",707031,7],["ἔστη",706846,2],["Φινεες",713510,4],["καὶ",707031,7],["ἐξιλάσατο",704932,23],["καὶ",707031,7],["ἐκόπασεν",707819,2],["ἡ",709436,10],["θραῦσις",706301,12]],"Then Phinees stood up, and made atonement: and the plague ceased."],["31",[["καὶ",707031,7],["ἐλογίσθη",708232,37],["αὐτῷ",702165,50],["εἰς",704105,0],["δικαιοσύνην",703695,9],["εἰς",704105,0],["γενεὰν",703037,9],["καὶ",707031,7],["γενεὰν",703037,9],["ἕως",705792,0],["τοῦ",709436,35],["αἰῶνος",700504,18]],"And it was counted to him for righteousness, to all generations for ever."],["32",[["καὶ",707031,7],["παρώργισαν",710167,150],["αὐτὸν",702165,85],["ἐφ᾿",705080,0],["ὕδατος",713071,21],["ἀντιλογίας",701249,17],["καὶ",707031,7],["ἐκακώθη",707073,37],["Μωυσῆς",709112,4],["δι᾿",703417,0],["αὐτούς",702165,62]],"They provoked him also at the water of Strife, and Moses was hurt for their sakes;"],["33",[["ὅτι",709803,7],["παρεπίκραναν",710087,150],["τὸ",709436,24],["πνεῦμα",710566,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["διέστειλεν",703588,2],["ἐν",704639,0],["τοῖς",709436,95],["χείλεσιν",713781,96],["αὐτοῦ",702165,102]],"for they provoked his spirit, and he spoke [unadvisedly] with his lips."],["34",[["οὐκ",709805,28],["ἐξωλέθρευσαν",704956,150],["τὰ",709436,41],["ἔθνη",704068,42],["ἃ",709781,69],["εἶπεν",705373,2],["κύριος",707996,4],["αὐτοῖς",702165,206]],"They destroyed not the nations which the Lord told them [to destroy];"],["35",[["καὶ",707031,7],["ἐμίγησαν",708911,99],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["καὶ",707031,7],["ἔμαθον",708480,150],["τὰ",709436,41],["ἔργα",705396,42],["αὐτῶν",702165,40]],"but were mingled with the heathen, and learned their works."],["36",[["καὶ",707031,7],["ἐδούλευσαν",703814,150],["τοῖς",709436,147],["γλυπτοῖς",703117,230],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐγενήθη",703104,37],["αὐτοῖς",702165,151],["εἰς",704105,0],["σκάνδαλον",711825,25]],"And they served their graven images; and it became an offence to them."],["37",[["καὶ",707031,7],["ἔθυσαν",706349,150],["τοὺς",709436,58],["υἱοὺς",713075,57],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰς",709436,38],["θυγατέρας",706320,39],["αὐτῶν",702165,40],["τοῖς",709436,147],["δαιμονίοις",703249,96]],"And they sacrificed their sons and their daughters to devils,"],["38",[["καὶ",707031,7],["ἐξέχεαν",704368,150],["αἷμα",700442,25],["ἀθῷον",700390,46],["αἷμα",700442,25],["υἱῶν",713075,81],["αὐτῶν",702165,40],["καὶ",707031,7],["θυγατέρων",706320,65],["ὧν",709781,199],["ἔθυσαν",706349,150],["τοῖς",709436,147],["γλυπτοῖς",703117,230],["Χανααν",713708,17],["καὶ",707031,7],["ἐφονοκτονήθη",713547,37],["ἡ",709436,10],["γῆ",703083,12],["ἐν",704639,0],["τοῖς",709436,95],["αἵμασιν",700442,96]],"and shed innocent blood, the blood of their sons and daughters, whom they sacrificed to the idols of Chanaan; and the land was defiled with blood,"],["39",[["καὶ",707031,7],["ἐμιάνθη",708900,37],["ἐν",704639,0],["τοῖς",709436,95],["ἔργοις",705396,96],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπόρνευσαν",710674,150],["ἐν",704639,0],["τοῖς",709436,95],["ἐπιτηδεύμασιν",705301,96],["αὐτῶν",702165,40]],"and was polluted with their works; and they went a whoring with their own devices."],["40",[["καὶ",707031,7],["ὠργίσθη",709729,37],["θυμῷ",706334,114],["κύριος",707996,4],["ἐπὶ",705080,0],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐβδελύξατο",702608,23],["τὴν",709436,8],["κληρονομίαν",707725,9],["αὐτοῦ",702165,102]],"So the Lord was very angry with his people, and he abhorred his inheritance."],["41",[["καὶ",707031,7],["παρέδωκεν",710014,2],["αὐτοὺς",702165,62],["εἰς",704105,0],["χεῖρας",713787,39],["ἐθνῶν",704068,44],["καὶ",707031,7],["ἐκυρίευσαν",707995,150],["αὐτῶν",702165,40],["οἱ",709436,136],["μισοῦντες",708935,146],["αὐτούς",702165,62]],"And he delivered them into the hands of [their] enemies; and they that hated them ruled over them."],["42",[["καὶ",707031,7],["ἔθλιψαν",706274,150],["αὐτοὺς",702165,62],["οἱ",709436,136],["ἐχθροὶ",705779,52],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐταπεινώθησαν",712717,99],["ὑπὸ",713184,0],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτῶν",702165,40]],"And their enemies oppressed them, and they were brought down under their hands."],["43",[["πλεονάκις",710517,28],["ἐρρύσατο",711309,23],["αὐτούς",702165,62],["αὐτοὶ",702165,201],["δὲ",703303,11],["παρεπίκραναν",710087,150],["αὐτὸν",702165,85],["ἐν",704639,0],["τῇ",709436,100],["βουλῇ",702792,1],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐταπεινώθησαν",712717,99],["ἐν",704639,0],["ταῖς",709436,75],["ἀνομίαις",701192,76],["αὐτῶν",702165,40]],"Many a time he delivered them; but they provoked him by their counsel, and they were brought low by their iniquities."],["44",[["καὶ",707031,7],["εἶδεν",709725,2],["ἐν",704639,0],["τῷ",709436,53],["θλίβεσθαι",706274,110],["αὐτοὺς",702165,62],["ἐν",704639,0],["τῷ",709436,113],["αὐτὸν",702165,85],["εἰσακοῦσαι",704108,106],["τῆς",709436,16],["δεήσεως",703311,17],["αὐτῶν",702165,40]],"Yet the Lord looked upon their affliction, when he heard their petition."],["45",[["καὶ",707031,7],["ἐμνήσθη",708960,2],["τῆς",709436,16],["διαθήκης",703456,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["μετεμελήθη",708805,2],["κατὰ",707200,0],["τὸ",709436,24],["πλῆθος",710529,25],["τοῦ",709436,20],["ἐλέους",704426,21],["αὐτοῦ",702165,102]],"And he remembered his covenant, and repented according to the multitude of his mercy."],["46",[["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτοὺς",702165,62],["εἰς",704105,0],["οἰκτιρμοὺς",709520,57],["ἐναντίον",704654,0],["πάντων",710177,169],["τῶν",709436,80],["αἰχμαλωτισάντων",700501,221],["αὐτούς",702165,62]],"And he caused them to be pitied in the sight of all who carried them captive."],["47",[["σῶσον",712627,176],["ἡμᾶς",705981,194],["κύριε",707996,153],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],[