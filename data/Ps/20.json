[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, a Psalm of David."],["2",[["κύριε",707996,153],["ἐν",704639,0],["τῇ",709436,100],["δυνάμει",703839,1],["σου",711945,133],["εὐφρανθήσεται",705715,134],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["ἐπὶ",705080,0],["τῷ",709436,53],["σωτηρίῳ",712659,54],["σου",711945,133],["ἀγαλλιάσεται",700114,93],["σφόδρα",712586,28]],"O Lord, the king shall rejoice in thy strength; and in thy salvation he shall greatly exult."],["3",[["τὴν",709436,8],["ἐπιθυμίαν",705147,9],["τῆς",709436,16],["ψυχῆς",714070,17],["αὐτοῦ",702165,102],["ἔδωκας",703654,162],["αὐτῷ",702165,50],["καὶ",707031,7],["τὴν",709436,8],["θέλησιν",706172,9],["τῶν",709436,43],["χειλέων",713781,44],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐστέρησας",712076,162],["αὐτόν",702165,85],["διάψαλμα",703641,15]],"Thou hast granted him the desire of his soul, and hast not withheld from him the request of his lips. Pause."],["4",[["ὅτι",709803,7],["προέφθασας",711011,162],["αὐτὸν",702165,85],["ἐν",704639,0],["εὐλογίαις",705633,76],["χρηστότητος",713959,17],["ἔθηκας",712849,162],["ἐπὶ",705080,0],["τὴν",709436,8],["κεφαλὴν",707639,9],["αὐτοῦ",702165,102],["στέφανον",712083,6],["ἐκ",704132,0],["λίθου",708196,18],["τιμίου",712858,116]],"For thou hast prevented him with blessings of goodness: thou hast set upon his head a crown of precious stone."],["5",[["ζωὴν",705910,9],["ᾐτήσατό",700489,23],["σε",711598,163],["καὶ",707031,7],["ἔδωκας",703654,162],["αὐτῷ",702165,50],["μακρότητα",708423,9],["ἡμερῶν",705984,65],["εἰς",704105,0],["αἰῶνα",700504,6],["αἰῶνος",700504,18]],"He asked life of thee, and thou gavest him length of days for ever and ever."],["6",[["μεγάλη",708653,29],["ἡ",709436,10],["δόξα",703791,12],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,53],["σωτηρίῳ",712659,54],["σου",711945,133],["δόξαν",703791,9],["καὶ",707031,7],["μεγαλοπρέπειαν",708632,9],["ἐπιθήσεις",705304,166],["ἐπ᾿",705080,0],["αὐτόν",702165,85]],"His glory is great in thy salvation: thou wilt crown him with glory and majesty."],["7",[["ὅτι",709803,7],["δώσεις",703654,166],["αὐτῷ",702165,50],["εὐλογίαν",705633,9],["εἰς",704105,0],["αἰῶνα",700504,6],["αἰῶνος",700504,18],["εὐφρανεῖς",705715,166],["αὐτὸν",702165,85],["ἐν",704639,0],["χαρᾷ",713719,1],["μετὰ",708780,0],["τοῦ",709436,20],["προσώπου",710986,21],["σου",711945,133]],"For thou wilt give him a blessing for ever and ever: thou wilt gladden him with joy with thy countenance."],["8",[["ὅτι",709803,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐλπίζει",704529,91],["ἐπὶ",705080,0],["κύριον",707996,6],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἐλέει",704426,54],["τοῦ",709436,35],["ὑψίστου",713287,116],["οὐ",709805,28],["μὴ",708851,28],["σαλευθῇ",711403,384]],"For the king trusts in the Lord, and through the mercy of the Highest he shall not be moved."],["9",[["εὑρεθείη",705676,528],["ἡ",709436,10],["χείρ",713787,12],["σου",711945,133],["πᾶσιν",710177,230],["τοῖς",709436,147],["ἐχθροῖς",705779,148],["σου",711945,133],["ἡ",709436,10],["δεξιά",703360,29],["σου",711945,133],["εὕροι",705676,225],["πάντας",710177,60],["τοὺς",709436,58],["μισοῦντάς",708935,235],["σε",711598,163]],"Let thy hand be found by all thine enemies: let thy right hand find all that hate thee."],["10",[["θήσεις",712849,166],["αὐτοὺς",702165,62],["ὡς",714148,7],["κλίβανον",707733,6],["πυρὸς",711088,21],["εἰς",704105,0],["καιρὸν",707047,6],["τοῦ",709436,20],["προσώπου",710986,21],["σου",711945,133],["κύριος",707996,4],["ἐν",704639,0],["ὀργῇ",709728,1],["αὐτοῦ",702165,102],["συνταράξει",712507,127],["αὐτούς",702165,62],["καὶ",707031,7],["καταφάγεται",707519,93],["αὐτοὺς",702165,62],["πῦρ",711088,15]],"Thou shalt make them as a fiery oven at the time of thy presence: the Lord shall trouble them in his anger, and fire shall devour them."],["11",[["τὸν",709436,5],["καρπὸν",707169,6],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["γῆς",703083,17],["ἀπολεῖς",701513,166],["καὶ",707031,7],["τὸ",709436,24],["σπέρμα",712008,25],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["υἱῶν",713075,81],["ἀνθρώπων",701163,81]],"Thou shalt destroy their fruit from the earth, and their seed from [among] the sons of men."],["12",[["ὅτι",709803,7],["ἔκλιναν",707738,150],["εἰς",704105,0],["σὲ",711598,163],["κακά",707066,195],["διελογίσαντο",703505,189],["βουλήν",702792,9],["ἣν",709781,131],["οὐ",709805,28],["μὴ",708851,28],["δύνωνται",703838,380],["στῆσαι",706846,106]],"For they intended evils against thee; they imagined a device which they shall by no means be able to perform."],["13",[["ὅτι",709803,7],["θήσεις",712849,166],["αὐτοὺς",702165,62],["νῶτον",709403,25],["ἐν",704639,0],["τοῖς",709436,147],["περιλοίποις",710345,230],["σου",711945,133],["ἑτοιμάσεις",705539,166],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτῶν",702165,40]],"For thou shalt make them [turn their] back in thy latter end, thou wilt prepare their face."],["14",[["ὑψώθητι",713289,244],["κύριε",707996,153],["ἐν",704639,0],["τῇ",709436,100],["δυνάμει",703839,1],["σου",711945,133],["ᾄσομεν",700299,141],["καὶ",707031,7],["ψαλοῦμεν",714021,275],["τὰς",709436,38],["δυναστείας",703841,39],["σου",711945,133]],"Be thou exalted, O Lord, in thy strength: we will sing and praise thy mighty acts."]]