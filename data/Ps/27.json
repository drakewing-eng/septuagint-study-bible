,42],["αὐτῶν",702165,40],["καὶ",707031,7],["κατὰ",707200,0],["τὴν",709436,8],["πονηρίαν",710659,9],["τῶν",709436,43],["ἐπιτηδευμάτων",705301,44],["αὐτῶν",702165,40],["κατὰ",707200,0],["τὰ",709436,41],["ἔργα",705396,42],["τῶν",709436,130],["χειρῶν",713787,65],["αὐτῶν",702165,40],["δὸς",703654,176],["αὐτοῖς",702165,151],["ἀπόδος",701449,176],["τὸ",709436,24],["ἀνταπόδομα",701216,25],["αὐτῶν",702165,40],["αὐτοῖς",702165,151]],"Give them according to their works, and according to the wickedness of their devices: give them according to the works of their hands; render their recompence unto them."],["5",[["ὅτι",709803,7],["οὐ",709805,28],["συνῆκαν",712481,150],["εἰς",704105,0],["τὰ",709436,41],["ἔργα",705396,42],["κυρίου",707996,18],["καὶ",707031,7],["εἰς",704105,0],["τὰ",709436,41],["ἔργα",705396,42],["τῶν",709436,130],["χειρῶν",713787,65],["αὐτοῦ",702165,102],["καθελεῖς",706982,166],["αὐτοὺς",702165,62],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["οἰκοδομήσεις",709509,166],["αὐτούς",702165,62]],"Because they have not attended to the works of the Lord, even to the works of his hands, thou shalt pull them down, and shalt not build them up."],["6",[["εὐλογητὸς",705632,14],["κύριος",707996,4],["ὅτι",709803,7],["εἰσήκουσεν",704108,2],["τῆς",709436,16],["φωνῆς",713640,17],["τῆς",709436,16],["δεήσεώς",703311,17],["μου",709032,133]],"Blessed be the Lord, for he has hearkened to the voice of my petition."],["7",[["κύριος",707996,4],["βοηθός",702748,4],["μου",709032,133],["καὶ",707031,7],["ὑπερασπιστής",713123,4],["μου",709032,133],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["ἤλπισεν",704529,2],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["καὶ",707031,7],["ἐβοηθήθην",702746,156],["καὶ",707031,7],["ἀνέθαλεν",700949,2],["ἡ",709436,10],["σάρξ",711537,12],["μου",709032,133],["καὶ",707031,7],["ἐκ",704132,0],["θελήματός",706170,21],["μου",709032,133],["ἐξομολογήσομαι",704960,181],["αὐτῷ",702165,50]],"The Lord is my helper and my defender; my heart has hoped in him, and I am helped: my flesh has revived, and willingly will I give praise to him."],["8",[["κύριος",707996,4],["κραταίωμα",707876,15],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὑπερασπιστὴς",713123,4],["τῶν",709436,43],["σωτηρίων",712659,44],["τοῦ",709436,35],["χριστοῦ",713964,116],["αὐτοῦ",702165,102],["ἐστιν",704093,91]],"The Lord is the strength of his people, and the saving defender of his anointed."],["9",[["σῶσον",712627,176],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133],["καὶ",707031,7],["εὐλόγησον",705631,176],["τὴν",709436,8],["κληρονομίαν",707725,9],["σου",711945,133],["καὶ",707031,7],["ποίμανον",710594,176],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἔπαρον",705002,176],["αὐτοὺς",702165,62],["ἕως",705792,0],["τοῦ",709436,35],["αἰῶνος",700504,18]],"Save thy people, and bless thine inheritance: and take care of them, and lift them up for ever."]]