[["1",[["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114],["ὁ",709436,3],["κύριος",707996,4],["ἐβασίλευσεν",702581,2],["ὀργιζέσθωσαν",709729,77],["λαοί",708094,52],["ὁ",709436,3],["καθήμενος",707000,122],["ἐπὶ",705080,0],["τῶν",709436,43],["χερουβιν",713830,44],["σαλευθήτω",711403,22],["ἡ",709436,10],["γῆ",703083,12]],"A Psalm of David. The Lord reigns;—let the people rage; [it is he] that sits upon the cherubs, let the earth be moved."],["2",[["κύριος",707996,4],["ἐν",704639,0],["Σιων",711816,1],["μέγας",708653,14],["καὶ",707031,7],["ὑψηλός",713285,14],["ἐστιν",704093,91],["ἐπὶ",705080,0],["πάντας",710177,60],["τοὺς",709436,58],["λαούς",708094,57]],"The Lord is great in Sion, and is high over all the people."],["3",[["ἐξομολογησάσθωσαν",704960,486],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133],["τῷ",709436,113],["μεγάλῳ",708653,30],["ὅτι",709803,7],["φοβερὸν",713530,26],["καὶ",707031,7],["ἅγιόν",700159,26],["ἐστιν",704093,91]],"Let them give thanks to thy great name; for it is terrible and holy."],["4",[["καὶ",707031,7],["τιμὴ",712856,12],["βασιλέως",702580,18],["κρίσιν",707908,9],["ἀγαπᾷ",700120,91],["σὺ",712181,164],["ἡτοίμασας",705539,162],["εὐθύτητας",705603,39],["κρίσιν",707908,9],["καὶ",707031,7],["δικαιοσύνην",703695,9],["ἐν",704639,0],["Ιακωβ",706401,114],["σὺ",712181,164],["ἐποίησας",710582,162]],"And the king's honour loves judgment; thou hast prepared equity, thou hast wrought judgment and justice in Jacob."],["5",[["ὑψοῦτε",713289,335],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["ἡμῶν",705999,145],["καὶ",707031,7],["προσκυνεῖτε",710925,335],["τῷ",709436,53],["ὑποποδίῳ",713233,54],["τῶν",709436,80],["ποδῶν",710707,81],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ἅγιός",700159,14],["ἐστιν",704093,91]],"Exalt ye the Lord our God, and worship [at] his footstool; for he is holy."],["6",[["Μωυσῆς",709112,4],["καὶ",707031,7],["Ααρων",700005,4],["ἐν",704639,0],["τοῖς",709436,147],["ἱερεῦσιν",706614,148],["αὐτοῦ",702165,102],["καὶ",707031,7],["Σαμουηλ",711473,4],["ἐν",704639,0],["τοῖς",709436,147],["ἐπικαλουμένοις",705153,341],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["ἐπεκαλοῦντο",705153,139],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["αὐτὸς",702165,121],["ἐπήκουσεν",705009,2],["αὐτῶν",702165,40]],"Moses and Aaron among his priests, and Samuel among them that call upon his name; they called upon the Lord, and he heard them."],["7",[["ἐν",704639,0],["στύλῳ",712179,114],["νεφέλης",709277,17],["ἐλάλει",708071,13],["πρὸς",710844,0],["αὐτούς",702165,62],["ἐφύλασσον",713619,137],["τὰ",709436,41],["μαρτύρια",708525,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["προστάγματα",710959,42],["ἃ",709781,69],["ἔδωκεν",703654,2],["αὐτοῖς",702165,151]],"He spoke to them in a pillar of cloud; they kept his testimonies, and the ordinances which he gave them."],["8",[["κύριε",707996,153],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["σὺ",712181,164],["ἐπήκουες",705009,363],["αὐτῶν",702165,40],["ὁ",709436,3],["θεός",706192,4],["σὺ",712181,164],["εὐίλατος",705608,14],["ἐγίνου",703104,497],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἐκδικῶν",704174,72],["ἐπὶ",705080,0],["πάντα",710177,68],["τὰ",709436,41],["ἐπιτηδεύματα",705301,42],["αὐτῶν",702165,40]],"O Lord our God, thou heardest them; O God, thou becamest propitious to them, though thou didst take vengeance on all their devices."],["9",[["ὑψοῦτε",713289,335],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["ἡμῶν",705999,145],["καὶ",707031,7],["προσκυνεῖτε",710925,87],["εἰς",704105,0],["ὄρος",709768,25],["ἅγιον",700159,27],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ἅγιος",700159,14],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145]],"Exalt ye the Lord our God, and worship at his holy mountain; for the Lord our God is holy."]]