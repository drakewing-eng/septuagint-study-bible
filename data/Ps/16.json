[["1",[["προσευχὴ",710892,12],["τοῦ",709436,35],["Δαυιδ",703232,18],["εἰσάκουσον",704108,176],["κύριε",707996,153],["τῆς",709436,16],["δικαιοσύνης",703695,17],["μου",709032,133],["πρόσχες",710895,176],["τῇ",709436,100],["δεήσει",703311,1],["μου",709032,133],["ἐνώτισαι",704825,106],["τῆς",709436,16],["προσευχῆς",710892,17],["μου",709032,133],["οὐκ",709805,28],["ἐν",704639,0],["χείλεσιν",713781,96],["δολίοις",703783,94]],"A Prayer of David. Hearken, O Lord of my righteousness, attend to my petition; give ear to my prayer not [uttered] with deceitful lips."],["2",[["ἐκ",704132,0],["προσώπου",710986,21],["σου",711945,133],["τὸ",709436,34],["κρίμα",707903,15],["μου",709032,133],["ἐξέλθοι",704909,225],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["μου",709032,133],["ἰδέτωσαν",709725,264],["εὐθύτητας",705603,39]],"Let my judgment come forth from thy presence; let mine eyes behold righteousness."],["3",[["ἐδοκίμασας",703776,162],["τὴν",709436,8],["καρδίαν",707141,9],["μου",709032,133],["ἐπεσκέψω",705250,174],["νυκτός",709386,17],["ἐπύρωσάς",711103,162],["με",708618,163],["καὶ",707031,7],["οὐχ",709805,28],["εὑρέθη",705676,37],["ἐν",704639,0],["ἐμοὶ",704577,159],["ἀδικία",700271,12]],"Thou hast proved mine heart; thou hast visited [me] by night; thou hast tried me as with fire, and unrighteousness has not been found in me: [I am purposed] that my mouth shall not speak [amiss]."],["4",[["ὅπως",709719,7],["ἂν",700900,11],["μὴ",708851,28],["λαλήσῃ",708071,123],["τὸ",709436,34],["στόμα",712125,15],["μου",709032,133],["τὰ",709436,41],["ἔργα",705396,42],["τῶν",709436,80],["ἀνθρώπων",701163,81],["διὰ",703417,0],["τοὺς",709436,58],["λόγους",708236,57],["τῶν",709436,43],["χειλέων",713781,44],["σου",711945,133],["ἐγὼ",704018,164],["ἐφύλαξα",713619,155],["ὁδοὺς",709458,39],["σκληράς",711861,119]],"As for the works of men, by the words of thy lips I have guarded [myself from] hard ways."],["5",[["κατάρτισαι",707410,300],["τὰ",709436,41],["διαβήματά",703422,42],["μου",709032,133],["ἐν",704639,0],["ταῖς",709436,75],["τρίβοις",712939,76],["σου",711945,133],["ἵνα",706747,7],["μὴ",708851,28],["σαλευθῶσιν",711403,272],["τὰ",709436,63],["διαβήματά",703422,64],["μου",709032,133]],"Direct my steps in thy paths, that my steps slip not."],["6",[["ἐγὼ",704018,164],["ἐκέκραξα",707868,155],["ὅτι",709803,7],["ἐπήκουσάς",705009,162],["μου",709032,133],["ὁ",709436,3],["θεός",706192,4],["κλῖνον",707738,176],["τὸ",709436,24],["οὖς",709852,25],["σου",711945,133],["ἐμοὶ",704577,159],["καὶ",707031,7],["εἰσάκουσον",704108,176],["τῶν",709436,80],["ῥημάτων",711246,81],["μου",709032,133]],"I have cried, for thou heardest me, O God: incline thine ear to me, and hearken to my words."],["7",[["θαυμάστωσον",706139,176],["τὰ",709436,41],["ἐλέη",704426,42],["σου",711945,133],["ὁ",709436,3],["σῴζων",712627,72],["τοὺς",709436,58],["ἐλπίζοντας",704529,235],["ἐπὶ",705080,0],["σὲ",711598,163],["ἐκ",704132,0],["τῶν",709436,80],["ἀνθεστηκότων",701154,387],["τῇ",709436,100],["δεξιᾷ",703360,101],["σου",711945,133]],"Shew the marvels of thy mercies, thou that savest them that hope in thee."],["8",[["φύλαξόν",713619,176],["με",708618,163],["ὡς",714148,7],["κόραν",707836,9],["ὀφθαλμοῦ",709870,18],["ἐν",704639,0],["σκέπῃ",711839,1],["τῶν",709436,130],["πτερύγων",711057,65],["σου",711945,133],["σκεπάσεις",711832,166],["με",708618,163]],"Keep me as the apple of the eye from those that resist thy right hand: thou shalt screen me by the covering of thy wings,"],["9",[["ἀπὸ",701425,0],["προσώπου",710986,21],["ἀσεβῶν",701909,169],["τῶν",709436,80],["ταλαιπωρησάντων",712694,221],["με",708618,163],["οἱ",709436,136],["ἐχθροί",705779,52],["μου",709032,133],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["περιέσχον",710315,150]],"from the face of the ungodly that have afflicted me: mine enemies have compassed about my soul."],["10",[["τὸ",709436,24],["στέαρ",712054,25],["αὐτῶν",702165,40],["συνέκλεισαν",712223,150],["τὸ",709436,34],["στόμα",712125,15],["αὐτῶν",702165,40],["ἐλάλησεν",708071,2],["ὑπερηφανίαν",713138,9]],"They have enclosed [themselves with] their own fat: their mouth has spoken pride."],["11",[["ἐκβάλλοντές",704145,146],["με",708618,163],["νυνὶ",709385,28],["περιεκύκλωσάν",710339,150],["με",708618,163],["τοὺς",709436,58],["ὀφθαλμοὺς",709870,57],["αὐτῶν",702165,40],["ἔθεντο",712849,189],["ἐκκλῖναι",704220,106],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1]],"They have now cast me out and compassed me round about: they have set their eyes [so as] to bow them down to the ground."],["12",[["ὑπέλαβόν",713210,150],["με",708618,163],["ὡσεὶ",714159,28],["λέων",708171,4],["ἕτοιμος",705541,14],["εἰς",704105,0],["θήραν",706244,9],["καὶ",707031,7],["ὡσεὶ",714159,28],["σκύμνος",711903,4],["οἰκῶν",709516,81],["ἐν",704639,0],["ἀποκρύφοις",701497,94]],"They laid wait for me as a lion ready for prey, and like a lion's whelp dwelling in secret [places]."],["13",[["ἀνάστηθι",701173,176],["κύριε",707996,153],["πρόφθασον",711011,176],["αὐτοὺς",702165,62],["καὶ",707031,7],["ὑποσκέλισον",713239,176],["αὐτούς",702165,62],["ῥῦσαι",711309,300],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἀπὸ",701425,0],["ἀσεβοῦς",701909,116],["ῥομφαίαν",711291,9],["σου",711945,133],["ἀπὸ",701425,0],["ἐχθρῶν",705779,81],["τῆς",709436,16],["χειρός",713787,17],["σου",711945,133]],"Arise, O Lord, prevent them, and cast them down: deliver my soul from the ungodly: [draw] thy sword,"],["14",[["κύριε",707996,153],["ἀπὸ",701425,0],["ὀλίγων",709568,169],["ἀπὸ",701425,0],["γῆς",703083,17],["διαμέρισον",703518,176],["αὐτοὺς",702165,62],["ἐν",704639,0],["τῇ",709436,100],["ζωῇ",705910,1],["αὐτῶν",702165,40],["καὶ",707031,7],["τῶν",709436,80],["κεκρυμμένων",707923,445],["σου",711945,133],["ἐπλήσθη",710532,37],["ἡ",709436,10],["γαστὴρ",702976,12],["αὐτῶν",702165,40],["ἐχορτάσθησαν",713919,99],["υἱῶν",713075,81],["καὶ",707031,7],["ἀφῆκαν",702211,150],["τὰ",709436,41],["κατάλοιπα",707317,68],["τοῖς",709436,147],["νηπίοις",709295,230],["αὐτῶν",702165,40]],"because of the enemies of thine hand: O Lord, destroy them from the earth; scatter them in their life, though their belly has been filled with thy hidden [treasures]: they have been satisfied with uncleanness, and have left the remnant [of their possessions] to their babes."],["15",[["ἐγὼ",704018,164],["δὲ",703303,11],["ἐν",704639,0],["δικαιοσύνῃ",703695,1],["ὀφθήσομαι",709725,180],["τῷ",709436,53],["προσώπῳ",710986,54],["σου",711945,133],["χορτασθήσομαι",713919,180],["ἐν",704639,0],["τῷ",709436,53],["ὀφθῆναι",709725,179],["τὴν",709436,8],["δόξαν",703791,9],["σου",711945,133]],"But I shall appear in righteousness before thy face: I shall be satisfied when thy glory appears."]]