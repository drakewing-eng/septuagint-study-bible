[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ὑπὲρ",713111,0],["τῶν",709436,80],["ἀλλοιωθησομένων",700694,728],["μαρτύριον",708525,15],["τῷ",709436,113],["Ασαφ",701894,114],["ψαλμὸς",714022,4],["ὑπὲρ",713111,0],["τοῦ",709436,35],["Ἀσσυρίου",702004,18]],"For the end, for alternate [strains], a testimony for Asaph, a Psalm concerning the Assyrian."],["2",[["ὁ",709436,3],["ποιμαίνων",710594,72],["τὸν",709436,5],["Ισραηλ",706839,6],["πρόσχες",710895,176],["ὁ",709436,3],["ὁδηγῶν",709448,72],["ὡσεὶ",714159,7],["πρόβατα",710768,42],["τὸν",709436,5],["Ιωσηφ",706948,6],["ὁ",709436,3],["καθήμενος",707000,122],["ἐπὶ",705080,0],["τῶν",709436,43],["χερουβιν",713830,44],["ἐμφάνηθι",704626,176]],"Attend, O Shepherd of Israel, who guidest Joseph like a flock; thou who sittest upon the cherubs, manifest thyself;"],["3",[["ἐναντίον",704654,0],["Εφραιμ",705769,18],["καὶ",707031,7],["Βενιαμιν",702650,18],["καὶ",707031,7],["Μανασση",708470,18],["ἐξέγειρον",704889,176],["τὴν",709436,8],["δυναστείαν",703841,9],["σου",711945,133],["καὶ",707031,7],["ἐλθὲ",705453,176],["εἰς",704105,0],["τὸ",709436,24],["σῶσαι",712627,106],["ἡμᾶς",705981,194]],"before Ephraim and Benjamin and Manasse, stir up thy power, and come to deliver us."],["4",[["ὁ",709436,3],["θεός",706192,4],["ἐπίστρεψον",705278,176],["ἡμᾶς",705981,194],["καὶ",707031,7],["ἐπίφανον",705317,176],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["καὶ",707031,7],["σωθησόμεθα",712627,347]],"Turn us, O God, and cause thy face to shine; and we shall be delivered."],["5",[["κύριε",707996,153],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,130],["δυνάμεων",703839,65],["ἕως",705792,0],["πότε",710696,11],["ὀργίζῃ",709729,204],["ἐπὶ",705080,0],["τὴν",709436,8],["προσευχὴν",710892,9],["τοῦ",709436,35],["δούλου",703817,18],["σου",711945,133]],"O Lord God of hosts, how long art thou angry with the prayer of thy servant?"],["6",[["ψωμιεῖς",714077,166],["ἡμᾶς",705981,194],["ἄρτον",701829,6],["δακρύων",703255,44],["καὶ",707031,7],["ποτιεῖς",710700,166],["ἡμᾶς",705981,194],["ἐν",704639,0],["δάκρυσιν",703255,96],["ἐν",704639,0],["μέτρῳ",708846,54]],"Thou wilt feed us with bread of tears; and wilt cause us to drink tears by measure."],["7",[["ἔθου",712849,174],["ἡμᾶς",705981,194],["εἰς",704105,0],["ἀντιλογίαν",701249,9],["τοῖς",709436,147],["γείτοσιν",703016,148],["ἡμῶν",705999,145],["καὶ",707031,7],["οἱ",709436,136],["ἐχθροὶ",705779,52],["ἡμῶν",705999,145],["ἐμυκτήρισαν",709052,150],["ἡμᾶς",705981,194]],"Thou hast made us a strife to our neighbours; and our enemies have mocked at us."],["8",[["κύριε",707996,153],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,130],["δυνάμεων",703839,65],["ἐπίστρεψον",705278,176],["ἡμᾶς",705981,194],["καὶ",707031,7],["ἐπίφανον",705317,176],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["καὶ",707031,7],["σωθησόμεθα",712627,347],["διάψαλμα",703641,15]],"Turn us, O Lord God of hosts, and cause thy face to shine; and we shall be saved. Pause."],["9",[["ἄμπελον",700870,9],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["μετῆρας",708794,162],["ἐξέβαλες",704145,162],["ἔθνη",704068,42],["καὶ",707031,7],["κατεφύτευσας",707487,162],["αὐτήν",702165,104]],"Thou hast transplanted a vine out of Egypt: thou hast cast out the heathen, and planted it."],["10",[["ὡδοποίησας",709456,162],["ἔμπροσθεν",704618,0],["αὐτῆς",702165,86],["καὶ",707031,7],["κατεφύτευσας",707487,162],["τὰς",709436,38],["ῥίζας",711260,39],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐπλήσθη",710532,37],["ἡ",709436,10],["γῆ",703083,12]],"Thou madest a way before it, and didst cause its roots to strike, and the land was filled [with it]."],["11",[["ἐκάλυψεν",707102,2],["ὄρη",709768,42],["ἡ",709436,10],["σκιὰ",711852,12],["αὐτῆς",702165,86],["καὶ",707031,7],["αἱ",709436,190],["ἀναδενδράδες",700937,191],["αὐτῆς",702165,86],["τὰς",709436,38],["κέδρους",707590,39],["τοῦ",709436,35],["θεοῦ",706192,18]],"Its shadow covered the mountains, and its shoots [equalled] the goodly cedars."],["12",[["ἐξέτεινεν",704322,2],["τὰ",709436,41],["κλήματα",707720,42],["αὐτῆς",702165,86],["ἕως",705792,0],["θαλάσσης",706069,17],["καὶ",707031,7],["ἕως",705792,0],["ποταμοῦ",710693,18],["τὰς",709436,38],["παραφυάδας",710118,39],["αὐτῆς",702165,86]],"It sent forth its branches to the sea, and its shoots to the river."],["13",[["ἵνα",706747,7],["τί",712867,126],["καθεῖλες",706982,162],["τὸν",709436,5],["φραγμὸν",713572,6],["αὐτῆς",702165,86],["καὶ",707031,7],["τρυγῶσιν",712996,197],["αὐτὴν",702165,104],["πάντες",710177,138],["οἱ",709436,136],["παραπορευόμενοι",710094,348],["τὴν",709436,8],["ὁδόν",709458,9]],"Wherefore hast thou broken down its hedge, while all that pass by the way pluck it?"],["14",[["ἐλυμήνατο",708270,23],["αὐτὴν",702165,104],["σῦς",712545,4],["ἐκ",704132,0],["δρυμοῦ",703836,18],["καὶ",707031,7],["μονιὸς",708995,14],["ἄγριος",700191,14],["κατενεμήσατο",707339,23],["αὐτήν",702165,104]],"The boar out of the wood has laid it waste, and the wild beast has devoured it."],["15",[["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,130],["δυνάμεων",703839,65],["ἐπίστρεψον",705278,176],["δή",703395,11],["ἐπίβλεψον",705088,176],["ἐξ",704132,0],["οὐρανοῦ",709844,18],["καὶ",707031,7],["ἰδὲ",709725,176],["καὶ",707031,7],["ἐπίσκεψαι",705250,300],["τὴν",709436,8],["ἄμπελον",700870,9],["ταύτην",709858,104]],"O God of hosts, turn, we pray thee: look on [us] from heaven, and behold and visit this vine;"],["16",[["καὶ",707031,7],["κατάρτισαι",707410,300],["αὐτήν",702165,104],["ἣν",709781,131],["ἐφύτευσεν",713636,2],["ἡ",709436,10],["δεξιά",703360,29],["σου",711945,133],["καὶ",707031,7],["ἐπὶ",705080,0],["υἱὸν",713075,6],["ἀνθρώπου",701163,18],["ὃν",709781,112],["ἐκραταίωσας",707875,162],["σεαυτῷ",711599,50]],"and restore that which thy right hand has planted: and look on the son of man whom thou didst strengthen for thyself."],["17",[["ἐμπεπυρισμένη",704622,451],["πυρὶ",711088,54],["καὶ",707031,7],["ἀνεσκαμμένη",701051,451],["ἀπὸ",701425,0],["ἐπιτιμήσεως",705306,17],["τοῦ",709436,20],["προσώπου",710986,21],["σου",711945,133],["ἀπολοῦνται",701513,135]],"[It is] burnt with fire and dug up: they shall perish at the rebuke of thy presence."],["18",[["γενηθήτω",703104,22],["ἡ",709436,10],["χείρ",713787,12],["σου",711945,133],["ἐπ᾿",705080,0],["ἄνδρα",701150,6],["δεξιᾶς",703360,82],["σου",711945,133],["καὶ",707031,7],["ἐπὶ",705080,0],["υἱὸν",713075,6],["ἀνθρώπου",701163,18],["ὃν",709781,112],["ἐκραταίωσας",707875,162],["σεαυτῷ",711599,50]],"Let thy hand be upon the man of thy right hand, and upon the son of man whom thou didst strengthen for thyself."],["19",[["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἀποστῶμεν",702214,79],["ἀπὸ",701425,0],["σοῦ",711945,133],["ζωώσεις",705918,166],["ἡμᾶς",705981,194],["καὶ",707031,7],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["ἐπικαλεσόμεθα",705153,141]],"So will we not depart from thee: thou shalt quicken us, and we will call upon thy name."],["20",[["κύριε",707996,153],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,130],["δυνάμεων",703839,65],["ἐπίστρεψον",705278,176],["ἡμᾶς",705981,194],["καὶ",707031,7],["ἐπίφανον",705317,176],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["καὶ",707031,7],["σωθησόμεθα",712627,347]],"Turn us, O Lord God of hosts, and make thy face to shine; and we shall be saved."]]