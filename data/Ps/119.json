[["1",[["ᾠδὴ",714091,12],["τῶν",709436,80],["ἀναβαθμῶν",700904,81],["πρὸς",710844,0],["κύριον",707996,6],["ἐν",704639,0],["τῷ",709436,53],["θλίβεσθαί",706274,110],["με",708618,163],["ἐκέκραξα",707868,155],["καὶ",707031,7],["εἰσήκουσέν",704108,2],["μου",709032,133]],"A Song of Degrees. In mine affliction I cried to the Lord, and he hearkened to me."],["2",[["κύριε",707996,153],["ῥῦσαι",711309,300],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἀπὸ",701425,0],["χειλέων",713781,44],["ἀδίκων",700272,83],["καὶ",707031,7],["ἀπὸ",701425,0],["γλώσσης",703120,17],["δολίας",703783,82]],"Deliver my soul, O Lord, from unjust lips, and from a deceitful tongue."],["3",[["τί",712867,126],["δοθείη",703654,528],["σοι",711925,159],["καὶ",707031,7],["τί",712867,126],["προστεθείη",710965,225],["σοι",711925,159],["πρὸς",710844,0],["γλῶσσαν",703120,9],["δολίαν",703783,36]],"What should be given to thee, and what should be added to thee, for [thy] crafty tongue?"],["4",[["τὰ",709436,41],["βέλη",702644,42],["τοῦ",709436,35],["δυνατοῦ",703845,116],["ἠκονημένα",700570,388],["σὺν",712372,0],["τοῖς",709436,147],["ἄνθραξιν",701160,148],["τοῖς",709436,147],["ἐρημικοῖς",705418,230]],"Sharpened weapons of the mighty, with coals of the desert."],["5",[["οἴμμοι",709525,88],["ὅτι",709803,7],["ἡ",709436,10],["παροικία",710158,12],["μου",709032,133],["ἐμακρύνθη",708428,37],["κατεσκήνωσα",707423,155],["μετὰ",708780,0],["τῶν",709436,43],["σκηνωμάτων",711849,44],["Κηδαρ",707645,17]],"Woe is me, that my sojourning is prolonged; I have tabernacled among the tents of Kedar."],["6",[["πολλὰ",710646,68],["παρῴκησεν",710156,2],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133]],"My soul has long been a sojourner;",{"s":"d","q":0.5}],["7",[["μετὰ",708780,0],["τῶν",709436,80],["μισούντων",708935,170],["τὴν",709436,8],["εἰρήνην",704098,9],["ἤμην",704578,36],["εἰρηνικός",704099,14],["ὅταν",709801,28],["ἐλάλουν",708071,333],["αὐτοῖς",702165,151],["ἐπολέμουν",710601,137],["με",708618,163],["δωρεάν",70390