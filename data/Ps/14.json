[["1",[["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114],["κύριε",707996,153],["τίς",712867,158],["παροικήσει",710157,1],["ἐν",704639,0],["τῷ",709436,53],["σκηνώματί",711849,54],["σου",711945,133],["καὶ",707031,7],["τίς",712867,158],["κατασκηνώσει",707423,127],["ἐν",704639,0],["τῷ",709436,53],["ὄρει",709768,54],["τῷ",709436,53],["ἁγίῳ",700159,97],["σου",711945,133]],"A Psalm of David. O Lord, who shall sojourn in thy tabernacle? and who shall dwell in thy holy mountain?"],["2",[["πορευόμενος",710667,122],["ἄμωμος",700895,14],["καὶ",707031,7],["ἐργαζόμενος",705383,122],["δικαιοσύνην",703695,9],["λαλῶν",708071,72],["ἀλήθειαν",700656,9],["ἐν",704639,0],["καρδίᾳ",707141,1],["αὐτοῦ",702165,102]],"He that walks blameless, and works righteousness, who speaks truth in his heart."],["3",[["ὃς",709781,213],["οὐκ",709805,28],["ἐδόλωσεν",703788,2],["ἐν",704639,0],["γλώσσῃ",703120,1],["αὐτοῦ",702165,102],["οὐδὲ",709816,7],["ἐποίησεν",710582,2],["τῷ",709436,113],["πλησίον",710547,28],["αὐτοῦ",702165,102],["κακὸν",707066,27],["καὶ",707031,7],["ὀνειδισμὸν",709657,6],["οὐκ",709805,28],["ἔλαβεν",708076,2],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἔγγιστα",703948,28],["αὐτοῦ",702165,102]],"Who has not spoken craftily with his tongue, neither has done evil to his neighbour, nor taken up a reproach against them that dwelt nearest to him."],["4",[["ἐξουδένωται",704969,462],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["πονηρευόμενος",710657,122],["τοὺς",709436,58],["δὲ",703303,11],["φοβουμένους",713532,236],["κύριον",707996,6],["δοξάζει",703792,91],["ὁ",709436,3],["ὀμνύων",709620,72],["τῷ",709436,113],["πλησίον",710547,28],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ἀθετῶν",700369,72]],"In his sight an evil-worker is set at nought, but he honours them that fear the Lord. He swears to his neighbour, and disappoints [him] not."],["5",[["τὸ",709436,24],["ἀργύριον",701707,25],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἔδωκεν",703654,2],["ἐπὶ",705080,0],["τόκῳ",712882,114],["καὶ",707031,7],["δῶρα",703907,42],["ἐπ᾿",705080,0],["ἀθῴοις",700390,230],["οὐκ",709805,28],["ἔλαβεν",708076,2],["ὁ",709436,3],["ποιῶν",710582,72],["ταῦτα",709858,71],["οὐ",709805,28],["σαλευθήσεται",711403,134],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"He has not lent his money on usury, and has not received bribes against the innocent. He that does these things shall never be moved."]]