[["1",[["ψαλμὸς",714022,4],["τῷ",709436,113],["Ασαφ",701894,114],["ὁ",709436,3],["θεός",706192,4],["ἤλθοσαν",705453,150],["ἔθνη",704068,64],["εἰς",704105,0],["τὴν",709436,8],["κληρονομίαν",707725,9],["σου",711945,133],["ἐμίαναν",708900,150],["τὸν",709436,5],["ναὸν",709191,6],["τὸν",709436,5],["ἅγιόν",700159,27],["σου",711945,133],["ἔθεντο",712849,189],["Ιερουσαλημ",706644,9],["εἰς",704105,0],["ὀπωροφυλάκιον",709718,25]],"A Psalm for Asaph. O God, the heathen are come into thine inheritance; they have polluted thy holy temple; they have made Jerusalem a storehouse of fruits."],["2",[["ἔθεντο",712849,189],["τὰ",709436,41],["θνησιμαῖα",706277,68],["τῶν",709436,80],["δούλων",703817,81],["σου",711945,133],["βρώματα",702823,42],["τοῖς",709436,95],["πετεινοῖς",710439,96],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["τὰς",709436,38],["σάρκας",711537,39],["τῶν",709436,80],["ὁσίων",709782,169],["σου",711945,133],["τοῖς",709436,95],["θηρίοις",706252,96],["τῆς",709436,16],["γῆς",703083,17]],"They have given the dead bodies of thy servants [to be] food for the birds of the sky, the flesh of thy holy ones for the wild beasts of the earth."],["3",[["ἐξέχεαν",704368,150],["τὸ",709436,24],["αἷμα",700442,25],["αὐτῶν",702165,40],["ὡς",714148,7],["ὕδωρ",713071,25],["κύκλῳ",707959,114],["Ιερουσαλημ",706644,17],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ὁ",709436,3],["θάπτων",706103,72]],"They have shed their blood as water, round about Jerusalem; and there was none to bury [them]."],["4",[["ἐγενήθημεν",703104,485],["ὄνειδος",709658,25],["τοῖς",709436,147],["γείτοσιν",703016,148],["ἡμῶν",705999,145],["μυκτηρισμὸς",709053,4],["καὶ",707031,7],["χλευασμὸς",713875,4],["τοῖς",709436,147],["κύκλῳ",707959,114],["ἡμῶν",705999,145]],"We are become a reproach to our neighbours, a scorn and derision to them [that are] round about us."],["5",[["ἕως",705792,0],["πότε",710696,11],["κύριε",707996,153],["ὀργισθήσῃ",709729,364],["εἰς",704105,0],["τέλος",712787,25],["ἐκκαυθήσεται",704205,134],["ὡς",714148,7],["πῦρ",711088,15],["ὁ",709436,3],["ζῆλός",705871,4],["σου",711945,133]],"How long, O Lord? wilt thou be angry for ever? shall thy jealousy burn like fire?"],["6",[["ἔκχεον",704368,176],["τὴν",709436,8],["ὀργήν",709728,9],["σου",711945,133],["ἐπὶ",705080,0],["ἔθνη",704068,42],["τὰ",709436,41],["μὴ",708851,28],["γινώσκοντά",703105,47],["σε",711598,163],["καὶ",707031,7],["ἐπὶ",705080,0],["βασιλείας",702577,17],["αἳ",709781,256],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["οὐκ",709805,28],["ἐπεκαλέσαντο",705153,189]],"Pour out thy wrath upon the heathen that have not known thee, and upon the kingdoms which have not called upon thy name."],["7",[["ὅτι",709803,7],["κατέφαγον",707519,150],["τὸν",709436,5],["Ιακωβ",706401,6],["καὶ",707031,7],["τὸν",709436,5],["τόπον",712903,6],["αὐτοῦ",702165,102],["ἠρήμωσαν",705421,150]],"For they have devoured Jacob, and laid his place waste."],["8",[["μὴ",708851,28],["μνησθῇς",708960,279],["ἡμῶν",705999,145],["ἀνομιῶν",701192,65],["ἀρχαίων",701835,198],["ταχὺ",712748,46],["προκαταλαβέτωσαν",710809,264],["ἡμᾶς",705981,194],["οἱ",709436,136],["οἰκτιρμοί",709520,52],["σου",711945,133],["ὅτι",709803,7],["ἐπτωχεύσαμεν",711074,289],["σφόδρα",712586,28]],"Remember not our old transgressions; let thy tender mercies speedily prevent us; for we are greatly impoverished."],["9",[["βοήθησον",702746,176],["ἡμῖν",705994,90],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["σωτὴρ",712657,4],["ἡμῶν",705999,145],["ἕνεκα",704709,0],["τῆς",709436,16],["δόξης",703791,17],["τοῦ",709436,20],["ὀνόματός",709666,21],["σου",711945,133],["κύριε",707996,153],["ῥῦσαι",711309,300],["ἡμᾶς",705981,194],["καὶ",707031,7],["ἱλάσθητι",706728,244,279],["ταῖς",709436,75],["ἁμαρτίαις",700775,76],["ἡμῶν",705999,145],["ἕνεκα",704709,0],["τοῦ",709436,20],["ὀνόματός",709666,21],["σου",711945,133]],"Help us, O God our Saviour; for the glory of thy name, O Lord, deliver us; and be merciful to our sins, for thy name's sake."],["10",[["μήποτε",708882,28],["εἴπωσιν",705373,234],["τὰ",709436,63],["ἔθνη",704068,64],["ποῦ",710706,28],["ἐστιν",704093,91],["ὁ",709436,3],["θεὸς",706192,4],["αὐτῶν",702165,40],["καὶ",707031,7],["γνωσθήτω",703105,22],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["ἐνώπιον",704823,0],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["ἡμῶν",705999,145],["ἡ",709436,10],["ἐκδίκησις",704175,12],["τοῦ",709436,20],["αἵματος",700442,21],["τῶν",709436,80],["δούλων",703817,81],["σου",711945,133],["τοῦ",709436,35],["ἐκκεχυμένου",704368,482]],"Lest haply they should say among the heathen, Where is their God? and let the avenging of thy servants' blood that has been shed be known among the heathen before our eyes."],["11",[["εἰσελθάτω",704114,45],["ἐνώπιόν",704823,0],["σου",711945,133],["ὁ",709436,3],["στεναγμὸς",712065,4],["τῶν",709436,80],["πεπεδημένων",710208,398],["κατὰ",707200,0],["τὴν",709436,8],["μεγαλωσύνην",708652,9],["τοῦ",709436,35],["βραχίονός",702808,18],["σου",711945,133],["περιποίησαι",710367,300],["τοὺς",709436,58],["υἱοὺς",713075,57],["τῶν",709436,80],["τεθανατωμένων",706097,398]],"Let the groaning of the prisoners come in before thee; according to the greatness of thine arm preserve the sons of the slain ones."],["12",[["ἀπόδος",701449,176],["τοῖς",709436,147],["γείτοσιν",703016,148],["ἡμῶν",705999,145],["ἑπταπλασίονα",705369,68],["εἰς",704105,0],["τὸν",709436,5],["κόλπον",707800,6],["αὐτῶν",702165,40],["τὸν",709436,5],["ὀνειδισμὸν",709657,6],["αὐτῶν",702165,40],["ὃν",709781,112],["ὠνείδισάν",709655,150],["σε",711598,163],["κύριε",707996,153]],"Repay to our neighbours sevenfold into their bosom their reproach, with which they have reproached thee, O Lord."],["13",[["ἡμεῖς",705983,219],["δὲ",703303,11],["λαός",708094,4],["σου",711945,133],["καὶ",707031,7],["πρόβατα",710768,64],["τῆς",709436,16],["νομῆς",709337,17],["σου",711945,133],["ἀνθομολογησόμεθά",701155,141],["σοι",711925,159],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["εἰς",704105,0],["γενεὰν",703037,9],["καὶ",707031,7],["γενεὰν",703037,9],["ἐξαγγελοῦμεν",704829,275],["τὴν",709436,8],["αἴνεσίν",700457,9],["σου",711945,133]],"For we are thy people and the sheep of thy pasture; we will give thee thanks for ever; we will declare thy praise throughout all generations."]]