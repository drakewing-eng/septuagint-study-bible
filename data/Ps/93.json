[["1",[["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114],["τετράδι",712808,1],["σαββάτων",711350,44],["ὁ",709436,3],["θεὸς",706192,4],["ἐκδικήσεων",704175,65],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἐκδικήσεων",704175,65],["ἐπαρρησιάσατο",710174,23]],"A Psalm of David for the fourth [day] of the week. The Lord is a God of vengeance; the God of vengeance has declared himself."],["2",[["ὑψώθητι",713289,244],["ὁ",709436,3],["κρίνων",707905,72],["τὴν",709436,8],["γῆν",703083,9],["ἀπόδος",701449,176],["ἀνταπόδοσιν",701217,9],["τοῖς",709436,147],["ὑπερηφάνοις",713139,230]],"Be thou exalted, thou that judgest the earth: render a reward to the proud."],["3",[["ἕως",705792,0],["πότε",710696,11],["ἁμαρτωλοί",700776,138],["κύριε",707996,153],["ἕως",705792,0],["πότε",710696,11],["ἁμαρτωλοὶ",700776,138],["καυχήσονται",707569,135]],"How long shall sinners, O Lord, how long shall sinners boast?"],["4",[["φθέγξονται",713442,135],["καὶ",707031,7],["λαλήσουσιν",708071,218],["ἀδικίαν",700271,9],["λαλήσουσιν",708071,218],["πάντες",710177,138],["οἱ",709436,136],["ἐργαζόμενοι",705383,348],["τὴν",709436,8],["ἀνομίαν",701192,9]],"They will utter and speak unrighteousness; all the workers of iniquity will speak [so]."],["5",[["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133],["κύριε",707996,153],["ἐταπείνωσαν",712717,150],["καὶ",707031,7],["τὴν",709436,8],["κληρονομίαν",707725,9],["σου",711945,133],["ἐκάκωσαν",707073,150]],"They have afflicted thy people, O Lord, and hurt thine heritage."],["6",[["χήραν",713848,9],["καὶ",707031,7],["προσήλυτον",710900,6],["ἀπέκτειναν",701498,150],["καὶ",707031,7],["ὀρφανοὺς",709779,60],["ἐφόνευσαν",713546,150]],"They have slain the widow and fatherless, and murdered the stranger."],["7",[["καὶ",707031,7],["εἶπαν",705373,150],["οὐκ",709805,28],["ὄψεται",709725,93],["κύριος",707996,4],["οὐδὲ",709816,7],["συνήσει",712481,127],["ὁ",709436,3],["θεὸς",706192,4],["τοῦ",709436,35],["Ιακωβ",706401,18]],"And they said, The Lord shall not see, neither shall the God of Jacob understand."],["8",[["σύνετε",712481,74],["δή",703395,11],["ἄφρονες",702236,138],["ἐν",704639,0],["τῷ",709436,113],["λαῷ",708094,114],["καί",707031,7],["μωροί",709110,138],["ποτὲ",710695,11],["φρονήσατε",713586,74]],"Understand now, ye simple among the people; and ye fools, at length be wise."],["9",[["ὁ",709436,3],["φυτεύσας",713636,182],["τὸ",709436,24],["οὖς",709852,25],["οὐχὶ",709862,28],["ἀκούει",700587,91],["ἢ",705924,7],["ὁ",709436,3],["πλάσας",710503,182],["τὸν",709436,5],["ὀφθαλμὸν",709870,6],["οὐ",709805,28],["κατανοεῖ",707341,91]],"He that planted the ear, does he not hear? or he that formed the eye, does not he perceive?"],["10",[["ὁ",709436,3],["παιδεύων",709926,72],["ἔθνη",704068,42],["οὐχὶ",709862,28],["ἐλέγξει",704416,127],["ὁ",709436,3],["διδάσκων",703649,72],["ἄνθρωπον",701163,6],["γνῶσιν",703138,9]],"He that chastises the heathen, shall not he punish, [even] he that teaches man knowledge?"],["11",[["κύριος",707996,4],["γινώσκει",703105,91],["τοὺς",709436,58],["διαλογισμοὺς",703506,57],["τῶν",709436,80],["ἀνθρώπων",701163,81],["ὅτι",709803,7],["εἰσὶν",704093,197],["μάταιοι",708575,138]],"The Lord knows the thoughts of men, that they are vain."],["12",[["μακάριος",708397,14],["ἄνθρωπος",701163,4],["ὃν",709781,112],["ἂν",700900,11],["σὺ",712181,164],["παιδεύσῃς",709926,175],["κύριε",707996,153],["καὶ",707031,7],["ἐκ",704132,0],["τοῦ",709436,35],["νόμου",709349,18],["σου",711945,133],["διδάξῃς",703649,175],["αὐτὸν",702165,85]],"Blessed is the man whomsoever thou shalt chasten, O Lord, and shalt teach him out of thy law;"],["13",[["τοῦ",709436,20],["πραῦναι",710724,106],["αὐτῷ",702165,50],["ἀφ᾿",701425,0],["ἡμερῶν",705984,65],["πονηρῶν",710660,198],["ἕως",705792,0],["οὗ",709781,48],["ὀρυγῇ",709775,37],["τῷ",709436,113],["ἁμαρτωλῷ",700776,30],["βόθρος",702749,4]],"to give him rest from evil days, until a pit be digged for the sinful one."],["14",[["ὅτι",709803,7],["οὐκ",709805,28],["ἀπώσεται",701659,93],["κύριος",707996,4],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὴν",709436,8],["κληρονομίαν",707725,9],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐγκαταλείψει",703967,127]],"For the Lord will not cast off his people, neither will he forsake his inheritance;"],["15",[["ἕως",705792,0],["οὗ",709781,48],["δικαιοσύνη",703695,12],["ἐπιστρέψῃ",705278,123],["εἰς",704105,0],["κρίσιν",707908,9],["καὶ",707031,7],["ἐχόμενοι",705785,348],["αὐτῆς",702165,86],["πάντες",710177,138],["οἱ",709436,136],["εὐθεῖς",705602,138],["τῇ",709436,100],["καρδίᾳ",707141,1],["διάψαλμα",703641,15]],"until righteousness return to judgment, and all the upright in heart shall follow it. Pause."],["16",[["τίς",712867,158],["ἀναστήσεταί",701173,93],["μοι",708974,159],["ἐπὶ",705080,0],["πονηρευομένους",710657,236],["ἢ",705924,7],["τίς",712867,158],["συμπαραστήσεταί",712323,93],["μοι",708974,159],["ἐπὶ",705080,0],["ἐργαζομένους",705383,236],["τὴν",709436,8],["ἀνομίαν",701192,9]],"Who will rise up for me against the transgressors? or who will stand up with me against the workers of iniquity?"],["17",[["εἰ",704071,7],["μὴ",708851,28],["ὅτι",709803,7],["κύριος",707996,4],["ἐβοήθησέν",702746,2],["μοι",708974,159],["παρὰ",709995,0],["βραχὺ",702809,46],["παρῴκησεν",710156,2],["τῷ",709436,113],["ᾅδῃ",700255,114],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133]],"If the Lord had not helped me, my soul had almost sojourned in Hades."],["18",[["εἰ",704071,7],["ἔλεγον",708124,333],["σεσάλευται",711403,403],["ὁ",709436,3],["πούς",710707,4],["μου",709032,133],["τὸ",709436,34],["ἔλεός",704426,15],["σου",711945,133],["κύριε",707996,153],["βοηθεῖ",702746,91],["μοι",708974,159]],"If I said, My foot has been moved;"],["19",[["κύριε",707996,153],["κατὰ",707200,0],["τὸ",709436,24],["πλῆθος",710529,25],["τῶν",709436,130],["ὀδυνῶν",709463,65],["μου",709032,133],["ἐν",704639,0],["τῇ",709436,100],["καρδίᾳ",707141,1],["μου",709032,133],["αἱ",709436,190],["παρακλήσεις",710047,191],["σου",711945,133],["ἠγάπησαν",700120,150],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133]],"thy mercy, O Lord, helped me. O Lord, according to the multitude of my griefs within my heart, thy consolations have soothed my soul."],["20",[["μὴ",708851,28],["συμπροσέσται",712349,93],["σοι",711925,159],["θρόνος",706315,4],["ἀνομίας",701192,17],["ὁ",709436,3],["πλάσσων",710503,72],["κόπον",707825,6],["ἐπὶ",705080,0],["προστάγματι",710959,54]],"Shall the throne of iniquity have fellowship with thee, which frames mischief by an ordinance?"],["21",[["θηρεύσουσιν",706248,218],["ἐπὶ",705080,0],["ψυχὴν",714070,9],["δικαίου",703694,116],["καὶ",707031,7],["αἷμα",700442,25],["ἀθῷον",700390,46],["καταδικάσονται",707241,135]],"They will hunt for the soul of the righteous, and condemn innocent blood."],["22",[["καὶ",707031,7],["ἐγένετό",703104,23],["μοι",708974,159],["κύριος",707996,4],["εἰς",704105,0],["καταφυγὴν",707485,9],["καὶ",707031,7],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["εἰς",704105,0],["βοηθὸν",702748,6],["ἐλπίδος",704530,17],["μου",709032,133]],"But the Lord was my refuge; and my God the helper of my hope."],["23",[["καὶ",707031,7],["ἀποδώσει",701449,127],["αὐτοῖς",702165,151],["τὴν",709436,8],["ἀνομίαν",701192,9],["αὐτῶν",702165,40],["καὶ",707031,7],["κατὰ",707200,0],["τὴν",709436,8],["πονηρίαν",710659,9],["αὐτῶν",702165,40],["ἀφανιεῖ",702182,127],["αὐτοὺς",702165,62],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145]],"And he will recompense to them their iniquity and their wickedness: the Lord our God shall utterly destroy them."]]