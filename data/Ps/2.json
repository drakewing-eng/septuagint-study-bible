[["1",[["ἵνα",706747,7],["τί",712867,126],["ἐφρύαξαν",713600,150],["ἔθνη",704068,64],["καὶ",707031,7],["λαοὶ",708094,52],["ἐμελέτησαν",708698,150],["κενά",707612,68]],"Wherefore did the heathen rage, and the nations imagine vain things?"],["2",[["παρέστησαν",710152,150],["οἱ",709436,136],["βασιλεῖς",702580,52],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["οἱ",709436,136],["ἄρχοντες",701862,52],["συνήχθησαν",712375,99],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτὸ",702165,129],["κατὰ",707200,0],["τοῦ",709436,35],["κυρίου",707996,18],["καὶ",707031,7],["κατὰ",707200,0],["τοῦ",709436,35],["χριστοῦ",713964,116],["αὐτοῦ",702165,102],["διάψαλμα",703641,15]],"The kings of the earth stood up, and the rulers gathered themselves together, against the Lord, and against his Christ;"],["3",[["διαρρήξωμεν",703565,79],["τοὺς",709436,58],["δεσμοὺς",703372,57],["αὐτῶν",702165,40],["καὶ",707031,7],["ἀπορρίψωμεν",701563,79],["ἀφ᾿",701425,0],["ἡμῶν",705999,145],["τὸν",709436,5],["ζυγὸν",705894,6],["αὐτῶν",702165,40]],"[saying], Let us break through their bonds, and cast away their yoke from us."],["4",[["ὁ",709436,3],["κατοικῶν",707534,72],["ἐν",704639,0],["οὐρανοῖς",709844,148],["ἐκγελάσεται",704157,117],["αὐτούς",702165,62],["καὶ",707031,7],["ὁ",709436,3],["κύριος",707996,4],["ἐκμυκτηριεῖ",704263,127],["αὐτούς",702165,62]],"He that dwells in the heavens shall laugh them to scorn, and the Lord shall mock them."],["5",[["τότε",712908,28],["λαλήσει",708071,127],["πρὸς",710844,0],["αὐτοὺς",702165,62],["ἐν",704639,0],["ὀργῇ",709728,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["θυμῷ",706334,114],["αὐτοῦ",702165,102],["ταράξει",712721,127],["αὐτούς",702165,62]],"Then shall he speak to them in his anger, and trouble them in his fury."],["6",[["ἐγὼ",704018,164],["δὲ",703303,11],["κατεστάθην",707011,156],["βασιλεὺς",702580,4],["ὑπ᾿",713184,0],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["Σιων",711816,227],["ὄρος",709768,25],["τὸ",709436,24],["ἅγιον",700159,46],["αὐτ