7],["ἀπολεῖσθε",701513,124],["ἐξ",704132,0],["ὁδοῦ",709458,17],["δικαίας",703694,82],["ὅταν",709801,28],["ἐκκαυθῇ",704205,384],["ἐν",704639,0],["τάχει",712750,30],["ὁ",709436,3],["θυμὸς",706334,4],["αὐτοῦ",702165,102],["μακάριοι",708397,138],["πάντες",710177,138],["οἱ",709436,136],["πεποιθότες",710221,268],["ἐπ᾿",705080,0],["αὐτῷ",702165,50]],"Accept correction, lest at any time the Lord be angry, and ye should perish from the righteous way: whensoever his wrath shall be suddenly kindled, blessed are all they that trust in him."]]