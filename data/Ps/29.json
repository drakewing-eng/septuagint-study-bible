[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ψαλμὸς",714022,4],["ᾠδῆς",714091,17],["τοῦ",709436,35],["ἐγκαινισμοῦ",703958,18],["τοῦ",709436,35],["οἴκου",709516,18],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, a Psalm and Song at the dedication of the house of David."],["2",[["ὑψώσω",713289,165],["σε",711598,163],["κύριε",707996,153],["ὅτι",709803,7],["ὑπέλαβές",713210,162],["με",708618,163],["καὶ",707031,7],["οὐκ",709805,28],["ηὔφρανας",705715,162],["τοὺς",709436,58],["ἐχθρούς",705779,57],["μου",709032,133],["ἐπ᾿",705080,0],["ἐμέ",704555,163]],"I will exalt thee, O Lord; for thou hast lifted me up, and not caused mine enemies to rejoice over me."],["3",[["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["ἐκέκραξα",707868,155],["πρὸς",710844,0],["σέ",711598,163],["καὶ",707031,7],["ἰάσω",706424,165],["με",708618,163]],"O Lord my God, I cried to thee, and thou didst heal me."],["4",[["κύριε",707996,153],["ἀνήγαγες",700933,162],["ἐξ",704132,0],["ᾅδου",700255,18],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἔσωσάς",712627,162],["με",708618,163],["ἀπὸ",701425,0],["τῶν",709436,80],["καταβαινόντων",707202,170],["εἰς",704105,0],["λάκκον",708067,6]],"O Lord, thou hast brought up my soul from Hades, thou hast delivered me from [among] them that go down to the pit."],["5",[["ψάλατε",714021,74],["τῷ",709436,113],["κυρίῳ",707996,114],["οἱ",709436,136],["ὅσιοι",709782,138],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐξομολογεῖσθε",704960,374],["τῇ",709436,100],["μνήμῃ",708964,1],["τῆς",709436,16],["ἁγιωσύνης",700161,17],["αὐτοῦ",702165,102]],"Sing to the Lord, ye his saints, and give thanks for the remembrance of his holiness."],["6",[["ὅτι",709803,7],["ὀργὴ",709728,12],["ἐν",704639,0],["τῷ",709436,113],["θυμῷ",706334,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["ζωὴ",705910,12],["ἐν",704639,0],["τῷ",709436,53],["θελήματι",706170,54],["αὐτοῦ",702165,102],["τὸ",709436,24],["ἑσπέρας",705500,17],["αὐλισθήσεται",702138,134],["κλαυθμὸς",707705,4],["καὶ",707031,7],["εἰς",704105,0],["τὸ",709436,24],["πρωὶ",711021,28],["ἀγαλλίασις",700113,12]],"For anger is in his wrath, but life in his favour: weeping shall tarry for the evening, but joy shall be in the morning."],["7",[["ἐγὼ",704018,164],["δὲ",703303,11],["εἶπα",705373,155],["ἐν",704639,0],["τῇ",709436,100],["εὐθηνίᾳ",705595,1],["μου",709032,133],["οὐ",709805,28],["μὴ",708851,28],["σαλευθῶ",711403,321],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"And I said in my prosperity, I shall never be moved."],["8",[["κύριε",707996,153],["ἐν",704639,0],["τῷ",709436,53],["θελήματί",706170,54],["σου",711945,133],["παρέσχου",710142,174],["τῷ",709436,53],["κάλλει",707093,54],["μου",709032,133],["δύναμιν",703839,9],["ἀπέστρεψας",701598,162],["δὲ",703303,11],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["καὶ",707031,7],["ἐγενήθην",703104,156],["τεταραγμένος",712721,251]],"O Lord, in thy good pleasure thou didst add strength to my beauty: but thou didst turn away thy face, and I was troubled."],["9",[["πρὸς",710844,0],["σέ",711598,163],["κύριε",707996,153],["κεκράξομαι",707868,181],["καὶ",707031,7],["πρὸς",710844,0],["τὸν",709436,5],["θεόν",706192,6],["μου",709032,133],["δεηθήσομαι",703394,180]],"To thee, O Lord, will I cry; and to my God will I make supplication."],["10",[["τίς",712867,359],["ὠφέλεια",714170,12],["ἐν",704639,0],["τῷ",709436,53],["αἵματί",700442,54],["μου",709032,133],["ἐν",704639,0],["τῷ",709436,53],["καταβῆναί",707202,106],["με",708618,163],["εἰς",704105,0],["διαφθοράν",703625,9],["μὴ",708851,28],["ἐξομολογήσεταί",704960,93],["σοι",711925,159],["χοῦς",713930,4],["ἢ",705924,7],["ἀναγγελεῖ",700921,127],["τὴν",709436,8],["ἀλήθειάν",700656,9],["σου",711945,133]],"What profit is there in my blood, when I go down to destruction? Shall the dust give praise to thee? or shall it declare thy truth?"],["11",[["ἤκουσεν",700587,2],["κύριος",707996,4],["καὶ",707031,7],["ἠλέησέν",704418,2],["με",708618,163],["κύριος",707996,4],["ἐγενήθη",703104,37],["βοηθός",702748,4],["μου",709032,133]],"The Lord heard, and had compassion upon me; the Lord is become my helper."],["12",[["ἔστρεψας",712160,162],["τὸν",709436,5],["κοπετόν",707821,6],["μου",709032,133],["εἰς",704105,0],["χορὸν",713915,6],["ἐμοί",704577,159],["διέρρηξας",703565,162],["τὸν",709436,5],["σάκκον",711386,6],["μου",709032,133],["καὶ",707031,7],["περιέζωσάς",710317,162],["με",708618,163],["εὐφροσύνην",705717,9]],"Thou hast turned my mourning into joy for me: thou hast rent off my sackcloth, and girded me with gladness;"],["13",[["ὅπως",709719,7],["ἂν",700900,11],["ψάλῃ",714021,204],["σοι",711925,159],["ἡ",709436,10],["δόξα",703791,12],["μου",709032,133],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["κατανυγῶ",707347,175],["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἐξομολογήσομαί",704960,181],["σοι",711925,159]],"that my glory may sing praise to thee, and I may not be pierced [with sorrow]. O Lord my God, I will give thanks to thee for ever."]]