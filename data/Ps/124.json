[["1",[["ᾠδὴ",714091,12],["τῶν",709436,80],["ἀναβαθμῶν",700904,81],["οἱ",709436,136],["πεποιθότες",710221,268],["ἐπὶ",705080,0],["κύριον",707996,6],["ὡς",714148,7],["ὄρος",709768,25],["Σιων",711816,9],["οὐ",709805,28],["σαλευθήσεται",711403,134],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ὁ",709436,3],["κατοικῶν",707534,72],["Ιερουσαλημ",706644,17]],"A Song of Degrees. They that trust in the Lord [shall be] as mount Sion: he that dwells in Jerusalem shall never be moved."],["2",[["ὄρη",709768,42],["κύκλῳ",707959,114],["αὐτῆς",702165,547],["καὶ",707031,7],["κύριος",707996,4],["κύκλῳ",707959,114],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτοῦ",702165,559],["ἀπὸ",701425,0],["τοῦ",709436,35],["νῦν",709384,28],["καὶ",707031,7],["ἕως",705792,0],["τοῦ",709436,35],["αἰῶνος",700504,18]],"The mountains are round about her, and [so] the Lord is round about his people, from henceforth and even for ever."],["3",[["ὅτι",709803,7],["οὐκ",709805,28],["ἀφήσει",702211,127],["τὴν",709436,8],["ῥάβδον",711135,9],["τῶν",709436,80],["ἁμαρτωλῶν",700776,169],["ἐπὶ",705080,0],["τὸν",709436,5],["κλῆρον",707727,6],["τῶν",709436,80],["δικαίων",703694,169],["ὅπως",709719,7],["ἂν",700900,11],["μὴ",708851,28],["ἐκτείνωσιν",704322,234],["οἱ",709436,136],["δίκαιοι",703694,138],["ἐν",704639,0],["ἀνομίᾳ",701192,1],["χεῖρας",713787,39],["αὐτῶν",702165,565]],"For the Lord will not allow the rod of sinners to be upon the lot of the righteous; lest the righteous should stretch forth their hands to iniquity."],["4",[["ἀγάθυνον",700109,176],["κύριε",707996,153],["τοῖς",709436,147],["ἀγαθοῖς",700106,230],["καὶ",707031,7],["τοῖς",709436,147],["εὐθέσι",705602,230],["τῇ",709436,100],["καρδίᾳ",707141,1]],"Do good, O Lord, to them [that are] good, and to them [that are] upright in heart."],["5",[["τοὺς",709436,58],["δὲ",703303,11],["ἐκκλίνοντας",704220,235],["εἰς",704105,0],["τὰς",709436,38],["στραγγαλιὰς",712133,39],["ἀπάξει",701324,127],["κύριος",707996,4],["μετὰ",708780,0],["τῶν",709436,80],["ἐργαζομέ