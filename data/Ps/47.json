[["1",[["ψαλμὸς",714022,4],["ᾠδῆς",714091,17],["τοῖς",709436,147],["υἱοῖς",713075,148],["Κορε",707833,118],["δευτέρᾳ",703389,101],["σαββάτου",711350,21]],"A Psalm of praise for the sons of Core on the second [day] of the week."],["2",[["μέγας",708653,14],["κύριος",707996,4],["καὶ",707031,7],["αἰνετὸς",700458,14],["σφόδρα",712586,28],["ἐν",704639,0],["πόλει",710612,1],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["ὄρει",709768,54],["ἁγίῳ",700159,97],["αὐτοῦ",702165,102]],"Great is the Lord, and greatly to be praised in the city of our God, in his holy mountain."],["3",[["εὖ",705544,28],["ῥιζῶν",711260,65],["ἀγαλλιάματι",700112,54],["πάσης",710177,82],["τῆς",709436,16],["γῆς",703083,17],["ὄρη",709768,64],["Σιων",711816,17],["τὰ",709436,63],["πλευρὰ",710525,64],["τοῦ",709436,35],["βορρᾶ",702765,18],["ἡ",709436,10],["πόλις",710612,12],["τοῦ",709436,35],["βασιλέως",702580,18],["τοῦ",709436,35],["μεγάλου",708653,116]],"The city of the great King is well planted [on] the mountains of Sion, with the joy of the whole earth, [on] the sides of the north."],["4",[["ὁ",709436,3],["θεὸς",706192,4],["ἐν",704639,0],["ταῖς",709436,75],["βάρεσιν",702542,76],["αὐτῆς",702165,86],["γινώσκεται",703105,117],["ὅταν",709801,28],["ἀντιλαμβάνηται",701243,428],["αὐτῆς",702165,86]],"God is known in her palaces, when he undertakes to help her."],["5",[["ὅτι",709803,7],["ἰδοὺ",706497,88],["οἱ",709436,136],["βασιλεῖς",702580,52],["συνήχθησαν",712375,99],["ἤλθοσαν",705453,150],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτό",702165,129]],"For, behold, the kings of the earth were assembled, they came together."],["6",[["αὐτοὶ",702165,201],["ἰδόντες",709725,196],["οὕτως",709859,28],["ἐθαύμασαν",706135,150],["ἐταράχθησαν",712721,99],["ἐσαλεύθησαν",711403,99]],"They saw, and so they wondered: they were troubled, they were moved."],["7",[["τρόμος",712975,4],["ἐπελάβετο",705185,23],["αὐτῶν",702165,40],["ἐκεῖ",704181,28],["ὠδῖνες",714094,191],["ὡς",714148,7],["τικτούσης",712853,222]],"Trembling took hold on them: there were the pangs as of a woman in travail."],["8",[["ἐν",704639,0],["πνεύματι",710566,54],["βιαίῳ",702714,97],["συντρίψεις",712520,166],["πλοῖα",710556,42],["Θαρσις",706124,118]],"Thou wilt break the ships of Tharsis with a vehement wind."],["9",[["καθάπερ",706984,28],["ἠκούσαμεν",700587,289],["οὕτως",709859,28],["εἴδομεν",709725,289],["ἐν",704639,0],["πόλει",710612,1],["κυρίου",707996,18],["τῶν",709436,130],["δυνάμεων",703839,65],["ἐν",704639,0],["πόλει",710612,1],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["ὁ",709436,3],["θεὸς",706192,4],["ἐθεμελίωσεν",706182,2],["αὐτὴν",702165,104],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["διάψαλμα",703641,15]],"As we have heard, so have we also seen, in the city of the Lord of hosts, in the city of our God: God has founded it for ever. Pause."],["10",[["ὑπελάβομεν",713210,289],["ὁ",709436,3],["θεός",706192,4],["τὸ",709436,24],["ἔλεός",704426,25],["σου",711945,133],["ἐν",704639,0],["μέσῳ",708768,30],["τοῦ",709436,35],["ναοῦ",709191,18],["σου",711945,133]],"We have thought of thy mercy, O God, in the midst of thy people."],["11",[["κατὰ",707200,0],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["ὁ",709436,3],["θεός",706192,4],["οὕτως",709859,28],["καὶ",707031,28],["ἡ",709436,10],["αἴνεσίς",700457,12],["σου",711945,133],["ἐπὶ",705080,0],["τὰ",709436,41],["πέρατα",710281,42],["τῆς",709436,16],["γῆς",703083,17],["δικαιοσύνης",703695,17],["πλήρης",710541,29],["ἡ",709436,10],["δεξιά",703360,29],["σου",711945,133]],"According to thy name, O God, so is also thy praise to the ends of the earth: thy right hand is full of righteousness."],["12",[["εὐφρανθήτω",705715,22],["τὸ",709436,34],["ὄρος",709768,15],["Σιων",711816,17],["ἀγαλλιάσθωσαν",700114,77],["αἱ",709436,190],["θυγατέρες",706320,191],["τῆς",709436,16],["Ιουδαίας",706769,17],["ἕνεκεν",704709,0],["τῶν",709436,43],["κριμάτων",707903,44],["σου",711945,133],["κύριε",707996,153]],"Let mount Sion rejoice, let the daughters of Judæa exult, because of thy judgments, O Lord."],["13",[["κυκλώσατε",707958,74],["Σιων",711816,9],["καὶ",707031,7],["περιλάβετε",710342,74],["αὐτήν",702165,104],["διηγήσασθε",703679,345],["ἐν",704639,0],["τοῖς",709436,147],["πύργοις",711092,148],["αὐτῆς",702165,86]],"Go round about Sion, and encompass her: tell ye her towers."],["14",[["θέσθε",712849,186],["τὰς",709436,38],["καρδίας",707141,39],["ὑμῶν",713091,145],["εἰς",704105,0],["τὴν",709436,8],["δύναμιν",703839,9],["αὐτῆς",702165,86],["καὶ",707031,7],["καταδιέλεσθε",707240,186],["τὰς",709436,38],["βάρεις",702542,39],["αὐτῆς",702165,86],["ὅπως",709719,7],["ἂν",700900,11],["διηγήσησθε",703679,142],["εἰς",704105,0],["γενεὰν",703037,9],["ἑτέραν",705535,36]],"Mark ye well her strength, and observe her palaces; that ye may tell the next generation."],["15",[["ὅτι",709803,7],["οὗτός",709858,121],["ἐστιν",704093,91],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18],["αὐτὸς",702165,121],["ποιμανεῖ",710594,127],["ἡμᾶς",705981,194],["εἰς",704105,0],["τοὺς",709436,58],["αἰῶνας",700504,57]],"For this is our God for ever and ever: he will be our guide for evermore."]]