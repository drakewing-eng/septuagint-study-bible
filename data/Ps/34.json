[["1",[["τῷ",709436,113],["Δαυιδ",703232,114],["δίκασον",703691,176],["κύριε",707996,153],["τοὺς",709436,58],["ἀδικοῦντάς",700269,235],["με",708618,163],["πολέμησον",710601,176],["τοὺς",709436,58],["πολεμοῦντάς",710601,235],["με",708618,163]],"[A Psalm] of David. Judge thou, O Lord, them that injure me, fight against them that fight against me."],["2",[["ἐπιλαβοῦ",705185,300],["ὅπλου",709704,21],["καὶ",707031,7],["θυρεοῦ",706338,18],["καὶ",707031,7],["ἀνάστηθι",701173,176],["εἰς",704105,0],["βοήθειάν",702745,9],["μου",709032,133]],"Take hold of shield and buckler, and arise for my help."],["3",[["ἔκχεον",704368,176],["ῥομφαίαν",711291,9],["καὶ",707031,7],["σύγκλεισον",712223,176],["ἐξ",704132,0],["ἐναντίας",704656,82],["τῶν",709436,80],["καταδιωκόντων",707243,170],["με",708618,163],["εἰπὸν",705373,150],["τῇ",709436,100],["ψυχῇ",714070,1],["μου",709032,133],["σωτηρία",712658,12],["σου",711945,133],["ἐγώ",704018,164],["εἰμι",704093,157]],"Bring forth a sword, and stop [the way] against them that persecute me: say to my soul, I am thy salvation."],["4",[["αἰσχυνθήτωσαν",700485,51],["καὶ",707031,7],["ἐντραπήτωσαν",704805,51],["οἱ",709436,136],["ζητοῦντες",705879,146],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἀποστραφήτωσαν",701598,51],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,0],["καὶ",707031,7],["καταισχυνθήτωσαν",707257,51],["οἱ",709436,136],["λογιζόμενοί",708232,348],["μοι",708974,159],["κακά",707066,68]],"Let them that seek my soul be ashamed and confounded: let them that devise evils against me be turned back and put to shame."],["5",[["γενηθήτωσαν",703104,51],["ὡσεὶ",714159,28],["χνοῦς",713883,4],["κατὰ",707200,0],["πρόσωπον",710986,25],["ἀνέμου",701123,18],["καὶ",707031,7],["ἄγγελος",700140,4],["κυρίου",707996,18],["ἐκθλίβων",704199,72],["αὐτούς",702165,62]],"Let them be as dust before the wind, and an angel of the Lord afflicting them."],["6",[["γενηθήτω",703104,22],["ἡ",709436,10],["ὁδὸς",709458,12],["αὐτῶν",702165,40],["σκότος",711889,15],["καὶ",707031,7],["ὀλίσθημα",709580,15],["καὶ",707031,7],["ἄγγελος",700140,4],["κυρίου",707996,18],["καταδιώκων",707243,72],["αὐτούς",702165,62]],"Let their way be dark and slippery, and an angel of the Lord persecuting them."],["7",[["ὅτι",709803,7],["δωρεὰν",703900,9],["ἔκρυψάν",707923,150],["μοι",708974,159],["διαφθορὰν",703625,9],["παγίδος",709910,17],["αὐτῶν",702165,40],["μάτην",708582,28],["ὠνείδισαν",709655,150],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133]],"For without cause they have hid for me their destructive snare: without a cause they have reproached my soul."],["8",[["ἐλθέτω",705453,45],["αὐτοῖς",702165,151],["παγίς",709910,12],["ἣν",709781,131],["οὐ",709805,28],["γινώσκουσιν",703105,197],["καὶ",707031,7],["ἡ",709436,10],["θήρα",706244,12],["ἣν",709781,131],["ἔκρυψαν",707923,150],["συλλαβέτω",712262,45],["αὐτούς",702165,62],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["παγίδι",709910,1],["πεσοῦνται",710481,135],["ἐν",704639,0],["αὐτῇ",702165,105]],"Let a snare which they know not come upon them: and the gin which they hid take them; and let them fall into the very same snare."],["9",[["ἡ",709436,10],["δὲ",703303,11],["ψυχή",714070,12],["μου",709032,133],["ἀγαλλιάσεται",700114,93],["ἐπὶ",705080,0],["τῷ",709436,113],["κυρίῳ",707996,114],["τερφθήσεται",712804,134],["ἐπὶ",705080,0],["τῷ",709436,53],["σωτηρίῳ",712659,54],["αὐτοῦ",702165,102]],"But my soul shall exult in the Lord: it shall delight in his salvation."],["10",[["πάντα",710177,195],["τὰ",709436,63],["ὀστᾶ",709792,64],["μου",709032,133],["ἐροῦσιν",705415,218],["κύριε",707996,153],["τίς",712867,158],["ὅμοιός",709626,14],["σοι",711925,159],["ῥυόμενος",711309,122],["πτωχὸν",711076,6],["ἐκ",704132,0],["χειρὸς",713787,17],["στερεωτέρων",712075,169],["αὐτοῦ",702165,102],["καὶ",707031,7],["πτωχὸν",711076,6],["καὶ",707031,7],["πένητα",710248,6],["ἀπὸ",701425,0],["τῶν",709436,80],["διαρπαζόντων",703562,170],["αὐτόν",702165,85]],"All my bones shall say, O Lord, who is like to thee? delivering the poor out of the hand of them that are stronger than he, yea, the poor and needy one from them that spoil him."],["11",[["ἀναστάντες",701173,196],["μάρτυρες",708527,52],["ἄδικοι",700272,138],["ἃ",709781,69],["οὐκ",709805,28],["ἐγίνωσκον",703105,137],["ἠρώτων",705458,81],["με",708618,163]],"Unjust witnesses arose, and asked me of things I knew not."],["12",[["ἀνταπεδίδοσάν",701215,137],["μοι",708974,159],["πονηρὰ",710660,68],["ἀντὶ",701227,0],["καλῶν",707097,169],["καὶ",707031,7],["ἀτεκνίαν",702079,9],["τῇ",709436,100],["ψυχῇ",714070,1],["μου",709032,133]],"They rewarded me evil for good, and bereavement to my soul."],["13",[["ἐγὼ",704018,164],["δὲ",703303,11],["ἐν",704639,0],["τῷ",709436,113],["αὐτοὺς",702165,62],["παρενοχλεῖν",710135,55],["μοι",708974,159],["ἐνεδυόμην",704701,334],["σάκκον",711386,6],["καὶ",707031,7],["ἐταπείνουν",712717,333],["ἐν",704639,0],["νηστείᾳ",709303,1],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["προσευχή",710892,12],["μου",709032,133],["εἰς",704105,0],["κόλπον",707800,6],["μου",709032,133],["ἀποστραφήσεται",701598,134]],"But I, when they troubled me, put on sackcloth, and humbled my soul with fasting: and my prayer shall return to my [own] bosom."],["14",[["ὡς",714148,7],["πλησίον",710547,28],["ὡς",714148,7],["ἀδελφὸν",700249,6],["ἡμέτερον",705987,27],["οὕτως",709859,28],["εὐηρέστουν",705554,137],["ὡς",714148,7],["πενθῶν",710251,72],["καὶ",707031,7],["σκυθρωπάζων",711896,72],["οὕτως",709859,28],["ἐταπεινούμην",712717,334]],"I behaved agreeably towards them as [if it had been] our neighbour [or] brother: I humbled myself as one mourning and sad of countenance."],["15",[["καὶ",707031,7],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["ηὐφράνθησαν",705715,99],["καὶ",707031,7],["συνήχθησαν",712375,99],["συνήχθησαν",712375,99],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["μάστιγες",708568,191],["καὶ",707031,7],["οὐκ",709805,28],["ἔγνων",703105,155],["διεσχίσθησαν",703598,99],["καὶ",707031,7],["οὐ",709805,28],["κατενύγησαν",707347,99]],"Yet they rejoiced against me, and plagues were plentifully brought against me, and I knew [it] not: they were scattered, but repented not."],["16",[["ἐπείρασάν",710225,150],["με",708618,163],["ἐξεμυκτήρισάν",704263,99],["με",708618,163],["μυκτηρισμόν",709053,6],["ἔβρυξαν",702822,150],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["τοὺς",709436,58],["ὀδόντας",709461,57],["αὐτῶν",702165,40]],"They tempted me, they sneered at me most contemptuously, they gnashed their teeth upon me."],["17",[["κύριε",707996,153],["πότε",710696,28],["ἐπόψῃ",705057,123],["ἀποκατάστησον",701470,176],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἀπὸ",701425,0],["τῆς",709436,16],["κακουργίας",707069,17],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["λεόντων",708171,81],["τὴν",709436,8],["μονογενῆ",708996,36],["μου",709032,133]],"O Lord, when wilt thou look upon me? Deliver my soul from their mischief, mine only-begotten one from the lions."],["18",[["ἐξομολογήσομαί",704960,181],["σοι",711925,159],["κύριε",707996,153],["ἐν",704639,0],["ἐκκλησίᾳ",704216,1],["πολλῇ",710646,101],["ἐν",704639,0],["λαῷ",708094,114],["βαρεῖ",702554,30],["αἰνέσω",700459,165],["σε",711598,163]],"I will give thanks to thee even in a great congregation: in an abundant people I will praise thee."],["19",[["μὴ",708851,28],["ἐπιχαρείησάν",705330,393],["μοι",708974,159],["οἱ",709436,136],["ἐχθραίνοντές",705776,146],["μοι",708974,159],["ἀδίκως",700273,28],["οἱ",709436,136],["μισοῦντές",708935,146],["με",708618,163],["δωρεὰν",703900,9],["καὶ",707031,7],["διανεύοντες",703524,146],["ὀφθαλμοῖς",709870,148]],"Let not them that are mine enemies without a cause rejoice against me; who hate me for nothing, and wink with their eyes."],["20",[["ὅτι",709803,7],["ἐμοὶ",704577,159],["μὲν",708730,11],["εἰρηνικὰ",704099,68],["ἐλάλουν",708071,137],["καὶ",707031,7],["ἐπ᾿",705080,0],["ὀργὴν",709728,9],["δόλους",703787,57],["διελογίζοντο",703505,139]],"For to me they spoke peaceably, but imagined deceits in [their] anger."],["21",[["καὶ",707031,7],["ἐπλάτυναν",710508,150],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["τὸ",709436,24],["στόμα",712125,25],["αὐτῶν",702165,40],["εἶπαν",705373,150],["εὖγε",705557,28],["εὖγε",705557,28],["εἶδαν",709725,150],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["ἡμῶν",705999,145]],"And they opened wide their mouth upon me; they said, Aha, aha, our eyes have seen [it]."],["22",[["εἶδες",709725,162],["κύριε",707996,153],["μὴ",708851,28],["παρασιωπήσῃς",710102,175],["κύριε",707996,153],["μὴ",708851,28],["ἀποστῇς",702214,175],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133]],"Thou hast seen [it], O Lord: keep not silence: O Lord, withdraw not [thyself] from me."],["23",[["ἐξεγέρθητι",704889,244],["κύριε",707996,153],["καὶ",707031,7],["πρόσχες",710895,176],["τῇ",709436,100],["κρίσει",707908,1],["μου",709032,133],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["καὶ",707031,7],["ὁ",709436,3],["κύριός",707996,4],["μου",709032,133],["εἰς",704105,0],["τὴν",709436,8],["δίκην",703702,9],["μου",709032,133]],"Awake, O Lord, and attend to my judgment, [even] to my cause, my God and my Lord."],["24",[["κρῖνόν",707905,176],["με",708618,163],["κατὰ",707200,0],["τὴν",709436,8],["δικαιοσύνην",703695,9],["σου",711945,133],["κύριε",707996,153],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["καὶ",707031,7],["μὴ",708851,28],["ἐπιχαρείησάν",705330,393],["μοι",708974,159]],"Judge me, O Lord, according to thy righteousness, O Lord my God; and let them not rejoice against me."],["25",[["μὴ",708851,28],["εἴπαισαν",705415,393],["ἐν",704639,0],["καρδίαις",707141,76],["αὐτῶν",702165,40],["εὖγε",705557,28],["εὖγε",705557,28],["τῇ",709436,100],["ψυχῇ",714070,1],["ἡμῶν",705999,145],["μηδὲ",708855,7],["εἴπαισαν",705415,393],["κατεπίομεν",707374,289],["αὐτόν",702165,85]],"Let them not say in their hearts, Aha, aha, [it is pleasing] to our soul: neither let them say, We have devoured him."],["26",[["αἰσχυνθείησαν",700485,393],["καὶ",707031,7],["ἐντραπείησαν",704805,393],["ἅμα",700745,28],["οἱ",709436,136],["ἐπιχαίροντες",705330,146],["τοῖς",709436,147],["κακοῖς",707066,230],["μου",709032,133],["ἐνδυσάσθωσαν",704701,486],["αἰσχύνην",700483,9],["καὶ",707031,7],["ἐντροπὴν",704809,9],["οἱ",709436,136],["μεγαλορρημονοῦντες",708637,146],["ἐπ᾿",705080,0],["ἐμέ",704555,163]],"Let them be confounded and ashamed together that rejoice at my afflictions: let them be clothed with shame and confusion that speak great swelling words against me."],["27",[["ἀγαλλιάσαιντο",700114,529],["καὶ",707031,7],["εὐφρανθείησαν",705715,393],["οἱ",709436,136],["θέλοντες",706176,146],["τὴν",709436,8],["δικαιοσύνην",703695,9],["μου",709032,133],["καὶ",707031,7],["εἰπάτωσαν",705373,264],["διὰ",703417,0],["παντός",710177,116],["μεγαλυνθήτω",708647,22],["ὁ",709436,3],["κύριος",707996,4],["οἱ",709436,136],["θέλοντες",706176,146],["τὴν",709436,8],["εἰρήνην",704098,9],["τοῦ",709436,35],["δούλου",703817,18],["αὐτοῦ",702165,102]],"Let them that rejoice in my righteousness exult and be glad: and let them say continually, The Lord be magnified, who desire the peace of his servant."],["28",[["καὶ",707031,7],["ἡ",709436,10],["γλῶσσά",703120,12],["μου",709032,133],["μελετήσει",708698,127],["τὴν",709436,8],["δικαιοσύνην",703695,9],["σου",711945,133],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["τὸν",709436,5],["ἔπαινόν",705001,6],["σου",711945,133]],"And my tongue shall meditate on thy righteousness, [and] on thy praise all the day."]]