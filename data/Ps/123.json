[["1",[["ᾠδὴ",714091,12],["τῶν",709436,80],["ἀναβαθμῶν",700904,81],["εἰ",704071,7],["μὴ",708851,28],["ὅτι",709803,7],["κύριος",707996,4],["ἦν",704093,13],["ἐν",704639,0],["ἡμῖν",705994,90],["εἰπάτω",705373,45],["δὴ",703395,11],["Ισραηλ",706839,4]],"A Song of Degrees. If it had not been that the Lord was among us, let Israel now say;"],["2",[["εἰ",704071,7],["μὴ",708851,28],["ὅτι",709803,7],["κύριος",707996,4],["ἦν",704093,13],["ἐν",704639,0],["ἡμῖν",705994,90],["ἐν",704639,0],["τῷ",709436,53],["ἐπαναστῆναι",705026,106],["ἀνθρώπους",701163,57],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194]],"if it had not been that the Lord was among us, when men rose up against us;"],["3",[["ἄρα",701666,11],["ζῶντας",705851,235],["ἂν",700900,11],["κατέπιον",707374,150],["ἡμᾶς",705981,194],["ἐν",704639,0],["τῷ",709436,53],["ὀργισθῆναι",709729,179],["τὸν",709436,5],["θυμὸν",706334,6],["αὐτῶν",702165,565],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194]],"verily they would have swallowed us up alive, when their wrath was kindled against us:"],["4",[["ἄρα",701666,11],["τὸ",709436,34],["ὕδωρ",713071,15],["κατεπόντισεν",707385,2],["ἡμᾶς",705981,194],["χείμαρρον",713783,6],["διῆλθεν",703673,2],["ἡ",709436,10],["ψυχὴ",714070,12],["ἡμῶν",705999,145]],"verily the water would have drowned us, our soul would have gone under the torrent."],["5",[["ἄρα",701666,11],["διῆλθεν",703673,2],["ἡ",709436,10],["ψυχὴ",714070,12],["ἡμῶν",705999,145],["τὸ",709436,24],["ὕδωρ",713071,15],["τὸ",709436,24],["ἀνυπόστατον",701292,27]],"Yea, our soul would have gone under the overwhelming water."],["6",[["εὐλογητὸς",705632,14],["κύριος",707996,4],["ὃς",709781,213],["οὐκ",709805,28],["ἔδωκεν",703654,2],["ἡμᾶς",705981,194],["εἰς",704105,0],["θήραν",706244,9],["τοῖς",709436,147],["ὀδοῦσιν",709461,148],["αὐτῶν",702165,565]],"Blessed be the Lord, who has not given us for a prey to their teeth."],["7",[["ἡ",709436,10],["ψυχὴ",714070,12],["ἡμῶν",705999,145],["ὡς",714148,7],["στρουθίον",712166,25],["ἐρρύσθη",711309,37],["ἐκ",704132,0],["τῆς",709436,16],["παγίδος",709910,17],["τῶν",709436,80],["θηρευόντων",706248,170],["ἡ",709436,10],["παγὶς",709910,12],["συνετρίβη",712520,37],["καὶ",707031,7],["ἡμεῖς",705983,219],["ἐρρύσθημεν",711309,485]],"Our soul has been delivered as a sparrow from the snare of the fowlers: the snare is broken, and we are delivered."],["8",[["ἡ",709436,10],["βοήθεια",702745,12],["ἡμῶν",705999,145],["ἐν",704639,0],["ὀνόματι",709666,54],["κυρίου",707996,18],["τοῦ",709436,35],["ποιήσαντος",710582,500],["τὸν",709436,5],["οὐρανὸν",709844,6],["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9]],"Our help is in the name of the Lord, who made heaven and earth."]]