[["1",[["αλληλουια",700688,88],["ἐξομολογεῖσθε",704960,73],["τῷ",709436,113],["κυρίῳ",707996,114],["ὅτι",709803,7],["ἀγαθός",700106,14],["ὅτι",709803,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τὸ",709436,34],["ἔλεος",704426,15],["αὐτοῦ",702165,102]],"Alleluia. Give thanks to the Lord; for [he is] good: for his mercy [endures] for ever."],["2",[["εἰπάτω",705373,45],["δὴ",703395,11],["οἶκος",709516,4],["Ισραηλ",706839,18],["ὅτι",709803,7],["ἀγαθός",700106,14],["ὅτι",709803,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τὸ",709436,34],["ἔλεος",704426,15],["αὐτοῦ",702165,102]],"Let now the house of Israel say, that [he is] good: for his mercy [endures] for ever."],["3",[["εἰπάτω",705373,45],["δὴ",703395,11],["οἶκος",709516,4],["Ααρων",700005,18],["ὅτι",709803,7],["ἀγαθός",700106,14],["ὅτι",709803,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τὸ",709436,34],["ἔλεος",704426,15],["αὐτοῦ",702165,102]],"Let now the house of Aaron say, that [he is] good: for his mercy [endures] for ever."],["4",[["εἰπάτωσαν",705373,264],["δὴ",703395,11],["πάντες",710177,138],["οἱ",709436,136],["φοβούμενοι",713532,348],["τὸν",709436,5],["κύριον",707996,6],["ὅτι",709803,7],["ἀγαθός",700106,14],["ὅτι",709803,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τὸ",709436,34],["ἔλεος",704426,15],["αὐτοῦ",702165,102]],"Let now all that fear the Lord say, that [he is] good: for his mercy [endures] for ever."],["5",[["ἐν",704639,0],["θλίψει",706276,1],["ἐπεκαλεσάμην",705153,161],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["ἐπήκουσέν",705009,2],["μου",709032,133],["εἰς",704105,0],["πλατυσμόν",710510,6]],"I called on the Lord out of affliction: and he hearkened to me, [so as to bring me] into a wide place."],["6",[["κύριος",707996,4],["ἐμοὶ",704577,159],["βοηθός",702748,4],["οὐ",709805,28],["φοβηθήσομαι",713532,180],["τί",712867,126],["ποιήσει",710582,127],["μοι",708974,159],["ἄνθρωπος",701163,4]],"The Lord is my helper; and I will not fear what man shall do to me."],["7",[["κύριος",707996,4],["ἐμοὶ",704577,159],["βοηθός",702748,4],["κἀγὼ",706969,288],["ἐπόψομαι",705057,181],["τοὺς",709436,58],["ἐχθρούς",705779,57],["μου",709032,133]],"The Lord is my helper; and I shall see [my desire] upon mine enemies."],["8",[["ἀγαθὸν",700106,27],["πεποιθέναι",710221,115],["ἐπὶ",705080,0],["κύριον",707996,6],["ἢ",705924,7],["πεποιθέναι",710221,115],["ἐπ᾿",705080,0],["ἄνθρωπον",701163,6]],"[It is] better to trust in the Lord than to trust in man."],["9",[["ἀγαθὸν",700106,26],["ἐλπίζειν",704529,55],["ἐπὶ",705080,0],["κύριον",707996,6],["ἢ",705924,7],["ἐλπίζειν",704529,55],["ἐπ᾿",705080,0],["ἄρχοντας",701862,57]],"[It is] better to hope in the Lord, than to hope in princes."],["10",[["πάντα",710177,195],["τὰ",709436,63],["ἔθνη",704068,64],["ἐκύκλωσάν",707958,150],["με",708618,163],["καὶ",707031,7],["τῷ",709436,53],["ὀνόματι",709666,54],["κυρίου",707996,18],["ἠμυνάμην",700880,161],["αὐτούς",702165,62]],"All nations compassed me about: but in the name of the Lord I repulsed them."],["11",[["κυκλώσαντες",707958,196],["ἐκύκλωσάν",707958,150],["με",708618,163],["καὶ",707031,7],["τῷ",709436,53],["ὀνόματι",709666,54],["κυρίου",707996,18],["ἠμυνάμην",700880,155],["αὐτούς",702165,62]],"They completely compassed me about: but in the name of the Lord I repulsed them."],["12",[["ἐκύκλωσάν",707958,150],["με",708618,163],["ὡσεὶ",714159,11],["μέλισσαι",708702,52],["κηρίον",707657,25],["καὶ",707031,7],["ἐξεκαύθησαν",704205,99],["ὡσεὶ",714159,11],["πῦρ",711088,25],["ἐν",704639,0],["ἀκάνθαις",700517,76],["καὶ",707031,7],["τῷ",709436,53],["ὀνόματι",709666,54],["κυρίου",707996,18],["ἠμυνάμην",700880,155],["αὐτούς",702165,62]],"They compassed me about as bees [do] a honeycomb, and they burst into flame as fire among thorns: but in the name of the Lord I repulsed them."],["13",[["ὠσθεὶς",714100,217],["ἀνετράπην",701073,156],["τοῦ",709436,20],["πεσεῖν",710481,106],["καὶ",707031,7],["ὁ",709436,3],["κύριος",707996,4],["ἀντελάβετό",701243,23],["μου",709032,133]],"I was thrust, and sorely shaken, that I might fall: but the Lord helped me."],["14",[["ἰσχύς",706858,12],["μου",709032,133],["καὶ",707031,7],["ὕμνησίς",713086,12],["μου",709032,133],["ὁ",709436,3],["κύριος",707996,4],["καὶ",707031,7],["ἐγένετό",703104,23],["μοι",708974,159],["εἰς",704105,0],["σωτηρίαν",712658,9]],"The Lord is my strength and my song, and is become my salvation."],["15",[["φωνὴ",713640,12],["ἀγαλλιάσεως",700113,17],["καὶ",707031,7],["σωτηρίας",712658,17],["ἐν",704639,0],["σκηναῖς",711845,76],["δικαίων",703694,169],["δεξιὰ",703360,29],["κυρίου",707996,18],["ἐποίησεν",710582,2],["δύναμιν",703839,9]],"The voice of exultation and salvation is in the tabernacles of the righteous: the right hand of the Lord has wrought mightily."],["16",[["δεξιὰ",703360,29],["κυρίου",707996,18],["ὕψωσέν",713289,2],["με",708618,163],["δεξιὰ",703360,29],["κυρίου",707996,18],["ἐποίησεν",710582,2],["δύναμιν",703839,9]],"The right hand of the Lord has exalted me: the right hand of the Lord has wrought powerfully."],["17",[["οὐκ",709805,28],["ἀποθανοῦμαι",701461,181],["ἀλλὰ",700680,7],["ζήσομαι",705851,181],["καὶ",707031,7],["ἐκδιηγήσομαι",704172,181],["τὰ",709436,41],["ἔργα",705396,42],["κυρίου",707996,18]],"I shall not die, but live, and recount the works of the Lord."],["18",[["παιδεύων",709926,72],["ἐπαίδευσέν",709926,2],["με",708618,163],["ὁ",709436,3],["κύριος",707996,4],["καὶ",707031,7],["τῷ",709436,113],["θανάτῳ",706096,114],["οὐ",709805,28],["παρέδωκέν",710014,2],["με",708618,163]],"The Lord has chastened me sore: but he has not given me up to death."],["19",[["ἀνοίξατέ",701186,74],["μοι",708974,159],["πύλας",711082,39],["δικαιοσύνης",703695,17],["εἰσελθὼν",704114,182],["ἐν",704639,0],["αὐταῖς",702165,200],["ἐξομολογήσομαι",704960,181],["τῷ",709436,113],["κυρίῳ",707996,114]],"Open to me the gates of righteousness: I will go into them, and give praise to the Lord."],["20",[["αὕτη",709858,107],["ἡ",709436,10],["πύλη",711082,12],["τοῦ",709436,35],["κυρίου",707996,18],["δίκαιοι",703694,138],["εἰσελεύσονται",704114,135],["ἐν",704639,0],["αὐτῇ",702165,105]],"This is the gate of the Lord: the righteous shall enter by it."],["21",[["ἐξομολογήσομαί",704960,181],["σοι",711925,159],["ὅτι",709803,7],["ἐπήκουσάς",705009,162],["μου",709032,133],["καὶ",707031,7],["ἐγένου",703104,174],["μοι",708974,159],["εἰς",704105,0],["σωτηρίαν",712658,9]],"I will give thanks to thee; because thou hast heard me, and art become my salvation."],["22",[["λίθον",708196,6],["ὃν",709781,112],["ἀπεδοκίμασαν",701451,150],["οἱ",709436,136],["οἰκοδομοῦντες",709509,146],["οὗτος",709858,121],["ἐγενήθη",703104,37],["εἰς",704105,0],["κεφαλὴν",707639,9],["γωνίας",703226,17]],"The stone which the builders rejected, the same is become the head of the corner."],["23",[["παρὰ",709995,0],["κυρίου",707996,18],["ἐγένετο",703104,23],["αὕτη",709858,107],["καὶ",707031,7],["ἔστιν",704093,91],["θαυμαστὴ",706138,29],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["ἡμῶν",705999,145]],"This has been done of the Lord; and it is wonderful in our eyes."],["24",[["αὕτη",709858,107],["ἡ",709436,10],["ἡμέρα",705984,12],["ἣν",709781,131],["ἐποίησεν",710582,2],["ὁ",709436,3],["κύριος",707996,4],["ἀγαλλιασώμεθα",700114,276],["καὶ",707031,7],["εὐφρανθῶμεν",705715,283],["ἐν",704639,0],["αὐτῇ",702165,105]],"This is the day which the Lord has made: let us exult and rejoice in it."],["25",[["ὦ",714081,88],["κύριε",707996,153],["σῶσον",712627,176],["δή",703395,11],["ὦ",714081,88],["κύριε",707996,153],["εὐόδωσον",705654,176],["δή",703395,11]],"O Lord, save now: O Lord, send now prosperity."],["26",[["εὐλογημένος",705631,419],["ὁ",709436,3],["ἐρχόμενος",705453,122],["ἐν",704639,0],["ὀνόματι",709666,54],["κυρίου",707996,18],["εὐλογήκαμεν",705631,314],["ὑμᾶς",713080,194],["ἐξ",704132,0],["οἴκου",709516,18],["κυρίου",707996,18]],"Blessed is he that comes in the name of the Lord: we have blessed you out of the house of the Lord."],["27",[["θεὸς",706192,4],["κύριος",707996,4],["καὶ",707031,7],["ἐπέφανεν",705317,2],["ἡμῖν",705994,90],["συστήσασθε",712482,186],["ἑορτὴν",704990,9],["ἐν",704639,0],["τοῖς",709436,147],["πυκάζουσιν",711080,197],["ἕως",705792,0],["τῶν",709436,43],["κεράτων",707625,44],["τοῦ",709436,20],["θυσιαστηρίου",706348,21]],"God is the Lord, and he has shined upon us: celebrate the feast with thick [branches, binding the victims] even to the horns of the altar."],["28",[["θεός",706192,4],["μου",709032,133],["εἶ",704093,154],["σύ",712181,164],["καὶ",707031,7],["ἐξομολογήσομαί",704960,181],["σοι",711925,159],["θεός",706192,4],["μου",709032,133],["εἶ",704093,154],["σύ",712181,164],["καὶ",707031,7],["ὑψώσω",713289,165],["σε",711598,163],["ἐξομολογήσομαί",704960,181],["σοι",711925,159],["ὅτι",709803,7],["ἐπήκουσάς",705009,162],["μου",709032,133],["καὶ",707031,7],["ἐγένου",703104,174],["μοι",708974,159],["εἰς",704105,0],["σωτηρίαν",712658,9]],"Thou art my God, and I will give thee thanks: thou art my God, and I will exalt thee. I will give thanks to thee, for thou hast heard me, and art become my salvation."],["29",[["ἐξομολογεῖσθε",704960,374],["τῷ",709436,113],["κυρίῳ",707996,114],["ὅτι",709803,7],["ἀγαθός",700106,14],["ὅτι",709803,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τὸ",709436,34],["ἔλεος",704426,15],["αὐτοῦ",702165,102]],"Give thanks to the Lord; for he is good: for his mercy [endures] for ever."]]