[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, a Psalm of David."],["2",[["μακάριος",708397,14],["ὁ",709436,3],["συνίων",712481,72],["ἐπὶ",705080,0],["πτωχὸν",711076,6],["καὶ",707031,7],["πένητα",710248,6],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["πονηρᾷ",710660,101],["ῥύσεται",711309,93],["αὐτὸν",702165,85],["ὁ",709436,3],["κύριος",707996,4]],"Blessed [is the man] who thinks on the poor and needy: the Lord shall deliver him in an evil day."],["3",[["κύριος",707996,4],["διαφυλάξαι",703632,106],["αὐτὸν",702165,85],["καὶ",707031,7],["ζήσαι",705851,300],["αὐτὸν",702165,85],["καὶ",707031,7],["μακαρίσαι",708396,300],["αὐτὸν",702165,5],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["καὶ",707031,7],["μὴ",708851,28],["παραδῴη",710014,225],["αὐτὸν",702165,85],["εἰς",704105,0],["χεῖρας",713787,39],["ἐχθροῦ",705779,18],["αὐτοῦ",702165,102]],"May the Lord preserve him and keep him alive, and bless him on the earth, and not deliver him into the hands of his enemy."],["4",[["κύριος",707996,4],["βοηθήσαι",702746,300],["αὐτῷ",702165,50],["ἐπὶ",705080,0],["κλίνης",707737,17],["ὀδύνης",709463,17],["αὐτοῦ",702165,102],["ὅλην",709597,36],["τὴν",709436,8],["κοίτην",707781,9],["αὐτοῦ",702165,102],["ἔστρεψας",712160,162],["ἐν",704639,0],["τῇ",709436,100],["ἀρρωστίᾳ",701813,1],["αὐτοῦ",702165,102]],"May the Lord help him upon the bed of his pain; thou hast made all his bed in his sickness."],["5",[["ἐγὼ",704018,164],["εἶπα",705373,155],["κύριε",707996,153],["ἐλέησόν",704418,176],["με",708618,163],["ἴασαι",706424,300],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ὅτι",709803,7],["ἥμαρτόν",700773,155],["σοι",711925,159]],"I said, O Lord, have mercy upon me; heal my soul; for I have sinned against thee."],["6",[["οἱ",709436,136],["ἐχθροί",705779,52],["μου",709032,133],["εἶπαν",705373,150],["κακά",707066,68],["μοι",708974,159],["πότε",710696,28],["ἀποθανεῖται",701461,93],["καὶ",707031,7],["ἀπολεῖται",701513,93],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102]],"Mine enemies have spoken evil against me, [saying], When shall he die, and his name perish?"],["7",[["καὶ",707031,7],["εἰ",704071,7],["εἰσεπορεύετο",704124,19],["τοῦ",709436,20],["ἰδεῖν",709725,106],["μάτην",708582,28],["ἐλάλει",708071,13],["ἡ",709436,10],["καρδία",707141,12],["αὐτοῦ",702165,102],["συνήγαγεν",712375,2],["ἀνομίαν",701192,9],["ἑαυτῷ",703917,50],["ἐξεπορεύετο",704293,19],["ἔξω",704983,28],["καὶ",707031,7],["ἐλάλει",708071,13]],"And if he came to see [me], his heart spoke vainly; he gathered iniquity to himself; he went forth and spoke in like manner."],["8",[["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτὸ",702165,129],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["ἐψιθύριζον",714053,137],["πάντες",710177,138],["οἱ",709436,136],["ἐχθροί",705779,52],["μου",709032,133],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["ἐλογίζοντο",708232,139],["κακά",707066,68],["μοι",708974,159]],"All my enemies whispered against me; against me they devised my hurt."],["9",[["λόγον",708236,6],["παράνομον",710080,27],["κατέθεντο",707458,189],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["μὴ",708851,28],["ὁ",709436,3],["κοιμώμενος",707767,122],["οὐχὶ",709862,28],["προσθήσει",710965,127],["τοῦ",709436,20],["ἀναστῆναι",701173,106]],"They denounced a wicked word against me, [saying], Now that he lies, shall he not rise up again?"],["10",[["καὶ",707031,7],["γὰρ",702963,11],["ὁ",709436,3],["ἄνθρωπος",701163,4],["τῆς",709436,16],["εἰρήνης",704098,17],["μου",709032,133],["ἐφ᾿",705080,0],["ὃν",709781,112],["ἤλπισα",704529,155],["ὁ",709436,3],["ἐσθίων",705495,72],["ἄρτους",701829,57],["μου",709032,133],["ἐμεγάλυνεν",708647,2],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["πτερνισμόν",711053,6]],"For even the man of my peace, in whom I trusted, who ate my bread, lifted up [his] heel against me."],["11",[["σὺ",712181,164],["δέ",703303,11],["κύριε",707996,153],["ἐλέησόν",704418,176],["με",708618,163],["καὶ",707031,7],["ἀνάστησόν",701173,176],["με",708618,163],["καὶ",707031,7],["ἀνταποδώσω",701215,165],["αὐτοῖς",702165,151]],"But thou, O Lord, have compassion upon me, and raise me up, and I shall requite them."],["12",[["ἐν",704639,0],["τούτῳ",709858,50],["ἔγνων",703105,155],["ὅτι",709803,7],["τεθέληκάς",706176,266],["με",708618,163],["ὅτι",709803,7],["οὐ",709805,28],["μὴ",708851,28],["ἐπιχαρῇ",705330,384],["ὁ",709436,3],["ἐχθρός",705779,4],["μου",709032,133],["ἐπ᾿",705080,0],["ἐμέ",704555,163]],"By this I know that thou hast delighted in me, because mine enemy shall not rejoice over me."],["13",[["ἐμοῦ",704580,133],["δὲ",703303,11],["διὰ",703417,0],["τὴν",709436,8],["ἀκακίαν",700511,9],["ἀντελάβου",701243,174],["καὶ",707031,7],["ἐβεβαίωσάς",702610,162],["με",708618,163],["ἐνώπιόν",704823,0],["σου",711945,133],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"But thou didst help me because of [mine] innocence, and hast established me before thee for ever."],["14",[["εὐλογητὸς",705632,14],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ἀπὸ",701425,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["γένοιτο",703104,382],["γένοιτο",703104,382]],"Blessed [be] the Lord God of Israel from everlasting, and to everlasting. So be it, so be it."]]