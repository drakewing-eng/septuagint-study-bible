[["1",[["ᾠδὴ",714091,12],["τῶν",709436,80],["ἀναβαθμῶν",700904,81],["εὐφράνθην",705715,156],["ἐπὶ",705080,0],["τοῖς",709436,147],["εἰρηκόσιν",705415,536],["μοι",708974,159],["εἰς",704105,0],["οἶκον",709516,6],["κυρίου",707996,18],["πορευσόμεθα",710667,141]],"A Song of Degrees. I was glad when they said to me, Let us go into the house of the Lord."],["2",[["ἑστῶτες",706846,268],["ἦσαν",704093,137],["οἱ",709436,136],["πόδες",710707,52],["ἡμῶν",705999,145],["ἐν",704639,0],["ταῖς",709436,75],["αὐλαῖς",702137,76],["σου",711945,133],["Ιερουσαλημ",706644,258]],"Our feet stood in thy courts, O Jerusalem."],["3",[["Ιερουσαλημ",706644,12],["οἰκοδομουμένη",709509,211],["ὡς",714148,7],["πόλις",710612,12],["ἧς",709781,167],["ἡ",709436,10],["μετοχὴ",708838,12],["αὐτῆς",702165,547],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτό",702165,684]],"Jerusalem is built as a city whose fellowship is complete."],["4",[["ἐκεῖ",704181,28],["γὰρ",702963,11],["ἀνέβησαν",700905,150],["αἱ",709436,190],["φυλαί",713620,191],["φυλαὶ",713620,191],["κυρίου",707996,18],["μαρτύριον",708525,25],["τῷ",709436,113],["Ισραηλ",706839,114],["τοῦ",709436,20],["ἐξομολογήσασθαι",704960,109],["τῷ",709436,53],["ὀνόματι",709666,54],["κυρίου",707996,18]],"For thither the tribes went up, the tribes of the Lord, as a testimony for Israel, to give thanks unto the name of the Lord."],["5",[["ὅτι",709803,7],["ἐκεῖ",704181,28],["ἐκάθισαν",707006,150],["θρόνοι",706315,52],["εἰς",704105,0],["κρίσιν",707908,9],["θρόνοι",706315,52],["ἐπὶ",705080,0],["οἶκον",709516,6],["Δαυιδ",703232,18]],"For there are set thrones for judgment, [even] thrones for the house of David."],["6",[["ἐρωτήσατε",705459,74],["δὴ",703395,11],["τὰ",709436,41],["εἰς",704105,0],["εἰρήνην",704098,9],["τὴν",709436,8],["Ιερουσαλημ",706644,17],["καὶ",707031,7],["εὐθηνία",705595,12],["τοῖς",709436,147],["ἀγαπῶσίν",700120,349],["σε",711598,163]],"Pray now for the peace of Jerusalem: and [let there be] prosperity to them that love thee."],["7",[["γενέσθω",703104,315],["δὴ",703395,11],["εἰρήνη",704098,12],["ἐν",704639,0],["τῇ",709436,100],["δυνάμει",703839,1],["σου",711945,133],["καὶ",707031,7],["εὐθηνία",705595,12],["ἐν",704639,0],["ταῖς",709436,75],["πυργοβάρεσίν",711091,76],["σου",711945,133]],"Let peace, I pray, be within thine host, and prosperity in thy palaces."],["8",[["ἕνεκα",704709,0],["τῶν",709436,80],["ἀδελφῶν",700249,81],["μου",709032,133],["καὶ",707031,7],["τῶν",709436,80],["πλησίον",710547,28],["μου",709032,133],["ἐλάλουν",708071,137],["δὴ",703395,11],["εἰρήνην",704098,9],["περὶ",710285,0],["σοῦ",711945,133]],"For the sake of my brethren and my neighbours, I have indeed spoken peace concerning thee."],["9",[["ἕνεκα",704709,0],["τοῦ",709436,35],["οἴκου",709516,18],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["ἐξεζήτησα",704187,155],["ἀγαθά",700106,68],["σοι",711925,159]],"Because of the house of the Lord our God, I have diligently sought thy good."]]