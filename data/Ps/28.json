[["1",[["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114],["ἐξοδίου",704946,21],["σκηνῆς",711845,17],["ἐνέγκατε",713428,74],["τῷ",709436,113],["κυρίῳ",707996,114],["υἱοὶ",713075,52],["θεοῦ",706192,18],["ἐνέγκατε",713428,74],["τῷ",709436,113],["κυρίῳ",707996,114],["υἱοὺς",713075,57],["κριῶν",707906,81],["ἐνέγκατε",713428,74],["τῷ",709436,113],["κυρίῳ",707996,114],["δόξαν",703791,9],["καὶ",707031,7],["τιμήν",712856,9]],"A Psalm of David [on the occasion] of the solemn assembly of the Tabernacle. Bring to the Lord, ye sons of God, bring to the Lord young rams; bring to the Lord glory and honour."],["2",[["ἐνέγκατε",713428,74],["τῷ",709436,113],["κυρίῳ",707996,114],["δόξαν",703791,9],["ὀνόματι",709666,54],["αὐτοῦ",702165,102],["προσκυνήσατε",710925,74],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐν",704639,0],["αὐλῇ",702137,1],["ἁγίᾳ",700159,101],["αὐτοῦ",702165,102]],"Bring to the Lord glory, [due] to his name; worship the Lord in his holy court."],["3",[["φωνὴ",713640,12],["κυρίου",707996,18],["ἐπὶ",705080,0],["τῶν",709436,43],["ὑδάτων",713071,44],["ὁ",709436,3],["θεὸς",706192,4],["τῆς",709436,16],["δόξης",703791,17],["ἐβρόντησεν",702815,2],["κύριος",707996,4],["ἐπὶ",705080,0],["ὑδάτων",713071,44],["πολλῶν",710646,83]],"The voice of the Lord is upon the waters: the God of glory has thundered: the Lord is upon many waters."],["4",[["φωνὴ",713640,12],["κυρίου",707996,18],["ἐν",704639,0],["ἰσχύι",706858,1],["φωνὴ",713640,12],["κυρίου",707996,18],["ἐν",704639,0],["μεγαλοπρεπείᾳ",708632,1]],"The voice of the Lord is mighty; the voice of the Lord is full of majesty."],["5",[["φωνὴ",713640,12],["κυρίου",707996,18],["συντρίβοντος",712520,152],["κέδρους",707590,39],["καὶ",707031,7],["συντρίψει",712520,127],["κύριος",707996,4],["τὰς",709436,38],["κέδρους",707590,39],["τοῦ",709436,35],["Λιβάνου",708185,18]],"[There is] the voice of the Lord who breaks the cedars; the Lord will break the cedars of Libanus."],["6",[["καὶ",707031,7],["λεπτυνεῖ",708154,127],["αὐτὰς",702165,231],["ὡς",714148,7],["τὸν",709436,5],["μόσχον",709029,6],["τὸν",709436,5],["Λίβανον",708185,6],["καὶ",707031,7],["ὁ",709436,3],["ἠγαπημένος",700120,419],["ὡς",714148,7],["υἱὸς",713075,4],["μονοκερώτων",708999,81]],"And he will beat them small, [even] Libanus itself, like a calf; and the beloved one is as a young unicorn."],["7",[["φωνὴ",713640,12],["κυρίου",707996,18],["διακόπτοντος",703481,152],["φλόγα",713524,9],["πυρός",711088,21]],"[There is] a voice of the Lord who divides a flame of fire."],["8",[["φωνὴ",713640,12],["κυρίου",707996,18],["συσσείοντος",712554,152],["ἔρημον",705420,9],["καὶ",707031,7],["συσσείσει",712554,127],["κύριος",707996,4],["τὴν",709436,8],["ἔρημον",705420,9],["Καδης",706973,118]],"A voice of the Lord who shakes the wilderness; the Lord will shake the wilderness of Cades."],["9",[["φωνὴ",713640,12],["κυρίου",707996,18],["καταρτιζομένου",707410,262],["ἐλάφους",704398,57],["καὶ",707031,7],["ἀποκαλύψει",701474,127],["δρυμούς",703836,57],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["ναῷ",709191,114],["αὐτοῦ",702165,102],["πᾶς",710177,14],["τις",712866,158],["λέγει",708124,91],["δόξαν",703791,9]],"The voice of the Lord strengthens the hinds, and will uncover the thickets: and in his temple every one speaks [of his] glory."],["10",[["κύριος",707996,4],["τὸν",709436,5],["κατακλυσμὸν",707279,6],["κατοικιεῖ",707538,127],["καὶ",707031,7],["καθίεται",707007,391],["κύριος",707996,4],["βασιλεὺς",702580,4],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"The Lord will dwell on the waterflood: and the Lord will sit a king for ever."],["11",[["κύριος",707996,4],["ἰσχὺν",706858,9],["τῷ",709436,113],["λαῷ",708094,114],["αὐτοῦ",702165,102],["δώσει",703654,127],["κύριος",707996,4],["εὐλογήσει",705631,127],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["ἐν",704639,0],["εἰρήνῃ",704098,1]],"The Lord will give strength to his people; the Lord will bless his people with peace."]]