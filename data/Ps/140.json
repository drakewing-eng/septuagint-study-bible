[["1",[["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114],["κύριε",707996,153],["ἐκέκραξα",707868,155],["πρὸς",710844,0],["σέ",711598,163],["εἰσάκουσόν",704108,176],["μου",709032,133],["πρόσχες",710895,176],["τῇ",709436,100],["φωνῇ",713640,1],["τῆς",709436,16],["δεήσεώς",703311,17],["μου",709032,133],["ἐν",704639,0],["τῷ",709436,53],["κεκραγέναι",707868,115],["με",708618,163],["πρὸς",710844,0],["σέ",711598,163]],"A Psalm of David. O Lord, I have cried to thee; hear me: attend to the voice of my supplication, when I cry to thee."],["2",[["κατευθυνθήτω",707521,22],["ἡ",709436,10],["προσευχή",710892,12],["μου",709032,133],["ὡς",714148,7],["θυμίαμα",706330,15],["ἐνώπιόν",704823,0],["σου",711945,133],["ἔπαρσις",705041,12],["τῶν",709436,130],["χειρῶν",713787,65],["μου",709032,133],["θυσία",706345,12],["ἑσπερινή",705501,29]],"Let my prayer be set forth before thee as incense; the lifting up of my hands [as] an evening sacrifice."],["3",[["θοῦ",712849,300],["κύριε",707996,153],["φυλακὴν",713613,9],["τῷ",709436,53],["στόματί",712125,54],["μου",709032,133],["καὶ",707031,7],["θύραν",706337,9],["περιοχῆς",710360,17],["περὶ",710285,0],["τὰ",709436,41],["χείλη",713781,42],["μου",709032,133]],"Set a watch, O Lord, on my mouth, and a strong door about my lips."],["4",[["μὴ",708851,28],["ἐκκλίνῃς",704220,205],["τὴν",709436,8],["καρδίαν",707141,9],["μου",709032,133],["εἰς",704105,0],["λόγους",708236,57],["πονηρίας",710659,17],["τοῦ",709436,20],["προφασίζεσθαι",711003,110],["προφάσεις",711004,39],["ἐν",704639,0],["ἁμαρτίαις",700775,76],["σὺν",712372,0],["ἀνθρώποις",701163,148],["ἐργαζομένοις",705383,341],["ἀνομίαν",701192,9],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["συνδυάσω",712422,165],["μετὰ",708780,0],["τῶν",709436,80],["ἐκλεκτῶν",704240,169],["αὐτῶν",702165,565]],"Incline not my heart to evil things, to employ pretexts for sins, with men who work iniquity: and let me not unite with their choice ones."],["5",[["παιδεύσει",709926,127],["με",708618,163],["δίκαιος",703694,14],["ἐν",704639,0],["ἐλέει",704426,54],["καὶ",707031,7],["ἐλέγξει",704416,127],["με",708618,163],["ἔλαιον",704380,15],["δὲ",703303,11],["ἁμαρτωλοῦ",700776,116],["μὴ",708851,28],["λιπανάτω",708215,45],["τὴν",709436,8],["κεφαλήν",707639,9],["μου",709032,133],["ὅτι",709803,7],["ἔτι",705538,28],["καὶ",707031,7],["ἡ",709436,10],["προσευχή",710892,12],["μου",709032,133],["ἐν",704639,0],["ταῖς",709436,75],["εὐδοκίαις",705566,76],["αὐτῶν",702165,565]],"The righteous shall chasten me with mercy, and reprove me: but let not the oil of the sinner anoint my head: for yet shall my prayer also be in their pleasures."],["6",[["κατεπόθησαν",707374,99],["ἐχόμενα",705785,67],["πέτρας",710443,17],["οἱ",709436,136],["κριταὶ",707910,52],["αὐτῶν",702165,565],["ἀκούσονται",700587,135],["τὰ",709436,41],["ῥήματά",711246,42],["μου",709032,133],["ὅτι",709803,7],["ἡδύνθησαν",705943,99]],"Their mighty ones have been swallowed up near the rock: they shall hear my words, for they are sweet."],["7",[["ὡσεὶ",714159,28],["πάχος",710204,4],["γῆς",703083,17],["διερράγη",703565,37],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["διεσκορπίσθη",703579,37],["τὰ",709436,41],["ὀστᾶ",709792,42],["ἡμῶν",705999,145],["παρὰ",709995,0],["τὸν",709436,5],["ᾅδην",700255,6]],"As a lump of earth is crushed upon the ground, our bones have been scattered by the [mouth of] the grave."],["8",[["ὅτι",709803,7],["πρὸς",710844,0],["σέ",711598,163],["κύριε",707996,153],["κύριε",707996,153],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["μου",709032,133],["ἐπὶ",705080,0],["σὲ",711598,163],["ἤλπισα",704529,155],["μὴ",708851,28],["ἀντανέλῃς",701212,279],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133]],"For mine eyes are to thee, O Lord God: I have hoped in thee; take not away my life."],["9",[["φύλαξόν",713619,176],["με",708618,163],["ἀπὸ",701425,0],["παγίδος",709910,17],["ἧς",709781,167],["συνεστήσαντό",712482,189],["μοι",708974,159],["καὶ",707031,7],["ἀπὸ",701425,0],["σκανδάλων",711825,44],["τῶν",709436,80],["ἐργαζομένων",705383,299],["τὴν",709436,8],["ἀνομίαν",701192,9]],"Keep me from the snare which they have set for me, and from the stumbling-blocks of them that work iniquity."],["10",[["πεσοῦνται",710481,135],["ἐν",704639,0],["ἀμφιβλήστρῳ",700884,54],["αὐτοῦ",702165,559],["ἁμαρτωλοί",700776,138],["κατὰ",707200,0],["μόνας",709003,119],["εἰμὶ",704093,157],["ἐγὼ",704018,164],["ἕως",705792,0],["οὗ",709781,48],["ἂν",700900,11],["παρέλθω",710141,207]],"Sinners shall fall by their own net: I am alone until I shall escape."]]