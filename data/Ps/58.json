[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["μὴ",708851,28],["διαφθείρῃς",703624,205],["τῷ",709436,113],["Δαυιδ",703232,114],["εἰς",704105,0],["στηλογραφίαν",712093,9],["ὁπότε",709709,28],["ἀπέστειλεν",701592,2],["Σαουλ",711499,4],["καὶ",707031,7],["ἐφύλαξεν",713619,2],["τὸν",709436,5],["οἶκον",709516,6],["αὐτοῦ",702165,102],["τοῦ",709436,20],["θανατῶσαι",706097,106],["αὐτόν",702165,85]],"For the end. Destroy not: by David for a memorial, when Saul sent, and watched his house to kill him."],["2",[["ἐξελοῦ",704838,300],["με",708618,163],["ἐκ",704132,0],["τῶν",709436,80],["ἐχθρῶν",705779,81],["μου",709032,133],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,80],["ἐπανιστανομένων",705026,445],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["λύτρωσαί",708282,106],["με",708618,163]],"Deliver me from mine enemies, O God; and ransom me from those that rise up against me."],["3",[["ῥῦσαί",711309,300],["με",708618,163],["ἐκ",704132,0],["τῶν",709436,80],["ἐργαζομένων",705383,299],["τὴν",709436,8],["ἀνομίαν",701192,9],["καὶ",707031,7],["ἐξ",704132,0],["ἀνδρῶν",701150,81],["αἱμάτων",700442,44],["σῶσόν",712627,176],["με",708618,163]],"Deliver me from the workers of iniquity, and save me from bloody men."],["4",[["ὅτι",709803,7],["ἰδοὺ",706497,88],["ἐθήρευσαν",706248,150],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἐπέθεντο",705304,189],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["κραταιοί",707873,138],["οὔτε",709857,7],["ἡ",709436,10],["ἀνομία",701192,12],["μου",709032,133],["οὔτε",709857,7],["ἡ",709436,10],["ἁμαρτία",700775,12],["μου",709032,133],["κύριε",707996,153]],"For, behold, they have hunted after my soul; violent men have set upon me: neither [is it] my iniquity, nor my sin, O Lord."],["5",[["ἄνευ",701137,0],["ἀνομίας",701192,17],["ἔδραμον",712931,150],["καὶ",707031,7],["κατεύθυναν",707521,150],["ἐξεγέρθητι",704889,244],["εἰς",704105,0],["συνάντησίν",712397,9],["μου",709032,133],["καὶ",707031,7],["ἰδέ",709725,176]],"Without iniquity I ran and directed [my course aright]: awake to help me, and behold."],["6",[["καὶ",707031,7],["σύ",712181,164],["κύριε",707996,153],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,130],["δυνάμεων",703839,65],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["πρόσχες",710895,176],["τοῦ",709436,20],["ἐπισκέψασθαι",705250,109],["πάντα",710177,68],["τὰ",709436,41],["ἔθνη",704068,42],["μὴ",708851,28],["οἰκτιρήσῃς",709518,175],["πάντας",710177,60],["τοὺς",709436,58],["ἐργαζομένους",705383,236],["τὴν",709436,8],["ἀνομίαν",701192,9],["διάψαλμα",703641,15]],"And thou, Lord God of hosts, the God of Israel, draw nigh to visit all the heathen; pity not any that work iniquity. Pause."],["7",[["ἐπιστρέψουσιν",705278,218],["εἰς",704105,0],["ἑσπέραν",705500,9],["καὶ",707031,7],["λιμώξουσιν",708211,218],["ὡς",714148,7],["κύων",708004,4],["καὶ",707031,7],["κυκλώσουσιν",707958,218],["πόλιν",710612,9]],"They shall return at evening, and hunger like a dog, and go round about the city."],["8",[["ἰδοὺ",706497,88],["ἀποφθέγξονται",701634,135],["ἐν",704639,0],["τῷ",709436,53],["στόματι",712125,54],["αὐτῶν",702165,40],["καὶ",707031,7],["ῥομφαία",711291,12],["ἐν",704639,0],["τοῖς",709436,95],["χείλεσιν",713781,96],["αὐτῶν",702165,40],["ὅτι",709803,7],["τίς",712867,158],["ἤκουσεν",700587,2]],"Behold, they shall utter a voice with their mouth, and a sword is in their lips; for who, [say they], has heard?"],["9",[["καὶ",707031,7],["σύ",712181,164],["κύριε",707996,153],["ἐκγελάσῃ",704157,172],["αὐτούς",702165,62],["ἐξουδενώσεις",704969,166],["πάντα",710177,68],["τὰ",709436,41],["ἔθνη",704068,42]],"But thou, Lord, wilt laugh them to scorn; thou wilt utterly set at nought all the heathen."],["10",[["τὸ",709436,24],["κράτος",707883,25],["μου",709032,133],["πρὸς",710844,0],["σὲ",711598,163],["φυλάξω",713619,165],["ὅτι",709803,7],["ὁ",709436,3],["θεὸς",706192,4],["ἀντιλήμπτωρ",701246,4],["μου",709032,133],["εἶ",704093,154]],"I will keep my strength, [looking] to thee; for thou, O God, art my helper."],["11",[["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["τὸ",709436,34],["ἔλεος",704426,15],["αὐτοῦ",702165,102],["προφθάσει",711011,127],["με",708618,163],["ὁ",709436,3],["θεὸς",706192,4],["δείξει",703314,127],["μοι",708974,159],["ἐν",704639,0],["τοῖς",709436,147],["ἐχθροῖς",705779,148],["μου",709032,133]],"[As for] my God, his mercy shall go before me: my God will shew me [vengeance] on mine enemies."],["12",[["μὴ",708851,28],["ἀποκτείνῃς",701498,175],["αὐτούς",702165,62],["μήποτε",708882,28],["ἐπιλάθωνται",705187,232],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133],["διασκόρπισον",703579,176],["αὐτοὺς",702165,62],["ἐν",704639,0],["τῇ",709436,100],["δυνάμει",703839,1],["σου",711945,133],["καὶ",707031,7],["κατάγαγε",707232,176],["αὐτούς",702165,62],["ὁ",709436,3],["ὑπερασπιστής",713123,4],["μου",709032,133],["κύριε",707996,153]],"Slay them not, lest they forget thy law; scatter them by thy power; and bring them down, O Lord, my defender."],["13",[["ἁμαρτίαν",700775,9],["στόματος",712125,21],["αὐτῶν",702165,40],["λόγον",708236,6],["χειλέων",713781,44],["αὐτῶν",702165,40],["καὶ",707031,7],["συλλημφθήτωσαν",712262,51],["ἐν",704639,0],["τῇ",709436,100],["ὑπερηφανίᾳ",713138,1],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐξ",704132,0],["ἀρᾶς",701665,17],["καὶ",707031,7],["ψεύδους",714036,116],["διαγγελήσονται",703432,144],["συντέλειαι",712509,191]],"[For] the sin of their mouth, [and] the word of their lips, let them be even taken in their pride."],["14",[["ἐν",704639,0],["ὀργῇ",709728,1],["συντελείας",712509,17],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ὑπάρξωσιν",713104,234],["καὶ",707031,7],["γνώσονται",703105,135],["ὅτι",709803,7],["ὁ",709436,3],["θεὸς",706192,4],["δεσπόζει",703376,91],["τοῦ",709436,35],["Ιακωβ",706401,18],["τῶν",709436,43],["περάτων",710281,44],["τῆς",709436,16],["γῆς",703083,17],["διάψαλμα",703641,15]],"And for [their] cursing and falsehood shall utter destruction be denounced: [they shall fall] by the wrath of utter destruction, and shall not be; so shall they know that the God of Jacob is Lord of the ends of the earth. Pause."],["15",[["ἐπιστρέψουσιν",705278,218],["εἰς",704105,0],["ἑσπέραν",705500,9],["καὶ",707031,7],["λιμώξουσιν",708211,218],["ὡς",714148,7],["κύων",708004,4],["καὶ",707031,7],["κυκλώσουσιν",707958,218],["πόλιν",710612,9]],"They shall return at evening, and be hungry as a dog, and go round about the city."],["16",[["αὐτοὶ",702165,201],["διασκορπισθήσονται",703579,144],["τοῦ",709436,20],["φαγεῖν",713296,106],["ἐὰν",703912,7],["δὲ",703303,11],["μὴ",708851,28],["χορτασθῶσιν",713919,272],["καὶ",707031,7],["γογγύσουσιν",703144,218]],"They shall be scattered hither and thither for meat; and if they be not satisfied, they shall even murmur."],["17",[["ἐγὼ",704018,164],["δὲ",703303,11],["ᾄσομαι",700299,181],["τῇ",709436,100],["δυνάμει",703839,1],["σου",711945,133],["καὶ",707031,7],["ἀγαλλιάσομαι",700114,181],["τὸ",709436,24],["πρωὶ",711021,28],["τὸ",709436,24],["ἔλεός",704426,25],["σου",711945,133],["ὅτι",709803,7],["ἐγενήθης",703104,168],["ἀντιλήμπτωρ",701246,4],["μου",709032,133],["καὶ",707031,7],["καταφυγὴ",707485,12],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["θλίψεώς",706276,17],["μου",709032,133]],"But I will sing to thy strength, and in the morning will I exult [in] thy mercy; for thou hast been my supporter, and my refuge in the day of mine affliction."],["18",[["βοηθός",702748,4],["μου",709032,133],["σοὶ",711925,159],["ψαλῶ",714021,165],["ὅτι",709803,7],["ὁ",709436,3],["θεός",706192,4],["ἀντιλήμπτωρ",701246,4],["μου",709032,133],["εἶ",704093,154],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["τὸ",709436,34],["ἔλεός",704426,15],["μου",709032,133]],"[Thou art] my helper; to thee, my God, will I sing; thou art my supporter, O my God, [and] my mercy."]]