[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ἐν",704639,0],["ὕμνοις",713089,148],["ψαλμὸς",714022,4],["τῷ",709436,113],["Ασαφ",701894,114],["ᾠδὴ",714091,12],["πρὸς",710844,0],["τὸν",709436,5],["Ἀσσύριον",702004,6]],"For the end, among the Hymns, a Psalm for Asaph; a Song for the Assyrian."],["2",[["γνωστὸς",703141,14],["ἐν",704639,0],["τῇ",709436,100],["Ιουδαίᾳ",706769,1],["ὁ",709436,3],["θεός",706192,4],["ἐν",704639,0],["τῷ",709436,113],["Ισραηλ",706839,114],["μέγα",708653,26],["τὸ",709436,34],["ὄνομα",709666,15],["αὐτοῦ",702165,102]],"God is known in Judea; his name is great in Israel."],["3",[["καὶ",707031,7],["ἐγενήθη",703104,37],["ἐν",704639,0],["εἰρήνῃ",704098,1],["ὁ",709436,3],["τόπος",712903,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὸ",709436,34],["κατοικητήριον",707536,15],["αὐτοῦ",702165,102],["ἐν",704639,0],["Σιων",711816,1]],"And his place has been in peace, and his dwelling-place in Sion."],["4",[["ἐκεῖ",704181,28],["συνέτριψεν",712520,2],["τὰ",709436,41],["κράτη",707883,42],["τῶν",709436,43],["τόξων",712898,44],["ὅπλον",709704,25],["καὶ",707031,7],["ῥομφαίαν",711291,9],["καὶ",707031,7],["πόλεμον",710605,6],["διάψαλμα",703641,15]],"There he broke the power of the bows, the shield, and the sword, and the battle. Pause."],["5",[["φωτίζεις",713646,154],["σὺ",712181,164],["θαυμαστῶς",706140,28],["ἀπὸ",701425,0],["ὀρέων",709768,44],["αἰωνίων",700505,83]],"Thou dost wonderfully shine forth from the everlasting mountains."],["6",[["ἐταράχθησαν",712721,99],["πάντες",710177,138],["οἱ",709436,136],["ἀσύνετοι",702034,138],["τῇ",709436,100],["καρδίᾳ",707141,1],["ὕπνωσαν",713182,150],["ὕπνον",713181,6],["αὐτῶν",702165,40],["καὶ",707031,7],["οὐχ",709805,28],["εὗρον",705676,150],["οὐδὲν",709817,46],["πάντες",710177,138],["οἱ",709436,136],["ἄνδρες",701150,52],["τοῦ",709436,35],["πλούτου",710563,18],["ταῖς",709436,75],["χερσὶν",713787,76],["αὐτῶν",702165,40]],"All the simple ones in heart were troubled; all the men of wealth have slept their sleep, and have found nothing in their hands."],["7",[["ἀπὸ",701425,0],["ἐπιτιμήσεώς",705306,17],["σου",711945,133],["ὁ",709436,3],["θεὸς",706192,4],["Ιακωβ",706401,18],["ἐνύσταξαν",709390,150],["οἱ",709436,136],["ἐπιβεβηκότες",705082,268],["τοὺς",709436,58],["ἵππους",706790,57]],"At thy rebuke, O God of Jacob, the riders on horses slumbered."],["8",[["σὺ",712181,164],["φοβερὸς",713530,14],["εἶ",704093,154],["καὶ",707031,7],["τίς",712867,158],["ἀντιστήσεταί",701154,93],["σοι",711925,159],["ἀπὸ",701425,0],["τότε",712908,28],["ἡ",709436,10],["ὀργή",709728,12],["σου",711945,133]],"Thou art terrible; and who shall withstand thee, because of thine anger?"],["9",[["ἐκ",704132,0],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["ἠκούτισας",700587,162],["κρίσιν",707908,9],["γῆ",703083,12],["ἐφοβήθη",713532,37],["καὶ",707031,7],["ἡσύχασεν",706033,2]],"Thou didst cause judgment to be heard from heaven; the earth feared, and was still,"],["10",[["ἐν",704639,0],["τῷ",709436,53],["ἀναστῆναι",701173,106],["εἰς",704105,0],["κρίσιν",707908,9],["τὸν",709436,5],["θεὸν",706192,6],["τοῦ",709436,20],["σῶσαι",712627,106],["πάντας",710177,60],["τοὺς",709436,58],["πραεῖς",710725,60],["τῆς",709436,16],["γῆς",703083,17],["διάψαλμα",703641,15]],"when God arose to judgment, to save all the meek in heart. Pause."],["11",[["ὅτι",709803,7],["ἐνθύμιον",704741,26],["ἀνθρώπου",701163,18],["ἐξομολογήσεταί",704960,93],["σοι",711925,159],["καὶ",707031,7],["ἐγκατάλειμμα",703966,15],["ἐνθυμίου",704742,92],["ἑορτάσει",704988,127],["σοι",711925,159]],"For the inward thought of man shall give thanks to thee: and the memorial of his inward thought shall keep a feast to thee."],["12",[["εὔξασθε",705727,345],["καὶ",707031,7],["ἀπόδοτε",701449,74],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["ὑμῶν",713091,145],["πάντες",710177,138],["οἱ",709436,136],["κύκλῳ",707959,114],["αὐτοῦ",702165,102],["οἴσουσιν",713428,218],["δῶρα",703907,42]],"Vow, and pay [your vows] to the Lord our God; all that are round about him shall bring gifts, [even] to him that is terrible,"],["13",[["τῷ",709436,113],["φοβερῷ",713530,30],["καὶ",707031,7],["ἀφαιρουμένῳ",702177,241],["πνεύματα",710566,42],["ἀρχόντων",701862,81],["φοβερῷ",713530,30],["παρὰ",709995,0],["τοῖς",709436,147],["βασιλεῦσι",702580,148],["τῆς",709436,16],["γῆς",703083,17]],"and that takes away the spirits of princes; to him that is terrible among the kings of the earth."]]