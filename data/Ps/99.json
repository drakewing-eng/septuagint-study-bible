[["1",[["ψαλμὸς",714022,4],["εἰς",704105,0],["ἐξομολόγησιν",704961,9],["ἀλαλάξατε",700632,74],["τῷ",709436,113],["κυρίῳ",707996,114],["πᾶσα",710177,29],["ἡ",709436,10],["γῆ",703083,12]],"A Psalm for Thanksgiving. Make a joyful noise to the Lord, all the earth."],["2",[["δουλεύσατε",703814,74],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐν",704639,0],["εὐφροσύνῃ",705717,1],["εἰσέλθατε",704114,74],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["ἐν",704639,0],["ἀγαλλιάσει",700113,1]],"Serve the Lord with gladness; come before his presence with exultation."],["3",[["γνῶτε",703105,74],["ὅτι",709803,7],["κύριος",707996,4],["αὐτός",702165,121],["ἐστιν",704093,91],["ὁ",709436,3],["θεός",706192,4],["αὐτὸς",702165,121],["ἐποίησεν",710582,2],["ἡμᾶς",705981,194],["καὶ",707031,7],["οὐχ",709805,28],["ἡμεῖς",705983,219],["λαὸς",708094,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["πρόβατα",710768,64],["τῆς",709436,16],["νομῆς",709337,17],["αὐτοῦ",702165,102]],"Know that the Lord he is God; he made us, and not we ourselves; [we are] his people, and the sheep of his pasture."],["4",[["εἰσέλθατε",704114,74],["εἰς",704105,0],["τὰς",709436,38],["πύλας",711082,39],["αὐτοῦ",702165,102],["ἐν",704639,0],["ἐξομολογήσει",704961,1],["εἰς",704105,0],["τὰς",709436,38],["αὐλὰς",702137,39],["αὐτοῦ",702165,102],["ἐν",704639,0],["ὕμνοις",713089,148],["ἐξομολογεῖσθε",704960,374],["αὐτῷ",702165,50],["αἰνεῖτε",700459,87],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102]],"Enter into his gates with thanksgiving, and his courts with hymns; give thanks to him, praise his name."],["5",[["ὅτι",709803,7],["χρηστὸς",713958,14],["κύριος",707996,4],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τὸ",709436,34],["ἔλεος",704426,15],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἕως",705792,0],["γενεᾶς",703037,17],["καὶ",707031,7],["γενεᾶς",703037,17],["ἡ",709436,10],["ἀλήθεια",700656,12],["αὐτοῦ",702165,102]],"For the Lord is good, his mercy is for ever; and his truth [endures] to generation and generation."]]