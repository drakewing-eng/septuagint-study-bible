[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ὑπὲρ",713111,0],["τῆς",709436,16],["ὀγδόης",709444,82],["ψαλμὸς",714022,4],["τῷ",709436,113],["Δαυιδ",703232,114]],"For the end, a Psalm of David, upon the eighth."],["2",[["σῶσόν",712627,176],["με",708618,163],["κύριε",707996,153],["ὅτι",709803,7],["ἐκλέλοιπεν",704237,171],["ὅσιος",709782,14],["ὅτι",709803,7],["ὠλιγώθησαν",709576,99],["αἱ",709436,190],["ἀλήθειαι",700656,191],["ἀπὸ",701425,0],["τῶν",709436,80],["υἱῶν",713075,81],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"Save me, O Lord; for the godly man has failed; for truth is diminished from among the children of men."],["3",[["μάταια",708575,68],["ἐλάλησεν",708071,2],["ἕκαστος",704133,14],["πρὸς",710844,0],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102],["χείλη",713781,42],["δόλια",703783,68],["ἐν",704639,0],["καρδίᾳ",707141,1],["καὶ",707031,7],["ἐν",704639,0],["καρδίᾳ",707141,1],["ἐλάλησαν",708071,150]],"Every one has spoken vanity to his neighbour: their lips are deceitful, they have spoken with a double heart."],["4",[["ἐξολεθρεύσαι",704956,300],["κύριος",707996,4],["πάντα",710177,68],["τὰ",709436,41],["χείλη",713781,42],["τὰ",709436,41],["δόλια",703783,68],["καὶ",707031,7],["γλῶσσαν",703120,9],["μεγαλορήμονα",708639,36]],"Let the Lord destroy all the deceitful lips, and the tongue that speaks great words:"],["5",[["τοὺς",709436,58],["εἰπόντας",705415,454],["τὴν",709436,8],["γλῶσσαν",703120,9],["ἡμῶν",705999,145],["μεγαλυνοῦμεν",708647,243],["τὰ",709436,63],["χείλη",713781,64],["ἡμῶν",705999,145],["παρ᾿",709995,0],["ἡμῶν",705999,145],["ἐστιν",704093,91],["τίς",712867,158],["ἡμῶν",705999,145],["κύριός",707996,4],["ἐστιν",704093,91]],"who have said, We will magnify our tongue; our lips are our own: who is Lord of us?"],["6",[["ἀπὸ",701425,0],["τῆς",709436,16],["ταλαιπωρίας",712695,17],["τῶν",709436,80],["πτωχῶν",711076,81],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,35],["στεναγμοῦ",712065,18],["τῶν",709436,80],["πενήτων",710248,81],["νῦν",709384,28],["ἀναστήσομαι",701173,181],["λέγει",708124,91],["κύριος",707996,4],["θήσομαι",712849,181],["ἐν",704639,0],["σωτηρίᾳ",712658,1],["παρρησιάσομαι",710174,181],["ἐν",704639,0],["αὐτῷ",702165,50]],"Because of the misery of the poor, and because of the sighing of the needy, now will I arise, saith the Lord, I will set [them] in safety; I will speak [to them] thereof openly."],["7",[["τὰ",709436,63],["λόγια",708233,64],["κυρίου",707996,18],["λόγια",708233,64],["ἁγνά",700178,195],["ἀργύριον",701707,15],["πεπυρωμένον",711103,413],["δοκίμιον",703779,15],["τῇ",709436,100],["γῇ",703083,1],["κεκαθαρισμένον",706985,413],["ἑπταπλασίως",705370,28]],"The oracles of the Lord are pure oracles; as silver tried in the fire, proved [in] a furnace of earth, purified seven times."],["8",[["σύ",712181,164],["κύριε",707996,153],["φυλάξεις",713619,166],["ἡμᾶς",705981,194],["καὶ",707031,7],["διατηρήσεις",703607,166],["ἡμᾶς",705981,194],["ἀπὸ",701425,0],["τῆς",709436,16],["γενεᾶς",703037,17],["ταύτης",709858,86],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"Thou, O Lord, shalt keep us, and shalt preserve us, from this generation, and for ever."],["9",[["κύκλῳ",707959,114],["οἱ",709436,136],["ἀσεβεῖς",701909,138],["περιπατοῦσιν",710362,197],["κατὰ",707200,0],["τὸ",709436,24],["ὕψος",713288,25],["σου",711945,133],["ἐπολυώρησας",710653,162],["τοὺς",709436,58],["υἱοὺς",713075,57],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"The ungodly walk around: according to thy greatness thou hast greatly exalted the sons of men."]]