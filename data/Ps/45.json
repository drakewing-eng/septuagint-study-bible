[["1",[["εἰς",704105,0],["τὸ",709436,24],["τέλος",712787,25],["ὑπὲρ",713111,0],["τῶν",709436,80],["υἱῶν",713075,81],["Κορε",707833,118],["ὑπὲρ",713111,0],["τῶν",709436,80],["κρυφίων",707930,169],["ψαλμός",714022,4]],"For the end, for the sons of Core; a Psalm concerning secret things."],["2",[["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["καταφυγὴ",707485,12],["καὶ",707031,7],["δύναμις",703839,12],["βοηθὸς",702748,4],["ἐν",704639,0],["θλίψεσιν",706276,76],["ταῖς",709436,75],["εὑρούσαις",705676,690],["ἡμᾶς",705981,194],["σφόδρα",712586,28]],"God is our refuge and strength, a help in the afflictions that have come heavily upon us."],["3",[["διὰ",703417,0],["τοῦτο",709858,129],["οὐ",709805,28],["φοβηθησόμεθα",713532,347],["ἐν",704639,0],["τῷ",709436,53],["ταράσσεσθαι",712721,395],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["μετατίθεσθαι",708820,110],["ὄρη",709768,42],["ἐν",704639,0],["καρδίαις",707141,76],["θαλασσῶν",706069,65]],"Therefore will we not fear when the earth is troubled, and the mountains are removed into the depths of the seas."],["4",[["ἤχησαν",706045,150],["καὶ",707031,7],["ἐταράχθησαν",712721,99],["τὰ",709436,63],["ὕδατα",713071,64],["αὐτῶν",702165,40],["ἐταράχθησαν",712721,99],["τὰ",709436,63],["ὄρη",709768,64],["ἐν",704639,0],["τῇ",709436,100],["κραταιότητι",707874,1],["αὐτοῦ",702165,102],["διάψαλμα",703641,15]],"Their waters have roared and been troubled, the mountains have been troubled by his might. Pause."],["5",[["τοῦ",709436,35],["ποταμοῦ",710693,18],["τὰ",709436,63],["ὁρμήματα",709757,64],["εὐφραίνουσιν",705715,197],["τὴν",709436,8],["πόλιν",710612,9],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡγίασεν",700153,2],["τὸ",709436,24],["σκήνωμα",711849,25],["αὐτοῦ",702165,102],["ὁ",709436,3],["ὕψιστος",713287,14]],"The flowings of the river gladden the city of God: the Most High has sanctified his tabernacle."],["6",[["ὁ",709436,3],["θεὸς",706192,4],["ἐν",704639,0],["μέσῳ",708768,30],["αὐτῆς",702165,86],["οὐ",709805,28],["σαλευθήσεται",711403,134],["βοηθήσει",702746,127],["αὐτῇ",702165,105],["ὁ",709436,3],["θεὸς",706192,4],["τὸ",709436,24],["πρὸς",710844,0],["πρωί",711021,28]],"God is in the midst of her; she shall not be moved: God shall help her with his countenance."],["7",[["ἐταράχθησαν",712721,99],["ἔθνη",704068,64],["ἔκλιναν",707738,150],["βασιλεῖαι",702577,191],["ἔδωκεν",703654,2],["φωνὴν",713640,9],["αὐτοῦ",702165,102],["ἐσαλεύθη",711403,37],["ἡ",709436,10],["γῆ",703083,12]],"The nations were troubled, the kingdoms tottered: he uttered his voice, the earth shook."],["8",[["κύριος",707996,4],["τῶν",709436,130],["δυνάμεων",703839,65],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["ἀντιλήμπτωρ",701246,4],["ἡμῶν",705999,145],["ὁ",709436,3],["θεὸς",706192,4],["Ιακωβ",706401,18],["διάψαλμα",703641,15]],"The Lord of hosts is with us; the God of Jacob is our helper. Pause."],["9",[["δεῦτε",703383,28],["ἴδετε",709725,74],["τὰ",709436,41],["ἔργα",705396,42],["κυρίου",707996,18],["ἃ",709781,69],["ἔθετο",712849,23],["τέρατα",712793,42],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"Come, and behold the works of the Lord, what wonders he has achieved on the earth."],["10",[["ἀνταναιρῶν",701212,72],["πολέμους",710605,57],["μέχρι",708849,0],["τῶν",709436,43],["περάτων",710281,44],["τῆς",709436,16],["γῆς",703083,17],["τόξον",712898,25],["συντρίψει",712520,127],["καὶ",707031,7],["συγκλάσει",712216,127],["ὅπλον",709704,25],["καὶ",707031,7],["θυρεοὺς",706338,57],["κατακαύσει",707258,127],["ἐν",704639,0],["πυρί",711088,54]],"Putting an end to wars as for the ends of the earth; he will crush the bow, and break in pieces the weapon, and burn the bucklers with fire."],["11",[["σχολάσατε",712614,74],["καὶ",707031,7],["γνῶτε",703105,74],["ὅτι",709803,7],["ἐγώ",704018,164],["εἰμι",704093,157],["ὁ",709436,3],["θεός",706192,4],["ὑψωθήσομαι",713289,180],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["ὑψωθήσομαι",713289,180],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1]],"Be still, and know that I am God: I will be exalted among the nations, I will be exalted in the earth."],["12",[["κύριος",707996,4],["τῶν",709436,130],["δυνάμεων",703839,65],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["ἀντιλήμπτωρ",701246,4],["ἡμῶν",705999,145],["ὁ",709436,3],["θεὸς",706192,4],["Ιακωβ",706401,18]],"The Lord of hosts is with us; the God of Jacob is our helper."]]