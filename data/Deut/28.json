,225],["σε",711598,163],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["εἰς",704105,0],["κεφαλὴν",707639,9],["καὶ",707031,7],["μὴ",708851,28],["εἰς",704105,0],["οὐράν",709839,9],["καὶ",707031,7],["ἔσῃ",704093,123],["τότε",712908,28],["ἐπάνω",705030,28],["καὶ",707031,7],["οὐκ",709805,28],["ἔσῃ",704093,123],["ὑποκάτω",713204,28],["ἐὰν",703912,7],["ἀκούσῃς",700587,175],["τῶν",709436,130],["ἐντολῶν",704802,65],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133],["ὅσα",709788,68],["ἐγὼ",704018,164],["ἐντέλλομαί",704791,254],["σοι",711925,159],["σήμερον",711751,28],["φυλάσσειν",713619,55],["καὶ",707031,7],["ποιεῖν",710582,55]],"The Lord thy God make thee the head, and not the tail; and thou shalt then be above and thou shalt not be below, if thou wilt hearken to the voice of the Lord thy God, in all things that I charge thee this day to observe."],["14",[["οὐ",709805,28],["παραβήσῃ",709996,123],["ἀπὸ",701425,0],["πάντων",710177,169],["τῶν",709436,80],["λόγων",708236,81],["ὧν",709781,252],["ἐγὼ",704018,164],["ἐντέλλομαί",704791,254],["σοι",711925,159],["σήμερον",711751,28],["δεξιὰ",703360,68],["οὐδὲ",709816,7],["ἀριστερὰ",701749,68],["πορεύεσθαι",710667,110],["ὀπίσω",709697,0],["θεῶν",706192,81],["ἑτέρων",705535,169],["λατρεύειν",708108,55],["αὐτοῖς",702165,151]],"Thou shalt not turn aside from any of the commandments, which I charge thee this day, to the right hand or to the left, to go after other gods to serve them."],["15",[["καὶ",707031,7],["ἔσται",704093,93],["ἐὰν",703912,7],["μὴ",708851,28],["εἰσακούσῃς",704108,175],["τῆς",709436,16],["φωνῆς",713640,17],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133],["φυλάσσειν",713619,55],["καὶ",707031,7],["ποιεῖν",710582,55],["πάσας",710177,119],["τὰς",709436,38],["ἐντολὰς",704802,39],["αὐτοῦ",702165,102],["ὅσας",709788,119],["ἐγὼ",704018,164],["ἐντέλλομαί",704791,254],["σοι",711925,159],["σήμερον",711751,28],["καὶ",707031,7],["ἐλεύσονται",705453,135]