,9],["καὶ",707031,7],["τὴν",709436,8],["ἀνάλωσιν",700996,9],["ἐπὶ",705080,0],["πάντα",710177,68],["οὗ",709806,28],["ἂν",700900,11],["ἐπιβάλῃς",705083,175],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133],["ὅσα",709788,68],["ἐὰν",703912,7],["ποιήσῃς",710582,175],["ἕως",705792,7],["ἂν",700900,11],["ἐξολεθρεύσῃ",704956,172],["σε",711598,163],["καὶ",707031,7],["ἕως",705792,7],["ἂν",700900,11],["ἀπολέσῃ",701513,172],["σε",711598,163],["ἐν",704639,0],["τάχει",712750,97],["διὰ",703417,0],["τὰ",709436,41],["πονηρὰ",710660,68],["ἐπιτηδεύματά",705301,42],["σου",711945,133],["διότι",703734,7],["ἐγκατέλιπές",703967,162],["με",708618,163]],"The Lord send upon thee want, and famine, and consumption on all things on which thou shalt put thy hand, until he shall have utterly destroyed thee, and until he shall have consumed thee quickly because of thine evil devices, because thou hast forsaken me."],["21",[["προσκολλήσαι",710921,225],["κύριος",707996,4],["εἰς",704105,0],["σὲ",711598,163],["τὸν",709436,5],["θάνατον",706096,6],["ἕως",705792,7],["ἂν",700900,11],["ἐξαναλώσῃ",704861,172],["σε",711598,163],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["εἰς",704105,0],["ἣν",709781,131],["σὺ",712181,164],["εἰσπορεύῃ",704124,259],["ἐκεῖ",704181,28],["κληρονομῆσαι",707724,106],["αὐτήν",702165,104]],"The Lord cause the pestilence to cleave to thee, until he shall have consumed thee off the land into which thou goest to inherit it."],["22",[["πατάξαι",710185,106],["σε",711598,163],["κύριος",707996,4],["ἀπορίᾳ",701560,1],["καὶ",707031,7],["πυρετῷ",711094,114],["καὶ",707031,7],["ῥίγει",711259,54],["καὶ",707031,7],["ἐρεθισμῷ",705401,54],["καὶ",707031,7],["φόνῳ",713549,114],["καὶ",707031,7],["ἀνεμοφθορίᾳ",701124,1],["καὶ",707031,7],["τῇ",709436,100],["ὤχρᾳ",714176,101],["καὶ",707031,7],["καταδιώξονταί",707243,135],["σε",711598,163],["ἕως",705792,7],["ἂν",700900,11],["ἀπολέσωσίν",701513,234],["σε",711598,163]],"The Lord smite thee with distress, and fever, and cold, and inflammation, and blighting, and paleness, and they shall pursue thee until they have destroyed thee."],["23",[["καὶ",707031,7],["ἔσται",704093,93],["σοι",711925,159],["ὁ",709436,3],["οὐρανὸς",709844,4],["ὁ",709436,3],["ὑπὲρ",713111,0],["κεφαλῆς",707639,17],["σου",711945,133],["χαλκοῦς",713690,14],["καὶ",707031,7],["ἡ",709436,10],["γῆ",703083,12],["ἡ",709436,10],["ὑποκάτω",713204,0],["σου",711945,133],["σιδηρᾶ",711771,29]],"And thou shalt have over thine head a sky of brass, and the earth under thee shall be iron."],["24",[["δῴη",703654,225],["κύριος",707996,4],["τὸν",709436,5],["ὑετὸν",713074,6],["τῇ",709436,100],["γῇ",703083,1],["σου",711945,133],["κονιορτόν",707815,6],["καὶ",707031,7],["χοῦς",713930,4],["ἐκ",704132,0],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καταβήσεται",707202,93],["ἐπὶ",705080,0],["σέ",711598,163],["ἕως",705792,7],["ἂν",700900,11],["ἐκτρίψῃ",704345,172],["σε",711598,163],["καὶ",707031,7],["ἕως",705792,7],["ἂν",700900,11],["ἀπολέσῃ",701513,172],["σε",711598,163]],"The Lord thy God make the rain of thy land dust; and dust shall come down from heaven, until it shall have destroyed thee, and until it shall have quickly consumed thee."],["25",[["δῴη",703654,225],["σε",711598,163],["κύριος",707996,4],["ἐπικοπὴν",705170,9],["ἐναντίον",704654,0],["τῶν",709436,80],["ἐχθρῶν",705779,81],["σου",711945,133],["ἐν",704639,0],["ὁδῷ",709458,1],["μιᾷ",704106,101],["ἐξελεύσῃ",704909,123],["πρὸς",710844,0],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἐν",704639,0],["ἑπτὰ",705357,59],["ὁδοῖς",709458,76],["φεύξῃ",713433,123],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτῶν",702165,40],["καὶ",707031,7],["ἔσῃ",704093,123],["ἐν",704639,0],["διασπορᾷ",703585,1],["ἐν",704639,0],["πάσαις",710177,291],["ταῖς",709436,75],["βασιλείαις",702577,76],["τῆς",709436,16],["γῆς",703083,17]],"The Lord give thee up for slaughter before thine enemies: thou shalt go out against them one way, and flee from their face seven ways; and thou shalt be a dispersion in all the kingdoms of the earth."],["26",[["καὶ",707031,7],["ἔσονται",704093,135],["οἱ",709436,136],["νεκροὶ",709247,52],["ὑμῶν",713091,145],["κατάβρωμα",707217,25],["τοῖς",709436,95],["πετεινοῖς",710438,96],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["τοῖς",709436,95],["θηρίοις",706252,96],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ὁ",709436,3],["ἀποσοβῶν",701581,72]],"And your dead men shall be food to the birds of the sky, and to the beasts of the earth; and there shall be none to scare them away."],["27",[["πατάξαι",710185,106],["σε",711598,163],["κύριος",707996,4],["ἐν",704639,0],["ἕλκει",704507,54],["Αἰγυπτίῳ",700400,97],["ἐν",704639,0],["ταῖς",709436,75],["ἕδραις",704036,76],["καὶ",707031,7],["ψώρᾳ",714079,1],["ἀγρίᾳ",700191,101],["καὶ",707031,7],["κνήφῃ",707752,1],["ὥστε",714164,7],["μὴ",708851,28],["δύνασθαί",703838,110],["σε",711598,163],["ἰαθῆναι",706424,179]],"The Lord smite thee with the botch of Egypt in the seat, and with a malignant scab, and itch, so that thou canst not be healed."],["28",[["πατάξαι",710185,106],["σε",711598,163],["κύριος",707996,4],["παραπληξίᾳ",710091,1],["καὶ",707031,7],["ἀορασίᾳ",701317,1],["καὶ",707031,7],["ἐκστάσει",704314,1],["διανοίας",703531,17]],"The Lord smite thee with insanity, and blindness, and astonishment of mind."],["29",[["καὶ",707031,7],["ἔσῃ",704093,123],["ψηλαφῶν",714047,72],["μεσημβρίας",708758,17],["ὡσεὶ",714159,28],["ψηλαφήσαι",714047,225],["ὁ",709436,3],["τυφλὸς",713031,14],["ἐν",704639,0],["τῷ",709436,53],["σκότει",711889,54],["καὶ",707031,7],["οὐκ",709805,28],["εὐοδώσει",705654,127],["τὰς",709436,38],["ὁδούς",709458,39],["σου",711945,133],["καὶ",707031,7],["ἔσῃ",704093,123],["τότε",712908,28],["ἀδικούμενος",700269,466],["καὶ",707031,7],["διαρπαζόμενος",703562,122],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["σοι",711925,159],["ὁ",709436,3],["βοηθῶν",702746,72]],"And thou shalt grope at mid-day, as a blind man would grope in the darkness, and thou shalt not prosper in thy ways; and then thou shalt be unjustly treated, and plundered continually, and there shall be no helper."],["30",[["γυναῖκα",703209,9],["λήμψῃ",708076,123],["καὶ",707031,7],["ἀνὴρ",701150,4],["ἕτερος",705535,14],["ἕξει",705785,127],["αὐτήν",702165,104],["οἰκίαν",709505,9],["οἰκοδομήσεις",709509,166],["καὶ",707031,7],["οὐκ",709805,28],["οἰκήσεις",709499,166],["ἐν",704639,0],["αὐτῇ",702165,105],["ἀμπελῶνα",700872,6],["φυτεύσεις",713636,166],["καὶ",707031,7],["οὐ",709805,28],["τρυγήσεις",712996,166],["αὐτόν",702165,85]],"Thou shalt take a wife, and another man shall have her; thou shalt build a house, and thou shalt not dwell in it; thou shalt plant a vineyard, and shalt not gather the grapes of it."],["31",[["ὁ",709436,3],["μόσχος",709029,4],["σου",711945,133],["ἐσφαγμένος",712571,251],["ἐναντίον",704654,0],["σου",711945,133],["καὶ",707031,7],["οὐ",709805,28],["φάγῃ",713296,123],["ἐξ",704132,0],["αὐτοῦ",702165,102],["ὁ",709436,3],["ὄνος",709671,4],["σου",711945,133],["ἡρπασμένος",701804,251],["ἀπὸ",701425,0],["σοῦ",711945,133],["καὶ",707031,7],["οὐκ",709805,28],["ἀποδοθήσεταί",701449,134],["σοι",711925,159],["τὰ",709436,63],["πρόβατά",710768,64],["σου",711945,133],["δεδομένα",703654,443],["τοῖς",709436,147],["ἐχθροῖς",705779,148],["σου",711945,133],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["σοι",711925,159],["ὁ",709436,3],["βοηθῶν",702746,72]],"Thy calf [shall be] slain before thee, and thou shalt not eat of it; thine ass shall be violently taken away from thee, and shall not be restored to thee: thy sheep shall be given to thine enemies, and thou shalt have no helper."],["32",[["οἱ",709436,136],["υἱοί",713075,52],["σου",711945,133],["καὶ",707031,7],["αἱ",709436,190],["θυγατέρες",706320,191],["σου",711945,133],["δεδομέναι",703654,415],["ἔθνει",704068,54],["ἑτέρῳ",705535,97],["καὶ",707031,7],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["σου",711945,133],["βλέψονται",702740,135],["σφακελίζοντες",712573,146],["εἰς",704105,0],["αὐτά",702165,71],["καὶ",707031,7],["οὐκ",709805,28],["ἰσχύσει",706859,127],["ἡ",709436,10],["χείρ",713787,12],["σου",711945,133]],"Thy sons and thy daughters shall be given to another nation, and thine eyes wasting away shall look for them: thine hand shall have no strength."],["33",[["τὰ",709436,41],["ἐκφόρια",704363,42],["τῆς",709436,16],["γῆς",703083,17],["σου",711945,133],["καὶ",707031,7],["πάντας",710177,60],["τοὺς",709436,58],["πόνους",710661,57],["σου",711945,133],["φάγεται",713296,93],["ἔθνος",704068,15],["ὃ",709781,128],["οὐκ",709805,28],["ἐπίστασαι",705264,259],["καὶ",707031,7],["ἔσῃ",704093,123],["ἀδικούμενος",700269,466],["καὶ",707031,7],["τεθραυσμένος",706304,251],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39]],"A nation which thou knowest not shall eat the produce of thy land, and all thy labours; and thou shalt be injured and crushed always."],["34",[["καὶ",707031,7],["ἔσῃ",704093,123],["παράπληκτος",710090,14],["διὰ",703417,0],["τὰ",709436,41],["ὁράματα",709720,42],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["σου",711945,133],["ἃ",709781,69],["βλέψῃ",702740,123]],"And thou shalt be distracted, because of the sights of thine eyes which thou shalt see."],["35",[["πατάξαι",710185,106],["σε",711598,163],["κύριος",707996,4],["ἐν",704639,0],["ἕλκει",704507,54],["πονηρῷ",710660,97],["ἐπὶ",705080,0],["τὰ",709436,41],["γόνατα",703172,42],["καὶ",707031,7],["ἐπὶ",705080,0],["τὰς",709436,38],["κνήμας",707750,39],["ὥστε",714164,7],["μὴ",708851,28],["δύνασθαί",703838,110],["σε",711598,163],["ἰαθῆναι",706424,179],["ἀπὸ",701425,0],["ἴχνους",706873,21],["τῶν",709436,80],["ποδῶν",710707,81],["σου",711945,133],["ἕως",705792,0],["τῆς",709436,16],["κορυφῆς",707844,17],["σου",711945,133]],"The Lord smite thee with an evil sore, on the knees and the legs, so that thou shalt not be able to be healed from the sole of thy foot to the crown of thy head."],["36",[["ἀπαγάγοι",701324,225],["κύριός",707996,4],["σε",711598,163],["καὶ",707031,7],["τοὺς",709436,58],["ἄρχοντάς",701862,57],["σου",711945,133],["οὓς",709781,298],["ἐὰν",703912,7],["καταστήσῃς",707011,175],["ἐπὶ",705080,0],["σεαυτόν",711599,85],["εἰς",704105,0],["ἔθνος",704068,25],["ὃ",709781,128],["οὐκ",709805,28],["ἐπίστασαι",705264,259],["σὺ",712181,164],["καὶ",707031,7],["οἱ",709436,136],["πατέρες",710189,52],["σου",711945,133],["καὶ",707031,7],["λατρεύσεις",708108,166],["ἐκεῖ",704181,28],["θεοῖς",706192,148],["ἑτέροις",705535,230],["ξύλοις",709427,96],["καὶ",707031,7],["λίθοις",708196,148]],"The Lord carry away thee and thy princes, whom thou shalt set over thee, to a nation which neither thou nor thy fathers know; and thou shalt there serve other gods, wood and stone."],["37",[["καὶ",707031,7],["ἔσῃ",704093,123],["ἐκεῖ",704181,28],["ἐν",704639,0],["αἰνίγματι",700460,54],["καὶ",707031,7],["παραβολῇ",710003,1],["καὶ",707031,7],["διηγήματι",703680,54],["ἐν",704639,0],["πᾶσιν",710177,94],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["εἰς",704105,0],["οὓς",709781,298],["ἂν",700900,11],["ἀπαγάγῃ",701324,172],["σε",711598,163],["κύριος",707996,4],["ἐκεῖ",704181,28]],"And thou shalt be there for a wonder, and a parable, and a tale, among all the nations, to which the Lord thy God shall carry thee away."],["38",[["σπέρμα",712008,25],["πολὺ",710646,46],["ἐξοίσεις",704356,166],["εἰς",704105,0],["τὸ",709436,24],["πεδίον",710215,25],["καὶ",707031,7],["ὀλίγα",709568,68],["εἰσοίσεις",704127,166],["ὅτι",709803,7],["κατέδεται",707519,93],["αὐτὰ",702165,71],["ἡ",709436,10],["ἀκρίς",700599,12]],"Thou shalt carry forth much seed into the field, and thou shalt bring in little, because the locust shall devour it."],["39",[["ἀμπελῶνα",700872,6],["φυτεύσεις",713636,166],["καὶ",707031,7],["κατεργᾷ",707515,123],["καὶ",707031,7],["οἶνον",709530,6],["οὐ",709805,28],["πίεσαι",710478,123],["οὐδὲ",709816,7],["εὐφρανθήσῃ",705715,364],["ἐξ",704132,0],["αὐτοῦ",702165,102],["ὅτι",709803,7],["καταφάγεται",707519,93],["αὐτὰ",702165,71],["ὁ",709436,3],["σκώληξ",711905,4]],"Thou shalt plant a vineyard, and dress it, and shalt not drink the wine, neither shalt thou delight thyself with it, because the worm shall devour it."],["40",[["ἐλαῖαι",704376,191],["ἔσονταί",704093,135],["σοι",711925,159],["ἐν",704639,0],["πᾶσι",710177,94],["τοῖς",709436,95],["ὁρίοις",709749,96],["σου",711945,133],["καὶ",707031,7],["ἔλαιον",704380,25],["οὐ",709805,28],["χρίσῃ",713965,123],["ὅτι",709803,7],["ἐκρυήσεται",704300,93],["ἡ",709436,10],["ἐλαία",704376,12],["σου",711945,133]],"Thou shalt have olive trees in all thy borders, and thou shalt not anoint thee with oil, because thine olive shall utterly cast [its fruit]."],["41",[["υἱοὺς",713075,57],["καὶ",707031,7],["θυγατέρας",706320,39],["γεννήσεις",703051,166],["καὶ",707031,7],["οὐκ",709805,28],["ἔσονταί",704093,135],["σοι",711925,159],["ἀπελεύσονται",701398,135],["γὰρ",702963,11],["ἐν",704639,0],["αἰχμαλωσίᾳ",700499,1]],"Thou shalt beget sons and daughters, and they shall not be [thine], for they shall depart into captivity."],["42",[["πάντα",710177,27],["τὰ",709436,41],["ξύλινά",709425,68],["σου",711945,133],["καὶ",707031,7],["τὰ",709436,41],["γενήματα",703052,42],["τῆς",709436,16],["γῆς",703083,17],["σου",711945,133],["ἐξαναλώσει",704861,127],["ἡ",709436,10],["ἐρυσίβη",705450,12]],"All thy trees and the fruits of thy land shall the blight consume."],["43",[["ὁ",709436,3],["προσήλυτος",710900,4],["ὅς",709781,213],["ἐστιν",704093,91],["ἐν",704639,0],["σοί",711925,159],["ἀναβήσεται",700905,93],["ἐπὶ",705080,0],["σὲ",711598,163],["ἄνω",701296,28],["ἄνω",701296,28],["σὺ",712181,164],["δὲ",703303,11],["καταβήσῃ",707202,123],["κάτω",707557,28],["κάτω",707557,28]],"The stranger that is within thee shall get up very high, and thou shalt come down very low."],["44",[["οὗτος",709858,121],["δανιεῖ",703277,127],["σοι",711925,159],["σὺ",712181,164],["δὲ",703303,11],["τούτῳ",709858,50],["οὐ",709805,28],["δανιεῖς",703277,166],["οὗτος",709858,121],["ἔσται",704093,93],["κεφαλή",707639,12],["σὺ",712181,164],["δὲ",703303,11],["ἔσῃ",70409