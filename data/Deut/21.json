[["1",[["ἐὰν",703912,7],["δὲ",703303,11],["εὑρεθῇ",705676,384],["τραυματίας",712921,57],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ᾗ",709781,108],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["δίδωσίν",703654,91],["σοι",711925,159],["κληρονομῆσαι",707724,106],["πεπτωκὼς",710481,270],["ἐν",704639,0],["τῷ",709436,53],["πεδίῳ",710215,54],["καὶ",707031,7],["οὐκ",709805,28],["οἴδασιν",709492,353],["τὸν",709436,5],["πατάξαντα",710185,365]],"And if one be found slain with the sword in the land, which the Lord thy God gives thee to inherit, having fallen in the field, and they do not know who has smitten [him];"],["2",[["ἐξελεύσεται",704909,93],["ἡ",709436,10],["γερουσία",703063,12],["σου",711945,133],["καὶ",707031,7],["οἱ",709436,136],["κριταί",707910,52],["σου",711945,133],["καὶ",707031,7],["ἐκμετρήσουσιν",704260,218],["ἐπὶ",705080,0],["τὰς",709436,38],["πόλεις",710612,39],["τὰς",709436,38],["κύκλῳ",707959,114],["τοῦ",709436,35],["τραυματίου",712921,18]],"thine elders and thy judges shall come forth, and shall measure the distances of the cities round about the slain man:"],["3",[["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["πόλις",710612,12],["ἡ",709436,10],["ἐγγίζουσα",703939,188],["τῷ",709436,113],["τραυματίᾳ",712921,114],["καὶ",707031,7],["λήμψεται",708076,93],["ἡ",709436,10],["γερουσία",703063,12],["τῆς",709436,16],["πόλεως",710612,17],["ἐκείνης",704183,86],["δάμαλιν",703271,9],["ἐκ",704132,0],["βοῶν",702798,81],["ἥτις",709793,412],["οὐκ",709805,28],["εἴργασται",705383,187],["καὶ",707031,7],["ἥτις",709793,412],["οὐχ",709805,28],["εἵλκυσεν",704508,2],["ζυγόν",705894,6]],"and it shall be that the city which is nearest to the slain man the elders of that city shall take a heifer of the herd, which has not laboured, and which has not borne a yoke."],["4",[["καὶ",707031,7],["καταβιβάσουσιν",707208,218],["ἡ",709436,10],["γερουσία",703063,12],["τῆς",709436,16],["πόλεως",710612,17],["ἐκείνης",704183,86],["τὴν",709436,8],["δάμαλιν",703271,9],["εἰς",704105,0],["φάραγγα",713351,9],["τραχεῖαν",712925,36],["ἥτις",709793,412],["οὐκ",709805,28],["εἴργασται",705383,187],["οὐδὲ",709816,7],["σπείρεται",712006,117],["καὶ",707031,7],["νευροκοπήσουσιν",709274,218],["τὴν",709436,8],["δάμαλιν",703271,9],["ἐν",704639,0],["τῇ",709436,100],["φάραγγι",713351,1]],"And the elders of that city shall bring down the heifer into a rough valley, which has not been tilled and is not sown, and they shall slay the heifer in the valley."],["5",[["καὶ",707031,7],["προσελεύσονται",710890,135],["οἱ",709436,136],["ἱερεῖς",706614,52],["οἱ",709436,136],["Λευῖται",708160,52],["ὅτι",709803,7],["αὐτοὺς",702165,62],["ἐπέλεξεν",705188,2],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["παρεστηκέναι",710152,115],["αὐτῷ",702165,50],["καὶ",707031,7],["εὐλογεῖν",705631,55],["ἐπὶ",705080,0],["τῷ",709436,53],["ὀνόματι",709666,54],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπὶ",705080,0],["τῷ",709436,53],["στόματι",712125,54],["αὐτῶν",702165,40],["ἔσται",704093,93],["πᾶσα",710177,29],["ἀντιλογία",701249,12],["καὶ",707031,7],["πᾶσα",710177,29],["ἁφή",702202,12]],"And the priests the Levites shall come, because the Lord God has chosen them to stand by him, and to bless in his name, and by their word shall every controversy and every stroke be [decided]."],["6",[["καὶ",707031,7],["πᾶσα",710177,29],["ἡ",709436,10],["γερουσία",703063,12],["τῆς",709436,16],["πόλεως",710612,17],["ἐκείνης",704183,86],["οἱ",709436,136],["ἐγγίζοντες",703939,146],["τῷ",709436,113],["τραυματίᾳ",712921,114],["νίψονται",709314,135],["τὰς",709436,38],["χεῖρας",713787,39],["ἐπὶ",705080,0],["τὴν",709436,8],["κεφαλὴν",707639,9],["τῆς",709436,16],["δαμάλεως",703271,17],["τῆς",709436,16],["νενευροκοπημένης",709274,440],["ἐν",704639,0],["τῇ",709436,100],["φάραγγι",713351,1]],"And all the elders of that city who draw nigh to the slain man shall wash their hands over the head of the heifer which was slain in the valley;"],["7",[["καὶ",707031,7],["ἀποκριθέντες",701492,247],["ἐροῦσιν",705415,218],["αἱ",709436,190],["χεῖρες",713787,191],["ἡμῶν",705999,145],["οὐκ",709805,28],["ἐξέχεαν",704368,150],["τὸ",709436,24],["αἷμα",700442,25],["τοῦτο",709858,129],["καὶ",707031,7],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["ἡμῶν",705999,145],["οὐχ",709805,28],["ἑωράκασιν",709725,353]],"and they shall answer and say, Our hands have not shed this blood, and our eyes have not seen [it]."],["8",[["ἵλεως",706732,14],["γενοῦ",703104,300],["τῷ",709436,113],["λαῷ",708094,114],["σου",711945,133],["Ισραηλ",706839,114],["οὓς",709781,298],["ἐλυτρώσω",708282,174],["κύριε",707996,153],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,18],["ἵνα",706747,7],["μὴ",708851,28],["γένηται",703104,239],["αἷμα",700442,25],["ἀναίτιον",700963,46],["ἐν",704639,0],["τῷ",709436,113],["λαῷ",708094,114],["σου",711945,133],["Ισραηλ",706839,114],["καὶ",707031,7],["ἐξιλασθήσεται",706728,134],["αὐτοῖς",702165,151],["τὸ",709436,24],["αἷμα",700442,25]],"Be merciful to thy people Israel, whom thou hast redeemed, O Lord, that innocent blood may not be charged on thy people Israel: and the blood shall be atoned for to them."],["9",[["σὺ",712181,164],["δὲ",703303,11],["ἐξαρεῖς",704839,166],["τὸ",709436,24],["αἷμα",700442,25],["τὸ",709436,24],["ἀναίτιον",700963,46],["ἐξ",704132,0],["ὑμῶν",713091,145],["αὐτῶν",702165,40],["ἐὰν",703912,7],["ποιήσῃς",710582,175],["τὸ",709436,24],["καλὸν",707097,46],["καὶ",707031,7],["τὸ",709436,24],["ἀρεστὸν",701723,46],["ἔναντι",704653,0],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133]],"And thou shalt take away innocent blood from among you, if thou shouldest do that which is good and pleasing before the Lord thy God."],["10",[["ἐὰν",703912,7],["δὲ",703303,11],["ἐξελθὼν",704909,182],["εἰς",704105,0],["πόλεμον",710605,6],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἐχθρούς",705779,57],["σου",711945,133],["καὶ",707031,7],["παραδῷ",710014,172],["σοι",711925,159],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["εἰς",704105,0],["τὰς",709436,38],["χεῖράς",713787,39],["σου",711945,133],["καὶ",707031,7],["προνομεύσεις",710826,166],["τὴν",709436,8],["προνομὴν",710827,9],["αὐτῶν",702165,40]],"And if when thou goest out to war against thine enemies, the Lord thy God should deliver them into thine hands, and thou shouldest take their spoil,"],["11",[["καὶ",707031,7],["ἴδῃς",709725,175],["ἐν",704639,0],["τῇ",709436,100],["προνομῇ",710827,1],["γυναῖκα",703209,9],["καλὴν",707097,36],["τῷ",709436,53],["εἴδει",704074,54],["καὶ",707031,7],["ἐνθυμηθῇς",704739,279],["αὐτῆς",702165,86],["καὶ",707031,7],["λάβῃς",708076,175],["αὐτὴν",702165,104],["σαυτῷ",711599,50],["γυναῖκα",703209,9]],"and shouldest see among the spoil a woman beautiful in countenance, and shouldest desire her, and take her to thyself for a wife,"],["12",[["καὶ",707031,7],["εἰσάξεις",704107,166],["αὐτὴν",702165,104],["ἔνδον",704692,28],["εἰς",704105,0],["τὴν",709436,8],["οἰκίαν",709505,9],["σου",711945,133],["καὶ",707031,7],["ξυρήσεις",709431,166],["τὴν",709436,8],["κεφαλὴν",707639,9],["αὐτῆς",702165,86],["καὶ",707031,7],["περιονυχιεῖς",710356,166],["αὐτὴν",702165,104]],"and shouldest bring her within thine house: then shalt thou shave her head, and pare her nails;"],["13",[["καὶ",707031,7],["περιελεῖς",710288,166],["τὰ",709436,41],["ἱμάτια",706742,42],["τῆς",709436,16],["αἰχμαλωσίας",700499,17],["αὐτῆς",702165,86],["ἀπ᾿",701425,0],["αὐτῆς",702165,86],["καὶ",707031,7],["καθίεται",707006,93],["ἐν",704639,0],["τῇ",709436,100],["οἰκίᾳ",709505,1],["σου",711945,133],["καὶ",707031,7],["κλαύσεται",707703,93],["τὸν",709436,5],["πατέρα",710189,6],["καὶ",707031,7],["τὴν",709436,8],["μητέρα",708892,9],["μηνὸς",708874,18],["ἡμέρας",705984,39],["καὶ",707031,7],["μετὰ",708780,0],["ταῦτα",709858,71],["εἰσελεύσῃ",704114,123],["πρὸς",710844,0],["αὐτὴν",702165,104],["καὶ",707031,7],["συνοικισθήσῃ",712495,364],["αὐτῇ",702165,105],["καὶ",707031,7],["ἔσται",704093,93],["σου",711945,133],["γυνή",703209,12]],"and shalt take away 