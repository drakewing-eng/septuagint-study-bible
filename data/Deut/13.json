],"And that prophet or that dreamer of a dream, shall die; for he has spoken to make thee err from the Lord thy God who brought thee out of the land of Egypt, who redeemed thee from bondage, to thrust thee out of the way which the Lord thy God commanded thee to walk in: so shalt thou abolish the evil from among you."],["7",[["ἐὰν",703912,7],["δὲ",703303,11],["παρακαλέσῃ",710039,172],["σε",711598,163],["ὁ",709436,3],["ἀδελφός",700249,4],["σου",711945,133],["ἐκ",704132,0],["πατρός",710189,18],["σου",711945,133],["ἢ",705924,7],["ἐκ",704132,0],["μητρός",708892,17],["σου",711945,133],["ἢ",705924,7],["ὁ",709436,3],["υἱός",713075,4],["σου",711945,133],["ἢ",705924,7],["ἡ",709436,10],["θυγάτηρ",706320,12],["σου",711945,133],["ἢ",705924,7],["ἡ",709436,10],["γυνὴ",703209,12],["ἡ",709436,10],["ἐν",704639,0],["κόλπῳ",707800,114],["σου",711945,133],["ἢ",705924,7],["ὁ",709436,3],["φίλος",713492,14],["ὁ",709436,3],["ἴσος",706832,14],["τῆς",709436,16],["ψυχῆς",714070,17],["σου",711945,133],["λάθρᾳ",708057,28],["λέγων",708124,72],["βαδίσωμεν",702367,79],["καὶ",707031,7],["λατρεύσωμεν",708108,79],["θεοῖς",706192,148],["ἑτέροις",705535,230],["οὓς",709781,298],["οὐκ",709805,28],["ᾔδεις",709492,508],["σὺ",712181,164],["καὶ",707031,7],["οἱ",709436,136],["πατέρες",710189,52],["σου",711945,133]],"And if thy brother by thy father or mother, or thy son, or daughter, or thy wife in thy bosom, or friend who is equal to thine own soul, entreat thee secretly, saying, Let us go and serve other gods, which neither thou nor thy fathers have known,"],["8",[["ἀπὸ",701425,0],["τῶν",709436,80],["θεῶν",706192,81],["τῶν",709436,43],["ἐθνῶν",704068,44],["τῶν",709436,43],["περικύκλῳ",710340,28],["ὑμῶν",713091,145],["τῶν",709436,43],["ἐγγιζόντων",703939,84],["σοι",711925,159],["ἢ",705924,7],["τῶν",709436,43],["μακρὰν",708411,28],["ἀπὸ",701425,0],["σοῦ",711945,133],["ἀπ᾿",701425,0],["ἄκρου",700608,92],["τῆς",709436,16],["γῆς",703083,17],["ἕως",705792,0],["ἄκρου",700608,92],["τῆς",709436,16],["γῆς",703083,17]]