[["1",[["καὶ",707031,7],["προσέταξεν",710962,2],["Μωυσῆς",709112,4],["καὶ",707031,7],["ἡ",709436,10],["γερουσία",703063,12],["Ισραηλ",706839,18],["λέγων",708124,72],["φυλάσσεσθε",713619,73],["πάσας",710177,119],["τὰς",709436,38],["ἐντολὰς",704802,39],["ταύτας",709858,231],["ὅσας",709788,119],["ἐγὼ",704018,164],["ἐντέλλομαι",704791,254],["ὑμῖν",713084,90],["σήμερον",711751,28]],"And Moses and the elders of Israel commanded, saying, Keep all these commands, all that I command you this day."],["2",[["καὶ",707031,7],["ἔσται",704093,93],["ᾗ",709781,108],["ἂν",700900,11],["ἡμέρᾳ",705984,1],["διαβῆτε",703419,125],["τὸν",709436,5],["Ιορδάνην",706763,6],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["δίδωσίν",703654,91],["σοι",711925,159],["καὶ",707031,7],["στήσεις",706846,166],["σεαυτῷ",711599,50],["λίθους",708196,57],["μεγάλους",708653,60],["καὶ",707031,7],["κονιάσεις",707813,166],["αὐτοὺς",702165,62],["κονίᾳ",707811,1]],"And it shall come to pass in the day when ye shall cross over Jordan into the land which the Lord thy God gives thee, that thou shalt set up for thyself great stones, and shalt plaster them with plaster."],["3",[["καὶ",707031,7],["γράψεις",703194,166],["ἐπὶ",705080,0],["τῶν",709436,80],["λίθων",708196,81],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["τοῦ",709436,35],["νόμου",709349,18],["τούτου",709858,102],["ὡς",714148,7],["ἂν",700900,11],["διαβῆτε",703419,125],["τὸν",709436,5],["Ιορδάνην",706763,6],["ἡνίκα",706008,28],["ἐὰν",703912,7],["εἰσέλθητε",704114,125],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,80],["πατέρων",710189,81],["σου",711945,133],["δίδωσίν",703654,91],["σοι",711925,159],["γῆν",703083,9],["ῥέουσαν",711241,78],["γάλα",702919,25],["καὶ",707031,7],["μέλι",708700,25],["ὃν",709781,112],["τρόπον",712980,6],["εἶπεν",705373,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,80],["πατέρων",710189,81],["σού",711945,133],["σοι",711925,159]],"And thou shalt write on these stones all the words of this law, as soon as ye have crossed Jordan, when ye are entered into the land, which the Lord God of thy fathers gives thee, a land flowing with milk and honey, according as the Lord God of thy fathers said to thee."],["4",[["καὶ",707031,7],["ἔσται",704093,93],["ὡς",714148,7],["ἂν",700900,11],["διαβῆτε",703419,125],["τὸν",709436,5],["Ιορδάνην",706763,6],["στήσετε",706846,337],["τοὺς",709436,58],["λίθους",708196,57],["τούτους",709858,62],["οὓς",709781,298],["ἐγὼ",704018,164],["ἐντέλλομαί",704791,254],["σοι",711925,159],["σήμερον",711751,28],["ἐν",704639,0],["ὄρει",709768,54],["Γαιβαλ",702907,515],["καὶ",707031,7],["κονιάσεις",707813,166],["αὐτοὺς",702165,62],["κονίᾳ",707811,1]],"And it shall be as soon as ye are gone over Jordan, ye shall set up these stones, which I command thee this day, on mount Gæbal, and thou shalt plaster them with plaster."],["5",[["καὶ",707031,7],["οἰκοδομήσεις",709509,166],["ἐκεῖ",704181,28],["θυσιαστήριον",706348,25],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["σου",711945,133],["θυσιαστήριον",706348,25],["ἐκ",704132,0],["λίθων",708196,81],["οὐκ",709805,28],["ἐπιβαλεῖς",705083,166],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["σίδηρον",711774,6]],"And thou shalt build there an altar to the Lord thy God, an altar of stones; thou shalt not lift up iron upon it."],["6",[["λίθους",708196,57],["ὁλοκλήρους",709591,60],["οἰκοδομήσεις",709509,166],["θυσιαστήριον",706348,25],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["σου",711945,133],["καὶ",707031,7],["ἀνοίσεις",701083,166],["ἐπ᾿",705080,0],["αὐτὸ",702165,129],["ὁλοκαυτώματα",709589,42],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["σου",711945,133]],"Of whole stones shalt thou build an altar to the Lord thy God, and thou shalt offer upon it whole-burnt-offerings to the Lord thy God."],["7",[["καὶ",707031,7],["θύσεις",706349,166],["ἐκεῖ",704181,28],["θυσίαν",706345,9],["σωτηρίου",712659,21],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["σου",711945,133],["καὶ",707031,7],["φάγῃ",713296,123],["καὶ",707031,7],["ἐμπλησθήσῃ",704592,364],["καὶ",707031,7],["εὐφρανθήσῃ",705715,364],["ἐναντίον",704654,0],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133]],"And thou shalt there offer a peace-offering; and thou shalt eat and be filled, and rejoice before the Lord thy God."],["8",[["καὶ",707031,7],["γράψεις",703194,166],["ἐπὶ",705080,0],["τῶν",709436,80],["λίθων",708196,81],["πάντα",710177,27],["τὸν",709436,5],["νόμον",709349,6],["τοῦτον",709858,85],["σαφῶς",711589,28],["σφόδρα",712586,28]],"And thou shalt write upon the stones all this law very plainly."],["9",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["Μωυσῆς",709112,4],["καὶ",707031,7],["οἱ",709436,136],["ἱερεῖς",706614,52],["οἱ",709436,136],["Λευῖται",708160,52],["παντὶ",710177,30],["Ισραηλ",706839,114],["λέγοντες",708124,146],["σιώπα",711818,240],["καὶ",707031,7],["ἄκουε",700587,240],["Ισραηλ",706839,153],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ταύτῃ",709858,105],["γέγονας",703104,266],["εἰς",704105,0],["λαὸν",708094,6],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["σου",711945,133]],"And Moses and the priests the Levites spoke to all Israel, saying, Be silent and hear, O Israel; this day thou art become a people to the Lord thy God."],["10",[["καὶ",707031,7],["εἰσακούσῃ",704108,123],["τῆς",709436,16],["φωνῆς",713640,17],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133],["καὶ",707031,7],["ποιήσεις",710582,166],["πάσας",710177,119],["τὰς",709436,38],["ἐντολὰς",704802,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["δικαιώματα",703697,42],["αὐτοῦ",702165,102],["ὅσα",709788,68],["ἐγὼ",704018,164],["ἐντέλλομαί",704791,254],["σοι",711925,159],["σήμερον",711751,28]],"And thou shalt hearken to the voice of the Lord thy God, and shalt do all his commands, and his ordinances, as many as I command thee this day."],["11",[["καὶ",707031,7],["ἐνετείλατο",704791,23],["Μωυσῆς",709112,4],["τῷ",709436,113],["λαῷ",708094,114],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["λέγων",708124,72]],"And Moses charged the people on that day, saying,"],["12",[["οὗτοι",709858,201],["στήσονται",706846,135],["εὐλογεῖν",705631,55],["τὸν",709436,5],["λαὸν",708094,6],["ἐν",704639,0],["ὄρει",709768,54],["Γαριζιν",702970,515],["διαβάντες",703419,196],["τὸν",709436,5],["Ιορδάνην",706763,6],["Συμεων",712297,4],["Λευι",708158,4],["Ιουδας",706775,4],["Ισσαχαρ",706843,4],["Ιωσηφ",706948,4],["καὶ",707031,7],["Βενιαμιν",702650,4]],"These shall stand to bless the people on mount Garizin having gone over Jordan; Symeon, Levi, Judas, Issachar, Joseph, and Benjamin."],["13",[["καὶ",707031,7],["οὗτοι",709858,201],["στήσονται",706846,135],["ἐπὶ",705080,0],["τῆς",709436,16],["κατάρας",707395,17],["ἐν",704639,0],["ὄρει",709768,54],["Γαιβαλ",702907,515],["Ρουβην",711295,4],["Γαδ",702872,4],["καὶ",707031,7],["Ασηρ",701934,4],["Ζαβουλων",705813,4],["Δαν",703276,4],["καὶ",707031,7],["Νεφθαλι",709279,4]],"And these shall stand for cursing on mount Gæbal; Ruben, Gad, and Aser, Zabulon, Dan, and Nephthali."],["14",[["καὶ",707031,7],["ἀποκριθέντες",701492,247],["οἱ",709436,136],["Λευῖται",708160,52],["ἐροῦσιν",705415,218],["παντὶ",710177,30],["Ισραηλ",706839,114],["φωνῇ",713640,1],["μεγάλῃ",708653,101]],"And the Levites shall answer and say to all Israel with a loud voice,"],["15",[["ἐπικατάρατος",705159,14],["ἄνθρωπος",701163,4],["ὅστις",709793,425],["ποιήσει",710582,127],["γλυπτὸν",703117,46],["καὶ",707031,7],["χωνευτόν",714009,46],["βδέλυγμα",702604,25],["κυρίῳ",707996,114],["ἔργον",705396,25],["χειρῶν",713787,65],["τεχνίτου",712832,18],["καὶ",707031,7],["θήσει",712849,127],["αὐτὸ",702165,129],["ἐν",704639,0],["ἀποκρύφῳ",701497,97],["καὶ",707031,7],["ἀποκριθεὶς",701492,217],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["ἐροῦσιν",705415,218],["γένοιτο",703104,382]],"Cursed [is] the man whosoever shall make a graven or molten image, an abomination to the Lord, the work of the hands of craftsmen, and shall put it in a secret place: and all the people shall answer and say, So be it."],["16",[["ἐπικατάρατος",705159,14],["ὁ",709436,3],["ἀτιμάζων",702092,72],["πατέρα",710189,6],["αὐτοῦ",702165,102],["ἢ",705924,7],["μητέρα",708892,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐροῦσιν",705415,218],["πᾶς",710177,14],["ὁ",709436,3],["λαός",708094,4],["γένοιτο",703104,382]],"Cursed is the man that dishonours his father or his mother: and all the people shall say, So be it."],["17",[["ἐπικατάρατος",705159,14],["ὁ",709436,3],["μετατιθεὶς",708820,72],["ὅρια",709749,42],["τοῦ",709436,35],["πλησίον",710547,28],["καὶ",707031,7],["ἐροῦσιν",705415,218],["πᾶς",710177,14],["ὁ",709436,3],["λαός",708094,4],["γένοιτο",703104,382]],"Cursed is he that removes his neighbour's landmarks: and all the people shall say, So be it."],["18",[["ἐπικατάρατος",705159,14],["ὁ",709436,3],["πλανῶν",710495,72],["τυφλὸν",713031,27],["ἐν",704639,0],["ὁδῷ",709458,1],["καὶ",707031,7],["ἐροῦσιν",705415,218],["πᾶς",710177,14],["ὁ",709436,3],["λαός",708094,4],["γένοιτο",703104,382]],"Cursed is he that makes the blind to wander in the way: and all the people shall say, So be it."],["19",[["ἐπικατάρατος",705159,14],["ὃς",709781,213],["ἂν",700900,11],["ἐκκλίνῃ",704220,204],["κρίσιν",707908,9],["προσηλύτου",710900,18],["καὶ",707031,7],["ὀρφανοῦ",709779,116],["καὶ",707031,7],["χήρας",713848,17],["καὶ",707031,7],["ἐροῦσιν",705415,218],["πᾶς",710177,14],["ὁ",709436,3],["λαός",708094,4],["γένοιτο",703104,382]],"Cursed is every one that shall pervert the judgment of the stranger, and orphan, and widow: and all the people shall say, So be it."],["20",[["ἐπικατάρατος",705159,14],["ὁ",709436,3],["κοιμώμενος",707767,122],["μετὰ",708780,0],["γυναικὸς",703209,17],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ἀπεκάλυψεν",701474,2],["συγκάλυμμα",712200,25],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐροῦσιν",705415,218],["πᾶς",710177,14],["ὁ",709436,3],["λαός",708094,4],["γένοιτο",703104,382]],"Cursed is he that lies with his father's wife, because he has uncovered his father's skirt: and all the people shall say, So be it."],["21",[["ἐπικατάρατος",705159,14],["ὁ",709436,3],["κοιμώμενος",707767,122],["μετὰ",708780,0],["παντὸς",710177,92],["κτήνους",707934,21],["καὶ",707031,7],["ἐροῦσιν",705415,218],["πᾶς",710177,14],["ὁ",709436,3],["λαός",708094,4],["γένοιτο",703104,382]],"Cursed is he that lies with any beast: and all the people shall say, So be it."],["22",[["ἐπικατάρατος",705159,14],["ὁ",709436,3],["κοιμώμενος",707767,122],["μετὰ",708780,0],["ἀδελφῆς",700244,17],["ἐκ",704132,0],["πατρὸς",710189,18],["ἢ",705924,7],["ἐκ",704132,0],["μητρὸς",708892,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐροῦσιν",705415,218],["πᾶς",710177,14],["ὁ",709436,3],["λαός",708094,4],["γένοιτο",703104,382]],"Cursed is he that lies with his sister by his father or his mother: and all the people shall say, So be it."],["23",[["ἐπικατάρατος",705159,14],["ὁ",709436,3],["κοιμώμενος",707767,122],["μετὰ",708780,0],["πενθερᾶς",710249,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐροῦσιν",705415,218],["πᾶς",710177,14],["ὁ",709436,3],["λαός",708094,4],["γένοιτο",703104,382],["ἐπικατάρατος",705159,14],["ὁ",709436,3],["κοιμώμενος",707767,122],["μετὰ",708780,0],["ἀδελφῆς",700244,17],["γυναικὸς",703209,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐροῦσιν",705415,218],["πᾶς",710177,14],["ὁ",709436,3],["λαός",708094,4],["γένοιτο",703104,382]],"Cursed is he that lies with his daughter-in-law: and all the people shall say, So be it. Cursed is he that lies with his wife's sister: and all the people shall say, So be it."],["24",[["ἐπικατάρατος",705159,14],["ὁ",709436,3],["τύπτων",713022,72],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102],["δόλῳ",703787,114],["καὶ",707031,7],["ἐροῦσιν",705415,218],["πᾶς",710177,14],["ὁ",709436,3],["λαός",708094,4],["γένοιτο",703104,382]],"Cursed is he that smites his neighbour secretly: and all the people shall say, So be it."],["25",[["ἐπικατάρατος",705159,14],["ὃς",709781,213],["ἂν",700900,11],["λάβῃ",708076,172],["δῶρα",703907,42],["πατάξαι",710185,106],["ψυχὴν",714070,9],["αἵματος",700442,21],["ἀθῴου",700390,92],["καὶ",707031,7],["ἐροῦσιν",705415,218],["πᾶς",710177,14],["ὁ",709436,3],["λαός",708094,4],["γένοιτο",703104,382]],"Cursed is he whosoever shall have taken a bribe to slay an innocent man: and all the people shall say, So be it."],["26",[["ἐπικατάρατος",705159,14],["πᾶς",710177,14],["ἄνθρωπος",701163,4],["ὃς",709781,213],["οὐκ",709805,28],["ἐμμενεῖ",704570,127],["ἐν",704639,0],["πᾶσιν",710177,230],["τοῖς",709436,147],["λόγοις",708236,148],["τοῦ",709436,35],["νόμου",709349,18],["τούτου",709858,102],["τοῦ",709436,20],["ποιῆσαι",710582,106],["αὐτούς",702165,62],["καὶ",707031,7],["ἐροῦσιν",705415,218],["πᾶς",710177,14],["ὁ",709436,3],["λαός",708094,4],["γένοιτο",703104,382]],"Cursed is every man that continues not in all the words of this law to do them: and all the people shall say, So be it."]]