[["1",[["πρόσεχε",710895,240],["οὐρανέ",709844,153],["καὶ",707031,7],["λαλήσω",708071,165],["καὶ",707031,7],["ἀκουέτω",700587,31],["γῆ",703083,12],["ῥήματα",711246,42],["ἐκ",704132,0],["στόματός",712125,21],["μου",709032,133]],"Attend, O heaven, and I will speak; and let the earth hear the words out of my mouth."],["2",[["προσδοκάσθω",710876,407],["ὡς",714148,7],["ὑετὸς",713074,4],["τὸ",709436,34],["ἀπόφθεγμά",701635,15],["μου",709032,133],["καὶ",707031,7],["καταβήτω",707202,45],["ὡς",714148,7],["δρόσος",703835,12],["τὰ",709436,63],["ῥήματά",711246,64],["μου",709032,133],["ὡσεὶ",714159,28],["ὄμβρος",709611,4],["ἐπ᾿",705080,0],["ἄγρωστιν",700199,9],["καὶ",707031,7],["ὡσεὶ",714159,28],["νιφετὸς",709320,4],["ἐπὶ",705080,0],["χόρτον",713923,6]],"Let my speech be looked for as the rain, and my words come down as dew, as the shower upon the herbage, and as snow upon the grass."],["3",[["ὅτι",709803,7],["ὄνομα",709666,25],["κυρίου",707996,18],["ἐκάλεσα",707084,155],["δότε",703654,74],["μεγαλωσύνην",708652,9],["τῷ",709436,113],["θεῷ",706192,114],["ἡμῶν",705999,145]],"For I have called on the name of the Lord: assign ye greatness to our God."],["4",[["θεός",706192,4],["ἀληθινὰ",700659,195],["τὰ",709436,63],["ἔργα",705396,64],["αὐτοῦ",702165,102],["καὶ",707031,7],["πᾶσαι",710177,192],["αἱ",709436,190],["ὁδοὶ",709458,191],["αὐτοῦ",702165,102],["κρίσεις",707908,191],["θεὸς",706192,4],["πιστός",710486,14],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀδικία",700271,12],["δίκαιος",703694,14],["καὶ",707031,7],["ὅσιος",709782,14],["κύριος",707996,4]],"[As for] God, his works [are] true, and all his ways [are] judgment: God [is] faithful, and there is no unrighteousness [in him]; just and holy [is] the Lord."],["5",[["ἡμάρτοσαν",700773,150],["οὐκ",709805,28],["αὐτῷ",702165,50],["τέκνα",712761,64],["μωμητά",709101,195],["γενεὰ",703037,12],["σκολιὰ",711868,29],["καὶ",707031,7],["διεστραμμένη",703592,203]],"They have sinned, not [pleasing] him; spotted children, a froward and perverse generation."],["6",[["ταῦτα",709858,71],["κυρίῳ",707996,114],["ἀνταποδίδοτε",701215,87],["οὕτω",709859,28],["λαὸς",708094,4],["μωρὸς",709110,14],["καὶ",707031,7],["οὐχὶ",709862,28],["σοφός",711985,14],["οὐκ",709805,28],["αὐτὸς",702165,121],["οὗτός",709858,121],["σου",711945,133],["πατὴρ",710189,4],["ἐκτήσατό",707932,23],["σε",711598,163],["καὶ",707031,7],["ἐποίησέν",710582,2],["σε",711598,163],["καὶ",707031,7],["ἔκτισέν",707938,2],["σε",711598,163]],"Do ye thus recompense the Lord? [is the] people thus foolish and unwise? did not he himself thy father purchase thee, and make thee, and form thee?"],["7",[["μνήσθητε",708960,372],["ἡμέρας",705984,39],["αἰῶνος",700504,18],["σύνετε",712481,74],["ἔτη",705543,42],["γενεᾶς",703037,17],["γενεῶν",703037,65],["ἐπερώτησον",705069,176],["τὸν",709436,5],["πατέρα",710189,6],["σου",711945,133],["καὶ",707031,7],["ἀναγγελεῖ",700921,127],["σοι",711925,159],["τοὺς",709436,58],["πρεσβυτέρους",710735,60],["σου",711945,133],["καὶ",707031,7],["ἐροῦσίν",705415,218],["σοι",711925,159]],"Remember the days of old, consider the years for past ages: ask thy father, and he shall relate to thee, thine elders, and they shall tell thee."],["8",[["ὅτε",709802,28],["διεμέριζεν",703518,13],["ὁ",709436,3],["ὕψιστος",713287,14],["ἔθνη",704068,42],["ὡς",714148,7],["διέσπειρεν",703584,2],["υἱοὺς",713075,57],["Αδαμ",700222,18],["ἔστησεν",706846,2],["ὅρια",709749,42],["ἐθνῶν",704068,44],["κατὰ",707200,0],["ἀριθμὸν",701744,6],["ἀγγέλων",700140,81],["θεοῦ",706192,18]],"When the Most High divided the nations, when he separated the sons of Adam, he set the bounds of the nations according to the number of the angels of God."],["9",[["καὶ",707031,7],["ἐγενήθη",703104,37],["μερὶς",708748,12],["κυρίου",707996,18],["λαὸς",708094,4],["αὐτοῦ",702165,102],["Ιακωβ",706401,4],["σχοίνισμα",712611,4],["κληρονομίας",707725,17],["αὐτοῦ",702165,102],["Ισραηλ",706839,4]],"And his people Jacob became the portion of the Lord, Israel was the line of his inheritance."],["10",[["αὐτάρκησεν",702156,2],["αὐτὸν",702165,85],["ἐν",704639,0],["γῇ",703083,1],["ἐρήμῳ",705420,1],["ἐν",704639,0],["δίψει",703764,54],["καύματος",707564,21],["ἐν",704639,0],["ἀνύδρῳ",701285,30],["ἐκύκλωσεν",707958,2],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐπαίδευσεν",709926,2],["αὐτὸν",702165,85],["καὶ",707031,7],["διεφύλαξεν",703632,2],["αὐτὸν",702165,85],["ὡς",714148,7],["κόραν",707836,9],["ὀφθαλμοῦ",709870,18]],"He maintained him in the wilderness, in burning thirst and a dry land: he led him about and instructed him, and kept him as the apple of an eye."],["11",[["ὡς",714148,7],["ἀετὸς",700318,4],["σκεπάσαι",711832,106],["νοσσιὰν",709360,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπὶ",705080,0],["τοῖς",709436,147],["νεοσσοῖς",709257,148],["αὐτοῦ",702165,102],["ἐπεπόθησεν",710581,2],["διεὶς",703688,182],["τὰς",709436,38],["πτέρυγας",711057,39],["αὐτοῦ",702165,102],["ἐδέξατο",703393,23],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἀνέλαβεν",700984,2],["αὐτοὺς",702165,62],["ἐπὶ",705080,0],["τῶν",709436,43],["μεταφρένων",708824,44],["αὐτοῦ",702165,102]],"As an eagle would watch over his brood, and yearns over his young, receives them having spread his wings, and takes them up on his back:"],["12",[["κύριος",707996,4],["μόνος",709003,14],["ἦγεν",700209,13],["αὐτούς",702165,62],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["μετ᾿",708780,0],["αὐτῶν",702165,40],["θεὸς",706192,4],["ἀλλότριος",700699,14]],"the Lord alone led them, there was no strange god with them."],["13",[["ἀνεβίβασεν",700910,2],["αὐτοὺς",702165,62],["ἐπὶ",705080,0],["τὴν",709436,8],["ἰσχὺν",706858,9],["τῆς",709436,16],["γῆς",703083,17],["ἐψώμισεν",714077,2],["αὐτοὺς",702165,62],["γενήματα",703052,42],["ἀγρῶν",700196,81],["ἐθήλασαν",706233,150],["μέλι",708700,25],["ἐκ",704132,0],["πέτρας",710443,17],["καὶ",707031,7],["ἔλαιον",704380,25],["ἐκ",704132,0],["στερεᾶς",712075,82],["πέτρας",710443,17]],"He brought them up on the strength of the land; he fed them with the fruits of the fields; they sucked honey out of the rock, and oil out of the solid rock."],["14",[["βούτυρον",702800,25],["βοῶν",702798,81],["καὶ",707031,7],["γάλα",702919,25],["προβάτων",710768,44],["μετὰ",708780,0],["στέατος",712054,21],["ἀρνῶν",701731,81],["καὶ",707031,7],["κριῶν",707906,81],["υἱῶν",713075,81],["ταύρων",712734,81],["καὶ",707031,7],["τράγων",712917,81],["μετὰ",708780,0],["στέατος",712054,21],["νεφρῶν",709282,81],["πυροῦ",711101,18],["καὶ",707031,7],["αἷμα",700442,25],["σταφυλῆς",712052,17],["ἔπιον",710478,150],["οἶνον",709530,6]],"Butter of cows, and milk of sheep, with the fat of lambs and rams, of calves and kids, with fat of kidneys of wheat; and he drank wine, the blood of the grape."],["15",[["καὶ",707031,7],["ἔφαγεν",713296,2],["Ιακωβ",706401,4],["καὶ",707031,7],["ἐνεπλήσθη",704592,37],["καὶ",707031,7],["ἀπελάκτισεν",701503,2],["ὁ",709436,3],["ἠγαπημένος",700120,419],["ἐλιπάνθη",708215,37],["ἐπαχύνθη",710205,37],["ἐπλατύνθη",710508,37],["καὶ",707031,7],["ἐγκατέλιπεν",703967,2],["θεὸν",706192,6],["τὸν",709436,5],["ποιήσαντα",710582,365],["αὐτὸν",702165,85],["καὶ",707031,7],["ἀπέστη",702214,2],["ἀπὸ",701425,0],["θεοῦ",706192,18],["σωτῆρος",712657,18],["αὐτοῦ",702165,102]],"So Jacob ate and was filled, and the beloved one kicked; he grew fat, he became thick and broad: then he forsook the God that made him, and departed from God his Saviour."],["16",[["παρώξυνάν",710164,150],["με",708618,163],["ἐπ᾿",705080,0],["ἀλλοτρίοις",700699,230],["ἐν",704639,0],["βδελύγμασιν",702604,96],["αὐτῶν",702165,40],["ἐξεπίκρανάν",704282,150],["με",708618,163]],"They provoked me to anger with strange gods; with their abominations they bitterly angered me."],["17",[["ἔθυσαν",706349,150],["δαιμονίοις",703249,96],["καὶ",707031,7],["οὐ",709805,28],["θεῷ",706192,114],["θεοῖς",706192,148],["οἷς",709781,311],["οὐκ",709805,28],["ᾔδεισαν",709492,263],["καινοὶ",707042,138],["πρόσφατοι",710972,138],["ἥκασιν",705956,353],["οὓς",709781,298],["οὐκ",709805,28],["ᾔδεισαν",709492,263],["οἱ",709436,136],["πατέρες",710189,52],["αὐτῶν",702165,40]],"They sacrificed to devils, and not to God; to gods whom they knew not: new and fresh [gods] came in, whom their fathers knew not."],["18",[["θεὸν",706192,6],["τὸν",709436,5],["γεννήσαντά",703051,365],["σε",711598,163],["ἐγκατέλιπες",703967,162],["καὶ",707031,7],["ἐπελάθου",705187,174],["θεοῦ",706192,18],["τοῦ",709436,35],["τρέφοντός",712930,152],["σε",711598,163]],"Thou hast forsaken God that begot thee, and forgotten God who feeds thee."],["19",[["καὶ",707031,7],["εἶδεν",709725,2],["κύριος",707996,4],["καὶ",707031,7],["ἐζήλωσεν",705873,2],["καὶ",707031,7],["παρωξύνθη",710164,37],["δι᾿",703417,0],["ὀργὴν",709728,9],["υἱῶν",713075,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["θυγατέρων",706320,65]],"And the Lord saw, and was jealous; and was provoked by the anger of his sons and daughters,"],["20",[["καὶ",707031,7],["εἶπεν",705373,2],["ἀποστρέψω",701598,165],["τὸ",709436,24],["πρόσωπόν",710986,25],["μου",709032,133],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["καὶ",707031,7],["δείξω",703314,165],["τί",712867,126],["ἔσται",704093,93],["αὐτοῖς",702165,151],["ἐπ᾿",705080,0],["ἐσχάτων",705519,83],["ὅτι",709803,7],["γενεὰ",703037,12],["ἐξεστραμμένη",704316,203],["ἐστίν",704093,91],["υἱοί",713075,52],["οἷς",709781,311],["οὐκ",709805,28],["ἔστιν",704093,91],["πίστις",710484,12],["ἐν",704639,0],["αὐτοῖς",702165,151]],"and said, I will turn away my face from them, and will show what shall happen to them in the last days; for it is a perverse generation, sons in whom is no faith."],["21",[["αὐτοὶ",702165,201],["παρεζήλωσάν",710021,150],["με",708618,163],["ἐπ᾿",705080,0],["οὐ",709805,28],["θεῷ",706192,114],["παρώργισάν",710167,150],["με",708618,163],["ἐν",704639,0],["τοῖς",709436,95],["εἰδώλοις",704079,96],["αὐτῶν",702165,40],["κἀγὼ",706969,288],["παραζηλώσω",710021,165],["αὐτοὺς",702165,62],["ἐπ᾿",705080,0],["οὐκ",709805,28],["ἔθνει",704068,54],["ἐπ᾿",705080,0],["ἔθνει",704068,54],["ἀσυνέτῳ",702034,97],["παροργιῶ",710167,165],["αὐτούς",702165,62]],"They have provoked me to jealousy with [that which is] not God, they have exasperated me with their idols; and I will provoke them to jealousy with them that are no nation, I will anger them with a nation void of understanding."],["22",[["ὅτι",709803,7],["πῦρ",711088,15],["ἐκκέκαυται",704205,187],["ἐκ",704132,0],["τοῦ",709436,35],["θυμοῦ",706334,18],["μου",709032,133],["καυθήσεται",707049,134],["ἕως",705792,0],["ᾅδου",700255,18],["κάτω",707557,28],["καταφάγεται",707519,93],["γῆν",703083,9],["καὶ",707031,7],["τὰ",709436,41],["γενήματα",703052,42],["αὐτῆς",702165,86],["φλέξει",713518,127],["θεμέλια",706181,68],["ὀρέων",709768,44]],"For a fire has been kindled out of my wrath, it shall burn to hell below; it shall devour the land, and the fruits of it; it shall set on fire the foundations of the mountains."],["23",[["συνάξω",712375,165],["εἰς",704105,0],["αὐτοὺς",702165,62],["κακὰ",707066,68],["καὶ",707031,7],["τὰ",709436,41],["βέλη",702644,42],["μου",709032,133],["συντελέσω",712510,165],["εἰς",704105,0],["αὐτούς",702165,62]],"I will gather evils upon them, and will fight with my weapons against them."],["24",[["τηκόμενοι",712839,348],["λιμῷ",708210,114],["καὶ",707031,7],["βρώσει",702825,1],["ὀρνέων",709762,44],["καὶ",707031,7],["ὀπισθότονος",709694,14],["ἀνίατος",701166,14],["ὀδόντας",709461,57],["θηρίων",706252,44],["ἀποστελῶ",701592,165],["εἰς",704105,0],["αὐτοὺς",702165,62],["μετὰ",708780,0],["θυμοῦ",706334,18],["συρόντων",712543,170],["ἐπὶ",705080,0],["γῆς",703083,17]],"[They shall be] consumed with hunger and the devouring of birds, and there shall be irremediable destruction: I will send forth against them the teeth of wild beasts, with the rage of [serpents] creeping on the ground."],["25",[["ἔξωθεν",704984,28],["ἀτεκνώσει",702081,127],["αὐτοὺς",702165,62],["μάχαιρα",708593,12],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,43],["ταμιείων",712700,44],["φόβος",713534,4],["νεανίσκος",709232,4],["σὺν",712372,0],["παρθένῳ",710148,1],["θηλάζων",706233,72],["μετὰ",708780,0],["καθεστηκότος",707011,310],["πρεσβύτου",710736,18]],"Without, the sword shall bereave them of children, and terror [shall issue] out of the secret chambers; the young man shall perish with the virgin, the suckling with him who has grown old."],["26",[["εἶπα",705373,155],["διασπερῶ",703584,165],["αὐτούς",702165,62],["παύσω",710202,165],["δὴ",703395,11],["ἐξ",704132,0],["ἀνθρώπων",701163,81],["τὸ",709436,24],["μνημόσυνον",708966,25],["αὐτῶν",702165,40]],"I said, I will scatter them, and I will cause their memorial to cease from among men."],["27",[["εἰ",704071,7],["μὴ",708851,28],["δι᾿",703417,0],["ὀργὴν",709728,9],["ἐχθρῶν",705779,81],["ἵνα",706747,7],["μὴ",708851,28],["μακροχρονίσωσιν",708425,234],["καὶ",707031,7],["ἵνα",706747,7],["μὴ",708851,28],["συνεπιθῶνται",712453,232],["οἱ",709436,136],["ὑπεναντίοι",713109,138],["μὴ",708851,28],["εἴπωσιν",705373,234],["ἡ",709436,10],["χεὶρ",713787,12],["ἡμῶν",705999,145],["ἡ",709436,10],["ὑψηλὴ",713285,29],["καὶ",707031,7],["οὐχὶ",709862,28],["κύριος",707996,4],["ἐποίησεν",710582,2],["ταῦτα",709858,71],["πάντα",710177,68]],"Were it not for the wrath of the enemy, lest they should live long, lest their enemies should combine against them; lest they should say, Our own high arm, and not the Lord, has done all these things."],["28",[["ὅτι",709803,7],["ἔθνος",704068,15],["ἀπολωλεκὸς",701513,426],["βουλήν",702792,9],["ἐστιν",704093,91],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐν",704639,0],["αὐτοῖς",702165,151],["ἐπιστήμη",705267,12]],"It is a nation that has lost counsel, neither is there understanding in them."],["29",[["οὐκ",709805,28],["ἐφρόνησαν",713586,150],["συνιέναι",712481,55],["ταῦτα",709858,71],["καταδεξάσθωσαν",707238,486],["εἰς",704105,0],["τὸν",709436,5],["ἐπιόντα",705058,183],["χρόνον",713969,6]],"They had not sense to understand: let them reserve these things against the time to come."],["30",[["πῶς",711121,28],["διώξεται",703768,93],["εἷς",704106,14],["χιλίους",713859,60],["καὶ",707031,7],["δύο",703849,59],["μετακινήσουσιν",708797,218],["μυριάδας",709062,39],["εἰ",704071,7],["μὴ",708851,28],["ὁ",709436,3],["θεὸς",706192,4],["ἀπέδοτο",701449,23],["αὐτοὺς",702165,62],["καὶ",707031,7],["κύριος",707996,4],["παρέδωκεν",710014,2],["αὐτούς",702165,62]],"How should one pursue a thousand, and two rout tens of thousands, if God had not sold them, and the Lord delivered them up?"],["31",[["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ὡς",714148,7],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["οἱ",709436,136],["θεοὶ",706192,52],["αὐτῶν",702165,40],["οἱ",709436,136],["δὲ",703303,11],["ἐχθροὶ",705779,52],["ἡμῶν",705999,145],["ἀνόητοι",701184,138]],"For their gods are not as our God, but our enemies [are] void of understanding."],["32",[["ἐκ",704132,0],["γὰρ",702963,11],["ἀμπέλου",700870,17],["Σοδομων",711920,81],["ἡ",709436,10],["ἄμπελος",700870,12],["αὐτῶν",702165,40],["καὶ",707031,7],["ἡ",709436,10],["κληματὶς",707721,12],["αὐτῶν",702165,40],["ἐκ",704132,0],["Γομορρας",703165,17],["ἡ",709436,10],["σταφυλὴ",712052,12],["αὐτῶν",702165,40],["σταφυλὴ",712052,12],["χολῆς",713900,17],["βότρυς",702775,4],["πικρίας",710472,17],["αὐτοῖς",702165,151]],"For their vine [is] of the vine of Sodom, and their vine-branch of Gomorrha: their grape [is] a grape of gall, their cluster [is] one of bitterness."],["33",[["θυμὸς",706334,4],["δρακόντων",703822,81],["ὁ",709436,3],["οἶνος",709530,4],["αὐτῶν",702165,40],["καὶ",707031,7],["θυμὸς",706334,4],["ἀσπίδων",701991,65],["ἀνίατος",701166,14]],"Their wine [is] the rage of serpents, and the incurable rage of asps."],["34",[["οὐκ",709805,28],["ἰδοὺ",706497,88],["ταῦτα",709858,290],["συνῆκται",712375,187],["παρ᾿",709995,0],["ἐμοὶ",704577,159],["καὶ",707031,7],["ἐσφράγισται",712590,187],["ἐν",704639,0],["τοῖς",709436,147],["θησαυροῖς",706258,148],["μου",709032,133]],"Lo! are not these things stored up by me, and sealed among my treasures?"],["35",[["ἐν",704639,0],["ἡμέρᾳ",705984,1],["ἐκδικήσεως",704175,17],["ἀνταποδώσω",701215,165],["ἐν",704639,0],["καιρῷ",707047,114],["ὅταν",709801,28],["σφαλῇ",712575,384],["ὁ",709436,3],["ποὺς",710707,4],["αὐτῶν",702165,40],["ὅτι",709803,7],["ἐγγὺς",703948,28],["ἡμέρα",705984,12],["ἀπωλείας",701660,17],["αὐτῶν",702165,40],["καὶ",707031,7],["πάρεστιν",710126,91],["ἕτοιμα",705541,195],["ὑμῖν",713084,90]],"In the day of vengeance I will recompense, whensoever their foot shall be tripped up; for the day of their destruction [is] near to them, and the judgments at hand are close upon you."],["36",[["ὅτι",709803,7],["κρινεῖ",707905,127],["κύριος",707996,4],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπὶ",705080,0],["τοῖς",709436,147],["δούλοις",703817,148],["αὐτοῦ",702165,102],["παρακληθήσεται",710039,134],["εἶδεν",709725,2],["γὰρ",702963,11],["παραλελυμένους",710070,360],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἐκλελοιπότας",704237,277],["ἐν",704639,0],["ἐπαγωγῇ",704995,1],["καὶ",707031,7],["παρειμένους",710149,360]],"For the Lord shall judge his people, and shall be comforted over his servants; for he saw that they were utterly weakened, and failed in the hostile invasion, and were become feeble:"],["37",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["ποῦ",710706,28],["εἰσιν",704093,197],["οἱ",709436,136],["θεοὶ",706192,52],["αὐτῶν",702165,40],["ἐφ᾿",705080,0],["οἷς",709781,311],["ἐπεποίθεισαν",710221,263],["ἐπ᾿",705080,0],["αὐτοῖς",702165,151]],"and the Lord said, Where are their gods on whom they trusted?"],["38",[["ὧν",709781,252],["τὸ",709436,24],["στέαρ",712054,25],["τῶν",709436,130],["θυσιῶν",706345,65],["αὐτῶν",702165,40],["ἠσθίετε",705495,399],["καὶ",707031,7],["ἐπίνετε",710478,399],["τὸν",709436,5],["οἶνον",709530,6],["τῶν",709436,130],["σπονδῶν",712025,65],["αὐτῶν",702165,40],["ἀναστήτωσαν",701173,264],["καὶ",707031,7],["βοηθησάτωσαν",702746,264],["ὑμῖν",713084,90],["καὶ",707031,7],["γενηθήτωσαν",703104,51],["ὑμῖν",713084,90],["σκεπασταί",711836,52]],"the fat of whose sacrifices ye ate, and ye drank the wine of their drink-offerings? let them arise and help you, and be your protectors."],["39",[["ἴδετε",709725,74],["ἴδετε",709725,74],["ὅτι",709803,7],["ἐγώ",704018,164],["εἰμι",704093,157],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["θεὸς",706192,4],["πλὴν",710540,28],["ἐμοῦ",704580,133],["ἐγὼ",704018,164],["ἀποκτενῶ",701498,165],["καὶ",707031,7],["ζῆν",705851,55],["ποιήσω",710582,165],["πατάξω",710185,165],["κἀγὼ",706969,288],["ἰάσομαι",706424,181],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ὃς",709781,213],["ἐξελεῖται",704838,93],["ἐκ",704132,0],["τῶν",709436,130],["χειρῶν",713787,65],["μου",709032,133]],"Behold, behold that I am [he], and there is no god beside me: I kill, and I will make to live: I will smite, and I will heal; and there is none who shall deliver out of my hands."],["40",[["ὅτι",709803,7],["ἀρῶ",700473,165],["εἰς",704105,0],["τὸν",709436,5],["οὐρανὸν",709844,6],["τὴν",709436,8],["χεῖρά",713787,9],["μου",709032,133],["καὶ",707031,7],["ὀμοῦμαι",709620,181],["τῇ",709436,100],["δεξιᾷ",703360,101],["μου",709032,133],["καὶ",707031,7],["ἐρῶ",705415,165],["ζῶ",705851,157],["ἐγὼ",704018,164],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"For I will lift up my hand to heaven, and swear by my right hand, and I will say, I live for ever."],["41",[["ὅτι",709803,7],["παροξυνῶ",710164,165],["ὡς",714148,7],["ἀστραπὴν",702021,9],["τὴν",709436,8],["μάχαιράν",708593,9],["μου",709032,133],["καὶ",707031,7],["ἀνθέξεται",701225,93],["κρίματος",707903,21],["ἡ",709436,10],["χείρ",713787,12],["μου",709032,133],["καὶ",707031,7],["ἀνταποδώσω",701215,165],["δίκην",703702,9],["τοῖς",709436,147],["ἐχθροῖς",705779,148],["καὶ",707031,7],["τοῖς",709436,147],["μισοῦσίν",708935,349],["με",708618,163],["ἀνταποδώσω",701215,165]],"For I will sharpen my sword like lightning, and my hand shall take hold of judgment; and I will render judgment to my enemies, and will recompense them that hate me."],["42",[["μεθύσω",708676,165],["τὰ",709436,41],["βέλη",702644,42],["μου",709032,133],["ἀφ᾿",701425,0],["αἵματος",700442,21],["καὶ",707031,7],["ἡ",709436,10],["μάχαιρά",708593,12],["μου",709032,133],["καταφάγεται",707519,93],["κρέα",707889,42],["ἀφ᾿",701425,0],["αἵματος",700442,21],["τραυματιῶν",712921,81],["καὶ",707031,7],["αἰχμαλωσίας",700499,17],["ἀπὸ",701425,0],["κεφαλῆς",707639,17],["ἀρχόντων",701862,81],["ἐχθρῶν",705779,81]],"I will make my weapons drunk with blood, and my sword shall devour flesh, [it shall glut itself] with the blood of the wounded, and from the captivity of the heads of [their] enemies that rule over them."],["43",[["εὐφράνθητε",705715,372],["οὐρανοί",709844,52],["ἅμα",700745,28],["αὐτῷ",702165,50],["καὶ",707031,7],["προσκυνησάτωσαν",710925,264],["αὐτῷ",702165,50],["πάντες",710177,138],["υἱοὶ",713075,52],["θεοῦ",706192,18],["εὐφράνθητε",705715,372],["ἔθνη",704068,64],["μετὰ",708780,0],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐνισχυσάτωσαν",704750,264],["αὐτῷ",702165,50],["πάντες",710177,138],["ἄγγελοι",700140,52],["θεοῦ",706192,18],["ὅτι",709803,7],["τὸ",709436,24],["αἷμα",700442,25],["τῶν",709436,80],["υἱῶν",713075,81],["αὐτοῦ",702165,102],["ἐκδικᾶται",704173,93],["καὶ",707031,7],["ἐκδικήσει",704174,127],["καὶ",707031,7],["ἀνταποδώσει",701215,127],["δίκην",703702,9],["τοῖς",709436,147],["ἐχθροῖς",705779,148],["καὶ",707031,7],["τοῖς",709436,147],["μισοῦσιν",708935,349],["ἀνταποδώσει",701215,127],["καὶ",707031,7],["ἐκκαθαριεῖ",704202,127],["κύριος",707996,4],["τὴν",709436,8],["γῆν",703083,9],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτοῦ",702165,102]],"Rejoice, ye heavens, with him, and let all the angels of God worship him; rejoice ye Gentiles, with his people, and let all the sons of God strengthen themselves in him; for he will avenge the blood of his sons, and he will render vengeance, and recompense justice to his enemies, and will reward them that hate him; and the Lord shall purge the land of his people."],["44",[["καὶ",707031,7],["ἔγραψεν",703194,2],["Μωυσῆς",709112,4],["τὴν",709436,8],["ᾠδὴν",714091,9],["ταύτην",709858,104],["ἐν",704639,0],["ἐκείνῃ",704183,105],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["καὶ",707031,7],["ἐδίδαξεν",703649,2],["αὐτὴν",702165,104],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ισραηλ",706839,18],["καὶ",707031,7],["εἰσῆλθεν",704114,2],["Μωυσῆς",709112,4],["καὶ",707031,7],["ἐλάλησεν",708071,2],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["τοῦ",709436,35],["νόμου",709349,18],["τούτου",709858,102],["εἰς",704105,0],["τὰ",709436,41],["ὦτα",709852,42],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτὸς",702165,121],["καὶ",707031,7],["Ἰησοῦς",706701,4],["ὁ",709436,3],["τοῦ",709436,35],["Ναυη",709206,18]],"And Moses wrote this song in that day, and taught it to the children of Israel; and Moses went in and spoke all the words of this law in the ears of the people, he and Joshua the [son] of Naue."],["45",[["καὶ",707031,7],["συνετέλεσεν",712510,2],["Μωυσῆς",709112,4],["λαλῶν",708071,72],["παντὶ",710177,30],["Ισραηλ",706839,114]],"And Moses finished speaking to all Israel."],["46",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτούς",702165,62],["προσέχετε",710895,335],["τῇ",709436,100],["καρδίᾳ",707141,1],["ἐπὶ",705080,0],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["οὓς",709781,298],["ἐγὼ",704018,164],["διαμαρτύρομαι",703513,254],["ὑμῖν",713084,90],["σήμερον",711751,28],["ἃ",709781,69],["ἐντελεῖσθε",704791,374],["τοῖς",709436,147],["υἱοῖς",713075,148],["ὑμῶν",713091,145],["φυλάσσειν",713619,55],["καὶ",707031,7],["ποιεῖν",710582,55],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["τοῦ",709436,35],["νόμου",709349,18],["τούτου",709858,102]],"And he said to them, Take heed with your heart to all these words, which I testify to you this day, which ye shall command your sons, to observe and do all the words of this law."],["47",[["ὅτι",709803,7],["οὐχὶ",709862,28],["λόγος",708236,4],["κενὸς",707612,14],["οὗτος",709858,121],["ὑμῖν",713084,90],["ὅτι",709803,7],["αὕτη",709858,107],["ἡ",709436,10],["ζωὴ",705910,12],["ὑμῶν",713091,145],["καὶ",707031,7],["ἕνεκεν",704709,0],["τοῦ",709436,35],["λόγου",708236,18],["τούτου",709858,102],["μακροημερεύσετε",708415,337],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["εἰς",704105,0],["ἣν",709781,131],["ὑμεῖς",713081,219],["διαβαίνετε",703419,87],["τὸν",709436,5],["Ιορδάνην",706763,6],["ἐκεῖ",704181,28],["κληρονομῆσαι",707724,106],["αὐτήν",702165,104]],"For this [is] no vain word to you; for it [is] your life, and because of this word ye shall live long upon the land, into which ye go over Jordan to inherit it."],["48",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ταύτῃ",709858,105],["λέγων",708124,72]],"And the Lord spoke to Moses in this day, saying,"],["49",[["ἀνάβηθι",700905,176],["εἰς",704105,0],["τὸ",709436,24],["ὄρος",709768,25],["τὸ",709436,24],["Αβαριν",700019,18],["τοῦτο",709858,129],["ὄρος",709768,25],["Ναβαυ",709137,18],["ὅ",709781,33],["ἐστιν",704093,91],["ἐν",704639,0],["γῇ",703083,1],["Μωαβ",709085,18],["κατὰ",707200,0],["πρόσωπον",710986,25],["Ιεριχω",706620,18],["καὶ",707031,7],["ἰδὲ",709725,176],["τὴν",709436,8],["γῆν",703083,9],["Χανααν",713708,18],["ἣν",709781,131],["ἐγὼ",704018,164],["δίδωμι",703654,157],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["εἰς",704105,0],["κατάσχεσιν",707451,9]],"Go up to the mount Abarim, this mountain Nabau which is in the land of Moab over against Jericho, and behold the land of Chanaan, which I give to the sons of Israel:"],["50",[["καὶ",707031,7],["τελεύτα",712781,240],["ἐν",704639,0],["τῷ",709436,53],["ὄρει",709768,54],["εἰς",704105,0],["ὃ",709781,128],["ἀναβαίνεις",700905,154],["ἐκεῖ",704181,28],["καὶ",707031,7],["προστέθητι",710965,244],["πρὸς",710844,0],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133],["ὃν",709781,112],["τρόπον",712980,6],["ἀπέθανεν",701461,2],["Ααρων",700005,4],["ὁ",709436,3],["ἀδελφός",700249,4],["σου",711945,133],["ἐν",704639,0],["Ωρ",714127,114],["τῷ",709436,53],["ὄρει",709768,54],["καὶ",707031,7],["προσετέθη",710965,37],["πρὸς",710844,0],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102]],"and die in the mount whither thou goest up, and be added to thy people; as Aaron thy brother died in mount Or, and was added to his people."],["51",[["διότι",703734,7],["ἠπειθήσατε",701370,265],["τῷ",709436,53],["ῥήματί",711246,54],["μου",709032,133],["ἐν",704639,0],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["ἐπὶ",705080,0],["τοῦ",709436,20],["ὕδατος",713071,21],["ἀντιλογίας",701249,17],["Καδης",706973,17],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["Σιν",711793,18],["διότι",703734,7],["οὐχ",709805,28],["ἡγιάσατέ",700153,265],["με",708618,163],["ἐν",704639,0],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18]],"Because ye disobeyed my word among the children of Israel, at the waters of strife of Cades in the wilderness of Sin; because ye sanctified me not among the sons of Israel."],["52",[["ὅτι",709803,7],["ἀπέναντι",701389,0],["ὄψῃ",709725,123],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἐκεῖ",704181,28],["οὐκ",709805,28],["εἰσελεύσῃ",704114,123]],"Thou shalt see the land before [thee], but thou shalt not enter into it."]]