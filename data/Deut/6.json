[["1",[["καὶ",707031,7],["αὗται",709858,202],["αἱ",709436,190],["ἐντολαὶ",704802,191],["καὶ",707031,7],["τὰ",709436,63],["δικαιώματα",703697,64],["καὶ",707031,7],["τὰ",709436,63],["κρίματα",707903,64],["ὅσα",709788,68],["ἐνετείλατο",704791,23],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["διδάξαι",703649,106],["ὑμᾶς",713080,194],["ποιεῖν",710582,55],["οὕτως",709859,28],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["εἰς",704105,0],["ἣν",709781,131],["ὑμεῖς",713081,219],["εἰσπορεύεσθε",704124,374],["ἐκεῖ",704181,28],["κληρονομῆσαι",707724,106],["αὐτήν",702165,104]],"And these [are] the commands, and the ordinances, and the judgments, as many as the Lord our God gave commandment to teach you to do so in the land on which ye enter to inherit it."],["2",[["ἵνα",706747,7],["φοβῆσθε",713532,375],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["ὑμῶν",713091,145],["φυλάσσεσθαι",713619,110],["πάντα",710177,68],["τὰ",709436,41],["δικαιώματα",703697,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰς",709436,38],["ἐντολὰς",704802,39],["αὐτοῦ",702165,102],["ὅσας",709788,119],["ἐγὼ",704018,164],["ἐντέλλομαί",704791,254],["σοι",711925,159],["σήμερον",711751,28],["σὺ",712181,164],["καὶ",707031,7],["οἱ",709436,136],["υἱοί",713075,52],["σου",711945,133],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["τῶν",709436,80],["υἱῶν",713075,81],["σου",711945,133],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["τῆς",709436,16],["ζωῆς",705910,17],["σου",711945,133],["ἵνα",706747,7],["μακροημερεύσητε",708415,125]],"That ye may fear the Lord your God, keep ye all his ordinances, and his commandments, which I command thee to-day, thou, and thy sons, and thy sons' sons, all the days of thy life, that ye may live many days."],["3",[["καὶ",707031,7],["ἄκουσον",700587,176],["Ισραηλ",706839,153],["καὶ",707031,7],["φύλαξαι",713619,300],["ποιεῖν",710582,55],["ὅπως",709719,7],["εὖ",705544,28],["σοι",711925,159],["ᾖ",704093,204],["καὶ",707031,7],["ἵνα",706747,7],["πληθυνθῆτε",710530,394],["σφόδρα",712586,28],["καθάπερ",706984,28],["ἐλάλησεν",708071,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,80],["πατέρων",710189,81],["σου",711945,133],["δοῦναί",703654,106],["σοι",711925,159],["γῆν",703083,9],["ῥέουσαν",711241,78],["γάλα",702919,25],["καὶ",707031,7],["μέλι",708700,25]],"Hear, therefore, O Israel, and observe to do them, that it may be well with thee, and that ye may be greatly multiplied, as the Lord God of thy fathers said that he would give thee a land flowing with milk and honey: and these [are] the ordinances, and the judgments, which the Lord commanded the children of Israel in the wilderness, when they had gone forth from the land of Egypt."],["4",[["καὶ",707031,7],["ταῦτα",709858,290],["τὰ",709436,63],["δικαιώματα",703697,64],["καὶ",707031,7],["τὰ",709436,63],["κρίματα",707903,64],["ὅσα",709788,68],["ἐνετείλατο",704791,23],["κύριος",707996,4],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["ἐξελθόντων",704909,221],["αὐτῶν",702165,40],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["ἄκουε",700587,240],["Ισραηλ",706839,153],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["κύριος",707996,4],["εἷς",704106,14],["ἐστιν",704093,91]],"Hear, O Israel, The Lord our God is one Lord."],["5",[["καὶ",707031,7],["ἀγαπήσεις",700120,166],["κύριον",707996,6],["τὸν",709436,5],["θεόν",706192,6],["σου",711945,133],["ἐξ",704132,0],["ὅλης",709597,82],["τῆς",709436,16],["καρδίας",707141,17],["σου",711945,133],["καὶ",707031,7],["ἐξ",704132,0],["ὅλης",709597,82],["τῆς",709436,16],["ψυχῆς",714070,17],["σου",711945,133],["καὶ",707031,7],["ἐξ",704132,0],["ὅλης",709597,82],["τῆς",709436,16],["δυνάμεώς",703839,17],["σου",711945,133]],"And thou shalt love the Lord thy God with all thy mind, and with all thy soul, and all thy strength."],["6",[["καὶ",707031,7],["ἔσται",704093,93],["τὰ",709436,63],["ῥήματα",711246,64],["ταῦτα",709858,290],["ὅσα",709788,68],["ἐγὼ",704018,164],["ἐντέλλομαί",704791,254],["σοι",711925,159],["σήμερον",711751,28],["ἐν",704639,0],["τῇ",709436,100],["καρδίᾳ",707141,1],["σου",711945,133],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["ψυχῇ",714070,1],["σου",711945,133]],"And these words, all that I command thee this day, shall be in thy heart and in thy soul."],["7",[["καὶ",707031,7],["προβιβάσεις",710769,166],["αὐτὰ",702165,71],["τοὺς",709436,58],["υἱούς",713075,57],["σου",711945,133],["καὶ",707031,7],["λαλήσεις",708071,166],["ἐν",704639,0],["αὐτοῖς",702165,206],["καθήμενος",707000,122],["ἐν",704639,0],["οἴκῳ",709516,114],["καὶ",707031,7],["πορευόμενος",710667,122],["ἐν",704639,0],["ὁδῷ",709458,1],["καὶ",707031,7],["κοιταζόμενος",707779,122],["καὶ",707031,7],["διανιστάμενος",703527,122]],"And thou shalt teach them to thy children, and thou shalt speak of them sitting in the house, and walking by the way, and lying down, and rising up."],["8",[["καὶ",707031,7],["ἀφάψεις",702184,166],["αὐτὰ",702165,71],["εἰς",704105,0],["σημεῖον",711748,25],["ἐπὶ",705080,0],["τῆς",709436,16],["χειρός",713787,17],["σου",711945,133],["καὶ",707031,7],["ἔσται",704093,93],["ἀσάλευτον",701881,27],["πρὸ",710747,0],["ὀφθαλμῶν",709870,81],["σου",711945,133]],"And thou shalt fasten them for a sign upon thy hand, and it shall be immoveable before thine eyes."],["9",[["καὶ",707031,7],["γράψετε",703194,337],["αὐτὰ",702165,71],["ἐπὶ",705080,0],["τὰς",709436,38],["φλιὰς",713520,39],["τῶν",709436,130],["οἰκιῶν",709505,65],["ὑμῶν",713091,145],["καὶ",707031,7],["τῶν",709436,130],["πυλῶν",711082,65],["ὑμῶν",713091,145]],"And ye shall write them on the lintels of your houses and of your gates."],["10",[["καὶ",707031,7],["ἔσται",704093,93],["ὅταν",709801,28],["εἰσαγάγῃ",704107,172],["σε",711598,163],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["ὤμοσεν",709620,2],["τοῖς",709436,147],["πατράσιν",710189,148],["σου",711945,133],["τῷ",709436,113],["Αβρααμ",700091,114],["καὶ",707031,7],["Ισαακ",706799,114],["καὶ",707031,7],["Ιακωβ",706401,114],["δοῦναί",703654,106],["σοι",711925,159],["πόλεις",710612,39],["μεγάλας",708653,119],["καὶ",707031,7],["καλάς",707097,119],["ἃς",709781,193],["οὐκ",709805,28],["ᾠκοδόμησας",709509,162]],"And it shall come to pass when the Lord thy God shall have brought thee into the land which he sware to thy fathers, to Abraam, and to Isaac, and to Jacob, to give thee great and beautiful cities which thou didst not build,"],["11",[["οἰκίας",709505,39],["πλήρεις",710541,119],["πάντων",710177,83],["ἀγαθῶν",700106,83],["ἃς",709781,193],["οὐκ",709805,28],["ἐνέπλησας",704592,162],["λάκκους",708067,57],["λελατομημένους",708102,360],["οὓς",709781,298],["οὐκ",709805,28],["ἐξελατόμησας",704235,162],["ἀμπελῶνας",700872,57],["καὶ",707031,7],["ἐλαιῶνας",704381,57],["οὓς",709781,298],["οὐ",709805,28],["κατεφύτευσας",707487,162],["καὶ",707031,7],["φαγὼν",705495,182],["καὶ",707031,7],["ἐμπλησθεὶς",704592,217]],"houses full of all good things which thou didst not fill, wells dug in the rock which thou didst not dig, vineyards and oliveyards which thou didst not plant, then having eaten and been filled,"],["12",[["πρόσεχε",710895,240],["σεαυτῷ",711599,50],["μὴ",708851,28],["ἐπιλάθῃ",705187,420],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133],["τοῦ",709436,35],["ἐξαγαγόντος",704834,500],["σε",711598,163],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["ἐξ",704132,0],["οἴκου",709516,18],["δουλείας",703813,17]],"beware lest thou forget the Lord thy God that brought thee forth out of the land of Egypt, out of the house of bondage."],["13",[["κύριον",707996,6],["τὸν",709436,5],["θεόν",706192,6],["σου",711945,133],["φοβηθήσῃ",713532,364],["καὶ",707031,7],["αὐτῷ",702165,50],["λατρεύσεις",708108,166],["καὶ",707031,7],["πρὸς",710844,0],["αὐτὸν",702165,85],["κολληθήσῃ",707791,364],["καὶ",707031,7],["τῷ",709436,53],["ὀνόματι",709666,54],["αὐτοῦ",702165,102],["ὀμῇ",709620,123]],"Thou shalt fear the Lord thy God, and him only shalt thou serve; and thou shalt cleave to him, and by his name thou shalt swear."],["14",[["οὐ",709805,28],["πορεύσεσθε",710667,124],["ὀπίσω",709697,0],["θεῶν",706192,81],["ἑτέρων",705535,169],["ἀπὸ",701425,0],["τῶν",709436,80],["θεῶν",706192,81],["τῶν",709436,43],["ἐθνῶν",704068,44],["τῶν",709436,43],["περικύκλῳ",710340,28],["ὑμῶν",713091,145]],"Go ye not after other gods of the gods of the nations round about you;"],["15",[["ὅτι",709803,7],["θεὸς",706192,4],["ζηλωτὴς",705875,4],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ἐν",704639,0],["σοί",711925,159],["μὴ",708851,28],["ὀργισθεὶς",709729,217],["θυμωθῇ",706335,384],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ἐν",704639,0],["σοὶ",711925,159],["καὶ",707031,7],["ἐξολεθρεύσῃ",704956,172],["σε",711598,163],["ἀπὸ",701425,0],["προσώπου",710986,21],["τῆς",709436,16],["γῆς",703083,17]],"for the Lord thy God in the midst of thee [is] a jealous God, lest the Lord thy God be very angry with thee, and destroy thee from off the face of the earth."],["16",[["οὐκ",709805,28],["ἐκπειράσεις",704273,166],["κύριον",707996,6],["τὸν",709436,5],["θεόν",706192,6],["σου",711945,133],["ὃν",709781,112],["τρόπον",712980,6],["ἐξεπειράσασθε",704273,345],["ἐν",704639,0],["τῷ",709436,113],["Πειρασμῷ",710226,114]],"Thou shalt not tempt the Lord thy God, as ye tempted him in the temptation."],["17",[["φυλάσσων",713619,72],["φυλάξῃ",713619,123],["τὰς",709436,38],["ἐντολὰς",704802,39],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133],["τὰ",709436,41],["μαρτύρια",708525,42],["καὶ",707031,7],["τὰ",709436,41],["δικαιώματα",703697,42],["ὅσα",709788,68],["ἐνετείλατό",704791,23],["σοι",711925,159]],"Thou shalt by all means keep the commands of the Lord thy God, the testimonies, and the ordinances, which he commanded thee."],["18",[["καὶ",707031,7],["ποιήσεις",710582,166],["τὸ",709436,24],["ἀρεστὸν",701723,46],["καὶ",707031,7],["τὸ",709436,24],["καλὸν",707097,46],["ἐναντίον",704654,0],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ὑμῶν",713091,145],["ἵνα",706747,7],["εὖ",705544,28],["σοι",711925,159],["γένηται",703104,239],["καὶ",707031,7],["εἰσέλθῃς",704114,175],["καὶ",707031,7],["κληρονομήσῃς",707724,175],["τὴν",709436,8],["γῆν",703083,9],["τὴν",709436,8],["ἀγαθήν",700106,36],["ἣν",709781,131],["ὤμοσεν",709620,2],["κύριος",707996,4],["τοῖς",709436,147],["πατράσιν",710189,148],["ὑμῶν",713091,145]],"And thou shalt do that which is pleasing and good before the Lord thy God, that it may be well with thee, and that thou mayest go in and inherit the good land, which the Lord sware to your fathers,"],["19",[["ἐκδιῶξαι",704178,106],["πάντας",710177,60],["τοὺς",709436,58],["ἐχθρούς",705779,57],["σου",711945,133],["πρὸ",710747,0],["προσώπου",710986,21],["σου",711945,133],["καθὰ",706979,28],["ἐλάλησεν",708071,2]],"to chase all thine enemies from before thy face, as the Lord said."],["20",[["καὶ",707031,7],["ἔσται",704093,93],["ὅταν",709801,28],["ἐρωτήσῃ",705459,172],["σε",711598,163],["ὁ",709436,3],["υἱός",713075,4],["σου",711945,133],["αὔριον",702149,28],["λέγων",708124,72],["τί",712867,273],["ἐστιν",704093,91],["τὰ",709436,63],["μαρτύρια",708525,64],["καὶ",707031,7],["τὰ",709436,63],["δικαιώματα",703697,64],["καὶ",707031,7],["τὰ",709436,63],["κρίματα",707903,64],["ὅσα",709788,68],["ἐνετείλατο",704791,23],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["ἡμῖν",705994,90]],"And it shall come to pass when thy son shall ask thee at a future time, saying, What are the testimonies, and the ordinances, and the judgments, which the Lord our God has commanded us?"],["21",[["καὶ",707031,7],["ἐρεῖς",705415,166],["τῷ",709436,113],["υἱῷ",713075,114],["σου",711945,133],["οἰκέται",709496,52],["ἦμεν",704093,421],["τῷ",709436,113],["Φαραω",713360,114],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτῳ",700401,1],["καὶ",707031,7],["ἐξήγαγεν",704834,2],["ἡμᾶς",705981,194],["κύριος",707996,4],["ἐκεῖθεν",704182,28],["ἐν",704639,0],["χειρὶ",713787,1],["κραταιᾷ",707873,101],["καὶ",707031,7],["ἐν",704639,0],["βραχίονι",702808,114],["ὑψηλῷ",713285,30]],"Then shalt thou say to thy son, We were slaves to Pharao in the land of Egypt, and the Lord brought us forth thence with a mighty hand, and with a high arm."],["22",[["καὶ",707031,7],["ἔδωκεν",703654,2],["κύριος",707996,4],["σημεῖα",711748,42],["καὶ",707031,7],["τέρατα",712793,42],["μεγάλα",708653,68],["καὶ",707031,7],["πονηρὰ",710660,68],["ἐν",704639,0],["Αἰγύπτῳ",700401,1],["ἐν",704639,0],["Φαραω",713360,114],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["αὐτοῦ",702165,102],["ἐνώπιον",704823,0],["ἡμῶν",705999,145]],"And the Lord wrought signs and great and grievous wonders in Egypt, on Pharao and on his house before us."],["23",[["καὶ",707031,7],["ἡμᾶς",705981,194],["ἐξήγαγεν",704834,2],["ἐκεῖθεν",704182,28],["ἵνα",706747,7],["εἰσαγάγῃ",704107,172],["ἡμᾶς",705981,194],["δοῦναι",703654,106],["ἡμῖν",705994,90],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104],["ἣν",709781,131],["ὤμοσεν",709620,2],["δοῦναι",703654,106],["τοῖς",709436,147],["πατράσιν",710189,148],["ἡμῶν",705999,145]],"And he brought us out thence to give us this land, which he sware to give to our fathers."],["24",[["καὶ",707031,7],["ἐνετείλατο",704791,23],["ἡμῖν",705994,90],["κύριος",707996,4],["ποιεῖν",710582,55],["πάντα",710177,68],["τὰ",709436,41],["δικαιώματα",703697,42],["ταῦτα",709858,71],["φοβεῖσθαι",713532,110],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["ἡμῶν",705999,145],["ἵνα",706747,7],["εὖ",705544,28],["ᾖ",704093,204],["ἡμῖν",705994,90],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["ἵνα",706747,7],["ζῶμεν",705851,233],["ὥσπερ",714163,28],["καὶ",707031,28],["σήμερον",711751,28]],"And the Lord charged us to observe all these ordinances; to fear the Lord our God, that it may be well with us for ever, that we may live, as even to-day."],["25",[["καὶ",707031,7],["ἐλεημοσύνη",704421,12],["ἔσται",704093,93],["ἡμῖν",705994,90],["ἐὰν",703912,7],["φυλασσώμεθα",713619,488],["ποιεῖν",710582,55],["πάσας",710177,119],["τὰς",709436,38],["ἐντολὰς",704802,39],["ταύτας",709858,231],["ἐναντίον",704654,0],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["καθὰ",706979,28],["ἐνετείλατο",704791,23],["ἡμῖν",705994,90],["κύριος",707996,4]],"And there shall be mercy to us, if we take heed to keep all these commands before the Lord our God, as he has commanded us."]]