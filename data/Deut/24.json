[["1",[["ἐὰν",703912,7],["δέ",703303,11],["τις",712866,158],["λάβῃ",708076,172],["γυναῖκα",703209,9],["καὶ",707031,7],["συνοικήσῃ",712493,172],["αὐτῇ",702165,105],["καὶ",707031,7],["ἔσται",704093,93],["ἐὰν",703912,7],["μὴ",708851,28],["εὕρῃ",705676,172],["χάριν",713735,9],["ἐναντίον",704654,0],["αὐτοῦ",702165,102],["ὅτι",709803,7],["εὗρεν",705676,2],["ἐν",704639,0],["αὐτῇ",702165,105],["ἄσχημον",702055,46],["πρᾶγμα",710708,25],["καὶ",707031,7],["γράψει",703194,127],["αὐτῇ",702165,105],["βιβλίον",702719,25],["ἀποστασίου",701587,21],["καὶ",707031,7],["δώσει",703654,127],["εἰς",704105,0],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐξαποστελεῖ",704872,127],["αὐτὴν",702165,104],["ἐκ",704132,0],["τῆς",709436,16],["οἰκίας",709505,17],["αὐτοῦ",702165,102]],"And if any one should take a wife, and should dwell with her, then it shall come to pass if she should not have found favour before him, because he has found some unbecoming thing in her, that he shall write for her a bill of divorcement, and give it into her hands, and he shall send her away out of his house."],["2",[["καὶ",707031,7],["ἀπελθοῦσα",701398,149],["γένηται",703104,239],["ἀνδρὶ",701150,114],["ἑτέρῳ",705535,30]],"And [if] she should go away and be married to another man;"],["3",[["καὶ",707031,7],["μισήσῃ",708935,172],["αὐτὴν",702165,104],["ὁ",709436,3],["ἀνὴρ",701150,4],["ὁ",709436,3],["ἔσχατος",705519,14],["καὶ",707031,7],["γράψει",703194,127],["αὐτῇ",702165,105],["βιβλίον",702719,25],["ἀποστασίου",701587,21],["καὶ",707031,7],["δώσει",703654,127],["εἰς",704105,0],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐξαποστελεῖ",704872,127],["αὐτὴν",702165,104],["ἐκ",704132,0],["τῆς",709436,16],["οἰκίας",709505,17],["αὐτοῦ",702165,102],["ἢ",705924,7],["ἀποθάνῃ",701461,172],["ὁ",709436,3],["ἀνὴρ",701150,4],["ὁ",709436,3],["ἔσχατος",705519,14],["ὃς",709781,213],["ἔλαβεν",708076,2],["αὐτὴν",702165,104],["ἑαυτῷ",703917,50],["γυναῖκα",703209,9]],"and the last husband should hate her, and write for her a bill of divorcement; and should give it into her hands, and send her away out of his house, and the last husband should die, who took her to himself for a wife;"],["4",[["οὐ",709805,28],["δυνήσεται",703838,93],["ὁ",709436,3],["ἀνὴρ",701150,4],["ὁ",709436,3],["πρότερος",710992,14],["ὁ",709436,3],["ἐξαποστείλας",704872,182],["αὐτὴν",702165,104],["ἐπαναστρέψας",705020,182],["λαβεῖν",708076,106],["αὐτὴν",702165,104],["ἑαυτῷ",703917,50],["γυναῖκα",703209,9],["μετὰ",708780,0],["τὸ",709436,24],["μιανθῆναι",708900,179],["αὐτήν",702165,104],["ὅτι",709803,7],["βδέλυγμά",702604,25],["ἐστιν",704093,91],["ἐναντίον",704654,0],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133],["καὶ",707031,7],["οὐ",709805,28],["μιανεῖτε",708900,337],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["δίδωσιν",703654,91],["ὑμῖν",713084,90],["ἐν",704639,0],["κλήρῳ",707727,114]],"the former husband who sent her away shall not be able to return and take her to himself for a wife, after she has been defiled; because it is an abomination before the Lord thy God, and ye shall not defile the land, which the Lord thy God gives thee to inherit."],["5",[["ἐὰν",703912,7],["δέ",703303,11],["τις",712866,158],["λάβῃ",708076,172],["γυναῖκα",703209,9],["προσφάτως",710973,28],["οὐκ",709805,28],["ἐξελεύσεται",704909,93],["εἰς",704105,0],["τὸν",709436,5],["πόλεμον",710605,6],["καὶ",707031,7],["οὐκ",709805,28],["ἐπιβληθήσεται",705083,134],["αὐτῷ",702165,50],["οὐδὲν",709817,46],["πρᾶγμα",710708,25],["ἀθῷος",700390,14],["ἔσται",704093,93],["ἐν",704639,0],["τῇ",709436,100],["οἰκίᾳ",709505,1],["αὐτοῦ",702165,102],["ἐνιαυτὸν",704745,6],["ἕνα",704106,27],["εὐφρανεῖ",705715,127],["τὴν",709436,8],["γυναῖκα",703209,9],["αὐτοῦ",702165,102],["ἣν",709781,131],["ἔλαβεν",708076,2]],"And if any one should have recently taken a wife, he shall not go out to war, neither shall any thing be laid upon him; he shall be free in his house; for one year he shall cheer his wife whom he has taken."],["6",[["οὐκ",709805,28],["ἐνεχυράσεις",704722,166],["μύλον",709056,6],["οὐδὲ",709816,7],["ἐπιμύλιον",705210,27],["ὅτι",709803,7],["ψυχὴν",714070,9],["οὗτος",709858,121],["ἐνεχυράζει",704722,91]],"Thou shalt not take for a pledge the under millstone, nor the upper millstone; for he who does so takes life for a pledge."],["7",[["ἐὰν",703912,7],["δὲ",703303,11],["ἁλῷ",700673,172],["ἄνθρωπος",701163,4],["κλέπτων",707715,72],["ψυχὴν",714070,9],["τῶν",709436,80],["ἀδελφῶν",700249,81],["αὐτοῦ",702165,102],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["καὶ",707031,7],["καταδυναστεύσας",707248,182],["αὐτὸν",702165,85],["ἀποδῶται",701449,239],["ἀποθανεῖται",701461,93],["ὁ",709436,3],["κλέπτης",707714,4],["ἐκεῖνος",704183,121],["καὶ",707031,7],["ἐξαρεῖς",704839,166],["τὸν",709436,5],["πονηρὸν",710660,27],["ἐξ",704132,0],["ὑμῶν",713091,145],["αὐτῶν",702165,40]],"And if a man should be caught stealing one of his brethren of the children of Israel, and having overcome him he should sell him, that thief shall die; so shalt thou remove that evil one from yourselves."],["8",[["πρόσεχε",710895,240],["σεαυτῷ",711599,50],["ἐν",704639,0],["τῇ",709436,100],["ἁφῇ",702202,1],["τῆς",709436,16],["λέπρας",708149,17],["φυλάξῃ",713619,123],["σφόδρα",712586,28],["ποιεῖν",710582,55],["κατὰ",707200,0],["πάντα",710177,27],["τὸν",709436,5],["νόμον",709349,6],["ὃν",709781,112],["ἐὰν",703912,7],["ἀναγγείλωσιν",700921,234],["ὑμῖν",713084,90],["οἱ",709436,136],["ἱερεῖς",706614,52],["οἱ",709436,136],["Λευῖται",708160,52],["ὃν",709781,112],["τρόπον",712980,6],["ἐνετειλάμην",704791,161],["ὑμῖν",713084,90],["φυλάξασθε",713619,186],["ποιεῖν",710582,55]],"Take heed to thyself in [regard of] the plague of leprosy: thou shalt take great heed to do according to all the law, which the priests the Levites shall report to you; take heed to do, as I have charged you."],["9",[["μνήσθητι",708960,244],["ὅσα",709788,68],["ἐποίησεν",710582,2],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["τῇ",709436,100],["Μαριαμ",708506,1],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["ἐκπορευομένων",704293,299],["ὑμῶν",713091,145],["ἐξ",704132,0],["Αἰγύπτου",700401,17]],"Remember all that the Lord thy God did to Mariam in the way, when ye were going out of Egypt."],["10",[["ἐὰν",703912,7],["ὀφείλημα",709864,15],["ᾖ",704093,204],["ἐν",704639,0],["τῷ",709436,113],["πλησίον",710547,28],["σου",711945,133],["ὀφείλημα",709864,15],["ὁτιοῦν",709794,513],["οὐκ",709805,28],["εἰσελεύσῃ",704114,123],["εἰς",704105,0],["τὴν",709436,8],["οἰκίαν",709505,9],["αὐτοῦ",702165,102],["ἐνεχυράσαι",704723,106],["τὸ",709436,24],["ἐνέχυρον",704726,25]],"If thy neighbour owe thee a debt, any debt whatsoever, thou shalt not go into his house to take his pledge:"],["11",[["ἔξω",704983,28],["στήσῃ",706846,123],["καὶ",707031,7],["ὁ",709436,3],["ἄνθρωπος",701163,4],["οὗ",709781,48],["τὸ",709436,34],["δάνειόν",703278,15],["σού",711945,133],["ἐστιν",704093,91],["ἐν",704639,0],["αὐτῷ",702165,50],["ἐξοίσει",704356,127],["σοι",711925,159],["τὸ",709436,24],["ἐνέχυρον",704726,25],["ἔξω",704983,28]],"thou shalt stand without, and the man who is in thy debt shall bring the pledge out to thee."],["12",[["ἐὰν",703912,7],["δὲ",703303,11],["ὁ",709436,3],["ἄνθρωπος",701163,4],["πένηται",710256,428],["οὐ",709805,28],["κοιμηθήσῃ",707767,364],["ἐν",704639,0],["τῷ",709436,53],["ἐνεχύρῳ",704726,54],["αὐτοῦ",702165,102]],"And if the man be poor, thou shalt not sleep with his pledge."],["13",[["ἀποδόσει",701453,1],["ἀποδώσεις",701449,166],["τὸ",709436,24],["ἐνέχυρον",704726,25],["αὐτοῦ",702165,102],["περὶ",710285,0],["δυσμὰς",703865,17],["ἡλίου",705974,18],["καὶ",707031,7],["κοιμηθήσεται",707767,134],["ἐν",704639,0],["τῷ",709436,53],["ἱματίῳ",706742,54],["αὐτοῦ",702165,102],["καὶ",707031,7],["εὐλογήσει",705631,127],["σε",711598,163],["καὶ",707031,7],["ἔσται",704093,93],["σοι",711925,159],["ἐλεημοσύνη",704421,12],["ἐναντίον",704654,0],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133]],"Thou shalt surely restore his pledge at sunset, and he shall sleep in his garment, and he shall bless thee; and it shall be mercy to thee before the Lord thy God."],["14",[["οὐκ",709805,28],["ἀπαδικήσεις",701326,166],["μισθὸν",708939,6],["πένητος",710248,18],["καὶ",707031,7],["ἐνδεοῦς",704671,116],["ἐκ",704132,0],["τῶν",709436,80],["ἀδελφῶν",700249,81],["σου",711945,133],["ἢ",705924,7],["ἐκ",704132,0],["τῶν",709436,80],["προσηλύτων",710900,81],["τῶν",709436,80],["ἐν",704639,0],["ταῖς",709436,75],["πόλεσίν",710612,76],["σου",711945,133]],"Thou shalt not unjustly withhold the wages of the poor and needy of thy brethren, or of the strangers who are in thy cities."],["15",[["αὐθημερὸν",702130,28],["ἀποδώσεις",701449,166],["τὸν",709436,5],["μισθὸν",708939,6],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐπιδύσεται",705126,93],["ὁ",709436,3],["ἥλιος",705974,4],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["ὅτι",709803,7],["πένης",710248,4],["ἐστὶν",704093,91],["καὶ",707031,7],["ἐν",704639,0],["αὐτῷ",702165,50],["ἔχει",705785,91],["τὴν",709436,8],["ἐλπίδα",704530,9],["καὶ",707031,7],["οὐ",709805,28],["καταβοήσεται",707213,93],["κατὰ",707200,0],["σοῦ",711945,133],["πρὸς",710844,0],["κύριον",707996,6],["καὶ",707031,7],["ἔσται",704093,93],["ἐν",704639,0],["σοὶ",711925,159],["ἁμαρτία",700775,12]],"Thou shalt pay him his wages the same day, the sun shall not go down upon it, because he is poor and he trusts in it; and he shall cry against thee to the Lord, and it shall be sin in thee."],["16",[["οὐκ",709805,28],["ἀποθανοῦνται",701461,135],["πατέρες",710189,52],["ὑπὲρ",713111,0],["τέκνων",712761,44],["καὶ",707031,7],["υἱοὶ",713075,52],["οὐκ",709805,28],["ἀποθανοῦνται",701461,135],["ὑπὲρ",713111,0],["πατέρων",710189,81],["ἕκαστος",704133,14],["τῇ",709436,100],["ἑαυτοῦ",703917,102],["ἁμαρτίᾳ",700775,1],["ἀποθανεῖται",701461,93]],"The fathers shall not be put to death for the children, and the sons shall not be put to death for the fathers; every one shall be put to death for his own sin."],["17",[["οὐκ",709805,28],["ἐκκλινεῖς",704220,166],["κρίσιν",707908,9],["προσηλύτου",710900,18],["καὶ",707031,7],["ὀρφανοῦ",709779,116],["καὶ",707031,7],["χήρας",713848,17],["καὶ",707031,7],["οὐκ",709805,28],["ἐνεχυράσεις",704722,166],["ἱμάτιον",706742,25],["χήρας",713848,17]],"Thou shalt not wrest the judgment of the stranger and the fatherless, and widow; thou shalt not take the widow's garment for a pledge.",{"s":"d","q":0.62}],["18",[["καὶ",707031,7],["μνησθήσῃ",708923,364],["ὅτι",709803,7],["οἰκέτης",709496,4],["ἦσθα",704093,363],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτῳ",700401,1],["καὶ",707031,7],["ἐλυτρώσατό",708282,23],["σε",711598,163],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ἐκεῖθεν",704182,28],["διὰ",703417,0],["τοῦτο",709858,129],["ἐγώ",704018,164],["σοι",711925,159],["ἐντέλλομαι",704791,254],["ποιεῖν",710582,55],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129]],"And thou shalt remember that thou wast a bondman in the land of Egypt, and the Lord thy God redeemed thee from thence; therefore I charge thee to do this thing."],["19",[["ἐὰν",703912,7],["δὲ",703303,11],["ἀμήσῃς",700789,175],["ἀμητὸν",700819,6],["ἐν",704639,0],["τῷ",709436,113],["ἀγρῷ",700196,114],["σου",711945,133],["καὶ",707031,7],["ἐπιλάθῃ",705187,420],["δράγμα",703820,25],["ἐν",704639,0],["τῷ",709436,113],["ἀγρῷ",700196,114],["σου",711945,133],["οὐκ",709805,28],["ἐπαναστραφήσῃ",705020,364],["λαβεῖν",708076,106],["αὐτό",702165,129],["τῷ",709436,113],["πτωχῷ",711076,114],["καὶ",707031,7],["τῷ",709436,113],["προσηλύτῳ",710900,114],["καὶ",707031,7],["τῷ",709436,113],["ὀρφανῷ",709779,30],["καὶ",707031,7],["τῇ",709436,100],["χήρᾳ",713848,1],["ἔσται",704093,93],["ἵνα",706747,7],["εὐλογήσῃ",705631,172],["σε",711598,163],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ἐν",704639,0],["πᾶσι",710177,94],["τοῖς",709436,95],["ἔργοις",705396,96],["τῶν",709436,130],["χειρῶν",713787,65],["σου",711945,133]],"And when thou shalt have reaped corn in thy field, and shalt have forgotten a sheaf in thy field, thou shalt not return to take it; it shall be for the stranger, and the orphan, and the widow, that the Lord thy God may bless thee in all the works of thy hands."],["20",[["ἐὰν",703912,7],["δὲ",703303,11],["ἐλαιαλογήσῃς",704379,175],["οὐκ",709805,28],["ἐπαναστρέψεις",705020,166],["καλαμήσασθαι",707078,109],["τὰ",709436,41],["ὀπίσω",709697,0],["σου",711945,133],["τῷ",709436,113],["προσηλύτῳ",710900,114],["καὶ",707031,7],["τῷ",709436,113],["ὀρφανῷ",709779,30],["καὶ",707031,7],["τῇ",709436,100],["χήρᾳ",713848,1],["ἔσται",704093,93],["καὶ",707031,7],["μνησθήσῃ",708923,364],["ὅτι",709803,7],["οἰκέτης",709496,4],["ἦσθα",704093,363],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτῳ",700401,1],["διὰ",703417,0],["τοῦτο",709858,129],["ἐγώ",704018,164],["σοι",711925,159],["ἐντέλλομαι",704791,254],["ποιεῖν",710582,55],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129]],"And if thou shouldest gather thine olives, thou shalt not return to collect the remainder; it shall be for the stranger, and the fatherless, and the widow, and thou shalt remember that thou wast a bondman in the land of Egypt; therefore I command thee to do this thing."],["21",[["ἐὰν",703912,7],["δὲ",703303,11],["τρυγήσῃς",712996,175],["τὸν",709436,5],["ἀμπελῶνά",700872,6],["σου",711945,133],["οὐκ",709805,28],["ἐπανατρυγήσεις",705021,166],["αὐτὸν",702165,85],["τὰ",709436,41],["ὀπίσω",709697,0],["σου",711945,133],["τῷ",709436,113],["προσηλύτῳ",710900,114],["καὶ",707031,7],["τῷ",709436,113],["ὀρφανῷ",709779,30],["καὶ",707031,7],["τῇ",709436,100],["χήρᾳ",713848,1],["ἔσται",704093,93]],"And whensoever thou shalt gather the grapes of thy vineyard, thou shalt not glean what thou hast left; it shall be for the stranger, and the orphan, and the widow:"],["22",[["καὶ",707031,7],["μνησθήσῃ",708923,364],["ὅτι",709803,7],["οἰκέτης",709496,4],["ἦσθα",704093,363],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτῳ",700401,1],["διὰ",703417,0],["τοῦτο",709858,129],["ἐγώ",704018,164],["σοι",711925,159],["ἐντέλλομαι",704791,254],["ποιεῖν",710582,55],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129]],"and thou shalt remember that thou wast a bondman in the land of Egypt; therefore I command thee to do this thing."]]