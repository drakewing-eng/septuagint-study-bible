[["1",[["καὶ",707031,7],["νῦν",709384,28],["Ισραηλ",706839,153],["ἄκουε",700587,240],["τῶν",709436,43],["δικαιωμάτων",703697,44],["καὶ",707031,7],["τῶν",709436,43],["κριμάτων",707903,44],["ὅσα",709788,68],["ἐγὼ",704018,164],["διδάσκω",703649,157],["ὑμᾶς",713080,194],["σήμερον",711751,28],["ποιεῖν",710582,55],["ἵνα",706747,7],["ζῆτε",705851,355],["καὶ",707031,7],["πολυπλασιασθῆτε",710638,394],["καὶ",707031,7],["εἰσελθόντες",704114,196],["κληρονομήσητε",707724,125],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,80],["πατέρων",710189,81],["ὑμῶν",713091,145],["δίδωσιν",703654,91],["ὑμῖν",713084,90]],"And now, Israel, hear the ordinances and judgments, all that I teach you this day to do: that ye may live, and be multiplied, and that ye may go in and inherit the land, which the Lord God of your fathers gives you."],["2",[["οὐ",709805,28],["προσθήσετε",710965,337],["πρὸς",710844,0],["τὸ",709436,24],["ῥῆμα",711246,25],["ὃ",709781,33],["ἐγὼ",704018,164],["ἐντέλλομαι",704791,254],["ὑμῖν",713084,90],["καὶ",707031,7],["οὐκ",709805,28],["ἀφελεῖτε",702177,337],["ἀπ᾿",701425,0],["αὐτοῦ",702165,49],["φυλάσσεσθε",713619,73],["τὰς",709436,38],["ἐντολὰς",704802,39],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ὑμῶν",713091,145],["ὅσα",709788,68],["ἐγὼ",704018,164],["ἐντέλλομαι",704791,254],["ὑμῖν",713084,90],["σήμερον",711751,28]],"Ye shall not add to the word which I command you, and ye shall not take from it: keep the commandments of the Lord our God, all that I command you this day."],["3",[["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["ὑμῶν",713091,145],["ἑωράκασιν",709725,353],["πάντα",710177,68],["ὅσα",709788,68],["ἐποίησεν",710582,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["τῷ",709436,113],["Βεελφεγωρ",702627,184],["ὅτι",709803,7],["πᾶς",710177,14],["ἄνθρωπος",701163,4],["ὅστις",709793,425],["ἐπορεύθη",710667,37],["ὀπίσω",709697,0],["Βεελφεγωρ",702627,184],["ἐξέτριψεν",704345,2],["αὐτὸν",702165,85],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["ἐξ",704132,0],["ὑμῶν",713091,145]],"Your eyes have seen all that the Lord our God did in [the case of] Beel-phegor; for every man that went after Beel-phegor, the Lord your God has utterly destroyed him from among you."],["4",[["ὑμεῖς",713081,219],["δὲ",703303,11],["οἱ",709436,136],["προσκείμενοι",710916,348],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["ὑμῶν",713091,145],["ζῆτε",705851,355],["πάντες",710177,138],["ἐν",704639,0],["τῇ",709436,100],["σήμερον",711751,28]],"But ye that kept close to the Lord your God are all alive to-day."],["5",[["ἴδετε",709725,74],["δέδειχα",703314,89],["ὑμῖν",713084,90],["δικαιώματα",703697,42],["καὶ",707031,7],["κρίσεις",707908,191],["καθὰ",706979,28],["ἐνετείλατό",704791,23],["μοι",708974,159],["κύριος",707996,4],["ποιῆσαι",710582,106],["οὕτως",709859,28],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["εἰς",704105,0],["ἣν",709781,131],["ὑμεῖς",713081,219],["εἰσπορεύεσθε",704124,374],["ἐκεῖ",704181,28],["κληρονομεῖν",707724,55],["αὐτήν",702165,104]],"Behold, I have shewn you ordinances and judgments as the Lord commanded me, that ye should do so in the land into which ye go to inherit it."],["6",[["καὶ",707031,7],["φυλάξεσθε",713619,124],["καὶ",707031,7],["ποιήσετε",710582,337],["ὅτι",709803,7],["αὕτη",709858,107],["ἡ",709436,10],["σοφία",711981,12],["ὑμῶν",713091,145],["καὶ",707031,7],["ἡ",709436,10],["σύνεσις",712460,12],["ἐναντίον",704654,0],["πάντων",710177,83],["τῶν",709436,43],["ἐθνῶν",704068,44],["ὅσοι",709788,138],["ἐὰν",703912,7],["ἀκούσωσιν",700587,234],["πάντα",710177,68],["τὰ",709436,41],["δικαιώματα",703697,42],["ταῦτα",709858,71],["καὶ",707031,7],["ἐροῦσιν",705415,218],["ἰδοὺ",706497,88],["λαὸς",708094,4],["σοφὸς",711985,14],["καὶ",707031,7],["ἐπιστήμων",705268,26],["τὸ",709436,34],["ἔθνος",704068,15],["τὸ",709436,34],["μέγα",708653,26],["τοῦτο",709858,132]],"And ye shall keep and do them: for this is your wisdom and understanding before all nations, as many as shall hear all these ordinances; and they shall say, Behold, this great nation [is] a wise and understanding people."],["7",[["ὅτι",709803,7],["ποῖον",710599,26],["ἔθνος",704068,15],["μέγα",708653,26],["ᾧ",709781,209],["ἐστιν",704093,91],["αὐτῷ",702165,280],["θεὸς",706192,4],["ἐγγίζων",703939,72],["αὐτοῖς",702165,151],["ὡς",714148,7],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["ἐν",704639,0],["πᾶσιν",710177,230],["οἷς",709781,311],["ἐὰν",703912,7],["αὐτὸν",702165,85],["ἐπικαλεσώμεθα",705153,276]],"For what manner of nation [is so] great, which has God so near to them as the Lord our God [is] in all things in whatsoever we may call upon him?"],["8",[["καὶ",707031,7],["ποῖον",710599,26],["ἔθνος",704068,15],["μέγα",708653,26],["ᾧ",709781,209],["ἐστιν",704093,91],["αὐτῷ",702165,280],["δικαιώματα",703697,42],["καὶ",707031,7],["κρίματα",707903,42],["δίκαια",703694,68],["κατὰ",707200,0],["πάντα",710177,27],["τὸν",709436,5],["νόμον",709349,6],["τοῦτον",709858,85],["ὃν",709781,112],["ἐγὼ",704018,164],["δίδωμι",703654,157],["ἐνώπιον",704823,0],["ὑμῶν",713091,145],["σήμερον",711751,28]],"And what manner of nation [is so] great, which has righteous ordinances and judgments according to all this law, which I set before you this day?"],["9",[["πρόσεχε",710895,240],["σεαυτῷ",711599,50],["καὶ",707031,7],["φύλαξον",713619,176],["τὴν",709436,8],["ψυχήν",714070,9],["σου",711945,133],["σφόδρα",712586,28],["μὴ",708851,28],["ἐπιλάθῃ",705187,420],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["οὓς",709781,298],["ἑωράκασιν",709725,353],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["σου",711945,133],["καὶ",707031,7],["μὴ",708851,28],["ἀποστήτωσαν",702214,264],["ἀπὸ",701425,0],["τῆς",709436,16],["καρδίας",707141,17],["σου",711945,133],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["τῆς",709436,16],["ζωῆς",705910,17],["σου",711945,133],["καὶ",707031,7],["συμβιβάσεις",