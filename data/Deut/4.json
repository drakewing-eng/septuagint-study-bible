6192,4],["σου",711945,133],["οὗτος",709858,121],["θεός",706192,4],["ἐστιν",704093,91],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἔτι",705538,28],["πλὴν",710540,28],["αὐτοῦ",702165,102]],"So that thou shouldest know that the Lord thy God he is God, and there is none beside him."],["36",[["ἐκ",704132,0],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["ἀκουστὴ",700584,29],["ἐγένετο",703104,23],["ἡ",709436,10],["φωνὴ",713640,12],["αὐτοῦ",702165,102],["παιδεῦσαί",709926,106],["σε",711598,163],["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ἔδειξέν",703314,2],["σοι",711925,159],["τὸ",709436,24],["πῦρ",711088,25],["αὐτοῦ",702165,102],["τὸ",709436,24],["μέγα",708653,46],["καὶ",707031,7],["τὰ",709436,41],["ῥήματα",711246,42],["αὐτοῦ",702165,102],["ἤκουσας",700587,162],["ἐκ",704132,0],["μέσου",708768,116],["τοῦ",709436,20],["πυρός",711088,21]],"His voice was made audible from heaven to instruct thee, and he shewed thee upon the earth his great fire, and thou heardest his words out of the midst of the fire."],["37",[["διὰ",703417,0],["τὸ",709436,24],["ἀγαπῆσαι",700120,106],["αὐτὸν",702165,85],["τοὺς",709436,58],["πατέρας",710189,57],["σου",711945,133],["καὶ",707031,7],["ἐξελέξατο",704236,23],["τὸ",709436,24],["σπέρμα",712008,25],["αὐτῶν",702165,40],["μετ᾿",708780,0],["αὐτοὺς",702165,62],["ὑμᾶς",713080,194],["καὶ",707031,7],["ἐξήγαγέν",704834,2],["σε",711598,163],["αὐτὸς",702165,121],["ἐν",704639,0],["τῇ",709436,100],["ἰσχύι",706858,1],["αὐτοῦ",702165,102],["τῇ",709436,100],["μεγάλῃ",708653,101],["ἐξ",704132,0],["Αἰγύπτου",700401,18]],"Because he loved thy fathers, he also chose you their seed after them, and he brought thee himself with his great strength out of Egypt,"],["38",[["ἐξολεθρεῦσαι",704956,106],["ἔθνη",704068,42],["μεγάλα",708653,68],["καὶ",707031,7],["ἰσχυρότερά",706855,68],["σου",711945,133],["πρὸ",710747,0],["προσώπου",710986,21],["σου",711945,133],["εἰσαγαγεῖν",704107,106],["σε",711598,163],["δοῦναί",703654,106],["σοι",711925,159],