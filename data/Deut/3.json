[["1",[["καὶ",707031,7],["ἐπιστραφέντες",705278,247],["ἀνέβημεν",700905,289],["ὁδὸν",709458,9],["τὴν",709436,8],["εἰς",704105,0],["Βασαν",702564,227],["καὶ",707031,7],["ἐξῆλθεν",704909,2],["Ωγ",714088,4],["βασιλεὺς",702580,4],["τῆς",709436,16],["Βασαν",702564,17],["εἰς",704105,0],["συνάντησιν",712397,9],["ἡμῖν",705994,90],["αὐτὸς",702165,121],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["αὐτοῦ",702165,102],["εἰς",704105,0],["πόλεμον",710605,6],["εἰς",704105,0],["Εδραϊν",704039,227]],"And we turned and went by the way leading to Basan; and Og the king of Basan came out to meet us, he and all his people, to battle at Edraim."],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["μὴ",708851,28],["φοβηθῇς",713532,279],["αὐτόν",702165,85],["ὅτι",709803,7],["εἰς",704105,0],["τὰς",709436,38],["χεῖράς",713787,39],["σου",711945,133],["παραδέδωκα",710014,89],["αὐτὸν",702165,85],["καὶ",707031,7],["πάντα",710177,27],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ποιήσεις",710582,166],["αὐτῷ",702165,50],["ὥσπερ",714163,28],["ἐποίησας",710582,162],["Σηων",711759,114],["βασιλεῖ",702580,114],["τῶν",709436,80],["Αμορραίων",700865,81],["ὃς",709781,213],["κατῴκει",707534,13],["ἐν",704639,0],["Εσεβων",705473,111]],"And the Lord said to me, Fear him not, for I have delivered him, and all his people, and all his land, into thy hands; and thou shalt do to him as thou didst to Seon king of the Amorites who dwelt in Esebon."],["3",[["καὶ",707031,7],["παρέδωκεν",710014,2],["αὐτὸν",702165,85],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["εἰς",704105,0],["τὰς",709436,38],["χεῖρας",713787,39],["ἡμῶν",705999,145],["καὶ",707031,7],["τὸν",709436,5],["Ωγ",714088,6],["βασιλέα",702580,6],["τῆς",709436,16],["Βασαν",702564,17],["καὶ",707031,7],["πάντα",710177,27],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπατάξαμεν",710185,289],["αὐτὸν",702165,85],["ἕως",705792,0],["τοῦ",709436,20],["μὴ",708851,28],["καταλιπεῖν",707305,106],["αὐτοῦ",702165,102],["σπέρμα",712008,25]],"And the Lord our God delivered him into our hands, even Og the king of Basan, and all his people; and we smote him until we left none of his seed."],["4",[["καὶ",707031,7],["ἐκρατήσαμεν",707879,289],["πασῶν",710177,198],["τῶν",709436,130],["πόλεων",710612,65],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["οὐκ",709805,28],["ἦν",704093,13],["πόλις",710612,12],["ἣν",709781,131],["οὐκ",709805,28],["ἐλάβομεν",708076,289],["παρ᾿",709995,0],["αὐτῶν",702165,40],["ἑξήκοντα",704922,59],["πόλεις",710612,39],["πάντα",710177,68],["τὰ",709436,41],["περίχωρα",710423,68],["Αργοβ",701703,118],["βασιλείας",702577,17],["Ωγ",714088,118],["ἐν",704639,0],["Βασαν",702564,111]],"And we mastered all his cities at that time; there was not a city which we took not from them; sixty cities, all the country round about Argob, belonging to king Og in Basan:"],["5",[["πᾶσαι",710177,192],["πόλεις",710612,191],["ὀχυραί",709889,192],["τείχη",712759,64],["ὑψηλά",713285,195],["πύλαι",711082,191],["καὶ",707031,7],["μοχλοί",709040,52],["πλὴν",710540,28],["τῶν",709436,130],["πόλεων",710612,65],["τῶν",709436,80],["Φερεζαίων",713422,81],["τῶν",709436,130],["πολλῶν",710646,198],["σφόδρα",712586,28]],"all strong cities, lofty walls, gates and bars; besides the very many cities of the Pherezites."],["6",[["ἐξωλεθρεύσαμεν",704956,289],["αὐτούς",702165,62],["ὥσπερ",714163,28],["ἐποιήσαμεν",710582,289],["τὸν",709436,5],["Σηων",711759,6],["βασιλέα",702580,6],["Εσεβων",705473,118],["καὶ",707031,7],["ἐξωλεθρεύσαμεν",704956,289],["πᾶσαν",710177,36],["πόλιν",710612,9],["ἑξῆς",704927,28],["καὶ",707031,7],["τὰς",709436,38],["γυναῖκας",703209,39],["καὶ",707031,7],["τὰ",709436,41],["παιδία",709927,42]],"We utterly destroyed [them] as we dealt with Seon the king of Esebon, so we utterly destroyed every city in order, and the women and the children,"],["7",[["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["κτήνη",707934,42],["καὶ",707031,7],["τὰ",709436,41],["σκῦλα",711902,42],["τῶν",709436,130],["πόλεων",710612,65],["ἐπρονομεύσαμεν",710826,289],["ἑαυτοῖς",703917,151]],"and all the cattle; and we took for a prey to ourselves the spoil of the cities."],["8",[["καὶ",707031,7],["ἐλάβομεν",708076,289],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["τὴν",709436,8],["γῆν",703083,9],["ἐκ",704132,0],["χειρῶν",713787,65],["δύο",703849,59],["βασιλέων",702580,81],["τῶν",709436,80],["Αμορραίων",700865,81],["οἳ",709781,250],["ἦσαν",704093,137],["πέραν",710280,28],["τοῦ",709436,35],["Ιορδάνου",706763,18],["ἀπὸ",701425,0],["τοῦ",709436,35],["χειμάρρου",713783,18],["Αρνων",701783,118],["καὶ",707031,7],["ἕως",705792,0],["Αερμων",700317,118]],"And we took at that time the land out of the hands of the two kings of the Amorites, who were beyond Jordan, [extending] from the brook of Arnon even unto Aermon."],["9",[["οἱ",709436,136],["Φοίνικες",713537,52],["ἐπονομάζουσιν",705348,197],["τὸ",709436,24],["Αερμων",700317,25],["Σανιωρ",711495,227],["καὶ",707031,7],["ὁ",709436,3],["Αμορραῖος",700865,4],["ἐπωνόμασεν",705348,2],["αὐτὸ",702165,129],["Σανιρ",711494,227]],"The Phœnicians call Aermon Sanior, but the Amorite has called it Sanir."],["10",[["πᾶσαι",710177,192],["πόλεις",710612,191],["Μισωρ",708949,118],["καὶ",707031,7],["πᾶσα",710177,29],["Γαλααδ",702920,120],["καὶ",707031,7],["πᾶσα",710177,29],["Βασαν",702564,120],["ἕως",705792,0],["Σελχα",711662,118],["καὶ",707031,7],["Εδραϊν",704039,118],["πόλεις",710612,191],["βασιλείας",702577,17],["τοῦ",709436,35],["Ωγ",714088,18],["ἐν",704639,0],["τῇ",709436,100],["Βασαν",702564,1]],"All the cities of Misor, and all Galaad, and all Basan as far as Elcha and Edraim, cities of the kingdom of Og in Basan."],["11",[["ὅτι",709803,7],["πλὴν",710540,28],["Ωγ",714088,4],["βασιλεὺς",702580,4],["Βασαν",702564,17],["κατελείφθη",707305,37],["ἀπὸ",701425,0],["τῶν",709436,80],["Ραφαϊν",711197,81],["ἰδοὺ",706497,88],["ἡ",709436,10],["κλίνη",707737,12],["αὐτοῦ",702165,102],["κλίνη",707737,12],["σιδηρᾶ",711771,29],["ἰδοὺ",706497,88],["αὕτη",709858,107],["ἐν",704639,0],["τῇ",709436,100],["ἄκρᾳ",700610,101],["τῶν",709436,80],["υἱῶν",713075,81],["Αμμων",700847,81],["ἐννέα",704754,59],["πηχῶν",710462,81],["τὸ",709436,34],["μῆκος",708868,15],["αὐτῆς",702165,86],["καὶ",707031,7],["τεσσάρων",712808,169],["πηχῶν",710462,81],["τὸ",709436,34],["εὖρος",705677,15],["αὐτῆς",702165,86],["ἐν",704639,0],["πήχει",710462,114],["ἀνδρός",701150,18]],"For only Og the king of Basan was left of the Raphain: behold, his bed [was] a bed of iron; behold, [it is] in the chief city of the children of Ammon; the length of it [is] nine cubits, and the breadth of it four cubits, according to the cubit of a man."],["12",[["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9],["ἐκείνην",704183,104],["ἐκληρονομήσαμεν",707724,289],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["ἀπὸ",701425,0],["Αροηρ",701787,118],["ἥ",709781,177],["ἐστιν",704093,91],["ἐπὶ",705080,0],["τοῦ",709436,20],["χείλους",713781,21],["χειμάρρου",713783,18],["Αρνων",701783,118],["καὶ",707031,7],["τὸ",709436,24],["ἥμισυ",705998,46],["ὄρους",709768,21],["Γαλααδ",702920,118],["καὶ",707031,7],["τὰς",709436,38],["πόλεις",710612,39],["αὐτοῦ",702165,49],["ἔδωκα",703654,155],["τῷ",709436,113],["Ρουβην",711295,114],["καὶ",707031,7],["τῷ",709436,113],["Γαδ",702872,114]],"And we inherited that land at that time from Aroer, which is by the border of the torrent Arnon, and half the mount of Galaad; and I gave his cities to Ruben and to Gad."],["13",[["καὶ",707031,7],["τὸ",709436,24],["κατάλοιπον",707317,46],["τοῦ",709436,35],["Γαλααδ",702920,118],["καὶ",707031,7],["πᾶσαν",710177,36],["τὴν",709436,8],["Βασαν",702564,9],["βασιλείαν",702577,9],["Ωγ",714088,18],["ἔδωκα",703654,155],["τῷ",709436,53],["ἡμίσει",705998,97],["φυλῆς",713620,17],["Μανασση",708470,18],["καὶ",707031,7],["πᾶσαν",710177,36],["περίχωρον",710423,36],["Αργοβ",701703,118],["πᾶσαν",710177,36],["τὴν",709436,8],["Βασαν",702564,9],["ἐκείνην",704183,104],["γῆ",703083,12],["Ραφαϊν",711197,81],["λογισθήσεται",708232,134]],"And the rest of Galaad, and all Basan the kingdom of Og I gave to the half-tribe of Manasse, and all the country round about Argob, all that Basan; it shall be accounted the land of Raphain."],["14",[["καὶ",707031,7],["Ιαϊρ",706390,4],["υἱὸς",713075,4],["Μανασση",708470,18],["ἔλαβεν",708076,2],["πᾶσαν",710177,36],["τὴν",709436,8],["περίχωρον",710423,36],["Αργοβ",701703,118],["ἕως",705792,0],["τῶν",709436,43],["ὁρίων",709749,44],["Γαργασι",702966,118],["καὶ",707031,7],["Ομαχαθι",709609,118],["ἐπωνόμασεν",705348,2],["αὐτὰς",702165,231],["ἐπὶ",705080,0],["τῷ",709436,53],["ὀνόματι",709666,54],["αὐτοῦ",702165,49],["τὴν",709436,8],["Βασαν",702564,9],["Αυωθ",702172,227],["Ιαϊρ",706390,6],["ἕως",705792,0],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86]],"And Jair the son of Manasse took all the country round about Argob as far as the borders of Gargasi and Machathi: he called them by his name Basan Thavoth Jair until this day."],["15",[["καὶ",707031,7],["τῷ",709436,113],["Μαχιρ",708604,114],["ἔδωκα",703654,155],["τὴν",709436,8],["Γαλααδ",702920,9]],"And to Machir I gave Galaad."],["16",[["καὶ",707031,7],["τῷ",709436,113],["Ρουβην",711295,114],["καὶ",707031,7],["τῷ",709436,113],["Γαδ",702872,114],["δέδωκα",703654,89],["ἀπὸ",701425,0],["τῆς",709436,16],["Γαλααδ",702920,17],["ἕως",705792,0],["χειμάρρου",713783,18],["Αρνων",701783,118],["μέσον",708768,27],["τοῦ",709436,35],["χειμάρρου",713783,18],["ὅριον",709749,25],["καὶ",707031,7],["ἕως",705792,0],["τοῦ",709436,35],["Ιαβοκ",706369,18],["ὁ",709436,3],["χειμάρρους",713783,4],["ὅριον",709749,15],["τοῖς",709436,147],["υἱοῖς",713075,148],["Αμμαν",700833,18]],"And to Ruben and to Gad I gave [the land] under Galaad as far as the brook of Arnon, the border between the brook and as far as Jaboc; the brook [is] the border to the children of Amman."],["17",[["καὶ",707031,7],["ἡ",709436,10],["Αραβα",701671,12],["καὶ",707031,7],["ὁ",709436,3],["Ιορδάνης",706763,4],["ὅριον",709749,15],["Μαχαναρεθ",708595,246],["καὶ",707031,7],["ἕως",705792,0],["θαλάσσης",706069,17],["Αραβα",701671,17],["θαλάσσης",706069,17],["ἁλυκῆς",700732,82],["ὑπὸ",713184,0],["Ασηδωθ",701930,9],["τὴν",709436,8],["Φασγα",713377,9],["ἀνατολῶν",701071,65]],"And Araba and Jordan [are] the boundary of Machanareth, even to the sea of Araba, the salt sea under Asedoth Phasga eastward."],["18",[["καὶ",707031,7],["ἐνετειλάμην",704791,161],["ὑμῖν",713084,90],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["λέγων",708124,72],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["ἔδωκεν",703654,2],["ὑμῖν",713084,90],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104],["ἐν",704639,0],["κλήρῳ",707727,114],["ἐνοπλισάμενοι",704775,317],["προπορεύεσθε",710839,73],["πρὸ",710747,0],["προσώπου",710986,21],["τῶν",709436,80],["ἀδελφῶν",700249,81],["ὑμῶν",713091,145],["υἱῶν",713075,81],["Ισραηλ",706839,18],["πᾶς",710177,14],["δυνατός",703845,14]],"And I charged you at that time, saying, The Lord your God has given you this land by lot; arm yourselves, every one [that is] powerful, and go before your brethren the children of Israel."],["19",[["πλὴν",710540,28],["αἱ",709436,190],["γυναῖκες",703209,191],["ὑμῶν",713091,145],["καὶ",707031,7],["τὰ",709436,63],["τέκνα",712761,64],["ὑμῶν",713091,145],["καὶ",707031,7],["τὰ",709436,63],["κτήνη",707934,64],["ὑμῶν",713091,145],["οἶδα",709492,89],["ὅτι",709803,7],["πολλὰ",710646,68],["κτήνη",707934,42],["ὑμῖν",713084,90],["κατοικείτωσαν",707534,56],["ἐν",704639,0],["ταῖς",709436,75],["πόλεσιν",710612,76],["ὑμῶν",713091,145],["αἷς",709781,281],["ἔδωκα",703654,155],["ὑμῖν",713084,90]],"Only your wives and your children and your cattle (I know that ye have much cattle), let them dwell in your cities which I have given you;"],["20",[["ἕως",705792,7],["ἂν",700900,11],["καταπαύσῃ",707365,172],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["τοὺς",709436,58],["ἀδελφοὺς",700249,57],["ὑμῶν",713091,145],["ὥσπερ",714163,28],["καὶ",707031,28],["ὑμᾶς",713080,194],["καὶ",707031,7],["κατακληρονομήσουσιν",707274,218],["καὶ",707031,28],["οὗτοι",709858,201],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["δίδωσιν",703654,91],["αὐτοῖς",702165,151],["ἐν",704639,0],["τῷ",709436,113],["πέραν",710280,28],["τοῦ",709436,35],["Ιορδάνου",706763,4],["καὶ",707031,7],["ἐπαναστραφήσεσθε",705020,261],["ἕκαστος",704133,14],["εἰς",704105,0],["τὴν",709436,8],["κληρονομίαν",707725,9],["αὐτοῦ",702165,102],["ἣν",709781,131],["ἔδωκα",703654,155],["ὑμῖν",713084,90]],"until the Lord your God give your brethren rest, as also he has given to you, and they also shall inherit the land, which the Lord our God gives them on the other side of Jordan; then ye shall return, each one to his inheritance which I have given you."],["21",[["καὶ",707031,7],["τῷ",709436,113],["Ἰησοῖ",706701,114],["ἐνετειλάμην",704791,161],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["λέγων",708124,72],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["ὑμῶν",713091,145],["ἑωράκασιν",709725,353],["πάντα",710177,68],["ὅσα",709788,68],["ἐποίησεν",710582,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["τοῖς",709436,147],["δυσὶ",703849,223],["βασιλεῦσι",702580,148],["τούτοις",709858,151],["οὕτως",709859,28],["ποιήσει",710582,127],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["πάσας",710177,119],["τὰς",709436,38],["βασιλείας",702577,39],["ἐφ᾿",705080,0],["ἃς",709781,193],["σὺ",712181,164],["διαβαίνεις",703419,154],["ἐκεῖ",704181,28]],"And I commanded Joshua at that time, saying, Your eyes have seen all things, which the 