[["1",[["υἱοί",713075,52],["ἐστε",704093,87],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ὑμῶν",713091,145],["οὐ",709805,28],["φοιβήσετε",713536,337],["οὐκ",709805,28],["ἐπιθήσετε",705304,337],["φαλάκρωμα",713324,25],["ἀνὰ",700902,0],["μέσον",708768,46],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["ὑμῶν",713091,145],["ἐπὶ",705080,0],["νεκρῷ",709247,114]],"Ye are the children of the Lord your God: ye shall not make any baldness between your eyes for the dead."],["2",[["ὅτι",709803,7],["λαὸς",708094,4],["ἅγιος",700159,14],["εἶ",704093,154],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["σου",711945,133],["καὶ",707031,7],["σὲ",711598,163],["ἐξελέξατο",704236,23],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["γενέσθαι",703104,109],["σε",711598,163],["αὐτῷ",702165,50],["λαὸν",708094,6],["περιούσιον",710358,27],["ἀπὸ",701425,0],["πάντων",710177,83],["τῶν",709436,43],["ἐθνῶν",704068,44],["τῶν",709436,43],["ἐπὶ",705080,0],["προσώπου",710986,21],["τῆς",709436,16],["γῆς",703083,17]],"For thou art a holy people to the Lord thy God, and the Lord thy God has chosen thee to be a peculiar people to himself of all the nations on the face of the earth."],["3",[["οὐ",709805,28],["φάγεσθε",705495,124],["πᾶν",710177,46],["βδέλυγμα",702604,25]],"Ye shall not eat any abominable thing."],["4",[["ταῦτα",709858,290],["τὰ",709436,63],["κτήνη",707934,64],["ἃ",709781,69],["φάγεσθε",705495,124],["μόσχον",709029,6],["ἐκ",704132,0],["βοῶν",702798,81],["καὶ",707031,7],["ἀμνὸν",700855,6],["ἐκ",704132,0],["προβάτων",710768,44],["καὶ",707031,7],["χίμαρον",713864,6],["ἐξ",704132,0],["αἰγῶν",700464,81]],"These [are] the beasts which ye shall eat; the calf of the herd, and lamb of the sheep, and kid of the goats;"],["5",[["ἔλαφον",704398,6],["καὶ",707031,7],["δορκάδα",703801,9],["καὶ",707031,7],["βούβαλον",702777,6],["καὶ",707031,7],["τραγέλαφον",712916,6],["καὶ",707031,7],["πύγαργον",711077,6],["ὄρυγα",709774,6],["καὶ",707031,7],["καμηλοπάρδαλιν",707109,9]],"the stag, and doe, and pygarg, and wild goat, and camelopard."],["6",[["πᾶν",710177,46],["κτῆνος",707934,25],["διχηλοῦν",703757,47],["ὁπλὴν",709698,9],["καὶ",707031,7],["ὀνυχιστῆρας",709676,57],["ὀνυχίζον",709674,47],["δύο",703849,59],["χηλῶν",713847,65],["καὶ",707031,7],["ἀνάγον",700933,47],["μηρυκισμὸν",708887,6],["ἐν",704639,0],["τοῖς",709436,95],["κτήνεσιν",707934,96],["ταῦτα",709858,71],["φάγεσθε",705495,124]],"Every beast that divides the hoofs, and makes claws of two divisions, and that chews the cud among beasts, these ye shall eat."],["7",[["καὶ",707031,7],["ταῦτα",709858,71],["οὐ",709805,28],["φάγεσθε",705495,124],["ἀπὸ",701425,0],["τῶν",709436,43],["ἀναγόντων",700933,84],["μηρυκισμὸν",708887,6],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,43],["διχηλούντων",703757,84],["τὰς",709436,38],["ὁπλὰς",709698,39],["καὶ",707031,7],["ὀνυχιζόντων",709674,84],["ὀνυχιστῆρας",709676,57],["τὸν",709436,5],["κάμηλον",707110,6],["καὶ",707031,7],["δασύποδα",703298,6],["καὶ",707031,7],["χοιρογρύλλιον",713895,6],["ὅτι",709803,7],["ἀνάγουσιν",700933,197],["μηρυκισμὸν",708887,6],["καὶ",707031,7],["ὁπλὴν",709698,9],["οὐ",709805,28],["διχηλοῦσιν",703757,197],["ἀκάθαρτα",700508,195],["ταῦτα",709858,290],["ὑμῖν",713084,90],["ἐστιν",704093,91]],"And these ye shall not eat of them that chew the cud, and of those that divide the hoofs, and make distinct claws; the camel, and the hare, and the rabbit; because they chew the cud, and do not divide the hoof, these are unclean to you."],["8",[["καὶ",707031,7],["τὸν",709436,5],["ὗν",713268,6],["ὅτι",709803,7],["διχηλεῖ",703757,91],["ὁπλὴν",709698,9],["τοῦτο",709858,132],["καὶ",707031,7],["ὀνυχίζει",709674,91],["ὄνυχας",709673,57],["ὁπλῆς",709698,17],["καὶ",707031,7],["τοῦτο",709858,132],["μηρυκισμὸν",708887,6],["οὐ",709805,28],["μαρυκᾶται",708528,117],["ἀκάθαρτον",700508,26],["τοῦτο",709858,132],["ὑμῖν",713084,90],["ἀπὸ",701425,0],["τῶν",709436,43],["κρεῶν",707889,44],["αὐτῶν",702165,70],["οὐ",709805,28],["φάγεσθε",705495,124],["καὶ",707031,7],["τῶν",709436,80],["θνησιμαίων",706277,169],["αὐτῶν",702165,70],["οὐχ",709805,28],["ἅψεσθε",701654,124]],"And as for the swine, because he divides the hoof, and makes claws of the hoof, yet he chews not the cud, he is unclean to you; ye shall not eat of their flesh, ye shall not touch their dead bodies."],["9",[["καὶ",707031,7],["ταῦτα",709858,71],["φάγεσθε",705495,124],["ἀπὸ",701425,0],["πάντων",710177,83],["τῶν",709436,43],["ἐν",704639,0],["τοῖς",709436,95],["ὕδασιν",713071,96],["πάντα",710177,195],["ὅσα",709788,195],["ἐστὶν",704093,91],["ἐν",704639,0],["αὐτοῖς",702165,206],["πτερύγια",711056,64],["καὶ",707031,7],["λεπίδες",708147,191],["φάγεσθε",705495,124]],"And these ye shall eat of all that are in the water, ye shall eat all that have fins and scales."],["10",[["καὶ",707031,7],["πάντα",710177,195],["ὅσα",709788,195],["οὐκ",709805,28],["ἔστιν",704093,91],["αὐτοῖς",702165,206],["πτερύγια",711056,64],["καὶ",707031,7],["λεπίδες",708147,191],["οὐ",709805,28],["φάγεσθε",705495,124],["ἀκάθαρτα",700508,195],["ὑμῖν",713084,90],["ἐστιν",704093,91]],"And all that have not fins and scales ye shall not eat; they are unclean to you."],["11",[["πᾶν",710177,46],["ὄρνεον",709762,25],["καθαρὸν",706988,46],["φάγεσθε",705495,124]],"Ye shall eat every clean bird."],["12",[["καὶ",707031,7],["ταῦτα",709858,71],["οὐ",709805,28],["φάγεσθε",705495,124],["ἀπ᾿",701425,0],["αὐτῶν",702165,70],["τὸν",709436,5],["ἀετὸν",700318,6],["καὶ",707031,7],["τὸν",709436,5],["γρύπα",703198,6],["καὶ",707031,7],["τὸν",709436,5],["ἁλιαίετον",700664,6]],"And these of them ye shall not eat; the eagle, and the ossifrage, and the sea-eagle,"],["13",[["καὶ",707031,7],["τὸν",709436,5],["γύπα",703212,6],["καὶ",707031,7],["τὸν",709436,5],["ἰκτῖνα",706721,6],["καὶ",707031,7],["τὰ",709436,41],["ὅμοια",709626,68],["αὐτῷ",702165,50]],"and the vulture, and the kite and the like to it,"],["14",[["καὶ",707031,7],["πάντα",710177,27],["κόρακα",707831,6],["καὶ",707031,7],["τὰ",709436,41],["ὅμοια",709626,68],["αὐτῷ",702165,50]],null],["15",[["καὶ",707031,7],["στρουθὸν",712167,6],["καὶ",707031,7],["γλαῦκα",703107,9],["καὶ",707031,7],["λάρον",708097,6]],"and the sparrow, and the owl, and the sea-mew,"],["16",[["καὶ",707031,7],["ἐρωδιὸν",705455,6],["καὶ",707031,7],["κύκνον",707963,6],["καὶ",707031,7],["ἶβιν",706473,9]],"and the heron, and the swan, and the stork,"],["17",[["καὶ",707031,7],["καταράκτην",707404,6],["καὶ",707031,7],["ἱέρακα",706603,6],["καὶ",707031,7],["τὰ",709436,41],["ὅμοια",709626,68],["αὐτῷ",702165,50],["καὶ",707031,7],["ἔποπα",705440,6],["καὶ",707031,7],["νυκτικόρακα",709377,6]],"and the cormorant, and the hawk, and its like, and the hoopoe, and the raven,"],["18",[["καὶ",707031,7],["πελεκᾶνα",710234,6],["καὶ",707031,7],["χαραδριὸν",713722,6],["καὶ",707031,7],["τὰ",709436,41],["ὅμοια",709626,68],["αὐτῷ",702165,50],["καὶ",707031,7],["πορφυρίωνα",710685,6],["καὶ",707031,7],["νυκτερίδα",709376,9]],"and the pelican, and the diver and the like to it, and the red-bill and the bat."],["19",[["πάντα",710177,195],["τὰ",709436,63],["ἑρπετὰ",705441,64],["τῶν",709436,43],["πετεινῶν",710438,44],["ἀκάθαρτα",700508,195],["ταῦτά",709858,290],["ἐστιν",704093,91],["ὑμῖν",713084,90],["οὐ",709805,28],["φάγεσθε",705495,124],["ἀπ᾿",701425,0],["αὐτῶν",702165,70]],"All winged animals that creep are unclean to you; ye shall not eat of them."],["20",[["πᾶν",710177,46],["πετεινὸν",710438,25],["καθαρὸν",706988,46],["φάγεσθε",705495,124]],"Ye shall eat every clean bird."],["21",[["πᾶν",710177,46],["θνησιμαῖον",706277,46],["οὐ",709805,28],["φάγεσθε",705495,124],["τῷ",709436,113],["παροίκῳ",710159,30],["τῷ",709436,113],["ἐν",704639,0],["ταῖς",709436,75],["πόλεσίν",710612,76],["σου",711945,133],["δοθήσεται",703654,134],["καὶ",707031,7],["φάγεται",713296,93],["ἢ",705924,7],["ἀποδώσῃ",701449,123],["τῷ",709436,113],["ἀλλοτρίῳ",700699,30],["ὅτι",709803,7],["λαὸς",708094,4],["ἅγιος",700159,14],["εἶ",704093,154],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["σου",711945,133],["οὐχ",709805,28],["ἑψήσεις",705788,166],["ἄρνα",701731,6],["ἐν",704639,0],["γάλακτι",702919,54],["μητρὸς",708892,17],["αὐτοῦ",702165,102]],"Ye shall eat nothing that dies of itself; it shall be given to the sojourner in thy cities and he shall eat it, or thou shalt sell it to a stranger, because thou art a holy people to the Lord thy God. Thou shalt not boil a lamb in his mother's milk."],["22",[["δεκάτην",703342,36],["ἀποδεκατώσεις",701442,166],["παντὸς",710177,92],["γενήματος",703052,21],["τοῦ",709436,20],["σπέρματός",712008,21],["σου",711945,133],["τὸ",709436,24],["γένημα",703052,25],["τοῦ",709436,35],["ἀγροῦ",700196,18],["σου",711945,133],["ἐνιαυτὸν",704745,6],["κατ᾿",707200,0],["ἐνιαυτόν",704745,6]],"Thou shalt tithe a tenth of all the produce of thy seed, the fruit of thy field year by year."],["23",[["καὶ",707031,7],["φάγῃ",713296,123],["αὐτὸ",702165,129],["ἔναντι",704653,0],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133],["ἐν",704639,0],["τῷ",709436,113],["τόπῳ",712903,114],["ᾧ",709781,309],["ἂν",700900,11],["ἐκλέξηται",704236,239],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ἐπικληθῆναι",705153,179],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["ἐκεῖ",704181,28],["οἴσετε",713428,337],["τὰ",709436,41],["ἐπιδέκατα",705114,68],["τοῦ",709436,35],["σίτου",711814,18],["σου",711945,133],["καὶ",707031,7],["τοῦ",709436,35],["οἴνου",709530,18],["σου",711945,133],["καὶ",707031,7],["τοῦ",709436,20],["ἐλαίου",704380,21],["σου",711945,133],["τὰ",709436,41],["πρωτότοκα",711046,68],["τῶν",709436,80],["βοῶν",702798,81],["σου",711945,133],["καὶ",707031,7],["τῶν",709436,43],["προβάτων",710768,44],["σου",711945,133],["ἵνα",706747,7],["μάθῃς",708480,175],["φοβεῖσθαι",713532,110],["κύριον",707996,6],["τὸν",709436,5],["θεόν",706192,6],["σου",711945,133],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39]],"And thou shalt eat it in the place which the Lord thy God shall choose to have his name called there; ye shall bring the tithe of thy corn and of thy wine, and of thine oil, the first-born of thy herd and of thy flock, that thou mayest learn to fear the Lord thy God always."],["24",[["ἐὰν",703912,7],["δὲ",703303,11],["μακρὰν",708411,28],["γένηται",703104,239],["ἀπὸ",701425,0],["σοῦ",711945,133],["ἡ",709436,10],["ὁδὸς",709458,12],["καὶ",707031,7],["μὴ",708851,28],["δύνῃ",703838,259],["ἀναφέρειν",701083,55],["αὐτά",702165,71],["ὅτι",709803,7],["μακρὰν",708411,28],["ἀπὸ",701425,0],["σοῦ",711945,133],["ὁ",709436,3],["τόπος",712903,4],["ὃν",709781,112],["ἂν",700900,11],["ἐκλέξηται",704236,239],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ἐπικληθῆναι",705153,179],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["ἐκεῖ",704181,28],["ὅτι",709803,7],["εὐλογήσει",705631,127],["σε",711598,163],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133]],"And if the journey be too far for thee, and thou art not able to bring them, because the place [is] far from thee which the Lord thy God shall choose to have his name called there, because the Lord thy God will bless thee;"],["25",[["καὶ",707031,7],["ἀποδώσῃ",701449,123],["αὐτὰ",702165,71],["ἀργυρίου",701707,21],["καὶ",707031,7],["λήμψῃ",708076,123],["τὸ",709436,24],["ἀργύριον",701707,25],["ἐν",704639,0],["ταῖς",709436,75],["χερσίν",713787,76],["σου",711945,133],["καὶ",707031,7],["πορεύσῃ",710667,123],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["ὃν",709781,112],["ἂν",700900,11],["ἐκλέξηται",704236,239],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["αὐτόν",702165,85]],"then thou shalt sell them for money, and thou shalt take the money in thy hands, and thou shalt go to the place which the Lord thy God shall choose."],["26",[["καὶ",707031,7],["δώσεις",703654,166],["τὸ",709436,24],["ἀργύριον",701707,25],["ἐπὶ",705080,0],["παντός",710177,92],["οὗ",709781,160],["ἐὰν",703912,7],["ἐπιθυμῇ",705141,204],["ἡ",709436,10],["ψυχή",714070,12],["σου",711945,133],["ἐπὶ",705080,0],["βουσὶ",702798,148],["ἢ",705924,7],["ἐπὶ",705080,0],["προβάτοις",710768,96],["ἐπὶ",705080,0],["οἴνῳ",709530,114],["ἢ",705924,7],["ἐπὶ",705080,0],["σικερα",711781,54],["ἢ",705924,7],["ἐπὶ",705080,0],["παντός",710177,92],["οὗ",709781,160],["ἐὰν",703912,7],["ἐπιθυμῇ",705141,204],["ἡ",709436,10],["ψυχή",714070,12],["σου",711945,133],["καὶ",707031,7],["φάγῃ",713296,123],["ἐκεῖ",704181,28],["ἐναντίον",704654,0],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133],["καὶ",707031,7],["εὐφρανθήσῃ",705715,364],["σὺ",712181,164],["καὶ",707031,7],["ὁ",709436,3],["οἶκός",709516,4],["σου",711945,133]],"And thou shalt give the money for whatsoever thy soul shall desire, for oxen or for sheep, or for wine, or [thou shalt lay it out] on strong drink, or on whatsoever thy soul may desire, and thou shalt eat there before the Lord thy God, and thou shalt rejoice and thy house,"],["27",[["καὶ",707031,7],["ὁ",709436,3],["Λευίτης",708160,4],["ὁ",709436,3],["ἐν",704639,0],["ταῖς",709436,75],["πόλεσίν",710612,76],["σου",711945,133],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["αὐτῷ",702165,50],["μερὶς",708748,12],["οὐδὲ",709816,7],["κλῆρος",707727,4],["μετὰ",708780,0],["σοῦ",711945,133]],"and the Levite that is in thy cities, because he has not a portion or inheritance with thee."],["28",[["μετὰ",708780,0],["τρία",712927,68],["ἔτη",705543,42],["ἐξοίσεις",704356,166],["πᾶν",710177,46],["τὸ",709436,24],["ἐπιδέκατον",705114,46],["τῶν",709436,43],["γενημάτων",703052,44],["σου",711945,133],["ἐν",704639,0],["τῷ",709436,113],["ἐνιαυτῷ",704745,114],["ἐκείνῳ",704183,50],["θήσεις",712849,166],["αὐτὸ",702165,129],["ἐν",704639,0],["ταῖς",709436,75],["πόλεσίν",710612,76],["σου",711945,133]],"After three years thou shalt bring out all the tithes of thy fruits, in that year thou shalt lay it up in thy cities."],["29",[["καὶ",707031,7],["ἐλεύσεται",705453,93],["ὁ",709436,3],["λευίτης",708157,4],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["αὐτῷ",702165,50],["μερὶς",708748,12],["οὐδὲ",709816,7],["κλῆρος",707727,4],["μετὰ",708780,0],["σοῦ",711945,133],["καὶ",707031,7],["ὁ",709436,3],["προσήλυτος",710900,4],["καὶ",707031,7],["ὁ",709436,3],["ὀρφανὸς",709779,14],["καὶ",707031,7],["ἡ",709436,10],["χήρα",713848,12],["ἡ",709436,10],["ἐν",704639,0],["ταῖς",709436,75],["πόλεσίν",710612,76],["σου",711945,133],["καὶ",707031,7],["φάγονται",713296,135],["καὶ",707031,7],["ἐμπλησθήσονται",704592,144],["ἵνα",706747,7],["εὐλογήσῃ",705631,172],["σε",711598,163],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ἐν",704639,0],["πᾶσιν",710177,94],["τοῖς",709436,95],["ἔργοις",705396,96],["οἷς",709781,295],["ἐὰν",703912,7],["ποιῇς",710582,205]],"And the Levite shall come, because he has no part or lot with thee, and the stranger, and the orphan, and the widow which is in thy cities; and they shall eat and be filled, that the Lord thy God may bless thee in all the works which thou shalt do."]]