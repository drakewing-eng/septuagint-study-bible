[["1",[["οὗτοι",709858,201],["οἱ",709436,136],["λόγοι",708236,52],["οὓς",709781,298],["ἐλάλησεν",708071,2],["Μωυσῆς",709112,4],["παντὶ",710177,30],["Ισραηλ",706839,114],["πέραν",710280,28],["τοῦ",709436,35],["Ιορδάνου",706763,18],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["πρὸς",710844,0],["δυσμαῖς",703865,76],["πλησίον",710547,28],["τῆς",709436,16],["ἐρυθρᾶς",705447,82],["ἀνὰ",700902,0],["μέσον",708768,27],["Φαραν",713358,118],["Τοφολ",712914,118],["καὶ",707031,7],["Λοβον",708228,118],["καὶ",707031,7],["Αυλων",702140,118],["καὶ",707031,7],["καταχρύσεα",707495,246]],"These [are] the words which Moses spoke to all Israel on this side Jordan in the desert towards the west near the Red Sea, between Pharan Tophol, and Lobon, and Aulon, and the gold works."],["2",[["ἕνδεκα",704675,59],["ἡμερῶν",705984,65],["ἐν",704639,0],["Χωρηβ",714013,1],["ὁδὸς",709458,12],["ἐπ᾿",705080,0],["ὄρος",709768,25],["Σηιρ",711734,21],["ἕως",705792,0],["Καδης",706973,118],["Βαρνη",702541,118]],"[It is] a journey of eleven days from Choreb to mount Seir as far as Cades Barne."],["3",[["καὶ",707031,7],["ἐγενήθη",703104,37],["ἐν",704639,0],["τῷ",709436,53],["τεσσαρακοστῷ",712807,97],["ἔτει",705543,54],["ἐν",704639,0],["τῷ",709436,113],["ἑνδεκάτῳ",704676,30],["μηνὶ",708874,114],["μιᾷ",704106,101],["τοῦ",709436,35],["μηνὸς",708874,18],["ἐλάλησεν",708071,2],["Μωυσῆς",709112,4],["πρὸς",710844,0],["πάντας",710177,60],["υἱοὺς",713075,57],["Ισραηλ",706839,18],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἐνετείλατο",704791,23],["κύριος",707996,4],["αὐτῷ",702165,50],["πρὸς",710844,0],["αὐτούς",702165,62]],"And it came to pass in the fortieth year, in the eleventh month, on the first [day] of the month, Moses spoke to all the children of Israel, according to all things which the Lord commanded him for them:"],["4",[["μετὰ",708780,0],["τὸ",709436,24],["πατάξαι",710185,106],["Σηων",711759,6],["βασιλέα",702580,6],["Αμορραίων",700865,81],["τὸν",709436,5],["κατοικήσαντα",707534,365],["ἐν",704639,0],["Εσεβων",705473,111],["καὶ",707031,7],["Ωγ",714088,6],["βασιλέα",702580,6],["τῆς",709436,16],["Βασαν",702564,118],["τὸν",709436,5],["κατοικήσαντα",707534,365],["ἐν",704639,0],["Ασταρωθ",702009,111],["καὶ",707031,7],["ἐν",704639,0],["Εδραϊν",704039,111]],"after he had smitten Seon king of the Amorites who dwelt in Esebon, and Og the king of Basan who dwelt in Astaroth and in Edrain;"],["5",[["ἐν",704639,0],["τῷ",709436,53],["πέραν",710280,28],["τοῦ",709436,35],["Ιορδάνου",706763,18],["ἐν",704639,0],["γῇ",703083,1],["Μωαβ",709085,118],["ἤρξατο",701860,23],["Μωυσῆς",709112,4],["διασαφῆσαι",703572,106],["τὸν",709436,5],["νόμον",709349,6],["τοῦτον",709858,85],["λέγων",708124,72]],"beyond Jordan in the land of Moab, Moses began to declare this law, saying,"],["6",[["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["ἐλάλησεν",708071,2],["ἡμῖν",705994,90],["ἐν",704639,0],["Χωρηβ",714013,1],["λέγων",708124,72],["ἱκανούσθω",706711,407],["ὑμῖν",713084,90],["κατοικεῖν",707534,55],["ἐν",704639,0],["τῷ",709436,53],["ὄρει",709768,54],["τούτῳ",709858,280]],"The Lord your God spoke to us in Choreb, saying, Let it suffice you to have dwelt [so long] in this mountain."],["7",[["ἐπιστράφητε",705278,372],["καὶ",707031,7],["ἀπάρατε",701329,74],["ὑμεῖς",713081,219],["καὶ",707031,7],["εἰσπορεύεσθε",704124,73],["εἰς",704105,0],["ὄρος",709768,25],["Αμορραίων",700865,81],["καὶ",707031,7],["πρὸς",710844,0],["πάντας",710177,60],["τοὺς",709436,58],["περιοίκους",710355,60],["Αραβα",701671,17],["εἰς",704105,0],["ὄρος",709768,25],["καὶ",707031,7],["πεδίον",710215,25],["καὶ",707031,7],["πρὸς",710844,0],["λίβα",708224,6],["καὶ",707031,7],["παραλίαν",710063,36],["γῆν",703083,9],["Χαναναίων",713711,81],["καὶ",707031,7],["Ἀντιλίβανον",701248,6],["ἕως",705792,0],["τοῦ",709436,35],["ποταμοῦ",710693,18],["τοῦ",709436,35],["μεγάλου",708653,116],["Εὐφράτου",705716,18]],"Turn ye and depart and enter into the mountain of the Amorites, and [go] to all that dwell near about Araba, to the mountain and the plain and to the south, and the land of the Chananites near the sea, and Antilibanus, as far as the great river, the river Euphrates."],["8",[["ἴδετε",709725,74],["παραδέδωκα",710014,89],["ἐνώπιον",704823,0],["ὑμῶν",713091,145],["τὴν",709436,8],["γῆν",703083,9],["εἰσπορευθέντες",704124,247],["κληρονομήσατε",707724,74],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["ὤμοσα",709620,155],["τοῖς",709436,147],["πατράσιν",710189,148],["ὑμῶν",713091,145],["τῷ",709436,113],["Αβρααμ",700091,114],["καὶ",707031,7],["Ισαακ",706799,114],["καὶ",707031,7],["Ιακωβ",706401,114],["δοῦναι",703654,106],["αὐτοῖς",702165,151],["καὶ",707031,7],["τῷ",709436,53],["σπέρματι",712008,54],["αὐτῶν",702165,40],["μετ᾿",708780,0],["αὐτούς",702165,62]],"Behold, [God] has delivered the land before you; go in and inherit the land, which I sware to your fathers, Abraam, and Isaac, and Jacob, to give it to them and to their seed after them."],["9",[["καὶ",707031,7],["εἶπα",705373,155],["πρὸς",710844,0],["ὑμᾶς",713080,194],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["λέγων",708124,72],["οὐ",709805,28],["δυνήσομαι",703838,181],["μόνος",709003,14],["φέρειν",713428,55],["ὑμᾶς",713080,194]],"And I spoke to you at that time, saying, I shall not be able by myself to bear you."],["10",[["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["ἐπλήθυνεν",710530,2],["ὑμᾶς",713080,194],["καὶ",707031,7],["ἰδού",706497,88],["ἐστε",704093,87],["σήμερον",711751,28],["ὡσεὶ",714159,28],["τὰ",709436,41],["ἄστρα",702024,42],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["τῷ",709436,53],["πλήθει",710529,54]],"The Lord your God has multiplied you, and, behold, ye are to-day as the stars of heaven for multitude."],["11",[["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,80],["πατέρων",710189,81],["ὑμῶν",713091,145],["προσθείη",710965,225],["ὑμῖν",713084,90],["ὡς",714148,7],["ἐστὲ",704093,87],["χιλιοπλασίως",713860,28],["καὶ",707031,7],["εὐλογήσαι",705631,225],["ὑμᾶς",713080,194],["καθότι",707021,28],["ἐλάλησεν",708071,2],["ὑμῖν",713084,90]],"The Lord God of your fathers add to you a thousand-fold more than you are, and bless you as he has spoken to you."],["12",[["πῶς",711121,28],["δυνήσομαι",703838,181],["μόνος",709003,14],["φέρειν",713428,55],["τὸν",709436,5],["κόπον",707825,6],["ὑμῶν",713091,145],["καὶ",707031,7],["τὴν",709436,8],["ὑπόστασιν",713241,9],["ὑμῶν",713091,145],["καὶ",707031,7],["τὰς",709436,38],["ἀντιλογίας",701249,39],["ὑμῶν",713091,145]],"How shall I alone be able to bear your labour, and your burden, and your gainsayings?"],["13",[["δότε",703654,74],["ἑαυτοῖς",703917,151],["ἄνδρας",701150,57],["σοφοὺς",711985,60],["καὶ",707031,7],["ἐπιστήμονας",705268,60],["καὶ",707031,7],["συνετοὺς",712464,60],["εἰς",704105,0],["τὰς",709436,38],["φυλὰς",713620,39],["ὑμῶν",713091,145],["καὶ",707031,7],["καταστήσω",707011,165],["ἐφ᾿",705080,0],["ὑμῶν",713091,145],["ἡγουμένους",705931,236],["ὑμῶν",713091,145]],"Take to yourselves wise and understanding and prudent men for your tribes, and I will set your leaders over you."],["14",[["καὶ",707031,7],["ἀπεκρίθητέ",701492,472],["μοι",708974,159],["καὶ",707031,7],["εἴπατε",705373,265],["καλὸν",707097,46],["τὸ",709436,34],["ῥῆμα",711246,15],["ὃ",709781,128],["ἐλάλησας",708071,162],["ποιῆσαι",710582,106]],"And ye answered me and said, The thing which thou hast told us [is] good to do."],["15",[["καὶ",707031,7],["ἔλαβον",708076,155],["ἐξ",704132,0],["ὑμῶν",713091,145],["ἄνδρας",701150,57],["σοφοὺς",711985,60],["καὶ",707031,7],["ἐπιστήμονας",705268,60],["καὶ",707031,7],["συνετοὺς",712464,60],["καὶ",707031,7],["κατέστησα",707011,155],["αὐτοὺς",702165,62],["ἡγεῖσθαι",705931,110],["ἐφ᾿",705080,0],["ὑμῶν",713091,145],["χιλιάρχους",713857,57],["καὶ",707031,7],["ἑκατοντάρχους",704140,57],["καὶ",707031,7],["πεντηκοντάρχους",710272,57],["καὶ",707031,7],["δεκαδάρχους",703334,57],["καὶ",707031,7],["γραμματοεισαγωγεῖς",703188,57],["τοῖς",709436,147],["κριταῖς",707910,148],["ὑμῶν",713091,145]],"So I took of you wise and understanding and prudent men, and I set them to rule over you as rulers of thousands, and rulers of hundreds, and rulers of fifties, and rulers of tens, and officers to your judges."],["16",[["καὶ",707031,7],["ἐνετειλάμην",704791,161],["τοῖς",709436,147],["κριταῖς",707910,148],["ὑμῶν",713091,145],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["λέγων",708124,72],["διακούετε",703485,335],["ἀνὰ",700902,0],["μέσον",708768,27],["τῶν",709436,80],["ἀδελφῶν",700249,81],["ὑμῶν",713091,145],["καὶ",707031,7],["κρίνατε",707905,74],["δικαίως",703698,28],["ἀνὰ",700902,0],["μέσον",708768,27],["ἀνδρὸς",701150,18],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,27],["ἀδελφοῦ",700249,18],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,27],["προσηλύτου",710900,18],["αὐτοῦ",702165,102]],"And I charged your judges at that time, saying, Hear [causes] between your brethren, and judge rightly between a man and [his] brother, and the stranger that is with him."],["17",[["οὐκ",709805,28],["ἐπιγνώσῃ",705104,123],["πρόσωπον",710986,25],["ἐν",704639,0],["κρίσει",707908,1],["κατὰ",707200,0],["τὸν",709436,5],["μικρὸν",708915,27],["καὶ",707031,7],["κατὰ",707200,0],["τὸν",709436,5],["μέγαν",708653,27],["κρινεῖς",707905,166],["οὐ",709805,28],["μὴ",708851,28],["ὑποστείλῃ",713242,420],["πρόσωπον",710986,25],["ἀνθρώπου",701163,18],["ὅτι",709803,7],["ἡ",709436,10],["κρίσις",707908,12],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐστιν",704093,91],["καὶ",707031,7],["τὸ",709436,34],["ῥῆμα",711246,15],["ὃ",709781,33],["ἐὰν",703912,7],["σκληρὸν",711861,26],["ᾖ",704093,204],["ἀφ᾿",701425,0],["ὑμῶν",713091,145],["ἀνοίσετε",701083,337],["αὐτὸ",702165,129],["ἐπ᾿",705080,0],["ἐμέ",704555,163],["καὶ",707031,7],["ἀκούσομαι",700587,181],["αὐτό",702165,129]],"Thou shalt not have respect to persons in judgment, thou shalt judge small and great equally; thou shalt not shrink from before the person of a man, for the judgment is God's; and whatsoever matter shall be too hard for you, ye shall bring it to me, and I will hear it."],["18",[["καὶ",707031,7],["ἐνετειλάμην",704791,161],["ὑμῖν",713084,90],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["οὓς",709781,298],["ποιήσετε",710582,337]],"And I charged upon you at that time all the commands which ye shall perform."],["19",[["καὶ",707031,7],["ἀπάραντες",701329,196],["ἐκ",704132,0],["Χωρηβ",714013,17],["ἐπορεύθημεν",710667,485],["πᾶσαν",710177,36],["τὴν",709436,8],["ἔρημον",705420,9],["τὴν",709436,8],["μεγάλην",708653,36],["καὶ",707031,7],["τὴν",709436,8],["φοβερὰν",713530,36],["ἐκείνην",704183,104],["ἣν",709781,131],["εἴδετε",709725,265],["ὁδὸν",709458,9],["ὄρους",709768,21],["τοῦ",709436,35],["Αμορραίου",700865,18],["καθότι",707021,28],["ἐνετείλατο",704791,23],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["ἡμῖν",705994,90],["καὶ",707031,7],["ἤλθομεν",705453,289],["ἕως",705792,0],["Καδης",706973,118],["Βαρνη",702541,118]],"And we departed from Choreb, and went through all that great wilderness and terrible, which ye saw, by the way of the mountain of the Amorite, as the Lord our God charged us, and we came as far as Cades Barne."],["20",[["καὶ",707031,7],["εἶπα",705373,155],["πρὸς",710844,0],["ὑμᾶς",713080,194],["ἤλθατε",705453,265],["ἕως",705792,0],["τοῦ",709436,20],["ὄρους",709768,21],["τοῦ",709436,35],["Αμορραίου",700865,18],["ὃ",709781,33],["ὁ",709436,3],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["δίδωσιν",703654,91],["ὑμῖν",713084,90]],"And I said to you, Ye have come as far as the mountain of the Amorite, which the Lord our God gives to you:"],["21",[["ἴδετε",709725,74],["παραδέδωκεν",710014,171],["ὑμῖν",713084,90],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["πρὸ",710747,0],["προσώπου",710986,21],["ὑμῶν",713091,145],["τὴν",709436,8],["γῆν",703083,9],["ἀναβάντες",700905,196],["κληρονομήσατε",707724,74],["ὃν",709781,112],["τρόπον",712980,6],["εἶπεν",705373,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,80],["πατέρων",710189,81],["ὑμῶν",713091,145],["ὑμῖν",713084,90],["μὴ",708851,28],["φοβεῖσθε",713532,73],["μηδὲ",708855,7],["δειλιάσητε",703321,372]],"behold, the Lord your God has delivered to us the land before you: go up and inherit it as the Lord God of your fathers said to you; fear not, neither be afraid."],["22",[["καὶ",707031,7],["προσήλθατέ",710890,265],["μοι",708974,159],["πάντες",710177,138],["καὶ",707031,7],["εἴπατε",705373,265],["ἀποστείλωμεν",701592,79],["ἄνδρας",701150,57],["προτέρους",710992,60],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐφοδευσάτωσαν",705757,264],["ἡμῖν",705994,90],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἀναγγειλάτωσαν",700921,264],["ἡμῖν",705994,90],["ἀπόκρισιν",701493,9],["τὴν",709436,8],["ὁδόν",709458,9],["δι᾿",703417,0],["ἧς",709781,167],["ἀναβησόμεθα",700905,141],["ἐν",704639,0],["αὐτῇ",702165,105],["καὶ",707031,7],["τὰς",709436,38],["πόλεις",710612,39],["εἰς",704105,0],["ἃς",709781,193],["εἰσπορευσόμεθα",704124,141],["εἰς",704105,0],["αὐτάς",702165,231]],"And ye all came to me, and said, Let us send men before us, and let them go up to the land for us; and let them bring back to us a report of the way by which we shall go up, and of the cities into which we shall enter."],["23",[["καὶ",707031,7],["ἤρεσεν",701722,2],["ἐναντίον",704654,0],["μου",709032,133],["τὸ",709436,34],["ῥῆμα",711246,15],["καὶ",707031,7],["ἔλαβον",708076,155],["ἐξ",704132,0],["ὑμῶν",713091,145],["δώδεκα",703887,59],["ἄνδρας",701150,57],["ἄνδρα",701150,6],["ἕνα",704106,27],["κατὰ",707200,0],["φυλήν",713620,9]],"And the saying pleased me: and I took of you twelve men, one man of a tribe."],["24",[["καὶ",707031,7],["ἐπιστραφέντες",705278,247],["ἀνέβησαν",700905,150],["εἰς",704105,0],["τὸ",709436,24],["ὄρος",709768,25],["καὶ",707031,7],["ἤλθοσαν",705453,150],["ἕως",705792,0],["Φάραγγος",713351,17],["βότρυος",702775,18],["καὶ",707031,7],["κατεσκόπευσαν",707426,150],["αὐτήν",702165,104]],"And they turned and went up to the mountain, and they came as far as the valley of the cluster, and surveyed it."],["25",[["καὶ",707031,7],["ἐλάβοσαν",708076,150],["ἐν",704639,0],["ταῖς",709436,75],["χερσὶν",713787,76],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["τοῦ",709436,35],["καρποῦ",707169,18],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["κατήνεγκαν",707471,150],["πρὸς",710844,0],["ἡμᾶς",705981,194],["καὶ",707031,7],["ἔλεγον",708124,137],["ἀγαθὴ",700106,29],["ἡ",709436,10],["γῆ",703083,12],["ἣν",709781,131],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["δίδωσιν",703654,91],["ἡμῖν",705994,90]],"And they took in their hands of the fruit of the land, and brought it to you, and said, The land is good which the Lord our God gives us."],["26",[["καὶ",707031,7],["οὐκ",709805,28],["ἠθελήσατε",706176,265],["ἀναβῆναι",700905,106],["καὶ",707031,7],["ἠπειθήσατε",701370,265],["τῷ",709436,53],["ῥήματι",711246,54],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ὑμῶν",713091,145]],"Yet ye would not go up, but rebelled against the words of the Lord our God."],["27",[["καὶ",707031,7],["διεγογγύζετε",703438,399],["ἐν",704639,0],["ταῖς",709436,75],["σκηναῖς",711845,76],["ὑμῶν",713091,145],["καὶ",707031,7],["εἴπατε",705373,265],["διὰ",703417,0],["τὸ",709436,24],["μισεῖν",708935,55],["κύριον",707996,6],["ἡμᾶς",705981,194],["ἐξήγαγεν",704834,2],["ἡμᾶς",705981,194],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["παραδοῦναι",710014,106],["ἡμᾶς",705981,194],["εἰς",704105,0],["χεῖρας",713787,39],["Αμορραίων",700865,81],["ἐξολεθρεῦσαι",704956,106],["ἡμᾶς",705981,194]],"And ye murmured in your tents, and said, Because the Lord hated us, he has brought us out of the land of Egypt to deliver us into the hands of the Amorites, to destroy us."],["28",[["ποῦ",710706,28],["ἡμεῖς",705983,219],["ἀναβαίνομεν",700905,243],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["ὑμῶν",713091,145],["ἀπέστησαν",702214,150],["ὑμῶν",713091,145],["τὴν",709436,8],["καρδίαν",707141,9],["λέγοντες",708124,146],["ἔθνος",704068,15],["μέγα",708653,26],["καὶ",707031,7],["πολὺ",710646,26],["καὶ",707031,7],["δυνατώτερον",703845,385],["ἡμῶν",705999,145],["καὶ",707031,7],["πόλεις",710612,191],["μεγάλαι",708653,192],["καὶ",707031,7],["τετειχισμέναι",712757,423],["ἕως",705792,0],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["ἀλλὰ",700680,7],["καὶ",707031,7],["υἱοὺς",713075,57],["γιγάντων",703101,81],["ἑωράκαμεν",709725,314],["ἐκεῖ",704181,28]],"Whither do we go up? and your brethren drew away your heart, saying, [It is a] great nation and populous, and mightier than we; and [there are] cities great and walled up to heaven: moreover we saw there the sons of the giants."],["29",[["καὶ",707031,7],["εἶπα",705373,155],["πρὸς",710844,0],["ὑμᾶς",713080,194],["μὴ",708851,28],["πτήξητε",711060,372],["μηδὲ",708855,7],["φοβηθῆτε",713532,394],["ἀπ᾿",701425,0],["αὐτῶν",702165,40]],"And I said to you, Fear not, neither be ye afraid of them;"],["30",[["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["ὁ",709436,3],["προπορευόμενος",710839,122],["πρὸ",710747,0],["προσώπου",710986,21],["ὑμῶν",713091,145],["αὐτὸς",702165,121],["συνεκπολεμήσει",712439,127],["αὐτοὺς",702165,62],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἐποίησεν",710582,2],["ὑμῖν",713084,90],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτῳ",700401,1]],"the Lord your God who goes before your face, he shall fight against them together with you effectually, according to all that he wrought for you in the land of Egypt;"],["31",[["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["ταύτῃ",709858,105],["ἣν",709781,131],["εἴδετε",709725,265],["ὡς",714148,7],["ἐτροφοφόρησέν",712986,2],["σε",711598,163],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ὡς",714148,7],["εἴ",704071,7],["τις",712866,158],["τροφοφορήσει",712986,127],["ἄνθρωπος",701163,4],["τὸν",709436,5],["υἱὸν",713075,6],["αὐτοῦ",702165,102],["κατὰ",707200,0],["πᾶσαν",710177,36],["τὴν",709436,8],["ὁδόν",709458,9],["ἣν",709781,131],["ἐπορεύθητε",710667,472],["ἕως",705792,7],["ἤλθετε",705453,265],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["τοῦτον",709858,85]],"and in this wilderness which ye saw, by the way of the mountain of the Amorite; how the Lord thy God will bear thee as a nursling, as if any man should nurse his child, through all the way which ye have gone until ye came to this place."],["32",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["λόγῳ",708236,114],["τούτῳ",709858,50],["οὐκ",709805,28],["ἐνεπιστεύσατε",704594,265],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["ὑμῶν",713091,145]],"And in this matter ye believed not the Lord our God,"],["33",[["ὃς",709781,213],["προπορεύεται",710839,117],["πρότερος",710992,14],["ὑμῶν",713091,145],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["ἐκλέγεσθαι",704236,110],["ὑμῖν",713084,90],["τόπον",712903,6],["ὁδηγῶν",709448,72],["ὑμᾶς",713080,194],["ἐν",704639,0],["πυρὶ",711088,54],["νυκτὸς",709386,17],["δεικνύων",703314,72],["ὑμῖν",713084,90],["τὴν",709436,8],["ὁδόν",709458,9],["καθ᾿",707200,0],["ἣν",709781,131],["πορεύεσθε",710667,73],["ἐπ᾿",705080,0],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐν",704639,0],["νεφέλῃ",709277,1],["ἡμέρας",705984,17]],"who goes before you in the way to choose you a place, guiding you in fire by night, shewing you the way by which ye go, and a cloud by day."],["34",[["καὶ",707031,7],["ἤκουσεν",700587,2],["κύριος",707996,4],["τὴν",709436,8],["φωνὴν",713640,9],["τῶν",709436,80],["λόγων",708236,81],["ὑμῶν",713091,145],["καὶ",707031,7],["παροξυνθεὶς",710164,217],["ὤμοσεν",709620,2],["λέγων",708124,72]],"And the Lord heard the voice of your words, and being greatly provoked he sware, saying,"],["35",[["εἰ",704071,7],["ὄψεταί",709725,93],["τις",712866,158],["τῶν",709436,80],["ἀνδρῶν",701150,81],["τούτω