700106,46],["ἢ",705924,7],["κακόν",707066,46],["οὗτοι",709858,201],["εἰσελεύσονται",704114,135],["ἐκεῖ",704181,28],["καὶ",707031,7],["τούτοις",709858,151],["δώσω",703654,165],["αὐτήν",702165,104],["καὶ",707031,7],["αὐτοὶ",702165,201],["κληρονομήσουσιν",707724,218],["αὐτήν",702165,104]],"And every young child who this day knows not good or evil,—they shall enter therein, and to them I will give it, and they shall inherit it."],["40",[["καὶ",707031,7],["ὑμεῖς",713081,219],["ἐπιστραφέντες",705278,247],["ἐστρατοπεδεύσατε",712150,265],["εἰς",704105,0],["τὴν",709436,8],["ἔρημον",705420,9],["ὁδὸν",709458,9],["τὴν",709436,8],["ἐπὶ",705080,0],["τῆς",709436,16],["ἐρυθρᾶς",705447,82],["θαλάσσης",706069,17]],"And ye turned and marched into the wilderness, in the way by the Red Sea."],["41",[["καὶ",707031,7],["ἀπεκρίθητέ",701492,472],["μοι",708974,159],["καὶ",707031,7],["εἴπατε",705373,265],["ἡμάρτομεν",700773,289],["ἔναντι",704653,0],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["ἡμεῖς",705983,219],["ἀναβάντες",700905,196],["πολεμήσομεν",710601,275],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἐνετείλατο",704791,23],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["ἡμῖν",705994,90],["καὶ",707031,7],["ἀναλαβόντες",700984,196],["ἕκαστος",704133,14],["τὰ",709436,41],["σκεύη",711844,42],["τὰ",709436,41],["πολεμικὰ",710602,68],["αὐτοῦ",702165,102],["καὶ",707031,7],["συναθροισθέντες",712378,247],["ἀνεβαίνετε",700905,399],["εἰς",704105,0],["τὸ",709436,24],["ὄρος",709768,25]],"And ye answered and said, We have sinned before the Lord our God; we will go up and fight according to all that the Lord our God has commanded us: and having taken every one his weapons of war, and being gathered together, ye went up to the mountain."],["42",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["εἰπὸν",705373,176],["αὐτοῖς",702165,151],["οὐκ",709805,28],["ἀναβήσεσθε",700905,124],["οὐδὲ",