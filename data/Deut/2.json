[["1",[["καὶ",707031,7],["ἐπιστραφέντες",705278,247],["ἀπήραμεν",701329,289],["εἰς",704105,0],["τὴν",709436,8],["ἔρημον",705420,9],["ὁδὸν",709458,9],["θάλασσαν",706069,9],["ἐρυθράν",705447,36],["ὃν",709781,112],["τρόπον",712980,6],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["καὶ",707031,7],["ἐκυκλώσαμεν",707958,289],["τὸ",709436,24],["ὄρος",709768,25],["τὸ",709436,24],["Σηιρ",711734,25],["ἡμέρας",705984,39],["πολλάς",710646,119]],"And we turned and departed into the wilderness, by the way of the Red Sea, as the Lord spoke to me, and we compassed mount Seir many days."],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163]],"And the Lord said to me,"],["3",[["ἱκανούσθω",706711,407],["ὑμῖν",713084,90],["κυκλοῦν",707958,55],["τὸ",709436,24],["ὄρος",709768,25],["τοῦτο",709858,129],["ἐπιστράφητε",705278,372],["οὖν",709835,11],["ἐπὶ",705080,0],["βορρᾶν",702765,6]],"Ye have compassed this mount long enough; turn therefore toward the north."],["4",[["καὶ",707031,7],["τῷ",709436,113],["λαῷ",708094,114],["ἔντειλαι",704791,300],["λέγων",708124,72],["ὑμεῖς",713081,219],["παραπορεύεσθε",710094,73],["διὰ",703417,0],["τῶν",709436,43],["ὁρίων",709749,44],["τῶν",709436,80],["ἀδελφῶν",700249,81],["ὑμῶν",713091,145],["υἱῶν",713075,81],["Ησαυ",706030,18],["οἳ",709781,250],["κατοικοῦσιν",707534,197],["ἐν",704639,0],["Σηιρ",711734,54],["καὶ",707031,7],["φοβηθήσονται",713532,144],["ὑμᾶς",713080,194],["καὶ",707031,7],["εὐλαβηθήσονται",705627,144],["ὑμᾶς",713080,194],["σφόδρα",712586,28]],"And charge the people, saying, Ye are going through the borders of your brethren the children of Esau, who dwell in Seir; and they shall fear you, and dread you greatly."],["5",[["μὴ",708851,28],["συνάψητε",712404,125],["πρὸς",710844,0],["αὐτοὺς",702165,62],["πόλεμον",710605,6],["οὐ",709805,28],["γὰρ",702963,11],["μὴ",708851,28],["δῶ",703654,207],["ὑμῖν",713084,90],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["αὐτῶν",702165,40],["οὐδὲ",709816,7],["βῆμα",702698,25],["ποδός",710707,18],["ὅτι",709803,7],["ἐν",704639,0],["κλήρῳ",707727,114],["δέδωκα",703654,89],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ησαυ",706030,18],["τὸ",709436,24],["ὄρος",709768,25],["τὸ",709436,24],["Σηιρ",711734,25]],"Do not engage in war against them, for I will not give you of their land even enough to set your foot upon, for I have given mount Seir to the children of Esau as an inheritance."],["6",[["βρώματα",702823,42],["ἀργυρίου",701707,21],["ἀγοράσατε",700184,74],["παρ᾿",709995,0],["αὐτῶν",702165,40],["καὶ",707031,7],["φάγεσθε",705495,124],["καὶ",707031,7],["ὕδωρ",713071,15],["μέτρῳ",708846,54],["λήμψεσθε",708076,124],["παρ᾿",709995,0],["αὐτῶν",702165,40],["ἀργυρίου",701707,21],["καὶ",707031,7],["πίεσθε",710478,124]],"Buy food of them for money and eat, and ye shall receive water of them by measure for money, and drink."],["7",[["ὁ",709436,3],["γὰρ",702963,11],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["εὐλόγησέν",705631,2],["σε",711598,163],["ἐν",704639,0],["παντὶ",710177,97],["ἔργῳ",705396,54],["τῶν",709436,130],["χειρῶν",713787,65],["σου",711945,133],["διάγνωθι",703435,176],["πῶς",711121,28],["διῆλθες",703673,162],["τὴν",709436,8],["ἔρημον",705420,9],["τὴν",709436,8],["μεγάλην",708653,36],["καὶ",707031,7],["τὴν",709436,8],["φοβερὰν",713530,36],["ἐκείνην",704183,104],["ἰδοὺ",706497,88],["τεσσαράκοντα",712806,59],["ἔτη",705543,42],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["μετὰ",708780,0],["σοῦ",711945,133],["οὐκ",709805,28],["ἐπεδεήθης",705118,168],["ῥήματος",711246,21]],"For the Lord our God has blessed thee in every work of thy hands. Consider how thou wentest through that great and terrible wilderness: behold, the Lord thy God [has been] with thee forty years; thou didst not lack any thing."],["8",[["καὶ",707031,7],["παρήλθομεν",710141,289],["τοὺς",709436,58],["ἀδελφοὺς",700249,57],["ἡμῶν",705999,145],["υἱοὺς",713075,57],["Ησαυ",706030,1