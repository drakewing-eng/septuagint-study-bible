5,0],["πόλεμον",710605,6],["οὐ",709805,28],["γὰρ",702963,11],["μὴ",708851,28],["δῶ",703654,207],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["υἱῶν",713075,81],["Αμμαν",700833,18],["σοὶ",711925,159],["ἐν",704639,0],["κλήρῳ",707727,114],["ὅτι",709803,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["Λωτ",708293,18],["δέδωκα",703654,89],["αὐτὴν",702165,104],["ἐν",704639,0],["κλήρῳ",707727,114]],"and ye shall draw nigh to the children of Amman: do not quarrel with them, nor wage war with them; for I will not give thee of the land of the children of Amman for an inheritance, because I have given it to the children of Lot for an inheritance."],["20",[["γῆ",703083,12],["Ραφαϊν",711197,81],["λογισθήσεται",708232,134],["καὶ",707031,28],["γὰρ",702963,11],["ἐπ᾿",705080,0],["αὐτῆς",702165,86],["κατῴκουν",707534,137],["οἱ",709436,136],["Ραφαϊν",711197,52],["τὸ",709436,24],["πρότερον",710991,46],["καὶ",707031,7],["οἱ",709436,136],["Αμμανῖται",700837,52],["ὀνομάζουσιν",709667,197],["αὐτοὺς",702165,62],["Ζομζομμιν",705888,57]],"It shall be accounted a land of Raphain, for the Raphain dwelt there before, and the Ammanites call them Zochommin."],["21",[["ἔθνος",704068,15],["μέγα",708653,26],["καὶ",707031,7],["πολὺ",710646,26],["καὶ",707031,7],["δυνατώτερον",703845,385],["ὑμῶν",713091,145],["ὥσπερ",714163,28],["οἱ",709436,136],["Ενακιμ",704647,52],["καὶ",707031,7],["ἀπώλεσεν",701513,2],["αὐτοὺς",702165,62],["κύριος",707996,4],["πρὸ",710747,0],["προσώπου",710986,21],["αὐτῶν",702165,40],["καὶ",707031,7],["κατεκληρονόμησαν",707274,150],["καὶ",707031,7],["κατῳκίσθησαν",707538,99],["ἀντ᾿",701227,0],["αὐτῶν",702165,40],["ἕως",705792,0],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86]],"A great nation and populous, and mightier than you, as also the Enakim: yet the Lord destroyed them from before them, and they inherited [their land], and they dwelt [there] instead of them until this day."],["22",[["ὥσπερ",714163,28],["ἐποίησαν",710582,150],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ησαυ",706030,18],["τοῖς",709436,147],["κατοικοῦσιν",707534,349],["ἐν",704639,0],["Σηιρ",711734,54],["ὃν",709781,112],["τρόπον",712980,6],["ἐξέτριψαν",704345,150],["τὸν",709436,5],["Χορραῖον",713917,6],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτῶν",702165,40],["καὶ",707031,7],["κατεκληρονόμησαν",707274,150],["καὶ",707031,7],["κατῳκίσθησαν",707538,99],["ἀντ᾿",701227,0],["αὐτῶν",702165,40],["ἕως",705792,0],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86]],"As they did to the children of Esau that dwell in Seir, even as they destroyed the Chorrhite from before them, and inherited their country, and dwelt [therein] instead of them until this day."],["23",[["καὶ",707031,7],["οἱ",709436,136],["Ευαῖοι",705549,52],["οἱ",709436,136],["κατοικοῦντες",707534,146],["ἐν",704639,0],["ασηρωθ",701936,111],["ἕως",705792,0],["Γάζης",702884,118],["καὶ",707031,7],["οἱ",709436,136],["Καππάδοκες",707133,52],["οἱ",709436,136],["ἐξελθόντες",704909,196],["ἐκ",704132,0],["Καππαδοκίας",707134,118],["ἐξέτριψαν",704345,150],["αὐτοὺς",702165,62],["καὶ",707031,7],["κατῳκίσθησαν",707538,99],["ἀντ᾿",701227,0],["αὐτῶν",702165,40]],"And the Evites who dwell in Asedoth to Gaza, and the Cappadocians who came out of Cappadocia, destroyed them, and dwelt in their room."],["24",[["νῦν",709384,28],["οὖν",709835,11],["ἀνάστητε",701173,74],["καὶ",707031,7],["ἀπάρατε",701329,74],["καὶ",707031,7],["παρέλθατε",710141,74],["ὑμεῖς",713081,219],["τὴν",709436,8],["φάραγγα",713351,9],["Αρνων",701783,118],["ἰδοὺ",706497,88],["παραδέδωκα",710014,89],["εἰς",704105,0],["τὰς",709436,38],["χεῖράς",713787,39],["σου",711945,133],["τὸν",709436,5],["Σηων",711759,6],["βασιλέα",702580,6],["Εσεβων",705473,118],["τὸν",709436,5],["Αμορραῖον",700865,6],["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9],["αὐτοῦ",702165,102],["ἐνάρχου",704664,253],["κληρονομεῖν",707724,55],["σύναπτε",712404,240],["πρὸς",710844,0],["αὐτὸν",702165,85],["πόλεμον",710605,6]],"Now then arise and depart, and pass over the valley of Arnon: behold, I have delivered into thy hands Seon the king of Esebon the Amorite, and his land: begin to inherit [it]: engage in war with him this day."],["25",[["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ταύτῃ",709858,105],["ἐνάρχου",704664,253],["δοῦναι",703654,106],["τὸν",709436,5],["τρόμον",712975,6],["σου",711945,133],["καὶ",707031,7],["τὸν",709436,5],["φόβον",713534,6],["σου",711945,133],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["πάντων",710177,83],["τῶν",709436,43],["ἐθνῶν",704068,44],["τῶν",709436,43],["ὑποκάτω",713204,0],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["οἵτινες",709793,450],["ἀκούσαντες",700587,196],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["ταραχθήσονται",712721,144],["καὶ",707031,7],["ὠδῖνας",714094,39],["ἕξουσιν",705785,218],["ἀπὸ",701425,0],["προσώπου",710986,21],["σου",711945,133]],"Begin to put thy terror and thy fear on the face of all the nations under heaven, who shall be troubled when they have heard thy name, and shall be in anguish before thee."],["26",[["καὶ",707031,7],["ἀπέστειλα",701592,155],["πρέσβεις",710733,57],["ἐκ",704132,0],["τῆς",709436,16],["ἐρήμου",705420,17],["Κεδαμωθ",707582,246],["πρὸς",710844,0],["Σηων",711759,6],["βασιλέα",702580,6],["Εσεβων",705473,118],["λόγοις",708236,148],["εἰρηνικοῖς",704099,230],["λέγων",708124,72]],"And I sent ambassadors from the wilderness of Kedamoth to Seon king of Esebon with peaceable words, saying,"],["27",[["παρελεύσομαι",710141,181],["διὰ",703417,0],["τῆς",709436,16],["γῆς",703083,17],["σου",711945,133],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["παρελεύσομαι",710141,181],["οὐχὶ",709862,28],["ἐκκλινῶ",704220,165],["δεξιὰ",703360,68],["οὐδὲ",709816,7],["ἀριστερά",701749,68]],"I will pass through thy land: I will go by the road, I will not turn aside to the right hand or to the left."],["28",[["βρώματα",702823,42],["ἀργυρίου",701707,21],["ἀποδώσῃ",701449,123],["μοι",708974,159],["καὶ",707031,7],["φάγομαι",705495,181],["καὶ",707031,7],["ὕδωρ",713071,15],["ἀργυ