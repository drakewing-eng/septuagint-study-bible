[["1",[["φύλαξαι",713619,300],["τὸν",709436,5],["μῆνα",708874,6],["τῶν",709436,43],["νέων",709256,83],["καὶ",707031,7],["ποιήσεις",710582,166],["τὸ",709436,24],["πασχα",710182,25],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["σου",711945,133],["ὅτι",709803,7],["ἐν",704639,0],["τῷ",709436,113],["μηνὶ",708874,114],["τῶν",709436,43],["νέων",709256,83],["ἐξῆλθες",704909,162],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["νυκτός",709386,17]],"Observe the month of new [corn], and thou shalt sacrifice the passover to the Lord thy God; because in the month of new corn thou camest out of Egypt by night."],["2",[["καὶ",707031,7],["θύσεις",706349,166],["τὸ",709436,24],["πασχα",710182,25],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["σου",711945,133],["πρόβατα",710768,42],["καὶ",707031,7],["βόας",702798,57],["ἐν",704639,0],["τῷ",709436,113],["τόπῳ",712903,114],["ᾧ",709781,309],["ἐὰν",703912,7],["ἐκλέξηται",704236,239],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["αὐτὸν",702165,85],["ἐπικληθῆναι",705153,179],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["ἐκεῖ",704181,28]],"And thou shalt sacrifice the passover to the Lord thy God, sheep and oxen in the place which the Lord thy God shall choose to have his name called upon it."],["3",[["οὐ",709805,28],["φάγῃ",713296,123],["ἐπ᾿",705080,0],["αὐτοῦ",702165,49],["ζύμην",705897,9],["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["φάγῃ",713296,123],["ἐπ᾿",705080,0],["αὐτοῦ",702165,49],["ἄζυμα",700345,68],["ἄρτον",701829,6],["κακώσεως",707075,17],["ὅτι",709803,7],["ἐν",704639,0],["σπουδῇ",712035,1],["ἐξήλθετε",704909,265],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["ἵνα",706747,7],["μνησθῆτε",708923,394],["τὴν",709436,8],["ἡμέραν",705984,9],["τῆς",709436,16],["ἐξοδίας",704944,17],["ὑμῶν",713091,145],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["τῆς",709436,16],["ζωῆς",705910,17],["ὑμῶν",713091,145]],"Thou shalt not eat leaven with it; seven days shalt thou eat unleavened [bread] with it, bread of affliction, because ye came forth out of Egypt in haste; that ye may remember the day of your coming forth out of the land of Egypt all the days of your life."],["4",[["οὐκ",709805,28],["ὀφθήσεταί",709725,134],["σοι",711925,159],["ζύμη",705897,12],["ἐν",704639,0],["πᾶσι",710177,94],["τοῖς",709436,95],["ὁρίοις",709749,96],["σου",711945,133],["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["καὶ",707031,7],["οὐ",709805,28],["κοιμηθήσεται",707767,134],["ἀπὸ",701425,0],["τῶν",709436,43],["κρεῶν",707889,44],["ὧν",709781,103],["ἐὰν",703912,7],["θύσῃς",706349,175],["τὸ",709436,24],["ἑσπέρας",705500,17],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["πρώτῃ",711041,101],["εἰς",704105,0],["τὸ",709436,24],["πρωί",711021,28]],"Leaven shall not be seen with thee in all thy borders for seven days, and there shall not be left of the flesh which thou shalt sacrifice at even on the first day until the morning."],["5",[["οὐ",709805,28],["δυνήσῃ",703838,123],["θῦσαι",706349,106],["τὸ",709436,24],["πασχα",710182,25],["ἐν",704639,0],["οὐδεμιᾷ",709817,101],["τῶν",709436,130],["πόλεών",710612,65],["σου",711945,133],["ὧν",709781,199],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["δίδωσίν",703654,91],["σοι",711925,159]],"Thou shalt not have power to sacrifice the passover in any of the cities, which the Lord thy God gives thee."],["6",[["ἀλλ᾿",700680,7],["ἢ",705924,7],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["ὃν",709781,112],["ἐὰν",703912,7],["ἐκλέξηται",704236,239],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ἐπικληθῆναι",705153,179],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["ἐκεῖ",704181,28],["θύσεις",706349,166],["τὸ",709436,24],["πασχα",710182,25],["ἑσπέρας",705500,17],["πρὸς",710844,0],["δυσμὰς",703865,39],["ἡλίου",705974,18],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ᾧ",709781,309],["ἐξῆλθες",704909,162],["ἐξ",704132,0],["Αἰγύπτου",700401,17]],"But in the place which the Lord thy God shall choose, to have his name called there, thou shalt sacrifice the passover at even at the setting of the sun, at the time when thou camest out of Egypt."],["7",[["καὶ",707031,7],["ἑψήσεις",705788,166],["καὶ",707031,7],["ὀπτήσεις",709715,166],["καὶ",707031,7],["φάγῃ",713296,123],["ἐν",704639,0],["τῷ",709436,113],["τόπῳ",712903,114],["ᾧ",709781,309],["ἐὰν",703912,7],["ἐκλέξηται",704236,239],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["αὐτόν",702165,85],["καὶ",707031,7],["ἀποστραφήσῃ",701598,364],["τὸ",709436,24],["πρωὶ",711021,28],["καὶ",707031,7],["ἀπελεύσῃ",701398,123],["εἰς",704105,0],["τοὺς",709436,58],["οἴκους",709516,57],["σου",711945,133]],"And thou shalt boil and roast and eat it in the place, which the Lord thy God shall choose; and thou shalt return in the morning, and go to thy house."],["8",[["ἓξ",704828,59],["ἡμέρας",705984,39],["φάγῃ",713296,123],["ἄζυμα",700345,68],["καὶ",707031,7],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["ἑβδόμῃ",703925,101],["ἐξόδιον",704946,25],["ἑορτὴ",704990,12],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["σου",711945,133],["οὐ",709805,28],["ποιήσεις",710582,166],["ἐν",704639,0],["αὐτῇ",702165,105],["πᾶν",710177,46],["ἔργον",705396,25],["πλὴν",710540,28],["ὅσα",709788,195],["ποιηθήσεται",710582,134],["ψυχῇ",714070,1]],"Six days shalt thou eat unleavened bread, and on the seventh day is a holiday, a feast to the Lord thy God: thou shalt not do in it any work, save what must be done by any one."],["9",[["ἑπτὰ",705357,59],["ἑβδομάδας",703921,39],["ὁλοκλήρους",709591,119],["ἐξαριθμήσεις",704877,166],["σεαυτῷ",711599,50],["ἀρξαμένου",701860,292],["σου",711945,133],["δρέπανον",703830,25],["ἐπ᾿",705080,0],["ἀμητὸν",700819,6],["ἄρξῃ",701860,123],["ἐξαριθμῆσαι",704877,106],["ἑπτὰ",705357,59],["ἑβδομάδας",703921,39]],"Seven weeks shalt thou number to thyself; when thou hast begun [to put] the sickle to the corn, thou shalt begin to number seven weeks."],["10",[["καὶ",707031,7],["ποιήσεις",710582,166],["ἑορτὴν",704990,9],["ἑβδομάδων",703921,65],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["σου",711945,133],["καθότι",707021,28],["ἡ",709436,10],["χείρ",713787,12],["σου",711945,133],["ἰσχύει",706859,91],["ὅσα",709788,68],["ἂν",700900,11],["δῷ",703654,172],["σοι",711925,159],["καθότι",707021,28],["ηὐλόγησέν",705631,2],["σε",711598,163],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133]],"And thou shalt keep the feast of weeks to the Lord thy God, accordingly as thy hand has power in as many things as the Lord thy God shall give thee."],["11",[["καὶ",707031,7],["εὐφρανθήσῃ",705715,364],["ἐναντίον",704654,0],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133],["σὺ",712181,164],["καὶ",707031,7],["ὁ",709436,3],["υἱός",713075,4],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["θυγάτηρ",706320,12],["σου",711945,133],["ὁ",709436,3],["παῖς",709932,4],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["παιδίσκη",709928,12],["σου",711945,133],["καὶ",707031,7],["ὁ",709436,3],["Λευίτης",708160,4],["ὁ",709436,3],["ἐν",704639,0],["ταῖς",709436,75],["πόλεσίν",710612,76],["σου",711945,133],["καὶ",707031,7],["ὁ",709436,3],["προσήλυτος",710900,4],["καὶ",707031,7],["ὁ",709436,3],["ὀρφανὸς",709779,14],["καὶ",707031,7],["ἡ",709436,10],["χήρα",713848,12],["ἡ",709436,10],["ἐν",704639,0],["ὑμῖν",713084,90],["ἐν",704639,0],["τῷ",709436,113],["τόπῳ",712903,114],["ᾧ",709781,309],["ἐὰν",703912,7],["ἐκλέξηται",704236,239],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ἐπικληθῆναι",705153,179],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["ἐκεῖ",704181,28]],"And thou shalt rejoice before the Lord thy God, thou and thy son, and thy daughter, thy man-servant and thy maid-servant, and the Levite, and the stranger, and the orphan, and the widow which dwells among you, in whatsoever place the Lord thy God shall choose, that his name should be called there."],["12",[["καὶ",707031,7],["μνησθήσῃ",708923,364],["ὅτι",709803,7],["οἰκέτης",709496,4],["ἦσθα",704093,363],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτῳ",700401,1],["καὶ",707031,7],["φυλάξῃ",713619,123],["καὶ",707031,7],["ποιήσεις",710582,166],["τὰς",709436,38],["ἐντολὰς",704802,39],["ταύτας",709858,231]],"And thou shalt remember that thou wast a servant in the land of Egypt, and thou shalt observe and do these commands."],["13",[["ἑορτὴν",704990,9],["σκηνῶν",711845,65],["ποιήσεις",710582,166],["σεαυτῷ",711599,50],["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["ἐν",704639,0],["τῷ",709436,53],["συναγαγεῖν",712375,106],["σε",711598,163],["ἐκ",704132,0],["τοῦ",709436,35],["ἅλωνός",700741,18],["σου",711945,133],["καὶ",707031,7],["ἀπὸ",701425,0],["τῆς",709436,16],["ληνοῦ",708176,17],["σου",711945,133]],"Thou shalt keep for thyself the feast of tabernacles seven days, when thou gatherest in [thy produce] from thy corn-floor and thy wine-press."],["14",[["καὶ",707031,7],["εὐφρανθήσῃ",705715,364],["ἐν",704639,0],["τῇ",709436,100],["ἑορτῇ",704990,1],["σου",711945,133],["σὺ",712181,164],["καὶ",707031,7],["ὁ",709436,3],["υἱός",713075,4],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["θυγάτηρ",706320,12],["σου",711945,133],["ὁ",709436,3],["παῖς",709932,4],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["παιδίσκη",709928,12],["σου",711945,133],["καὶ",707031,7],["ὁ",709436,3],["Λευίτης",708160,4],["καὶ",707031,7],["ὁ",709436,3],["προσήλυτος",710900,4],["καὶ",707031,7],["ὁ",709436,3],["ὀρφανὸς",709779,14],["καὶ",707031,7],["ἡ",709436,10],["χήρα",713848,12],["ἡ",709436,10],["οὖσα",704093,188],["ἐν",704639,0],["ταῖς",709436,75],["πόλεσίν",710612,76],["σου",711945,133]],"And thou shalt rejoice in thy feast, thou, and thy son, and thy daughter, thy man-servant, and thy maid-servant, and the Levite, and the stranger, and the orphan, and the widow that is in thy cities."],["15",[["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["ἑορτάσεις",704988,166],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["σου",711945,133],["ἐν",704639,0],["τῷ",709436,113],["τόπῳ",712903,114],["ᾧ",709781,309],["ἐὰν",703912,7],["ἐκλέξηται",704236,239],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["αὐτῷ",702165,50],["ἐὰν",703912,7],["δὲ",703303,11],["εὐλογήσῃ",705631,172],["σε",711598,163],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ἐν",704639,0],["πᾶσιν",710177,94],["τοῖς",709436,95],["γενήμασίν",703052,96],["σου",711945,133],["καὶ",707031,7],["ἐν",704639,0],["παντὶ",710177,97],["ἔργῳ",705396,54],["τῶν",709436,130],["χειρῶν",713787,65],["σου",711945,133],["καὶ",707031,7],["ἔσῃ",704093,123],["εὐφραινόμενος",705715,122]],"Seven days shalt thou keep a feast to the Lord thy God in the place which the Lord thy God shall choose for himself; and if the Lord thy God shall bless thee in all thy fruits, and in every work of thy hands, then thou shalt rejoice."],["16",[["τρεῖς",712927,60],["καιροὺς",707047,57],["τοῦ",709436,35],["ἐνιαυτοῦ",704745,18],["ὀφθήσεται",709725,134],["πᾶν",710177,46],["ἀρσενικόν",701817,27],["σου",711945,133],["ἐναντίον",704654,0],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133],["ἐν",704639,0],["τῷ",709436,113],["τόπῳ",712903,114],["ᾧ",709781,309],["ἐὰν",703912,7],["ἐκλέξηται",704236,239],["αὐτὸν",702165,85],["κύριος",707996,4],["ἐν",704639,0],["τῇ",709436,100],["ἑορτῇ",704990,1],["τῶν",709436,80],["ἀζύμων",700345,169],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["ἑορτῇ",704990,1],["τῶν",709436,130],["ἑβδομάδων",703921,65],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["ἑορτῇ",704990,1],["τῆς",709436,16],["σκηνοπηγίας",711846,17],["οὐκ",709805,28],["ὀφθήσῃ",709725,364],["ἐνώπιον",704823,0],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133],["κενός",707612,14]],"Three times in the year shall all thy males appear before the Lord thy God in the place which the Lord shall choose in the feast of unleavened bread, and in the feast of weeks, and in the feast of tabernacles: thou shalt not appear before the Lord thy God empty."],["17",[["ἕκαστος",704133,14],["κατὰ",707200,0],["δύναμιν",703839,9],["τῶν",709436,130],["χειρῶν",713787,65],["ὑμῶν",713091,145],["κατὰ",707200,0],["τὴν",709436,8],["εὐλογίαν",705633,9],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133],["ἣν",709781,131],["ἔδωκέν",703654,2],["σοι",711925,159]],"Each one according to his ability, according to the blessing of the Lord thy God which he has given thee."],["18",[["κριτὰς",707910,57],["καὶ",707031,7],["γραμματοεισαγωγεῖς",703188,57],["καταστήσεις",707011,166],["σεαυτῷ",711599,50],["ἐν",704639,0],["πάσαις",710177,291],["ταῖς",709436,75],["πόλεσίν",710612,76],["σου",711945,133],["αἷς",709781,281],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["δίδωσίν",703654,91],["σοι",711925,159],["κατὰ",707200,0],["φυλάς",713620,39],["καὶ",707031,7],["κρινοῦσιν",707905,218],["τὸν",709436,5],["λαὸν",708094,6],["κρίσιν",707908,9],["δικαίαν",703694,36]],"Thou shalt make for thyself judges and officers in thy cities, which the Lord thy God gives thee in [thy] tribes, and they shall judge the people with righteous judgment:"],["19",[["οὐκ",709805,28],["ἐκκλινοῦσιν",704220,218],["κρίσιν",707908,9],["οὐκ",709805,28],["ἐπιγνώσονται",705104,135],["πρόσωπον",710986,25],["οὐδὲ",709816,7],["λήμψονται",708076,135],["δῶρον",703907,25],["τὰ",709436,41],["γὰρ",702963,11],["δῶρα",703907,42],["ἐκτυφλοῖ",704352,91],["ὀφθαλμοὺς",709870,57],["σοφῶν",711985,169],["καὶ",707031,7],["ἐξαίρει",704839,91],["λόγους",708236,57],["δικαίων",703694,169]],"they shall not wrest judgment, nor favour persons, nor receive a gift; for gifts blind the eyes of the wise, and pervert the words of the righteous."],["20",[["δικαίως",703698,28],["τὸ",709436,24],["δίκαιον",703694,46],["διώξῃ",703768,123],["ἵνα",706747,7],["ζῆτε",705851,355],["καὶ",707031,7],["εἰσελθόντες",704114,196],["κληρονομήσητε",707724,125],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["δίδωσίν",703654,91],["σοι",711925,159]],"Thou shalt justly pursue justice, that ye may live, and go in and inherit the land which the Lord thy God gives thee."],["21",[["οὐ",709805,28],["φυτεύσεις",713636,166],["σεαυτῷ",711599,50],["ἄλσος",700729,25],["πᾶν",710177,46],["ξύλον",709427,25],["παρὰ",709995,0],["τὸ",709436,24],["θυσιαστήριον",706348,25],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133],["ὃ",709781,33],["ποιήσεις",710582,166],["σεαυτῷ",711599,50]],"Thou shalt not plant for thyself a grove; thou shalt not plant for thyself any tree near the altar of thy God."],["22",[["οὐ",709805,28],["στήσεις",706846,166],["σεαυτῷ",711599,50],["στήλην",712092,9],["ἃ",709781,69],["ἐμίσησεν",708935,2],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133]],"Thou shalt not set up for thyself a pillar, which the Lord thy God hates."]]