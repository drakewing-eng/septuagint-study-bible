[["1",[["ἐὰν",703912,7],["δὲ",703303,11],["ἐξέλθῃς",704909,175],["εἰς",704105,0],["πόλεμον",710605,6],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἐχθρούς",705779,57],["σου",711945,133],["καὶ",707031,7],["ἴδῃς",709725,175],["ἵππον",706790,6],["καὶ",707031,7],["ἀναβάτην",700909,6],["καὶ",707031,7],["λαὸν",708094,6],["πλείονά",710646,27],["σου",711945,133],["οὐ",709805,28],["φοβηθήσῃ",713532,364],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["ὅτι",709803,7],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["μετὰ",708780,0],["σοῦ",711945,133],["ὁ",709436,3],["ἀναβιβάσας",700910,182],["σε",711598,163],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17]],"And if thou shouldest go forth to war against thine enemies, and shouldest see horse, and rider, and a people more numerous than thyself; thou shalt not be afraid of them, for the Lord thy God [is] with thee, who brought thee up out of the land of Egypt."],["2",[["καὶ",707031,7],["ἔσται",704093,93],["ὅταν",709801,28],["ἐγγίσῃς",703939,175],["τῷ",709436,113],["πολέμῳ",710605,114],["καὶ",707031,7],["προσεγγίσας",710878,182],["ὁ",709436,3],["ἱερεὺς",706614,4],["λαλήσει",708071,127],["τῷ",709436,113],["λαῷ",708094,114]],"And it shall come to pass whenever thou shalt draw nigh to battle, that the priest shall draw nigh and speak to the people, and shall say to them,"],["3",[["καὶ",707031,7],["ἐρεῖ",705415,127],["πρὸς",710844,0],["αὐτούς",702165,62],["ἄκουε",700587,240],["Ισραηλ",706839,153],["ὑμεῖς",713081,219],["προσπορεύεσθε",710954,374],["σήμερον",711751,28],["εἰς",704105,0],["πόλεμον",710605,6],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἐχθροὺς",705779,57],["ὑμῶν",713091,145],["μὴ",708851,28],["ἐκλυέσθω",704254,407],["ἡ",709436,10],["καρδία",707141,12],["ὑμῶν",713091,145],["μὴ",708851,28],["φοβεῖσθε",713532,73],["μηδὲ",708855,7],["θραύεσθε",706304,374],["μηδὲ",708855,7],["ἐκκλίνητε",704220,355],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτῶν",702165,40]],"Hear, O Israel; ye are going this day to battle against your enemies: let not your heart faint, fear not, neither be confounded, neither turn aside from their face."],["4",[["ὅτι",709803,7],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["ὁ",709436,3],["προπορευόμενος",710839,122],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["συνεκπολεμῆσαι",712439,106],["ὑμῖν",713084,90],["τοὺς",709436,58],["ἐχθροὺς",705779,57],["ὑμῶν",713091,145],["διασῶσαι",703599,106],["ὑμᾶς",713080,194]],"For [it is] the Lord your God who advances with you, to fight with you against your enemies, [and] to save you."],["5",[["καὶ",707031,7],["λαλήσουσιν",708071,218],["οἱ",709436,136],["γραμματεῖς",703185,52],["πρὸς",710844,0],["τὸν",709436,5],["λαὸν",708094,6],["λέγοντες",708124,146],["τίς",712867,158],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ὁ",709436,3],["οἰκοδομήσας",709509,182],["οἰκίαν",709505,9],["καινὴν",707042,36],["καὶ",707031,7],["οὐκ",709805,28],["ἐνεκαίνισεν",703956,2],["αὐτήν",702165,104],["πορευέσθω",710667,407],["καὶ",707031,7],["ἀποστραφήτω",701598,22],["εἰς",704105,0],["τὴν",709436,8],["οἰκίαν",709505,9],["αὐτοῦ",702165,102],["μὴ",708851,28],["ἀποθάνῃ",701461,172],["ἐν",704639,0],["τῷ",709436,113],["πολέμῳ",710605,114],["καὶ",707031,7],["ἄνθρωπος",701163,4],["ἕτερος",705535,14],["ἐγκαινιεῖ",703956,127],["αὐτήν",702165,104]],"And the scribes shall speak to the people, saying, What man [is] he that has built a new house, and has not dedicated it? let him go and return to his house, lest he die in the war, and another man dedicate it."],["6",[["καὶ",707031,7],["τίς",712867,158],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ὅστις",709793,425],["ἐφύτευσεν",713636,2],["ἀμπελῶνα",700872,6],["καὶ",707031,7],["οὐκ",709805,28],["εὐφράνθη",705715,37],["ἐξ",704132,0],["αὐτοῦ",702165,102],["πορευέσθω",710667,407],["καὶ",707031,7],["ἀποστραφήτω",701598,22],["εἰς",704105,0],["τὴν",709436,8],["οἰκίαν",709505,9],["αὐτοῦ",702165,102],["μὴ",708851,28],["ἀποθάνῃ",701461,172],["ἐν",704639,0],["τῷ",709436,113],["πολέμῳ",710605,114],["καὶ",707031,7],["ἄνθρωπος",701163,4],["ἕτερος",705535,14],["εὐφρανθήσεται",705715,134],["ἐξ",704132,0],["αὐτοῦ",702165,102]],"And what man [is] he that has planted a vineyard, and not been made merry with it? let him go and return to his house, lest he die in the battle, and another man be made merry with it."],["7",[["καὶ",707031,7],["τίς",712867,158],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ὅστις",709793,425],["μεμνήστευται",708970,187],["γυναῖκα",703209,9],["καὶ",707031,7],["οὐκ",709805,28],["ἔλαβεν",708076,2],["αὐτήν",702165,104],["πορευέσθω",710667,407],["καὶ",707031,7],["ἀποστραφήτω",701598,22],["εἰς",704105,0],["τὴν",709436,8],["οἰκίαν",709505,9],["αὐτοῦ",702165,102],["μὴ",708851,28],["ἀποθάνῃ",701461,172],["ἐν",704639,0],["τῷ",709436,113],["πολέμῳ",710605,114],["καὶ",707031,7],["ἄνθρωπος",701163,4],["ἕτερος",705535,14],["λήμψεται",708076,93],["αὐτήν",702165,104]],"And what man [is] he that has betrothed a wife, and has not taken her? let him go and return to his house, lest he die in the battle, and another man take her."],["8",[["καὶ",707031,7],["προσθήσουσιν",710965,218],["οἱ",709436,136],["γραμματεῖς",703185,52],["λαλῆσαι",708071,106],["πρὸς",710844,0],["τὸν",709436,5],["λαὸν",708094,6],["καὶ",707031,7],["ἐροῦσιν",705415,218],["τίς",712867,158],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ὁ",709436,3],["φοβούμενος",713532,122],["καὶ",707031,7],["δειλὸς",703324,14],["τῇ",709436,100],["καρδίᾳ",707141,1],["πορευέσθω",710667,407],["καὶ",707031,7],["ἀποστραφήτω",701598,22],["εἰς",704105,0],["τὴν",709436,8],["οἰκίαν",709505,9],["αὐτοῦ",702165,102],["ἵνα",706747,7],["μὴ",708851,28],["δειλιάνῃ",703320,204],["τὴν",709436,8],["καρδίαν",707141,9],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["αὐτοῦ",702165,102],["ὥσπερ",714163,28],["ἡ",709436,10],["αὐτοῦ",702165,102]],"And the scribes shall speak further to the people, and say, What man [is] he that fears and is cowardly in his heart? Let him go and return to his house, lest he make the heart of his brother fail, as his own."],["9",[["καὶ",707031,7],["ἔσται",704093,93],["ὅταν",709801,28],["παύσωνται",710202,232],["οἱ",709436,136],["γραμματεῖς",703185,52],["λαλοῦντες",708071,146],["πρὸς",710844,0],["τὸν",709436,5],["λαόν",708094,6],["καὶ",707031,7],["καταστήσουσιν",707011,218],["ἄρχοντας",701862,57],["τῆς",709436,16],["στρατιᾶς",712145,17],["προηγουμένους",710791,236],["τοῦ",709436,35],["λαοῦ",708094,18]],"And it shall come to pass when the scribes shall have ceased speaking to the people, that they shall appoint generals of the army to be leaders of the people."],["10",[["ἐὰν",703912,7],["δὲ",703303,11],["προσέλθῃς",710890,175],["πρὸς",710844,0],["πόλιν",710612,9],["ἐκπολεμῆσαι",704290,106],["αὐτήν",702165,104],["καὶ",707031,7],["ἐκκαλέσῃ",704207,172],["αὐτοὺς",702165,62],["μετ᾿",708780,0],["εἰρήνης",704098,17]],"And if thou shalt draw nigh to a city to overcome them by war, then call them out peaceably."],["11",[["ἐὰν",703912,7],["μὲν",708730,11],["εἰρηνικὰ",704099,68],["ἀποκριθῶσίν",701492,272],["σοι",711925,159],["καὶ",707031,7],["ἀνοίξωσίν",701186,234],["σοι",711925,159],["ἔσται",704093,93],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["οἱ",709436,136],["εὑρεθέντες",705676,247],["ἐν",704639,0],["αὐτῇ",702165,105],["ἔσονταί",704093,135],["σοι",711925,159],["φορολόγητοι",713557,138],["καὶ",707031,7],["ὑπήκοοί",713176,138],["σου",711945,133]],"If then they should answer peaceably to thee, and open to thee, it shall be that all the people found in it shall be tributary and subject to thee."],["12",[["ἐὰν",703912,7],["δὲ",703303,11],["μὴ",708851,28],["ὑπακούσωσίν",713096,234],["σοι",711925,159],["καὶ",707031,7],["ποιήσωσιν",710582,234],["πρὸς",710844,0],["σὲ",711598,163],["πόλεμον",710605,6],["περικαθιεῖς",710325,166],["αὐτήν",702165,104]],"But if they will not hearken to thee, but wage war against thee, thou shalt invest it;"],["13",[["καὶ",707031,7],["παραδώσει",710014,127],["αὐτὴν",702165,104],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["εἰς",704105,0],["τὰς",709436,38],["χεῖράς",713787,39],["σου",711945,133],["καὶ",707031,7],["πατάξεις",710185,166],["πᾶν",710177,27],["ἀρσενικὸν",701817,27],["αὐτῆς",702165,86],["ἐν",704639,0],["φόνῳ",713549,114],["μαχαίρας",708593,39]],"until the Lord thy God shall deliver it into thy hands, and thou shalt smite every male of it with the edge of the sword:"],["14",[["πλὴν",710540,28],["τῶν",709436,130],["γυναικῶν",703209,65],["καὶ",707031,7],["τῆς",709436,16],["ἀποσκευῆς",701573,17],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["κτήνη",707934,42],["καὶ",707031,7],["πάντα",710177,68],["ὅσα",709788,68],["ἂν",700900,11],["ὑπάρχῃ",713104,204],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["καὶ",707031,7],["πᾶσαν",710177,36],["τὴν",709436,8],["ἀπαρτίαν",701358,9],["προνομεύσεις",710826,166],["σεαυτῷ",711599,50],["καὶ",707031,7],["φάγῃ",713296,123],["πᾶσαν",710177,36],["τὴν",709436,8],["προνομὴν",710827,9],["τῶν",709436,80],["ἐχθρῶν",705779,81],["σου",711945,133],["ὧν",709781,252],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["δίδωσίν",703654,91],["σοι",711925,159]],"except the women and the stuff: and all the cattle, and whatsoever shall be in the city, and all the plunder thou shalt take as spoil for thyself, and shalt eat all the plunder of thine enemies whom the Lord thy God gives thee."],["15",[["οὕτως",709859,28],["ποιήσεις",710582,166],["πάσας",710177,119],["τὰς",709436,38],["πόλεις",710612,39],["τὰς",709436,38],["μακρὰν",708411,28],["οὔσας",704093,338],["ἀπὸ",701425,0],["σοῦ",711945,133],["σφόδρα",712586,28],["αἳ",709781,256],["οὐχὶ",709862,28],["ἐκ",704132,0],["τῶν",709436,130],["πόλεων",710612,65],["τῶν",709436,43],["ἐθνῶν",704068,44],["τούτων",709858,70]],"Thus shalt thou do to all the cities that are very far off from thee, not [being] of the cities of these nations which the Lord thy God gives thee to inherit their land."],["16",[["ἰδοὺ",706497,88],["δὲ",703303,11],["ἀπὸ",701425,0],["τῶν",709436,130],["πόλεων",710612,65],["τῶν",709436,43],["ἐθνῶν",704068,44],["τούτων",709858,70],["ὧν",709781,103],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["δίδωσίν",703654,91],["σοι",711925,159],["κληρονομεῖν",707724,55],["τὴν",709436,8],["γῆν",703083,9],["αὐτῶν",702165,70],["οὐ",709805,28],["ζωγρήσετε",705906,337],["ἀπ᾿",701425,0],["αὐτῶν",702165,70],["πᾶν",710177,46],["ἐμπνέον",704600,46]],"[Of these] ye shall not take any thing alive;"],["17",[["ἀλλ᾿",700680,7],["ἢ",705924,7],["ἀναθέματι",700950,54],["ἀναθεματιεῖτε",700951,337],["αὐτούς",702165,62],["τὸν",709436,5],["Χετταῖον",713838,6],["καὶ",707031,7],["Αμορραῖον",700865,6],["καὶ",707031,7],["Χαναναῖον",713711,6],["καὶ",707031,7],["Φερεζαῖον",713422,6],["καὶ",707031,7],["Ευαῖον",705549,6],["καὶ",707031,7],["Ιεβουσαῖον",706519,6],["καὶ",707031,7],["Γεργεσαῖον",703062,6],["ὃν",709781,112],["τρόπον",712980,6],["ἐνετείλατό",704791,23],["σοι",711925,159],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133]],"but ye shall surely curse them, the Chettite, and the Amorite, and the Chananite, and the Pherezite, and the Evite, and the Jebusite, and the Gergesite; as the Lord thy God commanded thee:"],["18",[["ἵνα",706747,7],["μὴ",708851,28],["διδάξωσιν",703649,234],["ὑμᾶς",713080,194],["ποιεῖν",710582,55],["πάντα",710177,46],["τὰ",709436,41],["βδελύγματα",702604,42],["αὐτῶν",702165,70],["ὅσα",709788,68],["ἐποίησαν",710582,150],["τοῖς",709436,147],["θεοῖς",706192,148],["αὐτῶν",702165,70],["καὶ",707031,7],["ἁμαρτήσεσθε",700773,124],["ἐναντίον",704654,0],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ὑμῶν",713091,145]],"that they may not teach you to do all their abominations, which they did to their gods, and [so] ye should sin before the Lord your God."],["19",[["ἐὰν",703912,7],["δὲ",703303,11],["περικαθίσῃς",710325,175],["περὶ",710285,0],["πόλιν",710612,9],["ἡμέρας",705984,39],["πλείους",710514,119],["ἐκπολεμῆσαι",704290,106],["αὐτὴν",702165,104],["εἰς",704105,0],["κατάλημψιν",707310,9],["αὐτῆς",702165,86],["οὐχὶ",709862,28],["ἐξολεθρεύσεις",704956,166],["τὰ",709436,41],["δένδρα",703353,42],["αὐτῆς",702165,86],["ἐπιβαλεῖν",705083,106],["ἐπ᾿",705080,0],["αὐτὰ",702165,71],["σίδηρον",711774,6],["ἀλλ᾿",700680,7],["ἢ",705924,7],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["φάγῃ",713296,123],["αὐτὸ",702165,129],["δὲ",703303,11],["οὐκ",709805,28],["ἐκκόψεις",704225,166],["μὴ",708851,28],["ἄνθρωπος",701163,4],["τὸ",709436,24],["ξύλον",709427,25],["τὸ",709436,24],["ἐν",704639,0],["τῷ",709436,113],["ἀγρῷ",700196,114],["εἰσελθεῖν",704114,106],["ἀπὸ",701425,0],["προσώπου",710986,21],["σου",711945,133],["εἰς",704105,0],["τὸν",709436,5],["χάρακα",713729,6]],"And if thou shouldest besiege a city many days to prevail against it by war to take it, thou shalt not destroy its trees, by applying an iron tool to them, but thou shalt eat of it, and shalt not cut it down: Is the tree that is in the field a man, to enter before thee into the work of the siege?"],["20",[["ἀλλὰ",700680,7],["ξύλον",709427,15],["ὃ",709781,33],["ἐπίστασαι",705264,259],["ὅτι",709803,7],["οὐ",709805,28],["καρπόβρωτόν",707168,6],["ἐστιν",704093,91],["τοῦτο",709858,132],["ἐξολεθρεύσεις",704956,166],["καὶ",707031,7],["ἐκκόψεις",704225,166],["καὶ",707031,7],["οἰκοδομήσεις",709509,166],["χαράκωσιν",713728,9],["ἐπὶ",705080,0],["τὴν",709436,8],["πόλιν",710612,9],["ἥτις",709793,412],["ποιεῖ",710582,91],["πρὸς",710844,0],["σὲ",711598,163],["τὸν",709436,5],["πόλεμον",710605,6],["ἕως",705792,7],["ἂν",700900,11],["παραδοθῇ",710014,384]],"But the tree which thou knowest to be not fruit-bearing, this thou shalt destroy and cut down; and thou shalt construct a mound against the city, which makes war against thee, until it be delivered up."]]