[["1",[["δι᾿",703417,0],["ἑπτὰ",705357,59],["ἐτῶν",705543,44],["ποιήσεις",710582,166],["ἄφεσιν",702199,9]],"Every seven years thou shalt make a release."],["2",[["καὶ",707031,7],["οὕτως",709859,28],["τὸ",709436,34],["πρόσταγμα",710959,15],["τῆς",709436,16],["ἀφέσεως",702199,17],["ἀφήσεις",702211,166],["πᾶν",710177,46],["χρέος",713942,25],["ἴδιον",706493,46],["ὃ",709781,128],["ὀφείλει",709865,91],["σοι",711925,159],["ὁ",709436,3],["πλησίον",710547,28],["καὶ",707031,7],["τὸν",709436,5],["ἀδελφόν",700249,6],["σου",711945,133],["οὐκ",709805,28],["ἀπαιτήσεις",701330,166],["ὅτι",709803,7],["ἐπικέκληται",705153,403],["ἄφεσις",702199,12],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["σου",711945,133]],"And this [is] the ordinance of the release: thou shalt remit every private debt which thy neighbour owes thee, and thou shalt not ask payment of it from thy brother; for it has been called a release to the Lord thy God."],["3",[["τὸν",709436,5],["ἀλλότριον",700699,27],["ἀπαιτήσεις",701330,166],["ὅσα",709788,195],["ἐὰν",703912,7],["ᾖ",704093,204],["σοι",711925,159],["παρ᾿",709995,0],["αὐτῷ",702165,50],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["σου",711945,133],["ἄφεσιν",702199,9],["ποιήσεις",710582,166],["τοῦ",709436,20],["χρέους",713942,21],["σου",711945,133]],"Of a stranger thou shalt ask again whatsoever he has of thine, but to thy brother thou shalt remit his debt to thee."],["4",[["ὅτι",709803,7],["οὐκ",709805,28],["ἔσται",704093,93],["ἐν",704639,0],["σοὶ",711925,159],["ἐνδεής",704671,14],["ὅτι",709803,7],["εὐλογῶν",705631,72],["εὐλογήσει",705631,127],["σε",711598,163],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ᾗ",709781,108],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["δίδωσίν",703654,91],["σοι",711925,159],["ἐν",704639,0],["κλήρῳ",707727,114],["κατακληρονομῆσαι",707274,106],["αὐτήν",702165,104]],"For [thus] there shall not be a poor person in the midst of thee, for the Lord thy God will surely bless thee in the land which the Lord thy God gives thee by inheritance, that thou shouldest inherit it."],["5",[["ἐὰν",703912,7],["δὲ",703303,11],["ἀκοῇ",700561,1],["εἰσακούσητε",704108,125],["τῆς",709436,16],["φωνῆς",713640,17],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ὑμῶν",713091,145],["φυλάσσειν",713619,55],["καὶ",707031,7],["ποιεῖν",710582,55],["πάσας",710177,119],["τὰς",709436,38],["ἐντολὰς",704802,39],["ταύτας",709858,231],["ὅσας",709788,119],["ἐγὼ",704018,164],["ἐντέλλομαί",704791,254],["σοι",711925,159],["σήμερον",711751,28]],"And if ye shall indeed hearken to the voice of the Lord your God, to keep and do all these commandments, as many as I charge thee this day,"],["6",[["ὅτι",709803,7],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["εὐλόγησέν",705631,2],["σε",711598,163],["ὃν",709781,112],["τρόπον",712980,6],["ἐλάλησέν",708071,2],["σοι",711925,159],["καὶ",707031,7],["δανιεῖς",703277,166],["ἔθνεσιν",704068,96],["πολλοῖς",710646,94],["σὺ",712181,164],["δὲ",703303,11],["οὐ",709805,28],["δανιῇ",703277,123],["καὶ",707031,7],["ἄρξεις",701860,166],["σὺ",712181,164],["ἐθνῶν",704068,44],["πολλῶν",710646,83],["σοῦ",711945,133],["δὲ",703303,11],["οὐκ",709805,28],["ἄρξουσιν",701860,218]],"(for the Lord thy God has blessed thee in the way of which he spoke to thee,) then thou shalt lend to many nations, but thou shalt not borrow; and thou shalt rule over many nations, but they shall not rule over thee."],["7",[["ἐὰν",703912,7],["δὲ",703303,11],["γένηται",703104,239],["ἐν",704639,0],["σοὶ",711925,159],["ἐνδεὴς",704671,14],["τῶν",709436,80],["ἀδελφῶν",700249,81],["σου",711945,133],["ἐν",704639,0],["μιᾷ",704106,101],["τῶν",709436,130],["πόλεων",710612,65],["σου",711945,133],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ᾗ",709781,108],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["δίδωσίν",703654,91],["σοι",711925,159],["οὐκ",709805,28],["ἀποστέρξεις",701594,166],["τὴν",709436,8],["καρδίαν",707141,9],["σου",711945,133],["οὐδ᾿",709816,7],["οὐ",709805,28],["μὴ",708851,28],["συσφίγξῃς",712564,175],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133],["ἀπὸ",701425,0],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["σου",711945,133],["τοῦ",709436,35],["ἐπιδεομένου",705118,262]],"And if there shall be in the midst of thee a poor [man] of thy brethren in one of thy cities in the land, which the Lord thy God gives thee, thou shalt not harden thine heart, neither shalt thou by any means close up thine hand from thy brother who is in want."],["8",[["ἀνοίγων",701186,72],["ἀνοίξεις",701186,166],["τὰς",709436,38],["χεῖράς",713787,39],["σου",711945,133],["αὐτῷ",702165,50],["δάνειον",703278,25],["δανιεῖς",703277,166],["αὐτῷ",702165,50],["ὅσον",709788,46],["ἐπιδέεται",705118,117],["καθ᾿",707200,0],["ὅσον",709788,46],["ἐνδεεῖται",704685,93]],"Thou shalt surely open thine hands to him, and shalt lend to him as much as he wants according to his need."],["9",[["πρόσεχε",710895,240],["σεαυτῷ",711599,50],["μὴ",708851,28],["γένηται",703104,239],["ῥῆμα",711246,15],["κρυπτὸν",707922,27],["ἐν",704639,0],["τῇ",709436,100],["καρδίᾳ",707141,1],["σου",711945,133],["ἀνόμημα",701191,15],["λέγων",708124,72],["ἐγγίζει",703939,91],["τὸ",709436,34],["ἔτος",705543,15],["τὸ",709436,34],["ἕβδομον",703925,26],["ἔτος",705543,15],["τῆς",709436,16],["ἀφέσεως",702199,17],["καὶ",707031,7],["πονηρεύσηται",710657,239],["ὁ",709436,3],["ὀφθαλμός",709870,4],["σου",711945,133],["τῷ",709436,113],["ἀδελφῷ",700249,114],["σου",711945,133],["τῷ",709436,113],["ἐπιδεομένῳ",705118,241],["καὶ",707031,7],["οὐ",709805,28],["δώσεις",703654,166],["αὐτῷ",702165,50],["καὶ",707031,7],["βοήσεται",702743,93],["κατὰ",707200,0],["σοῦ",711945,133],["πρὸς",710844,0],["κύριον",707996,6],["καὶ",707031,7],["ἔσται",704093,93],["ἐν",704639,0],["σοὶ",711925,159],["ἁμαρτία",700775,12],["μεγάλη",708653,29]],"Take heed to thyself that there be not a secret thing in thine heart, an iniquity, saying, The seventh year, the year of release, draws nigh; and thine eye shall be evil to thy brother that is in want, and thou shalt not give to him, and he shall cry against thee to the Lord, and there shall be great sin in thee."],["10",[["διδοὺς",703654,72],["δώσεις",703654,166],["αὐτῷ",702165,50],["καὶ",707031,7],["δάνειον",703278,25],["δανιεῖς",703277,166],["αὐτῷ",702165,50],["ὅσον",709788,46],["ἐπιδέεται",705118,117],["καὶ",707031,7],["οὐ",709805,28],["λυπηθήσῃ",708272,364],["τῇ",709436,100],["καρδίᾳ",707141,1],["σου",711945,133],["διδόντος",703654,152],["σου",711945,133],["αὐτῷ",702165,50],["ὅτι",709803,7],["διὰ",703417,0],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["εὐλογήσει",705631,127],["σε",711598,163],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ἐν",704639,0],["πᾶσιν",710177,94],["τοῖς",709436,95],["ἔργοις",705396,96],["καὶ",707031,7],["ἐν",704639,0],["πᾶσιν",710177,94],["οὗ",709806,28],["ἂν",700900,11],["ἐπιβάλῃς",705083,175],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133]],"Thou shalt surely give to him, and thou shalt lend him as much as he wants, according as he is in need; and thou shalt not grudge in thine heart as thou givest to him, because on this account the Lord thy God will bless thee in all thy works, and in all things on which thou shalt lay thine hand."],["11",[["οὐ",709805,28],["γὰρ",702963,11],["μὴ",708851,28],["ἐκλίπῃ",704237,172],["ἐνδεὴς",704671,14],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["διὰ",703417,0],["τοῦτο",709858,129],["ἐγώ",704018,164],["σοι",711925,159],["ἐντέλλομαι",704791,254],["ποιεῖν",710582,55],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["λέγων",708124,72],["ἀνοίγων",701186,72],["ἀνοίξεις",701186,166],["τὰς",709436,38],["χεῖράς",713787,39],["σου",711945,133],["τῷ",709436,113],["ἀδελφῷ",700249,114],["σου",711945,133],["τῷ",709436,113],["πένητι",710248,114],["καὶ",707031,7],["τῷ",709436,113],["ἐπιδεομένῳ",705118,241],["τῷ",709436,113],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["σου",711945,133]],"For the poor shall not fail off thy land, therefore I charge thee to do this thing, saying, Thou shalt surely open thine hands to thy poor brother, and to him that is distressed upon thy land."],["12",[["ἐὰν",703912,7],["δὲ",703303,11],["πραθῇ",710480,384],["σοι",711925,159],["ὁ",709436,3],["ἀδελφός",700249,4],["σου",711945,133],["ὁ",709436,3],["Εβραῖος",703933,14],["ἢ",705924,7],["ἡ",709436,10],["Εβραία",703933,29],["δουλεύσει",703814,127],["σοι",711925,159],["ἓξ",704828,59],["ἔτη",705543,42],["καὶ",707031,7],["τῷ",709436,53],["ἑβδόμῳ",703925,97],["ἐξαποστελεῖς",704872,166],["αὐτὸν",702165,85],["ἐλεύθερον",704428,27],["ἀπὸ",701425,0],["σοῦ",711945,133]],"And if thy brother [or sister], a Hebrew man or a Hebrew woman, be sold to thee, he shall serve thee six years, and in the seventh year thou shalt send him out free from thee."],["13",[["ὅταν",709801,28],["δὲ",703303,11],["ἐξαποστέλλῃς",704872,205],["αὐτὸν",702165,85],["ἐλεύθερον",704428,27],["ἀπὸ",701425,0],["σοῦ",711945,133],["οὐκ",709805,28],["ἐξαποστελεῖς",704872,166],["αὐτὸν",702165,85],["κενόν",707612,27]],"And when thou shalt send him out free from thee, thou shalt not send him out empty."],["14",[["ἐφόδιον",705759,25],["ἐφοδιάσεις",705758,166],["αὐτὸν",702165,85],["ἀπὸ",701425,0],["τῶν",709436,43],["προβάτων",710768,44],["σου",711945,133],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,35],["σίτου",711814,18],["σου",711945,133],["καὶ",707031,7],["ἀπὸ",701425,0],["τῆς",709436,16],["ληνοῦ",708176,17],["σου",711945,133],["καθὰ",706979,28],["εὐλόγησέν",705631,2],["σε",711598,163],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["δώσεις",703654,166],["αὐτῷ",702165,50]],"Thou shalt give him provision for the way from thy flock, and from thy corn, and from thy wine; as the Lord thy God has blessed thee, thou shalt give to him."],["15",[["καὶ",707031,7],["μνησθήσῃ",708923,364],["ὅτι",709803,7],["οἰκέτης",709496,4],["ἦσθα",704093,363],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ἐλυτρώσατό",708282,23],["σε",711598,163],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ἐκεῖθεν",704182,28],["διὰ",703417,0],["τοῦτο",709858,129],["ἐγώ",704018,164],["σοι",711925,159],["ἐντέλλομαι",704791,254],["ποιεῖν",710582,55],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129]],"And thou shalt remember that thou wast a servant in the land of Egypt, and the Lord thy God redeemed thee from thence; therefore I charge thee to do this thing."],["16",[["ἐὰν",703912,7],["δὲ",703303,11],["λέγῃ",708124,204],["πρὸς",710844,0],["σέ",711598,163],["οὐκ",709805,28],["ἐξελεύσομαι",704909,181],["ἀπὸ",701425,0],["σοῦ",711945,133],["ὅτι",709803,7],["ἠγάπηκέν",700120,171],["σε",711598,163],["καὶ",707031,7],["τὴν",709436,8],["οἰκίαν",709505,9],["σου",711945,133],["ὅτι",709803,7],["εὖ",705544,28],["αὐτῷ",702165,50],["ἐστιν",704093,91],["παρὰ",709995,0],["σοί",711925,159]],"And if he should say to thee, I will not go out from thee, because he continues to love thee and thy house, because he is well with thee;"],["17",[["καὶ",707031,7],["λήμψῃ",708076,123],["τὸ",709436,24],["ὀπήτιον",709690,25],["καὶ",707031,7],["τρυπήσεις",713002,166],["τὸ",709436,24],["ὠτίον",714165,25],["αὐτοῦ",702165,102],["πρὸς",710844,0],["τὴν",709436,8],["θύραν",706337,9],["καὶ",707031,7],["ἔσται",704093,93],["σοι",711925,159],["οἰκέτης",709496,4],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["τὴν",709436,8],["παιδίσκην",709928,9],["σου",711945,133],["ποιήσεις",710582,166],["ὡσαύτως",714158,28]],"then thou shalt take an awl, and bore his ear through to the door, and he shall be thy servant for ever; and in like manner shalt thou do to thy maid-servant."],["18",[["οὐ",709805,28],["σκληρὸν",711861,26],["ἔσται",704093,93],["ἐναντίον",704654,0],["σου",711945,133],["ἐξαποστελλομένων",704872,299],["αὐτῶν",702165,40],["ἐλευθέρων",704428,169],["ἀπὸ",701425,0],["σοῦ",711945,133],["ὅτι",709803,7],["ἐφέτιον",705748,27],["μισθὸν",708939,6],["τοῦ",709436,35],["μισθωτοῦ",708942,116],["ἐδούλευσέν",703814,2],["σοι",711925,159],["ἓξ",704828,59],["ἔτη",705543,42],["καὶ",707031,7],["εὐλογήσει",705631,127],["σε",711598,163],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ἐν",704639,0],["πᾶσιν",710177,230],["οἷς",709781,311],["ἐὰν",703912,7],["ποιῇς",710582,205]],"It shall not seem hard to thee when they are sent out free from thee, because [thy servant] has served thee six years according to the annual hire of a hireling; so the Lord thy God shall bless thee in all things whatsoever thou mayest do."],["19",[["πᾶν",710177,26],["πρωτότοκον",711046,26],["ὃ",709781,33],["ἐὰν",703912,7],["τεχθῇ",712853,384],["ἐν",704639,0],["τοῖς",709436,147],["βουσίν",702798,148],["σου",711945,133],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["προβάτοις",710768,96],["σου",711945,133],["τὰ",709436,41],["ἀρσενικά",701817,68],["ἁγιάσεις",700153,166],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["σου",711945,133],["οὐκ",709805,28],["ἐργᾷ",705383,123],["ἐν",704639,0],["τῷ",709436,113],["πρωτοτόκῳ",711046,30],["μόσχῳ",709029,114],["σου",711945,133],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["κείρῃς",707597,175],["τὸ",709436,24],["πρωτότοκον",711046,46],["τῶν",709436,43],["προβάτων",710768,44],["σου",711945,133]],"Every first-born that shall be born among thy kine and thy sheep, thou shalt sanctify the males to the Lord thy God; thou shalt not work with thy first-born calf, and thou shalt not shear the first-born of thy sheep."],["20",[["ἔναντι",704653,0],["κυρίου",707996,18],["φάγῃ",713296,123],["αὐτὸ",702165,129],["ἐνιαυτὸν",704745,6],["ἐξ",704132,0],["ἐνιαυτοῦ",704745,18],["ἐν",704639,0],["τῷ",709436,113],["τόπῳ",712903,114],["ᾧ",709781,309],["ἐὰν",703912,7],["ἐκλέξηται",704236,239],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["σὺ",712181,164],["καὶ",707031,7],["ὁ",709436,3],["οἶκός",709516,4],["σου",711945,133]],"Thou shalt eat it before the Lord year by year in the place which the Lord thy God shall choose, thou and thy house."],["21",[["ἐὰν",703912,7],["δὲ",703303,11],["ᾖ",704093,204],["ἐν",704639,0],["αὐτῷ",702165,280],["μῶμος",709102,4],["χωλὸν",713999,26],["ἢ",705924,7],["τυφλὸν",713031,26],["ἢ",705924,7],["καὶ",707031,7],["πᾶς",710177,14],["μῶμος",709102,4],["πονηρός",710660,14],["οὐ",709805,28],["θύσεις",706349,166],["αὐτὸ",702165,129],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["σου",711945,133]],"And if there be in it a blemish, if it be lame or blind, an evil blemish, thou shalt not sacrifice it to the Lord thy God."],["22",[["ἐν",704639,0],["ταῖς",709436,75],["πόλεσίν",710612,76],["σου",711945,133],["φάγῃ",713296,123],["αὐτό",702165,129],["ὁ",709436,3],["ἀκάθαρτος",700508,14],["ἐν",704639,0],["σοὶ",711925,159],["καὶ",707031,7],["ὁ",709436,3],["καθαρὸς",706988,14],["ὡσαύτως",714158,28],["ἔδεται",705495,93],["ὡς",714148,7],["δορκάδα",703801,9],["ἢ",705924,7],["ἔλαφον",704398,6]],"Thou shalt eat it in thy cities; the unclean in thee and the clean shall eat it in like manner, as the doe or the stag."],["23",[["πλὴν",710540,28],["τὸ",709436,24],["αἷμα",700442,25],["οὐ",709805,28],["φάγεσθε",705495,124],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["ἐκχεεῖς",704368,166],["αὐτὸ",702165,129],["ὡς",714148,7],["ὕδωρ",713071,25]],"Only ye shall not eat the blood; thou shalt pour it out on the earth as water."]]