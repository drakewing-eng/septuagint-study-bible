[["1",[["πορευθῶμεν",710667,283],["καὶ",707031,7],["ἐπιστρέψωμεν",705278,79],["πρὸς",710844,0],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["ἡμῶν",705999,145],["ὅτι",709803,7],["αὐτὸς",702165,121],["ἥρπακεν",701804,171],["καὶ",707031,7],["ἰάσεται",706424,93],["ἡμᾶς",705981,194],["πατάξει",710185,127],["καὶ",707031,7],["μοτώσει",709031,127],["ἡμᾶς",705981,194]],"Let us go, and return to the Lord our God; for he has torn, and will heal us; he will smite, and bind us up."],["2",[["ὑγιάσει",713056,127],["ἡμᾶς",705981,194],["μετὰ",708780,0],["δύο",703849,59],["ἡμέρας",705984,39],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["τρίτῃ",712968,101],["ἀναστησόμεθα",701173,141],["καὶ",707031,7],["ζησόμεθα",705851,141],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102]],"After two days he will heal us: in the third day we shall arise, and live before him, and shall know [him]:"],["3",[["καὶ",707031,7],["γνωσόμεθα",703105,141],["διώξομεν",703768,275],["τοῦ",709436,20],["γνῶναι",703105,106],["τὸν",709436,5],["κύριον",707996,6],["ὡς",714148,7],["ὄρθρον",709745,6],["ἕτοιμον",705541,27],["εὑρήσομεν",705676,275],["αὐτόν",702165,85],["καὶ",707031,7],["ἥξει",705956,127],["ὡς",714148,7],["ὑετὸς",713074,4],["ἡμῖν",705994,90],["πρόιμος",711023,14],["καὶ",707031,7],["ὄψιμος",709899,14],["τῇ",709436,100],["γῇ",703083,1]],"let us follow on to know the Lord: we shall find him ready as the morning, and he will come to us as the early and latter rain to the earth."],["4",[["τί",712867,126],["σοι",711925,159],["ποιήσω",710582,165],["Εφραιμ",705769,153],["τί",712867,126],["σοι",711925,159],["ποιήσω",710582,165],["Ιουδα",706768,153],["τὸ",709436,34],["δὲ",703303,11],["ἔλεος",704426,15],["ὑμῶν",713091,145],["ὡς",714148,7],["νεφέλη",709277,12],["πρωινὴ",711024,29],["καὶ",707031,7],["ὡς",714148,7],["δρόσος",703835,12],["ὀρθρινὴ",709743,29],["πορευομένη",710667,211]],"What shall I do unto thee, Ephraim? What shall I do to thee, Juda? whereas your mercy is as a morning cloud, and as the early dew that goes away."],["5",[["διὰ",703417,0],["τοῦτο",709858,129],["ἀπεθέρισα",701457,155],["τοὺς",709436,58],["προφήτας",711009,57],["ὑμῶν",713091,145],["ἀπέκτεινα",701498,155],["αὐτοὺς",702165,62],["ἐν",704639,0],["ῥήμασιν",711246,96],["στόματός",712125,21],["μου",709032,133],["καὶ",707031,7],["τὸ",709436,34],["κρίμα",707903,15],["μου",709032,133],["ὡς",714148,7],["φῶς",713642,15],["ἐξελεύσεται",704909,93]],"Therefore have I mown down your prophets; I have slain them with the word of my mouth: and my judgment shall go forth as the light."],["6",[["διότι",703734,7],["ἔλεος",704426,25],["θέλω",706176,157],["καὶ",707031,7],["οὐ",709805,28],["θυσίαν",706345,9],["καὶ",707031,7],["ἐπίγνωσιν",705107,9],["θεοῦ",706192,18],["ἢ",705924,7],["ὁλοκαυτώματα",709589,42]],"For I will [have] mercy rather than sacrifice, and the knowledge of God rather than whole-burnt-offerings."],["7",[["αὐτοὶ",702165,201],["δέ",703303,11],["εἰσιν",704093,197],["ὡς",714148,7],["ἄνθρωπος",701163,4],["παραβαίνων",709996,72],["διαθήκην",703456,9],["ἐκεῖ",704181,28],["κατεφρόνησέν",707482,2],["μου",709032,133]],"But they are as a man transgressing a covenant:"],["8",[["Γαλααδ",702920,4],["πόλις",710612,12],["ἐργαζομένη",705383,211],["μάταια",708575,68],["ταράσσουσα",712721,188],["ὕδωρ",713071,25]],"there the city Galaad despised me, working vanity, troubling water."],["9",[["καὶ",707031,7],["ἡ",709436,10],["ἰσχύς",706858,12],["σου",711945,133],["ἀνδρὸς",701150,18],["πειρατοῦ",710229,18],["ἔκρυψαν",707923,150],["ἱερεῖς",706614,52],["ὁδὸν",709458,9],["κυρίου",707996,18],["ἐφόνευσαν",713546,150],["Σικιμα",711783,227],["ὅτι",709803,7],["ἀνομίαν",701192,9],["ἐποίησαν",710582,150]],"And thy strength [is that] of a robber: the priests have hid the way, they have murdered [the people of] Sicima; for they have wrought iniquity in the house of Israel."],["10",[["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["Ισραηλ",706839,18],["εἶδον",709725,155],["φρικώδη",713583,36],["ἐκεῖ",704181,28],["πορνείαν",710672,9],["τοῦ",709436,35],["Εφραιμ",705769,18],["ἐμιάνθη",708900,37],["Ισραηλ",706839,4],["καὶ",707031,7],["Ιουδα",706768,4]],"I have seen horrible [things] there, [even] the fornication of Ephraim: Israel and Juda are defiled;"],["11",[["ἄρχου",701860,253],["τρυγᾶν",712996,55],["σεαυτῷ",711599,50],["ἐν",704639,0],["τῷ",709436,53],["ἐπιστρέφειν",705278,55],["με",708618,163],["τὴν",709436,8],["αἰχμαλωσίαν",700499,9],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133]],"begin to gather grapes for thyself, when I turn the captivity of my people."]]