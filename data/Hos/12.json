[["1",[["ἐκύκλωσέν",707958,2],["με",708618,163],["ἐν",704639,0],["ψεύδει",714044,54],["Εφραιμ",705769,4],["καὶ",707031,7],["ἐν",704639,0],["ἀσεβείαις",701904,76],["οἶκος",709516,4],["Ισραηλ",706839,18],["καὶ",707031,7],["Ιουδα",706768,18],["νῦν",709384,28],["ἔγνω",703105,2],["αὐτοὺς",702165,62],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["λαὸς",708094,4],["ἅγιος",700159,14],["κεκλήσεται",707084,134],["θεοῦ",706192,18]],"Ephraim has compassed me with falsehood, and the house of Israel and Juda with ungodliness: [but] now God knows them, and they shall be called God's holy people."],["2",[["ὁ",709436,3],["δὲ",703303,11],["Εφραιμ",705769,4],["πονηρὸν",710660,46],["πνεῦμα",710566,25],["ἐδίωξεν",703768,2],["καύσωνα",707567,6],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["κενὰ",707612,68],["καὶ",707031,7],["μάταια",708575,68],["ἐπλήθυνεν",710530,13],["καὶ",707031,7],["διαθήκην",703456,9],["μετὰ",708780,0],["Ἀσσυρίων",702004,81],["διέθετο",703609,23],["καὶ",707031,7],["ἔλαιον",704380,25],["εἰς",704105,0],["Αἴγυπτον",700401,9],["ἐνεπορεύετο",704611,19]],"But Ephraim is an evil spirit, he has chased the east wind all the day: he has multiplied empty and vain things, and made a covenant with the Assyrians, and oil has gone in the way of traffic into Egypt."],["3",[["καὶ",707031,7],["κρίσις",707908,12],["τῷ",709436,113],["κυρίῳ",707996,114],["πρὸς",710844,0],["Ιουδαν",706775,6],["τοῦ",709436,20],["ἐκδικῆσαι",704174,106],["τὸν",709436,5],["Ιακωβ",706401,6],["κατὰ",707200,0],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["κατὰ",707200,0],["τὰ",709436,41],["ἐπιτηδεύματα",705301,42],["αὐτοῦ",702165,102],["ἀνταποδώσει",701215,127],["αὐτῷ",702165,50]],"And the Lord [has] a controversy with Juda, in order to punish Jacob: according to his ways and according to his practices will he recompense him."],["4",[["ἐν",704639,0],["τῇ",709436,100],["κοιλίᾳ",707761,1],["ἐπτέρνισεν",711052,2],["τὸν",709436,5],["ἀδελφὸν",700249,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["κόποις",707825,148],["αὐτοῦ",702165,102],["ἐνίσχυσεν",704750,2],["πρὸς",710844,0],["θεὸν",706192,6]],"He took his brother by the heel in the womb, and in his labours he had power with God."],["5",[["καὶ",707031,7],["ἐνίσχυσεν",704750,2],["μετὰ",708780,0],["ἀγγέλου",700140,18],["καὶ",707031,7],["ἠδυνάσθη",703838,37],["ἔκλαυσαν",707703,150],["καὶ",707031,7],["ἐδεήθησάν",703394,99],["μου",709032,133],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["Ων",714118,118],["εὕροσάν",705676,150],["με",708618,163],["καὶ",707031,7],["ἐκεῖ",704181,28],["ἐλαλήθη",708071,37],["πρὸς",710844,0],["αὐτόν",702165,85]],"And he prevailed with the angel and was strong: they wept, and intreated me: they found me in the house of On, and there [a word] was spoken to them."],["6",[["ὁ",709436,3],["δὲ",703303,11],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["παντοκράτωρ",709986,4],["ἔσται",704093,93],["μνημόσυνον",708966,15],["αὐτοῦ",702165,102]],"But the Lord God Almighty shall be his memorial."],["7",[["καὶ",707031,7],["σὺ",712181,164],["ἐν",704639,0],["θεῷ",706192,114],["σου",711945,133],["ἐπιστρέψεις",705278,166],["ἔλεον",704426,25],["καὶ",707031,7],["κρίμα",707903,25],["φυλάσσου",713619,253],["καὶ",707031,7],["ἔγγιζε",703939,240],["πρὸς",710844,0],["τὸν",709436,5],["θεόν",706192,6],["σου",711945,133],["διὰ",703417,0],["παντός",710177,116]],"Thou therefore shalt return to thy God: keep thou mercy and judgment, and draw nigh to thy God continually."],["8",[["Χανααν",713708,120],["ἐν",704639,0],["χειρὶ",713787,1],["αὐτοῦ",702165,102],["ζυγὸς",705894,4],["ἀδικίας",700271,17],["καταδυναστεύειν",707248,55],["ἠγάπησε",700120,2]],"[As for] Chanaan, in his hand is a balance of unrighteousness: he has loved to tyrannise."],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["Εφραιμ",705769,4],["πλὴν",710540,28],["πεπλούτηκα",710561,89],["εὕρηκα",705676,89],["ἀναψυχὴν",701094,9],["ἐμαυτῷ",704545,50],["πάντες",710177,138],["οἱ",709436,136],["πόνοι",710661,52],["αὐτοῦ",702165,102],["οὐχ",709805,28],["εὑρεθήσονται",705676,144],["αὐτῷ",702165,50],["δι᾿",703417,0],["ἀδικίας",700271,39],["ἃς",709781,193],["ἥμαρτεν",700773,2]],"And Ephraim said, Nevertheless I am rich, I have found refreshment to myself. None of his labours shall be found [available] to him, by reason of the sins which he has committed."],["10",[["ἐγὼ",704018,164],["δὲ",703303,11],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ἀνήγαγόν",700933,155],["σε",711598,163],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["ἔτι",705538,28],["κατοικιῶ",707538,165],["σε",711598,163],["ἐν",704639,0],["σκηναῖς",711845,76],["καθὼς",707030,28],["ἡμέρᾳ",705984,1],["ἑορτῆς",704990,17]],"But I the Lord thy God brought thee up out of the land of Egypt: I will yet cause thee to dwell in tabernacles, according to the days of the feast."],["11",[["καὶ",707031,7],["λαλήσω",708071,165],["πρὸς",710844,0],["προφήτας",711009,57],["καὶ",707031,7],["ἐγὼ",704018,164],["ὁράσεις",709721,39],["ἐπλήθυνα",710530,155],["καὶ",707031,7],["ἐν",704639,0],["χερσὶν",713787,76],["προφητῶν",711009,81],["ὡμοιώθην",709628,156]],"And I will speak to the prophets, and I have multiplied visions, and by the means of the prophets I was represented."],["12",[["εἰ",704071,7],["μὴ",708851,28],["Γαλααδ",702920,120],["ἔστιν",704093,91],["ἄρα",701666,11],["ψευδεῖς",714036,138],["ἦσαν",704093,137],["ἐν",704639,0],["Γαλγαλ",702932,111],["ἄρχοντες",701862,52],["θυσιάζοντες",706346,146],["καὶ",707031,7],["τὰ",709436,63],["θυσιαστήρια",706348,64],["αὐτῶν",702165,40],["ὡς",714148,7],["χελῶναι",713822,191],["ἐπὶ",705080,0],["χέρσον",713834,9],["ἀγροῦ",700196,18]],"If Galaad exists not, then the chiefs in Galaad when they sacrificed were false, and their altars were as heaps on the ground of the field."],["13",[["καὶ",707031,7],["ἀνεχώρησεν",701092,2],["Ιακωβ",706401,4],["εἰς",704105,0],["πεδίον",710215,25],["Συρίας",712533,118],["καὶ",707031,7],["ἐδούλευσεν",703814,2],["Ισραηλ",706839,4],["ἐν",704639,0],["γυναικὶ",703209,1],["καὶ",707031,7],["ἐν",704639,0],["γυναικὶ",703209,1],["ἐφυλάξατο",713619,23]],"And Jacob retreated into the plain of Syria, and Israel served for a wife, and waited for a wife."],["14",[["καὶ",707031,7],["ἐν",704639,0],["προφήτῃ",711009,114],["ἀνήγαγεν",700933,2],["κύριος",707996,4],["τὸν",709436,5],["Ισραηλ",706839,6],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ἐν",704639,0],["προφήτῃ",711009,114],["διεφυλάχθη",703632,37]],"And the Lord brought Israel out of the land of Egypt by a prophet, and by a prophet was he preserved."],["15",[["ἐθύμωσεν",706335,2],["Εφραιμ",705769,4],["καὶ",707031,7],["παρώργισεν",710167,2],["καὶ",707031,7],["τὸ",709436,34],["αἷμα",700442,15],["αὐτοῦ",702165,102],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["ἐκχυθήσεται",704368,134],["καὶ",707031,7],["τὸν",709436,5],["ὀνειδισμὸν",709657,6],["αὐτοῦ",702165,102],["ἀνταποδώσει",701215,127],["αὐτῷ",702165,50],["κύριος",707996,4]],"Ephraim was angry and excited, therefore his blood shall be poured out upon him, and the Lord shall recompense to him his reproach."]]