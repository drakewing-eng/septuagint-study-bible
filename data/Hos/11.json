[["1",[["διότι",703734,7],["νήπιος",709295,14],["Ισραηλ",706839,4],["καὶ",707031,7],["ἐγὼ",704018,164],["ἠγάπησα",700120,155],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["μετεκάλεσα",708796,155],["τὰ",709436,41],["τέκνα",712761,42],["αὐτοῦ",702165,102]],"Early in the morning were they cast off, the king of Israel has been cast off: for Israel is a child, and I loved him, and out of Egypt have I called his children."],["2",[["καθὼς",707030,28],["μετεκάλεσα",708796,155],["αὐτούς",702165,62],["οὕτως",709859,28],["ἀπῴχοντο",701466,139],["ἐκ",704132,0],["προσώπου",710986,21],["μου",709032,133],["αὐτοὶ",702165,201],["τοῖς",709436,147],["Βααλιμ",702342,148],["ἔθυον",706349,137],["καὶ",707031,7],["τοῖς",709436,147],["γλυπτοῖς",703117,230],["ἐθυμίων",706332,137]],"As I called them, so they departed from my presence: they sacrificed to Baalim, and burnt incense to graven images."],["3",[["καὶ",707031,7],["ἐγὼ",704018,164],["συνεπόδισα",712338,155],["τὸν",709436,5],["Εφραιμ",705769,6],["ἀνέλαβον",700984,155],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["τὸν",709436,5],["βραχίονά",702808,6],["μου",709032,133],["καὶ",707031,7],["οὐκ",709805,28],["ἔγνωσαν",703105,150],["ὅτι",709803,7],["ἴαμαι",706424,584],["αὐτούς",702165,62]],"Yet I bound the feet of Ephraim, I took him on my arm; but they knew not that I healed them."],["4",[["ἐν",704639,0],["διαφθορᾷ",703625,1],["ἀνθρώπων",701163,81],["ἐξέτεινα",704322,155],["αὐτοὺς",702165,62],["ἐν",704639,0],["δεσμοῖς",703372,148],["ἀγαπήσεώς",700123,17],["μου",709032,133],["καὶ",707031,7],["ἔσομαι",704093,181],["αὐτοῖς",702165,151],["ὡς",714148,7],["ῥαπίζων",711182,72],["ἄνθρωπος",701163,4],["ἐπὶ",705080,0],["τὰς",709436,38],["σιαγόνας",711763,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπιβλέψομαι",705088,181],["πρὸς",710844,0],["αὐτόν",702165,85],["δυνήσομαι",703838,181],["αὐτῷ",702165,50]],"When men were destroyed, I drew them with the bands of my love: and I will be to them as a man smiting [another] on his cheek: and I will have respect to him, I will prevail with him."],["5",[["κατῴκησεν",707534,2],["Εφραιμ",705769,4],["ἐν",704639,0],["Αἰγύπτῳ",700401,1],["καὶ",707031,7],["Ασσουρ",702001,4],["αὐτὸς",702165,121],["βασιλεὺς",702580,4],["αὐτοῦ",702165,102],["ὅτι",709803,7],["οὐκ",709805,28],["ἠθέλησεν",706176,2],["ἐπιστρέψαι",705278,106]],"Ephraim dwelt in Egypt; and [as for] the Assyrian, he was his king, because he would not return."],["6",[["καὶ",707031,7],["ἠσθένησεν",701938,2],["ῥομφαία",711291,12],["ἐν",704639,0],["ταῖς",709436,75],["πόλεσιν",710612,76],["αὐτοῦ",702165,102],["καὶ",707031,7],["κατέπαυσεν",707365,2],["ἐν",704639,0],["ταῖς",709436,75],["χερσὶν",713787,76],["αὐτοῦ",702165,102],["καὶ",707031,7],["φάγονται",713296,135],["ἐκ",704132,0],["τῶν",709436,130],["διαβουλίων",703430,65],["αὐτῶν",702165,40]],"And in his cities he prevailed not with the sword, and he ceased [to war] with his hands: and they shall eat [of the fruit] of their own devices:"],["7",[["καὶ",707031,7],["ὁ",709436,3],["λαὸς",708094,4],["αὐτοῦ",702165,102],["ἐπικρεμάμενος",705178,122],["ἐκ",704132,0],["τῆς",709436,16],["κατοικίας",707537,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὁ",709436,3],["θεὸς",706192,4],["ἐπὶ",705080,0],["τὰ",709436,41],["τίμια",712858,68],["αὐτοῦ",702165,102],["θυμωθήσεται",706335,134],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ὑψώσῃ",713289,172],["αὐτόν",702165,85]],"and his people [shall] cleave fondly to their habitation; but God shall be angry with his precious things, and shall not at all exalt him."],["8",[["τί",712867,126],["σε",711598,163],["διαθῶ",703609,207],["Εφραιμ",705769,153],["ὑπερασπιῶ",713121,165],["σου",711945,133],["Ισραηλ",706839,153],["τί",712867,126],["σε",711598,163],["διαθῶ",703609,207],["ὡς",714148,7],["Αδαμα",700223,227],["θήσομαί",712849,181],["σε",711598,163],["καὶ",707031,7],["ὡς",714148,7],["Σεβωιμ",711612,354],["μετεστράφη",708817,37],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["ἐν",704639,0],["τῷ",709436,113],["αὐτῷ",702165,50],["συνεταράχθη",712507,37],["ἡ",709436,10],["μεταμέλειά",708804,12],["μου",709032,133]],"How shall I deal with thee, Ephraim? [how] shall I protect thee, Israel? what shall I do with thee? I will make thee as Adama, and as Seboim; my heart is turned at once, my repentance is powerfully excited."],["9",[["οὐ",709805,28],["μὴ",708851,28],["ποιήσω",710582,207],["κατὰ",707200,0],["τὴν",709436,8],["ὀργὴν",709728,9],["τοῦ",709436,35],["θυμοῦ",706334,18],["μου",709032,133],["οὐ",709805,28],["μὴ",708851,28],["ἐγκαταλίπω",703967,207],["τοῦ",709436,20],["ἐξαλειφθῆναι",704852,179],["τὸν",709436,5],["Εφραιμ",705769,6],["διότι",703734,7],["θεὸς",706192,4],["ἐγώ",704018,164],["εἰμι",704093,157],["καὶ",707031,7],["οὐκ",709805,28],["ἄνθρωπος",701163,4],["ἐν",704639,0],["σοὶ",711925,159],["ἅγιος",700159,14],["καὶ",707031,7],["οὐκ",709805,28],["εἰσελεύσομαι",704114,181],["εἰς",704105,0],["πόλιν",710612,9]],"I will not act according to the fury of my wrath, I will not abandon Ephraim to be utterly destroyed: for I am God, and not man; the Holy One within thee: and I will not enter into the city."],["10",[["ὀπίσω",709697,0],["κυρίου",707996,18],["πορεύσομαι",710667,181],["ὡς",714148,7],["λέων",708171,4],["ἐρεύξεται",705410,93],["ὅτι",709803,7],["αὐτὸς",702165,121],["ὠρύσεται",714142,93],["καὶ",707031,7],["ἐκστήσονται",704940,135],["τέκνα",712761,64],["ὑδάτων",713071,44]],"I will go after the Lord: he shall utter [his voice] as a lion: for he shall roar, and the children of the waters shall be amazed."],["11",[["καὶ",707031,7],["ἐκστήσονται",704940,135],["ὡς",714148,7],["ὄρνεον",709762,15],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ὡς",714148,7],["περιστερὰ",710391,12],["ἐκ",704132,0],["γῆς",703083,17],["Ἀσσυρίων",702004,81],["καὶ",707031,7],["ἀποκαταστήσω",701470,165],["αὐτοὺς",702165,62],["εἰς",704105,0],["τοὺς",709436,58],["οἴκους",709516,57],["αὐτῶν",702165,40],["λέγει",708124,91],["κύριος",707996,4]],"They shall be amazed [and fly] as a bird out of Egypt, and as a dove out of the land of the Assyrians: and I will restore them to their houses, saith the Lord."]]