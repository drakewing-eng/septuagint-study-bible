[["1",[["εἰς",704105,0],["κόλπον",707800,6],["αὐτῶν",702165,40],["ὡς",714148,7],["γῆ",703083,12],["ὡς",714148,7],["ἀετὸς",700318,4],["ἐπ᾿",705080,0],["οἶκον",709516,6],["κυρίου",707996,18],["ἀνθ᾿",701227,0],["ὧν",709781,252],["παρέβησαν",709996,150],["τὴν",709436,8],["διαθήκην",703456,9],["μου",709032,133],["καὶ",707031,7],["κατὰ",707200,0],["τοῦ",709436,35],["νόμου",709349,18],["μου",709032,133],["ἠσέβησαν",701906,150]],"[He shall come] into their midst as the land, as an eagle against the house of the Lord, because they have transgressed my covenant, and have sinned against my law."],["2",[["ἐμὲ",704555,163],["κεκράξονται",707868,135],["ὁ",709436,3],["θεός",706192,4],["ἐγνώκαμέν",703105,314],["σε",711598,163]],"They shall soon cry out to me, [saying], O God, we know thee."],["3",[["ὅτι",709803,7],["Ισραηλ",706839,4],["ἀπεστρέψατο",701598,23],["ἀγαθά",700106,68],["ἐχθρὸν",705779,6],["κατεδίωξαν",707243,150]],"For Israel has turned away from good things; they have pursued an enemy."],["4",[["ἑαυτοῖς",703917,151],["ἐβασίλευσαν",702581,150],["καὶ",707031,7],["οὐ",709805,28],["δι᾿",703417,0],["ἐμοῦ",704580,133],["ἦρξαν",701860,150],["καὶ",707031,7],["οὐκ",709805,28],["ἐγνώρισάν",703135,150],["μοι",708974,159],["τὸ",709436,24],["ἀργύριον",701707,25],["αὐτῶν",702165,40],["καὶ",707031,7],["τὸ",709436,24],["χρυσίον",713972,25],["αὐτῶν",702165,40],["ἐποίησαν",710582,150],["ἑαυτοῖς",703917,151],["εἴδωλα",704079,42],["ὅπως",709719,7],["ἐξολεθρευθῶσιν",704956,272]],"They have made kings for themselves, but not by me: they have ruled, but they did not make it known to me: [of] their silver and their gold they have made images to themselves, that they might be destroyed."],["5",[["ἀπότριψαι",701624,300],["τὸν",709436,5],["μόσχον",709029,6],["σου",711945,133],["Σαμάρεια",711449,258],["παρωξύνθη",710164,37],["ὁ",709436,3],["θυμός",706334,4],["μου",709032,133],["ἐπ᾿",705080,0],["αὐτούς",702165,62],["ἕως",705792,0],["τίνος",712867,340],["οὐ",709805,28],["μὴ",708851,28],["δύνωνται",703838,380],["καθαρισθῆναι",706985,179]],"Cast off thy calf, O Samaria; mine anger is kindled against them: how long will they be unable to purge themselves in Israel?"],["6",[["ἐν",704639,0],["τῷ",709436,113],["Ισραηλ",706839,114],["καὶ",707031,7],["αὐτὸ",702165,129],["τέκτων",712766,4],["ἐποίησεν",710582,2],["καὶ",707031,7],["οὐ",709805,28],["θεός",706192,4],["ἐστιν",704093,91],["διότι",703734,7],["πλανῶν",710495,72],["ἦν",704093,13],["ὁ",709436,3],["μόσχος",709029,4],["σου",711945,133],["Σαμάρεια",711449,258]],"Whereas the workman made it, and it is not God; wherefore thy calf, Samaria, was a deceiver:"],["7",[["ὅτι",709803,7],["ἀνεμόφθορα",701125,68],["ἔσπειραν",712006,150],["καὶ",707031,7],["ἡ",709436,10],["καταστροφὴ",707445,12],["αὐτῶν",702165,40],["ἐκδέξεται",704165,93],["αὐτά",702165,71],["δράγμα",703820,25],["οὐκ",709805,28],["ἔχον",705785,47],["ἰσχὺν",706858,9],["τοῦ",709436,20],["ποιῆσαι",710582,106],["ἄλευρον",700653,25],["ἐὰν",703912,7],["δὲ",703303,11],["καὶ",707031,28],["ποιήσῃ",710582,172],["ἀλλότριοι",700699,138],["καταφάγονται",707519,135],["αὐτό",702165,129]],"for they sowed blighted [seed], and their destruction shall await them, a sheaf of corn that avails not to make meal; and even if it should produce it, strangers shall devour it."],["8",[["κατεπόθη",707374,37],["Ισραηλ",706839,4],["νῦν",709384,28],["ἐγένετο",703104,23],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["ὡς",714148,7],["σκεῦος",711844,15],["ἄχρηστον",702312,26]],"Israel is swallowed up: now is he become among the nations as a worthless vessel."],["9",[["ὅτι",709803,7],["αὐτοὶ",702165,201],["ἀνέβησαν",700905,150],["εἰς",704105,0],["Ἀσσυρίους",702004,57],["ἀνέθαλεν",700949,2],["καθ᾿",707200,0],["ἑαυτὸν",703917,85],["Εφραιμ",705769,4],["δῶρα",703907,42],["ἠγάπησαν",700120,150]],"For they have gone up to the Assyrians: Ephraim has been strengthened against himself; they loved gifts."],["10",[["διὰ",703417,0],["τοῦτο",709858,129],["παραδοθήσονται",710014,144],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["νῦν",709384,28],["εἰσδέξομαι",704111,181],["αὐτούς",702165,62],["καὶ",707031,7],["κοπάσουσιν",707819,218],["μικρὸν",708915,27],["τοῦ",709436,20],["χρίειν",713965,55],["βασιλέα",702580,6],["καὶ",707031,7],["ἄρχοντας",701862,57]],"Therefore shall they be delivered to the nations: now I will receive them, and they shall cease a little to anoint a king and princes."],["11",[["ὅτι",709803,7],["ἐπλήθυνεν",710530,13],["Εφραιμ",705769,4],["θυσιαστήρια",706348,42],["εἰς",704105,0],["ἁμαρτίας",700775,39],["ἐγένοντο",703104,189],["αὐτῷ",702165,50],["θυσιαστήρια",706348,64],["ἠγαπημένα",700120,370]],"Because Ephraim has multiplied altars, [his] beloved altars are become sins to him."],["12",[["καταγράψω",707231,207],["αὐτῷ",702165,50],["πλῆθος",710529,25],["καὶ",707031,28],["τὰ",709436,41],["νόμιμα",709340,68],["αὐτοῦ",702165,102],["εἰς",704105,0],["ἀλλότρια",700699,68],["ἐλογίσθησαν",708232,99],["θυσιαστήρια",706348,42],["τὰ",709436,41],["ἠγαπημένα",700120,388]],"I will write down a multitude [of commands] for him; but his statutes are accounted strange things, [even] the beloved altars."],["13",[["διότι",703734,7],["ἐὰν",703912,7],["θύσωσιν",706349,234],["θυσίαν",706345,9],["καὶ",707031,7],["φάγωσιν",713296,234],["κρέα",707889,42],["κύριος",707996,4],["οὐ",709805,28],["προσδέξεται",710874,93],["αὐτά",702165,71],["νῦν",709384,28],["μνησθήσεται",708923,134],["τὰς",709436,38],["ἀδικίας",700271,39],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐκδικήσει",704174,127],["τὰς",709436,38],["ἁμαρτίας",700775,39],["αὐτῶν",702165,40],["αὐτοὶ",702165,201],["εἰς",704105,0],["Αἴγυπτον",700401,9],["ἀπέστρεψαν",701598,150],["καὶ",707031,7],["ἐν",704639,0],["Ἀσσυρίοις",702004,148],["ἀκάθαρτα",700508,68],["φάγονται",713296,135]],"For if they should offer a sacrifice, and eat flesh, the Lord will not accept them: now will he remember their iniquities, and will take vengeance on their sins: they have returned to Egypt, and they shall eat unclean things among the Assyrians."],["14",[["καὶ",707031,7],["ἐπελάθετο",705187,23],["Ισραηλ",706839,4],["τοῦ",709436,35],["ποιήσαντος",710582,500],["αὐτὸν",702165,85],["καὶ",707031,7],["ᾠκοδόμησαν",709509,150],["τεμένη",712790,42],["καὶ",707031,7],["Ιουδας",706775,4],["ἐπλήθυνεν",710530,13],["πόλεις",710612,39],["τετειχισμένας",712757,498],["καὶ",707031,7],["ἐξαποστελῶ",704872,165],["πῦρ",711088,25],["εἰς",704105,0],["τὰς",709436,38],["πόλεις",710612,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["καταφάγεται",707519,93],["τὰ",709436,41],["θεμέλια",706181,42],["αὐτῶν",702165,40]],"And Israel has forgotten him that made him, and they have built fanes, and Juda has multiplied walled cities: but I will send fire on his cities, and it shall devour their foundations."]]