[["1",[["ἀκούσατε",700587,74],["ταῦτα",709858,71],["οἱ",709436,136],["ἱερεῖς",706614,52],["καὶ",707031,7],["προσέχετε",710895,335],["οἶκος",709516,4],["Ισραηλ",706839,18],["καὶ",707031,7],["ὁ",709436,3],["οἶκος",709516,4],["τοῦ",709436,35],["βασιλέως",702580,18],["ἐνωτίζεσθε",704825,73],["διότι",703734,7],["πρὸς",710844,0],["ὑμᾶς",713080,194],["ἐστιν",704093,91],["τὸ",709436,24],["κρίμα",707903,25],["ὅτι",709803,7],["παγὶς",709910,12],["ἐγενήθητε",703104,472],["τῇ",709436,100],["σκοπιᾷ",711876,1],["καὶ",707031,7],["ὡς",714148,7],["δίκτυον",703703,15],["ἐκτεταμένον",704322,327],["ἐπὶ",705080,0],["τὸ",709436,24],["ἰταβύριον",706861,25]],"Hear these things, ye priests; and attend, O house of Israel; and hearken, O house of the king; for the controversy is with you, because ye have been a snare in Scopia, and as a net spread on Itabyrium,"],["2",[["ὃ",709781,128],["οἱ",709436,136],["ἀγρεύοντες",700188,146],["τὴν",709436,8],["θήραν",706244,9],["κατέπηξαν",707371,150],["ἐγὼ",704018,164],["δὲ",703303,11],["παιδευτὴς",709925,4],["ὑμῶν",713091,145]],"which they that hunt the prey have fixed: but I will correct you."],["3",[["ἐγὼ",704018,164],["ἔγνων",703105,155],["τὸν",709436,5],["Εφραιμ",705769,6],["καὶ",707031,7],["Ισραηλ",706839,4],["οὐκ",709805,28],["ἄπεστιν",701376,91],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["διότι",703734,7],["νῦν",709384,28],["ἐξεπόρνευσεν",704295,2],["Εφραιμ",705769,4],["ἐμιάνθη",708900,37],["Ισραηλ",706839,4]],"I know Ephraim, and Israel is not far from me: for now Ephraim has gone grievously a-whoring, Israel is defiled."],["4",[["οὐκ",709805,28],["ἔδωκαν",703654,150],["τὰ",709436,63],["διαβούλια",703431,64],["αὐτῶν",702165,40],["τοῦ",709436,20],["ἐπιστρέψαι",705278,106],["πρὸς",710844,0],["τὸν",709436,5],["θεὸν",706192,6],["αὐτῶν",702165,40],["ὅτι",709803,7],["πνεῦμα",710566,15],["πορνείας",710672,17],["ἐν",704639,0],["αὐτοῖς",702165,151],["ἐστιν",704093,91],["τὸν",709436,5],["δὲ",703303,11],["κύριον",707996,6],["οὐκ",709805,28],["ἐπέγνωσαν",705104,150]],"They have not framed their counsels to return to their God, for the spirit of fornication is in them, and they have not known the Lord."],["5",[["καὶ",707031,7],["ταπεινωθήσεται",712717,134],["ἡ",709436,10],["ὕβρις",713051,12],["τοῦ",709436,35],["Ισραηλ",706839,18],["εἰς",704105,0],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["Ισραηλ",706839,4],["καὶ",707031,7],["Εφραιμ",705769,4],["ἀσθενήσουσιν",701938,218],["ἐν",704639,0],["ταῖς",709436,75],["ἀδικίαις",700271,76],["αὐτῶν",702165,40],["καὶ",707031,7],["ἀσθενήσει",701938,127],["καὶ",707031,28],["Ιουδας",706775,4],["μετ᾿",708780,0],["αὐτῶν",702165,40]],"And the pride of Israel shall be brought low before his face; and Israel and Ephraim shall fall in their iniquities; and Judas also shall fall with them."],["6",[["μετὰ",708780,0],["προβάτων",710768,44],["καὶ",707031,7],["μόσχων",709029,81],["πορεύσονται",710667,135],["τοῦ",709436,20],["ἐκζητῆσαι",704187,106],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["εὕρωσιν",705676,234],["αὐτόν",702165,85],["ὅτι",709803,7],["ἐξέκλινεν",704220,13],["ἀπ᾿",701425,0],["αὐτῶν",702165,40]],"They shall go with sheep and calves diligently to seek the Lord; but they shall not find him, for he has withdrawn himself from them."],["7",[["ὅτι",709803,7],["τὸν",709436,5],["κύριον",707996,6],["ἐγκατέλιπον",703967,150],["ὅτι",709803,7],["τέκνα",712761,64],["ἀλλότρια",700699,195],["ἐγεννήθησαν",703051,99],["αὐτοῖς",702165,151],["νῦν",709384,28],["καταφάγεται",707519,93],["αὐτοὺς",702165,62],["ἡ",709436,10],["ἐρυσίβη",705450,12],["καὶ",707031,7],["τοὺς",709436,58],["κλήρους",707727,57],["αὐτῶν",702165,40]],"For they have forsaken the Lord; for strange children have been born to them: now shall the cankerworm devour them and their heritages."],["8",[["σαλπίσατε",711425,74],["σάλπιγγι",711424,1],["ἐπὶ",705080,0],["τοὺς",709436,58],["βουνούς",702797,57],["ἠχήσατε",706045,74],["ἐπὶ",705080,0],["τῶν",709436,80],["ὑψηλῶν",713285,169],["κηρύξατε",707662,74],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["Ων",714118,118],["ἐξέστη",704940,2],["Βενιαμιν",702650,4]],"Blow ye the trumpet on the hills, sound aloud on the heights: proclaim in the house of On, Benjamin is amazed."],["9",[["Εφραιμ",705769,4],["εἰς",704105,0],["ἀφανισμὸν",702183,6],["ἐγένετο",703104,23],["ἐν",704639,0],["ἡμέραις",705984,76],["ἐλέγχου",704415,18],["ἐν",704639,0],["ταῖς",709436,75],["φυλαῖς",713620,76],["τοῦ",709436,35],["Ισραηλ",706839,18],["ἔδειξα",703314,155],["πιστά",710486,68]],"Ephraim has come to nought in the days of reproof: in the tribes of Israel I have shown faithful [dealings]."],["10",[["ἐγένοντο",703104,189],["οἱ",709436,136],["ἄρχοντες",701862,52],["Ιουδα",706768,18],["ὡς",714148,7],["μετατιθέντες",708820,146],["ὅρια",709749,42],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["ἐκχεῶ",704368,165],["ὡς",714148,7],["ὕδωρ",713071,25],["τὸ",709436,24],["ὅρμημά",709757,25],["μου",709032,133]],"The princes of Juda became as they that removed the bounds: I will pour out upon them my fury as water."],["11",[["κατεδυνάστευσεν",707248,2],["Εφραιμ",705769,4],["τὸν",709436,5],["ἀντίδικον",701233,6],["αὐτοῦ",702165,102],["κατεπάτησεν",707360,2],["κρίμα",707903,25],["ὅτι",709803,7],["ἤρξατο",701860,23],["πορεύεσθαι",710667,110],["ὀπίσω",709697,0],["τῶν",709436,80],["ματαίων",708575,169]],"Ephraim altogether prevailed against his adversary, he trod judgment under foot, for he began to go after vanities."],["12",[["καὶ",707031,7],["ἐγὼ",704018,164],["ὡς",714148,7],["ταραχὴ",712722,12],["τῷ",709436,113],["Εφραιμ",705769,114],["καὶ",707031,7],["ὡς",714148,7],["κέντρον",707616,15],["τῷ",709436,113],["οἴκῳ",709516,114],["Ιουδα",706768,18]],"Therefore I [will be] as consternation to Ephraim, and as a goad to the house of Juda."],["13",[["καὶ",707031,7],["εἶδεν",709725,2],["Εφραιμ",705769,4],["τὴν",709436,8],["νόσον",709358,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["Ιουδας",706775,4],["τὴν",709436,8],["ὀδύνην",709463,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπορεύθη",710667,37],["Εφραιμ",705769,4],["πρὸς",710844,0],["Ἀσσυρίους",702004,57],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["πρέσβεις",710732,57],["πρὸς",710844,0],["βασιλέα",702580,6],["Ιαριμ",706435,6],["καὶ",707031,7],["αὐτὸς",702165,121],["οὐκ",709805,28],["ἠδυνάσθη",703838,37],["ἰάσασθαι",706424,109],["ὑμᾶς",713080,194],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["διαπαύσῃ",703538,172],["ἐξ",704132,0],["ὑμῶν",713091,145],["ὀδύνη",709463,12]],"And Ephraim saw his disease, and Judas his pain; then Ephraim went to the Assyrians, and sent ambassadors to king Jarim: but he could not heal you, and your pain shall in nowise cease from you."],["14",[["διότι",703734,7],["ἐγώ",704018,164],["εἰμι",704093,157],["ὡς",714148,7],["πανθὴρ",709965,4],["τῷ",709436,113],["Εφραιμ",705769,114],["καὶ",707031,7],["ὡς",714148,7],["λέων",708171,4],["τῷ",709436,113],["οἴκῳ",709516,114],["Ιουδα",706768,18],["καὶ",707031,7],["ἐγὼ",704018,164],["ἁρπῶμαι",701804,181],["καὶ",707031,7],["πορεύσομαι",710667,181],["καὶ",707031,7],["λήμψομαι",708076,181],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ὁ",709436,3],["ἐξαιρούμενος",704838,122]],"Wherefore I am as a panther to Ephraim, and as a lion to the house of Juda: and I will tear, and go away; and I will take, and there shall be none to deliver."],["15",[["πορεύσομαι",710667,181],["καὶ",707031,7],["ἐπιστρέψω",705278,165],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["μου",709032,133],["ἕως",705792,0],["οὗ",709781,48],["ἀφανισθῶσιν",702182,272],["καὶ",707031,7],["ἐπιζητήσουσιν",705135,218],["τὸ",709436,24],["πρόσωπόν",710986,25],["μου",709032,133],["ἐν",704639,0],["θλίψει",706276,1],["αὐτῶν",702165,40],["ὀρθριοῦσι",709742,218],["πρός",710844,0],["με",708618,163],["λέγοντες",708124,146]],"I will go and return to my place, until they are brought to nought, and [then] shall they seek my face. In their affliction they will seek me early, saying,"]]