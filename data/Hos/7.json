[["1",[["ἐν",704639,0],["τῷ",709436,53],["ἰάσασθαί",706424,109],["με",708618,163],["τὸν",709436,5],["Ισραηλ",706839,6],["καὶ",707031,7],["ἀποκαλυφθήσεται",701474,134],["ἡ",709436,10],["ἀδικία",700271,12],["Εφραιμ",705769,18],["καὶ",707031,7],["ἡ",709436,10],["κακία",707054,12],["Σαμαρείας",711449,17],["ὅτι",709803,7],["ἠργάσαντο",705383,189],["ψευδῆ",714036,68],["καὶ",707031,7],["κλέπτης",707714,4],["πρὸς",710844,0],["αὐτὸν",702165,85],["εἰσελεύσεται",704114,93],["ἐκδιδύσκων",704180,72],["λῃστὴς",708181,4],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["αὐτοῦ",702165,102]],"When I have healed Israel, then shall the iniquity of Ephraim be revealed, and the wickedness of Samaria; for they have wrought falsehood: and a thief shall come in to him, [even] a robber spoiling in his way;"],["2",[["ὅπως",709719,7],["συνᾴδωσιν",712377,271],["ὡς",714148,7],["συνᾴδοντες",712377,146],["τῇ",709436,100],["καρδίᾳ",707141,1],["αὐτῶν",702165,40],["πάσας",710177,119],["τὰς",709436,38],["κακίας",707054,39],["αὐτῶν",702165,40],["ἐμνήσθην",708960,156],["νῦν",709384,28],["ἐκύκλωσεν",707958,2],["αὐτοὺς",702165,62],["τὰ",709436,63],["διαβούλια",703431,64],["αὐτῶν",702165,40],["ἀπέναντι",701389,0],["τοῦ",709436,20],["προσώπου",710986,21],["μου",709032,133],["ἐγένοντο",703104,189]],"that they may concert together as [men] singing in their heart: I remember all their wickedness: now have their own counsels compassed them about; they came before my face."],["3",[["ἐν",704639,0],["ταῖς",709436,75],["κακίαις",707054,76],["αὐτῶν",702165,40],["εὔφραναν",705715,150],["βασιλεῖς",702580,57],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["ψεύδεσιν",714044,96],["αὐτῶν",702165,40],["ἄρχοντας",701862,57]],"They gladdened kings with their wickedness, and princes with their lies."],["4",[["πάντες",710177,138],["μοιχεύοντες",708979,146],["ὡς",714148,7],["κλίβανος",707733,14],["καιόμενος",707049,122],["εἰς",704105,0],["πέψιν",710449,9],["κατακαύματος",707265,21],["ἀπὸ",701425,0],["τῆς",709436,16],[