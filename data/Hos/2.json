372],["πρὸς",710844,0],["τὴν",709436,8],["μητέρα",708892,9],["ὑμῶν",713091,145],["κρίθητε",707905,372],["ὅτι",709803,7],["αὐτὴ",702165,107],["οὐ",709805,28],["γυνή",703209,12],["μου",709032,133],["καὶ",707031,7],["ἐγὼ",704018,164],["οὐκ",709805,28],["ἀνὴρ",701150,4],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐξαρῶ",704839,165],["τὴν",709436,8],["πορνείαν",710672,9],["αὐτῆς",702165,86],["ἐκ",704132,0],["προσώπου",710986,21],["μου",709032,133],["καὶ",707031,7],["τὴν",709436,8],["μοιχείαν",708978,9],["αὐτῆς",702165,86],["ἐκ",704132,0],["μέσου",708768,116],["μαστῶν",708569,81],["αὐτῆς",702165,86]],"Plead with your mother, plead: for she is not my wife, and I am not her husband: and I will remove her fornication out of my presence, and her adultery from between her breasts:"],["5",[["ὅπως",709719,7],["ἂν",700900,11],["ἐκδύσω",704180,165],["αὐτὴν",702165,104],["γυμνὴν",703202,36],["καὶ",707031,7],["ἀποκαταστήσω",701470,165],["αὐτὴν",702165,104],["καθὼς",707030,28],["ἡμέρᾳ",705984,1],["γενέσεως",703043,17],["αὐτῆς",702165,86],["καὶ",707031,7],["θήσομαι",712849,181],["αὐτὴν",702165,104],["ὡς",714148,7],["ἔρημον",705420,9],["καὶ",707031,7],["τάξω",712730,165],["αὐτὴν",702165,104],["ὡς",714148,7],["γῆν",703083,9],["ἄνυδρον",701285,36],["καὶ",707031,7],["ἀποκτενῶ",701498,165],["αὐτὴν",702165,104],["ἐν",704639,0],["δίψει",703764,54]],"that I may strip her naked, and make her again as she was at the day of her birth: and I will make her desolate, and make her as a dry land, and will kill her with thirst."],["6",[["καὶ",707031,7],["τὰ",709436,41],["τέκνα",712761,42],["αὐτῆς",702165,86],["οὐ",709805,28],["μὴ",708851,28],["ἐλεήσω",704418,165],["ὅτι",709803,7],["τέκνα",712761,64],["πορνείας",710672,17],["ἐστίν",704093,91]],"And I will not have mercy upon her children; for they are children of fornication."],["7",[["ὅτι",709803,7],["ἐξεπόρνευσεν",704295,2],["ἡ",709436,10],["μήτηρ",708892,12],["αὐτῶν",702165,40],["κατῄσχυνεν",707257,13],["ἡ",709436,10],["τεκοῦσα",712853,149],["αὐτά",702165,71],["εἶπεν",705373,2],["γάρ",702963,11],["ἀκολουθήσω",700566,165],["ὀπίσω",709697,0],["τῶν",709436,80],["ἐραστῶν",705379,81],["μου",709032,133],["τῶν",709436,80],["διδόντων",703654,170],["μοι",708974,159],["τοὺς",709436,58],["ἄρτους",701829,57],["μου",709032,133],["καὶ",707031,7],["τὸ",709436,24],["ὕδωρ",713071,25],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,41],["ἱμάτιά",706742,42],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,41],["ὀθόνιά",709489,42],["μου",709032,133],["καὶ",707031,7],["τὸ",709436,24],["ἔλαιόν",704380,25],["μου",709032,133],["καὶ",707031,7],["πάντα",710177,68],["ὅσα",709788,68],["μοι",708974,159],["καθήκει",706998,91]],"And their mother went a-whoring: she that bore them disgraced [them]: for she said, I will go after my lovers, that give me my bread and my water, and my garments, and my linen clothes, my oil and all my necessaries."],["8",[["διὰ",703417,0],["τοῦτο",709858,129],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["φράσσω",713575,157],["τὴν",709436,8],["ὁδὸν",709458,9],["αὐτῆς",702165,86],["ἐν",704639,0],["σκόλοψιν",711871,148],["καὶ",707031,7],["ἀνοικοδομήσω",701187,165],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτῆς",702165,86],["καὶ",707031,7],["τὴν",709436,8],["τρίβον",712939,9],["αὐτῆς",702165,86],["οὐ",709805,28],["μὴ",708851,28],["εὕρῃ",705676,172]],"Therefore, behold, I hedge up her way with thorns, and will stop the ways, and she shall not find her path."],["9",[["καὶ",707031,7],["καταδιώξεται",707243,93],["τοὺς",709436,58],["ἐραστὰς",705379,57],["αὐτῆς",702165,86],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["καταλάβῃ",707300,172],["αὐτούς",702165,62],["καὶ",707031,7],["ζητήσει",705879,127],["αὐτοὺς",702165,62],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["εὕρῃ",705676,172],["αὐτούς",702165,62],["καὶ",707031,7],["ἐρεῖ",705415,127],["πορεύσομαι",710667,181],["καὶ",707031,7],["ἐπιστρέψω",705278,165],["πρὸς",710844,0],["τὸν",709436,5],["ἄνδρα",701150,6],["μου",709032,133],["τὸν",709436,5],["πρότερον",710991,27],["ὅτι",709803,7],["καλῶς",707106,28],["μοι",708974,159],["ἦν",704093,13],["τότε",712908,28],["ἢ",705924,7],["νῦν",709384,28]],"And she shall follow after her lovers, and shall not overtake them; and she shall seek them, but shall not find them: and she shall say, I will go, and return to my former husband; for it was better with me than now."],["10",[["καὶ",707031,7],["αὐτὴ",702165,107],["οὐκ",709805,28],["ἔγνω",703105,2],["ὅτι",709803,7],["ἐγὼ",704018,164],["δέδωκα",703654,89],["αὐτῇ",702165,105],["τὸν",709436,5],["σῖτον",711814,6],["καὶ",707031,7],["τὸν",709436,5],["οἶνον",709530,6],["καὶ",707031,7],["τὸ",709436,24],["ἔλαιον",704380,25],["καὶ",707031,7],["ἀργύριον",701707,25],["ἐπλήθυνα",710530,155],["αὐτῇ",702165,105],["αὐτὴ",702165,107],["δὲ",703303,11],["ἀργυρᾶ",701705,68],["καὶ",707031,7],["χρυσᾶ",713971,68],["ἐποίησεν",710582,2],["τῇ",709436,100],["Βααλ",702333,1]],"And she knew not that I gave her her corn, and wine, and oil, and multiplied silver to her: but she made silver and gold [images] for Baal."],["11",[["διὰ",703417,0],["τοῦτο",709858,129],["ἐπιστρέψω",705278,165],["καὶ",707031,7],["κομιοῦμαι",707805,181],["τὸν",709436,5],["σῖτόν",711814,6],["μου",709032,133],["καθ᾿",707200,0],["ὥραν",714128,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὸν",709436,5],["οἶνόν",709530,6],["μου",709032,133],["ἐν",704639,0],["καιρῷ",707047,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀφελοῦμαι",702177,181],["τὰ",709436,41],["ἱμάτιά",706742,42],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,41],["ὀθόνιά",709489,42],["μου",709032,133],["τοῦ",709436,20],["μὴ",708851,28],["καλύπτειν",707102,55],["τὴν",709436,8],["ἀσχημοσύνην",702054,9],["αὐτῆς",702165,86]],"Therefore I will return, and take away my corn in its season, and my wine in its time; and I will take away my raiment and my linen clothes, so that she shall not cover her nakedness."],["12",[["καὶ",707031,7],["νῦν",709384,28],["ἀποκαλύψω",701474,165],["τὴν",709436,8],["ἀκαθαρσίαν",700507,9],["αὐτῆς",702165,86],["ἐνώπιον",704823,0],["τῶν",709436,80],["ἐραστῶν",705379,81],["αὐτῆς",702165,86],["καὶ",707031,7],["οὐδεὶς",709817,14],["οὐ",709805,28],["μὴ",708851,28],["ἐξέληται",704838,239],["αὐτὴν",702165,104],["ἐκ",704132,0],["χειρός",713787,17],["μου",709032,133]],"And now I will expose her uncleanness before her lovers, and no one shall by any means deliver her out of my hand."],["13",[["καὶ",707031,7],["ἀποστρέψω",701598,165],["πάσας",710177,119],["τὰς",709436,38],["εὐφροσύνας",705717,39],["αὐτῆς",702165,86],["ἑορτὰς",704990,39],["αὐτῆς",702165,86],["καὶ",707031,7],["τὰς",709436,38],["νουμηνίας",709371,39],["αὐτῆς",702165,86],["καὶ",707031,7],["τὰ",709436,41],["σάββατα",711350,42],["αὐτῆς",702165,86],["καὶ",707031,7],["πάσας",710177,119],["τὰς",709436,38],["πανηγύρεις",709963,39],["αὐτῆς",702165,86]],"And I will take away all her gladness, her feasts, and her festivals at the new moon, and her sabbaths, and all her solemn assemblies."],["14",[["καὶ",707031,7],["ἀφανιῶ",702182,165],["ἄμπελον",700870,9],["αὐτῆς",702165,86],["καὶ",707031,7],["τὰς",709436,38],["συκᾶς",712254,39],["αὐτῆς",702165,86],["ὅσα",709788,68],["εἶπεν",705373,2],["μισθώματά",708941,64],["μου",709032,133],["ταῦτά",709858,290],["ἐστιν",704093,91],["ἃ",709781,69],["ἔδωκάν",703654,150],["μοι",708974,159],["οἱ",709436,136],["ἐρασταί",705379,52],["μου",709032,133],["καὶ",707031,7],["θήσομαι",712849,181],["αὐτὰ",702165,71],["εἰς",704105,0],["μαρτύριον",708525,25],["καὶ",707031,7],["καταφάγεται",707519,93],["αὐτὰ",702165,71],["τὰ",709436,63],["θηρία",706252,64],["τοῦ",709436,35],["ἀγροῦ",700196,18],["καὶ",707031,7],["τὰ",709436,63],["πετεινὰ",710439,64],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["τὰ",709436,63],["ἑρπετὰ",705441,64],["τῆς",709436,16],["γῆς",703083,17]],"And I will utterly destroy her vines, and her fig-trees, all things of which she said, These are my hire which my lovers have given me: and I will make them a testimony, and the wild beasts of the field, and the birds of the sky, and the reptiles of the earth shall devour them."],["15",[["καὶ",707031,7],["ἐκδικήσω",704174,165],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["τὰς",709436,38],["ἡμέρας",705984,39],["τῶν",709436,80],["Βααλιμ",702342,286],["ἐν",704639,0],["αἷς",709781,281],["ἐπέθυεν",705148,13],["αὐτοῖς",702165,151],["καὶ",707031,7],["περιετίθετο",710403,19],["τὰ",709436,41],["ἐνώτια",704826,42],["αὐτῆς",702165,86],["καὶ",707031,7],["τὰ",709436,41],["καθόρμια",707020,42],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐπορεύετο",710667,19],["ὀπίσω",709697,0],["τῶν",709436,80],["ἐραστῶν",705379,81],["αὐτῆς",702165,86],["ἐμοῦ",704580,133],["δὲ",703303,11],["ἐπελάθετο",705187,23],["λέγει",708124,91],["κύριος",707996,4]],"And I will recompense on her the days of Baalim, wherein she sacrificed to them, and put on her ear-rings, and her necklaces, and went after her lovers, and forgot me, saith the Lord."],["16",[["διὰ",703417,0],["τοῦτο",709858,129],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["πλανῶ",710495,165],["αὐτὴν",702165,104],["καὶ",707031,7],["τάξω",712730,165],["αὐτὴν",702165,104],["εἰς",704105,0],["ἔρημον",705420,9],["καὶ",707031,7],["λαλήσω",708071,165],["ἐπὶ",705080,0],["τὴν",709436,8],["καρδίαν",707141,9],["αὐτῆς",702165,86]],"Therefore, behold, I [will] cause her to err, and will make her as desolate, and will speak comfortably to her."],["17",[["καὶ",707031,7],["δώσω",703654,165],["αὐτῇ",702165,105],["τὰ",709436,41],["κτήματα",707933,42],["αὐτῆς",702165,86],["ἐκεῖθεν",704182,28],["καὶ",707031,7],["τὴν",709436,8],["κοιλάδα",707758,9],["Αχωρ",702318,118],["διανοῖξαι",703532,106],["σύνεσιν",712460,9],["αὐτῆς",702165,86],["καὶ",707031,7],["ταπεινωθήσεται",712717,134],["ἐκεῖ",704181,28],["κατὰ",707200,0],["τὰς",709436,38],["ἡμέρας",705984,39],["νηπιότητος",709296,17],["αὐτῆς",702165,86],["καὶ",707031,7],["κατὰ",707200,0],["τὰς",709436,38],["ἡμέρας",705984,39],["ἀναβάσεως",700907,17],["αὐτῆς",702165,86],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17]],"And I will give her her possessions from thence, and the valley of Achor to open her understanding: and she shall be afflicted there according to the days of her infancy, and according to the days of her coming up out of the land of Egypt."],["18",[["καὶ",707031,7],["ἔσται",704093,93],["ἐν",704639,0],["ἐκείνῃ",704183,105],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["λέγει",708124,91],["κύριος",707996,4],["καλέσει",707084,127],["με",708618,163],["ὁ",709436,3],["ἀνήρ",701150,4],["μου",709032,133],["καὶ",707031,7],["οὐ",709805,28],["καλέσει",707084,127],["με",708618,163],["ἔτι",705538,28],["Βααλιμ",702342,313]],"And it shall come to pass in that day, saith the Lord, [that] she shall call me, My husband, and shall no longer call me Baalim."],["19",[["καὶ",707031,7],["ἐξαρῶ",704839,165],["τὰ",709436,41],["ὀνόματα",709666,42],["τῶν",709436,80],["Βααλιμ",702342,286],["ἐκ",704132,0],["στόματος",712125,21],["αὐτῆς",702165,86],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["μνησθῶσιν",708923,272],["οὐκέτι",709827,28],["τὰ",709436,41],["ὀνόματα",709666,42],["αὐτῶν",702165,40]],"And I will take away the names of Baalim out of her mouth, and their names shall be remembered no more at all."],["20",[["καὶ",707031,7],["διαθήσομαι",703609,181],["αὐτοῖς",702165,151],["ἐν",704639,0],["ἐκείνῃ",704183,105],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["διαθήκην",703456,9],["μετὰ",708780,0],["τῶν",709436,43],["θηρίων",706252,44],["τοῦ",709436,35],["ἀγροῦ",700196,18],["καὶ",707031,7],["μετὰ",708780,0],["τῶν",709436,43],["πετεινῶν",710439,44],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["μετὰ",708780,0],["τῶν",709436,43],["ἑρπετῶν",705441,44],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["τόξον",712898,25],["καὶ",707031,7],["ῥομφαίαν",711291,9],["καὶ",707031,7],["πόλεμον",710605,6],["συντρίψω",712520,165],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["κατοικιῶ",707538,165],["σε",711598,163],["ἐπ᾿",705080,0],["ἐλπίδι",704530,1]],"And I will make for them in that day a covenant with the wild beasts of the field, and with the birds of the sky, and with the reptiles of the earth: and I will break the bow and the sword and the battle from off the earth, and will cause thee to dwell safely."],["21",[["καὶ",707031,7],["μνηστεύσομαί",708970,181],["σε",711598,163],["ἐμαυτῷ",704545,50],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["μνηστεύσομαί",708970,181],["σε",711598,163],["ἐμαυτῷ",704545,50],["ἐν",704639,0],["δικαιοσύνῃ",703695,1],["καὶ",707031,7],["ἐν",704639,0],["κρίματι",707903,54],["καὶ",707031,7],["ἐν",704639,0],["ἐλέει",704426,54],["καὶ",707031,7],["ἐν",704639,0],["οἰκτιρμοῖς",709520,148]],"And I will betroth thee to myself for ever; yea, I will betroth thee to myself in righteousness, and in judgment, and in mercy, and in tender compassions;"],["22",[["καὶ",707031,7],["μνηστεύσομαί",708970,181],["σε",711598,163],["ἐμαυτῷ",704545,50],["ἐν",704639,0],["πίστει",710484,1],["καὶ",707031,7],["ἐπιγνώσῃ",705104,123],["τὸν",709436,5],["κύριον",707996,6]],"and I will betroth thee to myself in faithfulness: and thou shalt know the Lord."],["23",[["καὶ",707031,7],["ἔσται",704093,93],["ἐν",704639,0],["ἐκείνῃ",704183,105],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["λέγει",708124,91],["κύριος",707996,4],["ἐπακούσομαι",705009,181],["τῷ",709436,113],["οὐρανῷ",709844,114],["καὶ",707031,7],["ὁ",709436,3],["οὐρανὸς",709844,4],["ἐπακούσεται",705009,93],["τῇ",709436,100],["γῇ",703083,1]],"And it shall come to pass in that day, saith the Lord, I will hearken to the heaven, and it shall hearken to the earth;"],["24",[["καὶ",707031,7],["ἡ",709436,10],["γῆ",703083,12],["ἐπακούσεται",705009,93],["τὸν",709436,5],["σῖτον",711814,6],["καὶ",707031,7],["τὸν",709436,5],["οἶνον",709530,6],["καὶ",707031,7],["τὸ",709436,24],["ἔλαιον",704380,25],["καὶ",707031,7],["αὐτὰ",702165,290],["ἐπακούσεται",705009,93],["τῷ",709436,113],["Ιεζραελ",706547,114]],"and the earth shall hearken to the corn, and the wine, and the oil; and they shall hearken to Jezrael."],["25",[["καὶ",707031,7],["