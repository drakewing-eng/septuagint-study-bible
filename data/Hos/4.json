[["1",[["ἀκούσατε",700587,74],["λόγον",708236,6],["κυρίου",707996,18],["υἱοὶ",713075,274],["Ισραηλ",706839,18],["διότι",703734,7],["κρίσις",707908,12],["τῷ",709436,113],["κυρίῳ",707996,114],["πρὸς",710844,0],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["τὴν",709436,8],["γῆν",703083,9],["διότι",703734,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀλήθεια",700656,12],["οὐδὲ",709816,7],["ἔλεος",704426,15],["οὐδὲ",709816,7],["ἐπίγνωσις",705107,12],["θεοῦ",706192,18],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"Hear the word of the Lord, ye children of Israel: for the Lord [has] a controversy with the inhabitants of the land, because there is no truth, nor mercy, nor knowledge of God in the land."],["2",[["ἀρὰ",701665,12],["καὶ",707031,7],["ψεῦδος",714044,15],["καὶ",707031,7],["φόνος",713549,4],["καὶ",707031,7],["κλοπὴ",707742,12],["καὶ",707031,7],["μοιχεία",708978,12],["κέχυται",713845,187],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["αἵματα",700442,42],["ἐφ᾿",705080,0],["αἵμασιν",700442,96],["μίσγουσιν",708934,197]],"Cursing, and lying, and murder, and theft, and adultery abound in the land, and they mingle blood with blood."],["3",[["διὰ",703417,0],["τοῦτο",709858,129],["πενθήσει",710251,127],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["σμικρυνθήσεται",708917,134],["σὺν",712372,0],["πᾶσιν",710177,230],["τοῖς",709436,147],["κατοικοῦσιν",707534,349],["αὐτήν",702165,104],["σὺν",712372,0],["τοῖς",709436,95],["θηρίοις",706252,96],["τοῦ",709436,35],["ἀγροῦ",700196,18],["καὶ",707031,7],["σὺν",712372,0],["τοῖς",709436,95],["ἑρπετοῖς",705441,96],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["σὺν",712372,0],["τοῖς",709436,95],["πετεινοῖς",710439,96],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["οἱ",709436,136],["ἰχθύες",706870,52],["τῆς",709436,16],["θαλάσσης",706069,17],["ἐκλείψουσιν",704237,218]],"Therefore shall the land mourn, and shall be diminished with all that dwell in it, with the wild beasts of the field, and the reptiles of the earth, and with the birds of the sky, and the fish of the sea shall fail:"],["4",[["ὅπως",709719,7],["μηδεὶς",708857,14],["μήτε",708891,7],["δικάζηται",703691,428],["μήτε",708891,7],["ἐλέγχῃ",704416,204],["μηδείς",708857,14],["ὁ",709436,3],["δὲ",703303,11],["λαός",708094,4],["μου",709032,133],["ὡς",714148,7],["ἀντιλεγόμενος",701245,122],["ἱερεύς",706614,4]],"that neither any one may plead, nor any one reprove [another]: but my people are as a priest spoken against."],["5",[["καὶ",707031,7],["ἀσθενήσεις",701938,166],["ἡμέρας",705984,17],["καὶ",707031,7],["ἀσθενήσει",701938,127],["καὶ",707031,28],["προφήτης",711009,4],["μετὰ",708780,0],["σοῦ",711945,133],["νυκτὶ",709386,1],["ὡμοίωσα",709628,155],["τὴν",709436,8],["μητέρα",708892,9],["σου",711945,133]],"Therefore they shall fall by day, and the prophet with thee shall fall: I have compared thy mother unto night."],["6",[["ὡμοιώθη",709628,37],["ὁ",709436,3],["λαός",708094,4],["μου",709032,133],["ὡς",714148,7],["οὐκ",709805,28],["ἔχων",705785,72],["γνῶσιν",703138,9],["ὅτι",709803,7],["σὺ",712181,164],["ἐπίγνωσιν",705107,9],["ἀπώσω",701659,174],["κἀγὼ",706969,288],["ἀπώσομαι",701659,181],["σὲ",711598,163],["τοῦ",709436,20],["μὴ",708851,28],["ἱερατεύειν",706607,55],["μοι",708974,159],["καὶ",707031,7],["ἐπελάθου",705187,174],["νόμον",709349,6],["θεοῦ",706192,18],["σου",711945,133],["κἀγὼ",706969,288],["ἐπιλήσομαι",705187,181],["τέκνων",712761,44],["σου",711945,133]],"My people are like as if they had no knowledge: because thou hast rejected knowledge, I will also reject thee, that thou shalt not minister as priest to me: and [as] thou hast forgotten the law of thy God, I also will forget thy children."],["7",[["κατὰ",707200,0],["τὸ",709436,24],["πλῆθος",710529,25],["αὐτῶν",702165,40],["οὕτως",709859,28],["ἥμαρτόν",700773,150],["μοι",708974,159],["τὴν",709436,8],["δόξαν",703791,9],["αὐτῶν",702165,40],["εἰς",704105,0],["ἀτιμίαν",702094,9],["θήσομαι",712849,181]],"According to their multitude, so they sinned against me: I will turn their glory into shame."],["8",[["ἁμαρτίας",700775,39],["λαοῦ",708094,18],["μου",709032,133],["φάγονται",713296,135],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἀδικίαις",700271,76],["αὐτῶν",702165,40],["λήμψονται",708076,135],["τὰς",709436,38],["ψυχὰς",714070,39],["αὐτῶν",702165,40]],"They will devour the sins of my people, and will set their hearts on their iniquities."],["9",[["καὶ",707031,7],["ἔσται",704093,93],["καθὼς",707030,28],["ὁ",709436,3],["λαὸς",708094,4],["οὕτως",709859,28],["καὶ",707031,28],["ὁ",709436,3],["ἱερεύς",706614,4],["καὶ",707031,7],["ἐκδικήσω",704174,165],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["διαβούλια",703431,42],["αὐτοῦ",702165,102],["ἀνταποδώσω",701215,165],["αὐτῷ",702165,50]],"And the priest shall be as the people: and I will avenge on them their ways, and I will recompense to them their counsels."],["10",[["καὶ",707031,7],["φάγονται",713296,135],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἐμπλησθῶσιν",704592,272],["ἐπόρνευσαν",710674,150],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["κατευθύνωσιν",707521,234],["διότι",703734,7],["τὸν",709436,5],["κύριον",707996,6],["ἐγκατέλιπον",703967,150],["τοῦ",709436,20],["φυλάξαι",713619,106]],"And they shall eat, and shall not be satisfied: they have gone a-whoring, and shall by no means prosper: because they have left off to take heed to the Lord."],["11",[["πορνείαν",710672,9],["καὶ",707031,7],["οἶνον",709530,6],["καὶ",707031,7],["μέθυσμα",708674,25],["ἐδέξατο",703393,23],["καρδία",707141,12],["λαοῦ",708094,18],["μου",709032,133]],"The heart of my people has gladly engaged in fornication and wine and strong drink."],["12",[["ἐν",704639,0],["συμβόλοις",712289,96],["ἐπηρώτων",705069,137],["καὶ",707031,7],["ἐν",704639,0],["ῥάβδοις",711135,76],["αὐτοῦ",702165,102],["ἀπήγγελλον",701321,137],["αὐτῷ",702165,50],["πνεύματι",710566,54],["πορνείας",710672,17],["ἐπλανήθησαν",710495,99],["καὶ",707031,7],["ἐξεπόρνευσαν",704295,150],["ἀπὸ",701425,0],["τοῦ",709436,35],["θεοῦ",706192,18],["αὐτῶν",702165,40]],"They asked counsel by [means of] signs, and they reported answer to them by their staves: they have gone astray in a spirit of whoredom, and gone grievously a-whoring from their God."],["13",[["ἐπὶ",705080,0],["τὰς",709436,38],["κορυφὰς",707844,39],["τῶν",709436,43],["ὀρέων",709768,44],["ἐθυσίαζον",706346,137],["καὶ",707031,7],["ἐπὶ",705080,0],["τοὺς",709436,58],["βουνοὺς",702797,57],["ἔθυον",706349,137],["ὑποκάτω",713204,0],["δρυὸς",703837,17],["καὶ",707031,7],["λεύκης",708165,82],["καὶ",707031,7],["δένδρου",703353,21],["συσκιάζοντος",712549,152],["ὅτι",709803,7],["καλὸν",707097,26],["σκέπη",711838,12],["διὰ",703417,0],["τοῦτο",709858,129],["ἐκπορνεύσουσιν",704295,218],["αἱ",709436,190],["θυγατέρες",706320,191],["ὑμῶν",713091,145],["καὶ",707031,7],["αἱ",709436,190],["νύμφαι",709381,191],["ὑμῶν",713091,145],["μοιχεύσουσιν",708979,218]],"They have sacrificed on the tops of the mountains, and on the hills they have sacrificed under the oak and poplar, and under the shady tree, because the shade was good: therefore your daughters shall go a-whoring, and your daughters-in-law shall commit adultery."],["14",[["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἐπισκέψωμαι",705250,410],["ἐπὶ",705080,0],["τὰς",709436,38],["θυγατέρας",706320,39],["ὑμῶν",713091,145],["ὅταν",709801,28],["πορνεύωσιν",710674,271],["καὶ",707031,7],["ἐπὶ",705080,0],["τὰς",709436,38],["νύμφας",709381,39],["ὑμῶν",713091,145],["ὅταν",709801,28],["μοιχεύωσιν",708979,271],["διότι",703734,7],["καὶ",707031,28],["αὐτοὶ",702165,201],["μετὰ",708780,0],["τῶν",709436,130],["πορνῶν",710675,65],["συνεφύροντο",712363,139],["καὶ",707031,7],["μετὰ",708780,0],["τῶν",709436,80],["τετελεσμένων",712783,398],["ἔθυον",706349,137],["καὶ",707031,7],["ὁ",709436,3],["λαὸς",708094,4],["ὁ",709436,3],["συνίων",712481,72],["συνεπλέκετο",712334,19],["μετὰ",708780,0],["πόρνης",710675,17]],"And I will not visit upon your daughters when they shall commit fornication, nor your daughters-in-law when they shall commit adultery: for they themselves mingled themselves with harlots, and sacrificed with polluted ones, and the people that understood not entangled itself with a harlot."],["15",[["σὺ",712181,164],["δέ",703303,11],["Ισραηλ",706839,153],["μὴ",708851,28],["ἀγνόει",700175,240],["καὶ",707031,7],["Ιουδα",706768,153],["μὴ",708851,28],["εἰσπορεύεσθε",704124,73],["εἰς",704105,0],["Γαλγαλα",702933,9],["καὶ",707031,7],["μὴ",708851,28],["ἀναβαίνετε",700905,335],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["Ων",714118,118],["καὶ",707031,7],["μὴ",708851,28],["ὀμνύετε",709620,335],["ζῶντα",705851,183],["κύριον",707996,6]],"But thou, Israel, be not ignorant, and go ye not, [men of] Juda, to Galgala; and go not up to the house of On, and swear not by the living Lord."],["16",[["ὅτι",709803,7],["ὡς",714148,7],["δάμαλις",703271,12],["παροιστρῶσα",710163,188],["παροίστρησεν",710163,13],["Ισραηλ",706839,4],["νῦν",709384,28],["νεμήσει",709253,127],["αὐτοὺς",702165,62],["κύριος",707996,4],["ὡς",714148,7],["ἀμνὸν",700855,6],["ἐν",704639,0],["εὐρυχώρῳ",705681,30]],"For Israel was maddened like a mad heifer: now the Lord will feed them as a lamb in a wide place."],["17",[["μέτοχος",708839,14],["εἰδώλων",704079,44],["Εφραιμ",705769,4],["ἔθηκεν",712849,2],["ἑαυτῷ",703917,50],["σκάνδαλα",711825,42]],"Ephraim, joined with idols, has laid stumbling-blocks in his own way."],["18",[["ᾑρέτισεν",700469,2],["Χαναναίους",713711,57],["πορνεύοντες",710674,146],["ἐξεπόρνευσαν",704295,150],["ἠγάπησαν",700120,150],["ἀτιμίαν",702094,9],["ἐκ",704132,0],["φρυάγματος",713598,21],["αὐτῶν",702165,40]],"He has chosen the Chananites: they have grievously gone a-whoring: they have loved dishonour through her insolence."],["19",[["συστροφὴ",712563,12],["πνεύματος",710566,21],["σὺ",712181,164],["εἶ",704093,154],["ἐν",704639,0],["ταῖς",709436,75],["πτέρυξιν",711057,76],["αὐτῆς",702165,86],["καὶ",707031,7],["καταισχυνθήσονται",707257,144],["ἐκ",704132,0],["τῶν",709436,43],["θυσιαστηρίων",706348,44],["αὐτῶν",702165,40]],"Thou art a blast of wind in her wings, and they shall be ashamed because of their altars."]]