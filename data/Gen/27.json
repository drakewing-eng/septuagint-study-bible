",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["ἀπὸ",701425,0],["τῆς",709436,16],["πιότητος",710479,17],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["πλῆθος",710529,25],["σίτου",711814,18],["καὶ",707031,7],["οἴνου",709530,18]],"And may God give thee of the dew of heaven, and of the fatness of the earth, and abundance of corn and wine."],["29",[["καὶ",707031,7],["δουλευσάτωσάν",703814,264],["σοι",711925,159],["ἔθνη",704068,64],["καὶ",707031,7],["προσκυνήσουσίν",710925,218],["σοι",711925,159],["ἄρχοντες",701862,52],["καὶ",707031,7],["γίνου",703104,253],["κύριος",707996,4],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["σου",711945,133],["καὶ",707031,7],["προσκυνήσουσίν",710925,218],["σοι",711925,159],["οἱ",709436,136],["υἱοὶ",713075,52],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["ὁ",709436,3],["καταρώμενός",707396,122],["σε",711598,163],["ἐπικατάρατος",705159,14],["ὁ",709436,3],["δὲ",703303,11],["εὐλογῶν",705631,72],["σε",711598,163],["εὐλογημένος",705631,251]],"And let nations serve thee, and princes bow down to thee, and be thou lord of thy brother, and the sons of thy father shall do thee reverence; accursed is he that curses thee, and blessed is he that blesses thee."],["30",[["καὶ",707031,7],["ἐγένετο",703104,23],["μετὰ",708780,0],["τὸ",709436,24],["παύσασθαι",710202,109],["Ισαακ",706799,6],["εὐλογοῦντα",705631,183],["Ιακωβ",706401,6],["τὸν",709436,5],["υἱὸν",713075,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐγένετο",703104,23],["ὡς",714148,7],["ἐξῆλθεν",704909,2],["Ιακωβ",706401,4],["ἀπὸ",701425,0],["προσώπου",710986,21],["Ισαακ",706799,18],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["Ησαυ",706030,4],["ὁ",709436,3],["ἀδελφὸς",700249,4],["αὐτοῦ",702165,102],["ἦλθεν",705453,2],["ἀπὸ",701425,0],["τῆς",709436,16],["θήρας",706244,17]],"And it came to pass after Isaac had ceased blessing his son Jacob, it even came to pass, just when Jacob had gone out from the presence of Isaac his father, that Esau his brother came in from his hunting."],["31",[["καὶ",707031,7],["ἐποίησεν",710582,2],["καὶ",707031,7],["αὐτὸς",702165,121],["ἐδέσματα",704032,42],["καὶ",707031,7],["προσήνεγκεν",710974,2],["τῷ",709436,113],["πατρὶ",710189,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["τῷ",709436,113],["πατρί",710189,114],["ἀναστήτω",701173,45],["ὁ",709436,3],["πατήρ",710189,4],["μου",709032,133],["καὶ",707031,7],["φαγέτω",705495,45],["τῆς",709436,16],["θήρας",706244,17],["τοῦ",709436,35],["υἱοῦ",713075,18],["αὐτοῦ",702165,102],["ὅπως",709719,7],["εὐλογήσῃ",705631,172],["με",708618,163],["ἡ",709436,10],["ψυχή",714070,12],["σου",711945,133]],"And he also had made meats and brought them to his father; and he said to his father, Let my father arise and eat of his son's venison, that thy soul may bless me."],["32",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["Ισαακ",706799,4],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτοῦ",702165,102],["τίς",712867,158],["εἶ",704093,154],["σύ",712181,164],["ὁ",709436,3],["δὲ",703303,11],["εἶπεν",705373,2],["ἐγώ",704018,164],["εἰμι",704093,157],["ὁ",709436,3],["υἱός",713075,4],["σου",711945,133],["ὁ",709436,3],["πρωτότοκος",711046,14],["Ησαυ",706030,4]],"And Isaac his father said to him, Who art thou? And he said, I am thy first-born son Esau."],["33",[["ἐξέστη",704940,2],["δὲ",703303,11],["Ισαακ",706799,4],["ἔκστασιν",704314,9],["μεγάλην",708653,36],["σφόδρα",712586,28],["καὶ",707031,7],["εἶπεν",705373,2],["τίς",712867,158],["οὖν",709835,11],["ὁ",709436,3],["θηρεύσας",706248,182],["μοι",708974,159],["θήραν",706244,9],["καὶ",707031,7],["εἰσενέγκας",704127,182],["μοι",708974,159],["καὶ",707031,7],["ἔφαγον",705495,155],["ἀπὸ",701425,0],["πάντων",710177,83],["πρὸ",710747,0],["τοῦ",709436,20],["σε",711598,163],["ἐλθεῖν",705453,106],["καὶ",707031,7],["ηὐλόγησα",705631,155],["αὐτόν",702165,85],["καὶ",707031,7],["εὐλογημένος",705631,251],["ἔστω",704093,31]],"And Isaac was amazed with very great amazement, and said, Who then is it that has procured venison for me and brought it to me? and I have eaten of all before thou camest, and I have blessed him, and he shall be blessed."],["34",[["ἐγένετο",703104,23],["δὲ",703303,11],["ἡνίκα",706008,28],["ἤκουσεν",700587,2],["Ησαυ",706030,4],["τὰ",709436,41],["ῥήματα",711246,42],["Ισαακ",706799,18],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["ἀνεβόησεν",700915,2],["φωνὴν",713640,9],["μεγάλην",708653,36],["καὶ",707031,7],["πικρὰν",710475,36],["σφόδρα",712586,28],["καὶ",707031,7],["εἶπεν",705373,2],["εὐλόγησον",705631,176],["δὴ",703395,11],["κἀμέ",706969,318],["πάτερ",710189,153]],"And it came to pass when Esau heard the words of his father Isaac, he cried out with a great and very bitter cry, and said, Bless, I pray thee, me also, father."],["35",[["εἶπεν",705373,2],["δὲ",703303,11],["αὐτῷ",702165,50],["ἐλθὼν",705453,182],["ὁ",709436,3],["ἀδελφός",700249,4],["σου",711945,133],["μετὰ",708780,0],["δόλου",703787,18],["ἔλαβεν",708076,2],["τὴν",709436,8],["εὐλογίαν",705633,9],["σου",711945,133]],"And he said to him, Thy brother has come with subtlety, and taken thy blessing."],["36",[["καὶ",707031,7],["εἶπεν",705373,2],["δικαίως",703698,28],["ἐκλήθη",707084,37],["τὸ",709436,34],["ὄνομα",709666,15],["αὐτοῦ",702165,102],["Ιακωβ",706401,4],["ἐπτέρνικεν",711052,171],["γάρ",702963,11],["με",708618,163],["ἤδη",705939,28],["δεύτερον",703389,46],["τοῦτο",709858,129],["τά",709436,41],["τε",712751,11],["πρωτοτόκιά",711045,42],["μου",709032,133],["εἴληφεν",708076,171],["καὶ",707031,7],["νῦν",709384,28],["εἴληφεν",708076,171],["τὴν",709436,8],["εὐλογίαν",705633,9],["μου",709032,133],["καὶ",707031,7],["εἶπεν",705373,2],["Ησαυ",706030,4],["τῷ",709436,113],["πατρὶ",710189,114],["αὐτοῦ",702165,102],["οὐχ",709805,28],["ὑπελίπω",713212,174],["μοι",708974,159],["εὐλογίαν",705633,9],["πάτερ",710189,153]],"And he said, Rightly was his name called Jacob, for lo! this second time has he supplanted me; he has both taken my birthright, and now he has taken my blessing; and Esau said