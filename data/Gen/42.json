[["1",[["ἰδὼν",709725,182],["δὲ",703303,11],["Ιακωβ",706401,4],["ὅτι",709803,7],["ἔστιν",704093,91],["πρᾶσις",710719,12],["ἐν",704639,0],["Αἰγύπτῳ",700401,1],["εἶπεν",705373,2],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτοῦ",702165,102],["ἵνα",706747,7],["τί",712867,126],["ῥᾳθυμεῖτε",711155,87]],"And Jacob having seen that there was a sale [of corn] in Egypt, said to his sons, Why are ye indolent?"],["2",[["ἰδοὺ",706497,88],["ἀκήκοα",700587,89],["ὅτι",709803,7],["ἔστιν",704093,91],["σῖτος",711814,4],["ἐν",704639,0],["Αἰγύπτῳ",700401,1],["κατάβητε",707202,74],["ἐκεῖ",704181,28],["καὶ",707031,7],["πρίασθε",710740,186],["ἡμῖν",705994,90],["μικρὰ",708915,68],["βρώματα",702823,42],["ἵνα",706747,7],["ζῶμεν",705851,243],["καὶ",707031,7],["μὴ",708851,28],["ἀποθάνωμεν",701461,79]],"Behold, I have heard that there is corn in Egypt; go down thither, and buy for us a little food, that we may live, and not die."],["3",[["κατέβησαν",707202,150],["δὲ",703303,11],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["Ιωσηφ",706948,18],["οἱ",709436,136],["δέκα",703333,59],["πρίασθαι",710740,109],["σῖτον",711814,6],["ἐξ",704132,0],["Αἰγύπτου",700401,17]],"And the ten brethren of Joseph went down to buy corn out of Egypt."],["4",[["τὸν",709436,5],["δὲ",703303,11],["Βενιαμιν",702650,6],["τὸν",709436,5],["ἀδελφὸν",700249,6],["Ιωσηφ",706948,18],["οὐκ",709805,28],["ἀπέστειλεν",701592,2],["μετὰ",708780,0],["τῶν",709436,80],["ἀδελφῶν",700249,81],["αὐτοῦ",702165,102],["εἶπεν",705373,2],["γάρ",702963,11],["μήποτε",708882,28],["συμβῇ",712277,172],["αὐτῷ",702165,50],["μαλακία",708435,12]],"But [Jacob] sent not Benjamin, the brother of Joseph, with his brethren; for he said, Lest, haply, disease befal him."],["5",[["ἦλθον",705453,150],["δὲ",703303,11],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["ἀγοράζειν",700184,55],["μετὰ",708780,0],["τῶν",709436,80],["ἐρχομένων",705453,299],["ἦν",704093,13],["γὰρ",702963,11],["ὁ",709436,3],["λιμὸς",708210,4],["ἐν",704639,0],["γῇ",703083,1],["Χανααν",713708,184]],"And the sons of Israel came to buy with those that came, for the famine was in the land of Chanaan."],["6",[["Ιωσηφ",706948,4],["δὲ",703303,11],["ἦν",704093,13],["ἄρχων",701862,4],["τῆς",709436,16],["γῆς",703083,17],["οὗτος",709858,121],["ἐπώλει",711116,13],["παντὶ",710177,30],["τῷ",709436,113],["λαῷ",708094,114],["τῆς",709436,16],["γῆς",703083,17],["ἐλθόντες",705453,196],["δὲ",703303,11],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["Ιωσηφ",706948,18],["προσεκύνησαν",710925,150],["αὐτῷ",702165,50],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9]],"And Joseph was ruler of the land; he sold to all the people of the land. And the brethren of Joseph, having come, did reverence to him, [bowing] with the face to the ground."],["7",[["ἰδὼν",709725,182],["δὲ",703303,11],["Ιωσηφ",706948,4],["τοὺς",709436,58],["ἀδελφοὺς",700249,57],["αὐτοῦ",702165,102],["ἐπέγνω",705104,2],["καὶ",707031,7],["ἠλλοτριοῦτο",700701,19],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐλάλησεν",708071,2],["αὐτοῖς",702165,151],["σκληρὰ",711861,68],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["πόθεν",710580,28],["ἥκατε",705956,330],["οἱ",709436,136],["δὲ",703303,11],["εἶπαν",705373,150],["ἐκ",704132,0],["γῆς",703083,17],["Χανααν",713708,118],["ἀγοράσαι",700184,106],["βρώματα",702823,42]],"And when Joseph saw his brethren, he knew them, and estranged himself from them, and spoke hard words to them; and said to them, Whence are ye come? And they said, Out of the land of Chanaan, to buy food."],["8",[["ἐπέγνω",705104,2],["δὲ",703303,11],["Ιωσηφ",706948,4],["τοὺς",709436,58],["ἀδελφοὺς",700249,57],["αὐτοῦ",702165,102],["αὐτοὶ",702165,201],["δὲ",703303,11],["οὐκ",709805,28],["ἐπέγνωσαν",705104,150],["αὐτόν",702165,85]],"And Joseph knew his brethren, but they knew not him."],["9",[["καὶ",707031,7],["ἐμνήσθη",708960,37],["Ιωσηφ",706948,4],["τῶν",709436,43],["ἐνυπνίων",704818,44],["ὧν",709781,103],["εἶδεν",709725,2],["αὐτός",702165,121],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["κατάσκοποί",707427,52],["ἐστε",704093,87],["κατανοῆσαι",707341,106],["τὰ",709436,41],["ἴχνη",706873,42],["τῆς",709436,16],["χώρας",714011,17],["ἥκατε",705956,330]],"And Joseph remembered his dream, which he saw; and he said to them, Ye are spies; to observe the marks of the land are ye come."],["10",[["οἱ",709436,136],["δὲ",703303,11],["εἶπαν",705373,150],["οὐχί",709862,28],["κύριε",707996,153],["οἱ",709436,136],["παῖδές",709932,52],["σου",711945,133],["ἤλθομεν",705453,289],["πρίασθαι",710740,109],["βρώματα",702823,42]],"But they said, Nay, Sir, we thy servants are come to buy food;"],["11",[["πάντες",710177,138],["ἐσμὲν",704093,243],["υἱοὶ",713075,52],["ἑνὸς",704106,116],["ἀνθρώπου",701163,18],["εἰρηνικοί",704099,138],["ἐσμεν",704093,243],["οὐκ",709805,28],["εἰσὶν",704093,197],["οἱ",709436,136],["παῖδές",709932,52],["σου",711945,133],["κατάσκοποι",707427,52]],"we are all sons of one man; we are peaceable, thy servants are not spies."],["12",[["εἶπεν",705373,2],["δὲ",703303,11],["αὐτοῖς",702165,151],["οὐχί",709862,28],["ἀλλὰ",700680,7],["τὰ",709436,41],["ἴχνη",706873,42],["τῆς",709436,16],["γῆς",703083,17],["ἤλθατε",705453,265],["ἰδεῖν",704075,106]],"And he said to them, Nay, but ye are come to observe the marks of the land."],["13",[["οἱ",709436,136],["δὲ",703303,11],["εἶπαν",705373,150],["δώδεκά",703887,59],["ἐσμεν",704093,243],["οἱ",709436,136],["παῖδές",709932,52],["σου",711945,133],["ἀδελφοὶ",700249,52],["ἐν",704639,0],["γῇ",703083,1],["Χανααν",713708,184],["καὶ",707031,7],["ἰδοὺ",706497,88],["ὁ",709436,3],["νεώτερος",709256,224],["μετὰ",708780,0],["τοῦ",709436,35],["πατρὸς",710189,18],["ἡμῶν",705999,145],["σήμερον",711751,28],["ὁ",709436,3],["δὲ",703303,11],["ἕτερος",705535,14],["οὐχ",709805,28],["ὑπάρχει",713104,91]],"And they said, We thy servants are twelve brethren, in the land of Chanaan; and, behold, the youngest is with our father to-day, but the other one is not."],["14",[["εἶπεν",705373,2],["δὲ",703303,11],["αὐτοῖς",702165,151],["Ιωσηφ",706948,4],["τοῦτό",709858,132],["ἐστιν",704093,91],["ὃ",709781,128],["εἴρηκα",705415,89],["ὑμῖν",713084,90],["λέγων",708124,72],["ὅτι",709803,7],["κατάσκοποί",707427,52],["ἐστε",704093,87]],"And Joseph said to them, This is it that I spoke to you, saying, ye are spies;"],["15",[["ἐν",704639,0],["τούτῳ",709858,280],["φανεῖσθε",713311,124],["νὴ",709291,11],["τὴν",709436,8],["ὑγίειαν",713058,9],["Φαραω",713360,18],["οὐ",709805,28],["μὴ",708851,28],["ἐξέλθητε",704909,125],["ἐντεῦθεν",704793,28],["ἐὰν",703912,7],["μὴ",708851,28],["ὁ",709436,3],["ἀδελφὸς",700249,4],["ὑμῶν",713091,145],["ὁ",709436,3],["νεώτερος",709256,224],["ἔλθῃ",705453,172],["ὧδε",714090,28]],"herein shall ye be manifested; by the health of Pharao, ye shall not depart hence, unless your younger brother come hither."],["16",[["ἀποστείλατε",701592,74],["ἐξ",704132,0],["ὑμῶν",713091,145],["ἕνα",704106,27],["καὶ",707031,7],["λάβετε",708076,74],["τὸν",709436,5],["ἀδελφὸν",700249,6],["ὑμῶν",713091,145],["ὑμεῖς",713081,219],["δὲ",703303,11],["ἀπάχθητε",701324,372],["ἕως",705792,0],["τοῦ",709436,20],["φανερὰ",713342,68],["γενέσθαι",703104,109],["τὰ",709436,41],["ῥήματα",711246,42],["ὑμῶν",713091,145],["εἰ",704071,7],["ἀληθεύετε",700657,87],["ἢ",705924,7],["οὔ",709805,28],["εἰ",704071,7],["δὲ",703303,11],["μή",708851,28],["νὴ",709291,11],["τὴν",709436,8],["ὑγίειαν",713058,9],["Φαραω",713360,18],["ἦ",705925,28],["μὴν",708873,11],["κατάσκοποί",707427,52],["ἐστε",704093,87]],"Send one of you, and take your brother; and go ye to prison, till your words be clear, whether ye speak the truth or not; but, if not, by the health of Pharao, verily ye are spies."],["17",[["καὶ",707031,7],["ἔθετο",712849,23],["αὐτοὺς",702165,62],["ἐν",704639,0],["φυλακῇ",713613,1],["ἡμέρας",705984,39],["τρεῖς",712927,119]],"And he put them in prison three days."],["18",[["εἶπεν",705373,2],["δὲ",703303,11],["αὐτοῖς",702165,151],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["τρίτῃ",712968,101],["τοῦτο",709858,129],["ποιήσατε",710582,74],["καὶ",707031,7],["ζήσεσθε",705851,124],["τὸν",709436,5],["θεὸν",706192,6],["γὰρ",702963,11],["ἐγὼ",704018,164],["φοβοῦμαι",713532,254]],"And he said to them on the third day, This do, and ye shall live, for I fear God."],["19",[["εἰ",704071,7],["εἰρηνικοί",704099,138],["ἐστε",704093,87],["ἀδελφὸς",700249,4],["ὑμῶν",713091,145],["εἷς",704106,14],["κατασχεθήτω",707526,22],["ἐν",704639,0],["τῇ",709436,100],["φυλακῇ",713613,1],["αὐτοὶ",702165,201],["δὲ",703303,11],["βαδίσατε",702367,74],["καὶ",707031,7],["ἀπαγάγετε",701324,74],["τὸν",709436,5],["ἀγορασμὸν",700186,6],["τῆς",709436,16],["σιτοδοσίας",711811,17],["ὑμῶν",713091,145]],"If ye be peaceable, let one of your brethren be detained in prison; but go ye, and carry back the corn ye have purchased."],["20",[["καὶ",707031,7],["τὸν",709436,5],["ἀδελφὸν",700249,6],["ὑμῶν",713091,145],["τὸν",709436,5],["νεώτερον",709256,61],["ἀγάγετε",700209,74],["πρός",710844,0],["με",708618,163],["καὶ",707031,7],["πιστευθήσονται",710483,144],["τὰ",709436,63],["ῥήματα",711246,64],["ὑμῶν",713091,145],["εἰ",704071,7],["δὲ",703303,11],["μή",708851,28],["ἀποθανεῖσθε",701461,124],["ἐποίησαν",710582,150],["δὲ",703303,11],["οὕτως",709859,28]],"And bring your younger brother to me, and your words shall be believed; but, if not, ye shall die. And they did so."],["21",[["καὶ",707031,7],["εἶπεν",705373,2],["ἕκαστος",704133,14],["πρὸς",710844,0],["τὸν",709436,5],["ἀδελφὸν",700249,6],["αὐτοῦ",702165,102],["ναί",709173,88],["ἐν",704639,0],["ἁμαρτίᾳ",700775,1],["γάρ",702963,11],["ἐσμεν",704093,243],["περὶ",710285,0],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["ἡμῶν",705999,145],["ὅτι",709803,7],["ὑπερείδομεν",713130,289],["τὴν",709436,8],["θλῖψιν",706276,9],["τῆς",709436,16],["ψυχῆς",714070,17],["αὐτοῦ",702165,102],["ὅτε",709802,28],["κατεδέετο",707239,19],["ἡμῶν",705999,145],["καὶ",707031,7],["οὐκ",709805,28],["εἰσηκούσαμεν",704108,289],["αὐτοῦ",702165,102],["ἕνεκεν",704709,0],["τούτου",709858,49],["ἐπῆλθεν",705068,2],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["ἡ",709436,10],["θλῖψις",706276,12],["αὕτη",709858,107]],"And each said to his brother, Yes, indeed, for we are in fault concerning our brother, when we disregarded the anguish of his soul, when he besought us, and we hearkened not to him; and therefore has this affliction come upon us."],["22",[["ἀποκριθεὶς",701492,217],["δὲ",703303,11],["Ρουβην",711295,4],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["οὐκ",709805,28],["ἐλάλησα",708071,155],["ὑμῖν",713084,90],["λέγων",708124,72],["μὴ",708851,28],["ἀδικήσητε",700269,125],["τὸ",709436,24],["παιδάριον",709923,25],["καὶ",707031,7],["οὐκ",709805,28],["εἰσηκούσατέ",704108,265],["μου",709032,133],["καὶ",707031,7],["ἰδοὺ",706497,88],["τὸ",709436,34],["αἷμα",700442,15],["αὐτοῦ",702165,102],["ἐκζητεῖται",704187,117]],"And Ruben answered them, saying, Did I not speak to you, saying, Hurt not the boy, and ye heard me not? and, behold, his blood is required."],["23",[["αὐτοὶ",702165,201],["δὲ",703303,11],["οὐκ",709805,28],["ᾔδεισαν",704075,263],["ὅτι",709803,7],["ἀκούει",700587,91],["Ιωσηφ",706948,4],["ὁ",709436,3],["γὰρ",702963,11],["ἑρμηνευτὴς",705434,4],["ἀνὰ",700902,0],["μέσον",708768,27],["αὐτῶν",702165,40],["ἦν",704093,13]],"But they knew not that Joseph understood them; for there was an interpreter between them."],["24",[["ἀποστραφεὶς",701598,217],["δὲ",703303,11],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["ἔκλαυσεν",707703,2],["Ιωσηφ",706948,4],["καὶ",707031,7],["πάλιν",709942,28],["προσῆλθεν",710890,2],["πρὸς",710844,0],["αὐτοὺς",702165,62],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἔλαβεν",708076,2],["τὸν",709436,5],["Συμεων",712297,6],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["καὶ",707031,7],["ἔδησεν",703394,2],["αὐτὸν",702165,85],["ἐναντίον",704654,0],["αὐτῶν",702165,40]],"And Joseph turned away from them, and wept; and again he came to them, and spoke to them; and he took Symeon from them, and bound him before their eyes."],["25",[["ἐνετείλατο",704791,23],["δὲ",703303,11],["Ιωσηφ",706948,4],["ἐμπλῆσαι",704592,106],["τὰ",709436,41],["ἀγγεῖα",700138,42],["αὐτῶν",702165,40],["σίτου",711814,18],["καὶ",707031,7],["ἀποδοῦναι",701449,106],["τὸ",709436,24],["ἀργύριον",701707,25],["ἑκάστου",704133,116],["εἰς",704105,0],["τὸν",709436,5],["σάκκον",711386,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["δοῦναι",703654,106],["αὐτοῖς",702165,151],["ἐπισιτισμὸν",705247,6],["εἰς",704105,0],["τὴν",709436,8],["ὁδόν",709458,9],["καὶ",707031,7],["ἐγενήθη",703104,37],["αὐτοῖς",702165,151],["οὕτως",709859,28]],"And Joseph gave orders to fill their vessels with corn, and to return their money to each into his sack, and to give them provision for the way; and it was so done to them."],["26",[["καὶ",707031,7],["ἐπιθέντες",705304,196],["τὸν",709436,5],["σῖτον",711814,6],["ἐπὶ",705080,0],["τοὺς",709436,58],["ὄνους",709671,57],["αὐτῶν",702165,40],["ἀπῆλθον",701398,150],["ἐκεῖθεν",704182,28]],"And having put the corn on the asses, they departed thence."],["27",[["λύσας",708288,182],["δὲ",703303,11],["εἷς",704106,14],["τὸν",709436,5],["μάρσιππον",708522,6],["αὐτοῦ",702165,102],["δοῦναι",703654,106],["χορτάσματα",713921,42],["τοῖς",709436,147],["ὄνοις",709671,148],["αὐτοῦ",702165,102],["οὗ",709806,28],["κατέλυσαν",707323,150],["εἶδεν",704075,2],["τὸν",709436,5],["δεσμὸν",703372,6],["τοῦ",709436,20],["ἀργυρίου",701707,21],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἦν",704093,13],["ἐπάνω",705030,0],["τοῦ",709436,20],["στόματος",712125,21],["τοῦ",709436,35],["μαρσίππου",708522,18]],"And one having opened his sack to give his asses fodder, at the place where they rested, saw also his bundle of money, for it was on the mouth of his sack."],["28",[["καὶ",707031,7],["εἶπεν",705373,2],["τοῖς",709436,147],["ἀδελφοῖς",700249,148],["αὐτοῦ",702165,102],["ἀπεδόθη",701449,37],["μοι",708974,159],["τὸ",709436,34],["ἀργύριον",701707,15],["καὶ",707031,7],["ἰδοὺ",706497,88],["τοῦτο",709858,132],["ἐν",704639,0],["τῷ",709436,113],["μαρσίππῳ",708522,114],["μου",709032,133],["καὶ",707031,7],["ἐξέστη",704940,2],["ἡ",709436,10],["καρδία",707141,12],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐταράχθησαν",712721,99],["πρὸς",710844,0],["ἀλλήλους",700689,62],["λέγοντες",708124,146],["τί",712867,126],["τοῦτο",709858,129],["ἐποίησεν",710582,2],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῖν",705994,90]],"And he said to his brethren, My money has been restored to me, and behold this is in my sack. And their heart was wonder-struck, and they were troubled, saying one to another, What is this that God has done to us?"],["29",[["ἦλθον",705453,150],["δὲ",703303,11],["πρὸς",710844,0],["Ιακωβ",706401,6],["τὸν",709436,5],["πατέρα",710189,6],["αὐτῶν",702165,40],["εἰς",704105,0],["γῆν",703083,9],["Χανααν",713708,184],["καὶ",707031,7],["ἀπήγγειλαν",701321,150],["αὐτῷ",702165,50],["πάντα",710177,68],["τὰ",709436,41],["συμβάντα",712277,373],["αὐτοῖς",702165,151],["λέγοντες",708124,146]],"And they came to their father, Jacob, into the land of Chanaan, and reported to him all that had happened to them, saying,"],["30",[["λελάληκεν",708071,171],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ὁ",709436,3],["κύριος",707996,4],["τῆς",709436,16],["γῆς",703083,17],["πρὸς",710844,0],["ἡμᾶς",705981,194],["σκληρὰ",711861,68],["καὶ",707031,7],["ἔθετο",712849,23],["ἡμᾶς",705981,194],["ἐν",704639,0],["φυλακῇ",713613,1],["ὡς",714148,7],["κατασκοπεύοντας",707426,235],["τὴν",709436,8],["γῆν",703083,9]],"The man, the lord of the land, spoke harsh words to us, and put us in prison as spies of the land."],["31",[["εἴπαμεν",705373,289],["δὲ",703303,11],["αὐτῷ",702165,50],["εἰρηνικοί",704099,138],["ἐσμεν",704093,243],["οὔκ",709805,28],["ἐσμεν",704093,243],["κατάσκοποι",707427,52]],"And we said to him, We are men of peace, we are not spies."],["32",[["δώδεκα",703887,59],["ἀδελφοί",700249,52],["ἐσμεν",704093,243],["υἱοὶ",713075,52],["τοῦ",709436,35],["πατρὸς",710189,18],["ἡμῶν",705999,145],["ὁ",709436,3],["εἷς",704106,14],["οὐχ",709805,28],["ὑπάρχει",713104,91],["ὁ",709436,3],["δὲ",703303,11],["