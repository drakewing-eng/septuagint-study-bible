[["1",[["καὶ",707031,7],["ηὐλόγησεν",705631,2],["ὁ",709436,3],["θεὸς",706192,4],["τὸν",709436,5],["Νωε",709395,6],["καὶ",707031,7],["τοὺς",709436,58],["υἱοὺς",713075,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["αὐξάνεσθε",702144,73],["καὶ",707031,7],["πληθύνεσθε",710530,73],["καὶ",707031,7],["πληρώσατε",710543,74],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["κατακυριεύσατε",707297,74],["αὐτῆς",702165,86]],"And God blessed Noe and his sons, and said to them, Increase and multiply, and fill the earth and have dominion over it."],["2",[["καὶ",707031,7],["ὁ",709436,3],["τρόμος",712975,4],["ὑμῶν",713091,145],["καὶ",707031,7],["ὁ",709436,3],["φόβος",713534,4],["ἔσται",704093,93],["ἐπὶ",705080,0],["πᾶσιν",710177,94],["τοῖς",709436,95],["θηρίοις",706252,96],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἐπὶ",705080,0],["πάντα",710177,68],["τὰ",709436,41],["ὄρνεα",709762,42],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["ἐπὶ",705080,0],["πάντα",710177,68],["τὰ",709436,41],["κινούμενα",707679,67],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἐπὶ",705080,0],["πάντας",710177,60],["τοὺς",709436,58],["ἰχθύας",706870,57],["τῆς",709436,16],["θαλάσσης",706069,17],["ὑπὸ",713184,0],["χεῖρας",713787,39],["ὑμῖν",713084,90],["δέδωκα",703654,89]],"And the dread and the fear of you shall be upon all the wild beasts of the earth, on all the birds of the sky, and on all things moving upon the earth, and upon all the fishes of the sea, I have placed them under your power."],["3",[["καὶ",707031,7],["πᾶν",710177,26],["ἑρπετόν",705441,15],["ὅ",709781,33],["ἐστιν",704093,91],["ζῶν",705851,32],["ὑμῖν",713084,90],["ἔσται",704093,93],["εἰς",704105,0],["βρῶσιν",702825,9],["ὡς",714148,7],["λάχανα",708114,64],["χόρτου",713923,18],["δέδωκα",703654,89],["ὑμῖν",713084,90],["τὰ",709436,41],["πάντα",710177,68]],"And every reptile which is living shall be to you for meat, I have given all things to you as the green herbs."],["4",[["πλὴν",710540,28],["κρέας",707889,25],["ἐν",704639,0],["αἵματι",700442,54],["ψυχῆς",714070,17],["οὐ",709805,28],["φάγεσθε",705495,124]],"But flesh with blood of life ye shall not eat."],["5",[["καὶ",707031,7],["γὰρ",702963,11],["τὸ",709436,34],["ὑμέτερον",713083,26],["αἷμα",700442,15],["τῶν",709436,130],["ψυχῶν",714070,65],["ὑμῶν",713091,145],["ἐκζητήσω",704187,207],["ἐκ",704132,0],["χειρὸς",713787,17],["πάντων",710177,83],["τῶν",709436,43],["θηρίων",706252,44],["ἐκζητήσω",704187,207],["αὐτὸ",702165,129],["καὶ",707031,7],["ἐκ",704132,0],["χειρὸς",713787,17],["ἀνθρώπου",701163,18],["ἀδελφοῦ",700249,18],["ἐκζητήσω",704187,207],["τὴν",709436,8],["ψυχὴν",714070,9],["τοῦ",709436,35],["ἀνθρώπου",701163,18]],"For your blood of your lives will I require at the hand of all wild beasts, and I will require the life of man at the hand of [his] brother man."],["6",[["ὁ",709436,3],["ἐκχέων",704368,72],["αἷμα",700442,25],["ἀνθρώπου",701163,18],["ἀντὶ",701227,0],["τοῦ",709436,20],["αἵματος",700442,21],["αὐτοῦ",702165,102],["ἐκχυθήσεται",704368,134],["ὅτι",709803,7],["ἐν",704639,0],["εἰκόνι",704089,1],["θεοῦ",706192,18],["ἐποίησα",710582,155],["τὸν",709436,5],["ἄνθρωπον",701163,6]],"He that sheds man's blood, instead of that blood shall his own be shed, for in the image of God I made man."],["7",[["ὑμεῖς",713081,219],["δὲ",703303,11],["αὐξάνεσθε",702144,73],["καὶ",707031,7],["πληθύνεσθε",710530,73],["καὶ",707031,7],["πληρώσατε",710543,74],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["πληθύνεσθε",710530,73],["ἐπ᾿",705080,0],["αὐτῆς",702165,86]],"But do ye increase and multiply, and fill the earth, and have dominion over it."],["8",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["θεὸς",706192,4],["τῷ",709436,113],["Νωε",709395,114],["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτοῦ",702165,102],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["λέγων",708124,72]],"And God spoke to Noe, and to his sons with him, saying,"],["9",[["ἐγὼ",704018,164],["ἰδοὺ",706497,88],["ἀνίστημι",701173,157],["τὴν",709436,8],["διαθήκην",703456,9],["μου",709032,133],["ὑμῖν",713084,90],["καὶ",707031,7],["τῷ",709436,53],["σπέρματι",712008,54],["ὑμῶν",713091,145],["μεθ᾿",708780,0],["ὑμᾶς",713080,194]],"And behold I establish my covenant with you, and with your seed after you,"],["10",[["καὶ",707031,7],["πάσῃ",710177,101],["ψυχῇ",714070,1],["τῇ",709436,100],["ζώσῃ",705851,220],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["ἀπὸ",701425,0],["ὀρνέων",709762,44],["καὶ",707031,7],["ἀπὸ",701425,0],["κτηνῶν",707934,44],["καὶ",707031,7],["πᾶσι",710177,94],["τοῖς",709436,95],["θηρίοις",706252,96],["τῆς",709436,16],["γῆς",703083,17],["ὅσα",709788,195],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["ἀπὸ",701425,0],["πάντων",710177,169],["τῶν",709436,80],["ἐξελθόντων",704909,221],["ἐκ",704132,0],["τῆς",709436,16],["κιβωτοῦ",707667,17]],"and with every living creature with you, of birds and of beasts, and with all the wild beasts of the earth, as many as are with you, of all that come out of the ark."],["11",[["καὶ",707031,7],["στήσω",706846,165],["τὴν",709436,8],["διαθήκην",703456,9],["μου",709032,133],["πρὸς",710844,0],["ὑμᾶς",713080,194],["καὶ",707031,7],["οὐκ",709805,28],["ἀποθανεῖται",701461,93],["πᾶσα",710177,29],["σὰρξ",711537,12],["ἔτι",705538,28],["ἀπὸ",701425,0],["τοῦ",709436,20],["ὕδατος",713071,21],["τοῦ",709436,35],["κατακλυσμοῦ",707279,18],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ἔτι",705538,28],["κατακλυσμὸς",707279,4],["ὕδατος",713071,21],["τοῦ",709436,20],["καταφθεῖραι",707474,106],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9]],"And I will establish my covenant with you and all flesh shall not any more die by the water of the flood, and there shall no more be a flood of water to destroy all the earth."],["12",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["πρὸς",710844,0],["Νωε",709395,6],["τοῦτο",709858,132],["τὸ",709436,34],["σημεῖον",711748,15],["τῆς",709436,16],["διαθήκης",703456,17],["ὃ",709781,128],["ἐγὼ",704018,164],["δίδωμι",703654,157],["ἀνὰ",700902,0],["μέσον",708768,27],["ἐμοῦ",704580,133],["καὶ",707031,7],["ὑμῶν",713091,145],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,27],["πάσης",710177,82],["ψυχῆς",714070,17],["ζώσης",705851,222],["ἥ",709781,177],["ἐστιν",704093,91],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["εἰς",704105,0],["γενεὰς",703037,39],["αἰωνίους",700505,119]],"And the Lord God said to Noe, This [is] the sign of the covenant which I set between me and you, and between every living creature which is with you for perpetual generations."],["13",[["τὸ",709436,24],["τόξον",712898,25],["μου",709032,133],["τίθημι",712849,157],["ἐν",704639,0],["τῇ",709436,100],["νεφέλῃ",709277,1],["καὶ",707031,7],["ἔσται",704093,93],["εἰς",704105,0],["σημεῖον",711748,25],["διαθήκης",703456,17],["ἀνὰ",700902,0],["μέσον",708768,27],["ἐμοῦ",704580,133],["καὶ",707031,7],["τῆς",709436,16],["γῆς",703083,17]],"I set my bow in the cloud, and it shall be for a sign of covenant between me and the earth."],["14",[["καὶ",707031,7],["ἔσται",704093,93],["ἐν",704639,0],["τῷ",709436,53],["συννεφεῖν",712484,55],["με",708618,163],["νεφέλας",709277,39],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["ὀφθήσεται",709725,134],["τὸ",709436,24],["τόξον",712898,25],["μου",709032,133],["ἐν",704639,0],["τῇ",709436,100],["νεφέλῃ",709277,1]],"And it shall be when I gather clouds upon the earth, that my bow shall be seen in the cloud."],["15",[["καὶ",707031,7],["μνησθήσομαι",708923,180],["τῆς",709436,16],["διαθήκης",703456,17],["μου",709032,133],["ἥ",709781,177],["ἐστιν",704093,91],["ἀνὰ",700902,0],["μέσον",708768,27],["ἐμοῦ",704580,133],["καὶ",707031,7],["ὑμῶν",713091,145],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,27],["πάσης",710177,82],["ψυχῆς",714070,17],["ζώσης",705851,222],["ἐν",704639,0],["πάσῃ",710177,101],["σαρκί",711537,1],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ἔτι",705538,28],["τὸ",709436,34],["ὕδωρ",713071,15],["εἰς",704105,0],["κατακλυσμὸν",707279,6],["ὥστε",714164,7],["ἐξαλεῖψαι",704852,106],["πᾶσαν",710177,36],["σάρκα",711537,9]],"And I will remember my covenant, which is between me and you, and between every living soul in all flesh, and there shall no longer be water for a deluge, so as to blot out all flesh."],["16",[["καὶ",707031,7],["ἔσται",704093,93],["τὸ",709436,34],["τόξον",712898,15],["μου",709032,133],["ἐν",704639,0],["τῇ",709436,100],["νεφέλῃ",709277,1],["καὶ",707031,7],["ὄψομαι",709725,181],["τοῦ",709436,20],["μνησθῆναι",708960,179],["διαθήκην",703456,9],["αἰώνιον",700505,36],["ἀνὰ",700902,0],["μέσον",708768,27],["ἐμοῦ",704580,133],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,27],["πάσης",710177,82],["ψυχῆς",714070,17],["ζώσης",705851,222],["ἐν",704639,0],["πάσῃ",710177,101],["σαρκί",711537,1],["ἥ",709781,177],["ἐστιν",704093,91],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"And my bow shall be in the cloud, and I will look to remember the everlasting covenant between me and the earth, and between [every] living soul in all flesh, which is upon the earth."],["17",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["θεὸς",706192,4],["τῷ",709436,113],["Νωε",709395,114],["τοῦτο",709858,132],["τὸ",709436,34],["σημεῖον",711748,15],["τῆς",709436,16],["διαθήκης",703456,17],["ἧς",709781,167],["διεθέμην",703609,161],["ἀνὰ",700902,0],["μέσον",708768,27],["ἐμοῦ",704580,133],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,27],["πάσης",710177,82],["σαρκός",711537,17],["ἥ",709781,177],["ἐστιν",704093,91],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"And God said to Noe, This [is] the sign of the covenant, which I have made between me and all flesh, which is upon the earth."],["18",[["ἦσαν",704093,137],["δὲ",703303,11],["οἱ",709436,136],["υἱοὶ",713075,52],["Νωε",709395,18],["οἱ",709436,136],["ἐξελθόντες",704909,196],["ἐκ",704132,0],["τῆς",709436,16],["κιβωτοῦ",707667,17],["Σημ",711743,4],["Χαμ",713699,4],["Ιαφεθ",706462,4],["Χαμ",713699,4],["ἦν",704093,13],["πατὴρ",710189,4],["Χανααν",713708,18]],"Now the sons of Noe which came out of the ark, were Sem, Cham, Japheth. And Cham was father of Chanaan."],["19",[["τρεῖς",712927,138],["οὗτοί",709858,201],["εἰσιν",704093,197],["οἱ",709436,136],["υἱοὶ",713075,52],["Νωε",709395,18],["ἀπὸ",701425,0],["τούτων",709858,40],["διεσπάρησαν",703584,99],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9]],"These three are the sons of Noe, of these were men scattered over all the earth."],["20",[["καὶ",707031,7],["ἤρξατο",701860,23],["Νωε",709395,4],["ἄνθρωπος",701163,4],["γεωργὸς",703082,4],["γῆς",703083,17],["καὶ",707031,7],["ἐφύτευσεν",713636,2],["ἀμπελῶνα",700872,6]],"And Noe began to be a husbandman, and he planted a vineyard."],["21",[["καὶ",707031,7],["ἔπιεν",710478,2],["ἐκ",704132,0],["τοῦ",709436,35],["οἴνου",709530,18],["καὶ",707031,7],["ἐμεθύσθη",708676,37],["καὶ",707031,7],["ἐγυμνώθη",703204,37],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["αὐτοῦ",702165,102]],"And he drank of the wine, and was drunk, and was naked in his house."],["22",[["καὶ",707031,7],["εἶδεν",709725,2],["Χαμ",713699,4],["ὁ",709436,3],["πατὴρ",710189,4],["Χανααν",713708,18],["τὴν",709436,8],["γύμνωσιν",703205,9],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐξελθὼν",704909,182],["ἀνήγγειλεν",700921,2],["τοῖς",709436,147],["δυσὶν",703849,223],["ἀδελφοῖς",700249,148],["αὐτοῦ",702165,102],["ἔξω",704983,28]],"And Cham the father of Chanaan saw the nakedness of his father, and he went out and told his two brothers without."],["23",[["καὶ",707031,7],["λαβόντες",708076,196],["Σημ",711743,4],["καὶ",707031,7],["Ιαφεθ",706462,4],["τὸ",709436,24],["ἱμάτιον",706742,25],["ἐπέθεντο",705304,189],["ἐπὶ",705080,0],["τὰ",709436,41],["δύο",703849,59],["νῶτα",709403,42],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["ὀπισθοφανῶς",709696,28],["καὶ",707031,7],["συνεκάλυψαν",712201,150],["τὴν",709436,8],["γύμνωσιν",703205,9],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτῶν",702165,40],["καὶ",707031,7],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτῶν",702165,40],["ὀπισθοφανές",709695,46],["καὶ",707031,7],["τὴν",709436,8],["γύμνωσιν",703205,9],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτῶν",702165,40],["οὐκ",709805,28],["εἶδον",709725,150]],"And Sem and Japheth having taken a garment, put it on both their backs and went backwards, and covered the nakedness of their father; and their face [was] backward, and they saw not the nakedness of their father."],["24",[["ἐξένηψεν",704265,2],["δὲ",703303,11],["Νωε",709395,4],["ἀπὸ",701425,0],["τοῦ",709436,35],["οἴνου",709530,18],["καὶ",707031,7],["ἔγνω",703105,2],["ὅσα",709788,68],["ἐποίησεν",710582,2],["αὐτῷ",702165,50],["ὁ",709436,3],["υἱὸς",713075,4],["αὐτοῦ",702165,102],["ὁ",709436,3],["νεώτερος",709256,224]],"And Noe recovered from the wine, and knew all that his younger son had done to him."],["25",[["καὶ",707031,7],["εἶπεν",705373,2],["ἐπικατάρατος",705159,14],["Χανααν",713708,4],["παῖς",709932,4],["οἰκέτης",709496,4],["ἔσται",704093,93],["τοῖς",709436,147],["ἀδελφοῖς",700249,148],["αὐτοῦ",702165,102]],"And he said, Cursed be the servant Chanaan, a slave shall he be to his brethren."],["26",[["καὶ",707031,7],["εἶπεν",705373,2],["εὐλογητὸς",705632,14],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τοῦ",709436,35],["Σημ",711743,18],["καὶ",707031,7],["ἔσται",704093,93],["Χανααν",713708,4],["παῖς",709932,4],["αὐτοῦ",702165,102]],"And he said, Blessed [be] the Lord God of Sem, and Chanaan shall be his bond-servant."],["27",[["πλατύναι",710508,225],["ὁ",709436,3],["θεὸς",706192,4],["τῷ",709436,113],["Ιαφεθ",706462,114],["καὶ",707031,7],["κατοικησάτω",707534,45],["ἐν",704639,0],["τοῖς",709436,147],["οἴκοις",709516,148],["τοῦ",709436,35],["Σημ",711743,18],["καὶ",707031,7],["γενηθήτω",703104,22],["Χανααν",713708,4],["παῖς",709932,4],["αὐτῶν",702165,40]],"May God make room for Japheth, and let him dwell in the habitations of Sem, and let Chanaan be his servant."],["28",[["ἔζησεν",705851,2],["δὲ",703303,11],["Νωε",709395,4],["μετὰ",708780,0],["τὸν",709436,5],["κατακλυσμὸν",707279,6],["τριακόσια",712936,68],["πεντήκοντα",710270,59],["ἔτη",705543,42]],"And Noe lived after the flood three hundred and fifty years."],["29",[["καὶ",707031,7],["ἐγένοντο",703104,189],["πᾶσαι",710177,192],["αἱ",709436,190],["ἡμέραι",705984,191],["Νωε",709395,18],["ἐννακόσια",704752,195],["πεντήκοντα",710270,59],["ἔτη",705543,64],["καὶ",707031,7],["ἀπέθανεν",701461,2]],"And all the days of Noe were nine hundred and fifty years, and he died."]]