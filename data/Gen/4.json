[["1",[["Αδαμ",700222,4],["δὲ",703303,11],["ἔγνω",703105,2],["Ευαν",705545,9],["τὴν",709436,8],["γυναῖκα",703209,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["συλλαβοῦσα",712262,149],["ἔτεκεν",712853,2],["τὸν",709436,5],["Καιν",707035,6],["καὶ",707031,7],["εἶπεν",705373,2],["ἐκτησάμην",707932,161],["ἄνθρωπον",701163,6],["διὰ",703417,0],["τοῦ",709436,35],["θεοῦ",706192,18]],"And Adam knew Eve his wife, and she conceived and brought forth Cain and said, I have gained a man through God."],["2",[["καὶ",707031,7],["προσέθηκεν",710965,2],["τεκεῖν",712853,106],["τὸν",709436,5],["ἀδελφὸν",700249,6],["αὐτοῦ",702165,102],["τὸν",709436,5],["Αβελ",700040,6],["καὶ",707031,7],["ἐγένετο",703104,23],["Αβελ",700040,4],["ποιμὴν",710596,4],["προβάτων",710768,44],["Καιν",707035,4],["δὲ",703303,11],["ἦν",704093,13],["ἐργαζόμενος",705383,122],["τὴν",709436,8],["γῆν",703083,9]],"And she again bore his brother Abel. And Abel was a keeper of sheep, but Cain was a tiller of the ground."],["3",[["καὶ",707031,7],["ἐγένετο",703104,23],["μεθ᾿",708780,0],["ἡμέρας",705984,39],["ἤνεγκεν",713428,2],["Καιν",707035,4],["ἀπὸ",701425,0],["τῶν",709436,80],["καρπῶν",707169,81],["τῆς",709436,16],["γῆς",703083,17],["θυσίαν",706345,9],["τῷ",709436,113],["κυρίῳ",707996,114]],"And it was so after some time that Cain brought of the fruits of the earth a sacrifice to the Lord."],["4",[["καὶ",707031,7],["Αβελ",700040,4],["ἤνεγκεν",713428,2],["καὶ",707031,7],["αὐτὸς",702165,121],["ἀπὸ",701425,0],["τῶν",709436,80],["πρωτοτόκων",711046,169],["τῶν",709436,43],["προβάτων",710768,44],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,43],["στεάτων",712054,44],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπεῖδεν",705057,2],["ὁ",709436,3],["θεὸς",706192,4],["ἐπὶ",705080,0],["Αβελ",700040,114],["καὶ",707031,7],["ἐπὶ",705080,0],["τοῖς",709436,95],["δώροις",703907,96],["αὐτοῦ",702165,102]],"And Abel also brought of the firstborn of his sheep and of his fatlings, and God looked upon Abel and his gifts,"],["5",[["ἐπὶ",705080,0],["δὲ",703303,11],["Καιν",707035,114],["καὶ",707031,7],["ἐπὶ",705080,0],["ταῖς",709436,75],["θυσίαις",706345,76],["αὐτοῦ",702165,102],["οὐ",709805,28],["προσέσχεν",710895,2],["καὶ",707031,7],["ἐλύπησεν",708272,2],["τὸν",709436,5],["Καιν",707035,6],["λίαν",708184,28],["καὶ",707031,7],["συνέπεσεν",712332,2],["τῷ",709436,53],["προσώπῳ",710986,54]],"but Cain and his sacrifices he regarded not, and Cain was exceedingly sorrowful and his countenance fell."],["6",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τῷ",709436,113],["Καιν",707035,114],["ἵνα",706747,7],["τί",712867,126],["περίλυπος",710346,14],["ἐγένου",703104,174],["καὶ",707031,7],["ἵνα",706747,7],["τί",712867,126],["συνέπεσεν",712332,2],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133]],"And the Lord God said to Cain, Why art thou become very sorrowful and why is thy countenance fallen?"],["7",[["οὐκ",709805,28],["ἐὰν",703912,7],["ὀρθῶς",709746,28],["προσενέγκῃς",710974,175],["ὀρθῶς",709746,28],["δὲ",703303,11],["μὴ",708851,28],["διέλῃς",703459,175],["ἥμαρτες",700773,162],["ἡσύχασον",706033,176],["πρὸς",710844,0],["σὲ",711598,163],["ἡ",709436,10],["ἀποστροφὴ",701599,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["σὺ",712181,164],["ἄρξεις",701860,166],["αὐτοῦ",702165,102]],"Hast thou not sinned if thou hast brought it rightly, but not rightly divided it? be still, to thee shall be his submission, and thou shalt rule over him."],["8",[["καὶ",707031,7],["εἶπεν",705373,2],["Καιν",707035,4],["πρὸς",710844,0],["Αβελ",700040,6],["τὸν",709436,5],["ἀδελφὸν",700249,6],["αὐτοῦ",702165,102],["διέλθωμεν",703673,79],["εἰς",704105,0],["τὸ",709436,24],["πεδίον",710215,25],["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["τῷ",709436,53],["εἶναι",704093,55],["αὐτοὺς",702165,62],["ἐν",704639,0],["τῷ",709436,53],["πεδίῳ",710215,54],["καὶ",707031,7],["ἀνέστη",701173,2],["Καιν",707035,4],["ἐπὶ",705080,0],["Αβελ",700040,114],["τὸν",709436,5],["ἀδελφὸν",700249,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀπέκτεινεν",701498,2],["αὐτόν",702165,85]],"And Cain said to Abel his brother, Let us go out into the plain; and it came to pass that when they were in the plain Cain rose up against Abel his brother, and slew him."],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["θεὸς",706192,4],["πρὸς",710844,0],["Καιν",707035,6],["ποῦ",710706,28],["ἐστιν",704093,91],["Αβελ",700040,4],["ὁ",709436,3],["ἀδελφός",700249,4],["σου",711945,133],["ὁ",709436,3],["δὲ",703303,11],["εἶπεν",705373,2],["οὐ",709805,28],["γινώσκω",703105,157],["μὴ",708851,28],["φύλαξ",713616,4],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["μού",709032,133],["εἰμι",704093,157],["ἐγώ",704018,164]],"And the Lord God said to Cain, Where is Abel thy brother? and he said, I know not, am I my brother's keeper?"],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["θεός",706192,4],["τί",712867,126],["ἐποίησας",710582,162],["φωνὴ",713640,12],["αἵματος",700442,21],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["σου",711945,133],["βοᾷ",702743,91],["πρός",710844,0],["με",708618,163],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17]],"And the Lord said, What hast thou done? the voice of thy brother's blood cries to me out of the ground."],["11",[["καὶ",707031,7],["νῦν",709384,28],["ἐπικατάρατος",705159,14],["σὺ",712181,164],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["ἣ",709781,177],["ἔχανεν",713662,2],["τὸ",709436,24],["στόμα",712125,25],["αὐτῆς",702165,86],["δέξασθαι",703393,109],["τὸ",709436,24],["αἷμα",700442,25],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["σου",711945,133],["ἐκ",704132,0],["τῆς",709436,16],["χειρός",713787,17],["σου",711945,133]],"And now thou [art] cursed from the earth which has opened her mouth to receive thy brother's blood from thy hand."],["12",[["ὅτι",709803,7],["ἐργᾷ",705383,123],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["οὐ",709805,28],["προσθήσει",710965,127],["τὴν",709436,8],["ἰσχὺν",706858,9],["αὐτῆς",702165,86],["δοῦναί",703654,106],["σοι",711925,159],["στένων",712072,72],["καὶ",707031,7],["τρέμων",712928,72],["ἔσῃ",704093,123],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"When thou tillest the earth, then it shall not continue to give its strength to thee: thou shalt be groaning and trembling on the earth."],["13",[["καὶ",707031,7],["εἶπεν",705373,2],["Καιν",707035,4],["πρὸς",710844,0],["τὸν",709436,5],["κύριον",707996,6],["μείζων",708682,178],["ἡ",709436,10],["αἰτία",700492,12],["μου",709032,133],["τοῦ",709436,20],["ἀφεθῆναί",702211,179],["με",708618,163]],"And Cain said to the Lord God, My crime [is] too great for me to be forgiven."],["14",[["εἰ",704071,7],["ἐκβάλλεις",704145,154],["με",708618,163],["σήμερον",711751,28],["ἀπὸ",701425,0],["προσώπου",710986,21],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,20],["προσώπου",710986,21],["σου",711945,133],["κρυβήσομαι",707923,180],["καὶ",707031,7],["ἔσομαι",704093,181],["στένων",712072,72],["καὶ",707031,7],["τρέμων",712928,72],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἔσται",704093,93],["πᾶς",710177,14],["ὁ",709436,3],["εὑρίσκων",705676,72],["με",708618,163],["ἀποκτενεῖ",701498,127],["με",708618,163]],"If thou castest me out this day from the face of the earth, and I shall be hidden from thy presence, and I shall be groaning and trembling upon the earth, then it will be that any one that finds me shall slay me."],["15",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["οὐχ",709805,28],["οὕτως",709859,28],["πᾶς",710177,14],["ὁ",709436,3],["ἀποκτείνας",701498,182],["Καιν",707035,6],["ἑπτὰ",705357,59],["ἐκδικούμενα",704174,67],["παραλύσει",710070,127],["καὶ",707031,7],["ἔθετο",712849,23],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["σημεῖον",711748,25],["τῷ",709436,113],["Καιν",707035,114],["τοῦ",709436,20],["μὴ",708851,28],["ἀνελεῖν",700962,106],["αὐτὸν",702165,85],["πάντα",710177,27],["τὸν",709436,5],["εὑρίσκοντα",705676,183],["αὐτόν",702165,85]],"And the Lord God said to him, Not so, any one that slays Cain shall suffer seven-fold vengeance; and the Lord God set a mark upon Cain that no one that found him might slay him."],["16",[["ἐξῆλθεν",704909,2],["δὲ",703303,11],["Καιν",707035,4],["ἀπὸ",701425,0],["προσώπου",710986,21],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["ᾤκησεν",709499,2],["ἐν",704639,0],["γῇ",703083,1],["Ναιδ",709174,184],["κατέναντι",707507,0],["Εδεμ",704027,118]],"So Cain went forth from the presence of God and dwelt in the land of Nod over against Edem."],["17",[["καὶ",707031,7],["ἔγνω",703105,2],["Καιν",707035,4],["τὴν",709436,8],["γυναῖκα",703209,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["συλλαβοῦσα",712262,149],["ἔτεκεν",712853,2],["τὸν",709436,5],["Ενωχ",704827,6],["καὶ",707031,7],["ἦν",704093,13],["οἰκοδομῶν",709509,72],["πόλιν",710612,9],["καὶ",707031,7],["ἐπωνόμασεν",705348,2],["τὴν",709436,8],["πόλιν",710612,9],["ἐπὶ",705080,0],["τῷ",709436,53],["ὀνόματι",709666,54],["τοῦ",709436,35],["υἱοῦ",713075,18],["αὐτοῦ",702165,102],["Ενωχ",704827,18]],"And Cain knew his wife, and having conceived she bore Enoch; and he built a city; and he named the city after the name of his son, Enoch."],["18",[["ἐγενήθη",703104,37],["δὲ",703303,11],["τῷ",709436,113],["Ενωχ",704827,114],["Γαιδαδ",702910,4],["καὶ",707031,7],["Γαιδαδ",702910,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Μαιηλ",708386,6],["καὶ",707031,7],["Μαιηλ",708386,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Μαθουσαλα",708380,6],["καὶ",707031,7],["Μαθουσαλα",708380,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Λαμεχ",708077,6]],"And to Enoch was born Gaidad; and Gaidad begot Maleleel; and Maleleel begot Mathusala; and Mathusala begot Lamech."],["19",[["καὶ",707031,7],["ἔλαβεν",708076,2],["ἑαυτῷ",703917,50],["Λαμεχ",708077,4],["δύο",703849,59],["γυναῖκας",703209,39],["ὄνομα",709666,25],["τῇ",709436,100],["μιᾷ",704106,101],["Αδα",700216,12],["καὶ",707031,7],["ὄνομα",709666,25],["τῇ",709436,100],["δευτέρᾳ",703389,101],["Σελλα",711652,12]],"And Lamech took to himself two wives; the name of the one was Ada, and the name of the second Sella."],["20",[["καὶ",707031,7],["ἔτεκεν",712853,2],["Αδα",700216,12],["τὸν",709436,5],["Ιωβελ",706905,6],["οὗτος",709858,121],["ἦν",704093,13],["ὁ",709436,3],["πατὴρ",710189,4],["οἰκούντων",709499,170],["ἐν",704639,0],["σκηναῖς",711845,76],["κτηνοτρόφων",707935,83]],"And Ada bore Jobel; he was the father of those that dwell in tents, feeding cattle."],["21",[["καὶ",707031,7],["ὄνομα",709666,25],["τῷ",709436,113],["ἀδελφῷ",700249,114],["αὐτοῦ",702165,102],["Ιουβαλ",706767,4],["οὗτος",709858,121],["ἦν",704093,13],["ὁ",709436,3],["καταδείξας",707235,182],["ψαλτήριον",714023,25],["καὶ",707031,7],["κιθάραν",707669,9]],"And the name of his brother was Jubal; he it was who invented the psaltery and harp."],["22",[["Σελλα",711652,12],["δὲ",703303,11],["ἔτεκεν",712853,2],["καὶ",707031,7],["αὐτὴ",702165,107],["τὸν",709436,5],["Θοβελ",706281,6],["καὶ",707031,7],["ἦν",704093,13],["σφυροκόπος",712594,14],["χαλκεὺς",713691,4],["χαλκοῦ",713695,18],["καὶ",707031,7],["σιδήρου",711774,18],["ἀδελφὴ",700244,12],["δὲ",703303,11],["Θοβελ",706281,18],["Νοεμα",709323,12]],"And Sella also bore Thobel; he was a smith, a manufacturer both of brass and iron; and the sister of Thobel was Noëma."],["23",[["εἶπεν",705373,2],["δὲ",703303,11],["Λαμεχ",708077,4],["ταῖς",709436,75],["ἑαυτοῦ",703917,102],["γυναιξίν",703209,76],["Αδα",700216,1],["καὶ",707031,7],["Σελλα",711652,1],["ἀκούσατέ",700587,74],["μου",709032,133],["τῆς",709436,16],["φωνῆς",713640,17],["γυναῖκες",703209,185],["Λαμεχ",708077,18],["ἐνωτίσασθέ",704825,186],["μου",709032,133],["τοὺς",709436,58],["λόγους",708236,57],["ὅτι",709803,7],["ἄνδρα",701150,6],["ἀπέκτεινα",701498,155],["εἰς",704105,0],["τραῦμα",712920,25],["ἐμοὶ",704577,159],["καὶ",707031,7],["νεανίσκον",709232,6],["εἰς",704105,0],["μώλωπα",709099,6],["ἐμοί",704577,159]],"And Lamech said to his wives, Ada and Sella, Hear my voice, ye wives of Lamech, consider my words, because I have slain a man to my sorrow and a youth to my grief."],["24",[["ὅτι",709803,7],["ἑπτάκις",705362,28],["ἐκδεδίκηται",704174,187],["ἐκ",704132,0],["Καιν",707035,18],["ἐκ",704132,0],["δὲ",703303,11],["Λαμεχ",708077,18],["ἑβδομηκοντάκις",703923,28],["ἑπτά",705357,59]],"Because vengeance has been exacted seven times on Cain's behalf, on Lamech's [it shall be] seventy times seven."],["25",[["ἔγνω",703105,2],["δὲ",703303,11],["Αδαμ",700222,4],["Ευαν",705545,9],["τὴν",709436,8],["γυναῖκα",703209,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["συλλαβοῦσα",712262,149],["ἔτεκεν",712853,2],["υἱὸν",713075,6],["καὶ",707031,7],["ἐπωνόμασεν",705348,2],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["Σηθ",711733,6],["λέγουσα",708124,188],["ἐξανέστησεν",704865,2],["γάρ",702963,11],["μοι",708974,159],["ὁ",709436,3],["θεὸς",706192,4],["σπέρμα",712008,25],["ἕτερον",705535,46],["ἀντὶ",701227,0],["Αβελ",700040,18],["ὃν",709781,112],["ἀπέκτεινεν",701498,2],["Καιν",707035,4]],"And Adam knew Eve his wife, and she conceived and bore a son, and called his name Seth, saying, For God has raised up to me another seed instead of Abel, whom Cain slew."],["26",[["καὶ",707031,7],["τῷ",709436,113],["Σηθ",711733,114],["ἐγένετο",703104,23],["υἱός",713075,4],["ἐπωνόμασεν",705348,2],["δὲ",703303,11],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["Ενως",704824,6],["οὗτος",709858,121],["ἤλπισεν",704529,2],["ἐπικαλεῖσθαι",705153,110],["τὸ",709436,24],["ὄνομα",709666,25],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18]],"And Seth had a son, and he called his name Enos: he hoped to call on the name of the Lord God."]]