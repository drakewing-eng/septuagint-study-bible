[["1",[["ὤφθη",709725,37],["δὲ",703303,11],["αὐτῷ",702165,50],["ὁ",709436,3],["θεὸς",706192,4],["πρὸς",710844,0],["τῇ",709436,100],["δρυὶ",703837,1],["τῇ",709436,100],["Μαμβρη",708455,1],["καθημένου",707000,262],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τῆς",709436,16],["θύρας",706337,17],["τῆς",709436,16],["σκηνῆς",711845,17],["αὐτοῦ",702165,102],["μεσημβρίας",708758,17]],"And God appeared to him by the oak of Mambre, as he sat by the door of his tent at noon."],["2",[["ἀναβλέψας",700913,182],["δὲ",703303,11],["τοῖς",709436,147],["ὀφθαλμοῖς",709870,148],["αὐτοῦ",702165,102],["εἶδεν",704075,2],["καὶ",707031,7],["ἰδοὺ",706497,88],["τρεῖς",712927,138],["ἄνδρες",701150,52],["εἱστήκεισαν",706846,263],["ἐπάνω",705030,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἰδὼν",709725,182],["προσέδραμεν",710967,2],["εἰς",704105,0],["συνάντησιν",712397,9],["αὐτοῖς",702165,151],["ἀπὸ",701425,0],["τῆς",709436,16],["θύρας",706337,17],["τῆς",709436,16],["σκηνῆς",711845,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["προσεκύνησεν",710925,2],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9]],"And he lifted up his eyes and beheld, and lo! three men stood before him; and having seen them he ran to meet them from the door of his tent, and did obeisance to the ground."],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριε",707996,153],["εἰ",704071,7],["ἄρα",701666,11],["εὗρον",705676,155],["χάριν",713735,9],["ἐναντίον",704654,0],["σου",711945,133],["μὴ",708851,28],["παρέλθῃς",710141,175],["τὸν",709436,5],["παῖδά",709932,6],["σου",711945,133]],"And he said, Lord, if indeed I have found grace in thy sight, pass not by thy servant."],["4",[["λημφθήτω",708076,22],["δὴ",703395,11],["ὕδωρ",713071,15],["καὶ",707031,7],["νιψάτωσαν",709314,264],["τοὺς",709436,58],["πόδας",710707,57],["ὑμῶν",713091,145],["καὶ",707031,7],["καταψύξατε",707502,74],["ὑπὸ",713184,0],["τὸ",709436,24],["δένδρον",703353,25]],"Let water now be brought, and let them wash your feet, and do ye refresh [yourselves] under the tree."],["5",[["καὶ",707031,7],["λήμψομαι",708076,181],["ἄρτον",701829,6],["καὶ",707031,7],["φάγεσθε",705495,186],["καὶ",707031,7],["μετὰ",708780,0],["τοῦτο",709858,129],["παρελεύσεσθε",710141,124],["εἰς",704105,0],["τὴν",709436,8],["ὁδὸν",709458,9],["ὑμῶν",713091,145],["οὗ",709806,48],["εἵνεκεν",704709,0],["ἐξεκλίνατε",704220,265],["πρὸς",710844,0],["τὸν",709436,5],["παῖδα",709932,6],["ὑμῶν",713091,145],["καὶ",707031,7],["εἶπαν",705373,150],["οὕτως",709859,28],["ποίησον",710582,176],["καθὼς",707030,28],["εἴρηκας",705415,266]],"And I will bring bread, and ye shall eat, and after this ye shall depart on your journey, on account of which [refreshment] ye have turned aside to your servant. And he said, So do, as thou hast said."],["6",[["καὶ",707031,7],["ἔσπευσεν",712011,2],["Αβρααμ",700091,4],["ἐπὶ",705080,0],["τὴν",709436,8],["σκηνὴν",711845,9],["πρὸς",710844,0],["Σαρραν",711541,9],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῇ",702165,105],["σπεῦσον",712011,176],["καὶ",707031,7],["φύρασον",713626,176],["τρία",712927,68],["μέτρα",708846,42],["σεμιδάλεως",711675,17],["καὶ",707031,7],["ποίησον",710582,176],["ἐγκρυφίας",703994,57]],"And Abraam hasted to the tent to Sarrha, and said to her, Hasten, and knead three measures of fine flour, and make cakes."],["7",[["καὶ",707031,7],["εἰς",704105,0],["τὰς",709436,38],["βόας",702798,39],["ἔδραμεν",712931,2],["Αβρααμ",700091,4],["καὶ",707031,7],["ἔλαβεν",708076,2],["μοσχάριον",709027,25],["ἁπαλὸν",701336,46],["καὶ",707031,7],["καλὸν",707097,46],["καὶ",707031,7],["ἔδωκεν",703654,2],["τῷ",709436,113],["παιδί",709932,114],["καὶ",707031,7],["ἐτάχυνεν",712749,2],["τοῦ",709436,20],["ποιῆσαι",710582,106],["αὐτό",702165,129]],"And Abraam ran to the kine, and took a young calf, tender and good, and gave it to his servant, and he hasted to dress it."],["8",[["ἔλαβεν",708076,2],["δὲ",703303,11],["βούτυρον",702800,25],["καὶ",707031,7],["γάλα",702919,25],["καὶ",707031,7],["τὸ",709436,24],["μοσχάριον",709027,25],["ὃ",709781,128],["ἐποίησεν",710582,2],["καὶ",707031,7],["παρέθηκεν",710111,2],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἐφάγοσαν",705495,150],["αὐτὸς",702165,121],["δὲ",703303,11],["παρειστήκει",710152,143],["αὐτοῖς",702165,151],["ὑπὸ",713184,0],["τὸ",709436,24],["δένδρον",703353,25]],"And he took butter and milk, and the calf which he had dressed; and he set them before them, and they did eat, and he stood by them under the tree."],["9",[["εἶπεν",705373,2],["δὲ",703303,11],["πρὸς",710844,0],["αὐτόν",702165,85],["ποῦ",710706,28],["Σαρρα",711541,12],["ἡ",709436,10],["γυνή",703209,12],["σου",711945,133],["ὁ",709436,3],["δὲ",703303,11],["ἀποκριθεὶς",701492,217],["εἶπεν",705373,2],["ἰδοὺ",706497,88],["ἐν",704639,0],["τῇ",709436,100],["σκηνῇ",711845,1]],"And he said to him, Where is Sarrha thy wife? And he answered and said, Behold! in the tent."],["10",[["εἶπεν",705373,2],["δέ",703303,11],["ἐπαναστρέφων",705020,72],["ἥξω",705956,165],["πρὸς",710844,0],["σὲ",711598,163],["κατὰ",707200,0],["τὸν",709436,5],["καιρὸν",707047,6],["τοῦτον",709858,85],["εἰς",704105,0],["ὥρας",714128,39],["καὶ",707031,7],["ἕξει",705785,127],["υἱὸν",713075,6],["Σαρρα",711541,12],["ἡ",709436,10],["γυνή",703209,12],["σου",711945,133],["Σαρρα",711541,12],["δὲ",703303,11],["ἤκουσεν",700587,2],["πρὸς",710844,0],["τῇ",709436,100],["θύρᾳ",706337,1],["τῆς",709436,16],["σκηνῆς",711845,17],["οὖσα",704093,188],["ὄπισθεν",709691,28],["αὐτοῦ",702165,102]],"And he said, I will return and come to thee according to this period seasonably, and Sarrha thy wife shall have a son; and Sarrha heard at the door of the tent, being behind him."],["11",[["Αβρααμ",700091,4],["δὲ",703303,11],["καὶ",707031,7],["Σαρρα",711541,12],["πρεσβύτεροι",710735,267],["προβεβηκότες",710763,268],["ἡμερῶν",705984,65],["ἐξέλιπεν",704237,2],["δὲ",703303,11],["Σαρρα",711541,12],["γίνεσθαι",703104,110],["τὰ",709436,41],["γυναικεῖα",703206,68]],"And Abraam and Sarrha were old, advanced in days, and the custom of women ceased with Sarrha."],["12",[["ἐγέλασεν",703019,2],["δὲ",703303,11],["Σαρρα",711541,12],["ἐν",704639,0],["ἑαυτῇ",703917,105],["λέγουσα",708124,188],["οὔπω",709837,28],["μέν",708730,11],["μοι",708974,159],["γέγονεν",703104,171],["ἕως",705792,0],["τοῦ",709436,20],["νῦν",709384,28],["ὁ",709436,3],["δὲ",703303,11],["κύριός",707996,4],["μου",709032,133],["πρεσβύτερος",710735,224]],"And Sarrha laughed in herself, saying, The thing has not as yet happened to me, even until now, and my lord is old."],["13",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Αβρααμ",700091,6],["τί",712867,126],["ὅτι",709803,7],["ἐγέλασεν",703019,2],["Σαρρα",711541,12],["ἐν",704639,0],["ἑαυτῇ",703917,105],["λέγουσα",708124,188],["ἆρά",701667,11],["γε",702985,11],["ἀληθῶς",700662,28],["τέξομαι",712853,181],["ἐγὼ",704018,164],["δὲ",703303,11],["γεγήρακα",703090,89]],"And the Lord said to Abraam, Why is it that Sarrha has laughed in herself, saying, Shall I then indeed bear? but I am grown old."],["14",[["μὴ",708851,28],["ἀδυνατεῖ",700296,91],["παρὰ",709995,0],["τῷ",709436,113],["θεῷ",706192,114],["ῥῆμα",711246,15],["εἰς",704105,0],["τὸν",709436,5],["καιρὸν",707047,6],["τοῦτον",709858,85],["ἀναστρέψω",701060,165],["πρὸς",710844,0],["σὲ",711598,163],["εἰς",704105,0],["ὥρας",714128,39],["καὶ",707031,7],["ἔσται",704093,93],["τῇ",709436,100],["Σαρρα",711541,1],["υἱός",713075,4]],"Shall anything be impossible with the Lord? At this time I will return to thee seasonably, and Sarrha shall have a son."],["15",[["ἠρνήσατο",701781,23],["δὲ",703303,11],["Σαρρα",711541,12],["λέγουσα",708124,188],["οὐκ",709805,28],["ἐγέλασα",703019,155],["ἐφοβήθη",713532,37],["γάρ",702963,11],["καὶ",707031,7],["εἶπεν",705373,2],["οὐχί",709862,28],["ἀλλὰ",700680,7],["ἐγέλασας",703019,162]],"But Sarrha denied, saying, I did not laugh, for she was afraid. And he said to her, Nay, but thou didst laugh."],["16",[["ἐξαναστάντες",704865,196],["δὲ",703303,11],["ἐκεῖθεν",704182,28],["οἱ",709436,136],["ἄνδρες",701150,52],["κατέβλεψαν",707212,150],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["Σοδομων",711920,118],["καὶ",707031,7],["Γομορρας",703165,118],["Αβρααμ",700091,4],["δὲ",703303,11],["συνεπορεύετο",712342,19],["μετ᾿",708780,0],["αὐτῶν",702165,40],["συμπροπέμπων",712348,72],["αὐτούς",702165,62]],"And the men having risen up from thence looked towards Sodom and Gomorrha. And Abraam went with them, attending them on their journey."],["17",[["ὁ",709436,3],["δὲ",703303,11],["κύριος",707996,4],["εἶπεν",705373,2],["μὴ",708851,28],["κρύψω",707923,165],["ἐγὼ",704018,164],["ἀπὸ",701425,0],["Αβρααμ",700091,18],["τοῦ",709436,35],["παιδός",709932,18],["μου",709032,133],["ἃ",709781,69],["ἐγὼ",704018,164],["ποιῶ",710582,157]],"And the Lord said, Shall I hide from Abraam my servant what things I intend to do?"],["18",[["Αβρααμ",700091,4],["δὲ",703303,11],["γινόμενος",703104,122],["ἔσται",704093,93],["εἰς",704105,0],["ἔθνος",704068,25],["μέγα",708653,46],["καὶ",707031,7],["πολύ",710646,46],["καὶ",707031,7],["ἐνευλογηθήσονται",704720,144],["ἐν",704639,0],["αὐτῷ",702165,50],["πάντα",710177,195],["τὰ",709436,63],["ἔθνη",704068,64],["τῆς",709436,16],["γῆς",703083,17]],"But Abraam shall become a great and populous nation, and in him shall all the nations of the earth be blest."],["19",[["ᾔδειν",704075,143],["γὰρ",702963,11],["ὅτι",709803,7],["συντάξει",712508,127],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτοῦ",702165,102],["καὶ",707031,7],["τῷ",709436,113],["οἴκῳ",709516,114],["αὐτοῦ",702165,102],["μετ᾿",708780,0],["αὐτόν",702165,85],["καὶ",707031,7],["φυλάξουσιν",713619,218],["τὰς",709436,38],["ὁδοὺς",709458,39],["κυρίου",707996,18],["ποιεῖν",710582,55],["δικαιοσύνην",703695,9],["καὶ",707031,7],["κρίσιν",707908,9],["ὅπως",709719,7],["ἂν",700900,11],["ἐπαγάγῃ",704994,172],["κύριος",707996,4],["ἐπὶ",705080,0],["Αβρααμ",700091,6],["πάντα",710177,68],["ὅσα",709788,68],["ἐλάλησεν",708071,2],["πρὸς",710844,0],["αὐτόν",702165,85]],"For I know that he will order his sons, and his house after him, and they will keep the ways of the Lord, to do justice and judgment, that the Lord may bring upon Abraam all things whatsoever he has spoken to him."],["20",[["εἶπεν",705373,2],["δὲ",703303,11],["κύριος",707996,4],["κραυγὴ",707886,12],["Σοδομων",711920,118],["καὶ",707031,7],["Γομορρας",703165,118],["πεπλήθυνται",710530,187],["καὶ",707031,7],["αἱ",709436,190],["ἁμαρτίαι",700775,191],["αὐτῶν",702165,40],["μεγάλαι",708653,192],["σφόδρα",712586,28]],"And the Lord said, The cry of Sodom and Gomorrha has been increased towards me, and their sins are very great."],["21",[["καταβὰς",707202,182],["οὖν",709835,11],["ὄψομαι",709712,181],["εἰ",704071,7],["κατὰ",707200,0],["τὴν",709436,8],["κραυγὴν",707886,9],["αὐτῶν",702165,40],["τὴν",709436,8],["ἐρχομένην",705453,173],["πρός",710844,0],["με",708618,163],["συντελοῦνται",712510,269],["εἰ",704071,7],["δὲ",703303,11],["μή",708851,28],["ἵνα",706747,7],["γνῶ",703105,207]],"I will therefore go down and see, if they completely correspond with the cry which comes to me, and if not, that I may know."],["22",[["καὶ",707031,7],["ἀποστρέψαντες",701598,196],["ἐκεῖθεν",704182,28],["οἱ",709436,136],["ἄνδρες",701150,52],["ἦλθον",705453,150],["εἰς",704105,0],["Σοδομα",711920,227],["Αβρααμ",700091,4],["δὲ",703303,11],["ἦν",704093,13],["ἑστηκὼς",706846,270],["ἐναντίον",704654,0],["κυρίου",707996,18]],"And the men having departed thence, came to Sodom; and Abraam was still standing before the Lord."],["23",[["καὶ",707031,7],["ἐγγίσας",703939,182],["Αβρααμ",700091,4],["εἶπεν",705373,2],["μὴ",708851,28],["συναπολέσῃς",712402,175],["δίκαιον",703694,27],["μετὰ",708780,0],["ἀσεβοῦς",701909,116],["καὶ",707031,7],["ἔσται",704093,93],["ὁ",709436,3],["δίκαιος",703694,14],["ὡς",714148,7],["ὁ",709436,3],["ἀσεβής",701909,14]],"And Abraam drew nigh and said, Wouldest thou destroy the righteous with the wicked, and shall the righteous be as the wicked?"],["24",[["ἐὰν",703912,7],["ὦσιν",704093,271],["πεντήκοντα",710270,59],["δίκαιοι",703694,138],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["ἀπολεῖς",701513,166],["αὐτούς",702165,62],["οὐκ",709805,28],["ἀνήσεις",701169,166],["πάντα",710177,27],["τὸν",709436,5],["τόπον",712903,6],["ἕνεκεν",704709,0],["τῶν",709436,80],["πεντήκοντα",710270,59],["δικαίων",703694,169],["ἐὰν",703912,7],["ὦσιν",704093,271],["ἐν",704639,0],["αὐτῇ",702165,105]],"Should there be fifty righteous in the city, wilt thou destroy them? wilt thou not spare the whole place for the sake of the fifty righteous, if they be in it?"],["25",[["μηδαμῶς",708854,28],["σὺ",712181,164],["ποιήσεις",710582,166],["ὡς",714148,7],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["τοῦ",709436,20],["ἀποκτεῖναι",701498,106],["δίκαιον",703694,27],["μετὰ",708780,0],["ἀσεβοῦς",701909,116],["καὶ",707031,7],["ἔσται",704093,93],["ὁ",709436,3],["δίκαιος",703694,14],["ὡς",714148,7],["ὁ",709436,3],["ἀσεβής",701909,14],["μηδαμῶς",708854,28],["ὁ",709436,3],["κρίνων",707905,72],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9],["οὐ",709805,28],["ποιήσεις",710582,166],["κρίσιν",707908,9]],"By no means shalt thou do as this thing [is] so as to destroy the righteous with the wicked, so the righteous shall be as the wicked: by no means. Thou that judgest the whole earth, shalt thou not do right?"],["26",[["εἶπεν",705373,2],["δὲ",703303,11],["κύριος",707996,4],["ἐὰν",703912,7],["εὕρω",705676,207],["ἐν",704639,0],["Σοδομοις",711920,111],["πεντήκοντα",710270,59],["δικαίους",703694,60],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["ἀφήσω",702211,165],["πάντα",710177,27],["τὸν",709436,5],["τόπον",712903,6],["δι᾿",703417,0],["αὐτούς",702165,62]],"And the Lord said, If there should be in Sodom fifty righteous in the city, I will spare the whole city, and the whole place for their sakes."],["27",[["καὶ",707031,7],["ἀποκριθεὶς",701492,217],["Αβρααμ",700091,4],["εἶπεν",705373,2],["νῦν",709384,28],["ἠρξάμην",701860,161],["λαλῆσαι",708071,106],["πρὸς",710844,0],["τὸν",709436,5],["κύριον",707996,6],["ἐγὼ",704018,164],["δέ",703303,11],["εἰμι",704093,157],["γῆ",703083,12],["καὶ",707031,7],["σποδός",712022,4]],"And Abraam answered and said, Now I have begun to speak to my Lord, and I am earth and ashes."],["28",[["ἐὰν",703912,7],["δὲ",703303,11],["ἐλαττονωθῶσιν",704393,272],["οἱ",709436,136],["πεντήκοντα",710270,59],["δίκαιοι",703694,138],["πέντε",710266,59],["ἀπολεῖς",701513,166],["ἕνεκεν",704709,0],["τῶν",709436,80],["πέντε",710266,59],["πᾶσαν",710177,36],["τὴν",709436,8],["πόλιν",710612,9],["καὶ",707031,7],["εἶπεν",705373,2],["οὐ",709805,28],["μὴ",708851,28],["ἀπολέσω",701513,207],["ἐὰν",703912,7],["εὕρω",705676,207],["ἐκεῖ",704181,28],["τεσσαράκοντα",712806,59],["πέντε",710266,59]],"But if the fifty righteous should be diminished to forty-five, wilt thou destroy the whole city because of the five [wanting]? And he said, I will not destroy it, if I should find there forty-five."],["29",[["καὶ",707031,7],["προσέθηκεν",710965,2],["ἔτι",705538,28],["λαλῆσαι",708071,106],["πρὸς",710844,0],["αὐτὸν",702165,85],["καὶ",707031,7],["εἶπεν",705373,2],["ἐὰν",703912,7],["δὲ",703303,11],["εὑρεθῶσιν",705676,272],["ἐκεῖ",704181,28],["τεσσαράκοντα",712806,59],["καὶ",707031,7],["εἶπεν",705373,2],["οὐ",709805,28],["μὴ",708851,28],["ἀπολέσω",701513,207],["ἕνεκεν",704709,0],["τῶν",709436,80],["τεσσαράκοντα",712806,59]],"And he continued to speak to him still, and said, But if there should be found there forty? And he said, I will not destroy it for the forty's sake."],["30",[["καὶ",707031,7],["εἶπεν",705373,2],["μή",708851,28],["τι",712867,273],["κύριε",707996,153],["ἐὰν",703912,7],["λαλήσω",708071,207],["ἐὰν",703912,7],["δὲ",703303,11],["εὑρεθῶσιν",705676,272],["ἐκεῖ",704181,28],["τριάκοντα",712934,59],["καὶ",707031,7],["εἶπεν",705373,2],["οὐ",709805,28],["μὴ",708851,28],["ἀπολέσω",701513,207],["ἐὰν",703912,7],["εὕρω",705676,207],["ἐκεῖ",704181,28],["τριάκοντα",712934,59]],"And he said, Will there be anything [against me], Lord, if I shall speak? but if there be found there thirty? And he said, I will not destroy it for the thirty's sake."],["31",[["καὶ",707031,7],["εἶπεν",705373,2],["ἐπειδὴ",705056,7],["ἔχω",705785,157],["λαλῆσαι",708071,106],["πρὸς",710844,0],["τὸν",709436,5],["κύριον",707996,6],["ἐὰν",703912,7],["δὲ",703303,11],["εὑρεθῶσιν",705676,272],["ἐκεῖ",704181,28],["εἴκοσι",704085,59],["καὶ",707031,7],["εἶπεν",705373,2],["οὐ",709805,28],["μὴ",708851,28],["ἀπολέσω",701513,207],["ἕνεκεν",704709,0],["τῶν",709436,80],["εἴκοσι",704085,59]],"And he said, Since I am able to speak to the Lord, what if there should be found there twenty? And he said, I will not destroy it, if I should find there twenty."],["32",[["καὶ",707031,7],["εἶπεν",705373,2],["μή",708851,28],["τι",712866,126],["κύριε",707996,153],["ἐὰν",703912,7],["λαλήσω",708071,207],["ἔτι",705538,28],["ἅπαξ",701350,28],["ἐὰν",703912,7],["δὲ",703303,11],["εὑρεθῶσιν",705676,272],["ἐκεῖ",704181,28],["δέκα",703333,59],["καὶ",707031,7],["εἶπεν",705373,2],["οὐ",709805,28],["μὴ",708851,28],["ἀπολέσω",701513,207],["ἕνεκεν",704709,0],["τῶν",709436,80],["δέκα",703333,59]],"And he said, Will there be anything [against me], Lord, if I speak yet once? but if there should be found there ten? And he said, I will not destroy it for the ten's sake."],["33",[["ἀπῆλθεν",701398,2],["δὲ",703303,11],["κύριος",707996,4],["ὡς",714148,7],["ἐπαύσατο",710202,23],["λαλῶν",708071,72],["τῷ",709436,113],["Αβρααμ",700091,114],["καὶ",707031,7],["Αβρααμ",700091,4],["ἀπέστρεψεν",701598,2],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["αὐτοῦ",702165,102]],"And the Lord departed, when he left off speaking to Abraam, and Abraam returned to his place."]]