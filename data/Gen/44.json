[["1",[["καὶ",707031,7],["ἐνετείλατο",704791,23],["Ιωσηφ",706948,4],["τῷ",709436,113],["ὄντι",704093,379],["ἐπὶ",705080,0],["τῆς",709436,16],["οἰκίας",709505,17],["αὐτοῦ",702165,102],["λέγων",708124,72],["πλήσατε",710532,74],["τοὺς",709436,58],["μαρσίππους",708522,57],["τῶν",709436,80],["ἀνθρώπων",701163,81],["βρωμάτων",702823,44],["ὅσα",709788,68],["ἐὰν",703912,7],["δύνωνται",703838,380],["ἆραι",700473,106],["καὶ",707031,7],["ἐμβάλατε",704547,74],["ἑκάστου",704133,116],["τὸ",709436,24],["ἀργύριον",701707,25],["ἐπὶ",705080,0],["τοῦ",709436,20],["στόματος",712125,21],["τοῦ",709436,35],["μαρσίππου",708522,18]],"And Joseph charged the steward of his house, saying, Fill the men's sacks with food, as much as they can carry, and put the money of each in the mouth of his sack."],["2",[["καὶ",707031,7],["τὸ",709436,24],["κόνδυ",707808,25],["μου",709032,133],["τὸ",709436,24],["ἀργυροῦν",701705,46],["ἐμβάλατε",704547,74],["εἰς",704105,0],["τὸν",709436,5],["μάρσιππον",708522,6],["τοῦ",709436,35],["νεωτέρου",709256,229],["καὶ",707031,7],["τὴν",709436,8],["τιμὴν",712856,9],["τοῦ",709436,35],["σίτου",711814,18],["αὐτοῦ",702165,102],["ἐγενήθη",703104,37],["δὲ",703303,11],["κατὰ",707200,0],["τὸ",709436,24],["ῥῆμα",711246,25],["Ιωσηφ",706948,18],["καθὼς",707030,28],["εἶπεν",705373,2]],"And put my silver cup into the sack of the youngest, and the price of his corn. And it was done according to the word of Joseph, as he said."],["3",[["τὸ",709436,24],["πρωὶ",711021,28],["διέφαυσεν",703621,2],["καὶ",707031,7],["οἱ",709436,136],["ἄνθρωποι",701163,52],["ἀπεστάλησαν",701592,99],["αὐτοὶ",702165,201],["καὶ",707031,7],["οἱ",709436,136],["ὄνοι",709671,52],["αὐτῶν",702165,40]],"The morning dawned, and the men were sent away, they and their asses."],["4",[["ἐξελθόντων",704909,221],["δὲ",703303,11],["αὐτῶν",702165,40],["τὴν",709436,8],["πόλιν",710612,9],["οὐκ",709805,28],["ἀπέσχον",701225,150],["μακράν",708411,28],["καὶ",707031,7],["Ιωσηφ",706948,4],["εἶπεν",705373,2],["τῷ",709436,113],["ἐπὶ",705080,0],["τῆς",709436,16],["οἰκίας",709505,17],["αὐτοῦ",702165,102],["ἀναστὰς",701173,182],["ἐπιδίωξον",705123,176],["ὀπίσω",709697,0],["τῶν",709436,80],["ἀνθρώπων",701163,81],["καὶ",707031,7],["καταλήμψῃ",707300,123],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἐρεῖς",705415,166],["αὐτοῖς",702165,151],["τί",712867,126],["ὅτι",709803,7],["ἀνταπεδώκατε",701215,265],["πονηρὰ",710660,68],["ἀντὶ",701227,0],["καλῶν",707097,83]],"And when they had gone out of the city, [and] were not far off, then Joseph said to his steward, Arise, and pursue after the men; and thou shalt overtake them, and say to them, Why have ye returned evil for good?"],["5",[["ἵνα",706747,7],["τί",712867,126],["ἐκλέψατέ",707715,265],["μου",709032,133],["τὸ",709436,24],["κόνδυ",707808,25],["τὸ",709436,24],["ἀργυροῦν",701705,46],["οὐ",709805,28],["τοῦτό",709858,132],["ἐστιν",704093,91],["ἐν",704639,0],["ᾧ",709781,209],["πίνει",710478,91],["ὁ",709436,3],["κύριός",707996,4],["μου",709032,133],["αὐτὸς",702165,121],["δὲ",703303,11],["οἰωνισμῷ",709543,114],["οἰωνίζεται",709540,117],["ἐν",704639,0],["αὐτῷ",702165,50],["πονηρὰ",710660,68],["συντετέλεσθε",712510,381],["ἃ",709781,69],["πεποιήκατε",710582,330]],"Why have ye stolen my silver cup? is it not this out of which my lord drinks? and he divines augury with it; ye have accomplished evil in that which ye have done."],["6",[["εὑρὼν",705676,182],["δὲ",703303,11],["αὐτοὺς",702165,62],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["κατὰ",707200,0],["τὰ",709436,41],["ῥήματα",711246,42],["ταῦτα",709858,71]],"And he found them, and spoke to them according to these words."],["7",[["οἱ",709436,136],["δὲ",703303,11],["εἶπον",705373,150],["αὐτῷ",702165,50],["ἵνα",706747,7],["τί",712867,126],["λαλεῖ",708071,91],["ὁ",709436,3],["κύριος",707996,4],["κατὰ",707200,0],["τὰ",709436,41],["ῥήματα",711246,42],["ταῦτα",709858,71],["μὴ",708851,28],["γένοιτο",703104,382],["τοῖς",709436,147],["παισίν",709932,148],["σου",711945,133],["ποιῆσαι",710582,106],["κατὰ",707200,0],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129]],"And they said to him, Why does our lord speak according to these words? far be it from thy servants to do according to this word."],["8",[["εἰ",704071,7],["τὸ",709436,24],["μὲν",708730,11],["ἀργύριον",701707,25],["ὃ",709781,128],["εὕρομεν",705676,289],["ἐν",704639,0],["τοῖς",709436,147],["μαρσίπποις",708522,148],["ἡμῶν",705999,145],["ἀπεστρέψαμεν",701598,289],["πρὸς",710844,0],["σὲ",711598,163],["ἐκ",704132,0],["γῆς",703083,17],["Χανααν",713708,118],["πῶς",711121,28],["ἂν",700900,11],["κλέψαιμεν",707715,383],["ἐκ",704132,0],["τοῦ",709436,35],["οἴκου",709516,18],["τοῦ",709436,35],["κυρίου",707996,18],["σου",711945,133],["ἀργύριον",701707,25],["ἢ",705924,7],["χρυσίον",713972,25]],"If we brought back to thee out of the land of Chanaan the money which we found in our sacks, how should we steal silver or gold out of the house of thy lord?"],["9",[["παρ᾿",709995,0],["ᾧ",709781,309],["ἂν",700900,11],["εὑρεθῇ",705676,384],["τὸ",709436,34],["κόνδυ",707808,15],["τῶν",709436,80],["παίδων",709932,81],["σου",711945,133],["ἀποθνῃσκέτω",701461,31],["καὶ",707031,7],["ἡμεῖς",705983,219],["δὲ",703303,11],["ἐσόμεθα",704093,141],["παῖδες",709932,52],["τῷ",709436,113],["κυρίῳ",707996,114],["ἡμῶν",705999,145]],"With whomsoever of thy servants thou shalt find the cup, let him die; and, moreover, we will be servants to our lord."],["10",[["ὁ",709436,3],["δὲ",703303,11],["εἶπεν",705373,2],["καὶ",707031,7],["νῦν",709384,28],["ὡς",714148,7],["λέγετε",708124,87],["οὕτως",709859,28],["ἔσται",704093,93],["ὁ",709436,3],["ἄνθρωπος",701163,4],["παρ᾿",709995,0],["ᾧ",709781,309],["ἂν",700900,11],["εὑρεθῇ",705676,384],["τὸ",709436,34],["κόνδυ",707808,15],["αὐτὸς",702165,121],["ἔσται",704093,93],["μου",709032,133],["παῖς",709932,4],["ὑμεῖς",713081,219],["δὲ",703303,11],["ἔσεσθε",704093,124],["καθαροί",706988,138]],"And he said, Now then it shall be as ye say; with whomsoever the cup shall be found, he shall be my servant, and ye shall be clear."],["11",[["καὶ",707031,7],["ἔσπευσαν",712011,150],["καὶ",707031,7],["καθεῖλαν",706982,150],["ἕκαστος",704133,14],["τὸν",709436,5],["μάρσιππον",708522,6],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἤνοιξαν",701186,150],["ἕκαστος",704133,14],["τὸν",709436,5],["μάρσιππον",708522,6],["αὐτοῦ",702165,102]],"And they hasted, and took down every man his sack on the ground, and they opened every man his sack."],["12",[["ἠρεύνα",705412,13],["δὲ",703303,11],["ἀπὸ",701425,0],["τοῦ",709436,35],["πρεσβυτέρου",710735,229],["ἀρξάμενος",701860,248],["ἕως",705792,7],["ἦλθεν",705453,2],["ἐπὶ",705080,0],["τὸν",709436,5],["νεώτερον",709256,61],["καὶ",707031,7],["εὗρεν",705676,2],["τὸ",709436,24],["κόνδυ",707808,25],["ἐν",704639,0],["τῷ",709436,113],["μαρσίππῳ",708522,114],["τῷ",709436,113],["Βενιαμιν",702650,18]],"And he searched, beginning from the eldest, until he came to the youngest; and he found the cup in Benjamin's sack."],["13",[["καὶ",707031,7],["διέρρηξαν",703565,150],["τὰ",709436,41],["ἱμάτια",706742,42],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπέθηκαν",705304,150],["ἕκαστος",704133,14],["τὸν",709436,5],["μάρσιππον",708522,6],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τὸν",709436,5],["ὄνον",709671,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπέστρεψαν",705278,150],["εἰς",704105,0],["τὴν",709436,8],["πόλιν",710612,9]],"And they rent their garments, and laid each man his sack on his ass, and returned to the city."],["14",[["εἰσῆλθεν",704114,2],["δὲ",703303,11],["Ιουδας",706775,4],["καὶ",707031,7],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["αὐτοῦ",702165,102],["πρὸς",710844,0],["Ιωσηφ",706948,6],["ἔτι",705538,28],["αὐτοῦ",702165,102],["ὄντος",704093,152],["ἐκεῖ",704181,28],["καὶ",707031,7],["ἔπεσον",710481,150],["ἐναντίον",704654,0],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9]],"And Judas and his brethren came in to Joseph, while he was yet there, and fell on the ground before him."],["15",[["εἶπεν",705373,2],["δὲ",703303,11],["αὐτοῖς",702165,151],["Ιωσηφ",706948,4],["τί",712867,273],["τὸ",709436,34],["πρᾶγμα",710708,15],["τοῦτο",709858,132],["ὃ",709781,128],["ἐποιήσατε",710582,265],["οὐκ",709805,28],["οἴδατε",709492,330],["ὅτι",709803,7],["οἰωνισμῷ",709543,114],["οἰωνιεῖται",709540,93],["ἄνθρωπος",701163,4],["οἷος",709535,14],["ἐγώ",704018,164]],"And Joseph said to them, What is this thing that ye have done? know ye not that a man such as I can surely divine?"],["16",[["εἶπεν",705373,2],["δὲ",703303,11],["Ιουδας",706775,4],["τί",712867,126],["ἀντεροῦμεν",701223,275],["τῷ",709436,113],["κυρίῳ",707996,114],["ἢ",705924,7],["τί",712867,126],["λαλήσωμεν",708071,79],["ἢ",705924,7],["τί",712867,126],["δικαιωθῶμεν",703696,283],["ὁ",709436,3],["δὲ",703303,11],["θεὸς",706192,4],["εὗρεν",705676,2],["τὴν",709436,8],["ἀδικίαν",700271,9],["τῶν",709436,80],["παίδων",709932,81],["σου",711945,133],["ἰδού",706497,88],["ἐσμεν",704093,243],["οἰκέται",709496,52],["τῷ",709436,113],["κυρίῳ",707996,114],["ἡμῶν",705999,145],["καὶ",707031,7],["ἡμεῖς",705983,219],["καὶ",707031,7],["παρ᾿",709995,0],["ᾧ",709781,309],["εὑρέθη",705676,37],["τὸ",709436,34],["κόνδυ",707808,15]],"And Judas said, What shall we answer to our lord, or what shall we say, or wherein should we be justified? whereas God has discovered the unrighteousness of thy servants; behold, we are slaves to our lord, both we and he with whom the cup has been found."],["17",[["εἶπεν",705373,2],["δὲ",703303,11],["Ιωσηφ",706948,4],["μή",708851,28],["μοι",708974,159],["γένοιτο",703104,382],["ποιῆσαι",710582,106],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["ὁ",709436,3],["ἄνθρωπος",701163,4],["παρ᾿",709995,0],["ᾧ",709781,309],["εὑρέθη",705676,37],["τὸ",709436,34],["κόνδυ",707808,15],["αὐτὸς",702165,121],["ἔσται",704093,93],["μου",709032,133],["παῖς",709932,4],["ὑμεῖς",713081,219],["δὲ",703303,11],["ἀνάβητε",700905,74],["μετὰ",708780,0],["σωτηρίας",712658,17],["πρὸς",710844,0],["τὸν",709436,5],["πατέρα",710189,6],["ὑμῶν",713091,145]],"And Joseph said, Far be it from me to do this thing; the man with whom the cup has been found, he shall be my servant; but do ye go up with safety to your father."],["18",[["ἐγγίσας",703939,182],["δὲ",703303,11],["αὐτῷ",702165,50],["Ιουδας",706775,4],["εἶπεν",705373,2],["δέομαι",703361,254],["κύριε",707996,153],["λαλησάτω",708071,45],["ὁ",709436,3],["παῖς",709932,4],["σου",711945,133],["ῥῆμα",711246,25],["ἐναντίον",704654,0],["σου",711945,133],["καὶ",707031,7],["μὴ",708851,28],["θυμωθῇς",706335,279],["τῷ",709436,113],["παιδί",709932,114],["σου",711945,133],["ὅτι",709803,7],["σὺ",712181,164],["εἶ",704093,154],["μετὰ",708780,0],["Φαραω",713360,18]],"And Judas drew near him, and said, I pray, Sir, let thy servant speak a word before thee, and be not angry with thy servant, for thou art next to Pharao."],["19",[["κύριε",707996,153],["σὺ",712181,164],["ἠρώτησας",705459,162],["τοὺς",709436,58],["παῖδάς",709932,57],["σου",711945,133],["λέγων",708124,72],["εἰ",704071,7],["ἔχετε",705785,87],["πατέρα",710189,6],["ἢ",705924,7],["ἀδελφόν",700249,6]],"Sir, thou askedst thy servants, saying, Have ye a father or a brother?"],["20",[["καὶ",707031,7],["εἴπαμεν",705373,289],["τῷ",709436,113],["κυρίῳ",707996,114],["ἔστιν",704093,91],["ἡμῖν",705994,90],["πατὴρ",710189,4],["πρεσβύτερος",710735,224],["καὶ",707031,7],["παιδίον",709927,15],["γήρως",703089,21],["νεώτερον",709256,385],["αὐτῷ",702165,50],["καὶ",707031,7],["ὁ",709436,3],["ἀδελφὸς",700249,4],["αὐτοῦ",702165,102],["ἀπέθανεν",701461,2],["αὐτὸς",702165,121],["δὲ",703303,11],["μόνος",709003,14],["ὑπελείφθη",713212,37],["τῇ",709436,100],["μητρὶ",708892,1],["αὐτοῦ",702165,102],["ὁ",709436,3],["δὲ",703303,11],["πατὴρ",710189,4],["αὐτὸν",702165,85],["ἠγάπησεν",700120,2]],"And we said to [my] lord, We have a father, an old man, and he has a son of his old age, a young one, and his brother is dead, and he alone has been left behind to his mother, and his father loves him."],["21",[["εἶπας",705373,162],["δὲ",703303,11],["τοῖς",709436,147],["παισίν",709932,148],["σου",711945,133],["καταγάγετε",707232,74],["αὐτὸν",702165,85],["πρός",710844,0],["με",708618,163],["καὶ",707031,7],["ἐπιμελοῦμαι",705199,254],["αὐτοῦ",702165,102]],"And thou saidst to thy servants, Bring him down to me, and I will take care of him."],["22",[["καὶ",707031,7],["εἴπαμεν",705373,289],["τῷ",709436,113],["κυρίῳ",707996,114],["οὐ",709805,28],["δυνήσεται",703838,93],["τὸ",709436,34],["παιδίον",709927,15],["καταλιπεῖν",707305,106],["τὸν",709436,5],["πατέρα",710189,6],["ἐὰν",703912,7],["δὲ",703303,11],["καταλίπῃ",707305,172],["τὸν",709436,5],["πατέρα",710189,6],["ἀποθανεῖται",701461,93]],"And we said to [my] lord, The child will not be able to leave his father; but if he should leave his father, he will die."],["23",[["σὺ",712181,164],["δὲ",703303,11],["εἶπας",705373,162],["τοῖς",709436,147],["παισίν",709932,148],["σου",711945,133],["ἐὰν",703912,7],["μὴ",708851,28],["καταβῇ",707202,172],["ὁ",709436,3],["ἀδελφὸς",700249,4],["ὑμῶν",713091,145],["ὁ",709436,3],["νεώτερος",709256,224],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["οὐ",709805,28],["προσθήσεσθε",710965,124],["ἔτι",705538,28],["ἰδεῖν",709725,106],["τὸ",709436,24],["πρόσωπόν",710986,25],["μου",709032,133]],"But thou saidst to thy servants, Except your younger brother come down with you, ye shall not see my face again."],["24",[["ἐγένετο",703104,23],["δὲ",703303,11],["ἡνίκα",706008,28],["ἀνέβημεν",700905,289],["πρὸς",710844,0],["τὸν",709436,5],["παῖδά",709932,6],["σου",711945,133],["πατέρα",710189,6],["δὲ",703303,11],["ἡμῶν",705999,145],["ἀπηγγείλαμεν",701321,289],["αὐτῷ",702165,50],["τὰ",709436,41],["ῥήματα",711246,42],["τοῦ",709436,35],["κυρίου",707996,18]],"And it came to pass, when we went up to thy servant our father, we reported to him the words of our lord."],["25",[["εἶπεν",705373,2],["δὲ",703303,11],["ἡμῖν",705994,90],["ὁ",709436,3],["πατὴρ",710189,4],["ἡμῶν",705999,145],["βαδίσατε",702367,74],["πάλιν",709942,28],["ἀγοράσατε",700184,74],["ἡμῖν",705994,90],["μικρὰ",708915,68],["βρώματα",702823,42]],"And our father said, Go again, and buy us a little food."],["26",[["ἡμεῖς",705983,219],["δὲ",703303,11],["εἴπαμεν",705373,289],["οὐ",709805,28],["δυνησόμεθα",703838,141],["καταβῆναι",707202,106],["ἀλλ᾿",700680,7],["εἰ",704071,7],["μὲν",708730,11],["ὁ",709436,3],["ἀδελφὸς",700249,4],["ἡμῶν",705999,145],["ὁ",709436,3],["νεώτερος",709256,224],["καταβαίνει",707202,91],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["καταβησόμεθα",707202,141],["οὐ",709805,28],["γὰρ",702963,11],["δυνησόμεθα",703838,141],["ἰδεῖν",709725,106],["τὸ",709436,24],["πρόσωπον",710986,25],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["τοῦ",709436,35],["νεωτέρου",709256,229],["μὴ",708851,28],["ὄντος",704093,152],["μεθ᾿",708780,0],["ἡμῶν",705999,145]],"And we said, We shall not be able to go down; but if our younger brother go down with us, we will go down; for we shall not be able to see the man's face, our younger brother not being with us."],["27",[["εἶπεν",705373,2],["δὲ",703303,11],["ὁ",709436,3],["παῖς",709932,4],["σου",711945,133],["ὁ",709436,3],["πατὴρ",710189,4],["ἡμῶν",705999,145],["πρὸς",710844,0],["ἡμᾶς",705981,194],["ὑμεῖς",713081,219],["γινώσκετε",703105,87],["ὅτι",709803,7],["δύο",703849,59],["ἔτεκέν",712853,2],["μοι",708974,159],["ἡ",709436,10],["γυνή",703209,12]],"And thy servant our father said to us, Ye know that my wife bore me two [sons];"],["28",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["ὁ",709436,3],["εἷς",704106,14],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["εἴπατε",705373,265],["ὅτι",709803,7],["θηριόβρωτος",706251,14],["γέγονεν",703104,171],["καὶ",707031,7],["οὐκ",709805,28],["εἶδον",709725,150],["αὐτὸν",702165,85],["ἔτι",705538,28],["καὶ",707031,7],["νῦν",709384,28]],"and one is departed from me; and ye said that he was devoured of wild beasts, and I have not seen him until now."],["29",[["ἐὰν",703912,7],["οὖν",709835,11],["λάβητε",708076,125],["καὶ",707031,7],["τοῦτον",709858,85],["ἐκ",704132,0],["προσώπου",710986,21],["μου",709032,133],["καὶ",707031,7],["συμβῇ",712277,172],["αὐτῷ",702165,50],["μαλακία",708435,12],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["καὶ",707031,7],["κατάξετέ",707232,337],["μου",709032,133],["τὸ",709436,24],["γῆρας",703089,25],["μετὰ",708780,0],["λύπης",708273,17],["εἰς",704105,0],["ᾅδου",700255,18]],"If then ye take this one also from my presence, and an affliction happen to him by the way, then shall ye bring down my old age with sorrow to the grave."],["30",[["νῦν",709384,28],["οὖν",709835,11],["ἐὰν",703912,7],["εἰσπορεύωμαι",704124,386],["πρὸς",710844,0],["τὸν",709436,5],["παῖδά",709932,6],["σου",711945,133],["πατέρα",710189,6],["δὲ",703303,11],["ἡμῶν",705999,145],["καὶ",707031,7],["τὸ",709436,24],["παιδάριον",709923,25],["μὴ",708851,28],["ᾖ",704093,204],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["ἡ",709436,10],["δὲ",703303,11],["ψυχὴ",714070,12],["αὐτοῦ",702165,102],["ἐκκρέμαται",704227,117],["ἐκ",704132,0],["τῆς",709436,16],["τούτου",709858,102],["ψυχῆς",714070,17]],"Now then, if I should go in to thy servant, and our father, and the boy should not be with us, (and his life depends on this [lad's] life)—"],["31",[["καὶ",707031,7],["ἔσται",704093,93],["ἐν",704639,0],["τῷ",709436,53],["ἰδεῖν",709725,106],["αὐτὸν",702165,85],["μὴ",708851,28],["ὂν",704093,47],["τὸ",709436,24],["παιδάριον",709923,25],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["τελευτήσει",712781,127],["καὶ",707031,7],["κατάξουσιν",707232,218],["οἱ",709436,136],["παῖδές",709932,52],["σου",711945,133],["τὸ",709436,24],["γῆρας",703089,25],["τοῦ",709436,35],["παιδός",709932,18],["σου",711945,133],["πατρὸς",710189,18],["δὲ",703303,11],["ἡμῶν",705999,145],["μετ᾿",708780,0],["ὀδύνης",709463,17],["εἰς",704105,0],["ᾅδου",700255,18]],"it shall even come to pass, when he sees the boy is not with us, [that] he will die, and thy servants will bring down the old age of thy servant, and our father, with sorrow to the grave."],["32",[["ὁ",709436,3],["γὰρ",702963,11],["παῖς",709932,4],["σου",711945,133],["ἐκδέδεκται",704165,187],["τὸ",709436,24],["παιδίον",709927,25],["παρὰ",709995,0],["τοῦ",709436,35],["πατρὸς",710189,18],["λέγων",708124,72],["ἐὰν",703912,7],["μὴ",708851,28],["ἀγάγω",700209,207],["αὐτὸν",702165,85],["πρὸς",710844,0],["σὲ",711598,163],["καὶ",707031,7],["στήσω",706846,207],["αὐτὸν",702165,85],["ἐναντίον",704654,0],["σου",711945,133],["ἡμαρτηκὼς",700773,270],["ἔσομαι",704093,181],["πρὸς",710844,0],["τὸν",709436,5],["πατέρα",710189,6],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39]],"For thy servant has received the boy [in charge] from his father, saying, If I bring him not to thee, and place him before thee, I shall be guilty towards my father for ever."],["33",[["νῦν",709384,28],["οὖν",709835,11],["παραμενῶ",710071,165],["σοι",711925,159],["παῖς",709932,4],["ἀντὶ",701227,0],["τοῦ",709436,20],["παιδίου",709927,21],["οἰκέτης",709496,4],["τοῦ",709436,35],["κυρίου",707996,18],["τὸ",709436,34],["δὲ",703303,11],["παιδίον",709927,15],["ἀναβήτω",700905,45],["μετὰ",708780,0],["τῶν",709436,80],["ἀδελφῶν",700249,81]],"Now then I will remain a servant with thee instead of the lad, a domestic of my lord; but let the lad go up with his brethren."],["34",[["πῶς",711121,28],["γὰρ",702963,11],["ἀναβήσομαι",700905,181],["πρὸς",710844,0],["τὸν",709436,5],["πατέρα",710189,6],["τοῦ",709436,20],["παιδίου",709927,21],["μὴ",708851,28],["ὄντος",704093,294],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["ἵνα",706747,7],["μὴ",708851,28],["ἴδω",709725,207],["τὰ",709436,41],["κακά",707066,68],["ἃ",709781,371],["εὑρήσει",705676,127],["τὸν",709436,5],["πατέρα",710189,6],["μου",709032,133]],"For how shall I go up to my father, the lad not being with us? lest I behold the evils which will befal my father."]]