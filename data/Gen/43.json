[["1",[["ὁ",709436,3],["δὲ",703303,11],["λιμὸς",708210,4],["ἐνίσχυσεν",704750,2],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"But the famine prevailed in the land."],["2",[["ἐγένετο",703104,23],["δὲ",703303,11],["ἡνίκα",706008,28],["συνετέλεσαν",712510,150],["καταφαγεῖν",707519,106],["τὸν",709436,5],["σῖτον",711814,6],["ὃν",709781,112],["ἤνεγκαν",713428,150],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτῶν",702165,40],["πάλιν",709942,28],["πορευθέντες",710667,247],["πρίασθε",710740,186],["ἡμῖν",705994,90],["μικρὰ",708915,68],["βρώματα",702823,42]],"And it came to pass, when they had finished eating the corn which they had brought out of Egypt, that their father said to them, Go again; buy us a little food."],["3",[["εἶπεν",705373,2],["δὲ",703303,11],["αὐτῷ",702165,50],["Ιουδας",706775,4],["λέγων",708124,72],["διαμαρτυρίᾳ",703512,9],["διαμεμαρτύρηται",703511,187],["ἡμῖν",705994,90],["ὁ",709436,3],["ἄνθρωπος",701163,4],["λέγων",708124,72],["οὐκ",709805,28],["ὄψεσθε",709725,124],["τὸ",709436,24],["πρόσωπόν",710986,25],["μου",709032,133],["ἐὰν",703912,7],["μὴ",708851,28],["ὁ",709436,3],["ἀδελφὸς",700249,4],["ὑμῶν",713091,145],["ὁ",709436,3],["νεώτερος",709256,224],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["ᾖ",704093,204]],"And Judas spoke to him, saying, The man, the lord of the country, positively testified to us, saying, Ye shall not see my face, unless your younger brother be with you."],["4",[["εἰ",704071,7],["μὲν",708730,11],["οὖν",709835,11],["ἀποστέλλεις",701592,154],["τὸν",709436,5],["ἀδελφὸν",700249,6],["ἡμῶν",705999,145],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["καταβησόμεθα",707202,141],["καὶ",707031,7],["ἀγοράσωμέν",700184,79],["σοι",711925,159],["βρώματα",702823,42]],"If, then, thou send our brother with us, we will go down, and buy thee food;"],["5",[["εἰ",704071,7],["δὲ",703303,11],["μὴ",708851,28],["ἀποστέλλεις",701592,154],["τὸν",709436,5],["ἀδελφὸν",700249,6],["ἡμῶν",705999,145],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["οὐ",709805,28],["πορευσόμεθα",710667,141],["ὁ",709436,3],["γὰρ",702963,11],["ἄνθρωπος",701163,4],["εἶπεν",705373,2],["ἡμῖν",705994,90],["λέγων",708124,72],["οὐκ",709805,28],["ὄψεσθέ",709725,124],["μου",709032,133],["τὸ",709436,24],["πρόσωπον",710986,25],["ἐὰν",703912,7],["μὴ",708851,28],["ὁ",709436,3],["ἀδελφὸς",700249,4],["ὑμῶν",713091,145],["ὁ",709436,3],["νεώτερος",709256,224],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["ᾖ",704093,204]],"but if thou send not our brother with us, we will not go: for the man spoke to us, saying, Ye shall not see my face, unless your younger brother be with you."],["6",[["εἶπεν",705373,2],["δὲ",703303,11],["Ισραηλ",706839,4],["τί",712867,126],["ἐκακοποιήσατέ",707062,265],["με",708618,163],["ἀναγγείλαντες",700921,196],["τῷ",709436,113],["ἀνθρώπῳ",701163,114],["εἰ",704071,7],["ἔστιν",704093,91],["ὑμῖν",713084,90],["ἀδελφός",700249,4]],"And Israel said, Why did ye harm me, inasmuch as ye told the man that ye had a brother?"],["7",[["οἱ",709436,136],["δὲ",703303,11],["εἶπαν",705373,150],["ἐρωτῶν",705459,72],["ἐπηρώτησεν",705069,2],["ἡμᾶς",705981,194],["ὁ",709436,3],["ἄνθρωπος",701163,4],["καὶ",707031,7],["τὴν",709436,8],["γενεὰν",703037,9],["ἡμῶν",705999,145],["λέγων",708124,72],["εἰ",704071,7],["ἔτι",705538,28],["ὁ",709436,3],["πατὴρ",710189,4],["ὑμῶν",713091,145],["ζῇ",705851,91],["εἰ",704071,7],["ἔστιν",704093,91],["ὑμῖν",713084,90],["ἀδελφός",700249,4],["καὶ",707031,7],["ἀπηγγείλαμεν",701321,289],["αὐτῷ",702165,50],["κατὰ",707200,0],["τὴν",709436,8],["ἐπερώτησιν",705071,9],["ταύτην",709858,104],["μὴ",708851,28],["ᾔδειμεν",704075,376],["εἰ",704071,7],["ἐρεῖ",705415,127],["ἡμῖν",705994,90],["ἀγάγετε",700209,74],["τὸν",709436,5],["ἀδελφὸν",700249,6],["ὑμῶν",713091,145]],"And they said, The man closely questioned us about our family also, saying, Does your father yet live, and have ye a brother? and we answered him according to this question: did we know that he would say to us, Bring your brother?"],["8",[["εἶπεν",705373,2],["δὲ",703303,11],["Ιουδας",706775,4],["πρὸς",710844,0],["Ισραηλ",706839,6],["τὸν",709436,5],["πατέρα",710189,6],["αὐτοῦ",702165,102],["ἀπόστειλον",701592,176],["τὸ",709436,24],["παιδάριον",709923,25],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["ἀναστάντες",701173,196],["πορευσόμεθα",710667,141],["ἵνα",706747,7],["ζῶμεν",705851,243],["καὶ",707031,7],["μὴ",708851,28],["ἀποθάνωμεν",701461,79],["καὶ",707031,7],["ἡμεῖς",705983,219],["καὶ",707031,7],["σὺ",712181,164],["καὶ",707031,7],["ἡ",709436,10],["ἀποσκευὴ",701573,12],["ἡμῶν",705999,145]],"And Judas said to his father Israel, Send the boy with me, and we will arise and go, that we may live and not die, both we and thou, and our store."],["9",[["ἐγὼ",704018,164],["δὲ",703303,11],["ἐκδέχομαι",704165,254],["αὐτόν",702165,85],["ἐκ",704132,0],["χειρός",713787,17],["μου",709032,133],["ζήτησον",705879,176],["αὐτόν",702165,85],["ἐὰν",703912,7],["μὴ",708851,28],["ἀγάγω",700209,207],["αὐτὸν",702165,85],["πρὸς",710844,0],["σὲ",711598,163],["καὶ",707031,7],["στήσω",706846,207],["αὐτὸν",702165,85],["ἐναντίον",704654,0],["σου",711945,133],["ἡμαρτηκὼς",700773,270],["ἔσομαι",704093,181],["πρὸς",710844,0],["σὲ",711598,163],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39]],"And I engage for him; at my hand do thou require him; if I bring him not to thee, and place him before thee, I shall be guilty toward thee for ever."],["10",[["εἰ",704071,7],["μὴ",708851,28],["γὰρ",702963,11],["ἐβραδύναμεν",702806,289],["ἤδη",705939,28],["ἂν",700900,11],["ὑπεστρέψαμεν",713246,289],["δίς",703741,28]],"For if we had not tarried, we should now have returned twice."],["11",[["εἶπεν",705373,2],["δὲ",703303,11],["αὐτοῖς",702165,151],["Ισραηλ",706839,4],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτῶν",702165,40],["εἰ",704071,7],["οὕτως",709859,28],["ἐστίν",704093,91],["τοῦτο",709858,129],["ποιήσατε",710582,74],["λάβετε",708076,74],["ἀπὸ",701425,0],["τῶν",709436,80],["καρπῶν",707169,81],["τῆς",709436,16],["γῆς",703083,17],["ἐν",704639,0],["τοῖς",709436,95],["ἀγγείοις",700138,96],["ὑμῶν",713091,145],["καὶ",707031,7],["καταγάγετε",707232,74],["τῷ",709436,113],["ἀνθρώπῳ",701163,114],["δῶρα",703907,42],["τῆς",709436,16],["ῥητίνης",711252,17],["καὶ",707031,7],["τοῦ",709436,20],["μέλιτος",708700,21],["θυμίαμα",706330,25],["καὶ",707031,7],["στακτὴν",712043,9],["καὶ",707031,7],["τερέμινθον",712798,9],["καὶ",707031,7],["κάρυα",707187,42]],"And Israel, their father, said to them, If it be so, do this; take of the fruits of the earth in your vessels, and carry down to the man presents of gum and honey, and frankincense, and stacte, and turpentine, and walnuts."],["12",[["καὶ",707031,7],["τὸ",709436,24],["ἀργύριον",701707,25],["δισσὸν",703744,46],["λάβετε",708076,74],["ἐν",704639,0],["ταῖς",709436,75],["χερσὶν",713787,76],["ὑμῶν",713091,145],["τὸ",709436,24],["ἀργύριον",701707,25],["τὸ",709436,24],["ἀποστραφὲν",701598,377],["ἐν",704639,0],["τοῖς",709436,147],["μαρσίπποις",708522,148],["ὑμῶν",713091,145],["ἀποστρέψατε",701598,74],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["μήποτε",708882,28],["ἀγνόημά",700176,15],["ἐστιν",704093,91]],"And take double money in your hands, and the money that was returned in your sacks, carry back with you, lest peradventure it is a mistake."],["13",[["καὶ",707031,7],["τὸν",709436,5],["ἀδελφὸν",700249,6],["ὑμῶν",713091,145],["λάβετε",708076,74],["καὶ",707031,7],["ἀναστάντες",701173,196],["κατάβητε",707202,74],["πρὸς",710844,0],["τὸν",709436,5],["ἄνθρωπον",701163,6]],"And take your brother; and arise, go down to the man."],["14",[["ὁ",709436,3],["δὲ",703303,11],["θεός",706192,4],["μου",709032,133],["δῴη",703654,225],["ὑμῖν",713084,90],["χάριν",713735,9],["ἐναντίον",704654,0],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["καὶ",707031,7],["ἀποστείλαι",701592,225],["τὸν",709436,5],["ἀδελφὸν",700249,6],["ὑμῶν",713091,145],["τὸν",709436,5],["ἕνα",704106,27],["καὶ",707031,7],["τὸν",709436,5],["Βενιαμιν",702650,6],["ἐγὼ",704018,164],["μὲν",708730,11],["γάρ",702963,11],["καθὰ",706979,28],["ἠτέκνωμαι",702081,326],["ἠτέκνωμαι",702081,326]],"And my God give you favour in the sight of the man, and send away your other brother, and Benjamin, for I accordingly as I have been bereaved, am bereaved."],["15",[["λαβόντες",708076,196],["δὲ",703303,11],["οἱ",709436,136],["ἄνδρες",701150,52],["τὰ",709436,41],["δῶρα",703907,42],["ταῦτα",709858,71],["καὶ",707031,7],["τὸ",709436,24],["ἀργύριον",701707,25],["διπλοῦν",703740,46],["ἔλαβον",708076,150],["ἐν",704639,0],["ταῖς",709436,75],["χερσὶν",713787,76],["αὐτῶν",702165,40],["καὶ",707031,7],["τὸν",709436,5],["Βενιαμιν",702650,6],["καὶ",707031,7],["ἀναστάντες",701173,196],["κατέβησαν",707202,150],["εἰς",704105,0],["Αἴγυπτον",700401,9],["καὶ",707031,7],["ἔστησαν",706846,150],["ἐναντίον",704654,0],["Ιωσηφ",706948,18]],"And the men having taken these presents, and the double money, took in their hands also Benjamin; and they rose up and went down to Egypt, and stood before Joseph."],["16",[["εἶδεν",704075,2],["δὲ",703303,11],["Ιωσηφ",706948,6],["αὐτοὺς",702165,62],["καὶ",707031,7],["τὸν",709436,5],["Βενιαμιν",702650,6],["τὸν",709436,5],["ἀδελφὸν",700249,6],["αὐτοῦ",702165,102],["τὸν",709436,5],["ὁμομήτριον",709637,27],["καὶ",707031,7],["εἶπεν",705373,2],["τῷ",709436,113],["ἐπὶ",705080,0],["τῆς",709436,16],["οἰκίας",709505,17],["αὐτοῦ",702165,102],["εἰσάγαγε",704107,176],["τοὺς",709436,58],["ἀνθρώπους",701163,57],["εἰς",704105,0],["τὴν",709436,8],["οἰκίαν",709505,9],["καὶ",707031,7],["σφάξον",712571,176],["θύματα",706327,42],["καὶ",707031,7],["ἑτοίμασον",705539,176],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["γὰρ",702963,11],["φάγονται",705495,135],["οἱ",709436,136],["ἄνθρωποι",701163,52],["ἄρτους",701829,57],["τὴν",709436,8],["μεσημβρίαν",708758,9]],"And Joseph saw them and his brother Benjamin, born of the same mother; and he said to the steward of his household, Bring the men into the house, and slay beasts and make ready, for the men are to eat bread with me at noon."],["17",[["ἐποίησεν",710582,2],["δὲ",703303,11],["ὁ",709436,3],["ἄνθρωπος",701163,4],["καθὰ",706979,28],["εἶπεν",705373,2],["Ιωσηφ",706948,4],["καὶ",707031,7],["εἰσήγαγεν",704107,2],["τοὺς",709436,58],["ἀνθρώπους",701163,57],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["Ιωσηφ",706948,18]],"And the man did as Joseph said; and he brought the men into the house of Joseph."],["18",[["ἰδόντες",709725,196],["δὲ",703303,11],["οἱ",709436,136],["ἄνθρωποι",701163,52],["ὅτι",709803,7],["εἰσήχθησαν",704107,99],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["Ιωσηφ",706948,18],["εἶπαν",705373,150],["διὰ",703417,0],["τὸ",709436,24],["ἀργύριον",701707,25],["τὸ",709436,24],["ἀποστραφὲν",701598,377],["ἐν",704639,0],["τοῖς",709436,147],["μαρσίπποις",708522,148],["ἡμῶν",705999,145],["τὴν",709436,8],["ἀρχὴν",701836,9],["ἡμεῖς",705983,219],["εἰσαγόμεθα",704107,378],["τοῦ",709436,20],["συκοφαντῆσαι",712256,106],["ἡμᾶς",705981,194],["καὶ",707031,7],["ἐπιθέσθαι",705304,109],["ἡμῖν",705994,90],["τοῦ",709436,20],["λαβεῖν",708076,106],["ἡμᾶς",705981,194],["εἰς",704105,0],["παῖδας",709932,57],["καὶ",707031,7],["τοὺς",709436,58],["ὄνους",709671,57],["ἡμῶν",705999,145]],"And the men, when they perceived that they were brought into the house of Joseph, said, We are brought in because of the money that was returned in our sacks at the first; even in order to inform against us, and lay it to our charge; to take us for servants, and our asses."],["19",[["προσελθόντες",710890,196],["δὲ",703303,11],["πρὸς",710844,0],["τὸν",709436,5],["ἄνθρωπον",701163,6],["τὸν",709436,5],["ἐπὶ",705080,0],["τοῦ",709436,35],["οἴκου",709516,18],["Ιωσηφ",706948,18],["ἐλάλησαν",708071,150],["αὐτῷ",702165,50],["ἐν",704639,0],["τῷ",709436,113],["πυλῶνι",711083,114],["τοῦ",709436,35],["οἴκου",709516,18]],"And having approached the man who was over the house of Joseph, they spoke to him in the porch of the house,"],["20",[["λέγοντες",708124,146],["δεόμεθα",703361,378],["κύριε",707996,153],["κατέβημεν",707202,289],["τὴν",709436,8],["ἀρχὴν",701836,9],["πρίασθαι",710740,109],["βρώματα",702823,42]],"saying, We pray [thee], Sir; we came down at first to buy food."],["21",[["ἐγένετο",703104,23],["δὲ",703303,11],["ἡνίκα",706008,28],["ἤλθομεν",705453,289],["εἰς",704105,0],["τὸ",709436,24],["καταλῦσαι",707323,106],["καὶ",707031,7],["ἠνοίξαμεν",701186,289],["τοὺς",709436,58],["μαρσίππους",708522,57],["ἡμῶν",705999,145],["καὶ",707031,7],["τόδε",709446,132],["τὸ",709436,34],["ἀργύριον",701707,15],["ἑκάστου",704133,116],["ἐν",704639,0],["τῷ",709436,113],["μαρσίππῳ",708522,114],["αὐτοῦ",702165,102],["τὸ",709436,24],["ἀργύριον",701707,25],["ἡμῶν",705999,145],["ἐν",704639,0],["σταθμῷ",712040,114],["ἀπεστρέψαμεν",701598,289],["νῦν",709384,28],["ἐν",704639,0],["ταῖς",709436,75],["χερσὶν",713787,76],["ἡμῶν",705999,145]],"And it came to pass, when we came to unlade, and opened our sacks, [there was] also this money of each in his sack; we have now brought back our money by weight in our hands."],["22",[["καὶ",707031,7],["ἀργύριον",701707,25],["ἕτερον",705535,46],["ἠνέγκαμεν",713428,289],["μεθ᾿",708780,0],["ἑαυτῶν",703917,40],["ἀγοράσαι",700184,106],["βρώματα",702823,42],["οὐκ",709805,28],["οἴδαμεν",709492,314],["τίς",712867,158],["ἐνέβαλεν",704547,2],["τὸ",709436,24],["ἀργύριον",701707,25],["εἰς",704105,0],["τοὺς",709436,58],["μαρσίππους",708522,57],["ἡμῶν",705999,145]],"And we have brought other money with us to buy food; we know not who put the money into our sacks."],["23",[["εἶπεν",705373,2],["δὲ",703303,11],["αὐτοῖς",702165,151],["ἵλεως",706732,14],["ὑμῖν",713084,90],["μὴ",708851,28],["φοβεῖσθε",713532,374],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["καὶ",707031,7],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,80],["πατέρων",710189,81],["ὑμῶν",713091,145],["ἔδωκεν",703654,2],["ὑμῖν",713084,90],["θησαυροὺς",706258,57],["ἐν",704639,0],["τοῖς",709436,147],["μαρσίπποις",708522,148],["ὑμῶν",713091,145],["τὸ",709436,24],["δὲ",703303,11],["ἀργύριον",701707,25],["ὑμῶν",713091,145],["εὐδοκιμοῦν",705567,47