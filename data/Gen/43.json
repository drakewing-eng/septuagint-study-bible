ἄνθρωποι",701163,52],["ἕκαστος",704133,14],["πρὸς",710844,0],["τὸν",709436,5],["ἀδελφὸν",700249,6],["αὐτοῦ",702165,102]],"And they sat before him, the first-born according to his seniority, and the younger according to his youth; and the men looked with amazement every one at his brother."],["34",[["ἦραν",700473,150],["δὲ",703303,11],["μερίδας",708748,39],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["πρὸς",710844,0],["αὐτούς",702165,62],["ἐμεγαλύνθη",708647,37],["δὲ",703303,11],["ἡ",709436,10],["μερὶς",708748,12],["Βενιαμιν",702650,18],["παρὰ",709995,0],["τὰς",709436,38],["μερίδας",708748,39],["πάντων",710177,169],["πενταπλασίως",710263,28],["πρὸς",710844,0],["τὰς",709436,38],["ἐκείνων",704183,40],["ἔπιον",710478,150],["δὲ",703303,11],["καὶ",707031,7],["ἐμεθύσθησαν",708676,99],["μετ᾿",708780,0],["αὐτοῦ",702165,102]],"And they took their portions from him to themselves; but Benjamin's portion was five times as much as the portions of [the others]. And they drank and were filled with drink with him."]]