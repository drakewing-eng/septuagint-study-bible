[["1",[["ἐγένετο",703104,23],["δὲ",703303,11],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["κατέβη",707202,2],["Ιουδας",706775,4],["ἀπὸ",701425,0],["τῶν",709436,80],["ἀδελφῶν",700249,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀφίκετο",702212,23],["ἕως",705792,0],["πρὸς",710844,0],["ἄνθρωπόν",701163,6],["τινα",712866,356],["Οδολλαμίτην",709453,6],["ᾧ",709781,309],["ὄνομα",709666,15],["Ιρας",706797,4]],"And it came to pass at that time that Judas went down from his brethren, and came as far as to a certain man of Odollam, whose name was Iras."],["2",[["καὶ",707031,7],["εἶδεν",709725,2],["ἐκεῖ",704181,28],["Ιουδας",706775,4],["θυγατέρα",706320,9],["ἀνθρώπου",701163,18],["Χαναναίου",713711,18],["ᾗ",709781,108],["ὄνομα",709666,15],["Σαυα",711558,12],["καὶ",707031,7],["ἔλαβεν",708076,2],["αὐτὴν",702165,104],["καὶ",707031,7],["εἰσῆλθεν",704114,2],["πρὸς",710844,0],["αὐτήν",702165,104]],"And Judas saw there the daughter of a Chananitish man, whose name was Sava; and he took her, and went in to her."],["3",[["καὶ",707031,7],["συλλαβοῦσα",712262,149],["ἔτεκεν",712853,2],["υἱὸν",713075,6],["καὶ",707031,7],["ἐκάλεσεν",707084,2],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["Ηρ",706016,6]],"And she conceived and bore a son, and called his name, Er."],["4",[["καὶ",707031,7],["συλλαβοῦσα",712262,149],["ἔτι",705538,28],["ἔτεκεν",712853,2],["υἱὸν",713075,6],["καὶ",707031,7],["ἐκάλεσεν",707084,2],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["Αυναν",702143,6]],"And she conceived and bore a son again; and called his name, Aunan."],["5",[["καὶ",707031,7],["προσθεῖσα",710965,149],["ἔτι",705538,28],["ἔτεκεν",712853,2],["υἱὸν",713075,6],["καὶ",707031,7],["ἐκάλεσεν",707084,2],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["Σηλωμ",711739,6],["αὐτὴ",702165,107],["δὲ",703303,11],["ἦν",704093,13],["ἐν",704639,0],["Χασβι",713759,111],["ἡνίκα",706008,28],["ἔτεκεν",712853,2],["αὐτούς",702165,62]],"And she again bore a son; and called his name, Selom: and she was in Chasbi when she bore them."],["6",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Ιουδας",706775,4],["γυναῖκα",703209,9],["Ηρ",706016,114],["τῷ",709436,113],["πρωτοτόκῳ",711046,30],["αὐτοῦ",702165,102],["ᾗ",709781,108],["ὄνομα",709666,15],["Θαμαρ",706078,12]],"And Judas took a wife for Er his first-born, whose name was Thamar."],["7",[["ἐγένετο",703104,23],["δὲ",703303,11],["Ηρ",706016,4],["πρωτότοκος",711046,14],["Ιουδα",706768,18],["πονηρὸς",710660,14],["ἐναντίον",704654,0],["κυρίου",707996,18],["καὶ",707031,7],["ἀπέκτεινεν",701498,2],["αὐτὸν",702165,85],["ὁ",709436,3],["θεός",706192,4]],"And Er, the first-born of Judas, was wicked before the Lord; and God killed him."],["8",[["εἶπεν",705373,2],["δὲ",703303,11],["Ιουδας",706775,4],["τῷ",709436,113],["Αυναν",702143,114],["εἴσελθε",704114,176],["πρὸς",710844,0],["τὴν",709436,8],["γυναῖκα",703209,9],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["σου",711945,133],["καὶ",707031,7],["γάμβρευσαι",702949,300],["αὐτὴν",702165,104],["καὶ",707031,7],["ἀνάστησον",701173,176],["σπέρμα",712008,25],["τῷ",709436,113],["ἀδελφῷ",700249,114],["σου",711945,133]],"And Judas said to Aunan, Go in to thy brother's wife, and marry her as her brother-in-law, and raise up seed to thy brother."],["9",[["γνοὺς",703105,182],["δὲ",703303,11],["Αυναν",702143,4],["ὅτι",709803,7],["οὐκ",709805,28],["αὐτῷ",702165,50],["ἔσται",704093,93],["τὸ",709436,34],["σπέρμα",712008,15],["ἐγίνετο",703104,19],["ὅταν",709801,28],["εἰσήρχετο",704114,19],["πρὸς",710844,0],["τὴν",709436,8],["γυναῖκα",703209,9],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["αὐτοῦ",702165,102],["ἐξέχεεν",704368,13],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["τοῦ",709436,20],["μὴ",708851,28],["δοῦναι",703654,106],["σπέρμα",712008,25],["τῷ",709436,113],["ἀδελφῷ",700249,114],["αὐτοῦ",702165,102]],"And Aunan, knowing that the seed should not be his—it came to pass when he went in to his brother's wife, that he spilled [it] upon the ground, so that he should not give seed to his brother's wife."],["10",[["πονηρὸν",710660,26],["δὲ",703303,11],["ἐφάνη",713311,37],["ἐναντίον",704654,0],["τοῦ",709436,35],["θεοῦ",706192,18],["ὅτι",709803,7],["ἐποίησεν",710582,2],["τοῦτο",709858,129],["καὶ",707031,7],["ἐθανάτωσεν",706097,2],["καὶ",707031,7],["τοῦτον",709858,85]],"And his doing this appeared evil before God; and he slew him also."],["11",[["εἶπεν",705373,2],["δὲ",703303,11],["Ιουδας",706775,4],["Θαμαρ",706078,1],["τῇ",709436,100],["νύμφῃ",709381,1],["αὐτοῦ",702165,102],["κάθου",707000,253],["χήρα",713848,12],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["ἕως",705792,7],["μέγας",708653,14],["γένηται",703104,239],["Σηλωμ",711739,4],["ὁ",709436,3],["υἱός",713075,4],["μου",709032,133],["εἶπεν",705373,2],["γάρ",702963,11],["μήποτε",708882,28],["ἀποθάνῃ",701461,172],["καὶ",707031,7],["οὗτος",709858,121],["ὥσπερ",714163,28],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["αὐτοῦ",702165,102],["ἀπελθοῦσα",701398,149],["δὲ",703303,11],["Θαμαρ",706078,12],["ἐκάθητο",707000,19],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτῆς",702165,86]],"And Judas said to Thamar, his daughter-in-law, Sit thou a widow in the house of thy father-in-law, until Selom my son be grown; for he said, Lest he also die as his brethren; and Thamar departed, and sat in the house of her father."],["12",[["ἐπληθύνθησαν",710530,99],["δὲ",703303,11],["αἱ",709436,190],["ἡμέραι",705984,191],["καὶ",707031,7],["ἀπέθανεν",701461,2],["Σαυα",711558,12],["ἡ",709436,10],["γυνὴ",703209,12],["Ιουδα",706768,18],["καὶ",707031,7],["παρακληθεὶς",710039,217],["Ιουδας",706775,4],["ἀνέβη",700905,2],["ἐπὶ",705080,0],["τοὺς",709436,58],["κείροντας",707597,235],["τὰ",709436,41],["πρόβατα",710768,42],["αὐτοῦ",702165,102],["αὐτὸς",702165,121],["καὶ",707031,7],["Ιρας",706797,4],["ὁ",709436,3],["ποιμὴν",710596,4],["αὐτοῦ",702165,102],["ὁ",709436,3],["Οδολλαμίτης",709453,4],["εἰς",704105,0],["Θαμνα",706084,227]],"And the days were fulfilled, and Sava the wife of Judas died; and Judas, being comforted, went to them that sheared his sheep, himself and Iras his shepherd the Odollamite, to Thamna."],["13",[["καὶ",707031,7],["ἀπηγγέλη",701321,37],["Θαμαρ",706078,1],["τῇ",709436,100],["νύμφῃ",709381,1],["αὐτοῦ",702165,102],["λέγοντες",708124,146],["ἰδοὺ",706497,88],["ὁ",709436,3],["πενθερός",710250,4],["σου",711945,133],["ἀναβαίνει",700905,91],["εἰς",704105,0],["Θαμνα",706084,227],["κεῖραι",707597,106],["τὰ",709436,41],["πρόβατα",710768,42],["αὐτοῦ",702165,102]],"And it was told Thamar his daughter-in-law, saying, Behold, thy father-in-law goeth up to Thamna, to shear his sheep."],["14",[["καὶ",707031,7],["περιελομένη",710288,357],["τὰ",709436,41],["ἱμάτια",706742,42],["τῆς",709436,16],["χηρεύσεως",713851,17],["ἀφ᾿",701425,0],["ἑαυτῆς",703917,86],["περιεβάλετο",710294,23],["θέριστρον",706210,25],["καὶ",707031,7],["ἐκαλλωπίσατο",707095,23],["καὶ",707031,7],["ἐκάθισεν",707006,2],["πρὸς",710844,0],["ταῖς",709436,75],["πύλαις",711082,76],["Αιναν",700455,118],["ἥ",709781,177],["ἐστιν",704093,91],["ἐν",704639,0],["παρόδῳ",710154,1],["Θαμνα",706084,111],["εἶδεν",709725,2],["γὰρ",702963,11],["ὅτι",709803,7],["μέγας",708653,14],["γέγονεν",703104,171],["Σηλωμ",711739,4],["αὐτὸς",702165,121],["δὲ",703303,11],["οὐκ",709805,28],["ἔδωκεν",703654,2],["αὐτὴν",702165,104],["αὐτῷ",702165,50],["γυναῖκα",703209,9]],"And having taken off the garments of her widowhood from her, she put on a veil, and ornamented her face, and sat by the gates of Ænan, which is in the way to Thamna, for she saw that Selom was grown; but he gave her not to him for a wife."],["15",[["καὶ",707031,7],["ἰδὼν",709725,182],["αὐτὴν",702165,104],["Ιουδας",706775,4],["ἔδοξεν",703775,2],["αὐτὴν",702165,104],["πόρνην",710675,9],["εἶναι",704093,55],["κατεκαλύψατο",707260,23],["γὰρ",702963,11],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτῆς",702165,86],["καὶ",707031,7],["οὐκ",709805,28],["ἐπέγνω",705104,2],["αὐτήν",702165,104]],"And when Judas saw her, he thought her to be a harlot; for she covered her face, and he knew her not."],["16",[["ἐξέκλινεν",704220,13],["δὲ",703303,11],["πρὸς",710844,0],["αὐτὴν",702165,104],["τὴν",709436,8],["ὁδὸν",709458,9],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῇ",702165,105],["ἔασόν",703918,176],["με",708618,163],["εἰσελθεῖν",704114,106],["πρὸς",710844,0],["σέ",711598,163],["οὐ",709805,28],["γὰρ",702963,11],["ἔγνω",703105,2],["ὅτι",709803,7],["ἡ",709436,10],["νύμφη",709381,12],["αὐτοῦ",702165,102],["ἐστιν",704093,91],["ἡ",709436,10],["δὲ",703303,11],["εἶπεν",705373,2],["τί",712867,126],["μοι",708974,159],["δώσεις",703654,166],["ἐὰν",703912,7],["εἰσέλθῃς",704114,175],["πρός",710844,0],["με",708618,163]],"And he went out of his way to her, and said to her, Let me come in to thee; for he knew not that she was his daughter-in-law; and she said, What wilt thou give me if thou shouldest come in to me?"],["17",[["ὁ",709436,3],["δὲ",703303,11],["εἶπεν",705373,2],["ἐγώ",704018,164],["σοι",711925,159],["ἀποστελῶ",701592,165],["ἔριφον",705429,6],["αἰγῶν",700464,81],["ἐκ",704132,0],["τῶν",709436,43],["προβάτων",710768,44],["ἡ",709436,10],["δὲ",703303,11],["εἶπεν",705373,2],["ἐὰν",703912,7],["δῷς",703654,175],["ἀρραβῶνα",701806,6],["ἕως",705792,0],["τοῦ",709436,20],["ἀποστεῖλαί",701592,106],["σε",711598,163]],"And he said, I will send thee a kid of the goats from my flock; and she said, [Well], if thou wilt give me an earnest, until thou send it."],["18",[["ὁ",709436,3],["δὲ",703303,11],["εἶπεν",705373,2],["τίνα",712867,356],["τὸν",709436,5],["ἀρραβῶνά",701806,6],["σοι",711925,159],["δώσω",703654,165],["ἡ",709436,10],["δὲ",703303,11],["εἶπεν",705373,2],["τὸν",709436,5],["δακτύλιόν",703258,6],["σου",711945,133],["καὶ",707031,7],["τὸν",709436,5],["ὁρμίσκον",709758,6],["καὶ",707031,7],["τὴν",709436,8],["ῥάβδον",711135,9],["τὴν",709436,8],["ἐν",704639,0],["τῇ",709436,100],["χειρί",713787,1],["σου",711945,133],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῇ