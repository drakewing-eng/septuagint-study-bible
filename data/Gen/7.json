πὸ",701425,0],["τῶν",709436,43],["πετεινῶν",710438,44],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,43],["κτηνῶν",707934,44],["τῶν",709436,43],["καθαρῶν",706988,83],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,43],["κτηνῶν",707934,44],["τῶν",709436,43],["μὴ",708851,28],["καθαρῶν",706988,83],["καὶ",707031,7],["ἀπὸ",701425,0],["πάντων",710177,83],["τῶν",709436,43],["ἑρπετῶν",705441,44],["τῶν",709436,43],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"And of clean flying creatures and of unclean flying creatures, and of clean cattle and of unclean cattle, and of all things that creep upon the earth,"],["9",[["δύο",703849,59],["δύο",703849,59],["εἰσῆλθον",704114,150],["πρὸς",710844,0],["Νωε",709395,6],["εἰς",704105,0],["τὴν",709436,8],["κιβωτόν",707667,9],["ἄρσεν",701818,46],["καὶ",707031,7],["θῆλυ",706237,46],["καθὰ",706979,28],["ἐνετείλατο",704791,23],["αὐτῷ",702165,50],["ὁ",709436,3],["θεός",706192,4]],"pairs went in to Noe into the ark, male and female, as God commanded Noe."],["10",[["καὶ",707031,7],["ἐγένετο",703104,23],["μετὰ",708780,0],["τὰς",709436,38],["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["καὶ",707031,7],["τὸ",709436,34],["ὕδωρ",713071,15],["τοῦ",709436,35],["κατακλυσμοῦ",707279,18],["ἐγένετο",703104,23],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"And it came to pass after the seven days that the water of the flood came upon the earth."],["11",[["ἐν",704639,0],["τῷ",709436,53],["ἑξακοσιοστῷ",704848,97],["ἔτει",705543,54],["ἐν",704639,0],["τῇ",709436,100],["ζωῇ",705910,1],["τοῦ",709436,35],["Νωε",709395,18],["τοῦ",709436,35],["δευτέρου",703389,116],["μηνός",708874,18],["ἑβδόμῃ",703925,101],["καὶ",707031,7],["εἰκάδι",704082,1],["τοῦ",709436,35],["μηνός",708874,18],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ταύτῃ",709858,105],["ἐρράγησαν",711243,150],["πᾶσαι",710177,192],["αἱ",709436,190],["πηγαὶ",710450,191],["τῆς",709436,16],["ἀβύσσου",700098,17],["καὶ",707031,7],["οἱ",709436,136],["καταρράκται",707404,52],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["ἠνεῴχθησαν",701186,99]],"In the six hundredth year of the life of Noe, in the second month, on the twenty-seventh day of the month, on this day all the fountains of the abyss were broken up, and the flood-gates of heaven were opened."],["12",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὁ",709436,3],["ὑετὸς",713074,4],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["τεσσαράκοντα",712806,59],["ἡμέρας",705984,39],["καὶ",707031,7],["τεσσαράκοντα",712806,59],["νύκτας",709386,39]],"And the rain was upon the earth forty days and forty nights."],["13",[["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ταύτῃ",709858,105],["εἰσῆλθεν",704114,2],["Νωε",709395,4],["Σημ",711743,4],["Χαμ",713699,4],["Ιαφεθ",706462,4],["υἱοὶ",713075,52],["Νωε",709395,18],["καὶ",707031,7],["ἡ",709436,10],["γυνὴ",703209,12],["Νωε",709395,18],["καὶ",707031,7],["αἱ",709436,190],["τρεῖς",712927,192],["γυναῖκες",703209,191],["τῶν",709436,80],["υἱῶν",713075,81],["αὐτοῦ",702165,102],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὴν",709436,8],["κιβωτόν",707667,9]],"On that very day entered Noe, Sem, Cham, Japheth, the sons of Noe, and the wife of Noe, and the three wives of his sons with him into the ark."],["14",[["καὶ",707031,7],["πάντα",710177,195],["τὰ",709436,63],["θηρία",706252,64],["κατὰ",707200,0],["γένος",703057,25],["καὶ",707031,7],["πάντα",710177,195],["τὰ",709436,63],["κτήνη",707934,64],["κατὰ",707200,0],["γένος",703057,25],["καὶ",707031,7],["πᾶν",710177,26],["ἑρπετὸν",705441,15],["κινούμενον",707679,208],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["κατὰ",707200,0],["γένος",703057,25],["καὶ",707031,7],["πᾶν",710177,26],["πετεινὸν",710438,15],["κατὰ",707200,0],["γένος",703057,25]],"And all the wild beasts after their kind, and all cattle after their kind, and every reptile moving itself on the earth after its kind, and every flying bird after its kind,"],["15",[["εἰσῆλθον",704114,150],["πρὸς",710844,0],["Νωε",709395,6],["εἰς",704105,0],["τὴν",709436,8],["κιβωτόν",707667,9],["δύο",703849,59],["δύο",703849,59],["ἀπὸ",701425,0],["πάσης",710177,82],["σαρκός",711537,17],["ἐν",704639,0],["ᾧ",709781,209],["ἐστιν",704093,91],["πνεῦμα",710566,15],["ζωῆς",705910,17]],"went in to Noe into the ark, pairs, male and female of all flesh in which is the breath of life."],["16",[["καὶ",707031,7],["τὰ",709436,63],["εἰσπορευόμενα",704124,210],["ἄρσεν",701818,46],["καὶ",707031,7],["θῆλυ",706237,46],["ἀπὸ",701425,0],["πάσης",710177,82],["σαρκὸς",711537,17],["εἰσῆλθεν",704114,2],["καθὰ",706979,28],["ἐνετείλατο",704791,23],["ὁ",709436,3],["θεὸς",706192,4],["τῷ",709436,113],["Νωε",709395,114],["καὶ",707031,7],["ἔκλεισεν",707710,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἔξωθεν",704984,28],["αὐτοῦ",702165,102],["τὴν",709436,8],["κιβωτόν",707667,9]],"And they that entered went in male and female of all flesh, as God commanded Noe, and the Lord God shut the ark outside of him."],["17",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὁ",709436,3],["κατακλυσμὸς",707279,4],["τεσσαράκοντα",712806,59],["ἡμέρας",705984,39],["καὶ",707031,7],["τεσσαράκοντα",712806,59],["νύκτας",709386,39],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἐπληθύνθη",710530,37],["τὸ",709436,34],["ὕδωρ",713071,15],["καὶ",707031,7],["ἐπῆρεν",705002,2],["τὴν",709436,8],["κιβωτόν",707667,9],["καὶ",707031,7],["ὑψώθη",713289,37],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17]],"And the flood was upon the earth forty days and forty nights, and the water abounded greatly and bore up the ark, and it was lifted on high from off the earth."],["18",[["καὶ",707031,7],["ἐπεκράτει",705176,13],["τὸ",709436,34],["ὕδωρ",713071,15],["καὶ",707031,7],["ἐπληθύνετο",710530,19],["σφόδρα",712586,28],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἐπεφέρετο",705322,19],["ἡ",709436,10],["κιβωτὸς",707667,12],["ἐπάνω",705030,0],["τοῦ",709436,20],["ὕδατος",713071,21]],"And the water prevailed and abounded exceedingly upon the earth, and the ark was borne upon the water."],["19",[["τὸ",709436,34],["δὲ",703303,11],["ὕδωρ",713071,15],["ἐπεκράτει",705176,13],["σφόδρα",712586,28],["σφοδρῶς",712588,28],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἐπεκάλυψεν",705155,2],["πάντα",710177,68],["τὰ",709436,41],["ὄρη",709768,42],["τὰ",709436,41],["ὑψηλά",713285,68],["ἃ",709781,69],["ἦν",704093,13],["ὑποκάτω",713204,0],["τοῦ",709436,35],["οὐρανοῦ",709844,18]],"And the water prevailed exceedingly upon the earth, and covered all the high mountains which were under heaven."],["20",[["δέκα",703333,59],["πέντε",710266,59],["πήχεις",710462,57],["ἐπάνω",705030,28],["ὑψώθη",713289,37],["τὸ",709436,34],["ὕδωρ",713071,15],["καὶ",707031,7],["ἐπεκάλυψεν",705155,2],["πάντα",710177,68],["τὰ",709436,41],["ὄρη",709768,42],["τὰ",709436,41],["ὑψηλά",713285,68]],"Fifteen cubits upwards was the water raised, and it covered all the high mountains."],["21",[["καὶ",707031,7],["ἀπέθανεν",701461,2],["πᾶσα",710177,29],["σὰρξ",711537,12],["κινουμένη",707679,211],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["τῶν",709436,43],["πετεινῶν",710438,44],["καὶ",707031,7],["τῶν",709436,43],["κτηνῶν",707934,44],["καὶ",707031,7],["τῶν",709436,43],["θηρίων",706252,44],["καὶ",707031,7],["πᾶν",710177,26],["ἑρπετὸν",705441,15],["κινούμενον",707679,212],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["πᾶς",710177,14],["ἄνθρωπος",701163,4]],"And there died all flesh that moved upon the earth, of flying creatures and cattle, and of wild beasts, and every reptile moving upon the earth, and every man."],["22",[["καὶ",707031,7],["πάντα",710177,68],["ὅσα",709788,68],["ἔχει",705785,91],["πνοὴν",710574,9],["ζωῆς",705910,17],["καὶ",707031,7],["πᾶς",710177,14],["ὃς",709781,213],["ἦν",704093,13],["ἐπὶ",705080,0],["τῆς",709436,16],["ξηρᾶς",709421,82],["ἀπέθανεν",701461,2]],"And all things which have the breath of life, and whatever was on the dry land, died."],["23",[["καὶ",707031,7],["ἐξήλειψεν",704852,2],["πᾶν",710177,26],["τὸ",709436,34],["ἀνάστημα",701058,15],["ὃ",709781,33],["ἦν",704093,13],["ἐπὶ",705080,0],["προσώπου",710986,21],["πάσης",710177,82],["τῆς",709436,16],["γῆς",703083,17],["ἀπὸ",701425,0],["ἀνθρώπου",701163,18],["ἕως",705792,0],["κτήνους",707934,21],["καὶ",707031,7],["ἑρπετῶν",705441,44],["καὶ",707031,7],["τῶν",709436,43],["πετεινῶν",710438,44],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["ἐξηλείφθησαν",704852,99],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["κατελείφθη",707305,37],["μόνος",709003,14],["Νωε",709395,4],["καὶ",707031,7],["οἱ",709436,136],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῇ",709436,100],["κιβωτῷ",707667,1]],"And [God] blotted out every offspring which was upon the face of the earth, both man and beast, and reptiles, and birds of the sky, and they were blotted out from the earth, and Noe was left alone, and those with him in the ark."],["24",[["καὶ",707031,7],["ὑψώθη",713289,37],["τὸ",709436,34],["ὕδωρ",713071,15],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ἡμέρας",705984,39],["ἑκατὸν",704136,59],["πεντήκοντα",710270,59]],"And the water was raised over the earth an hundred and fifty days."]]