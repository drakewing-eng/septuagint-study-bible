[["1",[["καὶ",707031,7],["ἐξάρας",704839,182],["Ιακωβ",706401,4],["τοὺς",709436,58],["πόδας",710707,57],["ἐπορεύθη",710667,37],["εἰς",704105,0],["γῆν",703083,9],["ἀνατολῶν",701071,65],["πρὸς",710844,0],["Λαβαν",708037,6],["τὸν",709436,5],["υἱὸν",713075,6],["Βαθουηλ",702377,18],["τοῦ",709436,35],["Σύρου",712541,18],["ἀδελφὸν",700249,6],["δὲ",703303,11],["Ρεβεκκας",711213,17],["μητρὸς",708892,17],["Ιακωβ",706401,18],["καὶ",707031,7],["Ησαυ",706030,18]],"And Jacob started and went to the land of the east to Laban, the son of Bathuel the Syrian, and the brother of Rebecca, mother of Jacob and Esau."],["2",[["καὶ",707031,7],["ὁρᾷ",709725,91],["καὶ",707031,7],["ἰδοὺ",706497,88],["φρέαρ",713576,15],["ἐν",704639,0],["τῷ",709436,53],["πεδίῳ",710215,54],["ἦσαν",704093,137],["δὲ",703303,11],["ἐκεῖ",704181,28],["τρία",712927,195],["ποίμνια",710598,64],["προβάτων",710768,44],["ἀναπαυόμενα",701027,210],["ἐπ᾿",705080,0],["αὐτοῦ",702165,102],["ἐκ",704132,0],["γὰρ",702963,11],["τοῦ",709436,20],["φρέατος",713576,21],["ἐκείνου",704183,102],["ἐπότιζον",710700,137],["τὰ",709436,41],["ποίμνια",710598,42],["λίθος",708196,4],["δὲ",703303,11],["ἦν",704093,13],["μέγας",708653,14],["ἐπὶ",705080,0],["τῷ",709436,53],["στόματι",712125,54],["τοῦ",709436,20],["φρέατος",713576,21]],"And he looks, and behold! a well in the plain; and there were there three flocks of sheep resting at it, for out of that well they watered the flocks, but there was a great stone at the mouth of the well."],["3",[["καὶ",707031,7],["συνήγοντο",712375,139],["ἐκεῖ",704181,28],["πάντα",710177,195],["τὰ",709436,63],["ποίμνια",710598,64],["καὶ",707031,7],["ἀπεκύλιον",701500,137],["τὸν",709436,5],["λίθον",708196,6],["ἀπὸ",701425,0],["τοῦ",709436,20],["στόματος",712125,21],["τοῦ",709436,20],["φρέατος",713576,21],["καὶ",707031,7],["ἐπότιζον",710700,137],["τὰ",709436,41],["πρόβατα",710768,42],["καὶ",707031,7],["ἀπεκαθίστων",701470,137],["τὸν",709436,5],["λίθον",708196,6],["ἐπὶ",705080,0],["τὸ",709436,24],["στόμα",712125,25],["τοῦ",709436,20],["φρέατος",713576,21],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["αὐτοῦ",702165,102]],"And there were all the flocks gathered, and they used to roll away the stone from the mouth of the well, and water the flocks, and set the stone again in its place on the mouth of the well."],["4",[["εἶπεν",705373,2],["δὲ",703303,11],["αὐτοῖς",702165,151],["Ιακωβ",706401,4],["ἀδελφοί",700249,274],["πόθεν",710580,28],["ἐστὲ",704093,87],["ὑμεῖς",713081,219],["οἱ",709436,136],["δὲ",703303,11],["εἶπαν",705373,150],["ἐκ",704132,0],["Χαρραν",713750,118],["ἐσμέν",704093,243]],"And Jacob said to them, Brethren, whence are ye? and they said, We are of Charrhan."],["5",[["εἶπεν",705373,2],["δὲ",703303,11],["αὐτοῖς",702165,151],["γινώσκετε",703105,87],["Λαβαν",708037,6],["τὸν",709436,5],["υἱὸν",713075,6],["Ναχωρ",709227,18],["οἱ",709436,136],["δὲ",703303,11],["εἶπαν",705373,150],["γινώσκομεν",703105,243]],"And he said to them, Know ye Laban, the son of Nachor? and they said, We do know [him]."],["6",[["εἶπεν",705373,2],["δὲ",703303,11],["αὐτοῖς",702165,151],["ὑγιαίνει",713057,91],["οἱ",709436,136],["δὲ",703303,11],["εἶπαν",705373,150],["ὑγιαίνει",713057,91],["καὶ",707031,7],["ἰδοὺ",706497,88],["Ραχηλ",711208,12],["ἡ",709436,10],["θυγάτηρ",706320,12],["αὐτοῦ",702165,102],["ἤρχετο",705453,19],["μετὰ",708780,0],["τῶν",709436,43],["προβάτων",710768,44]],"And he said to them, Is he well? And they said, He is well. And behold Rachel his daughter came with the sheep."],["7",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιακωβ",706401,4],["ἔτι",705538,28],["ἐστὶν",704093,91],["ἡμέρα",705984,12],["πολλή",710646,29],["οὔπω",709837,28],["ὥρα",714128,12],["συναχθῆναι",712375,179],["τὰ",709436,41],["κτήνη",707934,42],["ποτίσαντες",710700,196],["τὰ",709436,41],["πρόβατα",710768,42],["ἀπελθόντες",701398,196],["βόσκετε",702767,87]],"And Jacob said, It is yet high day, it is not yet time that the flocks be gathered together; water ye the flocks, and depart and feed them."],["8",[["οἱ",709436,136],["δὲ",703303,11],["εἶπαν",705373,150],["οὐ",709805,28],["δυνησόμεθα",703838,141],["ἕως",705792,0],["τοῦ",709436,20],["συναχθῆναι",712375,179],["πάντας",710177,60],["τοὺς",709436,58],["ποιμένας",710596,57],["καὶ",707031,7],["ἀποκυλίσωσιν",701500,234],["τὸν",709436,5],["λίθον",708196,6],["ἀπὸ",701425,0],["τοῦ",709436,20],["στόματος",712125,21],["τοῦ",709436,20],["φρέατος",713576,21],["καὶ",707031,7],["ποτιοῦμεν",710700,275],["τὰ",709436,41],["πρόβατα",710768,42]],"And they said, We shall not be able, until all the shepherds be gathered together, and they shall roll away the stone from the mouth of the well, then we will water the flocks."],["9",[["ἔτι",705538,28],["αὐτοῦ",702165,102],["λαλοῦντος",708071,152],["αὐτοῖς",702165,151],["καὶ",707031,7],["Ραχηλ",711208,12],["ἡ",709436,10],["θυγάτηρ",706320,12],["Λαβαν",708037,18],["ἤρχετο",705453,19],["μετὰ",708780,0],["τῶν",709436,43],["προβάτων",710768,44],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτῆς",702165,86],["αὐτὴ",702165,107],["γὰρ",702963,11],["ἔβοσκεν",702767,13],["τὰ",709436,41],["πρόβατα",710768,42],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτῆς",702165,86]],"While he was yet speaking to them, behold, Rachel the daughter of Laban came with her father's sheep, for she fed the sheep of her father."],["10",[["ἐγένετο",703104,23],["δὲ",703303,11],["ὡς",714148,7],["εἶδεν",704075,2],["Ιακωβ",706401,4],["τὴν",709436,8],["Ραχηλ",711208,9],["θυγατέρα",706320,9],["Λαβαν",708037,18],["ἀδελφοῦ",700249,18],["τῆς",709436,16],["μητρὸς",708892,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["πρόβατα",710768,42],["Λαβαν",708037,18],["ἀδελφοῦ",700249,18],["τῆς",709436,16],["μητρὸς",708892,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["προσελθὼν",710890,182],["Ιακωβ",706401,4],["ἀπεκύλισεν",701500,2],["τὸν",709436,5],["λίθον",708196,6],["ἀπὸ",701425,0],["τοῦ",709436,20],["στόματος",712125,21],["τοῦ",709436,20],["φρέατος",713576,21],["καὶ",707031,7],["ἐπότισεν",710700,2],["τὰ",709436,41],["πρόβατα",710768,42],["Λαβαν",708037,18],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["τῆς",709436,16],["μητρὸς",708892,17],["αὐτοῦ",702165,102]],"And it came to pass when Jacob saw Rachel the daughter of Laban, his mother's brother, and the sheep of Laban, his mother's brother, that Jacob came and rolled away the stone from the mouth of the well, and watered the sheep of Laban, his mother's brother."],["11",[["καὶ",707031,7],["ἐφίλησεν",713471,2],["Ιακωβ",706401,4],["τὴν",709436,8],["Ραχηλ",711208,9],["καὶ",707031,7],["βοήσας",702743,182],["τῇ",709436,100],["φωνῇ",713640,1],["αὐτοῦ",702165,102],["ἔκλαυσεν",707703,2]],"And Jacob kissed Rachel, and cried with a loud voice and wept."],["12",[["καὶ",707031,7],["ἀνήγγειλεν",700921,2],["τῇ",709436,100],["Ραχηλ",711208,1],["ὅτι",709803,7],["ἀδελφὸς",700249,4],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτῆς",702165,86],["ἐστιν",704093,91],["καὶ",707031,7],["ὅτι",709803,7],["υἱὸς",713075,4],["Ρεβεκκας",711213,17],["ἐστίν",704093,91],["καὶ",707031,7],["δραμοῦσα",712931,149],["ἀπήγγειλεν",701321,2],["τῷ",709436,113],["πατρὶ",710189,114],["αὐτῆς",702165,86],["κατὰ",707200,0],["τὰ",709436,41],["ῥήματα",711246,42],["ταῦτα",709858,71]],"And he told Rachel that he was the near relative of her father, and the son of Rebecca; and she ran and reported to her father according to these words."],["13",[["ἐγένετο",703104,23],["δὲ",703303,11],["ὡς",714148,7],["ἤκουσεν",700587,2],["Λαβαν",708037,4],["τὸ",709436,24],["ὄνομα",709666,25],["Ιακωβ",706401,18],["τοῦ",709436,35],["υἱοῦ",713075,18],["τῆς",709436,16],["ἀδελφῆς",700244,17],["αὐτοῦ",702165,102],["ἔδραμεν",712931,2],["εἰς",704105,0],["συνάντησιν",712397,9],["αὐτῷ",702165,50],["καὶ",707031,7],["περιλαβὼν",710342,182],["αὐτὸν",702165,85],["ἐφίλησεν",713471,2],["καὶ",707031,7],["εἰσήγαγεν",704107,2],["αὐτὸν",702165,85],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["διηγήσατο",703679,23],["τῷ",709436,113],["Λαβαν",708037,114],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62]],"And it came to pass when Laban heard the name of Jacob, his sister's son, he ran to meet him, and embraced and kissed him, and brought him into his house; and he told Laban all these sayings."],["14",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["Λαβαν",708037,4],["ἐκ",704132,0],["τῶν",709436,43],["ὀστῶν",709792,44],["μου",709032,133],["καὶ",707031,7],["ἐκ",704132,0],["τῆς",709436,16],["σαρκός",711537,17],["μου",709032,133],["εἶ",704093,154],["σύ",712181,164],["καὶ",707031,7],["ἦν",704093,13],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["μῆνα",708874,6],["ἡμερῶν",705984,65]],"And Laban said to him, Thou art of my bones and of my flesh; and he was with him a full month."],["15",[["εἶπεν",705373,2],["δὲ",703303,11],["Λαβαν",708037,4],["τῷ",709436,113],["Ιακωβ",706401,114],["ὅτι",709803,7],["γὰρ",702963,11],["ἀδελφός",700249,4],["μου",709032,133],["εἶ",704093,154],["οὐ",709805,28],["δουλεύσεις",703814,166],["μοι",708974,159],["δωρεάν",703901,9],["ἀπάγγειλόν",701321,176],["μοι",708974,159],["τίς",712867,158],["ὁ",709436,3],["μισθός",708939,4],["σού",711945,133],["ἐστιν",704093,91]],"And Laban said to Jacob, Surely thou shalt not serve me for nothing, because thou art my brother; tell me what thy reward is to be."],["16",[["τῷ",709436,113],["δὲ",703303,11],["Λαβαν",708037,114],["δύο",703849,59],["θυγατέρες",706320,191],["ὄνομα",709666,15],["τῇ",709436,100],["μείζονι",708653,324],["Λεια",708127,12],["καὶ",707031,7],["ὄνομα",709666,25],["τῇ",709436,100],["νεωτέρᾳ",709256,324],["Ραχηλ",711208,12]],"Now Laban had two daughters, the name of the elder was Lea, and the name of the younger, Rachel."],["17",[["οἱ",709436,136],["δὲ",703303,11],["ὀφθαλμοὶ",709870,52],["Λειας",708127,17],["ἀσθενεῖς",701939,138],["Ραχηλ",711208,12],["δὲ",703303,11],["καλὴ",707097,29],["τῷ",709436,53],["εἴδει",704074,54],["καὶ",707031,7],["ὡραία",714132,29],["τῇ",709436,100],["ὄψει",709901,1]],"And the eyes of Lea were weak. But Rachel was beautiful in appearance, and exceedingly fair in countenance."],["18",[["ἠγάπησεν",700120,2],["δὲ",703303,11],["Ιακωβ",706401,4],["τὴν",709436,8],["Ραχηλ",711208,9],["καὶ",707031,7],["εἶπεν",705373,2],["δουλεύσω",703814,165],["σοι",711925,159],["ἑπτὰ",705357,59],["ἔτη",705543,42],["περὶ",710285,0],["Ραχηλ",711208,17],["τῆς",709436,16],["θυγατρός",706320,17],["σου",711945,133],["τῆς",709436,16],["νεωτέρας",709256,325]],"And Jacob loved Rachel, and said, I will serve thee seven years for thy younger daughter Rachel."],["19",[["εἶπεν",705373,2],["δὲ",703303,11],["αὐτῷ",702165,50],["Λαβαν",708037,4],["βέλτιον",702647,26],["δοῦναί",703654,106],["με",708618,163],["αὐτὴν",702165,104],["σοὶ",711925,159],["ἢ",705924,7],["δοῦναί",703654,106],["με",708618,163],["αὐτὴν",702165,104],["ἀνδρὶ",701150,114],["ἑτέρῳ",705535,30],["οἴκησον",709499,176],["μετ᾿",708780,0],["ἐμοῦ",704580,133]],"And Laban said to him, [It is] better that I should give her to thee, than that I should give her to another man; dwell with me."],["20",[["καὶ",707031,7],["ἐδούλευσεν",703814,2],["Ιακωβ",706401,4],["περὶ",710285,0],["Ραχηλ",711208,17],["ἔτη",705543,42],["ἑπτά",705357,59],["καὶ",707031,7],["ἦσαν",704093,137],["ἐναντίον",704654,0],["αὐτοῦ",702165,102],["ὡς",714148,7],["ἡμέραι",705984,191],["ὀλίγαι",709568,192],["παρὰ",709995,0],["τὸ",709436,24],["ἀγαπᾶν",700120,55],["αὐτὸν",702165,85],["αὐτήν",702165,104]],"And Jacob served for Rachel seven years, and they were before him as a few days, by reason of his loving her."],["21",[["εἶπεν",705373,2],["δὲ",703303,11],["Ιακωβ",706401,4],["πρὸς",710844,0],["Λαβαν",708037,6],["ἀπόδος",701449,176],["τὴν",709436,8],["γυναῖκά",703209,9],["μου",709032,133],["πεπλήρωνται",710543,255],["γὰρ",702963,11],["αἱ",709436,190],["ἡμέραι",705984,191],["μου",709032,133],["ὅπως",709719,7],["εἰσέλθω",704114,207],["πρὸς",710844,0],["αὐτήν",702165,104]],"And Jacob said to Laban, Give me my wife, for my days are fulfilled, that I may go in to her."],["22",[["συνήγαγεν",712375,2],["δὲ",703303,11],["Λαβαν",708037,4],["πάντας",710177,60],["τοὺς",709436,58],["ἄνδρας",701150,57],["τοῦ",709436,35],["τόπου",712903,18],["καὶ",707031,7],["ἐποίησεν",710582,2],["γάμον",702957,6]],"And Laban gathered together all the men of the place, and made a marriage-feast."],["23",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἑσπέρα",705500,12],["καὶ",707031,7],["λαβὼν",708076,182],["Λαβαν",708037,4],["Λειαν",708127,9],["τὴν",709436,8],["θυγατέρα",706320,9],["αὐτοῦ",702165,102],["εἰσήγαγεν",704107,2],["αὐτὴν",702165,104],["πρὸς",710844,0],["Ιακωβ",706401,6],["καὶ",707031,7],["εἰσῆλθεν",704114,2],["πρὸς",710844,0],["αὐτὴν",702165,104],["Ιακωβ",706401,4]],"And it was even, and he took his daughter Lea, and brought her in to Jacob, and Jacob went in to her."],["24",[["ἔδωκεν",703654,2],["δὲ",703303,11],["Λαβαν",708037,4],["Λεια",708127,1],["τῇ",709436,100],["θυγατρὶ",706320,1],["αὐτοῦ",702165,102],["Ζελφαν",705856,9],["τὴν",709436,8],["παιδίσκην",709928,9],["αὐτοῦ",702165,102],["αὐτῇ",702165,105],["παιδίσκην",709928,9]],"And Laban gave to his daughter Lea, Zelpha his handmaid, as a handmaid for her."],["25",[["ἐγένετο",703104,23],["δὲ",703303,11],["πρωί",711021,28],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἦν",704093,13],["Λεια",708127,12],["εἶπεν",705373,2],["δὲ",703303,11],["Ιακωβ",706401,4],["τῷ",709436,113],["Λαβαν",708037,114],["τί",712867,126],["τοῦτο",709858,129],["ἐποίησάς",710582,162],["μοι",708974,159],["οὐ",709805,28],["περὶ",710285,0],["Ραχηλ",711208,17],["ἐδούλευσα",703814,155],["παρὰ",709995,0],["σοί",711925,159],["καὶ",707031,7],["ἵνα",706747,7],["τί",712867,126],["παρελογίσω",710067,174],["με",708618,163]],"And it was morning, and behold it was Lea; and Jacob said to Laban, What is this that thou hast done to me? did I not serve thee for Rachel? and wherefore hast thou deceived me?"],["26",[["εἶπεν",705373,2],["δὲ",703303,11],["Λαβαν",708037,4],["οὐκ",709805,28],["ἔστιν",704093,91],["οὕτως",709859,28],["ἐν",704639,0],["τῷ",709436,113],["τόπῳ",712903,114],["ἡμῶν",705999,145],["δοῦν