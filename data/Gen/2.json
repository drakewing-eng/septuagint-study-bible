[["1",[["καὶ",707031,7],["συνετελέσθησαν",712510,99],["ὁ",709436,3],["οὐρανὸς",709844,4],["καὶ",707031,7],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["κόσμος",707851,4],["αὐτῶν",702165,40]],"And the heavens and the earth were finished, and the whole world of them."],["2",[["καὶ",707031,7],["συνετέλεσεν",712510,2],["ὁ",709436,3],["θεὸς",706192,4],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["ἕκτῃ",704340,101],["τὰ",709436,41],["ἔργα",705396,42],["αὐτοῦ",702165,102],["ἃ",709781,69],["ἐποίησεν",710582,2],["καὶ",707031,7],["κατέπαυσεν",707365,2],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["ἑβδόμῃ",703925,101],["ἀπὸ",701425,0],["πάντων",710177,83],["τῶν",709436,43],["ἔργων",705396,44],["αὐτοῦ",702165,102],["ὧν",709781,103],["ἐποίησεν",710582,2]],"And God finished on the sixth day his works which he made, and he ceased on the seventh day from all his works which he made."],["3",[["καὶ",707031,7],["ηὐλόγησεν",705631,2],["ὁ",709436,3],["θεὸς",706192,4],["τὴν",709436,8],["ἡμέραν",705984,9],["τὴν",709436,8],["ἑβδόμην",703925,36],["καὶ",707031,7],["ἡγίασεν",700153,2],["αὐτήν",702165,104],["ὅτι",709803,7],["ἐν",704639,0],["αὐτῇ",702165,105],["κατέπαυσεν",707365,2],["ἀπὸ",701425,0],["πάντων",710177,83],["τῶν",709436,43],["ἔργων",705396,44],["αὐτοῦ",702165,102],["ὧν",709781,103],["ἤρξατο",701860,23],["ὁ",709436,3],["θεὸς",706192,4],["ποιῆσαι",710582,106]],"And God blessed the seventh day and sanctified it, because in it he ceased from all his works which God began to do."],["4",[["αὕτη",709858,107],["ἡ",709436,10],["βίβλος",702721,12],["γενέσεως",703043,17],["οὐρανοῦ",709844,18],["καὶ",707031,7],["γῆς",703083,17],["ὅτε",709802,28],["ἐγένετο",703104,23],["ᾗ",709781,108],["ἡμέρᾳ",705984,1],["ἐποίησεν",710582,2],["ὁ",709436,3],["θεὸς",706192,4],["τὸν",709436,5],["οὐρανὸν",709844,6],["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9]],"This [is] the book of the generation of heaven and earth, when they were made, in the day in which the Lord God made the heaven and the earth,"],["5",[["καὶ",707031,7],["πᾶν",710177,46],["χλωρὸν",713880,46],["ἀγροῦ",700196,18],["πρὸ",710747,0],["τοῦ",709436,20],["γενέσθαι",703104,109],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["πάντα",710177,27],["χόρτον",713923,6],["ἀγροῦ",700196,18],["πρὸ",710747,0],["τοῦ",709436,20],["ἀνατεῖλαι",701066,106],["οὐ",709805,28],["γὰρ",702963,11],["ἔβρεξεν",702812,2],["ὁ",709436,3],["θεὸς",706192,4],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἄνθρωπος",701163,4],["οὐκ",709805,28],["ἦν",704093,13],["ἐργάζεσθαι",705383,110],["τὴν",709436,8],["γῆν",703083,9]],"and every herb of the field before it was on the earth, and all the grass of the field before it sprang up, for God had not rained on the earth, and there was not a man to cultivate it."],["6",[["πηγὴ",710450,12],["δὲ",703303,11],["ἀνέβαινεν",700905,13],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἐπότιζεν",710700,13],["πᾶν",710177,46],["τὸ",709436,24],["πρόσωπον",710986,25],["τῆς",709436,16],["γῆς",703083,17]],"But there rose a fountain out of the earth, and watered the whole face of the earth."],["7",[["καὶ",707031,7],["ἔπλασεν",710503,2],["ὁ",709436,3],["θεὸς",706192,4],["τὸν",709436,5],["ἄνθρωπον",701163,6],["χοῦν",713930,6],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἐνεφύσησεν",704636,2],["εἰς",704105,0],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["πνοὴν",710574,9],["ζωῆς",705910,17],["καὶ",707031,7],["ἐγένετο",703104,23],["ὁ",709436,3],["ἄνθρωπος",701163,4],["εἰς",704105,0],["ψυχὴν",714070,9],["ζῶσαν",705851,78]],"And God formed the man [of] dust of the earth, and breathed upon his face the breath of life, and the man became a living soul."],["8",[["καὶ",707031,7],["ἐφύτευσεν",713636,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["παράδεισον",710012,6],["ἐν",704639,0],["Εδεμ",704027,111],["κατὰ",707200,0],["ἀνατολὰς",701071,39],["καὶ",707031,7],["ἔθετο",712849,23],["ἐκεῖ",704181,28],["τὸν",709436,5],["ἄνθρωπον",701163,6],["ὃν",709781,112],["ἔπλασεν",710503,2]],"And God planted a garden eastward in Edem, and placed there the man whom he had formed."],["9",[["καὶ",707031,7],["ἐξανέτειλεν",704863,2],["ὁ",709436,3],["θεὸς",706192,4],["ἔτι",705538,28],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17],["πᾶν",710177,46],["ξύλον",709427,25],["ὡραῖον",714132,46],["εἰς",704105,0],["ὅρασιν",709721,9],["καὶ",707031,7],["καλὸν",707097,27],["εἰς",704105,0],["βρῶσιν",702825,9],["καὶ",707031,7],["τὸ",709436,34],["ξύλον",709427,15],["τῆς",709436,16],["ζωῆς",705910,17],["ἐν",704639,0],["μέσῳ",708768,30],["τῷ",709436,113],["παραδείσῳ",710012,114],["καὶ",707031,7],["τὸ",709436,24],["ξύλον",709427,25],["τοῦ",709436,20],["εἰδέναι",704075,115],["γνωστὸν",703141,46],["καλοῦ",707097,116],["καὶ",707031,7],["πονηροῦ",710660,116]],"And God made to spring up also out of the earth every tree beautiful to the eye and good for food, and the tree of life in the midst of the garden, and the tree of learning the knowledge of good and evil."],["10",[["ποταμὸς",710693,4],["δὲ",703303,11],["ἐκπορεύεται",704293,117],["ἐξ",704132,0],["Εδεμ",704027,118],["ποτίζειν",710700,55],["τὸν",709436,5],["παράδεισον",710012,6],["ἐκεῖθεν",704182,28],["ἀφορίζεται",702227,117],["εἰς",704105,0],["τέσσαρας",712808,119],["ἀρχάς",701836,39]],"And a river proceeds out of Edem to water the garden, thence it divides itself into four heads."],["11",[["ὄνομα",709666,15],["τῷ",709436,113],["ἑνὶ",704106,30],["Φισων",713515,120],["οὗτος",709858,121],["ὁ",709436,3],["κυκλῶν",707958,72],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9],["Ευιλατ",705606,118],["ἐκεῖ",704181,28],["οὗ",709806,48],["ἐστιν",704093,91],["τὸ",709436,34],["χρυσίον",713972,15]],"The name of the one, Phisom, this it is which encircles the whole land of Evilat, where there is gold."],["12",[["τὸ",709436,24],["δὲ",703303,11],["χρυσίον",713972,25],["τῆς",709436,16],["γῆς",703083,17],["ἐκείνης",704183,86],["καλόν",707097,27],["καὶ",707031,7],["ἐκεῖ",704181,28],["ἐστιν",704093,91],["ὁ",709436,3],["ἄνθραξ",701160,4],["καὶ",707031,7],["ὁ",709436,3],["λίθος",708196,4],["ὁ",709436,3],["πράσινος",710718,4]],"And the gold of that land is good, there also is carbuncle and emerald."],["13",[["καὶ",707031,7],["ὄνομα",709666,25],["τῷ",709436,113],["ποταμῷ",710693,114],["τῷ",709436,113],["δευτέρῳ",703389,30],["Γηων",703098,120],["οὗτος",709858,121],["ὁ",709436,3],["κυκλῶν",707958,72],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9],["Αἰθιοπίας",700419,17]],"And the name of the second river is Geon, this it is which encircles the whole land of Ethiopia."],["14",[["καὶ",707031,7],["ὁ",709436,3],["ποταμὸς",710693,4],["ὁ",709436,3],["τρίτος",712968,14],["Τίγρις",712848,120],["οὗτος",709858,121],["ὁ",709436,3],["πορευόμενος",710667,122],["κατέναντι",707507,0],["Ἀσσυρίων",702004,81],["ὁ",709436,3],["δὲ",703303,11],["ποταμὸς",710693,4],["ὁ",709436,3],["τέταρτος",712811,14],["οὗτος",709858,121],["Εὐφράτης",705716,4]],"And the third river is Tigris, this is that which flows forth over against the Assyrians. And the fourth river is Euphrates."],["15",[["καὶ",707031,7],["ἔλαβεν",708076,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τὸν",709436,5],["ἄνθρωπον",701163,6],["ὃν",709781,112],["ἔπλασεν",710503,2],["καὶ",707031,7],["ἔθετο",712849,23],["αὐτὸν",702165,85],["ἐν",704639,0],["τῷ",709436,113],["παραδείσῳ",710012,114],["ἐργάζεσθαι",705383,110],["αὐτὸν",702165,85],["καὶ",707031,7],["φυλάσσειν",713619,55]],"And the Lord God took the man whom he had formed, and placed him in the garden of Delight, to cultivate and keep it."],["16",[["καὶ",707031,7],["ἐνετείλατο",704791,23],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τῷ",709436,113],["Αδαμ",700222,114],["λέγων",708124,72],["ἀπὸ",701425,0],["παντὸς",710177,92],["ξύλου",709427,21],["τοῦ",709436,20],["ἐν",704639,0],["τῷ",709436,113],["παραδείσῳ",710012,114],["βρώσει",702825,1],["φάγῃ",705495,123]],"And the Lord God gave a charge to Adam, saying, Of every tree which is in the garden thou mayest freely eat,"],["17",[["ἀπὸ",701425,0],["δὲ",703303,11],["τοῦ",709436,20],["ξύλου",709427,21],["τοῦ",709436,20],["γινώσκειν",703105,55],["καλὸν",707097,46],["καὶ",707031,7],["πονηρόν",710660,46],["οὐ",709805,28],["φάγεσθε",705495,124],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["ᾗ",709781,108],["δ᾿",703303,11],["ἂν",700900,11],["ἡμέρᾳ",705984,1],["φάγητε",705495,125],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["θανάτῳ",706096,114],["ἀποθανεῖσθε",701461,124]],"but of the tree of the knowledge of good and evil—of it ye shall not eat, but in whatsoever day ye eat of it, ye shall surely die."],["18",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["οὐ",709805,28],["καλὸν",707097,46],["εἶναι",704093,55],["τὸν",709436,5],["ἄνθρωπον",701163,6],["μόνον",709001,28],["ποιήσωμεν",710582,79],["αὐτῷ",702165,50],["βοηθὸν",702748,6],["κατ᾿",707200,0],["αὐτόν",702165,85]],"And the Lord God said, [It is] not good that the man should be alone, let us make for him a help suitable to him."],["19",[["καὶ",707031,7],["ἔπλασεν",710503,2],["ὁ",709436,3],["θεὸς",706192,4],["ἔτι",705538,28],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17],["πάντα",710177,68],["τὰ",709436,41],["θηρία",706252,42],["τοῦ",709436,35],["ἀγροῦ",700196,18],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["πετεινὰ",710438,42],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["ἤγαγεν",700209,2],["αὐτὰ",702165,71],["πρὸς",710844,0],["τὸν",709436,5],["Αδαμ",700222,6],["ἰδεῖν",709725,106],["τί",712867,126],["καλέσει",707084,127],["αὐτά",702165,71],["καὶ",707031,7],["πᾶν",710177,26],["ὃ",709781,128],["ἐὰν",703912,7],["ἐκάλεσεν",707084,2],["αὐτὸ",702165,129],["Αδαμ",700222,4],["ψυχὴν",714070,9],["ζῶσαν",705851,78],["τοῦτο",709858,129],["ὄνομα",709666,25],["αὐτοῦ",702165,102]],"And God formed yet farther out of the earth all the wild beasts of the field, and all the birds of the sky, and he brought them to Adam, to see what he would call them, and whatever Adam called any living creature, that was the name of it."],["20",[["καὶ",707031,7],["ἐκάλεσεν",707084,2],["Αδαμ",700222,4],["ὀνόματα",709666,42],["πᾶσιν",710177,94],["τοῖς",709436,95],["κτήνεσιν",707934,96],["καὶ",707031,7],["πᾶσι",710177,94],["τοῖς",709436,95],["πετεινοῖς",710438,96],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["πᾶσι",710177,94],["τοῖς",709436,95],["θηρίοις",706252,96],["τοῦ",709436,35],["ἀγροῦ",700196,18],["τῷ",709436,113],["δὲ",703303,11],["Αδαμ",700222,114],["οὐχ",709805,28],["εὑρέθη",705676,37],["βοηθὸς",702748,4],["ὅμοιος",709626,14],["αὐτῷ",702165,50]],"And Adam gave names to all the cattle and to all the birds of the sky, and to all the wild beasts of the field, but for Adam there was not found a help like to himself."],["21",[["καὶ",707031,7],["ἐπέβαλεν",705083,2],["ὁ",709436,3],["θεὸς",706192,4],["ἔκστασιν",704314,9],["ἐπὶ",705080,0],["τὸν",709436,5],["Αδαμ",700222,4],["καὶ",707031,7],["ὕπνωσεν",713182,2],["καὶ",707031,7],["ἔλαβεν",708076,2],["μίαν",704106,36],["τῶν",709436,130],["πλευρῶν",710524,65],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀνεπλήρωσεν",701035,2],["σάρκα",711537,9],["ἀντ᾿",701227,0],["αὐτῆς",702165,86]],"And God brought a trance upon Adam, and he slept, and he took one of his ribs, and filled up the flesh instead thereof."],["22",[["καὶ",707031,7],["ᾠκοδόμησεν",709509,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τὴν",709436,8],["πλευράν",710524,9],["ἣν",709781,131],["ἔλαβεν",708076,2],["ἀπὸ",701425,0],["τοῦ",709436,35],["Αδαμ",700222,18],["εἰς",704105,0],["γυναῖκα",703209,9],["καὶ",707031,7],["ἤγαγεν",700209,2],["αὐτὴν",702165,104],["πρὸς",710844,0],["τὸν",709436,5],["Αδαμ",700222,6]],"And God formed the rib which he took from Adam into a woman, and brought her to Adam."],["23",[["καὶ",707031,7],["εἶπεν",705373,2],["Αδαμ",700222,4],["τοῦτο",709858,132],["νῦν",709384,28],["ὀστοῦν",709792,15],["ἐκ",704132,0],["τῶν",709436,43],["ὀστέων",709792,44],["μου",709032,133],["καὶ",707031,7],["σὰρξ",711537,12],["ἐκ",704132,0],["τῆς",709436,16],["σαρκός",711537,17],["μου",709032,133],["αὕτη",709858,107],["κληθήσεται",707084,134],["γυνή",703209,12],["ὅτι",709803,7],["ἐκ",704132,0],["τοῦ",709436,35],["ἀνδρὸς",701150,18],["αὐτῆς",702165,86],["ἐλήμφθη",708076,37],["αὕτη",709858,107]],"And Adam said, This now is bone of my bones, and flesh of my flesh; she shall be called woman, because she was taken out of her husband."],["24",[["ἕνεκεν",704709,0],["τούτου",709858,49],["καταλείψει",707305,127],["ἄνθρωπος",701163,4],["τὸν",709436,5],["πατέρα",710189,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὴν",709436,8],["μητέρα",708892,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["προσκολληθήσεται",710921,134],["πρὸς",710844,0],["τὴν",709436,8],["γυναῖκα",703209,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔσονται",704093,135],["οἱ",709436,136],["δύο",703849,59],["εἰς",704105,0],["σάρκα",711537,9],["μίαν",704106,36]],"Therefore shall a man leave his father and his mother and shall cleave to his wife, and they two shall be one flesh."],["25",[["καὶ",707031,7],["ἦσαν",704093,137],["οἱ",709436,136],["δύο",703849,59],["γυμνοί",703202,138],["ὅ",709781,33],["τε",712751,11],["Αδαμ",700222,4],["καὶ",707031,7],["ἡ",709436,10],["γυνὴ",703209,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ᾐσχύνοντο",700485,139]],"And the two were naked, both Adam and his wife, and were not ashamed."]]