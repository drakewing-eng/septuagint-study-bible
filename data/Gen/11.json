[["1",[["καὶ",707031,7],["ἦν",704093,13],["πᾶσα",710177,29],["ἡ",709436,10],["γῆ",703083,12],["χεῖλος",713781,15],["ἕν",704106,26],["καὶ",707031,7],["φωνὴ",713640,12],["μία",704106,29],["πᾶσιν",710177,230]],"And all the earth was one lip, and there was one language to all."],["2",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["τῷ",709436,53],["κινῆσαι",707679,106],["αὐτοὺς",702165,62],["ἀπὸ",701425,0],["ἀνατολῶν",701071,65],["εὗρον",705676,150],["πεδίον",710215,25],["ἐν",704639,0],["γῇ",703083,1],["Σεννααρ",711691,184],["καὶ",707031,7],["κατῴκησαν",707534,150],["ἐκεῖ",704181,28]],"And it came to pass as they moved from the east, they found a plain in the land of Senaar, and they dwelt there."],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["ἄνθρωπος",701163,4],["τῷ",709436,113],["πλησίον",710547,28],["δεῦτε",703383,28],["πλινθεύσωμεν",710553,79],["πλίνθους",710554,39],["καὶ",707031,7],["ὀπτήσωμεν",709715,79],["αὐτὰς",702165,231],["πυρί",711088,54],["καὶ",707031,7],["ἐγένετο",703104,23],["αὐτοῖς",702165,151],["ἡ",709436,10],["πλίνθος",710554,12],["εἰς",704105,0],["λίθον",708196,6],["καὶ",707031,7],["ἄσφαλτος",702043,12],["ἦν",704093,13],["αὐτοῖς",702165,151],["ὁ",709436,3],["πηλός",710457,4]],"And a man said to his neighbour, Come, let us make bricks and bake them with fire. And the brick was to them for stone, and their mortar was bitumen."],["4",[["καὶ",707031,7],["εἶπαν",705373,150],["δεῦτε",703383,28],["οἰκοδομήσωμεν",709509,79],["ἑαυτοῖς",703917,151],["πόλιν",710612,9],["καὶ",707031,7],["πύργον",711092,6],["οὗ",709806,48],["ἡ",709436,10],["κεφαλὴ",707639,12],["ἔσται",704093,93],["ἕως",705792,0],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["ποιήσωμεν",710582,79],["ἑαυτοῖς",703917,151],["ὄνομα",709666,25],["πρὸ",710747,0],["τοῦ",709436,20],["διασπαρῆναι",703584,179],["ἐπὶ",705080,0],["προσώπου",710986,21],["πάσης",710177,82],["τῆς",709436,16],["γῆς",703083,17]],"And they said, Come, let us build to ourselves a city and tower, whose top shall be to heaven, and let us make to ourselves a name, before we are scattered abroad upon the face of all the earth."],["5",[["καὶ",707031,7],["κατέβη",707202,2],["κύριος",707996,4],["ἰδεῖν",709725,106],["τὴν",709436,8],["πόλιν",710612,9],["καὶ",707031,7],["τὸν",709436,5],["πύργον",711092,6],["ὃν",709781,112],["ᾠκοδόμησαν",709509,150],["οἱ",709436,136],["υἱοὶ",713075,52],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"And the Lord came down to see the city and the tower, which the sons of men built."],["6",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["ἰδοὺ",706497,88],["γένος",703057,15],["ἓν",704106,26],["καὶ",707031,7],["χεῖλος",713781,15],["ἓν",704106,26],["πάντων",710177,169],["καὶ",707031,7],["τοῦτο",709858,129],["ἤρξαντο",701860,189],["ποιῆσαι",710582,106],["καὶ",707031,7],["νῦν",709384,28],["οὐκ",709805,28],["ἐκλείψει",704237,127],["ἐξ",704132,0],["αὐτῶν",702165,40],["πάντα",710177,68],["ὅσα",709788,68],["ἂν",700900,11],["ἐπιθῶνται",705304,232],["ποιεῖν",710582,55]],"And the Lord said, Behold, [there is] one race, and one lip of all, and they have begun to do this, and now nothing shall fail from them of all that they may have undertaken to do."],["7",[["δεῦτε",703383,28],["καὶ",707031,7],["καταβάντες",707202,196],["συγχέωμεν",712243,233],["ἐκεῖ",704181,28],["αὐτῶν",702165,40],["τὴν",709436,8],["γλῶσσαν",703120,9],["ἵνα",706747,7],["μὴ",708851,28],["ἀκούσωσιν",700587,234],["ἕκαστος",704133,14],["τὴν",709436,8],["φωνὴν",713640,9],["τοῦ",709436,35],["πλησίον",710547,28]],"Come, and having gone down let us there confound their tongue, that they may not understand each the voice of his neighbour."],["8",[["καὶ",707031,7],["διέσπειρεν",703584,2],["αὐτοὺς",702165,62],["κύριος",707996,4],["ἐκεῖθεν",704182,28],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["πάσης",710177,82],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἐπαύσαντο",710202,189],["οἰκοδομοῦντες",709509,146],["τὴν",709436,8],["πόλιν",710612,9],["καὶ",707031,7],["τὸν",709436,5],["πύργον",711092,6]],"