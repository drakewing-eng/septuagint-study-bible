[["1",[["ἐγένετο",703104,23],["δὲ",703303,11],["ἡ",709436,10],["ζωὴ",705910,12],["Σαρρας",711541,17],["ἔτη",705543,64],["ἑκατὸν",704136,59],["εἴκοσι",704085,59],["ἑπτά",705357,59]],"And the life of Sarrha was an hundred and twenty-seven years."],["2",[["καὶ",707031,7],["ἀπέθανεν",701461,2],["Σαρρα",711541,12],["ἐν",704639,0],["πόλει",710612,1],["Αρβοκ",701700,184],["ἥ",709781,177],["ἐστιν",704093,91],["ἐν",704639,0],["τῷ",709436,53],["κοιλώματι",707766,54],["αὕτη",709858,107],["ἐστὶν",704093,91],["Χεβρων",713777,120],["ἐν",704639,0],["γῇ",703083,1],["Χανααν",713708,184],["ἦλθεν",705453,2],["δὲ",703303,11],["Αβρααμ",700091,4],["κόψασθαι",707829,109],["Σαρραν",711541,9],["καὶ",707031,7],["πενθῆσαι",710251,106]],"And Sarrha died in the city of Arboc, which is in the valley, this is Chebron in the land of Chanaan; and Abraam came to lament for Sarrha and to mourn."],["3",[["καὶ",707031,7],["ἀνέστη",701173,2],["Αβρααμ",700091,4],["ἀπὸ",701425,0],["τοῦ",709436,35],["νεκροῦ",709247,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["τοῖς",709436,147],["υἱοῖς",713075,148],["Χετ",713836,18],["λέγων",708124,72]],"And Abraam stood up from before his dead; and Abraam spoke to the sons of Chet, saying,"],["4",[["πάροικος",710159,14],["καὶ",707031,7],["παρεπίδημος",710139,14],["ἐγώ",704018,164],["εἰμι",704093,157],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["δότε",703654,74],["οὖν",709835,11],["μοι",708974,159],["κτῆσιν",707937,9],["τάφου",712738,18],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["καὶ",707031,7],["θάψω",706103,207],["τὸν",709436,5],["νεκρόν",709247,6],["μου",709032,133],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133]],"I am a sojourner and a stranger among you, give me therefore possession of a burying-place among you, and I will bury my dead away from me."],["5",[["ἀπεκρίθησαν",701492,99],["δὲ",703303,11],["οἱ",709436,136],["υἱοὶ",713075,52],["Χετ",713836,18],["πρὸς",710844,0],["Αβρααμ",700091,6],["λέγοντες",708124,146]],"And the sons of Chet answered to Abraam, saying, Not so, Sir,"],["6",[["μή",708851,28],["κύριε",707996,153],["ἄκουσον",700587,176],["δὲ",703303,11],["ἡμῶν",705999,145],["βασιλεὺς",702580,4],["παρὰ",709995,0],["θεοῦ",706192,18],["εἶ",704093,154],["σὺ",712181,164],["ἐν",704639,0],["ἡμῖν",705994,90],["ἐν",704639,0],["τοῖς",709436,95],["ἐκλεκτοῖς",704240,94],["μνημείοις",708963,96],["ἡμῶν",705999,145],["θάψον",706103,176],["τὸν",709436,5],["νεκρόν",709247,6],["σου",711945,133],["οὐδεὶς",709817,14],["γὰρ",702963,11],["ἡμῶν",705999,145],["τὸ",709436,24],["μνημεῖον",708963,25],["αὐτοῦ",702165,102],["κωλύσει",708020,127],["ἀπὸ",701425,0],["σοῦ",711945,133],["τοῦ",709436,20],["θάψαι",706103,106],["τὸν",709436,5],["νεκρόν",709247,6],["σου",711945,133],["ἐκεῖ",704181,28]],"but hear us; thou art in the midst of us a king from God; bury thy dead in our choice sepulchres, for not one of us will by any means withhold his sepulchre from thee, so that thou shouldest not bury thy dead there."],["7",[["ἀναστὰς",701173,182],["δὲ",703303,11],["Αβρααμ",700091,4],["προσεκύνησεν",710925,2],["τῷ",709436,113],["λαῷ",708094,114],["τῆς",709436,16],["γῆς",703083,17],["τοῖς",709436,147],["υἱοῖς",713075,148],["Χετ",713836,18]],"And Abraam rose up and did obeisance to the people of the land, to the sons of Chet."],["8",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["πρὸς",710844,0],["αὐτοὺς",702165,62],["Αβρααμ",700091,4],["λέγων",708124,72],["εἰ",704071,7],["ἔχετε",705785,87],["τῇ",709436,100],["ψυχῇ",714070,1],["ὑμῶν",713091,145],["ὥστε",714164,7],["θάψαι",706103,106],["τὸν",709436,5],["νεκρόν",709247,6],["μου",709032,133],["ἀπὸ",701425,0],["προσώπου",710986,21],["μου",709032,133],["ἀκούσατέ",700587,74],["μου",709032,133],["καὶ",707031,7],["λαλήσατε",708071,74],["περὶ",710285,0],["ἐμοῦ",704580,133],["Εφρων",705770,114],["τῷ",709436,113],["τοῦ",709436,35],["Σααρ",711328,18]],"And Abraam spoke to them, saying, If ye have it in your mind that I should bury my dead out of my sight, hearken to me, and speak for me to Ephron the son of Saar."],["9",[["καὶ",707031,7],["δότω",703654,45],["μοι",708974,159],["τὸ",709436,24],["σπήλαιον",712012,25],["τὸ",709436,24],["διπλοῦν",703740,46],["ὅ",709781,33],["ἐστιν",704093,91],["αὐτῷ",702165,50],["τὸ",709436,24],["ὂν",704093,47],["ἐν",704639,0],["μέρει",708752,54],["τοῦ",709436,35],["ἀγροῦ",700196,18],["αὐτοῦ",702165,102],["ἀργυρίου",701707,21],["τοῦ",709436,20],["ἀξίου",701308,92],["δότω",703654,45],["μοι",708974,159],["αὐτὸ",702165,129],["ἐν",704639,0],["ὑμῖν",713084,90],["εἰς",704105,0],["κτῆσιν",707937,9],["μνημείου",708963,21]],"And let him give me the double cave which he has, which is in a part of his field, let him give it me for the money it is worth for possession of a burying-place among you."],["10",[["Εφρων",705770,4],["δὲ",703303,11],["ἐκάθητο",707000,19],["ἐν",704639,0],["μέσῳ",708768,30],["τῶν",709436,80],["υἱῶν",713075,81],["Χετ",713836,18],["ἀποκριθεὶς",701492,217],["δὲ",703303,11],["Εφρων",705770,4],["ὁ",709436,3],["Χετταῖος",713838,4],["πρὸς",710844,0],["Αβρααμ",700091,6],["εἶπεν",705373,2],["ἀκουόντων",700587,170],["τῶν",709436,80],["υἱῶν",713075,81],["Χετ",713836,18],["καὶ",707031,7],["πάντων",710177,169],["τῶν",709436,80],["εἰσπορευομένων",704124,299],["εἰς",704105,0],["τὴν",709436,8],["πόλιν",710612,9],["λέγων",708124,72]],"Now Ephron was sitting in the midst of the children of Chet, and Ephron the Chettite answered Abraam and spoke in the hearing of the sons of Chet, and of all who entered the city, saying,"],["11",[["παρ᾿",709995,0],["ἐμοὶ",704577,159],["γενοῦ",703104,300],["κύριε",707996,153],["καὶ",707031,7],["ἄκουσόν",700587,176],["μου",709032,133],["τὸν",709436,5],["ἀγρὸν",700196,6],["καὶ",707031,7],["τὸ",709436,24],["σπήλαιον",712012,25],["τὸ",709436,24],["ἐν",704639,0],["αὐτῷ",702165,50],["σοι",711925,159],["δίδωμι",703654,157],["ἐναντίον",704654,0],["πάντων",710177,169],["τῶν",709436,80],["πολιτῶν",710616,81],["μου",709032,133],["δέδωκά",703654,89],["σοι",711925,159],["θάψον",706103,176],["τὸν",709436,5],["νεκρόν",709247,6],["σου",711945,133]],"Attend to me, my lord, and hear me, I give to thee the field and the cave which is in it; I have given it thee before all my countrymen; bury thy dead."],["12",[["καὶ",707031,7],["προσεκύνησεν",710925,2],["Αβρααμ",700091,4],["ἐναντίον",704654,0],["τοῦ",709436,35],["λαοῦ",708094,18],["τῆς",709436,16],["γῆς",703083,17]],"And Abraam did obeisance before the people of the land."],["13",[["καὶ",707031,7],["εἶπεν",705373,2],["τῷ",709436,113],["Εφρων",705770,114],["εἰς",704105,0],["τὰ",709436,41],["ὦτα",709852,42],["τοῦ",709436,35],["λαοῦ",708094,18],["τῆς",709436,16],["γῆς",703083,17],["ἐπειδὴ",705056,7],["πρὸς",710844,0],["ἐμοῦ",704580,133],["εἶ",704093,154],["ἄκουσόν",700587,176],["μου",709032,133],["τὸ",709436,24],["ἀργύριον",701707,25],["τοῦ",709436,35],["ἀγροῦ",700196,18],["λαβὲ",708076,176],["παρ᾿",709995,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["θάψω",706103,207],["τὸν",709436,5],["νεκρόν",709247,6],["μου",709032,133],["ἐκεῖ",704181,28]],"And he said in the ears of Ephron before the people of the land, Since thou art on my side, hear me; take the price of the field from me, and I will bury my dead there."],["14",[["ἀπεκρίθη",701492,37],["δὲ",703303,11],["Εφρων",705770,4],["τῷ",709436,113],["Αβρααμ",700091,114],["λέγων",708124,72]],"But Ephron answered Abraam, saying,"],["15",[["οὐχί",709862,28],["κύριε",707996,153],["ἀκήκοα",700587,89],["γῆ",703083,12],["τετρακοσίων",712817,83],["διδράχμων",703651,44],["ἀργυρίου",701707,21],["ἀνὰ",700902,0],["μέσον",708768,27],["ἐμοῦ",704580,133],["καὶ",707031,7],["σοῦ",711945,133],["τί",712867,273],["ἂν",700900,11],["εἴη",704093,301],["τοῦτο",709858,132],["σὺ",712181,164],["δὲ",703303,11],["τὸν",709436,5],["νεκρόν",709247,6],["σου",711945,133],["θάψον",706103,176]],"Nay, my lord, I have heard indeed, the land [is worth] four hundred silver didrachms, but what can this be between me and thee? nay, do thou bury thy dead."],["16",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Αβρααμ",700091,4],["τοῦ",709436,35],["Εφρων",705770,18],["καὶ",707031,7],["ἀπεκατέστησεν",701470,2],["Αβρααμ",700091,4],["τῷ",709436,113],["Εφρων",705770,114],["τὸ",709436,24],["ἀργύριον",701707,25],["ὃ",709781,128],["ἐλάλησεν",708071,2],["εἰς",704105,0],["τὰ",709436,41],["ὦτα",709852,42],["τῶν",709436,80],["υἱῶν",713075,81],["Χετ",713836,18],["τετρακόσια",712817,68],["δίδραχμα",703651,42],["ἀργυρίου",701707,21],["δοκίμου",703780,116],["ἐμπόροις",704614,148]],"And Abraam hearkened to Ephron, and Abraam rendered to Ephron the money, which he mentioned in the ears of the sons of Chet, four hundred didrachms of silver approved with merchants."],["17",[["καὶ",707031,7],["ἔστη",706846,2],["ὁ",709436,3],["ἀγρὸς",700196,4],["Εφρων",705770,18],["ὃς",709781,213],["ἦν",704093,13],["ἐν",704639,0],["τῷ",709436,53],["διπλῷ",703740,97],["σπηλαίῳ",712012,54],["ὅς",709781,213],["ἐστιν",704093,91],["κατὰ",707200,0],["πρόσωπον",710986,25],["Μαμβρη",708455,118],["ὁ",709436,3],["ἀγρὸς",700196,4],["καὶ",707031,7],["τὸ",709436,34],["σπήλαιον",712012,15],["ὃ",709781,33],["ἦν",704093,13],["ἐν",704639,0],["αὐτῷ",702165,50],["καὶ",707031,7],["πᾶν",710177,26],["δένδρον",703353,15],["ὃ",709781,33],["ἦν",704093,13],["ἐν",704639,0],["τῷ",709436,113],["ἀγρῷ",700196,114],["ὅ",709781,33],["ἐστιν",704093,91],["ἐν",704639,0],["τοῖς",709436,95],["ὁρίοις",709749,96],["αὐτοῦ",702165,102],["κύκλῳ",707959,114]],"And the field of Ephron, which was in Double Cave, which is opposite Mambre, the field and the cave, which was in it, and every tree which was in the field, and whatever is in its borders round about, were made sure"],["18",[["τῷ",709436,113],["Αβρααμ",700091,114],["εἰς",704105,0],["κτῆσιν",707937,9],["ἐναντίον",704654,0],["τῶν",709436,80],["υἱῶν",713075,81],["Χετ",713836,18],["καὶ",707031,7],["πάντων",710177,169],["τῶν",709436,80],["εἰσπορευομένων",704124,299],["εἰς",704105,0],["τὴν",709436,8],["πόλιν",710612,9]],"to Abraam for a possession, before the sons of Chet, and all that entered into the city."],["19",[["μετὰ",708780,0],["ταῦτα",709858,71],["ἔθαψεν",706103,2],["Αβρααμ",700091,4],["Σαρραν",711541,9],["τὴν",709436,8],["γυναῖκα",703209,9],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,53],["σπηλαίῳ",712012,54],["τοῦ",709436,35],["ἀγροῦ",700196,18],["τῷ",709436,53],["διπλῷ",703740,97],["ὅ",709781,33],["ἐστιν",704093,91],["ἀπέναντι",701389,0],["Μαμβρη",708455,120],["αὕτη",709858,107],["ἐστὶν",704093,91],["Χεβρων",713777,120],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["Χανααν",713708,184]],"After this Abraam buried Sarrha his wife in the Double Cave of the field, which is opposite Mambre, this is Chebron in the land of Chanaan."],["20",[["καὶ",707031,7],["ἐκυρώθη",707998,37],["ὁ",709436,3],["ἀγρὸς",700196,4],["καὶ",707031,7],["τὸ",709436,34],["σπήλαιον",712012,15],["ὃ",709781,33],["ἦν",704093,13],["ἐν",704639,0],["αὐτῷ",702165,50],["τῷ",709436,113],["Αβρααμ",700091,114],["εἰς",704105,0],["κτῆσιν",707937,9],["τάφου",712738,18],["παρὰ",709995,0],["τῶν",709436,80],["υἱῶν",713075,81],["Χετ",713836,18]],"So the field and the cave which was in it were made sure to Abraam for possession of a burying place, by the sons of Chet."]]