[["1",[["ἐγένετο",703104,23],["δὲ",703303,11],["μετὰ",708780,0],["τὰ",709436,41],["ῥήματα",711246,42],["ταῦτα",709858,71],["καὶ",707031,7],["ἀπηγγέλη",701321,37],["τῷ",709436,113],["Ιωσηφ",706948,114],["ὅτι",709803,7],["ὁ",709436,3],["πατήρ",710189,4],["σου",711945,133],["ἐνοχλεῖται",704780,117],["καὶ",707031,7],["ἀναλαβὼν",700984,182],["τοὺς",709436,58],["δύο",703849,59],["υἱοὺς",713075,57],["αὐτοῦ",702165,102],["τὸν",709436,5],["Μανασση",708470,6],["καὶ",707031,7],["τὸν",709436,5],["Εφραιμ",705769,6],["ἦλθεν",705453,2],["πρὸς",710844,0],["Ιακωβ",706401,6]],"And it came to pass after these things, that it was reported to Joseph, Behold, thy father is ill; and, having taken his two sons, Manasse and Ephraim, he came to Jacob."],["2",[["ἀπηγγέλη",701321,37],["δὲ",703303,11],["τῷ",709436,113],["Ιακωβ",706401,114],["λέγοντες",708124,146],["ἰδοὺ",706497,88],["ὁ",709436,3],["υἱός",713075,4],["σου",711945,133],["Ιωσηφ",706948,4],["ἔρχεται",705453,117],["πρὸς",710844,0],["σέ",711598,163],["καὶ",707031,7],["ἐνισχύσας",704750,182],["Ισραηλ",706839,4],["ἐκάθισεν",707006,2],["ἐπὶ",705080,0],["τὴν",709436,8],["κλίνην",707737,9]],"And it was reported to Jacob, saying, Behold, thy son Joseph cometh to thee; and Israel having strengthened himself, sat upon the bed."],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιακωβ",706401,4],["τῷ",709436,113],["Ιωσηφ",706948,114],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133],["ὤφθη",709725,37],["μοι",708974,159],["ἐν",704639,0],["Λουζα",708252,111],["ἐν",704639,0],["γῇ",703083,1],["Χανααν",713708,184],["καὶ",707031,7],["εὐλόγησέν",705631,2],["με",708618,163]],"And Jacob said to Joseph, My God appeared to me in Luza, in the land of Chanaan, and blessed me,"],["4",[["καὶ",707031,7],["εἶπέν",705373,2],["μοι",708974,159],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["αὐξανῶ",702144,165],["σε",711598,163],["καὶ",707031,7],["πληθυνῶ",710530,165],["σε",711598,163],["καὶ",707031,7],["ποιήσω",710582,165],["σε",711598,163],["εἰς",704105,0],["συναγωγὰς",712