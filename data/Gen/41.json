ν",702165,85],["ἐπὶ",705080,0],["τὸ",709436,24],["ἅρμα",701768,25],["τὸ",709436,24],["δεύτερον",703389,46],["τῶν",709436,80],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐκήρυξεν",707662,2],["ἔμπροσθεν",704618,0],["αὐτοῦ",702165,102],["κῆρυξ",707661,4],["καὶ",707031,7],["κατέστησεν",707011,2],["αὐτὸν",702165,85],["ἐφ᾿",705080,0],["ὅλης",709597,82],["γῆς",703083,17],["Αἰγύπτου",700401,17]],"And he mounted him on the second of his chariots, and a herald made proclamation before him; and he set him over all the land of Egypt."],["44",[["εἶπεν",705373,2],["δὲ",703303,11],["Φαραω",713360,4],["τῷ",709436,113],["Ιωσηφ",706948,114],["ἐγὼ",704018,164],["Φαραω",713360,4],["ἄνευ",701137,0],["σοῦ",711945,133],["οὐκ",709805,28],["ἐξαρεῖ",704839,127],["οὐθεὶς",709817,14],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["πάσῃ",710177,101],["γῇ",703083,1],["Αἰγύπτου",700401,17]],"And Pharao said to Joseph, I am Pharao; without thee no one shall lift up his hand on all the land of Egypt."],["45",[["καὶ",707031,7],["ἐκάλεσεν",707084,2],["Φαραω",713360,4],["τὸ",709436,24],["ὄνομα",709666,25],["Ιωσηφ",706948,18],["Ψονθομφανηχ",714062,6],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["τὴν",709436,8],["Ασεννεθ",701922,9],["θυγατέρα",706320,9],["Πετεφρη",710440,18],["ἱερέως",706614,18],["Ἡλίου",705974,18],["πόλεως",710612,17],["αὐτῷ",702165,50],["γυναῖκα",703209,9]],"And Pharao called the name of Joseph, Psonthomphanech; and he gave him Aseneth, the daughter of Petephres, priest of Heliopolis, to wife."],["46",[["Ιωσηφ",706948,4],["δὲ",703303,11],["ἦν",704093,13],["ἐτῶν",705543,44],["τριάκοντα",712934,59],["ὅτε",709802,28],["ἔστη",706846,2],["ἐναντίον",704654,0],["Φαραω",713360,18],["βασιλέως",702580,18],["Αἰγύπτου",700401,17],["ἐξῆλθεν",704909,2],["δὲ",703303,11],["Ιωσηφ",706948,4],["ἐκ",704132,0],["προσώπου",710986,21],["Φαραω",713360,18],["καὶ",707031,7],["διῆλθεν",703673,2],["πᾶσαν",710177,36],["γῆν",703083,9],["Αἰγύπτου",700401,17]],"And Joseph was thirty years old when he stood before Pharao, king of Egypt. And Joseph went out from the presence of Pharao, and went through all the land of Egypt."],["47",[["καὶ",707031,7],["ἐποίησεν",710582,2],["ἡ",709436,10],["γῆ",703083,12],["ἐν",704639,0],["τοῖς",709436,95],["ἑπτὰ",705357,59],["ἔτεσιν",705543,96],["τῆς",709436,16],["εὐθηνίας",705595,17],["δράγματα",703820,42]],"And the land produced, in the seven years of plenty, [whole] handfuls [of corn]."],["48",[["καὶ",707031,7],["συνήγαγεν",712375,2],["πάντα",710177,68],["τὰ",709436,41],["βρώματα",702823,42],["τῶν",709436,43],["ἑπτὰ",705357,59],["ἐτῶν",705543,44],["ἐν",704639,0],["οἷς",709781,295],["ἦν",704093,13],["ἡ",709436,10],["εὐθηνία",705595,12],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ἔθηκεν",712849,2],["τὰ",709436,41],["βρώματα",702823,42],["ἐν",704639,0],["ταῖς",709436,75],["πόλεσιν",710612,76],["βρώματα",702823,42],["τῶν",709436,43],["πεδίων",710215,44],["τῆς",709436,16],["πόλεως",710612,17],["τῶν",709436,43],["κύκλῳ",707959,114],["αὐτῆς",702165,86],["ἔθηκεν",712849,2],["ἐν",704639,0],["αὐτῇ",702165,105]],"And he gathered all the food of the seven years, in which was the plenty in the land of Egypt; and he laid up the food in the cities; the food of the fields of a city round about it he laid up in it."],["49",[["καὶ",707031,7],["συνήγαγεν",712375,2],["Ιωσηφ",706948,4],["σῖτον",711814,6],["ὡσεὶ",714159,28],["τὴν",709436,8],["ἄμμον",700845,9],["τῆς",709436,16],["θαλάσσης",706069,17],["πολὺν",710646,27],["σφόδρα",712586,28],["ἕως",705792,7],["οὐκ",709805,28],["ἠδύναντο",703838,139],["ἀριθμῆσαι",701742,106],["οὐ",709805,28],["γὰρ",702963,11],["ἦν",704093,13],["ἀριθμός",701744,4]],"And Joseph gathered very much corn as the sand of the sea, until it could not be numbered, for there was no number [of it]."],["50",[["τῷ",709436,113],["δὲ",703303,11],["Ιωσηφ",706948,114],["ἐγένοντο",703104,189],["υἱοὶ",713075,52],["δύο",703849,59],["πρὸ",710747,0],["τοῦ",709436,20],["ἐλθεῖν",705453,106],["