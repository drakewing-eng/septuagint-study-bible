[["1",[["ἐγένετο",703104,23],["δὲ",703303,11],["μετὰ",708780,0],["δύο",703849,59],["ἔτη",705543,42],["ἡμερῶν",705984,65],["Φαραω",713360,4],["εἶδεν",709725,2],["ἐνύπνιον",704818,25],["ᾤετο",709534,19],["ἑστάναι",706846,115],["ἐπὶ",705080,0],["τοῦ",709436,35],["ποταμοῦ",710693,18]],"And it came to pass after two full years that Pharao had a dream. He thought he stood upon [the bank of] the river."],["2",[["καὶ",707031,7],["ἰδοὺ",706497,88],["ὥσπερ",714163,28],["ἐκ",704132,0],["τοῦ",709436,35],["ποταμοῦ",710693,18],["ἀνέβαινον",700905,137],["ἑπτὰ",705357,59],["βόες",702798,52],["καλαὶ",707097,192],["τῷ",709436,53],["εἴδει",704074,54],["καὶ",707031,7],["ἐκλεκταὶ",704240,192],["ταῖς",709436,75],["σαρξὶν",711537,76],["καὶ",707031,7],["ἐβόσκοντο",702767,139],["ἐν",704639,0],["τῷ",709436,53],["ἄχει",702261,54]],"And lo, there came up as it were out of the river seven cows, fair in appearance, and choice of flesh, and they fed on the sedge."],["3",[["ἄλλαι",700697,202],["δὲ",703303,11],["ἑπτὰ",705357,59],["βόες",702798,191],["ἀνέβαινον",700905,137],["μετὰ",708780,0],["ταύτας",709858,231],["ἐκ",704132,0],["τοῦ",709436,35],["ποταμοῦ",710693,18],["αἰσχραὶ",700481,192],["τῷ",709436,53],["εἴδει",704074,54],["καὶ",707031,7],["λεπταὶ",708153,192],["ταῖς",709436,75],["σαρξὶν",711537,76],["καὶ",707031,7],["ἐνέμοντο",709253,139],["παρὰ",709995,0],["τὰς",709436,38],["βόας",702798,39],["παρὰ",709995,0],["τὸ",709436,24],["χεῖλος",713781,25],["τοῦ",709436,35],["ποταμοῦ",710693,18]],"And other seven cows came up after these out of the river, ill-favoured and lean-fleshed, and fed by the [other] cows on the bank of the river."],["4",[["καὶ",707031,7],["κατέφαγον",707519,150],["αἱ",709436,190],["ἑπτὰ",705357,59],["βόες",702798,191],["αἱ",709436,190],["αἰσχραὶ",700481,192],["καὶ",707031,7],["λεπταὶ",708153,192],["ταῖς",709436,75],["σαρξὶν",711537,76],["τὰς",709436,38],["ἑπτὰ",705357,59],["βόας",702798,39],["τὰς",709436,38],["καλὰς",707097,119],["τῷ",709436,53],["εἴδει",704074,54],["καὶ",707031,7],["τὰς",709436,38],["ἐκλεκτάς",704240,119],["ἠγέρθη",703949,37],["δὲ",703303,11],["Φαραω",713360,4]],"And the seven ill-favoured and lean cows devoured the seven well-favoured and choice-fleshed cows; and Pharao awoke."],["5",[["καὶ",707031,7],["ἐνυπνιάσθη",704815,37],["τὸ",709436,24],["δεύτερον",703389,46],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἑπτὰ",705357,59],["στάχυες",712053,52],["ἀνέβαινον",700905,137],["ἐν",704639,0],["πυθμένι",711079,114],["ἑνὶ",704106,30],["ἐκλεκτοὶ",704240,138],["καὶ",707031,7],["καλοί",707097,138]],"And he dreamed again. And, behold, seven ears came up on one stalk, choice and good."],["6",[["ἄλλοι",700697,201],["δὲ",703303,11],["ἑπτὰ",705357,59],["στάχυες",712053,52],["λεπτοὶ",708153,138],["καὶ",707031,7],["ἀνεμόφθοροι",701125,138],["ἀνεφύοντο",701088,139],["μετ᾿",708780,0],["αὐτούς",702165,62]],"And, behold, seven ears thin and blasted with the wind, grew up after them."],["7",[["καὶ",707031,7],["κατέπιον",707374,150],["οἱ",709436,136],["ἑπτὰ",705357,59],["στάχυες",712053,52],["οἱ",709436,136],["λεπτοὶ",708153,138],["καὶ",707031,7],["ἀνεμόφθοροι",701125,138],["τοὺς",709436,58],["ἑπτὰ",705357,59],["στάχυας",712053,57],["τοὺς",709436,58],["ἐκλεκτοὺς",704240,60],["καὶ",707031,7],["τοὺς",709436,58],["πλήρεις",710541,60],["ἠγέρθη",703949,37],["δὲ",703303,11],["Φαραω",713360,4],["καὶ",707031,7],["ἦν",704093,13],["ἐνύπνιον",704818,15]],"And the seven thin ears and blasted with the wind devoured the seven choice and full ears; and Pharao awoke, and it was a dream."],["8",[["ἐγένετο",703104,23],["δὲ",703303,11],["πρωὶ",711021,28],["καὶ",707031,7],["ἐταράχθη",712721,37],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀποστείλας",701592,182],["ἐκάλεσεν",707084,2],["πάντας",710177,60],["τοὺς",709436,58],["ἐξηγητὰς",704920,57],["Αἰγύπτου",700401,17],["καὶ",707031,7],["πάντας",710177,60],["τοὺς",709436,58],["σοφοὺς",711985,60],["αὐτῆς",702165,86],["καὶ",707031,7],["διηγήσατο",703679,23],["αὐτοῖς",702165,151],["Φαραω",713360,4],["τὸ",709436,24],["ἐνύπνιον",704818,25],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ὁ",709436,3],["ἀπαγγέλλων",701321,72],["αὐτὸ",702165,129],["τῷ",709436,113],["Φαραω",713360,114]],"And it was morning, and his soul was troubled; and he sent and called all the interpreters of Egypt, and all her wise men; and Pharao related to them his dream, and there was no one to interpret it to Pharao."],["9",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["ὁ",709436,3],["ἀρχιοινοχόος",701850,4],["πρὸς",710844,0],["Φαραω",713360,6],["λέγων",708124,72],["τὴν",709436,8],["ἁμαρτίαν",700775,9],["μου",709032,133],["ἀναμιμνῄσκω",701002,157],["σήμερον",711751,28]],"And the chief cupbearer spoke to Pharao, saying, I this day remember my fault:"],["10",[["Φαραω",713360,4],["ὠργίσθη",709729,37],["τοῖς",709436,147],["παισὶν",709932,148],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔθετο",712849,23],["ἡμᾶς",705981,194],["ἐν",704639,0],["φυλακῇ",713613,1],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["τοῦ",709436,35],["ἀρχιμαγείρου",701848,18],["ἐμέ",704555,163],["τε",712751,11],["καὶ",707031,7],["τὸν",709436,5],["ἀρχισιτοποιόν",701852,6]],"Pharao was angry with his servants, and put us in prison in the house of the captain of the guard, both me and the chief baker."],["11",[["καὶ",707031,7],["εἴδομεν",709725,289],["ἐνύπνιον",704818,25],["ἐν",704639,0],["νυκτὶ",709386,1],["μιᾷ",704106,101],["ἐγώ",704018,164],["τε",712751,11],["καὶ",707031,7],["αὐτός",702165,121],["ἕκαστος",704133,14],["κατὰ",707200,0],["τὸ",709436,24],["αὑτοῦ",703917,102],["ἐνύπνιον",704818,25],["εἴδομεν",709725,289]],"And we had a dream both in one night, I and he; we saw, each according to his dream."],["12",[["ἦν",704093,13],["δὲ",703303,11],["ἐκεῖ",704181,28],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["νεανίσκος",709232,4],["παῖς",709932,4],["Εβραῖος",703933,4],["τοῦ",709436,35],["ἀρχιμαγείρου",701848,18],["καὶ",707031,7],["διηγησάμεθα",703679,316],["αὐτῷ",702165,50],["καὶ",707031,7],["συνέκρινεν",712233,2],["ἡμῖν",705994,90]],"And there was there with us a young man, a Hebrew servant of the captain of the guard; and we related to him [our dreams], and he interpreted [them] to us."],["13",[["ἐγενήθη",703104,37],["δὲ",703303,11],["καθὼς",707030,28],["συνέκρινεν",712233,2],["ἡμῖν",705994,90],["οὕτως",709859,28],["καὶ",707031,7],["συνέβη",712277,2],["ἐμέ",704555,163],["τε",712751,11],["ἀποκατασταθῆναι",701470,179],["ἐπὶ",705080,0],["τὴν",709436,8],["ἀρχήν",701836,9],["μου",709032,133],["ἐκεῖνον",704183,85],["δὲ",703303,11],["κρεμασθῆναι",707892,179]],"And it came to pass, as he interpreted them to us, so also it happened, both that I was restored to my office, and that he was hanged."],["14",[["ἀποστείλας",701592,182],["δὲ",703303,11],["Φαραω",713360,4],["ἐκάλεσεν",707084,2],["τὸν",709436,5],["Ιωσηφ",706948,6],["καὶ",707031,7],["ἐξήγαγον",704834,150],["αὐτὸν",702165,85],["ἐκ",704132,0],["τοῦ",709436,20],["ὀχυρώματος",709891,21],["καὶ",707031,7],["ἐξύρησαν",709431,150],["αὐτὸν",702165,85],["καὶ",707031,7],["ἤλλαξαν",700683,150],["τὴν",709436,8],["στολὴν",712120,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἦλθεν",705453,2],["πρὸς",710844,0],["Φαραω",713360,6]],"And Pharao having sent, called Joseph; and they brought him out from the prison, and shaved him, and changed his dress, and he came to Pharao."],["15",[["εἶπεν",705373,2],["δὲ",703303,11],["Φαραω",713360,4],["τῷ",709436,113],["Ιωσηφ",706948,114],["ἐνύπνιον",704818,25],["ἑώρακα",709725,89],["καὶ",707031,7],["ὁ",709436,3],["συγκρίνων",712233,72],["οὐκ",709805,28],["ἔστιν",704093,91],["αὐτό",702165,129],["ἐγὼ",704018,164],["δὲ",703303,11],["ἀκήκοα",700587,89],["περὶ",710285,0],["σοῦ",711945,133],["λεγόντων",708124,170],["ἀκούσαντά",700587,365],["σε",711598,163],["ἐνύπνια",704818,42],["συγκρῖναι",712233,106],["αὐτά",702165,71]],"And Pharao said to Joseph, I have seen a vision, and there is no one to interpret it; but I have heard say concerning thee that thou didst hear dreams and interpret them."],["16",[["ἀποκριθεὶς",701492,217],["δὲ",703303,11],["Ιωσηφ",706948,4],["τῷ",709436,113],["Φαραω",713360,114],["εἶπεν",705373,2],["ἄνευ",701137,0],["τοῦ",709436,35],["θεοῦ",706192,18],["οὐκ",709805,28],["ἀποκριθήσεται",701492,134],["τὸ",709436,24],["σωτήριον",712659,25],["Φαραω",713360,114]],"And Joseph answered Pharao and said, Without God an answer of safety shall not be given to Pharao."],["17",[["ἐλάλησεν",708071,2],["δὲ",703303,11],["Φαραω",713360,4],["τῷ",709436,113],["Ιωσηφ",706948,114],["λέγων",708124,72],["ἐν",704639,0],["τῷ",709436,113],["ὕπνῳ",713181,114],["μου",709032,133],["ᾤμην",709534,334],["ἑστάναι",706846,115],["παρὰ",709995,0],["τὸ",709436,24],["χεῖλος",713781,25],["τοῦ",709436,35],["ποταμοῦ",710693,18]],"And Pharao spoke to Joseph, saying, In my dream methought I stood by the bank of the river;"],["18",[["καὶ",707031,7],["ὥσπερ",714163,28],["ἐκ",704132,0],["τοῦ",709436,35],["ποταμοῦ",710693,18],["ἀνέβαινον",700905,137],["ἑπτὰ",705357,59],["βόες",702798,191],["καλαὶ",707097,192],["τῷ",709436,53],["εἴδει",704074,54],["καὶ",707031,7],["ἐκλεκταὶ",704240,192],["ταῖς",709436,75],["σαρξὶν",711537,76],["καὶ",707031,7],["ἐνέμοντο",709253,139],["ἐν",704639,0],["τῷ",709436,53],["ἄχει",702261,54]],"and there came up as it were out of the river, seven cows well-favoured and choice-fleshed, and they fed on the sedge."],["19",[["καὶ",707031,7],["ἰδοὺ",706497,88],["ἑπτὰ",705357,59],["βόες",702798,191],["ἕτεραι",705535,192],["ἀνέβαινον",700905,137],["ὀπίσω",709697,0],["αὐτῶν",702165,40],["ἐκ",704132,0],["τοῦ",709436,35],["ποταμοῦ",710693,18],["πονηραὶ",710660,192],["καὶ",707031,7],["αἰσχραὶ",700481,192],["τῷ",709436,53],["εἴδει",704074,54],["καὶ",707031,7],["λεπταὶ",708153,192],["ταῖς",709436,75],["σαρξίν",711537,76],["οἵας",709535,119],["οὐκ",709805,28],["εἶδον",709725,155],["τοιαύτας",712878,119],["ἐν",704639,0],["ὅλῃ",709597,101],["γῇ",703083,1],["Αἰγύπτῳ",700401,1],["αἰσχροτέρας",700481,366]],"And behold seven other cows came up after them out of the river, evil and ill-favoured and lean-fleshed, such that I never saw worse in all the land of Egypt."],["20",[["καὶ",707031,7],["κατέφαγον",707519,150],["αἱ",709436,190],["ἑπτὰ",705357,59],["βόες",702798,191],["αἱ",709436,190],["αἰσχραὶ",700481,192],["καὶ",707031,7],["λεπταὶ",708153,192],["τὰς",709436,38],["ἑπτὰ",705357,59],["βόας",702798,39],["τὰς",709436,38],["πρώτας",711041,367],["τὰς",709436,38],["καλὰς",707097,119],["καὶ",707031,7],["ἐκλεκτάς",704240,119]],"And the seven ill-favoured and thin cows ate up the seven first good and choice cows."],["21",[["καὶ",707031,7],["εἰσῆλθον",704114,150],["εἰς",704105,0],["τὰς",709436,38],["κοιλίας",707761,39],["αὐτῶν",702165,284],["καὶ",707031,7],["οὐ",709805,28],["διάδηλοι",703446,52],["ἐγένοντο",703104,189],["ὅτι",709803,7],["εἰσῆλθον",704114,150],["εἰς",704105,0],["τὰς",709436,38],["κοιλίας",707761,39],["αὐτῶν",702165,40],["καὶ",707031,7],["αἱ",709436,190],["ὄψεις",709901,191],["αὐτῶν",702165,40],["αἰσχραὶ",700481,192],["καθὰ",706979,28],["καὶ",707031,7],["τὴν",709436,8],["ἀρχήν",701836,9],["ἐξεγερθεὶς",704889,217],["δὲ",703303,11],["ἐκοιμήθην",707767,156]],"And they went into their bellies; and it was not perceptible that they had gone into their bellies, and their appearance was ill-favoured, as also at the beginning; and after I awoke I slept,"],["22",[["καὶ",707031,7],["εἶδον",704075,155],["πάλιν",709942,28],["ἐν",704639,0],["τῷ",709436,113],["ὕπνῳ",713181,114],["μου",709032,133],["καὶ",707031,7],["ὥσπερ",714163,28],["ἑπτὰ",705357,59],["στάχυες",712053,52],["ἀνέβαινον",700905,137],["ἐν",704639,0],["πυθμένι",711079,114],["ἑνὶ",704106,30],["πλήρεις",710541,138],["καὶ",707031,7],["καλοί",707097,138]],"and saw again in my sleep, and as it were seven ears came up on one stem, full and good."],["23",[["ἄλλοι",700697,201],["δὲ",703303,11],["ἑπτὰ",705357,59],["στάχυες",712053,52],["λεπτοὶ",708153,138],["καὶ",707031,7],["ἀνεμόφθοροι",701125,138],["ἀνεφύοντο",701088,139],["ἐχόμενοι",705785,348],["αὐτῶν",702165,40]],"And other seven ears, thin and blasted with the wind, sprang up close to them."],["24",[["καὶ",707031,7],["κατέπιον",707374,150],["οἱ",709436,136],["ἑπτὰ",705357,59],["στάχυες",712053,52],["οἱ",709436,136],["λεπτοὶ",708153,138],["καὶ",707031,7],["ἀνεμόφθοροι",701125,138],["τοὺς",709436,58],["ἑπτὰ",705357,59],["στάχυας",712053,57],["τοὺς",709436,58],["καλοὺς",707097,60],["καὶ",707031,7],["τοὺς",709436,58],["πλήρεις",710541,60],["εἶπα",705373,155],["οὖν",709835,11],["τοῖς",709436,147],["ἐξηγηταῖς",704920,148],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ὁ",709436,3],["ἀπαγγέλλων",701321,72],["μοι",708974,159]],"And the seven thin and blasted ears devoured the seven fine and full ears: so I spoke to the interpreters, and there was no one to explain it to me."],["25",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιωσηφ",706948,4],["τῷ",709436,113],["Φαραω",713360,114],["τὸ",709436,34],["ἐνύπνιον",704818,15],["Φαραω",713360,18],["ἕν",704106,26],["ἐστιν",704093,91],["ὅσα",709788,68],["ὁ",709436,3],["θεὸς",706192,4],["ποιεῖ",710582,91],["ἔδειξεν",703314,2],["τῷ",709436,113],["Φαραω",713360,114]],"And Joseph said to Pharao, The dream of Pharao is one; whatever God does, he has shewn to Pharao."],["26",[["αἱ",709436,190],["ἑπτὰ",705357,59],["βόες",702798,191],["αἱ",709436,190],["καλαὶ",707097,192],["ἑπτὰ",705357,59],["ἔτη",705543,64],["ἐστίν",704093,91],["καὶ",707031,7],["οἱ",709436,136],["ἑπτὰ",705357,59],["στάχυες",712053,52],["οἱ",709436,136],["καλοὶ",707097,138],["ἑπτὰ",705357,59],["ἔτη",705543,64],["ἐστίν",704093,91],["τὸ",709436,34],["ἐνύπνιον",704818,15],["Φαραω",713360,18],["ἕν",704106,46],["ἐστιν",704093,91]],"The seven good cows are seven years, and the seven good ears are seven years; the dream of Pharao is one."],["27",[["καὶ",707031,7],["αἱ",709436,190],["ἑπτὰ",705357,59],["βόες",702798,191],["αἱ",709436,190],["λεπταὶ",708153,192],["αἱ",709436,190],["ἀναβαίνουσαι",700905,306],["ὀπίσω",709697,0],["αὐτῶν",702165,284],["ἑπτὰ",705357,59],["ἔτη",705543,64],["ἐστίν",704093,91],["καὶ",707031,7],["οἱ",709436,136],["ἑπτὰ",705357,59],["στάχυες",712053,52],["οἱ",709436,136],["λεπτοὶ",708153,138],["καὶ",707031,7],["ἀνεμόφθοροι",701125,138],["ἔσονται",704093,135],["ἑπτὰ",705357,59],["ἔτη",705543,64],["λιμοῦ",708210,18]],"And the seven thin kine that came up after them are seven years; and the seven thin and blasted ears are seven years; there shall be seven years of famine."],["28",[["τὸ",709436,24],["δὲ",703303,11],["ῥῆμα",711246,25],["ὃ",709781,128],["εἴρηκα",705415,89],["Φαραω",713360,114],["ὅσα",709788,68],["ὁ",709436,3],["θεὸς",706192,4],["ποιεῖ",710582,91],["ἔδειξεν",703314,2],["τῷ",709436,113],["Φαραω",713360,114]],"And as for the word which I have told Pharao, whatsoever God intends to do, he has shewn to Pharao:"],["29",[["ἰδοὺ",706497,88],["ἑπτὰ",705357,59],["ἔτη",705543,42],["ἔρχεται",705453,117],["εὐθηνία",705595,12],["πολλὴ",710646,29],["ἐν",704639,0],["πάσῃ",710177,101],["γῇ",703083,1],["Αἰγύπτῳ",700401,1]],"behold, for seven years there is coming great plenty in all the land of Egypt."],["30",[["ἥξει",705956,127],["δὲ",703303,11],["ἑπτὰ",705357,59],["ἔτη",705543,64],["λιμοῦ",708210,18],["μετὰ",708780,0],["ταῦτα",709858,71],["καὶ",707031,7],["ἐπιλήσονται",705187,135],["τῆς",709436,16],["πλησμονῆς",710549,17],["ἐν",704639,0],["ὅλῃ",709597,101],["γῇ",703083,1],["Αἰγύπτῳ",700401,1],["καὶ",707031,7],["ἀναλώσει",700992,127],["ὁ",709436,3],["λιμὸς",708210,4],["τὴν",709436,8],["γῆν",703083,9]],"But there shall come seven years of famine after these, and they shall forget the plenty that shall be in all Egypt, and the famine shall consume the land."],["31",[["καὶ",707031,7],["οὐκ",709805,28],["ἐπιγνωσθήσεται",705104,134],["ἡ",709436,10],["εὐθηνία",705595,12],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ἀπὸ",701425,0],["τοῦ",709436,35],["λιμοῦ",708210,18],["τοῦ",709436,35],["ἐσομένου",704093,368],["μετὰ",708780,0],["ταῦτα",709858,71],["ἰσχυρὸς",706855,14],["γὰρ",702963,11],["ἔσται",704093,93],["σφόδρα",712586,28]],"And the plenty shall not be known in the land by reason of the famine that shall be after this, for it shall be very grievous."],["32",[["περὶ",710285,0],["δὲ",703303,11],["τοῦ",709436,20],["δευτερῶσαι",703390,106],["τὸ",709436,24],["ἐνύπνιον",704818,25],["Φαραω",713360,6],["δίς",703741,28],["ὅτι",709803,7],["ἀληθὲς",700658,26],["ἔσται",704093,93],["τὸ",709436,34],["ῥῆμα",711246,15],["τὸ",709436,34],["παρὰ",709995,0],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["ταχυνεῖ",712749,127],["ὁ",709436,3],["θεὸς",706192,4],["τοῦ",709436,20],["ποιῆσαι",710582,106],["αὐτό",702165,129]],"And concerning the repetition of the dream to Pharao twice, [it is] because the saying which is from God shall be true, and God will hasten to accomplish it."],["33",[["νῦν",709384,28],["οὖν",709835,11],["σκέψαι",711840,300],["ἄνθρωπον",701163,6],["φρόνιμον",713589,27],["καὶ",707031,7],["συνετὸν",712464,27],["καὶ",707031,7],["κατάστησον",707011,176],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["γῆς",703083,17],["Αἰγύπτου",700401,17]],"Now then, look out a wise and prudent man, and set him over the land of Egypt."],["34",[["καὶ",707031,7],["ποιησάτω",710582,45],["Φαραω",713360,4],["καὶ",707031,7],["καταστησάτω",707011,45],["τοπάρχας",712901,57],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἀποπεμπτωσάτωσαν",701543,264],["πάντα",710177,68],["τὰ",709436,41],["γενήματα",703052,42],["τῆς",709436,16],["γῆς",703083,17],["Αἰγύπτου",700401,17],["τῶν",709436,43],["ἑπτὰ",705357,59],["ἐτῶν",705543,44],["τῆς",709436,16],["εὐθηνίας",705595,17]],"And let Pharao make and appoint local governors over the land; and let them take up a fifth part of all the produce of the land of Egypt for the seven years of the plenty."],["35",[["καὶ",707031,7],["συναγαγέτωσαν",712375,264],["πάντα",710177,68],["τὰ",709436,41],["βρώματα",702823,42],["τῶν",709436,43],["ἑπτὰ",705357,59],["ἐτῶν",705543,44],["τῶν",709436,43],["ἐρχομένων",705453,369],["τῶν",709436,43],["καλῶν",707097,83],["τούτων",709858,70],["καὶ",707031,7],["συναχθήτω",712375,22],["ὁ",709436,3],["σῖτος",711814,4],["ὑπὸ",713184,0],["χεῖρα",713787,9],["Φαραω",713360,18],["βρώματα",702823,42],["ἐν",704639,0],["ταῖς",709436,75],["πόλεσιν",710612,76],["φυλαχθήτω",713619,22]],"And let them gather all the food of these seven good years that are coming, and let the corn be gathered under the hand of Pharao; let food be kept in the cities."],["36",[["καὶ",707031,7],["ἔσται",704093,93],["τὰ",709436,63],["βρώματα",702823,64],["πεφυλαγμένα",713619,370],["τῇ",709436,100],["γῇ",703083,1],["εἰς",704105,0],["τὰ",709436,41],["ἑπτὰ",705357,59],["ἔτη",705543,42],["τοῦ",709436,35],["λιμοῦ",708210,18],["ἃ",709781,371],["ἔσονται",704093,135],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτῳ",700401,1],["καὶ",707031,7],["οὐκ",709805,28],["ἐκτριβήσεται",704345,134],["ἡ",709436,10],["γῆ",703083,12],["ἐν",704639,0],["τῷ",709436,113],["λιμῷ",708210,114]],"And the stored food shall be for the land against the seven years of famine, which shall be in the land of Egypt; and the land shall not be utterly destroyed by the famine."],["37",[["ἤρεσεν",701722,2],["δὲ",703303,11],["τὰ",709436,63],["ῥήματα",711246,64],["ἐναντίον",704654,0],["Φαραω",713360,18],["καὶ",707031,7],["ἐναντίον",704654,0],["πάντων",710177,169],["τῶν",709436,80],["παίδων",709932,81],["αὐτοῦ",702165,102]],"And the word was pleasing in the sight of Pharao, and in the sight of all his servants."],["38",[["καὶ",707031,7],["εἶπεν",705373,2],["Φαραω",713360,4],["πᾶσιν",710177,230],["τοῖς",709436,147],["παισὶν",709932,148],["αὐτοῦ",702165,102],["μὴ",708851,28],["εὑρήσομεν",705676,275],["ἄνθρωπον",701163,6],["τοιοῦτον",712878,27],["ὃς",709781,213],["ἔχει",705785,91],["πνεῦμα",710566,25],["θεοῦ",706192,18],["ἐν",704639,0],["αὐτῷ",702165,50]],"And Pharao said to all his servants, Shall we find such a man as this, who has the Spirit of God in him?"],["39",[["εἶπεν",705373,2],["δὲ",703303,11],["Φαραω",713360,4],["τῷ",709436,113],["Ιωσηφ",706948,114],["ἐπειδὴ",705056,7],["ἔδειξεν",703314,2],["ὁ",709436,3],["θεός",706192,4],["σοι",71