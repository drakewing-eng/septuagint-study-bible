[["1",[["ἐγένετο",703104,23],["δὲ",703303,11],["ἐν",704639,0],["τῇ",709436,100],["βασιλείᾳ",702577,1],["τῇ",709436,100],["Αμαρφαλ",700777,18],["βασιλέως",702580,18],["Σεννααρ",711691,118],["Αριωχ",701760,4],["βασιλεὺς",702580,4],["Ελλασαρ",704513,118],["καὶ",707031,7],["Χοδολλογομορ",713891,4],["βασιλεὺς",702580,4],["Αιλαμ",700430,118],["καὶ",707031,7],["Θαργαλ",706112,4],["βασιλεὺς",702580,4],["ἐθνῶν",704068,44]],"And it came to pass in the reign of Amarphal king of Sennaar, and Arioch king of Ellasar, that Chodollogomor king of Elam, and Thargal king of nations,"],["2",[["ἐποίησαν",710582,150],["πόλεμον",710605,6],["μετὰ",708780,0],["Βαλλα",702485,18],["βασιλέως",702580,18],["Σοδομων",711920,118],["καὶ",707031,7],["μετὰ",708780,0],["Βαρσα",702545,18],["βασιλέως",702580,18],["Γομορρας",703165,118],["καὶ",707031,7],["Σεννααρ",711691,118],["βασιλέως",702580,18],["Αδαμα",700223,118],["καὶ",707031,7],["Συμοβορ",712313,18],["βασιλέως",702580,18],["Σεβωιμ",711612,228],["καὶ",707031,7],["βασιλέως",702580,18],["Βαλακ",702474,118],["αὕτη",709858,107],["ἐστὶν",704093,91],["Σηγωρ",711731,120]],"made war with Balla king of Sodom, and with Barsa king of Gomorrha, and with Sennaar, king of Adama, and with Symobor king of Seboim and the king of Balac, this is Segor."],["3",[["πάντες",710177,138],["οὗτοι",709858,201],["συνεφώνησαν",712366,150],["ἐπὶ",705080,0],["τὴν",709436,8],["φάραγγα",713351,9],["τὴν",709436,8],["ἁλυκήν",700732,36],["αὕτη",709858,107],["ἡ",709436,10],["θάλασσα",706069,12],["τῶν",709436,80],["ἁλῶν",700728,81]],"All these met with one consent at the salt valley; this is [now] the sea of salt."],["4",[["δώδεκα",703887,59],["ἔτη",705543,42],["ἐδούλευον",703814,137],["τῷ",709436,113],["Χοδολλογομορ",713891,114],["τῷ",709436,53],["δὲ",703303,11],["τρισκαιδεκάτῳ",712957,97],["ἔτει",705543,54],["ἀπέστησαν",702214,150]],"Twelve years they served Chodollogomor, and the thirteenth year they revolted."],["5",[["ἐν",704639,0],["δὲ",703303,11],["τῷ",709436,53],["τεσσαρεσκαιδ