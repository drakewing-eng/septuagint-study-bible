],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐνέφραξαν",704635,150],["αὐτὰ",702165,71],["οἱ",709436,136],["Φυλιστιιμ",713621,52],["μετὰ",708780,0],["τὸ",709436,24],["ἀποθανεῖν",701461,106],["Αβρααμ",700091,6],["τὸν",709436,5],["πατέρα",710189,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπωνόμασεν",705348,2],["αὐτοῖς",702165,151],["ὀνόματα",709666,42],["κατὰ",707200,0],["τὰ",709436,41],["ὀνόματα",709666,42],["ἃ",709781,69],["ἐπωνόμασεν",705348,2],["Αβρααμ",700091,4],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτοῦ",702165,102]],"And Isaac dug again the wells of water, which the servants of his father Abraam had dug, and the Phylistines had stopped them, after the death of his father Abraam; and he gave them names, according to the names by which his father named them."],["19",[["καὶ",707031,7],["ὤρυξαν",709775,150],["οἱ",709436,136],["παῖδες",709932,52],["Ισαακ",706799,18],["ἐν",704639,0],["τῇ",709436,100],["φάραγγι",713351,1],["Γεραρων",703060,286],["καὶ",707031,7],["εὗρον",705676,150],["ἐκεῖ",704181,28],["φρέαρ",713576,25],["ὕδατος",713071,21],["ζῶντος",705851,294]],"And the servants of Isaac dug in the valley of Gerara, and they found there a well of living water."],["20",[["καὶ",707031,7],["ἐμαχέσαντο",708610,189],["οἱ",709436,136],["ποιμένες",710596,52],["Γεραρων",703060,286],["μετὰ",708780,0],["τῶν",709436,80],["ποιμένων",710596,81],["Ισαακ",706799,18],["φάσκοντες",713384,146],["αὐτῶν",702165,40],["εἶναι",704093,55],["τὸ",709436,24],["ὕδωρ",713071,25],["καὶ",707031,7],["ἐκάλεσεν",707084,2],["τὸ",709436,24],["ὄνομα",709666,25],["τοῦ",709436,20],["φρέατος",713576,21],["Ἀδικία",700271,12],["ἠδίκησαν",700269,150],["γὰρ",702963,11],["αὐτόν",702165,85]],"And the shepherds of Gerara strove with the shepherds of Isaac, saying that the water was theirs; and they called the name of the well, Injury, for they injured him."],["21",[["ἀπάρας",701329,182],["δὲ",703303,11],["Ισαακ",706799,4],["ἐκεῖθεν",704182,28],["ὤρυξεν",709775,2],["φρέαρ",713576,25],["ἕτερον",705535,46],["ἐκρίνοντο",707905,139],["δὲ",703303,11],["καὶ",707031,7],["περὶ",710285,0],["ἐκείνου",704183,102],["καὶ",707031,7],["ἐπωνόμασεν",705348,2],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["Ἐχθρία",705778,12]],"And having departed thence he dug another well, and they strove also for that; and he named the name of it, Enmity."],["22",[["ἀπάρας",701329,182],["δὲ",703303,11],["ἐκεῖθεν",704182,28],["ὤρυξεν",709775,2],["φρέαρ",713576,25],["ἕτερον",705535,46],["καὶ",707031,7],["οὐκ",709805,28],["ἐμαχέσαντο",708610,189],["περὶ",710285,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπωνόμασεν",705348,2],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["Εὐρυχωρία",705680,12],["λέγων",708124,72],["διότι",703734,7],["νῦν",709384,28],["ἐπλάτυνεν",710508,13],["κύριος",707996,4],["ἡμῖν",705994,90],["καὶ",707031,7],["ηὔξησεν",702144,2],["ἡμᾶς",705981,194],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"And he departed thence and dug another well; and they did not strive about that; and he named the name of it, Room, saying, Because now the Lord has made room for us, and has increased us upon the earth."],["23",[["ἀνέβη",700905,2],["δὲ",703303,11],["ἐκεῖθεν",704182,28],["ἐπὶ",705080,0],["τὸ",709436,24],["φρέαρ",713576,25],["τοῦ",709436,35],["ὅρκου",709753,18]],"And he went up thence to the well of the oath."],["24",[["καὶ",707031,7],["ὤφθη",709725,37],["αὐτῷ",702165,50],["κύριος",707996,4],["ἐν",704639,0],["τῇ",709436,100],["νυκτὶ",709386,1],["ἐκείνῃ",704183,105],["καὶ",707031,7],["εἶπεν",705373,2],["ἐγώ",704018,164],["εἰμι",704093,157],["ὁ",709436,3],["θεὸς",706192,4],["Αβρααμ",700091,18],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["μὴ",708851,28],["φοβοῦ",713532,253],["μετὰ",708780,0],["σοῦ",711945,133],["γάρ",702963,11],["εἰμι",704093,157],["καὶ",707031,7],["ηὐλόγηκά",705631,89],["σε",711598,163],["καὶ",707031,7],["πληθυνῶ",710530,165],["τὸ",709436,24],["σπέρμα",712008,25],["σου",711945,133],["διὰ",703417,0],["Αβρααμ",700091,6],["τὸν",709436,5],["πατέρα",710189,6],["σου",711945,133]],"And the Lord appeared to him in that night, and said, I am the God of Abraam thy father; fear not, for I am with thee, and I will bless thee, and multiply thy seed for the sake of Abraam thy father."],["25",[["καὶ",707031,7],["ᾠκοδόμησεν",709509,2],["ἐκεῖ",704181,28],["θυσιαστήριον",706348,25],["καὶ",707031,7],["ἐπεκαλέσατο",705153,23],["τὸ",709436,24],["ὄνομα",709666,25],["κυρίου",707996,18],["καὶ",707031,7],["ἔπηξεν",710452,2],["ἐκεῖ",704181,28],["τὴν",709436,8],["σκηνὴν",711845,9],["αὐτοῦ",702165,102],["ὤρυξαν",709775,150],["δὲ",703303,11],["ἐκεῖ",704181,28],["οἱ",709436,136],["παῖδες",709932,52],["Ισαακ",706799,18],["φρέαρ",713576,25]],"And he built there an altar, and called on the name of the Lord, and there he pitched his tent, and there the servants of Isaac dug a well in the valley of Gerara."],["26",[["καὶ",707031,7],["Αβιμελεχ",700068,4],["ἐπορεύθη",710667,37],["πρὸς",710844,0],["αὐτὸν",702165,85],["ἀπὸ",701425,0],["Γεραρων",703060,286],["καὶ",707031,7],["Οχοζαθ",709885,4],["ὁ",709436,3],["νυμφαγωγὸς",709379,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["Φικολ",713456,4],["ὁ",709436,3],["ἀρχιστράτηγος",701853,4],["τῆς",709436,16],["δυνάμεως",703839,17],["αὐτοῦ",702165,102]],"And Abimelech came to him from Gerara, and so did Ochozath his friend, and Phichol the commander-in-chief of his army."],["27",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["Ισαακ",706799,4],["ἵνα",706747,7],["τί",712867,126],["ἤλθατε",705453,265],["πρός",710844,0],["με",708618,163],["ὑμεῖς",713081,219],["δὲ",703303,11],["ἐμισήσατέ",708935,265],["με",708618,163],["καὶ",707031,7],["ἀπεστείλατέ",701592,265],["με",708618,163],["ἀφ᾿",701425,0],["ὑμῶν",713091,145]],"And Isaac said to them, Wherefore have ye come to me? whereas ye hated me, and sent me away from you."],["28",[["καὶ",707031,7],["εἶπαν",705373,150],["ἰδόντες",704075,196],["ἑωράκαμεν",709725,314],["ὅτι",709803,7],["ἦν",704093,13],["κύριος",707996,4],["μετὰ",708780,0],["σοῦ",711945,133],["καὶ",707031,7],["εἴπαμεν",705373,289],["γενέσθω",703104,315],["ἀρὰ",701665,12],["ἀνὰ",700902,0],["μέσον",708768,27],["ἡμῶν",705999,145],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,27],["σοῦ",711945,133],["καὶ",707031,7],["διαθησόμεθα",703609,141],["μετὰ",708780,0],["σοῦ",711945,133],["διαθήκην",703456,9]],"And they said, We have surely seen that the Lord was with thee, and we said, Let there be an oath between us and thee, and we will make a covenant with thee,"],["29",[["μὴ",708851,28],["ποιήσειν",710582,296],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["κακόν",707066,46],["καθότι",707021,28],["ἡμεῖς",705983,219],["σε",711598,163],["οὐκ",709805,28],["ἐβδελυξάμεθα",702608,316],["καὶ",707031,7],["ὃν",709781,112],["τρόπον",712980,6],["ἐχρησάμεθά",713937,316],["σοι",711925,159],["καλῶς",707106,28],["καὶ",707031,7],["ἐξαπεστείλαμέν",704872,289],["σε",711598,163],["μετ᾿",708780,0],["εἰρήνης",704098,17],["καὶ",707031,7],["νῦν",709384,28],["σὺ",712181,164],["εὐλογητὸς",705632,14],["ὑπὸ",713184,0],["κυρίου",707996,18]],"that thou shalt do no wrong by us, as we have not abhorred thee, and according as we have treated thee well, and have sent thee forth peaceably; and now thou art blessed of the Lord."],["30",[["καὶ",707031,7],["ἐποίησεν",710582,2],["αὐτοῖς",702165,151],["δοχήν",703819,9],["καὶ",707031,7],["ἔφαγον",705495,150],["καὶ",707031,7],["ἔπιον",710478,150]],"And he made a feast for them, and they ate and drank."],["31",[["καὶ",707031,7],["ἀναστάντες",701173,196],["τὸ",709436,24],["πρωὶ",711021,28],["ὤμοσαν",709620,150],["ἄνθρωπος",701163,4],["τῷ",709436,113],["πλησίον",710547,28],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐξαπέστειλεν",704872,2],["αὐτοὺς",702165,62],["Ισαακ",706799,4],["καὶ",707031,7],["ἀπῴχοντο",701466,139],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["μετὰ",708780,0],["σωτηρίας",712658,17]],"And they arose in the morning, and swore each to his neighbour; and Isaac sent them forth, and they departed from him in safety."],["32",[["ἐγένετο",703104,23],["δὲ",703303,11],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["καὶ",707031,7],["παραγενόμενοι",710006,317],["οἱ",709436,136],["παῖδες",709932,52],["Ισαακ",706799,18],["ἀπήγγειλαν",701321,150],["αὐτῷ",702165,50],["περὶ",710285,0],["τοῦ",709436,20],["φρέατος",713576,21],["οὗ",709806,160],["ὤρυξαν",709775,150],["καὶ",707031,7],["εἶπαν",705373,150],["οὐχ",709805,28],["εὕρομεν",705676,289],["ὕδωρ",713071,25]],"And it came to pass in that day, that the servants of Isaac came and told him of the well which they had dug; and they said, We have not found water."],["33",[["καὶ",707031,7],["ἐκάλεσεν",707084,2],["αὐτὸ",702165,129],["Ὅρκος",709753,4],["διὰ",703417,0],["τοῦτο",709858,129],["ὄνομα",709666,25],["τῇ",709436,100],["πόλει",710612,1],["Φρέαρ",713576,15],["ὅρκου",709753,18],["ἕως",705792,0],["τῆς",709436,16],["σήμερον",711751,28],["ἡμέρας",705984,17]],"And he called it, Oath: therefore he called the name of that city, the Well of Oath, until this day."],["34",[["ἦν",704093,13],["δὲ",703303,11],["Ησαυ",706030,4],["ἐτῶν",705543,44],["τεσσαράκοντα",712806,59],["καὶ",707031,7],["ἔλαβεν",708076,2],["γυναῖκα",703209,9],["Ιουδιν",706778,9],["τὴν",709436,8],["θυγατέρα",706320,9],["Βεηρ",702630,18],["τοῦ",709436,35],["Χετταίου",713838,18],["καὶ",707031,7],["τὴν",709436,8],["Βασεμμαθ",702572,9],["θυγατέρα",706320,9],["Αιλων",700441,18],["τοῦ",709436,35],["Ευαίου",705549,18]],"And Esau was forty years old; and he took to wife Judith the daughter of Beoch the Chettite, and Basemath, daughter of Helon the Chettite."],["35",[["καὶ",707031,7],["ἦσαν",704093,137],["ἐρίζουσαι",705423,306],["τῷ",709436,113],["Ισαακ",706799,114],["καὶ",707031,7],["τῇ",709436,100],["Ρεβεκκα",711213,1]],"And they were provoking to Isaac and Rebecca."]]