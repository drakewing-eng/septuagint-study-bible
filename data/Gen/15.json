[["1",[["μετὰ",708780,0],["δὲ",703303,11],["τὰ",709436,41],["ῥήματα",711246,42],["ταῦτα",709858,71],["ἐγενήθη",703104,37],["ῥῆμα",711246,15],["κυρίου",707996,18],["πρὸς",710844,0],["Αβραμ",700093,6],["ἐν",704639,0],["ὁράματι",709720,54],["λέγων",708124,72],["μὴ",708851,28],["φοβοῦ",713532,253],["Αβραμ",700093,153],["ἐγὼ",704018,164],["ὑπερασπίζω",713121,157],["σου",711945,133],["ὁ",709436,3],["μισθός",708939,4],["σου",711945,133],["πολὺς",710646,14],["ἔσται",704093,93],["σφόδρα",712586,28]],"And after these things the word of the Lord came to Abram in a vision, saying, Fear not, Abram, I shield thee, thy reward shall be very great."],["2",[["λέγει",708124,91],["δὲ",703303,11],["Αβραμ",700093,4],["δέσποτα",703379,153],["τί",712867,126],["μοι",708974,159],["δώσεις",703654,166],["ἐγὼ",704018,164],["δὲ",703303,11],["ἀπολύομαι",701524,254],["ἄτεκνος",702080,14],["ὁ",709436,3],["δὲ",703303,11],["υἱὸς",713075,4],["Μασεκ",708542,17],["τῆς",709436,16],["οἰκογενοῦς",709508,82],["μου",709032,133],["οὗτος",709858,121],["Δαμασκὸς",703275,120],["Ελιεζερ",704468,4]],"And Abram said, Master [and] Lord, what wilt thou give me? whereas I am departing without a child, but the son of Masek my home-born female slave, this Eliezer of Damascus [is mine heir]."],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["Αβραμ",700093,4],["ἐπειδὴ",705056,7],["ἐμοὶ",704577,159],["οὐκ",709805,28],["ἔδωκας",703654,162],["σπέρμα",712008,25],["ὁ",709436,3],["δὲ",703303,11],["οἰκογενής",709508,14],["μου",709032,133],["κληρονομήσει",707724,127],["με",708618,163]],"And Abram said, [I am grieved] since thou hast given me no seed, but my home-born [servant] shall succeed me."],["4",[["καὶ",707031,7],["εὐθὺς",705602,28],["φωνὴ",713640,12],["κυρίου",707996,18],["ἐγένετο",703104,23],["πρὸς",710844,0],["αὐτὸν",702165,85],["λέγων",708124,72],["οὐ",709805,28],["κληρονομήσει",707724,127],["σε",711598,163],["οὗτος",709858,121],["ἀλλ᾿",700680,7],["ὃς",709781,213],["ἐξελεύσεται",704909,93],["ἐκ",704132,0],["σοῦ",711945,133],["οὗτος",709858,121],["κληρονομήσει",707724,127],["σε",711598,163]],"And immediately there was a voice of the Lord to him, saying, This shall not be thine heir; but he that shall come out of thee shall be thine heir."],["5",[["ἐξήγαγεν",704834,2],["δὲ",703303,11],["αὐτὸν",702165,85],["ἔξω",704983,28],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["ἀνάβλεψον",700913,176],["δὴ",703395,11],["εἰς",704105,0],["τὸν",709436,5],["οὐρανὸν",709844,6],["καὶ",707031,7],["ἀρίθμησον",701742,176],["τοὺς",709436,58],["ἀστέρας",702017,57],["εἰ",704071,7],["δυνήσῃ",703838,123],["ἐξαριθμῆσαι",704877,106],["αὐτούς",702165,62],["καὶ",707031,7],["εἶπεν",705373,2],["οὕτως",709859,28],["ἔσται",704093,93],["τὸ",709436,34],["σπέρμα",712008,15],["σου",711945,133]],"And he brought him out and said to him, Look up now to heaven, and count the stars, if thou shalt be able to number them fully, and he said, Thus shall thy seed be."],["6",[["καὶ",707031,7],["ἐπίστευσεν",710483,2],["Αβραμ",700093,4],["τῷ",709436,113],["θεῷ",706192,114],["καὶ",707031,7],["ἐλογίσθη",708232,37],["αὐτῷ",702165,50],["εἰς",704105,0],["δικαιοσύνην",703695,9]],"And Abram believed God, and it was counted to him for righteousness."],["7",[["εἶπεν",705373,2],["δὲ",703303,11],["πρὸς",710844,0],["αὐτόν",702165,85],["ἐγὼ",704018,164],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["ἐξαγαγών",704834,182],["σε",711598,163],["ἐκ",704132,0],["χώρας",714011,17],["Χαλδαίων",713678,81],["ὥστε",714164,7],["δοῦναί",703654,106],["σοι",711925,159],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104],["κληρονομῆσαι",707724,106]],"And he said to him, I am God that brought thee out of the land of the Chaldeans, so as to give thee this land to inherit."],["8",[["εἶπεν",705373,2],["δέ",703303,11],["δέσποτα",703379,153],["κύριε",707996,153],["κατὰ",707200,0],["τί",712867,126],["γνώσομαι",703105,181],["ὅτι",709803,7],["κληρονομήσω",707724,165],["αὐτήν",702165,104]],"And he said, Master [and] Lord, how shall I know that I shall inherit it?"],["9",[["εἶπεν",705373,2],["δὲ",703303,11],["αὐτῷ",702165,50],["λαβέ",708076,176],["μοι",708974,159],["δάμαλιν",703271,9],["τριετίζουσαν",712943,78],["καὶ",707031,7],["αἶγα",700464,9],["τριετίζουσαν",712943,78],["καὶ",707031,7],["κριὸν",707906,6],["τριετίζοντα",712943,183],["καὶ",707031,7],["τρυγόνα",713000,9],["καὶ",707031,7],["περιστεράν",710391,9]],"And he said to him, Take for me an heifer in her third year, and a she-goat in her third year, and a ram in his third year, and a dove and a pigeon."],["10",[["ἔλαβεν",708076,2],["δὲ",703303,11],["αὐτῷ",702165,50],["πάντα",710177,68],["ταῦτα",709858,71],["καὶ",707031,7],["διεῖλεν",703459,2],["αὐτὰ",702165,71],["μέσα",708768,68],["καὶ",707031,7],["ἔθηκεν",712849,2],["αὐτὰ",702165,71],["ἀντιπρόσωπα",701270,68],["ἀλλήλοις",700689,151],["τὰ",709436,41],["δὲ",703303,11],["ὄρνεα",709762,42],["οὐ",709805,28],["διεῖλεν",703459,2]],"So he took to him all these, and divided them in the midst, and set them opposite to each other, but the birds he did not divide."],["11",[["κατέβη",707202,2],["δὲ",703303,11],["ὄρνεα",709762,64],["ἐπὶ",705080,0],["τὰ",709436,41],["σώματα",712635,42],["τὰ",709436,41],["διχοτομήματα",703761,42],["αὐτῶν",702165,40],["καὶ",707031,7],["συνεκάθισεν",712196,2],["αὐτοῖς",702165,151],["Αβραμ",700093,4]],"And birds came down upon the bodies, [even] upon the divided parts of them, and Abram sat down by them."],["12",[["περὶ",710285,0],["δὲ",703303,11],["ἡλίου",705974,18],["δυσμὰς",703865,39],["ἔκστασις",704314,12],["ἐπέπεσεν",705225,2],["τῷ",709436,113],["Αβραμ",700093,114],["καὶ",707031,7],["ἰδοὺ",706497,88],["φόβος",713534,4],["σκοτεινὸς",711885,14],["μέγας",708653,14],["ἐπιπίπτει",705225,91],["αὐτῷ",702165,50]],"And about sunset a trance fell upon Abram, and lo! a great gloomy terror falls upon him."],["13",[["καὶ",707031,7],["ἐρρέθη",705415,37],["πρὸς",710844,0],["Αβραμ",700093,6],["γινώσκων",703105,72],["γνώσῃ",703105,123],["ὅτι",709803,7],["πάροικον",710159,26],["ἔσται",704093,93],["τὸ",709436,34],["σπέρμα",712008,15],["σου",711945,133],["ἐν",704639,0],["γῇ",703083,1],["οὐκ",709805,28],["ἰδίᾳ",706493,101],["καὶ",707031,7],["δουλώσουσιν",703818,218],["αὐτοὺς",702165,62],["καὶ",707031,7],["κακώσουσιν",707073,218],["αὐτοὺς",702165,62],["καὶ",707031,7],["ταπεινώσουσιν",712717,218],["αὐτοὺς",702165,62],["τετρακόσια",712817,68],["ἔτη",705543,42]],"And it was said to Abram, Thou shalt surely know that thy seed shall be a sojourner in a land not their own, and they shall enslave them, and afflict them, and humble them four hundred years."],["14",[["τὸ",709436,24],["δὲ",703303,11],["ἔθνος",704068,25],["ᾧ",709781,209],["ἐὰν",703912,7],["δουλεύσωσιν",703814,234],["κρινῶ",707905,165],["ἐγώ",704018,164],["μετὰ",708780,0],["δὲ",703303,11],["ταῦτα",709858,71],["ἐξελεύσονται",704909,135],["ὧδε",714090,28],["μετὰ",708780,0],["ἀποσκευῆς",701573,17],["πολλῆς",710646,82]],"And the nation whomsoever they shall serve I will judge; and after this, they shall come forth hither with much property."],["15",[["σὺ",712181,164],["δὲ",703303,11],["ἀπελεύσῃ",701398,123],["πρὸς",710844,0],["τοὺς",709436,58],["πατέρας",710189,57],["σου",711945,133],["μετ᾿",708780,0],["εἰρήνης",704098,17],["ταφεὶς",706103,217],["ἐν",704639,0],["γήρει",703089,54],["καλῷ",707097,97]],"But thou shalt depart to thy fathers in peace, nourished in a good old age."],["16",[["τετάρτη",712811,29],["δὲ",703303,11],["γενεὰ",703037,12],["ἀποστραφήσονται",701598,144],["ὧδε",714090,28],["οὔπω",709837,28],["γὰρ",702963,11],["ἀναπεπλήρωνται",701035,255],["αἱ",709436,190],["ἁμαρτίαι",700775,191],["τῶν",709436,80],["Αμορραίων",700865,81],["ἕως",705792,0],["τοῦ",709436,20],["νῦν",709384,28]],"And in the fourth generation they shall return hither, for the sins of the Amorites are not yet filled up, even until now."],["17",[["ἐπεὶ",705054,7],["δὲ",703303,11],["ἐγίνετο",703104,19],["ὁ",709436,3],["ἥλιος",705974,4],["πρὸς",710844,0],["δυσμαῖς",703865,76],["φλὸξ",713524,12],["ἐγένετο",703104,23],["καὶ",707031,7],["ἰδοὺ",706497,88],["κλίβανος",707733,4],["καπνιζόμενος",707131,122],["καὶ",707031,7],["λαμπάδες",708079,191],["πυρός",711088,21],["αἳ",709781,256],["διῆλθον",703673,150],["ἀνὰ",700902,0],["μέσον",708768,27],["τῶν",709436,43],["διχοτομημάτων",703761,44],["τούτων",709858,40]],"And when the sun was about to set, there was a flame, and behold a smoking furnace and lamps of fire, which passed between these divided pieces."],["18",[["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["διέθετο",703609,23],["κύριος",707996,4],["τῷ",709436,113],["Αβραμ",700093,114],["διαθήκην",703456,9],["λέγων",708124,72],["τῷ",709436,53],["σπέρματί",712008,54],["σου",711945,133],["δώσω",703654,165],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104],["ἀπὸ",701425,0],["τοῦ",709436,35],["ποταμοῦ",710693,18],["Αἰγύπτου",700401,17],["ἕως",705792,0],["τοῦ",709436,35],["ποταμοῦ",710693,18],["τοῦ",709436,35],["μεγάλου",708653,116],["ποταμοῦ",710693,18],["Εὐφράτου",705716,18]],"In that day the Lord made a covenant with Abram, saying, To thy seed I will give this land, from the river of Egypt to the great river Euphrates."],["19",[["τοὺς",709436,58],["Καιναίους",707038,57],["καὶ",707031,7],["τοὺς",709436,58],["Κενεζαίους",707604,57],["καὶ",707031,7],["τοὺς",709436,58],["Κεδμωναίους",707588,57]],"The Kenites, and the Kenezites, and the Kedmoneans,"],["20",[["καὶ",707031,7],["τοὺς",709436,58],["Χετταίους",713838,57],["καὶ",707031,7],["τοὺς",709436,58],["Φερεζαίους",713422,57],["καὶ",707031,7],["τοὺς",709436,58],["Ραφαϊν",711197,57]],"and the Chettites, and the Pherezites, and the Raphaim,"],["21",[["καὶ",707031,7],["τοὺς",709436,58],["Αμορραίους",700865,57],["καὶ",707031,7],["τοὺς",709436,58],["Χαναναίους",713711,57],["καὶ",707031,7],["τοὺς",709436,58],["Ευαίους",705549,57],["καὶ",707031,7],["τοὺς",709436,58],["Γεργεσαίους",703062,57],["καὶ",707031,7],["τοὺς",709436,58],["Ιεβουσαίους",706519,57]],"and the Amorites, and the Chananites, and the Evites, and the Gergesites, and the Jebusites."