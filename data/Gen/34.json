[["1",[["ἐξῆλθεν",704909,2],["δὲ",703303,11],["Δινα",703710,12],["ἡ",709436,10],["θυγάτηρ",706320,12],["Λειας",708127,17],["ἣν",709781,131],["ἔτεκεν",712853,2],["τῷ",709436,113],["Ιακωβ",706401,114],["καταμαθεῖν",707324,106],["τὰς",709436,38],["θυγατέρας",706320,39],["τῶν",709436,130],["ἐγχωρίων",704017,198]],"And Dina, the daughter of Lea, whom she bore to Jacob, went forth to observe the daughters of the inhabitants."],["2",[["καὶ",707031,7],["εἶδεν",704075,2],["αὐτὴν",702165,104],["Συχεμ",712565,4],["ὁ",709436,3],["υἱὸς",713075,4],["Εμμωρ",704576,18],["ὁ",709436,3],["Χορραῖος",713917,4],["ὁ",709436,3],["ἄρχων",701862,4],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["λαβὼν",708076,182],["αὐτὴν",702165,104],["ἐκοιμήθη",707767,37],["μετ᾿",708780,0],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐταπείνωσεν",712717,2],["αὐτήν",702165,104]],"And Sychem the son of Emmor the Evite, the ruler of the land, saw her, and took her and lay with her, and humbled her."],["3",[["καὶ",707031,7],["προσέσχεν",710895,2],["τῇ",709436,100],["ψυχῇ",714070,1],["Δινας",703710,17],["τῆς",709436,16],["θυγατρὸς",706320,17],["Ιακωβ",706401,18],["καὶ",707031,7],["ἠγάπησεν",700120,2],["τὴν",709436,8],["παρθένον",710148,9],["καὶ",707031,7],["ἐλάλησεν",708071,2],["κατὰ",707200,0],["τὴν",709436,8],["διάνοιαν",703531,9],["τῆς",709436,16],["παρθένου",710148,17],["αὐτῇ",702165,105]],"And he was attached to the soul of Dina the daughter of Jacob, and he loved the damsel, and he spoke kindly to the damsel."],["4",[["εἶπεν",705373,2],["δὲ",703303,11],["Συχεμ",712565,4],["πρὸς",710844,0],["Εμμωρ",704576,6],["τὸν",709436,5],["πατέρα",710189,6],["αὐτοῦ",702165,102],["λέγων",708124,72],["λαβέ",708076,176],["μοι",708974,159],["τὴν",709436,8],["παιδίσκην",709928,9],["ταύτην",709858,104],["εἰς",704105,0],["γυναῖκα",703209,9]],"Sychem spoke to Emmor his father, saying, Take for me this damsel to wife."],["5",[["Ιακωβ",706401,4],["δὲ",703303,11],["ἤκουσεν",700587,2],["ὅτι",709803,7],["ἐμίανεν",708900,2],["ὁ",709436,3],["υἱὸς",713075,4],["Εμμωρ",704576,18],["Διναν",703710,9],["τὴν",709436,8],["θυγατέρα",706320,9],["αὐτοῦ",702165,102],["οἱ",709436,136],["δὲ",703303,11],["υἱοὶ",713075,52],["αὐτοῦ",702165,102],["ἦσαν",704093,137],["μετὰ",708780,0],["τῶν",709436,43],["κτηνῶν",707934,44],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,53],["πεδίῳ",710215,54],["παρεσιώπησεν",710102,2],["δὲ",703303,11],["Ιακωβ",706401,4],["ἕως",705792,0],["τοῦ",709436,20],["ἐλθεῖν",705453,106],["αὐτούς",702165,62]],"And Jacob heard that the son of Emmor had defiled Dina his daughter (now his sons were with his cattle in the plain). And Jacob was silent until they came."],["6",[["ἐξῆλθεν",704909,2],["δὲ",703303,11],["Εμμωρ",704576,4],["ὁ",709436,3],["πατὴρ",710189,4],["Συχεμ",712565,18],["πρὸς",710844,0],["Ιακωβ",706401,6],["λαλῆσαι",708071,106],["αὐτῷ",702165,50]],"And Emmor the father of Sychem went forth to Jacob, to speak to him."],["7",[["οἱ",709436,136],["δὲ",703303,11],["υἱοὶ",713075,52],["Ιακωβ",706401,18],["ἦλθον",705453,150],["ἐκ",704132,0],["τοῦ",709436,20],["πεδίου",710215,21],["ὡς",714148,7],["δὲ",703303,11],["ἤκουσαν",700587,150],["κατενύχθησαν",707347,99],["οἱ",709436,136],["ἄνδρες",701150,52],["καὶ",707031,7],["λυπηρὸν",708274,26],["ἦν",704093,13],["αὐτοῖς",702165,151],["σφόδρα",712586,28],["ὅτι",709803,7],["ἄσχημον",702055,46],["ἐποίησεν",710582,2],["ἐν",704639,0],["Ισραηλ",706839,114],["κοιμηθεὶς",707767,217],["μετὰ",708780,0],["τῆς",709436,16],["θυγατρὸς",706320,17],["Ιακωβ",706401,18],["καὶ",707031,7],["οὐχ",709805,28],["οὕτως",709859,28],["ἔσται",704093,93]],"And the sons of Jacob came from the plain; and when they heard, the men were deeply pained, and it was very grievous to them, because [the man] wrought folly in Israel, having lain with the daughter of Jacob, and so it must not be."],["8",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["Εμμωρ",704576,4],["αὐτοῖς",702165,151],["λέγων",708124,72],["Συχεμ",712565,4],["ὁ",709436,3],["υἱός",713075,4],["μου",709032,133],["προείλατο",710752,23],["τῇ",709436,100],["ψυχῇ",714070,1],["τὴν",709436,8],["θυγατέρα",706320,9],["ὑμῶν",713091,145],["δότε",703654,74],["οὖν",709835,11],["αὐτὴν",702165,104],["αὐτῷ",702165,50],["γυναῖκα",703209,9]],"And Emmor spoke to them, saying, Sychem my son has chosen in his heart your daughter; give her therefore to him for a wife,"],["9",[["ἐπιγαμβρεύσασθε",705099,345],["ἡμῖν",705994,90],["τὰς",709436,38],["θυγατέρας",706320,39],["ὑμῶν",713091,145],["δότε",703654,74],["ἡμῖν",705994,90],["καὶ",707031,7],["τὰς",709436,38],["θυγατέρας",706320,39],["ἡμῶν",705999,145],["λάβετε",708076,74],["τοῖς",709436,147],["υἱοῖς",713075,148],["ὑμῶν",713091,145]],"and intermarry with us. Give us your daughters, and take our daughters for your sons."],["10",[["καὶ",707031,7],["ἐν",704639,0],["ἡμῖν",705994,90],["κατοικεῖτε",707534,87],["καὶ",707031,7],["ἡ",709436,10],["γῆ",703083,12],["ἰδοὺ",706497,88],["πλατεῖα",710509,29],["ἐναντίον",704654,0],["ὑμῶν",713091,145],["κατοικεῖτε",707534,335],["καὶ",707031,7],["ἐμπορεύεσθε",704611,73],["ἐπ᾿",705080,0],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐγκτήσασθε",703995,186],["ἐν",704639,0],["αὐτῇ",702165,105]],"And dwell in the midst of us; and, behold, the land is spacious before you, dwell in it, and trade, and get possessions in it."],["11",[["εἶπεν",705373,2],["δὲ",703303,11],["Συχεμ",712565,4],["πρὸς",710844,0],["τὸν",709436,5],["πατέρα",710189,6],["αὐτῆς",702165,86],["καὶ",707031,7],["πρὸς",710844,0],["τοὺς",709436,58],["ἀδελφοὺς",700249,57],["αὐτῆς",702165,86],["εὕροιμι",705676,346],["χάριν",713735,9],["ἐναντίον",704654,0],["ὑμῶν",713091,145],["καὶ",707031,7],["ὃ",709781,128],["ἐὰν",703912,7],["εἴπητε",705373,125],["δώσομεν",703654,275]],"And Sychem said to her father and to her brothers, I would find grace before you, and we will give whatever ye shall name."],["12",[["πληθύνατε",710530,74],["τὴν",709436,8],["φερνὴν",713426,9],["σφόδρα",712586,28],["καὶ",707031,7],["δώσω",703654,165],["καθότι",707021,28],["ἂν",700900,11],["εἴπητέ",705373,125],["μοι",708974,159],["καὶ",707031,7],["δώσετέ",703654,337],["μοι",708974,159],["τὴν",709436,8],["παῖδα",709932,6],["ταύτην",709858,104],["εἰς",704105,0],["γυναῖκα",703209,9]],"Multiply [your demand of] dowry very much, and I will give accordingly as ye shall say to me, only ye shall give me this damsel for a wife."],["13",[["ἀπεκρίθησαν",701492,99],["δὲ",703303,11],["οἱ",709436,136],["υἱοὶ",713075,52],["Ιακωβ",706401,18],["τῷ",709436,113],["Συχεμ",712565,114],["καὶ",707031,7],["Εμμωρ",704576,114],["τῷ",709436,113],["πατρὶ",710189,114],["αὐτοῦ",702165,102],["μετὰ",708780,0],["δόλου",703787,18],["καὶ",707031,7],["ἐλάλησαν",708071,150],["αὐτοῖς",702165,151],["ὅτι",709803,7],["ἐμίαναν",708900,150],["Διναν",703710,9],["τὴν",709436,8],["ἀδελφὴν",700244,9],["αὐτῶν",702165,40]],"And the sons of Jacob answered to Sychem and Emmor his father craftily, and spoke to them, because they had defiled Dina their sister."],["14",[["καὶ",707031,7],["εἶπαν",705373,150],["αὐτοῖς",702165,151],["Συμεων",712297,4],["καὶ",707031,7],["Λευι",708158,4],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["Δινας",703710,17],["υἱοὶ",713075,52],["δὲ",703303,11],["Λειας",708127,17],["οὐ",709805,28],["δυνησόμεθα",703838,141],["ποιῆσαι",710582,106],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["δοῦναι",703654,106],["τὴν",709436,8],["ἀδελφὴν",700244,9],["ἡμῶν",705999,145],["ἀνθρώπῳ",701163,114],["ὃς",709781,213],["ἔχει",705785,91],["ἀκροβυστίαν",700605,9],["ἔστιν",704093,91],["γὰρ",702963,11],["ὄνειδος",709658,15],["ἡμῖν",705994,90]],"And Symeon and Levi, the brothers of Dina, said to them, We shall not be able to do this thing, to give our sister to a man who is uncircumcised, for it is a reproach to us."],["15",[["ἐν",704639,0],["τούτῳ",709858,50],["ὁμοιωθησόμεθα",709628,347],["ὑμῖν",713084,90],["καὶ",707031,7],["κατοικήσομεν",707534,275],["ἐν",704639,0],["ὑμῖν",713084,90],["ἐὰν",703912,7],["γένησθε",703104,142],["ὡς",714148,7],["ἡμεῖς",705983,219],["καὶ",707031,7],["ὑμεῖς",713081,219],["ἐν",704639,0],["τῷ",709436,53],["περιτμηθῆναι",710402,179],["ὑμῶν",713091,145],["πᾶν",710177,46],["ἀρσενικόν",701817,46]],"Only on these terms will we conform to you, and dwell among you, if ye also will be as we are, in that every male of you be circumcised."],["16",[["καὶ",707031,7],["δώσομεν",703654,275],["τὰς",709436,38],["θυγατέρας",706320,39],["ἡμῶν",705999,145],["ὑμῖν",713084,90],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,130],["θυγατέρων",706320,65],["ὑμῶν",713091,145],["λημψόμεθα",708076,141],["ἡμῖν",705994,90],["γυναῖκας",703209,39],["καὶ",707031,7],["οἰκήσομεν",709499,275],["παρ᾿",709995,0],["ὑμῖν",713084,90],["καὶ",707031,7],["ἐσόμεθα",704093,141],["ὡς",714148,7],["γένος",703057,15],["ἕν",704106,26]],"And we will give our daughters to you, and we will take of your daughters for wives to us, and we will dwell with you, and we will be as one race."],["17",[["ἐὰν",703912,7],["δὲ",703303,11],["μὴ",708851,28],["εἰσακούσητε",704108,125],["ἡμῶν",705999,145],["τοῦ",709436,20],["περιτέμνεσθαι",710402,110],["λαβόντες",708076,196],["τὰς",709436,38],["θυγατέρας",706320,39],["ἡμῶν",705999,145],["ἀπελευσόμεθα",701398,141]],"But if ye will not hearken to us to be circumcised, we will take our daughter and depart."],["18",[["καὶ",707031,7],["ἤρεσαν",701722,150],["οἱ",709436,136],["λόγοι",708236,52],["ἐναντίον",704654,0],["Εμμωρ",704576,18],["καὶ",707031,7],["ἐναντίον",704654,0],["Συχεμ",712565,18],["τοῦ",709436,35],["υἱοῦ",713075,18],["Εμμωρ",704576,18]],"And the words pleased Emmor, and Sychem the son of Emmor."],["19",[["καὶ",707031,7],["οὐκ",709805,28],["ἐχρόνισεν",713967,2],["ὁ",709436,3],["νεανίσκος",709232,4],["τοῦ",709436,20],["ποιῆσαι",710582,106],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["ἐνέκειτο",703972,19],["γὰρ",702963,11],["τῇ",709436,100],["θυγατρὶ",706320,1],["Ιακωβ",706401,18],["αὐτὸς",702165,121],["δὲ",703303,11],["ἦν",704093,13],["ἐνδοξότατος",704694,140],["πάντων",710177,169],["τῶν",709436,80],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102]],"And the young man delayed not to do this thing, for he was much attached to Jacob's daughter, and he was the most honourable of all in his father's house."],["20",[["ἦλθεν",705453,2],["δὲ",703303,11],["Εμμωρ",704576,4],["καὶ",707031,7],["Συχεμ",712565,4],["ὁ",709436,3],["υἱὸς",713075,4],["αὐτοῦ",702165,102],["πρὸς",710844,0],["τὴν",709436,8],["πύλην",711082,9],["τῆς",709436,16],["πόλεως",710612,17],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐλάλησαν",708071,150],["πρὸς",710844,0],["τοὺς",709436,58],["ἄνδρας",701150,57],["τῆς",709436,16],["πόλεως",710612,17],["αὐτῶν",702165,40],["λέγοντες",708124,146]],"And Emmor and Sychem his son came to the gate of their city, and spoke to the men of their city, saying,"],["21",[["οἱ",709436,136],["ἄνθρωποι",701163,52],["οὗτοι",709858,201],["εἰρηνικοί",704099,138],["εἰσιν",704093,197],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["οἰκείτωσαν",709499,56],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἐμπορευέσθωσαν",704611,77],["αὐτήν",702165,104],["ἡ",709436,10],["δὲ",703303,11],["γῆ",703083,12],["ἰδοὺ",706497,88],["πλατεῖα",710509,29],["ἐναντίον",704654,0],["αὐτῶν",702165,40],["τὰς",709436,38],["θυγατέρας",706320,39],["αὐτῶν",702165,40],["λημψόμεθα",708076,141],["ἡμῖν",705994,90],["γυναῖκας",703209,39],["καὶ",707031,7],["τὰς",709436,38],["θυγατέρας",706320,39],["ἡμῶν",705999,145],["δώσομεν",703654,275],["αὐτοῖς",702165,151]],"These men are peaceable, let them dwell with us upon the land, and let them trade in it, and behold the land is extensive before them; we will take their daughters to us for wives, and we will give them our daughters."],["22",[["μόνον",709001,28],["ἐν",704639,0],["τούτῳ",709858,50],["ὁμοιωθήσονται",709628,144],["ἡμῖν",705994,90],["οἱ",709436,136],["ἄνθρωποι",701163,52],["τοῦ",709436,20],["κατοικεῖν",707534,55],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["ὥστε",714164,7],["εἶναι",704093,55],["λαὸν",708094,6],["ἕνα",704106,27],["ἐν",704639,0],["τῷ",709436,53],["περιτέμνεσθαι",710402,110],["ἡμῶν",705999,145],["πᾶν",710177,46],["ἀρσενικόν",701817,46],["καθὰ",706979,28],["καὶ",707031,7],["αὐτοὶ",702165,201],["περιτέτμηνται",710402,255]],"Only on these terms will the men conform to us to dwell with us so as to be one people, if every male of us be circumcised, as they also are circumcised."],["23",[["καὶ",707031,7],["τὰ",709436,63],["κτήνη",707934,64],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,63],["ὑπάρχοντα",713102,242],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,63],["τετράποδα",712823,195],["οὐχ",709805,28],["ἡμῶν",705999,145],["ἔσται",704093,93],["μόνον",709001,28],["ἐν",704639,0],["τούτῳ",709858,50],["ὁμοιωθῶμεν",709628,283],["αὐτοῖς",702165,151],["καὶ",707031,7],["οἰκήσουσιν",709499,218],["μεθ᾿",708780,0],["ἡμῶν",705999,145]],"And shall not their cattle and their herds, and their possessions, be ours? only in this let us conform to them, and they will dwell with us."],["24",[["καὶ",707031,7],["εἰσήκουσαν",704108,150],["Εμμωρ",704576,18],["καὶ",707031,7],["Συχεμ",712565,18],["τοῦ",709436,35],["υἱοῦ",713075,18],["αὐτοῦ",702165,102],["πάντες",710177,138],["οἱ",709436,136],["ἐκπορευόμενοι",704293,348],["τὴν",709436,8],["πύλην",711082,9],["τῆς",709436,16],["πόλεως",710612,17],["αὐτῶν",702165,40],["καὶ",707031,7],["περιετέμοντο",710402,189],["τὴν",709436,8],["σάρκα",711537,9],["τῆς",709436,16],["ἀκροβυστίας",700605,17],["αὐτῶν",702165,40],["πᾶς",710177,14],["ἄρσην",701818,14]],"And all that went in at the gate of their city hearkened to Emmor and Sychem his son, and they were circumcised in the flesh of their foreskin every male."],["25",[["ἐγένετο",703104,23],["δὲ",703303,11],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["τρίτῃ",712968,101],["ὅτε",709802,28],["ἦσαν",704093,137],["ἐν",704639,0],["τῷ",709436,113],["πόνῳ",710661,114],["ἔλαβον",708076,150],["οἱ",709436,136],["δύο",703849,59],["υἱοὶ",713075,52],["Ιακωβ",706401,18],["Συμεων",712297,4],["καὶ",707031,7],["Λευι",708158,4],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["Δινας",703710,17],["ἕκαστος",704133,14],["τὴν",709436,8],["μάχαιραν",708593,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἰσῆλθον",704114,150],["εἰς",704105,0],["τὴν",709436,8],["πόλιν",710612,9],["ἀσφαλῶς",702045,28],["καὶ",707031,7],["ἀπέκτειναν",701498,150],["πᾶν",710177,46],["ἀρσενικόν",701817,46]],"And it came to pass on the third day, when they were in pain, the two sons of Jacob, Symeon and Levi, Dina's brethren, took each man his sword, and came upon the city securely, and slew every male."],["26",[["τόν",709436,5],["τε",712751,11],["Εμμωρ",704576,6],["καὶ",707031,7],["Συχεμ",712565,6],["τὸν",709436,5],["υἱὸν",713075,6],["αὐτοῦ",702165,102],["ἀπέκτειναν",701498,150],["ἐν",704639,0],["στόματι",712125,54],["μαχαίρας",708593,17],["καὶ",707031,7],["ἔλαβον",708076,150],["τὴν",709436,8],["Διναν",703710,9],["ἐκ",704132,0],["τοῦ",709436,35],["οἴκου",709516,18],["τοῦ",709436,35],["Συχεμ",712565,18],["καὶ",707031,7],["ἐξῆλθον",704909,150]],"And they slew Emmor and Sychem his son with the edge of the sword, and took Dina out of the house of Sychem, and went forth."],["27",[["οἱ",709436,136],["δὲ",703303,11],["υἱοὶ",713075,52],["Ιακωβ",706401,18],["εἰσῆλθον",704114,150],["ἐπὶ",705080,0],["τοὺς",709436,58],["τραυματίας",712921,57],["καὶ",707031,7],["διήρπασαν",703562,150],["τὴν",709436,8],["πόλιν",710612,9],["ἐν",704639,0],["ᾗ",709781,108],["ἐμίαναν",708900,150],["Διναν",703710,9],["τὴν",709436,8],["ἀδελφὴν",700244,9],["αὐτῶν",702165,40]],"But the sons of Jacob came upon the wounded, and ravaged the city wherein they had defiled Dina their sister."],["28",[["καὶ",707031,7],["τὰ",709436,41],["πρόβατα",710768,42],["αὐτῶν",702165,40],["καὶ",707031,7],["τοὺς",709436,58],["βόας",702798,57],["αὐτῶν",702165,40],["καὶ",707031,7],["τοὺς",709436,58],["ὄνους",709671,57],["αὐτῶν",702165,40],["ὅσα",709788,195],["τε",712751,11],["ἦν",704093,13],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["καὶ",707031,7],["ὅσα",70