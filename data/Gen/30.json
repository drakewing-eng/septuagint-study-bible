],["μανδραγορῶν",708474,81],["τοῦ",709436,35],["υἱοῦ",713075,18],["μου",709032,133],["καὶ",707031,7],["ἐκοιμήθη",707767,37],["μετ᾿",708780,0],["αὐτῆς",702165,86],["τὴν",709436,8],["νύκτα",709386,9],["ἐκείνην",704183,104]],"And Jacob came in out of the field at even; and Lea went forth to meet him, and said, Thou shalt come in to me this day, for I have hired thee for my son's mandrakes; and he lay with her that night."],["17",[["καὶ",707031,7],["ἐπήκουσεν",705009,2],["ὁ",709436,3],["θεὸς",706192,4],["Λειας",708127,17],["καὶ",707031,7],["συλλαβοῦσα",712262,149],["ἔτεκεν",712853,2],["τῷ",709436,113],["Ιακωβ",706401,114],["υἱὸν",713075,6],["πέμπτον",710245,27]],"And God hearkened to Lea, and she conceived, and bore Jacob a fifth son."],["18",[["καὶ",707031,7],["εἶπεν",705373,2],["Λεια",708127,12],["ἔδωκεν",703654,2],["ὁ",709436,3],["θεὸς",706192,4],["τὸν",709436,5],["μισθόν",708939,6],["μου",709032,133],["ἀνθ᾿",701227,0],["οὗ",709781,48],["ἔδωκα",703654,155],["τὴν",709436,8],["παιδίσκην",709928,9],["μου",709032,133],["τῷ",709436,113],["ἀνδρί",701150,114],["μου",709032,133],["καὶ",707031,7],["ἐκάλεσεν",707084,2],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["Ισσαχαρ",706843,6],["ὅ",709781,33],["ἐστιν",704093,91],["Μισθός",708939,4]],"And Lea said, God has given me my reward, because I gave my maid to my husband; and she called his name Issachar, which is, Reward."],["19",[["καὶ",707031,7],["συνέλαβεν",712262,2],["ἔτι",705538,28],["Λεια",708127,12],["καὶ",707031,7],["ἔτεκεν",712853,2],["υἱὸν",713075,6],["ἕκτον",704340,27],["τῷ",709436,113],["Ιακωβ",706401,114]],"And Lea conceived again, and bore Jacob a sixth son."],["20",[["καὶ",707031,7],["εἶπεν",705373,2],["Λεια",708127,12],["δεδώρηταί",703902,187],["μοι",708974,159],["ὁ",709436,3],["θεὸς",706192,4],["δῶρον",703907,25],["καλόν",707097,46],["ἐν",704639,0],["τῷ",709436,113],["νῦν",709384,28],["καιρῷ",707047,114],["αἱρετιεῖ",700469,127],["με",708618,163],["ὁ",709436,3],["ἀνήρ",701150,4],["μου",709032,133],["