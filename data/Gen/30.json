[["1",[["ἰδοῦσα",704075,149],["δὲ",703303,11],["Ραχηλ",711208,12],["ὅτι",709803,7],["οὐ",709805,28],["τέτοκεν",712853,171],["τῷ",709436,113],["Ιακωβ",706401,114],["καὶ",707031,7],["ἐζήλωσεν",705873,2],["Ραχηλ",711208,12],["τὴν",709436,8],["ἀδελφὴν",700244,9],["αὐτῆς",702165,86],["καὶ",707031,7],["εἶπεν",705373,2],["τῷ",709436,113],["Ιακωβ",706401,114],["δός",703654,176],["μοι",708974,159],["τέκνα",712761,42],["εἰ",704071,7],["δὲ",703303,11],["μή",708851,28],["τελευτήσω",712781,165],["ἐγώ",704018,164]],"And Rachel having perceived that she bore Jacob no children, was jealous of her sister; and said to Jacob, Give me children; and if not, I shall die."],["2",[["ἐθυμώθη",706335,37],["δὲ",703303,11],["Ιακωβ",706401,4],["τῇ",709436,100],["Ραχηλ",711208,1],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῇ",702165,105],["μὴ",708851,28],["ἀντὶ",701227,0],["θεοῦ",706192,18],["ἐγώ",704018,164],["εἰμι",704093,157],["ὃς",709781,213],["ἐστέρησέν",712076,2],["σε",711598,163],["καρπὸν",707169,6],["κοιλίας",707761,17]],"And Jacob was angry with Rachel, and said to her, Am I in the place of God, who has deprived thee of the fruit of the womb?"],["3",[["εἶπεν",705373,2],["δὲ",703303,11],["Ραχηλ",711208,12],["τῷ",709436,113],["Ιακωβ",706401,114],["ἰδοὺ",706497,88],["ἡ",709436,10],["παιδίσκη",709928,12],["μου",709032,133],["Βαλλα",702485,12],["εἴσελθε",704114,176],["πρὸς",710844,0],["αὐτήν",702165,104],["καὶ",707031,7],["τέξεται",712853,93],["ἐπὶ",705080,0],["τῶν",709436,43],["γονάτων",703172,44],["μου",709032,133],["καὶ",707031,7],["τεκνοποιήσομαι",712762,181],["κἀγὼ",706969,288],["ἐξ",704132,0],["αὐτῆς",702165,86]],"And Rachel said to Jacob, Behold my handmaid Balla, go in to her, and she shall bear upon my knees, and I also shall have children by her."],["4",[["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["Βαλλαν",702485,9],["τὴν",709436,8],["παιδίσκην",709928,9],["αὐτῆς",702165,86],["αὐτῷ",702165,50],["γυναῖκα",703209,9],["εἰσῆλθεν",704114,2],["δὲ",703303,11],["πρὸς",710844,0],[