",712853,93],["πάντα",710177,195],["τὰ",709436,63],["πρόβατα",710768,64],["λευκά",708165,195]],"If he should say thus, The speckled shall be thy reward, then all the cattle would bear speckled; and if he should say, The white shall be thy reward, then would all the cattle bear white."],["9",[["καὶ",707031,7],["ἀφείλατο",702177,23],["ὁ",709436,3],["θεὸς",706192,4],["πάντα",710177,68],["τὰ",709436,41],["κτήνη",707934,42],["τοῦ",709436,35],["πατρὸς",710189,18],["ὑμῶν",713091,145],["καὶ",707031,7],["ἔδωκέν",703654,2],["μοι",708974,159],["αὐτά",702165,71]],"So God has taken away all the cattle of your father, and given them to me."],["10",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἡνίκα",706008,28],["ἐνεκίσσων",703975,137],["τὰ",709436,63],["πρόβατα",710768,64],["καὶ",707031,7],["εἶδον",704075,150],["τοῖς",709436,147],["ὀφθαλμοῖς",709870,148],["αὐτὰ",702165,71],["ἐν",704639,0],["τῷ",709436,113],["ὕπνῳ",713181,114],["καὶ",707031,7],["ἰδοὺ",706497,88],["οἱ",709436,136],["τράγοι",712917,52],["καὶ",707031,7],["οἱ",709436,136],["κριοὶ",707906,52],["ἀναβαίνοντες",700905,146],["ἦσαν",704093,137],["ἐπὶ",705080,0],["τὰ",709436,41],["πρόβατα",710768,42],["καὶ",707031,7],["τὰς",709436,38],["αἶγας",700464,39],["διάλευκοι",703498,138],["καὶ",707031,7],["ποικίλοι",710589,138],["καὶ",707031,7],["σποδοειδεῖς",712021,138],["ῥαντοί",711179,138]],"And it came to pass when the cattle conceived and were with young, that I beheld with mine eyes in sleep, and behold the he-goats and the rams leaping on the sheep and the she-goats, speckled and variegated and spotted with ash-coloured spots."],["11",[["καὶ",707031,7],["εἶπέν",705373,2],["μοι",708974,159],["ὁ",709436,3],["ἄγγελος",700140,4],["τοῦ",709436,35],["θεοῦ",706192,18],["καθ᾿",707200,0],["ὕπνον",713181,6],["Ιακωβ",706401,153],["ἐγὼ",704018,164],["δὲ",703303,11],["εἶπα",705373,155],["τί",712867,273],["ἐστιν",704093,91]],"And the angel of God said to me in a dream, Jacob; and I said, What is it?"],["12",[["καὶ",707031,7],["εἶπεν",705373,2],["ἀνάβλεψον",700913,176],["τοῖς",709436,147],["ὀφθαλμοῖς",709870,148],["σου",711945,133],["καὶ",707031,7],["ἰδὲ",709725,176],["τοὺς",709436,58],["τράγους",712917,57],["καὶ",707031,7],["τοὺς",709436,58],["κριοὺς",707906,57],["ἀναβαίνοντας",700905,235],["ἐπὶ",705080,0],["τὰ",709436,41],["πρόβατα",710768,42],["καὶ",707031,7],["τὰς",709436,38],["αἶγας",700464,39],["διαλεύκους",703498,60],["καὶ",707031,7],["ποικίλους",710589,60],["καὶ",707031,7],["σποδοειδεῖς",712021,60],["ῥαντούς",711179,60],["ἑώρακα",709725,89],["γὰρ",702963,11],["ὅσα",709788,68],["σοι",711925,159],["Λαβαν",708037,4],["ποιεῖ",710582,91]],"And he said, Look up with thine eyes, and behold the he-goats and the rams leaping on the sheep and the she-goats, speckled and variegated and spotted with ash-coloured spots; for I have seen all things that Laban does to thee."],["13",[["ἐγώ",704018,164],["εἰμι",704093,157],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["ὀφθείς",709712,217],["σοι",711925,159],["ἐν",704639,0],["τόπῳ",712903,114],["θεοῦ",706192,18],["οὗ",709806,28],["ἤλειψάς",700644,162],["μοι",708974,159],["ἐκεῖ",704181,28],["στήλην",712092,9],["καὶ",707031,7],["ηὔξω",705727,174],["μοι",708974,159],["ἐκεῖ",704181,28],["εὐχήν",705726,9],["νῦν",709384,28],["οὖν",709835,11],["ἀνάστηθι",701173,176],["καὶ",707031,7],["ἔξελθε",704909,176],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17],["ταύτης",709858,86],["καὶ",707031,7],["ἄπελθε",701398,176],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["τῆς",709436,16],["γενέσεώς",703043,17],["σου",711945,133],["καὶ",707031,7],["ἔσομαι",704093,181],["μετὰ",708780,0],["σοῦ",711945,133]],"I am God that appeared to thee in the place of God, where thou anointedst a pillar to me, and vowedst to me there a vow; now then arise and depart out of this land, depart into the land of thy nativity, and I will be with thee."],["14",[["καὶ",707031,7],["ἀποκριθεῖσα",701492,307],["Ραχηλ",711208,12],["καὶ",707031,7],["Λεια",708127,12],["εἶπαν",705373,150],["αὐτῷ",702165,50],["μὴ",708851,28],["ἔστιν",704093,91],["ἡμῖν",705994,90],["ἔτι",705538,28],["μερὶς",708748,12],["ἢ",705924,7],["κληρονομία",707725,12],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["τοῦ",709436,35],["πατρὸς",710189,18],["ἡμῶν",705999,145]],"And Rachel and Lea answered and said to him, Have we yet a part or inheritance in the house of our father?"],["15",[["οὐχ",709805,28],["ὡς",714148,7],["αἱ",709436,190],["ἀλλότριαι",700699,192],["λελογίσμεθα",708232,331],["αὐτῷ",702165,50],["πέπρακεν",710480,171],["γὰρ",702963,11],["ἡμᾶς",705981,194],["καὶ",707031,7],["κατέφαγεν",707519,2],["καταβρώσει",707218,1],["τὸ",709436,24],["ἀργύριον",701707,25],["ἡμῶν",705999,145]],"Are we not considered strangers by him? for he has sold us, and quite devoured our money."],["16",[["πάντα",710177,27],["τὸν",709436,5],["πλοῦτον",710563,6],["καὶ",707031,7],["τὴν",709436,8],["δόξαν",703791,9],["ἣν",709781,131],["ἀφείλατο",702177,23],["ὁ",709436,3],["θεὸς",706192,4],["τοῦ",709436,35],["πατρὸς",710189,18],["ἡμῶν",705999,145],["ἡμῖν",705994,90],["ἔσται",704093,93],["καὶ",707031,7],["τοῖς",709436,95],["τέκνοις",712761,96],["ἡμῶν",705999,145],["νῦν",709384,28],["οὖν",709835,11],["ὅσα",709788,68],["εἴρηκέν",705415,171],["σοι",711925,159],["ὁ",709436,3],["θεός",706192,4],["ποίει",710582,240]],"All the wealth and the glory which God has taken from our father, it shall be our's and our children's; now then do whatsoever God has said to thee."],["17",[["ἀναστὰς",701173,182],["δὲ",703303,11],["Ιακωβ",706401,4],["ἔλαβεν",708076,2],["τὰς",709436,38],["γυναῖκας",703209,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["παιδία",709927,42],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τὰς",709436,38],["καμήλους",707110,39]],"And Jacob arose and took his wives and his children up on the camels;"],["18",[["καὶ",707031,7],["ἀπήγαγεν",701324,2],["πάντα",710177,68],["τὰ",709436,41],["ὑπάρχοντα",713102,237],["αὐτοῦ",702165,102],["καὶ",707031,7],["πᾶσαν",710177,36],["τὴν",709436,8],["ἀποσκευὴν",701573,9],