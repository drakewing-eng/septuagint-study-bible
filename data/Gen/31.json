[["1",[["ἤκουσεν",700587,2],["δὲ",703303,11],["Ιακωβ",706401,4],["τὰ",709436,41],["ῥήματα",711246,42],["τῶν",709436,80],["υἱῶν",713075,81],["Λαβαν",708037,18],["λεγόντων",708124,170],["εἴληφεν",708076,171],["Ιακωβ",706401,4],["πάντα",710177,68],["τὰ",709436,41],["τοῦ",709436,35],["πατρὸς",710189,18],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,43],["τοῦ",709436,35],["πατρὸς",710189,18],["ἡμῶν",705999,145],["πεποίηκεν",710582,171],["πᾶσαν",710177,36],["τὴν",709436,8],["δόξαν",703791,9],["ταύτην",709858,104]],"And Jacob heard the words of the sons of Laban, saying, Jacob has taken all that was our father's, and of our father's property has he gotten all this glory."],["2",[["καὶ",707031,7],["εἶδεν",704075,2],["Ιακωβ",706401,4],["τὸ",709436,24],["πρόσωπον",710986,25],["τοῦ",709436,35],["Λαβαν",708037,18],["καὶ",707031,7],["ἰδοὺ",706497,88],["οὐκ",709805,28],["ἦν",704093,13],["πρὸς",710844,0],["αὐτὸν",702165,85],["ὡς",714148,7],["ἐχθὲς",713853,28],["καὶ",707031,7],["τρίτην",712968,36],["ἡμέραν",705984,9]],"And Jacob saw the countenance of Laban, and behold it was not toward him as before."],["3",[["εἶπεν",705373,2],["δὲ",703303,11],["κύριος",707996,4],["πρὸς",710844,0],["Ιακωβ",706401,6],["ἀποστρέφου",701598,253],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["καὶ",707031,7],["εἰς",704105,0],["τὴν",709436,8],["γενεάν",703037,9],["σου",711945,133],["καὶ",707031,7],["ἔσομαι",704093,181],["μετὰ",708780,0],["σοῦ",711945,133]],"And the Lord said to Jacob, Return to the land of thy father, and to thy family, and I will be with thee."],["4",[["ἀποστείλας",701592,182],["δὲ",703303,11],["Ιακωβ",706401,4],["ἐκάλεσεν",707084,2],["Ραχηλ",711208,9],["καὶ",707031,7],["Λειαν",708127,9],["εἰς",704105,0],["τὸ",709436,24],["πεδίον",710215,25],["οὗ",709806,28],["τὰ",709436,63],["ποίμνια",710598,64]],"And Jacob sent and called Lea and Rachel to the plain where the flocks were."],["5",[["καὶ",707031,7],["εἶ