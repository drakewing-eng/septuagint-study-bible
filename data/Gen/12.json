[["1",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["τῷ",709436,113],["Αβραμ",700093,114],["ἔξελθε",704909,176],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17],["σου",711945,133],["καὶ",707031,7],["ἐκ",704132,0],["τῆς",709436,16],["συγγενείας",712184,17],["σου",711945,133],["καὶ",707031,7],["ἐκ",704132,0],["τοῦ",709436,35],["οἴκου",709516,18],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["ἄν",700900,11],["σοι",711925,159],["δείξω",703314,165]],"And the Lord said to Abram, Go forth out of thy land and out of thy kindred, and out of the house of thy father, and come into the land which I shall shew thee."],["2",[["καὶ",707031,7],["ποιήσω",710582,165],["σε",711598,163],["εἰς",704105,0],["ἔθνος",704068,25],["μέγα",708653,46],["καὶ",707031,7],["εὐλογήσω",705631,165],["σε",711598,163],["καὶ",707031,7],["μεγαλυνῶ",708647,165],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["καὶ",707031,7],["ἔσῃ",704093,123],["εὐλογητός",705632,14]],"And I will make thee a great nation, and I will bless thee and magnify thy name, and thou shalt be blessed."],["3",[["καὶ",707031,7],["εὐλογήσω",705631,165],["τοὺς",709436,58],["εὐλογοῦντάς",705631,235],["σε",711598,163],["καὶ",707031,7],["τοὺς",709436,58],["καταρωμένους",707396,236],["σε",711598,163],["καταράσομαι",707396,181],["καὶ",707031,7],["ἐνευλογηθήσονται",704720,144],["ἐν",704639,0],["σοὶ",711925,159],["πᾶσαι",710177,192],["αἱ",709436,190],["φυλαὶ",713620,191],["τῆς",709436,16],["γῆς",703083,17]],"And I will bless those that bless thee, and curse those that curse thee, and in thee shall all the tribes of the earth be blessed."],["4",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["Αβραμ",700093,4],["καθάπερ",706984,28],["ἐλάλησεν",708071,2],["αὐτῷ",702165,50],["κύριος",707996,4],["καὶ",707031,7],["ᾤχετο",709539,19],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["Λωτ",708293,4],["Αβραμ",700093,4],["δὲ",703303,11],["ἦν",704093,13],["ἐτῶν",705543