10],["ἄμμος",700845,12],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["πλατυνθήσεται",710508,134],["ἐπὶ",705080,0],["θάλασσαν",706069,9],["καὶ",707031,7],["ἐπὶ",705080,0],["λίβα",708224,6],["καὶ",707031,7],["ἐπὶ",705080,0],["βορρᾶν",702765,6],["καὶ",707031,7],["ἐπ᾿",705080,0],["ἀνατολάς",701071,39],["καὶ",707031,7],["ἐνευλογηθήσονται",704720,144],["ἐν",704639,0],["σοὶ",711925,159],["πᾶσαι",710177,192],["αἱ",709436,190],["φυλαὶ",713620,191],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["σπέρματί",712008,54],["σου",711945,133]],"And thy seed shall be as the sand of the earth; and it shall spread abroad to the sea, and the south, and the north, and to the east; and in thee and in thy seed shall all the tribes of the earth be blessed."],["15",[["καὶ",707031,7],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["μετὰ",708780,0],["σοῦ",711945,133],["διαφυλάσσων",703632,72],["σε",711598,163],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["πάσῃ",710177,101],["οὗ",709806,28],["ἐὰν",703912,7],["πορευθῇς",710667,279],["καὶ",707031,7],["ἀποστρέψω",701598,165],["σε",711598,163],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104],["ὅτι",709803,7],["οὐ",709805,28],["μή",708851,28],["σε",711598,163],["ἐγκαταλίπω",703967,207],["ἕως",705792,0],["τοῦ",709436,20],["ποιῆσαί",710582,106],["με",708618,163],["πάντα",710177,68],["ὅσα",709788,68],["ἐλάλησά",708071,155],["σοι",711925,159]],"And behold I am with thee to preserve thee continually in all the way wherein thou shalt go; and I will bring thee back to this land; for I will not desert thee, until I have done all that I have said to thee."],["16",[["καὶ",707031,7],["ἐξηγέρθη",704889,37],["Ιακωβ",706401,4],["ἀπὸ",701425,0],["τοῦ",709436,35],["ὕπνου",713181,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["ὅτι",709803,7],["ἔστιν",704093,91],["κύριος",707996,4],["ἐν",704639,0],["τῷ",709436,113],["τόπῳ",712903,114],["τούτῳ",709858,50],["ἐγὼ",704018,164],["δὲ",703303,11],["οὐκ",709805,28],["ᾔδειν",704075,143]],"And Jacob awaked out of his sleep, and said, The Lord is in this place, and I knew it not."],["17",[["καὶ",707031,7],["ἐφοβήθη",713532,37],["καὶ",707031,7],["εἶπεν",705373,2],["ὡς",714148,7],["φοβερὸς",713530,14],["ὁ",709436,3],["τόπος",712903,4],["οὗτος",709858,121],["οὐκ",709805,28],["ἔστιν",704093,91],["τοῦτο",709858,132],["ἀλλ᾿",700680,7],["ἢ",705924,7],["οἶκος",709516,4],["θεοῦ",706192,18],["καὶ",707031,7],["αὕτη",709858,107],["ἡ",709436,10],["πύλη",711082,12],["τοῦ",709436,35],["οὐρανοῦ",709844,18]],"And he was afraid, and said, How fearful is this place! this is none other than the house of God, and this is the gate of heaven."],["18",[["καὶ",707031,7],["ἀνέστη",701173,2],["Ιακωβ",706401,4],["τὸ",709436,24],["πρωὶ",711021,28],["καὶ",707031,7],["ἔλαβεν",708076,2],["τὸν",709436,5],["λίθον",708196,6],["ὃν",709781,112],["ὑπέθηκεν",713251,2],["ἐκεῖ",704181,28],["πρὸς",710844,0],["κεφαλῆς",707639,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔστησεν",706846,2],["αὐτὸν",702165,85],["στήλην",712092,9],["καὶ",707031,7],["ἐπέχεεν",705337,13],["ἔλαιον",704380,25],["ἐπὶ",705080,0],["τὸ",709436,24],["ἄκρον",700608,46],["αὐτῆς",702165,86]],"And Jacob rose up in the morning, and took the stone he [had] laid there by his head, and he set it up [as] a pillar, and poured oil on the top of it."],["19",[["καὶ",707031,7],["ἐκάλεσεν",707084,2],["Ιακωβ",706401,4],["τὸ",709436,24],["ὄνομα",709666,25],["τοῦ",709436,35],["τόπου",712903,18],["ἐκείνου",704183,102],["Οἶκος",709516,4],["θεοῦ",706192,18],["καὶ",707031,7],["Ουλαμλους",709833,323],["ἦν",704093,13],["ὄνομα",709666,25],["τῇ",709436,100],["πόλει",710612,1],["τὸ",709436,24],["πρότερον",710991,46]],"And he called the name of that place, the House of God; and the name of the city before was Ulam-luz."],["20",[["καὶ",707031,7],["ηὔξατο",705727,23],["Ιακωβ",706401,4],["εὐχὴν",705726,9],["λέγων",708124,72],["ἐὰν",703912,7],["ᾖ",704093,204],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["διαφυλάξῃ",703632,172],["με",708618,163],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["ταύτῃ",709858,105],["ᾗ",709781,108],["ἐγὼ",704018,164],["πορεύομαι",710667,254],["καὶ",707031,7],["δῷ",703654,172],["μοι",708974,159],["ἄρτον",701829,6],["φαγεῖν",705495,106],["καὶ",707031,7],["ἱμάτιον",706742,25],["περιβαλέσθαι",710294,109]],"And Jacob vowed a vow, saying, If the Lord God will be with me, and guard me throughout on this journey, on which I am going, and give me bread to eat, and raiment to put on,"],["21",[["καὶ",707031,7],["ἀποστρέψῃ",701598,172],["με",708618,163],["μετὰ",708780,0],["σωτηρίας",712658,17],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133],["καὶ",707031,7],["ἔσται",704093,93],["μοι",708974,159],["κύριος",707996,4],["εἰς",704105,0],["θεόν",706192,6]],"and bring me back in safety to the house of my father, then shall the Lord be for a God to me."],["22",[["καὶ",707031,7],["ὁ",709436,3],["λίθος",708196,4],["οὗτος",709858,121],["ὃν",709781,112],["ἔστησα",706846,155],["στήλην",712092,9],["ἔσται",704093,93],["μοι",708974,159],["οἶκος",709516,4],["θεοῦ",706192,18],["καὶ",707031,7],["πάντων",710177,83],["ὧν",709781,103],["ἐάν",703912,7],["μοι",708974,159],["δῷς",703654,175],["δεκάτην",703342,36],["ἀποδεκατώσω",701442,165],["αὐτά",702165,71],["σοι",711925,159]],"And this stone, which I have set up for a pillar, shall be to me a house of God; and of all whatsoever thou shalt give me, I will tithe a tenth for thee."]]