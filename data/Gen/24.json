[["1",[["καὶ",707031,7],["Αβρααμ",700091,4],["ἦν",704093,13],["πρεσβύτερος",710735,224],["προβεβηκὼς",710763,270],["ἡμερῶν",705984,65],["καὶ",707031,7],["κύριος",707996,4],["εὐλόγησεν",705631,2],["τὸν",709436,5],["Αβρααμ",700091,6],["κατὰ",707200,0],["πάντα",710177,68]],"And Abraam was old, advanced in days, and the Lord blessed Abraam in all things."],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["Αβρααμ",700091,4],["τῷ",709436,113],["παιδὶ",709932,114],["αὐτοῦ",702165,102],["τῷ",709436,113],["πρεσβυτέρῳ",710735,302],["τῆς",709436,16],["οἰκίας",709505,17],["αὐτοῦ",702165,102],["τῷ",709436,113],["ἄρχοντι",701862,114],["πάντων",710177,83],["τῶν",709436,43],["αὐτοῦ",702165,102],["θὲς",712849,176],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133],["ὑπὸ",713184,0],["τὸν",709436,5],["μηρόν",708885,6],["μου",709032,133]],"And Abraam said to his servant the elder of his house, who had rule over all his possessions, Put thy hand under my thigh,"],["3",[["καὶ",707031,7],["ἐξορκιῶ",704965,165],["σε",711598,163],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["τὸν",709436,5],["θεὸν",706192,6],["τῆς",709436,16],["γῆς",703083,17],["ἵνα",706747,7],["μὴ",708851,28],["λάβῃς",708076,175],["γυναῖκα",703209,9],["τῷ",709436,113],["υἱῷ",713075,114],["μου",709032,133],["Ισαακ",706799,114],["ἀπὸ",701425,0],["τῶν",709436,130],["θυγατέρων",706320,65],["τῶν",709436,80],["Χαναναίων",713711,81],["μεθ᾿",708780,0],["ὧν",709781,252],["ἐγὼ",704018,164],["οἰκῶ",709499,157],["ἐν",704639,0],["αὐτοῖς",702165,151]],"and I will adjure thee by the Lord the God of heaven, and the God of the earth, that thou take not a wife for my son Isaac from the daughters of the Chananites, with whom I dwell, in the midst of them."],["4",[["ἀλλὰ",700680,7],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["μου",709032,133],["οὗ",709806,28],["ἐγενόμην",703104,161],["πορεύσῃ",710667,172],["καὶ",707031,7],["εἰς",704105,0],["τὴν",709436,8],["φυλήν",713620,9],["μου",709032,133],["καὶ",707031,7],["λήμψῃ",708076,123],["γυναῖκα",703209,9],["τῷ",709436,113],["υἱῷ",713075,114],["μου",709032,133],["Ισαακ",706799,114],["ἐκεῖθεν",704182,28]],"But thou shalt go instead to my country, where I was born, and to my tribe, and thou shalt take from thence a wife for my son Isaac."],["5",[["εἶπεν",705373,2],["δὲ",703303,11],["πρὸς",710844,0],["αὐτὸν",702165,85],["ὁ",709436,3],["παῖς",709932,4],["μήποτε",708882,28],["οὐ",709805,28],["βούλεται",702795,117],["ἡ",709436,10],["γυνὴ",703209,12],["πορευθῆναι",710667,179],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["ὀπίσω",709697,0],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104],["ἀποστρέψω",701598,165],["τὸν",709436,5],["υἱόν",713075,6],["σου",711945,133],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ὅθεν",709486,28],["ἐξῆλθες",704909,162],["ἐκεῖθεν",704182,28]],"And the servant said to him, Shall I carry back thy son to the land whence thou camest forth, if haply the woman should not be willing to return with me to this land?"],["6",[["εἶπεν",705373,2],["δὲ",703303,11],["πρὸς",710844,0],["αὐτὸν",702165,85],["Αβρααμ",700091,4],["πρόσεχε",710895,240],["σεαυτῷ",711599,50],["μὴ",708851,28],["ἀποστρέψῃς",701598,175],["τὸν",709436,5],["υἱόν",713075,6],["μου",709032,133],["ἐκεῖ",704181,28]],"And Abraam said to him, Take heed to thyself that thou carry not my son back thither."],["7",[["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["ὁ",709436,3],["θεὸς",706192,4],["τῆς",709436,16],["γῆς",703083,17],["ὃς",709781,213],["ἔλαβέν",708076,2],["με",708618,163],["ἐκ",704132,0],["τοῦ",709436,35],["οἴκου",709516,18],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133],["καὶ",707031,7],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17],["ἧς",709781,167],["ἐγενήθην",703104,156],["ὃς",709781,213],["ἐλάλησέν",708071,2],["μοι",708974,159],["καὶ",707031,7],["ὤμοσέν",709620,2],["μοι",708974,159],["λέγων",708124,72],["σοὶ",711925,159],["δώσω",703654,165],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104],["καὶ",707031,7],["τῷ",709436,53],["σπέρματί",712008,54],["σου",711945,133],["αὐτὸς",702165,121],["ἀποστελεῖ",701592,127],["τὸν",709436,5],["ἄγγελον",700140,6],["αὐτοῦ",702165,102],["ἔμπροσθέν",704618,0],["σου",711945,133],["καὶ",707031,7],["λήμψῃ",708076,123],["γυναῖκα",703209,9],["τῷ",709436,113],["υἱῷ",713075,114],["μου",709032,133],["Ισαακ",706799,114],["ἐκεῖθεν",704182,28]],"The Lord the God of heaven, and the God of the earth, who took me out of my father's house, and out of the land whence I sprang, who spoke to me, and who swore to me, saying, I will give this land to thee and to thy seed, he shall send his angel before thee, and thou shalt take a wife to my son from thence."],["8",[["ἐὰν",703912,7],["δὲ",703303,11],["μὴ",708851,28],["θέλῃ",706176,204],["ἡ",709436,10],["γυνὴ",703209,12],["πορευθῆναι",710667,179],["μετὰ",708780,0],["σοῦ",711945,133],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104],["καθαρὸς",706988,14],["ἔσῃ",704093,123],["ἀπὸ",701425,0],["τοῦ",709436,35],["ὅρκου",709753,18],["τούτου",709858,102],["μόνον",709001,28],["τὸν",709436,5],["υἱόν",713075,6],["μου",709032,133],["μὴ",708851,28],["ἀποστρέψῃς",701598,175],["ἐκεῖ",704181,28]],"And if the woman should not be willing to come with thee into this land, thou shalt be clear from my oath, only carry not my son thither again."],["9",[["καὶ",707031,7],["ἔθηκεν",712849,2],["ὁ",709436,3],["παῖς",709932,4],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["ὑπὸ",713184,0],["τὸν",709436,5],["μηρὸν",708885,6],["Αβρααμ",700091,18],["τοῦ",709436,35],["κυρίου",707996,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὤμοσεν",709620,2],["αὐτῷ",702165,50],["περὶ",710285,0],["τοῦ",709436,20],["ῥήματος",711246,21],["τούτου",709858,49]],"And the servant put his hand under the thigh of his master Abraam, and swore to him concerning this matter."],["10",[["καὶ",707031,7],["ἔλαβεν",708076,2],["ὁ",