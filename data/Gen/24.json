,11],["θυγατέρες",706320,191],["τῶν",709436,80],["οἰκούντων",709499,170],["τὴν",709436,8],["πόλιν",710612,9],["ἐκπορεύονται",704293,269],["ἀντλῆσαι",701281,106],["ὕδωρ",713071,25]],"Lo! I stand by the well of water, and the daughters of them that inhabit the city come forth to draw water."],["14",[["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["παρθένος",710148,12],["ᾗ",709781,108],["ἂν",700900,11],["ἐγὼ",704018,164],["εἴπω",705373,207],["ἐπίκλινον",705166,176],["τὴν",709436,8],["ὑδρίαν",713067,9],["σου",711945,133],["ἵνα",706747,7],["πίω",710478,207],["καὶ",707031,7],["εἴπῃ",705373,172],["μοι",708974,159],["πίε",710478,176],["καὶ",707031,7],["τὰς",709436,38],["καμήλους",707110,39],["σου",711945,133],["ποτιῶ",710700,165],["ἕως",705792,7],["ἂν",700900,11],["παύσωνται",710202,232],["πίνουσαι",710478,306],["ταύτην",709858,104],["ἡτοίμασας",705539,162],["τῷ",709436,113],["παιδί",709932,114],["σου",711945,133],["Ισαακ",706799,114],["καὶ",707031,7],["ἐν",704639,0],["τούτῳ",709858,50],["γνώσομαι",703105,181],["ὅτι",709803,7],["ἐποίησας",710582,162],["ἔλεος",704426,25],["τῷ",709436,113],["κυρίῳ",707996,114],["μου",709032,133],["Αβρααμ",700091,114]],"And it shall be, the virgin to whomsoever I shall say, Incline thy water-pot, that I may drink, and she shall say, Drink thou, and I will give thy camels drink, until they shall have done drinking—even this one thou hast prepared for thy servant Isaac, and hereby shall I know that thou hast dealt mercifully with my master Abraam."],["15",[["καὶ",707031,7],["ἐγένετο",703104,23],["πρὸ",710747,0],["τοῦ",709436,20],["συντελέσαι",712510,106],["αὐτὸν",702165,85],["λαλοῦντα",708071,183],["ἐν",704639,0],["τῇ",709436,100],["διανοίᾳ",703531,1],["καὶ",707031,7],["ἰδοὺ",706497,88],["Ρεβεκκα",711213,12],["ἐξεπορεύετο",704293,19],["ἡ",709436,10],["τεχθεῖσα",712853,307],["Βαθουηλ",702377,114],["υἱῷ",713075,114],["Μελχας",708708,17],["τῆς",709436,16],["γυναικὸς",703209,17],["Ναχωρ",709227,18],["ἀδελφοῦ",700249,18],["δὲ",703303,11],["Αβρααμ",700091,18],["ἔχουσα",705785,188],["τὴν",709436,8],["ὑδρίαν",713067,9],["ἐπὶ",705080,0],["τῶν",709436,80],["ὤμων",714114,81],["αὐτῆς",702165,86]],"And it came to pass before he had done speaking in his mind, that behold, Rebecca the daughter of Bathuel, the son of Melcha, the wife of Nachor, and [the same] the brother of Abraam, came forth, having a water-pot on her shoulders."],["16",[["ἡ",709436,10],["δὲ",703303,11],["παρθένος",710148,12],["ἦν",704093,13],["καλὴ",707097,29],["τῇ",709436,100],["ὄψει",709901,1],["σφόδρα",712586,28],["παρθένος",710148,12],["ἦν",704093,13],["ἀνὴρ",701150,4],["οὐκ",709805,28],["ἔγνω",703105,2],["αὐτήν",702165,104],["καταβᾶσα",707202,149],["δὲ",703303,11],["ἐπὶ",705080,0],["τὴν",709436,8],["πηγὴν",710450,9],["ἔπλησεν",710532,2],["τὴν",709436,8],["ὑδρίαν",713067,9],["καὶ",707031,7],["ἀνέβη",700905,2]],"And the virgin was very beautiful in appearance, she was a virgin, a man had not known her; and she went down to the well, and filled her water-pot, and came up."],["17",[["ἐπέδραμεν",705312,2],["δὲ",703303,11],["ὁ",709436,3],["παῖς",709932,4],["εἰς",704105,0],["συνάντησιν",712397,9],["αὐτῆς",702165,86],["καὶ",707031,7],["εἶπεν",705373,2],["πότισόν",710700,176],["με",708618,163],["μικρὸν",708915,46],["ὕδωρ",713071,25],["ἐκ",704132,0],["τῆς",709436,16],["ὑδρίας",713067,17],["σου",711945,133]],"And the servant ran up to meet her, and said, Give me a little water to drink out of thy pitcher;"],["18",[["ἡ",709436,10],["δὲ",703303,11],["εἶπεν",705373,2],["πίε",710478,176],["κύριε",707996,153],["καὶ",707031,7],["ἔσπευσεν",712011,2],["καὶ",707031,7],["καθεῖλεν",706982,2],["τὴν",709436,8],["ὑδρίαν",713067,9],["ἐπὶ",705080,0],["τὸν",709436,5],["βραχίονα",702808,6],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐπότισεν",710700,2],["αὐτόν",702165,85]],"and she said, Drink, Sir; and she hasted, and let down the pitcher upon her arm, and gave him to drink, till he ceased drinking."],["19",[["ἕως",705792,7],["ἐπαύσατο",710202,23],["πίνων",710478,72],["καὶ",