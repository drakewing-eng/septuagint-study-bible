[["1",[["εἶπεν",705373,2],["δὲ",703303,11],["ὁ",709436,3],["θεὸς",706192,4],["πρὸς",710844,0],["Ιακωβ",706401,6],["ἀναστὰς",701173,182],["ἀνάβηθι",700905,176],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["Βαιθηλ",702412,184],["καὶ",707031,7],["οἴκει",709499,240],["ἐκεῖ",704181,28],["καὶ",707031,7],["ποίησον",710582,176],["ἐκεῖ",704181,28],["θυσιαστήριον",706348,25],["τῷ",709436,113],["θεῷ",706192,114],["τῷ",709436,113],["ὀφθέντι",709712,238],["σοι",711925,159],["ἐν",704639,0],["τῷ",709436,53],["ἀποδιδράσκειν",701448,55],["σε",711598,163],["ἀπὸ",701425,0],["προσώπου",710986,21],["Ησαυ",706030,18],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["σου",711945,133]],"And God said to Jacob, Arise, go up to the place, Bæthel, and dwell there; and make there an altar to the God that appeared to thee, when thou fleddest from the face of Esau thy brother."],["2",[["εἶπεν",705373,2],["δὲ",703303,11],["Ιακωβ",706401,4],["τῷ",709436,113],["οἴκῳ",709516,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["πᾶσιν",710177,230],["τοῖς",709436,147],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἄρατε",700473,74],["τοὺς",709436,58],["θεοὺς",706192,57],["τοὺς",709436,58],["ἀλλοτρίους",700699,60],["τοὺς",709436,58],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["ἐκ",704132,0],["μέσου",708768,116],["ὑμῶν",713091,145],["καὶ",707031,7],["καθαρίσασθε",706985,186],["καὶ",707031,7],["ἀλλάξατε",700683,74],["τὰς",709436,38],["στολὰς",712120,39],["ὑμῶν",713091,145]],"And Jacob said to his house, and to all that were with him, Remove the strange gods that are with you from the midst of you, and purify yourselves, and change your clothes."],["3",[["καὶ",707031,7],["ἀναστάντες",701173,196],["ἀναβῶμεν",700905,79],["εἰς",704105,0],["Βαιθηλ",702412,227],["καὶ",707031,7],["ποιήσωμεν",710582,79],["ἐκεῖ",704181,28],["θυσιαστήριον",706348,25],["τῷ",709436,113],["θεῷ",706192,114],["τῷ",709436,113],["ἐπακούσαντί",705009,350],["μοι",708974,159],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["θλίψεως",706276,17],["ὃς",709781,213],["ἦν",704093,13],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["διέσωσέν",703599,2],["με",708618,163],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["ᾗ",709781,108],["ἐπορεύθην",710667,156]],"And let us rise and go up to Bæthel, and let us there make an altar to God who hearkened to me in the day of calamity, who was with me, and preserved me throughout in the journey, by which I went."],["4",[["καὶ",707031,7],["ἔδωκαν",703654,150],["τῷ",709436,113],["Ιακωβ",706401,114],["τοὺς",709436,58],["θεοὺς",706192,57],["τοὺς",709436,58],["ἀλλοτρίους",700699,60],["οἳ",709781,250],["ἦσαν",704093,137],["ἐν",704639,0],["ταῖς",709436,75],["χερσὶν",713787,76],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,41],["ἐνώτια",704826,42],["τὰ",709436,41],["ἐν",704639,0],["τοῖς",709436,95],["ὠσὶν",709852,96],["αὐτῶν",702165,40],["καὶ",707031,7],["κατέκρυψεν",707292,2],["αὐτὰ",702165,71],["Ιακωβ",706401,4],["ὑπὸ",713184,0],["τὴν",709436,8],["τερέμινθον",712798,9],["τὴν",709436,8],["ἐν",704639,0],["Σικιμοις",711785,148],["καὶ",707031,7],["ἀπώλεσεν",701513,2],["αὐτὰ",702165,71],["ἕως",705792,0],["τῆς",709436,16],["σήμερον",711751,28],["ἡμέρας",705984,17]],"And they gave to Jacob the strange gods, which were in their hands, and the ear-rings which were in their ears, and Jacob hid them under the turpentine tree which is in Secima, and destroyed them to this day."],["5",[["καὶ",707031,7],["ἐξῆρεν",704839,2],["Ισραηλ",706839,4],["ἐκ",704132,0],["Σικιμων",711785,81,148],["καὶ",707031,7],["ἐγένετο",703104,23],["φόβος",713534,4],["θεοῦ",706192,18],["ἐπὶ",705080,0],["τὰς",709436,38],["πόλεις",710612,39],["τὰς",709436,38],["κύκλῳ",707959,114],["αὐτῶν",702165,40],["καὶ",707031,7],["οὐ",709805,28],["κατεδίωξαν",707243,150],["ὀπίσω",709697,0],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18]],"So Israel departed from Secima, and the fear of God was upon the cities round about them, and they did not pursue after the children of Israel."],["6",[["ἦλθεν",705453,2],["δὲ",703303,11],["Ιακωβ",706401,4],["εἰς",704105,0],["Λουζα",708252,9],["ἥ",709781,177],["ἐστιν",704093,91],["ἐν",704639,0],["γῇ",703083,1],["Χανααν",713708,184],["ἥ",709781,177],["ἐστιν",704093,91],["Βαιθηλ",702412,120],["αὐτὸς",702165,121],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["λαός",708094,4],["ὃς",709781,213],["ἦν",704093,13],["μετ᾿",708780,0],["αὐτοῦ",702165,102]],"And Jacob came to Luza, which is in the land of Chanaan, which is Bæthel, he and all the people that were with him."],["7",[["καὶ",707031,7],["ᾠκοδόμησεν",709509,2],["ἐκεῖ",704181,28],["θυσιαστήριον",706348,25],["καὶ",707031,7],["ἐκάλεσεν",707084,2],["τὸ",709436,24],["ὄνομα",709666,25],["τοῦ",709436,35],["τόπου",712903,18],["Βαιθηλ",702412,227],["ἐκεῖ",704181,28],["γὰρ",702963,11],["ἐπεφάνη",705317,37],["αὐτῷ",702165,50],["ὁ",709436,3],["θεὸς",706192,4],["ἐν",704639,0],["τῷ",709436,53],["ἀποδιδράσκειν",701448,55],["αὐτὸν",702165,85],["ἀπὸ",701425,0],["προσώπου",710986,21],["Ησαυ",706030,18],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["αὐτοῦ",702165,102]],"And he built there an altar, and called the name of the place Bæthel; for there God appeared to him, when he fled from the face of his brother Esau."],["8",[["ἀπέθανεν",701461,2],["δὲ",703303,11],["Δεββωρα",703305,12],["ἡ",709436,10],["τροφὸς",712985,12],["Ρεβεκκας",711213,17],["κατώτερον",707557,0],["Βαιθηλ",702412,118],["ὑπὸ",713184,0],["τὴν",709436,8],["βάλανον",702477,9],["καὶ",707031,7],["ἐκάλεσεν",707084,2],["Ιακωβ",706401,4],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτῆς",702165,86],["Βάλανος",702477,12],["πένθους",710253,21]],"And Deborrha, Rebecca's nurse, died, and was buried below Bæthel under the oak; and Jacob called its name, The Oak of Mourning."],["9",[["ὤφθη",709712,37],["δὲ",703303,11],["ὁ",709436,3],["θεὸς",706192,4],["Ιακωβ",706401,114],["ἔτι",705538,28],["ἐν",704639,0],["Λουζα",708252,111],["ὅτε",709802,28],["παρεγένετο",710006,23],["ἐκ",704132,0],["Μεσοποταμίας",708767,17],["τῆς",709436,16],["Συρίας",712533,17],["καὶ",707031,7],["ηὐλόγησεν",705631,2],["αὐτὸν",702165,85],["ὁ",709436,3],["θεός",706192,4]],"And God appeared to Jacob once more in Luza, when he came out of Mesopotamia of Syria, and God blessed him."],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["ὁ",709436,3],["θεός",706192,4],["τὸ",709436,34],["ὄνομά",709666,15],["σου",711945,133],["Ιακωβ",706401,4],["οὐ",709805,28],["κληθήσεται",707084,134],["ἔτι",705538,28],["Ιακωβ",706401,4],["ἀλλ᾿",700680,7],["Ισραηλ",706839,4],["ἔσται",704093,93],["τὸ",709436,34],["ὄνομά",709666,15],["σου",711945,133]],"And God said to him, Thy name shall not be called Jacob, but Israel shall be thy name; and he called his name Israel."],["11",[["εἶπεν",705373,2],["δὲ",703303,11],["αὐτῷ",702165,50],["ὁ",709436,3],["θεός",706192,4],["ἐγὼ",704018,164],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["αὐξάνου",702144,253],["καὶ",707031,7],["πληθύνου",710530,253],["ἔθνη",704068,64],["καὶ",707031,7],["συναγωγαὶ",712376,191],["ἐθνῶν",704068,44],["ἔσονται",704093,135],["ἐκ",704132,0],["σοῦ",711945,133],["καὶ",707031,7],["βασιλεῖς",702580,52],["ἐκ",704132,0],["τῆς",709436,16],["ὀσφύος",709800,17],["σου",711945,133],["ἐξελεύσονται",704909,135]],"And God said to him, I am thy God; increase and multiply; for nations and gatherings of nations shall be of thee, and kings shall come out of thy loins."],["12",[["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["δέδωκα",703654,89],["Αβρααμ",700091,114],["καὶ",707031,7],["Ισαακ",706799,114],["σοὶ",711925,159],["δέδωκα",703654,89],["αὐτήν",702165,104],["σοὶ",711925,159],["ἔσται",704093,93],["καὶ",707031,7],["τῷ",709436,53],["σπέρματί",712008,54],["σου",711945,133],["μετὰ",708780,0],["σὲ",711598,163],["δώσω",703654,165],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104]],"And the land which I gave to Abraam and Isaac, I have given it to thee; and it shall come to pass that I will give this land also to thy seed after thee."],["13",[["ἀνέβη",700905,2],["δὲ",703303,11],["ὁ",709436,3],["θεὸς",706192,4],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["ἐκ",704132,0],["τοῦ",709436,35],["τόπου",712903,18],["οὗ",709806,28],["ἐλάλησεν",708071,2],["μετ᾿",708780,0],["αὐτοῦ",702165,102]],"And God went up from him from the place where he spoke with him."],["14",[["καὶ",707031,7],["ἔστησεν",706846,2],["Ιακωβ",706401,4],["στήλην",712092,9],["ἐν",704639,0],["τῷ",709436,113],["τόπῳ",712903,114],["ᾧ",709781,309],["ἐλάλησεν",708071,2],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["στήλην",712092,9],["λιθίνην",708193,36],["καὶ",707031,7],["ἔσπεισεν",712007,2],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["σπονδὴν",712025,9],["καὶ",707031,7],["ἐπέχεεν",705337,13],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["ἔλαιον",704380,25]],"And Jacob set up a pillar in the place where God spoke with him, [even] a pillar of stone; and offered a libation upon it, and poured oil upon it."],["15",[["καὶ",707031,7],["ἐκάλεσεν",707084,2],["Ιακωβ",706401,4],["τὸ",709436,24],["ὄνομα",709666,25],["τοῦ",709436,35],["τόπου",712903,18],["ἐν",704639,0],["ᾧ",709781,309],["ἐλάλησεν",708071,2],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἐκεῖ",704181,28],["ὁ",709436,3],["θεός",706192,4],["Βαιθηλ",702412,227]],"And Jacob called the name of the place in which God spoke with him, Bæthel."],["16",[["ἀπάρας",701329,182],["δὲ",703303,11],["Ιακωβ",706401,4],["ἐκ",704132,0],["Βαιθηλ",702412,118],["ἔπηξεν",710452,2],["τὴν",709436,8],["σκηνὴν",711845,9],["αὐτοῦ",702165,102],["ἐπέκεινα",705062,28],["τοῦ",709436,35],["πύργου",711092,18],["Γαδερ",702878,118],["ἐγένετο",703104,23],["δὲ",703303,11],["ἡνίκα",706008,28],["ἤγγισεν",703939,2],["Χαβραθα",713653,111],["εἰς",704105,0],["γῆν",703083,9],["ἐλθεῖν",705453,106],["Εφραθα",705765,184],["ἔτεκεν",712853,2],["Ραχηλ",711208,12],["καὶ",707031,7],["ἐδυστόκησεν",703874,2],["ἐν",704639,0],["τῷ",709436,113],["τοκετῷ",712881,114]],"[And Jacob removed from Bæthel, and pitched his tent beyond the tower of Gader,] and it came to pass when he drew nigh to Chabratha, to enter into Ephratha, Rachel travailed; and in her travail she was in hard labour."],["17",[["ἐγένετο",703104,23],["δὲ",703303,11],["ἐν",704639,0],["τῷ",709436,113],["σκληρῶς",711865,28],["αὐτὴν",702165,104],["τίκτειν",712853,55],["εἶπεν",705373,2],["αὐτῇ",702165,105],["ἡ",709436,10],["μαῖα",708381,12],["θάρσει",706122,240],["καὶ",707031,7],["γὰρ",702963,11],["οὗτός",709858,121],["σοί",711925,159],["ἐστιν",704093,91],["υἱός",713075,4]],"And it came to pass in her hard labour, that the midwife said to her, Be of good courage, for thou shalt also have this son."],["18",[["ἐγένετο",703104,23],["δὲ",703303,11],["ἐν",704639,0],["τῷ",709436,53],["ἀφιέναι",702211,55],["αὐτὴν",702165,104],["τὴν",709436,8],["ψυχήν",714070,9],["ἀπέθνῃσκεν",701461,13],["γάρ",702963,11],["ἐκάλεσεν",707084,2],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["Υἱὸς",713075,4],["ὀδύνης",709463,17],["μου",709032,133],["ὁ",709436,3],["δὲ",703303,11],["πατὴρ",710189,4],["ἐκάλεσεν",707084,2],["αὐτὸν",702165,85],["Βενιαμιν",702650,6]],"And it came to pass in her giving up the ghost (for she was dying), that she called his name, The son of my pain; but his father called his name Benjamin."],["19",[["ἀπέθανεν",701461,2],["δὲ",703303,11],["Ραχηλ",711208,12],["καὶ",707031,7],["ἐτάφη",706103,37],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["Εφραθα",705765,118],["αὕτη",709858,107],["ἐστὶν",704093,91],["Βηθλεεμ",702688,120]],"So Rachel died, and was buried in the way of the course of Ephratha, this is Bethleem."],["20",[["καὶ",707031,7],["ἔστησεν",706846,2],["Ιακωβ",706401,4],["στήλην",712092,9],["ἐπὶ",705080,0],["τοῦ",709436,20],["μνημείου",708963,21],["αὐτῆς",702165,86],["αὕτη",709858,107],["ἐστὶν",704093,91],["στήλη",712092,12],["μνημείου",708963,21],["Ραχηλ",711208,17],["ἕως",705792,0],["τῆς",709436,16],["σήμερον",711751,28],["ἡμέρας",705984,17]],"And Jacob set up a pillar on her tomb; this is the pillar on the tomb of Rachel, until this day."],["22",[["ἐγένετο",703104,23],["δὲ",703303,11],["ἡνίκα",706008,28],["κατῴκησεν",707534,2],["Ισραηλ",706839,4],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ἐκείνῃ",704183,105],["ἐπορεύθη",710667,37],["Ρουβην",711295,4],["καὶ",707031,7],["ἐκοιμήθη",707767,37],["μετὰ",708780,0],["Βαλλας",702485,17],["τῆς",709436,16],["παλλακῆς",709943,17],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἤκουσεν",700587,2],["Ισραηλ",706839,4],["καὶ",707031,7],["πονηρὸν",710660,26],["ἐφάνη",713311,37],["ἐναντίον",704654,0],["αὐτοῦ",702165,102],["ἦσαν",704093,137],["δὲ",703303,11],["οἱ",709436,136],["υἱοὶ",713075,52],["Ιακωβ",706401,18],["δώδεκα",703887,59]],"And it came to pass when Israel dwelt in that land, that Ruben went and lay with Balla, the concubine of his father Jacob; and Israel heard, and the thing appeared grievous before him. And the sons of Jacob were twelve."],["23",[["υἱοὶ",713075,52],["Λειας",708127,17],["πρωτότοκος",711046,14],["Ιακωβ",706401,18],["Ρουβην",711295,4],["Συμεων",712297,4],["Λευι",708158,4],["Ιουδας",706775,4],["Ισσαχαρ",706843,4],["Ζαβουλων",705813,4]],"The sons of Lea, the first-born of Jacob; Ruben, Symeon, Levi, Judas, Issachar, Zabulon."],["24",[["υἱοὶ",713075,52],["δὲ",703303,11],["Ραχηλ",711208,17],["Ιωσηφ",706948,4],["καὶ",707031,7],["Βενιαμιν",702650,4]],"And the sons of Rachel; Joseph and Benjamin."],["25",[["υἱοὶ",713075,52],["δὲ",703303,11],["Βαλλας",702485,17],["παιδίσκης",709928,17],["Ραχηλ",711208,17],["Δαν",703276,4],["καὶ",707031,7],["Νεφθαλι",709279,4]],"And the sons of Balla, the hand-maid of Rachel; Dan and Nephthalim."],["26",[["υἱοὶ",713075,52],["δὲ",703303,11],["Ζελφας",705856,17],["παιδίσκης",709928,17],["Λειας",708127,17],["Γαδ",702872,4],["καὶ",707031,7],["Ασηρ",701934,4],["οὗτοι",709858,201],["υἱοὶ",713075,52],["Ιακωβ",706401,18],["οἳ",709781,250],["ἐγένοντο",703104,189],["αὐτῷ",702165,50],["ἐν",704639,0],["Μεσοποταμίᾳ",708767,1],["τῆς",709436,16],["Συρίας",712533,17]],"And the sons of Zelpha, the hand-maid of Lea; Gad and Aser. These [are] the sons of Jacob, which were born to him in Mesopotamia of Syria."],["27",[["ἦλθεν",705453,2],["δὲ",703303,11],["Ιακωβ",706401,4],["πρὸς",710844,0],["Ισαακ",706799,6],["τὸν",709436,5],["πατέρα",710189,6],["αὐτοῦ",702165,102],["εἰς",704105,0],["Μαμβρη",708455,227],["εἰς",704105,0],["πόλιν",710612,9],["τοῦ",709436,20],["πεδίου",710215,21],["αὕτη",709858,107],["ἐστὶν",704093,91],["Χεβρων",713777,120],["ἐν",704639,0],["γῇ",703083,1],["Χανααν",713708,184],["οὗ",709806,28],["παρῴκησεν",710156,2],["Αβρααμ",700091,4],["καὶ",707031,7],["Ισαακ",706799,4]],"And Jacob came to Isaac his father to Mambre, to a city of the plain; this is Chebron in the land of Chanaan, where Abraam and Isaac sojourned."],["28",[["ἐγένοντο",703104,189],["δὲ",703303,11],["αἱ",709436,190],["ἡμέραι",705984,191],["Ισαακ",706799,18],["ἃς",709781,193],["ἔζησεν",705851,2],["ἔτη",705543,64],["ἑκατὸν",704136,59],["ὀγδοήκοντα",709442,59]],"And the days of Isaac which he lived were an hundred and eighty years."],["29",[["καὶ",707031,7],["ἐκλιπὼν",704237,182],["ἀπέθανεν",701461,2],["καὶ",707031,7],["προσετέθη",710965,37],["πρὸς",710844,0],["τὸ",709436,24],["γένος",703057,25],["αὐτοῦ",702165,102],["πρεσβύτερος",710735,224],["καὶ",707031,7],["πλήρης",710541,14],["ἡμερῶν",705984,65],["καὶ",707031,7],["ἔθαψαν",706103,150],["αὐτὸν",702165,85],["Ησαυ",706030,4],["καὶ",707031,7],["Ιακωβ",706401,4],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτοῦ",702165,102]],"And Isaac gave up the ghost and died, and was laid to his family, old and full of days; and Esau and Jacob his sons buried him."]]