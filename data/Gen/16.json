[["1",[["Σαρα",711507,12],["δὲ",703303,11],["ἡ",709436,10],["γυνὴ",703209,12],["Αβραμ",700093,18],["οὐκ",709805,28],["ἔτικτεν",712853,13],["αὐτῷ",702165,50],["ἦν",704093,13],["δὲ",703303,11],["αὐτῇ",702165,105],["παιδίσκη",709928,12],["Αἰγυπτία",700399,29],["ᾗ",709781,108],["ὄνομα",709666,15],["Αγαρ",700125,12]],"And Sara the wife of Abram bore him no children; and she had an Egyptian maid, whose name was Agar."],["2",[["εἶπεν",705373,2],["δὲ",703303,11],["Σαρα",711507,12],["πρὸς",710844,0],["Αβραμ",700093,6],["ἰδοὺ",706497,88],["συνέκλεισέν",712223,2],["με",708618,163],["κύριος",707996,4],["τοῦ",709436,20],["μὴ",708851,28],["τίκτειν",712853,55],["εἴσελθε",704114,176],["οὖν",709835,11],["πρὸς",710844,0],["τὴν",709436,8],["παιδίσκην",709928,9],["μου",709032,133],["ἵνα",706747,7],["τεκνοποιήσῃς",712762,175],["ἐξ",704132,0],["αὐτῆς",702165,86],["ὑπήκουσεν",713096,2],["δὲ",703303,11],["Αβραμ",700093,4],["τῆς",709436,16],["φωνῆς",713640,17],["Σαρας",711507,17]],"And Sara said to Abram, Behold, the Lord has restrained me from bearing, go therefore in to my maid, that I may get children for myself through her. And Abram hearkened to the voice of Sara."],["3",[["καὶ",707031,7],["λαβοῦσα",708076,149],["Σαρα",711507,12],["ἡ",709436,10],["γυνὴ",703209,12],["Αβραμ",700093,18],["Αγαρ",700125,9],["τὴν",709436,8],["Αἰγυπτίαν",700399,36],["τὴν",709436,8],["ἑαυτῆς",703917,86],["παιδίσκην",709928,9],["μετὰ",708780,0],["δέκα",703333,59],["ἔτη",705543,42],["τοῦ",709436,20],["οἰκῆσαι",709499,106],["Αβραμ",700093,6],["ἐν",704639,0],["γῇ",703083,1],["Χανααν",713708,184],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτὴν",702165,104],["Αβραμ",700093,114],["τῷ",709436,113],["ἀνδρὶ",701150,114],["αὐτῆς",702165,86],["αὐτῷ",702165,50],["γυναῖκα",703209,9]],"So Sara the wife of Abram having taken Agar the Egyptian her handmaid, after Abram had dwelt ten years in the land of Chanaan, gave her to Abram her husband as a wife to him."],["4",[["καὶ",707031,7],["εἰσῆλθεν",704114,2],["πρὸς",710844,0],["Αγαρ