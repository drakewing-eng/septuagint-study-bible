[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἡνίκα",706008,28],["ἤρξαντο",701860,189],["οἱ",709436,136],["ἄνθρωποι",701163,52],["πολλοὶ",710646,138],["γίνεσθαι",703104,110],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["θυγατέρες",706320,191],["ἐγενήθησαν",703104,99],["αὐτοῖς",702165,151]],"And it came to pass when men began to be numerous upon the earth, and daughters were born to them,"],["2",[["ἰδόντες",709725,196],["δὲ",703303,11],["οἱ",709436,136],["υἱοὶ",713075,52],["τοῦ",709436,35],["θεοῦ",706192,18],["τὰς",709436,38],["θυγατέρας",706320,39],["τῶν",709436,80],["ἀνθρώπων",701163,81],["ὅτι",709803,7],["καλαί",707097,192],["εἰσιν",704093,197],["ἔλαβον",708076,150],["ἑαυτοῖς",703917,151],["γυναῖκας",703209,39],["ἀπὸ",701425,0],["πασῶν",710177,198],["ὧν",709781,199],["ἐξελέξαντο",704236,189]],"that the sons of God having seen the daughters of men that they were beautiful, took to themselves wives of all whom they chose."],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["οὐ",709805,28],["μὴ",708851,28],["καταμείνῃ",707326,172],["τὸ",709436,24],["πνεῦμά",710566,25],["μου",709032,133],["ἐν",704639,0],["τοῖς",709436,147],["ἀνθρώποις",701163,148],["τούτοις",709858,151],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["διὰ",703417,0],["τὸ",709436,24],["εἶναι",704093,55],["αὐτοὺς",702165,62],["σάρκας",711537,39],["ἔσονται",704093,135],["δὲ",703303,11],["αἱ",709436,190],["ἡμέραι",705984,191],["αὐτῶν",702165,40],["ἑκατὸν",704136,59],["εἴκοσι",704085,59],["ἔτη",705543,42]],"And the Lord God said, My Spirit shall certainly not remain among these men for ever, because they are flesh, but their days shall be an hundred and twenty years."],["4",[["οἱ",709436,136],["δὲ",703303,11],["γίγαντες",703101,52],["ἦσαν",704093,137],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["καὶ",707031,7],["μετ᾿",708780,0],["ἐκεῖνο",704183,129],["ὡς",714148,7],["ἂν",700900,11],["εἰσεπορεύοντο",704124,139],["οἱ",709436,136],["υἱοὶ",713075,52],["τοῦ",709436,35],["θεοῦ",706192,18],["πρὸς",710844,0],["τὰς",709436,38],["θυγατέρας",706320,39],["τῶν",709436,80],["ἀνθρώπων",701163,81],["καὶ",707031,7],["ἐγεννῶσαν",703051,150],["ἑαυτοῖς",703917,151],["ἐκεῖνοι",704183,201],["ἦσαν",704093,137],["οἱ",709436,136],["γίγαντες",703101,52],["οἱ",709436,136],["ἀπ᾿",701425,0],["αἰῶνος",700504,18],["οἱ",709436,136],["ἄνθρωποι",701163,52],["οἱ",709436,136],["ὀνομαστοί",709669,138]],"Now the giants were upon the earth in those days; and after that when the sons of God were wont to go in to the daughters of men, they bore [children] to them, those were the giants of old, the men of renown."],["5",[["ἰδὼν",709725,182],["δὲ",703303,11],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὅτι",709803,7],["ἐπληθύνθησαν",710530,99],["αἱ",709436,190],["κακίαι",707054,191],["τῶν",709436,80],["ἀνθρώπων",701163,81],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["πᾶς",710177,14],["τις",712866,158],["διανοεῖται",703528,117],["ἐν",704639,0],["τῇ",709436,100],["καρδίᾳ",707141,1],["αὐτοῦ",702165,102],["ἐπιμελῶς",705200,28],["ἐπὶ",705080,0],["τὰ",709436,41],["πονηρὰ",710660,68],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39]],"And the Lord God having seen that the wicked actions of men were multiplied upon the earth, and that every one in his heart was intently brooding over evil continually,"],["6",[["καὶ",707031,7],["ἐνεθυμήθη",704739,37],["ὁ",709436,3],["θεὸς",706192,4],["ὅτι",709803,7],["ἐποίησεν",710582,2],["τὸν",709436,5],["ἄνθρωπον",701163,6],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["διενοήθη",703528,37]],"then God laid it to heart that he had made man upon the earth, and he pondered [it] deeply."],["7",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["θεός",706192,4],["ἀπαλείψω",701332,165],["τὸν",709436,5],["ἄνθρωπον",701163,6],["ὃν",709781,112],["ἐποίησα",710582,155],["ἀπὸ",701425,0],["προσώπου",710986,21],["τῆς",709436,16],["γῆς",703083,17],["ἀπὸ",701425,0],["ἀνθρώπου",701163,18],["ἕως",705792,0],["κτήνους",707934,21],["καὶ",707031,7],["ἀπὸ",701425,0],["ἑρπετῶν",705441,44],["ἕως",705792,0],["τῶν",709436,43],["πετεινῶν",710438,44],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["ὅτι",709803,7],["ἐθυμώθην",706335,156],["ὅτι",709803,7],["ἐποίησα",710582,155],["αὐτούς",702165,62]],"And God said, I will blot out man whom I have made from the face of the earth, even man with cattle, and reptiles with flying creatures of the sky, for I am grieved that I have made them."],["8",[["Νωε",709395,4],["δὲ",703303,11],["εὗρεν",705676,2],["χάριν",713735,9],["ἐναντίον",704654,0],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18]],"But Noe found grace before the Lord God."],["9",[["αὗται",709858,202],["δὲ",703303,11],["αἱ",709436,190],["γενέσεις",703043,191],["Νωε",709395,18],["Νωε",709395,4],["ἄνθρωπος",701163,4],["δίκαιος",703694,14],["τέλειος",712769,14],["ὢν",704093,72],["ἐν",704639,0],["τῇ",709436,100],["γενεᾷ",703037,1],["αὐτοῦ",702165,102],["τῷ",709436,113],["θεῷ",706192,114],["εὐηρέστησεν",705554,2],["Νωε",709395,4]],"And these [are] the generations of Noe. Noe was a just man; being perfect in his generation, Noe was well-pleasing to God."],["10",[["ἐγέννησεν",703051,2],["δὲ",703303,11],["Νωε",709395,4],["τρεῖς",712927,60],["υἱούς",713075,57],["τὸν",709436,5],["Σημ",711743,6],["τὸν",709436,5],["Χαμ",713699,6],["τὸν",709436,5],["Ιαφεθ",706462,6]],"And Noe begot three sons, Sem, Cham, Japheth."],["11",[["ἐφθάρη",713445,37],["δὲ",703303,11],["ἡ",709436,10],["γῆ",703083,12],["ἐναντίον",704654,0],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["ἐπλήσθη",710532,37],["ἡ",709436,10],["γῆ",703083,12],["ἀδικίας",700271,17]],"But the earth was corrupted before God, and the earth was filled with iniquity."],["12",[["καὶ",707031,7],["εἶδεν",709725,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἦν",704093,13],["κατεφθαρμένη",707474,203],["ὅτι",709803,7],["κατέφθειρεν",707474,13],["πᾶσα",710177,29],["σὰρξ",711537,12],["τὴν",709436,8],["ὁδὸν",709458,9],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"And the Lord God saw the earth, and it was corrupted; because all flesh had corrupted its way upon the earth."],["13",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["θεὸς",706192,4],["πρὸς",710844,0],["Νωε",709395,6],["καιρὸς",707047,4],["παντὸς",710177,116],["ἀνθρώπου",701163,18],["ἥκει",705956,91],["ἐναντίον",704654,0],["μου",709032,133],["ὅτι",709803,7],["ἐπλήσθη",710532,37],["ἡ",709436,10],["γῆ",703083,12],["ἀδικίας",700271,17],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["καταφθείρω",707474,157],["αὐτοὺς",702165,62],["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9]],"And the Lord God said to Noe, A period of all men is come before me; because the earth has been filled with iniquity by them, and, behold, I destroy them and the earth."],["14",[["ποίησον",710582,176],["οὖν",709835,11],["σεαυτῷ",711599,50],["κιβωτὸν",707667,9],["ἐκ",704132,0],["ξύλων",709427,44],["τετραγώνων",712812,83],["νοσσιὰς",709360,39],["ποιήσεις",710582,166],["τὴν",709436,8],["κιβωτὸν",707667,9],["καὶ",707031,7],["ἀσφαλτώσεις",702044,166],["αὐτὴν",702165,104],["ἔσωθεν",705523,28],["καὶ",707031,7],["ἔξωθεν",704984,28],["τῇ",709436,100],["ἀσφάλτῳ",702043,1]],"Make therefore for thyself an ark of square timber; thou shalt make the ark in compartments, and thou shalt pitch it within and without with pitch."],["15",[["καὶ",707031,7],["οὕτως",709859,28],["ποιήσεις",710582,166],["τὴν",709436,8],["κιβωτόν",707667,9],["τριακοσίων",712936,169],["πήχεων",710462,81],["τὸ",709436,24],["μῆκος",708868,25],["τῆς",709436,16],["κιβωτοῦ",707667,17],["καὶ",707031,7],["πεντήκοντα",710270,59],["πήχεων",710462,81],["τὸ",709436,24],["πλάτος",710507,25],["καὶ",707031,7],["τριάκοντα",712934,59],["πήχεων",710462,81],["τὸ",709436,24],["ὕψος",713288,25],["αὐτῆς",702165,86]],"And thus shalt thou make the ark; three hundred cubits the length of the ark, and fifty cubits the breadth, and thirty cubits the height of it."],["16",[["ἐπισυνάγων",705280,72],["ποιήσεις",710582,166],["τὴν",709436,8],["κιβωτὸν",707667,9],["καὶ",707031,7],["εἰς",704105,0],["πῆχυν",710462,6],["συντελέσεις",712510,166],["αὐτὴν",702165,104],["ἄνωθεν",701298,28],["τὴν",709436,8],["δὲ",703303,11],["θύραν",706337,9],["τῆς",709436,16],["κιβωτοῦ",707667,17],["ποιήσεις",710582,166],["ἐκ",704132,0],["πλαγίων",710493,169],["κατάγαια",707219,68],["διώροφα",703769,68],["καὶ",707031,7],["τριώροφα",712973,68],["ποιήσεις",710582,166],["αὐτήν",702165,104]],"Thou shalt narrow the ark in making it, and in a cubit above thou shalt finish it, and the door of the ark thou shalt make on the side; with lower, second, and third stories thou shalt make it."],["17",[["ἐγὼ",704018,164],["δὲ",703303,11],["ἰδοὺ",706497,88],["ἐπάγω",704994,157],["τὸν",709436,5],["κατακλυσμὸν",707279,6],["ὕδωρ",713071,25],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["καταφθεῖραι",707474,106],["πᾶσαν",710177,36],["σάρκα",711537,9],["ἐν",704639,0],["ᾗ",709781,108],["ἐστιν",704093,91],["πνεῦμα",710566,15],["ζωῆς",705910,17],["ὑποκάτω",713204,0],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["ὅσα",709788,68],["ἐὰν",703912,7],["ᾖ",704093,204],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["τελευτήσει",712781,127]],"And behold I bring a flood of water upon the earth, to destroy all flesh in which is the breath of life under heaven, and whatsoever things are upon the earth shall die."],["18",[["καὶ",707031,7],["στήσω",706846,165],["τὴν",709436,8],["διαθήκην",703456,9],["μου",709032,133],["πρὸς",710844,0],["σέ",711598,163],["εἰσελεύσῃ",704114,123],["δὲ",703303,11],["εἰς",704105,0],["τὴν",709436,8],["κιβωτόν",707667,9],["σὺ",712181,164],["καὶ",707031,7],["οἱ",709436,136],["υἱοί",713075,52],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["γυνή",703209,12],["σου",711945,133],["καὶ",707031,7],["αἱ",709436,190],["γυναῖκες",703209,191],["τῶν",709436,80],["υἱῶν",713075,81],["σου",711945,133],["μετὰ",708780,0],["σοῦ",711945,133]],"And I will establish my covenant with thee, and thou shalt enter into the ark, and thy sons and thy wife, and thy sons' wives with thee."],["19",[["καὶ",707031,7],["ἀπὸ",701425,0],["πάντων",710177,83],["τῶν",709436,43],["κτηνῶν",707934,44],["καὶ",707031,7],["ἀπὸ",701425,0],["πάντων",710177,83],["τῶν",709436,43],["ἑρπετῶν",705441,44],["καὶ",707031,7],["ἀπὸ",701425,0],["πάντων",710177,83],["τῶν",709436,43],["θηρίων",706252,44],["καὶ",707031,7],["ἀπὸ",701425,0],["πάσης",710177,82],["σαρκός",711537,17],["δύο",703849,59],["δύο",703849,59],["ἀπὸ",701425,0],["πάντων",710177,169],["εἰσάξεις",704107,166],["εἰς",704105,0],["τὴν",709436,8],["κιβωτόν",707667,9],["ἵνα",706747,7],["τρέφῃς",712930,205],["μετὰ",708780,0],["σεαυτοῦ",711599,102],["ἄρσεν",701818,26],["καὶ",707031,7],["θῆλυ",706237,26],["ἔσονται",704093,135]],"And of all cattle and of all reptiles and of all wild beasts, even of all flesh, thou shalt bring by pairs of all, into the ark, that thou mayest feed them with thyself: male and female they shall be."],["20",[["ἀπὸ",701425,0],["πάντων",710177,169],["τῶν",709436,43],["ὀρνέων",709762,44],["τῶν",709436,43],["πετεινῶν",710438,44],["κατὰ",707200,0],["γένος",703057,25],["καὶ",707031,7],["ἀπὸ",701425,0],["πάντων",710177,83],["τῶν",709436,43],["κτηνῶν",707934,44],["κατὰ",707200,0],["γένος",703057,25],["καὶ",707031,7],["ἀπὸ",701425,0],["πάντων",710177,83],["τῶν",709436,43],["ἑρπετῶν",705441,44],["τῶν",709436,43],["ἑρπόντων",705442,84],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["κατὰ",707200,0],["γένος",703057,25],["αὐτῶν",702165,70],["δύο",703849,59],["δύο",703849,59],["ἀπὸ",701425,0],["πάντων",710177,83],["εἰσελεύσονται",704114,135],["πρὸς",710844,0],["σὲ",711598,163],["τρέφεσθαι",712930,110],["μετὰ",708780,0],["σοῦ",711945,133],["ἄρσεν",701818,46],["καὶ",707031,7],["θῆλυ",706237,46]],"Of all winged birds after their kind, and of all cattle after their kind, and of all reptiles creeping upon the earth after their kind, pairs of all shall come in to thee, male and female to be fed with thee."],["21",[["σὺ",712181,164],["δὲ",703303,11],["λήμψῃ",708076,123],["σεαυτῷ",711599,50],["ἀπὸ",701425,0],["πάντων",710177,83],["τῶν",709436,43],["βρωμάτων",702823,44],["ἃ",709781,69],["ἔδεσθε",705495,124],["καὶ",707031,7],["συνάξεις",712375,166],["πρὸς",710844,0],["σεαυτόν",711599,85],["καὶ",707031,7],["ἔσται",704093,93],["σοὶ",711925,159],["καὶ",707031,7],["ἐκείνοις",704183,206],["φαγεῖν",705495,106]],"And thou shalt take to thyself of all kinds of food which ye eat, and thou shalt gather them to thyself, and it shall be for thee and them to eat."],["22",[["καὶ",707031,7],["ἐποίησεν",710582,2],["Νωε",709395,4],["πάντα",710177,68],["ὅσα",709788,68],["ἐνετείλατο",704791,23],["αὐτῷ",702165,50],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["οὕτως",709859,28],["ἐποίησεν",710582,2]],"And Noe did all things whatever the Lord God commanded him, so did he."]]