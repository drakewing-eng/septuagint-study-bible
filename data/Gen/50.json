[["1",[["καὶ",707031,7],["ἐπιπεσὼν",705225,182],["Ιωσηφ",706948,4],["ἐπὶ",705080,0],["τὸ",709436,24],["πρόσωπον",710986,25],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["ἔκλαυσεν",707703,2],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐφίλησεν",713471,2],["αὐτόν",702165,85]],"And Joseph fell upon his father's face, and wept on him, and kissed him."],["2",[["καὶ",707031,7],["προσέταξεν",710962,2],["Ιωσηφ",706948,4],["τοῖς",709436,147],["παισὶν",709932,148],["αὐτοῦ",702165,102],["τοῖς",709436,147],["ἐνταφιασταῖς",704789,148],["ἐνταφιάσαι",704788,106],["τὸν",709436,5],["πατέρα",710189,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐνεταφίασαν",704788,150],["οἱ",709436,136],["ἐνταφιασταὶ",704789,52],["τὸν",709436,5],["Ισραηλ",706839,6]],"And Joseph commanded his servants the embalmers to embalm his father; and the embalmers embalmed Israel."],["3",[["καὶ",707031,7],["ἐπλήρωσαν",710543,150],["αὐτοῦ",702165,102],["τεσσαράκοντα",712806,59],["ἡμέρας",705984,39],["οὕτως",709859,28],["γὰρ",702963,11],["καταριθμοῦνται",707402,269],["αἱ",709436,190],["ἡμέραι",705984,191],["τῆς",709436,16],["ταφῆς",712736,9],["καὶ",707031,7],["ἐπένθησεν",710251,2],["αὐτὸν",702165,85],["Αἴγυπτος",700401,12],["ἑβδομήκοντα",703922,59],["ἡμέρας",705984,39]],"And they fulfilled forty days for him, for so are the days of embalming numbered; and Egypt mourned for him seventy days."],["4",[["ἐπειδὴ",705056,7],["δὲ",703303,11],["παρῆλθον",710141,150],["αἱ",709436,190],["ἡμέραι",705984,191],["τοῦ",709436,20],["πένθους",710253,21],["ἐλάλησεν",708071,2],["Ιωσηφ",706948,4],["πρὸς",710844,0],["τοὺς",709436,58],["δυνάστας",703844,57],["Φαραω",713360,18],["λέγων",708124,72],["εἰ",704071,7],["εὗρον",705676,155],["χάριν",713735,9],["ἐναντίον",704654,0],["ὑμῶν",713091,145],["λαλήσατε",708071,74],["περὶ",710285,0],["ἐμοῦ",704580,133],["εἰς",704105,0],["τὰ",709436,41],["ὦτα",709852,42],["Φαραω",713360,18],["λέγοντες",708124,146]],"And when the days of mourning were past, Joseph spoke to the princes of Pharao, saying, If I have found favour in your sight, speak concerning me in the ears of Pharao, saying,"],["5",[["ὁ",709436,3],["πατήρ",710189,4],["μου",709032,133],["ὥρκισέν",709751,2],["με",708618,163],["λέγων",708124,72],["ἐν",704639,0],["τῷ",709436,53],["μνημείῳ",708963,54],["ᾧ",709781,209],["ὤρυξα",709775,155],["ἐμαυτῷ",704545,50],["ἐν",704639,0],["γῇ",703083,1],["Χανααν",713708,184],["ἐκεῖ",704181,28],["με",708618,163],["θάψεις",706103,166],["νῦν",709384,28],["οὖν",709835,11],["ἀναβὰς",700905,182],["θάψω",706103,165],["τὸν",709436,5],["πατέρα",710189,6],["μου",709032,133],["καὶ",707031,7],["ἐπανελεύσομαι",705023,181]],"My father adjured me, saying, In the sepulchre which I dug for myself in the land of Chanaan, there thou shalt bury me; now then I will go up and bury my father, and return again."],["6",[["καὶ",707031,7],["εἶπεν",705373,2],["Φαραω",713360,4],["ἀνάβηθι",700905,176],["θάψον",706103,176],["τὸν",709436,5],["πατέρα",710189,6],["σου",711945,133],["καθάπερ",706984,28],["ὥρκισέν",709751,2],["σε",711598,163]],"And Pharao said to Joseph, Go up, bury thy father, as he constrained thee to swear."],["7",[["καὶ",707031,7],["ἀνέβη",700905,2],["Ιωσηφ",706948,4],["θάψαι",706103,106],["τὸν",709436,5],["πατέρα",710189,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["συνανέβησαν",712384,150],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["πάντες",710177,138],["οἱ",709436,136],["παῖδες",709932,52],["Φαραω",713360,18],["καὶ",707031,7],["οἱ",709436,136],["πρεσβύτεροι",710735,267],["τοῦ",709436,35],["οἴκου",709516,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["πρεσβύτεροι",710735,267],["τῆς",709436,16],["γῆς",703083,17],["Αἰγύπτου",700401,17]],"So Joseph went up to bury his father; and all the servants of Pharao went up with him, and the elders of his house, and all the elders of the land of Egypt."],["8",[["καὶ",707031,7],["πᾶσα",710177,29],["ἡ",709436,10],["πανοικία",709967,12],["Ιωσηφ",706948,18],["καὶ",707031,7],["οἱ",709436,136],