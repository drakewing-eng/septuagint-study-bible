μέγα",708653,26],["τοῦτό",709858,132],["ἐστιν",704093,91],["τοῖς",709436,147],["Αἰγυπτίοις",700400,148],["διὰ",703417,0],["τοῦτο",709858,129],["ἐκάλεσεν",707084,2],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["Πένθος",710253,15],["Αἰγύπτου",700401,17],["ὅ",709781,33],["ἐστιν",704093,91],["πέραν",710280,0],["τοῦ",709436,35],["Ιορδάνου",706763,18]],"And the inhabitants of the land of Chanaan saw the mourning at the floor of Atad, and said, This is a great mourning to the Egyptians; therefore he called its name, The mourning of Egypt, which is beyond Jordan."],["12",[["καὶ",707031,7],["ἐποίησαν",710582,150],["αὐτῷ",702165,50],["οὕτως",709859,28],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔθαψαν",706103,150],["αὐτὸν",702165,85],["ἐκεῖ",704181,28]],"And thus his sons did to him."],["13",[["καὶ",707031,7],["ἀνέλαβον",700984,150],["αὐτὸν",702165,85],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτοῦ",702165,102],["εἰς",704105,0],["γῆν",703083,9],["Χανααν",713708,184],["καὶ",707031,7],["ἔθαψαν",706103,150],["αὐτὸν",702165,85],["εἰς",704105,0],["τὸ",709436,24],["σπήλαιον",712012,25],["τὸ",709436,24],["διπλοῦν",703740,46],["ὃ",709781,128],["ἐκτήσατο",707932,23],["Αβρααμ",700091,4],["τὸ",709436,24],["σπήλαιον",712012,25],["ἐν",704639,0],["κτήσει",707937,1],["μνημείου",708963,21],["παρὰ",709995,0],["Εφρων",705770,18],["τοῦ",709436,35],["Χετταίου",713838,18],["κατέναντι",707507,0],["Μαμβρη",708455,118]],"So his sons carried him up into the land of Chanaan, and buried him in the double cave, which cave Abraam bought for possession of a burying place, of Ephrom the Chettite, before Mambre."],["14",[["καὶ",707031,7],["ἀπέστρεψεν",701598,2],["Ιωσηφ",706948,4],["εἰς",704105,0],["Αἴγυπτον",700401,9],["αὐτὸς",702165,121],["καὶ",707031,7],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["οἱ",709436,136],["συναναβάντες",712384,196],["θάψαι",706103,106],["τὸν",709436,5],["πατέρα",710189,6],["αὐτοῦ",702165,102]],"And Joseph returned to Egypt, he and his brethren, and those that had gone up with him to bury his father."],["15",[["ἰδόντες",709725,196],["δὲ",703303,11],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["Ιωσηφ",706948,18],["ὅτι",709803,7],["τέθνηκεν",706278,171],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτῶν",702165,40],["εἶπαν",705373,150],["μήποτε",708882,28],["μνησικακήσῃ",708967,172],["ἡμῖν",705994,90],["Ιωσηφ",706948,4],["καὶ",707031,7],["ἀνταπόδομα",701216,25],["ἀνταποδῷ",701215,172],["ἡμῖν",705994,90],["πάντα",710177,68],["τὰ",709436,41],["κακά",707066,68],["ἃ",709781,69],["ἐνεδειξάμεθα",704673,316],["αὐτῷ",702165,50]],"And when the brethren of Joseph saw that their father was dead, they said, [Let us take heed], lest at any time Joseph remember evil against us, and recompense to us all the evils which we have done against him."],["16",[["καὶ",707031,7],["παρεγένοντο",710006,189],["πρὸς",710844,0],["Ιωσηφ",706948,6],["λέγοντες",708124,146],["ὁ",709436,3],["πατήρ",710189,4],["σου",711945,133],["ὥρκισεν",709751,2],["πρὸ",710747,0],["τοῦ",709436,20],["τελευτῆσαι",712781,106],["αὐτὸν",702165,85],["λέγων",708124,72]],"And they came to Joseph, and said, Thy father adjured [us] before his death, saying,"],["17",[["οὕτως",709859,28],["εἴπατε",705373,265],["Ιωσηφ",706948,114],["ἄφες",702211,176],["αὐτοῖς",702165,151],["τὴν",709436,8],["ἀδικίαν",700271,9],["καὶ",707031,7],["τὴν",709436,8],["ἁμαρτίαν",700775,9],["αὐτῶν",702165,40],["ὅτι",709803,7],["πονηρά",710660,68],["σοι",711925,159],["ἐνεδείξαντο",704673,189],["καὶ",707031,7],["νῦν",709384,28],["δέξαι",703393,300],["τὴν",709436,8],["ἀδικίαν",700271,9],["τῶν",709436,80],["θεραπόντων",706201,81],["τοῦ",709436,35],["θεοῦ",706192,18],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["καὶ",707031,7],["ἔκλαυσεν",707703,2],["Ιωσηφ",706948,4],["λαλούντων",708071,170],["αὐτῶν",702165,40],["πρὸς",710844,0],["αὐτόν",702165,85]],"Thus say ye to Joseph, Forgive them their injustice and their sin, forasmuch as they have done thee evil; and now pardon the injustice of the servants of the God of thy father. And Joseph wept while they spoke to him."],["18",[["καὶ",707031,7],["ἐλθόντες",705453,196],["πρὸς",710844,0],["αὐτὸν",702165,85],["εἶπαν",705373,150],["οἵδε",709446,250],["ἡμεῖς",705983,219],["σοι",711925,159],["οἰκέται",709496,52]],"And they came to him and said, We, these [persons], are thy servants."],["19",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["Ιωσηφ",706948,4],["μὴ",708851,28],["φοβεῖσθε",713532,374],["τοῦ",709436,35],["γὰρ",702963,11],["θεοῦ",706192,18],["εἰμι",704093,157],["ἐγώ",704018,164]],"And Joseph said to them, Fear not, for I am God's."],["20",[["ὑμεῖς",713081,219],["ἐβουλεύσασθε",702791,345],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["εἰς",704105,0],["πονηρά",710660,68],["ὁ",709436,3],["δὲ",703303,11],["θεὸς",706192,4],["ἐβουλεύσατο",702791,23],["περὶ",710285,0],["ἐμοῦ",704580,133],["εἰς",704105,0],["ἀγαθά",700106,68],["ὅπως",709719,7],["ἂν",700900,11],["γενηθῇ",703104,384],["ὡς",714148,7],["σήμερον",711751,28],["ἵνα",706747,7],["διατραφῇ",703613,384],["λαὸς",708094,4],["πολύς",710646,14]],"Ye took counsel against me for evil, but God took counsel for me for good, that [the matter] might be as [it is] to-day, and much people might be fed."],["21",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["μὴ",708851,28],["φοβεῖσθε",713532,374],["ἐγὼ",704018,164],["διαθρέψω",703613,165],["ὑμᾶς",713080,194],["καὶ",707031,7],["τὰς",709436,38],["οἰκίας",709505,39],["ὑμῶν",713091,145],["καὶ",707031,7],["παρεκάλεσεν",710039,2],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἐλάλησεν",708071,2],["αὐτῶν",702165,40],["εἰς",704105,0],["τὴν",709436,8],["καρδίαν",707141,9]],"And he said to them, Fear not, I will maintain you, and your families: and he comforted them, and spoke kindly to them."],["22",[["καὶ",707031,7],["κατῴκησεν",707534,2],["Ιωσηφ",706948,4],["ἐν",704639,0],["Αἰγύπτῳ",700401,1],["αὐτὸς",702165,121],["καὶ",707031,7],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["πᾶσα",710177,29],["ἡ",709436,10],["πανοικία",709967,12],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔζησεν",705851,2],["Ιωσηφ",706948,4],["ἔτη",705543,42],["ἑκατὸν",704136,59],["δέκα",703333,59]],"And Joseph dwelt in Egypt, he and his brethren, and all the family of his father; and Joseph lived a hundred and ten years."],["23",[["καὶ",707031,7],["εἶδεν",709725,2],["Ιωσηφ",706948,4],["Εφραιμ",705769,18],["παιδία",709927,42],["ἕως",705792,0],["τρίτης",712968,82],["γενεᾶς",703037,17],["καὶ",707031,7],["υἱοὶ",713075,52],["Μαχιρ",708604,18],["τοῦ",709436,35],["υἱοῦ",713075,18],["Μανασση",708470,18],["ἐτέχθησαν",712853,99],["ἐπὶ",705080,0],["μηρῶν",708885,81],["Ιωσηφ",706948,18]],"And Joseph saw the children of Ephraim to the third generation; and the sons of Machir the son of Manasse were borne on the sides of Joseph."],["24",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιωσηφ",706948,4],["τοῖς",709436,147],["ἀδελφοῖς",700249,148],["αὐτοῦ",702165,102],["λέγων",708124,72],["ἐγὼ",704018,164],["ἀποθνῄσκω",701461,157],["ἐπισκοπῇ",705255,1],["δὲ",703303,11],["ἐπισκέψεται",705250,93],["ὑμᾶς",713080,194],["ὁ",709436,3],["θεὸς",706192,4],["καὶ",707031,7],["ἀνάξει",700933,127],["ὑμᾶς",713080,194],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17],["ταύτης",709858,86],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["ὤμοσεν",709620,2],["ὁ",709436,3],["θεὸς",706192,4],["τοῖς",709436,147],["πατράσιν",710189,148],["ἡμῶν",705999,145],["Αβρααμ",700091,114],["καὶ",707031,7],["Ισαακ",706799,114],["καὶ",707031,7],["Ιακωβ",706401,114]],"And Joseph spoke to his brethren, saying, I die, and God will surely visit you, and will bring you out of this land to the land concerning which God sware to our fathers, Abraam, Isaac, and Jacob."],["25",[["καὶ",707031,7],["ὥρκισεν",709751,2],["Ιωσηφ",706948,4],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ισραηλ",706839,18],["λέγων",708124,72],["ἐν",704639,0],["τῇ",709436,100],["ἐπισκοπῇ",705255,1],["ᾗ",709781,108],["ἐπισκέψεται",705250,93],["ὑμᾶς",713080,194],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["συνανοίσετε",712392,337],["τὰ",709436,41],["ὀστᾶ",709792,42],["μου",709032,133],["ἐντεῦθεν",704793,28],["μεθ᾿",708780,0],["ὑμῶν",713091,145]],"And Joseph adjured the sons of Israel, saying, At the visitation with which God shall visit you, then ye shall carry up my bones hence with you."],["26",[["καὶ",707031,7],["ἐτελεύτησεν",712781,2],["Ιωσηφ",706948,4],["ἐτῶν",705543,44],["ἑκατὸν",704136,59],["δέκα",703333,59],["καὶ",707031,7],["ἔθαψαν",706103,150],["αὐτὸν",702165,85],["καὶ",707031,7],["ἔθηκαν",712849,150],["ἐν",704639,0],["τῇ",709436,100],["σορῷ",711942,1],["ἐν",704639,0],["Αἰγύπτῳ",700401,1]],"And Joseph died, aged an hundred and ten years; and they prepared his corpse, and put him in a coffin in Egypt."]]