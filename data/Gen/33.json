[["1",[["ἀναβλέψας",700913,182],["δὲ",703303,11],["Ιακωβ",706401,4],["εἶδεν",709725,2],["καὶ",707031,7],["ἰδοὺ",706497,88],["Ησαυ",706030,4],["ὁ",709436,3],["ἀδελφὸς",700249,4],["αὐτοῦ",702165,102],["ἐρχόμενος",705453,122],["καὶ",707031,7],["τετρακόσιοι",712817,138],["ἄνδρες",701150,52],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπιδιεῖλεν",705120,2],["Ιακωβ",706401,4],["τὰ",709436,41],["παιδία",709927,42],["ἐπὶ",705080,0],["Λειαν",708127,9],["καὶ",707031,7],["Ραχηλ",711208,9],["καὶ",707031,7],["τὰς",709436,38],["δύο",703849,59],["παιδίσκας",709928,39]],"And Jacob lifted up his eyes, and beheld, and lo! Esau his brother coming, and four hundred men with him; and Jacob divided the children to Lea and to Rachel, and the two handmaidens."],["2",[["καὶ",707031,7],["ἐποίησεν",710582,2],["τὰς",709436,38],["δύο",703849,59],["παιδίσκας",709928,39],["καὶ",707031,7],["τοὺς",709436,58],["υἱοὺς",713075,57],["αὐτῶν",702165,40],["ἐν",704639,0],["πρώτοις",711041,343],["καὶ",707031,7],["Λειαν",708127,9],["καὶ",707031,7],["τὰ",709436,41],["παιδία",709927,42],["αὐτῆς",702165,86],["ὀπίσω",709697,0],["καὶ",707031,7],["Ραχηλ",711208,9],["καὶ",707031,7],["Ιωσηφ",706948,6],["ἐσχάτους",705519,60]],"And he put the two handmaidens and their children with the first, and Lea and her children behind, and Rachel and Joseph last."],["3",[["αὐτὸς",702165,121],["δὲ",703303,11],["προῆλθεν",710789,2],["ἔμπροσθεν",704618,0],["αὐτῶν",702165,40],["καὶ",707031,7],["προσεκύνησεν",710925,2],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["ἑπτάκις",705362,28],["ἕως",705792,0],["τοῦ",709436,20],["ἐγγίσαι",703939,106],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["αὐτοῦ",702165,102]],"But he advanced himself before them, and did reverence to the ground seven times, until he drew near to his brother."],["4",[["καὶ",707031,7],["προσέδραμεν",710967,2],["Ησαυ",706030,4],["εἰς",704105,0],["συνάντησιν",712397,9],["αὐτῷ",702165,50],["καὶ",707031,7],["περιλαβὼν",710342,182],["αὐτὸν",702165,85],["ἐφίλησε