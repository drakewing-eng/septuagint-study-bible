[["1",[["ἐκάλεσεν",707084,2],["δὲ",703303,11],["Ιακωβ",706401,4],["τοὺς",709436,58],["υἱοὺς",713075,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["συνάχθητε",712375,394],["ἵνα",706747,7],["ἀναγγείλω",700921,207],["ὑμῖν",713084,90],["τί",712867,273],["ἀπαντήσει",701345,127],["ὑμῖν",713084,90],["ἐπ᾿",705080,0],["ἐσχάτων",705519,169],["τῶν",709436,80],["ἡμερῶν",705984,65]],"And Jacob called his sons, and said to them, Assemble yourselves, that I may tell you what shall happen to you in the last days."],["2",[["ἀθροίσθητε",700384,372],["καὶ",707031,7],["ἀκούσατε",700587,74],["υἱοὶ",713075,52],["Ιακωβ",706401,18],["ἀκούσατε",700587,74],["Ισραηλ",706839,18],["τοῦ",709436,35],["πατρὸς",710189,18],["ὑμῶν",713091,145]],"Gather yourselves together, and hear me, sons of Jacob; hear Israel, hear your father."],["3",[["Ρουβην",711295,153],["πρωτότοκός",711046,14],["μου",709032,133],["σύ",712181,164],["ἰσχύς",706858,12],["μου",709032,133],["καὶ",707031,7],["ἀρχὴ",701836,12],["τέκνων",712761,44],["μου",709032,133],["σκληρὸς",711861,14],["φέρεσθαι",713428,395],["καὶ",707031,7],["σκληρὸς",711861,14],["αὐθάδης",702125,14]],"Ruben, thou [art] my first-born, thou my strength, and the first of my children, hard to be endured, [hard and] self-willed."],["4",[["ἐξύβρισας",704977,182],["ὡς",714148,7],["ὕδωρ",713071,15],["μὴ",708851,28],["ἐκζέσῃς",704186,175],["ἀνέβης",700905,162],["γὰρ",702963,11],["ἐπὶ",705080,0],["τὴν",709436,8],["κοίτην",707781,9],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["τότε",712908,28],["ἐμίανας",708900,162],["τὴν",709436,8],["στρωμνήν",712174,9],["οὗ",709806,28],["ἀνέβης",700905,162]],"Thou wast insolent like water, burst not forth with violence, for thou wentest up to the bed of thy father; then thou defiledst the couch, whereupon thou wentest up."],["5",[["Συμεων",712297,4],["καὶ",707031,7],["Λευι",708158,4],["ἀδελφοί",700249,52],["συνετέλεσαν",712510,150],["ἀδικίαν",700271,9],["ἐξ",704132,0],["αἱρέσεως",700468,17],["αὐτῶν",702165,40]],"Symeon and Levi, brethren, accomplished the injustice of their cutting off."],["6",[["εἰς",704105,0],["βουλὴν",702792,9],["αὐτῶν",702165,40],["μὴ",708851,28],["ἔλθοι",705453,225],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["καὶ",707031,7],["ἐπὶ",705080,0],["τῇ",709436,100],["συστάσει",712557,1],["αὐτῶν",702165,40],["μὴ",708851,28],["ἐρείσαι",705405,225],["τὰ",709436,41],["ἥπατά",706012,42],["μου",709032,133],["ὅτι",709803,7],["ἐν",704639,0],["τῷ",709436,113],["θυμῷ",706334,114],["αὐτῶν",702165,40],["ἀπέκτειναν",701498,150],["ἀνθρώπους",701163,57],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["ἐπιθυμίᾳ",705147,1],["αὐτῶν",702165,40],["ἐνευροκόπησαν",709274,150],["ταῦρον",712734,6]],"Let not my soul come into their counsel, and let not mine inward parts contend in their conspiracy, for in their wrath they slew men, and in their passion they houghed a bull."],["7",[["ἐπικατάρατος",705159,14],["ὁ",709436,3],["θυμὸς",706334,4],["αὐτῶν",702165,40],["ὅτι",709803,7],["αὐθάδης",702125,14],["καὶ",707031,7],["ἡ",709436,10],["μῆνις",708878,12],["αὐτῶν",702165,40],["ὅτι",709803,7],["ἐσκληρύνθη",711864,37],["διαμεριῶ",703518,165],["αὐτοὺς",702165,62],["ἐν",704639,0],["Ιακωβ",706401,114],["καὶ",707031,7],["διασπερῶ",703584,165],["αὐτοὺς",702165,62],["ἐν",704639,0],["Ισραηλ",706839,114]],"Cursed be their wrath, for it was wilful, and their anger, for it was cruel: I will divide them in Jacob, and scatter them in Israel."],["8",[["Ιουδα",706768,153],["σὲ",711598,163],["αἰνέσαισαν",700459,396],["οἱ",709436,136],["ἀδελφοί",700249,52],["σου",711945,133],["αἱ",709436,190],["χεῖρές",713787,191],["σου",711945,133],["ἐπὶ",705080,0],["νώτου",709403,21],["τῶν",709436,80],["ἐχθρῶν",705779,81],["σου",711945,133],["προσκυνήσουσίν",710925,218],["σοι",711925,159],["οἱ",709436,136],["υἱοὶ",713075,52],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133]],"Juda, thy brethren have praised thee, and thy hands shall be on the back of thine enemies; thy father's sons shall do thee reverence."],["9",[["σκύμνος",711903,4],["λέοντος",708171,18],["Ιουδα",706768,4],["ἐκ",704132,0],["βλαστοῦ",702736,18],["υἱέ",713075,153],["μου",709032,133],["ἀνέβης",700905,162],["ἀναπεσὼν",701033,182],["ἐκοιμήθης",707767,168],["ὡς",714148,7],["λέων",708171,4],["καὶ",707031,7],["ὡς",714148,7],["σκύμνος",711903,4],["τίς",712867,158],["ἐγερεῖ",703949,127],["αὐτόν",702165,85]],"Juda is a lion's whelp: from the tender plant, my son, thou art gone up, having couched thou liest as a lion, and as a whelp; who shall stir him up?"],["10",[["οὐκ",709805,28],["ἐκλείψει",704237,127],["ἄρχων",701862,4],["ἐξ",704132,0],["Ιουδα",706768,18],["καὶ",707031,7],["ἡγούμενος",705931,122],["ἐκ",704132,0],["τῶν",709436,80],["μηρῶν",708885,81],["αὐτοῦ",702165,102],["ἕως",705792,7],["ἂν",700900,11],["ἔλθῃ",705453,172],["τὰ",709436,63],["ἀποκείμενα",701476,210],["αὐτῷ",702165,50],["καὶ",707031,7],["αὐτὸς",702165,121],["προσδοκία",710877,12],["ἐθνῶν",704068,44]],"A ruler shall not fail from Juda, nor a prince from his loins, until there come the things stored up for him; and he is the expectation of nations."],["11",[["δεσμεύων",703369,72],["πρὸς",710844,0],["ἄμπελον",700870,9],["τὸν",709436,5],["πῶλον",711117,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["τῇ",709436,100],["ἕλικι",704476,1],["τὸν",709436,5],["πῶλον",711117,6],["τῆς",709436,16],["ὄνου",709671,17],["αὐτοῦ",702165,102],["πλυνεῖ",710564,127],["ἐν",704639,0],["οἴνῳ",709530,114],["τὴν",709436,8],["στολὴν",712120,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["αἵματι",700442,54],["σταφυλῆς",712052,17],["τὴν",709436,8],["περιβολὴν",710301,9],["αὐτοῦ",702165,102]],"Binding his foal to the vine, and the foal of his ass to the branch [of it], he shall wash his robe in wine, and his garment in the blood of the grape."],["12",[["χαροποὶ",713748,138],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["οἴνου",709530,18],["καὶ",707031,7],["λευκοὶ",708165,138],["οἱ",709436,136],["ὀδόντες",709461,52],["αὐτοῦ",702165,102],["ἢ",705924,7],["γάλα",702919,15]],"His eyes shall be more cheering than wine, and his teeth whiter than milk."],["13",[["Ζαβουλων",705813,4],["παράλιος",710063,14],["κατοικήσει",707534,127],["καὶ",707031,7],["αὐτὸς",702165,121],["παρ᾿",709995,0],["ὅρμον",709759,6],["πλοίων",710556,44],["καὶ",707031,7],["παρατενεῖ",710109,127],["ἕως",705792,0],["Σιδῶνος",711775,118]],"Zabulon shall dwell on the coast, and he [shall be] by a haven of ships, and shall extend to Sidon."],["14",[["Ισσαχαρ",706843,4],["τὸ",709436,24],["καλὸν",707097,46],["ἐπεθύμησεν",705141,2],["ἀναπαυόμενος",701027,122],["ἀνὰ",700902,0],["μέσον",708768,27],["τῶν",709436,80],["κλήρων",707727,81]],"Issachar has desired that which is good; resting between the inheritances."],["15",[["καὶ",707031,7],["ἰδὼν",709725,182],["τὴν",709436,8],["ἀνάπαυσιν",701026,9],["ὅτι",709803,7],["καλή",707097,29],["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9],["ὅτι",709803,7],["πίων",710491,4],["ὑπέθηκεν",713251,2],["τὸν",709436,5],["ὦμον",714114,6],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὸ",709436,24],["πονεῖν",710656,106],["καὶ",707031,7],["ἐγενήθη",703104,37],["ἀνὴρ",701150,4],["γεωργός",703082,4]],"And having seen the resting place that it was good, and the land that it was fertile, he subjected his shoulder to labour, and became a husbandman."],["16",[["Δαν",703276,4],["κρινεῖ",707905,127],["τὸν",709436,5],["ἑαυτοῦ",703917,102],["λαὸν",708094,6],["ὡσεὶ",714159,28],["καὶ",707031,7],["μία",704106,29],["φυλὴ",713620,12],["ἐν",704639,0],["Ισραηλ",706839,114]],"Dan shall judge his people, as one tribe too in Israel."],["17",[["καὶ",707031,7],["γενηθήτω",703104,22],["Δαν",703276,397],["ὄφις",709875,4],["ἐφ᾿",705080,0],["ὁδοῦ",709458,17],["ἐγκαθήμενος",703952,122],["ἐπὶ",705080,0],["τρίβου",712939,18],["δάκνων",703254,72],["πτέρναν",711050,9],["ἵππου",706790,18],["καὶ",707031,7],["πεσεῖται",710481,93],["ὁ",709436,3],["ἱππεὺς",706786,4],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,28]],"And let Dan be a serpent in the way, besetting the path, biting the heel of the horse (and the rider shall fall backward),"],["18",[["τὴν",709436,8],["σωτηρίαν",712658,9],["περιμένω",710348,157],["κυρίου",707996,18]],"waiting for the salvation of the Lord."],["19",[["Γαδ",702872,153],["πειρατήριον",710228,15],["πειρατεύσει",710227,127],["αὐτόν",702165,85],["αὐτὸς",702165,121],["δὲ",703303,11],["πειρατεύσει",710227,127],["αὐτῶν",702165,40],["κατὰ",707200,0],["πόδας",710707,57]],"Gad, a plundering troop shall plunder him; but he shall plunder him, [pursuing him] closely."],["20",[["Ασηρ",701934,4],["πίων",710491,4],["αὐτοῦ",702165,102],["ὁ",709436,3],["ἄρτος",701829,4],["καὶ",707031,7],["αὐτὸς",702165,121],["δώσει",703654,127],["τρυφὴν",713008,9],["ἄρχουσιν",701862,148]],"Aser, his bread [shall be] fat; and he shall yield dainties to princes."],["21",[["Νεφθαλι",709279,4],["στέλεχος",712062,15],["ἀνειμένον",701169,327],["ἐπιδιδοὺς",705121,72],["ἐν",704639,0],["τῷ",709436,53],["γενήματι",703052,54],["κάλλος",707093,15]],"Nephthalim is a spreading stem, bestowing beauty on its fruit."],["22",[["υἱὸς",713075,4],["ηὐξημένος",702144,251],["Ιωσηφ",706948,4],["υἱὸς",713075,4],["ηὐξημένος",702144,251],["ζηλωτός",705876,14],["υἱός",713075,4],["μου",709032,133],["νεώτατος",709256,140],["πρός",710844,0],["με",708618,163],["ἀνάστρεψον",701060,176]],"Joseph is a son increased; my dearly loved son is increased; my youngest son, turn to me."],["23",[["εἰς",704105,0],["ὃν",709781,112],["διαβουλευόμενοι",703429,348],["ἐλοιδόρουν",708240,137],["καὶ",707031,7],["ἐνεῖχον",704727,137],["αὐτῷ",702165,50],["κύριοι",707996,52],["τοξευμάτων",712895,81]],"Against whom men taking evil counsel reproached [him], and the archers pressed hard upon him."],["24",[["καὶ",707031,7],["συνετρίβη",712520,37],["μετὰ",708780,0],["κράτους",707883,21],["τὰ",709436,41],["τόξα",712898,42],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐξελύθη",704254,37],["τὰ",709436,63],["νεῦρα",709275,64],["βραχιόνων",702808,81],["χειρῶν",713787,65],["αὐτῶν",702165,284],["διὰ",703417,0],["χεῖρα",713787,9],["δυνάστου",703844,18],["Ιακωβ",706401,18],["ἐκεῖθεν",704182,28],["ὁ",709436,3],["κατισχύσας",707531,182],["Ισραηλ",706839,6]],"But their bow and arrows were mightily consumed, and the sinews of their arms were slackened by the hand of the mighty one of Jacob; thence is he that strengthened Israel from the God of thy father;"],["25",[["παρὰ",709995,0],["θεοῦ",706192,18],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["καὶ",707031,7],["ἐβοήθησέν",702746,2],["σοι",711925,159],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["ἐμὸς",704578,14],["καὶ",707031,7],["εὐλόγησέν",705631,2],["σε",711598,163],["εὐλογίαν",705633,9],["οὐρανοῦ",709844,18],["ἄνωθεν",701298,28],["καὶ",707031,7],["εὐλογίαν",705633,9],["γῆς",703083,17],["ἐχούσης",705785,222],["πάντα",710177,68],["ἕνεκεν",704709,0],["εὐλογίας",705633,17],["μαστῶν",708569,81],["καὶ",707031,7],["μήτρας",708894,17]],"and my God helped thee, and he blessed thee with the blessing of heaven from above, and the blessing of the earth possessing all things, because of the blessing of the breasts and of the womb,"],["26",[["εὐλογίας",705633,17],["πατρός",710189,18],["σου",711945,133],["καὶ",707031,7],["μητρός",708892,17],["σου",711945,133],["ὑπερίσχυσεν",713144,2],["ἐπ᾿",705080,0],["εὐλογίαις",705633,76],["ὀρέων",709768,44],["μονίμων",708994,83],["καὶ",707031,7],["ἐπ᾿",705080,0],["εὐλογίαις",705633,76],["θινῶν",706269,81],["ἀενάων",700313,169],["ἔσονται",704093,135],["ἐπὶ",705080,0],["κεφαλὴν",707639,9],["Ιωσηφ",706948,18],["καὶ",707031,7],["ἐπὶ",705080,0],["κορυφῆς",707844,17],["ὧν",709781,252],["ἡγήσατο",705931,23],["ἀδελφῶν",700249,81]],"the blessings of thy father and thy mother—it has prevailed above the blessing of the lasting mountains, and beyond the blessings of the everlasting hills; they shall be upon the head of Joseph, and upon the head of the brothers of whom he took the lead."],["27",[["Βενιαμιν",702650,4],["λύκος",708269,4],["ἅρπαξ",701805,14],["τὸ",709436,24],["πρωινὸν",711024,46],["ἔδεται",705495,93],["ἔτι",705538,28],["καὶ",707031,7],["εἰς",704105,0],["τὸ",709436,24],["ἑσπέρας",705500,17],["διαδώσει",703449,127],["τροφήν",712984,9]],"Benjamin, as a ravening wolf, shall eat still in the morning, and at evening he gives food."],["28",[["πάντες",710177,138],["οὗτοι",709858,201],["υἱοὶ",713075,52],["Ιακωβ",706401,18],["δώδεκα",703887,59],["καὶ",707031,7],["ταῦτα",709858,71],["ἐλάλησεν",708071,2],["αὐτοῖς",702165,151],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτῶν",702165,40],["καὶ",707031,7],["εὐλόγησεν",705631,2],["αὐτούς",702165,62],["ἕκαστον",704133,27],["κατὰ",707200,0],["τὴν",709436,8],["εὐλογίαν",705633,9],["αὐτοῦ",702165,102],["εὐλόγησεν",705631,2],["αὐτούς",702165,62]],"All these [are] the twelve sons of Jacob; and their father spoke these words to them, and he blessed them; he blessed each of them according to his blessing."],["29",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["ἐγὼ",704018,164],["προστίθεμαι",710965,254],["πρὸς",710844,0],["τὸν",709436,5],["ἐμὸν",704578,27],["λαόν",708094,6],["θάψατέ",706103,74],["με",708618,163],["μετὰ",708780,0],["τῶν",709436,80],["πατέρων",710189,81],["μου",709032,133],["ἐν",704639,0],["τῷ",709436,53],["σπηλαίῳ",712012,54],["ὅ",709781,33],["ἐστιν",704093,91],["ἐν",704639,0],["τῷ",709436,113],["ἀγρῷ",700196,114],["Εφρων",705770,18],["τοῦ",709436,35],["Χετταίου",713838,18]],"And he said to them, I am added to my people; ye shall bury me with my fathers in the cave, which is in the field of Ephron the Chettite,"],["30",[["ἐν",704639,0],["τῷ",709436,53],["σπηλαίῳ",712012,54],["τῷ",709436,53],["διπλῷ",703740,97],["τῷ",709436,53],["ἀπέναντι",701389,0],["Μαμβρη",708455,118],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["Χανααν",713708,184],["ὃ",709781,128],["ἐκτήσατο",707932,23],["Αβρααμ",700091,4],["τὸ",709436,24],["σπήλαιον",712012,25],["παρὰ",709995,0],["Εφρων",705770,18],["τοῦ",709436,35],["Χετταίου",713838,18],["ἐν",704639,0],["κτήσει",707937,1],["μνημείου",708963,21]],"in the double cave which is opposite Mambre, in the land of Chanaan, the cave which Abraam bought of Ephron the Chettite, for a possession of a sepulchre."],["31",[["ἐκεῖ",704181,28],["ἔθαψαν",706103,150],["Αβρααμ",700091,6],["καὶ",707031,7],["Σαρραν",711541,9],["τὴν",709436,8],["γυναῖκα",703209,9],["αὐτοῦ",702165,102],["ἐκεῖ",704181,28],["ἔθαψαν",706103,150],["Ισαακ",706799,6],["καὶ",707031,7],["Ρεβεκκαν",711213,9],["τὴν",709436,8],["γυναῖκα",703209,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐκεῖ",704181,28],["ἔθαψα",706103,155],["Λειαν",708127,9]],"There they buried Abraam and Sarrha his wife; there they buried Isaac, and Rebecca his wife; there they buried Lea;"],["32",[["ἐν",704639,0],["κτήσει",707937,1],["τοῦ",709436,35],["ἀγροῦ",700196,18],["καὶ",707031,7],["τοῦ",709436,20],["σπηλαίου",712012,21],["τοῦ",709436,20],["ὄντος",704093,294],["ἐν",704639,0],["αὐτῷ",702165,50],["παρὰ",709995,0],["τῶν",709436,80],["υἱῶν",713075,81],["Χετ",713836,18]],"in the portion of the field, and of the cave that was in it, [purchased] of the sons of Chet."],["33",[["καὶ",707031,7],["κατέπαυσεν",707365,2],["Ιακωβ",706401,4],["ἐπιτάσσων",705294,72],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐξάρας",704839,182],["τοὺς",709436,58],["πόδας",710707,57],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τὴν",709436,8],["κλίνην",707737,9],["ἐξέλιπεν",704237,2],["καὶ",707031,7],["προσετέθη",710965,37],["πρὸς",710844,0],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102]],"And Jacob ceased giving charges to his sons; and having lifted up his feet on the bed, he died, and was gathered to his people."]]