11],["τὰ",709436,63],["παιδία",709927,64],["ἐν",704639,0],["αὐτῇ",702165,105],["εἶπεν",705373,2],["δέ",703303,11],["εἰ",704071,7],["οὕτως",709859,28],["μοι",708974,159],["μέλλει",708705,91],["γίνεσθαι",703104,110],["ἵνα",706747,7],["τί",712867,273],["μοι",708974,159],["τοῦτο",709858,129],["ἐπορεύθη",710667,37],["δὲ",703303,11],["πυθέσθαι",711085,109],["παρὰ",709995,0],["κυρίου",707996,18]],"And the babes leaped within her; and she said, If it will be so with me, why is this to me? And she went to enquire of the Lord."],["23",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["αὐτῇ",702165,105],["δύο",703849,59],["ἔθνη",704068,64],["ἐν",704639,0],["τῇ",709436,100],["γαστρί",702976,1],["σού",711945,133],["εἰσιν",704093,197],["καὶ",707031,7],["δύο",703849,59],["λαοὶ",708094,52],["ἐκ",704132,0],["τῆς",709436,16],["κοιλίας",707761,17],["σου",711945,133],["διασταλήσονται",703588,144],["καὶ",707031,7],["λαὸς",708094,4],["λαοῦ",708094,18],["ὑπερέξει",713134,127],["καὶ",707031,7],["ὁ",709436,3],["μείζων",708682,224],["δουλεύσει",703814,127],["τῷ",709436,113],["ἐλάσσονι",704388,302]],"And the Lord said to her, There are two nations in thy womb, and two peoples shall be separated from thy belly, and one people shall excel the other, and the elder shall serve the younger."],["24",[["καὶ",707031,7],["ἐπληρώθησαν",710543,99],["αἱ",709436,190],["ἡμέραι",705984,191],["τοῦ",709436,20],["τεκεῖν",712853,106],["αὐτήν",702165,104],["καὶ",707031,7],["τῇδε",709446,105],["ἦν",704093,13],["δίδυμα",703653,195],["ἐν",704639,0],["τῇ",709436,100],["κοιλίᾳ",707761,1],["αὐτῆς",702165,86]],"And the days were fulfilled that she should be delivered, and she had twins in her womb."],["25",[["ἐξῆλθεν",704909,2],["δὲ",703303,11],["ὁ",709436,3],["υἱὸς",713075,4],["ὁ",709436,3],["πρωτότοκος",711046,14],["πυρράκης",711106,14],["ὅλος",709597,14],["ὡσεὶ",714159,28],["δορὰ",703797,12],["δασύς",703299,14],["ἐπωνόμασεν",705348,2],["δὲ",703303,11],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["Ησαυ",706030,6]],"And the first came out red, hairy all over like a skin; and she called his name Esau."],["26",[["καὶ",707031,7],["μετὰ",708780,0],["τοῦτο",709858,129],["ἐξῆλθεν",704909,2],["ὁ",709436,3],["ἀδελφὸς",700249,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἡ",709436,10],["χεὶρ",713787,12],["αὐτοῦ",702165,102],["ἐπειλημμένη",705185,203],["τῆς",709436,16],["πτέρνης",711050,17],["Ησαυ",706030,18],["καὶ",707031,7],["ἐκάλεσεν",707084,2],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["Ιακωβ",706401,6],["Ισαακ",706799,4],["δὲ",703303,11],["ἦν",704093,13],["ἐτῶν",705543,44],["ἑξήκοντα",704922,59],["ὅτε",709802,28],["ἔτεκεν",712853,2],["αὐτοὺς",702165,62],["Ρεβεκκα",711213,12]],"And after this came forth his brother, and his hand took hold of the heel of Esau; and she called his name Jacob. And Isaac was sixty years old when Rebecca bore them."],["27",[["ηὐξήθησαν",702144,99],["δὲ",703303,11],["οἱ",709436,136],["νεανίσκοι",709232,52],["καὶ",707031,7],["ἦν",704093,13],["Ησαυ",706030,4],["ἄνθρωπος",701163,4],["εἰδὼς",704075,270],["κυνηγεῖν",707974,55],["ἄγροικος",700195,14],["Ιακωβ",706401,4],["δὲ",703303,11],["ἦν",704093,13],["ἄνθρωπος",701163,4],["ἄπλαστος",701414,14],["οἰκῶν",709499,72],["οἰκίαν",709505,9]],"And the lads grew, and Esau was a man skilled in hunting, dwelling in the country, and Jacob a simple man, dwelling in a house."],["28",[["ἠγάπησεν",700120,2],["δὲ",703303,11],["Ισαακ",706799,4],["τὸν",709436,5],["Ησαυ",706030,6],["ὅτι",709803,7],["ἡ",709436,10],["θήρα",706244,12],["αὐτοῦ",702165,102],["βρῶσις",702825,12],["αὐτῷ",702165,50],["Ρεβεκκα",711213,12],["δὲ",703303,11],["ἠγάπα",700120,13],["τὸν",709436,5],["Ιακωβ",706401,6]],"And Isaac loved Esau, because his venison was his food, but Rebecca loved Jacob."],["29",[["ἥψησεν",705788,2],["δὲ",703303,11],["Ιακωβ",706401,4],["ἕψεμα",705787,25],["ἦλθεν",705453,2],["δὲ",703303,11],["Ησαυ",706030,4],["ἐκ",704132,0],["τοῦ",709436,20],["πεδίου",710215,21],["ἐκλείπων",704237,72]],"And Jacob cooked