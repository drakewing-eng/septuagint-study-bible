[["1",[["καὶ",707031,7],["ἀναστὰς",701173,182],["Εσδρας",705465,4],["ἀπὸ",701425,0],["τῆς",709436,16],["αὐλῆς",702137,17],["τοῦ",709436,20],["ἱεροῦ",706633,92],["ἐπορεύθη",710667,37],["εἰς",704105,0],["τὸ",709436,24],["παστοφόριον",710181,25],["Ιωαναν",706888,18],["τοῦ",709436,35],["Ελιασιβου",704459,18]],"Then Esdras rising from the court of the temple went to the chamber of Joanan the son of Eliasib,"],["2",[["καὶ",707031,7],["αὐλισθεὶς",702138,217],["ἐκεῖ",704181,28],["ἄρτου",701829,18],["οὐκ",709805,28],["ἐγεύσατο",703074,23],["οὐδὲ",709816,7],["ὕδωρ",713071,15],["ἔπιεν",710478,2],["πενθῶν",710251,72],["ὑπὲρ",713111,0],["τῶν",709436,130],["ἀνομιῶν",701192,65],["τῶν",709436,130],["μεγάλων",708653,198],["τοῦ",709436,20],["πλήθους",710529,21]],"and remained there, and did eat no meat nor drink water, mourning for the great iniquities of the multitude."],["3",[["καὶ",707031,7],["ἐγένετο",703104,23],["κήρυγμα",707660,15],["ἐν",704639,0],["ὅλῃ",709597,101],["τῇ",709436,100],["Ιουδαίᾳ",706769,1],["καὶ",707031,7],["Ιερουσαλημ",706644,1],["πᾶσι",710177,230],["τοῖς",709436,147],["ἐκ",704132,0],["τῆς",709436,16],["αἰχμαλωσίας",700499,17],["συναχθῆναι",712375,179],["εἰς",704105,0],["Ιερουσαλημ",706644,9]],"And there was a proclamation in all Jewry and Jerusalem to all them that were of the captivity, that they should be gathered together at Jerusalem:"],["4",[["καὶ",707031,7],["ὅσοι",709788,138],["ἂν",700900,11],["μὴ",708851,28],["ἀπαντήσωσιν",701345,234],["ἐν",704639,0],["δυσὶν",703849,59],["ἢ",705924,7],["τρισὶν",712927,291],["ἡμέραις",705984,76],["κατὰ",707200,0],["τὸ",709436,24],["κρίμα",707903,25],["τῶν",709436,80],["προκαθημένων",710805,299],["πρεσβυτέρων",710735,81],["ἀνιερωθήσονται",701167,144],["τὰ",709436,63],["κτήνη",707934,64],["αὐτῶν",702165,40],["καὶ",707031,7],["αὐτὸς",702165,121],["ἀλλοτριωθήσεται",700701,134],["ἀπὸ",701425,0],["τοῦ",709436,20],["πλήθους",710529,21],["τῆς",709436,16],["αἰχμαλωσίας",700499,17]],"and that whosoever met not there within two or three days, according as the elders that bare rule appointed, their cattle should be seized to the use of the temple, and himself cast out from them that were of the captivity."],["5",[["καὶ",707031,7],["ἐπισυνήχθησαν",705280,99],["οἱ",709436,136],["ἐκ",704132,0],["τῆς",709436,16],["φυλῆς",713620,17],["Ιουδα",706768,18],["καὶ",707031,7],["Βενιαμιν",702650,18],["ἐν",704639,0],["τρισὶν",712927,291],["ἡμέραις",705984,76],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["οὗτος",709858,121],["ὁ",709436,3],["μὴν",708874,4],["ἔνατος",704666,14],["τῇ",709436,100],["εἰκάδι",704082,1],["τοῦ",709436,35],["μηνός",708874,18]],"And in three days were all they of the tribe of Juda and Benjamin gathered together at Jerusalem the twentieth day of the ninth month."],["6",[["καὶ",707031,7],["συνεκάθισαν",712196,150],["πᾶν",710177,26],["τὸ",709436,34],["πλῆθος",710529,15],["ἐν",704639,0],["τῇ",709436,100],["εὐρυχώρῳ",705681,101],["τοῦ",709436,20],["ἱεροῦ",706633,92],["τρέμοντες",712928,146],["διὰ",703417,0],["τὸν",709436,5],["ἐνεστῶτα",704749,427],["χειμῶνα",713786,6]],"And all the multitude sat in the broad court of the temple, trembling because of the present foul weather."],["7",[["καὶ",707031,7],["ἀναστὰς",701173,182],["Εσδρας",705465,4],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["ὑμεῖς",713081,219],["ἠνομήσατε",701190,265],["καὶ",707031,7],["συνῳκίσατε",712495,265],["γυναῖκας",703209,39],["ἀλλογενεῖς",700690,119],["τοῦ",709436,20],["προσθεῖναι",710965,106],["ἁμαρτίαν",700775,9],["τῷ",709436,113],["Ισραηλ",706839,114]],"So Esdras arose up, and said unto them, Ye have transgressed the law in marrying strange wives, thereby to increase the sins of Israel."],["8",[["καὶ",707031,7],["νῦν",709384,28],["δότε",703654,74],["ὁμολογίαν",709633,9],["δόξαν",703791,9],["τῷ",709436,113],["κυρίῳ",707996,114],["θεῷ",706192,114],["τῶν",709436,80],["πατέρων",710189,81],["ἡμῶν",705999,145]],"And now by confessing give glory unto the Lord God of our fathers,"],["9",[["καὶ",707031,7],["ποιήσατε",710582,74],["τὸ",709436,24],["θέλημα",706170,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["χωρίσθητε",714014,372],["ἀπὸ",701425,0],["τῶν",709436,43],["ἐθνῶν",704068,44],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,130],["γυναικῶν",703209,65],["τῶν",709436,130],["ἀλλογενῶν",700690,198]],"and do his will, and separate yourselves from the heathen of the land, and from the strange women."],["10",[["καὶ",707031,7],["ἐφώνησαν",713639,150],["ἅπαν",701362,26],["τὸ",709436,34],["πλῆθος",710529,15],["καὶ",707031,7],["εἶπον",705373,150],["μεγάλῃ",708653,101],["τῇ",709436,100],["φωνῇ",713640,1],["οὕτως",709859,28],["ὡς",714148,7],["εἴρηκας",705415,266],["ποιήσομεν",710582,275]],"Then cried the whole multitude, and said with a loud voice, Like as thou hast spoken, so will we do."],["11",[["ἀλλὰ",700680,7],["τὸ",709436,34],["πλῆθος",710529,15],["πολὺ",710646,26],["καὶ",707031,7],["ἡ",709436,10],["ὥρα",714128,12],["χειμερινή",713784,29],["καὶ",707031,7],["οὐκ",709805,28],["ἰσχύομεν",706859,243],["στῆναι",706846,106],["αἴθριοι",700421,138],["καὶ",707031,7],["οὐχ",709805,28],["εὕρομεν",705676,289],["καὶ",707031,7],["τὸ",709436,34],["ἔργον",705396,15],["ἡμῖν",705994,90],["οὐκ",709805,28],["ἔστιν",704093,91],["ἡμέρας",705984,17],["μιᾶς",704106,82],["οὐδὲ",709816,7],["δύο",703849,59],["ἐπὶ",705080,0],["πλεῖον",710514,46],["γὰρ",702963,11],["ἡμάρτομεν",700773,289],["ἐν",704639,0],["τούτοις",709858,206]],"But forasmuch as the people are many, and it is foul weather, so that we cannot stand without, and this is not a work of a day or two, seeing our sin in these things is spread far:"],["12",[["στήτωσαν",706846,264],["δὲ",703303,11],["οἱ",709436,136],["προηγούμενοι",710791,348],["τοῦ",709436,20],["πλήθους",710529,21],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["ἐκ",704132,0],["τῶν",709436,130],["κατοικιῶν",707537,65],["ἡμῶν",705999,145],["ὅσοι",709788,138],["ἔχουσιν",705785,197],["γυναῖκας",703209,39],["ἀλλογενεῖς",700690,119],["παραγενηθήτωσαν",710006,51],["λαβόντες",708076,196],["χρόνον",713969,6]],"therefore let the rulers of the multitude stay, and let all them of our habitations that have strange wives come at the time appointed,"],["13",[["καὶ",707031,7],["ἑκάστου",704133,116],["δὲ",703303,11],["τόπου",712903,18],["τοὺς",709436,58],["πρεσβυτέρους",710735,57],["καὶ",707031,7],["τοὺς",709436,58],["κριτὰς",707910,57],["ἕως",705792,7],["τοῦ",709436,20],["λῦσαι",708288,106],["τὴν",709436,8],["ὀργὴν",709728,9],["τοῦ",709436,35],["κυρίου",707996,18],["ἀφ᾿",701425,0],["ἡμῶν",705999,145],["τοῦ",709436,20],["πράγματος",710708,21],["τούτου",709858,49]],"and with them the rulers and judges of every place, till we turn away the wrath of the Lord from us for this matter."],["14",[["Ιωναθας",706928,4],["Αζαηλου",700321,18],["καὶ",707031,7],["Ιεζιας",706542,4],["Θοκανου",706283,18],["ἐπεδέξαντο",705117,189],["κατὰ",707200,0],["ταῦτα",709858,71],["καὶ",707031,7],["Μοσολλαμος",709024,4],["καὶ",707031,7],["Λευις",708159,4],["καὶ",707031,7],["Σαββαταιος",711348,4],["συνεβράβευσαν",712296,150],["αὐτοῖς",702165,151]],"[Then] Jonathan [the son] of Azael and Ezechias [the son] of Theocanus accordingly took this matter upon them: and Mosollam and Levis and Sabbatheus helped them."],["15",[["καὶ",707031,7],["ἐποίησαν",710582,150],["κατὰ",707200,0],["πάντα",710177,68],["ταῦτα",709858,71],["οἱ",709436,136],["ἐκ",704132,0],["τῆς",709436,16],["αἰχμαλωσίας",700499,17]],"And they that were of the captivity did according to all these things."],["16",[["καὶ",707031,7],["ἐπελέξατο",705188,23],["ἑαυτῷ",703917,50],["Εσδρας",705465,4],["ὁ",709436,3],["ἱερεὺς",706614,4],["ἄνδρας",701150,57],["ἡγουμένους",705931,236],["τῶν",709436,130],["πατριῶν",710192,65],["αὐτῶν",702165,284],["κατ᾿",707200,0],["ὄνομα",709666,25],["πάντας",710177,60],["καὶ",707031,7],["συνεκάθισαν",712196,150],["τῇ",709436,100],["νουμηνίᾳ",709371,1],["τοῦ",709436,35],["μηνὸς",708874,18],["τοῦ",709436,35],["δεκάτου",703343,116],["ἐτάσαι",705526,106],["τὸ",709436,24],["πρᾶγμα",710708,25]],"And Esdras the priest chose unto him the principal men of their families, all by name: and in the first day of the tenth month they sat together to examine the matter."],["17",[["καὶ",707031,7],["ἤχθη",700209,37],["ἐπὶ",705080,0],["πέρας",710281,25],["τὰ",709436,41],["κατὰ",707200,0],["τοὺς",709436,58],["ἄνδρας",701150,57],["τοὺς",709436,58],["ἐπισυνέχοντας",705282,235],["γυναῖκας",703209,39],["ἀλλογενεῖς",700690,119],["ἕως",705792,7],["τῆς",709436,16],["νουμηνίας",709371,17],["τοῦ",709436,35],["πρώτου",711041,116],["μηνός",708874,18]],"So their cause that held strange wives was brought to an end in the first day of the first month."],["18",[["καὶ",707031,7],["εὑρέθησαν",705676,99],["τῶν",709436,80],["ἱερέων",706614,81],["οἱ",709436,136],["ἐπισυναχθέντες",705280,247],["ἀλλογενεῖς",700690,119],["γυναῖκας",703209,39],["ἔχοντες",705785,146]],"And of the priests that were come together, and had strange wives, there were found;"],["19",[["ἐκ",704132,0],["τῶν",709436,80],["υἱῶν",713075,81],["Ἰησοῦ",706701,18],["τοῦ",709436,35],["Ιωσεδεκ",706944,18],["καὶ",707031,7],["τῶν",709436,80],["ἀδελφῶν",700249,81],["Μασηας",708551,4],["καὶ",707031,7],["Ελεαζαρος",704408,4],["καὶ",707031,7],["Ιωριβος",706936,4],["καὶ",707031,7],["Ιωδανος",706910,4]],"of the sons of Jesus the [son] of Josedec, and his brethren; Matthelas, and Eleazar, and Joribus, and Joadanus."],["20",[["καὶ",707031,7],["ἐπέβαλον",705083,150],["τὰς",709436,38],["χεῖρας",713787,39],["ἐκβαλεῖν",704145,106],["τὰς",709436,38],["γυναῖκας",703209,39],["αὐτῶν",702165,40],["καὶ",707031,7],["εἰς",704105,0],["ἐξιλασμὸν",704934,6],["κριοὺς",707906,57],["ὑπὲρ",713111,0],["τῆς",709436,16],["ἀγνοίας",700177,17],["αὐτῶν",702165,40]],"And they gave their hands to put away their wives, and to offer rams to make reconcilement for their errors."],["21",[["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,80],["υἱῶν",713075,81],["Εμμηρ",704571,18],["Ανανιας",701016,4],["καὶ",707031,7],["Ζαβδαιος",705801,4],["καὶ",707031,7],["Μανη