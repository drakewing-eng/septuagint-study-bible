[["1",[["καὶ",707031,7],["ἤρξατο",701860,23],["ὁ",709436,3],["δεύτερος",703389,14],["λαλεῖν",708071,55],["ὁ",709436,3],["εἴπας",705373,182],["περὶ",710285,0],["τῆς",709436,16],["ἰσχύος",706858,17],["τοῦ",709436,35],["βασιλέως",702580,18]],"Then the second, that had spoken of the strength of the king, began to say,"],["2",[["ὦ",714081,88],["ἄνδρες",701150,274],["οὐχ",709805,28],["ὑπερισχύουσιν",713144,197],["οἱ",709436,136],["ἄνθρωποι",701163,52],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["τὴν",709436,8],["θάλασσαν",706069,9],["κατακρατοῦντες",707287,146],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["ἐν",704639,0],["αὐτοῖς",702165,206]],"O ye men, do not men excel in strength, that bear rule over sea and land, and all things in them?"],["3",[["ὁ",709436,3],["δὲ",703303,11],["βασιλεὺς",702580,4],["ὑπερισχύει",713144,91],["καὶ",707031,7],["κυριεύει",707995,91],["αὐτῶν",702165,40],["καὶ",707031,7],["δεσπόζει",703376,91],["αὐτῶν",702165,40],["καὶ",707031,7],["πᾶν",710177,46],["ὃ",709781,128],["ἐὰν",703912,7],["εἴπῃ",708124,172],["αὐτοῖς",702165,151],["ἐνακούουσιν",704649,197]],"But yet the king is more mighty: for he is lord of all these things, and hath dominion over them; and whatsoever he commandeth them they do."],["4",[["ἐὰν",703912,7],["εἴπῃ",708124,172],["αὐτοῖς",702165,151],["ποιῆσαι",710582,106],["πόλεμον",710605,6],["ἕτερος",705535,14],["πρὸς",710844,0],["τὸν",709436,5],["ἕτερον",705535,27],["ποιοῦσιν",710582,197],["ἐὰν",703912,7],["δὲ",703303,11],["ἐξαποστείλῃ",704872,172],["αὐτοὺς",702165,62],["πρὸς",710844,0],["τοὺς",709436,58],["πολεμίους",710603,60],["βαδίζουσιν",702367,197],["καὶ",707031,7],["κατεργάζονται",707515,269],["τὰ",709436,41],["ὄρη",709768,42],["καὶ",707031,7],["τὰ",709436,41],["τείχη",712759,42],["καὶ",707031,7],["τοὺς",709436,58],["πύργους",711092,57]],"If he bid them make war the one against the other, they do it: if he send them out against the enemies, they go, and break down mountains, walls, and towers."],["5",[["φονεύουσιν",713546,197],["καὶ",707031,7],["φονεύονται",713546,269],["καὶ",707031,7],["τὸν",709436,5],["λόγον",708236,6],["τοῦ",709436,35],["βασιλέως",702580,18],["οὐ",709805,28],["παραβαίνουσιν",709996,197],["ἐὰν",703912,7],["δὲ",703303,11],["νικήσωσιν",709309,234],["τῷ",709436,113],["βασιλεῖ",702580,114],["κομίζουσιν",707805,197],["πάντα",710177,68],["καὶ",707031,7],["ὅσα",709788,68],["ἐὰν",703912,7],["προνομεύσωσιν",710826,234],["καὶ",707031,7],["τὰ",709436,41],["ἄλλα",700697,68],["πάντα",710177,68]],"They slay and are slain, and transgress not the king's commandment: if they get the victory, they bring all to the king, as well the spoil, as all things else."],["6",[["καὶ",707031,7],["ὅσοι",709788,138],["οὐ",709805,28],["στρατεύονται",712140,269],["οὐδὲ",709816,7],["πολεμοῦσιν",710601,197],["ἀλλὰ",700680,7],["γεωργοῦσιν",703079,197],["τὴν",709436,8],["γῆν",703083,9],["πάλιν",709942,28],["ὅταν",709801,28],["σπείρωσι",712006,234],["θερίσαντες",706206,196],["ἀναφέρουσιν",701083,197],["τῷ",709436,113],["βασιλεῖ",702580,114],["καὶ",707031,7],["ἕτερος",705535,14],["τὸν",709436,5],["ἕτερον",705535,27],["ἀναγκάζοντες",700923,146],["ἀναφέρουσι",701083,197],["τοὺς",709436,58],["φόρους",713561,57],["τῷ",709436,113],["βασιλεῖ",702580,114]],"Likewise for those that are no soldiers, and have not to do with wars, but use husbandry, when they have reaped again that which they had sown, they bring it to the king, and compel one another to pay tribute unto the king."],["7",[["καὶ",707031,7],["αὐτὸς",702165,121],["εἷς",704106,596],["μόνος",709003,14],["ἐστίν",704093,91],["ἐὰν",703912,7],["εἴπῃ",708124,172],["ἀποκτεῖναι",701498,106],["ἀποκτέννουσιν",701498,197],["εἶπεν",705373,2],["ἀφεῖναι",702211,106],["ἀφίουσιν",702211,197]],"And yet he is but one man: if he command to kill, they kill; if he command to spare, they spare;"],["8",[["εἶπε",705373,2],["πατάξαι",710185,106],["τύπτουσιν",713022,197],["εἶπεν",705373,2],["ἐρημῶσαι",705421,106],["ἐρημοῦσιν",705421,197],["εἶπεν",705373,2],["οἰκοδομῆσαι",709509,106],["οἰκοδομοῦσιν",709509,197]],"if he command to smite, they smite; if he command to make desolate, they make desolate; if he command to build, they build;"],["9",[["εἶπεν",705373,2],["ἐκκόψαι",704225,106],["ἐκκόπτουσιν",704225,197],["εἶπεν",705373,2],["φυτεῦσαι",713636,106],["φυτεύουσιν",713636,197]],"if he command to cut down, they cut down; if he command to plant, they plant."],["10",[["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["αἱ",709436,190],["δυνάμεις",703839,191],["αὐτοῦ",702165,102],["ἐνακούουσιν",704649,197]],"So all his people and his armies obey him: furthermore he lieth down, he eateth and drinketh, and taketh his rest:"],["11",[["πρὸς",710844,0],["δὲ",703303,11],["τούτοις",709858,151],["αὐτὸς",702165,121],["ἀνάκειται",700970,117],["ἐσθίει",705495,91],["καὶ",707031,7],["πίνει",710478,91],["καὶ",707031,7],["καθεύδει",706996,91],["αὐτοὶ",702165,201],["δὲ",703303,11],["τηροῦσιν",712844,197],["κύκλῳ",707959,114],["περὶ",710285,0],["αὐτὸν",702165,85],["καὶ",707031,7],["οὐ",709805,28],["δύνανται",703838,269],["ἕκαστος",704133,14],["ἀπελθεῖν",701398,106],["καὶ",707031,7],["ποιεῖν",710582,55],["τὰ",709436,41],["ἔργα",705396,42],["αὐτοῦ",702165,102],["οὐδὲ",709816,7],["παρακούουσιν",710055,197],["αὐτοῦ",702165,102]],"and these keep watch round about him, neither may any one depart, and do his own business, neither disobey they him in any thing."],["12",[["ὦ",714081,88],["ἄνδρες",701150,274],["πῶς",711121,28],["οὐχ",709805,28],["ὑπερισχύει",713144,91],["ὁ",709436,3],["βασιλεύς",702580,4],["ὅτι",709803,7],["οὕτως",709859,28],["ἐπακουστός",705008,14],["ἐστιν",704093,91],["καὶ",707031,7],["ἐσίγησεν",711767,2]],"O ye men, how should not the king be mightiest, when in such sort he is obeyed? And he held his tongue."],["13",[["ὁ",709436,3],["δὲ",703303,11],["τρίτος",712968,14],["ὁ",709436,3],["εἴπας",705373,182],["περὶ",710285,0],["τῶν",709436,130],["γυναικῶν",703209,65],["καὶ",707031,7],["τῆς",709436,16],["ἀληθείας",700656,17],["οὗτός",709858,121],["ἐστιν",704093,91],["Ζοροβαβελ",705889,4],["ἤρξατο",701860,23],["λαλεῖν",708071,55]],"Then the third, who had spoken of women, and of the truth, (this was Zorobabel) began to speak."],["14",[["ἄνδρες",701150,274],["οὐ",709805,28],["μέγας",708653,14],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["πολλοὶ",710646,138],["οἱ",709436,136],["ἄνθρωποι",701163,52],["καὶ",707031,7],["ὁ",709436,3],["οἶνος",709530,4],["ἰσχύει",706859,91],["τίς",712867,158],["οὖν",709835,11],["ὁ",709436,3],["δεσπόζων",703376,72],["αὐτῶν",702165,40],["ἢ",705924,7],["τίς",712867,158],["ὁ",709436,3],["κυριεύων",707995,72],["αὐτῶν",702165,40],["οὐχ",709805,28],["αἱ",709436,190],["γυναῖκες",703209,191]],"O ye men, it is not the great king, nor the multitude of men, neither is it wine, that excelleth: who is it then that ruleth them, or hath the lordship over them? are they not women?"],["15",[["αἱ",709436,190],["γυναῖκες",703209,191],["ἐγέννησαν",703051,150],["τὸν",709436,5],["βασιλέα",702580,6],["καὶ",707031,7],["πάντα",710177,27],["τὸν",709436,5],["λαόν",708094,6],["ὃς",709781,213],["κυριεύει",707995,91],["τῆς",709436,16],["θαλάσσης",706069,17],["καὶ",707031,7],["τῆς",709436,16],["γῆς",703083,17]],"Women have borne the king and all the people that bear rule by sea and land."],["16",[["καὶ",707031,7],["ἐξ",704132,0],["αὐτῶν",702165,284],["ἐγένοντο",703104,189],["καὶ",707031,7],["αὗται",709858,202],["ἐξέθρεψαν",704342,150],["αὐτοὺς",702165,62],["τοὺς",709436,58],["φυτεύοντας",713636,235],["τοὺς",709436,58],["ἀμπελῶνας",700872,57],["ἐξ",704132,0],["ὧν",709781,252],["ὁ",709436,3],["οἶνος",709530,4],["γίνεται",703104,117]],"Even of them came they: and they nourished them up that planted the vineyards, from whence the wine cometh."],["17",[["καὶ",707031,7],["αὗται",709858,202],["ποιοῦσιν",710582,197],["τὰς",709436,38],["στολὰς",712120,39],["τῶν",709436,80],["ἀνθρώπων",701163,81],["καὶ",707031,7],["αὗται",709858,202],["ποιοῦσιν",710582,197],["δόξαν",703791,9],["τοῖς",709436,147],["ἀνθρώποις",701163,148],["καὶ",707031,7],["οὐ",709805,28],["δύνανται",703838,269],["οἱ",709436,136],["ἄνθρωποι",701163,52],["εἶναι",704093,55],["χωρὶς",714016,28],["τῶν",709436,130],["γυναικῶν",703209,65]],"These also make garments for men; these bring glory unto men; and without women cannot men be."],["18",[["ἐὰν",703912,7],["δὲ",703303,11],["συναγάγωσιν",712375,234],["χρυσίον",713972,25],["καὶ",707031,7],["ἀργύριον",701707,25],["καὶ",707031,7],["πᾶν",710177,46],["πρᾶγμα",710708,25],["ὡραῖον",714132,46],["καὶ",707031,7],["ἴδωσιν",709725,234],["γυναῖκα",703209,9],["μίαν",704106,36],["καλὴν",707097,36],["τῷ",709436,53],["εἴδει",704074,54],["καὶ",707031,7],["τῷ",709436,53],["κάλλει",707093,54]],"Yea, and if men have gathered together gold and silver, or any other goodly thing, do they not love a woman which is comely in favour and beauty?"],["19",[["καὶ",707031,7],["ταῦτα",709858,71],["πάντα",710177,68],["ἀφέντες",702211,146],["εἰς",704105,0],["αὐτὴν",702165,104],["ἐγκέχηναν",704010,353],["καὶ",707031,7],["χάσκοντες",713765,146],["τὸ",709436,24],["στόμα",712125,25],["θεωροῦσιν",706226,197],["αὐτήν",702165,104],["καὶ",707031,7],["πάντες",710177,138],["αὐτὴν",702165,104],["αἱρετίζουσιν",700469,197],["μᾶλλον",708448,28],["ἢ",705924,7],["τὸ",709436,24],["χρυσίον",713972,25],["καὶ",707031,7],["τὸ",709436,24],["ἀργύριον",701707,25],["καὶ",707031,7],["πᾶν",710177,46],["πρᾶγμα",710708,25],["ὡραῖον",714132,46]],"And letting all those things go, do they not gape, and even with open mouth fix their eyes fast on her; and have not all men more desire unto her than unto silver or gold, or any goodly thing whatsoever?"],["20",[["ἄνθρωπος",701163,4],["τὸν",709436,5],["ἑαυτοῦ",703917,102],["πατέρα",710189,6],["ἐγκαταλείπει",703967,91],["ὃς",709781,213],["ἐξέθρεψεν",704342,2],["αὐτόν",702165,85],["καὶ",707031,7],["τὴν",709436,8],["ἰδίαν",706493,36],["χώραν",714011,9],["καὶ",707031,7],["πρὸς",710844,0],["τὴν",709436,8],["ἰδίαν",706493,36],["γυναῖκα",703209,9],["κολλᾶται",707791,117]],"A man leaveth his own father that brought him up, and his own country, and cleaveth unto his wife."],["21",[["καὶ",707031,7],["μετὰ",708780,0],["τῆς",709436,16],["γυναικὸς",703209,17],["ἀφίησι",702211,91],["τὴν",709436,8],["ψυχὴν",714070,9],["καὶ",707031,7],["οὔτε",709857,7],["τὸν",709436,5],["πατέρα",710189,6],["μέμνηται",708923,187],["οὔτε",709857,7],["τὴν",709436,8],["μητέρα",708892,9],["οὔτε",709857,7],["τὴν",709436,8],["χώραν",714011,9]],"He sticketh not to spend his life with his wife, and remembereth neither father, nor mother, nor country."],["22",[["καὶ",707031,7],["ἐντεῦθεν",704793,28],["δεῖ",703312,91],["ὑμᾶς",713080,194],["γνῶναι",703105,106],["ὅτι",709803,7],["αἱ",709436,190],["γυναῖκες",703209,191],["κυριεύουσιν",707995,197],["ὑμῶν",713091,145],["οὐχὶ",709862,28],["πονεῖτε",710656,87],["καὶ",707031,7],["μοχθεῖτε",709037,87],["καὶ",707031,7],["πάντα",710177,68],["ταῖς",709436,75],["γυναιξὶν",703209,76],["δίδοτε",703654,87],["καὶ",707031,7],["φέρετε",713428,87]],"By this also ye must know that women have dominion over you: do ye not labour and toil, and give and bring all to the woman?"],["23",[["καὶ",707031,7],["λαμβάνει",708076,91],["ἄνθρωπος",701163,4],["τὴν",709436,8],["ῥομφαίαν",711291,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐκπορεύεται",704293,117],["ἐξοδεύειν",704943,55],["καὶ",707031,7],["λῃστεύειν",708179,55],["καὶ",707031,7],["κλέπτειν",707715,55],["καὶ",707031,7],["εἰς",704105,0],["τὴν",709436,8],["θάλασσαν",706069,9],["πλεῖν",710526,55],["καὶ",707031,7],["ποταμούς",710693,57]],"Yea, a man taketh his sword, and goeth his way to rob and to steal, to sail upon the sea and upon rivers;"],["24",[["καὶ",707031,7],["τὸν",709436,5],["λέοντα",708171,6],["θεωρεῖ",706226,91],["καὶ",707031,7],["ἐν",704639,0],["σκότει",711889,54],["βαδίζει",702367,91],["καὶ",707031,7],["ὅταν",709801,28],["κλέψῃ",707715,172],["καὶ",707031,7],["ἁρπάσῃ",701804,172],["καὶ",707031,7],["λωποδυτήσῃ",708292,172],["τῇ",709436,100],["ἐρωμένῃ",705380,585],["ἀποφέρει",701632,91]],"and looketh upon a lion, and goeth in the darkness; and when he hath stolen, spoiled, and robbed, he bringeth it to his love."],["25",[["καὶ",707031,7],["πλεῖον",710514,46],["ἀγαπᾷ",700120,91],["ἄνθρωπος",701163,4],["τὴν",709436,8],["ἰδίαν",706493,36],["γυναῖκα",703209,9],["μᾶλλον",708448,28],["ἢ",705924,7],["τὸν",709436,5],["πατέρα",710189,6],["καὶ",707031,7],["τὴν",709436,8],["μητέρα",708892,9]],"Wherefore a man loveth his wife better than father or mother."],["26",[["καὶ",707031,7],["πολλοὶ",710646,138],["ἀπενοήθησαν",701534,99],["ταῖς",709436,75],["ἰδίαις",706493,291],["διανοίαις",703531,76],["διὰ",703417,0],["τὰς",709436,38],["γυναῖκας",703209,39],["καὶ",707031,7],["δοῦλοι",703817,52],["ἐγένοντο",703104,189],["δι᾿",703417,0],["αὐτάς",702165,231]],"Yea, many there be that have run out of their wits for women, and become servants for their sakes."],["27",[["καὶ",707031,7],["πολλοὶ",710646,138],["ἀπώλοντο",701513,189],["καὶ",707031,7],["ἐσφάλησαν",712575,99],["καὶ",707031,7],["ἡμάρτοσαν",700773,150],["διὰ",703417,0],["τὰς",709436,38],["γυναῖκας",703209,39]],"Many also have perished, have erred, and sinned, for women."],["28",[["καὶ",707031,7],["νῦν",709384,28],["οὐ",709805,28],["πιστεύετέ",710483,87],["μοι",708974,159],["οὐχὶ",709862,28],["μέγας",708653,14],["ὁ",709436,3],["βασιλεὺς",702580,4],["τῇ",709436,100],["ἐξουσίᾳ",704974,1],["αὐτοῦ",702165,102],["οὐχὶ",709862,28],["πᾶσαι",710177,192],["αἱ",709436,190],["χῶραι",714011,191],["εὐλαβοῦνται",705627,269],["ἅψασθαι",701654,109],["αὐτοῦ",702165,102]],"And now do ye not believe me? is not the king great in his power? do not all regions fear to touch him?"],["29",[["ἐθεώρουν",706226,333],["αὐτὸν",702165,85],["καὶ",707031,7],["Ἀπάμην",701340,9],["τὴν",709436,8],["θυγατέρα",706320,9],["Βαρτάκου",702547,18],["τοῦ",709436,35],["θαυμαστοῦ",706138,116],["τὴν",709436,8],["παλλακὴν",709943,9],["τοῦ",709436,35],["βασιλέως",702580,18],["καθημένην",707000,173],["ἐν",704639,0],["δεξιᾷ",703360,101],["τοῦ",709436,35],["βασιλέως",702580,18]],"Yet did I see him and Apame the king's concubine, the daughter of the admirable Bartacus, sitting at the right hand of the king,"],["30",[["καὶ",707031,7],["ἀφαιροῦσαν",702177,78],["τὸ",709436,24],["διάδημα",703447,25],["ἀπὸ",701425,0],["τῆς",709436,16],["κεφαλῆς",707639,17],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["ἐπιτιθοῦσαν",705304,78],["ἑαυτῇ",703917,105],["καὶ",707031,7],["ἐρράπιζεν",711182,13],["τὸν",709436,5],["βασιλέα",702580,6],["τῇ",709436,100],["ἀριστερᾷ",701749,101]],"and taking the crown from the king's head, and setting it upon her own head; she also struck the king with her left hand."],["31",[["καὶ",707031,7],["πρὸς",710844,0],["τούτοις",709858,206],["ὁ",709436,3],["βασιλεὺς",702580,4],["χάσκων",713765,72],["τὸ",709436,24],["στόμα",712125,25],["ἐθεώρει",706226,13],["αὐτήν",702165,104],["καὶ",707031,7],["ἐὰν",703912,7],["προσγελάσῃ",710869,172],["αὐτῷ",702165,50],["γελᾷ",703019,91],["ἐὰν",703912,7],["δὲ",703303,11],["πικρανθῇ",710469,384],["ἐπ᾿",705080,0],["αὐτόν",702165,85],["κολακεύει",707787,91],["αὐτήν",702165,104],["ὅπως",709719,7],["διαλλαγῇ",703502,384],["αὐτῷ",702165,50]],"And yet for all this the king gaped and gazed upon her with open mouth: if she laughed upon him, he laughed also: but if she took any displeasure at him, the king was fain to flatter, that she might be reconciled to him again."],["32",[["ὦ",714081,88],["ἄνδρες",701150,274],["πῶς",711121,28],["οὐχὶ",709862,28],["ἰσχυραὶ",706855,192],["αἱ",709436,190],["γυναῖκες",703209,191],["ὅτι",709803,7],["οὕτως",709859,28],["πράσσουσιν",710721,197]],"O ye men, how can it be but women should be strong, seeing they do thus?"],["33",[["καὶ",707031,7],["τότε",712908,28],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["οἱ",709436,136],["μεγιστᾶνες",708657,52],["ἐνέβλεπον",704551,137],["ἕτερος",705535,14],["πρὸς",710844,0],["τὸν",709436,5],["ἕτερον",705535,27]],"Then the king and the princes looked one upon another: so he began to speak of the truth."],["34",[["καὶ",707031,7],["ἤρξατο",701860,23],["λαλεῖν",708071,55],["περὶ",710285,0],["τῆς",709436,16],["ἀληθείας",700656,17],["ἄνδρες",701150,274],["οὐχὶ",709862,28],["ἰσχυραὶ",706855,192],["αἱ",709436,190],["γυναῖκες",703209,191],["μεγάλη",708653,29],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["ὑψηλὸς",713285,14],["ὁ",709436,3],["οὐρανός",709844,4],["καὶ",707031,7],["ταχὺς",712750,14],["τῷ",709436,113],["δρόμῳ",703833,114],["ὁ",709436,3],["ἥλιος",705974,4],["ὅτι",709803,7],["στρέφεται",712160,117],["ἐν",704639,0],["τῷ",709436,113],["κύκλῳ",707959,114],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["πάλιν",709942,28],["ἀποτρέχει",701623,91],["εἰς",704105,0],["τὸν",709436,5],["ἑαυτοῦ",703917,102],["τόπον",712903,6],["ἐν",704639,0],["μιᾷ",704106,101],["ἡμέρᾳ",705984,1]],"O ye men, are not women strong? great is the earth, high is the heaven, swift is the sun in his course, for he compasseth the heavens round about, and fetcheth his course again to his own place in one day."],["35",[["οὐχὶ",709862,28],["μέγας",708653,14],["ὃς",709781,213],["ταῦτα",709858,71],["ποιεῖ",710582,91],["καὶ",707031,7],["ἡ",709436,10],["ἀλήθεια",700656,12],["μεγάλη",708653,29],["καὶ",707031,7],["ἰσχυροτέρα",706855,29],["παρὰ",709995,0],["πάντα",710177,68]],"Is he not great that maketh these things? therefore great is the truth, and stronger than all things."],["36",[["πᾶσα",710177,29],["ἡ",709436,10],["γῆ",703083,12],["τὴν",709436,8],["ἀλήθειαν",700656,9],["καλεῖ",707084,91],["καὶ",707031,7],["ὁ",709436,3],["οὐρανὸς",709844,4],["αὐτὴν",702165,104],["εὐλογεῖ",705631,91],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["ἔργα",705396,42],["σείεται",711633,117],["καὶ",707031,7],["τρέμει",712928,91],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["μετ᾿",708780,0],["αὐτοῦ",702165,49],["ἄδικον",700272,26],["οὐθέν",709817,26]],"All the earth calleth upon the truth, and the heaven blesseth it: all works shake and tremble at it, and with it is no unrighteous thing."],["37",[["ἄδικος",700272,14],["ὁ",709436,3],["οἶνος",709530,4],["ἄδικος",700272,14],["ὁ",709436,3],["βασιλεύς",702580,4],["ἄδικοι",700272,192],["αἱ",709436,190],["γυναῖκες",703209,191],["ἄδικοι",700272,138],["πάντες",710177,138],["οἱ",709436,136],["υἱοὶ",713075,52],["τῶν",709436,80],["ἀνθρώπων",701163,81],["καὶ",707031,7],["ἄδικα",700272,195],["πάντα",710177,195],["τὰ",709436,63],["ἔργα",705396,64],["αὐτῶν",702165,40],["πάντα",710177,195],["τὰ",709436,63],["τοιαῦτα",712878,195],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐν",704639,0],["αὐτοῖς",702165,151],["ἀλήθεια",700656,12],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["ἀδικίᾳ",700271,1],["αὐτῶν",702165,40],["ἀπολοῦνται",701513,135]],"Wine is wicked, the king is wicked, women are wicked, all the children of men are wicked; and such are all their wicked works, and there is no truth in them; in their unrighteousness also they shall perish."],["38",[["ἡ",709436,10],["δὲ",703303,11],["ἀλήθεια",700656,12],["μένει",708736,91],["καὶ",707031,7],["ἰσχύει",706859,91],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["ζῇ",705851,91],["καὶ",707031,7],["κρατεῖ",707879,91],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18]],"As for the truth, it endureth, and is always strong; it liveth and conquereth for evermore."],["39",[["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["παρ᾿",709995,0],["αὐτῇ",702165,105],["λαμβάνειν",708076,55],["πρόσωπα",710986,42],["οὐδὲ",709816,7],["διάφορα",703630,68],["ἀλλὰ",700680,7],["τὰ",709436,41],["δίκαια",703694,68],["ποιεῖ",710582,91],["ἀπὸ",701425,0],["πάντων",710177,83],["τῶν",709436,43],["ἀδίκων",700272,83],["καὶ",707031,7],["πονηρῶν",710660,83],["καὶ",707031,7],["πάντες",710177,138],["εὐδοκοῦσι",705565,197],["τοῖς",709436,95],["ἔργοις",705396,96],["αὐτῆς",702165,86],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐν",704639,0],["τῇ",709436,100],["κρίσει",707908,1],["αὐτῆς",702165,86],["οὐθὲν",709817,26],["ἄδικον",700272,26]],"With her there is no accepting of persons or rewards: but she doeth the things that are just, and refraineth from all unjust and wicked things; and all men do well like of her works."],["40",[["καὶ",707031,7],["αὐτῇ",702165,105],["ἡ",709436,10],["ἰσχὺς",706858,12],["καὶ",707031,7],["τὸ",709436,34],["βασίλειον",702579,26],["καὶ",707031,7],["ἡ",709436,10],["ἐξουσία",704974,12],["καὶ",707031,7],["ἡ",709436,10],["μεγαλειότης",708626,12],["τῶν",709436,80],["πάντων",710177,169],["αἰώνων",700504,81],["εὐλογητὸς",705632,14],["ὁ",709436,3],["θεὸς",706192,4],["τῆς",709436,16],["ἀληθείας",700656,17]],"Neither in her judgment is any unrighteousness; and she is the strength, kingdom, power, and majesty of all ages. Blessed be the God of truth."],["41",[["καὶ",707031,7],["ἐσιώπησεν",711818,2],["τοῦ",709436,20],["λαλεῖν",708071,55],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["τότε",712908,28],["ἐφώνησεν",713639,2],["καὶ",707031,7],["τότε",712908,28],["εἶπον",705373,150],["μεγάλη",708653,29],["ἡ",709436,10],["ἀλήθεια",700656,12],["καὶ",707031,7],["ὑπερισχύει",713144,91]],"And with that he held his peace. And all the people then shouted, and said, Great is Truth, and mighty above all things."],["42",[["τότε",712908,28],["ὁ",709436,3],["βασιλεὺς",702580,4],["εἶπεν",705373,2],["αὐτῷ",702165,50],["αἴτησαι",700489,300],["ὃ",709781,128],["θέλεις",706176,154],["πλείω",710514,46],["τῶν",709436,43],["γεγραμμένων",703194,445],["καὶ",707031,7],["δώσομέν",703654,275],["σοι",711925,159],["ὃν",709781,112],["τρόπον",712980,6],["εὑρέθης",705676,168],["σοφώτερος",711985,224],["καὶ",707031,7],["ἐχόμενός",705785,122],["μου",709032,133],["καθήσῃ",707007,123],["καὶ",707031,7],["συγγενής",712185,14],["μου",709032,133],["κληθήσῃ",707084,364]],"Then said the king unto him, Ask what thou wilt more than is appointed in the writings, and we will give it thee, because thou art found wisest; and thou shalt sit next me, and shalt be called my cousin."],["43",[["τότε",712908,28],["εἶπεν",705373,2],["τῷ",709436,113],["βασιλεῖ",702580,114],["μνήσθητι",708960,244],["τὴν",709436,8],["εὐχήν",705726,9],["ἣν",709781,131],["ηὔξω",705727,174],["οἰκοδομῆσαι",709509,106],["τὴν",709436,8],["Ιερουσαλημ",706644,9],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ᾗ",709781,108],["τὸ",709436,24],["βασίλειόν",702578,25],["σου",711945,133],["παρέλαβες",710059,162]],"Then said he unto the king, Remember thy vow, which thou hast vowed to build Jerusalem, in the day when thou camest to thy kingdom,"],["44",[["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["σκεύη",711844,42],["τὰ",709436,41],["λημφθέντα",708076,328],["ἐξ",704132,0],["Ιερουσαλημ",706644,17],["ἐκπέμψαι",704274,106],["ἃ",709781,69],["ἐξεχώρισεν",704372,2],["Κῦρος",707997,4],["ὅτε",709802,28],["ηὔξατο",705727,23],["ἐκκόψαι",704225,106],["Βαβυλῶνα",702352,9],["καὶ",707031,7],["ηὔξατο",705727,23],["ἐξαποστεῖλαι",704872,106],["ἐκεῖ",704181,28]],"and to send away all the vessels that were taken away out of Jerusalem, which Cyrus set apart, when he vowed to destroy Babylon, and to send them again thither."],["45",[["καὶ",707031,7],["σὺ",712181,164],["εὔξω",705727,174],["οἰκοδομῆσαι",709509,106],["τὸν",709436,5],["ναόν",709191,6],["ὃν",709781,112],["ἐνεπύρισαν",704622,150],["οἱ",709436,136],["Ιδουμαῖοι",706504,52],["ὅτε",709802,28],["ἠρημώθη",705421,37],["ἡ",709436,10],["Ιουδαία",706769,12],["ὑπὸ",713184,0],["τῶν",709436,80],["Χαλδαίων",713678,81]],"Thou also hast vowed to build up the temple, which the Edomites burned when Judea was made desolate by the Chaldees."],["46",[["καὶ",707031,7],["νῦν",709384,28],["τοῦτό",709858,132],["ἐστιν",704093,91],["ὅ",709781,128],["σε",711598,163],["ἀξιῶ",701309,157],["κύριε",707996,153],["βασιλεῦ",702580,153],["καὶ",707031,7],["ὃ",709781,128],["αἰτοῦμαί",700489,254],["σε",711598,163],["καὶ",707031,7],["αὕτη",709858,107],["ἐστὶν",704093,91],["ἡ",709436,10],["μεγαλωσύνη",708652,12],["ἡ",709436,10],["παρὰ",709995,0],["σοῦ",711945,133],["δέομαι",703394,254],["οὖν",709835,11],["ἵνα",706747,7],["ποιήσῃς",710582,175],["τὴν",709436,8],["εὐχήν",705726,9],["ἣν",709781,131],["ηὔξω",705727,174],["τῷ",709436,113],["βασιλεῖ",702580,114],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["ποιῆσαι",710582,106],["ἐκ",704132,0],["στόματός",712125,21],["σου",711945,133]],"And now, O lord the king, this is that which I require, and which I desire of thee, and this is the princely liberality proceeding from thyself: I desire therefore that thou make good the vow, the performance whereof with thine own mouth thou hast vowed to the King of heaven."],["47",[["τότε",712908,28],["ἀναστὰς",701173,182],["Δαρεῖος",703292,4],["ὁ",709436,3],["βασιλεὺς",702580,4],["κατεφίλησεν",707476,2],["αὐτὸν",702165,85],["καὶ",707031,7],["ἔγραψεν",703194,2],["αὐτῷ",702165,50],["τὰς",709436,38],["ἐπιστολὰς",705272,39],["πρὸς",710844,0],["πάντας",710177,60],["τοὺς",709436,58],["οἰκονόμους",709514,57],["καὶ",707031,7],["τοπάρχας",712901,57],["καὶ",707031,7],["στρατηγοὺς",712144,57],["καὶ",707031,7],["σατράπας",711555,57],["ἵνα",706747,7],["προπέμψωσιν",710835,234],["αὐτὸν",702165,85],["καὶ",707031,7],["τοὺς",709436,58],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["πάντας",710177,60],["ἀναβαίνοντας",700905,235],["οἰκοδομῆσαι",709509,106],["τὴν",709436,8],["Ιερουσαλημ",706644,9]],"Then Darius the king stood up, and kissed him, and wrote letters for him unto all the treasurers and lieutenants and captains and governors, that they should safely convey on their way both him, and all those that go up with him to build Jerusalem."],["48",[["καὶ",707031,7],["πᾶσι",710177,230],["τοῖς",709436,147],["τοπάρχαις",712901,148],["ἐν",704639,0],["Κοίλῃ",707760,1],["Συρίᾳ",712533,1],["καὶ",707031,7],["Φοινίκῃ",713538,1],["καὶ",707031,7],["τοῖς",709436,147],["ἐν",704639,0],["τῷ",709436,113],["Λιβάνῳ",708185,114],["ἔγραψεν",703194,2],["ἐπιστολὰς",705272,39],["μεταφέρειν",708822,55],["ξύλα",709427,42],["κέδρινα",707589,68],["ἀπὸ",701425,0],["τοῦ",709436,35],["Λιβάνου",708185,18],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["ὅπως",709719,7],["οἰκοδομήσωσιν",709509,234],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["τὴν",709436,8],["πόλιν",710612,9]],"He wrote letters also unto the lieutenants that were in Celosyria and Phenice, and unto them in Libanus, that they should bring cedar wood from Libanus unto Jerusalem, and that they should build the city with him."],["49",[["καὶ",707031,7],["ἔγραψεν",703194,2],["πᾶσι",710177,230],["τοῖς",709436,147],["Ιουδαίοις",706772,148],["τοῖς",709436,147],["ἀναβαίνουσιν",700905,349],["ἀπὸ",701425,0],["τῆς",709436,16],["βασιλείας",702577,17],["εἰς",704105,0],["τὴν",709436,8],["Ιουδαίαν",706769,9],["ὑπὲρ",713111,0],["τῆς",709436,16],["ἐλευθερίας",704427,17],["πάντα",710177,27],["δυνατὸν",703845,27],["καὶ",707031,7],["σατράπην",711555,6],["καὶ",707031,7],["τοπάρχην",712901,6],["καὶ",707031,7],["οἰκονόμον",709514,6],["μὴ",708851,28],["ἐπελεύσεσθαι",705068,492],["ἐπὶ",705080,0],["τὰς",709436,38],["θύρας",706337,39],["αὐτῶν",702165,40]],"Moreover he wrote for all the Jews that went out of his realm up into Jewry, concerning their freedom, that no officer, no ruler, no lieutenant, nor treasurer, should forcibly enter into their doors;"],["50",[["καὶ",707031,7],["πᾶσαν",710177,36],["τὴν",709436,8],["χώραν",714011,9],["ἣν",709781,131],["κρατήσουσιν",707879,218],["ἀφορολόγητον",702231,36],["αὐτοῖς",702165,151],["ὑπάρχειν",713104,55],["καὶ",707031,7],["ἵνα",706747,7],["οἱ",709436,136],["Ιδουμαῖοι",706504,52],["ἀφιῶσι",702211,271],["τὰς",709436,38],["κώμας",708022,39],["ἃς",709781,193],["διακρατοῦσιν",703486,197],["τῶν",709436,80],["Ιουδαίων",706772,81]],"and that all the country which they hold should be free without tribute; and that the Edomites should give over the villages of the Jews which then they held:"],["51",[["καὶ",707031,7],["εἰς",704105,0],["τὴν",709436,8],["οἰκοδομὴν",709510,9],["τοῦ",709436,20],["ἱεροῦ",706633,92],["δοθῆναι",703654,179],["κατ᾿",707200,0],