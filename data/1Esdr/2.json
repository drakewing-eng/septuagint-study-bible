νται",713185,269]],"So all the vessels of gold and of silver, which were carried away, were five thousand four hundred threescore and nine."],["15",[["ἐὰν",703912,7],["οὖν",709835,11],["ἡ",709436,10],["πόλις",710612,12],["αὕτη",709858,107],["οἰκοδομηθῇ",709509,384],["καὶ",707031,7],["τὰ",709436,63],["τείχη",712759,64],["συντελεσθῇ",712510,384],["φορολογίαν",713558,9],["οὐ",709805,28],["μὴ",708851,28],["ὑπομείνωσιν",713219,234],["δοῦναι",703654,106],["ἀλλὰ",700680,7],["καὶ",707031,28],["βασιλεῦσιν",702580,148],["ἀντιστήσονται",701154,135]],"These were brought back by Sanabassar, together with them of the captivity, from Babylon to Jerusalem."],["16",[["καὶ",707031,7],["ἐπεὶ",705054,7],["ἐνεργεῖται",704718,117],["τὰ",709436,41],["κατὰ",707200,0],["τὸν",709436,5],["ναόν",709191,6],["καλῶς",707106,28],["ἔχειν",705785,55],["ὑπολαμβάνομεν",713210,243],["μὴ",708851,28],["ὑπεριδεῖν",713154,106],["τὸ",709436,24],["τοιοῦτο",712878,46],["ἀλλὰ",700680,7],["προσφωνῆσαι",710978,106],["τῷ",709436,113],["κυρίῳ",707996,114],["βασιλεῖ",702580,114],["ὅπως",709719,7],["ἂν",700900,11],["φαίνηταί",713311,428],["σοι",711925,159],["ἐπισκεφθῇ",705250,384],["ἐν",704639,0],["τοῖς",709436,95],["ἀπὸ",701425,0],["τῶν",709436,80],["πατέρων",710189,81],["σου",711945,133],["βιβλίοις",702719,96]],"But in the time of Artaxerxes king of the Persians Belemus, and Mithridates, and Tabellius, and Rathumus, and Beeltethmus, and Samellius the secretary, with the rest that were in commission with them, dwelling in Samaria and other places, wrote unto him against them that dwelt in Judea and Jerusalem this letter following;"],["17",[["καὶ",707031,7],["εὑρήσεις",705676,166],["ἐν",704639,0],["τοῖς",709436,147],["ὑπομνηματισμοῖς",713223,148],["τὰ",709436,41],["γεγραμμένα",703194,388],["περὶ",710285,0],["τούτων",709858,70],["καὶ",707031,7],["γνώσῃ",703105,123],["ὅτι",709803,7],["ἡ",709436,10],["πόλις",710612,12],["ἦν",704093,13],["ἐκείνη",704183,107],["ἀποστάτις",701591,12],["καὶ",707031,7],["βασιλεῖς",702580,52],["καὶ",707031,7],["πόλεις",710612,191],["ἐνοχλοῦσα",704780,188],["καὶ",707031,7],["οἱ",709436,136],["Ιουδαῖοι",706772,52],["ἀποστάται",701590,52],["καὶ",707031,7],["πολιορκίας",710610,17],["συνιστάμενοι",712482,348],["ἐν",704639,0],["αὐτῇ",702165,105],["ἔτι",705538,28],["ἐξ",704132,0],["αἰῶνος",700504,18],["δι᾿",703417,0],["ἣν",709781,131],["αἰτίαν",700492,9],["καὶ",707031,7],["ἡ",709436,10],["πόλις",710612,12],["αὕτη",709858,107],["ἠρημώθη",705421,37]],"To king Artaxerxes our lord, Thy servants, Rathumus the storywriter, and Samellius the scribe, and the rest of their council, and the judges that are in Celosyria and Phenice."],["18",[["νῦν",709384,28],["οὖν",709835,11],["ὑποδείκνυμέν",713192,243],["σοι",711925,159],["κύριε",707996,153],["βασιλεῦ",702580,153],["διότι",703734,7],["ἐὰν",703912,7],["ἡ",709436,10],["πόλις",710612,12],["αὕτη",709858,107],["οἰκοδομηθῇ",709509,384],["καὶ",707031,7],["τὰ",709436,63],["ταύτης",709858,86],["τείχη",712759,64],["ἀνασταθῇ",701173,384],["κάθοδός",707014,12],["σοι",711925,159],["οὐκέτι",709827,28],["ἔσται",704093,93],["εἰς",704105,0],["Κοίλην",707760,9],["Συρίαν",712533,9],["καὶ",707031,7],["Φοινίκην",713538,9]],"Be it now known to the lord the king, that the Jews that are come up from you to us, being come into Jerusalem, that rebellious and wicked city, do build the marketplaces, and repair the walls of it, and do lay the foundation of the temple."],["19",[["τότε",712908,28],["ἀντέγραψεν",701230,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ραούμῳ",711181,114],["τῷ",709436,113],["γράφοντι",703194,379],["τὰ",709436,41],["προσπίπτοντα",710952,237],["καὶ",707031,7],["Βεελτεέμῳ",702626,114],["καὶ",707031,7],["Σαμσαίῳ",711478,114],["γραμματεῖ",703185,114],["καὶ",707031,7],["τοῖς",709436,147],["λοιποῖς",708248,230],["τοῖς",709436,147],["συντασσομένοις",712508,341],["καὶ",707031,7],["οἰκοῦσιν",709499,349],["ἐν",704639,0],["τῇ",709436,100],["Σαμαρείᾳ",711449,1],["καὶ",707031,7],["Συρίᾳ",712533,1],["καὶ",707031,7],["Φοινίκῃ",713538,1],["τὰ",709436,41],["ὑπογεγραμμένα",713189,388]],"Now if this city and the walls thereof be made up again, they will not only refuse to give tribute, but also rebel against kings."],["20",[["ἀνέγνων",700922,155],["τὴν",709436,8],["ἐπιστολήν",705272,9],["ἣν",709781,131],["πεπόμφατε",710246,171],["πρός",710844,0],["με",708618,163]],"And forasmuch as the things pertaining to the temple are now in hand, we think it meet not to neglect such a matter,"],["21",[["ἐπέταξα",705294,155],["οὖν",709835,11],["ἐπισκέψασθαι",705250,109],["καὶ",707031,7],["εὑρέθη",705676,37],["ὅτι",709803,7],["ἐστὶν",704093,91],["ἡ",709436,10],["πόλις",710612,12],["ἐκείνη",704183,107],["ἐξ",704132,0],["αἰῶνος",700504,18],["βασιλεῦσιν",702580,148],["ἀντιπαρατάσσουσα",701262,188],["καὶ",707031,7],["οἱ",709436,136],["ἄνθρωποι",701163,52],["ἀποστάσεις",701588,39],["καὶ",707031,7],["πολέμους",710605,57],["ἐν",704639,0],["αὐτῇ",702165,105],["συντελοῦντες",712510,146]],"but to speak unto our lord the king, to the intent that, if it be thy pleasure, it may be sought out in the books of thy fathers:"],["22",[["καὶ",707031,7],["βασιλεῖς",702580,52],["ἰσχυροὶ",706855,138],["καὶ",707031,7],["σκληροὶ",711861,138],["ἦσαν",704093,137],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["κυριεύοντες",707995,146],["καὶ",707031,7],["φορολογοῦντες",713556,146],["Κοίλην",707760,9],["Συρίαν",712533,9],["καὶ",707031,7],["Φοινίκην",713538,9]],"and thou shalt find in the chronicles what is written concerning these things, and shalt understand that that city was rebellious, troubling both kings and cities:"],["23",[["νῦν",709384,28],["οὖν",709835,11],["ἐπέταξα",705294,155],["ἀποκωλῦσαι",701501,106],["τοὺς",709436,58],["ἀνθρώπους",701163,57],["ἐκείνους",704183,62],["τοῦ",709436,20],["οἰκοδομῆσαι",709509,106],["τὴν",709436,8],["πόλιν",710612,9]],"and that the Jews were rebellious, and raised always wars therein; for the which cause even this city was made desolate."],["24",[["καὶ",707031,7],["προνοηθῆναι",710824,179],["ὅπως",709719,7],["μηθὲν",708857,46],["παρὰ",709995,0],["ταῦτα",709858,71],["γένηται",703104,239],["καὶ",707031,7],["μὴ",708851,28],["προβῇ",710763,172],["ἐπὶ",705080,0],["πλεῖον",710514,46],["τὰ",709436,41],["τῆς",709436,16],["κακίας",707054,17],["εἰς",704105,0],["τὸ",709436,24],["βασιλεῖς",702580,52],["ἐνοχλῆσαι",704780,106]],"Wherefore now we do declare unto thee, O lord the king, that if this city be built again, and the walls thereof set up anew, thou shalt from henceforth have no passage into Celosyria and Phenice."],["25",[["τότε",712908,28],["ἀναγνωσθέντων",700922,249],["τῶν",709436,80],["παρὰ",709995,0],["τοῦ",709436,35],["βασιλέως",702580,18],["Ἀρταξέρξου",701824,18],["γραφέντων",703194,249],["ὁ",709436,3],["Ραουμος",711181,4],["καὶ",707031,7],["Σαμσαῖος",711478,4],["ὁ",709436,3],["γραμματεὺς",703185,4],["καὶ",707031,7],["οἱ",709436,136],["τούτοις",709858,151],["συντασσόμενοι",712508,348],["ἀναζεύξαντες",700941,196],["κατὰ",707200,0],["σπουδὴν",712035,9],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["μεθ᾿",708780,0],["ἵππου",706790,18],["καὶ",707031,7],["ὄχλου",709884,18],["παρατάξεως",710107,17],["ἤρξαντο",701860,189],["κωλύειν",708020,55],["τοὺς",709436,58],["οἰκοδομοῦντας",709509,235]],"Then the king wrote back again to Rathumus the storywriter, to Beeltethmus, to Semellius the scribe, and to the rest that were in commission, and dwellers in Samaria and Syria and Phenice, after this manner;"],["26",[["καὶ",707031,7],["ἤργει",705392,13],["ἡ",709436,10],["οἰκοδομὴ",709510,12],["τοῦ",709436,20],["ἱεροῦ",706633,92],["τοῦ",709436,20],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["μέχρι",708849,0],["τοῦ",709436,20],["δευτέρου",703389,92],["ἔτους",705543,21],["τῆς",709436,16],["βασιλείας",702577,17],["Δαρείου",703292,18],["τοῦ",709436,35],["Περσῶν",710429,81],["βασιλέως",702580,18]],"I have read the epistle which ye have sent unto me: therefore I commanded to make diligent search, and it hath been found that that city was from the beginning practising against kings;"]]