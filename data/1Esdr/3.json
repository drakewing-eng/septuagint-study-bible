[["1",[["καὶ",707031,7],["βασιλεὺς",702580,4],["Δαρεῖος",703292,4],["ἐποίησεν",710582,2],["δοχὴν",703819,9],["μεγάλην",708653,36],["πᾶσιν",710177,230],["τοῖς",709436,147],["ὑπ᾿",713184,0],["αὐτὸν",702165,85],["καὶ",707031,7],["πᾶσιν",710177,230],["τοῖς",709436,147],["οἰκογενέσιν",709508,230],["αὐτοῦ",702165,102],["καὶ",707031,7],["πᾶσιν",710177,230],["τοῖς",709436,147],["μεγιστᾶσιν",708657,148],["τῆς",709436,16],["Μηδίας",708856,17],["καὶ",707031,7],["τῆς",709436,16],["Περσίδος",710431,17]],"Now when Darius reigned, he made a great feast unto all his subjects, and unto all his household, and unto all the princes of Media and Persia,"],["2",[["καὶ",707031,7],["πᾶσιν",710177,230],["τοῖς",709436,147],["σατράπαις",711555,148],["καὶ",707031,7],["στρατηγοῖς",712144,148],["καὶ",707031,7],["τοπάρχαις",712901,148],["τοῖς",709436,147],["ὑπ᾿",713184,0],["αὐτὸν",702165,85],["ἀπὸ",701425,0],["τῆς",709436,16],["Ἰνδικῆς",706750,17],["μέχρι",708849,0],["τῆς",709436,16],["Αἰθιοπίας",700419,17],["ἐν",704639,0],["ταῖς",709436,75],["ἑκατὸν",704136,59],["εἴκοσι",704085,59],["ἑπτὰ",705357,59],["σατραπείαις",711554,76]],"and to all the governors and captains and lieutenants that were under him, from India unto Ethiopia, in the hundred twenty and seven provinces."],["3",[["καὶ",707031,7],["ἐφάγοσαν",705495,150],["καὶ",707031,7],["ἐπίοσαν",710478,150],["καὶ",707031,7],["ἐμπλησθέντες",704592,247],["ἀνέλυσαν",700995,150],["ὁ",709436,3],["δὲ",703303,11],["Δαρεῖος",703292,4],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἀνέλυσεν",700995,2],["εἰς",704105,0],["τὸν",709436,5],["κοιτῶνα",707782,6],["καὶ",707031,7],["ἐκοιμήθη",707767,37],["καὶ",707031,7],["ἔξυπνος",704980,14],["ἐγένετο",703104,23]],"And when they had eaten and drunken, and being satisfied were gone home, then Darius the king went into his bedchamber, and slept, and soon after awaked."],["4",[["τότε",712908,28],["οἱ",709436,136],["τρεῖς",712927,592],["νεανίσκοι",709232,52],["οἱ",709436,136],["σωματοφύλακες",712640,52],["οἱ",709436,136],["φυλάσσοντες",713619,146],["τὸ",709436,24],["σῶμα",712635,25],["τοῦ",709436,35],["βασιλέως",702580,18],["εἶπαν",705373,150],["ἕτερος",705535,14],["πρὸς",710844,0],["τὸν",709436,5],["ἕτερον",705535,27]],"Then three young men, that were of the guard that kept the king's body, spake one to another;"],["5",[["εἴπωμεν",705373,79],["ἕκαστος",704133,14],["ἡμῶν",705999,145],["ἕνα",704106,27],["λόγον",708236,6],["ὃς",709781,213],["ὑπερισχύσει",713144,127],["καὶ",707031,7],["οὗ",709781,48],["ἂν",700900,11],["φανῇ",713311,384],["τὸ",709436,24],["ῥῆμα",711246,25],["αὐτοῦ",702165,102],["σοφώτερον",711985,61],["τοῦ",709436,35],["ἑτέρου",705535,116],["δώσει",703654,127],["αὐτῷ",702165,50],["Δαρεῖος",703292,4],["ὁ",709436,3],["βασιλεὺς",702580,4],["δωρεὰς",703900,39],["μεγάλας",708653,119],["καὶ",707031,7],["ἐπινίκια",705213,68],["μεγάλα",708653,68]],"Let every one of us speak a sentence: he that shall overcome, and whose sentence shall seem wiser than the others, unto him shall the king Darius give great gifts, and great things in token of victory:"],["6",[["καὶ",707031,7],["πορφύραν",710682,9],["περιβαλέσθαι",710294,109],["καὶ",707031,7],["ἐν",704639,0],["χρυσώμασιν",713981,96],["πίνειν",710478,55],["καὶ",707031,7],["ἐπὶ",705080,0],["χρυσῷ",713975,114],["καθεύδειν",706996,55],["καὶ",707031,7],["ἅρμα",701768,25],["χρυσοχάλινον",713978,46],["καὶ",707031,7],["κίδαριν",707668,9],["βυσσίνην",702833,36],["καὶ",707031,7],["μανιάκην",708483,6],["περὶ",710285,0],["τὸν",709436,5],["τράχηλον",712924,6]],"as to be clothed in purple, to drink in gold, and to sleep upon gold, and a chariot with bridles of gold, and an headtire of fine linen, and a chain about his neck:"],["7",[["καὶ",707031,7],["δεύτερος",703389,14],["καθιεῖται",707006,93],["Δαρείου",703292,18],["διὰ",703417,0],["τὴν",709436,8],["σοφίαν",711981,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["συγγενὴς",712185,14],["Δαρείου",703292,18],["κληθήσεται",707084,134]],"and he shall sit next to Darius because of his wisdom, and shall be called Darius's cousin."],["8",[["καὶ",707031,7],["τότε",712908,28],["γράψαντες",703194,196],["ἕκαστος",704133,14],["τὸν",709436,5],["ἑαυτοῦ",703917,102],["λόγον",708236,6],["ἐσφραγίσαντο",712590,189],["καὶ",707031,7],["ἔθηκαν",712849,150],["ὑπὸ",713184,0],["τὸ",709436,24],["προσκεφάλαιον",710917,25],["Δαρείου",703292,18],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["εἶπαν",705373,150]],"And then every one wrote his sentence, sealed it, and laid it under the pillow of king Darius;"],["9",[["ὅταν",709801,28],["ἐγερθῇ",703949,384],["ὁ",709436,3],["βασιλεύς",702580,4],["δώσουσιν",703654,218],["αὐτῷ",702165,50],["τὸ",709436,24],["γράμμα",703183,25],["καὶ",707031,7],["ὃν",709781,112],["ἂν",700900,11],["κρίνῃ",707905,172],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["οἱ",709436,136],["τρεῖς",712927,592],["μεγιστᾶνες",708657,52],["τῆς",709436,16],["Περσίδος",710431,17],["ὅτι",709803,7],["ὁ",709436,3],["λόγος",708236,4],["αὐτοῦ",702165,102],["σοφώτερος",711985,14],["αὐτῷ",702165,50],["δοθήσεται",703654,134],["τὸ",709436,24],["νῖκος",709311,25],["καθὼς",707030,7],["γέγραπται",703194,187]],"and said that, when the king is risen, [some] will give him the writing; and of whose side the king and the three princes of Persia shall judge that his sentence is the wisest, to him shall the victory be given, as was appointed."],["10",[["ὁ",709436,3],["εἷς",704106,596],["ἔγραψεν",703194,2],["ὑπερισχύει",713144,91],["ὁ",709436,3],["οἶνος",709530,4]],"The first wrote, Wine is the strongest."],["11",[["ὁ",709436,3],["ἕτερος",705535,14],["ἔγραψεν",703194,2],["ὑπερισχύει",713144,91],["ὁ",709436,3],["βασιλεύς",702580,4]],"The second wrote, The king is strongest."],["12",[["ὁ",709436,3],["τρίτος",712968,14],["ἔγραψεν",703194,2],["ὑπερισχύουσιν",713144,197],["αἱ",709436,190],["γυναῖκες",703209,191],["ὑπὲρ",713111,0],["δὲ",703303,11],["πάντα",710177,68],["νικᾷ",709309,91],["ἡ",709436,10],["ἀλήθεια",700656,12]],"The third wrote, Women are strongest: but above all things Truth beareth away the victory."],["13",[["καὶ",707031,7],["ὅτε",709802,28],["ἐξηγέρθη",704889,37],["ὁ",709436,3],["βασιλεύς",702580,4],["λαβόντες",708076,196],["τὸ",709436,24],["γράμμα",703183,25],["ἔδωκαν",703654,150],["αὐτῷ",702165,280],["καὶ",707031,7],["ἀνέγνω",700922,2]],"Now when the king was risen up, they took their writings, and delivered [them] unto him, and [so] he read [them]:"],["14",[["καὶ",707031,7],["ἐξαποστείλας",704872,182],["ἐκάλεσεν",707084,2],["πάντας",710177,60],["τοὺς",709436,58],["μεγιστᾶνας",708657,57],["τῆς",709436,16],["Περσίδος",710431,17],["καὶ",707031,7],["τῆς",709436,16],["Μηδίας",708856,17],["καὶ",707031,7],["σατράπας",711555,57],["καὶ",707031,7],["στρατηγοὺς",712144,57],["καὶ",707031,7],["τοπάρχας",712901,57],["καὶ",707031,7],["ὑπάτους",713106,57],["καὶ",707031,7],["ἐκάθισεν",707006,2],["ἐν",704639,0],["τῷ",709436,53],["χρηματιστηρίῳ",713951,54],["καὶ",707031,7],["ἀνεγνώσθη",700922,37],["τὸ",709436,24],["γράμμα",703183,25],["ἐνώπιον",704823,0],["αὐτῶν",702165,40]],"and sending forth he called all the princes of Persia and Media, and the governors, and the captains, and the lieutenants, and the chief officers;"],["15",[["καὶ",707031,7],["εἶπεν",705373,2],["καλέσατε",707084,74],["τοὺς",709436,58],["νεανίσκους",709232,57],["καὶ",707031,7],["αὐτοὶ",702165,201],["δηλώσουσιν",703402,218],["τοὺς",709436,58],["λόγους",708236,57],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐκλήθησαν",707084,99],["καὶ",707031,7],["εἰσήλθοσαν",704114,150]],"and sat him down in the royal seat of judgment; and the writing was read before them."],["16",[["καὶ",707031,7],["εἶπαν",705373,150],["αὐτοῖς",702165,151],["ἀπαγγείλατε",701321,74],["ἡμῖν",705994,90],["περὶ",710285,0],["τῶν",709436,43],["γεγραμμένων",703194,635]],"And he said, Call the young men, and they shall declare their own sentences. So they were called, and came in."],["17",[["καὶ",707031,7],["ἤρξατο",701860,23],["ὁ",709436,3],["πρῶτος",711041,14],["ὁ",709436,3],["εἴπας",705373,182],["περὶ",710285,0],["τῆς",709436,16],["ἰσχύος",706858,17],["τοῦ",709436,35],["οἴνου",709530,18],["καὶ",707031,7],["ἔφη",713437,13],["οὕτως",709859,28]],"And he said unto them, Declare unto us your mind concerning the writings. Then began the first, who had spoken of the strength of wine;"],["18",[["ἄνδρες",701150,274],["πῶς",711121,28],["ὑπερισχύει",713144,91],["ὁ",709436,3],["οἶνος",709530,4],["πάντας",710177,60],["τοὺς",709436,58],["ἀνθρώπους",701163,57],["τοὺς",709436,58],["πίνοντας",710478,235],["αὐτὸν",702165,85],["πλανᾷ",710495,91],["τὴν",709436,8],["διάνοιαν",703531,9]],"and he said thus, O ye men, how exceeding strong is wine! it causeth all men to err that drink it:"],["19",[["τοῦ",709436,35],["τε",712751,11],["βασιλέως",702580,18],["καὶ",707031,7],["τοῦ",709436,35],["ὀρφανοῦ",709779,116],["ποιεῖ",710582,91],["τὴν",709436,8],["διάνοιαν",703531,9],["μίαν",704106,36],["τήν",709436,8],["τε",712751,11],["τοῦ",709436,35],["οἰκέτου",709496,18],["καὶ",707031,7],["τὴν",709436,8],["τοῦ",709436,35],["ἐλευθέρου",704428,116],["τήν",709436,8],["τε",712751,11],["τοῦ",709436,35],["πένητος",710248,18],["καὶ",707031,7],["τὴν",709436,8],["τοῦ",709436,35],["πλουσίου",710560,116]],"it maketh the mind of the king and of the fatherless child to be all one; of the bondman and of the freeman, of the poor man and of the rich:"],["20",[["καὶ",707031,7],["πᾶσαν",710177,36],["διάνοιαν",703531,9],["μεταστρέφει",708817,91],["εἰς",704105,0],["εὐωχίαν",705738,9],["καὶ",707031,7],["εὐφροσύνην",705717,9],["καὶ",707031,7],["οὐ",709805,28],["μέμνηται",708923,187],["πᾶσαν",710177,36],["λύπην",708273,9],["καὶ",707031,7],["πᾶν",710177,46],["ὀφείλημα",709864,25]],"it turneth also every thought into jollity and mirth, so that a man remembereth neither sorrow nor debt:"],["21",[["καὶ",707031,7],["πάσας",710177,119],["καρδίας",707141,39],["ποιεῖ",710582,91],["πλουσίας",710560,119],["καὶ",707031,7],["οὐ",709805,28],["μέμνηται",708923,187],["βασιλέα",702580,6],["οὐδὲ",709816,7],["σατράπην",711555,6],["καὶ",707031,7],["πάντα",710177,27],["διὰ",703417,0],["ταλάντων",712697,44],["ποιεῖ",710582,91],["λαλεῖν",708071,55]],"and it maketh every heart rich, so that a man remembereth neither king nor governor; and it maketh to speak all things by talents:"],["22",[["καὶ",707031,7],["οὐ",709805,28],["μέμνηται",708923,187],["ὅταν",709801,28],["πίνωσιν",710478,271],["φιλιάζειν",713475,55],["φίλοις",713492,230],["καὶ",707031,7],["ἀδελφοῖς",700249,148],["καὶ",707031,7],["μετ᾿",708780,0],["οὐ",709805,28],["πολὺ",710646,46],["σπῶνται",712003,269],["μαχαίρας",708593,39]],"and when they are in their cups, they forget their love both to friends and brethren, and a little after draw out swords:"],["23",[["καὶ",707031,7],["ὅταν",709801,28],["ἀπὸ",701425,0],["τοῦ",709436,35],["οἴνου",709530,18],["γενηθῶσιν",703104,272],["οὐ",709805,28],["μέμνηται",708923,187],["ἃ",709781,69],["ἔπραξαν",710721,150]],"but when they are from the wine, they remember not what they have done."],["24",[["ὦ",714081,88],["ἄνδρες",701150,274],["οὐχ",709805,28],["ὑπερισχύει",713144,91],["ὁ",709436,3],["οἶνος",709530,4],["ὅτι",709803,7],["οὕτως",709859,28],["ἀναγκάζει",700923,91],["ποιεῖν",710582,55],["καὶ",707031,7],["ἐσίγησεν",711767,2],["οὕτως",709859,28],["εἴπας",705373,182]],"O ye men, is not wine the strongest, that enforceth to do thus? And when he had so spoken, he held his peace."]]