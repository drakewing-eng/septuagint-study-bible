[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["τὰ",709436,63],["ὅρια",709749,64],["φυλῆς",713620,17],["Ιουδα",706768,118],["κατὰ",707200,0],["δήμους",703411,57],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["τῶν",709436,43],["ὁρίων",709749,44],["τῆς",709436,16],["Ιδουμαίας",706503,17],["ἀπὸ",701425,0],["τῆς",709436,16],["ἐρήμου",705420,17],["Σιν",711793,118],["ἕως",705792,0],["Καδης",706973,118],["πρὸς",710844,0],["λίβα",708224,6]],"And the borders of the tribe of Juda according to their families were from the borders of Idumea from the wilderness of Sin, as far as Cades southward."],["2",[["καὶ",707031,7],["ἐγενήθη",703104,37],["αὐτῶν",702165,40],["τὰ",709436,63],["ὅρια",709749,64],["ἀπὸ",701425,0],["λιβὸς",708224,18],["ἕως",705792,0],["μέρους",708752,21],["τῆς",709436,16],["θαλάσσης",706069,17],["τῆς",709436,16],["ἁλυκῆς",700732,82],["ἀπὸ",701425,0],["τῆς",709436,16],["λοφιᾶς",708259,17],["τῆς",709436,16],["φερούσης",713428,222],["ἐπὶ",705080,0],["λίβα",708224,6]],"And their borders were from the south as far as a part of the salt sea from the high country that extends southward."],["3",[["καὶ",707031,7],["διαπορεύεται",703551,117],["ἀπέναντι",701389,0],["τῆς",709436,16],["προσαναβάσεως",710851,17],["Ακραβιν",700590,118],["καὶ",707031,7],["ἐκπεριπορεύεται",704276,117],["Σεννα",711689,118],["καὶ",707031,7],["ἀναβαίνει",700905,91],["ἀπὸ",701425,0],["λιβὸς",708224,18],["ἐπὶ",705080,0],["Καδης",706973,227],["Βαρνη",702541,118],["καὶ",707031,7],["ἐκπορεύεται",704293,117],["Ασωρων",702064,118],["καὶ",707031,7],["προσαναβαίνει",710850,91],["εἰς",704105,0],["Αδδαρα",700238,227],["καὶ",707031,7],["περιπορεύεται",710370,117],["τὴν",709436,8],["κατὰ",707200,0],["δυσμὰς",703865,39],["Καδης",706973,9]],"And they proceed before the ascent of Acrabin, and go out round Sena, and go up from the south to Cades Barne; and go out to Asoron, and proceed up to Sarada, and go out by the way that is west of Cades."],["4",[["καὶ",707031,7],["πορεύεται",710667,117],["ἐπὶ",705080,0],["Ασεμωνα",701917,227],["καὶ",707031,7],["διεκβαλεῖ",703657,127],["ἕως",705792,0],["φάραγγος",713351,17],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ἔσται",704093,93],["αὐτοῦ",702165,49],["ἡ",709436,10],["διέξοδος",703668,12],["τῶν",709436,43],["ὁρίων",709749,44],["ἐπὶ",705080,0],["τὴν",709436,8],["θάλασσαν",706069,9],["τοῦτό",709858,132],["ἐστιν",704093,91],["αὐτῶν",702165,40],["ὅρια",709749,64],["ἀπὸ",701425,0],["λιβός",708224,18]],"And they go out to Selmona, and issue at the valley of Egypt; and the termination of its boundaries shall be at the sea: these are their boundaries southward."],["5",[["καὶ",707031,7],["τὰ",709436,63],["ὅρια",709749,64],["ἀπὸ",701425,0],["ἀνατολῶν",701071,65],["πᾶσα",710177,29],["ἡ",709436,10],["θάλασσα",706069,12],["ἡ",709436,10],["ἁλυκὴ",700732,29],["ἕως",705792,0],["τοῦ",709436,35],["Ιορδάνου",706763,18],["καὶ",707031,7],["τὰ",709436,63],["ὅρια",709749,64],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["βορρᾶ",702765,18],["καὶ",707031,7],["ἀπὸ",701425,0],["τῆς",709436,16],["λοφιᾶς",708259,17],["τῆς",709436,16],["θαλάσσης",706069,17],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,20],["μέρους",708752,21],["τοῦ",709436,35],["Ιορδάνου",706763,18]],"And their boundaries eastward [are] all the salt sea as far as Jordan; and their borders from the north, and from the border of the sea, and from part of Jordan—"],["6",[["ἐπιβαίνει",705082,91],["τὰ",709436,63],["ὅρια",709749,64],["ἐπὶ",705080,0],["Βαιθαγλα",702387,227],["καὶ",707031,7],["παραπορεύεται",710094,117],["ἀπὸ",701425,0],["βορρᾶ",702765,18],["ἐπὶ",705080,0],["Βαιθαραβα",702397,227],["καὶ",707031,7],["προσαναβαίνει",710850,91],["τὰ",709436,63],["ὅρια",709749,64],["ἐπὶ",705080,0],["λίθον",708196,6],["Βαιων",702455,118],["υἱοῦ",713075,18],["Ρουβην",711295,118]],"the borders go up to Bæthaglaam, and they go along from the north to Bætharaba, and the borders go on up to the stone of Bæon the son of Ruben."],["7",[["καὶ",707031,7],["προσαναβαίνει",710850,91],["τὰ",709436,63],["ὅρια",709749,64],["ἐπὶ",705080,0],["τὸ",709436,24],["τέταρτον",712811,46],["τῆς",709436,16],["φάραγγος",713351,17],["Αχωρ",702318,118],["καὶ",707031,7],["καταβαίνει",707202,91],["ἐπὶ",705080,0],["Γαλγαλ",702932,227],["ἥ",709781,177],["ἐστιν",704093,91],["ἀπέναντι",701389,0],["τῆς",709436,16],["προσβάσεως",710866,17],["Αδδαμιν",700237,17],["ἥ",709781,177],["ἐστιν",704093,91],["κατὰ",707200,0],["λίβα",708224,6],["τῇ",709436,100],["φάραγγι",713351,1],["καὶ",707031,7],["διεκβαλεῖ",703657,127],["ἐπὶ",705080,0],["τὸ",709436,24],["ὕδωρ",713071,25],["πηγῆς",710450,17],["ἡλίου",705974,18],["καὶ",707031,7],["ἔσται",704093,93],["αὐτοῦ",702165,49],["ἡ",709436,10],["διέξοδος",703668,12],["πηγὴ",710450,12],["Ρωγηλ",711316,118]],"And the borders continue on to the fourth part of the valley of Achor, and go down to Galgal, which is before the approach of Adammin, which is southward in the valley, and terminate at the water of the fountain of the sun; and their going forth shall be the fountain of Rogel."],["8",[["καὶ",707031,7],["ἀναβαίνει",700905,91],["τὰ",709436,63],["ὅρια",709749,64],["εἰς",704105,0],["φάραγγα",713351,9],["Ονομ",709665,118],["ἐπὶ",705080,0],["νώτου",709403,21],["Ιεβους",706517,118],["ἀπὸ",701425,0],["λιβός",708224,18],["αὕτη",709858,107],["ἐστὶν",704093,91],["Ιερουσαλημ",706644,12],["καὶ",707031,7],["διεκβάλλει",703657,91],["τὰ",709436,63],["ὅρια",709749,64],["ἐπὶ",705080,0],["κορυφὴν",707844,9],["ὄρους",709768,21],["ἥ",709781,177],["ἐστιν",704093,91],["κατὰ",707200,0],["πρόσωπον",710986,25],["φάραγγος",713351,17],["Ονομ",709665,118],["πρὸς",710844,0],["θαλάσσης",706069,17],["ἥ",709781,177],["ἐστιν",704093,91],["ἐκ",704132,0],["μέρους",708752,21],["γῆς",703083,17],["Ραφαϊν",711197,118],["ἐπὶ",705080,0],["βορρᾶ",702765,18]],"And the borders go up to the valley of Ennom, behind Jebus southward; this is Jerusalem: and the borders terminate at the top of the mountain, which is before the valley of Ennom toward the sea, which is by the side of the land of Raphain northward."],["9",[["καὶ",707031,7],