[["1",[["τότε",712908,28],["συνεκάλεσεν",712199,2],["Ἰησοῦς",706701,4],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ρουβην",711295,118],["καὶ",707031,7],["τοὺς",709436,58],["υἱοὺς",713075,57],["Γαδ",702872,118],["καὶ",707031,7],["τὸ",709436,24],["ἥμισυ",705998,46],["φυλῆς",713620,17],["Μανασση",708470,118]],"Then Joshua called together the sons of Ruben, and the sons of Gad, and the half tribe of Manasse,"],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["ὑμεῖς",713081,219],["ἀκηκόατε",700587,330],["πάντα",710177,68],["ὅσα",709788,68],["ἐνετείλατο",704791,23],["ὑμῖν",713084,90],["Μωυσῆς",709112,4],["ὁ",709436,3],["παῖς",709932,4],["κυρίου",707996,18],["καὶ",707031,7],["ἐπηκούσατε",705009,265],["τῆς",709436,16],["φωνῆς",713640,17],["μου",709032,133],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἐνετειλάμην",704791,161],["ὑμῖν",713084,90]],"and said to them, Ye have heard all that Moses the servant of the Lord commanded you, and ye have hearkened to my voice in all that he commanded you."],["3",[["οὐκ",709805,28],["ἐγκαταλελοίπατε",703967,330],["τοὺς",709436,58],["ἀδελφοὺς",700249,57],["ὑμῶν",713091,145],["ταύτας",709858,231],["τὰς",709436,38],["ἡμέρας",705984,39],["καὶ",707031,7],["πλείους",710514,119],["ἕως",705792,0],["τῆς",709436,16],["σήμερον",711751,28],["ἡμέρας",705984,17],["ἐφυλάξασθε",713619,345],["τὴν",709436,8],["ἐντολὴν",704802,9],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ὑμῶν",713091,145]],"Ye have not deserted your brethren these many days: until this day ye have kept the commandment of the Lord your God."],["4",[["νῦν",709384,28],["δὲ",703303,11],["κατέπαυσεν",707365,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["τοὺς",709436,58],["ἀδελφοὺς",700249,57],["ἡμῶν",705999,145],["ὃν",709781,112],["τρόπον",712980,6],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["νῦν",709384,28],["οὖν",709835,11],["ἀποστραφέντες",701598,247],["ἀπέλθατε",701398,74],["εἰς",704105,0],["τοὺς",709436,58],["οἴκους",709516,57],["ὑμῶν",713091,145],["καὶ",707031,7],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["τῆς",709436,16],["κατασχέσεως",707451,17],["ὑμῶν",713091,145],["ἣν",709781,131],["ἔδωκεν",703654,2],["ὑμῖν",713084,90],["Μωυσῆς",709112,4],["ἐν",704639,0],["τῷ",709436,53],["πέραν",710280,28],["τοῦ",709436,35],["Ιορδάνου",706763,18]],"And now the Lord our God has given our brethren rest, as he told them: now then return and depart to your homes, and to the land of your possession, which Moses gave you on the other side Jordan."],["5",[["ἀλλὰ",700680,7],["φυλάξασθε",713619,186],["ποιεῖν",710582,55],["σφόδρα",712586,28],["τὰς",709436,38],["ἐντολὰς",704802,39],["καὶ",707031,7],["τὸν",709436,5],["νόμον",709349,6],["ὃν",709781,112],["ἐνετείλατο",704791,23],["ἡμῖν",705994,90],["ποιεῖν",710582,55],["Μωυσῆς",709112,4],["ὁ",709436,3],["παῖς",709932,4],["κυρίου",707996,18],["ἀγαπᾶν",700120,55],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["ὑμῶν",713091,145],["πορεύεσθαι",710667,110],["πάσαις",710177,291],["ταῖς",709436,75],["ὁδοῖς",709458,76],["αὐτοῦ",702165,102],["φυλάξασθαι",713619,109],["τὰς",709436,38],["ἐντολὰς",704802,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["προσκεῖσθαι",710916,110],["αὐτῷ",702165,50],["καὶ",707031,7],["λατρεύειν",708108,55],["αὐτῷ",702165,50],["ἐξ",704132,0],["ὅλης",709597,82],["τῆς",709436,16],["διανοίας",703531,17],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐξ",704132,0],["ὅλης",709597,82],["τῆς",709436,16],["ψυχῆς",714070,17],["ὑμῶν",713091,145]],"But take great heed to do the commands and the law, which Moses the servant of the Lord commanded you to do; to love the Lord our God, to walk in all his ways, to keep his commands, and to cleave to him, and serve him with all your mind, and with all your soul."],["6",[["καὶ",707031,7],["ηὐλόγησεν",705631,2],["αὐτοὺς",702165,62],["Ἰησοῦς",706701,4],["καὶ",707031,7],["ἐξαπέστειλεν",704872,2],["αὐτούς",702165,62],["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["εἰς",704105,0],["τοὺς",709436,58],["οἴκους",709516,57],["αὐτῶν",702165,40]],"And Joshua blessed them, and dismissed them; and they went to their homes."],["7",[["καὶ",707031,7],["τῷ",709436,53],["ἡμίσει",705998,97],["φυλῆς",713620,17],["Μανασση",708470,118],["ἔδωκεν",703654,2],["Μωυσῆς",709112,4],["ἐν",704639,0],["τῇ",709436,100],["Βασανίτιδι",702569,1],["καὶ",707031,7],["τῷ",709436,53],["ἡμίσει",705998,97],["ἔδωκεν",703654,2],["Ἰησοῦς",706701,4],["μετὰ",708780,0],["τῶν",709436,80],["ἀδελφῶν",700249,81],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,53],["πέραν",710280,28],["τοῦ",709436,35],["Ιορδάνου",706763,18],["παρὰ",709995,0],["θάλασσαν",706069,9],["καὶ",707031,7],["ἡνίκα",706008,28],["ἐξαπέστειλεν",704872,2],["αὐτοὺς",702165,62],["Ἰησοῦς",706701,4],["εἰς",704105,0],["τοὺς",709436,58],["οἴκους",709516,57],["αὐτῶν",702165,40],["καὶ",707031,7],["εὐλόγησεν",705631,2],["αὐτούς",702165,62]],"And to [one] half the tribe of Manasse Moses gave a portion in the land of Basan, and to [the other] half Joshua gave a portion with his brethren on the other side of Jordan westward: and when Joshua sent them away to their homes, then he blessed them."],["8",[["καὶ",707031,7],["ἐν",704639,0],["χρήμασιν",713948,96],["πολλοῖς",710646,94],["ἀπήλθοσαν",701398,150],["εἰς",704105,0],["τοὺς",709436,58],["οἴκους",709516,57],["αὐτῶν",702165,40],["καὶ",707031,7],["κτήνη",707934,42],["πολλὰ",710646,68],["σφόδρα",712586,28],["καὶ",707031,7],["ἀργύριον",701707,25],["καὶ",707031,7],["χρυσίον",713972,25],["καὶ",707031,7],["σίδηρον",711774,6],["καὶ",707031,7],["ἱματισμὸν",706744,6],["πολύν",710646,27],["καὶ",707031,7],["διείλαντο",703459,189],["τὴν",709436,8],["προνομὴν",710827,9],["τῶν",709436,80],["ἐχθρῶν",705779,81],["μετὰ",708780,0],["τῶν",709436,80],["ἀδελφῶν",700249,81],["αὐτῶν",702165,40]],"And they departed with much wealth to their houses, and they divided the spoil of their enemies with their brethren; very much cattle, and silver, and gold, and iron, and much raiment."],["9",[["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["