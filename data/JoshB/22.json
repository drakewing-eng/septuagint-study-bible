λ",706839,18],["λεγόντων",708124,170],["ἰδοὺ",706497,88],["ᾠκοδόμησαν",709509,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Γαδ",702872,118],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["Ρουβην",711295,118],["καὶ",707031,7],["τὸ",709436,34],["ἥμισυ",705998,26],["φυλῆς",713620,17],["Μανασση",708470,118],["βωμὸν",702840,6],["ἐφ᾿",705080,0],["ὁρίων",709749,44],["γῆς",703083,17],["Χανααν",713708,118],["ἐπὶ",705080,0],["τοῦ",709436,35],["Γαλααδ",702920,18],["τοῦ",709436,35],["Ιορδάνου",706763,18],["ἐν",704639,0],["τῷ",709436,53],["πέραν",710280,28],["υἱῶν",713075,81],["Ισραηλ",706839,18]],"And the children of Israel heard say, Behold, the sons of Ruben, and the sons of Gad, and the half tribe of Manasse have built an altar at the borders of the land of Chanaan at Galaad of Jordan, on the opposite side to the children of Israel."],["12",[["καὶ",707031,7],["συνηθροίσθησαν",712378,99],["πάντες",710177,138],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["εἰς",704105,0],["Σηλω",711738,227],["ὥστε",714164,7],["ἀναβάντες",700905,196],["ἐκπολεμῆσαι",704290,106],["αὐτούς",702165,62]],"And all the children of Israel gathered together to Selo, so as to go up and fight against them."],["13",[["καὶ",707031,7],["ἀπέστειλαν",701592,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["πρὸς",710844,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ρουβην",711295,118],["καὶ",707031,7],["πρὸς",710844,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["Γαδ",702872,118],["καὶ",707031,7],["πρὸς",710844,0],["τὸ",709436,24],["ἥμισυ",705998,46],["φυλῆς",713620,17],["Μανασση",708470,118],["εἰς",704105,0],["γῆν",703083,9],["Γαλααδ",702920,118],["τόν",709436,5],["τε",712751,11],["Φινεες",713510,6],["υἱὸν",713075,6],["Ελεαζαρ",704407,118],["υἱοῦ",713075,18],["Ααρων",700005,18],["τοῦ",709436,35],["ἀρχιερέως",701845,18]],"And the children of Israel sent to the sons of Ruben, and the sons of Gad, and to the sons of the half tribe of Manasse into the land of Galaad, both Phinees the son of Eleazar the son of Aaron the priest,"],["14",[["καὶ",707031,7],["δέκα",703333,59],["τῶν",709436,80],["ἀρχόντων",701862,81],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἄρχων",701862,4],["εἷς",704106,14],["ἀπὸ",701425,0],["οἴκου",709516,18],["πατριᾶς",710192,17],["ἀπὸ",701425,0],["πασῶν",710177,198],["φυλῶν",713620,65],["Ισραηλ",706839,18],["ἄρχοντες",701862,52],["οἴκων",709516,81],["πατριῶν",710192,65],["εἰσιν",704093,197],["χιλίαρχοι",713857,52],["Ισραηλ",706839,18]],"and ten of the chiefs with him; [there was] one chief of every household out of all the tribes of Israel; (the heads of families are the captains of thousands in Israel.)"],["15",[["καὶ",707031,7],["παρεγένοντο",710006,189],["πρὸς",710844,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["Γαδ",702872,118],["καὶ",707031,7],["πρὸς",710844,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ρουβην",711295,118],["καὶ",707031,7],["πρὸς",710844,0],["τοὺς",709436,58],["ἡμίσεις",705998,60],["φυλῆς",713620,17],["Μανασση",708470,118],["εἰς",704105,0],["γῆν",703083,9],["Γαλααδ",702920,118],["καὶ",707031,7],["ἐλάλησαν",708071,150],["πρὸς",710844,0],["αὐτοὺς",702165,62],["λέγοντες",708124,146]],"And they came to the sons of Ruben, and to the sons of Gad, and to the half tribe of Manasse into the land of Galaad; and they spoke to them, saying,"],["16",[["τάδε",709446,71],["λέγει",708124,91],["πᾶσα",710177,29],["ἡ",709436,10],["συναγωγὴ",712376,12],["κυρίου",707996,18],["τίς",712867,359],["ἡ",709436,10],["πλημμέλεια",710533,12],["αὕτη",709858,107],["ἣν",709781,131],["ἐπλημμελήσατε",710534,265],["ἐναντίον",704654,0],["τοῦ",709436,35],["θεοῦ",706192,18],["Ισραηλ",706839,18],["ἀποστραφῆναι",701598,179],["σήμερον",711751,28],["ἀπὸ",701425,0],["κυρίου",707996,18],["οἰκοδομήσαντες",709509,196],["ὑμῖν",713084,90],["ἑαυτοῖς",703917,151],["βωμὸν",702840,6],["ἀποστάτας",701590,57],["ὑμᾶς",713080,194],["γενέσθαι",703104,109],["ἀπὸ",701425,0],["κυρίου",707996,18]],"Thus says the whole congregation of the Lord, What [is] this transgression that ye have transgressed before the God of Israel, to turn away today from the Lord, in that ye have built for yourselves an altar, so that ye should be apostates from the Lord?"],["17",[["μὴ",708851,28],["μικρὸν",708915,26],["ἡμῖν",705994,90],["τὸ",709436,34],["ἁμάρτημα",700774,15],["Φογωρ",713535,118],["ὅτι",709803,7],["οὐκ",709805,28],["ἐκαθαρίσθημεν",706985,485],["ἀπ᾿",701425,0],["αὐτοῦ",702165,49],["ἕως",705792,0],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86],["καὶ",707031,7],["ἐγενήθη",703104,37],["πληγὴ",710527,12],["ἐν",704639,0],["τῇ",709436,100],["συναγωγῇ",712376,1],["κυρίου",707996,18]],"Is the sin of Phogor too little for you, whereas we have not been cleansed from it until this day, though there was a plague among the congregation of the Lord?"],["18",[["καὶ",707031,7],["ὑμεῖς",713081,219],["ἀποστραφήσεσθε",701598,261],["σήμερον",711751,28],["ἀπὸ",701425,0],["κυρίου",707996,18],["καὶ",707031,7],["ἔσται",704093,93],["ἐὰν",703912,7],["ἀποστῆτε",702214,125],["σήμερον",711751,28],["ἀπὸ",701425,0],["κυρίου",707996,18],["καὶ",707031,7],["αὔριον",702149,28],["ἐπὶ",705080,0],["πάντα",710177,27],["Ισραηλ",706839,114],["ἔσται",704093,93],["ἡ",709436,10],["ὀργή",709728,12]],"And ye have this day revolted from the Lord; and it shall come to pass if ye revolt this day from the Lord, that to-morrow there shall be wrath upon all Israel."],["19",[["καὶ",707031,7],["νῦν",709384,28],["εἰ",704071,7],["μικρὰ",708915,29],["ὑμῖν",713084,90],["ἡ",709436,10],["γῆ",703083,12],["τῆς",709436,16],["κατασχέσεως",707451,17],["ὑμῶν",713091,145],["διάβητε",703419,74],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["τῆς",709436,16],["κατασχέσεως",707451,17],["κυρίου",707996,18],["οὗ",709806,28],["κατασκηνοῖ",707423,91],["ἐκεῖ",704181,28],["ἡ",709436,10],["σκηνὴ",711845,12],["κυρίου",707996,18],["καὶ",707031,7],["κατακληρονομήσατε",707274,74],["ἐν",704639,0],["ἡμῖν",705994,90],["καὶ",707031,7],["μὴ",708851,28],["ἀποστάται",701590,52],["ἀπὸ",701425,0],["θεοῦ",706192,18]