39,0],["ταῖς",709436,75],["θυσίαις",706345,76],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["θυσίαις",706345,76],["τῶν",709436,80],["σωτηρίων",712659,44],["ἡμῶν",705999,145],["καὶ",707031,7],["οὐκ",709805,28],["ἐροῦσιν",705415,218],["τὰ",709436,63],["τέκνα",712761,64],["ὑμῶν",713091,145],["τοῖς",709436,95],["τέκνοις",712761,96],["ἡμῶν",705999,145],["αὔριον",702149,28],["οὐκ",709805,28],["ἔστιν",704093,91],["ὑμῖν",713084,90],["μερὶς",708748,12],["κυρίου",707996,18]],"but that this may be a witness between you and us, and between our posterity after us, that we may do service to the Lord before him, with our burnt-offerings and our meat-offerings and our peace-offerings: so your sons shall not say to our sons, hereafter, Ye have no portion in the Lord."],["28",[["καὶ",707031,7],["εἴπαμεν",705415,289],["ἐὰν",703912,7],["γένηταί",703104,239],["ποτε",710695,28],["καὶ",707031,7],["λαλήσωσιν",708071,234],["πρὸς",710844,0],["ἡμᾶς",705981,194],["καὶ",707031,7],["ταῖς",709436,75],["γενεαῖς",703037,76],["ἡμῶν",705999,145],["αὔριον",702149,28],["καὶ",707031,7],["ἐροῦσιν",705415,218],["ἴδετε",709725,74],["ὁμοίωμα",709629,25],["τοῦ",709436,20],["θυσιαστηρίου",706348,21],["κυρίου",707996,18],["ὃ",709781,128],["ἐποίησαν",710582,150],["οἱ",709436,136],["πατέρες",710189,52],["ἡμῶν",705999,145],["οὐχ",709805,28],["ἕνεκεν",704709,0],["καρπωμάτων",707174,44],["οὐδὲ",709816,7],["ἕνεκεν",704709,0],["θυσιῶν",706345,65],["ἀλλὰ",700680,7],["μαρτύριόν",708525,15],["ἐστιν",704093,91],["ἀνὰ",700902,0],["μέσον",708768,46],["ὑμῶν",713091,145],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,46],["ἡμῶν",705999,145],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,46],["τῶν",709436,80],["υἱῶν",713075,81],["ἡμῶν",705999,145]],"And we said, If ever it should come to pass that they should speak [so] to us, or to our posterity hereafter; then shall they say, Behold the likeness of the altar of the Lord, which our fathers made, not for the sake of burnt-offerings, nor for the sake of meat-offerings, but it is a witness between you and us, and between our sons."],["29",[["μὴ",708851,28],["γένοιτο",703104,382],["οὖν",709835,11],["ἡμᾶς",705981,194],["ἀποστραφῆναι",701598,179],["ἀπὸ",701425,0],["κυρίου",707996,18],["ἐν",704639,0],["ταῖς",709436,75],["σήμερον",711751,28],["ἡμέραις",705984,76],["ἀποστῆναι",702214,106],["ἀπὸ",701425,0],["κυρίου",707996,18],["ὥστε",714164,7],["οἰκοδομῆσαι",709509,106],["ἡμᾶς",705981,194],["θυσιαστήριον",706348,25],["τοῖς",709436,95],["καρπώμασιν",707174,96],["καὶ",707031,7],["ταῖς",709436,75],["θυσίαις",706345,76],["σαλαμιν",711401,118],["καὶ",707031,7],["τῇ",709436,100],["θυσίᾳ",706345,1],["τοῦ",709436,35],["σωτηρίου",712659,21],["πλὴν",710540,0],["τοῦ",709436,20],["θυσιαστηρίου",706348,21],["κυρίου",707996,18],["ὅ",709781,33],["ἐστιν",704093,91],["ἐναντίον",704654,0],["τῆς",709436,16],["σκηνῆς",711845,17],["αὐτοῦ",702165,102]],"Far be it from us therefore that we should turn away from the Lord this day so as to apostatize from the Lord, so as that we should build an altar for burnt-offerings, and for peace-offerings, besides the altar of the Lord which is before his tabernacle."],["30",[["καὶ",707031,7],["ἀκούσας",700587,182],["Φινεες",713510,120],["ὁ",709436,3],["ἱερεὺς",706614,4],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["ἄρχοντες",701862,52],["τῆς",709436,16],["συναγωγῆς",712376,17],["Ισραηλ",706839,18],["οἳ",709781,250],["ἦσαν",704093,137],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["τοὺς",709436,58],["λόγους",708236,57],["οὓς",709781,298],["ἐλάλησαν",708071,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ρουβην",711295,118],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["Γαδ",702872,118],["καὶ",707031,7],["τὸ",709436,34],["ἥμισυ",705998,26],["φυλῆς",713620,17],["Μανασση",708470,118],["καὶ",707031,7],["ἤρεσεν",701722,2],["αὐτοῖς",702165,151]],"And Phinees the priest and all the chiefs of the congregation of Israel who were with him heard the words which the children of Ruben, and the children of Gad, and the half tribe of Manasse spoke; and it pleased them."],["31",[["καὶ",707031,7],["εἶπεν",705373,2],["Φινεες",713510,120],["ὁ",709436,3],["ἱερεὺς",706614,4],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ρουβην",711295,118],["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["Γαδ",702872,118],["καὶ",707031,7],["τῷ",709436,53],["ἡμίσει",705998,97],["φυλῆς",713620,17],["Μανασση",708470,118],["σήμερον",711751,28],["ἐγνώκαμεν",703105,314],["ὅτι",709803,7],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["κύριος",707996,4],["διότι",703734,7],["οὐκ",709805,28],["ἐπλημμελήσατε",710534,265],["ἐναντίον",704654,0],["κυρίου",707996,18],["πλημμέλειαν",710533,9],["καὶ",707031,7],["ὅτι",709803,7],["ἐρρύσασθε",711309,345],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ισραηλ",706839,18],["ἐκ",704132,0],["χειρὸς",713787,17],["κυρίου",707996,18]],"And Phinees the priest said to the sons of Ruben, and to the sons of Gad, and to the half of the tribe of Manasse, To-day we know that the Lord [is] with us, because ye have not trespassed grievously against the Lord, and because ye have delivered the children of Israel out of the hand of the Lord."],["32",[["καὶ",707031,7],["ἀπέστρεψεν",701598,2],["Φινεες",713510,120],["ὁ",709436,3],["ἱερεὺς",706614,4],["καὶ",707031,7],["οἱ",709436,136],["ἄρχοντες",701862,52],["ἀπὸ",701425,0],["τῶν",709436,80],["υἱῶν",713075,81],["Ρουβην",711295,118],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,80],["υἱῶν",713075,81],["Γαδ",702872,118],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,20],["ἡμίσους",705998,92],["φυλῆς",713620,17],["Μανασση",708470,118],["ἐκ",704132,0],["γῆς",703083,17],["Γαλααδ",702920,118],["εἰς",704105,0],["γῆν",703083,9],["Χανααν",713708,118],["πρὸς",710844,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ισραηλ",706839,18],["καὶ",707031,7],["ἀπεκρίθησαν",701492,99],["αὐτοῖς",702165,151],["τοὺς",709436,58],["λόγους",708236,57]],"So Phinees the priest and the princes departed from the children of Ruben, and from the children of Gad, and from the half tribe of Manasse out of Galaad into the land of Chanaan to the children of Israel; and reported the words to them."],["33",[["καὶ",707031,7],["ἤρεσεν",701722,2],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐλάλησαν",708071,150],["πρὸς",710844,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ισραηλ",706839,18],["καὶ",707031,7],["εὐλόγησαν",705631,150],["τὸν",709436,5],["θεὸν",706192,6],["υἱῶν",713075,81],["Ισραηλ",706839,18],["καὶ",707031,7],["εἶπαν",705373,150],["μηκέτι",708867,28],["ἀναβῆναι",700905,106],["πρὸς",710844,0],["αὐτοὺς",702165,62],["εἰς",704105,0],["πόλεμον",710605,6],["ἐξολεθρεῦσαι",704956,106],["τὴν",709436,8],["γῆν",703083,9],["τῶν",709436,80],["υἱῶν",713075,81],["Ρουβην",711295,118],["καὶ",707031,7],["τῶν",709436,80],["υἱῶν",713075,81],["Γαδ",702872,118],["καὶ",707031,7],["τοῦ",709436,20],["ἡμίσους",705998,92],["φυλῆς",713620,17],["Μανασση",708470,118],["καὶ",707031,7],["κατῴκησαν",707534,150],["ἐπ᾿",705080,0],["αὐτῆς",702165,86]],"And it pleased the children of Israel; and they spoke to the children of Israel, and blessed the God of the children of Israel, and told them to go up no more to war against the others to destroy the land of the children of Ruben, and the children of Gad, and the half tribe of Manasse: so they dwelt upon it."],["34",[["καὶ",707031,7],["ἐπωνόμασεν",705348,2],["Ἰησοῦς",706701,4],["τὸν",709436,5],["βωμὸν",702840,6],["τῶν",709436,80],["Ρουβην",711295,81],["καὶ",707031,7],["τῶν",709436,80],["Γαδ",702872,81],["καὶ",707031,7],["τοῦ",709436,20],["ἡμίσους",705998,92],["φυλῆς",713620,17],["Μανασση",708470,118],["καὶ",707031,7],["εἶπεν",705373,2],["ὅτι",709803,7],["μαρτύριόν",708525,15],["ἐστιν",704093,91],["ἀνὰ",700902,0],["μέσον",708768,46],["αὐτῶν",702165,40],["ὅτι",709803,7],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["αὐτῶν",702165,40],["ἐστιν",704093,91]],"And Joshua gave a name to the altar of the children of Ruben, and the children of Gad, and of the half tribe of Manasse; and said, It is a testimony in the midst of them, that the Lord is their God."]]