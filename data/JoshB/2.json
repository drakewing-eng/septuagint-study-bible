[["1",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Ἰησοῦς",706701,4],["υἱὸς",713075,4],["Ναυη",709206,18],["ἐκ",704132,0],["Σαττιν",711557,228],["δύο",703849,59],["νεανίσκους",709232,57],["κατασκοπεῦσαι",707426,106],["λέγων",708124,72],["ἀνάβητε",700905,74],["καὶ",707031,7],["ἴδετε",709725,74],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["τὴν",709436,8],["Ιεριχω",706620,9],["καὶ",707031,7],["πορευθέντες",710667,247],["εἰσήλθοσαν",704114,150],["οἱ",709436,136],["δύο",703849,59],["νεανίσκοι",709232,52],["εἰς",704105,0],["Ιεριχω",706620,9],["καὶ",707031,7],["εἰσήλθοσαν",704114,150],["εἰς",704105,0],["οἰκίαν",709505,9],["γυναικὸς",703209,17],["πόρνης",710675,17],["ᾗ",709781,108],["ὄνομα",709666,15],["Ρααβ",711123,120],["καὶ",707031,7],["κατέλυσαν",707323,150],["ἐκεῖ",704181,28]],"And Joshua the son of Naue sent out of Sattin two young men to spy [the land], saying, Go up and view the land and Jericho: and the two young men went and entered into Jericho; and they entered into the house of a harlot, whose name [was] Raab, and lodged there."],["2",[["καὶ",707031,7],["ἀπηγγέλη",701321,37],["τῷ",709436,113],["βασιλεῖ",702580,114],["Ιεριχω",706620,17],["λέγοντες",708124,146],["εἰσπεπόρευνται",704124,255],["ὧδε",714090,28],["ἄνδρες",701150,52],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["κατασκοπεῦσαι",707426,106],["τὴν",709436,8],["γῆν",703083,9]],"And it was reported to the king of Jericho, saying, Men of the sons of Israel have come in hither to spy the land."],["3",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ιεριχω",706620,17],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["Ρααβ",711123,227],["λέγων",708124,72],["ἐξάγαγε",704834,176],["τοὺς",709436,58],["ἄνδρας",701150,57],["τοὺς",709436,58],["εἰσπεπορευμένους",704124,360],["εἰς",704105,0],["τὴν",709436,8],["οἰκίαν",709505,9],["σου",711945,133],["τὴν",709436,8],["νύκτα",709386,9],["κατασκοπεῦσαι",707426,106],["γὰρ",702963,11],["τὴν",709436,8],["γῆν",703083,9],["ἥκασιν",705956,353]],"And the king of Jericho sent and spoke to Raab, saying, Bring out the men that entered into thine house this night; for they are come to spy out the land."],["4",[["καὶ",707031,7],["λαβοῦσα",708076,149],["ἡ",709436,10],["γυνὴ",703209,12],["τοὺς",709436,58],["ἄνδρας",701150,57],["ἔκρυψεν",707923,2],["αὐτοὺς",702165,62],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["λέγουσα",708124,188],["εἰσεληλύθασιν",704114,353],["πρός",710844,0],["με",708618,163],["οἱ",709436,136],["ἄνδρες",701150,52]],"And the woman took the two men and hid them; and she spoke to the messengers, saying, The men came in to me,"],["5",[["ὡς",714148,7],["δὲ",703303,11],["ἡ",709436,10],["πύλη",711082,12],["ἐκλείετο",707710,19],["ἐν",704639,0],["τῷ",709436,53],["σκότει",711889,54],["καὶ",707031,7],["οἱ",709436,136],["ἄνδρες",701150,52],["ἐξῆλθον",704909,150],["οὐκ",709805,28],["ἐπίσταμαι",705264,254],["ποῦ",710706,28],["πεπόρευνται",710667,255],["καταδιώξατε",707243,74],["ὀπίσω",709697,0],["αὐτῶν",702165,40],["εἰ",704071,7],["καταλήμψεσθε",707300,124],["αὐτούς",702165,62]],"but when the gate was shut in the evening, the men went out; I know not whither they are gone: follow after them, if ye may overtake them."],["6",[["αὐτὴ",702165,107],["δὲ",703303,11],["ἀνεβίβασεν",700910,2],["αὐτοὺς",702165,62],["ἐπὶ",705080,0],["τὸ",709436,24],["δῶμα",703896,25],["καὶ",707031,7],["ἔκρυψεν",707923,2],["αὐτοὺς",702165,62],["ἐν",704639,0],["τῇ",709436,100],["λινοκαλάμῃ",708212,1],["τῇ",709436,100],["ἐστοιβασμένῃ",712115,470],["αὐτῇ",702165,105],["ἐπὶ",705080,0],["τοῦ",709436,20],["δώματος",703896,21]],"But she [had] brought them up upon the house, and hid them in the flax-stalks that were spread by her on the house."],["7",[["καὶ",707031,7],["οἱ",709436,136],["ἄνδρες",701150,52],["κατεδίωξαν",707243,150],["ὀπίσω",709697,0],["αὐτῶν",702165,40],["ὁδὸν",709458,9],["τὴν",709436,8],["ἐπὶ",705080,0],["τοῦ",709436,35],["Ιορδάνου",706763,18],["ἐπὶ",705080,0],["τὰς",709436,38],["διαβάσεις",703421,39],["καὶ",707031,7],["ἡ",709436,10],["πύλη",711082,12],["ἐκλείσθη",707710,37],["καὶ",707031,7],["ἐγένετο",703104,23],["ὡς",714148,7],["ἐξήλθοσαν",704909,150],["οἱ",709436,136],["διώκοντες",703768,146],["ὀπίσω",709697,0],["αὐτῶν",702165,40]],"And the men followed after them in the way to Jordan to the fords; and the gate was shut.",{"s":"d","q":0.68}],["8",[["καὶ",707031,7],["αὐτοὶ",702165,201],["δὲ",703303,11],["πρὶν",710742,28],["ἢ",705924,7],["κοιμηθῆναι",707767,179],["αὐτούς",702165,62],["καὶ",707031,7],["αὐτὴ",702165,107],["ἀνέβη",700905,2],["ἐπὶ",705080,0],["τὸ",709436,24],["δῶμα",703896,25],["πρὸς",710844,0],["αὐτοὺς",702165,62]],"And it came to pass when the men who pursued after them were gone forth, and before the spies had lain down to sleep, that she came up to them on the top of the house;",{"s":"d","q":0.65}],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτούς",702165,62],["ἐπίσταμαι",705264,254],["ὅτι",709803,7],["δέδωκεν",703654,171],["ὑμῖν",713084,90],["κύριος",707996,4],["τὴν",709436,8],["γῆν",703083,9],["ἐπιπέπτωκεν",705225,171],["γὰρ",702963,11],["ὁ",709436,3],["φόβος",713534,4],["ὑμῶν",713091,145],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194]],"and she said to them, I know that the Lord has given you the land; for the fear of you has fallen upon us."],["10",[["ἀκηκόαμεν",700587,314],["γὰρ",702963,11],["ὅτι",709803,7],["κατεξήρανεν",712298,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τὴν",709436,8],["ἐρυθρὰν",705447,36],["θάλασσαν",706069,9],["ἀπὸ",701425,0],["προσώπου",710986,21],["ὑμῶν",713091,145],["ὅτε",709802,28],["ἐξεπορεύεσθε",704293,501],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ὅσα",709788,68],["ἐποίησεν",710582,2],["τοῖς",709436,147],["δυσὶ",703849,223],["βασιλεῦσιν",702580,148],["τῶν",709436,80],["Αμορραίων",700865,81],["οἳ",709781,250],["ἦσαν",704093,137],["πέραν",710280,0],["τοῦ",709436,35],["Ιορδάνου",706763,18],["τῷ",709436,113],["Σηων",711759,111],["καὶ",707031,7],["Ωγ",714088,111],["οὓς",709781,298],["ἐξωλεθρεύσατε",704956,265],["αὐτούς",702165,62]],"For we have heard that the Lord God dried up the Red Sea before you, when ye came out of the land of Egypt, and all that he did to the two kings of the Amorites, who were beyond Jordan, to Seon and Og, whom ye utterly destroyed."],["11",[["καὶ",707031,7],["ἀκούσαντες",700587,196],["ἡμεῖς",705983,219],["ἐξέστημεν",704940,289],["τῇ",709436,100],["καρδίᾳ",707141,1],["ἡμῶν",705999,145],["καὶ",707031,7],["οὐκ",709805,28],["ἔστη",706846,2],["ἔτι",705538,28],["πνεῦμα",710566,15],["ἐν",704639,0],["οὐδενὶ",709817,30],["ἡμῶν",705999,145],["ἀπὸ",701425,0],["προσώπου",710986,21],["ὑμῶν",713091,145],["ὅτι",709803,7],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["θεὸς",706192,4],["ἐν",704639,0],["οὐρανῷ",709844,114],["ἄνω",701296,28],["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["κάτω",707557,28]],"And when we heard it we were amazed in our heart, and there was no longer any spirit in any of us because of you, for the Lord your God [is] God in heaven above, and on the earth beneath."],["12",[["καὶ",707031,7],["νῦν",709384,28],["ὀμόσατέ",709620,74],["μοι",708974,159],["κύριον",707996,6],["τὸν",709436,5],["θεόν",706192,6],["ὅτι",709803,7],["ποιῶ",710582,157],["ὑμῖν",713084,90],["ἔλεος",704426,25],["καὶ",707031,7],["ποιήσετε",710582,337],["καὶ",707031,28],["ὑμεῖς",713081,219],["ἔλεος",704426,25],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133]],"And now swear to me by the Lord God; since I deal mercifully with you, so do ye also deal mercifully with the house of my father:"],["13",[["καὶ",707031,7],["ζωγρήσετε",705906,337],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133],["καὶ",707031,7],["τὴν",709436,8],["μητέρα",708892,9],["μου",709032,133],["καὶ",707031,7],["τοὺς",709436,58],["ἀδελφούς",700249,57],["μου",709032,133],["καὶ",707031,7],["πάντα",710177,27],["τὸν",709436,5],["οἶκόν",709516,6],["μου",709032,133],["καὶ",707031,7],["πάντα",710177,68],["ὅσα",709788,195],["ἐστὶν",704093,91],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἐξελεῖσθε",704838,124],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἐκ",704132,0],["θανάτου",706096,18]],"and save alive the house of my father, my mother, and my brethren, and all my house, and all that they have, and ye shall rescue my soul from death."],["14",[["καὶ",707031,7],["εἶπαν",705373,150],["αὐτῇ",702165,105],["οἱ",709436,136],["ἄνδρες",701150,52],["ἡ",709436,10],["ψυχὴ",714070,12],["ἡμῶν",705999,145],["ἀνθ᾿",701227,0],["ὑμῶν",713091,145],["εἰς",704105,0],["θάνατον",706096,6],["καὶ",707031,7],["αὐτὴ",702165,107],["εἶπεν",705373,2],["ὡς",714148,7],["ἂν",700900,11],["παραδῷ",710014,172],["κύριος",707996,4],["ὑμῖν",713084,90],["τὴν",709436,8],["πόλιν",710612,9],["ποιήσετε",710582,337],["εἰς",704105,0],["ἐμὲ",704555,163],["ἔλεος",704426,25],["καὶ",707031,7],["ἀλήθειαν",700656,9]],"And the men said to her, Our life for yours [even] to death: and she said, When the Lord shall have delivered the city to you, ye shall deal mercifully and truly with me."],["15",[["καὶ",707031,7],["κατεχάλασεν",707489,2],["αὐτοὺς",702165,62],["διὰ",703417,0],["τῆς",709436,16],["θυρίδος",706340,17]],"And she let them down by the window;"],["16",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["εἰς",704105,0],["τὴν",709436,8],["ὀρεινὴν",709733,9],["ἀπέλθετε",701398,74],["μὴ",708851,28],["συναντήσωσιν",712394,234],["ὑμῖν",713084,90],["οἱ",709436,136],["καταδιώκοντες",707243,146],["καὶ",707031,7],["κρυβήσεσθε",707923,261],["ἐκεῖ",704181,28],["τρεῖς",712927,119],["ἡμέρας",705984,39],["ἕως",705792,7],["ἂν",700900,11],["ἀποστρέψωσιν",701598,234],["οἱ",709436,136],["καταδιώκοντες",707243,146],["ὀπίσω",709697,0],["ὑμῶν",713091,145],["καὶ",707031,7],["μετὰ",708780,0],["ταῦτα",709858,71],["ἀπελεύσεσθε",701398,124],["εἰς",704105,0],["τὴν",709436,8],["ὁδὸν",709458,9],["ὑμῶν",713091,145]],"and she said to them, Depart into the hill-country, lest the pursuers meet you, and ye shall be hidden there three days until your pursuers return from after you, and afterwards ye shall depart on your way."],["17",[["καὶ",707031,7],["εἶπαν",705373,150],["οἱ",709436,136],["ἄνδρες",701150,52],["πρὸς",710844,0],["αὐτήν",702165,104],["ἀθῷοί",700390,138],["ἐσμεν",704093,243],["τῷ",709436,113],["ὅρκῳ",709753,114],["σου",711945,133],["τούτῳ",709858,50]],"And the men said to her, We are clear of this thy oath."],["18",[["ἰδοὺ",706497,88],["ἡμεῖς",705983,219],["εἰσπορευόμεθα",704124,378],["εἰς",704105,0],["μέρος",708752,25],["τῆς",709436,16],["πόλεως",710612,17],["καὶ",707031,7],["θήσεις",712849,166],["τὸ",709436,24],["σημεῖον",711748,25],["τὸ",709436,24],["σπαρτίον",711999,25],["τὸ",709436,24],["κόκκινον",707783,46],["τοῦτο",709858,129],["ἐκδήσεις",704166,166],["εἰς",704105,0],["τὴν",709436,8],["θυρίδα",706340,9],["δι᾿",703417,0],["ἧς",709781,167],["κατεβίβασας",707208,162],["ἡμᾶς",705981,194],["δι᾿",703417,0],["αὐτῆς",702165,86],["τὸν",709436,5],["δὲ",703303,11],["πατέρα",710189,6],["σου",711945,133],["καὶ",707031,7],["τὴν",709436,8],["μητέρα",708892,9],["σου",711945,133],["καὶ",707031,7],["τοὺς",709436,58],["ἀδελφούς",700249,57],["σου",711945,133],["καὶ",707031,7],["πάντα",710177,27],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["συνάξεις",712375,166],["πρὸς",710844,0],["σεαυτὴν",711599,104],["εἰς",704105,0],["τὴν",709436,8],["οἰκίαν",709505,9],["σου",711945,133]],"Behold, we shall enter into a part of the city, and thou shalt set a sign; thou shalt bind this scarlet cord in the window, by which thou hast let us down, and thou shalt bring in to thyself, into thy house, thy father, and thy mother, and thy brethren, and all the family of thy father."],["19",[["καὶ",707031,7],["ἔσται",704093,93],["πᾶς",710177,14],["ὃς",709781,213],["ἂν",700900,11],["ἐξέλθῃ",704909,172],["τὴν",709436,8],["θύραν",706337,9],["τῆς",709436,16],["οἰκίας",709505,17],["σου",711945,133],["ἔξω",704983,28],["ἔνοχος",704781,14],["ἑαυτῷ",703917,50],["ἔσται",704093,93],["ἡμεῖς",705983,219],["δὲ",703303,11],["ἀθῷοι",700390,138],["τῷ",709436,113],["ὅρκῳ",709753,114],["σου",711945,133],["τούτῳ",709858,50],["καὶ",707031,7],["ὅσοι",709788,138],["ἐὰν",703912,7],["γένωνται",703104,232],["μετὰ",708780,0],["σοῦ",711945,133],["ἐν",704639,0],["τῇ",709436,100],["οἰκίᾳ",709505,1],["σου",711945,133],["ἡμεῖς",705983,219],["ἔνοχοι",704781,138],["ἐσόμεθα",704093,141]],"And it shall come to pass that whosoever shall go outside the door of thy house, his guilt shall be upon him, and we shall be quit of this thine oath; and we will be responsible for all that shall be found with thee in thy house."],["20",[["ἐὰν",703912,7],["δέ",703303,11],["τις",712866,158],["ἡμᾶς",705981,194],["ἀδικήσῃ",700269,172],["ἢ",705924,7],["καὶ",707031,28],["ἀποκαλύψῃ",701474,172],["τοὺς",709436,58],["λόγους",708236,57],["ἡμῶν",705999,145],["τούτους",709858,62],["ἐσόμεθα",704093,141],["ἀθῷοι",700390,138],["τῷ",709436,113],["ὅρκῳ",709753,114],["σου",711945,133],["τούτῳ",709858,50]],"But if any one should injure us, or betray these our matters, we shall be quit of this thine oath."],["21",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["κατὰ",707200,0],["τὸ",709436,24],["ῥῆμα",711246,25],["ὑμῶν",713091,145],["οὕτως",709859,28],["ἔστω",704093,31],["καὶ",707031,7],["ἐξαπέστειλεν",704872,2],["αὐτούς",702165,62]],"And she said to them, Let it be according to your word; and she sent them out, and they departed."],["22",[["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["καὶ",707031,7],["ἤλθοσαν",705453,150],["εἰς",704105,0],["τὴν",709436,8],["ὀρεινὴν",709733,9],["καὶ",707031,7],["κατέμειναν",707326,150],["ἐκεῖ",704181,28],["τρεῖς",712927,119],["ἡμέρας",705984,39],["καὶ",707031,7],["ἐξεζήτησαν",704187,150],["οἱ",709436,136],["καταδιώκοντες",707243,146],["πάσας",710177,119],["τὰς",709436,38],["ὁδοὺς",709458,39],["καὶ",707031,7],["οὐχ",709805,28],["εὕροσαν",705676,150]],"And they came to the hill-country, and remained there three days; and the pursuers searched all the roads, and found them not."],["23",[["καὶ",707031,7],["ὑπέστρεψαν",713246,150],["οἱ",709436,136],["δύο",703849,59],["νεανίσκοι",709232,52],["καὶ",707031,7],["κατέβησαν",707202,150],["ἐκ",704132,0],["τοῦ",709436,20],["ὄρους",709768,21],["καὶ",707031,7],["διέβησαν",703419,150],["πρὸς",710844,0],["Ἰησοῦν",706701,6],["υἱὸν",713075,6],["Ναυη",709206,118],["καὶ",707031,7],["διηγήσαντο",703679,189],["αὐτῷ",702165,50],["πάντα",710177,68],["τὰ",709436,41],["συμβεβηκότα",712277,518],["αὐτοῖς",702165,151]],"And the two young men returned, and came down out of the mountain; and they went over to Joshua the son of Naue, and told him all things that had happened to them."],["24",[["καὶ",707031,7],["εἶπαν",705373,150],["πρὸς",710844,0],["Ἰησοῦν",706701,6],["ὅτι",709803,7],["παρέδωκεν",710014,2],["κύριος",707996,4],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9],["ἐν",704639,0],["χειρὶ",713787,1],["ἡμῶν",705999,145],["καὶ",707031,7],["κατέπτηκεν",707392,171],["πᾶς",710177,14],["ὁ",709436,3],["κατοικῶν",707534,72],["τὴν",709436,8],["γῆν",703083,9],["ἐκείνην",704183,104],["ἀφ᾿",701425,0],["ἡμῶν",705999,145]],"And they said to Joshua, The Lord has delivered all the land into our power, and all the inhabitants of that land tremble because of us."]]