[["1",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Ἰησοῦν",706701,6],["μὴ",708851,28],["φοβηθῇς",713532,279],["μηδὲ",708855,7],["δειλιάσῃς",703321,175],["λαβὲ",708076,176],["μετὰ",708780,0],["σοῦ",711945,133],["τοὺς",709436,58],["ἄνδρας",701150,57],["πάντας",710177,60],["τοὺς",709436,58],["πολεμιστὰς",710604,57],["καὶ",707031,7],["ἀναστὰς",701173,182],["ἀνάβηθι",700905,176],["εἰς",704105,0],["Γαι",702900,9],["ἰδοὺ",706497,88],["δέδωκα",703654,89],["εἰς",704105,0],["τὰς",709436,38],["χεῖράς",713787,39],["σου",711945,133],["τὸν",709436,5],["βασιλέα",702580,6],["Γαι",702900,17],["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9],["αὐτοῦ",702165,102]],"And the Lord said to Joshua, Fear not, nor be timorous: take with thee all the men of war, and arise, go up to Gai; behold, I have given into thy hands the king of Gai, and his land."],["2",[["καὶ",707031,7],["ποιήσεις",710582,166],["τὴν",709436,8],["Γαι",702900,9],["ὃν",709781,112],["τρόπον",712980,6],["ἐποίησας",710582,162],["τὴν",709436,8],["Ιεριχω",706620,9],["καὶ",707031,7],["τὸν",709436,5],["βασιλέα",702580,6],["αὐτῆς",702165,86],["καὶ",707031,7],["τὴν",709436,8],["προνομὴν",710827,9],["τῶν",709436,43],["κτηνῶν",707934,44],["προνομεύσεις",710826,166],["σεαυτῷ",711599,50],["κατάστησον",707011,176],["δὲ",703303,11],["σεαυτῷ",711599,50],["ἔνεδρα",704704,42],["τῇ",709436,100],["πόλει",710612,1],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,28]],"And thou shalt do to Gai, as thou didst to Jericho and its king; and thou shalt take to thyself the spoil of its cattle; set now for thyself an ambush for the city behind."],["3",[["καὶ",707031,7],["ἀνέστη",701173,2],["Ἰησοῦς",706701,4],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["ὁ",709436,3],["πολεμιστὴς",710604,4],["ὥστε",714164,7],["ἀναβῆναι",700905,106],["εἰς",704105,0],["Γαι",702900,9],["ἐπέλεξεν",705188,2],["δὲ",703303,11],["Ἰησοῦς",706701,4],["τριάκοντα",712934,59],["χιλιάδας",713858,39],["ἀνδρῶν",701150,81],["δ