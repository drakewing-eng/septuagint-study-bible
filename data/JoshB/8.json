1,7],["ἔμπροσθεν",704618,28]],"And when they shall come out after us, we will draw them away from the city; and they will say, These men flee from before us, as also before."],["7",[["ὑμεῖς",713081,219],["δὲ",703303,11],["ἐξαναστήσεσθε",704865,124],["ἐκ",704132,0],["τῆς",709436,16],["ἐνέδρας",704702,17],["καὶ",707031,7],["πορεύσεσθε",710667,124],["εἰς",704105,0],["τὴν",709436,8],["πόλιν",710612,9]],"And ye shall rise up out of the ambuscade, and go into the city."],["8",[["κατὰ",707200,0],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["ποιήσετε",710582,337],["ἰδοὺ",706497,88],["ἐντέταλμαι",704791,326],["ὑμῖν",713084,90]],"Ye shall do according to this word, lo! I have commanded you."],["9",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["αὐτοὺς",702165,62],["Ἰησοῦς",706701,4],["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["εἰς",704105,0],["τὴν",709436,8],["ἐνέδραν",704702,9],["καὶ",707031,7],["ἐνεκάθισαν",703953,150],["ἀνὰ",700902,0],["μέσον",708768,46],["Βαιθηλ",702412,118],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,46],["Γαι",702900,17],["ἀπὸ",701425,0],["θαλάσσης",706069,17],["τῆς",709436,16],["Γαι",702900,17]],"And Joshua sent them, and they went to lie in ambush; and they lay between Bæthel and Gai, westward of Gai."],["10",[["καὶ",707031,7],["ὀρθρίσας",709742,182],["Ἰησοῦς",706701,4],["τὸ",709436,24],["πρωὶ",711021,28],["ἐπεσκέψατο",705250,23],["τὸν",709436,5],["λαόν",708094,6],["καὶ",707031,7],["ἀνέβησαν",700905,150],["αὐτὸς",702165,121],["καὶ",707031,7],["οἱ",709436,136],["πρεσβύτεροι",710735,267],["κατὰ",707200,0],["πρόσωπον",710986,25],["τοῦ",709436,35],["λαοῦ",708094,18],["ἐπὶ",705080,0],["Γαι",702900,17]],"And Joshua rose up early in the morning, and numbered the people; and he went up, he and the elders before the people to Gai."],["11",[["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["ὁ",709436,3],["πολεμιστὴς",710604,4],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἀνέβησαν",700905,150],["καὶ",707031,7],["πορευόμενοι",710667,348],["ἦλθον",705453,150],["ἐξ",704132,0],["ἐναντίας",704656,82],["τῆς",709436,16],["πόλεως",710612,17],["ἀπ᾿",701425,0],["ἀνατολῶν",701071,65]],"And all the men of war went up with him, and they went forward and came over against the city eastward."],["12",[["καὶ",707031,7],["τὰ",709436,41],["ἔνεδρα",704704,42],["τῆς",709436,16],["πόλεως",710612,17],["ἀπὸ",701425,0],["θαλάσσης",706069,17]],"And the ambuscade [was] on the west side of the city."],["14",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὡς",714148,7],["εἶδεν",709725,2],["βασιλεὺς",702580,4],["Γαι",702900,17],["ἔσπευσεν",712011,2],["καὶ",707031,7],["ἐξῆλθεν",704909,2],["εἰς",704105,0],["συνάντησιν",712397,9],["αὐτοῖς",702165,151],["ἐπ᾿",705080,0],["εὐθείας",705602,82],["εἰς",704105,0],["τὸν",709436,5],["πόλεμον",710605,6],["αὐτὸς",702165,121],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["ὁ",709436,3],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["αὐτὸς",702165,121],["οὐκ",709805,28],["ᾔδει",709492,143],["ὅτι",709803,7],["ἔνεδρα",704704,64],["αὐτῷ",702165,50],["ἐστιν",704093,91],["ὀπίσω",709697,0],["τῆς",709436,16],["πόλεως",710612,17]],"And it came to pass when the king of Gai saw [it], he hasted and went out to meet them direct to the battle, he and all the people [that were] with him: and he knew not that there was an ambuscade [formed] against him behind the city."],["15",[["καὶ",707031,7],["εἶδεν",709725,2],["καὶ",707031,7],["ἀνεχώρησεν",701092,2],["Ἰησοῦς",706701,4],["καὶ",707031,7],["Ισραηλ",706839,4],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτῶν",702165,40]],"And Joshua and Israel saw, and retreated from before them."],["16",[["καὶ",707031,7],["κατεδίωξαν",707243,150],["ὀπίσω",709697,0],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["καὶ",707031,7],["αὐτοὶ",702165,201],["ἀπέστησαν",702214,150],["ἀπὸ",701425,0],["τῆς",709436,16],["πόλεως",710612,17]],"And they pursued after the children of Israel, and they themselves went to a distance from the city."],["17",[["οὐ",709805,28],["κατελείφθη",707305,37],["οὐθεὶς",709817,14],["ἐν",704639,0],["τῇ",709436,100],["Γαι",702900,1],["ὃς",709781,213],["οὐ",709805,28],["κατεδίωξεν",707243,2],["ὀπίσω",709697,0],["Ισραηλ",706839,18],["καὶ",707031,7],["κατέλιπον",707305,150],["τὴν",709436,8],["πόλιν",710612,9],["ἀνεῳγμένην",701186,444],["καὶ",707031,7],["κατεδίωξαν",707243,150],["ὀπίσω",709697,0],["Ισραηλ",706839,18]],"There was no one left in Gai who did not pursue after Israel; and they left the city open, and pursued after Israel."],["18",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Ἰησοῦν",706701,6],["ἔκτεινον",704322,176],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133],["ἐν",704639,0],["τῷ",709436,113],["γαίσῳ",702916,114],["τῷ",709436,113],["ἐν",704639,0],["τῇ",709436,100],["χειρί",713787,1],["σου",711945,133],["ἐπὶ",705080,0],["τὴν",709436,8],["πόλιν",710612,9],["εἰς",704105,0],["γὰρ",702963,11],["τὰς",709436,38],["χεῖράς",713787,39],["σου",711945,133],["παραδέδωκα",710014,89],["αὐτήν",702165,104],["καὶ",707031,7],["τὰ",709436,63],["ἔνεδρα",704704,64],["ἐξαναστήσονται",704865,135],["ἐν",704639,0],["τάχει",712747,54],["ἐκ",704132,0],["τοῦ",709436,35],["τόπου",712903,18],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐξέτεινεν",704322,2],["Ἰησοῦς",706701,4],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["τὸν",709436,5],["γαῖσον",702916,6],["ἐπὶ",705080,0],["τὴν",709436,8],["πόλιν",710612,9]],"And the Lord said to Joshua, Stretch forth thy hand with the spear that is in thy hand toward the city, for I have delivered it into thy hands; and the liers in wait shall rise up quickly out of their place."],["19",[["καὶ",707031,7],["τὰ",709436,63],["ἔνεδρα",704704,64],["ἐξανέστησαν",704865,150],["ἐν",704639,0],["τάχει",712747,54],["ἐκ",704132,0],["τοῦ",709436,35],["τόπου",712903,18],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐξήλθοσαν",704909,150],["ὅτε",709802,28],["ἐξέτεινεν",704322,2],["τὴν",709436,8],["χεῖρα",713787,9],["καὶ",707031,7],["ἤλθοσαν",705453,150],["ἐπὶ",705080,0],["τὴν",709436,8],["πόλιν",710612,9],["καὶ",707031,7],["κατελάβοντο",707300,189],["αὐτὴν",702165,104],["καὶ",707031,7],["σπεύσαντες",712011,196],["ἐνέπρησαν",704617,150],["τὴν",709436,8],["πόλιν",710612,9],["ἐν",704639,0],["πυρί",711088,54]],"And Joshua stretched out his hand [and] his spear toward the city, and the ambuscade rose up quickly out of their place; and they came forth when he stretched out his hand; and they entered into the city, and took it; and they hasted and burnt the city with fire."],["20",[["καὶ",707031,7],["περιβλέψαντες",710297,196],["οἱ",709436,136],["κάτοικοι",707540,52],["Γαι",702900,17],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,28],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐθεώρουν",706226,137],["καπνὸν",707132,6],["ἀναβαίνοντα",700905,183],["ἐκ",704132,0],["τῆς",709436,16],["πόλεως",710612,17],["εἰς",704105,0],["τὸν",709436,5],["οὐρανόν",709844,6],["καὶ",707031,7],["οὐκέτι",709827,28],["εἶχον",705785,137],["ποῦ",710706,28],["φύγωσιν",713433,234],["ὧδε",714090,28],["ἢ",705924,7],["ὧδε",714090,28]],"And when the inhabitants of Gai looked round behind them, then they saw the smoke going up out of the city to heaven, and they were no longer able to flee this way or that way."],["21",[["καὶ",707031,7],["Ἰησοῦς",706701,4],["καὶ",707031,7],["πᾶς",710177,14],["Ισραηλ",706839,4],["εἶδον",709725,150],["ὅτι",709803,7],["ἔλαβον",708076,150],["τὰ",709436,63],["ἔνεδρα",704704,64],["τὴν",709436,8],["πόλιν",710612,9],["καὶ",707031,7],["ὅτι",709803,7],["ἀνέβη",700905,2],["ὁ",709436,3],["καπνὸς",707132,4],["τῆς",709436,16],["πόλεως",710612,17],["εἰς",704105,0],["τὸν",709436,5],["οὐρανόν",709844,6],["καὶ",707031,7],["μεταβαλόμενοι",708782,317],["ἐπάταξαν",710185,150],["τοὺς",709436,58],["ἄνδρας",701150,57],["τῆς",709436,16],["Γαι",702900,17]],"And Joshua and all Israel saw that the ambuscade had taken the city, and that the smoke of the city went up to heaven; and they turned and smote the men of Gai."],["22",[["καὶ",70703