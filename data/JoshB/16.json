[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["τὰ",709436,63],["ὅρια",709749,64],["υἱῶν",713075,81],["Ιωσηφ",706948,18],["ἀπὸ",701425,0],["τοῦ",709436,35],["Ιορδάνου",706763,18],["τοῦ",709436,35],["κατὰ",707200,0],["Ιεριχω",706620,9],["ἀπ᾿",701425,0],["ἀνατολῶν",701071,65],["καὶ",707031,7],["ἀναβήσεται",700905,93],["ἀπὸ",701425,0],["Ιεριχω",706620,17],["εἰς",704105,0],["τὴν",709436,8],["ὀρεινὴν",709733,9],["τὴν",709436,8],["ἔρημον",705420,9],["εἰς",704105,0],["Βαιθηλ",702412,227],["Λουζα",708252,118]],"And the borders of the children of Joseph were from Jordan by Jericho eastward; and they will go up from Jericho to the hill country, to the wilderness, to Bæthel Luza."],["2",[["καὶ",707031,7],["ἐξελεύσεται",704909,93],["εἰς",704105,0],["Βαιθηλ",702412,227],["καὶ",707031,7],["παρελεύσεται",710141,93],["ἐπὶ",705080,0],["τὰ",709436,41],["ὅρια",709749,42],["τοῦ",709436,35],["Χαταρωθι",713770,18]],"And they will go out to Bæthel, and will proceed to the borders of Achatarothi."],["3",[["καὶ",707031,7],["διελεύσεται",703673,93],["ἐπὶ",705080,0],["τὴν",709436,8],["θάλασσαν",706069,9],["ἐπὶ",705080,0],["τὰ",709436,41],["ὅρια",709749,42],["Απταλιμ",701652,118],["ἕως",705792,0],["τῶν",709436,43],["ὁρίων",709749,44],["Βαιθωρων",702442,118],["τὴν",709436,8],["κάτω",707557,28],["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["διέξοδος",703668,12],["αὐτῶν",702165,70],["ἐπὶ",705080,0],["τὴν",709436,8],["θάλασσαν",706069,9]],"And they will go across to the sea to the borders of Aptalim, as far as the borders of Bæthoron the lower, and the going forth of them shall be to the sea."],["4",[["καὶ",707031,7],["ἐκληρονόμησαν",707724,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ιωσηφ",706948,18],["Εφραιμ",705769,120],["καὶ",707031,7],["Μανασση",708470,120]],"And the sons of Joseph, Ephraim and Manasse, took their inheritance."],["5",[["καὶ",707031,7],["ἐγενήθη",703104,37],["ὅρια",709749,64],["υἱῶν",713075,81],["Εφραιμ",705769,118],["κατὰ",707200,0],["δήμους",703411,57],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐγενήθη",703104,37],["τὰ",709436,63],["ὅρια",709749,64],["τῆς",709436,16],["κληρονομίας",707725,17],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["ἀνατολῶν",701071,65],["Αταρωθ",702075,118],["καὶ",707031,7],["Εροκ",705439,118],["ἕως",705792,0],["Βαιθωρων",702442,118],["τὴν",709436,8],["ἄνω",701296,28],["καὶ",707031,7],["Γαζαρα",702887,118]],"And the borders of the children of Ephraim were according to their families, and the borders of their inheritance were eastward to Ataroth, and Eroc as far as Bæthoron the upper, and Gazara."],["6",[["καὶ",707031,7],["διελεύσεται",703673,93],["τὰ",709436,63],["ὅρια",709749,64],["ἐπὶ",705080,0],["τὴν",709436,8],["θάλασσαν",706069,9],["εἰς",704105,0],["Ικασμων",706713,227],["ἀπὸ",701425,0],["βορρᾶ",702765,18],["Θερμα",706211,118],["περιελεύσεται",710314,93],["ἐπὶ",705080,0],["ἀνατολὰς",701071,39],["εἰς",704105,0],["Θηνασα",706242,227],["καὶ",707031,7],["Σελλησα",711656,227],["καὶ",707031,7],["παρελεύσεται",710141,93],["ἀπ᾿",701425,0],["ἀνατολῶν",701071,65],["εἰς",704105,0],["Ιανωκα",706422,227]],"And the borders will proceed to the sea to Icasmon north of Therma; they will go round eastward to Thenasa, and Selles, and will pass on eastward to Janoca,"],["7",[["καὶ",707031,7],["εἰς",704105,0],["Μαχω",708611,227],["καὶ",707031,7],["Αταρωθ",702075,227],["καὶ",707031,7],["αἱ",709436,190],["κῶμαι",708022,191],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐλεύσεται",705453,93],["ἐπὶ",705080,0],["Ιεριχω",706620,9],["καὶ",707031,7],["διεκβαλεῖ",703657,127],["ἐπὶ",705080,0],["τὸν",709436,5],["Ιορδάνην",706763,6]],"and to Macho, and Ataroth, and [these are] their villages; and they will come to Jericho, and will issue at Jordan."],["8",[["καὶ",707031,7],["ἀπὸ",701425,0],["Ταφου",712739,118],["πορεύσεται",710667,93],["τὰ",709436,63],["ὅρια",709749,64],["ἐπὶ",705080,0],["θάλασσαν",706069,9],["ἐπὶ",705080,0],["Χελκανα",713811,227],["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["διέξοδος",703668,12],["αὐτῶν",702165,70],["ἐπὶ",705080,0],["θάλασσαν",706069,9],["αὕτη",709858,107],["ἡ",709436,10],["κληρονομία",707725,12],["φυλῆς",713620,17],["Εφραιμ",705769,118],["κατὰ",707200,0],["δήμους",703411,57],["αὐτῶν",702165,40]],"And the borders will proceed from Tapho to the sea to Chelcana; and their termination will be at the sea; this [is] the inheritance of the tribe of Ephraim according to their families."],["9",[["καὶ",707031,7],["αἱ",709436,190],["πόλεις",710612,191],["αἱ",709436,190],["ἀφορισθεῖσαι",702227,520],["τοῖς",709436,147],["υἱοῖς",713075,148],["Εφραιμ",705769,118],["ἀνὰ",700902,0],["μέσον",708768,46],["τῆς",709436,16],["κληρονομίας",707725,17],["υἱῶν",713075,81],["Μανασση",708470,118],["πᾶσαι",710177,192],["αἱ",709436,190],["πόλεις",710612,191],["καὶ",707031,7],["αἱ",709436,190],["κῶμαι",708022,191],["αὐτῶν",702165,284]],"And the cities separated to the sons of Ephraim [were] in the midst of the inheritance of the sons of Manasse, all the cities and their villages."],["10",[["καὶ",707031,7],["οὐκ",709805,28],["ἀπώλεσεν",701513,2],["Εφραιμ",705769,120],["τὸν",709436,5],["Χαναναῖον",713711,6],["τὸν",709436,5],["κατοικοῦντα",707534,183],["ἐν",704639,0],["Γαζερ",702891,111],["καὶ",707031,7],["κατῴκει",707534,13],["ὁ",709436,3],["Χαναναῖος",713711,4],["ἐν",704639,0],["τῷ",709436,113],["Εφραιμ",705769,114],["ἕως",705792,0],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86],["ἕως",705792,0],["ἀνέβη",700905,2],["Φαραω",713360,4],["βασιλεὺς",702580,4],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ἔλαβεν",708076,2],["αὐτὴν",702165,104],["καὶ",707031,7],["ἐνέπρησεν",704617,2],["αὐτὴν",702165,104],["ἐν",704639,0],["πυρί",711088,54],["καὶ",707031,7],["τοὺς",709436,58],["Χαναναίους",713711,57],["καὶ",707031,7],["τοὺς",709436,58],["Φερεζαίους",713422,57],["καὶ",707031,7],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["ἐν",704639,0],["Γαζερ",702891,111],["ἐξεκέντησαν",704211,150],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτὴν",702165,104],["Φαραω",713360,4],["ἐν",704639,0],["φερνῇ",713426,1],["τῇ",709436,100],["θυγατρὶ",706320,1],["αὐτοῦ",702165,102]],"And Ephraim did not destroy the Chananite who dwelt in Gazer; and the Chananite dwelt in Ephraim until this day, until Pharao the king of Egypt went up and took it, and burnt it with fire; and the Chananites, and Pherezites, and the dwellers in Gaza they destroyed, and Pharao gave them for a dowry to his daughter."]]