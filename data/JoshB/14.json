[["1",[["καὶ",707031,7],["οὗτοι",709858,201],["οἱ",709436,136],["κατακληρονομήσαντες",707274,196],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["Χανααν",713708,118],["οἷς",709781,311],["κατεκληρονόμησεν",707274,2],["αὐτοῖς",702165,151],["Ελεαζαρ",704407,120],["ὁ",709436,3],["ἱερεὺς",706614,4],["καὶ",707031,7],["Ἰησοῦς",706701,4],["ὁ",709436,3],["τοῦ",709436,35],["Ναυη",709206,118],["καὶ",707031,7],["οἱ",709436,136],["ἄρχοντες",701862,52],["πατριῶν",710192,65],["φυλῶν",713620,65],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18]],"And these [are] they of the children of Israel that received their inheritance in the land of Chanaan, to whom Eleazar the priest, and Joshua the [son] of Naue, and the heads of the families of the tribes of the children of Israel, gave inheritance."],["2",[["κατὰ",707200,0],["κλήρους",707727,57],["ἐκληρονόμησαν",707724,150],["ὃν",709781,112],["τρόπον",712980,6],["ἐνετείλατο",704791,23],["κύριος",707996,4],["ἐν",704639,0],["χειρὶ",713787,1],["Ἰησοῦ",706701,18],["ταῖς",709436,75],["ἐννέα",704754,59],["φυλαῖς",713620,76],["καὶ",707031,7],["τῷ",709436,53],["ἡμίσει",705998,97],["φυλῆς",713620,17]],"They inherited according to their lots, as the Lord commanded by the hand of Joshua to the nine tribes and the half tribe, on the other side of Jordan."],["3",[["ἀπὸ",701425,0],["τοῦ",709436,20],["πέραν",710280,28],["τοῦ",709436,35],["Ιορδάνου",706763,18],["καὶ",707031,7],["τοῖς",709436,147],["Λευίταις",708160,148],["οὐκ",709805,28],["ἔδωκεν",703654,2],["κλῆρον",707727,6],["ἐν",704639,0],["αὐτοῖς",702165,151]],"But to the Levites he gave no inheritance among them."],["4",[["ὅτι",709803,7],["ἦσαν",704093,137],["οἱ",709436,136],["υἱοὶ",713075,52],["Ιωσηφ",706948,118],["δύο",703849,59],["φυλαί",713620,191],["Μανασση",708470,120],["καὶ",707031,7],["Εφραιμ",705769,120],["καὶ",707031,7],["οὐκ",709805,28],["ἐδόθη",703654,37],["μερὶς",708748,12],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["τοῖς",709436,147],["Λευίταις",708160,148],["ἀλλ᾿",700680,7],["ἢ",705924,7],["πόλεις",710612,191],["κατοικεῖν",707534,55],["καὶ",707031,7],["τὰ",709436,63],["ἀφωρισμένα",702227,370],["αὐτῶν",702165,40],["τοῖς",709436,95],["κτήνεσιν",707934,96],["καὶ",707031,7],["τὰ",709436,63],["κτήνη",707934,64],["αὐτῶν",702165,40]],"For the sons of Joseph were two tribes, Manasse and Ephraim; and there was none inheritance in the land given to the Levites, only cities to dwell in, and their suburbs separated for the cattle, and their cattle."],["5",[["ὃν",709781,112],["τρόπον",712980,6],["ἐνετείλατο",704791,23],["κύριος",707996,4],["τῷ",709436,113],["Μωυσῇ",709112,114],["οὕτως",709859,28],["ἐποίησαν",710582,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐμέρισαν",708744,150],["τὴν",709436,8],["γῆν",703083,9]],"As the Lord commanded Moses, so did the children of Israel; and they divided the land."],["6",[["καὶ",707031,7],["προσήλθοσαν",710890,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ιουδα",706768,18],["πρὸς",710844,0],["Ἰησοῦν",706701,6],["ἐν",704639,0],["Γαλγαλ",702932,111],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτὸν",702165,85],["Χαλεβ",713680,120],["ὁ",709436,3],["τοῦ",709436,35],["Ιεφοννη",706687,18],["ὁ",709436,3],["Κενεζαῖος",707604,4],["σὺ",712181,164],["ἐπίστῃ",705264,278],["τὸ",709436,24],["ῥῆμα",711246,25],["ὃ",709781,128],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["ἄνθρωπον",701163,6],["τοῦ",709436,35],["θεοῦ",706192,18],["περὶ",710285,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["σοῦ",711945,133],["ἐν",704639,0],["Καδης",706973,111],["Βαρνη",702541,118]],"And the children of Juda came to Joshua in Galgal, and Chaleb the [son] of Jephone the Kenezite said to him, Thou knowest the word that the Lord spoke to Moses the man of God concerning me and thee in Cades Barne."],["7",[["τεσσαράκοντα",712806,59],["γὰρ",702963,11],["ἐτῶν",705543,44],["ἤμην",704093,334],["ὅτε",709802,28],["ἀπέστειλέν",701592,2],["με",708618,163],["Μωυσῆς",709112,4],["ὁ",709436,3],["παῖς",709932,4],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐκ",704132,0],["Καδης",706973,118],["Βαρνη",702541,118],["κατασκοπεῦσαι",707426,106],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἀπεκρίθην",701492,156],["αὐτῷ",702165,50],["λόγον",708236,6],["κατὰ",707200,0],["τὸν",709436,5],["νοῦν",709374,6],["αὐτοῦ",702165,102]],"For I was forty years old when Moses the servant of God sent me out of Cades Barne to spy out the land; and I returned him an answer according to his mind."],["8",[["οἱ",709436,136],["δὲ",703303,11],["ἀδελφοί",700249,52],["μου",709032,133],["οἱ",709436,136],["ἀναβάντες",700905,196],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["μετέστησαν",708668,150],["τὴν",709436,8],["καρδίαν",707141,9],["τοῦ",709436,35],["λαοῦ",708094,18],["ἐγὼ",704018,164],["δὲ",703303,11],["προσετέθην",710965,156],["ἐπακολουθῆσαι",705007,106],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["μου",709032,133]],"My brethren that went up with me turned away the heart of the people, but I applied myself to follow the Lord my God."],["9",[["καὶ",707031,7],["ὤμοσεν",709620,2],["Μωυσῆς",709112,4],["ἐν",704639,0],["ἐκείνῃ",704183,105],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["λέγων",708124,72],["ἡ",709436,10],["γῆ",703083,12],["ἐφ᾿",705080,0],["ἣν",709781,131],["ἐπέβης",705082,162],["σοὶ",711925,159],["ἔσται",704093,93],["ἐν",704639,0],["κλήρῳ",707727,114],["καὶ",707031,7],["τοῖς",709436,95],["τέκνοις",712761,96],["σου",711945,133],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ὅτι",709803,7],["προσετέθης",710965,168],["ἐπακολουθῆσαι",705007,106],["ὀπίσω",709697,0],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145]],"And Moses sware on that day, saying, The land on which thou art gone up, it shall be thy inheritance and thy children's for ever, because thou hast applied thyself to follow the Lord our God."],["10",[["καὶ",707031,7],["νῦν",709384,28],["διέθρεψέν",703613,2],["με",708618,163],["κύριος",707996,4],["ὃν",709781,112],["τρόπον",712980,6],["εἶπεν",705373,2],["τοῦτο",709858,129],["τεσσαρακοστὸν",712807,46],["καὶ",707031,7],["πέμπτον",710245,46],["ἔτος",705543,25],["ἀφ᾿",701425,0],["οὗ",709781,160],["ἐλάλησεν",708071,2],["κύριος",707996,4],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["πρὸς",710844,0],["Μωυσῆν",709112,6],["καὶ",707031,7],["ἐπορεύθη",710667,37],["Ισραηλ",706839,4],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["καὶ",707031,7],["νῦν",709384,28],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["σήμερον",711751,28],["ὀγδοήκοντα",709442,59],["καὶ",707031,7],["πέντε",710266,59],["ἐτῶν",705543,44]],"And now the Lord has kept me alive as he said: this [is] the forty-fifth year since the Lord spoke that word to Moses; and Israel journeyed in the wilderness; and now, behold, I [am] this day eighty-five years old."],["11",[["ἔτι",705538,28],["εἰμὶ",704093,157],["σήμερον",711751,28],["ἰσχύων",706858,65],["ὡσεὶ",714159,28],["ὅτε",709802,28],["ἀπέστειλέν",701592,2],["με",708618,163],["Μωυσῆς",709112,4],["ὡσαύτως",714158,28],["ἰσχύω",706859,157],["νῦν",709384,28],["ἐξελθεῖν",704909,106],["καὶ",707031,7],["εἰσελθεῖν",704114,106],["εἰς",704105,0],["τὸν",709436,5],["πόλεμον",710605,6]],"I am still strong this day, as when the Lord sent me: just so strong am I now to go out and to come in for war."],["12",[["καὶ",707031,7],["νῦν",709384,28],["αἰτοῦμαί",700489,254],["σε",711598,163],["τὸ",709436,24],["ὄρος",709768,25],["τοῦτο",709858,129],["καθὰ",706979,28],["εἶπεν",705373,2],["κύριος",707996,4],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ὅτι",709803,7],["σὺ",712181,164],["ἀκήκοας",700587,266],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["νυνὶ",709385,28],["δὲ",703303,11],["οἱ",709436,136],["Ενακιμ",704647,52],["ἐκεῖ",704181,28],["εἰσιν",704093,197],["πόλεις",710612,191],["ὀχυραὶ",709889,192],["καὶ",707031,7],["μεγάλαι",708653,192],["ἐὰν",703912,7],["οὖν",709835,11],["κύριος",707996,4],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["ᾖ",704093,204],["ἐξολεθρεύσω",704956,165],["αὐτούς",702165,62],["ὃν",709781,112],["τρόπον",712980,6],["εἶπέν",705373,2],["μοι",708974,159],["κύριος",707996,4]],"And now I ask of thee this mountain, as the Lord said in that day; for thou heardest this word on that day; and now the Enakim are there, cities great and strong: if then the Lord should be with me, I will utterly destroy them, as the Lord said to me."],["13",[["καὶ",707031,7],["εὐλόγησεν",705631,2],["αὐτὸν",702165,85],["Ἰησοῦς",706701,4],["καὶ",707031,7],["ἔδωκεν",703654,2],["τὴν",709436,8],["Χεβρων",713777,9],["τῷ",709436,113],["Χαλεβ",713680,114],["υἱῷ",713075,114],["Ιεφοννη",706687,18],["υἱοῦ",713075,18],["Κενεζ",707603,118],["ἐν",704639,0],["κλήρῳ",707727,114]],"And Joshua blessed him, and gave Chebron to Chaleb the son of Jephone the son of Kenez for an inheritance."],["14",[["διὰ",703417,0],["τοῦτο",709858,129],["ἐγενήθη",703104,37],["ἡ",709436,10],["Χεβρων",713777,12],["τῷ",709436,113],["Χαλεβ",713680,114],["τῷ",709436,113],["τοῦ",709436,35],["Ιεφοννη",706687,18],["τοῦ",709436,35],["Κενεζαίου",707604,18],["ἐν",704639,0],["κλήρῳ",707727,114],["ἕως",705792,0],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86],["διὰ",703417,0],["τὸ",709436,24],["αὐτὸν",702165,85],["ἐπακολουθῆσαι",705007,106],["τῷ",709436,53],["προστάγματι",710959,54],["κυρίου",707996,18],["θεοῦ",706192,18],["Ισραηλ",706839,18]],"Therefore Chebron became the inheritance of Chaleb the [son] of Jephone the Kenezite until this day, because he followed the commandment of the Lord God of Israel."],["15",[["τὸ",709436,34],["δὲ",703303,11],["ὄνομα",709666,15],["τῆς",709436,16],["Χεβρων",713777,17],["ἦν",704093,13],["τὸ",709436,24],["πρότερον",710991,46],["πόλις",710612,12],["Αρβοκ",701700,118],["μητρόπολις",708895,12],["τῶν",709436,80],["Ενακιμ",704647,81],["αὕτη",709858,107],["καὶ",707031,7],["ἡ",709436,10],["γῆ",703083,12],["ἐκόπασεν",707819,2],["τοῦ",709436,35],["πολέμου",710605,18]],"And the name of Chebron before was the city Argob, it [is] the metropolis of the Enakim: and the land rested from war."]]