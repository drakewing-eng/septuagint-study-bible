[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["μετὰ",708780,0],["τὴν",709436,8],["τελευτὴν",712782,9],["Μωυσῆ",709112,18],["εἶπεν",705373,2],["κύριος",707996,4],["τῷ",709436,113],["Ἰησοῖ",706701,114],["υἱῷ",713075,114],["Ναυη",709206,18],["τῷ",709436,113],["ὑπουργῷ",713253,30],["Μωυσῆ",709112,18],["λέγων",708124,72]],"And it came to pass after the death of Moses, that the Lord spoke to Joshua the son of Naue, the minister of Moses, saying,"],["2",[["Μωυσῆς",709112,4],["ὁ",709436,3],["θεράπων",706201,4],["μου",709032,133],["τετελεύτηκεν",712781,171],["νῦν",709384,28],["οὖν",709835,11],["ἀναστὰς",701173,182],["διάβηθι",703419,176],["τὸν",709436,5],["Ιορδάνην",706763,6],["σὺ",712181,164],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["οὗτος",709858,121],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["ἐγὼ",704018,164],["δίδωμι",703654,157],["αὐτοῖς",702165,151]],"Moses my servant is dead; now then arise, go over Jordan, thou and all this people, into the land, which I give them."],["3",[["πᾶς",710177,14],["ὁ",709436,3],["τόπος",712903,4],["ἐφ᾿",705080,0],["ὃν",709781,112],["ἂν",700900,11],["ἐπιβῆτε",705082,125],["τῷ",709436,53],["ἴχνει",706873,54],["τῶν",709436,80],["ποδῶν",710707,81],["ὑμῶν",713091,145],["ὑμῖν",713084,90],["δώσω",703654,165],["αὐτόν",702165,85],["ὃν",709781,112],["τρόπον",712980,6],["εἴρηκα",705415,89],["τῷ",709436,113],["Μωυσῇ",709112,114]],"Every spot on which ye shall tread I will give it you, as I said to Moses."],["4",[["τὴν",709436,8],["ἔρημον",705420,9],["καὶ",707031,7],["τὸν",709436,5],["Ἀντιλίβανον",701248,6],["ἕως",705792,0],["τοῦ",709436,35],["ποταμοῦ",710693,18],["τοῦ",709436,35],["μεγάλου",708653,116],["ποταμοῦ",710693,18],["Εὐφράτου",705716,18],["καὶ",707031,7],["ἕως",705792,0],["τῆς",709436,16],["θαλάσσης",706069,17],["τῆς",709436,16],["ἐσχάτης",705519,82],["ἀφ᾿",701425,0],["ἡλίου",705974,18],["δυσμῶν",703865,65],["ἔσται",704093,93],["τὰ",709436,63],["ὅρια",709749,64],["ὑμῶν",713091,145]],"The wilderness and Antilibanus, as far as the great river, the river Euphrates, and as far as the extremity of the sea; your coasts shall be from the setting of the sun."],["5",[["οὐκ",709805,28],["ἀντιστήσεται",701154,93],["ἄνθρωπος",701163,4],["κατενώπιον",707511,0],["ὑμῶν",713091,145],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["τῆς",709436,16],["ζωῆς",705910,17],["σου",711945,133],["καὶ",707031,7],["ὥσπερ",714163,28],["ἤμην",704093,334],["μετὰ",708780,0],["Μωυσῆ",709112,18],["οὕτως",709859,28],["ἔσομαι",704093,181],["καὶ",707031,28],["μετὰ",708780,0],["σοῦ",711945,133],["καὶ",707031,7],["οὐκ",709805,28],["ἐγκαταλείψω",703967,165],["σε",711598,163],["οὐδὲ",709816,7],["ὑπερόψομαί",713154,181],["σε",711598,163]],"Not a man shall stand against you all the days of thy life; and as I was with Moses, so will I also be with thee, and I will not fail thee, or neglect thee."],["6",[["ἴσχυε",706859,240],["καὶ",707031,7],["ἀνδρίζου",701104,253],["σὺ",712181,164],["γὰρ",702963,11],["ἀποδιαστελεῖς",701447,166],["τῷ",709436,113],["λαῷ",708094,114],["τούτῳ",709858,50],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["ὤμοσα",709620,155],["τοῖς",709436,147],["πατράσιν",710189,148],["ὑμῶν",713091,145],["δοῦναι",703654,106],["αὐτοῖς",702165,151]],"Be strong and quit thyself like a man, for thou shalt divide the land to this people, which I sware to give to your fathers."],["7",[["ἴσχυε",706859,240],["οὖν",709835,11],["καὶ",707031,7],["ἀνδρίζου",701104,253],["φυλάσσεσθαι",713619,110],["καὶ",707031,7],["ποιεῖν",710582,55],["καθότι",707021,28],["ἐνετείλατό",704791,23],["σοι",711925,159],["Μωυσῆς",709112,4],["ὁ",709436,3],["παῖς",709932,4],["μου",709032,133],["καὶ",707031,7],["οὐκ",709805,28],["ἐκκλινεῖς",704220,166],["ἀπ᾿",701425,0],["αὐτῶν",702165,70],["εἰς",704105,0],["δεξιὰ",703360,68],["οὐδὲ",709816,7],["εἰς",704105,0],["ἀριστερά",701749,68],["ἵνα",706747,7],["συνῇς",712435,205],["ἐν",704639,0],["πᾶσιν",710177,94],["οἷς",709781,295],["ἐὰν",703912,7],["πράσσῃς",710721,205]],"Be strong, therefore, and quit thyself like a man, to observe and do as Moses my servant commanded thee; and thou shalt not turn therefrom to the right hand or to the left, that thou mayest be wise in whatsoever thou mayest do."],["8",[["καὶ",707031,7],["οὐκ",709805,28],["ἀποστήσεται",702214,93],["ἡ",709436,10],["βίβλος",702721,12],["τοῦ",709436,35],["νόμου",709349,18],["τούτου",709858,102],["ἐκ",704132,0],["τοῦ",709436,20],["στόματός",712125,21],["σου",711945,133],["καὶ",707031,7],["μελετήσεις",708698,166],["ἐν",704639,0],["αὐτῷ",702165,50],["ἡμέρας",705984,17],["καὶ",707031,7],["νυκτός",709386,17],["ἵνα",706747,7],["συνῇς",712435,205],["ποιεῖν",710582,55],["πάντα",710177,68],["τὰ",709436,41],["γεγραμμένα",703194,388],["τότε",712908,28],["εὐοδωθήσῃ",705654,364],["καὶ",707031,7],["εὐοδώσεις",705654,166],["τὰς",709436,38],["ὁδούς",709458,39],["σου",711945,133],["καὶ",707031,7],["τότε",712908,28],["συνήσεις",712481,166]],"And the book of this law shall not depart out of thy mouth, and thou shalt meditate in it day and night, that thou mayest know how to do all the things that are written [in it]; then shalt thou prosper, and make thy ways prosperous, and then shalt thou be wise."],["9",[["ἰδοὺ",706497,88],["ἐντέταλμαί",704791,326],["σοι",711925,159],["ἴσχυε",706859,240],["καὶ",707031,7],["ἀνδρίζου",701104,253],["μὴ",708851,28],["δειλιάσῃς",703321,175],["μηδὲ",708855,7],["φοβηθῇς",713532,279],["ὅτι",709803,7],["μετὰ",708780,0],["σοῦ",711945,133],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["εἰς",704105,0],["πάντα",710177,27],["οὗ",709806,28],["ἐὰν",703912,7],["πορεύῃ",710667,278]],"Lo! I have commanded thee; be strong and courageous, be not cowardly nor fearful, for the Lord thy God is with thee in all places whither thou goest."],["10",[["καὶ",707031,7],["ἐνετείλατο",704791,23],["Ἰησοῦς",706701,4],["τοῖς",709436,147],["γραμματεῦσιν",703185,148],["τοῦ",709436,35],["λαοῦ",708094,18],["λέγων",708124,72]],"And Joshua commanded the scribes of the people, saying,"],["11",[["εἰσέλθατε",704114,74],["κατὰ",707200,0],["μέσον",708768,46],["τῆς",709436,16],["παρεμβολῆς",710133,17],["τοῦ",709436,35],["λαοῦ",708094,18],["καὶ",707031,7],["ἐντείλασθε",704791,186],["τῷ",709436,113],["λαῷ",708094,114],["λέγοντες",708124,146],["ἑτοιμάζεσθε",705539,73],["ἐπισιτισμόν",705247,6],["ὅτι",709803,7],["ἔτι",705538,28],["τρεῖς",712927,192],["ἡμέραι",705984,191],["καὶ",707031,7],["ὑμεῖς",713081,219],["διαβαίνετε",703419,87],["τὸν",709436,5],["Ιορδάνην",706763,6],["τοῦτον",709858,85],["εἰσελθόντες",704114,196],["κατασχεῖν",707526,106],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,80],["πατέρων",710189,81],["ὑμῶν",713091,145],["δίδωσιν",703654,91],["ὑμῖν",713084,90]],"Go into the midst of the camp of the people, and command the people, saying, Prepare provisions; for yet three days and ye shall go over this Jordan, entering in to take possession of the land, which the Lord God of your fathers gives to you."],["12",[["καὶ",707031,7],["τῷ",709436,113],["Ρουβην",711295,111],["καὶ",707031,7],["τῷ",709436,113],["Γαδ",702872,111],["καὶ",707031,7],["τῷ",709436,113],["ἡμίσει",705998,30],["φυλῆς",713620,17],["Μανασση",708470,118],["εἶπεν",705373,2],["Ἰησοῦς",706701,4]],"And to Ruben, and to Gad, and to the half tribe of Manasse, Joshua said,"],["13",[["μνήσθητε",708960,372],["τὸ",709436,24],["ῥῆμα",711246,25],["κυρίου",707996,18],["ὃ",709781,128],["ἐνετείλατο",704791,23],["ὑμῖν",713084,90],["Μωυσῆς",709112,4],["ὁ",709436,3],["παῖς",709932,4],["κυρίου",707996,18],["λέγων",708124,72],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["κατέπαυσεν",707365,2],["ὑμᾶς",713080,194],["καὶ",707031,7],["ἔδωκεν",703654,2],["ὑμῖν",713084,90],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104]],"Remember the word which Moses the servant of the Lord commanded you, saying, The Lord your God has caused you to rest, and has given you this land."],["14",[["αἱ",709436,190],["γυναῖκες",703209,191],["ὑμῶν",713091,145],["καὶ",707031,7],["τὰ",709436,63],["παιδία",709927,64],["ὑμῶν",713091,145],["καὶ",707031,7],["τὰ",709436,63],["κτήνη",707934,64],["ὑμῶν",713091,145],["κατοικείτωσαν",707534,56],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ᾗ",709781,108],["ἔδωκεν",703654,2],["ὑμῖν",713084,90],["ὑμεῖς",713081,219],["δὲ",703303,11],["διαβήσεσθε",703419,124],["εὔζωνοι",705581,138],["πρότεροι",710992,267],["τῶν",709436,80],["ἀδελφῶν",700249,81],["ὑμῶν",713091,145],["πᾶς",710177,14],["ὁ",709436,3],["ἰσχύων",706859,72],["καὶ",707031,7],["συμμαχήσετε",712298,337],["αὐτοῖς",702165,151]],"Let your wives and your children and your cattle dwell in the land, which he has given you; and ye shall go over well armed before your brethren, every one of you who is strong; and ye shall fight on their side;"],["15",[["ἕως",705792,7],["ἂν",700900,11],["καταπαύσῃ",707365,172],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["τοὺς",709436,58],["ἀδελφοὺς",700249,57],["ὑμῶν",713091,145],["ὥσπερ",714163,28],["καὶ",707031,28],["ὑμᾶς",713080,194],["καὶ",707031,7],["κληρονομήσωσιν",707724,234],["καὶ",707031,28],["οὗτοι",709858,201],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["δίδωσιν",703654,91],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἀπελεύσεσθε",701398,124],["ἕκαστος",704133,14],["εἰς",704105,0],["τὴν",709436,8],["κληρονομίαν",707725,9],["αὐτοῦ",702165,102],["ἣν",709781,131],["δέδωκεν",703654,171],["ὑμῖν",713084,90],["Μωυσῆς",709112,4],["εἰς",704105,0],["τὸ",709436,24],["πέραν",710280,28],["τοῦ",709436,35],["Ιορδάνου",706763,18],["ἀπ᾿",701425,0],["ἀνατολῶν",701071,65],["ἡλίου",705974,18]],"until the Lord your God shall have given your brethren rest, as also to you, and they also shall have inherited the land, which the Lord your God gives them; then ye shall depart each one to his inheritance, which Moses gave you beyond Jordan eastward."],["16",[["καὶ",707031,7],["ἀποκριθέντες",701492,247],["τῷ",709436,113],["Ἰησοῖ",706701,114],["εἶπαν",705373,150],["πάντα",710177,68],["ὅσα",709788,68],["ἂν",700900,11],["ἐντείλῃ",704791,420],["ἡμῖν",705994,90],["ποιήσομεν",710582,275],["καὶ",707031,7],["εἰς",704105,0],["πάντα",710177,27],["τόπον",712903,6],["οὗ",709806,28],["ἐὰν",703912,7],["ἀποστείλῃς",701592,175],["ἡμᾶς",705981,194],["πορευσόμεθα",710667,141]],"And they answered Joshua and said, We will do all things which thou commandest us, and we will go to every place whither thou shalt send us."],["17",[["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἠκούσαμεν",700587,289],["Μωυσῆ",709112,18],["ἀκουσόμεθα",700587,141],["σοῦ",711945,133],["πλὴν",710540,28],["ἔστω",704093,31],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["μετὰ",708780,0],["σοῦ",711945,133],["ὃν",709781,112],["τρόπον",712980,6],["ἦν",704093,13],["μετὰ",708780,0],["Μωυσῆ",709112,18]],"Whereinsoever we hearkened to Moses we will hearken to thee; only let the Lord our God be with thee, as he was with Moses."],["18",[["ὁ",709436,3],["δὲ",703303,11],["ἄνθρωπος",701163,4],["ὃς",709781,213],["ἐὰν",703912,7],["ἀπειθήσῃ",701370,172],["σοι",711925,159],["καὶ",707031,7],["ὅστις",709793,425],["μὴ",708851,28],["ἀκούσῃ",700587,172],["τῶν",709436,43],["ῥημάτων",711246,44],["σου",711945,133],["καθότι",707021,28],["ἂν",700900,11],["αὐτῷ",702165,50],["ἐντείλῃ",704791,420],["ἀποθανέτω",701461,45],["ἀλλὰ",700680,7],["ἴσχυε",706859,240],["καὶ",707031,7],["ἀνδρίζου",701104,253]],"And whosoever shall disobey thee, and whosoever shall not hearken to thy words as thou shalt command him, let him die; but be thou strong and courageous."]]