[["1",[["καὶ",707031,7],["ἐξεκκλησιάσθη",704217,37],["πᾶσα",710177,29],["συναγωγὴ",712376,12],["υἱῶν",713075,81],["Ισραηλ",706839,18],["εἰς",704105,0],["Σηλω",711738,227],["καὶ",707031,7],["ἔπηξαν",710452,150],["ἐκεῖ",704181,28],["τὴν",709436,8],["σκηνὴν",711845,9],["τοῦ",709436,20],["μαρτυρίου",708525,21],["καὶ",707031,7],["ἡ",709436,10],["γῆ",703083,12],["ἐκρατήθη",707879,37],["ὑπ᾿",713184,0],["αὐτῶν",702165,40]],"And all the congregation of the children of Israel were assembled at Selo, and there they pitched the tabernacle of witness; and the land was subdued by them."],["2",[["καὶ",707031,7],["κατελείφθησαν",707305,99],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["οἳ",709781,250],["οὐκ",709805,28],["ἐκληρονόμησαν",707724,150],["ἑπτὰ",705357,59],["φυλαί",713620,191]],"And the sons of Israel remained, [even] those who [had] not received their inheritance, seven tribes."],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["Ἰησοῦς",706701,4],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["ἕως",705792,0],["τίνος",712867,340],["ἐκλυθήσεσθε",704254,261],["κληρονομῆσαι",707724,106],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["ἔδωκεν",703654,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145]],"And Joshua said to the sons of Israel, How long will ye be slack to inherit the land, which the Lord our God has given you?"],["4",[["δότε",703654,74],["ἐξ",704132,0],["ὑμῶν",713091,145],["τρεῖς",712927,60],["ἄνδρας",701150,57],["ἐκ",704132,0],["φυλῆς",713620,17],["καὶ",707031,7],["ἀναστάντες",701173,196],["διελθέτωσαν",703673,264],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["διαγραψάτωσαν",703441,264],["αὐτὴν",702165,104],["ἐναντίον",704654,0],["μου",709032,133],["καθὰ",706979,28],["δεήσει",703311,127],["διελεῖν",703459,106],["αὐτήν",702165,104],["καὶ",707031,7],["ἤλθοσαν",705453,150],["πρὸς",710844,0],["αὐτόν",702165,85]],"Appoint of yourselves three men of each tribe, and let them rise up and go through the land, and let them describe it before me, as it will be proper to divide it."],["5",[["καὶ",707031,7],["διεῖλεν",703459,2],["αὐτοῖς",702165,151],["ἑπτὰ",705357,59],["μερίδας",708748,39],["Ιουδας",706775,120],["στήσεται",706846,93],["αὐτοῖς",702165,151],["ὅριον",709749,25],["ἀπὸ",701425,0],["λιβός",708224,18],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["Ιωσηφ",706948,18],["στήσονται",706846,135],["αὐτοῖς",702165,151],["ἀπὸ",701425,0],["βορρᾶ",702765,18]],"And they came to him: and he divided to them seven portions, [saying], Juda shall stand to them a border southward, and the sons of Joseph shall stand to them northward."],["6",[["ὑμεῖς",713081,219],["δὲ",703303,11],["μερίσατε",708744,74],["τὴν",709436,8],["γῆν",703083,9],["ἑπτὰ",705357,59],["μερίδας",708748,39],["καὶ",707031,7],["ἐνέγκατε",713428,74],["πρός",710844,0],["με",708618,163],["ὧδε",714090,28],["καὶ",707031,7],["ἐξοίσω",704356,165],["ὑμῖν",713084,90],["κλῆρον",707727,6],["ἔναντι",704653,0],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145]],"And do ye divide the land into seven parts, and bring the description hither to me, and I will give you a lot before the Lord our God."],["7",[["οὐ",709805,28],["γάρ",702963,11],["ἐστιν",704093,91],["μερὶς",708748,12],["τοῖς",709436,147],["υἱοῖς",713075,148],["Λευι",708158,118],["ἐν",704639,0],["ὑμῖν",713084,90],["ἱερατεία",706604,12],["γὰρ",702963,11],["κυρίου",707996,18],["μερὶς",708748,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["Γαδ",702872,120],["καὶ",707031,7],["Ρουβην",711295,120],["καὶ",707031,7],["τὸ",709436,34],["ἥμισυ",705998,26],["φυλῆς",713620,17],["Μανασση",708470,118],["ἐλάβοσαν",708076,150],["τὴν",709436,8],["κληρονομίαν",707725,9],["αὐτῶν",702165,40],["πέραν",710280,0],["τοῦ",709436,35],["Ιορδάνου",706763,18],["ἐπ᾿",705080,0],["ἀνατολάς",701071,39],["ἣν",709781,131],["ἔδωκεν",703654,2],["αὐτοῖς",702165,151],["Μωυσῆς",709112,4],["ὁ",709436,3],["παῖς",709932,4],["κυρίου",707996,18]],"For the sons of Levi have no part among you; for the priesthood of the Lord [is] his portion; and Gad, and Ruben, and the half tribe of Manasse, have received their inheritance beyond Jordan eastward, which Moses the servant of the Lord gave to them."],["8",[["καὶ",707031,7],["ἀναστάντες",701173,196],["οἱ",709436,136],["ἄνδρες",701150,52],["ἐπορεύθησαν",710667,99],["καὶ",707031,7],["ἐνετείλατο",704791,23],["Ἰησοῦς",706701,4],["τοῖς",709436,147],["ἀνδράσιν",701150,148],["τοῖς",709436,147],["πορευομένοις",710667,341],["χωροβατῆσαι",714018,106],["τὴν",709436,8],["γῆν",703083,9],["λέγων",708124,72],["πορεύεσθε",710667,73],["καὶ",707031,7],["χωροβατήσατε",714018,74],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["παραγενήθητε",710006,372],["πρός",710844,0],["με",708618,163],["καὶ",707031,7],["ὧδε",714090,28],["ἐξοίσω",704356,165],["ὑμῖν",713084,90],["κλῆρον",707727,6],["ἔναντι",704653,0],["κυρίου",707996,18],["ἐν",704639,0],["Σηλω",711738,111]],"And the men rose up and went; and Joshua charged the men who went to explore the land, saying, Go and explore the land, and come to me, and I will bring you forth a lot here before the Lord in Selo."],["9",[["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["καὶ",707031,7],["ἐχωροβάτησαν",714018,150],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["εἴδοσαν",709725,150],["αὐτὴν",702165,104],["καὶ",707031,7],["ἔγραψαν",703194,150],["αὐτὴν",702165,104],["κατὰ",707200,0],["πόλεις",710612,39],["αὐτῆς",702165,86],["ἑπτὰ",705357,59],["μερίδας",708748,39],["εἰς",704105,0],["βιβλίον",702719,25],["καὶ",707031,7],["ἤνεγκαν",713428,150],["πρὸς",710844,0],["Ἰησοῦν",706701,6]],"And they went, and explored the land: and they viewed it, and described it according to the cities, seven parts in a book, and brought [the book] to Joshua."],["10",[["καὶ",707031,7],["ἐνέβαλεν",704547,2],["αὐτοῖς",702165,151],["Ἰησοῦς",706701,4],["κλῆρον",707727,6],["ἐν",704639,0],["Σηλω",711738,111],["ἔναντι",704653,0],["κυρίου",707996,18]],"And Joshua cast the lot for them in Selo before the Lord."],["11",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["ὁ",709436,3],["κλῆρος",707727,4],["φυλῆς",713620,17],["Βενιαμιν",702650,118],["πρῶτος",711041,140],["κατὰ",707200,0],["δήμους",703411,57],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐξῆλθεν",704909,2],["ὅρια",709749,64],["τοῦ",709436,35],["κλήρου",707727,18],["αὐτῶν",702165,40],["ἀνὰ",700902,0],["μέσον",708768,46],["Ιουδα",706768,118],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,46],["τῶν",709436,80],["υἱῶν",713075,81],["Ιωσηφ",706948,118]],"And the lot of the tribe of Benjamin came forth first according to their families: and the borders of their lot came forth between the children of Juda and the children of Joseph."],["12",[["καὶ",707031,7],["ἐγενήθη",703104,37],["αὐτῶν",702165,40],["τὰ",709436,63],["ὅρια",709749,64],["ἀπὸ",701425,0],["βορρᾶ",702765,18],["ἀπὸ",701425,0],["τοῦ",709436,35],["Ιορδάνου",706763,18],["προσαναβήσεται",710850,93],["τὰ",709436,63],["ὅρια",709749,64],["κατὰ",707200,0],["νώτου",709403,21],["Ιεριχω",706620,17],["ἀπὸ",701425,0],["βορρᾶ",702765,18],["καὶ",707031,7],["ἀναβήσεται",700905,93],["ἐπὶ",705080,0],["τὸ",709436,24],["ὄρος",709768,25],["ἐπὶ",705080,0],["τὴν",709436,8],["θάλασσαν",706069,9],["καὶ",707031,7],["ἔσται",704093,93],["αὐτοῦ",702165,49],["ἡ",709436,10],["διέξοδος",703668,12],["ἡ",709436,10],["Μαδβαρῖτις",708353,12],["Βαιθων",702441,118]],"And their borders were northward: the borders shall go up from Jordan behind Jericho northward, and shall go up to the mountain westward, and the issue of it shall be Bæthon of Mabdara."],["13",[["καὶ",707031,7],["διελεύσεται",703673,93],["ἐκεῖθεν",704182,28],["τὰ",709436,63],["ὅρια",709749,64],["Λουζα",708252,227],["ἐπὶ",705080,0],["νώτου",709403,21],["Λουζα",708252,118],["ἀπὸ",701425,0],["λιβός",708224,18],["αὕτη",709858,107],["ἐστὶν",704093,91],["Βαιθηλ",702412,120],["καὶ",707031,7],["καταβήσεται",707202,93],["τὰ",709436,63],["ὅρια",709749,64],["Μααταρωθορεχ",708317,227],["ἐπὶ",705080,0],["τὴν",709436,8],["ὀρεινήν",709732,9],["ἥ",709781,177],["ἐστιν",704093,91],["πρὸς",710844,0],["λίβα",708224,6],["Βαιθωρων",702442,118],["ἡ",709436,10],["κάτω",707557,28]],"And the borders will go forth thence to Luz, behind Luz, from the south of it; this is Bæthel: and the borders shall go down to Maatarob Orech, to the hill country, which is southward of Bæthoron the lower."],["14",[["καὶ",707031,7],["διελεύσεται",703673,93],["τὰ",709436,63],["ὅρια",709749,64],["καὶ",707031,7],["περιελεύσεται",710314,93],["ἐπὶ",705080,0],["τὸ",709436,24],["μέρος",708752,25],["τὸ",709436,24],["βλέπον",702740,47],["παρὰ",709995,0],["θάλασσαν",706069,9],["ἀπὸ",701425,0],["λιβὸς",708224,18],["ἀπὸ",701425,0],["τοῦ",709436,20],["ὄρους",709768,21],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["Βαιθωρων",702442,118],["λίβα",708224,6],["καὶ",707031,7],["ἔσται",704093,93],["αὐτοῦ",702165,49],["ἡ",709436,10],["διέξοδος",703668,12],["εἰς",704105,0],["Καριαθβααλ",707150,227],["αὕτη",709858,107],["ἐστὶν",704093,91],["Καριαθιαριν",707152,120],["πόλις",710612,12],["υἱῶν",713075,81],["Ιουδα",706768,118],["τοῦτό",709858,132],["ἐστιν",704093,91],["τὸ",709436,34],["μέρος",708752,15],["τὸ",709436,34],["πρὸς",710844,0],["θάλασσαν",706069,9]],"And the borders shall pass through and proceed to the part that looks toward the sea, on the south, from the mountain in front of Bæthoron southward, and its termination shall be at Cariath-Baal, this is Cariath-Jarin, a city of the children of Juda; this is the part toward the west."],["15",[["καὶ",707031,7],["μέρος",708752,15],["τὸ",709436,34],["πρὸς",710844,0],["λίβα",708224,6],["ἀπὸ",701425,0],["μέρους",708752,21],["Καριαθβααλ",707150,118],["καὶ",707031,7],["διελεύσεται",703673,93],["ὅρια",709749,64],["εἰς",704105,0],["Γασιν",702974,227],["ἐπὶ",705080,0],["πηγὴν",710450,9],["ὕδατος",713071,21],["Ναφθω",709216,118]],"And the south side on the part of Cariath-Baal; and the borders shall go across to Gasin, to the fountain of the water of Naphtho."],["16",[["καὶ",707031,7],["καταβήσεται",707202,93],["τὰ",709436,63],["ὅρια",709749,64],["ἐπὶ",705080,0],["μέρους",708752,21],["τοῦ",709436,20],["ὄρους",709768,21],["ὅ",709781,33],["ἐστιν",704093,91],["κατὰ",707200,0],["πρόσωπον",710986,25],["νάπης",709193,17],["Ονναμ",709663,118],["ὅ",709781,33],["ἐστιν",704093,91],["ἐκ",704132,0],["μέρους",708752,21],["Εμεκραφαϊν",704559,118],["ἀπὸ",701425,0],["βορρᾶ",702765,18],["καὶ",707031,7],["καταβήσεται",707202,93],["Γαιεννα",702911,227],["ἐπὶ",705080,0],["νώτου",709403,21],["Ιεβουσαι",706518,118],["ἀπὸ",701425,0],["λιβὸς",708224,18],["καὶ",707031,7],["καταβήσεται",707202,93],["ἐπὶ",705080,0],["πηγὴν",710450,9],["Ρωγηλ",711316,118]],"And the borders shall extend down on one side, this is in front of the forest of Sonnam, which is on the side of Emec Raphain northward, and it shall come down to Gæenna behind Jebusai southward: it shall come down to the fountain of Rogel."],["17",[["καὶ",707031,7],["διελεύσεται",703673,93],["ἐπὶ",705080,0],["πηγὴν",710450,9],["Βαιθσαμυς",702430,118],["καὶ",707031,7],["παρελεύσεται",710141,93],["ἐπὶ",705080,0],["Γαλιλωθ",702941,227],["ἥ",709781,177],["ἐστιν",704093,91],["ἀπέναντι",701389,28],["πρὸς",710844,0],["ἀνάβασιν",700907,9],["Αιθαμιν",700415,118],["καὶ",707031,7],["καταβήσεται",707202,93],["ἐπὶ",705080,0],["λίθον",708196,6],["Βαιων",702455,118],["υἱῶν",713075,81],["Ρουβην",711295,118]],"And [the borders] shall go across to the fountain of Bæthsamys:"],["18",[["καὶ",707031,7],["διελεύσεται",703673,93],["κατὰ",707200,0],["νώτου",709403,21],["Βαιθαραβα",702397,118],["ἀπὸ",701425,0],["βορρᾶ",702765,18],["καὶ",707031,7],["καταβήσεται",707202,93]],"and shall proceed to Galiloth, which is in front by the going up of Æthamin; and they shall come down to the stone of Bæon of the sons of Ruben; and shall pass over behind Bætharaba northward, and shall go down to the borders behind the sea northward."],["19",[["ἐπὶ",705080,0],["τὰ",709436,41],["ὅρια",709749,42],["ἐπὶ",705080,0],["νώτου",709403,21],["Βαιθαγλα",702387,118],["ἀπὸ",701425,0],["βορρᾶ",702765,18],["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["διέξοδος",703668,12],["τῶν",709436,43],["ὁρίων",709749,44],["ἐπὶ",705080,0],["λοφιὰν",708259,9],["τῆς",709436,16],["θαλάσσης",706069,17],["τῶν",709436,80],["ἁλῶν",700728,81],["ἐπὶ",705080,0],["βορρᾶν",702765,6],["εἰς",704105,0],["μέρος",708752,25],["τοῦ",709436,35],["Ιορδάνου",706763,18],["ἀπὸ",701425,0],["λιβός",708224,18],["ταῦτα",709858,290],["τὰ",709436,63],["ὅριά",709749,64],["ἐστιν",704093,91],["ἀπὸ",701425,0],["λιβός",708224,18]],"And the termination of the borders shall be at the creek of the salt sea northward to the side of Jordan southward: these are their southern borders."],["20",[["καὶ",707031,7],["ὁ",709436,3],["Ιορδάνης",706763,4],["ὁριεῖ",709748,127],["ἀπὸ",701425,0],["μέρους",708752,21],["ἀνατολῶν",701071,65],["αὕτη",709858,107],["ἡ",709436,10],["κληρονομία",707725,12],["υἱῶν",713075,81],["Βενιαμιν",702650,118],["τὰ",709436,63],["ὅρια",709749,64],["αὐτῆς",702165,86],["κύκλῳ",707959,114],["κατὰ",707200,0],["δήμους",703411,57]],"And Jordan shall be their boundary on the east: this [is] the inheritance of the children of Benjamin, these [are] their borders round about according to their families."],["21",[["καὶ",707031,7],["ἐγενήθησαν",703104,99],["αἱ",709436,190],["πόλεις",710612,191],["τῶν",709436,80],["υἱῶν",713075,81],["Βενιαμιν",702650,118],["κατὰ",707200,0],["δήμους",703411,57],["αὐτῶν",702165,40],["Ιεριχω",706620,12],["καὶ",707031,7],["Βαιθεγλιω",702408,120],["καὶ",707031,7],["Αμεκασις",700800,120]],"And the cities of the children of Benjamin according to their families [were] Jericho, and Bethegæo, and Amecasis,"],["22",[["καὶ",707031,7],["Βαιθαβαρα",702675,120],["καὶ",707031,7],["Σαρα",711507,120],["καὶ",707031,7],["Βησανα",702710,120]],"and Bæthabara, and Sara, and Besana,"],["23",[["καὶ",707031,7],["Αιιν",700422,120],["καὶ",707031,7],["Φαρα",713350,120],["καὶ",707031,7],["Εφραθα",705765,120]],"and Æein, and Phara, and Ephratha,"],["24",[["καὶ",707031,7],["Καραφα",707140,120],["καὶ",707031,7],["Κεφιρα",707641,120],["καὶ",707031,7],["Μονι",708993,120],["καὶ",707031,7],["Γαβαα",702849,120],["πόλεις",710612,191],["δέκα",703333,59],["δύο",703849,59],["καὶ",707031,7],["αἱ",709436,190],["κῶμαι",708022,191],["αὐτῶν",702165,284]],"and Carapha, and Cephira, and Moni, and Gabaa, twelve cities and their villages:"],["25",[["Γαβαων",702858,120],["καὶ",707031,7],["Ραμα",711163,120],["καὶ",707031,7],["Βεηρωθα",702634,120]],"Gabaon, and Rama, and Beerotha;"],["26",[["καὶ",707031,7],["Μασσημα",708560,120],["καὶ",707031,7],["Μιρων",708926,120],["καὶ",707031,7],["Αμωκη",700894,120]],"and Massema, and Miron, and Amoke;"],["27",[["καὶ",707031,7],["Φιρα",713514,120],["καὶ",707031,7],["Καφαν",707572,120],["καὶ",707031,7],["Νακαν",709178,120],["καὶ",707031,7],["Σεληκαν",711649,120],["καὶ",707031,7],["Θαρεηλα",706113,120]],"and Phira, and Caphan, and Nacan, and Selecan, and Thareela,"],["28",[["καὶ",707031,7],["Ιεβους",706517,120],["αὕτη",709858,107],["ἐστὶν",704093,91],["Ιερουσαλημ",706644,12],["καὶ",707031,7],["πόλεις",710612,191],["καὶ",707031,7],["Γαβαωθιαριμ",702857,120],["πόλεις",710612,191],["τρεῖς",712927,192],["καὶ",707031,7],["δέκα",703333,59],["καὶ",707031,7],["αἱ",709436,190],["κῶμαι",708022,191],["αὐτῶν",702165,284],["αὕτη",709858,107],["ἡ",709436,10],["κληρονομία",707725,12],["υἱῶν",713075,81],["Βενιαμιν",702650,118],["κατὰ",707200,0],["δήμους",703411,57],["αὐτῶν",702165,40]],"and Jebus (this is Jerusalem); and Gabaoth, Jarim, thirteen cities, and their villages; this [is] the inheritance of the sons of Benjamin according to their families."]]