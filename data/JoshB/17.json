[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["τὰ",709436,63],["ὅρια",709749,64],["φυλῆς",713620,17],["υἱῶν",713075,81],["Μανασση",708470,118],["ὅτι",709803,7],["οὗτος",709858,121],["πρωτότοκος",711046,14],["τῷ",709436,113],["Ιωσηφ",706948,114],["τῷ",709436,113],["Μαχιρ",708604,114],["πρωτοτόκῳ",711046,30],["Μανασση",708470,118],["πατρὶ",710189,114],["Γαλααδ",702920,118],["ἀνὴρ",701150,4],["γὰρ",702963,11],["πολεμιστὴς",710604,4],["ἦν",704093,13],["ἐν",704639,0],["τῇ",709436,100],["Γαλααδίτιδι",702925,1],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["Βασανίτιδι",702569,1]],"And the borders of the tribe of the children of Manasse, (for he [was] the first-born of Joseph,) [assigned] to Machir the first-born of Manasse the father of Galaad, for he was a warrior, [were] in the land of Galaad and of Basan."],["2",[["καὶ",707031,7],["ἐγενήθη",703104,37],["τοῖς",709436,147],["υἱοῖς",713075,148],["Μανασση",708470,118],["τοῖς",709436,147],["λοιποῖς",708248,230],["κατὰ",707200,0],["δήμους",703411,57],["αὐτῶν",702165,40],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ιεζερ",706540,118],["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["Κελεζ",707599,118],["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ιεζιηλ",706543,118],["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["Συχεμ",712565,118],["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["Συμαριμ",712276,118],["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["Οφερ",709868,118],["οὗτοι",709858,201],["οἱ",709436,136],["ἄρσενες",701818,138],["κατὰ",707200,0],["δήμους",703411,57],["αὐτῶν",702165,40]],"And there was [land] assigned to the other sons of Manasse according to their families; to the sons of Jezi, and to the sons of Kelez, and to the sons of Jeziel, and to the sons of Sychem, and to the sons of Symarim, and to the sons of Opher: these [are] the males according to their families."],["3",[["καὶ",707031,7],["τῷ",709436,113],["Σαλπααδ",711423,114],["υἱῷ",713075,114],["Οφερ",709868,118],["οὐκ",709805,28],["ἦσαν",704093,137],["αὐτῷ",702165,50],["υἱοὶ",713075,52],["ἀλλ᾿",700680,7],["ἢ",705924,7],["θυγατέρες",706320,191],["καὶ",707031,7],["ταῦτα",709858,290],["τὰ",709436,63],["ὀνόματα",709666,64],["τῶν",709436,130],["θυγατέρων",706320,65],["Σαλπααδ",711423,118],["Μααλα",708298,120],["καὶ",707031,7],["Νουα",709365,120],["καὶ",707031,7],["Εγλα",704005,120],["καὶ",707031,7],["Μελχα",708708,120],["καὶ",707031,7],["Θερσα",706220,120]],"And Salpaad the son of Opher had no sons but daughters: and these [are] the names of the daughters of Salpaad; Maala, and Nua, and Egla, and Melcha, and Thersa."],["4",[["καὶ",707031,7],["ἔστησαν",706846,150],["ἐναντίον",704654,0],["Ελεαζαρ",704407,118],["τοῦ",709436,35],["ἱερέως",706614,18],["καὶ",707031,7],["ἐναντίον",704654,0],["Ἰησοῦ",706701,18],["καὶ",707031,7],["ἐναντίον",704654,0],["τῶν",709436,80],["ἀρχόντων",701862,81],["λέγουσαι",708124,306],["ὁ",709436,3],["θεὸς",706192,4],["ἐνετείλατο",704791,23],["διὰ",703417,0],["χειρὸς",713787,17],["Μωυσῆ",709112,18],["δοῦναι",703654,106],["ἡμῖν",705994,90],["κληρονομίαν",707725,9],["ἐν",704639,0],["μέσῳ",708768,97],["τῶν",709436,80],["ἀδελφῶν",700249,81],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐδόθη",703654,37],["αὐταῖς",702165,200],["διὰ",703417,0],["προστάγματος",710959,21],["κυρίου",707996,18],["κλῆρος",707727,4],["ἐν",704639,0],["τοῖς",709436,147],["ἀδελφοῖς",700249,148],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτῶν",702165,284]],"And they stood before Eleazar the priest, and before Joshua, and before the rulers, saying, God gave a charge by the hand of Moses, to give us an inheritance in the midst of our brethren: so there was given to them by the command of the Lord an inheritance among the brethren of their father."],["5",[["καὶ",707031,7],["ἔπεσεν",710481,2],["ὁ",709436,3],["σχοινισμὸς",712612,4],["αὐτῶν",702165,284],["ἀπὸ",701425,0],["Ανασσα",701053,118],["καὶ",707031,7],["πεδίον",710215,15],["Λαβεκ",708043,118],["ἐκ",704132,0],["τῆς",709436,16],["Γαλααδ",702920,17],["ἥ",709781,177],["ἐστιν",704093,91],["πέραν",710280,0],["τοῦ",709436,35],["Ιορδάνου",706763,18]],"And their lot fell [to them] from Anassa, and [to the] plain of Labec of the land of Galaad, which is beyond Jordan."],["6",[["ὅτι",709803,7],["θυγατέρες",706320,191],["υἱῶν",713075,81],["Μανασση",708470,118],["ἐκληρονόμησαν",707724,150],["κλῆρον",707727,6],["ἐν",704639,0],["μέσῳ",708768,97],["τῶν",709436,80],["ἀδελφῶν",700249,81],["αὐτῶν",702165,284],["ἡ",709436,10],["δὲ",703303,11],["γῆ",703083,12],["Γαλααδ",702920,17],["ἐγενήθη",703104,37],["τοῖς",709436,147],["υἱοῖς",713075,148],["Μανασση",708470,118],["τοῖς",709436,147],["καταλελειμμένοις",707305,521]],"For the daughters of the sons of Manasse inherited a portion in the midst of their brethren, and the land of Galaad was assigned to the remainder of the sons of Manasse."],["7",[["καὶ",707031,7],["ἐγενήθη",703104,37],["ὅρια",709749,64],["υἱῶν",713075,81],["Μανασση",708470,118],["Δηλαναθ",703399,12],["ἥ",709781,177],["ἐστιν",704093,91],["κατὰ",707200,0],["πρόσωπον",710986,25],["υἱῶν",713075,81],["Αναθ",700948,118],["καὶ",707031,7],["πορεύεται",710667,117],["ἐπὶ",705080,0],["τὰ",709436,41],["ὅρια",709749,42],["ἐπὶ",705080,0],["Ιαμιν",706409,227],["καὶ",707031,7],["Ιασσιβ",706453,227],["ἐπὶ",705080,0],["πηγὴν",710450,9],["Θαφθωθ",706142,118]],"And the borders of the sons of Manasse were Delanath, which is before the sons of Anath, and it proceeds to the borders [even] to Jamin and Jassib to the fountain of Thaphthoth."],["8",[["τῷ",709436,113],["Μανασση",708470,114],["ἔσται",704093,93],["καὶ",707031,7],["Θαφεθ",706141,120],["ἐπὶ",705080,0],["τῶν",709436,43],["ὁρίων",709749,44],["Μανασση",708470,18],["τοῖς",709436,147],["υἱοῖς",713075,148],["Εφραιμ",705769,118]],"It shall belong to Manasse, and Thapheth on the borders of Manasse [shall belong] to the sons of Ephraim."],["9",[["καὶ",707031,7],["καταβήσεται",707202,93],["τὰ",709436,63],["ὅρια",709749,64],["ἐπὶ",705080,0],["φάραγγα",713351,9],["Καρανα",707138,118],["ἐπὶ",705080,0],["λίβα",708224,6],["κατὰ",707200,0],["φάραγγα",713351,9],["Ιαριηλ",706433,118],["τερέμινθος",712798,4],["τῷ",709436,113],["Εφραιμ",705769,114],["ἀνὰ",700902,0],["μέσον",708768,46],["πόλεως",710612,17],["Μανασση",708470,118],["καὶ",707031,7],["ὅρια",709749,64],["Μανασση",708470,118],["ἐπὶ",705080,0],["τὸν",709436,5],["βορρᾶν",702765,6],["εἰς",704105,0],["τὸν",709436,5],["χειμάρρουν",713783,27],["καὶ",707031,7],["ἔσται",704093,93],["αὐτοῦ",702165,49],["ἡ",709436,10],["διέξοδος",703668,12],["θάλασσα",706069,12]],"And the borders shall go down to the valley of Carana southward by the valley of Jariel, ([there is] a turpentine tree [belonging] to Ephraim between [that and] the city of Manasse:) and the borders of Manasse [are] northward to the brook; and the sea shall be its termination."],["10",[["ἀπὸ",701425,0],["λιβὸς",708224,18],["τῷ",709436,113],["Εφραιμ",705769,111],["καὶ",707031,7],["ἐπὶ",705080,0],["βορρᾶν",702765,6],["Μανασση",708470,118],["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["θάλασσα",706069,12],["ὅρια",709749,64],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἐπὶ",705080,0],["Ασηρ",701934,227],["συνάψουσιν",712404,218],["ἐπὶ",705080,0],["βορρᾶν",702765,6],["καὶ",707031,7],["τῷ",709436,113],["Ισσαχαρ",706843,114],["ἀπ᾿",701425,0],["ἀνατολῶν",701071,65]],"Southward [the land belongs] to Ephraim, and northward to Manasse; and the sea shall be their coast; and northward they shall border upon Aseb, and eastward upon Issachar."],["11",[["καὶ",707031,7],["ἔσται",704093,93],["Μανασση",708470,4],["ἐν",704639,0],["Ισσαχαρ",706843,111],["καὶ",707031,7],["ἐν",704639,0],["Ασηρ",701934,111],["Βαιθσαν",702432,118],["καὶ",707031,7],["αἱ",709436,190],["κῶμαι",708022,191],["αὐτῶν",702165,40],["καὶ",707031,7],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["Δωρ",703898,227],["καὶ",707031,7],["τὰς",709436,38],["κώμας",708022,39],["αὐτῆς",702165,86],["καὶ",707031,7],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["Μαγεδδω",708337,227],["καὶ",707031,7],["τὰς",709436,38],["κώμας",708022,39],["αὐτῆς",702165,86],["καὶ",707031,7],["τὸ",709436,24],["τρίτον",712968,46],["τῆς",709436,16],["Ναφετα",709214,17],["καὶ",707031,7],["τὰς",709436,38],["κώμας",708022,39],["αὐτῆς",702165,86]],"And Manasses shall have in [the portion of] Issachar and Aser Bæthsan and their villages, and the inhabitants of Dor, and its villages, and the inhabitants of Mageddo, and its villages, and the third part of Mapheta, and its villages."],["12",[["καὶ",707031,7],["οὐκ",709805,28],["ἠδυνάσθησαν",703838,99],["οἱ",709436,136],["υἱοὶ",713075,52],["Μανασση",708470,118],["ἐξολεθρεῦσαι",704956,106],["τὰς",709436,38],["πόλεις",710612,39],["ταύτας",709858,231],["καὶ",707031,7],["ἤρχετο",705453,19],["ὁ",709436,3],["Χαναναῖος",713711,4],["κατοικεῖν",707534,55],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ταύτῃ",709858,105]],"And the sons of Manasse were not able to destroy these cities; and the Chananite began to dwell in that land."],["13",[["καὶ",707031,7],["ἐγενήθη",703104,37],["καὶ",707031,7],["ἐπεὶ",705054,7],["κατίσχυσαν",707531,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐποίησαν",710582,150],["τοὺς",709436,58],["Χαναναίους",713711,57],["ὑπηκόους",713176,57],["ἐξολεθρεῦσαι",704956,106],["δὲ",703303,11],["αὐτοὺς",702165,62],["οὐκ",709805,28],["ἐξωλέθρευσαν",704956,150]],"And it came to pass that when the children of Israel were strong, they made the Chananites subject, but they did not utterly destroy them."],["14",[["ἀντεῖπαν",701223,150],["δὲ",703303,11],["οἱ",709436,136],["υἱοὶ",713075,52],["Ιωσηφ",706948,18],["τῷ",709436,113],["Ἰησοῦ",706701,114],["λέγοντες",708124,146],["διὰ",703417,0],["τί",712867,126],["ἐκληρονόμησας",707724,162],["ἡμᾶς",705981,194],["κλῆρον",707727,6],["ἕνα",704106,27],["καὶ",707031,7],["σχοίνισμα",712611,25],["ἕν",704106,46],["ἐγὼ",704018,164],["δὲ",703303,11],["λαὸς",708094,4],["πολύς",710646,14],["εἰμι",704093,157],["καὶ",707031,7],["ὁ",709436,3],["θεὸς",706192,4],["εὐλόγησέν",705631,2],["με",708618,163]],"And the sons of Joseph answered Joshua, saying, Wherefore hast thou caused us to inherit one inheritance, and one line? whereas I am a great people, and God has blessed me."],["15",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["Ἰησοῦς",706701,4],["εἰ",704071,7],["λαὸς",708094,4],["πολὺς",710646,14],["εἶ",704093,154],["ἀνάβηθι",700905,176],["εἰς",704105,0],["τὸν",709436,5],["δρυμὸν",703836,6],["καὶ",707031,7],["ἐκκάθαρον",704202,176],["σεαυτῷ",711599,50],["εἰ",704071,7],["στενοχωρεῖ",712070,91],["σε",711598,163],["τὸ",709436,34],["ὄρος",709768,15],["τὸ",709436,34],["Εφραιμ",705769,118]],"And Joshua said to them, If thou be a great people, go up to the forest, and clear [the land] for thyself, if mount Ephraim be too little for thee."],["16",[["καὶ",707031,7],["εἶπαν",705373,150],["οὐκ",709805,28],["ἀρκέσει",701765,127],["ἡμῖν",705994,90],["τὸ",709436,34],["ὄρος",709768,15],["τὸ",709436,34],["Εφραιμ",705769,118],["καὶ",707031,7],["ἵππος",706790,4],["ἐπίλεκτος",705189,14],["καὶ",707031,7],["σίδηρος",711774,4],["τῷ",709436,113],["Χαναναίῳ",713711,114],["τῷ",709436,113],["κατοικοῦντι",707534,379],["ἐν",704639,0],["αὐτῷ",702165,280],["ἐν",704639,0],["Βαιθσαν",702432,1],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["κώμαις",708022,76],["αὐτῆς",702165,86],["ἐν",704639,0],["τῇ",709436,100],["κοιλάδι",707758,1],["Ιεζραελ",706547,118]],"And they said, The mount of Ephraim does not please us, and the Chananite dwelling in it in Bæthsan, and in its villages, [and] in the valley of Jezrael, has choice cavalry and iron."],["17",[["καὶ",707031,7],["εἶπεν",705373,2],["Ἰησοῦς",706701,4],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ιωσηφ",706948,18],["εἰ",704071,7],["λαὸς",708094,4],["πολὺς",710646,14],["εἶ",704093,154],["καὶ",707031,7],["ἰσχὺν",706858,9],["μεγάλην",708653,36],["ἔχεις",705785,154],["οὐκ",709805,28],["ἔσται",704093,93],["σοι",711925,159],["κλῆρος",707727,4],["εἷς",704106,14]],"And Joshua said to the sons of Joseph, If thou art a great people, and hast great strength, thou shalt not have [only] one inheritance."],["18",[["ὁ",709436,3],["γὰρ",702963,11],["δρυμὸς",703836,4],["ἔσται",704093,93],["σοι",711925,159],["ὅτι",709803,7],["δρυμός",703836,4],["ἐστιν",704093,91],["καὶ",707031,7],["ἐκκαθαριεῖς",704202,166],["αὐτὸν",702165,85],["καὶ",707031,7],["ἔσται",704093,93],["σοι",711925,159],["καὶ",707031,7],["ὅταν",709801,28],["ἐξολεθρεύσῃς",704956,175],["τὸν",709436,5],["Χαναναῖον",713711,6],["ὅτι",709803,7],["ἵππος",706790,4],["ἐπίλεκτός",705189,14],["ἐστιν",704093,91],["αὐτῷ",702165,50],["σὺ",712181,164],["γὰρ",702963,11],["ὑπερισχύεις",713144,154],["αὐτοῦ",702165,102]],"For thou shalt have the wood, for there is a wood, and thou shalt clear it, and [the land] shall be thine; even when thou shalt have utterly destroyed the Chananite, for he has chosen cavalry; yet thou art stronger than he."]]