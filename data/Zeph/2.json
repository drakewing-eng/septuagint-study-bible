[["1",[["συνάχθητε",712375,372],["καὶ",707031,7],["συνδέθητε",712417,372],["τὸ",709436,768],["ἔθνος",704068,297],["τὸ",709436,768],["ἀπαίδευτον",701328,719]],"Be ye gathered and closely joined together, O unchastened nation;"],["2",[["πρὸ",710747,0],["τοῦ",709436,20],["γενέσθαι",703104,109],["ὑμᾶς",713080,194],["ὡς",714148,7],["ἄνθος",701157,15],["παραπορευόμενον",710094,122],["πρὸ",710747,0],["τοῦ",709436,20],["ἐπελθεῖν",705068,106],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["ὀργὴν",709728,9],["κυρίου",707996,18],["πρὸ",710747,0],["τοῦ",709436,20],["ἐπελθεῖν",705068,106],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["ἡμέραν",705984,9],["θυμοῦ",706334,18],["κυρίου",707996,18]],"before ye become as the flower that passes away, before the anger of the Lord come upon you, before the day of the wrath of the Lord come upon you."],["3",[["ζητήσατε",705879,74],["τὸν",709436,5],["κύριον",707996,6],["πάντες",710177,538],["ταπεινοὶ",712714,538],["γῆς",703083,17],["κρίμα",707903,25],["ἐργάζεσθε",705383,73],["καὶ",707031,7],["δικαιοσύνην",703695,9],["ζητήσατε",705879,74],["καὶ",707031,7],["ἀποκρίνεσθε",701492,374],["αὐτά",702165,71],["ὅπως",709719,7],["σκεπασθῆτε",711832,394],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["ὀργῆς",709728,17],["κυρίου",707996,18]],"Seek ye the Lord, all ye meek of the earth; do judgment, and seek justice, and answer accordingly; that ye may be hid in the day of the wrath of the Lord."],["4",[["διότι",703734,7],["Γάζα",702884,12],["διηρπασμένη",703562,203],["ἔσται",704093,93],["καὶ",707031,7],["Ἀσκαλὼν",701962,12],["ἔσται",704093,93],["εἰς",704105,0],["ἀφανισμόν",702183,6],["καὶ",707031,7],["Ἄζωτος",700351,120],["μεσημβρίας",708758,17],["ἐκριφήσεται",704306,134],["καὶ",707031,7],["Ακκαρων",700549,120],["ἐκριζωθήσεται",704303,134]],"For Gaza shall be utterly spoiled, and Ascalon shall be destroyed; and Azotus shall be cast forth at noon-day, and Accaron shall be rooted up."],["5",[["οὐαὶ",709807,88],["οἱ",709436,643],["κατοικοῦντες",707534,759],["τὸ",709436,24],["σχοίνισμα",712611,25],["τῆς",709436,16],["θαλάσσης",706069,17],["πάροικοι",710159,538],["Κρητῶν",707898,286],["λόγος",708236,4],["κυρίου",707996,18],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["Χανααν",713708,766],["γῆ",703083,258],["ἀλλοφύλων",700706,169],["καὶ",707031,7],["ἀπολῶ",701513,165],["ὑμᾶς",713080,194],["ἐκ",704132,0],["κατοικίας",707537,17]],"Woe to them that dwell on the border of the sea, neighbours of the Cretans! the word of the Lord is against you, O Chanaan, land of the Philistines, and I will destroy you out of [your] dwelling-place."],["6",[["καὶ",707031,7],["ἔσται",704093,93],["Κρήτη",707899,12],["νομὴ",709337,12],["ποιμνίων",710598,44],["καὶ",707031,7],["μάνδρα",708473,12],["προβάτων",710768,44]],"And Crete shall be a pasture of flocks, and a fold of sheep."],["7",[["καὶ",707031,7],["ἔσται",704093,93],["τὸ",709436,34],["σχοίνισμα",712611,15],["τῆς",709436,16],["θαλάσσης",706069,17],["τοῖς",709436,147],["καταλοίποις",707317,230],["οἴκου",709516,18],["Ιουδα",706768,18],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["νεμήσονται",709253,135],["ἐν",704639,0],["τοῖς",709436,147],["οἴκοις",709516,148],["Ἀσκαλῶνος",701962,17],["δείλης",703324,82],["καταλύσουσιν",707323,218],["ἀπὸ",701425,0],["προσώπου",710986,21],["υἱῶν",713075,81],["Ιουδα",706768,18],["ὅτι",709803,7],["ἐπέσκεπται",705250,187],["αὐτοὺς",702165,62],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["αὐτῶν",702165,40],["καὶ",707031,7],["ἀπέστρεψε",701598,2],["τὴν",709436,8],["αἰχμαλωσίαν",700499,9],["αὐτῶν",702165,40]],"And the sea coast shall be for the remnant of the house of Juda; they shall pasture upon them in the houses of Ascalon; they shall rest in the evening because of the children of Juda; for the Lord their God has visited them, and he will turn away their captivity."],["8",[["ἤκουσα",700587,155],["ὀνειδισμοὺς",709657,57],["Μωαβ",709085,17],["καὶ",707031,7],["κονδυλισμοὺς",707810,57],["υἱῶν",713075,81],["Αμμων",700847,118],["ἐν",704639,0],["οἷς",709781,311],["ὠνείδιζον",709655,137],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["καὶ",707031,7],["ἐμεγαλύνοντο",708647,139],["ἐπὶ",705080,0],["τὰ",709436,41],["ὅριά",709749,42],["μου",709032,133]],"I have heard the revilings of Moab, and the insults of the children of Ammon, wherewith they have reviled my people, and magnified themselves against my coasts."],["9",[["διὰ",703417,0],["τοῦτο",709858,129],["ζῶ",705851,157],["ἐγώ",704018,164],["λέγει",708124,91],["κύριος",707996,4],["τῶν",709436,130],["δυνάμεων",703839,65],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["διότι",703734,7],["Μωαβ",709085,12],["ὡς",714148,7],["Σοδομα",711920,120],["ἔσται",704093,93],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["Αμμων",700847,118],["ὡς",714148,7],["Γομορρα",703165,120],["καὶ",707031,7],["Δαμασκὸς",703275,120],["ἐκλελειμμένη",704237,203],["ὡς",714148,7],["θιμωνιὰ",706240,12],["ἅλωνος",700741,17],["καὶ",707031,7],["ἠφανισμένη",702182,203],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["οἱ",709436,136],["κατάλοιποι",707317,138],["λαοῦ",708094,18],["μου",709032,133],["διαρπῶνται",703562,135],["αὐτούς",702165,62],["καὶ",707031,7],["οἱ",709436,136],["κατάλοιποι",707317,138],["ἔθνους",704068,21],["μου",709032,133],["κληρονομήσουσιν",707724,218],["αὐτούς",702165,62]],"Therefore, [as] I live, saith the Lord of hosts, the God of Israel, Moab shall be as Sodoma, and the children of Ammon as Gomorrha; and Damascus [shall be] left as a heap of the threshing-floor, and desolate for ever: and the remnant of my people shall plunder them, and the remnant of my nation shall inherit them."],["10",[["αὕτη",709858,107],["αὐτοῖς",702165,151],["ἀντὶ",701227,0],["τῆς",709436,16],["ὕβρεως",713051,17],["αὐτῶν",702165,40],["διότι",703734,7],["ὠνείδισαν",709655,150],["καὶ",707031,7],["ἐμεγαλύνθησαν",708647,99],["ἐπὶ",705080,0],["τὸν",709436,5],["κύριον",707996,6],["τὸν",709436,5],["παντοκράτορα",709986,6]],"This is their punishment in return for their haughtiness, because they have reproached and magnified themselves against the Lord Almighty."],["11",[["ἐπιφανήσεται",705317,134],["κύριος",707996,4],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἐξολεθρεύσει",704956,127],["πάντας",710177,60],["τοὺς",709436,58],["θεοὺς",706192,57],["τῶν",709436,43],["ἐθνῶν",704068,44],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["προσκυνήσουσιν",710925,218],["αὐτῷ",702165,50],["ἕκαστος",704133,14],["ἐκ",704132,0],["τοῦ",709436,35],["τόπου",712903,18],["αὐτοῦ",702165,102],["πᾶσαι",710177,192],["αἱ",709436,190],["νῆσοι",709302,191],["τῶν",709436,43],["ἐθνῶν",704068,44]],"The Lord shall appear against them, and shall utterly destroy all the gods of the nations of the earth; and they shall worship him every one from his place, [even] all the islands of the nations."],["12",[["καὶ",707031,7],["ὑμεῖς",713081,219],["Αἰθίοπες",700420,185],["τραυματίαι",712921,52],["ῥομφαίας",711291,17],["μού",709032,133],["ἐστε",704093,87]],"Ye Ethiopians also are the slain of my sword."],["13",[["καὶ",707031,7],["ἐκτενεῖ",704322,127],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["βορρᾶν",702765,6],["καὶ",707031,7],["ἀπολεῖ",701513,127],["τὸν",709436,5],["Ἀσσύριον",702004,6],["καὶ",707031,7],["θήσει",712849,127],["τὴν",709436,8],["Νινευη",709312,9],["εἰς",704105,0],["ἀφανισμὸν",702183,6],["ἄνυδρον",701285,27],["ὡς",714148,7],["ἔρημον",705420,9]],"And he shall stretch forth his hand against the north and destroy the Assyrian, and make Nineve a dry wilderness, [even] as a desert."],["14",[["καὶ",707031,7],["νεμήσονται",709253,135],["ἐν",704639,0],["μέσῳ",708768,97],["αὐτῆς",702165,86],["ποίμνια",710598,64],["καὶ",707031,7],["πάντα",710177,195],["τὰ",709436,63],["θηρία",706252,64],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["χαμαιλέοντες",713702,52],["καὶ",707031,7],["ἐχῖνοι",705780,52],["ἐν",704639,0],["τοῖς",709436,95],["φατνώμασιν",713393,96],["αὐτῆς",702165,86],["κοιτασθήσονται",707779,144],["καὶ",707031,7],["θηρία",706252,42],["φωνήσει",713639,127],["ἐν",704639,0],["τοῖς",709436,95],["διορύγμασιν",703731,96],["αὐτῆς",702165,86],["κόρακες",707831,52],["ἐν",704639,0],["τοῖς",709436,147],["πυλῶσιν",711083,148],["αὐτῆς",702165,86],["διότι",703734,7],["κέδρος",707590,12],["τὸ",709436,34],["ἀνάστημα",701058,15],["αὐτῆς",702165,86]],"And flocks, and all the wild beasts of the land, and chameleons shall feed in the midst thereof: and hedgehogs shall lodge in the ceilings thereof; and wild beasts shall cry in the breaches thereof, and ravens in her porches, whereas her loftiness was [as] a cedar."],["15",[["αὕτη",709858,107],["ἡ",709436,10],["πόλις",710612,12],["ἡ",709436,10],["φαυλίστρια",713397,12],["ἡ",709436,10],["κατοικοῦσα",707534,188],["ἐπ᾿",705080,0],["ἐλπίδι",704530,1],["ἡ",709436,10],["λέγουσα",708124,188],["ἐν",704639,0],["καρδίᾳ",707141,1],["αὐτῆς",702165,86],["ἐγώ",704018,164],["εἰμι",704093,157],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["μετ᾿",708780,0],["ἐμὲ",704555,163],["ἔτι",705538,28],["πῶς",711121,28],["ἐγενήθη",703104,37],["εἰς",704105,0],["ἀφανισμόν",702183,6],["νομὴ",709337,12],["θηρίων",706252,44],["πᾶς",710177,14],["ὁ",709436,3],["διαπορευόμενος",703551,122],["δι᾿",703417,0],["αὐτῆς",702165,86],["συριεῖ",712538,127],["καὶ",707031,7],["κινήσει",707679,127],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτοῦ",702165,102]],"This is the scornful city that dwells securely, that says in her heart, I am, and there is no longer any [to be] after me: how is she become desolate, a habitation of wild beasts! every one that passes through her shall hiss, and shake his hands."]]