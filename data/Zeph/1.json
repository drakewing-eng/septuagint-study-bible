[["1",[["λόγος",708236,4],["κυρίου",707996,18],["ὃς",709781,213],["ἐγενήθη",703104,37],["πρὸς",710844,0],["Σοφονιαν",711984,6],["τὸν",709436,5],["τοῦ",709436,35],["Χουσι",713933,18],["υἱὸν",713075,6],["Γοδολιου",703148,18],["τοῦ",709436,35],["Αμαριου",700772,18],["τοῦ",709436,35],["Εζεκιου",704044,18],["ἐν",704639,0],["ἡμέραις",705984,76],["Ιωσιου",706950,18],["υἱοῦ",713075,18],["Αμων",700896,18],["βασιλέως",702580,18],["Ιουδα",706768,18]],"The word of the Lord which came to Sophonias the son of Chusi, the son of Godolias, the son of Amorias, the son of Ezekias, in the days of Josias son of Amon, king of Juda."],["2",[["ἐκλείψει",704239,1],["ἐκλιπέτω",704237,45],["πάντα",710177,27],["ἀπὸ",701425,0],["προσώπου",710986,21],["τῆς",709436,16],["γῆς",703083,17],["λέγει",708124,91],["κύριος",707996,4]],"Let there be an utter cutting off from the face of the land, saith the Lord."],["3",[["ἐκλιπέτω",704237,45],["ἄνθρωπος",701163,4],["καὶ",707031,7],["κτήνη",707934,64],["ἐκλιπέτω",704237,45],["τὰ",709436,63],["πετεινὰ",710439,64],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["οἱ",709436,136],["ἰχθύες",706870,52],["τῆς",709436,16],["θαλάσσης",706069,17],["καὶ",707031,7],["ἐξαρῶ",704839,165],["τοὺς",709436,58],["ἀνθρώπους",701163,57],["ἀπὸ",701425,0],["προσώπου",710986,21],["τῆς",709436,16],["γῆς",703083,17],["λέγει",708124,91],["κύριος",707996,4]],"Let man and cattle be cut off; let the birds of the air and the fishes of the sea be cut off; and the ungodly shall fail, and I will take away the transgressors from the face of the land, saith the Lord."],["4",[["καὶ",707031,7],["ἐκτενῶ",704322,165],["τὴν",709436,8],["χεῖρά",713787,9],["μου",709032,133],["ἐπὶ",705080,0],["Ιουδαν",706775,6],["καὶ",707031,7],["ἐπὶ",705080,0],["πάντας",710177,60],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["ἐξαρῶ",704839,165],["ἐκ",704132,0],["τοῦ",709436,35],["τόπου",712903,18],["τούτου",709858,102],["τὰ",709436,41],["ὀνόματα",709666,42],["τῆ