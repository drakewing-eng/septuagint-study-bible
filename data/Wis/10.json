[["1",[["αὕτη",709858,107],["πρωτόπλαστον",711040,27],["πατέρα",710189,6],["κόσμου",707851,18],["μόνον",709003,27],["κτισθέντα",707938,260],["διεφύλαξεν",703632,2],["καὶ",707031,7],["ἐξείλατο",704838,23],["αὐτὸν",702165,85],["ἐκ",704132,0],["παραπτώματος",710095,21],["ἰδίου",706493,92]],"She preserved the first formed father of the world, that was created alone, and brought him out of his fall,"],["2",[["ἔδωκέν",703654,2],["τε",712751,11],["αὐτῷ",702165,50],["ἰσχὺν",706858,9],["κρατῆσαι",707879,106],["ἁπάντων",701362,83]],"and gave him power to rule all things."],["3",[["ἀποστὰς",702214,182],["δὲ",703303,11],["ἀπ᾿",701425,0],["αὐτῆς",702165,86],["ἄδικος",700272,14],["ἐν",704639,0],["ὀργῇ",709728,1],["αὐτοῦ",702165,102],["ἀδελφοκτόνοις",700247,230],["συναπώλετο",712402,23],["θυμοῖς",706334,148]],"But when the unrighteous went away from her in his anger, he perished also in the fury wherewith he murdered his brother."],["4",[["δι᾿",703417,0],["ὃν",709781,112],["κατακλυζομένην",707278,173],["γῆν",703083,9],["πάλιν",709942,28],["ἔσωσεν",712627,2],["σοφία",711981,12],["δι᾿",703417,0],["εὐτελοῦς",705705,92],["ξύλου",709427,21],["τὸν",709436,5],["δίκαιον",703694,27],["κυβερνήσασα",707946,149]],"For whose cause the earth being drowned with the flood, wisdom again preserved it, and directed the course of the righteous in a piece of wood of small value."],["5",[["αὕτη",709858,107],["καὶ",707031,7],["ἐν",704639,0],["ὁμονοίᾳ",709639,1],["πονηρίας",710659,17],["ἐθνῶν",704068,44],["συγχυθέντων",712243,505],["ἔγνω",703105,2],["τὸν",709436,5],["δίκαιον",703694,27],["καὶ",707031,7],["ἐτήρησεν",712844,2],["αὐτὸν",702165,85],["ἄμεμπτον",700807,27],["θεῷ",706192,114],["καὶ",707031,7],["ἐπὶ",705080,0],["τέκνου",712761,21],["σπλάγχνοις",712018,96],["ἰσχυρὸν",706855,27],["ἐφύλαξεν",713619,2]],"Moreover, the nations in their wicked conspiracy being confounded, she found out the righteous, and preserved him blameless unto God, and kept him strong against his tender compassion toward his son."],["6",[["αὕτη",709858,107],["δίκαιον",703694,27],["ἐξαπολλυμένων",704870,682],["ἀσεβῶν",701909,169],["ἐρρύσατο",711309,23],["φυγόντα",713433,365],["καταβάσιον",707205,46],["πῦρ",711088,25],["Πενταπόλεως",710265,17]],"When the ungodly perished, she delivered the righteous man, who fled from the fire which fell down upon the five cities."],["7",[["ἧς",709781,167],["ἔτι",705538,28],["μαρτύριον",708525,15],["τῆς",709436,16],["πονηρίας",710659,17],["καπνιζομένη",707131,211],["καθέστηκε",707011,171],["χέρσος",713834,12],["καὶ",707031,7],["ἀτελέσιν",702084,291],["ὥραις",714128,76],["καρποφοροῦντα",707170,242],["φυτά",713637,64],["ἀπιστούσης",701411,222],["ψυχῆς",714070,17],["μνημεῖον",708963,15],["ἑστηκυῖα",706846,287],["στήλη",712092,12],["ἁλός",700728,18]],"Of whose wickedness, even to this day the waste land that smoketh is a testimony, and plants bearing fruit that never come to ripeness: and a standing pillar of salt is a monument of an unbelieving soul."],["8",[["σοφίαν",711981,9],["γὰρ",702963,11],["παροδεύσαντες",710153,196],["οὐ",709805,28],["μόνον",709001,28],["ἐβλάβησαν",702732,99],["τοῦ",709436,20],["μὴ",708851,28],["γνῶναι",703105,106],["τὰ",709436,41],["καλά",707097,68],["ἀλλὰ",700680,7],["καὶ",707031,28],["τῆς",709436,16],["ἀφροσύνης",702235,17],["ἀπέλιπον",701508,150],["τῷ",709436,113],["βίῳ",702724,114],["μνημόσυνον",708966,25],["ἵνα",706747,7],["ἐν",704639,0],["οἷς",709781,311],["ἐσφάλησαν",712575,99],["μηδὲ",708855,7],["λαθεῖν",708088,106],["δυνηθῶσιν",703838,272]],"For regarding not wisdom, they gat not only this hurt, that they knew not the things which were good; but also left behind them to the world a memorial of their foolishness: so that in the things wherein they offended they could not so much as be hid."],["9",[["σοφία",711981,12],["δὲ",703303,11],["τοὺς",709436,58],["θεραπεύοντας",706200,235],["αὐτὴν",702165,104],["ἐκ",704132,0],["πόνων",710661,81],["ἐρρύσατο",711309,23]],"But wisdom delivered from pain those that attended upon her."],["10",[["αὕτη",709858,107],["φυγάδα",713608,6],["ὀργῆς",709728,17],["ἀδελφοῦ",700249,18],["δίκαιον",703694,27],["ὡδήγησεν",709448,2],["ἐν",704639,0],["τρίβοις",712939,1],["εὐθείαις",705602,291],["ἔδειξεν",703314,2],["αὐτῷ",702165,50],["βασιλείαν",702577,9],["θεοῦ",706192,18],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["γνῶσιν",703138,9],["ἁγίων",700159,169],["εὐπόρησεν",705664,2],["αὐτὸν",702165,85],["ἐν",704639,0],["μόχθοις",709039,148],["καὶ",707031,7],["ἐπλήθυνεν",710530,2],["τοὺς",709436,58],["πόνους",710661,57],["αὐτοῦ",702165,102]],"When the righteous fled from his brother's wrath, she guided him in right paths, shewed him the kingdom of God, and gave him knowledge of holy things, made him rich in his travels, and multiplied [the fruit of] his labours."],["11",[["ἐν",704639,0],["πλεονεξίᾳ",710523,1],["κατισχυόντων",707531,170],["αὐτὸν",702165,85],["παρέστη",710152,2],["καὶ",707031,7],["ἐπλούτισεν",710562,2],["αὐτόν",702165,85]],"In the covetousness of such as oppressed him she stood by him, and made him rich."],["12",[["διεφύλαξεν",703632,2],["αὐτὸν",702165,85],["ἀπὸ",701425,0],["ἐχθρῶν",705779,169],["καὶ",707031,7],["ἀπὸ",701425,0],["ἐνεδρευόντων",704703,170],["ἠσφαλίσατο",702041,23],["καὶ",707031,7],["ἀγῶνα",700211,6],["ἰσχυρὸν",706855,27],["ἐβράβευσεν",702802,2],["αὐτῷ",702165,50],["ἵνα",706747,7],["γνῷ",703105,172],["ὅτι",709803,7],["παντὸς",710177,92],["δυνατωτέρα",703845,178],["ἐστὶν",704093,91],["εὐσέβεια",705685,12]],"She defended him from his enemies, and kept him safe from those that lay in wait, and in a sore conflict she gave him the victory; that he might know that godliness is stronger than all."],["13",[["αὕτη",709858,107],["πραθέντα",710480,260],["δίκαιον",703694,27],["οὐκ",709805,28],["ἐγκατέλιπεν",703967,2],["ἀλλὰ",700680,7],["ἐξ",704132,0],["ἁμαρτίας",700775,17],["ἐρρύσατο",711309,23],["αὐτόν",702165,85]],"When the righteous was sold, she forsook him not, but delivered him from sin: she went down with him into the pit,"],["14",[["συγκατέβη",712203,2],["αὐτῷ",702165,50],["εἰς",704105,0],["λάκκον",708067,6],["καὶ",707031,7],["ἐν",704639,0],["δεσμοῖς",703372,148],["οὐκ",709805,28],["ἀφῆκεν",702211,2],["αὐτόν",702165,85],["ἕως",705792,7],["ἤνεγκεν",713428,2],["αὐτῷ",702165,50],["σκῆπτρα",711851,42],["βασιλείας",702577,17],["καὶ",707031,7],["ἐξουσίαν",704974,9],["τυραννούντων",713023,170],["αὐτοῦ",702165,102],["ψευδεῖς",714036,60],["τε",712751,11],["ἔδειξεν",703314,2],["τοὺς",709436,58],["μωμησαμένους",709100,525],["αὐτὸν",702165,85],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["δόξαν",703791,9],["αἰώνιον",700505,36]],"and left him not in bonds, till she brought him the sceptre of the kingdom, and power against those that oppressed him: as for them that had accused him, she shewed them to be liars, and gave him perpetual glory."],["15",[["αὕτη",709858,107],["λαὸν",708094,6],["ὅσιον",709782,27],["καὶ",707031,7],["σπέρμα",712008,25],["ἄμεμπτον",700807,46],["ἐρρύσατο",711309,23],["ἐξ",704132,0],["ἔθνους",704068,21],["θλιβόντων",706274,170]],"She delivered the righteous people and blameless seed from the nation that oppressed them."],["16",[["εἰσῆλθεν",704114,2],["εἰς",704105,0],["ψυχὴν",714070,9],["θεράποντος",706201,18],["κυρίου",707996,18],["καὶ",707031,7],["ἀντέστη",701154,2],["βασιλεῦσιν",702580,148],["φοβεροῖς",713530,230],["ἐν",704639,0],["τέρασι",712793,96],["καὶ",707031,7],["σημείοις",711748,96]],"She entered into the soul of the servant of the Lord, and withstood dreadful kings in wonders and signs;"],["17",[["ἀπέδωκεν",701449,2],["ὁσίοις",709782,230],["μισθὸν",708939,6],["κόπων",707825,81],["αὐτῶν",702165,40],["ὡδήγησεν",709448,2],["αὐτοὺς",702165,62],["ἐν",704639,0],["ὁδῷ",709458,1],["θαυμαστῇ",706138,101],["καὶ",707031,7],["ἐγένετο",703104,23],["αὐτοῖς",702165,151],["εἰς",704105,0],["σκέπην",711839,9],["ἡμέρας",705984,17],["καὶ",707031,7],["εἰς",704105,0],["φλόγα",713524,9],["ἄστρων",702024,44],["τὴν",709436,8],["νύκτα",709386,9]],"rendered to the righteous a reward of their labours, guided them in a marvellous way, and was unto them for a cover by day, and a light of stars in the night season;"],["18",[["διεβίβασεν",703424,2],["αὐτοὺς",702165,62],["θάλασσαν",706069,9],["ἐρυθρὰν",705447,36],["καὶ",707031,7],["διήγαγεν",703442,2],["αὐτοὺς",702165,62],["δι᾿",703417,0],["ὕδατος",713071,21],["πολλοῦ",710646,92]],"brought them through the Red sea, and led them through much water:"],["19",[["τοὺς",709436,58],["δὲ",703303,11],["ἐχθροὺς",705779,60],["αὐτῶν",702165,40],["κατέκλυσεν",707278,2],["καὶ",707031,7],["ἐκ",704132,0],["βάθους",702376,21],["ἀβύσσου",700098,18],["ἀνέβρασεν",700918,2],["αὐτούς",702165,62]],"but she drowned their enemies, and cast them up out of the bottom of the deep."],["20",[["διὰ",703417,0],["τοῦτο",709858,129],["δίκαιοι",703694,138],["ἐσκύλευσαν",711900,150],["ἀσεβεῖς",701909,60],["καὶ",707031,7],["ὕμνησαν",713085,150],["κύριε",707996,153],["τὸ",709436,24],["ὄνομα",709666,25],["τὸ",709436,24],["ἅγιόν",700159,46],["σου",711945,133],["τήν",709436,8],["τε",712751,11],["ὑπέρμαχόν",713149,6],["σου",711945,133],["χεῖρα",713787,9],["ᾔνεσαν",700459,150],["ὁμοθυμαδόν",709624,28]],"Therefore the righteous spoiled the ungodly, and praised thy holy name, O Lord, and magnified with one accord thine hand, that fought for them."],["21",[["ὅτι",709803,7],["ἡ",709436,10],["σοφία",711981,12],["ἤνοιξεν",701186,2],["στόμα",712125,25],["κωφῶν",708033,169],["καὶ",707031,7],["γλώσσας",703120,39],["νηπίων",709295,169],["ἔθηκεν",712849,2],["τρανάς",712918,39]],"For wisdom opened the mouth of the dumb, and made the tongues of them that cannot speak eloquent."]]