[["1",[["τὸ",709436,34],["γὰρ",702963,11],["ἄφθαρτόν",702206,26],["σου",711945,133],["πνεῦμά",710566,15],["ἐστιν",704093,91],["ἐν",704639,0],["πᾶσιν",710177,94]],"For thine incorruptible Spirit is in all things."],["2",[["διὸ",703714,7],["τοὺς",709436,58],["παραπίπτοντας",710089,235],["κατ᾿",707200,0],["ὀλίγον",709568,46],["ἐλέγχεις",704416,154],["καὶ",707031,7],["ἐν",704639,0],["οἷς",709781,311],["ἁμαρτάνουσιν",700773,349],["ὑπομιμνῄσκων",713220,72],["νουθετεῖς",709367,154],["ἵνα",706747,7],["ἀπαλλαγέντες",701333,247],["τῆς",709436,16],["κακίας",707054,17],["πιστεύσωσιν",710483,234],["ἐπὶ",705080,0],["σέ",711598,163],["κύριε",707996,153]],"Therefore chastenest thou them by little and little that offend, and warnest them by putting them in remembrance wherein they have offended, that leaving their wickedness they may believe on thee, O Lord."],["3",[["καὶ",707031,7],["γὰρ",702963,11],["τοὺς",709436,58],["πάλαι",709935,28],["οἰκήτορας",709504,57],["τῆς",709436,16],["ἁγίας",700159,82],["σου",711945,133],["γῆς",703083,17]],"For it was thy will to destroy by the hands of our fathers both those old inhabitants of thy holy land,"],["4",[["μισήσας",708935,182],["ἐπὶ",705080,0],["τῷ",709436,53],["ἔχθιστα",705779,430],["πράσσειν",710721,55],["ἔργα",705396,42],["φαρμακειῶν",713368,65],["καὶ",707031,7],["τελετὰς",712779,39],["ἀνοσίους",701199,119]],"whom thou hatedst for doing most odious works of witchcrafts, and wicked sacrifices;"],["5",[["τέκνων",712761,44],["τε",712751,11],["φονὰς",713544,57],["ἀνελεήμονας",701120,60],["καὶ",707031,7],["σπλαγχνοφάγον",712019,46],["ἀνθρωπίνων",701162,198],["σαρκῶν",711537,65],["θοῖναν",706282,9],["καὶ",707031,7],["αἵματος",700442,21],["ἐκ",704132,0],["μέσου",708768,92],["μύστας",709081,57],["θιάσου",706260,18]],"and also those merciless murderers of children, and devourers of man's flesh, and the feasts of blood,",{"s":"d","q":0.53}],["6",[["καὶ",707031,7],["αὐθέντας",702127,57],["γονεῖς",703169,52],["ψυχῶν",714070,65],["ἀβοηθήτων",700084,198],["ἐβουλήθης",702795,168],["ἀπολέσαι",701513,106],["διὰ",703417,0],["χειρῶν",713787,65],["πατέρων",710189,81],["ἡμῶν",705999,145]],"with their priests out of the midst of their idolatrous crew, and the parents, that killed with their own hands souls destitute of help:",{"s":"d","q":0.65}],["7",[["ἵνα",706747,7],["ἀξίαν",701308,36],["ἀποικίαν",701463,9],["δέξηται",703393,239],["θεοῦ",706192,18],["παίδων",709932,81],["ἡ",709436,10],["παρὰ",709995,0],["σοὶ",711925,159],["πασῶν",710177,198],["τιμιωτάτη",712858,417],["γῆ",703083,12]],"that the land, which thou esteemedst above all other, might receive a worthy colony of God's children."],["8",[["ἀλλὰ",700680,7],["καὶ",707031,28],["τούτων",709858,40],["ὡς",714148,7],["ἀνθρώπων",701163,81],["ἐφείσω",713406,174],["ἀπέστειλάς",701592,162],["τε",712751,11],["προδρόμους",710784,60],["τοῦ",709436,20],["στρατοπέδου",712151,21],["σου",711945,133],["σφῆκας",712583,57],["ἵνα",706747,7],["αὐτοὺς",702165,62],["κατὰ",707200,0],["βραχὺ",702809,46],["ἐξολεθρεύσωσιν",704956,234]],"Nevertheless even those thou sparedst as men, and didst send wasps, forerunners of thine host, to destroy them by little and little."],["9",[["οὐκ",709805,28],["ἀδυνατῶν",700296,72],["ἐν",704639,0],["παρατάξει",710107,114],["ἀσεβεῖς",701909,60],["δικαίοις",703694,230],["ὑποχειρίους",713258,60],["δοῦναι",703654,106],["ἢ",705924,7],["θηρίοις",706252,96],["δεινοῖς",703328,94],["ἢ",705924,7],["λόγῳ",708236,114],["ἀποτόμῳ",701620,30],["ὑφ᾿",713184,0],["ἓν",704106,46],["ἐκτρῖψαι",704345,106]],"Not that thou wast unable to bring the ungodly under the hand of the righteous in battle, or to destroy them at once with cruel beasts, or with one rough word:"],["10",[["κρίνων",707904,44],["δὲ",703303,11],["κατὰ",707200,0],["βραχὺ",702809,46],["ἐδίδους",703654,497],["τόπον",712903,6],["μετανοίας",708810,17],["οὐκ",709805,28],["ἀγνοῶν",700175,72],["ὅτι",709803,7],["πονηρὰ",710660,29],["ἡ",709436,10],["γένεσις",703043,12],["αὐτῶν",702165,40],["καὶ",707031,7],["ἔμφυτος",704638,29],["ἡ",709436,10],["κακία",707054,12],["αὐτῶν",702165,40],["καὶ",707031,7],["ὅτι",709803,7],["οὐ",709805,28],["μὴ",708851,28],["ἀλλαγῇ",700683,384],["ὁ",709436,3],["λογισμὸς",708234,4],["αὐτῶν",702165,40],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"but executing thy judgments upon them by little and little, thou gavest them place of repentance, not being ignorant that they were a naughty generation, and that their malice was bred in them, and that their cogitation would never be changed."],["11",[["σπέρμα",712008,15],["γὰρ",702963,11],["ἦν",704093,13],["κατηραμένον",707396,327],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["οὐδὲ",709816,7],["εὐλαβούμενός",705627,122],["τινα",712866,356],["ἐφ᾿",705080,0],["οἷς",709781,311],["ἡμάρτανον",700773,137],["ἄδειαν",700242,9],["ἐδίδους",703654,497]],"For it was a cursed seed from the beginning; neither didst thou for fear of any man give them pardon for those things wherein they sinned."],["12",[["τίς",712867,158],["γὰρ",702963,11],["ἐρεῖ",705415,127],["τί",712867,126],["ἐποίησας",710582,162],["ἢ",705924,7],["τίς",712867,158],["ἀντιστήσεται",701154,93],["τῷ",709436,53],["κρίματί",707903,54],["σου",711945,133],["τίς",712867,158],["δὲ",703303,11],["ἐγκαλέσει",703961,127],["σοι",711925,159],["κατὰ",707200,0],["ἐθνῶν",704068,44],["ἀπολωλότων",701513,461],["ἃ",709781,69],["σὺ",712181,164],["ἐποίησας",710582,162],["ἢ",705924,7],["τίς",712867,158],["εἰς",704105,0],["κατάστασίν",707436,9],["σοι",711925,159],["ἐλεύσεται",705453,93],["ἔκδικος",704177,14],["κατὰ",707200,0],["ἀδίκων",700272,169],["ἀνθρώπων",701163,81]],"For who shall say, What hast thou done? or who shall withstand thy judgment? or who shall accuse thee for the nations that perish, whom thou hast made? or who shall come to stand against thee, to be revenged for the unrighteous men?"],["13",[["οὔτε",709857,7],["γὰρ",702963,11],["θεός",706192,4],["ἐστιν",704093,91],["πλὴν",710540,28],["σοῦ",711945,133],["ᾧ",709781,309],["μέλει",708696,91],["περὶ",710285,0],["πάντων",710177,169],["ἵνα",706747,7],["δείξῃς",703314,175],["ὅτι",709803,7],["οὐκ",709805,28],["ἀδίκως",700273,28],["ἔκρινας",707905,162]],"For neither is there any God but thou that careth for all, to whom thou mightest shew that thy judgment is not unright."],["14",[["οὔτε",709857,7],["βασιλεὺς",702580,4],["ἢ",705924,7],["τύραννος",713026,4],["ἀντοφθαλμῆσαι",701282,106],["δυνήσεταί",703838,93],["σοι",711925,159],["περὶ",710285,0],["ὧν",709781,252],["ἐκόλασας",707786,162]],"Neither shall king or tyrant be able to set his face against thee for any whom thou hast punished."],["15",[["δίκαιος",703694,14],["δὲ",703303,11],["ὢν",704093,72],["δικαίως",703698,28],["τὰ",709436,41],["πάντα",710177,68],["διέπεις",703669,154],["αὐτὸν",702165,85],["τὸν",709436,5],["μὴ",708851,28],["ὀφείλοντα",709865,183],["κολασθῆναι",707786,179],["καταδικάσαι",707241,106],["ἀλλότριον",700699,27],["ἡγούμενος",705931,122],["τῆς",709436,16],["σῆς",711943,82],["δυνάμεως",703839,17]],"Forsomuch then as thou art righteous thyself, thou orderest all things righteously: thinking it not agreeable with thy power to condemn him that hath not deserved to be punished."],["16",[["ἡ",709436,10],["γὰρ",702963,11],["ἰσχύς",706858,12],["σου",711945,133],["δικαιοσύνης",703695,17],["ἀρχή",701836,12],["καὶ",707031,7],["τὸ",709436,24],["πάντων",710177,83],["σε",711598,163],["δεσπόζειν",703376,55],["πάντων",710177,83],["φείδεσθαί",713406,110],["σε",711598,163],["ποιεῖ",710582,91]],"For thy power is the beginning of righteousness, and because thou art the Lord of all, it maketh thee to be gracious unto all."],["17",[["ἰσχὺν",706858,9],["γὰρ",702963,11],["ἐνδείκνυσαι",704673,259],["ἀπιστούμενος",701411,122],["ἐπὶ",705080,0],["δυνάμεως",703839,17],["τελειότητι",712770,1],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["εἰδόσι",709492,536],["τὸ",709436,24],["θράσος",706297,25],["ἐξελέγχεις",704897,154]],"For when men will not believe that thou art of a full power, thou shewest thy strength, and among them that know it thou makest their boldness manifest."],["18",[["σὺ",712181,164],["δὲ",703303,11],["δεσπόζων",703376,72],["ἰσχύος",706858,17],["ἐν",704639,0],["ἐπιεικείᾳ",705127,1],["κρίνεις",707905,154],["καὶ",707031,7],["μετὰ",708780,0],["πολλῆς",710646,82],["φειδοῦς",713407,17],["διοικεῖς",703717,154],["ἡμᾶς",705981,194],["πάρεστιν",710126,91],["γάρ",702963,11],["σοι",711925,159],["ὅταν",709801,28],["θέλῃς",706176,205],["τὸ",709436,24],["δύνασθαι",703838,110]],"But thou, mastering thy power, judgest with equity, and orderest us with great favour: for thou mayest use power when thou wilt."],["19",[["ἐδίδαξας",703649,162],["δέ",703303,11],["σου",711945,133],["τὸν",709436,5],["λαὸν",708094,6],["διὰ",703417,0],["τῶν",709436,43],["τοιούτων",712878,83],["ἔργων",705396,44],["ὅτι",709803,7],["δεῖ",703312,91],["τὸν",709436,5],["δίκαιον",703694,27],["εἶναι",704093,55],["φιλάνθρωπον",713463,27],["καὶ",707031,7],["εὐέλπιδας",705572,60],["ἐποίησας",710582,162],["τοὺς",709436,58],["υἱούς",713075,57],["σου",711945,133],["ὅτι",709803,7],["διδοῖς",703654,154],["ἐπὶ",705080,0],["ἁμαρτήμασιν",700774,96],["μετάνοιαν",708810,9]],"But by such works hast thou taught thy people that the just man should be merciful, and hast made thy children to be of a good hope that thou givest repentance for sins."],["20",[["εἰ",704071,7],["γὰρ",702963,11],["ἐχθροὺς",705779,60],["παίδων",709932,81],["σου",711945,133],["καὶ",707031,7],["ὀφειλομένους",709865,236],["θανάτῳ",706096,114],["μετὰ",708780,0],["τοσαύτης",712907,82],["ἐτιμωρήσω",712861,174],["προσοχῆς",710944,17],["καὶ",707031,7],["διέσεως",703674,17],["δοὺς",703654,182],["χρόνους",713969,57],["καὶ",707031,7],["τόπον",712903,6],["δι᾿",703417,0],["ὧν",709781,252],["ἀπαλλαγῶσι",701333,477],["τῆς",709436,16],["κακίας",707054,17]],"For if thou didst punish the enemies of thy children, and the condemned to death, with such deliberation, giving them time and place whereby they might be delivered from their malice:"],["21",[["μετὰ",708780,0],["πόσης",710692,82],["ἀκριβείας",700596,17],["ἔκρινας",707905,162],["τοὺς",709436,58],["υἱούς",713075,57],["σου",711945,133],["ὧν",709781,252],["τοῖς",709436,147],["πατράσιν",710189,148],["ὅρκους",709753,57],["καὶ",707031,7],["συνθήκας",712477,39],["ἔδωκας",703654,162],["ἀγαθῶν",700106,83],["ὑποσχέσεων",713249,65]],"with how great circumspection didst thou judge thine own sons, unto whose fathers thou hast sworn, and made covenants of good promises?"],["22",[["ἡμᾶς",705981,194],["οὖν",709835,11],["παιδεύων",709926,72],["τοὺς",709436,58],["ἐχθροὺς",705779,60],["ἡμῶν",705999,145],["ἐν",704639,0],["μυριότητι",709066,1],["μαστιγοῖς",708566,154],["ἵνα",706747,7],["σου",711945,133],["τὴν",709436,8],["ἀγαθότητα",700107,9],["μεριμνῶμεν",708746,233],["κρίνοντες",707905,146],["κρινόμενοι",707905,348],["δὲ",703303,11],["προσδοκῶμεν",710876,233],["ἔλεος",704426,4]],"Therefore, whereas thou dost chasten us, thou scourgest our enemies a thousand times more, to the intent that, when we judge, we should carefully think of thy goodness, and when we ourselves are judged, we should look for mercy."],["23",[["ὅθεν",709486,28],["καὶ",707031,7],["τοὺς",709436,58],["ἐν",704639,0],["ἀφροσύνῃ",702235,1],["ζωῆς",705910,17],["βιώσαντας",702727,454],["ἀδίκως",700273,28],["διὰ",703417,0],["τῶν",709436,43],["ἰδίων",706493,83],["ἐβασάνισας",702566,162],["βδελυγμάτων",702604,44]],"Wherefore, whereas men have lived dissolutely and unrighteously, thou hast tormented them with their own abominations."],["24",[["καὶ",707031,7],["γὰρ",702963,11],["τῶν",709436,130],["πλάνης",710496,17],["ὁδῶν",709458,65],["μακρότερον",708421,489],["ἐπλανήθησαν",710495,99],["θεοὺς",706192,57],["ὑπολαμβάνοντες",713210,146],["τὰ",709436,41],["καὶ",707031,7],["ἐν",704639,0],["ζῴοις",705916,96],["τῶν",709436,80],["αἰσχρῶν",700481,169],["ἄτιμα",702095,68],["νηπίων",709295,169],["δίκην",703702,9],["ἀφρόνων",702236,169],["ψευσθέντες",714045,247]],"For they went astray very far in the ways of error, and held them for gods, which even among the beasts of their enemies were despised, being deceived, as children of no understanding."],["25",[["διὰ",703417,0],["τοῦτο",709858,129],["ὡς",714148,7],["παισὶν",709932,148],["ἀλογίστοις",700719,230],["τὴν",709436,8],["κρίσιν",707908,9],["εἰς",704105,0],["ἐμπαιγμὸν",704582,6],["ἔπεμψας",710246,162]],"Therefore unto them, as to children without the use of reason, thou didst send a judgment to mock them."],["26",[["οἱ",709436,136],["δὲ",703303,11],["παιγνίοις",709922,96],["ἐπιτιμήσεως",705306,17],["μὴ",708851,28],["νουθετηθέντες",709367,247],["ἀξίαν",701308,36],["θεοῦ",706192,18],["κρίσιν",707908,9],["πειράσουσιν",710225,218]],"But they that would not be reformed by that correction, wherein he dallied with them, shall feel a judgment worthy of God."],["27",[["ἐφ᾿",705080,0],["οἷς",709781,311],["γὰρ",702963,11],["αὐτοὶ",702165,201],["πάσχοντες",710183,146],["ἠγανάκτουν",700119,137],["ἐπὶ",705080,0],["τούτοις",709858,151],["οὓς",709781,298],["ἐδόκουν",703775,137],["θεούς",706192,57],["ἐν",704639,0],["αὐτοῖς",702165,151],["κολαζόμενοι",707786,348],["ἰδόντες",709725,196],["ὃν",709781,112],["πάλαι",709935,28],["ἠρνοῦντο",701781,139],["εἰδέναι",709492,115],["θεὸν",706192,6],["ἐπέγνωσαν",705104,150],["ἀληθῆ",700658,27],["διὸ",703714,7],["καὶ",707031,28],["τὸ",709436,34],["τέρμα",712801,15],["τῆς",709436,16],["καταδίκης",707242,17],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["ἐπῆλθεν",705068,2]],"For, look, for what things they grudged, when they were punished, that is, for them whom they thought to be gods; [now] being punished in them, when they saw it, they acknowledged him to be the true God, whom before they denied to know; and therefore came extreme damnation upon them."]]