[["1",[["πλοῦν",710526,72],["τις",712866,158],["πάλιν",709942,28],["στελλόμενος",712063,122],["καὶ",707031,7],["ἄγρια",700191,68],["μέλλων",708705,72],["διοδεύειν",703715,55],["κύματα",707968,42],["τοῦ",709436,20],["φέροντος",713428,294],["αὐτὸν",702165,85],["πλοίου",710556,21],["σαθρότερον",711381,489],["ξύλον",709427,25],["ἐπιβοᾶται",705090,117]],"Again, one preparing himself to sail, and about to pass through the raging waves, calleth upon a piece of wood more rotten than the vessel that carrieth him."],["2",[["ἐκεῖνο",704183,129],["μὲν",708730,11],["γὰρ",702963,11],["ὄρεξις",709734,12],["πορισμῶν",710671,81],["ἐπενόησεν",705214,2],["τεχνῖτις",712833,12],["δὲ",703303,11],["σοφία",711981,12],["κατεσκεύασεν",707419,2]],"For verily desire of gain devised that, and the workman built it by his skill."],["3",[["ἡ",709436,10],["δὲ",703303,11],["σή",711943,29],["πάτερ",710189,153],["διακυβερνᾷ",703490,91],["πρόνοια",710825,12],["ὅτι",709803,7],["ἔδωκας",703654,162],["καὶ",707031,7],["ἐν",704639,0],["θαλάσσῃ",706069,1],["ὁδὸν",709458,9],["καὶ",707031,7],["ἐν",704639,0],["κύμασι",707968,96],["τρίβον",712939,6],["ἀσφαλῆ",702040,27]],"But thy providence, O Father, governeth it: for thou hast made a way in the sea, and a safe path in the waves;"],["4",[["δεικνὺς",703314,154],["ὅτι",709803,7],["δύνασαι",703838,259],["ἐκ",704132,0],["παντὸς",710177,92],["σῴζειν",712627,55],["ἵνα",706747,7],["κἂν",707120,459],["ἄνευ",701137,0],["τέχνης",712831,17],["τις",712866,158],["ἐπιβῇ",705082,172]],"shewing that thou canst save from all danger: yea, though a man went to sea without art."],["5",[["θέλεις",706176,154],["δὲ",703303,11],["μὴ",708851,28],["ἀργὰ",701704,68],["εἶναι",704093,55],["τὰ",709436,41],["τῆς",709436,16],["σοφίας",711981,17],["σου",711945,133],["ἔργα",705396,42],["διὰ",703417,0],["τοῦτο",709858,129],["καὶ",707031,7],["ἐλαχίστῳ",704400,633],["ξύλῳ",709427,54],["πιστεύουσιν",710483,197],["ἄνθρωποι",701163,52],["ψυχὰς",714070,39],["καὶ",707031,7],["διελθόντες",703673,196],["κλύδωνα",707744,6],["σχεδίᾳ",712597,1],["διεσώθησαν",703599,99]],"Nevertheless thou wouldest not that the works of thy wisdom should be idle, and therefore do men commit their lives to a small piece of wood, and passing the rough sea in a weak vessel are saved."],["6",[["καὶ",707031,7],["ἀρχῆς",701836,17],["γὰρ",702963,11],["ἀπολλυμένων",701513,299],["ὑπερηφάνων",713139,169],["γιγάντων",703101,81],["ἡ",709436,10],["ἐλπὶς",704530,12],["τοῦ",709436,35],["κόσμου",707851,18],["ἐπὶ",705080,0],["σχεδίας",712597,17],["καταφυγοῦσα",707472,149],["ἀπέλιπεν",701508,2],["αἰῶνι",700504,114],["σπέρμα",712008,25],["γενέσεως",703043,17],["τῇ",709436,100],["σῇ",711943,101],["κυβερνηθεῖσα",707946,307],["χειρί",713787,1]],"For in the old time also, when the proud giants perished, the hope of the world governed by thy hand escaped in a weak vessel, and left to all ages a seed of generation."],["7",[["εὐλόγηται",705631,187],["γὰρ",702963,11],["ξύλον",709427,15],["δι᾿",703417,0],["οὗ",709781,160],["γίνεται",703104,117],["δικαιοσύνη",703695,12]],"For blessed is the wood whereby righteousness cometh."],["8",[["τὸ",709436,34],["χειροποίητον",713796,26],["δέ",703303,11],["ἐπικατάρατον",705159,26],["αὐτὸ",702165,132],["καὶ",707031,7],["ὁ",709436,3],["ποιήσας",710582,182],["αὐτό",702165,129],["ὅτι",709803,7],["ὁ",709436,3],["μὲν",708730,11],["ἠργάζετο",705383,19],["τὸ",709436,24],["δὲ",703303,11],["φθαρτὸν",713441,46],["θεὸς",706192,4],["ὠνομάσθη",709667,37]],"But that which is made with hands is cursed, as well it, as he that made it: he, because he made it: and it, because, being corruptible, it was called God."],["9",[["ἐν",704639,0],["ἴσῳ",706832,30],["γὰρ",702963,11],["μισητὰ",708936,68],["θεῷ",706192,114],["καὶ",707031,7],["ὁ",709436,3],["ἀσεβῶν",701906,72],["καὶ",707031,7],["ἡ",709436,10],["ἀσέβεια",701904,12],["αὐτοῦ",702165,102]],"For the ungodly and his ungodliness are both alike hateful unto God."],["10",[["καὶ",707031,7],["γὰρ",702963,11],["τὸ",709436,34],["πραχθὲν",710721,418],["σὺν",712372,0],["τῷ",709436,113],["δράσαντι",703828,350],["κολασθήσεται",707786,134]],"For that which is made shall be punished together with him that made it."],["11",[["διὰ",703417,0],["τοῦτο",709858,129],["καὶ",707031,7],["ἐν",704639,0],["εἰδώλοις",704079,96],["ἐθνῶν",704068,44],["ἐπισκοπὴ",705255,12],["ἔσται",704093,93],["ὅτι",709803,7],["ἐν",704639,0],["κτίσματι",707940,54],["θεοῦ",706192,18],["εἰς",704105,0],["βδέλυγμα",702604,25],["ἐγενήθησαν",703104,99],["καὶ",707031,7],["εἰς",704105,0],["σκάνδαλα",711825,42],["ψυχαῖς",714070,76],["ἀνθρώπων",701163,81],["καὶ",707031,7],["εἰς",704105,0],["παγίδα",709910,9],["ποσὶν",710707,148],["ἀφρόνων",702236,169]],"Therefore even upon the idols of the Gentiles shall there be a visitation: because in the creature of God they are become an abomination, and stumblingblocks to the souls of men, and a snare to the feet of the unwise."],["12",[["ἀρχὴ",701836,12],["γὰρ",702963,11],["πορνείας",710672,17],["ἐπίνοια",705215,12],["εἰδώλων",704079,44],["εὕρεσις",705672,12],["δὲ",703303,11],["αὐτῶν",702165,70],["φθορὰ",713451,12],["ζωῆς",705910,17]],"For the devising of idols was the beginning of [spiritual] fornication, and the invention of them the corruption of life."],["13",[["οὔτε",709857,7],["γὰρ",702963,11],["ἦν",704093,13],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["οὔτε",709857,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἔσται",704093,93]],"For neither were they from the beginning, neither shall they be for ever."],["14",[["κενοδοξίᾳ",707610,1],["γὰρ",702963,11],["ἀνθρώπων",701163,81],["εἰσῆλθεν",704114,2],["εἰς",704105,0],["τὸν",709436,5],["κόσμον",707851,6],["καὶ",707031,7],["διὰ",703417,0],["τοῦτο",709858,129],["σύντομον",712515,46],["αὐτῶν",702165,70],["τὸ",709436,24],["τέλος",712787,25],["ἐπενοήθη",705214,37]],"For by the vain glory of men they entered into the world, and therefore shall they come shortly to an end."],["15",[["ἀώρῳ",702329,97],["γὰρ",702963,11],["πένθει",710253,54],["τρυχόμενος",713011,122],["πατὴρ",710189,4],["τοῦ",709436,20],["ταχέως",712743,28],["ἀφαιρεθέντος",702177,401],["τέκνου",712761,21],["εἰκόνα",704089,17],["ποιήσας",710582,182],["τόν",709436,5],["ποτε",710695,28],["νεκρὸν",709247,27],["ἄνθρωπον",701163,6],["νῦν",709384,28],["ὡς",714148,7],["θεὸν",706192,6],["ἐτίμησεν",712855,2],["καὶ",707031,7],["παρέδωκεν",710014,2],["τοῖς",709436,147],["ὑποχειρίοις",713258,230],["μυστήρια",709080,42],["καὶ",707031,7],["τελετάς",712779,39]],"For a father afflicted with untimely mourning, when he hath made an image of his child soon taken away, now honoured him as a god, which was then a dead man, and delivered to those that were under him ceremonies and sacrifices."],["16",[["εἶτα",704129,28],["ἐν",704639,0],["χρόνῳ",713969,114],["κρατυνθὲν",707884,418],["τὸ",709436,34],["ἀσεβὲς",701909,26],["ἔθος",704069,15],["ὡς",714148,7],["νόμος",709349,4],["ἐφυλάχθη",713619,37]],"Thus in process of time an ungodly custom grown strong was kept as a law, and graven images were worshipped by the commandments of kings."],["17",[["καὶ",707031,7],["τυράννων",713026,81],["ἐπιταγαῖς",705290,76],["ἐθρησκεύετο",706311,19],["τὰ",709436,41],["γλυπτά",703117,68],["οὓς",709781,298],["ἐν",704639,0],["ὄψει",709901,1],["μὴ",708851,28],["δυνάμενοι",703838,348],["τιμᾶν",712855,55],["ἄνθρωποι",701163,52],["διὰ",703417,0],["τὸ",709436,24],["μακρὰν",708411,28],["οἰκεῖν",709499,55],["τὴν",709436,8],["πόρρωθεν",710681,28],["ὄψιν",709901,9],["ἀνατυπωσάμενοι",701078,317],["ἐμφανῆ",704627,36],["εἰκόνα",704089,9],["τοῦ",709436,35],["τιμωμένου",712855,262],["βασιλέως",702580,18],["ἐποίησαν",710582,150],["ἵνα",706747,7],["ὡς",714148,7],["παρόντα",710126,183],["τὸν",709436,5],["ἀπόντα",701376,183],["κολακεύωσιν",707787,271],["διὰ",703417,0],["τῆς",709436,16],["σπουδῆς",712035,17]],"Whom men could not honour in presence, because they dwelt far off, they took the counterfeit of his visage from far, and made an express image of a king whom they honoured, to the end that by this their forwardness they might flatter him that was absent, as if he were present."],["18",[["εἰς",704105,0],["ἐπίτασιν",705293,9],["δὲ",703303,11],["θρησκείας",706310,17],["καὶ",707031,7],["τοὺς",709436,58],["ἀγνοοῦντας",700175,235],["ἡ",709436,10],["τοῦ",709436,35],["τεχνίτου",712832,18],["προετρέψατο",710996,23],["φιλοτιμία",713501,12]],"Also the singular diligence of the artificer did help to set forward the ignorant to more superstition."],["19",[["ὁ",709436,3],["μὲν",708730,11],["γὰρ",702963,11],["τάχα",712742,28],["κρατοῦντι",707879,379],["βουλόμενος",702795,122],["ἀρέσαι",701722,106],["ἐξεβιάσατο",704149,23],["τῇ",709436,100],["τέχνῃ",712831,1],["τὴν",709436,8],["ὁμοιότητα",709627,9],["ἐπὶ",705080,0],["τὸ",709436,24],["κάλλιον",707088,46]],"For he, peradventure willing to please one in authority, forced all his skill to make the resemblance of the best fashion."],["20",[["τὸ",709436,34],["δὲ",703303,11],["πλῆθος",710529,15],["ἐφελκόμενον",705745,214],["διὰ",703417,0],["τὸ",709436,24],["εὔχαρι",705720,46],["τῆς",709436,16],["ἐργασίας",705385,17],["τὸν",709436,5],["πρὸ",710747,0],["ὀλίγου",709568,92],["τιμηθέντα",712855,260],["ἄνθρωπον",701163,6],["νῦν",709384,28],["σέβασμα",711603,25],["ἐλογίσαντο",708232,189]],"And so the multitude, allured by the grace of the work, took him now for a god, which a little before was but honoured as a man."],["21",[["καὶ",707031,7],["τοῦτο",709858,132],["ἐγένετο",703104,23],["τῷ",709436,113],["βίῳ",702724,114],["εἰς",704105,0],["ἔνεδρον",704704,25],["ὅτι",709803,7],["ἢ",705924,7],["συμφορᾷ",712357,1],["ἢ",705924,7],["τυραννίδι",713025,1],["δουλεύσαντες",703814,196],["ἄνθρωποι",701163,52],["τὸ",709436,24],["ἀκοινώνητον",700563,46],["ὄνομα",709666,25],["λίθοις",708196,148],["καὶ",707031,7],["ξύλοις",709427,96],["περιέθεσαν",710403,2]],"And this was an occasion to deceive the world: for men, serving either calamity or tyranny, did ascribe unto stones and stocks the incommunicable name."],["22",[["εἶτ᾿",704129,28],["οὐκ",709805,28],["ἤρκεσεν",701765,2],["τὸ",709436,24],["πλανᾶσθαι",710495,110],["περὶ",710285,0],["τὴν",709436,8],["τοῦ",709436,35],["θεοῦ",706192,18],["γνῶσιν",703138,9],["ἀλλὰ",700680,7],["καὶ",707031,28],["ἐν",704639,0],["μεγάλῳ",708653,30],["ζῶντες",705851,146],["ἀγνοίας",700177,17],["πολέμῳ",710605,114],["τὰ",709436,41],["τοσαῦτα",712907,68],["κακὰ",707066,68],["εἰρήνην",704098,9],["προσαγορεύουσιν",710847,197]],"Moreover this was not enough for them, that they erred in the knowledge of God; but whereas they lived in the great war of ignorance, those so great plagues called they peace."],["23",[["ἢ",705924,7],["γὰρ",702963,11],["τεκνοφόνους",712763,119],["τελετὰς",712779,39],["ἢ",705924,7],["κρύφια",707930,68],["μυστήρια",709080,42],["ἢ",705924,7],["ἐμμανεῖς",704567,60],["ἐξάλλων",704857,169],["θεσμῶν",706224,81],["κώμους",708023,57],["ἄγοντες",700209,146]],"For whilst they slew their children in sacrifices, or used secret ceremonies, or made revellings of strange rites;"],["24",[["οὔτε",709857,7],["βίους",702724,57],["οὔτε",709857,7],["γάμους",702957,57],["καθαροὺς",706988,60],["ἔτι",705538,28],["φυλάσσουσιν",713619,197],["ἕτερος",705535,14],["δ᾿",703303,11],["ἕτερον",705535,27],["ἢ",705924,7],["λοχῶν",708261,81],["ἀναιρεῖ",700962,91],["ἢ",705924,7],["νοθεύων",709331,72],["ὀδυνᾷ",709462,91]],"they kept neither lives nor marriages any longer undefiled: but either one slew another traiterously or grieved him by adultery."],["25",[["πάντα",710177,195],["δ᾿",703303,11],["ἐπιμὶξ",705206,28],["ἔχει",705785,91],["αἷμα",700442,15],["καὶ",707031,7],["φόνος",713549,4],["κλοπὴ",707742,12],["καὶ",707031,7],["δόλος",703787,4],["φθορά",713451,12],["ἀπιστία",701412,12],["τάραχος",712723,4],["ἐπιορκία",705219,12]],"So that there reigned in all men without exception, blood, manslaughter, theft, and dissimulation, corruption, unfaithfulness, tumults, perjury,"],["26",[["θόρυβος",706293,4],["ἀγαθῶν",700106,83],["χάριτος",713735,17],["ἀμνηστία",700854,12],["ψυχῶν",714070,65],["μιασμός",708910,4],["γενέσεως",703043,17],["ἐναλλαγή",704650,12],["γάμων",702957,81],["ἀταξία",702069,12],["μοιχεία",708978,12],["καὶ",707031,7],["ἀσέλγεια",701914,12]],"disquieting of good men, forgetfulness of good turns, defiling of souls, changing of kind, disorder in marriages, adultery, and shameless uncleanness."],["27",[["ἡ",709436,10],["γὰρ",702963,11],["τῶν",709436,43],["ἀνωνύμων",701300,83],["εἰδώλων",704079,44],["θρησκεία",706310,12],["παντὸς",710177,92],["ἀρχὴ",701836,12],["κακοῦ",707066,92],["καὶ",707031,7],["αἰτία",700492,12],["καὶ",707031,7],["πέρας",710281,15],["ἐστίν",704093,91]],"For the worshipping of idols not to be named is the beginning, the cause, and the end, of all evil."],["28",[["ἢ",705924,7],["γὰρ",702963,11],["εὐφραινόμενοι",705715,348],["μεμήνασιν",708389,353],["ἢ",705924,7],["προφητεύουσιν",711008,197],["ψευδῆ",714036,68],["ἢ",705924,7],["ζῶσιν",705851,197],["ἀδίκως",700273,28],["ἢ",705924,7],["ἐπιορκοῦσιν",705218,197],["ταχέως",712743,28]],"For either they are mad when they be merry, or prophesy lies, or live unjustly, or else lightly forswear themselves."],["29",[["ἀψύχοις",702322,94],["γὰρ",702963,11],["πεποιθότες",710221,268],["εἰδώλοις",704079,96],["κακῶς",707074,28],["ὀμόσαντες",709620,196],["ἀδικηθῆναι",700269,179],["οὐ",709805,28],["προσδέχονται",710874,269]],"For insomuch as their trust is in idols which have no life, though they swear falsely, yet they look not to be hurt."],["30",[["ἀμφότερα",700892,195],["δὲ",703303,11],["αὐτοὺς",702165,62],["μετελεύσεται",708827,93],["τὰ",709436,63],["δίκαια",703694,68],["ὅτι",709803,7],["κακῶς",707074,28],["ἐφρόνησαν",713586,150],["περὶ",710285,0],["θεοῦ",706192,18],["προσέχοντες",710895,146],["εἰδώλοις",704079,96],["καὶ",707031,7],["ἀδίκως",700273,28],["ὤμοσαν",709620,150],["ἐν",704639,0],["δόλῳ",703787,114],["καταφρονήσαντες",707482,196],["ὁσιότητος",709783,17]],"Howbeit for both causes shall they be justly punished: both because they thought not well of God, giving heed unto idols, and also unjustly swore in deceit, despising holiness."],["31",[["οὐ",709805,28],["γὰρ",702963,11],["ἡ",709436,10],["τῶν",709436,43],["ὀμνυμένων",709620,369],["δύναμις",703839,12],["ἀλλ᾿",700680,7],["ἡ",709436,10],["τῶν",709436,80],["ἁμαρτανόντων",700773,170],["δίκη",703702,12],["ἐπεξέρχεται",705066,117],["ἀεὶ",700311,28],["τὴν",709436,8],["τῶν",709436,80],["ἀδίκων",700272,169],["παράβασιν",709999,9]],"For it is not the power of them by whom they swear: but it is the just vengeance of sinners, that punisheth always the offence of the ungodly."]]