[["1",[["Ἀγαπήσατε",700120,74],["δικαιοσύνην",703695,9],["οἱ",709436,643],["κρίνοντες",707905,759],["τὴν",709436,8],["γῆν",703083,9],["φρονήσατε",713586,74],["περὶ",710285,0],["τοῦ",709436,35],["κυρίου",707996,18],["ἐν",704639,0],["ἀγαθότητι",700107,1],["καὶ",707031,7],["ἐν",704639,0],["ἁπλότητι",701420,1],["καρδίας",707141,17],["ζητήσατε",705879,74],["αὐτόν",702165,85]],"Love righteousness, ye that be judges of the earth: think of the Lord with a good (heart,) and in simplicity of heart seek him."],["2",[["ὅτι",709803,7],["εὑρίσκεται",705676,117],["τοῖς",709436,147],["μὴ",708851,28],["πειράζουσιν",710225,349],["αὐτόν",702165,85],["ἐμφανίζεται",704628,117],["δὲ",703303,11],["τοῖς",709436,147],["μὴ",708851,28],["ἀπιστοῦσιν",701411,349],["αὐτῷ",702165,50]],"For he will be found of them that tempt him not; and sheweth himself unto such as do not distrust him."],["3",[["σκολιοὶ",711868,138],["γὰρ",702963,11],["λογισμοὶ",708234,52],["χωρίζουσιν",714014,197],["ἀπὸ",701425,0],["θεοῦ",706192,18],["δοκιμαζομένη",703776,211],["τε",712751,11],["ἡ",709436,10],["δύναμις",703839,12],["ἐλέγχει",704416,91],["τοὺς",709436,58],["ἄφρονας",702236,60]],"For froward thoughts separate from God: and his power, when it is tried, reproveth the unwise."],["4",[["ὅτι",709803,7],["εἰς",704105,0],["κακότεχνον",707068,36],["ψυχὴν",714070,9],["οὐκ",709805,28],["εἰσελεύσεται",704114,93],["σοφία",711981,12],["οὐδὲ",709816,7],["κατοικήσει",707535,1],["ἐν",704639,0],["σώματι",712635,54],["κατάχρεῳ",707493,97],["ἁμαρτίας",700775,17]],"For into a malicious soul wisdom shall not enter: nor dwell in the body that is subject unto sin."],["5",[["ἅγιον",700159,26],["γὰρ",702963,11],["πνεῦμα",710566,15],["παιδείας",709924,17],["φεύξεται",713433,93],["δόλον",703787,6],["καὶ",707031,7],["ἀπαναστήσεται",701344,93],["ἀπὸ",701425,0],["λογισμῶν",708234,81],["ἀσυνέτων",702034,169],["καὶ",707031,7],["ἐλεγχθήσεται",704416,134],["ἐπελθούσης",705068,494],["ἀδικίας",700271,17]],"For the holy spirit of discipline will flee deceit, and remove from thoughts that are without understanding, and will not abide when unrighteousness cometh in."],["6",[["φιλάνθρωπον",713463,26],["γὰρ",702963,11],["πνεῦμα",710566,15],["σοφία",711981,12],["καὶ",707031,7],["οὐκ",709805,28],["ἀθῳώσει",700391,127],["βλάσφημον",702739,46],["ἀπὸ",701425,0],["χειλέων",713781,44],["αὐτοῦ",702165,102],["ὅτι",709803,7],["τῶν",709436,80],["νεφρῶν",709282,81],["αὐτοῦ",702165,102],["μάρτυς",708527,4],["ὁ",709436,3],["θεὸς",706192,4],["καὶ",707031,7],["τῆς",709436,16],["καρδίας",707141,17],["αὐτοῦ",702165,102],["ἐπίσκοπος",705256,4],["ἀληθὴς",700658,14],["καὶ",707031,7],["τῆς",709436,16],["γλώσσης",703120,17],["ἀκουστής",700584,82]],"For wisdom is a loving spirit; and will not acquit a blasphemer of his words: for God is witness of his reins, and a true beholder of his heart, and a hearer of his tongue."],["7",[["ὅτι",709803,7],["πνεῦμα",710566,15],["κυρίου",707996,18],["πεπλήρωκεν",710543,171],["τὴν",709436,8],["οἰκουμένην",709517,173],["καὶ",707031,7],["τὸ",709436,34],["συνέχον",712469,32],["τὰ",709436,41],["πάντα",710177,68],["γνῶσιν",703138,9],["ἔχει",705785,91],["φωνῆς",713640,17]],"For the Spirit of the Lord filleth the world: and that which containeth all things hath knowledge of the voice."],["8",[["διὰ",703417,0],["τοῦτο",709858,129],["φθεγγόμενος",713442,122],["ἄδικα",700272,68],["οὐδεὶς",709817,14],["μὴ",708851,28],["λάθῃ",708088,127],["οὐδὲ",709816,7],["μὴ",708851,28],["παροδεύσῃ",710153,127],["αὐτὸν",702165,85],["ἐλέγχουσα",704416,188],["ἡ",709436,10],["δίκη",703702,12]],"Therefore he that speaketh unrighteous things cannot be hidden: neither shall vengeance, when it punisheth, pass by him."],["9",[["ἐν",704639,0],["γὰρ",702963,11],["διαβουλίοις",703431,96],["ἀσεβοῦς",701909,116],["ἐξέτασις",704912,12],["ἔσται",704093,93],["λόγων",708236,81],["δὲ",703303,11],["αὐτοῦ",702165,102],["ἀκοὴ",700561,12],["πρὸς",710844,0],["κύριον",707996,6],["ἥξει",705956,127],["εἰς",704105,0],["ἔλεγχον",704415,6],["ἀνομημάτων",701191,44],["αὐτοῦ",702165,102]],"For inquisition shall be made into the counsels of the ungodly: and the sound of his words shall come unto the Lord for the manifestation of his wicked deeds."],["10",[["ὅτι",709803,7],["οὖς",709852,15],["ζηλώσεως",705874,17],["ἀκροᾶται",700602,117],["τὰ",709436,41],["πάντα",710177,27],["καὶ",707031,7],["θροῦς",706316,4],["γογγυσμῶν",703146,81],["οὐκ",709805,28],["ἀποκρύπτεται",701495,117]],"For the ear of jealousy heareth all things: and the noise of murmurings is not hid."],["11",[["φυλάξασθε",713619,186],["τοίνυν",712875,11],["γογγυσμὸν",703146,6],["ἀνωφελῆ",701303,27],["καὶ",707031,7],["ἀπὸ",701425,0],["καταλαλιᾶς",707299,17],["φείσασθε",713406,186],["γλώσσης",703120,17],["ὅτι",709803,7],["φθέγμα",713443,15],["λαθραῖον",708058,26],["κενὸν",707612,46],["οὐ",709805,28],["πορεύσεται",710667,93],["στόμα",712125,15],["δὲ",703303,11],["καταψευδόμενον",707500,208],["ἀναιρεῖ",700962,91],["ψυχήν",714070,9]],"Therefore beware of murmuring, which is unprofitable; and refrain your tongue from backbiting: for there is no word so secret, that shall go for nought: and the mouth that belieth slayeth the soul."],["12",[["μὴ",708851,28],["ζηλοῦτε",705873,335],["θάνατον",706096,6],["ἐν",704639,0],["πλάνῃ",710496,1],["ζωῆς",705910,17],["ὑμῶν",713091,145],["μηδὲ",708855,7],["ἐπισπᾶσθε",705258,73],["ὄλεθρον",709563,6],["ἐν",704639,0],["ἔργοις",705396,96],["χειρῶν",713787,65],["ὑμῶν",713091,145]],"Seek not death in the error of your life: and pull not upon yourselves destruction with the works of your hands."],["13",[["ὅτι",709803,7],["ὁ",709436,3],["θεὸς",706192,4],["θάνατον",706096,6],["οὐκ",709805,28],["ἐποίησεν",710582,2],["οὐδὲ",709816,7],["τέρπεται",712804,117],["ἐπ᾿",705080,0],["ἀπωλείᾳ",701660,1],["ζώντων",705851,84]],"For God made not death: neither hath he pleasure in the destruction of the living."],["14",[["ἔκτισεν",707938,2],["γὰρ",702963,11],["εἰς",704105,0],["τὸ",709436,24],["εἶναι",704093,55],["τὰ",709436,41],["πάντα",710177,68],["καὶ",707031,7],["σωτήριοι",712659,192],["αἱ",709436,190],["γενέσεις",703043,191],["τοῦ",709436,35],["κόσμου",707851,18],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐν",704639,0],["αὐταῖς",702165,200],["φάρμακον",713369,25],["ὀλέθρου",709563,18],["οὔτε",709857,7],["ᾅδου",700255,18],["βασίλειον",702578,25],["ἐπὶ",705080,0],["γῆς",703083,17]],"For he created all things, that they might have their being: and the generations of the world were healthful; and there is no poison of destruction in them, nor the kingdom of death upon the earth:"],["15",[["δικαιοσύνη",703695,12],["γὰρ",702963,11],["ἀθάνατός",700358,29],["ἐστιν",704093,91]],"(for righteousness is immortal:)"],["16",[["ἀσεβεῖς",701909,138],["δὲ",703303,11],["ταῖς",709436,75],["χερσὶν",713787,76],["καὶ",707031,7],["τοῖς",709436,147],["λόγοις",708236,148],["προσεκαλέσαντο",710912,189],["αὐτόν",702165,85],["φίλον",713492,27],["ἡγησάμενοι",705931,317],["αὐτὸν",702165,85],["ἐτάκησαν",712839,150],["καὶ",707031,7],["συνθήκην",712477,9],["ἔθεντο",712849,189],["πρὸς",710844,0],["αὐτόν",702165,85],["ὅτι",709803,7],["ἄξιοί",701308,138],["εἰσιν",704093,197],["τῆς",709436,16],["ἐκείνου",704183,86],["μερίδος",708748,17],["εἶναι",704093,55]],"but ungodly men with their works and words called it to them: for when they thought to have it their friend, they consumed to nought, and made a covenant with it, because they are worthy to take part with it."]]