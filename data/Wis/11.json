[["1",[["εὐόδωσεν",705654,2],["τὰ",709436,41],["ἔργα",705396,42],["αὐτῶν",702165,40],["ἐν",704639,0],["χειρὶ",713787,1],["προφήτου",711009,18],["ἁγίου",700159,116]],"She prospered their works in the hand of the holy prophet."],["2",[["διώδευσαν",703715,150],["ἔρημον",705420,9],["ἀοίκητον",701315,36],["καὶ",707031,7],["ἐν",704639,0],["ἀβάτοις",700023,94],["ἔπηξαν",710452,150],["σκηνάς",711845,39]],"They went through the wilderness that was not inhabited, and pitched tents in places where there lay no way."],["3",[["ἀντέστησαν",701154,150],["πολεμίοις",710603,230],["καὶ",707031,7],["ἐχθροὺς",705779,60],["ἠμύναντο",700880,189]],"They stood against their enemies, and were avenged of their adversaries."],["4",[["ἐδίψησαν",703763,150],["καὶ",707031,7],["ἐπεκαλέσαντό",705153,189],["σε",711598,163],["καὶ",707031,7],["ἐδόθη",703654,37],["αὐτοῖς",702165,151],["ἐκ",704132,0],["πέτρας",710443,17],["ἀκροτόμου",700611,82],["ὕδωρ",713071,15],["καὶ",707031,7],["ἴαμα",706405,25],["δίψης",703762,17],["ἐκ",704132,0],["λίθου",708196,18],["σκληροῦ",711861,116]],"When they were thirsty, they called upon thee, and water was given them out of the flinty rock, and their thirst was quenched out of the hard stone."],["5",[["δι᾿",703417,0],["ὧν",709781,103],["γὰρ",702963,11],["ἐκολάσθησαν",707786,99],["οἱ",709436,136],["ἐχθροὶ",705779,138],["αὐτῶν",702165,40],["διὰ",703417,0],["τούτων",709858,70],["αὐτοὶ",702165,201],["ἀποροῦντες",701559,146],["εὐεργετήθησαν",705575,99]],"For by what things their enemies were punished, by the same they in their need were benefited."],["6",[["ἀντὶ",701227,0],["μὲν",708730,11],["πηγῆς",710450,17],["ἀενάου",700313,116],["ποταμοῦ",710693,18],["αἵματι",700442,54],["λυθρώδει",708267,30],["ταραχθέντος",712721,319]],"For instead of a fountain of a perpetual running river troubled with foul blood,"],["7",[["εἰς",704105,0],["ἔλεγχον",704415,6],["νηπιοκτόνου",709294,116],["διατάγματος",703601,21],["ἔδωκας",703654,162],["αὐτοῖς",702165,151],["δαψιλὲς",703302,46],["ὕδωρ",713071,25],["ἀνελπίστως",701122,28]],"for a manifest reproof of that commandment, whereby the infants were slain, thou gavest unto them abundance of water by a means which they hoped not for:"],["8",[["δείξας",703314,182],["διὰ",703417,0],["τοῦ",709436,20],["τότε",712908,28],["δίψους",703764,21],["πῶς",711121,28],["τοὺς",709436,58],["ὑπεναντίους",713109,60],["ἐκόλασας",707786,162]],"declaring by that thirst then how thou hadst punished their adversaries."],["9",[["ὅτε",709802,28],["γὰρ",702963,11],["ἐπειράσθησαν",710225,99],["καίπερ",707045,7],["ἐν",704639,0],["ἐλέει",704426,54],["παιδευόμενοι",709926,348],["ἔγνωσαν",703105,150],["πῶς",711121,28],["μετ᾿",708780,0],["ὀργῆς",709728,17],["κρινόμενοι",707905,348],["ἀσεβεῖς",701909,60],["ἐβασανίζοντο",702566,139]],"For when they were tried, albeit but in mercy chastised, they knew how the ungodly were judged in wrath and tormented, thirsting in another manner than the just."],["10",[["τούτους",709858,62],["μὲν",708730,11],["γὰρ",702963,11],["ὡς",714148,7],["πατὴρ",710189,4],["νουθετῶν",709367,72],["ἐδοκίμασας",703776,162],["ἐκείνους",704183,62],["δὲ",703303,11],["ὡς",714148,7],["ἀπότομος",701620,14],["βασιλεὺς",702580,4],["καταδικάζων",707241,72],["ἐξήτασας",704911,162]],"For these thou didst admonish and try, as a father: but the others, as a severe king, thou didst condemn and punish."],["11",[["καὶ",707031,7],["ἀπόντες",701376,146],["δὲ",703303,11],["καὶ",707031,7],["παρόντες",710126,146],["ὁμοίως",709630,28],["ἐτρύχοντο",713011,139]],"Whether they were absent or present, they were vexed alike."],["12",[["διπλῆ",703740,29],["γὰρ",702963,11],["αὐτοὺς",702165,62],["ἔλαβεν",708076,2],["λύπη",708273,12],["καὶ",707031,7],["στεναγμὸς",712065,4],["μνημῶν",708964,65],["τῶν",709436,43],["παρελθόντων",710141,329]],"For a double grief came upon them, and a groaning for the remembrance of things past."],["13",[["ὅτε",709802,28],["γὰρ",702963,11],["ἤκουσαν",700587,2],["διὰ",703417,0],["τῶν",709436,130],["ἰδίων",706493,198],["κολάσεων",707789,65],["εὐεργετημένους",705575,360],["αὐτούς",702165,62],["ᾔσθοντο",700476,189],["τοῦ",709436,35],["κυρίου",707996,18]],"For when they heard by their own punishments the other to be benefited, they had some feeling of the Lord."],["14",[["ὃν",709781,112],["γὰρ",702963,11],["ἐν",704639,0],["ἐκθέσει",704195,1],["πάλαι",709935,28],["ῥιφέντα",711267,260],["ἀπεῖπον",701378,150],["χλευάζοντες",713873,146],["ἐπὶ",705080,0],["τέλει",712787,54],["τῶν",709436,130],["ἐκβάσεων",704146,65],["ἐθαύμασαν",706135,150],["οὐχ",709805,28],["ὅμοια",709626,195],["δικαίοις",703694,230],["διψήσαντες",703763,196]],"For whom they rejected with scorn, when he was long before thrown out at the casting forth [of the infants], him in the end, when they saw what came to pass, they admired."],["15",[["ἀντὶ",701227,0],["δὲ",703303,11],["λογισμῶν",708234,81],["ἀσυνέτων",702034,169],["ἀδικίας",700271,17],["αὐτῶν",702165,40],["ἐν",704639,0],["οἷς",709781,311],["πλανηθέντες",710495,247],["ἐθρήσκευον",706311,137],["ἄλογα",700721,68],["ἑρπετὰ",705441,42],["καὶ",707031,7],["κνώδαλα",707756,42],["εὐτελῆ",705705,68],["ἐπαπέστειλας",705036,162],["αὐτοῖς",702165,151],["πλῆθος",710529,25],["ἀλόγων",700721,83],["ζῴων",705916,44],["εἰς",704105,0],["ἐκδίκησιν",704175,9]],"But for the foolish devices of their wickedness, wherewith being deceived they worshipped serpents void of reason, and vile beasts, thou didst send a multitude of unreasonable beasts upon them for vengeance:"],["16",[["ἵνα",706747,7],["γνῶσιν",703105,234],["ὅτι",709803,7],["δι᾿",703417,0],["ὧν",709781,252],["τις",712866,158],["ἁμαρτάνει",700773,91],["διὰ",703417,0],["τούτων",709858,70],["κολάζεται",707786,117]],"that they might know, that wherewithal a man sinneth, by the same shall he be punished."],["17",[["οὐ",709805,28],["γὰρ",702963,11],["ἠπόρει",701559,13],["ἡ",709436,10],["παντοδύναμός",709983,29],["σου",711945,133],["χεὶρ",713787,12],["καὶ",707031,7],["κτίσασα",707938,149],["τὸν",709436,5],["κόσμον",707851,6],["ἐξ",704132,0],["ἀμόρφου",700867,82],["ὕλης",713077,17],["ἐπιπέμψαι",705223,106],["αὐτοῖς",702165,151],["πλῆθος",710529,25],["ἄρκων",701766,81],["ἢ",705924,7],["θρασεῖς",706300,60],["λέοντας",708171,57]],"For thy Almighty hand, that made the world of matter without form, wanted not means to send among them a multitude of bears, or fierce lions,"],["18",[["ἢ",705924,7],["νεοκτίστους",709255,60],["θυμοῦ",706334,18],["πλήρεις",710541,60],["θῆρας",706244,17],["ἀγνώστους",700181,60],["ἤτοι",706039,7],["πυρπνόον",711104,46],["φυσῶντας",713631,235],["ἄσθμα",701942,25],["ἢ",705924,7],["βρόμον",702814,46],["λικμωμένους",708202,236],["καπνοῦ",707132,18],["ἢ",705924,7],["δεινοὺς",703328,60],["ἀπ᾿",701425,0],["ὀμμάτων",709616,44],["σπινθῆρας",712015,57],["ἀστράπτοντας",702022,235]],"or unknown wild beasts, full of rage, newly created, breathing out either a fiery vapour, or filthy scents of scattered smoke, or shooting horrible sparkles out of their eyes:"],["19",[["ὧν",709781,103],["οὐ",709805,28],["μόνον",709001,28],["ἡ",709436,10],["βλάβη",702731,12],["ἠδύνατο",703838,19],["συνεκτρῖψαι",712442,106],["αὐτούς",702165,62],["ἀλλὰ",700680,7],["καὶ",707031,28],["ἡ",709436,10],["ὄψις",709901,12],["ἐκφοβήσασα",704360,149],["διολέσαι",703721,106]],"whereof not only the harm might dispatch them at once, but also the terrible sight utterly destroy them."],["20",[["καὶ",707031,7],["χωρὶς",714016,28],["δὲ",703303,11],["τούτων",709858,70],["ἑνὶ",704106,97],["πνεύματι",710566,54],["πεσεῖν",710481,106],["ἐδύναντο",703838,139],["ὑπὸ",713184,0],["τῆς",709436,16],["δίκης",703702,17],["διωχθέντες",703768,247],["καὶ",707031,7],["λικμηθέντες",708202,247],["ὑπὸ",713184,0],["πνεύματος",710566,21],["δυνάμεώς",703839,17],["σου",711945,133],["ἀλλὰ",700680,7],["πάντα",710177,68],["μέτρῳ",708846,54],["καὶ",707031,7],["ἀριθμῷ",701744,114],["καὶ",707031,7],["σταθμῷ",712040,114],["διέταξας",703603,162]],"Yea, and without these might they have fallen down with one blast, being persecuted of vengeance, and scattered abroad through the breath of thy power: but thou hast ordered all things in measure and number and weight."],["21",[["τὸ",709436,24],["γὰρ",702963,11],["μεγάλως",708650,28],["ἰσχύειν",706859,55],["σοι",711925,159],["πάρεστιν",710126,91],["πάντοτε",709987,28],["καὶ",707031,7],["κράτει",707883,54],["βραχίονός",702808,18],["σου",711945,133],["τίς",712867,158],["ἀντιστήσεται",701154,93]],"For thou canst shew thy great strength at all times when thou wilt; and who may withstand the power of thine arm?"],["22",[["ὅτι",709803,7],["ὡς",714148,7],["ῥοπὴ",711294,12],["ἐκ",704132,0],["πλαστίγγων",710504,17],["ὅλος",709597,14],["ὁ",709436,3],["κόσμος",707851,4],["ἐναντίον",704654,0],["σου",711945,133],["καὶ",707031,7],["ὡς",714148,7],["ῥανὶς",711176,12],["δρόσου",703835,17],["ὀρθρινὴ",709743,29],["κατελθοῦσα",707518,149],["ἐπὶ",705080,0],["γῆν",703083,9]],"For the whole world before thee is as a little grain of the balance, yea, as a drop of the morning dew that falleth down upon the earth."],["23",[["ἐλεεῖς",704418,154],["δὲ",703303,11],["πάντας",710177,60],["ὅτι",709803,7],["πάντα",710177,68],["δύνασαι",703838,259],["καὶ",707031,7],["παρορᾷς",710125,154],["ἁμαρτήματα",700774,42],["ἀνθρώπων",701163,81],["εἰς",704105,0],["μετάνοιαν",708810,9]],"But thou hast mercy upon all; for thou canst do all things, and winkest at the sins of men, because they should amend."],["24",[["ἀγαπᾷς",700120,154],["γὰρ",702963,11],["τὰ",709436,41],["ὄντα",704093,237],["πάντα",710177,68],["καὶ",707031,7],["οὐδὲν",709817,46],["βδελύσσῃ",702608,278],["ὧν",709781,103],["ἐποίησας",710582,162],["οὐδὲ",709816,7],["γὰρ",702963,11],["ἂν",700900,11],["μισῶν",708935,72],["τι",712866,126],["κατεσκεύασας",707419,162]],"For thou lovest all the things that are, and abhorrest nothing which thou hast made: for never wouldest thou have made any thing, if thou hadst hated it."],["25",[["πῶς",711121,28],["δὲ",703303,11],["διέμεινεν",703517,2],["ἄν",700900,11],["τι",712866,126],["εἰ",704071,7],["μὴ",708851,28],["σὺ",712181,164],["ἠθέλησας",706176,162],["ἢ",705924,7],["τὸ",709436,24],["μὴ",708851,28],["κληθὲν",707084,377],["ὑπὸ",713184,0],["σοῦ",711945,133],["διετηρήθη",703607,37]],"And how could any thing have endured, if it had not been thy will? or been preserved, if not called by thee?"],["26",[["φείδῃ",713406,259],["δὲ",703303,11],["πάντων",710177,83],["ὅτι",709803,7],["σά",711943,68],["ἐστιν",704093,91],["δέσποτα",703379,153],["φιλόψυχε",713506,564]],"But thou sparest all: for they are thine, O Lord, thou lover of souls."]]