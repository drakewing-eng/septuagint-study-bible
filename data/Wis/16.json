[["1",[["διὰ",703417,0],["τοῦτο",709858,129],["δι᾿",703417,0],["ὁμοίων",709626,83],["ἐκολάσθησαν",707786,99],["ἀξίως",701311,28],["καὶ",707031,7],["διὰ",703417,0],["πλήθους",710529,21],["κνωδάλων",707756,44],["ἐβασανίσθησαν",702566,99]],"Therefore by the like were they punished worthily, and by the multitude of beasts tormented."],["2",[["ἀνθ᾿",701227,0],["ἧς",709781,167],["κολάσεως",707789,17],["εὐεργετήσας",705575,182],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133],["εἰς",704105,0],["ἐπιθυμίαν",705147,9],["ὀρέξεως",709734,17],["ξένην",709415,36],["γεῦσιν",703073,9],["τροφὴν",712984,9],["ἡτοίμασας",705539,162],["ὀρτυγομήτραν",709773,9]],"Instead of which punishment, dealing graciously with thine own people, thou preparedst for them meat of a strange taste, even quails to stir up their appetite:"],["3",[["ἵνα",706747,7],["ἐκεῖνοι",704183,201],["μὲν",708730,11],["ἐπιθυμοῦντες",705141,146],["τροφὴν",712984,9],["διὰ",703417,0],["τὴν",709436,8],["εἰδέχθειαν",704072,9],["τῶν",709436,80],["ἐπαπεσταλμένων",705036,445],["καὶ",707031,7],["τὴν",709436,8],["ἀναγκαίαν",700924,36],["ὄρεξιν",709734,9],["ἀποστρέφωνται",701598,380],["αὐτοὶ",702165,201],["δὲ",703303,11],["ἐπ᾿",705080,0],["ὀλίγον",709568,46],["ἐνδεεῖς",704671,138],["γενόμενοι",703104,317],["καὶ",707031,7],["ξένης",709415,82],["μετάσχωσι",708828,234],["γεύσεως",703073,17]],"to the end that they, desiring food, might for the ugly sight of the beasts sent among them lothe even that, which they must needs desire; but these, suffering penury for a short space, might be made partakers of a strange taste."],["4",[["ἔδει",703312,13],["γὰρ",702963,11],["ἐκείνοις",704183,151],["μὲν",708730,11],["ἀπαραίτητον",701351,36],["ἔνδειαν",704672,9],["ἐπελθεῖν",705068,106],["τυραννοῦσιν",713023,349],["τούτοις",709858,151],["δὲ",703303,11],["μόνον",709001,28],["δειχθῆναι",703314,179],["πῶς",711121,28],["οἱ",709436,136],["ἐχθροὶ",705779,138],["αὐτῶν",702165,40],["ἐβασανίζοντο",702566,139]],"For it was requisite, that upon them exercising tyranny should come penury, which they could not avoid: but to these it should only be shewed how their enemies were tormented."],["5",[["καὶ",707031,7],["γὰρ",702963,11],["ὅτε",709802,28],["αὐτοῖς",702165,151],["δεινὸς",703328,14],["ἐπῆλθεν",705068,2],["θηρίων",706252,44],["θυμὸς",706334,4],["δήγμασίν",703397,96],["τε",712751,11],["σκολιῶν",711868,169],["διεφθείροντο",703624,139],["ὄφεων",709875,81],["οὐ",709805,28],["μέχρι",708849,0],["τέλους",712787,21],["ἔμεινεν",708736,2],["ἡ",709436,10],["ὀργή",709728,12],["σου",711945,133]],"For when the horrible fierceness of beasts came upon these, and they perished with the stings of crooked serpents, thy wrath endured not for ever:"],["6",[["εἰς",704105,0],["νουθεσίαν",709366,9],["δὲ",703303,11],["πρὸς",710844,0],["ὀλίγον",709568,46],["ἐταράχθησαν",712721,99],["σύμβολον",712289,25],["ἔχοντες",705785,146],["σωτηρίας",712658,17],["εἰς",704105,0],["ἀνάμνησιν",701004,9],["ἐντολῆς",704802,17],["νόμου",709349,18],["σου",711945,133]],"But they were troubled for a small season, that they might be admonished, having a sign of salvation, to put them in remembrance of the commandment of thy law."],["7",[["ὁ",709436,3],["γὰρ",702963,11],["ἐπιστραφεὶς",705278,217],["οὐ",709805,28],["διὰ",703417,0],["τὸ",709436,24],["θεωρούμενον",706226,214],["ἐσῴζετο",712627,19],["ἀλλὰ",700680,7],["διὰ",703417,0],["σὲ",711598,163],["τὸν",709436,5],["πάντων",710177,169],["σωτῆρα",712657,6]],"For he that turned himself toward it was not saved by the thing that he saw, but by thee, that art the Saviour of all."],["8",[["καὶ",707031,7],["ἐν",704639,0],["τούτῳ",709858,280],["δὲ",703303,11],["ἔπεισας",710221,162],["τοὺς",709436,58],["ἐχθροὺς",705779,60],["ἡμῶν",705999,145],["ὅτι",709803,7],["σὺ",712181,164],["εἶ",704093,154],["ὁ",709436,3],["ῥυόμενος",711309,122],["ἐκ",704132,0],["παντὸς",710177,92],["κακοῦ",707066,92]],"And in this thou madest thine enemies confess, that it is thou who deliverest from all evil:"],["9",[["οὓς",709781,298],["μὲν",708730,11],["γὰρ",702963,11],["ἀκρίδων",700599,65],["καὶ",707031,7],["μυιῶν",709050,65],["ἀπέκτεινεν",701498,2],["δήγματα",703397,42],["καὶ",707031,7],["οὐχ",709805,28],["εὑρέθη",705676,37],["ἴαμα",706405,15],["τῇ",709436,100],["ψυχῇ",714070,1],["αὐτῶν",702165,40],["ὅτι",709803,7],["ἄξιοι",701308,138],["ἦσαν",704093,137],["ὑπὸ",713184,0],["τοιούτων",712878,83],["κολασθῆναι",707786,179]],"for them the bitings of grasshoppers and flies killed, neither was there found any remedy for their life: for they were worthy to be punished by such."],["10",[["τοὺς",709436,58],["δὲ",703303,11],["υἱούς",713075,57],["σου",711945,133],["οὐδὲ",709816,7],["ἰοβόλων",706753,169],["δρακόντων",703822,81],["ἐνίκησαν",709309,150],["ὀδόντες",709461,52],["τὸ",709436,34],["ἔλεος",704426,15],["γάρ",702963,11],["σου",711945,133],["ἀντιπαρῆλθεν",701263,2],["καὶ",707031,7],["ἰάσατο",706424,23],["αὐτούς",702165,62]],"But thy sons not the very teeth of venomous dragons overcame: for thy mercy was by them, and healed them."],["11",[["εἰς",704105,0],["γὰρ",702963,11],["ὑπόμνησιν",713225,9],["τῶν",709436,43],["λογίων",708233,44],["σου",711945,133],["ἐνεκεντρίζοντο",703973,139],["καὶ",707031,7],["ὀξέως",709677,28],["διεσῴζοντο",703599,139],["ἵνα",706747,7],["μὴ",708851,28],["εἰς",704105,0],["βαθεῖαν",702381,36],["ἐμπεσόντες",704593,651],["λήθην",708174,9],["ἀπερίσπαστοι",701396,138],["γένωνται",703104,232],["τῆς",709436,16],["σῆς",711943,82],["εὐεργεσίας",705574,17]],"For they were pricked, that they should remember thy words; and were quickly saved, that not falling into deep forgetfulness, they might be continually mindful of thy goodness."],["12",[["καὶ",707031,7],["γὰρ",702963,11],["οὔτε",709857,7],["βοτάνη",702772,12],["οὔτε",709857,7],["μάλαγμα",708434,15],["ἐθεράπευσεν",706200,2],["αὐτούς",702165,62],["ἀλλὰ",700680,7],["ὁ",709436,3],["σός",711943,14],["κύριε",707996,153],["λόγος",708236,4],["ὁ",709436,3],["πάντας",710177,60],["ἰώμενος",706424,122]],"For it was neither herb, nor mollifying plaister, that restored them to health: but thy word, O Lord, which healeth all things."],["13",[["σὺ",712181,164],["γὰρ",702963,11],["ζωῆς",705910,17],["καὶ",707031,7],["θανάτου",706096,18],["ἐξουσίαν",704974,9],["ἔχεις",705785,154],["καὶ",707031,7],["κατάγεις",707232,154],["εἰς",704105,0],["πύλας",711082,39],["ᾅδου",700255,18],["καὶ",707031,7],["ἀνάγεις",700933,154]],"For thou hast power of life and death: thou leadest to the gates of hell, and bringest up again."],["14",[["ἄνθρωπος",701163,4],["δὲ",703303,11],["ἀποκτέννει",701498,91],["μὲν",708730,11],["τῇ",709436,100],["κακίᾳ",707054,1],["αὐτοῦ",702165,102],["ἐξελθὸν",704909,511],["δὲ",703303,11],["πνεῦμα",710566,25],["οὐκ",709805,28],["ἀναστρέφει",701060,91],["οὐδὲ",709816,7],["ἀναλύει",700995,91],["ψυχὴν",714070,9],["παραλημφθεῖσαν",710059,406]],"A man indeed killeth through his malice: and the spirit, when it is gone forth, returneth not; neither the soul received up cometh again."],["15",[["τὴν",709436,8],["δὲ",703303,11],["σὴν",711943,36],["χεῖρα",713787,9],["φυγεῖν",713433,106],["ἀδύνατόν",700297,26],["ἐστιν",704093,91]],"But it is not possible to escape thine hand."],["16",[["ἀρνούμενοι",701781,348],["γάρ",702963,11],["σε",711598,163],["εἰδέναι",709492,115],["ἀσεβεῖς",701909,138],["ἐν",704639,0],["ἰσχύι",706858,1],["βραχίονός",702808,18],["σου",711945,133],["ἐμαστιγώθησαν",708566,99],["ξένοις",709415,230],["ὑετοῖς",713074,148],["καὶ",707031,7],["χαλάζαις",713667,76],["καὶ",707031,7],["ὄμβροις",709611,148],["διωκόμενοι",703768,348],["ἀπαραιτήτοις",701351,230],["καὶ",707031,7],["πυρὶ",711088,54],["καταναλισκόμενοι",707338,645]],"For the ungodly, that denied to know thee, were scourged by the strength of thine arm: with strange rains, hails, and showers, were they persecuted, that they could not avoid, and through fire were they consumed."],["17",[["τὸ",709436,34],["γὰρ",702963,11],["παραδοξότατον",710016,654],["ἐν",704639,0],["τῷ",709436,53],["πάντα",710177,68],["σβεννύντι",711596,98],["ὕδατι",713071,54],["πλεῖον",710514,46],["ἐνήργει",704718,13],["τὸ",709436,34],["πῦρ",711088,15],["ὑπέρμαχος",713149,4],["γὰρ",702963,11],["ὁ",709436,3],["κόσμος",707851,4],["ἐστὶν",704093,91],["δικαίων",703694,169]],"For, which is most to be wondered at, the fire had more force in the water, that quencheth all things: for the world fighteth for the righteous."],["18",[["ποτὲ",710695,28],["μὲν",708730,11],["γὰρ",702963,11],["ἡμεροῦτο",705985,19],["φλόξ",713524,12],["ἵνα",706747,7],["μὴ",708851,28],["καταφλέξῃ",707477,172],["τὰ",709436,41],["ἐπ᾿",705080,0],["ἀσεβεῖς",701909,60],["ἀπεσταλμένα",701592,388],["ζῷα",705916,42],["ἀλλ᾿",700680,7],["αὐτοὶ",702165,201],["βλέποντες",702740,146],["εἰδῶσιν",709492,761],["ὅτι",709803,7],["θεοῦ",706192,18],["κρίσει",707908,1],["ἐλαύνονται",704397,269]],"For sometime the flame was mitigated, that it might not burn up the beasts that were sent against the ungodly; but themselves might see and perceive that they were persecuted with the judgment of God."],["19",[["ποτὲ",710695,28],["δὲ",703303,11],["καὶ",707031,7],["μεταξὺ",708811,28],["ὕδατος",713071,21],["ὑπὲρ",713111,0],["τὴν",709436,8],["πυρὸς",711088,21],["δύναμιν",703839,9],["φλέγει",713518,91],["ἵνα",706747,7],["ἀδίκου",700272,82],["γῆς",703083,17],["γενήματα",703052,42],["διαφθείρῃ",703624,204]],"And at another time it burneth even in the midst of water above the power of fire, that it might destroy the fruits of an unjust land."],["20",[["ἀνθ᾿",701227,0],["ὧν",709781,103],["ἀγγέλων",700140,81],["τροφὴν",712984,9],["ἐψώμισας",714077,162],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133],["καὶ",707031,7],["ἕτοιμον",705541,27],["ἄρτον",701829,6],["ἀπ᾿",701425,0],["οὐρανοῦ",709844,18],["παρέσχες",710142,162],["αὐτοῖς",702165,151],["ἀκοπιάτως",700573,28],["πᾶσαν",710177,36],["ἡδονὴν",705942,9],["ἰσχύοντα",706859,183],["καὶ",707031,7],["πρὸς",710844,0],["πᾶσαν",710177,36],["ἁρμόνιον",701777,36],["γεῦσιν",703073,9]],"Instead whereof thou feddest thine own people with angels' food, and didst send them from heaven bread prepared without their labour, able to content every man's delight, and agreeing to every taste."],["21",[["ἡ",709436,10],["μὲν",708730,11],["γὰρ",702963,11],["ὑπόστασίς",713241,12],["σου",711945,133],["τὴν",709436,8],["σὴν",711943,36],["πρὸς",710844,0],["τέκνα",712761,42],["ἐνεφάνιζεν",704628,13],["γλυκύτητα",703115,9],["τῇ",709436,100],["δὲ",703303,11],["τοῦ",709436,35],["προσφερομένου",710974,262],["ἐπιθυμίᾳ",705147,1],["ὑπηρετῶν",713178,72],["πρὸς",710844,0],["ὅ",709781,128],["τις",712866,158],["ἐβούλετο",702795,19],["μετεκιρνᾶτο",708798,19]],"For thy sustenance declared thy sweetness unto thy children, and serving to the appetite of the eater, tempered itself to every man's liking."],["22",[["χιὼν",713870,12],["δὲ",703303,11],["καὶ",707031,7],["κρύσταλλος",707926,4],["ὑπέμεινε",713219,2],["πῦρ",711088,25],["καὶ",707031,7],["οὐκ",709805,28],["ἐτήκετο",712839,19],["ἵνα",706747,7],["γνῶσιν",703105,234],["ὅτι",709803,7],["τοὺς",709436,58],["τῶν",709436,80],["ἐχθρῶν",705779,169],["καρποὺς",707169,57],["κατέφθειρε",707474,13],["πῦρ",711088,25],["φλεγόμενον",713518,212],["ἐν",704639,0],["τῇ",709436,100],["χαλάζῃ",713667,1],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["ὑετοῖς",713074,148],["διαστράπτον",703591,32]],"But snow and ice endured the fire, and melted not, that they might know that fire burning in the hail, and sparkling in the rain, did destroy the fruits of the enemies."],["23",[["τοῦτο",709858,132],["πάλιν",709942,28],["δ᾿",703303,11],["ἵνα",706747,7],["τραφῶσιν",712930,272],["δίκαιοι",703694,138],["καὶ",707031,7],["τῆς",709436,16],["ἰδίας",706493,82],["ἐπιλέλησται",705187,187],["δυνάμεως",703839,17]],"But this again did even forget his own strength, that the righteous might be nourished."],["24",[["ἡ",709436,10],["γὰρ",702963,11],["κτίσις",707939,12],["σοὶ",711925,159],["τῷ",709436,113],["ποιήσαντι",710582,350],["ὑπηρετοῦσα",713178,188],["ἐπιτείνεται",705296,117],["εἰς",704105,0],["κόλασιν",707789,9],["κατὰ",707200,0],["τῶν",709436,80],["ἀδίκων",700272,169],["καὶ",707031,7],["ἀνίεται",701169,117],["εἰς",704105,0],["εὐεργεσίαν",705574,9],["ὑπὲρ",713111,0],["τῶν",709436,80],["ἐπὶ",705080,0],["σοὶ",711925,159],["πεποιθότων",710221,387]],"For the creature that serveth thee, who art the Maker, increaseth his strength against the unrighteous for their punishment, and abateth his strength for the benefit of such as put their trust in thee."],["25",[["διὰ",703417,0],["τοῦτο",709858,129],["καὶ",707031,28],["τότε",712908,28],["εἰς",704105,0],["πάντα",710177,68],["μεταλλευομένη",708802,211],["τῇ",709436,100],["παντοτρόφῳ",709988,101],["σου",711945,133],["δωρεᾷ",703900,1],["ὑπηρέτει",713178,13],["πρὸς",710844,0],["τὴν",709436,8],["τῶν",709436,80],["δεομένων",703394,299],["θέλησιν",706172,9]],"Therefore even then was it altered into all fashions, and was obedient to thy grace, that nourisheth all things, according to the desire of them that had need:"],["26",[["ἵνα",706747,7],["μάθωσιν",708480,234],["οἱ",709436,136],["υἱοί",713075,52],["σου",711945,133],["οὓς",709781,298],["ἠγάπησας",700120,162],["κύριε",707996,153],["ὅτι",709803,7],["οὐχ",709805,28],["αἱ",709436,190],["γενέσεις",703043,191],["τῶν",709436,80],["καρπῶν",707169,81],["τρέφουσιν",712930,197],["ἄνθρωπον",701163,6],["ἀλλὰ",700680,7],["τὸ",709436,34],["ῥῆμά",711246,15],["σου",711945,133],["τοὺς",709436,58],["σοὶ",711925,159],["πιστεύοντας",710483,235],["διατηρεῖ",703607,91]],"that thy children, O Lord, whom thou lovest, might know, that it is not the growing of fruits that nourisheth man: but that it is thy word, which preserveth them that put their trust in thee."],["27",[["τὸ",709436,34],["γὰρ",702963,11],["ὑπὸ",713184,0],["πυρὸς",711088,21],["μὴ",708851,28],["φθειρόμενον",713445,208],["ἁπλῶς",701423,28],["ὑπὸ",713184,0],["βραχείας",702809,82],["ἀκτῖνος",700615,17],["ἡλίου",705974,18],["θερμαινόμενον",706213,208],["ἐτήκετο",712839,19]],"For that which was not destroyed of the fire, being warmed with a little sunbeam, soon melted away:"],["28",[["ὅπως",709719,7],["γνωστὸν",703141,26],["ᾖ",704093,204],["ὅτι",709803,7],["δεῖ",703312,91],["φθάνειν",713439,55],["τὸν",709436,5],["ἥλιον",705974,6],["ἐπ᾿",705080,0],["εὐχαριστίαν",705722,9],["σου",711945,133],["καὶ",707031,7],["πρὸς",710844,0],["ἀνατολὴν",701071,9],["φωτὸς",713642,21],["ἐντυγχάνειν",704812,55],["σοι",711925,159]],"that it might be known, that we must prevent the sun to give thee thanks, and at the dayspring pray unto thee."],["29",[["ἀχαρίστου",702252,116],["γὰρ",702963,11],["ἐλπὶς",704530,12],["ὡς",714148,7],["χειμέριος",713785,29],["πάχνη",710203,12],["τακήσεται",712839,93],["καὶ",707031,7],["ῥυήσεται",711309,93],["ὡς",714148,7],["ὕδωρ",713071,15],["ἄχρηστον",702312,26]],"For the hope of the unthankful shall melt away as the winter's hoar frost, and shall run away as unprofitable water."]]