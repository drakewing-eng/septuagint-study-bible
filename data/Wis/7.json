[["1",[["εἰμὶ",704093,157],["μὲν",708730,11],["κἀγὼ",706969,288],["θνητὸς",706279,14],["ἄνθρωπος",701163,4],["ἴσος",706832,14],["ἅπασιν",701362,230],["καὶ",707031,7],["γηγενοῦς",703085,116],["ἀπόγονος",701435,14],["πρωτοπλάστου",711040,116],["καὶ",707031,7],["ἐν",704639,0],["κοιλίᾳ",707761,1],["μητρὸς",708892,17],["ἐγλύφην",703118,9],["σὰρξ",711537,12]],"I myself also am a mortal man, like to all, and the offspring of him that was first made of the earth,",{"s":"d","q":0.65}],["2",[["δεκαμηνιαίῳ",703336,30],["χρόνῳ",713969,114],["παγεὶς",710452,217],["ἐν",704639,0],["αἵματι",700442,54],["ἐκ",704132,0],["σπέρματος",712008,21],["ἀνδρὸς",701150,18],["καὶ",707031,7],["ἡδονῆς",705942,17],["ὕπνῳ",713181,114],["συνελθούσης",712458,494]],"and in my mother's womb was fashioned to be flesh in the time of ten months, being compacted in blood, of the seed of man, and the pleasure that came with sleep.",{"s":"d","q":0.67}],["3",[["καὶ",707031,7],["ἐγὼ",704018,164],["δὲ",703303,11],["γενόμενος",703104,248],["ἔσπασα",712003,155],["τὸν",709436,5],["κοινὸν",707772,27],["ἀέρα",700354,6],["καὶ",707031,7],["ἐπὶ",705080,0],["τὴν",709436,8],["ὁμοιοπαθῆ",709625,36],["κατέπεσον",707375,150],["γῆν",703083,9],["πρώτην",711041,506],["φωνὴν",713640,9],["τὴν",709436,8],["ὁμοίαν",709626,36],["πᾶσιν",710177,230],["ἴσα",706832,68],["κλαίων",707703,72]],"And when I was born, I drew in the common air, and fell upon the earth, which is of like nature, and the first voice which I uttered was crying, as all others do."],["4",[["ἐν",704639,0],["σπαργάνοις",711995,148],["ἀνετράφην",701074,156],["καὶ",707031,7],["φροντίσιν",713591,76]],"I was nursed in swaddling clothes, and that with cares."],["5",[["οὐδεὶς",709817,14],["γὰρ",702963,11],["βασιλέων",702580,81],["ἑτέραν",705535,36],["ἔσχεν",705785,2],["γενέσεως",703043,17],["ἀρχήν",701836,9]],"For there is no king that had any other beginning of birth."],["6",[["μία",704106,29],["δὲ",703303,11],["πάντων",710177,169],["εἴσοδος",704119,12],["εἰς",704105,0],["τὸν",709436,5],["βίον",702724,6],["ἔξοδός",704948,12],["τε",712751,11],["ἴση",706832,29]],"For all men have one entrance into life, and the like going out."],["7",[["διὰ",703417,0],["τοῦτο",709858,129],["εὐξάμην",705727,161],["καὶ",707031,7],["φρόνησις",713588,12],["ἐδόθη",703654,37],["μοι",708974,159],["ἐπεκαλεσάμην",705153,161],["καὶ",707031,7],["ἦλθέν",705453,2],["μοι",708974,159],["πνεῦμα",710566,15],["σοφίας",711981,17]],"Wherefore I prayed, and understanding was given me: I called [upon God], and the spirit of wisdom came to me."],["8",[["προέκρινα",710815,155],["αὐτὴν",702165,104],["σκήπτρων",711851,44],["καὶ",707031,7],["θρόνων",706315,81],["καὶ",707031,7],["πλοῦτον",710563,6],["οὐδὲν",709817,46],["ἡγησάμην",705931,161],["ἐν",704639,0],["συγκρίσει",712234,1],["αὐτῆς",702165,86]],"I preferred her before sceptres and thrones, and esteemed riches nothing in comparison of her."],["9",[["οὐδὲ",709816,7],["ὡμοίωσα",709628,155],["αὐτῇ",702165,105],["λίθον",708196,6],["ἀτίμητον",702093,27],["ὅτι",709803,7],["ὁ",709436,3],["πᾶς",710177,14],["χρυσὸς",713975,14],["ἐν",704639,0],["ὄψει",709901,1],["αὐτῆς",702165,86],["ψάμμος",714029,12],["ὀλίγη",709568,29],["καὶ",707031,7],["ὡς",714148,7],["πηλὸς",710457,4],["λογισθήσεται",708232,134],["ἄργυρος",701711,4],["ἐναντίον",704654,28],["αὐτῆς",702165,86]],"Neither compared I unto her any precious stone, because all gold in respect of her is as a little sand, and silver shall be counted as clay before her."],["10",[["ὑπὲρ",713111,0],["ὑγίειαν",713058,9],["καὶ",707031,7],["εὐμορφίαν",705645,9],["ἠγάπησα",700120,155],["αὐτὴν",702165,104],["καὶ",707031,7],["προειλόμην",710752,161],["αὐτὴν",702165,104],["ἀντὶ",701227,0],["φωτὸς",713642,21],["ἔχειν",705785,55],["ὅτι",709803,7],["ἀκοίμητον",700562,26],["τὸ",709436,34],["ἐκ",704132,0],["ταύτης",709858,86],["φέγγος",713404,15]],"I loved her above health and beauty, and chose to have her instead of light: for the light that cometh from her never goeth out."],["11",[["ἦλθεν",705453,2],["δέ",703303,11],["μοι",708974,159],["τὰ",709436,63],["ἀγαθὰ",700106,195],["ὁμοῦ",709644,28],["πάντα",710177,195],["μετ᾿",708780,0],["αὐτῆς",702165,86],["καὶ",707031,7],["ἀναρίθμητος",701047,14],["πλοῦτος",710563,4],["ἐν",704639,0],["χερσὶν",713787,76],["αὐτῆς",702165,86]],"All good things together came to me with her, and innumerable riches in her hands."],["12",[["εὐφράνθην",705715,156],["δὲ",703303,11],["ἐπὶ",705080,0],["πᾶσιν",710177,94],["ὅτι",709803,7],["αὐτῶν",702165,70],["ἡγεῖται",705931,117],["σοφία",711981,12],["ἠγνόουν",700175,333],["δὲ",703303,11],["αὐτὴν",702165,104],["γενέτιν",703045,9],["εἶναι",704093,55],["τούτων",709858,70]],"And I rejoiced in [them] all, because wisdom goeth before them: and I knew not that she was the mother of them."],["13",[["ἀδόλως",700283,28],["τε",712751,11],["ἔμαθον",708480,155],["ἀφθόνως",702208,28],["τε",712751,11],["μεταδίδωμι",708791,157],["τὸν",709436,5],["πλοῦτον",710563,6],["αὐτῆς",702165,86],["οὐκ",709805,28],["ἀποκρύπτομαι",701495,254]],"I learned diligently, and do communicate [her] liberally: I do not hide her riches."],["14",[["ἀνεκλιπὴς",701118,14],["γὰρ",702963,11],["θησαυρός",706258,4],["ἐστιν",704093,91],["ἀνθρώποις",701163,148],["ὃν",709781,112],["οἱ",709436,136],["κτησάμενοι",707932,317],["πρὸς",710844,0],["θεὸν",706192,6],["ἐστείλαντο",712063,189],["φιλίαν",713474,9],["διὰ",703417,0],["τὰς",709436,38],["ἐκ",704132,0],["παιδείας",709924,17],["δωρεὰς",703900,39],["συσταθέντες",712482,247]],"For she is a treasure unto men that never faileth: which they that use become the friends of God, being commended for the gifts that come from learning."],["15",[["ἐμοὶ",704577,159],["δὲ",703303,11],["δῴη",703654,225],["ὁ",709436,3],["θεὸς",706192,4],["εἰπεῖν",708124,106],["κατὰ",707200,0],["γνώμην",703134,9],["καὶ",707031,7],["ἐνθυμηθῆναι",704739,179],["ἀξίως",701311,28],["τῶν",709436,80],["δεδομένων",703654,445],["ὅτι",709803,7],["αὐτὸς",702165,121],["καὶ",707031,7],["τῆς",709436,16],["σοφίας",711981,17],["ὁδηγός",709449,4],["ἐστιν",704093,91],["καὶ",707031,7],["τῶν",709436,80],["σοφῶν",711985,169],["διορθωτής",703729,4]],"God hath granted me to speak as I would, and to conceive as is meet for the things that are given me: because it is he that leadeth unto wisdom, and directeth the wise."],["16",[["ἐν",704639,0],["γὰρ",702963,11],["χειρὶ",713787,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἡμεῖς",705983,219],["καὶ",707031,7],["οἱ",709436,136],["λόγοι",708236,52],["ἡμῶν",705999,145],["πᾶσά",710177,29],["τε",712751,11],["φρόνησις",713588,12],["καὶ",707031,7],["ἐργατειῶν",705388,65],["ἐπιστήμη",705267,12]],"For in his hand are both we and our words; all wisdom also, and knowledge of workmanship."],["17",[["αὐτὸς",702165,121],["γάρ",702963,11],["μοι",708974,159],["ἔδωκεν",703654,2],["τῶν",709436,43],["ὄντων",704093,84],["γνῶσιν",703138,9],["ἀψευδῆ",702321,36],["εἰδέναι",709492,115],["σύστασιν",712557,9],["κόσμου",707851,18],["καὶ",707031,7],["ἐνέργειαν",704717,9],["στοιχείων",712117,44]],"For he hath given me certain knowledge of the things that are, namely, to know how the world was made, and the operation of the elements:"],["18",[["ἀρχὴν",701836,9],["καὶ",707031,7],["τέλος",712787,25],["καὶ",707031,7],["μεσότητα",708769,9],["χρόνων",713969,81],["τροπῶν",712978,65],["ἀλλαγὰς",700681,39],["καὶ",707031,7],["μεταβολὰς",708784,39],["καιρῶν",707047,81]],"the beginning, ending, and midst of the times: the alterations of the turning [of the sun], and change of seasons:"],["19",[["ἐνιαυτοῦ",704745,18],["κύκλους",707957,57],["καὶ",707031,7],["ἄστρων",702024,44],["θέσεις",706223,39]],"the circuits of years, and positions of stars:"],["20",[["φύσεις",713633,39],["ζῴων",705916,44],["καὶ",707031,7],["θυμοὺς",706334,57],["θηρίων",706252,44],["πνευμάτων",710566,44],["βίας",702712,39],["καὶ",707031,7],["διαλογισμοὺς",703506,57],["ἀνθρώπων",701163,81],["διαφορὰς",703627,39],["φυτῶν",713637,44],["καὶ",707031,7],["δυνάμεις",703839,39],["ῥιζῶν",711260,65]],"the natures of living creatures, and the furies of wild beasts: the violence of winds, and the reasonings of men: the diversities of plants, and the virtues of roots:"],["21",[["ὅσα",709788,195],["τέ",712751,11],["ἐστιν",704093,91],["κρυπτὰ",707922,195],["καὶ",707031,7],["ἐμφανῆ",704627,195],["ἔγνων",703105,155],["ἡ",709436,10],["γὰρ",702963,11],["πάντων",710177,83],["τεχνῖτις",712833,12],["ἐδίδαξέν",703649,2],["με",708618,163],["σοφία",711981,12]],"and all such things as are either secret or manifest, [them] I know.",{"s":"d","q":0.43}],["22",[["ἔστιν",704093,91],["γὰρ",702963,11],["ἐν",704639,0],["αὐτῇ",702165,105],["πνεῦμα",710566,15],["νοερόν",709326,26],["ἅγιον",700159,26],["μονογενές",708996,26],["πολυμερές",710631,26],["λεπτόν",708153,26],["εὐκίνητον",705616,26],["τρανόν",712918,26],["ἀμόλυντον",700858,26],["σαφές",711577,26],["ἀπήμαντον",701407,26],["φιλάγαθον",713457,26],["ὀξύ",709682,26]],"For wisdom, which is the worker of all things, taught me: for in her is an understanding spirit, holy, one only, manifold, subtil, lively, clear, undefiled, plain, not subject to hurt, loving the thing that is good, quick, which cannot be letted, ready to do good,",{"s":"d","q":0.64}],["23",[["ἀκώλυτον",700621,26],["εὐεργετικόν",705579,26],["φιλάνθρωπον",713463,26],["βέβαιον",702609,26],["ἀσφαλές",702040,26],["ἀμέριμνον",700810,26],["παντοδύναμον",709983,26],["πανεπίσκοπον",709961,26],["καὶ",707031,7],["διὰ",703417,0],["πάντων",710177,83],["χωροῦν",714012,32],["πνευμάτων",710566,44],["νοερῶν",709326,83],["καθαρῶν",706988,83],["λεπτοτάτων",708153,616]],"kind to man, stedfast, sure, free from care, having all power, overseeing all things, and going through all understanding, pure, and most subtil, spirits."],["24",[["πάσης",710177,82],["γὰρ",702963,11],["κινήσεως",707681,17],["κινητικώτερον",707682,385],["σοφία",711981,12],["διήκει",703683,91],["δὲ",703303,11],["καὶ",707031,7],["χωρεῖ",714012,91],["διὰ",703417,0],["πάντων",710177,83],["διὰ",703417,0],["τὴν",709436,8],["καθαρότητα",706989,9]],"For wisdom is more moving than any motion: she passeth and goeth through all things by reason of her pureness."],["25",[["ἀτμὶς",702100,12],["γάρ",702963,11],["ἐστιν",704093,91],["τῆς",709436,16],["τοῦ",709436,35],["θεοῦ",706192,18],["δυνάμεως",703839,17],["καὶ",707031,7],["ἀπόρροια",701564,12],["τῆς",709436,16],["τοῦ",709436,35],["παντοκράτορος",709986,18],["δόξης",703791,17],["εἰλικρινής",704091,29],["διὰ",703417,0],["τοῦτο",709858,129],["οὐδὲν",709817,26],["μεμιαμμένον",708900,327],["εἰς",704105,0],["αὐτὴν",702165,104],["παρεμπίπτει",710134,91]],"For she is the breath of the power of God, and a pure influence flowing from the glory of the Almighty: therefore can no defiled thing fall into her."],["26",[["ἀπαύγασμα",701367,15],["γάρ",702963,11],["ἐστιν",704093,91],["φωτὸς",713642,21],["ἀϊδίου",700406,92],["καὶ",707031,7],["ἔσοπτρον",705499,15],["ἀκηλίδωτον",700540,26],["τῆς",709436,16],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐνεργείας",704717,17],["καὶ",707031,7],["εἰκὼν",704088,72],["τῆς",709436,16],["ἀγαθότητος",700107,17],["αὐτοῦ",702165,102]],"For she is the brightness of the everlasting light, the unspotted mirror of the power of God, and the image of his goodness."],["27",[["μία",704106,29],["δὲ",703303,11],["οὖσα",704093,188],["πάντα",710177,46],["δύναται",703838,117],["καὶ",707031,7],["μένουσα",708736,188],["ἐν",704639,0],["αὑτῇ",703917,105],["τὰ",709436,41],["πάντα",710177,68],["καινίζει",707041,91],["καὶ",707031,7],["κατὰ",707200,0],["γενεὰς",703037,39],["εἰς",704105,0],["ψυχὰς",714070,39],["ὁσίας",709782,119],["μεταβαίνουσα",708781,188],["φίλους",713492,60],["θεοῦ",706192,18],["καὶ",707031,7],["προφήτας",711009,57],["κατασκευάζει",707419,91]],"And being but one, she can do all things: and remaining in herself, she maketh all things new: and in all ages entering into holy souls, she maketh them friends of God, and prophets."],["28",[["οὐθὲν",709817,46],["γὰρ",702963,11],["ἀγαπᾷ",700120,91],["ὁ",709436,3],["θεὸς",706192,4],["εἰ",704071,7],["μὴ",708851,28],["τὸν",709436,5],["σοφίᾳ",711981,1],["συνοικοῦντα",712493,183]],"For God loveth none but him that dwelleth with wisdom."],["29",[["ἔστιν",704093,91],["γὰρ",702963,11],["αὕτη",709858,107],["εὐπρεπεστέρα",705667,178],["ἡλίου",705974,18],["καὶ",707031,7],["ὑπὲρ",713111,0],["πᾶσαν",710177,36],["ἄστρων",702024,44],["θέσιν",706223,9],["φωτὶ",713642,54],["συγκρινομένη",712233,211],["εὑρίσκεται",705676,117],["προτέρα",711041,178]],"For she is more beautiful than the sun, and above all the order of stars: being compared with the light, she is found before it."],["30",[["τοῦτο",709858,129],["μὲν",708730,11],["γὰρ",702963,11],["διαδέχεται",703444,117],["νύξ",709386,12],["σοφίας",711981,17],["δὲ",703303,11],["οὐ",709805,28],["κατισχύει",707531,91],["κακία",707054,12]],"For after this cometh night: but vice shall not prevail against wisdom."]]