[["1",[["σὺ",712181,164],["δέ",703303,11],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["χρηστὸς",713958,14],["καὶ",707031,7],["ἀληθής",700658,14],["μακρόθυμος",708420,14],["καὶ",707031,7],["ἐλέει",704426,54],["διοικῶν",703717,72],["τὰ",709436,41],["πάντα",710177,68]],"But thou, our God, art gracious and true, long-suffering, and in mercy ordering all things."],["2",[["καὶ",707031,28],["γὰρ",702963,11],["ἐὰν",703912,7],["ἁμάρτωμεν",700773,79],["σοί",711925,159],["ἐσμεν",704093,243],["εἰδότες",709492,268],["σου",711945,133],["τὸ",709436,24],["κράτος",707883,25],["οὐχ",709805,28],["ἁμαρτησόμεθα",700773,141],["δέ",703303,11],["εἰδότες",709492,268],["ὅτι",709803,7],["σοὶ",711925,159],["λελογίσμεθα",708232,580]],"For if we sin, we are thine, knowing thy power: but we will not sin, knowing that we are counted thine."],["3",[["τὸ",709436,34],["γὰρ",702963,11],["ἐπίστασθαί",705264,110],["σε",711598,163],["ὁλόκληρος",709591,29],["δικαιοσύνη",703695,12],["καὶ",707031,7],["εἰδέναι",709492,115],["σου",711945,133],["τὸ",709436,24],["κράτος",707883,25],["ῥίζα",711260,12],["ἀθανασίας",700357,17]],"For to know thee is perfect righteousness: yea, to know thy power is the root of immortality."],["4",[["οὔτε",709857,7],["γὰρ",702963,11],["ἐπλάνησεν",710495,2],["ἡμᾶς",705981,194],["ἀνθρώπων",701163,81],["κακότεχνος",707068,29],["ἐπίνοια",705215,12],["οὐδὲ",709816,7],["σκιαγράφων",711853,81],["πόνος",710661,4],["ἄκαρπος",700522,14],["εἶδος",704074,15],["σπιλωθὲν",712014,418],["χρώμασιν",713982,96],["διηλλαγμένοις",703502,594]],"For neither did the mischievous invention of men deceive us, nor an image spotted with divers colours, the painter's fruitless labour;"],["5",[["ὧν",709781,103],["ὄψις",709901,12],["ἄφροσιν",702236,230],["εἰς",704105,0],["ὄρεξιν",709734,9],["ἔρχεται",705453,117],["ποθεῖ",710581,91],["τε",712751,11],["νεκρᾶς",709247,82],["εἰκόνος",704089,17],["εἶδος",704074,25],["ἄπνουν",701424,46]],"the sight whereof enticeth fools to lust after it, and so they desire the form of a dead image, that hath no breath."],["6",[["κακῶν",707066,83],["ἐρασταὶ",705379,52],["ἄξιοί",701308,138],["τε",712751,11],["τοιούτων",712878,198],["ἐλπίδων",704530,65],["καὶ",707031,7],["οἱ",709436,136],["δρῶντες",703828,146],["καὶ",707031,7],["οἱ",709436,136],["ποθοῦντες",710581,146],["καὶ",707031,7],["οἱ",709436,136],["σεβόμενοι",711609,348]],"Both they that make them, they that desire them, and they that worship them, are lovers of evil things, and are worthy to have such things to trust upon."],["7",[["καὶ",707031,7],["γὰρ",702963,11],["κεραμεὺς",707619,4],["ἁπαλὴν",701336,36],["γῆν",703083,9],["θλίβων",706274,72],["ἐπίμοχθον",705208,36],["πλάσσει",710503,91],["πρὸς",710844,0],["ὑπηρεσίαν",713177,9],["ἡμῶν",705999,145],["ἓν",704106,46],["ἕκαστον",704133,46],["ἀλλ᾿",700680,7],["ἐκ",704132,0],["τοῦ",709436,35],["αὐτοῦ",702165,102],["πηλοῦ",710457,18],["ἀνεπλάσατο",701034,23],["τά",709436,41],["τε",712751,11],["τῶν",709436,43],["καθαρῶν",706988,83],["ἔργων",705396,44],["δοῦλα",703817,68],["σκεύη",711844,42],["τά",709436,41],["τε",712751,11],["ἐναντία",704656,68],["πάντα",710177,68],["ὁμοίως",709630,28],["τούτων",709858,70],["δὲ",703303,11],["ἑτέρου",705535,92],["τίς",712867,158],["ἑκάστου",704133,92],["ἐστὶν",704093,91],["ἡ",709436,10],["χρῆσις",713954,12],["κριτὴς",707910,4],["ὁ",709436,3],["πηλουργός",710458,4]],"For the potter, tempering soft earth, fashioneth every vessel with much labour for our service: yea, of the same clay he maketh both the vessels that serve for clean uses, and likewise also all such as serve to the contrary: but what is the use of either sort, the potter himself is the judge."],["8",[["καὶ",707031,7],["κακόμοχθος",707059,14],["θεὸν",706192,6],["μάταιον",708575,27],["ἐκ",704132,0],["τοῦ",709436,35],["αὐτοῦ",702165,102],["πλάσσει",710503,91],["πηλοῦ",710457,18],["ὃς",709781,213],["πρὸ",710747,0],["μικροῦ",708915,92],["ἐκ",704132,0],["γῆς",703083,17],["γενηθεὶς",703104,217],["μετ᾿",708780,0],["ὀλίγον",709568,46],["πορεύεται",710667,117],["ἐξ",704132,0],["ἧς",709781,167],["ἐλήμφθη",708076,37],["τὸ",709436,24],["τῆς",709436,16],["ψυχῆς",714070,17],["ἀπαιτηθεὶς",701330,217],["χρέος",713942,25]],"And employing his labours lewdly, he maketh a vain god of the same clay, even he which a little before was made of earth himself, and within a little while after returneth to the same, out of the which he was taken, when his life which was lent him shall be demanded."],["9",[["ἀλλ᾿",700680,7],["ἔστιν",704093,91],["αὐτῷ",702165,50],["φροντὶς",713591,12],["οὐχ",709805,28],["ὅτι",709803,7],["μέλλει",708705,91],["κάμνειν",707115,55],["οὐδ᾿",709816,7],["ὅτι",709803,7],["βραχυτελῆ",702810,27],["βίον",702724,6],["ἔχει",705785,91],["ἀλλ᾿",700680,7],["ἀντερείδεται",701224,117],["μὲν",708730,11],["χρυσουργοῖς",713976,148],["καὶ",707031,7],["ἀργυροχόοις",701712,148],["χαλκοπλάστας",713694,57],["τε",712751,11],["μιμεῖται",708921,117],["καὶ",707031,7],["δόξαν",703791,9],["ἡγεῖται",705931,117],["ὅτι",709803,7],["κίβδηλα",707666,68],["πλάσσει",710503,91]],"Notwithstanding his care is, not that he shall have much labour, nor that his life is short: but striveth to excel goldsmiths and silversmiths, and endeavoureth to do like the workers in brass, and counteth it his glory to make counterfeit things."],["10",[["σποδὸς",712022,12],["ἡ",709436,10],["καρδία",707141,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["γῆς",703083,17],["εὐτελεστέρα",705705,178],["ἡ",709436,10],["ἐλπὶς",704530,12],["αὐτοῦ",702165,102],["πηλοῦ",710457,18],["τε",712751,11],["ἀτιμότερος",702095,224],["ὁ",709436,3],["βίος",702724,4],["αὐτοῦ",702165,102]],"His heart is ashes, his hope is more vile than earth, and his life of less value than clay:"],["11",[["ὅτι",709803,7],["ἠγνόησεν",700175,2],["τὸν",709436,5],["πλάσαντα",710503,365],["αὐτὸν",702165,85],["καὶ",707031,7],["τὸν",709436,5],["ἐμπνεύσαντα",704602,365],["αὐτῷ",702165,50],["ψυχὴν",714070,9],["ἐνεργοῦσαν",704718,78],["καὶ",707031,7],["ἐμφυσήσαντα",704636,365],["πνεῦμα",710566,25],["ζωτικόν",705923,27]],"forasmuch as he knew not his Maker, and him that inspired into him an active soul, and breathed in a living spirit."],["12",[["ἀλλ᾿",700680,7],["ἐλογίσαντο",708232,189],["παίγνιον",709922,25],["εἶναι",704093,55],["τὴν",709436,8],["ζωὴν",705910,9],["ἡμῶν",705999,145],["καὶ",707031,7],["τὸν",709436,5],["βίον",702724,6],["πανηγυρισμὸν",709964,6],["ἐπικερδῆ",705161,27],["δεῖν",703312,55],["γάρ",702963,11],["φησιν",713437,91],["ὅθεν",709486,28],["δή",703395,11],["κἂν",707120,459],["ἐκ",704132,0],["κακοῦ",707066,92],["πορίζειν",710670,55]],"But they counted our life a pastime, and our time here a market for gain: for, say they, we must be getting every way, though it be by evil means."],["13",[["οὗτος",709858,121],["γὰρ",702963,11],["παρὰ",709995,0],["πάντας",710177,60],["οἶδεν",709492,171],["ὅτι",709803,7],["ἁμαρτάνει",700773,91],["ὕλης",713077,17],["γεώδους",703076,82],["εὔθραυστα",705598,68],["σκεύη",711844,42],["καὶ",707031,7],["γλυπτὰ",703117,68],["δημιουργῶν",703410,81]],"For this man, that of earthly matter maketh brittle vessels and graven images, knoweth himself to offend above all others."],["14",[["πάντες",710177,138],["δὲ",703303,11],["ἀφρονέστατοι",702236,480],["καὶ",707031,7],["τάλανες",712698,138],["ὑπὲρ",713111,0],["ψυχὴν",714070,9],["νηπίου",709295,116],["οἱ",709436,136],["ἐχθροὶ",705779,138],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133],["καταδυναστεύσαντες",707248,196],["αὐτόν",702165,85]],"And all the enemies of thy people, that hold them in subjection, are most foolish, and are more miserable than very babes."],["15",[["ὅτι",709803,7],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["εἴδωλα",704079,42],["τῶν",709436,43],["ἐθνῶν",704068,44],["ἐλογίσαντο",708232,189],["θεούς",706192,57],["οἷς",709781,295],["οὔτε",709857,7],["ὀμμάτων",709616,44],["χρῆσις",713954,12],["εἰς",704105,0],["ὅρασιν",709721,9],["οὔτε",709857,7],["ῥῖνες",711268,191],["εἰς",704105,0],["συνολκὴν",712497,9],["ἀέρος",700354,18],["οὔτε",709857,7],["ὦτα",709852,25],["ἀκούειν",700587,55],["οὔτε",709857,7],["δάκτυλοι",703259,52],["χειρῶν",713787,65],["εἰς",704105,0],["ψηλάφησιν",714048,9],["καὶ",707031,7],["οἱ",709436,136],["πόδες",710707,52],["αὐτῶν",702165,40],["ἀργοὶ",701704,138],["πρὸς",710844,0],["ἐπίβασιν",705084,9]],"For they counted all the idols of the heathen to be gods: which neither have the use of eyes to see, nor noses to draw breath, nor ears to hear, nor fingers of hands to handle; and as for their feet, they are slow to go."],["16",[["ἄνθρωπος",701163,4],["γὰρ",702963,11],["ἐποίησεν",710582,2],["αὐτούς",702165,62],["καὶ",707031,7],["τὸ",709436,24],["πνεῦμα",710566,25],["δεδανεισμένος",703277,419],["ἔπλασεν",710503,2],["αὐτούς",702165,62],["οὐδεὶς",709817,14],["γὰρ",702963,11],["αὐτῷ",702165,50],["ὅμοιον",709626,27],["ἄνθρωπος",701163,4],["ἰσχύει",706859,91],["πλάσαι",710503,106],["θεόν",706192,6]],"For man made them, and he that borrowed his own spirit fashioned them: but no man can make a god like unto himself."],["17",[["θνητὸς",706279,14],["δὲ",703303,11],["ὢν",704093,72],["νεκρὸν",709247,6],["ἐργάζεται",705383,117],["χερσὶν",713787,76],["ἀνόμοις",701194,291],["κρείττων",707891,14],["γάρ",702963,11],["ἐστιν",704093,91],["τῶν",709436,43],["σεβασμάτων",711603,44],["αὐτοῦ",702165,102],["ὧν",709781,103],["αὐτὸς",702165,121],["μὲν",708730,11],["ἔζησεν",705851,2],["ἐκεῖνα",704183,290],["δὲ",703303,11],["οὐδέποτε",709818,28]],"For being mortal, he worketh a dead thing with wicked hands: for he himself is better than the things which he worshippeth: whereas [he] lived once, but they never."],["18",[["καὶ",707031,7],["τὰ",709436,41],["ζῷα",705916,42],["δὲ",703303,11],["τὰ",709436,41],["ἔχθιστα",705779,430],["σέβονται",711609,269],["ἀνοίᾳ",701185,1],["γὰρ",702963,11],["συγκρινόμενα",712233,210],["τῶν",709436,43],["ἄλλων",700697,70],["ἐστὶ",704093,91],["χείρονα",713799,195]],"Yea, they worshipped those beasts also that are most hateful: for being compared together, some are worse than others."],["19",[["οὐδ᾿",709816,7],["ὅσον",709788,46],["ἐπιποθῆσαι",705228,106],["ὡς",714148,7],["ἐν",704639,0],["ζῴων",705916,44],["ὄψει",709901,1],["καλὰ",707097,68],["τυγχάνει",713015,91],["ἐκπέφευγεν",704357,171],["δὲ",703303,11],["καὶ",707031,7],["τὸν",709436,5],["τοῦ",709436,35],["θεοῦ",706192,18],["ἔπαινον",705001,6],["καὶ",707031,7],["τὴν",709436,8],["εὐλογίαν",705633,9],["αὐτοῦ",702165,102]],"Neither are they beautiful, so much as to be desired in respect of beasts: but they went without the praise of God and his blessing."]]