[["1",[["ἀκούσατε",700587,74],["οὖν",709835,11],["βασιλεῖς",702580,274],["καὶ",707031,7],["σύνετε",712481,74],["μάθετε",708480,74],["δικασταὶ",703701,274],["περάτων",710281,44],["γῆς",703083,17]],"Hear therefore, O ye kings, and understand; learn, ye that be judges of the ends of the earth."],["2",[["ἐνωτίσασθε",704825,186],["οἱ",709436,643],["κρατοῦντες",707879,759],["πλήθους",710529,21],["καὶ",707031,7],["γεγαυρωμένοι",702984,760],["ἐπὶ",705080,0],["ὄχλοις",709884,148],["ἐθνῶν",704068,44]],"Give ear, ye that rule the people, and glory in the multitude of nations."],["3",[["ὅτι",709803,7],["ἐδόθη",703654,37],["παρὰ",709995,0],["κυρίου",707996,18],["ἡ",709436,10],["κράτησις",707882,12],["ὑμῖν",713084,90],["καὶ",707031,7],["ἡ",709436,10],["δυναστεία",703841,12],["παρὰ",709995,0],["ὑψίστου",713287,116],["ὃς",709781,213],["ἐξετάσει",704911,127],["ὑμῶν",713091,145],["τὰ",709436,41],["ἔργα",705396,42],["καὶ",707031,7],["τὰς",709436,38],["βουλὰς",702792,39],["διερευνήσει",703671,127]],"For power is given you of the Lord, and sovereignty from the Highest, who shall try your works, and search out your counsels."],["4",[["ὅτι",709803,7],["ὑπηρέται",713179,274],["ὄντες",704093,759],["τῆς",709436,16],["αὐτοῦ",702165,102],["βασιλείας",702577,17],["οὐκ",709805,28],["ἐκρίνατε",707905,265],["ὀρθῶς",709746,28],["οὐδὲ",709816,7],["ἐφυλάξατε",713619,265],["νόμον",709349,6],["οὐδὲ",709816,7],["κατὰ",707200,0],["τὴν",709436,8],["βουλὴν",702792,9],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐπορεύθητε",710667,472]],"Because, being ministers of his kingdom, ye have not judged aright, nor kept the law, nor walked after the counsel of God;"],["5",[["φρικτῶς",713582,28],["καὶ",707031,7],["ταχέως",712743,28],["ἐπιστήσεται",705756,93],["ὑμῖν",713084,90],["ὅτι",709803,7],["κρίσις",707908,12],["ἀπότομος",701620,29],["ἐν",704639,0],["τοῖς",709436,147],["ὑπερέχουσιν",713134,349],["γίνεται",703104,117]],"horribly and speedily shall he come upon you: for a sharp judgment shall be to them that be in high places."],["6",[["ὁ",709436,3],["γὰρ",702963,11],["ἐλάχιστος",704400,140],["συγγνωστός",712190,14],["ἐστιν",704093,91],["ἐλέους",704426,57],["δυνατοὶ",703845,138],["δὲ",703303,11],["δυνατῶς",703846,28],["ἐτασθήσονται",705526,144]],"For mercy will soon pardon the meanest: but mighty men shall be mightily tormented."],["7",[["οὐ",709805,28],["γὰρ",702963,11],["ὑποστελεῖται",713242,93],["πρόσωπον",710986,25],["ὁ",709436,3],["πάντων",710177,169],["δεσπότης",703379,4],["οὐδὲ",709816,7],["ἐντραπήσεται",704805,134],["μέγεθος",708656,25],["ὅτι",709803,7],["μικρὸν",708915,27],["καὶ",707031,7],["μέγαν",708653,27],["αὐτὸς",702165,121],["ἐποίησεν",710582,2],["ὁμοίως",709630,28],["τε",712751,11],["προνοεῖ",710824,127],["περὶ",710285,0],["πάντων",710177,169]],"For he which is Lord over all shall fear no man's person, neither shall he stand in awe of any man's greatness: for he hath made the small and great, and careth for all alike."],["8",[["τοῖς",709436,147],["δὲ",703303,11],["κραταιοῖς",707873,230],["ἰσχυρὰ",706855,68],["ἐφίσταται",705756,117],["ἔρευνα",705411,12]],"But a sore trial shall come upon the mighty."],["9",[["πρὸς",710844,0],["ὑμᾶς",713080,194],["οὖν",709835,11],["ὦ",714081,88],["τύραννοι",713026,274],["οἱ",709436,136],["λόγοι",708236,52],["μου",709032,133],["ἵνα",706747,7],["μάθητε",708480,125],["σοφίαν",711981,9],["καὶ",707031,7],["μὴ",708851,28],["παραπέσητε",710089,125]],"Unto you therefore, O kings, do I speak, that ye may learn wisdom, and not fall away."],["10",[["οἱ",709436,136],["γὰρ",702963,11],["φυλάξαντες",713619,196],["ὁσίως",709785,28],["τὰ",709436,41],["ὅσια",709782,68],["ὁσιωθήσονται",709784,144],["καὶ",707031,7],["οἱ",709436,136],["διδαχθέντες",703649,247],["αὐτὰ",702165,71],["εὑρήσουσιν",705676,218],["ἀπολογίαν",701518,9]],"For they that keep holiness holily shall be judged holy: and they that have learned such things shall find what to answer."],["11",[["ἐπιθυμήσατε",705141,74],["οὖν",709835,11],["τῶν",709436,80],["λόγων",708236,81],["μου",709032,133],["ποθήσατε",710581,74],["καὶ",707031,7],["παιδευθήσεσθε",709926,261]],"Wherefore set your affection upon my words; desire them, and ye shall be instructed."],["12",[["λαμπρὰ",708082,29],["καὶ",707031,7],["ἀμάραντός",700768,29],["ἐστιν",704093,91],["ἡ",709436,10],["σοφία",711981,12],["καὶ",707031,7],["εὐχερῶς",705725,28],["θεωρεῖται",706226,117],["ὑπὸ",713184,0],["τῶν",709436,80],["ἀγαπώντων",700120,170],["αὐτὴν",702165,104],["καὶ",707031,7],["εὑρίσκεται",705676,117],["ὑπὸ",713184,0],["τῶν",709436,80],["ζητούντων",705879,170],["αὐτήν",702165,104]],"Wisdom is glorious, and never fadeth away: yea, she is easily seen of them that love her, and found of such as seek her."],["13",[["φθάνει",713439,91],["τοὺς",709436,58],["ἐπιθυμοῦντας",705141,235],["προγνωσθῆναι",710774,179]],"She preventeth them that desire her, in making herself first known unto them."],["14",[["ὁ",709436,3],["ὀρθρίσας",709742,182],["πρὸς",710844,0],["αὐτὴν",702165,104],["οὐ",709805,28],["κοπιάσει",707824,127],["πάρεδρον",710124,6],["γὰρ",702963,11],["εὑρήσει",705676,127],["τῶν",709436,130],["πυλῶν",711082,65],["αὐτοῦ",702165,102]],"Whoso seeketh her early shall have no great travail: for he shall find her sitting at his doors."],["15",[["τὸ",709436,34],["γὰρ",702963,11],["ἐνθυμηθῆναι",704739,179],["περὶ",710285,0],["αὐτῆς",702165,86],["φρονήσεως",713588,17],["τελειότης",712770,12],["καὶ",707031,7],["ὁ",709436,3],["ἀγρυπνήσας",700197,182],["δι᾿",703417,0],["αὐτὴν",702165,104],["ταχέως",712743,28],["ἀμέριμνος",700810,14],["ἔσται",704093,93]],"To think therefore upon her is the perfection of wisdom: and whoso watcheth for her shall quickly be without care."],["16",[["ὅτι",709803,7],["τοὺς",709436,58],["ἀξίους",701308,60],["αὐτῆς",702165,86],["αὐτὴ",702165,107],["περιέρχεται",710314,117],["ζητοῦσα",705879,188],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["τρίβοις",712939,76],["φαντάζεται",713346,117],["αὐτοῖς",702165,151],["εὐμενῶς",705642,28],["καὶ",707031,7],["ἐν",704639,0],["πάσῃ",710177,101],["ἐπινοίᾳ",705215,1],["ὑπαντᾷ",713098,91],["αὐτοῖς",702165,151]],"For she goeth about seeking such as are worthy of her, sheweth herself favourably unto them in the ways, and meeteth them in every thought."],["17",[["ἀρχὴ",701836,12],["γὰρ",702963,11],["αὐτῆς",702165,86],["ἡ",709436,10],["ἀληθεστάτη",700658,417],["παιδείας",709924,17],["ἐπιθυμία",705147,12],["φροντὶς",713591,12],["δὲ",703303,11],["παιδείας",709924,17],["ἀγάπη",700122,12]],"For the very true beginning of her is the desire of discipline; and the care of discipline is love;"],["18",[["ἀγάπη",700122,12],["δὲ",703303,11],["τήρησις",712845,12],["νόμων",709349,81],["αὐτῆς",702165,86],["προσοχὴ",710944,12],["δὲ",703303,11],["νόμων",709349,81],["βεβαίωσις",702612,12],["ἀφθαρσίας",702205,17]],"and love is the keeping of her laws; and the giving heed unto her laws is the assurance of incorruption;"],["19",[["ἀφθαρσία",702205,12],["δὲ",703303,11],["ἐγγὺς",703948,28],["εἶναι",704093,55],["ποιεῖ",710582,91],["θεοῦ",706192,18]],"and incorruption maketh us near unto God:"],["20",[["ἐπιθυμία",705147,12],["ἄρα",701666,11],["σοφίας",711981,17],["ἀνάγει",700933,91],["ἐπὶ",705080,0],["βασιλείαν",702577,9]],"therefore the desire of wisdom bringeth to a kingdom."],["21",[["εἰ",704071,7],["οὖν",709835,11],["ἥδεσθε",705941,374],["ἐπὶ",705080,0],["θρόνοις",706315,148],["καὶ",707031,7],["σκήπτροις",711851,96],["τύραννοι",713026,274],["λαῶν",708094,81],["τιμήσατε",712855,74],["σοφίαν",711981,9],["ἵνα",706747,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["βασιλεύσητε",702581,125]],"If your delight be then in thrones and sceptres, O ye kings of the people, honour wisdom, that ye may reign for evermore."],["22",[["τί",712867,273],["δέ",703303,11],["ἐστιν",704093,91],["σοφία",711981,12],["καὶ",707031,7],["πῶς",711121,28],["ἐγένετο",703104,23],["ἀπαγγελῶ",701321,165],["καὶ",707031,7],["οὐκ",709805,28],["ἀποκρύψω",701495,165],["ὑμῖν",713084,90],["μυστήρια",709080,42],["ἀλλὰ",700680,7],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["γενέσεως",703043,17],["ἐξιχνιάσω",704941,165],["καὶ",707031,7],["θήσω",712849,165],["εἰς",704105,0],["τὸ",709436,24],["ἐμφανὲς",704627,46],["τὴν",709436,8],["γνῶσιν",703138,9],["αὐτῆς",702165,86],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["παροδεύσω",710153,165],["τὴν",709436,8],["ἀλήθειαν",700656,9]],"As for wisdom, what she is, and how she came up, I will tell you, and will not hide mysteries from you: but will seek her out from the beginning of her nativity, and bring the knowledge of her into light, and will not pass over the truth."],["23",[["οὔτε",709857,7],["μὴν",708873,11],["φθόνῳ",713450,114],["τετηκότι",712839,514],["συνοδεύσω",712489,165],["ὅτι",709803,7],["οὗτος",709858,121],["οὐ",709805,28],["κοινωνήσει",707775,127],["σοφίᾳ",711981,1]],"Neither will I go with consuming envy; for such a man shall have no fellowship with wisdom."],["24",[["πλῆθος",710529,15],["δὲ",703303,11],["σοφῶν",711985,169],["σωτηρία",712658,12],["κόσμου",707851,18],["καὶ",707031,7],["βασιλεὺς",702580,4],["φρόνιμος",713589,14],["εὐστάθεια",705692,12],["δήμου",703411,18]],"But the multitude of the wise is the welfare of the world: and a wise king is the upholding of the people."],["25",[["ὥστε",714164,7],["παιδεύεσθε",709926,73],["τοῖς",709436,95],["ῥήμασίν",711246,96],["μου",709032,133],["καὶ",707031,7],["ὠφεληθήσεσθε",714171,261]],"Receive therefore instruction through my words, and it shall do you good."]]