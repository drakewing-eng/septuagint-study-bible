[["1",[["τοῖς",709436,147],["δὲ",703303,11],["ὁσίοις",709782,230],["σου",711945,133],["μέγιστον",708653,654],["ἦν",704093,13],["φῶς",713642,15],["ὧν",709781,252],["φωνὴν",713640,9],["μὲν",708730,11],["ἀκούοντες",700587,146],["μορφὴν",709018,9],["δὲ",703303,11],["οὐχ",709805,28],["ὁρῶντες",709725,146],["ὅτι",709803,7],["μὲν",708730,11],["οὐ",709805,28],["κἀκεῖνοι",707052,762],["ἐπεπόνθεισαν",710183,263],["ἐμακάριζον",708396,137]],"Nevertheless thy saints had a very great light, whose voice they hearing, and not seeing their shape, because they also had not suffered the same things, they counted them happy."],["2",[["ὅτι",709803,7],["δ᾿",703303,11],["οὐ",709805,28],["βλάπτουσιν",702732,197],["προηδικημένοι",710750,429],["ηὐχαρίστουν",705721,137],["καὶ",707031,7],["τοῦ",709436,20],["διενεχθῆναι",703622,179],["χάριν",713735,9],["ἐδέοντο",703394,139]],"But for that they did not hurt them [now], of whom they had been wronged before, they thanked them, and besought them pardon for that they had been enemies."],["3",[["ἀνθ᾿",701227,0],["ὧν",709781,252],["πυριφλεγῆ",711098,27],["στῦλον",712179,6],["ὁδηγὸν",709449,6],["μὲν",708730,11],["ἀγνώστου",700181,82],["ὁδοιπορίας",709450,17],["ἥλιον",705974,6],["δὲ",703303,11],["ἀβλαβῆ",700082,27],["φιλοτίμου",713502,82],["ξενιτείας",709413,17],["παρέσχες",710142,162]],"Instead whereof thou gavest them a burning pillar of fire, both to be a guide of the unknown journey, and a harmless sun to entertain them honourably."],["4",[["ἄξιοι",701308,138],["μὲν",708730,11],["γὰρ",702963,11],["ἐκεῖνοι",704183,201],["στερηθῆναι",712076,179],["φωτὸς",713642,21],["καὶ",707031,7],["φυλακισθῆναι",713614,179],["σκότει",711889,54],["οἱ",709436,136],["κατακλείστους",707271,60],["φυλάξαντες",713619,196],["τοὺς",709436,58],["υἱούς",713075,57],["σου",711945,133],["δι᾿",703417,0],["ὧν",709781,252],["ἤμελλεν",708705,13],["τὸ",709436,34],["ἄφθαρτον",702206,26],["νόμου",709349,18],["φῶς",713642,25],["τῷ",709436,113],["αἰῶνι",700504,114],["δίδοσθαι",703654,110]],"For they were worthy to be deprived of light, and imprisoned in darkness, who had kept thy sons shut up, by whom the uncorrupt light of the law was to be given unto the world."],["5",[["βουλευσαμένους",702791,525],["δ᾿",703303,11],["αὐτοὺς",702165,62],["τὰ",709436,41],["τῶν",709436,80],["ὁσίων",709782,169],["ἀποκτεῖναι",701498,106],["νήπια",709295,68],["καὶ",707031,7],["ἑνὸς",704106,92],["ἐκτεθέντος",704330,401],["τέκνου",712761,21],["καὶ",707031,7],["σωθέντος",712627,401],["εἰς",704105,0],["ἔλεγχον",704415,6],["τὸ",709436,24],["αὐτῶν",702165,40],["ἀφείλω",702177,174],["πλῆθος",710529,25],["τέκνων",712761,44],["καὶ",707031,7],["ὁμοθυμαδὸν",709624,28],["ἀπώλεσας",701513,162],["ἐν",704639,0],["ὕδατι",713071,54],["σφοδρῷ",712587,97]],"And when they had determined to slay the babes of the saints, one child being cast forth, and saved, to reprove them, thou tookest away the multitude of their children, and destroyedst them all together in a mighty water."],["6",[["ἐκείνη",704183,107],["ἡ",709436,10],["νὺξ",709386,12],["προεγνώσθη",710774,37],["πατράσιν",710189,148],["ἡμῶν",705999,145],["ἵνα",706747,7],["ἀσφαλῶς",702045,28],["εἰδότες",709492,268],["οἷς",709781,311],["ἐπίστευσαν",710483,150],["ὅρκοις",709753,148],["ἐπευθυμήσωσιν",705072,234]],"Of that night were our fathers certified afore, that assuredly knowing unto what oaths they had given credence, they might afterwards be of good cheer."],["7",[["προσεδέχθη",710874,37],["ὑπὸ",713184,0],["λαοῦ",708094,18],["σου",711945,133],["σωτηρία",712658,12],["μὲν",708730,11],["δικαίων",703694,169],["ἐχθρῶν",705779,169],["δὲ",703303,11],["ἀπώλεια",701660,12]],"So of thy people was accepted both the salvation of the righteous, and destruction of the enemies."],["8",[["ᾧ",709781,309],["γὰρ",702963,11],["ἐτιμωρήσω",712861,174],["τοὺς",709436,58],["ὑπεναντίους",713109,60],["τούτῳ",709858,280],["ἡμᾶς",705981,194],["προσκαλεσάμενος",710912,248],["ἐδόξασας",703792,162]],"For wherewith thou didst punish our adversaries, by the same thou didst glorify us, whom thou hadst called."],["9",[["κρυφῇ",707929,28],["γὰρ",702963,11],["ἐθυσίαζον",706346,137],["ὅσιοι",709782,138],["παῖδες",709932,52],["ἀγαθῶν",700106,169],["καὶ",707031,7],["τὸν",709436,5],["τῆς",709436,16],["θειότητος",706155,17],["νόμον",709349,6],["ἐν",704639,0],["ὁμονοίᾳ",709639,1],["διέθεντο",703609,189],["τῶν",709436,80],["αὐτῶν",702165,40],["ὁμοίως",709630,28],["καὶ",707031,7],["ἀγαθῶν",700106,169],["καὶ",707031,7],["κινδύνων",707678,81],["μεταλήμψεσθαι",708800,492],["τοὺς",709436,58],["ἁγίους",700159,60],["πατέρων",710189,81],["ἤδη",705939,28],["προαναμέλποντες",710755,146],["αἴνους",700462,57]],"For the righteous children of good men did sacrifice secretly, and with one consent made a holy law, that the saints should be like partakers of the same good and evil, the fathers now singing out the songs of praise."],["10",[["ἀντήχει",701226,13],["δ᾿",703303,11],["ἀσύμφωνος",702033,29],["ἐχθρῶν",705779,169],["ἡ",709436,10],["βοή",702744,12],["καὶ",707031,7],["οἰκτρὰ",709524,29],["διεφέρετο",703622,19],["φωνὴ",713640,12],["θρηνουμένων",706306,299],["παίδων",709932,81]],"But on the other side there sounded an ill according cry of the enemies, and a lamentable noise was carried abroad for children that were bewailed."],["11",[["ὁμοίᾳ",709626,101],["δὲ",703303,11],["δίκῃ",703702,1],["δοῦλος",703817,4],["ἅμα",700745,28],["δεσπότῃ",703379,114],["κολασθεὶς",707786,217],["καὶ",707031,7],["δημότης",703414,4],["βασιλεῖ",702580,114],["τὰ",709436,41],["αὐτὰ",702165,71],["πάσχων",710183,72]],"The master and the servant were punished after one manner; and like as the king, so suffered the common person."],["12",[["ὁμοθυμαδὸν",709624,28],["δὲ",703303,11],["πάντες",710177,138],["ἐν",704639,0],["ἑνὶ",704106,97],["ὀνόματι",709666,54],["θανάτου",706096,18],["νεκροὺς",709247,57],["εἶχον",705785,137],["ἀναριθμήτους",701047,60],["οὐδὲ",709816,7],["γὰρ",702963,11],["πρὸς",710844,0],["τὸ",709436,24],["θάψαι",706103,106],["οἱ",709436,136],["ζῶντες",705851,146],["ἦσαν",704093,137],["ἱκανοί",706710,138],["ἐπεὶ",705054,7],["πρὸς",710844,0],["μίαν",704106,36],["ῥοπὴν",711294,9],["ἡ",709436,10],["ἐντιμοτέρα",704798,29],["γένεσις",703043,12],["αὐτῶν",702165,40],["διέφθαρτο",703624,361]],"So they all together had innumerable dead with one kind of death; neither were the living sufficient to bury them: for in one moment the noblest offspring of them was destroyed."],["13",[["πάντα",710177,68],["γὰρ",702963,11],["ἀπιστοῦντες",701411,146],["διὰ",703417,0],["τὰς",709436,38],["φαρμακείας",713368,39],["ἐπὶ",705080,0],["τῷ",709436,113],["τῶν",709436,43],["πρωτοτόκων",711046,83],["ὀλέθρῳ",709563,114],["ὡμολόγησαν",709632,150],["θεοῦ",706192,18],["υἱὸν",713075,6],["λαὸν",708094,6],["εἶναι",704093,55]],"For whereas they would not believe any thing by reason of the enchantments; upon the destruction of the firstborn, they acknowledged this people to be the sons of God."],["14",[["ἡσύχου",706037,82],["γὰρ",702963,11],["σιγῆς",711768,17],["περιεχούσης",710315,222],["τὰ",709436,41],["πάντα",710177,68],["καὶ",707031,7],["νυκτὸς",709386,17],["ἐν",704639,0],["ἰδίῳ",706493,97],["τάχει",712750,97],["μεσαζούσης",708755,222]],"For while all things were in quiet silence, and that night was in the midst of her swift course,"],["15",[["ὁ",709436,3],["παντοδύναμός",709983,14],["σου",711945,133],["λόγος",708236,4],["ἀπ᾿",701425,0],["οὐρανῶν",709844,81],["ἐκ",704132,0],["θρόνων",706315,81],["βασιλείων",702579,169],["ἀπότομος",701620,14],["πολεμιστὴς",710604,4],["εἰς",704105,0],["μέσον",708768,46],["τῆς",709436,16],["ὀλεθρίας",709562,82],["ἥλατο",700696,23],["γῆς",703083,17],["ξίφος",709423,25],["ὀξὺ",709682,46],["τὴν",709436,8],["ἀνυπόκριτον",701289,36],["ἐπιταγήν",705290,9],["σου",711945,133],["φέρων",713428,72]],"thine Almighty word leaped from heaven out of thy royal throne, as a fierce man of war into the midst of a land of destruction,"],["16",[["καὶ",707031,7],["στὰς",706846,182],["ἐπλήρωσεν",710543,2],["τὰ",709436,41],["πάντα",710177,68],["θανάτου",706096,18],["καὶ",707031,7],["οὐρανοῦ",709844,18],["μὲν",708730,11],["ἥπτετο",701654,19],["βεβήκει",702445,143],["δ᾿",703303,11],["ἐπὶ",705080,0],["γῆς",703083,17]],"and brought thine unfeigned commandment as a sharp sword, and standing up filled all things with death; and it touched the heaven, but it stood upon the earth."],["17",[["τότε",712908,28],["παραχρῆμα",710119,28],["φαντασίαι",713347,191],["μὲν",708730,11],["ὀνείρων",709659,81],["δεινῶν",703328,169],["ἐξετάραξαν",704319,150],["αὐτούς",702165,62],["φόβοι",713534,52],["δὲ",703303,11],["ἐπέστησαν",705756,150],["ἀδόκητοι",700279,138]],"Then suddenly visions of horrible dreams troubled them sore, and terrors came upon them unlooked for."],["18",[["καὶ",707031,7],["ἄλλος",700697,121],["ἀλλαχῇ",700684,1],["ῥιφεὶς",711267,217],["ἡμίθνητος",705992,14],["δι᾿",703417,0],["ἣν",709781,131],["ἔθνῃσκον",706278,137],["αἰτίαν",700492,9],["ἐνεφάνιζεν",704628,13]],"And one thrown here, and another there, half dead, shewed the cause of his death."],["19",[["οἱ",709436,136],["γὰρ",702963,11],["ὄνειροι",709659,52],["θορυβήσαντες",706292,196],["αὐτοὺς",702165,62],["τοῦτο",709858,129],["προεμήνυσαν",710823,150],["ἵνα",706747,7],["μὴ",708851,28],["ἀγνοοῦντες",700175,146],["δι᾿",703417,0],["ὃ",709781,128],["κακῶς",707074,28],["πάσχουσιν",710183,197],["ἀπόλωνται",701513,232]],"For the dreams that troubled them did foreshew this, lest they should perish, and not know why they were afflicted."],["20",[["ἥψατο",701654,23],["δὲ",703303,11],["καὶ",707031,28],["δικαίων",703694,169],["πεῖρα",710224,12],["θανάτου",706096,18],["καὶ",707031,7],["θραῦσις",706301,12],["ἐν",704639,0],["ἐρήμῳ",705420,1],["ἐγένετο",703104,23],["πλήθους",710529,21],["ἀλλ᾿",700680,7],["οὐκ",709805,28],["ἐπὶ",705080,0],["πολὺ",710646,46],["ἔμεινεν",708736,2],["ἡ",709436,10],["ὀργή",709728,12]],"Yea, the tasting of death touched the righteous also, and there was a destruction of the multitude in the wilderness: but the wrath endured not long."],["21",[["σπεύσας",712011,182],["γὰρ",702963,11],["ἀνὴρ",701150,4],["ἄμεμπτος",700807,14],["προεμάχησεν",710821,2],["τὸ",709436,24],["τῆς",709436,16],["ἰδίας",706493,82],["λειτουργίας",708135,17],["ὅπλον",709704,25],["προσευχὴν",710892,9],["καὶ",707031,7],["θυμιάματος",706330,21],["ἐξιλασμὸν",704934,6],["κομίσας",707805,182],["ἀντέστη",701154,2],["τῷ",709436,113],["θυμῷ",706334,114],["καὶ",707031,7],["πέρας",710281,15],["ἐπέθηκε",705304,2],["τῇ",709436,100],["συμφορᾷ",712357,1],["δεικνὺς",703314,72],["ὅτι",709803,7],["σός",711943,14],["ἐστιν",704093,91],["θεράπων",706201,4]],"For then the blameless man made haste, and stood forth to defend them; and bringing the shield of his proper ministry, even prayer, and the propitiation of incense, set himself against the wrath, and so brought the calamity to an end, declaring that he was thy servant."],["22",[["ἐνίκησεν",709309,2],["δὲ",703303,11],["τὸν",709436,5],["χόλον",713903,6],["οὐκ",709805,28],["ἰσχύι",706858,1],["τοῦ",709436,20],["σώματος",712635,21],["οὐχ",709805,28],["ὅπλων",709704,44],["ἐνεργείᾳ",704717,1],["ἀλλὰ",700680,7],["λόγῳ",708236,114],["τὸν",709436,5],["κολάζοντα",707786,183],["ὑπέταξεν",713250,2],["ὅρκους",709753,57],["πατέρων",710189,81],["καὶ",707031,7],["διαθήκας",703456,39],["ὑπομνήσας",713220,182]],"So he overcame the destroyer, not with might of body, nor force of arms, but with a word subdued him that punished, alleging the oaths and covenants made with the fathers."],["23",[["σωρηδὸν",712644,28],["γὰρ",702963,11],["ἤδη",705939,28],["πεπτωκότων",710481,387],["ἐπ᾿",705080,0],["ἀλλήλων",700689,40],["νεκρῶν",709247,81],["μεταξὺ",708811,28],["στὰς",706846,182],["ἀνέκοψε",700978,2],["τὴν",709436,8],["ὀργὴν",709728,9],["καὶ",707031,7],["διέσχισεν",703598,2],["τὴν",709436,8],["πρὸς",710844,0],["τοὺς",709436,58],["ζῶντας",705851,235],["ὁδόν",709458,9]],"For when the dead were now fallen down by heaps one upon another, standing between, he stayed the wrath, and parted the way to the living."],["24",[["ἐπὶ",705080,0],["γὰρ",702963,11],["ποδήρους",710577,92],["ἐνδύματος",704698,21],["ἦν",704093,13],["ὅλος",709597,14],["ὁ",709436,3],["κόσμος",707851,4],["καὶ",707031,7],["πατέρων",710189,81],["δόξαι",703791,191],["ἐπὶ",705080,0],["τετραστίχου",712825,82],["λίθων",708196,81],["γλυφῆς",703118,17],["καὶ",707031,7],["μεγαλωσύνη",708652,12],["σου",711945,133],["ἐπὶ",705080,0],["διαδήματος",703447,21],["κεφαλῆς",707639,17],["αὐτοῦ",702165,102]],"For in the long garment was the whole world, and in the four rows of the stones was the glory of the fathers graven, and thy Majesty upon the diadem of his head."],["25",[["τούτοις",709858,206],["εἶξεν",704088,2],["ὁ",709436,3],["ὀλεθρεύων",709560,72],["ταῦτα",709858,71],["δὲ",703303,11],["ἐφοβήθη",713532,37],["ἦν",704093,13],["γὰρ",702963,11],["μόνη",709003,29],["ἡ",709436,10],["πεῖρα",710224,12],["τῆς",709436,16],["ὀργῆς",709728,17],["ἱκανή",706710,29]],"Unto these the destroyer gave place, and they were afraid of them: for it was enough that they only tasted of the wrath."]]