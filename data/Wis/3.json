[["1",[["δικαίων",703694,169],["δὲ",703303,11],["ψυχαὶ",714070,191],["ἐν",704639,0],["χειρὶ",713787,1],["θεοῦ",706192,18],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἅψηται",701654,239],["αὐτῶν",702165,40],["βάσανος",702570,12]],"But the souls of the righteous are in the hand of God, and there shall no torment touch them."],["2",[["ἔδοξαν",703775,2],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["ἀφρόνων",702236,169],["τεθνάναι",706278,115],["καὶ",707031,7],["ἐλογίσθη",708232,37],["κάκωσις",707075,12],["ἡ",709436,10],["ἔξοδος",704948,12],["αὐτῶν",702165,40]],"In the sight of the unwise they seemed to die: and their departure is taken for misery,",{"s":"d","q":0.45}],["3",[["καὶ",707031,7],["ἡ",709436,10],["ἀφ᾿",701425,0],["ἡμῶν",705999,145],["πορεία",710665,12],["σύντριμμα",712521,25],["οἱ",709436,136],["δέ",703303,11],["εἰσιν",704093,197],["ἐν",704639,0],["εἰρήνῃ",704098,1]],"and their going from us to be utter destruction: but they are in peace.",{"s":"d","q":0.59}],["4",[["καὶ",707031,7],["γὰρ",702963,11],["ἐν",704639,0],["ὄψει",709901,1],["ἀνθρώπων",701163,81],["ἐὰν",703912,7],["κολασθῶσιν",707786,272],["ἡ",709436,10],["ἐλπὶς",704530,12],["αὐτῶν",702165,40],["ἀθανασίας",700357,17],["πλήρης",710541,14]],"For though they be punished in the sight of men, yet is their hope full of immortality."],["5",[["καὶ",707031,7],["ὀλίγα",709568,68],["παιδευθέντες",709926,247],["μεγάλα",708653,68],["εὐεργετηθήσονται",705575,144],["ὅτι",709803,7],["ὁ",709436,3],["θεὸς",706192,4],["ἐπείρασεν",710225,2],["αὐτοὺς",702165,62],["καὶ",707031,7],["εὗρεν",705676,2],["αὐτοὺς",702165,62],["ἀξίους",701308,60],["ἑαυτοῦ",703917,102]],"And having been a little chastised, they shall be greatly rewarded: for God proved them, and found them worthy for himself."],["6",[["ὡς",714148,28],["χρυσὸν",713975,27],["ἐν",704639,0],["χωνευτηρίῳ",714007,54],["ἐδοκίμασεν",703776,2],["αὐτοὺς",702165,62],["καὶ",707031,7],["ὡς",714148,28],["ὁλοκάρπωμα",709586,25],["θυσίας",706345,17],["προσεδέξατο",710874,23],["αὐτούς",702165,62]],"As gold in the furnace hath he tried them, and received them as a burnt offering."],["7",[["καὶ",707031,7],["ἐν",704639,0],["καιρῷ",707047,114],["ἐπισκοπῆς",705255,17],["αὐτῶν",702165,40],["ἀναλάμψουσιν",700985,218],["καὶ",707031,7],["ὡς",714148,28],["σπινθῆρες",712015,57],["ἐν",704639,0],["καλάμῃ",707079,1],["διαδραμοῦνται",703614,135]],"And in the time of their visitation they shall shine, and run to and fro like sparks among the stubble."],["8",[["κρινοῦσιν",707905,218],["ἔθνη",704068,42],["καὶ",707031,7],["κρατήσουσιν",707879,218],["λαῶν",708094,81],["καὶ",707031,7],["βασιλεύσει",702581,127],["αὐτῶν",702165,40],["κύριος",707996,4],["εἰς",704105,0],["τοὺς",709436,58],["αἰῶνας",700504,57]],"They shall judge the nations, and have dominion over the people, and their Lord shall reign for ever."],["9",[["οἱ",709436,136],["πεποιθότες",710221,268],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["συνήσουσιν",712481,218],["ἀλήθειαν",700656,9],["καὶ",707031,7],["οἱ",709436,136],["πιστοὶ",710486,138],["ἐν",704639,0],["ἀγάπῃ",700122,1],["προσμενοῦσιν",710934,218],["αὐτῷ",702165,50],["ὅτι",709803,7],["χάρις",713735,12],["καὶ",707031,7],["ἔλεος",704426,4],["τοῖς",709436,147],["ἐκλεκτοῖς",704240,230],["αὐτοῦ",702165,102]],"They that put their trust in him shall understand the truth: and such as be faithful in love shall abide with him: for grace and mercy is to his saints, and he hath care for his elect."],["10",[["οἱ",709436,136],["δὲ",703303,11],["ἀσεβεῖς",701909,138],["καθὰ",706979,28],["ἐλογίσαντο",708232,189],["ἕξουσιν",705785,218],["ἐπιτιμίαν",705307,9],["οἱ",709436,136],["ἀμελήσαντες",700803,196],["τοῦ",709436,35],["δικαίου",703694,116],["καὶ",707031,7],["τοῦ",709436,35],["κυρίου",707996,18],["ἀποστάντες",702214,196]],"But the ungodly shall be punished according to their own imaginations, which have neglected the righteous, and forsaken the Lord."],["11",[["σοφίαν",711981,9],["γὰρ",702963,11],["καὶ",707031,7],["παιδείαν",709924,9],["ὁ",709436,3],["ἐξουθενῶν",704969,72],["ταλαίπωρος",712696,14],["καὶ",707031,7],["κενὴ",707612,29],["ἡ",709436,10],["ἐλπὶς",704530,12],["αὐτῶν",702165,40],["καὶ",707031,7],["οἱ",709436,136],["κόποι",707825,52],["ἀνόνητοι",701196,138],["καὶ",707031,7],["ἄχρηστα",702312,195],["τὰ",709436,63],["ἔργα",705396,64],["αὐτῶν",702165,40]],"For whoso despiseth wisdom and nurture, he is miserable, and their hope is vain, their labours unfruitful, and their works unprofitable:"],["12",[["αἱ",709436,190],["γυναῖκες",703209,191],["αὐτῶν",702165,40],["ἄφρονες",702236,192],["καὶ",707031,7],["πονηρὰ",710660,195],["τὰ",709436,63],["τέκνα",712761,64],["αὐτῶν",702165,40],["ἐπικατάρατος",705159,14],["ἡ",709436,10],["γένεσις",703043,12],["αὐτῶν",702165,40]],"their wives are foolish, and their children wicked:"],["13",[["ὅτι",709803,7],["μακαρία",708397,29],["στεῖρα",712060,12],["ἡ",709436,10],["ἀμίαντος",700821,29],["ἥτις",709793,412],["οὐκ",709805,28],["ἔγνω",703105,2],["κοίτην",707781,9],["ἐν",704639,0],["παραπτώματι",710095,54],["ἕξει",704937,1],["καρπὸν",707169,6],["ἐν",704639,0],["ἐπισκοπῇ",705255,1],["ψυχῶν",714070,65]],"Their offspring is cursed. Wherefore blessed is the barren that is undefiled, which hath not known the sinful bed: she shall have fruit in the visitation of souls."],["14",[["καὶ",707031,7],["εὐνοῦχος",705651,4],["ὁ",709436,3],["μὴ",708851,28],["ἐργασάμενος",705383,248],["ἐν",704639,0],["χειρὶ",713787,1],["ἀνόμημα",701191,25],["μηδὲ",708855,7],["ἐνθυμηθεὶς",704739,217],["κατὰ",707200,0],["τοῦ",709436,35],["κυρίου",707996,18],["πονηρά",710660,68],["δοθήσεται",703654,134],["γὰρ",702963,11],["αὐτῷ",702165,50],["τῆς",709436,16],["πίστεως",710484,17],["χάρις",713735,12],["ἐκλεκτὴ",704240,29],["καὶ",707031,7],["κλῆρος",707727,4],["ἐν",704639,0],["ναῷ",709191,114],["κυρίου",707996,18],["θυμηρέστερος",706328,224]],"And [blessed is] the eunuch, which with his hands hath wrought no iniquity, nor imagined wicked things against God: for unto him shall be given the special gift of faith, and an inheritance in the temple of the Lord more acceptable to his mind."],["15",[["ἀγαθῶν",700106,169],["γὰρ",702963,11],["πόνων",710661,81],["καρπὸς",707169,4],["εὐκλεής",705617,14],["καὶ",707031,7],["ἀδιάπτωτος",700262,29],["ἡ",709436,10],["ῥίζα",711260,12],["τῆς",709436,16],["φρονήσεως",713588,17]],"For glorious is the fruit of good labours: and the root of wisdom shall never fall away."],["16",[["τέκνα",712761,64],["δὲ",703303,11],["μοιχῶν",708980,81],["ἀτέλεστα",702083,195],["ἔσται",704093,93],["καὶ",707031,7],["ἐκ",704132,0],["παρανόμου",710080,82],["κοίτης",707781,17],["σπέρμα",712008,15],["ἀφανισθήσεται",702182,134]],"As for the children of adulterers, they shall not come to their perfection, and the seed of an unrighteous bed shall be rooted out."],["17",[["ἐάν",703912,7],["τε",712751,11],["γὰρ",702963,11],["μακρόβιοι",708412,138],["γένωνται",703104,232],["εἰς",704105,0],["οὐθὲν",709817,46],["λογισθήσονται",708232,144],["καὶ",707031,7],["ἄτιμον",702095,27],["ἐπ᾿",705080,0],["ἐσχάτων",705519,169],["τὸ",709436,24],["γῆρας",703089,25],["αὐτῶν",702165,40]],"For though they live long, yet shall they be nothing regarded: and their last age shall be without honour."],["18",[["ἐάν",703912,7],["τε",712751,11],["ὀξέως",709677,28],["τελευτήσωσιν",712781,234],["οὐχ",709805,28],["ἕξουσιν",705785,218],["ἐλπίδα",704530,9],["οὐδὲ",709816,7],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["διαγνώσεως",703437,17],["παραμύθιον",710074,25]],"Or, if they die quickly, they have no hope, neither comfort in the day of trial."],["19",[["γενεᾶς",703037,17],["γὰρ",702963,11],["ἀδίκου",700272,82],["χαλεπὰ",713682,195],["τὰ",709436,63],["τέλη",712787,64]],"For horrible is the end of the unrighteous generation."]]