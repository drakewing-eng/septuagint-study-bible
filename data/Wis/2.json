[["1",[["εἶπον",705373,150],["γὰρ",702963,11],["ἐν",704639,0],["ἑαυτοῖς",703917,151],["λογισάμενοι",708232,317],["οὐκ",709805,28],["ὀρθῶς",709746,28],["ὀλίγος",709568,14],["ἐστὶν",704093,91],["καὶ",707031,7],["λυπηρὸς",708274,14],["ὁ",709436,3],["βίος",702724,4],["ἡμῶν",705999,145],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἴασις",706444,12],["ἐν",704639,0],["τελευτῇ",712782,1],["ἀνθρώπου",701163,18],["καὶ",707031,7],["οὐκ",709805,28],["ἐγνώσθη",703105,37],["ὁ",709436,3],["ἀναλύσας",700995,182],["ἐξ",704132,0],["ᾅδου",700255,18]],"For [the ungodly] said, reasoning with themselves, [but] not aright, Our life is short and tedious, and in the death of a man there is no remedy: neither was there any man known to have returned from the grave."],["2",[["ὅτι",709803,7],["αὐτοσχεδίως",702166,28],["ἐγενήθημεν",703104,485],["καὶ",707031,7],["μετὰ",708780,0],["τοῦτο",709858,129],["ἐσόμεθα",704093,141],["ὡς",714148,28],["οὐχ",709805,28],["ὑπάρξαντες",713104,196],["ὅτι",709803,7],["καπνὸς",707132,4],["ἡ",709436,10],["πνοὴ",710574,12],["ἐν",704639,0],["ῥισὶν",711268,76],["ἡμῶν",705999,145],["καὶ",707031,7],["ὁ",709436,3],["λόγος",708236,4],["σπινθὴρ",712015,12],["ἐν",704639,0],["κινήσει",707681,1],["καρδίας",707141,17],["ἡμῶν",705999,145]],"For we are born at all adventure: and we shall be hereafter as though we had never been: for the breath in our nostrils is as smoke, and a little spark in the moving of our heart:"],["3",[["οὗ",709781,48],["σβεσθέντος",711596,319],["τέφρα",712827,12],["ἀποβήσεται",701426,93],["τὸ",709436,24],["σῶμα",712635,25],["καὶ",707031,7],["τὸ",709436,34],["πνεῦμα",710566,15],["διαχυθήσεται",703636,134],["ὡς",714148,28],["χαῦνος",713772,14],["ἀήρ",700354,4]],"which being extinguished, our body shall be turned to ashes, and our spirit shall vanish as the soft air,"],["4",[["καὶ",707031,7],["τὸ",709436,34],["ὄνομα",709666,15],["ἡμῶν",705999,145],["ἐπιλησθήσεται",705187,134],["ἐν",704639,0],["χρόνῳ",713969,114],["καὶ",707031,7],["οὐθεὶς",709817,14],["μνημονεύσει",708965,127],["τῶν",709436,43],["ἔργων",705396,44],["ἡμῶν",705999,145],["καὶ",707031,7],["παρελεύσεται",710141,93],["ὁ",709436,3],["βίος",702724,4],["ἡμῶν",705999,145],["ὡς",714148,28],["ἴχνη",706873,64],["νεφέλης",709277,17],["καὶ",707031,7],["ὡς",714148,28],["ὁμίχλη",709615,12],["διασκεδασθήσεται",703575,134],["διωχθεῖσα",703768,307],["ὑπὸ",713184,0],["ἀκτίνων",700615,65],["ἡλίου",705974,18],["καὶ",707031,7],["ὑπὸ",713184,0],["θερμότητος",706218,17],["αὐτοῦ",702165,102],["βαρυνθεῖσα",702553,307]],"and our name shall be forgotten in time, and no man shall have our works in remembrance, and our life shall pass away as the trace of a cloud, and shall be dispersed as a mist, that is driven away with the beams of the sun, and overcome with the heat thereof."],["5",[["σκιᾶς",711852,17],["γὰρ",702963,11],["πάροδος",710154,12],["ὁ",709436,3],["καιρὸς",707047,4],["ἡμῶν",705999,145],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀναποδισμὸς",701039,4],["τῆς",709436,16],["τελευτῆς",712782,17],["ἡμῶν",705999,145],["ὅτι",709803,7],["κατεσφραγίσθη",707450,37],["καὶ",707031,7],["οὐδεὶς",709817,14],["ἀναστρέφει",701060,91]],"For our time is a very shadow that passeth away; and after our end there is no returning: for it is fast sealed, so that no man cometh again."],["6",[["δεῦτε",703383,28],["οὖν",709835,11],["καὶ",707031,7],["ἀπολαύσωμεν",701506,79],["τῶν",709436,43],["ὄντων",704093,84],["ἀγαθῶν",700106,83],["καὶ",707031,7],["χρησώμεθα",713937,276],["τῇ",709436,100],["κτίσει",707939,1],["ὡς",714148,28],["ἐν",704639,0],["νεότητι",709258,1],["σπουδαίως",712034,28]],"Come on therefore, let us enjoy the good things that are present: and let us speedily use the creatures like as in youth."],["7",[["οἴνου",709530,18],["πολυτελοῦς",710647,116],["καὶ",707031,7],["μύρων",709072,44],["πλησθῶμεν",710532,283],["καὶ",707031,7],["μὴ",708851,28],["παροδευσάτω",710153,45],["ἡμᾶς",705981,194],["ἄνθος",701157,25],["ἔαρος",703914,21]],"Let us fill ourselves with costly wine and ointments: and let no flower of the spring pass by us."],["8",[["στεψώμεθα",712087,276],["ῥόδων",711281,44],["κάλυξιν",707100,76],["πρὶν",710742,28],["ἢ",705924,7],["μαρανθῆναι",708497,179]],"Let us crown ourselves with rosebuds, before they be withered:"],["9",[["μηδεὶς",708857,14],["ἡμῶν",705999,145],["ἄμοιρος",700857,14],["ἔστω",704093,31],["τῆς",709436,16],["ἡμετέρας",705987,82],["ἀγερωχίας",700150,17],["πανταχῇ",709976,28],["καταλίπωμεν",707305,79],["σύμβολα",712289,42],["τῆς",709436,16],["εὐφροσύνης",705717,17],["ὅτι",709803,7],["αὕτη",709858,107],["ἡ",709436,10],["μερὶς",708748,12],["ἡμῶν",705999,145],["καὶ",707031,7],["ὁ",709436,3],["κλῆρος",707727,4],["οὗτος",709858,121]],"let none of us go without his part of our voluptuousness: let us leave tokens of our joyfulness in every place: for this is our portion, and our lot is this."],["10",[["καταδυναστεύσωμεν",707248,79],["πένητα",710248,6],["δίκαιον",703694,27],["μὴ",708851,28],["φεισώμεθα",713406,276],["χήρας",713848,17],["μηδὲ",708855,7],["πρεσβύτου",710736,18],["ἐντραπῶμεν",704805,79],["πολιὰς",710607,39],["πολυχρονίους",710652,119]],"Let us oppress the poor righteous man, let us not spare the widow, nor reverence the ancient grey hairs of the aged."],["11",[["ἔστω",704093,31],["δὲ",703303,11],["ἡμῶν",705999,145],["ἡ",709436,10],["ἰσχὺς",706858,12],["νόμος",709349,4],["τῆς",709436,16],["δικαιοσύνης",703695,17],["τὸ",709436,34],["γὰρ",702963,11],["ἀσθενὲς",701939,26],["ἄχρηστον",702312,26],["ἐλέγχεται",704416,117]],"Let our strength be the law of justice: for that which is feeble is found to be nothing worth."],["12",[["ἐνεδρεύσωμεν",704703,79],["τὸν",709436,5],["δίκαιον",703694,27],["ὅτι",709803,7],["δύσχρηστος",703883,14],["ἡμῖν",705994,90],["ἐστιν",704093,91],["καὶ",707031,7],["ἐναντιοῦται",704655,117],["τοῖς",709436,95],["ἔργοις",705396,96],["ἡμῶν",705999,145],["καὶ",707031,7],["ὀνειδίζει",709655,91],["ἡμῖν",705994,90],["ἁμαρτήματα",700774,42],["νόμου",709349,18],["καὶ",707031,7],["ἐπιφημίζει",705323,91],["ἡμῖν",705994,90],["ἁμαρτήματα",700774,42],["παιδείας",709924,17],["ἡμῶν",705999,145]],"Therefore let us lie in wait for the righteous; because he is not for our turn, and he is clean contrary to our doings: he upbraideth us with our offending the law, and objecteth to our infamy the transgressings of our education."],["13",[["ἐπαγγέλλεται",704992,117],["γνῶσιν",703138,9],["ἔχειν",705785,55],["θεοῦ",706192,18],["καὶ",707031,7],["παῖδα",709932,6],["κυρίου",707996,18],["ἑαυτὸν",703917,85],["ὀνομάζει",709667,91]],"He professeth to have the knowledge of God: and he calleth himself the child of the Lord."],["14",[["ἐγένετο",703104,23],["ἡμῖν",705994,90],["εἰς",704105,0],["ἔλεγχον",704415,6],["ἐννοιῶν",704764,65],["ἡμῶν",705999,145],["βαρύς",702554,14],["ἐστιν",704093,91],["ἡμῖν",705994,90],["καὶ",707031,7],["βλεπόμενος",702740,122]],"He was made to reprove our thoughts.",{"s":"d","q":0.55}],["15",[["ὅτι",709803,7],["ἀνόμοιος",701193,14],["τοῖς",709436,147],["ἄλλοις",700697,151],["ὁ",709436,3],["βίος",702724,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐξηλλαγμέναι",704854,423],["αἱ",709436,190],["τρίβοι",712939,191],["αὐτοῦ",702165,102]],"He is grievous unto us even to behold: for his life is not like other men's, his ways are of another fashion."],["16",[["εἰς",704105,0],["κίβδηλον",707666,46],["ἐλογίσθημεν",708232,485],["αὐτῷ",702165,50],["καὶ",707031,7],["ἀπέχεται",701225,117],["τῶν",709436,130],["ὁδῶν",709458,65],["ἡμῶν",705999,145],["ὡς",714148,28],["ἀπὸ",701425,0],["ἀκαθαρσιῶν",700507,65],["μακαρίζει",708396,91],["ἔσχατα",705519,68],["δικαίων",703694,169],["καὶ",707031,7],["ἀλαζονεύεται",700628,117],["πατέρα",710189,6],["θεόν",706192,6]],"We are esteemed of him as counterfeits: he abstaineth from our ways as from filthiness: he pronounceth the end of the just to be blessed, and maketh his boast that God is his father."],["17",[["ἴδωμεν",709725,79],["εἰ",704071,7],["οἱ",709436,136],["λόγοι",708236,52],["αὐτοῦ",702165,102],["ἀληθεῖς",700658,138],["καὶ",707031,7],["πειράσωμεν",710225,79],["τὰ",709436,41],["ἐν",704639,0],["ἐκβάσει",704146,1],["αὐτοῦ",702165,102]],"Let us see if his words be true: and let us prove what shall happen in the end of him."],["18",[["εἰ",704071,7],["γάρ",702963,11],["ἐστιν",704093,91],["ὁ",709436,3],["δίκαιος",703694,14],["υἱὸς",713075,4],["θεοῦ",706192,18],["ἀντιλήμψεται",701243,93],["αὐτοῦ",702165,102],["καὶ",707031,7],["ῥύσεται",711309,93],["αὐτὸν",702165,85],["ἐκ",704132,0],["χειρὸς",713787,17],["ἀνθεστηκότων",701154,387]],"For if the just man be the son of God, he will help him, and deliver him from the hand of his enemies."],["19",[["ὕβρει",713051,1],["καὶ",707031,7],["βασάνῳ",702570,1],["ἐτάσωμεν",705526,79],["αὐτόν",702165,85],["ἵνα",706747,7],["γνῶμεν",703105,79],["τὴν",709436,8],["ἐπιείκειαν",705127,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["δοκιμάσωμεν",703776,79],["τὴν",709436,8],["ἀνεξικακίαν",701128,9],["αὐτοῦ",702165,102]],"Let us examine him with despitefulness and torture, that we may know his meekness, and prove his patience."],["20",[["θανάτῳ",706096,114],["ἀσχήμονι",702055,30],["καταδικάσωμεν",707241,79],["αὐτόν",702165,85],["ἔσται",704093,93],["γὰρ",702963,11],["αὐτοῦ",702165,102],["ἐπισκοπὴ",705255,12],["ἐκ",704132,0],["λόγων",708236,81],["αὐτοῦ",702165,102]],"Let us condemn him with a shameful death: for by his own saying he shall be respected."],["21",[["ταῦτα",709858,71],["ἐλογίσαντο",708232,189],["καὶ",707031,7],["ἐπλανήθησαν",710495,99],["ἀπετύφλωσεν",701629,2],["γὰρ",702963,11],["αὐτοὺς",702165,62],["ἡ",709436,10],["κακία",707054,12],["αὐτῶν",702165,40]],"Such things they did imagine, and were deceived: for their own wickedness hath blinded them."],["22",[["καὶ",707031,7],["οὐκ",709805,28],["ἔγνωσαν",703105,150],["μυστήρια",709080,42],["θεοῦ",706192,18],["οὐδὲ",709816,7],["μισθὸν",708939,6],["ἤλπισαν",704529,150],["ὁσιότητος",709783,17],["οὐδὲ",709816,7],["ἔκριναν",707905,150],["γέρας",703061,15],["ψυχῶν",714070,65],["ἀμώμων",700895,198]],"As for the mysteries of God, they knew them not: neither hoped they for the wages of righteousness, nor discerned a reward for blameless souls."],["23",[["ὅτι",709803,7],["ὁ",709436,3],["θεὸς",706192,4],["ἔκτισεν",707938,2],["τὸν",709436,5],["ἄνθρωπον",701163,6],["ἐπ᾿",705080,0],["ἀφθαρσίᾳ",702205,1],["καὶ",707031,7],["εἰκόνα",704089,9],["τῆς",709436,16],["ἰδίας",706493,82],["ἀϊδιότητος",700407,17],["ἐποίησεν",710582,2],["αὐτόν",702165,85]],"For God created man to be immortal, and made him to be an image of his own eternity."],["24",[["φθόνῳ",713450,114],["δὲ",703303,11],["διαβόλου",703428,18],["θάνατος",706096,4],["εἰσῆλθεν",704114,2],["εἰς",704105,0],["τὸν",709436,5],["κόσμον",707851,6],["πειράζουσιν",710225,197],["δὲ",703303,11],["αὐτὸν",702165,85],["οἱ",709436,136],["τῆς",709436,16],["ἐκείνου",704183,102],["μερίδος",708748,17],["ὄντες",704093,146]],"Nevertheless through envy of the devil came death into the world: and they that are of his side do find it."]]