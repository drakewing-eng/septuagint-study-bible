[["1",[["κρείσσων",707891,14],["ἀτεκνία",702079,12],["μετὰ",708780,0],["ἀρετῆς",701727,17],["ἀθανασία",700357,12],["γάρ",702963,11],["ἐστιν",704093,91],["ἐν",704639,0],["μνήμῃ",708964,1],["αὐτῆς",702165,86],["ὅτι",709803,7],["καὶ",707031,7],["παρὰ",709995,0],["θεῷ",706192,114],["γινώσκεται",703105,117],["καὶ",707031,7],["παρὰ",709995,0],["ἀνθρώποις",701163,148]],"Better it is to have no children, and to have virtue: for the memorial thereof is immortal: because it is known with God, and with men."],["2",[["παροῦσάν",710126,78],["τε",712751,11],["μιμοῦνται",708921,269],["αὐτὴν",702165,104],["καὶ",707031,7],["ποθοῦσιν",710581,197],["ἀπελθοῦσαν",701398,610],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["αἰῶνι",700504,114],["στεφανηφοροῦσα",712082,188],["πομπεύει",710655,91],["τὸν",709436,5],["τῶν",709436,80],["ἀμιάντων",700821,169],["ἄθλων",700379,44],["ἀγῶνα",700211,6],["νικήσασα",709309,149]],"When it is present, men take example at it; and when it is gone, they desire it: it weareth a crown, and triumpheth for ever, having gotten the victory, striving for undefiled rewards."],["3",[["πολύγονον",710622,26],["δὲ",703303,11],["ἀσεβῶν",701909,169],["πλῆθος",710529,15],["οὐ",709805,28],["χρησιμεύσει",713952,127],["καὶ",707031,7],["ἐκ",704132,0],["νόθων",709332,83],["μοσχευμάτων",709028,44],["οὐ",709805,28],["δώσει",703654,127],["ῥίζαν",711260,9],["εἰς",704105,0],["βάθος",702376,25],["οὐδὲ",709816,7],["ἀσφαλῆ",702040,195],["βάσιν",702585,9],["ἑδράσει",704037,127]],"But the multiplying brood of the ungodly shall not thrive, nor take deep rooting from bastard slips, nor lay any fast foundation."],["4",[["κἂν",707120,459],["γὰρ",702963,11],["ἐν",704639,0],["κλάδοις",707702,148],["πρὸς",710844,0],["καιρὸν",707047,6],["ἀναθάλῃ",700949,172],["ἐπισφαλῶς",705287,28],["βεβηκότα",702445,427],["ὑπὸ",713184,0],["ἀνέμου",701123,18],["σαλευθήσεται",711403,134],["καὶ",707031,7],["ὑπὸ",713184,0],["βίας",702712,17],["ἀνέμων",701123,81],["ἐκριζωθήσεται",704303,134]],"For though they flourish in branches for a time; yet standing not fast, they shall be shaken with the wind, and through the force of winds they shall be rooted out."],["5",[["περικλασθήσονται",710332,144],["κλῶνες",707747,52],["ἀτέλεστοι",702083,138],["καὶ",707031,7],["ὁ",709436,3],["καρπὸς",707169,4],["αὐτῶν",702165,40],["ἄχρηστος",702312,14],["ἄωρος",702329,14],["εἰς",704105,0],["βρῶσιν",702825,9],["καὶ",707031,7],["εἰς",704105,0],["οὐθὲν",709817,46],["ἐπιτήδειος",705300,14]],"The imperfect branches shall be broken off, their fruit unprofitable, not ripe to eat, yea, meet for nothing."],["6",[["ἐκ",704132,0],["γὰρ",702963,11],["ἀνόμων",701194,169],["ὕπνων",713181,81],["τέκνα",712761,42],["γεννώμενα",703051,67],["μάρτυρές",708527,52],["εἰσιν",704093,197],["πονηρίας",710659,17],["κατὰ",707200,0],["γονέων",703169,81],["ἐν",704639,0],["ἐξετασμῷ",704913,114],["αὐτῶν",702165,40]],"For children begotten of unlawful beds are witnesses of wickedness against their parents in their trial."],["7",[["δίκαιος",703694,14],["δὲ",703303,11],["ἐὰν",703912,7],["φθάσῃ",713439,172],["τελευτῆσαι",712781,106],["ἐν",704639,0],["ἀναπαύσει",701026,1],["ἔσται",704093,93]],"But though the righteous be prevented with death, yet shall he be in rest."],["8",[["γῆρας",703089,25],["γὰρ",702963,11],["τίμιον",712858,26],["οὐ",709805,28],["τὸ",709436,34],["πολυχρόνιον",710652,26],["οὐδὲ",709816,7],["ἀριθμῷ",701744,114],["ἐτῶν",705543,44],["μεμέτρηται",708840,187]],"For honourable age is not that which standeth in length of time, nor that is measured by number of years."],["9",[["πολιὰ",710607,12],["δέ",703303,11],["ἐστιν",704093,91],["φρόνησις",713588,12],["ἀνθρώποις",701163,148],["καὶ",707031,7],["ἡλικία",705971,12],["γήρως",703089,21],["βίος",702724,4],["ἀκηλίδωτος",700540,14]],"But wisdom is the grey hair unto men, and an unspotted life is old age."],["10",[["εὐάρεστος",705555,14],["θεῷ",706192,114],["γενόμενος",703104,248],["ἠγαπήθη",700120,37],["καὶ",707031,7],["ζῶν",705851,72],["μεταξὺ",708811,28],["ἁμαρτωλῶν",700776,169],["μετετέθη",708820,37]],"He pleased God, and was beloved of him: so that living among sinners he was translated."],["11",[["ἡρπάγη",701804,37],["μὴ",708851,28],["κακία",707054,12],["ἀλλάξῃ",700683,123],["σύνεσιν",712460,9],["αὐτοῦ",702165,102],["ἢ",705924,7],["δόλος",703787,4],["ἀπατήσῃ",701364,123],["ψυχὴν",714070,9],["αὐτοῦ",702165,102]],"Yea, speedily was he taken away, lest that wickedness should alter his understanding, or deceit beguile his soul."],["12",[["βασκανία",702588,12],["γὰρ",702963,11],["φαυλότητος",713399,17],["ἀμαυροῖ",700786,138],["τὰ",709436,63],["καλά",707097,195],["καὶ",707031,7],["ῥεμβασμὸς",711226,4],["ἐπιθυμίας",705147,17],["μεταλλεύει",708802,91],["νοῦν",709374,6],["ἄκακον",700512,27]],"For the bewitching of naughtiness doth obscure things that are honest; and the wandering of concupiscence doth undermine the simple mind."],["13",[["τελειωθεὶς",712771,217],["ἐν",704639,0],["ὀλίγῳ",709568,97],["ἐπλήρωσεν",710543,2],["χρόνους",713969,57],["μακρούς",708421,60]],"He, being made perfect in a short time, fulfilled a long time:"],["14",[["ἀρεστὴ",701723,29],["γὰρ",702963,11],["ἦν",704093,13],["κυρίῳ",707996,114],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτοῦ",702165,102],["διὰ",703417,0],["τοῦτο",709858,129],["ἔσπευσεν",712011,2],["ἐκ",704132,0],["μέσου",708768,92],["πονηρίας",710659,17],["οἱ",709436,136],["δὲ",703303,11],["λαοὶ",708094,52],["ἰδόντες",709725,196],["καὶ",707031,7],["μὴ",708851,28],["νοήσαντες",709327,196],["μηδὲ",708855,7],["θέντες",712849,196],["ἐπὶ",705080,0],["διανοίᾳ",703531,1],["τὸ",709436,24],["τοιοῦτο",712878,46]],"for his soul pleased the Lord: therefore hasted he [to take him away] from among the wicked.",{"s":"d","q":0.5}],["15",[["ὅτι",709803,7],["χάρις",713735,12],["καὶ",707031,7],["ἔλεος",704426,4],["ἐν",704639,0],["τοῖς",709436,147],["ἐκλεκτοῖς",704240,230],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπισκοπὴ",705255,12],["ἐν",704639,0],["τοῖς",709436,147],["ὁσίοις",709782,230],["αὐτοῦ",702165,102]],"This the people saw, and understood not, neither laid they up this in their minds, That his grace and mercy is with his saints, and that he hath respect unto his chosen.",{"s":"d","q":0.54}],["16",[["κατακρινεῖ",707289,127],["δὲ",703303,11],["δίκαιος",703694,14],["καμὼν",707115,182],["τοὺς",709436,58],["ζῶντας",705851,235],["ἀσεβεῖς",701909,138],["καὶ",707031,7],["νεότης",709258,12],["τελεσθεῖσα",712783,307],["ταχέως",712743,28],["πολυετὲς",710625,92],["γῆρας",703089,25],["ἀδίκου",700272,116]],"Thus the righteous that is dead shall condemn the ungodly which are living; and youth that is soon perfected the many years and old age of the unrighteous."],["17",[["ὄψονται",709725,135],["γὰρ",702963,11],["τελευτὴν",712782,9],["σοφοῦ",711985,116],["καὶ",707031,7],["οὐ",709805,28],["νοήσουσιν",709327,218],["τί",712867,126],["ἐβουλεύσατο",702791,23],["περὶ",710285,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἰς",704105,0],["τί",712867,126],["ἠσφαλίσατο",702041,23],["αὐτὸν",702165,85],["ὁ",709436,3],["κύριος",707996,4]],"For they shall see the end of the wise, and shall not understand what God in his counsel hath decreed of him, and to what end the Lord hath set him in safety."],["18",[["ὄψονται",709725,135],["καὶ",707031,7],["ἐξουθενήσουσιν",704969,218],["αὐτοὺς",702165,62],["δὲ",703303,11],["ὁ",709436,3],["κύριος",707996,4],["ἐκγελάσεται",704157,93]],"They shall see him, and despise him; but God shall laugh them to scorn; and they shall hereafter be a vile carcase, and a reproach among the dead for evermore.",{"s":"d","q":0.36}],["19",[["καὶ",707031,7],["ἔσονται",704093,135],["μετὰ",708780,0],["τοῦτο",709858,129],["εἰς",704105,0],["πτῶμα",711071,25],["ἄτιμον",702095,27],["καὶ",707031,7],["εἰς",704105,0],["ὕβριν",713051,9],["ἐν",704639,0],["νεκροῖς",709247,148],["δι᾿",703417,0],["αἰῶνος",700504,18],["ὅτι",709803,7],["ῥήξει",711243,127],["αὐτοὺς",702165,62],["ἀφώνους",702242,60],["πρηνεῖς",710739,57],["καὶ",707031,7],["σαλεύσει",711403,127],["αὐτοὺς",702165,62],["ἐκ",704132,0],["θεμελίων",706181,44],["καὶ",707031,7],["ἕως",705792,7],["ἐσχάτου",705519,116],["χερσωθήσονται",713833,144],["καὶ",707031,7],["ἔσονται",704093,135],["ἐν",704639,0],["ὀδύνῃ",709463,1],["καὶ",707031,7],["ἡ",709436,10],["μνήμη",708964,12],["αὐτῶν",702165,40],["ἀπολεῖται",701513,93]],"For he shall rend them, and cast them down headlong, that they shall be speechless; and he shall shake them from the foundation; and they shall be utterly laid waste, and be in sorrow; and their memorial shall perish.",{"s":"d","q":0.64}],["20",[["ἐλεύσονται",705453,135],["ἐν",704639,0],["συλλογισμῷ",712268,114],["ἁμαρτημάτων",700774,44],["αὐτῶν",702165,40],["δειλοί",703324,138],["καὶ",707031,7],["ἐλέγξει",704416,127],["αὐτοὺς",702165,62],["ἐξ",704132,0],["ἐναντίας",704656,82],["τὰ",709436,41],["ἀνομήματα",701191,42],["αὐτῶν",702165,40]],"And when they cast up the account of their sins, they shall come with fear: and their own iniquities shall convince them to their face."]]