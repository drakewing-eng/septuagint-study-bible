[["1",[["τότε",712908,28],["στήσεται",706846,93],["ἐν",704639,0],["παρρησίᾳ",710173,1],["πολλῇ",710646,101],["ὁ",709436,3],["δίκαιος",703694,14],["κατὰ",707200,0],["πρόσωπον",710986,25],["τῶν",709436,80],["θλιψάντων",706274,221],["αὐτὸν",702165,85],["καὶ",707031,7],["τῶν",709436,80],["ἀθετούντων",700369,170],["τοὺς",709436,58],["πόνους",710661,57],["αὐτοῦ",702165,102]],"Then shall the righteous man stand in great boldness before the face of such as have afflicted him, and made no account of his labours."],["2",[["ἰδόντες",709725,196],["ταραχθήσονται",712721,144],["φόβῳ",713534,114],["δεινῷ",703328,30],["καὶ",707031,7],["ἐκστήσονται",704940,135],["ἐπὶ",705080,0],["τῷ",709436,113],["παραδόξῳ",710016,114],["τῆς",709436,16],["σωτηρίας",712658,17]],"When they see it, they shall be troubled with terrible fear, and shall be amazed at the strangeness of his salvation, so far beyond all that they looked for."],["3",[["ἐροῦσιν",705415,218],["ἐν",704639,0],["ἑαυτοῖς",703917,151],["μετανοοῦντες",708809,146],["καὶ",707031,7],["διὰ",703417,0],["στενοχωρίαν",712071,9],["πνεύματος",710566,21],["στενάξονται",712066,135],["καὶ",707031,7],["ἐροῦσιν",705415,218]],"And they repenting and groaning for anguish of spirit shall say within themselves, This was he, whom we had sometimes in derision, and a proverb of reproach:",{"s":"d","q":0.5}],["4",[["οὗτος",709858,121],["ἦν",704093,13],["ὃν",709781,112],["ἔσχομέν",705785,289],["ποτε",710695,28],["εἰς",704105,0],["γέλωτα",703032,6],["καὶ",707031,7],["εἰς",704105,0],["παραβολὴν",710003,9],["ὀνειδισμοῦ",709657,18],["οἱ",709436,136],["ἄφρονες",702236,138],["τὸν",709436,5],["βίον",702724,6],["αὐτοῦ",702165,102],["ἐλογισάμεθα",708232,316],["μανίαν",708482,9],["καὶ",707031,7],["τὴν",709436,8],["τελευτὴν",712782,9],["αὐτοῦ",702165,102],["ἄτιμον",702095,27]],"we fools accounted his life madness, and his end to be without honour:",{"s":"d","q":0.52}],["5",[["πῶς",711121,28],["κατελογίσθη",707316,37],["ἐν",704639,0],["υἱοῖς",713075,148],["θεοῦ",706192,18],["καὶ",707031,7],["ἐν",704639,0],["ἁγίοις",700159,230],["ὁ",709436,3],["κλῆρος",707727,4],["αὐτοῦ",702165,102],["ἐστιν",704093,91]],"how is he numbered among the children of God, and his lot is among the saints!"],["6",[["ἄρα",701666,11],["ἐπλανήθημεν",710495,485],["ἀπὸ",701425,0],["ὁδοῦ",709458,17],["ἀληθείας",700656,17],["καὶ",707031,7],["τὸ",709436,34],["τῆς",709436,16],["δικαιοσύνης",703695,17],["φῶς",713642,15],["οὐκ",709805,28],["ἐπέλαμψεν",705186,2],["ἡμῖν",705994,90],["καὶ",707031,7],["ὁ",709436,3],["ἥλιος",705974,4],["οὐκ",709805,28],["ἀνέτειλεν",701066,2],["ἡμῖν",705994,90]],"Therefore have we erred from the way of truth, and the light of righteousness hath not shined unto us, and the sun of righteousness rose not upon us."],["7",[["ἀνομίας",701192,17],["ἐνεπλήσθημεν",704592,485],["τρίβοις",712939,76],["καὶ",707031,7],["ἀπωλείας",701660,17],["καὶ",707031,7],["διωδεύσαμεν",703715,289],["ἐρήμους",705420,39],["ἀβάτους",700023,119],["τὴν",709436,8],["δὲ",703303,11],["ὁδὸν",709458,9],["κυρίου",707996,18],["οὐκ",709805,28],["ἐπέγνωμεν",705104,289]],"We wearied ourselves in the way of wickedness and destruction: yea, we have gone through deserts, where there lay no way: but as for the way of the Lord, we have not known it."],["8",[["τί",712867,126],["ὠφέλησεν",714171,2],["ἡμᾶς",705981,194],["ἡ",709436,10],["ὑπερηφανία",713138,12],["καὶ",707031,7],["τί",712867,126],["πλοῦτος",710563,4],["μετὰ",708780,0],["ἀλαζονείας",700627,17],["συμβέβληται",712278,187],["ἡμῖν",705994,90]],"What hath pride profited us? or what good hath riches with [our] vaunting brought us?"],["9",[["παρῆλθεν",710141,2],["ἐκεῖνα",704183,290],["πάντα",710177,195],["ὡς",714148,28],["σκιὰ",711852,12],["καὶ",707031,7],["ὡς",714148,28],["ἀγγελία",700139,12],["παρατρέχουσα",710112,188]],"All those things are passed away like a shadow, and as a post that hasted by;"],["10",[["ὡς",714148,28],["ναῦς",709208,12],["διερχομένη",703673,211],["κυμαινόμενον",707969,214],["ὕδωρ",713071,25],["ἧς",709781,167],["διαβάσης",703419,494],["οὐκ",709805,28],["ἔστιν",704093,91],["ἴχνος",706873,25],["εὑρεῖν",705676,106],["οὐδὲ",709816,7],["ἀτραπὸν",702106,9],["τρόπιος",712979,17],["αὐτῆς",702165,86],["ἐν",704639,0],["κύμασιν",707968,96]],"and as a ship that passeth over the waves of the water, which when it is gone by, the trace thereof cannot be found, neither the pathway of the keel in the waves:"],["11",[["ἢ",705924,7],["ὡς",714148,28],["ὀρνέου",709762,21],["διιπτάντος",703544,152],["ἀέρα",700354,6],["οὐθὲν",709817,26],["εὑρίσκεται",705676,117],["τεκμήριον",712760,25],["πορείας",710665,17],["πληγῇ",710527,1],["δὲ",703303,11],["μαστιζόμενον",708567,208],["ταρσῶν",712727,81],["πνεῦμα",710566,15],["κοῦφον",707863,26],["καὶ",707031,7],["σχιζόμενον",712604,208],["βίᾳ",702712,1],["ῥοίζου",711286,18],["κινουμένων",707679,522],["πτερύγων",711057,65],["διωδεύθη",703715,37],["καὶ",707031,7],["μετὰ",708780,0],["τοῦτο",709858,129],["οὐχ",709805,28],["εὑρέθη",705676,37],["σημεῖον",711748,25],["ἐπιβάσεως",705084,17],["ἐν",704639,0],["αὐτῷ",702165,50]],"or as when a bird hath flown through the air, there is no token of her way to be found, but the light air being beaten with the stroke of her wings, and parted with the violent noise and motion of them, is passed through, and therein afterwards no sign where she went is to be found;"],["12",[["ἢ",705924,7],["ὡς",714148,28],["βέλους",702644,21],["βληθέντος",702487,401],["ἐπὶ",705080,0],["σκοπὸν",711877,6],["τμηθεὶς",712791,217],["ὁ",709436,3],["ἀὴρ",700354,14],["εὐθέως",705593,28],["εἰς",704105,0],["ἑαυτὸν",703917,85],["ἀνελύθη",700995,37],["ὡς",714148,7],["ἀγνοῆσαι",700175,106],["τὴν",709436,8],["δίοδον",703716,9],["αὐτοῦ",702165,49]],"or like as when an arrow is shot at a mark, it parteth the air, which immediately cometh together again, so that a man cannot know where it went through:"],["13",[["οὕτως",709859,28],["καὶ",707031,7],["ἡμεῖς",705983,219],["γεννηθέντες",703051,247],["ἐξελίπομεν",704237,289],["καὶ",707031,7],["ἀρετῆς",701727,17],["μὲν",708730,11],["σημεῖον",711748,25],["οὐδὲν",709817,46],["ἔσχομεν",705785,289],["δεῖξαι",703314,106],["ἐν",704639,0],["δὲ",703303,11],["τῇ",709436,100],["κακίᾳ",707054,1],["ἡμῶν",705999,145],["κατεδαπανήθημεν",707234,485]],"even so we in like manner, as soon as we were born, began to draw to our end, and had no sign of virtue to shew; but were consumed in our own wickedness."],["14",[["ὅτι",709803,7],["ἐλπὶς",704530,12],["ἀσεβοῦς",701909,116],["ὡς",714148,7],["φερόμενος",713428,122],["χνοῦς",713883,4],["ὑπὸ",713184,0],["ἀνέμου",701123,18],["καὶ",707031,7],["ὡς",714148,7],["πάχνη",710203,12],["ὑπὸ",713184,0],["λαίλαπος",708061,17],["διωχθεῖσα",703768,307],["λεπτὴ",708153,29],["καὶ",707031,7],["ὡς",714148,28],["καπνὸς",707132,4],["ὑπὸ",713184,0],["ἀνέμου",701123,18],["διεχύθη",703636,37],["καὶ",707031,7],["ὡς",714148,28],["μνεία",708961,12],["καταλύτου",707322,18],["μονοημέρου",708998,116],["παρώδευσεν",710153,2]],"For the hope of the ungodly is like dust that is blown away with the wind; like a thin froth that is driven away with the storm; like as the smoke which is dispersed here and there with a tempest, and passeth away as the remembrance of a guest that tarrieth but a day."],["15",[["δίκαιοι",703694,138],["δὲ",703303,11],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ζῶσιν",705851,197],["καὶ",707031,7],["ἐν",704639,0],["κυρίῳ",707996,114],["ὁ",709436,3],["μισθὸς",708939,4],["αὐτῶν",702165,40],["καὶ",707031,7],["ἡ",709436,10],["φροντὶς",713591,12],["αὐτῶν",702165,40],["παρὰ",709995,0],["ὑψίστῳ",713287,30]],"But the righteous live for evermore; their reward also is with the Lord, and the care of them is with the most High."],["16",[["διὰ",703417,0],["τοῦτο",709858,129],["λήμψονται",708076,135],["τὸ",709436,24],["βασίλειον",702578,25],["τῆς",709436,16],["εὐπρεπείας",705666,17],["καὶ",707031,7],["τὸ",709436,24],["διάδημα",703447,25],["τοῦ",709436,20],["κάλλους",707093,21],["ἐκ",704132,0],["χειρὸς",713787,17],["κυρίου",707996,18],["ὅτι",709803,7],["τῇ",709436,100],["δεξιᾷ",703360,101],["σκεπάσει",711832,127],["αὐτοὺς",702165,62],["καὶ",707031,7],["τῷ",709436,113],["βραχίονι",702808,114],["ὑπερασπιεῖ",713121,127],["αὐτῶν",702165,40]],"Therefore shall they receive a glorious kingdom, and a beautiful crown from the Lord's hand: for with his right hand shall he cover them, and with his arm shall he protect them."],["17",[["λήμψεται",708076,93],["πανοπλίαν",709968,9],["τὸν",709436,5],["ζῆλον",705871,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὁπλοποιήσει",709705,127],["τὴν",709436,8],["κτίσιν",707939,9],["εἰς",704105,0],["ἄμυναν",700879,9],["ἐχθρῶν",705779,169]],"He shall take to him his jealousy for complete armour, and make the creature his weapon for the revenge of [his] enemies."],["18",[["ἐνδύσεται",704701,93],["θώρακα",706356,6],["δικαιοσύνην",703695,9],["καὶ",707031,7],["περιθήσεται",710403,93],["κόρυθα",707843,9],["κρίσιν",707908,9],["ἀνυπόκριτον",701289,36]],"He shall put on righteousness as a breastplate, and true judgment instead of an helmet."],["19",[["λήμψεται",708076,93],["ἀσπίδα",701991,9],["ἀκαταμάχητον",700526,36],["ὁσιότητα",709783,9]],"He shall take holiness for an invincible shield."],["20",[["ὀξυνεῖ",709681,127],["δὲ",703303,11],["ἀπότομον",701620,36],["ὀργὴν",709728,9],["εἰς",704105,0],["ῥομφαίαν",711291,9],["συνεκπολεμήσει",712439,127],["δὲ",703303,11],["αὐτῷ",702165,50],["ὁ",709436,3],["κόσμος",707851,4],["ἐπὶ",705080,0],["τοὺς",709436,58],["παράφρονας",710117,57]],"His severe wrath shall he sharpen for a sword, and the world shall fight with him against the unwise."],["21",[["πορεύσονται",710667,135],["εὔστοχοι",705695,192],["βολίδες",702756,191],["ἀστραπῶν",702021,65],["καὶ",707031,7],["ὡς",714148,7],["ἀπὸ",701425,0],["εὐκύκλου",705625,92],["τόξου",712898,21],["τῶν",709436,43],["νεφῶν",709281,44],["ἐπὶ",705080,0],["σκοπὸν",711877,6],["ἁλοῦνται",700696,135]],"Then shall the right aiming thunderbolts go abroad; and from the clouds, as from a well drawn bow, shall they fly to the mark."],["22",[["καὶ",707031,7],["ἐκ",704132,0],["πετροβόλου",710445,116],["θυμοῦ",706334,18],["πλήρεις",710541,138],["ῥιφήσονται",711267,135],["χάλαζαι",713667,191],["ἀγανακτήσει",700119,127],["κατ᾿",707200,0],["αὐτῶν",702165,40],["ὕδωρ",713071,15],["θαλάσσης",706069,17],["ποταμοὶ",710693,52],["δὲ",703303,11],["συγκλύσουσιν",712226,218],["ἀποτόμως",701621,28]],"And hailstones full of wrath shall be cast [as] out of a stone bow, and the water of the sea shall rage against them, and the floods shall cruelly drown them."],["23",[["ἀντιστήσεται",701154,93],["αὐτοῖς",702165,151],["πνεῦμα",710566,15],["δυνάμεως",703839,17],["καὶ",707031,7],["ὡς",714148,28],["λαῖλαψ",708061,12],["ἐκλικμήσει",704243,127],["αὐτούς",702165,62],["καὶ",707031,7],["ἐρημώσει",705421,127],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9],["ἀνομία",701192,12],["καὶ",707031,7],["ἡ",709436,10],["κακοπραγία",707065,12],["περιτρέψει",710405,127],["θρόνους",706315,57],["δυναστῶν",703844,81]],"Yea, a mighty wind shall stand up against them, and like a storm shall blow them away: thus iniquity shall lay waste the whole earth, and ill dealing shall overthrow the thrones of the mighty."]]