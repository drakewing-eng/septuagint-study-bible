[["1",[["μάταιοι",708575,138],["μὲν",708730,11],["γὰρ",702963,11],["πάντες",710177,138],["ἄνθρωποι",701163,52],["φύσει",713633,1],["οἷς",709781,311],["παρῆν",710126,13],["θεοῦ",706192,18],["ἀγνωσία",700180,12],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,43],["ὁρωμένων",709725,369],["ἀγαθῶν",700106,83],["οὐκ",709805,28],["ἴσχυσαν",706859,511],["εἰδέναι",709492,115],["τὸν",709436,5],["ὄντα",704093,183],["οὔτε",709857,7],["τοῖς",709436,95],["ἔργοις",705396,96],["προσέχοντες",710895,146],["ἐπέγνωσαν",705104,150],["τὸν",709436,5],["τεχνίτην",712832,6]],"Surely vain are all men by nature, who are ignorant of God, and could not out of the good things that are seen know him that is: neither by considering the works did they acknowledge the workmaster;"],["2",[["ἀλλ᾿",700680,7],["ἢ",705924,7],["πῦρ",711088,25],["ἢ",705924,7],["πνεῦμα",710566,25],["ἢ",705924,7],["ταχινὸν",712744,27],["ἀέρα",700354,6],["ἢ",705924,7],["κύκλον",707957,6],["ἄστρων",702024,44],["ἢ",705924,7],["βίαιον",702714,46],["ὕδωρ",713071,25],["ἢ",705924,7],["φωστῆρας",713643,57],["οὐρανοῦ",709844,18],["πρυτάνεις",711019,52],["κόσμου",707851,18],["θεοὺς",706192,57],["ἐνόμισαν",709338,150]],"but deemed either fire, or wind, or the swift air, or the circle of the stars, or the violent water, or the lights of heaven, to be the gods which govern the world."],["3",[["ὧν",709781,103],["εἰ",704071,7],["μὲν",708730,11],["τῇ",709436,100],["καλλονῇ",707092,1],["τερπόμενοι",712804,348],["ταῦτα",709858,71],["θεοὺς",706192,57],["ὑπελάμβανον",713210,137],["γνώτωσαν",703105,264],["πόσῳ",710692,30],["τούτων",709858,70],["ὁ",709436,3],["δεσπότης",703379,4],["ἐστὶ",704093,91],["βελτίων",702647,14],["ὁ",709436,3],["γὰρ",702963,11],["τοῦ",709436,20],["κάλλους",707093,21],["γενεσιάρχης",703041,4],["ἔκτισεν",707938,2],["αὐτά",702165,71]],"With whose beauty if they being delighted took them to be gods; let them know how much better the Lord of them is: for the first author of beauty hath created them."],["4",[["εἰ",704071,7],["δὲ",703303,11],["δύναμιν",703839,9],["καὶ",707031,7],["ἐνέργειαν",704717,9],["ἐκπλαγέντες",704287,247],["νοησάτωσαν",709327,264],["ἀπ᾿",701425,0],["αὐτῶν",702165,70],["πόσῳ",710692,30],["ὁ",709436,3],["κατασκευάσας",707419,182],["αὐτὰ",702165,71],["δυνατώτερός",703845,224],["ἐστιν",704093,91]],"But if they were astonished at their power and virtue, let them understand by them, how much mightier he is that made them."],["5",[["ἐκ",704132,0],["γὰρ",702963,11],["μεγέθους",708656,21],["καὶ",707031,7],["καλλονῆς",707092,17],["κτισμάτων",707940,44],["ἀναλόγως",700994,28],["ὁ",709436,3],["γενεσιουργὸς",703042,4],["αὐτῶν",702165,40],["θεωρεῖται",706226,117]],"For by the greatness and beauty of the creatures proportionably the maker of them is seen."],["6",[["ἀλλ᾿",700680,7],["ὅμως",709652,7],["ἐπὶ",705080,0],["τούτοις",709858,206],["μέμψις",708729,12],["ἐστὶν",704093,91],["ὀλίγη",709568,29],["καὶ",707031,7],["γὰρ",702963,11],["αὐτοὶ",702165,201],["τάχα",712742,28],["πλανῶνται",710495,269],["θεὸν",706192,6],["ζητοῦντες",705879,146],["καὶ",707031,7],["θέλοντες",706176,146],["εὑρεῖν",705676,106]],"But yet for this they are the less to be blamed: for they peradventure err, seeking God, and desirous to find him."],["7",[["ἐν",704639,0],["γὰρ",702963,11],["τοῖς",709436,95],["ἔργοις",705396,96],["αὐτοῦ",702165,102],["ἀναστρεφόμενοι",701060,348],["διερευνῶσιν",703671,197],["καὶ",707031,7],["πείθονται",710221,269],["τῇ",709436,100],["ὄψει",709901,1],["ὅτι",709803,7],["καλὰ",707097,68],["τὰ",709436,41],["βλεπόμενα",702740,67]],"For being conversant in his works they search [him] diligently, and believe their sight: because the things are beautiful that are seen."],["8",[["πάλιν",709942,28],["δ᾿",703303,11],["οὐδ᾿",709816,7],["αὐτοὶ",702165,201],["συγγνωστοί",712190,138]],"Howbeit neither are they to be pardoned."],["9",[["εἰ",704071,7],["γὰρ",702963,11],["τοσοῦτον",712907,46],["ἴσχυσαν",706859,511],["εἰδέναι",709492,115],["ἵνα",706747,7],["δύνωνται",703838,380],["στοχάσασθαι",712129,109],["τὸν",709436,5],["αἰῶνα",700504,6],["τὸν",709436,5],["τούτων",709858,70],["δεσπότην",703379,6],["πῶς",711121,28],["τάχιον",712745,28],["οὐχ",709805,28],["εὗρον",705676,150]],"For if they were able to know so much, that they could aim at the world; how did they not sooner find out the Lord thereof?"],["10",[["ταλαίπωροι",712696,138],["δὲ",703303,11],["καὶ",707031,7],["ἐν",704639,0],["νεκροῖς",709247,148],["αἱ",709436,190],["ἐλπίδες",704530,191],["αὐτῶν",702165,40],["οἵτινες",709793,450],["ἐκάλεσαν",707084,150],["θεοὺς",706192,57],["ἔργα",705396,42],["χειρῶν",713787,65],["ἀνθρώπων",701163,81],["χρυσὸν",713975,6],["καὶ",707031,7],["ἄργυρον",701711,6],["τέχνης",712831,17],["ἐμμελέτημα",704569,25],["καὶ",707031,7],["ἀπεικάσματα",701373,42],["ζῴων",705916,44],["ἢ",705924,7],["λίθον",708196,6],["ἄχρηστον",702312,27],["χειρὸς",713787,17],["ἔργον",705396,25],["ἀρχαίας",701835,82]],"But miserable are they, and in dead things is their hope, who called them gods, which are the works of men's hands, gold and silver, to shew art in, and resemblances of beasts, or a stone good for nothing, the work of an ancient hand."],["11",[["εἰ",704071,7],["δὲ",703303,11],["καί",707031,28],["τις",712866,158],["ὑλοτόμος",713078,14],["τέκτων",712766,4],["εὐκίνητον",705616,46],["φυτὸν",713637,25],["ἐκπρίσας",704298,182],["περιέξυσεν",710351,2],["εὐμαθῶς",705636,28],["πάντα",710177,27],["τὸν",709436,5],["φλοιὸν",713523,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["τεχνησάμενος",712830,248],["εὐπρεπῶς",705668,28],["κατεσκεύασεν",707419,2],["χρήσιμον",713953,46],["σκεῦος",711844,25],["εἰς",704105,0],["ὑπηρεσίαν",713177,9],["ζωῆς",705910,17]],"Now a carpenter that felleth timber, after he hath sawn down a tree meet for the purpose, and taken off all the bark skilfully round about, and hath wrought it handsomely, and made a vessel thereof fit for the service of man's life;"],["12",[["τὰ",709436,41],["δὲ",703303,11],["ἀποβλήματα",701431,42],["τῆς",709436,16],["ἐργασίας",705385,17],["εἰς",704105,0],["ἑτοιμασίαν",705540,9],["τροφῆς",712984,17],["ἀναλώσας",700992,182],["ἐνεπλήσθη",704592,37]],"and after spending the refuse of his work to dress his meat, hath filled himself;"],["13",[["τὸ",709436,24],["δὲ",703303,11],["ἐξ",704132,0],["αὐτῶν",702165,70],["ἀπόβλημα",701431,25],["εἰς",704105,0],["οὐθὲν",709817,46],["εὔχρηστον",705729,46],["ξύλον",709427,25],["σκολιὸν",711868,46],["καὶ",707031,7],["ὄζοις",709481,148],["συμπεφυκός",712365,270],["λαβὼν",708076,182],["ἔγλυψεν",703119,2],["ἐν",704639,0],["ἐπιμελείᾳ",705198,1],["ἀργίας",701702,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐμπειρίᾳ",704586,1],["συνέσεως",712460,17],["ἐτύπωσεν",713021,2],["αὐτό",702165,129],["ἀπείκασεν",701372,2],["αὐτὸ",702165,129],["εἰκόνι",704089,1],["ἀνθρώπου",701163,18]],"and taking the very refuse among those which served to no use, being a crooked piece of wood, and full of knots, hath carved it diligently when he had nothing else to do, and formed it by the skill of his understanding, and fashioned it to the image of a man;"],["14",[["ἢ",705924,7],["ζῴῳ",705916,54],["τινὶ",712866,432],["εὐτελεῖ",705705,97],["ὡμοίωσεν",709628,2],["αὐτὸ",702165,129],["καταχρίσας",707494,182],["μίλτῳ",708920,1],["καὶ",707031,7],["φύκει",713611,54],["ἐρυθήνας",705443,182],["χρόαν",713966,9],["αὐτοῦ",702165,49],["καὶ",707031,7],["πᾶσαν",710177,36],["κηλῖδα",707652,9],["τὴν",709436,8],["ἐν",704639,0],["αὐτῷ",702165,280],["καταχρίσας",707494,182]],"or made it like some vile beast, laying it over with vermilion, and with paint colouring it red, and colouring every spot therein;"],["15",[["καὶ",707031,7],["ποιήσας",710582,182],["αὐτῷ",702165,280],["αὐτοῦ",702165,49],["ἄξιον",701308,46],["οἴκημα",709500,25],["ἐν",704639,0],["τοίχῳ",712879,114],["ἔθηκεν",712849,2],["αὐτὸ",702165,129],["ἀσφαλισάμενος",702041,248],["σιδήρῳ",711774,114]],"and when he had made a convenient room for it, set it in a wall, and made it fast with iron:"],["16",[["ἵνα",706747,7],["μὲν",708730,11],["οὖν",709835,11],["μὴ",708851,28],["καταπέσῃ",707375,172],["προενόησεν",710824,2],["αὐτοῦ",702165,49],["εἰδὼς",709492,270],["ὅτι",709803,7],["ἀδυνατεῖ",700296,91],["ἑαυτῷ",703917,280],["βοηθῆσαι",702746,106],["καὶ",707031,7],["γάρ",702963,11],["ἐστιν",704093,91],["εἰκὼν",704089,72],["καὶ",707031,7],["χρείαν",713938,9],["ἔχει",705785,91],["βοηθείας",702745,17]],"for he provided for it that it might not fall, knowing that it was unable to help itself; for it is an image, and hath need of help."],["17",[["περὶ",710285,0],["δὲ",703303,11],["κτημάτων",707933,44],["καὶ",707031,7],["γάμων",702957,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["τέκνων",712761,44],["προσευχόμενος",710893,122],["οὐκ",709805,28],["αἰσχύνεται",700485,117],["τῷ",709436,53],["ἀψύχῳ",702322,97],["προσλαλῶν",710929,72],["καὶ",707031,7],["περὶ",710285,0],["μὲν",708730,11],["ὑγιείας",713058,17],["τὸ",709436,24],["ἀσθενὲς",701939,46],["ἐπικαλεῖται",705153,117]],"Then maketh he prayer for his goods, for his wife and children, and is not ashamed to speak to that which hath no life."],["18",[["περὶ",710285,0],["δὲ",703303,11],["ζωῆς",705910,17],["τὸ",709436,24],["νεκρὸν",709247,46],["ἀξιοῖ",701309,91],["περὶ",710285,0],["δὲ",703303,11],["ἐπικουρίας",705172,17],["τὸ",709436,24],["ἀπειρότατον",701381,647],["ἱκετεύει",706716,91],["περὶ",710285,0],["δὲ",703303,11],["ὁδοιπορίας",709450,17],["τὸ",709436,24],["μηδὲ",708855,7],["βάσει",702585,1],["χρῆσθαι",713936,110],["δυνάμενον",703838,214]],"For health he calleth upon that which is weak: for life prayeth to that which is dead: for aid humbly beseecheth that which hath least means to help: and for a good journey he asketh of that which cannot set a foot forward:"],["19",[["περὶ",710285,0],["δὲ",703303,11],["πορισμοῦ",710671,18],["καὶ",707031,7],["ἐργασίας",705385,17],["καὶ",707031,7],["χειρῶν",713787,65],["ἐπιτυχίας",705316,17],["τὸ",709436,24],["ἀδρανέστατον",700291,647],["ταῖς",709436,75],["χερσὶν",713787,76],["εὐδράνειαν",705569,9],["αἰτεῖται",700489,117]],"and for gaining and getting, and for good success of his hands, asketh ability to do of him, that is most unable to do any thing."]]