[["1",[["διατείνει",703604,91],["δὲ",703303,11],["ἀπὸ",701425,0],["πέρατος",710281,21],["ἐπὶ",705080,0],["πέρας",710281,15],["εὐρώστως",705683,28],["καὶ",707031,7],["διοικεῖ",703717,91],["τὰ",709436,41],["πάντα",710177,68],["χρηστῶς",713960,28]],"[Wisdom] reacheth from one end to another mightily; and sweetly doth she order all things."],["2",[["ταύτην",709858,104],["ἐφίλησα",713471,155],["καὶ",707031,7],["ἐξεζήτησα",704187,155],["ἐκ",704132,0],["νεότητός",709258,17],["μου",709032,133],["καὶ",707031,7],["ἐζήτησα",705879,155],["νύμφην",709381,9],["ἀγαγέσθαι",700209,109],["ἐμαυτῷ",704545,50],["καὶ",707031,7],["ἐραστὴς",705379,4],["ἐγενόμην",703104,161],["τοῦ",709436,20],["κάλλους",707093,21],["αὐτῆς",702165,86]],"I loved her, and sought [her] out from my youth, I desired to make [her] my spouse, and I was a lover of her beauty."],["3",[["εὐγένειαν",705558,9],["δοξάζει",703792,91],["συμβίωσιν",712282,9],["θεοῦ",706192,18],["ἔχουσα",705785,188],["καὶ",707031,7],["ὁ",709436,3],["πάντων",710177,169],["δεσπότης",703379,4],["ἠγάπησεν",700120,2],["αὐτήν",702165,104]],"In that she is conversant with God, she magnifieth her nobility: yea, the Lord of all things himself loved her."],["4",[["μύστις",709083,12],["γάρ",702963,11],["ἐστιν",704093,91],["τῆς",709436,16],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐπιστήμης",705267,17],["καὶ",707031,7],["αἱρετὶς",700470,12],["τῶν",709436,43],["ἔργων",705396,44],["αὐτοῦ",702165,102]],"For she is privy to the mysteries of the knowledge of God, and a lover of his works."],["5",[["εἰ",704071,7],["δὲ",703303,11],["πλοῦτός",710563,4],["ἐστιν",704093,91],["ἐπιθυμητὸν",705146,26],["κτῆμα",707933,15],["ἐν",704639,0],["βίῳ",702724,114],["τί",712867,273],["σοφίας",711981,17],["πλουσιώτερον",710560,385],["τῆς",709436,16],["τὰ",709436,41],["πάντα",710177,68],["ἐργαζομένης",705383,422]],"If riches be a possession to be desired in this life; what is richer than wisdom, that worketh all things?"],["6",[["εἰ",704071,7],["δὲ",703303,11],["φρόνησις",713588,12],["ἐργάζεται",705383,117],["τίς",712867,158],["αὐτῆς",702165,86],["τῶν",709436,43],["ὄντων",704093,84],["μᾶλλόν",708448,28],["ἐστιν",704093,91],["τεχνῖτις",712833,12]],"And if prudence work; who of all that are is a more cunning workman than she?"],["7",[["καὶ",707031,7],["εἰ",704071,7],["δικαιοσύνην",703695,9],["ἀγαπᾷ",700120,91],["τις",712866,158],["οἱ",709436,136],["πόνοι",710661,52],["ταύτης",709858,86],["εἰσὶν",704093,197],["ἀρεταί",701727,191],["σωφροσύνην",712674,9],["γὰρ",702963,11],["καὶ",707031,7],["φρόνησιν",713588,9],["ἐκδιδάσκει",704170,91],["δικαιοσύνην",703695,9],["καὶ",707031,7],["ἀνδρείαν",701101,36],["ὧν",709781,103],["χρησιμώτερον",713953,489],["οὐδέν",709817,46],["ἐστιν",704093,91],["ἐν",704639,0],["βίῳ",702724,114],["ἀνθρώποις",701163,148]],"And if a man love righteousness, her labours are virtues: for she teacheth temperance and prudence, justice and fortitude: which are such things, as men can have nothing more profitable in their life."],["8",[["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["πολυπειρίαν",710636,9],["ποθεῖ",710581,91],["τις",712866,158],["οἶδεν",709492,171],["τὰ",709436,41],["ἀρχαῖα",701835,68],["καὶ",707031,7],["τὰ",709436,41],["μέλλοντα",708705,237],["εἰκάζει",704081,91],["ἐπίσταται",705264,117],["στροφὰς",712169,39],["λόγων",708236,81],["καὶ",707031,7],["λύσεις",708277,39],["αἰνιγμάτων",700460,44],["σημεῖα",711748,42],["καὶ",707031,7],["τέρατα",712793,25],["προγινώσκει",710774,91],["καὶ",707031,7],["ἐκβάσεις",704146,39],["καιρῶν",707047,81],["καὶ",707031,7],["χρόνων",713969,81]],"If a man desire much experience, she knoweth things of old, and conjectureth [aright] what is to come: she knoweth the subtilties of speeches, and can expound dark sentences: she foreseeth signs and wonders, and the events of seasons and times."],["9",[["ἔκρινα",707905,2],["τοίνυν",712875,11],["ταύτην",709858,104],["ἀγαγέσθαι",700209,109],["πρὸς",710844,0],["συμβίωσιν",712281,271],["εἰδὼς",709492,270],["ὅτι",709803,7],["ἔσται",704093,93],["μοι",708974,159],["σύμβουλος",712295,4],["ἀγαθῶν",700106,83],["καὶ",707031,7],["παραίνεσις",710030,12],["φροντίδων",713591,65],["καὶ",707031,7],["λύπης",708273,17]],"Therefore I purposed to take her to me to live with me, knowing that she would be a counsellor of good things, and a comfort in cares and grief."],["10",[["ἕξω",705785,165],["δι᾿",703417,0],["αὐτὴν",702165,104],["δόξαν",703791,9],["ἐν",704639,0],["ὄχλοις",709884,148],["καὶ",707031,7],["τιμὴν",712856,9],["παρὰ",709995,0],["πρεσβυτέροις",710735,148],["ὁ",709436,3],["νέος",709256,14]],"For her sake I shall have estimation among the multitude, and honour with the elders, though I be young."],["11",[["ὀξὺς",709682,14],["εὑρεθήσομαι",705676,180],["ἐν",704639,0],["κρίσει",707908,1],["καὶ",707031,7],["ἐν",704639,0],["ὄψει",709901,1],["δυναστῶν",703844,81],["θαυμασθήσομαι",706135,180]],"I shall be found of a quick conceit in judgment, and shall be admired in the sight of great men."],["12",[["σιγῶντά",711767,183],["με",708618,163],["περιμενοῦσιν",710348,218],["καὶ",707031,7],["φθεγγομένῳ",713442,241],["προσέξουσιν",710895,218],["καὶ",707031,7],["λαλοῦντος",708071,152],["ἐπὶ",705080,0],["πλεῖον",710514,36],["χεῖρα",713787,9],["ἐπιθήσουσιν",705304,218],["ἐπὶ",705080,0],["στόμα",712125,25],["αὐτῶν",702165,40]],"When I hold my tongue, they shall bide my leisure, and when I speak, they shall give good ear unto me: if I talk much, they shall lay their hands upon their mouth."],["13",[["ἕξω",705785,165],["δι᾿",703417,0],["αὐτὴν",702165,104],["ἀθανασίαν",700357,9],["καὶ",707031,7],["μνήμην",708964,9],["αἰώνιον",700505,36],["τοῖς",709436,147],["μετ᾿",708780,0],["ἐμὲ",704555,163],["ἀπολείψω",701508,165]],"Moreover by the means of her I shall obtain immortality, and leave behind me an everlasting memorial to them that come after me."],["14",[["διοικήσω",703717,165],["λαούς",708094,57],["καὶ",707031,7],["ἔθνη",704068,42],["ὑποταγήσεταί",713250,134],["μοι",708974,159]],"I shall set the people in order, and the nations shall be subject unto me."],["15",[["φοβηθήσονταί",713532,144],["με",708618,163],["ἀκούσαντες",700587,196],["τύραννοι",713026,52],["φρικτοί",713581,138],["ἐν",704639,0],["πλήθει",710529,54],["φανοῦμαι",713311,181],["ἀγαθὸς",700106,14],["καὶ",707031,7],["ἐν",704639,0],["πολέμῳ",710605,114],["ἀνδρεῖος",701101,14]],"Horrible tyrants shall be afraid when they do but hear of me; I shall be found good among the multitude, and valiant in war."],["16",[["εἰσελθὼν",704114,182],["εἰς",704105,0],["τὸν",709436,5],["οἶκόν",709516,6],["μου",709032,133],["προσαναπαύσομαι",710853,181],["αὐτῇ",702165,105],["οὐ",709805,28],["γὰρ",702963,11],["ἔχει",705785,91],["πικρίαν",710472,9],["ἡ",709436,10],["συναναστροφὴ",712391,12],["αὐτῆς",702165,86],["οὐδὲ",709816,7],["ὀδύνην",709463,9],["ἡ",709436,10],["συμβίωσις",712282,12],["αὐτῆς",702165,86],["ἀλλὰ",700680,7],["εὐφροσύνην",705717,9],["καὶ",707031,7],["χαράν",713719,9]],"After I am come into mine house, I will repose myself with her: for her conversation hath no bitterness: and to live with her hath no sorrow, but mirth and joy."],["17",[["ταῦτα",709858,71],["λογισάμενος",708232,248],["ἐν",704639,0],["ἐμαυτῷ",704545,50],["καὶ",707031,7],["φροντίσας",713590,182],["ἐν",704639,0],["καρδίᾳ",707141,1],["μου",709032,133],["ὅτι",709803,7],["ἀθανασία",700357,12],["ἐστὶν",704093,91],["ἐν",704639,0],["συγγενείᾳ",712184,1],["σοφίας",711981,17]],"Now when I considered these things in myself, and pondered them in my heart, how that to be allied unto wisdom is immortality;"],["18",[["καὶ",707031,7],["ἐν",704639,0],["φιλίᾳ",713474,1],["αὐτῆς",702165,86],["τέρψις",712805,12],["ἀγαθὴ",700106,29],["καὶ",707031,7],["ἐν",704639,0],["πόνοις",710661,148],["χειρῶν",713787,65],["αὐτῆς",702165,86],["πλοῦτος",710563,4],["ἀνεκλιπὴς",701118,14],["καὶ",707031,7],["ἐν",704639,0],["συγγυμνασίᾳ",712194,1],["ὁμιλίας",709614,17],["αὐτῆς",702165,86],["φρόνησις",713588,12],["καὶ",707031,7],["εὔκλεια",705618,12],["ἐν",704639,0],["κοινωνίᾳ",707776,1],["λόγων",708236,81],["αὐτῆς",702165,86],["περιῄειν",710310,333],["ζητῶν",705879,72],["ὅπως",709719,7],["λάβω",708076,207],["αὐτὴν",702165,104],["εἰς",704105,0],["ἐμαυτόν",704545,85]],"and great pleasure it is to have her friendship; and in the works of her hands are infinite riches; and in the exercise of conference with her, prudence; and in talking with her, a good report; I went about seeking how to take her to me."],["19",[["παῖς",709932,4],["δὲ",703303,11],["ἤμην",704093,333],["εὐφυὴς",705719,14],["ψυχῆς",714070,17],["τε",712751,11],["ἔλαχον",708052,155],["ἀγαθῆς",700106,82]],"For I was a witty child, and had a good spirit."],["20",[["μᾶλλον",708448,28],["δὲ",703303,11],["ἀγαθὸς",700106,14],["ὢν",704093,72],["ἦλθον",705453,150],["εἰς",704105,0],["σῶμα",712635,25],["ἀμίαντον",700821,46]],"Yea rather, being good, I came into a body undefiled."],["21",[["γνοὺς",703105,182],["δὲ",703303,11],["ὅτι",709803,7],["οὐκ",709805,28],["ἄλλως",700711,28],["ἔσομαι",704093,181],["ἐγκρατής",703990,14],["ἐὰν",703912,7],["μὴ",708851,28],["ὁ",709436,3],["θεὸς",706192,4],["δῷ",703654,172],["καὶ",707031,7],["τοῦτο",709858,132],["δ᾿",703303,11],["ἦν",704093,13],["φρονήσεως",713588,17],["τὸ",709436,24],["εἰδέναι",709492,115],["τίνος",712867,340],["ἡ",709436,10],["χάρις",713735,12],["ἐνέτυχον",704812,155],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["ἐδεήθην",703394,156],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπον",705373,155],["ἐξ",704132,0],["ὅλης",709597,82],["τῆς",709436,16],["καρδίας",707141,17],["μου",709032,133]],"Nevertheless, when I perceived that I could not otherwise obtain her, except God gave her me; and that was a point of wisdom also to know whose gift she was; I prayed unto the Lord, and besought him, and with my whole heart I said,"]]