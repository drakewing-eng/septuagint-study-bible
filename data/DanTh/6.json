[["1",[["καὶ",707031,7],["Δαρεῖος",703292,4],["ὁ",709436,3],["Μῆδος",708864,4],["παρέλαβεν",710059,2],["τὴν",709436,8],["βασιλείαν",702577,9],["ὢν",704093,72],["ἐτῶν",705543,44],["ἑξήκοντα",704922,59],["δύο",703849,59]],"And Darius the Mede succeeded to the kingdom, being sixty-two years [old]."],["2",[["καὶ",707031,7],["ἤρεσεν",701722,2],["ἐνώπιον",704823,0],["Δαρείου",703292,18],["καὶ",707031,7],["κατέστησεν",707011,2],["ἐπὶ",705080,0],["τῆς",709436,16],["βασιλείας",702577,17],["σατράπας",711555,57],["ἑκατὸν",704136,59],["εἴκοσι",704085,59],["τοῦ",709436,20],["εἶναι",704093,55],["αὐτοὺς",702165,62],["ἐν",704639,0],["ὅλῃ",709597,101],["τῇ",709436,100],["βασιλείᾳ",702577,1],["αὐτοῦ",702165,102]],"And it pleased Darius, and he set over the kingdom a hundred and twenty satraps, to be in all his kingdom;"],["3",[["καὶ",707031,7],["ἐπάνω",705030,0],["αὐτῶν",702165,40],["τακτικοὺς",712691,57],["τρεῖς",712927,60],["ὧν",709781,252],["ἦν",704093,13],["Δανιηλ",703283,4],["εἷς",704106,14],["ἐξ",704132,0],["αὐτῶν",702165,40],["τοῦ",709436,20],["ἀποδιδόναι",701449,55],["αὐτοῖς",702165,151],["τοὺς",709436,58],["σατράπας",711555,57],["λόγον",708236,6],["ὅπως",709719,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["μὴ",708851,28],["ἐνοχλῆται",704780,117]],"and over them three governors, of whom one was Daniel; for the satraps to give account to them, that the king should not be troubled."],["4",[["καὶ",707031,7],["ἦν",704093,13],["Δανιηλ",703283,4],["ὑπὲρ",713111,0],["αὐτούς",702165,62],["ὅτι",709803,7],["πνεῦμα",710566,15],["περισσὸν",710387,26],["ἐν",704639,0],["αὐτῷ",702165,50],["καὶ",707031,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["κατέστησεν",707011,2],["αὐτὸν",702165,85],["ἐφ᾿",705080,0],["ὅλης",709597,82],["τῆς",709436,16],["βασιλείας",702577,17],["αὐτοῦ",702165,102]],"And Daniel was over them, for [there was] an excellent spirit in him; and the king set him over all his kingdom."],["5",[["καὶ",707031,7],["οἱ",709436,136],["τακτικοὶ",712691,52],["καὶ",707031,7],["οἱ",709436,136],["σατράπαι",711555,52],["ἐζήτουν",705879,137],["πρόφασιν",711004,9],["εὑρεῖν",705676,106],["κατὰ",707200,0],["Δανιηλ",703283,6],["καὶ",707031,7],["πᾶσαν",710177,36],["πρόφασιν",711004,9],["καὶ",707031,7],["παράπτωμα",710095,25],["καὶ",707031,7],["ἀμβλάκημα",700791,25],["οὐχ",709805,28],["εὗρον",705676,150],["κατ᾿",707200,0],["αὐτοῦ",702165,102],["ὅτι",709803,7],["πιστὸς",710486,14],["ἦν",704093,13]],"Then the governors and satraps sought to find occasion against Daniel; but they found against him no occasion, nor trespass, nor error, because he was faithful."],["6",[["καὶ",707031,7],["εἶπον",705373,150],["οἱ",709436,136],["τακτικοί",712691,52],["οὐχ",709805,28],["εὑρήσομεν",705676,275],["κατὰ",707200,0],["Δανιηλ",703283,6],["πρόφασιν",711004,9],["εἰ",704071,7],["μὴ",708851,28],["ἐν",704639,0],["νομίμοις",709340,230],["θεοῦ",706192,18],["αὐτοῦ",702165,102]],"And the governors said, We shall not find occasion against Daniel, except in the ordinances of his God."],["7",[["τότε",712908,28],["οἱ",709436,136],["τακτικοὶ",712691,52],["καὶ",707031,7],["οἱ",709436,136],["σατράπαι",711555,52],["παρέστησαν",710152,150],["τῷ",709436,113],["βασιλεῖ",702580,114],["καὶ",707031,7],["εἶπαν",705373,150],["αὐτῷ",702165,50],["Δαρεῖε",703292,153],["βασιλεῦ",702580,153],["εἰς",704105,0],["τοὺς",709436,58],["αἰῶνας",700504,57],["ζῆθι",705851,240]],"Then the governors and satraps stood by the king, and said to him, King Darius, live for ever."],["8",[["συνεβουλεύσαντο",712292,189],["πάντες",710177,138],["οἱ",709436,136],["ἐπὶ",705080,0],["τῆς",709436,16],["βασιλείας",702577,17],["σου",711945,133],["στρατηγοὶ",712144,52],["καὶ",707031,7],["σατράπαι",711555,52],["ὕπατοι",713106,52],["καὶ",707031,7],["τοπάρχαι",712901,52],["τοῦ",709436,20],["στῆσαι",706846,106],["στάσει",712049,1],["βασιλικῇ",702582,101],["καὶ",707031,7],["ἐνισχῦσαι",704750,106],["ὁρισμόν",709750,6],["ὅπως",709719,7],["ὃς",709781,213],["ἂν",700900,11],["αἰτήσῃ",700489,172],["αἴτημα",700490,25],["παρὰ",709995,0],["παντὸς",710177,116],["θεοῦ",706192,18],["καὶ",707031,7],["ἀνθρώπου",701163,18],["ἕως",705792,0],["ἡμερῶν",705984,65],["τριάκοντα",712934,59],["ἀλλ᾿",700680,7],["ἢ",705924,7],["παρὰ",709995,0],["σοῦ",711945,133],["βασιλεῦ",702580,153],["ἐμβληθήσεται",704547,134],["εἰς",704105,0],["τὸν",709436,5],["λάκκον",708067,6],["τῶν",709436,80],["λεόντων",708171,81]],"All who preside over thy kingdom, captains and satraps, chiefs and local governors, have taken counsel together, to establish by a royal statute and to confirm a decree, that whosoever shall ask a petition of any god or man for thirty days, save of thee, O king, shall be cast into the den of lions."],["9",[["νῦν",709384,28],["οὖν",709835,11],["βασιλεῦ",702580,153],["στῆσον",706846,176],["τὸν",709436,5],["ὁρισμὸν",709750,6],["καὶ",707031,7],["ἔκθες",704330,176],["γραφήν",703191,9],["ὅπως",709719,7],["μὴ",708851,28],["ἀλλοιωθῇ",700694,384],["τὸ",709436,34],["δόγμα",703773,15],["Μήδων",708864,81],["καὶ",707031,7],["Περσῶν",710429,81]],"Now then, O king, establish the decree, and publish a writ, that the decree of the Persians and Medes be not changed."],["10",[["τότε",712908,28],["ὁ",709436,3],["βασιλεὺς",702580,4],["Δαρεῖος",703292,4],["ἐπέταξεν",705294,2],["γραφῆναι",703194,179],["τὸ",709436,24],["δόγμα",703773,25]],"Then king Darius commanded the decree to be written."],["11",[["καὶ",707031,7],["Δανιηλ",703283,4],["ἡνίκα",706008,28],["ἔγνω",703105,2],["ὅτι",709803,7],["ἐνετάγη",704786,37],["τὸ",709436,34],["δόγμα",703773,15],["εἰσῆλθεν",704114,2],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["αἱ",709436,190],["θυρίδες",706340,191],["ἀνεῳγμέναι",701186,423],["αὐτῷ",702165,50],["ἐν",704639,0],["τοῖς",709436,95],["ὑπερῴοις",713172,96],["αὐτοῦ",702165,102],["κατέναντι",707507,0],["Ιερουσαλημ",706644,17],["καὶ",707031,7],["καιροὺς",707047,57],["τρεῖς",712927,60],["τῆς",709436,16],["ἡμέρας",705984,17],["ἦν",704093,13],["κάμπτων",707118,72],["ἐπὶ",705080,0],["τὰ",709436,41],["γόνατα",703172,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["προσευχόμενος",710893,122],["καὶ",707031,7],["ἐξομολογούμενος",704960,122],["ἐναντίον",704654,0],["τοῦ",709436,35],["θεοῦ",706192,18],["αὐτοῦ",702165,102],["καθὼς",707030,28],["ἦν",704093,13],["ποιῶν",710599,169],["ἔμπροσθεν",704618,28]],"And when Daniel knew that the decree was ordered, he went into his house; and his windows were opened in his chambers toward Jerusalem, and three times in the day he knelt upon his knees, and prayed and gave thanks before his God, as he used to do before."],["12",[["τότε",712908,28],["οἱ",709436,136],["ἄνδρες",701150,52],["ἐκεῖνοι",704183,201],["παρετήρησαν",710110,150],["καὶ",707031,7],["εὗρον",705676,150],["τὸν",709436,5],["Δανιηλ",703283,6],["ἀξιοῦντα",701309,183],["καὶ",707031,7],["δεόμενον",703394,212],["τοῦ",709436,35],["θεοῦ",706192,18],["αὐτοῦ",702165,102]],"Then these men watched, and found Daniel praying and supplicating to his God."],["13",[["καὶ",707031,7],["προσελθόντες",710890,196],["λέγουσιν",708124,197],["τῷ",709436,113],["βασιλεῖ",702580,114],["βασιλεῦ",702580,153],["οὐχ",709805,28],["ὁρισμὸν",709750,6],["ἔταξας",712730,162],["ὅπως",709719,7],["πᾶς",710177,14],["ἄνθρωπος",701163,4],["ὃς",709781,213],["ἂν",700900,11],["αἰτήσῃ",700489,172],["παρὰ",709995,0],["παντὸς",710177,116],["θεοῦ",706192,18],["καὶ",707031,7],["ἀνθρώπου",701163,18],["αἴτημα",700490,25],["ἕως",705792,0],["ἡμερῶν",705984,65],["τριάκοντα",712934,59],["ἀλλ᾿",700680,7],["ἢ",705924,7],["παρὰ",709995,0],["σοῦ",711945,133],["βασιλεῦ",702580,153],["ἐμβληθήσεται",704547,134],["εἰς",704105,0],["τὸν",709436,5],["λάκκον",708067,6],["τῶν",709436,80],["λεόντων",708171,81],["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεύς",702580,4],["ἀληθινὸς",700659,14],["ὁ",709436,3],["λόγος",708236,4],["καὶ",707031,7],["τὸ",709436,34],["δόγμα",703773,15],["Μήδων",708864,81],["καὶ",707031,7],["Περσῶν",710429,81],["οὐ",709805,28],["παρελεύσεται",710141,93]],"And they came and said to the king, O king, hast thou not made a decree, that whatsoever man shall ask a petition of any god or man for thirty days, but of thee, O king, shall be cast into the den of lions? And the king said, The word is true, and the decree of the Medes and Persians shall not pass."],["14",[["τότε",712908,28],["ἀπεκρίθησαν",701492,99],["καὶ",707031,7],["λέγουσιν",708124,197],["ἐνώπιον",704823,0],["τοῦ",709436,35],["βασιλέως",702580,18],["Δανιηλ",703283,4],["ὁ",709436,3],["ἀπὸ",701425,0],["τῶν",709436,80],["υἱῶν",713075,81],["τῆς",709436,16],["αἰχμαλωσίας",700499,17],["τῆς",709436,16],["Ιουδαίας",706769,17],["οὐχ",709805,28],["ὑπετάγη",713250,37],["τῷ",709436,53],["δόγματί",703773,54],["σου",711945,133],["περὶ",710285,0],["τοῦ",709436,35],["ὁρισμοῦ",709750,18],["οὗ",709781,48],["ἔταξας",712730,162],["καὶ",707031,7],["καιροὺς",707047,57],["τρεῖς",712927,60],["τῆς",709436,16],["ἡμέρας",705984,17],["αἰτεῖ",700489,91],["παρὰ",709995,0],["τοῦ",709436,35],["θεοῦ",706192,18],["αὐτοῦ",702165,102],["τὰ",709436,41],["αἰτήματα",700490,42],["αὐτοῦ",702165,102]],"Then they answered and said before the king, Daniel of the children of the captivity of Judea, has not submitted to thy decree; and three times in the day he makes his requests of his God."],["15",[["τότε",712908,28],["ὁ",709436,3],["βασιλεύς",702580,4],["ὡς",714148,7],["τὸ",709436,24],["ῥῆμα",711246,25],["ἤκουσεν",700587,2],["πολὺ",710646,28],["ἐλυπήθη",708272,37],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["καὶ",707031,7],["περὶ",710285,0],["τοῦ",709436,35],["Δανιηλ",703283,18],["ἠγωνίσατο",700214,23],["τοῦ",709436,20],["ἐξελέσθαι",704838,109],["αὐτὸν",702165,85],["καὶ",707031,7],["ἕως",705792,0],["ἑσπέρας",705500,17],["ἦν",704093,13],["ἀγωνιζόμενος",700214,122],["τοῦ",709436,20],["ἐξελέσθαι",704838,109],["αὐτόν",702165,85]],"Then the king, when he heard the saying, was much grieved for Daniel, and he greatly exerted himself for Daniel to deliver him: and he exerted himself till evening to deliver him."],["16",[["τότε",712908,28],["οἱ",709436,136],["ἄνδρες",701150,52],["ἐκεῖνοι",704183,201],["λέγουσιν",708124,197],["τῷ",709436,113],["βασιλεῖ",702580,114],["γνῶθι",703105,176],["βασιλεῦ",702580,153],["ὅτι",709803,7],["δόγμα",703773,15],["Μήδοις",708864,148],["καὶ",707031,7],["Πέρσαις",710429,148],["τοῦ",709436,35],["πᾶν",710177,27],["ὁρισμὸν",709750,6],["καὶ",707031,7],["στάσιν",712049,9],["ἣν",709781,131],["ἂν",700900,11],["ὁ",709436,3],["βασιλεὺς",702580,4],["στήσῃ",706846,172],["οὐ",709805,28],["δεῖ",703312,91],["παραλλάξαι",710066,106]],"Then those men said to the king, Know, O king, that the law of the Medes and Persians is, that we must not change any decree or statute which the king shall make."],["17",[["τότε",712908,28],["ὁ",709436,3],["βασιλεὺς",702580,4],["εἶπεν",705373,2],["καὶ",707031,7],["ἤγαγον",700209,150],["τὸν",709436,5],["Δανιηλ",703283,6],["καὶ",707031,7],["ἐνέβαλον",704547,150],["αὐτὸν",702165,85],["εἰς",704105,0],["τὸν",709436,5],["λάκκον",708067,6],["τῶν",709436,80],["λεόντων",708171,81],["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["τῷ",709436,113],["Δανιηλ",703283,114],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ᾧ",709781,309],["σὺ",712181,164],["λατρεύεις",708108,154],["ἐνδελεχῶς",704681,28],["αὐτὸς",702165,121],["ἐξελεῖταί",704838,93],["σε",711598,163]],"Then the king commanded, and they brought Daniel, and cast him into the den of lions. But the king said to Daniel, Thy God whom thou servest continually, he will deliver thee."],["18",[["καὶ",707031,7],["ἤνεγκαν",713428,150],["λίθον",708196,6],["καὶ",707031,7],["ἐπέθηκαν",705304,150],["ἐπὶ",705080,0],["τὸ",709436,24],["στόμα",712125,25],["τοῦ",709436,35],["λάκκου",708067,18],["καὶ",707031,7],["ἐσφραγίσατο",712590,23],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐν",704639,0],["τῷ",709436,113],["δακτυλίῳ",703258,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["δακτυλίῳ",703258,114],["τῶν",709436,80],["μεγιστάνων",708657,81],["αὐτοῦ",702165,102],["ὅπως",709719,7],["μὴ",708851,28],["ἀλλοιωθῇ",700694,384],["πρᾶγμα",710708,15],["ἐν",704639,0],["τῷ",709436,113],["Δανιηλ",703283,114]],"And they brought a stone, and put it on the mouth of the den; and the king sealed [it] with his ring, and with the ring of his nobles; that the case might not be altered with regard to Daniel."],["19",[["καὶ",707031,7],["ἀπῆλθεν",701398,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐκοιμήθη",707767,37],["ἄδειπνος",700243,14],["καὶ",707031,7],["ἐδέσματα",704032,42],["οὐκ",709805,28],["εἰσήνεγκαν",704127,150],["αὐτῷ",702165,50],["καὶ",707031,7],["ὁ",709436,3],["ὕπνος",713181,4],["ἀπέστη",702214,2],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀπέκλεισεν",701484,2],["ὁ",709436,3],["θεὸς",706192,4],["τὰ",709436,41],["στόματα",712125,42],["τῶν",709436,80],["λεόντων",708171,81],["καὶ",707031,7],["οὐ",709805,28],["παρηνώχλησαν",710135,150],["τῷ",709436,113],["Δανιηλ",703283,114]],"And the king departed to his house, and lay down fasting, and they brought him no food; and his sleep departed from him. But God shut the mouths of the lions, and they did not molest Daniel."],["20",[["τότε",712908,28],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἀνέστη",701173,2],["τὸ",709436,24],["πρωὶ",711021,28],["ἐν",704639,0],["τῷ",709436,53],["φωτὶ",713642,54],["καὶ",707031,7],["ἐν",704639,0],["σπουδῇ",712035,1],["ἦλθεν",705453,2],["ἐπὶ",705080,0],["τὸν",709436,5],["λάκκον",708067,6],["τῶν",709436,80],["λεόντων",708171,81]],"Then the king arose very early in the morning, and came in haste to the den of lions."],["21",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἐγγίζειν",703939,55],["αὐτὸν",702165,85],["τῷ",709436,113],["λάκκῳ",708067,114],["ἐβόησεν",702743,2],["φωνῇ",713640,1],["ἰσχυρᾷ",706855,101],["Δανιηλ",703283,153],["ὁ",709436,3],["δοῦλος",703817,4],["τοῦ",709436,35],["θεοῦ",706192,18],["τοῦ",709436,35],["ζῶντος",705851,152],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["ᾧ",709781,309],["σὺ",