[["1",[["ἐν",704639,0],["ἔτει",705543,54],["πρώτῳ",711041,633],["Βαλτασαρ",702491,18],["βασιλέως",702580,18],["Χαλδαίων",713678,81],["Δανιηλ",703283,4],["ἐνύπνιον",704818,25],["εἶδεν",709725,2],["καὶ",707031,7],["αἱ",709436,190],["ὁράσεις",709721,191],["τῆς",709436,16],["κεφαλῆς",707639,17],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τῆς",709436,16],["κοίτης",707781,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὸ",709436,24],["ἐνύπνιον",704818,25],["ἔγραψεν",703194,2]],"In the first year of Baltasar king of the Chaldeans Daniel had a dream, and visions of his head upon his bed: and he wrote his dream."],["2",[["ἐγὼ",704018,164],["Δανιηλ",703283,4],["ἐθεώρουν",706226,333],["ἐν",704639,0],["ὁράματί",709720,54],["μου",709032,133],["τῆς",709436,16],["νυκτὸς",709386,17],["καὶ",707031,7],["ἰδοὺ",706497,88],["οἱ",709436,136],["τέσσαρες",712808,138],["ἄνεμοι",701123,52],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["προσέβαλλον",710865,137],["εἰς",704105,0],["τὴν",709436,8],["θάλασσαν",706069,9],["τὴν",709436,8],["μεγάλην",708653,36]],"I Daniel beheld, and, lo, the four winds of heaven blew violently upon the great sea."],["3",[["καὶ",707031,7],["τέσσαρα",712808,195],["θηρία",706252,64],["μεγάλα",708653,195],["ἀνέβαινον",700905,137],["ἐκ",704132,0],["τῆς",709436,16],["θαλάσσης",706069,17],["διαφέροντα",703622,242],["ἀλλήλων",700689,70]],"And there came up four great beasts out of the sea, differing from one another."],["4",[["τὸ",709436,34],["πρῶτον",711041,654],["ὡσεὶ",714159,28],["λέαινα",708117,12],["καὶ",707031,7],["πτερὰ",711054,64],["αὐτῇ",702165,105],["ὡσεὶ",714159,28],["ἀετοῦ",700318,18],["ἐθεώρουν",706226,333],["ἕως",705792,0],["οὗ",709781,48],["ἐξετίλη",704332,37],["τὰ",709436,63],["πτερὰ",711054,64],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐξήρθη",704839,37],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἐπὶ",705080,0],["ποδῶν",710707,81],["ἀνθρώπου",701163,18],["ἐστάθη",706846,37],["καὶ",707031,7],["καρδία",707141,12],["ἀνθρώπου",701163,18],["ἐδόθη",703654,37],["αὐτῇ",702165,105]],"The first [was] as a lioness, and her wings as an eagle's: I beheld until her wings were plucked, and she was lifted off from the earth, and she stood on human feet, and a man's heart was given to her."],["5",[["καὶ",707031,7],["ἰδοὺ",706497,88],["θηρίον",706252,15],["δεύτερον",703389,26],["ὅμοιον",709626,26],["ἄρκῳ",701766,114],["καὶ",707031,7],["εἰς",704105,0],["μέρος",708752,25],["ἓν",704106,46],["ἐστάθη",706846,37],["καὶ",707031,7],["τρία",712927,195],["πλευρὰ",710525,64],["ἐν",704639,0],["τῷ",709436,53],["στόματι",712125,54],["αὐτῆς",702165,86],["ἀνὰ",700902,0],["μέσον",708768,27],["τῶν",709436,80],["ὀδόντων",709461,81],["αὐτῆς",702165,86],["καὶ",707031,7],["οὕτως",709859,28],["ἔλεγον",708124,137],["αὐτῇ",702165,105],["ἀνάστηθι",701173,176],["φάγε",713296,176],["σάρκας",711537,39],["πολλάς",710646,119]],"And, behold, a second beast like a bear, and it supported itself on one side, and there were three ribs in its mouth, between its teeth: and thus they said to it, Arise, devour much flesh."],["6",[["ὀπίσω",709697,0],["τούτου",709858,49],["ἐθεώρουν",706226,333],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἕτερον",705535,26],["θηρίον",706252,15],["ὡσεὶ",714159,28],["πάρδαλις",710122,12],["καὶ",707031,7],["αὐτῇ",702165,105],["πτερὰ",711054,64],["τέσσαρα",712808,195],["πετεινοῦ",710439,21],["ὑπεράνω",713118,0],["αὐτῆς",702165,86],["καὶ",707031,7],["τέσσαρες",712808,192],["κεφαλαὶ",707639,191],["τῷ",709436,53],["θηρίῳ",706252,54],["καὶ",707031,7],["ἐξουσία",704974,12],["ἐδόθη",703654,37],["αὐτῇ",702165,105]],"After this one I looked, and behold another wild beast as a leopard, and it had four wings of a bird upon it: and the wild beast had four heads, and power was given to it."],["7",[["ὀπίσω",709697,0],["τούτου",709858,49],["ἐθεώρουν",706226,333],["καὶ",707031,7],["ἰδοὺ",706497,88],["θηρίον",706252,15],["τέταρτον",712811,26],["φοβερὸν",713530,26],["καὶ",707031,7],["ἔκθαμβον",704190,26],["καὶ",707031,7],["ἰσχυρὸν",706855,26],["περισσῶς",7