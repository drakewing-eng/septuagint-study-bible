[["1",[["ἐν",704639,0],["ἔτει",705543,54],["τρίτῳ",712968,97],["τῆς",709436,16],["βασιλείας",702577,17],["Ιωακιμ",706887,18],["βασιλέως",702580,18],["Ιουδα",706768,18],["ἦλθεν",705453,2],["Ναβουχοδονοσορ",709149,4],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,17],["εἰς",704105,0],["Ιερουσαλημ",706644,12],["καὶ",707031,7],["ἐπολιόρκει",710608,13],["αὐτήν",702165,104]],"In the third year of the reign of Joakim king of Juda, came Nabuchodonosor king of Babylon to Jerusalem, and besieged it."],["2",[["καὶ",707031,7],["ἔδωκεν",703654,2],["κύριος",707996,4],["ἐν",704639,0],["χειρὶ",713787,1],["αὐτοῦ",702165,102],["τὸν",709436,5],["Ιωακιμ",706887,6],["βασιλέα",702580,6],["Ιουδα",706768,18],["καὶ",707031,7],["ἀπὸ",701425,0],["μέρους",708752,21],["τῶν",709436,43],["σκευῶν",711844,44],["οἴκου",709516,18],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["ἤνεγκεν",713428,2],["αὐτὰ",702165,71],["εἰς",704105,0],["γῆν",703083,9],["Σεννααρ",711691,118],["οἶκον",709516,6],["τοῦ",709436,35],["θεοῦ",706192,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["σκεύη",711844,42],["εἰσήνεγκεν",704127,2],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["θησαυροῦ",706258,18],["τοῦ",709436,35],["θεοῦ",706192,18],["αὐτοῦ",702165,102]],"And the Lord gave into his hand Joakim king of Juda, and part of the vessels of the house of God: and he brought them into the land of Sennaar to the house of his god; and he brought the vessels into the treasure-house of his god."],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["τῷ",709436,113],["Ασφανεζ",702046,114],["τῷ",709436,113],["ἀρχιευνούχῳ",701847,114],["αὐτοῦ",702165,102],["εἰσαγαγεῖν",704107,106],["ἀπὸ",701425,0],["τῶν",709436,80],["υἱῶν",713075,81],["τῆς",709436,16],["αἰχμαλωσίας",700499,17],["Ισραηλ",706839,18],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,20],["σπέρματος",712008,21],["τῆς",709436,16],["βασιλείας",702577,17],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,304],["φορθομμιν",713555,286]],"And the king told Asphanez his chief eunuch, to bring in [some] of the captive children of Israel, and of the seed of the kingdom, and of the princes;"],["4",[["νεανίσκους",709232,57],["οἷς",709781,311],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐν",704639,0],["αὐτοῖς",702165,151],["μῶμος",709102,4],["καὶ",707031,7],["καλοὺς",707097,60],["τῇ",709436,100],["ὄψει",709901,1],["καὶ",707031,7],["συνιέντας",712481,235],["ἐν",704639,0],["πάσῃ",710177,101],["σοφίᾳ",711981,1],["καὶ",707031,7],["γιγνώσκοντας",703105,235],["γνῶσιν",703138,9],["καὶ",707031,7],["διανοουμένους",703528,236],["φρόνησιν",713588,9],["καὶ",707031,7],["οἷς",709781,311],["ἐστιν",704093,91],["ἰσχὺς",706858,12],["ἐν",704639,0],["αὐτοῖς",702165,151],["ἑστάναι",706846,115],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["διδάξαι",703649,106],["αὐτοὺς",702165,62],["γράμματα",703183,42],["καὶ",707031,7],["γλῶσσαν",703120,9],["Χαλδαίων",713678,81]],"young men in whom was no blemish, and beautiful in appearance, and skilled in all wisdom, and possessing knowledge, and acquainted with prudence, and who had ability to stand in the house before the king, and [the king gave commandment] to teach them the learning and language of the Chaldeans."],["5",[["καὶ",707031,7],["διέταξεν",703603,2],["αὐτοῖς",702165,151],["ὁ",709436,3],["βασιλεὺς",702580,4],["τὸ",709436,24],["τῆς",709436,16],["ἡμέρας",705984,17],["καθ᾿",707200,0],["ἡμέραν",705984,9],["ἀπὸ",701425,0],["τῆς",709436,16],["τραπέζης",712919,17],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,35],["οἴνου",709530,18],["τοῦ",709436,35],["πότου",710704,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["θρέψαι",712930,106],["αὐτοὺς",702165,62],["ἔτη",705543,42],["τρία",712927,68],["καὶ",707031,7],["μετὰ",708780,0],["ταῦτα",709858,71],["στῆναι",706846,106],["ἐνώπιον",704823,0],["τοῦ",709436,35],["βασιλέως",702580,18]],"And the king appointed them a daily portion from the king's table, and from the wine which he drank; and [gave orders] to nourish them three years, and [that] afterwards they should stand before the king."],["6",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["αὐτοῖς",702165,151],["ἐκ",704132,0],["τῶν",709436,80],["υἱῶν",713075,81],["Ιουδα",706768,18],["Δανιηλ",703283,4],["καὶ",707031,7],["Ανανιας",701016,4],["καὶ",707031,7],["Μισαηλ",708930,4],["καὶ",707031,7],["Αζαριας",700328,4]],"Now these were among them of the children of Juda, Daniel, and Ananias, and Azarias, and Misael."],["7",[["καὶ",707031,7],["ἐπέθηκεν",705304,2],["αὐτοῖς",702165,151],["ὁ",709436,3],["ἀρχιευνοῦχος",701847,4],["ὀνόματα",709666,42],["τῷ",709436,113],["Δανιηλ",703283,114],["Βαλτασαρ",702491,6],["καὶ",707031,7],["τῷ",709436,113],["Ανανια",701016,114],["Σεδραχ",711622,6],["καὶ",707031,7],["τῷ",709436,113],["Μισαηλ",708930,114],["Μισαχ",708933,6],["καὶ",707031,7],["τῷ",709436,113],["Αζαρια",700328,114],["Αβδεναγω",700028,6]],"And the chief of the eunuchs gave them names: to Daniel, Baltasar; and to Ananias, Sedrach; and to Misael, Misach; and to Azarias, Abdenago."],["8",[["καὶ",707031,7],["ἔθετο",712849,23],["Δανιηλ",703283,4],["ἐπὶ",705080,0],["τὴν",709436,8],["καρδίαν",707141,9],["αὐτοῦ",702165,102],["ὡς",714148,7],["οὐ",709805,28],["μὴ",708851,28],["ἀλισγηθῇ",700672,384],["ἐν",704639,0],["τῇ",709436,100],["τραπέζῃ",712919,1],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["οἴνῳ",709530,114],["τοῦ",709436,35],["πότου",710704,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἠξίωσε",701309,2],["τὸν",709436,5],["ἀρχιευνοῦχον",701847,6],["ὡς",714148,7],["οὐ",709805,28],["μὴ",708851,28],["ἀλισγηθῇ",700672,384]],"And Daniel purposed in his heart, that he would not defile himself with the king's table, nor with the wine of his drink: and he intreated the chief of the eunuchs that he might not defile himself."],["9",[["καὶ",707031,7],["ἔδωκεν",703654,2],["ὁ",709436,3],["θεὸς",706192,4],["τὸν",709436,5],["Δανιηλ",703283,6],["εἰς",704105,0],["ἔλεον",704426,6],["καὶ",707031,7],["εἰς",704105,0],["οἰκτιρμὸν",709520,6],["ἐνώπιον",704823,0],["τοῦ",709436,35],["ἀρχιευνούχου",701847,18]],"Now God [had] brought Daniel into favour and compassion with the chief of the eunuchs."],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["ἀρχιευνοῦχος",701847,4],["τῷ",709436,113],["Δανιηλ",703283,114],["φοβοῦμαι",713532,254],["ἐγὼ",704018,164],["τὸν",709436,5],["κύριόν",707996,6],["μου",709032,133],["τὸν",709436,5],["βασιλέα",702580,6],["τὸν",709436,5],["ἐκτάξαντα",704321,365],["τὴν",709436,8],["βρῶσιν",702825,9],["ὑμῶν",713091,145],["καὶ",707031,7],["τὴν",709436,8],["πόσιν",710691,9],["ὑμῶν",713091,145],["μήποτε",708882,28],["ἴδῃ",709725,172],["τὰ",709436,41],["πρόσωπα",710986,42],["ὑμῶν",713091,145],["σκυθρωπὰ",711897,68],["παρὰ",709995,0],["τὰ",709436,41],["παιδάρια",709923,42],["τὰ",709436,41],["συνήλικα",712472,68],["ὑμῶν",713091,145],["καὶ",707031,7],["καταδικάσητε",707241,125],["τὴν",709436,8],["κεφαλήν",707639,9],["μου",709032,133],["τῷ",709436,113],["βασιλεῖ",702580,114]],"And the chief of the eunuchs said to Daniel, I fear my lord the king, who has appointed your meat and your drink, lest he see your countenances gloomy in comparison of the young men your equals; so shall ye endanger my head to the king."],["11",[["καὶ",707031,7],["εἶπεν",705373,2],["Δανιηλ",703283,4],["πρὸς",710844,0],["Αμελσαδ",700805,6],["ὃν",709781,112],["κατέστησεν",707011,2],["ὁ",709436,3],["ἀρχιευνοῦχος",701847,4],["ἐπὶ",705080,0],["Δανιηλ",703283,6],["Ανανιαν",701016,6],["Μισαηλ",708930,6],["Αζαριαν",700328,6]],"And Daniel said to Amelsad, whom the chief of the eunuchs had appointed over Daniel, Ananias, Misael, [and] Azarias,"],["12",[["πείρασον",710225,176],["δὴ",703395,11],["τοὺς",709436,58],["παῖδάς",709932,57],["σου",711945,133],["ἡμέρας",705984,39],["δέκα",703333,59],["καὶ",707031,7],["δότωσαν",703654,264],["ἡμῖν",705994,90],["ἀπὸ",701425,0],["τῶν",709436,43],["σπερμάτων",712008,44],["καὶ",707031,7],["φαγόμεθα",705495,141],["καὶ",707031,7],["ὕδωρ",713071,25],["πιόμεθα",710478,141]],"Prove now thy servants ten days; and let them give us pulse, and let us eat, and let us drink water:"],["13",[["καὶ",707031,7],["ὀφθήτωσαν",709725,51],["ἐνώπιόν",704823,0],["σου",711945,133],["αἱ",709436,190],["ἰδέαι",706483,191],["ἡμῶν",705999,145],["καὶ",707031,7],["αἱ",709436,190],["ἰδέαι",706483,191],["τῶν",709436,43],["παιδαρίων",709923,44],["τῶν",709436,43],["ἐσθιόντων",705495,84],["τὴν",709436,8],["τράπεζαν",712919,9],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["καθὼς",707030,28],["ἂν",700900,11],["ἴδῃς",709725,175],["ποίησον",710582,176],["μετὰ",708780,0],["τῶν",709436,80],["παίδων",709932,81],["σου",711945,133]],"and let our countenances be seen by thee, and the countenances of the children that eat [at] the king's table; and deal with thy servants according as thou shalt see."],["14",[["καὶ",707031,7],["εἰσήκουσεν",704108,2],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπείρασεν",710225,2],["αὐτοὺς",702165,62],["ἡμέρας",705984,39],["δέκα",703333,59]],"And he hearkened to them, and proved them ten days."],["15",[["καὶ",707031,7],["μετὰ",708780,0],["τὸ",709436,24],["τέλος",712787,25],["τῶν",709436,130],["δέκα",703333,59],["ἡμερῶν",705984,65],["ὡράθησαν",709725,99],["αἱ",709436,190],["ἰδέαι",706483,191],["αὐτῶν",702165,40],["ἀγαθαὶ",700106,192],["καὶ",707031,7],["ἰσχυραὶ",706855,192],["ταῖς",709436,75],["σαρξὶν",711537,76],["ὑπὲρ",713111,0],["τὰ",709436,41],["παιδάρια",709923,42],["τὰ",709436,41],["ἐσθίοντα",705495,47],["τὴν",709436,8],["τράπεζαν",712919,9],["τοῦ",709436,35],["βασιλέως",702580,18]],"And at the end of the ten days their countenances appeared fairer and stouter in flesh than the children that fed at the king's table."],["16",[["καὶ",707031,7],["ἐγένετο",703104,23],["Αμελσαδ",700805,4],["ἀναιρούμενος",700962,122],["τὸ",709436,24],["δεῖπνον",703331,25],["αὐτῶν",702165,40],["καὶ",707031,7],["τὸν",709436,5],["οἶνον",709530,6],["τοῦ",709436,20],["πόματος",710654,21],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐδίδου",703654,19],["αὐτοῖς",702165,151],["σπέρματα",712008,42]],"So Amelsad took away their supper and the wine of their drink, and gave them pulse."],["17",[["καὶ",707031,7],["τὰ",709436,63],["παιδάρια",709923,64],["ταῦτα",709858,290],["οἱ",709436,136],["τέσσαρες",712808,138],["αὐτοί",702165,201],["ἔδωκεν",703654,2],["αὐτοῖς",702165,151],["ὁ",709436,3],["θεὸς",706192,4],["σύνεσιν",712460,9],["καὶ",707031,7],["φρόνησιν",713588,9],["ἐν",704639,0],["πάσῃ",710177,101],["γραμματικῇ",703187,101],["καὶ",707031,7],["σοφίᾳ",711981,1],["καὶ",707031,7],["Δανιηλ",703283,4],["συνῆκεν",712481,2],["ἐν",704639,0],["πάσῃ",710177,101],["ὁράσει",709721,1],["καὶ",707031,7],["ἐνυπνίοις",704818,96]],"And [as for] these four children, God gave them understanding and prudence in all learning and wisdom: and Daniel had understanding in all visions and dreams."],["18",[["καὶ",707031,7],["μετὰ",708780,0],["τὸ",709436,24],["τέλος",712787,25],["τῶν",709436,130],["ἡμερῶν",705984,65],["ὧν",709781,199],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["εἰσαγαγεῖν",704107,106],["αὐτούς",702165,62],["καὶ",707031,7],["εἰσήγαγεν",704107,2],["αὐτοὺς",702165,62],["ὁ",709436,3],["ἀρχιευνοῦχος",701847,4],["ἐναντίον",704654,0],["Ναβουχοδονοσορ",709149,18]],"And at the end of the days, [after] which the king had given orders to bring them in, then the chief of the eunuchs brought them in before Nabuchodonosor."],["19",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["μετ᾿",708780,0],["αὐτῶν",702165,40],["ὁ",709436,3],["βασιλεύς",702580,4],["καὶ",707031,7],["οὐχ",709805,28],["εὑρέθησαν",705676,99],["ἐκ",704132,0],["πάντων",710177,169],["αὐτῶν",702165,40],["ὅμοιοι",709626,138],["Δανιηλ",703283,114],["καὶ",707031,7],["Ανανια",701016,114],["καὶ",707031,7],["Μισαηλ",708930,114],["καὶ",707031,7],["Αζαρια",700328,114],["καὶ",707031,7],["ἔστησαν",706846,150],["ἐνώπιον",704823,0],["τοῦ",709436,35],["βασιλέως",702580,18]],"And the king spoke with them; and there were not found out of them all any like Daniel, and Ananias, and Misael, and Azarias: and they stood before the king."],["20",[["καὶ",707031,7],["ἐν",704639,0],["παντὶ",710177,97],["ῥήματι",711246,54],["σοφίας",711981,17],["καὶ",707031,7],["ἐπιστήμης",705267,17],["ὧν",709781,103],["ἐζήτησεν",705879,2],["παρ᾿",709995,0],["αὐτῶν",702165,40],["ὁ",709436,3],["βασιλεύς",702580,4],["εὗρεν",705676,2],["αὐτοὺς",702165,62],["δεκαπλασίονας",703340,60],["παρὰ",709995,0],["πάντας",710177,60],["τοὺς",709436,58],["ἐπαοιδοὺς",705035,57],["καὶ",707031,7],["τοὺς",709436,58],["μάγους",708347,57],["τοὺς",709436,58],["ὄντας",704093,235],["ἐν",704639,0],["πάσῃ",710177,101],["τῇ",709436,100],["βασιλείᾳ",702577,1],["αὐτοῦ",702165,102]],"And in every matter of wisdom and knowledge wherein the king questioned them, he found them ten times wiser than all the enchanters and sorcerers that were in all his kingdom."],["21",[["καὶ",707031,7],["ἐγένετο",703104,23],["Δανιηλ",703283,4],["ἕως",705792,0],["ἔτους",705543,21],["ἑνὸς",704106,92],["Κύρου",707997,18],["τοῦ",709436,35],["βασιλέως",702580,18]],"And Daniel continued till the first year of king Cyrus."]]