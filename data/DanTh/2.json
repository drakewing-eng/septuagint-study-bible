[["1",[["ἐν",704639,0],["τῷ",709436,53],["ἔτει",705543,54],["τῷ",709436,53],["δευτέρῳ",703389,97],["τῆς",709436,16],["βασιλείας",702577,17],["Ναβουχοδονοσορ",709149,18],["ἠνυπνιάσθη",704815,37],["Ναβουχοδονοσορ",709149,4],["ἐνύπνιον",704818,25],["καὶ",707031,7],["ἐξέστη",704940,2],["τὸ",709436,34],["πνεῦμα",710566,15],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὁ",709436,3],["ὕπνος",713181,4],["αὐτοῦ",702165,102],["ἐγένετο",703104,23],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102]],"In the second year of [his] reign Nabuchodonosor dreamed a dream, and his spirit was amazed, and his sleep departed from him."],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["καλέσαι",707084,106],["τοὺς",709436,58],["ἐπαοιδοὺς",705035,57],["καὶ",707031,7],["τοὺς",709436,58],["μάγους",708347,57],["καὶ",707031,7],["τοὺς",709436,58],["φαρμακοὺς",713370,57],["καὶ",707031,7],["τοὺς",709436,58],["Χαλδαίους",713678,57],["τοῦ",709436,20],["ἀναγγεῖλαι",700921,106],["τῷ",709436,113],["βασιλεῖ",702580,114],["τὰ",709436,41],["ἐνύπνια",704818,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἦλθαν",705453,150],["καὶ",707031,7],["ἔστησαν",706846,150],["ἐνώπιον",704823,0],["τοῦ",709436,35],["βασιλέως",702580,18]],"And the king gave orders to call the enchanters, and the magicians, and the sorcerers, and the Chaldeans, to declare to the king his dreams. And they came and stood before the king."],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["ὁ",709436,3],["βασιλεύς",702580,4],["ἠνυπνιάσθην",704815,156],["καὶ",707031,7],["ἐξέστη",704940,2],["τὸ",709436,34],["πνεῦμά",710566,15],["μου",709032,133],["τοῦ",709436,20],["γνῶναι",703105,106],["τὸ",709436,24],["ἐνύπνιον",704818,25]],"And the king said to them, I have dreamed, and my spirit was troubled to know the dream."],["4",[["καὶ",707031,7],["ἐλάλησαν",708071,150],["οἱ",709436,136],["Χαλδαῖοι",713678,52],["τῷ",709436,113],["βασιλεῖ",702580,114],["Συριστί",712540,28],["βασιλεῦ",702580,153],["εἰς",704105,0],["τοὺς",709436,58],["αἰῶνας",700504,57],["ζῆθι",705851,240],["σὺ",712181,164],["εἰπὸν",705373,176],["τὸ",709436,24],["ἐνύπνιον",704818,25],["τοῖς",709436,147],["παισίν",709932,148],["σου",711945,133],["καὶ",707031,7],["τὴν",709436,8],["σύγκρισιν",712234,9],["ἀναγγελοῦμεν",700921,275]],"And the Chaldeans spoke to the king in the Syrian language, [saying], O king, live for ever: do thou tell the dream to thy servants, and we will declare the interpretation."],["5",[["ἀπεκρίθη",701492,37],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["εἶπεν",705373,2],["τοῖς",709436,147],["Χαλδαίοις",713678,148],["ὁ",709436,3],["λόγος",708236,4],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["ἀπέστη",702214,2],["ἐὰν",703912,7],["μὴ",708851,28],["γνωρίσητέ",703135,125],["μοι",708974,159],["τὸ",709436,24],["ἐνύπνιον",704818,25],["καὶ",707031,7],["τὴν",709436,8],["σύγκρισιν",712234,9],["αὐτοῦ",702165,49],["εἰς",704105,0],["ἀπώλειαν",701660,9],["ἔσεσθε",704093,124],["καὶ",707031,7],["οἱ",709436,136],["οἶκοι",709516,52],["ὑμῶν",713091,145],["διαρπαγήσονται",703562,135]],"The king answered the Chaldeans, The thing has departed from me: if ye do not make known to me the dream and the interpretation, ye shall be destroyed, and your houses shall be spoiled."],["6",[["ἐὰν",703912,7],["δὲ",703303,11],["τὸ",709436,24],["ἐνύπνιον",704818,25],["καὶ",707031,7],["τὴν",709436,8],["σύγκρισιν",712234,9],["αὐτοῦ",702165,49],["γνωρίσητέ",703135,125],["μοι",708974,159],["δόματα",703789,42],["καὶ",707031,7],["δωρεὰς",703900,39],["καὶ",707031,7],["τιμὴν",712856,9],["πολλὴν",710646,36],["λήμψεσθε",708076,124],["παρ᾿",709995,0],["ἐμοῦ",704580,133],["πλὴν",710540,28],["τὸ",709436,24],["ἐνύπνιον",704818,25],["καὶ",707031,7],["τὴν",709436,8],["σύγκρισιν",712234,9],["αὐτοῦ",702165,49],["ἀπαγγείλατέ",701321,74],["μοι",708974,159]],"But if ye make known to me the dream, and the interpretation thereof, ye shall receive of me gifts and presents and much honour: only tell me the dream, and the interpretation thereof."],["7",[["ἀπεκρίθησαν",701492,99],["δεύτερον",703389,27],["καὶ",707031,7],["εἶπαν",705373,150],["ὁ",709436,630],["βασιλεὺς",702580,153],["εἰπάτω",705373,45],["τὸ",709436,24],["ἐνύπνιον",704818,25],["τοῖς",709436,147],["παισὶν",709932,148],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὴν",709436,8],["σύγκρισιν",712234,9],["αὐτοῦ",702165,49],["ἀναγγελοῦμεν",700921,275]],"They answered the second time, and said, Let the king tell the dream to his servants, and we will declare the interpretation."],["8",[["ἀπεκρίθη",701492,37],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["εἶπεν",705373,2],["ἐπ᾿",705080,0],["ἀληθείας",700656,17],["οἶδα",709492,89],["ἐγὼ",704018,164],["ὅτι",709803,7],["καιρὸν",707047,6],["ὑμεῖς",713081,219],["ἐξαγοράζετε",704830,87],["καθότι",707021,28],["εἴδετε",709725,265],["ὅτι",709803,7],["ἀπέστη",702214,2],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["τὸ",709436,34],["ῥῆμα",711246,15]],"And the king answered and said, I verily know that ye are trying to gain time, because ye see that the thing has gone from me."],["9",[["ἐὰν",703912,7],["οὖν",709835,11],["τὸ",709436,24],["ἐνύπνιον",704818,25],["μὴ",708851,28],["ἀναγγείλητέ",700921,125],["μοι",708974,159],["οἶδα",709492,89],["ὅτι",709803,7],["ῥῆμα",711246,25],["ψευδὲς",714036,46],["καὶ",707031,7],["διεφθαρμένον",703624,439],["συνέθεσθε",712513,345],["εἰπεῖν",705373,106],["ἐνώπιόν",704823,0],["μου",709032,133],["ἕως",705792,0],["οὗ",709781,48],["ὁ",709436,3],["καιρὸς",707047,4],["παρέλθῃ",710141,172],["τὸ",709436,24],["ἐνύπνιόν",704818,25],["μου",709032,133],["εἴπατέ",705373,74],["μοι",708974,159],["καὶ",707031,7],["γνώσομαι",703105,181],["ὅτι",709803,7],["τὴν",709436,8],["σύγκρισιν",712234,9],["αὐτοῦ",702165,49],["ἀναγγελεῖτέ",700921,337],["μοι",708974,159]],"If then ye do not tell me the dream, I know that ye have concerted to utter before me a false and corrupt tale, until the time shall have past: tell me my dream, and I shall know that ye will also declare to me the interpretation thereof."],["10",[["ἀπεκρίθησαν",701492,99],["οἱ",709436,136],["Χαλδαῖοι",713678,52],["ἐνώπιον",704823,0],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["λέγουσιν",708124,197],["οὐκ",709805,28],["ἔστιν",704093,91],["ἄνθρωπος",701163,4],["ἐπὶ",705080,0],["τῆς",709436,16],["ξηρᾶς",709421,82],["ὅστις",709793,425],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦ",709436,35],["βασιλέως",702580,18],["δυνήσεται",703838,93],["γνωρίσαι",703135,106],["καθότι",707021,28],["πᾶς",710177,14],["βασιλεὺς",702580,4],["μέγας",708653,14],["καὶ",707031,7],["ἄρχων",701862,4],["ῥῆμα",711246,25],["τοιοῦτο",712878,129],["οὐκ",709805,28],["ἐπερωτᾷ",705069,91],["ἐπαοιδόν",705035,6],["μάγον",708347,6],["καὶ",707031,7],["Χαλδαῖον",713678,6]],"The Chaldeans answered before the king, and said, There is no man upon the earth, who shall be able to make known the king's matter: forasmuch as no great king or ruler asks such a question of an enchanter, magician, or Chaldean."],["11",[["ὅτι",709803,7],["ὁ",709436,3],["λόγος",708236,4],["ὃν",709781,112],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐπερωτᾷ",705069,91],["βαρύς",702554,14],["καὶ",707031,7],["ἕτερος",705535,14],["οὐκ",709805,28],["ἔστιν",704093,91],["ὃς",709781,213],["ἀναγγελεῖ",700921,127],["αὐτὸν",702165,85],["ἐνώπιον",704823,0],["τοῦ",709436,35],["βασιλέως",702580,18],["ἀλλ᾿",700680,7],["ἢ",705924,7],["θεοί",706192,52],["ὧν",709781,252],["οὐκ",709805,28],["ἔστιν",704093,91],["ἡ",709436,10],["κατοικία",707537,12],["μετὰ",708780,0],["πάσης",710177,82],["σαρκός",711537,17]],"For the question which the king asks is difficult, and there is no one else who shall answer it before the king, but the gods, whose dwelling is not with any flesh."],["12",[["τότε",712908,28],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐν",704639,0],["θυμῷ",706334,114],["καὶ",707031,7],["ὀργῇ",709728,1],["πολλῇ",710646,101],["εἶπεν",705373,2],["ἀπολέσαι",701513,106],["πάντας",710177,60],["τοὺς",709436,58],["σοφοὺς",711985,60],["Βαβυλῶνος",702352,17]],"Then the king in rage and anger commanded to destroy all the wise men of Babylon."],["13",[["καὶ",707031,7],["τὸ",709436,34],["δόγμα",703773,15],["ἐξῆλθεν",704909,2],["καὶ",707031,7],["οἱ",709436,136],["σοφοὶ",711985,138],["ἀπεκτέννοντο",701498,139],["καὶ",707031,7],["ἐζήτησαν",705879,150],["Δανιηλ",703283,6],["καὶ",707031,7],["τοὺς",709436,58],["φίλους",713492,60],["αὐτοῦ",702165,102],["ἀνελεῖν",700962,106]],"So the decree went forth, and they began to slay the wise men; and they sought Daniel and his fellows to slay [them]."],["14",[["τότε",712908,28],["Δανιηλ",703283,4],["ἀπεκρίθη",701492,37],["βουλὴν",702792,9],["καὶ",707031,7],["γνώμην",703134,9],["τῷ",709436,113],["Αριωχ",701760,114],["τῷ",709436,113],["ἀρχιμαγείρῳ",701848,114],["τοῦ",709436,35],["βασιλέως",702580,18],["ὃς",709781,213],["ἐξῆλθεν",704909,2],["ἀναιρεῖν",700962,55],["τοὺς",709436,58],["σοφοὺς",711985,60],["Βαβυλῶνος",702352,17]],"Then Daniel answered [with] counsel and prudence to Arioch the captain of the royal guard, who was gone forth to kill the wise men of Babylon; [saying],"],["15",[["ἄρχων",701862,153],["τοῦ",709436,35],["βασιλέως",702580,18],["περὶ",710285,0],["τίνος",712867,340],["ἐξῆλθεν",704909,2],["ἡ",709436,10],["γνώμη",703134,12],["ἡ",709436,10],["ἀναιδὴς",700959,14],["ἐκ",704132,0],["προσώπου",710986,21],["τοῦ",709436,35],["βασιλέως",702580,18],["ἐγνώρισεν",703135,2],["δὲ",703303,11],["τὸ",709436,24],["ῥῆμα",711246,25],["Αριωχ",701760,4],["τῷ",709436,113],["Δανιηλ",703283,114]],"Chief magistrate of the king, wherefore has the peremptory command proceeded from the king? So Arioch made known the matter to Daniel."],["16",[["καὶ",707031,7],["Δανιηλ",703283,4],["εἰσῆλθεν",704114,2],["καὶ",707031,7],["ἠξίωσεν",701309,2],["τὸν",709436,5],["βασιλέα",702580,6],["ὅπως",709719,7],["χρόνον",713969,6],["δῷ",703654,172],["αὐτῷ",702165,50],["καὶ",707031,7],["τὴν",709436,8],["σύγκρισιν",712234,9],["αὐτοῦ",702165,49],["ἀναγγείλῃ",700921,172],["τῷ",709436,113],["βασιλεῖ",702580,114]],"And Daniel intreated the king to give him time, and that he might [thus] declare to the king the interpretation of it."],["17",[["καὶ",707031,7],["εἰσῆλθεν",704114,2],["Δανιηλ",703283,4],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["τῷ",709436,113],["Ανανια",701016,114],["καὶ",707031,7],["τῷ",709436,113],["Μισαηλ",708930,114],["καὶ",707031,7],["τῷ",709436,113],["Αζαρια",700328,114],["τοῖς",709436,147],["φίλοις",713492,230],["αὐτοῦ",702165,102],["τὸ",709436,24],["ῥῆμα",711246,25],["ἐγνώρισεν",703135,2]],"So Daniel went into his house, and made known the matter to Ananias, and Misael, and Azarias, his friends."],["18",[["καὶ",707031,7],["οἰκτιρμοὺς",709520,57],["ἐζήτουν",705879,137],["παρὰ",709995,0],["τοῦ",709436,35],["θεοῦ",706192,18],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["ὑπὲρ",713111,0],["τοῦ",709436,20],["μυστηρίου",709080,21],["τούτου",709858,49],["ὅπως",709719,7],["ἂν",700900,11],["μὴ",708851,28],["ἀπόλωνται",701513,232],["Δανιηλ",703283,4],["καὶ",707031,7],["οἱ",709436,136],["φίλοι",713492,138],["αὐτοῦ",702165,102],["μετὰ",708780,0],["τῶν",709436,80],["ἐπιλοίπων",705194,169],["σοφῶν",711985,169],["Βαβυλῶνος",702352,17]],"And they sought mercies from the God of heaven concerning this mystery; that Daniel and his friends might not perish with the rest of the wise men of Babylon."],["19",[["τότε",712908,28],["τῷ",709436,113],["Δανιηλ",703283,114],["ἐν",704639,0],["ὁράματι",709720,54],["τῆς",709436,16],["νυκτὸς",709386,17],["τὸ",709436,34],["μυστήριον",709080,15],["ἀπεκαλύφθη",701474,37],["καὶ",707031,7],["εὐλόγησεν",705631,2],["τὸν",709436,5],["θεὸν",706192,6],["τοῦ",709436,35],["οὐρανοῦ",709844,18]],"Then the mystery was revealed to Daniel in a vision of the night: and Daniel blessed the God of heaven, and said,"],["20",[["Δανιηλ",703283,4],["καὶ",707031,7],["εἶπεν",705373,2],["εἴη",704093,301],["τὸ",709436,34],["ὄνομα",709666,15],["τοῦ",709436,35],["θεοῦ",706192,18],["εὐλογημένον",705631,413],["ἀπὸ",701425,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["καὶ",707031,7],["ἕως",705792,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["ὅτι",709803,7],["ἡ",709436,10],["σοφία",711981,12],["καὶ",707031,7],["ἡ",709436,10],["σύνεσις",712460,12],["αὐτοῦ",702165,102],["ἐστιν",704093,91]],"May the name of God be blessed from everlasting and to everlasting: for wisdom and understanding are his."],["21",[["καὶ",707031,7],["αὐτὸς",702165,121],["ἀλλοιοῖ",700694,91],["καιροὺς",707047,57],["καὶ",707031,7],["χρόνους",713969,57],["καθιστᾷ",707011,91],["βασιλεῖς",702580,52],["καὶ",707031,7],["μεθιστᾷ",708668,91],["διδοὺς",703654,72],["σοφίαν",711981,9],["τοῖς",709436,147],["σοφοῖς",711985,230],["καὶ",707031,7],["φρόνησιν",713588,9],["τοῖς",709436,147],["εἰδόσιν",709492,536],["σύνεσιν",712460,9]],"And he changes times and seasons: he appoints kings, and removes [them], giving wisdom to the wise, and prudence to them that have understanding:"],["22",[["αὐτὸς",702165,121],["ἀποκαλύπτει",701474,91],["βαθέα",702381,68],["καὶ",707031,7],["ἀπόκρυφα",701497,68],["γινώσκων",703105,72],["τὰ",709436,41],["ἐν",704639,0],["τῷ",709436,53],["σκότει",711889,54],["καὶ",707031,7],["τὸ",709436,34],["φῶς",713642,15],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἐστιν",704093,91]],"he reveals deep and secret [matters]; knowing what is in darkness, and the light is with him."],["23",[["σοί",711925,159],["ὁ",709436,630],["θεὸς",706192,153],["τῶν",709436,80],["πατέρων",710189,81],["μου",709032,133],["ἐξομολογοῦμαι",704960,254],["καὶ",707031,7],["αἰνῶ",700459,157],["ὅτι",709803,7],["σοφίαν",711981,9],["καὶ",707031,7],["δύναμιν",703839,9],["ἔδωκάς",703654,162],["μοι",708974,159],["καὶ",707031,7],["νῦν",709384,28],["ἐγνώρισάς",703135,162],["μοι",708974,159],["ἃ",709781,69],["ἠξιώσαμεν",701309,289],["παρὰ",709995,0],["σοῦ",711945,133],["καὶ",707031,7],["τὸ",709436,24],["ὅραμα",709720,25],["τοῦ",709436,35],["βασιλέως",702580,18],["ἐγνώρισάς",703135,162],["μοι",708974,159]],"I give thanks to thee, and praise [thee], O God of my fathers, for thou hast given me wisdom and power, and hast made known to me the things which we asked of thee; and thou hast made known to me the king's vision."],["24",[["καὶ",707031,7],["ἦλθεν",705453,2],["Δανιηλ",703283,4],["πρὸς",710844,0],["Αριωχ",701760,6],["ὃν",709781,112],["κατέστησεν",707011,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἀπολέσαι",701513,106],["τοὺς",709436,58],["σοφοὺς",711985,60],["Βαβυλῶνος",702352,17],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["τοὺς",709436,58],["σοφοὺς",711985,60],["Βαβυλῶνος",702352,17],["μὴ",708851,28],["ἀπολέσῃς",701513,175],["εἰσάγαγε",704107,176],["δέ",703303,11],["με",708618,163],["ἐνώπιον",704823,0],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["τὴν",709436,8],["σύγκρισιν",712234,9],["τῷ",709436,113],["βασιλεῖ",702580,114],["ἀναγγελῶ",700921,165]],"And Daniel came to Arioch, whom the king had appointed to destroy the wise men of Babylon, and said to him; Destroy not the wise men of Babylon, but bring me in before the king, and I will declare the interpretation to the king."],["25",[["τότε",712908,28],["Αριωχ",701760,4],["ἐν",704639,0],["σπουδῇ",712035,1],["εἰσήγαγεν",704107,2],["τὸν",709436,5],["Δανιηλ",703283,6],["ἐνώπιον",704823,0],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["εὕρηκα",705676,89],["ἄνδρα",701150,6],["ἐκ",704132,0],["τῶν",709436,80],["υἱῶν",713075,81],["τῆς",709436,16],["αἰχμαλωσίας",700499,17],["τῆς",709436,16],["Ιουδαίας",706769,17],["ὅστις",709793,425],["τὸ",709436,24],["σύγκριμα",712232,25],["τῷ",709436,113],["βασιλεῖ",702580,114],["ἀναγγελεῖ",700921,127]],"Then Arioch in haste brought in Daniel before the king, and said to him, I have found a man of the children of the captivity of Judea, who will declare the interpretation to the king."],["26",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["εἶπεν",705373,2],["τῷ",709436,113],["Δανιηλ",703283,114],["οὗ",709781,48],["τὸ",709436,34],["ὄνομα",709666,15],["Βαλτασαρ",702491,4],["εἰ",704071,7],["δύνασαί",703838,259],["μοι",708974,159],["ἀναγγεῖλαι",700921,106],["τὸ",709436,24],["ἐνύπνιον",704818,25],["ὃ",709781,128],["εἶδον",709725,150],["καὶ",707031,7],["τὴν",709436,8],["σύγκρισιν",712234,9],["αὐτοῦ",702165,49]],"And the king answered and said to Daniel, whose name was Baltasar, Canst thou declare to me the dream which I saw, and the interpretation thereof?"],["27",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["Δανιηλ",703283,4],["ἐνώπιον",704823,0],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["λέγει",708124,91],["τὸ",709436,34],["μυστήριον",709080,15],["ὃ",709781,128],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐπερωτᾷ",705069,91],["οὐκ",709805,28],["ἔστιν",704093,91],["σοφῶν",711985,169],["μάγων",708347,81],["ἐπαοιδῶν",705035,81],["γαζαρηνῶν",702888,81],["ἀναγγεῖλαι",700921,106],["τῷ",709436,113],["βασιλεῖ",702580,114]],"And Daniel answered before the king, and said, The mystery which the king asks [the explanation of] is not [in the power] of the wise men, magicians, enchanters, [or] soothsayers to declare to the king."],["28",[["ἀλλ᾿",700680,7],["ἢ",705924,7],["ἔστιν",704093,91],["θεὸς",706192,4],["ἐν",704639,0],["οὐρανῷ",709844,114],["ἀποκαλύπτων",701474,72],["μυστήρια",709080,42],["καὶ",707031,7],["ἐγνώρισεν",703135,2],["τῷ",709436,113],["βασιλεῖ",702580,114],["Ναβουχοδονοσορ",709149,114],["ἃ",709781,371],["δεῖ",703312,91],["γενέσθαι",703104,109],["ἐπ᾿",705080,0],["ἐσχάτων",705519,198],["τῶν",709436,130],["ἡμερῶν",705984,65],["τὸ",709436,34],["ἐνύπνιόν",704818,15],["σου",711945,133],["καὶ",707031,7],["αἱ",709436,190],["ὁράσεις",709721,191],["τῆς",709436,16],["κεφαλῆς",707639,17],["σου",711945,133],["ἐπὶ",705080,0],["τῆς",709436,16],["κοίτης",707781,17],["σου",711945,133],["τοῦτό",709858,132],["ἐστιν",704093,91]],"But there is a God in heaven revealing mysteries, and he has made known to king Nabuchodonosor what things must come to pass in the last days. Thy dream, and the visions of thy head upon thy bed, are as follows,"],["29",[["σὺ",712181,686],["βασιλεῦ",702580,153],["οἱ",709436,136],["διαλογισμοί",703506,52],["σου",711945,133],["ἐπὶ",705080,0],["τῆς",709436,16],["κοίτης",707781,17],["σου",711945,133],["ἀνέβησαν",700905,150],["τί",712867,273],["δεῖ",703312,91],["γενέσθαι",703104,109],["μετὰ",708780,0],["ταῦτα",709858,71],["καὶ",707031,7],["ὁ",709436,3],["ἀποκαλύπτων",701474,72],["μυστήρια",709080,42],["ἐγνώρισέν",703135,2],["σοι",711925,159],["ἃ",709781,371],["δεῖ",703312,91],["γενέσθαι",703104,109]],"O king: thy thoughts upon thy bed arose [as to] what must come to pass hereafter: and he that reveals mysteries has made known to thee what must come to pass."],["30",[["καὶ",707031,7],["ἐμοὶ",704577,159],["δὲ",703303,11],["οὐκ",709805,28],["ἐν",704639,0],["σοφίᾳ",711981,1],["τῇ",709436,100],["οὔσῃ",704093,220],["ἐν",704639,0],["ἐμοὶ",704577,159],["παρὰ",709995,0],["πάντας",710177,60],["τοὺς",709436,58],["ζῶντας",705851,235],["τὸ",709436,34],["μυστήριον",709080,15],["τοῦτο",709858,132],["ἀπεκαλύφθη",701474,37],["ἀλλ᾿",700680,7],["ἕνεκεν",704709,0],["τοῦ",709436,20],["τὴν",709436,8],["σύγκρισιν",712234,9],["τῷ",709436,113],["βασιλεῖ",702580,114],["γνωρίσαι",703135,106],["ἵνα",706747,7],["τοὺς",709436,58],["διαλογισμοὺς",703506,57],["τῆς",709436,16],["καρδίας",707141,17],["σου",711945,133],["γνῷς",703105,175]],"Moreover, this mystery has not been revealed to me by reason of wisdom which is in me beyond all [others] living, but for the sake of making known the interpretation to the king, that thou mightest know the thoughts of thine heart."],["31",[["σύ",712181,164],["βασιλεῦ",702580,153],["ἐθεώρεις",706226,363],["καὶ",707031,7],["ἰδοὺ",706497,88],["εἰκὼν",704089,12],["μία",704106,29],["μεγάλη",708653,29],["ἡ",709436,10],["εἰκὼν",704089,12],["ἐκείνη",704183,107],["καὶ",707031,7],["ἡ",709436,10],["πρόσοψις",710948,12],["αὐτῆς",702165,86],["ὑπερφερής",713164,29],["ἑστῶσα",706846,287],["πρὸ",710747,0],["προσώπου",710986,21],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["ὅρασις",709721,12],["αὐτῆς",702165,86],["φοβερά",713530,29]],"Thou, O king, sawest, and behold an image: that image was great, and the appearance of it excellent, standing before thy face; and the form of it was terrible."],["32",[["ἡ",709436,10],["εἰκών",704089,12],["ἧς",709781,167],["ἡ",709436,10],["κεφαλὴ",707639,12],["χρυσίου",713972,21],["χρηστοῦ",713958,92],["αἱ",709436,190],["χεῖρες",713787,191],["καὶ",707031,7],["τὸ",709436,34],["στῆθος",712089,15],["καὶ",707031,7],["οἱ",709436,136],["βραχίονες",702808,52],["αὐτῆς",702165,86],["ἀργυροῖ",701705,138],["ἡ",709436,10],["κοιλία",707761,12],["καὶ",707031,7],["οἱ",709436,136],["μηροὶ",708885,52],["χαλκοῖ",713690,138]],"[It was] an image, the head of which was of fine gold, its hands and breast and arms of silver, [its] belly and thighs of brass,"],["33",[["αἱ",709436,190],["κνῆμαι",707750,191],["σιδηραῖ",711771,192],["οἱ",709436,136],["πόδες",710707,52],["μέρος",708752,15],["τι",712866,273],["σιδηροῦν",711771,26],["καὶ",707031,7],["μέρος",708752,15],["τι",712866,273],["ὀστράκινον",709795,26]],"its legs of iron, its feet, part of iron and part of earthenware."],["34",[["ἐθεώρεις",706226,363],["ἕως",705792,0],["οὗ",709781,48],["ἐτμήθη",712791,37],["λίθος",708196,4],["ἐξ",704132,0],["ὄρους",709768,21],["ἄνευ",701137,0],["χειρῶν",713787,65],["καὶ",707031,7],["ἐπάταξεν",710185,2],["τὴν",709436,8],["εἰκόνα",704089,9],["ἐπὶ",705080,0],["τοὺς",709436,58],["πόδας",710707,57],["τοὺς",709436,58],["σιδηροῦς",711771,60],["καὶ",707031,7],["ὀστρακίνους",709795,60],["καὶ",707031,7],["ἐλέπτυνεν",708154,2],["αὐτοὺς",702165,62],["εἰς",704105,0],["τέλος",712787,25]],"Thou sawest until a stone was cut out of a mountain without hands, and it smote the image upon its feet of iron and earthenware, and utterly reduced them to powder."],["35",[["τότε",712908,28],["ἐλεπτύνθησαν",708154,99],["εἰς",704105,0],["ἅπαξ",701350,28],["τὸ",709436,34],["ὄστρακον",709796,15],["ὁ",709436,3],["σίδηρος",711774,4],["ὁ",709436,3],["χαλκός",713695,4],["ὁ",709436,3],["ἄργυρος",701711,4],["ὁ",709436,3],["χρυσὸς",713975,14],["καὶ",707031,7],["ἐγένοντο",703104,189],["ὡσεὶ",714159,28],["κονιορτὸς",707815,4],["ἀπὸ",701425,0],["ἅλωνος",700741,17],["θερινῆς",706207,82],["καὶ",707031,7],["ἐξῆρεν",704839,2],["αὐτὰ",702165,71],["τὸ",709436,34],["πλῆθος",710529,15],["τοῦ",709436,20],["πνεύματος",710566,21],["καὶ",707031,7],["τόπος",712903,4],["οὐχ",709805,28],["εὑρέθη",705676,37],["αὐτοῖς",702165,206],["καὶ",707031,7],["ὁ",709436,3],["λίθος",708196,4],["ὁ",709436,3],["πατάξας",710185,182],["τὴν",709436,8],["εἰκόνα",704089,9],["ἐγενήθη",703104,37],["ὄρος",709768,15],["μέγα",708653,26],["καὶ",707031,7],["ἐπλήρωσεν",710543,2],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9]],"Then once for all the earthenware, the iron, the brass, the silver, the gold, were ground to powder, and became as chaff from the summer threshingfloor; and the violence of the wind carried them away, and no place was found for them: and the stone which had smitten the image became a great mountain, and filled all the earth."],["36",[["τοῦτό",709858,132],["ἐστιν",704093,91],["τὸ",709436,34],["ἐνύπνιον",704818,15],["καὶ",707031,7],["τὴν",709436,8],["σύγκρισιν",712234,9],["αὐτοῦ",702165,49],["ἐροῦμεν",705415,275],["ἐνώπιον",704823,0],["τοῦ",709436,35],["βασιλέως",702580,18]],"This is the dream; and we will tell the interpretation thereof before the king."],["37",[["σύ",712181,164],["βασιλεῦ",702580,153],["βασιλεὺς",702580,4],["βασιλέων",702580,81],["ᾧ",709781,309],["ὁ",709436,3],["θεὸς",706192,4],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["βασιλείαν",702577,9],["ἰσχυρὰν",706855,36],["καὶ",707031,7],["κραταιὰν",707873,36],["καὶ",707031,7],["ἔντιμον",704798,36],["ἔδωκεν",703654,2]],"Thou, O king, art a king of kings, to whom the God of heaven has given a powerful and strong and honourable kingdom,"],["38",[["ἐν",704639,0],["παντὶ",710177,30],["τόπῳ",712903,114],["ὅπου",709710,11],["κατοικοῦσιν",707534,197],["οἱ",709436,136],["υἱοὶ",713075,52],["τῶν",709436,80],["ἀνθρώπων",701163,81],["θηρία",706252,42],["τε",712751,11],["ἀγροῦ",700196,18],["καὶ",707031,7],["πετεινὰ",710439,42],["οὐρανοῦ",709844,18],["ἔδωκεν",703654,2],["ἐν",704639,0],["τῇ",709436,100],["χειρί",713787,1],["σου",711945,133],["καὶ",707031,7],["κατέστησέν",707011,2],["σε",711598,163],["κύριον",707996,6],["πάντων",710177,83],["σὺ",712181,164],["εἶ",704093,154],["ἡ",709436,10],["κεφαλὴ",707639,12],["ἡ",709436,10],["χρυσῆ",713971,29]],"in every place where the children of men dwell: and he has given into thine hand the wild beasts of the field, and the birds of the sky and the fish of the sea, and he has made thee lord of all."],["39",[["καὶ",707031,7],["ὀπίσω",709697,0],["σου",711945,133],["ἀναστήσεται",701173,93],["βασιλεία",702577,12],["ἑτέρα",705535,29],["ἥττων",706042,29],["σου",711945,133],["καὶ",707031,7],["βασιλεία",702577,12],["τρίτη",712968,29],["ἥτις",709793,412],["ἐστὶν",704093,91],["ὁ",709436,3],["χαλκός",713695,4],["ἣ",709781,177],["κυριεύσει",707995,127],["πάσης",710177,82],["τῆς",709436,16],["γῆς",703083,17]],"Thou art the head of gold. And after thee shall arise another kingdom inferior to thee, and a third kingdom which is the brass, which shall have dominion over all the earth;"],["40",[["καὶ",707031,7],["βασιλεία",702577,12],["τετάρτη",712811,29],["ἔσται",704093,93],["ἰσχυρὰ",706855,29],["ὡς",714148,7],["ὁ",709436,3],["σίδηρος",711774,4],["ὃν",709781,112],["τρόπον",712980,6],["ὁ",709436,3],["σίδηρος",711774,4],["λεπτύνει",708154,91],["καὶ",707031,7],["δαμάζει",703270,91],["πάντα",710177,68],["οὕτως",709859,28],["πάντα",710177,68],["λεπτυνεῖ",708154,127],["καὶ",707031,7],["δαμάσει",703270,127]],"and a fourth kingdom, which shall be strong as iron: as iron beats to powder and subdues all things, so shall it beat to powder and subdue."],["41",[["καὶ",707031,7],["ὅτι",709803,7],["εἶδες",709725,162],["τοὺς",709436,58],["πόδας",710707,57],["καὶ",707031,7],["τοὺς",709436,58],["δακτύλους",703259,57],["μέρος",708752,25],["μέν",708730,11],["τι",712866,126],["ὀστράκινον",709795,46],["μέρος",708752,25],["δέ",703303,11],["τι",712866,126],["σιδηροῦν",711771,46],["βασιλεία",702577,12],["διῃρημένη",703459,203],["ἔσται",704093,93],["καὶ",707031,7],["ἀπὸ",701425,0],["τῆς",709436,16],["ῥίζης",711260,17],["τῆς",709436,16],["σιδηρᾶς",711771,82],["ἔσται",704093,93],["ἐν",704639,0],["αὐτῇ",702165,105],["ὃν",709781,112],["τρόπον",712980,6],["εἶδες",709725,162],["τὸν",709436,5],["σίδηρον",711774,6],["ἀναμεμειγμένον",701001,439],["τῷ",709436,113],["ὀστράκῳ",709796,54]],"And whereas thou sawest the feet and the toes, part of earthenware and part of iron, the kingdom shall be divided; yet there shall be in it of the strength of iron, as thou sawest the iron mixed with earthenware."],["42",[["καὶ",707031,7],["οἱ",709436,136],["δάκτυλοι",703259,52],["τῶν",709436,80],["ποδῶν",710707,81],["μέρος",708752,15],["μέν",708730,11],["τι",712866,273],["σιδηροῦν",711771,26],["μέρος",708752,15],["δέ",703303,11],["τι",712866,273],["ὀστράκινον",709795,26],["μέρος",708752,15],["τι",712866,273],["τῆς",709436,16],["βασιλείας",702577,17],["ἔσται",704093,93],["ἰσχυρὸν",706855,26],["καὶ",707031,7],["ἀπ᾿",701425,0],["αὐτῆς",702165,86],["ἔσται",704093,93],["συντριβόμενον",712520,208]],"And [whereas] the toes of the feet were part of iron and part of earthenware, part of the kingdom shall be strong, and [part] of it shall be broken."],["43",[["ὅτι",709803,7],["εἶδες",709725,162],["τὸν",709436,5],["σίδηρον",711774,6],["ἀναμεμειγμένον",701001,439],["τῷ",709436,53],["ὀστράκῳ",709796,54],["συμμειγεῖς",712306,195],["ἔσονται",704093,135],["ἐν",704639,0],["σπέρματι",712008,54],["ἀνθρώπων",701163,81],["καὶ",707031,7],["οὐκ",709805,28],["ἔσονται",704093,135],["προσκολλώμενοι",710921,348],["οὗτος",709858,121],["μετὰ",708780,0],["τούτου",709858,102],["καθὼς",707030,28],["ὁ",709436,3],["σίδηρος",711774,4],["οὐκ",709805,28],["ἀναμείγνυται",701001,117],["μετὰ",708780,0],["τοῦ",709436,20],["ὀστράκου",709796,21]],"Whereas thou sawest the iron mixed with earthenware, they shall be mingled with the seed of men: but they shall not cleave together, as the iron does not mix itself with earthenware."],["44",[["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["τῶν",709436,80],["βασιλέων",702580,81],["ἐκείνων",704183,40],["ἀναστήσει",701173,127],["ὁ",709436,3],["θεὸς",706192,4],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["βασιλείαν",702577,9],["ἥτις",709793,412],["εἰς",704105,0],["τοὺς",709436,58],["αἰῶνας",700504,57],["οὐ",709805,28],["διαφθαρήσεται",703624,134],["καὶ",707031,7],["ἡ",709436,10],["βασιλεία",702577,12],["αὐτοῦ",702165,102],["λαῷ",708094,114],["ἑτέρῳ",705535,30],["οὐχ",709805,28],["ὑπολειφθήσεται",713212,134],["λεπτυνεῖ",708154,127],["καὶ",707031,7],["λικμήσει",708202,127],["πάσας",710177,119],["τὰς",709436,38],["βασιλείας",702577,39],["καὶ",707031,7],["αὐτὴ",702165,107],["ἀναστήσεται",701173,93],["εἰς",704105,0],["τοὺς",709436,58],["αἰῶνας",700504,57]],"And in the days of those kings the God of heaven shall set up a kingdom which shall never be destroyed: and his kingdom shall not be left to another people, [but] it shall beat to pieces and grind to powder all [other] kingdoms, and it shall stand for ever."],["45",[["ὃν",709781,112],["τρόπον",712980,6],["εἶδες",709725,162],["ὅτι",709803,7],["ἀπὸ",701425,0],["ὄρους",709768,21],["ἐτμήθη",712791,37],["λίθος",708196,4],["ἄνευ",701137,0],["χειρῶν",713787,65],["καὶ",707031,7],["ἐλέπτυνεν",708154,2],["τὸ",709436,24],["ὄστρακον",709796,25],["τὸν",709436,5],["σίδηρον",711774,6],["τὸν",709436,5],["χαλκόν",713695,6],["τὸν",709436,5],["ἄργυρον",701711,6],["τὸν",709436,5],["χρυσόν",713975,6],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["μέγας",708653,14],["ἐγνώρισεν",703135,2],["τῷ",709436,113],["βασιλεῖ",702580,114],["ἃ",709781,371],["δεῖ",703312,91],["γενέσθαι",703104,109],["μετὰ",708780,0],["ταῦτα",709858,71],["καὶ",707031,7],["ἀληθινὸν",700659,26],["τὸ",709436,34],["ἐνύπνιον",704818,15],["καὶ",707031,7],["πιστὴ",710486,29],["ἡ",709436,10],["σύγκρισις",712234,12],["αὐτοῦ",702165,49]],"Whereas thou sawest that a stone was cut out of a mountain without hands, and it beat to pieces the earthenware, the iron, the brass, the silver, the gold; the great God has made known to the king what must happen hereafter: and the dream is true, and the interpretation thereof sure."],["46",[["τότε",712908,28],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ναβουχοδονοσορ",709149,4],["ἔπεσεν",710481,2],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["καὶ",707031,7],["τῷ",709436,113],["Δανιηλ",703283,114],["προσεκύνησεν",710925,2],["καὶ",707031,7],["μαναα",708463,354],["καὶ",707031,7],["εὐωδίας",705734,39],["εἶπεν",705373,2],["σπεῖσαι",712007,106],["αὐτῷ",702165,50]],"Then king Nabuchodonosor fell upon his face, and worshipped Daniel, and gave orders to offer to him gifts and incense."],["47",[["καὶ",707031,7],["ἀποκριθεὶς",701492,217],["ὁ",709436,3],["βασιλεὺς",702580,4],["εἶπεν",705373,2],["τῷ",709436,113],["Δανιηλ",703283,114],["ἐπ᾿",705080,0],["ἀληθείας",700656,17],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["αὐτός",702165,121],["ἐστιν",704093,91],["θεὸς",706192,4],["θεῶν",706192,81],["καὶ",707031,7],["κύριος",707996,4],["τῶν",709436,80],["βασιλέων",702580,81],["καὶ",707031,7],["ἀποκαλύπτων",701474,72],["μυστήρια",709080,42],["ὅτι",709803,7],["ἠδυνήθης",703838,168],["ἀποκαλύψαι",701474,106],["τὸ",709436,24],["μυστήριον",709080,25],["τοῦτο",709858,129]],"And the king answered and said to Daniel, Of a truth your God is a God of gods, and Lord of kings, who reveals mysteries; for thou hast been able to reveal this mystery."],["48",[["καὶ",707031,7],["ἐμεγάλυνεν",708647,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["τὸν",709436,5],["Δανιηλ",703283,6],["καὶ",707031,7],["δόματα",703789,42],["μεγάλα",708653,68],["καὶ",707031,7],["πολλὰ",710646,68],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["καὶ",707031,7],["κατέστησεν",707011,2],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["πάσης",710177,82],["χώρας",714011,17],["Βαβυλῶνος",702352,17],["καὶ",707031,7],["ἄρχοντα",701862,6],["σατραπῶν",711555,81],["ἐπὶ",705080,0],["πάντας",710177,60],["τοὺς",709436,58],["σοφοὺς",711985,60],["Βαβυλῶνος",702352,17]],"And the king promoted Daniel, and gave him great and abundant gifts, and set him over the whole province of Babylon, and [made him] chief satrap over all the wise men of Babylon."],["49",[["καὶ",707031,7],["Δανιηλ",703283,4],["ᾐτήσατο",700489,23],["παρὰ",709995,0],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["κατέστησεν",707011,2],["ἐπὶ",705080,0],["τὰ",709436,41],["ἔργα",705396,42],["τῆς",709436,16],["χώρας",714011,17],["Βαβυλῶνος",702352,17],["τὸν",709436,5],["Σεδραχ",711622,6],["Μισαχ",708933,6],["Αβδεναγω",700028,6],["καὶ",707031,7],["Δανιηλ",703283,4],["ἦν",704093,13],["ἐν",704639,0],["τῇ",709436,100],["αὐλῇ",702137,1],["τοῦ",709436,35],["βασιλέως",702580,18]],"And Daniel asked of the king, and he appointed Sedrach, Misach, and Abdenago, over the affairs of the province of Babylon: but Daniel was in the king's palace."]]