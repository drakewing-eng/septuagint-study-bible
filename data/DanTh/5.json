,704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["ἔπινον",710478,137],["ἐν",704639,0],["αὐτοῖς",702165,206],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["οἱ",709436,136],["μεγιστᾶνες",708657,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["αἱ",709436,190],["παλλακαὶ",709943,191],["αὐτοῦ",702165,102],["καὶ",707031,7],["αἱ",709436,190],["παράκοιτοι",710052,191],["αὐτοῦ",702165,102]],"So the gold and silver vessels were brought which [Nabuchodonosor] had taken out of the temple of God in Jerusalem; and the king, and his nobles, and his mistresses, and his concubines, drank out of them."],["4",[["ἔπινον",710478,137],["οἶνον",709530,6],["καὶ",707031,7],["ᾔνεσαν",700459,150],["τοὺς",709436,58],["θεοὺς",706192,57],["τοὺς",709436,58],["χρυσοῦς",713971,60],["καὶ",707031,7],["ἀργυροῦς",701705,60],["καὶ",707031,7],["χαλκοῦς",713690,60],["καὶ",707031,7],["σιδηροῦς",711771,60],["καὶ",707031,7],["ξυλίνους",709425,60],["καὶ",707031,7],["λιθίνους",708193,60]],"They drank wine, and praised the gods of gold, and of silver, and of brass, and of iron, and of wood, and of stone."],["5",[["ἐν",704639,0],["αὐτῇ",702165,105],["τῇ",709436,100],["ὥρᾳ",714128,1],["ἐξῆλθον",704909,150],["δάκτυλοι",703259,52],["χειρὸς",713787,17],["ἀνθρώπου",701163,18],["καὶ",707031,7],["ἔγραφον",703194,137],["κατέναντι",707507,0],["τῆς",709436,16],["λαμπάδος",708079,17],["ἐπὶ",705080,0],["τὸ",709436,24],["κονίαμα",707812,25],["τοῦ",709436,35],["τοίχου",712879,18],["τοῦ",709436,35],["οἴκου",709516,18],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐθεώρει",706226,13],["τοὺς",709436,58],["ἀστραγάλους",702020,57],["τῆς",709436,16],["χειρὸς",713787,17],["τῆς",709436,16],["γραφούσης",703194,222]],"In the same hour came forth fingers of a man's hand, and wrote in front of the lamp on the plaster of the wall of the king's house: and the king saw the knuckles of the hand that wrote."],["6",[["τότε",712908,28],["τοῦ",709436,35],["βασιλέως",702580,18],["ἡ",709436,10],["μορφὴ",709018,12],["ἠλλοιώθη",700694,37],["καὶ",707031,7],["οἱ",709436,136],["διαλογισμοὶ",703506,52],["αὐτοῦ",702165,102],["συνετάρασσον",712507,137],["αὐτόν",702165,85],["καὶ",707031,7],["οἱ",709436,136],["σύνδεσμοι",712416,52],["τῆς",709436,16],["ὀσφύος",709800,17],["αὐτοῦ",702165,102],["διελύοντο",703509,139],["καὶ",707031,7],["τὰ",709436,63],["γόνατα",703172,64],["αὐτοῦ",702165,102],["συνεκροτοῦντο",712235,139]],"Then the king's countenance changed, and his thoughts troubled him, and the joints of his loins were loosed, and his knees smote one another."],["7",[["καὶ",707031,7],["ἐβόησεν",702743,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐν",704639,0],["ἰσχύι",706858,1],["τοῦ",709436,20],["εἰσαγαγεῖν",704107,106],["μάγους",708347,57],["Χαλδαίους",713678,57],["γαζαρηνοὺς",702888,57],["καὶ",707031,7],["εἶπεν",705373,2],["τοῖς",709436,147],["σοφοῖς",711985,230],["Βαβυλῶνος",702352,17],["ὃς",709781,213],["ἂν",700900,11],["ἀναγνῷ",700922,172],["τὴν",709436,8],["γραφὴν",703191,9],["ταύτην",709858,104],["καὶ",707031,7],["τὴν",709436,8],["σύγκρισιν",712234,9],["γνωρίσῃ",703135,172],["μοι",708974,159],["πορφύραν",710682,9],["ἐνδύσεται",704701,134],["καὶ",707031,7],["ὁ",709436,3],["μανιάκης",708483,4],["ὁ",709436,3],["χρυσοῦς",713971,14],["ἐπὶ",705080,0],["τὸν",709436,5],["τράχηλον",712924,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["τρίτος",712968,14],["ἐν",704639,0],["τῇ",709436,100],["βασιλείᾳ",702577,1],["μου",709032,133],["ἄρξει",701860,127]],"And the king cried aloud to bring in the magicians, Chaldeans, [and] soothsayers; and he said to the wise men of Babylon, Whosoever shall read this writing, and make known to me the interpretation, shall be clothed with scarlet, and [there shall be] a golden chain upon his neck, and he shall be the third ruler in my kingdom."],["8",[["καὶ",707031,7],["εἰσεπορεύοντο",704124,139],["πάντες",710177,138],["οἱ",709436,136],["σοφοὶ",711985,138],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["οὐκ",709805,28],["ἠδύναντο",703838,139],["τὴν",709436,8],["γραφὴν",703191,9],["ἀναγνῶναι",700922,106],["οὐδὲ",709816,7],["τὴν",709436,8],["σύγκρισιν",712234,9],["γνωρίσαι",703135,106],["τῷ",709436,113],["βασιλεῖ",702580,114]],"Then came in all the king's wise men: but they could not read the writing, nor make known the interpretation to the king."],["9",[["καὶ",707031,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["Βαλτασαρ",702491,4],["πολὺ",710646,28],["ἐταράχθη",712721,37],["καὶ",707031,7],["ἡ",709436,10],["μορφὴ",709018,12],["αὐτοῦ",702165,102],["ἠλλοιώθη",700694,37],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["καὶ",707031,7],["οἱ",709436,136],["μεγιστᾶνες",708657,52],["αὐτοῦ",702165,102],["συνεταράσσοντο",712507,139]],"And king Baltasar was troubled, and his countenance changed upon him, and his nobles were troubled with him."],["10",[["καὶ",707031,7],["εἰσῆλθεν",704114,2],["ἡ",709436,10],["βασίλισσα",702584,12],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["πότου",710704,18],["καὶ",707031,7],["εἶπεν",705373,2],["βασιλεῦ",702580,153],["εἰς",704105,0],["τοὺς",709436,58],["αἰῶνας",700504,57],["ζῆθι",705851,240],["μὴ",708851,28],["ταρασσέτωσάν",712721,56],["σε",711598,163],["οἱ",709436,136],["διαλογισμοί",703506,52],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["μορφή",709018,12],["σου",711945,133],["μὴ",708851,28],["ἀλλοιούσθω",700694,407]],"Then the queen came into the banquet house, and said, O king, live for ever: let not thy thoughts trouble thee, and let not thy countenance be changed."],["11",[["ἔστιν",704093,91],["ἀνὴρ",701150,4],["ἐν",704639,0],["τῇ",709436,100],["βασιλείᾳ",702577,1],["σου",711945,133],["ἐν",704639,0],["ᾧ",709781,309],["πνεῦμα",710566,15],["θεοῦ",706192,18],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["γρηγόρησις",703196,12],["καὶ",707031,7],["σύνεσις",712460,12],["εὑρέθη",705676,37],["ἐν",704639,0],["αὐτῷ",702165,50],["καὶ",707031,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ναβουχοδονοσορ",709149,4],["ὁ",709436,3],["πατήρ",710189,4],["σου",711945,133],["ἄρχοντα",701862,6],["ἐπαοιδῶν",705035,81],["μάγων",708347,81],["Χαλδαίων",713678,81],["γαζαρηνῶν",702888,81],["κατέστησεν",707011,2],["αὐτόν",702165,85]],"There is a man in thy kingdom, in whom is the Spirit of God; and in the days of thy father watchfulness and understanding were found in him; and king Nabuchodonosor thy father made him chief of the enchanters, magicians, Chaldeans, [and] soothsayers."],["12",[["ὅτι",709803,7],["πνεῦμα",710566,15],["περισσὸν",710387,26],["ἐν",704639,0],["αὐτῷ",702165,50],["καὶ",707031,7],["φρόνησις",713588,12],["καὶ",707031,7],["σύνεσις",712460,12],["συγκρίνων",712233,72],["ἐνύπνια",704818,42],["καὶ",707031,7],["ἀναγγέλλων",700921,72],["κρατούμενα",707879,67],["καὶ",707031,7],["λύων",708288,72],["συνδέσμους",712416,57],["Δανιηλ",703283,4],["καὶ",707031,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐπέθηκεν",705304,2],["αὐτῷ",702165,50],["ὄνομα",709666,25],["Βαλτασαρ",702491,227],["νῦν",709384,28],["οὖν",709835,11],["κληθήτω",707084,22],["καὶ",707031,7],["τὴν",709436,8],["σύγκρισιν",712234,9],["αὐτοῦ",702165,49],["ἀναγγελεῖ",700921,127],["σοι",711925,159]],"For [there is] an excellent spirit in him, and sense and understanding are in him, interpreting dreams [as he does], and answering hard [questions], and solving difficulties: [it is] Daniel, and the king gave him the name of Baltasar: now then let him be called, and he shall tell thee the interpretation of the writing."],["13",[["τότε",712908,28],["Δανιηλ",703283,4],["εἰσήχθη",704107,37],["ἐνώπιον",704823,0],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["τῷ",709436,113],["Δανιηλ",703283,114],["σὺ",712181,164],["εἶ",704093,154],["Δανιηλ",703283,4],["ὁ",709436,3],["ἀπὸ",701425,0],["τῶν",709436,80],["υἱῶν",713075,81],["τῆς",709436,16],["αἰχμαλωσίας",700499,17],["τῆς",709436,16],["Ιουδαίας",706769,17],["ἧς",709781,167],["ἤγα