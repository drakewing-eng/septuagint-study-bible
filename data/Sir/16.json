[["1",[["μὴ",708851,28],["ἐπιθύμει",705141,240],["τέκνων",712761,44],["πλῆθος",710529,25],["ἀχρήστων",702312,83],["μηδὲ",708855,7],["εὐφραίνου",705715,253],["ἐπὶ",705080,0],["υἱοῖς",713075,148],["ἀσεβέσιν",701909,230]],"Desire not a multitude of unprofitable children, neither delight in ungodly sons."],["2",[["ἐὰν",703912,7],["πληθύνωσιν",710530,271],["μὴ",708851,28],["εὐφραίνου",705715,253],["ἐπ᾿",705080,0],["αὐτοῖς",702165,151],["εἰ",704071,7],["μή",708851,28],["ἐστιν",704093,91],["φόβος",713534,4],["κυρίου",707996,18],["μετ᾿",708780,0],["αὐτῶν",702165,40]],"Though they multiply, rejoice not in them, except the fear of the Lord be with them."],["3",[["μὴ",708851,28],["ἐμπιστεύσῃς",704594,175],["τῇ",709436,100],["ζωῇ",705910,1],["αὐτῶν",702165,40],["καὶ",707031,7],["μὴ",708851,28],["ἔπεχε",705076,240],["ἐπὶ",705080,0],["τὸ",709436,24],["πλῆθος",710529,25],["αὐτῶν",702165,40],["κρείσσων",707891,14],["γὰρ",702963,11],["εἷς",704106,59],["ἢ",705924,7],["χίλιοι",713859,138],["καὶ",707031,7],["ἀποθανεῖν",701461,106],["ἄτεκνον",702080,27],["ἢ",705924,7],["ἔχειν",705785,55],["τέκνα",712761,42],["ἀσεβῆ",701909,68]],"Trust not thou in their life, neither respect their multitude: for one that is just is better than a thousand; and better it is to die without children, than to have them that are ungodly."],["4",[["ἀπὸ",701425,0],["γὰρ",702963,11],["ἑνὸς",704106,116],["συνετοῦ",712464,116],["συνοικισθήσεται",712495,134],["πόλις",710612,12],["φυλὴ",713620,12],["δὲ",703303,11],["ἀνόμων",701194,169],["ἐρημωθήσεται",705421,134]],"For by one that hath understanding shall the city be replenished: but the kindred of the wicked shall speedily become desolate."],["5",[["πολλὰ",710646,68],["τοιαῦτα",712878,68],["ἑόρακεν",709725,171],["ὁ",709436,3],["ὀφθαλμός",709870,4],["μου",709032,133],["καὶ",707031,7],["ἰσχυρότερα",706855,484],["τούτων",709858,70],["ἀκήκοεν",700587,171],["τὸ",709436,34],["οὖς",709852,15],["μου",709032,133]],"Many such things have I seen with mine eyes, and mine ear hath heard greater things than these."],["6",[["ἐν",704639,0],["συναγωγῇ",712376,1],["ἁμαρτωλῶν",700776,169],["ἐκκαυθήσεται",704205,134],["πῦρ",711088,15],["καὶ",707031,7],["ἐν",704639,0],["ἔθνει",704068,54],["ἀπειθεῖ",701371,97],["ἐξεκαύθη",704205,37],["ὀργή",709728,12]],"In the congregation of the ungodly shall a fire be kindled; and in a rebellious nation wrath is set on fire."],["7",[["οὐκ",709805,28],["ἐξιλάσατο",704932,23],["περὶ",710285,0],["τῶν",709436,80],["ἀρχαίων",701835,169],["γιγάντων",703101,81],["οἳ",709781,250],["ἀπέστησαν",702214,150],["τῇ",709436,100],["ἰσχύι",706858,1],["αὐτῶν",702165,40]],"He was not pacified toward the old giants, who fell away in the strength of their foolishness."],["8",[["οὐκ",709805,28],["ἐφείσατο",713406,23],["περὶ",710285,0],["τῆς",709436,16],["παροικίας",710158,17],["Λωτ",708293,18],["οὓς",709781,298],["ἐβδελύξατο",702608,23],["διὰ",703417,0],["τὴν",709436,8],["ὑπερηφανίαν",713138,9],["αὐτῶν",702165,40]],"Neither spared he the place where Lot sojourned, but abhorred them for their pride."],["9",[["οὐκ",709805,28],["ἠλέησεν",704418,2],["ἔθνος",704068,25],["ἀπωλείας",701660,17],["τοὺς",709436,58],["ἐξηρμένους",704839,525],["ἐν",704639,0],["ἁμαρτίαις",700775,76],["αὐτῶν",702165,40]],"He pitied not the people of perdition, who were taken away in their sins:"],["10",[["καὶ",707031,7],["οὕτως",709859,28],["ἑξακοσίας",704847,119],["χιλιάδας",713858,39],["πεζῶν",710219,169],["τοὺς",709436,58],["ἐπισυναχθέντας",705280,460],["ἐν",704639,0],["σκληροκαρδίᾳ",711859,1],["αὐτῶν",702165,40]],"nor the six hundred thousand footmen, who were gathered together in the hardness of their hearts."],["11",[["κἂν",707120,459],["ᾖ",704093,204],["εἷς",704106,59],["σκληροτράχηλος",711863,14],["θαυμαστὸν",706138,26],["τοῦτο",709858,132],["εἰ",704071,7],["ἀθῳωθήσεται",700391,134],["ἔλεος",704426,15],["γὰρ",702963,11],["καὶ",707031,7],["ὀργὴ",709728,12],["παρ᾿",709995,0],["αὐτῷ",702165,50],["δυνάστης",703844,4],["ἐξιλασμῶν",704934,81],["καὶ",707031,7],["ἐκχέων",704368,72],["ὀργήν",709728,9]],"And if there be one stiffnecked among the people, it is marvel if he escape unpunished: for mercy and wrath are with him; he is mighty to forgive and to pour out displeasure."],["12",[["κατὰ",707200,0],["τὸ",709436,24],["πολὺ",710646,46],["ἔλεος",704426,25],["αὐτοῦ",702165,102],["οὕτως",709859,28],["καὶ",707031,28],["πολὺς",710646,14],["ὁ",709436,3],["ἔλεγχος",704415,4],["αὐτοῦ",702165,102],["ἄνδρα",701150,6],["κατὰ",707200,0],["τὰ",709436,41],["ἔργα",705396,42],["αὐτοῦ",702165,102],["κρινεῖ",707905,127]],"As his mercy is great, so is his correction also: he judgeth a man according to his works."],["13",[["οὐκ",709805,28],["ἐκφεύξεται",704357,93],["ἐν",704639,0],["ἁρπάγματι",701803,54],["ἁμαρτωλός",700776,14],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["καθυστερήσει",707027,127],["ὑπομονὴ",713226,12],["εὐσεβοῦς",705687,116]],"The sinner shall not escape with his spoils: and the patience of the godly shall not be frustrate."],["14",[["πάσῃ",710177,101],["ἐλεημοσύνῃ",704421,1],["ποιήσει",710582,127],["τόπον",712903,6],["ἕκαστος",704133,14],["κατὰ",707200,0],["τὰ",709436,41],["ἔργα",705396,42],["αὐτοῦ",702165,102],["εὑρήσει",705676,127]],"Make way for every work of mercy: for every man shall find according to his works."],["17",[["μὴ",708851,28],["εἴπῃς",705373,175],["ὅτι",709803,7],["ἀπὸ",701425,0],["κυρίου",707996,18],["κρυβήσομαι",707923,180],["καὶ",707031,7],["ἐξ",704132,0],["ὕψους",713288,21],["τίς",712866,158],["μου",709032,133],["μνησθήσεται",708923,134],["ἐν",704639,0],["λαῷ",708094,114],["πλείονι",710646,30],["οὐ",709805,28],["μὴ",708851,28],["γνωσθῶ",703105,321],["τίς",712867,158],["γὰρ",702963,11],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ἐν",704639,0],["ἀμετρήτῳ",700816,101],["κτίσει",707939,1]],"Say not thou, I will hide myself from the Lord: shall any remember me from above? I shall not be remembered among so many people: for what is my soul among such an infinite number of creatures?"],["18",[["ἰδοὺ",709725,300],["ὁ",709436,3],["οὐρανὸς",709844,4],["καὶ",707031,7],["ὁ",709436,3],["οὐρανὸς",709844,4],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["ἄβυσσος",700098,4],["καὶ",707031,7],["γῆ",703083,12],["ἐν",704639,0],["τῇ",709436,100],["ἐπισκοπῇ",705255,1],["αὐτοῦ",702165,102],["σαλευθήσονται",711403,134]],"Behold, the heaven, and the heaven of heavens, the deep, and the earth, and all that therein is, shall be moved when he shall visit."],["19",[["ἅμα",700745,28],["τὰ",709436,63],["ὄρη",709768,64],["καὶ",707031,7],["τὰ",709436,63],["θεμέλια",706181,64],["τῆς",709436,16],["γῆς",703083,17],["ἐν",704639,0],["τῷ",709436,53],["ἐπιβλέψαι",705088,106],["εἰς",704105,0],["αὐτὰ",702165,71],["τρόμῳ",712975,114],["συσσείονται",712554,269]],"The mountains also and foundations of the earth shall be shaken with trembling, when he looketh upon them."],["20",[["καὶ",707031,7],["ἐπ᾿",705080,0],["αὐτοῖς",702165,206],["οὐ",709805,28],["διανοηθήσεται",703528,134],["καρδία",707141,12],["καὶ",707031,7],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτοῦ",702165,102],["τίς",712867,158],["ἐνθυμηθήσεται",704739,134]],"No heart can think upon these things worthily: and who is able to conceive his ways?"],["21",[["καὶ",707031,7],["καταιγίς",707254,12],["ἣν",709781,131],["οὐκ",709805,28],["ὄψεται",709725,93],["ἄνθρωπος",701163,4],["τὰ",709436,63],["δὲ",703303,11],["πλείονα",710514,195],["τῶν",709436,43],["ἔργων",705396,44],["αὐτοῦ",702165,102],["ἐν",704639,0],["ἀποκρύφοις",701497,97]],"It is a tempest which no man can see: for the most part of his works are hid."],["22",[["ἔργα",705396,42],["δικαιοσύνης",703695,17],["τίς",712867,158],["ἀναγγελεῖ",700921,127],["ἢ",705924,7],["τίς",712867,158],["ὑπομενεῖ",713219,127],["μακρὰν",708411,28],["γὰρ",702963,11],["ἡ",709436,10],["διαθήκη",703456,12]],"Who can declare the works of his justice? or who can endure them? for his covenant is afar off."],["23",[["ἐλαττούμενος",704394,122],["καρδίᾳ",707141,1],["διανοεῖται",703528,117],["ταῦτα",709858,71],["καὶ",707031,7],["ἀνὴρ",701150,4],["ἄφρων",702236,14],["καὶ",707031,7],["πλανώμενος",710495,122],["διανοεῖται",703528,117],["μωρά",709110,68]],"He that wanteth understanding will think upon vain things: and a foolish man erring imagineth follies."],["24",[["ἄκουσόν",700587,176],["μου",709032,133],["τέκνον",712761,297],["καὶ",707031,7],["μάθε",708480,176],["ἐπιστήμην",705267,9],["καὶ",707031,7],["ἐπὶ",705080,0],["τῶν",709436,80],["λόγων",708236,81],["μου",709032,133],["πρόσεχε",710895,240],["τῇ",709436,100],["καρδίᾳ",707141,1],["σου",711945,133]],"My son, hearken unto me, and learn knowledge, and mark my words with thy heart."],["25",[["ἐκφανῶ",704354,165],["ἐν",704639,0],["σταθμῷ",712040,114],["παιδείαν",709924,9],["καὶ",707031,7],["ἐν",704639,0],["ἀκριβείᾳ",700596,1],["ἀπαγγελῶ",701321,165],["ἐπιστήμην",705267,9]],"I will shew forth doctrine in weight, and declare his knowledge exactly."],["26",[["ἐν",704639,0],["κρίσει",707908,1],["κυρίου",707996,18],["τὰ",709436,63],["ἔργα",705396,64],["αὐτοῦ",702165,102],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["καὶ",707031,7],["ἀπὸ",701425,0],["ποιήσεως",710584,17],["αὐτῶν",702165,70],["διέστειλεν",703588,2],["μερίδας",708748,39],["αὐτῶν",702165,70]],"The works of the Lord are done in judgment from the beginning: and from the time he made them he disposed the parts thereof."],["27",[["ἐκόσμησεν",707847,2],["εἰς",704105,0],["αἰῶνα",700504,6],["τὰ",709436,41],["ἔργα",705396,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰς",709436,38],["ἀρχὰς",701836,39],["αὐτῶν",702165,70],["εἰς",704105,0],["γενεὰς",703037,39],["αὐτῶν",702165,70],["οὔτε",709857,7],["ἐπείνασαν",710222,150],["οὔτε",709857,7],["ἐκοπίασαν",707824,150],["καὶ",707031,7],["οὐκ",709805,28],["ἐξέλιπον",704237,150],["ἀπὸ",701425,0],["τῶν",709436,43],["ἔργων",705396,44],["αὐτῶν",702165,70]],"He garnished his works for ever, and the chief of them unto all generations: they neither labour, nor are weary, nor cease from their works."],["28",[["ἕκαστος",704133,14],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐξέθλιψεν",704199,2],["καὶ",707031,7],["ἕως",705792,0],["αἰῶνος",700504,18],["οὐκ",709805,28],["ἀπειθήσουσιν",701370,218],["τοῦ",709436,20],["ῥήματος",711246,21],["αὐτοῦ",702165,102]],"None of them hindereth another, and they shall never disobey his word."],["29",[["καὶ",707031,7],["μετὰ",708780,0],["ταῦτα",709858,71],["κύριος",707996,4],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ἐπέβλεψεν",705088,2],["καὶ",707031,7],["ἐνέπλησεν",704592,2],["αὐτὴν",702165,104],["τῶν",709436,43],["ἀγαθῶν",700106,83],["αὐτοῦ",702165,102]],"After this the Lord looked upon the earth, and filled it with his blessings."],["30",[["ψυχῇ",714070,1],["παντὸς",710177,92],["ζῴου",705916,21],["ἐκάλυψεν",707102,2],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτῆς",702165,86],["καὶ",707031,7],["εἰς",704105,0],["αὐτὴν",702165,104],["ἡ",709436,10],["ἀποστροφὴ",701599,12],["αὐτῶν",702165,70]],"With all manner of living things hath he covered the face thereof; and they shall return into it again."]]