[["1",[["ἀγρυπνία",700198,12],["πλούτου",710563,18],["ἐκτήκει",704329,91],["σάρκας",711537,39],["καὶ",707031,7],["ἡ",709436,10],["μέριμνα",708745,12],["αὐτοῦ",702165,102],["ἀφιστᾷ",702214,91],["ὕπνον",713181,6]],"The hopes of a man void of understanding are vain and false: and dreams lift up fools."],["2",[["μέριμνα",708745,12],["ἀγρυπνίας",700198,17],["ἀποστήσει",702214,127],["νυσταγμόν",709389,6],["καὶ",707031,7],["ἀρρώστημα",701812,15],["βαρὺ",702554,26],["ἐκνήψει",704265,127],["ὕπνον",713181,6]],"Whoso regardeth dreams is like him that catcheth at a shadow, and followeth after the wind."],["3",[["ἐκοπίασεν",707824,2],["πλούσιος",710560,14],["ἐν",704639,0],["συναγωγῇ",712376,1],["χρημάτων",713948,44],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["ἀναπαύσει",701026,1],["ἐμπίμπλαται",704592,117],["τῶν",709436,43],["τρυφημάτων",713009,44],["αὐτοῦ",702165,102]],"The vision of dreams is the resemblance of one thing to another, even as the likeness of a face to a face."],["4",[["ἐκοπίασεν",707824,2],["πτωχὸς",711076,4],["ἐν",704639,0],["ἐλαττώσει",704396,1],["βίου",702724,18],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["ἀναπαύσει",701026,1],["ἐπιδεὴς",705111,14],["γίνεται",703104,117]],"Of an unclean thing what can be cleansed? and from that thing which is false what truth can come?"],["5",[["ὁ",709436,3],["ἀγαπῶν",700120,72],["χρυσίον",713972,25],["οὐ",709805,28],["δικαιωθήσεται",703696,134],["καὶ",707031,7],["ὁ",709436,3],["διώκων",703768,72],["διάφορα",703630,68],["ἐν",704639,0],["αὐτοῖς",702165,206],["πλανηθήσεται",710495,134]],"Divinations, and soothsayings, and dreams, are vain: and the heart fancieth, as a woman's heart in travail."],["6",[["πολλοὶ",710646,138],["ἐδόθησαν",703654,99],["εἰς",704105,0],["πτῶμα",711071,25],["χάριν",713735,9],["χρυσίου",713972,21],["καὶ",707031,7],["ἐγενήθη",703104,37],["ἡ",709436,10],["ἀπώλεια",701660,12],["αὐτῶν",702165,40],["κατὰ",707200,0],["πρόσωπον",710986,25],["αὐτῶν",702165,40]],"If they be not sent from the most High in thy visitation, set not thy heart upon them."],["7",[["ξύλον",709427,25],["προσκόμματός",710922,21],["ἐστιν",704093,91],["τοῖς",709436,147],["ἐνθουσιάζουσιν",704736,349],["αὐτῷ",702165,280],["καὶ",707031,7],["πᾶς",710177,14],["ἄφρων",702236,14],["ἁλώσεται",700673,93],["ἐν",704639,0],["αὐτῷ",702165,280]],"For dreams have deceived many, and they have failed that put their trust in them."],["8",[["μακάριος",708397,14],["πλούσιος",710560,14],["ὃς",709781,213],["εὑρέθη",705676,37],["ἄμωμος",700895,14],["καὶ",707031,7],["ὃς",709781,213],["ὀπίσω",709697,28],["χρυσίου",713972,21],["οὐκ",709805,28],["ἐπορεύθη",710667,37]],"The law shall be found perfect without lies: and wisdom is perfection to a faithful mouth."],["9",[["τίς",712867,158],["ἐστιν",704093,91],["καὶ",707031,7],["μακαριοῦμεν",708396,275],["αὐτόν",702165,85],["ἐποίησεν",710582,2],["γὰρ",702963,11],["θαυμάσια",706136,68],["ἐν",704639,0],["λαῷ",708094,114],["αὐτοῦ",702165,102]],"A man that hath travelled knoweth many things: and he that hath much experience will declare wisdom."],["10",[["τίς",712867,158],["ἐδοκιμάσθη",703776,37],["ἐν",704639,0],["αὐτῷ",702165,280],["καὶ",707031,7],["ἐτελειώθη",712771,37],["καὶ",707031,7],["ἔσται",704093,93],["αὐτῷ",702165,50],["εἰς",704105,0],["καύχησιν",707571,9],["τίς",712867,158],["ἐδύνατο",703838,19],["παραβῆναι",709996,106],["καὶ",707031,7],["οὐ",709805,28],["παρέβη",709996,2],["καὶ",707031,7],["ποιῆσαι",710582,106],["κακὰ",707066,68],["καὶ",707031,7],["οὐκ",709805,28],["ἐποίησεν",710582,2]],"He that hath no experience knoweth little: but he that hath travelled is full of prudence."],["11",[["στερεωθήσεται",712076,134],["τὰ",709436,41],["ἀγαθὰ",700106,68],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰς",709436,38],["ἐλεημοσύνας",704421,39],["αὐτοῦ",702165,102],["ἐκδιηγήσεται",704172,93],["ἐκκλησία",704216,12]],"When I travelled, I saw many things; and I understand more than I can express."],["12",[["ἐπὶ",705080,0],["τραπέζης",712919,17],["μεγάλης",708653,82],["ἐκάθισας",707006,162],["μὴ",708851,28],["ἀνοίξῃς",701186,175],["ἐπ᾿",705080,0],["αὐτῆς",702165,86],["φάρυγγά",713375,9],["σου",711945,133],["καὶ",707031,7],["μὴ",708851,28],["εἴπῃς",705373,175],["πολλά",710646,195],["γε",702985,11],["τὰ",709436,63],["ἐπ᾿",705080,0],["αὐτῆς",702165,86]],"I was oft-times in danger of death: yet I was delivered because of these things."],["13",[["μνήσθητι",708960,244],["ὅτι",709803,7],["κακὸν",707066,26],["ὀφθαλμὸς",709870,4],["πονηρός",710660,14],["πονηρότερον",710660,385],["ὀφθαλμοῦ",709870,18],["τί",712867,273],["ἔκτισται",707938,187],["διὰ",703417,0],["τοῦτο",709858,129],["ἀπὸ",701425,0],["παντὸς",710177,92],["προσώπου",710986,21],["δακρύει",703256,91]],"The spirit of those that fear the Lord shall live; for their hope is in him that saveth them."],["14",[["οὗ",709781,160],["ἐὰν",703912,7],["ἐπιβλέψῃ",705088,420],["μὴ",708851,28],["ἐκτείνῃς",704322,175],["χεῖρα",713787,9],["καὶ",707031,7],["μὴ",708851,28],["συνθλίβου",712480,253],["αὐτῷ",702165,280],["ἐν",704639,0],["τρυβλίῳ",712995,54]],"Whoso feareth the Lord shall not fear nor be afraid; for he is his hope."],["15",[["νόει",709327,240],["τὰ",709436,41],["τοῦ",709436,35],["πλησίον",710547,28],["ἐκ",704132,0],["σεαυτοῦ",711599,102],["καὶ",707031,7],["ἐπὶ",705080,0],["παντὶ",710177,97],["πράγματι",710708,54],["διανοοῦ",703528,253]],"Blessed is the soul of him that feareth the Lord: to whom doth he look? and who is his strength?"],["16",[["φάγε",713296,176],["ὡς",714148,7],["ἄνθρωπος",701163,4],["τὰ",709436,41],["παρακείμενά",710044,67],["σοι",711925,159],["καὶ",707031,7],["μὴ",708851,28],["διαμασῶ",703514,253],["μὴ",708851,28],["μισηθῇς",708935,279]],"For the eyes of the Lord are upon them that love him, he is their mighty protection and strong stay, a defence from heat, and a cover from the sun at noon, a preservation from stumbling, and an help from falling;"],["17",[["παῦσαι",710202,300],["πρῶτος",711041,140],["χάριν",713735,9],["παιδείας",709924,17],["καὶ",707031,7],["μὴ",708851,28],["ἀπληστεύου",701416,253],["μήποτε",708882,28],["προσκόψῃς",710923,175]],"he raiseth up the soul, and lighteneth the eyes: he giveth health, life, and blessing."],["18",[["καὶ",707031,7],["εἰ",704071,7],["ἀνὰ",700902,0],["μέσον",708768,27],["πλειόνων",710514,169],["ἐκάθισας",707006,162],["πρότερος",710992,224],["αὐτῶν",702165,40],["μὴ",708851,28],["ἐκτείνῃς",704322,175],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133]],"He that sacrificeth of a thing wrongfully gotten, his offering is ridiculous; and the gifts of unjust men are not accepted."],["19",[["ὡς",714148,7],["ἱκανὸν",706710,26],["ἀνθρώπῳ",701163,114],["πεπαιδευμένῳ",709926,516],["τὸ",709436,34],["ὀλίγον",709568,26],["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["κοίτης",707781,17],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἀσθμαίνει",701943,91]],"The most High is not pleased with the offerings of the wicked; neither is he pacified for sin by the multitude of sacrifices."],["20",[["ὕπνος",713181,4],["ὑγιείας",713058,17],["ἐπὶ",705080,0],["ἐντέρῳ",704792,54],["μετρίῳ",708844,97],["ἀνέστη",701173,2],["πρωί",711021,28],["καὶ",707031,7],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτοῦ",702165,102],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["πόνος",710661,4],["ἀγρυπνίας",700198,17],["καὶ",707031,7],["χολέρας",713899,17],["καὶ",707031,7],["στρόφος",712171,4],["μετὰ",708780,0],["ἀνδρὸς",701150,18],["ἀπλήστου",701418,116]],"Whoso bringeth an offering of the goods of the poor doeth as one that killeth the son before his father's eyes."],["21",[["καὶ",707031,7],["εἰ",704071,7],["ἐβιάσθης",702713,168],["ἐν",704639,0],["ἐδέσμασιν",704032,96],["ἀνάστα",701173,176],["ἔμεσον",704563,176],["πόρρω",710680,28],["καὶ",707031,7],["ἀναπαύσῃ",701027,172]],"The bread of the needy is their life: he that defraudeth him thereof is a man of blood."],["22",[["ἄκουσόν",700587,176],["μου",709032,133],["τέκνον",712761,297],["καὶ",707031,7],["μὴ",708851,28],["ἐξουδενήσῃς",704969,175],["με",708618,163],["καὶ",707031,7],["ἐπ᾿",705080,0],["ἐσχάτων",705519,83],["εὑρήσεις",705676,166],["τοὺς",709436,58],["λόγους",708236,57],["μου",709032,133],["ἐν",704639,0],["πᾶσι",710177,94],["τοῖς",709436,95],["ἔργοις",705396,96],["σου",711945,133],["γίνου",703104,253],["ἐντρεχής",704806,14],["καὶ",707031,7],["πᾶν",710177,26],["ἀρρώστημα",701812,15],["οὐ",709805,28],["μή",708851,28],["σοι",711925,159],["ἀπαντήσῃ",701345,123]],"He that taketh away his neighbour's living slayeth him; and he that defraudeth the labourer his hire is a bloodshedder."],["23",[["λαμπρὸν",708082,27],["ἐπ᾿",705080,0],["ἄρτοις",701829,148],["εὐλογήσει",705631,127],["χείλη",713781,64],["καὶ",707031,7],["ἡ",709436,10],["μαρτυρία",708524,12],["τῆς",709436,16],["καλλονῆς",707092,17],["αὐτοῦ",702165,102],["πιστή",710486,29]],"When one buildeth, and another pulleth down, what profit have they then but labour?"],["24",[["πονηρῷ",710660,30],["ἐπ᾿",705080,0],["ἄρτῳ",701829,114],["διαγογγύσει",703438,127],["πόλις",710612,12],["καὶ",707031,7],["ἡ",709436,10],["μαρτυρία",708524,12],["τῆς",709436,16],["πονηρίας",710659,17],["αὐτοῦ",702165,102],["ἀκριβής",700597,29]],"When one prayeth, and another curseth, whose voice will the Lord hear?"],["25",[["ἐν",704639,0],["οἴνῳ",709530,114],["μὴ",708851,28],["ἀνδρίζου",701104,253],["πολλοὺς",710646,60],["γὰρ",702963,11],["ἀπώλεσεν",701513,2],["ὁ",709436,3],["οἶνος",709530,4]],"He that washeth himself after the touching of a dead body, if he touch it again, what availeth his washing?"],["26",[["κάμινος",707113,12],["δοκιμάζει",703776,91],["στόμωμα",712126,25],["ἐν",704639,0],["βαφῇ",702601,1],["οὕτως",709859,28],["οἶνος",709530,4],["καρδίας",707141,39],["ἐν",704639,0],["μάχῃ",708601,1],["ὑπερηφάνων",713139,169]],"So is it with a man that fasteth for his sins, and goeth again, and doeth the same: who will hear his prayer? or what doth his humbling profit him?"],["27",[["ἔφισον",705257,14],["ζωῆς",705910,17],["οἶνος",709530,4],["ἀνθρώποις",701163,148],["ἐὰν",703912,7],["πίνῃς",710478,205],["αὐτὸν",702165,85],["ἐν",704639,0],["μέτρῳ",708846,54],["αὐτοῦ",702165,102],["τίς",712867,359],["ζωὴ",705910,12],["ἐλασσουμένῳ",704394,241],["οἴνῳ",709530,114],["καὶ",707031,7],["αὐτὸς",702165,121],["ἔκτισται",707938,187],["εἰς",704105,0],["εὐφροσύνην",705717,9],["ἀνθρώποις",701163,148]],null],["28",[["ἀγαλλίαμα",700112,15],["καρδίας",707141,17],["καὶ",707031,7],["εὐφροσύνη",705717,12],["ψυχῆς",714070,17],["οἶνος",709530,4],["πινόμενος",710478,122],["ἐν",704639,0],["καιρῷ",707047,114],["αὐτάρκης",702157,14]],null],["29",[["πικρία",710472,12],["ψυχῆς",714070,17],["οἶνος",709530,4],["πινόμενος",710478,122],["πολὺς",710646,14],["ἐν",704639,0],["ἐρεθισμῷ",705402,114],["καὶ",707031,7],["ἀντιπτώματι",701271,54]],null],["30",[["πληθύνει",710530,91],["μέθη",708667,14],["θυμὸν",706334,6],["ἄφρονος",702236,116],["εἰς",704105,0],["πρόσκομμα",710922,25],["ἐλαττῶν",704394,72],["ἰσχὺν",706858,9],["καὶ",707031,7],["προσποιῶν",710953,72],["τραύματα",712920,42]],null],["31",[["ἐν",704639,0],["συμποσίῳ",712345,54],["οἴνου",709530,18],["μὴ",708851,28],["ἐλέγξῃς",704416,175],["τὸν",709436,5],["πλησίον",710547,28],["καὶ",707031,7],["μὴ",708851,28],["ἐξουθενήσῃς",704969,175],["αὐτὸν",702165,85],["ἐν",704639,0],["εὐφροσύνῃ",705717,1],["αὐτοῦ",702165,102],["λόγον",708236,6],["ὀνειδισμοῦ",709657,18],["μὴ",708851,28],["εἴπῃς",705373,175],["αὐτῷ",702165,50],["καὶ",707031,7],["μὴ",708851,28],["αὐτὸν",702165,85],["θλίψῃς",706274,175],["ἐν",704639,0],["ἀπαιτήσει",701331,1]],null]]