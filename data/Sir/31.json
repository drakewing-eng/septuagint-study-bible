[["1",[["ἀγρυπνία",700198,12],["πλούτου",710563,18],["ἐκτήκει",704329,91],["σάρκας",711537,39],["καὶ",707031,7],["ἡ",709436,10],["μέριμνα",708745,12],["αὐτοῦ",702165,102],["ἀφιστᾷ",702214,91],["ὕπνον",713181,6]],"Watching for riches consumeth the flesh, and the care thereof driveth away sleep.",{"s":"m","br":"34:1","q":1.0}],["2",[["μέριμνα",708745,12],["ἀγρυπνίας",700198,17],["ἀποστήσει",702214,127],["νυσταγμόν",709389,6],["καὶ",707031,7],["ἀρρώστημα",701812,15],["βαρὺ",702554,26],["ἐκνήψει",704265,127],["ὕπνον",713181,6]],"Watching care will not let a man slumber, as a sore disease breaketh sleep.",{"s":"m","br":"34:2","q":0.78}],["3",[["ἐκοπίασεν",707824,2],["πλούσιος",710560,14],["ἐν",704639,0],["συναγωγῇ",712376,1],["χρημάτων",713948,44],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["ἀναπαύσει",701026,1],["ἐμπίμπλαται",704592,117],["τῶν",709436,43],["τρυφημάτων",713009,44],["αὐτοῦ",702165,102]],"The rich hath great labour in gathering riches together; and when he resteth, he is filled with his delicacies.",{"s":"m","br":"34:3","q":0.92}],["4",[["ἐκοπίασεν",707824,2],["πτωχὸς",711076,4],["ἐν",704639,0],["ἐλαττώσει",704396,1],["βίου",702724,18],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["ἀναπαύσει",701026,1],["ἐπιδεὴς",705111,14],["γίνεται",703104,117]],"The poor laboureth in his poor estate; and when he leaveth off, he is still needy.",{"s":"m","br":"34:4","q":1.0}],["5",[["ὁ",709436,3],["ἀγαπῶν",700120,72],["χρυσίον",713972,25],["οὐ",709805,28],["δικαιωθήσεται",703696,134],["καὶ",707031,7],["ὁ",709436,3],["διώκων",703768,72],["διάφορα",703630,68],["ἐν",704639,0],["αὐτοῖς",702165,206],["πλανηθήσεται",710495,134]],"He that loveth gold shall not be justified, and he that followeth corruption shall have enough thereof.",{"s":"m","br":"34:5","q":0.67,"gd":0.67}],["6",[["πολλοὶ",710646,138],["ἐδόθησαν",703654,99],["εἰς",704105,0],["πτῶμα",711071,25],["χάριν",713735,9],["χρυσίου",713972,21],["καὶ",707031,7],["ἐγενήθη",703104,37],["ἡ",709436,10],["ἀπώλεια",701660,12],["αὐτῶν",702165,40],["κατὰ",707200,0],["πρόσωπον",710986,25],["αὐτῶν",702165,40]],"Gold hath been the ruin of many, and their destruction was present.",{"s":"m","br":"34:6","q":0.93}],["7",[["ξύλον",709427,25],["προσκόμματός",710922,21],["ἐστιν",704093,91],["τοῖς",709436,147],["ἐνθουσιάζουσιν",704736,349],["αὐτῷ",702165,280],["καὶ",707031,7],["πᾶς",710177,14],["ἄφρων",702236,14],["ἁλώσεται",700673,93],["ἐν",704639,0],["αὐτῷ",702165,280]],"It is a stumblingblock unto them that sacrifice unto it, and every fool shall be taken therewith.",{"s":"m","br":"34:7","q":0.83}],["8",[["μακάριος",708397,14],["πλούσιος",710560,14],["ὃς",709781,213],["εὑρέθη",705676,37],["ἄμωμος",700895,14],["καὶ",707031,7],["ὃς",709781,213],["ὀπίσω",709697,28],["χρυσίου",713972,21],["οὐκ",709805,28],["ἐπορεύθη",710667,37]],"Blessed is the rich that is found without blemish, and hath not gone after gold.",{"s":"m","br":"34:8","q":1.0}],["9",[["τίς",712867,158],["ἐστιν",704093,91],["καὶ",707031,7],["μακαριοῦμεν",708396,275],["αὐτόν",702165,85],["ἐποίησεν",710582,2],["γὰρ",702963,11],["θαυμάσια",706136,68],["ἐν",704639,0],["λαῷ",708094,114],["αὐτοῦ",702165,102]],"Who is he? and we will call him blessed: for wonderful things hath he done among his people.",{"s":"m","br":"34:9","q":0.91}],["10",[["τίς",712867,158],["ἐδοκιμάσθη",703776,37],["ἐν",704639,0],["αὐτῷ",702165,280],["καὶ",707031,7],["ἐτελειώθη",712771,37],["καὶ",707031,7],["ἔσται",704093,93],["αὐτῷ",702165,50],["εἰς",704105,0],["καύχησιν",707571,9],["τίς",712867,158],["ἐδύνατο",703838,19],["παραβῆναι",709996,106],["καὶ",707031,7],["οὐ",709805,28],["παρέβη",709996,2],["καὶ",707031,7],["ποιῆσαι",710582,106],["κακὰ",707066,68],["καὶ",707031,7],["οὐκ",709805,28],["ἐποίησεν",710582,2]],"Who hath been tried thereby, and found perfect? then let him glory. Who might offend, and hath not offended? or done evil, and hath not done it?",{"s":"m","br":"34:10","q":0.91}],["11",[["στερεωθήσεται",712076,134],["τὰ",709436,41],["ἀγαθὰ",700106,68],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰς",709436,38],["ἐλεημοσύνας",704421,39],["αὐτοῦ",702165,102],["ἐκδιηγήσεται",704172,93],["ἐκκλησία",704216,12]],"His goods shall be established, and the congregation shall declare his alms.",{"s":"m","br":"34:11","q":1.0}],["12",[["ἐπὶ",705080,0],["τραπέζης",712919,17],["μεγάλης",708653,82],["ἐκάθισας",707006,162],["μὴ",708851,28],["ἀνοίξῃς",701186,175],["ἐπ᾿",705080,0],["αὐτῆς",702165,86],["φάρυγγά",713375,9],["σου",711945,133],["καὶ",707031,7],["μὴ",708851,28],["εἴπῃς",705373,175],["πολλά",710646,195],["γε",702985,11],["τὰ",709436,63],["ἐπ᾿",705080,0],["αὐτῆς",702165,86]],"If thou sit at a bountiful table, be not greedy upon it, and say not, There is much meat on it.",{"s":"m","br":"34:12","q":1.0}],["13",[["μνήσθητι",708960,244],["ὅτι",709803,7],["κακὸν",707066,26],["ὀφθαλμὸς",709870,4],["πονηρός",710660,14],["πονηρότερον",710660,385],["ὀφθαλμοῦ",709870,18],["τί",712867,273],["ἔκτισται",707938,187],["διὰ",703417,0],["τοῦτο",709858,129],["ἀπὸ",701425,0],["παντὸς",710177,92],["προσώπου",710986,21],["δακρύει",703256,91]],"Remember that a wicked eye is an evil thing: and what is created more wicked than an eye? therefore it weepeth upon every occasion.",{"s":"m","br":"34:13","q":1.0}],["14",[["οὗ",709781,160],["ἐὰν",703912,7],["ἐπιβλέψῃ",705088,420],["μὴ",708851,28],["ἐκτείνῃς",704322,175],["χεῖρα",713787,9],["καὶ",707031,7],["μὴ",708851,28],["συνθλίβου",712480,253],["αὐτῷ",702165,280],["ἐν",704639,0],["τρυβλίῳ",712995,54]],"Stretch not thine hand whithersoever it looketh, and thrust it not with him into the dish.",{"s":"m","br":"34:14","q":1.0}],["15",[["νόει",709327,240],["τὰ",709436,41],["τοῦ",709436,35],["πλησίον",710547,28],["ἐκ",704132,0],["σεαυτοῦ",711599,102],["καὶ",707031,7],["ἐπὶ",705080,0],["παντὶ",710177,97],["πράγματι",710708,54],["διανοοῦ",703528,253]],"Judge of thy neighbour by thyself: and be discreet in every point.",{"s":"m","br":"34:15","q":1.0}],["16",[["φάγε",713296,176],["ὡς",714148,7],["ἄνθρωπος",701163,4],["τὰ",709436,41],["παρακείμενά",710044,67],["σοι",711925,159],["καὶ",707031,7],["μὴ",708851,28],["διαμασῶ",703514,253],["μὴ",708851,28],["μισηθῇς",708935,279]],"Eat, as it becometh a man, those things which are set before thee; and devour not, lest thou be hated.",{"s":"m","br":"34:16","q":1.0}],["17",[["παῦσαι",710202,300],["πρῶτος",711041,140],["χάριν",713735,9],["παιδείας",709924,17],["καὶ",707031,7],["μὴ",708851,28],["ἀπληστεύου",701416,253],["μήποτε",708882,28],["προσκόψῃς",710923,175]],"Leave off first for manners' sake; and be not unsatiable, lest thou offend.",{"s":"m","br":"34:17","q":1.0}],["18",[["καὶ",707031,7],["εἰ",704071,7],["ἀνὰ",700902,0],["μέσον",708768,27],["πλειόνων",710514,169],["ἐκάθισας",707006,162],["πρότερος",710992,224],["αὐτῶν",702165,40],["μὴ",708851,28],["ἐκτείνῃς",704322,175],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133]],"When thou sittest among many, reach not thine hand out first of all.",{"s":"m","br":"34:18","q":0.85}],["19",[["ὡς",714148,7],["ἱκανὸν",706710,26],["ἀνθρώπῳ",701163,114],["πεπαιδευμένῳ",709926,516],["τὸ",709436,34],["ὀλίγον",709568,26],["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["κοίτης",707781,17],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἀσθμαίνει",701943,91]],"A very little is sufficient for a man well nurtured, and he fetcheth not his wind short upon his bed.",{"s":"m","br":"34:19","q":1.0}],["20",[["ὕπνος",713181,4],["ὑγιείας",713058,17],["ἐπὶ",705080,0],["ἐντέρῳ",704792,54],["μετρίῳ",708844,97],["ἀνέστη",701173,2],["πρωί",711021,28],["καὶ",707031,7],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτοῦ",702165,102],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["πόνος",710661,4],["ἀγρυπνίας",700198,17],["καὶ",707031,7],["χολέρας",713899,17],["καὶ",707031,7],["στρόφος",712171,4],["μετὰ",708780,0],["ἀνδρὸς",701150,18],["ἀπλήστου",701418,116]],"Sound sleep cometh of moderate eating: he riseth early, and his wits are with him: but the pain of watching, and choler, and pangs of the belly, are with an unsatiable man.",{"s":"m","br":"34:20","q":0.95}],["21",[["καὶ",707031,7],["εἰ",704071,7],["ἐβιάσθης",702713,168],["ἐν",704639,0],["ἐδέσμασιν",704032,96],["ἀνάστα",701173,176],["ἔμεσον",704563,176],["πόρρω",710680,28],["καὶ",707031,7],["ἀναπαύσῃ",701027,172]],"And if thou hast been forced to eat, arise, go forth, vomit, and thou shalt have rest.",{"s":"m","br":"34:21","q":0.8}],["22",[["ἄκουσόν",700587,176],["μου",709032,133],["τέκνον",712761,297],["καὶ",707031,7],["μὴ",708851,28],["ἐξουδενήσῃς",704969,175],["με",708618,163],["καὶ",707031,7],["ἐπ᾿",705080,0],["ἐσχάτων",705519,83],["εὑρήσεις",705676,166],["τοὺς",709436,58],["λόγους",708236,57],["μου",709032,133],["ἐν",704639,0],["πᾶσι",710177,94],["τοῖς",709436,95],["ἔργοις",705396,96],["σου",711945,133],["γίνου",703104,253],["ἐντρεχής",704806,14],["καὶ",707031,7],["πᾶν",710177,26],["ἀρρώστημα",701812,15],["οὐ",709805,28],["μή",708851,28],["σοι",711925,159],["ἀπαντήσῃ",701345,123]],"My son, hear me, and despise me not, and at the last thou shalt find as I told thee: in all thy works be quick, so shall there no sickness come unto thee.",{"s":"m","br":"34:22","q":1.0}],["23",[["λαμπρὸν",708082,27],["ἐπ᾿",705080,0],["ἄρτοις",701829,148],["εὐλογήσει",705631,127],["χείλη",713781,64],["καὶ",707031,7],["ἡ",709436,10],["μαρτυρία",708524,12],["τῆς",709436,16],["καλλονῆς",707092,17],["αὐτοῦ",702165,102],["πιστή",710486,29]],null,{"s":"h"}],["24",[["πονηρῷ",710660,30],["ἐπ᾿",705080,0],["ἄρτῳ",701829,114],["διαγογγύσει",703438,127],["πόλις",710612,12],["καὶ",707031,7],["ἡ",709436,10],["μαρτυρία",708524,12],["τῆς",709436,16],["πονηρίας",710659,17],["αὐτοῦ",702165,102],["ἀκριβής",700597,29]],"But against him that is a niggard of his meat the whole city shall murmur; and the testimonies of his niggardness shall not be doubted of.",{"s":"m","br":"34:24","q":0.92}],["25",[["ἐν",704639,0],["οἴνῳ",709530,114],["μὴ",708851,28],["ἀνδρίζου",701104,253],["πολλοὺς",710646,60],["γὰρ",702963,11],["ἀπώλεσεν",701513,2],["ὁ",709436,3],["οἶνος",709530,4]],"Shew not thy valiantness in wine; for wine hath destroyed many.",{"s":"m","br":"34:25","q":1.0}],["26",[["κάμινος",707113,12],["δοκιμάζει",703776,91],["στόμωμα",712126,25],["ἐν",704639,0],["βαφῇ",702601,1],["οὕτως",709859,28],["οἶνος",709530,4],["καρδίας",707141,39],["ἐν",704639,0],["μάχῃ",708601,1],["ὑπερηφάνων",713139,169]],"The furnace proveth the edge by dipping: so doth wine the hearts of the proud by drunkenness.",{"s":"m","br":"34:26","q":1.0}],["27",[["ἔφισον",705257,14],["ζωῆς",705910,17],["οἶνος",709530,4],["ἀνθρώποις",701163,148],["ἐὰν",703912,7],["πίνῃς",710478,205],["αὐτὸν",702165,85],["ἐν",704639,0],["μέτρῳ",708846,54],["αὐτοῦ",702165,102],["τίς",712867,359],["ζωὴ",705910,12],["ἐλασσουμένῳ",704394,241],["οἴνῳ",709530,114],["καὶ",707031,7],["αὐτὸς",702165,121],["ἔκτισται",707938,187],["εἰς",704105,0],["εὐφροσύνην",705717,9],["ἀνθρώποις",701163,148]],"Wine is as good as life to a man, if it be drunk moderately: what life is then to a man that is without wine? for it was made to make men glad.",{"s":"m","br":"34:27","q":0.9}],["28",[["ἀγαλλίαμα",700112,15],["καρδίας",707141,17],["καὶ",707031,7],["εὐφροσύνη",705717,12],["ψυχῆς",714070,17],["οἶνος",709530,4],["πινόμενος",710478,122],["ἐν",704639,0],["καιρῷ",707047,114],["αὐτάρκης",702157,14]],"Wine measurably drunk and in season bringeth gladness of the heart, and cheerfulness of the mind:",{"s":"m","br":"34:28","q":1.0}],["29",[["πικρία",710472,12],["ψυχῆς",714070,17],["οἶνος",709530,4],["πινόμενος",710478,122],["πολὺς",710646,14],["ἐν",704639,0],["ἐρεθισμῷ",705402,114],["καὶ",707031,7],["ἀντιπτώματι",701271,54]],"but wine drunken with excess maketh bitterness of the mind, with brawling and quarrelling.",{"s":"m","br":"34:29","q":0.89}],["30",[["πληθύνει",710530,91],["μέθη",708667,14],["θυμὸν",706334,6],["ἄφρονος",702236,116],["εἰς",704105,0],["πρόσκομμα",710922,25],["ἐλαττῶν",704394,72],["ἰσχὺν",706858,9],["καὶ",707031,7],["προσποιῶν",710953,72],["τραύματα",712920,42]],"Drunkenness increaseth the rage of a fool till he offend: it diminisheth strength, and maketh wounds.",{"s":"m","br":"34:30","q":1.0}],["31",[["ἐν",704639,0],["συμποσίῳ",712345,54],["οἴνου",709530,18],["μὴ",708851,28],["ἐλέγξῃς",704416,175],["τὸν",709436,5],["πλησίον",710547,28],["καὶ",707031,7],["μὴ",708851,28],["ἐξουθενήσῃς",704969,175],["αὐτὸν",702165,85],["ἐν",704639,0],["εὐφροσύνῃ",705717,1],["αὐτοῦ",702165,102],["λόγον",708236,6],["ὀνειδισμοῦ",709657,18],["μὴ",708851,28],["εἴπῃς",705373,175],["αὐτῷ",702165,50],["καὶ",707031,7],["μὴ",708851,28],["αὐτὸν",702165,85],["θλίψῃς",706274,175],["ἐν",704639,0],["ἀπαιτήσει",701331,1]],"Rebuke not thy neighbour at the wine, and despise him not in his mirth: give him no despiteful words, and press not upon him with urging him [to drink].",{"s":"m","br":"34:31","q":0.89}]]