[["1",[["κύριε",707996,153],["πάτερ",710189,153],["καὶ",707031,7],["δέσποτα",703379,153],["ζωῆς",705910,17],["μου",709032,133],["μὴ",708851,28],["ἐγκαταλίπῃς",703967,175],["με",708618,163],["ἐν",704639,0],["βουλῇ",702792,1],["αὐτῶν",702165,40],["μὴ",708851,28],["ἀφῇς",702211,175],["με",708618,163],["πεσεῖν",710481,106],["ἐν",704639,0],["αὐτοῖς",702165,151]],"O Lord, Father and Governor of my life, leave me not to their counsels, and let me not fall by them."],["2",[["τίς",712867,158],["ἐπιστήσει",705756,127],["ἐπὶ",705080,0],["τοῦ",709436,20],["διανοήματός",703529,21],["μου",709032,133],["μάστιγας",708568,39],["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["καρδίας",707141,17],["μου",709032,133],["παιδείαν",709924,9],["σοφίας",711981,17],["ἵνα",706747,7],["ἐπὶ",705080,0],["τοῖς",709436,95],["ἀγνοήμασίν",700176,96],["μου",709032,133],["μὴ",708851,28],["φείσωνται",713406,232],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["παρῇ",710126,204],["τὰ",709436,41],["ἁμαρτήματα",700774,42],["αὐτῶν",702165,40]],"Who will set scourges over my thoughts, and the discipline of wisdom over mine heart? that they spare me not for mine ignorances, and it pass not by my sins:"],["3",[["ὅπως",709719,7],["μὴ",708851,28],["πληθυνθῶσιν",710530,272],["αἱ",709436,190],["ἄγνοιαί",700177,191],["μου",709032,133],["καὶ",707031,7],["αἱ",709436,190],["ἁμαρτίαι",700775,191],["μου",709032,133],["πλεονάσωσιν",710516,234],["καὶ",707031,7],["πεσοῦμαι",710481,181],["ἔναντι",704653,0],["τῶν",709436,80],["ὑπεναντίων",713109,169],["καὶ",707031,7],["ἐπιχαρεῖταί",705330,93],["μοι",708974,159],["ὁ",709436,3],["ἐχθρός",705779,14],["μου",709032,133]],"lest mine ignorances increase, and my sins abound to my destruction, and I fall before mine adversaries, and mine enemy rejoice over me, whose hope is far from thy mercy."],["4",[["κύριε",707996,153],["πάτερ",710189,153],["καὶ",707031,7],["θεὲ",706192,153],["ζωῆς",705910,17],["μου",709032,133],["μετεωρισμὸν",708830,6],["ὀφθαλμῶν",709870,81],["μὴ",708851,28],["δῷς",703654,175],["μοι",708974,159]],"O Lord, Father and God of my life, give me not a proud look."],["5",[["καὶ",707031,7],["ἐπιθυμίαν",705147,9],["ἀπόστρεψον",701598,176],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133]],"Turn away concupiscence from me."],["6",[["κοιλίας",707761,17],["ὄρεξις",709734,12],["καὶ",707031,7],["συνουσιασμὸς",712502,4],["μὴ",708851,28],["καταλαβέτωσάν",707300,264],["με",708618,163],["καὶ",707031,7],["ψυχῇ",714070,1],["ἀναιδεῖ",700959,101],["μὴ",708851,28],["παραδῷς",710014,175],["με",708618,163]],"Let not the greediness of the belly nor lust of the flesh take hold of me; and give me not over into an impudent mind."],["7",[["παιδείαν",709924,9],["στόματος",712125,21],["ἀκούσατε",700587,74],["τέκνα",712761,589],["καὶ",707031,7],["ὁ",709436,3],["φυλάσσων",713619,72],["οὐ",709805,28],["μὴ",708851,28],["ἁλῷ",700673,172]],"Hear, O ye children, the discipline of the mouth: he that keepeth it shall never be taken in his lips."],["8",[["ἐν",704639,0],["τοῖς",709436,95],["χείλεσιν",713781,96],["αὐτοῦ",702165,102],["καταληφθήσεται",707300,134],["ἁμαρτωλός",700776,14],["καὶ",707031,7],["λοίδορος",708243,14],["καὶ",707031,7],["ὑπερήφανος",713139,14],["σκανδαλισθήσονται",711824,144],["ἐν",704639,0],["αὐτοῖς",702165,206]],"The sinner shall be left in his foolishness: both the evil speaker and the proud shall fall thereby.",{"s":"d","q":0.62}],["9",[["ὅρκῳ",709753,114],["μὴ",708851,28],["ἐθίσῃς",704061,175],["τὸ",709436,24],["στόμα",712125,25],["σου",711945,133],["καὶ",707031,7],["ὀνομασίᾳ",709668,1],["τοῦ",709436,35],["ἁγίου",700159,116],["μὴ",708851,28],["συνεθισθῇς",712431,279]],"Accustom not thy mouth to swearing; neither use thyself to the naming of the Holy One."],["10",[["ὥσπερ",714163,28],["γὰρ",702963,11],["οἰκέτης",709496,4],["ἐξεταζόμενος",704911,122],["ἐνδελεχῶς",704681,28],["ἀπὸ",701425,0],["μώλωπος",709099,18],["οὐκ",709805,28],["ἐλαττωθήσεται",704394,134],["οὕτως",709859,28],["καὶ",707031,7],["ὁ",709436,3],["ὀμνύων",709620,72],["καὶ",707031,7],["ὀνομάζων",709667,72],["διὰ",703417,0],["παντὸς",710177,92],["ἀπὸ",701425,0],["ἁμαρτίας",700775,17],["οὐ",709805,28],["μὴ",708851,28],["καθαρισθῇ",706985,384]],"For as a servant that is continually beaten shall not be without a blue mark: so he that sweareth and nameth God continually shall not be faultless."],["11",[["ἀνὴρ",701150,4],["πολύορκος",710633,14],["πλησθήσεται",710532,134],["ἀνομίας",701192,39],["καὶ",707031,7],["οὐκ",709805,28],["ἀποστήσεται",702214,93],["ἀπὸ",701425,0],["τοῦ",709436,35],["οἴκου",709516,18],["αὐτοῦ",702165,102],["μάστιξ",708568,12],["ἐὰν",703912,7],["πλημμελήσῃ",710534,172],["ἁμαρτία",700775,12],["αὐτοῦ",702165,102],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["κἂν",707120,459],["ὑπερίδῃ",713154,172],["ἥμαρτεν",700773,2],["δισσῶς",703745,28],["καὶ",707031,7],["εἰ",704071,7],["διὰ",703417,0],["κενῆς",707612,82],["ὤμοσεν",709620,2],["οὐ",709805,28],["δικαιωθήσεται",703696,134],["πλησθήσεται",710532,134],["γὰρ",702963,11],["ἐπαγωγῶν",704995,65],["ὁ",709436,3],["οἶκος",709516,4],["αὐτοῦ",702165,102]],"A man that useth much swearing shall be filled with iniquity, and the plague shall never depart from his house: if he shall offend, his sin shall be upon him: and if he acknowledge not his sin, he maketh a double offence: and if he swear in vain, he shall not be innocent, but his house shall be full of calamities."],["12",[["ἔστιν",704093,91],["λέξις",708144,12],["ἀντιπαραβεβλημένη",701259,203],["θανάτῳ",706096,114],["μὴ",708851,28],["εὑρεθήτω",705676,22],["ἐν",704639,0],["κληρονομίᾳ",707725,1],["Ιακωβ",706401,18],["ἀπὸ",701425,0],["γὰρ",702963,11],["εὐσεβῶν",705687,169],["ταῦτα",709858,290],["πάντα",710177,195],["ἀποστήσεται",702214,93],["καὶ",707031,7],["ἐν",704639,0],["ἁμαρτίαις",700775,76],["οὐκ",709805,28],["ἐγκυλισθήσονται",703999,144]],"There is a word that is clothed about with death: God grant that it be not found in the heritage of Jacob; for all such things shall be far from the godly, and they shall not wallow in their sins."],["13",[["ἀπαιδευσίαν",701327,9],["ἀσυρῆ",702038,36],["μὴ",708851,28],["συνεθίσῃς",712431,175],["τὸ",709436,24],["στόμα",712125,25],["σου",711945,133],["ἔστιν",704093,91],["γὰρ",702963,11],["ἐν",704639,0],["αὐτῇ",702165,105],["λόγος",708236,4],["ἁμαρτίας",700775,17]],"Use not thy mouth to intemperate swearing, for therein is the word of sin."],["14",[["μνήσθητι",708960,244],["πατρὸς",710189,18],["καὶ",707031,7],["μητρός",708892,17],["σου",711945,133],["ἀνὰ",700902,0],["μέσον",708768,27],["γὰρ",702963,11],["μεγιστάνων",708657,81],["συνεδρεύεις",712426,154],["μήποτε",708882,28],["ἐπιλάθῃ",705187,172],["ἐνώπιον",704823,0],["αὐτῶν",702165,40],["καὶ",707031,7],["τῷ",709436,113],["ἐθισμῷ",704062,114],["σου",711945,133],["μωρανθῇς",709105,279],["καὶ",707031,7],["θελήσεις",706176,166],["εἰ",704071,7],["μὴ",708851,28],["ἐγεννήθης",703051,168],["καὶ",707031,7],["τὴν",709436,8],["ἡμέραν",705984,9],["τοῦ",709436,35],["τοκετοῦ",712881,18],["σου",711945,133],["καταράσῃ",707396,123]],"Remember thy father and thy mother, when thou sittest among great men. Be not forgetful before them, and so thou by thy custom become a fool, and wish that thou hadst not been born, and curse the day of thy nativity."],["15",[["ἄνθρωπος",701163,4],["συνεθιζόμενος",712431,122],["λόγοις",708236,148],["ὀνειδισμοῦ",709657,18],["ἐν",704639,0],["πάσαις",710177,291],["ταῖς",709436,75],["ἡμέραις",705984,76],["αὐτοῦ",702165,102],["οὐ",709805,28],["μὴ",708851,28],["παιδευθῇ",709926,384]],"The man that is accustomed to opprobrious words will never be reformed all the days of his life."],["16",[["δύο",703849,59],["εἴδη",704074,64],["πληθύνουσιν",710530,197],["ἁμαρτίας",700775,39],["καὶ",707031,7],["τὸ",709436,34],["τρίτον",712968,26],["ἐπάξει",704994,127],["ὀργήν",709728,9]],null,{"s":"j","with":"23:17"}],["17",[["ψυχὴ",714070,12],["θερμὴ",706217,29],["ὡς",714148,7],["πῦρ",711088,15],["καιόμενον",707049,208],["οὐ",709805,28],["μὴ",708851,28],["σβεσθῇ",711596,384],["ἕως",705792,7],["ἂν",700900,11],["καταποθῇ",707374,204],["ἄνθρωπος",701163,4],["πόρνος",710678,4],["ἐν",704639,0],["σώματι",712635,54],["σαρκὸς",711537,17],["αὐτοῦ",702165,102],["οὐ",709805,28],["μὴ",708851,28],["παύσηται",710202,239],["ἕως",705792,7],["ἂν",700900,11],["ἐκκαύσῃ",704205,2],["πῦρ",711088,15],["ἀνθρώπῳ",701163,114],["πόρνῳ",710678,114],["πᾶς",710177,14],["ἄρτος",701829,4],["ἡδύς",705945,14],["οὐ",709805,28],["μὴ",708851,28],["κοπάσῃ",707819,172],["ἕως",705792,7],["ἂν",700900,11],["τελευτήσῃ",712781,172]],"Two sorts of men multiply sin, and the third will bring wrath: a hot mind is as a burning fire, it will never be quenched till it be consumed: a fornicator in the body of his flesh will never cease till he hath kindled a fire. All bread is sweet to a whoremonger, he will not leave off till he die.",{"s":"m","br":"23:16 23:17","q":0.8}],["18",[["ἄνθρωπος",701163,4],["παραβαίνων",709996,72],["ἀπὸ",701425,0],["τῆς",709436,16],["κλίνης",707737,17],["αὐτοῦ",702165,102],["λέγων",708124,72],["ἐν",704639,0],["τῇ",709436,100],["ψυχῇ",714070,1],["αὐτοῦ",702165,102],["τίς",712867,158],["με",708618,163],["ὁρᾷ",709725,91],["σκότος",711889,15],["κύκλῳ",707959,114],["μου",709032,133],["καὶ",707031,7],["οἱ",709436,136],["τοῖχοί",712879,52],["με",708618,163],["καλύπτουσιν",707102,197],["καὶ",707031,7],["οὐθείς",709817,14],["με",708618,163],["ὁρᾷ",709725,91],["τί",712867,126],["εὐλαβοῦμαι",705627,254],["τῶν",709436,130],["ἁμαρτιῶν",700775,65],["μου",709032,133],["οὐ",709805,28],["μὴ",708851,28],["μνησθήσεται",708923,134],["ὁ",709436,3],["ὕψιστος",713287,14]],"A man that breaketh wedlock, saying thus in his heart, Who seeth me? I am compassed about with darkness, the walls cover me, and no body seeth me; what need I to fear? the most High will not remember my sins:"],["19",[["καὶ",707031,7],["ὀφθαλμοὶ",709870,52],["ἀνθρώπων",701163,81],["ὁ",709436,3],["φόβος",713534,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ἔγνω",703105,2],["ὅτι",709803,7],["ὀφθαλμοὶ",709870,52],["κυρίου",707996,18],["μυριοπλασίως",709065,28],["ἡλίου",705974,18],["φωτεινότεροι",713645,267],["ἐπιβλέποντες",705088,146],["πάσας",710177,119],["ὁδοὺς",709458,39],["ἀνθρώπων",701163,81],["καὶ",707031,7],["κατανοοῦντες",707341,146],["εἰς",704105,0],["ἀπόκρυφα",701497,68],["μέρη",708752,42]],"such a man only feareth the eyes of men, and knoweth not that the eyes of the Lord are ten thousand times brighter than the sun, beholding all the ways of men, and considering the most secret parts."],["20",[["πρὶν",710742,28],["ἢ",705924,7],["κτισθῆναι",707938,179],["τὰ",709436,41],["πάντα",710177,68],["ἔγνωσται",703105,187],["αὐτῷ",702165,50],["οὕτως",709859,28],["καὶ",707031,28],["μετὰ",708780,0],["τὸ",709436,24],["συντελεσθῆναι",712510,179]],"He knew all things ere ever they were created; so also after they were perfected he looked upon them all."],["21",[["οὗτος",709858,121],["ἐν",704639,0],["πλατείαις",710509,291],["πόλεως",710612,17],["ἐκδικηθήσεται",704174,134],["καὶ",707031,7],["οὗ",709806,28],["οὐχ",709805,28],["ὑπενόησεν",713227,2],["πιασθήσεται",710465,134]],"This man shall be punished in the streets of the city, and where he suspecteth not he shall be taken."],["22",[["οὕτως",709859,28],["καὶ",707031,28],["γυνὴ",703209,12],["καταλιποῦσα",707305,149],["τὸν",709436,5],["ἄνδρα",701150,6],["καὶ",707031,7],["παριστῶσα",710152,149],["κληρονόμον",707726,6],["ἐξ",704132,0],["ἀλλοτρίου",700699,116]],"Thus shall it go also with the wife that leaveth her husband, and bringeth in an heir by another."],["23",[["πρῶτον",711039,28],["μὲν",708730,11],["γὰρ",702963,11],["ἐν",704639,0],["νόμῳ",709349,114],["ὑψίστου",713287,116],["ἠπείθησεν",701370,2],["καὶ",707031,7],["δεύτερον",703389,46],["εἰς",704105,0],["ἄνδρα",701150,6],["αὐτῆς",702165,86],["ἐπλημμέλησεν",710534,2],["καὶ",707031,7],["τὸ",709436,24],["τρίτον",712968,46],["ἐν",704639,0],["πορνείᾳ",710672,1],["ἐμοιχεύθη",708979,37],["καὶ",707031,7],["ἐξ",704132,0],["ἀλλοτρίου",700699,116],["ἀνδρὸς",701150,18],["τέκνα",712761,42],["παρέστησεν",710152,2]],"For first, she hath disobeyed the law of the most High; and secondly, she hath trespassed against her own husband; and thirdly, she hath played the whore in adultery, and brought children by another man."],["24",[["αὕτη",709858,107],["εἰς",704105,0],["ἐκκλησίαν",704216,9],["ἐξαχθήσεται",704834,134],["καὶ",707031,7],["ἐπὶ",705080,0],["τὰ",709436,41],["τέκνα",712761,42],["αὐτῆς",702165,86],["ἐπισκοπὴ",705255,12],["ἔσται",704093,93]],"She shall be brought out into the congregation, and inquisition shall be made of her children."],["25",[["οὐ",709805,28],["διαδώσουσιν",703449,218],["τὰ",709436,63],["τέκνα",712761,64],["αὐτῆς",702165,86],["εἰς",704105,0],["ῥίζαν",711260,9],["καὶ",707031,7],["οἱ",709436,136],["κλάδοι",707702,52],["αὐτῆς",702165,86],["οὐκ",709805,28],["οἴσουσιν",713428,218],["καρπόν",707169,6]],"Her children shall not take root, and her branches shall bring forth no fruit."],["26",[["καταλείψει",707305,127],["εἰς",704105,0],["κατάραν",707395,9],["τὸ",709436,24],["μνημόσυνον",708966,25],["αὐτῆς",702165,86],["καὶ",707031,7],["τὸ",709436,34],["ὄνειδος",709658,15],["αὐτῆς",702165,86],["οὐκ",709805,28],["ἐξαλειφθήσεται",704852,134]],"She shall leave her memory to be cursed, and her reproach shall not be blotted out."],["27",[["καὶ",707031,7],["ἐπιγνώσονται",705104,135],["οἱ",709436,136],["καταλειφθέντες",707305,247],["ὅτι",709803,7],["οὐθὲν",709817,26],["κρεῖττον",707891,46],["φόβου",713534,18],["κυρίου",707996,18],["καὶ",707031,7],["οὐθὲν",709817,26],["γλυκύτερον",703114,26],["τοῦ",709436,20],["προσέχειν",710895,55],["ἐντολαῖς",704802,76],["κυρίου",707996,18]],"And they that remain shall know that there is nothing better than the fear of the Lord, and that there is nothing sweeter than to take heed unto the commandments of the Lord."]]