[["1",[["μὴ",708851,28],["περὶ",710285,0],["τούτων",709858,70],["αἰσχυνθῇς",700485,279],["καὶ",707031,7],["μὴ",708851,28],["λάβῃς",708076,175],["πρόσωπον",710986,25],["τοῦ",709436,20],["ἁμαρτάνειν",700773,55]],"Of these things be not thou ashamed, and accept no person to sin thereby:"],["2",[["περὶ",710285,0],["νόμου",709349,18],["ὑψίστου",713287,116],["καὶ",707031,7],["διαθήκης",703456,17],["καὶ",707031,7],["περὶ",710285,0],["κρίματος",707903,21],["δικαιῶσαι",703696,106],["τὸν",709436,5],["ἀσεβῆ",701909,27]],"of the law of the most High, and his covenant; and of judgment to justify the ungodly;"],["3",[["περὶ",710285,0],["λόγου",708236,18],["κοινωνοῦ",707777,18],["καὶ",707031,7],["ὁδοιπόρων",709451,81],["καὶ",707031,7],["περὶ",710285,0],["δόσεως",703809,17],["κληρονομίας",707725,17],["ἑταίρων",705529,81]],"of reckoning with thy partners and travellers; or of the gift of the heritage of friends;"],["4",[["περὶ",710285,0],["ἀκριβείας",700596,17],["ζυγοῦ",705894,18],["καὶ",707031,7],["σταθμίων",712039,44],["καὶ",707031,7],["περὶ",710285,0],["κτήσεως",707937,17],["πολλῶν",710646,83],["καὶ",707031,7],["ὀλίγων",709568,83]],"of exactness of balance and weights; or of getting much or little;"],["5",[["περὶ",710285,0],["διαφόρου",703630,82],["πράσεως",710719,17],["ἐμπόρων",704614,81],["καὶ",707031,7],["περὶ",710285,0],["παιδείας",709924,17],["τέκνων",712761,44],["πολλῆς",710646,82],["καὶ",707031,7],["οἰκέτῃ",709496,114],["πονηρῷ",710660,30],["πλευρὰν",710524,9],["αἱμάξαι",700447,106]],"and of merchants' indifferent selling; of much correction of children; and to make the side of an evil servant to bleed."],["6",[["ἐπὶ",705080,0],["γυναικὶ",703209,1],["πονηρᾷ",710660,101],["καλὸν",707097,26],["σφραγίς",712591,12],["καὶ",707031,7],["ὅπου",709710,11],["χεῖρες",713787,191],["πολλαί",710646,192],["κλεῖσον",707710,176]],"Sure keeping is good, where an evil wife is; and locked up, where many hands are."],["7",[["ὃ",709781,128],["ἐὰν",703912,7],["παραδιδῷς",710014,205],["ἐν",704639,0],["ἀριθμῷ",701744,114],["καὶ",707031,7],["σταθμῷ",712040,114],["καὶ",707031,7],["δόσις",703809,12],["καὶ",707031,7],["λῆμψις",708183,12],["πάντα",710177,68],["ἐν",704639,0],["γραφῇ",703191,1]],"Deliver all things in number and weight; and put all in writing that thou givest out, or receivest in."],["8",[["περὶ",710285,0],["παιδείας",709924,17],["ἀνοήτου",701184,82],["καὶ",707031,7],["μωροῦ",709110,116],["καὶ",707031,7],["ἐσχατογήρως",705518,116],["κρινομένου",707905,262],["πρὸς",710844,0],["νέους",709256,60],["καὶ",707031,7],["ἔσῃ",704093,123],["πεπαιδευμένος",709926,419],["ἀληθινῶς",700660,28],["καὶ",707031,7],["δεδοκιμασμένος",703776,419],["ἔναντι",704653,0],["παντὸς",710177,116],["ζῶντος",705851,152]],"Be not ashamed to inform the unwise and foolish, and the extreme aged that contendeth with those that are young: thus shalt thou be truly learned, and approved of all men living."],["9",[["θυγάτηρ",706320,12],["πατρὶ",710189,114],["ἀπόκρυφος",701497,29],["ἀγρυπνία",700198,12],["καὶ",707031,7],["ἡ",709436,10],["μέριμνα",708745,12],["αὐτῆς",702165,86],["ἀφιστᾷ",702214,91],["ὕπνον",713181,6],["ἐν",704639,0],["νεότητι",709258,1],["αὐτῆς",702165,86],["μήποτε",708882,28],["παρακμάσῃ",710051,172],["καὶ",707031,7],["συνῳκηκυῖα",712493,287],["μήποτε",708882,28],["μισηθῇ",708935,384]],"A daughter is a wakeful care to a father; and the care for her taketh away sleep: when she is young, lest she pass away the flower of her age; and being married, lest she should be hated:"],["10",[["ἐν",704639,0],["παρθενίᾳ",710146,1],["μήποτε",708882,28],["βεβηλωθῇ",702614,384],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["πατρικοῖς",710194,230],["αὐτῆς",702165,86],["ἔγκυος",704000,29],["γένηται",703104,239],["μετὰ",708780,0],["ἀνδρὸς",701150,18],["οὖσα",704093,188],["μήποτε",708882,28],["παραβῇ",709996,172],["καὶ",707031,7],["συνῳκηκυῖα",712493,287],["μήποτε",708882,28],["στειρωθῇ",712061,384]],"in her virginity, lest she should be defiled and gotten with child in her father's house; and having an husband, lest she should misbehave herself; and when she is married, lest she should be barren."],["11",[["ἐπὶ",705080,0],["θυγατρὶ",706320,1],["ἀδιατρέπτῳ",700264,101],["στερέωσον",712076,176],["φυλακήν",713613,9],["μήποτε",708882,28],["ποιήσῃ",710582,172],["σε",711598,163],["ἐπίχαρμα",705332,9],["ἐχθροῖς",705779,230],["λαλιὰν",708074,9],["ἐν",704639,0],["πόλει",710612,1],["καὶ",707031,7],["ἔκκλητον",704219,36],["λαοῦ",708094,18],["καὶ",707031,7],["καταισχύνῃ",707257,204],["σε",711598,163],["ἐν",704639,0],["πλήθει",710529,54],["πολλῶν",710646,169]],"Keep a sure watch over a shameless daughter, lest she make thee a laughingstock to thine enemies, and a byword in the city, and a reproach among the people, and make thee ashamed before the multitude."],["12",[["παντὶ",710177,30],["ἀνθρώπῳ",701163,114],["μὴ",708851,28],["ἔμβλεπε",704551,240],["ἐν",704639,0],["κάλλει",707093,54],["καὶ",707031,7],["ἐν",704639,0],["μέσῳ",708768,30],["γυναικῶν",703209,65],["μὴ",708851,28],["συνέδρευε",712426,240]],"Behold not everybody's beauty, and sit not in the midst of women."],["13",[["ἀπὸ",701425,0],["γὰρ",702963,11],["ἱματίων",706742,44],["ἐκπορεύεται",704293,117],["σὴς",711943,82],["καὶ",707031,7],["ἀπὸ",701425,0],["γυναικὸς",703209,17],["πονηρία",710659,12],["γυναικός",703209,17]],"For from garments cometh a moth, and from women wickedness."],["14",[["κρείσσων",707891,29],["πονηρία",710659,12],["ἀνδρὸς",701150,18],["ἢ",705924,7],["ἀγαθοποιὸς",700105,29],["γυνή",703209,12],["καὶ",707031,7],["γυνὴ",703209,12],["καταισχύνουσα",707257,188],["εἰς",704105,0],["ὀνειδισμόν",709657,6]],"Better is the churlishness of a man than a courteous woman, a woman, [I say], which bringeth shame and reproach."],["15",[["μνησθήσομαι",708923,180],["δὴ",703395,11],["τὰ",709436,41],["ἔργα",705396,42],["κυρίου",707996,18],["καὶ",707031,7],["ἃ",709781,69],["ἑόρακα",709725,89],["ἐκδιηγήσομαι",704172,181],["ἐν",704639,0],["λόγοις",708236,148],["κυρίου",707996,18],["τὰ",709436,41],["ἔργα",705396,42],["αὐτοῦ",702165,102]],"I will now remember the works of the Lord, and declare the things that I have seen: In the words of the Lord are his works."],["16",[["ἥλιος",705974,4],["φωτίζων",713646,72],["κατὰ",707200,0],["πᾶν",710177,46],["ἐπέβλεψεν",705088,2],["καὶ",707031,7],["τῆς",709436,16],["δόξης",703791,17],["κυρίου",707996,18],["πλῆρες",710541,26],["τὸ",709436,34],["ἔργον",705396,15],["αὐτοῦ",702165,102]],"The sun that giveth light looketh upon all things, and the work thereof [is] full of the glory of the Lord."],["17",[["οὐκ",709805,28],["ἐξεποίησεν",704289,2],["τοῖς",709436,147],["ἁγίοις",700159,230],["κυρίου",707996,18],["ἐκδιηγήσασθαι",704172,109],["πάντα",710177,68],["τὰ",709436,41],["θαυμάσια",706136,68],["αὐτοῦ",702165,102],["ἃ",709781,69],["ἐστερέωσεν",712076,2],["κύριος",707996,4],["ὁ",709436,3],["παντοκράτωρ",709986,4],["στηριχθῆναι",712098,179],["ἐν",704639,0],["δόξῃ",703791,1],["αὐτοῦ",702165,102],["τὸ",709436,24],["πᾶν",710177,46]],"The Lord hath not given power to the saints to declare all his marvellous works, which the Almighty Lord firmly settled, that whatsoever is might be established for his glory."],["18",[["ἄβυσσον",700098,9],["καὶ",707031,7],["καρδίαν",707141,9],["ἐξίχνευσεν",704941,2],["καὶ",707031,7],["ἐν",704639,0],["πανουργεύμασιν",709969,96],["αὐτῶν",702165,40],["διενοήθη",703528,37],["ἔγνω",703105,2],["γὰρ",702963,11],["ὁ",709436,3],["ὕψιστος",713287,14],["πᾶσαν",710177,36],["εἴδησιν",704073,9],["καὶ",707031,7],["ἐνέβλεψεν",704551,2],["εἰς",704105,0],["σημεῖον",711748,25],["αἰῶνος",700504,18]],"He seeketh out the deep, and the heart, and considereth their crafty devices: for the Lord knoweth all that can be known, and he beholdeth the signs of the world,"],["19",[["ἀπαγγέλλων",701321,72],["τὰ",709436,41],["παρεληλυθότα",710141,518],["καὶ",707031,7],["τὰ",709436,41],["ἐσόμενα",704093,765],["καὶ",707031,7],["ἀποκαλύπτων",701474,72],["ἴχνη",706873,42],["ἀποκρύφων",701497,83]],"declaring the things that are past, and for to come, and revealing the steps of hidden things."],["20",[["οὐ",709805,28],["παρῆλθεν",710141,2],["αὐτὸν",702165,85],["πᾶν",710177,26],["διανόημα",703529,15],["οὐκ",709805,28],["ἐκρύβη",707923,37],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["οὐδὲ",709816,7],["εἷς",704106,59],["λόγος",708236,4]],"No thought escapeth him, neither any word is hidden from him."],["21",[["τὰ",709436,41],["μεγαλεῖα",708625,68],["τῆς",709436,16],["σοφίας",711981,17],["αὐτοῦ",702165,102],["ἐκόσμησεν",707847,2],["ὡς",714148,7],["ἔστιν",704093,91],["πρὸ",710747,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["οὔτε",709857,7],["προσετέθη",710965,37],["οὔτε",709857,7],["ἠλαττώθη",704394,37],["καὶ",707031,7],["οὐ",709805,28],["προσεδεήθη",710873,37],["οὐδενὸς",709817,116],["συμβούλου",712295,18]],"He hath garnished the excellent works of his wisdom, and he is from everlasting to everlasting: unto him may nothing be added, neither can he be diminished, and he hath no need of any counsellor."],["22",[["ὡς",714148,7],["πάντα",710177,195],["τὰ",709436,63],["ἔργα",705396,64],["αὐτοῦ",702165,102],["ἐπιθυμητὰ",705146,195],["καὶ",707031,7],["ὡς",714148,7],["σπινθῆρός",712015,18],["ἐστιν",704093,91],["θεωρῆσαι",706226,106]],"Oh how desirable are all his works! and that a man may see even to a spark."],["23",[["πάντα",710177,195],["ταῦτα",709858,290],["ζῇ",705851,91],["καὶ",707031,7],["μένει",708736,91],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἐν",704639,0],["πάσαις",710177,291],["χρείαις",713938,76],["καὶ",707031,7],["πάντα",710177,195],["ὑπακούει",713096,91]],"All these things live and remain for ever for all uses, and they are all obedient."],["24",[["πάντα",710177,195],["δισσά",703744,195],["ἓν",704106,26],["κατέναντι",707507,28],["τοῦ",709436,35],["ἑνός",704106,92],["καὶ",707031,7],["οὐκ",709805,28],["ἐποίησεν",710582,2],["οὐδὲν",709817,46],["ἐλλεῖπον",708131,47]],"All things are double one against another: and he hath made nothing imperfect."],["25",[["ἓν",704106,26],["τοῦ",709436,20],["ἑνὸς",704106,92],["ἐστερέωσεν",712076,2],["τὰ",709436,41],["ἀγαθά",700106,68],["καὶ",707031,7],["τίς",712867,158],["πλησθήσεται",710532,134],["ὁρῶν",709725,72],["δόξαν",703791,9],["αὐτοῦ",702165,102]],"One thing establisheth the good of another: and who shall be filled with beholding his glory?"]]