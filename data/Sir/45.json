[["1",[["καὶ",707031,7],["ἐξήγαγεν",704834,2],["ἐξ",704132,0],["αὐτοῦ",702165,102],["ἄνδρα",701150,6],["ἐλέους",704426,21],["εὑρίσκοντα",705676,183],["χάριν",713735,9],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["πάσης",710177,82],["σαρκὸς",711537,17],["ἠγαπημένον",700120,439],["ὑπὸ",713184,0],["θεοῦ",706192,18],["καὶ",707031,7],["ἀνθρώπων",701163,81],["Μωυσῆν",709112,6],["οὗ",709781,48],["τὸ",709436,34],["μνημόσυνον",708966,15],["ἐν",704639,0],["εὐλογίαις",705633,76]],"And he brought out of him a merciful man, which found favour in the sight of all flesh; even Moses, beloved of God and men, whose memorial is blessed."],["2",[["ὡμοίωσεν",709628,2],["αὐτὸν",702165,85],["δόξῃ",703791,1],["ἁγίων",700159,169],["καὶ",707031,7],["ἐμεγάλυνεν",708647,2],["αὐτὸν",702165,85],["ἐν",704639,0],["φόβοις",713534,148],["ἐχθρῶν",705779,169]],"He made him like to the glorious saints, and magnified him, so that his enemies stood in fear of him."],["3",[["ἐν",704639,0],["λόγοις",708236,148],["αὐτοῦ",702165,102],["σημεῖα",711748,42],["κατέπαυσεν",707365,2],["ἐδόξασεν",703792,2],["αὐτὸν",702165,85],["κατὰ",707200,0],["πρόσωπον",710986,25],["βασιλέων",702580,81],["ἐνετείλατο",704791,23],["αὐτῷ",702165,50],["πρὸς",710844,0],["λαὸν",708094,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔδειξεν",703314,2],["αὐτῷ",702165,50],["τῆς",709436,16],["δόξης",703791,17],["αὐτοῦ",702165,102]],"By his words he caused the wonders to cease, and he made him glorious in the sight of kings, and gave him a commandment for his people, and shewed him part of his glory."],["4",[["ἐν",704639,0],["πίστει",710484,1],["καὶ",707031,7],["πραΰτητι",710726,1],["αὐτὸν",702165,85],["ἡγίασεν",700153,2],["ἐξελέξατο",704236,23],["αὐτὸν",702165,85],["ἐκ",704132,0],["πάσης",710177,82],["σαρκός",711537,17]],"He sanctified him [in] his faithfulness and meekness, and chose him out of all men."],["5",[["ἠκούτισεν",700585,2],["αὐτὸν",702165,85],["τῆς",709436,16],["φωνῆς",713640,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἰσήγαγεν",704107,2],["αὐτὸν",702165,85],["εἰς",704105,0],["τὸν",709436,5],["γνόφον",703131,6],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["κατὰ",707200,0],["πρόσωπον",710986,25],["ἐντολάς",704802,39],["νόμον",709349,6],["ζωῆς",705910,17],["καὶ",707031,7],["ἐπιστήμης",705267,17],["διδάξαι",703649,106],["τὸν",709436,5],["Ιακωβ",706401,6],["διαθήκην",703456,9],["καὶ",707031,7],["κρίματα",707903,42],["αὐτοῦ",702165,102],["τὸν",709436,5],["Ισραηλ",706839,6]],"He made him to hear his voice, and brought him into the dark cloud, and gave him commandments before his face, even the law of life and knowledge, that he might teach Jacob his covenants, and Israel his judgments."],["6",[["Ααρων",700005,6],["ὕψωσεν",713289,2],["ἅγιον",700159,27],["ὅμοιον",709626,27],["αὐτῷ",702165,50],["ἀδελφὸν",700249,6],["αὐτοῦ",702165,102],["ἐκ",704132,0],["φυλῆς",713620,17],["Λευι",708158,18]],"He exalted Aaron, an holy man like unto him, even his brother, of the tribe of Levi."],["7",[["ἔστησεν",706846,2],["αὐτὸν",702165,85],["διαθήκην",703456,9],["αἰῶνος",700504,18],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["ἱερατείαν",706604,9],["λαοῦ",708094,18],["ἐμακάρισεν",708396,2],["αὐτὸν",702165,85],["ἐν",704639,0],["εὐκοσμίᾳ",705624,1],["καὶ",707031,7],["περιέζωσεν",710317,2],["αὐτὸν",702165,85],["περιστολὴν",710393,9],["δόξης",703791,17]],"An everlasting covenant he made with him, and gave him the priesthood among the people; he beautified him with comely ornaments, and clothed him with a robe of glory."],["8",[["ἐνέδυσεν",704701,2],["αὐτὸν",702165,85],["συντέλειαν",712509,9],["καυχήματος",707570,21],["καὶ",707031,7],["ἐστερέωσεν",712076,2],["αὐτὸν",702165,85],["σκεύεσιν",711844,96],["ἰσχύος",706858,17],["περισκελῆ",710379,68],["καὶ",707031,7],["ποδήρη",710577,27],["καὶ",707031,7],["ἐπωμίδα",705374,9]],"He put upon him perfect glory; and strengthened him with rich garments, with breeches, with a long robe, and the ephod."],["9",[["καὶ",707031,7],["ἐκύκλωσεν",707958,2],["αὐτὸν",702165,85],["ῥοΐσκοις",711287,148],["χρυσοῖς",713971,230],["κώδωσιν",708006,148],["πλείστοις",710646,343],["κυκλόθεν",707956,28],["ἠχῆσαι",706045,106],["φωνὴν",713640,9],["ἐν",704639,0],["βήμασιν",702698,96],["αὐτοῦ",702165,102],["ἀκουστὸν",700584,46],["ποιῆσαι",710582,106],["ἦχον",705785,137],["ἐν",704639,0],["ναῷ",709191,54],["εἰς",704105,0],["μνημόσυνον",708966,25],["υἱοῖς",713075,148],["λαοῦ",708094,18],["αὐτοῦ",702165,102]],"And he compassed him with pomegranates and with many golden bells round about, that as he went there might be a sound, and a noise made that might be heard in the temple for a memorial to the children of his people;"],["10",[["στολῇ",712120,1],["ἁγίᾳ",700159,101],["χρυσῷ",713971,101],["καὶ",707031,7],["ὑακίνθῳ",713048,1],["καὶ",707031,7],["πορφύρᾳ",710682,1],["ἔργῳ",705396,54],["ποικιλτοῦ",710590,18],["λογείῳ",708231,54],["κρίσεως",707908,17],["δήλοις",703401,94],["ἀληθείας",700656,17],["κεκλωσμένῃ",707746,455],["κόκκῳ",707784,114],["ἔργῳ",705396,54],["τεχνίτου",712832,18]],"with a holy garment, with gold, and blue silk, and purple, the work of the embroiderer, with a breastplate of judgment, with the revealers of truth;"],["11",[["λίθοις",708196,148],["πολυτελέσιν",710647,230],["γλύμματος",703116,21],["σφραγῖδος",712591,17],["ἐν",704639,0],["δέσει",703368,1],["χρυσίου",713972,21],["ἔργῳ",705396,54],["λιθουργοῦ",708200,18],["εἰς",704105,0],["μνημόσυνον",708966,25],["ἐν",704639,0],["γραφῇ",703191,1],["κεκολαμμένῃ",707788,455],["κατ᾿",707200,0],["ἀριθμὸν",701744,6],["φυλῶν",713620,65],["Ισραηλ",706839,118]],"with twisted scarlet, the work of the cunning workman, with precious stones graven like seals, and set in gold, the work of the jeweller, with a writing engraved for a memorial, after the number of the tribes of Israel."],["12",[["στέφανον",712083,6],["χρυσοῦν",713971,27],["ἐπάνω",705030,28],["κιδάρεως",707668,17],["ἐκτύπωμα",704350,25],["σφραγῖδος",712591,17],["ἁγιάσματος",700154,21],["καύχημα",707570,25],["τιμῆς",712856,17],["ἔργον",705396,25],["ἰσχύος",706858,17],["ἐπιθυμήματα",705142,42],["ὀφθαλμῶν",709870,81],["κοσμούμενα",707847,67]],"He set a crown of gold upon the mitre, wherein was engraven Holiness, an ornament of honour, a costly work, the desires of the eyes, goodly and beautiful."],["13",[["ὡραῖα",714132,195],["πρὸ",710747,0],["αὐτοῦ",702165,102],["οὐ",709805,28],["γέγονεν",703104,171],["τοιαῦτα",712878,195],["ἕως",705792,0],["αἰῶνος",700504,18],["οὐκ",709805,28],["ἐνεδύσατο",704701,23],["ἀλλογενὴς",700690,14],["πλὴν",710540,28],["τῶν",709436,80],["υἱῶν",713075,81],["αὐτοῦ",702165,102],["μόνον",709001,28],["καὶ",707031,7],["τὰ",709436,63],["ἔκγονα",704159,195],["αὐτοῦ",702165,102],["διὰ",703417,0],["παντός",710177,92]],"Before him there were none such, neither did ever any stranger put them on, but only his children and his children's children perpetually."],["14",[["θυσίαι",706345,191],["αὐτοῦ",702165,102],["ὁλοκαρπωθήσονται",709585,144],["καθ᾿",707200,0],["ἡμέραν",705984,9],["ἐνδελεχῶς",704681,28],["δίς",703741,28]],"Their sacrifices shall be wholly consumed every day twice continually."],["15",[["ἐπλήρωσεν",710543,2],["Μωυσῆς",709112,4],["τὰς",709436,38],["χεῖρας",713787,39],["καὶ",707031,7],["ἔχρισεν",713965,2],["αὐτὸν",702165,85],["ἐν",704639,0],["ἐλαίῳ",704380,54],["ἁγίῳ",700159,97],["ἐγενήθη",703104,37],["αὐτῷ",702165,50],["εἰς",704105,0],["διαθήκην",703456,9],["αἰῶνος",700504,18],["καὶ",707031,7],["τῷ",709436,53],["σπέρματι",712008,54],["αὐτοῦ",702165,102],["ἐν",704639,0],["ἡμέραις",705984,76],["οὐρανοῦ",709844,18],["λειτουργεῖν",708132,55],["αὐτῷ",702165,50],["ἅμα",700745,28],["καὶ",707031,7],["ἱερατεύειν",706607,55],["καὶ",707031,7],["εὐλογεῖν",705631,55],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,53],["ὀνόματι",709666,54]],"Moses consecrated him, and anointed him with holy oil; this was appointed unto him by an everlasting covenant, and to his seed, so long as the heavens should remain, that they should minister unto him, and execute the office of the priesthood, and bless the people in his name."],["16",[["ἐξελέξατο",704236,23],["αὐτὸν",702165,85],["ἀπὸ",701425,0],["παντὸς",710177,116],["ζῶντος",705851,152],["προσαγαγεῖν",710848,106],["κάρπωσιν",707174,96],["κυρίῳ",707996,114],["θυμίαμα",706330,25],["καὶ",707031,7],["εὐωδίαν",705734,9],["εἰς",704105,0],["μνημόσυνον",708966,25],["ἐξιλάσκεσθαι",704932,110],["περὶ",710285,0],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133]],"He chose him out of all men living to offer sacrifices to the Lord, incense, and a sweet savour, for a memorial, to make reconciliation for his people."],["17",[["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["ἐν",704639,0],["ἐντολαῖς",704802,76],["αὐτοῦ",702165,102],["ἐξουσίαν",704974,9],["ἐν",704639,0],["διαθήκαις",703456,76],["κριμάτων",707903,44],["διδάξαι",703649,106],["τὸν",709436,5],["Ιακωβ",706401,6],["τὰ",709436,41],["μαρτύρια",708524,12],["καὶ",707031,7],["ἐν",704639,0],["νόμῳ",709349,114],["αὐτοῦ",702165,102],["φωτίσαι",713646,106],["Ισραηλ",706839,227]],"He gave unto him his commandments, and authority in the statutes of judgments, that he should teach Jacob the testimonies, and inform Israel in his laws."],["18",[["ἐπισυνέστησαν",705283,150],["αὐτῷ",702165,50],["ἀλλότριοι",700699,138],["καὶ",707031,7],["ἐζήλωσαν",705873,150],["αὐτὸν",702165,85],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["ἄνδρες",701150,52],["οἱ",709436,136],["περὶ",710285,0],["Δαθαν",703244,18],["καὶ",707031,7],["Αβιρων",700074,18],["καὶ",707031,7],["ἡ",709436,10],["συναγωγὴ",712376,12],["Κορε",707833,18],["ἐν",704639,0],["θυμῷ",706334,114],["καὶ",707031,7],["ὀργῇ",709728,1]],"Strangers conspired together against him, and maligned him in the wilderness, even the men that were of Dathan's and Abiron's side, and the congregation of Core, with fury and wrath."],["19",[["εἶδεν",709725,2],["κύριος",707996,4],["καὶ",707031,7],["οὐκ",709805,28],["εὐδόκησεν",705565,2],["καὶ",707031,7],["συνετελέσθησαν",712510,99],["ἐν",704639,0],["θυμῷ",706334,114],["ὀργῆς",709728,17],["ἐποίησεν",710582,2],["αὐτοῖς",702165,151],["τέρατα",712793,25],["καταναλῶσαι",707338,106],["ἐν",704639,0],["πυρὶ",711088,54],["φλογὸς",713524,17],["αὐτοῦ",702165,102]],"This the Lord saw, and it displeased him, and in his wrathful indignation were they consumed: he did wonders upon them, to consume them with the fiery flame."],["20",[["καὶ",707031,7],["προσέθηκεν",710965,2],["Ααρων",700005,114],["δόξαν",703791,9],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["κληρονομίαν",707725,9],["ἀπαρχὰς",701359,39],["πρωτογενημάτων",711033,44],["ἐμέρισεν",708744,2],["αὐτῷ",702165,50],["ἄρτον",701829,6],["πρώτοις",711041,230],["ἡτοίμασεν",705539,2],["πλησμονήν",710549,9]],"But he made Aaron more honourable, and gave him an heritage, and divided unto him the firstfruits of the increase; especially he prepared bread in abundance:"],["21",[["καὶ",707031,28],["γὰρ",702963,11],["θυσίας",706345,39],["κυρίου",707996,18],["φάγονται",713296,135],["ἃς",709781,193],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["τε",712751,11],["καὶ",707031,7],["τῷ",709436,53],["σπέρματι",712008,54],["αὐτοῦ",702165,102]],"for they eat of the sacrifices of the Lord, which he gave unto him and his seed."],["22",[["πλὴν",710540,28],["ἐν",704639,0],["γῇ",703083,1],["λαοῦ",708094,18],["οὐ",709805,28],["κληρονομήσει",707724,127],["καὶ",707031,7],["μερὶς",708748,12],["οὐκ",709805,28],["ἔστιν",704093,91],["αὐτῷ",702165,50],["ἐν",704639,0],["λαῷ",708094,114],["αὐτὸς",702165,121],["γὰρ",702963,11],["μερίς",708748,12],["σου",711945,133],["καὶ",707031,7],["κληρονομία",707725,12]],"Howbeit in the land of the people he had no inheritance, neither had he any portion among the people: for the Lord himself is his portion and inheritance."],["23",[["καὶ",707031,7],["Φινεες",713510,4],["υἱὸς",713075,4],["Ελεαζαρ",704407,18],["τρίτος",712968,14],["εἰς",704105,0],["δόξαν",703791,9],["ἐν",704639,0],["τῷ",709436,53],["ζηλῶσαι",705873,106],["αὐτὸν",702165,85],["ἐν",704639,0],["φόβῳ",713534,114],["κυρίου",707996,18],["καὶ",707031,7],["στῆναι",706846,106],["αὐτὸν",702165,85],["ἐν",704639,0],["τροπῇ",712978,1],["λαοῦ",708094,18],["ἐν",704639,0],["ἀγαθότητι",700107,1],["προθυμίας",710798,17],["ψυχῆς",714070,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐξιλάσατο",704932,23],["περὶ",710285,0],["τοῦ",709436,35],["Ισραηλ",706839,18]],"The third in glory is Phinees the son of Eleazar, because he had zeal in the fear of the Lord, and stood up with good courage of heart when the people were turned back, and made reconciliation for Israel."],["24",[["διὰ",703417,0],["τοῦτο",709858,129],["ἐστάθη",706846,37],["αὐτῷ",702165,50],["διαθήκη",703456,12],["εἰρήνης",704098,17],["προστατεῖν",710963,106],["ἁγίων",700159,83],["καὶ",707031,7],["λαοῦ",708094,18],["αὐτοῦ",702165,102],["ἵνα",706747,7],["αὐτῷ",702165,50],["ᾖ",704093,204],["καὶ",707031,7],["τῷ",709436,53],["σπέρματι",712008,54],["αὐτοῦ",702165,102],["ἱερωσύνης",706650,17],["μεγαλεῖον",708625,46],["εἰς",704105,0],["τοὺς",709436,58],["αἰῶνας",700504,57]],"Therefore was there a covenant of peace made with him, that he should be the chief of the sanctuary and of his people, and that he and his posterity should have the dignity of the priesthood for ever:"],["25",[["καὶ",707031,7],["διαθήκη",703456,12],["τῷ",709436,113],["Δαυιδ",703232,114],["υἱῷ",713075,114],["Ιεσσαι",706668,18],["ἐκ",704132,0],["φυλῆς",713620,17],["Ιουδα",706768,18],["κληρονομία",707725,12],["βασιλέως",702580,18],["υἱοῦ",713075,18],["ἐξ",704132,0],["υἱοῦ",713075,18],["μόνου",709003,116],["κληρονομία",707725,12],["Ααρων",700005,18],["καὶ",707031,7],["τῷ",709436,53],["σπέρματι",712008,54],["αὐτοῦ",702165,102]],"according to the covenant made with David son of Jesse, of the tribe of Juda, that the inheritance of the king should be to his posterity alone: so the inheritance of Aaron should also be unto his seed."],["26",[["δῴη",703654,225],["ὑμῖν",713084,90],["σοφίαν",711981,9],["ἐν",704639,0],["καρδίᾳ",707141,1],["ὑμῶν",713091,145],["κρίνειν",707905,55],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["ἐν",704639,0],["δικαιοσύνῃ",703695,1],["ἵνα",706747,7],["μὴ",708851,28],["ἀφανισθῇ",702182,384],["τὰ",709436,63],["ἀγαθὰ",700106,195],["αὐτῶν",702165,40],["καὶ",707031,7],["τὴν",709436,8],["δόξαν",703791,9],["αὐτῶν",702165,40],["εἰς",704105,0],["γενεὰς",703037,39],["αὐτῶν",702165,40]],"God give you wisdom in your heart to judge his people in righteousness, that their good things be not abolished, and that their glory may endure for ever."]]