[["1",[["ὁ",709436,3],["ποιῶν",710582,72],["ἔλεος",704426,25],["δανιεῖ",703277,127],["τῷ",709436,113],["πλησίον",710547,28],["καὶ",707031,7],["ὁ",709436,3],["ἐπισχύων",705289,72],["τῇ",709436,100],["χειρὶ",713787,1],["αὐτοῦ",702165,102],["τηρεῖ",712844,91],["ἐντολάς",704802,39]],"He that is merciful will lend unto his neighbour; and he that strengtheneth his hand keepeth the commandments."],["2",[["δάνεισον",703277,176],["τῷ",709436,113],["πλησίον",710547,28],["ἐν",704639,0],["καιρῷ",707047,114],["χρείας",713938,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["πάλιν",709942,28],["ἀπόδος",701449,176],["τῷ",709436,113],["πλησίον",710547,28],["εἰς",704105,0],["τὸν",709436,5],["καιρόν",707047,6]],"Lend to thy neighbour in time of his need, and pay thou thy neighbour again in due season."],["3",[["στερέωσον",712076,176],["λόγον",708236,6],["καὶ",707031,7],["πιστώθητι",710487,244],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["παντὶ",710177,30],["καιρῷ",707047,114],["εὑρήσεις",705676,166],["τὴν",709436,8],["χρείαν",713938,9],["σου",711945,133]],"Keep thy word, and deal faithfully with him, and thou shalt always find the thing that is necessary for thee."],["4",[["πολλοὶ",710646,138],["ὡς",714148,7],["εὕρεμα",705671,25],["ἐνόμισαν",709338,150],["δάνος",703285,25],["καὶ",707031,7],["παρέσχον",710142,150],["κόπον",707825,6],["τοῖς",709436,147],["βοηθήσασιν",702746,456],["αὐτοῖς",702165,151]],"Many, when a thing was lent them, reckoned it to be found, and put them to trouble that helped them."],["5",[["ἕως",705792,7],["οὗ",709781,48],["λάβῃ",708076,172],["καταφιλήσει",707476,127],["χεῖρας",713787,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπὶ",705080,0],["τῶν",709436,43],["χρημάτων",713948,44],["τοῦ",709436,35],["πλησίον",710547,28],["ταπεινώσει",712717,127],["φωνήν",713640,9],["καὶ",707031,7],["ἐν",704639,0],["καιρῷ",707047,114],["ἀποδόσεως",701453,17],["παρελκύσει",710131,127],["χρόνον",713969,6],["καὶ",707031,7],["ἀποδώσει",701449,127],["λόγους",708236,57],["ἀκηδίας",700537,17],["καὶ",707031,7],["τὸν",709436,5],["καιρὸν",707047,6],["αἰτιάσεται",700493,93]],"Till he hath received, he will kiss a man's hand; and for his neighbour's money he will speak submissively: but when he should repay, he will prolong the time, and return words of grief, and complain of the time."],["6",[["ἐὰν",703912,7],["ἰσχύσῃ",706859,172],["μόλις",708982,28],["κομίσεται",707805,93],["τὸ",709436,24],["ἥμισυ",705998,46],["καὶ",707031,7],["λογιεῖται",708232,93],["αὐτὸ",702165,129],["ὡς",714148,7],["εὕρεμα",705671,25],["εἰ",704071,7],["δὲ",703303,11],["μή",708851,28],["ἀπεστέρησεν",701595,2],["αὐτὸν",702165,85],["τῶν",709436,43],["χρημάτων",713948,44],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐκτήσατο",707932,23],["αὐτὸν",702165,85],["ἐχθρὸν",705779,27],["δωρεάν",703901,9],["κατάρας",707395,39],["καὶ",707031,7],["λοιδορίας",708242,39],["ἀποδώσει",701449,127],["αὐτῷ",702165,50],["καὶ",707031,7],["ἀντὶ",701227,0],["δόξης",703791,17],["ἀποδώσει",701449,127],["αὐτῷ",702165,50],["ἀτιμίαν",702094,9]],"If he prevail, he shall hardly receive the half, and he will count as if he had found it: if not, he hath deprived him of his money, and he hath gotten him an enemy without cause: he payeth him with cursings and railings; and for honour he will pay him disgrace."],["7",[["πολλοὶ",710646,138],["οὐ",709805,28],["χάριν",713735,9],["πονηρίας",710659,17],["ἀπέστρεψαν",701598,150],["ἀποστερηθῆναι",701595,179],["δωρεὰν",703900,9],["εὐλαβήθησαν",705627,99]],"Many therefore have refused to lend for other men's ill dealing, fearing to be defrauded."],["8",[["πλὴν",710540,28],["ἐπὶ",705080,0],["ταπεινῷ",712714,30],["μακροθύμησον",708418,176],["καὶ",707031,7],["ἐπ᾿",705080,0],["ἐλεημοσύνῃ",704421,1],["μὴ",708851,28],["παρελκύσῃς",710131,175],["αὐτόν",702165,85]],"Yet have thou patience with a man in poor estate, and delay not to shew him mercy."],["9",[["χάριν",713735,9],["ἐντολῆς",704802,17],["ἀντιλαβοῦ",701243,300],["πένητος",710248,18],["καὶ",707031,7],["κατὰ",707200,0],["τὴν",709436,8],["ἔνδειαν",704672,9],["αὐτοῦ",702165,102],["μὴ",708851,28],["ἀποστρέψῃς",701598,175],["αὐτὸν",702165,85],["κενόν",707612,27]],"Help the poor for the commandment's sake, and turn him not away because of his poverty."],["10",[["ἀπόλεσον",701513,176],["ἀργύριον",701707,25],["δι᾿",703417,0],["ἀδελφὸν",700249,6],["καὶ",707031,7],["φίλον",713492,27],["καὶ",707031,7],["μὴ",708851,28],["ἰωθήτω",706759,22],["ὑπὸ",713184,0],["τὸν",709436,5],["λίθον",708196,6],["εἰς",704105,0],["ἀπώλειαν",701660,9]],"Lose thy money for thy brother and thy friend, and let it not rust under a stone to be lost."],["11",[["θὲς",712849,176],["τὸν",709436,5],["θησαυρόν",706258,6],["σου",711945,133],["κατ᾿",707200,0],["ἐντολὰς",704802,39],["ὑψίστου",713287,116],["καὶ",707031,7],["λυσιτελήσει",708279,127],["σοι",711925,159],["μᾶλλον",708448,28],["ἢ",705924,7],["τὸ",709436,24],["χρυσίον",713972,25]],"Lay up thy treasure according to the commandments of the most High, and it shall bring thee more profit than gold."],["12",[["σύγκλεισον",712223,176],["ἐλεημοσύνην",704421,9],["ἐν",704639,0],["τοῖς",709436,95],["ταμιείοις",712700,96],["σου",711945,133],["καὶ",707031,7],["αὕτη",709858,107],["ἐξελεῖταί",704838,93],["σε",711598,163],["ἐκ",704132,0],["πάσης",710177,82],["κακώσεως",707075,17]],"Shut up alms in thy storehouses: and it shall deliver thee from all affliction."],["13",[["ὑπὲρ",713111,0],["ἀσπίδα",701991,9],["κράτους",707883,21],["καὶ",707031,7],["ὑπὲρ",713111,0],["δόρυ",703804,25],["ὁλκῆς",709583,17],["κατέναντι",707507,28],["ἐχθροῦ",705779,116],["πολεμήσει",710601,127],["ὑπὲρ",713111,0],["σοῦ",711945,133]],"It shall fight for thee against thine enemies better than a mighty shield and strong spear."],["14",[["ἀνὴρ",701150,4],["ἀγαθὸς",700106,14],["ἐγγυήσεται",703944,134],["τὸν",709436,5],["πλησίον",710547,28],["καὶ",707031,7],["ὁ",709436,3],["ἀπολωλεκὼς",701513,270],["αἰσχύνην",700483,9],["ἐγκαταλείψει",703967,127],["αὐτόν",702165,85]],"An honest man is surety for his neighbour: but he that is impudent will forsake him."],["15",[["χάριτας",713735,39],["ἐγγύου",703947,92],["μὴ",708851,28],["ἐπιλάθῃ",705187,172],["ἔδωκεν",703654,2],["γὰρ",702963,11],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["ὑπὲρ",713111,0],["σοῦ",711945,133]],"Forget not the friendship of thy surety, for he hath given his life for thee."],["16",[["ἀγαθὰ",700106,68],["ἐγγύου",703947,92],["ἀνατρέψει",701073,127],["ἁμαρτωλός",700776,14],["καὶ",707031,7],["ἀχάριστος",702252,14],["ἐν",704639,0],["διανοίᾳ",703531,1],["ἐγκαταλείψει",703967,127],["ῥυσάμενον",711309,424]],"A sinner will overthrow the good estate of his surety: and he that is of an unthankful mind will leave him [in danger] that delivered him.",{"s":"m","br":"29:16 29:17","q":1.0}],["17",[["ἐγγύη",703945,29],["πολλοὺς",710646,60],["ἀπώλεσεν",701513,2],["κατευθύνοντας",707521,235],["καὶ",707031,7],["ἐσάλευσεν",711403,2],["αὐτοὺς",702165,62],["ὡς",714148,7],["κῦμα",707968,15],["θαλάσσης",706069,17]],"Suretyship hath undone many of good estate, and shaken them as a wave of the sea: mighty men hath it driven from their houses, so that they wandered among strange nations.",{"s":"m","br":"29:18","q":0.56,"gd":0.56}],["18",[["ἄνδρας",701150,57],["δυνατοὺς",703845,60],["ἀπῴκισεν",701464,2],["καὶ",707031,7],["ἐπλανήθησαν",710495,99],["ἐν",704639,0],["ἔθνεσιν",704068,96],["ἀλλοτρίοις",700699,94]],null,{"s":"j","with":"29:17"}],["19",[["ἁμαρτωλὸς",700776,14],["ἐμπεσὼν",704593,182],["εἰς",704105,0],["ἐγγύην",703945,9],["καὶ",707031,7],["διώκων",703768,72],["ἐργολαβίας",705395,39],["ἐμπεσεῖται",704593,93],["εἰς",704105,0],["κρίσεις",707908,39]],"A wicked man transgressing the commandments of the Lord shall fall into suretyship: and he that undertaketh and followeth other men's business for gain shall fall into suits."],["20",[["ἀντιλαβοῦ",701243,300],["τοῦ",709436,35],["πλησίον",710547,28],["κατὰ",707200,0],["δύναμίν",703839,9],["σου",711945,133],["καὶ",707031,7],["πρόσεχε",710895,240],["σεαυτῷ",711599,50],["μὴ",708851,28],["ἐμπέσῃς",704593,175]],"Help thy neighbour according to thy power, and beware that thou thyself fall not into the same."],["21",[["ἀρχὴ",701836,12],["ζωῆς",705910,17],["ὕδωρ",713071,15],["καὶ",707031,7],["ἄρτος",701829,4],["καὶ",707031,7],["ἱμάτιον",706742,15],["καὶ",707031,7],["οἶκος",709516,4],["καλύπτων",707102,72],["ἀσχημοσύνην",702054,9]],"The chief thing for life is water, and bread, and clothing, and a house to cover shame."],["22",[["κρείσσων",707891,14],["βίος",702724,4],["πτωχοῦ",711076,18],["ὑπὸ",713184,0],["σκέπην",711839,9],["δοκῶν",703781,65],["ἢ",705924,7],["ἐδέσματα",704032,64],["λαμπρὰ",708082,68],["ἐν",704639,0],["ἀλλοτρίοις",700699,230]],"Better is the life of a poor man in a mean cottage, than delicate fare in another man's house."],["23",[["ἐπὶ",705080,0],["μικρῷ",708915,97],["καὶ",707031,7],["μεγάλῳ",708653,97],["εὐδοκίαν",705566,9],["ἔχε",705785,240],["καὶ",707031,7],["ὀνειδισμὸν",709657,6],["παροικίας",710158,17],["οὐ",709805,28],["μὴ",708851,28],["ἀκούσῃς",700587,175]],"Be it little or much, hold thee contented,",{"s":"d","q":0.5}],["24",[["ζωὴ",705910,12],["πονηρὰ",710660,29],["ἐξ",704132,0],["οἰκίας",709505,17],["εἰς",704105,0],["οἰκίαν",709505,9],["καὶ",707031,7],["οὗ",709806,28],["παροικήσεις",710156,166],["οὐκ",709805,28],["ἀνοίξεις",701186,166],["στόμα",712125,25]],"for it is a miserable life to go from house to house: for where thou art a stranger, thou darest not open thy mouth."],["25",[["ξενιεῖς",709409,166],["καὶ",707031,7],["ποτιεῖς",710700,166],["εἰς",704105,0],["ἀχάριστα",702252,68],["καὶ",707031,7],["πρὸς",710844,0],["ἐπὶ",705080,0],["τούτοις",709858,206],["πικρὰ",710475,68],["ἀκούσῃ",700587,123]],"Thou shalt entertain, and feast, and have no thanks: moreover thou shalt hear bitter words:"],["26",[["πάρελθε",710141,176],["πάροικε",710156,176],["κόσμησον",707847,176],["τράπεζαν",712919,9],["καὶ",707031,7],["εἴ",704071,7],["τι",712866,273],["ἐν",704639,0],["τῇ",709436,100],["χειρί",713787,1],["σου",711945,133],["ψώμισόν",714077,176],["με",708618,163]],"Come, thou stranger, and furnish a table, and feed me of that thou hast ready."],["27",[["ἔξελθε",704909,176],["πάροικε",710156,176],["ἀπὸ",701425,0],["προσώπου",710986,21],["δόξης",703791,17],["ἐπεξένωταί",705217,187],["μοι",708974,159],["ὁ",709436,3],["ἀδελφός",700249,4],["χρεία",713938,12],["τῆς",709436,16],["οἰκίας",709505,17]],"Give place, thou stranger, to an honourable man; my brother cometh to be lodged, and I have need of mine house."],["28",[["βαρέα",702554,195],["ταῦτα",709858,290],["ἀνθρώπῳ",701163,114],["ἔχοντι",705785,379],["φρόνησιν",713588,9],["ἐπιτίμησις",705306,12],["οἰκίας",709505,17],["καὶ",707031,7],["ὀνειδισμὸς",709657,4],["δανειστοῦ",703280,18]],"These things are grievous to a man of understanding; the upbraiding of houseroom, and reproaching of the lender."]]