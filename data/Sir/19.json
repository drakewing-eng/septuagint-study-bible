[["1",[["ἐργάτης",705390,4],["μέθυσος",708675,14],["οὐ",709805,28],["πλουτισθήσεται",710562,134],["ὁ",709436,3],["ἐξουθενῶν",704969,72],["τὰ",709436,41],["ὀλίγα",709568,68],["κατὰ",707200,0],["μικρὸν",708915,46],["πεσεῖται",710481,93]],"A labouring man that is given to drunkenness shall not be rich: and he that contemneth small things shall fall by little and little."],["2",[["οἶνος",709530,4],["καὶ",707031,7],["γυναῖκες",703209,191],["ἀποστήσουσιν",702214,218],["συνετούς",712464,60],["καὶ",707031,7],["ὁ",709436,3],["κολλώμενος",707791,122],["πόρναις",710675,76],["τολμηρότερος",712888,224],["ἔσται",704093,93]],"Wine and women will make men of understanding to fall away: and he that cleaveth to harlots will become impudent."],["3",[["σήπη",711753,12],["καὶ",707031,7],["σκώληκες",711905,52],["κληρονομήσουσιν",707724,218],["αὐτόν",702165,85],["καὶ",707031,7],["ψυχὴ",714070,12],["τολμηρὰ",712887,29],["ἐξαρθήσεται",704839,134]],"Moths and worms shall have him to heritage, and a bold man shall be taken away."],["4",[["ὁ",709436,3],["ταχὺ",712748,28],["ἐμπιστεύων",704594,72],["κοῦφος",707863,14],["καρδίᾳ",707141,1],["καὶ",707031,7],["ὁ",709436,3],["ἁμαρτάνων",700773,72],["εἰς",704105,0],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["πλημμελήσει",710534,127]],"He that is hasty to give credit is light-minded; and he that sinneth shall offend against his own soul."],["5",[["ὁ",709436,3],["εὐφραινόμενος",705715,122],["καρδίᾳ",707141,1],["καταγνωσθήσεται",707226,134]],"Whoso taketh pleasure in wickedness shall be condemned:"],["6",[["καὶ",707031,7],["ὁ",709436,3],["μισῶν",708935,72],["λαλιὰν",708074,9],["ἐλαττονοῦται",704393,117],["κακίᾳ",707054,1]],"but he that hateth babbling hath less of evil."],["7",[["μηδέποτε",708858,28],["δευτερώσῃς",703390,175],["λόγον",708236,6],["καὶ",707031,7],["οὐθέν",709817,26],["σοι",711925,159],["οὐ",709805,28],["μὴ",708851,28],["ἐλαττονωθῇ",704393,384]],"Rehearse not unto another that which is told unto thee, and thou shalt fare never the worse."],["8",[["ἐν",704639,0],["φίλῳ",713492,30],["καὶ",707031,7],["ἐχθρῷ",705779,30],["μὴ",708851,28],["διηγοῦ",703679,253],["καὶ",707031,7],["εἰ",704071,7],["μή",708851,28],["ἐστίν",704093,91],["σοι",711925,159],["ἁμαρτία",700775,12],["μὴ",708851,28],["ἀποκάλυπτε",701474,240]],"Whether it be to friend or foe, talk not of other men's lives; and if thou canst not without offence, reveal them not."],["9",[["ἀκήκοεν",700587,171],["γάρ",702963,11],["σου",711945,133],["καὶ",707031,7],["ἐφυλάξατό",713619,23],["σε",711598,163],["καὶ",707031,7],["ἐν",704639,0],["καιρῷ",707047,114],["μισήσει",708935,127],["σε",711598,163]],"For he heard and observed thee, and when time cometh he will hate thee."],["10",[["ἀκήκοας",700587,266],["λόγον",708236,6],["συναποθανέτω",712400,45],["σοι",711925,159],["θάρσει",706122,240],["οὐ",709805,28],["μή",708851,28],["σε",711598,163],["ῥήξει",711243,127]],"If thou hast heard a word, let it die with thee; and be bold, it will not burst thee."],["11",[["ἀπὸ",701425,0],["προσώπου",710986,21],["λόγου",708236,18],["ὠδινήσει",714095,127],["μωρὸς",709110,14],["ὡς",714148,7],["ἀπὸ",701425,0],["προσώπου",710986,21],["βρέφους",702811,21],["ἡ",709436,10],["τίκτουσα",712853,188]],"A fool travaileth with a word, as a woman in labour of a child."],["12",[["βέλος",702644,15],["πεπηγὸς",710452,426],["ἐν",704639,0],["μηρῷ",708885,114],["σαρκός",711537,17],["οὕτως",709859,28],["λόγος",708236,4],["ἐν",704639,0],["κοιλίᾳ",707761,1],["μωροῦ",709110,116]],"As an arrow that sticketh in a man's thigh, so is a word within a fool's belly."],["13",[["ἔλεγξον",704416,176],["φίλον",713492,27],["μήποτε",708882,28],["οὐκ",709805,28],["ἐποίησεν",710582,2],["καὶ",707031,7],["εἴ",704071,7],["τι",712866,126],["ἐποίησεν",710582,2],["μήποτε",708882,28],["προσθῇ",710906,204]],"Admonish a friend, it may be he hath not done it: and if he have done it, that he do it no more."],["14",[["ἔλεγξον",704416,176],["τὸν",709436,5],["πλησίον",710547,28],["μήποτε",708882,28],["οὐκ",709805,28],["εἶπεν",705373,2],["καὶ",707031,7],["εἰ",704071,7],["εἴρηκεν",705415,171],["ἵνα",706747,7],["μὴ",708851,28],["δευτερώσῃ",703390,172]],"Admonish thy friend, it may be he hath not said it: and if he have, that he speak it not again."],["15",[["ἔλεγξον",704416,176],["φίλον",713492,27],["πολλάκις",710617,28],["γὰρ",702963,11],["γίνεται",703104,117],["διαβολή",703427,12],["καὶ",707031,7],["μὴ",708851,28],["παντὶ",710177,30],["λόγῳ",708236,114],["πίστευε",710483,240]],"Admonish a friend: for many times it is a slander, and believe not every tale."],["16",[["ἔστιν",704093,91],["ὀλισθάνων",709579,72],["καὶ",707031,7],["οὐκ",709805,28],["ἀπὸ",701425,0],["ψυχῆς",714070,17],["καὶ",707031,7],["τίς",712867,158],["οὐχ",709805,28],["ἥμαρτεν",700773,2],["ἐν",704639,0],["τῇ",709436,100],["γλώσσῃ",703120,1],["αὐτοῦ",702165,102]],"There is one that slippeth in his speech, but not from his heart; and who is he that hath not offended with his tongue?"],["17",[["ἔλεγξον",704416,176],["τὸν",709436,5],["πλησίον",710547,28],["σου",711945,133],["πρὶν",710742,28],["ἢ",705924,28],["ἀπειλῆσαι",701374,106],["καὶ",707031,7],["δὸς",703654,176],["τόπον",712903,6],["νόμῳ",709349,114],["ὑψίστου",713287,116]],"Admonish thy neighbour before thou threaten him; and give place to the law of the most High."],["20",[["πᾶσα",710177,29],["σοφία",711981,12],["φόβος",713534,4],["κυρίου",707996,18],["καὶ",707031,7],["ἐν",704639,0],["πάσῃ",710177,101],["σοφίᾳ",711981,1],["ποίησις",710584,12],["νόμου",709349,18]],"The fear of the Lord is all wisdom; and in all wisdom is the performance of the law."],["22",[["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["σοφία",711981,12],["πονηρίας",710659,17],["ἐπιστήμη",705267,12],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ὅπου",709710,11],["βουλὴ",702792,12],["ἁμαρτωλῶν",700776,169],["φρόνησις",713588,12]],"The knowledge of wickedness is not wisdom, neither at any time the counsel of sinners prudence."],["23",[["ἔστιν",704093,91],["πανουργία",709971,12],["καὶ",707031,7],["αὕτη",709858,107],["βδέλυγμα",702604,15],["καὶ",707031,7],["ἔστιν",704093,91],["ἄφρων",702236,14],["ἐλαττούμενος",704394,122],["σοφίᾳ",711981,1]],"There is a wickedness, and the same an abomination; and there is a fool wanting in wisdom."],["24",[["κρείττων",707891,14],["ἡττώμενος",706040,122],["ἐν",704639,0],["συνέσει",712460,1],["ἔμφοβος",704633,14],["ἢ",705924,7],["περισσεύων",710386,72],["ἐν",704639,0],["φρονήσει",713588,1],["καὶ",707031,7],["παραβαίνων",709996,72],["νόμον",709349,6]],"He that hath small understanding, and feareth God, is better than one that hath much wisdom, and transgresseth the law of the most High."],["25",[["ἔστιν",704093,91],["πανουργία",709971,12],["ἀκριβὴς",700597,29],["καὶ",707031,7],["αὕτη",709858,107],["ἄδικος",700272,29],["καὶ",707031,7],["ἔστιν",704093,91],["διαστρέφων",703592,72],["χάριν",713735,9],["τοῦ",709436,20],["ἐκφᾶναι",704358,55],["κρίμα",707903,25]],"There is an exquisite subtilty, and the same is unjust; and there is one that turneth aside to make judgment appear."],["26",[["ἔστιν",704093,91],["πονηρευόμενος",710658,122],["συγκεκυφὼς",712240,270],["μελανίᾳ",708693,1],["καὶ",707031,7],["τὰ",709436,63],["ἐντὸς",704804,28],["αὐτοῦ",702165,102],["πλήρη",710541,195],["δόλου",703787,18]],"There is a wicked man that hangeth down his head sadly; but inwardly he is full of deceit,"],["27",[["συγκρύφων",712238,72],["πρόσωπον",710986,25],["καὶ",707031,7],["ἐθελοκωφῶν",704057,72],["ὅπου",709710,11],["οὐκ",709805,28],["ἐπεγνώσθη",705104,37],["προφθάσει",711011,127],["σε",711598,163]],"casting down his countenance, and making as if he heard not: where he is not known, he will do thee a mischief before thou be aware."],["28",[["καὶ",707031,7],["ἐὰν",703912,7],["ὑπὸ",713184,0],["ἐλαττώματος",704395,21],["ἰσχύος",706858,17],["κωλυθῇ",708020,384],["ἁμαρτεῖν",700773,106],["ἐὰν",703912,7],["εὕρῃ",705676,172],["καιρόν",707047,6],["κακοποιήσει",707062,127]],"And if for want of power he be hindered from sinning, yet when he findeth opportunity he will do evil."],["29",[["ἀπὸ",701425,0],["ὁράσεως",709721,17],["ἐπιγνωσθήσεται",705104,134],["ἀνήρ",701150,4],["καὶ",707031,7],["ἀπὸ",701425,0],["ἀπαντήσεως",701348,17],["προσώπου",710986,21],["ἐπιγνωσθήσεται",705104,134],["νοήμων",709329,14]],"A man may be known by his look, and one that hath understanding by his countenance, when thou meetest him."],["30",[["στολισμὸς",712122,4],["ἀνδρὸς",701150,18],["καὶ",707031,7],["γέλως",703032,4],["ὀδόντων",709461,81],["καὶ",707031,7],["βήματα",702698,64],["ἀνθρώπου",701163,18],["ἀναγγελεῖ",700921,127],["τὰ",709436,41],["περὶ",710285,0],["αὐτοῦ",702165,102]],"A man's attire, and excessive laughter, and gait, shew what he is."]]