[["1",[["τίμα",712855,240],["ἰατρὸν",706459,6],["πρὸς",710844,0],["τὰς",709436,38],["χρείας",713938,39],["αὐτοῦ",702165,102],["τιμαῖς",712856,76],["αὐτοῦ",702165,102],["καὶ",707031,7],["γὰρ",702963,11],["αὐτὸν",702165,85],["ἔκτισεν",707938,2],["κύριος",707996,4]],"Honour a physician with the honour due unto him for the uses which ye may have of him: for the Lord hath created him."],["2",[["παρὰ",709995,0],["γὰρ",702963,11],["ὑψίστου",713287,116],["ἐστὶν",704093,91],["ἴασις",706444,12],["καὶ",707031,7],["παρὰ",709995,0],["βασιλέως",702580,18],["λήμψεται",708076,93],["δόμα",703789,25]],"For of the most High cometh healing, and he shall receive honour of the king."],["3",[["ἐπιστήμη",705267,12],["ἰατροῦ",706459,18],["ἀνυψώσει",701293,127],["κεφαλὴν",707639,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔναντι",704653,0],["μεγιστάνων",708657,81],["θαυμασθήσεται",706135,134]],"The skill of the physician shall lift up his head: and in the sight of great men he shall be in admiration."],["4",[["κύριος",707996,4],["ἔκτισεν",707938,2],["ἐκ",704132,0],["γῆς",703083,17],["φάρμακα",713369,42],["καὶ",707031,7],["ἀνὴρ",701150,4],["φρόνιμος",713589,14],["οὐ",709805,28],["προσοχθιεῖ",710945,127],["αὐτοῖς",702165,206]],"The Lord hath created medicines out of the earth; and he that is wise will not abhor them."],["5",[["οὐκ",709805,28],["ἀπὸ",701425,0],["ξύλου",709427,21],["ἐγλυκάνθη",703110,37],["ὕδωρ",713071,15],["εἰς",704105,0],["τὸ",709436,24],["γνωσθῆναι",703105,179],["τὴν",709436,8],["ἰσχὺν",706858,9],["αὐτοῦ",702165,102]],"Was not the water made sweet with wood, that the virtue thereof might be known?"],["6",[["καὶ",707031,7],["αὐτὸς",702165,121],["ἔδωκεν",703654,2],["ἀνθρώποις",701163,148],["ἐπιστήμην",705267,9],["ἐνδοξάζεσθαι",704693,110],["ἐν",704639,0],["τοῖς",709436,95],["θαυμασίοις",706136,94],["αὐτοῦ",702165,102]],"And he hath given men skill, that he might be honoured in his marvellous works."],["7",[["ἐν",704639,0],["αὐτοῖς",702165,206],["ἐθεράπευσεν",706200,2],["καὶ",707031,7],["ἦρεν",700473,2],["τὸν",709436,5],["πόνον",710661,6],["αὐτοῦ",702165,102],["μυρεψὸς",709061,4],["ἐν",704639,0],["τούτοις",709858,206],["ποιήσει",710582,127],["μεῖγμα",708678,25]],"With such doth he heal [men,] and taketh away their pains."],["8",[["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["συντελεσθῇ",712510,384],["ἔργα",705396,64],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἰρήνη",704098,12],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["ἐστιν",704093,91],["ἐπὶ",705080,0],["προσώπου",710986,21],["τῆς",709436,16],["γῆς",703083,17]],"Of such doth the apothecary make a confection; and of his works there is no end; and from him is peace over all the earth."],["9",[["τέκνον",712761,297],["ἐν",704639,0],["ἀρρωστήματί",701812,54],["σου",711945,133],["μὴ",708851,28],["παράβλεπε",710002,240],["ἀλλ᾿",700680,7],["εὖξαι",705727,300],["κυρίῳ",707996,114],["καὶ",707031,7],["αὐτὸς",702165,121],["ἰάσεταί",706424,127],["σε",711598,163]],"My son, in thy sickness be not negligent: but pray unto the Lord, and he will make thee whole."],["10",[["ἀπόστησον",702214,176],["πλημμέλειαν",710533,9],["καὶ",707031,7],["εὔθυνον",705601,176],["χεῖρας",713787,39],["καὶ",707031,7],["ἀπὸ",701425,0],["πάσης",710177,82],["ἁμαρτίας",700775,17],["καθάρισον",706985,176],["καρδίαν",707141,9]],"Leave off from sin, and order thine hands aright, and cleanse thy heart from all wickedness."],["11",[["δὸς",703654,176],["εὐωδίαν",705734,9],["καὶ",707031,7],["μνημόσυνον",708966,25],["σεμιδάλεως",711675,17],["καὶ",707031,7],["λίπανον",708215,176],["προσφορὰν",710976,9],["ὡς",714148,7],["μὴ",708851,28],["ὑπάρχων",713104,72]],"Give a sweet savour, and a memorial of fine flour; and make a fat offering, as not being."],["12",[["καὶ",707031,7],["ἰατρῷ",706459,114],["δὸς",703654,176],["τόπον",712903,6],["καὶ",707031,28],["γὰρ",702963,11],["αὐτὸν",702165,85],["ἔκτισεν",707938,2],["κύριος",707996,4],["καὶ",707031,7],["μὴ",708851,28],["ἀποστήτω",702214,45],["σου",711945,133],["καὶ",707031,28],["γὰρ",702963,11],["αὐτοῦ",702165,102],["χρεία",713938,12]],"Then give place to the physician, for the Lord hath created him: let him not go from thee, for thou hast need of him."],["13",[["ἔστιν",704093,91],["καιρὸς",707047,4],["ὅτε",709802,28],["καὶ",707031,7],["ἐν",704639,0],["χερσὶν",713787,76],["αὐτῶν",702165,40],["εὐοδία",705652,12]],"There is a time when in their hands there is good success."],["14",[["καὶ",707031,28],["γὰρ",702963,11],["αὐτοὶ",702165,201],["κυρίου",707996,18],["δεηθήσονται",703394,144],["ἵνα",706747,7],["εὐοδώσῃ",705654,172],["αὐτοῖς",702165,151],["ἀνάπαυσιν",701026,9],["καὶ",707031,7],["ἴασιν",706444,9],["χάριν",713735,9],["ἐμβιώσεως",704550,17]],"For they shall also pray unto the Lord, that he would prosper that which they give for ease and remedy to prolong life."],["15",[["ὁ",709436,3],["ἁμαρτάνων",700773,72],["ἔναντι",704653,0],["τοῦ",709436,35],["ποιήσαντος",710582,500],["αὐτὸν",702165,85],["ἐμπέσοι",704593,583],["εἰς",704105,0],["χεῖρας",713787,39],["ἰατροῦ",706459,18]],"He that sinneth before his Maker, let him fall into the hand of the physician."],["16",[["τέκνον",712761,297],["ἐπὶ",705080,0],["νεκρῷ",709247,114],["κατάγαγε",707232,176],["δάκρυα",703255,42],["καὶ",707031,7],["ὡς",714148,7],["δεινὰ",703328,68],["πάσχων",710183,72],["ἔναρξαι",704664,300],["θρήνου",706309,18],["κατὰ",707200,0],["δὲ",703303,11],["τὴν",709436,8],["κρίσιν",707908,9],["αὐτοῦ",702165,102],["περίστειλον",710390,176],["τὸ",709436,24],["σῶμα",712635,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["μὴ",708851,28],["ὑπερίδῃς",713154,175],["τὴν",709436,8],["ταφὴν",712736,9],["αὐτοῦ",702165,102]],"My son, let tears fall down over the dead, and begin to lament, as if thou hadst suffered great harm thyself; and then cover his body according to the custom, and neglect not his burial."],["17",[["πίκρανον",710469,176],["κλαυθμὸν",707705,6],["καὶ",707031,7],["θέρμανον",706213,176],["κοπετὸν",707821,6],["καὶ",707031,7],["ποίησον",710582,176],["τὸ",709436,24],["πένθος",710253,25],["κατὰ",707200,0],["τὴν",709436,8],["ἀξίαν",701305,9],["αὐτοῦ",702165,102],["ἡμέραν",705984,9],["μίαν",704106,36],["καὶ",707031,7],["δύο",703849,59],["χάριν",713735,9],["διαβολῆς",703427,17],["καὶ",707031,7],["παρακλήθητι",710039,244],["λύπης",708273,17],["ἕνεκα",704709,0]],"Weep bitterly, and make great moan, and use lamentation, as he is worthy, and that a day or two, lest thou be evil spoken of: and then comfort thyself for thy heaviness;"],["18",[["ἀπὸ",701425,0],["λύπης",708273,17],["γὰρ",702963,11],["ἐκβαίνει",704144,91],["θάνατος",706096,4],["καὶ",707031,7],["λύπη",708273,12],["καρδίας",707141,17],["κάμψει",707118,127],["ἰσχύν",706858,9]],"for of heaviness cometh death, and the heaviness of the heart breaketh strength."],["19",[["ἐν",704639,0],["ἐπαγωγῇ",704995,1],["παραμένει",710071,91],["καὶ",707031,7],["λύπη",708273,12],["καὶ",707031,7],["βίος",702724,4],["πτωχοῦ",711076,18],["κατὰ",707200,0],["καρδίας",707141,17]],"In affliction also sorrow remaineth: and the life of the poor is the curse of the heart."],["20",[["μὴ",708851,28],["δῷς",703654,175],["εἰς",704105,0],["λύπην",708273,9],["τὴν",709436,8],["καρδίαν",707141,9],["σου",711945,133],["ἀπόστησον",702214,176],["αὐτὴν",702165,104],["μνησθεὶς",708923,217],["τὰ",709436,41],["ἔσχατα",705519,68]],"Take no heaviness to heart: drive it away, and remember the last end."],["21",[["μὴ",708851,28],["ἐπιλάθῃ",705187,420],["οὐ",709805,28],["γάρ",702963,11],["ἐστιν",704093,91],["ἐπάνοδος",705027,12],["καὶ",707031,7],["τοῦτον",709858,85],["οὐκ",709805,28],["ὠφελήσεις",714171,166],["καὶ",707031,7],["σεαυτὸν",711599,85],["κακώσεις",707073,166]],"Forget him not, for there is no turning again: thou shalt not do him good, but hurt thyself."],["22",[["μνήσθητι",708960,244],["τὸ",709436,24],["κρίμα",707903,25],["μου",709032,133],["ὅτι",709803,7],["οὕτως",709859,28],["καὶ",707031,28],["τὸ",709436,24],["σόν",711943,46],["ἐμοὶ",704577,159],["ἐχθὲς",713853,28],["καὶ",707031,7],["σοὶ",711925,159],["σήμερον",711751,28]],"Remember his judgment: for thine also shall be so; yesterday for me, and to day for thee."],["23",[["ἐν",704639,0],["ἀναπαύσει",701026,1],["νεκροῦ",709247,18],["κατάπαυσον",707365,176],["τὸ",709436,24],["μνημόσυνον",708966,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["παρακλήθητι",710039,244],["ἐν",704639,0],["αὐτῷ",702165,50],["ἐν",704639,0],["ἐξόδῳ",704948,1],["πνεύματος",710566,21],["αὐτοῦ",702165,102]],"When the dead is at rest, let his remembrance rest; and be comforted for him when his spirit is departed from him."],["24",[["σοφία",711981,12],["γραμματέως",703185,18],["ἐν",704639,0],["εὐκαιρίᾳ",705611,1],["σχολῆς",712616,17],["καὶ",707031,7],["ὁ",709436,3],["ἐλασσούμενος",704394,122],["πράξει",710714,1],["αὐτοῦ",702165,102],["σοφισθήσεται",711982,134]],"The wisdom of a learned man cometh by opportunity of leisure: and he that hath little business shall become wise."],["25",[["τί",712867,126],["σοφισθήσεται",711982,134],["ὁ",709436,3],["κρατῶν",707879,72],["ἀρότρου",701792,21],["καὶ",707031,7],["καυχώμενος",707569,122],["ἐν",704639,0],["δόρατι",703804,54],["κέντρου",707616,21],["βόας",702798,57],["ἐλαύνων",704397,72],["καὶ",707031,7],["ἀναστρεφόμενος",701060,122],["ἐν",704639,0],["ἔργοις",705396,96],["αὐτῶν",702165,40],["καὶ",707031,7],["ἡ",709436,10],["διήγησις",703681,12],["αὐτοῦ",702165,102],["ἐν",704639,0],["υἱοῖς",713075,148],["ταύρων",712734,81]],"How can he get wisdom that holdeth the plough, and that glorieth in the goad, that driveth oxen, and is occupied in their labours, and whose talk is of bullocks?"],["26",[["καρδίαν",707141,9],["αὐτοῦ",702165,102],["δώσει",703654,127],["ἐκδοῦναι",704171,106],["αὔλακας",702134,57],["καὶ",707031,7],["ἡ",709436,10],["ἀγρυπνία",700198,12],["αὐτοῦ",702165,102],["εἰς",704105,0],["χορτάσματα",713921,42],["δαμάλεων",703271,65]],"He giveth his mind to make furrows; and is diligent to give the kine fodder."],["27",[["οὕτως",709859,28],["πᾶς",710177,14],["τέκτων",712766,4],["καὶ",707031,7],["ἀρχιτέκτων",701857,4],["ὅστις",709793,425],["νύκτωρ",709378,28],["ὡς",714148,7],["ἡμέρας",705984,17],["διάγει",703442,91],["οἱ",709436,136],["γλύφοντες",703119,146],["γλύμματα",703116,42],["σφραγίδων",712591,65],["καὶ",707031,7],["ἡ",709436,10],["ἐπιμονὴ",705207,12],["αὐτοῦ",702165,102],["ἀλλοιῶσαι",700694,106],["ποικιλίαν",710586,9],["καρδίαν",707141,9],["αὐτοῦ",702165,102],["δώσει",703654,127],["εἰς",704105,0],["ὁμοιῶσαι",709628,106],["ζωγραφίαν",705904,9],["καὶ",707031,7],["ἡ",709436,10],["ἀγρυπνία",700198,12],["αὐτοῦ",702165,102],["τελέσαι",712783,106],["ἔργον",705396,25]],"So every carpenter and workmaster, that laboureth night and day: and they that cut and grave seals, and are diligent to make great variety, and give themselves to counterfeit imagery, and watch to finish a work:"],["28",[["οὕτως",709859,28],["χαλκεὺς",713691,4],["καθήμενος",707000,122],["ἐγγὺς",703948,28],["ἄκμονος",700560,18],["καὶ",707031,7],["καταμανθάνων",707324,72],["ἔργα",705396,42],["σιδήρου",711774,18],["ἀτμὶς",702100,12],["πυρὸς",711088,21],["τήξει",712839,127],["σάρκας",711537,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["θέρμῃ",706217,101],["καμίνου",707113,18],["διαμαχήσεται",703515,134],["φωνῇ",713640,1],["σφύρης",712592,17],["κλινεῖ",707738,127],["τὸ",709436,24],["οὖς",709852,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["κατέναντι",707507,28],["ὁμοιώματος",709629,21],["σκεύους",711844,21],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["αὐτοῦ",702165,102],["καρδίαν",707141,9],["αὐτοῦ",702165,102],["δώσει",703654,127],["εἰς",704105,0],["συντέλειαν",712509,9],["ἔργων",705396,44],["καὶ",707031,7],["ἡ",709436,10],["ἀγρυπνία",700198,12],["αὐτοῦ",702165,102],["κοσμῆσαι",707847,106],["ἐπὶ",705080,0],["συντελείας",712509,17]],"The smith also sitting by the anvil, and considering the iron work, the vapour of the fire wasteth his flesh, and he fighteth with the heat of the furnace: the noise of the hammer and the anvil is ever in his ears, and his eyes look still upon the pattern of the thing that he maketh; he setteth his mind to finish his work, and watcheth to polish it perfectly:"],["29",[["οὕτως",709859,28],["κεραμεὺς",707619,4],["καθήμενος",707000,122],["ἐν",704639,0],["ἔργῳ",705396,54],["αὐτοῦ",702165,102],["καὶ",707031,7],["συστρέφων",712517,72],["ἐν",704639,0],["ποσὶν",710707,148],["αὐτοῦ",702165,102],["τροχόν",712994,6],["ὃς",709781,213],["ἐν",704639,0],["μερίμνῃ",708745,1],["κεῖται",707595,117],["διὰ",703417,0],["παντὸς",710177,92],["ἐπὶ",705080,0],["τὸ",709436,24],["ἔργον",705396,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐναρίθμιος",704662,29],["πᾶσα",710177,29],["ἡ",709436,10],["ἐργασία",705385,12],["αὐτοῦ",702165,102]],"So doth the potter sitting at his work, and turning the wheel about with his feet, who is alway carefully set at his work, and maketh all his work by number;"],["30",[["ἐν",704639,0],["βραχίονι",702808,114],["αὐτοῦ",702165,102],["τυπώσει",713021,127],["πηλὸν",710457,6],["καὶ",707031,7],["πρὸ",710747,0],["ποδῶν",710707,81],["κάμψει",707118,127],["ἰσχὺν",706858,9],["αὐτοῦ",702165,102],["καρδίαν",707141,9],["ἐπιδώσει",705121,127],["συντελέσαι",712510,106],["τὸ",709436,24],["χρῖσμα",713963,25],["καὶ",707031,7],["ἡ",709436,10],["ἀγρυπνία",700198,12],["αὐτοῦ",702165,102],["καθαρίσαι",706985,106],["κάμινον",707113,9]],"he fashioneth the clay with his arm, and boweth down his strength before his feet; he applieth himself to lead it over; and he is diligent to make clean the furnace:"],["31",[["πάντες",710177,138],["οὗτοι",709858,201],["εἰς",704105,0],["χεῖρας",713787,39],["αὐτῶν",702165,40],["ἐνεπίστευσαν",704594,150],["καὶ",707031,7],["ἕκαστος",704133,14],["ἐν",704639,0],["τῷ",709436,53],["ἔργῳ",705396,54],["αὐτοῦ",702165,102],["σοφίζεται",711982,117]],"all these trust to their hands; and every one is wise in his work."],["32",[["ἄνευ",701137,0],["αὐτῶν",702165,40],["οὐκ",709805,28],["οἰκισθήσεται",709507,134],["πόλις",710612,12],["καὶ",707031,7],["οὐ",709805,28],["παροικήσουσιν",710156,218],["οὐδὲ",709816,7],["περιπατήσουσιν",710362,218]],"Without these cannot a city be inhabited: and they shall not dwell where they will, nor go up and down:"],["33",[["ἀλλ᾿",700680,7],["εἰς",704105,0],["βουλὴν",702792,9],["λαοῦ",708094,18],["οὐ",709805,28],["ζητηθήσονται",705879,144],["καὶ",707031,7],["ἐν",704639,0],["ἐκκλησίᾳ",704216,1],["οὐχ",709805,28],["ὑπεραλοῦνται",713117,135],["ἐπὶ",705080,0],["δίφρον",703755,6],["δικαστοῦ",703701,18],["οὐ",709805,28],["καθιοῦνται",707006,135],["καὶ",707031,7],["διαθήκην",703456,9],["κρίματος",707903,21],["οὐ",709805,28],["διανοηθήσονται",703528,144]],"they shall not be sought for in public counsel, nor sit high in the congregation: they shall not sit on the judges' seat, nor understand the sentence of judgment: they cannot declare justice and judgment; and they shall not be found where parables are spoken."],["34",[["οὐδὲ",709816,7],["μὴ",708851,28],["ἐκφάνωσιν",704354,272],["παιδείαν",709924,9],["καὶ",707031,7],["κρίμα",707903,25],["καὶ",707031,7],["ἐν",704639,0],["παραβολαῖς",710003,76],["οὐχ",709805,28],["εὑρεθήσονται",705676,144],["ἀλλὰ",700680,7],["κτίσμα",707940,25],["αἰῶνος",700504,18],["στηρίσουσιν",712098,218],["καὶ",707031,7],["ἡ",709436,10],["δέησις",703311,12],["αὐτῶν",702165,40],["ἐν",704639,0],["ἐργασίᾳ",705385,1],["τέχνης",712831,17]],"But they will maintain the state of the world, and [all] their desire is in the work of their craft. But he that giveth his mind to the law of the most High, and is occupied in the meditation thereof,"]]