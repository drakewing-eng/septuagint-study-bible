[["1",[["λίθῳ",708196,114],["ἠρδαλωμένῳ",701715,241],["συνεβλήθη",712278,37],["ὀκνηρός",709550,14],["καὶ",707031,7],["πᾶς",710177,14],["ἐκσυριεῖ",704317,127],["ἐπὶ",705080,0],["τῇ",709436,100],["ἀτιμίᾳ",702094,1],["αὐτοῦ",702165,102]],"A slothful man is compared to a filthy stone, and every one will hiss him out to his disgrace."],["2",[["βολβίτῳ",702754,54],["κοπρίων",707827,44],["συνεβλήθη",712278,37],["ὀκνηρός",709550,14],["πᾶς",710177,14],["ὁ",709436,3],["ἀναιρούμενος",700962,122],["αὐτὸν",702165,85],["ἐκτινάξει",704334,127],["χεῖρα",713787,9]],"A slothful man is compared to the filth of a dunghill: every man that takes it up will shake his hand."],["3",[["αἰσχύνη",700483,12],["πατρὸς",710189,18],["ἐν",704639,0],["γεννήσει",703054,1],["ἀπαιδεύτου",701328,116],["θυγάτηρ",706320,12],["δὲ",703303,11],["ἐπ᾿",705080,0],["ἐλαττώσει",704394,127],["γίνεται",703104,117]],"An evil-nurtured son is the dishonour of his father that begat him: and a [foolish] daughter is born to his loss."],["4",[["θυγάτηρ",706320,12],["φρονίμη",713589,29],["κληρονομήσει",707724,127],["ἄνδρα",701150,6],["αὐτῆς",702165,86],["καὶ",707031,7],["ἡ",709436,10],["καταισχύνουσα",707257,188],["εἰς",704105,0],["λύπην",708273,9],["γεννήσαντος",703051,500]],"A wise daughter shall bring an inheritance to her husband: but she that liveth dishonestly is her father's heaviness."],["5",[["πατέρα",710189,6],["καὶ",707031,7],["ἄνδρα",701150,6],["καταισχύνει",707257,91],["ἡ",709436,10],["θρασεῖα",706300,29],["καὶ",707031,7],["ὑπὸ",713184,0],["ἀμφοτέρων",700892,169],["ἀτιμασθήσεται",702092,134]],"She that is bold dishonoureth both her father and her husband, and they both shall despise her."],["6",[["μουσικὰ",709034,195],["ἐν",704639,0],["πένθει",710253,54],["ἄκαιρος",700509,29],["διήγησις",703681,12],["μάστιγες",708568,191],["δὲ",703303,11],["καὶ",707031,7],["παιδεία",709924,12],["ἐν",704639,0],["παντὶ",710177,30],["καιρῷ",707047,114],["σοφίας",711981,17]],"A tale out of season [is as] music in mourning: but stripes and correction of wisdom are never out of time."],["9",[["συγκολλῶν",712228,72],["ὄστρακον",709796,25],["ὁ",709436,3],["διδάσκων",703649,72],["μωρόν",709110,27],["ἐξεγείρων",704889,72],["καθεύδοντα",706996,183],["ἐκ",704132,0],["βαθέος",702381,116],["ὕπνου",713181,18]],"Whoso teacheth a fool is as one that glueth a potsherd together, and as he that waketh one from a sound sleep."],["10",[["διηγούμενος",703679,122],["νυστάζοντι",709390,379],["ὁ",709436,3],["διηγούμενος",703679,122],["μωρῷ",709110,30],["καὶ",707031,7],["ἐπὶ",705080,0],["συντελείᾳ",712509,1],["ἐρεῖ",705415,127],["τί",712867,273],["ἐστιν",704093,91]],"He that telleth a tale to a fool speaketh to one in a slumber: when he hath told his tale, he will say, What is the matter?"],["11",[["ἐπὶ",705080,0],["νεκρῷ",709247,114],["κλαῦσον",707703,176],["ἐξέλιπεν",704237,2],["γὰρ",702963,11],["φῶς",713642,25],["καὶ",707031,7],["ἐπὶ",705080,0],["μωρῷ",709110,30],["κλαῦσον",707703,176],["ἐξέλιπεν",704237,2],["γὰρ",702963,11],["σύνεσιν",712460,9],["ἥδιον",705938,28],["κλαῦσον",707703,176],["ἐπὶ",705080,0],["νεκρῷ",709247,114],["ὅτι",709803,7],["ἀνεπαύσατο",701027,23],["τοῦ",709436,35],["δὲ",703303,11],["μωροῦ",709110,116],["ὑπὲρ",713111,0],["θάνατον",706096,6],["ἡ",709436,10],["ζωὴ",705910,12],["πονηρά",710660,29]],"Weep for the dead, for he hath lost the light: and weep for the fool, for he wanteth understanding: make little weeping for the dead, for he is at rest: but the life of the fool is worse than death."],["12",[["πένθος",710253,15],["νεκροῦ",709247,18],["ἑπτὰ",705357,59],["ἡμέραι",705984,191],["μωροῦ",709110,116],["δὲ",703303,11],["καὶ",707031,7],["ἀσεβοῦς",701909,116],["πᾶσαι",710177,192],["αἱ",709436,190],["ἡμέραι",705984,191],["τῆς",709436,16],["ζωῆς",705910,17],["αὐτοῦ",702165,102]],"Seven days do men mourn for him that is dead; but for a fool and an ungodly man all the days of his life."],["13",[["μετὰ",708780,0],["ἄφρονος",702236,116],["μὴ",708851,28],["πληθύνῃς",710530,205],["λόγον",708236,6],["καὶ",707031,7],["πρὸς",710844,0],["ἀσύνετον",702034,27],["μὴ",708851,28],["πορεύου",710667,253],["φύλαξαι",713619,300],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["ἵνα",706747,7],["μὴ",708851,28],["κόπον",707825,6],["ἔχῃς",705785,205],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["μολυνθῇς",708987,279],["ἐν",704639,0],["τῷ",709436,113],["ἐντιναγμῷ",704800,114],["αὐτοῦ",702165,102],["ἔκκλινον",704220,176],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["εὑρήσεις",705676,166],["ἀνάπαυσιν",701026,9],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἀκηδιάσῃς",700539,175],["ἐν",704639,0],["τῇ",709436,100],["ἀπονοίᾳ",701535,1],["αὐτοῦ",702165,102]],"Talk not much with a fool, and go not to him that hath no understanding: beware of him, lest thou have trouble, and thou shalt never be defiled with his fooleries: depart from him, and thou shalt find rest, and never be disquieted with madness."],["14",[["ὑπὲρ",713111,0],["μόλιβον",708981,6],["τί",712867,273],["βαρυνθήσεται",702553,134],["καὶ",707031,7],["τί",712867,273],["αὐτῷ",702165,280],["ὄνομα",709666,15],["ἀλλ᾿",700680,7],["ἢ",705924,7],["μωρός",709110,14]],"What is heavier than lead? and what is the name thereof, but a fool?"],["15",[["ἄμμον",700845,9],["καὶ",707031,7],["ἅλα",700634,6],["καὶ",707031,7],["βῶλον",702839,9],["σιδήρου",711774,18],["εὔκοπον",705622,27],["ὑπενεγκεῖν",713256,106],["ἢ",705924,7],["ἄνθρωπον",701163,6],["ἀσύνετον",702034,27]],"Sand, and salt, and a mass of iron, are easier to bear, than a man without understanding."],["16",[["ἱμάντωσις",706739,12],["ξυλίνη",709425,29],["ἐνδεδεμένη",704685,203],["εἰς",704105,0],["οἰκοδομὴν",709510,9],["ἐν",704639,0],["συσσεισμῷ",712553,114],["οὐ",709805,28],["διαλυθήσεται",703509,134],["οὕτως",709859,28],["καρδία",707141,12],["ἐστηριγμένη",712098,203],["ἐπὶ",705080,0],["διανοήματος",703529,21],["βουλῆς",702792,17],["ἐν",704639,0],["καιρῷ",707047,114],["οὐ",709805,28],["δειλιάσει",703321,127]],"As timber girt and bound together in a building cannot be loosed with shaking: so the heart that is stablished by advised counsel shall fear at no time."],["17",[["καρδία",707141,12],["ἡδρασμένη",704037,203],["ἐπὶ",705080,0],["διανοίας",703531,17],["συνέσεως",712460,17],["ὡς",714148,7],["κόσμος",707851,4],["ψαμμωτὸς",714030,14],["τοίχου",712879,18],["ξυστοῦ",709434,18]],"A heart settled upon a thought of understanding is as a fair plaistering on the wall of a gallery."],["18",[["χάρακες",713729,52],["ἐπὶ",705080,0],["μετεώρου",708831,92],["κείμενοι",707595,348],["κατέναντι",707507,28],["ἀνέμου",701123,18],["οὐ",709805,28],["μὴ",708851,28],["ὑπομείνωσιν",713219,234],["οὕτως",709859,28],["καρδία",707141,12],["δειλὴ",703324,29],["ἐπὶ",705080,0],["διανοήματος",703529,21],["μωροῦ",709110,116],["κατέναντι",707507,28],["παντὸς",710177,116],["φόβου",713534,18],["οὐ",709805,28],["μὴ",708851,28],["ὑπομείνῃ",713219,172]],"Pales set on an high place will never stand against the wind: so a fearful heart in the imagination of a fool cannot stand against any fear."],["19",[["ὁ",709436,3],["νύσσων",709387,72],["ὀφθαλμὸν",709870,6],["κατάξει",707232,127],["δάκρυα",703255,42],["καὶ",707031,7],["νύσσων",709387,72],["καρδίαν",707141,9],["ἐκφαίνει",704354,91],["αἴσθησιν",700477,9]],"He that pricketh the eye will make tears to fall: and he that pricketh the heart maketh it to shew her knowledge."],["20",[["βάλλων",702487,72],["λίθον",708196,6],["ἐπὶ",705080,0],["πετεινὰ",710439,68],["ἀποσοβεῖ",701581,91],["αὐτά",702165,71],["καὶ",707031,7],["ὁ",709436,3],["ὀνειδίζων",709655,72],["φίλον",713492,27],["διαλύσει",703509,127],["φιλίαν",713474,9]],"Whoso casteth a stone at the birds frayeth them away: and he that upbraideth his friend breaketh friendship."],["21",[["ἐπὶ",705080,0],["φίλον",713492,27],["ἐὰν",703912,7],["σπάσῃς",712003,175],["ῥομφαίαν",711291,9],["μὴ",708851,28],["ἀφελπίσῃς",701388,172],["ἔστιν",704093,91],["γὰρ",702963,11],["ἐπάνοδος",705027,12]],"Though thou drewest a sword at thy friend, yet despair not: for there may be a returning [to favour]."],["22",[["ἐπὶ",705080,0],["φίλον",713492,27],["ἐὰν",703912,7],["ἀνοίξῃς",701186,175],["στόμα",712125,25],["μὴ",708851,28],["εὐλαβηθῇς",705627,279],["ἔστιν",704093,91],["γὰρ",702963,11],["διαλλαγή",703501,12],["πλὴν",710540,28],["ὀνειδισμοῦ",709657,18],["καὶ",707031,7],["ὑπερηφανίας",713138,17],["καὶ",707031,7],["μυστηρίου",709080,21],["ἀποκαλύψεως",701475,17],["καὶ",707031,7],["πληγῆς",710527,17],["δολίας",703783,82],["ἐν",704639,0],["τούτοις",709858,206],["ἀποφεύξεται",701633,93],["πᾶς",710177,14],["φίλος",713492,14]],"If thou hast opened thy mouth against thy friend, fear not; for there may be a reconciliation: except for upbraiding, or pride, or disclosing of secrets, or a treacherous wound: for for these things every friend will depart."],["23",[["πίστιν",710484,9],["κτῆσαι",707932,300],["ἐν",704639,0],["πτωχείᾳ",711073,1],["μετὰ",708780,0],["τοῦ",709436,35],["πλησίον",710547,28],["ἵνα",706747,7],["ἐν",704639,0],["τοῖς",709436,95],["ἀγαθοῖς",700106,94],["αὐτοῦ",702165,102],["ὁμοῦ",709644,28],["πλησθῇς",710532,279],["ἐν",704639,0],["καιρῷ",707047,114],["θλίψεως",706276,17],["διάμενε",703517,240],["αὐτῷ",702165,50],["ἵνα",706747,7],["ἐν",704639,0],["τῇ",709436,100],["κληρονομίᾳ",707725,1],["αὐτοῦ",702165,102],["συγκληρονομήσῃς",712224,175]],"Be faithful to thy neighbour in his poverty, that thou mayest rejoice in his prosperity: abide steadfast unto him in the time of his trouble, that thou mayest be heir with him in his heritage."],["24",[["πρὸ",710747,0],["πυρὸς",711088,21],["ἀτμὶς",702100,12],["καμίνου",707113,18],["καὶ",707031,7],["καπνός",707132,4],["οὕτως",709859,28],["πρὸ",710747,0],["αἱμάτων",700442,44],["λοιδορίαι",708242,191]],"As the vapour and smoke of a furnace goeth before the fire; so reviling before blood."],["25",[["φίλον",713492,27],["σκεπάσαι",711832,106],["οὐκ",709805,28],["αἰσχυνθήσομαι",700485,180],["καὶ",707031,7],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["οὐ",709805,28],["μὴ",708851,28],["κρυβῶ",707923,321]],"I will not be ashamed to defend a friend; neither will I hide myself from him;"],["26",[["καὶ",707031,7],["εἰ",704071,7],["κακά",707066,195],["μοι",708974,159],["συμβήσεται",712277,93],["δι᾿",703417,0],["αὐτόν",702165,85],["πᾶς",710177,14],["ὁ",709436,3],["ἀκούων",700587,72],["φυλάξεται",713619,93],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102]],"and if any evil happen unto me by him, every one that heareth it will beware of him."],["27",[["τίς",712867,158],["δώσει",703654,127],["ἐπὶ",705080,0],["στόμα",712125,25],["μου",709032,133],["φυλακὴν",713613,9],["καὶ",707031,7],["ἐπὶ",705080,0],["τῶν",709436,43],["χειλέων",713781,44],["μου",709032,133],["σφραγῖδα",712591,9],["πανοῦργον",709972,36],["ἵνα",706747,7],["μὴ",708851,28],["πέσω",710481,207],["ἀπ᾿",701425,0],["αὐτῆς",702165,86],["καὶ",707031,7],["ἡ",709436,10],["γλῶσσά",703120,12],["μου",709032,133],["ἀπολέσῃ",701513,123],["με",708618,163]],"Who shall set a watch before my mouth, and a seal of wisdom upon my lips, that I fall not suddenly by them, and that my tongue destroy me not?"]]