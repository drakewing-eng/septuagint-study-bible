[["1",[["μὴ",708851,28],["διαμάχου",703515,253],["μετὰ",708780,0],["ἀνθρώπου",701163,18],["δυνάστου",703844,18],["μήποτε",708882,28],["ἐμπέσῃς",704593,175],["εἰς",704105,0],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτοῦ",702165,102]],"Strive not with a mighty man, lest thou fall into his hands."],["2",[["μὴ",708851,28],["ἔριζε",705423,240],["μετὰ",708780,0],["ἀνθρώπου",701163,18],["πλουσίου",710560,116],["μήποτε",708882,28],["ἀντιστήσῃ",701154,172],["σου",711945,133],["τὴν",709436,8],["ὁλκήν",709583,9],["πολλοὺς",710646,60],["γὰρ",702963,11],["ἀπώλεσεν",701513,2],["τὸ",709436,34],["χρυσίον",713972,15],["καὶ",707031,7],["καρδίας",707141,39],["βασιλέων",702580,81],["ἐξέκλινεν",704220,2]],"Be not at variance with a rich man, lest he overweigh thee: for gold hath destroyed many, and perverted the hearts of kings."],["3",[["μὴ",708851,28],["διαμάχου",703515,253],["μετὰ",708780,0],["ἀνθρώπου",701163,18],["γλωσσώδους",703125,116],["καὶ",707031,7],["μὴ",708851,28],["ἐπιστοιβάσῃς",705271,175],["ἐπὶ",705080,0],["τὸ",709436,24],["πῦρ",711088,25],["αὐτοῦ",702165,102],["ξύλα",709427,42]],"Strive not with a man that is full of tongue, and heap not wood upon his fire."],["4",[["μὴ",708851,28],["πρόσπαιζε",710949,240],["ἀπαιδεύτῳ",701328,30],["ἵνα",706747,7],["μὴ",708851,28],["ἀτιμάζωνται",702092,380],["οἱ",709436,136],["πρόγονοί",710777,52],["σου",711945,133]],"Jest not with a rude man, lest thy ancestors be disgraced."],["5",[["μὴ",708851,28],["ὀνείδιζε",709655,240],["ἄνθρωπον",701163,6],["ἀποστρέφοντα",701598,183],["ἀπὸ",701425,0],["ἁμαρτίας",700775,17],["μνήσθητι",708960,244],["ὅτι",709803,7],["πάντες",710177,138],["ἐσμὲν",704093,243],["ἐν",704639,0],["ἐπιτίμοις",705309,94]],"Reproach not a man that turneth from sin, but remember that we are all worthy of punishment."],["6",[["μὴ",708851,28],["ἀτιμάσῃς",702092,175],["ἄνθρωπον",701163,6],["ἐν",704639,0],["γήρᾳ",703089,54],["αὐτοῦ",702165,102],["καὶ",707031,7],["γὰρ",702963,11],["ἐξ",704132,0],["ἡμῶν",705999,145],["γηράσκουσιν",703090,197]],"Dishonour not a man in his old age: for even some of us wax old."],["7",[["μὴ",708851,28],["ἐπίχαιρε",705330,240],["ἐπὶ",705080,0],["νεκρῷ",709247,114],["μνήσθητι",708960,244],["ὅτι",709803,7],["πάντες",710177,138],["τελευτῶμεν",712781,243]],"Rejoice not over thy greatest enemy being dead, but remember that we die all."],["8",[["μὴ",708851,28],["παρίδῃς",710125,175],["διήγημα",703680,25],["σοφῶν",711985,169],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["παροιμίαις",710160,76],["αὐτῶν",702165,40],["ἀναστρέφου",701060,253],["ὅτι",709803,7],["παρ᾿",709995,0],["αὐτῶν",702165,284],["μαθήσῃ",708480,123],["παιδείαν",709924,9],["καὶ",707031,7],["λειτουργῆσαι",708132,106],["μεγιστᾶσιν",708657,148]],"Despise not the discourse of the wise, but acquaint thyself with their proverbs: for of them thou shalt learn instruction, and how to serve great men with ease."],["9",[["μὴ",708851,28],["ἀστόχει",702019,240],["διηγήματος",703680,21],["γερόντων",703065,81],["καὶ",707031,7],["γὰρ",702963,11],["αὐτοὶ",702165,201],["ἔμαθον",708480,150],["παρὰ",709995,0],["τῶν",709436,80],["πατέρων",710189,81],["αὐτῶν",702165,40],["ὅτι",709803,7],["παρ᾿",709995,0],["αὐτῶν",702165,40],["μαθήσῃ",708480,123],["σύνεσιν",712460,9],["καὶ",707031,7],["ἐν",704639,0],["καιρῷ",707047,114],["χρείας",713938,17],["δοῦναι",703654,106],["ἀπόκρισιν",701493,9]],"Miss not the discourse of the elders: for they also learned of their fathers, and of them thou shalt learn understanding, and to give answer as need requireth."],["10",[["μὴ",708851,28],["ἔκκαιε",704205,240],["ἄνθρακας",701160,57],["ἁμαρτωλοῦ",700776,116],["μὴ",708851,28],["ἐμπυρισθῇς",704622,279],["ἐν",704639,0],["πυρὶ",711088,54],["φλογὸς",713524,17],["αὐτοῦ",702165,102]],"Kindle not the coals of a sinner, lest thou be burnt with the flame of his fire."],["11",[["μὴ",708851,28],["ἐξαναστῇς",704865,175],["ἀπὸ",701425,0],["προσώπου",710986,21],["ὑβριστοῦ",713054,92],["ἵνα",706747,7],["μὴ",708851,28],["ἐγκαθίσῃ",703953,123],["ὡς",714148,7],["ἔνεδρον",704704,25],["τῷ",709436,53],["στόματί",712125,54],["σου",711945,133]],"Rise not up [in anger] at the presence of an injurious person, lest he lie in wait to entrap thee in thy words."],["12",[["μὴ",708851,28],["δανείσῃς",703277,175],["ἀνθρώπῳ",701163,114],["ἰσχυροτέρῳ",706855,302],["σου",711945,133],["καὶ",707031,7],["ἐὰν",703912,7],["δανείσῃς",703277,175],["ὡς",714148,7],["ἀπολωλεκὼς",701513,270],["γίνου",703104,253]],"Lend not unto him that is mightier than thyself; for if thou lendest him, count it but lost."],["13",[["μὴ",708851,28],["ἐγγυήσῃ",703944,175],["ὑπὲρ",713111,0],["δύναμίν",703839,9],["σου",711945,133],["καὶ",707031,7],["ἐὰν",703912,7],["ἐγγυήσῃ",703944,175],["ὡς",714148,7],["ἀποτείσων",701618,512],["φρόντιζε",713590,240]],"Be not surety above thy power: for if thou be surety, take care to pay it."],["14",[["μὴ",708851,28],["δικάζου",703691,253],["μετὰ",708780,0],["κριτοῦ",707910,18],["κατὰ",707200,0],["γὰρ",702963,11],["τὴν",709436,8],["δόξαν",703791,9],["αὐτοῦ",702165,102],["κρινοῦσιν",707905,218],["αὐτῷ",702165,50]],"Go not to law with a judge; for they will judge for him according to his honour."],["15",[["μετὰ",708780,0],["τολμηροῦ",712887,116],["μὴ",708851,28],["πορεύου",710667,253],["ἐν",704639,0],["ὁδῷ",709458,1],["ἵνα",706747,7],["μὴ",708851,28],["βαρύνηται",702553,428],["κατὰ",707200,0],["σοῦ",711945,133],["αὐτὸς",702165,121],["γὰρ",702963,11],["κατὰ",707200,0],["τὸ",709436,24],["θέλημα",706170,25],["αὐτοῦ",702165,102],["ποιήσει",710582,127],["καὶ",707031,7],["τῇ",709436,100],["ἀφροσύνῃ",702235,1],["αὐτοῦ",702165,102],["συναπολῇ",712402,123]],"Travel not by the way with a bold fellow, lest he become grievous unto thee: for he will do according to his own will, and thou shalt perish with him through his folly."],["16",[["μετὰ",708780,0],["θυμώδους",706336,116],["μὴ",708851,28],["ποιήσῃς",710582,175],["μάχην",708601,9],["καὶ",707031,7],["μὴ",708851,28],["διαπορεύου",703551,253],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["τὴν",709436,8],["ἔρημον",705420,9],["ὅτι",709803,7],["ὡς",714148,7],["οὐδὲν",709817,26],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["αὐτοῦ",702165,102],["αἷμα",700442,25],["καὶ",707031,7],["ὅπου",709710,11],["οὐκ",709805,28],["ἔστιν",704093,91],["βοήθεια",702745,12],["καταβαλεῖ",707203,127],["σε",711598,163]],"Strive not with an angry man, and go not with him into a solitary place: for blood is as nothing in his sight; and where there is no help, he will overthrow thee."],["17",[["μετὰ",708780,0],["μωροῦ",709110,116],["μὴ",708851,28],["συμβουλεύου",712292,253],["οὐ",709805,28],["γὰρ",702963,11],["δυνήσεται",703838,93],["λόγον",708236,6],["στέξαι",712059,106]],"Consult not with a fool; for he cannot keep counsel."],["18",[["ἐνώπιον",704823,0],["ἀλλοτρίου",700699,116],["μὴ",708851,28],["ποιήσῃς",710582,175],["κρυπτόν",707922,27],["οὐ",709805,28],["γὰρ",702963,11],["γινώσκεις",703105,154],["τί",712867,126],["τέξεται",712853,93]],"Do no secret thing before a stranger: for thou knowest not what he will bring forth."],["19",[["παντὶ",710177,30],["ἀνθρώπῳ",701163,114],["μὴ",708851,28],["ἔκφαινε",704354,240],["σὴν",711943,36],["καρδίαν",707141,9],["καὶ",707031,7],["μὴ",708851,28],["ἀναφερέτω",701083,31],["σοι",711925,159],["χάριν",713735,9]],"Open not thine heart to every man, lest he requite thee with a shrewd turn."]]