[["1",[["κύριος",707996,4],["ἔκτισεν",707938,2],["ἐκ",704132,0],["γῆς",703083,17],["ἄνθρωπον",701163,6],["καὶ",707031,7],["πάλιν",709942,28],["ἀπέστρεψεν",701598,2],["αὐτὸν",702165,85],["εἰς",704105,0],["αὐτήν",702165,104]],"The Lord created man of the earth, and turned him into it again."],["2",[["ἡμέρας",705984,39],["ἀριθμοῦ",701744,18],["καὶ",707031,7],["καιρὸν",707047,6],["ἔδωκεν",703654,2],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτοῖς",702165,151],["ἐξουσίαν",704974,9],["τῶν",709436,43],["ἐπ᾿",705080,0],["αὐτῆς",702165,86]],"He gave them few days, and a short time, and power also over the things therein."],["3",[["καθ᾿",707200,0],["ἑαυτὸν",703917,85],["ἐνέδυσεν",704701,2],["αὐτοὺς",702165,62],["ἰσχὺν",706858,9],["καὶ",707031,7],["κατ᾿",707200,0],["εἰκόνα",704089,9],["αὐτοῦ",702165,102],["ἐποίησεν",710582,2],["αὐτούς",702165,62]],"He endued them with strength by themselves, and made them according to his image,"],["4",[["ἔθηκεν",712849,2],["τὸν",709436,5],["φόβον",713534,6],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["πάσης",710177,82],["σαρκὸς",711537,17],["καὶ",707031,7],["κατακυριεύειν",707297,55],["θηρίων",706252,44],["καὶ",707031,7],["πετεινῶν",710439,44]],"and put the fear of man upon all flesh, and gave him dominion over beasts and fowls."],["6",[["διαβούλιον",703431,25],["καὶ",707031,7],["γλῶσσαν",703120,9],["καὶ",707031,7],["ὀφθαλμούς",709870,57],["ὦτα",709852,25],["καὶ",707031,7],["καρδίαν",707141,9],["ἔδωκεν",703654,2],["διανοεῖσθαι",703528,110],["αὐτοῖς",702165,151]],"Counsel, and a tongue, and eyes, ears, and a heart, gave he them to understand."],["7",[["ἐπιστήμην",705267,9],["συνέσεως",712460,17],["ἐνέπλησεν",704592,2],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἀγαθὰ",700106,68],["καὶ",707031,7],["κακὰ",707066,68],["ὑπέδειξεν",713192,2],["αὐτοῖς",702165,151]],"Withal he filled them with the knowledge of understanding, and shewed them good and evil."],["8",[["ἔθηκεν",712849,2],["τὸν",709436,5],["ὀφθαλμὸν",709870,6],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τὰς",709436,38],["καρδίας",707141,39],["αὐτῶν",702165,40],["δεῖξαι",703314,106],["αὐτοῖς",702165,151],["τὸ",709436,24],["μεγαλεῖον",708625,27],["τῶν",709436,43],["ἔργων",705396,44],["αὐτοῦ",702165,102]],"He set his eye upon their hearts, that he might shew them the greatness of his works;"],["10",[["καὶ",707031,7],["ὄνομα",709666,25],["ἁγιασμοῦ",700155,18],["αἰνέσουσιν",700459,218],["ἵνα",706747,7],["διηγῶνται",703679,380],["τὰ",709436,41],["μεγαλεῖα",708625,68],["τῶν",709436,80],["ἔργων",705396,44],["αὐτοῦ",702165,102]],"and they shall praise his holy name, that they may search out his marvellous works."],["11",[["προσέθηκεν",710965,2],["αὐτοῖς",702165,151],["ἐπιστήμην",705267,9],["καὶ",707031,7],["νόμον",709349,6],["ζωῆς",705910,17],["ἐκληροδότησεν",707723,2],["αὐτοῖς",702165,151]],"Beside this he gave them knowledge, and the law of life for an heritage."],["12",[["διαθήκην",703456,9],["αἰῶνος",700504,18],["ἔστησεν",706846,2],["μετ᾿",708780,0],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,41],["κρίματα",707903,42],["αὐτοῦ",702165,102],["ὑπέδειξεν",713192,2],["αὐτοῖς",702165,151]],"He made an everlasting covenant with them, and shewed them his judgments."],["13",[["μεγαλεῖον",708625,46],["δόξης",703791,17],["εἶδον",709725,150],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["αὐτῶν",702165,40],["καὶ",707031,7],["δόξαν",703791,9],["φωνῆς",713640,17],["αὐτοῦ",702165,102],["ἤκουσεν",700587,2],["τὸ",709436,34],["οὖς",709852,15],["αὐτῶν",702165,40]],"Their eyes saw the majesty of his glory, and their ears heard his glorious voice."],["14",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["προσέχετε",710895,335],["ἀπὸ",701425,0],["παντὸς",710177,92],["ἀδίκου",700272,92],["καὶ",707031,7],["ἐνετείλατο",704791,23],["αὐτοῖς",702165,151],["ἑκάστῳ",704133,30],["περὶ",710285,0],["τοῦ",709436,35],["πλησίον",710547,28]],"And he said unto them, Beware of all unrighteousness; and he gave every man commandment concerning his neighbour."],["15",[["αἱ",709436,190],["ὁδοὶ",709458,191],["αὐτῶν",702165,40],["ἐναντίον",704654,0],["αὐτοῦ",702165,102],["διὰ",703417,0],["παντός",710177,92],["οὐ",709805,28],["κρυβήσονται",707923,144],["ἀπὸ",701425,0],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["αὐτοῦ",702165,102]],"Their ways are ever before him, and shall not be hid from his eyes."],["17",[["ἑκάστῳ",704133,97],["ἔθνει",704068,54],["κατέστησεν",707011,2],["ἡγούμενον",705931,212],["καὶ",707031,7],["μερὶς",708748,12],["κυρίου",707996,18],["Ισραηλ",706839,120],["ἐστίν",704093,91]],"For in the division of the nations of the whole earth he set a ruler over every people; but Israel is the Lord's portion:"],["19",[["ἅπαντα",701362,195],["τὰ",709436,63],["ἔργα",705396,64],["αὐτῶν",702165,40],["ὡς",714148,7],["ὁ",709436,3],["ἥλιος",705974,4],["ἐναντίον",704654,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["αὐτοῦ",702165,102],["ἐνδελεχεῖς",704678,138],["ἐπὶ",705080,0],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτῶν",702165,40]],"Therefore all their works are as the sun before him, and his eyes are continually upon their ways."],["20",[["οὐκ",709805,28],["ἐκρύβησαν",707923,99],["αἱ",709436,190],["ἀδικίαι",700271,191],["αὐτῶν",702165,40],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["πᾶσαι",710177,192],["αἱ",709436,190],["ἁμαρτίαι",700775,191],["αὐτῶν",702165,40],["ἔναντι",704653,0],["κυρίου",707996,18]],"None of their unrighteous deeds are hid from him, but all their sins are before the Lord."],["22",[["ἐλεημοσύνη",704421,12],["ἀνδρὸς",701150,18],["ὡς",714148,7],["σφραγὶς",712591,12],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["χάριν",713735,9],["ἀνθρώπου",701163,18],["ὡς",714148,7],["κόρην",707836,9],["συντηρήσει",712512,127]],"The alms of a man is as a signet with him, and he will keep the good deeds of man as the apple of the eye, and give repentance to his sons and daughters."],["23",[["μετὰ",708780,0],["ταῦτα",709858,71],["ἐξαναστήσεται",704865,93],["καὶ",707031,7],["ἀνταποδώσει",701215,127],["αὐτοῖς",702165,151],["καὶ",707031,7],["τὸ",709436,24],["ἀνταπόδομα",701216,25],["αὐτῶν",702165,40],["εἰς",704105,0],["κεφαλὴν",707639,9],["αὐτῶν",702165,40],["ἀποδώσει",701449,127]],"Afterwards he will rise up and reward them, and render their recompence upon their heads."],["24",[["πλὴν",710540,28],["μετανοοῦσιν",708809,197],["ἔδωκεν",703654,2],["ἐπάνοδον",705027,9],["καὶ",707031,7],["παρεκάλεσεν",710039,2],["ἐκλείποντας",704237,235],["ὑπομονήν",713226,9]],"But unto them that repent, he granted them return, and comforted those that failed in patience."],["25",[["ἐπίστρεφε",705278,240],["ἐπὶ",705080,0],["κύριον",707996,6],["καὶ",707031,7],["ἀπόλειπε",701508,240],["ἁμαρτίας",700775,39],["δεήθητι",703394,244],["κατὰ",707200,0],["πρόσωπον",710986,25],["καὶ",707031,7],["σμίκρυνον",708917,176],["πρόσκομμα",710922,25]],"Return unto the Lord, and forsake thy sins, make thy prayer before his face, and offend less."],["26",[["ἐπάναγε",705015,240],["ἐπὶ",705080,0],["ὕψιστον",713287,27],["καὶ",707031,7],["ἀπόστρεφε",701598,240],["ἀπὸ",701425,0],["ἀδικίας",700271,17],["καὶ",707031,7],["σφόδρα",712586,28],["μίσησον",708935,176],["βδέλυγμα",702604,25]],"Turn again to the most High, and turn away from iniquity: for he will lead thee out of darkness into the light of health, and hate thou abomination vehemently."],["27",[["ὑψίστῳ",713287,30],["τίς",712867,158],["αἰνέσει",700459,127],["ἐν",704639,0],["ᾅδου",700255,18],["ἀντὶ",701227,0],["ζώντων",705851,170],["καὶ",707031,7],["διδόντων",703654,170],["ἀνθομολόγησιν",701156,9]],"Who shall praise the most High in the grave, instead of them which live and give thanks?"],["28",[["ἀπὸ",701425,0],["νεκροῦ",709247,18],["ὡς",714148,7],["μηδὲ",708855,7],["ὄντος",704093,152],["ἀπόλλυται",701513,117],["ἐξομολόγησις",704961,12],["ζῶν",705851,72],["καὶ",707031,7],["ὑγιὴς",713059,14],["αἰνέσει",700459,127],["τὸν",709436,5],["κύριον",707996,6]],"Thanksgiving perisheth from the dead, as from one that is not: the living and sound in heart shall praise the Lord."],["29",[["ὡς",714148,7],["μεγάλη",708653,29],["ἡ",709436,10],["ἐλεημοσύνη",704421,12],["τοῦ",709436,35],["κυρίου",707996,18],["καὶ",707031,7],["ἐξιλασμὸς",704934,4],["τοῖς",709436,147],["ἐπιστρέφουσιν",705278,349],["ἐπ᾿",705080,0],["αὐτόν",702165,85]],"How great is the lovingkindness of the Lord our God, and his compassion unto such as turn unto him in holiness!"],["30",[["οὐ",709805,28],["γὰρ",702963,11],["δύναται",703838,117],["πάντα",710177,195],["εἶναι",704093,55],["ἐν",704639,0],["ἀνθρώποις",701163,148],["ὅτι",709803,7],["οὐκ",709805,28],["ἀθάνατος",700358,14],["υἱὸς",713075,4],["ἀνθρώπου",701163,18]],"For all things cannot be in men, because the son of man is not immortal."],["31",[["τί",712867,273],["φωτεινότερον",713645,385],["ἡλίου",705974,18],["καὶ",707031,7],["τοῦτο",709858,129],["ἐκλείπει",704237,91],["καὶ",707031,7],["πονηρὸν",710660,27],["ἐνθυμηθήσεται",704739,134],["σὰρξ",711537,12],["καὶ",707031,7],["αἷμα",700442,25]],"What is brighter than the sun? yet the light thereof faileth: and flesh and blood will imagine evil."],["32",[["δύναμιν",703839,9],["ὕψους",713288,21],["οὐρανοῦ",709844,18],["αὐτὸς",702165,121],["ἐπισκέπτεται",705250,117],["καὶ",707031,7],["ἄνθρωποι",701163,52],["πάντες",710177,138],["γῆ",703083,12],["καὶ",707031,7],["σποδός",712022,4]],"He vieweth the power of the height of heaven; and all men are but earth and ashes."]]