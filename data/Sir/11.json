[["1",[["σοφία",711981,12],["ταπεινοῦ",712714,116],["ἀνυψώσει",701293,127],["κεφαλὴν",707639,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["μέσῳ",708768,97],["μεγιστάνων",708657,81],["καθίσει",707006,127],["αὐτόν",702165,85]],"Wisdom lifteth up the head of him that is of low degree, and maketh him to sit among great men."],["2",[["μὴ",708851,28],["αἰνέσῃς",700459,175],["ἄνδρα",701150,6],["ἐν",704639,0],["κάλλει",707093,54],["αὐτοῦ",702165,102],["καὶ",707031,7],["μὴ",708851,28],["βδελύξῃ",702608,175],["ἄνθρωπον",701163,6],["ἐν",704639,0],["ὁράσει",709721,1],["αὐτοῦ",702165,102]],"Commend not a man for his beauty; neither abhor a man for his outward appearance."],["3",[["μικρὰ",708915,29],["ἐν",704639,0],["πετεινοῖς",710439,96],["μέλισσα",708702,12],["καὶ",707031,7],["ἀρχὴ",701836,12],["γλυκασμάτων",703111,44],["ὁ",709436,3],["καρπὸς",707169,4],["αὐτῆς",702165,86]],"The bee is little among such as fly; but her fruit is the chief of sweet things."],["4",[["ἐν",704639,0],["περιβολῇ",710301,1],["ἱματίων",706742,44],["μὴ",708851,28],["καυχήσῃ",707569,172],["καὶ",707031,7],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["δόξης",703791,17],["μὴ",708851,28],["ἐπαίρου",705002,253],["ὅτι",709803,7],["θαυμαστὰ",706138,195],["τὰ",709436,63],["ἔργα",705396,64],["κυρίου",707996,18],["καὶ",707031,7],["κρυπτὰ",707922,195],["τὰ",709436,63],["ἔργα",705396,64],["αὐτοῦ",702165,102],["ἀνθρώποις",701163,148]],"Boast not of thy clothing and raiment, and exalt not thyself in the day of honour: for the works of the Lord are wonderful, and his works among men are hidden."],["5",[["πολλοὶ",710646,138],["τύραννοι",713026,52],["ἐκάθισαν",707006,150],["ἐπὶ",705080,0],["ἐδάφους",704022,21],["ὁ",709436,3],["δὲ",703303,11],["ἀνυπονόητος",701291,14],["ἐφόρεσεν",713554,2],["διάδημα",703447,25]],"Many kings have sat down upon the ground; and one that was never thought of hath worn the crown."],["6",[["πολλοὶ",710646,138],["δυνάσται",703844,52],["ἠτιμάσθησαν",702092,99],["σφόδρα",712586,28],["καὶ",707031,7],["ἔνδοξοι",704694,138],["παρεδόθησαν",710014,99],["εἰς",704105,0],["χεῖρας",713787,39],["ἑτέρων",705535,169]],"Many mighty men have been greatly disgraced; and the honourable delivered into other men's hands."],["7",[["πρὶν",710742,28],["ἐξετάσῃς",704911,175],["μὴ",708851,28],["μέμψῃ",708728,420],["νόησον",709327,176],["πρῶτον",711039,28],["καὶ",707031,7],["τότε",712908,28],["ἐπιτίμα",705305,240]],"Blame not before thou hast examined the truth: understand first, and then rebuke."],["8",[["πρὶν",710742,28],["ἢ",705924,7],["ἀκοῦσαι",700587,300],["μὴ",708851,28],["ἀποκρίνου",701492,253],["καὶ",707031,7],["ἐν",704639,0],["μέσῳ",708768,97],["λόγων",708236,81],["μὴ",708851,28],["παρεμβάλλου",710132,253]],"Answer not before thou hast heard the cause: neither interrupt men in the midst of their talk."],["9",[["περὶ",710285,0],["πράγματος",710708,21],["οὗ",709781,160],["οὐκ",709805,28],["ἔστιν",704093,91],["σοι",711925,159],["χρεία",713938,12],["μὴ",708851,28],["ἔριζε",705423,240],["καὶ",707031,7],["ἐν",704639,0],["κρίσει",707908,1],["ἁμαρτωλῶν",700776,169],["μὴ",708851,28],["συνέδρευε",712426,240]],"Strive not in a matter that concerneth thee not; and sit not in judgment with sinners."],["10",[["τέκνον",712761,297],["μὴ",708851,28],["περὶ",710285,0],["πολλὰ",710646,68],["ἔστωσαν",704093,56],["αἱ",709436,190],["πράξεις",710714,191],["σου",711945,133],["ἐὰν",703912,7],["πληθύνῃς",710530,205],["οὐκ",709805,28],["ἀθῳωθήσῃ",700391,420],["καὶ",707031,7],["ἐὰν",703912,7],["διώκῃς",703768,205],["οὐ",709805,28],["μὴ",708851,28],["καταλάβῃς",707300,175],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἐκφύγῃς",704357,175],["διαδράς",703448,182]],"My son, meddle not with many matters: for if thou meddle much, thou shalt not be innocent; and if thou follow after, thou shalt not obtain, neither shalt thou escape by fleeing."],["11",[["ἔστιν",704093,91],["κοπιῶν",707824,72],["καὶ",707031,7],["πονῶν",710656,72],["καὶ",707031,7],["σπεύδων",712011,72],["καὶ",707031,7],["τόσῳ",712906,30],["μᾶλλον",708448,28],["ὑστερεῖται",713270,117]],"There is one that laboureth, and taketh pains, and maketh haste, and is so much the more behind."],["12",[["ἔστιν",704093,91],["νωθρὸς",709398,14],["προσδεόμενος",710873,122],["ἀντιλήμψεως",701247,17],["ὑστερῶν",713270,72],["ἰσχύι",706858,1],["καὶ",707031,7],["πτωχείᾳ",711073,1],["περισσεύει",710386,91],["καὶ",707031,7],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["κυρίου",707996,18],["ἐπέβλεψαν",705088,150],["αὐτῷ",702165,50],["εἰς",704105,0],["ἀγαθά",700106,68],["καὶ",707031,7],["ἀνώρθωσεν",701197,2],["αὐτὸν",702165,85],["ἐκ",704132,0],["ταπεινώσεως",712719,17],["αὐτοῦ",702165,102]],"Again, there is another that is slow, and hath need of help, wanting ability, and full of poverty; yet the eye of the Lord looked upon him for good, and set him up from his low estate,"],["13",[["καὶ",707031,7],["ἀνύψωσεν",701293,2],["κεφαλὴν",707639,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀπεθαύμασαν",701456,150],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["πολλοί",710646,138]],"and lifted up his head from misery; so that many that saw it marvelled at him."],["14",[["ἀγαθὰ",700106,195],["καὶ",707031,7],["κακά",707066,195],["ζωὴ",705910,12],["καὶ",707031,7],["θάνατος",706096,4],["πτωχεία",711073,12],["καὶ",707031,7],["πλοῦτος",710563,4],["παρὰ",709995,0],["κυρίου",707996,18],["ἐστίν",704093,91]],"Prosperity and adversity, life and death, poverty and riches, come of the Lord."],["17",[["δόσις",703809,12],["κυρίου",707996,18],["παραμένει",710071,91],["εὐσεβέσιν",705687,230],["καὶ",707031,7],["ἡ",709436,10],["εὐδοκία",705566,12],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["εὐοδωθήσεται",705654,134]],"The gift of the Lord remaineth with the godly, and his favour bringeth prosperity for ever."],["18",[["ἔστιν",704093,91],["πλουτῶν",710561,72],["ἀπὸ",701425,0],["προσοχῆς",710944,17],["καὶ",707031,7],["σφιγγίας",712584,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["αὕτη",709858,107],["ἡ",709436,10],["μερὶς",708748,12],["τοῦ",709436,35],["μισθοῦ",708939,18],["αὐτοῦ",702165,102]],"There is that waxeth rich by his wariness and pinching, and this is the portion of his reward:"],["19",[["ἐν",704639,0],["τῷ",709436,53],["εἰπεῖν",705373,106],["αὐτόν",702165,85],["εὗρον",705676,155],["ἀνάπαυσιν",701026,9],["καὶ",707031,7],["νῦν",709384,28],["φάγομαι",705495,181],["ἐκ",704132,0],["τῶν",709436,43],["ἀγαθῶν",700106,83],["μου",709032,133],["καὶ",707031,7],["οὐκ",709805,28],["οἶδεν",709492,171],["τίς",712867,158],["καιρὸς",707047,4],["παρελεύσεται",710141,93],["καὶ",707031,7],["καταλείψει",707305,127],["αὐτὰ",702165,71],["ἑτέροις",705535,230],["καὶ",707031,7],["ἀποθανεῖται",701461,93]],"whereas he saith, I have found rest, and now will eat continually of my goods; and [yet] he knoweth not what time shall come upon him, and that he must leave those things to others, and die."],["20",[["στῆθι",706846,176],["ἐν",704639,0],["διαθήκῃ",703456,1],["σου",711945,133],["καὶ",707031,7],["ὁμίλει",709613,240],["ἐν",704639,0],["αὐτῇ",702165,105],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἔργῳ",705396,54],["σου",711945,133],["παλαιώθητι",709937,244]],"Be stedfast in thy covenant, and be conversant therein, and wax old in thy work."],["21",[["μὴ",708851,28],["θαύμαζε",706135,240],["ἐν",704639,0],["ἔργοις",705396,96],["ἁμαρτωλοῦ",700776,116],["πίστευε",710483,240],["δὲ",703303,11],["κυρίῳ",707996,114],["καὶ",707031,7],["ἔμμενε",704570,240],["τῷ",709436,113],["πόνῳ",710661,114],["σου",711945,133],["ὅτι",709803,7],["κοῦφον",707863,26],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["κυρίου",707996,18],["διὰ",703417,0],["τάχους",712747,21],["ἐξάπινα",704868,28],["πλουτίσαι",710562,106],["πένητα",710248,6]],"Marvel not at the works of sinners; but trust in the Lord, and abide in thy labour: for it is an easy thing in the sight of the Lord on the sudden to make a poor man rich."],["22",[["εὐλογία",705633,12],["κυρίου",707996,18],["ἐν",704639,0],["μισθῷ",708939,114],["εὐσεβοῦς",705687,116],["καὶ",707031,7],["ἐν",704639,0],["ὥρᾳ",714128,1],["ταχινῇ",712744,101],["ἀναθάλλει",700949,91],["εὐλογίαν",705633,9],["αὐτοῦ",702165,102]],"The blessing of the Lord is in the reward of the godly, and suddenly he maketh his blessing to flourish."],["23",[["μὴ",708851,28],["εἴπῃς",705373,175],["τίς",712867,359],["ἐστίν",704093,91],["μου",709032,133],["χρεία",713938,12],["καὶ",707031,7],["τίνα",712867,642],["ἀπὸ",701425,0],["τοῦ",709436,20],["νῦν",709384,28],["ἔσται",704093,93],["μου",709032,133],["τὰ",709436,63],["ἀγαθά",700106,195]],"Say not, What profit is there of my service? and what good things shall I have hereafter?"],["24",[["μὴ",708851,28],["εἴπῃς",705373,175],["αὐτάρκη",702157,195],["μοί",708974,159],["ἐστιν",704093,91],["καὶ",707031,7],["τί",712867,273],["ἀπὸ",701425,0],["τοῦ",709436,20],["νῦν",709384,28],["κακωθήσομαι",707073,180]],"Again, say not, I have enough, and possess many things, and what evil can come to me hereafter?"],["25",[["ἐν",704639,0],["ἡμέρᾳ",705984,1],["ἀγαθῶν",700106,83],["ἀμνησία",700851,12],["κακῶν",707066,83],["καὶ",707031,7],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["κακῶν",707066,83],["οὐ",709805,28],["μνησθήσεται",708923,134],["ἀγαθῶν",700106,83]],"In the day of prosperity there is a forgetfulness of affliction: and in the day of affliction there is no more remembrance of prosperity."],["26",[["ὅτι",709803,7],["κοῦφον",707863,26],["ἔναντι",704653,0],["κυρίου",707996,18],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["τελευτῆς",712782,17],["ἀποδοῦναι",701449,106],["ἀνθρώπῳ",701163,114],["κατὰ",707200,0],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτοῦ",702165,102]],"For it is an easy thing unto the Lord in the day of death to reward a man according to his ways."],["27",[["κάκωσις",707075,12],["ὥρας",714128,17],["ἐπιλησμονὴν",705192,12],["ποιεῖ",710582,91],["τρυφῆς",713008,17],["καὶ",707031,7],["ἐν",704639,0],["συντελείᾳ",712509,1],["ἀνθρώπου",701163,18],["ἀποκάλυψις",701475,12],["ἔργων",705396,44],["αὐτοῦ",702165,102]],"The affliction of an hour maketh a man forget pleasure: and in his end his deeds shall be discovered."],["28",[["πρὸ",710747,0],["τελευτῆς",712782,17],["μὴ",708851,28],["μακάριζε",708396,240],["μηδένα",708857,27],["καὶ",707031,7],["ἐν",704639,0],["τέκνοις",712761,96],["αὐτοῦ",702165,102],["γνωσθήσεται",703105,134],["ἀνήρ",701150,4]],"Judge none blessed before his death: for a man shall be known in his children."],["29",[["μὴ",708851,28],["πάντα",710177,27],["ἄνθρωπον",701163,6],["εἴσαγε",704107,240],["εἰς",704105,0],["τὸν",709436,5],["οἶκόν",709516,6],["σου",711945,133],["πολλὰ",710646,195],["γὰρ",702963,11],["τὰ",709436,63],["ἔνεδρα",704704,64],["τοῦ",709436,35],["δολίου",703783,116]],"Bring not every man into thine house: for the deceitful man hath many trains."],["30",[["πέρδιξ",710284,12],["θηρευτὴς",706247,4],["ἐν",704639,0],["καρτάλλῳ",707177,114],["οὕτως",709859,28],["καρδία",707141,12],["ὑπερηφάνου",713139,116],["καὶ",707031,7],["ὡς",714148,7],["ὁ",709436,3],["κατάσκοπος",707427,4],["ἐπιβλέπει",705088,91],["πτῶσιν",711072,9]],"Like as a partridge taken [and kept] in a cage, so is the heart of the proud: and like as a spy, watcheth he for thy fall:"],["31",[["τὰ",709436,41],["γὰρ",702963,11],["ἀγαθὰ",700106,68],["εἰς",704105,0],["κακὰ",707066,68],["μεταστρέφων",708817,72],["ἐνεδρεύει",704703,91],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["αἱρετοῖς",700471,94],["ἐπιθήσει",705304,127],["μῶμον",709102,6]],"for he lieth in wait, and turneth good into evil, and in things worthy praise will lay blame upon thee."],["32",[["ἀπὸ",701425,0],["σπινθῆρος",712015,18],["πυρὸς",711088,21],["πληθύνεται",710530,117],["ἀνθρακιά",701158,12],["καὶ",707031,7],["ἄνθρωπος",701163,4],["ἁμαρτωλὸς",700776,14],["εἰς",704105,0],["αἷμα",700442,25],["ἐνεδρεύει",704703,91]],"Of a spark of fire a heap of coals is kindled: and a sinful man layeth wait for blood."],["33",[["πρόσεχε",710895,240],["ἀπὸ",701425,0],["κακούργου",707070,116],["πονηρὰ",710660,68],["γὰρ",702963,11],["τεκταίνει",712764,91],["μήποτε",708882,28],["μῶμον",709102,6],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["δῷ",703654,172],["σοι",711925,159]],"Take heed of a mischievous man, for he worketh wickedness: lest he bring upon thee a perpetual blot."],["34",[["ἐνοίκισον",704773,176],["ἀλλότριον",700699,27],["καὶ",707031,7],["διαστρέψει",703592,127],["σε",711598,163],["ἐν",704639,0],["ταραχαῖς",712722,76],["καὶ",707031,7],["ἀπαλλοτριώσει",701334,127],["σε",711598,163],["τῶν",709436,80],["ἰδίων",706493,169],["σου",711945,133]],"Receive a stranger into thine house, and he will disturb thee, and turn thee out of thine own."]]