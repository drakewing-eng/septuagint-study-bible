[["1",[["αἰνέσωμεν",700459,79],["δὴ",703395,11],["ἄνδρας",701150,57],["ἐνδόξους",704694,60],["καὶ",707031,7],["τοὺς",709436,58],["πατέρας",710189,57],["ἡμῶν",705999,145],["τῇ",709436,100],["γενέσει",703043,1]],"Let us now praise famous men, and our fathers that begat us."],["2",[["πολλὴν",710646,36],["δόξαν",703791,9],["ἔκτισεν",707938,2],["ὁ",709436,3],["κύριος",707996,4],["τὴν",709436,8],["μεγαλωσύνην",708652,9],["αὐτοῦ",702165,102],["ἀπ᾿",701425,0],["αἰῶνος",700504,18]],"The Lord hath wrought great glory by them through his great power from the beginning."],["3",[["κυριεύοντες",707995,146],["ἐν",704639,0],["ταῖς",709436,75],["βασιλείαις",702577,76],["αὐτῶν",702165,40],["καὶ",707031,7],["ἄνδρες",701150,52],["ὀνομαστοὶ",709669,138],["ἐν",704639,0],["δυνάμει",703839,1],["βουλεύοντες",702791,146],["ἐν",704639,0],["συνέσει",712460,1],["αὐτῶν",702165,40],["ἀπηγγελκότες",701321,268],["ἐν",704639,0],["προφητείαις",711007,76]],"Such as did bear rule in their kingdoms, men renowned for their power, giving counsel by their understanding, and declaring prophecies:"],["4",[["ἡγούμενοι",705931,348],["λαοῦ",708094,18],["ἐν",704639,0],["διαβουλίοις",703431,148],["καὶ",707031,7],["συνέσει",712460,1],["γραμματείας",703184,39],["λαοῦ",708094,18],["σοφοὶ",711985,138],["λόγοι",708236,52],["ἐν",704639,0],["παιδείᾳ",709924,1],["αὐτῶν",702165,40]],"leaders of the people by their counsels, and by their knowledge of learning meet for the people, wise and eloquent in their instruction:"],["5",[["ἐκζητοῦντες",704187,146],["μέλη",708707,42],["μουσικῶν",709034,83],["καὶ",707031,7],["διηγούμενοι",703679,348],["ἔπη",705353,42],["ἐν",704639,0],["γραφῇ",703191,1]],"such as found out musical tunes, and recited verses in writing:"],["6",[["ἄνδρες",701150,52],["πλούσιοι",710560,138],["κεχορηγημένοι",713911,429],["ἰσχύι",706858,1],["εἰρηνεύοντες",704097,146],["ἐν",704639,0],["κατοικίαις",707537,76],["αὐτῶν",702165,40]],"rich men furnished with ability, living peaceably in their habitations:"],["7",[["πάντες",710177,138],["οὗτοι",709858,201],["ἐν",704639,0],["γενεαῖς",703037,76],["ἐδοξάσθησαν",703792,99],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["αὐτῶν",702165,40],["καύχημα",707570,15]],"all these were honoured in their generations, and were the glory of their times."],["8",[["εἰσὶν",704093,197],["αὐτῶν",702165,40],["οἳ",709781,250],["κατέλιπον",707305,150],["ὄνομα",709666,25],["τοῦ",709436,35],["ἐκδιηγήσασθαι",704172,109],["ἐπαίνους",705001,57]],"There be of them that have left a name behind them, that their praises might be reported."],["9",[["καὶ",707031,7],["εἰσὶν",704093,197],["ὧν",709781,252],["οὐκ",709805,28],["ἔστιν",704093,91],["μνημόσυνον",708966,15],["καὶ",707031,7],["ἀπώλοντο",701513,189],["ὡς",714148,7],["οὐχ",709805,28],["ὑπάρξαντες",713104,196],["καὶ",707031,7],["ἐγένοντο",703104,189],["ὡς",714148,7],["οὐ",709805,28],["γεγονότες",703104,268],["καὶ",707031,7],["τὰ",709436,63],["τέκνα",712761,64],["αὐτῶν",702165,40],["μετ᾿",708780,0],["αὐτούς",702165,62]],"And some there be, which have no memorial; who are perished, as though they had never been; and are become as though they had never been born; and their children after them."],["10",[["ἀλλ᾿",700680,7],["ἢ",705924,7],["οὗτοι",709858,201],["ἄνδρες",701150,52],["ἐλέους",704426,21],["ὧν",709781,252],["αἱ",709436,190],["δικαιοσύναι",703695,191],["οὐκ",709805,28],["ἐπελήσθησαν",710240,99]],"But these were merciful men, whose righteousness hath not been forgotten."],["11",[["μετὰ",708780,0],["τοῦ",709436,20],["σπέρματος",712008,21],["αὐτῶν",702165,40],["διαμενεῖ",703517,127],["ἀγαθὴ",700106,29],["κληρονομία",707725,12],["ἔκγονα",704159,68],["αὐτῶν",702165,40]],"With their seed shall continually remain a good inheritance, and their children are within the covenant."],["12",[["ἐν",704639,0],["ταῖς",709436,75],["διαθήκαις",703456,76],["ἔστη",706846,2],["τὸ",709436,34],["σπέρμα",712008,15],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,63],["τέκνα",712761,64],["αὐτῶν",702165,40],["δι᾿",703417,0],["αὐτούς",702165,62]],"Their seed standeth fast, and their children for their sakes."],["13",[["ἕως",705792,0],["αἰῶνος",700504,18],["μενεῖ",708736,127],["σπέρμα",712008,15],["αὐτῶν",702165,40],["καὶ",707031,7],["ἡ",709436,10],["δόξα",703791,12],["αὐτῶν",702165,40],["οὐκ",709805,28],["ἐξαλειφθήσεται",704852,134]],"Their seed shall remain for ever, and their glory shall not be blotted out."],["14",[["τὰ",709436,63],["σώματα",712635,64],["αὐτῶν",702165,40],["ἐν",704639,0],["εἰρήνῃ",704098,1],["ἐτάφη",706103,37],["καὶ",707031,7],["τὸ",709436,34],["ὄνομα",709666,15],["αὐτῶν",702165,40],["ζῇ",705851,91],["εἰς",704105,0],["γενεάς",703037,39]],"Their bodies are buried in peace; but their name liveth for evermore."],["15",[["σοφίαν",711981,9],["αὐτῶν",702165,40],["διηγήσονται",703679,135],["λαοί",708094,52],["καὶ",707031,7],["τὸν",709436,5],["ἔπαινον",705001,6],["ἐξαγγέλλει",704829,91],["ἐκκλησία",704216,12]],"The people will tell of their wisdom, and the congregation will shew forth their praise."],["16",[["Ενωχ",704827,4],["εὐηρέστησεν",705554,2],["κυρίῳ",707996,114],["καὶ",707031,7],["μετετέθη",708820,37],["ὑπόδειγμα",713191,15],["μετανοίας",708810,17],["ταῖς",709436,75],["γενεαῖς",703037,76]],"Enoch pleased the Lord, and was translated, being an example of repentance to all generations."],["17",[["Νωε",709395,4],["εὑρέθη",705676,37],["τέλειος",712769,14],["δίκαιος",703694,14],["ἐν",704639,0],["καιρῷ",707047,114],["ὀργῆς",709728,17],["ἐγένετο",703104,23],["ἀντάλλαγμα",701209,15],["διὰ",703417,0],["τοῦτον",709858,85],["ἐγενήθη",703104,37],["κατάλειμμα",707304,15],["τῇ",709436,100],["γῇ",703083,1],["ὅτε",709802,28],["ἐγένετο",703104,23],["κατακλυσμός",707279,4]],"Noah was found perfect and righteous; in the time of wrath he was taken in exchange [for the world;] therefore was he left as a remnant unto the earth, when the flood came."],["18",[["διαθῆκαι",703456,191],["αἰῶνος",700504,18],["ἐτέθησαν",712849,99],["πρὸς",710844,0],["αὐτόν",702165,85],["ἵνα",706747,7],["μὴ",708851,28],["ἐξαλειφθῇ",704852,384],["κατακλυσμῷ",707279,114],["πᾶσα",710177,29],["σάρξ",711537,12]],"An everlasting covenant was made with him, that all flesh shall perish no more by the flood."],["19",[["Αβρααμ",700091,4],["μέγας",708653,14],["πατὴρ",710189,4],["πλήθους",710529,21],["ἐθνῶν",704068,44],["καὶ",707031,7],["οὐχ",709805,28],["εὑρέθη",705676,37],["ὅμοιος",709626,14],["ἐν",704639,0],["τῇ",709436,100],["δόξῃ",703791,1]],"Abraham was a great father of many people: in glory was there none like unto him;"],["20",[["ὃς",709781,213],["συνετήρησεν",712512,2],["νόμον",709349,6],["ὑψίστου",713287,116],["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["διαθήκῃ",703456,1],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἐν",704639,0],["σαρκὶ",711537,1],["αὐτοῦ",702165,102],["ἔστησεν",706846,2],["διαθήκην",703456,9],["καὶ",707031,7],["ἐν",704639,0],["πειρασμῷ",710226,114],["εὑρέθη",705676,37],["πιστός",710486,14]],"who kept the law of the most High, and was in covenant with him: he established the covenant in his flesh; and when he was proved, he was found faithful."],["21",[["διὰ",703417,0],["τοῦτο",709858,129],["ἐν",704639,0],["ὅρκῳ",709753,114],["ἔστησεν",706846,2],["αὐτῷ",702165,50],["ἐνευλογηθῆναι",704720,179],["ἔθνη",704068,42],["ἐν",704639,0],["σπέρματι",712008,54],["αὐτοῦ",702165,102],["πληθῦναι",710530,106],["αὐτὸν",702165,85],["ὡς",714148,7],["χοῦν",713930,6],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ὡς",714148,7],["ἄστρα",702024,42],["ἀνυψῶσαι",701293,106],["τὸ",709436,24],["σπέρμα",712008,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["κατακληρονομῆσαι",707274,106],["αὐτοὺς",702165,62],["ἀπὸ",701425,0],["θαλάσσης",706069,17],["ἕως",705792,0],["θαλάσσης",706069,17],["καὶ",707031,7],["ἀπὸ",701425,0],["ποταμοῦ",710693,18],["ἕως",705792,0],["ἄκρου",700608,116],["τῆς",709436,16],["γῆς",703083,17]],"Therefore he assured him by an oath, that he would bless the nations in his seed, and that he would multiply him as the dust of the earth, and exalt his seed as the stars, and cause them to inherit from sea to sea, and from the river unto the utmost part of the land."],["22",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["Ισαακ",706799,114],["ἔστησεν",706846,2],["οὕτως",709859,28],["δι᾿",703417,0],["Αβρααμ",700091,6],["τὸν",709436,5],["πατέρα",710189,6],["αὐτοῦ",702165,102]],"With Isaac did he establish likewise, for Abraham his father's sake, the blessing of all men, and the covenant,"],["23",[["εὐλογίαν",705633,9],["πάντων",710177,169],["ἀνθρώπων",701163,81],["καὶ",707031,7],["διαθήκην",703456,9],["κατέπαυσεν",707365,2],["ἐπὶ",705080,0],["κεφαλὴν",707639,9],["Ιακωβ",706401,18],["ἐπέγνω",705104,2],["αὐτὸν",702165,85],["ἐν",704639,0],["εὐλογίαις",705633,76],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["ἐν",704639,0],["κληρονομίᾳ",707725,1],["καὶ",707031,7],["διέστειλεν",703588,2],["μερίδας",708748,39],["αὐτοῦ",702165,102],["ἐν",704639,0],["φυλαῖς",713620,76],["ἐμέρισεν",708744,2],["δέκα",703333,59],["δύο",703849,59]],"and made it rest upon the head of Jacob. He acknowledged him in his blessing, and gave him an heritage, and divided his portions; among the twelve tribes did he part them."]]