[["1",[["ἡγούμενόν",705931,212],["σε",711598,163],["κατέστησαν",707011,150],["μὴ",708851,28],["ἐπαίρου",705002,253],["γίνου",703104,253],["ἐν",704639,0],["αὐτοῖς",702165,151],["ὡς",714148,7],["εἷς",704106,59],["ἐξ",704132,0],["αὐτῶν",702165,40],["φρόντισον",713590,176],["αὐτῶν",702165,40],["καὶ",707031,7],["οὕτω",709859,28],["κάθισον",707006,176]],"If thou be made the master [of a feast], lift not thyself up, but be among them as one of the rest; take diligent care for them, and so sit down.",{"s":"m","br":"35:1","q":1.0}],["2",[["καὶ",707031,7],["πᾶσαν",710177,36],["τὴν",709436,8],["χρείαν",713938,9],["σου",711945,133],["ποιήσας",710582,182],["ἀνάπεσε",701033,176],["ἵνα",706747,7],["εὐφρανθῇς",705715,279],["δι᾿",703417,0],["αὐτοὺς",702165,62],["καὶ",707031,7],["εὐκοσμίας",705624,17],["χάριν",713735,9],["λάβῃς",708076,175],["στέφανον",712083,6]],"And when thou hast done all thy office, take thy place, that thou mayest be merry with them, and receive a crown for thy well ordering of the feast.",{"s":"m","br":"35:2","q":1.0}],["3",[["λάλησον",708071,176],["πρεσβύτερε",710735,153],["πρέπει",710728,91],["γάρ",702963,11],["σοι",711925,159],["ἐν",704639,0],["ἀκριβεῖ",700597,101],["ἐπιστήμῃ",705267,1],["καὶ",707031,7],["μὴ",708851,28],["ἐμποδίσῃς",704604,175],["μουσικά",709034,68]],"Speak, thou that art the elder, for it becometh thee, but with sound judgment; and hinder not music.",{"s":"m","br":"35:3","q":1.0}],["4",[["ὅπου",709710,11],["ἀκρόαμα",700601,15],["μὴ",708851,28],["ἐκχέῃς",704368,205],["λαλιὰν",708074,9],["καὶ",707031,7],["ἀκαίρως",700510,28],["μὴ",708851,28],["σοφίζου",711982,253]],"Pour not out words where there is a musician, and shew not forth wisdom out of time.",{"s":"m","br":"35:4","q":1.0}],["5",[["σφραγὶς",712591,12],["ἄνθρακος",701160,18],["ἐπὶ",705080,0],["κόσμῳ",707851,114],["χρυσῷ",713971,30],["σύγκριμα",712232,15],["μουσικῶν",709034,83],["ἐν",704639,0],["συμποσίῳ",712345,54],["οἴνου",709530,18]],"A concert of music in a banquet of wine is as a signet of carbuncle set in gold.",{"s":"m","br":"35:5","q":1.0}],["6",[["ἐν",704639,0],["κατασκευάσματι",707420,54],["χρυσῷ",713971,97],["σφραγὶς",712591,12],["σμαράγδου",711909,18],["μέλος",708707,15],["μουσικῶν",709034,83],["ἐφ᾿",705080,0],["ἡδεῖ",705945,30],["οἴνῳ",709530,114]],"As a signet of an emerald set in a work of gold, so is the melody of music with pleasant wine.",{"s":"m","br":"35:6","q":1.0}],["7",[["λάλησον",708071,176],["νεανίσκε",709232,153],["εἰ",704071,7],["χρεία",713938,12],["σου",711945,133],["μόλις",708982,28],["δὶς",703741,28],["ἐὰν",703912,7],["ἐπερωτηθῇς",705069,279]],"Speak, young man, if there be need of thee: and yet scarcely when thou art twice asked.",{"s":"m","br":"35:7","q":1.0}],["8",[["κεφαλαίωσον",707638,176],["λόγον",708236,6],["ἐν",704639,0],["ὀλίγοις",709568,230],["πολλά",710646,68],["γίνου",703104,253],["ὡς",714148,7],["γινώσκων",703105,72],["καὶ",707031,7],["ἅμα",700745,28],["σιωπῶν",711818,72]],"Let thy speech be short, comprehending much in few words; be as one that knoweth and yet holdeth his tongue.",{"s":"m","br":"35:8","q":1.0}],["9",[["ἐν",704639,0],["μέσῳ",708768,30],["μεγιστάνων",708657,81],["μὴ",708851,28],["ἐξισάζου",704938,253],["καὶ",707031,7],["ἑτέρου",705535,116],["λέγοντος",708124,152],["μὴ",708851,28],["πολλὰ",710646,68],["ἀδολέσχει",700281,240]],null,{"s":"h"}],["10",[["πρὸ",710747,0],["βροντῆς",702816,17],["κατασπεύδει",707433,91],["ἀστραπή",702021,12],["καὶ",707031,7],["πρὸ",710747,0],["αἰσχυντηροῦ",700484,116],["προελεύσεται",710789,93],["χάρις",713735,12]],"Before the thunder goeth lightning; and before a shamefaced man shall go favour.",{"s":"m","br":"35:10","q":1.0}],["11",[["ἐν",704639,0],["ὥρᾳ",714128,1],["ἐξεγείρου",704889,253],["καὶ",707031,7],["μὴ",708851,28],["οὐράγει",709840,240],["ἀπότρεχε",701623,240],["εἰς",704105,0],["οἶκον",709516,6],["καὶ",707031,7],["μὴ",708851,28],["ῥᾳθύμει",711155,240]],"Rise up betimes, and be not the last; but get thee home without delay.",{"s":"m","br":"35:11","q":1.0}],["12",[["ἐκεῖ",704181,28],["παῖζε",709931,240],["καὶ",707031,7],["ποίει",710582,240],["τὰ",709436,41],["ἐνθυμήματά",704740,42],["σου",711945,133],["καὶ",707031,7],["μὴ",708851,28],["ἁμάρτῃς",700773,175],["λόγῳ",708236,114],["ὑπερηφάνῳ",713139,30]],"There take thy pastime, and do what thou wilt: but sin not by proud speech.",{"s":"m","br":"35:12","q":1.0}],["13",[["καὶ",707031,7],["ἐπὶ",705080,0],["τούτοις",709858,206],["εὐλόγησον",705631,176],["τὸν",709436,5],["ποιήσαντά",710582,365],["σε",711598,163],["καὶ",707031,7],["μεθύσκοντά",708676,183],["σε",711598,163],["ἀπὸ",701425,0],["τῶν",709436,43],["ἀγαθῶν",700106,83],["αὐτοῦ",702165,102]],"And for these things bless him that made thee, and hath replenished thee with his good things.",{"s":"m","br":"35:13","q":1.0}],["14",[["ὁ",709436,3],["φοβούμενος",713532,122],["κύριον",707996,6],["ἐκδέξεται",704165,93],["παιδείαν",709924,9],["καὶ",707031,7],["οἱ",709436,136],["ὀρθρίζοντες",709742,146],["εὑρήσουσιν",705676,218],["εὐδοκίαν",705566,9]],"Whoso feareth the Lord will receive his discipline; and they that seek him early shall find favour.",{"s":"m","br":"35:14","q":1.0}],["15",[["ὁ",709436,3],["ζητῶν",705879,72],["νόμον",709349,6],["ἐμπλησθήσεται",704592,134],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὁ",709436,3],["ὑποκρινόμενος",713207,122],["σκανδαλισθήσεται",711824,134],["ἐν",704639,0],["αὐτῷ",702165,50]],"He that seeketh the law shall be filled therewith: but the hypocrite will be offended thereat.",{"s":"m","br":"35:15","q":1.0}],["16",[["οἱ",709436,136],["φοβούμενοι",713532,348],["κύριον",707996,6],["εὑρήσουσιν",705676,218],["κρίμα",707903,25],["καὶ",707031,7],["δικαιώματα",703697,42],["ὡς",714148,7],["φῶς",713642,25],["ἐξάψουσιν",704874,218]],"They that fear the Lord shall find judgment, and shall kindle justice as a light.",{"s":"m","br":"35:16","q":1.0}],["17",[["ἄνθρωπος",701163,4],["ἁμαρτωλὸς",700776,14],["ἐκκλινεῖ",704220,127],["ἐλεγμὸν",704413,6],["καὶ",707031,7],["κατὰ",707200,0],["τὸ",709436,24],["θέλημα",706170,25],["αὐτοῦ",702165,102],["εὑρήσει",705676,127],["σύγκριμα",712232,25]],"A sinful man will not be reproved, but findeth an excuse according to his will.",{"s":"m","br":"35:17","q":1.0}],["18",[["ἀνὴρ",701150,4],["βουλῆς",702792,17],["οὐ",709805,28],["μὴ",708851,28],["παρίδῃ",710125,172],["διανόημα",703529,25],["ἀλλότριος",700699,14],["καὶ",707031,7],["ὑπερήφανος",713139,14],["οὐ",709805,28],["καταπτήξει",707392,127],["φόβον",713534,6]],"A man of counsel will be considerate; but a strange and proud man is not daunted with fear, even when of himself he hath done without counsel.",{"s":"m","br":"35:18","q":0.6,"gd":0.6}],["19",[["ἄνευ",701137,0],["βουλῆς",702792,17],["μηθὲν",708857,46],["ποιήσῃς",710582,175],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["ποιῆσαί",710582,106],["σε",711598,163],["μὴ",708851,28],["μεταμελοῦ",708805,253]],null,{"s":"h"}],["20",[["ἐν",704639,0],["ὁδῷ",709458,1],["ἀντιπτώματος",701271,21],["μὴ",708851,28],["πορεύου",710667,253],["καὶ",707031,7],["μὴ",708851,28],["προσκόψῃς",710923,175],["ἐν",704639,0],["λιθώδεσιν",708201,94]],"Go not in a way wherein thou mayest fall, and stumble not among the stones.",{"s":"m","br":"35:20","q":1.0}],["21",[["μὴ",708851,28],["πιστεύσῃς",710483,175],["ἐν",704639,0],["ὁδῷ",709458,1],["ἀπροσκόπῳ",701650,101]],"Be not confident in a plain way.",{"s":"m","br":"35:21","q":1.0}],["22",[["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,43],["τέκνων",712761,44],["σου",711945,133],["φύλαξαι",713619,300]],"And beware of thine own children.",{"s":"m","br":"35:22","q":1.0}],["23",[["ἐν",704639,0],["παντὶ",710177,97],["ἔργῳ",705396,54],["πίστευε",710483,240],["τῇ",709436,100],["ψυχῇ",714070,1],["σου",711945,133],["καὶ",707031,28],["γὰρ",702963,11],["τοῦτό",709858,132],["ἐστιν",704093,91],["τήρησις",712845,12],["ἐντολῶν",704802,65]],null],["24",[["ὁ",709436,3],["πιστεύων",710483,72],["νόμῳ",709349,114],["προσέχει",710895,91],["ἐντολαῖς",704802,76],["καὶ",707031,7],["ὁ",709436,3],["πεποιθὼς",710221,270],["κυρίῳ",707996,114],["οὐκ",709805,28],["ἐλαττωθήσεται",704394,134]],"He that believeth in the Lord taketh heed to the commandment; and he that trusteth in him shall fare never the worse.",{"s":"m","br":"35:24","q":1.0}]]