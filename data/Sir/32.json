[["1",[["ἡγούμενόν",705931,212],["σε",711598,163],["κατέστησαν",707011,150],["μὴ",708851,28],["ἐπαίρου",705002,253],["γίνου",703104,253],["ἐν",704639,0],["αὐτοῖς",702165,151],["ὡς",714148,7],["εἷς",704106,59],["ἐξ",704132,0],["αὐτῶν",702165,40],["φρόντισον",713590,176],["αὐτῶν",702165,40],["καὶ",707031,7],["οὕτω",709859,28],["κάθισον",707006,176]],"He that keepeth the law bringeth offerings enough: he that taketh heed to the commandment offereth a peace offering."],["2",[["καὶ",707031,7],["πᾶσαν",710177,36],["τὴν",709436,8],["χρείαν",713938,9],["σου",711945,133],["ποιήσας",710582,182],["ἀνάπεσε",701033,176],["ἵνα",706747,7],["εὐφρανθῇς",705715,279],["δι᾿",703417,0],["αὐτοὺς",702165,62],["καὶ",707031,7],["εὐκοσμίας",705624,17],["χάριν",713735,9],["λάβῃς",708076,175],["στέφανον",712083,6]],"He that requiteth a good turn offereth fine flour; and he that giveth alms sacrificeth praise."],["3",[["λάλησον",708071,176],["πρεσβύτερε",710735,153],["πρέπει",710728,91],["γάρ",702963,11],["σοι",711925,159],["ἐν",704639,0],["ἀκριβεῖ",700597,101],["ἐπιστήμῃ",705267,1],["καὶ",707031,7],["μὴ",708851,28],["ἐμποδίσῃς",704604,175],["μουσικά",709034,68]],"To depart from wickedness is a thing pleasing to the Lord; and to forsake unrighteousness is a propitiation."],["4",[["ὅπου",709710,11],["ἀκρόαμα",700601,15],["μὴ",708851,28],["ἐκχέῃς",704368,205],["λαλιὰν",708074,9],["καὶ",707031,7],["ἀκαίρως",700510,28],["μὴ",708851,28],["σοφίζου",711982,253]],"Thou shalt not appear empty before the Lord."],["5",[["σφραγὶς",712591,12],["ἄνθρακος",701160,18],["ἐπὶ",705080,0],["κόσμῳ",707851,114],["χρυσῷ",713971,30],["σύγκριμα",712232,15],["μουσικῶν",709034,83],["ἐν",704639,0],["συμποσίῳ",712345,54],["οἴνου",709530,18]],"For all these things [are to be done] because of the commandment."],["6",[["ἐν",704639,0],["κατασκευάσματι",707420,54],["χρυσῷ",713971,97],["σφραγὶς",712591,12],["σμαράγδου",711909,18],["μέλος",708707,15],["μουσικῶν",709034,83],["ἐφ᾿",705080,0],["ἡδεῖ",705945,30],["οἴνῳ",709530,114]],"The offering of the righteous maketh the altar fat, and the sweet savour thereof [is] before the most High."],["7",[["λάλησον",708071,176],["νεανίσκε",709232,153],["εἰ",704071,7],["χρεία",713938,12],["σου",711945,133],["μόλις",708982,28],["δὶς",703741,28],["ἐὰν",703912,7],["ἐπερωτηθῇς",705069,279]],"The sacrifice of a just man is acceptable, and the memorial thereof shall never be forgotten."],["8",[["κεφαλαίωσον",707638,176],["λόγον",708236,6],["ἐν",704639,0],["ὀλίγοις",709568,230],["πολλά",710646,68],["γίνου",703104,253],["ὡς",714148,7],["γινώσκων",703105,72],["καὶ",707031,7],["ἅμα",700745,28],["σιωπῶν",711818,72]],"Give the Lord his honour with a good eye, and diminish not the firstfruits of thine hands."],["9",[["ἐν",704639,0],["μέσῳ",708768,30],["μεγιστάνων",708657,81],["μὴ",708851,28],["ἐξισάζου",704938,253],["καὶ",707031,7],["ἑτέρου",705535,116],["λέγοντος",708124,152],["μὴ",708851,28],["πολλὰ",710646,68],["ἀδολέσχει",700281,240]],"In all thy gifts shew a cheerful countenance, and dedicate thy tithes with gladness."],["10",[["πρὸ",710747,0],["βροντῆς",702816,17],["κατασπεύδει",707433,91],["ἀστραπή",702021,12],["καὶ",707031,7],["πρὸ",710747,0],["αἰσχυντηροῦ",700484,116],["προελεύσεται",710789,93],["χάρις",713735,12]],"Give unto the most High according as he hath enriched thee; and as thou hast gotten, give with a cheerful eye."],["11",[["ἐν",704639,0],["ὥρᾳ",714128,1],["ἐξεγείρου",704889,253],["καὶ",707031,7],["μὴ",708851,28],["οὐράγει",709840,240],["ἀπότρεχε",701623,240],["εἰς",704105,0],["οἶκον",709516,6],["καὶ",707031,7],["μὴ",708851,28],["ῥᾳθύμει",711155,240]],"For the Lord recompenseth, and will give thee seven times as much."],["12",[["ἐκεῖ",704181,28],["παῖζε",709931,240],["καὶ",707031,7],["ποίει",710582,240],["τὰ",709436,41],["ἐνθυμήματά",704740,42],["σου",711945,133],["καὶ",707031,7],["μὴ",708851,28],["ἁμάρτῃς",700773,175],["λόγῳ",708236,114],["ὑπερηφάνῳ",713139,30]],"Do not think to corrupt with gifts: for such he will not receive: and trust not to unrighteous sacrifices; for the Lord is judge, and with him is no respect of persons."],["13",[["καὶ",707031,7],["ἐπὶ",705080,0],["τούτοις",709858,206],["εὐλόγησον",705631,176],["τὸν",709436,5],["ποιήσαντά",710582,365],["σε",711598,163],["καὶ",707031,7],["μεθύσκοντά",708676,183],["σε",711598,163],["ἀπὸ",701425,0],["τῶν",709436,43],["ἀγαθῶν",700106,83],["αὐτοῦ",702165,102]],"He will not accept any person against a poor man, but will hear the prayer of the oppressed."],["14",[["ὁ",709436,3],["φοβούμενος",713532,122],["κύριον",707996,6],["ἐκδέξεται",704165,93],["παιδείαν",709924,9],["καὶ",707031,7],["οἱ",709436,136],["ὀρθρίζοντες",709742,146],["εὑρήσουσιν",705676,218],["εὐδοκίαν",705566,9]],"He will not despise the supplication of the fatherless; nor the widow, when she poureth out her complaint."],["15",[["ὁ",709436,3],["ζητῶν",705879,72],["νόμον",709349,6],["ἐμπλησθήσεται",704592,134],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὁ",709436,3],["ὑποκρινόμενος",713207,122],["σκανδαλισθήσεται",711824,134],["ἐν",704639,0],["αὐτῷ",702165,50]],"Do not the tears run down the widow's cheeks? and is not her cry against him that causeth them to fall?"],["16",[["οἱ",709436,136],["φοβούμενοι",713532,348],["κύριον",707996,6],["εὑρήσουσιν",705676,218],["κρίμα",707903,25],["καὶ",707031,7],["δικαιώματα",703697,42],["ὡς",714148,7],["φῶς",713642,25],["ἐξάψουσιν",704874,218]],"He that serveth the Lord shall be accepted with favour, and his prayer shall reach unto the clouds."],["17",[["ἄνθρωπος",701163,4],["ἁμαρτωλὸς",700776,14],["ἐκκλινεῖ",704220,127],["ἐλεγμὸν",704413,6],["καὶ",707031,7],["κατὰ",707200,0],["τὸ",709436,24],["θέλημα",706170,25],["αὐτοῦ",702165,102],["εὑρήσει",705676,127],["σύγκριμα",712232,25]],"The prayer of the humble pierceth the clouds: and till it come nigh, he will not be comforted; and will not depart, till the most High shall behold to judge righteously, and execute judgment."],["18",[["ἀνὴρ",701150,4],["βουλῆς",702792,17],["οὐ",709805,28],["μὴ",708851,28],["παρίδῃ",710125,172],["διανόημα",703529,25],["ἀλλότριος",700699,14],["καὶ",707031,7],["ὑπερήφανος",713139,14],["οὐ",709805,28],["καταπτήξει",707392,127],["φόβον",713534,6]],"For the Lord will not be slack, neither will the Mighty be patient toward them, till he have smitten in sunder the loins of the unmerciful, and repayed vengeance to the heathen; till he have taken away the multitude of the proud, and broken the sceptre of the unrighteous;"],["19",[["ἄνευ",701137,0],["βουλῆς",702792,17],["μηθὲν",708857,46],["ποιήσῃς",710582,175],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["ποιῆσαί",710582,106],["σε",711598,163],["μὴ",708851,28],["μεταμελοῦ",708805,253]],"till he have rendered to every man according to his deeds, and to the works of men according to their devices; till he have judged the cause of his people, and made them to rejoice in his mercy."],["20",[["ἐν",704639,0],["ὁδῷ",709458,1],["ἀντιπτώματος",701271,21],["μὴ",708851,28],["πορεύου",710667,253],["καὶ",707031,7],["μὴ",708851,28],["προσκόψῃς",710923,175],["ἐν",704639,0],["λιθώδεσιν",708201,94]],"Mercy is seasonable in the time of affliction, as clouds of rain in the time of drought."],["21",[["μὴ",708851,28],["πιστεύσῃς",710483,175],["ἐν",704639,0],["ὁδῷ",709458,1],["ἀπροσκόπῳ",701650,101]],null],["22",[["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,43],["τέκνων",712761,44],["σου",711945,133],["φύλαξαι",713619,300]],null],["23",[["ἐν",704639,0],["παντὶ",710177,97],["ἔργῳ",705396,54],["πίστευε",710483,240],["τῇ",709436,100],["ψυχῇ",714070,1],["σου",711945,133],["καὶ",707031,28],["γὰρ",702963,11],["τοῦτό",709858,132],["ἐστιν",704093,91],["τήρησις",712845,12],["ἐντολῶν",704802,65]],null],["24",[["ὁ",709436,3],["πιστεύων",710483,72],["νόμῳ",709349,114],["προσέχει",710895,91],["ἐντολαῖς",704802,76],["καὶ",707031,7],["ὁ",709436,3],["πεποιθὼς",710221,270],["κυρίῳ",707996,114],["οὐκ",709805,28],["ἐλαττωθήσεται",704394,134]],null]]