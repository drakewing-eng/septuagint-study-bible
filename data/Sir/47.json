[["1",[["καὶ",707031,7],["μετὰ",708780,0],["τοῦτον",709858,85],["ἀνέστη",701173,2],["Ναθαν",709164,4],["προφητεύειν",711008,55],["ἐν",704639,0],["ἡμέραις",705984,76],["Δαυιδ",703232,18]],"And after him rose up Nathan to prophesy in the time of David."],["2",[["ὥσπερ",714163,28],["στέαρ",712054,15],["ἀφωρισμένον",702227,327],["ἀπὸ",701425,0],["σωτηρίου",712659,21],["οὕτως",709859,28],["Δαυιδ",703232,4],["ἀπὸ",701425,0],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,118]],"As is the fat taken away from the peace offering, so was David chosen out of the children of Israel."],["3",[["ἐν",704639,0],["λέουσιν",708171,148],["ἔπαιξεν",709931,2],["ὡς",714148,7],["ἐν",704639,0],["ἐρίφοις",705429,148],["καὶ",707031,7],["ἐν",704639,0],["ἄρκοις",701766,148],["ὡς",714148,7],["ἐν",704639,0],["ἄρνασι",701731,148],["προβάτων",710768,44]],"He played with lions as with kids, and with bears as with lambs."],["4",[["ἐν",704639,0],["νεότητι",709258,1],["αὐτοῦ",702165,102],["οὐχὶ",709862,28],["ἀπέκτεινεν",701498,2],["γίγαντα",703101,6],["καὶ",707031,7],["ἐξῆρεν",704839,2],["ὀνειδισμὸν",709657,26],["ἐκ",704132,0],["λαοῦ",708094,18],["ἐν",704639,0],["τῷ",709436,53],["ἐπᾶραι",705002,106],["χεῖρα",713787,9],["ἐν",704639,0],["λίθῳ",708196,114],["σφενδόνης",712578,17],["καὶ",707031,7],["καταβαλεῖν",707203,106],["γαυρίαμα",702981,25],["τοῦ",709436,35],["Γολιαθ",703161,18]],"Slew he not a giant, when he was yet but young? and did he not take away reproach from the people, when he lifted up his hand with the stone in the sling, and beat down the boasting of Goliath?"],["5",[["ἐπεκαλέσατο",705153,23],["γὰρ",702963,11],["κύριον",707996,6],["τὸν",709436,5],["ὕψιστον",713287,27],["καὶ",707031,7],["ἔδωκεν",703654,2],["ἐν",704639,0],["τῇ",709436,100],["δεξιᾷ",703360,101],["αὐτοῦ",702165,102],["κράτος",707883,25],["ἐξᾶραι",704839,106],["ἄνθρωπον",701163,6],["δυνατὸν",703845,27],["ἐν",704639,0],["πολέμῳ",710605,114],["ἀνυψῶσαι",701293,106],["κέρας",707625,25],["λαοῦ",708094,18],["αὐτοῦ",702165,102]],"for he called upon the most high Lord; and he gave him strength in his right hand to slay that mighty warrior, and set up the horn of his people."],["6",[["οὕτως",709859,28],["ἐν",704639,0],["μυριάσιν",709062,76],["ἐδόξασαν",703792,150],["αὐτὸν",702165,85],["καὶ",707031,7],["ᾔνεσαν",700459,150],["αὐτὸν",702165,85],["ἐν",704639,0],["εὐλογίαις",705633,76],["κυρίου",707996,18],["ἐν",704639,0],["τῷ",709436,53],["φέρεσθαι",713428,110],["αὐτῷ",702165,50],["διάδημα",703447,25],["δόξης",703791,17]],"So the people honoured him with ten thousands, and praised him in the blessings of the Lord in that he gave him a crown of glory."],["7",[["ἐξέτριψεν",704345,2],["γὰρ",702963,11],["ἐχθροὺς",705779,60],["κυκλόθεν",707956,28],["καὶ",707031,7],["ἐξουδένωσεν",704969,2],["Φυλιστιιμ",713621,57],["τοὺς",709436,58],["ὑπεναντίους",713109,60],["ἕως",705792,7],["σήμερον",711751,28],["συνέτριψεν",712520,2],["αὐτῶν",702165,40],["κέρας",707625,25]],"For he destroyed the enemies on every side, and brought to nought the Philistines his adversaries, and brake their horn in sunder unto this day."],["8",[["ἐν",704639,0],["παντὶ",710177,97],["ἔργῳ",705396,54],["αὐτοῦ",702165,102],["ἔδωκεν",703654,2],["ἐξομολόγησιν",704961,76],["ἁγίῳ",700159,30],["ὑψίστῳ",713287,30],["ῥήματι",711246,54],["δόξης",703791,17],["ἐν",704639,0],["πάσῃ",710177,101],["καρδίᾳ",707141,1],["αὐτοῦ",702165,102],["ὕμνησεν",713085,2],["καὶ",707031,7],["ἠγάπησεν",700120,2],["τὸν",709436,5],["ποιήσαντα",710582,365],["αὐτόν",702165,85]],"In all his works he praised the Holy One most high with words of glory; with his whole heart he sang songs, and loved him that made him."],["9",[["καὶ",707031,7],["ἔστησεν",706846,2],["ψαλτῳδοὺς",714027,57],["κατέναντι",707507,28],["τοῦ",709436,20],["θυσιαστηρίου",706348,21],["καὶ",707031,7],["ἐξ",704132,0],["ἠχοῦς",702305,21],["αὐτῶν",702165,40],["γλυκαίνειν",703110,55],["μέλη",708707,42]],"He set singers also before the altar, that by their voices they might make sweet melody, and daily sing praises in their songs."],["10",[["ἔδωκεν",703654,2],["ἐν",704639,0],["ἑορταῖς",704990,76],["εὐπρέπειαν",705666,9],["καὶ",707031,7],["ἐκόσμησεν",707847,2],["καιροὺς",707047,57],["μέχρι",708849,0],["συντελείας",712509,17],["ἐν",704639,0],["τῷ",709436,53],["αἰνεῖν",700459,55],["αὐτοὺς",702165,62],["τὸ",709436,24],["ἅγιον",700159,27],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀπὸ",701425,0],["πρωίας",711025,82],["ἠχεῖν",706045,55],["τὸ",709436,24],["ἁγίασμα",700154,25]],"He beautified their feasts, and set in order the solemn times until the end, that they might praise his holy name, and that the temple might sound from morning."],["11",[["κύριος",707996,4],["ἀφεῖλεν",702177,2],["τὰς",709436,38],["ἁμαρτίας",700775,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀνύψωσεν",701293,2],["εἰς",704105,0],["αἰῶνα",700504,6],["τὸ",709436,24],["κέρας",707625,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["διαθήκην",703456,9],["βασιλέων",702580,81],["καὶ",707031,7],["θρόνον",706315,6],["δόξης",703791,17],["ἐν",704639,0],["τῷ",709436,113],["Ισραηλ",706839,6]],"The Lord took away his sins, and exalted his horn for ever: he gave him a covenant of kings, and a throne of glory in Israel."],["12",[["μετὰ",708780,0],["τοῦτον",709858,85],["ἀνέστη",701173,2],["υἱὸς",713075,4],["ἐπιστήμων",705268,14],["καὶ",707031,7],["δι᾿",703417,0],["αὐτὸν",702165,85],["κατέλυσεν",707323,2],["ἐν",704639,0],["πλατυσμῷ",710510,114]],"After him rose up a wise son, and for his sake he dwelt at large."],["13",[["Σαλωμων",711430,4],["ἐβασίλευσεν",702581,2],["ἐν",704639,0],["ἡμέραις",705984,76],["εἰρήνης",704098,17],["ᾧ",709781,309],["ὁ",709436,3],["θεὸς",706192,4],["κατέπαυσεν",707365,2],["κυκλόθεν",707956,28],["ἵνα",706747,7],["στήσῃ",706846,172],["οἶκον",709516,6],["ἐπ᾿",705080,0],["ὀνόματι",709666,54],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἑτοιμάσῃ",705539,172],["ἁγίασμα",700154,25],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"Solomon reigned in a peaceable time, and was honoured; for God made all quiet round about him, that he might build an house in his name, and prepare his sanctuary for ever."],["14",[["ὡς",714148,7],["ἐσοφίσθης",711982,168],["ἐν",704639,0],["νεότητί",709258,1],["σου",711945,133],["καὶ",707031,7],["ἐνεπλήσθης",704592,168],["ὡς",714148,7],["ποταμὸς",710693,4],["συνέσεως",712460,17]],"How wise wast thou in thy youth, and, as a flood, filled with understanding!"],["15",[["γῆν",703083,9],["ἐπεκάλυψεν",705155,2],["ἡ",709436,10],["ψυχή",714070,12],["σου",711945,133],["καὶ",707031,7],["ἐνέπλησας",704592,162],["ἐν",704639,0],["παραβολαῖς",710003,76],["αἰνιγμάτων",700460,44]],"Thy soul covered the whole earth, and thou filledst it with dark parables."],["16",[["εἰς",704105,0],["νήσους",709302,39],["πόρρω",710680,28],["ἀφίκετο",702212,23],["τὸ",709436,34],["ὄνομά",709666,15],["σου",711945,133],["καὶ",707031,7],["ἠγαπήθης",700120,168],["ἐν",704639,0],["τῇ",709436,100],["εἰρήνῃ",704098,1],["σου",711945,133]],"Thy name went far unto the islands; and for thy peace thou wast beloved."],["17",[["ἐν",704639,0],["ᾠδαῖς",714091,76],["καὶ",707031,7],["παροιμίαις",710160,76],["καὶ",707031,7],["παραβολαῖς",710003,76],["καὶ",707031,7],["ἐν",704639,0],["ἑρμηνείαις",705433,76],["ἀπεθαύμασάν",701456,150],["σε",711598,163],["χῶραι",714011,191]],"The countries marvelled at thee for thy songs, and proverbs, and parables, and interpretations."],["18",[["ἐν",704639,0],["ὀνόματι",709666,54],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["τοῦ",709436,35],["ἐπικεκλημένου",705153,482],["θεοῦ",706192,18],["Ισραηλ",706839,118],["συνήγαγες",712375,162],["ὡς",714148,7],["κασσίτερον",707198,6],["τὸ",709436,24],["χρυσίον",713972,25],["καὶ",707031,7],["ὡς",714148,7],["μόλιβον",708981,6],["ἐπλήθυνας",710530,162],["ἀργύριον",701707,25]],"By the name of the Lord God, which is called the Lord God of Israel, thou didst gather gold as tin, and didst multiply silver as lead."],["19",[["παρανέκλινας",710076,162],["τὰς",709436,38],["λαγόνας",708053,39],["σου",711945,133],["γυναιξὶν",703209,76],["καὶ",707031,7],["ἐνεξουσιάσθης",704715,168],["ἐν",704639,0],["τῷ",709436,53],["σώματί",712635,54],["σου",711945,133]],"Thou didst bow thy loins unto women, and by thy body thou wast brought into subjection."],["20",[["ἔδωκας",703654,162],["μῶμον",709102,6],["ἐν",704639,0],["τῇ",709436,100],["δόξῃ",703791,1],["σου",711945,133],["καὶ",707031,7],["ἐβεβήλωσας",702614,162],["τὸ",709436,24],["σπέρμα",712008,25],["σου",711945,133],["ἐπαγαγεῖν",704994,106],["ὀργὴν",709728,9],["ἐπὶ",705080,0],["τὰ",709436,41],["τέκνα",712761,42],["σου",711945,133],["καὶ",707031,7],["κατανυγῆναι",707347,106],["ἐπὶ",705080,0],["τῇ",709436,100],["ἀφροσύνῃ",702235,1],["σου",711945,133]],"Thou didst stain thy honour, and pollute thy seed: so that thou broughtest wrath upon thy children, and wast grieved for thy folly."],["21",[["γενέσθαι",703104,109],["δίχα",703756,28],["τυραννίδα",713025,9],["καὶ",707031,7],["ἐξ",704132,0],["Εφραιμ",705769,18],["ἄρξαι",701860,106],["βασιλείαν",702577,9],["ἀπειθῆ",701371,119]],"So the kingdom was divided, and out of Ephraim ruled a rebellious kingdom."],["22",[["ὁ",709436,3],["δὲ",703303,11],["κύριος",707996,4],["οὐ",709805,28],["μὴ",708851,28],["καταλίπῃ",707305,172],["τὸ",709436,24],["ἔλεος",704426,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["διαφθείρῃ",703624,204],["ἀπὸ",701425,0],["τῶν",709436,80],["λόγων",708236,81],["αὐτοῦ",702165,102],["οὐδὲ",709816,7],["μὴ",708851,28],["ἐξαλείψῃ",704852,172],["ἐκλεκτοῦ",704240,116],["αὐτοῦ",702165,102],["ἔκγονα",704159,68],["καὶ",707031,7],["σπέρμα",712008,25],["τοῦ",709436,35],["ἀγαπήσαντος",700120,500],["αὐτὸν",702165,85],["οὐ",709805,28],["μὴ",708851,28],["ἐξάρῃ",704839,172],["καὶ",707031,7],["τῷ",709436,113],["Ιακωβ",706401,114],["ἔδωκεν",703654,2],["κατάλειμμα",707304,25],["καὶ",707031,7],["τῷ",709436,113],["Δαυιδ",703232,114],["ἐξ",704132,0],["αὐτοῦ",702165,102],["ῥίζαν",711260,9]],"But the Lord will never leave off his mercy, neither shall any of his works perish, neither will he abolish the posterity of his elect, and the seed of him that loveth him he will not take away: wherefore he gave a remnant unto Jacob, and out of him a root unto David."],["23",[["καὶ",707031,7],["ἀνεπαύσατο",701027,23],["Σαλωμων",711430,4],["μετὰ",708780,0],["τῶν",709436,80],["πατέρων",710189,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["κατέλιπεν",707305,2],["μετ᾿",708780,0],["αὐτὸν",702165,85],["ἐκ",704132,0],["τοῦ",709436,20],["σπέρματος",712008,21],["αὐτοῦ",702165,102],["λαοῦ",708094,18],["ἀφροσύνην",702235,9],["καὶ",707031,7],["ἐλασσούμενον",704394,212],["συνέσει",712460,1],["Ροβοαμ",711276,4],["ὃς",709781,213],["ἀπέστησεν",702214,2],["λαὸν",708094,6],["ἐκ",704132,0],["βουλῆς",702792,17],["αὐτοῦ",702165,102]],"Thus rested Solomon with his fathers, and of his seed he left behind him Roboam, even the foolishness of the people, and one that had no understanding, who turned away the people through his counsel. There was also Jeroboam the son of Nebat, who caused Israel to sin, and shewed Ephraim the way of sin:",{"s":"d","q":0.68}],["24",[["καὶ",707031,7],["Ιεροβοαμ",706629,4],["υἱὸς",713075,4],["Ναβατ",709134,18],["ὃς",709781,213],["ἐξήμαρτεν",704859,2],["τὸν",709436,5],["Ισραηλ",706839,6],["καὶ",707031,7],["ἔδωκεν",703654,2],["τῷ",709436,113],["Εφραιμ",705769,114],["ὁδὸν",709458,9],["ἁμαρτίας",700775,17],["καὶ",707031,7],["ἐπληθύνθησαν",710530,99],["αἱ",709436,190],["ἁμαρτίαι",700775,191],["αὐτῶν",702165,40],["σφόδρα",712586,28],["ἀποστῆσαι",702214,106],["αὐτοὺς",702165,62],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["αὐτῶν",702165,40]],"and their sins were multiplied exceedingly, that they were driven out of the land.",{"s":"d","q":0.46}],["25",[["καὶ",707031,7],["πᾶσαν",710177,36],["πονηρίαν",710659,9],["ἐξεζήτησαν",704187,150],["ἕως",705792,7],["ἐκδίκησις",704175,12],["ἔλθῃ",705453,172],["ἐπ᾿",705080,0],["αὐτούς",702165,62]],"For they sought out all wickedness, till the vengeance came upon them."]]