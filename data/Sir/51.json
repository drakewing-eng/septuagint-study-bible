[["1",[["ἐξομολογήσομαί",704960,181],["σοι",711925,159],["κύριε",707996,153],["βασιλεῦ",702580,153],["καὶ",707031,7],["αἰνέσω",700459,165],["σε",711598,163],["θεὸν",706192,6],["τὸν",709436,5],["σωτῆρά",712657,6],["μου",709032,133],["ἐξομολογοῦμαι",704960,254],["τῷ",709436,53],["ὀνόματί",709666,54],["σου",711945,133]],"I will thank thee, O Lord and King, and praise thee, O God my Saviour: I do give praise unto thy name:"],["2",[["ὅτι",709803,7],["σκεπαστὴς",711836,4],["καὶ",707031,7],["βοηθὸς",702748,4],["ἐγένου",703104,174],["μοι",708974,159],["καὶ",707031,7],["ἐλυτρώσω",708282,174],["τὸ",709436,24],["σῶμά",712635,25],["μου",709032,133],["ἐξ",704132,0],["ἀπωλείας",701660,17],["καὶ",707031,7],["ἐκ",704132,0],["παγίδος",709910,17],["διαβολῆς",703427,17],["γλώσσης",703120,17],["ἀπὸ",701425,0],["χειλέων",713781,44],["ἐργαζομένων",705383,369],["ψεῦδος",714044,25],["καὶ",707031,7],["ἔναντι",704653,0],["τῶν",709436,80],["παρεστηκότων",710152,387],["ἐγένου",703104,174],["βοηθὸς",702748,4],["καὶ",707031,7],["ἐλυτρώσω",708282,174],["με",708618,163]],"for thou art my defender and helper, and hast preserved my body from destruction, and from the snare of the slanderous tongue, and from the lips that forge lies, and hast been mine helper against mine adversaries:"],["3",[["κατὰ",707200,0],["τὸ",709436,24],["πλῆθος",710529,25],["ἐλέους",704426,21],["καὶ",707031,7],["ὀνόματός",709666,21],["σου",711945,133],["ἐκ",704132,0],["βρυγμῶν",702821,81],["ἕτοιμον",705541,27],["εἰς",704105,0],["βρῶμα",702823,25],["ἐκ",704132,0],["χειρὸς",713787,17],["ζητούντων",705879,170],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἐκ",704132,0],["πλειόνων",710514,198],["θλίψεων",706276,65],["ὧν",709781,199],["ἔσχον",705785,155]],"and hast delivered me, according to the multitude of thy mercies and greatness of thy name, from the teeth of them that were ready to devour me, and out of the hands of such as sought after my life, and from the manifold afflictions which I had;"],["4",[["ἀπὸ",701425,0],["πνιγμοῦ",710572,18],["πυρᾶς",711089,17],["κυκλόθεν",707956,28],["καὶ",707031,7],["ἐκ",704132,0],["μέσου",708768,116],["πυρός",711088,21],["οὗ",709781,160],["οὐκ",709805,28],["ἐξέκαυσα",704205,155]],"from the choking of fire on every side, and from the midst of the fire which I kindled not;"],["5",[["ἐκ",704132,0],["βάθους",702376,21],["κοιλίας",707761,17],["ᾅδου",700255,18],["καὶ",707031,7],["ἀπὸ",701425,0],["γλώσσης",703120,17],["ἀκαθάρτου",700508,82],["καὶ",707031,7],["λόγου",708236,18],["ψευδοῦς",714036,116]],"from the depth of the belly of hell, from an unclean tongue, and from lying words."],["6",[["βασιλεῖ",702580,114],["διαβολὴ",703427,12],["γλώσσης",703120,17],["ἀδίκου",700272,82],["ἤγγισεν",703939,2],["ἕως",705792,0],["θανάτου",706096,18],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["ζωή",705910,12],["μου",709032,133],["ἦν",704093,13],["σύνεγγυς",712424,28],["ᾅδου",700255,18],["κάτω",707557,28]],"By an accusation to the king from an unrighteous tongue my soul drew near even unto death, my life was near to the hell beneath."],["7",[["περιέσχον",710315,150],["με",708618,163],["πάντοθεν",709984,28],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ὁ",709436,3],["βοηθῶν",702746,72],["ἐνέβλεπον",704551,333],["εἰς",704105,0],["ἀντίλημψιν",701247,9],["ἀνθρώπων",701163,81],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13]],"They compassed me on every side, and there was no man to help me: I looked for the succour of men, but there was none."],["8",[["καὶ",707031,7],["ἐμνήσθην",708960,156],["τοῦ",709436,20],["ἐλέους",704426,21],["σου",711945,133],["κύριε",707996,153],["καὶ",707031,7],["τῆς",709436,16],["ἐργασίας",705385,17],["σου",711945,133],["τῆς",709436,16],["ἀπ᾿",701425,0],["αἰῶνος",700504,18],["ὅτι",709803,7],["ἐξαιρῇ",704839,259],["τοὺς",709436,58],["ὑπομένοντάς",713219,235],["σε",711598,163],["καὶ",707031,7],["σῴζεις",712627,154],["αὐτοὺς",702165,62],["ἐκ",704132,0],["χειρὸς",713787,17],["ἐχθρῶν",705779,169]],"Then thought I upon thy mercy, O Lord, and upon thy acts of old, how thou deliverest such as wait for thee, and savest them out of the hands of the enemies."],["9",[["καὶ",707031,7],["ἀνύψωσα",701293,155],["ἀπὸ",701425,0],["γῆς",703083,17],["ἱκετείαν",706715,9],["μου",709032,133],["καὶ",707031,7],["ὑπὲρ",713111,0],["θανάτου",706096,18],["ῥύσεως",711312,17],["ἐδεήθην",703394,156]],"Then lifted I up my supplication from the earth, and prayed for deliverance from death."],["10",[["ἐπεκαλεσάμην",705153,161],["κύριον",707996,6],["πατέρα",710189,6],["κυρίου",707996,18],["μου",709032,133],["μή",708851,28],["με",708618,163],["ἐγκαταλιπεῖν",703967,106],["ἐν",704639,0],["ἡμέραις",705984,76],["θλίψεως",706276,17],["ἐν",704639,0],["καιρῷ",707047,114],["ὑπερηφανιῶν",713138,65],["ἀβοηθησίας",700083,17],["αἰνέσω",700459,165],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["ἐνδελεχῶς",704681,28],["καὶ",707031,7],["ὑμνήσω",713085,165],["ἐν",704639,0],["ἐξομολογήσει",704961,1]],"I called upon the Lord, the Father of my Lord, that he would not leave me in the days of my trouble, and in the time of the proud, when there was no help.",{"s":"d","q":0.62}],["11",[["καὶ",707031,7],["εἰσηκούσθη",704108,37],["ἡ",709436,10],["δέησίς",703311,12],["μου",709032,133],["ἔσωσας",712627,162],["γάρ",702963,11],["με",708618,163],["ἐξ",704132,0],["ἀπωλείας",701660,17],["καὶ",707031,7],["ἐξείλου",704893,253],["με",708618,163],["ἐκ",704132,0],["καιροῦ",707047,18],["πονηροῦ",710660,116]],"I will praise thy name continually, and will sing praise with thanksgiving; and so my prayer was heard:",{"s":"d","q":0.38}],["12",[["διὰ",703417,0],["τοῦτο",709858,129],["ἐξομολογήσομαί",704960,181],["σοι",711925,159],["καὶ",707031,7],["αἰνέσω",700459,165],["σε",711598,163],["καὶ",707031,7],["εὐλογήσω",705631,165],["τῷ",709436,53],["ὀνόματι",709666,54],["κυρίου",707996,18]],"for thou savedst me from destruction, and deliveredst me from the evil time: therefore will I give thanks, and praise thee, and bless thy name, O Lord.",{"s":"d","q":0.52}],["13",[["ἔτι",705538,28],["ὢν",704093,72],["νεώτερος",709256,224],["πρὶν",710742,28],["ἢ",705924,7],["πλανηθῆναί",710495,179],["με",708618,163],["ἐζήτησα",705879,155],["σοφίαν",711981,9],["προφανῶς",711002,28],["ἐν",704639,0],["προσευχῇ",710892,1],["μου",709032,133]],"When I was yet young, or ever I went abroad, I desired wisdom openly in my prayer."],["14",[["ἔναντι",704653,0],["ναοῦ",709191,18],["ἠξίουν",701309,333],["περὶ",710285,0],["αὐτῆς",702165,86],["καὶ",707031,7],["ἕως",705792,0],["ἐσχάτων",705519,83],["ἐκζητήσω",704187,165],["αὐτήν",702165,104]],"I prayed for her before the temple, and will seek her out even to the end."],["15",[["ἐξ",704132,0],["ἄνθους",701157,21],["ὡς",714148,7],["περκαζούσης",710426,222],["σταφυλῆς",712052,17],["εὐφράνθη",705715,37],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["ἐν",704639,0],["αὐτῇ",702165,105],["ἐπέβη",705082,2],["ὁ",709436,3],["πούς",710707,4],["μου",709032,133],["ἐν",704639,0],["εὐθύτητι",705603,1],["ἐκ",704132,0],["νεότητός",709258,17],["μου",709032,133],["ἴχνευον",706872,155],["αὐτήν",702165,104]],"Even from the flower till the grape was ripe hath my heart delighted in her: my foot went the right way, from my youth up sought I after her."],["16",[["ἔκλινα",707738,155],["ὀλίγον",709568,46],["τὸ",709436,24],["οὖς",709852,25],["μου",709032,133],["καὶ",707031,7],["ἐδεξάμην",703393,161],["καὶ",707031,7],["πολλὴν",710646,36],["εὗρον",705676,155],["ἐμαυτῷ",704545,50],["παιδείαν",709924,9]],"I bowed down mine ear a little, and received her, and gat much learning."],["17",[["προκοπὴ",710813,12],["ἐγένετό",703104,23],["μοι",708974,159],["ἐν",704639,0],["αὐτῇ",702165,105],["τῷ",709436,113],["διδόντι",703654,379],["μοι",708974,159],["σοφίαν",711981,9],["δώσω",703654,165],["δόξαν",703791,9]],"I profited therein, [therefore] will I ascribe the glory unto him that giveth me wisdom."],["18",[["διενοήθην",703528,156],["γὰρ",702963,11],["τοῦ",709436,20],["ποιῆσαι",710582,106],["αὐτὴν",702165,104],["καὶ",707031,7],["ἐζήλωσα",705873,155],["τὸ",709436,24],["ἀγαθὸν",700106,46],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["αἰσχυνθῶ",700485,321]],"For I purposed to do after her, and earnestly I followed that which is good; so shall I not be confounded."],["19",[["διαμεμάχισται",703515,187],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ἐν",704639,0],["αὐτῇ",702165,105],["καὶ",707031,7],["ἐν",704639,0],["ποιήσει",710584,1],["νόμου",709349,18],["διηκριβασάμην",703487,161],["τὰς",709436,38],["χεῖράς",713787,39],["μου",709032,133],["ἐξεπέτασα",704278,155],["πρὸς",710844,0],["ὕψος",713288,25],["καὶ",707031,7],["τὰ",709436,41],["ἀγνοήματα",700176,42],["αὐτῆς",702165,86],["ἐπένθησα",710251,155]],"My soul hath wrestled with her, and in my doings I was exact: I stretched forth my hands to the heaven above, and bewailed my ignorances of her."],["20",[["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["κατεύθυνα",707521,155],["εἰς",704105,0],["αὐτὴν",702165,104],["καὶ",707031,7],["ἐν",704639,0],["καθαρισμῷ",706987,114],["εὗρον",705676,155],["αὐτήν",702165,104],["καρδίαν",707141,9],["ἐκτησάμην",707932,161],["μετ᾿",708780,0],["αὐτῆς",702165,86],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["διὰ",703417,0],["τοῦτο",709858,129],["οὐ",709805,28],["μὴ",708851,28],["ἐγκαταλειφθῶ",703967,321]],"I directed my soul unto her, and I found her in pureness: I have had my heart joined with her from the beginning, therefore shall I not be forsaken."],["21",[["καὶ",707031,7],["ἡ",709436,10],["κοιλία",707761,12],["μου",709032,133],["ἐταράχθη",712721,37],["τοῦ",709436,20],["ἐκζητῆσαι",704187,106],["αὐτήν",702165,104],["διὰ",703417,0],["τοῦτο",709858,129],["ἐκτησάμην",707932,161],["ἀγαθὸν",700106,46],["κτῆμα",707933,25]],"My heart was troubled in seeking her: therefore have I gotten a good possession."],["22",[["ἔδωκεν",703654,2],["κύριος",707996,4],["γλῶσσάν",703120,9],["μοι",708974,159],["μισθόν",708939,6],["μου",709032,133],["καὶ",707031,7],["ἐν",704639,0],["αὐτῇ",702165,105],["αἰνέσω",700459,165],["αὐτόν",702165,85]],"The Lord hath given me a tongue for my reward, and I will praise him therewith."],["23",[["ἐγγίσατε",703939,74],["πρός",710844,0],["με",708618,163],["ἀπαίδευτοι",701328,538],["καὶ",707031,7],["αὐλίσθητε",702138,372],["ἐν",704639,0],["οἴκῳ",709516,114],["παιδείας",709924,17]],"Draw near unto me, ye unlearned, and dwell in the house of learning."],["24",[["τί",712867,126],["ὅτι",709803,7],["ὑστερεῖσθαι",713270,110],["λέγετε",708124,87],["ἐν",704639,0],["τούτοις",709858,206],["καὶ",707031,7],["αἱ",709436,190],["ψυχαὶ",714070,191],["ὑμῶν",713091,145],["διψῶσι",703763,197],["σφόδρα",712586,28]],"Wherefore are ye slow, and what say ye of these things, seeing your souls are very thirsty?"],["25",[["ἤνοιξα",701186,155],["τὸ",709436,24],["στόμα",712125,25],["μου",709032,133],["καὶ",707031,7],["ἐλάλησα",708071,155],["κτήσασθε",707932,186],["ἑαυτοῖς",703917,151],["ἄνευ",701137,0],["ἀργυρίου",701707,21]],"I opened my mouth, and said, Buy her for yourselves without money."],["26",[["τὸν",709436,5],["τράχηλον",712924,6],["ὑμῶν",713091,145],["ὑπόθετε",713251,74],["ὑπὸ",713184,0],["ζυγόν",705894,6],["καὶ",707031,7],["ἐπιδεξάσθω",705117,315],["ἡ",709436,10],["ψυχὴ",714070,12],["ὑμῶν",713091,145],["παιδείαν",709924,9],["ἐγγύς",703948,28],["ἐστιν",704093,91],["εὑρεῖν",705676,106],["αὐτήν",702165,104]],"Put your neck under the yoke, and let your soul receive instruction: she is hard at hand to find."],["27",[["ἴδετε",709725,74],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["ὑμῶν",713091,145],["ὅτι",709803,7],["ὀλίγον",709568,46],["ἐκοπίασα",707824,155],["καὶ",707031,7],["εὗρον",705676,155],["ἐμαυτῷ",704545,50],["πολλὴν",710646,36],["ἀνάπαυσιν",701026,9]],"Behold with your eyes, how that I have had but little labour, and have gotten unto me much rest."],["28",[["μετάσχετε",708828,74],["παιδείας",709924,17],["ἐν",704639,0],["πολλῷ",710646,30],["ἀριθμῷ",701744,114],["ἀργυρίου",701707,21],["καὶ",707031,7],["πολὺν",710646,27],["χρυσὸν",713975,27],["κτήσασθε",707932,186],["ἐν",704639,0],["αὐτῇ",702165,105]],"Get learning with a great sum of money, and get much gold by her."],["29",[["εὐφρανθείη",705715,528],["ἡ",709436,10],["ψυχὴ",714070,12],["ὑμῶν",713091,145],["ἐν",704639,0],["τῷ",709436,53],["ἐλέει",704426,54],["αὐτοῦ",702165,102],["καὶ",707031,7],["μὴ",708851,28],["αἰσχυνθείητε",700485,531],["ἐν",704639,0],["αἰνέσει",700457,1],["αὐτοῦ",702165,102]],"Let your soul rejoice in his mercy, and be not ashamed of his praise."],["30",[["ἐργάζεσθε",705383,374],["τὸ",709436,24],["ἔργον",705396,25],["ὑμῶν",713091,145],["πρὸ",710747,0],["καιροῦ",707047,18],["καὶ",707031,7],["δώσει",703654,127],["τὸν",709436,5],["μισθὸν",708939,6],["ὑμῶν",713091,145],["ἐν",704639,0],["καιρῷ",707047,114],["αὐτοῦ",702165,102]],"Work your work betimes, and in his time he will give you your reward."]]