[["2",[["μὴ",708851,28],["ἐπάρῃς",705002,175],["σεαυτὸν",711599,85],["ἐν",704639,0],["βουλῇ",702792,1],["ψυχῆς",714070,17],["σου",711945,133],["ἵνα",706747,7],["μὴ",708851,28],["διαρπαγῇ",703562,384],["ὡς",714148,7],["ταῦρος",712734,4],["ἡ",709436,10],["ψυχή",714070,12],["σου",711945,133]],"Extol not thyself in the counsel of thine own heart: that thy soul be not torn in pieces as a bull [straying alone].",{"s":"m","br":"6:2b","q":1.0}],["3",[["τὰ",709436,41],["φύλλα",713622,42],["σου",711945,133],["καταφάγεσαι",707519,123],["καὶ",707031,7],["τοὺς",709436,58],["καρπούς",707169,57],["σου",711945,133],["ἀπολέσεις",701513,166],["καὶ",707031,7],["ἀφήσεις",702211,166],["σεαυτὸν",711599,85],["ὡς",714148,7],["ξύλον",709427,25],["ξηρόν",709421,46]],"Thou shalt eat up thy leaves, and lose thy fruit, and leave thyself as a dry tree."],["4",[["ψυχὴ",714070,12],["πονηρὰ",710660,29],["ἀπολεῖ",701513,127],["τὸν",709436,5],["κτησάμενον",707932,424],["αὐτὴν",702165,104],["καὶ",707031,7],["ἐπίχαρμα",705332,25],["ἐχθρῶν",705779,169],["ποιήσει",710582,127],["αὐτόν",702165,85]],"A wicked soul shall destroy him that hath it, and shall make him to be laughed to scorn of his enemies."],["5",[["λάρυγξ",708098,4],["γλυκὺς",703114,14],["πληθυνεῖ",710530,127],["φίλους",713492,60],["αὐτοῦ",702165,102],["καὶ",707031,7],["γλῶσσα",703120,12],["εὔλαλος",705630,29],["πληθυνεῖ",710530,127],["εὐπροσήγορα",705669,68]],"Sweet language will multiply friends: and a fairspeaking tongue will increase kind greetings."],["6",[["οἱ",709436,136],["εἰρηνεύοντές",704097,146],["σοι",711925,159],["ἔστωσαν",704093,56],["πολλοί",710646,138],["οἱ",709436,136],["δὲ",703303,11],["σύμβουλοί",712295,52],["σου",711945,133],["εἷς",704106,59],["ἀπὸ",701425,0],["χιλίων",713859,169]],"Be in peace with many: nevertheless have but one counsellor of a thousand."],["7",[["εἰ",704071,7],["κτᾶσαι",707932,278],["φίλον",713492,27],["ἐν",704639,0],["πειρασμῷ",710226,114],["κτῆσαι",707932,300],["αὐτὸν",702165,85],["καὶ",707031,7],["μὴ",708851,28],["ταχὺ",712748,28],["ἐμπιστεύσῃς",704594,175],["αὐτῷ",702165,50]],"If thou wouldest get a friend, prove him first, and be not hasty to credit him."],["8",[["ἔστιν",704093,91],["γὰρ",702963,11],["φίλος",713492,14],["ἐν",704639,0],["καιρῷ",707047,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["παραμείνῃ",710071,172],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["θλίψεώς",706276,17],["σου",711945,133]],"For some man is a friend for his own occasion, and will not abide in the day of thy trouble."],["9",[["καὶ",707031,7],["ἔστιν",704093,91],["φίλος",713492,14],["μετατιθέμενος",708820,122],["εἰς",704105,0],["ἔχθραν",705779,36],["καὶ",707031,7],["μάχην",708601,9],["ὀνειδισμοῦ",709657,18],["σου",711945,133],["ἀποκαλύψει",701474,127]],"And there is a friend, who being turned to enmity and strife will discover thy reproach."],["10",[["καὶ",707031,7],["ἔστιν",704093,91],["φίλος",713492,14],["κοινωνὸς",707777,4],["τραπεζῶν",712919,65],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["παραμείνῃ",710071,172],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["θλίψεώς",706276,17],["σου",711945,133]],"Again, some friend is a companion at the table, and will not continue in the day of thy affliction."],["11",[["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["ἀγαθοῖς",700106,94],["σου",711945,133],["ἔσται",704093,93],["ὡς",714148,7],["σὺ",712181,164],["καὶ",707031,7],["ἐπὶ",705080,0],["τοὺς",709436,58],["οἰκέτας",709496,57],["σου",711945,133],["παρρησιάσεται",710174,93]],"But in thy prosperity he will be as thyself, and will be bold over thy servants."],["12",[["ἐὰν",703912,7],["ταπεινωθῇς",712717,279],["ἔσται",704093,93],["κατὰ",707200,0],["σοῦ",711945,133],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,20],["προσώπου",710986,21],["σου",711945,133],["κρυβήσεται",707923,134]],"If thou be brought low, he will be against thee, and will hide himself from thy face."],["13",[["ἀπὸ",701425,0],["τῶν",709436,80],["ἐχθρῶν",705779,169],["σου",711945,133],["διαχωρίσθητι",703640,244],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,80],["φίλων",713492,169],["σου",711945,133],["πρόσεχε",710895,240]],"Separate thyself from thine enemies, and take heed of thy friends."],["14",[["φίλος",713492,14],["πιστὸς",710486,14],["σκέπη",711839,12],["κραταιά",707873,29],["ὁ",709436,3],["δὲ",703303,11],["εὑρὼν",705676,182],["αὐτὸν",702165,85],["εὗρεν",705676,2],["θησαυρόν",706258,6]],"A faithful friend is a strong defence: and he that hath found such an one hath found a treasure."],["15",[["φίλου",713492,116],["πιστοῦ",710486,116],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀντάλλαγμα",701209,15],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["σταθμὸς",712040,4],["τῆς",709436,16],["καλλονῆς",707092,17],["αὐτοῦ",702165,102]],"Nothing doth countervail a faithful friend, and his excellency is invaluable."],["16",[["φίλος",713492,14],["πιστὸς",710486,14],["φάρμακον",713369,15],["ζωῆς",705910,17],["καὶ",707031,7],["οἱ",709436,136],["φοβούμενοι",713532,348],["κύριον",707996,6],["εὑρήσουσιν",705676,218],["αὐτόν",702165,85]],"A faithful friend is the medicine of life; and they that fear the Lord shall find him."],["17",[["ὁ",709436,3],["φοβούμενος",713532,122],["κύριον",707996,6],["εὐθυνεῖ",705601,127],["φιλίαν",713474,9],["αὐτοῦ",702165,102],["ὅτι",709803,7],["κατ᾿",707200,0],["αὐτὸν",702165,85],["οὕτως",709859,28],["καὶ",707031,28],["ὁ",709436,3],["πλησίον",710547,28],["αὐτοῦ",702165,102]],"Whoso feareth the Lord shall direct his friendship aright: for as he is, so shall his neighbour be also."],["18",[["τέκνον",712761,297],["ἐκ",704132,0],["νεότητός",709258,17],["σου",711945,133],["ἐπίλεξαι",705188,300],["παιδείαν",709924,9],["καὶ",707031,7],["ἕως",705792,0],["πολιῶν",710607,65],["εὑρήσεις",705676,166],["σοφίαν",711981,9]],"My son, gather instruction from thy youth up: so shalt thou find wisdom till thine old age."],["19",[["ὡς",714148,7],["ὁ",709436,3],["ἀροτριῶν",701791,72],["καὶ",707031,7],["ὁ",709436,3],["σπείρων",712006,72],["πρόσελθε",710890,176],["αὐτῇ",702165,105],["καὶ",707031,7],["ἀνάμενε",701000,240],["τοὺς",709436,58],["ἀγαθοὺς",700106,60],["καρποὺς",707169,57],["αὐτῆς",702165,86],["ἐν",704639,0],["γὰρ",702963,11],["τῇ",709436,100],["ἐργασίᾳ",705385,1],["αὐτῆς",702165,86],["ὀλίγον",709568,46],["κοπιάσεις",707824,166],["καὶ",707031,7],["ταχὺ",712748,28],["φάγεσαι",713296,123],["τῶν",709436,43],["γενημάτων",703052,44],["αὐτῆς",702165,86]],"Come unto her as one that ploweth and soweth, and wait for her good fruits: for thou shalt not toil much in labouring about her, but thou shalt eat of her fruits right soon."],["20",[["ὡς",714148,7],["τραχεῖά",712925,29],["ἐστιν",704093,91],["σφόδρα",712586,28],["τοῖς",709436,147],["ἀπαιδεύτοις",701328,230],["καὶ",707031,7],["οὐκ",709805,28],["ἐμμενεῖ",704570,127],["ἐν",704639,0],["αὐτῇ",702165,105],["ἀκάρδιος",700519,14]],"She is very unpleasant to the unlearned: he that is without understanding will not remain with her."],["21",[["ὡς",714148,7],["λίθος",708196,4],["δοκιμασίας",703777,17],["ἰσχυρὸς",706855,14],["ἔσται",704093,93],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["καὶ",707031,7],["οὐ",709805,28],["χρονιεῖ",713967,127],["ἀπορρῖψαι",701563,106],["αὐτήν",702165,104]],"She will lie upon him as a mighty stone of trial; and he will cast her from him ere it be long."],["22",[["σοφία",711981,12],["γὰρ",702963,11],["κατὰ",707200,0],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτῆς",702165,86],["ἐστιν",704093,91],["καὶ",707031,7],["οὐ",709805,28],["πολλοῖς",710646,230],["ἐστιν",704093,91],["φανερά",713342,29]],"For wisdom is according to her name, and she is not manifest unto many."],["23",[["ἄκουσον",700587,176],["τέκνον",712761,297],["καὶ",707031,7],["ἔκδεξαι",704165,300],["γνώμην",703134,9],["μου",709032,133],["καὶ",707031,7],["μὴ",708851,28],["ἀπαναίνου",701342,253],["τὴν",709436,8],["συμβουλίαν",712293,9],["μου",709032,133]],"Give ear, my son, receive my advice, and refuse not my counsel,"],["24",[["καὶ",707031,7],["εἰσένεγκον",704127,176],["τοὺς",709436,58],["πόδας",710707,57],["σου",711945,133],["εἰς",704105,0],["τὰς",709436,38],["πέδας",710210,39],["αὐτῆς",702165,86],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["κλοιὸν",707741,6],["αὐτῆς",702165,86],["τὸν",709436,5],["τράχηλόν",712924,6],["σου",711945,133]],"and put thy feet into her fetters, and thy neck into her chain."],["25",[["ὑπόθες",713251,176],["τὸν",709436,5],["ὦμόν",714114,6],["σου",711945,133],["καὶ",707031,7],["βάσταξον",702594,176],["αὐτὴν",702165,104],["καὶ",707031,7],["μὴ",708851,28],["προσοχθίσῃς",710945,175],["τοῖς",709436,147],["δεσμοῖς",703372,148],["αὐτῆς",702165,86]],"Bow down thy shoulder, and bear her, and be not grieved with her bonds."],["26",[["ἐν",704639,0],["πάσῃ",710177,101],["ψυχῇ",714070,1],["σου",711945,133],["πρόσελθε",710890,176],["αὐτῇ",702165,105],["καὶ",707031,7],["ἐν",704639,0],["ὅλῃ",709597,101],["δυνάμει",703839,1],["σου",711945,133],["συντήρησον",712512,176],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτῆς",702165,86]],"Come unto her with thy whole heart, and keep her ways with all thy power."],["27",[["ἐξίχνευσον",704941,176],["καὶ",707031,7],["ζήτησον",705879,176],["καὶ",707031,7],["γνωσθήσεταί",703105,134],["σοι",711925,159],["καὶ",707031,7],["ἐγκρατὴς",703990,14],["γενόμενος",703104,248],["μὴ",708851,28],["ἀφῇς",702211,175],["αὐτήν",702165,104]],"Search, and seek, and she shall be made known unto thee: and when thou hast got hold of her, let her not go."],["28",[["ἐπ᾿",705080,0],["ἐσχάτων",705519,83],["γὰρ",702963,11],["εὑρήσεις",705676,166],["τὴν",709436,8],["ἀνάπαυσιν",701026,9],["αὐτῆς",702165,86],["καὶ",707031,7],["στραφήσεταί",712160,134],["σοι",711925,159],["εἰς",704105,0],["εὐφροσύνην",705717,9]],"For at the last thou shalt find her rest, and that shall be turned to thy joy."],["29",[["καὶ",707031,7],["ἔσονταί",704093,135],["σοι",711925,159],["αἱ",709436,190],["πέδαι",710210,191],["εἰς",704105,0],["σκέπην",711839,9],["ἰσχύος",706858,17],["καὶ",707031,7],["οἱ",709436,136],["κλοιοὶ",707741,52],["αὐτῆς",702165,86],["εἰς",704105,0],["στολὴν",712120,9],["δόξης",703791,17]],"Then shall her fetters be a strong defence for thee, and her chains a robe of glory."],["30",[["κόσμος",707851,4],["γὰρ",702963,11],["χρύσεός",713971,14],["ἐστιν",704093,91],["ἐπ᾿",705080,0],["αὐτῆς",702165,86],["καὶ",707031,7],["οἱ",709436,136],["δεσμοὶ",703372,52],["αὐτῆς",702165,86],["κλῶσμα",707748,15],["ὑακίνθινον",713047,26]],"For there is a golden ornament upon her, and her bands are purple lace."],["31",[["στολὴν",712120,9],["δόξης",703791,17],["ἐνδύσῃ",704701,123],["αὐτὴν",702165,104],["καὶ",707031,7],["στέφανον",712083,6],["ἀγαλλιάματος",700112,21],["περιθήσεις",710403,166],["σεαυτῷ",711599,50]],"Thou shalt put her on as a robe of honour, and shalt put her about thee as a crown of joy."],["32",[["ἐὰν",703912,7],["θέλῃς",706176,205],["τέκνον",712761,297],["παιδευθήσῃ",709926,364],["καὶ",707031,7],["ἐὰν",703912,7],["ἐπιδῷς",705121,175],["τὴν",709436,8],["ψυχήν",714070,9],["σου",711945,133],["πανοῦργος",709972,14],["ἔσῃ",704093,123]],"My son, if thou wilt, thou shalt be taught: and if thou wilt apply thy mind, thou shalt be prudent."],["33",[["ἐὰν",703912,7],["ἀγαπήσῃς",700120,175],["ἀκούειν",700587,55],["ἐκδέξῃ",704165,123],["καὶ",707031,7],["ἐὰν",703912,7],["κλίνῃς",707738,205],["τὸ",709436,24],["οὖς",709852,25],["σου",711945,133],["σοφὸς",711985,14],["ἔσῃ",704093,123]],"If thou love to hear, thou shalt receive understanding: and if thou bow thine ear, thou shalt be wise."],["34",[["ἐν",704639,0],["πλήθει",710529,54],["πρεσβυτέρων",710735,81],["στῆθι",706846,176],["καὶ",707031,7],["τίς",712867,158],["σοφός",711985,14],["αὐτῷ",702165,50],["προσκολλήθητι",710921,244]],"Stand in the multitude of the elders; and cleave unto him that is wise."],["35",[["πᾶσαν",710177,36],["διήγησιν",703681,9],["θείαν",706154,36],["θέλε",706176,240],["ἀκροᾶσθαι",700602,110],["καὶ",707031,7],["παροιμίαι",710160,191],["συνέσεως",712460,17],["μὴ",708851,28],["ἐκφευγέτωσάν",704357,56],["σε",711598,163]],"Be willing to hear every godly discourse: and let not the parables of understanding escape thee."],["36",[["ἐὰν",703912,7],["ἴδῃς",709725,175],["συνετόν",712464,27],["ὄρθριζε",709742,240],["πρὸς",710844,0],["αὐτόν",702165,85],["καὶ",707031,7],["βαθμοὺς",702375,57],["θυρῶν",706337,65],["αὐτοῦ",702165,102],["ἐκτριβέτω",704345,31],["ὁ",709436,3],["πούς",710707,4],["σου",711945,133]],"And if thou seest a man of understanding, get thee betimes unto him, and let thy foot wear the steps of his door."],["37",[["διανοοῦ",703528,253],["ἐν",704639,0],["τοῖς",709436,95],["προστάγμασιν",710959,96],["κυρίου",707996,18],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἐντολαῖς",704802,76],["αὐτοῦ",702165,102],["μελέτα",708698,240],["διὰ",703417,0],["παντός",710177,92],["αὐτὸς",702165,121],["στηριεῖ",712098,127],["τὴν",709436,8],["καρδίαν",707141,9],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["ἐπιθυμία",705147,12],["τῆς",709436,16],["σοφίας",711981,17],["δοθήσεταί",703654,134],["σοι",711925,159]],"Let thy mind be upon the ordinances of the Lord, and meditate continually in his commandments: he shall establish thine heart, and give thee wisdom at thine own desire."]]