[["1",[["χάριν",713735,9],["διαφόρου",703630,92],["πολλοὶ",710646,138],["ἥμαρτον",700773,150],["καὶ",707031,7],["ὁ",709436,3],["ζητῶν",705879,72],["πληθῦναι",710530,106],["ἀποστρέψει",701598,127],["ὀφθαλμόν",709870,6]],"Many have sinned for a small matter; and he that seeketh for abundance will turn his eyes away."],["2",[["ἀνὰ",700902,0],["μέσον",708768,27],["ἁρμῶν",701778,81],["λίθων",708196,81],["παγήσεται",710452,134],["πάσσαλος",710178,4],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,27],["πράσεως",710719,17],["καὶ",707031,7],["ἀγορασμοῦ",700186,18],["συντριβήσεται",712520,134],["ἁμαρτία",700775,12]],"As a nail sticketh fast between the joinings of the stones; so doth sin stick close between buying and selling."],["3",[["ἐὰν",703912,7],["μὴ",708851,28],["ἐν",704639,0],["φόβῳ",713534,114],["κυρίου",707996,18],["κρατήσῃ",707879,172],["κατὰ",707200,0],["σπουδήν",712035,9],["ἐν",704639,0],["τάχει",712750,97],["καταστραφήσεται",707444,134],["αὐτοῦ",702165,102],["ὁ",709436,3],["οἶκος",709516,4]],"Unless a man hold himself diligently in the fear of the Lord, his house shall soon be overthrown."],["4",[["ἐν",704639,0],["σείσματι",711631,54],["κοσκίνου",707846,21],["διαμένει",703517,91],["κοπρία",707827,12],["οὕτως",709859,28],["σκύβαλα",711892,64],["ἀνθρώπου",701163,18],["ἐν",704639,0],["λογισμῷ",708234,114],["αὐτοῦ",702165,102]],"As when one sifteth with a sieve, the refuse remaineth; so the filth of man in his talk."],["5",[["σκεύη",711844,64],["κεραμέως",707619,18],["δοκιμάζει",703776,91],["κάμινος",707113,4],["καὶ",707031,7],["πειρασμὸς",710226,4],["ἀνθρώπου",701163,18],["ἐν",704639,0],["διαλογισμῷ",703506,114],["αὐτοῦ",702165,102]],"The furnace proveth the potter's vessels; so the trial of man is in his reasoning."],["6",[["γεώργιον",703081,25],["ξύλου",709427,21],["ἐκφαίνει",704354,91],["ὁ",709436,3],["καρπὸς",707169,4],["αὐτοῦ",702165,102],["οὕτως",709859,28],["λόγος",708236,4],["ἐνθυμήματος",704740,21],["καρδίας",707141,17],["ἀνθρώπου",701163,18]],"The fruit declareth if the tree have been dressed; so is the utterance of a conceit in the heart of man."],["7",[["πρὸ",710747,0],["λογισμοῦ",708234,18],["μὴ",708851,28],["ἐπαινέσῃς",705000,175],["ἄνδρα",701150,6],["οὗτος",709858,121],["γὰρ",702963,11],["πειρασμὸς",710226,4],["ἀνθρώπων",701163,81]],"Praise no man before thou hearest him speak; for this is the trial of men."],["8",[["ἐὰν",703912,7],["διώκῃς",703768,205],["τὸ",709436,24],["δίκαιον",703694,46],["καταλήμψῃ",707300,123],["καὶ",707031,7],["ἐνδύσῃ",704701,123],["αὐτὸ",702165,129],["ὡς",714148,7],["ποδήρη",710577,27],["δόξης",703791,17]],"If thou followest righteousness, thou shalt obtain her, and put her on, as a glorious long robe."],["9",[["πετεινὰ",710439,195],["πρὸς",710844,0],["τὰ",709436,41],["ὅμοια",709626,68],["αὐτοῖς",702165,206],["καταλύσει",707323,127],["καὶ",707031,7],["ἀλήθεια",700656,12],["πρὸς",710844,0],["τοὺς",709436,58],["ἐργαζομένους",705383,236],["αὐτὴν",702165,104],["ἐπανήξει",705024,127]],"The birds will resort unto their like; so will truth return unto them that practise in her."],["10",[["λέων",708171,4],["θήραν",706244,9],["ἐνεδρεύει",704703,91],["οὕτως",709859,28],["ἁμαρτία",700775,12],["ἐργαζομένους",705383,236],["ἄδικα",700272,68]],"As the lion lieth in wait for the prey; so sin for them that work iniquity."],["11",[["διήγησις",703681,12],["εὐσεβοῦς",705687,116],["διὰ",703417,0],["παντὸς",710177,92],["σοφία",711981,12],["ὁ",709436,3],["δὲ",703303,11],["ἄφρων",702236,14],["ὡς",714148,7],["σελήνη",711650,12],["ἀλλοιοῦται",700694,117]],"The discourse of a godly man is always with wisdom; but a fool changeth as the moon."],["12",[["εἰς",704105,0],["μέσον",708768,27],["ἀσυνέτων",702034,169],["συντήρησον",712512,176],["καιρόν",707047,6],["εἰς",704105,0],["μέσον",708768,27],["δὲ",703303,11],["διανοουμένων",703528,299],["ἐνδελέχιζε",704679,240]],"If thou be among the indiscreet, observe the time; but be continually among men of understanding."],["13",[["διήγησις",703681,12],["μωρῶν",709110,169],["προσόχθισμα",710946,15],["καὶ",707031,7],["ὁ",709436,3],["γέλως",703032,4],["αὐτῶν",702165,40],["ἐν",704639,0],["σπατάλῃ",712002,1],["ἁμαρτίας",700775,17]],"The discourse of fools is irksome, and their sport is the wantonness of sin."],["14",[["λαλιὰ",708074,12],["πολυόρκου",710633,92],["ἀνορθώσει",701197,127],["τρίχας",706312,39],["καὶ",707031,7],["ἡ",709436,10],["μάχη",708601,12],["αὐτῶν",702165,40],["ἐμφραγμὸς",704634,4],["ὠτίων",714165,44]],"The talk of him that sweareth much maketh the hair stand upright; and their brawls make one stop his ears."],["15",[["ἔκχυσις",704370,12],["αἵματος",700442,21],["μάχη",708601,12],["ὑπερηφάνων",713139,169],["καὶ",707031,7],["ἡ",709436,10],["διαλοιδόρησις",703507,12],["αὐτῶν",702165,40],["ἀκοὴ",700561,12],["μοχθηρά",709038,29]],"The strife of the proud is bloodshedding, and their revilings are grievous to the ear."],["16",[["ὁ",709436,3],["ἀποκαλύπτων",701474,72],["μυστήρια",709080,42],["ἀπώλεσεν",701513,2],["πίστιν",710484,9],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["εὕρῃ",705676,172],["φίλον",713492,27],["πρὸς",710844,0],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102]],"Whoso discovereth secrets loseth his credit; and shall never find friend to his mind."],["17",[["στέρξον",712074,176],["φίλον",713492,27],["καὶ",707031,7],["πιστώθητι",710487,244],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἐὰν",703912,7],["δὲ",703303,11],["ἀποκαλύψῃς",701474,175],["τὰ",709436,41],["μυστήρια",709080,42],["αὐτοῦ",702165,102],["μὴ",708851,28],["καταδιώξῃς",707243,175],["ὀπίσω",709697,28],["αὐτοῦ",702165,102]],"Love thy friend, and be faithful unto him: but if thou betrayest his secrets, follow no more after him."],["18",[["καθὼς",707030,7],["γὰρ",702963,11],["ἀπώλεσεν",701513,2],["ἄνθρωπος",701163,4],["τὸν",709436,5],["νεκρὸν",709247,6],["αὐτοῦ",702165,102],["οὕτως",709859,28],["ἀπώλεσας",701513,162],["τὴν",709436,8],["φιλίαν",713474,9],["τοῦ",709436,35],["πλησίον",710547,28]],"For as a man hath destroyed his enemy; so hast thou lost the love of thy neighbour."],["19",[["καὶ",707031,7],["ὡς",714148,7],["πετεινὸν",710439,46],["ἐκ",704132,0],["χειρός",713787,17],["σου",711945,133],["ἀπέλυσας",701524,162],["οὕτως",709859,28],["ἀφῆκας",702211,162],["τὸν",709436,5],["πλησίον",710547,28],["καὶ",707031,7],["οὐ",709805,28],["θηρεύσεις",706248,127],["αὐτόν",702165,85]],"As one that letteth a bird go out of his hand, so hast thou let thy neighbour go, and shalt not get him again."],["20",[["μὴ",708851,28],["αὐτὸν",702165,85],["διώξῃς",703768,175],["ὅτι",709803,7],["μακρὰν",708411,28],["ἀπέστη",702214,2],["καὶ",707031,7],["ἐξέφυγεν",704357,2],["ὡς",714148,7],["δορκὰς",703801,12],["ἐκ",704132,0],["παγίδος",709910,17]],"Follow after him no more, for he is too far off; he is as a roe escaped out of the snare."],["21",[["ὅτι",709803,7],["τραῦμα",712920,15],["ἔστιν",704093,91],["καταδῆσαι",707239,106],["καὶ",707031,7],["λοιδορίας",708242,17],["ἔστιν",704093,91],["διαλλαγή",703501,12],["ὁ",709436,3],["δὲ",703303,11],["ἀποκαλύψας",701474,182],["μυστήρια",709080,42],["ἀφήλπισεν",701388,2]],"As for a wound, it may be bound up; and after reviling there may be reconcilement: but he that betrayeth secrets is without hope.",{"s":"d","q":0.69}],["22",[["διανεύων",703524,72],["ὀφθαλμῷ",709870,114],["τεκταίνει",712764,91],["κακά",707066,68],["καὶ",707031,7],["οὐδεὶς",709817,14],["αὐτὰ",702165,71],["ἀποστήσει",702214,127],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102]],"He that winketh with the eyes worketh evil: and he that knoweth him will depart from him."],["23",[["ἀπέναντι",701389,28],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["σου",711945,133],["γλυκανεῖ",703110,127],["τὸ",709436,34],["στόμα",712125,15],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπὶ",705080,0],["τῶν",709436,80],["λόγων",708236,81],["σου",711945,133],["ἐκθαυμάσει",704192,127],["ὕστερον",713273,28],["δὲ",703303,11],["διαστρέψει",703592,127],["τὸ",709436,24],["στόμα",712125,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["λόγοις",708236,148],["σου",711945,133],["δώσει",703654,127],["σκάνδαλον",711825,25]],"When thou art present, he will speak sweetly, and will admire thy words: but at the last he will writhe his mouth, and slander thy sayings."],["24",[["πολλὰ",710646,68],["ἐμίσησα",708935,155],["καὶ",707031,7],["οὐχ",709805,28],["ὡμοίωσα",709628,155],["αὐτῷ",702165,50],["καὶ",707031,7],["ὁ",709436,3],["κύριος",707996,4],["μισήσει",708935,127],["αὐτόν",702165,85]],"I have hated many things, but nothing like him; for the Lord will hate him."],["25",[["ὁ",709436,3],["βάλλων",702487,72],["λίθον",708196,6],["εἰς",704105,0],["ὕψος",713288,25],["ἐπὶ",705080,0],["κεφαλὴν",707639,9],["αὐτοῦ",702165,102],["βάλλει",702487,91],["καὶ",707031,7],["πληγὴ",710527,12],["δολία",703783,29],["διελεῖ",703459,127],["τραύματα",712920,42]],"Whoso casteth a stone on high casteth it on his own head; and a deceitful stroke shall make wounds."],["26",[["ὁ",709436,3],["ὀρύσσων",709775,72],["βόθρον",702749,6],["εἰς",704105,0],["αὐτὸν",702165,85],["ἐμπεσεῖται",704593,127],["καὶ",707031,7],["ὁ",709436,3],["ἱστῶν",706846,72],["παγίδα",709910,9],["ἐν",704639,0],["αὐτῇ",702165,105],["ἁλώσεται",700673,93]],"Whoso diggeth a pit shall fall therein: and he that setteth a trap shall be taken therein."],["27",[["ὁ",709436,3],["ποιῶν",710582,72],["πονηρά",710660,68],["εἰς",704105,0],["αὐτὸν",702165,85],["κυλισθήσεται",707967,134],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἐπιγνῷ",705104,172],["πόθεν",710580,28],["ἥκει",705956,91],["αὐτῷ",702165,50]],"He that worketh mischief, it shall fall upon him, and he shall not know whence it cometh."],["28",[["ἐμπαιγμὸς",704582,4],["καὶ",707031,7],["ὀνειδισμὸς",709657,4],["ὑπερηφάνῳ",713139,30],["καὶ",707031,7],["ἡ",709436,10],["ἐκδίκησις",704175,12],["ὡς",714148,7],["λέων",708171,4],["ἐνεδρεύσει",704703,127],["αὐτόν",702165,85]],"Mockery and reproach are from the proud; but vengeance, as a lion, shall lie in wait for him."],["29",[["παγίδι",709910,1],["ἁλώσονται",700673,135],["οἱ",709436,136],["εὐφραινόμενοι",705715,348],["πτώσει",711072,1],["εὐσεβῶν",705687,169],["καὶ",707031,7],["ὀδύνη",709463,12],["καταναλώσει",707338,127],["αὐτοὺς",702165,62],["πρὸ",710747,0],["τοῦ",709436,35],["θανάτου",706096,18],["αὐτῶν",702165,40]],"They that rejoice at the fall of the righteous shall be taken in the snare; and anguish shall consume them before they die."],["30",[["μῆνις",708878,12],["καὶ",707031,7],["ὀργή",709728,12],["καὶ",707031,28],["ταῦτά",709858,290],["ἐστιν",704093,91],["βδελύγματα",702604,64],["καὶ",707031,7],["ἀνὴρ",701150,4],["ἁμαρτωλὸς",700776,14],["ἐγκρατὴς",703990,14],["ἔσται",704093,93],["αὐτῶν",702165,70]],"Malice and wrath, even these are abominations; and the sinful man shall have them both."]]