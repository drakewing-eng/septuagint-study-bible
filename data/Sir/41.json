[["1",[["ὦ",714081,88],["θάνατε",706096,153],["ὡς",714148,7],["πικρόν",710475,26],["σου",711945,133],["τὸ",709436,34],["μνημόσυνόν",708966,15],["ἐστιν",704093,91],["ἀνθρώπῳ",701163,114],["εἰρηνεύοντι",704097,379],["ἐν",704639,0],["τοῖς",709436,95],["ὑπάρχουσιν",713103,94],["αὐτοῦ",702165,102],["ἀνδρὶ",701150,114],["ἀπερισπάστῳ",701396,30],["καὶ",707031,7],["εὐοδουμένῳ",705654,241],["ἐν",704639,0],["πᾶσιν",710177,94],["καὶ",707031,7],["ἔτι",705538,28],["ἰσχύοντι",706859,379],["ἐπιδέξασθαι",705117,109],["τροφήν",712984,9]],"O death, how bitter is the remembrance of thee to a man that liveth at rest in his possessions, unto the man that hath nothing to vex him, and that hath prosperity in all things: yea, unto him that is yet able to receive meat!"],["2",[["ὦ",714081,88],["θάνατε",706096,153],["καλόν",707097,26],["σου",711945,133],["τὸ",709436,34],["κρίμα",707903,15],["ἐστὶν",704093,91],["ἀνθρώπῳ",701163,114],["ἐπιδεομένῳ",705118,241],["καὶ",707031,7],["ἐλασσουμένῳ",704394,241],["ἰσχύι",706858,1],["ἐσχατογήρῳ",705517,30],["καὶ",707031,7],["περισπωμένῳ",710382,241],["περὶ",710285,0],["πάντων",710177,83],["καὶ",707031,7],["ἀπειθοῦντι",701370,379],["καὶ",707031,7],["ἀπολωλεκότι",701513,514],["ὑπομονήν",713226,9]],"O death, acceptable is thy sentence unto the needy, and unto him whose strength faileth, that is now in the last age, and is vexed with all things, and to him that despaireth, and hath lost patience!"],["3",[["μὴ",708851,28],["εὐλαβοῦ",705627,253],["κρίμα",707903,25],["θανάτου",706096,18],["μνήσθητι",708960,244],["προτέρων",710992,83],["σου",711945,133],["καὶ",707031,7],["ἐσχάτων",705519,83]],"Fear not the sentence of death, remember them that have been before thee, and that come after; for this is the sentence of the Lord over all flesh.",{"s":"d","q":0.6}],["4",[["τοῦτο",709858,132],["τὸ",709436,34],["κρίμα",707903,15],["παρὰ",709995,0],["κυρίου",707996,18],["πάσῃ",710177,101],["σαρκί",711537,1],["καὶ",707031,7],["τί",712867,126],["ἀπαναίνῃ",701342,204],["ἐν",704639,0],["εὐδοκίᾳ",705566,1],["ὑψίστου",713287,116],["εἴτε",704130,7],["δέκα",703333,59],["εἴτε",704130,7],["ἑκατὸν",704136,59],["εἴτε",704130,7],["χίλια",713859,195],["ἔτη",705543,64],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐν",704639,0],["ᾅδου",700255,18],["ἐλεγμὸς",704413,4],["ζωῆς",705910,17]],"And why art thou against the pleasure of the most High? there is no inquisition in the grave, whether thou have lived ten, or an hundred, or a thousand years."],["5",[["τέκνα",712761,64],["βδελυρὰ",702607,195],["γίνεται",703104,117],["τέκνα",712761,64],["ἁμαρτωλῶν",700776,169],["καὶ",707031,7],["συναναστρεφόμενα",712390,210],["παροικίαις",710158,76],["ἀσεβῶν",701909,169]],"The children of sinners are abominable children, and they that are conversant in the dwelling of the ungodly."],["6",[["τέκνων",712761,44],["ἁμαρτωλῶν",700776,169],["ἀπολεῖται",701513,93],["κληρονομία",707725,12],["καὶ",707031,7],["μετὰ",708780,0],["τοῦ",709436,20],["σπέρματος",712008,21],["αὐτῶν",702165,40],["ἐνδελεχιεῖ",704679,127],["ὄνειδος",709658,25]],"The inheritance of sinners' children shall perish, and from their posterity shall be a perpetual reproach."],["7",[["πατρὶ",710189,114],["ἀσεβεῖ",701909,30],["μέμψεται",708728,93],["τέκνα",712761,64],["ὅτι",709803,7],["δι᾿",703417,0],["αὐτὸν",702165,85],["ὀνειδισθήσονται",709655,144]],"The children will complain of an ungodly father, because they will be reproached for his sake."],["8",[["οὐαὶ",709807,88],["ὑμῖν",713084,90],["ἄνδρες",701150,52],["ἀσεβεῖς",701909,138],["οἵτινες",709793,450],["ἐγκατελίπετε",703967,265],["νόμον",709349,6],["θεοῦ",706192,18],["ὑψίστου",713287,116]],"Who be unto you, ungodly men, which have forsaken the law of the most high God! for if ye increase, it shall be to your destruction:"],["9",[["καὶ",707031,7],["ἐὰν",703912,7],["γεννηθῆτε",703051,394],["εἰς",704105,0],["κατάραν",707395,9],["γεννηθήσεσθε",703051,261],["καὶ",707031,7],["ἐὰν",703912,7],["ἀποθάνητε",701461,125],["εἰς",704105,0],["κατάραν",707395,9],["μερισθήσεσθε",708744,261]],"and if ye be born, ye shall be born to a curse: and if ye die, a curse shall be your portion."],["10",[["πάντα",710177,195],["ὅσα",709788,195],["ἐκ",704132,0],["γῆς",703083,17],["εἰς",704105,0],["γῆν",703083,9],["ἀπελεύσεται",701398,93],["οὕτως",709859,28],["ἀσεβεῖς",701909,138],["ἀπὸ",701425,0],["κατάρας",707395,17],["εἰς",704105,0],["ἀπώλειαν",701660,9]],"All that are of the earth shall turn to earth again: so the ungodly shall go from a curse to destruction."],["11",[["πένθος",710253,15],["ἀνθρώπων",701163,81],["ἐν",704639,0],["σώμασιν",712635,96],["αὐτῶν",702165,40],["ὄνομα",709666,25],["δὲ",703303,11],["ἁμαρτωλῶν",700776,169],["οὐκ",709805,28],["ἀγαθὸν",700106,46],["ἐξαλειφθήσεται",704852,134]],"The mourning of men is about their bodies: but an ill name of sinners shall be blotted out."],["12",[["φρόντισον",713590,176],["περὶ",710285,0],["ὀνόματος",709666,21],["αὐτὸ",702165,132],["γάρ",702963,11],["σοι",711925,159],["διαμενεῖ",703517,127],["ἢ",705924,7],["χίλιοι",713859,138],["μεγάλοι",708653,138],["θησαυροὶ",706258,52],["χρυσίου",713972,21]],"Have regard to thy name; for that shall continue with thee above a thousand great treasures of gold."],["13",[["ἀγαθῆς",700106,82],["ζωῆς",705910,17],["ἀριθμὸς",701744,4],["ἡμερῶν",705984,65],["καὶ",707031,7],["ἀγαθὸν",700106,26],["ὄνομα",709666,15],["εἰς",704105,0],["αἰῶνα",700504,6],["διαμενεῖ",703517,127]],"A good life hath but few days: but a good name endureth for ever."],["14",[["παιδείαν",709924,9],["ἐν",704639,0],["εἰρήνῃ",704098,1],["συντηρήσατε",712512,74],["τέκνα",712761,589],["σοφία",711981,12],["δὲ",703303,11],["κεκρυμμένη",707923,203],["καὶ",707031,7],["θησαυρὸς",706258,4],["ἀφανής",702181,14],["τίς",712867,359],["ὠφέλεια",714170,12],["ἐν",704639,0],["ἀμφοτέροις",700892,230]],"My children, keep discipline in peace: for wisdom that is hid, and a treasure that is not seen, what profit is in them both?"],["15",[["κρείσσων",707891,14],["ἄνθρωπος",701163,4],["ἀποκρύπτων",701495,72],["τὴν",709436,8],["μωρίαν",709109,9],["αὐτοῦ",702165,102],["ἢ",705924,7],["ἄνθρωπος",701163,4],["ἀποκρύπτων",701495,72],["τὴν",709436,8],["σοφίαν",711981,9],["αὐτοῦ",702165,102]],"A man that hideth his foolishness is better than a man that hideth his wisdom."],["16",[["τοιγαροῦν",712874,11],["ἐντράπητε",704805,125],["ἐπὶ",705080,0],["τῷ",709436,53],["ῥήματί",711246,54],["μου",709032,133],["οὐ",709805,28],["γάρ",702963,11],["ἐστιν",704093,91],["πᾶσαν",710177,36],["αἰσχύνην",700483,9],["διαφυλάξαι",703632,106],["καλόν",707097,26],["καὶ",707031,7],["οὐ",709805,28],["πάντα",710177,195],["πᾶσιν",710177,230],["ἐν",704639,0],["πίστει",710484,1],["εὐδοκιμεῖται",705567,117]],"Therefore be shamefaced according to my word: for it is not good to retain all shamefacedness; neither is it altogether approved in every thing."],["17",[["αἰσχύνεσθε",700485,73],["ἀπὸ",701425,0],["πατρὸς",710189,18],["καὶ",707031,7],["μητρὸς",708892,17],["περὶ",710285,0],["πορνείας",710672,17],["καὶ",707031,7],["ἀπὸ",701425,0],["ἡγουμένου",705931,262],["καὶ",707031,7],["δυνάστου",703844,18],["περὶ",710285,0],["ψεύδους",714036,116]],"Be ashamed of whoredom before father and mother: and of a lie before a prince and a mighty man;"],["18",[["ἀπὸ",701425,0],["κριτοῦ",707910,18],["καὶ",707031,7],["ἄρχοντος",701862,18],["περὶ",710285,0],["πλημμελείας",710533,17],["καὶ",707031,7],["ἀπὸ",701425,0],["συναγωγῆς",712376,17],["καὶ",707031,7],["λαοῦ",708094,18],["περὶ",710285,0],["ἀνομίας",701192,17]],"of an offence before a judge and ruler; of iniquity before a congregation and people; of unjust dealing before thy partner and friend;",{"s":"d","q":0.52}],["19",[["ἀπὸ",701425,0],["κοινωνοῦ",707777,18],["καὶ",707031,7],["φίλου",713492,116],["περὶ",710285,0],["ἀδικίας",700271,17],["καὶ",707031,7],["ἀπὸ",701425,0],["τόπου",712903,18],["οὗ",709806,28],["παροικεῖς",710156,154],["περὶ",710285,0],["κλοπῆς",707742,17]],null,{"s":"j","with":"41:18"}],["20",[["ἀπὸ",701425,0],["ἀληθείας",700656,17],["θεοῦ",706192,18],["καὶ",707031,7],["διαθήκης",703456,17],["καὶ",707031,7],["ἀπὸ",701425,0],["πήξεως",710459,17],["ἀγκῶνος",700166,18],["ἐπ᾿",705080,0],["ἄρτοις",701829,148]],"and of silence before them that salute thee; and to look upon an harlot;",{"s":"d","q":0.3}],["21",[["ἀπὸ",701425,0],["σκορακισμοῦ",711878,18],["λήμψεως",708183,17],["καὶ",707031,7],["δόσεως",703809,17],["καὶ",707031,7],["ἀπὸ",701425,0],["ἀσπαζομένων",701987,299],["περὶ",710285,0],["σιωπῆς",711819,17]],null,{"s":"j","with":"41:23"}],["22",[["ἀπὸ",701425,0],["ὁράσεως",709721,17],["γυναικὸς",703209,17],["ἑταίρας",705527,17],["καὶ",707031,7],["ἀπὸ",701425,0],["ἀποστροφῆς",701599,17],["προσώπου",710986,21],["συγγενοῦς",712185,92]],null,{"s":"h"}],["23",[["ἀπὸ",701425,0],["ἀφαιρέσεως",702176,17],["μερίδος",708748,17],["καὶ",707031,7],["δόσεως",703809,17],["καὶ",707031,7],["ἀπὸ",701425,0],["κατανοήσεως",707342,17],["γυναικὸς",703209,17],["ὑπάνδρου",713097,82]],"and to turn away thy face from thy kinsman; or to take away a portion or a gift; or to gaze upon another man's wife;",{"s":"m","br":"41:21","q":0.67,"gd":0.67}],["24",[["ἀπὸ",701425,0],["περιεργίας",710313,17],["παιδίσκης",709928,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["μὴ",708851,28],["ἐπιστῇς",705756,175],["ἐπὶ",705080,0],["τὴν",709436,8],["κοίτην",707781,9],["αὐτῆς",702165,86]],"or to be overbusy with his maid, and come not near her bed; or of upbraiding speeches before friends; and after thou hast given, upbraid not;",{"s":"m","br":"41:22","q":0.5,"gd":0.5}],["25",[["ἀπὸ",701425,0],["φίλων",713492,169],["περὶ",710285,0],["λόγων",708236,81],["ὀνειδισμοῦ",709657,18],["καὶ",707031,7],["μετὰ",708780,0],["τὸ",709436,24],["δοῦναι",703654,106],["μὴ",708851,28],["ὀνείδιζε",709655,240]],null,{"s":"j","with":"41:24"}],["26",[["ἀπὸ",701425,0],["δευτερώσεως",703391,17],["καὶ",707031,7],["λόγου",708236,18],["ἀκοῆς",700561,17],["καὶ",707031,7],["ἀπὸ",701425,0],["καλύψεως",707103,17],["λόγων",708236,81],["κρυφίων",707930,169]],"Or of iterating and speaking again that which thou hast heard; 