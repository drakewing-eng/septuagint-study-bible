[["1",[["ἐλέησον",704418,176],["ἡμᾶς",705981,194],["δέσποτα",703379,153],["ὁ",709436,3],["θεὸς",706192,4],["πάντων",710177,169],["καὶ",707031,7],["ἐπίβλεψον",705088,176],["καὶ",707031,7],["ἐπίβαλε",705083,176],["τὸν",709436,5],["φόβον",713534,6],["σου",711945,133],["ἐπὶ",705080,0],["πάντα",710177,68],["τὰ",709436,41],["ἔθνη",704068,42]],"There shall no evil happen unto him that feareth the Lord; but in temptation even again he will deliver him."],["2",[["ἔπαρον",705002,176],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133],["ἐπὶ",705080,0],["ἔθνη",704068,42],["ἀλλότρια",700699,68],["καὶ",707031,7],["ἰδέτωσαν",709725,264],["τὴν",709436,8],["δυναστείαν",703841,9],["σου",711945,133]],"A wise man hateth not the law; but he that is an hypocrite therein is as a ship in a storm."],["3",[["ὥσπερ",714163,28],["ἐνώπιον",704823,0],["αὐτῶν",702165,40],["ἡγιάσθης",700153,168],["ἐν",704639,0],["ἡμῖν",705994,90],["οὕτως",709859,28],["ἐνώπιον",704823,0],["ἡμῶν",705999,145],["μεγαλυνθείης",708647,716],["ἐν",704639,0],["αὐτοῖς",702165,151]],"A man of understanding trusteth in the law; and the law is faithful unto him, as an oracle."],["4",[["καὶ",707031,7],["ἐπιγνώτωσάν",705104,264],["σε",711598,163],["καθάπερ",706984,28],["καὶ",707031,7],["ἡμεῖς",705983,219],["ἐπέγνωμεν",705104,289],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["θεὸς",706192,4],["πλὴν",710540,28],["σοῦ",711945,133],["κύριε",707996,153]],"Prepare what to say, and so thou shalt be heard: and bind up instruction, and then make answer."],["5",[["ἐγκαίνισον",703956,176],["σημεῖα",711748,42],["καὶ",707031,7],["ἀλλοίωσον",700694,176],["θαυμάσια",706136,68],["δόξασον",703792,176],["χεῖρα",713787,9],["καὶ",707031,7],["βραχίονα",702808,6],["δεξιόν",703360,27]],"The heart of the foolish is like a cartwheel; and his thoughts are like a rolling axle-tree."],["6",[["ἔγειρον",703949,176],["θυμὸν",706334,6],["καὶ",707031,7],["ἔκχεον",704368,176],["ὀργήν",709728,9],["ἔξαρον",704839,176],["ἀντίδικον",701233,46],["καὶ",707031,7],["ἔκτριψον",704345,176],["ἐχθρόν",705779,27]],"A stallion horse is as a mocking friend, he neigheth under every one that sitteth upon him."],["7",[["σπεῦσον",712011,176],["καιρὸν",707047,6],["καὶ",707031,7],["μνήσθητι",708960,244],["ὁρκισμοῦ",709752,18],["καὶ",707031,7],["ἐκδιηγησάσθωσαν",704172,486],["τὰ",709436,41],["μεγαλεῖά",708625,68],["σου",711945,133]],"Why doth one day excel another, when as all the light of every day in the year is of the sun?"],["8",[["ἐν",704639,0],["ὀργῇ",709728,1],["πυρὸς",711088,21],["καταβρωθήτω",707209,22],["ὁ",709436,3],["σῳζόμενος",712627,122],["καὶ",707031,7],["οἱ",709436,136],["κακοῦντες",707073,146],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133],["εὕροισαν",705676,396],["ἀπώλειαν",701660,9]],"By the knowledge of the Lord they were distinguished: and he altered seasons and feasts."],["9",[["σύντριψον",712520,176],["κεφαλὰς",707639,39],["ἀρχόντων",701862,81],["ἐχθρῶν",705779,169],["λεγόντων",708124,170],["οὐκ",709805,28],["ἔστιν",704093,91],["πλὴν",710540,28],["ἡμῶν",705999,145]],"Some of them hath he made high days, and hallowed [them], and some of them hath he made ordinary days."],["10",[["συνάγαγε",712375,176],["πάσας",710177,119],["φυλὰς",713620,39],["Ιακωβ",706401,18],["καὶ",707031,7],["κατακληρονόμησον",707274,176],["αὐτοὺς",702165,62],["καθὼς",707030,7],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17]],"And all men are from the ground, and Adam was created of earth."],["11",[["ἐλέησον",704418,176],["λαόν",708094,6],["κύριε",707996,153],["κεκλημένον",707084,439],["ἐπ᾿",705080,0],["ὀνόματί",709666,54],["σου",711945,133],["καὶ",707031,7],["Ισραηλ",706839,6],["ὃν",709781,112],["πρωτογόνῳ",711035,30],["ὡμοίωσας",709628,162]],"In much knowledge the Lord hath divided them, and made their ways diverse."],["12",[["οἰκτίρησον",709518,176],["πόλιν",710612,9],["ἁγιάσματός",700154,21],["σου",711945,133],["Ιερουσαλημ",706644,227],["τόπον",712903,6],["καταπαύματός",707363,21],["σου",711945,133]],"Some of them hath he blessed and exalted, and some of them hath he sanctified, and set near himself: but some of them hath he cursed and brought low, and turned out of their places."],["13",[["πλῆσον",710532,176],["Σιων",711816,227],["ἀρεταλογίας",701725,39],["σου",711945,133],["καὶ",707031,7],["ἀπὸ",701425,0],["τῆς",709436,16],["δόξης",703791,17],["σου",711945,133],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133]],"As the clay is in the potter's hand, to fashion it at his pleasure: so man is in the hand of him that made him, to render to them as liketh him best."],["14",[["δὸς",703654,176],["μαρτύριον",708525,25],["τοῖς",709436,147],["ἐν",704639,0],["ἀρχῇ",701836,1],["κτίσμασίν",707940,96],["σου",711945,133],["καὶ",707031,7],["ἔγειρον",703949,176],["προφητείας",711007,39],["τὰς",709436,38],["ἐπ᾿",705080,0],["ὀνόματί",709666,54],["σου",711945,133]],"Good is set against evil, and life against death: so is the godly against the sinner, and the sinner against the godly."],["15",[["δὸς",703654,176],["μισθὸν",708939,6],["τοῖς",709436,147],["ὑπομένουσίν",713219,349],["σε",711598,163],["καὶ",707031,7],["οἱ",709436,136],["προφῆταί",711009,52],["σου",711945,133],["ἐμπιστευθήτωσαν",704594,51]],"So look upon all the works of the most High; and there are two and two, one against another."],["16",[["εἰσάκουσον",704108,176],["κύριε",707996,153],["δεήσεως",703311,17],["τῶν",709436,80],["ἱκετῶν",706718,81],["σου",711945,133],["κατὰ",707200,0],["τὴν",709436,8],["εὐλογίαν",705633,9],["Ααρων",700005,18],["περὶ",710285,0],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133]],"Though I was the last to wake up, yet I received their inheritance as from the beginning."],["17",[["καὶ",707031,7],["γνώσονται",703105,135],["πάντες",710177,138],["οἱ",709436,136],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ὅτι",709803,7],["κύριος",707996,4],["εἶ",704093,154],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,80],["αἰώνων",700504,81]],"O Lord have mercy upon the people that is called by thy name, and upon Israel, whom thou hast named thy firstborn."],["18",[["πᾶν",710177,46],["βρῶμα",702823,25],["φάγεται",713296,93],["κοιλία",707761,12],["ἔστιν",704093,91],["δὲ",703303,11],["βρῶμα",702823,15],["βρώματος",702823,21],["κάλλιον",707088,26]],"O be merciful unto Jerusalem, thy holy city, the place of thy rest."],["19",[["φάρυγξ",713375,12],["γεύεται",703074,117],["βρώματα",702823,42],["θήρας",706244,17],["οὕτως",709859,28],["καρδία",707141,12],["συνετὴ",712464,29],["λόγους",708236,57],["ψευδεῖς",714036,60]],"Fill Sion with thine unspeakable oracles, and thy people with thy glory."],["20",[["καρδία",707141,12],["στρεβλὴ",712154,29],["δώσει",703654,127],["λύπην",708273,9],["καὶ",707031,7],["ἄνθρωπος",701163,4],["πολύπειρος",710637,14],["ἀνταποδώσει",701215,127],["αὐτῷ",702165,50]],"Give testimony unto those that thou hast possessed from the beginning, and raise up prophets that have been in thy name."],["21",[["πάντα",710177,27],["ἄρρενα",701818,27],["ἐπιδέξεται",705117,93],["γυνή",703209,12],["ἔστιν",704093,91],["δὲ",703303,11],["θυγάτηρ",706320,12],["θυγατρὸς",706320,17],["κρείσσων",707891,14]],"Reward them that wait for thee, and let thy prophets be found faithful."],["22",[["κάλλος",707093,15],["γυναικὸς",703209,17],["ἱλαρύνει",706726,91],["πρόσωπον",710986,25],["καὶ",707031,7],["ὑπὲρ",713111,0],["πᾶσαν",710177,36],["ἐπιθυμίαν",705147,9],["ἀνθρώπου",701163,18],["ὑπεράγει",713114,91]],"O Lord, hear the prayer of thy servants, according to the blessing of Aaron over thy people, that all they which dwell upon the earth may know that thou art the Lord, the eternal God."],["23",[["εἰ",704071,7],["ἔστιν",704093,91],["ἐπὶ",705080,0],["γλώσσης",703120,17],["αὐτῆς",702165,86],["ἔλεος",704426,15],["καὶ",707031,7],["πραΰτης",710726,12],["οὐκ",709805,28],["ἔστιν",704093,91],["ὁ",709436,3],["ἀνὴρ",701150,4],["αὐτῆς",702165,86],["καθ᾿",707200,0],["υἱοὺς",713075,57],["ἀνθρώπων",701163,81]],"The belly devoureth all meats, yet is one meat better than another."],["24",[["ὁ",709436,3],["κτώμενος",707932,122],["γυναῖκα",703209,9],["ἐνάρχεται",704664,117],["κτήσεως",707937,17],["βοηθὸν",702748,6],["κατ᾿",707200,0],["αὐτὸν",702165,85],["καὶ",707031,7],["στῦλον",712179,6],["ἀναπαύσεως",701026,17]],"As the palate tasteth divers kinds of venison: so doth an heart of understanding false speeches."],["25",[["οὗ",709806,28],["οὐκ",709805,28],["ἔστιν",704093,91],["φραγμός",713572,4],["διαρπαγήσεται",703562,134],["κτῆμα",707933,15],["καὶ",707031,7],["οὗ",709806,28],["οὐκ",709805,28],["ἔστιν",704093,91],["γυνή",703209,12],["στενάξει",712066,127],["πλανώμενος",710495,122]],"A froward heart causeth heaviness: but a man of experience will recompense him."],["26",[["τίς",712867,158],["γὰρ",702963,11],["πιστεύσει",710483,127],["εὐζώνῳ",705581,30],["λῃστῇ",708181,114],["ἀφαλλομένῳ",702180,241],["ἐκ",704132,0],["πόλεως",710612,17],["εἰς",704105,0],["πόλιν",710612,9]],"A woman will receive every man, yet is one daughter better than another."],["27",[["οὕτως",709859,28],["ἀνθρώπῳ",701163,114],["μὴ",708851,28],["ἔχοντι",705785,379],["νοσσιὰν",709360,9],["καὶ",707031,7],["καταλύοντι",707323,379],["οὗ",709806,28],["ἐὰν",703912,7],["ὀψίσῃ",709898,172]],"The beauty of a woman cheereth the countenance, and a man loveth nothing better."]]