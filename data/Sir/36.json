21],["σου",711945,133]],"O be merciful unto Jerusalem, thy holy city, the place of thy rest.",{"s":"m","br":"36:18","q":0.75}],["13",[["πλῆσον",710532,176],["Σιων",711816,227],["ἀρεταλογίας",701725,39],["σου",711945,133],["καὶ",707031,7],["ἀπὸ",701425,0],["τῆς",709436,16],["δόξης",703791,17],["σου",711945,133],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133]],"Fill Sion with thine unspeakable oracles, and thy people with thy glory.",{"s":"m","br":"36:19","q":0.79}],["14",[["δὸς",703654,176],["μαρτύριον",708525,25],["τοῖς",709436,147],["ἐν",704639,0],["ἀρχῇ",701836,1],["κτίσμασίν",707940,96],["σου",711945,133],["καὶ",707031,7],["ἔγειρον",703949,176],["προφητείας",711007,39],["τὰς",709436,38],["ἐπ᾿",705080,0],["ὀνόματί",709666,54],["σου",711945,133]],"Give testimony unto those that thou hast possessed from the beginning, and raise up prophets that have been in thy name.",{"s":"m","br":"36:20","q":1.0}],["15",[["δὸς",703654,176],["μισθὸν",708939,6],["τοῖς",709436,147],["ὑπομένουσίν",713219,349],["σε",711598,163],["καὶ",707031,7],["οἱ",709436,136],["προφῆταί",711009,52],["σου",711945,133],["ἐμπιστευθήτωσαν",704594,51]],"Reward them that wait for thee, and let thy prophets be found faithful.",{"s":"m","br":"36:21","q":1.0}],["16",[["εἰσάκουσον",704108,176],["κύριε",707996,153],["δεήσεως",703311,17],["τῶν",709436,80],["ἱκετῶν",706718,81],["σου",711945,133],["κατὰ",707200,0],["τὴν",709436,8],["εὐλογίαν",705633,9],["Ααρων",700005,18],["περὶ",710285,0],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133]],null,{"s":"h"}],["17",[["καὶ",707031,7],["γνώσονται",703105,135],["πάντες",710177,138],["οἱ",709436,136],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ὅτι",709803,7],["κύριος",707996,4],["εἶ",704093,154],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,80],["αἰώνων",700504,81]],null,{"s":"h"}],["18",[["πᾶν",710177,46],["βρῶμα",702823,25],["φάγεται",713296,93],["κοιλία",707761,12],["ἔστιν",704093,91],["δὲ",703303,11],["βρῶμα",702823,15],["βρώματος",702823,21],["κάλλιον",707088,26]],"The belly devoureth all meats, yet is one meat better than another.",{"s":"m","br":"36:23","q":0.89}],["19",[["φάρυγξ",713375,12],["γεύεται",703074,117],["βρώματα",702823,42],["θήρας",706244,17],["οὕτως",709859,28],["καρδία",707141,12],["συνετὴ",712464,29],["λόγους",708236,57],["ψευδεῖς",714036,60]],"As the palate tasteth divers kinds of venison: so doth an heart of understanding false speeches.",{"s":"m","br":"36:24","q":1.0}],["20",[["καρδία",707141,12],["στρεβλὴ",712154,29],["δώσει",703654,127],["λύπην",708273,9],["καὶ",707031,7],["ἄνθρωπος",701163,4],["πολύπειρος",710637,14],["ἀνταποδώσει",701215,127],["αὐτῷ",702165,50]],"A froward heart causeth heaviness: but a man of experience will recompense him.",{"s":"m","br":"36:25","q":1.0}],["21",[["πάντα",710177,27],["ἄρρενα",701818,27],["ἐπιδέξεται",705117,93],["γυνή",703209,12],["ἔστιν",704093,91],["δὲ",703303,11],["θυγάτηρ",706320,12],["θυγατρὸς",706320,17],["κρείσσων",707891,14]],"A woman will receive every man, yet is one daughter better than another.",{"s":"m","br":"36:26","q":0.89}],["22",[["κάλλος",707093,15],["γυναικὸς",703209,17],["ἱλαρύνει",706726,91],["πρόσωπον",710986,25],["καὶ",707031,7],["ὑπὲρ",713111,0],["πᾶσαν",710177,36],["ἐπιθυμίαν",705147,9],["ἀνθρώπου",701163,18],["ὑπεράγει",713114,91]],"The beauty of a woman cheereth the countenance, and a man loveth nothing better.",{"s":"m","br":"36:27","q":1.0}],["23",[["εἰ",704071,7],["ἔστιν",704093,91],["ἐπὶ",705080,0],["γλώσσης",703120,17],["αὐτῆς",702165,86],["ἔλεος",704426,15],["καὶ",707031,7],["πραΰτης",710726,12],["οὐκ",709805,28],["ἔστιν",704093,91],["ὁ",709436,3],["ἀνὴρ",701150,4],["αὐτῆς",702165,86],["καθ᾿",707200,0],["υἱοὺς",713075,57],["ἀνθρώπων",701163,81]],"If there be kindness, meekness, and comfort, in her tongue, then is not her husband like other men.",{"s":"m","br":"36:28","q":1.0}],["24",[["ὁ",709436,3],["κτώμενος",707932,122],["γυναῖκα",703209,9],["ἐνάρχεται",704664,117],["κτήσεως",707937,17],["βοηθὸν",702748,6],["κατ᾿",707200,0],["αὐτὸν",702165,85],["καὶ",707031,7],["στῦλον",712179,6],["ἀναπαύσεως",701026,17]],"He that getteth a wife beginneth a possession, a help like unto himself, and a pillar of rest.",{"s":"m","br":"36:29","q":1.0}],["25",[["οὗ",709806,28],["οὐκ",709805,28],["ἔστιν",704093,91],["φραγμός",713572,4],["διαρπαγήσεται",703562,134],["κτῆμα",707933,15],["καὶ",707031,7],["οὗ",709806,28],["οὐκ",709805,28],["ἔστιν",704093,91],["γυνή",703209,12],["στενάξει",712066,127],["πλανώμενος",710495,122]],"Where no hedge is, there the possession is spoiled: and he that hath no wife will wander up and down mourning.",{"s":"m","br":"36:30","q":0.85}],["26",[["τίς",712867,158],["γὰρ",702963,11],["πιστεύσει",710483,127],["εὐζώνῳ",705581,30],["λῃστῇ",708181,114],["ἀφαλλομένῳ",702180,241],["ἐκ",704132,0],["πόλεως",710612,17],["εἰς",704105,0],["πόλιν",710612,9]],null,{"s":"h"}],["27",[["οὕτως",709859,28],["ἀνθρώπῳ",701163,114],["μὴ",708851,28],["ἔχοντι",705785,379],["νοσσιὰν",709360,9],["καὶ",707031,7],["καταλύοντι",707323,379],["οὗ",709806,28],["ἐὰν",703912,7],["ὀψίσῃ",709898,172]],"Who will trust a thief well appointed, that skippeth from city to city? so [who will believe] a man that hath no house, and lodgeth wheresoever the night taketh him?",{"s":"m","br":"36:31","q":0.5,"gd":0.53}]]