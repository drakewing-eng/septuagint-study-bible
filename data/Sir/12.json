[["1",[["ἐὰν",703912,7],["εὖ",705544,28],["ποιῇς",710582,205],["γνῶθι",703105,176],["τίνι",712867,435],["ποιεῖς",710582,154],["καὶ",707031,7],["ἔσται",704093,93],["χάρις",713735,12],["τοῖς",709436,95],["ἀγαθοῖς",700106,94],["σου",711945,133]],"When thou wilt do good, know to whom thou doest it; so shalt thou be thanked for thy benefits."],["2",[["εὖ",705544,28],["ποίησον",710582,176],["εὐσεβεῖ",705687,30],["καὶ",707031,7],["εὑρήσεις",705676,166],["ἀνταπόδομα",701216,25],["καὶ",707031,7],["εἰ",704071,7],["μὴ",708851,28],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["ἀλλὰ",700680,7],["παρὰ",709995,0],["τοῦ",709436,35],["ὑψίστου",713287,116]],"Do good to the godly man, and thou shalt find a recompence; and if not from him, yet from the most High."],["3",[["οὐκ",709805,28],["ἔσται",704093,93],["ἀγαθὰ",700106,195],["τῷ",709436,113],["ἐνδελεχίζοντι",704679,379],["εἰς",704105,0],["κακὰ",707066,68],["καὶ",707031,7],["τῷ",709436,113],["ἐλεημοσύνην",704421,9],["μὴ",708851,28],["χαριζομένῳ",713734,241]],"There can no good come to him that is always occupied in evil, nor to him that giveth no alms."],["4",[["δὸς",703654,176],["τῷ",709436,113],["εὐσεβεῖ",705687,30],["καὶ",707031,7],["μὴ",708851,28],["ἀντιλάβῃ",701243,172],["τοῦ",709436,35],["ἁμαρτωλοῦ",700776,116]],"Give to the godly man, and help not a sinner."],["5",[["εὖ",705544,28],["ποίησον",710582,176],["ταπεινῷ",712714,30],["καὶ",707031,7],["μὴ",708851,28],["δῷς",703654,175],["ἀσεβεῖ",701909,30],["ἐμπόδισον",704604,176],["τοὺς",709436,58],["ἄρτους",701829,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["μὴ",708851,28],["δῷς",703654,175],["αὐτῷ",702165,50],["ἵνα",706747,7],["μὴ",708851,28],["ἐν",704639,0],["αὐτοῖς",702165,151],["σε",711598,163],["δυναστεύσῃ",703843,172],["διπλάσια",703738,68],["γὰρ",702963,11],["κακὰ",707066,68],["εὑρήσεις",705676,166],["ἐν",704639,0],["πᾶσιν",710177,94],["ἀγαθοῖς",700106,94],["οἷς",709781,295],["ἂν",700900,11],["ποιήσῃς",710582,175],["αὐτῷ",702165,50]],"Do well unto him that is lowly, but give not to the ungodly: hold back thy bread, and give it not unto him, lest he overmaster thee thereby: for [else] thou shalt receive twice as much evil for all the good thou shalt have done unto him."],["6",[["ὅτι",709803,7],["καὶ",707031,28],["ὁ",709436,3],["ὕψιστος",713287,14],["ἐμίσησεν",708935,2],["ἁμαρτωλοὺς",700776,60],["καὶ",707031,7],["τοῖς",709436,147],["ἀσεβέσιν",701909,230],["ἀποδώσει",701449,127],["ἐκδίκησιν",704175,9]],"For the most High hateth sinners, and will repay vengeance unto the ungodly, and keepeth them against the mighty day of their punishment."],["7",[["δὸς",703654,176],["τῷ",709436,113],["ἀγαθῷ",700106,30],["καὶ",707031,7],["μὴ",708851,28],["ἀντιλάβῃ",701243,172],["τοῦ",709436,35],["ἁμαρτωλοῦ",700776,116]],"Give unto the good, and help not the sinner."],["8",[["οὐκ",709805,28],["ἐκδικηθήσεται",704174,134],["ἐν",704639,0],["ἀγαθοῖς",700106,230],["ὁ",709436,3],["φίλος",713492,14],["καὶ",707031,7],["οὐ",709805,28],["κρυβήσεται",707923,134],["ἐν",704639,0],["κακοῖς",707066,94],["ὁ",709436,3],["ἐχθρός",705779,14]],"A friend cannot be known in prosperity: and an enemy cannot be hidden in adversity."],["9",[["ἐν",704639,0],["ἀγαθοῖς",700106,94],["ἀνδρὸς",701150,18],["οἱ",709436,136],["ἐχθροὶ",705779,138],["αὐτοῦ",702165,102],["ἐν",704639,0],["λύπῃ",708273,1],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["κακοῖς",707066,230],["αὐτοῦ",702165,102],["καὶ",707031,28],["ὁ",709436,3],["φίλος",713492,14],["διαχωρισθήσεται",703640,134]],"In the prosperity of a man enemies will be grieved: but in his adversity even a friend will depart."],["10",[["μὴ",708851,28],["πιστεύσῃς",710483,175],["τῷ",709436,113],["ἐχθρῷ",705779,30],["σου",711945,133],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ὡς",714148,7],["γὰρ",702963,11],["ὁ",709436,3],["χαλκὸς",713695,4],["ἰοῦται",706759,117],["οὕτως",709859,28],["ἡ",709436,10],["πονηρία",710659,12],["αὐτοῦ",702165,102]],"Never trust thine enemy: for like as iron rusteth, so is his wickedness."],["11",[["καὶ",707031,7],["ἐὰν",703912,7],["ταπεινωθῇ",712717,384],["καὶ",707031,7],["πορεύηται",710667,428],["συγκεκυφώς",712240,270],["ἐπίστησον",705756,176],["τὴν",709436,8],["ψυχήν",714070,9],["σου",711945,133],["καὶ",707031,7],["φύλαξαι",713619,300],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔσῃ",704093,123],["αὐτῷ",702165,50],["ὡς",714148,7],["ἐκμεμαχὼς",704257,270],["ἔσοπτρον",705499,25],["καὶ",707031,7],["γνώσῃ",703105,123],["ὅτι",709803,7],["οὐκ",709805,28],["εἰς",704105,0],["τέλος",712787,25],["κατίωσεν",707530,2]],"Though he humble himself, and go crouching, yet take good heed and beware of him, and thou shalt be unto him as if thou hadst wiped a looking-glass, and thou shalt know that his rust hath not been altogether wiped away."],["12",[["μὴ",708851,28],["στήσῃς",706846,175],["αὐτὸν",702165,85],["παρὰ",709995,0],["σεαυτῷ",711599,50],["μὴ",708851,28],["ἀνατρέψας",701073,182],["σε",711598,163],["στῇ",706846,172],["ἐπὶ",705080,0],["τὸν",709436,5],["τόπον",712903,6],["σου",711945,133],["μὴ",708851,28],["καθίσῃς",707006,175],["αὐτὸν",702165,85],["ἐκ",704132,0],["δεξιῶν",703360,169],["σου",711945,133],["μήποτε",708882,28],["ζητήσῃ",705879,172],["τὴν",709436,8],["καθέδραν",706992,9],["σου",711945,133],["καὶ",707031,7],["ἐπ᾿",705080,0],["ἐσχάτων",705519,83],["ἐπιγνώσῃ",705104,123],["τοὺς",709436,58],["λόγους",708236,57],["μου",709032,133],["καὶ",707031,7],["ἐπὶ",705080,0],["τῶν",709436,43],["ῥημάτων",711246,44],["μου",709032,133],["κατανυγήσῃ",707347,123]],"Set him not by thee, lest, when he hath overthrown thee, he stand up in thy place; neither let him sit at thy right hand, lest he seek to take thy seat, and thou at the last remember my words, and be pricked therewith."],["13",[["τίς",712867,158],["ἐλεήσει",704418,127],["ἐπαοιδὸν",705035,6],["ὀφιόδηκτον",709873,27],["καὶ",707031,7],["πάντας",710177,60],["τοὺς",709436,58],["προσάγοντας",710848,235],["θηρίοις",706252,96]],"Who will pity a charmer that is bitten with a serpent, or any such as come nigh wild beasts?"],["14",[["οὕτως",709859,28],["τὸν",709436,5],["προσπορευόμενον",710954,212],["ἀνδρὶ",701150,114],["ἁμαρτωλῷ",700776,30],["καὶ",707031,7],["συμφυρόμενον",712363,183],["ἐν",704639,0],["ταῖς",709436,75],["ἁμαρτίαις",700775,76],["αὐτοῦ",702165,102]],"So one that goeth to a sinner, and is defiled with him in his sins, who will pity?"],["15",[["ὥραν",714128,9],["μετὰ",708780,0],["σοῦ",711945,133],["διαμενεῖ",703517,127],["καὶ",707031,7],["ἐὰν",703912,7],["ἐκκλίνῃς",704220,205],["οὐ",709805,28],["μὴ",708851,28],["καρτερήσῃ",707178,172]],"For a while he will abide with thee, but if thou begin to fall, he will not tarry."],["16",[["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["χείλεσιν",713781,96],["αὐτοῦ",702165,102],["γλυκανεῖ",703110,127],["ὁ",709436,3],["ἐχθρὸς",705779,14],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["καρδίᾳ",707141,1],["αὐτοῦ",702165,102],["βουλεύσεται",702791,93],["ἀνατρέψαι",701073,106],["σε",711598,163],["εἰς",704105,0],["βόθρον",702749,6],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["αὐτοῦ",702165,102],["δακρύσει",703256,127],["ὁ",709436,3],["ἐχθρός",705779,14],["καὶ",707031,7],["ἐὰν",703912,7],["εὕρῃ",705676,172],["καιρόν",707047,6],["οὐκ",709805,28],["ἐμπλησθήσεται",704592,134],["ἀφ᾿",701425,0],["αἵματος",700442,21]],"An enemy speaketh sweetly with his lips, but in his heart he imagineth how to throw thee into a pit: he will weep with his eyes, but if he find opportunity, he will not be satisfied with blood."],["17",[["κακὰ",707066,195],["ἐὰν",703912,7],["ὑπαντήσῃ",713098,172],["σοι",711925,159],["εὑρήσεις",705676,166],["αὐτὸν",702165,85],["πρότερον",710991,28],["ἐκεῖ",704181,28],["σου",711945,133],["καὶ",707031,7],["ὡς",714148,7],["βοηθῶν",702748,81],["ὑποσχάσει",713248,127],["πτέρναν",711050,9],["σου",711945,133]],"If adversity come upon thee, thou shalt find him there first; and though he pretend to help thee, yet shall he undermine thee."],["18",[["τὴν",709436,8],["κεφαλὴν",707639,9],["αὐτοῦ",702165,102],["κινήσει",707679,127],["καὶ",707031,7],["ἐπικροτήσει",705180,127],["ταῖς",709436,75],["χερσὶν",713787,76],["αὐτοῦ",702165,102],["καὶ",707031,7],["πολλὰ",710646,68],["διαψιθυρίσει",703643,127],["καὶ",707031,7],["ἀλλοιώσει",700694,127],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102]],"He will shake his head, and clap his hands, and whisper much, and change his countenance."]]