[["1",[["μὴ",708851,28],["ζήλου",705873,240],["γυναῖκα",703209,9],["τοῦ",709436,35],["κόλπου",707800,18],["σου",711945,133],["μηδὲ",708855,7],["διδάξῃς",703649,175],["ἐπὶ",705080,0],["σεαυτὸν",711599,85],["παιδείαν",709924,9],["πονηράν",710660,36]],"Be not jealous over the wife of thy bosom, and teach her not an evil lesson against thyself."],["2",[["μὴ",708851,28],["δῷς",703654,175],["γυναικὶ",703209,1],["τὴν",709436,8],["ψυχήν",714070,9],["σου",711945,133],["ἐπιβῆναι",705082,106],["αὐτὴν",702165,104],["ἐπὶ",705080,0],["τὴν",709436,8],["ἰσχύν",706858,9],["σου",711945,133]],"Give not thy soul unto a woman to set her foot upon thy substance."],["3",[["μὴ",708851,28],["ὑπάντα",713098,240],["γυναικὶ",703209,1],["ἑταιριζομένῃ",705528,585],["μήποτε",708882,28],["ἐμπέσῃς",704593,175],["εἰς",704105,0],["τὰς",709436,38],["παγίδας",709910,39],["αὐτῆς",702165,86]],"Meet not with an harlot, lest thou fall into her snares."],["4",[["μετὰ",708780,0],["ψαλλούσης",714021,222],["μὴ",708851,28],["ἐνδελέχιζε",704679,240],["μήποτε",708882,28],["ἁλῷς",700673,175],["ἐν",704639,0],["τοῖς",709436,95],["ἐπιχειρήμασιν",705335,96],["αὐτῆς",702165,86]],"Use not much the company of a woman that is a singer, lest thou be taken with her attempts."],["5",[["παρθένον",710148,9],["μὴ",708851,28],["καταμάνθανε",707324,240],["μήποτε",708882,28],["σκανδαλισθῇς",711824,279],["ἐν",704639,0],["τοῖς",709436,95],["ἐπιτιμίοις",705308,96],["αὐτῆς",702165,86]],"Gaze not on a maid, that thou fall not by those things that are precious in her."],["6",[["μὴ",708851,28],["δῷς",703654,175],["πόρναις",710675,76],["τὴν",709436,8],["ψυχήν",714070,9],["σου",711945,133],["ἵνα",706747,7],["μὴ",708851,28],["ἀπολέσῃς",701513,175],["τὴν",709436,8],["κληρονομίαν",707725,9],["σου",711945,133]],"Give not thy soul unto harlots, that thou lose not thine inheritance."],["7",[["μὴ",708851,28],["περιβλέπου",710297,253],["ἐν",704639,0],["ῥύμαις",711308,76],["πόλεως",710612,17],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἐρήμοις",705420,76],["αὐτῆς",702165,86],["μὴ",708851,28],["πλανῶ",710495,253]],"Look not round about thee in the streets of the city, neither wander thou in the solitary places thereof."],["8",[["ἀπόστρεψον",701598,176],["ὀφθαλμὸν",709870,6],["ἀπὸ",701425,0],["γυναικὸς",703209,17],["εὐμόρφου",705646,82],["καὶ",707031,7],["μὴ",708851,28],["καταμάνθανε",707324,240],["κάλλος",707093,25],["ἀλλότριον",700699,46],["ἐν",704639,0],["κάλλει",707093,54],["γυναικὸς",703209,17],["πολλοὶ",710646,138],["ἐπλανήθησαν",710495,99],["καὶ",707031,7],["ἐκ",704132,0],["τούτου",709858,49],["φιλία",713474,12],["ὡς",714148,7],["πῦρ",711088,25],["ἀνακαίεται",700966,117]],"Turn away thine eye from a beautiful woman, and look not upon another's beauty; for many have been deceived by the beauty of a woman; for herewith love is kindled as a fire."],["9",[["μετὰ",708780,0],["ὑπάνδρου",713097,82],["γυναικὸς",703209,17],["μὴ",708851,28],["κάθου",707000,253],["τὸ",709436,24],["σύνολον",712499,46],["καὶ",707031,7],["μὴ",708851,28],["συμβολοκοπήσῃς",712288,175],["μετ᾿",708780,0],["αὐτῆς",702165,86],["ἐν",704639,0],["οἴνῳ",709530,114],["μήποτε",708882,28],["ἐκκλίνῃ",704220,204],["ἡ",709436,10],["ψυχή",714070,12],["σου",711945,133],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["καὶ",707031,7],["τῷ",709436,53],["πνεύματί",710566,54],["σου",711945,133],["ὀλίσθῃς",709579,175],["εἰς",704105,0],["ἀπώλειαν",701660,9]],"Sit not at all with another man's wife, nor sit down with her in thine arms, and spend not thy money with her at the wine; lest thine heart incline unto her, and so through thy desire thou fall into destruction."],["10",[["μὴ",708851,28],["ἐγκαταλίπῃς",703967,175],["φίλον",713492,27],["ἀρχαῖον",701835,27],["ὁ",709436,3],["γὰρ",702963,11],["πρόσφατος",710972,14],["οὐκ",709805,28],["ἔστιν",704093,91],["ἔφισος",705257,14],["αὐτῷ",702165,50],["οἶνος",709530,4],["νέος",709256,14],["φίλος",713492,14],["νέος",709256,14],["ἐὰν",703912,7],["παλαιωθῇ",709937,384],["μετ᾿",708780,0],["εὐφροσύνης",705717,17],["πίεσαι",710478,123],["αὐτόν",702165,85]],"Forsake not an old friend; for the new is not comparable to him: a new friend is as new wine; when it is old, thou shalt drink it with pleasure."],["11",[["μὴ",708851,28],["ζηλώσῃς",705873,175],["δόξαν",703791,9],["ἁμαρτωλοῦ",700776,116],["οὐ",709805,28],["γὰρ",702963,11],["οἶδας",709492,266],["τί",712867,126],["ἔσται",704093,93],["ἡ",709436,10],["καταστροφὴ",707445,12],["αὐτοῦ",702165,102]],"Envy not the glory of a sinner: for thou knowest not what shall be his end."],["12",[["μὴ",708851,28],["εὐδοκήσῃς",705565,175],["ἐν",704639,0],["εὐδοκίᾳ",705566,1],["ἀσεβῶν",701909,169],["μνήσθητι",708960,244],["ὅτι",709803,7],["ἕως",705792,0],["ᾅδου",700255,18],["οὐ",709805,28],["μὴ",708851,28],["δικαιωθῶσιν",703696,272]],"Delight not in the thing that the ungodly have pleasure in; but remember they shall not go unpunished unto their grave."],["13",[["μακρὰν",708411,28],["ἄπεχε",701225,240],["ἀπὸ",701425,0],["ἀνθρώπου",701163,18],["ὃς",709781,213],["ἔχει",705785,91],["ἐξουσίαν",704974,9],["τοῦ",709436,20],["φονεύειν",713546,55],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ὑποπτεύσῃς",713234,175],["φόβον",713534,6],["θανάτου",706096,18],["κἂν",707120,459],["προσέλθῃς",710890,175],["μὴ",708851,28],["πλημμελήσῃς",710534,175],["ἵνα",706747,7],["μὴ",708851,28],["ἀφέληται",702177,239],["τὴν",709436,8],["ζωήν",705910,9],["σου",711945,133],["ἐπίγνωθι",705104,176],["ὅτι",709803,7],["ἐν",704639,0],["μέσῳ",708768,97],["παγίδων",709910,65],["διαβαίνεις",703419,154],["καὶ",707031,7],["ἐπὶ",705080,0],["ἐπάλξεων",705012,65],["πόλεως",710612,17],["περιπατεῖς",710362,154]],"Keep thee far from the man that hath power to kill: so shalt thou not doubt the fear of death: and if thou come unto him, make no fault, lest he take away thy life presently: remember that thou goest in the midst of snares, and that thou walkest upon the battlements of the city."],["14",[["κατὰ",707200,0],["τὴν",709436,8],["ἰσχύν",706858,9],["σου",711945,133],["στόχασαι",712129,300],["τοὺς",709436,58],["πλησίον",710547,28],["καὶ",707031,7],["μετὰ",708780,0],["σοφῶν",711985,169],["συμβουλεύου",712292,253]],"As near as thou canst, guess at thy neighbour, and consult with the wise."],["15",[["μετὰ",708780,0],["συνετῶν",712464,169],["ἔστω",704093,31],["ὁ",709436,3],["διαλογισμός",703506,4],["σου",711945,133],["καὶ",707031,7],["πᾶσα",710177,29],["διήγησίς",703681,12],["σου",711945,133],["ἐν",704639,0],["νόμῳ",709349,114],["ὑψίστου",713287,116]],"Let thy talk be with the wise, and all thy communication in the law of the most High."],["16",[["ἄνδρες",701150,52],["δίκαιοι",703694,138],["ἔστωσαν",704093,56],["σύνδειπνοί",712415,52],["σου",711945,133],["καὶ",707031,7],["ἐν",704639,0],["φόβῳ",713534,114],["κυρίου",707996,18],["ἔστω",704093,31],["τὸ",709436,34],["καύχημά",707570,15],["σου",711945,133]],"And let just men eat and drink with thee; and let thy glorying be in the fear of the Lord."],["17",[["ἐν",704639,0],["χειρὶ",713787,1],["τεχνιτῶν",712832,81],["ἔργον",705396,15],["ἐπαινεσθήσεται",705000,134],["καὶ",707031,7],["ὁ",709436,3],["ἡγούμενος",705931,122],["λαοῦ",708094,18],["σοφὸς",711985,14],["ἐν",704639,0],["λόγῳ",708236,114],["αὐτοῦ",702165,102]],"For the hand of the artificer the work shall be commended; and the wise ruler of the people for his speech."],["18",[["φοβερὸς",713530,14],["ἐν",704639,0],["πόλει",710612,1],["αὐτοῦ",702165,102],["ἀνὴρ",701150,4],["γλωσσώδης",703125,14],["καὶ",707031,7],["ὁ",709436,3],["προπετὴς",710836,14],["ἐν",704639,0],["λόγῳ",708236,114],["αὐτοῦ",702165,102],["μισηθήσεται",708935,134]],"A man of an ill tongue is dangerous in his city; and he that is rash in his talk shall be hated."]]