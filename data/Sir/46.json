[["1",[["κραταιὸς",707873,14],["ἐν",704639,0],["πολέμῳ",710605,114],["Ἰησοῦς",706701,4],["Ναυη",709206,18],["καὶ",707031,7],["διάδοχος",703450,4],["Μωυσῆ",709112,18],["ἐν",704639,0],["προφητείαις",711007,76],["ὃς",709781,213],["ἐγένετο",703104,23],["κατὰ",707200,0],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["μέγας",708653,14],["ἐπὶ",705080,0],["σωτηρίᾳ",712658,1],["ἐκλεκτῶν",704240,169],["αὐτοῦ",702165,102],["ἐκδικῆσαι",704174,106],["ἐπεγειρομένους",705053,236],["ἐχθρούς",705779,60],["ὅπως",709719,7],["κατακληρονομήσῃ",707274,172],["τὸν",709436,5],["Ισραηλ",706839,6]],"Jesus the son of Nave was valiant in the wars, and was the successor of Moses in prophecies, who according to his name was made great for the saving of the elect of God, and taking vengeance of the enemies that rose up against them, that he might set Israel in their inheritance."],["2",[["ὡς",714148,7],["ἐδοξάσθη",703792,37],["ἐν",704639,0],["τῷ",709436,113],["ἐπᾶραι",705002,106],["χεῖρας",713787,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἐκτεῖναι",704322,106],["ῥομφαίαν",711291,9],["ἐπὶ",705080,0],["πόλεις",710612,39]],"How great glory gat he, when he did lift up his hands, and stretched out his sword against the cities!"],["3",[["τίς",712867,158],["πρότερος",710992,14],["αὐτοῦ",702165,102],["οὕτως",709859,28],["ἔστη",706846,2],["τοὺς",709436,58],["γὰρ",702963,11],["πολέμους",710605,57],["κυρίου",707996,18],["αὐτὸς",702165,121],["ἐπήγαγεν",704994,2]],"Who before him has so stood? for the Lord himself brought his enemies over to him."],["4",[["οὐχὶ",709862,28],["ἐν",704639,0],["χειρὶ",713787,1],["αὐτοῦ",702165,102],["ἐνεποδίσθη",704604,37],["ὁ",709436,3],["ἥλιος",705974,4],["καὶ",707031,7],["μία",704106,29],["ἡμέρα",705984,12],["ἐγενήθη",703104,37],["πρὸς",710844,0],["δύο",703849,59]],"Did not the sun go back by his means? and was not one day as long as two?"],["5",[["ἐπεκαλέσατο",705153,23],["τὸν",709436,5],["ὕψιστον",713287,27],["δυνάστην",703844,6],["ἐν",704639,0],["τῷ",709436,53],["θλῖψαι",706274,106],["αὐτὸν",702165,85],["ἐχθροὺς",705779,60],["κυκλόθεν",707956,28],["καὶ",707031,7],["ἐπήκουσεν",705009,2],["αὐτοῦ",702165,102],["μέγας",708653,14],["κύριος",707996,4],["ἐν",704639,0],["λίθοις",708196,148],["χαλάζης",713667,17],["δυνάμεως",703839,17],["κραταιᾶς",707873,82]],"He called upon the most high Lord, when the enemies pressed upon him on every side; and the great Lord heard him."],["6",[["κατέρραξεν",707405,2],["ἐπ᾿",705080,0],["ἔθνος",704068,25],["πόλεμον",710605,6],["καὶ",707031,7],["ἐν",704639,0],["καταβάσει",707206,1],["ἀπώλεσεν",701513,2],["ἀνθεστηκότας",701154,277],["ἵνα",706747,7],["γνῶσιν",703105,234],["ἔθνη",704068,64],["πανοπλίαν",709968,9],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ἐναντίον",704654,0],["κυρίου",707996,18],["ὁ",709436,3],["πόλεμος",710605,4],["αὐτοῦ",702165,102]],"And with hailstones of mighty power he made the battle to fall violently upon the nations, and by their falling he destroyed them that resisted, that the nations might know all their strength, because he fought in the sight of the Lord, and he followed the Mighty One."],["7",[["καὶ",707031,28],["γὰρ",702963,11],["ἐπηκολούθησεν",705007,2],["ὀπίσω",709697,28],["δυνάστου",703844,18],["καὶ",707031,7],["ἐν",704639,0],["ἡμέραις",705984,76],["Μωυσέως",709112,18],["ἐποίησεν",710582,2],["ἔλεος",704426,25],["αὐτὸς",702165,121],["καὶ",707031,7],["Χαλεβ",713680,4],["υἱὸς",713075,4],["Ιεφοννη",706687,18],["ἀντιστῆναι",701154,106],["ἔναντι",704653,0],["ἐκκλησίας",704216,17],["κωλῦσαι",708020,106],["λαὸν",708094,6],["ἀπὸ",701425,0],["ἁμαρτίας",700775,17],["καὶ",707031,7],["κοπάσαι",707819,106],["γογγυσμὸν",703146,6],["πονηρίας",710659,17]],"In the time of Moses also he did a work of mercy, he and Caleb the son of Jephunne, in that they withstood the enemy, and withheld the people from sin, and appeased the wicked murmuring."],["8",[["καὶ",707031,7],["αὐτοὶ",702165,201],["δύο",703849,59],["ὄντες",704093,146],["διεσώθησαν",703599,99],["ἀπὸ