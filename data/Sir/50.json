[["1",[["Σιμων",711792,4],["Ονιου",709654,18],["υἱὸς",713075,4],["ἱερεὺς",706614,4],["ὁ",709436,3],["μέγας",708653,14],["ὃς",709781,213],["ἐν",704639,0],["ζωῇ",705910,1],["αὐτοῦ",702165,102],["ὑπέρραψεν",713237,2],["οἶκον",709516,6],["καὶ",707031,7],["ἐν",704639,0],["ἡμέραις",705984,76],["αὐτοῦ",702165,102],["ἐστερέωσεν",712076,2],["ναόν",709191,6]],"Simon the high priest, the son of Onias, who in his life repaired the house again, and in his days fortified the temple:"],["2",[["καὶ",707031,7],["ὑπ᾿",713184,0],["αὐτοῦ",702165,102],["ἐθεμελιώθη",706182,37],["ὕψος",713288,15],["διπλῆς",703740,82],["ἀνάλημμα",700988,15],["ὑψηλὸν",713285,26],["περιβόλου",710302,18],["ἱεροῦ",706633,92]],"and by him was built from the foundation the double height, the high fortress of the wall about the temple:"],["3",[["ἐν",704639,0],["ἡμέραις",705984,76],["αὐτοῦ",702165,102],["ἐλατομήθη",704394,37],["ἀποδοχεῖον",701454,15],["ὑδάτων",713071,44],["λάκκος",708067,4],["ὡσεὶ",714159,28],["θαλάσσης",706069,17],["τὸ",709436,34],["περίμετρον",710349,15]],"in his days the cistern to receive water, being in compass as the sea, was covered with plates of brass:"],["4",[["ὁ",709436,3],["φροντίζων",713590,72],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["πτώσεως",711072,17],["καὶ",707031,7],["ἐνισχύσας",704750,182],["πόλιν",710612,9],["ἐν",704639,0],["πολιορκήσει",710609,1]],"he took care of the temple that it should not fall, and fortified the city against besieging:"],["5",[["ὡς",714148,7],["ἐδοξάσθη",703792,37],["ἐν",704639,0],["περιστροφῇ",710396,1],["λαοῦ",708094,18],["ἐν",704639,0],["ἐξόδῳ",704948,1],["οἴκου",709516,18],["καταπετάσματος",707370,21]],"how was he honoured in the midst of the people in his coming out of the sanctuary!"],["6",[["ὡς",714148,7],["ἀστὴρ",702017,4],["ἑωθινὸς",705790,14],["ἐν",704639,0],["μέσῳ",708768,30],["νεφελῶν",709277,65],["ὡς",714148,7],["σελήνη",711650,12],["πλήρης",710541,29],["ἐν",704639,0],["ἡμέραις",705984,76]],"He was as the morning star in the midst of a cloud, and as the moon at the full:"],["7",[["ὡς",714148,7],["ἥλιος",705974,4],["ἐκλάμπων",704233,72],["ἐπὶ",705080,0],["ναὸν",709191,6],["ὑψίστου",713287,116],["καὶ",707031,7],["ὡς",714148,7],["τόξον",712898,15],["φωτίζον",713646,32],["ἐν",704639,0],["νεφέλαις",709277,76],["δόξης",703791,17]],"as the sun shining upon the temple of the most High, and as the rainbow giving light in the bright clouds:"],["8",[["ὡς",714148,7],["ἄνθος",701157,15],["ῥόδων",711281,44],["ἐν",704639,0],["ἡμέραις",705984,76],["νέων",709256,169],["ὡς",714148,7],["κρίνα",707904,64],["ἐπ᾿",705080,0],["ἐξόδῳ",704948,1],["ὕδατος",713071,21],["ὡς",714148,7],["βλαστὸς",702736,4],["Λιβάνου",708185,18],["ἐν",704639,0],["ἡμέραις",705984,76],["θέρους",706219,21]],"and as the flower of roses in the spring of the year, as lilies by the rivers of waters, and as the branches of the frankincense tree in the time of summer:"],["9",[["ὡς",714148,7],["πῦρ",711088,15],["καὶ",707031,7],["λίβανος",708186,4],["ἐπὶ",705080,0],["πυρείου",711093,21],["ὡς",714148,7],["σκεῦος",711844,15],["χρυσίου",713972,21],["ὁλοσφύρητον",709598,26],["κεκοσμημένον",707847,327],["παντὶ",710177,30],["λίθῳ",708196,114],["πολυτελεῖ",710647,30]],"as fire and incense in the censer, and as a vessel of beaten gold set with all manner of precious stones:"],["10",[["ὡς",714148,7],["ἐλαία",704376,12],["ἀναθάλλουσα",700949,188],["καρποὺς",707169,57],["καὶ",707031,7],["ὡς",714148,7],["κυπάρισσος",707982,12],["ὑψουμένη",713289,211],["ἐν",704639,0],["νεφέλαις",709277,76]],"and as a fair olive tree budding forth fruit, and as a cypress tree which groweth up to the clouds."],["11",[["ἐν",704639,0],["τῷ",709436,53],["ἀναλαμβάνειν",700984,55],["αὐτὸν",702165,85],["στολὴν",712120,9],["δόξης",703791,17],["καὶ",707031,7],["ἐνδιδύσκεσθαι",704688,110],["αὐτὸν",702165,85],["συντέλειαν",712509,9],["καυχήματος",707570,21],["ἐν",704639,0],["ἀναβάσει",700907,1],["θυσιαστηρίου",706348,21],["ἁγίου",700159,92],["ἐδόξασεν",703792,2],["π