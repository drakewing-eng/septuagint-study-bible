05994,90],["εὐφροσύνην",705717,9],["καρδίας",707141,17],["καὶ",707031,7],["γενέσθαι",703104,109],["εἰρήνην",704098,9],["ἐν",704639,0],["ἡμέραις",705984,76],["ἡμῶν",705999,145],["ἐν",704639,0],["Ισραηλ",706839,111],["κατὰ",707200,0],["τὰς",709436,38],["ἡμέρας",705984,39],["τοῦ",709436,35],["αἰῶνος",700504,18]],"He grant us joyfulness of heart, and that peace may be in our days in Israel for ever:"],["24",[["ἐμπιστεύσαι",704594,225],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["τὸ",709436,24],["ἔλεος",704426,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἡμῶν",705999,145],["λυτρωσάσθω",708282,315],["ἡμᾶς",705981,194]],"that he would confirm his mercy with us, and deliver us at his time!"],["25",[["ἐν",704639,0],["δυσὶν",703849,533],["ἔθνεσιν",704068,96],["προσώχθισεν",710945,2],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["καὶ",707031,7],["τὸ",709436,34],["τρίτον",712968,26],["οὐκ",709805,28],["ἔστιν",704093,91],["ἔθνος",704068,15]],"There be two manner of nations which my heart abhorreth, and the third is no nation:"],["26",[["οἱ",709436,136],["καθήμενοι",707000,348],["ἐν",704639,0],["ὄρει",709768,54],["Σαμαρείας",711449,17],["καὶ",707031,7],["Φυλιστιιμ",713621,52],["καὶ",707031,7],["ὁ",709436,3],["λαὸς",708094,4],["ὁ",709436,3],["μωρὸς",709110,14],["ὁ",709436,3],["κατοικῶν",707540,81],["ἐν",704639,0],["Σικιμοις",711783,111]],"they that sit upon the mountain of Samaria, and they that dwell among the Philistines, and that foolish people that dwell in Sichem."],["27",[["παιδείαν",709924,9],["συνέσεως",712460,17],["καὶ",707031,7],["ἐπιστήμης",705267,17],["ἐχάραξεν",713730,2],["ἐν",704639,0],["τῷ",709436,53],["βιβλίῳ",702719,54],["τούτῳ",709858,280],["Ἰησοῦς",706701,4],["υἱὸς",713075,4],["Σιραχ",711799,18],["Ελεαζαρ",704407,18],["ὁ",709436,3],["Ιεροσολυμίτης",706635,4],["ὃς",709781,213],["ἀνώμβρησεν",701189,2],["σοφίαν",711981,9],["ἀπὸ",701425,0],["καρδίας",707141,17],["αὐτοῦ",702165,102]],"Jesus the son of Sirach of Jerusalem hath written in this book the instruction of understanding and knowledge, who out of his heart poured forth wisdom."],["28",[["μακάριος",708397,14],["ὃς",709781,213],["ἐν",704639,0],["τούτοις",709858,206],["ἀναστραφήσεται",701060,134],["καὶ",707031,7],["θεὶς",712849,182],["αὐτὰ",702165,71],["ἐπὶ",705080,0],["καρδίαν",707141,9],["αὐτοῦ",702165,102],["σοφισθήσεται",711982,134]],"Blessed is he that shall be exercised in these things: and he that layeth them up in his heart shall become wise."],["29",[["ἐὰν",703912,7],["γὰρ",702963,11],["αὐτὰ",702165,71],["ποιήσῃ",710582,172],["πρὸς",710844,0],["πάντα",710177,68],["ἰσχύσει",706859,127],["ὅτι",709803,7],["φῶς",713642,25],["κυρίου",707996,18],["τὸ",709436,34],["ἴχνος",706873,15],["αὐτοῦ",702165,102]],"For if he do them, he shall be strong to all things: for the light of the Lord is his path."]]