132,0],["αἵματος",700442,21],["σταφυλῆς",712052,17],["ἐξέχεεν",704368,2],["εἰς",704105,0],["θεμέλια",706181,42],["θυσιαστηρίου",706348,21],["ὀσμὴν",709786,9],["εὐωδίας",705734,17],["ὑψίστῳ",713287,30],["παμβασιλεῖ",709946,114]],"he stretched out his hand to the cup, and poured of the blood of the grape, he poured out at the foot of the altar a sweetsmelling savour unto the most high King of all."],["16",[["τότε",712908,28],["ἀνέκραγον",700979,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ααρων",700005,18],["ἐν",704639,0],["σάλπιγξιν",711424,76],["ἐλαταῖς",704389,76],["ἤχησαν",706045,150],["ἀκουστὴν",700584,36],["ἐποίησαν",710582,150],["φωνὴν",713640,9],["μεγάλην",708653,36],["εἰς",704105,0],["μνημόσυνον",708966,25],["ἔναντι",704653,0],["ὑψίστου",713287,116]],"Then shouted the sons of Aaron, and sounded the silver trumpets, and made a great noise to be heard, for a remembrance before the most High."],["17",[["τότε",712908,28],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["κοινῇ",707772,101],["κατέσπευσαν",707433,150],["καὶ",707031,7],["ἔπεσαν",710481,150],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["προσκυνῆσαι",710925,106],["τῷ",709436,113],["κυρίῳ",707996,114],["αὐτῶν",702165,40],["παντοκράτορι",709986,114],["θεῷ",706192,114],["ὑψίστῳ",713287,30]],"Then all the people together hasted, and fell down to the earth upon their faces to worship their Lord God Almighty, the most High."],["18",[["καὶ",707031,7],["ᾔνεσαν",700459,150],["οἱ",709436,136],["ψαλτῳδοὶ",714027,52],["ἐν",704639,0],["φωναῖς",713640,76],["αὐτῶν",702165,40],["ἐν",704639,0],["πλείστῳ",710646,339],["ἤχῳ",706046,114],["ἐγλυκάνθη",703110,37],["μέλος",708707,15]],"The singers also sang praises with their voices, with great variety of sounds was there made sweet melody."],["19",[["καὶ",707031,7],["ἐδεήθη",703394,37],["ὁ",709436,3],["λαὸς",708094,4],["κυρίου",707996,18],["ὑψίστου",713287,116],["ἐν",704639,0],["προσευχῇ",710892,1],["κατέναντι",707507,0],["ἐλ