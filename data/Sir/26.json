[["1",[["γυναικὸς",703209,17],["ἀγαθῆς",700106,82],["μακάριος",708397,14],["ὁ",709436,3],["ἀνήρ",701150,4],["καὶ",707031,7],["ἀριθμὸς",701744,4],["τῶν",709436,130],["ἡμερῶν",705984,65],["αὐτοῦ",702165,102],["διπλάσιος",703738,14]],"Blessed is the man that hath a virtuous wife, for the number of his days shall be double."],["2",[["γυνὴ",703209,12],["ἀνδρεία",701101,29],["εὐφραίνει",705715,91],["τὸν",709436,5],["ἄνδρα",701150,6],["αὐτῆς",702165,86],["καὶ",707031,7],["τὰ",709436,41],["ἔτη",705543,42],["αὐτοῦ",702165,102],["πληρώσει",710543,127],["ἐν",704639,0],["εἰρήνῃ",704098,1]],"A virtuous woman rejoiceth her husband, and he shall fulfil the years of his life in peace."],["3",[["γυνὴ",703209,12],["ἀγαθὴ",700106,29],["μερὶς",708748,12],["ἀγαθή",700106,29],["ἐν",704639,0],["μερίδι",708748,1],["φοβουμένων",713532,299],["κύριον",707996,6],["δοθήσεται",703654,134]],"A good wife is a good portion, which shall be given in the portion of them that fear the Lord."],["4",[["πλουσίου",710560,116],["δὲ",703303,11],["καὶ",707031,7],["πτωχοῦ",711076,18],["καρδία",707141,12],["ἀγαθή",700106,29],["ἐν",704639,0],["παντὶ",710177,30],["καιρῷ",707047,114],["πρόσωπον",710986,15],["ἱλαρόν",706723,26]],"Whether a man be rich or poor, if he have a good heart toward the Lord, he shall at all times rejoice with a cheerful countenance."],["5",[["ἀπὸ",701425,0],["τριῶν",712927,83],["εὐλαβήθη",705627,37],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["καὶ",707031,7],["ἐπὶ",705080,0],["τῷ",709436,53],["τετάρτῳ",712811,97],["προσώπῳ",710986,54],["ἐδεήθην",703394,156],["διαβολὴν",703427,9],["πόλεως",710612,17],["καὶ",707031,7],["ἐκκλησίαν",704216,9],["ὄχλου",709884,18],["καὶ",707031,7],["καταψευσμόν",707501,6],["ὑπὲρ",713111,0],["θάνατον",706096,6],["πάντα",710177,195],["μοχθηρά",709038,195]],"There be three things that mine heart feareth; and for the fourth I was sore afraid: the slander of a city, the gathering together of an unruly multitude, and a false accusation: all these are worse than death."],["6",[["ἄλγος",700642,15],["καρδίας",707141,17],["καὶ",707031,7],["πένθος",710253,15],["γυνὴ",703209,12],["ἀντίζηλος",701235,12],["ἐπὶ",705080,0],["γυναικὶ",703209,1],["καὶ",707031,7],["μάστιξ",708568,12],["γλώσσης",703120,17],["πᾶσιν",710177,230],["ἐπικοινωνοῦσα",705169,188]],"But a grief of heart and sorrow is a woman that is jealous over another woman, and a scourge of the tongue which communicateth with all."],["7",[["βοοζύγιον",702761,15],["σαλευόμενον",711403,32],["γυνὴ",703209,12],["πονηρά",710660,29],["ὁ",709436,3],["κρατῶν",707879,72],["αὐτῆς",702165,86],["ὡς",714148,7],["ὁ",709436,3],["δρασσόμενος",703826,122],["σκορπίου",711882,18]],"An evil wife is a yoke shaken to and fro: he that hath hold of her is as though he held a scorpion."],["8",[["ὀργὴ",709728,12],["μεγάλη",708653,29],["γυνὴ",703209,12],["μέθυσος",708675,29],["καὶ",707031,7],["ἀσχημοσύνην",702054,9],["αὐτῆς",702165,86],["οὐ",709805,28],["συγκαλύψει",712201,127]],"A drunken woman and a gadder abroad causeth great anger, and she will not cover her own shame."],["9",[["πορνεία",710672,12],["γυναικὸς",703209,17],["ἐν",704639,0],["μετεωρισμοῖς",708830,148],["ὀφθαλμῶν",709870,81],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["βλεφάροις",702741,96],["αὐτῆς",702165,86],["γνωσθήσεται",703105,134]],"The whoredom of a woman may be known in her haughty looks and eyelids."],["10",[["ἐπὶ",705080,0],["θυγατρὶ",706320,1],["ἀδιατρέπτῳ",700264,101],["στερέωσον",712076,176],["φυλακήν",713613,9],["ἵνα",706747,7],["μὴ",708851,28],["εὑροῦσα",705676,149],["ἄνεσιν",701134,9],["ἑαυτῇ",703917,105],["χρήσηται",713937,239]],"If thy daughter be shameless, keep her in straitly, lest she abuse herself through overmuch liberty."],["11",[["ὀπίσω",709697,28],["ἀναιδοῦς",700959,116],["ὀφθαλμοῦ",709870,18],["φύλαξαι",713619,300],["καὶ",707031,7],["μὴ",708851,28],["θαυμάσῃς",706135,175],["ἐὰν",703912,7],["εἰς",704105,0],["σὲ",711598,163],["πλημμελήσῃ",710534,172]],"Watch over an impudent eye: and marvel not if she trespass against thee."],["12",[["ὡς",714148,7],["διψῶν",703763,72],["ὁδοιπόρος",709451,4],["τὸ",709436,24],["στόμα",712125,25],["ἀνοίξει",701186,127],["καὶ",707031,7],["ἀπὸ",701425,0],["παντὸς",710177,92],["ὕδατος",713071,21],["τοῦ",709436,20],["σύνεγγυς",712424,28],["πίεται",710478,93],["κατέναντι",707507,0],["παντὸς",710177,116],["πασσάλου",710178,18],["καθήσεται",707007,93],["καὶ",707031,7],["ἔναντι",704653,0],["βέλους",702644,21],["ἀνοίξει",701186,127],["φαρέτραν",713364,9]],"She will open her mouth, as a thirsty traveller when he hath found a fountain, and drink of every water near her: by every hedge will she sit down, and open her quiver against every arrow."],["13",[["χάρις",713735,12],["γυναικὸς",703209,17],["τέρψει",712804,127],["τὸν",709436,5],["ἄνδρα",701150,6],["αὐτῆς",702165,86],["καὶ",707031,7],["τὰ",709436,41],["ὀστᾶ",709792,42],["αὐτοῦ",702165,102],["πιανεῖ",710464,127],["ἡ",709436,10],["ἐπιστήμη",705267,12],["αὐτῆς",702165,86]],"The grace of a wife delighteth her husband, and her discretion will fatten his bones."],["14",[["δόσις",703809,12],["κυρίου",707996,18],["γυνὴ",703209,12],["σιγηρά",711769,29],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀντάλλαγμα",701209,15],["πεπαιδευμένης",709926,440],["ψυχῆς",714070,17]],"A silent and loving woman is a gift of the Lord; and there is nothing so much worth as a mind well instructed."],["15",[["χάρις",713735,12],["ἐπὶ",705080,0],["χάριτι",713735,1],["γυνὴ",703209,12],["αἰσχυντηρά",700484,29],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["σταθμὸς",712040,4],["πᾶς",710177,14],["ἄξιος",701308,14],["ἐγκρατοῦς",703990,82],["ψυχῆς",714070,17]],"A shamefaced and faithful woman is a double grace, and her continent mind cannot be valued."],["16",[["ἥλιος",705974,4],["ἀνατέλλων",701066,72],["ἐν",704639,0],["ὑψίστοις",713287,230],["κυρίου",707996,18],["καὶ",707031,7],["κάλλος",707093,15],["ἀγαθῆς",700106,82],["γυναικὸς",703209,17],["ἐν",704639,0],["κόσμῳ",707851,114],["οἰκίας",709505,17],["αὐτῆς",702165,86]],"As the sun when it ariseth in the high heaven; so is the beauty of a good wife in the ordering of her house."],["17",[["λύχνος",708287,4],["ἐκλάμπων",704233,72],["ἐπὶ",705080,0],["λυχνίας",708286,17],["ἁγίας",700159,82],["καὶ",707031,7],["κάλλος",707093,15],["προσώπου",710986,21],["ἐπὶ",705080,0],["ἡλικίᾳ",705971,1],["στασίμῃ",712048,101]],"As the clear light is upon the holy candlestick: so is the beauty of the face in ripe age."],["18",[["στῦλοι",712179,52],["χρύσεοι",713971,138],["ἐπὶ",705080,0],["βάσεως",702585,17],["ἀργυρᾶς",701705,82],["καὶ",707031,7],["πόδες",710707,52],["ὡραῖοι",714132,138],["ἐπὶ",705080,0],["στέρνοις",712080,96],["εὐσταθοῦς",705694,92]],"As the golden pillars are upon the sockets of silver; so are the fair feet with a constant heart."],["28",[["ἐπὶ",705080,0],["δυσὶ",703849,533],["λελύπηται",708272,187],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["καὶ",707031,7],["ἐπὶ",705080,0],["τῷ",709436,53],["τρίτῳ",712968,97],["θυμός",706334,4],["μοι",708974,159],["ἐπῆλθεν",705068,2],["ἀνὴρ",701150,4],["πολεμιστὴς",710604,4],["ὑστερῶν",713270,72],["δι᾿",703417,0],["ἔνδειαν",704672,9],["καὶ",707031,7],["ἄνδρες",701150,52],["συνετοὶ",712464,138],["ἐὰν",703912,7],["σκυβαλισθῶσιν",711891,272],["ἐπανάγων",705015,72],["ἀπὸ",701425,0],["δικαιοσύνης",703695,17],["ἐπὶ",705080,0],["ἁμαρτίαν",700775,9],["ὁ",709436,3],["κύριος",707996,4],["ἑτοιμάσει",705539,127],["εἰς",704105,0],["ῥομφαίαν",711291,9],["αὐτόν",702165,85]],"There be two things that grieve my heart; and the third maketh me angry: a man of war that suffereth poverty; and men of understanding that are not set by: and one that returneth from righteousness to sin; the Lord prepareth such an one for the sword."],["29",[["μόλις",708982,28],["ἐξελεῖται",704838,93],["ἔμπορος",704614,4],["ἀπὸ",701425,0],["πλημμελείας",710533,17],["καὶ",707031,7],["οὐ",709805,28],["δικαιωθήσεται",703696,134],["κάπηλος",707129,4],["ἀπὸ",701425,0],["ἁμαρτίας",700775,17]],"A merchant shall hardly keep himself from doing wrong; and an huckster shall not be freed from sin."]]