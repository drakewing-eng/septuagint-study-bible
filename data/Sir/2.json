[["1",[["τέκνον",712761,297],["εἰ",704071,7],["προσέρχῃ",710890,278],["δουλεύειν",703814,55],["κυρίῳ",707996,114],["ἑτοίμασον",705539,176],["τὴν",709436,8],["ψυχήν",714070,9],["σου",711945,133],["εἰς",704105,0],["πειρασμόν",710226,6]],"My son, if thou come to serve the Lord God, prepare thy soul for temptation."],["2",[["εὔθυνον",705601,176],["τὴν",709436,8],["καρδίαν",707141,9],["σου",711945,133],["καὶ",707031,7],["καρτέρησον",707178,176],["καὶ",707031,7],["μὴ",708851,28],["σπεύσῃς",712011,175],["ἐν",704639,0],["καιρῷ",707047,114],["ἐπαγωγῆς",704995,17]],"Set thy heart aright, and constantly endure, and make not haste in time of trouble."],["3",[["κολλήθητι",707791,244],["αὐτῷ",702165,50],["καὶ",707031,7],["μὴ",708851,28],["ἀποστῇς",702214,175],["ἵνα",706747,7],["αὐξηθῇς",702144,279],["ἐπ᾿",705080,0],["ἐσχάτων",705519,83],["σου",711945,133]],"Cleave unto him, and depart not away, that thou mayest be increased at thy last end."],["4",[["πᾶν",710177,26],["ὃ",709781,33],["ἐὰν",703912,7],["ἐπαχθῇ",704994,384],["σοι",711925,159],["δέξαι",703393,300],["καὶ",707031,7],["ἐν",704639,0],["ἀλλάγμασιν",700682,96],["ταπεινώσεώς",712719,17],["σου",711945,133],["μακροθύμησον",708418,176]],"Whatsoever is brought upon thee take cheerfully, and be patient when thou art changed to a low estate."],["5",[["ὅτι",709803,7],["ἐν",704639,0],["πυρὶ",711088,54],["δοκιμάζεται",703776,117],["χρυσὸς",713975,14],["καὶ",707031,7],["ἄνθρωποι",701163,52],["δεκτοὶ",703348,138],["ἐν",704639,0],["καμίνῳ",707113,114],["ταπεινώσεως",712719,17]],"For gold is tried in the fire, and acceptable men in the furnace of adversity."],["6",[["πίστευσον",710483,176],["αὐτῷ",702165,50],["καὶ",707031,7],["ἀντιλήμψεταί",701243,93],["σου",711945,133],["εὔθυνον",705601,176],["τὰς",709436,38],["ὁδούς",709458,39],["σου",711945,133],["καὶ",707031,7],["ἔλπισον",704529,176],["ἐπ᾿",705080,0],["αὐτόν",702165,85]],"Believe in him, and he will help thee; order thy way aright, and trust in him."],["7",[["οἱ",709436,136],["φοβούμενοι",713532,348],["τὸν",709436,5],["κύριον",707996,6],["ἀναμείνατε",701000,74],["τὸ",709436,24],["ἔλεος",704426,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["μὴ",708851,28],["ἐκκλίνητε",704220,355],["ἵνα",706747,7],["μὴ",708851,28],["πέσητε",710481,125]],"Ye that fear the Lord, wait for his mercy; and go not aside, lest ye fall."],["8",[["οἱ",709436,136],["φοβούμενοι",713532,348],["κύριον",707996,6],["πιστεύσατε",710483,74],["αὐτῷ",702165,50],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["πταίσῃ",711048,172],["ὁ",709436,3],["μισθὸς",708939,4],["ὑμῶν",713091,145]],"Ye that fear the Lord, believe him; and your reward shall not fail."],["9",[["οἱ",709436,136],["φοβούμενοι",713532,348],["κύριον",707996,6],["ἐλπίσατε",704529,74],["εἰς",704105,0],["ἀγαθὰ",700106,68],["καὶ",707031,7],["εἰς",704105,0],["εὐφροσύνην",705717,9],["αἰῶνος",700504,18],["καὶ",707031,7],["ἔλεος",704426,25]],"Ye that fear the Lord, hope for good, and for everlasting joy and mercy."],["10",[["ἐμβλέψατε",704551,74],["εἰς",704105,0],["ἀρχαίας",701835,119],["γενεὰς",703037,39],["καὶ",707031,7],["ἴδετε",709725,74],["τίς",712867,158],["ἐνεπίστευσεν",704594,2],["κυρίῳ",707996,114],["καὶ",707031,7],["κατῃσχύνθη",707257,37],["ἢ",705924,7],["τίς",712867,158],["ἐνέμεινεν",704570,2],["τῷ",709436,113],["φόβῳ",713534,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐγκατελείφθη",703967,37],["ἢ",705924,7],["τίς",712867,158],["ἐπεκαλέσατο",705153,23],["αὐτόν",702165,85],["καὶ",707031,7],["ὑπερεῖδεν",713154,2],["αὐτόν",702165,85]],"Look at the generations of old, and see; did ever any trust in the Lord, and was confounded? or did any abide in his fear, and was forsaken? or whom did he ever despise, that called upon him?"],["11",[["διότι",703734,7],["οἰκτίρμων",709521,14],["καὶ",707031,7],["ἐλεήμων",704422,14],["ὁ",709436,3],["κύριος",707996,4],["καὶ",707031,7],["ἀφίησιν",702211,91],["ἁμαρτίας",700775,39],["καὶ",707031,7],["σῴζει",712627,91],["ἐν",704639,0],["καιρῷ",707047,114],["θλίψεως",706276,17]],"For the Lord is full of compassion and mercy, longsuffering, and very pitiful, and forgiveth sins, and saveth in time of affliction."],["12",[["οὐαὶ",709807,88],["καρδίαις",707141,76],["δειλαῖς",703324,291],["καὶ",707031,7],["χερσὶν",713787,76],["παρειμέναις",710149,351],["καὶ",707031,7],["ἁμαρτωλῷ",700776,30],["ἐπιβαίνοντι",705082,379],["ἐπὶ",705080,0],["δύο",703849,59],["τρίβους",712939,39]],"Woe be to fearful hearts, and faint hands, and the sinner that goeth two ways!"],["13",[["οὐαὶ",709807,88],["καρδίᾳ",707141,1],["παρειμένῃ",710149,455],["ὅτι",709803,7],["οὐ",709805,28],["πιστεύει",710483,91],["διὰ",703417,0],["τοῦτο",709858,129],["οὐ",709805,28],["σκεπασθήσεται",711832,134]],"Woe unto him that is fainthearted! for he believeth not; therefore shall he not be defended."],["14",[["οὐαὶ",709807,88],["ὑμῖν",713084,90],["τοῖς",709436,147],["ἀπολωλεκόσιν",701513,536],["τὴν",709436,8],["ὑπομονήν",713226,9],["καὶ",707031,7],["τί",712867,126],["ποιήσετε",710582,337],["ὅταν",709801,28],["ἐπισκέπτηται",705250,428],["ὁ",709436,3],["κύριος",707996,4]],"Woe unto you that have lost patience! and what will ye do when the Lord shall visit you?"],["15",[["οἱ",709436,136],["φοβούμενοι",713532,348],["κύριον",707996,6],["οὐκ",709805,28],["ἀπειθήσουσιν",701370,218,127],["ῥημάτων",711246,44],["αὐτοῦ",702165,102],["καὶ",707031,7],["οἱ",709436,136],["ἀγαπῶντες",700120,146],["αὐτὸν",702165,85],["συντηρήσουσιν",712512,218],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτοῦ",702165,102]],"They that fear the Lord will not disobey his word; and they that love him will keep his ways."],["16",[["οἱ",709436,136],["φοβούμενοι",713532,348],["κύριον",707996,6],["ζητήσουσιν",705879,218],["εὐδοκίαν",705566,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["οἱ",709436,136],["ἀγαπῶντες",700120,146],["αὐτὸν",702165,85],["ἐμπλησθήσονται",704592,144],["τοῦ",709436,35],["νόμου",709349,18]],"They that fear the Lord will seek that which is wellpleasing unto him; and they that love him shall be filled with the law."],["17",[["οἱ",709436,136],["φοβούμενοι",713532,348],["κύριον",707996,6],["ἑτοιμάσουσιν",705539,218],["καρδίας",707141,39],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["ταπεινώσουσιν",712717,218],["τὰς",709436,38],["ψυχὰς",714070,39],["αὐτῶν",702165,40]],"They that fear the Lord will prepare their hearts, and humble their souls in his sight,"],["18",[["ἐμπεσούμεθα",704593,141],["εἰς",704105,0],["χεῖρας",713787,39],["κυρίου",707996,18],["καὶ",707031,7],["οὐκ",709805,28],["εἰς",704105,0],["χεῖρας",713787,39],["ἀνθρώπων",701163,81],["ὡς",714148,7],["γὰρ",702963,11],["ἡ",709436,10],["μεγαλωσύνη",708652,12],["αὐτοῦ",702165,102],["οὕτως",709859,28],["καὶ",707031,28],["τὸ",709436,34],["ἔλεος",704426,15],["αὐτοῦ",702165,102]],"[saying], We will fall into the hands of the Lord, and not into the hands of men: for as his majesty is, so is his mercy."]]