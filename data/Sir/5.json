[["1",[["μὴ",708851,28],["ἔπεχε",705076,240],["ἐπὶ",705080,0],["τοῖς",709436,95],["χρήμασίν",713948,96],["σου",711945,133],["καὶ",707031,7],["μὴ",708851,28],["εἴπῃς",705373,175],["αὐτάρκη",702157,195],["μοί",708974,159],["ἐστιν",704093,91]],"Set not thy heart upon thy goods; and say not, I have enough for my life."],["2",[["μὴ",708851,28],["ἐξακολούθει",704845,240],["τῇ",709436,100],["ψυχῇ",714070,1],["σου",711945,133],["καὶ",707031,7],["τῇ",709436,100],["ἰσχύι",706858,1],["σου",711945,133],["πορεύεσθαι",710667,110],["ἐν",704639,0],["ἐπιθυμίαις",705147,76],["καρδίας",707141,17],["σου",711945,133]],"Follow not thine own mind and thy strength, to walk in the ways of thy heart:"],["3",[["καὶ",707031,7],["μὴ",708851,28],["εἴπῃς",705373,175],["τίς",712867,158],["με",708618,163],["δυναστεύσει",703843,127],["ὁ",709436,3],["γὰρ",702963,11],["κύριος",707996,4],["ἐκδικῶν",704174,72],["ἐκδικήσει",704175,1]],"and say not, Who shall control me for my works? for the Lord will surely revenge thy pride."],["4",[["μὴ",708851,28],["εἴπῃς",705373,175],["ἥμαρτον",700773,155],["καὶ",707031,7],["τί",712867,273],["μοι",708974,159],["ἐγένετο",703104,23],["ὁ",709436,3],["γὰρ",702963,11],["κύριός",707996,4],["ἐστιν",704093,91],["μακρόθυμος",708420,14]],"Say not, I have sinned, and what harm hath happened unto me? for the Lord is longsuffering, he will in no wise let thee go."],["5",[["περὶ",710285,0],["ἐξιλασμοῦ",704934,18],["μὴ",708851,28],["ἄφοβος",702217,14],["γίνου",703104,253],["προσθεῖναι",710965,106],["ἁμαρτίαν",700775,9],["ἐφ᾿",705080,0],["ἁμαρτίαις",700775,76]],"Concerning propitiation, be not without fear to add sin unto sin:"],["6",[["καὶ",707031,7],["μὴ",708851,28],["εἴπῃς",705373,175],["ὁ",709436,3],["οἰκτιρμὸς",709520,4],["αὐτοῦ",702165,102],["πολύς",710646,14],["τὸ",709436,24],["πλῆθος",710529,25],["τῶν",709436,130],["ἁμαρτιῶν",700775,65],["μου",709032,133],["ἐξιλάσεται",704932,93],["ἔλεος",704426,15],["γὰρ",702963,11],["καὶ",707031,7],["ὀργὴ",709728,12],["παρ᾿",709995,0],["αὐτῷ",702165,50],["καὶ",707031,7],["ἐπὶ",705080,0],["ἁμαρτωλοὺς",700776,60],["καταπαύσει",707364,1],["ὁ",709436,3],["θυμὸς",706334,4],["αὐτοῦ",702165,102]],"and say not, His mercy is great; he will be pacified for the multitude of my sins: for mercy and wrath come from him, and his indignation resteth upon sinners."],["7",[["μὴ",708851,28],["ἀνάμενε",701000,240],["ἐπιστρέψαι",705278,106],["πρὸς",710844,0],["κύριον",707996,6],["καὶ",707031,7],["μὴ",708851,28],["ὑπερβάλλου",713127,253],["ἡμέραν",705984,9],["ἐξ",704132,0],["ἡμέρας",705984,17],["ἐξάπινα",704868,28],["γὰρ",702963,11],["ἐξελεύσεται",704909,93],["ὀργὴ",709728,12],["κυρίου",707996,18],["καὶ",707031,7],["ἐν",704639,0],["καιρῷ",707047,114],["ἐκδικήσεως",704175,17],["ἐξολῇ",704955,123]],"Make no tarrying to turn to the Lord, and put not off from day to day: for suddenly shall the wrath of the Lord come forth, and in thy security thou shalt be destroyed, and perish in the day of vengeance."],["8",[["μὴ",708851,28],["ἔπεχε",705076,240],["ἐπὶ",705080,0],["χρήμασιν",713948,96],["ἀδίκοις",700272,230],["οὐδὲν",709817,26],["γὰρ",702963,11],["ὠφελήσει",714171,127],["σε",711598,163],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["ἐπαγωγῆς",704995,17]],"Set not thine heart upon goods unjustly gotten; for they shall not profit thee in the day of calamity."],["9",[["μὴ",708851,28],["λίκμα",708202,240],["ἐν",704639,0],["παντὶ",710177,30],["ἀνέμῳ",701123,114],["καὶ",707031,7],["μὴ",708851,28],["πορεύου",710667,253],["ἐν",704639,0],["πάσῃ",710177,101],["ἀτραπῷ",702106,1],["οὕτως",709859,28],["ὁ",709436,3],["ἁμαρτωλὸς",700776,14],["ὁ",709436,3],["δίγλωσσος",703644,14]],"Winnow not with every wind, and go not into every way: for so doth the sinner that hath a double tongue."],["10",[["ἴσθι",704093,240],["ἐστηριγμένος",712098,419],["ἐν",704639,0],["συνέσει",712460,1],["σου",711945,133],["καὶ",707031,7],["εἷς",704106,59],["ἔστω",704093,31],["σου",711945,133],["ὁ",709436,3],["λόγος",708236,4]],"Be stedfast in thy understanding; and let thy word be the same."],["11",[["γίνου",703104,253],["ταχὺς",712750,14],["ἐν",704639,0],["ἀκροάσει",700603,1],["σου",711945,133],["καὶ",707031,7],["ἐν",704639,0],["μακροθυμίᾳ",708419,1],["φθέγγου",713442,253],["ἀπόκρισιν",701493,9]],"Be swift to hear; and let thy life be sincere; and with patience give answer."],["12",[["εἰ",704071,7],["ἔστιν",704093,91],["σοι",711925,159],["σύνεσις",712460,12],["ἀποκρίθητι",701492,244],["τῷ",709436,113],["πλησίον",710547,28],["εἰ",704071,7],["δὲ",703303,11],["μή",708851,28],["ἡ",709436,10],["χείρ",713787,12],["σου",711945,133],["ἔστω",704093,31],["ἐπὶ",705080,0],["τῷ",709436,53],["στόματί",712125,54],["σου",711945,133]],"If thou hast understanding, answer thy neighbour; if not, lay thy hand upon thy mouth."],["13",[["δόξα",703791,12],["καὶ",707031,7],["ἀτιμία",702094,12],["ἐν",704639,0],["λαλιᾷ",708074,1],["καὶ",707031,7],["γλῶσσα",703120,12],["ἀνθρώπου",701163,18],["πτῶσις",711072,12],["αὐτῷ",702165,50]],"Honour and shame is in talk: and the tongue of man is his fall."],["14",[["μὴ",708851,28],["κληθῇς",707084,279],["ψίθυρος",714055,14],["καὶ",707031,7],["τῇ",709436,100],["γλώσσῃ",703120,1],["σου",711945,133],["μὴ",708851,28],["ἐνέδρευε",704703,240],["ἐπὶ",705080,0],["γὰρ",702963,11],["τῷ",709436,113],["κλέπτῃ",707714,114],["ἐστὶν",704093,91],["αἰσχύνη",700483,12],["καὶ",707031,7],["κατάγνωσις",707228,12],["πονηρὰ",710660,29],["ἐπὶ",705080,0],["διγλώσσου",703644,116]],"Be not called a whisperer, and lie not in wait with thy tongue: for a foul shame is upon the thief, and an evil condemnation upon the double tongue."],["15",[["ἐν",704639,0],["μεγάλῳ",708653,97],["καὶ",707031,7],["ἐν",704639,0],["μικρῷ",708915,97],["μὴ",708851,28],["ἀγνόει",700175,240],["καὶ",707031,7],["ἀντὶ",701227,0],["φίλου",713492,116],["μὴ",708851,28],["γίνου",703104,253],["ἐχθρός",705779,14],["ὄνομα",709666,15],["γὰρ",702963,11],["πονηρὸν",710660,26],["αἰσχύνην",700483,9],["καὶ",707031,7],["ὄνειδος",709658,25],["κληρονομήσει",707724,127],["οὕτως",709859,28],["ὁ",709436,3],["ἁμαρτωλὸς",700776,14],["ὁ",709436,3],["δίγλωσσος",703644,14]],"Be not ignorant of any thing in a great matter or a small."]]