[["1",[["τέκνον",712761,297],["τὴν",709436,8],["ζωὴν",705910,9],["τοῦ",709436,35],["πτωχοῦ",711076,18],["μὴ",708851,28],["ἀποστερήσῃς",701595,175],["καὶ",707031,7],["μὴ",708851,28],["παρελκύσῃς",710131,175],["ὀφθαλμοὺς",709870,57],["ἐπιδεεῖς",705111,60]],"My son, defraud not the poor of his living, and make not the needy eyes to wait long."],["2",[["ψυχὴν",714070,9],["πεινῶσαν",710222,78],["μὴ",708851,28],["λυπήσῃς",708272,175],["καὶ",707031,7],["μὴ",708851,28],["παροργίσῃς",710167,175],["ἄνδρα",701150,6],["ἐν",704639,0],["ἀπορίᾳ",701560,1],["αὐτοῦ",702165,102]],"Make not a hungry soul sorrowful; neither provoke a man in his distress."],["3",[["καρδίαν",707141,9],["παρωργισμένην",710167,444],["μὴ",708851,28],["προσταράξῃς",710960,175],["καὶ",707031,7],["μὴ",708851,28],["παρελκύσῃς",710131,175],["δόσιν",703809,9],["προσδεομένου",710873,262]],"Add not more trouble to a heart that is vexed; and defer not to give to him that is in need."],["4",[["ἱκέτην",706718,6],["θλιβόμενον",706274,212],["μὴ",708851,28],["ἀπαναίνου",701342,253],["καὶ",707031,7],["μὴ",708851,28],["ἀποστρέψῃς",701598,175],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["ἀπὸ",701425,0],["πτωχοῦ",711076,18]],"Reject not the supplication of the afflicted; neither turn away thy face from a poor man."],["5",[["ἀπὸ",701425,0],["δεομένου",703394,262],["μὴ",708851,28],["ἀποστρέψῃς",701598,175],["ὀφθαλμὸν",709870,6],["καὶ",707031,7],["μὴ",708851,28],["δῷς",703654,175],["τόπον",712903,6],["ἀνθρώπῳ",701163,114],["καταράσασθαί",707396,109],["σε",711598,163]],"Turn not away thine eye from the needy, and give him none occasion to curse thee:"],["6",[["καταρωμένου",707396,262],["γάρ",702963,11],["σε",711598,163],["ἐν",704639,0],["πικρίᾳ",710472,1],["ψυχῆς",714070,17],["αὐτοῦ",702165,102],["τῆς",709436,16],["δεήσεως",703311,17],["αὐτοῦ",702165,102],["ἐπακούσεται",705009,93],["ὁ",709436,3],["ποιήσας",710582,182],["αὐτόν",702165,85]],"for if he curse thee in the bitterness of his soul, his prayer shall be heard of him that made him."],["7",[["προσφιλῆ",710975,27],["συναγωγῇ",712376,1],["σεαυτὸν",711599,85],["ποίει",710582,240],["καὶ",707031,7],["μεγιστᾶνι",708657,114],["ταπείνου",712717,240],["τὴν",709436,8],["κεφαλήν",707639,9],["σου",711945,133]],"Get thyself the love of the congregation, and bow thy head to a great man."],["8",[["κλῖνον",707738,176],["πτωχῷ",711076,114],["τὸ",709436,24],["οὖς",709852,25],["σου",711945,133],["καὶ",707031,7],["ἀποκρίθητι",701492,244],["αὐτῷ",702165,50],["εἰρηνικὰ",704099,68],["ἐν",704639,0],["πραΰτητι",710726,1]],"Let it not grieve thee to bow down thine ear to the poor, and give him a friendly answer with meekness."],["9",[["ἐξελοῦ",704838,300],["ἀδικούμενον",700269,212],["ἐκ",704132,0],["χειρὸς",713787,17],["ἀδικοῦντος",700269,152],["καὶ",707031,7],["μὴ",708851,28],["ὀλιγοψυχήσῃς",709572,175],["ἐν",704639,0],["τῷ",709436,53],["κρίνειν",707905,55],["σε",711598,163]],"Deliver him that suffereth wrong from the hand of the oppressor; and be not fainthearted when thou sittest in judgment."],["10",[["γίνου",703104,253],["ὀρφανοῖς",709779,230],["ὡς",714148,7],["πατὴρ",710189,4],["καὶ",707031,7],["ἀντὶ",701227,0],["ἀνδρὸς",701150,18],["τῇ",709436,100],["μητρὶ",708892,1],["αὐτῶν",702165,40],["καὶ",707031,7],["ἔσῃ",704093,123],["ὡς",714148,7],["υἱὸς",713075,4],["ὑψίστου",713287,116],["καὶ",707031,7],["ἀγαπήσει",700120,127],["σε",711598,163],["μᾶλλον",708448,28],["ἢ",705924,28],["μήτηρ",708892,12],["σου",711945,133]],"Be as a father unto the fatherless, and instead of a husband unto their mother: so shalt thou be as the son of the most High, and he shall love thee more than thy mother doth."],["11",[["ἡ",709436,10],["σοφία",711981,12],["υἱοὺς",713075,57],["αὐτῆς",702165,86],["ἀνύψωσεν",701293,2],["καὶ",707031,7],["ἐπιλαμβάνεται",705185,117],["τῶν",709436,80],["ζητοῦντων",705879,170],["αὐτήν",702165,104]],"Wisdom exalteth her children, and layeth hold of them that seek her."],["12",[["ὁ",709436,3],["ἀγαπῶν",700120,72],["αὐτὴν",702165,104],["ἀγαπᾷ",700120,91],["ζωήν",705910,9],["καὶ",707031,7],["οἱ",709436,136],["ὀρθρίζοντες",709742,146],["πρὸς",710844,0],["αὐτὴν",702165,104],["ἐμπλησθήσονται",704592,144],["εὐφροσύνης",705717,17]],"He that loveth her loveth life; and they that seek to her early shall be filled with joy."],["13",[["ὁ",709436,3],["κρατῶν",707879,72],["αὐτῆς",702165,86],["κληρονομήσει",707724,127],["δόξαν",703791,9],["καὶ",707031,7],["οὗ",709806,28],["εἰσπορεύεται",704124,117],["εὐλογεῖ",705631,91],["κύριος",707996,4]],"He that holdeth her fast shall inherit glory; and wheresoever she entereth, the Lord will bless."],["14",[["οἱ",709436,136],["λατρεύοντες",708108,146],["αὐτῇ",702165,105],["λειτουργήσουσιν",708132,218],["ἁγίῳ",700159,30],["καὶ",707031,7],["τοὺς",709436,58],["ἀγαπῶντας",700120,235],["αὐτὴν",702165,104],["ἀγαπᾷ",700120,91],["ὁ",709436,3],["κύριος",707996,4]],"They that serve her shall minister to the Holy One: and them that love her the Lord doth love."],["15",[["ὁ",709436,3],["ὑπακούων",713096,72],["αὐτῆς",702165,86],["κρινεῖ",707905,127],["ἔθνη",704068,42],["καὶ",707031,7],["ὁ",709436,3],["προσέχων",710895,72],["αὐτῇ",702165,105],["κατασκηνώσει",707423,127],["πεποιθώς",710221,270]],"Whoso giveth ear unto her shall judge the nations: and he that attendeth unto her shall dwell securely."],["16",[["ἐὰν",703912,7],["ἐμπιστεύσῃ",704594,172],["κατακληρονομήσει",707274,127],["αὐτήν",702165,104],["καὶ",707031,7],["ἐν",704639,0],["κατασχέσει",707451,1],["ἔσονται",704093,135],["αἱ",709436,190],["γενεαὶ",703037,191],["αὐτοῦ",702165,102]],"If a man commit himself unto her, he shall inherit her; and his generation shall hold her in possession."],["17",[["ὅτι",709803,7],["διεστραμμένως",703675,28],["πορεύσεται",710667,93],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἐν",704639,0],["πρώτοις",711041,94],["φόβον",713534,6],["καὶ",707031,7],["δειλίαν",703319,9],["ἐπάξει",704994,127],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["καὶ",707031,7],["βασανίσει",702566,127],["αὐτὸν",702165,85],["ἐν",704639,0],["παιδείᾳ",709924,1],["αὐτῆς",702165,86],["ἕως",705792,7],["οὗ",709806,28],["ἐμπιστεύσῃ",704594,172],["τῇ",709436,100],["ψυχῇ",714070,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["πειράσει",710225,127],["αὐτὸν",702165,85],["ἐν",704639,0],["τοῖς",709436,95],["δικαιώμασιν",703697,96],["αὐτῆς",702165,86]],"For at the first she will walk with him by crooked ways, and bring fear and dread upon him, and torment him with her discipline, until she may trust his soul, and try him by her laws."],["18",[["καὶ",707031,7],["πάλιν",709942,28],["ἐπανήξει",705024,127],["κατ᾿",707200,0],["εὐθεῖαν",705602,36],["πρὸς",710844,0],["αὐτὸν",702165,85],["καὶ",707031,7],["εὐφρανεῖ",705715,127],["αὐτὸν",702165,85],["καὶ",707031,7],["ἀποκαλύψει",701474,127],["αὐτῷ",702165,50],["τὰ",709436,41],["κρυπτὰ",707922,68],["αὐτῆς",702165,86]],"Then will she return the straight way unto him, and comfort him, and shew him her secrets."],["19",[["ἐὰν",703912,7],["ἀποπλανηθῇ",701547,384],["ἐγκαταλείψει",703967,127],["αὐτὸν",702165,85],["καὶ",707031,7],["παραδώσει",710014,127],["αὐτὸν",702165,85],["εἰς",704105,0],["χεῖρας",713787,39],["πτώσεως",711072,17],["αὐτοῦ",702165,102]],"But if he go wrong, she will forsake him, and give him over to his own ruin."],["20",[["συντήρησον",712512,176],["καιρὸν",707047,6],["καὶ",707031,7],["φύλαξαι",713619,300],["ἀπὸ",701425,0],["πονηροῦ",710660,116],["καὶ",707031,7],["περὶ",710285,0],["τῆς",709436,16],["ψυχῆς",714070,17],["σου",711945,133],["μὴ",708851,28],["αἰσχυνθῇς",700485,279]],"Observe the opportunity, and beware of evil; and be not ashamed when it concerneth thy soul."],["21",[["ἔστιν",704093,91],["γὰρ",702963,11],["αἰσχύνη",700483,12],["ἐπάγουσα",704994,188],["ἁμαρτίαν",700775,9],["καὶ",707031,7],["ἔστιν",704093,91],["αἰσχύνη",700483,12],["δόξα",703791,12],["καὶ",707031,7],["χάρις",713735,12]],"For there is a shame that bringeth sin; and there is a shame which is glory and grace."],["22",[["μὴ",708851,28],["λάβῃς",708076,175],["πρόσωπον",710986,25],["κατὰ",707200,0],["τῆς",709436,16],["ψυχῆς",714070,17],["σου",711945,133],["καὶ",707031,7],["μὴ",708851,28],["ἐντραπῇς",704805,175],["εἰς",704105,0],["πτῶσίν",711072,9],["σου",711945,133]],"Accept no person against thy soul, and let not the reverence of any man cause thee to fall."],["23",[["μὴ",708851,28],["κωλύσῃς",708020,175],["λόγον",708236,6],["ἐν",704639,0],["καιρῷ",707047,114],["χρείας",713938,17]],"And refrain not to speak, when there is occasion to do good, and hide not thy wisdom in her beauty."],["24",[["ἐν",704639,0],["γὰρ",702963,11],["λόγῳ",708236,114],["γνωσθήσεται",703105,134],["σοφία",711981,12],["καὶ",707031,7],["παιδεία",709924,12],["ἐν",704639,0],["ῥήματι",711246,54],["γλώσσης",703120,17]],"For by speech wisdom shall be known: and learning by the word of the tongue."],["25",[["μὴ",708851,28],["ἀντίλεγε",701245,240],["τῇ",709436,100],["ἀληθείᾳ",700656,1],["καὶ",707031,7],["περὶ",710285,0],["τῆς",709436,16],["ἀπαιδευσίας",701327,17],["σου",711945,133],["ἐντράπηθι",704805,244]],"In no wise speak against the truth; but be abashed of the error of thine ignorance."],["26",[["μὴ",708851,28],["αἰσχυνθῇς",700485,279],["ὁμολογῆσαι",709632,106],["ἐφ᾿",705080,0],["ἁμαρτίαις",700775,76],["σου",711945,133],["καὶ",707031,7],["μὴ",708851,28],["βιάζου",702713,253],["ῥοῦν",711299,6],["ποταμοῦ",710693,18]],"Be not ashamed to confess thy sins; and force not the course of the river."],["27",[["καὶ",707031,7],["μὴ",708851,28],["ὑποστρώσῃς",713247,175],["ἀνθρώπῳ",701163,114],["μωρῷ",709110,30],["σεαυτὸν",711599,85],["καὶ",707031,7],["μὴ",708851,28],["λάβῃς",708076,175],["πρόσωπον",710986,25],["δυνάστου",703844,18]],"Make not thyself an underling to a foolish man; neither accept the person of the mighty."],["28",[["ἕως",705792,0],["θανάτου",706096,18],["ἀγώνισαι",700214,300],["περὶ",710285,0],["τῆς",709436,16],["ἀληθείας",700656,17],["καὶ",707031,7],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["πολεμήσει",710601,127],["ὑπὲρ",713111,0],["σοῦ",711945,133]],"Strive for the truth unto death, and the Lord shall fight for thee."],["29",[["μὴ",708851,28],["γίνου",703104,253],["θρασὺς",706300,14],["ἐν",704639,0],["γλώσσῃ",703120,1],["σου",711945,133],["καὶ",707031,7],["νωθρὸς",709398,14],["καὶ",707031,7],["παρειμένος",710149,419],["ἐν",704639,0],["τοῖς",709436,95],["ἔργοις",705396,96],["σου",711945,133]],"Be not hasty in thy tongue, and in thy deeds slack and remiss."],["30",[["μὴ",708851,28],["ἴσθι",704093,240],["ὡς",714148,7],["λέων",708171,4],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["σου",711945,133],["καὶ",707031,7],["φαντασιοκοπῶν",713348,72],["ἐν",704639,0],["τοῖς",709436,147],["οἰκέταις",709496,148],["σου",711945,133]],"Be not as a lion in thy house, nor frantic among thy servants."],["31",[["μὴ",708851,28],["ἔστω",704093,31],["ἡ",709436,10],["χείρ",713787,12],["σου",711945,133],["ἐκτεταμένη",704322,203],["εἰς",704105,0],["τὸ",709436,24],["λαβεῖν",708076,106],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἀποδιδόναι",701449,55],["συνεσταλμένη",712558,203]],"Let not thine hand be stretched out to receive, and shut when thou shouldest repay."]]