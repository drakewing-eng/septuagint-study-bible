[["1",[["πᾶς",710177,14],["φίλος",713492,14],["ἐρεῖ",705415,127],["ἐφιλίασα",713475,155],["κἀγώ",706969,288],["ἀλλ᾿",700680,7],["ἔστιν",704093,91],["φίλος",713492,14],["ὀνόματι",709666,54],["μόνον",709001,28],["φίλος",713492,14]],"Every friend saith, I am his friend also: but there is a friend, which is only a friend in name."],["2",[["οὐχὶ",709862,28],["λύπη",708273,12],["ἔνι",704743,91],["ἕως",705792,0],["θανάτου",706096,18],["ἑταῖρος",705529,4],["καὶ",707031,7],["φίλος",713492,14],["τρεπόμενος",712929,122],["εἰς",704105,0],["ἔχθραν",705779,36]],"Is it not a grief unto death, when a companion and friend is turned to an enemy?"],["3",[["ὦ",714081,88],["πονηρὸν",710660,719],["ἐνθύμημα",704740,297],["πόθεν",710580,28],["ἐνεκυλίσθης",703999,168],["καλύψαι",707102,106],["τὴν",709436,8],["ξηρὰν",709421,36],["ἐν",704639,0],["δολιότητι",703784,1]],"O wicked imagination, whence camest thou in to cover the earth with deceit?"],["4",[["ἑταῖρος",705529,4],["φίλου",713492,116],["ἐν",704639,0],["εὐφροσύνῃ",705717,1],["ἥδεται",705941,117],["καὶ",707031,7],["ἐν",704639,0],["καιρῷ",707047,114],["θλίψεως",706276,17],["ἔσται",704093,93],["ἀπέναντι",701389,28]],"There is a companion, which rejoiceth in the prosperity of a friend, but in the time of trouble will be against him."],["5",[["ἑταῖρος",705529,4],["φίλῳ",713492,30],["συμπονεῖ",712341,91],["χάριν",713735,9],["γαστρός",702976,17],["ἔναντι",704653,0],["πολέμου",710605,18],["λήμψεται",708076,93],["ἀσπίδα",701991,9]],"There is a companion, which helpeth his friend for the belly, and taketh up the buckler against the enemy."],["6",[["μὴ",708851,28],["ἐπιλάθῃ",705187,420],["φίλου",713492,116],["ἐν",704639,0],["τῇ",709436,100],["ψυχῇ",714070,1],["σου",711945,133],["καὶ",707031,7],["μὴ",708851,28],["ἀμνημονήσῃς",700850,175],["αὐτοῦ",702165,102],["ἐν",704639,0],["χρήμασίν",713948,96],["σου",711945,133]],"Forget not thy friend in thy mind, and be not unmindful of him in thy riches."],["7",[["πᾶς",710177,14],["σύμβουλος",712295,4],["ἐξαίρει",704839,91],["βουλήν",702792,9],["ἀλλ᾿",700680,7],["ἔστιν",704093,91],["συμβουλεύων",712292,72],["εἰς",704105,0],["ἑαυτόν",703917,85]],"Every counsellor extolleth counsel; but there is some that counselleth for himself."],["8",[["ἀπὸ",701425,0],["συμβούλου",712295,18],["φύλαξον",713619,176],["τὴν",709436,8],["ψυχήν",714070,9],["σου",711945,133],["καὶ",707031,7],["γνῶθι",703105,176],["πρότερον",710991,28],["τίς",712867,359],["αὐτοῦ",702165,102],["χρεία",713938,12],["καὶ",707031,28],["γὰρ",702963,11],["αὐτὸς",702165,121],["ἑαυτῷ",703917,50],["βουλεύσεται",702791,93],["μήποτε",708882,28],["βάλῃ",702487,172],["ἐπὶ",705080,0],["σοὶ",711925,159],["κλῆρον",707727,6]],"Beware of a counsellor, and know before what need he hath; for he will counsel for himself; lest he cast the lot upon thee,"],["9",[["καὶ",707031,7],["εἴπῃ",705373,172],["σοι",711925,159],["καλὴ",707097,29],["ἡ",709436,10],["ὁδός",709458,12],["σου",711945,133],["καὶ",707031,7],["στήσεται",706846,93],["ἐξ",704132,0],["ἀναντίας",701018,17],["ἰδεῖν",709725,106],["τὸ",709436,24],["συμβησόμενόν",712277,400],["σοι",711925,159]],"and say unto thee, Thy way is good: and afterward he stand on the other side, to see what shall befall thee."],["10",[["μὴ",708851,28],["βουλεύου",702791,253],["μετὰ",708780,0],["τοῦ",709436,35],["ὑποβλεπομένου",713186,262],["σε",711598,163],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,80],["ζηλούντων",705873,170],["σε",711598,163],["κρύψον",707923,176],["βουλήν",702792,9]],"Consult not with one that suspecteth thee: and hide thy counsel from such as envy thee."],["11",[["μετὰ",708780,0],["γυναικὸς",703209,17],["περὶ",710285,0],["τῆς",709436,16],["ἀντιζήλου",701235,17],["αὐτῆς",702165,86],["καὶ",707031,7],["μετὰ",708780,0],["δειλοῦ",703324,116],["περὶ",710285,0],["πολέμου",710605,18],["μετὰ",708780,0],["ἐμπόρου",704614,18],["περὶ",710285,0],["μεταβολίας",708785,17],["καὶ",707031,7],["μετὰ",708780,0],["ἀγοράζοντος",700184,152],["περὶ",710285,0],["πράσεως",710719,17],["μετὰ",708780,0],["βασκάνου",702589,18],["περὶ",710285,0],["εὐχαριστίας",705722,17],["καὶ",707031,7],["μετὰ",708780,0],["ἀνελεήμονος",701120,116],["περὶ",710285,0],["χρηστοηθείας",713957,17],["μετὰ",708780,0],["ὀκνηροῦ",709550,116],["περὶ",710285,0],["παντὸς",710177,92],["ἔργου",705396,21],["καὶ",707031,7],["μετὰ",708780,0],["μισθίου",708938,116],["ἐφετίου",705747,116],["περὶ",710285,0],["συντελείας",712509,17],["οἰκέτῃ",709496,114],["ἀργῷ",701704,30],["περὶ",710285,0],["πολλῆς",710646,82],["ἐργασίας",705385,17],["μὴ",708851,28],["ἔπεχε",705076,240],["ἐπὶ",705080,0],["τούτοις",709858,151],["περὶ",710285,0],["πάσης",710177,82],["συμβουλίας",712293,17]],"Neither consult with a woman touching her of whom she is jealous; neither with a coward in matters of war; nor with a merchant concerning exchange; nor with a buyer of selling; nor with an envious man of thankfulness; nor with an unmerciful man touching kindness; nor with the slothful for any work; nor with an hireling for a year of finishing work; nor with an idle servant of much business: hearken not unto these in any matter of counsel."],["12",[["ἀλλ᾿",700680,7],["ἢ",705924,7],["μετὰ",708780,0],["ἀνδρὸς",701150,18],["εὐσεβοῦς",705687,116],["ἐνδελέχιζε",704679,240],["ὃν",709781,112],["ἂν",700900,11],["ἐπιγνῷς",705104,176],["συντηροῦντα",712512,183],["ἐντολάς",704802,39],["ὃς",709781,213],["ἐν",704639,0],["τῇ",709436,100],["ψυχῇ",714070,1],["αὐτοῦ",702165,102],["κατὰ",707200,0],["τὴν",709436,8],["ψυχήν",714070,9],["σου",711945,133],["καὶ",707031,7],["ἐὰν",703912,7],["πταίσῃς",711048,175],["συναλγήσει",712381,127],["σοι",711925,159]],"But be continually with a godly man, whom thou knowest to keep the commandments of the Lord, whose mind is according to thy mind, and will sorrow with thee, if thou shalt miscarry."],["13",[["καὶ",707031,7],["βουλὴν",702792,9],["καρδίας",707141,17],["στῆσον",706846,176],["οὐ",709805,28],["γὰρ",702963,11],["ἔστιν",704093,91],["σοι",711925,159],["πιστότερος",710486,224],["αὐτῆς",702165,86]],"And let the counsel of thine own heart stand: for there is no man more faithful unto thee than it;"],["14",[["ψυχὴ",714070,12],["γὰρ",702963,11],["ἀνδρὸς",701150,18],["ἀπαγγέλλειν",701321,55],["ἐνίοτε",704748,28],["εἴωθεν",704070,171],["ἢ",705924,7],["ἑπτὰ",705357,59],["σκοποὶ",711877,52],["ἐπὶ",705080,0],["μετεώρου",708831,92],["καθήμενοι",707000,348],["ἐπὶ",705080,0],["σκοπῆς",711875,17]],"for a man's mind is sometime wont to tell him more than seven watchmen, that sit above in an high tower."],["15",[["καὶ",707031,7],["ἐπὶ",705080,0],["πᾶσι",710177,94],["τούτοις",709858,206],["δεήθητι",703394,244],["ὑψίστου",713287,116],["ἵνα",706747,7],["εὐθύνῃ",705601,172],["ἐν",704639,0],["ἀληθείᾳ",700656,1],["τὴν",709436,8],["ὁδόν",709458,9],["σου",711945,133]],"And above all this pray to the most High, that he will direct thy way in truth."],["16",[["ἀρχὴ",701836,12],["παντὸς",710177,92],["ἔργου",705396,21],["λόγος",708236,4],["καὶ",707031,7],["πρὸ",710747,0],["πάσης",710177,82],["πράξεως",710714,17],["βουλή",702792,12]],"Let reason go before every enterprize, and counsel before every action."],["17",[["ἴχνος",706873,15],["ἀλλοιώσεως",700695,17],["καρδίας",707141,17],["τέσσαρα",712808,195],["μέρη",708752,64],["ἀνατέλλει",701066,91]],"The countenance is a sign of changing of the heart."],["18",[["ἀγαθὸν",700106,26],["καὶ",707031,7],["κακόν",707066,26],["ζωὴ",705910,12],["καὶ",707031,7],["θάνατος",706096,4],["καὶ",707031,7],["ἡ",709436,10],["κυριεύουσα",707995,188],["ἐνδελεχῶς",704681,28],["αὐτῶν",702165,70],["γλῶσσά",703120,12],["ἐστιν",704093,91]],"Four manners of things appear: good and evil, life and death: but the tongue ruleth over them continually."],["19",[["ἔστιν",704093,91],["ἀνὴρ",701150,4],["πανοῦργος",709972,14],["πολλῶν",710646,169],["παιδευτής",709925,4],["καὶ",707031,7],["τῇ",709436,100],["ἰδίᾳ",706493,101],["ψυχῇ",714070,1],["ἐστιν",704093,91],["ἄχρηστος",702312,14]],"There is one that is wise and teacheth many, and yet is unprofitable to himself."],["20",[["ἔστιν",704093,91],["σοφιζόμενος",711982,122],["ἐν",704639,0],["λόγοις",708236,148],["μισητός",708936,14],["οὗτος",709858,121],["πάσης",710177,82],["τροφῆς",712984,17],["καθυστερήσει",707027,127]],"There is one that sheweth wisdom in words, and is hated: he shall be destitute of all food."],["21",[["οὐ",709805,28],["γὰρ",702963,11],["ἐδόθη",703654,37],["αὐτῷ",702165,50],["παρὰ",709995,0],["κυρίου",707996,18],["χάρις",713735,12],["ὅτι",709803,7],["πάσης",710177,82],["σοφίας",711981,17],["ἐστερήθη",712076,37]],"For grace is not given him from the Lord; because he is deprived of all wisdom."],["22",[["ἔστιν",704093,91],["σοφὸς",711985,14],["τῇ",709436,100],["ἰδίᾳ",706493,101],["ψυχῇ",714070,1],["καὶ",707031,7],["οἱ",709436,136],["καρποὶ",707169,52],["τῆς",709436,16],["συνέσεως",712460,17],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["στόματος",712125,21],["πιστοί",710486,138]],"Another is wise to himself; and the fruits of understanding are commendable in his mouth."],["23",[["ἀνὴρ",701150,4],["σοφὸς",711985,14],["τὸν",709436,5],["ἑαυτοῦ",703917,102],["λαὸν",708094,6],["παιδεύσει",709926,127],["καὶ",707031,7],["οἱ",709436,136],["καρποὶ",707169,52],["τῆς",709436,16],["συνέσεως",712460,17],["αὐτοῦ",702165,102],["πιστοί",710486,138]],"A wise man instructeth his people; and the fruits of his understanding fail not."],["24",[["ἀνὴρ",701150,4],["σοφὸς",711985,14],["πλησθήσεται",710532,134],["εὐλογίας",705633,17],["καὶ",707031,7],["μακαριοῦσιν",708396,218],["αὐτὸν",702165,85],["πάντες",710177,138],["οἱ",709436,136],["ὁρῶντες",709725,146]],"A wise man shall be filled with blessing; and all they that see him shall count him happy."],["25",[["ζωὴ",705910,12],["ἀνδρὸς",701150,18],["ἐν",704639,0],["ἀριθμῷ",701744,114],["ἡμερῶν",705984,65],["καὶ",707031,7],["αἱ",709436,190],["ἡμέραι",705984,191],["τοῦ",709436,35],["Ισραηλ",706839,18],["ἀναρίθμητοι",701047,192]],"The days of the life of man may be numbered; but the days of Israel are innumerable."],["26",[["ὁ",709436,3],["σοφὸς",711985,14],["ἐν",704639,0],["τῷ",709436,113],["λαῷ",708094,114],["αὐτοῦ",702165,102],["κληρονομήσει",707724,127],["πίστιν",710484,9],["καὶ",707031,7],["τὸ",709436,34],["ὄνομα",709666,15],["αὐτοῦ",702165,102],["ζήσεται",705851,93],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"A wise man shall inherit glory among his people, and his name shall be perpetual."],["27",[["τέκνον",712761,297],["ἐν",704639,0],["ζωῇ",705910,1],["σου",711945,133],["πείρασον",710225,176],["τὴν",709436,8],["ψυχήν",714070,9],["σου",711945,133],["καὶ",707031,7],["ἰδὲ",709725,176],["τί",712867,273],["πονηρὸν",710660,26],["αὐτῇ",702165,105],["καὶ",707031,7],["μὴ",708851,28],["δῷς",703654,175],["αὐτῇ",702165,105]],"My son, prove thy soul in thy life, and see what is evil for it, and give not that unto it."],["28",[["οὐ",709805,28],["γὰρ",702963,11],["πάντα",710177,195],["πᾶσιν",710177,230],["συμφέρει",712353,91],["καὶ",707031,7],["οὐ",709805,28],["πᾶσα",710177,29],["ψυχὴ",714070,12],["ἐν",704639,0],["παντὶ",710177,97],["εὐδοκεῖ",705565,91]],"For all things are not profitable for all men, neither hath every soul pleasure in every thing."],["29",[["μὴ",708851,28],["ἀπληστεύου",701416,253],["ἐν",704639,0],["πάσῃ",710177,101],["τρυφῇ",713008,1],["καὶ",707031,7],["μὴ",708851,28],["ἐκχυθῇς",704368,279],["ἐπὶ",705080,0],["ἐδεσμάτων",704032,44]],"Be not insatiable in any dainty thing, nor too greedy upon meats:"],["30",[["ἐν",704639,0],["πολλοῖς",710646,94],["γὰρ",702963,11],["βρώμασιν",702823,96],["ἔσται",704093,93],["νόσος",709358,12],["καὶ",707031,7],["ἡ",709436,10],["ἀπληστία",701417,12],["ἐγγιεῖ",703939,127],["ἕως",705792,0],["χολέρας",713899,17]],"for excess of meats bringeth sickness, and surfeiting will turn into choler."],["31",[["δι᾿",703417,0],["ἀπληστίαν",701417,9],["πολλοὶ",710646,138],["ἐτελεύτησαν",712781,150],["ὁ",709436,3],["δὲ",703303,11],["προσέχων",710895,72],["προσθήσει",710965,127],["ζωήν",705910,9]],"By surfeiting have many perished; but he that taketh heed prolongeth his life."]]