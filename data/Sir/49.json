[["1",[["μνημόσυνον",708966,15],["Ιωσιου",706945,18],["εἰς",704105,0],["σύνθεσιν",712475,9],["θυμιάματος",706330,21],["ἐσκευασμένον",711841,327],["ἔργῳ",705396,54],["μυρεψοῦ",709061,18],["ἐν",704639,0],["παντὶ",710177,97],["στόματι",712125,54],["ὡς",714148,7],["μέλι",708700,15],["γλυκανθήσεται",703110,134],["καὶ",707031,7],["ὡς",714148,7],["μουσικὰ",709034,195],["ἐν",704639,0],["συμποσίῳ",712345,54],["οἴνου",709530,18]],"The remembrance of Josias is like the composition of the perfume that is made by the art of the apothecary: it is sweet as honey in all mouths, and as music at a banquet of wine."],["2",[["αὐτὸς",702165,121],["κατευθύνθη",707521,37],["ἐν",704639,0],["ἐπιστροφῇ",705279,1],["λαοῦ",708094,18],["καὶ",707031,7],["ἐξῆρεν",704839,2],["βδελύγματα",702604,42],["ἀνομίας",701192,17]],"He behaved himself uprightly in the conversion of the people, and took away the abominations of iniquity."],["3",[["κατεύθυνεν",707521,2],["πρὸς",710844,0],["κύριον",707996,6],["τὴν",709436,8],["καρδίαν",707141,9],["αὐτοῦ",702165,102],["ἐν",704639,0],["ἡμέραις",705984,76],["ἀνόμων",701194,169],["κατίσχυσεν",707531,2],["τὴν",709436,8],["εὐσέβειαν",705685,9]],"He directed his heart unto the Lord, and in the time of the ungodly he established the worship of God."],["4",[["πάρεξ",710136,0],["Δαυιδ",703232,18],["καὶ",707031,7],["Εζεκιου",704044,18],["καὶ",707031,7],["Ιωσιου",706945,18],["πάντες",710177,138],["πλημμέλειαν",710533,9],["ἐπλημμέλησαν",710534,150],["κατέλιπον",707305,150],["γὰρ",702963,11],["τὸν",709436,5],["νόμον",709349,6],["τοῦ",709436,35],["ὑψίστου",713287,116],["οἱ",709436,136],["βασιλεῖς",702580,52],["Ιουδα",706768,18],["ἐξέλιπον",704237,150]],"All, except David and Ezekias and Josias, were defective: for they forsook the law of the most High, [even] the kings of Juda failed;"],["5",[["ἔδωκαν",703654,150],["γὰρ",702963,11],["τὸ",709436,24],["κέρας",707625,25],["αὐτῶν",702165,40],["ἑτέροις",705535,230],["καὶ",707031,7],["τὴν",709436,8],["δόξαν",703791,9],["αὐτῶν",702165,40],["ἔθνει",704068,54],["ἀλλοτρίῳ",700699,97]],"for they gave their power unto others, and their glory to a strange nation."],["6",[["ἐνεπύρισαν",704622,150],["ἐκλεκτὴν",704240,36],["πόλιν",710612,9],["ἁγιάσματος",700154,21],["καὶ",707031,7],["ἠρήμωσαν",705421,150],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτῆς",702165,86]],"They burnt the chosen city of the sanctuary, and made the streets desolate, according to the prophecy of Jeremias."],["7",[["ἐν",704639,0],["χειρὶ",713787,1],["Ιερεμιου",706611,18],["ἐκάκωσαν",707073,150],["γὰρ",702963,11],["αὐτόν",702165,85],["καὶ",707031,7],["αὐτὸς",702165,121],["ἐν",704639,0],["μήτρᾳ",708894,1],["ἡγιάσθη",700153,37],["προφήτης",711009,4],["ἐκριζοῦν",704303,55],["καὶ",707031,7],["κακοῦν",707073,55],["καὶ",707031,7],["ἀπολλύειν",701513,55],["ὡσαύτως",714158,28],["οἰκοδομεῖν",709509,55],["καὶ",707031,7],["καταφυτεύειν",707487,55]],"For they entreated him evil, who nevertheless was a prophet, sanctified in his mother's womb, that he might root out, and afflict, and destroy; and that he might build up also, and plant."],["8",[["Ιεζεκιηλ",706539,4],["ὃς",709781,213],["εἶδεν",709725,2],["ὅρασιν",709721,9],["δόξης",703791,17],["ἣν",709781,131],["ὑπέδειξεν",713192,2],["αὐτῷ",702165,50],["ἐπὶ",705080,0],["ἅρματος",701768,21],["χερουβιν",713830,44]],"It was Ezekiel who saw the glorious vision, which was shewed him upon the chariot of the cherubim."],["9",[["καὶ",707031,28],["γὰρ",702963,11],["ἐμνήσθη",708960,37],["τῶν",709436,80],["ἐχθρῶν",705779,169],["ἐν",704639,0],["ὄμβρῳ",709611,114],["καὶ",707031,7],["ἀγαθῶσαι",700108,106],["τοὺς",709436,58],["εὐθύνοντας",705601,235],["ὁδούς",709458,39]],"For he made mention of the enemies under [the figure of] the rain, and directed them that went right."],["10",[["καὶ",707031,7],["τῶν",709436,80],["δώδεκα",703887,59],["προφητῶν",711009,81],["τὰ",709436,63],["ὀστᾶ",709792,64],["ἀναθάλοι",700949,225],["ἐκ",704132,0],["τοῦ",709436,35],["τόπου",712903,18],["αὐτῶν",702165,40],["παρεκάλεσαν",710039,150],["γὰρ",702963,11],["τὸν",709436,5],["Ιακωβ",706401,6],["καὶ",707031,7],["ἐλυτρώσαντο",708282,189],["αὐτοὺς",702165,62],["ἐν",704639,0],["πίστει",710484,1],["ἐλπίδος",704530,17]],"And of the twelve prophets let the memorial be blessed, and let their bones flourish again out of their place: for they comforted Jacob, and delivered them by assured hope."],["11",[["πῶς",711121,28],["μεγαλύνωμεν",708647,79],["τὸν",709436,5],["Ζοροβαβελ",705889,6],["καὶ",707031,7],["αὐτὸς",702165,121],["ὡς",714148,7],["σφραγὶς",712591,12],["ἐπὶ",705080,0],["δεξιᾶς",703360,82],["χειρός",713787,17]],"How shall we magnify Zorobabel? he was even as a signet on the right hand:"],["12",[["οὕτως",709859,28],["Ἰησοῦς",706701,4],["υἱὸς",713075,4],["Ιωσεδεκ",706944,6],["οἳ",709781,250],["ἐν",704639,0],["ἡμέραις",705984,76],["αὐτῶν",702165,40],["ᾠκοδόμησαν",709509,150],["οἶκον",709516,6],["καὶ",707031,7],["ἀνύψωσαν",701293,150],["ναὸν",709191,6],["ἅγιον",700159,27],["κυρίῳ",707996,114],["ἡτοιμασμένον",705539,439],["εἰς",704105,0],["δόξαν",703791,9],["αἰῶνος",700504,18]],"So was Jesus the son of Josedec: who in their time builded the house, and set up an holy temple to the Lord, which was prepared for everlasting glory."],["13",[["καὶ",707031,7],["Νεεμιου",709240,18],["ἐπὶ",705080,0],["πολὺ",710646,46],["τὸ",709436,24],["μνημόσυνον",708966,25],["τοῦ",709436,35],["ἐγείραντος",703949,500],["ἡμῖν",705994,90],["τείχη",712759,42],["πεπτωκότα",710481,518],["καὶ",707031,7],["στήσαντος",706846,500],["πύλας",711082,39],["καὶ",707031,7],["μοχλοὺς",709040,57],["καὶ",707031,7],["ἀνεγείραντος",701113,500],["τὰ",709436,41],["οἰκόπεδα",709515,42],["ἡμῶν",705999,145]],"And among the elect was Neemias, whose renown is great, who raised up for us the walls that were fallen, and set up the gates and the bars, and raised up our ruins again."],["14",[["οὐδεὶς",709817,14],["ἐκτίσθη",707938,37],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["τοιοῦτος",712878,14],["οἷος",709535,14],["Ενωχ",704827,4],["καὶ",707031,7],["γὰρ",702963,11],["αὐτὸς",702165,121],["ἀνελήμφθη",700984,37],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17]],"But upon the earth was no man created like Enoch; for he was taken from the earth."],["15",[["οὐδὲ",709816,7],["ὡς",714148,7],["Ιωσηφ",706948,4],["ἐγεννήθη",703051,37],["ἀνὴρ",701150,4],["ἡγούμενος",705931,122],["ἀδελφῶν",700249,81],["στήριγμα",712097,15],["λαοῦ",708094,18],["καὶ",707031,7],["τὰ",709436,63],["ὀστᾶ",709792,64],["αὐτοῦ",702165,102],["ἐπεσκέπησαν",705250,99]],"Neither was there a man born like unto Joseph, a governor of his brethren, a stay of the people, whose bones were regarded of the Lord."],["16",[["Σημ",711743,4],["καὶ",707031,7],["Σηθ",711733,4],["ἐν",704639,0],["ἀνθρώποις",701163,148],["ἐδοξάσθησαν",703792,99],["καὶ",707031,7],["ὑπὲρ",713111,0],["πᾶν",710177,46],["ζῷον",705916,25],["ἐν",704639,0],["τῇ",709436,100],["κτίσει",707939,1],["Αδαμ",700222,18]],"Sem and Seth were in great honour among men, and so was Adam above every living thing in the creation."]]