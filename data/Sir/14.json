[["1",[["μακάριος",708397,14],["ἀνήρ",701150,4],["ὃς",709781,213],["οὐκ",709805,28],["ὠλίσθησεν",709579,2],["ἐν",704639,0],["τῷ",709436,53],["στόματι",712125,54],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐ",709805,28],["κατενύγη",707347,37],["ἐν",704639,0],["λύπῃ",708273,1],["ἁμαρτιῶν",700775,65]],"Blessed is the man that hath not slipped with his mouth, and is not pricked with the multitude of sins."],["2",[["μακάριος",708397,14],["οὗ",709781,48],["οὐ",709805,28],["κατέγνω",707226,2],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὃς",709781,213],["οὐκ",709805,28],["ἔπεσεν",710481,2],["ἀπὸ",701425,0],["τῆς",709436,16],["ἐλπίδος",704530,17],["αὐτοῦ",702165,102]],"Blessed is he whose conscience hath not condemned him, and who is not fallen from his hope [in the Lord]."],["3",[["ἀνδρὶ",701150,114],["μικρολόγῳ",708914,30],["οὐ",709805,28],["καλὸς",707097,14],["ὁ",709436,3],["πλοῦτος",710563,4],["καὶ",707031,7],["ἀνθρώπῳ",701163,114],["βασκάνῳ",702589,30],["ἵνα",706747,7],["τί",712867,273],["χρήματα",713948,64]],"Riches are not comely for a niggard: and what should an envious man do with money?"],["4",[["ὁ",709436,3],["συνάγων",712375,72],["ἀπὸ",701425,0],["τῆς",709436,16],["ψυχῆς",714070,17],["αὐτοῦ",702165,102],["συνάγει",712375,91],["ἄλλοις",700697,151],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["ἀγαθοῖς",700106,94],["αὐτοῦ",702165,102],["τρυφήσουσιν",713004,218,127],["ἕτεροι",705535,138]],"He that gathereth by defrauding his own soul gathereth for others that shall spend his goods riotously."],["5",[["ὁ",709436,3],["πονηρὸς",710660,14],["ἑαυτῷ",703917,50],["τίνι",712867,435],["ἀγαθὸς",700106,14],["ἔσται",704093,93],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["εὐφρανθήσεται",705715,134],["ἐν",704639,0],["τοῖς",709436,95],["χρήμασιν",713948,96],["αὐτοῦ",702165,102]],"He that is evil to himself, to whom will he be good? he shall not take pleasure in his goods."],["6",[["τοῦ",709436,35],["βασκαίνοντος",702586,152],["ἑαυτὸν",703917,85],["οὐκ",709805,28],["ἔστιν",704093,91],["πονηρότερος",710660,224],["καὶ",707031,7],["τοῦτο",709858,132],["ἀνταπόδομα",701216,15],["τῆς",709436,16],["κακίας",707054,17],["αὐτοῦ",702165,102]],"There is none worse than he that envieth himself; and this is a recompence of his wickedness."],["7",[["κἂν",707120,459],["εὖ",705544,28],["ποιῇ",710582,204],["ἐν",704639,0],["λήθῃ",708174,1],["ποιεῖ",710582,91],["καὶ",707031,7],["ἐπ᾿",705080,0],["ἐσχάτων",705519,83],["ἐκφαίνει",704354,91],["τὴν",709436,8],["κακίαν",707054,9],["αὐτοῦ",702165,102]],"And if he doeth good, he doeth it unwillingly; and at the last he will declare his wickedness."],["8",[["πονηρὸς",710660,14],["ὁ",709436,3],["βασκαίνων",702586,72],["ὀφθαλμῷ",709870,114],["ἀποστρέφων",701598,72],["πρόσωπον",710986,25],["καὶ",707031,7],["ὑπερορῶν",713154,72],["ψυχάς",714070,39]],"The envious man hath a wicked eye; he turneth away his face, and despiseth men."],["9",[["πλεονέκτου",710522,18],["ὀφθαλμὸς",709870,4],["οὐκ",709805,28],["ἐμπίπλαται",704592,117],["μερίδι",708748,1],["καὶ",707031,7],["ἀδικία",700271,12],["πονηρὰ",710660,29],["ἀναξηραίνει",701020,91],["ψυχήν",714070,9]],"A covetous man's eye is not satisfied with his portion; and the iniquity of the wicked drieth up his soul."],["10",[["ὀφθαλμὸς",709870,4],["πονηρὸς",710660,14],["φθονερὸς",713448,14],["ἐπ᾿",705080,0],["ἄρτῳ",701829,114],["καὶ",707031,7],["ἐλλιπὴς",704521,14],["ἐπὶ",705080,0],["τῆς",709436,16],["τραπέζης",712919,17],["αὐτοῦ",702165,102]],"A wicked eye envieth [his] bread, and he is a niggard at his table."],["11",[["τέκνον",712761,297],["καθὼς",707030,7],["ἐὰν",703912,7],["ἔχῃς",705785,205],["εὖ",705544,28],["ποίει",710582,240],["σεαυτὸν",711599,85],["καὶ",707031,7],["προσφορὰς",710976,39],["κυρίῳ",707996,114],["ἀξίως",701311,28],["πρόσαγε",710848,240]],"My son, according to thy ability do good to thyself, and give the Lord his due offering."],["12",[["μνήσθητι",708960,244],["ὅτι",709803,7],["θάνατος",706096,4],["οὐ",709805,28],["χρονιεῖ",713967,127],["καὶ",707031,7],["διαθήκη",703456,12],["ᾅδου",700255,18],["οὐχ",709805,28],["ὑπεδείχθη",713192,37],["σοι",711925,159]],"Remember that death will not be long in coming, and that the covenant of the grave is not shewed unto thee."],["13",[["πρίν",710742,28],["σε",711598,163],["τελευτῆσαι",712781,106],["εὖ",705544,28],["ποίει",710582,240],["φίλῳ",713492,30],["καὶ",707031,7],["κατὰ",707200,0],["τὴν",709436,8],["ἰσχύν",706858,9],["σου",711945,133],["ἔκτεινον",704322,176],["καὶ",707031,7],["δὸς",703654,176],["αὐτῷ",702165,50]],"Do good unto thy friend before thou die, and according to thy ability stretch out thy hand and give to him."],["14",[["μὴ",708851,28],["ἀφυστερήσῃς",702238,175],["ἀπὸ",701425,0],["ἀγαθῆς",700106,82],["ἡμέρας",705984,17],["καὶ",707031,7],["μερὶς",708748,12],["ἐπιθυμίας",705147,17],["ἀγαθῆς",700106,82],["μή",708851,28],["σε",711598,163],["παρελθάτω",710141,45]],"Defraud not thyself of the good day, and let not the part of a good desire overpass thee."],["15",[["οὐχὶ",709862,28],["ἑτέρῳ",705535,30],["καταλείψεις",707305,166],["τοὺς",709436,58],["πόνους",710661,57],["σου",711945,133],["καὶ",707031,7],["τοὺς",709436,58],["κόπους",707825,57],["σου",711945,133],["εἰς",704105,0],["διαίρεσιν",703458,9],["κλήρου",707727,18]],"Shalt thou not leave thy travails unto another? and thy labours to be divided by lot?"],["16",[["δὸς",703654,176],["καὶ",707031,7],["λαβὲ",708076,176],["καὶ",707031,7],["ἀπάτησον",701364,176],["τὴν",709436,8],["ψυχήν",714070,9],["σου",711945,133],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐν",704639,0],["ᾅδου",700255,18],["ζητῆσαι",705879,106],["τρυφήν",713008,9]],"Give, and take, and sanctify thy soul; for there is no seeking of dainties in the grave."],["17",[["πᾶσα",710177,29],["σὰρξ",711537,12],["ὡς",714148,7],["ἱμάτιον",706742,15],["παλαιοῦται",709937,117],["ἡ",709436,10],["γὰρ",702963,11],["διαθήκη",703456,12],["ἀπ᾿",701425,0],["αἰῶνος",700504,18],["θανάτῳ",706096,114],["ἀποθανῇ",701461,172]],"All flesh waxeth old as a garment: for the covenant from the beginning is, Thou shalt die the death."],["18",[["ὡς",714148,7],["φύλλον",713622,15],["θάλλον",706073,32],["ἐπὶ",705080,0],["δένδρου",703353,21],["δασέος",703299,92],["τὰ",709436,41],["μὲν",708730,11],["καταβάλλει",707203,91],["ἄλλα",700697,68],["δὲ",703303,11],["φύει",713638,91],["οὕτως",709859,28],["γενεὰ",703037,12],["σαρκὸς",711537,17],["καὶ",707031,7],["αἵματος",700442,21],["ἡ",709436,10],["μὲν",708730,11],["τελευτᾷ",712781,91],["ἑτέρα",705535,29],["δὲ",703303,11],["γεννᾶται",703051,117]],"As of the green leaves on a thick tree, some fall, and some grow: so is the generation of flesh and blood, one cometh to an end, and another is born."],["19",[["πᾶν",710177,26],["ἔργον",705396,15],["σηπόμενον",711754,208],["ἐκλείπει",704237,91],["καὶ",707031,7],["ὁ",709436,3],["ἐργαζόμενος",705383,122],["αὐτὸ",702165,129],["μετ᾿",708780,0],["αὐτοῦ",702165,49],["ἀπελεύσεται",701398,93]],"Every work rotteth and consumeth away, and the worker thereof shall go withal."],["20",[["μακάριος",708397,14],["ἀνήρ",701150,4],["ὃς",709781,213],["ἐν",704639,0],["σοφίᾳ",711981,1],["μελετήσει",708698,127],["καὶ",707031,7],["ὃς",709781,213],["ἐν",704639,0],["συνέσει",712460,1],["αὐτοῦ",702165,102],["διαλεχθήσεται",703495,134]],"Blessed is the man that doth meditate good things in wisdom, and that reasoneth of holy things by his understanding."],["21",[["ὁ",709436,3],["διανοούμενος",703528,122],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτῆς",702165,86],["ἐν",704639,0],["καρδίᾳ",707141,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["ἀποκρύφοις",701497,94],["αὐτῆς",702165,86],["ἐννοηθήσεται",704762,134]],"He that considereth her ways in his heart shall also have understanding in her secrets."],["22",[["ἔξελθε",704909,176],["ὀπίσω",709697,28],["αὐτῆς",702165,86],["ὡς",714148,7],["ἰχνευτὴς",706871,4],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["αὐτῆς",702165,86],["ἐνέδρευε",704703,240]],"Go after her as one that traceth, and lie in wait in her ways."],["23",[["ὁ",709436,3],["παρακύπτων",710057,72],["διὰ",703417,0],["τῶν",709436,130],["θυρίδων",706340,65],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐπὶ",705080,0],["τῶν",709436,43],["θυρωμάτων",706343,44],["αὐτῆς",702165,86],["ἀκροάσεται",700602,93]],"He that prieth in at her windows shall also hearken at her doors."],["24",[["ὁ",709436,3],["καταλύων",707323,72],["σύνεγγυς",712424,28],["τοῦ",709436,35],["οἴκου",709516,18],["αὐτῆς",702165,86],["καὶ",707031,7],["πήξει",710452,127],["πάσσαλον",710178,6],["ἐν",704639,0],["τοῖς",709436,147],["τοίχοις",712879,148],["αὐτῆς",702165,86]],"He that doth lodge near her house shall also fasten a pin in her walls."],["25",[["στήσει",706846,127],["τὴν",709436,8],["σκηνὴν",711845,9],["αὐτοῦ",702165,102],["κατὰ",707200,0],["χεῖρας",713787,39],["αὐτῆς",702165,86],["καὶ",707031,7],["καταλύσει",707323,127],["ἐν",704639,0],["καταλύματι",707320,54],["ἀγαθῶν",700106,169]],"He shall pitch his tent nigh unto her, and shall lodge in a lodging where good things are."],["26",[["θήσει",712849,127],["τὰ",709436,41],["τέκνα",712761,42],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῇ",709436,100],["σκέπῃ",711839,1],["αὐτῆς",702165,86],["καὶ",707031,7],["ὑπὸ",713184,0],["τοὺς",709436,58],["κλάδους",707702,57],["αὐτῆς",702165,86],["αὐλισθήσεται",702138,134]],"He shall set his children under her shelter, and shall lodge under her branches."],["27",[["σκεπασθήσεται",711832,134],["ὑπ᾿",713184,0],["αὐτῆς",702165,86],["ἀπὸ",701425,0],["καύματος",707564,21],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["δόξῃ",703791,1],["αὐτῆς",702165,86],["καταλύσει",707323,127]],"By her he shall be covered from heat, and in her glory shall he dwell."]]