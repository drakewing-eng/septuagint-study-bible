[["1",[["κεναὶ",707612,192],["ἐλπίδες",704530,191],["καὶ",707031,7],["ψευδεῖς",714036,192],["ἀσυνέτῳ",702034,30],["ἀνδρί",701150,114],["καὶ",707031,7],["ἐνύπνια",704818,64],["ἀναπτεροῦσιν",701041,197],["ἄφρονας",702236,60]],"The hopes of a man void of understanding are vain and false: and dreams lift up fools.",{"s":"m","br":"31:1","q":1.0}],["2",[["ὡς",714148,7],["δρασσόμενος",703826,122],["σκιᾶς",711852,17],["καὶ",707031,7],["διώκων",703768,72],["ἄνεμον",701123,6],["οὕτως",709859,28],["ὁ",709436,3],["ἐπέχων",705076,72],["ἐνυπνίοις",704818,96]],"Whoso regardeth dreams is like him that catcheth at a shadow, and followeth after the wind.",{"s":"m","br":"31:2","q":1.0}],["3",[["τοῦτο",709858,132],["κατὰ",707200,0],["τούτου",709858,49],["ὅρασις",709721,12],["ἐνυπνίων",704818,44],["κατέναντι",707507,28],["προσώπου",710986,21],["ὁμοίωμα",709629,15],["προσώπου",710986,21]],"The vision of dreams is the resemblance of one thing to another, even as the likeness of a face to a face.",{"s":"m","br":"31:3","q":0.89}],["4",[["ἀπὸ",701425,0],["ἀκαθάρτου",700508,92],["τί",712867,273],["καθαρισθήσεται",706985,134],["καὶ",707031,7],["ἀπὸ",701425,0],["ψευδοῦς",714036,92],["τί",712867,273],["ἀληθεύσει",700657,127]],"Of an unclean thing what can be cleansed? and from that thing which is false what truth can come?",{"s":"m","br":"31:4","q":1.0}],["5",[["μαντεῖαι",708488,191],["καὶ",707031,7],["οἰωνισμοὶ",709543,52],["καὶ",707031,7],["ἐνύπνια",704818,64],["μάταιά",708575,195],["ἐστιν",704093,91],["καὶ",707031,7],["ὡς",714148,7],["ὠδινούσης",714095,188],["φαντάζεται",713346,117],["καρδία",707141,12]],"Divinations, and soothsayings, and dreams, are vain: and the heart fancieth, as a woman's heart in travail.",{"s":"m","br":"31:5","q":0.92}],["6",[["ἐὰν",703912,7],["μὴ",708851,28],["παρὰ",709995,0],["ὑψίστου",713287,116],["ἀποσταλῇ",701592,384],["ἐν",704639,0],["ἐπισκοπῇ",705255,1],["μὴ",708851,28],["δῷς",703654,175],["εἰς",704105,0],["αὐτὰ",702165,71],["τὴν",709436,8],["καρδίαν",707141,9],["σου",711945,133]],"If they be not sent from the most High in thy visitation, set not thy heart upon them.",{"s":"m","br":"31:6","q":1.0}],["7",[["πολλοὺς",710646,60],["γὰρ",702963,11],["ἐπλάνησεν",710495,2],["τὰ",709436,63],["ἐνύπνια",704818,64],["καὶ",707031,7],["ἐξέπεσον",704284,150],["ἐλπίζοντες",704529,146],["ἐπ᾿",705080,0],["αὐτοῖς",702165,206]],"For dreams have deceived many, and they have failed that put their trust in them.",{"s":"m","br":"31:7","q":0.9}],["8",[["ἄνευ",701137,0],["ψεύδους",714036,92],["συντελεσθήσεται",712510,134],["νόμος",709349,4],["καὶ",707031,7],["σοφία",711981,12],["στόματι",712125,54],["πιστῷ",710486,97],["τελείωσις",712773,12]],"The law shall be found perfect without lies: and wisdom is perfection to a faithful mouth.",{"s":"m","br":"31:8","q":1.0}],["9",[["ἀνὴρ",701150,4],["πεπλανημένος",710495,419],["ἔγνω",703105,2],["πολλά",710646,68],["καὶ",707031,7],["ὁ",709436,3],["πολύπειρος",710637,14],["ἐκδιηγήσεται",704172,93],["σύνεσιν",712460,9]],"A man that hath travelled knoweth many things: and he that hath much experience will declare wisdom.",{"s":"m","br":"31:9","q":0.89}],["10",[["ὃς",709781,213],["οὐκ",709805,28],["ἐπειράθη",710225,37],["ὀλίγα",709568,68],["οἶδεν",709492,171],["ὁ",709436,3],["δὲ",703303,11],["πεπλανημένος",710495,419],["πληθυνεῖ",710530,127],["πανουργίαν",709971,9]],"He that hath no experience knoweth little: but he that hath travelled is full of prudence.",{"s":"m","br":"31:10","q":1.0}],["11",[["πολλὰ",710646,68],["ἑώρακα",709725,89],["ἐν",704639,0],["τῇ",709436,100],["ἀποπλανήσει",701548,1],["μου",709032,133],["καὶ",707031,7],["πλείονα",710514,68],["τῶν",709436,80],["λόγων",708236,81],["μου",709032,133],["σύνεσίς",712460,12],["μου",709032,133]],"When I travelled, I saw many things; and I understand more than I can express.",{"s":"m","br":"31:11","q":1.0}],["12",[["πλεονάκις",710517,28],["ἕως",705792,0],["θανάτου",706096,18],["ἐκινδύνευσα",707677,155],["καὶ",707031,7],["διεσώθην",703599,156],["τούτων",709858,70],["χάριν",713735,9]],"I was oft-times in danger of death: yet I was delivered because of these things.",{"s":"m","br":"31:12","q":1.0}],["13",[["πνεῦμα",710566,15],["φοβουμένων",713532,299],["κύριον",707996,6],["ζήσεται",705851,93],["ἡ",709436,10],["γὰρ",702963,11],["ἐλπὶς",704530,12],["αὐτῶν",702165,40],["ἐπὶ",705080,0],["τὸν",709436,5],["σῴζοντα",712627,183],["αὐτούς",702165,62]],"The spirit of those that fear the Lord shall live; for their hope is in him that saveth them.",{"s":"m","br":"31:13","q":1.0}],["14",[["ὁ",709436,3],["φοβούμενος",713532,122],["κύριον",707996,6],["οὐδὲν",709817,46],["εὐλαβηθήσεται",705627,134],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["δειλιάσῃ",703321,172],["ὅτι",709803,7],["αὐτὸς",702165,121],["ἐλπὶς",704530,12],["αὐτοῦ",702165,102]],"Whoso feareth the Lord shall not fear nor be afraid; for he is his hope.",{"s":"m","br":"31:14","q":0.86}],["15",[["φοβουμένου",713532,262],["τὸν",709436,5],["κύριον",707996,6],["μακαρία",708397,29],["ἡ",709436,10],["ψυχή",714070,12],["τίνι",712867,435],["ἐπέχει",705076,91],["καὶ",707031,7],["τίς",712867,158],["αὐτοῦ",702165,102],["στήριγμα",712097,15]],"Blessed is the soul of him that feareth the Lord: to whom doth he look? and who is his strength?",{"s":"m","br":"31:15","q":0.92}],["16",[["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["κυρίου",707996,18],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἀγαπῶντας",700120,235],["αὐτόν",702165,85],["ὑπερασπισμὸς",713122,4],["δυναστείας",703841,17],["καὶ",707031,7],["στήριγμα",712097,15],["ἰσχύος",706858,17],["σκέπη",711838,12],["ἀπὸ",701425,0],["καύσωνος",707567,18],["καὶ",707031,7],["σκέπη",711838,12],["ἀπὸ",701425,0],["μεσημβρίας",708758,17],["φυλακὴ",713613,12],["ἀπὸ",701425,0],["προσκόμματος",710922,21],["καὶ",707031,7],["βοήθεια",702745,12],["ἀπὸ",701425,0],["πτώσεως",711072,17]],"For the eyes of the Lord are upon them that love him, he is their mighty protection and strong stay, a defence from heat, and a cover from the sun at noon, a preservation from stumbling, and an help from falling;",{"s":"m","br":"31:16","q":0.81}],["17",[["ἀνυψῶν",701293,72],["ψυχὴν",714070,9],["καὶ",707031,7],["φωτίζων",713646,72],["ὀφθαλμούς",709870,57],["ἴασιν",706444,9],["διδούς",703654,72],["ζωὴν",705910,9],["καὶ",707031,7],["εὐλογίαν",705633,9]],null,{"s":"h"}],["18",[["θυσιάζων",706346,72],["ἐξ",704132,0],["ἀδίκου",700272,92],["προσφορὰ",710976,12],["μεμωμημένη",709100,203],["καὶ",707031,7],["οὐκ",709805,28],["εἰς",704105,0],["εὐδοκίαν",705566,9],["δωρήματα",703903,64],["ἀνόμων",701194,83]],"He that sacrificeth of a thing wrongfully gotten, his offering is ridiculous; and the gifts of unjust men are not accepted.",{"s":"m","br":"31:18","q":0.82}],["19",[["οὐκ",709805,28],["εὐδοκεῖ",705565,91],["ὁ",709436,3],["ὕψιστος",713287,14],["ἐν",704639,0],["προσφοραῖς",710976,76],["ἀσεβῶν",701909,169],["οὐδὲ",709816,7],["ἐν",704639,0],["πλήθει",710529,54],["θυσιῶν",706345,65],["ἐξιλάσκεται",704932,117],["ἁμαρτίας",700775,39]],"The most High is not pleased with the offerings of the wicked; neither is he pacified for sin by the multitude of sacrifices.",{"s":"m","br":"31:19","q":0.92}],["20",[["θύων",706349,72],["υἱὸν",713075,6],["ἔναντι",704653,0],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["ὁ",709436,3],["προσάγων",710848,72],["θυσίαν",706345,9],["ἐκ",704132,0],["χρημάτων",713948,44],["πενήτων",710248,81]],"Whoso bringeth an offering of the goods of the poor doeth as one that killeth the son before his father's eyes.",{"s":"m","br":"31:20","q":1.0}],["21",[["ἄρτος",701829,4],["ἐπιδεομένων",705118,299],["ζωὴ",705910,12],["πτωχῶν",711076,81],["ὁ",709436,3],["ἀποστερῶν",701595,72],["αὐτὴν",702165,104],["ἄνθρωπος",701163,4],["αἱμάτων",700442,44]],"The bread of the needy is their life: he that defraudeth him thereof is a man of blood.",{"s":"m","br":"31:21","q":1.0}],["22",[["φονεύων",713546,72],["τὸν",709436,5],["πλησίον",710547,28],["ὁ",709436,3],["ἀφαιρούμενος",702177,122],["ἐμβίωσιν",704550,9],["καὶ",707031,7],["ἐκχέων",704368,72],["αἷμα",700442,25],["ὁ",709436,3],["ἀποστερῶν",701595,72],["μισθὸν",708939,6],["μισθίου",708938,18]],"He that taketh away his neighbour's living slayeth him; and he that defraudeth the labourer his hire is a bloodshedder.",{"s":"m","br":"31:22","q":0.92}],["23",[["εἷς",704106,59],["οἰκοδομῶν",709509,72],["καὶ",707031,7],["εἷς",704106,59],["καθαιρῶν",706982,72],["τί",712867,126],["ὠφέλησαν",714171,150],["πλεῖον",710514,46],["ἢ",705924,7],["κόπους",707825,57]],null,{"s":"h"}],["24",[["εἷς",704106,59],["εὐχόμενος",705727,122],["καὶ",707031,7],["εἷς",704106,596],["καταρώμενος",707396,122],["τίνος",712867,666],["φωνῆς",713640,17],["εἰσακούσεται",704108,93],["ὁ",709436,3],["δεσπότης",703379,4]],"When one prayeth, and another curseth, whose voice will the Lord hear?",{"s":"m","br":"31:24","q":0.9}],["25",[["βαπτιζόμενος",702515,122],["ἀπὸ",701425,0],["νεκροῦ",709247,18],["καὶ",707031,7],["πάλιν",709942,28],["ἁπτόμενος",701654,122],["αὐτοῦ",702165,102],["τί",712867,126],["ὠφέλησεν",714171,2],["ἐν",704639,0],["τῷ",709436,53],["λουτρῷ",708257,54],["αὐτοῦ",702165,102]],"He that washeth himself after the touching of a dead body, if he touch it again, what availeth his washing?",{"s":"m","br":"31:25","q":0.92}],["26",[["οὕτως",709859,28],["ἄνθρωπος",701163,4],["νηστεύων",709304,72],["ἐπὶ",705080,0],["τῶν",709436,130],["ἁμαρτιῶν",700775,65],["αὐτοῦ",702165,102],["καὶ",707031,7],["πάλιν",709942,28],["πορευόμενος",710667,122],["καὶ",707031,7],["τὰ",709436,41],["αὐτὰ",702165,71],["ποιῶν",710582,72],["τῆς",709436,16],["προσευχῆς",710892,17],["αὐτοῦ",702165,102],["τίς",712867,158],["εἰσακούσεται",704108,93],["καὶ",707031,7],["τί",712867,126],["ὠφέλησεν",714171,2],["ἐν",704639,0],["τῷ",709436,53],["ταπεινωθῆναι",712717,179],["αὐτόν",702165,85]],"So is it with a man that fasteth for his sins, and goeth again, and doeth the same: who will hear his prayer? or what doth his humbling profit him?",{"s":"m","br":"31:26","q":1.0}]]