[["1",[["κεναὶ",707612,192],["ἐλπίδες",704530,191],["καὶ",707031,7],["ψευδεῖς",714036,192],["ἀσυνέτῳ",702034,30],["ἀνδρί",701150,114],["καὶ",707031,7],["ἐνύπνια",704818,64],["ἀναπτεροῦσιν",701041,197],["ἄφρονας",702236,60]],"Watching for riches consumeth the flesh, and the care thereof driveth away sleep."],["2",[["ὡς",714148,7],["δρασσόμενος",703826,122],["σκιᾶς",711852,17],["καὶ",707031,7],["διώκων",703768,72],["ἄνεμον",701123,6],["οὕτως",709859,28],["ὁ",709436,3],["ἐπέχων",705076,72],["ἐνυπνίοις",704818,96]],"Watching care will not let a man slumber, as a sore disease breaketh sleep."],["3",[["τοῦτο",709858,132],["κατὰ",707200,0],["τούτου",709858,49],["ὅρασις",709721,12],["ἐνυπνίων",704818,44],["κατέναντι",707507,28],["προσώπου",710986,21],["ὁμοίωμα",709629,15],["προσώπου",710986,21]],"The rich hath great labour in gathering riches together; and when he resteth, he is filled with his delicacies."],["4",[["ἀπὸ",701425,0],["ἀκαθάρτου",700508,92],["τί",712867,273],["καθαρισθήσεται",706985,134],["καὶ",707031,7],["ἀπὸ",701425,0],["ψευδοῦς",714036,92],["τί",712867,273],["ἀληθεύσει",700657,127]],"The poor laboureth in his poor estate; and when he leaveth off, he is still needy."],["5",[["μαντεῖαι",708488,191],["καὶ",707031,7],["οἰωνισμοὶ",709543,52],["καὶ",707031,7],["ἐνύπνια",704818,64],["μάταιά",708575,195],["ἐστιν",704093,91],["καὶ",707031,7],["ὡς",714148,7],["ὠδινούσης",714095,188],["φαντάζεται",713346,117],["καρδία",707141,12]],"He that loveth gold shall not be justified, and he that followeth corruption shall have enough thereof."],["6",[["ἐὰν",703912,7],["μὴ",708851,28],["παρὰ",709995,0],["ὑψίστου",713287,116],["ἀποσταλῇ",701592,384],["ἐν",704639,0],["ἐπισκοπῇ",705255,1],["μὴ",708851,28],["δῷς",703654,175],["εἰς",704105,0],["αὐτὰ",702165,71],["τὴν",709436,8],["καρδίαν",707141,9],["σου",711945,133]],"Gold hath been the ruin of many, and their destruction was present."],["7",[["πολλοὺς",710646,60],["γὰρ",702963,11],["ἐπλάνησεν",710495,2],["τὰ",709436,63],["ἐνύπνια",704818,64],["καὶ",707031,7],["ἐξέπεσον",704284,150],["ἐλπίζοντες",704529,146],["ἐπ᾿",705080,0],["αὐτοῖς",702165,206]],"It is a stumblingblock unto them that sacrifice unto it, and every fool shall be taken therewith."],["8",[["ἄνευ",701137,0],["ψεύδους",714036,92],["συντελεσθήσεται",712510,134],["νόμος",709349,4],["καὶ",707031,7],["σοφία",711981,12],["στόματι",712125,54],["πιστῷ",710486,97],["τελείωσις",712773,12]],"Blessed is the rich that is found without blemish, and hath not gone after gold."],["9",[["ἀνὴρ",701150,4],["πεπλανημένος",710495,419],["ἔγνω",703105,2],["πολλά",710646,68],["καὶ",707031,7],["ὁ",709436,3],["πολύπειρος",710637,14],["ἐκδιηγήσεται",704172,93],["σύνεσιν",712460,9]],"Who is he? and we will call him blessed: for wonderful things hath he done among his people."],["10",[["ὃς",709781,213],["οὐκ",709805,28],["ἐπειράθη",710225,37],["ὀλίγα",709568,68],["οἶδεν",709492,171],["ὁ",709436,3],["δὲ",703303,11],["πεπλανημένος",710495,419],["πληθυνεῖ",710530,127],["πανουργίαν",709971,9]],"Who hath been tried thereby, and found perfect? then let him glory. Who might offend, and hath not offended? or done evil, and hath not done it?"],["11",[["πολλὰ",710646,68],["ἑώρακα",709725,89],["ἐν",704639,0],["τῇ",709436,100],["ἀποπλανήσει",701548,1],["μου",709032,133],["καὶ",707031,7],["πλείονα",710514,68],["τῶν",709436,80],["λόγων",708236,81],["μου",709032,133],["σύνεσίς",712460,12],["μου",709032,133]],"His goods shall be established, and the congregation shall declare his alms."],["12",[["πλεονάκις",710517,28],["ἕως",705792,0],["θανάτου",706096,18],["ἐκινδύνευσα",707677,155],["καὶ",707031,7],["διεσώθην",703599,156],["τούτων",709858,70],["χάριν",713735,9]],"If thou sit at a bountiful table, be not greedy upon it, and say not, There is much meat on it."],["13",[["πνεῦμα",710566,15],["φοβουμένων",713532,299],["κύριον",707996,6],["ζήσεται",705851,93],["ἡ",709436,10],["γὰρ",702963,11],["ἐλπὶς",704530,12],["αὐτῶν",702165,40],["ἐπὶ",705080,0],["τὸν",709436,5],["σῴζοντα",712627,183],["αὐτούς",702165,62]],"Remember that a wicked eye is an evil thing: and what is created more wicked than an eye? therefore it weepeth upon every occasion."],["14",[["ὁ",709436,3],["φοβούμενος",713532,122],["κύριον",707996,6],["οὐδὲν",709817,46],["εὐλαβηθήσεται",705627,134],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["δειλιάσῃ",703321,172],["ὅτι",709803,7],["αὐτὸς",702165,121],["ἐλπὶς",704530,12],["αὐτοῦ",702165,102]],"Stretch not thine hand whithersoever it looketh, and thrust it not with him into the dish."],["15",[["φοβουμένου",713532,262],["τὸν",709436,5],["κύριον",707996,6],["μακαρία",708397,29],["ἡ",709436,10],["ψυχή",714070,12],["τίνι",712867,435],["ἐπέχει",705076,91],["καὶ",707031,7],["τίς",712867,158],["αὐτοῦ",702165,102],["στήριγμα",712097,15]],"Judge of thy neighbour by thyself: and be discreet in every point."],["16",[["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["κυρίου",707996,18],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἀγαπῶντας",700120,235],["αὐτόν",702165,85],["ὑπερασπισμὸς",713122,4],["δυναστείας",703841,17],["καὶ",707031,7],["στήριγμα",712097,15],["ἰσχύος",706858,17],["σκέπη",711838,12],["ἀπὸ",701425,0],["καύσωνος",707567,18],["καὶ",707031,7],["σκέπη",711838,12],["ἀπὸ",701425,0],["μεσημβρίας",708758,17],["φυλακὴ",713613,12],["ἀπὸ",701425,0],["προσκόμματος",710922,21],["καὶ",707031,7],["βοήθεια",702745,12],["ἀπὸ",701425,0],["πτώσεως",711072,17]],"Eat, as it becometh a man, those things which are set before thee; and devour not, lest thou be hated."],["17",[["ἀνυψῶν",701293,72],["ψυχὴν",714070,9],["καὶ",707031,7],["φωτίζων",713646,72],["ὀφθαλμούς",709870,57],["ἴασιν",706444,9],["διδούς",703654,72],["ζωὴν",705910,9],["καὶ",707031,7],["εὐλογίαν",705633,9]],"Leave off first for manners' sake; and be not unsatiable, lest thou offend."],["18",[["θυσιάζων",706346,72],["ἐξ",704132,0],["ἀδίκου",700272,92],["προσφορὰ",710976,12],["μεμωμημένη",709100,203],["καὶ",707031,7],["οὐκ",709805,28],["εἰς",704105,0],["εὐδοκίαν",705566,9],["δωρήματα",703903,64],["ἀνόμων",701194,83]],"When thou sittest among many, reach not thine hand out first of all."],["19",[["οὐκ",709805,28],["εὐδοκεῖ",705565,91],["ὁ",709436,3],["ὕψιστος",713287,14],["ἐν",704639,0],["προσφοραῖς",710976,76],["ἀσεβῶν",701909,169],["οὐδὲ",709816,7],["ἐν",704639,0],["πλήθει",710529,54],["θυσιῶν",706345,65],["ἐξιλάσκεται",704932,117],["ἁμαρτίας",700775,39]],"A very little is sufficient for a man well nurtured, and he fetcheth not his wind short upon his bed."],["20",[["θύων",706349,72],["υἱὸν",713075,6],["ἔναντι",704653,0],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["ὁ",709436,3],["προσάγων",710848,72],["θυσίαν",706345,9],["ἐκ",704132,0],["χρημάτων",713948,44],["πενήτων",710248,81]],"Sound sleep cometh of moderate eating: he riseth early, and his wits are with him: but the pain of watching, and choler, and pangs of the belly, are with an unsatiable man."],["21",[["ἄρτος",701829,4],["ἐπιδεομένων",705118,299],["ζωὴ",705910,12],["πτωχῶν",711076,81],["ὁ",709436,3],["ἀποστερῶν",701595,72],["αὐτὴν",702165,104],["ἄνθρωπος",701163,4],["αἱμάτων",700442,44]],"And if thou hast been forced to eat, arise, go forth, vomit, and thou shalt have rest."],["22",[["φονεύων",713546,72],["τὸν",709436,5],["πλησίον",710547,28],["ὁ",709436,3],["ἀφαιρούμενος",702177,122],["ἐμβίωσιν",704550,9],["καὶ",707031,7],["ἐκχέων",704368,72],["αἷμα",700442,25],["ὁ",709436,3],["ἀποστερῶν",701595,72],["μισθὸν",708939,6],["μισθίου",708938,18]],"My son, hear me, and despise me not, and at the last thou shalt find as I told thee: in all thy works be quick, so shall there no sickness come unto thee."],["23",[["εἷς",704106,59],["οἰκοδομῶν",709509,72],["καὶ",707031,7],["εἷς",704106,59],["καθαιρῶν",706982,72],["τί",712867,126],["ὠφέλησαν",714171,150],["πλεῖον",710514,46],["ἢ",705924,7],["κόπους",707825,57]],"Whoso is liberal of his meat, men shall speak well of him; and the report of his good housekeeping will be believed."],["24",[["εἷς",704106,59],["εὐχόμενος",705727,122],["καὶ",707031,7],["εἷς",704106,596],["καταρώμενος",707396,122],["τίνος",712867,666],["φωνῆς",713640,17],["εἰσακούσεται",704108,93],["ὁ",709436,3],["δεσπότης",703379,4]],"But against him that is a niggard of his meat the whole city shall murmur; and the testimonies of his niggardness shall not be doubted of."],["25",[["βαπτιζόμενος",702515,122],["ἀπὸ",701425,0],["νεκροῦ",709247,18],["καὶ",707031,7],["πάλιν",709942,28],["ἁπτόμενος",701654,122],["αὐτοῦ",702165,102],["τί",712867,126],["ὠφέλησεν",714171,2],["ἐν",704639,0],["τῷ",709436,53],["λουτρῷ",708257,54],["αὐτοῦ",702165,102]],"Shew not thy valiantness in wine; for wine hath destroyed many."],["26",[["οὕτως",709859,28],["ἄνθρωπος",701163,4],["νηστεύων",709304,72],["ἐπὶ",705080,0],["τῶν",709436,130],["ἁμαρτιῶν",700775,65],["αὐτοῦ",702165,102],["καὶ",707031,7],["πάλιν",709942,28],["πορευόμενος",710667,122],["καὶ",707031,7],["τὰ",709436,41],["αὐτὰ",702165,71],["ποιῶν",710582,72],["τῆς",709436,16],["προσευχῆς",710892,17],["αὐτοῦ",702165,102],["τίς",712867,158],["εἰσακούσεται",704108,93],["καὶ",707031,7],["τί",712867,126],["ὠφέλησεν",714171,2],["ἐν",704639,0],["τῷ",709436,53],["ταπεινωθῆναι",712717,179],["αὐτόν",702165,85]],"The furnace proveth the edge by dipping: so doth wine the hearts of the proud by drunkenness."]]