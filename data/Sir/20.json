[["1",[["ἔστιν",704093,91],["ἔλεγχος",704415,4],["ὃς",709781,213],["οὐκ",709805,28],["ἔστιν",704093,91],["ὡραῖος",714132,14],["καὶ",707031,7],["ἔστιν",704093,91],["σιωπῶν",711818,72],["καὶ",707031,7],["αὐτὸς",702165,121],["φρόνιμος",713589,14]],"There is a reproof that is not comely: again, some man holdeth his tongue, and he is wise."],["2",[["ὡς",714148,7],["καλὸν",707097,26],["ἐλέγξαι",704416,106],["ἢ",705924,7],["θυμοῦσθαι",706335,110]],"It is much better to reprove, than to be angry secretly:"],["3",[["καὶ",707031,7],["ὁ",709436,3],["ἀνθομολογούμενος",701155,122],["ἀπὸ",701425,0],["ἐλαττώσεως",704396,17],["κωλυθήσεται",708020,134]],"and he that confesseth his fault shall be preserved from hurt."],["4",[["ἐπιθυμία",705147,12],["εὐνούχου",705651,18],["ἀποπαρθενῶσαι",701541,106],["νεάνιδα",709231,9],["οὕτως",709859,28],["ὁ",709436,3],["ποιῶν",710582,72],["ἐν",704639,0],["βίᾳ",702712,1],["κρίματα",707903,42]],"As is the lust of an eunuch to deflower a virgin; so is he that executeth judgment with violence."],["5",[["ἔστιν",704093,91],["σιωπῶν",711818,72],["εὑρισκόμενος",705676,122],["σοφός",711985,14],["καὶ",707031,7],["ἔστιν",704093,91],["μισητὸς",708936,14],["ἀπὸ",701425,0],["πολλῆς",710646,82],["λαλιᾶς",708074,17]],"There is one that keepeth silence, and is found wise: and another by much babbling becometh hateful."],["6",[["ἔστιν",704093,91],["σιωπῶν",711818,72],["οὐ",709805,28],["γὰρ",702963,11],["ἔχει",705785,91],["ἀπόκρισιν",701493,9],["καὶ",707031,7],["ἔστιν",704093,91],["σιωπῶν",711818,72],["εἰδὼς",704075,270],["καιρόν",707047,6]],"Some man holdeth his tongue, because he hath not to answer: and some keepeth silence, knowing his time."],["7",[["ἄνθρωπος",701163,4],["σοφὸς",711985,14],["σιγήσει",711767,127],["ἕως",705792,0],["καιροῦ",707047,18],["ὁ",709436,3],["δὲ",703303,11],["λαπιστὴς",708095,4],["καὶ",707031,7],["ἄφρων",702236,14],["ὑπερβήσεται",713125,93],["καιρόν",707047,6]],"A wise man will hold his tongue till he see opportunity: but a babbler and a fool will regard no time."],["8",[["ὁ",709436,3],["πλεονάζων",710516,72],["λόγῳ",708236,114],["βδελυχθήσεται",702608,134],["καὶ",707031,7],["ὁ",709436,3],["ἐνεξουσιαζόμενος",704715,122],["μισηθήσεται",708935,134]],"He that useth many words shall be abhorred; and he that taketh to himself authority therein shall be hated."],["9",[["ἔστιν",704093,91],["εὐοδία",705652,12],["ἐν",704639,0],["κακοῖς",707066,94],["ἀνδρί",701150,114],["καὶ",707031,7],["ἔστιν",704093,91],["εὕρεμα",705671,15],["εἰς",704105,0],["ἐλάττωσιν",704396,12]],"There is a sinner that hath good success in evil things; and there is a gain that turneth to loss."],["10",[["ἔστιν",704093,91],["δόσις",703809,12],["ἣ",709781,177],["οὐ",709805,28],["λυσιτελήσει",708279,127],["σοι",711925,159],["καὶ",707031,7],["ἔστιν",704093,91],["δόσις",703809,12],["ἧς",709781,167],["τὸ",709436,24],["ἀνταπόδομα",701216,25],["διπλοῦν",703740,46]],"There is a gift that shall not profit thee; and there is a gift whose recompence is double."],["11",[["ἔστιν",704093,91],["ἐλάττωσις",704396,12],["ἕνεκεν",704709,0],["δόξης",703791,17],["καὶ",707031,7],["ἔστιν",704093,91],["ὃς",709781,213],["ἀπὸ",701425,0],["ταπεινώσεως",712719,17],["ἦρεν",700473,2],["κεφαλήν",707639,9]],"There is an abasement because of glory; and there is that lifteth up his head from a low estate."],["12",[["ἔστιν",704093,91],["ἀγοράζων",700184,72],["πολλὰ",710646,68],["ὀλίγου",709568,92],["καὶ",707031,7],["ἀποτιννύων",701617,72],["αὐτὰ",702165,71],["ἑπταπλάσιον",705368,46]],"There is that buyeth much for a little, and repayeth it sevenfold."],["13",[["ὁ",709436,3],["σοφὸς",711985,14],["ἐν",704639,0],["λόγοις",708236,148],["ἑαυτὸν",703917,85],["προσφιλῆ",710975,27],["ποιήσει",710582,127],["χάριτες",713735,191],["δὲ",703303,11],["μωρῶν",709110,169],["ἐκχυθήσονται",704368,144]],"A wise man by his words maketh himself beloved: but the graces of fools shall be poured out."],["14",[["δόσις",703809,12],["ἄφρονος",702236,116],["οὐ",709805,28],["λυσιτελήσει",708279,127],["σοι",711925,159],["οἱ",709436,136],["γὰρ",702963,11],["ὀφθαλμοὶ",709870,52],["αὐτοῦ",702165,102],["ἀνθ᾿",701227,0],["ἑνὸς",704106,116],["πολλοί",710646,138]],"The gift of a fool shall do thee no good when thou hast it; neither yet of the envious for his necessity: for he looketh to receive many things for one."],["15",[["ὀλίγα",709568,68],["δώσει",703654,127],["καὶ",707031,7],["πολλὰ",710646,68],["ὀνειδίσει",709655,127],["καὶ",707031,7],["ἀνοίξει",701186,127],["τὸ",709436,24],["στόμα",712125,25],["αὐτοῦ",702165,102],["ὡς",714148,7],["κῆρυξ",707661,4],["σήμερον",711751,28],["δανιεῖ",703277,127],["καὶ",707031,7],["αὔριον",702149,28],["ἀπαιτήσει",701330,127],["μισητὸς",708936,14],["ἄνθρωπος",701163,4],["ὁ",709436,3],["τοιοῦτος",712878,14]],"He giveth little, and upbraideth much; he openeth his mouth like a crier; to-day he lendeth, and to-morrow will he ask it again: such an one is to be hated of God and man."],["16",[["μωρὸς",709110,14],["ἐρεῖ",705415,127],["οὐχ",709805,28],["ὑπάρχει",713104,91],["μοι",708974,159],["φίλος",713492,14],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["χάρις",713735,12],["τοῖς",709436,95],["ἀγαθοῖς",700106,94],["μου",709032,133]],"The fool saith, I have no friends, I have no thank for all my good deeds, and they that eat my bread speak evil of me.",{"s":"d","q":0.6}],["17",[["οἱ",709436,136],["ἔσθοντες",705495,146],["τὸν",709436,5],["ἄρτον",701829,6],["αὐτοῦ",702165,102],["φαῦλοι",713398,138],["γλώσσῃ",703120,1],["ποσάκις",710687,28],["καὶ",707031,7],["ὅσοι",709788,138],["καταγελάσονται",707222,135],["αὐτοῦ",702165,102]],"How oft, and of how many shall he be laughed to scorn!",{"s":"d","q":0.42}],["18",[["ὀλίσθημα",709580,15],["ἀπὸ",701425,0],["ἐδάφους",704022,21],["μᾶλλον",708448,28],["ἢ",705924,7],["ἀπὸ",701425,0],["γλώσσης",703120,17],["οὕτως",709859,28],["πτῶσις",711072,12],["κακῶν",707066,83],["κατὰ",707200,0],["σπουδὴν",712035,9],["ἥξει",705956,127]],"To slip upon a pavement is better than to slip with the tongue: so the fall of the wicked shall come speedily."],["19",[["ἄνθρωπος",701163,4],["ἄχαρις",702251,14],["μῦθος",709049,4],["ἄκαιρος",700509,14],["ἐν",704639,0],["στόματι",712125,54],["ἀπαιδεύτων",701328,169],["ἐνδελεχισθήσεται",704679,134]],"An unseasonable tale will always be in the mouth of the unwise."],["20",[["ἀπὸ",701425,0],["στόματος",712125,21],["μωροῦ",709110,116],["ἀποδοκιμασθήσεται",701451,134],["παραβολή",710003,12],["οὐ",709805,28],["γὰρ",702963,11],["μὴ",708851,28],["εἴπῃ",705373,172],["αὐτὴν",702165,104],["ἐν",704639,0],["καιρῷ",707047,114],["αὐτῆς",702165,86]],"A wise sentence shall be rejected when it cometh out of a fool's mouth; for he will not speak it in due season."],["21",[["ἔστιν",704093,91],["κωλυόμενος",708020,122],["ἁμαρτάνειν",700773,55],["ἀπὸ",701425,0],["ἐνδείας",704672,17],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["ἀναπαύσει",701026,1],["αὐτοῦ",702165,102],["οὐ",709805,28],["κατανυγήσεται",707347,134]],"There is that is hindered from sinning through want: and when he taketh rest, he shall not be troubled."],["22",[["ἔστιν",704093,91],["ἀπολλύων",701513,72],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["δι᾿",703417,0],["αἰσχύνην",700483,9],["καὶ",707031,7],["ἀπὸ",701425,0],["ἄφρονος",702236,116],["προσώπου",710986,21],["ἀπολεῖ",701513,127],["αὐτήν",702165,104]],"There is that destroyeth his own soul through bashfulness, and by accepting of persons overthroweth himself."],["23",[["ἔστιν",704093,91],["χάριν",713735,9],["αἰσχύνης",700483,17],["ἐπαγγελλόμενος",704992,122],["φίλῳ",713492,30],["καὶ",707031,7],["ἐκτήσατο",707932,23],["αὐτὸν",702165,85],["ἐχθρὸν",705779,27],["δωρεάν",703901,9]],"There is that for bashfulness promiseth to his friend, and maketh him his enemy for nothing."],["24",[["μῶμος",709102,4],["πονηρὸς",710660,14],["ἐν",704639,0],["ἀνθρώπῳ",701163,114],["ψεῦδος",714044,15],["ἐν",704639,0],["στόματι",712125,54],["ἀπαιδεύτων",701328,169],["ἐνδελεχισθήσεται",704679,134]],"A lie is a foul blot in a man, yet it is continually in the mouth of the untaught."],["25",[["αἱρετὸν",700471,26],["κλέπτης",707714,4],["ἢ",705924,7],["ὁ",709436,3],["ἐνδελεχίζων",704679,72],["ψεύδει",714045,91],["ἀμφότεροι",700892,138],["δὲ",703303,11],["ἀπώλειαν",701660,9],["κληρονομήσουσιν",707724,218]],"A thief is better than a man that is accustomed to lie: but they both shall have destruction to heritage."],["26",[["ἦθος",705955,15],["ἀνθρώπου",701163,18],["ψευδοῦς",714036,116],["ἀτιμία",702094,12],["καὶ",707031,7],["ἡ",709436,10],["αἰσχύνη",700483,12],["αὐτοῦ",702165,102],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἐνδελεχῶς",704681,28]],"The disposition of a liar is dishonourable, and his shame is ever with him."],["27",[["ὁ",709436,3],["σοφὸς",711985,14],["ἐν",704639,0],["λόγοις",708236,148],["προάξει",710748,127],["ἑαυτόν",703917,85],["καὶ",707031,7],["ἄνθρωπος",701163,4],["φρόνιμος",713589,14],["ἀρέσει",701724,127],["μεγιστᾶσιν",708657,148]],"A wise man shall promote himself [to honour] with his words: and he that hath understanding will please great men."],["28",[["ὁ",709436,3],["ἐργαζόμενος",705383,122],["γῆν",703083,9],["ἀνυψώσει",701293,127],["θιμωνιὰν",706241,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὁ",709436,3],["ἀρέσκων",701722,72],["μεγιστᾶσιν",708657,148],["ἐξιλάσεται",704932,93],["ἀδικίαν",700271,9]],"He that tilleth his land shall increase his heap: and he that pleaseth great men shall get pardon for iniquity."],["29",[["ξένια",709408,12],["καὶ",707031,7],["δῶρα",703907,64],["ἀποτυφλοῖ",701629,91],["ὀφθαλμοὺς",709870,57],["σοφῶν",711985,169],["καὶ",707031,7],["ὡς",714148,7],["φιμὸς",713508,4],["ἐν",704639,0],["στόματι",712125,54],["ἀποτρέπει",701622,91],["ἐλεγμούς",704413,57]],"Presents and gifts blind the eyes of the wise, and stop up his mouth that he cannot reprove."],["30",[["σοφία",711981,12],["κεκρυμμένη",707923,203],["καὶ",707031,7],["θησαυρὸς",706258,4],["ἀφανής",702181,14],["τίς",712867,359],["ὠφέλεια",714170,12],["ἐν",704639,0],["ἀμφοτέροις",700892,230]],"Wisdom that is hid, and treasure that is hoarded up, what profit is in them both?"],["31",[["κρείσσων",707891,14],["ἄνθρωπος",701163,4],["ἀποκρύπτων",701495,72],["τὴν",709436,8],["μωρίαν",709109,9],["αὐτοῦ",702165,102],["ἢ",705924,7],["ἄνθρωπος",701163,4],["ἀποκρύπτων",701495,72],["τὴν",709436,8],["σοφίαν",711981,9],["αὐτοῦ",702165,102]],"Better is he that hideth his folly than a man that hideth his wisdom."]]