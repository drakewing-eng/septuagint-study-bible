97,28],["τρυγητῶν",712998,81]],null],["17",[["ἐν",704639,0],["εὐλογίᾳ",705633,1],["κυρίου",707996,18],["ἔφθασα",713439,155],["καὶ",707031,7],["ὡς",714148,7],["τρυγῶν",713000,12],["ἐπλήρωσα",710543,155],["ληνόν",708176,9]],null],["18",[["κατανοήσατε",707341,74],["ὅτι",709803,7],["οὐκ",709805,28],["ἐμοὶ",704577,159],["μόνῳ",709003,30],["ἐκοπίασα",707824,155],["ἀλλὰ",700680,7],["πᾶσιν",710177,230],["τοῖς",709436,147],["ζητοῦσιν",705879,349],["παιδείαν",709924,9]],null],["19",[["ἀκούσατέ",700587,74],["μου",709032,133],["μεγιστᾶνες",708657,274],["λαοῦ",708094,18],["καὶ",707031,7],["οἱ",709436,136],["ἡγούμενοι",705931,348],["ἐκκλησίας",704216,17],["ἐνωτίσασθε",704825,186]],"Hear me, O ye great men of the people, and hearken with your ears, ye rulers of the congregation.",{"s":"m","br":"30:27","q":1.0}],["20",[["υἱῷ",713075,114],["καὶ",707031,7],["γυναικί",703209,1],["ἀδελφῷ",700249,114],["καὶ",707031,7],["φίλῳ",713492,30],["μὴ",708851,28],["δῷς",703654,175],["ἐξουσίαν",704974,9],["ἐπὶ",705080,0],["σὲ",711598,163],["ἐν",704639,0],["ζωῇ",705910,1],["σου",711945,133],["καὶ",707031,7],["μὴ",708851,28],["δῷς",703654,175],["ἑτέρῳ",705535,30],["τὰ",709436,41],["χρήματά",713948,42],["σου",711945,133],["ἵνα",706747,7],["μὴ",708851,28],["μεταμεληθεὶς",708805,217],["δέῃ",703312,204],["περὶ",710285,0],["αὐτῶν",702165,70]],"Give not thy son and wife, thy brother and friend, power over thee while thou livest, and give not thy goods to another, lest it repent thee, and thou intreat for the same again.",{"s":"m","br":"30:28","q":1.0}],["21",[["ἕως",705792,7],["ἔτι",705538,28],["ζῇς",705851,154],["καὶ",707031,7],["πνοὴ",710574,12],["ἐν",704639,0],["σοί",711925,159],["μὴ",708851,28],["ἀλλάξῃς",700683,175],["σεαυτὸν",711599,85],["ἐν",704639,0],["πάσῃ",710177,101],["σαρκί",711537,1]],"As long as thou livest and hast breath in thee, give not thyself over to any.",{"s":"m","br":"30:29","q":0.92}],["22",[["κρεῖσσον",707890,26],["γάρ",702963,11],["ἐστιν",704093,91],["τὰ",709436,41],["τέκνα",7127