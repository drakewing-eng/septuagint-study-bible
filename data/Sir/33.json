κέτῃ",709496,114],["κακούργῳ",707070,30],["στρέβλαι",712153,191],["καὶ",707031,7],["βάσανοι",702570,191]],"A yoke and a collar do bow the neck: so are tortures and torments for an evil servant.",{"s":"m","br":"30:35","q":1.0}],["28",[["ἔμβαλε",704547,176],["αὐτὸν",702165,85],["εἰς",704105,0],["ἐργασίαν",705385,9],["ἵνα",706747,7],["μὴ",708851,28],["ἀργῇ",701701,204],["πολλὴν",710646,36],["γὰρ",702963,11],["κακίαν",707054,9],["ἐδίδαξεν",703649,2],["ἡ",709436,10],["ἀργία",701702,12]],"Send him to labour, that he be not idle; for idleness teacheth much evil.",{"s":"m","br":"30:36","q":1.0}],["29",[["εἰς",704105,0],["ἔργα",705396,42],["κατάστησον",707011,176],["καθὼς",707030,7],["πρέπει",710728,91],["αὐτῷ",702165,50],["κἂν",707120,459],["μὴ",708851,28],["πειθαρχῇ",710220,204],["βάρυνον",702553,176],["τὰς",709436,38],["πέδας",710210,39],["αὐτοῦ",702165,102]],"Set him to work, as is fit for him: if he be not obedient, put on more heavy fetters.",{"s":"m","br":"30:37","q":1.0}],["30",[["καὶ",707031,7],["μὴ",708851,28],["περισσεύσῃς",710386,175],["ἐπὶ",705080,0],["πάσῃ",710177,101],["σαρκὶ",711537,1],["καὶ",707031,7],["ἄνευ",701137,0],["κρίσεως",707908,17],["μὴ",708851,28],["ποιήσῃς",710582,175],["μηδέν",708857,46]],"But be not excessive toward any; and without discretion do nothing.",{"s":"m","br":"30:38","q":0.92}],["31",[["εἰ",704071,7],["ἔστιν",704093,91],["σοι",711925,159],["οἰκέτης",709496,4],["ἔστω",704093,31],["ὡς",714148,7],["σύ",712181,164],["ὅτι",709803,7],["ἐν",704639,0],["αἵματι",700442,54],["ἐκτήσω",707932,174],["αὐτόν",702165,85]],"If thou have a servant, let him be unto thee as thyself, because thou hast bought him with a price.",{"s":"m","br":"30:39","q":0.92}],["32",[["εἰ",704071,7],["ἔστιν",704093,91],["σοι",711925,159],["οἰκέτης",709496,4],["ἄγε",700209,240],["αὐτὸν",702165,85],["ὡς",714148,7],["ἀδελφόν",700249,6],["ὅτι",709803,7],["ὡς",714148,7],["ἡ",709436,10],["ψυχή",714070,12],["σου",711945,133],["ἐπιδεήσεις",705118,166],["αὐτῷ",702165,50]],null],["3