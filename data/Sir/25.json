[["1",[["ἐν",704639,0],["τρισὶν",712927,230],["ὡραΐσθην",714130,156],["καὶ",707031,7],["ἀνέστην",701173,155],["ὡραία",714132,68],["ἔναντι",704653,0],["κυρίου",707996,18],["καὶ",707031,7],["ἀνθρώπων",701163,81],["ὁμόνοια",709639,12],["ἀδελφῶν",700249,81],["καὶ",707031,7],["φιλία",713474,12],["τῶν",709436,80],["πλησίον",710547,28],["καὶ",707031,7],["γυνὴ",703209,12],["καὶ",707031,7],["ἀνὴρ",701150,4],["ἑαυτοῖς",703917,151],["συμπεριφερόμενοι",712330,348]],"In three things I was beautified, and stood up beautiful both before God and men: the unity of brethren, the love of neighbours, a man and a wife that agree together."],["2",[["τρία",712927,68],["δὲ",703303,11],["εἴδη",704074,42],["ἐμίσησεν",708935,2],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["καὶ",707031,7],["προσώχθισα",710945,155],["σφόδρα",712586,28],["τῇ",709436,100],["ζωῇ",705910,1],["αὐτῶν",702165,40],["πτωχὸν",711076,6],["ὑπερήφανον",713139,27],["καὶ",707031,7],["πλούσιον",710560,27],["ψεύστην",714046,6],["γέροντα",703065,6],["μοιχὸν",708980,6],["ἐλαττούμενον",704394,212],["συνέσει",712460,1]],"Three sorts of men my soul hateth, and I am greatly offended at their life: a poor man that is proud, a rich man that is a liar, and an old adulterer that doateth."],["3",[["ἐν",704639,0],["νεότητι",709258,1],["οὐ",709805,28],["συναγείοχας",712375,266],["καὶ",707031,7],["πῶς",711121,28],["ἂν",700900,11],["εὕροις",705676,657],["ἐν",704639,0],["τῷ",709436,53],["γήρᾳ",703089,54],["σου",711945,133]],"If thou hast gathered nothing in thy youth, how canst thou find any thing in thine age?"],["4",[["ὡς",714148,7],["ὡραῖον",714132,26],["πολιαῖς",710607,76],["κρίσις",707908,12],["καὶ",707031,7],["πρεσβυτέροις",710735,148],["ἐπιγνῶναι",705104,106],["βουλήν",702792,9]],"O how comely a thing is judgment for grey hairs, and for ancient men to know counsel!"],["5",[["ὡς",714148,7],["ὡραία",714132,195],["γερόντων",703065,81],["σοφία",711981,12],["καὶ",707031,7],["δεδοξασμένοις",703792,521],["διανόημα",703529,15],["καὶ",707031,7],["βουλή",702792,12]],"O how comely is the wisdom of old men, and understanding and counsel to men of honour!"],["6",[["στέφανος",712083,4],["γερόντων",703065,81],["πολυπειρία",710636,12],["καὶ",707031,7],["τὸ",709436,34],["καύχημα",707570,15],["αὐτῶν",702165,40],["φόβος",713534,4],["κυρίου",707996,18]],"Much experience is the crown of old men, and the fear of God is their glory."],["7",[["ἐννέα",704754,59],["ὑπονοήματα",713228,42],["ἐμακάρισα",708396,155],["ἐν",704639,0],["καρδίᾳ",707141,1],["καὶ",707031,7],["τὸ",709436,24],["δέκατον",703343,46],["ἐρῶ",705415,165],["ἐπὶ",705080,0],["γλώσσης",703120,17],["ἄνθρωπος",701163,4],["εὐφραινόμενος",705715,122],["ἐπὶ",705080,0],["τέκνοις",712761,96],["ζῶν",705851,72],["καὶ",707031,7],["βλέπων",702740,72],["ἐπὶ",705080,0],["πτώσει",711072,1],["ἐχθρῶν",705779,169]],"There be nine things which I have judged in mine heart to be happy, and the tenth I will utter with my tongue: A man that hath joy of his children; and he that liveth to see the fall of his enemy."],["8",[["μακάριος",708397,14],["ὁ",709436,3],["συνοικῶν",712493,72],["γυναικὶ",703209,1],["συνετῇ",712464,101],["καὶ",707031,7],["ὃς",709781,213],["ἐν",704639,0],["γλώσσῃ",703120,1],["οὐκ",709805,28],["ὠλίσθησεν",709579,2],["καὶ",707031,7],["ὃς",709781,213],["οὐκ",709805,28],["ἐδούλευσεν",703814,2],["ἀναξίῳ",701021,30],["ἑαυτοῦ",703917,102]],"Well is he that dwelleth with a wife of understanding, and that hath not slipped with his tongue, and that hath not served a man more unworthy than himself."],["9",[["μακάριος",708397,14],["ὃς",709781,213],["εὗρεν",705676,2],["φρόνησιν",713588,9],["καὶ",707031,7],["ὁ",709436,3],["διηγούμενος",703679,122],["εἰς",704105,0],["ὦτα",709852,25],["ἀκουόντων",700587,170]],"Well is he that hath found prudence, and he that speaketh in the ears of them that will hear:"],["10",[["ὡς",714148,7],["μέγας",708653,14],["ὁ",709436,3],["εὑρὼν",705676,182],["σοφίαν",711981,9],["ἀλλ᾿",700680,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ὑπὲρ",713111,0],["τὸν",709436,5],["φοβούμενον",713532,212],["τὸν",709436,5],["κύριον",707996,6]],"O how great is he that findeth wisdom! yet there is none above him that feareth the Lord."],["11",[["φόβος",713534,4],["κυρίου",707996,18],["ὑπὲρ",713111,0],["πᾶν",710177,46],["ὑπερέβαλεν",713127,2],["ὁ",709436,3],["κρατῶν",707879,72],["αὐτοῦ",702165,102],["τίνι",712867,435],["ὁμοιωθήσεται",709628,134]],"But the love of the Lord passeth all things for illumination: he that holdeth it, whereto shall he be likened?"],["13",[["πᾶσαν",710177,36],["πληγὴν",710527,9],["καὶ",707031,7],["μὴ",708851,28],["πληγὴν",710527,9],["καρδίας",707141,17],["καὶ",707031,7],["πᾶσαν",710177,36],["πονηρίαν",710659,9],["καὶ",707031,7],["μὴ",708851,28],["πονηρίαν",710659,9],["γυναικός",703209,17]],"[Give me] any plague, but the plague of the heart: and any wickedness, but the wickedness of a woman:"],["14",[["πᾶσαν",710177,36],["ἐπαγωγὴν",704995,9],["καὶ",707031,7],["μὴ",708851,28],["ἐπαγωγὴν",704995,9],["μισούντων",708935,170],["καὶ",707031,7],["πᾶσαν",710177,36],["ἐκδίκησιν",704175,9],["καὶ",707031,7],["μὴ",708851,28],["ἐκδίκησιν",704175,9],["ἐχθρῶν",705779,169]],"and any affliction, but the affliction from them that hate me: and any revenge, but the revenge of enemies."],["15",[["οὐκ",709805,28],["ἔστιν",704093,91],["κεφαλὴ",707639,12],["ὑπὲρ",713111,0],["κεφαλὴν",707639,9],["ὄφεως",709875,18],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["θυμὸς",706334,4],["ὑπὲρ",713111,0],["θυμὸν",706334,6],["ἐχθροῦ",705779,116]],"There is no head above the head of a serpent; and there is no wrath above the wrath of an enemy."],["16",[["συνοικῆσαι",712493,106],["λέοντι",708171,114],["καὶ",707031,7],["δράκοντι",703822,114],["εὐδοκήσω",705565,165],["ἢ",705924,7],["συνοικῆσαι",712493,106],["μετὰ",708780,0],["γυναικὸς",703209,17],["πονηρᾶς",710660,82]],"I had rather dwell with a lion and a dragon, than to keep house with a wicked woman."],["17",[["πονηρία",710659,12],["γυναικὸς",703209,17],["ἀλλοιοῖ",700694,91],["τὴν",709436,8],["ὅρασιν",709721,9],["αὐτῆς",702165,86],["καὶ",707031,7],["σκοτοῖ",711890,91],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτῆς",702165,86],["ὡς",714148,7],["ἄρκος",701766,4]],"The wickedness of a woman changeth her face, and darkeneth her countenance like sackcloth."],["18",[["ἀνὰ",700902,0],["μέσον",708768,27],["τῶν",709436,80],["πλησίον",710547,28],["αὐτοῦ",702165,102],["ἀναπεσεῖται",701033,93],["ὁ",709436,3],["ἀνὴρ",701150,4],["αὐτῆς",702165,86],["καὶ",707031,7],["ἀκουσίως",700583,28],["ἀνεστέναξεν",701057,2],["πικρά",710475,68]],"Her husband shall sit among his neighbours; and when he heareth it shall sigh bitterly."],["19",[["μικρὰ",708915,29],["πᾶσα",710177,29],["κακία",707054,12],["πρὸς",710844,0],["κακίαν",707054,9],["γυναικός",703209,17],["κλῆρος",707727,4],["ἁμαρτωλοῦ",700776,116],["ἐπιπέσοι",705225,583],["αὐτῇ",702165,105]],"All wickedness is but little to the wickedness of a woman; let the portion of a sinner fall upon her."],["20",[["ἀνάβασις",700907,12],["ἀμμώδης",700846,29],["ἐν",704639,0],["ποσὶν",710707,148],["πρεσβυτέρου",710735,18],["οὕτως",709859,28],["γυνὴ",703209,12],["γλωσσώδης",703125,29],["ἀνδρὶ",701150,114],["ἡσύχῳ",706037,30]],"As the climbing up a sandy way is to the feet of the aged, so is a wife full of words to a quiet man."],["21",[["μὴ",708851,28],["προσπέσῃς",710952,175],["ἐπὶ",705080,0],["κάλλος",707093,25],["γυναικὸς",703209,17],["καὶ",707031,7],["γυναῖκα",703209,9],["μὴ",708851,28],["ἐπιποθήσῃς",705228,175]],"Stumble not at the beauty of a woman, and desire her not for pleasure."],["22",[["ὀργὴ",709728,12],["καὶ",707031,7],["ἀναίδεια",700958,12],["καὶ",707031,7],["αἰσχύνη",700483,12],["μεγάλη",708653,29],["γυνὴ",703209,12],["ἐὰν",703912,7],["ἐπιχορηγῇ",705338,172],["τῷ",709436,113],["ἀνδρὶ",701150,114],["αὐτῆς",702165,86]],"A woman, if she maintain her husband, is full of anger, impudence, and much reproach."],["23",[["καρδία",707141,12],["ταπεινὴ",712714,29],["καὶ",707031,7],["πρόσωπον",710986,15],["σκυθρωπὸν",711897,26],["καὶ",707031,7],["πληγὴ",710527,12],["καρδίας",707141,17],["γυνὴ",703209,12],["πονηρά",710660,29],["χεῖρες",713787,191],["παρειμέναι",710149,423],["καὶ",707031,7],["γόνατα",703172,64],["παραλελυμένα",710070,370],["ἥτις",709793,412],["οὐ",709805,28],["μακαριεῖ",708396,127],["τὸν",709436,5],["ἄνδρα",701150,6],["αὐτῆς",702165,86]],"A wicked woman abateth the courage, maketh an heavy countenance and a wounded heart: a woman that will not comfort her husband in distress maketh weak hands and feeble knees."],["24",[["ἀπὸ",701425,0],["γυναικὸς",703209,17],["ἀρχὴ",701836,12],["ἁμαρτίας",700775,17],["καὶ",707031,7],["δι᾿",703417,0],["αὐτὴν",702165,104],["ἀποθνῄσκομεν",701461,243],["πάντες",710177,138]],"Of the woman came the beginning of sin, and through her we all die."],["25",[["μὴ",708851,28],["δῷς",703654,175],["ὕδατι",713071,54],["διέξοδον",703668,9],["μηδὲ",708855,7],["γυναικὶ",703209,1],["πονηρᾷ",710660,101],["παρρησίαν",710173,9]],"Give the water no passage; neither a wicked woman liberty to gad abroad."],["26",[["εἰ",704071,7],["μὴ",708851,28],["πορεύεται",710667,117],["κατὰ",707200,0],["χεῖράς",713787,39],["σου",711945,133],["ἀπὸ",701425,0],["τῶν",709436,130],["σαρκῶν",711537,65],["σου",711945,133],["ἀπότεμε",701611,176],["αὐτήν",702165,104]],"If she go not as thou wouldest have her, cut her off from thy flesh, and give her a bill of divorce, and let her go."]]