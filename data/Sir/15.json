[["1",[["ὁ",709436,3],["φοβούμενος",713532,122],["κύριον",707996,6],["ποιήσει",710582,127],["αὐτό",702165,129],["καὶ",707031,7],["ὁ",709436,3],["ἐγκρατὴς",703990,14],["τοῦ",709436,35],["νόμου",709349,18],["καταλήμψεται",707300,93],["αὐτήν",702165,104]],"He that feareth the Lord will do good; and he that hath the knowledge of the law shall obtain her;"],["2",[["καὶ",707031,7],["ὑπαντήσεται",713098,93],["αὐτῷ",702165,50],["ὡς",714148,7],["μήτηρ",708892,12],["καὶ",707031,7],["ὡς",714148,7],["γυνὴ",703209,12],["παρθενίας",710146,17],["προσδέξεται",710874,93],["αὐτόν",702165,85]],"and as a mother shall she meet him, and receive him as a wife married of a virgin."],["3",[["ψωμιεῖ",714077,127],["αὐτὸν",702165,85],["ἄρτον",701829,6],["συνέσεως",712460,17],["καὶ",707031,7],["ὕδωρ",713071,25],["σοφίας",711981,17],["ποτίσει",710700,127],["αὐτόν",702165,85]],"With the bread of understanding shall she feed him, and give him the water of wisdom to drink."],["4",[["στηριχθήσεται",712098,134],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["κλιθῇ",707738,384],["καὶ",707031,7],["ἐπ᾿",705080,0],["αὐτῆς",702165,86],["ἐφέξει",705076,127],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["καταισχυνθῇ",707257,384]],"He shall be stayed upon her, and shall not be moved; and shall rely upon her, and shall not be confounded."],["5",[["καὶ",707031,7],["ὑψώσει",713289,127],["αὐτὸν",702165,85],["παρὰ",709995,0],["τοὺς",709436,58],["πλησίον",710547,28],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["μέσῳ",708768,97],["ἐκκλησίας",704216,17],["ἀνοίξει",701186,127],["τὸ",709436,24],["στόμα",712125,25],["αὐτοῦ",702165,102]],"She shall exalt him above his neighbours, and in the midst of the congregation shall she open his mouth."],["6",[["εὐφροσύνην",705717,9],["καὶ",707031,7],["στέφανον",712083,6],["ἀγαλλιάματος",700112,21],["εὑρήσει",705676,127],["καὶ",707031,7],["ὄνομα",709666,25],["αἰῶνος",700504,18],["κατακληρονομήσει",707274,127]],"He shall find joy and a crown of gladness, and she shall cause him to inherit an everlasting name."],["7",[["οὐ",709805,28],["μὴ",708851,28],["καταλήμψονται",707300,135],["αὐτὴν",702165,104],["ἄνθρωποι",701163,52],["ἀσύνετοι",702034,138],["καὶ",707031,7],["ἄνδρες",701150,52],["ἁμαρτωλοὶ",700776,138],["οὐ",709805,28],["μὴ",708851,28],["ἴδωσιν",709725,234],["αὐτήν",702165,104]],"But foolish men shall not attain unto her, and sinners shall not see her."],["8",[["μακράν",708411,28],["ἐστιν",704093,91],["ὑπερηφανίας",713138,17],["καὶ",707031,7],["ἄνδρες",701150,52],["ψεῦσται",714046,52],["οὐ",709805,28],["μὴ",708851,28],["μνησθήσονται",708923,144],["αὐτῆς",702165,86]],"For she is far from pride, and men that are liars cannot remember her."],["9",[["οὐχ",709805,28],["ὡραῖος",714132,14],["αἶνος",700462,4],["ἐν",704639,0],["στόματι",712125,54],["ἁμαρτωλοῦ",700776,116],["ὅτι",709803,7],["οὐ",709805,28],["παρὰ",709995,0],["κυρίου",707996,18],["ἀπεστάλη",701592,37]],"Praise is not seemly in the mouth of a sinner, for it was not sent him of the Lord."],["10",[["ἐν",704639,0],["γὰρ",702963,11],["σοφίᾳ",711981,1],["ῥηθήσεται",705415,134],["αἶνος",700462,4],["καὶ",707031,7],["ὁ",709436,3],["κύριος",707996,4],["εὐοδώσει",705654,127],["αὐτόν",702165,85]],"For praise shall be uttered in wisdom, and the Lord will prosper it."],["11",[["μὴ",708851,28],["εἴπῃς",705373,175],["ὅτι",709803,7],["διὰ",703417,0],["κύριον",707996,6],["ἀπέστην",702214,155],["ἃ",709781,69],["γὰρ",702963,11],["ἐμίσησεν",708935,2],["οὐ",709805,28],["ποιήσει",710582,127]],"Say not thou, It is through the Lord that I fell away: for thou oughtest not to do the things that he hateth."],["12",[["μὴ",708851,28],["εἴπῃς",705373,175],["ὅτι",709803,7],["αὐτός",702165,121],["με",708618,163],["ἐπλάνησεν",710495,2],["οὐ",709805,28],["γὰρ",702963,11],["χρείαν",713938,9],["ἔχει",705785,91],["ἀνδρὸς",701150,18],["ἁμαρτωλοῦ",700776,116]],"Say not thou, He hath caused me to err: for he hath no need of the sinful man."],["13",[["πᾶν",710177,46],["βδέλυγμα",702604,25],["ἐμίσησεν",708935,2],["ὁ",709436,3],["κύριος",707996,4],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀγαπητὸν",700124,26],["τοῖς",709436,147],["φοβουμένοις",713532,341],["αὐτόν",702165,85]],"The Lord hateth all abomination; and they that fear God love it not."],["14",[["αὐτὸς",702165,121],["ἐξ",704132,0],["ἀρχῆς",701836,17],["ἐποίησεν",710582,2],["ἄνθρωπον",701163,6],["καὶ",707031,7],["ἀφῆκεν",702211,2],["αὐτὸν",702165,85],["ἐν",704639,0],["χειρὶ",713787,1],["διαβουλίου",703431,21],["αὐτοῦ",702165,102]],"He himself made man from the beginning, and left him in the hand of his counsel;"],["15",[["ἐὰν",703912,7],["θέλῃς",706176,205],["συντηρήσεις",712512,166],["ἐντολὰς",704802,39],["καὶ",707031,7],["πίστιν",710484,9],["ποιῆσαι",710582,106],["εὐδοκίας",705566,17]],"if thou wilt, to keep the commandments, and to perform acceptable faithfulness."],["16",[["παρέθηκέν",710111,2],["σοι",711925,159],["πῦρ",711088,25],["καὶ",707031,7],["ὕδωρ",713071,25],["οὗ",709806,28],["ἐὰν",703912,7],["θέλῃς",706176,205],["ἐκτενεῖς",704322,166],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133]],"He hath set fire and water before thee: stretch forth thy hand unto whether thou wilt."],["17",[["ἔναντι",704653,28],["ἀνθρώπων",701163,81],["ἡ",709436,10],["ζωὴ",705910,12],["καὶ",707031,7],["ὁ",709436,3],["θάνατος",706096,4],["καὶ",707031,7],["ὃ",709781,128],["ἐὰν",703912,7],["εὐδοκήσῃ",705565,172],["δοθήσεται",703654,134],["αὐτῷ",702165,50]],"Before man is life and death; and whether he liketh shall be given him."],["18",[["ὅτι",709803,7],["πολλὴ",710646,29],["ἡ",709436,10],["σοφία",711981,12],["τοῦ",709436,35],["κυρίου",707996,18],["ἰσχυρὸς",706855,14],["ἐν",704639,0],["δυναστείᾳ",703841,1],["καὶ",707031,7],["βλέπων",702740,72],["τὰ",709436,41],["πάντα",710177,68]],"For the wisdom of the Lord is great, and he is mighty in power, and beholdeth all things:"],["19",[["καὶ",707031,7],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τοὺς",709436,58],["φοβουμένους",713532,236],["αὐτόν",702165,85],["καὶ",707031,7],["αὐτὸς",702165,121],["ἐπιγνώσεται",705104,93],["πᾶν",710177,46],["ἔργον",705396,25],["ἀνθρώπου",701163,18]],"and his eyes are upon them that fear him, and he knoweth every work of man."],["20",[["οὐκ",709805,28],["ἐνετείλατο",704791,23],["οὐδενὶ",709817,30],["ἀσεβεῖν",701906,55],["καὶ",707031,7],["οὐκ",709805,28],["ἔδωκεν",703654,2],["ἄνεσιν",701134,9],["οὐδενὶ",709817,30],["ἁμαρτάνειν",700773,55]],"He hath commanded no man to do wickedly, neither hath he given any man licence to sin."]]