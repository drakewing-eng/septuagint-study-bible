[["1",[["γαυρίαμα",702981,15],["ὕψους",713288,21],["στερέωμα",712077,15],["καθαριότητος",706986,17],["εἶδος",704074,25],["οὐρανοῦ",709844,18],["ἐν",704639,0],["ὁράματι",709720,54],["δόξης",703791,17]],"The pride of the height, the clear firmament, the beauty of heaven, with his glorious shew;"],["2",[["ἥλιος",705974,4],["ἐν",704639,0],["ὀπτασίᾳ",709714,1],["διαγγέλλων",703432,72],["ἐν",704639,0],["ἐξόδῳ",704948,1],["σκεῦος",711844,15],["θαυμαστόν",706138,26],["ἔργον",705396,15],["ὑψίστου",713287,116]],"the sun when it appeareth, declaring at his rising a marvellous instrument, the work of the most High:"],["3",[["ἐν",704639,0],["μεσημβρίᾳ",708758,1],["αὐτοῦ",702165,102],["ἀναξηραίνει",701020,91],["χώραν",714011,9],["καὶ",707031,7],["ἐναντίον",704654,0],["καύματος",707564,21],["αὐτοῦ",702165,102],["τίς",712867,158],["ὑποστήσεται",713281,93]],"at noon it parcheth the country, and who can abide the burning heat thereof?"],["4",[["κάμινον",707113,9],["φυσῶν",713631,72],["ἐν",704639,0],["ἔργοις",705396,96],["καύματος",707564,21],["τριπλασίως",712950,28],["ἥλιος",705974,4],["ἐκκαίων",704205,72],["ὄρη",709768,42],["ἀτμίδας",702100,39],["πυρώδεις",711113,119],["ἐκφυσῶν",704366,72],["καὶ",707031,7],["ἐκλάμπων",704233,72],["ἀκτῖνας",700615,39],["ἀμαυροῖ",700787,91],["ὀφθαλμούς",709870,57]],"A man blowing a furnace is in works of heat, but the sun burneth the mountains three times more; breathing out fiery vapours, and sending forth bright beams, it dimmeth the eyes."],["5",[["μέγας",708653,14],["κύριος",707996,4],["ὁ",709436,3],["ποιήσας",710582,182],["αὐτόν",702165,85],["καὶ",707031,7],["ἐν",704639,0],["λόγοις",708236,148],["αὐτοῦ",702165,102],["κατέσπευσεν",707433,2],["πορείαν",710665,9]],"Great is the Lord that made it; and at his commandment it runneth hastily."],["6",[["καὶ",707031,7],["ἡ",709436,10],["σελήνη",711650,12],["ἐν",704639,0],["πᾶσιν",710177,94],["εἰς",704105,0],["καιρὸν",707047,6],["αὐτῆς",702165,86],["ἀνάδειξιν",700936,9],["χρόνων",713969,81],["καὶ",707031,7],["σημεῖον",711748,25],["αἰῶνος",700504,18]],"He made the moon also to serve in her season for a declaration of times, and a sign of the world."],["7",[["ἀπὸ",701425,0],["σελήνης",711650,17],["σημεῖον",711748,25],["ἑορτῆς",704990,17],["φωστὴρ",713643,4],["μειούμενος",708684,122],["ἐπὶ",705080,0],["συντελείας",712509,17]],"From the moon is the sign of feasts, a light that decreaseth in her perfection."],["8",[["μὴν",708874,4],["κατὰ",707200,0],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτῆς",702165,86],["ἐστιν",704093,91],["αὐξανόμενος",702144,122],["θαυμαστῶς",706140,28],["ἐν",704639,0],["ἀλλοιώσει",700695,1],["σκεῦος",711844,15],["παρεμβολῶν",710133,65],["ἐν",704639,0],["ὕψει",713288,54],["ἐν",704639,0],["στερεώματι",712077,54],["οὐρανοῦ",709844,18],["ἐκλάμπων",704233,72]],"The month is called after her name, increasing wonderfully in her changing, being an instrument of the armies above, shining in the firmament of heaven;"],["9",[["κάλλος",707093,25],["οὐρανοῦ",709844,18],["δόξα",703791,12],["ἄστρων",702024,44],["κόσμος",707851,4],["φωτίζων",713646,72],["ἐν",704639,0],["ὑψίστοις",713287,94],["κυρίου",707996,18]],"the beauty of heaven, the glory of the stars, an ornament giving light in the highest places of the Lord."],["10",[["ἐν",704639,0],["λόγοις",708236,148],["ἁγίου",700159,116],["στήσονται",706846,135],["κατὰ",707200,0],["κρίμα",707903,25],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἐκλυθῶσιν",704254,272],["ἐν",704639,0],["φυλακαῖς",713613,76],["αὐτῶν",702165,40]],"At the commandment of the Holy One they will stand in their order, and never faint in their watches."],["11",[["ἰδὲ",709725,176],["τόξον",712898,25],["καὶ",707031,7],["εὐλόγησον",705631,176],["τὸν",709436,5],["ποιήσαντα",710582,365],["αὐτὸ",702165,129],["σφόδρα",712586,28],["ὡραῖον",714132,46],["ἐν",704639,0],["τῷ",709436,53],["αὐγάσματι",702120,54],["αὐτοῦ",702165,49]],"Look upon the rainbow, and praise him that made it; very beautiful it is in the brightness thereof."],["12",[["ἐγύρωσεν",703211,2],["οὐρανὸν",709844,6],["ἐν",704639,0],["κυκλώσει",707961,1],["δόξης",703791,17],["χεῖρες",713787,191],["ὑψίστου",713287,116],["ἐτάνυσαν",712710,2],["αὐτό",702165,129]],"It compasseth the heaven about with a glorious circle, and the hands of the most High have bended it."],["13",[["προστάγματι",710959,54],["αὐτοῦ",702165,102],["κατέσπευσεν",707433,2],["χιόνα",713870,9],["καὶ",707031,7],["ταχύνει",712749,91],["ἀστραπὰς",702021,39],["κρίματος",707903,21],["αὐτοῦ",702165,102]],"By his commandment he maketh the snow to fall apace, and sendeth swiftly the lightnings of his judgment."],["14",[["διὰ",703417,0],["τοῦτο",709858,129],["ἠνεῴχθησαν",701186,99],["θησαυροί",706258,52],["καὶ",707031,7],["ἐξέπτησαν",704279,99],["νεφέλαι",709277,191],["ὡς",714148,7],["πετεινά",710439,195]],"Through this the treasures are opened: and clouds fly forth as fowls."],["15",[["ἐν",704639,0],["μεγαλείῳ",708625,97],["αὐτοῦ",702165,102],["ἴσχυσεν",706859,2],["νεφέλας",709277,39],["καὶ",707031,7],["διεθρύβησαν",703457,99],["λίθοι",708196,52],["χαλάζης",713667,17]],"By his great power he maketh the clouds firm, and the hailstones are broken small."],["16",[["καὶ",707031,7],["ἐν",704639,0],["ὀπτασίᾳ",709714,1],["αὐτοῦ",702165,102],["σαλευθήσεται",711403,134],["ὄρη",709768,42],["ἐν",704639,0],["θελήματι",706170,96],["αὐτοῦ",702165,102],["πνεύσεται",710570,93],["νότος",709364,4]],"At his sight the mountains are shaken, and at his will the south wind bloweth."],["17",[["φωνὴ",713640,12],["βροντῆς",702816,17],["αὐτοῦ",702165,102],["ὠνείδισεν",709655,2],["γῆν",703083,9],["καὶ",707031,7],["καταιγὶς",707254,12],["βορέου",702765,18],["καὶ",707031,7],["συστροφὴ",712563,12],["πνεύματος",710566,21]],"The noise of the thunder maketh the earth to tremble: so doth the northern storm and the whirlwind: as birds flying he scattereth the snow, and the falling down thereof is as the lighting of grasshoppers:"],["18",[["ὡς",714148,7],["πετεινὰ",710439,68],["καθιπτάμενα",707009,388],["πάσσει",710179,91],["χιόνα",713870,9],["καὶ",707031,7],["ὡς",714148,7],["ἀκρὶς",700599,12],["καταλύουσα",707323,188],["ἡ",709436,10],["κατάβασις",707206,12],["αὐτῆς",702165,86],["κάλλος",707093,25],["λευκότητος",708166,17],["αὐτῆς",702165,86],["ἐκθαυμάσει",704192,127],["ὀφθαλμός",709870,4],["καὶ",707031,7],["ἐπὶ",705080,0],["τοῦ",709436,35],["ὑετοῦ",713074,18],["αὐτῆς",702165,86],["ἐκστήσεται",704940,93],["καρδία",707141,12]],"the eye marvelleth at the beauty of the whiteness thereof, and the heart is astonished at the raining of it."],["19",[["καὶ",707031,7],["πάχνην",710203,9],["ὡς",714148,7],["ἅλα",700634,6],["ἐπὶ",705080,0],["γῆς",703083,17],["χέει",713845,91],["καὶ",707031,7],["παγεῖσα",710452,307],["γίνεται",703104,117],["σκολόπων",711871,18],["ἄκρα",700610,195]],"The hoarfrost also as salt he poureth on the earth, and being congealed, it becometh sharp peaks."],["20",[["ψυχρὸς",714075,14],["ἄνεμος",701123,4],["βορέης",702765,4],["πνεύσει",710570,127],["καὶ",707031,7],["παγήσεται",710452,134],["κρύσταλλος",707926,4],["ἐφ᾿",705080,0],["ὕδατος",713071,21],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["συναγωγὴν",712376,9],["ὕδατος",713071,21],["καταλύσει",707321,1],["καὶ",707031,7],["ὡς",714148,7],["θώρακα",706356,6],["ἐνδύσεται",704701,93],["τὸ",709436,34],["ὕδωρ",713071,15]],"When the cold north wind bloweth, and the water is congealed into ice, it abideth upon every gathering together of water, and clotheth the water as with a breastplate."],["21",[["καταφάγεται",707519,93],["ὄρη",709768,42],["καὶ",707031,7],["ἔρημον",705420,9],["ἐκκαύσει",704205,127],["καὶ",707031,7],["ἀποσβέσει",701567,127],["χλόην",713877,9],["ὡς",714148,7],["πῦρ",711088,15]],"It devoureth the mountains, and burneth the wilderness, and consumeth the grass as fire."],["22",[["ἴασις",706444,12],["πάντων",710177,83],["κατὰ",707200,0],["σπουδὴν",712035,9],["ὁμίχλη",709615,12],["δρόσος",703835,12],["ἀπαντῶσα",701345,188],["ἀπὸ",701425,0],["καύσωνος",707567,18],["ἱλαρώσει",706725,127]],"A present remedy of all is a mist coming speedily: a dew coming after heat refresheth."],["23",[["λογισμῷ",708234,114],["αὐτοῦ",702165,102],["ἐκόπασεν",707819,2],["ἄβυσσον",700098,9],["καὶ",707031,7],["ἐφύτευσεν",713636,2],["ἐν",704639,0],["αὐτῇ",702165,105],["νήσους",709302,39]],"By his counsel he appeaseth the deep, and planteth islands therein."],["24",[["οἱ",709436,136],["πλέοντες",710526,146],["τὴν",709436,8],["θάλασσαν",706069,9],["διηγοῦνται",703679,269],["τὸν",709436,5],["κίνδυνον",707678,6],["αὐτῆς",702165,86],["καὶ",707031,7],["ἀκοαῖς",700561,76],["ὠτίων",714165,44],["ἡμῶν",705999,145],["θαυμάζομεν",706135,243]],"They that sail on the sea tell of the danger thereof; and when we hear it with our ears, we marvel thereat."],["25",[["καὶ",707031,7],["ἐκεῖ",704181,28],["τὰ",709436,63],["παράδοξα",710016,195],["καὶ",707031,7],["θαυμάσια",706136,195],["ἔργα",705396,64],["ποικιλία",710586,12],["παντὸς",710177,92],["ζῴου",705916,21],["κτίσις",707939,12],["κητῶν",707664,44]],"For therein be strange and wondrous works, variety of all kinds of beasts, the race of whales."],["26",[["δι᾿",703417,0],["αὐτὸν",702165,85],["εὐοδοῖ",705654,91],["ἄγγελος",700140,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["λόγῳ",708236,114],["αὐτοῦ",702165,102],["σύγκειται",712210,117],["τὰ",709436,63],["πάντα",710177,195]],"By him the end of them hath prosperous success, and by his word all things consist."],["27",[["πολλὰ",710646,68],["ἐροῦμεν",705415,275],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἀφικώμεθα",702212,276],["καὶ",707031,7],["συντέλεια",712509,12],["λόγων",708236,81],["τὸ",709436,34],["πᾶν",710177,26],["ἐστιν",704093,91],["αὐτός",702165,121]],"We may speak much, and yet come short; wherefore in sum, he is all."],["28",[["δοξάζοντες",703792,146],["ποῦ",710706,28],["ἰσχύσομεν",706859,141],["αὐτὸς",702165,121],["γὰρ",702963,11],["ὁ",709436,3],["μέγας",708653,14],["παρὰ",709995,0],["πάντα",710177,68],["τὰ",709436,41],["ἔργα",705396,42],["αὐτοῦ",702165,102]],"How shall we be able to magnify him? for he is great above all his works."],["29",[["φοβερὸς",713530,14],["κύριος",707996,4],["καὶ",707031,7],["σφόδρα",712586,28],["μέγας",708653,14],["καὶ",707031,7],["θαυμαστὴ",706138,29],["ἡ",709436,10],["δυναστεία",703841,12],["αὐτοῦ",702165,102]],"The Lord is terrible and very great, and marvellous is his power."],["30",[["δοξάζοντες",703792,146],["κύριον",707996,6],["ὑψώσατε",713289,74],["καθ᾿",707200,0],["ὅσον",709788,46],["ἂν",700900,11],["δύνησθε",703838,375],["ὑπερέξει",713134,127],["γὰρ",702963,11],["καὶ",707031,28],["ἔτι",705538,28],["καὶ",707031,7],["ὑψοῦντες",713289,146],["αὐτὸν",702165,85],["πληθύνατε",710530,74],["ἐν",704639,0],["ἰσχύι",706858,1],["μὴ",708851,28],["κοπιᾶτε",707824,240],["οὐ",709805,28],["γὰρ",702963,11],["μὴ",708851,28],["ἀφίκησθε",702212,142]],"When ye glorify the Lord, exalt him as much as ye can; for even yet will he far exceed: and when ye exalt him, put forth all your strength, and be not weary; for ye can never go far enough."],["31",[["τίς",712867,158],["ἑόρακεν",709725,171],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐκδιηγήσεται",704172,93],["καὶ",707031,7],["τίς",712867,158],["μεγαλυνεῖ",708647,91],["αὐτὸν",702165,85],["καθώς",707030,7],["ἐστιν",704093,91]],"Who hath seen him, that he might tell us? and who can magnify him as he is?"],["32",[["πολλὰ",710646,195],["ἀπόκρυφά",701497,195],["ἐστιν",704093,91],["μείζονα",708653,195],["τούτων",709858,70],["ὀλίγα",709568,68],["γὰρ",702963,11],["ἑωράκαμεν",709725,314],["τῶν",709436,43],["ἔργων",705396,44],["αὐτοῦ",702165,102]],"There are yet hid greater things than these be, for we have seen but a few of his works."],["33",[["πάντα",710177,68],["γὰρ",702963,11],["ἐποίησεν",710582,2],["ὁ",709436,3],["κύριος",707996,4],["καὶ",707031,7],["τοῖς",709436,147],["εὐσεβέσιν",705687,230],["ἔδωκεν",703654,2],["σοφίαν",711981,9]],"For the Lord hath made all things; and to the godly hath he given wisdom."]]