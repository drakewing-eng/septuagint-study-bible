[["1",[["ὁ",709436,3],["ἐκδικῶν",704174,72],["παρὰ",709995,0],["κυρίου",707996,18],["εὑρήσει",705676,127],["ἐκδίκησιν",704175,9],["καὶ",707031,7],["τὰς",709436,38],["ἁμαρτίας",700775,39],["αὐτοῦ",702165,102],["διατηρῶν",703607,72],["διατηρήσει",703607,127]],"He that revengeth shall find vengeance from the Lord, and he will surely keep his sins [in remembrance]."],["2",[["ἄφες",702211,176],["ἀδίκημα",700270,25],["τῷ",709436,113],["πλησίον",710547,28],["σου",711945,133],["καὶ",707031,7],["τότε",712908,28],["δεηθέντος",703394,319],["σου",711945,133],["αἱ",709436,190],["ἁμαρτίαι",700775,191],["σου",711945,133],["λυθήσονται",708288,144]],"Forgive thy neighbour the hurt that he hath done unto thee, so shall thy sins also be forgiven when thou prayest."],["3",[["ἄνθρωπος",701163,4],["ἀνθρώπῳ",701163,114],["συντηρεῖ",712512,91],["ὀργήν",709728,9],["καὶ",707031,7],["παρὰ",709995,0],["κυρίου",707996,18],["ζητεῖ",705879,91],["ἴασιν",706444,9]],"One man beareth hatred against another, and doth he seek pardon from the Lord?"],["4",[["ἐπ᾿",705080,0],["ἄνθρωπον",701163,6],["ὅμοιον",709626,27],["αὐτῷ",702165,50],["οὐκ",709805,28],["ἔχει",705785,91],["ἔλεος",704426,25],["καὶ",707031,7],["περὶ",710285,0],["τῶν",709436,130],["ἁμαρτιῶν",700775,65],["αὐτοῦ",702165,102],["δεῖται",703394,117]],"He sheweth no mercy to a man, which is like himself: and doth he ask forgiveness of his own sins?"],["5",[["αὐτὸς",702165,121],["σὰρξ",711537,12],["ὢν",704093,72],["διατηρεῖ",703607,91],["μῆνιν",708878,9],["τίς",712867,158],["ἐξιλάσεται",704932,93],["τὰς",709436,38],["ἁμαρτίας",700775,39],["αὐτοῦ",702165,102]],"If he that is but flesh nourish hatred, who will intreat for pardon of his sins?"],["6",[["μνήσθητι",708960,244],["τὰ",709436,41],["ἔσχατα",705519,68],["καὶ",707031,7],["παῦσαι",710202,300],["ἐχθραίνων",705776,72],["καταφθορὰν",707475,9],["καὶ",707031,7],["θάνατον",706096,6],["καὶ",707031,7],["ἔμμενε",704570,240],["ἐντολαῖς",704802,76]],"Remember thy end, and let thy enmity cease; [remember] corruption and death, and abide in the commandments."],["7",[["μνήσθητι",708960,244],["ἐντολῶν",704802,65],["καὶ",707031,7],["μὴ",708851,28],["μηνίσῃς",708880,175],["τῷ",709436,113],["πλησίον",710547,28],["καὶ",707031,7],["διαθήκην",703456,9],["ὑψίστου",713287,116],["καὶ",707031,7],["πάριδε",710125,176],["ἄγνοιαν",700177,9]],"Remember the commandments, and bear no malice to thy neighbour: [remember] the covenant of the Highest, and wink at ignorance."],["8",[["ἀπόσχου",701225,300],["ἀπὸ",701425,0],["μάχης",708601,17],["καὶ",707031,7],["ἐλαττώσεις",704394,166],["ἁμαρτίας",700775,39],["ἄνθρωπος",701163,4],["γὰρ",702963,11],["θυμώδης",706336,14],["ἐκκαύσει",704205,127],["μάχην",708601,9]],"Abstain from strife, and thou shalt diminish thy sins: for a furious man will kindle strife."],["9",[["καὶ",707031,7],["ἀνὴρ",701150,4],["ἁμαρτωλὸς",700776,14],["ταράξει",712721,127],["φίλους",713492,60],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,27],["εἰρηνευόντων",704097,170],["ἐμβαλεῖ",704547,127],["διαβολήν",703427,9]],"A sinful man disquieteth friends, and maketh debate among them that be at peace."],["10",[["κατὰ",707200,0],["τὴν",709436,8],["ὕλην",713077,9],["τοῦ",709436,20],["πυρὸς",711088,21],["οὕτως",709859,28],["ἐκκαυθήσεται",704205,134],["καὶ",707031,7],["κατὰ",707200,0],["τὴν",709436,8],["στερέωσιν",712078,9],["τῆς",709436,16],["μάχης",708601,17],["ἐκκαυθήσεται",704205,134],["κατὰ",707200,0],["τὴν",709436,8],["ἰσχὺν",706858,9],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["ὁ",709436,3],["θυμὸς",706334,4],["αὐτοῦ",702165,102],["ἔσται",704093,93],["καὶ",707031,7],["κατὰ",707200,0],["τὸν",709436,5],["πλοῦτον",710563,6],["ἀνυψώσει",701293,127],["ὀργὴν",709728,9],["αὐτοῦ",702165,102]],"As the matter of the fire is, so it burneth: and as a man's strength is, so is his wrath; and according to his riches his anger riseth; and the stronger they are which contend, the more they will be inflamed."],["11",[["ἔρις",705427,12],["κατασπευδομένη",707433,211],["ἐκκαίει",704205,91],["πῦρ",711088,25],["καὶ",707031,7],["μάχη",708601,12],["κατασπεύδουσα",707433,188],["ἐκχέει",704368,91],["αἷμα",700442,25]],"An hasty contention kindleth a fire: and an hasty fighting sheddeth blood."],["12",[["ἐὰν",703912,7],["φυσήσῃς",713631,175],["εἰς",704105,0],["σπινθῆρα",712015,6],["ἐκκαήσεται",704205,134],["καὶ",707031,7],["ἐὰν",703912,7],["πτύσῃς",711070,175],["ἐπ᾿",705080,0],["αὐτόν",702165,85],["σβεσθήσεται",711596,134],["καὶ",707031,7],["ἀμφότερα",700892,195],["ἐκ",704132,0],["τοῦ",709436,20],["στόματός",712125,21],["σου",711945,133],["ἐκπορεύεται",704293,117]],"If thou blow the spark, it shall burn: if thou spit upon it, it shall be quenched: and both these come out of thy mouth."],["13",[["ψίθυρον",714055,27],["καὶ",707031,7],["δίγλωσσον",703644,27],["καταράσασθε",707396,186],["πολλοὺς",710646,60],["γὰρ",702963,11],["εἰρηνεύοντας",704097,235],["ἀπώλεσεν",701513,2]],"Curse the whisperer and double-tongued: for such have destroyed many that were at peace."],["14",[["γλῶσσα",703120,12],["τρίτη",712968,29],["πολλοὺς",710646,60],["ἐσάλευσεν",711403,2],["καὶ",707031,7],["διέστησεν",703690,2],["αὐτοὺς",702165,62],["ἀπὸ",701425,0],["ἔθνους",704068,21],["εἰς",704105,0],["ἔθνος",704068,25],["καὶ",707031,7],["πόλεις",710612,39],["ὀχυρὰς",709889,119],["καθεῖλεν",706982,2],["καὶ",707031,7],["οἰκίας",709505,39],["μεγιστάνων",708657,81],["κατέστρεψεν",707444,2]],"A backbiting tongue hath disquieted many, and driven them from nation to nation: strong cities hath it pulled down, and overthrown the houses of great men."],["15",[["γλῶσσα",703120,12],["τρίτη",712968,29],["γυναῖκας",703209,39],["ἀνδρείας",701101,119],["ἐξέβαλεν",704145,2],["καὶ",707031,7],["ἐστέρεσεν",712076,2],["αὐτὰς",702165,231],["τῶν",709436,80],["πόνων",710661,81],["αὐτῶν",702165,284]],"A backbiting tongue hath cast out virtuous women, and deprived them of their labours."],["16",[["ὁ",709436,3],["προσέχων",710895,72],["αὐτῇ",702165,105],["οὐ",709805,28],["μὴ",708851,28],["εὕρῃ",705676,172],["ἀνάπαυσιν",701026,9],["οὐδὲ",709816,7],["κατασκηνώσει",707423,127],["μεθ᾿",708780,0],["ἡσυχίας",706035,17]],"Whoso hearkeneth unto it shall never find rest, and never dwell quietly."],["17",[["πληγὴ",710527,12],["μάστιγος",708568,17],["ποιεῖ",710582,91],["μώλωπα",709099,6],["πληγὴ",710527,12],["δὲ",703303,11],["γλώσσης",703120,17],["συγκλάσει",712216,127],["ὀστᾶ",709792,42]],"The stroke of the whip maketh marks in the flesh: but the stroke of the tongue breaketh the bones."],["18",[["πολλοὶ",710646,138],["ἔπεσαν",710481,150],["ἐν",704639,0],["στόματι",712125,54],["μαχαίρας",708593,39],["καὶ",707031,7],["οὐχ",709805,28],["ὡς",714148,7],["οἱ",709436,136],["πεπτωκότες",710481,268],["διὰ",703417,0],["γλῶσσαν",703120,9]],"Many have fallen by the edge of the sword: but not so many as have fallen by the tongue."],["19",[["μακάριος",708397,14],["ὁ",709436,3],["σκεπασθεὶς",711832,217],["ἀπ᾿",701425,0],["αὐτῆς",702165,86],["ὃς",709781,213],["οὐ",709805,28],["διῆλθεν",703673,2],["ἐν",704639,0],["τῷ",709436,113],["θυμῷ",706334,114],["αὐτῆς",702165,86],["ὃς",709781,213],["οὐχ",709805,28],["εἵλκυσεν",704508,2],["τὸν",709436,5],["ζυγὸν",705894,6],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["δεσμοῖς",703372,148],["αὐτῆς",702165,86],["οὐκ",709805,28],["ἐδέθη",703394,37]],"Well is he that is defended from it, and hath not passed through the venom thereof, who hath not drawn the yoke thereof, nor hath been bound in her bands."],["20",[["ὁ",709436,3],["γὰρ",702963,11],["ζυγὸς",705894,4],["αὐτῆς",702165,86],["ζυγὸς",705894,4],["σιδηροῦς",711771,14],["καὶ",707031,7],["οἱ",709436,136],["δεσμοὶ",703372,52],["αὐτῆς",702165,86],["δεσμοὶ",703372,52],["χάλκειοι",713689,138]],"For the yoke thereof is a yoke of iron, and the bands thereof are bands of brass."],["21",[["θάνατος",706096,4],["πονηρὸς",710660,14],["ὁ",709436,3],["θάνατος",706096,4],["αὐτῆς",702165,86],["καὶ",707031,7],["λυσιτελὴς",708280,14],["μᾶλλον",708448,28],["ὁ",709436,3],["ᾅδης",700255,4],["αὐτῆς",702165,86]],"The death thereof is an evil death, the grave were better than it."],["22",[["οὐ",709805,28],["μὴ",708851,28],["κρατήσῃ",707879,172],["εὐσεβῶν",705687,169],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["φλογὶ",713524,1],["αὐτῆς",702165,86],["οὐ",709805,28],["καήσονται",707049,144]],"It shall not have rule over them that fear God, neither shall they be burned with the flame thereof."],["23",[["οἱ",709436,136],["καταλείποντες",707305,146],["κύριον",707996,6],["ἐμπεσοῦνται",704593,135],["εἰς",704105,0],["αὐτήν",702165,104],["καὶ",707031,7],["ἐν",704639,0],["αὐτοῖς",702165,151],["ἐκκαήσεται",704205,134],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["σβεσθῇ",711596,384],["ἐπαποσταλήσεται",705036,134],["αὐτοῖς",702165,151],["ὡς",714148,7],["λέων",708171,4],["καὶ",707031,7],["ὡς",714148,7],["πάρδαλις",710122,12],["λυμανεῖται",708270,93],["αὐτούς",702165,62]],"Such as forsake the Lord shall fall into it; and it shall burn in them, and not be quenched; it shall be sent upon them as a lion, and devour them as a leopard."],["24",[["ἰδὲ",709725,176],["περίφραξον",710412,176],["τὸ",709436,24],["κτῆμά",707933,25],["σου",711945,133],["ἀκάνθαις",700517,76],["τὸ",709436,24],["ἀργύριόν",701707,25],["σου",711945,133],["καὶ",707031,7],["τὸ",709436,24],["χρυσίον",713972,25],["κατάδησον",707239,176]],"Look that thou hedge thy possession about with thorns, and bind up thy silver and gold,"],["25",[["καὶ",707031,7],["τοῖς",709436,147],["λόγοις",708236,148],["σου",711945,133],["ποίησον",710582,176],["ζυγὸν",705894,6],["καὶ",707031,7],["σταθμὸν",712040,6],["καὶ",707031,7],["τῷ",709436,53],["στόματί",712125,54],["σου",711945,133],["ποίησον",710582,176],["θύραν",706337,9],["καὶ",707031,7],["μοχλόν",709040,6]],"and weigh thy words in a balance, and make a door and bar for thy mouth."],["26",[["πρόσεχε",710895,240],["μήπως",708883,28],["ὀλίσθῃς",709579,279],["ἐν",704639,0],["αὐτῇ",702165,105],["μὴ",708851,28],["πέσῃς",710481,175],["κατέναντι",707507,28],["ἐνεδρεύοντος",704703,152]],"Beware thou slide not by it, lest thou fall before him that lieth in wait."]]