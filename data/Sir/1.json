[["1",[["πᾶσα",710177,29],["σοφία",711981,12],["παρὰ",709995,0],["κυρίου",707996,18],["καὶ",707031,7],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἐστιν",704093,91],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"[The Prologue to the Wisdom of] Jesus [the son of] Sirach Whereas many and great things have been delivered unto us by the law and the prophets, and by others that have followed their steps, for the which things Israel ought to be commended for learning and wisdom: and whereof not only the readers must needs become skilful themselves,"],["2",[["ἄμμον",700845,9],["θαλασσῶν",706069,65],["καὶ",707031,7],["σταγόνας",712036,39],["ὑετοῦ",713074,18],["καὶ",707031,7],["ἡμέρας",705984,39],["αἰῶνος",700504,18],["τίς",712867,158],["ἐξαριθμήσει",704877,127]],"Who can number the sand of the sea, and the drops of rain, and the days of eternity?"],["3",[["ὕψος",713288,25],["οὐρανοῦ",709844,18],["καὶ",707031,7],["πλάτος",710507,25],["γῆς",703083,17],["καὶ",707031,7],["ἄβυσσον",700098,6],["καὶ",707031,7],["σοφίαν",711981,9],["τίς",712867,158],["ἐξιχνιάσει",704941,127]],"Who can find out the height of heaven, and the breadth of the earth, and the deep, and wisdom?"],["4",[["προτέρα",710992,29],["πάντων",710177,83],["ἔκτισται",707938,187],["σοφία",711981,12],["καὶ",707031,7],["σύνεσις",712460,12],["φρονήσεως",713588,17],["ἐξ",704132,0],["αἰῶνος",700504,18]],"Wisdom hath been created before all things, and the understanding of prudence from everlasting."],["6",[["ῥίζα",711260,12],["σοφίας",711981,17],["τίνι",712867,435],["ἀπεκαλύφθη",701474,37],["καὶ",707031,7],["τὰ",709436,41],["πανουργεύματα",709969,42],["αὐτῆς",702165,86],["τίς",712867,158],["ἔγνω",703105,2]],"To whom hath the root of wisdom been revealed? or who hath known her wise counsels?"],["8",[["εἷς",704106,596],["ἐστιν",704093,91],["σοφός",711985,14],["φοβερὸς",713530,14],["σφόδρα",712586,28],["καθήμενος",707000,122],["ἐπὶ",705080,0],["τοῦ",709436,35],["θρόνου",706315,18],["αὐτοῦ",702165,102]],"There is one wise and greatly to be feared, the Lord sitting upon his throne."],["9",[["κύριος",707996,4],["αὐτὸς",702165,121],["ἔκτισεν",707938,2],["αὐτὴν",702165,104],["καὶ",707031,7],["εἶδεν",709725,2],["καὶ",707031,7],["ἐξηρίθμησεν",704877,2],["αὐτὴν",702165,104],["καὶ",707031,7],["ἐξέχεεν",704368,13],["αὐτὴν",702165,104],["ἐπὶ",705080,0],["πάντα",710177,68],["τὰ",709436,41],["ἔργα",705396,42],["αὐτοῦ",702165,102]],"He created her, and saw her, and numbered her, and poured her out upon all his works."],["10",[["μετὰ",708780,0],["πάσης",710177,82],["σαρκὸς",711537,17],["κατὰ",707200,0],["τὴν",709436,8],["δόσιν",703809,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐχορήγησεν",713911,2],["αὐτὴν",702165,104],["τοῖς",709436,147],["ἀγαπῶσιν",700120,349],["αὐτόν",702165,85]],"She [is] with all flesh according to his gift, and he hath given her to them that love him."],["11",[["φόβος",713534,4],["κυρίου",707996,18],["δόξα",703791,12],["καὶ",707031,7],["καύχημα",707570,15],["καὶ",707031,7],["εὐφροσύνη",705717,12],["καὶ",707031,7],["στέφανος",712083,4],["ἀγαλλιάματος",700112,21]],"The fear of the Lord is honour, and glory, and gladness, and a crown of rejoicing."],["12",[["φόβος",713534,4],["κυρίου",707996,18],["τέρψει",712804,127],["καρδίαν",707141,9],["καὶ",707031,7],["δώσει",703654,127],["εὐφροσύνην",705717,9],["καὶ",707031,7],["χαρὰν",713719,9],["καὶ",707031,7],["μακροημέρευσιν",708414,9]],"The fear of the Lord maketh a merry heart, and giveth joy, and gladness, and long life."],["13",[["τῷ",709436,113],["φοβουμένῳ",713532,241],["τὸν",709436,5],["κύριον",707996,6],["εὖ",705544,28],["ἔσται",704093,93],["ἐπ᾿",705080,0],["ἐσχάτων",705519,83],["καὶ",707031,7],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["τελευτῆς",712782,17],["αὐτοῦ",702165,102],["εὐλογηθήσεται",705631,134]],"Whoso feareth the Lord, it shall go well with him at the last, and he shall find favour in the day of his death."],["14",[["ἀρχὴ",701836,12],["σοφίας",711981,17],["φοβεῖσθαι",713532,110],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["μετὰ",708780,0],["πιστῶν",710486,169],["ἐν",704639,0],["μήτρᾳ",708894,1],["συνεκτίσθη",712239,37],["αὐτοῖς",702165,151]],"To fear the Lord is the beginning of wisdom: and it was created with the faithful in the womb."],["15",[["μετὰ",708780,0],["ἀνθρώπων",701163,81],["θεμέλιον",706181,6],["αἰῶνος",700504,18],["ἐνόσσευσεν",709359,2],["καὶ",707031,7],["μετὰ",708780,0],["τοῦ",709436,20],["σπέρματος",712008,21],["αὐτῶν",702165,40],["ἐμπιστευθήσεται",704594,134]],"She hath built an everlasting foundation with men, and she shall continue with their seed."],["16",[["πλησμονὴ",710549,12],["σοφίας",711981,17],["φοβεῖσθαι",713532,110],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["μεθύσκει",708676,91],["αὐτοὺς",702165,62],["ἀπὸ",701425,0],["τῶν",709436,80],["καρπῶν",707169,81],["αὐτῆς",702165,86]],"To fear the Lord is fulness of wisdom, and filleth men with her fruits."],["17",[["πάντα",710177,27],["τὸν",709436,5],["οἶκον",709516,6],["αὐτῶν",702165,40],["ἐμπλήσει",704592,127],["ἐπιθυμημάτων",705142,44],["καὶ",707031,7],["τὰ",709436,41],["ἀποδοχεῖα",701454,42],["ἀπὸ",701425,0],["τῶν",709436,43],["γενημάτων",703052,44],["αὐτῆς",702165,86]],"She filleth all their house with things desirable, and the garners with her increase."],["18",[["στέφανος",712083,4],["σοφίας",711981,17],["φόβος",713534,4],["κυρίου",707996,18],["ἀναθάλλων",700949,72],["εἰρήνην",704098,9],["καὶ",707031,7],["ὑγίειαν",713058,9],["ἰάσεως",706444,17]],"The fear of the Lord is a crown of wisdom, making peace and perfect health to flourish."],["19",[["καὶ",707031,7],["εἶδεν",709725,2],["καὶ",707031,7],["ἐξηρίθμησεν",704877,2],["αὐτήν",702165,104],["ἐπιστήμην",705267,9],["καὶ",707031,7],["γνῶσιν",703138,9],["συνέσεως",712460,17],["ἐξώμβρησεν",704957,2],["καὶ",707031,7],["δόξαν",703791,9],["κρατούντων",707879,170],["αὐτῆς",702165,86],["ἀνύψωσεν",701293,2]],"Wisdom raineth down skill and knowledge of understanding, and exalteth them to honour that hold her fast."],["20",[["ῥίζα",711260,12],["σοφίας",711981,17],["φοβεῖσθαι",713532,110],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["οἱ",709436,136],["κλάδοι",707702,52],["αὐτῆς",702165,86],["μακροημέρευσις",708414,12]],"The root of wisdom is to fear the Lord, and the branches thereof are long life."],["22",[["οὐ",709805,28],["δυνήσεται",703838,93],["θυμὸς",706334,4],["ἄδικος",700272,14],["δικαιωθῆναι",703696,179],["ἡ",709436,10],["γὰρ",702963,11],["ῥοπὴ",711294,12],["τοῦ",709436,35],["θυμοῦ",706334,18],["αὐτοῦ",702165,102],["πτῶσις",711072,12],["αὐτῷ",702165,50]],"A furious man cannot be justified; for the sway of his fury shall be his destruction."],["23",[["ἕως",705792,0],["καιροῦ",707047,18],["ἀνθέξεται",701225,93],["μακρόθυμος",708420,14],["καὶ",707031,7],["ὕστερον",713274,15],["αὐτῷ",702165,50],["ἀναδώσει",700939,127],["εὐφροσύνη",705717,12]],"A patient man will bear for a time, and afterward joy shall spring up unto him."],["24",[["ἕως",705792,0],["καιροῦ",707047,18],["κρύψει",707923,127],["τοὺς",709436,58],["λόγους",708236,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["χείλη",713781,64],["πολλῶν",710646,169],["ἐκδιηγήσεται",704172,93],["σύνεσιν",712460,9],["αὐτοῦ",702165,102]],"He will hide his words for a time, and the lips of many shall declare his wisdom."],["25",[["ἐν",704639,0],["θησαυροῖς",706258,148],["σοφίας",711981,17],["παραβολαὶ",710003,191],["ἐπιστήμης",705267,17],["βδέλυγμα",702604,15],["δὲ",703303,11],["ἁμαρτωλῷ",700776,30],["θεοσέβεια",706193,12]],"The parables of knowledge are in the treasures of wisdom: but godliness is an abomination to a sinner."],["26",[["ἐπιθυμήσας",705141,182],["σοφίαν",711981,9],["διατήρησον",703607,176],["ἐντολάς",704802,39],["καὶ",707031,7],["κύριος",707996,4],["χορηγήσει",713911,127],["σοι",711925,159],["αὐτήν",702165,104]],"If thou desire wisdom, keep the commandments, and the Lord shall give her unto thee."],["27",[["σοφία",711981,12],["γὰρ",702963,11],["καὶ",707031,7],["παιδεία",709924,12],["φόβος",713534,4],["κυρίου",707996,18],["καὶ",707031,7],["ἡ",709436,10],["εὐδοκία",705566,12],["αὐτοῦ",702165,102],["πίστις",710484,12],["καὶ",707031,7],["πραότης",710716,12]],"For the fear of the Lord is wisdom and instruction: and faith and meekness are his delight."],["28",[["μὴ",708851,28],["ἀπειθήσῃς",701370,175],["φόβῳ",713534,114],["κυρίου",707996,18],["καὶ",707031,7],["μὴ",708851,28],["προσέλθῃς",710890,175],["αὐτῷ",702165,50],["ἐν",704639,0],["καρδίᾳ",707141,1],["δισσῇ",703744,101]],"Distrust not the fear of the Lord when thou art poor; and come not unto him with a double heart."],["29",[["μὴ",708851,28],["ὑποκριθῇς",713207,279],["ἐν",704639,0],["στόμασιν",712125,96],["ἀνθρώπων",701163,81],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["χείλεσίν",713781,96],["σου",711945,133],["πρόσεχε",710895,240]],"Be not a hypocrite in the sight of men, and take good heed what thou speakest."],["30",[["μὴ",708851,28],["ἐξύψου",704982,253],["σεαυτόν",711599,85],["ἵνα",706747,7],["μὴ",708851,28],["πέσῃς",710481,175],["καὶ",707031,7],["ἐπαγάγῃς",704994,175],["τῇ",709436,100],["ψυχῇ",714070,1],["σου",711945,133],["ἀτιμίαν",702094,9],["καὶ",707031,7],["ἀποκαλύψει",701474,127],["κύριος",707996,4],["τὰ",709436,41],["κρυπτά",707922,68],["σου",711945,133],["καὶ",707031,7],["ἐν",704639,0],["μέσῳ",708768,30],["συναγωγῆς",712376,17],["καταβαλεῖ",707203,127],["σε",711598,163],["ὅτι",709803,7],["οὐ",709805,28],["προσῆλθες",710890,162],["φόβῳ",713534,114],["κυρίου",707996,18],["καὶ",707031,7],["ἡ",709436,10],["καρδία",707141,12],["σου",711945,133],["πλήρης",710541,29],["δόλου",703787,18]],"Exalt not thyself, lest thou fall, and bring dishonour upon thy soul, and so the Lord discover thy secrets, and cast thee down in the midst of the congregation, because thou camest not in truth to the fear of the Lord, but thy heart is full of deceit."]]