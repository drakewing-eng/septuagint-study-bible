[["1",[["ὁ",709436,3],["ἁπτόμενος",701654,122],["πίσσης",710482,17],["μολυνθήσεται",708987,134],["καὶ",707031,7],["ὁ",709436,3],["κοινωνῶν",707775,72],["ὑπερηφάνῳ",713139,30],["ὁμοιωθήσεται",709628,134],["αὐτῷ",702165,50]],"He that toucheth pitch shall be defiled therewith; and he that hath fellowship with a proud man shall be like unto him."],["2",[["βάρος",702542,25],["ὑπὲρ",713111,0],["σὲ",711598,163],["μὴ",708851,28],["ἄρῃς",700473,175],["καὶ",707031,7],["ἰσχυροτέρῳ",706855,302],["σου",711945,133],["καὶ",707031,7],["πλουσιωτέρῳ",710560,302],["μὴ",708851,28],["κοινώνει",707775,240],["τί",712867,126],["κοινωνήσει",707775,127],["χύτρα",713989,12],["πρὸς",710844,0],["λέβητα",708121,6],["αὕτη",709858,107],["προσκρούσει",710924,127],["καὶ",707031,7],["αὕτη",709858,107],["συντριβήσεται",712520,134]],"Burden not thyself above thy power while thou livest; and have no fellowship with one that is mightier and richer than thyself: for how agree the kettle and the earthen pot together? for if the one be smitten against the other, it shall be broken."],["3",[["πλούσιος",710560,14],["ἠδίκησεν",700269,2],["καὶ",707031,7],["αὐτὸς",702165,121],["προσενεβριμήσατο",710883,23],["πτωχὸς",711076,4],["ἠδίκηται",700269,187],["καὶ",707031,7],["αὐτὸς",702165,121],["προσδεηθήσεται",710873,134]],"The rich man hath done wrong, and yet he threateneth withal: the poor is wronged, and he must intreat also."],["4",[["ἐὰν",703912,7],["χρησιμεύσῃς",713952,175],["ἐργᾶται",705383,117],["ἐν",704639,0],["σοί",711925,159],["καὶ",707031,7],["ἐὰν",703912,7],["ὑστερήσῃς",713270,175],["καταλείψει",707305,127],["σε",711598,163]],"If thou be for his profit, he will use thee; but if thou have nothing, he will forsake thee."],["5",[["ἐὰν",703912,7],["ἔχῃς",705785,205],["συμβιώσεταί",712281,93],["σοι",711925,159],["καὶ",707031,7],["ἀποκενώσει",701477,127],["σε",711598,163],["καὶ",707031,7],["αὐτὸς",702165,121],["οὐ",709805,28],["πονέσει",710656,127]],"If thou have any thing, he will live with thee: yea, he will make thee bare, and will not be sorry for it."],["6",[["χρείαν",713938,9],["ἔσχηκέν",705785,171],["σου",711945,133],["καὶ",707031,7],["ἀποπλανήσει",701547,127],["σε",711598,163],["καὶ",707031,7],["προσγελάσεταί",710869,93],["σοι",711925,159],["καὶ",707031,7],["δώσει",703654,127],["σοι",711925,159],["ἐλπίδα",704530,9],["λαλήσει",708071,127],["σοι",711925,159],["καλὰ",707097,68],["καὶ",707031,7],["ἐρεῖ",705415,127],["τίς",712867,359],["ἡ",709436,10],["χρεία",713938,12],["σου",711945,133]],"If he have need of thee, he will deceive thee, and smile upon thee, and put thee in hope; he will speak thee fair, and say, What wantest thou?"],["7",[["καὶ",707031,7],["αἰσχυνεῖ",700485,127],["σε",711598,163],["ἐν",704639,0],["τοῖς",709436,95],["βρώμασιν",702823,96],["αὐτοῦ",702165,102],["ἕως",705792,7],["οὗ",709781,48],["ἀποκενώσῃ",701477,172],["σε",711598,163],["δὶς",703741,28],["ἢ",705924,7],["τρίς",712953,28],["καὶ",707031,7],["ἐπ᾿",705080,0],["ἐσχάτων",705519,83],["καταμωκήσεταί",707335,93],["σου",711945,133],["μετὰ",708780,0],["ταῦτα",709858,71],["ὄψεταί",709725,93],["σε",711598,163],["καὶ",707031,7],["καταλείψει",707305,127],["σε",711598,163],["καὶ",707031,7],["τὴν",709436,8],["κεφαλὴν",707639,9],["αὐτοῦ",702165,102],["κινήσει",707679,127],["ἐπὶ",705080,0],["σοί",711925,159]],"And he will shame thee by his meats, until he have drawn thee dry twice or thrice, and at the last he will laugh thee to scorn: afterward, when he seeth thee, he will forsake thee, and shake his head at thee."],["8",[["πρόσεχε",710895,240],["μὴ",708851,28],["ἀποπλανηθῇς",701547,279],["καὶ",707031,7],["μὴ",708851,28],["ταπεινωθῇς",712717,279],["ἐν",704639,0],["ἀφροσύνῃ",702235,1],["σου",711945,133]],"Beware that thou be not deceived, and brought down in thy jollity."],["9",[["προσκαλεσαμένου",710912,292],["σε",711598,163],["δυνάστου",703844,18],["ὑποχωρῶν",713262,72],["γίνου",703104,253],["καὶ",707031,7],["τόσῳ",712906,30],["μᾶλλόν",708448,28],["σε",711598,163],["προσκαλέσεται",710912,93]],"If thou be invited of a mighty man, withdraw thyself, and so much the more will he invite thee."],["10",[["μὴ",708851,28],["ἔμπιπτε",704593,240],["μὴ",708851,28],["ἀπωσθῇς",701659,279],["καὶ",707031,7],["μὴ",708851,28],["μακρὰν",708411,28],["ἀφίστω",702214,438],["ἵνα",706747,7],["μὴ",708851,28],["ἐπιλησθῇς",705187,279]],"Press thou not upon him, lest thou be put back; stand not far off, lest thou be forgotten."],["11",[["μὴ",708851,28],["ἔπεχε",705076,240],["ἰσηγορεῖσθαι",706816,110],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["μὴ",708851,28],["πίστευε",710483,240],["τοῖς",709436,147],["πλείοσιν",710514,230],["λόγοις",708236,148],["αὐτοῦ",702165,102],["ἐκ",704132,0],["πολλῆς",710646,82],["γὰρ",702963,11],["λαλιᾶς",708074,17],["πειράσει",710225,127],["σε",711598,163],["καὶ",707031,7],["ὡς",714148,7],["προσγελῶν",710869,72],["ἐξετάσει",704911,127],["σε",711598,163]],"Affect not to be made equal unto him in talk, and believe not his many words: for with much communication will he tempt thee, and smiling upon thee will get out thy secrets:"],["12",[["ἀνελεήμων",701120,14],["ὁ",709436,3],["μὴ",708851,28],["συντηρῶν",712512,72],["λόγους",708236,57],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["φείσηται",713406,239],["περὶ",710285,0],["κακώσεως",707075,17],["καὶ",707031,7],["δεσμῶν",703372,81]],"but cruelly he will lay up thy words, and will not spare to do thee hurt, and to put thee in prison."],["13",[["συντήρησον",712512,176],["καὶ",707031,7],["πρόσεχε",710895,240],["σφοδρῶς",712588,28],["ὅτι",709803,7],["μετὰ",708780,0],["τῆς",709436,16],["πτώσεώς",711072,17],["σου",711945,133],["περιπατεῖς",710362,154]],"Observe, and take good heed, for thou walkest in peril of thy overthrowing: when thou hearest these things, awake in thy sleep."],["15",[["πᾶν",710177,26],["ζῷον",705916,15],["ἀγαπᾷ",700120,91],["τὸ",709436,24],["ὅμοιον",709626,46],["αὐτῷ",702165,280],["καὶ",707031,7],["πᾶς",710177,14],["ἄνθρωπος",701163,4],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102]],"Every beast loveth his like, and every man loveth his neighbour."],["16",[["πᾶσα",710177,29],["σὰρξ",711537,12],["κατὰ",707200,0],["γένος",703057,25],["συνάγεται",712375,117],["καὶ",707031,7],["τῷ",709436,113],["ὁμοίῳ",709626,30],["αὐτοῦ",702165,102],["προσκολληθήσεται",710921,134],["ἀνήρ",701150,4]],"All flesh consorteth according to kind, and a man will cleave to his like."],["17",[["τί",712867,273],["κοινωνήσει",707775,127],["λύκος",708269,4],["ἀμνῷ",700855,114],["οὕτως",709859,28],["ἁμαρτωλὸς",700776,14],["πρὸς",710844,0],["εὐσεβῆ",705687,68]],"What fellowship hath the wolf with the lamb? so the sinner with the godly."],["18",[["τίς",712867,359],["εἰρήνη",704098,12],["ὑαίνῃ",713045,1],["πρὸς",710844,0],["κύνα",708004,6],["καὶ",707031,7],["τίς",712867,359],["εἰρήνη",704098,12],["πλουσίῳ",710560,30],["πρὸς",710844,0],["πένητα",710248,6]],"What agreement is there between the hyena and a dog? and what peace between the rich and the poor?"],["19",[["κυνήγια",707975,64],["λεόντων",708171,81],["ὄναγροι",709653,52],["ἐν",704639,0],["ἐρήμῳ",705420,1],["οὕτως",709859,28],["νομαὶ",709337,191],["πλουσίων",710560,169],["πτωχοί",711076,52]],"As the wild ass is the lion's prey in the wilderness: so the rich eat up the poor."],["20",[["βδέλυγμα",702604,15],["ὑπερηφάνῳ",713139,30],["ταπεινότης",712715,12],["οὕτως",709859,28],["βδέλυγμα",702604,15],["πλουσίῳ",710560,30],["πτωχός",711076,4]],"As the proud hate humility: so doth the rich abhor the poor."],["21",[["πλούσιος",710560,14],["σαλευόμενος",711403,122],["στηρίζεται",712098,117],["ὑπὸ",713184,0],["φίλων",713492,169],["ταπεινὸς",712714,14],["δὲ",703303,11],["πεσὼν",710481,182],["προσαπωθεῖται",710862,117],["ὑπὸ",713184,0],["φίλων",713492,169]],"A rich man beginning to fall is held up of his friends: but a poor man being down is thrust also away by his friends."],["22",[["πλουσίου",710560,116],["σφαλέντος",712575,319],["πολλοὶ",710646,138],["ἀντιλήμπτορες",701246,52],["ἐλάλησεν",708071,2],["ἀπόρρητα",701562,68],["καὶ",707031,7],["ἐδικαίωσαν",703696,2],["αὐτόν",702165,85],["ταπεινὸς",712714,14],["ἔσφαλεν",712575,2],["καὶ",707031,7],["προσεπετίμησαν",710888,150],["αὐτῷ",702165,50],["ἐφθέγξατο",713442,23],["σύνεσιν",712460,9],["καὶ",707031,7],["οὐκ",709805,28],["ἐδόθη",703654,37],["αὐτῷ",702165,50],["τόπος",712903,4]],"When a rich man is fallen, he hath many helpers: he speaketh things not to be spoken, and yet men justify him: the poor man slipped, and yet they rebuked him too; he spake wisely, and could have no place."],["23",[["πλούσιος",710560,14],["ἐλάλησεν",708071,2],["καὶ",707031,7],["πάντες",710177,138],["ἐσίγησαν",711767,150],["καὶ",707031,7],["τὸν",709436,5],["λόγον",708236,6],["αὐτοῦ",702165,102],["ἀνύψωσαν",701293,150],["ἕως",705792,0],["τῶν",709436,130],["νεφελῶν",709277,65],["πτωχὸς",711076,4],["ἐλάλησεν",708071,2],["καὶ",707031,7],["εἶπαν",705373,150],["τίς",712867,158],["οὗτος",709858,121],["κἂν",707120,459],["προσκόψῃ",710923,172],["προσανατρέψουσιν",710855,218],["αὐτόν",702165,85]],"When a rich man speaketh, every man holdeth his tongue, and, look, what he saith, they extol it to the clouds: but if the poor man speak, they say, What fellow is this? and if he stumble, they will help to overthrow him."],["24",[["ἀγαθὸς",700106,14],["ὁ",709436,3],["πλοῦτος",710563,4],["ᾧ",709781,309],["μή",708851,28],["ἐστιν",704093,91],["ἁμαρτία",700775,12],["καὶ",707031,7],["πονηρὰ",710660,29],["ἡ",709436,10],["πτωχεία",711073,12],["ἐν",704639,0],["στόματι",712125,54],["ἀσεβοῦς",701909,116]],"Riches are good unto him that hath no sin, and poverty is evil in the mouth of the ungodly."],["25",[["καρδία",707141,12],["ἀνθρώπου",701163,18],["ἀλλοιοῖ",700694,91],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["ἐάν",703912,7],["τε",712751,11],["εἰς",704105,0],["ἀγαθὰ",700106,68],["ἐάν",703912,7],["τε",712751,11],["εἰς",704105,0],["κακά",707066,68]],"The heart of a man changeth his countenance, whether it be for good or evil."],["26",[["ἴχνος",706873,15],["καρδίας",707141,17],["ἐν",704639,0],["ἀγαθοῖς",700106,230],["πρόσωπον",710986,15],["ἱλαρόν",706723,26],["καὶ",707031,7],["εὕρεσις",705672,12],["παραβολῶν",710003,65],["διαλογισμοὶ",703506,52],["μετὰ",708780,0],["κόπων",707825,65]],"A cheerful countenance is a token of a heart that is in prosperity; and the finding out of parables is a wearisome labour of the mind."]]