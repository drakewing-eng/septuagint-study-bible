[["1",[["ἀσχολία",702057,12],["μεγάλη",708653,29],["ἔκτισται",707938,187],["παντὶ",710177,30],["ἀνθρώπῳ",701163,114],["καὶ",707031,7],["ζυγὸς",705894,4],["βαρὺς",702554,14],["ἐπὶ",705080,0],["υἱοὺς",713075,57],["Αδαμ",700222,18],["ἀφ᾿",701425,0],["ἡμέρας",705984,17],["ἐξόδου",704948,17],["ἐκ",704132,0],["γαστρὸς",702976,17],["μητρὸς",708892,17],["αὐτῶν",702165,40],["ἕως",705792,0],["ἡμέρας",705984,17],["ἐπιστροφῆς",705279,17],["εἰς",704105,0],["μητέρα",708892,9],["πάντων",710177,169]],"Great travail is created for every man, and an heavy yoke is upon the sons of Adam, from the day that they go out of their mother's womb, till the day that they return to the mother of all things."],["2",[["τοὺς",709436,58],["διαλογισμοὺς",703506,57],["αὐτῶν",702165,40],["καὶ",707031,7],["φόβον",713534,6],["καρδίας",707141,17],["ἐπίνοια",705215,12],["προσδοκίας",710877,17],["ἡμέρα",705984,12],["τελευτῆς",712782,17]],"Their imagination of things to come, and the day of death, [trouble] their thoughts, and [cause] fear of heart;"],["3",[["ἀπὸ",701425,0],["καθημένου",707000,262],["ἐπὶ",705080,0],["θρόνου",706315,18],["ἐνδόξου",704694,116],["καὶ",707031,7],["ἕως",705792,0],["τεταπεινωμένου",712717,482],["ἐν",704639,0],["γῇ",703083,1],["καὶ",707031,7],["σποδῷ",712022,114]],"from him that sitteth on a throne of glory, unto him that is humbled in earth and ashes;"],["4",[["ἀπὸ",701425,0],["φοροῦντος",713554,152],["ὑακίνθινον",713047,27],["καὶ",707031,7],["στέφανον",712083,6],["καὶ",707031,7],["ἕως",705792,0],["περιβαλλομένου",710294,262],["ὠμόλινον",714113,25],["θυμὸς",706334,4],["καὶ",707031,7],["ζῆλος",705871,4],["καὶ",707031,7],["ταραχὴ",712722,12],["καὶ",707031,7],["σάλος",711420,4],["καὶ",707031,7],["φόβος",713534,4],["θανάτου",706096,18],["καὶ",707031,7],["μηνίαμα",708876,15],["καὶ",707031,7],["ἔρις",705427,12]],"from him that weareth purple and a crown, unto [him that is clothed with a linen] frock."],["5",[["καὶ",707031,7],["ἐν",704639,0],["καιρῷ",707047,114],["ἀναπαύσεως",701026,17],["ἐπὶ",705080,0],["κοίτης",707781,17],["ὕπνος",713181,4],["νυκτὸς",709386,17],["ἀλλοιοῖ",700694,91],["γνῶσιν",703138,9],["αὐτοῦ",702165,102]],"Wrath, and envy, trouble, and unquietness, fear of death, and anger, and strife, and in the time of rest upon his bed his night sleep, do change his knowledge."],["6",[["ὀλίγον",709568,46],["ὡς",714148,7],["οὐδὲν",709817,46],["ἐν",704639,0],["ἀναπαύσει",701026,1],["καὶ",707031,7],["ἀπ᾿",701425,0],["ἐκείνου",704183,102],["ἐν",704639,0],["ὕπνοις",713181,148],["ὡς",714148,7],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["σκοπιᾶς",711876,39],["τεθορυβημένος",706292,419],["ἐν",704639,0],["ὁράσει",709721,1],["καρδίας",707141,17],["αὐτοῦ",702165,102],["ὡς",714148,7],["ἐκπεφευγὼς",704357,270],["ἀπὸ",701425,0],["προσώπου",710986,21],["πολέμου",710605,18]],"Little or nothing is his rest, and afterward he is in his sleep as in a day of keeping watch, troubled in the vision of his heart, as if he were escaped out of a battle."],["7",[["ἐν",704639,0],["καιρῷ",707047,114],["χρείας",713938,17],["αὐτοῦ",702165,102],["ἐξηγέρθη",704889,37],["καὶ",707031,7],["ἀποθαυμάζων",701456,72],["εἰς",704105,0],["οὐδένα",709817,46],["φόβον",713534,6]],"When all is safe, he awaketh, and marvelleth that the fear was nothing."],["8",[["μετὰ",708780,0],["πάσης",710177,82],["σαρκὸς",711537,17],["ἀπὸ",701425,0],["ἀνθρώπου",701163,18],["ἕως",705792,0],["κτήνους",707934,21],["καὶ",707031,7],["ἐπὶ",705080,0],["ἁμαρτωλῶν",700776,169],["ἑπταπλάσια",705368,68],["πρὸς",710844,0],["ταῦτα",709858,71]],"[Such things happen] unto all flesh, both man and beast, and sevenfold more upon sinners."],["9",[["θάνατος",706096,4],["καὶ",707031,7],["αἷμα",700442,15],["καὶ",707031,7],["ἔρις",705427,12],["καὶ",707031,7],["ῥομφαία",711291,12],["ἐπαγωγαί",704995,191],["λιμὸς",708210,4],["καὶ",707031,7],["σύντριμμα",712521,15],["καὶ",707031,7],["μάστιξ",708568,12]],"Death, and bloodshed, strife, and sword, calamities, famine, tribulation, and the scourge;"],["10",[["ἐπὶ",705080,0],["τοὺς",709436,58],["ἀνόμους",701194,60],["ἐκτίσθη",707938,37],["ταῦτα",709858,290],["πάντα",710177,195],["καὶ",707031,7],["δι᾿",703417,0],["αὐτοὺς",702165,62],["ἐγένετο",703104,23],["ὁ",709436,3],["κατακλυσμός",707279,4]],"these things are created for the wicked, and through them came the flood."],["11",[["πάντα",710177,195],["ὅσα",709788,195],["ἀπὸ",701425,0],["γῆς",703083,17],["εἰς",704105,0],["γῆν",703083,9],["ἀναστρέφει",701060,91],["καὶ",707031,7],["ἀπὸ",701425,0],["ὑδάτων",713071,44],["εἰς",704105,0],["θάλασσαν",706069,9],["ἀνακάμπτει",700969,91]],"All things that are of the earth do turn to the earth again: and that which is of the waters doth return into the sea."],["12",[["πᾶν",710177,26],["δῶρον",703907,15],["καὶ",707031,7],["ἀδικία",700271,12],["ἐξαλειφθήσεται",704852,134],["καὶ",707031,7],["πίστις",710484,12],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["στήσεται",706846,93]],"All bribery and injustice shall be blotted out: but true dealing shall endure for ever."],["13",[["χρήματα",713948,64],["ἀδίκων",700272,169],["ὡς",714148,7],["ποταμὸς",710693,4],["ξηρανθήσεται",709419,134],["καὶ",707031,7],["ὡς",714148,7],["βροντὴ",702816,12],["μεγάλη",708653,29],["ἐν",704639,0],["ὑετῷ",713074,114],["ἐξηχήσει",704928,127]],"The goods of the unjust shall be dried up like a river, and shall vanish with noise, like a great thunder in rain."],["14",[["ἐν",704639,0],["τῷ",709436,53],["ἀνοῖξαι",701186,106],["αὐτὸν",702165,85],["χεῖρας",713787,39],["εὐφρανθήσεται",705715,134],["οὕτως",709859,28],["οἱ",709436,136],["παραβαίνοντες",709996,146],["εἰς",704105,0],["συντέλειαν",712509,9],["ἐκλείψουσιν",704237,218]],"While he openeth his hand he shall rejoice: so shall transgressors come to nought."],["15",[["ἔκγονα",704159,195],["ἀσεβῶν",701909,169],["οὐ",709805,28],["πληθυνεῖ",710530,127],["κλάδους",707702,57],["καὶ",707031,7],["ῥίζαι",711260,191],["ἀκάθαρτοι",700508,192],["ἐπ᾿",705080,0],["ἀκροτόμου",700611,82],["πέτρας",710443,17]],"The children of the ungodly shall not bring forth many branches: but are as unclean roots upon a hard rock."],["16",[["ἄχι",702261,15],["ἐπὶ",705080,0],["παντὸς",710177,92],["ὕδατος",713071,21],["καὶ",707031,7],["χείλους",713781,21],["ποταμοῦ",710693,18],["πρὸ",710747,0],["παντὸς",710177,116],["χόρτου",713923,18],["ἐκτιλήσεται",704332,93]],"The weed growing upon every water and bank of a river shall be pulled up before all grass."],["17",[["χάρις",713735,12],["ὡς",714148,7],["παράδεισος",710012,4],["ἐν",704639,0],["εὐλογίαις",705633,76],["καὶ",707031,7],["ἐλεημοσύνη",704421,12],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["διαμενεῖ",703517,127]],"Bountifulness is as a most fruitful garden, and mercifulness endureth for ever."],["18",[["ζωὴ",705910,12],["αὐτάρκους",702157,116],["καὶ",707031,7],["ἐργάτου",705390,18],["γλυκανθήσεται",703110,134],["καὶ",707031,7],["ὑπὲρ",713111,0],["ἀμφότερα",700892,68],["ὁ",709436,3],["εὑρίσκων",705676,72],["θησαυρόν",706258,6]],"To labour, and to be content with that a man hath, is a sweet life: but he that findeth a treasure is above them both."],["19",[["τέκνα",712761,64],["καὶ",707031,7],["οἰκοδομὴ",709510,12],["πόλεως",710612,17],["στηρίζουσιν",712098,197],["ὄνομα",709666,25],["καὶ",707031,7],["ὑπὲρ",713111,0],["ἀμφότερα",700892,68],["γυνὴ",703209,12],["ἄμωμος",700895,29],["λογίζεται",708232,117]],"Children and the building of a city continue a man's name: but a blameless wife is counted above them both."],["20",[["οἶνος",709530,4],["καὶ",707031,7],["μουσικὰ",709034,64],["εὐφραίνουσιν",705715,197],["καρδίαν",707141,9],["καὶ",707031,7],["ὑπὲρ",713111,0],["ἀμφότερα",700892,68],["ἀγάπησις",700123,12],["σοφίας",711981,17]],"Wine and music rejoice the heart: but the love of wisdom is above them both."],["21",[["αὐλὸς",702139,4],["καὶ",707031,7],["ψαλτήριον",714023,15],["ἡδύνουσιν",705943,197],["μέλη",708707,42],["καὶ",707031,7],["ὑπὲρ",713111,0],["ἀμφότερα",700892,68],["γλῶσσα",703120,12],["ἡδεῖα",705945,29]],"The pipe and the psaltery make sweet melody: but a pleasant tongue is above them both."],["22",[["χάριν",713735,9],["καὶ",707031,7],["κάλλος",707093,25],["ἐπιθυμήσει",705141,127],["ὀφθαλμὸς",709870,4],["καὶ",707031,7],["ὑπὲρ",713111,0],["ἀμφότερα",700892,68],["χλόην",713877,9],["σπόρου",712030,18]],"Thine eye desireth favour and beauty: but more than both the first sprouting of corn."],["23",[["φίλος",713492,14],["καὶ",707031,7],["ἑταῖρος",705529,4],["εἰς",704105,0],["καιρὸν",707047,6],["ἀπαντῶντες",701345,146],["καὶ",707031,7],["ὑπὲρ",713111,0],["ἀμφότερα",700892,68],["γυνὴ",703209,12],["μετὰ",708780,0],["ἀνδρός",701150,18]],"A friend and companion never meet amiss: but above both is a wife with her husband."],["24",[["ἀδελφοὶ",700249,52],["καὶ",707031,7],["βοήθεια",702745,12],["εἰς",704105,0],["καιρὸν",707047,6],["θλίψεως",706276,17],["καὶ",707031,7],["ὑπὲρ",713111,0],["ἀμφότερα",700892,68],["ἐλεημοσύνη",704421,12],["ῥύσεται",711309,93]],"Brethren and help are against time of trouble: but alms shall deliver more than them both."],["25",[["χρυσίον",713972,15],["καὶ",707031,7],["ἀργύριον",701707,15],["ἐπιστήσουσιν",705756,218],["πόδα",710707,6],["καὶ",707031,7],["ὑπὲρ",713111,0],["ἀμφότερα",700892,68],["βουλὴ",702792,12],["εὐδοκιμεῖται",705567,117]],"Gold and silver make the foot stand sure; but counsel is esteemed above them both."],["26",[["χρήματα",713948,64],["καὶ",707031,7],["ἰσχὺς",706858,12],["ἀνυψώσουσιν",701293,218],["καρδίαν",707141,9],["καὶ",707031,7],["ὑπὲρ",713111,0],["ἀμφότερα",700892,68],["φόβος",713534,4],["κυρίου",707996,18],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐν",704639,0],["φόβῳ",713534,114],["κυρίου",707996,18],["ἐλάττωσις",704396,12],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐπιζητῆσαι",705135,106],["ἐν",704639,0],["αὐτῷ",702165,50],["βοήθειαν",702745,9]],"Riches and strength lift up the heart: but the fear of the Lord is above them both: there is no want in the fear of the Lord, and it needeth not to seek help."],["27",[["φόβος",713534,4],["κυρίου",707996,18],["ὡς",714148,7],["παράδεισος",710012,4],["εὐλογίας",705633,17],["καὶ",707031,7],["ὑπὲρ",713111,0],["πᾶσαν",710177,36],["δόξαν",703791,9],["ἐκάλυψεν",707102,2],["αὐτόν",702165,85]],"The fear of the Lord is a fruitful garden, and covereth him above all glory."],["28",[["τέκνον",712761,297],["ζωὴν",705910,9],["ἐπαιτήσεως",705005,17],["μὴ",708851,28],["βιώσῃς",702727,175],["κρεῖσσον",707890,46],["ἀποθανεῖν",701461,106],["ἢ",705924,7],["ἐπαιτεῖν",705004,55]],"My son, lead not a beggar's life; for better it is to die than to beg."],["29",[["ἀνὴρ",701150,4],["βλέπων",702740,72],["εἰς",704105,0],["τράπεζαν",712919,9],["ἀλλοτρίαν",700699,36],["οὐκ",709805,28],["ἔστιν",704093,91],["αὐτοῦ",702165,102],["ὁ",709436,3],["βίος",702724,4],["ἐν",704639,0],["λογισμῷ",708234,114],["ζωῆς",705910,17],["ἀλισγήσει",700672,127],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["ἐν",704639,0],["ἐδέσμασιν",704032,96],["ἀλλοτρίοις",700699,94],["ἀνὴρ",701150,4],["δὲ",703303,11],["ἐπιστήμων",705268,14],["καὶ",707031,7],["πεπαιδευμένος",709926,419],["φυλάξεται",713619,93]],"The life of him that dependeth on another man's table is not to be counted for a life; for he polluteth himself with other men's meat: but a wise man well nurtured will beware thereof."],["30",[["ἐν",704639,0],["στόματι",712125,54],["ἀναιδοῦς",700959,116],["γλυκανθήσεται",703110,134],["ἐπαίτησις",705005,12],["καὶ",707031,7],["ἐν",704639,0],["κοιλίᾳ",707761,1],["αὐτοῦ",702165,102],["πῦρ",711088,15],["καήσεται",707049,134]],"Begging is sweet in the mouth of the shameless: but in his belly there shall burn a fire."]]