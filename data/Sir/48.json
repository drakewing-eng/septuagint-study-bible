[["1",[["καὶ",707031,7],["ἀνέστη",701173,2],["Ηλιας",705970,4],["προφήτης",711009,4],["ὡς",714148,7],["πῦρ",711088,15],["καὶ",707031,7],["ὁ",709436,3],["λόγος",708236,4],["αὐτοῦ",702165,102],["ὡς",714148,7],["λαμπὰς",708079,12],["ἐκαίετο",707049,19]],"Then stood up Elias the prophet as fire, and his word burned like a lamp."],["2",[["ὃς",709781,213],["ἐπήγαγεν",704994,2],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["λιμὸν",708210,6],["καὶ",707031,7],["τῷ",709436,113],["ζήλῳ",705871,114],["αὐτοῦ",702165,102],["ὠλιγοποίησεν",709567,2],["αὐτούς",702165,62]],"He brought a sore famine upon them, and by his zeal he diminished their number."],["3",[["ἐν",704639,0],["λόγῳ",708236,114],["κυρίου",707996,18],["ἀνέσχεν",701140,2],["οὐρανόν",709844,6],["κατήγαγεν",707232,2],["οὕτως",709859,28],["τρὶς",712953,28],["πῦρ",711088,25]],"By the word of the Lord he shut up the heaven, and also three times brought down fire."],["4",[["ὡς",714148,7],["ἐδοξάσθης",703792,168],["Ηλια",705970,153],["ἐν",704639,0],["θαυμασίοις",706136,94],["σου",711945,133],["καὶ",707031,7],["τίς",712867,158],["ὅμοιός",709626,14],["σοι",711925,159],["καυχᾶσθαι",707569,110]],"O Elias, how wast thou honoured in thy wondrous deeds! and who may glory like unto thee!"],["5",[["ὁ",709436,3],["ἐγείρας",703949,182],["νεκρὸν",709247,6],["ἐκ",704132,0],["θανάτου",706096,18],["καὶ",707031,7],["ἐξ",704132,0],["ᾅδου",700255,18],["ἐν",704639,0],["λόγῳ",708236,114],["ὑψίστου",713287,116]],"Who didst raise up a dead man from death, and his soul from the place of the dead, by the word of the most High:"],["6",[["ὁ",709436,3],["καταγαγὼν",707232,182],["βασιλεῖς",702580,57],["εἰς",704105,0],["ἀπώλειαν",701660,9],["καὶ",707031,7],["δεδοξασμένους",703792,360],["ἀπὸ",701425,0],["κλίνης",707737,17],["αὐτῶν",702165,40]],"who broughtest kings to destruction, and honourable men from their bed:"],["7",[["ἀκούων",700587,72],["ἐν",704639,0],["Σινα",711794,111],["ἐλεγμὸν",704413,6],["καὶ",707031,7],["ἐν",704639,0],["Χωρηβ",714013,111],["κρίματα