[["1",[["ἡ",709436,10],["σοφία",711981,12],["αἰνέσει",700459,127],["ψυχὴν",714070,9],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐν",704639,0],["μέσῳ",708768,30],["λαοῦ",708094,18],["αὐτῆς",702165,86],["καυχήσεται",707569,93]],"Wisdom shall praise herself, and shall glory in the midst of her people."],["2",[["ἐν",704639,0],["ἐκκλησίᾳ",704216,1],["ὑψίστου",713287,116],["στόμα",712125,25],["αὐτῆς",702165,86],["ἀνοίξει",701186,127],["καὶ",707031,7],["ἔναντι",704653,0],["δυνάμεως",703839,17],["αὐτοῦ",702165,102],["καυχήσεται",707569,93]],"In the congregation of the most High shall she open her mouth, and triumph before his power."],["3",[["ἐγὼ",704018,164],["ἀπὸ",701425,0],["στόματος",712125,21],["ὑψίστου",713287,116],["ἐξῆλθον",704909,155],["καὶ",707031,7],["ὡς",714148,7],["ὁμίχλη",709615,12],["κατεκάλυψα",707260,155],["γῆν",703083,9]],"I came out of the mouth of the most High, and covered the earth as a cloud."],["4",[["ἐγὼ",704018,164],["ἐν",704639,0],["ὑψηλοῖς",713285,94],["κατεσκήνωσα",707423,155],["καὶ",707031,7],["ὁ",709436,3],["θρόνος",706315,4],["μου",709032,133],["ἐν",704639,0],["στύλῳ",712179,114],["νεφέλης",709277,17]],"I dwelt in high places, and my throne is in a cloudy pillar."],["5",[["γῦρον",703210,6],["οὐρανοῦ",709844,18],["ἐκύκλωσα",707958,155],["μόνη",709003,29],["καὶ",707031,7],["ἐν",704639,0],["βάθει",702381,97],["ἀβύσσων",700098,81],["περιεπάτησα",710362,155]],"I alone compassed the circuit of heaven, and walked in the bottom of the deep."],["6",[["ἐν",704639,0],["κύμασιν",707968,96],["θαλάσσης",706069,17],["καὶ",707031,7],["ἐν",704639,0],["πάσῃ",710177,101],["τῇ",709436,100],["γῇ",703083,1],["καὶ",707031,7],["ἐν",704639,0],["παντὶ",710177,30],["λαῷ",708094,114],["καὶ",707031,7],["ἔθνει",704068,54],["ἐκτησάμην",707932,161]],"In the waves of the sea, and in all the earth, and in every people and nation, I got a possession."],["7",[["μετὰ",708780,0],["τούτων",709858,70],["πάντων",710177,83],["ἀνάπαυσιν",701026,9],["ἐζήτησα",705879,155],["καὶ",707031,7],["ἐν",704639,0],["κληρονομίᾳ",707725,1],["τίνος",712867,308],["αὐλισθήσομαι",702138,180]],"With all these I sought rest: and in whose inheritance shall I abide?"],["8",[["τότε",712908,28],["ἐνετείλατό",704791,23],["μοι",708974,159],["ὁ",709436,3],["κτίστης",707941,4],["ἁπάντων",701362,83],["καὶ",707031,7],["ὁ",709436,3],["κτίσας",707938,182],["με",708618,163],["κατέπαυσεν",707365,2],["τὴν",709436,8],["σκηνήν",711845,9],["μου",709032,133],["καὶ",707031,7],["εἶπεν",705373,2],["ἐν",704639,0],["Ιακωβ",706401,114],["κατασκήνωσον",707423,176],["καὶ",707031,7],["ἐν",704639,0],["Ισραηλ",706839,111],["κατακληρονομήθητι",707274,244]],"So the Creator of all things gave me a commandment, and he that made me caused my tabernacle to rest, and said, Let thy dwelling be in Jacob, and thine inheritance in Israel."],["9",[["πρὸ",710747,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["ἔκτισέν",707938,2],["με",708618,163],["καὶ",707031,7],["ἕως",705792,0],["αἰῶνος",700504,18],["οὐ",709805,28],["μὴ",708851,28],["ἐκλίπω",704237,207]],"He created me from the beginning before the world, and I shall never fail."],["10",[["ἐν",704639,0],["σκηνῇ",711845,1],["ἁγίᾳ",700159,101],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["ἐλειτούργησα",708132,155],["καὶ",707031,7],["οὕτως",709859,28],["ἐν",704639,0],["Σιων",711816,111],["ἐστηρίχθην",712098,156]],"In the holy tabernacle I served before him; and so was I established in Sion."],["11",[["ἐν",704639,0],["πόλει",710612,1],["ἠγαπημένῃ",700120,455],["ὁμοίως",709630,28],["με",708618,163],["κατέπαυσεν",707365,2],["καὶ",707031,7],["ἐν",704639,0],["Ιερουσαλημ",706644,111],["ἡ",709436,10],["ἐξουσία",704974,12],["μου",709032,133]],"Likewise in the beloved city he gave me rest, and in Jerusalem was my power."],["12",[["καὶ",707031,7],["ἐρρίζωσα",711261,155],["ἐν",704639,0],["λαῷ",708094,114],["δεδοξασμένῳ",703792,516],["ἐν",704639,0],["μερίδι",708748,1],["κυρίου",707996,18],["κληρονομίας",707725,17],["αὐτοῦ",702165,102]],"And I took root in an honourable people, even in the portion of the Lord's inheritance."],["13",[["ὡς",714148,7],["κέδρος",707590,12],["ἀνυψώθην",701293,156],["ἐν",704639,0],["τῷ",709436,113],["Λιβάνῳ",708185,114],["καὶ",707031,7],["ὡς",714148,7],["κυπάρισσος",707982,12],["ἐν",704639,0],["ὄρεσιν",709768,96],["Αερμων",700317,118]],"I was exalted like a cedar in Libanus, and as a cypress tree upon the mountains of Hermon."],["14",[["ὡς",714148,7],["φοῖνιξ",713541,4],["ἀνυψώθην",701293,156],["ἐν",704639,0],["Αιγγαδοις",700394,111],["καὶ",707031,7],["ὡς",714148,7],["φυτὰ",713637,64],["ῥόδου",711281,21],["ἐν",704639,0],["Ιεριχω",706620,111],["ὡς",714148,7],["ἐλαία",704376,12],["εὐπρεπὴς",705667,29],["ἐν",704639,0],["πεδίῳ",710215,54],["καὶ",707031,7],["ἀνυψώθην",701293,156],["ὡς",714148,7],["πλάτανος",710505,12]],"I was exalted like a palm tree on the sea shore, and as a rose plant in Jericho, as a fair olive tree in a plain, and grew up as a plane tree."],["15",[["ὡς",714148,7],["κιννάμωμον",707683,15],["καὶ",707031,7],["ἀσπάλαθος",701988,4],["ἀρωμάτων",701867,44],["δέδωκα",703654,89],["ὀσμὴν",709786,9],["καὶ",707031,7],["ὡς",714148,7],["σμύρνα",711914,12],["ἐκλεκτὴ",704240,29],["διέδωκα",703449,155],["εὐωδίαν",705734,9],["ὡς",714148,7],["χαλβάνη",713675,12],["καὶ",707031,7],["ὄνυξ",709673,4],["καὶ",707031,7],["στακτὴ",712043,12],["καὶ",707031,7],["ὡς",714148,7],["λιβάνου",708186,18],["ἀτμὶς",702100,12],["ἐν",704639,0],["σκηνῇ",711845,1]],"I gave a sweet smell like cinnamon and aspalathus, and I yielded a pleasant odour like the best myrrh, as galbanum, and onyx, and sweet storax, and as the fume of frankincense in the tabernacle."],["16",[["ἐγὼ",704018,164],["ὡς",714148,7],["τερέμινθος",712799,4],["ἐξέτεινα",704322,155],["κλάδους",707702,57],["μου",709032,133],["καὶ",707031,7],["οἱ",709436,136],["κλάδοι",707702,52],["μου",709032,133],["κλάδοι",707702,52],["δόξης",703791,17],["καὶ",707031,7],["χάριτος",713735,17]],"As the turpentine tree I stretched out my branches, and my branches are the branches of honour and grace."],["17",[["ἐγὼ",704018,164],["ὡς",714148,7],["ἄμπελος",700870,12],["ἐβλάστησα",702733,155],["χάριν",713735,9],["καὶ",707031,7],["τὰ",709436,63],["ἄνθη",701157,64],["μου",709032,133],["καρπὸς",707169,4],["δόξης",703791,17],["καὶ",707031,7],["πλούτου",710563,18]],"As the vine brought I forth pleasant savour, and my flowers are the fruit of honour and riches."],["19",[["προσέλθετε",710890,74],["πρός",710844,0],["με",708618,163],["οἱ",709436,136],["ἐπιθυμοῦντές",705141,146],["μου",709032,133],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,43],["γενημάτων",703052,44],["μου",709032,133],["ἐμπλήσθητε",704592,394]],"Come unto me, all ye that be desirous of me, and fill yourselves with my fruits."],["20",[["τὸ",709436,34],["γὰρ",702963,11],["μνημόσυνόν",708966,15],["μου",709032,133],["ὑπὲρ",713111,0],["τὸ",709436,24],["μέλι",708700,25],["γλυκύ",703114,46],["καὶ",707031,7],["ἡ",709436,10],["κληρονομία",707725,12],["μου",709032,133],["ὑπὲρ",713111,0],["μέλιτος",708700,21],["κηρίον",707657,25]],"For my memorial is sweeter than honey, and mine inheritance than the honeycomb."],["21",[["οἱ",709436,136],["ἐσθίοντές",705495,146],["με",708618,163],["ἔτι",705538,28],["πεινάσουσιν",710222,218],["καὶ",707031,7],["οἱ",709436,136],["πίνοντές",710478,146],["με",708618,163],["ἔτι",705538,28],["διψήσουσιν",703763,218]],"They that eat me shall yet be hungry, and they that drink me shall yet be thirsty."],["22",[["ὁ",709436,3],["ὑπακούων",713096,72],["μου",709032,133],["οὐκ",709805,28],["αἰσχυνθήσεται",700485,134],["καὶ",707031,7],["οἱ",709436,136],["ἐργαζόμενοι",705383,348],["ἐν",704639,0],["ἐμοὶ",704577,159],["οὐχ",709805,28],["ἁμαρτήσουσιν",700773,218]],"He that obeyeth me shall never be confounded, and they that work by me shall not do amiss."],["23",[["ταῦτα",709858,290],["πάντα",710177,195],["βίβλος",702721,12],["διαθήκης",703456,17],["θεοῦ",706192,18],["ὑψίστου",713287,116],["νόμον",709349,6],["ὃν",709781,112],["ἐνετείλατο",704791,23],["ἡμῖν",705994,90],["Μωυσῆς",709112,4],["κληρονομίαν",707725,9],["συναγωγαῖς",712376,76],["Ιακωβ",706401,18]],"All these things are the book of the covenant of the most high God, [even] the law which Moses commanded for an heritage unto the congregations of Jacob."],["25",[["ὁ",709436,3],["πιμπλῶν",710532,72],["ὡς",714148,7],["Φισων",713409,120],["σοφίαν",711981,9],["καὶ",707031,7],["ὡς",714148,7],["Τίγρις",712848,120],["ἐν",704639,0],["ἡμέραις",705984,76],["νέων",709256,169]],"He filleth all things with his wisdom, as Phison and as Tigris in the time of the new fruits."],["26",[["ὁ",709436,3],["ἀναπληρῶν",701035,72],["ὡς",714148,7],["Εὐφράτης",705716,120],["σύνεσιν",712460,9],["καὶ",707031,7],["ὡς",714148,7],["Ιορδάνης",706763,4],["ἐν",704639,0],["ἡμέραις",705984,76],["θερισμοῦ",706208,18]],"He maketh the understanding to abound like Euphrates, and as Jordan in the time of the harvest."],["27",[["ὁ",709436,3],["ἐκφαίνων",704354,72],["ὡς",714148,7],["φῶς",713642,25],["παιδείαν",709924,9],["ὡς",714148,7],["Γηων",703098,120],["ἐν",704639,0],["ἡμέραις",705984,76],["τρυγήτου",712998,18]],"He maketh the doctrine of knowledge appear as the light, and as Geon in the time of vintage."],["28",[["οὐ",709805,28],["συνετέλεσεν",712510,2],["ὁ",709436,3],["πρῶτος",711041,140],["γνῶναι",703105,106],["αὐτήν",702165,104],["καὶ",707031,7],["οὕτως",709859,28],["ὁ",709436,3],["ἔσχατος",705519,14],["οὐκ",709805,28],["ἐξιχνίασεν",704941,2],["αὐτήν",702165,104]],"The first man knew her not perfectly: no more shall the last find her out."],["29",[["ἀπὸ",701425,0],["γὰρ",702963,11],["θαλάσσης",706069,17],["ἐπληθύνθη",710530,37],["διανόημα",703529,15],["αὐτῆς",702165,86],["καὶ",707031,7],["ἡ",709436,10],["βουλὴ",702792,12],["αὐτῆς",702165,86],["ἀπὸ",701425,0],["ἀβύσσου",700098,17],["μεγάλης",708653,82]],"For her thoughts are more than the sea, and her counsels profounder than the great deep."],["30",[["κἀγὼ",706969,288],["ὡς",714148,7],["διῶρυξ",703770,12],["ἀπὸ",701425,0],["ποταμοῦ",710693,18],["καὶ",707031,7],["ὡς",714148,7],["ὑδραγωγὸς",713065,4],["ἐξῆλθον",704909,155],["εἰς",704105,0],["παράδεισον",710012,6]],"I also came out as a brook from a river, and as a conduit into a garden."],["31",[["εἶπα",705373,155],["ποτιῶ",710700,165],["μου",709032,133],["τὸν",709436,5],["κῆπον",707654,6],["καὶ",707031,7],["μεθύσω",708676,165],["μου",709032,133],["τὴν",709436,8],["πρασιάν",710717,9],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἐγένετό",703104,23],["μοι",708974,159],["ἡ",709436,10],["διῶρυξ",703770,12],["εἰς",704105,0],["ποταμόν",710693,6],["καὶ",707031,7],["ὁ",709436,3],["ποταμός",710693,4],["μου",709032,133],["ἐγένετο",703104,23],["εἰς",704105,0],["θάλασσαν",706069,9]],"I said, I will water my best garden, and will water abundantly my garden bed: and, lo, my brook became a river, and my river became a sea."],["32",[["ἔτι",705538,28],["παιδείαν",709924,9],["ὡς",714148,7],["ὄρθρον",709745,6],["φωτιῶ",713646,165],["καὶ",707031,7],["ἐκφανῶ",704354,165],["αὐτὰ",702165,71],["ἕως",705792,7],["εἰς",704105,0],["μακράν",708411,28]],"I will yet make doctrine to shine as the morning, and will send forth her light afar off."],["33",[["ἔτι",705538,28],["διδασκαλίαν",703647,9],["ὡς",714148,7],["προφητείαν",711007,9],["ἐκχεῶ",704368,165],["καὶ",707031,7],["καταλείψω",707305,165],["αὐτὴν",702165,104],["εἰς",704105,0],["γενεὰς",703037,39],["αἰώνων",700504,81]],"I will yet pour out doctrine as prophecy, and leave it to all ages for ever."],["34",[["ἴδετε",709725,74],["ὅτι",709803,7],["οὐκ",709805,28],["ἐμοὶ",704577,159],["μόνῳ",709003,30],["ἐκοπίασα",707824,155],["ἀλλ᾿",700680,7],["ἅπασιν",701362,230],["τοῖς",709436,147],["ἐκζητοῦσιν",704187,349],["αὐτήν",702165,104]],"Behold that I have not laboured for myself only, but for all them that seek wisdom."]]