[["1",[["τέκνον",712761,297],["ἥμαρτες",700773,162],["μὴ",708851,28],["προσθῇς",710906,205],["μηκέτι",708867,28],["καὶ",707031,7],["περὶ",710285,0],["τῶν",709436,130],["προτέρων",710992,198],["σου",711945,133],["δεήθητι",703394,244]],"My son, hast thou sinned? do so no more, but ask pardon for thy former sins."],["2",[["ὡς",714148,7],["ἀπὸ",701425,0],["προσώπου",710986,21],["ὄφεως",709875,18],["φεῦγε",713433,240],["ἀπὸ",701425,0],["ἁμαρτίας",700775,17],["ἐὰν",703912,7],["γὰρ",702963,11],["προσέλθῃς",710890,175],["δήξεταί",703254,93],["σε",711598,163],["ὀδόντες",709461,52],["λέοντος",708171,18],["οἱ",709436,136],["ὀδόντες",709461,52],["αὐτῆς",702165,86],["ἀναιροῦντες",700962,146],["ψυχὰς",714070,39],["ἀνθρώπων",701163,81]],"Flee from sin as from the face of a serpent: for if thou comest too near it, it will bite thee: the teeth thereof are as the teeth of a lion, slaying the souls of men."],["3",[["ὡς",714148,7],["ῥομφαία",711291,12],["δίστομος",703746,29],["πᾶσα",710177,29],["ἀνομία",701192,12],["τῇ",709436,100],["πληγῇ",710527,1],["αὐτῆς",702165,86],["οὐκ",709805,28],["ἔστιν",704093,91],["ἴασις",706444,12]],"All iniquity is as a two edged sword, the wounds whereof cannot be healed."],["4",[["καταπληγμὸς",707378,4],["καὶ",707031,7],["ὕβρις",713051,12],["ἐρημώσουσιν",705421,218,127],["πλοῦτον",710563,6],["οὕτως",709859,28],["οἶκος",709516,4],["ὑπερηφάνου",713139,116],["ἐρημωθήσεται",705421,134]],"To terrify and do wrong will waste riches: thus the house of proud men shall be made desolate."],["5",[["δέησις",703311,12],["πτωχοῦ",711076,18],["ἐκ",704132,0],["στόματος",712125,21],["ἕως",705792,0],["ὠτίων",714165,44],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὸ",709436,34],["κρίμα",707903,15],["αὐτοῦ",702165,102],["κατὰ",707200,0],["σπουδὴν",712035,9],["ἔρχεται",705453,117]],"A prayer out of a poor man's mouth reacheth to the ears of God, and his judgment cometh speedily."],["6",[["μισῶν",708935,72],["ἐλεγμὸν",704413,6],["ἐν",704639,0],["ἴχνει",706873,54],["ἁμαρτωλοῦ",700776,116],["καὶ",707031,7],["ὁ",709436,3],["φοβούμενος",713532,122],["κύριον",707996,6],["ἐπιστρέψει",705278,127],["ἐν",704639,0],["καρδίᾳ",707141,1]],"He that hateth reproof is in the way of sinners: but he that feareth the Lord will repent from his heart."],["7",[["γνωστὸς",703141,14],["μακρόθεν",708417,28],["ὁ",709436,3],["δυνατὸς",703845,14],["ἐν",704639,0],["γλώσσῃ",703120,1],["ὁ",709436,3],["δὲ",703303,11],["νοήμων",709329,14],["οἶδεν",709492,171],["ἐν",704639,0],["τῷ",709436,53],["ὀλισθάνειν",709579,55],["αὐτόν",702165,85]],"An eloquent man is known far [and near]; but a man of understanding knoweth when he slippeth."],["8",[["ὁ",709436,3],["οἰκοδομῶν",709509,72],["τὴν",709436,8],["οἰκίαν",709505,9],["αὐτοῦ",702165,102],["ἐν",704639,0],["χρήμασιν",713948,96],["ἀλλοτρίοις",700699,94],["ὡς",714148,7],["συνάγων",712375,72],["αὐτοῦ",702165,102],["τοὺς",709436,58],["λίθους",708196,57],["εἰς",704105,0],["χειμῶνα",713786,6]],"He that buildeth his house with other men's money is like one that gathereth himself stones for the tomb of his burial."],["9",[["στιππύον",712111,15],["συνηγμένον",712375,327],["συναγωγὴ",712376,12],["ἀνόμων",701194,169],["καὶ",707031,7],["ἡ",709436,10],["συντέλεια",712509,12],["αὐτῶν",702165,40],["φλὸξ",713524,12],["πυρός",711088,21]],"The congregation of the wicked is like tow wrapped together: and the end of them is a flame of fire to destroy them."],["10",[["ὁδὸς",709458,12],["ἁμαρτωλῶν",700776,169],["ὡμαλισμένη",709607,203],["ἐκ",704132,0],["λίθων",708196,81],["καὶ",707031,7],["ἐπ᾿",705080,0],["ἐσχάτων",705519,83],["αὐτῆς",702165,86],["βόθρος",702749,4],["ᾅδου",700255,18]],"The way of sinners is made plain with stones, but at the end thereof is the pit of hell."],["11",[["ὁ",709436,3],["φυλάσσων",713619,72],["νόμον",709349,6],["κατακρατεῖ",707287,91],["τοῦ",709436,20],["ἐννοήματος",704763,21],["αὐτοῦ",702165,102],["καὶ",707031,7],["συντέλεια",712509,12],["τοῦ",709436,35],["φόβου",713534,18],["κυρίου",707996,18],["σοφία",711981,12]],"He that keepeth the law of the Lord getteth the understanding thereof: and the perfection of the fear of the Lord is wisdom."],["12",[["οὐ",709805,28],["παιδευθήσεται",709926,134],["ὃς",709781,213],["οὐκ",709805,28],["ἔστιν",704093,91],["πανοῦργος",709972,14],["ἔστιν",704093,91],["δὲ",703303,11],["πανουργία",709971,12],["πληθύνουσα",710530,188],["πικρίαν",710472,9]],"He that is not wise will not be taught: but there is a wisdom which multiplieth bitterness."],["13",[["γνῶσις",703138,12],["σοφοῦ",711985,116],["ὡς",714148,7],["κατακλυσμὸς",707279,4],["πληθυνθήσεται",710530,134],["καὶ",707031,7],["ἡ",709436,10],["βουλὴ",702792,12],["αὐτοῦ",702165,102],["ὡς",714148,7],["πηγὴ",710450,12],["ζωῆς",705910,17]],"The knowledge of a wise man shall abound like a flood: and his counsel is like a pure fountain of life."],["14",[["ἔγκατα",703964,0],["μωροῦ",709110,116],["ὡς",714148,7],["ἀγγεῖον",700138,15],["συντετριμμένον",712520,327],["καὶ",707031,7],["πᾶσαν",710177,36],["γνῶσιν",703138,9],["οὐ",709805,28],["κρατήσει",707879,127]],"The inner parts of a fool are like a broken vessel, and he will hold no knowledge as long as he liveth."],["15",[["λόγον",708236,6],["σοφὸν",711985,27],["ἐὰν",703912,7],["ἀκούσῃ",700587,172],["ἐπιστήμων",705268,14],["αἰνέσει",700459,127],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["προσθήσει",710965,127],["ἤκουσεν",700587,2],["ὁ",709436,3],["σπαταλῶν",712001,72],["καὶ",707031,7],["ἀπήρεσεν",701355,2],["αὐτῷ",702165,50],["καὶ",707031,7],["ἀπέστρεψεν",701598,2],["αὐτὸν",702165,85],["ὀπίσω",709697,28],["τοῦ",709436,20],["νώτου",709403,21],["αὐτοῦ",702165,102]],"If a skilful man hear a wise word, he will commend it, and add unto it: but when one of no understanding heareth it, it displeaseth him, and he casteth it behind his back."],["16",[["ἐξήγησις",704919,12],["μωροῦ",709110,116],["ὡς",714148,7],["ἐν",704639,0],["ὁδῷ",709458,1],["φορτίον",713563,15],["ἐπὶ",705080,0],["δὲ",703303,11],["χείλους",713781,21],["συνετοῦ",712464,116],["εὑρεθήσεται",705676,134],["χάρις",713735,12]],"The talking of a fool is like a burden in the way: but grace shall be found in the lips of the wise."],["17",[["στόμα",712125,15],["φρονίμου",713589,116],["ζητηθήσεται",705879,134],["ἐν",704639,0],["ἐκκλησίᾳ",704216,1],["καὶ",707031,7],["τοὺς",709436,58],["λόγους",708236,57],["αὐτοῦ",702165,102],["διανοηθήσονται",703528,144],["ἐν",704639,0],["καρδίᾳ",707141,1]],"They enquire at the mouth of the wise man in the congregation, and they shall ponder his words in their heart."],["18",[["ὡς",714148,7],["οἶκος",709516,4],["ἠφανισμένος",702182,419],["οὕτως",709859,28],["μωρῷ",709110,30],["σοφία",711981,12],["καὶ",707031,7],["γνῶσις",703138,12],["ἀσυνέτου",702034,116],["ἀδιεξέταστοι",700267,138],["λόγοι",708236,52]],"As a house that is destroyed, so is wisdom to a fool: and the knowledge of the unwise is as talk without sense."],["19",[["πέδαι",710210,191],["ἐν",704639,0],["ποσὶν",710707,148],["ἀνοήτου",701184,116],["παιδεία",709924,12],["καὶ",707031,7],["ὡς",714148,7],["χειροπέδαι",713795,191],["ἐπὶ",705080,0],["χειρὸς",713787,17],["δεξιᾶς",703360,82]],"Doctrine unto fools is as fetters on the feet, and like manacles on the right hand."],["20",[["μωρὸς",709110,14],["ἐν",704639,0],["γέλωτι",703032,114],["ἀνυψοῖ",701293,91],["φωνὴν",713640,9],["αὐτοῦ",702165,102],["ἀνὴρ",701150,4],["δὲ",703303,11],["πανοῦργος",709972,14],["μόλις",708982,28],["ἡσυχῇ",706034,28],["μειδιάσει",708680,127]],"A fool lifteth up his voice with laughter; but a wise man doth scarce smile a little."],["21",[["ὡς",714148,7],["κόσμος",707851,4],["χρυσοῦς",713971,14],["φρονίμῳ",713589,30],["παιδεία",709924,12],["καὶ",707031,7],["ὡς",714148,7],["χλιδὼν",713876,4],["ἐπὶ",705080,0],["βραχίονι",702808,114],["δεξιῷ",703360,30]],"Learning is unto a wise man as an ornament of gold, and like a bracelet upon his right arm."],["22",[["ποὺς",710707,4],["μωροῦ",709110,116],["ταχὺς",712750,14],["εἰς",704105,0],["οἰκίαν",709505,9],["ἄνθρωπος",701163,4],["δὲ",703303,11],["πολύπειρος",710637,14],["αἰσχυνθήσεται",700485,134],["ἀπὸ",701425,0],["προσώπου",710986,21]],"A foolish man's foot is soon in [his neighbour's] house: but a man of experience is ashamed of him."],["23",[["ἄφρων",702236,14],["ἀπὸ",701425,0],["θύρας",706337,17],["παρακύπτει",710057,91],["εἰς",704105,0],["οἰκίαν",709505,9],["ἀνὴρ",701150,4],["δὲ",703303,11],["πεπαιδευμένος",709926,419],["ἔξω",704983,28],["στήσεται",706846,93]],"A fool will peep in at the door into the house: but he that is well nurtured will stand without."],["24",[["ἀπαιδευσία",701327,12],["ἀνθρώπου",701163,18],["ἀκροᾶσθαι",700602,110],["παρὰ",709995,0],["θύραν",706337,9],["ὁ",709436,3],["δὲ",703303,11],["φρόνιμος",713589,14],["βαρυνθήσεται",702553,134],["ἀτιμίᾳ",702094,1]],"It is the rudeness of a man to hearken at the door: but a wise man will be grieved with the disgrace."],["25",[["χείλη",713781,64],["ἀλλοτρίων",700699,169],["ἐν",704639,0],["τούτοις",709858,206],["διηγήσονται",703679,135],["λόγοι",708236,52],["δὲ",703303,11],["φρονίμων",713589,169],["ἐν",704639,0],["ζυγῷ",705894,114],["σταθήσονται",706846,144]],"The lips of talkers will be telling such things as pertain not unto them: but the words of such as have understanding are weighed in the balance."],["26",[["ἐν",704639,0],["στόματι",712125,54],["μωρῶν",709110,169],["ἡ",709436,10],["καρδία",707141,12],["αὐτῶν",702165,40],["καρδία",707141,12],["δὲ",703303,11],["σοφῶν",711985,169],["στόμα",712125,15],["αὐτῶν",702165,40]],"The heart of fools is in their mouth: but the mouth of the wise is in their heart."],["27",[["ἐν",704639,0],["τῷ",709436,53],["καταρᾶσθαι",707396,110],["ἀσεβῆ",701909,27],["τὸν",709436,5],["σατανᾶν",711550,6],["αὐτὸς",702165,121],["καταρᾶται",707396,117],["τὴν",709436,8],["ἑαυτοῦ",703917,102],["ψυχήν",714070,9]],"When the ungodly curseth Satan, he curseth his own soul."],["28",[["μολύνει",708987,91],["τὴν",709436,8],["ἑαυτοῦ",703917,102],["ψυχὴν",714070,9],["ὁ",709436,3],["ψιθυρίζων",714053,72],["καὶ",707031,7],["ἐν",704639,0],["παροικήσει",710157,1],["μισηθήσεται",708935,134]],"A whisperer defileth his own soul, and is hated wheresoever he dwelleth."]]