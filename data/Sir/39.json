[["1",[["πλὴν",710540,28],["τοῦ",709436,35],["ἐπιδιδόντος",705121,152],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["διανοουμένου",703528,262],["ἐν",704639,0],["νόμῳ",709349,114],["ὑψίστου",713287,116],["σοφίαν",711981,9],["πάντων",710177,169],["ἀρχαίων",701835,169],["ἐκζητήσει",704187,127],["καὶ",707031,7],["ἐν",704639,0],["προφητείαις",711007,76],["ἀσχοληθήσεται",702056,134]],"will seek out the wisdom of all the ancients, and be occupied in prophecies."],["2",[["διήγησιν",703681,9],["ἀνδρῶν",701150,81],["ὀνομαστῶν",709669,169],["συντηρήσει",712512,127],["καὶ",707031,7],["ἐν",704639,0],["στροφαῖς",712169,76],["παραβολῶν",710003,65],["συνεισελεύσεται",712437,93]],"He will keep the sayings of the renowned men: and where subtil parables are, he will be there also."],["3",[["ἀπόκρυφα",701497,764],["παροιμιῶν",710160,65],["ἐκζητήσει",704187,127],["καὶ",707031,7],["ἐν",704639,0],["αἰνίγμασι",700460,96],["παραβολῶν",710003,65],["ἀναστραφήσεται",701060,134]],"He will seek out the secrets of grave sentences, and be conversant in dark parables."],["4",[["ἀνὰ",700902,0],["μέσον",708768,27],["μεγιστάνων",708657,81],["ὑπηρετήσει",713178,127],["καὶ",707031,7],["ἔναντι",704653,0],["ἡγουμένων",705931,299],["ὀφθήσεται",709725,134],["ἐν",704639,0],["γῇ",703083,1],["ἀλλοτρίων",700699,83],["ἐθνῶν",704068,44],["διελεύσεται",703673,93],["ἀγαθὰ",700106,68],["γὰρ",702963,11],["καὶ",707031,7],["κακὰ",707066,68],["ἐν",704639,0],["ἀνθρώποις",701163,148],["ἐπείρασεν",710225,2]],"He shall serve among great men, and appear before princes: he will travel through strange countries; for he hath tried the good and the evil among men."],["5",[["τὴν",709436,8],["καρδίαν",707141,9],["αὐτοῦ",702165,102],["ἐπιδώσει",705121,127],["ὀρθρίσαι",709742,106],["πρὸς",710844,0],["κύριον",707996,6],["τὸν",709436,5],["ποιήσαντα",710582,365],["αὐτὸν",702165,85],["καὶ",707031,7],["ἔναντι",704653,0],["ὑψίστου",713287,116],["δεηθήσεται",703394,134],["καὶ",707031,7],["ἀνοίξει",701186,127],["στόμα",712125,25],["αὐτοῦ",702165,102],["ἐν",704639,0],["προσευχῇ",710892,1],["καὶ",707031,7],["περὶ",710285,0],["τῶν",709436,130],["ἁμαρτιῶν",700775,65],["αὐτοῦ",702165,102],["δεηθήσεται",703394,134]],"He will give his heart to resort early to the Lord that made him, and will pray before the most High, and will open his mouth in prayer, and make supplication for his sins."],["6",[["ἐὰν",703912,7],["κύριος",707996,4],["ὁ",709436,3],["μέγας",708653,14],["θελήσῃ",706176,172],["πνεύματι",710566,54],["συνέσεως",712460,17],["ἐμπλησθήσεται",704592,134],["αὐτὸς",702165,121],["ἀνομβρήσει",701189,127],["ῥήματα",711246,42],["σοφίας",711981,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["προσευχῇ",710892,1],["ἐξομολογήσεται",704960,93],["κυρίῳ",707996,114]],"When the great Lord will, he shall be filled with the spirit of understanding: he shall pour out wise sentences, and give thanks unto the Lord in his prayer."],["7",[["αὐτὸς",702165,121],["κατευθυνεῖ",707521,127],["βουλὴν",702792,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπιστήμην",705267,9],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["ἀποκρύφοις",701497,94],["αὐτοῦ",702165,102],["διανοηθήσεται",703528,134]],"He shall direct his counsel and knowledge, and on his secrets shall he meditate."],["8",[["αὐτὸς",702165,121],["ἐκφανεῖ",704354,127],["παιδείαν",709924,9],["διδασκαλίας",703647,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["νόμῳ",709349,114],["διαθήκης",703456,17],["κυρίου",707996,18],["καυχήσεται",707569,93]],"He shall shew forth that which he hath learned, and shall glory in the law of the covenant of the Lord."],["9",[["αἰνέσουσιν",700459,218],["τὴν",709436,8],["σύνεσιν",712460,9],["αὐτοῦ",702165,102],["πολλοί",710646,138],["καὶ",707031,7],["ἕως",705792,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["οὐκ",709805,28],["ἐξαλειφθήσεται",704852,134],["οὐκ",709805,28],["ἀποστήσεται",702214,93],["τὸ",709436,34],["μνημόσυνον",708966,15],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὸ",709436,34],["ὄνομα",709666,15],["αὐτοῦ",702165,102],["ζήσεται",705851,93],["εἰς",704105,0],["γενεὰς",703037,39],["γενεῶν",703037,65]],"Many shall commend his understanding; and so long as the world endureth, it shall not be blotted out; his memorial shall not depart away, and his name shall live from generation to generation."],["10",[["τὴν",709436,8],["σοφίαν",711981,9],["αὐτοῦ",702165,102],["διηγήσονται",703679,135],["ἔθνη",704068,42],["καὶ",707031,7],["τὸν",709436,5],["ἔπαινον",705001,6],["αὐτοῦ",702165,102],["ἐξαγγελεῖ",704829,127],["ἐκκλησία",704216,12]],"Nations shall shew forth his wisdom, and the congregation shall declare his praise."],["11",[["ἐὰν",703912,7],["ἐμμείνῃ",704570,172],["ὄνομα",709666,25],["καταλείψει",707305,127],["ἢ",705924,7],["χίλιοι",713859,138],["καὶ",707031,7],["ἐὰν",703912,7],["ἀναπαύσηται",701027,239],["ἐκποιεῖ",704289,91],["αὐτῷ",702165,50]],"If he die, he shall leave a greater name than a thousand: and if he live, he shall increase it."],["12",[["ἔτι",705538,28],["διανοηθεὶς",703528,217],["ἐκδιηγήσομαι",704172,181],["καὶ",707031,7],["ὡς",714148,7],["διχομηνία",703758,12],["ἐπληρώθην",710543,156]],"Yet have I more to say, which I have thought upon; for I am filled as the moon at the full."],["13",[["εἰσακούσατέ",704108,74],["μου",709032,133],["υἱοὶ",713075,274],["ὅσιοι",709782,538],["καὶ",707031,7],["βλαστήσατε",702733,74],["ὡς",714148,7],["ῥόδον",711281,15],["φυόμενον",713638,208],["ἐπὶ",705080,0],["ῥεύματος",711240,21],["ὑγροῦ",713063,92]],"Hearken unto me, ye holy children, and bud forth as a rose growing by the brook of the field:"],["14",[["καὶ",707031,7],["ὡς",714148,7],["λίβανος",708186,4],["εὐωδιάσατε",705735,74],["ὀσμὴν",709786,9],["καὶ",707031,7],["ἀνθήσατε",701152,74],["ἄνθος",701157,25],["ὡς",714148,7],["κρίνον",707904,15],["διάδοτε",703449,74],["ὀσμὴν",709786,9],["καὶ",707031,7],["αἰνέσατε",700459,74],["ᾆσμα",701970,25],["εὐλογήσατε",705631,74],["κύριον",707996,6],["ἐπὶ",705080,0],["πᾶσιν",710177,94],["τοῖς",709436,95],["ἔργοις",705396,96]],"and give ye a sweet savour as frankincense, and flourish as a lily, send forth a smell, and sing a song of praise, bless the Lord in all his works."],["15",[["δότε",703654,74],["τῷ",709436,53],["ὀνόματι",709666,54],["αὐτοῦ",702165,102],["μεγαλωσύνην",708652,9],["καὶ",707031,7],["ἐξομολογήσασθε",704960,186],["ἐν",704639,0],["αἰνέσει",700457,1],["αὐτοῦ",702165,102],["ἐν",704639,0],["ᾠδαῖς",714091,76],["χειλέων",713781,44],["καὶ",707031,7],["ἐν",704639,0],["κινύραις",707684,76],["καὶ",707031,7],["οὕτως",709859,28],["ἐρεῖτε",705415,337],["ἐν",704639,0],["ἐξομολογήσει",704961,1]],"Magnify his name, and shew forth his praise with the songs of your lips, and with harps, and in praising him ye shall say after this manner:"],["16",[["τὰ",709436,63],["ἔργα",705396,64],["κυρίου",707996,18],["πάντα",710177,195],["ὅτι",709803,7],["καλὰ",707097,195],["σφόδρα",712586,28],["καὶ",707031,7],["πᾶν",710177,26],["πρόσταγμα",710959,15],["ἐν",704639,0],["καιρῷ",707047,114],["αὐτοῦ",702165,102],["ἔσται",704093,93],["οὐκ",709805,28],["ἔστιν",704093,91],["εἰπεῖν",705373,106],["τί",712867,273],["τοῦτο",709858,132],["εἰς",704105,0],["τί",712867,126],["τοῦτο",709858,132],["πάντα",710177,26],["γὰρ",702963,11],["ἐν",704639,0],["καιρῷ",707047,114],["αὐτοῦ",702165,102],["ζητηθήσεται",705879,134]],"All the works of the Lord are exceeding good, and whatsoever he commandeth shall be [accomplished] in due season."],["17",[["ἐν",704639,0],["λόγῳ",708236,114],["αὐτοῦ",702165,102],["ἔστη",706846,2],["ὡς",714148,7],["θιμωνιὰ",706241,12],["ὕδωρ",713071,15],["καὶ",707031,7],["ἐν",704639,0],["ῥήματι",711246,54],["στόματος",712125,21],["αὐτοῦ",702165,102],["ἀποδοχεῖα",701454,64],["ὑδάτων",713071,44]],"For at time convenient they shall all be sought out: at his commandment the waters stood as an heap, and at the words of his mouth, the receptacles of waters."],["18",[["ἐν",704639,0],["προστάγματι",710959,54],["αὐτοῦ",702165,102],["πᾶσα",710177,29],["ἡ",709436,10],["εὐδοκία",705566,12],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ὃς",709781,213],["ἐλαττώσει",704394,127],["τὸ",709436,24],["σωτήριον",712659,25],["αὐτοῦ",702165,102]],"At his commandment is done whatsoever pleaseth him; and none can hinder, when he will save."],["19",[["ἔργα",705396,64],["πάσης",710177,82],["σαρκὸς",711537,17],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["κρυβῆναι",707923,179],["ἀπὸ",701425,0],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["αὐτοῦ",702165,102]],"The works of all flesh are before him, and nothing can be hid from his eyes."],["20",[["ἀπὸ",701425,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἐπέβλεψεν",705088,2],["καὶ",707031,7],["οὐθέν",709817,26],["ἐστιν",704093,91],["θαυμάσιον",706136,26],["ἐναντίον",704654,0],["αὐτοῦ",702165,102]],"He seeth from everlasting to everlasting; and there is nothing wonderful before him."],["21",[["οὐκ",709805,28],["ἔστιν",704093,91],["εἰπεῖν",705373,106],["τί",712867,273],["τοῦτο",709858,132],["εἰς",704105,0],["τί",712867,126],["τοῦτο",709858,132],["πάντα",710177,195],["γὰρ",702963,11],["εἰς",704105,0],["χρείας",713938,17],["αὐτῶν",702165,70],["ἔκτισται",707938,187]],"A man need not to say, What is this? wherefore is that? for he hath made all things for their uses."],["22",[["ἡ",709436,10],["εὐλογία",705633,12],["αὐτοῦ",702165,102],["ὡς",714148,7],["ποταμὸς",710693,4],["ἐπεκάλυψεν",705155,2],["καὶ",707031,7],["ὡς",714148,7],["κατακλυσμὸς",707279,4],["ξηρὰν",709421,36],["ἐμέθυσεν",708676,2]],"His blessing covered the dry land as a river, and watered it as a flood."],["23",[["οὕτως",709859,28],["ὀργὴν",709728,9],["αὐτοῦ",702165,102],["ἔθνη",704068,64],["κληρονομήσει",707724,127],["ὡς",714148,7],["μετέστρεψεν",708817,2],["ὕδατα",713071,25],["εἰς",704105,0],["ἅλμην",700713,9]],"As he hath turned the waters into saltness: so shall the heathen inherit his wrath."],["24",[["αἱ",709436,190],["ὁδοὶ",709458,191],["αὐτοῦ",702165,102],["τοῖς",709436,147],["ὁσίοις",709782,230],["εὐθεῖαι",705602,192],["οὕτως",709859,28],["τοῖς",709436,147],["ἀνόμοις",701194,230],["προσκόμματα",710922,64]],"As his ways are plain unto the holy; so are they stumbling-blocks unto the wicked."],["25",[["ἀγαθὰ",700106,195],["τοῖς",709436,147],["ἀγαθοῖς",700106,230],["ἔκτισται",707938,187],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["οὕτως",709859,28],["τοῖς",709436,147],["ἁμαρτωλοῖς",700776,230],["κακά",707066,195]],"For the good are good things created from the beginning: so evil things for sinners."],["26",[["ἀρχὴ",701836,12],["πάσης",710177,82],["χρείας",713938,17],["εἰς",704105,0],["ζωὴν",705910,9],["ἀνθρώπου",701163,18],["ὕδωρ",713071,15],["καὶ",707031,7],["πῦρ",711088,15],["καὶ",707031,7],["σίδηρος",711774,4],["καὶ",707031,7],["ἅλας",700634,52],["καὶ",707031,7],["σεμίδαλις",711675,12],["πυροῦ",711101,18],["καὶ",707031,7],["γάλα",702919,15],["καὶ",707031,7],["μέλι",708700,15],["αἷμα",700442,15],["σταφυλῆς",712052,17],["καὶ",707031,7],["ἔλαιον",704380,15],["καὶ",707031,7],["ἱμάτιον",706742,15]],"The principal things for the whole use of man's life are water, fire, iron, and salt, flour of wheat, honey, milk, and the blood of the grape, and oil, and clothing."],["27",[["ταῦτα",709858,290],["πάντα",710177,195],["τοῖς",709436,147],["εὐσεβέσιν",705687,230],["εἰς",704105,0],["ἀγαθά",700106,68],["οὕτως",709859,28],["τοῖς",709436,147],["ἁμαρτωλοῖς",700776,230],["τραπήσεται",712929,134],["εἰς",704105,0],["κακά",707066,68]],"All these things are for good to the godly: so to the sinners they are turned into evil."],["28",[["ἔστιν",704093,91],["πνεύματα",710566,64],["ἃ",709781,371],["εἰς",704105,0],["ἐκδίκησιν",704175,9],["ἔκτισται",707938,187],["καὶ",707031,7],["ἐν",704639,0],["θυμῷ",706334,114],["αὐτοῦ",702165,102],["ἐστερέωσεν",712076,2],["μάστιγας",708568,39],["αὐτῶν",702165,40],["ἐν",704639,0],["καιρῷ",707047,114],["συντελείας",712509,17],["ἰσχὺν",706858,9],["ἐκχεοῦσιν",704368,218],["καὶ",707031,7],["τὸν",709436,5],["θυμὸν",706334,6],["τοῦ",709436,35],["ποιήσαντος",710582,500],["αὐτοὺς",702165,62],["κοπάσουσιν",707819,218]],"There be spirits that are created for vengeance, which in their fury lay on sore strokes; in the time of destruction they pour out their force, and appease the wrath of him that made them."],["29",[["πῦρ",711088,15],["καὶ",707031,7],["χάλαζα",713667,12],["καὶ",707031,7],["λιμὸς",708210,4],["καὶ",707031,7],["θάνατος",706096,4],["πάντα",710177,195],["ταῦτα",709858,290],["εἰς",704105,0],["ἐκδίκησιν",704175,9],["ἔκτισται",707938,187]],"Fire, and hail, and famine, and death, all these were created for vengeance;"],["30",[["θηρίων",706252,44],["ὀδόντες",709461,52],["καὶ",707031,7],["σκορπίοι",711882,52],["καὶ",707031,7],["ἔχεις",705781,52],["καὶ",707031,7],["ῥομφαία",711291,12],["ἐκδικοῦσα",704174,188],["εἰς",704105,0],["ὄλεθρον",709563,6],["ἀσεβεῖς",701909,60]],"teeth of wild beasts, and scorpions, serpents, and the sword, punishing the wicked to destruction,"],["31",[["ἐν",704639,0],["τῇ",709436,100],["ἐντολῇ",704802,1],["αὐτοῦ",702165,102],["εὐφρανθήσονται",705715,144],["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["εἰς",704105,0],["χρείας",713938,39],["ἑτοιμασθήσονται",705539,144],["καὶ",707031,7],["ἐν",704639,0],["καιροῖς",707047,148],["αὐτῶν",702165,40],["οὐ",709805,28],["παραβήσονται",709996,135],["λόγον",708236,6]],"shall rejoice in his commandment, and they shall be ready upon earth, when need is; and when their time is come, they shall not go beyond his word."],["32",[["διὰ",703417,0],["τοῦτο",709858,129],["ἐξ",704132,0],["ἀρχῆς",701836,17],["ἐστηρίχθην",712098,156],["καὶ",707031,7],["διενοήθην",703528,156],["καὶ",707031,7],["ἐν",704639,0],["γραφῇ",703191,1],["ἀφῆκα",702211,155]],"Therefore from the beginning I was resolved, and thought upon these things, and have left them in writing."],["33",[["τὰ",709436,63],["ἔργα",705396,64],["κυρίου",707996,18],["πάντα",710177,195],["ἀγαθὰ",700106,195],["καὶ",707031,7],["πᾶσαν",710177,36],["χρείαν",713938,9],["ἐν",704639,0],["ὥρᾳ",714128,1],["αὐτῆς",702165,86],["χορηγήσει",713911,127]],"All the works of the Lord are good: and he will give every needful thing in due season."],["34",[["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["εἰπεῖν",705373,106],["τοῦτο",709858,132],["τούτου",709858,49],["πονηρότερον",710660,385],["πάντα",710177,195],["γὰρ",702963,11],["ἐν",704639,0],["καιρῷ",707047,114],["εὐδοκιμηθήσεται",705567,134]],"So that a man cannot say, This is worse than that: for in time they shall all be well approved."],["35",[["καὶ",707031,7],["νῦν",709384,28],["ἐν",704639,0],["πάσῃ",710177,101],["καρδίᾳ",707141,1],["καὶ",707031,7],["στόματι",712125,54],["ὑμνήσατε",713085,74],["καὶ",707031,7],["εὐλογήσατε",705631,74],["τὸ",709436,24],["ὄνομα",709666,25],["κυρίου",707996,18]],"And therefore praise ye the Lord with the whole heart and mouth, and bless the name of the Lord."]]