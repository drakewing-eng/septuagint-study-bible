[["1",[["ὁ",709436,3],["ἀγαπῶν",700120,72],["τὸν",709436,5],["υἱὸν",713075,6],["αὐτοῦ",702165,102],["ἐνδελεχήσει",704677,127],["μάστιγας",708568,39],["αὐτῷ",702165,50],["ἵνα",706747,7],["εὐφρανθῇ",705715,384],["ἐπ᾿",705080,0],["ἐσχάτων",705519,83],["αὐτοῦ",702165,102]],"He that loveth his son causeth him oft to feel the rod, that he may have joy of him in the end."],["2",[["ὁ",709436,3],["παιδεύων",709926,72],["τὸν",709436,5],["υἱὸν",713075,6],["αὐτοῦ",702165,102],["ὀνήσεται",709662,93],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,27],["γνωρίμων",703136,169],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["καυχήσεται",707569,93]],"He that chastiseth his son shall have joy in him, and shall rejoice of him among his acquaintance."],["3",[["ὁ",709436,3],["διδάσκων",703649,72],["τὸν",709436,5],["υἱὸν",713075,6],["αὐτοῦ",702165,102],["παραζηλώσει",710021,127],["τὸν",709436,5],["ἐχθρὸν",705779,27],["καὶ",707031,7],["ἔναντι",704653,0],["φίλων",713492,169],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["ἀγαλλιάσεται",700114,93]],"He that teacheth his son grieveth the enemy: and before his friends he shall rejoice of him."],["4",[["ἐτελεύτησεν",712781,2],["αὐτοῦ",702165,102],["ὁ",709436,3],["πατήρ",710189,4],["καὶ",707031,7],["ὧς",714148,7],["οὐκ",709805,28],["ἀπέθανεν",701461,2],["ὅμοιον",709626,27],["γὰρ",702963,11],["αὐτῷ",702165,50],["κατέλιπεν",707305,2],["μετ᾿",708780,0],["αὐτόν",702165,85]],"Though his father die, yet he is as though he were not dead: for he hath left one behind him that is like himself."],["5",[["ἐν",704639,0],["τῇ",709436,100],["ζωῇ",705910,1],["αὐτοῦ",702165,102],["εἶδεν",709725,2],["καὶ",707031,7],["εὐφράνθη",705715,37],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["τελευτῇ",712782,1],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐλυπήθη",708272,37]],"While he lived, he saw and rejoiced in him: and when he died, he was not sorrowful."],["6",[["ἐναντίον",704654,0],["ἐχθρῶν",705779,169],["κατέλιπεν",707305,2],["ἔκδικον",704177,27],["καὶ",707031,7],["τοῖς",709436,147],["φίλοις",713492,230],["ἀνταποδιδόντα",701215,183],["χάριν",713735,9]],"He left behind him an avenger against his enemies, and one that shall requite kindness to his friends."],["7",[["περιψύχων",710425,72],["υἱὸν",713075,6],["καταδεσμεύσει",707236,127],["τραύματα",712920,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπὶ",705080,0],["πάσῃ",710177,101],["βοῇ",702744,1],["ταραχθήσεται",712721,134],["σπλάγχνα",712018,64],["αὐτοῦ",702165,102]],"He that maketh too much of his son shall bind up his wounds; and his bowels will be troubled at every cry."],["8",[["ἵππος",706790,4],["ἀδάμαστος",700226,14],["ἐκβαίνει",704144,91],["σκληρός",711861,14],["καὶ",707031,7],["υἱὸς",713075,4],["ἀνειμένος",701169,419],["ἐκβαίνει",704144,91],["προαλής",710754,14]],"An horse not broken becometh headstrong: and a child left to himself will be wilful."],["9",[["τιθήνησον",712850,176],["τέκνον",712761,25],["καὶ",707031,7],["ἐκθαμβήσει",704189,127],["σε",711598,163],["σύμπαιξον",712318,176],["αὐτῷ",702165,50],["καὶ",707031,7],["λυπήσει",708272,127],["σε",711598,163]],"Cocker thy child, and he shall make thee afraid: play with him, and he will bring thee to heaviness."],["10",[["μὴ",708851,28],["συγγελάσῃς",712183,175],["αὐτῷ",702165,50],["ἵνα",706747,7],["μὴ",708851,28],["συνοδυνηθῇς",712492,175],["καὶ",707031,7],["ἐπ᾿",705080,0],["ἐσχάτων",705519,83],["γομφιάσεις",703167,166],["τοὺς",709436,58],["ὀδόντας",709461,57],["σου",711945,133]],"Laugh not with him, lest thou have sorrow with him, and lest thou gnash thy teeth in the end."],["11",[["μὴ",708851,28],["δῷς",703654,175],["αὐτῷ",702165,50],["ἐξουσίαν",704974,9],["ἐν",704639,0],["νεότητι",709258,1]],"Give him not liberty in youth."],["12",[["θλάσον",706273,176],["τὰς",709436,38],["πλευρὰς",710524,39],["αὐτοῦ",702165,102],["ὡς",714148,7],["ἔστιν",704093,91],["νήπιος",709295,14],["μήποτε",708882,28],["σκληρυνθεὶς",711864,217],["ἀπειθήσῃ",701370,172],["σοι",711925,159]],"Beat his sides while he is still young, lest becoming stubborn, he disobey thee."],["13",[["παίδευσον",709926,176],["τὸν",709436,5],["υἱόν",713075,6],["σου",711945,133],["καὶ",707031,7],["ἔργασαι",705383,300],["ἐν",704639,0],["αὐτῷ",702165,50],["ἵνα",706747,7],["μὴ",708851,28],["ἐν",704639,0],["τῇ",709436,100],["ἀσχημοσύνῃ",702054,1],["αὐτοῦ",702165,102],["προσκόψῃς",710923,175]],"Train up thy son, and exercise him with work, lest by thy looseness thou stumble."],["14",[["κρείσσων",707891,14],["πτωχὸς",711076,4],["ὑγιὴς",713059,14],["καὶ",707031,7],["ἰσχύων",706859,72],["τῇ",709436,100],["ἕξει",704937,1],["ἢ",705924,7],["πλούσιος",710560,14],["μεμαστιγωμένος",708566,419],["εἰς",704105,0],["σῶμα",712635,25],["αὐτοῦ",702165,102]],"Better is the poor, being sound and strong of constitution, than a rich man that is afflicted in his body."],["15",[["ὑγίεια",713058,12],["καὶ",707031,7],["εὐεξία",705573,12],["βελτίων",702647,29],["παντὸς",710177,92],["χρυσίου",713972,21],["καὶ",707031,7],["σῶμα",712635,15],["εὔρωστον",705682,26],["ἢ",705924,7],["ὄλβος",709558,4],["ἀμέτρητος",700816,14]],"Health and good estate of body are above all gold, and a strong body above infinite wealth."],["16",[["οὐκ",709805,28],["ἔστιν",704093,91],["πλοῦτος",710563,4],["βελτίων",702647,14],["ὑγιείας",713058,17],["σώματος",712635,21],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["εὐφροσύνη",705717,12],["ὑπὲρ",713111,0],["χαρὰν",713719,9],["καρδίας",707141,17]],"There is no riches above a sound body, and no joy above the joy of the heart."],["17",[["κρείσσων",707891,14],["θάνατος",706096,4],["ὑπὲρ",713111,0],["ζωὴν",705910,9],["πικρὰν",710475,36],["καὶ",707031,7],["ἀνάπαυσις",701026,12],["αἰῶνος",700504,18],["ἢ",705924,7],["ἀρρώστημα",701812,15],["ἔμμονον",704574,26]],"Death is better than a bitter life or continual sickness."],["18",[["ἀγαθὰ",700106,195],["ἐκκεχυμένα",704368,370],["ἐπὶ",705080,0],["στόματι",712125,54],["κεκλεισμένῳ",707710,447],["θέματα",706178,64],["βρωμάτων",702823,44],["παρακείμενα",710044,210],["ἐπὶ",705080,0],["τάφῳ",712738,114]],"Delicacies poured upon a mouth shut up are as messes of meat set upon a grave."],["19",[["τί",712867,126],["συμφέρει",712353,91],["κάρπωσις",707175,12],["εἰδώλῳ",704079,54],["οὔτε",709857,7],["γὰρ",702963,11],["ἔδεται",705495,93],["οὔτε",709857,7],["μὴ",708851,28],["ὀσφρανθῇ",709798,384],["οὕτως",709859,28],["ὁ",709436,3],["ἐκδιωκόμενος",704178,122],["ὑπὸ",713184,0],["κυρίου",707996,18]],"What good doeth the offering unto an idol? for neither can it eat nor smell: so is he that is persecuted of the Lord."],["20",[["βλέπων",702740,72],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["καὶ",707031,7],["στενάζων",712066,72],["ὥσπερ",714163,28],["εὐνοῦχος",705651,4],["περιλαμβάνων",710342,72],["παρθένον",710148,9],["καὶ",707031,7],["στενάζων",712066,72]],"He seeth with his eyes and groaneth, as an eunuch that embraceth a virgin and sigheth."],["21",[["μὴ",708851,28],["δῷς",703654,175],["εἰς",704105,0],["λύπην",708273,9],["τὴν",709436,8],["ψυχήν",714070,9],["σου",711945,133],["καὶ",707031,7],["μὴ",708851,28],["θλίψῃς",706274,175],["σεαυτὸν",711599,85],["ἐν",704639,0],["βουλῇ",702792,1],["σου",711945,133]],"Give not over thy mind to heaviness, and afflict not thyself in thine own counsel."],["22",[["εὐφροσύνη",705717,12],["καρδίας",707141,17],["ζωὴ",705910,12],["ἀνθρώπου",701163,18],["καὶ",707031,7],["ἀγαλλίαμα",700112,15],["ἀνδρὸς",701150,18],["μακροημέρευσις",708414,12]],"The gladness of the heart is the life of man, and the joyfulness of a man prolongeth his days."],["23",[["ἀπάτα",701364,240],["τὴν",709436,8],["ψυχήν",714070,9],["σου",711945,133],["καὶ",707031,7],["παρακάλει",710039,240],["τὴν",709436,8],["καρδίαν",707141,9],["σου",711945,133],["καὶ",707031,7],["λύπην",708273,9],["μακρὰν",708411,28],["ἀπόστησον",702214,176],["ἀπὸ",701425,0],["σοῦ",711945,133],["πολλοὺς",710646,60],["γὰρ",702963,11],["ἀπώλεσεν",701513,2],["ἡ",709436,10],["λύπη",708273,12],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ὠφέλεια",714170,12],["ἐν",704639,0],["αὐτῇ",702165,105]],"Love thine own soul, and comfort thy heart, remove sorrow far from thee: for sorrow hath killed many, and there is no profit therein."],["24",[["ζῆλος",705871,4],["καὶ",707031,7],["θυμὸς",706334,4],["ἐλαττοῦσιν",704394,197],["ἡμέρας",705984,39],["καὶ",707031,7],["πρὸ",710747,0],["καιροῦ",707047,18],["γῆρας",703089,25],["ἄγει",700209,91],["μέριμνα",708745,12]],"Envy and wrath shorten the life, and carefulness bringeth age before the time."],["25",[["λαμπρὰ",708082,29],["καρδία",707141,12],["καὶ",707031,7],["ἀγαθὴ",700106,29],["ἐπὶ",705080,0],["ἐδέσμασιν",704032,96],["τῶν",709436,43],["βρωμάτων",702823,44],["αὐτῆς",702165,86],["ἐπιμελήσεται",705199,93]],"I awaked up last of all, as one that gathereth after the grape-gatherers: by the blessing of the Lord I profited,"]]