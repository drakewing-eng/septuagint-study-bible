[["1",[["ὁ",709436,3],["συντηρῶν",712512,72],["νόμον",709349,6],["πλεονάζει",710516,91],["προσφοράς",710976,39],["θυσιάζων",706346,72],["σωτηρίου",712659,21],["ὁ",709436,3],["προσέχων",710895,72],["ἐντολαῖς",704802,76]],"If thou be made the master [of a feast], lift not thyself up, but be among them as one of the rest; take diligent care for them, and so sit down."],["2",[["ἀνταποδιδοὺς",701215,72],["χάριν",713735,9],["προσφέρων",710974,72],["σεμίδαλιν",711675,9],["καὶ",707031,7],["ὁ",709436,3],["ποιῶν",710582,72],["ἐλεημοσύνην",704421,9],["θυσιάζων",706346,72],["αἰνέσεως",700457,17]],"And when thou hast done all thy office, take thy place, that thou mayest be merry with them, and receive a crown for thy well ordering of the feast."],["3",[["εὐδοκία",705566,12],["κυρίου",707996,18],["ἀποστῆναι",702214,106],["ἀπὸ",701425,0],["πονηρίας",710659,17],["καὶ",707031,7],["ἐξιλασμὸς",704934,4],["ἀποστῆναι",702214,106],["ἀπὸ",701425,0],["ἀδικίας",700271,17]],"Speak, thou that art the elder, for it becometh thee, but with sound judgment; and hinder not music."],["4",[["μὴ",708851,28],["ὀφθῇς",709725,279],["ἐν",704639,0],["προσώπῳ",710986,54],["κυρίου",707996,18],["κενός",707612,14],["πάντα",710177,195],["γὰρ",702963,11],["ταῦτα",709858,290],["χάριν",713735,9],["ἐντολῆς",704802,17]],"Pour not out words where there is a musician, and shew not forth wisdom out of time."],["5",[["προσφορὰ",710976,12],["δικαίου",703694,116],["λιπαίνει",708215,91],["θυσιαστήριον",706348,25],["καὶ",707031,7],["ἡ",709436,10],["εὐωδία",705734,12],["αὐτῆς",702165,86],["ἔναντι",704653,0],["ὑψίστου",713287,116]],"A concert of music in a banquet of wine is as a signet of carbuncle set in gold."],["6",[["θυσία",706345,12],["ἀνδρὸς",701150,18],["δικαίου",703694,116],["δεκτή",703348,29],["καὶ",707031,7],["τὸ",709436,34],["μνημόσυνον",708966,15],["αὐτῆς",702165,86],["οὐκ",709805,28],["ἐπιλησθήσεται",705187,134]],"As a signet of an emerald set in a work of gold, so is the melody of music with pleasant wine."],["7",[["ἐν",704639,0],["ἀγαθῷ",700106,30],["ὀφθαλμῷ",709870,114],["δόξασον",703792,176],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["μὴ",708851,28],["σμικρύνῃς",711911,175],["ἀπαρχὴν",701359,9],["χειρῶν",713787,65],["σου",711945,133]],"Speak, young man, if there be need of thee: and yet scarcely when thou art twice asked."],["8",[["ἐν",704639,0],["πάσῃ",710177,101],["δόσει",703809,1],["ἱλάρωσον",706725,176],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["καὶ",707031,7],["ἐν",704639,0],["εὐφροσύνῃ",705717,1],["ἁγίασον",700153,176],["δεκάτην",703342,36]],"Let thy speech be short, comprehending much in few words; be as one that knoweth and yet holdeth his tongue."],["9",[["δὸς",703654,176],["ὑψίστῳ",713287,30],["κατὰ",707200,0],["τὴν",709436,8],["δόσιν",703809,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["ἀγαθῷ",700106,30],["ὀφθαλμῷ",709870,114],["καθ᾿",707200,0],["εὕρεμα",705671,25],["χειρός",713787,17]],"If thou be among great men, make not thyself equal with them; and when ancient men are in place, use not many words."],["10",[["ὅτι",709803,7],["κύριος",707996,4],["ἀνταποδιδούς",701215,72],["ἐστιν",704093,91],["καὶ",707031,7],["ἑπταπλάσια",705368,68],["ἀνταποδώσει",701215,127],["σοι",711925,159]],"Before the thunder goeth lightning; and before a shamefaced man shall go favour."],["11",[["μὴ",708851,28],["δωροκόπει",703905,240],["οὐ",709805,28],["γὰρ",702963,11],["προσδέξεται",710874,93],["καὶ",707031,7],["μὴ",708851,28],["ἔπεχε",705076,240],["θυσίᾳ",706345,1],["ἀδίκῳ",700272,101]],"Rise up betimes, and be not the last; but get thee home without delay."],["12",[["ὅτι",709803,7],["κύριος",707996,4],["κριτής",707910,4],["ἐστιν",704093,91],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["παρ᾿",709995,0],["αὐτῷ",702165,50],["δόξα",703791,12],["προσώπου",710986,21]],"There take thy pastime, and do what thou wilt: but sin not by proud speech."],["13",[["οὐ",709805,28],["λήμψεται",708076,93],["πρόσωπον",710986,25],["ἐπὶ",705080,0],["πτωχοῦ",711076,18],["καὶ",707031,7],["δέησιν",703311,9],["ἠδικημένου",700269,482],["εἰσακούσεται",704108,93]],"And for these things bless him that made thee, and hath replenished thee with his good things."],["14",[["οὐ",709805,28],["μὴ",708851,28],["ὑπερίδῃ",713154,172],["ἱκετείαν",706715,9],["ὀρφανοῦ",709779,116],["καὶ",707031,7],["χήραν",713848,9],["ἐὰν",703912,7],["ἐκχέῃ",704368,204],["λαλιάν",708074,9]],"Whoso feareth the Lord will receive his discipline; and they that seek him early shall find favour."],["15",[["οὐχὶ",709862,28],["δάκρυα",703255,64],["χήρας",713848,17],["ἐπὶ",705080,0],["σιαγόνα",711763,9],["καταβαίνει",707202,91],["καὶ",707031,7],["ἡ",709436,10],["καταβόησις",707214,12],["ἐπὶ",705080,0],["τῷ",709436,113],["καταγαγόντι",707232,350],["αὐτά",702165,71]],"He that seeketh the law shall be filled therewith: but the hypocrite will be offended thereat."],["16",[["θεραπεύων",706200,72],["ἐν",704639,0],["εὐδοκίᾳ",705566,1],["δεχθήσεται",703393,134],["καὶ",707031,7],["ἡ",709436,10],["δέησις",703311,12],["αὐτοῦ",702165,102],["ἕως",705792,0],["νεφελῶν",709277,65],["συνάψει",712404,127]],"They that fear the Lord shall find judgment, and shall kindle justice as a light."],["17",[["προσευχὴ",710892,12],["ταπεινοῦ",712714,116],["νεφέλας",709277,39],["διῆλθεν",703673,2],["καὶ",707031,7],["ἕως",705792,7],["συνεγγίσῃ",712423,172],["οὐ",709805,28],["μὴ",708851,28],["παρακληθῇ",710039,384]],"A sinful man will not be reproved, but findeth an excuse according to his will."],["18",[["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἀποστῇ",702214,172],["ἕως",705792,7],["ἐπισκέψηται",705250,239],["ὁ",709436,3],["ὕψιστος",713287,14],["καὶ",707031,7],["κρινεῖ",707905,127],["δικαίοις",703694,230],["καὶ",707031,7],["ποιήσει",710582,127],["κρίσιν",707908,9]],"A man of counsel will be considerate; but a strange and proud man is not daunted with fear, even when of himself he hath done without counsel."],["19",[["καὶ",707031,7],["ὁ",709436,3],["κύριος",707996,4],["οὐ",709805,28],["μὴ",708851,28],["βραδύνῃ",702806,172],["οὐδὲ",709816,7],["μὴ",708851,28],["μακροθυμήσῃ",708418,172],["ἐπ᾿",705080,0],["αὐτοῖς",702165,151]],"Do nothing without advice; and when thou hast once done, repent not."],["20",[["ἕως",705792,7],["ἂν",700900,11],["συντρίψῃ",712520,172],["ὀσφὺν",709800,9],["ἀνελεημόνων",701120,169],["καὶ",707031,7],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["ἀνταποδώσει",701215,127],["ἐκδίκησιν",704175,9]],"Go not in a way wherein thou mayest fall, and stumble not among the stones."],["21",[["ἕως",705792,7],["ἐξάρῃ",704839,172],["πλῆθος",710529,25],["ὑβριστῶν",713052,81],["καὶ",707031,7],["σκῆπτρα",711851,42],["ἀδίκων",700272,169],["συντρίψει",712520,127]],"Be not confident in a plain way."],["22",[["ἕως",705792,7],["ἀνταποδῷ",701215,172],["ἀνθρώπῳ",701163,114],["κατὰ",707200,0],["τὰς",709436,38],["πράξεις",710714,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["ἔργα",705396,42],["τῶν",709436,80],["ἀνθρώπων",701163,81],["κατὰ",707200,0],["τὰ",709436,41],["ἐνθυμήματα",704740,42],["αὐτῶν",702165,40]],"And beware of thine own children."],["23",[["ἕως",705792,7],["κρίνῃ",707905,172],["τὴν",709436,8],["κρίσιν",707908,9],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["εὐφρανεῖ",705715,127],["αὐτοὺς",702165,62],["ἐν",704639,0],["τῷ",709436,53],["ἐλέει",704426,54],["αὐτοῦ",702165,102]],"In every good work trust thy own soul; for this is the keeping of the commandments."],["24",[["ὡραῖον",714132,26],["ἔλεος",704426,15],["ἐν",704639,0],["καιρῷ",707047,114],["θλίψεως",706276,17],["αὐτοῦ",702165,102],["ὡς",714148,7],["νεφέλαι",709277,191],["ὑετοῦ",713074,18],["ἐν",704639,0],["καιρῷ",707047,114],["ἀβροχίας",700095,17]],"He that believeth in the Lord taketh heed to the commandment; and he that trusteth in him shall fare never the worse."]]