[["1",[["ὁ",709436,3],["ζῶν",705851,72],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἔκτισεν",707938,2],["τὰ",709436,41],["πάντα",710177,68],["κοινῇ",707772,101]],"He that liveth for ever created all things in general."],["2",[["κύριος",707996,4],["μόνος",709003,14],["δικαιωθήσεται",703696,134]],"The Lord only is righteous."],["4",[["οὐθενὶ",709817,30],["ἐξεποίησεν",704289,2],["ἐξαγγεῖλαι",704829,106],["τὰ",709436,41],["ἔργα",705396,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["τίς",712867,158],["ἐξιχνεύσει",704941,127],["τὰ",709436,41],["μεγαλεῖα",708625,68],["αὐτοῦ",702165,102]],"To none hath he given power to declare his works; and who shall find out his noble acts?"],["5",[["κράτος",707883,25],["μεγαλωσύνης",708652,17],["αὐτοῦ",702165,102],["τίς",712867,158],["ἐξαριθμήσεται",704877,93],["καὶ",707031,7],["τίς",712867,158],["προσθήσει",710965,127],["ἐκδιηγήσασθαι",704172,109],["τὰ",709436,41],["ἐλέη",704426,42],["αὐτοῦ",702165,102]],"Who shall number the strength of his majesty? and who shall also tell out his mercies?"],["6",[["οὐκ",709805,28],["ἔστιν",704093,91],["ἐλαττῶσαι",704394,106],["οὐδὲ",709816,7],["προσθεῖναι",710965,106],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐξιχνιάσαι",704941,106],["τὰ",709436,41],["θαυμάσια",706136,68],["τοῦ",709436,35],["κυρίου",707996,18]],"As for the wondrous works of the Lord, there may nothing be taken from them, neither may any thing be put unto them, neither can the ground of them be found out."],["7",[["ὅταν",709801,28],["συντελέσῃ",712510,172],["ἄνθρωπος",701163,4],["τότε",712908,28],["ἄρχεται",701860,117],["καὶ",707031,7],["ὅταν",709801,28],["παύσηται",710202,239],["τότε",712908,28],["ἀπορηθήσεται",701559,134]],"When a man hath done, then he beginneth; and when he leaveth off, then he shall be doubtful."],["8",[["τί",712867,273],["ἄνθρωπος",701163,4],["καὶ",707031,7],["τί",712867,273],["ἡ",709436,10],["χρῆσις",713954,12],["αὐτοῦ",702165,102],["τί",712867,273],["τὸ",709436,34],["ἀγαθὸν",700106,26],["αὐτοῦ",702165,102],["καὶ",707031,7],["τί",712867,273],["τὸ",709436,34],["κακὸν",707066,26],["αὐτοῦ",702165,102]],"What is man, and whereto serveth he; what is his good, and what is his evil?"],["9",[["ἀριθμὸς",701744,4],["ἡμερῶν",705984,65],["ἀνθρώπου",701163,18],["πολλὰ",710646,195],["ἔτη",705543,64],["ἑκατόν",704136,59]],"The number of a man's days at the most is an hundred years."],["10",[["ὡς",714148,7],["σταγὼν",712036,12],["ὕδατος",713071,21],["ἀπὸ",701425,0],["θαλάσσης",706069,17],["καὶ",707031,7],["ψῆφος",714052,12],["ἄμμου",700845,17],["οὕτως",709859,28],["ὀλίγα",709568,195],["ἔτη",705543,64],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["αἰῶνος",700504,18]],"As a drop of water unto the sea, and a gravel-stone in comparison of the sand; so are a thousand years to the days of eternity."],["11",[["διὰ",703417,0],["τοῦτο",709858,129],["ἐμακροθύμησεν",708418,2],["κύριος",707996,4],["ἐπ᾿",705080,0],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἐξέχεεν",704368,13],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["τὸ",709436,24],["ἔλεος",704426,25],["αὐτοῦ",702165,102]],"Therefore is God patient with them, and poureth forth his mercy upon them."],["12",[["εἶδεν",709725,2],["καὶ",707031,7],["ἐπέγνω",705104,2],["τὴν",709436,8],["καταστροφὴν",707445,9],["αὐτῶν",702165,40],["ὅτι",709803,7],["πονηρά",710660,195],["διὰ",703417,0],["τοῦτο",709858,129],["ἐπλήθυνεν",710530,2],["τὸν",709436,5],["ἐξιλασμὸν",704934,6],["αὐτοῦ",702165,102]],"He saw and perceived their end to be evil; therefore he multiplied his compassion."],["13",[["ἔλεος",704426,15],["ἀνθρώπου",701163,18],["ἐπὶ",705080,0],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102],["ἔλεος",704426,25],["δὲ",703303,11],["κυρίου",707996,18],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["σάρκα",711537,9],["ἐλέγχων",704416,72],["καὶ",707031,7],["παιδεύων",709926,72],["καὶ",707031,7],["διδάσκων",703649,72],["καὶ",707031,7],["ἐπιστρέφων",705278,72],["ὡς",714148,7],["ποιμὴν",710596,4],["τὸ",709436,24],["ποίμνιον",710598,25],["αὐτοῦ",702165,102]],"The mercy of man is toward his neighbour; but the mercy of the Lord is upon all flesh: he reproveth, and nurtureth, and teacheth, and bringeth again, as a shepherd his flock."],["14",[["τοὺς",709436,58],["ἐκδεχομένους",704165,236],["παιδείαν",709924,9],["ἐλεᾷ",704412,91],["καὶ",707031,7],["τοὺς",709436,58],["κατασπεύδοντας",707433,235],["ἐπὶ",705080,0],["τὰ",709436,41],["κρίματα",707903,42],["αὐτοῦ",702165,102]],"He hath mercy on them that receive discipline, and that diligently seek after his judgments."],["15",[["τέκνον",712761,297],["ἐν",704639,0],["ἀγαθοῖς",700106,94],["μὴ",708851,28],["δῷς",703654,175],["μῶμον",709102,6],["καὶ",707031,7],["ἐν",704639,0],["πάσῃ",710177,101],["δόσει",703809,1],["λύπην",708273,9],["λόγων",708236,81]],"My son, blemish not thy good deeds, neither use uncomfortable words when thou givest any thing."],["16",[["οὐχὶ",709862,28],["καύσωνα",707567,6],["ἀναπαύσει",701026,1],["δρόσος",703835,12],["οὕτως",709859,28],["κρείσσων",707891,14],["λόγος",708236,4],["ἢ",705924,7],["δόσις",703809,12]],"Shall not the dew assuage the heat? so is a word better than a gift."],["17",[["οὐκ",709805,28],["ἰδοὺ",706497,88],["λόγος",708236,4],["ὑπὲρ",713111,0],["δόμα",703789,15],["ἀγαθόν",700106,26],["καὶ",707031,7],["ἀμφότερα",700892,195],["παρὰ",709995,0],["ἀνδρὶ",701150,114],["κεχαριτωμένῳ",713737,516]],"Lo, is not a word better than a gift? but both are with a gracious man."],["18",[["μωρὸς",709110,14],["ἀχαρίστως",702253,28],["ὀνειδιεῖ",709655,127],["καὶ",707031,7],["δόσις",703809,12],["βασκάνου",702589,18],["ἐκτήκει",704329,91],["ὀφθαλμούς",709870,57]],"A fool will upbraid churlishly, and a gift of the envious consumeth the eyes."],["19",[["πρὶν",710742,28],["ἢ",705924,28],["λαλῆσαι",708071,106],["μάνθανε",708480,240],["καὶ",707031,7],["πρὸ",710747,0],["ἀρρωστίας",701813,17],["θεραπεύου",706200,253]],"Learn before thou speak, and use physic or ever thou be sick."],["20",[["πρὸ",710747,0],["κρίσεως",707908,17],["ἐξέταζε",704911,240],["σεαυτόν",711599,85],["καὶ",707031,7],["ἐν",704639,0],["ὥρᾳ",714128,1],["ἐπισκοπῆς",705255,17],["εὑρήσεις",705676,166],["ἐξιλασμόν",704934,6]],"Before judgment examine thyself, and in the day of visitation thou shalt find mercy."],["21",[["πρὶν",710742,28],["ἀρρωστῆσαί",701811,106],["σε",711598,163],["ταπεινώθητι",712717,244],["καὶ",707031,7],["ἐν",704639,0],["καιρῷ",707047,114],["ἁμαρτημάτων",700774,44],["δεῖξον",703314,176],["ἐπιστροφήν",705279,9]],"Humble thyself before thou be sick, and in the time of sins shew repentance."],["22",[["μὴ",708851,28],["ἐμποδισθῇς",704604,279],["τοῦ",709436,20],["ἀποδοῦναι",701449,106],["εὐχὴν",705726,9],["εὐκαίρως",705613,28],["καὶ",707031,7],["μὴ",708851,28],["μείνῃς",708736,175],["ἕως",705792,0],["θανάτου",706096,18],["δικαιωθῆναι",703696,179]],"Let nothing hinder thee to pay thy vow in due time, and defer not until death to be justified."],["23",[["πρὶν",710742,28],["εὔξασθαι",705727,109],["ἑτοίμασον",705539,176],["σεαυτὸν",711599,85],["καὶ",707031,7],["μὴ",708851,28],["γίνου",703104,253],["ὡς",714148,7],["ἄνθρωπος",701163,4],["πειράζων",710225,72],["τὸν",709436,5],["κύριον",707996,6]],"Before thou prayest, prepare thyself; and be not as one that tempteth the Lord."],["24",[["μνήσθητι",708960,244],["θυμοῦ",706334,18],["ἐν",704639,0],["ἡμέραις",705984,76],["τελευτῆς",712782,17],["καὶ",707031,7],["καιρὸν",707047,6],["ἐκδικήσεως",704175,17],["ἐν",704639,0],["ἀποστροφῇ",701599,1],["προσώπου",710986,21]],"Think upon the wrath that shall be at the end, and the time of vengeance, when he shall turn away his face."],["25",[["μνήσθητι",708960,244],["καιρὸν",707047,6],["λιμοῦ",708210,18],["ἐν",704639,0],["καιρῷ",707047,114],["πλησμονῆς",710549,17],["πτωχείαν",711073,9],["καὶ",707031,7],["ἔνδειαν",704672,9],["ἐν",704639,0],["ἡμέραις",705984,76],["πλούτου",710563,18]],"When thou hast enough, remember the time of hunger: and when thou art rich, think upon poverty and need."],["26",[["ἀπὸ",701425,0],["πρωίθεν",711022,28],["ἕως",705792,0],["ἑσπέρας",705500,17],["μεταβάλλει",708782,91],["καιρός",707047,4],["καὶ",707031,7],["πάντα",710177,195],["ἐστὶν",704093,91],["ταχινὰ",712744,195],["ἔναντι",704653,0],["κυρίου",707996,18]],"From the morning until the evening the time is changed, and all things are soon done before the Lord."],["27",[["ἄνθρωπος",701163,4],["σοφὸς",711985,14],["ἐν",704639,0],["παντὶ",710177,97],["εὐλαβηθήσεται",705627,134],["καὶ",707031,7],["ἐν",704639,0],["ἡμέραις",705984,76],["ἁμαρτιῶν",700775,65],["προσέξει",710895,127],["ἀπὸ",701425,0],["πλημμελείας",710533,17]],"A wise man will fear in every thing, and in the day of sinning he will beware of offence: but a fool will not observe time."],["28",[["πᾶς",710177,14],["συνετὸς",712464,14],["ἔγνω",703105,2],["σοφίαν",711981,9],["καὶ",707031,7],["τῷ",709436,113],["εὑρόντι",705676,350],["αὐτὴν",702165,104],["δώσει",703654,127],["ἐξομολόγησιν",704961,9]],"Every man of understanding knoweth wisdom, and will give praise unto him that found her."],["29",[["συνετοὶ",712464,138],["ἐν",704639,0],["λόγοις",708236,148],["καὶ",707031,7],["αὐτοὶ",702165,201],["ἐσοφίσαντο",711982,189],["καὶ",707031,7],["ἀνώμβρησαν",701189,150],["παροιμίας",710160,39],["ἀκριβεῖς",700597,119]],"They that had understanding in sayings became also wise themselves, and poured forth exquisite parables."],["30",[["ὀπίσω",709697,28],["τῶν",709436,130],["ἐπιθυμιῶν",705147,65],["σου",711945,133],["μὴ",708851,28],["πορεύου",710667,253],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,130],["ὀρέξεών",709734,65],["σου",711945,133],["κωλύου",708020,253]],"Go not after thy lusts, but refrain thyself from thine appetites."],["31",[["ἐὰν",703912,7],["χορηγήσῃς",713911,175],["τῇ",709436,100],["ψυχῇ",714070,1],["σου",711945,133],["εὐδοκίαν",705566,9],["ἐπιθυμίας",705147,17],["ποιήσει",710582,127],["σε",711598,163],["ἐπίχαρμα",705332,25],["τῶν",709436,80],["ἐχθρῶν",705779,169],["σου",711945,133]],"If thou givest thy soul the desires that please her, she will make thee a laughingstock to thine enemies that malign thee."],["32",[["μὴ",708851,28],["εὐφραίνου",705715,253],["ἐπὶ",705080,0],["πολλῇ",710646,101],["τρυφῇ",713008,1],["μὴ",708851,28],["προσδεθῇς",710873,279],["συμβολῇ",712287,1],["αὐτῆς",702165,86]],"Take not pleasure in much good cheer, neither be tied to the expence thereof."],["33",[["μὴ",708851,28],["γίνου",703104,253],["πτωχὸς",711076,4],["συμβολοκοπῶν",712288,72],["ἐκ",704132,0],["δανεισμοῦ",703279,18],["καὶ",707031,7],["οὐδέν",709817,26],["σοί",711925,159],["ἐστιν",704093,91],["ἐν",704639,0],["μαρσιππίῳ",708521,54]],"Be not made a beggar by banqueting upon borrowing, when thou hast nothing in thy purse."]]