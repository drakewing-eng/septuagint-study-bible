[["1",[["μὴ",708851,28],["ποίει",710582,240],["κακά",707066,68],["καὶ",707031,7],["οὐ",709805,28],["μή",708851,28],["σε",711598,163],["καταλάβῃ",707300,172],["κακόν",707066,46]],"Do no evil, so shall no harm come unto thee."],["2",[["ἀπόστηθι",702214,176],["ἀπὸ",701425,0],["ἀδίκου",700272,92],["καὶ",707031,7],["ἐκκλινεῖ",704220,127],["ἀπὸ",701425,0],["σοῦ",711945,133]],"Depart from the unjust, and iniquity shall turn away from thee."],["3",[["υἱέ",713075,153],["μὴ",708851,28],["σπεῖρε",712006,240],["ἐπ᾿",705080,0],["αὔλακας",702134,57],["ἀδικίας",700271,17],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["θερίσῃς",706206,175],["αὐτὰ",702165,71],["ἑπταπλασίως",705370,28]],"My son, sow not upon the furrows of unrighteousness, and thou shalt not reap them sevenfold."],["4",[["μὴ",708851,28],["ζήτει",705879,240],["παρὰ",709995,0],["κυρίου",707996,18],["ἡγεμονίαν",705927,9],["μηδὲ",708855,7],["παρὰ",709995,0],["βασιλέως",702580,18],["καθέδραν",706992,9],["δόξης",703791,17]],"Seek not of the Lord preeminence, neither of the king the seat of honour."],["5",[["μὴ",708851,28],["δικαιοῦ",703696,253],["ἔναντι",704653,0],["κυρίου",707996,18],["καὶ",707031,7],["παρὰ",709995,0],["βασιλεῖ",702580,114],["μὴ",708851,28],["σοφίζου",711982,253]],"Justify not thyself before the Lord; and boast not of thy wisdom before the king."],["6",[["μὴ",708851,28],["ζήτει",705879,240],["γενέσθαι",703104,109],["κριτής",707910,4],["μὴ",708851,28],["οὐκ",709805,28],["ἰσχύσεις",706859,166],["ἐξᾶραι",704839,106],["ἀδικίας",700271,39],["μήποτε",708882,28],["εὐλαβηθῇς",705627,279],["ἀπὸ",701425,0],["προσώπου",710986,21],["δυνάστου",703844,18],["καὶ",707031,7],["θήσεις",712849,166],["σκάνδαλον",711825,25],["ἐν",704639,0],["εὐθύτητί",705603,1],["σου",711945,133]],"Seek not to be judge, being not able to take away iniquity; lest at any time thou fear the person of the mighty, and lay a stumblingblock in the way of thy uprightness."],["7",[["μὴ",708851,28],["ἁμάρτανε",700773,240],["εἰς",704105,0],["πλῆθος",710529,25],["πόλεως",710612,17],["καὶ",707031,7],["μὴ",708851,28],["καταβάλῃς",707203,175],["σεαυτὸν",711599,85],["ἐν",704639,0],["ὄχλῳ",709884,114]],"Offend not against the multitude of a city, and then thou shalt not cast thyself down among the people."],["8",[["μὴ",708851,28],["καταδεσμεύσῃς",707236,175],["δὶς",703741,28],["ἁμαρτίαν",700775,9],["ἐν",704639,0],["γὰρ",702963,11],["τῇ",709436,100],["μιᾷ",704106,101],["οὐκ",709805,28],["ἀθῷος",700390,14],["ἔσῃ",704093,123]],"Bind not one sin upon another; for in one thou shalt not be unpunished."],["9",[["μὴ",708851,28],["εἴπῃς",705373,175],["τῷ",709436,53],["πλήθει",710529,54],["τῶν",709436,43],["δώρων",703907,44],["μου",709032,133],["ἐπόψεται",705057,93],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["προσενέγκαι",710974,106],["με",708618,163],["θεῷ",706192,114],["ὑψίστῳ",713287,30],["προσδέξεται",710874,93]],"Say not, God will look upon the multitude of my oblations, and when I offer to the most high God, he will accept it."],["10",[["μὴ",708851,28],["ὀλιγοψυχήσῃς",709572,175],["ἐν",704639,0],["τῇ",709436,100],["προσευχῇ",710892,1],["σου",711945,133],["καὶ",707031,7],["ἐλεημοσύνην",704421,9],["ποιῆσαι",710582,106],["μὴ",708851,28],["παρίδῃς",710125,175]],"Be not fainthearted when thou makest thy prayer, and neglect not to give alms."],["11",[["μὴ",708851,28],["καταγέλα",707222,240],["ἄνθρωπον",701163,6],["ὄντα",704093,183],["ἐν",704639,0],["πικρίᾳ",710472,1],["ψυχῆς",714070,17],["αὐτοῦ",702165,102],["ἔστιν",704093,91],["γὰρ",702963,11],["ὁ",709436,3],["ταπεινῶν",712717,72],["καὶ",707031,7],["ἀνυψῶν",701293,72]],"Laugh no man to scorn in the bitterness of his soul: for there is one which humbleth and exalteth."],["12",[["μὴ",708851,28],["ἀροτρία",701791,240],["ψεῦδος",714044,25],["ἐπ᾿",705080,0],["ἀδελφῷ",700249,114],["σου",711945,133],["μηδὲ",708855,7],["φίλῳ",713492,30],["τὸ",709436,24],["ὅμοιον",709626,46],["ποίει",710582,240]],"Devise not a lie against thy brother; neither do the like to thy friend."],["13",[["μὴ",708851,28],["θέλε",706176,240],["ψεύδεσθαι",714045,110],["πᾶν",710177,46],["ψεῦδος",714044,25],["ὁ",709436,3],["γὰρ",702963,11],["ἐνδελεχισμὸς",704680,4],["αὐτοῦ",702165,49],["οὐκ",709805,28],["εἰς",704105,0],["ἀγαθόν",700106,27]],"Use not to make any manner of lie: for the custom thereof is not good."],["14",[["μὴ",708851,28],["ἀδολέσχει",700281,240],["ἐν",704639,0],["πλήθει",710529,54],["πρεσβυτέρων",710735,81],["καὶ",707031,7],["μὴ",708851,28],["δευτερώσῃς",703390,175],["λόγον",708236,6],["ἐν",704639,0],["προσευχῇ",710892,1],["σου",711945,133]],"Use not many words in a multitude of elders, and make not much babbling when thou prayest."],["15",[["μὴ",708851,28],["μισήσῃς",708935,175],["ἐπίπονον",705231,36],["ἐργασίαν",705385,9],["καὶ",707031,7],["γεωργίαν",703080,9],["ὑπὸ",713184,0],["ὑψίστου",713287,116],["ἐκτισμένην",707938,444]],"Hate not laborious work, neither husbandry, which the most High hath ordained."],["16",[["μὴ",708851,28],["προσλογίζου",710931,253],["σεαυτὸν",711599,85],["ἐν",704639,0],["πλήθει",710529,54],["ἁμαρτωλῶν",700776,169],["μνήσθητι",708960,244],["ὅτι",709803,7],["ὀργὴ",709728,12],["οὐ",709805,28],["χρονιεῖ",713967,127]],"Number not thyself among the multitude of sinners, but remember that wrath will not tarry long.",{"s":"d","q":0.55}],["17",[["ταπείνωσον",712717,176],["σφόδρα",712586,28],["τὴν",709436,8],["ψυχήν",714070,9],["σου",711945,133],["ὅτι",709803,7],["ἐκδίκησις",704175,12],["ἀσεβοῦς",701909,116],["πῦρ",711088,15],["καὶ",707031,7],["σκώληξ",711905,4]],"Humble thy soul greatly: for the vengeance of the ungodly is fire and worms.",{"s":"d","q":0.45}],["18",[["μὴ",708851,28],["ἀλλάξῃς",700683,175],["φίλον",713492,27],["ἕνεκεν",704709,0],["διαφόρου",703630,116],["μηδὲ",708855,7],["ἀδελφὸν",700249,6],["γνήσιον",703128,27],["ἐν",704639,0],["χρυσίῳ",713972,54],["Σουφιρ",711980,118]],"Change not a friend for any good by no means; neither a faithful brother for the gold of Suphir."],["19",[["μὴ",708851,28],["ἀστόχει",702019,240],["γυναικὸς",703209,17],["σοφῆς",711985,82],["καὶ",707031,7],["ἀγαθῆς",700106,82],["ἡ",709436,10],["γὰρ",702963,11],["χάρις",713735,12],["αὐτῆς",702165,86],["ὑπὲρ",713111,0],["τὸ",709436,24],["χρυσίον",713972,25]],"Forego not a wise and good woman: for her grace is above gold."],["20",[["μὴ",708851,28],["κακώσῃς",707073,175],["οἰκέτην",709496,6],["ἐργαζόμενον",705383,212],["ἐν",704639,0],["ἀληθείᾳ",700656,1],["μηδὲ",708855,7],["μίσθιον",708938,27],["διδόντα",703654,183],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102]],"Whereas thy servant worketh truly, entreat him not evil, nor the hireling that bestoweth himself wholly for thee."],["21",[["οἰκέτην",709496,6],["συνετὸν",712464,27],["ἀγαπάτω",700120,31],["σου",711945,133],["ἡ",709436,10],["ψυχή",714070,12],["μὴ",708851,28],["στερήσῃς",712076,175],["αὐτὸν",702165,85],["ἐλευθερίας",704427,17]],"Let thy soul love a good servant, and defraud him not of liberty."],["22",[["κτήνη",707934,42],["σοί",711925,159],["ἐστιν",704093,91],["ἐπισκέπτου",705250,253],["αὐτά",702165,71],["καὶ",707031,7],["εἰ",704071,7],["ἔστιν",704093,91],["σοι",711925,159],["χρήσιμα",713953,68],["ἐμμενέτω",704570,31],["σοι",711925,159]],"Hast thou cattle? have an eye to them: and if they be for thy profit, keep them with thee."],["23",[["τέκνα",712761,42],["σοί",711925,159],["ἐστιν",704093,91],["παίδευσον",709926,176],["αὐτὰ",702165,71],["καὶ",707031,7],["κάμψον",707118,176],["ἐκ",704132,0],["νεότητος",709258,17],["τὸν",709436,5],["τράχηλον",712924,6],["αὐτῶν",702165,40]],"Hast thou children? instruct them, and bow down their neck from their youth."],["24",[["θυγατέρες",706320,191],["σοί",711925,159],["εἰσιν",704093,197],["πρόσεχε",710895,240],["τῷ",709436,53],["σώματι",712635,54],["αὐτῶν",702165,284],["καὶ",707031,7],["μὴ",708851,28],["ἱλαρώσῃς",706726,175],["πρὸς",710844,0],["αὐτὰς",702165,231],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133]],"Hast thou daughters? have a care of their body, and shew not thyself cheerful toward them."],["25",[["ἔκδου",704166,253],["θυγατέρα",706320,9],["καὶ",707031,7],["ἔσῃ",704093,123],["τετελεκὼς",712783,270],["ἔργον",705396,25],["μέγα",708653,46],["καὶ",707031,7],["ἀνδρὶ",701150,114],["συνετῷ",712464,30],["δώρησαι",703902,300],["αὐτήν",702165,104]],"Marry thy daughter, and so shalt thou have performed a weighty matter: but give her to a man of understanding."],["26",[["γυνή",703209,12],["σοί",711925,159],["ἐστιν",704093,91],["κατὰ",707200,0],["ψυχήν",714070,9],["μὴ",708851,28],["ἐκβάλῃς",704145,175],["αὐτήν",702165,104],["καὶ",707031,7],["μισουμένῃ",708935,585],["μὴ",708851,28],["ἐμπιστεύσῃς",704594,175],["σεαυτόν",711599,85]],"Hast thou a wife after thy mind? forsake her not.",{"s":"d","q":0.54}],["27",[["ἐν",704639,0],["ὅλῃ",709597,101],["καρδίᾳ",707141,1],["σου",711945,133],["δόξασον",703792,176],["τὸν",709436,5],["πατέρα",710189,6],["σου",711945,133],["καὶ",707031,7],["μητρὸς",708892,17],["ὠδῖνας",714094,39],["μὴ",708851,28],["ἐπιλάθῃ",705187,420]],"Honour thy father with thy whole heart, and forget not the sorrows of thy mother."],["28",[["μνήσθητι",708960,244],["ὅτι",709803,7],["δι᾿",703417,0],["αὐτῶν",702165,40],["ἐγεννήθης",703051,168],["καὶ",707031,7],["τί",712867,126],["ἀνταποδώσεις",701215,166],["αὐτοῖς",702165,151],["καθὼς",707030,7],["αὐτοὶ",702165,201],["σοί",711925,159]],"Remember that thou wast begotten of them; and how canst thou recompense them the things that they have done for thee?"],["29",[["ἐν",704639,0],["ὅλῃ",709597,101],["ψυχῇ",714070,1],["σου",711945,133],["εὐλαβοῦ",705627,253],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["τοὺς",709436,58],["ἱερεῖς",706614,57],["αὐτοῦ",702165,102],["θαύμαζε",706135,240]],"Fear the Lord with all thy soul, and reverence his priests."],["30",[["ἐν",704639,0],["ὅλῃ",709597,101],["δυνάμει",703839,1],["ἀγάπησον",700120,176],["τὸν",709436,5],["ποιήσαντά",710582,365],["σε",711598,163],["καὶ",707031,7],["τοὺς",709436,58],["λειτουργοὺς",708137,57],["αὐτοῦ",702165,102],["μὴ",708851,28],["ἐγκαταλίπῃς",703967,175]],"Love him that made thee with all thy strength, and forsake not his ministers."],["31",[["φοβοῦ",713532,253],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["δόξασον",703792,176],["ἱερέα",706614,6],["καὶ",707031,7],["δὸς",703654,176],["τὴν",709436,8],["μερίδα",708748,9],["αὐτῷ",702165,50],["καθὼς",707030,7],["ἐντέταλταί",704791,187],["σοι",711925,159],["ἀπαρχὴν",701359,9],["καὶ",707031,7],["περὶ",710285,0],["πλημμελείας",710533,17],["καὶ",707031,7],["δόσιν",703809,9],["βραχιόνων",702808,81],["καὶ",707031,7],["θυσίαν",706345,9],["ἁγιασμοῦ",700155,18],["καὶ",707031,7],["ἀπαρχὴν",701359,9],["ἁγίων",700159,83]],"Fear the Lord, and honour the priest: and give him his portion, as it is commanded thee: the firstfruits, and the trespass offering, and the gift of the shoulders, and the sacrifice of sanctification, and the firstfruits of the holy things."],["32",[["καὶ",707031,7],["πτωχῷ",711076,114],["ἔκτεινον",704322,176],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133],["ἵνα",706747,7],["τελειωθῇ",712771,384],["ἡ",709436,10],["εὐλογία",705633,12],["σου",711945,133]],"And stretch thine hand unto the poor, that thy blessing may be perfected."],["33",[["χάρις",713735,12],["δόματος",703789,21],["ἔναντι",704653,0],["παντὸς",710177,116],["ζῶντος",705851,152],["καὶ",707031,7],["ἐπὶ",705080,0],["νεκρῷ",709247,114],["μὴ",708851,28],["ἀποκωλύσῃς",701501,175],["χάριν",713735,9]],"A gift hath grace in the sight of every man living; and for the dead detain it not."],["34",[["μὴ",708851,28],["ὑστέρει",713270,240],["ἀπὸ",701425,0],["κλαιόντων",707703,170],["καὶ",707031,7],["μετὰ",708780,0],["πενθούντων",710251,170],["πένθησον",710251,176]],"Fail not to be with them that weep, and mourn with them that mourn."],["35",[["μὴ",708851,28],["ὄκνει",709548,240],["ἐπισκέπτεσθαι",705250,110],["ἄρρωστον",701814,27],["ἄνθρωπον",701163,6],["ἐκ",704132,0],["γὰρ",702963,11],["τῶν",709436,43],["τοιούτων",712878,83],["ἀγαπηθήσῃ",700120,364]],"Be not slow to visit the sick: for that shall make thee to be beloved."],["36",[["ἐν",704639,0],["πᾶσι",710177,230],["τοῖς",709436,147],["λόγοις",708236,148],["σου",711945,133],["μιμνῄσκου",708923,253],["τὰ",709436,41],["ἔσχατά",705519,68],["σου",711945,133],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["οὐχ",709805,28],["ἁμαρτήσεις",700773,166]],"Whatsoever thou takest in hand, remember the end, and thou shalt never do amiss."]]