[["1",[["κριτὴς",707910,4],["σοφὸς",711985,14],["παιδεύσει",709926,127],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἡγεμονία",705927,12],["συνετοῦ",712464,116],["τεταγμένη",712730,203],["ἔσται",704093,93]],"A wise judge will instruct his people; and the government of a prudent man is well ordered."],["2",[["κατὰ",707200,0],["τὸν",709436,5],["κριτὴν",707910,6],["τοῦ",709436,35],["λαοῦ",708094,18],["οὕτως",709859,28],["καὶ",707031,28],["οἱ",709436,136],["λειτουργοὶ",708137,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["κατὰ",707200,0],["τὸν",709436,5],["ἡγούμενον",705931,212],["τῆς",709436,16],["πόλεως",710612,17],["πάντες",710177,138],["οἱ",709436,136],["κατοικοῦντες",707534,146],["αὐτήν",702165,104]],"As the judge of the people is himself, so are his officers; and what manner of man the ruler of the city is, such are all they that dwell therein."],["3",[["βασιλεὺς",702580,4],["ἀπαίδευτος",701328,14],["ἀπολεῖ",701513,127],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["πόλις",710612,12],["οἰκισθήσεται",709507,134],["ἐν",704639,0],["συνέσει",712460,1],["δυναστῶν",703844,81]],"An unwise king destroyeth his people; but through the prudence of them which are in authority the city shall be inhabited."],["4",[["ἐν",704639,0],["χειρὶ",713787,1],["κυρίου",707996,18],["ἡ",709436,10],["ἐξουσία",704974,12],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["τὸν",709436,5],["χρήσιμον",713953,27],["ἐγερεῖ",703949,127],["εἰς",704105,0],["καιρὸν",707047,6],["ἐπ᾿",705080,0],["αὐτῆς",702165,86]],"The power of the earth is in the hand of the Lord, and in due time he will set over it one that is profitable."],["5",[["ἐν",704639,0],["χειρὶ",713787,1],["κυρίου",707996,18],["εὐοδία",705652,12],["ἀνδρός",701150,18],["καὶ",707031,7],["προσώπῳ",710986,54],["γραμματέως",703185,18],["ἐπιθήσει",705304,127],["δόξαν",703791,9],["αὐτοῦ",702165,102]],"In the hand of God is the prosperity of man: and upon the person of the scribe shall he lay his honour."],["6",[["ἐπὶ",705080,0],["παντὶ",710177,97],["ἀδικήματι",700270,54],["μὴ",708851,28],["μηνιάσῃς",708877,175],["τῷ",709436,113],["πλησίον",710547,28],["καὶ",707031,7],["μὴ",708851,28],["πρᾶσσε",710721,240],["μηδὲν",708857,46],["ἐν",704639,0],["ἔργοις",705396,96],["ὕβρεως",713051,17]],"Bear not hatred to thy neighbour for every wrong; and do nothing at all by injurious practices."],["7",[["μισητὴ",708936,29],["ἔναντι",704653,0],["κυρίου",707996,18],["καὶ",707031,7],["ἀνθρώπων",701163,81],["ὑπερηφανία",713138,12],["καὶ",707031,7],["ἐξ",704132,0],["ἀμφοτέρων",700892,169],["πλημμελὴς",710536,29],["ἡ",709436,10],["ἀδικία",700271,12]],"Pride is hateful before God and man: and by both doth one commit iniquity."],["8",[["βασιλεία",702577,12],["ἀπὸ",701425,0],["ἔθνους",704068,21],["εἰς",704105,0],["ἔθνος",704068,25],["μετάγεται",708789,117],["διὰ",703417,0],["ἀδικίας",700271,39],["καὶ",707031,7],["ὕβρεις",713051,39],["καὶ",707031,7],["χρήματα",713948,42]],"Because of unrighteous dealings, injuries, and riches got by deceit, the kingdom is translated from one people to another."],["9",[["τί",712867,126],["ὑπερηφανεύεται",713136,117],["γῆ",703083,12],["καὶ",707031,7],["σποδός",712022,4],["ὅτι",709803,7],["ἐν",704639,0],["ζωῇ",705910,1],["ἔρριψα",711267,155],["τὰ",709436,41],["ἐνδόσθια",704696,42],["αὐτοῦ",702165,102]],"Why is earth and ashes proud? There is not a more wicked thing than a covetous man: for such an one setteth his own soul to sale; because while he liveth he casteth away his bowels."],["10",[["μακρὸν",708421,46],["ἀρρώστημα",701812,25],["σκώπτει",711907,91],["ἰατρός",706459,4],["καὶ",707031,7],["βασιλεὺς",702580,4],["σήμερον",711751,28],["καὶ",707031,7],["αὔριον",702149,28],["τελευτήσει",712781,127]],"The physician cutteth off a long disease: and he that is to day a king to morrow shall die."],["11",[["ἐν",704639,0],["γὰρ",702963,11],["τῷ",709436,53],["ἀποθανεῖν",701461,106],["ἄνθρωπον",701163,6],["κληρονομήσει",707724,127],["ἑρπετὰ",705441,42],["καὶ",707031,7],["θηρία",706252,42],["καὶ",707031,7],["σκώληκας",711905,57]],"For when a man is dead, he shall inherit creeping things, beasts, and worms."],["12",[["ἀρχὴ",701836,12],["ὑπερηφανίας",713138,17],["ἀνθρώπου",701163,18],["ἀφίστασθαι",702214,110],["ἀπὸ",701425,0],["κυρίου",707996,18],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,35],["ποιήσαντος",710582,500],["αὐτὸν",702165,85],["ἀπέστη",702214,2],["ἡ",709436,10],["καρδία",707141,12],["αὐτοῦ",702165,102]],"The beginning of pride is when one departeth from God, and his heart is turned away from his Maker."],["13",[["ὅτι",709803,7],["ἀρχὴ",701836,12],["ὑπερηφανίας",713138,17],["ἁμαρτία",700775,12],["καὶ",707031,7],["ὁ",709436,3],["κρατῶν",707879,72],["αὐτῆς",702165,86],["ἐξομβρήσει",704957,127],["βδέλυγμα",702604,25],["διὰ",703417,0],["τοῦτο",709858,129],["παρεδόξασεν",710015,2],["κύριος",707996,4],["τὰς",709436,38],["ἐπαγωγὰς",704995,39],["καὶ",707031,7],["κατέστρεψεν",707444,2],["εἰς",704105,0],["τέλος",712787,25],["αὐτούς",702165,62]],"For pride is the beginning of sin, and he that hath it shall pour out abomination: and therefore the Lord brought upon them strange calamities, and overthrew them utterly."],["14",[["θρόνους",706315,57],["ἀρχόντων",701862,81],["καθεῖλεν",706982,2],["ὁ",709436,3],["κύριος",707996,4],["καὶ",707031,7],["ἐκάθισεν",707006,2],["πραεῖς",710725,60],["ἀντ᾿",701227,0],["αὐτῶν",702165,40]],"The Lord hath cast down the thrones of proud princes, and set up the meek in their stead."],["15",[["ῥίζας",711260,39],["ἐθνῶν",704068,44],["ἐξέτιλεν",704332,2],["ὁ",709436,3],["κύριος",707996,4],["καὶ",707031,7],["ἐφύτευσεν",713636,2],["ταπεινοὺς",712714,60],["ἀντ᾿",701227,0],["αὐτῶν",702165,40]],"The Lord hath plucked up the roots of the proud nations, and planted the lowly in their place."],["16",[["χώρας",714011,39],["ἐθνῶν",704068,44],["κατέστρεψεν",707444,2],["ὁ",709436,3],["κύριος",707996,4],["καὶ",707031,7],["ἀπώλεσεν",701513,2],["αὐτὰς",702165,231],["ἕως",705792,0],["θεμελίων",706181,44],["γῆς",703083,17]],"The Lord overthrew countries of the heathen, and destroyed them to the foundations of the earth."],["17",[["ἐξῆρεν",704839,2],["ἐξ",704132,0],["αὐτῶν",702165,40],["καὶ",707031,7],["ἀπώλεσεν",701513,2],["αὐτοὺς",702165,62],["καὶ",707031,7],["κατέπαυσεν",707365,2],["ἀπὸ",701425,0],["γῆς",703083,17],["τὸ",709436,24],["μνημόσυνον",708966,25],["αὐτῶν",702165,40]],"He took some of them away, and destroyed them, and hath made their memorial to cease from the earth."],["18",[["οὐκ",709805,28],["ἔκτισται",707938,187],["ἀνθρώποις",701163,148],["ὑπερηφανία",713138,12],["οὐδὲ",709816,7],["ὀργὴ",709728,12],["θυμοῦ",706334,18],["γεννήμασιν",703052,96],["γυναικῶν",703209,65]],"Pride was not made for men, nor furious anger for them that are born of a woman."],["19",[["σπέρμα",712008,15],["ἔντιμον",704798,46],["ποῖον",710599,26],["σπέρμα",712008,15],["ἀνθρώπου",701163,18],["σπέρμα",712008,15],["ἔντιμον",704798,46],["ποῖον",710599,26],["οἱ",709436,136],["φοβούμενοι",713532,348],["τὸν",709436,5],["κύριον",707996,6],["σπέρμα",712008,15],["ἄτιμον",702095,46],["ποῖον",710599,26],["σπέρμα",712008,15],["ἀνθρώπου",701163,18],["σπέρμα",712008,15],["ἄτιμον",702095,46],["ποῖον",710599,26],["οἱ",709436,136],["παραβαίνοντες",709996,146],["ἐντολάς",704802,39]],"They that fear the Lord are a sure seed, and they that love him an honourable plant: they that regard not the law are a dishonourable seed; they that transgress the commandments are a deceivable seed."],["20",[["ἐν",704639,0],["μέσῳ",708768,97],["ἀδελφῶν",700249,81],["ὁ",709436,3],["ἡγούμενος",705931,122],["αὐτῶν",702165,40],["ἔντιμος",704798,14],["καὶ",707031,7],["οἱ",709436,136],["φοβούμενοι",713532,348],["κύριον",707996,6],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["αὐτοῦ",702165,102]],"Among brethren he that is chief is honourable; so are they that fear the Lord in his eyes."],["22",[["πλούσιος",710560,14],["καὶ",707031,7],["ἔνδοξος",704694,14],["καὶ",707031,7],["πτωχός",711076,4],["τὸ",709436,34],["καύχημα",707570,15],["αὐτῶν",702165,40],["φόβος",713534,4],["κυρίου",707996,18]],"Whether he be rich, noble or poor, their glory is the fear of the Lord."],["23",[["οὐ",709805,28],["δίκαιον",703694,26],["ἀτιμάσαι",702092,106],["πτωχὸν",711076,6],["συνετόν",712464,27],["καὶ",707031,7],["οὐ",709805,28],["καθήκει",706998,91],["δοξάσαι",703792,106],["ἄνδρα",701150,6],["ἁμαρτωλόν",700776,27]],"It is not meet to despise the poor man that hath understanding; neither is it convenient to magnify a sinful man."],["24",[["μεγιστὰν",708657,4],["καὶ",707031,7],["κριτὴς",707910,4],["καὶ",707031,7],["δυνάστης",703844,4],["δοξασθήσεται",703792,134],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["αὐτῶν",702165,40],["τις",712866,158],["μείζων",708682,14],["τοῦ",709436,35],["φοβουμένου",713532,262],["τὸν",709436,5],["κύριον",707996,6]],"Great men, and judges, and potentates, shall be honoured; yet is there none of them greater than he that feareth the Lord."],["25",[["οἰκέτῃ",709496,114],["σοφῷ",711985,30],["ἐλεύθεροι",704428,138],["λειτουργήσουσιν",708132,218],["καὶ",707031,7],["ἀνὴρ",701150,4],["ἐπιστήμων",705268,14],["οὐ",709805,28],["γογγύσει",703144,127]],"Unto the servant that is wise shall they that are free do service: and he that hath knowledge will not grudge when he is reformed."],["26",[["μὴ",708851,28],["σοφίζου",711982,253],["ποιῆσαι",710582,106],["τὸ",709436,24],["ἔργον",705396,25],["σου",711945,133],["καὶ",707031,7],["μὴ",708851,28],["δοξάζου",703792,253],["ἐν",704639,0],["καιρῷ",707047,114],["στενοχωρίας",712071,17],["σου",711945,133]],"Be not overwise in doing thy business; and boast not thyself in the time of thy distress."],["27",[["κρείσσων",707891,14],["ἐργαζόμενος",705383,122],["καὶ",707031,7],["περισσεύων",710386,72],["ἐν",704639,0],["πᾶσιν",710177,94],["ἢ",705924,7],["περιπατῶν",710362,72],["δοξαζόμενος",703792,122],["καὶ",707031,7],["ἀπορῶν",701559,72],["ἄρτων",701829,81]],"Better is he that laboureth, and aboundeth in all things, than he that boasteth himself, and wanteth bread."],["28",[["τέκνον",712761,297],["ἐν",704639,0],["πραΰτητι",710726,1],["δόξασον",703792,176],["τὴν",709436,8],["ψυχήν",714070,9],["σου",711945,133],["καὶ",707031,7],["δὸς",703654,176],["αὐτῇ",702165,105],["τιμὴν",712856,9],["κατὰ",707200,0],["τὴν",709436,8],["ἀξίαν",701305,9],["αὐτῆς",702165,86]],"My son, glorify thy soul in meekness, and give it honour according to the dignity thereof."],["29",[["τὸν",709436,5],["ἁμαρτάνοντα",700773,183],["εἰς",704105,0],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["τίς",712867,158],["δικαιώσει",703696,127],["καὶ",707031,7],["τίς",712867,158],["δοξάσει",703792,127],["τὸν",709436,5],["ἀτιμάζοντα",702092,183],["τὴν",709436,8],["ζωὴν",705910,9],["αὐτοῦ",702165,102]],"Who will justify him that sinneth against his own soul? and who will honour him that dishonoureth his own life?"],["30",[["πτωχὸς",711076,4],["δοξάζεται",703792,117],["δι᾿",703417,0],["ἐπιστήμην",705267,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["πλούσιος",710560,14],["δοξάζεται",703792,117],["διὰ",703417,0],["τὸν",709436,5],["πλοῦτον",710563,6],["αὐτοῦ",702165,102]],"The poor man is honoured for his skill, and the rich man is honoured for his riches."],["31",[["ὁ",709436,3],["δεδοξασμένος",703792,419],["ἐν",704639,0],["πτωχείᾳ",711073,1],["καὶ",707031,7],["ἐν",704639,0],["πλούτῳ",710563,114],["ποσαχῶς",710689,28],["καὶ",707031,7],["ὁ",709436,3],["ἄδοξος",700286,14],["ἐν",704639,0],["πλούτῳ",710563,114],["καὶ",707031,7],["ἐν",704639,0],["πτωχείᾳ",711073,1],["ποσαχῶς",710689,28]],"He that is honoured in poverty, how much more in riches? and he that is dishonourable in riches, how much more in poverty?"]]