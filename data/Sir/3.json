[["1",[["ἐμοῦ",704580,133],["τοῦ",709436,35],["πατρὸς",710189,18],["ἀκούσατε",700587,74],["τέκνα",712761,589],["καὶ",707031,7],["οὕτως",709859,28],["ποιήσατε",710582,74],["ἵνα",706747,7],["σωθῆτε",712627,394]],"Hear me your father, O children, and do thereafter, that ye may be safe."],["2",[["ὁ",709436,3],["γὰρ",702963,11],["κύριος",707996,4],["ἐδόξασεν",703792,2],["πατέρα",710189,6],["ἐπὶ",705080,0],["τέκνοις",712761,96],["καὶ",707031,7],["κρίσιν",707908,9],["μητρὸς",708892,17],["ἐστερέωσεν",712076,2],["ἐφ᾿",705080,0],["υἱοῖς",713075,148]],"For the Lord hath given the father honour over the children, and hath confirmed the authority of the mother over the sons."],["3",[["ὁ",709436,3],["τιμῶν",712855,72],["πατέρα",710189,6],["ἐξιλάσκεται",704932,117],["ἁμαρτίας",700775,39]],"Whoso honoureth his father maketh an atonement for his sins:"],["4",[["καὶ",707031,7],["ὡς",714148,7],["ὁ",709436,3],["ἀποθησαυρίζων",701459,72],["ὁ",709436,3],["δοξάζων",703792,72],["μητέρα",708892,9],["αὐτοῦ",702165,102]],"and he that honoureth his mother is as one that layeth up treasure."],["5",[["ὁ",709436,3],["τιμῶν",712855,72],["πατέρα",710189,6],["εὐφρανθήσεται",705715,134],["ὑπὸ",713184,0],["τέκνων",712761,44],["καὶ",707031,7],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["προσευχῆς",710892,17],["αὐτοῦ",702165,102],["εἰσακουσθήσεται",704108,134]],"Whoso honoureth his father shall have joy of [his own] children; and when he maketh his prayer, he shall be heard."],["6",[["ὁ",709436,3],["δοξάζων",703792,72],["πατέρα",710189,6],["μακροημερεύσει",708415,127],["καὶ",707031,7],["ὁ",709436,3],["εἰσακούων",704108,72],["κυρίου",707996,18],["ἀναπαύσει",701027,127],["μητέρα",708892,9],["αὐτοῦ",702165,102]],"He that honoureth his father shall have a long life; and he that is obedient unto the Lord shall be a comfort to his mother,"],["7",[["καὶ",707031,7],["ὡς",714148,7],["δεσπόταις",703379,148],["δουλεύσει",703814,127],["ἐν",704639,0],["τοῖς",709436,147],["γεννήσασιν",703051,456],["αὐτόν",702165,85]],"and will do service unto his parents, as to his masters."],["8",[["ἐν",704639,0],["ἔργῳ",705396,54],["καὶ",707031,7],["λόγῳ",708236,114],["τίμα",712855,240],["τὸν",709436,5],["πατέρα",710189,6],["σου",711945,133],["ἵνα",706747,7],["ἐπέλθῃ",705068,172],["σοι",711925,159],["εὐλογία",705633,12],["παρ᾿",709995,0],["αὐτοῦ",702165,102]],"Honour thy father and mother both in word and deed, that a blessing may come upon thee from them."],["9",[["εὐλογία",705633,12],["γὰρ",702963,11],["πατρὸς",710189,18],["στηρίζει",712098,91],["οἴκους",709516,57],["τέκνων",712761,44],["κατάρα",707395,12],["δὲ",703303,11],["μητρὸς",708892,17],["ἐκριζοῖ",704303,91],["θεμέλια",706181,68]],"For the blessing of the father establisheth the houses of children; but the curse of the mother rooteth out foundations."],["10",[["μὴ",708851,28],["δοξάζου",703792,253],["ἐν",704639,0],["ἀτιμίᾳ",702094,1],["πατρός",710189,18],["σου",711945,133],["οὐ",709805,28],["γάρ",702963,11],["ἐστίν",704093,91],["σοι",711925,159],["δόξα",703791,12],["πατρὸς",710189,18],["ἀτιμία",702094,12]],"Glory not in the dishonour of thy father; for thy father's dishonour is no glory unto thee."],["11",[["ἡ",709436,10],["γὰρ",702963,11],["δόξα",703791,12],["ἀνθρώπου",701163,18],["ἐκ",704132,0],["τιμῆς",712856,17],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὄνειδος",709658,25],["τέκνοις",712761,96],["μήτηρ",708892,12],["ἐν",704639,0],["ἀδοξίᾳ",700285,1]],"For the glory of a man is from the honour of his father; and a mother in dishonour is a reproach to the children."],["12",[["τέκνον",712761,297],["ἀντιλαβοῦ",701243,300],["ἐν",704639,0],["γήρᾳ",703089,54],["πατρός",710189,18],["σου",711945,133],["καὶ",707031,7],["μὴ",708851,28],["λυπήσῃς",708272,175],["αὐτὸν",702165,85],["ἐν",704639,0],["τῇ",709436,100],["ζωῇ",705910,1],["αὐτοῦ",702165,102]],"My son, help thy father in his age, and grieve him not as long as he liveth."],["13",[["κἂν",707120,459],["ἀπολείπῃ",701508,204],["σύνεσιν",712460,9],["συγγνώμην",712188,9],["ἔχε",705785,240],["καὶ",707031,7],["μὴ",708851,28],["ἀτιμάσῃς",702092,175],["αὐτὸν",702165,85],["ἐν",704639,0],["πάσῃ",710177,101],["ἰσχύι",706858,1],["σου",711945,133]],"And if his understanding fail, have patience with him; and despise him not when thou art in thy full strength."],["14",[["ἐλεημοσύνη",704421,12],["γὰρ",702963,11],["πατρὸς",710189,18],["οὐκ",709805,28],["ἐπιλησθήσεται",705187,134],["καὶ",707031,7],["ἀντὶ",701227,0],["ἁμαρτιῶν",700775,65],["προσανοικοδομηθήσεταί",710857,134],["σοι",711925,159]],"For the relieving of thy father shall not be forgotten: and instead of sins it shall be added to build thee up."],["15",[["ἐν",704639,0],["ἡμέρᾳ",705984,1],["θλίψεώς",706276,17],["σου",711945,133],["ἀναμνησθήσεταί",701002,134],["σου",711945,133],["ὡς",714148,7],["εὐδία",705564,12],["ἐπὶ",705080,0],["παγετῷ",709908,114],["οὕτως",709859,28],["ἀναλυθήσονταί",700995,144],["σου",711945,133],["αἱ",709436,190],["ἁμαρτίαι",700775,191]],"In the day of thine affliction it shall be remembered; thy sins also shall melt away, as the ice in the fair warm weather."],["16",[["ὡς",714148,7],["βλάσφημος",702739,14],["ὁ",709436,3],["ἐγκαταλιπὼν",703967,182],["πατέρα",710189,6],["καὶ",707031,7],["κεκατηραμένος",707396,419],["ὑπὸ",713184,0],["κυρίου",707996,18],["ὁ",709436,3],["παροργίζων",710167,72],["μητέρα",708892,9],["αὐτοῦ",702165,102]],"He that forsaketh his father is as a blasphemer; and he that angereth his mother is cursed of God."],["17",[["τέκνον",712761,15],["ἐν",704639,0],["πραΰτητι",710726,1],["τὰ",709436,41],["ἔργα",705396,42],["σου",711945,133],["διέξαγε",703664,240],["καὶ",707031,7],["ὑπὸ",713184,0],["ἀνθρώπου",701163,18],["δεκτοῦ",703348,116],["ἀγαπηθήσῃ",700120,364]],"My son, go on with thy business in meekness; so shalt thou be beloved of him that is approved."],["18",[["ὅσῳ",709788,30],["μέγας",708653,14],["εἶ",704093,154],["τοσούτῳ",712907,30],["ταπείνου",712714,116],["σεαυτόν",711599,85],["καὶ",707031,7],["ἔναντι",704653,0],["κυρίου",707996,18],["εὑρήσεις",705676,166],["χάριν",713735,9]],"The greater thou art, the more humble thyself, and thou shalt find favour before the Lord."],["20",[["ὅτι",709803,7],["μεγάλη",708653,29],["ἡ",709436,10],["δυναστεία",703841,12],["τοῦ",709436,35],["κυρίου",707996,18],["καὶ",707031,7],["ὑπὸ",713184,0],["τῶν",709436,80],["ταπεινῶν",712714,169],["δοξάζεται",703792,117]],"For the power of the Lord is great, and he is honoured of the lowly."],["21",[["χαλεπώτερά",713682,484],["σου",711945,133],["μὴ",708851,28],["ζήτει",705879,240],["καὶ",707031,7],["ἰσχυρότερά",706855,484],["σου",711945,133],["μὴ",708851,28],["ἐξέταζε",704911,240]],"Seek not out the things that are too hard for thee, neither search the things that are above thy strength."],["22",[["ἃ",709781,371],["προσετάγη",710962,37],["σοι",711925,159],["ταῦτα",709858,71],["διανοοῦ",703528,253],["οὐ",709805,28],["γάρ",702963,11],["ἐστίν",704093,91],["σοι",711925,159],["χρεία",713938,12],["τῶν",709436,43],["κρυπτῶν",707922,83]],"But what is commanded thee, think thereupon [with reverence]; for it is not needful for thee [to see with thine eyes] the things that are in secret."],["23",[["ἐν",704639,0],["τοῖς",709436,95],["περισσοῖς",710387,94],["τῶν",709436,43],["ἔργων",705396,44],["σου",711945,133],["μὴ",708851,28],["περιεργάζου",710312,253],["πλείονα",710514,27],["γὰρ",702963,11],["συνέσεως",712460,17],["ἀνθρώπων",701163,81],["ὑπεδείχθη",713192,37],["σοι",711925,159]],"Be not curious in unnecessary matters; for more things are shewed unto thee than men understand."],["24",[["πολλοὺς",710646,60],["γὰρ",702963,11],["ἐπλάνησεν",710495,2],["ἡ",709436,10],["ὑπόλημψις",713213,12],["αὐτῶν",702165,40],["καὶ",707031,7],["ὑπόνοια",713230,12],["πονηρὰ",710660,29],["ὠλίσθησεν",709579,2],["διανοίας",703531,39],["αὐτῶν",702165,40]],"For many are deceived by their own vain opinion; and an evil suspicion hath overthrown their judgment."],["26",[["καρδία",707141,12],["σκληρὰ",711861,29],["κακωθήσεται",707073,134],["ἐπ᾿",705080,0],["ἐσχάτων",705519,83],["καὶ",707031,7],["ὁ",709436,3],["ἀγαπῶν",700120,72],["κίνδυνον",707678,6],["ἐν",704639,0],["αὐτῷ",702165,50],["ἀπολεῖται",701513,93]],"A stubborn heart shall fare evil at the last; and he that loveth danger shall perish therein."],["27",[["καρδία",707141,12],["σκληρὰ",711861,29],["βαρυνθήσεται",702553,134],["πόνοις",710661,148],["καὶ",707031,7],["ὁ",709436,3],["ἁμαρτωλὸς",700776,14],["προσθήσει",710965,127],["ἁμαρτίαν",700775,9],["ἐφ᾿",705080,0],["ἁμαρτίαις",700775,76]],"An obstinate heart shall be laden with sorrows; and the wicked man shall heap sin upon sin."],["28",[["ἐπαγωγῇ",704995,1],["ὑπερηφάνου",713139,116],["οὐκ",709805,28],["ἔστιν",704093,91],["ἴασις",706444,12],["φυτὸν",713637,15],["γὰρ",702963,11],["πονηρίας",710659,17],["ἐρρίζωκεν",711261,171],["ἐν",704639,0],["αὐτῷ",702165,50]],"In the punishment of the proud there is no remedy; for the plant of wickedness hath taken root in him."],["29",[["καρδία",707141,12],["συνετοῦ",712464,116],["διανοηθήσεται",703528,134],["παραβολήν",710003,9],["καὶ",707031,7],["οὖς",709852,15],["ἀκροατοῦ",700604,18],["ἐπιθυμία",705147,12],["σοφοῦ",711985,116]],"The heart of the prudent will understand a parable; and an attentive ear is the desire of a wise man."],["30",[["πῦρ",711088,25],["φλογιζόμενον",713521,214],["ἀποσβέσει",701567,127],["ὕδωρ",713071,15],["καὶ",707031,7],["ἐλεημοσύνη",704421,12],["ἐξιλάσεται",704932,93],["ἁμαρτίας",700775,39]],"Water will quench a flaming fire; and alms maketh an atonement for sins."],["31",[["ὁ",709436,3],["ἀνταποδιδοὺς",701215,72],["χάριτας",713735,39],["μέμνηται",708923,187],["εἰς",704105,0],["τὰ",709436,41],["μετὰ",708780,0],["ταῦτα",709858,71],["καὶ",707031,7],["ἐν",704639,0],["καιρῷ",707047,114],["πτώσεως",711072,17],["αὐτοῦ",702165,102],["εὑρήσει",705676,127],["στήριγμα",712097,25]],"And he that requiteth good turns is mindful of that which may come hereafter; and when he falleth, he shall find a stay."]]