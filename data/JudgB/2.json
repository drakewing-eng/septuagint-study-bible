νεὰ",703037,12],["ἐκείνη",704183,107],["προσετέθησαν",710965,99],["πρὸς",710844,0],["τοὺς",709436,58],["πατέρας",710189,57],["αὐτῶν",702165,40],["καὶ",707031,7],["ἀνέστη",701173,2],["γενεὰ",703037,12],["ἑτέρα",705535,29],["μετ᾿",708780,0],["αὐτούς",702165,62],["οἳ",709781,250],["οὐκ",709805,28],["ἔγνωσαν",703105,150],["τὸν",709436,5],["κύριον",707996,6],["καί",707031,7],["γε",702985,11],["τὸ",709436,24],["ἔργον",705396,25],["ὃ",709781,128],["ἐποίησεν",710582,2],["ἐν",704639,0],["τῷ",709436,113],["Ισραηλ",706839,114]],"And all that generation were laid to their fathers: and another generation rose up after them, who knew not the Lord, nor yet the work which he wrought in Israel."],["11",[["καὶ",707031,7],["ἐποίησαν",710582,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["τὸ",709436,24],["πονηρὸν",710660,46],["ἐνώπιον",704823,0],["κυρίου",707996,18],["καὶ",707031,7],["ἐλάτρευσαν",708108,150],["τοῖς",709436,147],["Βααλιμ",702342,148]],"And the children of Israel wrought evil before the Lord, and served Baalim."],["12",[["καὶ",707031,7],["ἐγκατέλιπον",703967,150],["τὸν",709436,5],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["τῶν",709436,80],["πατέρων",710189,81],["αὐτῶν",702165,40],["τὸν",709436,5],["ἐξαγαγόντα",704834,365],["αὐτοὺς",702165,62],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["ὀπίσω",709697,0],["θεῶν",706192,81],["ἑτέρων",705535,169],["ἀπὸ",701425,0],["τῶν",709436,80],["θεῶν",706192,81],["τῶν",709436,43],["ἐθνῶν",704068,44],["τῶν",709436,43],["περικύκλῳ",710340,28],["αὐτῶν",702165,40],["καὶ",707031,7],["προσεκύνησαν",710925,150],["αὐτοῖς",702165,151],["καὶ",707031,7],["παρώργισαν",710167,150],["τὸν",709436,5],["κύριον",707996,6]],"And they forsook the Lord God of their fathers, who brought them out of the land of Egypt, and walked after other gods, of the gods of the nations round about them; and they worshipped them."],["13",[["καὶ",707031,7],["ἐγκατέλιπον",703967,150],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐλάτρευσαν",708108,150],["τῷ",709436,113],["Βααλ",702333,114],["καὶ",707031,7],["ταῖς",709436,75],["Ἀστάρταις",702008,76]],"And they provoked the Lord, and forsook him, and served Baal and the Astartes."],["14",[["καὶ",707031,7],["ὠργίσθη",709729,37],["θυμῷ",706334,114],["κύριος",707996,4],["ἐν",704639,0],["τῷ",709436,113],["Ισραηλ",706839,114],["καὶ",707031,7],["παρέδωκεν",710014,2],["αὐτοὺς",702165,62],["εἰς",704105,0],["χεῖρας",713787,39],["προνομευόντων",710826,170],["καὶ",707031,7],["κατεπρονόμευσαν",707391,150],["αὐτούς",702165,62],["καὶ",707031,7],["ἀπέδοτο",701449,23],["αὐτοὺς",702165,62],["ἐν",704639,0],["χερσὶ",713787,76],["τῶν",709436,80],["ἐχθρῶν",705779,81],["αὐτῶν",702165,40],["κυκλόθεν",707956,28],["καὶ",707031,7],["οὐκ",709805,28],["ἠδυνήθησαν",703838,99],["ἔτι",705538,28],["ἀντιστῆναι",701154,106],["κατὰ",707200,0],["πρόσωπον",710986,25],["τῶν",709436,80],["ἐχθρῶν",705779,81],["αὐτῶν",702165,40]],"And the Lord was very angry with Israel; and he gave them into the hands of the spoilers, and they spoiled them; and he sold them into the hands of their enemies round about, and they could not any longer resist their enemies,"],["15",[["ἐν",704639,0],["πᾶσιν",710177,230],["οἷς",709781,311],["ἐξεπορεύοντο",704293,139],["καὶ",707031,7],["χεὶρ",713787,12],["κυρίου",707996,18],["ἦν",704093,13],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["εἰς",704105,0],["κακά",707066,68],["καθὼς",707030,28],["ἐλάλησεν",708071,2],["κύριος",707996,4],["καὶ",707031,7],["καθὼς",707030,28],["ὤμοσεν",709620,2],["κύριος",707996,4],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἐξέθλιψεν",704199,2],["αὐτοὺς",702165,62],["σφόδρα",712586,28]],"among whomsoever they went; and the hand of the Lord was against them for evil, as the Lord spoke, and as the Lord sware to them; and he greatly afflicted them."],["16",[["καὶ",707031,7],["ἤγειρεν",703949,13],["κύριος",707996,4],["κριτάς",707910,57],["καὶ",707031,7],["ἔσωσεν",712627,2],["αὐτοὺς",702165,62],["κύριος",707996,4],["ἐκ",704132,0],["χειρὸς",713787,17],["τῶν",709436,80],["προνομευόντων",710826,170],["αὐτούς",702165,62]],"And the Lord raised up judges, and the Lord saved them out of the hands of them that spoiled them: and yet they hearkened not to the judges,"],["17",[["καί",707031,7],["γε",702985,11],["τῶν",709436,80],["κριτῶν",707910,81],["οὐχ",709805,28],["ὑπήκουσαν",713096,150],["ὅτι",709803,7],["ἐξεπόρνευσαν",704295,150],["ὀπίσω",709697,0],["θεῶν",706192,81],["ἑτέρων",705535,169],["καὶ",707031,7],["προσεκύνησαν",710925,150],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἐξέκλιναν",704220,150],["ταχὺ",712748,46],["ἐκ",704132,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["ἧς",709781,167],["ἐπορεύθησαν",710667,99],["οἱ",709436,136],["πατέρες",710189,52],["αὐτῶν",702165,40],["τοῦ",709436,20],["εἰσακούειν",704108,55],["τῶν",709436,80],["λόγων",708236,81],["κυρίου",707996,18],["οὐκ",709805,28],["ἐποίησαν",710582,150],["οὕτως",709859,28]],"for they went a whoring after other gods, and worshipped them; and they turned quickly out of the way in which their fathers walked to hearken to the words of the Lord; they did not so."],["18",[["καὶ",707031,7],["ὅτι",709803,7],["ἤγειρεν",703949,13],["κύριος",707996,4],["κριτὰς",707910,57],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἦν",704093,13],["κύριος",707996,4],["μετὰ",708780,0],["τοῦ",709436,35],["κριτοῦ",707910,18],["καὶ",707031,7],["ἔσωσεν",712627,2],["αὐτοὺς",702165,62],["ἐκ",704132,0],["χειρὸς",713787,17],["ἐχθρῶν",705779,81],["αὐτῶν",702165,40],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["τοῦ",709436,35],["κριτοῦ",707910,18],["ὅτι",709803,7],["παρεκλήθη",710039,37],["κύριος",707996,4],["ἀπὸ",701425,0],["τοῦ",709436,35],["στεναγμοῦ",712065,18],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["προσώπου",710986,21],["τῶν",709436,80],["πολιορκούντων",710608,170],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἐκθλιβόντων",704199,170],["αὐτούς",702165,62]],"And because the Lord raised them up judges, so the Lord was with the judge, and saved them out of the hand of their enemies all the days of the judge; for the Lord was moved at their groaning by reason of them that besieged them and afflicted them."],["19",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὡς",714148,7],["ἀπέθνῃσκεν",701461,13],["ὁ",709436,3],["κριτής",707910,4],["καὶ",707031,7],["ἀπέστρεψαν",701598,150],["καὶ",707031,7],["πάλιν",709942,28],["διέφθειραν",703624,150],["ὑπὲρ",713111,0],["τοὺς",709436,58],["πατέρας",710189,57],["αὐτῶν",702165,40],["πορεύεσθαι",710667,110],["ὀπίσω",709697,0],["θεῶν",706192,81],["ἑτέρων",705535,169],["λατρεύειν",708108,55],["αὐτοῖς",702165,151],["καὶ",707031,7],["προσκυνεῖν",710925,55],["αὐτοῖς",702165,151],["οὐκ",709805,28],["ἀπέρριψαν",701563,150],["τὰ",709436,41],["ἐπιτηδεύματα",705301,42],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτῶν",702165,40],["τὰς",709436,38],["σκληράς",711861,119]],"And it came to pass when the judge died, that they went back, and again corrupted [themselves] worse than their fathers to go after other gods to serve them and to worship them: they abandoned not their devices nor their stubborn ways."],["20",[["καὶ",707031,7],["ὠργίσθη",709729,37],["θυμῷ",706334,114],["κύριος",707996,4],["ἐν",704639,0],["τῷ",709436,113],["Ισραηλ",706839,114],["καὶ",707031,7],["εἶπεν",705373,2],["ἀνθ᾿",701227,0],["ὧν",709781,252],["ὅσα",709788,68],["ἐγκατέλιπον",703967,150],["τὸ",709436,34],["ἔθνος",704068,15],["τοῦτο",709858,132],["τὴν",709436,8],["διαθήκην",703456,9],["μου",709032,133],["ἣν",709781,131],["ἐνετειλάμην",704791,161],["τοῖς",709436,147],["πατράσιν",710189,148],["αὐτῶν",702165,40],["καὶ",707031,7],["οὐκ",709805,28],["εἰσήκουσαν",704108,150],["τῆς",709436,16],["φωνῆς",713640,17],["μου",709032,133]],"And the Lord was very angry with Israel, and said, Forasmuch as this nation has forsaken my covenant which I commanded their fathers, and has not hearkened to my voice,"],["21",[["καί",707031,7],["γε",702985,11],["ἐγὼ",704018,164],["οὐ",709805,28],["προσθήσω",710965,165],["τοῦ",709436,20],["ἐξᾶραι",704839,106],["ἄνδρα",701150,6],["ἐκ",704132,0],["προσώπου",710986,21],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["τῶν",709436,43],["ἐθνῶν",704068,44],["ὧν",709781,252],["κατέλιπεν",707305,2],["Ἰησοῦς",706701,4],["υἱὸς",713075,4],["Ναυη",709206,18],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["καὶ",707031,7],["ἀφῆκεν",702211,2]],"therefore I will not any more cast out a man of the nations from before their face, which Joshua the son of Naue left in the land. And [the Lord] left [them],"],["22",[["τοῦ",709436,20],["πειράσαι",710225,106],["ἐν",704639,0],["αὐτοῖς",702165,151],["τὸν",709436,5],["Ισραηλ",706839,6],["εἰ",704071,11],["φυλάσσονται",713619,269],["τὴν",709436,8],["ὁδὸν",709458,9],["κυρίου",707996,18],["πορεύεσθαι",710667,110],["ἐν",704639,0],["αὐτῇ",702165,105],["ὃν",709781,112],["τρόπον",712980,6],["ἐφύλαξαν",713619,150],["οἱ",709436,136],["πατέρες",710189,52],["αὐτῶν",702165,40],["ἢ",705924,7],["οὔ",709805,28]],"to prove Israel with them, whether they would keep the way of the Lord, to walk in it, as their fathers kept it, or no."],["23",[["καὶ",707031,7],["ἀφῆκεν",702211,2],["κύριος",707996,4],["τὰ",709436,41],["ἔθνη",704068,42],["ταῦτα",709858,71],["τοῦ",709436,20],["μὴ",708851,28],["ἐξᾶραι",704839,106],["αὐτὰ",702165,71],["τὸ",709436,24],["τάχος",712747,25],["καὶ",707031,7],["οὐ",709805,28],["παρέδωκεν",710014,2],["αὐτὰ",702165,71],["ἐν",704639,0],["χειρὶ",713787,1],["Ἰησοῦ",706701,18]],"So the Lord will leave these nations, so as not to cast them out suddenly; and he delivered them not into the hand of Joshua."]]