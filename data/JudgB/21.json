[["1",[["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["ὤμοσαν",709620,150],["ἐν",704639,0],["Μασσηφα",708561,1],["λέγοντες",708124,146],["ἀνὴρ",701150,4],["ἐξ",704132,0],["ἡμῶν",705999,145],["οὐ",709805,28],["δώσει",703654,127],["θυγατέρα",706320,9],["αὐτοῦ",702165,102],["τῷ",709436,113],["Βενιαμιν",702650,114],["εἰς",704105,0],["γυναῖκα",703209,9]],"Now the children of Israel swore in Massephath, saying, No man of us shall give his daughter to Benjamin for a wife."],["2",[["καὶ",707031,7],["ἦλθεν",705453,2],["ὁ",709436,3],["λαὸς",708094,4],["εἰς",704105,0],["Βαιθηλ",702412,9],["καὶ",707031,7],["ἐκάθισαν",707006,150],["ἐκεῖ",704181,28],["ἕως",705792,0],["ἑσπέρας",705500,17],["ἐνώπιον",704823,0],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["ἦραν",700473,150],["φωνὴν",713640,9],["αὐτῶν",702165,40],["καὶ",707031,7],["ἔκλαυσαν",707703,150],["κλαυθμὸν",707705,6],["μέγαν",708653,27]],"And the people came to Bæthel, and sat there until evening before God: and they lifted up their voice and wept with a great weeping;"],["3",[["καὶ",707031,7],["εἶπαν",705373,150],["εἰς",704105,0],["τί",712867,273],["κύριε",707996,153],["θεὲ",706192,153],["Ισραηλ",706839,18],["ἐγενήθη",703104,37],["αὕτη",709858,107],["τοῦ",709436,20],["ἐπισκεπῆναι",705250,179],["σήμερον",711751,28],["ἀπὸ",701425,0],["Ισραηλ",706839,18],["φυλὴν",713620,9],["μίαν",704106,36]],"and said, Wherefore, O Lord God of Israel, has this come to pass, that to-day one tribe should be counted [as missing] from Israel?"],["4",[["καὶ",707031,7],["ἐγένετο",703104,23],["τῇ",709436,100],["ἐπαύριον",705050,28],["καὶ",707031,7],["ὤρθρισεν",709742,2],["ὁ",709436,3],["λαὸς",708094,4],["καὶ",707031,7],["ᾠκοδόμησαν",709509,150],["ἐκεῖ",704181,28],["θυσιαστήριον",706348,25],["καὶ",707031,7],["ἀνήνεγκαν",701083,150],["ὁλοκαυτώσεις",709590,39],["καὶ",707031,7],["τελείας",712769,119]],"And it came to pass on the morrow that the people rose up early, and built there an altar, and offered up whole-burnt-offerings and peace-offerings."],["5",[["καὶ",707031,7],["εἶπον",705373,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["τίς",712867,273],["οὐκ",709805,28],["ἀνέβη",700905,2],["ἐν",704639,0],["τῇ",709436,100],["ἐκκλησίᾳ",704216,1],["ἀπὸ",701425,0],["πασῶν",710177,198],["φυλῶν",713620,65],["Ισραηλ",706839,18],["πρὸς",710844,0],["κύριον",707996,6],["ὅτι",709803,7],["ὁ",709436,3],["ὅρκος",709753,4],["μέγας",708653,14],["ἦν",704093,13],["τοῖς",709436,147],["οὐκ",709805,28],["ἀναβεβηκόσιν",700905,536],["πρὸς",710844,0],["κύριον",707996,6],["εἰς",704105,0],["Μασσηφα",708561,9],["λέγοντες",708124,146],["θανάτῳ",706096,114],["θανατωθήσεται",706097,134]],"And the children of Israel said, Who of all the tribes of Israel, went not up in the congregation to the Lord? for there was a great oath concerning those who went not up to the Lord to Massephath, saying, He shall surely be put to death."],["6",[["καὶ",707031,7],["παρεκλήθησαν",710039,99],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["πρὸς",710844,0],["Βενιαμιν",702650,6],["ἀδελφὸν",700249,6],["αὐτῶν",702165,40],["καὶ",707031,7],["εἶπαν",705373,150],["ἐξεκόπη",704225,37],["σήμερον",711751,28],["φυλὴ",713620,12],["μία",704106,29],["ἀπὸ",701425,0],["Ισραηλ",706839,18]],"And the children of Israel relented toward Benjamin their brother, and said, To-day one tribe is cut off from Israel."],["7",[["τί",712867,126],["ποιήσωμεν",710582,79],["αὐτοῖς",702165,151],["τοῖς",709436,147],["περισσοῖς",710387,230],["τοῖς",709436,147],["ὑπολειφθεῖσιν",713212,477],["εἰς",704105,0],["γυναῖκας",703209,39],["καὶ",707031,7],["ἡμεῖς",705983,219],["ὠμόσαμεν",709620,289],["ἐν",704639,0],["κυρίῳ",707996,114],["τοῦ",709436,20],["μὴ",708851,28],["δοῦναι",703654,106],["αὐτοῖς",702165,151],["ἀπὸ",701425,0],["τῶν",709436,130],["θυγατέρων",706320,65],["ἡμῶν",705999,145],["εἰς",704105,0],["γυναῖκας",703209,39]],"What shall we do for wives for the rest that remain? whereas we have sworn by the Lord, not to give them of our daughters for wives."],["8",[["καὶ",707031,7],["εἶπαν",705373,150],["τίς",712867,158],["εἷς",704106,14],["ἀπὸ",701425,0],["φυλῶν",713620,65],["Ισραηλ",706839,18],["ὃς",709781,213],["οὐκ",709805,28],["ἀνέβη",700905,2],["πρὸς",710844,0],["κύριον",707996,6],["εἰς",704105,0],["Μασσηφα",708561,9],["καὶ",707031,7],["ἰδοὺ",706497,88],["οὐκ",709805,28],["ἦλθεν",705453,2],["ἀνὴρ",701150,4],["εἰς",704105,0],["τὴν",709436,8],["παρεμβολὴν",710133,9],["ἀπὸ",701425,0],["Ιαβις",706366,18],["Γαλααδ",702920,18],["εἰς",704105,0],["τὴν",709436,8],["ἐκκλησίαν",704216,9]],"And they said, What one [man is there] of the tribes of Israel, who went not up to the Lord to Massephath? and, behold, no man came to the camp from Jabis Galaad to the assembly."],["9",[["καὶ",707031,7],["ἐπεσκέπη",705250,37],["ὁ",709436,3],["λαός",708094,4],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ἐκεῖ",704181,28],["ἀνὴρ",701150,4],["ἀπὸ",701425,0],["οἰκούντων",709499,170],["Ιαβις",706366,18],["Γαλααδ",702920,18]],"And the people were numbered, and there was not there a man from the inhabitants of Jabis Galaad."],["10",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["ἐκεῖ",704181,28],["ἡ",709436,10],["συναγωγὴ",712376,12],["δώδεκα",703887,59],["χιλιάδας",713858,39],["ἀνδρῶν",701150,81],["ἀπὸ",701425,0],["υἱῶν",713075,81],["τῆς",709436,16],["δυνάμεως",703839,17],["καὶ",707031,7],["ἐνετείλαντο",704791,189],["αὐτοῖς",702165,151],["λέγοντες",708124,146],["πορεύεσθε",710667,73],["καὶ",707031,7],["πατάξατε",710185,74],["τοὺς",709436,58],["οἰκοῦντας",709499,235],["Ιαβις",706366,18],["Γαλααδ",702920,18],["ἐν",704639,0],["στόματι",712125,54],["ῥομφαίας",711291,17]],"And the congregation sent thither twelve thousand men of the strongest, and they charged them, saying, Go ye and smite the inhabitants of Jabis Galaad with the edge of the sword."],["11",[["καὶ",707031,7],["τοῦτο",709858,129],["ποιήσετε",710582,337],["πᾶν",710177,46],["ἄρσεν",701818,46],["καὶ",707031,7],["πᾶσαν",710177,36],["γυναῖκα",703209,9],["εἰδυῖαν",709492,336],["κοίτην",707781,9],["ἄρσενος",701818,116],["ἀναθεματιεῖτε",700951,337],["τὰς",709436,38],["δὲ",703303,11],["παρθένους",710148,39],["περιποιήσεσθε",710367,124],["καὶ",707031,7],["ἐποίησαν",710582,150],["οὕτως",709859,28]],"And this shall ye do: every male and every woman that has known the lying with man ye shall devote [to destruction], but the virgins ye shall save alive: and they did so."],["12",[["καὶ",707031,7],["εὗρον",705676,150],["ἀπὸ",701425,0],["οἰκούντων",709499,170],["Ιαβις",706366,18],["Γαλααδ",702920,18],["τετρακοσίας",712817,119],["νεάνιδας",709231,39],["παρθένους",710148,39],["αἵτινες",709793,537],["οὐκ",709805,28],["ἔγνωσαν",703105,150],["ἄνδρα",701150,6],["εἰς",704105,0],["κοίτην",707781,9],["ἄρσενος",701818,116],["καὶ",707031,7],["ἤνεγκαν",713428,150],["αὐτὰς",702165,231],["εἰς",704105,0],["τὴν",709436,8],["παρεμβολὴν",710133,9],["εἰς",704105,0],["Σηλων",711740,9],["τὴν",709436,8],["ἐν",704639,0],["γῇ",703083,1],["Χανααν",713708,17]],"And they found among the inhabitants of Jabis Galaad four hundred young virgins, who had not known man by lying with him; and they brought them to Selom in the land of Chanaan."],["13",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["πᾶσα",710177,29],["ἡ",709436,10],["συναγωγὴ",712376,12],["καὶ",707031,7],["ἐλάλησαν",708071,150],["πρὸς",710844,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["Βενιαμιν",702650,18],["ἐν",704639,0],["τῇ",709436,100],["πέτρᾳ",710443,1],["Ρεμμων",711233,118],["καὶ",707031,7],["ἐκάλεσαν",707084,150],["αὐτοὺς",702165,62],["εἰς",704105,0],["εἰρήνην",704098,9]],"And all the congregation sent and spoke to the children of Benjamin in the rock Remmon, and invited them to [make] peace."],["14",[["καὶ",707031,7],["ἐπέστρεψεν",705278,2],["Βενιαμιν",702650,4],["πρὸς",710844,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ισραηλ",706839,18],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["καὶ",707031,7],["ἔδωκαν",703654,150],["αὐτοῖς",702165,151],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["τὰς",709436,38],["γυναῖκας",703209,39],["ἃς",709781,193],["ἐζωοποίησαν",705917,150],["ἀπὸ",701425,0],["τῶν",709436,130],["θυγατέρων",706320,65],["Ιαβις",706366,18],["Γαλααδ",702920,18],["καὶ",707031,7],["ἤρεσεν",701722,2],["αὐτοῖς",702165,151],["οὕτως",709859,28]],"And Benjamin returned to the children of Israel at that time, and the children of Israel gave them the women whom they [had] saved alive of the daughters of Jabis Galaad; and they were content."],["15",[["καὶ",707031,7],["ὁ",709436,3],["λαὸς",708094,4],["παρεκλήθη",710039,37],["ἐπὶ",705080,0],["τῷ",709436,113],["Βενιαμιν",702650,114],["ὅτι",709803,7],["ἐποίησεν",710582,2],["κύριος",707996,4],["διακοπὴν",703480,9],["ἐν",704639,0],["ταῖς",709436,75],["φυλαῖς",713620,76],["Ισραηλ",706839,18]],"And the people relented for Benjamin, because the Lord had made a breach in the tribes of Israel."],["16",[["καὶ",707031,7],["εἶπον",705373,150],["οἱ",709436,136],["πρεσβύτεροι",710735,267],["τῆς",709436,16],["συναγωγῆς",712376,17],["τί",712867,126],["ποιήσωμεν",710582,79],["τοῖς",709436,147],["περισσοῖς",710387,230],["εἰς",704105,0],["γυναῖκας",703209,39],["ὅτι",709803,7],["ἠφανίσθη",702182,37],["ἀπὸ",701425,0],["Βενιαμιν",702650,18],["γυνή",703209,12]],"And the elders of the congregation said, What shall we do for wives for them that remain? for the women have been destroyed out of Benjamin."],["17",[["καὶ",707031,7],["εἶπαν",705373,150],["κληρονομία",707725,12],["διασῳζομένων",703599,299],["τῷ",709436,113],["Βενιαμιν",702650,114],["καὶ",707031,7],["οὐκ",709805,28],["ἐξαλειφθήσεται",704852,134],["φυλὴ",713620,12],["ἀπὸ",701425,0],["Ισραηλ",706839,18]],"And they said, [There must be] an inheritance of them that are escaped of Benjamin; and [so] a tribe shall not be destroyed out of Israel."],["18",[["ὅτι",709803,7],["ἡμεῖς",705983,219],["οὐ",709805,28],["δυνησόμεθα",703838,141],["δοῦναι",703654,106],["αὐτοῖς",702165,151],["γυναῖκας",703209,39],["ἀπὸ",701425,0],["τῶν",709436,130],["θυγατέρων",706320,65],["ἡμῶν",705999,145],["ὅτι",709803,7],["ὠμόσαμεν",709620,289],["ἐν",704639,0],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["λέγοντες",708124,146],["ἐπικατάρατος",705159,224],["ὁ",709436,3],["διδοὺς",703654,72],["γυναῖκα",703209,9],["τῷ",709436,113],["Βενιαμιν",702650,114]],"For we shall not be able to give them wives of our daughters, because we swore among the children of Israel, saying, Cursed [is] he that gives a wife to Benjamin."],["19",[["καὶ",707031,7],["εἶπαν",705373,150],["ἰδοὺ",706497,88],["δὴ",703395,11],["ἑορτὴ",704990,12],["κυρίου",707996,18],["ἐν",704639,0],["Σηλων",711740,111],["ἀφ᾿",701425,0],["ἡμερῶν",705984,65],["εἰς",704105,0],["ἡμέρας",705984,39],["ἥ",709781,177],["ἐστιν",704093,91],["ἀπὸ",701425,0],["βορρᾶ",702765,18],["τῆς",709436,16],["Βαιθηλ",702412,9],["κατ᾿",707200,0],["ἀνατολὰς",701071,39],["ἡλίου",705974,18],["ἐπὶ",705080,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["τῆς",709436,16],["ἀναβαινούσης",700905,222],["ἀπὸ",701425,0],["Βαιθηλ",702412,17],["εἰς",704105,0],["Συχεμ",712565,6],["καὶ",707031,7],["ἀπὸ",701425,0],["νότου",709364,18],["τῆς",709436,16],["Λεβωνα",708123,17]],"And they said, Lo! now [there is] a feast of the Lord from year to year in Selom, which is on the north of Bæthel, eastward on the way that goes up from Bæthel to Sychem, and from the south of Lebona."],["20",[["καὶ",707031,7],["ἐνετείλαντο",704791,189],["τοῖς",709436,147],["υἱοῖς",713075,148],["Βενιαμιν",702650,18],["λέγοντες",708124,146],["πορεύεσθε",710667,73],["ἐνεδρεύσατε",704703,74],["ἐν",704639,0],["τοῖς",709436,147],["ἀμπελῶσιν",700872,148]],"And they charged the children of Benjamin, saying, Go and lie in wait in the vineyards;"],["21",[["καὶ",707031,7],["ὄψεσθε",709725,124],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἐὰν",703912,7],["ἐξέλθωσιν",704909,234],["αἱ",709436,190],["θυγατέρες",706320,191],["τῶν",709436,80],["οἰκούντων",709499,170],["Σηλων",711740,111],["χορεύειν",713910,55],["ἐν",704639,0],["τοῖς",709436,147],["χοροῖς",713915,148],["καὶ",707031,7],["ἐξελεύσεσθε",704909,124],["ἐκ",704132,0],["τῶν",709436,80],["ἀμπελώνων",700872,81],["καὶ",707031,7],["ἁρπάσατε",701804,74],["ἑαυτοῖς",703917,151],["ἀνὴρ",701150,4],["γυναῖκα",703209,9],["ἀπὸ",701425,0],["τῶν",709436,130],["θυγατέρων",706320,65],["Σηλων",711740,118],["καὶ",707031,7],["πορεύεσθε",710667,73],["εἰς",704105,0],["γῆν",703083,9],["Βενιαμιν",702650,18]],"and ye shall see; and lo! if there come out the daughters of the inhabitants of Selom to dance in dances, then shall ye go out of the vineyards and seize for yourselves every man a wife of the daughters of Selom, and go ye into the land of Benjamin."],["22",[["καὶ",707031,7],["ἔσται",704093,93],["ὅταν",709801,28],["ἔλθωσιν",705453,234],["οἱ",709436,136],["πατέρες",710189,52],["αὐτῶν",702165,40],["ἢ",705924,7],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["αὐτῶν",702165,40],["κρίνεσθαι",707905,110],["πρὸς",710844,0],["ὑμᾶς",713080,194],["καὶ",707031,7],["ἐροῦμεν",705415,275],["αὐτοῖς",702165,151],["ἔλεος",704426,15],["ποιήσατε",710582,74],["ἡμῖν",705994,90],["αὐτάς",702165,231],["ὅτι",709803,7],["οὐκ",709805,28],["ἐλάβομεν",708076,289],["ἀνὴρ",701150,4],["γυναῖκα",703209,9],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῇ",709436,100],["παρατάξει",710107,1],["ὅτι",709803,7],["οὐχ",709805,28],["ὑμεῖς",713081,219],["ἐδώκατε",703654,265],["αὐτοῖς",702165,151],["ὡς",714148,7],["καιρὸς",707047,4],["πλημμελήσατε",710534,74]],"And it shall come to pass, when their fathers or their brethren come to dispute with us, that we will say to them, Grant them freely to us, for we have not taken every man his wife in the battle: because ye did not give to them according to the occasion, ye transgressed."],["23",[["καὶ",707031,7],["ἐποίησαν",710582,150],["οὕτως",709859,28],["οἱ",709436,136],["υἱοὶ",713075,52],["Βενιαμιν",702650,18],["καὶ",707031,7],["ἔλαβον",708076,150],["γυναῖκας",703209,39],["εἰς",704105,0],["ἀριθμὸν",701744,6],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["τῶν",709436,130],["χορευουσῶν",713910,66],["ὧν",709781,252],["ἥρπασαν",701804,150],["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["καὶ",707031,7],["ὑπέστρεψαν",713246,150],["εἰς",704105,0],["τὴν",709436,8],["κληρονομίαν",707725,9],["αὐτῶν",702165,40],["καὶ",707031,7],["ᾠκοδόμησαν",709509,150],["τὰς",709436,38],["πόλεις",710612,39],["καὶ",707031,7],["ἐκάθισαν",707006,150],["ἐν",704639,0],["αὐταῖς",702165,200]],"And the children of Benjamin did so; and they took wives according to their number from the dancers whom they seized: and they went and returned to their inheritance, and built the cities, and dwelt in them."],["24",[["καὶ",707031,7],["περιεπάτησαν",710362,150],["ἐκεῖθεν",704182,28],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["ἀνὴρ",701150,4],["εἰς",704105,0],["φυλὴν",713620,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἰς",704105,0],["συγγένειαν",712184,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐξῆλθον",704909,150],["ἐκεῖθεν",704182,28],["ἀνὴρ",701150,4],["εἰς",704105,0],["κληρονομίαν",707725,9],["αὐτοῦ",702165,102]],"And the children of Israel went thence at that time every man to his tribe and his kindred; and they went thence every man to his inheritance."],["25",[["ἐν",704639,0],["δὲ",703303,11],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["οὐκ",709805,28],["ἦν",704093,13],["βασιλεὺς",702580,4],["ἐν",704639,0],["Ισραηλ",706839,114],["ἀνὴρ",701150,4],["τὸ",709436,24],["εὐθὲς",705596,46],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["ἐποίει",710582,13]],"And in those days there was no king in Israel; every man did that which was right in his own sight."]]