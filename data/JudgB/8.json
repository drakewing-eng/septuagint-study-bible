[["1",[["καὶ",707031,7],["εἶπαν",705373,150],["πρὸς",710844,0],["Γεδεων",702995,6],["ἀνὴρ",701150,4],["Εφραιμ",705769,18],["τί",712867,126],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["ἐποίησας",710582,162],["ἡμῖν",705994,90],["τοῦ",709436,20],["μὴ",708851,28],["καλέσαι",707084,106],["ἡμᾶς",705981,194],["ὅτε",709802,28],["ἐπορεύθης",710667,168],["παρατάξασθαι",710108,109],["ἐν",704639,0],["Μαδιαμ",708355,1],["καὶ",707031,7],["διελέξαντο",703495,189],["πρὸς",710844,0],["αὐτὸν",702165,85],["ἰσχυρῶς",706857,28]],"And the men of Ephraim said to Gedeon, What [is] this [that] thou hast done to us, in that thou didst not call us when thou wentest to fight with Madiam? and they chode with him sharply."],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτούς",702165,62],["τί",712867,126],["ἐποίησα",710582,155],["νῦν",709384,28],["καθὼς",707030,28],["ὑμεῖς",713081,219],["ἢ",705924,7],["οὐχὶ",709862,28],["κρεῖσσον",707890,26],["ἐπιφυλλὶς",705326,12],["Εφραιμ",705769,18],["ἢ",705924,7],["τρυγητὸς",712998,4],["Αβιεζερ",700063,18]],"And he said to them, What have I now done in comparison of you? [is] not the gleaning of Ephraim better than the vintage of Abiezer?"],["3",[["ἐν",704639,0],["χειρὶ",713787,1],["ὑμῶν",713091,145],["παρέδωκεν",710014,2],["κύριος",707996,4],["τοὺς",709436,58],["ἄρχοντας",701862,57],["Μαδιαμ",708355,17],["τὸν",709436,5],["Ωρηβ",714137,6],["καὶ",707031,7],["τὸν",709436,5],["Ζηβ",705870,6],["καὶ",707031,7],["τί",712867,126],["ἠδυνήθην",703838,156],["ποιῆσαι",710582,106],["ὡς",714148,7],["ὑμεῖς",713081,219],["τότε",712908,28],["ἀνέθη",701169,37],["τὸ",709436,34],["πνεῦμα",710566,15],["αὐτῶν",702165,40],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,53],["λαλῆσαι",708071,106],["αὐτὸν",702165,85],["τὸν",709436,5],["λόγον",708236,6],["τοῦτον",709858,85]],"The Lord has delivered into your hand the princes of Madiam, Oreb and Zeb; and what could I do in comparison of you? Then was their spirit calmed toward him, when he spoke this word."],["4",[["καὶ",707031,7],["ἦλθεν",705453,2],["Γεδεων",702995,4],["ἐπὶ",705080,0],["τὸν",709436,5],["Ιορδάνην",706763,6],["καὶ",707031,7],["διέβη",703419,2],["αὐτὸς",702165,121],["καὶ",707031,7],["οἱ",709436,136],["τριακόσιοι",712936,138],["ἄνδρες",701150,52],["οἱ",709436,136],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["πεινῶντες",710222,146],["καὶ",707031,7],["διώκοντες",703768,146]],"And Gedeon came to Jordan, and went over, himself and the three hundred with him, hungry, yet pursuing."],["5",[["καὶ",707031,7],["εἶπεν",705373,2],["τοῖς",709436,147],["ἀνδράσιν",701150,148],["Σοκχωθ",711926,17],["δότε",703654,74],["δὴ",703395,11],["ἄρτους",701829,57],["εἰς",704105,0],["τροφὴν",712984,9],["τῷ",709436,113],["λαῷ",708094,114],["τούτῳ",709858,50],["τῷ",709436,113],["ἐν",704639,0],["ποσίν",710707,148],["μου",709032,133],["ὅτι",709803,7],["ἐκλείπουσιν",704237,197],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἐγώ",704018,164],["εἰμι",704093,157],["διώκων",703768,72],["ὀπίσω",709697,0],["τοῦ",709436,35],["Ζεβεε",705853,18],["καὶ",707031,7],["Σελμανα",711658,18],["βασιλέων",702580,81],["Μαδιαμ",708355,17]],"And he said to the men of Socchoth, Give, I pray you, bread to feed this people that follow me; because they are faint, and behold, I am following after Zebee and Salmana, kings of Madiam."],["6",[["καὶ",707031,7],["εἶπον",705373,150],["οἱ",709436,136],["ἄρχοντες",701862,52],["Σοκχωθ",711926,17],["μὴ",708851,28],["χεὶρ",713787,12],["Ζεβεε",705853,18],["καὶ",707031,7],["Σελμανα",711658,18],["νῦν",709384,28],["ἐν",704639,0],["χειρί",713787,1],["σου",711945,133],["οὐ",709805,28],["δώσομεν",703654,275],["τῇ",709436,100],["δυνάμει",703839,1],["σου",711945,133],["ἄρτους",701829,57]],"And the princes of Socchoth said, [Are] the hands of Zebee and Salmana now in thy hand, that we should give bread to thy host?"],["7",[["καὶ",707031,7],["εἶπεν",705373,2],["Γεδεων",702995,4],["διὰ",703417,0],["τοῦτο",709858,129],["ἐν",704639,0],["τῷ",709436,53],["δοῦναι",703654,106],["κύριον",707996,6],["τὸν",709436,5],["Ζεβεε",705853,6],["καὶ",707031,7],["Σελμανα",711658,6],["ἐν",704639,0],["χειρί",713787,1],["μου",709032,133],["καὶ",707031,7],["ἐγὼ",704018,164],["ἀλοήσω",700716,165],["τὰς",709436,38],["σάρκας",711537,39],["ὑμῶν",713091,145],["ἐν",704639,0],["ταῖς",709436,75],["ἀκάνθαις",700517,76],["τῆς",709436,16],["ἐρήμου",705420,17],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["αβαρκηνιν",700020,76]],"And Gedeon said, Therefore when the Lord gives Zebee and Salmana into my hand, then will I tear your flesh with the thorns of the wilderness, and the Barkenim."],["8",[["καὶ",707031,7],["ἀνέβη",700905,2],["ἐκεῖθεν",704182,28],["εἰς",704105,0],["Φανουηλ",713345,227],["καὶ",707031,7],["ἐλάλησεν",708071,2],["πρὸς",710844,0],["αὐτοὺς",702165,62],["ὡσαύτως",714158,28],["καὶ",707031,7],["ἀπεκρίθησαν",701492,99],["αὐτῷ",702165,50],["οἱ",709436,136],["ἄνδρες",701150,52],["Φανουηλ",713345,118],["ὃν",709781,112],["τρόπον",712980,6],["ἀπεκρίθησαν",701492,99],["ἄνδρες",701150,52],["Σοκχωθ",711926,17]],"And he went up thence to Phanuel, and spoke to them likewise: and the men of Phanuel answered him as the men of Socchoth [had] answered him."],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["Γεδεων",702995,4],["πρὸς",710844,0],["ἄνδρας",701150,57],["Φανουηλ",713345,118],["ἐν",704639,0],["ἐπιστροφῇ",705279,1],["μου",709032,133],["μετ᾿",708780,0],["εἰρήνης",704098,17],["τὸν",709436,5],["πύργον",711092,6],["τοῦτον",709858,85],["κατασκάψω",707416,165]],"And Gedeon said to the men of Phanuel, When I return in peace, I will break down this tower."],["10",[["καὶ",707031,7],["Ζεβεε",705853,4],["καὶ",707031,7],["Σελμανα",711658,4],["ἐν",704639,0],["Καρκαρ",707156,111],["καὶ",707031,7],["ἡ",709436,10],["παρεμβολὴ",710133,12],["αὐτῶν",702165,40],["μετ᾿",708780,0],["αὐτῶν",702165,40],["ὡσεὶ",714159,7],["δέκα",703333,59],["πέντε",710266,59],["χιλιάδες",713858,191],["πάντες",710177,138],["οἱ",709436,136],["καταλελειμμένοι",707305,429],["ἀπὸ",701425,0],["πάσης",710177,82],["παρεμβολῆς",710133,17],["ἀλλοφύλων",700706,169],["καὶ",707031,7],["οἱ",709436,136],["πεπτωκότες",710481,268],["ἑκατὸν",704136,59],["εἴκοσι",704085,59],["χιλιάδες",713858,191],["ἀνδρῶν",701150,81],["σπωμένων",712003,299],["ῥομφαίαν",711291,9]],"And Zebee and Salmana [were] in Carcar, and their host [was] with them, about fifteen thousand, all that were left of all the host of the aliens; and they that fell [were] a hundred and twenty thousand men that drew the sword."],["11",[["καὶ",707031,7],["ἀνέβη",700905,2],["Γεδεων",702995,4],["ὁδὸν",709458,9],["τῶν",709436,80],["σκηνούντων",711848,170],["ἐν",704639,0],["σκηναῖς",711845,76],["ἀπὸ",701425,0],["ἀνατολῶν",701071,65],["τῆς",709436,16],["Ναβαι",709130,17],["καὶ",707031,7],["Ιεγεβαλ",706521,118],["καὶ",707031,7],["ἐπάταξεν",710185,2],["τὴν",709436,8],["παρεμβολήν",710133,9],["καὶ",707031,7],["ἡ",709436,10],["παρεμβολὴ",710133,12],["ἦν",704093,13],["πεποιθυῖα",710221,287]],"And Gedeon went up by the way of them that dwelt in tents, eastward of Nabai and Jegebal; and he smote the host, and the host was secure."],["12",[["καὶ",707031,7],["ἔφυγον",713433,150],["Ζεβεε",705853,4],["καὶ",707031,7],["Σελμανα",711658,4],["καὶ",707031,7],["ἐδίωξεν",703768,2],["ὀπίσω",709697,0],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐκράτησεν",707879,2],["τοὺς",709436,58],["δύο",703849,59],["βασιλεῖς",702580,52],["Μαδιαμ",708355,17],["τὸν",709436,5],["Ζεβεε",705853,6],["καὶ",707031,7],["τὸν",709436,5],["Σελμανα",711658,6],["καὶ",707031,7],["πᾶσαν",710177,36],["τὴν",709436,8],["παρεμβολὴν",710133,9],["ἐξέστησεν",704940,2]],"And Zebee and Salmana fled; and he pursued after them, and took the two kings of Madiam, Zebee and Salmana, and discomfited all the army."],["13",[["καὶ",707031,7],["ἐπέστρεψεν",705278,2],["Γεδεων",702995,4],["υἱὸς",713075,4],["Ιωας",706896,18],["ἀπὸ",701425,0],["τῆς",709436,16],["παρατάξεως",710107,17],["ἀπὸ",701425,0],["ἐπάνωθεν",705032,28],["τῆς",709436,16],["παρατάξεως",710107,17],["Αρες",701720,118]],"And Gedeon the son of Joas returned from the battle, down from the battle of Ares."],["14",[["καὶ",707031,7],["συνέλαβεν",712262,2],["παιδάριον",709923,25],["ἀπὸ",701425,0],["τῶν",709436,80],["ἀνδρῶν",701150,81],["Σοκχωθ",711926,17],["καὶ",707031,7],["ἐπηρώτησεν",705069,2],["αὐτόν",702165,85],["καὶ",707031,7],["ἔγραψεν",703194,2],["πρὸς",710844,0],["αὐτὸν",702165,85],["τὰ",709436,41],["ὀνόματα",709666,42],["τῶν",709436,80],["ἀρχόντων",701862,81],["Σοκχωθ",711926,17],["καὶ",707031,7],["τῶν",709436,80],["πρεσβυτέρων",710735,527],["αὐτῶν",702165,40],["ἑβδομήκοντα",703922,59],["καὶ",707031,7],["ἑπτὰ",705357,59],["ἄνδρας",701150,57]],"And he took prisoner a young lad of the men of Socchoth, and questioned him; and he wrote to him the names of the princes of Socchoth and of their elders, seventy-seven men."],["15",[["καὶ",707031,7],["παρεγένετο",710006,23],["Γεδεων",702995,4],["πρὸς",710844,0],["τοὺς",709436,58],["ἄρχοντας",701862,57],["Σοκχωθ",711926,17],["καὶ",707031,7],["εἶπεν",705373,2],["ἰδοὺ",706497,88],["Ζεβεε",705853,6],["καὶ",707031,7],["Σελμανα",711658,6],["ἐν",704639,0],["οἷς",709781,311],["ὠνειδίσατέ",709655,265],["με",708618,163],["λέγοντες",708124,146],["μὴ",708851,28],["χεὶρ",713787,12],["Ζεβεε",705853,18],["καὶ",707031,7],["Σελμανα",711658,18],["νῦν",709384,28],["ἐν",704639,0],["χειρί",713787,1],["σου",711945,133],["ὅτι",709803,7],["δώσομεν",703654,275],["τοῖς",709436,147],["ἀνδράσιν",701150,148],["τοῖς",709436,147],["ἐκλείπουσιν",704237,349],["ἄρτους",701829,57]],"And Gedeon came to the princes of Socchoth, and said, Behold Zebee and Salmana, about whom ye reproached me, saying, [Are] the hands of Zebee and Salmana now in thy hand, that we should give bread to thy men that are faint?"],["16",[["καὶ",707031,7],["ἔλαβεν",708076,2],["τοὺς",709436,58],["πρεσβυτέρους",710735,496],["τῆς",709436,16],["πόλεως",710612,17],["ἐν",704639,0],["ταῖς",709436,75],["ἀκάνθαις",700517,76],["τῆς",709436,16],["ἐρήμου",705420,17],["καὶ",707031,7],["ταῖς",709436,75],["βαρακηνιμ",702524,76],["καὶ",707031,7],["ἠλόησεν",700716,2],["ἐν",704639,0],["αὐτοῖς",702165,151],["τοὺς",709436,58],["ἄνδρας",701150,57],["τῆς",709436,16],["πόλεως",710612,17]],"And he took the elders of the city with the thorns of the wilderness and the Barkenim, and with them he tore the men of the city."],["17",[["καὶ",707031,7],["τὸν",709436,5],["πύργον",711092,6],["Φανουηλ",713345,118],["κατέστρεψεν",707444,2],["καὶ",707031,7],["ἀπέκτεινεν",701498,2],["τοὺς",709436,58],["ἄνδρας",701150,57],["τῆς",709436,16],["πόλεως",710612,17]],"And he overthrew the tower of Phanuel, and slew the men of the city."],["18",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["Ζεβεε",705853,6],["καὶ",707031,7],["Σελμανα",711658,6],["ποῦ",710706,28],["οἱ",709436,136],["ἄνδρες",701150,52],["οὓς",709781,298],["ἀπεκτείνατε",701498,265],["ἐν",704639,0],["Θαβωρ",706055,111],["καὶ",707031,7],["εἶπαν",705373,150],["ὡς",714148,28],["σύ",712181,164],["ὣς",714148,7],["αὐτοὶ",702165,201],["εἰς",704105,0],["ὁμοίωμα",709629,25],["υἱοῦ",713075,18],["βασιλέως",702580,18]],"And he said to Zebee and Salmana, Where [are] the men whom ye slew in Thabor? and they said, As thou, so [were] they, according to the likeness of the son of a king."],["19",[["καὶ",707031,7],["εἶπεν",705373,2],["Γεδεων",702995,4],["ἀδελφοί",700249,52],["μου",709032,133],["καὶ",707031,7],["υἱοὶ",713075,52],["τῆς",709436,16],["μητρός",708892,17],["μου",709032,133],["ἦσαν",704093,137],["ζῇ",705851,91],["κύριος",707996,4],["εἰ",704071,11],["ἐζωογονήκειτε",705915,510],["αὐτούς",702165,62],["οὐκ",709805,28],["ἂν",700900,11],["ἀπέκτεινα",701498,155],["ὑμᾶς",713080,194]],"And Gedeon said, They were my brethren and the sons of my mother: [as] the Lord lives, if ye had preserved them alive, I would not have slain you."],["20",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιεθερ",706559,4],["τῷ",709436,113],["πρωτοτόκῳ",711046,30],["αὐτοῦ",702165,102],["ἀναστὰς",701173,182],["ἀπόκτεινον",701498,176],["αὐτούς",702165,62],["καὶ",707031,7],["οὐκ",709805,28],["ἔσπασεν",712003,2],["τὸ",709436,24],["παιδάριον",709923,25],["τὴν",709436,8],["ῥομφαίαν",711291,9],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ἐφοβήθη",713532,37],["ὅτι",709803,7],["ἔτι",705538,28],["νεώτερος",709256,224],["ἦν",704093,13]],"And he said to Jether his first-born, Rise and slay them; but the lad drew not his sword, for he was afraid, for he was yet very young."],["21",[["καὶ",707031,7],["εἶπεν",705373,2],["Ζεβεε",705853,4],["καὶ",707031,7],["Σελμανα",711658,4],["ἀνάστα",701173,176],["σὺ",712181,164],["καὶ",707031,7],["συνάντησον",712394,176],["ἡμῖν",705994,90],["ὅτι",709803,7],["ὡς",714148,7],["ἀνδρὸς",701150,18],["ἡ",709436,10],["δύναμίς",703839,12],["σου",711945,133],["καὶ",707031,7],["ἀνέστη",701173,2],["Γεδεων",702995,4],["καὶ",707031,7],["ἀπέκτεινεν",701498,2],["τὸν",709436,5],["Ζεβεε",705853,6],["καὶ",707031,7],["τὸν",709436,5],["Σελμανα",711658,6],["καὶ",707031,7],["ἔλαβεν",708076,2],["τοὺς",709436,58],["μηνίσκους",708879,57],["τοὺς",709436,58],["ἐν",704639,0],["τοῖς",709436,147],["τραχήλοις",712924,148],["τῶν",709436,130],["καμήλων",707110,65],["αὐτῶν",702165,40]],"And Zebee and Salmana said, Rise thou and fall upon us, for thy power [is] as that of a man; and Gedeon arose, and slew Zebee and Salmana; and he took the round ornaments that were on the necks of their camels."],["22",[["καὶ",707031,7],["εἶπον",705373,150],["ἀνὴρ",701150,4],["Ισραηλ",706839,18],["πρὸς",710844,0],["Γεδεων",702995,6],["κύριε",707996,153],["ἄρξον",701860,176],["ἡμῶν",705999,145],["καὶ",707031,7],["σὺ",712181,164],["καὶ",707031,7],["ὁ",709436,3],["υἱός",713075,4],["σου",711945,133],["ὅτι",709803,7],["σὺ",712181,164],["ἔσωσας",712627,162],["ἡμᾶς",705981,194],["ἐκ",704132,0],["χειρὸς",713787,17],["Μαδιαμ",708355,17]],"And the men of Israel said to Gedeon, Rule, [my] lord, over us, both thou, and thy son, and thy son's son; for thou hast saved us out of the hand of Madiam."],["23",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτοὺς",702165,62],["Γεδεων",702995,4],["οὐκ",709805,28],["ἄρξω",701860,165],["ἐγώ",704018,164],["καὶ",707031,7],["οὐκ",709805,28],["ἄρξει",701860,127],["ὁ",709436,3],["υἱός",713075,4],["μου",709032,133],["ἐν",704639,0],["ὑμῖν",713084,90],["κύριος",707996,4],["ἄρξει",701860,127],["ὑμῶν",713091,145]],"And Gedeon said to them, I will not rule, and my son shall not rule among you; the Lord shall rule over you."],["24",[["καὶ",707031,7],["εἶπεν",705373,2],["Γεδεων",702995,4],["πρὸς",710844,0],["αὐτούς",702165,62],["αἰτήσομαι",700489,181],["παρ᾿",709995,0],["ὑμῶν",713091,145],["αἴτημα",700490,25],["καὶ",707031,7],["δότε",703654,74],["μοι",708974,159],["ἀνὴρ",701150,4],["ἐνώτιον",704826,25],["ἐκ",704132,0],["σκύλων",711902,44],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ἐνώτια",704826,64],["χρυσᾶ",713971,195],["αὐτοῖς",702165,151],["ὅτι",709803,7],["Ισμαηλῖται",706819,52],["ἦσαν",704093,137]],"And Gedeon said to them, I will make a request of you, and do ye give me every man an earring out of his spoils: for they had golden earrings, for they were Ismaelites."],["25",[["καὶ",707031,7],["εἶπαν",705373,150],["διδόντες",703654,146],["δώσομεν",703654,275],["καὶ",707031,7],["ἀνέπτυξεν",701043,2],["τὸ",709436,24],["ἱμάτιον",706742,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔβαλεν",702487,2],["ἐκεῖ",704181,28],["ἀνὴρ",701150,4],["ἐνώτιον",704826,25],["σκύλων",711902,44],["αὐτοῦ",702165,102]],"And they said, We will certainly give them: and he opened his garment, and each man cast therein an earring of his spoils."],["26",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὁ",709436,3],["σταθμὸς",712040,4],["τῶν",709436,43],["ἐνωτίων",704826,44],["τῶν",709436,43],["χρυσῶν",713971,83],["ὧν",709781,103],["ᾔτησεν",700489,2],["χίλιοι",713859,138],["καὶ",707031,7],["πεντακόσιοι",710261,138],["χρυσοῖ",713971,138],["πάρεξ",710136,0],["τῶν",709436,80],["μηνίσκων",708879,81],["καὶ",707031,7],["τῶν",709436,130],["στραγγαλίδων",712134,65],["καὶ",707031,7],["τῶν",709436,43],["ἱματίων",706742,44],["καὶ",707031,7],["πορφυρίδων",710684,65],["τῶν",709436,43],["ἐπὶ",705080,0],["βασιλεῦσι",702580,148],["Μαδιαμ",708355,17],["καὶ",707031,7],["ἐκτὸς",704339,0],["τῶν",709436,43],["περιθεμάτων",710318,44],["ἃ",709781,69],["ἦν",704093,13],["ἐν",704639,0],["τοῖς",709436,147],["τραχήλοις",712924,148],["τῶν",709436,130],["καμήλων",707110,65],["αὐτῶν",702165,40]],"And the weight of the golden earrings which he asked, was a thousand and seven hundred pieces of gold, besides the crescents, and the chains, and the garments, and the purple cloths that were on the kings of Madiam, and besides the chains that were on the necks of their camels."],["27",[["καὶ",707031,7],["ἐποίησεν",710582,2],["αὐτὸ",702165,129],["Γεδεων",702995,4],["εἰς",704105,0],["εφωθ",705773,25],["καὶ",707031,7],["ἔστησεν",706846,2],["αὐτὸ",702165,129],["ἐν",704639,0],["πόλει",710612,1],["αὐτοῦ",702165,102],["Εφραθα",705765,111],["καὶ",707031,7],["ἐξεπόρνευσεν",704295,2],["πᾶς",710177,14],["Ισραηλ",706839,4],["ὀπίσω",709697,0],["αὐτοῦ",702165,102],["ἐκεῖ",704181,28],["καὶ",707031,7],["ἐγένετο",703104,23],["τῷ",709436,113],["Γεδεων",702995,114],["καὶ",707031,7],["τῷ",709436,113],["οἴκῳ",709516,114],["αὐτοῦ",702165,102],["εἰς",704105,0],["σκῶλον",711906,25]],"And Gedeon made an ephod of it, and set it in his city in Ephratha; and all Israel went thither a whoring after it, and it became a stumbling-block to Gedeon and his house."],["28",[["καὶ",707031,7],["συνεστάλη",712558,37],["Μαδιαμ",708355,12],["ἐνώπιον",704823,0],["υἱῶν",713075,81],["Ισραηλ",706839,18],["καὶ",707031,7],["οὐ",709805,28],["προσέθηκαν",710965,150],["ἆραι",700473,106],["κεφαλὴν",707639,9],["αὐτῶν",702165,40],["καὶ",707031,7],["ἡσύχασεν",706033,2],["ἡ",709436,10],["γῆ",703083,12],["τεσσαράκοντα",712806,59],["ἔτη",705543,42],["ἐν",704639,0],["ἡμέραις",705984,76],["Γεδεων",702995,18]],"And Madiam was straitened before the children of Israel, and they did not lift up their head any more; and the land had rest forty years in the days of Gedeon."],["29",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["Ιεροβααλ",706627,4],["υἱὸς",713075,4],["Ιωας",706896,18],["καὶ",707031,7],["ἐκάθισεν",707006,2],["ἐν",704639,0],["οἴκῳ",709516,114],["αὐτοῦ",702165,102]],"And Jerobaal the son of Joas went and sat in his house."],["30",[["καὶ",707031,7],["τῷ",709436,113],["Γεδεων",702995,114],["ἦσαν",704093,137],["ἑβδομήκοντα",703922,59],["υἱοὶ",713075,52],["ἐκπεπορευμένοι",704293,429],["ἐκ",704132,0],["μηρῶν",708885,81],["αὐτοῦ",702165,102],["ὅτι",709803,7],["γυναῖκες",703209,191],["πολλαὶ",710646,192],["ἦσαν",704093,137],["αὐτῷ",702165,50]],"And Gedeon had seventy sons begotten of his body, for he had many wives."],["31",[["καὶ",707031,7],["παλλακὴ",709943,12],["αὐτοῦ",702165,102],["ἦν",704093,13],["ἐν",704639,0],["Συχεμ",712565,114],["καὶ",707031,7],["ἔτεκεν",712853,2],["αὐτῷ",702165,50],["καί",707031,7],["γε",702985,11],["αὐτὴ",702165,107],["υἱόν",713075,6],["καὶ",707031,7],["ἔθηκεν",712849,2],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["Αβιμελεχ",700068,4]],"And his concubine was in Sychem, and she also bore him a son, and gave him the name Abimelech."],["32",[["καὶ",707031,7],["ἀπέθανεν",701461,2],["Γεδεων",702995,4],["υἱὸς",713075,4],["Ιωας",706896,18],["ἐν",704639,0],["πόλει",710612,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐτάφη",706103,37],["ἐν",704639,0],["τῷ",709436,113],["τάφῳ",712738,114],["Ιωας",706896,18],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["ἐν",704639,0],["Εφραθα",705765,111],["Αβιεσδρι",700065,18]],"And Gedeon son of Joas died in his city, and was buried in the sepulchre of Joas his father in Ephratha of Abi-Esdri."],["33",[["καὶ",707031,7],["ἐγένετο",703104,23],["καθὼς",707030,28],["ἀπέθανεν",701461,2],["Γεδεων",702995,4],["καὶ",707031,7],["ἐπέστρεψαν",705278,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐξεπόρνευσαν",704295,150],["ὀπίσω",709697,0],["τῶν",709436,80],["Βααλιμ",702342,81],["καὶ",707031,7],["ἔθηκαν",712849,150],["ἑαυτοῖς",703917,151],["τῷ",709436,113],["Βααλ",702333,114],["διαθήκην",703456,9],["τοῦ",709436,20],["εἶναι",704093,55],["αὐτοῖς",702165,151],["αὐτὸν",702165,85],["εἰς",704105,0],["θεόν",706192,6]],"And it came to pass when Gedeon was dead, that the children of Israel turned, and went a whoring after Baalim, and made for themselves a covenant with Baal that he should be their god."],["34",[["καὶ",707031,7],["οὐκ",709805,28],["ἐμνήσθησαν",708960,99],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["τοῦ",709436,35],["ῥυσαμένου",711309,292],["αὐτοὺς",702165,62],["ἐκ",704132,0],["χειρὸς",713787,17],["πάντων",710177,169],["τῶν",709436,80],["θλιβόντων",706274,170],["αὐτοὺς",702165,62],["κυκλόθεν",707956,28]],"And the children of Israel remembered not the Lord their God who had delivered them out of the hand of all that afflicted them round about."],["35",[["καὶ",707031,7],["οὐκ",709805,28],["ἐποίησαν",710582,150],["ἔλεος",704426,25],["μετὰ",708780,0],["τοῦ",709436,35],["οἴκου",709516,18],["Ιεροβααλ",706627,18],["αὐτός",702165,121],["ἐστιν",704093,91],["Γεδεων",702995,4],["κατὰ",707200,0],["πάντα",710177,68],["τὰ",709436,41],["ἀγαθά",700106,68],["ἃ",709781,69],["ἐποίησεν",710582,2],["μετὰ",708780,0],["Ισραηλ",706839,18]],"And they did not deal mercifully with the house of Jerobaal, (the same is Gedeon) according to all the good which he did to Israel."]]