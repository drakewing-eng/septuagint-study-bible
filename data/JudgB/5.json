[["1",[["καὶ",707031,7],["ᾖσαν",704094,137],["Δεββωρα",703305,12],["καὶ",707031,7],["Βαρακ",702523,4],["υἱὸς",713075,4],["Αβινεεμ",700069,18],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["λέγοντες",708124,146]],"And Debbora and Barac son of Abineem sang in that day, saying,"],["2",[["ἀπεκαλύφθη",701474,37],["ἀποκάλυμμα",701473,15],["ἐν",704639,0],["Ισραηλ",706839,114],["ἐν",704639,0],["τῷ",709436,53],["ἑκουσιασθῆναι",704267,179],["λαὸν",708094,6],["εὐλογεῖτε",705631,335],["κύριον",707996,6]],"A revelation was made in Israel when the people were made willing: Praise ye the Lord."],["3",[["ἀκούσατε",700587,74],["βασιλεῖς",702580,274],["καὶ",707031,7],["ἐνωτίσασθε",704825,73],["σατράπαι",711555,274],["ἐγώ",704018,164],["εἰμι",704093,157],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐγώ",704018,164],["εἰμι",704093,157],["ᾄσομαι",700299,181],["ψαλῶ",714021,165],["τῷ",709436,113],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["Ισραηλ",706839,18]],"Hear, ye kings, and hearken, rulers: I will sing, it is I [who will sing] to the Lord, it is I, I will sing a psalm to the Lord the God of Israel."],["4",[["κύριε",707996,153],["ἐν",704639,0],["τῇ",709436,100],["ἐξόδῳ",704948,1],["σου",711945,133],["ἐν",704639,0],["Σηιρ",711734,111],["ἐν",704639,0],["τῷ",709436,53],["ἀπαίρειν",701329,55],["σε",711598,163],["ἐξ",704132,0],["ἀγροῦ",700196,18],["Εδωμ",704041,118],["γῆ",703083,12],["ἐσείσθη",711633,37],["καὶ",707031,7],["ὁ",709436,3],["οὐρανὸς",709844,4],["ἔσταξεν",712038,2],["δρόσους",703835,39],["καὶ",707031,7],["αἱ",709436,190],["νεφέλαι",709277,191],["ἔσταξαν",712038,150],["ὕδωρ",713071,25]],"O Lord, in thy going forth on Seir, when thou wentest forth out of the land of Edom, the earth quaked and the heaven dropped dews, and the clouds dropped water."],["5",[["ὄρη",709768,64],["ἐσαλεύθησαν",711403,99],["ἀπὸ",701425,0],["προσώπου",710986,21],["κυρίου",707996,18],["Ελωι",704539,18],["τοῦτο",709858,129],["Σινα",711794,120],["ἀπὸ",701425,0],["προσώπου",710986,21],["κυρίου",707996,18],["θεοῦ",706192,18],["Ισραηλ",706839,18]],"The mountains were shaken before the face of the Lord Eloi, this Sina before the face of the Lord God of Israel."],["6",[["ἐν",704639,0],["ἡμέραις",705984,76],["Σαμεγαρ",711459,18],["υἱοῦ",713075,18],["Αναθ",700948,18],["ἐν",704639,0],["ἡμέραις",705984,76],["Ιαηλ",706386,17],["ἐξέλιπον",704237,150],["ὁδοὺς",709458,39],["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["ἀτραπούς",702106,39],["ἐπορεύθησαν",710667,99],["ὁδοὺς",709458,39],["διεστραμμένας",703592,498]],"In the days of Samegar son of Anath, in the days of Jael, they deserted the ways, and went in by-ways; they went in crooked paths."],["7",[["ἐξέλιπον",704237,150],["δυνατοὶ",703845,138],["ἐν",704639,0],["Ισραηλ",706839,114],["ἐξέλιπον",704237,150],["ἕως",705792,0],["οὗ",709781,48],["ἀναστῇ",701173,172],["Δεββωρα",703305,12],["ἕως",705792,0],["οὗ",709781,48],["ἀναστῇ",701173,172],["μήτηρ",708892,12],["ἐν",704639,0],["Ισραηλ",706839,114]],"The mighty men in Israel failed, they failed until Debbora arose, until she arose a mother in Israel."],["8",[["ἐξελέξαντο",704236,189],["θεοὺς",706192,57],["καινούς",707042,60],["τότε",712908,28],["ἐπολέμησαν",710601,150],["πόλεις",710612,191],["ἀρχόντων",701862,81],["θυρεὸς",706338,4],["ἐὰν",703912,7],["ὀφθῇ",709725,384],["καὶ",707031,7],["λόγχη",708237,12],["ἐν",704639,0],["τεσσαράκοντα",712806,59],["χιλιάσιν",713858,76],["ἐν",704639,0],["Ισραηλ",706839,114]],"They chose new gods; then the cities of rulers fought; there was not a shield or spear seen among forty thousand in Israel."],["9",[["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["εἰς",704105,0],["τὰ",709436,41],["διατεταγμένα",703603,388],["τῷ",709436,113],["Ισραηλ",706839,114],["οἱ",709436,136],["ἑκουσιαζόμενοι",704267,348],["ἐν",704639,0],["λαῷ",708094,114],["εὐλογεῖτε",705631,87],["κύριον",707996,6]],"My heart [inclines] to the orders given in Israel; ye that are willing among the people, bless the Lord."],["10",[["ἐπιβεβηκότες",705082,268],["ἐπὶ",705080,0],["ὄνου",709671,18],["θηλείας",706237,82],["μεσημβρίας",708758,17],["καθήμενοι",707000,348],["ἐπὶ",705080,0],["κριτηρίου",707909,21],["καὶ",707031,7],["πορευόμενοι",710667,348],["ἐπὶ",705080,0],["ὁδοὺς",709458,39],["συνέδρων",712420,137],["ἐφ᾿",705080,0],["ὁδῷ",709458,1]],"Ye that mount a she-ass at noon-day, ye that sit on the judgment-seat, and walk by the roads of them that sit in judgment by the way; declare"],["11",[["διηγεῖσθε",703679,73],["ἀπὸ",701425,0],["φωνῆς",713640,17],["ἀνακρουομένων",700982,299],["ἀνὰ",700902,0],["μέσον",708768,46],["ὑδρευομένων",713066,299],["ἐκεῖ",704181,28],["δώσουσιν",703654,218],["δικαιοσύνας",703695,39],["κυρίῳ",707996,114],["δικαιοσύνας",703695,39],["αὔξησον",702144,176],["ἐν",704639,0],["Ισραηλ",706839,114],["τότε",712908,28],["κατέβη",707202,2],["εἰς",704105,0],["τὰς",709436,38],["πόλεις",710612,39],["λαὸς",708094,4],["κυρίου",707996,18]],"[ye that are delivered] from the noise of disturbers among the drawers of water; there shall they relate righteous acts: O Lord, increase righteous acts in Israel: then the people of the Lord went down to the cities."],["12",[["ἐξεγείρου",704889,253],["ἐξεγείρου",704889,253],["Δεββωρα",703305,258],["ἐξεγείρου",704889,253],["ἐξεγείρου",704889,253],["λάλησον",708071,176],["ᾠδήν",714091,9],["ἀνάστα",701173,176],["Βαρακ",702523,153],["καὶ",707031,7],["αἰχμαλώτισον",700501,176],["αἰχμαλωσίαν",700499,9],["σου",711945,133],["υἱὸς",713075,4],["Αβινεεμ",700069,18]],"Awake, awake, Debbora; awake, awake, utter a song: arise, Barac, and lead thy captivity captive, son of Abineem."],["13",[["τότε",712908,28],["κατέβη",707202,2],["κατάλειμμα",707304,15],["τοῖς",709436,147],["ἰσχυροῖς",706855,230],["λαὸς",708094,4],["κυρίου",707996,18],["κατέβη",707202,2],["αὐτῷ",702165,50],["ἐν",704639,0],["τοῖς",709436,147],["κραταιοῖς",707873,230]],"Then went down the remnant to the strong, the people of the Lord went down for him among the mighty ones from me."],["14",[["ἐξ",704132,0],["ἐμοῦ",704580,133],["Εφραιμ",705769,4],["ἐξερρίζωσεν",704303,2],["αὐτοὺς",702165,62],["ἐν",704639,0],["τῷ",709436,113],["Αμαληκ",700759,114],["ὀπίσω",709697,0],["σου",711945,133],["Βενιαμιν",702650,153],["ἐν",704639,0],["τοῖς",709436,147],["λαοῖς",708094,148],["σου",711945,133],["ἐν",704639,0],["ἐμοὶ",704577,159],["Μαχιρ",708604,111],["κατέβησαν",707202,150],["ἐξερευνῶντες",704905,146],["καὶ",707031,7],["ἀπὸ",701425,0],["Ζαβουλων",705813,18],["ἕλκοντες",704508,146],["ἐν",704639,0],["ῥάβδῳ",711135,1],["διηγήσεως",703681,17,1],["γραμματέως",703185,18]],"Ephraim rooted them out in Amalec, behind thee was Benjamin among thy people: the inhabitants of Machir came down with me searching out the enemy, and from Zabulon came they that draw with the scribe's pen of record."],["15",[["καὶ",707031,7],["ἀρχηγοὶ",701838,52],["ἐν",704639,0],["Ισσαχαρ",706843,114],["μετὰ",708780,0],["Δεββωρας",703305,17],["καὶ",707031,7],["Βαρακ",702523,18],["οὕτως",709859,28],["Βαρακ",702523,4],["ἐν",704639,0],["κοιλάσιν",707758,76],["ἀπέστειλεν",701592,2],["ἐν",704639,0],["ποσὶν",710707,148],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὰς",709436,38],["μερίδας",708748,39],["Ρουβην",711295,18],["μεγάλοι",708653,138],["ἐξικνούμενοι",704930,348],["καρδίαν",707141,9]],"And princes in Issachar were with Debbora and Barac, thus she sent Barac on his feet in the valleys into the portions of Ruben; great [pangs] reached to the heart."],["16",[["εἰς",704105,0],["τί",712867,126],["ἐκάθισαν",707006,150],["ἀνὰ",700902,0],["μέσον",708768,46],["τῆς",709436,16],["διγομίας",703645,17],["τοῦ",709436,20],["ἀκοῦσαι",700587,106],["συρισμοῦ",712539,18],["ἀγγέλων",700140,81],["εἰς",704105,0],["διαιρέσεις",703458,39],["Ρουβην",711295,18],["μεγάλοι",708653,138],["ἐξετασμοὶ",704913,52],["καρδίας",707141,17]],"Why did they sit between the sheep-folds to hear the bleating of flocks for the divisions of Ruben? [there were] great searchings of heart."],["17",[["Γαλααδ",702920,4],["ἐν",704639,0],["τῷ",709436,113],["πέραν",710280,0],["τοῦ",709436,35],["Ιορδάνου",706763,18],["ἐσκήνωσεν",711848,2],["καὶ",707031,7],["Δαν",703276,4],["εἰς",704105,0],["τί",712867,126],["παροικεῖ",710156,91],["πλοίοις",710556,96],["Ασηρ",701934,4],["ἐκάθισεν",707006,2],["παραλίαν",710063,36],["θαλασσῶν",706069,65],["καὶ",707031,7],["ἐπὶ",705080,0],["διεξόδοις",703668,76],["αὐτοῦ",702165,102],["σκηνώσει",711848,127]],"Galaad [is] on the other side of Jordan where he pitched his tents; and why does Dan remain in ships? Aser sat down on the sea-coasts, and he will tabernacle at his ports."],["18",[["Ζαβουλων",705813,4],["λαὸς",708094,4],["ὠνείδισεν",709655,2],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["εἰς",704105,0],["θάνατον",706096,6],["καὶ",707031,7],["Νεφθαλι",709279,4],["ἐπὶ",705080,0],["ὕψη",713288,42],["ἀγροῦ",700196,18]],"The people Zabulon exposed their soul to death, and Nephthali came to the high places of their land."],["19",[["ἦλθον",705453,150],["αὐτῶν",702165,40],["βασιλεῖς",702580,52],["παρετάξαντο",710108,189],["τότε",712908,28],["ἐπολέμησαν",710601,150],["βασιλεῖς",702580,52],["Χανααν",713708,118],["ἐν",704639,0],["Θανααχ",706092,111],["ἐπὶ",705080,0],["ὕδατι",713071,54],["Μεγεδδω",708654,118],["δῶρον",703907,25],["ἀργυρίου",701707,21],["οὐκ",709805,28],["ἔλαβον",708076,150]],"Kings set themselves in array, then the kings of Chanaan fought in Thanaach at the water of Mageddo; they took no gift of money."],["20",[["ἐξ",704132,0],["οὐρανοῦ",709844,18],["παρετάξαντο",710108,189],["οἱ",709436,136],["ἀστέρες",702017,52],["ἐκ",704132,0],["τρίβων",712939,81],["αὐτῶν",702165,40],["παρετάξαντο",710108,189],["μετὰ",708780,0],["Σισαρα",711803,18]],"The stars from heaven set themselves in array, they set themselves [to fight] with Sisara out of their paths."],["21",[["χειμάρρους",713783,57],["Κισων",707695,4],["ἐξέσυρεν",704318,2],["αὐτούς",702165,62],["χειμάρρους",713783,57],["ἀρχαίων",701835,169],["χειμάρρους",713783,4],["Κισων",707695,4],["καταπατήσει",707360,127],["αὐτὸν",702165,85],["ψυχή",714070,12],["μου",709032,133],["δυνατή",703845,29]],"The brook of Kison swept them away, the ancient brook, the brook Kison: my mighty soul will trample him down."],["22",[["τότε",712908,28],["ἐνεποδίσθησαν",704604,99],["πτέρναι",711050,191],["ἵππου",706790,18],["σπουδῇ",712035,1],["ἔσπευσαν",712011,150],["ἰσχυροὶ",706855,138],["αὐτοῦ",702165,102]],"When the hoofs of the horse were entangled, his mighty ones earnestly hasted"],["23",[["καταρᾶσθε",707396,73],["Μηρωζ",708889,9],["εἶπεν",705373,2],["ἄγγελος",700140,4],["κυρίου",707996,18],["καταρᾶσθε",707396,73],["ἐπικατάρατος",705159,14],["πᾶς",710177,14],["ὁ",709436,3],["κατοικῶν",707534,72],["αὐτήν",702165,104],["ὅτι",709803,7],["οὐκ",709805,28],["ἤλθοσαν",705453,150],["εἰς",704105,0],["βοήθειαν",702745,9],["κυρίου",707996,18],["εἰς",704105,0],["βοήθειαν",702745,9],["ἐν",704639,0],["δυνατοῖς",703845,230]],"to curse Meroz: Curse ye [it], said the angel of the Lord; cursed [is] every one that dwells in it, because they came not to the help of the Lord, to his help among the mighty."],["24",[["εὐλογηθείη",705631,528],["ἐν",704639,0],["γυναιξὶν",703209,76],["Ιαηλ",706386,12],["γυνὴ",703209,12],["Χαβερ",713650,18],["τοῦ",709436,35],["Κιναίου",707675,18],["ἀπὸ",701425,0],["γυναικῶν",703209,65],["ἐν",704639,0],["σκηναῖς",711845,76],["εὐλογηθείη",705631,528]],"Blessed among women be Jael wife of Chaber the Kenite; let her be blessed above women in tents."],["25",[["ὕδωρ",713071,25],["ᾔτησεν",700489,2],["γάλα",702919,25],["ἔδωκεν",703654,2],["ἐν",704639,0],["λεκάνῃ",708140,1],["ὑπερεχόντων",713134,170],["προσήνεγκεν",710974,2],["βούτυρον",702800,25]],"He asked for water, she gave him milk in a dish; she brought butter of princes."],["26",[["χεῖρα",713787,9],["αὐτῆς",702165,86],["ἀριστερὰν",701749,36],["εἰς",704105,0],["πάσσαλον",710178,6],["ἐξέτεινεν",704322,2],["καὶ",707031,7],["δεξιὰν",703360,36],["αὐτῆς",702165,86],["εἰς",704105,0],["σφῦραν",712592,9],["κοπιώντων",707824,170],["καὶ",707031,7],["ἐσφυροκόπησεν",712593,2],["Σισαρα",711803,6],["διήλωσεν",703684,2],["κεφαλὴν",707639,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπάταξεν",710185,2],["διήλωσεν",703684,2],["κρόταφον",707917,6],["αὐτοῦ",702165,102]],"She stretched forth her left hand to the nail, and her right hand to the workman's hammer, and she smote Sisara with it, she nailed through his head and smote him; she nailed through his temples."],["27",[["ἀνὰ",700902,0],["μέσον",708768,46],["τῶν",709436,80],["ποδῶν",710707,81],["αὐτῆς",702165,86],["κατεκυλίσθη",707295,37],["ἔπεσεν",710481,2],["καὶ",707031,7],["ἐκοιμήθη",707767,37],["ἀνὰ",700902,0],["μέσον",708768,46],["τῶν",709436,80],["ποδῶν",710707,81],["αὐτῆς",702165,86],["κατακλιθεὶς",707276,217],["ἔπεσεν",710481,2],["καθὼς",707030,28],["κατεκλίθη",707276,37],["ἐκεῖ",704181,28],["ἔπεσεν",710481,2],["ἐξοδευθείς",704943,217]],"He rolled down between her feet; he fell and lay between her feet; he bowed and fell: where he bowed, there he fell dead."],["28",[["διὰ",703417,0],["τῆς",709436,16],["θυρίδος",706340,17],["παρέκυψεν",710057,2],["μήτηρ",708892,12],["Σισαρα",711803,18],["ἐκτὸς",704339,0],["τοῦ",709436,35],["τοξικοῦ",712897,116],["διότι",703734,7],["ᾐσχύνθη",700485,37],["ἅρμα",701768,25],["αὐτοῦ",702165,102],["διότι",703734,7],["ἐχρόνισαν",713967,150],["πόδες",710707,52],["ἁρμάτων",701768,44],["αὐτοῦ",702165,102]],"The mother of Sisara looked down through the window out of the loophole, [saying], Why was his chariot ashamed? why did the wheels of his chariots tarry?"],["29",[["αἱ",709436,190],["σοφαὶ",711985,192],["ἄρχουσαι",701860,306],["αὐτῆς",702165,86],["ἀπεκρίθησαν",701492,99],["πρὸς",710844,0],["αὐτήν",702165,104],["καὶ",707031,7],["αὐτὴ",702165,107],["ἀπέστρεψεν",701598,2],["λόγους",708236,57],["αὐτῆς",702165,86],["ἑαυτῇ",703917,105]],"Her wise ladies answered her, and she returned answers to herself, [saying],"],["30",[["οὐχ",709805,28],["εὑρήσουσιν",705676,218],["αὐτὸν",702165,85],["διαμερίζοντα",703518,183],["σκῦλα",711902,42],["οἰκτίρμων",709521,14],["οἰκτιρήσει",709518,127],["εἰς",704105,0],["κεφαλὴν",707639,9],["ἀνδρός",701150,18],["σκῦλα",711902,42],["βαμμάτων",702497,44],["τῷ",709436,113],["Σισαρα",711803,114],["σκῦλα",711902,42],["βαμμάτων",702497,44],["ποικιλίας",710586,17],["βάμματα",702497,42],["ποικιλτῶν",710590,81],["αὐτά",702165,71],["τῷ",709436,113],["τραχήλῳ",712924,114],["αὐτοῦ",702165,102],["σκῦλα",711902,42]],"Will they not find him dividing the spoil? he will surely be gracious to every man: [there are] spoils of dyed garments for Sisara, spoils of various dyed garments, dyed embroidered garments, they [are] the spoils for his neck."],["31",[["οὕτως",709859,28],["ἀπόλοιντο",701513,529],["πάντες",710177,138],["οἱ",709436,136],["ἐχθροί",705779,52],["σου",711945,133],["κύριε",707996,153],["καὶ",707031,7],["οἱ",709436,136],["ἀγαπῶντες",700120,146],["αὐτὸν",702165,85],["ὡς",714148,7],["ἔξοδος",704948,12],["ἡλίου",705974,18],["ἐν",704639,0],["δυνάμει",703839,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἡσύχασεν",706033,2],["ἡ",709436,10],["γῆ",703083,12],["τεσσαράκοντα",712806,59],["ἔτη",705543,42]],"Thus let all thine enemies perish, O Lord: and they that love him shall be as the going forth of the sun in his strength. And the land had rest forty years."]]