[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["μετὰ",708780,0],["τὴν",709436,8],["τελευτὴν",712782,9],["Ἰησοῦ",706701,18],["καὶ",707031,7],["ἐπηρώτων",705069,137],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["διὰ",703417,0],["τοῦ",709436,35],["κυρίου",707996,18],["λέγοντες",708124,146],["τίς",712867,158],["ἀναβήσεται",700905,93],["ἡμῖν",705994,90],["πρὸς",710844,0],["τοὺς",709436,58],["Χαναναίους",713711,57],["ἀφηγούμενος",702203,122],["τοῦ",709436,20],["πολεμῆσαι",710601,106],["πρὸς",710844,0],["αὐτούς",702165,62]],"And it came to pass after the death of Joshua, that the children of Israel enquired of the Lord, saying, Who shall go up for us first against the Chananites, to fight against them?"],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["Ιουδας",706775,4],["ἀναβήσεται",700905,93],["ἰδοὺ",706497,88],["δέδωκα",703654,89],["τὴν",709436,8],["γῆν",703083,9],["ἐν",704639,0],["τῇ",709436,100],["χειρὶ",713787,1],["αὐτοῦ",702165,102]],"And the Lord said, Judas shall go up: behold, I have delivered the land into his hand."],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιουδας",706775,4],["τῷ",709436,113],["Συμεων",712297,114],["ἀδελφῷ",700249,114],["αὐτοῦ",702165,102],["ἀνάβηθι",700905,176],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["ἐν",704639,0],["τῷ",709436,113],["κλήρῳ",707727,114],["μου",709032,133],["καὶ",707031,7],["παραταξώμεθα",710108,276],["πρὸς",710844,0],["τοὺς",709436,58],["Χαναναίους",713711,57],["καὶ",707031,7],["πορεύσομαι",710667,181],["κἀγὼ",706969,288],["μετὰ",708780,0],["σοῦ",711945,133],["ἐν",704639,0],["τῷ",709436,113],["κλήρῳ",707727,114],["σου",711945,133],["καὶ",707031,7],["ἐπορεύθη",710667,37],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["Συμεων",712297,4]],"And Judas said to his brother Symeon, Come up with me into my lot, and let us array ourselves against the Chananites, and I also will go with thee into thy lot: and Symeon went with him."],["4",[["καὶ",707031,7],["ἀνέβη",700905,2],["Ιουδας",706775,4],["καὶ",707031,7],["π