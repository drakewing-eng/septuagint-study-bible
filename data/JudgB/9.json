[["1",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["Αβιμελεχ",700068,4],["υἱὸς",713075,4],["Ιεροβααλ",706627,18],["εἰς",704105,0],["Συχεμ",712565,6],["πρὸς",710844,0],["ἀδελφοὺς",700249,57],["μητρὸς",708892,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐλάλησεν",708071,2],["πρὸς",710844,0],["αὐτοὺς",702165,62],["καὶ",707031,7],["πρὸς",710844,0],["πᾶσαν",710177,36],["συγγένειαν",712184,9],["οἴκου",709516,18],["πατρὸς",710189,18],["μητρὸς",708892,17],["αὐτοῦ",702165,102],["λέγων",708124,72]],"And Abimelech son of Jerobaal went to Sychem to his mother's brethren; and he spoke to them and to all the kindred of the house of his mother's father, saying,"],["2",[["λαλήσατε",708071,74],["δὴ",703395,11],["ἐν",704639,0],["τοῖς",709436,95],["ὠσὶν",709852,96],["πάντων",710177,169],["τῶν",709436,80],["ἀνδρῶν",701150,81],["Συχεμ",712565,18],["τί",712867,273],["τὸ",709436,34],["ἀγαθὸν",700106,26],["ὑμῖν",713084,90],["κυριεῦσαι",707995,106],["ὑμῶν",713091,145],["ἑβδομήκοντα",703922,59],["ἄνδρας",701150,57],["πάντας",710177,60],["υἱοὺς",713075,57],["Ιεροβααλ",706627,18],["ἢ",705924,7],["κυριεύειν",707995,55],["ὑμῶν",713091,145],["ἄνδρα",701150,6],["ἕνα",704106,27],["καὶ",707031,7],["μνήσθητε",708960,394],["ὅτι",709803,7],["ὀστοῦν",709792,15],["ὑμῶν",713091,145],["καὶ",707031,7],["σὰρξ",711537,12],["ὑμῶν",713091,145],["εἰμι",704093,157]],"Speak, I pray you, in the ears of all the men of Sychem, saying, Which [is] better for you, that seventy men, even all the sons of Jerobaal, should reign over you, or that one man should reign over you? and remember that I am your bone and your flesh."],["3",[["καὶ",707031,7],["ἐλάλησαν",708071,150],["περὶ",710285,0],["αὐτοῦ",702165,102],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["τῆς",709436,16],["μητρὸς",708892,17],["αὐτοῦ",702165,102],["ἐν",704639,0],["τοῖς",709436,95],["ὠσὶν",709852,96],["πάντων",710177,169],["τῶν",709436,80],["ἀνδρῶν",701150,81],["Συχεμ",712565,18],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["καὶ",707031,7],["ἔκλινεν",707738,13],["ἡ",709436,10],["καρδία",707141,12],["αὐτῶν",702165,40],["ὀπίσω",709697,0],["Αβιμελεχ",700068,18],["ὅτι",709803,7],["εἶπαν",705373,150],["ἀδελφὸς",700249,4],["ἡμῶν",705999,145],["ἐστιν",704093,91]],"And his mother's brethren spoke concerning him in the ears of all the men of Sychem all these words; and their heart turned after Abimelech, for they said, He is our brother."],["4",[["καὶ",707031,7],["ἔδωκαν",703654,150],["αὐτῷ",702165,50],["ἑβδομήκοντα",703922,59],["ἀργυρίου",701707,21],["ἐξ",704132,0],["οἴκου",709516,18],["Βααλβεριθ",702336,18],["καὶ",707031,7],["ἐμισθώσατο",708940,23],["ἑαυτῷ",703917,50],["Αβιμελεχ",700068,4],["ἄνδρας",701150,57],["κενοὺς",707612,60],["καὶ",707031,7],["δειλούς",703324,60],["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["ὀπίσω",709697,0],["αὐτοῦ",702165,102]],"And they gave him seventy [pieces] of silver out of the house of Baalberith; and Abimelech hired for himself vain and cowardly men, and they went after him."],["5",[["καὶ",707031,7],["εἰσῆλθεν",704114,2],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["εἰς",704105,0],["Εφραθα",705765,227],["καὶ",707031,7],["ἀπέκτεινεν",701498,2],["τοὺς",709436,58],["ἀδελφοὺς",700249,57],["αὐτοῦ",702165,102],["υἱοὺς",713075,57],["Ιεροβααλ",706627,18],["ἑβδομήκοντα",703922,59],["ἄνδρας",701150,57],["ἐπὶ",705080,0],["λίθον",708196,6],["ἕνα",704106,27],["καὶ",707031,7],["κατελείφθη",707305,37],["Ιωαθαν",706886,4],["υἱὸς",713075,4],["Ιεροβααλ",706627,18],["ὁ",709436,3],["νεώτερος",709256,224],["ὅτι",709803,7],["ἐκρύβη",707923,37]],"And he went to the house of his father to Ephratha, and slew his brethren the sons of Jerobaal, seventy men upon one stone; but Joatham the youngest son of Jerobaal was left, for he hid himself."],["6",[["καὶ",707031,7],["συνήχθησαν",712375,99],["πάντες",710177,138],["ἄνδρες",701150,52],["Σικιμων",711783,81],["καὶ",707031,7],["πᾶς",710177,14],["οἶκος",709516,4],["Βηθμααλων",702691,118],["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["καὶ",707031,7],["ἐβασίλευσαν",702581,150],["τὸν",709436,5],["Αβιμελεχ",700068,6],["πρὸς",710844,0],["τῇ",709436,100],["βαλάνῳ",702477,1],["τῇ",709436,100],["εὑρετῇ",705674,101],["τῆς",709436,16],["στάσεως",712049,17],["τῆς",709436,16],["ἐν",704639,0],["Σικιμοις",711783,148]],"And all the men of Sicima, and all the house of Bethmaalo, were gathered together, and they went and made Abimelech king by the oak of Sedition, which was at Sicima."],["7",[["καὶ",707031,7],["ἀνηγγέλη",700921,37],["τῷ",709436,113],["Ιωαθαν",706886,114],["καὶ",707031,7],["ἐπορεύθη",710667,37],["καὶ",707031,7],["ἔστη",706846,2],["ἐπὶ",705080,0],["κορυφὴν",707844,9],["ὄρους",709768,21],["Γαριζιν",702970,118],["καὶ",707031,7],["ἐπῆρεν",705002,2],["τὴν",709436,8],["φωνὴν",713640,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔκλαυσεν",707703,2],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["ἀκούσατέ",700587,74],["μου",709032,133],["ἄνδρες",701150,52],["Σικιμων",711783,81],["καὶ",707031,7],["ἀκούσεται",700587,93],["ὑμῶν",713091,145],["ὁ",709436,3],["θεός",706192,4]],"And it was reported to Joatham, and he went and stood on the top of mount Garizin, and lifted up his voice, and wept, and said to them, Hear me, ye men of Sicima, and God shall hear you."],["8",[["πορευόμενα",710667,210],["ἐπορεύθη",710667,37],["τὰ",709436,63],["ξύλα",709427,64],["τοῦ",709436,20],["χρῖσαι",713965,106],["ἐφ᾿",705080,0],["ἑαυτὰ",703917,71],["βασιλέα",702580,6],["καὶ",707031,7],["εἶπον",705373,150],["τῇ",709436,100],["ἐλαίᾳ",704376,1],["βασίλευσον",702581,176],["ἐφ᾿",705080,0],["ἡμῶν",705999,145]],"The trees went forth on a time to anoint a king over them; and they said to the olive, Reign over us."],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["ἡ",709436,10],["ἐλαία",704376,12],["μὴ",708851,28],["ἀπολείψασα",701508,149],["τὴν",709436,8],["πιότητά",710479,9],["μου",709032,133],["ἐν",704639,0],["ᾗ",709781,108],["δοξάσουσι",703792,218],["τὸν",709436,5],["θεὸν",706192,6],["ἄνδρες",701150,52],["πορεύσομαι",710667,181],["κινεῖσθαι",707679,110],["ἐπὶ",705080,0],["τῶν",709436,43],["ξύλων",709427,44]],"But the olive said to them, Shall I leave my fatness, with which men shall glorify God, and go to be promoted over the trees?"],["10",[["καὶ",707031,7],["εἶπον",705373,150],["τὰ",709436,63],["ξύλα",709427,64],["τῇ",709436,100],["συκῇ",712254,1],["δεῦρο",703382,28],["βασίλευσον",702581,176],["ἐφ᾿",705080,0],["ἡμῶν",705999,145]],"And the trees said to the fig-tree, Come, reign over us."],["11",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["ἡ",709436,10],["συκῆ",712254,12],["μὴ",708851,28],["ἀπολείψασα",701508,149],["ἐγὼ",704018,164],["τὴν",709436,8],["γλυκύτητά",703115,9],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,41],["γενήματά",703052,42],["μου",709032,133],["τὰ",709436,41],["ἀγαθὰ",700106,68],["πορεύσομαι",710667,181],["κινεῖσθαι",707679,110],["ἐπὶ",705080,0],["τῶν",709436,43],["ξύλων",709427,44]],"But the fig-tree said to them, Shall I leave my sweetness and my good fruits, and go to be promoted over the trees?"],["12",[["καὶ",707031,7],["εἶπαν",705373,150],["τὰ",709436,63],["ξύλα",709427,64],["πρὸς",710844,0],["τὴν",709436,8],["ἄμπελον",700870,9],["δεῦρο",703382,28],["σὺ",712181,164],["βασίλευσον",702581,176],["ἐφ᾿",705080,0],["ἡμῶν",705999,145]],"And the trees said to the vine, Come, reign over us."],["13",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["ἡ",709436,10],["ἄμπελος",700870,12],["μὴ",708851,28],["ἀπολείψασα",701508,149],["τὸν",709436,5],["οἶνόν",709530,6],["μου",709032,133],["τὸν",709436,5],["εὐφραίνοντα",705715,183],["θεὸν",706192,6],["καὶ",707031,7],["ἀνθρώπους",701163,57],["πορεύσομαι",710667,181],["κινεῖσθαι",707679,110],["ἐπὶ",705080,0],["τῶν",709436,43],["ξύλων",709427,44]],"And the vine said to them, Shall I leave my wine that cheers God and men, and go to be promoted over the trees?"],["14",[["καὶ",707031,7],["εἶπαν",705373,150],["πάντα",710177,195],["τὰ",709436,63],["ξύλα",709427,64],["τῇ",709436,100],["ῥάμνῳ",711172,1],["δεῦρο",703382,28],["σὺ",712181,164],["βασίλευσον",702581,176],["ἐφ᾿",705080,0],["ἡμῶν",705999,145]],"Then all the trees said to the bramble, Come thou [and] reign over us."],["15",[["καὶ",707031,7],["εἶπεν",705373,2],["ἡ",709436,10],["ῥάμνος",711172,12],["πρὸς",710844,0],["τὰ",709436,41],["ξύλα",709427,42],["εἰ",704071,11],["ἐν",704639,0],["ἀληθείᾳ",700656,1],["χρίετέ",713965,87],["με",708618,163],["ὑμεῖς",713081,219],["τοῦ",709436,20],["βασιλεύειν",702581,55],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["δεῦτε",703383,28],["ὑπόστητε",713281,74],["ἐν",704639,0],["τῇ",709436,100],["σκιᾷ",711852,1],["μου",709032,133],["καὶ",707031,7],["εἰ",704071,11],["μή",708851,28],["ἐξέλθῃ",704909,172],["πῦρ",711088,15],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["καταφάγῃ",707519,172],["τὰς",709436,38],["κέδρους",707590,39],["τοῦ",709436,35],["Λιβάνου",708185,18]],"And the bramble said to the trees, If ye in truth anoint me to reign over you, come, stand under my shadow; and if not, let fire come out from me and devour the cedars of Libanus."],["16",[["καὶ",707031,7],["νῦν",709384,28],["εἰ",704071,11],["ἐν",704639,0],["ἀληθείᾳ",700656,1],["καὶ",707031,7],["τελειότητι",712770,1],["ἐποιήσατε",710582,265],["καὶ",707031,7],["ἐβασιλεύσατε",702581,265],["τὸν",709436,5],["Αβιμελεχ",700068,6],["καὶ",707031,7],["εἰ",704071,11],["ἀγαθωσύνην",700111,9],["ἐποιήσατε",710582,265],["μετὰ",708780,0],["Ιεροβααλ",706627,18],["καὶ",707031,7],["μετὰ",708780,0],["τοῦ",709436,35],["οἴκου",709516,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἰ",704071,11],["ὡς",714148,7],["ἀνταπόδοσις",701217,12],["χειρὸς",713787,17],["αὐτοῦ",702165,102],["ἐποιήσατε",710582,265],["αὐτῷ",702165,50]],"And now, if ye have done it in truth and integrity, and have made Abimelech king, and if ye have wrought well with Jerobaal, and with his house, and if ye have done to him according to the reward of his hand,"],["17",[["ὡς",714148,7],["παρετάξατο",710108,23],["ὁ",709436,3],["πατήρ",710189,4],["μου",709032,133],["ὑπὲρ",713111,0],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐξέρριψεν",704306,2],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["ἐξ",704132,0],["ἐναντίας",704656,82],["καὶ",707031,7],["ἐρρύσατο",711309,23],["ὑμᾶς",713080,194],["ἐκ",704132,0],["χειρὸς",713787,17],["Μαδιαμ",708355,17]],"as my father fought for you, and put his life in jeopardy, and delivered you out of the hand of Madiam;"],["18",[["καὶ",707031,7],["ὑμεῖς",713081,219],["ἐπανέστητε",705026,265],["ἐπὶ",705080,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133],["σήμερον",711751,28],["καὶ",707031,7],["ἀπεκτείνατε",701498,265],["τοὺς",709436,58],["υἱοὺς",713075,57],["αὐτοῦ",702165,102],["ἑβδομήκοντα",703922,59],["ἄνδρας",701150,57],["ἐπὶ",705080,0],["λίθον",708196,6],["ἕνα",704106,27],["καὶ",707031,7],["ἐβασιλεύσατε",702581,265],["τὸν",709436,5],["Αβιμελεχ",700068,6],["υἱὸν",713075,6],["παιδίσκης",709928,17],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἄνδρας",701150,57],["Σικιμων",711783,81],["ὅτι",709803,7],["ἀδελφὸς",700249,4],["ὑμῶν",713091,145],["ἐστιν",704093,91]],"and ye are risen up this day against the house of my father, and have slain his sons, being seventy men, upon one stone, and have made Abimelech the son of his bondwoman king over the men of Sicima, because he is your brother:"],["19",[["καὶ",707031,7],["εἰ",704071,11],["ἐν",704639,0],["ἀληθείᾳ",700656,1],["καὶ",707031,7],["τελειότητι",712770,1],["ἐποιήσατε",710582,265],["μετὰ",708780,0],["Ιεροβααλ",706627,18],["καὶ",707031,7],["μετὰ",708780,0],["τοῦ",709436,35],["οἴκου",709516,18],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ταύτῃ",709858,105],["εὐφρανθείητε",705715,531],["ἐν",704639,0],["Αβιμελεχ",700068,114],["καὶ",707031,7],["εὐφρανθείη",705715,528],["καί",707031,7],["γε",702985,11],["αὐτὸς",702165,121],["ἐφ᾿",705080,0],["ὑμῖν",713084,90]],"if then ye have done truly and faithfully with Jerobaal, and with his house this day, rejoice ye in Abimelech, and let him also rejoice over you:"],["20",[["εἰ",704071,11],["δὲ",703303,11],["οὐ",709805,28],["ἐξέλθοι",704909,225],["πῦρ",711088,15],["ἀπὸ",701425,0],["Αβιμελεχ",700068,6],["καὶ",707031,7],["φάγοι",713296,225],["τοὺς",709436,58],["ἄνδρας",701150,57],["Σικιμων",711783,81],["καὶ",707031,7],["τὸν",709436,5],["οἶκον",709516,6],["Βηθμααλλων",702690,118],["καὶ",707031,7],["ἐξέλθοι",704909,225],["πῦρ",711088,15],["ἀπὸ",701425,0],["ἀνδρῶν",701150,81],["Σικιμων",711783,81],["καὶ",707031,7],["ἐκ",704132,0],["τοῦ",709436,35],["οἴκου",709516,18],["Βηθμααλλων",702690,118],["καὶ",707031,7],["καταφάγοι",707519,225],["τὸν",709436,5],["Αβιμελεχ",700068,6]],"but if not, let fire come out from Abimelech, and devour the men of Sicima, and the house of Beth-maalo; and let fire come out from the men of Sicima and from the house of Beth-maalo, and devour Abimelech."],["21",[["καὶ",707031,7],["ἔφυγεν",713433,2],["Ιωαθαν",706886,4],["καὶ",707031,7],["ἀπέδρα",701448,2],["καὶ",707031,7],["ἐπορεύθη",710667,37],["ἕως",705792,0],["Βαιηρ",702385,18],["καὶ",707031,7],["ᾤκησεν",709499,2],["ἐκεῖ",704181,28],["ἀπὸ",701425,0],["προσώπου",710986,21],["Αβιμελεχ",700068,18],["ἀδελφοῦ",700249,18],["αὐτοῦ",702165,102]],"And Joatham fled, and ran away, and went as far as Bæer, and dwelt there out of the way of his brother Abimelech."],["22",[["καὶ",707031,7],["ἦρξεν",701860,2],["Αβιμελεχ",700068,4],["ἐπὶ",705080,0],["Ισραηλ",706839,6],["τρία",712927,68],["ἔτη",705543,42]],"And Abimelech reigned over Israel three years."],["23",[["καὶ",707031,7],["ἐξαπέστειλεν",704872,2],["ὁ",709436,3],["θεὸς",706192,4],["πνεῦμα",710566,25],["πονηρὸν",710660,46],["ἀνὰ",700902,0],["μέσον",708768,27],["Αβιμελεχ",700068,18],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,27],["τῶν",709436,80],["ἀνδρῶν",701150,81],["Σικιμων",711783,81],["καὶ",707031,7],["ἠθέτησαν",700369,150],["ἄνδρες",701150,52],["Σικιμων",711783,81],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["Αβιμελεχ",700068,18]],"And God sent an evil spirit between Abimelech and the men of Sicima; and the men of Sicima dealt treacherously with the house of Abimelech:"],["24",[["τοῦ",709436,20],["ἐπαγαγεῖν",704994,106],["τὴν",709436,8],["ἀδικίαν",700271,9],["τῶν",709436,80],["ἑβδομήκοντα",703922,59],["υἱῶν",713075,81],["Ιεροβααλ",706627,18],["καὶ",707031,7],["τὰ",709436,41],["αἵματα",700442,42],["αὐτῶν",702165,40],["τοῦ",709436,20],["θεῖναι",712849,106],["ἐπὶ",705080,0],["Αβιμελεχ",700068,6],["τὸν",709436,5],["ἀδελφὸν",700249,6],["αὐτῶν",702165,40],["ὃς",709781,213],["ἀπέκτεινεν",701498,2],["αὐτούς",702165,62],["καὶ",707031,7],["ἐπὶ",705080,0],["ἄνδρας",701150,57],["Σικιμων",711783,81],["ὅτι",709803,7],["ἐνίσχυσαν",704750,150],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτοῦ",702165,102],["ἀποκτεῖναι",701498,106],["τοὺς",709436,58],["ἀδελφοὺς",700249,57],["αὐτοῦ",702165,102]],"to bring the injury done to the seventy sons of Jerobaal, and to lay their blood upon their brother Abimelech, who slew them, and upon the men of Sicima, because they strengthened his hands to slay his brethren."],["25",[["καὶ",707031,7],["ἔθηκαν",712849,150],["αὐτῷ",702165,50],["οἱ",709436,136],["ἄνδρες",701150,52],["Σικιμων",711783,81],["ἐνεδρεύοντας",704703,235],["ἐπὶ",705080,0],["τὰς",709436,38],["κεφαλὰς",707639,39],["τῶν",709436,43],["ὀρέων",709768,44],["καὶ",707031,7],["διήρπαζον",703562,137],["πάντα",710177,27],["ὃς",709781,213],["παρεπορεύετο",710094,19],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["καὶ",707031,7],["ἀπηγγέλη",701321,37],["τῷ",709436,113],["βασιλεῖ",702580,114],["Αβιμελεχ",700068,114]],"And the men of Sicima set liers in wait against him on the top of the mountains, and robbed every one who passed by them on the way; and it was reported to the king Abimelech."],["26",[["καὶ",707031,7],["ἦλθεν",705453,2],["Γααλ",702843,4],["υἱὸς",713075,4],["Ιωβηλ",706906,18],["καὶ",707031,7],["οἱ",709436,136],["ἀδελφοὶ",700249,5