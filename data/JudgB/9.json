,708882,28],["εἴπωσιν",705373,234],["γυνὴ",703209,12],["ἀπέκτεινεν",701498,2],["αὐτόν",702165,85],["καὶ",707031,7],["ἐξεκέντησεν",704211,2],["αὐτὸν",702165,85],["τὸ",709436,34],["παιδάριον",709923,15],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀπέθανεν",701461,2]],"And he cried out quickly to the young man his armour-bearer, and said to him, Draw thy sword, and slay me, lest at any time they should say, A woman slew him: and his young man thrust him through and he died."],["55",[["καὶ",707031,7],["εἶδεν",709725,2],["ἀνὴρ",701150,4],["Ισραηλ",706839,18],["ὅτι",709803,7],["ἀπέθανεν",701461,2],["Αβιμελεχ",700068,4],["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["ἀνὴρ",701150,4],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["αὐτοῦ",702165,102]],"And the men of Israel saw that Abimelech was dead; and they went each to his place."],["56",[["καὶ",707031,7],["ἐπέστρεψεν",705278,2],["ὁ",709436,3],["θεὸς",706192,4],["τὴν",709436,8],["πονηρίαν",710659,9],["Αβιμελεχ",700068,18],["ἣν",709781,131],["ἐποίησεν",710582,2],["τῷ",709436,113],["πατρὶ",710189,114],["αὐτοῦ",702165,102],["ἀποκτεῖναι",701498,106],["τοὺς",709436,58],["ἑβδομήκοντα",703922,59],["ἀδελφοὺς",700249,57],["αὐτοῦ",702165,102]],"So God requited the wickedness of Abimelech, which he wrought against his father, in slaying his seventy brethren."],["57",[["καὶ",707031,7],["τὴν",709436,8],["πᾶσαν",710177,36],["πονηρίαν",710659,9],["ἀνδρῶν",701150,81],["Συχεμ",712565,18],["ἐπέστρεψεν",705278,2],["ὁ",709436,3],["θεὸς",706192,4],["εἰς",704105,0],["κεφαλὴν",707639,9],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπῆλθεν",705068,2],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["ἡ",709436,10],["κατάρα",707395,12],["Ιωαθαν",706886,18],["υἱοῦ",713075,18],["Ιεροβααλ",706627,18]],"And all the wickedness of the men of Sychem God requited upon their head; and the curse of Joatham the son of Jerobaal came upon them."]]