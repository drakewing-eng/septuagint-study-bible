[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["μεθ᾿",708780,0],["ἡμέρας",705984,39],["ἐν",704639,0],["ἡμέραις",705984,76],["θερισμοῦ",706208,18],["πυρῶν",711089,65],["καὶ",707031,7],["ἐπεσκέψατο",705250,23],["Σαμψων",711482,4],["τὴν",709436,8],["γυναῖκα",703209,9],["αὐτοῦ",702165,102],["ἐν",704639,0],["ἐρίφῳ",705429,114],["αἰγῶν",700464,81],["καὶ",707031,7],["εἶπεν",705373,2],["εἰσελεύσομαι",704114,181],["πρὸς",710844,0],["τὴν",709436,8],["γυναῖκά",703209,9],["μου",709032,133],["εἰς",704105,0],["τὸ",709436,24],["ταμιεῖον",712700,25],["καὶ",707031,7],["οὐκ",709805,28],["ἔδωκεν",703654,2],["αὐτὸν",702165,85],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτῆς",702165,86],["εἰσελθεῖν",704114,106]],"And it came to pass after a time, in the days of wheat harvest, that Sampson visited his wife with a kid, and said, I will go in to my wife even into the chamber: but her father did not suffer him to go in."],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτῆς",702165,86],["λέγων",708124,72],["εἶπα",705373,155],["ὅτι",709803,7],["μισῶν",708935,72],["ἐμίσησας",708935,162],["αὐτήν",702165,104],["καὶ",707031,7],["ἔδωκα",703654,155],["αὐτὴν",702165,104],["ἑνὶ",704106,30],["τῶν",709436,80],["ἐκ",704132,0],["τῶν",709436,80],["φίλων",713492,169],["σου",711945,133],["μὴ",708851,28],["οὐχὶ",709862,28],["ἡ",709436,10],["ἀδελφὴ",700244,12],["αὐτῆς",702165,86],["ἡ",709436,10],["νεωτέρα",709256,484],["αὐτῆς",702165,86],["ἀγαθωτέρα",700106,484],["ὑπὲρ",713111,0],["αὐτήν",702165,104],["ἔστω",704093,31],["δή",703395,11],["σοι",711925,159],["ἀντὶ",701227,0],["αὐτῆς",702165,86]],"And her father spoke, saying, I said that thou didst surely hate her, and I gave her to one of thy friends: [is] not her younger sister better than she? let her be to thee instead of her."],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["Σαμψων",711482,4],["ἠθῴωμαι",700391,326],["καὶ",707031,7],["τὸ",709436,24],["ἅπαξ",701350,28],["ἀπὸ",701425,0],["ἀλλοφύλων",700706,169],["ὅτι",709803,7],["ποιῶ",710582,157],["ἐγὼ",704018,164],["μετ᾿",708780,0],["αὐτῶν",702165,40],["πονηρίαν",710659,9]],"And Sampson said to them, Even for once am I guiltless with regard to the Philistines, in that I do mischief among them."],["4",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["Σαμψων",711482,4],["καὶ",707031,7],["συνέλαβεν",712262,2],["τριακοσίας",712936,119],["ἀλώπεκας",700743,39],["καὶ",707031,7],["ἔλαβεν",708076,2],["λαμπάδας",708079,39],["καὶ",707031,7],["ἐπέστρεψεν",705278,2],["κέρκον",707633,9],["πρὸς",710844,0],["κέρκον",707633,9],["καὶ",707031,7],["ἔθηκεν",712849,2],["λαμπάδα",708079,9],["μίαν",704106,36],["ἀνὰ",700902,0],["μέσον",708768,27],["τῶν",709436,80],["δύο",703849,59],["κέρκων",707633,65],["καὶ",707031,7],["ἔδησεν",703394,2]],"And Sampson went and caught three hundred foxes, and took torches, and turned tail to tail, and put a torch between two tails, and fastened it."],["5",[["καὶ",707031,7],["ἐξέκαυσεν",704205,2],["πῦρ",711088,25],["ἐν",704639,0],["ταῖς",709436,75],["λαμπάσιν",708079,76],["καὶ",707031,7],["ἐξαπέστειλεν",704872,2],["ἐν",704639,0],["τοῖς",709436,147],["στάχυσιν",712053,148],["τῶν",709436,80],["ἀλλοφύλων",700706,169],["καὶ",707031,7],["ἐκάησαν",707049,150],["ἀπὸ",701425,0],["ἅλωνος",700741,17],["καὶ",707031,7],["ἕως",705792,0],["σταχύων",712053,81],["ὀρθῶν",709738,169],["καὶ",707031,7],["ἕως",705792,0],["ἀμπελῶνος",700872,18],["καὶ",707031,7],["ἐλαίας",704376,17]],"And he set fire to the torches, and sent [the foxes] into the corn of the Philistines; and every thing was burnt from the threshing floor to the standing corn, and even to the vineyard and olives."],["6",[["καὶ",707031,7],["εἶπαν",705373,150],["οἱ",709436,136],["ἀλλόφυλοι",700706,138],["τίς",712867,158],["ἐποίησεν",710582,2],["ταῦτα",709858,71],["καὶ",707031,7],["εἶπαν",705373,150],["Σαμψων",711482,4],["ὁ",709436,3],["νυμφίος",709382,4],["τοῦ",709436,35],["Θαμνι",706090,18],["ὅτι",709803,7],["ἔλαβεν",708076,2],["τὴν",709436,8],["γυναῖκα",703209,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτὴν",702165,104],["τῷ",709436,113],["ἐκ",704132,0],["τῶν",709436,80],["φίλων",713492,169],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀνέβησαν",700905,150],["οἱ",709436,136],["ἀλλόφυλοι",700706,138],["καὶ",707031,7],["ἐνέπρησαν",704617,150],["αὐτὴν",702165,104],["καὶ",707031,7],["τὸν",709436,5],["πατέρα",710189,6],["αὐτῆς",702165,86],["ἐν",704639,0],["πυρί",711088,54]],"And the Philistines said, Who [has done] these things? and they said, Sampson the son-in-law of the Thamnite, because he has taken his wife, and given her to one of his friends; and the Philistines went up, and burnt her and her father's house with fire."],["7",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["Σαμψων",711482,4],["ἐὰν",703912,7],["ποιήσητε",710582,125],["οὕτως",709859,28],["ταύτην",709858,104],["ὅτι",709803,7],["εἰ",704071,11],["μὴν",708873,11],["ἐκδικήσω",704174,165],["ἐν",704639,0],["ὑμῖν",713084,90],["καὶ",707031,7],["ἔσχατον",705519,27],["κοπάσω",707819,165]],"And Sampson said to them, Though ye may have dealt thus with her, verily I will be avenged of you, and afterwards I will cease."],["8",[["καὶ",707031,7],["ἐπάταξεν",710185,2],["αὐτοὺς",702165,62],["κνήμην",707750,9],["ἐπὶ",705080,0],["μηρὸν",708885,6],["πληγὴν",710527,9],["μεγάλην",708653,36],["καὶ",707031,7],["κατέβη",707202,2],["καὶ",707031,7],["ἐκάθισεν",707006,2],["ἐν",704639,0],["τρυμαλιᾷ",713001,1],["τῆς",709436,16],["πέτρας",710443,17],["Ηταμ",706038,118]],"And he smote them leg on thigh [with] a great overthrow; and went down and dwelt in a cave of the rock Etam."],["9",[["καὶ",707031,7],["ἀνέβησαν",700905,150],["οἱ",709436,136],["ἀλλόφυλοι",700706,138],["καὶ",707031,7],["παρενέβαλον",710132,150],["ἐν",704639,0],["Ιουδα",706768,114],["καὶ",707031,7],["ἐξερρίφησαν",704306,150],["ἐν",704639,0],["Λευι",708158,114]],"And the Philistines went up, and encamped in Juda, and spread themselves abroad in Lechi."],["10",[["καὶ",707031,7],["εἶπαν",705373,150],["ἀνὴρ",701150,4],["Ιουδα",706768,18],["εἰς",704105,0],["τί",712867,126],["ἀνέβητε",700905,265],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["καὶ",707031,7],["εἶπον",705373,150],["οἱ",709436,136],["ἀλλόφυλοι",700706,138],["δῆσαι",703394,106],["τὸν",709436,5],["Σαμψων",711482,6],["ἀνέβημεν",700905,289],["καὶ",707031,7],["ποιῆσαι",710582,106],["αὐτῷ",702165,50],["ὃν",709781,112],["τρόπον",712980,6],["ἐποίησεν",710582,2],["ἡμῖν",705994,90]],"And the men of Juda said, Why are ye come up against us? and the Philistines said, We are come up to bind Sampson, and to do to him as he has done to us."],["11",[["καὶ",707031,7],["κατέβησαν",707202,150],["τρισχίλιοι",712964,138],["ἄνδρες",701150,52],["ἀπὸ",701425,0],["Ιουδα",706768,18],["εἰς",704105,0],["τρυμαλιὰν",713001,9],["πέτρας",710443,17],["Ηταμ",706038,118],["καὶ",707031,7],["εἶπαν",705373,150],["τῷ",709436,113],["Σαμψων",711482,114],["οὐκ",709805,28],["οἶδας",709492,266],["ὅτι",709803,7],["κυριεύουσιν",707995,197],["οἱ",709436,136],["ἀλλόφυλοι",700706,138],["ἡμῶν",705999,145],["καὶ",707031,7],["τί",712867,126],["τοῦτο",709858,129],["ἐποίησας",710582,162],["ἡμῖν",705994,90],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["Σαμψων",711482,4],["ὃν",709781,112],["τρόπον",712980,6],["ἐποίησάν",710582,150],["μοι",708974,159],["οὕτως",709859,28],["ἐποίησα",710582,155],["αὐτοῖς",702165,151]],"And the three thousand men of Juda went down to the hole of the rock Etam, and they said to Sampson, Knowest thou not that the Philistines rule over us? and what [is] this [that] thou hast done to us? and Sampson said to them, As they did to me, so have I done to them."],["12",[["καὶ",707031,7],["εἶπαν",705373,150],["αὐτῷ",702165,50],["δῆσαί",703394,106],["σε",711598,163],["κατέβημεν",707202,289],["τοῦ",709436,20],["δοῦναί",703654,106],["σε",711598,163],["ἐν",704639,0],["χειρὶ",713787,1],["ἀλλοφύλων",700706,169],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["Σαμψων",711482,4],["ὀμόσατέ",709620,74],["μοι",708974,159],["μήποτε",708882,28],["συναντήσητε",712394,125],["ἐν",704639,0],["ἐμοὶ",704577,159],["ὑμεῖς",713081,219]],"And they said to him, We are come down to bind thee to deliver thee into the hand of the Philistines: and Sampson said to them, Swear to me that ye will not fall upon me yourselves."],["13",[["καὶ",707031,7],["εἶπον",705373,150],["αὐτῷ",702165,50],["λέγοντες",708124,146],["οὐχί",709862,28],["ὅτι",709803,7],["ἀλλ᾿",700680,7],["ἢ",705924,7],["δεσμῷ",703372,114],["δήσομέν",703394,275],["σε",711598,163],["καὶ",707031,7],["παραδώσομέν",710014,275],["σε",711598,163],["ἐν",704639,0],["χειρὶ",713787,1],["αὐτῶν",702165,40],["καὶ",707031,7],["θανάτῳ",706096,114],["οὐ",709805,28],["θανατώσομέν",706097,275],["σε",711598,163],["καὶ",707031,7],["ἔδησαν",703394,150],["αὐτὸν",702165,85],["ἐν",704639,0],["δυσὶ",703849,533],["καλωδίοις",707104,96],["καινοῖς",707042,94],["καὶ",707031,7],["ἀνήνεγκαν",701083,150],["αὐτὸν",702165,85],["ἀπὸ",701425,0],["τῆς",709436,16],["πέτρας",710443,17],["ἐκείνης",704183,86]],"And they spoke to him, saying, Nay, but we will only bind thee fast, and deliver thee into their hand, and will by no means slay thee: and they bound him with two new ropes, and brought him from that rock."],["14",[["καὶ",707031,7],["ἦλθον",705453,150],["ἕως",705792,0],["σιαγόνος",711763,17],["καὶ",707031,7],["οἱ",709436,136],["ἀλλόφυλοι",700706,138],["ἠλάλαξαν",700632,150],["καὶ",707031,7],["ἔδραμον",712931,150],["εἰς",704105,0],["συνάντησιν",712397,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἥλατο",700696,23],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["πνεῦμα",710566,15],["κυρίου",707996,18],["καὶ",707031,7],["ἐγενήθη",703104,37],["τὰ",709436,63],["καλώδια",707104,64],["τὰ",709436,63],["ἐπὶ",705080,0],["βραχίοσιν",702808,148],["αὐτοῦ",702165,102],["ὡσεὶ",714159,28],["στιππύον",712111,15],["ὃ",709781,128],["ἐξεκαύθη",704205,37],["ἐν",704639,0],["πυρί",711088,54],["καὶ",707031,7],["ἐτάκησαν",712839,150],["δεσμοὶ",703372,52],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["χειρῶν",713787,65],["αὐτοῦ",702165,102]],"And they came to Lechi: and the Philistines shouted, and ran to meet him: and the Spirit of the Lord came mightily upon him, and the ropes that were upon his arms became as tow which is burnt with fire; and his bonds were consumed from off his hands."],["15",[["καὶ",707031,7],["εὗρεν",705676,2],["σιαγόνα",711763,9],["ὄνου",709671,18],["ἐκρεριμμένην",704306,444],["καὶ",707031,7],["ἐξέτεινεν",704322,2],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔλαβεν",708076,2],["αὐτὴν",702165,104],["καὶ",707031,7],["ἐπάταξεν",710185,2],["ἐν",704639,0],["αὐτῇ",702165,105],["χιλίους",713859,60],["ἄνδρας",701150,57]],"And he found the jaw-bone of an ass that had been cast away, and he put forth his hand and took it, and smote with it a thousand men."],["16",[["καὶ",707031,7],["εἶπεν",705373,2],["Σαμψων",711482,4],["ἐν",704639,0],["σιαγόνι",711763,1],["ὄνου",709671,18],["ἐξαλείφων",704852,72],["ἐξήλειψα",704852,155],["αὐτούς",702165,62],["ὅτι",709803,7],["ἐν",704639,0],["τῇ",709436,100],["σιαγόνι",711763,1],["τοῦ",709436,35],["ὄνου",709671,18],["ἐπάταξα",710185,155],["χιλίους",713859,60],["ἄνδρας",701150,57]],"And Sampson said, With the jaw-bone of an ass I have utterly destroyed them, for with the jaw-bone of an ass I have smitten a thousand men."],["17",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὡς",714148,7],["ἐπαύσατο",710202,23],["λαλῶν",708071,72],["καὶ",707031,7],["ἔρριψεν",711267,2],["τὴν",709436,8],["σιαγόνα",711763,9],["ἐκ",704132,0],["τῆς",709436,16],["χειρὸς",713787,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐκάλεσεν",707084,2],["τὸν",709436,5],["τόπον",712903,6],["ἐκεῖνον",704183,85],["ἀναίρεσις",700961,12],["σιαγόνος",711763,17]],"And it came to pass when he ceased speaking, that he cast the jaw-bone out of his hand; and he called that place the Lifting of the jaw-bone."],["18",[["καὶ",707031,7],["ἐδίψησεν",703763,2],["σφόδρα",712586,28],["καὶ",707031,7],["ἔκλαυσεν",707703,2],["πρὸς",710844,0],["κύριον",707996,6],["καὶ",707031,7],["εἶπεν",705373,2],["σὺ",712181,164],["εὐδόκησας",705565,162],["ἐν",704639,0],["χειρὶ",713787,1],["δούλου",703817,18],["σου",711945,133],["τὴν",709436,8],["σωτηρίαν",712658,9],["τὴν",709436,8],["μεγάλην",708653,36],["ταύτην",709858,104],["καὶ",707031,7],["νῦν",709384,28],["ἀποθανοῦμαι",701461,181],["τῷ",709436,53],["δίψει",703764,54],["καὶ",707031,7],["ἐμπεσοῦμαι",704593,181],["ἐν",704639,0],["χειρὶ",713787,1],["τῶν",709436,80],["ἀπεριτμήτων",701397,169]],"And he was very thirsty, and wept before the Lord, and said, Thou hast been well pleased to grant this great deliverance by the hand of thy servant, and now shall I die for thirst, and fall into the hand of the uncircumcised?"],["19",[["καὶ",707031,7],["ἔρρηξεν",711243,2],["ὁ",709436,3],["θεὸς",706192,4],["τὸν",709436,5],["λάκκον",708067,6],["τὸν",709436,5],["ἐν",704639,0],["τῇ",709436,100],["σιαγόνι",711763,1],["καὶ",707031,7],["ἐξῆλθεν",704909,2],["ἐξ",704132,0],["αὐτοῦ",702165,102],["ὕδωρ",713071,15],["καὶ",707031,7],["ἔπιεν",710478,2],["καὶ",707031,7],["ἐπέστρεψεν",705278,2],["τὸ",709436,34],["πνεῦμα",710566,15],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔζησεν",705851,2],["διὰ",703417,0],["τοῦτο",709858,129],["ἐκλήθη",707084,37],["τὸ",709436,34],["ὄνομα",709666,15],["αὐτῆς",702165,86],["πηγὴ",710450,12],["τοῦ",709436,35],["ἐπικαλουμένου",705153,262],["ἥ",709781,177],["ἐστιν",704093,91],["ἐν",704639,0],["σιαγόνι",711763,1],["ἕως",705792,0],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86]],"And God broke open a hollow place in the jaw, and there came thence water, and he drank; and his spirit returned and he revived: therefore the name of the fountain was called ‘The well of the invoker,’ which is in Lechi, until this day."],["20",[["καὶ",707031,7],["ἔκρινεν",707905,2],["τὸν",709436,5],["Ισραηλ",706839,6],["ἐν",704639,0],["ἡμέραις",705984,76],["ἀλλοφύλων",700706,169],["εἴκοσι",704085,59],["ἔτη",705543,42]],"And he judged Israel in the days of the Philistines twenty years."]]