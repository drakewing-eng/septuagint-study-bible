,709436,35],["Αμορραίου",700865,18],["καὶ",707031,7],["ἀπὸ",701425,0],["υἱῶν",713075,81],["Αμμων",700847,18],["καὶ",707031,7],["ἀπὸ",701425,0],["Φυλιστιιμ",713621,81]],"And the Lord said to the children of Israel, Did I not [save you] from Egypt and from the Amorite, and from the children of Ammon, and from the Phylistines,"],["12",[["καὶ",707031,7],["Σιδωνίων",711776,81],["καὶ",707031,7],["Αμαληκ",700759,18],["καὶ",707031,7],["Μαδιαμ",708355,17],["οἳ",709781,250],["ἔθλιψαν",706274,150],["ὑμᾶς",713080,194],["καὶ",707031,7],["ἐβοήσατε",702743,265],["πρός",710844,0],["με",708618,163],["καὶ",707031,7],["ἔσωσα",712627,155],["ὑμᾶς",713080,194],["ἐκ",704132,0],["χειρὸς",713787,17],["αὐτῶν",702165,40]],"and from the Sidonians, and Amalec, and Madiam, who afflicted you? and ye cried to me, and I saved you out of their hand?"],["13",[["καὶ",707031,7],["ὑμεῖς",713081,219],["ἐγκατελίπετέ",703967,265],["με",708618,163],["καὶ",707031,7],["ἐδουλεύσατε",703814,265],["θεοῖς",706192,148],["ἑτέροις",705535,230],["διὰ",703417,0],["τοῦτο",709858,129],["οὐ",709805,28],["προσθήσω",710965,165],["τοῦ",709436,20],["σῶσαι",712627,106],["ὑμᾶς",713080,194]],"Yet ye forsook me and served other gods; therefore I will not save you any more."],["14",[["πορεύεσθε",710667,73],["καὶ",707031,7],["βοήσατε",702743,74],["πρὸς",710844,0],["τοὺς",709436,58],["θεούς",706192,57],["οὓς",709781,298],["ἐξελέξασθε",704236,345],["ἑαυτοῖς",703917,151],["καὶ",707031,7],["αὐτοὶ",702165,201],["σωσάτωσαν",712627,264],["ὑμᾶς",713080,194],["ἐν",704639,0],["καιρῷ",707047,114],["θλίψεως",706276,17],["ὑμῶν",713091,145]],"Go, and cry to the gods whom ye have chosen to yourselves, and let them save you in the time of your affliction."],["15",[["καὶ",707031,7],["εἶπαν",705373,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["πρὸς",710844,0],["κύριον",707996,6],["ἡμάρτομεν",700773,289],["ποίησον",710582,176],["σὺ",712181,164],["ἡμῖν",705994,90],["κατὰ",707200,0],["πᾶν",710177,46],["τὸ",709436,24],["ἀγαθὸν",70010