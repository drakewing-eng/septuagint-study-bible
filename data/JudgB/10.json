[["1",[["καὶ",707031,7],["ἀνέστη",701173,2],["μετὰ",708780,0],["Αβιμελεχ",700068,6],["τοῦ",709436,20],["σῶσαι",712627,106],["τὸν",709436,5],["Ισραηλ",706839,6],["Θωλα",706352,4],["υἱὸς",713075,4],["Φουα",713564,18],["υἱὸς",713075,4],["πατραδέλφου",710191,18],["αὐτοῦ",702165,102],["ἀνὴρ",701150,4],["Ισσαχαρ",706843,4],["καὶ",707031,7],["αὐτὸς",702165,121],["ᾤκει",709499,13],["ἐν",704639,0],["Σαμιρ",711465,1],["ἐν",704639,0],["ὄρει",709768,54],["Εφραιμ",705769,18]],"And after Abimelech Thola the son of Phua rose up to save Israel, [being] the son of his father's brother, a man of Issachar; and he dwelt in Samir in mount Ephraim."],["2",[["καὶ",707031,7],["ἔκρινεν",707905,2],["τὸν",709436,5],["Ισραηλ",706839,6],["εἴκοσι",704085,59],["τρία",712927,68],["ἔτη",705543,42],["καὶ",707031,7],["ἀπέθανεν",701461,2],["καὶ",707031,7],["ἐτάφη",706103,37],["ἐν",704639,0],["Σαμιρ",711465,1]],"And he judged Israel twenty-three years, and died, and was buried in Samir."],["3",[["καὶ",707031,7],["ἀνέστη",701173,2],["μετ᾿",708780,0],["αὐτὸν",702165,85],["Ιαϊρ",706390,4],["ὁ",709436,3],["Γαλααδ",702920,4],["καὶ",707031,7],["ἔκρινεν",707905,2],["τὸν",709436,5],["Ισραηλ",706839,6],["εἴκοσι",704085,59],["δύο",703849,59],["ἔτη",705543,42]],"And after him arose Jair of Galaad, and he judged Israel twenty-two years."],["4",[["καὶ",707031,7],["ἦσαν",704093,137],["αὐτῷ",702165,50],["τριάκοντα",712934,59],["καὶ",707031,7],["δύο",703849,59],["υἱοὶ",713075,52],["ἐπιβαίνοντες",705082,146],["ἐπὶ",705080,0],["τριάκοντα",712934,59],["δύο",703849,59],["πώλους",711117,52],["καὶ",707031,7],["τριάκοντα",712934,59],["δύο",703849,59],["πόλεις",710612,191],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἐκάλουν",707084,137],["αὐτὰς",702165,231],["ἐπαύλεις",705048,39],["Ιαϊρ",706390,18],["ἕως",705792,0],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86],["ἐν",704639,0],["γῇ",703083,1],["Γαλααδ",702920,18]],"And he had thirty-two sons riding on thirty-two colts, and they had thirty-two cities; and they called them Jair's towns until this day in the land of Galaad."],["5",[["καὶ",707031,7],["ἀπέθανεν",701461,2],["Ιαϊρ",706390,4],["καὶ",707031,7],["ἐτάφη",706103,37],["ἐν",704639,0],["Ραμνων",711173,1]],"And Jair died, and was buried in Rhamnon."],["6",[["καὶ",707031,7],["προσέθεντο",710965,189],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["ποιῆσαι",710582,106],["τὸ",709436,24],["πονηρὸν",710660,27],["ἐνώπιον",704823,0],["κυρίου",707996,18],["καὶ",707031,7],["ἐδούλευσαν",703814,150],["τοῖς",709436,147],["Βααλιμ",702342,148],["καὶ",707031,7],["ταῖς",709436,75],["Ασταρωθ",702009,76],["καὶ",707031,7],["τοῖς",709436,147],["θεοῖς",706192,148],["Αραδ",701677,17],["καὶ",707031,7],["τοῖς",709436,147],["θεοῖς",706192,148],["Σιδῶνος",711775,18],["καὶ",707031,7],["τοῖς",709436,147],["θεοῖς",706192,148],["Μωαβ",709085,17],["καὶ",707031,7],["τοῖς",709436,147],["θεοῖς",706192,148],["υἱῶν",713075,81],["Αμμων",700847,18],["καὶ",707031,7],["τοῖς",709436,147],["θεοῖς",706192,148],["Φυλιστιιμ",713621,81],["καὶ",707031,7],["ἐγκατέλιπον",703967,150],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["οὐκ",709805,28],["ἐδούλευσαν",703814,150],["αὐτῷ",702165,50]],"And the children of Israel did evil again in the sight of the Lord, and served Baalim, and Astaroth, and the gods of Aram, and the gods of Sidon, and the gods of Moab, and the gods of the children of Ammon, and the gods of the Phylistines; and they forsook the Lord, and did not serve him."],["7",[["καὶ",707031,7],["ὠργίσθη",709729,37],["θυμῷ",706334,114],["κύριος",707996,4],["ἐν",704639,0],["Ισραηλ",706839,114],["καὶ",707031,7],["ἀπέδοτο",701449,23],["αὐτοὺς",702165,62],["ἐν",704639,0],["χειρὶ",713787,1],["Φυλιστιιμ",713621,81],["καὶ",707031,7],["ἐν",704639,0],["χειρὶ",713787,1],["υἱῶν",713075,81],["Αμμων",700847,18]],"And the Lord was very angry with Israel, and sold them into the hand of the Phylistines, and into the hand of the children of Ammon."],["8",[["καὶ",707031,7],["ἔθλιψαν",706274,150],["καὶ",707031,7],["ἔθ