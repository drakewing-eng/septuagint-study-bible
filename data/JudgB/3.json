[["1",[["καὶ",707031,7],["ταῦτα",709858,290],["τὰ",709436,63],["ἔθνη",704068,64],["ἃ",709781,69],["ἀφῆκεν",702211,2],["κύριος",707996,4],["αὐτὰ",702165,71],["ὥστε",714164,7],["πειράσαι",710225,106],["ἐν",704639,0],["αὐτοῖς",702165,151],["τὸν",709436,5],["Ισραηλ",706839,6],["πάντας",710177,60],["τοὺς",709436,58],["μὴ",708851,28],["ἐγνωκότας",703105,277],["τοὺς",709436,58],["πολέμους",710605,57],["Χανααν",713708,118]],"And these [are] the nations which the Lord left to prove Israel with them, all that had not known the wars of Chanaan."],["2",[["πλὴν",710540,28],["διὰ",703417,0],["τὰς",709436,38],["γενεὰς",703037,39],["υἱῶν",713075,81],["Ισραηλ",706839,18],["τοῦ",709436,20],["διδάξαι",703649,106],["αὐτοὺς",702165,62],["πόλεμον",710605,6],["πλὴν",710540,28],["οἱ",709436,136],["ἔμπροσθεν",704618,0],["αὐτῶν",702165,40],["οὐκ",709805,28],["ἔγνωσαν",703105,150],["αὐτά",702165,71]],"Only for the sake of the generations of Israel, to teach them war, only the men before them knew them not."],["3",[["τὰς",709436,38],["πέντε",710266,59],["σατραπείας",711554,39],["τῶν",709436,80],["ἀλλοφύλων",700706,169],["καὶ",707031,7],["πάντα",710177,27],["τὸν",709436,5],["Χαναναῖον",713711,6],["καὶ",707031,7],["τὸν",709436,5],["Σιδώνιον",711776,6],["καὶ",707031,7],["τὸν",709436,5],["Ευαῖον",705549,6],["τὸν",709436,5],["κατοικοῦντα",707534,183],["τὸν",709436,5],["Λίβανον",708185,6],["ἀπὸ",701425,0],["τοῦ",709436,20],["ὄρους",709768,21],["τοῦ",709436,35],["Αερμων",700317,118],["ἕως",705792,0],["Λαβωεμαθ",708048,118]],"The five lordships of the Phylistines, and every Chananite, and the Sidonian, and the Evite who dwelt in Libanus from the mount of Aermon to Laboemath."],["4",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὥστε",714164,7],["πειράσαι",710225,106],["ἐν",704639,0],["αὐτοῖς",702165,151],["τὸν",709436,5],["Ισραηλ",706839,6],["γνῶναι",703105,106],["εἰ",704071,11],["ἀκούσονται",700587,135],["τὰς",709436,38],["ἐντολὰς",704802,39],["κυρίου",707996,18],["ἃς",709781,193],["ἐνετείλατο",704791,23]