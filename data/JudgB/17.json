[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἀνὴρ",701150,4],["ἀπὸ",701425,0],["ὄρους",709768,21],["Εφραιμ",705769,18],["καὶ",707031,7],["ὄνομα",709666,25],["αὐτῷ",702165,50],["Μιχαιας",708955,4]],"And there was a man of mount Ephraim, and his name was Michaias."],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["τῇ",709436,100],["μητρὶ",708892,1],["αὐτοῦ",702165,102],["οἱ",709436,136],["χίλιοι",713859,138],["καὶ",707031,7],["ἑκατόν",704136,59],["οὓς",709781,298],["ἔλαβες",708076,162],["ἀργυρίου",701707,21],["σεαυτῇ",711599,105],["καί",707031,7],["με",708618,163],["ἠράσω",701686,174],["καὶ",707031,7],["προσεῖπας",710881,162],["ἐν",704639,0],["ὠσί",709852,96],["μου",709032,133],["ἰδοὺ",706497,88],["τὸ",709436,34],["ἀργύριον",701707,15],["παρ᾿",709995,0],["ἐμοί",704577,159],["ἐγὼ",704018,164],["ἔλαβον",708076,150],["αὐτό",702165,129],["καὶ",707031,7],["εἶπεν",705373,2],["ἡ",709436,10],["μήτηρ",708892,12],["αὐτοῦ",702165,102],["εὐλογητὸς",705632,14],["ὁ",709436,3],["υἱός",713075,4],["μου",709032,133],["τῷ",709436,113],["κυρίῳ",707996,114]],"And he said to his mother, The eleven hundred pieces of silver which thou tookest to thyself, and [about which] thou cursedst me, and spokest in my ears, behold, the silver [is] with me; I took it: and his mother said, Blessed [be] my son of the Lord."],["3",[["καὶ",707031,7],["ἀπέδωκεν",701449,2],["τοὺς",709436,58],["χιλίους",713859,60],["καὶ",707031,7],["ἑκατὸν",704136,59],["τοῦ",709436,20],["ἀργυρίου",701707,21],["τῇ",709436,100],["μητρὶ",708892,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["ἡ",709436,10],["μήτηρ",708892,12],["αὐτοῦ",702165,102],["ἁγιάζουσα",700153,188],["ἡγίακα",700153,89],["τὸ",709436,24],["ἀργύριον",701707,25],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐκ",704132,0],["χειρός",713787,17],["μου",709032,133],["τῷ",709436,113],["υἱῷ",713075,114],["μου",709032,133],["τοῦ",709436,20],["ποιῆσαι",710582,106],["γλυπτὸν",703117,46],["καὶ",707031,7],["χωνευτόν",714009,46],["καὶ",707031,7],["νῦν",709384,28],["ἀποδώσω",701449,165],["σοι",711925,159],["αὐτό",702165,129]],"And he restored the eleven hundred pieces of silver to his mother; and his mother said, I had wholly consecrated the money to the Lord out of my hand for my son, to make a graven and a molten [image], and now I will restore it to thee."],["4",[["καὶ",707031,7],["ἀπέδωκεν",701449,2],["τὸ",709436,24],["ἀργύριον",701707,25],["τῇ",709436,100],["μητρὶ",708892,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔλαβεν",708076,2],["ἡ",709436,10],["μήτηρ",708892,12],["αὐτοῦ",702165,102],["διακοσίους",703482,60],["ἀργυρίου",701707,21],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτὸ",702165,129],["ἀργυροκόπῳ",701709,114],["καὶ",707031,7],["ἐποίησεν",710582,2],["αὐτὸ",702165,129],["γλυπτὸν",703117,46],["καὶ",707031,7],["χωνευτόν",714009,46],["καὶ",707031,7],["ἐγενήθη",703104,37],["ἐν",704639,0],["οἴκῳ",709516,114],["Μιχαια",708955,18]],"But he returned the silver to his mother, and his mother took two hundred pieces of silver, and gave them to a silversmith, and he made it a graven and a molten image; and it was in the house of Michaias."],["5",[["καὶ",707031,7],["ὁ",709436,3],["οἶκος",709516,4],["Μιχαια",708955,18],["αὐτῷ",702165,50],["οἶκος",709516,4],["θεοῦ",706192,18],["καὶ",707031,7],["ἐποίησεν",710582,2],["εφωδ",705772,25],["καὶ",707031,7],["θαραφιν",706109,25],["καὶ",707031,7],["ἐπλήρωσεν",710543,2],["τὴν",709436,8],["χεῖρα",713787,9],["ἀπὸ",701425,0],["ἑνὸς",704106,116],["υἱῶν",713075,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐγένετο",703104,23],["αὐτῷ",702165,50],["εἰς",704105,0],["ἱερέα",706614,6]],"And the house of Michaias [was] to him the house of God, and he made an ephod and theraphin, and he consecrated one of his sons, and he became to him a priest."],["6",[["ἐν",704639,0],["δὲ",703303,11],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["οὐκ",709805,28],["ἦν",704093,13],["βασιλεὺς",702580,4],["ἐν",704639,0],["Ισραηλ",706839,114],["ἀνὴρ",701150,4],["τὸ",709436,24],["εὐθὲς",705596,46],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["αὐτοῦ",702165,102],["ἐποίει",710582,13]],"And in those days there was no king in Israel; every man did that which was right in his own eyes."],["7",[["καὶ",707031,7],["ἐγενήθη",703104,37],["νεανίας",709229,4],["ἐκ",704132,0],["Βηθλεεμ",702688,111],["δήμου",703411,18],["Ιουδα",706768,18],["καὶ",707031,7],["αὐτὸς",702165,121],["Λευίτης",708160,4],["καὶ",707031,7],["οὗτος",709858,121],["παρῴκει",710156,13],["ἐκεῖ",704181,28]],"And there was a young man in Bethleem of the tribe of Juda, and he [was] a Levite, and he was sojourning there."],["8",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["ὁ",709436,3],["ἀνὴρ",701150,4],["ἀπὸ",701425,0],["Βηθλεεμ",702688,111],["τῆς",709436,16],["πόλεως",710612,17],["Ιουδα",706768,18],["παροικῆσαι",710156,106],["ἐν",704639,0],["ᾧ",709781,309],["ἐὰν",703912,7],["εὕρῃ",705676,172],["τόπῳ",712903,114],["καὶ",707031,7],["ἦλθεν",705453,2],["ἕως",705792,0],["ὄρους",709768,21],["Εφραιμ",705769,18],["καὶ",707031,7],["ἕως",705792,0],["οἴκου",709516,18],["Μιχαια",708955,18],["τοῦ",709436,20],["ποιῆσαι",710582,106],["ὁδὸν",709458,9],["αὐτοῦ",702165,102]],"And the man departed from Bethleem the city of Juda to sojourn in whatever place he might find; and he came as far as mount Ephraim, and to the house of Michaias to accomplish his journey."],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["Μιχαιας",708955,4],["πόθεν",710580,28],["ἔρχῃ",705453,278],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτόν",702165,85],["Λευίτης",708160,4],["εἰμὶ",704093,157],["ἀπὸ",701425,0],["Βαιθλεεμ",702420,118],["Ιουδα",706768,18],["καὶ",707031,7],["ἐγὼ",704018,164],["πορεύομαι",710667,254],["παροικῆσαι",710156,106],["ἐν",704639,0],["ᾧ",709781,309],["ἐὰν",703912,7],["εὕρω",705676,207],["τόπῳ",712903,114]],"And Michaias said to him, Whence comest thou? and he said to him, I am a Levite of Bethleem Juda, and I go to sojourn in any place I may find."],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["Μιχα