",709436,20],["παιδίου",709927,21],["καὶ",707031,7],["τὰ",709436,63],["ποιήματα",710583,64],["αὐτοῦ",702165,102]],"And Manoë said, Now shall [thy] word come to pass: what shall be the ordering of the child, and our dealings with him?"],["13",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["ἄγγελος",700140,4],["κυρίου",707996,18],["πρὸς",710844,0],["Μανωε",708492,6],["ἀπὸ",701425,0],["πάντων",710177,169],["ὧν",709781,252],["εἴρηκα",705415,89],["πρὸς",710844,0],["τὴν",709436,8],["γυναῖκα",703209,9],["φυλάξεται",713619,93]],"And the angel of the Lord said to Manoë, Of all things concerning which I spoke to the woman, she shall beware."],["14",[["ἀπὸ",701425,0],["παντός",710177,116],["ὃ",709781,128],["ἐκπορεύεται",704293,117],["ἐξ",704132,0],["ἀμπέλου",700870,17],["τοῦ",709436,35],["οἴνου",709530,18],["οὐ",709805,28],["φάγεται",713296,93],["καὶ",707031,7],["οἶνον",709530,6],["καὶ",707031,7],["σικερα",711781,25],["μέθυσμα",708674,25],["μὴ",708851,28],["πιέτω",710478,45],["καὶ",707031,7],["πᾶν",710177,46],["ἀκάθαρτον",700508,46],["μὴ",708851,28],["φαγέτω",705495,45],["πάντα",710177,68],["ὅσα",709788,68],["ἐνετειλάμην",704791,161],["αὐτῇ",702165,105],["φυλάξεται",713619,93]],"She shall eat of nothing that comes of the vine yielding wine, and let her not drink wine or strong liquor, and let her not eat anything unclean: all things that I have charged her she shall observe."],["15",[["καὶ",707031,7],["εἶπεν",705373,2],["Μανωε",708492,4],["πρὸς",710844,0],["τὸν",709436,5],["ἄγγελον",700140,6],["κυρίου",707996,18],["κατάσχωμεν",707526,79],["ὧδέ",714090,28],["σε",711598,163],["καὶ",707031,7],["ποιήσωμεν",710582,79],["ἐνώπιόν",704823,0],["σου",711945,133],["ἔριφον",705429,6],["αἰγῶν",700464,81]],"And Manoë said to the angel of the Lord, Let us detain thee here, and prepare before thee a kid of the goats."],["16",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["ἄγγελος",700140,4],["κυρίου",707996,18],["πρὸς",710844,0],["Μανωε",708492,6],["ἐὰν",703912,7],["κατάσχῃς",7075