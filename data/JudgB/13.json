[["1",[["καὶ",707031,7],["προσέθηκαν",710965,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["ποιῆσαι",710582,106],["τὸ",709436,24],["πονηρὸν",710660,27],["ἐνώπιον",704823,0],["κυρίου",707996,18],["καὶ",707031,7],["παρέδωκεν",710014,2],["αὐτοὺς",702165,62],["κύριος",707996,4],["ἐν",704639,0],["χειρὶ",713787,1],["Φυλιστιιμ",713621,81],["τεσσαράκοντα",712806,59],["ἔτη",705543,42]],"And the children of Israel yet again committed iniquity before the Lord; and the Lord delivered them into the hand of the Phylistines forty years."],["2",[["καὶ",707031,7],["ἦν",704093,13],["ἀνὴρ",701150,4],["εἷς",704106,14],["ἀπὸ",701425,0],["Σαραα",711508,118],["ἀπὸ",701425,0],["δήμου",703411,18],["συγγενείας",712184,17],["τοῦ",709436,35],["Δανι",703281,18],["καὶ",707031,7],["ὄνομα",709666,25],["αὐτῷ",702165,50],["Μανωε",708492,4],["καὶ",707031,7],["γυνὴ",703209,12],["αὐτῷ",702165,50],["στεῖρα",712060,12],["καὶ",707031,7],["οὐκ",709805,28],["ἔτεκεν",712853,2]],"And there was a man of Saraa, of the family of the kindred of Dan, and his name was Manoë, and his wife was barren, and bore not."],["3",[["καὶ",707031,7],["ὤφθη",709725,37],["ἄγγελος",700140,4],["κυρίου",707996,18],["πρὸς",710844,0],["τὴν",709436,8],["γυναῖκα",703209,9],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτήν",702165,104],["ἰδοὺ",706497,88],["σὺ",712181,164],["στεῖρα",712060,12],["καὶ",707031,7],["οὐ",709805,28],["τέτοκας",712853,266],["καὶ",707031,7],["συλλήμψῃ",712262,123],["υἱόν",713075,6]],"And an angel of the Lord appeared to the woman, and said to her, Behold, thou art barren and hast not born; yet thou shalt conceive a son."],["4",[["καὶ",707031,7],["νῦν",709384,28],["φύλαξαι",713619,300],["δὴ",703395,11],["καὶ",707031,7],["μὴ",708851,28],["πίῃς",710478,175],["οἶνον",709530,6],["καὶ",707031,7],["μέθυσμα",708674,25],["καὶ",707031,7],["μὴ",708851,28],["φάγῃς",713296,175],["πᾶν",710177,46],["ἀκάθαρτον",700508,46]],"And now be very cautious, and drink no wine nor strong drink, and eat no un