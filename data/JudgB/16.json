,["6",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαλιδα",703266,12],["πρὸς",710844,0],["Σαμψων",711482,6],["ἀπάγγειλον",701321,176],["δή",703395,11],["μοι",708974,159],["ἐν",704639,0],["τίνι",712867,432],["ἡ",709436,10],["ἰσχύς",706858,12],["σου",711945,133],["ἡ",709436,10],["μεγάλη",708653,29],["καὶ",707031,7],["ἐν",704639,0],["τίνι",712867,432],["δεθήσῃ",703394,364],["τοῦ",709436,20],["ταπεινωθῆναί",712717,179],["σε",711598,163]],"And Dalida said to Sampson, Tell me, I pray thee, wherein [is] thy great strength, and wherewith thou shalt be bound that thou mayest be humbled."],["7",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτὴν",702165,104],["Σαμψων",711482,4],["ἐὰν",703912,7],["δήσωσίν",703394,234],["με",708618,163],["ἐν",704639,0],["ἑπτὰ",705357,59],["νευρέαις",709273,76],["ὑγραῖς",713063,291],["μὴ",708851,28],["διεφθαρμέναις",703624,351],["καὶ",707031,7],["ἀσθενήσω",701938,207],["καὶ",707031,7],["ἔσομαι",704093,181],["ὡς",714148,7],["εἷς",704106,14],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"And Sampson said to her, If they bind me with seven moist cords that have not been spoiled, then shall I be weak and be as one of ordinary men."],["8",[["καὶ",707031,7],["ἀνήνεγκαν",701083,150],["αὐτῇ",702165,105],["οἱ",709436,136],["ἄρχοντες",701862,52],["τῶν",709436,80],["ἀλλοφύλων",700706,169],["ἑπτὰ",705357,59],["νευρὰς",709273,39],["ὑγρὰς",713063,119],["μὴ",708851,28],["διεφθαρμένας",703624,498],["καὶ",707031,7],["ἔδησεν",703394,2],["αὐτὸν",702165,85],["ἐν",704639,0],["αὐταῖς",702165,200]],"And the princes of the Philistines brought to her seven moist cords that had not been spoiled, and she bound him with them."],["9",[["καὶ",707031,7],["τὸ",709436,24],["ἔνεδρον",704704,25],["αὐτῇ",702165,105],["ἐκάθητο",707000,19],["ἐν",704639,0],["τῷ",709436,53],["ταμιείῳ",712700,54],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["ἀλλόφυλοι",700706,138],["ἐπὶ",705080,0],["σέ",711598,163],["Σαμψων",711482,153],["καὶ",707031,7],["διέσπασεν",703583,2],["τὰς",709436,38],["νευρέας",709273,39],["ὡς",714148,7],["εἴ",704071,11],["τις",712866,158],["ἀποσπάσοι",701583,225],["στρέμμα",712157,15],["στιππύου",712111,21],["ἐν",704639,0],["τῷ",709436,53],["ὀσφρανθῆναι",709798,179],["αὐτὸ",702165,129],["πυρός",711088,18],["καὶ",707031,7],["οὐκ",709805,28],["ἐγνώσθη",703105,37],["ἡ",709436,10],["ἰσχὺς",706858,12],["αὐτοῦ",702165,102]],"And the liers in wait remained with her in the chamber; and she said to him, The Philistines [are] upon thee, Sampson: and he broke the cords as if any one should break a thread of tow when it has touched the fire, and his strength was not known."],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαλιδα",703266,12],["πρὸς",710844,0],["Σαμψων",711482,6],["ἰδοὺ",706497,88],["ἐπλάνησάς",710495,162],["με",708618,163],["καὶ",707031,7],["ἐλάλησας",708071,162],["πρός",710844,0],["με",708618,163],["ψευδῆ",714036,68],["νῦν",709384,28],["οὖν",709835,11],["ἀνάγγειλόν",700921,176],["μοι",708974,159],["ἐν",704639,0],["τίνι",712867,432],["δεθήσῃ",703394,364]],"And Dalida said to Sampson, Behold, thou hast cheated me, and told me lies; now then tell me wherewith thou shalt be bound."],["11",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτήν",702165,104],["ἐὰν",703912,7],["δεσμεύοντες",703369,146],["δήσωσίν",703394,234],["με",708618,163],["ἐν",704639,0],["καλωδίοις",707104,96],["καινοῖς",707042,94],["οἷς",709781,295],["οὐκ",709805,28],["ἐγένετο",703104,23],["ἐν",704639,0],["αὐτοῖς",702165,206],["ἔργον",705396,25],["καὶ",707031,7],["ἀσθενήσω",701938,207],["καὶ",707031,7],["ἔσομαι",704093,181],["ὡς",714148,7],["εἷς",704106,14],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"And he said to her, If they should bind me fast with new ropes with which work has not been done, then shall I be weak, and shall be as another man."],["12",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Δαλιδα",703266,12],["καλώδια",707104,42],["καινὰ",707042,68],["καὶ",707031,7],["ἔδησεν",703394,2],["αὐτὸν",702165,85],["ἐν",704639,0],["αὐτοῖς",702165,151],["κ