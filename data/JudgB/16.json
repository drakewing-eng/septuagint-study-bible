,2],["αὐτὸν",702165,85],["ἐν",704639,0],["λόγοις",708236,148],["αὐτῆς",702165,86],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["καὶ",707031,7],["ἐστενοχώρησεν",712070,2],["αὐτόν",702165,85],["καὶ",707031,7],["ὠλιγοψύχησεν",709575,2],["ἕως",705792,0],["τοῦ",709436,20],["ἀποθανεῖν",701461,106]],"And it came to pass as she pressed him sore with her words continually, and straitened him, that his spirit failed almost to death."],["17",[["καὶ",707031,7],["ἀνήγγειλεν",700921,2],["αὐτῇ",702165,105],["τὴν",709436,8],["πᾶσαν",710177,36],["καρδίαν",707141,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῇ",702165,105],["σίδηρος",711774,4],["οὐκ",709805,28],["ἀνέβη",700905,2],["ἐπὶ",705080,0],["τὴν",709436,8],["κεφαλήν",707639,9],["μου",709032,133],["ὅτι",709803,7],["ἅγιος",700159,14],["θεοῦ",706192,18],["ἐγώ",704018,164],["εἰμι",704093,157],["ἀπὸ",701425,0],["κοιλίας",707761,17],["μητρός",708892,17],["μου",709032,133],["ἐὰν",703912,7],["οὖν",709835,11],["ξυρήσωμαι",709431,410],["ἀποστήσεται",702214,93],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["ἡ",709436,10],["ἰσχύς",706858,12],["μου",709032,133],["καὶ",707031,7],["ἀσθενήσω",701938,207],["καὶ",707031,7],["ἔσομαι",704093,181],["ὡς",714148,7],["πάντες",710177,138],["οἱ",709436,136],["ἄνθρωποι",701163,52]],"Then he told her all his heart, and said to her, A razor has not come upon my head, because I have been a holy [one] of God from my mother's womb; if then I should be shaven, my strength will depart from me, and I shall be weak, and I shall be as all [other] men."],["18",[["καὶ",707031,7],["εἶδεν",709725,2],["Δαλιδα",703266,12],["ὅτι",709803,7],["ἀπήγγειλεν",701321,2],["αὐτῇ",702165,105],["πᾶσαν",710177,36],["τὴν",709436,8],["καρδίαν",707141,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["καὶ",707031,7],["ἐκάλεσεν",707084,2],["τοὺς",709436,58],["ἄρχοντας",701862,57],["τῶν",709436,80],["ἀλλοφύλων",700706,169],["λέγουσα",708124,188],["ἀνάβητε",700905,74],["ἔτι",705538,28],["τὸ",709436,24],["ἅπαξ",701350,28],["τοῦτο",709858,129],["ὅτι",709803,7],["ἀπήγγειλέν",701321,2],["μοι",708974,159],["τὴν",709436,8],["πᾶσαν",710177,36],["καρδίαν",707141,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀνέβησαν",700905,150],["πρὸς",710844,0],["αὐτὴν",702165,104],["οἱ",709436,136],["ἄρχοντες",701862,52],["τῶν",709436,80],["ἀλλοφύλων",700706,169],["καὶ",707031,7],["ἀνήνεγκαν",701083,150],["τὸ",709436,24],["ἀργύριον",701707,25],["ἐν",704639,0],["χερσὶν",713787,76],["αὐτῶν",702165,40]],"And Dalida saw that he told her all his heart, and she sent and called the princes of the Philistines, saying, Come up yet this once; for he has told me all his heart. And the chiefs of the Philistines went up to her, and brought the money in their hands."],["19",[["καὶ",707031,7],["ἐκοίμισεν",707769,2],["Δαλιδα",703266,12],["τὸν",709436,5],["Σαμψων",711482,6],["ἐπὶ",705080,0],["τὰ",709436,41],["γόνατα",703172,42],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐκάλεσεν",707084,2],["ἄνδρα",701150,6],["καὶ",707031,7],["ἐξύρησεν",709431,2],["τὰς",709436,38],["ἑπτὰ",705357,59],["σειρὰς",711625,39],["τῆς",709436,16],["κεφαλῆς",707639,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἤρξατο",701860,23],["ταπεινῶσαι",712717,106],["αὐτόν",702165,85],["καὶ",707031,7],["ἀπέστη",702214,2],["ἡ",709436,10],["ἰσχὺς",706858,12],["αὐτοῦ",702165,102],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102]],"And Dalida made Sampson sleep upon her knees; and she called a man, and he shaved the seven locks of his head, and she began to humble him, and his strength departed from him."],["20",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαλιδα",703266,12],["ἀλλόφυλοι",700706,138],["ἐπὶ",705080,0],["σέ",711598,163],["Σαμψων",711482,153],["καὶ",707031,7],["ἐξυπνίσθη",704979,37],["ἐκ",704132,0],["τοῦ",709436,35],["ὕπνου",713181,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["ἐξελεύσομαι",704909,181],["ὡς",714148,7],["ἅπαξ",701350,28],["καὶ",707031,7],["ἅπαξ",701350,28],["καὶ",707031,7],["ἐκτιναχθήσομαι",704334,180],["καὶ",707031,7],["αὐτὸς",702165,121],["οὐκ",709805,28],["ἔγνω",703105,2],["ὅτι",709803,7],["ἀπέστη",702214,2],["ὁ",709436,3],["κύριος",707996,4],["ἀπάνωθεν",701349,28],["αὐτοῦ",702165,102]],"And Dalida said, The Philistines [are] upon thee, Sampson: and he awoke out of his sleep and said, I will go out as at former times, and shake myself; and he knew not that the Lord was departed from him."],["21",[["καὶ",707031,7],["ἐκράτησαν",707879,150],["αὐτὸν",702165,85],["οἱ",709436,136],["ἀλλόφυλοι",700706,138],["καὶ",707031,7],["ἐξέκοψαν",704225,150],["τοὺς",709436,58],["ὀφθαλμοὺς",709870,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["κατήνεγκαν",707471,150],["αὐτὸν",702165,85],["εἰς",704105,0],["Γάζαν",702884,9],["καὶ",707031,7],["ἐπέδησαν",705118,150],["αὐτὸν",702165,85],["ἐν",704639,0],["πέδαις",710210,76],["χαλκείαις",713689,291],["καὶ",707031,7],["ἦν",704093,13],["ἀλήθων",700661,72],["ἐν",704639,0],["οἴκῳ",709516,114],["τοῦ",709436,20],["δεσμωτηρίου",703374,21]],"And the Philistines took him, and put out his eyes, and brought him down to Gaza, and bound him with fetters of brass; and he ground in the prison-house."],["22",[["καὶ",707031,7],["ἤρξατο",701860,23],["θρὶξ",706312,12],["τῆς",709436,16],["κεφαλῆς",707639,17],["αὐτοῦ",702165,102],["βλαστάνειν",702733,55],["καθὼς",707030,28],["ἐξυρήσατο",709431,23]],"And the hair of his head began to grow as before it was shaven."],["23",[["καὶ",707031,7],["οἱ",709436,136],["ἄρχοντες",701862,52],["τῶν",709436,80],["ἀλλοφύλων",700706,169],["συνήχθησαν",712375,99],["θῦσαι",706349,106],["θυσίασμα",706347,25],["μέγα",708653,46],["τῷ",709436,113],["Δαγων",703240,114],["θεῷ",706192,114],["αὐτῶν",702165,40],["καὶ",707031,7],["εὐφρανθῆναι",705715,179],["καὶ",707031,7],["εἶπαν",705373,150],["ἔδωκεν",703654,2],["ὁ",709436,3],["θεὸς",706192,4],["ἐν",704639,0],["χειρὶ",713787,1],["ἡμῶν",705999,145],["τὸν",709436,5],["Σαμψων",711482,6],["τὸν",709436,5],["ἐχθρὸν",705779,6],["ἡμῶν",705999,145]],"And the chiefs of the Philistines met to offer a great sacrifice to their god Dagon, and to make merry; and they said, God has given into our hand our enemy Sampson."],["24",[["καὶ",707031,7],["εἶδαν",709725,150],["αὐτὸν",702165,85],["ὁ",709436,3],["λαὸς",708094,4],["καὶ",707031,7],["ὕμνησαν",713085,150],["τὸν",709436,5],["θεὸν",706192,6],["αὐτῶν",702165,40],["ὅτι",709803,7],["παρέδωκεν",710014,2],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["τὸν",709436,5],["ἐχθρὸν",705779,6],["ἡμῶν",705999,145],["ἐν",704639,0],["χειρὶ",713787,1],["ἡμῶν",705999,145],["τὸν",709436,5],["ἐρημοῦντα",705421,183],["τὴν",709436,8],["γῆν",703083,9],["ἡμῶν",705999,145],["καὶ",707031,7],["ὃς",709781,213],["ἐπλήθυνεν",710530,13],["τοὺς",709436,58],["τραυματίας",712921,57],["ἡμῶν",705999,145]],"And the people saw him, and sang praises to their god; for our god, [said they], has delivered into our hand our enemy, who wasted our land, and who multiplied our slain."],["25",[["καὶ",707031,7],["ὅτε",709802,28],["ἠγαθύνθη",700109,37],["ἡ",709436,10],["καρδία",707141,12],["αὐτῶν",702165,40],["καὶ",707031,7],["εἶπαν",705373,150],["καλέσατε",707084,74],["τὸν",709436,5],["Σαμψων",711482,6],["ἐξ",704132,0],["οἴκου",709516,18],["φυλακῆς",713613,17],["καὶ",707031,7],["παιξάτω",709931,45],["ἐνώπιον",704823,0],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐκάλεσαν",707084,150],["τὸν",709436,5],["Σαμψων",711482,6],["ἀπὸ",701425,0],["οἴκου",709516,18],["δεσμωτηρίου",703374,21],["καὶ",707031,7],["ἔπαιζεν",709931,13],["ἐνώπιον",704823,0],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐρράπιζον",711182,137],["αὐτὸν",702165,85],["καὶ",707031,7],["ἔστησαν",706846,150],["αὐτὸν",702165,85],["ἀνὰ",700902,0],["μέσον",708768,27],["τῶν",709436,80],["κιόνων",707701,81]],"And when their heart was merry, then they said, Call Sampson out of the prison-house, and let him play before us: and they called Sampson out of the prison-house, and he played before them; and they smote him with the palms of their hands, and set him between the pillars."],["26",[["καὶ",707031,7],["εἶπεν",705373,2],["Σαμψων",711482,4],["πρὸς",710844,0],["τὸν",709436,5],["νεανίαν",709229,6],["τὸν",709436,5],["κρατοῦντα",707879,183],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["ἄφες",702211,176],["με",708618,163],["καὶ",707031,7],["ψηλαφήσω",714047,207],["τοὺς",709436,58],["κίονας",707701,57],["ἐφ᾿",705080,0],["οἷς",709781,311],["ὁ",709436,3],["οἶκος",709516,4],["στήκει",712091,91],["ἐπ᾿",705080,0],["αὐτούς",702165,62],["καὶ",707031,7],["ἐπιστηριχθήσομαι",705270,180],["ἐπ᾿",705080,0],["αὐτούς",702165,62]],"And Sampson said to the young man that held his hand, Suffer me to feel the pillars on which the house [rests], and I will stay myself upon them."],["27",[["καὶ",707031,7],["ὁ",709436,3],["οἶκος",709516,4],["πλήρης",710541,14],["τῶν",709436,80],["ἀνδρῶν",701150,81],["καὶ",707031,7],["τῶν",709436,130],["γυναικῶν",703209,65],["καὶ",707031,7],["ἐκεῖ",704181,28],["πάντες",710177,138],["οἱ",709436,136],["ἄρχοντες",701862,52],["τῶν",709436,80],["ἀλλοφύλων",700706,169],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸ",709436,24],["δῶμα",703896,25],["ὡς",714148,7],["ἑπτακόσιοι",705365,138],["ἄνδρες",701150,52],["καὶ",707031,7],["γυναῖκες",703209,191],["οἱ",709436,136],["θεωροῦντες",706226,146],["ἐν",704639,0],["παιγνίαις",709921,76],["Σαμψων",711482,114]],"And the house [was] full of men and women, and there [were] all the chiefs of the Philistines, and on the roof [were] about three thousand men and women looking at the sports of Sampson."],["28",[["καὶ",707031,7],["ἔκλαυσεν",707703,2],["Σαμψων",711482,4],["πρὸς",710844,0],["κύριον",707996,6],["καὶ",707031,7],["εἶπεν",705373,2],["Αδωναιε",700302,153],["κύριε",707996,153],["μνήσθητι",708960,244],["δή",703395,11],["μου",709032,133],["νῦν",709384,28],["καὶ",707031,7],["ἐνίσχυσόν",704750,176],["με",708618,163],["ἔτι",705538,28],["τὸ",709436,24],["ἅπαξ",701350,28],["τοῦτο",709858,129],["θεέ",706192,153],["καὶ",707031,7],["ἀνταποδώσω",701215,165],["ἀνταπόδοσιν",701217,9],["μίαν",704106,36],["περὶ",710285,0],["τῶν",709436,80],["δύο",703849,59],["ὀφθαλμῶν",709870,81],["μου",709032,133],["τοῖς",709436,147],["ἀλλοφύλοις",700706,230]],"And Sampson wept before the Lord, and said, O Lord, my Lord, remember me, I pray thee, and strengthen me, O God, yet this once, and I will requite one recompense to the Philistines for my two eyes."],["29",[["καὶ",707031,7],["περιέλαβεν",710342,2],["Σαμψων",711482,4],["τοὺς",709436,58],["δύο",703849,59],["κίονας",707701,57],["τοῦ",709436,35],["οἴκου",709516,18],["ἐφ᾿",705080,0],["οὓς",709781,298],["ὁ",709436,3],["οἶκος",709516,4],["εἱστήκει",706846,143],["καὶ",707031,7],["ἐπεστηρίχθη",705270,37],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἐκράτησεν",707879,2],["ἕνα",704106,27],["τῇ",709436,100],["δεξιᾷ",703360,101],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἕνα",704106,27],["τῇ",709436,100],["ἀριστερᾷ",701749,101],["αὐτοῦ",702165,102]],"And Sampson took hold of the two pillars of the house on which the house stood, and leaned on them, and laid hold of one with his right hand, and the other with his left."],["30",[["καὶ",707031,7],["εἶπεν",705373,2],["Σαμψων",711482,4],["ἀποθανέτω",701461,45],["ψυχή",714070,12],["μου",709032,133],["μετὰ",708780,0],["ἀλλοφύλων",700706,169],["καὶ",707031,7],["ἐβάσταξεν",702594,2],["ἐν",704639,0],["ἰσχύι",706858,1],["καὶ",707031,7],["ἔπεσεν",710481,2],["ὁ",709436,3],["οἶκος",709516,4],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἄρχοντας",701862,57],["καὶ",707031,7],["ἐπὶ",705080,0],["πάντα",710177,27],["τὸν",709436,5],["λαὸν",708094,6],["τὸν",709436,5],["ἐν",704639,0],["αὐτῷ",702165,50],["καὶ",707031,7],["ἦσαν",704093,137],["οἱ",709436,136],["τεθνηκότες",706278,268],["οὓς",709781,298],["ἐθανάτωσεν",706097,2],["Σαμψων",711482,4],["ἐν",704639,0],["τῷ",709436,113],["θανάτῳ",706096,114],["αὐτοῦ",702165,102],["πλείους",710514,267],["ἢ",705924,7],["οὓς",709781,298],["ἐθανάτωσεν",706097,2],["ἐν",704639,0],["τῇ",709436,100],["ζωῇ",705910,1],["αὐτοῦ",702165,102]],"And Sampson said, Let my life perish with the Philistines: and he bowed himself mightily; and the house fell upon the princes, and upon all the people that were in it: and the dead whom Sampson slew in his death were more than those whom he slew in his life."],["31",[["καὶ",707031,7],["κατέβησαν",707202,150],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὁ",709436,3],["οἶκος",709516,4],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔλαβον",708076,150],["αὐτὸν",702165,85],["καὶ",707031,7],["ἀνέβησαν",700905,150],["καὶ",707031,7],["ἔθαψαν",706103,150],["αὐτὸν",702165,85],["ἀνὰ",700902,0],["μέσον",708768,27],["Σαραα",711508,118],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,27],["Εσθαολ",705486,118],["ἐν",704639,0],["τῷ",709436,113],["τάφῳ",712738,114],["Μανωε",708492,18],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["αὐτὸς",702165,121],["ἔκρινεν",707905,2],["τὸν",709436,5],["Ισραηλ",706839,18],["εἴκοσι",704085,59],["ἔτη",705543,42]],"And his brethren and his father's house went down, and they took him; and they went up and buried him between Saraa and Esthaol in the sepulchre of his father Manoë; and he judged Israel twenty years."]]