[["1",[["καὶ",707031,7],["κατέβη",707202,2],["Σαμψων",711482,4],["εἰς",704105,0],["Θαμναθα",706085,227],["καὶ",707031,7],["εἶδεν",709725,2],["γυναῖκα",703209,9],["εἰς",704105,0],["Θαμναθα",706085,227],["ἀπὸ",701425,0],["τῶν",709436,130],["θυγατέρων",706320,65],["τῶν",709436,80],["ἀλλοφύλων",700706,169]],"And Sampson went down to Thamnatha, and saw a woman in Thamnatha of the daughters of the Philistines."],["2",[["καὶ",707031,7],["ἀνέβη",700905,2],["καὶ",707031,7],["ἀπήγγειλεν",701321,2],["τῷ",709436,113],["πατρὶ",710189,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["τῇ",709436,100],["μητρὶ",708892,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["γυναῖκα",703209,9],["ἑόρακα",709725,89],["ἐν",704639,0],["Θαμναθα",706085,111],["ἀπὸ",701425,0],["τῶν",709436,130],["θυγατέρων",706320,65],["Φυλιστιιμ",713621,81],["καὶ",707031,7],["νῦν",709384,28],["λάβετε",708076,74],["αὐτὴν",702165,104],["ἐμοὶ",704577,159],["εἰς",704105,0],["γυναῖκα",703209,9]],"And he went up and told his father and his mother, and said, I have seen a woman in Thamnatha of the daughters of the Phylistines; and now take her to me for a wife."],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἡ",709436,10],["μήτηρ",708892,12],["αὐτοῦ",702165,102],["μὴ",708851,28],["οὔκ",709805,28],["εἰσιν",704093,197],["θυγατέρες",706320,191],["τῶν",709436,80],["ἀδελφῶν",700249,81],["σου",711945,133],["καὶ",707031,7],["ἐκ",704132,0],["παντὸς",710177,116],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133],["γυνή",703209,12],["ὅτι",709803,7],["σὺ",712181,164],["πορεύῃ",710667,204],["λαβεῖν",708076,106],["γυναῖκα",703209,9],["ἀπὸ",701425,0],["τῶν",709436,80],["ἀλλοφύλων",700706,169],["τῶν",709436,80],["ἀπεριτμήτων",701397,169],["καὶ",707031,7],["εἶπεν",705373,2],["Σαμψων",711482,4],["πρὸς",710844,0],["τὸν",709436,5],["πατέρα",710189,6],["αὐτοῦ",702165,102],["ταύτην",709858,104],["λαβέ",708076,176],["μοι",708974,159],["ὅτι",7