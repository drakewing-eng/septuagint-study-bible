,7],["εἶπεν",705373,2],["εὔξασθε",705727,186],["περὶ",710285,0],["ἐμοῦ",704580,133],["πρὸς",710844,0],["κύριον",707996,6],["καὶ",707031,7],["περιελέτω",710288,45],["τοὺς",709436,58],["βατράχους",702599,57],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,35],["ἐμοῦ",704580,133],["λαοῦ",708094,18],["καὶ",707031,7],["ἐξαποστελῶ",704872,165],["τὸν",709436,5],["λαόν",708094,6],["καὶ",707031,7],["θύσωσιν",706349,234],["κυρίῳ",707996,114]],"And Pharao called Moses and Aaron, and said, Pray for me to the Lord, and let him take away the frogs from me and from my people; and I will send them away, and they shall sacrifice to the Lord."],["5",[["εἶπεν",705373,2],["δὲ",703303,11],["Μωυσῆς",709112,4],["πρὸς",710844,0],["Φαραω",713360,18],["τάξαι",712730,300],["πρός",710844,0],["με",708618,163],["πότε",710696,28],["εὔξωμαι",705727,410],["περὶ",710285,0],["σοῦ",711945,133],["καὶ",707031,7],["περὶ",710285,0],["τῶν",709436,80],["θεραπόντων",706201,81],["σου",711945,133],["καὶ",707031,7],["περὶ",710285,0],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133],["ἀφανίσαι",702182,106],["τοὺς",709436,58],["βατράχους",702599,57],["ἀπὸ",701425,0],["σοῦ",711945,133],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,130],["οἰκιῶν",709505,65],["ὑμῶν",713091,145],["πλὴν",710540,28],["ἐν",704639,0],["τῷ",709436,113],["ποταμῷ",710693,114],["ὑπολειφθήσονται",713212,144]],"And Moses said to Pharao, Appoint me [a time] when I shall pray for thee, and for thy servants, and for thy people, to cause the frogs to disappear from thee, and from thy people, and from your houses, only in the river shall they be left behind."],["6",[["ὁ",709436,3],["δὲ",703303,11],["εἶπεν",705373,2],["εἰς",704105,0],["αὔριον",702149,28],["εἶπεν",705373,2],["οὖν",709835,11],["ὡς",714148,28],["εἴρηκας",705415,266],["ἵνα",706747,7],["εἰδῇς",709492,411],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἄλλος",700697,121],["πλὴν",710540,28],["κυρίου",707996,18]],"And he said, On the morrow: he said therefore, As thou hast said; that thou mayest know, that there is no other [God] but the Lord."],["7",[["καὶ",707031,7],["περιαιρεθήσονται",710288,144],["οἱ",709436,136],["βάτραχοι",702599,52],["ἀπὸ",701425,0],["σοῦ",711945,133],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,130],["οἰκιῶν",709505,65],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,130],["ἐπαύλεων",705048,65],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,80],["θεραπόντων",706201,81],["σου",711945,133],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133],["πλὴν",710540,28],["ἐν",704639,0],["τῷ",709436,113],["ποταμῷ",710693,114],["ὑπολειφθήσονται",713212,144]],"And the frogs shall be removed away from thee, and from your houses and from the villages, and from thy servants, and from thy people, only in the river they shall be left."],["8",[["ἐξῆλθεν",704909,2],["δὲ",703303,11],["Μωυσῆς",709112,4],["καὶ",707031,7],["Ααρων",700005,4],["ἀπὸ",701425,0],["Φαραω",713360,18],["καὶ",707031,7],["ἐβόησεν",702743,2],["Μωυσῆς",709112,4],["πρὸς",710844,0],["κύριον",707996,6],["περὶ",710285,0],["τοῦ",709436,35],["ὁρισμοῦ",709750,18],["τῶν",709436,80],["βατράχων",702599,81],["ὡς",714148,7],["ἐτάξατο",712730,23],["Φαραω",713360,4]],"And Moses and Aaron went forth from Pharao, and Moses cried to the Lord concerning the restriction of the frogs, as Pharao appointed him."],["9",[["ἐποίησεν",710582,2],["δὲ",703303,11],["κύριος",707996,4],["καθάπερ",706984,28],["εἶπεν",705373,2],["Μωυσῆς",709112,4],["καὶ",707031,7],["ἐτελεύτησαν",712781,150],["οἱ",709436,136],["βάτραχοι",702599,52],["ἐκ",704132,0],["τῶν",709436,130],["οἰκιῶν",709505,65],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,130],["ἐπαύλεων",705048,65],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,80],["ἀγρῶν",700196,81]],"And the Lord did as Moses said, and the frogs died out of the houses, and out of the villages, and out of the fields."],["10",[["καὶ",707031,7],["συνήγαγον",712375,150],["αὐτοὺς",702165,62],["θιμωνιὰς",706266,39],["θιμωνιάς",706266,39],["καὶ",707031,7],["ὤζεσεν",709484,2],["ἡ",709436,10],["γῆ",703083,12]],"And they gathered them together in heaps, and the land stank."],["11",[["ἰδὼν",709725,182],["δὲ",703303,11],["Φαραω",713360,4],["ὅτι",709803,7],["γέγονεν",703104,171],["ἀνάψυξις",701093,12],["ἐβαρύνθη",702553,37],["ἡ",709436,10],["καρδία",707141,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["εἰσήκουσεν",704108,2],["αὐτῶν",702165,40],["καθάπερ",706984,28],["ἐλάλησεν",708071,2],["κύριος",707996,4]],"And when Pharao saw that there was relief, his heart was hardened, and he did not hearken to them, as the Lord spoke."],["12",[["εἶπεν",705373,2],["δὲ",703303,11],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["εἰπὸν",705373,176],["Ααρων",700005,114],["ἔκτεινον",704322,176],["τῇ",709436,100],["χειρὶ",713787,1],["τὴν",709436,8],["ῥάβδον",711135,9],["σου",711945,133],["καὶ",707031,7],["πάταξον",710185,176],["τὸ",709436,24],["χῶμα",714000,25],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἔσονται",704093,135],["σκνῖφες",711866,52],["ἔν",704639,0],["τε",712751,11],["τοῖς",709436,147],["ἀνθρώποις",701163,148],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["τετράποσιν",712823,94],["καὶ",707031,7],["ἐν",704639,0],["πάσῃ",710177,101],["γῇ",703083,1],["Αἰγύπτου",700401,17]],"And the Lord said to Moses, Say to Aaron, Stretch forth thy rod with thy hand and smite the dust of the earth; and there shall be lice both upon man, and upon quadrupeds, and in all the land of Egypt."],["13",[["ἐξέτεινεν",704322,2],["οὖν",709835,11],["Ααρων",700005,4],["τῇ",709436,100],["χειρὶ",713787,1],["τὴν",709436,8],["ῥάβδον",711135,9],["καὶ",707031,7],["ἐπάταξεν",710185,2],["τὸ",709436,24],["χῶμα",714000,25],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἐγένοντο",703104,189],["οἱ",709436,136],["σκνῖφες",711866,52],["ἔν",704639,0],["τε",712751,11],["τοῖς",709436,147],["ἀνθρώποις",701163,148],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["τετράποσιν",712823,94],["καὶ",707031,7],["ἐν",704639,0],["παντὶ",710177,97],["χώματι",714000,54],["τῆς",709436,16],["γῆς",703083,17],["ἐγένοντο",703104,189],["οἱ",709436,136],["σκνῖφες",711866,52],["ἐν",704639,0],["πάσῃ",710177,101],["γῇ",703083,1],["Αἰγύπτου",700401,17]],"So Aaron stretched out his rod with his hand, and smote the dust of the earth; and the lice were on men and on quadrupeds, and in all the dust of the earth there were lice."],["14",[["ἐποιήσαν",710582,150],["δὲ",703303,11],["ὡσαύτως",714158,28],["καὶ",707031,7],["οἱ",709436,136],["ἐπαοιδοὶ",705035,52],["ταῖς",709436,75],["φαρμακείαις",713368,76],["αὐτῶν",702165,40],["ἐξαγαγεῖν",704834,106],["τὸν",709436,5],["σκνῖφα",711866,6],["καὶ",707031,7],["οὐκ",709805,28],["ἠδύναντο",703838,139],["καὶ",707031,7],["ἐγένοντο",703104,189],["οἱ",709436,136],["σκνῖφες",711866,52],["ἐν",704639,0],["τοῖς",709436,147],["ἀνθρώποις",701163,148],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["τετράποσιν",712823,94]],"And the charmers also did so with their sorceries, to bring forth the louse, and they could not. And the lice were both on the men and on the quadrupeds."],["15",[["εἶπαν",705373,150],["οὖν",709835,11],["οἱ",709436,136],["ἐπαοιδοὶ",705035,52],["τῷ",709436,113],["Φαραω",713360,114],["δάκτυλος",703259,4],["θεοῦ",706192,18],["ἐστιν",704093,91],["τοῦτο",709858,132],["καὶ",707031,7],["ἐσκληρύνθη",711864,37],["ἡ",709436,10],["καρδία",707141,12],["Φαραω",713360,4],["καὶ",707031,7],["οὐκ",709805,28],["εἰσήκουσεν",704108,2],["αὐτῶν",702165,40],["καθάπερ",706984,28],["ἐλάλησεν",708071,2],["κύριος",707996,4]],"So the charmers said to Pharao, This is the finger of God. But the heart of Pharao was hardened, and he hearkened not to them, as the Lord said."],["16",[["εἶπεν",705373,2],["δὲ",703303,11],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["ὄρθρισον",709742,176],["τὸ",709436,24],["πρωὶ",