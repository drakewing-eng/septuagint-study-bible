6,10],["γῆ",703083,12],["ἀπὸ",701425,0],["τῆς",709436,16],["κυνομυίης",707978,17]],"And the dog-fly came in abundance into the houses of Pharao, and into the houses of his servants, and into all the land of Egypt; and the land was destroyed by the dog-fly."],["21",[["ἐκάλεσεν",707084,2],["δὲ",703303,11],["Φαραω",713360,4],["Μωυσῆν",709112,6],["καὶ",707031,7],["Ααρων",700005,6],["λέγων",708124,72],["ἐλθόντες",705453,196],["θύσατε",706349,74],["τῷ",709436,113],["θεῷ",706192,114],["ὑμῶν",713091,145],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1]],"And Pharao called Moses and Aaron, saying, Go and sacrifice to the Lord your God in the land."],["22",[["καὶ",707031,7],["εἶπεν",705373,2],["Μωυσῆς",709112,4],["οὐ",709805,28],["δυνατὸν",703845,46],["γενέσθαι",703104,109],["οὕτως",709859,28],["τὰ",709436,41],["γὰρ",702963,11],["βδελύγματα",702604,42],["τῶν",709436,80],["Αἰγυπτίων",700400,81],["θύσομεν",706349,275],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["ἡμῶν",705999,145],["ἐὰν",703912,7],["γὰρ",702963,11],["θύσωμεν",706349,79],["τὰ",709436,41],["βδελύγματα",702604,42],["τῶν",709436,80],["Αἰγυπτίων",700400,81],["ἐναντίον",704654,0],["αὐτῶν",702165,40],["λιθοβοληθησόμεθα",708194,347]],"And Moses said, It cannot be so, for we shall sacrifice to the Lord our God the abominations of the Egyptians; for if we sacrifice the abominations of the Egyptians before them, we shall be stoned."],["23",[["ὁδὸν",709458,9],["τριῶν",712927,198],["ἡμερῶν",705984,65],["πορευσόμεθα",710667,141],["εἰς",704105,0],["τὴν",709436,8],["ἔρημον",705420,9],["καὶ",707031,7],["θύσομεν",706349,275],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["ἡμῶν",705999,145],["καθάπερ",706984,28],["εἶπεν",705373,2],["ἡμῖν",705994,90]],"We will go a journey of three days into the wilderness, and we will sacrifice to the Lord our God, as the Lord said to us."],["24",[["καὶ",707031,7],["εἶπεν",705373,2],["Φαραω",713360,4],["ἐγὼ",704018,164],["ἀποστέλλω",701592,157],["ὑμᾶς",713080,194],["καὶ",707031,7],["θύσατε",706349,74],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["ὑμῶν",713091,145],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["ἀλλ᾿",700680,7],["οὐ",709805,28],["μακρὰν",708411,28],["ἀποτενεῖτε",701609,337],["πορευθῆναι",710667,179],["εὔξασθε",705727,186],["οὖν",709835,11],["περὶ",710285,0],["ἐμοῦ",704580,133],["πρὸς",710844,0],["κύριον",707996,6]],"And Pharao said, I [will] let you go, and do ye sacrifice to your God in the wilderness, but do not go very far away: pray then for me to the Lord."],["25",[["εἶπεν",705373,2],["δὲ",703303,11],["Μωυσῆς",709112,4],["ὅδε",709446,121],["ἐγὼ",704018,164],["ἐξελεύσομαι",704909,181],["ἀπὸ",701425,0],["σοῦ",711945,133],["καὶ",707031,7],["εὔξομαι",705727,181],["πρὸς",710844,0],["τὸν",709436,5],["θεόν",706192,6],["καὶ",707031,7],["ἀπελεύσεται",701398,93],["ἡ",709436,10],["κυνόμυια",707978,12],["ἀπὸ",701425,0],["σοῦ",711945,133],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,80],["θεραπόντων",706201,81],["σου",711945,133],["καὶ",707031,7],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133],["αὔριον",702149,28],["μὴ",708851,28],["προσθῇς",710965,175],["ἔτι",705538,28],["Φαραω",713360,153],["ἐξαπατῆσαι",704867,106],["τοῦ",709436,20],["μὴ",708851,28],["ἐξαποστεῖλαι",704872,106],["τὸν",709436,5],["λαὸν",708094,6],["θῦσαι",706349,106],["κυρίῳ",707996,114]],"And Moses said, I then will go forth from thee and pray to God, and the dog-fly shall depart both from thy servants, and from thy people to-morrow. Do not thou, Pharao, deceive again, so as not to send the people away to do sacrifice to the Lord."],["26",[["ἐξῆλθεν",704909,2],["δὲ",703303,11],["Μωυσῆς",709112,4],["ἀπὸ",701425,0],["Φαραω",713360,18],["καὶ",707031,7],["ηὔξατο",705727,23],["πρὸς",710844,0],["τὸν",709436,5],["θεόν",706192,6]],"And Moses went out from Pharao, and prayed to God."],["27",[["ἐποίησεν",710582,2],["δὲ",703303,11],["κύριος",707996,4],["καθάπερ",706984,28],["εἶπεν",705373,2],["Μωυσῆς",709112,4],["καὶ",707031,7],["περιεῖλεν",710288,2],["τὴν",709436,8],["κυνόμυιαν",707978,9],["ἀπὸ",701425,0],["Φαραω",713360,18],["καὶ",707031,7],["τῶν",709436,80],["θεραπόντων",706201,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐ",709805,28],["κατελείφθη",707305,37],["οὐδεμία",709817,29]],"And the Lord did as Moses said, and removed the dog-fly from Pharao, and from his servants, and from his people, and there was not one left."],["28",[["καὶ",707031,7],["ἐβάρυνεν",702553,13],["Φαραω",713360,4],["τὴν",709436,8],["καρδίαν",707141,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπὶ",705080,0],["τοῦ",709436,35],["καιροῦ",707047,18],["τούτου",709858,102],["καὶ",707031,7],["οὐκ",709805,28],["ἠθέλησεν",706176,2],["ἐξαποστεῖλαι",704872,106],["τὸν",709436,5],["λαόν",708094,6]],"And Pharao hardened his heart, even on this occasion, and he would not send the people away."]]