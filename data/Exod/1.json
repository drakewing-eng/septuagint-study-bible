[["1",[["ταῦτα",709858,290],["τὰ",709436,63],["ὀνόματα",709666,64],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["τῶν",709436,80],["εἰσπεπορευμένων",704124,398],["εἰς",704105,0],["Αἴγυπτον",700401,9],["ἅμα",700745,28],["Ιακωβ",706401,114],["τῷ",709436,113],["πατρὶ",710189,114],["αὐτῶν",702165,40],["ἕκαστος",704133,14],["πανοικίᾳ",709967,1],["αὐτῶν",702165,40],["εἰσήλθοσαν",704114,150]],"These are the names of the sons of Israel that came into Egypt together with Jacob their father; they came in each with their whole family."],["2",[["Ρουβην",711295,4],["Συμεων",712297,4],["Λευι",708158,4],["Ιουδας",706775,4]],"Ruben, Simeon, Levi, Judas,"],["3",[["Ισσαχαρ",706843,4],["Ζαβουλων",705813,4],["καὶ",707031,7],["Βενιαμιν",702650,4]],"Issachar, Zabulon, Benjamin,"],["4",[["Δαν",703276,4],["καὶ",707031,7],["Νεφθαλι",709279,4],["Γαδ",702872,4],["καὶ",707031,7],["Ασηρ",701934,4]],"Dan and Nephthalim, Gad and Aser."],["5",[["Ιωσηφ",706948,4],["δὲ",703303,11],["ἦν",704093,13],["ἐν",704639,0],["Αἰγύπτῳ",700401,1],["ἦσαν",704093,137],["δὲ",703303,11],["πᾶσαι",710177,192],["ψυχαὶ",714070,191],["ἐξ",704132,0],["Ιακωβ",706401,18],["πέντε",710266,59],["καὶ",707031,7],["ἑβδομήκοντα",703922,59]],"But Joseph was in Egypt. And all the souls [born] of Jacob were seventy-five."],["6",[["ἐτελεύτησεν",712781,2],["δὲ",703303,11],["Ιωσηφ",706948,4],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["πᾶσα",710177,29],["ἡ",709436,10],["γενεὰ",703037,12],["ἐκείνη",704183,107]],"And Joseph died, and all his brethren, and all that generation."],["7",[["οἱ",709436,136],["δὲ",703303,11],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["ηὐξήθησαν",702144,99],["καὶ",707031,7],["ἐπληθύνθησαν",710530,99],["καὶ",707031,7],["χυδαῖοι",713984,138],["ἐγένοντο",703104,189],["καὶ",707031,7],["κατίσχυον",707531,137],["σφόδρα",712586,28],["σφόδρα",712586,28],["ἐπλήθυνεν",710530,2],["δὲ",703303,11],["ἡ",709436,10],["γῆ",703083,12],["αὐτούς",702165,62]],"And the children of Israel increased and multiplied, and became numerous and grew exceedingly strong, and the land multiplied them."],["8",[["ἀνέστη",701173,2],["δὲ",703303,11],["βασιλεὺς",702580,4],["ἕτερος",705535,14],["ἐπ᾿",705080,0],["Αἴγυπτον",700401,9],["ὃς",709781,213],["οὐκ",709805,28],["ᾔδει",709492,143],["τὸν",709436,5],["Ιωσηφ",706948,6]],"And there arose up another king over Egypt, who knew not Joseph."],["9",[["εἶπεν",705373,2],["δὲ",703303,11],["τῷ",709436,53],["ἔθνει",704068,54],["αὐτοῦ",702165,102],["ἰδοὺ",706497,88],["τὸ",709436,34],["γένος",703057,15],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["μέγα",708653,26],["πλῆθος",710529,15],["καὶ",707031,7],["ἰσχύει",706859,91],["ὑπὲρ",713111,0],["ἡμᾶς",705981,194]],"And he said to his nation, Behold, the race of the children of Israel is a great multitude, and is stronger than we:"],["10",[["δεῦτε",703383,28],["οὖν",709835,11],["κατασοφισώμεθα",707429,276],["αὐτούς",702165,62],["μήποτε",708882,28],["πληθυνθῇ",710530,384],["καί",707031,7],["ἡνίκα",706008,28],["ἂν",700900,11],["συμβῇ",712277,172],["ἡμῖν",705994,90],["πόλεμος",710605,4],["προστεθήσονται",710965,144],["καὶ",707031,7],["οὗτοι",709858,201],["πρὸς",710844,0],["τοὺς",709436,58],["ὑπεναντίους",713109,60],["καὶ",707031,7],["ἐκπολεμήσαντες",704290,196],["ἡμᾶς",705981,194],["ἐξελεύσονται",704909,135],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17]],"come then, let us deal craftily with them, lest at any time they be increased, and whensoever war shall happen to us, these also shall be added to our enemies, and having prevailed against us in war, they will depart out of the land."],["11",[["καὶ",707031,7],["ἐπέστησεν",705264,2],["αὐτοῖς",702165,151],["ἐπιστάτας",705266,57],["τῶν",709436,43],["ἔργων",705396,44],["ἵνα",706747,7],["κακώσωσιν",707073,234],["αὐτοὺς",702165,62],["ἐν",704639,0],["τοῖς",709436,95],["ἔργοις",705396,96],["καὶ",707031,7],["ᾠκοδόμησαν",709509,150],["πόλεις",710612,39],["ὀχυρὰς",709889,119],["τῷ",709436,113],["Φαραω",713360,114],["τήν",709436,8],["τε",712751,11],["Πιθωμ",710468,9],["καὶ",707031,7],["Ραμεσση",711167,9],["καὶ",707031,7],["Ων",714118,6],["ἥ",709781,177],["ἐστιν",704093,91],["Ἡλίου",705974,18],["πόλις",710612,12]],"And he set over them task-masters, who should afflict them in their works; and they built strong cities for Pharao, both Pitho, and Ramesses, and On, which is Heliopolis."],["12",[["καθότι",707021,28],["δὲ",703303,11],["αὐτοὺς",702165,62],["ἐταπείνουν",712717,137],["τοσούτῳ",712907,30],["πλείους",710514,267],["ἐγίνοντο",703104,139],["καὶ",707031,7],["ἴσχυον",706859,137],["σφόδρα",712586,28],["σφόδρα",712586,28],["καὶ",707031,7],["ἐβδελύσσοντο",702608,139],["οἱ",709436,136],["Αἰγύπτιοι",700400,52],["ἀπὸ",701425,0],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18]],"But as they humbled them, by so much they multiplied, and grew exceedingly strong; and the Egyptians greatly abhorred the children of Israel."],["13",[["καὶ",707031,7],["κατεδυνάστευον",707248,137],["οἱ",709436,136],["Αἰγύπτιοι",700400,52],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ισραηλ",706839,18],["βίᾳ",702712,1]],"And the Egyptians tyrannised over the children of Israel by force."],["14",[["καὶ",707031,7],["κατωδύνων",707532,137],["αὐτῶν",702165,40],["τὴν",709436,8],["ζωὴν",705910,9],["ἐν",704639,0],["τοῖς",709436,95],["ἔργοις",705396,96],["τοῖς",709436,95],["σκληροῖς",711861,94],["τῷ",709436,113],["πηλῷ",710457,114],["καὶ",707031,7],["τῇ",709436,100],["πλινθείᾳ",710551,1],["καὶ",707031,7],["πᾶσι",710177,94],["τοῖς",709436,95],["ἔργοις",705396,96],["τοῖς",709436,95],["ἐν",704639,0],["τοῖς",709436,95],["πεδίοις",710215,96],["κατὰ",707200,0],["πάντα",710177,68],["τὰ",709436,41],["ἔργα",705396,42],["ὧν",709781,103],["κατεδουλοῦντο",707245,139],["αὐτοὺς",702165,62],["μετὰ",708780,0],["βίας",702712,17]],"And they embittered their life by hard labours, in the clay and in brick-making, and all the works in the plains, according to all the works, wherein they caused them to serve with violence."],["15",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["τῶν",709436,80],["Αἰγυπτίων",700400,81],["ταῖς",709436,75],["μαίαις",708381,76],["τῶν",709436,80],["Εβραίων",703933,81],["τῇ",709436,100],["μιᾷ",704106,101],["αὐτῶν",702165,40],["ᾗ",709781,108],["ὄνομα",709666,15],["Σεπφωρα",711699,12],["καὶ",707031,7],["τὸ",709436,34],["ὄνομα",709666,15],["τῆς",709436,16],["δευτέρας",703389,82],["Φουα",713564,12]],"And the king of the Egyptians spoke to the midwives of the Hebrews; the name of the one was, Sepphora; and the name of the second, Phua."],["16",[["καὶ",707031,7],["εἶπεν",705373,2],["ὅταν",709801,28],["μαιοῦσθε",708390,374],["τὰς",709436,38],["Εβραίας",703932,39],["καὶ",707031,7],["ὦσιν",704093,271],["πρὸς",710844,0],["τῷ",709436,53],["τίκτειν",712853,55],["ἐὰν",703912,7],["μὲν",708730,11],["ἄρσεν",701818,26],["ᾖ",704093,204],["ἀποκτείνατε",701498,74],["αὐτό",702165,129],["ἐὰν",703912,7],["δὲ",703303,11],["θῆλυ",706237,26],["περιποιεῖσθε",710367,73],["αὐτό",702165,129]],"And he said, When ye do the office of midwives to the Hebrew women, and they are about to be delivered, if it be a male, kill it; but if a female, save it."],["17",[["ἐφοβήθησαν",713532,99],["δὲ",703303,11],["αἱ",709436,190],["μαῖαι",708381,191],["τὸν",709436,5],["θεὸν",706192,6],["καὶ",707031,7],["οὐκ",709805,28],["ἐποίησαν",710582,150],["καθότι",707021,28],["συνέταξεν",712508,2],["αὐταῖς",702165,200],["ὁ",709436,3],["βασιλεὺς",702580,4],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ἐζωογόνουν",705915,137],["τὰ",709436,41],["ἄρσενα",701818,68]],"But the midwives feared God, and did not as the king of Egypt appointed them; and they saved the male children alive."],["18",[["ἐκάλεσεν",707084,2],["δὲ",703303,11],["ὁ",709436,3],["βασιλεὺς",702580,4],["Αἰγύπτου",700401,17],["τὰς",709436,38],["μαίας",708381,39],["καὶ",707031,7],["εἶπεν",705373,2],["αὐταῖς",702165,200],["τί",712867,126],["ὅτι",709803,7],["ἐποιήσατε",710582,265],["τὸ",709436,24],["πρᾶγμα",710708,25],["τοῦτο",709858,129],["καὶ",707031,7],["ἐζωογονεῖτε",705915,399],["τὰ",709436,41],["ἄρσενα",701818,68]],"And the king of Egypt called the midwives, and said to them, Why is it that ye have done this thing, and saved the male children alive?"],["19",[["εἶπαν",705373,150],["δὲ",703303,11],["αἱ",709436,190],["μαῖαι",708381,191],["τῷ",709436,113],["Φαραω",713360,114],["οὐχ",709805,28],["ὡς",714148,7],["γυναῖκες",703209,191],["Αἰγύπτου",700401,17],["αἱ",709436,190],["Εβραῖαι",703932,191],["τίκτουσιν",712853,197],["γὰρ",702963,11],["πρὶν",710742,28],["ἢ",705924,7],["εἰσελθεῖν",704114,106],["πρὸς",710844,0],["αὐτὰς",702165,231],["τὰς",709436,38],["μαίας",708381,39],["καὶ",707031,7],["ἔτικτον",712853,137]],"And the midwives said to Pharao, The Hebrew women are not as the women of Egypt, for they are delivered before the midwives go in to them. So they bore children."],["20",[["εὖ",705544,28],["δὲ",703303,11],["ἐποίει",710582,13],["ὁ",709436,3],["θεὸς",706192,4],["ταῖς",709436,75],["μαίαις",708381,76],["καὶ",707031,7],["ἐπλήθυνεν",710530,2],["ὁ",709436,3],["λαὸς",708094,4],["καὶ",707031,7],["ἴσχυεν",706859,13],["σφόδρα",712586,28]],"And God did well to the midwives, and the people multiplied, and grew very strong."],["21",[["ἐπειδὴ",705056,7],["ἐφοβοῦντο",713532,139],["αἱ",709436,190],["μαῖαι",708381,191],["τὸν",709436,5],["θεόν",706192,6],["ἐποίησαν",710582,150],["ἑαυταῖς",703917,200],["οἰκίας",709505,39]],"And as the midwives feared God, they established for themselves families."],["22",[["συνέταξεν",712508,2],["δὲ",703303,11],["Φαραω",713360,4],["παντὶ",710177,30],["τῷ",709436,113],["λαῷ",708094,114],["αὐτοῦ",702165,102],["λέγων",708124,72],["πᾶν",710177,14],["ἄρσεν",701818,46],["ὃ",709781,33],["ἐὰν",703912,7],["τεχθῇ",712853,384],["τοῖς",709436,147],["Εβραίοις",703933,148],["εἰς",704105,0],["τὸν",709436,5],["ποταμὸν",710693,6],["ῥίψατε",711267,74],["καὶ",707031,7],["πᾶν",710177,46],["θῆλυ",706237,46],["ζωογονεῖτε",705915,87],["αὐτό",702165,129]],"And Pharao charged all his people, saying, Whatever male [child] shall be born to the Hebrews, cast into the river; and every female, save it alive."]]