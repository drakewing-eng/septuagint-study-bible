[["1",[["καὶ",707031,7],["σὺ",712181,164],["προσαγάγου",710848,300],["πρὸς",710844,0],["σεαυτὸν",711599,85],["τόν",709436,5],["τε",712751,11],["Ααρων",700005,6],["τὸν",709436,5],["ἀδελφόν",700249,6],["σου",711945,133],["καὶ",707031,7],["τοὺς",709436,58],["υἱοὺς",713075,57],["αὐτοῦ",702165,102],["ἐκ",704132,0],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ἱερατεύειν",706607,55],["μοι",708974,159],["Ααρων",700005,6],["καὶ",707031,7],["Ναδαβ",709156,6],["καὶ",707031,7],["Αβιουδ",700071,6],["καὶ",707031,7],["Ελεαζαρ",704407,6],["καὶ",707031,7],["Ιθαμαρ",706704,6],["υἱοὺς",713075,57],["Ααρων",700005,18]],"And do thou take to thyself both Aaron thy brother, and his sons, even [them] of the children of Israel; so that Aaron, and Nadab and Abiud, and Eleazar and Ithamar, sons of Aaron, may minister to me."],["2",[["καὶ",707031,7],["ποιήσεις",710582,166],["στολὴν",712120,9],["ἁγίαν",700159,36],["Ααρων",700005,114],["τῷ",709436,113],["ἀδελφῷ",700249,114],["σου",711945,133],["εἰς",704105,0],["τιμὴν",712856,9],["καὶ",707031,7],["δόξαν",703791,9]],"And thou shalt make holy apparel for Aaron thy brother, for honour and glory."],["3",[["καὶ",707031,7],["σὺ",712181,164],["λάλησον",708071,176],["πᾶσι",710177,230],["τοῖς",709436,147],["σοφοῖς",711985,230],["τῇ",709436,100],["διανοίᾳ",703531,1],["οὓς",709781,298],["ἐνέπλησα",704592,155],["πνεύματος",710566,21],["αἰσθήσεως",700477,17],["καὶ",707031,7],["ποιήσουσιν",710582,218],["τὴν",709436,8],["στολὴν",712120,9],["τὴν",709436,8],["ἁγίαν",700159,36],["Ααρων",700005,114],["εἰς",704105,0],["τὸ",709436,24],["ἅγιον",700159,46],["ἐν",704639,0],["ᾗ",709781,108],["ἱερατεύσει",706607,127],["μοι",708974,159]],"And speak thou to all those who are wise in understanding, whom I have filled with the spirit of wisdom and perception; and they shall make the holy apparel of Aaron for the sanctuary, in which [apparel] he shall minister to me as priest."],["4",[["καὶ",707031,7],["αὗται",709858,202],["αἱ",709436,190],["στολαί",712120,191],["ἃς",709781,193],["ποιήσουσιν",710582,218],["τὸ",709436,24],["περιστήθιον",710392,25],["καὶ",707031,7],["τὴν",709436,8],["ἐπωμίδα",705374,9],["καὶ",707031,7],["τὸν",709436,5],["ποδήρη",710577,27],["καὶ",707031,7],["χιτῶνα",713869,6],["κοσυμβωτὸν",707854,27],["καὶ",707031,7],["κίδαριν",707668,9],["καὶ",707031,7],["ζώνην",705912,9],["καὶ",707031,7],["ποιήσουσιν",710582,218],["στολὰς",712120,39],["ἁγίας",700159,119],["Ααρων",700005,114],["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὸ",709436,24],["ἱερατεύειν",706607,55],["μοι",708974,159]],"And these are the garments which they shall make: the breast-plate, and the shoulder-piece, and the full-length robe, and the tunic with a fringe, and the tire, and the girdle; and they shall make holy garments for Aaron and his sons to minister to me as priests."],["5",[["καὶ",707031,7],["αὐτοὶ",702165,201],["λήμψονται",708076,135],["τὸ",709436,24],["χρυσίον",713972,25],["καὶ",707031,7],["τὴν",709436,8],["ὑάκινθον",713048,9],["καὶ",707031,7],["τὴν",709436,8],["πορφύραν",710682,9],["καὶ",707031,7],["τὸ",709436,24],["κόκκινον",707783,46],["καὶ",707031,7],["τὴν",709436,8],["βύσσον",702834,9]],"And they shall take the gold, and the blue, and the purple, and the scarlet, and the fine linen."],["6",[["καὶ",707031,7],["ποιήσουσιν",710582,218],["τὴν",709436,8],["ἐπωμίδα",705374,9],["ἐκ",704132,0],["βύσσου",702834,17],["κεκλωσμένης",707746,440],["ἔργον",705396,25],["ὑφαντὸν",713278,46],["ποικιλτοῦ",710590,18]],"And they shall make the shoulder-piece of fine linen spun, the woven work of the embroiderer."],["7",[["δύο",703849,59],["ἐπωμίδες",705374,191],["συνέχουσαι",712469,306],["ἔσονται",704093,135],["αὐτῷ",702165,50],["ἑτέρα",705535,29],["τὴν",709436,8],["ἑτέραν",705535,36],["ἐπὶ",705080,0],["τοῖς",709436,95],["δυσὶ",703849,405],["μέρεσιν",708752,96],["ἐξηρτημέναι",704882,415]],"It shall have two shoulder-pieces joined together, fastened on the two sides."],["8",[["καὶ",707031,7],["τὸ",709436,34],["ὕφασμα",713280,15],["τῶν",709436,130],["ἐπωμίδων",705374,65],["ὅ",709781,33],["ἐστιν",704093,91],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["κατὰ",707200,0],["τὴν",709436,8],["ποίησιν",710584,9],["ἐξ",704132,0],["αὐτοῦ",702165,49],["ἔσται",704093,93],["ἐκ",704132,0],["χρυσίου",713972,21],["καὶ",707031,7],["ὑακίνθου",713048,17],["καὶ",707031,7],["πορφύρας",710682,17],["καὶ",707031,7],["κοκκίνου",707783,92],["διανενησμένου",703525,441],["καὶ",707031,7],["βύσσου",702834,17],["κεκλωσμένης",707746,440]],"And the woven work of the shoulder-pieces which is upon it, shall be of one piece according to the work, of pure gold and blue and purple, and spun scarlet and fine twined linen."],["9",[["καὶ",707031,7],["λήμψῃ",708076,123],["τοὺς",709436,58],["δύο",703849,59],["λίθους",708196,57],["λίθους",708196,57],["σμαράγδου",711909,17],["καὶ",707031,7],["γλύψεις",703119,166],["ἐν",704639,0],["αὐτοῖς",702165,151],["τὰ",709436,41],["ὀνόματα",709666,42],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18]],"And thou shalt take the two stones, the stones of emerald, and thou shalt grave on them the names of the children of Israel."],["10",[["ἓξ",704828,59],["ὀνόματα",709666,42],["ἐπὶ",705080,0],["τὸν",709436,5],["λίθον",708196,6],["τὸν",709436,5],["ἕνα",704106,27],["καὶ",707031,7],["τὰ",709436,41],["ἓξ",704828,59],["ὀνόματα",709666,42],["τὰ",709436,41],["λοιπὰ",708248,68],["ἐπὶ",705080,0],["τὸν",709436,5],["λίθον",708196,6],["τὸν",709436,5],["δεύτερον",703389,27],["κατὰ",707200,0],["τὰς",709436,38],["γενέσεις",703043,39],["αὐτῶν",702165,40]],"Six names on the first stone, and the other six names on the second stone, according to their births."],["11",[["ἔργον",705396,25],["λιθουργικῆς",708199,82],["τέχνης",712831,17],["γλύμμα",703116,25],["σφραγῖδος",712591,17],["διαγλύψεις",703436,166],["τοὺς",709436,58],["δύο",703849,59],["λίθους",708196,57],["ἐπὶ",705080,0],["τοῖς",709436,95],["ὀνόμασιν",709666,96],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18]],"[It shall be] the work of the stone-engraver's art; as the graving of a seal thou shalt engrave the two stones with the names of the children of Israel."],["12",[["καὶ",707031,7],["θήσεις",712849,166],["τοὺς",709436,58],["δύο",703849,59],["λίθους",708196,57],["ἐπὶ",705080,0],["τῶν",709436,80],["ὤμων",714114,81],["τῆς",709436,16],["ἐπωμίδος",705374,17],["λίθοι",708196,52],["μνημοσύνου",708966,21],["εἰσὶν",704093,197],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["καὶ",707031,7],["ἀναλήμψεται",700984,93],["Ααρων",700005,4],["τὰ",709436,41],["ὀνόματα",709666,42],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ἔναντι",704653,0],["κυρίου",707996,18],["ἐπὶ",705080,0],["τῶν",709436,80],["δύο",703849,59],["ὤμων",714114,81],["αὐτοῦ",702165,102],["μνημόσυνον",708966,25],["περὶ",710285,0],["αὐτῶν",702165,40]],"And thou shalt put the two stones on the shoulders of the shoulder-piece: they are memorial-stones for the children of Israel: and Aaron shall bear the names of the children of Israel before the Lord on his two shoulders, a memorial for them."],["13",[["καὶ",707031,7],["ποιήσεις",710582,166],["ἀσπιδίσκας",701990,39],["ἐκ",704132,0],["χρυσίου",713972,21],["καθαροῦ",706988,92]],"And thou shalt make circlets of pure gold;"],["14",[["καὶ",707031,7],["ποιήσεις",710582,166],["δύο",703849,59],["κροσσωτὰ",707916,68],["ἐκ",704132,0],["χρυσίου",713972,21],["καθαροῦ",706988,92],["καταμεμιγμένα",707333,437],["ἐν",704639,0],["ἄνθεσιν",701157,96],["ἔργον",705396,25],["πλοκῆς",710558,17],["καὶ",707031,7],["ἐπιθήσεις",705304,166],["τὰ",709436,41],["κροσσωτὰ",707916,68],["τὰ",709436,41],["πεπλεγμένα",710515,437],["ἐπὶ",705080,0],["τὰς",709436,38],["ἀσπιδίσκας",701990,39],["κατὰ",707200,0],["τὰς",709436,38],["παρωμίδας",710176,39],["αὐτῶν",702165,40],["ἐκ",704132,0],["τῶν",709436,43],["ἐμπροσθίων",704620,83]],"and thou shalt make two fringes of pure gold, variegated with flowers, wreathen work; and thou shalt put the wreathen fringes on the circlets, fastening them on their shoulder-pieces in front."],["15",[["καὶ",707031,7],["ποιήσεις",710582,166],["λογεῖον",708231,25],["τῶν",709436,130],["κρίσεων",707908,65],["ἔργον",705396,25],["ποικιλτοῦ",710590,18],["κατὰ",707200,0],["τὸν",709436,5],["ῥυθμὸν",711307,6],["τῆς",709436,16],["ἐπωμίδος",705374,17],["ποιήσεις",710582,166],["αὐτό",702165,129],["ἐκ",704132,0],["χρυσίου",713972,21],["καὶ",707031,7],["ὑακίνθου",713048,17],["καὶ",707031,7],["πορφύρας",710682,17],["καὶ",707031,7],["κοκκίνου",707783,92],["κεκλωσμένου",707746,441],["καὶ",707031,7],["βύσσου",702834,17],["κεκλωσμένης",707746,440],["ποιήσεις",710582,166],["αὐτό",702165,129]],"And thou shalt make the oracle of judgment, the work of the embroiderer: in keeping with the ephod, thou shalt make it of gold, and blue and purple, and spun scarlet, and fine linen spun."],["16",[["τετράγωνον",712812,26],["ἔσται",704093,93],["διπλοῦν",703740,26],["σπιθαμῆς",712013,17],["τὸ",709436,24],["μῆκος",708868,25],["καὶ",707031,7],["σπιθαμῆς",712013,17],["τὸ",709436,24],["εὖρος",705677,25]],"Thou shalt make it square: it shall be double; of a span the length of it, and of a span the breadth."],["17",[["καὶ",707031,7],["καθυφανεῖς",707028,166],["ἐν",704639,0],["αὐτῷ",702165,280],["ὕφασμα",713280,25],["κατάλιθον",707312,46],["τετράστιχον",712825,46],["στίχος",712113,4],["λίθων",708196,81],["ἔσται",704093,93],["σάρδιον",711525,15],["τοπάζιον",712900,15],["καὶ",707031,7],["σμάραγδος",711909,12],["ὁ",709436,3],["στίχος",712113,4],["ὁ",709436,3],["εἷς",704106,14]],"And thou shalt interweave with it a texture of four rows of stone; there shall be a row of stones, a sardius, a topaz, an emerald, the first row."],["18",[["καὶ",707031,7],["ὁ",709436,3],["στίχος",712113,4],["ὁ",709436,3],["δεύτερος",703389,14],["ἄνθραξ",701160,4],["καὶ",707031,7],["σάπφειρος",711505,12],["καὶ",707031,7],["ἴασπις",706451,12]],"And the second row, a carbuncle, a sapphire, and a jasper."],["19",[["καὶ",707031,7],["ὁ",709436,3],["στίχος",712113,4],["ὁ",709436,3],["τρίτος",712968,