,703654,127],["σοι",711925,159],["αὐτήν",702165,104]],"And it shall come to pass when the Lord thy God shall bring thee into the land of the Chananites, as he sware to thy fathers, and shall give it thee,"],["12",[["καὶ",707031,7],["ἀφελεῖς",702177,166],["πᾶν",710177,46],["διανοῖγον",703532,47],["μήτραν",708894,9],["τὰ",709436,41],["ἀρσενικά",701817,68],["τῷ",709436,113],["κυρίῳ",707996,114],["πᾶν",710177,46],["διανοῖγον",703532,47],["μήτραν",708894,9],["ἐκ",704132,0],["τῶν",709436,43],["βουκολίων",702786,44],["ἢ",705924,7],["ἐν",704639,0],["τοῖς",709436,95],["κτήνεσίν",707934,96],["σου",711945,133],["ὅσα",709788,68],["ἐὰν",703912,7],["γένηταί",703104,239],["σοι",711925,159],["τὰ",709436,41],["ἀρσενικά",701817,68],["ἁγιάσεις",700153,166],["τῷ",709436,113],["κυρίῳ",707996,114]],"that thou shalt set apart every [offspring] opening the womb, the males to the Lord, every one that opens the womb out of the herds or among thy cattle, as many as thou shalt have: thou shalt sanctify the males to the Lord."],["13",[["πᾶν",710177,46],["διανοῖγον",703532,47],["μήτραν",708894,9],["ὄνου",709671,18],["ἀλλάξεις",700683,166],["προβάτῳ",710768,54],["ἐὰν",703912,7],["δὲ",703303,11],["μὴ",708851,28],["ἀλλάξῃς",700683,175],["λυτρώσῃ",708282,123],["αὐτό",702165,129],["πᾶν",710177,46],["πρωτότοκον",711046,46],["ἀνθρώπου",701163,18],["τῶν",709436,80],["υἱῶν",713075,81],["σου",711945,133],["λυτρώσῃ",708282,123]],"Every [offspring] opening the womb of the ass thou shalt change for a sheep; and if thou wilt not change it, thou shalt redeem it: every first-born of man of thy sons shalt thou redeem."],["14",[["ἐὰν",703912,7],["δὲ",703303,11],["ἐρωτήσῃ",705459,172],["σε",711598,163],["ὁ",709436,3],["υἱός",713075,4],["σου",711945,133],["μετὰ",708780,0],["ταῦτα",709858,71],["λέγων",708124,72],["τί",712867,273],["τοῦτο",709858,132],["καὶ",707031,7],["ἐρεῖς",705415,166],["αὐτῷ",702165,50],["ὅτι",709803,7],["ἐν",704639,0],["χειρὶ",713787,1],["κραταιᾷ",707873,101],["ἐξήγαγεν",704834,2],["ἡμᾶς",705981