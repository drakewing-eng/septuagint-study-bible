2,2],["Φαραω",713360,4],["τὸν",709436,5],["λαόν",708094,6],["οὐχ",709805,28],["ὡδήγησεν",709448,2],["αὐτοὺς",702165,62],["ὁ",709436,3],["θεὸς",706192,4],["ὁδὸν",709458,9],["γῆς",703083,17],["Φυλιστιιμ",713621,81],["ὅτι",709803,7],["ἐγγὺς",703948,28],["ἦν",704093,13],["εἶπεν",705373,2],["γὰρ",702963,11],["ὁ",709436,3],["θεός",706192,4],["μήποτε",708882,28],["μεταμελήσῃ",708805,172],["τῷ",709436,113],["λαῷ",708094,114],["ἰδόντι",709725,350],["πόλεμον",710605,6],["καὶ",707031,7],["ἀποστρέψῃ",701598,172],["εἰς",704105,0],["Αἴγυπτον",700401,9]],"And when Pharao sent forth the people, God led them not by the way of the land of the Phylistines, because it was near; for God said, Lest at any time the people repent when they see war, and return to Egypt."],["18",[["καὶ",707031,7],["ἐκύκλωσεν",707958,2],["ὁ",709436,3],["θεὸς",706192,4],["τὸν",709436,5],["λαὸν",708094,6],["ὁδὸν",709458,9],["τὴν",709436,8],["εἰς",704105,0],["τὴν",709436,8],["ἔρημον",705420,9],["εἰς",704105,0],["τὴν",709436,8],["ἐρυθρὰν",705447,36],["θάλασσαν",706069,9],["πέμπτη",710245,29],["δὲ",703303,11],["γενεὰ",703037,12],["ἀνέβησαν",700905,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17]],"And God led the people round by the way to the wilderness, to the Red Sea: and in the fifth generation the children of Israel went up out of the land of Egypt."],["19",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Μωυσῆς",709112,4],["τὰ",709436,41],["ὀστᾶ",709792,42],["Ιωσηφ",706948,18],["μεθ᾿",708780,0],["ἑαυτοῦ",703917,102],["ὅρκῳ",709753,114],["γὰρ",702963,11],["ὥρκισεν",709751,2],["Ιωσηφ",706948,4],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ισραηλ",706839,18],["λέγων",708124,72],["ἐπισκοπῇ",705255,1],["ἐπισκέψεται",705250,93],["ὑμᾶς",713080,194],["κύριος",707996,4],["καὶ",707031,7],["συνανοίσετέ",712392,337],["μου",709032,133],["τὰ",709436,41],["ὀστᾶ",709792,42],["ἐντεῦθεν",704793,28],["μεθ᾿",708780,0],["ὑμῶν",713091,145]],"And Moses took the bones of Joseph with him, for he had solemnly adjured the children of Israel, saying, God will surely visit you, and ye shall carry up my bones hence with you."],["20",[["ἐξάραντες",704839,196],["δὲ",703303,11],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["ἐκ",704132,0],["Σοκχωθ",711926,118],["ἐστρατοπέδευσαν",712150,150],["ἐν",704639,0],["Οθομ",709487,111],["παρὰ",709995,0],["τὴν",709436,8],["ἔρημον",705420,9]],"And the children of Israel departed from Socchoth, and encamped in Othom by the wilderness."],["21",[["ὁ",709436,3],["δὲ",703303,11],["θεὸς",706192,4],["ἡγεῖτο",705931,19],["αὐτῶν",702165,40],["ἡμέρας",705984,17],["μὲν",708730,11],["ἐν",704639,0],["στύλῳ",712179,114],["νεφέλης",709277,17],["δεῖξαι",703314,106],["αὐτοῖς",702165,151],["τὴν",709436,8],["ὁδόν",709458,9],["τὴν",709436,8],["δὲ",703303,11],["νύκτα",709386,9],["ἐν",704639,0],["στύλῳ",712179,114],["πυρός",711088,21]],"And God led them, in the day by a pillar of cloud, to show them the way, and in the night by a pillar of fire."],["22",[["οὐκ",709805,28],["ἐξέλιπεν",704237,2],["ὁ",709436,3],["στῦλος",712179,4],["τῆς",709436,16],["νεφέλης",709277,17],["ἡμέρας",705984,17],["καὶ",707031,7],["ὁ",709436,3],["στῦλος",712179,4],["τοῦ",709436,20],["πυρὸς",711088,21],["νυκτὸς",709386,17],["ἐναντίον",704654,0],["παντὸς",710177,116],["τοῦ",709436,35],["λαοῦ",708094,18]],"And the pillar of cloud failed not by day, nor the pillar of fire by night, before all the people."]]