[["1",[["καὶ",707031,7],["ἀπῆρεν",701329,2],["πᾶσα",710177,29],["συναγωγὴ",712376,12],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ἐκ",704132,0],["τῆς",709436,16],["ἐρήμου",705420,17],["Σιν",711793,118],["κατὰ",707200,0],["παρεμβολὰς",710133,39],["αὐτῶν",702165,40],["διὰ",703417,0],["ῥήματος",711246,21],["κυρίου",707996,18],["καὶ",707031,7],["παρενεβάλοσαν",710132,150],["ἐν",704639,0],["Ραφιδιν",711204,245],["οὐκ",709805,28],["ἦν",704093,13],["δὲ",703303,11],["ὕδωρ",713071,15],["τῷ",709436,113],["λαῷ",708094,114],["πιεῖν",710478,106]],"And all the congregation of the children of Israel departed from the wilderness of Sin, according to their encampments, by the word of the Lord; and they encamped in Raphidin: and there was no water for the people to drink."],["2",[["καὶ",707031,7],["ἐλοιδορεῖτο",708240,19],["ὁ",709436,3],["λαὸς",708094,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγοντες",708124,146],["δὸς",703654,176],["ἡμῖν",705994,90],["ὕδωρ",713071,25],["ἵνα",706747,7],["πίωμεν",710478,79],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["Μωυσῆς",709112,4],["τί",712867,126],["λοιδορεῖσθέ",708240,374],["μοι",708974,159],["καὶ",707031,7],["τί",712867,126],["πειράζετε",710225,87],["κύριον",707996,6]],"And the people reviled Moses, saying, Give us water, that we may drink; and Moses said to them, Why do ye revile me, and why tempt ye the Lord?"],["3",[["ἐδίψησεν",703763,2],["δὲ",703303,11],["ἐκεῖ",704181,28],["ὁ",709436,3],["λαὸς",708094,4],["ὕδατι",713071,54],["καὶ",707031,7],["ἐγόγγυζεν",703144,13],["ἐκεῖ",704181,28],["ὁ",709436,3],["λαὸς",708094,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγοντες",708124,146],["ἵνα",706747,7],["τί",712867,273],["τοῦτο",709858,132],["ἀνεβίβασας",700910,162],["ἡμᾶς",705981,194],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["ἀποκτεῖναι",701498,106],["ἡμᾶς",705981,194],["καὶ",707031,7],["τὰ",709436,41],["τέκνα",712761,42],["ἡμῶν",705999,145],["καὶ",707031,7],["τὰ",709436,41],["κτήνη",707934,42],["τῷ",709436,53],["δίψει",703764,54]],"And the people thirsted there for water, and there the people murmured against Moses, saying, Why is this? hast thou brought us up out of Egypt to slay us and our children and our cattle with thirst?"],["4",[["ἐβόησεν",702743,2],["δὲ",703303,11],["Μωυσῆς",709112,4],["πρὸς",710844,0],["κύριον",707996,6],["λέγων",708124,72],["τί",712867,126],["ποιήσω",710582,207],["τῷ",709436,113],["λαῷ",708094,114],["τούτῳ",709858,50],["ἔτι",705538,28],["μικρὸν",708915,27],["καὶ",707031,7],["καταλιθοβολήσουσίν",707311,218],["με",708618,163]],"And Moses cried to the Lord, saying, What shall I do to this people? yet a little while and they will stone me."],["5",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["προπορεύου",710839,253],["τοῦ",709436,35],["λαοῦ",708094,18],["τούτου",709858,102],["λαβὲ",708076,176],["δὲ",703303,11],["μετὰ",708780,0],["σεαυτοῦ",711599,102],["ἀπὸ",701425,0],["τῶν",709436,80],["πρεσβυτέρων",710735,81],["τοῦ",709436,35],["λαοῦ",708094,18],["καὶ",707031,7],["τὴν",709436,8],["ῥάβδον",711135,9],["ἐν",704639,0],["ᾗ",709781,108],["ἐπάταξας",710185,162],["τὸν",709436,5],["ποταμόν",710693,6],["λαβὲ",708076,176],["ἐν",704639,0],["τῇ",709436,100],["χειρί",713787,1],["σου",711945,133],["καὶ",707031,7],["πορεύσῃ",710667,123]],"And the Lord said to Moses, Go before this people, and take to thyself of the elders of the people; and the rod with which thou smotest the river, take in thine hand, and thou shalt go."],["6",[["ὅδε",709446,121],["ἐγὼ",704018,164],["ἕστηκα",706846,89],["πρὸ",710747,0],["τοῦ",709436,35],["σὲ",711598,163],["ἐκεῖ",704181,28],["ἐπὶ",705080,0],["τῆς",709436,16],["πέτρας",710443,17],["ἐν",704639,0],["Χωρηβ",714013,184],["καὶ",707031,7],["πατάξεις",710185,166],["τὴν",709436,8],["πέτραν",710443,9],["καὶ",707031,7],["ἐξελεύσεται",704909,93],["ἐξ",704132,0],["αὐτῆς",702165,86],["ὕδωρ",713071,15],["καὶ",707031,7],["πίεται",710478,93],["ὁ",709436,3],["λαός",708094,4],["μου",709032,133],["ἐποίησεν",710582,2],["δὲ",703303,11],["Μωυσῆς",709112,4],["οὕτως",709859,28],["ἐναντίον",704654,0],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18]],"Behold, I stand there before thou [come], on the rock in Choreb, and thou shalt smite the rock, and water shall come out from it, and the people shall drink. And Moses did so before the sons of Israel."],["7",[["καὶ",707031,7],["ἐπωνόμασεν",705348,2],["τὸ",709436,24],["ὄνομα",709666,25],["τοῦ",709436,35],["τόπου",712903,18],["ἐκείνου",704183,102],["πειρασμὸς",710226,4],["καὶ",707031,7],["λοιδόρησις",708241,12],["διὰ",703417,0],["τὴν",709436,8],["λοιδορίαν",708242,9],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["καὶ",707031,7],["διὰ",703417,0],["τὸ",709436,24],["πειράζειν",710225,55],["κύριον",707996,6],["λέγοντας",708124,235],["εἰ",704071,7],["ἔστιν",704093,91],["κύριος",707996,4],["ἐν",704639,0],["ἡμῖν",705994,90],["ἢ",705924,7],["οὔ",709805,28]],"And he called the name of that place, Temptation, and Reviling, because of the reviling of the children of Israel, and because they tempted the Lord, saying, Is the Lord among us or not?"],["8",[["ἦλθεν",705453,2],["δὲ",703303,11],["Αμαληκ",700759,4],["καὶ",707031,7],["ἐπολέμει",710601,13],["Ισραηλ",706839,4],["ἐν",704639,0],["Ραφιδιν",711204,245]],"And Amalec came and fought with Israel in Raphidin."],["9",[["εἶπεν",705373,2],["δὲ",703303,11],["Μωυσῆς",709112,4],["τῷ",709436,113],["Ἰησοῦ",706701,18],["ἐπίλεξον",705188,176],["σεαυτῷ",711599,50],["ἄνδρας",701150,57],["δυνατοὺς",703845,60],["καὶ",707031,7],["ἐξελθὼν",704909,182],["παράταξαι",710108,300],["τῷ",709436,113],["Αμαληκ",700759,114],["αὔριον",702149,28],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἕστηκα",706846,89],["ἐπὶ",705080,0],["τῆς",709436,16],["κορυφῆς",707844,17],["τοῦ",709436,35],["βουνοῦ",702797,18],["καὶ",707031,7],["ἡ",709436,10],["ῥάβδος",711135,12],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐν",704639,0],["τῇ",709436,100],["χειρί",713787,1],["μου",709032,133]],"And Moses said to Joshua, Choose out for thyself mighty men, and go forth and set the army in array against Amalec to-morrow; and, behold, I [shall] stand on the top of the hill, and the rod of God [will be] in my hand."],["10",[["καὶ",707031,7],["ἐποίησεν",710582,2],["Ἰησοῦς",706701,4],["καθάπερ",706984,28],["εἶπεν",705373,2],["αὐτῷ",702165,50],["Μωυσῆς",709112,4],["καὶ",707031,7],["ἐξελθὼν",704909,182],["παρετάξατο",710108,23],["τῷ",709436,113],["Αμαληκ",700759,114],["καὶ",707031,7],["Μωυσῆς",709112,4],["καὶ",707031,7],["Ααρων",700005,4],["καὶ",707031,7],["Ωρ",714127,4],["ἀνέβησαν",700905,150],["ἐπὶ",705080,0],["τὴν",709436,8],["κορυφὴν",707844,9],["τοῦ",709436,35],["βουνοῦ",702797,18]],"And Joshua did as Moses said to him, and he went out and set the army in array against Amalec, and Moses and Aaron and Or went up to the top of the hill."],["11",[["καὶ",707031,7],["ἐγίνετο",703104,19],["ὅταν",709801,28],["ἐπῆρεν",705002,2],["Μωυσῆς",709112,4],["τὰς",709436,38],["χεῖρας",713787,39],["κατίσχυεν",707531,13],["Ισραηλ",706839,4],["ὅταν",709801,28],["δὲ",703303,11],["καθῆκεν",707007,2],["τὰς",709436,38],["χεῖρας",713787,39],["κατίσχυεν",707531,13],["Αμαληκ",700759,4]],"And it came to pass, when Moses lifted up his hands, Israel prevailed; and when he let down his hands, Amalec prevailed."],["12",[["αἱ",709436,190],["δὲ",703303,11],["χεῖρες",713787,191],["Μωυσῆ",709112,18],["βαρεῖαι",702554,192],["καὶ",707031,7],["λαβόντες",708076,196],["λίθον",708196,6],["ὑπέθηκαν",713251,150],["ὑπ᾿",713184,0],["αὐτόν",702165,85],["καὶ",707031,7],["ἐκάθητο",707000,19],["ἐπ᾿",705080,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["Ααρων",700005,4],["καὶ",707031,7],["Ωρ",714127,4],["ἐστήριζον",712098,137],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτοῦ",702165,102],["ἐντεῦθεν",704793,28],["εἷς",704106,14],["καὶ",707031,7],["ἐντεῦθεν",704793,28],["εἷς",704106,14],["καὶ",707031,7],["ἐγένοντο",703104,189],["αἱ",709436,190],["χεῖρες",713787,191],["Μωυσῆ",709112,18],["ἐστηριγμέναι",712098,423],["ἕως",705792,0],["δυσμῶν",703865,65],["ἡλίου",705974,18]],"But the hands of Moses were heavy, and they took a stone and put it under him, and he sat upon it; and Aaron and Or supported his hands one on this side and the other on that, and the hands of Moses were supported till the going down of the sun."],["13",[["καὶ",707031,7],["ἐτρέψατο",712929,23],["Ἰησοῦς",706701,4],["τὸν",709436,5],["Αμαληκ",700759,6],["καὶ",707031,7],["πάντα",710177,27],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["ἐν",704639,0],["φόνῳ",713549,114],["μαχαίρας",708593,17]],"And Joshua routed Amalec and all his people with the slaughter of the sword."],["14",[["εἶπεν",705373,2],["δὲ",703303,11],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["κατάγραψον",707231,176],["τοῦτο",709858,129],["εἰς",704105,0],["μνημόσυνον",708966,25],["ἐν",704639,0],["βιβλίῳ",702719,54],["καὶ",707031,7],["δὸς",703654,176],["εἰς",704105,0],["τὰ",709436,41],["ὦτα",709852,42],["Ἰησοῖ",706701,114],["ὅτι",709803,7],["ἀλοιφῇ",700725,1],["ἐξαλείψω",704852,165],["τὸ",709436,24],["μνημόσυνον",708966,25],["Αμαληκ",700759,18],["ἐκ",704132,0],["τῆς",709436,16],["ὑπὸ",713184,0],["τὸν",709436,5],["οὐρανόν",709844,6]],"And the Lord said to Moses, Write this for a memorial in a book, and speak [this] in the ears of Joshua; for I will utterly blot out the memorial of Amalec from under heaven."],["15",[["καὶ",707031,7],["ᾠκοδόμησεν",709509,2],["Μωυσῆς",709112,4],["θυσιαστήριον",706348,25],["κυρίῳ",707996,114],["καὶ",707031,7],["ἐπωνόμασεν",705348,2],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,49],["κύριός",707996,4],["μου",709032,133],["καταφυγή",707485,12]],"And Moses built an altar to the Lord, and called the name of it, The Lord my Refuge."],["16",[["ὅτι",709803,7],["ἐν",704639,0],["χειρὶ",713787,1],["κρυφαίᾳ",707927,101],["πολεμεῖ",710601,91],["κύριος",707996,4],["ἐπὶ",705080,0],["Αμαληκ",700759,114],["ἀπὸ",701425,0],["γενεῶν",703037,65],["εἰς",704105,0],["γενεάς",703037,39]],"For with a secret hand the Lord wages war upon Amalec to all generations."]]