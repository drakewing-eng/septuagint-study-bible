ὶ",707031,7],["ἁμαρτίας",700775,39],["καὶ",707031,7],["οὐ",709805,28],["καθαριεῖ",706985,127],["τὸν",709436,5],["ἔνοχον",704781,27],["ἐπάγων",704994,72],["ἀνομίας",701192,17],["πατέρων",710189,81],["ἐπὶ",705080,0],["τέκνα",712761,42],["καὶ",707031,7],["ἐπὶ",705080,0],["τέκνα",712761,42],["τέκνων",712761,44],["ἐπὶ",705080,0],["τρίτην",712968,36],["καὶ",707031,7],["τετάρτην",712811,36],["γενεάν",703037,9]],"and keeping justice and mercy for thousands, taking away iniquity, and unrighteousness, and sins; and he will not clear the guilty; bringing the iniquity of the fathers upon the children, and to the children's children, to the third and fourth generation."],["8",[["καὶ",707031,7],["σπεύσας",712011,182],["Μωυσῆς",709112,4],["κύψας",707989,182],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["προσεκύνησεν",710925,2]],"And Moses hasted, and bowed to the earth and worshipped;"],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["εἰ",704071,7],["εὕρηκα",705676,89],["χάριν",713735,9],["ἐνώπιόν",704823,0],["σου",711945,133],["συμπορευθήτω",712342,22],["ὁ",709436,3],["κύριός",707996,4],["μου",709032,133],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["ὁ",709436,3],["λαὸς",708094,4],["γὰρ",702963,11],["σκληροτράχηλός",711863,14],["ἐστιν",704093,91],["καὶ",707031,7],["ἀφελεῖς",702177,166],["σὺ",712181,164],["τὰς",709436,38],["ἁμαρτίας",700775,39],["ἡμῶν",705999,145],["καὶ",707031,7],["τὰς",709436,38],["ἀνομίας",701192,39],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐσόμεθα",704093,141],["σοί",711925,159]],"and said, If I have found grace before thee, let my Lord go with us; for the people is stiff-necked: and thou shalt take away our sins and our iniquities, and we will be thine."],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["τίθημί",712849,157],["σοι",711925,159],["διαθήκην",703456,9],["ἐνώπιον",704823,0],["παντὸς",710177,116],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133],["ποιήσω",710582,165],["ἔνδοξα",704694,68],["ἃ",709781,69],["οὐ",709805,28],["γέγονεν",703104,171],["ἐν",704639,0],["πάσῃ",710177,101],["τῇ",709436,100],["γῇ",703083,1],["καὶ",707031,7],["ἐν",704639,0],["παντὶ",710177,97],["ἔθνει",704068,54],["καὶ",707031,7],["ὄψεται",709725,93],["πᾶς",710177,14],["ὁ",709436,3],["λαός",708094,4],["ἐν",704639,0],["οἷς",709781,311],["εἶ",704093,154],["σύ",712181,164],["τὰ",709436,41],["ἔργα",705396,42],["κυρίου",707996,18],["ὅτι",709803,7],["θαυμαστά",706138,195],["ἐστιν",704093,91],["ἃ",709781,69],["ἐγὼ",704018,164],["ποιήσω",710582,165],["σοι",711925,159]],"And the Lord said to Moses, Behold, I establish a covenant for thee in the presence of all thy people; I will do glorious things, which have not been done in all the earth, or in any nation; and all the people among whom thou art shall see the works of the Lord, that they are wonderful, which I will do for thee."],["11",[["πρόσεχε",710895,240],["σὺ",712181,164],["πάντα",710177,68],["ὅσα",709788,68],["ἐγὼ",704018,164],["ἐντέλλομαί",704791,254],["σοι",711925,159],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐκβάλλω",704145,157],["πρὸ",710747,0],["προσώπου",710986,21],["ὑμῶν",713091,145],["τὸν",709436,5],["Αμορραῖον",700865,6],["καὶ",707031,7],["Χαναναῖον",713711,6],["καὶ",707031,7],["Χετταῖον",713838,6],["καὶ",707031,7],["Φερεζαῖον",713422,6],["καὶ",707031,7],["Ευαῖον",705549,6],["καὶ",707031,7],["Γεργεσαῖον",703062,6],["καὶ",707031,7],["Ιεβουσαῖον",706519,6]],"Do thou take heed to all things whatsoever I command thee: behold, I cast out before your face the Amorite and the Chananite and the Pherezite, and the Chettite, and Evite, and Gergesite and Jebusite:"],["12",[["πρόσεχε",710895,240],["σεαυτῷ",711599,50],["μήποτε",708882,28],["θῇς",712849,175],["διαθήκην",703456,9],["τοῖς",709436,147],["ἐγκαθημένοις",703952,341],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["εἰς",704105,0],["ἣν",709781,131],["εἰσπορεύῃ",704124,259],["εἰς",704105,0],["αὐτήν",702165,104],["μή",708851,28],["σοι",711925,159],["γένηται",703104,239],["πρόσκομμα",710922,15],["ἐν",704639,0],["ὑμῖν",713084,90]],"take heed to thyself, lest at any time thou make a covenant with the dwellers on the land, into which thou art entering, lest it be to thee a stumbling-block among you."],["13",[["τοὺς",709436,58],["βωμοὺς",702840,57],["αὐτῶν",702165,40],["καθελεῖτε",706982,337],["καὶ",707031,7],["τὰς",709436,38],["στήλας",712092,39],["αὐτῶν",702165,40],["συντρίψετε",712520,337],["καὶ",707031,7],["τὰ",709436,41],["ἄλση",700729,42],["αὐτῶν",702165,40],["ἐκκόψετε",704225,337],["καὶ",707031,7],["τὰ",709436,41],["γλυπτὰ",703117,68],["τῶν",709436,80],["θεῶν",706192,81],["αὐτῶν",702165,40],["κατακαύσετε",707258,337],["ἐν",704639,0],["πυρί",711088,54]],"Ye shall destroy their altars, and break in pieces their pillars, and ye shall cut down their groves, and the graven images of their gods ye shall burn with fire."],["14",[["οὐ",709805,28],["γὰρ",702963,11],["μὴ",708851,28],["προσκυνήσητε",710925,125],["θεῷ",706192,114],["ἑτέρῳ",705535,30],["ὁ",709436,3],["γὰρ",702963,11],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ζηλωτὸν",705876,26],["ὄνομα",709666,15],["θεὸς",706192,4],["ζηλωτής",705875,4],["ἐστιν",704093,91]],"For ye shall not worship strange gods, for the Lord God, a jealous name, is a jealous God;"],["15",[["μήποτε",708882,28],["θῇς",712849,175],["διαθήκην",703456,9],["τοῖς",709436,147],["ἐγκαθημένοις",703952,341],["πρὸς",710844,0],["ἀλλοφύλους",700706,60],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἐκπορνεύσωσιν",704295,234],["ὀπίσω",709697,0],["τῶν",709436,80],["θεῶν",706192,81],["αὐτῶν",702165,40],["καὶ",707031,7],["θύσωσι",706349,234],["τοῖς",709436,147],["θεοῖς",706192,148],["αὐτῶν",702165,40],["καὶ",707031,7],["καλέσωσίν",707084,234],["σε",711598,163],["καὶ",707031,7],["φάγῃς",713296,175],["τῶν",709436,43],["θυμάτων",706327,44],["αὐτῶν",702165,40]],"lest at any time thou make a covenant with the dwellers on the land, and they go a whoring after their gods, and sacrifice to their gods, and they call thee, and thou shouldest eat of their feasts,"],["16",[["καὶ",707031,7],["λάβῃς",708076,175],["τῶν",709436,130],["θυγατέρων",706320,65],["αὐτῶν",702165,40],["τοῖς",709436,147],["υἱοῖς",713075,148],["σου",711945,133],["καὶ",707031,7],["τῶν",709436,130],["θυγατέρων",706320,65],["σου",711945,133],["δῷς",703654,175],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐκπορνεύσωσιν",704295,234],["αἱ",709436,190],["θυγατέρες",706320,191],["σου",711945,133],["ὀπίσω",709697,0],["τῶν",709436,80],["θεῶν",706192,81],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐκπορνεύσωσιν",704295,234],["τοὺς",709436,58],["υἱούς",713075,57],["σου",711945,133],["ὀπίσω",709697,0],["τῶν",709436,80],["θεῶν",706192,81],["αὐτῶν",702165,40]],"and thou shouldest take of their daughters to thy sons, and thou shouldest give of thy daughters to their sons; and thy daughters should go a whoring after their gods, and thy sons should go a whoring after their gods."],["17",[["καὶ",707031,7],["θεοὺς",706192,57],["χωνευτοὺς",714009,60],["οὐ",709805,28],["ποιήσεις",710582,166],["σεαυτῷ",711599,50]],"And thou shalt not make to thyself molten gods."],["18",[["καὶ",707031,7],["τὴν",709436,8],["ἑορτὴν",704990,9],["τῶν",709436,80],["ἀζύμων",700345,169],["φυλάξῃ",713619,123],["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["φάγῃ",713296,123],["ἄζυμα",700345,68],["καθάπερ",706984,28],["ἐντέταλμαί",704791,326],["σοι",711925,159],["εἰς",704105,0],["τὸν",709436,5],["καιρὸν",707047,6],["ἐν",704639,0],["μηνὶ",708874,114],["τῶν",709436,43],["νέων",709256,83],["ἐν",704639,0],["γὰρ",702963,11],["μηνὶ",708874,114],["τῶν",709436,43],["νέων",709256,83],["ἐξῆλθες",704909,162],["ἐξ",704132,0],["Αἰγύπτου",700401,17]],"And thou shalt keep the feast of unleavened bread: seven days shalt thou eat unleavened bread, as I have charged thee, at the season in the month of new [corn]; for in the month of new [corn] thou camest out from Egypt."],["19",[["πᾶν",710177,26],["διανοῖγον",703532,32],["μήτραν",708894,9],["ἐμοί",704577,159],["τὰ",709436,63],["ἀρσενικά",701817,195],["πρωτότοκον",711046,26],["μόσχου",709029,18],["καὶ",707031,7],["πρωτότοκον",711046,26],["προβάτου",710768,21]],"The males [are] mine, everything that opens the womb; every first-born of oxen, and [every] first-born of sheep."],["20",[["καὶ",707031,7],["πρωτότοκον",711046,26],["ὑποζυγίου",713198,21],["λυτρώσῃ",708282,123],["προβάτῳ",710768,54],["ἐὰν",703912,7],["δὲ",703303,11],["μὴ",708851,28],["λυτρώσῃ",708282,123],["αὐτό",702165,129],["τιμὴν",712856,9],["δώσεις",703654,166],["πᾶν",710177,46],["πρωτότοκον",711046,46],["τῶν",709436,80],["υἱῶν",713075,81],["σου",711945,133],["λυτρώσῃ",708282,123],["οὐκ",709805,28],["ὀφθήσῃ",709725,364],["ἐνώπιόν",704823,0],["μου",709032,133],["κενός",707612,14]],"And the first-born of an ass thou shalt redeem with a sheep, and if thou wilt not redeem it thou shalt pay a price: every first-born of thy sons shalt thou redeem: thou shalt not appear before me empty."],["21",[["ἓξ",704828,59],["ἡμέρας",705984,39],["ἐργᾷ",705383,123],["τῇ",709436,100],["δὲ",703303,11],["ἑβδόμῃ",703925,101],["καταπαύσεις",707365,166],["τῷ",709436,113],["σπόρῳ",712030,114],["καὶ",707031,7],["τῷ",709436,113],["ἀμήτῳ",700819,114],["καταπαύσεις",707365,166]],"Six days thou shalt work, but on the seventh day thou shalt rest: [there shall be] rest in seed-time and harvest."],["22",[["καὶ",707031,7],["ἑορτὴν",704990,9],["ἑβδομάδων",703921,65],["ποιήσεις",710582,166],["μοι",708974,159],["ἀρχὴν",701836,9],["θερισμοῦ",706208,18],["πυρῶν",711101,81],["καὶ",707031,7],["ἑορτὴν",704990,9],["συναγωγῆς",712376,17],["μεσοῦντος",708771,152],["τοῦ",709436,35],["ἐνιαυτοῦ",704745,18]],"And thou shalt keep to me the feast of weeks, the beginning of wheat-harvest; and the feast of ingathering in the middle of the year."],["23",[["τρεῖς",712927,60],["καιροὺς",707047,57],["τοῦ",709436,35],["ἐνιαυτοῦ",704745,18],["ὀφθήσεται",709725,134],["πᾶν",710177,26],["ἀρσενικόν",701817,26],["σου",711945,133],["ἐνώπιον",704823,0],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["Ισραηλ",706839,18]],"Three times in the year shall every male of thine appear before the Lord the God of Israel."],["24",[["ὅταν",709801,28],["γὰρ",702963,11],["ἐκβάλω",704145,207],["τὰ",709436,41],["ἔθνη",704068,42],["πρὸ",710747,0],["προσώπου",710986,21],["σου",711945,133],["καὶ",707031,7],["πλατύνω",710508,438],["τὰ",709436,41],["ὅριά",709749,42],["σου",711945,133],["οὐκ",709805,28],["ἐπιθυμήσει",705141,127],["οὐδεὶς",709817,14],["τῆς",709436,16],["γῆς",703083,17],["σου",711945,133],["ἡνίκα",706008,28],["ἂν",700900,11],["ἀναβαίνῃς",700905,205],["ὀφθῆναι",709725,179],["ἐναντίον",704654,0],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133],["τρεῖς",712927,60],["καιροὺς",707047,57],["τοῦ",709436,35],["ἐνιαυτοῦ",704745,18]],"For when I shall have cast out the nations before thy face, and shall have enlarged thy coasts, no one shall desire thy land, whenever thou mayest go up to appear before the Lord thy God, three times in the year."],["25",[["οὐ",709805,28],["σφάξεις",712571,166],["ἐπὶ",705080,0],["ζύμῃ",705897,1],["αἷμα",700442,25],["θυμιαμάτων",706330,44],["μου",709032,133],["καὶ",707031,7],["οὐ",709805,28],["κοιμηθήσεται",707767,134],["εἰς",704105,0],["τὸ",709436,24],["πρωὶ",711021,28],["θύματα",706327,64],["τῆς",709436,16],["ἑορτῆς",704990,17],["τοῦ",709436,20],["πασχα",710182,21]],"Thou shalt not offer the blood of my sacrifices with leaven, neither shall the sacrifices of the feast of the passover remain till the morning."],["26",[["τὰ",709436,41],["πρωτογενήματα",711033,42],["τῆς",709436,16],["γῆς",703083,17],["σου",711945,133],["θήσεις",712849,166],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133],["οὐ",709805,28],["προσοίσεις",710974,166],["ἄρνα",701731,6],["ἐν",704639,0],["γάλακτι",702919,54],["μητρὸς",708892,17],["αὐτοῦ",702165,102]],"The first-fruits of thy land shalt thou put into the house of the Lord thy God: thou shalt not boil a lamb in his mother's milk."],["27",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["γράψον",703194,176],["σεαυτῷ",711599,50],["τὰ",709436,41],["ῥήματα",711246,42],["ταῦτα",709858,71],["ἐπὶ",705080,0],["γὰρ",702963,11],["τῶν",709436,80],["λόγων",708236,81],["τούτων",709858,40],["τέθειμαί",712849,326],["σοι",711925,159],["διαθήκην",703456,9],["καὶ",707031,7],["τῷ",709436,113],["Ισραηλ",706839,114]],"And the Lord said to Moses, Write these words for thyself, for on these words I have established a covenant with thee and with Israel."],["28",[["καὶ",707031,7],["ἦν",704093,13],["ἐκεῖ",704181,28],["Μωυσῆς",709112,4],["ἐναντίον",704654,0],["κυρίου",707996,18],["τεσσαράκοντα",712806,59],["ἡμέρας",705984,39],["καὶ",707031,7],["τεσσαράκοντα",712806,59],["νύκτας",709386,39],["ἄρτον",701829,6],["οὖκ",709805,28],["ἔφαγεν",713296,2],["καὶ",707031,7],["ὕδωρ",713071,15],["οὐκ",709805,28],["ἔπιεν",710478,2],["καὶ",707031,7],["ἔγραψεν",703194,2],["τὰ",709436,41],["ῥήματα",711246,42],["ταῦτα",709858,71],["ἐπὶ",705080,0],["τῶν",709436,130],["πλακῶν",710501,65],["τῆς",709436,16],["διαθήκης",703456,17],["τοὺς",709436,58],["δέκα",703333,59],["λόγους",708236,57]],"And Moses was there before the Lord forty days, and forty nights; he did not eat bread, and he did not drink water; and he wrote upon the tables these words of the covenant, the ten sayings."],["29",[["ὡς",714148,7],["δὲ",703303,11],["κατέβαινεν",707202,13],["Μωυσῆς",709112,4],["ἐκ",704132,0],["τοῦ",709436,20],["ὄρους",709768,21],["καὶ",707031,7],["αἱ",709436,190],["δύο",703849,59],["πλάκες",710501,191],["ἐπὶ",705080,0],["τῶν",709436,130],["χειρῶν",713787,65],["Μωυσῆ",709112,18],["καταβαίνοντος",707202,152],["δὲ",703303,11],["αὐτοῦ",702165,102],["ἐκ",704132,0],["τοῦ",709436,20],["ὄρους",709768,21],["Μωυσῆς",709112,4],["οὐκ",709805,28],["ᾔδει",709492,143],["ὅτι",709803,7],["δεδόξασται",703792,187],["ἡ",709436,10],["ὄψις",709901,12],["τοῦ",709436,20],["χρώματος",713982,21],["τοῦ",709436,20],["προσώπου",710986,21],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,53],["λαλεῖν",708071,55],["αὐτὸν",702165,85],["αὐτῷ",702165,50]],"And when Moses went down from the mountain, [there were] the two tables in the hands of Moses,—as then he went down from the mountain, Moses knew not that the appearance of the skin of his face was glorified, when God spoke to him."],["30",[["καὶ",707031,7],["εἶδεν",709725,2],["Ααρων",700005,4],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["πρεσβύτεροι",710735,138],["Ισραηλ",706839,18],["τὸν",709436,5],["Μωυσῆν",709112,6],["καὶ",707031,7],["ἦν",704093,13],["δεδοξασμένη",703792,203],["ἡ",709436,10],["ὄψις",709901,12],["τοῦ",709436,20],["χρώματος",713982,21],["τοῦ",709436,20],["προσώπου",710986,21],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐφοβήθησαν",713532,99],["ἐγγίσαι",703939,106],["αὐτοῦ",702165,102]],"And Aaron and all the elders of Israel saw Moses, and the appearance of the skin of his face was made glorious, and they feared to approach him."],["31",[["καὶ",707031,7],["ἐκάλεσεν",707084,2],["αὐτοὺς",702165,62],["Μωυσῆς",709112,4],["καὶ",707031,7],["ἐπεστράφησαν",705278,99],["πρὸς",710844,0],["αὐτὸν",702165,85],["Ααρων",700005,4],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["ἄρχοντες",701862,52],["τῆς",709436,16],["συναγωγῆς",712376,17],["καὶ",707031,7],["ἐλάλησεν",708071,2],["αὐτοῖς",702165,151],["Μωυσῆς",709112,4]],"And Moses called them, and Aaron and all the rulers of the synagogue turned towards him, and Moses spoke to them."],["32",[["καὶ",707031,7],["μετὰ",708780,0],["ταῦτα",709858,71],["προσῆλθον",710890,150],["πρὸς",710844,0],["αὐτὸν",702165,85],["πάντες",710177,138],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐνετείλατο",704791,23],["αὐτοῖς",702165,151],["πάντα",710177,68],["ὅσα",709788,68],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["αὐτὸν",702165,85],["ἐν",704639,0],["τῷ",709436,53],["ὄρει",709768,54],["Σινα",711794,184]],"And afterwards all the children of Israel came to him, and he commanded them all things, whatsoever the Lord had commanded him in the mount of Sina."],["33",[["καὶ",707031,7],["ἐπειδὴ",705056,7],["κατέπαυσεν",707365,2],["λαλῶν",708071,72],["πρὸς",710844,0],["αὐτούς",702165,62],["ἐπέθηκεν",705304,2],["ἐπὶ",705080,0],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["κάλυμμα",707099,25]],"And when he ceased speaking to them, he put a veil on his face."],["34",[["ἡνίκα",706008,28],["δ᾿",703303,11],["ἂν",700900,11],["εἰσεπορεύετο",704124,19],["Μωυσῆς",709112,4],["ἔναντι",704653,0],["κυρίου",707996,18],["λαλεῖν",708071,55],["αὐτῷ",702165,50],["περιῃρεῖτο",710288,19],["τὸ",709436,24],["κάλυμμα",707099,25],["ἕως",705792,0],["τοῦ",709436,20],["ἐκπορεύεσθαι",704293,110],["καὶ",707031,7],["ἐξελθὼν",704909,182],["ἐλάλει",708071,13],["πᾶσιν",710177,230],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["ὅσα",709788,68],["ἐνετείλατο",704791,23],["αὐτῷ",702165,50],["κύριος",707996,4]],"And whenever Moses went in before the Lord to speak to him, he took off the veil till he went out, and he went forth and spoke to all the children of Israel whatsoever the Lord commanded him."],["35",[["καὶ",707031,7],["εἶδον",709725,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["τὸ",709436,24],["πρόσωπον",710986,25],["Μωυσῆ",709112,18],["ὅτι",709803,7],["δεδόξασται",703792,187],["καὶ",707031,7],["περιέθηκεν",710403,2],["Μωυσῆς",709112,4],["κάλυμμα",707099,25],["ἐπὶ",705080,0],["τὸ",709436,24],["πρόσωπον",710986,25],["ἑαυτοῦ",703917,102],["ἕως",705792,7],["ἂν",700900,11],["εἰσέλθῃ",704114,172],["συλλαλεῖν",712261,55],["αὐτῷ",702165,50]],"And the children of Israel saw the face of Moses, that it was glorified; and Moses put the veil over his face, till he went in to speak with him."]]