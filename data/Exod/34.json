[["1",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λάξευσον",708092,176],["σεαυτῷ",711599,50],["δύο",703849,59],["πλάκας",710501,39],["λιθίνας",708193,119],["καθὼς",707030,28],["καὶ",707031,7],["αἱ",709436,190],["πρῶται",711041,452],["καὶ",707031,7],["ἀνάβηθι",700905,176],["πρός",710844,0],["με",708618,163],["εἰς",704105,0],["τὸ",709436,24],["ὄρος",709768,25],["καὶ",707031,7],["γράψω",703194,165],["ἐπὶ",705080,0],["τῶν",709436,130],["πλακῶν",710501,65],["τὰ",709436,41],["ῥήματα",711246,42],["ἃ",709781,371],["ἦν",704093,13],["ἐν",704639,0],["ταῖς",709436,75],["πλαξὶν",710501,76],["ταῖς",709436,75],["πρώταις",711041,453],["αἷς",709781,281],["συνέτριψας",712520,162]],"And the Lord said to Moses, Hew for thyself two tables of stone, as also the first were, and come up to me to the mountain; and I will write upon the tables the words, which were on the first tables, which thou brokest."],["2",[["καὶ",707031,7],["γίνου",703104,253],["ἕτοιμος",705541,14],["εἰς",704105,0],["τὸ",709436,24],["πρωὶ",711021,28],["καὶ",707031,7],["ἀναβήσῃ",700905,123],["ἐπὶ",705080,0],["τὸ",709436,24],["ὄρος",709768,25],["τὸ",709436,24],["Σινα",711794,184],["καὶ",707031,7],["στήσῃ",706846,123],["μοι",708974,159],["ἐκεῖ",704181,28],["ἐπ᾿",705080,0],["ἄκρου",700608,92],["τοῦ",709436,20],["ὄρους",709768,21]],"And be ready by the morning, and thou shalt go up to the mount Sina, and shalt stand there for me on the top of the mountain."],["3",[["καὶ",707031,7],["μηδεὶς",708857,14],["ἀναβήτω",700905,45],["μετὰ",708780,0],["σοῦ",711945,133],["μηδὲ",708855,7],["ὀφθήτω",709725,22],["ἐν",704639,0],["παντὶ",710177,97],["τῷ",709436,53],["ὄρει",709768,54],["καὶ",707031,7],["τὰ",709436,63],["πρόβατα",710768,64],["καὶ",707031,7],["αἱ",709436,190],["βόες",702798,191],["μὴ",708851,28],["νεμέσθωσαν",709253,77],["πλησίον",710547,28],["τοῦ",709436,20],["ὄρους",709768,21],["ἐκείνου",704183,49]],"And let no one go up with thee, nor be seen in all the mountain; and le