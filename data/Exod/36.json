,["ἁγίου",700159,92],["ποιεῖν",710582,55],["αὐτά",702165,71],["καὶ",707031,7],["αὐτοὶ",702165,201],["προσεδέχοντο",710874,139],["ἔτι",705538,28],["τὰ",709436,41],["προσφερόμενα",710974,67],["παρὰ",709995,0],["τῶν",709436,80],["φερόντων",713428,170],["τὸ",709436,24],["πρωὶ",711021,28],["πρωί",711021,28]],"And they received from Moses all the offerings, which the children of Israel brought for all the works of the sanctuary to do them; and they continued to receive the gifts brought, from those who brought them in the morning."],["4",[["καὶ",707031,7],["παρεγίνοντο",710006,139],["πάντες",710177,138],["οἱ",709436,136],["σοφοὶ",711985,138],["οἱ",709436,136],["ποιοῦντες",710582,146],["τὰ",709436,41],["ἔργα",705396,42],["τοῦ",709436,20],["ἁγίου",700159,92],["ἕκαστος",704133,14],["κατὰ",707200,0],["τὸ",709436,24],["αὐτοῦ",702165,102],["ἔργον",705396,25],["ὃ",709781,128],["αὐτοὶ",702165,201],["ἠργάζοντο",705383,139]],"And there came all the wise men who wrought the works of the sanctuary, each according to his own work, which they wrought."],["5",[["καὶ",707031,7],["εἶπαν",705373,150],["πρὸς",710844,0],["Μωυσῆν",709112,6],["ὅτι",709803,7],["πλῆθος",710529,25],["φέρει",713428,91],["ὁ",709436,3],["λαὸς",708094,4],["παρὰ",709995,0],["τὰ",709436,41],["ἔργα",705396,42],["ὅσα",709788,68],["συνέταξεν",712508,2],["κύριος",707996,4],["ποιῆσαι",710582,106]],"And one said to Moses, The people bring an abundance [too great] in proportion to all the works which the Lord has appointed [them] to do."],["6",[["καὶ",707031,7],["προσέταξεν",710962,2],["Μωυσῆς",709112,4],["καὶ",707031,7],["ἐκήρυξεν",707662,2],["ἐν",704639,0],["τῇ",709436,100],["παρεμβολῇ",710133,1],["λέγων",708124,72],["ἀνὴρ",701150,4],["καὶ",707031,7],["γυνὴ",703209,12],["μηκέτι",708867,28],["ἐργαζέσθωσαν",705383,77],["εἰς",704105,0],["τὰς",709436,38],["ἀπαρχὰς",701359,39],["τοῦ",709436,20],["ἁγίου",700159,92],["καὶ",707031,7],["ἐκωλύθη",708020,37],["ὁ",709436,3],["λαὸς",708094,4],["ἔτι",705538,28],["προσφέρειν",710974,55]],