,100],["βύσσῳ",702834,1],["τῇ",709436,100],["κεκλωσμένῃ",707746,455],["ἔργον",705396,25],["ὑφαντόν",713278,46]],"And the plates were divided, the threads of gold, so as to interweave with the blue and purple, and with the spun scarlet, and the fine linen twined, they made it a woven work;"],["11",[["ἐποίησαν",710582,150],["αὐτὸ",702165,129],["ἐπωμίδας",705374,39],["συνεχούσας",712469,338],["ἐξ",704132,0],["ἀμφοτέρων",700892,83],["τῶν",709436,43],["μερῶν",708752,44]],"shoulder-pieces joined from both sides, a work woven by mutual twisting of the parts into one another."],["12",[["ἔργον",705396,25],["ὑφαντὸν",713278,46],["εἰς",704105,0],["ἄλληλα",700689,71],["συμπεπλεγμένον",712334,414],["καθ᾿",707200,0],["ἑαυτὸ",703917,129],["ἐξ",704132,0],["αὐτοῦ",702165,49],["ἐποίησαν",710582,150],["κατὰ",707200,0],["τὴν",709436,8],["αὐτοῦ",702165,49],["ποίησιν",710584,9],["ἐκ",704132,0],["χρυσίου",713972,21],["καὶ",707031,7],["ὑακίνθου",713048,17],["καὶ",707031,7],["πορφύρας",710682,17],["καὶ",707031,7],["κοκκίνου",707783,92],["διανενησμένου",703525,441],["καὶ",707031,7],["βύσσου",702834,17],["κεκλωσμένης",707746,440],["καθὰ",706979,28],["συνέταξεν",712508,2],["κύριος",707996,4],["τῷ",709436,113],["Μωυσῇ",709112,114]],"They made it of the same material according to the making of it, of gold, and blue, and purple, and spun scarlet, and fine linen twined, as the Lord commanded Moses;"],["13",[["καὶ",707031,7],["ἐποίησαν",710582,150],["ἀμφοτέρους",700892,60],["τοὺς",709436,58],["λίθους",708196,57],["τῆς",709436,16],["σμαράγδου",711909,17],["συμπεπορπημένους",712343,360],["καὶ",707031,7],["περισεσιαλωμένους",710378,360],["χρυσίῳ",713972,54],["γεγλυμμένους",703119,360],["καὶ",707031,7],["ἐκκεκολαμμένους",704223,360],["ἐκκόλαμμα",704222,25],["σφραγῖδος",712591,17],["ἐκ",704132,0],["τῶν",709436,43],["ὀνομάτων",709666,44],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18]],"and they made the two emerald stones clasped together and set in gold, graven and cut after the cutting of a seal with the names of the children of Israel;"],["14",[["καὶ",707031,7],["ἐπέθηκεν",705304,2],["αὐτοὺς",702165,62],["ἐπὶ",705080,0],["τοὺς",709436,58],["ὤμους",714114,57],["τῆς",709436,16],["ἐπωμίδος",705374,17],["λίθους",708196,57],["μνημοσύνου",708966,21],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["καθὰ",706979,28],["συνέταξεν",712508,2],["κύριος",707996,4],["τῷ",709436,113],["Μωυσῇ",709112,114]],"and he put them on the shoulder-pieces of the ephod, [as] stones of memorial of the children of Israel, as the Lord appointed Moses."],["15",[["καὶ",707031,7],["ἐποίησαν",710582,150],["λογεῖον",708231,25],["ἔργον",705396,25],["ὑφαντὸν",713278,46],["ποικιλίᾳ",710586,1],["κατὰ",707200,0],["τὸ",709436,24],["ἔργον",705396,25],["τῆς",709436,16],["ἐπωμίδος",705374,17],["ἐκ",704132,0],["χρυσίου",713972,21],["καὶ",707031,7],["ὑακίνθου",713048,17],["καὶ",707031,7],["πορφύρας",710682,17],["καὶ",707031,7],["κοκκίνου",707783,92],["διανενησμένου",703525,441],["καὶ",707031,7],["βύσσου",702834,17],["κεκλωσμένης",707746,440]],"And they made the oracle, a work woven with embroidery, according to the work of the ephod, of gold, and blue, and purple, and spun scarlet, and fine linen twined."],["16",[["τετράγωνον",712812,46],["διπλοῦν",703740,46],["ἐποίησαν",710582,150],["τὸ",709436,24],["λογεῖον",708231,25],["σπιθαμῆς",712013,17],["τὸ",709436,24],["μῆκος",708868,25],["καὶ",707031,7],["σπιθαμῆς",712013,17],["τὸ",709436,24],["εὖρος",705677,25],["διπλοῦν",703740,46]],"They made the oracle square [and] double, the length of a span, and the breadth of a span,—double."],["17",[["καὶ",707031,7],["συνυφάνθη",712528,37],["ἐν",704639,0],["αὐτῷ",702165,280],["ὕφασμα",713280,15],["κατάλιθον",707312,26],["τετράστιχον",712825,26],["στίχος",712113,4],["λίθων",708196,81],["σάρδιον",711525,15],["καὶ",707031,7],["τοπάζιον",712900,15],["καὶ",707031,7],["σμάραγδος",711909,12],["ὁ",709436,3],["στίχος",712113,4],["ὁ",709436,3],["εἷς",704106,14]],"And there was interwoven with it a woven work of four rows of stones, a series of stones, the first row, a sardius and topaz and emerald;"],["18",[["καὶ",707031,7],["ὁ",709436,3],["στίχος",712113,4],["ὁ",709436,3],["δεύτερος",703389,14],["ἄνθραξ",701160,4],["καὶ",707031,7],["σάπφειρος",711505,12],["καὶ",707031,7],["ἴασπις",706451,12]],"and the second row, a carbuncle and sapphire and jasper;"],["19",[["καὶ",707031,7],["ὁ",709436,3],["στίχος",712113,4],["ὁ",709436,3],["τρίτος",712968,14],["λιγύριον",708191,15],["καὶ",707031,7],["ἀχάτης",702255,4],["καὶ",707031,7],["ἀμέθυστος",700797,12]],"and the third row, a ligure and agate and amethyst;"],["20",[["καὶ",707031,7],["ὁ",709436,3],["στίχος",712113,4],["ὁ",709436,3],["τέταρτος",712811,14],["χρυσόλιθος",713974,4],["καὶ",707031,7],["βηρύλλιον",702704,15],["καὶ",707031,7],["ὀνύχιον",709675,15],["περικεκυκλωμένα",710339,388],["χρυσίῳ",713972,54],["καὶ",707031,7],["συνδεδεμένα",712417,370],["χρυσίῳ",713972,54]],"and the fourth row a chrysolite and beryl and onyx set round about with gold, and fastened with gold."],["21",[["καὶ",707031,7],["οἱ",709436,136],["λίθοι",708196,52],["ἦσαν",704093,137],["ἐκ",704132,0],["τῶν",709436,43],["ὀνομάτων",709666,44],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["δώδεκα",703887,59],["ἐκ",704132,0],["τῶν",709436,43],["ὀνομάτων",709666,44],["αὐτῶν",702165,40],["ἐγγεγραμμένα",703943,370],["εἰς",704105,0],["σφραγῖδας",712591,39],["ἕκαστος",704133,14],["ἐκ",704132,0],["τοῦ",709436,20],["ἑαυτοῦ",703917,49],["ὀνόματος",709666,21],["εἰς",704105,0],["τὰς",709436,38],["δώδεκα",703887,59],["φυλάς",713620,39]],"And the stones were twelve according to the names of the children of Israel, graven according to their names like seals, each according to his own name for the twelve tribes."],["22",[["καὶ",707031,7],["ἐποίησαν",710582,150],["ἐπὶ",705080,0],["τὸ",709436,24],["λογεῖον",708231,25],["κροσσοὺς",707915,57],["συμπεπλεγμένους",712334,360],["ἔργον",705396,25],["ἐμπλοκίου",704599,21],["ἐκ",704132,0],["χρυσίου",713972,21],["καθαροῦ",706988,92]],"And they made on the oracle turned wreaths, wreathen work, of pure gold,"],["23",[["καὶ",707031,7],["ἐποίησαν",710582,150],["δύο",703849,59],["ἀσπιδίσκας",701990,39],["χρυσᾶς",713971,119],["καὶ",707031,7],["δύο",703849,59],["δακτυλίους",703258,57],["χρυσοῦς",713971,14],["καὶ",707031,7],["ἐπέθηκαν",705304,150],["τοὺς",709436,58],["δύο",703849,59],["δακτυλίους",703258,57],["τοὺς",709436,58],["χρυσοῦς",713971,27],["ἐπ᾿",705080,0],["ἀμφοτέρας",700892,119],["τὰς",709436,38],["ἀρχὰς",701836,39],["τοῦ",709436,20],["λογείου",708231,21]],"and they made two golden circlets and two golden rings. And they put the two golden rings on both the [upper] corners of the oracle;"],["24",[["καὶ",707031,7],["ἐπέθηκαν",705304,150],["τὰ",709436,41],["ἐμπλόκια",704599,42],["ἐκ",704132,0],["χρυσίου",713972,21],["ἐπὶ",705080,0],["τοὺς",709436,58],["δακτυλίους",703258,57],["ἐπ᾿",705080,0],["ἀμφοτέρων",700892,83],["τῶν",709436,43],["μερῶν",708752,44],["τοῦ",709436,20],["λογείου",708231,21]],"and they put the golden wreaths on the rings on both sides of the oracle,"],["25",[["καὶ",707031,7],["εἰς",704105,0],["τὰς",709436,38],["δύο",703849,59],["συμβολὰς",712287,39],["τὰ",709436,41],["δύο",703849,59],["ἐμπλόκια",704599,42],["καὶ",707031,7],["ἐπέθηκαν",705304,150],["ἐπὶ",705080,0],["τὰς",709436,38],["δύο",703849,59],["ἀσπιδίσκας",701990,39],["καὶ",707031,7],["ἐπέθηκαν",705304,150],["ἐπὶ",705080,0],["τοὺς",709436,58],["ὤμους",714114,57],["τῆς",709436,16],["ἐπωμίδος",705374,17],["ἐξ",704132,0],["ἐναντίας",704656,82],["κατὰ",707200,0],["πρόσωπον",710986,25]],"and the two wreaths into the two couplings. And they put them on the two circlets, and they put them on the shoulders of the ephod opposite [each other] in front."],["26",[["καὶ",707031,7],["ἐποίησαν",710582,150],["δύο",703849,59],["δακτυλίους",703258,57],["χρυσοῦς",713971,14],["καὶ",707031,7],["ἐπέθηκαν",705304,150],["ἐπὶ",705080,0],["τὰ",709436,41],["δύο",703849,59],["πτερύγια",711056,42],["ἐπ᾿",705080,0],["ἄκρου",700608,92],["τοῦ",70