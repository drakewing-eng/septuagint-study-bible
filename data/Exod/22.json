[["1",[["ἐὰν",703912,7],["δὲ",703303,11],["ἐν",704639,0],["τῷ",709436,53],["διορύγματι",703731,54],["εὑρεθῇ",705676,384],["ὁ",709436,3],["κλέπτης",707714,4],["καὶ",707031,7],["πληγεὶς",710550,217],["ἀποθάνῃ",701461,172],["οὐκ",709805,28],["ἔστιν",704093,91],["αὐτῷ",702165,50],["φόνος",713549,4]],"And if the thief be found in the breach [made by himself] and be smitten and die, there shall not be blood shed for him."],["2",[["ἐὰν",703912,7],["δὲ",703303,11],["ἀνατείλῃ",701066,172],["ὁ",709436,3],["ἥλιος",705974,4],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["ἔνοχός",704781,14],["ἐστιν",704093,91],["ἀνταποθανεῖται",701218,93],["ἐὰν",703912,7],["δὲ",703303,11],["μὴ",708851,28],["ὑπάρχῃ",713104,204],["αὐτῷ",702165,50],["πραθήτω",710480,22],["ἀντὶ",701227,0],["τοῦ",709436,20],["κλέμματος",707711,21]],"But if the sun be risen upon him, he is guilty, he shall die instead; and if a thief have nothing, let him be sold in compensation for what he has stolen."],["3",[["ἐὰν",703912,7],["δὲ",703303,11],["καταλημφθῇ",707300,384],["καὶ",707031,7],["εὑρεθῇ",705676,384],["ἐν",704639,0],["τῇ",709436,100],["χειρὶ",713787,1],["αὐτοῦ",702165,102],["τὸ",709436,34],["κλέμμα",707711,15],["ἀπό",701425,0],["τε",712751,11],["ὄνου",709671,18],["ἕως",705792,0],["προβάτου",710768,21],["ζῶντα",705851,237],["διπλᾶ",703740,68],["αὐτὰ",702165,71],["ἀποτείσει",701618,127]],"And if the thing stolen be left and be in his hand alive, whether ox or sheep, he shall restore them two-fold."],["4",[["ἐὰν",703912,7],["δὲ",703303,11],["καταβοσκήσῃ",707216,172],["τις",712866,158],["ἀγρὸν",700196,6],["ἢ",705924,7],["ἀμπελῶνα",700872,6],["καὶ",707031,7],["ἀφῇ",702211,172],["τὸ",709436,24],["κτῆνος",707934,25],["αὐτοῦ",702165,102],["καταβοσκῆσαι",707216,106],["ἀγρὸν",700196,6],["ἕτερον",705535,27],["ἀποτείσει",701618,127],["ἐκ",704132,0],["τοῦ",709436,35],["ἀγροῦ",700196,18],["αὐτοῦ",702165,102],["κατὰ",707200,0],["τὸ",709436,24],["γένημα",703052,25],["αὐτοῦ",702165,102],["ἐὰν",703912,7],["δὲ",703303,11],["πάντα",710177,27],["τὸν",709436,5],["ἀγρὸν",700196,6],["καταβοσκήσῃ",707216,172],["τὰ",709436,41],["βέλτιστα",702647,430],["τοῦ",709436,35],["ἀγροῦ",700196,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["βέλτιστα",702647,430],["τοῦ",709436,35],["ἀμπελῶνος",700872,18],["αὐτοῦ",702165,102],["ἀποτείσει",701618,127]],"And if any one should feed down a field or a vineyard, and should send in his beast to feed down another field, he shall make compensation of his own field according to his produce; and if he shall have fed down the whole field, he shall pay for compensation the best of his own field and the best of his vineyard."],["5",[["ἐὰν",703912,7],["δὲ",703303,11],["ἐξελθὸν",704909,293],["πῦρ",711088,15],["εὕρῃ",705676,172],["ἀκάνθας",700517,39],["καὶ",707031,7],["προσεμπρήσῃ",710884,172],["ἅλωνα",700741,9],["ἢ",705924,7],["στάχυς",712053,6],["ἢ",705924,7],["πεδίον",710215,25],["ἀποτείσει",701618,127],["ὁ",709436,3],["τὸ",709436,24],["πῦρ",711088,25],["ἐκκαύσας",704205,182]],"And if fire have gone forth and caught thorns, and should also set on fire threshing-floors or ears of corn or a field, he that kindled the fire shall make compensation."],["6",[["ἐὰν",703912,7],["δέ",703303,11],["τις",712866,158],["δῷ",703654,172],["τῷ",709436,113],["πλησίον",710547,28],["ἀργύριον",701707,25],["ἢ",705924,7],["σκεύη",711844,42],["φυλάξαι",713619,106],["καὶ",707031,7],["κλαπῇ",707715,384],["ἐκ",704132,0],["τῆς",709436,16],["οἰκίας",709505,17],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["ἐὰν",703912,7],["εὑρεθῇ",705676,384],["ὁ",709436,3],["κλέψας",707715,182],["ἀποτείσει",701618,127],["διπλοῦν",703740,46]],"And if any one give to his neighbour money or goods to keep, and they be stolen out of the man's house, if the thief be found, he shall repay double."],["7",[["ἐὰν",703912,7],["δὲ",703303,11],["μὴ",708851,28],["εὑρεθῇ",705676,384],["ὁ",709436,3],["κλέψας",707715,182],["προσελεύσεται",710890,93],["ὁ",709436,3],["κύριος",707996,4],["τῆς",709436,16],["οἰκίας",709505,17],["ἐνώπιον",704823,0],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["ὀμεῖται",709620,93],["ἦ",705924,7],["μὴν",708873,11],["μὴ",708851,28],["αὐτὸς",702165,121],["πεπονηρεῦσθαι",710657,431],["ἐφ᾿",705080,0],["ὅλης",709597,82],["τῆς",709436,16],["παρακαταθήκης",710042,17],["τοῦ",709436,35],["πλησίον",710547,28]],"But if the thief be not found, the master of the house shall come forward before God, and shall swear that surely he has not wrought wickedly in regard of any part of his neighbour's deposit,"],["8",[["κατὰ",707200,0],["πᾶν",710177,46],["ῥητὸν",711253,46],["ἀδίκημα",700270,25],["περί",710285,0],["τε",712751,11],["μόσχου",709029,18],["καὶ",707031,7],["ὑποζυγίου",713198,21],["καὶ",707031,7],["προβάτου",710768,21],["καὶ",707031,7],["ἱματίου",706742,21],["καὶ",707031,7],["πάσης",710177,82],["ἀπωλείας",701660,17],["τῆς",709436,16],["ἐγκαλουμένης",703961,422],["ὅ",709781,33],["τι",712866,126],["οὖν",709835,11],["ἂν",700900,11],["ᾖ",704093,204],["ἐνώπιον",704823,0],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐλεύσεται",705453,93],["ἡ",709436,10],["κρίσις",707908,12],["ἀμφοτέρων",700892,169],["καὶ",707031,7],["ὁ",709436,3],["ἁλοὺς",700673,182],["διὰ",703417,0],["τοῦ",709436,35],["θεοῦ",706192,18],["ἀποτείσει",701618,127],["διπλοῦν",703740,46],["τῷ",709436,113],["πλησίον",710547,28]],"according to every injury alleged, both concerning a calf, and an ass, and a sheep, and a garment, and every alleged loss, whatsoever in fact it may be,—the judgment of both shall proceed before God, and he that is convicted by God shall repay to his neighbour double."],["9",[["ἐὰν",703912,7],["δέ",703303,11],["τις",712866,158],["δῷ",703654,172],["τῷ",709436,113],["πλησίον",710547,28],["ὑποζύγιον",713198,25],["ἢ",705924,7],["μόσχον",709029,6],["ἢ",705924,7],["πρόβατον",710768,25],["ἢ",705924,7],["πᾶν",710177,46],["κτῆνος",707934,25],["φυλάξαι",713619,106],["καὶ",707031,7],["συντριβῇ",712520,384],["ἢ",705924,7],["τελευτήσῃ",712781,172],["ἢ",705924,7],["αἰχμάλωτον",700503,27],["γένηται",703104,239],["καὶ",707031,7],["μηδεὶς",708857,14],["γνῷ",703105,172]],"And if any one give to his neighbour to keep a calf or sheep or any beast, and it be wounded or die or be taken, and no one know,"],["10",[["ὅρκος",709753,4],["ἔσται",704093,93],["τοῦ",709436,35],["θεοῦ",706192,18],["ἀνὰ",700902,0],["μέσον",708768,46],["ἀμφοτέρων",700892,169],["ἦ",705924,7],["μὴν",708873,11],["μὴ",708851,28],["αὐτὸν",702165,85],["πεπονηρεῦσθαι",710657,431],["καθ᾿",707200,0],["ὅλης",709597,82],["τῆς",709436,16],["παρακαταθήκης",710042,17],["τοῦ",709436,35],["πλησίον",710547,28],["καὶ",707031,7],["οὕτως",709859,28],["προσδέξεται",710874,93],["ὁ",709436,3],["κύριος",707996,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ἀποτείσει",701618,127]],"an oath of God shall be between both, [each swearing] that he has surely not at all been guilty in the matter of his neighbour's deposit; and so his master shall hold him guiltless, and he shall not make compensation."],["11",[["ἐὰν",703912,7],["δὲ",703303,11],["κλαπῇ",707715,384],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["ἀποτείσει",701618,127],["τῷ",709436,113],["κυρίῳ",707996,114]],"And if it be stolen from him, he shall make compensation to the owner."],["12",[["ἐὰν",703912,7],["δὲ",703303,11],["θηριάλωτον",706250,26],["γένηται",703104,239],["ἄξει",700209,127],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["τὴν",709436,8],["θήραν",706244,9],["καὶ",707031,7],["οὐκ",709805,28],["ἀποτείσει",701618,127]],"And if it be seized of beasts, he shall bring him to [witness] the prey, and he shall not make compensation."],["13",[["ἐὰν",703912,7],["δὲ",703303,11],["αἰτήσῃ",700489,172],["τις",712866,158],["παρὰ",709995,0],["τοῦ",709436,35],["πλησίον",710547,28],["καὶ",707031,7],["συντριβῇ",712520,384],["ἢ",705924,7],["ἀποθάνῃ",701461,172],["ἢ",705924,7],["αἰχμάλωτον",700503,26],["γένηται",703104,239],["ὁ",709436,3],["δὲ",703303,11],["κύριος",707996,4],["μὴ",708851,28],["ᾖ",704093,204],["μετ᾿",708780,0],["αὐτοῦ",702165,49],["ἀποτείσει",701618,127]],"And if any one borrow [ought] of his neighbour, and it be wounded or die or be carried away, and the owner of it be not with it, he shall make compensation."],["14",[["ἐὰν",703912,7],["δὲ",703303,11],["ὁ",709436,3],["κύριος",707996,4],["ᾖ",704093,204],["μετ᾿",708780,0],["αὐτοῦ",702165,49],["οὐκ",709805,28],["ἀποτείσει",701618,127],["ἐὰν",703912,7],["δὲ",703303,11],["μισθωτὸς",708942,14],["ᾖ",704093,204],["ἔσται",704093,93],["αὐτῷ",702165,280],["ἀντὶ",701227,0],["τοῦ",709436,35],["μισθοῦ",708939,18],["αὐτοῦ",702165,49]],"But if the owner be with it, he shall not make compensation: but if it be a hired thing, there shall be [a compensation] to him instead of his hire."],["15",[["ἐὰν",703912,7],["δὲ",703303,11],["ἀπατήσῃ",701364,172],["τις",712866,158],["παρθένον",710148,9],["ἀμνήστευτον",700853,36],["καὶ",707031,7],["κοιμηθῇ",707767,384],["μετ᾿",708780,0],["αὐτῆς",702165,86],["φερνῇ",713426,1],["φερνιεῖ",713427,127],["αὐτὴν",702165,104],["αὐτῷ",702165,50],["γυναῖκα",703209,9]],"And if any one deceive a virgin that is not betrothed, and lie with her, he shall surely endow her for a wife to himself."],["16",[["ἐὰν",703912,7],["δὲ",703303,11],["ἀνανεύων",701013,72],["ἀνανεύσῃ",701013,172],["καὶ",707031,7],["μὴ",708851,28],["βούληται",702795,428],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτῆς",702165,86],["δοῦναι",703654,106],["αὐτὴν",702165,104],["αὐτῷ",702165,50],["γυναῖκα",703209,9],["ἀργύριον",701707,25],["ἀποτείσει",701618,127],["τῷ",709436,113],["πατρὶ",710189,114],["καθ᾿",707200,0],["ὅσον",709788,46],["ἐστὶν",704093,91],["ἡ",709436,10],["φερνὴ",713426,12],["τῶν",709436,130],["παρθένων",710148,65]],"And if her father positively refuse, and will not consent to give her to him for a wife, he shall pay compensation to her father according to the amount of the dowry of virgins."],["17",[["φαρμακοὺς",713370,57],["οὐ",709805,28],["περιποιήσετε",710367,337]],"Ye shall not save the lives of sorcerers."],["18",[["πᾶν",710177,26],["κοιμώμενον",707767,208],["μετὰ",708780,0],["κτήνους",707934,21],["θανάτῳ",706096,114],["ἀποκτενεῖτε",701498,337],["αὐτούς",702165,62]],"Every one that lies with a beast ye shall surely put to death."],["19",[["ὁ",709436,3],["θυσιάζων",706346,72],["θεοῖς",706192,148],["θανάτῳ",706096,114],["ὀλεθρευθήσεται",709560,134],["πλὴν",710540,28],["κυρίῳ",707996,114],["μόνῳ",709003,30]],"He that sacrifices to any gods but to the Lord alone, shall be destroyed by death."],["20",[["καὶ",707031,7],["προσήλυτον",710900,6],["οὐ",709805,28],["κακώσετε",707073,337],["οὐδὲ",709816,7],["μὴ",708851,28],["θλίψητε",706274,125],["αὐτόν",702165,85],["ἦτε",704093,399],["γὰρ",702963,11],["προσήλυτοι",710900,52],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτῳ",700401,1]],"And ye shall not hurt a stranger, nor afflict him; for ye were strangers in the land of Egypt."],["21",[["πᾶσαν",710177,36],["χήραν",713848,9],["καὶ",707031,7],["ὀρφανὸν",709779,27],["οὐ",709805,28],["κακώσετε",707073,337]],"Ye shall hurt no widow or orphan."],["22",[["ἐὰν",703912,7],["δὲ",703303,11],["κακίᾳ",707054,1],["κακώσητε",707073,125],["αὐτοὺς",702165,62],["καὶ",707031,7],["κεκράξαντες",707868,196],["καταβοήσωσι",707213,234],["πρός",710844,0],["με",708618,163],["ἀκοῇ",700561,1],["εἰσακούσομαι",704108,181],["τῆς",709436,16],["φωνῆς",713640,17],["αὐτῶν",702165,40]],"And if ye should afflict them by ill-treatment, and they should cry aloud to me, I will surely hear their voice."],["23",[["καὶ",707031,7],["ὀργισθήσομαι",709729,180],["θυμῷ",706334,114],["καὶ",707031,7],["ἀποκτενῶ",701498,165],["ὑμᾶς",713080,194],["μαχαίρᾳ",708593,1],["καὶ",707031,7],["ἔσονται",704093,135],["αἱ",709436,190],["γυναῖκες",703209,191],["ὑμῶν",713091,145],["χῆραι",713848,191],["καὶ",707031,7],["τὰ",709436,63],["παιδία",709927,64],["ὑμῶν",713091,145],["ὀρφανά",709779,195]],"And I will be very angry, and will slay you with the sword, and your wives shall be widows and your children orphans."],["24",[["ἐὰν",703912,7],["δὲ",703303,11],["ἀργύριον",701707,25],["ἐκδανείσῃς",704161,175],["τῷ",709436,113],["ἀδελφῷ",700249,114],["τῷ",709436,113],["πενιχρῷ",710255,30],["παρὰ",709995,0],["σοί",711925,159],["οὐκ",709805,28],["ἔσῃ",704093,123],["αὐτὸν",702165,85],["κατεπείγων",707512,72],["οὐκ",709805,28],["ἐπιθήσεις",705304,166],["αὐτῷ",702165,50],["τόκον",712882,6]],"And if thou shouldest lend money to thy poor brother who is by thee, thou shalt not be hard upon him, thou shalt not exact usury of him."],["25",[["ἐὰν",703912,7],["δὲ",703303,11],["ἐνεχύρασμα",704724,25],["ἐνεχυράσῃς",704722,175],["τὸ",709436,24],["ἱμάτιον",706742,25],["τοῦ",709436,35],["πλησίον",710547,28],["πρὸ",710747,0],["δυσμῶν",703865,65],["ἡλίου",705974,18],["ἀποδώσεις",701449,166],["αὐτῷ",702165,50]],"And if thou take thy neighbour's garment for a pledge, thou shalt restore it to him before sunset."],["26",[["ἔστιν",704093,91],["γὰρ",702963,11],["τοῦτο",709858,132],["περιβόλαιον",710300,15],["αὐτοῦ",702165,102],["μόνον",709003,26],["τοῦτο",709858,132],["τὸ",709436,34],["ἱμάτιον",706742,15],["ἀσχημοσύνης",702054,17],["αὐτοῦ",702165,102],["ἐν",704639,0],["τίνι",712867,432],["κοιμηθήσεται",707767,134],["ἐὰν",703912,7],["οὖν",709835,11],["καταβοήσῃ",707213,172],["πρός",710844,0],["με",708618,163],["εἰσακούσομαι",704108,181],["αὐτοῦ",702165,102],["ἐλεήμων",704422,14],["γάρ",702963,11],["εἰμι",704093,157]],"For this is his clothing, this is the only covering of his nakedness; wherein shall he sleep? If then he shall cry to me, I will hearken to him, for I am merciful."],["27",[["θεοὺς",706192,57],["οὐ",709805,28],["κακολογήσεις",707058,166],["καὶ",707031,7],["ἄρχοντας",701862,57],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133],["οὐ",709805,28],["κακῶς",707074,28],["ἐρεῖς",705415,166]],"Thou shalt not revile the gods, nor speak ill of the ruler of thy people."],["28",[["ἀπαρχὰς",701359,39],["ἅλωνος",700741,17],["καὶ",707031,7],["ληνοῦ",708176,17],["σου",711945,133],["οὐ",709805,28],["καθυστερήσεις",707027,166],["τὰ",709436,41],["πρωτότοκα",711046,68],["τῶν",709436,80],["υἱῶν",713075,81],["σου",711945,133],["δώσεις",703654,166],["ἐμοί",704577,159]],"Thou shalt not keep back the first-fruits of thy threshing floor and press. The first-born of thy sons thou shalt give to me."],["29",[["οὕτως",709859,28],["ποιήσεις",710582,166],["τὸν",709436,5],["μόσχον",709029,6],["σου",711945,133],["καὶ",707031,7],["τὸ",709436,24],["πρόβατόν",710768,25],["σου",711945,133],["καὶ",707031,7],["τὸ",709436,24],["ὑποζύγιόν",713198,25],["σου",711945,133],["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["ἔσται",704093,93],["ὑπὸ",713184,0],["τὴν",709436,8],["μητέρα",708892,9],["τῇ",709436,100],["δὲ",703303,11],["ὀγδόῃ",709444,101],["ἡμέρᾳ",705984,1],["ἀποδώσεις",701449,166],["μοι",708974,159],["αὐτό",702165,129]],"So shalt thou do with thy calf and thy sheep and thine ass; seven days shall it be under the mother, and the eighth day thou shalt give it to me."],["30",[["καὶ",707031,7],["ἄνδρες",701150,52],["ἅγιοι",700159,138],["ἔσεσθέ",704093,124],["μοι",708974,159],["καὶ",707031,7],["κρέας",707889,25],["θηριάλωτον",706250,46],["οὐκ",709805,28],["ἔδεσθε",705495,124],["τῷ",709436,113],["κυνὶ",708004,114],["ἀπορρίψατε",701563,74],["αὐτό",702165,129]],"And ye shall be holy men to me; and ye shall not eat flesh taken of beasts, ye shall cast it to the dog."]]