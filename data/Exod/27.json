[["1",[["καὶ",707031,7],["ποιήσεις",710582,166],["θυσιαστήριον",706348,25],["ἐκ",704132,0],["ξύλων",709427,44],["ἀσήπτων",701933,83],["πέντε",710266,59],["πήχεων",710462,81],["τὸ",709436,24],["μῆκος",708868,25],["καὶ",707031,7],["πέντε",710266,59],["πήχεων",710462,81],["τὸ",709436,24],["εὖρος",705677,25],["τετράγωνον",712812,26],["ἔσται",704093,93],["τὸ",709436,24],["θυσιαστήριον",706348,25],["καὶ",707031,7],["τριῶν",712927,169],["πήχεων",710462,81],["τὸ",709436,24],["ὕψος",713288,25],["αὐτοῦ",702165,102]],"And thou shalt make an altar of incorruptible wood, of five cubits in the length, and five cubits in the breadth; the altar shall be square, and the height of it shall be of three cubits."],["2",[["καὶ",707031,7],["ποιήσεις",710582,166],["τὰ",709436,41],["κέρατα",707625,42],["ἐπὶ",705080,0],["τῶν",709436,130],["τεσσάρων",712808,198],["γωνιῶν",703226,65],["ἐξ",704132,0],["αὐτοῦ",702165,102],["ἔσται",704093,93],["τὰ",709436,41],["κέρατα",707625,42],["καὶ",707031,7],["καλύψεις",707102,166],["αὐτὰ",702165,71],["χαλκῷ",713690,30]],"And thou shalt make the horns on the four corners; the horns shall be of the same piece, and thou shalt overlay them with brass."],["3",[["καὶ",707031,7],["ποιήσεις",710582,166],["στεφάνην",712081,9],["τῷ",709436,53],["θυσιαστηρίῳ",706348,54],["καὶ",707031,7],["τὸν",709436,5],["καλυπτῆρα",707101,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰς",709436,38],["φιάλας",713453,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰς",709436,38],["κρεάγρας",707887,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὸ",709436,24],["πυρεῖον",711093,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["σκεύη",711844,42],["αὐτοῦ",702165,102],["ποιήσεις",710582,166],["χαλκᾶ",713690,68]],"And thou shalt make a rim for the altar; and its covering and its cups, and its flesh-hooks, and its fire-pan, and all its vessels shalt thou make of brass."],["4",[["καὶ",707031,7],["ποιήσεις",710582,166],["αὐτῷ",702165,50],["ἐσχάραν",705514,9],["ἔργῳ",70539