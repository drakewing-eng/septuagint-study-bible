,["ὑακίνθου",713048,17],["καὶ",707031,7],["πορφύρας",710682,17],["καὶ",707031,7],["κοκκίνου",707783,92],["κεκλωσμένου",707746,441],["καὶ",707031,7],["βύσσου",702834,17],["κεκλωσμένης",707746,440],["ἔργον",705396,25],["ποικιλτοῦ",710590,18]],"And thou shalt make a screen for the door of the tabernacle of blue, and purple, and spun scarlet and fine linen spun, the work of the embroiderer."],["37",[["καὶ",707031,7],["ποιήσεις",710582,166],["τῷ",709436,53],["καταπετάσματι",707370,54],["πέντε",710266,59],["στύλους",712179,57],["καὶ",707031,7],["χρυσώσεις",713980,166],["αὐτοὺς",702165,62],["χρυσίῳ",713972,54],["καὶ",707031,7],["αἱ",709436,190],["κεφαλίδες",707640,191],["αὐτῶν",702165,40],["χρυσαῖ",713971,192],["καὶ",707031,7],["χωνεύσεις",714010,166],["αὐτοῖς",702165,151],["πέντε",710266,59],["βάσεις",702585,39],["χαλκᾶς",713690,119]],"And thou shalt make for the veil five posts, and thou shalt gild them with gold; and their chapiters shall be gold; and thou shalt cast for them five brazen sockets."]]