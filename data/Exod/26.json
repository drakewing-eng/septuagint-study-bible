σεις",710582,166],["χρυσοῦς",713971,60],["εἰς",704105,0],["οὓς",709781,298],["εἰσάξεις",704107,166],["τοὺς",709436,58],["μοχλούς",709040,57],["καὶ",707031,7],["καταχρυσώσεις",707496,166],["τοὺς",709436,58],["μοχλοὺς",709040,57],["χρυσίῳ",713972,54]],"And thou shalt gild the posts with gold; and thou shalt make golden rings, into which thou shalt introduce the bars, and thou shalt gild the bars with gold."],["30",[["καὶ",707031,7],["ἀναστήσεις",701173,166],["τὴν",709436,8],["σκηνὴν",711845,9],["κατὰ",707200,0],["τὸ",709436,24],["εἶδος",704074,25],["τὸ",709436,24],["δεδειγμένον",703314,414],["σοι",711925,159],["ἐν",704639,0],["τῷ",709436,53],["ὄρει",709768,54]],"And thou shalt set up the tabernacle according to the pattern shewed thee in the mount."],["31",[["καὶ",707031,7],["ποιήσεις",710582,166],["καταπέτασμα",707370,25],["ἐξ",704132,0],["ὑακίνθου",713048,17],["καὶ",707031,7],["πορφύρας",710682,17],["καὶ",707031,7],["κοκκίνου",707783,92],["κεκλωσμένου",707746,441],["καὶ",707031,7],["βύσσου",702834,17],["νενησμένης",709292,440],["ἔργον",705396,25],["ὑφαντὸν",713278,46],["ποιήσεις",710582,166],["αὐτὸ",702165,129],["χερουβιμ",713830,57]],"And thou shalt make a veil of blue and purple and scarlet woven, and fine linen spun: thou shalt make it cherubs [in] woven work."],["32",[["καὶ",707031,7],["ἐπιθήσεις",705304,166],["αὐτὸ",702165,129],["ἐπὶ",705080,0],["τεσσάρων",712808,169],["στύλων",712179,81],["ἀσήπτων",701933,169],["κεχρυσωμένων",713980,398],["χρυσίῳ",713972,54],["καὶ",707031,7],["αἱ",709436,190],["κεφαλίδες",707640,191],["αὐτῶν",702165,40],["χρυσαῖ",713971,192],["καὶ",707031,7],["αἱ",709436,190],["βάσεις",702585,191],["αὐτῶν",702165,40],["τέσσαρες",712808,192],["ἀργυραῖ",701705,192]],"And thou shalt set it upon four posts of incorruptible wood overlaid with gold; and their tops [shall be] gold, and their four sockets [shall be] of silver."],["33",[["καὶ",707031,7],["θήσεις",712849,166],["τὸ",709436,24],["καταπέτασμα",707370,25],["ἐπὶ",705080,0],["τοὺς",709436,58]