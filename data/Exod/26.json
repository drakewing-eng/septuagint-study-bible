[["1",[["καὶ",707031,7],["τὴν",709436,8],["σκηνὴν",711845,9],["ποιήσεις",710582,166],["δέκα",703333,59],["αὐλαίας",702133,39],["ἐκ",704132,0],["βύσσου",702834,17],["κεκλωσμένης",707746,440],["καὶ",707031,7],["ὑακίνθου",713048,17],["καὶ",707031,7],["πορφύρας",710682,17],["καὶ",707031,7],["κοκκίνου",707783,92],["κεκλωσμένου",707746,441],["χερουβιμ",713830,57],["ἐργασίᾳ",705385,1],["ὑφάντου",713277,18],["ποιήσεις",710582,166],["αὐτάς",702165,231]],"And thou shalt make the tabernacle, ten curtains of fine linen spun, and blue and purple, and scarlet spun [with] cherubs; thou shalt make them with work of a weaver."],["2",[["μῆκος",708868,15],["τῆς",709436,16],["αὐλαίας",702133,17],["τῆς",709436,16],["μιᾶς",704106,82],["ὀκτὼ",709555,59],["καὶ",707031,7],["εἴκοσι",704085,59],["πήχεων",710462,81],["καὶ",707031,7],["εὖρος",705677,15],["τεσσάρων",712808,169],["πήχεων",710462,81],["ἡ",709436,10],["αὐλαία",702133,12],["ἡ",709436,10],["μία",704106,29],["ἔσται",704093,93],["μέτρον",708846,15],["τὸ",709436,34],["αὐτὸ",702165,132],["ἔσται",704093,93],["πάσαις",710177,291],["ταῖς",709436,75],["αὐλαίαις",702133,76]],"The length of one curtain shall be eight and twenty cubits, and one curtain shall be the breadth of four cubits: there shall be the same measure to all the curtains."],["3",[["πέντε",710266,59],["δὲ",703303,11],["αὐλαῖαι",702133,191],["ἔσονται",704093,135],["ἐξ",704132,0],["ἀλλήλων",700689,40],["ἐχόμεναι",705785,305],["ἡ",709436,10],["ἑτέρα",705535,29],["ἐκ",704132,0],["τῆς",709436,16],["ἑτέρας",705535,82],["καὶ",707031,7],["πέντε",710266,59],["αὐλαῖαι",702133,191],["ἔσονται",704093,135],["συνεχόμεναι",712469,305],["ἑτέρα",705535,29],["τῇ",709436,100],["ἑτέρᾳ",705535,101]],"And the five curtains shall be joined one to another, and [the other] five curtains shall be closely connected the one with the other."],["4",[["καὶ",707031,7],["ποιήσεις",710582,166],["αὐταῖς",702165,200],["ἀγκύλας",700165,39],["ὑακινθίνας",713047,119],["ἐπὶ",705080,0],["τοῦ",709436,20],["χείλους",713781,21],["τῆς",709436,16],["αὐλαίας",702133,17],["τῆς",709436,16],["μιᾶς",704106,82],["ἐκ",704132,0],["τοῦ",709436,20],["ἑνὸς",704106,92],["μέρους",708752,21],["εἰς",704105,0],["τὴν",709436,8],["συμβολὴν",712287,9],["καὶ",707031,7],["οὕτως",709859,28],["ποιήσεις",710582,166],["ἐπὶ",705080,0],["τοῦ",709436,20],["χείλους",713781,21],["τῆς",709436,16],["αὐλαίας",702133,17],["τῆς",709436,16],["ἐξωτέρας",704987,82],["πρὸς",710844,0],["τῇ",709436,100],["συμβολῇ",712287,1],["τῇ",709436,100],["δευτέρᾳ",703389,101]],"And thou shalt make for them loops of blue on the edge of one curtain, on one side for the coupling, and so shalt thou make on the edge of the outer curtain for the second coupling."],["5",[["πεντήκοντα",710270,59],["ἀγκύλας",700165,39],["ποιήσεις",710582,166],["τῇ",709436,100],["αὐλαίᾳ",702133,1],["τῇ",709436,100],["μιᾷ",704106,101],["καὶ",707031,7],["πεντήκοντα",710270,59],["ἀγκύλας",700165,39],["ποιήσεις",710582,166],["ἐκ",704132,0],["τοῦ",709436,20],["μέρους",708752,21],["τῆς",709436,16],["αὐλαίας",702133,17],["κατὰ",707200,0],["τὴν",709436,8],["συμβολὴν",712287,9],["τῆς",709436,16],["δευτέρας",703389,82],["ἀντιπρόσωποι",701270,192],["ἀντιπίπτουσαι",701265,306],["ἀλλήλαις",700689,200],["εἰς",704105,0],["ἑκάστην",704133,36]],"Fifty loops shalt thou make for one curtain, and fifty loops shalt thou make on the part of the curtain answering to the coupling of the second, opposite [each other], corresponding to each other at each point."],["6",[["καὶ",707031,7],["ποιήσεις",710582,166],["κρίκους",707902,57],["πεντήκοντα",710270,59],["χρυσοῦς",713971,60],["καὶ",707031,7],["συνάψεις",712404,166],["τὰς",709436,38],["αὐλαίας",702133,39],["ἑτέραν",705535,36],["τῇ",709436,100],["ἑτέρᾳ",705535,101],["τοῖς",709436,147],["κρίκοις",707902,148],["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["σκηνὴ",711845,12],["μία",704106,29]],"And thou shalt make fifty golden rings; and thou shalt join the curtains to each other with the rings, and it shall be one tabernacle."],["7",[["καὶ",707031,7],["ποιήσεις",710582,166],["δέρρεις",703365,39],["τριχίνας",712970,119],["σκέπην",711838,9],["ἐπὶ",705080,0],["τῆς",709436,16],["σκηνῆς",711845,17],["ἕνδεκα",704675,59],["δέρρεις",703365,39],["ποιήσεις",710582,166],["αὐτάς",702165,231]],"And thou shalt make for a covering of the tabernacle skins with the hair on, thou shalt make them eleven skins."],["8",[["τὸ",709436,34],["μῆκος",708868,15],["τῆς",709436,16],["δέρρεως",703365,17],["τῆς",709436,16],["μιᾶς",704106,82],["ἔσται",704093,93],["τριάκοντα",712934,59],["πήχεων",710462,81],["καὶ",707031,7],["τεσσάρων",712808,169],["πήχεων",710462,81],["τὸ",709436,34],["εὖρος",705677,15],["τῆς",709436,16],["δέρρεως",703365,17],["τῆς",709436,16],["μιᾶς",704106,82],["μέτρον",708846,15],["τὸ",709436,34],["αὐτὸ",702165,132],["ἔσται",704093,93],["ταῖς",709436,75],["ἕνδεκα",704675,59],["δέρρεσι",703365,76]],"The length of one skin thirty cubits, and the breadth of one skin four cubits: there shall be the same measure to the eleven skins."],["9",[["καὶ",707031,7],["συνάψεις",712404,166],["τὰς",709436,38],["πέντε",710266,59],["δέρρεις",703365,39],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτὸ",702165,129],["καὶ",707031,7],["τὰς",709436,38],["ἓξ",704828,59],["δέρρεις",703365,39],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτό",702165,129],["καὶ",707031,7],["ἐπιδιπλώσεις",705122,166],["τὴν",709436,8],["δέρριν",703365,9],["τὴν",709436,8],["ἕκτην",704340,36],["κατὰ",707200,0],["πρόσωπον",710986,25],["τῆς",709436,16],["σκηνῆς",711845,17]],"And thou shalt join the five skins together, and the six skins together; and thou shalt double the sixth skin in front of the tabernacle."],["10",[["καὶ",707031,7],["ποιήσεις",710582,166],["ἀγκύλας",700165,39],["πεντήκοντα",710270,59],["ἐπὶ",705080,0],["τοῦ",709436,20],["χείλους",713781,21],["τῆς",709436,16],["δέρρεως",703365,17],["τῆς",709436,16],["μιᾶς",704106,82],["τῆς",709436,16],["ἀνὰ",700902,0],["μέσον",708768,46],["κατὰ",707200,0],["συμβολὴν",712287,9],["καὶ",707031,7],["πεντήκοντα",710270,59],["ἀγκύλας",700165,39],["ποιήσεις",710582,166],["ἐπὶ",705080,0],["τοῦ",709436,20],["χείλους",713781,21],["τῆς",709436,16],["δέρρεως",703365,17],["τῆς",709436,16],["συναπτούσης",712404,222],["τῆς",709436,16],["δευτέρας",703389,82]],"And thou shalt make fifty loops on the border of one skin, which is in the midst for the joinings; and thou shalt make fifty loops on the edge of the second skin that joins it."],["11",[["καὶ",707031,7],["ποιήσεις",710582,166],["κρίκους",707902,57],["χαλκοῦς",713690,60],["πεντήκοντα",710270,59],["καὶ",707031,7],["συνάψεις",712404,166],["τοὺς",709436,58],["κρίκους",707902,57],["ἐκ",704132,0],["τῶν",709436,130],["ἀγκυλῶν",700165,65],["καὶ",707031,7],["συνάψεις",712404,166],["τὰς",709436,38],["δέρρεις",703365,39],["καὶ",707031,7],["ἔσται",704093,93],["ἕν",704106,26]],"And thou shalt make fifty brazen rings; and thou shalt join the rings by the loops, and thou shalt join the skins, and they shall be one."],["12",[["καὶ",707031,7],["ὑποθήσεις",713251,166],["τὸ",709436,24],["πλεονάζον",710516,47],["ἐν",704639,0],["ταῖς",709436,75],["δέρρεσιν",703365,76],["τῆς",709436,16],["σκηνῆς",711845,17],["τὸ",709436,24],["ἥμισυ",705998,46],["τῆς",709436,16],["δέρρεως",703365,17],["τὸ",709436,24],["ὑπολελειμμένον",713212,414],["ὑποκαλύψεις",713203,166],["τὸ",709436,24],["πλεονάζον",710516,47],["τῶν",709436,130],["δέρρεων",703365,65],["τῆς",709436,16],["σκηνῆς",711845,17],["ὑποκαλύψεις",713203,166],["ὀπίσω",709697,0],["τῆς",709436,16],["σκηνῆς",711845,17]],"And thou shalt fix at the end that which is over in the skins of the tabernacle; the half of the skin that is left shalt thou fold over, according to the overplus of the skins of the tabernacle; thou shalt fold it over behind the tabernacle."],["13",[["πῆχυν",710462,6],["ἐκ",704132,0],["τούτου",709858,49],["καὶ",707031,7],["πῆχυν",710462,6],["ἐκ",704132,0],["τούτου",709858,49],["ἐκ",704132,0],["τοῦ",709436,20],["ὑπερέχοντος",713134,294],["τῶν",709436,130],["δέρρεων",703365,65],["ἐκ",704132,0],["τοῦ",709436,20],["μήκους",708868,21],["τῶν",709436,130],["δέρρεων",703365,65],["τῆς",709436,16],["σκηνῆς",711845,17],["ἔσται",704093,93],["συγκαλύπτον",712201,32],["ἐπὶ",705080,0],["τὰ",709436,41],["πλάγια",710493,68],["τῆς",709436,16],["σκηνῆς",711845,17],["ἔνθεν",704732,28],["καὶ",707031,7],["ἔνθεν",704732,28],["ἵνα",706747,7],["καλύπτῃ",707102,204]],"A cubit on this side, and a cubit on that side of that which remains of the skins, of the length of the skins of the tabernacle: it shall be folding over the sides of the tabernacle on this side and that side, that it may cover it."],["14",[["καὶ",707031,7],["ποιήσεις",710582,166],["κατακάλυμμα",707259,25],["τῇ",709436,100],["σκηνῇ",711845,1],["δέρματα",703363,42],["κριῶν",707906,81],["ἠρυθροδανωμένα",705446,437],["καὶ",707031,7],["ἐπικαλύμματα",705154,42],["δέρματα",703363,42],["ὑακίνθινα",713047,68],["ἐπάνωθεν",705032,28]],"And thou shalt make for a covering of the tabernacle rams' skins dyed red, and blue skins as coverings above."],["15",[["καὶ",707031,7],["ποιήσεις",710582,166],["στύλους",712179,57],["τῇ",709436,100],["σκηνῇ",711845,1],["ἐκ",704132,0],["ξύλων",709427,44],["ἀσήπτων",701933,83]],"And thou shalt make the posts of the tabernacle of incorruptible wood."],["16",[["δέκα",703333,59],["πήχεων",710462,81],["ποιήσεις",710582,166],["τὸν",709436,5],["στῦλον",712179,6],["τὸν",709436,5],["ἕνα",704106,27],["καὶ",707031,7],["πήχεος",710462,18],["ἑνὸς",704106,116],["καὶ",707031,7],["ἡμίσους",705998,116],["τὸ",709436,24],["πλάτος",710507,25],["τοῦ",709436,35],["στύλου",712179,18],["τοῦ",709436,35],["ἑνός",704106,116]],"Of ten cubits shalt thou make one post, and the breadth of one post of a cubit and a half."],["17",[["δύο",703849,59],["ἀγκωνίσκους",700167,57],["τῷ",709436,113],["στύλῳ",712179,114],["τῷ",709436,113],["ἑνὶ",704106,30],["ἀντιπίπτοντας",701265,235],["ἕτερον",705535,27],["τῷ",709436,113],["ἑτέρῳ",705535,30],["οὕτως",709859,28],["ποιήσεις",710582,166],["πᾶσι",710177,230],["τοῖς",709436,147],["στύλοις",712179,148],["τῆς",709436,16],["σκηνῆς",711845,17]],"Two joints shalt thou make in one post, answering the one to the other: so shalt thou do to all the posts of the tabernacle."],["18",[["καὶ",707031,7],["ποιήσεις",710582,166],["στύλους",712179,57],["τῇ",709436,100],["σκηνῇ",711845,1],["εἴκοσι",704085,59],["στύλους",712179,57],["ἐκ",704132,0],["τοῦ",709436,20],["κλίτους",707740,21],["τοῦ",709436,20],["πρὸς",710844,0],["βορρᾶν",702765,6]],"And thou shalt make posts to the tabernacle, twenty posts on the north side."],["19",[["καὶ",707031,7],["τεσσαράκοντα",712806,59],["βάσεις",702585,39],["ἀργυρᾶς",701705,119],["ποιήσεις",710582,166],["τοῖς",709436,147],["εἴκοσι",704085,59],["στύλοις",712179,148],["δύο",703849,59],["βάσεις",702585,191],["τῷ",709436,113],["στύλῳ",712179,114],["τῷ",709436,113],["ἑνὶ",704106,30],["εἰς",704105,0],["ἀμφότερα",700892,68],["τὰ",709436,41],["μέρη",708752,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["δύο",703849,59],["βάσεις",702585,191],["τῷ",709436,113],["στύλῳ",712179,114],["τῷ",709436,113],["ἑνὶ",704106,30],["εἰς",704105,0],["ἀμφότερα",700892,68],["τὰ",709436,41],["μέρη",708752,42],["αὐτοῦ",702165,102]],"And thou shalt make to the twenty posts forty silver sockets; two sockets to one post on both its sides, and two sockets to the other post on both its sides."],["20",[["καὶ",707031,7],["τὸ",709436,24],["κλίτος",707740,25],["τὸ",709436,24],["δεύτερον",703389,46],["τὸ",709436,24],["πρὸς",710844,0],["νότον",709364,6],["εἴκοσι",704085,59],["στύλους",712179,57]],"And for the next side, toward the south, twenty posts,"],["21",[["καὶ",707031,7],["τεσσαράκοντα",712806,59],["βάσεις",702585,39],["αὐτῶν",702165,40],["ἀργυρᾶς",701705,119],["δύο",703849,59],["βάσεις",702585,39],["τῷ",709436,113],["στύλῳ",712179,114],["τῷ",709436,113],["ἑνὶ",704106,30],["εἰς",704105,0],["ἀμφότερα",700892,68],["τὰ",709436,41],["μέρη",708752,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["δύο",703849,59],["βάσεις",702585,39],["τῷ",709436,113],["στύλῳ",712179,114],["τῷ",709436,113],["