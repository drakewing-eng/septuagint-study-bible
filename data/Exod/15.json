[["1",[["τότε",712908,28],["ᾖσεν",700299,2],["Μωυσῆς",709112,4],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["τὴν",709436,8],["ᾠδὴν",714091,9],["ταύτην",709858,104],["τῷ",709436,113],["θεῷ",706192,114],["καὶ",707031,7],["εἶπαν",705373,150],["λέγοντες",708124,146],["ᾄσωμεν",700299,79],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐνδόξως",704695,28],["γὰρ",702963,11],["δεδόξασται",703792,187],["ἵππον",706790,9],["καὶ",707031,7],["ἀναβάτην",700909,6],["ἔρριψεν",711267,2],["εἰς",704105,0],["θάλασσαν",706069,9]],"Then sang Moses and the children of Israel this song to God, and spoke, saying, Let us sing to the Lord, for he is very greatly glorified: horse and rider he has thrown into the sea."],["2",[["βοηθὸς",702748,4],["καὶ",707031,7],["σκεπαστὴς",711836,4],["ἐγένετό",703104,23],["μοι",708974,159],["εἰς",704105,0],["σωτηρίαν",712658,9],["οὗτός",709858,121],["μου",709032,133],["θεός",706192,4],["καὶ",707031,7],["δοξάσω",703792,165],["αὐτόν",702165,85],["θεὸς",706192,4],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133],["καὶ",707031,7],["ὑψώσω",713289,165],["αὐτόν",702165,85]],"He was to me a helper and protector for salvation: this is my God, and I will glorify him; my father's God, and I will exalt him."],["3",[["κύριος",707996,4],["συντρίβων",712520,72],["πολέμους",710605,57],["κύριος",707996,4],["ὄνομα",709666,15],["αὐτῷ",702165,50]],"The Lord bringing wars to nought, the Lord [is] his name."],["4",[["ἅρματα",701768,42],["Φαραω",713360,18],["καὶ",707031,7],["τὴν",709436,8],["δύναμιν",703839,9],["αὐτοῦ",702165,102],["ἔρριψεν",711267,2],["εἰς",704105,0],["θάλασσαν",706069,9],["ἐπιλέκτους",705189,60],["ἀναβάτας",700909,57],["τριστάτας",712963,57],["κατεπόντισεν",707385,2],["ἐν",704639,0],["ἐρυθρᾷ",705447,101],["θαλάσσῃ",706069,1]],"He has cast the chariots of Pharao and his host into the sea, the chosen mounted captains: they were swallowed up in the Red Sea."],["5",[["πόντῳ",710664,114],["ἐκάλυψεν",707102,2],["αὐτούς",702165,62],["κατ