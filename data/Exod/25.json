[["1",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["2",[["εἰπὸν",705373,176],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["καὶ",707031,7],["λάβετέ",708076,74],["μοι",708974,159],["ἀπαρχὰς",701359,39],["παρὰ",709995,0],["πάντων",710177,169],["οἷς",709781,311],["ἂν",700900,11],["δόξῃ",703775,172],["τῇ",709436,100],["καρδίᾳ",707141,1],["καὶ",707031,7],["λήμψεσθε",708076,124],["τὰς",709436,38],["ἀπαρχάς",701359,39],["μου",709032,133]],"Speak to the children of Israel, and take first-fruits of all, who may be disposed in their heart to give; and ye shall take my first-fruits."],["3",[["καὶ",707031,7],["αὕτη",709858,107],["ἐστὶν",704093,91],["ἡ",709436,10],["ἀπαρχή",701359,12],["ἣν",709781,131],["λήμψεσθε",708076,124],["παρ᾿",709995,0],["αὐτῶν",702165,40],["χρυσίον",713972,25],["καὶ",707031,7],["ἀργύριον",701707,25],["καὶ",707031,7],["χαλκὸν",713695,6]],"And this is the offering which ye shall take of them; gold and silver and brass,"],["4",[["καὶ",707031,7],["ὑάκινθον",713048,9],["καὶ",707031,7],["πορφύραν",710682,9],["καὶ",707031,7],["κόκκινον",707783,27],["διπλοῦν",703740,27],["καὶ",707031,7],["βύσσον",702834,9],["κεκλωσμένην",707746,436],["καὶ",707031,7],["τρίχας",706312,39],["αἰγείας",700395,119]],"and blue, and purple, and double scarlet, and fine spun linen, and goats' hair,"],["5",[["καὶ",707031,7],["δέρματα",703363,42],["κριῶν",707906,81],["ἠρυθροδανωμένα",705446,437],["καὶ",707031,7],["δέρματα",703363,42],["ὑακίνθινα",713047,68],["καὶ",707031,7],["ξύλα",709427,42],["ἄσηπτα",701933,68]],"and rams' skins dyed red, and blue skins, and incorruptible wood,"],["7",[["καὶ",707031,7],["λίθους",708196,57],["σαρδίου",711525,21],["καὶ",707031,7],["λίθους",708196,57],["εἰς",704105,0],["τὴν",709436,8],["γλυφὴν",703118,9],["εἰς",704105,0],["τὴν",709436,8],["ἐπωμίδα",705374,9],["καὶ",707031,7],["τὸν",709436,5],["ποδήρη",710577,27]],"and sardius stones, and stones for the carved work of the breast-plate, and the full-length robe."],["8",[["καὶ",707031,7],["ποιήσεις",710582,166],["μοι",708974,159],["ἁγίασμα",700154,25],["καὶ",707031,7],["ὀφθήσομαι",709725,180],["ἐν",704639,0],["ὑμῖν",713084,90]],"And thou shalt make me a sanctuary, and I will appear among you."],["9",[["καὶ",707031,7],["ποιήσεις",710582,166],["μοι",708974,159],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἐγώ",704018,164],["σοι",711925,159],["δεικνύω",703314,438],["ἐν",704639,0],["τῷ",709436,53],["ὄρει",709768,54],["τὸ",709436,24],["παράδειγμα",710008,25],["τῆς",709436,16],["σκηνῆς",711845,17],["καὶ",707031,7],["τὸ",709436,24],["παράδειγμα",710008,25],["πάντων",710177,169],["τῶν",709436,130],["σκευῶν",711844,44],["αὐτῆς",702165,86],["οὕτω",709859,28],["ποιήσεις",710582,166]],"And thou shalt make for me according to all things which I shew thee in the mountain; even the pattern of the tabernacle, and the pattern of all its furniture: so shalt thou make it."],["10",[["καὶ",707031,7],["ποιήσεις",710582,166],["κιβωτὸν",707667,9],["μαρτυρίου",708525,21],["ἐκ",704132,0],["ξύλων",709427,44],["ἀσήπτων",701933,83],["δύο",703849,59],["πήχεων",710462,81],["καὶ",707031,7],["ἡμίσους",705998,92],["τὸ",709436,24],["μῆκος",708868,25],["καὶ",707031,7],["πήχεος",710462,18],["καὶ",707031,7],["ἡμίσους",705998,92],["τὸ",709436,24],["πλάτος",710507,25],["καὶ",707031,7],["πήχεος",710462,18],["καὶ",707031,7],["ἡμίσους",705998,92],["τὸ",709436,24],["ὕψος",713288,25]],"And thou shalt make the ark of testimony of incorruptible wood; the length of two cubits and a half, and the breadth of a cubit and a half, and the height of a cubit and a half."],["11",[["καὶ",707031,7],["καταχρυσώσεις",707496,166],["αὐτὴν",702165,104],["χρυσίῳ",713972,54],["καθαρῷ",706988,97],["ἔξωθεν",704984,28],["καὶ",707031,7],["ἔσωθεν",705523,28],["χρυσώσεις",713980,166],["αὐτήν",702165,104],["καὶ",707031,7],["ποιήσεις",710582,166],["αὐτῇ",702165,105],["κυμάτια",707970,42],["στρεπτὰ",712158,68],["χρυσᾶ",713971,68],["κύκλῳ",707959,114]],"And thou shalt gild it with pure gold, thou shalt gild it within and without; and thou shalt make for it golden wreaths twisted round about."],["12",[["καὶ",707031,7],["ἐλάσεις",704397,166],["αὐτῇ",702165,105],["τέσσαρας",712808,60],["δακτυλίους",703258,57],["χρυσοῦς",713971,60],["καὶ",707031,7],["ἐπιθήσεις",705304,166],["ἐπὶ",705080,0],["τὰ",709436,41],["τέσσαρα",712808,68],["κλίτη",707740,42],["δύο",703849,59],["δακτυλίους",703258,57],["ἐπὶ",705080,0],["τὸ",709436,24],["κλίτος",707740,25],["τὸ",709436,24],["ἓν",704106,46],["καὶ",707031,7],["δύο",703849,59],["δακτυλίους",703258,57],["ἐπὶ",705080,0],["τὸ",709436,24],["κλίτος",707740,25],["τὸ",709436,24],["δεύτερον",703389,46]],"And thou shalt cast for it four golden rings, and shalt put them on the four sides; two rings on the one side, and two rings on the other side."],["13",[["ποιήσεις",710582,166],["δὲ",703303,11],["ἀναφορεῖς",701086,57],["ξύλα",709427,42],["ἄσηπτα",701933,68],["καὶ",707031,7],["καταχρυσώσεις",707496,166],["αὐτὰ",702165,71],["χρυσίῳ",713972,54]],"And thou shalt make staves [of] incorruptible wood, and shalt gild them with gold."],["14",[["καὶ",707031,7],["εἰσάξεις",704107,166],["τοὺς",709436,58],["ἀναφορεῖς",701086,57],["εἰς",704105,0],["τοὺς",709436,58],["δακτυλίους",703258,57],["τοὺς",709436,58],["ἐν",704639,0],["τοῖς",709436,95],["κλίτεσι",707740,96],["τῆς",709436,16],["κιβωτοῦ",707667,17],["αἴρειν",700473,55],["τὴν",709436,8],["κιβωτὸν",707667,9],["ἐν",704639,0],["αὐτοῖς",702165,151]],"And thou shalt put the staves into the rings on the sides of the ark, to bear the ark with them."],["15",[["ἐν",704639,0],["τοῖς",709436,147],["δακτυλίοις",703258,148],["τῆς",709436,16],["κιβωτοῦ",707667,17],["ἔσονται",704093,135],["οἱ",709436,136],["ἀναφορεῖς",701086,52],["ἀκίνητοι",700545,138]],"The staves shall remain fixed in the rings of the ark."],["16",[["καὶ",707031,7],["ἐμβαλεῖς",704547,166],["εἰς",704105,0],["τὴν",709436,8],["κιβωτὸν",707667,9],["τὰ",709436,41],["μαρτύρια",708525,42],["ἃ",709781,69],["ἂν",700900,11],["δῶ",703654,207],["σοι",711925,159]],"And thou shalt put into the ark the testimonies which I shall give thee."],["17",[["καὶ",707031,7],["ποιήσεις",710582,166],["ἱλαστήριον",706730,25],["ἐπίθεμα",705137,25],["χρυσίου",713972,21],["καθαροῦ",706988,92],["δύο",703849,59],["πήχεων",710462,81],["καὶ",707031,7],["ἡμίσους",705998,92],["τὸ",709436,24],["μῆκος",708868,25],["καὶ",707031,7],["πήχεος",710462,18],["καὶ",707031,7],["ἡμίσους",705998,92],["τὸ",709436,24],["πλάτος",710507,25]],"And thou shalt make a propitiatory, a lid of pure gold; the length of two cubits and a half, and the breadth of a cubit and a half."],["18",[["καὶ",707031,7],["ποιήσεις",710582,166],["δύο",703849,59],["χερουβιμ",713830,42],["χρυσᾶ",713971,68],["τορευτὰ",712904,68],["καὶ",707031,7],["ἐπιθήσεις",705304,166],["αὐτὰ",702165,71],["ἐξ",704132,0],["ἀμφοτέρων",700892,83],["τῶν",709436,43],["κλιτῶν",707740,44],["τοῦ",709436,20],["ἱλαστηρίου",706730,21]],"And thou shalt make two cherubs graven in gold, and thou shalt put them on both sides of the propitiatory."],["19",[["ποιηθήσονται",710582,144],["χερουβ",713830,4],["εἷς",704106,14],["ἐκ",704132,0],["τοῦ",709436,20],["κλίτους",707740,21],["τούτου",709858,49],["καὶ",707031,7],["χερουβ",713830,6],["εἷς",704106,14],["ἐκ",704132,0],["τοῦ",709436,20],["κλίτους",707740,21],["τοῦ",709436,20],["δευτέρου",703389,92],["τοῦ",709436,20],["ἱλαστηρίου",706730,21],["καὶ",707031,7],["ποιήσεις",710582,166],["τοὺς",709436,58],["δύο",703849,59],["χερουβιμ",713830,57],["ἐπὶ",705080,0],["τὰ",709436,41],["δύο",703849,59],["κλίτη",707740,42]],"They shall be made, one cherub on this side, and another cherub on the other side of the propitiatory; and thou shalt make the two cherubs on the two sides."],["20",[["ἔσονται",704093,135],["οἱ",709436,136],["χερουβιμ",713830,52],["ἐκτείνοντες",704322,146],["τὰς",709436,38],["πτέρυγας",711057,39],["ἐπάνωθεν",705032,28],["συσκιάζοντες",712549,146],["ταῖς",709436,75],["πτέρυξιν",711057,76],["αὐτῶν",702165,40],["ἐπὶ",705080,0],["τοῦ",709436,20],["ἱλαστηρίου",706730,21],["καὶ",707031,7],["τὰ",709436,63],["πρόσωπα",710986,64],["αὐτῶν",702165,40],["εἰς",704105,0],["ἄλληλα",700689,71],["εἰς",704105,0],["τὸ",709436,24],["ἱλαστήριον",706730,25],["ἔσονται",704093,135],["τὰ",709436,41],["πρόσωπα",710986,42],["τῶν",709436,80],["χερουβιμ",713830,81]],"The cherubs shall stretch forth their wings above, overshadowing the propitiatory with their wings; and their faces shall be toward each other, the faces of the cherubs shall be toward the propitiatory."],["21",[["καὶ",707031,7],["ἐπιθήσεις",705304,166],["τὸ",709436,24],["ἱλαστήριον",706730,25],["ἐπὶ",705080,0],["τὴν",709436,8],["κιβωτὸν",707667,9],["ἄνωθεν",701298,28],["καὶ",707031,7],["εἰς",704105,0],["τὴν",709436,8],["κιβωτὸν",707667,9],["ἐμβαλεῖς",704547,166],["τὰ",709436,41],["μαρτύρια",708525,42],["ἃ",709781,69],["ἂν",700900,11],["δῶ",703654,207],["σοι",711925,159]],"And thou shalt set the propitiatory on the ark above, and thou shalt put into the ark the testimonies which I shall give thee."],["22",[["καὶ",707031,7],["γνωσθήσομαί",703105,180],["σοι",711925,159],["ἐκεῖθεν",704182,28],["καὶ",707031,7],["λαλήσω",708071,207],["σοι",711925,159],["ἄνωθεν",701298,28],["τοῦ",709436,20],["ἱλαστηρίου",706730,21],["ἀνὰ",700902,0],["μέσον",708768,46],["τῶν",709436,80],["δύο",703849,59],["χερουβιμ",713830,81],["τῶν",709436,80],["ὄντων",704093,170],["ἐπὶ",705080,0],["τῆς",709436,16],["κιβωτοῦ",707667,17],["τοῦ",709436,20],["μαρτυρίου",708525,21],["καὶ",707031,7],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἂν",700900,11],["ἐντείλωμαί",704791,410],["σοι",711925,159],["πρὸς",710844,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ισραηλ",706839,18]],"And I will make myself known to thee from thence, and I will speak to thee above the propitiatory between the two cherubs, which are upon the ark of testimony, even in all things which I shall charge thee concerning the children of Israel."],["2