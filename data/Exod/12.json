[["1",[["εἶπεν",705373,2],["δὲ",703303,11],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["καὶ",707031,7],["Ααρων",700005,6],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτου",700401,17],["λέγων",708124,72]],"And the Lord spoke to Moses and Aaron in the land of Egypt, saying,"],["2",[["ὁ",709436,3],["μὴν",708874,4],["οὗτος",709858,121],["ὑμῖν",713084,90],["ἀρχὴ",701836,12],["μηνῶν",708874,81],["πρῶτός",711041,140],["ἐστιν",704093,91],["ὑμῖν",713084,90],["ἐν",704639,0],["τοῖς",709436,147],["μησὶν",708874,148],["τοῦ",709436,35],["ἐνιαυτοῦ",704745,18]],"This month [shall be] to you the beginning of months: it is the first to you among the months of the year."],["3",[["λάλησον",708071,176],["πρὸς",710844,0],["πᾶσαν",710177,36],["συναγωγὴν",712376,9],["υἱῶν",713075,81],["Ισραηλ",706839,18],["λέγων",708124,72],["τῇ",709436,100],["δεκάτῃ",703343,101],["τοῦ",709436,35],["μηνὸς",708874,18],["τούτου",709858,102],["λαβέτωσαν",708076,264],["ἕκαστος",704133,14],["πρόβατον",710768,25],["κατ᾿",707200,0],["οἴκους",709516,57],["πατριῶν",710195,169],["ἕκαστος",704133,14],["πρόβατον",710768,25],["κατ᾿",707200,0],["οἰκίαν",709505,9]],"Speak to all the congregation of the children of Israel, saying, On the tenth of this month let them take each man a lamb according to the houses of their families, every man a lamb for his household."],["4",[["ἐὰν",703912,7],["δὲ",703303,11],["ὀλιγοστοὶ",709569,138],["ὦσιν",704093,271],["οἱ",709436,136],["ἐν",704639,0],["τῇ",709436,100],["οἰκίᾳ",709505,1],["ὥστε",714164,7],["μὴ",708851,28],["ἱκανοὺς",706710,60],["εἶναι",704093,55],["εἰς",704105,0],["πρόβατον",710768,25],["συλλήμψεται",712262,93],["μεθ᾿",708780,0],["ἑαυτοῦ",703917,102],["τὸν",709436,5],["γείτονα",703016,6],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102],["κατὰ",707200,0],["ἀριθμὸν",701744,6],["ψυχῶν",714070,65],["ἕκαστος",704133,14],["τὸ",709436,24],["ἀρκοῦν",701765,47],["αὐτῷ",702165,50],["συναριθμήσεται",712405,93],["εἰς",704105,0],["πρόβατον",710768,25]],"And if they be few in a household, so that there are not enough for the lamb, he shall take with himself his neighbour that lives near to him,—as to the number of souls, every one according to that which suffices him shall make a reckoning for the lamb."],["5",[["πρόβατον",710768,15],["τέλειον",712769,26],["ἄρσεν",701818,26],["ἐνιαύσιον",704744,26],["ἔσται",704093,93],["ὑμῖν",713084,90],["ἀπὸ",701425,0],["τῶν",709436,80],["ἀρνῶν",701731,81],["καὶ",707031,7],["τῶν",709436,80],["ἐρίφων",705429,81],["λήμψεσθε",708076,124]],"It shall be to you a lamb unblemished, a male of a year old: ye shall take it of the lambs and the kids."],["6",[["καὶ",707031,7],["ἔσται",704093,93],["ὑμῖν",713084,90],["διατετηρημένον",703607,413],["ἕως",705792,0],["τῆς",709436,16],["τεσσαρεσκαιδεκάτης",712809,82],["τοῦ",709436,35],["μηνὸς",708874,18],["τούτου",709858,102],["καὶ",707031,7],["σφάξουσιν",712571,218],["αὐτὸ",702165,129],["πᾶν",710177,46],["τὸ",709436,24],["πλῆθος",710529,25],["συναγωγῆς",712376,17],["υἱῶν",713075,81],["Ισραηλ",706839,18],["πρὸς",710844,0],["ἑσπέραν",705500,9]],"And it shall be kept by you till the fourteenth of this month, and all the multitude of the congregation of the children of Israel shall kill it toward evening."],["7",[["καὶ",707031,7],["λήμψονται",708076,135],["ἀπὸ",701425,0],["τοῦ",709436,20],["αἵματος",700442,21],["καὶ",707031,7],["θήσουσιν",712849,218],["ἐπὶ",705080,0],["τῶν",709436,80],["δύο",703849,59],["σταθμῶν",712040,81],["καὶ",707031,7],["ἐπὶ",705080,0],["τὴν",709436,8],["φλιὰν",713520,9],["ἐν",704639,0],["τοῖς",709436,147],["οἴκοις",709516,148],["ἐν",704639,0],["οἷς",709781,311],["ἐὰν",703912,7],["φάγωσιν",713296,234],["αὐτὰ",702165,71],["ἐν",704639,0],["αὐτοῖς",702165,151]],"And they shall take of the blood, and shall put it on the two door-posts, and on the lintel, in the houses in which soever they shall eat them."],["8",[["καὶ",707031,7],["φάγονται",713296,135],["τὰ",709436,41],["κρέα",707889,42],["τῇ",709436,100],["νυκτὶ",709386,1],["ταύτῃ",709858,105],["ὀπτὰ",709716,68],["πυρὶ",711088,54],["καὶ",707031,7],["ἄζυμα",700345,68],["ἐπὶ",705080,0],["πικρίδων",710474,65],["ἔδονται",705495,135]],"And they shall eat the flesh in this night roast with fire, and they shall eat unleavened [bread] with bitter herbs."],["9",[["οὐκ",709805,28],["ἔδεσθε",705495,124],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["ὠμὸν",714114,6],["οὐδὲ",709816,7],["ἡψημένον",705788,414],["ἐν",704639,0],["ὕδατι",713071,54],["ἀλλ᾿",700680,7],["ἢ",705924,7],["ὀπτὰ",709716,68],["πυρί",711088,54],["κεφαλὴν",707639,9],["σὺν",712372,0],["τοῖς",709436,147],["ποσὶν",710707,148],["καὶ",707031,7],["τοῖς",709436,95],["ἐνδοσθίοις",704696,96]],"Ye shall not eat of it raw nor sodden in water, but only roast with fire, the head with the feet and the appurtenances."],["10",[["οὐκ",709805,28],["ἀπολείψετε",701508,337],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["ἕως",705792,0],["πρωὶ",711021,28],["καὶ",707031,7],["ὀστοῦν",709792,25],["οὐ",709805,28],["συντρίψετε",712520,337],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["τὰ",709436,41],["δὲ",703303,11],["καταλειπόμενα",707305,67],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["ἕως",705792,0],["πρωὶ",711021,28],["ἐν",704639,0],["πυρὶ",711088,54],["κατακαύσετε",707258,337]],"Nothing shall be left of it till the morning, and a bone of it ye shall not break; but that which is left of it till the morning ye shall burn with fire."],["11",[["οὕτως",709859,28],["δὲ",703303,11],["φάγεσθε",705495,124],["αὐτό",702165,129],["αἱ",709436,190],["ὀσφύες",709800,191],["ὑμῶν",713091,145],["περιεζωσμέναι",710317,415],["καὶ",707031,7],["τὰ",709436,41],["ὑποδήματα",713195,42],["ἐν",704639,0],["τοῖς",709436,147],["ποσὶν",710707,148],["ὑμῶν",713091,145],["καὶ",707031,7],["αἱ",709436,190],["βακτηρίαι",702459,191],["ἐν",704639,0],["ταῖς",709436,75],["χερσὶν",713787,76],["ὑμῶν",713091,145],["καὶ",707031,7],["ἔδεσθε",705495,124],["αὐτὸ",702165,129],["μετὰ",708780,0],["σπουδῆς",712035,17],["πασχα",710182,15],["ἐστὶν",704093,91],["κυρίῳ",707996,114]],"And thus shall ye eat it: your loins girded, and your sandals on your feet, and your staves in your hands, and ye shall eat it in haste. It is a passover to the Lord."],["12",[["καὶ",707031,7],["διελεύσομαι",703673,181],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτῳ",700401,1],["ἐν",704639,0],["τῇ",709436,100],["νυκτὶ",709386,1],["ταύτῃ",709858,105],["καὶ",707031,7],["πατάξω",710185,165],["πᾶν",710177,27],["πρωτότοκον",711046,27],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτῳ",700401,1],["ἀπὸ",701425,0],["ἀνθρώπου",701163,18],["ἕως",705792,0],["κτήνους",707934,21],["καὶ",707031,7],["ἐν",704639,0],["πᾶσι",710177,230],["τοῖς",709436,147],["θεοῖς",706192,148],["τῶν",709436,80],["Αἰγυπτίων",700400,81],["ποιήσω",710582,207],["τὴν",709436,8],["ἐκδίκησιν",704175,9],["ἐγὼ",704018,164],["κύριος",707996,4]],"And I will go through the land of Egypt in that night, and will smite every first-born in the land of Egypt both man and beast, and on all the gods of Egypt will I execute vengeance: I [am] the Lord."],["13",[["καὶ",707031,7],["ἔσται",704093,93],["τὸ",709436,34],["αἷμα",700442,15],["ὑμῖν",713084,90],["ἐν",704639,0],["σημείῳ",711748,54],["ἐπὶ",705080,0],["τῶν",709436,130],["οἰκιῶν",709505,65],["ἐν",704639,0],["αἷς",709781,281],["ὑμεῖς",713081,219],["ἐστε",704093,87],["ἐκεῖ",704181,28],["καὶ",707031,7],["ὄψομαι",709725,181],["τὸ",709436,24],["αἷμα",700442,25],["καὶ",707031,7],["σκεπάσω",711832,207],["ὑμᾶς",713080,194],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ἐν",704639,0],["ὑμῖν",713084,90],["πληγὴ",710527,12],["τοῦ",709436,20],["ἐκτριβῆναι",704345,179],["ὅταν",709801,28],["παίω",709933,157],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτῳ",700401,1]],"And the blood shall be for a sign to you on the houses in which ye are, and I will see the blood, and will protect you, and there shall not be on you the plague of destruction, when I smite in the land of Egypt."],["14",[["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["ἡμέρα",705984,12],["ὑμῖν",713084,90],["αὕτη",709858,107],["μνημόσυνον",708966,15],["καὶ",707031,7],["ἑορτάσετε",704988,337],["αὐτὴν",702165,104],["ἑορτὴν",704990,9],["κυρίῳ",707996,114],["εἰς",704105,0],["πάσας",710177,119],["τὰς",709436,38],["γενεὰς",703037,39],["ὑμῶν",713091,145],["νόμιμον",709340,46],["αἰώνιον",700505,46],["ἑορτάσετε",704988,337],["αὐτήν",702165,104]],"And this day shall be to you a memorial, and ye shall keep it a feast to the Lord through all your generations; ye shall keep it a feast for a perpetual ordinance."],["15",[["ἑπτὰ",705357,59],["ἡμέρας",705984,39],["ἄζυμα",700345,68],["ἔδεσθε",705495,124],["ἀπὸ",701425,0],["δὲ",703303,11],["τῆς",709436,16],["ἡμέρας",705984,17],["τῆς",709436,16],["πρώτης",711041,416],["ἀφανιεῖτε",702182,337],["ζύμην",705897,9],["ἐκ",704132,0],["τῶν",709436,130],["οἰκιῶν",709505,65],["ὑμῶν",713091,145],["πᾶς",710177,14],["ὃς",709781,213],["ἂν",700900,11],["φάγῃ",713296,123],["ζύμην",705897,9],["ἐξολεθρευθήσεται",704956,134],["ἡ",709436,10],["ψυχὴ",714070,12],["ἐκείνη",704183,107],["ἐξ",704132,0],["Ισραηλ",706839,18],["ἀπὸ",701425,0],["τῆς",709436,16],["ἡμέρας",705984,17],["τῆς",709436,16],["πρώτης",711041,416],["ἕως",705792,0],["τῆς",709436,16],["ἡμέρας",705984,17],["τῆς",709436,16],["ἑβδόμης",703925,82]],"Seven days ye shall eat unleavened bread, and from the first day ye shall utterly remove leaven from your houses: whoever shall eat leaven, that soul shall be utterly destroyed from Israel, from the first day until the seventh day."],["16",[["καὶ",707031,7],["ἡ",709436,10],["ἡμέρα",705984,12],["ἡ",709436,10],["πρώτη",711041,417],["κληθήσεται",707084,134],["ἁγία",700159,68],["καὶ",707031,7],["ἡ",709436,10],["ἡμέρα",705984,12],["ἡ",709436,10],["ἑβδόμη",703925,29],["κλητὴ",707732,29],["ἁγία",700159,29],["ἔσται",704093,93],["ὑμῖν",713084,90],["πᾶν",710177,46],["ἔργον",705396,25],["λατρευτὸν",708107,46],["οὐ",709805,28],["ποιήσετε",710582,337],["ἐν",704639,0],["αὐταῖς",702165,200],["πλὴν",710540,28],["ὅσα",709788,68],["ποιηθήσεται",710582,134],["πάσῃ",710177,101],["ψυχῇ",714070,1],["τοῦτο",709858,129],["μόνον",709001,28],["ποιηθήσεται",710582,134],["ὑμῖν",713084,90]],"And the first day shall be called holy, and the seventh day shall be a holy convocation to you: ye shall do no servile work on them, only as many things as will [necessarily] be done by every soul, this only shall be done by you."],["17",[["καὶ",707031,7],["φυλάξεσθε",713619,124],["τὴν",709436,8],["ἐντολὴν",704802,9],["ταύτην",709858,104],["ἐν",704639,0],["γὰρ",702963,11],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ταύτῃ",709858,105],["ἐξάξω",704834,165],["τὴν",709436,8],["δύναμιν",703839,9],["ὑμῶν",713091,145],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ποιήσετε",710582,337],["τὴν",709436,8],["ἡμέραν",705984,9],["ταύτην",709858,104],["εἰς",704105,0],["γενεὰς",703037,39],["ὑμῶν",713091,145],["νόμιμον",709340,46],["αἰώνιον",700505,46]],"And ye shall keep this commandment, for on this day will I bring out your force out of the land of Egypt; and ye shall make this day a perpetual ordinance for you throughout your generations."],["18",[["ἐναρχομένου",704664,262],["τῇ",709436,100],["τεσσαρεσκαιδεκάτῃ",712809,101],["ἡμέρᾳ",705984,1],["τοῦ",709436,35],["μηνὸς",708874,18],["τοῦ",709436,35],["πρώτου",711041,216],["ἀφ᾿",701425,0],["ἑσπέρας",705500,17],["ἔδεσθε",705495,124],["ἄζυμα",700345,68],["ἕως",705792,0],["ἡμέρας",705984,17],["μιᾶς",704106,82],["καὶ",707031,7],["εἰκάδος",704082,17],["τοῦ",709436,35],["μηνὸς",708874,18],["ἕως",705792,0],["ἑσπέρας",705500,17]],"Beginning the fourteenth day of the first month, ye shall eat unleavened bread from evening, till the twenty-first day of the month, till evening."],["19",[["ἑπτὰ",705357,59],["ἡμέρας",705984,17],["ζύμη",705897,12],["οὐχ",709805,28],["εὑρεθήσεται",705676,134],["ἐν",704639,0],["ταῖς",709436,75],["οἰκίαις",709505,76],["ὑμῶν",713091,145],["πᾶς",710177,14],["ὃς",709781,213],["ἂν",700900,11],["φάγῃ",713296,123],["ζυμωτόν",705901,46],["ἐξολεθρευθήσεται",704956,134],["ἡ",709436,10],["ψυχὴ",714070,12],["ἐκείνη",704183,107],["ἐκ",704132,0],["συναγωγῆς",712376,17],["Ισραηλ",706839,18],["ἔν",704639,0],["τε",712751,11],["τοῖς",709436,147],["γειώραις",703017,148],["καὶ",707031,7],["αὐτόχθοσιν",702168,230],["τῆς",709436,16],["γῆς",703083,17]],"Seven days leaven shall not be found in your houses; whosoever shall eat anything leavened, that soul shall be cut off from the congregation of Israel, both among the occupiers of the land and the original inhabitants."],["20",[["πᾶν",710177,46],["ζυμωτὸν",705901,46],["οὐκ",709805,28],["ἔδεσθε",705495,124],["ἐν",704639,0],["παντὶ",710177,97],["δὲ",703303,11],["κατοικητηρίῳ",707536,54],["ὑμῶν",713091,145],["ἔδεσθε",705495,124],["ἄζυμα",700345,68]],"Ye shall eat nothing leavened, but in every habitation of yours ye shall eat unleavened bread."],["21",[["ἐκάλεσεν",707084,2],["δὲ",703303,11],["Μωυσῆς",709112,4],["πᾶσαν",710177,36],["γερουσίαν",703063,9],["υἱῶν",713075,81],["Ισραηλ",706839,18],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτούς",702165,62],["ἀπελθόντες",701398,196],["λάβετε",708076,74],["ὑμῖν",713084,90],["ἑαυτοῖς",703917,151],["πρόβατον",710768,25],["κατὰ",707200,0],["συγγενείας",712184,39],["ὑμῶν",713091,145],["καὶ",707031,7],["θύσατε",706349,74],["τὸ",709436,24],["πασχα",710182,25]],"And Moses called all the elders of the children of Israel, and said to them, Go away and take to yourselves a lamb according to your kindreds, and slay the passover."],["22",[["λήμψεσθε",708076,124],["δὲ",703303,11],["δέσμην",703370,9],["ὑσσώπου",713269,17],["καὶ",707031,7],["βάψαντες",702517,196],["ἀπὸ",701425,0],["τοῦ",709436,20],["αἵματος",700442,21],["τοῦ",709436,20],["παρὰ",709995,0],["τὴν",709436,8],["θύραν",706337,9],["καθίξετε",707002,337],["τῆς",709436,16],["φλιᾶς",713520,17],["καὶ",707031,7],["ἐπ᾿",705080,0],["ἀμφοτέρων",700892,169],["τῶν",709436,80],["σταθμῶν",712040,81],["ἀπὸ",701425,0],["τοῦ",709436,20],["αἵματος",700442,21],["ὅ",709781,33],["ἐστιν",704093,91],["παρὰ",709995,0],["τὴν",709436,8],["θύραν",706337,9],["ὑμεῖς",713081,219],["δὲ",703303,11],["οὐκ",709805,28],["ἐξελεύσεσθε",704909,124],["ἕκαστος",704133,14],["τὴν",709436,8],["θύραν",706337,9],["τοῦ",709436,35],["οἴκου",709516,18],["αὐτοῦ",702165,102],["ἕως",705792,0],["πρωί",711021,28]],"And ye shall take a bunch of hyssop, and having dipped it into some of the blood that is by the door, ye shall touch the lintel, and [shall put it] upon both door-posts, even of the blood which is by the door; but ye shall not go out every one from the door of his house till the morning."],["23",[["καὶ",707031,7],["παρελεύσεται",710141,93],["κύριος",707996,4],["πατάξαι",710185,106],["τοὺς",709436,58],["Αἰγυπτίους",700400,57],["καὶ",707031,7],["ὄψεται",709725,93],["τὸ",709436,24],["αἷμα",700442,25],["ἐπὶ",705080,0],["τῆς",709436,16],["φλιᾶς",713520,17],["καὶ",707031,7],["ἐπ᾿",705080,0],["ἀμφοτέρων",700892,169],["τῶν",709436,80],["σταθμῶν",712040,81],["καὶ",707031,7],["παρελεύσεται",710141,93],["κύριος",707996,4],["τὴν",709436,8],["θύραν",706337,9],["καὶ",707031,7],["οὐκ",709805,28],["ἀφήσει",702211,127],["τὸν",709436,5],["ὀλεθρεύοντα",709560,183],["εἰσελθεῖν",704114,106],["εἰς",704105,0],["τὰς",709436,38],["οἰκίας",709505,39],["ὑμῶν",713091,145],["πατάξαι",710185,106]],"And the Lord shall pass by to smite the Egyptians, and shall see the blood upon the lintel, and upon both the door-posts; and the Lord shall pass by the door, and shall not suffer the destroyer to enter into your houses to smite [you]."],["24",[["καὶ",707031,7],["φυλάξεσθε",713619,124],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["νόμιμον",709340,46],["σεαυτῷ",711599,50],["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["σου",711945,133],["ἕως",705792,0],["αἰῶνος",700504,18]],"And keep ye this thing as an ordinance for thyself and for thy children for ever."],["25",[["ἐὰν",703912,7],["δὲ",703303,11],["εἰσέλθητε",704114,125],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["ἂν",700900,11],["δῷ",703654,172],["κύριος",707996,4],["ὑμῖν",713084,90],["καθότι",707021,28],["ἐλάλησεν",708071,2],["φυλάξεσθε",713619,124],["τὴν",709436,8],["λατρείαν",708106,9],["ταύτην",709858,104]],"And if ye should enter into the land, which the Lord shall give you, as he has spoken, keep this service."],["26",[["καὶ",707031,7],["ἔσται",704093,93],["ἐὰν",703912,7],["λέγωσιν",708124,271],["πρὸς",710844,0],["ὑμᾶς",713080,194],["οἱ",709436,136],["υἱοὶ",713075,52],["ὑμῶν",713091,145],["τίς",712867,359],["ἡ",709436,10],["λατρεία",708106,12],["αὕτη",709858,107]],"And it shall come to pass, if your sons say to you, What is this service?"],["27",[["καὶ",707031,7],["ἐρεῖτε",705415,337],["αὐτοῖς",702165,151],["θυσία",706345,12],["τὸ",709436,34],["πασχα",710182,15],["τοῦτο",709858,132],["κυρίῳ",707996,114],["ὡς",714148,7],["ἐσκέπασεν",711832,2],["τοὺς",709436,58],["οἴκους",709516,57],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ἐν",704639,0],["Αἰγύπτῳ",700401,1],["ἡνίκα",706008,28],["ἐπάταξεν",710185,2],["τοὺς",709436,58],["Αἰγυπτίους",700400,57],["τοὺς",709436,58],["δὲ",703303,11],["οἴκους",709516,57],["ἡμῶν",705999,145],["ἐρρύσατο",711309,23],["καὶ",707031,7],["κύψας",707989,182],["ὁ",709436,3],["λαὸς",708094,4],["προσεκύνησεν",710925,2]],"that ye shall say to them, This passover is a sacrifice to the Lord, as he defended the houses of the children of Israel in Egypt, when he smote the Egyptians, but delivered our houses."],["28",[["καὶ",707031,7],["ἀπελθόντες",701398,196],["ἐποίησαν",710582,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["καθὰ",706979,28],["ἐνετείλατο",704791,23],["κύριος",707996,4],["τῷ",709436,113],["Μωυσῇ",709112,114],["καὶ",707031,7],["Ααρων",700005,114],["οὕτως",709859,28],["ἐποίησαν",710582,150]],"And the people bowed and worshipped. And the children of Israel departed and did as the Lord commanded Moses and Aaron, so did they."],["29",[["ἐγενήθη",703104,37],["δὲ",703303,11],["μεσούσης",708771,222],["τῆς",709436,16],["νυκτὸς",709386,17],["καὶ",707031,7],["κύριος",707996,4],["ἐπάταξεν",710185,2],["πᾶν",710177,46],["πρωτότοκον",711046,46],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτῳ",700401,1],["ἀπὸ",701425,0],["πρωτοτόκου",711046,92],["Φαραω",713360,18],["τοῦ",709436,35],["καθημένου",707000,262],["ἐπὶ",705080,0],["τοῦ",709436,35],["θρόνου",706315,18],["ἕως",705792,0],["πρωτοτόκου",711046,92],["τῆς",709436,16],["αἰχμαλωτίδος",700502,17],["τῆς",709436,16],["ἐν",704639,0],["τῷ",709436,113],["λάκκῳ",708067,114],["καὶ",707031,7],["ἕως",705792,0],["πρωτοτόκου",711046,92],["παντὸς",710177,92],["κτήνους",707934,21]],"And it came to pass at midnight that the Lord smote all the first-born in the land of Egypt, from the first-born of Pharao that sat on the throne, to the first-born of the captive-maid in the dungeon, and the first-born of all cattle."],["30",[["καὶ",707031,7],["ἀναστὰς",701173,182],["Φαραω",713360,4],["νυκτὸς",709386,17],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["θεράποντες",706201,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["Αἰγύπτιοι",700400,52],["καὶ",707031,7],["ἐγενήθη",703104,37],["κραυγὴ",707886,12],["μεγάλη",708653,29],["ἐν",704639,0],["πάσῃ",710177,101],["γῇ",703083,1],["Αἰγύπτῳ",700401,1],["οὐ",709805,28],["γὰρ",702963,11],["ἦν",704093,13],["οἰκία",709505,12],["ἐν",704639,0],["ᾗ",709781,108],["οὐκ",709805,28],["ἦν",704093,13],["ἐν",704639,0],["αὐτῇ",702165,105],["τεθνηκώς",706278,270]],"And Pharao rose up by night, and his servants, and all the Egyptians; and there was a great cry in all the land of Egypt, for there was not a house in which there was not one dead."],["31",[["καὶ",707031,7],["ἐκάλεσεν",707084,2],["Φαραω",713360,4],["Μωυσῆν",709112,6],["καὶ",707031,7],["Ααρων",700005,6],["νυκτὸς",709386,17],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["ἀνάστητε",701173,74],["καὶ",707031,7],["ἐξέλθατε",704909,74],["ἐκ",704132,0],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133],["καὶ",707031,7],["ὑμεῖς",713081,219],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["βαδίζετε",702367,87],["καὶ",707031,7],["λατρεύσατε",708108,74],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["ὑμῶν",713091,145],["καθὰ",706979,28],["λέγετε",708124,87]],"And Pharao called Moses and Aaron by night, and said to them, Rise and depart from my people, both ye and the children of Israel. Go and serve the Lord your God, even as ye say."],["32",[["καὶ",707031,7],["τὰ",709436,41],["πρόβατα",710768,42],["καὶ",707031,7],["τοὺς",709436,58],["βόας",702798,57],["ὑμῶν",713091,145],["ἀναλαβόντες",700984,196],["πορεύεσθε",710667,73],["εὐλογήσατε",705631,74],["δὲ",703303,11],["κἀμέ",706969,318]],"And take with you your sheep, and your oxen: bless me also, I pray you."],["33",[["καὶ",707031,7],["κατεβιάζοντο",707207,139],["οἱ",709436,136],["Αἰγύπτιοι",700400,52],["τὸν",709436,5],["λαὸν",708094,6],["σπουδῇ",712035,1],["ἐκβαλεῖν",704145,106],["αὐτοὺς",702165,62],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17],["εἶπαν",705373,150],["γὰρ",702963,11],["ὅτι",709803,7],["πάντες",710177,138],["ἡμεῖς",705983,219],["ἀποθνῄσκομεν",701461,243]],"And the Egyptians constrained the people, so that they cast them out of the land with haste, for they said, We all shall die."],["34",[["ἀνέλαβεν",700984,2],["δὲ",703303,11],["ὁ",709436,3],["λαὸς",708094,4],["τὸ",709436,24],["σταῖς",712042,25],["πρὸ",710747,0],["τοῦ",709436,20],["ζυμωθῆναι",705900,179],["τὰ",709436,41],["φυράματα",713624,42],["αὐτῶν",702165,40],["ἐνδεδεμένα",704685,388],["ἐν",704639,0],["τοῖς",709436,95],["ἱματίοις",706742,96],["αὐτῶν",702165,40],["ἐπὶ",705080,0],["τῶν",709436,80],["ὤμων",714114,81]],"And the people took their dough before their meal was leavened, bound up [as it was] in their garments, on their shoulders."],["35",[["οἱ",709436,136],["δὲ",703303,11],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["ἐποίησαν",710582,150],["καθὰ",706979,28],["συνέταξεν",712508,2],["αὐτοῖς",702165,151],["Μωυσῆς",709112,4],["καὶ",707031,7],["ᾔτησαν",700489,150],["παρὰ",709995,0],["τῶν",709436,80],["Αἰγυπτίων",700400,81],["σκεύη",711844,42],["ἀργυρᾶ",701705,68],["καὶ",707031,7],["χρυσᾶ",713971,68],["καὶ",707031,7],["ἱματισμόν",706744,6]],"And the children of Israel did as Moses commanded them, and they asked of the Egyptians articles of silver and gold and apparel."],["36",[["καὶ",707031,7],["κύριος",707996,4],["ἔδωκεν",703654,2],["τὴν",709436,8],["χάριν",713735,9],["τῷ",709436,113],["λαῷ",708094,114],["αὐτοῦ",702165,102],["ἐναντίον",704654,0],["τῶν",709436,80],["Αἰγυπτίων",700400,81],["καὶ",707031,7],["ἔχρησαν",713937,150],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἐσκύλευσαν",711900,150],["τοὺς",709436,58],["Αἰγυπτίους",700400,57]],"And the Lord gave his people favour in the sight of the Egyptians, and they lent to them; and they spoiled the Egyptians."],["37",[["ἀπάραντες",701329,196],["δὲ",703303,11],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["ἐκ",704132,0],["Ραμεσση",711167,18],["εἰς",704105,0],["Σοκχωθα",711927,227],["εἰς",704105,0],["ἑξακοσίας",704847,119],["χιλιάδας",713858,39],["πεζῶν",710219,169],["οἱ",709436,136],["ἄνδρες",701150,52],["πλὴν",710540,28],["τῆς",709436,16],["ἀποσκευῆς",701573,17]],"And the children of Israel departed from Ramesses to Socchoth, to [the full number of] six hundred thousand footmen, even men, besides the baggage."],["38",[["καὶ",707031,7],["ἐπίμικτος",705204,14],["πολὺς",710646,14],["συνανέβη",712384,2],["αὐτοῖς",702165,151],["καὶ",707031,7],["πρόβατα",710768,64],["καὶ",707031,7],["βόες",702798,52],["καὶ",707031,7],["κτήνη",707934,64],["πολλὰ",710646,195],["σφόδρα",712586,28]],"And a great mixed [company] went up with them, and sheep and oxen and very much cattle."],["39",[["καὶ",707031,7],["ἔπεψαν",710432,150],["τὸ",709436,24],["σταῖς",712042,25],["ὃ",709781,33],["ἐξήνεγκαν",704356,150],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["ἐγκρυφίας",703994,57],["ἀζύμους",700345,60],["οὐ",709805,28],["γὰρ",702963,11],["ἐζυμώθη",705900,37],["ἐξέβαλον",704145,150],["γὰρ",702963,11],["αὐτοὺς",702165,62],["οἱ",709436,136],["Αἰγύπτιοι",700400,52],["καὶ",707031,7],["οὐκ",709805,28],["ἠδυνήθησαν",703838,99],["ἐπιμεῖναι",705201,106],["οὐδὲ",709816,7],["ἐπισιτισμὸν",705247,6],["ἐποίησαν",710582,150],["ἑαυτοῖς",703917,151],["εἰς",704105,0],["τὴν",709436,8],["ὁδόν",709458,9]],"And they baked the dough which they brought out of Egypt, unleavened cakes, for it had not been leavened; for the Egyptians cast them out, and they could not remain, neither did they prepare provision for themselves for the journey."],["40",[["ἡ",709436,10],["δὲ",703303,11],["κατοίκησις",707535,12],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ἣν",709781,131],["κατῴκησαν",707534,150],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτῳ",700401,1],["καὶ",707031,7],["ἐν",704639,0],["γῇ",703083,1],["Χανααν",713708,184],["ἔτη",705543,42],["τετρακόσια",712817,68],["τριάκοντα",712934,59]],"And the sojourning of the children of Israel, while they sojourned in the land of Egypt and the land of Chanaan, [was] four hundred and thirty years."],["41",[["καὶ",707031,7],["ἐγένετο",703104,23],["μετὰ",708780,0],["τὰ",709436,41],["τετρακόσια",712817,68],["τριάκοντα",712934,59],["ἔτη",705543,42],["ἐξῆλθεν",704909,2],["πᾶσα",710177,29],["ἡ",709436,10],["δύναμις",703839,12],["κυρίου",707996,18],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17]],"And it came to pass after the four hundred and thirty years, all the forces of the Lord came forth out of the land of Egypt by night."],["42",[["νυκτὸς",709386,17],["προφυλακή",711012,12],["ἐστιν",704093,91],["τῷ",709436,113],["κυρίῳ",707996,114],["ὥστε",714164,7],["ἐξαγαγεῖν",704834,106],["αὐτοὺς",702165,62],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["ἐκείνη",704183,107],["ἡ",709436,10],["νὺξ",709386,12],["αὕτη",709858,107],["προφυλακὴ",711012,12],["κυρίῳ",707996,114],["ὥστε",714164,7],["πᾶσι",710177,230],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["εἶναι",704093,55],["εἰς",704105,0],["γενεὰς",703037,39],["αὐτῶν",702165,40]],"It is a watch kept to the Lord, so that he should bring them out of the land of Egypt; that very night is a watch kept to the Lord, so that it should be to all the children of Israel to their generations."],["43",[["εἶπεν",705373,2],["δὲ",703303,11],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["καὶ",707031,7],["Ααρων",700005,6],["λέγων",708124,72],["οὗτος",709858,121],["ὁ",709436,3],["νόμος",709349,4],["τοῦ",709436,20],["πασχα",710182,21],["πᾶς",710177,14],["ἀλλογενὴς",700690,14],["οὐκ",709805,28],["ἔδεται",705495,93],["ἀπ᾿",701425,0],["αὐτοῦ",702165,49]],"And the Lord said to Moses and Aaron, This is the law of the passover: no stranger shall eat of it."],["44",[["καὶ",707031,7],["πᾶν",710177,27],["οἰκέτην",709496,6],["τινὸς",712866,308],["ἢ",705924,7],["ἀργυρώνητον",701714,27],["περιτεμεῖς",710402,166],["αὐτόν",702165,85],["καὶ",707031,7],["τότε",712908,28],["φάγεται",713296,93],["ἀπ᾿",701425,0],["αὐτοῦ",702165,49]],"And every slave or servant bought with money—him thou shalt circumcise, and then shall he eat of it."],["45",[["πάροικος",710159,14],["ἢ",705924,7],["μισθωτὸς",708942,14],["οὐκ",709805,28],["ἔδεται",705495,93],["ἀπ᾿",701425,0],["αὐτοῦ",702165,49]],"A sojourner or hireling shall not eat of it."],["46",[["ἐν",704639,0],["οἰκίᾳ",709505,1],["μιᾷ",704106,101],["βρωθήσεται",702722,134],["καὶ",707031,7],["οὐκ",709805,28],["ἐξοίσετε",704356,337],["ἐκ",704132,0],["τῆς",709436,16],["οἰκίας",709505,17],["τῶν",709436,43],["κρεῶν",707889,44],["ἔξω",704983,28],["καὶ",707031,7],["ὀστοῦν",709792,25],["οὐ",709805,28],["συντρίψετε",712520,337],["ἀπ᾿",701425,0],["αὐτοῦ",702165,49]],"In one house shall it be eaten, and ye shall not carry of the flesh out from the house; and a bone of it ye shall not break."],["47",[["πᾶσα",710177,29],["συναγωγὴ",712376,12],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ποιήσει",710582,127],["αὐτό",702165,129]],"All the congregation of the children of Israel shall keep it."],["48",[["ἐὰν",703912,7],["δέ",703303,11],["τις",712866,158],["προσέλθῃ",710890,172],["πρὸς",710844,0],["ὑμᾶς",713080,194],["προσήλυτος",710900,4],["ποιῆσαι",710582,106],["τὸ",709436,24],["πασχα",710182,25],["κυρίῳ",707996,114],["περιτεμεῖς",710402,166],["αὐτοῦ",702165,102],["πᾶν",710177,46],["ἀρσενικόν",701817,46],["καὶ",707031,7],["τότε",712908,28],["προσελεύσεται",710890,93],["ποιῆσαι",710582,106],["αὐτὸ",702165,129],["καὶ",707031,7],["ἔσται",704093,93],["ὥσπερ",714163,28],["καὶ",707031,28],["ὁ",709436,3],["αὐτόχθων",702168,14],["τῆς",709436,16],["γῆς",703083,17],["πᾶς",710177,14],["ἀπερίτμητος",701397,14],["οὐκ",709805,28],["ἔδεται",705495,93],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102]],"And if any proselyte shall come to you to keep the passover to the Lord, thou shalt circumcise every male of him, and then shall he approach to sacrifice it, and he shall be even as the original inhabitant of the land; no uncircumcised person shall eat of it."],["49",[["νόμος",709349,4],["εἷς",704106,14],["ἔσται",704093,93],["τῷ",709436,113],["ἐγχωρίῳ",704017,30],["καὶ",707031,7],["τῷ",709436,113],["προσελθόντι",710890,350],["προσηλύτῳ",710900,114],["ἐν",704639,0],["ὑμῖν",713084,90]],"There shall be one law to the native, and to the proselyte coming among you."],["50",[["καὶ",707031,7],["ἐποίησαν",710582,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["καθὰ",706979,28],["ἐνετείλατο",704791,23],["κύριος",707996,4],["τῷ",709436,113],["Μωυσῇ",709112,114],["καὶ",707031,7],["Ααρων",700005,114],["πρὸς",710844,0],["αὐτούς",702165,62],["οὕτως",709859,28],["ἐποίησαν",710582,150]],"And the children of Israel did as the Lord commanded Moses and Aaron for them, so they did."],["51",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἐξήγαγεν",704834,2],["κύριος",707996,4],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ισραηλ",706839,18],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["σὺν",712372,0],["δυνάμει",703839,1],["αὐτῶν",702165,40]],"And it came to pass in that day that the Lord brought out the children of Israel from the land of Egypt with their forces."]]