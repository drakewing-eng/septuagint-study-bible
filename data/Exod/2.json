[["1",[["ἦν",704093,13],["δέ",703303,11],["τις",712866,158],["ἐκ",704132,0],["τῆς",709436,16],["φυλῆς",713620,17],["Λευι",708158,18],["ὃς",709781,213],["ἔλαβεν",708076,2],["τῶν",709436,130],["θυγατέρων",706320,65],["Λευι",708158,18],["καὶ",707031,7],["ἔσχεν",705785,2],["αὐτήν",702165,104]],"And there was a certain man of the tribe of Levi, who took to wife one of the daughters of Levi."],["2",[["καὶ",707031,7],["ἐν",704639,0],["γαστρὶ",702976,1],["ἔλαβεν",708076,2],["καὶ",707031,7],["ἔτεκεν",712853,2],["ἄρσεν",701818,46],["ἰδόντες",709725,196],["δὲ",703303,11],["αὐτὸ",702165,129],["ἀστεῖον",702014,46],["ἐσκέπασαν",711832,150],["αὐτὸ",702165,129],["μῆνας",708874,57],["τρεῖς",712927,60]],"And she conceived, and bore a male child; and having seen that he was fair, they hid him three months."],["3",[["ἐπεὶ",705054,7],["δὲ",703303,11],["οὐκ",709805,28],["ἠδύναντο",703838,139],["αὐτὸ",702165,129],["ἔτι",705538,28],["κρύπτειν",707923,55],["ἔλαβεν",708076,2],["αὐτῷ",702165,280],["ἡ",709436,10],["μήτηρ",708892,12],["αὐτοῦ",702165,49],["θῖβιν",706261,9],["καὶ",707031,7],["κατέχρισεν",707494,2],["αὐτὴν",702165,104],["ἀσφαλτοπίσσῃ",702042,1],["καὶ",707031,7],["ἐνέβαλεν",704547,2],["τὸ",709436,24],["παιδίον",709927,25],["εἰς",704105,0],["αὐτὴν",702165,104],["καὶ",707031,7],["ἔθηκεν",712849,2],["αὐτὴν",702165,104],["εἰς",704105,0],["τὸ",709436,24],["ἕλος",704527,25],["παρὰ",709995,0],["τὸν",709436,5],["ποταμόν",710693,6]],"And when they could no longer hide him, his mother took for him an ark, and besmeared it with bitumen, and cast the child into it, and put it in the ooze by the river."],["4",[["καὶ",707031,7],["κατεσκόπευεν",707426,13],["ἡ",709436,10],["ἀδελφὴ",700244,12],["αὐτοῦ",702165,102],["μακρόθεν",708417,28],["μαθεῖν",708480,106],["τί",712867,126],["τὸ",709436,24],["ἀποβησόμενον",701426,400],["αὐτῷ",702165,280]],"And his sister was watching from a distance, to learn what would happen to him."],["5",[["κατέβη",707202,2],["δὲ",703303,11],["ἡ",709436,10],["θυγάτηρ",706320,12],["Φαραω",713360,18],["λούσασθαι",708258,109],["ἐπὶ",705080,0],["τὸν",709436,5],["ποταμόν",710693,6],["καὶ",707031,7],["αἱ",709436,190],["ἅβραι",700090,192],["αὐτῆς",702165,86],["παρεπορεύοντο",710094,139],["παρὰ",709995,0],["τὸν",709436,5],["ποταμόν",710693,6],["καὶ",707031,7],["ἰδοῦσα",709725,149],["τὴν",709436,8],["θῖβιν",706261,9],["ἐν",704639,0],["τῷ",709436,53],["ἕλει",704527,54],["ἀποστείλασα",701592,149],["τὴν",709436,8],["ἅβραν",700090,36],["ἀνείλατο",700962,23],["αὐτήν",702165,104]],"And the daughter of Pharao came down to the river to bathe; and her maids walked by the river's side, and having seen the ark in the ooze, she sent her maid, and took it up."],["6",[["ἀνοίξασα",701186,149],["δὲ",703303,11],["ὁρᾷ",709725,91],["παιδίον",709927,25],["κλαῖον",707703,47],["ἐν",704639,0],["τῇ",709436,100],["θίβει",706261,1],["καὶ",707031,7],["ἐφείσατο",713406,23],["αὐτοῦ",702165,49],["ἡ",709436,10],["θυγάτηρ",706320,12],["Φαραω",713360,18],["καὶ",707031,7],["ἔφη",713437,13],["ἀπὸ",701425,0],["τῶν",709436,43],["παιδίων",709927,44],["τῶν",709436,80],["Εβραίων",703933,81],["τοῦτο",709858,129]],"And having opened it, she sees the babe weeping in the ark: and the daughter of Pharao had compassion on it, and said, This [is one] of the Hebrews' children."],["7",[["καὶ",707031,7],["εἶπεν",705373,2],["ἡ",709436,10],["ἀδελφὴ",700244,12],["αὐτοῦ",702165,49],["τῇ",709436,100],["θυγατρὶ",706320,1],["Φαραω",713360,18],["θέλεις",706176,154],["καλέσω",707084,207],["σοι",711925,159],["γυναῖκα",703209,9],["τροφεύουσαν",712983,78],["ἐκ",704132,0],["τῶν",709436,80],["Εβραίων",703933,81],["καὶ",707031,7],["θηλάσει",706234,127],["σοι",711925,159],["τὸ",709436,24],["παιδίον",709927,25]],"And his sister said to the daughter of Pharao, Wilt thou that I call to thee a nurse of the Hebrews, and shall she suckle the child for thee?"],["8",[["ἡ",709436,10],["δὲ",703303,11],["εἶπεν",705373,2],["αὐτῇ",702165,105],["ἡ",709436,10],["θυγάτηρ",706320,12],["Φαραω",713360,18],["πορεύου",710667,253],