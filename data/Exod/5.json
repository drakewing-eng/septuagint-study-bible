[["1",[["καὶ",707031,7],["μετὰ",708780,0],["ταῦτα",709858,71],["εἰσῆλθεν",704114,2],["Μωυσῆς",709112,4],["καὶ",707031,7],["Ααρων",700005,4],["πρὸς",710844,0],["Φαραω",713360,6],["καὶ",707031,7],["εἶπαν",705373,150],["αὐτῷ",702165,50],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ἐξαπόστειλον",704872,176],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["ἵνα",706747,7],["μοι",708974,159],["ἑορτάσωσιν",704988,234],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1]],"And after this went in Moses and Aaron to Pharao, and they said to him, These things says the Lord God of Israel, Send my people away, that they may keep a feast to me in the wilderness."],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["Φαραω",713360,4],["τίς",712867,158],["ἐστιν",704093,91],["οὗ",709781,48],["εἰσακούσομαι",704108,181],["τῆς",709436,16],["φωνῆς",713640,17],["αὐτοῦ",702165,102],["ὥστε",714164,7],["ἐξαποστεῖλαι",704872,106],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ισραηλ",706839,18],["οὐκ",709805,28],["οἶδα",709492,89],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["τὸν",709436,5],["Ισραηλ",706839,6],["οὐκ",709805,28],["ἐξαποστέλλω",704872,157]],"And Pharao said, Who is he that I should hearken to his voice, so that I should send away the children of Israel? I do not know the Lord, and I will not let Israel go."],["3",[["καὶ",707031,7],["λέγουσιν",708124,197],["αὐτῷ",702165,50],["ὁ",709436,3],["θεὸς",706192,4],["τῶν",709436,80],["Εβραίων",703933,81],["προσκέκληται",710912,187],["ἡμᾶς",705981,194],["πορευσόμεθα",710667,141],["οὖν",709835,11],["ὁδὸν",709458,9],["τριῶν",712927,198],["ἡμερῶν",705984,65],["εἰς",704105,0],["τὴν",709436,8],["ἔρημον",705420,9],["ὅπως",709719,7],["θύσωμεν",706349,79],["τῷ",709436,113],["θεῷ",706192,114],["ἡμῶν",705999,145],["μήποτε",708882,28],["συναντήσῃ",712394,172],["ἡμῖν",705994,90],["θάνατος",706096,4],["ἢ",705924,7],["φόνος",713549,4]],"And they say to him, The God of the Hebrews has called us to him: we will go therefore a three days' journey into the wilderness, that we may sacrifice to the Lord our God, lest at any time death or slaughter happen to us."],["4",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["ὁ",709436,3],["βασιλεὺς",702580,4],["Αἰγύπτου",700401,17],["ἵνα",706747,7],["τί",712867,273],["Μωυσῆ",709112,153],["καὶ",707031,7],["Ααρων",700005,153],["διαστρέφετε",703592,87],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["ἀπὸ",701425,0],["τῶν",709436,43],["ἔργων",705396,44],["ἀπέλθατε",701398,74],["ἕκαστος",704133,14],["ὑμῶν",713091,145],["πρὸς",710844,0],["τὰ",709436,41],["ἔργα",705396,42],["αὐτοῦ",702165,102]],"And the king of Egypt said to them, Why do ye, Moses and Aaron, turn the people from their works? depart each of you to your works."],["5",[["καὶ",707031,7],["εἶπεν",705373,2],["Φαραω",713360,4],["ἰδοὺ",706497,88],["νῦν",709384,28],["πολυπληθεῖ",710640,91],["ὁ",709436,3],["λαός",708094,4],["μὴ",708851,28],["οὖν",709835,11],["καταπαύσωμεν",707365,79],["αὐτοὺς",702165,62],["ἀπὸ",701425,0],["τῶν",709436,43],["ἔργων",705396,44]],"And Pharao said, Behold now, the people is very numerous; let us not then give them rest from their work."],["6",[["συνέταξεν",712508,2],["δὲ",703303,11],["Φαραω",713360,4],["τοῖς",709436,147],["ἐργοδιώκταις",705394,148],["τοῦ",709436,35],["λαοῦ",708094,18],["καὶ",707031,7],["τοῖς",709436,147],["γραμματεῦσιν",703185,148],["λέγων",708124,72]],"And Pharao gave orders to the task-masters of the people and the accountants, saying,"],["7",[["οὐκέτι",709827,28],["προστεθήσεται",710965,134],["διδόναι",703654,55],["ἄχυρον",702316,25],["τῷ",709436,113],["λαῷ",708094,114],["εἰς",704105,0],["τὴν",709436,8],["πλινθουργίαν",710555,9],["καθάπερ",706984,28],["ἐχθὲς",713853,28],["καὶ",707031,7],["τρίτην",712968,36],["ἡμέραν",705984,9],["αὐτοὶ",702165,201],["πορευέσθωσαν",710667,77],["καὶ",707031,7],["συναγαγέτωσαν",712375,264],["ἑαυτοῖς",703917,151],["ἄχυρα",702316,42]],"Ye shall no longer give straw to the people for brick-making as yesterday and the third day; but let them go themselves, and collect straw for themselves."],["8",[["καὶ",707031,7],["τὴν",709436,8],["σύνταξιν",712506,9],["τῆς",709436,16],["πλινθείας",710551,17],["ἧς",709781,167],["αὐτοὶ",702165,201],["ποιοῦσιν",710582,197],["καθ᾿",707200,0],["ἑκάστην",704133,36],["ἡμέραν",705984,9],["ἐπιβαλεῖς",705083,166],["αὐτοῖς",702165,151],["οὐκ",709805,28],["ἀφελεῖς",702177,166],["οὐδέν",709817,46],["σχολάζουσιν",712614,197],["γάρ",702963,11],["διὰ",703417,0],["τοῦτο",709858,129],["κεκράγασιν",707868,353],["λέγοντες",708124,146],["πορευθῶμεν",710667,283],["καὶ",707031,7],["θύσωμεν",706349,79],["τῷ",709436,113],["θεῷ",706192,114],["ἡμῶν",705999,145]],"And thou shalt impose on them daily the rate of brick-making which they perform: thou shalt not abate anything, for they are idle; therefore have they cried, saying, Let us arise and do sacrifice to our God."],["9",[["βαρυνέσθω",702553,407],["τὰ",709436,41],["ἔργα",705396,42],["τῶν",709436,80],["ἀνθρώπων",701163,81],["τούτων",709858,40],["καὶ",707031,7],["μεριμνάτωσαν",708746,56],["ταῦτα",709858,71],["καὶ",707031,7],["μὴ",708851,28],["μεριμνάτωσαν",708746,56],["ἐν",704639,0],["λόγοις",708236,148],["κενοῖς",707612,230]],"Let the works of these men be made grievous, and let them care for these things, and not care for vain words."],["10",[["κατέσπευδον",707433,137],["δὲ",703303,11],["αὐτοὺς",702165,62],["οἱ",709436,136],["ἐργοδιῶκται",705394,52],["καὶ",707031,7],["οἱ",709436,136],["γραμματεῖς",703185,52],["καὶ",707031,7],["ἔλεγον",708124,137],["πρὸς",710844,0],["τὸν",709436,5],["λαὸν",708094,6],["λέγοντες",708124,146],["τάδε",709446,71],["λέγει",708124,91],["Φαραω",713360,4],["οὐκέτι",709827,28],["δίδωμι",703654,157],["ὑμῖν",713084,90],["ἄχυρα",702316,42]],"And the taskmasters and the accountants hastened them, and they spoke to the people, saying, Thus says Pharao, I [will] give you straw no longer."],["11",[["αὐτοὶ",702165,201],["ὑμεῖς",713081,219],["πορευόμενοι",710667,348],["συλλέγετε",712263,87],["ἑαυτοῖς",703917,151],["ἄχυρα",702316,42],["ὅθεν",709486,28],["ἐὰν",703912,7],["εὕρητε",705676,125],["οὐ",709805,28],["γὰρ",702963,11],["ἀφαιρεῖται",702177,117],["ἀπὸ",701425,0],["τῆς",709436,16],["συντάξεως",712506,17],["ὑμῶν",713091,145],["οὐθέν",709817,46]],"Go ye, yourselves, get for yourselves straw whencesoever ye can find it, for nothing is diminished from your rate."],["12",[["καὶ",707031,7],["διεσπάρη",703584,37],["ὁ",709436,3],["λαὸς",708094,4],["ἐν",704639,0],["ὅλῃ",709597,101],["Αἰγύπτῳ",700401,1],["συναγαγεῖν",712375,106],["καλάμην",707079,9],["εἰς",704105,0],["ἄχυρα",702316,42]],"So the people were dispersed in all the land of Egypt, to gather stubble for straw."],["13",[["οἱ",709436,136],["δὲ",703303,11],["ἐργοδιῶκται",705394,52],["κατέσπευδον",707433,137],["αὐτοὺς",702165,62],["λέγοντες",708124,146],["συντελεῖτε",712510,335],["τὰ",709436,41],["ἔργα",705396,42],["τὰ",709436,41],["καθήκοντα",706998,237],["καθ᾿",707200,0],["ἡμέραν",705984,9],["καθάπερ",706984,28],["καὶ",707031,7],["ὅτε",709802,28],["τὸ",709436,24],["ἄχυρον",702316,25],["ἐδίδοτο",703654,19],["ὑμῖν",713084,90]],"And the taskmasters hastened them, saying, Fulfil your regular daily tasks, even as when straw was given you."],["14",[["καὶ",707031,7],["ἐμαστιγώθησαν",708566,99],["οἱ",709436,136],["γραμματεῖς",703185,52],["τοῦ",709436,20],["γένους",703057,21],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["οἱ",709436,136],["κατασταθέντες",707011,247],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["ὑπὸ",713184,0],["τῶν",709436,80],["ἐπιστατῶν",705266,81],["τοῦ",709436,35],["Φαραω",713360,18],["λέγοντες",708124,146],["διὰ",703417,0],["τί",712867,126],["οὐ",709805,28],["συνετελέσατε",712510,265],["τὰς",709436,38],["συντάξεις",712506,39],["ὑμῶν",713091,145],["τῆς",709436,16],["πλινθείας",710551,17],["καθάπερ",706984,28],["ἐχθὲς",713853,28],["καὶ",707031,7],["τρίτην",712968,36],["ἡμέραν",705984,9],["καὶ",707031,7],["τὸ",709436,24],["τῆς",709436,16],["σήμερον",711751,28]],"And the accountants of the race of the children of Israel, who were set over them by the masters of Pharao, were scourged, [[and questioned],] [men] saying, Why have ye not fulfilled your rates of brick-work as yesterday and the third day, to-day also?"],["15",[["εἰσελθόντες",704114,196],["δὲ",703303,11],["οἱ",709436,136],["γραμματεῖς",703185,52],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["κατεβόησαν",707213,150],["πρὸς",710844,0],["Φαραω",713360,6],["λέγοντες",708124,146],["ἵνα",706747,7],["τί",712867,126],["οὕτως",709859,28],["ποιεῖς",710582,154],["τοῖς",709436,147],["σοῖς",712181,90],["οἰκέταις",709496,148]],"And the accountants of the children of Israel went in and cried to Pharao, saying, Why dost thou act thus to thy servants?"],["16",[["ἄχυρον",702316,25],["οὐ",709805,28],["δίδοται",703654,117],["τοῖς",709436,147],["οἰκέταις",709496,148],["σου",711945,133],["καὶ",707031,7],["τὴν",709436,8],["πλίνθον",710554,9],["ἡμῖν",705994,90],["λέγουσιν",708124,197],["ποιεῖν",710582,55],["καὶ",707031,7],["ἰδοὺ",706497,88],["οἱ",709436,136],["παῖδές",709932,52],["σου",711945,133],["μεμαστίγωνται",708566,408],["ἀδικήσεις",700269,166],["οὖν",709835,11],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133]],"Straw is not given to thy servants, and they tell us to make brick; and behold thy servants have been scourged: thou wilt therefore injure thy people."],["17",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["σχολάζετε",712614,87],["σχολασταί",712615,52],["ἐστε",704093,87],["διὰ",703417,0],["τοῦτο",709858,129],["λέγετε",708124,87],["πορευθῶμεν",710667,283],["θύσωμεν",706349,79],["τῷ",709436,113],["θεῷ",706192,114],["ἡμῶν",705999,145]],"And he said to them, Ye are idle, ye are idlers: therefore ye say, Let us go [and] do sacrifice to our God."],["18",[["νῦν",709384,28],["οὖν",709835,11],["πορευθέντες",710667,247],["ἐργάζεσθε",705383,73],["τὸ",709436,34],["γὰρ",702963,11],["ἄχυρον",702316,15],["οὐ",709805,28],["δοθήσεται",703654,134],["ὑμῖν",713084,90],["καὶ",707031,7],["τὴν",709436,8],["σύνταξιν",712506,9],["τῆς",709436,16],["πλινθείας",710551,17],["ἀποδώσετε",701449,337]],"Now then go and work, for straw shall not be given to you, yet ye shall return the rate of bricks."],["19",[["ἑώρων",709725,137],["δὲ",703303,11],["οἱ",709436,136],["γραμματεῖς",703185,52],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,4],["ἑαυτοὺς",703917,62],["ἐν",704639,0],["κακοῖς",707066,94],["λέγοντες",708124,146],["οὐκ",709805,28],["ἀπολείψετε",701508,337],["τῆς",709436,16],["πλινθείας",710551,17],["τὸ",709436,24],["καθῆκον",706998,47],["τῇ",709436,100],["ἡμέρᾳ",705984,1]],"And the accountants of the children of Israel saw themselves in an evil plight, [men] saying, Ye shall not fail to deliver the daily rate of the brick-making."],["20",[["συνήντησαν",712394,150],["δὲ",703303,11],["Μωυσῇ",709112,114],["καὶ",707031,7],["Ααρων",700005,114],["ἐρχομένοις",705453,341],["εἰς",704105,0],["συνάντησιν",712397,9],["αὐτοῖς",702165,151],["ἐκπορευομένων",704293,299],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["Φαραω",713360,18]],"And they met Moses and Aaron coming forth to meet them, as they came forth from Pharao."],["21",[["καὶ",707031,7],["εἶπαν",705373,150],["αὐτοῖς",702165,151],["ἴδοι",709725,225],["ὁ",709436,3],["θεὸς",706192,4],["ὑμᾶς",713080,194],["καὶ",707031,7],["κρίναι",707905,225],["ὅτι",709803,7],["ἐβδελύξατε",702608,265],["τὴν",709436,8],["ὀσμὴν",709786,9],["ἡμῶν",705999,145],["ἐναντίον",704654,0],["Φαραω",713360,18],["καὶ",707031,7],["ἐναντίον",704654,0],["τῶν",709436,80],["θεραπόντων",706201,81],["αὐτοῦ",702165,102],["δοῦναι",703654,106],["ῥομφαίαν",711291,9],["εἰς",704105,0],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτοῦ",702165,102],["ἀποκτεῖναι",701498,106],["ἡμᾶς",705981,194]],"And they said to them, The Lord look upon you and judge you, for ye have made our savour abominable before Pharao, and before his servants, to put a sword into his hands to slay us."],["22",[["ἐπέστρεψεν",705278,2],["δὲ",703303,11],["Μωυσῆς",709112,4],["πρὸς",710844,0],["κύριον",707996,6],["καὶ",707031,7],["εἶπεν",705373,2],["κύριε",707996,153],["διὰ",703417,0],["τί",712867,126],["ἐκάκωσας",707073,162],["τὸν",709436,5],["λαὸν",708094,6],["τοῦτον",709858,85],["καὶ",707031,7],["ἵνα",706747,7],["τί",712867,126],["ἀπέσταλκάς",701592,266],["με",708618,163]],"And Moses turned to the Lord, and said, I pray, Lord, why hast thou afflicted this people? and wherefore hast thou sent me?"],["23",[["καὶ",707031,7],["ἀφ᾿",701425,0],["οὗ",709781,48],["πεπόρευμαι",710667,326],["πρὸς",710844,0],["Φαραω",713360,6],["λαλῆσαι",708071,106],["ἐπὶ",705080,0],["τῷ",709436,53],["σῷ",711943,159],["ὀνόματι",709666,54],["ἐκάκωσεν",707073,2],["τὸν",709436,5],["λαὸν",708094,6],["τοῦτον",709858,85],["καὶ",707031,7],["οὐκ",709805,28],["ἐρρύσω",711309,174],["τὸν",709436,5],["λαόν",708094,6],["σου",711945,133]],"For from the time that I went to Pharao to speak in thy name, he has afflicted this people, and thou hast not delivered thy people."]]