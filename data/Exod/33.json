,["μοι",708974,159],["λέγεις",708124,154],["ἀνάγαγε",700933,176],["τὸν",709436,5],["λαὸν",708094,6],["τοῦτον",709858,85],["σὺ",712181,164],["δὲ",703303,11],["οὐκ",709805,28],["ἐδήλωσάς",703402,162],["μοι",708974,159],["ὃν",709781,112],["συναποστελεῖς",712403,166],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["σὺ",712181,164],["δέ",703303,11],["μοι",708974,159],["εἶπας",705373,162],["οἶδά",709492,89],["σε",711598,163],["παρὰ",709995,0],["πάντας",710177,60],["καὶ",707031,7],["χάριν",713735,9],["ἔχεις",705785,154],["παρ᾿",709995,0],["ἐμοί",704577,159]],"And Moses said to the Lord, Lo! thou sayest to me, Lead on this people; but thou hast not shewed me whom thou wilt send with me, but thou hast said to me, I know thee above all, and thou hast favour with me."],["13",[["εἰ",704071,7],["οὖν",709835,11],["εὕρηκα",705676,89],["χάριν",713735,9],["ἐναντίον",704654,0],["σου",711945,133],["ἐμφάνισόν",704628,176],["μοι",708974,159],["σεαυτόν",711599,85],["γνωστῶς",703142,28],["ἴδω",709725,207],["σε",711598,163],["ὅπως",709719,7],["ἂν",700900,11],["ὦ",704093,438],["εὑρηκὼς",705676,270],["χάριν",713735,9],["ἐναντίον",704654,0],["σου",711945,133],["καὶ",707031,7],["ἵνα",706747,7],["γνῶ",703105,207],["ὅτι",709803,7],["λαός",708094,4],["σου",711945,133],["τὸ",709436,34],["ἔθνος",704068,15],["τὸ",709436,34],["μέγα",708653,26],["τοῦτο",709858,132]],"If then I have found favour in thy sight, reveal thyself to me, that I may evidently see thee; that I may find favour in thy sight, and that I may know that this great nation [is] thy people."],["14",[["καὶ",707031,7],["λέγει",708124,91],["αὐτὸς",702165,121],["προπορεύσομαί",710839,181],["σου",711945,133],["καὶ",707031,7],["καταπαύσω",707365,207],["σε",711598,163]],"And he says, I myself will go before thee, and give thee rest."],["15",[["καὶ",707031,7],["λέγει",708124,91],["πρὸς",710844,0],["αὐτόν",702165,85],["εἰ",704071,7],["μὴ",708851,28],["αὐτὸς",702165,121],["σὺ",712181,164],["πορεύῃ",710667,278],["μή",708851,28],["με",708618,163],["ἀναγάγῃς",700933,175],["ἐντεῦθεν",704793,28]],"And he says to him, If thou go not up with us thyself, bring me not up hence."],["16",[["καὶ",707031,7],["πῶς",711121,28],["γνωστὸν",703141,26],["ἔσται",704093,93],["ἀληθῶς",700662,28],["ὅτι",709803,7],["εὕρηκα",705676,89],["χάριν",713735,9],["παρὰ",709995,0],["σοί",711925,159],["ἐγώ",704018,164],["τε",712751,11],["καὶ",707031,7],["ὁ",709436,3],["λαός",708094,4],["σου",711945,133],["ἀλλ᾿",700680,7],["ἢ",705924,7],["συμπορευομένου",712342,262],["σου",711945,133],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐνδοξασθήσομαι",704693,180],["ἐγώ",704018,164],["τε",712751,11],["καὶ",707031,7],["ὁ",709436,3],["λαός",708094,4],["σου",711945,133],["παρὰ",709995,0],["πάντα",710177,68],["τὰ",709436,41],["ἔθνη",704068,42],["ὅσα",709788,195],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ἐστιν",704093,91]],"And how shall it be surely known, that both I and this people have found favour with thee, except only if thou go with us? So both I and thy people shall be glorified beyond all the nations, as many as are upon the earth."],["17",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["καὶ",707031,7],["τοῦτόν",709858,85],["σοι",711925,159],["τὸν",709436,5],["λόγον",708236,6],["ὃν",709781,112],["εἴρηκας",705415,266],["ποιήσω",710582,165],["εὕρηκας",705676,266],["γὰρ",702963,11],["χάριν",713735,9],["ἐνώπιόν",704823,0],["μου",709032,133],["καὶ",707031,7],["οἶδά",709492,89],["σε",711598,163],["παρὰ",709995,0],["πάντας",710177,60]],"And the Lord said to Moses, I will also do for thee this thing, which thou hast spoken; for thou hast found grace before me, and I know thee above all."],["18",[["καὶ",707031,7],["λέγει",708124,91],["δεῖξόν",703314,176],["μοι",708974,159],["τὴν",709436,8],["σεαυτοῦ",711599,102],["δόξαν",703791,9]],"And [Moses] says, Manifest thyself to me.",{"s":"d","q":0.57}],["19",[["καὶ",707031,7],["εἶπεν",705373,2],["ἐγὼ",704018,164],["παρελεύσομαι",710141,181],["πρότερός",710992,224],["σου",711945,133],["τῇ",709436,100],["δόξῃ",703791,1],["μου",709032,133],["καὶ",707031,7],["καλέσω",707084,207],["ἐπὶ",705080,0],["τῷ",709436,53],["ὀνόματί",709666,54],["μου",709032,133],["κύριος",707996,4],["ἐναντίον",704654,0],["σου",711945,133],["καὶ",707031,7],["ἐλεήσω",704418,165],["ὃν",709781,112],["ἂν",700900,11],["ἐλεῶ",704418,438],["καὶ",707031,7],["οἰκτιρήσω",709518,165],["ὃν",709781,112],["ἂν",700900,11],["οἰκτίρω",709518,438]],"And [God] said, I will pass by before thee with my glory, and I will call by my name, the Lord, before thee; and I will have mercy on whom I will have mercy, and will have pity on whom I will have pity."],["20",[["καὶ",707031,7],["εἶπεν",705373,2],["οὐ",709805,28],["δυνήσῃ",703838,123],["ἰδεῖν",709725,106],["μου",709032,133],["τὸ",709436,24],["πρόσωπον",710986,25],["οὐ",709805,28],["γὰρ",702963,11],["μὴ",708851,28],["ἴδῃ",709725,172],["ἄνθρωπος",701163,4],["τὸ",709436,24],["πρόσωπόν",710986,25],["μου",709032,133],["καὶ",707031,7],["ζήσεται",705851,93]],"And [God] said, Thou shalt not be able to see my face; for no man shall see my face, and live."],["21",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["ἰδοὺ",706497,88],["τόπος",712903,4],["παρ᾿",709995,0],["ἐμοί",704577,159],["στήσῃ",706846,123],["ἐπὶ",705080,0],["τῆς",709436,16],["πέτρας",710443,17]],"And the Lord said, Behold, [there is] a place by me: thou shalt stand upon the rock;"],["22",[["ἡνίκα",706008,28],["δ᾿",703303,11],["ἂν",700900,11],["παρέλθῃ",710141,172],["μου",709032,133],["ἡ",709436,10],["δόξα",703791,12],["καὶ",707031,7],["θήσω",712849,165],["σε",711598,163],["εἰς",704105,0],["ὀπὴν",709688,9],["τῆς",709436,16],["πέτρας",710443,17],["καὶ",707031,7],["σκεπάσω",711832,165],["τῇ",709436,100],["χειρί",713787,1],["μου",709032,133],["ἐπὶ",705080,0],["σέ",711598,163],["ἕως",705792,7],["ἂν",700900,11],["παρέλθω",710141,207]],"and when my glory shall pass by, then I will put thee into a hole of the rock; and I will cover thee over with my hand, until I shall have passed by."],["23",[["καὶ",707031,7],["ἀφελῶ",702177,165],["τὴν",709436,8],["χεῖρα",713787,9],["καὶ",707031,7],["τότε",712908,28],["ὄψῃ",709725,123],["τὰ",709436,41],["ὀπίσω",709697,0],["μου",709032,133],["τὸ",709436,24],["δὲ",703303,11],["πρόσωπόν",710986,15],["μου",709032,133],["οὐκ",709805,28],["ὀφθήσεταί",709725,134],["σοι",711925,159]],"And I will remove my hand, and then shalt thou see my back parts; but my face shall not appear to thee."]]