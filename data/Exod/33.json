[["1",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["πορεύου",710667,253],["ἀνάβηθι",700905,176],["ἐντεῦθεν",704793,28],["σὺ",712181,164],["καὶ",707031,7],["ὁ",709436,3],["λαός",708094,4],["σου",711945,133],["οὓς",709781,298],["ἐξήγαγες",704834,162],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["ὤμοσα",709620,155],["τῷ",709436,113],["Αβρααμ",700091,114],["καὶ",707031,7],["Ισαακ",706799,18],["καὶ",707031,7],["Ιακωβ",706401,114],["λέγων",708124,72],["τῷ",709436,53],["σπέρματι",712008,54],["ὑμῶν",713091,145],["δώσω",703654,165],["αὐτήν",702165,104]],"And the Lord said to Moses, Go forward, go up hence, thou and thy people, whom thou broughtest out of the land of Egypt, into the land which I swore to Abraam, and Isaac, and Jacob, saying, I will give it to your seed."],["2",[["καὶ",707031,7],["συναποστελῶ",712403,165],["τὸν",709436,5],["ἄγγελόν",700140,6],["μου",709032,133],["πρὸ",710747,0],["προσώπου",710986,21],["σου",711945,133],["καὶ",707031,7],["ἐκβαλεῖ",704145,127],["τὸν",709436,5],["Αμορραῖον",700865,6],["καὶ",707031,7],["Χετταῖον",713838,6],["καὶ",707031,7],["Φερεζαῖον",713422,6],["καὶ",707031,7],["Γεργεσαῖον",703062,6],["καὶ",707031,7],["Ευαῖον",705549,6],["καὶ",707031,7],["Ιεβουσαῖον",706519,6]],"And I will send at the same time my angel before thy face, and he shall cast out the Amorite and the Chettite, and the Pherezite and Gergesite, and Evite, and Jebusite, and Chananite."],["3",[["καὶ",707031,7],["εἰσάξω",704107,165],["σε",711598,163],["εἰς",704105,0],["γῆν",703083,9],["ῥέουσαν",711241,78],["γάλα",702919,25],["καὶ",707031,7],["μέλι",708700,25],["οὐ",709805,28],["γὰρ",702963,11],["μὴ",708851,28],["συναναβῶ",712384,207],["μετὰ",708780,0],["σοῦ",711945,133],["διὰ",703417,0],["τὸ",709436,24],["λαὸν",708094,6],["σκληροτράχηλόν",711863,27],["σε",711598,163],["εἶναι",704093,55],["ἵνα",706747,7],["μὴ",708851,28],["ἐξαναλώσω",704861,207],["σε",711598,163],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1]],"And I will bring thee into a land flowing with milk and honey; for I will not go up with thee, because thou art a stiff-necked people, lest I consume thee by the way."],["4",[["καὶ",707031,7],["ἀκούσας",700587,182],["ὁ",709436,3],["λαὸς",708094,4],["τὸ",709436,24],["ῥῆμα",711246,25],["τὸ",709436,24],["πονηρὸν",710660,46],["τοῦτο",709858,129],["κατεπένθησαν",707368,150],["ἐν",704639,0],["πενθικοῖς",710252,94]],"And the people having heard this grievous saying, mourned in mourning apparel."],["5",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["ὑμεῖς",713081,219],["λαὸς",708094,4],["σκληροτράχηλος",711863,14],["ὁρᾶτε",709725,87],["μὴ",708851,28],["πληγὴν",710527,9],["ἄλλην",700697,104],["ἐπάξω",704994,165],["ἐγὼ",704018,164],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["καὶ",707031,7],["ἐξαναλώσω",704861,207],["ὑμᾶς",713080,194],["νῦν",709384,28],["οὖν",709835,11],["ἀφέλεσθε",702177,186],["τὰς",709436,38],["στολὰς",712120,39],["τῶν",709436,130],["δοξῶν",703791,65],["ὑμῶν",713091,145],["καὶ",707031,7],["τὸν",709436,5],["κόσμον",707851,6],["καὶ",707031,7],["δείξω",703314,165],["σοι",711925,159],["ἃ",709781,69],["ποιήσω",710582,207],["σοι",711925,159]],"For the Lord said to the children of Israel, Ye are a stiff-necked people; take heed lest I bring on you another plague, and destroy you: now then put off your glorious apparel, and [your] ornaments, and I will shew thee what I will do to thee."],["6",[["καὶ",707031,7],["περιείλαντο",710288,189],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["τὸν",709436,5],["κόσμον",707851,6],["αὐτῶν",702165,40],["καὶ",707031,7],["τὴν",709436,8],["περιστολὴν",710393,9],["ἀπὸ",701425,0],["τοῦ",709436,20],["ὄρους",709768,21],["τοῦ",709436,20],["Χωρηβ",714013,184]],"So the sons of Israel took off their ornaments and their array at the mount of Choreb."],["7",[["καὶ",707031,7],["λαβὼν",708076,