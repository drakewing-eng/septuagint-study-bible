[["1",[["ἤκουσεν",700587,2],["δὲ",703303,11],["Ιοθορ",706756,4],["ὁ",709436,3],["ἱερεὺς",706614,4],["Μαδιαμ",708355,118],["ὁ",709436,3],["γαμβρὸς",702950,4],["Μωυσῆ",709112,18],["πάντα",710177,68],["ὅσα",709788,68],["ἐποίησεν",710582,2],["κύριος",707996,4],["Ισραηλ",706839,114],["τῷ",709436,113],["ἑαυτοῦ",703917,102],["λαῷ",708094,114],["ἐξήγαγεν",704834,2],["γὰρ",702963,11],["κύριος",707996,4],["τὸν",709436,5],["Ισραηλ",706839,6],["ἐξ",704132,0],["Αἰγύπτου",700401,17]],"And Jothor the priest of Madiam, the father-in-law of Moses, heard of all that the Lord did to his people Israel; for the Lord brought Israel out of Egypt."],["2",[["ἔλαβεν",708076,2],["δὲ",703303,11],["Ιοθορ",706756,4],["ὁ",709436,3],["γαμβρὸς",702950,4],["Μωυσῆ",709112,18],["Σεπφωραν",711699,9],["τὴν",709436,8],["γυναῖκα",703209,9],["Μωυσῆ",709112,18],["μετὰ",708780,0],["τὴν",709436,8],["ἄφεσιν",702199,9],["αὐτῆς",702165,86]],"And Jothor the father-in-law of Moses, took Sepphora the wife of Moses after she had been sent away,"],["3",[["καὶ",707031,7],["τοὺς",709436,58],["δύο",703849,59],["υἱοὺς",713075,57],["αὐτοῦ",702165,102],["ὄνομα",709666,25],["τῷ",709436,113],["ἑνὶ",704106,30],["αὐτῶν",702165,40],["Γηρσαμ",703092,6],["λέγων",708124,72],["πάροικος",710159,14],["ἤμην",704093,334],["ἐν",704639,0],["γῇ",703083,1],["ἀλλοτρίᾳ",700699,101]],"and her two sons: the name of the one was Gersam, [his father] saying, I was a sojourner in a strange land;—"],["4",[["καὶ",707031,7],["τὸ",709436,24],["ὄνομα",709666,25],["τοῦ",709436,35],["δευτέρου",703389,116],["Ελιεζερ",704468,6],["λέγων",708124,72],["ὁ",709436,3],["γὰρ",702963,11],["θεὸς",706192,4],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133],["βοηθός",702748,4],["μου",709032,133],["καὶ",707031,7],["ἐξείλατό",704838,23],["με",708618,163],["ἐκ",704132,0],["χειρὸς",713787,17],["Φαραω",713360,18]],"and the name of the second Eliezer, saying, For the God of my father [is] my helper, and he has rescued me out of the hand of Pharao."],["5",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["Ιοθορ",706756,4],["ὁ",709436,3],["γαμβρὸς",702950,4],["Μωυσῆ",709112,18],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["καὶ",707031,7],["ἡ",709436,10],["γυνὴ",703209,12],["πρὸς",710844,0],["Μωυσῆν",709112,6],["εἰς",704105,0],["τὴν",709436,8],["ἔρημον",705420,9],["οὗ",709806,28],["παρενέβαλεν",710132,2],["ἐπ᾿",705080,0],["ὄρους",709768,21],["τοῦ",709436,35],["θεοῦ",706192,18]],"And Jothor the father-in-law of Moses, and his sons and his wife, went forth to Moses into the wilderness, where he encamped on the mount of God."],["6",[["ἀνηγγέλη",700921,37],["δὲ",703303,11],["Μωυσεῖ",709112,114],["λέγοντες",708124,146],["ἰδοὺ",706497,88],["ὁ",709436,3],["γαμβρός",702950,4],["σου",711945,133],["Ιοθορ",706756,4],["παραγίνεται",710006,117],["πρὸς",710844,0],["σέ",711598,163],["καὶ",707031,7],["ἡ",709436,10],["γυνὴ",703209,12],["καὶ",707031,7],["οἱ",709436,136],["δύο",703849,59],["υἱοί",713075,52],["σου",711945,133],["μετ᾿",708780,0],["αὐτοῦ",702165,102]],"And it was told Moses, saying, Behold, thy father-in-law Jothor is coming to thee, and thy wife and two sons with him."],["7",[["ἐξῆλθεν",704909,2],["δὲ",703303,11],["Μωυσῆς",709112,4],["εἰς",704105,0],["συνάντησιν",712397,9],["τῷ",709436,113],["γαμβρῷ",702950,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["προσεκύνησεν",710925,2],["αὐτῷ",702165,50],["καὶ",707031,7],["ἐφίλησεν",713471,2],["αὐτόν",702165,85],["καὶ",707031,7],["ἠσπάσαντο",701987,189],["ἀλλήλους",700689,62],["καὶ",707031,7],["εἰσήγαγεν",704107,2],["αὐτὸν",702165,85],["εἰς",704105,0],["τὴν",709436,8],["σκηνήν",711845,9]],"And Moses went forth to meet his father-in-law, and did him reverence, and kissed him, and they embraced each other, and he brought them into the tent."],["8",[["καὶ",707031,7],["διηγήσατο",703679,23],["Μωυσῆς",709112,4],["τῷ",709436,113],["γαμβρῷ",702950,114],["πάντα",710177,68],["ὅσα",709788,68],["ἐποίησεν",710582,2],["κύριος",707996,4],["τῷ",709436,113],["Φαραω",713360,114],["καὶ",707031,7],["τοῖς",709436,147],["Αἰγυπτίοις",700400,148],["ἕνεκεν",704709,0],["τοῦ",709436,35],["Ισραηλ",706839,18],["καὶ",707031,7],["πάντα",710177,27],["τὸν",709436,5],["μόχθον",709039,6],["τὸν",709436,5],["γενόμενον",703104,424],["αὐτοῖς",702165,151],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["καὶ",707031,7],["ὅτι",709803,7],["ἐξείλατο",704838,23],["αὐτοὺς",702165,62],["κύριος",707996,4],["ἐκ",704132,0],["χειρὸς",713787,17],["Φαραω",713360,18],["καὶ",707031,7],["ἐκ",704132,0],["χειρὸς",713787,17],["τῶν",709436,80],["Αἰγυπτίων",700400,81]],"And Moses related to his father-in-law all things that the Lord did to Pharao and all the Egyptians for Israel's sake, and all the labour that had befallen them in the way, and that the Lord had rescued them out of the hand of Pharao, and out of the hand of the Egyptians."],["9",[["ἐξέστη",704940,2],["δὲ",703303,11],["Ιοθορ",706756,4],["ἐπὶ",705080,0],["πᾶσι",710177,94],["τοῖς",709436,95],["ἀγαθοῖς",700106,94],["οἷς",709781,295],["ἐποίησεν",710582,2],["αὐτοῖς",702165,151],["κύριος",707996,4],["ὅτι",709803,7],["ἐξείλατο",704838,23],["αὐτοὺς",702165,62],["ἐκ",704132,0],["χειρὸς",713787,17],["Αἰγυπτίων",700400,81],["καὶ",707031,7],["ἐκ",704132,0],["χειρὸς",713787,17],["Φαραω",713360,18]],"And Jothor was amazed at all the good things which the Lord did to them, forasmuch as he rescued them out of the hand of the Egyptians and out of the hand of Pharao."],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιοθορ",706756,4],["εὐλογητὸς",705632,14],["κύριος",707996,4],["ὅτι",709803,7],["ἐξείλατο",704838,23],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["ἐκ",704132,0],["χειρὸς",713787,17],["Αἰγυπτίων",700400,81],["καὶ",707031,7],["ἐκ",704132,0],["χειρὸς",713787,17],["Φαραω",713360,18]],"And Jothor said, Blessed be the Lord, because he has rescued them out of the hand of the Egyptians and out of the hand of Pharao."],["11",[["νῦν",709384,28],["ἔγνων",703105,155],["ὅτι",709803,7],["μέγας",708653,14],["κύριος",707996,4],["παρὰ",709995,0],["πάντας",710177,60],["τοὺς",709436,58],["θεούς",706192,57],["ἕνεκεν",704709,0],["τούτου",709858,49],["ὅτι",709803,7],["ἐπέθεντο",705304,189],["αὐτοῖς",702165,151]],"Now know I that the Lord is great above all gods, because of this, wherein they attacked them."],["12",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Ιοθορ",706756,4],["ὁ",709436,3],["γαμβρὸς",702950,4],["Μωυσῆ",709112,18],["ὁλοκαυτώματα",709589,42],["καὶ",707031,7],["θυσίας",706345,39],["τῷ",709436,113],["θεῷ",706192,114],["παρεγένετο",710006,23],["δὲ",703303,11],["Ααρων",700005,4],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["πρεσβύτεροι",710735,52],["Ισραηλ",706839,18],["συμφαγεῖν",712459,106],["ἄρτον",701829,6],["μετὰ",708780,0],["τοῦ",709436,35],["γαμβροῦ",702950,18],["Μωυσῆ",709112,18],["ἐναντίον",704654,0],["τοῦ",709436,35],["θεοῦ",706192,18]],"And Jothor the father-in-law of Moses took whole burnt-offerings and sacrifices for God, for Aaron and all the elders of Israel came to eat bread with the father-in-law of Moses before God."],["13",[["καὶ",707031,7],["ἐγένετο",703104,23],["μετὰ",708780,0],["τὴν",709436,8],["ἐπαύριον",705050,28],["συνεκάθισεν",712196,2],["Μωυσῆς",709112,4],["κρίνειν",707905,55],["τὸν",709436,5],["λαόν",708094,6],["παρειστήκει",710152,143],["δὲ",703303,11],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["Μωυσεῖ",709112,114],["ἀπὸ",701425,0],["πρωίθεν",711022,28],["ἕως",705792,0],["ἑσπέρας",705500,17]],"And it came to pass after the morrow that Moses sat to judge the people, and all the people stood by Moses from morning till evening."],["14",[["καὶ",707031,7],["ἰδὼν",709725,182],["Ιοθορ",706756,4],["πάντα",710177,68],["ὅσα",709788,68],["ἐποίει",710582,13],["τῷ",709436,113],["λαῷ",708094,114],["λέγει",708124,91],["τί",712867,273],["τοῦτο",709858,132],["ὃ",709781,33],["σὺ",712181,164],["ποιεῖς",710582,154],["τῷ",709436,113],["λαῷ",708094,114],["διὰ",703417,0],["τί",712867,126],["σὺ",712181,164],["κάθησαι",707000,259],["μόνος",709003,14],["πᾶς",710177,14],["δὲ",703303,11],["ὁ",709436,3],["λαὸς",708094,4],["παρέστηκέν",710152,171],["σοι",711925,159],["ἀπὸ",701425,0],["πρωίθεν",711022,28],["ἕως",705792,0],["δείλης",703324,82]],"And Jothor having seen all that [Moses] did to the people, says, What is this that thou doest to the people? wherefore sittest thou alone, and all the people stand by thee from morning till evening?"],["15",[["καὶ",707031,7],["λέγει",708124,91],["Μωυσῆς",709112,4],["τῷ",709436,113],["γαμβρῷ",702950,114],["ὅτι",709803,7],["παραγίνεται",710006,117],["πρός",710844,0],["με",708618,163],["ὁ",709436,3],["λαὸς",708094,4],["ἐκζητῆσαι",704187,106],["κρίσιν",707908,9],["παρὰ",709995,0],["τοῦ",709436,35],["θεοῦ",706192,18]],"And Moses says to his father-in-law, Because the people come to me to seek judgment from God."],["16",[["ὅταν",709801,28],["γὰρ",702963,11],["γένηται",703104,239],["αὐτοῖς",702165,151],["ἀντιλογία",701249,12],["καὶ",707031,7],["ἔλθωσι",705453,234],["πρός",710844,0],["με",708618,163],["διακρίνω",703488,157],["ἕκαστον",704133,27],["καὶ",707031,7],["συμβιβάζω",712280,157],["αὐτοὺς",702165,62],["τὰ",709436,41],["προστάγματα",710959,42],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["τὸν",709436,5],["νόμον",709349,6],["αὐτοῦ",702165,102]],"For whenever there is a dispute among them, and they come to me, I give judgment upon each, and I teach them the ordinances of God and his law."],["17",[["εἶπεν",705373,2],["δὲ",703303,11],["ὁ",709436,3],["γαμβρὸς",702950,4],["Μωυσῆ",709112,18],["πρὸς",710844,0],["αὐτόν",702165,85],["οὐκ",709805,28],["ὀρθῶς",709746,28],["σὺ",712181,164],["ποιεῖς",710582,154],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129]],"And the father-in-law of Moses said to him, Thou dost not this thing rightly,"],["18",[["φθορᾷ",713451,1],["καταφθαρήσῃ",707474,364],["ἀνυπομονήτῳ",701290,101],["καὶ",707031,7],["σὺ",712181,164],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["οὗτος",709858,121],["ὅς",709781,213],["ἐστιν",704093,91],["μετὰ",708780,0],["σοῦ",711945,133],["βαρύ",702554,26],["σοι",711925,159],["τὸ",709436,34],["ῥῆμα",711246,15],["τοῦτο",709858,132],["οὐ",709805,28],["δυνήσῃ",703838,123],["ποιεῖν",710582,55],["μόνος",709003,14]],"thou wilt wear away with intolerable weariness, both thou and all this people which is with thee: this thing is hard, thou wilt not be able to endure it thyself alone."],["19",[["νῦν",709384,28],["οὖν",709835,11],["ἄκουσόν",700587,176],["μου",709032,133],["καὶ",707031,7],["συμβουλεύσω",712292,165],["σοι",711925,159],["καὶ",707031,7],["ἔσται",704093,93],["ὁ",709436,3],["θεὸς",706192,4],["μετὰ",708780,0],["σοῦ",711945,133],["γίνου",703104,253],["σὺ",712181,164],["τῷ",709436,113],["λαῷ",708094,114],["τὰ",709436,41],["πρὸς",710844,0],["τὸν",709436,5],["θεὸν",706192,6],["καὶ",707031,7],["ἀνοίσεις",701083,166],["τοὺς",709436,58],["λόγους",708236,57],["αὐτῶν",702165,40],["πρὸς",710844,0],["τὸν",709436,5],["θεὸν",706192,6]],"Now then hearken to me, and I will advise thee, and God shall be with thee: be thou to the people in the things pertaining to God, and thou shalt bring their matters to God."],["20",[["καὶ",707031,7],["διαμαρτυρῇ",703513,123],["αὐτοῖς",702165,151],["τὰ",709436,41],["προστάγματα",710959,42],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["τὸν",709436,5],["νόμον",709349,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["σημανεῖς",711745,166],["αὐτοῖς",702165,151],["τὰς",709436,38],["ὁδούς",709458,39],["ἐν",704639,0],["αἷς",709781,281],["πορεύσονται",710667,135],["ἐν",704639,0],["αὐταῖς",702165,200],["καὶ",707031,7],["τὰ",709436,41],["ἔργα",705396,42],["ἃ",709781,69],["ποιήσουσιν",710582,218]],"And thou shalt testify to them the ordinances of God and his law, and thou shalt shew to them the ways in which they shall walk, and the works which they shall do."],["21",[["καὶ",707031,7],["σὺ",712181,164],["σεαυτῷ",711599,50],["σκέψαι",711840,300],["ἀπὸ",701425,0],["παντὸς",710177,116],["τοῦ",709436,35],["λαοῦ",708094,18],["ἄνδρας",701150,57],["δυνατοὺς",703845,60],["θεοσεβεῖς",706194,60],["ἄ