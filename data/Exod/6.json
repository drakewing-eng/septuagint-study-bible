[["1",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["ἤδη",705939,28],["ὄψει",709725,123],["ἃ",709781,69],["ποιήσω",710582,165],["τῷ",709436,113],["Φαραω",713360,114],["ἐν",704639,0],["γὰρ",702963,11],["χειρὶ",713787,1],["κραταιᾷ",707873,101],["ἐξαποστελεῖ",704872,127],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἐν",704639,0],["βραχίονι",702808,114],["ὑψηλῷ",713285,30],["ἐκβαλεῖ",704145,127],["αὐτοὺς",702165,62],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17],["αὐτοῦ",702165,102]],"And the Lord said to Moses, Now thou shalt see what I will do to Pharao; for he shall send them forth with a mighty hand, and with a high arm shall he cast them out of his land."],["2",[["ἐλάλησεν",708071,2],["δὲ",703303,11],["ὁ",709436,3],["θεὸς",706192,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτόν",702165,85],["ἐγὼ",704018,164],["κύριος",707996,4]],"And God spoke to Moses and said to him, I [am] the Lord."],["3",[["καὶ",707031,7],["ὤφθην",709725,156],["πρὸς",710844,0],["Αβρααμ",700091,6],["καὶ",707031,7],["Ισαακ",706799,6],["καὶ",707031,7],["Ιακωβ",706401,6],["θεὸς",706192,4],["ὢν",704093,72],["αὐτῶν",702165,40],["καὶ",707031,7],["τὸ",709436,24],["ὄνομά",709666,25],["μου",709032,133],["κύριος",707996,4],["οὐκ",709805,28],["ἐδήλωσα",703402,155],["αὐτοῖς",702165,151]],"And I appeared to Abraam and Isaac and Jacob, being their God, but I did not manifest to them my name Lord."],["4",[["καὶ",707031,7],["ἔστησα",706846,155],["τὴν",709436,8],["διαθήκην",703456,9],["μου",709032,133],["πρὸς",710844,0],["αὐτοὺς",702165,62],["ὥστε",714164,7],["δοῦναι",703654,106],["αὐτοῖς",702165,151],["τὴν",709436,8],["γῆν",703083,9],["τῶν",709436,80],["Χαναναίων",713711,81],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["παρῳκήκασιν",710156,353],["ἐν",704639,0],["ᾗ",709781,108],["καὶ",707031,7],["παρῴκησαν",710156,150],["ἐπ᾿",705080,0],["αὐτῆς",702165,86]],"And I established my covenant with them, to give them the land of the Chananites, the land wherein they sojourned, in which also they dwelt as strangers."],["5",[["καὶ",707031,7],["ἐγὼ",704018,164],["εἰσήκουσα",704108,155],["τὸν",709436,5],["στεναγμὸν",712065,6],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ὃν",709781,112],["οἱ",709436,136],["Αἰγύπτιοι",700400,52],["καταδουλοῦνται",707245,269],["αὐτούς",702165,62],["καὶ",707031,7],["ἐμνήσθην",708960,156],["τῆς",709436,16],["διαθήκης",703456,17],["ὑμῶν",713091,145]],"And I hearkened to the groaning of the children of Israel (the affliction with which the Egyptians enslave them) and I remembered the covenant with you."],["6",[["βάδιζε",702367,240],["εἰπὸν",705373,176],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["λέγων",708124,72],["ἐγὼ",704018,164],["κύριος",707996,4],["καὶ",707031,7],["ἐξάξω",704834,165],["ὑμᾶς",713080,194],["ἀπὸ",701425,0],["τῆς",709436,16],["δυναστείας",703841,17],["τῶν",709436,80],["Αἰγυπτίων",700400,81],["καὶ",707031,7],["ῥύσομαι",711309,181],["ὑμᾶς",713080,194],["ἐκ",704132,0],["τῆς",709436,16],["δουλείας",703813,17],["καὶ",707031,7],["λυτρώσομαι",708282,181],["ὑμᾶς",713080,194],["ἐν",704639,0],["βραχίονι",702808,114],["ὑψηλῷ",713285,30],["καὶ",707031,7],["κρίσει",707908,1],["μεγάλῃ",708653,101]],"Go, speak to the children of Israel, saying, I [am] the Lord; and I will lead you forth from the tyranny of the Egyptians, and I will deliver you from bondage, and I will ransom you with a high arm, and great judgment."],["7",[["καὶ",707031,7],["λήμψομαι",708076,181],["ἐμαυτῷ",704545,50],["ὑμᾶς",713080,194],["λαὸν",708094,6],["ἐμοὶ",704577,159],["καὶ",707031,7],["ἔσομαι",704093,181],["ὑμῶν",713091,145],["θεός",706192,4],["καὶ",707031,7],["γνώσεσθε",703105,124],["ὅτι",709803,7],["ἐγὼ",704018,164],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὑμῶν",713091,145],["ὁ",709436,3],["ἐξαγαγὼν",704834,182],["ὑμᾶς",713080,194],["ἐκ",704132,0],["τῆς",709436,16],["καταδυναστείας",707247,17],["τῶν",709436,80],["Αἰγυπτίων",700400,81]],"And I will take you to me a people for myself, and will be your God; and ye shall know that I am the Lord your God, who brought you out from the tyranny of the Egyptians."],["8",[["καὶ",707031,7],["εἰσάξω",704107,165],["ὑμᾶς",713080,194],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["εἰς",704105,0],["ἣν",709781,131],["ἐξέτεινα",704322,155],["τὴν",709436,8],["χεῖρά",713787,9],["μου",709032,133],["δοῦναι",703654,106],["αὐτὴν",702165,104],["τῷ",709436,113],["Αβρααμ",700091,114],["καὶ",707031,7],["Ισαακ",706799,114],["καὶ",707031,7],["Ιακωβ",706401,114],["καὶ",707031,7],["δώσω",703654,165],["ὑμῖν",713084,90],["αὐτὴν",702165,104],["ἐν",704639,0],["κλήρῳ",707727,114],["ἐγὼ",704018,164],["κύριος",707996,4]],"And I will bring you into the land concerning which I stretched out my hand to give it to Abraam and Isaac and Jacob, and I will give it you for an inheritance: I [am] the Lord."],["9",[["ἐλάλησεν",708071,2],["δὲ",703303,11],["Μωυσῆς",709112,4],["οὕτως",709859,28],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["καὶ",707031,7],["οὐκ",709805,28],["εἰσήκουσαν",704108,150],["Μωυσῇ",709112,114],["ἀπὸ",701425,0],["τῆς",709436,16],["ὀλιγοψυχίας",709573,17],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,43],["ἔργων",705396,44],["τῶν",709436,43],["σκληρῶν",711861,83]],"And Moses spoke thus to the sons of Israel, and they hearkened not to Moses for faint-heartedness, and for their hard tasks."],["10",[["εἶπεν",705373,2],["δὲ",703303,11],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["11",[["εἴσελθε",704114,176],["λάλησον",708071,176],["Φαραω",713360,114],["βασιλεῖ",702580,114],["Αἰγύπτου",700401,17],["ἵνα",706747,7],["ἐξαποστείλῃ",704872,172],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ισραηλ",706839,18],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17],["αὐτοῦ",702165,102]],"Go in, speak to Pharao king of Egypt, that he send forth the children of Israel out of his land."],["12",[["ἐλάλησεν",708071,2],["δὲ",703303,11],["Μωυσῆς",709112,4],["ἔναντι",704653,0],["κυρίου",707996,18],["λέγων",708124,72],["ἰδοὺ",706497,88],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["οὐκ",709805,28],["εἰσήκουσάν",704108,150],["μου",709032,133],["καὶ",707031,7],["πῶς",711121,28],["εἰσακούσεταί",704108,93],["μου",709032,133],["Φαραω",713360,4],["ἐγὼ",704018,164],["δὲ",703303,11],["ἄλογός",700721,14],["εἰμι",704093,157]],"And Moses spoke before the Lord, saying, Behold, the children of Israel hearkened not to me, and how shall Pharao hearken to me? and I am not eloquent."],["13",[["εἶπεν",705373,2],["δὲ",703303,11],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["καὶ",707031,7],["Ααρων",700005,6],["καὶ",707031,7],["συνέταξεν",712508,2],["αὐτοῖς",702165,151],["πρὸς",710844,0],["Φαραω",713360,6],["βασιλέα",702580,6],["Αἰγύπτου",700401,17],["ὥστε",714164,7],["ἐξαποστεῖλαι",704872,106],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ισραηλ",706839,18],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17]],"And the Lord spoke to Moses and Aaron, and gave them a charge to Pharao king of Egypt, that he should send forth the children of Israel out of the land of Egypt."],["14",[["καὶ",707031,7],["οὗτοι",709858,201],["ἀρχηγοὶ",701838,52],["οἴκων",709516,81],["πατριῶν",710195,169],["αὐτῶν",702165,40],["υἱοὶ",713075,52],["Ρουβην",711295,18],["πρωτοτόκου",711046,116],["Ισραηλ",706839,18],["Ενωχ",704827,4],["καὶ",707031,7],["Φαλλους",713336,4],["Ασρων",701992,4],["καὶ",707031,7],["Χαρμι",713742,4],["αὕτη",709858,107],["ἡ",709436,10],["συγγένεια",712184,12],["Ρουβην",711295,18]],"And these are the heads of the houses of their families: the sons of Ruben the first-born of Israel; Enoch and Phallus, Asron, and Charmi, this is the kindred of Ruben."],["15",[["καὶ",707031,7],["υἱοὶ",713075,52],["Συμεων",712297,18],["Ιεμουηλ",706594,4],["καὶ",707031,7],["Ιαμιν",706409,4],["καὶ",707031,7],["Αωδ",702323,4],["καὶ",707031,7],["Ιαχιν",706464,4],["καὶ",707031,7],["Σααρ",711328,4],["καὶ",707031,7],["Σαουλ",711499,4],["ὁ",709436,3],["ἐκ",704132,0],["τῆς",709436,16],["Φοινίσσης",713542,17],["αὗται",709858,202],["αἱ",709436,190],["πατριαὶ",710192,191],["τῶν",709436,80],["υἱῶν",713075,81],["Συμεων",712297,18]],"And the sons of Symeon, Jemuel and Jamin, and Aod, and Jachin and Saar, and Saul the son of a Phœnician woman, these are the families of the sons of Symeon."],["16",[["καὶ",707031,7],["ταῦτα",709858,290],["τὰ",709436,63],["ὀνόματα",709666,64],["τῶν",709436,80],["υἱῶν",713075,81],["Λευι",708158,18],["κατὰ",707200,0],["συγγενείας",712184,39],["αὐτῶν",702165,40],["Γεδσων",702999,4],["Κααθ",706961,4],["καὶ",707031,7],["Μεραρι",708739,4],["καὶ",707031,7],["τὰ",709436,63],["ἔτη",705543,64],["τῆς",709436,16],["ζωῆς",705910,17],["Λευι",708158,18],["ἑκατὸν",704136,59],["τριάκοντα",712934,59],["ἑπτά",705357,59]],"And these are the names of the sons of Levi according to their kindreds, Gedson, Caath, and Merari; and the years of the life of Levi were a hundred and thirty-seven."],["17",[["καὶ",707031,7],["οὗτοι",709858,201],["υἱοὶ",713075,52],["Γεδσων",702999,18],["Λοβενι",708226,4],["καὶ",707031,7],["Σεμεϊ",711666,4],["οἶκοι",709516,52],["πατριᾶς",710192,17],["αὐτῶν",702165,40]],"And these are the sons of Gedson, Lobeni and Semei, the houses of their family. And the sons of Caath,"],["18",[["καὶ",707031,7],["υἱοὶ",713075,52],["Κααθ",706961,18],["Αμβραμ",700794,4],["καὶ",707031,7],["Ισσααρ",706841,4],["Χεβρων",713777,4],["καὶ",707031,7],["Οζιηλ",709477,4],["καὶ",707031,7],["τὰ",709436,63],["ἔτη",705543,64],["τῆς",709436,16],["ζωῆς",705910,17],["Κααθ",706961,18],["ἑκατὸν",704136,59],["τριάκοντα",712934,59],["ἔτη",705543,64]],"Ambram and Issaar, Chebron, and Oziel; and the years of the life of Caath were a hundred and thirty-three years."],["19",[["καὶ",707031,7],["υἱοὶ",713075,52],["Μεραρι",708739,18],["Μοολι",709010,4],["καὶ",707031,7],["Ομουσι",709645,4],["οὗτοι",709858,201],["οἶκοι",709516,52],["πατριῶν",710195,169],["Λευι",708158,18],["κατὰ",707200,0],["συγγενείας",712184,39],["αὐτῶν",702165,40]],"And the sons of Merari, Moöli, and Omusi, these are the houses of the families of Levi, according to their kindreds."],["20",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Αμβραμ",700794,4],["τὴν",709436,8],["Ιωχαβεδ",706956,9],["θυγατέρα",706320,9],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["ἑαυτῷ",703917,50],["εἰς",704105,0],["γυναῖκα",703209,9],["καὶ",707031,7],["ἐγέννησεν",703051,2],["αὐτῷ",702165,50],["τόν",709436,5],["τε",712751,11],["Ααρων",700005,6],["καὶ",707031,7],["Μωυσῆν",709112,6],["καὶ",707031,7],["Μαριαμ",708506,9],["τὴν",709436,8],["ἀδελφὴν",700244,9],["αὐτῶν",702165,40],["τὰ",709436,63],["δὲ",703303,11],["ἔτη",705543,64],["τῆς",709436,16],["ζωῆς",705910,17],["Αμβραμ",700794,18],["ἑκατὸν",704136,59],["τριάκοντα",712934,59],["δύο",703849,59],["ἔτη",705543,42]],"And Ambram took to wife Jochabed the daughter of his father's brother, and she bore to him both Aaron and Moses, and Mariam their sister: and the years of the life of Ambram were a hundred and thirty-two years."],["21",[["καὶ",707031,7],["υἱοὶ",713075,52],["Ισσααρ",706841,18],["Κορε",707833,4],["καὶ",707031,7],["Ναφεκ",709212,4],["καὶ",707031,7],["Ζεχρι",705867,4]],"And the sons of Issaar, Core, and Naphec, and Zechri."],["22",[["καὶ",707031,7],["υἱοὶ",713075,52],["Οζιηλ",709477,18],["Ελισαφαν",704487,4],["καὶ",707031,7],["Σετρι",711715,4]],"And the sons of Oziel, Misael, and Elisaphan, and Segri."],["23",[["ἔλαβεν",708076,2],["δὲ",703303,11],["Ααρων",700005,4],["τὴν",709436,8],["Ελισαβεθ",704480,9],["θυγατέρα",706320,9],["Αμιναδαβ",700824,18],["ἀδελφὴν",700244,9],["Ναασσων",709127,18],["αὐτῷ",702165,50],["γυναῖκα",703209,9],["καὶ",707031,7],["ἔτεκεν",712853,2],["αὐτῷ",702165,50],["τόν",709436,5],["τε",712751,11],["Ναδαβ",709156,6],["καὶ",707031,7],["Αβιουδ",700071,6],["καὶ",707031,7],["Ελεαζαρ",704407,6],["καὶ",707031,7],["Ιθαμαρ",706704,6]],"And Aaron took to himself to wife Elisabeth daughter of Aminadab sister of Naasson, and she bore to him both Nadab and Abiud, and Eleazar and Ithamar."],["24",[["υἱοὶ",713075,52],["δὲ",703303,11],["Κορε",707833,18],["Ασιρ",701958,4],["καὶ",707031,7],["Ελκανα",704504,4],["καὶ",707031,7],["Αβιασαφ",700056,4],["αὗται",709858,202],["αἱ",709436,190],["γενέσεις",703043,191],["Κορε",707833,18]],"And the sons of Core, Asir, and Elkana, and Abiasar, these are the generations of Core."],["25",[["καὶ",707031,7],["Ελεαζαρ",704407,4],["ὁ",709436,3],["τοῦ",709436,35],["Ααρων",700005,18],["ἔλαβεν",708076,2],["τῶν",709436,130],["θυγατέρων",706320,65],["Φουτιηλ",713569,18],["αὐτῷ",702165,50],["γυναῖκα",703209,9],["καὶ",707031,7],["ἔτεκεν",712853,2],["αὐτῷ",702165,50],["τὸν",709436,5],["Φινεες",713510,6],["αὗται",709858,202],["αἱ",709436,190],["ἀρχαὶ",701836,191],["πατριᾶς",710192,17],["Λευιτῶν",708160,81],["κατὰ",707200,0],["γενέσεις",703043,39],["αὐτῶν",702165,40]],"And Eleazar the son of Aaron took to himself for a wife [one] of the daughters of Phutiel, and she bore to him Phinees. These are the heads of the family of the Levites, according to their generations."],["26",[["οὗτος",709858,121],["Ααρων",700005,4],["καὶ",707031,7],["Μωυσῆς",709112,4],["οἷς",709781,311],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["ὁ",709436,3],["θεὸς",706192,4],["ἐξαγαγεῖν",704834,106],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ισραηλ",706839,18],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["σὺν",712372,0],["δυνάμει",703839,1],["αὐτῶν",702165,40]],"This is Aaron and Moses, whom God told to bring out the children of Israel out of the land of Egypt with their forces."],["27",[["οὗτοί",709858,201],["εἰσιν",704093,197],["οἱ",709436,136],["διαλεγόμενοι",703495,348],["πρὸς",710844,0],["Φαραω",713360,6],["βασιλέα",702580,6],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ἐξήγαγον",704834,150],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ισραηλ",706839,18],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["αὐτὸς",702165,121],["Ααρων",700005,4],["καὶ",707031,7],["Μωυσῆς",709112,4]],"These are they that spoke with Pharao king of Egypt, and Aaron himself and Moses brought out the children of Israel from the land of Egypt,"],["28",[["ᾗ",709781,108],["ἡμέρᾳ",705984,1],["ἐλάλησεν",708071,2],["κύριος",707996,4],["Μωυσῇ",709112,114],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτῳ",700401,1]],"in the day in which the Lord spoke to Moses in the land of Egypt;"],["29",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72],["ἐγὼ",704018,164],["κύριος",707996,4],["λάλησον",708071,176],["πρὸς",710844,0],["Φαραω",713360,6],["βασιλέα",702580,6],["Αἰγύπτου",700401,17],["ὅσα",709788,68],["ἐγὼ",704018,164],["λέγω",708124,157],["πρὸς",710844,0],["σέ",711598,163]],"then the Lord spoke to Moses, saying, I am the Lord: speak to Pharao king of Egypt whatsoever I say to thee."],["30",[["καὶ",707031,7],["εἶπεν",705373,2],["Μωυσῆς",709112,4],["ἐναντίον",704654,0],["κυρίου",707996,18],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἰσχνόφωνός",706854,14],["εἰμι",704093,157],["καὶ",707031,7],["πῶς",711121,28],["εἰσακούσεταί",704108,93],["μου",709032,133],["Φαραω",713360,4]],"And Moses said before the Lord, Behold, I am not able in speech, and how shall Pharao hearken to me?"]]