[["1",[["καὶ",707031,7],["ποιήσεις",710582,166],["θυσιαστήριον",706348,25],["θυμιάματος",706330,21],["ἐκ",704132,0],["ξύλων",709427,44],["ἀσήπτων",701933,83],["καὶ",707031,7],["ποιήσεις",710582,166],["αὐτὸ",702165,129]],"And thou shalt make the altar of incense of incorruptible wood."],["2",[["πήχεος",710462,18],["τὸ",709436,24],["μῆκος",708868,25],["καὶ",707031,7],["πήχεος",710462,18],["τὸ",709436,34],["εὖρος",705677,15],["τετράγωνον",712812,26],["ἔσται",704093,93],["καὶ",707031,7],["δύο",703849,59],["πήχεων",710462,81],["τὸ",709436,24],["ὕψος",713288,25],["ἐξ",704132,0],["αὐτοῦ",702165,49],["ἔσται",704093,93],["τὰ",709436,63],["κέρατα",707625,64],["αὐτοῦ",702165,49]],"And thou shalt make it a cubit in length, and a cubit in breadth: it shall be square; and the height of it shall be of two cubits, its horns shall be of the same piece."],["3",[["καὶ",707031,7],["καταχρυσώσεις",707496,166],["αὐτὰ",702165,71],["χρυσίῳ",713972,54],["καθαρῷ",706988,97],["τὴν",709436,8],["ἐσχάραν",705514,9],["αὐτοῦ",702165,49],["καὶ",707031,7],["τοὺς",709436,58],["τοίχους",712879,57],["αὐτοῦ",702165,49],["κύκλῳ",707959,114],["καὶ",707031,7],["τὰ",709436,41],["κέρατα",707625,42],["αὐτοῦ",702165,49],["καὶ",707031,7],["ποιήσεις",710582,166],["αὐτῷ",702165,280],["στρεπτὴν",712158,36],["στεφάνην",712081,9],["χρυσῆν",713971,36],["κύκλῳ",707959,114]],"And thou shalt gild its grate with pure gold, and its sides round about, and its horns; and thou shalt make for it a wreathen border of gold round-about."],["4",[["καὶ",707031,7],["δύο",703849,59],["δακτυλίους",703258,57],["χρυσοῦς",713971,60],["καθαροὺς",706988,60],["ποιήσεις",710582,166],["ὑπὸ",713184,0],["τὴν",709436,8],["στρεπτὴν",712158,36],["στεφάνην",712081,9],["αὐτοῦ",702165,49],["εἰς",704105,0],["τὰ",709436,41],["δύο",703849,59],["κλίτη",707740,42],["ποιήσεις",710582,166],["ἐν",704639,0],["τοῖς",709436,95],["δυσὶ",703849,405],["πλευροῖς",710525,96],["καὶ",707031,7],["ἔσονται",704093,135],["ψαλίδες",714020,191],["ταῖς",709436,75],["σκυτάλαις",711904,76],["ὥστε",714164,7],["αἴρειν",700473,55],["αὐτὸ",702165,129],["ἐν",704639,0],["αὐταῖς",702165,200]],"And thou shalt make under its wreathen border two rings of pure gold; thou shalt make it to the two corners on the two sides, and they shall be bearings for the staves, so as to bear it with them."],["5",[["καὶ",707031,7],["ποιήσεις",710582,166],["σκυτάλας",711904,39],["ἐκ",704132,0],["ξύλων",709427,44],["ἀσήπτων",701933,83],["καὶ",707031,7],["καταχρυσώσεις",707496,166],["αὐτὰς",702165,231],["χρυσίῳ",713972,54]],"And thou shalt make the staves of incorruptible wood, and shalt gild them with gold."],["6",[["καὶ",707031,7],["θήσεις",712849,166],["αὐτὸ",702165,129],["ἀπέναντι",701389,0],["τοῦ",709436,20],["καταπετάσματος",707370,21],["τοῦ",709436,20],["ὄντος",704093,294],["ἐπὶ",705080,0],["τῆς",709436,16],["κιβωτοῦ",707667,17],["τῶν",709436,43],["μαρτυρίων",708525,44],["ἐν",704639,0],["οἷς",709781,311],["γνωσθήσομαί",703105,180],["σοι",711925,159],["ἐκεῖθεν",704182,28]],"And thou shalt set it before the veil that is over the ark of the testimonies, wherein I will make myself known to thee from thence."],["7",[["καὶ",707031,7],["θυμιάσει",706332,127],["ἐπ᾿",705080,0],["αὐτοῦ",702165,49],["Ααρων",700005,4],["θυμίαμα",706330,25],["σύνθετον",712476,46],["λεπτόν",708153,46],["τὸ",709436,24],["πρωὶ",711021,28],["πρωί",711021,28],["ὅταν",709801,28],["ἐπισκευάζῃ",705251,204],["τοὺς",709436,58],["λύχνους",708287,57],["θυμιάσει",706332,127],["ἐπ᾿",705080,0],["αὐτοῦ",702165,49]],"And Aaron shall burn upon it fine compound incense every morning; whensoever he trims the lamps he shall burn incense upon it."],["8",[["καὶ",707031,7],["ὅταν",709801,28],["ἐξάπτῃ",704874,204],["Ααρων",700005,4],["τοὺς",709436,58],["λύχνους",708287,57],["ὀψέ",709896,28],["θυμιάσει",706332,127],["ἐπ᾿",705080,0],["αὐτοῦ",702165,49],["θυμίαμα",706330,15],["ἐνδελεχισμοῦ",704680,18],["διὰ",703417,0],["παντὸς",710177,116],["ἔναντι",704653,0],["κυρίου",707996,18],["εἰς",704105,0],["γενεὰς",703037,39],["αὐτῶν",702165,40]],"And when Aaron lights the lamps in the evening, he shall burn incense upon it; a constant incense-offering always before the Lord for their generations."],["9",[["καὶ",707031,7],["οὐκ",709805,28],["ἀνοίσεις",701083,166],["ἐπ᾿",705080,0],["αὐτοῦ",702165,49],["θυμίαμα",706330,25],["ἕτερον",705535,46],["κάρπωμα",707174,25],["θυσίαν",706345,9],["καὶ",707031,7],["σπονδὴν",712025,9],["οὐ",709805,28],["σπείσεις",712007,166],["ἐπ᾿",705080,0],["αὐτοῦ",702165,49]],"And thou shalt not offer strange incense upon it, [nor] an offering made by fire, [nor] a sacrifice; and thou shalt not pour a drink-offering upon it."],["10",[["καὶ",707031,7],["ἐξιλάσεται",704932,93],["ἐπ᾿",705080,0],["αὐτὸ",702165,129],["Ααρων",700005,4],["ἐπὶ",705080,0],["τῶν",709436,43],["κεράτων",707625,44],["αὐτοῦ",702165,49],["ἅπαξ",701350,28],["τοῦ",709436,35],["ἐνιαυτοῦ",704745,18],["ἀπὸ",701425,0],["τοῦ",709436,20],["αἵματος",700442,21],["τοῦ",709436,35],["καθαρισμοῦ",706987,18],["τῶν",709436,130],["ἁμαρτιῶν",700775,65],["τοῦ",709436,35],["ἐξιλασμοῦ",704934,18],["ἅπαξ",701350,28],["τοῦ",709436,35],["ἐνιαυτοῦ",704745,18],["καθαριεῖ",706985,127],["αὐτὸ",702165,129],["εἰς",704105,0],["τὰς",709436,38],["γενεὰς",703037,39],["αὐτῶν",702165,40],["ἅγιον",700159,46],["τῶν",709436,43],["ἁγίων",700159,83],["ἐστὶν",704093,91],["κυρίῳ",707996,114]],"And once in the year Aaron shall make atonement on its horns, he shall purge it with the blood of purification for their generations: it is most holy to the Lord."],["11",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["12",[["ἐὰν",703912,7],["λάβῃς",708076,175],["τὸν",709436,5],["συλλογισμὸν",712268,6],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ἐν",704639,0],["τῇ",709436,100],["ἐπισκοπῇ",705255,1],["αὐτῶν",702165,40],["καὶ",707031,7],["δώσουσιν",703654,218],["ἕκαστος",704133,14],["λύτρα",708281,42],["τῆς",709436,16],["ψυχῆς",714070,17],["αὐτοῦ",702165,102],["τῷ",709436,113],["κυρίῳ",707996,114],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ἐν",704639,0],["αὐτοῖς",702165,151],["πτῶσις",711072,12],["ἐν",704639,0],["τῇ",709436,100],["ἐπισκοπῇ",705255,1],["αὐτῶν",702165,40]],"If thou take account of the children of Israel in the surveying of them, and they shall give every one a ransom for his soul to the Lord, then there shall not be among them a destruction in the visiting of them."],["13",[["καὶ",707031,7],["τοῦτό",709858,132],["ἐστιν",704093,91],["ὃ",709781,128],["δώσουσιν",703654,218],["ὅσοι",709788,138],["ἂν",700900,11],["παραπορεύωνται",710094,380],["τὴν",709436,8],["ἐπίσκεψιν",705252,9],["τὸ",709436,24],["ἥμισυ",705998,46],["τοῦ",709436,20],["διδράχμου",703651,21],["ὅ",709781,33],["ἐστιν",704093,91],["κατὰ",707200,0],["τὸ",709436,24],["δίδραχμον",703651,25],["τὸ",709436,24],["ἅγιον",700159,46],["εἴκοσι",704085,59],["ὀβολοὶ",709441,52],["τὸ",709436,34],["δίδραχμον",703651,15],["τὸ",709436,34],["δὲ",703303,11],["ἥμισυ",705998,46],["τοῦ",709436,20],["διδράχμου",703651,21],["εἰσφορὰ",704128,12],["κυρίῳ",707996,114]],"And this is what they shall give, as many as pass the survey, half a didrachm which is according to the didrachm of the sanctuary: twenty oboli [go to] the didrachm, but the half of the didrachm is the offering to the Lord."],["14",[["πᾶς",710177,14],["ὁ",709436,3],["παραπορευόμενος",710094,122],["εἰς",704105,0],["τὴν",709436,8],["ἐπίσκεψιν",705252,9],["ἀπὸ",701425,0],["εἰκοσαετοῦς",704084,116],["καὶ",707031,7],["ἐπάνω",705030,28],["δώσουσιν",703654,218],["τὴν",709436,8],["εἰσφορὰν",704128,9],["κυρίῳ",707996,114]],"Every one that passes the survey from twenty years old and upwards shall give the offering to the Lord."],["15",[["ὁ",709436,3],["πλουτῶν",710561,72],["οὐ",709805,28],["προσθήσει",710965,127],["καὶ",707031,7],["ὁ",709436,3],["πενόμενος",710256,122],["οὐκ",709805,28],["ἐλαττονήσει",704392,127],["ἀπὸ",701425,0],["τοῦ",709436,20],["ἡμίσους",705998,92],["τοῦ",709436,20],["διδράχμου",703651,21],["ἐν",704639,0],["τῷ",709436,53],["διδόναι",703654,55],["τὴν",709436,8],["εἰσφορὰν",704128,9],["κυρίῳ",707996,114],["ἐξιλάσασθαι",704932,109],["περὶ",710285,0],["τῶν",709436,130],["ψυχῶν",714070,65],["ὑμῶν",713091,145]],"The rich shall not give more, and the poor shall not give less than the half didrachm in giving the offering to the Lord, to make atonement for your souls."],["16",[["καὶ",707031,7],["λήμψῃ",708076,123],["τὸ",709436,24],["ἀργύριον",701707,25],["τῆς",709436,16],["εἰσφορᾶς",704128,17],["παρὰ",709995,0],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["καὶ",707031,7],["δώσεις",703654,166],["αὐτὸ",702165,129],["εἰς",704105,0],["κάτεργον",707517,25],["τῆς",709436,16],["σκηνῆς",711845,17],["τοῦ",709436,20],["μαρτυρίου",708525,21],["καὶ",707031,7],["ἔσται",704093,93],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["μνημόσυνον",708966,15],["ἔναντι",704653,0],["κυρίου",707996,18],["ἐξιλάσασθαι",704932,109],["περὶ",710285,0],["τῶν",709436,130],["ψυχῶν",714070,65],["ὑμῶν",713091,145]],"And thou shalt take the money of the offering from the children of Israel, and shalt give it for the service of the tabernacle of testimony; and it shall be to the children of Israel a memorial before the Lord, to make atonement for your souls."],["17",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["18",[["ποίησον",710582,176],["λουτῆρα",708256,6],["χαλκοῦν",713690,27],["καὶ",707031,7],["βάσιν",702585,9],["αὐτῷ",702165,50],["χαλκῆν",713690,36],["ὥστε",714164,7],["νίπτεσθαι",709314,110],["καὶ",707031,7],["θήσεις",712849,166],["αὐτὸν",702165,85],["ἀνὰ",700902,0],["μέσον",708768,46],["τῆς",709436,16],["σκηνῆς",711845,17],["τοῦ",709436,20],["μαρτυρίου",708525,21],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,46],["τοῦ",709436,20],["θυσιαστηρίου",706348,21],["καὶ",707031,7],["ἐκχεεῖς",704368,166],["εἰς",704105,0],["αὐτὸν",702165,85],["ὕδωρ",713071,25]],"Make a brazen laver, and a brazen base for it, for washing; and thou shalt put it between the tabernacle of witness and the altar, and thou shalt pour forth water into it."],["19",[["καὶ",707031,7],["νίψεται",709314,93],["Ααρων",700005,4],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτοῦ",702165,102],["ἐξ",704132,0],["αὐτοῦ",702165,102],["τὰς",709436,38],["χεῖρας",713787,39],["καὶ",707031,7],["τοὺς",709436,58],["πόδας",710707,57],["ὕδατι",713071,54]],"And Aaron and his sons shall wash their hands and their feet with water from it."],["20",[["ὅταν",709801,28],["εἰσπορεύωνται",704124,380],["εἰς",704105,0],["τὴν",709436,8],["σκηνὴν",711845,9],["τοῦ",709436,20],["μαρτυρίου",708525,21],["νίψονται",709314,135],["ὕδατι",713071,54],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἀποθάνωσιν",701461,234],["ἢ",705924,7],["ὅταν",709801,28],["προσπορεύωνται",710954,380],["πρὸς",710844,0],["τὸ",709436,24],["θυσιαστήριον",706348,25],["λειτουργεῖν",708132,55],["καὶ",707031,7],["ἀναφέρειν",701083,55],["τὰ",709436,41],["ὁλοκαυτώματα",709589,42],["κυρίῳ",707996,114]],"Whensoever they shall go into the tabernacle of witness, they shall wash themselves with water, so they shall not die, whensoever they advance to the altar to do service and to offer the whole burnt-offerings to the Lord."],["21",[["νίψονται",709314,135],["τὰς",709436,38],["χεῖρας",713787,39],["καὶ",707031,7],["τοὺς",709436,58],["πόδας",710707,57],["ὕδατι",713071,54],["ὅταν",709801,28],["εἰσπορεύωνται",704124,380],["εἰς",704105,0],["τὴν",709436,8],["σκηνὴν",711845,9],["τοῦ",709436,20],["μαρτυρίου",708525,21],["νίψονται",709314,135],["ὕδατι",713071,54],["ἵνα",706747,7],["μὴ",708851,28],["ἀποθάνωσιν",701461,234],["καὶ",707031,7],["ἔσται",704093,93],["αὐτοῖς",702165,151],["νόμιμον",709340,26],["αἰώνιον",700505,26],["αὐτῷ",702165,50],["καὶ",707031,7],["ταῖς",709436,75],["γενεαῖς",703037,76],["αὐτοῦ",702165,102],["μετ᾿",708780,0],["αὐτόν",702165,85]],"They shall wash their hands and feet with water, whensoever they shall go into the tabernacle of witness; they shall wash themselves with water, that they die not; and it shall be for them a perpetual statute, for him and his posterity after him."],["22",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λέγων",708124,72]],"And the Lord spoke to Moses, saying,"],["23",[["καὶ",707031,7],["σὺ",712181,164],["λαβὲ",708076,176],["ἡδύσματα",705946,42],["τὸ",709436,24],["ἄνθος",701157,25],["σμύρνης",711914,17],["ἐκλεκτῆς",704240,82],["πεντακοσίους",710261,60],["σίκλους",711786,57],["καὶ",707031,7],["κινναμώμου",707683,21],["εὐώδους",705733,92],["τὸ",709436,24],["ἥμισυ",705998,46],["τούτου",709858,102],["διακοσίους",703482,60],["πεντήκοντα",710270,59],["καὶ",707031,7],["καλάμου",707082,18],["εὐώδους",705733,116],["διακοσίους",703482,60],["πεντήκοντα",710270,59]],"Do thou also take sweet herbs, the flower of choice myrrh five hundred shekels, and the half of this two hundred and fifty shekels of sweet-smelling cinnamon, and two hundred and fifty shekels of sweet-smelling calamus,"],["24",[["καὶ",707031,7],["ἴρεως",706798,17],["πεντακοσίους",710261,60],["σίκλους",711786,57],["τοῦ",709436,20],["ἁγίου",700159,92],["καὶ",707031,7],["ἔλαιον",704380,25],["ἐξ",704132,0],["ἐλαίων",704380,44],["ιν",706746,25]],"and of cassia five hundred shekels of the sanctuary, and a hin of olive oil."],["25",[["καὶ",707031,7],["ποιήσεις",710582,166],["αὐτὸ",702165,129],["ἔλαιον",704380,25],["χρῖσμα",713963,25],["ἅγιον",700159,46],["μύρον",709072,25],["μυρεψικὸν",709060,25],["τέχνῃ",712831,1],["μυρεψοῦ",709061,18],["ἔλαιον",704380,15],["χρῖσμα",713963,15],["ἅγιον",700159,26],["ἔσται",704093,93]],"And thou shalt make it a holy anointing oil, a perfumed ointment [tempered] by the art of the perfumer: it shall be a holy anointing oil."],["26",[["καὶ",707031,7],["χρίσεις",713965,166],["ἐξ",704132,0],["αὐτοῦ",702165,102],["τὴν",709436,8],["σκηνὴν",711845,9],["τοῦ",709436,20],["μαρτυρίου",708525,21],["καὶ",707031,7],["τὴν",709436,8],["κιβωτὸν",707667,9],["τοῦ",709436,20],["μαρτυρίου",708525,21]],"And thou shalt anoint with it the tabernacle of witness, and the ark of the tabernacle of witness,"],["27",[["καὶ",707031,7],["τὴν",709436,8],["λυχνίαν",708286,9],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["σκεύη",711844,42],["αὐτῆς",702165,86],["καὶ",707031,7],["τὸ",709436,24],["θυσιαστήριον",706348,25],["τοῦ",709436,20],["θυμιάματος",706330,21]],"and all its furniture, and the candlestick and all its furniture, and the altar of incense,"],["28",[["καὶ",707031,7],["τὸ",709436,24],["θυσιαστήριον",706348,25],["τῶν",709436,43],["ὁλοκαυτωμάτων",709589,44],["καὶ",707031,7],["πάντα",710177,68],["αὐτοῦ",702165,49],["τὰ",709436,41],["σκεύη",711844,42],["καὶ",707031,7],["τὴν",709436,8],["τράπεζαν",712919,9],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["σκεύη",711844,42],["αὐτῆς",702165,86],["καὶ",707031,7],["τὸν",709436,5],["λουτῆρα",708256,6],["καὶ",707031,7],["τὴν",709436,8],["βάσιν",702585,9],["αὐτοῦ",702165,102]],"and the altar of whole burnt-offerings and all its furniture, and the table and all its furniture, and the laver."],["29",[["καὶ",707031,7],["ἁγιάσεις",700153,166],["αὐτά",702165,71],["καὶ",707031,7],["ἔσται",704093,93],["ἅγια",700159,195],["τῶν",709436,43],["ἁγίων",700159,83],["πᾶς",710177,14],["ὁ",709436,3],["ἁπτόμενος",701654,122],["αὐτῶν",702165,70],["ἁγιασθήσεται",700153,134]],"And thou shalt sanctify them, and they shall be most holy: every one that touches them shall be hallowed."],["30",[["καὶ",707031,7],["Ααρων",700005,6],["καὶ",707031,7],["τοὺς",709436,58],["υἱοὺς",713075,57],["αὐτοῦ",702165,102],["χρίσεις",713965,166],["καὶ",707031,7],["ἁγιάσεις",700153,166],["αὐτοὺς",702165,62],["ἱερατεύειν",706607,55],["μοι",708974,159]],"And thou shalt anoint Aaron and his sons, and sanctify them that they may minister to me as priests."],["31",[["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ισραηλ",706839,18],["λαλήσεις",708071,166],["λέγων",708124,72],["ἔλαιον",704380,15],["ἄλειμμα",700643,15],["χρίσεως",713962,17],["ἅγιον",700159,26],["ἔσται",704093,93],["τοῦτο",712913,132],["ὑμῖν",713084,90],["εἰς",704105,0],["τὰς",709436,38],["γενεὰς",703037,39],["ὑμῶν",713091,145]],"And thou shalt speak to the children of Israel, saying, This shall be to you a holy anointing oil throughout your generations."],["32",[["ἐπὶ",705080,0],["σάρκα",711537,9],["ἀνθρώπου",701163,18],["οὐ",709805,28],["χρισθήσεται",713965,134],["καὶ",707031,7],["κατὰ",707200,0],["τὴν",709436,8],["σύνθεσιν",712475,9],["ταύτην",709858,104],["οὐ",709805,28],["ποιήσετε",710582,337],["ὑμῖν",713084,90],["ἑαυτοῖς",703917,151],["ὡσαύτως",714158,28],["ἅγιόν",700159,26],["ἐστιν",704093,91],["καὶ",707031,7],["ἁγίασμα",700154,15],["ἔσται",704093,93],["ὑμῖν",713084,90]],"On man's flesh it shall not be poured, and ye shall not make [any] for yourselves according to this composition: it is holy, and shall be holiness to you."],["33",[["ὃς",709781,213],["ἂν",700900,11],["ποιήσῃ",710582,172],["ὡσαύτως",714158,28],["καὶ",707031,7],["ὃς",709781,213],["ἂν",700900,11],["δῷ",703654,172],["ἀπ᾿",701425,0],["αὐτοῦ",702165,49],["ἀλλογενεῖ",700690,30],["ἐξολεθρευθήσεται",704956,134],["ἐκ",704132,0],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτοῦ",702165,102]],"Whosoever shall make it in like manner, and whosoever shall give of it to a stranger, shall be destroyed from among his people."],["34",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρὸς",710844,0],["Μωυσῆν",709112,6],["λαβὲ",708076,176],["σεαυτῷ",711599,50],["ἡδύσματα",705946,42],["στακτήν",712043,9],["ὄνυχα",709673,6],["χαλβάνην",713675,9],["ἡδυσμοῦ",705947,18],["καὶ",707031,7],["λίβανον",708186,6],["διαφανῆ",703620,27],["ἴσον",706832,26],["ἴσῳ",706832,97],["ἔσται",704093,93]],"And the Lord said to Moses, Take for thyself sweet herbs, stacte, onycha, sweet galbanum, and transparent frankincense; there shall be an equal weight of each."],["35",[["καὶ",707031,7],["ποιήσουσιν",710582,218],["ἐν",704639,0],["αὐτῷ",702165,280],["θυμίαμα",706330,25],["μυρεψικὸν",709060,46],["ἔργον",705396,25],["μυρεψοῦ",709061,18],["μεμιγμένον",708911,448],["καθαρόν",706988,46],["ἔργον",705396,25],["ἅγιον",700159,46]],"And they shall make with it perfumed incense, tempered with the art of a perfumer, a pure holy work."],["36",[["καὶ",707031,7],["συγκόψεις",712230,166],["ἐκ",704132,0],["τούτων",709858,70],["λεπτὸν",708153,27],["καὶ",707031,7],["θήσεις",712849,166],["ἀπέναντι",701389,0],["τῶν",709436,43],["μαρτυρίων",708525,44],["ἐν",704639,0],["τῇ",709436,100],["σκηνῇ",711845,1],["τοῦ",709436,20],["μαρτυρίου",708525,21],["ὅθεν",709486,28],["γνωσθήσομαί",703105,180],["σοι",711925,159],["ἐκεῖθεν",704182,28],["ἅγιον",700159,27],["τῶν",709436,43],["ἁγίων",700159,83],["ἔσται",704093,93],["ὑμῖν",713084,90]],"And of these thou shalt beat some small, and thou shalt put it before the testimonies in the tabernacle of testimony, whence I will make myself known to thee: it shall be to you a most holy incense."],["37",[["θυμίαμα",706330,25],["κατὰ",707200,0],["τὴν",709436,8],["σύνθεσιν",712475,9],["ταύτην",709858,104],["οὐ",709805,28],["ποιήσετε",710582,337],["ὑμῖν",713084,90],["αὐτοῖς",702165,151],["ἁγίασμα",700154,15],["ἔσται",704093,93],["ὑμῖν",713084,90],["κυρίῳ",707996,114]],"Ye shall not make any for yourselves according to this composition; it shall be to you a holy thing for the Lord."],["38",[["ὃς",709781,213],["ἂν",700900,11],["ποιήσῃ",710582,172],["ὡσαύτως",714158,28],["ὥστε",714164,7],["ὀσφραίνεσθαι",709798,110],["ἐν",704639,0],["αὐτῷ",702165,280],["ἀπολεῖται",701513,93],["ἐκ",704132,0],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτοῦ",702165,102]],"Whosoever shall make any in like manner, so as to smell it, shall perish from his people."]]