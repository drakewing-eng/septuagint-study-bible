,710185,165],["τοὺς",709436,58],["Αἰγυπτίους",700400,57],["ἐν",704639,0],["πᾶσι",710177,230],["τοῖς",709436,147],["θαυμασίοις",706136,230],["μου",709032,133],["οἷς",709781,311],["ποιήσω",710582,207],["ἐν",704639,0],["αὐτοῖς",702165,151],["καὶ",707031,7],["μετὰ",708780,0],["ταῦτα",709858,71],["ἐξαποστελεῖ",704872,127],["ὑμᾶς",713080,194]],"and I will stretch out my hand, and smite the Egyptians with all my wonders, which I shall work among them, and after that he will send you forth."],["21",[["καὶ",707031,7],["δώσω",703654,165],["χάριν",713735,9],["τῷ",709436,113],["λαῷ",708094,114],["τούτῳ",709858,50],["ἐναντίον",704654,0],["τῶν",709436,80],["Αἰγυπτίων",700400,81],["ὅταν",709801,28],["δὲ",703303,11],["ἀποτρέχητε",701623,355],["οὐκ",709805,28],["ἀπελεύσεσθε",701398,124],["κενοί",707612,138]],"And I will give this people favour in the sight of the Egyptians, and whenever ye shall escape, ye shall not depart empty."],["22",[["αἰτήσει",700489,127],["γυνὴ",703209,12],["παρὰ",709995,0],["γείτονος",703016,18],["καὶ",707031,7],["συσκήνου",712547,18],["αὐτῆς",702165,86],["σκεύη",711844,42],["ἀργυρᾶ",701705,68],["καὶ",707031,7],["χρυσᾶ",713971,68],["καὶ",707031,7],["ἱματισμόν",706744,6],["καὶ",707031,7],["ἐπιθήσετε",705304,337],["ἐπὶ",705080,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐπὶ",705080,0],["τὰς",709436,38],["θυγατέρας",706320,39],["ὑμῶν",713091,145],["καὶ",707031,7],["σκυλεύσετε",711900,337],["τοὺς",709436,58],["Αἰγυπτίους",700400,57]],"But [every] woman shall ask of her neighbour and fellow lodger, articles of gold and silver, and apparel; and ye shall put them upon your sons and upon your daughters,—and spoil ye the Egyptians."]]