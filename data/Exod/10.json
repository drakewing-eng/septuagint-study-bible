60,6],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["πορεύεσθε",710667,73],["καὶ",707031,7],["λατρεύσατε",708108,74],["τῷ",709436,113],["θεῷ",706192,114],["ὑμῶν",713091,145],["τίνες",712867,392],["δὲ",703303,11],["καὶ",707031,7],["τίνες",712867,392],["εἰσὶν",704093,197],["οἱ",709436,136],["πορευόμενοι",710667,348]],"And they brought back both Moses and Aaron to Pharao; and he said to them, Go and serve the Lord your God; but who are they that are going with you?"],["9",[["καὶ",707031,7],["λέγει",708124,91],["Μωυσῆς",709112,4],["σὺν",712372,0],["τοῖς",709436,147],["νεανίσκοις",709232,148],["καὶ",707031,7],["πρεσβυτέροις",710735,230],["πορευσόμεθα",710667,141],["σὺν",712372,0],["τοῖς",709436,147],["υἱοῖς",713075,148],["καὶ",707031,7],["θυγατράσιν",706320,76],["καὶ",707031,7],["προβάτοις",710768,96],["καὶ",707031,7],["βουσὶν",702798,148],["ἡμῶν",705999,145],["ἔστιν",704093,91],["γὰρ",702963,11],["ἑορτὴ",704990,12],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145]],"And Moses said, We will go with the young and the old, with our sons, and daughters, and sheep, and oxen, for it is a feast of the Lord."],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτούς",702165,62],["ἔστω",704093,31],["οὕτως",709859,28],["κύριος",707996,4],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["καθότι",707021,28],["ἀποστέλλω",701592,157],["ὑμᾶς",713080,194],["μὴ",708851,28],["καὶ",707031,7],["τὴν",709436,8],["ἀποσκευὴν",701573,9],["ὑμῶν",713091,145],["ἴδετε",709725,74],["ὅτι",709803,7],["πονηρία",710659,12],["πρόκειται",710812,117],["ὑμῖν",713084,90]],"And he said to them, So let the Lord be with you: as I [will] send you away, [must I send away] your store also? see that evil is attached to you."],["11",[["μὴ",708851,28],["οὕτως",709859,28],["πορευέσθωσαν",710667,77],["δὲ",703303,11],["οἱ",709436,136],["ἄνδρες",701150,52],["καὶ",707031,7],["λατρεύσατε",708108,74],["τῷ",709436,113],["θεῷ",706192,114],["τοῦτο",709858,129],["γὰρ",702963,11],["αὐτ