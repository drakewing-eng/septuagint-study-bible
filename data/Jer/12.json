[["1",[["δίκαιος",703694,14],["εἶ",704093,154],["κύριε",707996,153],["ὅτι",709803,7],["ἀπολογήσομαι",701516,181],["πρὸς",710844,0],["σέ",711598,163],["πλὴν",710540,28],["κρίματα",707903,42],["λαλήσω",708071,165],["πρὸς",710844,0],["σέ",711598,163],["τί",712867,126],["ὅτι",709803,7],["ὁδὸς",709458,12],["ἀσεβῶν",701909,169],["εὐοδοῦται",705654,117],["εὐθήνησαν",705594,150],["πάντες",710177,138],["οἱ",709436,136],["ἀθετοῦντες",700369,146],["ἀθετήματα",700370,42]],"Righteous art thou, O Lord, that I may make my defence to thee, yea, I will speak to thee [of] judgments. Why [is it] that the way of ungodly [men] prospers? [that] all that deal very treacherously are flourishing?"],["2",[["ἐφύτευσας",713636,162],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἐρριζώθησαν",711261,150],["ἐτεκνοποίησαν",712762,150],["καὶ",707031,7],["ἐποίησαν",710582,150],["καρπόν",707169,6],["ἐγγὺς",703948,28],["εἶ",704093,154],["σὺ",712181,164],["τοῦ",709436,20],["στόματος",712125,21],["αὐτῶν",702165,40],["καὶ",707031,7],["πόρρω",710680,28],["ἀπὸ",701425,0],["τῶν",709436,80],["νεφρῶν",709282,81],["αὐτῶν",702165,40]],"Thou hast planted them, and they have taken root; they have begotten children, and become fruitful; thou art near to their mouth, and far from their reins."],["3",[["καὶ",707031,7],["σύ",712181,164],["κύριε",707996,153],["γινώσκεις",703105,154],["με",708618,163],["δεδοκίμακας",703776,266],["τὴν",709436,8],["καρδίαν",707141,9],["μου",709032,133],["ἐναντίον",704654,0],["σου",711945,133],["ἅγνισον",700172,176],["αὐτοὺς",702165,62],["εἰς",704105,0],["ἡμέραν",705984,9],["σφαγῆς",712568,17],["αὐτῶν",702165,40]],"But thou, Lord, knowest me; thou hast proved my heart before thee; purify them for the day of their slaughter."],["4",[["ἕως",705792,7],["πότε",710696,28],["πενθήσει",710251,127],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["χόρτος",713923,4],["τοῦ",709436,35],["ἀγροῦ",700196,18],["ξηρανθήσεται",709419,134],["ἀπὸ",701425,0],["κακίας",707054,17],["τῶν",709436,80],["κατοικούντων",707534,170],["ἐν",704639,0],["αὐτῇ",702165,105],["ἠφανίσθησαν",702182,99],["κτήνη",707934,64],["καὶ",707031,7],["πετεινά",710439,64],["ὅτι",709803,7],["εἶπαν",705373,150],["οὐκ",709805,28],["ὄψεται",709725,93],["ὁ",709436,3],["θεὸς",706192,4],["ὁδοὺς",709458,39],["ἡμῶν",705999,145]],"How long shall the land mourn, and the grass of the field wither, for the wickedness of them that dwell in it? the beasts and birds are utterly destroyed; because [the people] said, God shall not see our ways."],["5",[["σοῦ",711945,133],["οἱ",709436,136],["πόδες",710707,52],["τρέχουσιν",712931,197],["καὶ",707031,7],["ἐκλύουσίν",704254,197],["σε",711598,163],["πῶς",711121,28],["παρασκευάσῃ",710103,172],["ἐφ᾿",705080,0],["ἵπποις",706790,148],["καὶ",707031,7],["ἐν",704639,0],["γῇ",703083,1],["εἰρήνης",704098,17],["σὺ",712181,164],["πέποιθας",710221,266],["πῶς",711121,28],["ποιήσεις",710582,166],["ἐν",704639,0],["φρυάγματι",713598,54],["τοῦ",709436,35],["Ιορδάνου",706763,18]],"Thy feet run, and they cause thee to faint; how wilt thou prepare [to ride] upon horses? and thou hast been confident in the land of thy peace? how wilt thou do in the roaring of Jordan?"],["6",[["ὅτι",709803,7],["καὶ",707031,28],["οἱ",709436,136],["ἀδελφοί",700249,52],["σου",711945,133],["καὶ",707031,7],["ὁ",709436,3],["οἶκος",709516,4],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["καὶ",707031,7],["οὗτοι",709858,201],["ἠθέτησάν",700369,150],["σε",711598,163],["καὶ",707031,7],["αὐτοὶ",702165,201],["ἐβόησαν",702743,150],["ἐκ",704132,0],["τῶν",709436,80],["ὀπίσω",709697,0],["σου",711945,133],["ἐπισυνήχθησαν",705280,99],["μὴ",708851,28],["πιστεύσῃς",710483,175],["ἐν",704639,0],["αὐτοῖς",702165,151],["ὅτι",709803,7],["λαλήσουσιν",708071,218],["πρὸς",710844,0],["σὲ",711598,163],["καλά",707097,68]],"For even thy brethren and the house of thy father, even these have dealt treacherously with thee; and they have cried out, they are gathered together in pursuit of thee; trust not thou in them, though they shall speak fair [words] to thee."],["7",[["ἐγκαταλέλοιπα",703967,89],["τὸν",709436,5],["οἶκόν",709516,6],["μου",709032,133],["ἀφῆκα",702211,155],["τὴν",709436,8],["κληρονομίαν",707725,9],["μου",709032,133],["ἔδωκα",703654,155],["τὴν",709436,8],["ἠγαπημένην",700120,444],["ψυχήν",714070,9],["μου",709032,133],["εἰς",704105,0],["χεῖρας",713787,39],["ἐχθρῶν",705779,81],["αὐτῆς",702165,86]],"I have forsaken mine house, I have left mine heritage; I have given my beloved one into the hands of her enemies."],["8",[["ἐγενήθη",703104,37],["ἡ",709436,10],["κληρονομία",707725,12],["μου",709032,133],["ἐμοὶ",704577,159],["ὡς",714148,7],["λέων",708171,4],["ἐν",704639,0],["δρυμῷ",703836,114],["ἔδωκεν",703654,2],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["τὴν",709436,8],["φωνὴν",713640,9],["αὐτῆς",702165,86],["διὰ",703417,0],["τοῦτο",709858,129],["ἐμίσησα",708935,155],["αὐτήν",702165,104]],"My inheritance has become to me as a lion in a forest; she has uttered her voice against me; therefore have I hated her."],["9",[["μὴ",708851,28],["σπήλαιον",712012,15],["ὑαίνης",713046,4],["ἡ",709436,10],["κληρονομία",707725,12],["μου",709032,133],["ἐμοὶ",704577,159],["ἢ",705924,7],["σπήλαιον",712012,15],["κύκλῳ",707959,114],["αὐτῆς",702165,86],["βαδίσατε",702367,74],["συναγάγετε",712375,74],["πάντα",710177,68],["τὰ",709436,41],["θηρία",706252,42],["τοῦ",709436,35],["ἀγροῦ",700196,18],["καὶ",707031,7],["ἐλθέτωσαν",705453,264],["τοῦ",709436,20],["φαγεῖν",713296,106],["αὐτήν",702165,104]],"Is not my inheritance to me a hyæna's cave, or a cave round about her? Go ye, gather together all the wild beasts of the field, and let them come to devour her."],["10",[["ποιμένες",710596,52],["πολλοὶ",710646,138],["διέφθειραν",703624,150],["τὸν",709436,5],["ἀμπελῶνά",700872,6],["μου",709032,133],["ἐμόλυναν",708987,150],["τὴν",709436,8],["μερίδα",708748,9],["μου",709032,133],["ἔδωκαν",703654,150],["μερίδα",708748,9],["ἐπιθυμητήν",705144,36],["μου",709032,133],["εἰς",704105,0],["ἔρημον",705420,9],["ἄβατον",700023,36]],"Many shepherds have destroyed my vineyard, they have defiled my portion, they have made my desirable portion a trackless wilderness;"],["11",[["ἐτέθη",712849,37],["εἰς",704105,0],["ἀφανισμὸν",702183,6],["ἀπωλείας",701660,17],["δι᾿",703417,0],["ἐμὲ",704555,163],["ἀφανισμῷ",702183,114],["ἠφανίσθη",702182,37],["πᾶσα",710177,29],["ἡ",709436,10],["γῆ",703083,12],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀνὴρ",701150,4],["τιθέμενος",712849,122],["ἐν",704639,0],["καρδίᾳ",707141,1]],"it is made a complete ruin: for my sake the whole land has been utterly ruined, because there is none that lays [the matter] to heart."],["12",[["ἐπὶ",705080,0],["πᾶσαν",710177,36],["διεκβολὴν",703658,9],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["ἦλθον",705453,150],["ταλαιπωροῦντες",712694,146],["ὅτι",709803,7],["μάχαιρα",708593,12],["τοῦ",709436,35],["κυρίου",707996,18],["καταφάγεται",707519,93],["ἀπ᾿",701425,0],["ἄκρου",700608,116],["τῆς",709436,16],["γῆς",703083,17],["ἕως",705792,0],["ἄκρου",700608,116],["τῆς",709436,16],["γῆς",703083,17],["οὐκ",709805,28],["ἔστιν",704093,91],["εἰρήνη",704098,12],["πάσῃ",710177,101],["σαρκί",711537,1]],"The ravagers are come to every passage in the wilderness: for the sword of the Lord will devour from one end of the land to the other: no flesh has any peace."],["13",[["σπείρατε",712006,74],["πυροὺς",711101,57],["καὶ",707031,7],["ἀκάνθας",700517,39],["θερίσατε",706206,74],["οἱ",709436,136],["κλῆροι",707727,52],["αὐτῶν",702165,40],["οὐκ",709805,28],["ὠφελήσουσιν",714171,218],["αὐτούς",702165,62],["αἰσχύνθητε",700485,372],["ἀπὸ",701425,0],["καυχήσεως",707571,17],["ὑμῶν",713091,145],["ἀπὸ",701425,0],["ὀνειδισμοῦ",709657,18],["ἔναντι",704653,0],["κυρίου",707996,18]],"Sow wheat, and reap thorns; their portions shall not profit them: be ashamed of your boasting, because of reproach before the Lord."],["14",[["ὅτι",709803,7],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["περὶ",710285,0],["πάντων",710177,169],["τῶν",709436,80],["γειτόνων",703016,81],["τῶν",709436,80],["πονηρῶν",710660,169],["τῶν",709436,80],["ἁπτομένων",701654,299],["τῆς",709436,16],["κληρονομίας",707725,17],["μου",709032,133],["ἧς",709781,167],["ἐμέρισα",708744,155],["τῷ",709436,113],["λαῷ",708094,114],["μου",709032,133],["Ισραηλ",706839,114],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἀποσπῶ",701583,157],["αὐτοὺς",702165,62],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["αὐτῶν",702165,40],["καὶ",707031,7],["τὸν",709436,5],["Ιουδαν",706775,6],["ἐκβαλῶ",704145,165],["ἐκ",704132,0],["μέσου",708768,116],["αὐτῶν",702165,40]],"For thus saith the Lord concerning all the evil neighbours that touch mine inheritance, which I have divided to my people Israel; Behold, I [will] draw them away from their land, and I will cast out Juda from the midst of them."],["15",[["καὶ",707031,7],["ἔσται",704093,93],["μετὰ",708780,0],["τὸ",709436,24],["ἐκβαλεῖν",704145,296],["με",708618,163],["αὐτοὺς",702165,62],["ἐπιστρέψω",705278,165],["καὶ",707031,7],["ἐλεήσω",704418,165],["αὐτοὺς",702165,62],["καὶ",707031,7],["κατοικιῶ",707538,165],["αὐτοὺς",702165,62],["ἕκαστον",704133,27],["εἰς",704105,0],["τὴν",709436,8],["κληρονομίαν",707725,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἕκαστον",704133,27],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["αὐτοῦ",702165,102]],"And it shall come to pass, after I have cast them out, [that] I will return, and have mercy upon them, and will cause them to dwell every one in his inheritance, and every one in his land."],["16",[["καὶ",707031,7],["ἔσται",704093,93],["ἐὰν",703912,7],["μαθόντες",708480,196],["μάθωσιν",708480,234],["τὴν",709436,8],["ὁδὸν",709458,9],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133],["τοῦ",709436,20],["ὀμνύειν",709620,55],["τῷ",709436,53],["ὀνόματί",709666,54],["μου",709032,133],["ζῇ",705851,91],["κύριος",707996,4],["καθὼς",707030,28],["ἐδίδαξαν",703649,150],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["ὀμνύειν",709620,55],["τῇ",709436,100],["Βααλ",702333,1],["καὶ",707031,7],["οἰκοδομηθήσονται",709509,144],["ἐν",704639,0],["μέσῳ",708768,30],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133]],"And it shall be, if they will indeed learn the way of my people, to swear by my name, [saying], The Lord lives; as they taught my people to swear by Baal; then shall [that nation] be built in the midst of my people."],["17",[["ἐὰν",703912,7],["δὲ",703303,11],["μὴ",708851,28],["ἐπιστρέψωσιν",705278,234],["καὶ",707031,7],["ἐξαρῶ",704839,165],["τὸ",709436,24],["ἔθνος",704068,25],["ἐκεῖνο",704183,129],["ἐξάρσει",704881,1],["καὶ",707031,7],["ἀπωλείᾳ",701660,1]],"But if they will not return, then will I cut off that nation with utter ruin and destruction."]]