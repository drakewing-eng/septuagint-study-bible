[["1",[["ὁ",709436,3],["λόγος",708236,4],["ὁ",709436,3],["γενόμενος",703104,248],["πρὸς",710844,0],["Ιερεμιαν",706611,6],["ἐπὶ",705080,0],["πάντα",710177,27],["τὸν",709436,5],["λαὸν",708094,6],["Ιουδα",706768,18],["ἐν",704639,0],["τῷ",709436,53],["ἔτει",705543,54],["τῷ",709436,53],["τετάρτῳ",712811,97],["τοῦ",709436,35],["Ιωακιμ",706887,18],["υἱοῦ",713075,18],["Ιωσια",706949,18],["βασιλέως",702580,18],["Ιουδα",706768,18]],"The Word that came to Jeremias concerning all the people of Juda in the fourth year of Joakim, son of Josias, king of Juda;"],["2",[["ὃν",709781,112],["ἐλάλησεν",708071,2],["πρὸς",710844,0],["πάντα",710177,27],["τὸν",709436,5],["λαὸν",708094,6],["Ιουδα",706768,18],["καὶ",707031,7],["πρὸς",710844,0],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["Ιερουσαλημ",706644,9],["λέγων",708124,72]],"which he spoke to all the people of Juda, and to the inhabitants of Jerusalem, saying,"],["3",[["ἐν",704639,0],["τρισκαιδεκάτῳ",712957,97],["ἔτει",705543,54],["Ιωσια",706949,18],["υἱοῦ",713075,18],["Αμως",700898,18],["βασιλέως",702580,18],["Ιουδα",706768,18],["καὶ",707031,7],["ἕως",705792,0],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86],["εἴκοσι",704085,59],["καὶ",707031,7],["τρία",712927,68],["ἔτη",705543,42],["καὶ",707031,7],["ἐλάλησα",708071,155],["πρὸς",710844,0],["ὑμᾶς",713080,194],["ὀρθρίζων",709742,72],["καὶ",707031,7],["λέγων",708124,72]],"In the thirteenth year of Josias, son of Amos, king of Juda, even until this day for three and twenty years, I have both spoken to you, rising early and speaking,"],["4",[["καὶ",707031,7],["ἀπέστελλον",701592,333],["πρὸς",710844,0],["ὑμᾶς",713080,194],["τοὺς",709436,58],["δούλους",703817,57],["μου",709032,133],["τοὺς",709436,58],["προφήτας",711009,57],["ὄρθρου",709745,18],["ἀποστέλλων",701592,72],["καὶ",707031,7],["οὐκ",709805,28],["εἰσηκούσατε",704108,265],["καὶ",707031,7],["οὐ",709805,28],["προσέσχετε",710895,265],["τοῖς",709436,95],["ὠσὶν",709852,96],["ὑμῶν",713091,145]],"and I sent to you my servants the prophets, sending them early; (but ye hearkened not, and listened not with your ears;) saying,"],["5",[["λέγων",708124,72],["ἀποστράφητε",701598,74],["ἕκαστος",704133,14],["ἀπὸ",701425,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["αὐτοῦ",702165,102],["τῆς",709436,16],["πονηρᾶς",710660,82],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,43],["πονηρῶν",710660,83],["ἐπιτηδευμάτων",705301,44],["ὑμῶν",713091,145],["καὶ",707031,7],["κατοικήσετε",707534,337],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ἧς",709781,167],["ἔδωκα",703654,155],["ὑμῖν",713084,90],["καὶ",707031,7],["τοῖς",709436,147],["πατράσιν",710189,148],["ὑμῶν",713091,145],["ἀπ᾿",701425,0],["αἰῶνος",700504,18],["καὶ",707031,7],["ἕως",705792,0],["αἰῶνος",700504,18]],"Turn ye every one from his evil way, and from your evil practices, and ye shall dwell in the land which I gave to you and your fathers, of old and for ever."],["6",[["μὴ",708851,28],["πορεύεσθε",710667,375],["ὀπίσω",709697,0],["θεῶν",706192,81],["ἀλλοτρίων",700699,169],["τοῦ",709436,20],["δουλεύειν",703814,55],["αὐτοῖς",702165,151],["καὶ",707031,7],["τοῦ",709436,20],["προσκυνεῖν",710925,55],["αὐτοῖς",702165,151],["ὅπως",709719,7],["μὴ",708851,28],["παροργίζητέ",710167,355],["με",708618,163],["ἐν",704639,0],["τοῖς",709436,95],["ἔργοις",705396,96],["τῶν",709436,130],["χειρῶν",713787,65],["ὑμῶν",713091,145],["τοῦ",709436,20],["κακῶσαι",707073,106],["ὑμᾶς",713080,194]],"Go ye not after strange gods, to serve them, and to worship them, that ye provoke me not by the works of your hands, to do you hurt."],["7",[["καὶ",707031,7],["οὐκ",709805,28],["ἠκούσατέ",700587,265],["μου",709032,133]],"But ye hearkened not to me."],["8",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἐπειδὴ",705056,7],["οὐκ",709805,28],["ἐπιστεύσατε",710483,265],["τοῖς",709436,147],["λόγοις",708236,148],["μου",709032,133]],"Therefore thus saith the Lord; Since ye believed not my words,"],["9",[["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἀποστέλλω",701592,157],["καὶ",707031,7],["λήμψομαι",708076,181],["τὴν",709436,8],["πατριὰν",710192,9],["ἀπὸ",701425,0],["βορρᾶ",702765,18],["καὶ",707031,7],["ἄξω",700209,165],["αὐτοὺς",702165,62],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104],["καὶ",707031,7],["ἐπὶ",705080,0],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["αὐτὴν",702165,104],["καὶ",707031,7],["ἐπὶ",705080,0],["πάντα",710177,68],["τὰ",709436,41],["ἔθνη",704068,42],["τὰ",709436,41],["κύκλῳ",707959,114],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐξερημώσω",704907,165],["αὐτοὺς",702165,62],["καὶ",707031,7],["δώσω",703654,165],["αὐτοὺς",702165,62],["εἰς",704105,0],["ἀφανισμὸν",702183,6],["καὶ",707031,7],["εἰς",704105,0],["συριγμὸν",712536,6],["καὶ",707031,7],["εἰς",704105,0],["ὀνειδισμὸν",709657,6],["αἰώνιον",700505,27]],"behold, I [will] send and take a family from the north, and will bring them against this land, and against the inhabitants of it, and against all the nations round about it, and I will make them utterly waste, and make them a desolation, and a hissing, and an everlasting reproach."],["10",[["καὶ",707031,7],["ἀπολῶ",701513,165],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["φωνὴν",713640,9],["χαρᾶς",713719,17],["καὶ",707031,7],["φωνὴν",713640,9],["εὐφροσύνης",705717,17],["φωνὴν",713640,9],["νυμφίου",709382,18],["καὶ",707031,7],["φωνὴν",713640,9],["νύμφης",709381,17],["ὀσμὴν",709786,9],["μύρου",709072,21],["καὶ",707031,7],["φῶς",713642,25],["λύχνου",708287,18]],"And I will destroy from [among] them the voice of joy, and the voice of gladness, the voice of the bridegroom, and the voice of the bride, the scent of ointment, and the light of a candle."],["11",[["καὶ",707031,7],["ἔσται",704093,93],["πᾶσα",710177,29],["ἡ",709436,10],["γῆ",703083,12],["εἰς",704105,0],["ἀφανισμόν",702183,6],["καὶ",707031,7],["δουλεύσουσιν",703814,218],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["ἑβδομήκοντα",703922,59],["ἔτη",705543,42]],"And all the land shall be a desolation; and they shall serve among the Gentiles seventy years."],["12",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["πληρωθῆναι",710543,179],["τὰ",709436,41],["ἑβδομήκοντα",703922,59],["ἔτη",705543,42],["ἐκδικήσω",704174,165],["τὸ",709436,24],["ἔθνος",704068,25],["ἐκεῖνο",704183,129],["φησὶν",713437,91],["κύριος",707996,4],["καὶ",707031,7],["θήσομαι",712849,181],["αὐτοὺς",702165,62],["εἰς",704105,0],["ἀφανισμὸν",702183,6],["αἰώνιον",700505,27]],"And when the seventy years are fulfilled, I will take vengeance on that nation, and will make them a perpetual desolation."],["13",[["καὶ",707031,7],["ἐπάξω",704994,165],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["ἐκείνην",704183,104],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["μου",709032,133],["οὓς",709781,298],["ἐλάλησα",708071,155],["κατ᾿",707200,0],["αὐτῆς",702165,86],["πάντα",710177,68],["τὰ",709436,41],["γεγραμμένα",703194,388],["ἐν",704639,0],["τῷ",709436,53],["βιβλίῳ",702719,54],["τούτῳ",709858,280]],"And I will bring upon that land all my words which I have spoken against it, [even] all things that are written in this book."],["14",[["ἃ",709781,69],["ἐπροφήτευσεν",711008,2],["Ιερεμιας",706611,4],["ἐπὶ",705080,0],["τὰ",709436,41],["ἔθνη",704068,42],["τὰ",709436,41],["Αιλαμ",700430,42]],"The Prophecies of Jeremias against the Nations of Ælam."],["15",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["συντριβήτω",712520,22],["τὸ",709436,24],["τόξον",712898,25],["Αιλαμ",700430,118],["ἀρχὴ",701836,12],["δυναστείας",703841,17],["αὐτῶν",702165,40]],"Thus saith the Lord, The bow of Ælam is broken, [even] the chief of their power."],["16",[["καὶ",707031,7],["ἐπάξω",704994,165],["ἐπὶ",705080,0],["Αιλαμ",700430,227],["τέσσαρας",712808,60],["ἀνέμους",701123,57],["ἐκ",704132,0],["τῶν",709436,80],["τεσσάρων",712808,169],["ἄκρων",700608,169],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["διασπερῶ",703584,165],["αὐτοὺς",702165,62],["ἐν",704639,0],["πᾶσιν",710177,230],["τοῖς",709436,147],["ἀνέμοις",701123,148],["τούτοις",709858,151],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ἔθνος",704068,25],["ὃ",709781,33],["οὐχ",709805,28],["ἥξει",705956,127],["ἐκεῖ",704181,28],["οἱ",709436,136],["ἐξωσμένοι",704985,429],["Αιλαμ",700430,118]],"And I will bring upon Ælam the four winds from the four corners of heaven, and I will disperse them toward all these winds; and there shall be no nation [to] which they shall not come—[even] the outcasts of Ælam."],["17",[["καὶ",707031,7],["πτοήσω",711062,165],["αὐτοὺς",702165,62],["ἐναντίον",704654,0],["τῶν",709436,80],["ἐχθρῶν",705779,81],["αὐτῶν",702165,40],["τῶν",709436,80],["ζητούντων",705879,170],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπάξω",704994,165],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["κακὰ",707066,68],["κατὰ",707200,0],["τὴν",709436,8],["ὀργὴν",709728,9],["τοῦ",709436,35],["θυμοῦ",706334,18],["μου",709032,133],["καὶ",707031,7],["ἐπαποστελῶ",705036,165],["ὀπίσω",709697,0],["αὐτῶν",702165,40],["τὴν",709436,8],["μάχαιράν",708593,9],["μου",709032,133],["ἕως",705792,0],["τοῦ",709436,20],["ἐξαναλῶσαι",704861,106],["αὐτούς",702165,62]],"And I will put them in fear before their enemies that seek their life; and I will bring evils upon them according to my great anger; and I will send forth my sword after them, until I have utterly destroyed them."],["18",[["καὶ",707031,7],["θήσω",712849,165],["τὸν",709436,5],["θρόνον",706315,6],["μου",709032,133],["ἐν",704639,0],["Αιλαμ",700430,111],["καὶ",707031,7],["ἐξαποστελῶ",704872,165],["ἐκεῖθεν",704182,28],["βασιλέα",702580,6],["καὶ",707031,7],["μεγιστᾶνας",708657,57]],"And I will set my throne in Ælam, and will send forth thence king and rulers."],["19",[["καὶ",707031,7],["ἔσται",704093,93],["ἐπ᾿",705080,0],["ἐσχάτου",705519,92],["τῶν",709436,130],["ἡμερῶν",705984,65],["ἀποστρέψω",701598,165],["τὴν",709436,8],["αἰχμαλωσίαν",700499,9],["Αιλαμ",700430,118],["λέγει",708124,91],["κύριος",707996,4]],"But it shall come to pass at the end of days, that I will turn the captivity of Ælam, saith the Lord."],["20",[["ἐν",704639,0],["ἀρχῇ",701836,1],["βασιλεύοντος",702581,152],["Σεδεκιου",711618,18],["τοῦ",709436,35],["βασιλέως",702580,18],["ἐγένετο",703104,23],["ὁ",709436,3],["λόγος",708236,4],["οὗτος",709858,121],["περὶ",710285,0],["Αιλαμ",700430,354]],"In the beginning of the reign of king Sedekias, there came this word concerning Ælam."]]