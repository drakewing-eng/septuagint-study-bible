[["1",[["ὁ",709436,3],["λόγος",708236,4],["ὁ",709436,3],["γενόμενος",703104,248],["παρὰ",709995,0],["κυρίου",707996,18],["πρὸς",710844,0],["Ιερεμιαν",706611,6],["ὅτε",709802,28],["ἀπέστειλεν",701592,2],["πρὸς",710844,0],["αὐτὸν",702165,85],["ὁ",709436,3],["βασιλεὺς",702580,4],["Σεδεκιας",711618,4],["τὸν",709436,5],["Πασχωρ",710184,6],["υἱὸν",713075,6],["Μελχιου",708712,18],["καὶ",707031,7],["Σοφονιαν",711984,6],["υἱὸν",713075,6],["Μαασαιου",708311,18],["τὸν",709436,5],["ἱερέα",706614,6],["λέγων",708124,72]],"The Word that came from the Lord to Jeremias, when King Sedekias sent to him Paschor the Son of Melchias, and Sophonias Son of Basæas, the Priest, saying,"],["2",[["ἐπερώτησον",705069,176],["περὶ",710285,0],["ἡμῶν",705999,145],["τὸν",709436,5],["κύριον",707996,6],["ὅτι",709803,7],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,17],["ἐφέστηκεν",705756,171],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["εἰ",704071,7],["ποιήσει",710582,127],["κύριος",707996,4],["κατὰ",707200,0],["πάντα",710177,68],["τὰ",709436,41],["θαυμάσια",706136,68],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀπελεύσεται",701398,93],["ἀφ᾿",701425,0],["ἡμῶν",705999,145]],"Enquire of the Lord for us; for the king of Babylon has risen up against us; if the Lord will do according to all his wonderful works, and [the king] shall depart from us."],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτοὺς",702165,62],["Ιερεμιας",706611,4],["οὕτως",709859,28],["ἐρεῖτε",705415,337],["πρὸς",710844,0],["Σεδεκιαν",711618,6],["βασιλέα",702580,6],["Ιουδα",706768,18]],"And Jeremias said to them, Thus shall ye say to Sedekias king of Juda,"],["4",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["μεταστρέφω",708817,157],["τὰ",709436,41],["ὅπλα",709704,42],["τὰ",709436,41],["πολεμικά",710602,68],["ἐν",704639,0],["οἷς",709781,311],["ὑμεῖς",713081,219],["πολεμεῖτε",710601,87],["ἐν",704639,0],["αὐτοῖς",702165,151],["πρὸς",710844,0],["τοὺς",709436,58],["Χαλδαίους",713678,57],["τοὺς",709436,58],["συγκεκλεικότας",712223,277],["ὑμᾶς",713080,194],["ἔξωθεν",704984,28],["τοῦ",709436,20],["τείχους",712759,21],["εἰς",704105,0],["τὸ",709436,24],["μέσον",708768,46],["τῆς",709436,16],["πόλεως",710612,17],["ταύτης",709858,86]],"Thus saith the Lord; Behold, I [will] turn back the weapons of war wherewith ye fight against the Chaldeans that have besieged you from outside the wall, and I will gather them into the midst of this city."],["5",[["καὶ",707031,7],["πολεμήσω",710601,165],["ἐγὼ",704018,164],["ὑμᾶς",713080,194],["ἐν",704639,0],["χειρὶ",713787,1],["ἐκτεταμένῃ",704322,455],["καὶ",707031,7],["ἐν",704639,0],["βραχίονι",702808,114],["κραταιῷ",707873,30],["μετὰ",708780,0],["θυμοῦ",706334,18],["καὶ",707031,7],["ὀργῆς",709728,17],["καὶ",707031,7],["παροργισμοῦ",710169,18],["μεγάλου",708653,116]],"And I will fight against you with an outstretched hand and with a strong arm, with wrath and great anger."],["6",[["καὶ",707031,7],["πατάξω",710185,165],["πάντας",710177,60],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["ταύτῃ",709858,105],["τοὺς",709436,58],["ἀνθρώπους",701163,57],["καὶ",707031,7],["τὰ",709436,41],["κτήνη",707934,42],["ἐν",704639,0],["θανάτῳ",706096,114],["μεγάλῳ",708653,30],["καὶ",707031,7],["ἀποθανοῦνται",701461,135]],"And I will smite all the dwellers in this city, [both] men and cattle, with grievous pestilence: and they shall die."],["7",[["καὶ",707031,7],["μετὰ",708780,0],["ταῦτα",709858,71],["οὕτως",709859,28],["λέγει",708124,91],["κύριος",707996,4],["δώσω",703654,165],["τὸν",709436,5],["Σεδεκιαν",711618,6],["βασιλέα",702580,6],["Ιουδα",706768,18],["καὶ",707031,7],["τοὺς",709436,58],["παῖδας",709932,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὸν",709436,5],["λαὸν",708094,6],["τὸν",709436,5],["καταλειφθέντα",707305,260],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["ταύτῃ",709858,105],["ἀπὸ",701425,0],["τοῦ",709436,35],["θανάτου",706096,18],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,35],["λιμοῦ",708210,18],["καὶ",707031,7],["ἀπὸ",701425,0],["τῆς",709436,16],["μαχαίρας",708593,17],["εἰς",704105,0],["χεῖρας",713787,39],["ἐχθρῶν",705779,81],["αὐτῶν",702165,40],["τῶν",709436,80],["ζητούντων",705879,170],["τὰς",709436,38],["ψυχὰς",714070,39],["αὐτῶν",702165,40],["καὶ",707031,7],["κατακόψουσιν",707285,218],["αὐτοὺς",702165,62],["ἐν",704639,0],["στόματι",712125,54],["μαχαίρας",708593,17],["οὐ",709805,28],["φείσομαι",713406,181],["ἐπ᾿",705080,0],["αὐτοῖς",702165,151],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["οἰκτιρήσω",709518,165],["αὐτούς",702165,62]],"And after this, thus saith the Lord; I will give Sedekias king of Juda, and his servants, and the people that is left in this city from the pestilence, and from the famine, and from the sword, into the hands of their enemies, that seek their lives: and they shall cut them in pieces with the edge of the sword: I will not spare them, and I will not have compassion upon them."],["8",[["καὶ",707031,7],["πρὸς",710844,0],["τὸν",709436,5],["λαὸν",708094,6],["τοῦτον",709858,85],["ἐρεῖς",705415,166],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["δέδωκα",703654,89],["πρὸ",710747,0],["προσώπου",710986,21],["ὑμῶν",713091,145],["τὴν",709436,8],["ὁδὸν",709458,9],["τῆς",709436,16],["ζωῆς",705910,17],["καὶ",707031,7],["τὴν",709436,8],["ὁδὸν",709458,9],["τοῦ",709436,35],["θανάτου",706096,18]],"And thou shalt say to this people, Thus saith the Lord; Behold, I have set before you the way of life, and the way of death."],["9",[["ὁ",709436,3],["καθήμενος",707000,122],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["ταύτῃ",709858,105],["ἀποθανεῖται",701461,93],["ἐν",704639,0],["μαχαίρᾳ",708593,1],["καὶ",707031,7],["ἐν",704639,0],["λιμῷ",708210,114],["καὶ",707031,7],["ὁ",709436,3],["ἐκπορευόμενος",704293,122],["προσχωρῆσαι",710983,106],["πρὸς",710844,0],["τοὺς",709436,58],["Χαλδαίους",713678,57],["τοὺς",709436,58],["συγκεκλεικότας",712223,277],["ὑμᾶς",713080,194],["ζήσεται",705851,93],["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτοῦ",702165,102],["εἰς",704105,0],["σκῦλα",711902,42],["καὶ",707031,7],["ζήσεται",705851,93]],"He that remains in this city shall die by the sword, and by famine: but he that goes forth to advance to the Chaldeans that have besieged you, shall live, and his life shall be to him for a spoil, and he shall live."],["10",[["διότι",703734,7],["ἐστήρικα",712098,89],["τὸ",709436,24],["πρόσωπόν",710986,25],["μου",709032,133],["ἐπὶ",705080,0],["τὴν",709436,8],["πόλιν",710612,9],["ταύτην",709858,104],["εἰς",704105,0],["κακὰ",707066,68],["καὶ",707031,7],["οὐκ",709805,28],["εἰς",704105,0],["ἀγαθά",700106,68],["εἰς",704105,0],["χεῖρας",713787,39],["βασιλέως",702580,18],["Βαβυλῶνος",702352,17],["παραδοθήσεται",710014,134],["καὶ",707031,7],["κατακαύσει",707258,127],["αὐτὴν",702165,104],["ἐν",704639,0],["πυρί",711088,54]],"For I have set my face against this city for evil, and not for good: it shall be delivered into the hands of the king of Babylon, and he shall consume it with fire."],["11",[["ὁ",709436,3],["οἶκος",709516,4],["βασιλέως",702580,18],["Ιουδα",706768,18],["ἀκούσατε",700587,74],["λόγον",708236,6],["κυρίου",707996,18]],"O house of the king of Juda, hear ye the word of the Lord."],["12",[["οἶκος",709516,4],["Δαυιδ",703232,18],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["κρίνατε",707905,74],["τὸ",709436,24],["πρωὶ",711021,28],["κρίμα",707903,25],["καὶ",707031,7],["κατευθύνατε",707521,74],["καὶ",707031,7],["ἐξέλεσθε",704838,186],["διηρπασμένον",703562,604],["ἐκ",704132,0],["χειρὸς",713787,17],["ἀδικοῦντος",700269,152],["αὐτόν",702165,85],["ὅπως",709719,7],["μὴ",708851,28],["ἀναφθῇ",701044,384],["ὡς",714148,7],["πῦρ",711088,15],["ἡ",709436,10],["ὀργή",709728,12],["μου",709032,133],["καὶ",707031,7],["καυθήσεται",707049,134],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ὁ",709436,3],["σβέσων",711596,512]],"O house of David, thus saith the Lord; Judge judgment in the morning, and act rightly, and rescue the spoiled one from the hand of him that wrongs him, lest mine anger be kindled like fire, and it burn, and there be none to quench [it]."],["13",[["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["πρὸς",710844,0],["σὲ",711598,163],["τὸν",709436,5],["κατοικοῦντα",707534,183],["τὴν",709436,8],["κοιλάδα",707758,9],["Σορ",711939,118],["τὴν",709436,8],["πεδινὴν",710214,36],["τοὺς",709436,58],["λέγοντας",708124,235],["τίς",712867,158],["πτοήσει",711062,127],["ἡμᾶς",705981,194],["ἢ",705924,7],["τίς",712867,158],["εἰσελεύσεται",704114,93],["πρὸς",710844,0],["τὸ",709436,24],["κατοικητήριον",707536,25],["ἡμῶν",705999,145]],"Behold, I am against thee that dwellest in the valley of Sor; in the plain country, [even against] them that say, Who shall alarm us? or who shall enter into our habitation?"],["14",[["καὶ",707031,7],["ἀνάψω",701044,165],["πῦρ",711088,25],["ἐν",704639,0],["τῷ",709436,113],["δρυμῷ",703836,114],["αὐτῆς",702165,86],["καὶ",707031,7],["ἔδεται",705495,93],["πάντα",710177,68],["τὰ",709436,41],["κύκλῳ",707959,114],["αὐτῆς",702165,86]],"And I will kindle a fire in the forest thereof, and it shall devour all things round about it."]]