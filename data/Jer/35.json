[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["τῷ",709436,53],["τετάρτῳ",712811,97],["ἔτει",705543,54],["Σεδεκια",711618,114],["βασιλέως",702580,18],["Ιουδα",706768,18],["ἐν",704639,0],["μηνὶ",708874,114],["τῷ",709436,113],["πέμπτῳ",710245,30],["εἶπέν",705373,2],["μοι",708974,159],["Ανανιας",701016,4],["υἱὸς",713075,4],["Αζωρ",700347,18],["ὁ",709436,3],["ψευδοπροφήτης",714043,4],["ὁ",709436,3],["ἀπὸ",701425,0],["Γαβαων",702858,118],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18],["κατ᾿",707200,0],["ὀφθαλμοὺς",709870,57],["τῶν",709436,80],["ἱερέων",706614,81],["καὶ",707031,7],["παντὸς",710177,116],["τοῦ",709436,35],["λαοῦ",708094,18],["λέγων",708124,72]],"And it came to pass in the fourth year of Sedekias king of Juda, in the fifth month, [that] Ananias the false prophet, the son of Azor, from Gabaon, spoke to me in the house of the Lord, in the sight of the priests and all the people, saying,"],["2",[["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["συνέτριψα",712520,155],["τὸν",709436,5],["ζυγὸν",705894,6],["τοῦ",709436,35],["βασιλέως",702580,18],["Βαβυλῶνος",702352,17]],"Thus saith the Lord; I have broken the yoke of the king of Babylon."],["3",[["ἔτι",705538,28],["δύο",703849,59],["ἔτη",705543,42],["ἡμερῶν",705984,65],["ἐγὼ",704018,164],["ἀποστρέψω",701598,165],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["τοῦτον",709858,85],["τὰ",709436,41],["σκεύη",711844,42],["οἴκου",709516,18],["κυρίου",707996,18]],"Yet two full years, and I will return into this place the vessels of the house of the Lord,"],["4",[["καὶ",707031,7],["Ιεχονιαν",706691,6],["καὶ",707031,7],["τὴν",709436,8],["ἀποικίαν",701463,9],["Ιουδα",706768,18],["ὅτι",709803,7],["συντρίψω",712520,207],["τὸν",709436,5],["ζυγὸν",705894,6],["βασιλέως",702580,18],["Βαβυλῶνος",702352,17]],"and Jechonias, and the captivity of Juda: for I will break the yoke of the king of Babylon."],["5",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιερεμιας",706611,4],["πρὸς",710844,0],["Ανανιαν",701016,6],["κατ᾿",707200,0],["ὀφθαλμοὺς",709870,57],["παντὸς",710177,116],["τοῦ",709436,35],["λαοῦ",708094,18],["καὶ",707031,7],["κατ᾿",707200,0],["ὀφθαλμοὺς",709870,57],["τῶν",709436,80],["ἱερέων",706614,81],["τῶν",709436,80],["ἑστηκότων",706846,387],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18]],"Then Jeremias spoke to Ananias in the sight of all the people, and in the sight of the priests that stood in the house of the Lord,"],["6",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιερεμιας",706611,4],["ἀληθῶς",700662,28],["οὕτω",709859,28],["ποιήσαι",710582,657],["κύριος",707996,4],["στήσαι",706846,225],["τὸν",709436,5],["λόγον",708236,6],["σου",711945,133],["ὃν",709781,112],["σὺ",712181,164],["προφητεύεις",711008,154],["τοῦ",709436,20],["ἐπιστρέψαι",705278,106],["τὰ",709436,41],["σκεύη",711844,42],["οἴκου",709516,18],["κυρίου",707996,18],["καὶ",707031,7],["πᾶσαν",710177,36],["τὴν",709436,8],["ἀποικίαν",701463,9],["ἐκ",704132,0],["Βαβυλῶνος",702352,17],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["τοῦτον",709858,85]],"and Jeremias said, May the Lord indeed do thus; may he confirm thy word which thou dost prophesy, to return the vessels of the house of the Lord, and all the captivity, out of Babylon to this place."],["7",[["πλὴν",710540,28],["ἀκούσατε",700587,74],["τὸν",709436,5],["λόγον",708236,6],["κυρίου",707996,18],["ὃν",709781,112],["ἐγὼ",704018,164],["λέγω",708124,157],["εἰς",704105,0],["τὰ",709436,41],["ὦτα",709852,42],["ὑμῶν",713091,145],["καὶ",707031,7],["εἰς",704105,0],["τὰ",709436,41],["ὦτα",709852,42],["παντὸς",710177,116],["τοῦ",709436,35],["λαοῦ",708094,18]],"Nevertheless hear ye the word of the Lord which I speak in your ears, and in the ears of all the people."],["8",[["οἱ",709436,136],["προφῆται",711009,52],["οἱ",709436,136],["γεγονότες",703104,268],["πρότεροί",710992,138],["μου",709032,133],["καὶ",707031,7],["πρότεροι",710992,138],["ὑμῶν",713091,145],["ἀπὸ",701425,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["καὶ",707031,7],["ἐπροφήτευσαν",711008,150],["ἐπὶ",705080,0],["γῆς",703083,17],["πολλῆς",710646,82],["καὶ",707031,7],["ἐπὶ",705080,0],["βασιλείας",702577,17],["μεγάλας",708653,119],["εἰς",704105,0],["πόλεμον",710605,6]],"The prophets that were before me and before you of old, also prophesied over much country, and against great kingdoms, concerning war."],["9",[["ὁ",709436,3],["προφήτης",711009,4],["ὁ",709436,3],["προφητεύσας",711008,182],["εἰς",704105,0],["εἰρήνην",704098,9],["ἐλθόντος",705453,500],["τοῦ",709436,35],["λόγου",708236,18],["γνώσονται",703105,135],["τὸν",709436,5],["προφήτην",711009,6],["ὃν",709781,112],["ἀπέστειλεν",701592,2],["αὐτοῖς",702165,151],["κύριος",707996,4],["ἐν",704639,0],["πίστει",710484,1]],"[As for] the prophet that has prophesied for peace, when the word has come [to pass], they shall know the prophet whom the Lord has sent them in truth."],["10",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Ανανιας",701016,4],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["παντὸς",710177,116],["τοῦ",709436,35],["λαοῦ",708094,18],["τοὺς",709436,58],["κλοιοὺς",707741,57],["ἀπὸ",701425,0],["τοῦ",709436,35],["τραχήλου",712924,18],["Ιερεμιου",706611,18],["καὶ",707031,7],["συνέτριψεν",712520,2],["αὐτούς",702165,62]],"Then Ananias took the yokes from the neck of Jeremias in the sight of all the people, and broke them to pieces."],["11",[["καὶ",707031,7],["εἶπεν",705373,2],["Ανανιας",701016,4],["κατ᾿",707200,0],["ὀφθαλμοὺς",709870,57],["παντὸς",710177,116],["τοῦ",709436,35],["λαοῦ",708094,18],["λέγων",708124,72],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["οὕτως",709859,28],["συντρίψω",712520,207],["τὸν",709436,5],["ζυγὸν",705894,6],["βασιλέως",702580,18],["Βαβυλῶνος",702352,17],["ἀπὸ",701425,0],["τραχήλων",712924,81],["πάντων",710177,83],["τῶν",709436,43],["ἐθνῶν",704068,44],["καὶ",707031,7],["ᾤχετο",709539,19],["Ιερεμιας",706611,4],["εἰς",704105,0],["τὴν",709436,8],["ὁδὸν",709458,9],["αὐτοῦ",702165,102]],"And Ananias spoke in the presence of all the people, saying, Thus said the Lord; Thus will I break the yoke of the king of Babylon from the necks of all the nations. And Jeremias went his way."],["12",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρὸς",710844,0],["Ιερεμιαν",706611,6],["μετὰ",708780,0],["τὸ",709436,24],["συντρῖψαι",712520,106],["Ανανιαν",701016,6],["τοὺς",709436,58],["κλοιοὺς",707741,57],["ἀπὸ",701425,0],["τοῦ",709436,35],["τραχήλου",712924,18],["αὐτοῦ",702165,102],["λέγων",708124,72]],"And the word of the Lord came to Jeremias, after that Ananias had broken the yokes off his neck, saying,"],["13",[["βάδιζε",702367,240],["καὶ",707031,7],["εἰπὸν",705373,176],["πρὸς",710844,0],["Ανανιαν",701016,6],["λέγων",708124,72],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["κλοιοὺς",707741,57],["ξυλίνους",709425,60],["συνέτριψας",712520,162],["καὶ",707031,7],["ποιήσω",710582,165],["ἀντ᾿",701227,0],["αὐτῶν",702165,40],["κλοιοὺς",707741,57],["σιδηροῦς",711771,14]],"Go and speak to Ananias, saying, Thus saith the Lord; Thou hast broken the yokes of wood; but I will make instead of them yokes of iron."],["14",[["ὅτι",709803,7],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["ζυγὸν",705894,6],["σιδηροῦν",711771,27],["ἔθηκα",712849,155],["ἐπὶ",705080,0],["τὸν",709436,5],["τράχηλον",712924,6],["πάντων",710177,83],["τῶν",709436,43],["ἐθνῶν",704068,44],["ἐργάζεσθαι",705383,110],["τῷ",709436,113],["βασιλεῖ",702580,114],["Βαβυλῶνος",702352,17]],"For thus said the Lord, I have put a yoke of iron on the neck of all the nations, that they may serve the king of Babylon."],["15",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιερεμιας",706611,4],["τῷ",709436,113],["Ανανια",701016,114],["οὐκ",709805,28],["ἀπέσταλκέν",701592,171],["σε",711598,163],["κύριος",707996,4],["καὶ",707031,7],["πεποιθέναι",710221,115],["ἐποίησας",710582,162],["τὸν",709436,5],["λαὸν",708094,6],["τοῦτον",709858,85],["ἐπ᾿",705080,0],["ἀδίκῳ",700272,30]],"And Jeremias said to Ananias, The Lord has not sent thee; and thou hast caused this people to trust in unrighteousness."],["16",[["διὰ",703417,0],["τοῦτο",709858,129],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐξαποστέλλω",704872,157],["σε",711598,163],["ἀπὸ",701425,0],["προσώπου",710986,21],["τῆς",709436,16],["γῆς",703083,17],["τούτῳ",709858,50],["τῷ",709436,113],["ἐνιαυτῷ",704745,114],["ἀποθανῇ",701461,123]],"Therefore thus said the Lord: Behold, I [will] cast thee off from the face of the earth: this year thou shalt die."],["17",[["καὶ",707031,7],["ἀπέθανεν",701461,2],["ἐν",704639,0],["τῷ",709436,113],["μηνὶ",708874,114],["τῷ",709436,113],["ἑβδόμῳ",703925,30]],"So he died in the seventh month."]]