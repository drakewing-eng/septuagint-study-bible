,700587,155],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["προσεύξομαι",710893,181],["πρὸς",710844,0],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["ἡμῶν",705999,145],["κατὰ",707200,0],["τοὺς",709436,58],["λόγους",708236,57],["ὑμῶν",713091,145],["καὶ",707031,7],["ἔσται",704093,93],["ὁ",709436,3],["λόγος",708236,4],["ὃν",709781,112],["ἂν",700900,11],["ἀποκριθήσεται",701492,134],["κύριος",707996,4],["ἀναγγελῶ",700921,165],["ὑμῖν",713084,90],["οὐ",709805,28],["μὴ",708851,28],["κρύψω",707923,207],["ἀφ᾿",701425,0],["ὑμῶν",713091,145],["ῥῆμα",711246,25]],"And Jeremias said to them, I have heard [you]; behold, I will pray for you to the Lord our God, according to your words; and it shall come to pass, [that] whatsoever word the Lord God shall answer, I will declare [it] to you; I will not hide anything from you."],["5",[["καὶ",707031,7],["αὐτοὶ",702165,201],["εἶπαν",705373,150],["τῷ",709436,113],["Ιερεμια",706611,114],["ἔστω",704093,31],["κύριος",707996,4],["ἐν",704639,0],["ἡμῖν",705994,90],["εἰς",704105,0],["μάρτυρα",708527,6],["δίκαιον",703694,27],["καὶ",707031,7],["πιστόν",710486,27],["εἰ",704071,7],["μὴ",708851,28],["κατὰ",707200,0],["πάντα",710177,27],["τὸν",709436,5],["λόγον",708236,6],["ὃν",709781,112],["ἂν",700900,11],["ἀποστείλῃ",701592,172],["σε",711598,163],["κύριος",707996,4],["πρὸς",710844,0],["ἡμᾶς",705981,194],["οὕτως",709859,28],["ποιήσομεν",710582,275]],"And they said to Jeremias, Let the Lord be between us for a just and faithful witness, if we do not according to every word which the Lord shall send to us."],["6",[["καὶ",707031,7],["ἐὰν",703912,7],["ἀγαθὸν",700106,27],["καὶ",707031,7],["ἐὰν",703912,7],["κακόν",707066,27],["τὴν",709436,8],["φωνὴν",713640,9],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["οὗ",709781,48],["ἡμεῖς",705983,219],["ἀποστέλλομέν",701592,243],["σε",711598,163],["πρὸς",710844,0],["αὐτόν",702165,85],["ἀκουσόμεθα",700587,141],["ἵνα",706747,7],["βέλτιον",702647,26],["ἡμῖν",705994,90],["γένηται",703104,239],["ὅτι",709803,7],["ἀκουσόμεθα",700587,141],["τῆς",709436,16],["φωνῆς",713640,17],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145]],"And whether [it be] good, or whether [it be] evil, we will hearken to the voice of the Lord our God, to whom we send thee; that it may be well with us, because we shall hearken to the voice of the Lord our God."],["7",[["καὶ",707031,7],["ἐγενήθη",703104,37],["μετὰ",708780,0],["δέκα",703333,59],["ἡμέρας",705984,39],["ἐγενήθη",703104,37],["λόγος",708236,4],["κυρίου",707996,18],["πρὸς",710844,0],["Ιερεμιαν",706611,6]],"And it came to pass after ten days, [that] the word of the Lord came to Jeremias."],["8",[["καὶ",707031,7],["ἐκάλεσεν",707084,2],["τὸν",709436,5],["Ιωαναν",706888,6],["καὶ",707031,7],["τοὺς",709436,58],["ἡγεμόνας",705930,57],["τῆς",709436,16],["δυνάμεως",703839,17],["καὶ",707031,7],["πάντα",710177,27],["τὸν",709436,5],["λαὸν",708094,6],["ἀπὸ",701425,0],["μικροῦ",708915,116],["ἕως",705792,0],["μεγάλου",708653,116]],"And he called Joanan, and the leaders of the host, and all the people from the least even to the greatest,"],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4]],"and he said to them, Thus saith the Lord;"],["10",[["ἐὰν",703912,7],["καθίσαντες",707006,196],["καθίσητε",707006,125],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ταύτῃ",709858,105],["οἰκοδομήσω",709509,165],["ὑμᾶς",713080,194],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["καθέλω",706982,207],["καὶ",707031,7],["φυτεύσω",713636,207],["ὑμᾶς",713080,194],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἐκτίλω",704332,157],["ὅτι",709803,7],["ἀναπέπαυμαι",701027,326],["ἐπὶ",705080,0],["τοῖς",709436,147],["κακοῖς",707066,230],["οἷς",709781,311],["ἐποίησα",710582,155],["ὑμῖν",713084,90]],"If ye will indeed dwell in this land, I will build you, and will not pull [you] down, but will plant you, and in no wise pluck you up: for I have ceased from the calamities which I brought upon you."],["11",[["μὴ",708851,28],["φοβηθῆτε",713532,394],["ἀπὸ",701425,0],["προσώπου",710986,21],["βασιλέως",702580,18],["Βαβυλῶνος",702352,17],["οὗ",709781,48],["ὑμεῖς",713081,219],["φοβεῖσθε",713532,374],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["μὴ",708851,28],["φοβηθῆτε",713532,394],["φησὶν",713437,91],["κύριος",707996,4],["ὅτι",709803,7],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["ἐγώ",704018,164],["εἰμι",704093,157],["τοῦ",709436,20],["ἐξαιρεῖσθαι",704838,110],["ὑμᾶς",713080,194],["καὶ",707031,7],["σῴζειν",712627,55],["ὑμᾶς",713080,194],["ἐκ",704132,0],["χειρὸς",713787,17],["αὐτοῦ",702165,102]],"Be not afraid of the king of Babylon, of whom ye are afraid; be not afraid of him, saith the Lord: for I am with you, to deliver you, and save you out of their hand."],["12",[["καὶ",707031,7],["δώσω",703654,165],["ὑμῖν",713084,90],["ἔλεος",704426,25],["καὶ",707031,7],["ἐλεήσω",704418,165],["ὑμᾶς",713080,194],["καὶ",707031,7],["ἐπιστρέψω",705278,165],["ὑμᾶς",713080,194],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ὑμῶν",713091,145]],"And I will grant you mercy, and pity you, and will restore you to your land."],["13",[["καὶ",707031,7],["εἰ",704071,7],["λέγετε",708124,87],["ὑμεῖς",713081,219],["οὐ",709805,28],["μὴ",708851,28],["καθίσωμεν",707006,79],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ταύτῃ",709858,105],["πρὸς",710844,0],["τὸ",709436,24],["μὴ",708851,28],["ἀκοῦσαι",700587,106],["φωνῆς",713640,17],["κυρίου",707996,18]],"But if ye say, We will not dwell in this land, that we may not hearken to the voice of the Lord;"],["14",[["ὅτι",709803,7],["εἰς",704105,0],["γῆν",703083,9],["Αἰγύπτου",700401,17],["εἰσελευσόμεθα",704114,141],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἴδωμεν",709725,79],["πόλεμον",710605,6],["καὶ",707031,7],["φωνὴν",713640,9],["σάλπιγγος",711424,17],["οὐ",709805,28],["μὴ",708851,28],["ἀκούσωμεν",700587,79],["καὶ",707031,7],["ἐν",704639,0],["ἄρτοις",701829,148],["οὐ",709805,28],["μὴ",708851,28],["πεινάσωμεν",710222,79],["καὶ",707031,7],["ἐκεῖ",704181,28],["οἰκήσομεν",709499,275]],"for we will go into the land of Egypt, and we shall see no war, and shall not hear the sound of a trumpet, and we shall not hunger for bread; and there we will dwell:"],["15",[["διὰ",703417,0],["τοῦτο",709858,129],["ἀκούσατε",700587,74],["λόγον",708236,6],["κυρίου",707996,18],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["ἐὰν",703912,7],["ὑμεῖς",713081,219],["δῶτε",703654,125],["τὸ",709436,24],["πρόσωπον",710986,25],["ὑμῶν",713091,145],["εἰς",704105,0],["Αἴγυπτον",700401,9],["καὶ",707031,7],["εἰσέλθητε",704114,125],["ἐκεῖ",704181,28],["κατοικεῖν",707534,55]],"then hear the word of the Lord; thus saith the Lord;"],["16",[["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["ῥομφαία",711291,12],["ἣν",709781,131],["ὑμεῖς",713081,219],["φοβεῖσθε",713532,374],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτῆς",702165,86],["εὑρήσει",705676,127],["ὑμᾶς",713080,194],["ἐν",704639,0],["γῇ",703083,1],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ὁ",709436,3],["λιμός",708210,4],["οὗ",709781,48],["ὑμεῖς",713081,219],["λόγον",708236,6],["ἔχετε",705785,87],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["καταλήμψεται",707300,93],["ὑμᾶς",713080,194],["ὀπίσω",709697,28],["ὑμῶν",713091,145],["ἐν",704639,0],["Αἰγύπτῳ",700401,1],["καὶ",707031,7],["ἐκεῖ",704181,28],["ἀποθανεῖσθε",701461,124]],"If ye set your face toward Egypt, and go in there to dwell; then it shall be, [that] the sword which ye fear shall find you in the land of Egypt, and the famine to which ye have regard, shall overtake you, [coming] after you in Egypt; and there ye shall die."],["17",[["καὶ",707031,7],["ἔσονται",704093,135],["πάντες",710177,138],["οἱ",709436,136],["ἄνθρωποι",701163,52],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["ἀλλογενεῖς",700690,138],["οἱ",709436,136],["θέντες",712849,196],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτῶν",702165,40],["εἰς",704105,0],["γῆν",703083,9],["Αἰγύπτου",700401,17],["ἐνοικεῖν",704772,55],["ἐκεῖ",704181,28],["ἐκλείψουσιν",704237,218],["ἐν",704639,0],["τῇ",709436,100],["ῥομφαίᾳ",711291,1],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["λιμῷ",708210,114],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["αὐτῶν",702165,40],["οὐθεὶς",709817,14],["σῳζόμενος",712627,122],["ἀπὸ",701425,0],["τῶν",709436,43],["κακῶν",707066,83],["ὧν",709781,103],["ἐγὼ",704018,164],["ἐπάγω",704994,157],["ἐπ᾿",705080,0],["αὐτούς",702165,62]],"And all the men, and all the strangers who have set their face toward the land of Egypt to dwell there, shall be consumed by the sword, and by the famine: and there shall not one of them escape from the evils which I bring upon them."],["18",[["ὅτι",709803,7],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["καθὼς",707030,28],["ἔσταξεν",712038,2],["ὁ",709436,3],["θυμός",706334,4],["μου",709032,133],["ἐπὶ",705080,0],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["Ιερουσαλημ",706644,9],["οὕτως",709859,28],["στάξει",712038,127],["ὁ",709436,3],["θυμός",706334,4],["μου",709032,133],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["εἰσελθόντων",704114,221],["ὑμῶν",713091,145],["εἰς",704105,0],["Αἴγυπτον",700401,9],["καὶ",707031,7],["ἔσεσθε",704093,124],["εἰς",704105,0],["ἄβατον",700023,27],["καὶ",707031,7],["ὑποχείριοι",713258,138],["καὶ",707031,28],["εἰς",704105,0],["ἀρὰν",701665,9],["καὶ",707031,7],["εἰς",704105,0],["ὀνειδισμὸν",709657,6],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἴδητε",709725,125],["οὐκέτι",709827,28],["τὸν",709436,5],["τόπον",712903,6],["τοῦτον",709858,85]],"For thus saith the Lord; As my wrath has dropped upon the inhabitants of Jerusalem, so shall my wrath drop upon you, when ye have entered into Egypt: and ye shall be a desolation, and under the power of others, and a curse and a reproach: and ye shall no more see this place."],["19",[["ἃ",709781,69],["ἐλάλησεν",708071,2],["κύριος",707996,4],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["τοὺς",709436,58],["καταλοίπους",707317,60],["Ιουδα",706768,18],["μὴ",708851,28],["εἰσέλθητε",704114,125],["εἰς",704105,0],["Αἴγυπτον",700401,9],["καὶ",707031,7],["νῦν",709384,28],["γνόντες",703105,196],["γνώσεσθε",703105,124]],"[These are the words] which the Lord has spoken concerning you the remnant of Juda; Enter ye not into Egypt: and now know ye for a certainty,"],["20",[["ὅτι",709803,7],["ἐπονηρεύσασθε",710658,345],["ἐν",704639,0],["ψυχαῖς",714070,76],["ὑμῶν",713091,145],["ἀποστείλαντές",701592,196],["με",708618,163],["λέγοντες",708124,146],["πρόσευξαι",710893,300],["περὶ",710285,0],["ἡμῶν",705999,145],["πρὸς",710844,0],["κύριον",707996,6],["καὶ",707031,7],["κατὰ",707200,0],["πάντα",710177,68],["ἃ",709781,69],["ἐὰν",703912,7],["λαλήσῃ",708071,123],["σοι",711925,159],["κύριος",707996,4],["ποιήσομεν",710582,275]],"that ye have wrought wickedness in your hearts, when ye sent me, saying, Pray thou for us to the Lord; and according to all that the Lord shall speak to thee we will do."],["21",[["καὶ",707031,7],["οὐκ",709805,28],["ἠκούσατε",700587,265],["τῆς",709436,16],["φωνῆς",713640,17],["κυρίου",707996,18],["ἧς",709781,167],["ἀπέστειλέν",701592,2],["με",708618,163],["πρὸς",710844,0],["ὑμᾶς",713080,194]],"And ye have not hearkened to the voice of the Lord, with which he sent me to you."],["22",[["καὶ",707031,7],["νῦν",709384,28],["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["καὶ",707031,7],["ἐν",704639,0],["λιμῷ",708210,114],["ἐκλείψετε",704237,337],["ἐν",704639,0],["τῷ",709436,113],["τόπῳ",712903,114],["οὗ",709781,48],["ὑμεῖς",713081,219],["βούλεσθε",702795,374],["εἰσελθεῖν",704114,106],["κατοικεῖν",707534,55],["ἐκεῖ",704181,28]],"Now therefore ye shall perish by sword and by famine, in the place which ye desire to go into to dwell there."]]