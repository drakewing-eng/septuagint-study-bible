[["1",[["ἐὰν",703912,7],["ἐπιστραφῇ",705278,384],["Ισραηλ",706839,4],["λέγει",708124,91],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["ἐπιστραφήσεται",705278,134],["ἐὰν",703912,7],["περιέλῃ",710314,384],["τὰ",709436,41],["βδελύγματα",702604,42],["αὐτοῦ",702165,102],["ἐκ",704132,0],["στόματος",712125,21],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,20],["προσώπου",710986,21],["μου",709032,133],["εὐλαβηθῇ",705627,384]],"If Israel will return to me, saith the Lord, he shall return: and if he will remove his abominations out of his mouth, and fear before me, and swear,"],["2",[["καὶ",707031,7],["ὀμόσῃ",709620,123],["ζῇ",705851,91],["κύριος",707996,4],["μετὰ",708780,0],["ἀληθείας",700656,17],["καὶ",707031,7],["ἐν",704639,0],["κρίσει",707908,1],["καὶ",707031,7],["ἐν",704639,0],["δικαιοσύνῃ",703695,1],["καὶ",707031,7],["εὐλογήσουσιν",705631,218],["ἐν",704639,0],["αὐτῇ",702165,105],["ἔθνη",704068,64],["καὶ",707031,7],["ἐν",704639,0],["αὐτῷ",702165,50],["αἰνέσουσιν",700459,218],["τῷ",709436,113],["θεῷ",706192,114],["ἐν",704639,0],["Ιερουσαλημ",706644,1]],"The Lord lives, with truth, in judgment and righteousness, then shall nations bless by him, and by him they shall praise God in Jerusalem."],["3",[["ὅτι",709803,7],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["τοῖς",709436,147],["ἀνδράσιν",701150,148],["Ιουδα",706768,18],["καὶ",707031,7],["τοῖς",709436,147],["κατοικοῦσιν",707534,349],["Ιερουσαλημ",706644,9],["νεώσατε",709261,74],["ἑαυτοῖς",703917,151],["νεώματα",709286,42],["καὶ",707031,7],["μὴ",708851,28],["σπείρητε",712006,125],["ἐπ᾿",705080,0],["ἀκάνθαις",700517,76]],"For thus saith the Lord to the men of Juda, and to the inhabitants of Jerusalem, Break up fresh ground for yourselves, and sow not among thorns."],["4",[["περιτμήθητε",710402,372],["τῷ",709436,113],["θεῷ",706192,114],["ὑμῶν",713091,145],["καὶ",707031,7],["περιτέμεσθε",710402,186],["τὴν",709436,8],["σκληροκαρδίαν",711859,9],["ὑμῶν",713091,145],["ἄνδρες",701150,274],["Ιουδα",706768,18],["καὶ",707031,7],["οἱ",709436,136],["κατοικοῦντες",707534,146],["Ιερουσαλημ",706644,9],["μὴ",708851,28],["ἐξέλθῃ",704909,172],["ὡς",714148,7],["πῦρ",711088,15],["ὁ",709436,3],["θυμός",706334,4],["μου",709032,133],["καὶ",707031,7],["ἐκκαυθήσεται",704205,134],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ὁ",709436,3],["σβέσων",711596,72],["ἀπὸ",701425,0],["προσώπου",710986,21],["πονηρίας",710659,17],["ἐπιτηδευμάτων",705301,44],["ὑμῶν",713091,145]],"Circumcise yourselves to your God, and circumcise your hardness of heart, ye men of Juda, and inhabitants of Jerusalem: lest my wrath go forth as fire, and burn, and there be none to quench it, because of the evil of your devices."],["5",[["ἀναγγείλατε",700921,74],["ἐν",704639,0],["τῷ",709436,113],["Ιουδα",706768,114],["καὶ",707031,7],["ἀκουσθήτω",700587,22],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["εἴπατε",705373,265],["σημάνατε",711745,74],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["σάλπιγγι",711424,1],["καὶ",707031,7],["κεκράξατε",707868,74],["μέγα",708653,46],["εἴπατε",705373,74],["συνάχθητε",712375,372],["καὶ",707031,7],["εἰσέλθωμεν",704114,79],["εἰς",704105,0],["τὰς",709436,38],["πόλεις",710612,39],["τὰς",709436,38],["τειχήρεις",712756,119]],"Declare ye in Juda, and let it be heard in Jerusalem: say ye, Sound the trumpet in the land; cry ye aloud: say ye, Gather yourselves together, and let us enter into the fortified cities."],["6",[["ἀναλαβόντες",700984,196],["φεύγετε",713433,335],["εἰς",704105,0],["Σιων",711816,9],["σπεύσατε",712011,74],["μὴ",708851,28],["στῆτε",706846,74],["ὅτι",709803,7],["κακὰ",707066,68],["ἐγὼ",704018,164],["ἐπάγω",704994,157],["ἀπὸ",701425,0],["βορρᾶ",702765,18],["καὶ",707031,7],["συντριβὴν",712519,9],["μεγάλην",708653,36]],"Gather up [your wares] and flee to Sion: hasten, stay not: for I will bring evils from the north, and great destruction."],["7",[["ἀνέβη",700905,2],["λέων",708171,4],["ἐκ",704132,0],["τῆς",709436,16],["μάνδρας",708473,17],["αὐτοῦ",702165,102],["ἐξολεθρεύων",704956,72],["ἔθνη",704068,42],["ἐξῆρεν",704839,2],["καὶ",707031,7],["ἐξῆλθεν",704909,2],["ἐκ",704132,0],["τοῦ",709436,35],["τόπου",712903,18],["αὐτοῦ",702165,102],["τοῦ",709436,20],["θεῖναι",712849,106],["τὴν",709436,8],["γῆν",703083,9],["εἰς",704105,0],["ἐρήμωσιν",705422,9],["καὶ",707031,7],["πόλεις",710612,191],["καθαιρεθήσονται",706982,144],["παρὰ",709995,0],["τὸ",709436,24],["μὴ",708851,28],["κατοικεῖσθαι",707534,110],["αὐτάς",702165,231]],"The lion is gone up from his lair, he has roused [himself] to the destruction of the nations, and has gone forth out of his place, to make the land desolate; and the cities shall be destroyed, so as to be without inhabitant."],["8",[["ἐπὶ",705080,0],["τούτοις",709858,151],["περιζώσασθε",710317,186],["σάκκους",711386,57],["καὶ",707031,7],["κόπτεσθε",707829,73],["καὶ",707031,7],["ἀλαλάξατε",700632,74],["διότι",703734,7],["οὐκ",709805,28],["ἀπεστράφη",701598,37],["ὁ",709436,3],["θυμὸς",706334,4],["κυρίου",707996,18],["ἀφ᾿",701425,0],["ὑμῶν",713091,145]],"For these things gird yourselves with sackclothes, and lament, and howl: for the anger of the Lord is not turned away from you."],["9",[["καὶ",707031,7],["ἔσται",704093,93],["ἐν",704639,0],["ἐκείνῃ",704183,105],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["λέγει",708124,91],["κύριος",707996,4],["ἀπολεῖται",701513,93],["ἡ",709436,10],["καρδία",707141,12],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["ἡ",709436,10],["καρδία",707141,12],["τῶν",709436,80],["ἀρχόντων",701862,81],["καὶ",707031,7],["οἱ",709436,136],["ἱερεῖς",706614,52],["ἐκστήσονται",704940,135],["καὶ",707031,7],["οἱ",709436,136],["προφῆται",711009,52],["θαυμάσονται",706135,135]],"And it shall come to pass in that day, saith the Lord, that the heart of the king shall perish, and the heart of the princes; and the priests shall be amazed, and the prophets shall wonder."],["10",[["καὶ",707031,7],["εἶπα",705373,155],["ὦ",714081,88],["δέσποτα",703379,153],["κύριε",707996,153],["ἄρα",701666,11],["γε",702985,11],["ἀπατῶν",701364,72],["ἠπάτησας",701364,162],["τὸν",709436,5],["λαὸν",708094,6],["τοῦτον",709858,85],["καὶ",707031,7],["τὴν",709436,8],["Ιερουσαλημ",706644,9],["λέγων",708124,72],["εἰρήνη",704098,12],["ἔσται",704093,93],["ὑμῖν",713084,90],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἥψατο",701654,23],["ἡ",709436,10],["μάχαιρα",708593,12],["ἕως",705792,0],["τῆς",709436,16],["ψυχῆς",714070,17],["αὐτῶν",702165,40]],"And I said, O sovereign Lord, verily thou hast greatly deceived this people and Jerusalem, saying, There shall be peace; whereas behold, the sword has reached even to their soul."],["11",[["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["ἐροῦσιν",705415,218],["τῷ",709436,113],["λαῷ",708094,114],["τούτῳ",709858,50],["καὶ",707031,7],["τῇ",709436,100],["Ιερουσαλημ",706644,1],["πνεῦμα",710566,15],["πλανήσεως",710497,17],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["ὁδὸς",709458,12],["τῆς",709436,16],["θυγατρὸς",706320,17],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133],["οὐκ",709805,28],["εἰς",704105,0],["καθαρὸν",706988,46],["οὐδ᾿",709816,7],["εἰς",704105,0],["ἅγιον",700159,46]],"At that time they shall say to this people and to Jerusalem, [There is] a spirit of error in the wilderness: the way of the daughter of my people is not to purity, nor to holiness."],["12",[["πνεῦμα",710566,25],["πληρώσεως",710545,17],["ἥξει",705956,127],["μοι",708974,159],["νῦν",709384,28],["δὲ",703303,11],["ἐγὼ",704018,164],["λαλῶ",708071,157],["κρίματα",707903,42],["πρὸς",710844,0],["αὐτούς",702165,62]],"[But] a spirit of full vengeance shall come upon me; and now I declare my judgments against them."],["13",[["ἰδοὺ",706497,88],["ὡς",714148,7],["νεφέλη",709277,12],["ἀναβήσεται",700905,93],["καὶ",707031,7],["ὡς",714148,7],["καταιγὶς",707254,12],["τὰ",709436,63],["ἅρματα",701768,64],["αὐτοῦ",702165,102],["κουφότεροι",707863,267],["ἀετῶν",700318,81],["οἱ",709436,136],["ἵπποι",706790,52],["αὐτοῦ",702165,102],["οὐαὶ",709807,88],["ἡμῖν",705994,90],["ὅτι",709803,7],["ταλαιπωροῦμεν",712694,243]],"Behold, he shall come up as a cloud, and his chariots as a tempest: his horses are swifter than eagles. Woe unto us! for we are in misery."],["14",[["ἀπόπλυνε",701549,240],["ἀπὸ",701425,0],["κακίας",707054,17],["τὴν",709436,8],["καρδίαν",707141,9],["σου",711945,133],["Ιερουσαλημ",706644,258],["ἵνα",706747,7],["σωθῇς",712627,279],["ἕως",705792,0],["πότε",710696,28],["ὑπάρξουσιν",713104,218],["ἐν",704639,0],["σοὶ",711925,159],["διαλογισμοὶ",703506,52],["πόνων",710661,81],["σου",711945,133]],"Cleanse thine heart from wickedness, O Jerusalem, that thou mayest be saved: how long will thy grievous thoughts be within thee?"],["15",[["διότι",703734,7],["φωνὴ",713640,12],["ἀναγγέλλοντος",700921,152],["ἐκ",704132,0],["Δαν",703276,18],["ἥξει",705956,127],["καὶ",707031,7],["ἀκουσθήσεται",700587,134],["πόνος",710661,4],["ἐξ",704132,0],["ὄρους",709768,21],["Εφραιμ",705769,18]],"For a voice of one publishing from Dan shall come, and trouble out of mount Ephraim shall be heard of."],["16",[["ἀναμνήσατε",701002,74],["ἔθνη",704068,42],["ἰδοὺ",706497,88],["ἥκασιν",705956,197],["ἀναγγείλατε",700921,74],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["συστροφαὶ",712563,191],["ἔρχονται",705453,269],["ἐκ",704132,0],["γῆς",703083,17],["μακρόθεν",708417,28],["καὶ",707031,7],["ἔδωκαν",703654,150],["ἐπὶ",705080,0],["τὰς",709436,38],["πόλεις",710612,39],["Ιουδα",706768,18],["φωνὴν",713640,9],["αὐτῶν",702165,284]],"Remind ye the nations; behold, they are come: proclaim [it] in Jerusalem, that bands are approaching from a land afar off, and have uttered their voice against the cities of Juda."],["17",[["ὡς",714148,7],["φυλάσσοντες",713619,146],["ἀγρὸν",700196,6],["ἐγένοντο",703104,189],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["κύκλῳ",707959,114],["ὅτι",709803,7],["ἐμοῦ",704580,133],["ἠμέλησας",700803,162],["λέγει",708124,91],["κύριος",707996,4]],"As keepers of a field, they have surrounded her; because thou, saith the Lord, hast neglected me."],["18",[["αἱ",709436,190],["ὁδοί",709458,191],["σου",711945,133],["καὶ",707031,7],["τὰ",709436,63],["ἐπιτηδεύματά",705301,64],["σου",711945,133],["ἐποίησαν",710582,150],["ταῦτά",709858,71],["σοι",711925,159],["αὕτη",709858,107],["ἡ",709436,10],["κακία",707054,12],["σου",711945,133],["ὅτι",709803,7],["πικρά",710475,29],["ὅτι",709803,7],["ἥψατο",701654,23],["ἕως",705792,0],["τῆς",709436,16],["καρδίας",707141,17],["σου",711945,133]],"Thy ways and thy devices have brought these things upon thee; this is thy wickedness, for [it is] bitter, for it has reached to thy heart."],["19",[["τὴν",709436,8],["κοιλίαν",707761,9],["μου",709032,133],["τὴν",709436,8],["κοιλίαν",707761,9],["μου",709032,133],["ἀλγῶ",700638,157],["καὶ",707031,7],["τὰ",709436,41],["αἰσθητήρια",700478,42],["τῆς",709436,16],["καρδίας",707141,17],["μου",709032,133],["μαιμάσσει",708387,91],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["σπαράσσεται",711994,117],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["οὐ",709805,28],["σιωπήσομαι",711818,181],["ὅτι",709803,7],["φωνὴν",713640,9],["σάλπιγγος",711424,17],["ἤκουσεν",700587,2],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["κραυγὴν",707886,9],["πολέμου",710605,18]],"I am pained in my bowels, my bowels, and the sensitive powers of my heart; my soul is in great commotion, my heart is torn: I will not be silent, for my soul has heard the sound of a trumpet, the cry of war, and of distress: it calls on destruction;"],["20",[["καὶ",707031,7],["ταλαιπωρίαν",712695,9],["συντριμμὸν",712522,6],["ἐπικαλεῖται",705153,117],["ὅτι",709803,7],["τεταλαιπώρηκεν",712694,171],["πᾶσα",710177,29],["ἡ",709436,10],["γῆ",703083,12],["ἄφνω",702215,28],["τεταλαιπώρηκεν",712694,171],["ἡ",709436,10],["σκηνή",711845,12],["διεσπάσθησαν",703583,99],["αἱ",709436,190],["δέρρεις",703365,191],["μου",709032,133]],"for all the land is distressed: suddenly [my] tabernacle is distressed, my curtains have been rent asunder."],["21",[["ἕως",705792,0],["πότε",710696,28],["ὄψομαι",709725,181],["φεύγοντας",713433,235],["ἀκούων",700587,72],["φωνὴν",713640,9],["σαλπίγγων",711424,65]],"How long shall I see fugitives, and hear the sound of the trumpet?"],["22",[["διότι",703734,7],["οἱ",709436,136],["ἡγούμενοι",705931,348],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133],["ἐμὲ",704555,163],["οὐκ",709805,28],["ᾔδεισαν",709492,263],["υἱοὶ",713075,52],["ἄφρονές",702236,138],["εἰσιν",704093,197],["καὶ",707031,7],["οὐ",709805,28],["συνετοί",712464,138],["σοφοί",711985,138],["εἰσιν",704093,197],["τοῦ",709436,20],["κακοποιῆσαι",707062,106],["τὸ",709436,24],["δὲ",703303,11],["καλῶς",707106,28],["ποιῆσαι",710582,106],["οὐκ",709805,28],["ἐπέγνωσαν",705104,150]],"For the princes of my people have not known me, they are foolish and unwise children: they are wise to do evil, but [how] to do good they have not known."],["23",[["ἐπέβλεψα",705088,155],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἰδοὺ",706497,88],["οὐθέν",709817,46],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["οὐρανόν",709844,6],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["τὰ",709436,63],["φῶτα",713642,64],["αὐτοῦ",702165,102]],"I looked upon the earth, and, behold, [it was] not; and to the sky, and there was no light in it."],["24",[["εἶδον",709725,155],["τὰ",709436,41],["ὄρη",709768,42],["καὶ",707031,7],["ἦν",704093,13],["τρέμοντα",712928,242],["καὶ",707031,7],["πάντας",710177,60],["τοὺς",709436,58],["βουνοὺς",702797,57],["ταρασσομένους",712721,235]],"I beheld the mountains, and they trembled, and [I saw] all the hills in commotion."],["25",[["ἐπέβλεψα",705088,155],["καὶ",707031,7],["ἰδοὺ",706497,88],["οὐκ",709805,28],["ἦν",704093,13],["ἄνθρωπος",701163,4],["καὶ",707031,7],["πάντα",710177,195],["τὰ",709436,63],["πετεινὰ",710439,64],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["ἐπτοεῖτο",711062,19]],"I looked, and, behold, there was no man, and all the birds of the sky were scared."],["26",[["εἶδον",709725,155],["καὶ",707031,7],["ἰδοὺ",706497,88],["ὁ",709436,3],["Κάρμηλος",707161,4],["ἔρημος",705420,12],["καὶ",707031,7],["πᾶσαι",710177,192],["αἱ",709436,190],["πόλεις",710612,191],["ἐμπεπυρισμέναι",704622,415],["πυρὶ",711088,54],["ἀπὸ",701425,0],["προσώπου",710986,21],["κυρίου",707996,18],["καὶ",707031,7],["ἀπὸ",701425,0],["προσώπου",710986,21],["ὀργῆς",709728,17],["θυμοῦ",706334,18],["αὐτοῦ",702165,102],["ἠφανίσθησαν",702182,99]],"I saw, and, behold, Carmel was desert, and all the cities were burnt with fire at the presence of the Lord, and at the presence of his fierce anger they were utterly destroyed."],["27",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἔρημος",705420,12],["ἔσται",704093,93],["πᾶσα",710177,29],["ἡ",709436,10],["γῆ",703083,12],["συντέλειαν",712509,9],["δὲ",703303,11],["οὐ",709805,28],["μὴ",708851,28],["ποιήσω",710582,165]],"Thus saith the Lord, The whole land shall be desolate; but I will not make a full end."],["28",[["ἐπὶ",705080,0],["τούτοις",709858,151],["πενθείτω",710251,31],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["συσκοτασάτω",712551,45],["ὁ",709436,3],["οὐρανὸς",709844,4],["ἄνωθεν",701298,28],["διότι",703734,7],["ἐλάλησα",708071,155],["καὶ",707031,7],["οὐ",709805,28],["μετανοήσω",708809,165],["ὥρμησα",709755,155],["καὶ",707031,7],["οὐκ",709805,28],["ἀποστρέψω",701598,165],["ἀπ᾿",701425,0],["αὐτῆς",702165,86]],"For these things let the earth mourn, and let the sky be dark above: for I have spoken, and I will not repent; I have purposed, and I will not turn back from it."],["29",[["ἀπὸ",701425,0],["φωνῆς",713640,17],["ἱππέως",706786,18],["καὶ",707031,7],["ἐντεταμένου",704790,474],["τόξου",712898,21],["ἀνεχώρησεν",701092,2],["πᾶσα",710177,29],["χώρα",714011,12],["εἰσέδυσαν",704112,150],["εἰς",704105,0],["τὰ",709436,41],["σπήλαια",712012,42],["καὶ",707031,7],["εἰς",704105,0],["τὰ",709436,41],["ἄλση",700729,42],["ἐκρύβησαν",707923,99],["καὶ",707031,7],["ἐπὶ",705080,0],["τὰς",709436,38],["πέτρας",710443,39],["ἀνέβησαν",700905,150],["πᾶσα",710177,29],["πόλις",710612,12],["ἐγκατελείφθη",703967,37],["οὐ",709805,28],["κατοικεῖ",707534,91],["ἐν",704639,0],["αὐταῖς",702165,200],["ἄνθρωπος",701163,4]],"The whole land has recoiled from the noise of the horseman and the bent bow; they have gone into the caves, and have hidden themselves in the groves, and have gone up upon the rocks: every city was abandoned, no man dwelt in them."],["30",[["καὶ",707031,7],["σὺ",712181,164],["τί",712867,126],["ποιήσεις",710582,166],["ἐὰν",703912,7],["περιβάλῃ",710294,420],["κόκκινον",707783,27],["καὶ",707031,7],["κοσμήσῃ",707847,420],["κόσμῳ",707851,114],["χρυσῷ",713975,30],["καὶ",707031,7],["ἐὰν",703912,7],["ἐγχρίσῃ",704015,420],["στίβι",712101,54],["τοὺς",709436,58],["ὀφθαλμούς",709870,57],["σου",711945,133],["εἰς",704105,0],["μάτην",708582,28],["ὁ",709436,3],["ὡραϊσμός",714135,4],["σου",711945,133],["ἀπώσαντό",701659,189],["σε",711598,163],["οἱ",709436,136],["ἐρασταί",705379,52],["σου",711945,133],["τὴν",709436,8],["ψυχήν",714070,9],["σου",711945,133],["ζητοῦσιν",705879,197]],"And what wilt thou do? Though thou clothe thyself with scarlet, and adorn thyself with golden ornaments; though thou adorn thine eyes with stibium, thy beauty [will be] in vain: thy lovers have rejected thee, they seek thy life."],["31",[["ὅτι",709803,7],["φωνὴν",713640,9],["ὡς",714148,7],["ὠδινούσης",714095,222],["ἤκουσα",700587,155],["τοῦ",709436,35],["στεναγμοῦ",712065,18],["σου",711945,133],["ὡς",714148,7],["πρωτοτοκούσης",711044,222],["φωνὴ",713640,12],["θυγατρὸς",706320,17],["Σιων",711816,17],["ἐκλυθήσεται",704254,134],["καὶ",707031,7],["παρήσει",710149,127],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτῆς",702165,86],["οἴμμοι",709525,88],["ἐγώ",704018,164],["ὅτι",709803,7],["ἐκλείπει",704237,91],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ἐπὶ",705080,0],["τοῖς",709436,147],["ἀνῃρημένοις",700962,521]],"For I have heard thy groaning as the voice of a woman in travail, as of her that brings forth her first child; the voice of the daughter of Zion shall fail through weakness, and she shall lose the strength of her hands, [saying], Woe is me! for my soul faints because of the slain."]]