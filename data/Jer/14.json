[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρὸς",710844,0],["Ιερεμιαν",706611,6],["περὶ",710285,0],["τῆς",709436,16],["ἀβροχίας",700095,17]],"And the Word of the Lord came to Jeremias concerning the Drought."],["2",[["ἐπένθησεν",710251,2],["ἡ",709436,10],["Ιουδαία",706769,12],["καὶ",707031,7],["αἱ",709436,190],["πύλαι",711082,191],["αὐτῆς",702165,86],["ἐκενώθησαν",707614,99],["καὶ",707031,7],["ἐσκοτώθησαν",711890,99],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἡ",709436,10],["κραυγὴ",707886,12],["τῆς",709436,16],["Ιερουσαλημ",706644,17],["ἀνέβη",700905,2]],"Judea has mourned, and her gates are emptied, and are darkened upon the earth; and the cry of Jerusalem is gone up."],["3",[["καὶ",707031,7],["οἱ",709436,136],["μεγιστᾶνες",708657,52],["αὐτῆς",702165,86],["ἀπέστειλαν",701592,150],["τοὺς",709436,58],["νεωτέρους",709256,496],["αὐτῶν",702165,40],["ἐφ᾿",705080,0],["ὕδωρ",713071,25],["ἤλθοσαν",705453,150],["ἐπὶ",705080,0],["τὰ",709436,41],["φρέατα",713576,42],["καὶ",707031,7],["οὐχ",709805,28],["εὕροσαν",705676,150],["ὕδωρ",713071,25],["καὶ",707031,7],["ἀπέστρεψαν",701598,150],["τὰ",709436,41],["ἀγγεῖα",700138,42],["αὐτῶν",702165,40],["κενά",707612,68]],"And her nobles have sent their little ones to the water: they came to the wells, and found no water: and brought back their vessels empty."],["4",[["καὶ",707031,7],["τὰ",709436,63],["ἔργα",705396,64],["τῆς",709436,16],["γῆς",703083,17],["ἐξέλιπεν",704237,2],["ὅτι",709803,7],["οὐκ",709805,28],["ἦν",704093,13],["ὑετός",713074,4],["ᾐσχύνθησαν",700485,99],["γεωργοί",703082,52],["ἐπεκάλυψαν",705155,150],["τὴν",709436,8],["κεφαλὴν",707639,9],["αὐτῶν",702165,40]],"And the labours of the land failed, because there was no rain: the husbandmen were ashamed, they covered their heads."],["5",[["καὶ",707031,7],["ἔλαφοι",704398,52],["ἐν",704639,0],["ἀγρῷ",700196,114],["ἔτεκον",712853,150],["καὶ",707031,7],["ἐγκατέλιπον",703967,150],["ὅτι",709803,7],["οὐκ",709805,28],["ἦν",704093,13],["βοτάνη",702772,12]],"And hinds calved in the field, and forsook [it], because there was no grass."],["6",[["ὄνοι",709671,52],["ἄγριοι",700191,138],["ἔστησαν",706846,150],["ἐπὶ",705080,0],["νάπας",709193,39],["εἵλκυσαν",704508,150],["ἄνεμον",701123,6],["ἐξέλιπον",704237,150],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["αὐτῶν",702165,40],["ὅτι",709803,7],["οὐκ",709805,28],["ἦν",704093,13],["χόρτος",713923,4],["ἀπὸ",701425,0],["λαοῦ",708094,18],["ἀδικίας",700271,17]],"The wild asses stood by the forests, and snuffed up the wind; their eyes failed, because there was no grass."],["7",[["εἰ",704071,7],["αἱ",709436,190],["ἁμαρτίαι",700775,191],["ἡμῶν",705999,145],["ἀντέστησαν",701154,150],["ἡμῖν",705994,90],["κύριε",707996,153],["ποίησον",710582,176],["ἡμῖν",705994,90],["ἕνεκεν",704709,0],["σοῦ",711945,133],["ὅτι",709803,7],["πολλαὶ",710646,192],["αἱ",709436,190],["ἁμαρτίαι",700775,191],["ἡμῶν",705999,145],["ἐναντίον",704654,0],["σοῦ",711945,133],["ὅτι",709803,7],["σοὶ",711925,159],["ἡμάρτομεν",700773,289]],"Our sins have risen up against us: O Lord, do thou for us for thine own sake; for our sins are many before thee; for we have sinned against thee."],["8",[["ὑπομονὴ",713226,12],["Ισραηλ",706839,18],["κύριε",707996,153],["καὶ",707031,7],["σῴζεις",712627,154],["ἐν",704639,0],["καιρῷ",707047,114],["κακῶν",707066,169],["ἵνα",706747,7],["τί",712867,126],["ἐγενήθης",703104,168],["ὡσεὶ",714159,28],["πάροικος",710159,14],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ὡς",714148,7],["αὐτόχθων",702168,4],["ἐκκλίνων",704220,72],["εἰς",704105,0],["κατάλυμα",707320,25]],"O Lord, [thou art] the hope of Israel, and deliverest [us] in time of troubles; why art thou become as a sojourner upon the land, or as one born in the land, yet turning aside for a resting-place?"],["9",[["μὴ",708851,28],["ἔσῃ",704093,123],["ὥσπερ",714163,28],["ἄνθρωπος",701163,4],["ὑπνῶν",713182,72],["ἢ",705924,7],["ὡς",714148,7],["ἀνὴρ",701150,4],["οὐ",709805,28],["δυνάμενος",703838,122],["σῴζειν",712627,55],["καὶ",707031,7],["σὺ",712181,164],["ἐν",704639,0],["ἡμῖν",705994,90],["εἶ",704093,154],["κύριε",707996,153],["καὶ",707031,7],["τὸ",709436,34],["ὄνομά",709666,15],["σου",711945,133],["ἐπικέκληται",705153,187],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["μὴ",708851,28],["ἐπιλάθῃ",705187,172],["ἡμῶν",705999,145]],"Wilt thou be as a man asleep, or as a [strong] man that cannot save? yet thou art among us, O Lord, and thy name is called upon us; forget us not."],["10",[["οὕτως",709859,28],["λέγει",708124,91],["κύριος",707996,4],["τῷ",709436,113],["λαῷ",708094,114],["τούτῳ",709858,50],["ἠγάπησαν",700120,150],["κινεῖν",707679,55],["πόδας",710707,57],["αὐτῶν",702165,40],["καὶ",707031,7],["οὐκ",709805,28],["ἐφείσαντο",713406,189],["καὶ",707031,7],["ὁ",709436,3],["θεὸς",706192,4],["οὐκ",709805,28],["εὐδόκησεν",705565,2],["ἐν",704639,0],["αὐτοῖς",702165,151],["νῦν",709384,28],["μνησθήσεται",708923,134],["τῶν",709436,130],["ἀδικιῶν",700271,65],["αὐτῶν",702165,40]],"Thus saith the Lord to this people, They have loved to wander, and they have not spared, therefore God has not prospered them; now will he remember their iniquity."],["11",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["μὴ",708851,28],["προσεύχου",710893,253],["περὶ",710285,0],["τοῦ",709436,35],["λαοῦ",708094,18],["τούτου",709858,102],["εἰς",704105,0],["ἀγαθά",700106,68]],"And the Lord said to me, Pray not for this people for [their] good:"],["12",[["ὅτι",709803,7],["ἐὰν",703912,7],["νηστεύσωσιν",709304,234],["οὐκ",709805,28],["εἰσακούσομαι",704108,181],["τῆς",709436,16],["δεήσεως",703311,17],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐὰν",703912,7],["προσενέγκωσιν",710974,234],["ὁλοκαυτώματα",709589,42],["καὶ",707031,7],["θυσίας",706345,39],["οὐκ",709805,28],["εὐδοκήσω",705565,165],["ἐν",704639,0],["αὐτοῖς",702165,151],["ὅτι",709803,7],["ἐν",704639,0],["μαχαίρᾳ",708593,1],["καὶ",707031,7],["ἐν",704639,0],["λιμῷ",708210,114],["καὶ",707031,7],["ἐν",704639,0],["θανάτῳ",706096,114],["ἐγὼ",704018,164],["συντελέσω",712510,165],["αὐτούς",702165,62]],"for though they fast, I will not hear their supplication; and though they offer whole-burnt-offerings and sacrifices, I will take no pleasure in them: for I will consume them with sword, and with famine, and with pestilence."],["13",[["καὶ",707031,7],["εἶπα",705373,155],["ὦ",714081,88],["κύριε",707996,153],["ἰδοὺ",706497,88],["οἱ",709436,136],["προφῆται",711009,52],["αὐτῶν",702165,40],["προφητεύουσιν",711008,197],["καὶ",707031,7],["λέγουσιν",708124,197],["οὐκ",709805,28],["ὄψεσθε",709725,124],["μάχαιραν",708593,9],["οὐδὲ",709816,7],["λιμὸς",708210,4],["ἔσται",704093,93],["ἐν",704639,0],["ὑμῖν",713084,90],["ὅτι",709803,7],["ἀλήθειαν",700656,9],["καὶ",707031,7],["εἰρήνην",704098,9],["δώσω",703654,165],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["τόπῳ",712903,114],["τούτῳ",709858,50]],"And I said, O [ever] living Lord! behold, their prophets prophesy, and say, Ye shall not see a sword, nor shall famine be among you; for I will give truth and peace on the land, and in this place."],["14",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["ψευδῆ",714036,68],["οἱ",709436,136],["προφῆται",711009,52],["προφητεύουσιν",711008,197],["ἐπὶ",705080,0],["τῷ",709436,53],["ὀνόματί",709666,54],["μου",709032,133],["οὐκ",709805,28],["ἀπέστειλα",701592,155],["αὐτοὺς",702165,62],["καὶ",707031,7],["οὐκ",709805,28],["ἐνετειλάμην",704791,161],["αὐτοῖς",702165,151],["καὶ",707031,7],["οὐκ",709805,28],["ἐλάλησα",708071,155],["πρὸς",710844,0],["αὐτούς",702165,62],["ὅτι",709803,7],["ὁράσεις",709721,39],["ψευδεῖς",714036,119],["καὶ",707031,7],["μαντείας",708488,39],["καὶ",707031,7],["οἰωνίσματα",709542,42],["καὶ",707031,7],["προαιρέσεις",710751,39],["καρδίας",707141,17],["αὐτῶν",702165,40],["αὐτοὶ",702165,201],["προφητεύουσιν",711008,197],["ὑμῖν",713084,90]],"Then the Lord said to me, The prophets prophesy lies in my name: I sent them not, and I commanded them not, and I spoke not to them: for they prophesy to you false visions, and divinations, and auguries, and devices of their own heart."],["15",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["περὶ",710285,0],["τῶν",709436,80],["προφητῶν",711009,81],["τῶν",709436,80],["προφητευόντων",711008,170],["ἐπὶ",705080,0],["τῷ",709436,53],["ὀνόματί",709666,54],["μου",709032,133],["ψευδῆ",714036,68],["καὶ",707031,7],["ἐγὼ",704018,164],["οὐκ",709805,28],["ἀπέστειλα",701592,155],["αὐτούς",702165,62],["οἳ",709781,250],["λέγουσιν",708124,197],["μάχαιρα",708593,4],["καὶ",707031,7],["λιμὸς",708210,4],["οὐκ",709805,28],["ἔσται",704093,93],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ταύτης",709858,86],["ἐν",704639,0],["θανάτῳ",706096,114],["νοσερῷ",709356,30],["ἀποθανοῦνται",701461,135],["καὶ",707031,7],["ἐν",704639,0],["λιμῷ",708210,114],["συντελεσθήσονται",712510,144],["οἱ",709436,136],["προφῆται",711009,52]],"Therefore thus saith the Lord concerning the prophets that prophesy lies in my name, and I sent them not, who say, Sword and famine shall not be upon this land; they shall die by a grievous death, and the prophets shall be consumed by famine."],["16",[["καὶ",707031,7],["ὁ",709436,3],["λαός",708094,4],["οἷς",709781,311],["αὐτοὶ",702165,201],["προφητεύουσιν",711008,197],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἔσονται",704093,135],["ἐρριμμένοι",711267,362],["ἐν",704639,0],["ταῖς",709436,75],["διόδοις",703716,76],["Ιερουσαλημ",706644,17],["ἀπὸ",701425,0],["προσώπου",710986,21],["μαχαίρας",708593,39],["καὶ",707031,7],["τοῦ",709436,35],["λιμοῦ",708210,18],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ὁ",709436,3],["θάπτων",706103,72],["αὐτούς",702165,62],["καὶ",707031,7],["αἱ",709436,190],["γυναῖκες",703209,191],["αὐτῶν",702165,40],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτῶν",702165,40],["καὶ",707031,7],["αἱ",709436,190],["θυγατέρες",706320,191],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐκχεῶ",704368,165],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["τὰ",709436,41],["κακὰ",707066,68],["αὐτῶν",702165,40]],"And the people to whom they prophesy, they also shall be cast out in the streets of Jerusalem, because of the sword and famine; and there shall be none to bury them: their wives also, and their sons, and their daughters [shall die thus]; and I will pour out their wickedness upon them."],["17",[["καὶ",707031,7],["ἐρεῖς",705415,166],["πρὸς",710844,0],["αὐτοὺς",702165,62],["τὸν",709436,5],["λόγον",708236,6],["τοῦτον",709858,85],["καταγάγετε",707232,74],["ἐπ᾿",705080,0],["ὀφθαλμοὺς",709870,57],["ὑμῶν",713091,145],["δάκρυα",703255,42],["ἡμέρας",705984,17],["καὶ",707031,7],["νυκτός",709386,17],["καὶ",707031,7],["μὴ",708851,28],["διαλιπέτωσαν",703496,264],["ὅτι",709803,7],["συντρίμματι",712521,54],["συνετρίβη",712520,37],["θυγάτηρ",706320,12],["λαοῦ",708094,18],["μου",709032,133],["καὶ",707031,7],["πληγῇ",710527,1],["ὀδυνηρᾷ",709464,101],["σφόδρα",712586,28]],"And thou shalt speak this word to them; Let your eyes shed tears day and night, and let them not cease: for the daughter of my people has been sorely bruised, and her plague is very grievous."],["18",[["ἐὰν",703912,7],["ἐξέλθω",704909,207],["εἰς",704105,0],["τὸ",709436,24],["πεδίον",710215,25],["καὶ",707031,7],["ἰδοὺ",706497,88],["τραυματίαι",712921,52],["μαχαίρας",708593,17],["καὶ",707031,7],["ἐὰν",703912,7],["εἰσέλθω",704114,207],["εἰς",704105,0],["τὴν",709436,8],["πόλιν",710612,9],["καὶ",707031,7],["ἰδοὺ",706497,88],["πόνος",710661,4],["λιμοῦ",708210,18],["ὅτι",709803,7],["ἱερεὺς",706614,4],["καὶ",707031,7],["προφήτης",711009,4],["ἐπορεύθησαν",710667,99],["εἰς",704105,0],["γῆν",703083,9],["ἣν",709781,131],["οὐκ",709805,28],["ᾔδεισαν",709492,263]],"If I go forth into the plain, then behold the slain by the sword! and if I enter into the city, then behold the distress of famine! for priest and prophet have gone to a land which they knew not."],["19",[["μὴ",708851,28],["ἀποδοκιμάζων",701451,72],["ἀπεδοκίμασας",701451,162],["τὸν",709436,5],["Ιουδαν",706775,6],["καὶ",707031,7],["ἀπὸ",701425,0],["Σιων",711816,17],["ἀπέστη",702214,2],["ἡ",709436,10],["ψυχή",714070,12],["σου",711945,133],["ἵνα",706747,7],["τί",712867,126],["ἔπαισας",709931,162],["ἡμᾶς",705981,194],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἡμῖν",705994,90],["ἴασις",706444,12],["ὑπεμείναμεν",713219,289],["εἰς",704105,0],["εἰρήνην",704098,9],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ἀγαθά",700106,195],["εἰς",704105,0],["καιρὸν",707047,6],["ἰάσεως",706444,17],["καὶ",707031,7],["ἰδοὺ",706497,88],["ταραχή",712722,12]],"Hast thou utterly rejected Juda? and has thy soul departed from Sion? wherefore hast thou smitten us, and there is no healing for us? we waited for peace, but there was no prosperity; for a time of healing, and behold trouble!"],["20",[["ἔγνωμεν",703105,289],["κύριε",707996,153],["ἁμαρτήματα",700774,42],["ἡμῶν",705999,145],["ἀδικίας",700271,39],["πατέρων",710189,81],["ἡμῶν",705999,145],["ὅτι",709803,7],["ἡμάρτομεν",700773,289],["ἐναντίον",704654,0],["σου",711945,133]],"We know, O Lord, our sins, [and] the iniquities of our fathers: for we have sinned before thee."],["21",[["κόπασον",707819,176],["διὰ",703417,0],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["μὴ",708851,28],["ἀπολέσῃς",701513,175],["θρόνον",706315,6],["δόξης",703791,17],["σου",711945,133],["μνήσθητι",708960,244],["μὴ",708851,28],["διασκεδάσῃς",703575,175],["τὴν",709436,8],["διαθήκην",703456,9],["σου",711945,133],["τὴν",709436,8],["μεθ᾿",708780,0],["ἡμῶν",705999,145]],"Refrain for thy name's sake, destroy not the throne of thy glory: remember, break not thy covenant with us."],["22",[["μὴ",708851,28],["ἔστιν",704093,91],["ἐν",704639,0],["εἰδώλοις",704079,96],["τῶν",709436,43],["ἐθνῶν",704068,44],["ὑετίζων",713073,72],["καὶ",707031,7],["εἰ",704071,7],["ὁ",709436,3],["οὐρανὸς",709844,4],["δώσει",703654,127],["πλησμονὴν",710549,9],["αὐτοῦ",702165,102],["οὐχὶ",709862,28],["σὺ",712181,164],["εἶ",704093,154],["αὐτός",702165,121],["καὶ",707031,7],["ὑπομενοῦμέν",713219,275],["σε",711598,163],["ὅτι",709803,7],["σὺ",712181,164],["ἐποίησας",710582,162],["πάντα",710177,68],["ταῦτα",709858,71]],"Is there any one among the idols of the Gentiles that can give rain? and will the sky yield his fulness [at their bidding]? Art not thou he? we will even wait on thee, O Lord: for thou hast made all these things."]]