[["1",[["περιδράμετε",710406,74],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["Ιερουσαλημ",706644,17],["καὶ",707031,7],["ἴδετε",709725,74],["καὶ",707031,7],["γνῶτε",703105,74],["καὶ",707031,7],["ζητήσατε",705879,74],["ἐν",704639,0],["ταῖς",709436,75],["πλατείαις",710509,291],["αὐτῆς",702165,86],["ἐὰν",703912,7],["εὕρητε",705676,125],["ἄνδρα",701150,6],["εἰ",704071,7],["ἔστιν",704093,91],["ποιῶν",710582,72],["κρίμα",707903,25],["καὶ",707031,7],["ζητῶν",705879,72],["πίστιν",710484,9],["καὶ",707031,7],["ἵλεως",706732,14],["ἔσομαι",704093,181],["αὐτοῖς",702165,151],["λέγει",708124,91],["κύριος",707996,4]],"Run ye about in the streets of Jerusalem, and see, and know, and seek in her broad places, if ye can find [one], if there is any one that does judgment, and seeks faithfulness; and I will pardon them, saith the Lord."],["2",[["ζῇ",705851,91],["κύριος",707996,4],["λέγουσιν",708124,197],["διὰ",703417,0],["τοῦτο",709858,129],["οὐκ",709805,28],["ἐπὶ",705080,0],["ψεύδεσιν",714036,230],["ὀμνύουσιν",709620,197]],"The Lord lives, they say; do they not therefore swear falsely?"],["3",[["κύριε",707996,153],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["σου",711945,133],["εἰς",704105,0],["πίστιν",710484,9],["ἐμαστίγωσας",708566,162],["αὐτούς",702165,62],["καὶ",707031,7],["οὐκ",709805,28],["ἐπόνεσαν",710656,150],["συνετέλεσας",712510,162],["αὐτούς",702165,62],["καὶ",707031,7],["οὐκ",709805,28],["ἠθέλησαν",706176,150],["δέξασθαι",703393,109],["παιδείαν",709924,9],["ἐστερέωσαν",712076,150],["τὰ",709436,41],["πρόσωπα",710986,42],["αὐτῶν",702165,40],["ὑπὲρ",713111,0],["πέτραν",710443,9],["καὶ",707031,7],["οὐκ",709805,28],["ἠθέλησαν",706176,150],["ἐπιστραφῆναι",705278,179]],"O Lord, thine eyes are upon faithfulness: thou hast scourged them, but they have not grieved; thou hast consumed them; but they would not receive correction: they have made their faces harder than a rock; and they would not return."],["4",[["καὶ",707031,7],["ἐγὼ",704018,164],["εἶπα",705373,155],["ἴσως",706860,28],["πτωχοί",711076,52],["εἰσιν",704093,197],["διότι",703734,7],["οὐκ",709805,28],["ἐδυνάσθησαν",703838,99],["ὅτι",709803,7],["οὐκ",709805,28],["ἔγνωσαν",703105,150],["ὁδὸν",709458,9],["κυρίου",707996,18],["καὶ",707031,7],["κρίσιν",707908,9],["θεοῦ",706192,18]],"Then I said, It may be they are poor; for they are weak, for they know not the way of the Lord, or the judgment of God."],["5",[["πορεύσομαι",710667,181],["πρὸς",710844,0],["τοὺς",709436,58],["ἁδροὺς",700292,60],["καὶ",707031,7],["λαλήσω",708071,165],["αὐτοῖς",702165,151],["ὅτι",709803,7],["αὐτοὶ",702165,201],["ἐπέγνωσαν",705104,150],["ὁδὸν",709458,9],["κυρίου",707996,18],["καὶ",707031,7],["κρίσιν",707908,9],["θεοῦ",706192,18],["καὶ",707031,7],["ἰδοὺ",706497,88],["ὁμοθυμαδὸν",709624,28],["συνέτριψαν",712520,150],["ζυγόν",705894,6],["διέρρηξαν",703565,150],["δεσμούς",703372,57]],"I will go to the rich men, and will speak to them; for they have known the way of the Lord, and the judgment of God: but, behold, with one consent they have broken the yoke, they have burst the bonds."],["6",[["διὰ",703417,0],["τοῦτο",709858,129],["ἔπαισεν",709933,2],["αὐτοὺς",702165,62],["λέων",708171,4],["ἐκ",704132,0],["τοῦ",709436,35],["δρυμοῦ",703836,18],["καὶ",707031,7],["λύκος",708269,4],["ἕως",705792,0],["τῶν",709436,130],["οἰκιῶν",709505,65],["ὠλέθρευσεν",709560,2],["αὐτούς",702165,62],["καὶ",707031,7],["πάρδαλις",710122,12],["ἐγρηγόρησεν",703195,2],["ἐπὶ",705080,0],["τὰς",709436,38],["πόλεις",710612,39],["αὐτῶν",702165,40],["πάντες",710177,138],["οἱ",709436,136],["ἐκπορευόμενοι",704293,348],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["θηρευθήσονται",706248,144],["ὅτι",709803,7],["ἐπλήθυναν",710530,150],["ἀσεβείας",701904,39],["αὐτῶν",702165,40],["ἴσχυσαν",706859,150],["ἐν",704639,0],["ταῖς",709436,75],["ἀποστροφαῖς",701599,76],["αὐτῶν",702165,40]],"Therefore has a lion out of the forest smitten them, and a wolf has destroyed them even to [their] houses, and a leopard has watched against their cities: all that go forth from them shall be hunted: for they have multiplied their ungodliness, they have strengthened themselves in their revoltings."],["7",[["ποίᾳ",710599,101],["τούτων",709858,40],["ἵλεως",706732,14],["γένωμαί",703104,410],["σοι",711925,159],["οἱ",709436,136],["υἱοί",713075,52],["σου",711945,133],["ἐγκατέλιπόν",703967,150],["με",708618,163],["καὶ",707031,7],["ὤμνυον",709620,137],["ἐν",704639,0],["τοῖς",709436,147],["οὐκ",709805,28],["οὖσιν",704093,349],["θεοῖς",706192,148],["καὶ",707031,7],["ἐχόρτασα",713919,155],["αὐτούς",702165,62],["καὶ",707031,7],["ἐμοιχῶντο",708976,139],["καὶ",707031,7],["ἐν",704639,0],["οἴκοις",709516,148],["πορνῶν",710675,65],["κατέλυον",707323,137]],"In what [way] shall I forgive thee for these things? Thy sons have forsaken me, and sworn by them that are no gods: and I fed them to the full, and they committed adultery, and lodged in harlots' houses."],["8",[["ἵπποι",706790,52],["θηλυμανεῖς",706236,138],["ἐγενήθησαν",703104,99],["ἕκαστος",704133,14],["ἐπὶ",705080,0],["τὴν",709436,8],["γυναῖκα",703209,9],["τοῦ",709436,35],["πλησίον",710547,28],["αὐτοῦ",702165,102],["ἐχρεμέτιζον",713949,137]],"They became as wanton horses: they neighed each one after his neighbour's wife."],["9",[["μὴ",708851,28],["ἐπὶ",705080,0],["τούτοις",709858,206],["οὐκ",709805,28],["ἐπισκέψομαι",705250,181],["λέγει",708124,91],["κύριος",707996,4],["ἢ",705924,7],["ἐν",704639,0],["ἔθνει",704068,54],["τοιούτῳ",712878,97],["οὐκ",709805,28],["ἐκδικήσει",704174,127],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133]],"Shall I not visit for these things? saith the Lord: and shall not my soul be avenged on such a nation as this."],["10",[["ἀνάβητε",700905,74],["ἐπὶ",705080,0],["τοὺς",709436,58],["προμαχῶνας",710822,57],["αὐτῆς",702165,86],["καὶ",707031,7],["κατασκάψατε",707416,74],["συντέλειαν",712509,9],["δὲ",703303,11],["μὴ",708851,28],["ποιήσητε",710582,125],["ὑπολίπεσθε",713212,186],["τὰ",709436,41],["ὑποστηρίγματα",713244,42],["αὐτῆς",702165,86],["ὅτι",709803,7],["τοῦ",709436,35],["κυρίου",707996,18],["εἰσίν",704093,197]],"Go up upon her battlements, and break [them] down; but make not a full end: leave her buttresses; for they are the Lord's."],["11",[["ὅτι",709803,7],["ἀθετῶν",700369,72],["ἠθέτησεν",700369,2],["εἰς",704105,0],["ἐμέ",704555,163],["λέγει",708124,91],["κύριος",707996,4],["οἶκος",709516,4],["Ισραηλ",706839,18],["καὶ",707031,7],["οἶκος",709516,4],["Ιουδα",706768,18]],"For the house of Israel have indeed dealt treacherously against me, saith the Lord: the house of Juda also"],["12",[["ἐψεύσαντο",714045,189],["τῷ",709436,113],["κυρίῳ",707996,114],["ἑαυτῶν",703917,40],["καὶ",707031,7],["εἶπαν",705373,150],["οὐκ",709805,28],["ἔστιν",704093,91],["ταῦτα",709858,290],["οὐχ",709805,28],["ἥξει",705956,127],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["κακά",707066,195],["καὶ",707031,7],["μάχαιραν",708593,9],["καὶ",707031,7],["λιμὸν",708210,6],["οὐκ",709805,28],["ὀψόμεθα",709725,141]],"have lied to their Lord, and they have said, These things are not so; no evils shall come upon us; and we shall not see sword or famine."],["13",[["οἱ",709436,136],["προφῆται",711009,52],["ἡμῶν",705999,145],["ἦσαν",704093,137],["εἰς",704105,0],["ἄνεμον",701123,6],["καὶ",707031,7],["λόγος",708236,4],["κυρίου",707996,18],["οὐχ",709805,28],["ὑπῆρχεν",713104,13],["ἐν",704639,0],["αὐτοῖς",702165,151],["οὕτως",709859,28],["ἔσται",704093,93],["αὐτοῖς",702165,151]],"Our prophets became wind, and the word of the Lord was not in them."],["14",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["παντοκράτωρ",709986,4],["ἀνθ᾿",701227,0],["ὧν",709781,252],["ἐλαλήσατε",708071,265],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["δέδωκα",703654,89],["τοὺς",709436,58],["λόγους",708236,57],["μου",709032,133],["εἰς",704105,0],["τὸ",709436,24],["στόμα",712125,25],["σου",711945,133],["πῦρ",711088,25],["καὶ",707031,7],["τὸν",709436,5],["λαὸν",708094,6],["τοῦτον",709858,85],["ξύλα",709427,42],["καὶ",707031,7],["καταφάγεται",707519,93],["αὐτούς",702165,62]],"Therefore thus saith the Lord Almighty, Because ye have spoken this word, behold, I have made my words in thy mouth fire, and this people wood, and it shall devour them."],["15",[["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐπάγω",704994,157],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["ἔθνος",704068,25],["πόρρωθεν",710681,28],["οἶκος",709516,4],["Ισραηλ",706839,18],["λέγει",708124,91],["κύριος",707996,4],["ἔθνος",704068,25],["οὗ",709781,48],["οὐκ",709805,28],["ἀκούσῃ",700587,123],["τῆς",709436,16],["φωνῆς",713640,17],["τῆς",709436,16],["γλώσσης",703120,17],["αὐτοῦ",702165,49]],"Behold, I [will] bring upon you a nation from far, O house of Israel, saith the Lord; a nation the sound of whose language one shall not understand."],["16",[["πάντες",710177,138],["ἰσχυροὶ",706855,138]],"[They are] all mighty men:"],["17",[["καὶ",707031,7],["κατέδονται",707519,135],["τὸν",709436,5],["θερισμὸν",706208,6],["ὑμῶν",713091,145],["καὶ",707031,7],["τοὺς",709436,58],["ἄρτους",701829,57],["ὑμῶν",713091,145],["καὶ",707031,7],["κατέδονται",707519,135],["τοὺς",709436,58],["υἱοὺς",713075,57],["ὑμῶν",713091,145],["καὶ",707031,7],["τὰς",709436,38],["θυγατέρας",706320,39],["ὑμῶν",713091,145],["καὶ",707031,7],["κατέδονται",707519,135],["τὰ",709436,41],["πρόβατα",710768,42],["ὑμῶν",713091,145],["καὶ",707031,7],["τοὺς",709436,58],["μόσχους",709029,57],["ὑμῶν",713091,145],["καὶ",707031,7],["κατέδονται",707519,135],["τοὺς",709436,58],["ἀμπελῶνας",700872,57],["ὑμῶν",713091,145],["καὶ",707031,7],["τοὺς",709436,58],["συκῶνας",712259,57],["ὑμῶν",713091,145],["καὶ",707031,7],["τοὺς",709436,58],["ἐλαιῶνας",704381,57],["ὑμῶν",713091,145],["καὶ",707031,7],["ἀλοήσουσιν",700716,218],["τὰς",709436,38],["πόλεις",710612,39],["τὰς",709436,38],["ὀχυρὰς",709889,119],["ὑμῶν",713091,145],["ἐφ᾿",705080,0],["αἷς",709781,281],["ὑμεῖς",713081,219],["πεποίθατε",710221,330],["ἐπ᾿",705080,0],["αὐταῖς",702165,200],["ἐν",704639,0],["ῥομφαίᾳ",711291,1]],"and they shall devour your harvest, and your bread; and shall devour your sons, and your daughters; and they shall devour your sheep, and your calves, and devour your vineyards, and your fig-plantations, and your olive yards: and they shall utterly destroy your strong cities, wherein ye trusted, with the sword."],["18",[["καὶ",707031,7],["ἔσται",704093,93],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["οὐ",709805,28],["μὴ",708851,28],["ποιήσω",710582,165],["ὑμᾶς",713080,194],["εἰς",704105,0],["συντέλειαν",712509,9]],"And it shall come to pass in those days, saith the Lord thy God, that I will not utterly destroy you."],["19",[["καὶ",707031,7],["ἔσται",704093,93],["ὅταν",709801,28],["εἴπητε",705373,125],["τίνος",712867,340],["ἕνεκεν",704709,0],["ἐποίησεν",710582,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["ἡμῖν",705994,90],["ἅπαντα",701362,68],["ταῦτα",709858,71],["καὶ",707031,7],["ἐρεῖς",705415,166],["αὐτοῖς",702165,151],["ἀνθ᾿",701227,0],["ὧν",709781,252],["ἐδουλεύσατε",703814,265],["θεοῖς",706192,148],["ἀλλοτρίοις",700699,230],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ὑμῶν",713091,145],["οὕτως",709859,28],["δουλεύσετε",703814,337],["ἀλλοτρίοις",700699,230],["ἐν",704639,0],["γῇ",703083,1],["οὐχ",709805,28],["ὑμῶν",713091,145]],"And it shall come to pass, when ye shall say, Wherefore has the Lord our God done all these things to us? that thou shalt say to them, Because ye served strange gods in your land, so shall ye serve strangers in a land that is not yours."],["20",[["ἀναγγείλατε",700921,74],["ταῦτα",709858,71],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["Ιακωβ",706401,18],["καὶ",707031,7],["ἀκουσθήτω",700587,22],["ἐν",704639,0],["τῷ",709436,113],["Ιουδα",706768,114]],"Proclaim these things to the house of Jacob, and let them be heard in the house of Juda."],["21",[["ἀκούσατε",700587,74],["δὴ",703395,11],["ταῦτα",709858,71],["λαὸς",708094,4],["μωρὸς",709110,14],["καὶ",707031,7],["ἀκάρδιος",700519,14],["ὀφθαλμοὶ",709870,52],["αὐτοῖς",702165,151],["καὶ",707031,7],["οὐ",709805,28],["βλέπουσιν",702740,197],["ὦτα",709852,64],["αὐτοῖς",702165,151],["καὶ",707031,7],["οὐκ",709805,28],["ἀκούουσιν",700587,197]],"Hear ye now these things, O foolish and senseless people; who have eyes, and see not; and have ears, and hear not:"],["22",[["μὴ",708851,28],["ἐμὲ",704555,163],["οὐ",709805,28],["φοβηθήσεσθε",713532,261],["λέγει",708124,91],["κύριος",707996,4],["ἢ",705924,7],["ἀπὸ",701425,0],["προσώπου",710986,21],["μου",709032,133],["οὐκ",709805,28],["εὐλαβηθήσεσθε",705627,261],["τὸν",709436,5],["τάξαντα",712730,365],["ἄμμον",700845,9],["ὅριον",709749,25],["τῇ",709436,100],["θαλάσσῃ",706069,1],["πρόσταγμα",710959,25],["αἰώνιον",700505,46],["καὶ",707031,7],["οὐχ",709805,28],["ὑπερβήσεται",713125,93],["αὐτό",702165,129],["καὶ",707031,7],["ταραχθήσεται",712721,134],["καὶ",707031,7],["οὐ",709805,28],["δυνήσεται",703838,93],["καὶ",707031,7],["ἠχήσουσιν",706045,218],["τὰ",709436,63],["κύματα",707968,64],["αὐτῆς",702165,86],["καὶ",707031,7],["οὐχ",709805,28],["ὑπερβήσεται",713125,93],["αὐτό",702165,129]],"will ye not be afraid of me? saith the Lord; and will ye not fear before me, who have set the sand for a bound to the sea, [as] a perpetual ordinance, and it shall not pass it: yea, it shall rage, but not prevail; and its waves shall roar, but not pass over it."],["23",[["τῷ",709436,113],["δὲ",703303,11],["λαῷ",708094,114],["τούτῳ",709858,50],["ἐγενήθη",703104,37],["καρδία",707141,12],["ἀνήκοος",701144,29],["καὶ",707031,7],["ἀπειθής",701371,29],["καὶ",707031,7],["ἐξέκλιναν",704220,150],["καὶ",707031,7],["ἀπήλθοσαν",701398,150]],"But this people has a disobedient and rebellious heart; and they have turned aside and gone back:"],["24",[["καὶ",707031,7],["οὐκ",709805,28],["εἶπον",705373,150],["ἐν",704639,0],["τῇ",709436,100],["καρδίᾳ",707141,1],["αὐτῶν",702165,40],["φοβηθῶμεν",713532,283],["δὴ",703395,11],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["ἡμῶν",705999,145],["τὸν",709436,5],["διδόντα",703654,183],["ἡμῖν",705994,90],["ὑετὸν",713074,6],["πρόιμον",711023,27],["καὶ",707031,7],["ὄψιμον",709899,27],["κατὰ",707200,0],["καιρὸν",707047,6],["πληρώσεως",710545,17],["προστάγματος",710959,21],["θερισμοῦ",706208,18],["καὶ",707031,7],["ἐφύλαξεν",713619,2],["ἡμῖν",705994,90]],"and they have not said in their heart, Let us fear now the Lord our God, who gives us the early and latter rain, according to the season of the fulfilment of the ordinance of harvest, and has preserved [it] for us."],["25",[["αἱ",709436,190],["ἀνομίαι",701192,191],["ὑμῶν",713091,145],["ἐξέκλιναν",704220,150],["ταῦτα",709858,71],["καὶ",707031,7],["αἱ",709436,190],["ἁμαρτίαι",700775,191],["ὑμῶν",713091,145],["ἀπέστησαν",702214,150],["τὰ",709436,41],["ἀγαθὰ",700106,68],["ἀφ᾿",701425,0],["ὑμῶν",713091,145]],"Your transgressions have turned away these things, and your sins have removed good things from you."],["26",[["ὅτι",709803,7],["εὑρέθησαν",705676,99],["ἐν",704639,0],["τῷ",709436,113],["λαῷ",708094,114],["μου",709032,133],["ἀσεβεῖς",701909,138],["καὶ",707031,7],["παγίδας",709910,39],["ἔστησαν",706846,150],["διαφθεῖραι",703624,106],["ἄνδρας",701150,57],["καὶ",707031,7],["συνελαμβάνοσαν",712262,137]],"For among my people were found ungodly men; and they have set snares to destroy men, and have caught [them]."],["27",[["ὡς",714148,7],["παγὶς",709910,12],["ἐφεσταμένη",705756,357],["πλήρης",710541,29],["πετεινῶν",710439,44],["οὕτως",709859,28],["οἱ",709436,136],["οἶκοι",709516,52],["αὐτῶν",702165,40],["πλήρεις",710541,138],["δόλου",703787,18],["διὰ",703417,0],["τοῦτο",709858,129],["ἐμεγαλύνθησαν",708647,99],["καὶ",707031,7],["ἐπλούτησαν",710561,150]],"As a snare which has been set is full of birds, so are their houses full of deceit: therefore have they grown great, and become rich:"],["28",[["καὶ",707031,7],["παρέβησαν",709996,150],["κρίσιν",707908,9],["οὐκ",709805,28],["ἔκριναν",707905,150],["κρίσιν",707908,9],["ὀρφανοῦ",709779,116],["καὶ",707031,7],["κρίσιν",707908,9],["χήρας",713848,17],["οὐκ",709805,28],["ἐκρίνοσαν",707905,137]],"and they have transgressed [the rule of] judgment; they have not judged the cause of the orphan, nor have they judged the cause of the widow."],["29",[["μὴ",708851,28],["ἐπὶ",705080,0],["τούτοις",709858,206],["οὐκ",709805,28],["ἐπισκέψομαι",705250,181],["λέγει",708124,91],["κύριος",707996,4],["ἢ",705924,7],["ἐν",704639,0],["ἔθνει",704068,54],["τῷ",709436,53],["τοιούτῳ",712878,97],["οὐκ",709805,28],["ἐκδικήσει",704174,127],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133]],"Shall I not visit for these things? saith the Lord: and shall not my soul be avenged on such a nation as this?"],["30",[["ἔκστασις",704314,12],["καὶ",707031,7],["φρικτὰ",713581,195],["ἐγενήθη",703104,37],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"Shocking and horrible deeds have been done on the land;"],["31",[["οἱ",709436,136],["προφῆται",711009,52],["προφητεύουσιν",711008,197],["ἄδικα",700272,68],["καὶ",707031,7],["οἱ",709436,136],["ἱερεῖς",706614,52],["ἐπεκρότησαν",705180,150],["ταῖς",709436,75],["χερσὶν",713787,76],["αὐτῶν",702165,40],["καὶ",707031,7],["ὁ",709436,3],["λαός",708094,4],["μου",709032,133],["ἠγάπησεν",700120,2],["οὕτως",709859,28],["καὶ",707031,7],["τί",712867,126],["ποιήσετε",710582,337],["εἰς",704105,0],["τὰ",709436,41],["μετὰ",708780,0],["ταῦτα",709858,71]],"the prophets utter unrighteous prophecies, and the priests have clapped their hands: and my people has loved [to have it] thus: and what will ye do for the future?"]]