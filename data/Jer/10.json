[["1",[["ἀκούσατε",700587,74],["τὸν",709436,5],["λόγον",708236,6],["κυρίου",707996,18],["ὃν",709781,112],["ἐλάλησεν",708071,2],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["οἶκος",709516,4],["Ισραηλ",706839,18]],"Hear ye the word of the Lord, which he has spoken to you, O house of Israel."],["2",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["κατὰ",707200,0],["τὰς",709436,38],["ὁδοὺς",709458,39],["τῶν",709436,43],["ἐθνῶν",704068,44],["μὴ",708851,28],["μανθάνετε",708480,335],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,43],["σημείων",711748,44],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["μὴ",708851,28],["φοβεῖσθε",713532,73],["ὅτι",709803,7],["φοβοῦνται",713532,269],["αὐτὰ",702165,290],["τοῖς",709436,95],["προσώποις",710986,96],["αὐτῶν",702165,40]],"Thus saith the Lord, Learn ye not the ways of the heathen, and be not alarmed at the signs of the sky; for they are alarmed at them, [falling] on their faces."],["3",[["ὅτι",709803,7],["τὰ",709436,63],["νόμιμα",709340,195],["τῶν",709436,43],["ἐθνῶν",704068,44],["μάταια",708575,195],["ξύλον",709427,15],["ἐστὶν",704093,91],["ἐκ",704132,0],["τοῦ",709436,35],["δρυμοῦ",703836,18],["ἐκκεκομμένον",704225,327],["ἔργον",705396,15],["τέκτονος",712766,18],["καὶ",707031,7],["χώνευμα",714005,15]],"For the customs of the nations are vain; it is a tree cut out of the forest, the work of the carpenter, or a molten image."],["4",[["ἀργυρίῳ",701707,54],["καὶ",707031,7],["χρυσίῳ",713972,54],["κεκαλλωπισμένα",707095,370],["ἐστίν",704093,91],["ἐν",704639,0],["σφύραις",712592,76],["καὶ",707031,7],["ἥλοις",705977,148],["ἐστερέωσαν",712076,150],["αὐτά",702165,71],["καὶ",707031,7],["οὐ",709805,28],["κινηθήσονται",707679,144]],"[They are] beautified with silver and gold, they fix them with hammers and nails;"],["9",[["ἀργύριον",701707,15],["τορευτόν",712904,26],["ἐστιν",704093,91],["οὐ",709805,28],["πορεύσονται",710667,135],["ἀργύριον",701707,15],["προσβλητὸν",710867,26],["ἀπὸ",701425,0],["Θαρσις",706124,17],["ἥξει",705956,127],["χρυσίον",713972,15],["Μωφαζ",709114,118],["καὶ",707031,7],["χεὶρ",713787,12],["χρυσοχόων",713979,29],["ἔργα",705396,64],["τεχνιτῶν",712832,81],["πάντα",710177,195],["ὑάκινθον",713048,9],["καὶ",707031,7],["πορφύραν",710682,9],["ἐνδύσουσιν",704701,218],["αὐτά",702165,71]],"it is forged silver [brought] from Tharsis, gold will come from Mophaz, and the work of goldsmiths: [they are] all the works of craftsmen, they will clothe themselves with blue and scarlet."],["5",[["αἰρόμενα",700473,67],["ἀρθήσονται",700473,144],["ὅτι",709803,7],["οὐκ",709805,28],["ἐπιβήσονται",705082,135],["μὴ",708851,28],["φοβηθῆτε",713532,394],["αὐτά",702165,71],["ὅτι",709803,7],["οὐ",709805,28],["μὴ",708851,28],["κακοποιήσωσιν",707062,234],["καὶ",707031,7],["ἀγαθὸν",700106,26],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐν",704639,0],["αὐτοῖς",702165,151]],"they will set them up that they may not move; it is wrought silver, they will not walk,"],["11",[["οὕτως",709859,28],["ἐρεῖτε",705415,337],["αὐτοῖς",702165,151],["θεοί",706192,52],["οἳ",709781,250],["τὸν",709436,5],["οὐρανὸν",709844,6],["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9],["οὐκ",709805,28],["ἐποίησαν",710582,150],["ἀπολέσθωσαν",701513,486],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ὑποκάτωθεν",713205,28],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["τούτου",709858,102]],"Thus shall ye say to them, Let the gods which have not made heaven and earth perish from off the earth, and from under this sky."],["12",[["κύριος",707996,4],["ὁ",709436,3],["ποιήσας",710582,182],["τὴν",709436,8],["γῆν",703083,9],["ἐν",704639,0],["τῇ",709436,100],["ἰσχύι",706858,1],["αὐτοῦ",702165,102],["ὁ",709436,3],["ἀνορθώσας",701197,182],["τὴν",709436,8],["οἰκουμένην",709517,173],["ἐν",704639,0],["τῇ",709436,100],["σοφίᾳ",711981,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["τῇ",709436,100],["φρονήσει",713588,1],["αὐτοῦ",702165,102],["ἐξέτεινεν",704322,2],["τὸν",709436,5],["οὐρανὸν",709844,6]],"It is the Lord that made the earth by his strength, who set up the world by his wisdom, and by his understanding stretched out the sky,"],["13",[["καὶ",707031,7],["πλῆθος",710529,25],["ὕδατος",713071,21],["ἐν",704639,0],["οὐρανῷ",709844,114],["καὶ",707031,7],["ἀνήγαγεν",700933,2],["νεφέλας",709277,39],["ἐξ",704132,0],["ἐσχάτου",705519,92],["τῆς",709436,16],["γῆς",703083,17],["ἀστραπὰς",702021,39],["εἰς",704105,0],["ὑετὸν",713074,6],["ἐποίησεν",710582,2],["καὶ",707031,7],["ἐξήγαγεν",704834,2],["φῶς",713642,25],["ἐκ",704132,0],["θησαυρῶν",706258,81],["αὐτοῦ",702165,102]],"and set abundance of waters in the sky, and brought up clouds from the ends of the earth; he made lightnings for the rain, and brought forth light out of his treasures."],["14",[["ἐμωράνθη",709105,37],["πᾶς",710177,14],["ἄνθρωπος",701163,4],["ἀπὸ",701425,0],["γνώσεως",703138,17],["κατῃσχύνθη",707257,37],["πᾶς",710177,14],["χρυσοχόος",713979,14],["ἐπὶ",705080,0],["τοῖς",709436,147],["γλυπτοῖς",703117,230],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ψευδῆ",714036,68],["ἐχώνευσαν",714010,150],["οὐκ",709805,28],["ἔστιν",704093,91],["πνεῦμα",710566,15],["ἐν",704639,0],["αὐτοῖς",702165,151]],"Every man is deprived of knowledge, every goldsmith is confounded because of his graven images; for he has cast false gods, there is no breath in them."],["15",[["μάταιά",708575,195],["ἐστιν",704093,91],["ἔργα",705396,64],["ἐμπεπαιγμένα",704583,443],["ἐν",704639,0],["καιρῷ",707047,114],["ἐπισκοπῆς",705255,17],["αὐτῶν",702165,40],["ἀπολοῦνται",701513,135]],"They are vain works, wrought in mockery; in the time of their visitation they shall perish."],["16",[["οὐκ",709805,28],["ἔστιν",704093,91],["τοιαύτη",712878,29],["μερὶς",708748,12],["τῷ",709436,113],["Ιακωβ",706401,114],["ὅτι",709803,7],["ὁ",709436,3],["πλάσας",710503,182],["τὰ",709436,41],["πάντα",710177,68],["αὐτὸς",702165,121],["κληρονομία",707725,12],["αὐτοῦ",702165,102],["κύριος",707996,4],["ὄνομα",709666,15],["αὐτῷ",702165,50]],"Such is not the portion of Jacob; for he that formed all things, he is his inheritance; the Lord is his name."],["17",[["συνήγαγεν",712375,2],["ἔξωθεν",704984,28],["τὴν",709436,8],["ὑπόστασίν",713241,9],["σου",711945,133],["κατοικοῦσα",707534,188],["ἐν",704639,0],["ἐκλεκτοῖς",704240,230]],"He has gathered thy substance from without that lodged in choice [vessels]."],["18",[["ὅτι",709803,7],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["σκελίζω",711830,157],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104],["ἐν",704639,0],["θλίψει",706276,1],["ὅπως",709719,7],["εὑρεθῇ",705676,384],["ἡ",709436,10],["πληγή",710527,12],["σου",711945,133]],"For thus saith the Lord, Behold, I [will] overthrow the inhabitants of this land with affliction, that thy plague may be discovered."],["19",[["οὐαὶ",709807,88],["ἐπὶ",705080,0],["συντρίμματί",712521,54],["σου",711945,133],["ἀλγηρὰ",700641,29],["ἡ",709436,10],["πληγή",710527,12],["σου",711945,133],["κἀγὼ",706969,288],["εἶπα",705373,155],["ὄντως",709672,28],["τοῦτο",709858,132],["τὸ",709436,34],["τραῦμά",712920,15],["μου",709032,133],["καὶ",707031,7],["κατέλαβέν",707300,2],["με",708618,163]],"Alas for thy ruin! thy plague is grievous: and I said, Surely this is thy wound, and it has overtaken thee."],["20",[["ἡ",709436,10],["σκηνή",711845,12],["μου",709032,133],["ἐταλαιπώρησεν",712694,2],["ὤλετο",709584,23],["καὶ",707031,7],["πᾶσαι",710177,192],["αἱ",709436,190],["δέρρεις",703365,191],["μου",709032,133],["διεσπάσθησαν",703583,99],["οἱ",709436,136],["υἱοί",713075,52],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,63],["πρόβατά",710768,64],["μου",709032,133],["οὔκ",709805,28],["εἰσιν",704093,197],["οὐκ",709805,28],["ἔστιν",704093,91],["ἔτι",705538,28],["τόπος",712903,4],["τῆς",709436,16],["σκηνῆς",711845,17],["μου",709032,133],["τόπος",712903,4],["τῶν",709436,130],["δέρρεών",703365,65],["μου",709032,133]],"Thy tabernacle is in a ruinous state, it has perished; and all thy curtains have been torn asunder: my children and my cattle are no more: there is no more any place for my tabernacle, [nor] place for my curtains."],["21",[["ὅτι",709803,7],["οἱ",709436,136],["ποιμένες",710596,52],["ἠφρονεύσαντο",702233,189],["καὶ",707031,7],["τὸν",709436,5],["κύριον",707996,6],["οὐκ",709805,28],["ἐξεζήτησαν",704187,150],["διὰ",703417,0],["τοῦτο",709858,129],["οὐκ",709805,28],["ἐνόησεν",709327,2],["πᾶσα",710177,29],["ἡ",709436,10],["νομὴ",709337,12],["καὶ",707031,7],["διεσκορπίσθησαν",703579,99]],"For the shepherds have become foolish, and have not sought the Lord; therefore the whole pasture has failed, and [the sheep] have been scattered."],["22",[["φωνὴ",713640,12],["ἀκοῆς",700561,17],["ἰδοὺ",706497,88],["ἔρχεται",705453,117],["καὶ",707031,7],["σεισμὸς",711632,4],["μέγας",708653,14],["ἐκ",704132,0],["γῆς",703083,17],["βορρᾶ",702765,18],["τοῦ",709436,20],["τάξαι",712730,106],["τὰς",709436,38],["πόλεις",710612,39],["Ιουδα",706768,18],["εἰς",704105,0],["ἀφανισμὸν",702183,6],["καὶ",707031,7],["κοίτην",707781,9],["στρουθῶν",712167,81]],"Behold, there comes a sound of a noise, and a great earthquake from the land of the north, to make the cities of Juda a desolation, and a resting-place for ostriches."],["23",[["οἶδα",709492,89],["κύριε",707996,153],["ὅτι",709803,7],["οὐχὶ",709862,28],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["ἡ",709436,10],["ὁδὸς",709458,12],["αὐτοῦ",702165,102],["οὐδὲ",709816,7],["ἀνὴρ",701150,4],["πορεύσεται",710667,93],["καὶ",707031,7],["κατορθώσει",707548,127],["πορείαν",710665,9],["αὐτοῦ",702165,102]],"I know, O Lord, that man's way is not his own; neither shall a man go, and direct his going."],["24",[["παίδευσον",709926,176],["ἡμᾶς",705981,194],["κύριε",707996,153],["πλὴν",710540,28],["ἐν",704639,0],["κρίσει",707908,1],["καὶ",707031,7],["μὴ",708851,28],["ἐν",704639,0],["θυμῷ",706334,114],["ἵνα",706747,7],["μὴ",708851,28],["ὀλίγους",709568,60],["ἡμᾶς",705981,194],["ποιήσῃς",710582,175]],"Chasten us, O Lord, but with judgment; and not in wrath, lest thou make us few."],["25",[["ἔκχεον",704368,176],["τὸν",709436,5],["θυμόν",706334,6],["σου",711945,133],["ἐπὶ",705080,0],["ἔθνη",704068,42],["τὰ",709436,41],["μὴ",708851,28],["εἰδότα",709492,237],["σε",711598,163],["καὶ",707031,7],["ἐπὶ",705080,0],["γενεὰς",703037,39],["αἳ",709781,256],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["οὐκ",709805,28],["ἐπεκαλέσαντο",705153,189],["ὅτι",709803,7],["κατέφαγον",707519,150],["τὸν",709436,5],["Ιακωβ",706401,6],["καὶ",707031,7],["ἐξανήλωσαν",704861,150],["αὐτὸν",702165,85],["καὶ",707031,7],["τὴν",709436,8],["νομὴν",709337,9],["αὐτοῦ",702165,102],["ἠρήμωσαν",705421,150]],"Pour out thy wrath upon the nations that have not known thee, and upon the families that have not called upon thy name: for they have devoured Jacob, and consumed him, and have made his pasture desolate."]]