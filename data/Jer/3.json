[["1",[["ἐὰν",703912,7],["ἐξαποστείλῃ",704872,172],["ἀνὴρ",701150,4],["τὴν",709436,8],["γυναῖκα",703209,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀπέλθῃ",701398,172],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["γένηται",703104,239],["ἀνδρὶ",701150,114],["ἑτέρῳ",705535,30],["μὴ",708851,28],["ἀνακάμπτουσα",700969,188],["ἀνακάμψει",700969,127],["πρὸς",710844,0],["αὐτὸν",702165,85],["ἔτι",705538,28],["οὐ",709805,28],["μιαινομένη",708900,211],["μιανθήσεται",708900,134],["ἡ",709436,10],["γυνὴ",703209,12],["ἐκείνη",704183,107],["καὶ",707031,7],["σὺ",712181,164],["ἐξεπόρνευσας",704295,162],["ἐν",704639,0],["ποιμέσιν",710596,148],["πολλοῖς",710646,230],["καὶ",707031,7],["ἀνέκαμπτες",700969,363],["πρός",710844,0],["με",708618,163],["λέγει",708124,91],["κύριος",707996,4]],"If a man put away his wife, and she depart from him, and become another man's, shall she return to him any more at all? shall not that woman be utterly defiled? yet thou hast gone a-whoring with many shepherds, and hast returned to me, saith the Lord."],["2",[["ἆρον",700473,176],["εἰς",704105,0],["εὐθεῖαν",705602,36],["τοὺς",709436,58],["ὀφθαλμούς",709870,57],["σου",711945,133],["καὶ",707031,7],["ἰδέ",709725,176],["ποῦ",710706,28],["οὐχὶ",709862,28],["ἐξεφύρθης",704365,168],["ἐπὶ",705080,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["ἐκάθισας",707006,162],["αὐτοῖς",702165,151],["ὡσεὶ",714159,28],["κορώνη",707845,12],["ἐρημουμένη",705421,473],["καὶ",707031,7],["ἐμίανας",708900,162],["τὴν",709436,8],["γῆν",703083,9],["ἐν",704639,0],["ταῖς",709436,75],["πορνείαις",710672,76],["σου",711945,133],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["κακίαις",707054,76],["σου",711945,133]],"Lift up thine eyes [to look] straight forward, and see where thou hast not been utterly defiled. Thou hast sat for them by the wayside as a deserted crow, and hast defiled the land with thy fornications and thy wickedness."],["3",[["καὶ",707031,7],["ἔσχες",705785,162],["ποιμένας",710596,57],["πολλοὺς",710646,60],["εἰς",704105,0],["πρόσκομμα",710922,25],["σεαυτῇ",711599,105],["ὄψις",709901,12],["πόρνης",710675,17],["ἐγένετό",703104,23],["σοι",711925,159],["ἀπηναισχύντησας",701343,2],["πρὸς",710844,0],["πάντας",710177,60]],"And thou didst retain many shepherds for a stumbling-block to thyself: thou hadst a whore's face, thou didst become shameless toward all."],["4",[["οὐχ",709805,28],["ὡς",714148,7],["οἶκόν",709516,6],["με",708618,163],["ἐκάλεσας",707084,162],["καὶ",707031,7],["πατέρα",710189,6],["καὶ",707031,7],["ἀρχηγὸν",701838,6],["τῆς",709436,16],["παρθενίας",710146,17],["σου",711945,133]],"Hast thou not called me as it were a home, and the father and guide of thy virgin-time?"],["5",[["μὴ",708851,28],["διαμενεῖ",703517,127],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἢ",705924,7],["διαφυλαχθήσεται",703632,134],["εἰς",704105,0],["νεῖκος",709246,25],["ἰδοὺ",706497,88],["ἐλάλησας",708071,162],["καὶ",707031,7],["ἐποίησας",710582,162],["τὰ",709436,41],["πονηρὰ",710660,68],["ταῦτα",709858,71],["καὶ",707031,7],["ἠδυνάσθης",703838,168]],"Will [God's anger] continue for ever, or be preserved to the end? Behold, thou hast spoken and done these bad things, and hadst power [to do them]."],["6",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["Ιωσια",706949,18],["τοῦ",709436,35],["βασιλέως",702580,18],["εἶδες",709725,162],["ἃ",709781,69],["ἐποίησέν",710582,2],["μοι",708974,159],["ἡ",709436,10],["κατοικία",707537,12],["τοῦ",709436,35],["Ισραηλ",706839,18],["ἐπορεύθησαν",710667,99],["ἐπὶ",705080,0],["πᾶν",710177,46],["ὄρος",709768,25],["ὑψηλὸν",713285,46],["καὶ",707031,7],["ὑποκάτω",713204,28],["παντὸς",710177,92],["ξύλου",709427,21],["ἀλσώδους",700730,92],["καὶ",707031,7],["ἐπόρνευσαν",710674,150],["ἐκεῖ",704181,28]],"And the Lord said to me in the days of Josias the king, Hast thou seen what things the house of Israel has done to me? they have gone on every high mountain, and under every shady tree, and have committed fornication there."],["7",[["καὶ",707031,7],["εἶπα",705373,155],["μετὰ",708780,0],["τὸ",709436,24],["πορνεῦσαι",710674,106],["αὐτὴν",702165,104],["ταῦτα",709858,71],["πάντα",710177,68],["πρός",710844,0],["με",708618,163],["ἀνάστρεψον",701060,176],["καὶ",707031,7],["οὐκ",709805,28],["ἀνέστρεψεν",701060,2],["καὶ",707031,7],["εἶδεν",709725,2],["τὴν",709436,8],["ἀσυνθεσίαν",702035,9],["αὐτῆς",702165,86],["ἡ",709436,10],["ἀσύνθετος",702037,29],["Ιουδα",706768,12]],"And I said after she had committed all these acts of fornication, Turn again to me. Yet she returned not. And faithless Juda saw her faithlessness."],["8",[["καὶ",707031,7],["εἶδον",709725,155],["διότι",703734,7],["περὶ",710285,0],["πάντων",710177,169],["ὧν",709781,252],["κατελήμφθη",707300,37],["ἐν",704639,0],["οἷς",709781,311],["ἐμοιχᾶτο",708976,23],["ἡ",709436,10],["κατοικία",707537,12],["τοῦ",709436,35],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐξαπέστειλα",704872,155],["αὐτὴν",702165,104],["καὶ",707031,7],["ἔδωκα",703654,155],["αὐτῇ",702165,105],["βιβλίον",702719,25],["ἀποστασίου",701587,21],["εἰς",704105,0],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτῆς",702165,86],["καὶ",707031,7],["οὐκ",709805,28],["ἐφοβήθη",713532,37],["ἡ",709436,10],["ἀσύνθετος",702037,29],["Ιουδα",706768,12],["καὶ",707031,7],["ἐπορεύθη",710667,37],["καὶ",707031,7],["ἐπόρνευσεν",710674,2],["καὶ",707031,28],["αὐτή",702165,107]],"And I saw that (for all the sins of which she was convicted, wherein the house of Israel committed adultery, and I put her away, and gave into her hands a bill of divorcement,) yet faithless Juda feared not, but went and herself also committed fornication."],["9",[["καὶ",707031,7],["ἐγένετο",703104,23],["εἰς",704105,0],["οὐθὲν",709817,46],["ἡ",709436,10],["πορνεία",710672,12],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐμοίχευσεν",708979,2],["τὸ",709436,24],["ξύλον",709427,25],["καὶ",707031,7],["τὸν",709436,5],["λίθον",708196,6]],"And her fornication was nothing accounted of; and she committed adultery with wood and stone."],["10",[["καὶ",707031,7],["ἐν",704639,0],["πᾶσιν",710177,230],["τούτοις",709858,151],["οὐκ",709805,28],["ἐπεστράφη",705278,37],["πρός",710844,0],["με",708618,163],["ἡ",709436,10],["ἀσύνθετος",702037,29],["Ιουδα",706768,12],["ἐξ",704132,0],["ὅλης",709597,82],["τῆς",709436,16],["καρδίας",707141,17],["αὐτῆς",702165,86],["ἀλλ᾿",700680,7],["ἐπὶ",705080,0],["ψεύδει",714044,54]],"And for all these things faithless Juda turned not to me with all her heart, but falsely."],["11",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["ἐδικαίωσεν",703696,2],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["Ισραηλ",706839,4],["ἀπὸ",701425,0],["τῆς",709436,16],["ἀσυνθέτου",702037,82],["Ιουδα",706768,17]],"And the Lord said to me, Israel has justified himself more than faithless Juda."],["12",[["πορεύου",710667,253],["καὶ",707031,7],["ἀνάγνωθι",700922,176],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["πρὸς",710844,0],["βορρᾶν",702765,6],["καὶ",707031,7],["ἐρεῖς",705415,166],["ἐπιστράφητι",705278,244],["πρός",710844,0],["με",708618,163],["ἡ",709436,10],["κατοικία",707537,12],["τοῦ",709436,35],["Ισραηλ",706839,18],["λέγει",708124,91],["κύριος",707996,4],["καὶ",707031,7],["οὐ",709805,28],["στηριῶ",712098,165],["τὸ",709436,24],["πρόσωπόν",710986,25],["μου",709032,133],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["ὅτι",709803,7],["ἐλεήμων",704422,14],["ἐγώ",704018,164],["εἰμι",704093,157],["λέγει",708124,91],["κύριος",707996,4],["καὶ",707031,7],["οὐ",709805,28],["μηνιῶ",708880,165],["ὑμῖν",713084,90],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"Go and read these words toward the north, and thou shalt say, Return to me, O house of Israel, saith the Lord; and I will not set my face against you: for I am merciful, saith the Lord, and I will not be angry with you for ever."],["13",[["πλὴν",710540,28],["γνῶθι",703105,176],["τὴν",709436,8],["ἀδικίαν",700271,9],["σου",711945,133],["ὅτι",709803,7],["εἰς",704105,0],["κύριον",707996,6],["τὸν",709436,5],["θεόν",706192,6],["σου",711945,133],["ἠσέβησας",701906,162],["καὶ",707031,7],["διέχεας",703636,162],["τὰς",709436,38],["ὁδούς",709458,39],["σου",711945,133],["εἰς",704105,0],["ἀλλοτρίους",700699,60],["ὑποκάτω",713204,28],["παντὸς",710177,92],["ξύλου",709427,21],["ἀλσώδους",700730,92],["τῆς",709436,16],["δὲ",703303,11],["φωνῆς",713640,17],["μου",709032,133],["οὐχ",709805,28],["ὑπήκουσας",713096,162],["λέγει",708124,91],["κύριος",707996,4]],"Nevertheless, know thine iniquity, that thou hast sinned against the Lord thy God, and hast scattered thy ways to strangers under every shady tree, but thou didst not hearken to my voice, saith the Lord."],["14",[["ἐπιστράφητε",705278,372],["υἱοὶ",713075,274],["ἀφεστηκότες",702214,268],["λέγει",708124,91],["κύριος",707996,4],["διότι",703734,7],["ἐγὼ",704018,164],["κατακυριεύσω",707297,165],["ὑμῶν",713091,145],["καὶ",707031,7],["λήμψομαι",708076,181],["ὑμᾶς",713080,194],["ἕνα",704106,27],["ἐκ",704132,0],["πόλεως",710612,17],["καὶ",707031,7],["δύο",703849,59],["ἐκ",704132,0],["πατριᾶς",710192,17],["καὶ",707031,7],["εἰσάξω",704107,165],["ὑμᾶς",713080,194],["εἰς",704105,0],["Σιων",711816,9]],"Turn, ye children that have revolted, saith the Lord; for I will rule over you: and I will take you one of a city, and two of a family, and I will bring you in to Sion:"],["15",[["καὶ",707031,7],["δώσω",703654,165],["ὑμῖν",713084,90],["ποιμένας",710596,57],["κατὰ",707200,0],["τὴν",709436,8],["καρδίαν",707141,9],["μου",709032,133],["καὶ",707031,7],["ποιμανοῦσιν",710594,218],["ὑμᾶς",713080,194],["ποιμαίνοντες",710594,146],["μετ᾿",708780,0],["ἐπιστήμης",705267,17]],"and I will give you shepherds after my heart, and they shall certainly tend you with knowledge."],["16",[["καὶ",707031,7],["ἔσται",704093,93],["ἐὰν",703912,7],["πληθυνθῆτε",710530,394],["καὶ",707031,7],["αὐξηθῆτε",702144,394],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["λέγει",708124,91],["κύριος",707996,4],["οὐκ",709805,28],["ἐροῦσιν",705415,218],["ἔτι",705538,28],["κιβωτὸς",707667,12],["διαθήκης",703456,17],["ἁγίου",700159,116],["Ισραηλ",706839,18],["οὐκ",709805,28],["ἀναβήσεται",700905,93],["ἐπὶ",705080,0],["καρδίαν",707141,9],["οὐκ",709805,28],["ὀνομασθήσεται",709667,134],["οὐδὲ",709816,7],["ἐπισκεφθήσεται",705250,134],["καὶ",707031,7],["οὐ",709805,28],["ποιηθήσεται",710582,134],["ἔτι",705538,28]],"And it shall come to pass that when ye are multiplied and increased upon the land, saith the Lord, in those days they shall say no more, The ark of the covenant of the Holy One of Israel: it shall not come to mind; it shall not be named; neither shall it be visited; nor shall [this] be done any more."],["17",[["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["καλέσουσιν",707084,218],["τὴν",709436,8],["Ιερουσαλημ",706644,9],["θρόνος",706315,4],["κυρίου",707996,18],["καὶ",707031,7],["συναχθήσονται",712375,144],["εἰς",704105,0],["αὐτὴν",702165,104],["πάντα",710177,195],["τὰ",709436,63],["ἔθνη",704068,64],["καὶ",707031,7],["οὐ",709805,28],["πορεύσονται",710667,135],["ἔτι",705538,28],["ὀπίσω",709697,0],["τῶν",709436,43],["ἐνθυμημάτων",704740,44],["τῆς",709436,16],["καρδίας",707141,17],["αὐτῶν",702165,40],["τῆς",709436,16],["πονηρᾶς",710660,82]],"In those days and at that time they shall call Jerusalem the throne of the Lord; and all the nations shall be gathered to it: and they shall not walk any more after the imaginations of their evil heart."],["18",[["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["συνελεύσονται",712458,135],["οἶκος",709516,4],["Ιουδα",706768,18],["ἐπὶ",705080,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["Ισραηλ",706839,18],["καὶ",707031,7],["ἥξουσιν",705956,218],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτὸ",702165,129],["ἀπὸ",701425,0],["γῆς",703083,17],["βορρᾶ",702765,18],["καὶ",707031,7],["ἀπὸ",701425,0],["πασῶν",710177,198],["τῶν",709436,130],["χωρῶν",714011,65],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["κατεκληρονόμησα",707274,155],["τοὺς",709436,58],["πατέρας",710189,57],["αὐτῶν",702165,40]],"In those days the house of Juda shall come together to the house of Israel, and they shall come, together, from the land of the north, and from all the countries, to the land, which I caused their fathers to inherit."],["19",[["καὶ",707031,7],["ἐγὼ",704018,164],["εἶπα",705373,155],["γένοιτο",703104,382],["κύριε",707996,153],["ὅτι",709803,7],["τάξω",712730,165],["σε",711598,163],["εἰς",704105,0],["τέκνα",712761,42],["καὶ",707031,7],["δώσω",703654,165],["σοι",711925,159],["γῆν",703083,9],["ἐκλεκτὴν",704240,36],["κληρονομίαν",707725,9],["θεοῦ",706192,18],["παντοκράτορος",709986,18],["ἐθνῶν",704068,44],["καὶ",707031,7],["εἶπα",705373,155],["πατέρα",710189,6],["καλέσετέ",707084,337],["με",708618,163],["καὶ",707031,7],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["οὐκ",709805,28],["ἀποστραφήσεσθε",701598,261]],"And I said, So be it, Lord, for [thou saidst], I will set thee among children, and will give thee a choice land, the inheritance of the Almighty God of the Gentiles: and I said, Ye shall call me Father; and ye shall not turn away from me."],["20",[["πλὴν",710540,28],["ὡς",714148,7],["ἀθετεῖ",700369,91],["γυνὴ",703209,12],["εἰς",704105,0],["τὸν",709436,5],["συνόντα",712435,183],["αὐτῇ",702165,105],["οὕτως",709859,28],["ἠθέτησεν",700369,2],["εἰς",704105,0],["ἐμὲ",704555,163],["οἶκος",709516,4],["Ισραηλ",706839,18],["λέγει",708124,91],["κύριος",707996,4]],"But as a wife acts treacherously against her husband, so has the house of Israel dealt treacherously against me, saith the Lord."],["21",[["φωνὴ",713640,12],["ἐκ",704132,0],["χειλέων",713781,44],["ἠκούσθη",700587,37],["κλαυθμοῦ",707705,18],["καὶ",707031,7],["δεήσεως",703311,17],["υἱῶν",713075,81],["Ισραηλ",706839,18],["ὅτι",709803,7],["ἠδίκησαν",700269,150],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["αὐτῶν",702165,40],["ἐπελάθοντο",705187,189],["θεοῦ",706192,18],["ἁγίου",700159,116],["αὐτῶν",702165,40]],"A voice from the lips was heard, [even] of weeping and supplication of the children of Israel: for they have dealt unrighteously in their ways, they have forgotten God their Holy One."],["22",[["ἐπιστράφητε",705278,372],["υἱοὶ",713075,274],["ἐπιστρέφοντες",705278,146],["καὶ",707031,7],["ἰάσομαι",706424,181],["τὰ",709436,41],["συντρίμματα",712521,42],["ὑμῶν",713091,145],["ἰδοὺ",706497,88],["δοῦλοι",703817,52],["ἡμεῖς",705983,219],["ἐσόμεθά",704093,141],["σοι",711925,159],["ὅτι",709803,7],["σὺ",712181,164],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["εἶ",704093,154]],"Turn, ye children that are given to turning, and I will heal your bruises. Behold, we will be thy servants; for thou art the Lord our God."],["23",[["ὄντως",709672,28],["εἰς",704105,0],["ψεῦδος",714044,25],["ἦσαν",704093,137],["οἱ",709436,136],["βουνοὶ",702797,52],["καὶ",707031,7],["ἡ",709436,10],["δύναμις",703839,12],["τῶν",709436,43],["ὀρέων",709768,44],["πλὴν",710540,28],["διὰ",703417,0],["κυρίου",707996,18],["θεοῦ",706192,18],["ἡμῶν",705999,145],["ἡ",709436,10],["σωτηρία",712658,12],["τοῦ",709436,35],["Ισραηλ",706839,18]],"Truly the hills and the strength of the mountains were a lying refuge: but by the Lord our God is the salvation of Israel."],["24",[["ἡ",709436,10],["δὲ",703303,11],["αἰσχύνη",700483,12],["κατανάλωσεν",707338,2],["τοὺς",709436,58],["μόχθους",709039,57],["τῶν",709436,80],["πατέρων",710189,81],["ἡμῶν",705999,145],["ἀπὸ",701425,0],["νεότητος",709258,17],["ἡμῶν",705999,145],["τὰ",709436,41],["πρόβατα",710768,42],["αὐτῶν",702165,40],["καὶ",707031,7],["τοὺς",709436,58],["μόσχους",709029,57],["αὐτῶν",702165,40],["καὶ",707031,7],["τοὺς",709436,58],["υἱοὺς",713075,57],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰς",709436,38],["θυγατέρας",706320,39],["αὐτῶν",702165,40]],"But shame has consumed the labours of our fathers from our youth; their sheep and their calves, and their sons and their daughters."],["25",[["ἐκοιμήθημεν",707767,485],["ἐν",704639,0],["τῇ",709436,100],["αἰσχύνῃ",700483,1],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐπεκάλυψεν",705155,2],["ἡμᾶς",705981,194],["ἡ",709436,10],["ἀτιμία",702094,12],["ἡμῶν",705999,145],["διότι",703734,7],["ἔναντι",704653,0],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["ἡμάρτομεν",700773,289],["ἡμεῖς",705983,219],["καὶ",707031,7],["οἱ",709436,136],["πατέρες",710189,52],["ἡμῶν",705999,145],["ἀπὸ",701425,0],["νεότητος",709258,17],["ἡμῶν",705999,145],["ἕως",705792,0],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86],["καὶ",707031,7],["οὐχ",709805,28],["ὑπηκούσαμεν",713096,289],["τῆς",709436,16],["φωνῆς",713640,17],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145]],"We have lain down in our shame, and our disgrace has covered us: because we and our fathers have sinned before our God, from our youth until this day; and we have not hearkened to the voice of the Lord our God."]]