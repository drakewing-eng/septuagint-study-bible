[["1",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["ἐὰν",703912,7],["στῇ",706846,172],["Μωυσῆς",709112,4],["καὶ",707031,7],["Σαμουηλ",711473,4],["πρὸ",710747,0],["προσώπου",710986,21],["μου",709032,133],["οὐκ",709805,28],["ἔστιν",704093,91],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["πρὸς",710844,0],["αὐτούς",702165,62],["ἐξαπόστειλον",704872,176],["τὸν",709436,5],["λαὸν",708094,6],["τοῦτον",709858,85],["καὶ",707031,7],["ἐξελθέτωσαν",704909,264]],"And the Lord said to me, Though Moses and Samuel stood before my face, my soul could not be toward them: dismiss this people, and let them go forth."],["2",[["καὶ",707031,7],["ἔσται",704093,93],["ἐὰν",703912,7],["εἴπωσιν",705373,234],["πρὸς",710844,0],["σέ",711598,163],["ποῦ",710706,28],["ἐξελευσόμεθα",704909,141],["καὶ",707031,7],["ἐρεῖς",705415,166],["πρὸς",710844,0],["αὐτούς",702165,62],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὅσοι",709788,138],["εἰς",704105,0],["θάνατον",706096,6],["εἰς",704105,0],["θάνατον",706096,6],["καὶ",707031,7],["ὅσοι",709788,138],["εἰς",704105,0],["μάχαιραν",708593,9],["εἰς",704105,0],["μάχαιραν",708593,9],["καὶ",707031,7],["ὅσοι",709788,138],["εἰς",704105,0],["λιμόν",708210,6],["εἰς",704105,0],["λιμόν",708210,6],["καὶ",707031,7],["ὅσοι",709788,138],["εἰς",704105,0],["αἰχμαλωσίαν",700499,9],["εἰς",704105,0],["αἰχμαλωσίαν",700499,9]],"And it shall be, if they say to thee, Whither shall we go forth? then thou shalt say to them, Thus saith the Lord; As many as are for death, to death; and as many as are for famine, to famine; and as many as are for the sword, to the sword; and as many as are for captivity, to captivity."],["3",[["καὶ",707031,7],["ἐκδικήσω",704174,165],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["τέσσαρα",712808,68],["εἴδη",704074,42],["λέγει",708124,91],["κύριος",707996,4],["τὴν",709436,8],["μάχαιραν",708593,9],["εἰς",704105,0],["σφαγὴν",712568,9],["καὶ",707031,7],["τοὺς",709436,58],["κύνας",708004,57],["εἰς",704105,0],["διασπασμὸν",703582,6],["καὶ",707031,7],["τὰ",709436,41],["θηρία",706252,42],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["τὰ",709436,41],["πετεινὰ",710439,42],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["εἰς",704105,0],["βρῶσιν",702825,9],["καὶ",707031,7],["εἰς",704105,0],["διαφθοράν",703625,9]],"And I will punish them with four kinds [of death], saith the Lord, the sword to slay, and the dogs to tear, and the wild beasts of the earth, and the birds of the sky to devour and destroy."],["4",[["καὶ",707031,7],["παραδώσω",710014,165],["αὐτοὺς",702165,62],["εἰς",704105,0],["ἀνάγκας",700925,39],["πάσαις",710177,291],["ταῖς",709436,75],["βασιλείαις",702577,76],["τῆς",709436,16],["γῆς",703083,17],["διὰ",703417,0],["Μανασση",708470,6],["υἱὸν",713075,6],["Εζεκιου",704044,18],["βασιλέα",702580,6],["Ιουδα",706768,18],["περὶ",710285,0],["πάντων",710177,169],["ὧν",709781,252],["ἐποίησεν",710582,2],["ἐν",704639,0],["Ιερουσαλημ",706644,1]],"And I will deliver them up for distress to all the kingdoms of the earth, because of Manasses son of Ezekias king of Juda, for all that he did in Jerusalem."],["5",[["τίς",712867,158],["φείσεται",713406,93],["ἐπὶ",705080,0],["σοί",711925,159],["Ιερουσαλημ",706644,258],["καὶ",707031,7],["τίς",712867,158],["δειλιάσει",703321,127],["ἐπὶ",705080,0],["σοί",711925,159],["ἢ",705924,7],["τίς",712867,158],["ἀνακάμψει",700969,127],["εἰς",704105,0],["εἰρήνην",704098,9],["σοι",711925,159]],"Who will spare thee, O Jerusalem? and who will fear for thee? or who will turn back [to ask] for thy welfare?"],["6",[["σὺ",712181,164],["ἀπεστράφης",701598,168],["με",708618,163],["λέγει",708124,91],["κύριος",707996,4],["ὀπίσω",709697,28],["πορεύσῃ",710667,420],["καὶ",707031,7],["ἐκτενῶ",704322,165],["τὴν",709436,8],["χεῖρά",713787,9],["μου",709032,133],["καὶ",707031,7],["διαφθερῶ",703624,165],["σε",711598,163],["καὶ",707031,7],["οὐκέτι",709827,28],["ἀνήσω",701169,165],["αὐτούς",702165,62]],"Thou hast turned away from me, saith the Lord, thou wilt go back: therefore I will stretch out my hand, and will destroy thee, and will no more spare them."],["7",[["καὶ",707031,7],["διασπερῶ",703584,165],["αὐτοὺς",702165,62],["ἐν",704639,0],["διασπορᾷ",703585,1],["ἐν",704639,0],["πύλαις",711082,76],["λαοῦ",708094,18],["μου",709032,133],["ἠτεκνώθησαν",702081,99],["ἀπώλεσαν",701513,150],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["διὰ",703417,0],["τὰς",709436,38],["κακίας",707054,39],["αὐτῶν",702165,40]],"And I will completely scatter them; in the gates of my people they are bereaved of children: they have destroyed my people because of their iniquities."],["8",[["ἐπληθύνθησαν",710530,99],["χῆραι",713848,191],["αὐτῶν",702165,40],["ὑπὲρ",713111,0],["τὴν",709436,8],["ἄμμον",700845,9],["τῆς",709436,16],["θαλάσσης",706069,17],["ἐπήγαγον",704994,150],["ἐπὶ",705080,0],["μητέρα",708892,9],["νεανίσκου",709232,18],["ταλαιπωρίαν",712695,9],["ἐν",704639,0],["μεσημβρίᾳ",708758,1],["ἐπέρριψα",705238,155],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["ἐξαίφνης",704842,28],["τρόμον",712975,6],["καὶ",707031,7],["σπουδήν",712035,9]],"Their widows have been multiplied more than the sand of the sea: I have brought young men against the mother, [even] distress at noon-day: I have suddenly cast upon her trembling and anxiety."],["9",[["ἐκενώθη",707614,37],["ἡ",709436,10],["τίκτουσα",712853,188],["ἑπτά",705357,59],["ἀπεκάκησεν",701472,2],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτῆς",702165,86],["ἐπέδυ",705126,2],["ὁ",709436,3],["ἥλιος",705974,4],["αὐτῇ",702165,105],["ἔτι",705538,28],["μεσούσης",708771,222],["τῆς",709436,16],["ἡμέρας",705984,17],["κατῃσχύνθη",707257,37],["καὶ",707031,7],["ὠνειδίσθη",709655,37],["τοὺς",709436,58],["καταλοίπους",707317,60],["αὐτῶν",702165,40],["εἰς",704105,0],["μάχαιραν",708593,9],["δώσω",703654,165],["ἐναντίον",704654,0],["τῶν",709436,80],["ἐχθρῶν",705779,81],["αὐτῶν",702165,40]],"She that bore seven is spent; her soul has fainted under trouble; her sun is gone down while it is yet noon; she is ashamed and disgraced: I will give the remnant of them to the sword before their enemies."],["10",[["οἴμμοι",709525,88],["ἐγώ",704018,164],["μῆτερ",708892,258],["ὡς",714148,7],["τίνα",712867,572],["με",708618,163],["ἔτεκες",712853,162],["ἄνδρα",701150,6],["δικαζόμενον",703691,212],["καὶ",707031,7],["διακρινόμενον",703488,212],["πάσῃ",710177,101],["τῇ",709436,100],["γῇ",703083,1],["οὔτε",709857,7],["ὠφέλησα",714171,155],["οὔτε",709857,7],["ὠφέλησέν",714171,2],["με",708618,163],["οὐδείς",709817,14],["ἡ",709436,10],["ἰσχύς",706858,12],["μου",709032,133],["ἐξέλιπεν",704237,2],["ἐν",704639,0],["τοῖς",709436,147],["καταρωμένοις",707396,341],["με",708618,163]],"Woe is me, [my] mother! thou hast born me as some man of strife, and at variance with the whole earth; I have not helped [others], nor has any one helped me; my strength has failed among them that curse me."],["11",[["γένοιτο",703104,382],["δέσποτα",703379,153],["κατευθυνόντων",707521,170],["αὐτῶν",702165,40],["εἰ",704071,7],["μὴ",708851,28],["παρέστην",710152,155],["σοι",711925,159],["ἐν",704639,0],["καιρῷ",707047,114],["τῶν",709436,80],["κακῶν",707066,169],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐν",704639,0],["καιρῷ",707047,114],["θλίψεως",706276,17],["αὐτῶν",702165,40],["εἰς",704105,0],["ἀγαθὰ",700106,68],["πρὸς",710844,0],["τὸν",709436,5],["ἐχθρόν",705779,6]],"Be it so, Lord, in their prosperity; surely I stood before thee in the time of their calamities, and in the time of their affliction, for [their] good against the enemy."],["12",[["εἰ",704071,7],["γνωσθήσεται",703105,134],["σίδηρος",711774,4],["καὶ",707031,7],["περιβόλαιον",710300,25],["χαλκοῦν",713690,46]],"Will iron be known? whereas thy strength is a brazen covering."],["13",[["ἡ",709436,10],["ἰσχύς",706858,12],["σου",711945,133],["καὶ",707031,7],["τοὺς",709436,58],["θησαυρούς",706258,57],["σου",711945,133],["εἰς",704105,0],["προνομὴν",710827,9],["δώσω",703654,165],["ἀντάλλαγμα",701209,25],["διὰ",703417,0],["πάσας",710177,119],["τὰς",709436,38],["ἁμαρτίας",700775,39],["σου",711945,133],["καὶ",707031,7],["ἐν",704639,0],["πᾶσι",710177,94],["τοῖς",709436,95],["ὁρίοις",709749,96],["σου",711945,133]],"Yea, I will give thy treasures for a spoil as a recompence, because of all thy sins, and [that] in all thy borders."],["14",[["καὶ",707031,7],["καταδουλώσω",707245,165],["σε",711598,163],["κύκλῳ",707959,114],["τοῖς",709436,147],["ἐχθροῖς",705779,148],["σου",711945,133],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ᾗ",709781,108],["οὐκ",709805,28],["ᾔδεις",709492,508],["ὅτι",709803,7],["πῦρ",711088,15],["ἐκκέκαυται",704205,403],["ἐκ",704132,0],["τοῦ",709436,35],["θυμοῦ",706334,18],["μου",709032,133],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["καυθήσεται",707049,134]],"And I will enslave thee to thine enemies round about, in a land which thou hast not known; for a fire has been kindled out of my wrath; it shall burn upon you."],["15",[["κύριε",707996,153],["μνήσθητί",708960,244],["μου",709032,133],["καὶ",707031,7],["ἐπίσκεψαί",705250,300],["με",708618,163],["καὶ",707031,7],["ἀθῴωσόν",700391,176],["με",708618,163],["ἀπὸ",701425,0],["τῶν",709436,80],["καταδιωκόντων",707243,170],["με",708618,163],["μὴ",708851,28],["εἰς",704105,0],["μακροθυμίαν",708419,9],["γνῶθι",703105,176],["ὡς",714148,7],["ἔλαβον",708076,155],["περὶ",710285,0],["σοῦ",711945,133],["ὀνειδισμὸν",709657,6]],"O Lord, remember me, and visit me, and vindicate me before them that persecute me; do not bear long with them; know how I have met with reproach for thy sake, from those who set at nought thy words;"],["16",[["ὑπὸ",713184,0],["τῶν",709436,80],["ἀθετούντων",700369,170],["τοὺς",709436,58],["λόγους",708236,57],["σου",711945,133],["συντέλεσον",712510,176],["αὐτούς",702165,62],["καὶ",707031,7],["ἔσται",704093,93],["ὁ",709436,3],["λόγος",708236,4],["σου",711945,133],["ἐμοὶ",704577,159],["εἰς",704105,0],["εὐφροσύνην",705717,9],["καὶ",707031,7],["χαρὰν",713719,9],["καρδίας",707141,17],["μου",709032,133],["ὅτι",709803,7],["ἐπικέκληται",705153,187],["τὸ",709436,34],["ὄνομά",709666,15],["σου",711945,133],["ἐπ᾿",705080,0],["ἐμοί",704577,159],["κύριε",707996,153],["παντοκράτωρ",709986,4]],"consume them; and thy word shall be to me for the joy and gladness of my heart: for thy name has been called upon me, O Lord Almighty."],["17",[["οὐκ",709805,28],["ἐκάθισα",707006,155],["ἐν",704639,0],["συνεδρίῳ",712429,54],["αὐτῶν",702165,40],["παιζόντων",709931,170],["ἀλλὰ",700680,7],["εὐλαβούμην",705627,334],["ἀπὸ",701425,0],["προσώπου",710986,21],["χειρός",713787,17],["σου",711945,133],["κατὰ",707200,0],["μόνας",709003,119],["ἐκαθήμην",707000,334],["ὅτι",709803,7],["πικρίας",710472,39],["ἐνεπλήσθην",704592,156]],"I have not sat in the assembly of them as they mocked, but I feared because of thy power: I sat alone, for I was filled with bitterness."],["18",[["ἵνα",706747,7],["τί",712867,126],["οἱ",709436,136],["λυποῦντές",708272,146],["με",708618,163],["κατισχύουσίν",707531,197],["μου",709032,133],["ἡ",709436,10],["πληγή",710527,12],["μου",709032,133],["στερεά",712075,29],["πόθεν",710580,28],["ἰαθήσομαι",706424,180],["γινομένη",703104,211],["ἐγενήθη",703104,37],["μοι",708974,159],["ὡς",714148,7],["ὕδωρ",713071,15],["ψευδὲς",714036,26],["οὐκ",709805,28],["ἔχον",705785,32],["πίστιν",710484,9]],"Why do they that grieve me prevail against me? my wound is severe; whence shall I be healed? it is indeed become to me as deceitful water, that has no faithfulness."],["19",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἐὰν",703912,7],["ἐπιστρέψῃς",705278,175],["καὶ",707031,7],["ἀποκαταστήσω",701470,207],["σε",711598,163],["καὶ",707031,7],["πρὸ",710747,0],["προσώπου",710986,21],["μου",709032,133],["στήσῃ",706846,123],["καὶ",707031,7],["ἐὰν",703912,7],["ἐξαγάγῃς",704834,175],["τίμιον",712858,27],["ἀπὸ",701425,0],["ἀναξίου",701021,116],["ὡς",714148,7],["στόμα",712125,15],["μου",709032,133],["ἔσῃ",704093,123],["καὶ",707031,7],["ἀναστρέψουσιν",701060,218],["αὐτοὶ",702165,201],["πρὸς",710844,0],["σέ",711598,163],["καὶ",707031,7],["σὺ",712181,164],["οὐκ",709805,28],["ἀναστρέψεις",701060,166],["πρὸς",710844,0],["αὐτούς",702165,62]],"Therefore thus saith the Lord, If thou wilt return, then will I restore thee, and thou shalt stand before my face: and if thou wilt bring forth the precious from the worthless, thou shalt be as my mouth: and they shall return to thee; but thou shalt not return to them."],["20",[["καὶ",707031,7],["δώσω",703654,165],["σε",711598,163],["τῷ",709436,113],["λαῷ",708094,114],["τούτῳ",709858,50],["ὡς",714148,7],["τεῖχος",712759,25],["ὀχυρὸν",709889,46],["χαλκοῦν",713690,46],["καὶ",707031,7],["πολεμήσουσιν",710601,218],["πρὸς",710844,0],["σὲ",711598,163],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["δύνωνται",703838,380],["πρὸς",710844,0],["σέ",711598,163],["διότι",703734,7],["μετὰ",708780,0],["σοῦ",711945,133],["εἰμι",704093,157],["τοῦ",709436,20],["σῴζειν",712627,55],["σε",711598,163]],"And I will make thee to this people as a strong brazen wall; and they shall fight against thee, but they shall by no means prevail against thee;"],["21",[["καὶ",707031,7],["ἐξαιρεῖσθαί",704838,110],["σε",711598,163],["ἐκ",704132,0],["χειρὸς",713787,17],["πονηρῶν",710660,169],["καὶ",707031,7],["λυτρώσομαί",708282,181],["σε",711598,163],["ἐκ",704132,0],["χειρὸς",713787,17],["λοιμῶν",708245,81]],"for I am with thee to save thee, and to deliver thee out of the hand of wicked [men]; and I will ransom thee out of the hand of pestilent [men]."]]