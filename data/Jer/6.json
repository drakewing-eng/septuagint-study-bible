[["1",[["ἐνισχύσατε",704750,74],["υἱοὶ",713075,52],["Βενιαμιν",702650,18],["ἐκ",704132,0],["μέσου",708768,116],["τῆς",709436,16],["Ιερουσαλημ",706644,17],["καὶ",707031,7],["ἐν",704639,0],["Θεκουε",706159,1],["σημάνατε",711745,74],["σάλπιγγι",711424,1],["καὶ",707031,7],["ὑπὲρ",713111,0],["Βαιθαχαρμα",702402,9],["ἄρατε",700473,74],["σημεῖον",711748,25],["ὅτι",709803,7],["κακὰ",707066,195],["ἐκκέκυφεν",704229,171],["ἀπὸ",701425,0],["βορρᾶ",702765,18],["καὶ",707031,7],["συντριβὴ",712519,12],["μεγάλη",708653,29],["γίνεται",703104,117]],"Strengthen yourselves, ye children of Benjamin, [to flee] out of the midst of Jerusalem, and sound an alarm with the trumpet in Thecue, and set up a signal over Bæthacharma: for evil threatens from the north, and a great destruction is coming."],["2",[["καὶ",707031,7],["ἀφαιρεθήσεται",702177,134],["τὸ",709436,34],["ὕψος",713288,15],["σου",711945,133],["θύγατερ",706320,258],["Σιων",711816,17]],"And [thy] pride, O daughter of Sion, shall be taken away."],["3",[["εἰς",704105,0],["αὐτὴν",702165,104],["ἥξουσιν",705956,218],["ποιμένες",710596,52],["καὶ",707031,7],["τὰ",709436,63],["ποίμνια",710598,64],["αὐτῶν",702165,40],["καὶ",707031,7],["πήξουσιν",710452,218],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["σκηνὰς",711845,39],["κύκλῳ",707959,114],["καὶ",707031,7],["ποιμανοῦσιν",710594,218],["ἕκαστος",704133,14],["τῇ",709436,100],["χειρὶ",713787,1],["αὐτοῦ",702165,102]],"The shepherds and their flocks shall come to her; and they shall pitch [their] tents against her round about, and shall feed [their flocks] each with his hand."],["4",[["παρασκευάσασθε",710103,186],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["εἰς",704105,0],["πόλεμον",710605,6],["ἀνάστητε",701173,74],["καὶ",707031,7],["ἀναβῶμεν",700905,79],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["μεσημβρίας",708758,17],["οὐαὶ",709807,88],["ἡμῖν",705994,90],["ὅτι",709803,7],["κέκλικεν",707738,171],["ἡ",709436,10],["ἡμέρα",705984,12],["ὅτι",709803,7],["ἐκλείπουσιν",704237,197],["αἱ",709436,190],["σκιαὶ",711852,191],["τῆς",709436,16],["ἑσπέρας",705500,17]],"Prepare yourselves for war against her; rise up, and let us go up against her at noon. Woe to us! for the day has gone down, for the shadows of the day fail."],["5",[["ἀνάστητε",701173,74],["καὶ",707031,7],["ἀναβῶμεν",700905,79],["ἐν",704639,0],["τῇ",709436,100],["νυκτὶ",709386,1],["καὶ",707031,7],["διαφθείρωμεν",703624,233],["τὰ",709436,41],["θεμέλια",706181,42],["αὐτῆς",702165,86]],"Rise, and let us go up against her by night, and destroy her foundations."],["6",[["ὅτι",709803,7],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἔκκοψον",704225,176],["τὰ",709436,41],["ξύλα",709427,42],["αὐτῆς",702165,86],["ἔκχεον",704368,176],["ἐπὶ",705080,0],["Ιερουσαλημ",706644,9],["δύναμιν",703839,9],["ὦ",714081,88],["πόλις",710612,12],["ψευδής",714036,29],["ὅλη",709597,29],["καταδυναστεία",707247,29],["ἐν",704639,0],["αὐτῇ",702165,105]],"For thus saith the Lord, Hew down her trees, array a numerous force against Jerusalem. O false city; [there is] all oppression in her."],["7",[["ὡς",714148,7],["ψύχει",714076,91],["λάκκος",708067,4],["ὕδωρ",713071,25],["οὕτως",709859,28],["ψύχει",714076,91],["κακία",707054,12],["αὐτῆς",702165,86],["ἀσέβεια",701904,12],["καὶ",707031,7],["ταλαιπωρία",712695,12],["ἀκουσθήσεται",700587,134],["ἐν",704639,0],["αὐτῇ",702165,105],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["αὐτῆς",702165,86],["διὰ",703417,0],["παντός",710177,116],["πόνῳ",710661,114],["καὶ",707031,7],["μάστιγι",708568,1]],"As a cistern cools water, so her wickedness cools her, ungodliness and misery shall be heard in her, [as] continually before her."],["8",[["παιδευθήσῃ",709926,364],["Ιερουσαλημ",706644,258],["μὴ",708851,28],["ἀποστῇ",702214,172],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ἀπὸ",701425,0],["σοῦ",711945,133],["μὴ",708851,28],["ποιήσω",710582,207],["σε",711598,163],["ἄβατον",700023,36],["γῆν",703083,9],["ἥτις",709793,412],["οὐ",709805,28],["κατοικηθήσεται",707534,134]],"Thou shalt be chastened, O Jerusalem, with pain and the scourge, lest my soul depart from thee; lest I make thee a desert land, which shall not be inhabited."],["9",[["ὅτι",709803,7],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["καλαμᾶσθε",707078,374],["καλαμᾶσθε",707078,374],["ὡς",714148,7],["ἄμπελον",700870,9],["τὰ",709436,41],["κατάλοιπα",707317,68],["τοῦ",709436,35],["Ισραηλ",706839,18],["ἐπιστρέψατε",705278,74],["ὡς",714148,7],["ὁ",709436,3],["τρυγῶν",712996,72],["ἐπὶ",705080,0],["τὸν",709436,5],["κάρταλλον",707177,6],["αὐτοῦ",702165,102]],"For thus saith the Lord, Glean, glean thoroughly as a vine the remnant of Israel: turn back [your hands] as a grape-gatherer to his basket."],["10",[["πρὸς",710844,0],["τίνα",712867,356],["λαλήσω",708071,165],["καὶ",707031,7],["διαμαρτύρωμαι",703513,386],["καὶ",707031,7],["ἀκούσεται",700587,93],["ἰδοὺ",706497,88],["ἀπερίτμητα",701397,195],["τὰ",709436,63],["ὦτα",709852,64],["αὐτῶν",702165,40],["καὶ",707031,7],["οὐ",709805,28],["δύνανται",703838,269],["ἀκούειν",700587,55],["ἰδοὺ",706497,88],["τὸ",709436,34],["ῥῆμα",711246,15],["κυρίου",707996,18],["ἐγένετο",703104,23],["αὐτοῖς",702165,151],["εἰς",704105,0],["ὀνειδισμόν",709657,6],["οὐ",709805,28],["μὴ",708851,28],["βουληθῶσιν",702795,272],["αὐτὸ",702165,129],["ἀκοῦσαι",700587,106]],"To whom shall I speak, and testify, that he may hearken? behold, thine ears are uncircumcised, and they shall not be able to hear: behold, the word of the Lord is become to them a reproach, they will not at all desire it."],["11",[["καὶ",707031,7],["τὸν",709436,5],["θυμόν",706334,6],["μου",709032,133],["ἔπλησα",710532,155],["καὶ",707031,7],["ἐπέσχον",705076,155],["καὶ",707031,7],["οὐ",709805,28],["συνετέλεσα",712510,155],["αὐτούς",702165,62],["ἐκχεῶ",704368,165],["ἐπὶ",705080,0],["νήπια",709295,68],["ἔξωθεν",704984,28],["καὶ",707031,7],["ἐπὶ",705080,0],["συναγωγὴν",712376,9],["νεανίσκων",709232,81],["ἅμα",700745,28],["ὅτι",709803,7],["ἀνὴρ",701150,4],["καὶ",707031,7],["γυνὴ",703209,12],["συλλημφθήσονται",712262,144],["πρεσβύτερος",710735,14],["μετὰ",708780,0],["πλήρους",710541,116],["ἡμερῶν",705984,65]],"And I allowed my wrath to come to the full, yet I kept [it] in, and did not utterly destroy them: I will pour it out on the children without, and on the assembly of young men together: for man and woman shall be taken together, the old man with him that is full of days."],["12",[["καὶ",707031,7],["μεταστραφήσονται",708817,144],["αἱ",709436,190],["οἰκίαι",709505,191],["αὐτῶν",702165,40],["εἰς",704105,0],["ἑτέρους",705535,60],["ἀγροὶ",700196,52],["καὶ",707031,7],["αἱ",709436,190],["γυναῖκες",703209,191],["αὐτῶν",702165,40],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτό",702165,129],["ὅτι",709803,7],["ἐκτενῶ",704322,165],["τὴν",709436,8],["χεῖρά",713787,9],["μου",709032,133],["ἐπὶ",705080,0],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104],["λέγει",708124,91],["κύριος",707996,4]],"And their houses shall be turned to others, [with] their fields and their wives together: for I will stretch out my hand upon the inhabitants of this land, saith the Lord."],["13",[["ὅτι",709803,7],["ἀπὸ",701425,0],["μικροῦ",708915,116],["αὐτῶν",702165,40],["καὶ",707031,7],["ἕως",705792,0],["μεγάλου",708653,116],["πάντες",710177,138],["συνετελέσαντο",712510,189],["ἄνομα",701194,68],["ἀπὸ",701425,0],["ἱερέως",706614,18],["καὶ",707031,7],["ἕως",705792,0],["ψευδοπροφήτου",714043,18],["πάντες",710177,138],["ἐποίησαν",710582,150],["ψευδῆ",714036,68]],"For from the least of them even to the greatest they have all committed iniquity; from the priest even to the false prophet they have all wrought falsely."],["14",[["καὶ",707031,7],["ἰῶντο",706424,139],["τὸ",709436,24],["σύντριμμα",712521,25],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133],["ἐξουθενοῦντες",704972,146],["καὶ",707031,7],["λέγοντες",708124,146],["εἰρήνη",704098,12],["εἰρήνη",704098,12],["καὶ",707031,7],["ποῦ",710706,28],["ἐστιν",704093,91],["εἰρήνη",704098,12]],"And they healed the breach of my people [imperfectly], making light [of it], and saying, Peace, peace: and where is peace?"],["15",[["κατῃσχύνθησαν",707257,99],["ὅτι",709803,7],["ἐξελίποσαν",704237,150],["καὶ",707031,7],["οὐδ᾿",709816,7],["ὧς",714148,7],["καταισχυνόμενοι",707257,348],["κατῃσχύνθησαν",707257,99],["καὶ",707031,7],["τὴν",709436,8],["ἀτιμίαν",702094,9],["αὐτῶν",702165,40],["οὐκ",709805,28],["ἔγνωσαν",703105,150],["διὰ",703417,0],["τοῦτο",709858,129],["πεσοῦνται",710481,135],["ἐν",704639,0],["τῇ",709436,100],["πτώσει",711072,1],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐν",704639,0],["καιρῷ",707047,114],["ἐπισκοπῆς",705255,17],["αὐτῶν",702165,40],["ἀπολοῦνται",701513,135],["εἶπεν",705373,2],["κύριος",707996,4]],"They were ashamed because they failed; yet they were not ashamed as those who are [truly] ashamed, and they knew not their own disgrace: therefore shall they [utterly] fall when they do fall, and in the time of visitation shall they perish, said the Lord."],["16",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["στῆτε",706846,74],["ἐπὶ",705080,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["καὶ",707031,7],["ἴδετε",709725,74],["καὶ",707031,7],["ἐρωτήσατε",705459,74],["τρίβους",712939,39],["κυρίου",707996,18],["αἰωνίους",700505,60],["καὶ",707031,7],["ἴδετε",709725,74],["ποία",710599,29],["ἐστὶν",704093,91],["ἡ",709436,10],["ὁδὸς",709458,12],["ἡ",709436,10],["ἀγαθή",700106,29],["καὶ",707031,7],["βαδίζετε",702367,335],["ἐν",704639,0],["αὐτῇ",702165,105],["καὶ",707031,7],["εὑρήσετε",705676,337],["ἁγνισμὸν",700174,6],["ταῖς",709436,75],["ψυχαῖς",714070,76],["ὑμῶν",713091,145],["καὶ",707031,7],["εἶπαν",705373,150],["οὐ",709805,28],["πορευσόμεθα",710667,141]],"Thus saith the Lord, Stand ye in the ways, and see, and ask for the old paths of the Lord; and see what is the good way, and walk in it, and ye shall find purification for your souls. But they said, We will not walk [in them]."],["17",[["κατέστακα",707011,89],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["σκοπούς",711877,57],["ἀκούσατε",700587,74],["τῆς",709436,16],["φωνῆς",713640,17],["τῆς",709436,16],["σάλπιγγος",711424,17],["καὶ",707031,7],["εἶπαν",705373,150],["οὐκ",709805,28],["ἀκουσόμεθα",700587,141]],"I have set watchmen over you, [saying], Hear ye the sound of the trumpet. But they said, We will not hear [it]."],["18",[["διὰ",703417,0],["τοῦτο",709858,129],["ἤκουσαν",700587,150],["τὰ",709436,63],["ἔθνη",704068,64],["καὶ",707031,7],["οἱ",709436,136],["ποιμαίνοντες",710594,146],["τὰ",709436,41],["ποίμνια",710598,42],["αὐτῶν",702165,40]],"Therefore have the nations heard, and they that feed their flocks."],["19",[["ἄκουε",700587,240],["γῆ",703083,258],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐπάγω",704994,157],["ἐπὶ",705080,0],["τὸν",709436,5],["λαὸν",708094,6],["τοῦτον",709858,85],["κακά",707066,68],["τὸν",709436,5],["καρπὸν",707169,6],["ἀποστροφῆς",701599,17],["αὐτῶν",702165,40],["ὅτι",709803,7],["τῶν",709436,80],["λόγων",708236,81],["μου",709032,133],["οὐ",709805,28],["προσέσχον",710895,150],["καὶ",707031,7],["τὸν",709436,5],["νόμον",709349,6],["μου",709032,133],["ἀπώσαντο",701659,189]],"Hear, O earth: behold, I will bring evils upon this people, [even] the fruit of their rebellions; for they have not heeded my words, and they have rejected my law."],["20",[["ἵνα",706747,7],["τί",712867,126],["μοι",708974,159],["λίβανον",708186,6],["ἐκ",704132,0],["Σαβα",711332,17],["φέρετε",713428,87],["καὶ",707031,7],["κιννάμωμον",707683,25],["ἐκ",704132,0],["γῆς",703083,17],["μακρόθεν",708417,28],["τὰ",709436,63],["ὁλοκαυτώματα",709589,64],["ὑμῶν",713091,145],["οὔκ",709805,28],["εἰσιν",704093,197],["δεκτά",703348,195],["καὶ",707031,7],["αἱ",709436,190],["θυσίαι",706345,191],["ὑμῶν",713091,145],["οὐχ",709805,28],["ἥδυνάν",705943,150],["μοι",708974,159]],"Wherefore do ye bring me frankincense from Saba, and cinnamon from a land afar off? your whole-burnt-offerings are not acceptable, and your sacrifices have not been pleasant to me."],["21",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["δίδωμι",703654,157],["ἐπὶ",705080,0],["τὸν",709436,5],["λαὸν",708094,6],["τοῦτον",709858,85],["ἀσθένειαν",701937,9],["καὶ",707031,7],["ἀσθενήσουσιν",701938,218],["ἐν",704639,0],["αὐτῇ",702165,105],["πατέρες",710189,52],["καὶ",707031,7],["υἱοὶ",713075,52],["ἅμα",700745,28],["γείτων",703016,4],["καὶ",707031,7],["ὁ",709436,3],["πλησίον",710547,28],["αὐτοῦ",702165,102],["ἀπολοῦνται",701513,135]],"Therefore thus saith the Lord, Behold, I [will] bring weakness upon this people, and the fathers and sons shall be weak together; the neighbour and his friend shall perish."],["22",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἰδοὺ",706497,88],["λαὸς",708094,4],["ἔρχεται",705453,117],["ἀπὸ",701425,0],["βορρᾶ",702765,18],["καὶ",707031,7],["ἔθνη",704068,64],["ἐξεγερθήσεται",704889,134],["ἀπ᾿",701425,0],["ἐσχάτου",705519,116],["τῆς",709436,16],["γῆς",703083,17]],"Thus saith the Lord, Behold, a people comes from the north, and nations shall be stirred up from the end of the earth."],["23",[["τόξον",712898,25],["καὶ",707031,7],["ζιβύνην",705881,9],["κρατήσουσιν",707879,218],["ἰταμός",706864,14],["ἐστιν",704093,91],["καὶ",707031,7],["οὐκ",709805,28],["ἐλεήσει",704418,127],["φωνὴ",713640,12],["αὐτοῦ",702165,102],["ὡς",714148,7],["θάλασσα",706069,12],["κυμαίνουσα",707969,188],["ἐφ᾿",705080,0],["ἵπποις",706790,148],["καὶ",707031,7],["ἅρμασιν",701768,96],["παρατάξεται",710108,93],["ὡς",714148,7],["πῦρ",711088,15],["εἰς",704105,0],["πόλεμον",710605,6],["πρὸς",710844,0],["σέ",711598,163],["θύγατερ",706320,258],["Σιων",711816,17]],"They shall lay hold on bow and spear; [the people] is fierce, and will have no mercy; their voice is as the roaring sea; they shall array themselves for war against thee as fire on horses and chariots, O daughter of Sion."],["24",[["ἠκούσαμεν",700587,289],["τὴν",709436,8],["ἀκοὴν",700561,9],["αὐτῶν",702165,40],["παρελύθησαν",710070,99],["αἱ",709436,190],["χεῖρες",713787,191],["ἡμῶν",705999,145],["θλῖψις",706276,12],["κατέσχεν",707526,2],["ἡμᾶς",705981,194],["ὠδῖνες",714094,191],["ὡς",714148,7],["τικτούσης",712853,222]],"We have heard the report of them: our hands are weakened: anguish has seized us, the pangs as of a woman in travail."],["25",[["μὴ",708851,28],["ἐκπορεύεσθε",704293,73],["εἰς",704105,0],["ἀγρὸν",700196,6],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["μὴ",708851,28],["βαδίζετε",702367,335],["ὅτι",709803,7],["ῥομφαία",711291,12],["τῶν",709436,80],["ἐχθρῶν",705779,81],["παροικεῖ",710156,91],["κυκλόθεν",707956,28]],"Go not forth into the field, and walk not in the ways; for the sword of the enemy lingers round about."],["26",[["θύγατερ",706320,258],["λαοῦ",708094,18],["μου",709032,133],["περίζωσαι",710317,300],["σάκκον",711386,6],["κατάπασαι",707359,300],["ἐν",704639,0],["σποδῷ",712022,1],["πένθος",710253,25],["ἀγαπητοῦ",700124,116],["ποίησαι",710582,300],["σεαυτῇ",711599,105],["κοπετὸν",707821,6],["οἰκτρόν",709524,27],["ὅτι",709803,7],["ἐξαίφνης",704842,28],["ἥξει",705956,127],["ταλαιπωρία",712695,12],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194]],"O daughter of my people, gird thyself with sackcloth: sprinkle [thyself] with ashes; make for thyself pitiable lamentation, [as] the mourning for a beloved [son]: for misery will come suddenly upon you."],["27",[["δοκιμαστὴν",703778,6],["δέδωκά",703654,89],["σε",711598,163],["ἐν",704639,0],["λαοῖς",708094,148],["δεδοκιμασμένοις",703776,521],["καὶ",707031,7],["γνώσῃ",703105,123],["με",708618,163],["ἐν",704639,0],["τῷ",709436,53],["δοκιμάσαι",703776,106],["με",708618,163],["τὴν",709436,8],["ὁδὸν",709458,9],["αὐτῶν",702165,40]],"I have caused thee to be tried among tried nations, and thou shalt know me when I have tried their way."],["28",[["πάντες",710177,138],["ἀνήκοοι",701144,138],["πορευόμενοι",710667,348],["σκολιῶς",711870,28],["χαλκὸς",713695,4],["καὶ",707031,7],["σίδηρος",711774,4],["πάντες",710177,138],["διεφθαρμένοι",703624,429],["εἰσίν",704093,197]],"[They are] all disobedient, walking perversely: [they are] brass and iron; they are all corrupted."],["29",[["ἐξέλιπεν",704237,2],["φυσητὴρ",713632,4],["ἀπὸ",701425,0],["πυρός",711088,21],["ἐξέλιπεν",704237,2],["μόλιβος",708981,4],["εἰς",704105,0],["κενὸν",707612,27],["ἀργυροκόπος",701709,4],["ἀργυροκοπεῖ",701708,91],["πονηρία",710659,12],["αὐτῶν",702165,40],["οὐκ",709805,28],["ἐτάκη",712839,37]],"The bellows have failed from the fire, the lead has failed: the silversmith works at his trade in vain; their wickedness is not consumed."],["30",[["ἀργύριον",701707,25],["ἀποδεδοκιμασμένον",701451,414],["καλέσατε",707084,74],["αὐτούς",702165,62],["ὅτι",709803,7],["ἀπεδοκίμασεν",701451,2],["αὐτοὺς",702165,62],["κύριος",707996,4]],"Call ye them reprobate silver, because the Lord has rejected them."]]