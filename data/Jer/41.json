"],["10",[["καὶ",707031,7],["ἐπεστράφησαν",705278,99],["πάντες",710177,138],["οἱ",709436,136],["μεγιστᾶνες",708657,52],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["οἱ",709436,136],["εἰσελθόντες",704114,196],["ἐν",704639,0],["τῇ",709436,100],["διαθήκῃ",703456,1],["τοῦ",709436,20],["ἀποστεῖλαι",701592,106],["ἕκαστον",704133,27],["τὸν",709436,5],["παῖδα",709932,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἕκαστον",704133,27],["τὴν",709436,8],["παιδίσκην",709928,9],["αὐτοῦ",702165,102]],"Then all the nobles, and all the people who had entered into the covenant, [engaging] to set free every one his man-servant, and every one his maid, turned,"],["11",[["καὶ",707031,7],["ἔωσαν",703918,78],["αὐτοὺς",702165,62],["εἰς",704105,0],["παῖδας",709932,57],["καὶ",707031,7],["παιδίσκας",709928,39]],"and gave them over to be men-servants and maid-servants."],["12",[["καὶ",707031,7],["ἐγενήθη",703104,37],["λόγος",708236,4],["κυρίου",707996,18],["πρὸς",710844,0],["Ιερεμιαν",706611,6],["λέγων",708124,72]],"And the word of the Lord came to Jeremias, saying,"],["13",[["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ἐγὼ",704018,164],["ἐθέμην",712849,161],["διαθήκην",703456,9],["πρὸς",710844,0],["τοὺς",709436,58],["πατέρας",710189,57],["ὑμῶν",713091,145],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ᾗ",709781,108],["ἐξειλάμην",704838,161],["αὐτοὺς",702165,62],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["ἐξ",704132,0],["οἴκου",709516,18],["δουλείας",703813,17],["λέγων",708124,72]],"Thus saith the Lord; I made a covenant with your fathers in the day wherein I took them out of the land of Egypt, out of the house of bondage, saying,"],["14",[["ὅταν",709801,28],["πληρωθῇ",710543,384],["ἓξ",704828,59],["ἔτη",705543,42],["ἀποστελεῖς",701592,166],["τὸν",709436,5],["ἀδελφόν",700249,6],["σου",711945,133],["τὸν",709436,5],["Εβραῖον",703933,6],["ὃς",709781,213],["πραθήσεταί",710480,134],["σοι",711925,159],["καὶ",707031,7],["ἐργᾶταί",705383,117],["σοι",711925,159],["ἓξ",704828,59],["ἔτη",705543,42],["καὶ",707031,7],["ἐξαποστελεῖς",704872,166],["αὐτὸν",702165,85],["ἐλεύθερον",704428,27],["καὶ",707031,7],["οὐκ",709805,28],["ἤκουσάν",700587,150],["μου",709032,133],["καὶ",707031,7],["οὐκ",709805,28],["ἔκλιναν",707738,150],["τὸ",709436,24],["οὖς",709852,25],["αὐτῶν",702165,40]],"When six years are accomplished, thou shalt set free thy brother the Hebrew, who shall be sold to thee: for he shall serve thee six years, and [then] thou shalt let him go free: but they hearkened not to me, and inclined not their ear."],["15",[["καὶ",707031,7],["ἐπέστρεψαν",705278,150],["σήμερον",711751,28],["ποιῆσαι",710582,106],["τὸ",709436,24],["εὐθὲς",705596,46],["πρὸ",710747,0],["ὀφθαλμῶν",709870,81],["μου",709032,133],["τοῦ",709436,20],["καλέσαι",707084,106],["ἄφεσιν",702199,9],["ἕκαστον",704133,27],["τοῦ",709436,35],["πλησίον",710547,28],["αὐτοῦ",702165,102],["καὶ",707031,7],["συνετέλεσαν",712510,150],["διαθήκην",703456,9],["κατὰ",707200,0],["πρόσωπόν",710986,25],["μου",709032,133],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["οὗ",709781,48],["ἐπεκλήθη",705153,37],["τὸ",709436,34],["ὄνομά",709666,15],["μου",709032,133],["ἐπ᾿",705080,0],["αὐτῷ",702165,50]],"And this day they turned to do that which was right in my sight, to proclaim every one the release of his neighbour; and they had concluded a covenant before me, in the house whereon my name is called."],["16",[["καὶ",707031,7],["ἐπεστρέψατε",705278,265],["καὶ",707031,7],["ἐβεβηλώσατε",702614,265],["τὸ",709436,24],["ὄνομά",709666,25],["μου",709032,133],["τοῦ",709436,20],["ἐπιστρέψαι",705278,106],["ἕκαστον",704133,27],["τὸν",709436,5],["παῖδα",709932,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἕκαστον",704133,27],["τὴν",709436,8],["παιδίσκην",709928,9],["αὐτοῦ",702165,102],["οὓς",709781,298],["ἐξαπεστείλατε",704872,265],["ἐλευθέρους",704428,60],["τῇ",709436,100],["ψυχῇ",714070,1],["αὐτῶν",702165,40],["ὑμῖν",713084,90],["εἰς",704105,0],["παῖδας",709932,57],["καὶ",707031,7],["παιδίσκας",709928,39]],"But ye turned and profaned my name, to bring back every one his servant, and every one his handmaid, whom ye had sent forth free [and] at their own disposal, to be to you men-servants and maid-servants."],["17",[["διὰ",703417,0],["τοῦτο",709858,129],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["ὑμεῖς",713081,219],["οὐκ",709805,28],["ἠκούσατέ",700587,265],["μου",709032,133],["τοῦ",709436,20],["καλέσαι",707084,106],["ἄφεσιν",702199,9],["ἕκαστος",704133,14],["πρὸς",710844,0],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["καλῶ",707084,157],["ἄφεσιν",702199,9],["ὑμῖν",713084,90],["εἰς",704105,0],["μάχαιραν",708593,9],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["θάνατον",706096,6],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["λιμὸν",708210,6],["καὶ",707031,7],["δώσω",703654,165],["ὑμᾶς",713080,194],["εἰς",704105,0],["διασπορὰν",703585,9],["πάσαις",710177,291],["ταῖς",709436,75],["βασιλείαις",702577,76],["τῆς",709436,16],["γῆς",703083,17]],"Therefore thus said the Lord; Ye have not hearkened to me, to proclaim a release every one to his neighbour: behold, I proclaim a release to you, to the sword, and to the pestilence, and to the famine; and I will give you up to dispersion [among] all the kingdoms of the earth."],["18",[["καὶ",707031,7],["δώσω",703654,165],["τοὺς",709436,58],["ἄνδρας",701150,57],["τοὺς",709436,58],["παρεληλυθότας",710141,277],["τὴν",709436,8],["διαθήκην",703456,9],["μου",709032,133],["τοὺς",709436,58],["μὴ",708851,28],["στήσαντας",706846,454],["τὴν",709436,8],["διαθήκην",703456,9],["μου",709032,133],["ἣν",709781,131],["ἐποίησαν",710582,150],["κατὰ",707200,0],["πρόσωπόν",710986,25],["μου",709032,133],["τὸν",709436,5],["μόσχον",709029,6],["ὃν",709781,112],["ἐποίησαν",710582,150],["ἐργάζεσθαι",705383,110],["αὐτῷ",702165,50]],"And I will give the men that have transgressed my covenant, who have not kept my covenant, which they made before me, the calf which they prepared to sacrifice with it,"],["19",[["τοὺς",709436,58],["ἄρχοντας",701862,57],["Ιουδα",706768,18],["καὶ",707031,7],["τοὺς",709436,58],["δυνάστας",703844,57],["καὶ",707031,7],["τοὺς",709436,58],["ἱερεῖς",706614,57],["καὶ",707031,7],["τὸν",709436,5],["λαόν",708094,6]],"the princes of Juda, and the men in power, and the priests, and the people;"],["20",[["καὶ",707031,7],["δώσω",703654,165],["αὐτοὺς",702165,62],["τοῖς",709436,147],["ἐχθροῖς",705779,148],["αὐτῶν",702165,40],["καὶ",707031,7],["ἔσται",704093,93],["τὰ",709436,63],["θνησιμαῖα",706277,195],["αὐτῶν",702165,40],["βρῶσις",702825,12],["τοῖς",709436,95],["πετεινοῖς",710439,94],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["τοῖς",709436,95],["θηρίοις",706252,96],["τῆς",709436,16],["γῆς",703083,17]],"I will even give them to their enemies, and their carcases shall be food for the birds of the sky and for the wild beasts of the earth."],["21",[["καὶ",707031,7],["τὸν",709436,5],["Σεδεκιαν",711618,6],["βασιλέα",702580,6],["τῆς",709436,16],["Ιουδαίας",706769,17],["καὶ",707031,7],["τοὺς",709436,58],["ἄρχοντας",701862,57],["αὐτῶν",702165,40],["δώσω",703654,165],["εἰς",704105,0],["χεῖρας",713787,39],["ἐχθρῶν",705779,81],["αὐτῶν",702165,40],["καὶ",707031,7],["δύναμις",703839,12],["βασιλέως",702580,18],["Βαβυλῶνος",702352,17],["τοῖς",709436,147],["ἀποτρέχουσιν",701623,197],["ἀπ᾿",701425,0],["αὐτῶν",702165,40]],"And I will give Sedekias king of Judea, and their princes, into the hands of their enemies, and the host of the king of Babylon [shall come upon] them that run away from them."],["22",[["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["συντάσσω",712508,157],["φησὶν",713437,91],["κύριος",707996,4],["καὶ",707031,7],["ἐπιστρέψω",705278,165],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104],["καὶ",707031,7],["πολεμήσουσιν",710601,218],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["καὶ",707031,7],["λήμψονται",7080