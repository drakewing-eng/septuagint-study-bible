105,0],["χεῖρας",713787,39],["αὐτοῦ",702165,102],["δοθήσῃ",703654,364],["καὶ",707031,7],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["σου",711945,133],["τοὺς",709436,58],["ὀφθαλμοὺς",709870,57],["αὐτοῦ",702165,102],["ὄψονται",709725,135],["καὶ",707031,7],["τὸ",709436,34],["στόμα",712125,15],["αὐτοῦ",702165,102],["μετὰ",708780,0],["τοῦ",709436,20],["στόματός",712125,21],["σου",711945,133],["λαλήσει",708071,127],["καὶ",707031,7],["εἰς",704105,0],["Βαβυλῶνα",702352,9],["εἰσελεύσῃ",704114,123]],"and thou shalt not escape out of his hand, but shalt certainly be taken, and shalt be given into his hands; and thine eyes shall see his eyes, and thou shalt enter into Babylon."],["4",[["ἀλλὰ",700680,7],["ἄκουσον",700587,176],["τὸν",709436,5],["λόγον",708236,6],["κυρίου",707996,18],["Σεδεκια",711618,153],["βασιλεῦ",702580,153],["Ιουδα",706768,18],["οὕτως",709859,28],["λέγει",708124,91],["κύριος",707996,4]],"But hear the word of the Lord, O Sedekias king of Juda; Thus saith the Lord,"],["5",[["ἐν",704639,0],["εἰρήνῃ",704098,1],["ἀποθανῇ",701461,123],["καὶ",707031,7],["ὡς",714148,7],["ἔκλαυσαν",707703,150],["τοὺς",709436,58],["πατέρας",710189,57],["σου",711945,133],["τοὺς",709436,58],["βασιλεύσαντας",702581,454],["πρότερόν",710991,28],["σου",711945,133],["κλαύσονται",707703,135],["καὶ",707031,7],["σὲ",711598,163],["καὶ",707031,7],["ὦ",714081,88],["αδων",700300,4],["κόψονταί",707829,135],["σε",711598,163],["ὅτι",709803,7],["λόγον",708236,6],["ἐγὼ",704018,164],["ἐλάλησα",708071,155],["εἶπεν",705373,2],["κύριος",707996,4]],"Thou shalt die in peace: and as they wept for thy fathers that reigned before thee, they shall weep also for thee, [saying], Ah lord! and they shall lament for thee down to the grave: for I have spoken the word, said the Lord."],["6",[["καὶ",707031,7],["ἐλάλησεν",708071,2],["Ιερεμιας",706611,4],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["Σεδεκιαν",711618,6],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["ἐν",704639,