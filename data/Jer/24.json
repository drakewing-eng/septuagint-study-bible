[["1",[["ἔδειξέν",703314,2],["μοι",708974,159],["κύριος",707996,4],["δύο",703849,59],["καλάθους",707077,57],["σύκων",712254,65],["κειμένους",707595,236],["κατὰ",707200,0],["πρόσωπον",710986,25],["ναοῦ",709191,18],["κυρίου",707996,18],["μετὰ",708780,0],["τὸ",709436,24],["ἀποικίσαι",701464,106],["Ναβουχοδονοσορ",709149,6],["βασιλέα",702580,6],["Βαβυλῶνος",702352,17],["τὸν",709436,5],["Ιεχονιαν",706691,6],["υἱὸν",713075,6],["Ιωακιμ",706887,18],["βασιλέα",702580,6],["Ιουδα",706768,18],["καὶ",707031,7],["τοὺς",709436,58],["ἄρχοντας",701862,57],["καὶ",707031,7],["τοὺς",709436,58],["τεχνίτας",712832,57],["καὶ",707031,7],["τοὺς",709436,58],["δεσμώτας",703375,57],["καὶ",707031,7],["τοὺς",709436,58],["πλουσίους",710560,60],["ἐξ",704132,0],["Ιερουσαλημ",706644,17],["καὶ",707031,7],["ἤγαγεν",700209,2],["αὐτοὺς",702165,62],["εἰς",704105,0],["Βαβυλῶνα",702352,9]],"The Lord shewed me two baskets of figs, lying in front of the temple of the Lord, after Nabuchodonosor king of Babylon had carried captive Jechonias son of Joakim king of Juda, and the princes, and the artificers, and the prisoners, and the rich men out of Jerusalem, and had brought them to Babylon."],["2",[["ὁ",709436,3],["κάλαθος",707077,4],["ὁ",709436,3],["εἷς",704106,14],["σύκων",712254,65],["χρηστῶν",713958,198],["σφόδρα",712586,28],["ὡς",714148,7],["τὰ",709436,63],["σῦκα",712255,783],["τὰ",709436,63],["πρόιμα",711023,195],["καὶ",707031,7],["ὁ",709436,3],["κάλαθος",707077,4],["ὁ",709436,3],["ἕτερος",705535,14],["σύκων",712254,65],["πονηρῶν",710660,198],["σφόδρα",712586,28],["ἃ",709781,371],["οὐ",709805,28],["βρωθήσεται",702722,134],["ἀπὸ",701425,0],["πονηρίας",710659,17],["αὐτῶν",702165,70]],"The one basket was [full] of very good figs, as the early figs; and the other basket was [full] of very bad figs, which could not be eaten, for their badness."],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["τί",712867,126],["σὺ",712181,164],["ὁρᾷς",709725,154],["Ιερεμια",706611,153],["καὶ",707031,7],["εἶπα",705373,155],["σῦκα",712255,42],["τὰ",709436,63],["χρηστὰ",713958,195],["χρηστὰ",713958,195],["λίαν",708184,28],["καὶ",707031,7],["τὰ",709436,63],["πονηρὰ",710660,195],["πονηρὰ",710660,195],["λίαν",708184,28],["ἃ",709781,371],["οὐ",709805,28],["βρωθήσεται",702722,134],["ἀπὸ",701425,0],["πονηρίας",710659,17],["αὐτῶν",702165,70]],"And the Lord said to me, What seest thou, Jeremias? and I said, Figs; the good figs, very good; and the bad, very bad, which cannot be eaten, for their badness."],["4",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72]],"And the word of the Lord came to me, saying,"],["5",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ὡς",714148,7],["τὰ",709436,41],["σῦκα",712255,42],["τὰ",709436,41],["χρηστὰ",713958,68],["ταῦτα",709858,71],["οὕτως",709859,28],["ἐπιγνώσομαι",705104,181],["τοὺς",709436,58],["ἀποικισθέντας",701464,460],["Ιουδα",706768,18],["οὓς",709781,298],["ἐξαπέσταλκα",704872,89],["ἐκ",704132,0],["τοῦ",709436,35],["τόπου",712903,18],["τούτου",709858,102],["εἰς",704105,0],["γῆν",703083,9],["Χαλδαίων",713678,81],["εἰς",704105,0],["ἀγαθά",700106,68]],"Thus saith the Lord, the God of Israel; As these good figs, so will I acknowledge the Jews that have been carried away captive, whom I have sent forth out of this place into the land of the Chaldeans for good."],["6",[["καὶ",707031,7],["στηριῶ",712098,165],["τοὺς",709436,58],["ὀφθαλμούς",709870,57],["μου",709032,133],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["εἰς",704105,0],["ἀγαθὰ",700106,68],["καὶ",707031,7],["ἀποκαταστήσω",701470,165],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104],["εἰς",704105,0],["ἀγαθὰ",700106,68],["καὶ",707031,7],["ἀνοικοδομήσω",701187,165],["αὐτοὺς",702165,62],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["καθελῶ",706982,207],["καὶ",707031,7],["καταφυτεύσω",707487,165],["αὐτοὺς",702165,62],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἐκτίλω",704332,157]],"And I will fix mine eyes upon them for good, and I will restore them into this land for good: and I will build them up, and not pull them down; and I will plant them, and not pluck them up."],["7",[["καὶ",707031,7],["δώσω",703654,165],["αὐτοῖς",702165,151],["καρδίαν",707141,9],["τοῦ",709436,20],["εἰδέναι",709492,115],["αὐτοὺς",702165,62],["ἐμὲ",704555,163],["ὅτι",709803,7],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["καὶ",707031,7],["ἔσονταί",704093,135],["μοι",708974,159],["εἰς",704105,0],["λαόν",708094,6],["καὶ",707031,7],["ἐγὼ",704018,164],["ἔσομαι",704093,181],["αὐτοῖς",702165,151],["εἰς",704105,0],["θεόν",706192,6],["ὅτι",709803,7],["ἐπιστραφήσονται",705278,144],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ἐξ",704132,0],["ὅλης",709597,82],["τῆς",709436,16],["καρδίας",707141,17],["αὐτῶν",702165,40]],"And I will give them a heart to know me, that I am the Lord: and they shall be to me a people, and I will be to them a God: for they shall turn to me with all their heart."],["8",[["καὶ",707031,7],["ὡς",714148,7],["τὰ",709436,41],["σῦκα",712255,42],["τὰ",709436,41],["πονηρά",710660,68],["ἃ",709781,69],["οὐ",709805,28],["βρωθήσεται",702722,134],["ἀπὸ",701425,0],["πονηρίας",710659,17],["αὐτῶν",702165,70],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["οὕτως",709859,28],["παραδώσω",710014,165],["τὸν",709436,5],["Σεδεκιαν",711618,6],["βασιλέα",702580,6],["Ιουδα",706768,18],["καὶ",707031,7],["τοὺς",709436,58],["μεγιστᾶνας",708657,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὸ",709436,24],["κατάλοιπον",707317,46],["Ιερουσαλημ",706644,17],["τοὺς",709436,58],["ὑπολελειμμένους",713212,360],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ταύτῃ",709858,105],["καὶ",707031,7],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["ἐν",704639,0],["Αἰγύπτῳ",700401,1]],"And as the bad figs, which cannot be eaten, for their badness; thus saith the Lord, So will I deliver Sedekias king of Juda, and his nobles, and the remnant of Jerusalem, them that are left in this land, and the dwellers in Egypt."],["9",[["καὶ",707031,7],["δώσω",703654,165],["αὐτοὺς",702165,62],["εἰς",704105,0],["διασκορπισμὸν",703580,6],["εἰς",704105,0],["πάσας",710177,119],["τὰς",709436,38],["βασιλείας",702577,39],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἔσονται",704093,135],["εἰς",704105,0],["ὀνειδισμὸν",709657,6],["καὶ",707031,7],["εἰς",704105,0],["παραβολὴν",710003,9],["καὶ",707031,7],["εἰς",704105,0],["μῖσος",708947,25],["καὶ",707031,7],["εἰς",704105,0],["κατάραν",707395,9],["ἐν",704639,0],["παντὶ",710177,30],["τόπῳ",712903,114],["οὗ",709806,28],["ἐξῶσα",704985,155],["αὐτοὺς",702165,62],["ἐκεῖ",704181,28]],"And I will cause them to be dispersed into all the kingdoms of the earth, and they shall be for a reproach, and a proverb, and an [object of] hatred, and a curse, in every place whither I have driven them out."],["10",[["καὶ",707031,7],["ἀποστελῶ",701592,165],["εἰς",704105,0],["αὐτοὺς",702165,62],["τὸν",709436,5],["λιμὸν",708210,6],["καὶ",707031,7],["τὸν",709436,5],["θάνατον",706096,6],["καὶ",707031,7],["τὴν",709436,8],["μάχαιραν",708593,9],["ἕως",705792,7],["ἂν",700900,11],["ἐκλίπωσιν",704237,234],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["ἧς",709781,167],["ἔδωκα",703654,155],["αὐτοῖς",702165,151]],"And I will send against them famine, and pestilence, and the sword, until they are consumed from off the land which I gave them."]]