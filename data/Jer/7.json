1,7],["ἤλθετε",705453,265],["καὶ",707031,7],["ἔστητε",706846,265],["ἐνώπιον",704823,0],["ἐμοῦ",704580,133],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["οὗ",709806,28],["ἐπικέκληται",705153,187],["τὸ",709436,34],["ὄνομά",709666,15],["μου",709032,133],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["καὶ",707031,7],["εἴπατε",705373,265],["ἀπεσχήμεθα",701225,580],["τοῦ",709436,20],["μὴ",708851,28],["ποιεῖν",710582,55],["πάντα",710177,68],["τὰ",709436,41],["βδελύγματα",702604,42],["ταῦτα",709858,71]],"so that it is evil with you; yet have ye come, and stood before me in the house, whereon my name is called, and ye have said, We have refrained from doing all these abominations."],["11",[["μὴ",708851,28],["σπήλαιον",712012,15],["λῃστῶν",708181,81],["ὁ",709436,3],["οἶκός",709516,4],["μου",709032,133],["οὗ",709806,28],["ἐπικέκληται",705153,187],["τὸ",709436,24],["ὄνομά",709666,25],["μου",709032,133],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["ἐκεῖ",704181,28],["ἐνώπιον",704823,0],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐγὼ",704018,164],["ἰδοὺ",706497,88],["ἑώρακα",709725,89],["λέγει",708124,91],["κύριος",707996,4]],"Is my house, whereon my name is called, a den of robbers in your eyes? And, behold, I have seen [it], saith the Lord."],["12",[["ὅτι",709803,7],["πορεύθητε",710667,372],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["μου",709032,133],["τὸν",709436,5],["ἐν",704639,0],["Σηλωμ",711739,1],["οὗ",709806,28],["κατεσκήνωσα",707423,155],["τὸ",709436,24],["ὄνομά",709666,25],["μου",709032,133],["ἐκεῖ",704181,28],["ἔμπροσθεν",704618,28],["καὶ",707031,7],["ἴδετε",709725,74],["ἃ",709781,69],["ἐποίησα",710582,155],["αὐτῷ",702165,50],["ἀπὸ",701425,0],["προσώπου",710986,21],["κακίας",707054,17],["λαοῦ",708094,18],["μου",709032,133],["Ισραηλ",706839,18]],"For go ye to my place which is in Selo, where I caused my name to dwell before, and see what I did to it because of the wickedness of my people Israel."],["13",[["καὶ",707031,7],["νῦν",709384,28],["ἀνθ᾿",701227,0],["ὧν",709781,25