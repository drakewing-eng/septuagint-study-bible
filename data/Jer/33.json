[["1",[["ἐν",704639,0],["ἀρχῇ",701836,1],["βασιλέως",702580,18],["Ιωακιμ",706887,18],["υἱοῦ",713075,18],["Ιωσια",706949,18],["ἐγενήθη",703104,37],["ὁ",709436,3],["λόγος",708236,4],["οὗτος",709858,121],["παρὰ",709995,0],["κυρίου",707996,18]],"In the beginning of the Reign of King Joakim Son of Josias there came this Word from the Lord."],["2",[["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["στῆθι",706846,176],["ἐν",704639,0],["αὐλῇ",702137,1],["οἴκου",709516,18],["κυρίου",707996,18],["καὶ",707031,7],["χρηματιεῖς",713949,166],["ἅπασι",701362,230],["τοῖς",709436,147],["Ιουδαίοις",706772,148],["καὶ",707031,7],["πᾶσι",710177,230],["τοῖς",709436,147],["ἐρχομένοις",705453,341],["προσκυνεῖν",710925,55],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18],["ἅπαντας",701362,60],["τοὺς",709436,58],["λόγους",708236,57],["οὓς",709781,298],["συνέταξά",712508,155],["σοι",711925,159],["αὐτοῖς",702165,151],["χρηματίσαι",713949,106],["μὴ",708851,28],["ἀφέλῃς",702177,175],["ῥῆμα",711246,25]],"Thus said the Lord; Stand in the court of the Lord's house, and thou shalt declare to all the Jews, and to all that come to worship in the house of the Lord, all the words which I commanded thee to speak to them; abate not one word."],["3",[["ἴσως",706860,28],["ἀκούσονται",700587,135],["καὶ",707031,7],["ἀποστραφήσονται",701598,144],["ἕκαστος",704133,14],["ἀπὸ",701425,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["αὐτοῦ",702165,102],["τῆς",709436,16],["πονηρᾶς",710660,82],["καὶ",707031,7],["παύσομαι",710202,181],["ἀπὸ",701425,0],["τῶν",709436,80],["κακῶν",707066,169],["ὧν",709781,252],["ἐγὼ",704018,164],["λογίζομαι",708232,254],["τοῦ",709436,20],["ποιῆσαι",710582,106],["αὐτοῖς",702165,151],["ἕνεκεν",704709,0],["τῶν",709436,43],["πονηρῶν",710660,83],["ἐπιτηδευμάτων",705301,44],["αὐτῶν",702165,40]],"Peradventure they will hear, and turn every one from his evil way: then I will cease from the evils which I purpose to do to them, because of their evil practices."],["4",[["καὶ",707031,7],["ἐρεῖς",705415,166],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["ἐὰν",703912,7],["μὴ",708851,28],["ἀκούσητέ",700587,125],["μου",709032,133],["τοῦ",709436,20],["πορεύεσθαι",710667,110],["ἐν",704639,0],["τοῖς",709436,147],["νομίμοις",709340,230],["μου",709032,133],["οἷς",709781,311],["ἔδωκα",703654,155],["κατὰ",707200,0],["πρόσωπον",710986,25],["ὑμῶν",713091,145]],"And thou shalt say, Thus said the Lord; If ye will not hearken to me, to walk in my statutes which I set before you,"],["5",[["εἰσακούειν",704108,55],["τῶν",709436,80],["λόγων",708236,81],["τῶν",709436,80],["παίδων",709932,81],["μου",709032,133],["τῶν",709436,80],["προφητῶν",711009,81],["οὓς",709781,298],["ἐγὼ",704018,164],["ἀποστέλλω",701592,157],["πρὸς",710844,0],["ὑμᾶς",713080,194],["ὄρθρου",709745,18],["καὶ",707031,7],["ἀπέστειλα",701592,155],["καὶ",707031,7],["οὐκ",709805,28],["εἰσηκούσατέ",704108,265],["μου",709032,133]],"to hearken to the words of my servants the prophets, whom I send to you early in the morning; yea, I sent them, but ye hearkened not to me;"],["6",[["καὶ",707031,7],["δώσω",703654,165],["τὸν",709436,5],["οἶκον",709516,6],["τοῦτον",709858,85],["ὥσπερ",714163,28],["Σηλωμ",711739,1],["καὶ",707031,7],["τὴν",709436,8],["πόλιν",710612,9],["δώσω",703654,165],["εἰς",704105,0],["κατάραν",707395,9],["πᾶσιν",710177,94],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["πάσης",710177,82],["τῆς",709436,16],["γῆς",703083,17]],"then will I make this house as Selo, and I will make [this] city a curse to all the nations of all the earth."],["7",[["καὶ",707031,7],["ἤκουσαν",700587,150],["οἱ",709436,136],["ἱερεῖς",706614,52],["καὶ",707031,7],["οἱ",709436,136],["ψευδοπροφῆται",714043,52],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["τοῦ",709436,35],["Ιερεμιου",706611,18],["λαλοῦντος",708071,152],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18]],"And the priests, and the false prophets, and all the people