[["1",[["τῇ",709436,100],["Μωαβ",709085,1],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["οὐαὶ",709807,88],["ἐπὶ",705080,0],["Ναβαυ",709137,227],["ὅτι",709803,7],["ὤλετο",709584,23],["ἐλήμφθη",708076,37],["Καριαθαιμ",707146,120],["ᾐσχύνθη",700485,37],["Αμαθ",700753,4],["καὶ",707031,7],["ἡττήθη",706040,37]],"Thus has the Lord said concerning Moab, Woe to Nabau! for it has perished: Cariathaim is taken: Amath and Agath are put to shame."],["2",[["οὐκ",709805,28],["ἔστιν",704093,91],["ἔτι",705538,28],["ἰατρεία",706456,12],["Μωαβ",709085,18],["ἀγαυρίαμα",700131,15],["ἐν",704639,0],["Εσεβων",705473,111],["ἐλογίσαντο",708232,189],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["κακά",707066,68],["ἐκόψαμεν",707829,289],["αὐτὴν",702165,104],["ἀπὸ",701425,0],["ἔθνους",704068,21],["καὶ",707031,7],["παῦσιν",710201,9],["παύσεται",710202,93],["ὄπισθέν",709691,28],["σου",711945,133],["βαδιεῖται",702367,93],["μάχαιρα",708593,12]],"There is no longer any healing for Moab, [nor] glorying in Esebon: he has devised evils against her: we have cut her off from [being] a nation, and she shall be completely still: after thee shall go a sword;"],["3",[["ὅτι",709803,7],["φωνὴ",713640,12],["κεκραγότων",707868,387],["ἐξ",704132,0],["Ωρωναιμ",714143,118],["ὄλεθρος",709563,4],["καὶ",707031,7],["σύντριμμα",712521,25],["μέγα",708653,46]],"for [there is] a voice of [men] crying out of Oronaim, destruction and great ruin."],["4",[["συνετρίβη",712520,37],["Μωαβ",709085,4],["ἀναγγείλατε",700921,74],["εἰς",704105,0],["Ζογορα",705887,227]],"Moab is ruined, proclaim [it] to Zogora:"],["5",[["ὅτι",709803,7],["ἐπλήσθη",710532,37],["Αλαωθ",700637,120],["ἐν",704639,0],["κλαυθμῷ",707705,114],["ἀναβήσεται",700905,93],["κλαίων",707703,72],["ἐν",704639,0],["ὁδῷ",709458,1],["Ωρωναιμ",714143,118],["κραυγὴν",707886,9],["συντρίμματος",712521,21],["ἠκούσατε",700587,265]],"for Aloth is filled with weeping: one shall go up weeping by the way of Oronaim; ye have heard a cry of destruction."],["6",[["φεύγετε",713433,335],["καὶ",707031,7],["σώσατε",712627,74],["τὰς",709436,38],["ψυχὰς",714070,39],["ὑμῶν",713091,145],["καὶ",707031,7],["ἔσεσθε",704093,124],["ὥσπερ",714163,28],["ὄνος",709671,4],["ἄγριος",700191,14],["ἐν",704639,0],["ἐρήμῳ",705420,1]],"Flee ye, and save your lives, and ye shall be as a wild ass in the desert."],["7",[["ἐπειδὴ",705056,7],["ἐπεποίθεις",710221,508],["ἐν",704639,0],["ὀχυρώμασίν",709891,96],["σου",711945,133],["καὶ",707031,7],["σὺ",712181,164],["συλλημφθήσῃ",712262,364],["καὶ",707031,7],["ἐξελεύσεται",704909,93],["Χαμως",713707,120],["ἐν",704639,0],["ἀποικίᾳ",701463,1],["οἱ",709436,136],["ἱερεῖς",706614,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["οἱ",709436,136],["ἄρχοντες",701862,52],["αὐτοῦ",702165,102],["ἅμα",700745,28]],"Since thou hast trusted in thy strong-hold, therefore thou shalt be taken: and Chamos shall go forth into captivity, and his priests, and his princes together."],["8",[["καὶ",707031,7],["ἥξει",705956,127],["ὄλεθρος",709563,4],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["πόλιν",710612,9],["καὶ",707031,7],["πόλις",710612,12],["οὐ",709805,28],["μὴ",708851,28],["σωθῇ",712627,384],["καὶ",707031,7],["ἀπολεῖται",701513,93],["ὁ",709436,3],["αὐλών",702141,81],["καὶ",707031,7],["ἐξολεθρευθήσεται",704956,134],["ἡ",709436,10],["πεδινή",710214,29],["καθὼς",707030,28],["εἶπεν",705373,2],["κύριος",707996,4]],"And destruction shall come upon every city, it shall by no means escape; the valley also shall perish, and the plain country shall be completely destroyed, as the Lord has said."],["9",[["δότε",703654,74],["σημεῖα",711748,42],["τῇ",709436,100],["Μωαβ",709085,1],["ὅτι",709803,7],["ἁφῇ",702202,1],["ἀναφθήσεται",701084,134],["καὶ",707031,7],["πᾶσαι",710177,192],["αἱ",709436,190],["πόλεις",710612,191],["αὐτῆς",702165,86],["εἰς",704105,0],["ἄβατον",700023,27],["ἔσονται",704093,135],["πόθεν",710580,28],["ἔνοικος",704774,14],["αὐτῇ",702165,105]],"Set marks upon Moab, for she shall be touched with a plague-spot, and all her cities shall become desolate; whence [shall there be] an inhabitant for her?"],["10",[["ἐπικατάρατος",705159,14],["ὁ",709436,3],["ποιῶν",710582,72],["τὰ",709436,41],["ἔργα",705396,42],["κυρίου",707996,18],["ἀμελῶς",700806,28],["ἐξαίρων",704839,72],["μάχαιραν",708593,9],["αὐτοῦ",702165,102],["ἀφ᾿",701425,0],["αἵματος",700442,21]],"Cursed is the man that does the works of the Lord carelessly, keeping back his sword from blood."],["11",[["ἀνεπαύσατο",701027,23],["Μωαβ",709085,4],["ἐκ",704132,0],["παιδαρίου",709923,21],["καὶ",707031,7],["πεποιθὼς",710221,270],["ἦν",704093,13],["ἐπὶ",705080,0],["τῇ",709436,100],["δόξῃ",703791,1],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐνέχεεν",704014,13],["ἐξ",704132,0],["ἀγγείου",700138,21],["εἰς",704105,0],["ἀγγεῖον",700138,25],["καὶ",707031,7],["εἰς",704105,0],["ἀποικισμὸν",701465,6],["οὐκ",709805,28],["ᾤχετο",709539,19],["διὰ",703417,0],["τοῦτο",709858,129],["ἔστη",706846,2],["γεῦμα",703072,15],["αὐτοῦ",702165,102],["ἐν",704639,0],["αὐτῷ",702165,50],["καὶ",707031,7],["ὀσμὴ",709786,12],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐξέλιπεν",704237,2]],"Moab has been at ease from a child, and trusted in his glory; he has not poured out [his liquor] from vessel to vessel, and has not gone into banishment, therefore his taste remained in him, and his smell departed not."],["12",[["διὰ",703417,0],["τοῦτο",709858,129],["ἰδοὺ",706497,88],["ἡμέραι",705984,191],["ἔρχονται",705453,269],["φησὶν",713437,91],["κύριος",707996,4],["καὶ",707031,7],["ἀποστελῶ",701592,165],["αὐτῷ",702165,50],["κλίνοντας",707738,235],["καὶ",707031,7],["κλινοῦσιν",707738,218],["αὐτὸν",702165,85],["καὶ",707031,7],["τὰ",709436,41],["σκεύη",711844,42],["αὐτοῦ",702165,102],["λεπτυνοῦσιν",708154,218],["καὶ",707031,7],["τὰ",709436,41],["κέρατα",707625,42],["αὐτοῦ",702165,102],["συγκόψουσιν",712230,218]],"Therefore, behold, his days come, saith the Lord, when I shall send upon him bad leaders, and they shall lead him astray, and they shall utterly break in pieces his possessions, and shall cut his horns asunder."],["13",[["καὶ",707031,7],["καταισχυνθήσεται",707257,134],["Μωαβ",709085,12],["ἀπὸ",701425,0],["Χαμως",713707,118],["ὥσπερ",714163,28],["κατῃσχύνθη",707257,37],["οἶκος",709516,4],["Ισραηλ",706839,18],["ἀπὸ",701425,0],["Βαιθηλ",702412,118],["ἐλπίδος",704530,17],["αὐτῶν",702165,40],["πεποιθότες",710221,268],["ἐπ᾿",705080,0],["αὐτοῖς",702165,151]],"And Moab shall be ashamed of Chamos, as the house of Israel was ashamed of Bæthel their hope, having trusted in them."],["14",[["πῶς",711121,28],["ἐρεῖτε",705415,337],["ἰσχυροί",706855,138],["ἐσμεν",704093,243],["καὶ",707031,7],["ἄνθρωπος",701163,4],["ἰσχύων",706858,65],["εἰς",704105,0],["τὰ",709436,41],["πολεμικά",710602,68]],"How will ye say, We are strong, and men strong for war?"],["15",[["ὤλετο",709584,23],["Μωαβ",709085,18],["πόλις",710612,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐκλεκτοὶ",704240,138],["νεανίσκοι",709232,52],["αὐτοῦ",702165,102],["κατέβησαν",707202,150],["εἰς",704105,0],["σφαγήν",712568,9]],"Moab is ruined, [even] his city, and his choice young men have gone down to slaughter."],["16",[["ἐγγὺς",703948,28],["ἡμέρα",705984,12],["Μωαβ",709085,17],["ἐλθεῖν",705453,106],["καὶ",707031,7],["πονηρία",710659,12],["αὐτοῦ",702165,102],["ταχεῖα",712750,29],["σφόδρα",712586,28]],"The day of Moab is near at hand, and his iniquity moves swiftly [to vengeance]."],["17",[["κινήσατε",707679,74],["αὐτῷ",702165,50],["πάντες",710177,138],["κυκλόθεν",707956,28],["αὐτοῦ",702165,102],["πάντες",710177,138],["εἰδότες",704075,196],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["εἴπατε",705373,265],["πῶς",711121,28],["συνετρίβη",712520,37],["βακτηρία",702459,12],["εὐκλεής",705617,29],["ῥάβδος",711135,12],["μεγαλώματος",708648,21]],"Shake [the head] at him, all ye that are round about him; all [of you] utter his name; say ye, How is the glorious staff broken to pieces, the rod of magnificence!"],["18",[["κατάβηθι",707202,176],["ἀπὸ",701425,0],["δόξης",703791,17],["καὶ",707031,7],["κάθισον",707006,176],["ἐν",704639,0],["ὑγρασίᾳ",713062,1],["καθημένη",707000,211],["Δαιβων",703247,120],["ἐκτρίβητε",704345,394],["ὅτι",709803,7],["ὤλετο",709584,23],["Μωαβ",709085,120],["ἀνέβη",700905,2],["εἰς",704105,0],["σὲ",711598,163],["λυμαινόμενος",708270,122],["ὀχύρωμά",709891,15],["σου",711945,133]],"Come down from [thy] glory, and sit down in a damp place: Dæbon shall be broken, because Moab is destroyed: there has gone up against thee one to ravage thy strong-hold."],["19",[["ἐφ᾿",705080,0],["ὁδοῦ",709458,17],["στῆθι",706846,176],["καὶ",707031,7],["ἔπιδε",705057,176],["καθημένη",707000,211],["ἐν",704639,0],["Αροηρ",701787,1],["καὶ",707031,7],["ἐρώτησον",705459,176],["φεύγοντα",713433,183],["καὶ",707031,7],["σῳζόμενον",712627,212],["καὶ",707031,7],["εἰπόν",705373,150],["τί",712867,126],["ἐγένετο",703104,23]],"Stand by the way, and look, thou that dwellest in Arer; and ask him that is fleeing, and him that escapes, and say, What has happened?"],["20",[["κατῃσχύνθη",707257,37],["Μωαβ",709085,12],["ὅτι",709803,7],["συνετρίβη",712520,37],["ὀλόλυξον",709593,176],["καὶ",707031,7],["κέκραξον",707868,656],["ἀνάγγειλον",700921,176],["ἐν",704639,0],["Αρνων",701783,111],["ὅτι",709803,7],["ὤλετο",709584,23],["Μωαβ",709085,4]],"Moab is put to shame, because he is broken: howl and cry; proclaim in Arnon, that Moab has perished."],["21",[["καὶ",707031,7],["κρίσις",707908,12],["ἔρχεται",705453,117],["εἰς",704105,0],["γῆν",703083,9],["τοῦ",709436,35],["Μισωρ",708949,18],["ἐπὶ",705080,0],["Χαιλων",713661,227],["καὶ",707031,7],["ἐπὶ",705080,0],["Ιασσα",706452,227],["καὶ",707031,7],["ἐπὶ",705080,0],["Μωφαθ",709115,227]],"And judgment is coming against the land of Misor, upon Chelon, and Rephas, and Mophas,"],["22",[["καὶ",707031,7],["ἐπὶ",705080,0],["Δαιβων",703247,227],["καὶ",707031,7],["ἐπὶ",705080,0],["Ναβαυ",709137,227],["καὶ",707031,7],["ἐπ᾿",705080,0],["οἶκον",709516,6],["Δεβλαθαιμ",703309,118]],"and upon Dæbon, and upon Nabau, and upon the house of Dæthlathaim,"],["23",[["καὶ",707031,7],["ἐπὶ",705080,0],["Καριαθαιμ",707146,227],["καὶ",707031,7],["ἐπ᾿",705080,0],["οἶκον",709516,6],["Γαμωλ",702959,118],["καὶ",707031,7],["ἐπ᾿",705080,0],["οἶκον",709516,6],["Μαων",708615,118]],"and upon Cariathaim, and upon the house of Gæmol, and upon the house of Maon,"],["24",[["καὶ",707031,7],["ἐπὶ",705080,0],["Καριωθ",707155,227],["καὶ",707031,7],["ἐπὶ",705080,0],["Βοσορ",702768,227],["καὶ",707031,7],["ἐπὶ",705080,0],["πάσας",710177,119],["τὰς",709436,38],["πόλεις",710612,191],["Μωαβ",709085,118],["τὰς",709436,38],["πόρρω",710680,28],["καὶ",707031,7],["τὰς",709436,38],["ἐγγύς",703948,28]],"and upon Carioth, and upon Bosor, and upon all the cities of Moab, far and near."],["25",[["κατεάχθη",707232,37],["κέρας",707625,15],["Μωαβ",709085,18],["καὶ",707031,7],["τὸ",709436,24],["ἐπίχειρον",705336,25],["αὐτοῦ",702165,102],["συνετρίβη",712520,37]],"The horn of Moab is broken, and his arm is crushed."],["26",[["μεθύσατε",708676,74],["αὐτόν",702165,85],["ὅτι",709803,7],["ἐπὶ",705080,0],["κύριον",707996,6],["ἐμεγαλύνθη",708647,37],["καὶ",707031,7],["ἐπικρούσει",705181,127],["Μωαβ",709085,4],["ἐν",704639,0],["χειρὶ",713787,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔσται",704093,93],["εἰς",704105,0],["γέλωτα",703032,6],["καὶ",707031,28],["αὐτός",702165,121]],"Make ye him drunk; for he has magnified himself against the Lord: and Moab shall clap with his hand, and shall be also himself a laughing-stock."],["27",[["καὶ",707031,7],["εἰ",704071,7],["μὴ",708851,28],["εἰς",704105,0],["γελοιασμὸν",703027,6],["ἦν",704093,13],["σοι",711925,159],["Ισραηλ",706839,153],["εἰ",704071,7],["ἐν",704639,0],["κλοπαῖς",707742,76],["σου",711945,133],["εὑρέθη",705676,37],["ὅτι",709803,7],["ἐπολέμεις",710601,363],["αὐτόν",702165,85]],"For surely Israel was to thee a laughing-stock, and was found among thy thefts, because thou didst fight against him."],["28",[["κατέλιπον",707305,150],["τὰς",709436,38],["πόλεις",710612,39],["καὶ",707031,7],["ᾤκησαν",709499,150],["ἐν",704639,0],["πέτραις",710443,76],["οἱ",709436,136],["κατοικοῦντες",707534,146],["Μωαβ",709085,9],["ἐγενήθησαν",703104,99],["ὡς",714148,7],["περιστεραὶ",710391,191],["νοσσεύουσαι",709359,306],["ἐν",704639,0],["πέτραις",710443,76],["στόματι",712125,54],["βοθύνου",702750,18]],"The inhabitants of Moab have left the cities, and dwelt in rocks; they have become as doves nestling in rocks, at the mouth of a cave."],["29",[["ἤκουσα",700587,155],["ὕβριν",713051,9],["Μωαβ",709085,17],["ὕβρισεν",713050,2],["λίαν",708184,28],["ὕβριν",713051,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὑπερηφανίαν",713138,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὑψώθη",713289,37],["ἡ",709436,10],["καρδία",707141,12],["αὐτοῦ",702165,102]],"And I have heard of the pride of Moab, he has greatly heightened his pride and his haughtiness, and his heart has been lifted up."],["30",[["ἐγὼ",704018,164],["δὲ",703303,11],["ἔγνων",703105,155],["ἔργα",705396,42],["αὐτοῦ",702165,102],["οὐχὶ",709862,28],["τὸ",709436,24],["ἱκανὸν",706710,46],["αὐτοῦ",702165,102],["οὐχ",709805,28],["οὕτως",709859,28],["ἐποίησεν",710582,2]],"But I know his works: is it not enough for him? has he not done thus?"],["31",[["διὰ",703417,0],["τοῦτο",709858,129],["ἐπὶ",705080,0],["Μωαβ",709085,9],["ὀλολύζετε",709593,335],["πάντοθεν",709984,28],["βοήσατε",702743,74],["ἐπ᾿",705080,0],["ἄνδρας",701150,57],["Κιραδας",707685,18],["αὐχμοῦ",702170,18]],"Therefore howl ye for Moab on all sides; cry out against the shorn men [in] a gloomy place. I will weep for thee,"],["32",[["ὡς",714148,7],["κλαυθμὸν",707705,6],["Ιαζηρ",706382,4],["ἀποκλαύσομαί",701482,181],["σοι",711925,159],["ἄμπελος",700870,12],["Σεβημα",711607,118],["κλήματά",707720,42],["σου",711945,133],["διῆλθεν",703673,2],["θάλασσαν",706069,9],["Ιαζηρ",706382,120],["ἥψαντο",701654,189],["ἐπὶ",705080,0],["ὀπώραν",709717,9],["σου",711945,133],["ἐπὶ",705080,0],["τρυγηταῖς",712997,148],["σου",711945,133],["ὄλεθρος",709563,4],["ἐπέπεσεν",705225,2]],"O vine of Aserema, as with the weeping of Jazer: thy branches are gone over the sea, they reached the cities of Jazer: destruction has come upon thy fruits, [and] upon thy grape-gatherers."],["33",[["συνεψήσθη",712371,37],["χαρμοσύνη",713747,29],["καὶ",707031,7],["εὐφροσύνη",705717,12],["ἐκ",704132,0],["τῆς",709436,16],["Μωαβίτιδος",709089,17],["καὶ",707031,7],["οἶνος",709530,4],["ἦν",704093,13],["ἐπὶ",705080,0],["ληνοῖς",708176,76],["σου",711945,133],["πρωὶ",711021,28],["οὐκ",709805,28],["ἐπάτησαν",710187,150],["οὐδὲ",709816,7],["δείλης",703324,82],["οὐκ",709805,28],["ἐποίησαν",710582,150],["αιδαδ",700402,227]],"Joy and gladness have been utterly swept off the land of Moab: and [though] there was wine in thy presses, in the morning they trod it not, neither in the evening did they raise the cry of joy."],["34",[["ἀπὸ",701425,0],["κραυγῆς",707886,17],["Εσεβων",705473,118],["ἕως",705792,0],["Ελεαλη",704409,118],["αἱ",709436,190],["πόλεις",710612,191],["αὐτῶν",702165,40],["ἔδωκαν",703654,150],["φωνὴν",713640,9],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["Ζογορ",705886,118],["ἕως",705792,0],["Ωρωναιμ",714143,228],["καὶ",707031,7],["Αγλαθσαλισια",700169,118],["ὅτι",709803,7],["καὶ",707031,28],["τὸ",709436,34],["ὕδωρ",713071,15],["Νεβριμ",709235,228],["εἰς",704105,0],["κατάκαυμα",707265,25],["ἔσται",704093,93]],"From the cry of Esebon even to Ætam their cities uttered their voice, from Zogor to Oronaim, and their tidings [as] a heifer of three years old, for the water also of Nebrin shall be dried up."],["35",[["καὶ",707031,7],["ἀπολῶ",701513,165],["τὸν",709436,5],["Μωαβ",709085,6],["φησὶν",713437,91],["κύριος",707996,4],["ἀναβαίνοντα",700905,183],["ἐπὶ",705080,0],["βωμὸν",702840,6],["καὶ",707031,7],["θυμιῶντα",706332,183],["θεοῖς",706192,148],["αὐτοῦ",702165,102]],"And I will destroy Moab, saith the Lord, as he comes up to the altar, and burns incense to his gods."],["36",[["διὰ",703417,0],["τοῦτο",709858,129],["καρδία",707141,12],["μου",709032,133],["Μωαβ",709085,153],["ὥσπερ",714163,28],["αὐλοὶ",702139,52],["βομβήσουσιν",702757,218],["καρδία",707141,12],["μου",709032,133],["ἐπ᾿",705080,0],["ἀνθρώπους",701163,57],["Κιραδας",707685,118],["ὥσπερ",714163,28],["αὐλὸς",702139,4],["βομβήσει",702757,127],["διὰ",703417,0],["τοῦτο",709858,129],["ἃ",709781,69],["περιεποιήσατο",710367,23],["ἀπώλετο",701513,23],["ἀπὸ",701425,0],["ἀνθρώπου",701163,18]],"Therefore the heart of Moab shall sound as pipes, my heart shall sound as a pipe for the shorn men; forasmuch as what [every] man has gained has perished from him."],["37",[["πᾶσαν",710177,36],["κεφαλὴν",707639,9],["ἐν",704639,0],["παντὶ",710177,30],["τόπῳ",712903,114],["ξυρήσονται",709431,135],["καὶ",707031,7],["πᾶς",710177,14],["πώγων",711115,4],["ξυρηθήσεται",709431,134],["καὶ",707031,7],["πᾶσαι",710177,192],["χεῖρες",713787,191],["κόψονται",707829,135],["καὶ",707031,7],["ἐπὶ",705080,0],["πάσης",710177,82],["ὀσφύος",709800,17],["σάκκος",711386,4]],"They shall all have their heads shaved in every place, and every beard shall be shaved; and all hands shall beat [the breasts], and on all loins shall be sackcloth."],["38",[["καὶ",707031,7],["ἐπὶ",705080,0],["πάντων",710177,83],["τῶν",709436,43],["δωμάτων",703896,44],["Μωαβ",709085,17],["καὶ",707031,7],["ἐπὶ",705080,0],["πλατείαις",710509,291],["αὐτῆς",702165,86],["ὅτι",709803,7],["συνέτριψα",712520,155],["τὸν",709436,5],["Μωαβ",709085,227],["φησὶν",713437,91],["κύριος",707996,4],["ὡς",714148,7],["ἀγγεῖον",700138,25],["οὗ",709781,48],["οὐκ",709805,28],["ἔστιν",704093,91],["χρεία",713938,12],["αὐτοῦ",702165,102]],"And on all the housetops of Moab, and in his streets [shall be mourning]: for I have broken [him], saith the Lord, as a vessel, which is useless."],["39",[["πῶς",711121,28],["κατήλλαξεν",707315,2],["πῶς",711121,28],["ἔστρεψεν",712160,2],["νῶτον",709403,25],["Μωαβ",709085,4],["ᾐσχύνθη",700485,37],["καὶ",707031,7],["ἐγένετο",703104,23],["Μωαβ",709085,12],["εἰς",704105,0],["γέλωτα",703032,6],["καὶ",707031,7],["ἐγκότημα",703986,25],["πᾶσιν",710177,230],["τοῖς",709436,147],["κύκλῳ",707959,114],["αὐτῆς",702165,86]],"How has he changed! how has Moab turned [his] back! Moab is put to shame, and become a laughing-stock, and an object of anger to all that are round about him."],["40",[["ὅτι",709803,7],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4]],"For thus said the Lord;"],["41",[["ἐλήμφθη",708076,37],["Ακκαριωθ",700548,120],["καὶ",707031,7],["τὰ",709436,41],["ὀχυρώματα",709891,42],["συνελήμφθη",712262,37]],"Carioth is taken, and the strong-holds have been taken together."],["42",[["καὶ",707031,7],["ἀπολεῖται",701513,93],["Μωαβ",709085,12],["ἀπὸ",701425,0],["ὄχλου",709884,18],["ὅτι",709803,7],["ἐπὶ",705080,0],["τὸν",709436,5],["κύριον",707996,6],["ἐμεγαλύνθη",708647,37]],"And Moab shall perish from being a multitude, because he has magnified himself against the Lord."],["43",[["παγὶς",709910,12],["καὶ",707031,7],["φόβος",713534,4],["καὶ",707031,7],["βόθυνος",702750,4],["ἐπὶ",705080,0],["σοί",711925,159],["καθήμενος",707000,122],["Μωαβ",709085,18]],"A snare, and fear, and the pit, are upon thee, O inhabitant of Moab."],["44",[["ὁ",709436,3],["φεύγων",713433,72],["ἀπὸ",701425,0],["προσώπου",710986,21],["τοῦ",709436,35],["φόβου",713534,18],["ἐμπεσεῖται",704593,93],["εἰς",704105,0],["τὸν",709436,5],["βόθυνον",702750,6],["καὶ",707031,7],["ὁ",709436,3],["ἀναβαίνων",700905,72],["ἐκ",704132,0],["τοῦ",709436,35],["βοθύνου",702750,18],["συλλημφθήσεται",712262,134],["ἐν",704639,0],["τῇ",709436,100],["παγίδι",709910,1],["ὅτι",709803,7],["ἐπάξω",704994,165],["ταῦτα",709858,71],["ἐπὶ",705080,0],["Μωαβ",709085,9],["ἐν",704639,0],["ἐνιαυτῷ",704745,114],["ἐπισκέψεως",705252,17],["αὐτῆς",702165,86]],"He that flees from the terror shall fall into the pit, and he that comes up out of the pit shall even be taken in the snare: for I will bring these things upon Moab in the year of their visitation."]]