018,164],["ἐκτίλλω",704332,157]],"say thou to him, Thus saith the Lord; Behold, I pull down those whom I have built up, and I pluck up those whom I have planted."],["35",[["καὶ",707031,7],["σὺ",712181,164],["ζητεῖς",705879,154],["σεαυτῷ",711599,50],["μεγάλα",708653,68],["μὴ",708851,28],["ζητήσῃς",705879,175],["ὅτι",709803,7],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐπάγω",704994,157],["κακὰ",707066,68],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["σάρκα",711537,9],["λέγει",708124,91],["κύριος",707996,4],["καὶ",707031,7],["δώσω",703654,165],["τὴν",709436,8],["ψυχήν",714070,9],["σου",711945,133],["εἰς",704105,0],["εὕρεμα",705671,25],["ἐν",704639,0],["παντὶ",710177,30],["τόπῳ",712903,114],["οὗ",709781,48],["ἐὰν",703912,7],["βαδίσῃς",702367,175],["ἐκεῖ",704181,28]],"And wilt thou seek great things for thyself? seek [them] not: for, behold, I bring evil upon all flesh, saith the Lord: but I will give [to thee] thy life for a spoil in every place whither thou shalt go."]]