[["1",[["ὁ",709436,3],["λόγος",708236,4],["ὁ",709436,3],["γενόμενος",703104,248],["παρὰ",709995,0],["κυρίου",707996,18],["πρὸς",710844,0],["Ιερεμιαν",706611,6],["λέγων",708124,72]],"The word that came to Jeremias from the Lord, saying,"],["2",[["ἀκούσατε",700587,74],["τοὺς",709436,58],["λόγους",708236,57],["τῆς",709436,16],["διαθήκης",703456,17],["ταύτης",709858,86],["καὶ",707031,7],["λαλήσεις",708071,166],["πρὸς",710844,0],["ἄνδρας",701150,57],["Ιουδα",706768,18],["καὶ",707031,7],["πρὸς",710844,0],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["Ιερουσαλημ",706644,9]],"Hear ye the words of this covenant, and thou shalt speak to the men of Juda, and to the dwellers in Jerusalem;"],["3",[["καὶ",707031,7],["ἐρεῖς",705415,166],["πρὸς",710844,0],["αὐτούς",702165,62],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ἐπικατάρατος",705159,14],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ὃς",709781,213],["οὐκ",709805,28],["ἀκούσεται",700587,93],["τῶν",709436,80],["λόγων",708236,81],["τῆς",709436,16],["διαθήκης",703456,17],["ταύτης",709858,86]],"and thou shalt say to them, Thus saith the Lord God of Israel, Cursed is the man, who shall not hearken to the words of this covenant,"],["4",[["ἧς",709781,167],["ἐνετειλάμην",704791,161],["τοῖς",709436,147],["πατράσιν",710189,148],["ὑμῶν",713091,145],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["ᾗ",709781,108],["ἀνήγαγον",700933,155],["αὐτοὺς",702165,62],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["ἐκ",704132,0],["καμίνου",707113,18],["τῆς",709436,16],["σιδηρᾶς",711771,82],["λέγων",708124,72],["ἀκούσατε",700587,74],["τῆς",709436,16],["φωνῆς",713640,17],["μου",709032,133],["καὶ",707031,7],["ποιήσατε",710582,74],["πάντα",710177,68],["ὅσα",709788,68],["ἐὰν",703912,7],["ἐντείλωμαι",704791,410],["ὑμῖν",713084,90],["καὶ",707031,7],["ἔσεσθέ",704093,124],["μοι",708974,159],["εἰς",704105,0],["λαόν",708094,6],["καὶ",707031,7],["ἐγὼ",704018,164],["ἔσομαι",704093,181],["ὑμῖν",713084,90],["εἰς",704105,0],["θεόν",706192,6]],"which I commanded your fathers, in the day wherein I brought them up out of the land of Egypt, out of the iron furnace, saying, Hearken to my voice, and do all things that I shall command you; so shall ye be to me a people, and I will be to you a God;"],["5",[["ὅπως",709719,7],["στήσω",706846,207],["τὸν",709436,5],["ὅρκον",709753,6],["μου",709032,133],["ὃν",709781,112],["ὤμοσα",709620,155],["τοῖς",709436,147],["πατράσιν",710189,148],["ὑμῶν",713091,145],["τοῦ",709436,20],["δοῦναι",703654,106],["αὐτοῖς",702165,151],["γῆν",703083,9],["ῥέουσαν",711241,78],["γάλα",702919,25],["καὶ",707031,7],["μέλι",708700,25],["καθὼς",707030,28],["ἡ",709436,10],["ἡμέρα",705984,12],["αὕτη",709858,107],["καὶ",707031,7],["ἀπεκρίθην",701492,156],["καὶ",707031,7],["εἶπα",705373,155],["γένοιτο",703104,382],["κύριε",707996,153]],"that I may confirm mine oath, which I sware to your fathers, to give them a land flowing [with] milk and honey, as [it is] this day. Then I answered and said, So be it, O Lord."],["6",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["ἀνάγνωθι",700922,176],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["ἐν",704639,0],["πόλεσιν",710612,76],["Ιουδα",706768,18],["καὶ",707031,7],["ἔξωθεν",704984,28],["Ιερουσαλημ",706644,17],["λέγων",708124,72],["ἀκούσατε",700587,74],["τοὺς",709436,58],["λόγους",708236,57],["τῆς",709436,16],["διαθήκης",703456,17],["ταύτης",709858,86],["καὶ",707031,7],["ποιήσατε",710582,74],["αὐτούς",702165,62]],"And the Lord said to me, Read these words in the cities of Juda, and in the streets of Jerusalem, saying, Hear ye the words of this covenant, and do them."],["8",[["καὶ",707031,7],["οὐκ",709805,28],["ἐποίησαν",710582,150]],"But they did [them] not."],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["εὑρέθη",705676,37],["σύνδεσμος",712416,4],["ἐν",704639,0],["ἀνδράσιν",701150,148],["Ιουδα",706768,18],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["κατοικοῦσιν",707534,349],["Ιερουσαλημ",706644,9]],"And the Lord said to me, A conspiracy is found among the men of Juda, and among the dwellers in Jerusalem."],["10",[["ἐπεστράφησαν",705278,99],["ἐπὶ",705080,0],["τὰς",709436,38],["ἀδικίας",700271,39],["τῶν",709436,80],["πατέρων",710189,81],["αὐτῶν",702165,40],["τῶν",709436,80],["πρότερον",710991,28],["οἳ",709781,250],["οὐκ",709805,28],["ἤθελον",706176,137],["εἰσακοῦσαι",704108,106],["τῶν",709436,80],["λόγων",708236,81],["μου",709032,133],["καὶ",707031,7],["ἰδοὺ",706497,88],["αὐτοὶ",702165,201],["βαδίζουσιν",702367,197],["ὀπίσω",709697,0],["θεῶν",706192,81],["ἀλλοτρίων",700699,169],["τοῦ",709436,20],["δουλεύειν",703814,55],["αὐτοῖς",702165,151],["καὶ",707031,7],["διεσκέδασαν",703575,150],["οἶκος",709516,4],["Ισραηλ",706839,18],["καὶ",707031,7],["οἶκος",709516,4],["Ιουδα",706768,18],["τὴν",709436,8],["διαθήκην",703456,9],["μου",709032,133],["ἣν",709781,131],["διεθέμην",703609,161],["πρὸς",710844,0],["τοὺς",709436,58],["πατέρας",710189,57],["αὐτῶν",702165,40]],"They are turned [aside] to the iniquities of their fathers that were of old, who would not hearken to my words: and, behold, they go after strange gods, to serve them: and the house of Israel and the house of Juda have broken my covenant, which I made with their fathers."],["11",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐπάγω",704994,157],["ἐπὶ",705080,0],["τὸν",709436,5],["λαὸν",708094,6],["τοῦτον",709858,85],["κακά",707066,68],["ἐξ",704132,0],["ὧν",709781,252],["οὐ",709805,28],["δυνήσονται",703838,135],["ἐξελθεῖν",704909,106],["ἐξ",704132,0],["αὐτῶν",702165,40],["καὶ",707031,7],["κεκράξονται",707868,135],["πρός",710844,0],["με",708618,163],["καὶ",707031,7],["οὐκ",709805,28],["εἰσακούσομαι",704108,181],["αὐτῶν",702165,40]],"Therefore thus saith the Lord, Behold, I bring evils upon this people, out of which they shall not be able to come forth; and they shall presently cry to me, but I will not hearken to them."],["12",[["καὶ",707031,7],["πορεύσονται",710667,135],["πόλεις",710612,191],["Ιουδα",706768,18],["καὶ",707031,7],["οἱ",709436,136],["κατοικοῦντες",707534,146],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["κεκράξονται",707868,135],["πρὸς",710844,0],["τοὺς",709436,58],["θεούς",706192,57],["οἷς",709781,311],["αὐτοὶ",702165,201],["θυμιῶσιν",706332,197],["αὐτοῖς",702165,151],["μὴ",708851,28],["σώσουσιν",712627,218],["αὐτοὺς",702165,62],["ἐν",704639,0],["καιρῷ",707047,114],["τῶν",709436,80],["κακῶν",707066,169],["αὐτῶν",702165,40]],"And the cities of Juda and the dwellers in Jerusalem shall go, and cry to the gods to whom they burn incense; which shall not deliver them in the time of their troubles."],["13",[["ὅτι",709803,7],["κατ᾿",707200,0],["ἀριθμὸν",701744,6],["τῶν",709436,130],["πόλεών",710612,65],["σου",711945,133],["ἦσαν",704093,137],["θεοί",706192,52],["σου",711945,133],["Ιουδα",706768,153],["καὶ",707031,7],["κατ᾿",707200,0],["ἀριθμὸν",701744,6],["ἐξόδων",704948,65],["τῆς",709436,16],["Ιερουσαλημ",706644,17],["ἐτάξατε",712730,265],["βωμοὺς",702840,57],["θυμιᾶν",706332,55],["τῇ",709436,100],["Βααλ",702333,1]],"For according to the number of thy cities were thy gods, O Juda; and according to the number of the streets of Jerusalem have ye set up altars to burn incense to Baal."],["14",[["καὶ",707031,7],["σὺ",712181,164],["μὴ",708851,28],["προσεύχου",710893,253],["περὶ",710285,0],["τοῦ",709436,35],["λαοῦ",708094,18],["τούτου",709858,102],["καὶ",707031,7],["μὴ",708851,28],["ἀξίου",701309,253],["περὶ",710285,0],["αὐτῶν",702165,40],["ἐν",704639,0],["δεήσει",703311,1],["καὶ",707031,7],["προσευχῇ",710892,1],["ὅτι",709803,7],["οὐκ",709805,28],["εἰσακούσομαι",704108,181],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐν",704639,0],["ᾧ",709781,309],["ἐπικαλοῦνταί",705153,269],["με",708618,163],["ἐν",704639,0],["καιρῷ",707047,114],["κακώσεως",707075,17],["αὐτῶν",702165,40]],"And thou, pray not for this people, and intercede not for them in supplication and prayer: for I will not hear in the day in which they call upon me, in the day of their affliction."],["15",[["τί",712867,359],["ἡ",709436,10],["ἠγαπημένη",700120,203],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["μου",709032,133],["ἐποίησεν",710582,2],["βδέλυγμα",702604,25],["μὴ",708851,28],["εὐχαὶ",705726,191],["καὶ",707031,7],["κρέα",707889,64],["ἅγια",700159,195],["ἀφελοῦσιν",702177,218],["ἀπὸ",701425,0],["σοῦ",711945,133],["τὰς",709436,38],["κακίας",707054,39],["σου",711945,133],["ἢ",705924,7],["τούτοις",709858,151],["διαφεύξῃ",703623,123]],"Why has [my] beloved wrought abomination in my house? will prayers and holy offerings take away thy wickedness from thee, or shalt thou escape by these things?"],["16",[["ἐλαίαν",704377,9],["ὡραίαν",714132,36],["εὔσκιον",705690,36],["τῷ",709436,53],["εἴδει",704074,54],["ἐκάλεσεν",707084,2],["κύριος",707996,4],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["εἰς",704105,0],["φωνὴν",713640,9],["περιτομῆς",710404,17],["αὐτῆς",702165,86],["ἀνήφθη",701044,37],["πῦρ",711088,25],["ἐπ᾿",705080,0],["αὐτήν",702165,104],["μεγάλη",708653,29],["ἡ",709436,10],["θλῖψις",706276,12],["ἐπὶ",705080,0],["σέ",711598,163],["ἠχρεώθησαν",702311,99],["οἱ",709436,136],["κλάδοι",707702,52],["αὐτῆς",702165,86]],"The Lord called thy name a fair olive tree, of a goodly shade in appearance, at the noise of its being lopped, fire was kindled against it; great is the affliction [coming] upon thee: her branches are become good for nothing."],["17",[["καὶ",707031,7],["κύριος",707996,4],["ὁ",709436,3],["καταφυτεύσας",707487,182],["σε",711598,163],["ἐλάλησεν",708071,2],["ἐπὶ",705080,0],["σὲ",711598,163],["κακὰ",707066,68],["ἀντὶ",701227,0],["τῆς",709436,16],["κακίας",707054,17],["οἴκου",709516,18],["Ισραηλ",706839,18],["καὶ",707031,7],["οἴκου",709516,18],["Ιουδα",706768,18],["ὅτι",709803,7],["ἐποίησαν",710582,150],["ἑαυτοῖς",703917,151],["τοῦ",709436,20],["παροργίσαι",710167,106],["με",708618,163],["ἐν",704639,0],["τῷ",709436,53],["θυμιᾶν",706332,55],["αὐτοὺς",702165,62],["τῇ",709436,100],["Βααλ",702333,1]],"And the Lord that planted thee has pronounced evils against thee, because of the iniquity of the house of Israel and the house of Juda, whatsoever they have done against themselves to provoke me to anger by burning incense to Baal."],["18",[["κύριε",707996,153],["γνώρισόν",703135,176],["μοι",708974,159],["καὶ",707031,7],["γνώσομαι",703105,181],["τότε",712908,28],["εἶδον",709725,155],["τὰ",709436,41],["ἐπιτηδεύματα",705301,42],["αὐτῶν",702165,40]],"O Lord, teach me, and I shall know: then I saw their practices."],["19",[["ἐγὼ",704018,164],["δὲ",703303,11],["ὡς",714148,7],["ἀρνίον",701782,25],["ἄκακον",700512,46],["ἀγόμενον",700209,214],["τοῦ",709436,20],["θύεσθαι",706349,110],["οὐκ",709805,28],["ἔγνων",703105,155],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ἐλογίσαντο",708232,189],["λογισμὸν",708234,6],["πονηρὸν",710660,27],["λέγοντες",708124,146],["δεῦτε",703383,28],["καὶ",707031,7],["ἐμβάλωμεν",704547,79],["ξύλον",709427,25],["εἰς",704105,0],["τὸν",709436,5],["ἄρτον",701829,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐκτρίψωμεν",704345,79],["αὐτὸν",702165,85],["ἀπὸ",701425,0],["γῆς",703083,17],["ζώντων",705851,170],["καὶ",707031,7],["τὸ",709436,34],["ὄνομα",709666,15],["αὐτοῦ",702165,102],["οὐ",709805,28],["μὴ",708851,28],["μνησθῇ",708923,384],["ἔτι",705538,28]],"But I as an innocent lamb led to the slaughter, knew not: against me they devised an evil device, saying, Come and let us put wood into his bread, and let us utterly destroy him from off the land of the living, and let his name not be remembered any more."],["20",[["κύριε",707996,153],["κρίνων",707905,72],["δίκαια",703694,68],["δοκιμάζων",703776,72],["νεφροὺς",709282,57],["καὶ",707031,7],["καρδίας",707141,39],["ἴδοιμι",709725,346],["τὴν",709436,8],["παρὰ",709995,0],["σοῦ",711945,133],["ἐκδίκησιν",704175,9],["ἐξ",704132,0],["αὐτῶν",702165,40],["ὅτι",709803,7],["πρὸς",710844,0],["σὲ",711598,163],["ἀπεκάλυψα",701474,155],["τὸ",709436,24],["δικαίωμά",703697,25],["μου",709032,133]],"O Lord, that judgest righteously, trying the reins and hearts, let me see thy vengeance [taken] upon them, for to thee I have declared my cause."],["21",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἄνδρας",701150,57],["Αναθωθ",700953,65],["τοὺς",709436,58],["ζητοῦντας",705879,235],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["τοὺς",709436,58],["λέγοντας",708124,235],["οὐ",709805,28],["μὴ",708851,28],["προφητεύσῃς",711008,175],["ἐπὶ",705080,0],["τῷ",709436,53],["ὀνόματι",709666,54],["κυρίου",707996,18],["εἰ",704071,7],["δὲ",703303,11],["μή",708851,28],["ἀποθανῇ",701461,123],["ἐν",704639,0],["ταῖς",709436,75],["χερσὶν",713787,76],["ἡμῶν",705999,145]],"Therefore thus saith the Lord concerning the men of Anathoth, that seek my life, that say, Thou shalt not prophesy at all in the name of the Lord, but if thou dost, thou shalt die by our hands:"],["22",[["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐπισκέψομαι",705250,181],["ἐπ᾿",705080,0],["αὐτούς",702165,62],["οἱ",709436,136],["νεανίσκοι",709232,52],["αὐτῶν",702165,40],["ἐν",704639,0],["μαχαίρᾳ",708593,1],["ἀποθανοῦνται",701461,135],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτῶν",702165,40],["καὶ",707031,7],["αἱ",709436,190],["θυγατέρες",706320,191],["αὐτῶν",702165,40],["τελευτήσουσιν",712781,218],["ἐν",704639,0],["λιμῷ",708210,114]],"behold, I will visit them: their young men shall die by the sword; and their sons and their daughters shall die of famine:"],["23",[["καὶ",707031,7],["ἐγκατάλειμμα",703966,15],["οὐκ",709805,28],["ἔσται",704093,93],["αὐτῶν",702165,40],["ὅτι",709803,7],["ἐπάξω",704994,165],["κακὰ",707066,68],["ἐπὶ",705080,0],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["ἐν",704639,0],["Αναθωθ",700953,76],["ἐν",704639,0],["ἐνιαυτῷ",704745,114],["ἐπισκέψεως",705252,17],["αὐτῶν",702165,40]],"and there shall be no remnant [left] of them; for I will bring evil upon the dwellers in Anathoth, in the year of their visitation."]]