[["1",[["λόγος",708236,4],["κυρίου",707996,18],["ὃν",709781,112],["ἐλάλησεν",708071,2],["ἐπὶ",705080,0],["Βαβυλῶνα",702352,9]],"The Word of the Lord which He spoke against Babylon."],["2",[["ἀναγγείλατε",700921,74],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["καὶ",707031,7],["ἀκουστὰ",700584,68],["ποιήσατε",710582,74],["καὶ",707031,7],["μὴ",708851,28],["κρύψητε",707923,125],["εἴπατε",705373,265],["ἑάλωκεν",700673,171],["Βαβυλών",702352,12],["κατῃσχύνθη",707257,37],["Βῆλος",702697,12],["ἡ",709436,10],["ἀπτόητος",701653,29],["ἡ",709436,10],["τρυφερὰ",713006,29],["παρεδόθη",710014,37],["Μαρωδαχ",708529,12]],"Proclaim ye among the Gentiles, and cause the tidings to be heard, and suppress [them] not: say ye, Babylon is taken, Belus is confounded; the fearless, the luxurious Mærodach is delivered up."],["3",[["ὅτι",709803,7],["ἀνέβη",700905,2],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["ἔθνος",704068,25],["ἀπὸ",701425,0],["βορρᾶ",702765,18],["οὗτος",709858,121],["θήσει",712849,127],["τὴν",709436,8],["γῆν",703083,9],["αὐτῆς",702165,86],["εἰς",704105,0],["ἀφανισμόν",702183,6],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ὁ",709436,3],["κατοικῶν",707534,72],["ἐν",704639,0],["αὐτῇ",702165,105],["ἀπὸ",701425,0],["ἀνθρώπου",701163,18],["καὶ",707031,7],["ἕως",705792,0],["κτήνους",707934,21]],"For a nation has come up against her from the north, he shall utterly ravage her land, and there shall be none to dwell in it, neither man nor beast."],["4",[["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["ἥξουσιν",705956,218],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["αὐτοὶ",702165,201],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["Ιουδα",706768,18],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτό",702165,129],["βαδίζοντες",702367,146],["καὶ",707031,7],["κλαίοντες",707703,146],["πορεύσονται",710667,135],["τὸν",709436,5],["κύριον",707996,6],["θεὸν",706192,6],["αὐτῶν",702165,40],["ζητοῦντες",705879,146]],"In those days, and at that time, the children of Israel shall come, they and the children of Juda together; they shall proceed, weeping as they go, seeking the Lord their God."],["5",[["ἕως",705792,0],["Σιων",711816,17],["ἐρωτήσουσιν",705459,218],["τὴν",709436,8],["ὁδόν",709458,9],["ὧδε",714090,28],["γὰρ",702963,11],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτῶν",702165,40],["δώσουσιν",703654,218],["καὶ",707031,7],["ἥξουσιν",705956,218],["καὶ",707031,7],["καταφεύξονται",707472,135],["πρὸς",710844,0],["κύριον",707996,6],["τὸν",709436,5],["θεόν",706192,6],["διαθήκη",703456,12],["γὰρ",702963,11],["αἰώνιος",700505,29],["οὐκ",709805,28],["ἐπιλησθήσεται",705187,134]],"They shall ask the way till [they come to] Sion, for that way shall they set their face; and they shall come and flee for refuge to the Lord their God; for the everlasting covenant shall not be forgotten."],["6",[["πρόβατα",710768,64],["ἀπολωλότα",701513,586],["ἐγενήθη",703104,37],["ὁ",709436,3],["λαός",708094,4],["μου",709032,133],["οἱ",709436,136],["ποιμένες",710596,52],["αὐτῶν",702165,40],["ἐξῶσαν",704985,150],["αὐτούς",702165,62],["ἐπὶ",705080,0],["τὰ",709436,41],["ὄρη",709768,42],["ἀπεπλάνησαν",701547,150],["αὐτούς",702165,62],["ἐξ",704132,0],["ὄρους",709768,21],["ἐπὶ",705080,0],["βουνὸν",702797,6],["ᾤχοντο",709539,139],["ἐπελάθοντο",705187,189],["κοίτης",707781,17],["αὐτῶν",702165,40]],"My people have been lost sheep: their shepherds thrust them out, they caused them to wander on the mountains: they went from mountain to hill, they forgot their resting-place."],["7",[["πάντες",710177,138],["οἱ",709436,136],["εὑρίσκοντες",705676,146],["αὐτοὺς",702165,62],["κατανάλισκον",707338,137],["αὐτούς",702165,62],["οἱ",709436,136],["ἐχθροὶ",705779,52],["αὐτῶν",702165,40],["εἶπαν",705373,150],["μὴ",708851,28],["ἀνῶμεν",701117,233],["αὐτούς",702165,62],["ἀνθ᾿",701227,0],["ὧν",709781,252],["ἥμαρτον",700773,150],["τῷ",709436,113],["κυρίῳ",707996,114],["νομῇ",709337,1],["δικαιοσύνης",703695,17],["τῷ",709436,113],["συναγαγόντι",712375,350],["τοὺς",709436,58],["πατέρας",710189,57],["αὐτῶν",702165,40]],"All that found them consumed them: their enemies said, Let us not leave them alone, because they have sinned against the Lord: he that gathered their fathers [had] a pasture of righteousness."],["8",[["ἀπαλλοτριώθητε",701334,372],["ἐκ",704132,0],["μέσου",708768,116],["Βαβυλῶνος",702352,17],["καὶ",707031,7],["ἀπὸ",701425,0],["γῆς",703083,17],["Χαλδαίων",713678,81],["καὶ",707031,7],["ἐξέλθατε",704909,74],["καὶ",707031,7],["γένεσθε",703104,186],["ὥσπερ",714163,28],["δράκοντες",703822,52],["κατὰ",707200,0],["πρόσωπον",710986,25],["προβάτων",710768,44]],"Flee ye out of the midst of Babylon, and from the land of the Chaldeans, and go forth, and be as serpents before sleep."],["9",[["ὅτι",709803,7],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐγείρω",703949,157],["ἐπὶ",705080,0],["Βαβυλῶνα",702352,9],["συναγωγὰς",712376,39],["ἐθνῶν",704068,44],["ἐκ",704132,0],["γῆς",703083,17],["βορρᾶ",702765,18],["καὶ",707031,7],["παρατάξονται",710108,135],["αὐτῇ",702165,105],["ἐκεῖθεν",704182,28],["ἁλώσεται",700673,93],["ὡς",714148,7],["βολὶς",702756,12],["μαχητοῦ",708602,18],["συνετοῦ",712464,116],["οὐκ",709805,28],["ἐπιστρέψει",705278,127],["κενή",707612,29]],"For, behold, I stir up against Babylon the gatherings of nations out of the land of the north; and they shall set themselves in array against her: thence shall she be taken, as the dart of an expert warrior shall not return empty."],["10",[["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["Χαλδαία",713676,12],["εἰς",704105,0],["προνομήν",710827,9],["πάντες",710177,138],["οἱ",709436,136],["προνομεύοντες",710826,146],["αὐτὴν",702165,104],["ἐμπλησθήσονται",704592,144]],"And Chaldea shall be a spoil: all that spoil her shall be satisfied."],["11",[["ὅτι",709803,7],["ηὐφραίνεσθε",705715,501],["καὶ",707031,7],["κατεκαυχᾶσθε",707266,501],["διαρπάζοντες",703562,146],["τὴν",709436,8],["κληρονομίαν",707725,9],["μου",709032,133],["διότι",703734,7],["ἐσκιρτᾶτε",711856,399],["ὡς",714148,7],["βοΐδια",702751,64],["ἐν",704639,0],["βοτάνῃ",702772,1],["καὶ",707031,7],["ἐκερατίζετε",707628,399],["ὡς",714148,7],["ταῦροι",712734,52]],"Because ye rejoiced, and boasted, [while] plundering mine heritage; because ye exulted as calves in the grass, and pushed with the horn as bulls."],["12",[["ᾐσχύνθη",700485,37],["ἡ",709436,10],["μήτηρ",708892,12],["ὑμῶν",713091,145],["σφόδρα",712586,28],["μήτηρ",708892,12],["ἐπ᾿",705080,0],["ἀγαθὰ",700106,68],["ἐσχάτη",705519,29],["ἐθνῶν",704068,44],["ἔρημος",705420,12]],"Your mother is greatly ashamed; your mother that bore you for prosperity is confounded: [she is] the last of the nations, desolate,"],["13",[["ἀπὸ",701425,0],["ὀργῆς",709728,17],["κυρίου",707996,18],["οὐ",709805,28],["κατοικηθήσεται",707534,134],["καὶ",707031,7],["ἔσται",704093,93],["εἰς",704105,0],["ἀφανισμὸν",702183,6],["πᾶσα",710177,29],["καὶ",707031,7],["πᾶς",710177,14],["ὁ",709436,3],["διοδεύων",703715,72],["διὰ",703417,0],["Βαβυλῶνος",702352,17],["σκυθρωπάσει",711896,127],["καὶ",707031,7],["συριοῦσιν",712538,218],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["τὴν",709436,8],["πληγὴν",710527,9],["αὐτῆς",702165,86]],"by reason of the Lord's anger: it shall not be inhabited, but it shall be all a desolation; and every one that passes through Babylon shall scowl, and they shall hiss at all her plague."],["14",[["παρατάξασθε",710108,186],["ἐπὶ",705080,0],["Βαβυλῶνα",702352,9],["κύκλῳ",707959,114],["πάντες",710177,138],["τείνοντες",712754,146],["τόξον",712898,25],["τοξεύσατε",712896,74],["ἐπ᾿",705080,0],["αὐτήν",702165,104],["μὴ",708851,28],["φείσησθε",713406,142],["ἐπὶ",705080,0],["τοῖς",709436,147],["τοξεύμασιν",712895,148],["ὑμῶν",713091,145]],"Set yourselves in array against Babylon round about, all ye that bend the bow; shoot at her, spare not your arrows,"],["15",[["κατακροτήσατε",707290,74],["ἐπ᾿",705080,0],["αὐτήν",702165,104],["παρελύθησαν",710070,99],["αἱ",709436,190],["χεῖρες",713787,191],["αὐτῆς",702165,86],["ἔπεσαν",710481,150],["αἱ",709436,190],["ἐπάλξεις",705012,191],["αὐτῆς",702165,86],["καὶ",707031,7],["κατεσκάφη",707416,37],["τὸ",709436,24],["τεῖχος",712759,25],["αὐτῆς",702165,86],["ὅτι",709803,7],["ἐκδίκησις",704175,12],["παρὰ",709995,0],["θεοῦ",706192,18],["ἐστιν",704093,91],["ἐκδικεῖτε",704174,87],["ἐπ᾿",705080,0],["αὐτήν",702165,104],["καθὼς",707030,28],["ἐποίησεν",710582,2],["ποιήσατε",710582,74],["αὐτῇ",702165,105]],"and prevail against her: her hands are weakened, her bulwarks are fallen, and her wall is broken down: for it is vengeance from God: take vengeance upon her; as she has done, do to her."],["16",[["ἐξολεθρεύσατε",704956,74],["σπέρμα",712008,25],["ἐκ",704132,0],["Βαβυλῶνος",702352,17],["κατέχοντα",707526,183],["δρέπανον",703830,25],["ἐν",704639,0],["καιρῷ",707047,114],["θερισμοῦ",706208,18],["ἀπὸ",701425,0],["προσώπου",710986,21],["μαχαίρας",708593,39],["Ἑλληνικῆς",704517,118],["ἕκαστος",704133,14],["εἰς",704105,0],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["ἀποστρέψουσιν",701598,218],["καὶ",707031,7],["ἕκαστος",704133,14],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["αὐτοῦ",702165,102],["φεύξεται",713433,93]],"Utterly destroy seed out of Babylon, [and] him that holds a sickle in time of harvest: for fear of the Grecian sword, they shall return every one to his people, and every one shall flee to his own land."],["17",[["πρόβατον",710768,15],["πλανώμενον",710495,208],["Ισραηλ",706839,4],["λέοντες",708171,52],["ἐξῶσαν",704985,150],["αὐτόν",702165,85],["ὁ",709436,3],["πρῶτος",711041,140],["ἔφαγεν",713296,2],["αὐτὸν",702165,85],["βασιλεὺς",702580,4],["Ασσουρ",702001,18],["καὶ",707031,7],["οὗτος",709858,121],["ὕστερον",713273,28],["τὰ",709436,41],["ὀστᾶ",709792,42],["αὐτοῦ",702165,102],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,17]],"Israel is a wandering sheep; the lions have driven him out: the king of Assyria first devoured him, and afterward this king of Babylon [has gnawed] his bones."],["18",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐκδικῶ",704174,157],["ἐπὶ",705080,0],["τὸν",709436,5],["βασιλέα",702580,6],["Βαβυλῶνος",702352,17],["καὶ",707031,7],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["αὐτοῦ",702165,102],["καθὼς",707030,28],["ἐξεδίκησα",704174,155],["ἐπὶ",705080,0],["τὸν",709436,5],["βασιλέα",702580,6],["Ασσουρ",702001,18]],"Therefore thus saith the Lord; Behold, I [will] take vengeance on the king of Babylon, and upon his land, as I took vengeance on the king of Assyria."],["19",[["καὶ",707031,7],["ἀποκαταστήσω",701470,207],["τὸν",709436,5],["Ισραηλ",706839,6],["εἰς",704105,0],["τὴν",709436,8],["νομὴν",709337,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["νεμήσεται",709253,93],["ἐν",704639,0],["τῷ",709436,113],["Καρμήλῳ",707161,114],["καὶ",707031,7],["ἐν",704639,0],["ὄρει",709768,54],["Εφραιμ",705769,18],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["Γαλααδ",702920,114],["καὶ",707031,7],["πλησθήσεται",710532,134],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτοῦ",702165,102]],"And I will restore Israel to his pasture, and he shall feed on Carmel and on mount Ephraim and in Galaad, and his soul shall be satisfied."],["20",[["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["ζητήσουσιν",705879,218],["τὴν",709436,8],["ἀδικίαν",700271,9],["Ισραηλ",706839,18],["καὶ",707031,7],["οὐχ",709805,28],["ὑπάρξει",713104,127],["καὶ",707031,7],["τὰς",709436,38],["ἁμαρτίας",700775,39],["Ιουδα",706768,18],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["εὑρεθῶσιν",705676,272],["ὅτι",709803,7],["ἵλεως",706732,14],["ἔσομαι",704093,181],["τοῖς",709436,147],["ὑπολελειμμένοις",713212,521],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["λέγει",708124,91],["κύριος",707996,4]],"In those days, and at that time, they shall seek for the iniquity of Israel, and there shall be none; and for the sins of Juda, and they shall not be found: for I will be merciful to them that are left"],["21",[["πικρῶς",710476,28],["ἐπίβηθι",705082,176],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["καὶ",707031,7],["ἐπὶ",705080,0],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["ἐπ᾿",705080,0],["αὐτήν",702165,104],["ἐκδίκησον",704174,176],["μάχαιρα",708593,12],["καὶ",707031,7],["ἀφάνισον",702182,176],["λέγει",708124,91],["κύριος",707996,4],["καὶ",707031,7],["ποίει",710582,240],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἐντέλλομαί",704791,254],["σοι",711925,159]],"on the land, saith the Lord. Go up against it roughly, and against them that dwell on it: avenge, O sword, and destroy utterly, saith the Lord, and do according to all that I command thee."],["22",[["φωνὴ",713640,12],["πολέμου",710605,18],["καὶ",707031,7],["συντριβὴ",712519,12],["μεγάλη",708653,29],["ἐν",704639,0],["γῇ",703083,1],["Χαλδαίων",713678,81]],"A sound of war, and great destruction in the land of the Chaldeans!"],["23",[["πῶς",711121,28],["συνεκλάσθη",712215,37],["καὶ",707031,7],["συνετρίβη",712520,37],["ἡ",709436,10],["σφῦρα",712592,12],["πάσης",710177,82],["τῆς",709436,16],["γῆς",703083,17],["πῶς",711121,28],["ἐγενήθη",703104,37],["εἰς",704105,0],["ἀφανισμὸν",702183,6],["Βαβυλὼν",702352,12],["ἐν",704639,0],["ἔθνεσιν",704068,96]],"How is the hammer of the whole earth broken and crushed! How is Babylon become a desolation among the nations!"],["24",[["ἐπιθήσονταί",705304,135],["σοι",711925,159],["καὶ",707031,7],["ἁλώσῃ",700673,123],["ὦ",714081,88],["Βαβυλών",702352,258],["καὶ",707031,7],["οὐ",709805,28],["γνώσῃ",703105,123],["εὑρέθης",705676,168],["καὶ",707031,7],["ἐλήμφθης",708076,168],["ὅτι",709803,7],["τῷ",709436,113],["κυρίῳ",707996,114],["ἀντέστης",701154,162]],"They shall come upon thee, and thou shalt not know it, Babylon, that thou wilt even be taken captive: thou art found and taken, because thou didst resist the Lord."],["25",[["ἤνοιξεν",701186,2],["κύριος",707996,4],["τὸν",709436,5],["θησαυρὸν",706258,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐξήνεγκεν",704356,2],["τὰ",709436,41],["σκεύη",711844,42],["ὀργῆς",709728,17],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ἔργον",705396,15],["τῷ",709436,113],["κυρίῳ",707996,114],["θεῷ",706192,114],["ἐν",704639,0],["γῇ",703083,1],["Χαλδαίων",713678,81]],"The Lord has opened his treasury, and brought forth the weapons of his anger: for the Lord God [has] a work in the land of the Chaldeans."],["26",[["ὅτι",709803,7],["ἐληλύθασιν",705453,353],["οἱ",709436,136],["καιροὶ",707047,52],["αὐτῆς",702165,86],["ἀνοίξατε",701186,74],["τὰς",709436,38],["ἀποθήκας",701458,39],["αὐτῆς",702165,86],["ἐρευνήσατε",705412,74],["αὐτὴν",702165,104],["ὡς",714148,7],["σπήλαιον",712012,25],["καὶ",707031,7],["ἐξολεθρεύσατε",704956,74],["αὐτήν",702165,104],["μὴ",708851,28],["γενέσθω",703104,315],["αὐτῆς",702165,86],["κατάλειμμα",707304,25]],"For her times are come: open ye her storehouses: search her as a cave, and utterly destroy her: let there be no remnant of her."],["27",[["ἀναξηράνατε",701020,74],["αὐτῆς",702165,86],["πάντας",710177,60],["τοὺς",709436,58],["καρπούς",707169,57],["καὶ",707031,7],["καταβήτωσαν",707202,264],["εἰς",704105,0],["σφαγήν",712568,9],["οὐαὶ",709807,88],["αὐτοῖς",702165,151],["ὅτι",709803,7],["ἥκει",705956,91],["ἡ",709436,10],["ἡμέρα",705984,12],["αὐτῶν",702165,40],["καὶ",707031,7],["καιρὸς",707047,4],["ἐκδικήσεως",704175,17],["αὐτῶν",702165,40]],"Dry ye up all her fruits, and let them go down to the slaughter: woe to them! for their day is come, and the time of their retribution."],["28",[["φωνὴ",713640,12],["φευγόντων",713433,170],["καὶ",707031,7],["ἀνασῳζομένων",701064,299],["ἐκ",704132,0],["γῆς",703083,17],["Βαβυλῶνος",702352,17],["τοῦ",709436,20],["ἀναγγεῖλαι",700921,106],["εἰς",704105,0],["Σιων",711816,9],["τὴν",709436,8],["ἐκδίκησιν",704175,9],["παρὰ",709995,0],["κυρίου",707996,18],["θεοῦ",706192,18],["ἡμῶν",705999,145]],"A voice of men fleeing and escaping from the land of Babylon, to declare to Sion the vengeance [that comes] from the Lord our God."],["29",[["παραγγείλατε",710004,74],["ἐπὶ",705080,0],["Βαβυλῶνα",702352,9],["πολλοῖς",710646,230],["παντὶ",710177,30],["ἐντείνοντι",704790,379],["τόξον",712898,25],["παρεμβάλετε",710132,74],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["κυκλόθεν",707956,28],["μὴ",708851,28],["ἔστω",704093,31],["αὐτῆς",702165,86],["ἀνασῳζόμενος",701064,122],["ἀνταπόδοτε",701215,74],["αὐτῇ",702165,105],["κατὰ",707200,0],["τὰ",709436,41],["ἔργα",705396,42],["αὐτῆς",702165,86],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἐποίησεν",710582,2],["ποιήσατε",710582,74],["αὐτῇ",702165,105],["ὅτι",709803,7],["πρὸς",710844,0],["τὸν",709436,5],["κύριον",707996,6],["ἀντέστη",701154,2],["θεὸν",706192,6],["ἅγιον",700159,27],["τοῦ",709436,35],["Ισραηλ",706839,18]],"Summon many against Babylon, [even] every one that bends the bow: camp against her round about; let no one of her [people] escape: render to her according to her works; according to all that she has done, do to her: for she has resisted the Lord, the Holy God of Israel."],["30",[["διὰ",703417,0],["τοῦτο",709858,129],["πεσοῦνται",710481,135],["οἱ",709436,136],["νεανίσκοι",709232,52],["αὐτῆς",702165,86],["ἐν",704639,0],["ταῖς",709436,75],["πλατείαις",710509,291],["αὐτῆς",702165,86],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["ἄνδρες",701150,52],["οἱ",709436,136],["πολεμισταὶ",710604,52],["αὐτῆς",702165,86],["ῥιφήσονται",711267,144],["εἶπεν",705373,2],["κύριος",707996,4]],"Therefore shall her young men fall in the streets, and all her warriors shall be cast down, saith the Lord."],["31",[["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐπὶ",705080,0],["σὲ",711598,163],["τὴν",709436,8],["ὑβρίστριαν",713055,9],["λέγει",708124,91],["κύριος",707996,4],["ὅτι",709803,7],["ἥκει",705956,91],["ἡ",709436,10],["ἡμέρα",705984,12],["σου",711945,133],["καὶ",707031,7],["ὁ",709436,3],["καιρὸς",707047,4],["ἐκδικήσεώς",704175,17],[