[["2",[["τῇ",709436,100],["Αἰγύπτῳ",700401,1],["ἐπὶ",705080,0],["δύναμιν",703839,9],["Φαραω",713360,18],["Νεχαω",709284,18],["βασιλέως",702580,18],["Αἰγύπτου",700401,17],["ὃς",709781,213],["ἦν",704093,13],["ἐπὶ",705080,0],["τῷ",709436,113],["ποταμῷ",710693,114],["Εὐφράτῃ",705716,114],["ἐν",704639,0],["Χαρχαμις",713756,111],["ὃν",709781,112],["ἐπάταξε",710185,2],["Ναβουχοδονοσορ",709149,4],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,17],["ἐν",704639,0],["τῷ",709436,53],["ἔτει",705543,54],["τῷ",709436,113],["τετάρτῳ",712811,30],["Ιωακιμ",706887,18],["βασιλέως",702580,18],["Ιουδα",706768,18]],"For Egypt, against the Power of Pharao Nechao King of Egypt, who was by the river Euphrates in Charmis, whom Nabuchodonosor king of Babylon smote in the fourth year of Joakim king of Juda."],["3",[["ἀναλάβετε",700984,74],["ὅπλα",709704,42],["καὶ",707031,7],["ἀσπίδας",701991,39],["καὶ",707031,7],["προσαγάγετε",710848,74],["εἰς",704105,0],["πόλεμον",710605,6]],"Take up arms and spears, and draw nigh to battle;"],["4",[["ἐπισάξατε",705242,74],["τοὺς",709436,58],["ἵππους",706790,57],["ἐπίβητε",705082,372],["οἱ",709436,136],["ἱππεῖς",706786,52],["καὶ",707031,7],["κατάστητε",707011,74],["ἐν",704639,0],["ταῖς",709436,75],["περικεφαλαίαις",710331,76],["ὑμῶν",713091,145],["προβάλετε",710764,74],["τὰ",709436,41],["δόρατα",703804,42],["καὶ",707031,7],["ἐνδύσασθε",704701,186],["τοὺς",709436,58],["θώρακας",706356,57],["ὑμῶν",713091,145]],"and harness the horses: mount, ye horsemen, and stand ready in your helmets; advance the spears, and put on your breast-plates."],["5",[["τί",712867,126],["ὅτι",709803,7],["αὐτοὶ",702165,201],["πτοοῦνται",711062,269],["καὶ",707031,7],["ἀποχωροῦσιν",701639,197],["ὀπίσω",709697,28],["διότι",703734,7],["οἱ",709436,136],["ἰσχυροὶ",706855,138],["αὐτῶν",702165,40],["κοπήσονται",707829,144],["φυγῇ",713609,1],["ἔφυγον",713433,150],["καὶ",707031,7],["οὐκ",709805,28],["ἀνέστρεψαν",701060,150],["περιεχόμενοι",710315,348],["κυκλόθεν",707956,28],["λέγει",708124,91],["κύριος",707996,4]],"Why do they fear, and turn back? even because their mighty men shall be slain: they have utterly fled, and being hemmed in they have not rallied, saith the Lord."],["6",[["μὴ",708851,28],["φευγέτω",713433,31],["ὁ",709436,3],["κοῦφος",707863,14],["καὶ",707031,7],["μὴ",708851,28],["ἀνασῳζέσθω",701064,407],["ὁ",709436,3],["ἰσχυρός",706855,14],["ἐπὶ",705080,0],["βορρᾶν",702765,6],["τὰ",709436,41],["παρὰ",709995,0],["τὸν",709436,5],["Εὐφράτην",705716,6],["ἠσθένησαν",701938,150],["πεπτώκασιν",710481,353]],"Let not the swift flee, and let not the mighty man escape to the north: the [forces] at Euphrates are become feeble, and they have fallen."],["7",[["τίς",712867,158],["οὗτος",709858,121],["ὡς",714148,7],["ποταμὸς",710693,4],["ἀναβήσεται",700905,93],["καὶ",707031,7],["ὡς",714148,7],["ποταμοὶ",710693,52],["κυμαίνουσιν",707969,197],["ὕδωρ",713071,25]],"Who is this [that] shall come up as a river, and as rivers roll [their] waves?"],["8",[["ὕδατα",713071,42],["Αἰγύπτου",700401,17],["ὡσεὶ",714159,28],["ποταμὸς",710693,4],["ἀναβήσεται",700905,93],["καὶ",707031,7],["εἶπεν",705373,2],["ἀναβήσομαι",700905,181],["καὶ",707031,7],["κατακαλύψω",707260,165],["γῆν",703083,9],["καὶ",707031,7],["ἀπολῶ",701513,165],["κατοικοῦντας",707534,235],["ἐν",704639,0],["αὐτῇ",702165,105]],"The waters of Egypt shall come up like a river: and he said, I will go up, and will cover the earth, and will destroy the dwellers in it."],["9",[["ἐπίβητε",705082,372],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἵππους",706790,57],["παρασκευάσατε",710103,74],["τὰ",709436,41],["ἅρματα",701768,42],["ἐξέλθατε",704909,74],["οἱ",709436,136],["μαχηταὶ",708602,52],["Αἰθιόπων",700420,81],["καὶ",707031,7],["Λίβυες",708189,81],["καθωπλισμένοι",707018,429],["ὅπλοις",709704,96],["καὶ",707031,7],["Λυδοί",708266,52],["ἀνάβητε",700905,74],["ἐντείνατε",704790,74],["τόξον",712898,25]],"Mount ye the horses, prepare the chariots; go forth, ye warriors of the Ethiopians, and Libyans armed with shields; and mount, ye Lydians, bend the bow."],["10",[["καὶ",707031,7],["ἡ",709436,10],["ἡμέρα",705984,12],["ἐκείνη",704183,107],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["ἡμῶν",705999,145],["ἡμέρα",705984,12],["ἐκδικήσεως",704175,17],["τοῦ",709436,20],["ἐκδικῆσαι",704174,106],["τοὺς",709436,58],["ἐχθροὺς",705779,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["καταφάγεται",707519,93],["ἡ",709436,10],["μάχαιρα",708593,12],["κυρίου",707996,18],["καὶ",707031,7],["ἐμπλησθήσεται",704592,134],["καὶ",707031,7],["μεθυσθήσεται",708676,134],["ἀπὸ",701425,0],["τοῦ",709436,20],["αἵματος",700442,21],["αὐτῶν",702165,40],["ὅτι",709803,7],["θυσία",706345,12],["τῷ",709436,113],["κυρίῳ",707996,114],["σαβαωθ",711346,81],["ἀπὸ",701425,0],["γῆς",703083,17],["βορρᾶ",702765,18],["ἐπὶ",705080,0],["ποταμῷ",710693,114],["Εὐφράτῃ",705716,114]],"And that day [shall be] to the Lord our God a day of vengeance, to take vengeance on his enemies: and the sword of the Lord shall devour, and be glutted, and be drunken with their blood: for the Lord [has] a sacrifice from the land of the north at the river Euphrates."],["11",[["ἀνάβηθι",700905,176],["Γαλααδ",702920,766],["καὶ",707031,7],["λαβὲ",708076,176],["ῥητίνην",711252,9],["τῇ",709436,100],["παρθένῳ",710148,1],["θυγατρὶ",706320,1],["Αἰγύπτου",700401,17],["εἰς",704105,0],["κενὸν",707612,27],["ἐπλήθυνας",710530,162],["ἰάματά",706405,42],["σου",711945,133],["ὠφέλεια",714170,12],["οὐκ",709805,28],["ἔστιν",704093,91],["σοί",711925,159]],"Go up to Galaad, and take balm for the virgin daughter of Egypt: in vain hast thou multiplied thy medicines; there is no help in thee."],["12",[["ἤκουσαν",700587,150],["ἔθνη",704068,64],["φωνήν",713640,9],["σου",711945,133],["καὶ",707031,7],["τῆς",709436,16],["κραυγῆς",707886,17],["σου",711945,133],["ἐπλήσθη",710532,37],["ἡ",709436,10],["γῆ",703083,12],["ὅτι",709803,7],["μαχητὴς",708602,4],["πρὸς",710844,0],["μαχητὴν",708602,6],["ἠσθένησεν",701938,2],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτὸ",702165,129],["ἔπεσαν",710481,150],["ἀμφότεροι",700892,138]],"The nations have heard thy voice, and the land has been filled with thy cry: for the warriors have fainted fighting one against another, [and] both are fallen together."],["13",[["ἃ",709781,69],["ἐλάλησεν",708071,2],["κύριος",707996,4],["ἐν",704639,0],["χειρὶ",713787,1],["Ιερεμιου",706611,18],["τοῦ",709436,20],["ἐλθεῖν",705453,106],["Ναβουχοδονοσορ",709149,6],["τὸν",709436,5],["βασιλέα",702580,6],["Βαβυλῶνος",702352,17],["τοῦ",709436,20],["κόψαι",707829,106],["τὴν",709436,8],["γῆν",703083,9],["Αἰγύπτου",700401,17]],"The Words which the Lord spoke by Jeremias, concerning the coming of the king of Babylon to smite the land of Egypt."],["14",[["ἀναγγείλατε",700921,74],["εἰς",704105,0],["Μάγδωλον",708332,6],["καὶ",707031,7],["παραγγείλατε",710004,74],["εἰς",704105,0],["Μέμφιν",708727,227],["εἴπατε",705373,74],["ἐπίστηθι",705756,244],["καὶ",707031,7],["ἑτοίμασον",705539,176],["ὅτι",709803,7],["κατέφαγεν",707519,2],["μάχαιρα",708593,12],["τὴν",709436,8],["σμίλακά",711912,9],["σου",711945,133]],"Proclaim [it] at Magdol, and declare [it] at Memphis: say ye, Stand up, and prepare; for the sword has devoured thy yew-tree."],["15",[["διὰ",703417,0],["τί",712867,126],["ἔφυγεν",713433,2],["ὁ",709436,3],["Ἆπις",701410,4],["ὁ",709436,3],["μόσχος",709029,4],["ὁ",709436,3],["ἐκλεκτός",704240,14],["σου",711945,133],["οὐκ",709805,28],["ἔμεινεν",708736,2],["ὅτι",709803,7],["κύριος",707996,4],["παρέλυσεν",710070,2],["αὐτόν",702165,85]],"Wherefore has Apis fled from thee? thy choice calf has not remained; for the Lord has utterly weakened him."],["16",[["καὶ",707031,7],["τὸ",709436,34],["πλῆθός",710529,15],["σου",711945,133],["ἠσθένησεν",701938,2],["καὶ",707031,7],["ἔπεσεν",710481,2],["καὶ",707031,7],["ἕκαστος",704133,14],["πρὸς",710844,0],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102],["ἐλάλει",708071,13],["ἀναστῶμεν",701173,79],["καὶ",707031,7],["ἀναστρέψωμεν",701060,79],["πρὸς",710844,0],["τὸν",709436,5],["λαὸν",708094,6],["ἡμῶν",705999,145],["εἰς",704105,0],["τὴν",709436,8],["πατρίδα",710196,9],["ἡμῶν",705999,145],["ἀπὸ",701425,0],["προσώπου",710986,21],["μαχαίρας",708593,39],["Ἑλληνικῆς",704517,82]],"And thy multitude has fainted and fallen; and each one said to his neighbour, Let us arise, and return into our country to our people, from the Grecian sword."],["17",[["καλέσατε",707084,74],["τὸ",709436,24],["ὄνομα",709666,25],["Φαραω",713360,18],["Νεχαω",709284,18],["βασιλέως",702580,18],["Αἰγύπτου",700401,17],["Σαωνεσβιεμωηδ",711594,4]],"Call ye the name of Pharao Nechao king of Egypt, Saon esbeie moed."],["18",[["ζῶ",705851,157],["ἐγώ",704018,164],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["ὅτι",709803,7],["ὡς",714148,7],["τὸ",709436,34],["Ἰταβύριον",706862,15],["ἐν",704639,0],["τοῖς",709436,95],["ὄρεσιν",709768,96],["καὶ",707031,7],["ὡς",714148,7],["ὁ",709436,3],["Κάρμηλος",707161,4],["ἐν",704639,0],["τῇ",709436,100],["θαλάσσῃ",706069,1],["ἥξει",705956,127]],"[As] I live, saith the Lord God, he shall come as Itabyrion among the mountains, and as Carmel that is on the sea."],["19",[["σκεύη",711844,42],["ἀποικισμοῦ",701465,18],["ποίησον",710582,176],["σεαυτῇ",711599,105],["κατοικοῦσα",707534,784],["θύγατερ",706320,258],["Αἰγύπτου",700401,17],["ὅτι",709803,7],["Μέμφις",708727,120],["εἰς",704105,0],["ἀφανισμὸν",702183,6],["ἔσται",704093,93],["καὶ",707031,7],["κληθήσεται",707084,134],["οὐαὶ",709807,88],["διὰ",703417,0],["τὸ",709436,24],["μὴ",708851,28],["ὑπάρχειν",713104,55],["κατοικοῦντας",707534,235],["ἐν",704639,0],["αὐτῇ",702165,105]],"O daughter of Egypt dwelling [at home], prepare thee stuff for removing: for Memphis shall be utterly desolate, and shall be called Woe, because there are no inhabitants in it."],["20",[["δάμαλις",703271,12],["κεκαλλωπισμένη",707095,203],["Αἴγυπτος",700401,12],["ἀπόσπασμα",701582,15],["ἀπὸ",701425,0],["βορρᾶ",702765,18],["ἦλθεν",705453,2],["ἐπ᾿",705080,0],["αὐτήν",702165,104]],"Egypt is a fair heifer, [but] destruction from the north is come upon her."],["21",[["καὶ",707031,7],["οἱ",709436,136],["μισθωτοὶ",708942,138],["αὐτῆς",702165,86],["ἐν",704639,0],["αὐτῇ",702165,105],["ὥσπερ",714163,28],["μόσχοι",709029,52],["σιτευτοὶ",711807,138],["τρεφόμενοι",712930,348],["ἐν",704639,0],["αὐτῇ",702165,105],["διότι",703734,7],["καὶ",707031,28],["αὐτοὶ",702165,201],["ἀπεστράφησαν",701598,99],["καὶ",707031,7],["ἔφυγον",713433,150],["ὁμοθυμαδόν",709624,28],["οὐκ",709805,28],["ἔστησαν",706846,150],["ὅτι",709803,7],["ἡμέρα",705984,12],["ἀπωλείας",701660,17],["ἦλθεν",705453,2],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["καὶ",707031,7],["καιρὸς",707047,4],["ἐκδικήσεως",704175,17],["αὐτῶν",702165,40]],"Also her hired [soldiers] in the midst of her are as fatted calves fed in her; for they also have turned, and fled with one accord: they stood not, for the day of destruction was come upon them, and the time of their retribution."],["22",[["φωνὴ",713640,12],["ὡς",714148,7],["ὄφεως",709875,18],["συρίζοντος",712538,152],["ὅτι",709803,7],["ἐν",704639,0],["ἄμμῳ",700845,1],["πορεύσονται",710667,135],["ἐν",704639,0],["ἀξίναις",701306,76],["ἥξουσιν",705956,218],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["ὡς",714148,7],["κόπτοντες",707829,146],["ξύλα",709427,42]],"Their voice is as [that] of a hissing serpent, for they go upon the sand; they shall come upon Egypt with axes, as men that cut wood."],["23",[["ἐκκόψουσιν",704225,218],["τὸν",709436,5],["δρυμὸν",703836,6],["αὐτῆς",702165,86],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["ὅτι",709803,7],["οὐ",709805,28],["μὴ",708851,28],["εἰκασθῇ",704081,384],["ὅτι",709803,7],["πληθύνει",710530,91],["ὑπὲρ",713111,0],["ἀκρίδα",700599,9],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["αὐτοῖς",702165,151],["ἀριθμός",701744,4]],"They shall cut down her forest, saith the Lord, for [their number] cannot at all be conjectured, for it exceeds the locust in multitude, and they are innumerable."],["24",[["κατῃσχύνθη",707257,37],["θυγάτηρ",706320,12],["Αἰγύπτου",700401,17],["παρεδόθη",710014,37],["εἰς",704105,0],["χεῖρας",713787,39],["λαοῦ",708094,18],["ἀπὸ",701425,0],["βορρᾶ",702765,18]],"The daughter of Egypt is confounded; she is delivered into the hands of a people from the north."],["25",[["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐκδικῶ",704174,157],["τὸν",709436,5],["Αμων",700896,6],["τὸν",709436,5],["υἱὸν",713075,6],["αὐτῆς",702165,86],["ἐπὶ",705080,0],["Φαραω",713360,6],["καὶ",707031,7],["ἐπὶ",705080,0],["τοὺς",709436,58],["πεποιθότας",710221,277],["ἐπ᾿",705080,0],["αὐτῷ",702165,50]],"Behold, I [will] avenge Ammon her son upon Pharao, and upon them that trust in him."],["27",[["σὺ",712181,164],["δὲ",703303,11],["μὴ",708851,28],["φοβηθῇς",713532,279],["δοῦλός",703817,4],["μου",709032,133],["Ιακωβ",706401,153],["μηδὲ",708855,7],["πτοηθῇς",711062,279],["Ισραηλ",706839,153],["διότι",703734,7],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["σῴζων",712627,72],["σε",711598,163],["μακρόθεν",708417,28],["καὶ",707031,7],["τὸ",709436,24],["σπέρμα",712008,25],["σου",711945,133],["ἐκ",704132,0],["τῆς",709436,16],["αἰχμαλωσίας",700499,17],["αὐτῶν",702165,40],["καὶ",707031,7],["ἀναστρέψει",701060,127],["Ιακωβ",706401,4],["καὶ",707031,7],["ἡσυχάσει",706033,127],["καὶ",707031,7],["ὑπνώσει",713182,127],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ὁ",709436,3],["παρενοχλῶν",710135,72],["αὐτόν",702165,85]],"But fear not thou, my servant Jacob, neither be thou alarmed, Israel: for, behold, I will save thee from afar, and thy seed from their captivity; and Jacob shall return, and be at ease, and sleep, and there shall be no one to trouble him."],["28",[["μὴ",708851,28],["φοβοῦ",713532,253],["παῖς",709932,4],["μου",709032,133],["Ιακωβ",706401,153],["λέγει",708124,91],["κύριος",707996,4],["ὅτι",709803,7],["μετὰ",708780,0],["σοῦ",711945,133],["ἐγώ",704018,164],["εἰμι",704093,157],["ὅτι",709803,7],["ποιήσω",710582,165],["συντέλειαν",712509,9],["ἐν",704639,0],["παντὶ",710177,97],["ἔθνει",704068,54],["εἰς",704105,0],["οὓς",709781,298],["ἐξῶσά",704985,155],["σε",711598,163],["ἐκεῖ",704181,28],["σὲ",711598,163],["δὲ",703303,11],["οὐ",709805,28],["μὴ",708851,28],["ποιήσω",710582,165],["ἐκλιπεῖν",704237,106],["καὶ",707031,7],["παιδεύσω",709926,165],["σε",711598,163],["εἰς",704105,0],["κρίμα",707903,25],["καὶ",707031,7],["ἀθῷον",700390,27],["οὐκ",709805,28],["ἀθῳώσω",700391,165],["σε",711598,163]],"Fear not thou, my servant Jacob, saith the Lord; for I am with thee: she [that was] without fear and in luxury, has been delivered up: for I will make a full end of every nation among whom I have thrust thee forth; but I will not cause thee to fail: yet will I chastise thee in the way of judgment, and will not hold thee entirely guiltless."]]