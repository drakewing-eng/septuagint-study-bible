[["1",[["ὁ",709436,3],["λόγος",708236,4],["ὁ",709436,3],["γενόμενος",703104,248],["πρὸς",710844,0],["Ιερεμιαν",706611,6],["παρὰ",709995,0],["κυρίου",707996,18],["εἰπεῖν",705373,106]],"The Word that came to Jeremias from the Lord, saying,"],["2",[["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["λέγων",708124,72],["γράψον",703194,176],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["οὓς",709781,298],["ἐχρημάτισα",713949,155],["πρὸς",710844,0],["σέ",711598,163],["ἐπὶ",705080,0],["βιβλίου",702719,21]],"Thus speaks the Lord God of Israel, saying, Write all the words which I have spoken to thee in a book."],["3",[["ὅτι",709803,7],["ἰδοὺ",706497,88],["ἡμέραι",705984,191],["ἔρχονται",705453,269],["φησὶν",713437,91],["κύριος",707996,4],["καὶ",707031,7],["ἀποστρέψω",701598,165],["τὴν",709436,8],["ἀποικίαν",701463,9],["λαοῦ",708094,18],["μου",709032,133],["Ισραηλ",706839,18],["καὶ",707031,7],["Ιουδα",706768,18],["εἶπεν",705373,2],["κύριος",707996,4],["καὶ",707031,7],["ἀποστρέψω",701598,165],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ἣν",709781,131],["ἔδωκα",703654,155],["τοῖς",709436,147],["πατράσιν",710189,148],["αὐτῶν",702165,40],["καὶ",707031,7],["κυριεύσουσιν",707995,218],["αὐτῆς",702165,86]],"For, behold, the days come, saith the Lord, when I will bring back the captivity of my people Israel and Juda, said the Lord: and I will bring them back to the land which I gave to their fathers, and they shall be lords of it."],["4",[["καὶ",707031,7],["οὗτοι",709858,201],["οἱ",709436,136],["λόγοι",708236,52],["οὓς",709781,298],["ἐλάλησεν",708071,2],["κύριος",707996,4],["ἐπὶ",705080,0],["Ισραηλ",706839,6],["καὶ",707031,7],["Ιουδα",706768,6]],"And these are the Words which the Lord spoke concerning Israel and Juda:"],["5",[["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["φωνὴν",713640,9],["φόβου",713534,18],["ἀκούσεσθε",700587,124],["φόβος",713534,4],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["εἰρήνη",704098,12]],"Thus said the Lord: Ye shall hear a sound of fear, [there is] fear, and there is not peace."],["6",[["ἐρωτήσατε",705459,74],["καὶ",707031,7],["ἴδετε",709725,74],["εἰ",704071,7],["ἔτεκεν",712853,2],["ἄρσεν",701818,46],["καὶ",707031,7],["περὶ",710285,0],["φόβου",713534,18],["ἐν",704639,0],["ᾧ",709781,309],["καθέξουσιν",707526,218],["ὀσφὺν",709800,9],["καὶ",707031,7],["σωτηρίαν",712658,9],["διότι",703734,7],["ἑώρακα",709725,89],["πάντα",710177,27],["ἄνθρωπον",701163,6],["καὶ",707031,7],["αἱ",709436,190],["χεῖρες",713787,191],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τῆς",709436,16],["ὀσφύος",709800,17],["αὐτοῦ",702165,102],["ἐστράφησαν",712160,99],["πρόσωπα",710986,42],["εἰς",704105,0],["ἴκτερον",706720,6]],"Enquire, and see if a male has born a child? and [ask] concerning the fear, wherein they shall hold their loins, and [look for] safety: for I have seen every man, and his hands are on his loins; [their] faces are turned to paleness."],["7",[["ἐγενήθη",703104,37],["ὅτι",709803,7],["μεγάλη",708653,29],["ἡ",709436,10],["ἡμέρα",705984,12],["ἐκείνη",704183,107],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["τοιαύτη",712878,29],["καὶ",707031,7],["χρόνος",713969,4],["στενός",712068,14],["ἐστιν",704093,91],["τῷ",709436,113],["Ιακωβ",706401,114],["καὶ",707031,7],["ἀπὸ",701425,0],["τούτου",709858,102],["σωθήσεται",712627,134]],"For that day is great, and there is not such [another]; and it is a time of straitness to Jacob; but he shall be saved out of it."],["8",[["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["εἶπεν",705373,2],["κύριος",707996,4],["συντρίψω",712520,165],["τὸν",709436,5],["ζυγὸν",705894,6],["ἀπὸ",701425,0],["τοῦ",709436,35],["τραχήλου",712924,18],["αὐτῶν",702165,40],["καὶ",707031,7],["τοὺς",709436,58],["δεσμοὺς",703372,57],["αὐτῶν",702165,40],["διαρρήξω",703565,165],["καὶ",707031,7],["οὐκ",709805,28],["ἐργῶνται",705382,380],["αὐτοὶ",702165,201],["ἔτι",705538,28],["ἀλλοτρίοις",700699,230]],"In that day, said the Lord, I will break the yoke off their neck, and will burst their bonds, and they shall no longer serve strangers:"],["9",[["καὶ",707031,7],["ἐργῶνται",705382,380],["τῷ",709436,113],["κυρίῳ",707996,114],["θεῷ",706192,114],["αὐτῶν",702165,40],["καὶ",707031,7],["τὸν",709436,5],["Δαυιδ",703232,6],["βασιλέα",702580,6],["αὐτῶν",702165,40],["ἀναστήσω",701173,165],["αὐτοῖς",702165,151]],"but they shall serve the Lord their God; and I will raise up to them David their king."],["12",[["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["ἀνέστησα",701173,2],["σύντριμμα",712521,25],["ἀλγηρὰ",700641,29],["ἡ",709436,10],["πληγή",710527,12],["σου",711945,133]],"Thus saith the Lord; I have brought on [thee] destruction; thy stroke is painful."],["13",[["οὐκ",709805,28],["ἔστιν",704093,91],["κρίνων",707905,72],["κρίσιν",707908,9],["σου",711945,133],["εἰς",704105,0],["ἀλγηρὸν",700641,46],["ἰατρεύθης",706458,168],["ὠφέλεια",714170,12],["οὐκ",709805,28],["ἔστιν",704093,91],["σοι",711925,159]],"There is none to judge thy cause: thou hast been painfully treated for healing, there is no help for thee."],["14",[["πάντες",710177,138],["οἱ",709436,136],["φίλοι",713492,138],["σου",711945,133],["ἐπελάθοντό",705187,189],["σου",711945,133],["οὐ",709805,28],["μὴ",708851,28],["ἐπερωτήσουσιν",705069,218],["ὅτι",709803,7],["πληγὴν",710527,9],["ἐχθροῦ",705779,18],["ἔπαισά",709931,155],["σε",711598,163],["παιδείαν",709924,9],["στερεάν",712075,36],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["ἀδικίαν",700271,9],["σου",711945,133],["ἐπλήθυναν",710530,150],["αἱ",709436,190],["ἁμαρτίαι",700775,191],["σου",711945,133]],"All thy friends have forgotten thee; they shall not ask [about thee] at all, for I have smitten thee with the stroke of an enemy, [even] severe correction: thy sins have abounded above all thine iniquity."],["16",[["διὰ",703417,0],["τοῦτο",709858,129],["πάντες",710177,138],["οἱ",709436,136],["ἔσθοντές",705495,146],["σε",711598,163],["βρω