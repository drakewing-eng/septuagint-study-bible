ὸ",701425,0],["προσώπου",710986,21],["αὐτῶν",702165,40],["ὅτι",709803,7],["ἐπάταξεν",710185,2],["Ισμαηλ",706818,4],["τὸν",709436,5],["Γοδολιαν",703148,6],["ὃν",709781,112],["κατέστησεν",707011,2],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,17],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1]],"for they were afraid of them, because Ismael had smitten Godolias, whom the king of Babylon made [governor] in the land."]]