[["2",[["καὶ",707031,7],["εἶπεν",705373,2],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἐμνήσθην",708960,156],["ἐλέους",704426,21],["νεότητός",709258,17],["σου",711945,133],["καὶ",707031,7],["ἀγάπης",700122,17],["τελειώσεώς",712773,17],["σου",711945,133],["τοῦ",709436,20],["ἐξακολουθῆσαί",704845,106],["σε",711598,163],["τῷ",709436,113],["ἁγίῳ",700159,30],["Ισραηλ",706839,114],["λέγει",708124,91],["κύριος",707996,4]],"And he said, Thus saith the Lord, I remember the kindness of thy youth, and the love of thine espousals, in following the Holy One of Israel, saith the Lord."],["3",[["ἅγιος",700159,14],["Ισραηλ",706839,18],["τῷ",709436,113],["κυρίῳ",707996,114],["ἀρχὴ",701836,12],["γενημάτων",703052,44],["αὐτοῦ",702165,102],["πάντες",710177,138],["οἱ",709436,136],["ἔσθοντες",705495,146],["αὐτὸν",702165,85],["πλημμελήσουσιν",710534,218],["κακὰ",707066,195],["ἥξει",705956,127],["ἐπ᾿",705080,0],["αὐτούς",702165,62],["φησὶν",713437,91],["κύριος",707996,4]],"Israel was the holy [people] to the Lord, [and] the first-fruits of his increase: all that devoured him shall offend; evils shall come upon them, saith the Lord."],["4",[["ἀκούσατε",700587,74],["λόγον",708236,6],["κυρίου",707996,18],["οἶκος",709516,4],["Ιακωβ",706401,18],["καὶ",707031,7],["πᾶσα",710177,29],["πατριὰ",710192,12],["οἴκου",709516,18],["Ισραηλ",706839,18]],"Hear the word of the Lord, O house of Jacob, and every family of the house of Israel."],["5",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["τί",712867,126],["εὕροσαν",705676,150],["οἱ",709436,136],["πατέρες",710189,52],["ὑμῶν",713091,145],["ἐν",704639,0],["ἐμοὶ",704577,159],["πλημμέλημα",710535,25],["ὅτι",709803,7],["ἀπέστησαν",702214,150],["μακρὰν",708421,36],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["ὀπίσω",709697,0],["τῶν",709436,80],["ματαίων",708575,169],["καὶ",707031,7],["ἐματαιώθησαν",708578,99]],"Thus saith the Lord, What trespass have your fathers found in me, that they have revolted far from me, and gone after vanities, and become vain?"],["6",[["καὶ",707031,7],["οὐκ",709805,28],["εἶπαν",705373,150],["ποῦ",710706,28],["ἐστιν",704093,91],["κύριος",707996,4],["ὁ",709436,3],["ἀναγαγὼν",700933,182],["ἡμᾶς",705981,194],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["ὁ",709436,3],["καθοδηγήσας",707013,182],["ἡμᾶς",705981,194],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["ἐν",704639,0],["γῇ",703083,1],["ἀπείρῳ",701381,101],["καὶ",707031,7],["ἀβάτῳ",700023,101],["ἐν",704639,0],["γῇ",703083,1],["ἀνύδρῳ",701285,101],["καὶ",707031,7],["ἀκάρπῳ",700522,101],["ἐν",704639,0],["γῇ",703083,1],["ἐν",704639,0],["ᾗ",709781,108],["οὐ",709805,28],["διώδευσεν",703715,2],["ἐν",704639,0],["αὐτῇ",702165,105],["οὐθὲν",709817,26],["καὶ",707031,7],["οὐ",709805,28],["κατῴκησεν",707534,2],["ἐκεῖ",704181,28],["υἱὸς",713075,4],["ἀνθρώπου",701163,18]],"And they said not, Where is the Lord, who brought us up out of the land of Egypt, who guided us in the wilderness, in an untried and trackless land, in a land which no man at all went through, and no man dwelt there?"],["7",[["καὶ",707031,7],["εἰσήγαγον",704107,150],["ὑμᾶς",713080,194],["εἰς",704105,0],["τὸν",709436,5],["Κάρμηλον",707161,6],["τοῦ",709436,20],["φαγεῖν",713296,106],["ὑμᾶς",713080,194],["τοὺς",709436,58],["καρποὺς",707169,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["ἀγαθὰ",700106,68],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἰσήλθατε",704114,265],["καὶ",707031,7],["ἐμιάνατε",708900,265],["τὴν",709436,8],["γῆν",703083,9],["μου",709032,133],["καὶ",707031,7],["τὴν",709436,8],["κληρονομίαν",707725,9],["μου",709032,133],["ἔθεσθε",712849,345],["εἰς",704105,0],["βδέλυγμα",702604,25]],"And I brought you to Carmel, that ye should eat the fruits thereof, and the good thereof; and ye went in, and defiled my land, and made mine heritage an abomination."],["8",[["οἱ",709436,136],["ἱερεῖς",706614,52],["οὐκ",709805,28],["εἶπαν",705373,150],["ποῦ",710706,28],["ἐστιν",704093,91],["κύριος",707996,4],["καὶ",707031,7],["οἱ",709436,136],["ἀντεχόμενοι",701225,348],["τοῦ",709436,35],["νόμου",709349,18],["οὐκ",709805,28],["ἠπίσταντό",705264,139],["με",708618,163],["καὶ",707031,7],["οἱ",709436,136],["ποιμένες",710596,52],["ἠσέβουν",701906,137],["εἰς",704105,0],["ἐμέ",704555,163],["καὶ",707031,7],["οἱ",709436,136],["προφῆται",711009,52],["ἐπροφήτευον",711008,137],["τῇ",709436,100],["Βααλ",702333,1],["καὶ",707031,7],["ὀπίσω",709697,0],["ἀνωφελοῦς",701303,92],["ἐπορεύθησαν",710667,99]],"The priests said not, Where is the Lord? and they that held by the law knew me not: the shepherds also sinned against me, and the prophets prophesied by Baal, and went after that which profited not."],["9",[["διὰ",703417,0],["τοῦτο",709858,129],["ἔτι",705538,28],["κριθήσομαι",707905,180],["πρὸς",710844,0],["ὑμᾶς",713080,194],["λέγει",708124,91],["κύριος",707996,4],["καὶ",707031,7],["πρὸς",710844,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["τῶν",709436,80],["υἱῶν",713075,81],["ὑμῶν",713091,145],["κριθήσομαι",707905,180]],"Therefore I will yet plead with you, and will plead with your children's children."],["10",[["διότι",703734,7],["διέλθετε",703673,74],["εἰς",704105,0],["νήσους",709302,39],["Χεττιιμ",713840,81],["καὶ",707031,7],["ἴδετε",709725,74],["καὶ",707031,7],["εἰς",704105,0],["Κηδαρ",707645,227],["ἀποστείλατε",701592,74],["καὶ",707031,7],["νοήσατε",709327,74],["σφόδρα",712586,28],["καὶ",707031,7],["ἴδετε",709725,74],["εἰ",704071,7],["γέγονεν",703104,171],["τοιαῦτα",712878,195]],"For go to the isles of the Chettians, and see; and send to Kedar, and observe accurately, and see if such things have been done;"],["11",[["εἰ",704071,7],["ἀλλάξονται",700683,135],["ἔθνη",704068,64],["θεοὺς",706192,57],["αὐτῶν",702165,70],["καὶ",707031,7],["οὗτοι",709858,201],["οὔκ",709805,28],["εἰσιν",704093,197],["θεοί",706192,52],["ὁ",709436,3],["δὲ",703303,11],["λαός",708094,4],["μου",709032,133],["ἠλλάξατο",700683,23],["τὴν",709436,8],["δόξαν",703791,9],["αὐτοῦ",702165,102],["ἐξ",704132,0],["ἧς",709781,167],["οὐκ",709805,28],["ὠφεληθήσονται",714171,144]],"if the nations will change their gods, though they are not gods: but my people have changed their glory, [for that] from which they shall not be profited."],["12",[["ἐξέστη",704940,2],["ὁ",709436,3],["οὐρανὸς",709844,4],["ἐπὶ",705080,0],["τούτῳ",709858,50],["καὶ",707031,7],["ἔφριξεν",713584,2],["ἐπὶ",705080,0],["πλεῖον",710514,46],["σφόδρα",712586,28],["λέγει",708124,91],["κύριος",707996,4]],"The heaven is amazed at this, and is very exceedingly horror-struck, saith the Lord."],["13",[["ὅτι",709803,7],["δύο",703849,59],["πονηρὰ",710660,68],["ἐποίησεν",710582,2],["ὁ",709436,3],["λαός",708094,4],["μου",709032,133],["ἐμὲ",704555,163],["ἐγκατέλιπον",703967,150],["πηγὴν",710450,9],["ὕδατος",713071,21],["ζωῆς",705910,17],["καὶ",707031,7],["ὤρυξαν",709775,150],["ἑαυτοῖς",703917,151],["λάκκους",708067,57],["συντετριμμένους",712520,360],["οἳ",709781,250],["οὐ",709805,28],["δυνήσονται",703838,135],["ὕδωρ",713071,25],["συνέχειν",712469,55]],"For my people has committed two [faults], and evil ones: they have forsaken me, the fountain of water of life, and hewn out for themselves broken cisterns, which will not be able to hold water."],["14",[["μὴ",708851,28],["δοῦλός",703817,4],["ἐστιν",704093,91],["Ισραηλ",706839,4],["ἢ",705924,7],["οἰκογενής",709508,14],["ἐστιν",704093,91],["διὰ",703417,0],["τί",712867,126],["εἰς",704105,0],["προνομὴν",710827,9],["ἐγένετο",703104,23]],"Is Israel a servant, or a home-born slave? why has he become a spoil?"],["15",[["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["ὠρύοντο",714142,139],["λέοντες",708171,52],["καὶ",707031,7],["ἔδωκαν",703654,150],["τὴν",709436,8],["φωνὴν",713640,9],["αὐτῶν",702165,40],["οἳ",709781,250],["ἔταξαν",712730,150],["τὴν",709436,8],["γῆν",703083,9],["αὐτοῦ",702165,102],["εἰς",704105,0],["ἔρημον",705420,9],["καὶ",707031,7],["αἱ",709436,190],["πόλεις",710612,191],["αὐτοῦ",702165,102],["κατεσκάφησαν",707416,150],["παρὰ",709995,0],["τὸ",709436,24],["μὴ",708851,28],["κατοικεῖσθαι",707534,110]],"The lions roared upon him, and uttered their voice, which have made his land a wilderness: and his cities are broken down, that they should not be inhabited."],["16",[["καὶ",707031,7],["υἱοὶ",713075,52],["Μέμφεως",708727,17],["καὶ",707031,7],["Ταφνας",712737,118],["ἔγνωσάν",703105,150],["σε",711598,163],["καὶ",707031,7],["κατέπαιζόν",707355,137],["σου",711945,133]],"Also the children of Memphis and Taphnas have known thee, and mocked thee."],["17",[["οὐχὶ",709862,28],["ταῦτα",709858,71],["ἐποίησέν",710582,2],["σοι",711925,159],["τὸ",709436,24],["καταλιπεῖν",707305,106],["σε",711598,163],["ἐμέ",704555,163],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133]],"Has not thy forsaking me brought these things upon thee? saith the Lord thy God."],["18",[["καὶ",707031,7],["νῦν",709384,28],["τί",712867,126],["σοι",711925,159],["καὶ",707031,7],["τῇ",709436,100],["ὁδῷ",709458,1],["Αἰγύπτου",700401,17],["τοῦ",709436,20],["πιεῖν",710478,106],["ὕδωρ",713071,25],["Γηων",703098,17],["καὶ",707031,7],["τί",712867,126],["σοι",711925,159],["καὶ",707031,7],["τῇ",709436,100],["ὁδῷ",709458,1],["Ἀσσυρίων",702004,81],["τοῦ",709436,20],["πιεῖν",710478,106],["ὕδωρ",713071,25],["ποταμῶν",710693,81]],"And now what hast thou to do with the way of Egypt, to drink the water of Geon? and what hast thou to do with the way of the Assyrians, to drink the water of rivers?"],["19",[["παιδεύσει",709926,127],["σε",711598,163],["ἡ",709436,10],["ἀποστασία",701586,12],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["κακία",707054,12],["σου",711945,133],["ἐλέγξει",704416,127],["σε",711598,163],["καὶ",707031,7],["γνῶθι",703105,176],["καὶ",707031,7],["ἰδὲ",709725,176],["ὅτι",709803,7],["πικρόν",710475,26],["σοι",711925,159],["τὸ",709436,34],["καταλιπεῖν",707305,106],["σε",711598,163],["ἐμέ",704555,163],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["καὶ",707031,7],["οὐκ",709805,28],["εὐδόκησα",705565,155],["ἐπὶ",705080,0],["σοί",711925,159],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133]],"Thine apostasy shall correct thee, and thy wickedness shall reprove thee: know then, and see, that thy forsaking me [has been] bitter to thee, saith the Lord thy God; and I have taken no pleasure in thee, saith the Lord thy God."],["20",[["ὅτι",709803,7],["ἀπ᾿",701425,0],["αἰῶνος",700504,18],["συνέτριψας",712520,162],["τὸν",709436,5],["ζυγόν",705894,6],["σου",711945,133],["διέσπασας",703583,162],["τοὺς",709436,58],["δεσμούς",703372,57],["σου",711945,133],["καὶ",707031,7],["εἶπας",705373,162],["οὐ",709805,28],["δουλεύσω",703814,165],["ἀλλὰ",700680,7],["πορεύσομαι",710667,181],["ἐπὶ",705080,0],["πᾶν",710177,46,27],["βουνὸν",702797,6],["ὑψηλὸν",713285,27],["καὶ",707031,7],["ὑποκάτω",713204,28],["παντὸς",710177,92],["ξύλου",709427,21],["κατασκίου",707425,92],["ἐκεῖ",704181,28],["διαχυθήσομαι",703636,180],["ἐν",704639,0],["τῇ",709436,100],["πορνείᾳ",710672,1],["μου",709032,133]],"For of old thou hast broken thy yoke, and plucked asunder thy bands; and thou hast said, I will not serve thee, but will go upon every high hill, and under every shady tree, there will I indulge in my fornication."],["21",[["ἐγὼ",704018,164],["δὲ",703303,11],["ἐφύτευσά",713636,155],["σε",711598,163],["ἄμπελον",700870,9],["καρποφόρον",707172,36],["πᾶσαν",710177,36],["ἀληθινήν",700659,36],["πῶς",711121,28],["ἐστράφης",712160,168],["εἰς",704105,0],["πικρίαν",710472,9],["ἡ",709436,10],["ἄμπελος",700870,12],["ἡ",709436,10],["ἀλλοτρία",700699,29]],"Yet I planted thee a fruitful vine, entirely of the right sort: how art thou a strange vine turned to bitterness!"],["22",[["ἐὰν",703912,7],["ἀποπλύνῃ",701549,278],["ἐν",704639,0],["νίτρῳ",709319,54],["καὶ",707031,7],["πληθύνῃς",710530,205],["σεαυτῇ",711599,105],["πόαν",710575,9],["κεκηλίδωσαι",707651,332],["ἐν",704639,0],["ταῖς",709436,75],["ἀδικίαις",700271,76],["σου",711945,133],["ἐναντίον",704654,0],["ἐμοῦ",704580,133],["λέγει",708124,91],["κύριος",707996,4]],"Though thou shouldest wash thyself with nitre, and multiply to thyself soap, [still] thou art stained by thine iniquities before me, saith the Lord."],["23",[["πῶς",711121,28],["ἐρεῖς",705415,166],["οὐκ",709805,28],["ἐμιάνθην",708900,156],["καὶ",707031,7],["ὀπίσω",709697,0],["τῆς",709436,16],["Βααλ",702333,17],["οὐκ",709805,28],["ἐπορεύθην",710667,156],["ἰδὲ",709725,176],["τὰς",709436,38],["ὁδούς",709458,39],["σου",711945,133],["ἐν",704639,0],["τῷ",709436,53],["πολυανδρίῳ",710621,54],["καὶ",707031,7],["γνῶθι",703105,176],["τί",712867,126],["ἐποίησας",710582,162],["ὀψὲ",709896,28],["φωνὴ",713640,12],["αὐτῆς",702165,86],["ὠλόλυξεν",709593,2],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτῆς",702165,86]],"How wilt thou say, I am not polluted, and have not gone after Baal? behold thy ways in the burial-ground, and know what thou hast done: her voice has howled in the evening:"],["24",[["ἐπλάτυνεν",710508,13],["ἐφ᾿",705080,0],["ὕδατα",713071,42],["ἐρήμου",705420,17],["ἐν",704639,0],["ἐπιθυμίαις",705147,76],["ψυχῆς",714070,17],["αὐτῆς",702165,86],["ἐπνευματοφορεῖτο",710567,19],["παρεδόθη",710014,37],["τίς",712867,158],["ἐπιστρέψει",705278,127],["αὐτήν",702165,104],["πάντες",710177,138],["οἱ",709436,136],["ζητοῦντες",705879,146],["αὐτὴν",702165,104],["οὐ",709805,28],["κοπιάσουσιν",707824,218],["ἐν",704639,0],["τῇ",709436,100],["ταπεινώσει",712719,1],["αὐτῆς",702165,86],["εὑρήσουσιν",705676,218],["αὐτήν",702165,104]],"she has extended her ways over the waters of the desert; she was hurried along by the lusts of her soul; she is given up [to them], who will turn her back? none that seek her shall be weary; at [the time of] her humiliation they shall find her."],["25",[["ἀπόστρεψον",701598,176],["τὸν",709436,5],["πόδα",710707,6],["σου",711945,133],["ἀπὸ",701425,0],["ὁδοῦ",709458,17],["τραχείας",712925,82],["καὶ",707031,7],["τὸν",709436,5],["φάρυγγά",713375,6],["σου",711945,133],["ἀπὸ",701425,0],["δίψους",703764,21],["ἡ",709436,10],["δὲ",703303,11],["εἶπεν",705373,2],["ἀνδριοῦμαι",701104,181],["ὅτι",709803,7],["ἠγαπήκει",700120,171],["ἀλλοτρίους",700699,60],["καὶ",707031,7],["ὀπίσω",709697,0],["αὐτῶν",702165,40],["ἐπορεύετο",710667,19]],"Withdraw thy foot from a rough way, and thy throat from thirst: but she said, I will strengthen myself: for she loved strangers, and went after them."],["26",[["ὡς",714148,7],["αἰσχύνη",700483,12],["κλέπτου",707714,18],["ὅταν",709801,28],["ἁλῷ",700673,172],["οὕτως",709859,28],["αἰσχυνθήσονται",700485,144],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["αὐτοὶ",702165,201],["καὶ",707031,7],["οἱ",709436,136],["βασιλεῖς",702580,52],["αὐτῶν",702165,40],["καὶ",707031,7],["οἱ",709436,136],["ἄρχοντες",701862,52],["αὐτῶν",702165,40],["καὶ",707031,7],["οἱ",709436,136],["ἱερεῖς",706614,52],["αὐτῶν",702165,40],["καὶ",707031,7],["οἱ",709436,136],["προφῆται",711009,52],["αὐτῶν",702165,40]],"As is the shame of a thief when he is caught, so shall the children of Israel be ashamed; they, and their kings, and their princes, and their priests, and their prophets."],["27",[["τῷ",709436,53],["ξύλῳ",709427,54],["εἶπαν",705373,150],["ὅτι",709803,7],["πατήρ",710189,4],["μου",709032,133],["εἶ",704093,154],["σύ",712181,164],["καὶ",707031,7],["τῷ",709436,113],["λίθῳ",708196,114],["σὺ",712181,164],["ἐγέννησάς",703051,162],["με",708618,163],["καὶ",707031,7],["ἔστρεψαν",712160,150],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["νῶτα",709403,42],["καὶ",707031,7],["οὐ",709805,28],["πρόσωπα",710986,42],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["τῶν",709436,80],["κακῶν",707066,169],["αὐτῶν",702165,40],["ἐροῦσιν",705415,218],["ἀνάστα",701173,176],["καὶ",707031,7],["σῶσον",712627,176],["ἡμᾶς",705981,194]],"They said to a stock, Thou art my father; and to a stone, Thou hast begotten me: and they have turned [their] backs to me, and not their faces: yet in the time of their afflictions they will say, Arise, and save us."],["28",[["καὶ",707031,7],["ποῦ",710706,28],["εἰσιν",704093,197],["οἱ",709436,136],["θεοί",706192,52],["σου",711945,133],["οὓς",709781,298],["ἐποίησας",710582,162],["σεαυτῷ",711599,50],["εἰ",704071,7],["ἀναστήσονται",701173,135],["καὶ",707031,7],["σώσουσίν",712627,218],["σε",711598,163],["ἐν",704639,0],["καιρῷ",707047,114],["τῆς",709436,16],["κακώσεώς",707075,17],["σου",711945,133],["ὅτι",709803,7],["κατ᾿",707200,0],["ἀριθμὸν",701744,6],["τῶν",709436,130],["πόλεών",710612,65],["σου",711945,133],["ἦσαν",704093,137],["θεοί",706192,52],["σου",711945,133],["Ιουδα",706768,153],["καὶ",707031,7],["κατ᾿",707200,0],["ἀριθμὸν",701744,6],["διόδων",703716,65],["τῆς",709436,16],["Ιερουσαλημ",706644,17],["ἔθυον",706349,137],["τῇ",709436,100],["Βααλ",702333,1]],"And where are thy gods, which thou madest for thyself? will they arise and save in the time of thine affliction? for according to the number of thy cities were thy gods, O Juda; and according to the number of the streets of Jerusalem they sacrificed to Baal."],["29",[["ἵνα",706747,7],["τί",712867,126],["λαλεῖτε",708071,87],["πρός",710844,0],["με",708618,163],["πάντες",710177,138],["ὑμεῖς",713081,219],["ἠσεβήσατε",701906,265],["καὶ",707031,7],["πάντες",710177,138],["ὑμεῖς",713081,219],["ἠνομήσατε",701190,265],["εἰς",704105,0],["ἐμέ",704555,163],["λέγει",708124,91],["κύριος",707996,4]],"Wherefore do ye speak unto me? ye all have been ungodly, and ye all have transgressed against me, saith the Lord."],["30",[["μάτην",708582,28],["ἐπάταξα",710185,155],["τὰ",709436,41],["τέκνα",712761,42],["ὑμῶν",713091,145],["παιδείαν",709924,9],["οὐκ",709805,28],["ἐδέξασθε",703393,345],["μάχαιρα",708593,12],["κατέφαγεν",707519,2],["τοὺς",709436,58],["προφήτας",711009,57],["ὑμῶν",713091,145],["ὡς",714148,7],["λέων",708171,4],["ὀλεθρεύων",709560,72],["καὶ",707031,7],["οὐκ",709805,28],["ἐφοβήθητε",713532,472]],"In vain have I smitten your children; ye have not received correction: a sword has devoured your prophets as a destroying lion; yet ye feared not."],["31",[["ἀκούσατε",700587,74],["λόγον",708236,6],["κυρίου",707996,18],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["μὴ",708851,28],["ἔρημος",705420,12],["ἐγενόμην",703104,161],["τῷ",709436,113],["Ισραηλ",706839,114],["ἢ",705924,7],["γῆ",703083,12],["κεχερσωμένη",713832,203],["διὰ",703417,0],["τί",712867,126],["εἶπεν",705373,2],["ὁ",709436,3],["λαός",708094,4],["μου",709032,133],["οὐ",709805,28],["κυριευθησόμεθα",707995,347],["καὶ",707031,7],["οὐχ",709805,28],["ἥξομεν",705956,275],["πρὸς",710844,0],["σὲ",711598,163],["ἔτι",705538,28]],"Hear ye the word of the Lord: thus saith the Lord, Have I been a wilderness or a dry land to Israel? wherefore has my people said, We will not be ruled over, and will not come to thee any more?"],["32",[["μὴ",708851,28],["ἐπιλήσεται",705187,93],["νύμφη",709381,12],["τὸν",709436,5],["κόσμον",707851,6],["αὐτῆς",702165,86],["καὶ",707031,7],["παρθένος",710148,12],["τὴν",709436,8],["στηθοδεσμίδα",712088,9],["αὐτῆς",702165,86],["ὁ",709436,3],["δὲ",703303,11],["λαός",708094,4],["μου",709032,133],["ἐπελάθετό",705187,23],["μου",709032,133],["ἡμέρας",705984,39],["ὧν",709781,199],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀριθμός",701744,4]],"Will a bride forget her ornaments, or a virgin her girdle? but my people has forgotten me days without number."],["33",[["τί",712867,126],["ἔτι",705538,28],["καλὸν",707097,27],["ἐπιτηδεύσεις",705302,166],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["σου",711945,133],["τοῦ",709436,20],["ζητῆσαι",705879,106],["ἀγάπησιν",700123,9],["οὐχ",709805,28],["οὕτως",709859,28],["ἀλλὰ",700680,7],["καὶ",707031,28],["σὺ",712181,164],["ἐπονηρεύσω",710658,174],["τοῦ",709436,20],["μιᾶναι",708900,106],["τὰς",709436,38],["ὁδούς",709458,39],["σου",711945,133]],"What fair device wilt thou yet employ in thy ways, so as to seek love? [it shall] not [be] so; moreover thou hast done wickedly in corrupting thy ways;"],["34",[["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["χερσίν",713787,76],["σου",711945,133],["εὑρέθησαν",705676,99],["αἵματα",700442,42],["ψυχῶν",714070,65],["ἀθῴων",700390,198],["οὐκ",709805,28],["ἐν",704639,0],["διορύγμασιν",703731,96],["εὗρον",705676,150],["αὐτούς",702165,62],["ἀλλ᾿",700680,7],["ἐπὶ",705080,0],["πάσῃ",710177,101],["δρυί",703837,1]],"and in thine hands has been found the blood of innocent souls; I have not found them in holes, but on every oak."],["35",[["καὶ",707031,7],["εἶπας",705373,162],["ἀθῷός",700390,29],["εἰμι",704093,157],["ἀλλὰ",700680,7],["ἀποστραφήτω",701598,22],["ὁ",709436,3],["θυμὸς",706334,4],["αὐτοῦ",702165,102],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["κρίνομαι",707905,254],["πρὸς",710844,0],["σὲ",711598,163],["ἐν",704639,0],["τῷ",709436,53],["λέγειν",708124,55],["σε",711598,163],["οὐχ",709805,28],["ἥμαρτον",700773,155]],"Yet thou saidst, I am innocent: only let his wrath be turned away from me. Behold, I [will] plead with thee, whereas thou sayest, I have not sinned."],["36",[["τί",712867,126],["κατεφρόνησας",707482,162],["σφόδρα",712586,28],["τοῦ",709436,20],["δευτερῶσαι",703390,106],["τὰς",709436,38],["ὁδούς",709458,39],["σου",711945,133],["καὶ",707031,7],["ἀπὸ",701425,0],["Αἰγύπτου",700401,17],["καταισχυνθήσῃ",707257,364],["καθὼς",707030,28],["κατῃσχύνθης",707257,168],["ἀπὸ",701425,0],["Ασσουρ",702001,18]],"For thou hast been so exceedingly contemptuous as to repeat thy ways; but thou shalt be ashamed of Egypt, as thou wast ashamed of Assur."],["37",[["ὅτι",709803,7],["καὶ",707031,28],["ἐντεῦθεν",704793,28],["ἐξελεύσῃ",704909,123],["καὶ",707031,7],["αἱ",709436,190],["χεῖρές",713787,191],["σου",711945,133],["ἐπὶ",705080,0],["τῆς",709436,16],["κεφαλῆς",707639,17],["σου",711945,133],["ὅτι",709803,7],["ἀπώσατο",701659,23],["κύριος",707996,4],["τὴν",709436,8],["ἐλπίδα",704530,9],["σου",711945,133],["καὶ",707031,7],["οὐκ",709805,28],["εὐοδωθήσῃ",705654,364],["ἐν",704639,0],["αὐτῇ",702165,105]],"For thou shalt go forth thence also with thine hands upon thine head; for the Lord has rejected thine hope, and thou shalt not prosper in it."]]