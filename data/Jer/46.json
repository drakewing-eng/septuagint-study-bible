05984,1],["ἐκείνῃ",704183,105],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["δώσω",703654,165],["σε",711598,163],["εἰς",704105,0],["χεῖρας",713787,39],["τῶν",709436,80],["ἀνθρώπων",701163,81],["ὧν",709781,252],["σὺ",712181,164],["φοβῇ",713532,259],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτῶν",702165,40]],"But I will save thee in that day, and I will by no means deliver thee into the hands of the men before whom thou art afraid."],["18",[["ὅτι",709803,7],["σῴζων",712627,72],["σώσω",712627,165],["σε",711598,163],["καὶ",707031,7],["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["οὐ",709805,28],["μὴ",708851,28],["πέσῃς",710481,175],["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["ψυχή",714070,12],["σου",711945,133],["εἰς",704105,0],["εὕρεμα",705671,25],["ὅτι",709803,7],["ἐπεποίθεις",710221,508],["ἐπ᾿",705080,0],["ἐμοί",704577,159],["φησὶν",713437,91],["κύριος",707996,4]],"For I will surely save thee, and thou shalt by no means fall by the sword; and thou shalt find thy life, because thou didst trust in me, saith the Lord."]]