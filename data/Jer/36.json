[["1",[["καὶ",707031,7],["οὗτοι",709858,201],["οἱ",709436,136],["λόγοι",708236,52],["τῆς",709436,16],["βίβλου",702721,17],["οὓς",709781,298],["ἀπέστειλεν",701592,2],["Ιερεμιας",706611,4],["ἐξ",704132,0],["Ιερουσαλημ",706644,1],["πρὸς",710844,0],["τοὺς",709436,58],["πρεσβυτέρους",710735,496],["τῆς",709436,16],["ἀποικίας",701463,17],["καὶ",707031,7],["πρὸς",710844,0],["τοὺς",709436,58],["ἱερεῖς",706614,57],["καὶ",707031,7],["πρὸς",710844,0],["τοὺς",709436,58],["ψευδοπροφήτας",714043,57],["ἐπιστολὴν",705272,9],["εἰς",704105,0],["Βαβυλῶνα",702352,9],["τῇ",709436,100],["ἀποικίᾳ",701463,1],["καὶ",707031,7],["πρὸς",710844,0],["ἅπαντα",701362,27],["τὸν",709436,5],["λαὸν",708094,6]],"And these are the words of the book which Jeremias sent from Jerusalem to the elders of the captivity, and to the priests, and to the false prophets, even an epistle to Babylon for the captivity, and to all the people;"],["2",[["ὕστερον",713273,28],["ἐξελθόντος",704909,500],["Ιεχονιου",706691,18],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["τῆς",709436,16],["βασιλίσσης",702584,17],["καὶ",707031,7],["τῶν",709436,80],["εὐνούχων",705651,81],["καὶ",707031,7],["παντὸς",710177,116],["ἐλευθέρου",704428,116],["καὶ",707031,7],["δεσμώτου",703375,18],["καὶ",707031,7],["τεχνίτου",712832,18],["ἐξ",704132,0],["Ιερουσαλημ",706644,17]],"(after the departure of Jechonias the king and the queen, and the eunuchs, and every freeman, and bondman, and artificer, out of Jerusalem;)"],["3",[["ἐν",704639,0],["χειρὶ",713787,1],["Ελεασα",704411,18],["υἱοῦ",713075,18],["Σαφαν",711569,18],["καὶ",707031,7],["Γαμαριου",702947,18],["υἱοῦ",713075,18],["Χελκιου",713815,18],["ὃν",709781,112],["ἀπέστειλεν",701592,2],["Σεδεκιας",711618,4],["βασιλεὺς",702580,4],["Ιουδα",706768,18],["πρὸς",710844,0],["βασιλέα",702580,6],["Βαβυλῶνος",702352,17],["εἰς",704105,0],["Βαβυλῶνα",702352,9],["λέγων",708124,72]],"by the hand of Eleasan son of Saphan, and Gamarias son of Chelcias, (whom Sedekias king of Juda sent to the king of Babylon to Babylon) saying,"],["4",[["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ἐπὶ",705080,0],["τὴν",709436,8],["ἀποικίαν",701463,9],["ἣν",709781,131],["ἀπῴκισα",701464,155],["ἀπὸ",701425,0],["Ιερουσαλημ",706644,17]],"Thus said the Lord God of Israel concerning the captivity which I caused to be carried away from Jerusalem;"],["5",[["οἰκοδομήσατε",709509,74],["οἴκους",709516,57],["καὶ",707031,7],["κατοικήσατε",707534,74],["καὶ",707031,7],["φυτεύσατε",713636,74],["παραδείσους",710012,57],["καὶ",707031,7],["φάγετε",713296,74,337],["τοὺς",709436,58],["καρποὺς",707169,57],["αὐτῶν",702165,40]],"Build ye houses, and inhabit [them]; and plant gardens, and eat the fruits thereof;"],["6",[["καὶ",707031,7],["λάβετε",708076,74],["γυναῖκας",703209,39],["καὶ",707031,7],["τεκνοποιήσατε",712762,74],["υἱοὺς",713075,57],["καὶ",707031,7],["θυγατέρας",706320,39],["καὶ",707031,7],["λάβετε",708076,74],["τοῖς",709436,147],["υἱοῖς",713075,148],["ὑμῶν",713091,145],["γυναῖκας",703209,39],["καὶ",707031,7],["τὰς",709436,38],["θυγατέρας",706320,39],["ὑμῶν",713091,145],["ἀνδράσιν",701150,148],["δότε",703654,74],["καὶ",707031,7],["πληθύνεσθε",710530,374],["καὶ",707031,7],["μὴ",708851,28],["σμικρυνθῆτε",711911,394]],"and take ye wives, and beget sons and daughters; and take wives for your sons, and give your daughters to husbands, and be multiplied, and be not diminished."],["7",[["καὶ",707031,7],["ζητήσατε",705879,74],["εἰς",704105,0],["εἰρήνην",704098,9],["τῆς",709436,16],["γῆς",703083,17],["εἰς",704105,0],["ἣν",709781,131],["ἀπῴκισα",701464,155],["ὑμᾶς",713080,194],["ἐκεῖ",704181,28],["καὶ",707031,7],["προσεύξασθε",710893,345],["περὶ",710285,0],["αὐτῶν",702165,40],["πρὸς",710844,0],["κύριον",707996,6],["ὅτι",709803,7],["ἐν",704639,0],["εἰρήνῃ",704098,1],["αὐτῆς",702165,86],["ἔσται",704093,93],["εἰρήνη",704098,12],["ὑμῖν",713084,90]],"And seek the peace of the land into which I have carried you captive, and ye shall pray to the Lord for the people: for in its peace ye shall [have] peace."],["8",[["ὅτι",709803,7],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["μὴ",708851,28],["ἀναπειθέτωσαν",701028,56],["ὑμᾶς",713080,194],["οἱ",709436,136],["ψευδοπροφῆται",714043,52],["οἱ",709436,136],["ἐν",704639,0],["ὑμῖν",713084,90],["καὶ",707031,7],["μὴ",708851,28],["ἀναπειθέτωσαν",701028,56],["ὑμᾶς",713080,194],["οἱ",709436,136],["μάντεις",708491,52],["ὑμῶν",713091,145],["καὶ",707031,7],["μὴ",708851,28],["ἀκούετε",700587,335],["εἰς",704105,0],["τὰ",709436,41],["ἐνύπνια",704818,42],["ὑμῶν",713091,145],["ἃ",709781,69],["ὑμεῖς",713081,219],["ἐνυπνιάζεσθε",704815,374]],"For thus saith the Lord; Let not the false prophets that are among you persuade you, and let not your diviners persuade you, and hearken not to your dreams which ye dream."],["9",[["ὅτι",709803,7],["ἄδικα",700272,68],["αὐτοὶ",702165,201],["προφητεύουσιν",711008,197],["ὑμῖν",713084,90],["ἐπὶ",705080,0],["τῷ",709436,53],["ὀνόματί",709666,54],["μου",709032,133],["καὶ",707031,7],["οὐκ",709805,28],["ἀπέστειλα",701592,155],["αὐτούς",702165,62]],"For they prophesy to you unrighteous [words] in my name; and I sent them not."],["10",[["ὅτι",709803,7],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["ὅταν",709801,28],["μέλλῃ",708705,204],["πληροῦσθαι",710543,110],["Βαβυλῶνι",702352,1],["ἑβδομήκοντα",703922,59],["ἔτη",705543,42],["ἐπισκέψομαι",705250,181],["ὑμᾶς",713080,194],["καὶ",707031,7],["ἐπιστήσω",705756,165],["τοὺς",709436,58],["λόγους",708236,57],["μου",709032,133],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["τοῦ",709436,20],["τὸν",709436,5],["λαὸν",708094,6],["ὑμῶν",713091,145],["ἀποστρέψαι",701598,106],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["τοῦτον",709858,85]],"For thus said the Lord; When seventy years shall be on the point of being accomplished at Babylon, I will visit you, and will confirm my words to you, to bring back your people to this place."],["11",[["καὶ",707031,7],["λογιοῦμαι",708232,181],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["λογισμὸν",708234,6],["εἰρήνης",704098,17],["καὶ",707031,7],["οὐ",709805,28],["κακὰ",707066,68],["τοῦ",709436,20],["δοῦναι",703654,106],["ὑμῖν",713084,90],["ταῦτα",709858,71]],"And I will devise for you a device of peace, and not evil, to bestow upon you these [good things]."],["12",[["καὶ",707031,7],["προσεύξασθε",710893,345],["πρός",710844,0],["με",708618,163],["καὶ",707031,7],["εἰσακούσομαι",704108,181],["ὑμῶν",713091,145]],"And do ye pray to me, and I will hearken to you: and do ye earnestly seek me, and ye shall find me;"],["13",[["καὶ",707031,7],["ἐκζητήσατέ",704187,74],["με",708618,163],["καὶ",707031,7],["εὑρήσετέ",705676,337],["με",708618,163],["ὅτι",709803,7],["ζητήσετέ",705879,337],["με",708618,163],["ἐν",704639,0],["ὅλῃ",709597,101],["καρδίᾳ",707141,1],["ὑμῶν",713091,145]],"for ye shall seek me with your whole heart."],["14",[["καὶ",707031,7],["ἐπιφανοῦμαι",705317,181],["ὑμῖν",713084,90]],"And I will appear to you:"],["15",[["ὅτι",709803,7],["εἴπατε",705373,265],["κατέστησεν",707011,2],["ἡμῖν",705994,90],["κύριος",707996,4],["προφήτας",711009,57],["ἐν",704639,0],["Βαβυλῶνι",702352,1]],"whereas ye said, The Lord has appointed for us prophets in Babylon:"],["21",[["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["ἐπὶ",705080,0],["Αχιαβ",702263,6],["καὶ",707031,7],["ἐπὶ",705080,0],["Σεδεκιαν",711618,6],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["δίδωμι",703654,157],["αὐτοὺς",702165,62],["εἰς",704105,0],["χεῖρας",713787,39],["βασιλέως",702580,18],["Βαβυλῶνος",702352,17],["καὶ",707031,7],["πατάξει",710185,127],["αὐτοὺς",702165,62],["κατ᾿",707200,0],["ὀφθαλμοὺς",709870,57],["ὑμῶν",713091,145]],"Thus saith the Lord concerning Achiab, and concerning Sedekias; Behold, I [will] deliver them into the hands of the king of Babylon; and he shall smite them in your sight."],["22",[["καὶ",707031,7],["λήμψονται",708076,135],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["κατάραν",707395,9],["ἐν",704639,0],["πάσῃ",710177,101],["τῇ",709436,100],["ἀποικίᾳ",701463,1],["Ιουδα",706768,18],["ἐν",704639,0],["Βαβυλῶνι",702352,1],["λέγοντες",708124,146],["ποιήσαι",710582,300],["σε",711598,163],["κύριος",707996,4],["ὡς",714148,7],["Σεδεκιαν",711618,6],["ἐποίησεν",710582,2],["καὶ",707031,7],["ὡς",714148,7],["Αχιαβ",702263,6],["οὓς",709781,298],["ἀπετηγάνισεν",701612,2],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,17],["ἐν",704639,0],["πυρὶ",711088,54]],"And they shall make of them a curse in all the captivity of Juda in Babylon, saying, The Lord do to thee as he did to Sedekias, and as he did to Achiab, whom the king of Babylon fried in the fire;"],["23",[["δι᾿",703417,0],["ἣν",709781,131],["ἐποίησαν",710582,150],["ἀνομίαν",701192,9],["ἐν",704639,0],["Ισραηλ",706839,114],["καὶ",707031,7],["ἐμοιχῶντο",708976,139],["τὰς",709436,38],["γυναῖκας",703209,39],["τῶν",709436,80],["πολιτῶν",710616,81],["αὐτῶν",702165,40],["καὶ",707031,7],["λόγον",708236,6],["ἐχρημάτισαν",713949,150],["ἐν",704639,0],["τῷ",709436,53],["ὀνόματί",709666,54],["μου",709032,133],["ὃν",709781,112],["οὐ",709805,28],["συνέταξα",712508,155],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἐγὼ",704018,164],["μάρτυς",708527,4],["φησὶν",713437,91],["κύριος",707996,4]],"because of the iniquity which they wrought in Israel, and [because] they committed adultery with the wives of their fellow-citizens, and spoke a word in my name, which I did not command them [to speak], and I am witness, saith the Lord."],["24",[["καὶ",707031,7],["πρὸς",710844,0],["Σαμαιαν",711441,6],["τὸν",709436,5],["Νελαμίτην",709250,6],["ἐρεῖς",705415,166]],"And to Samæas the Ælamite thou shalt say,"],["25",[["οὐκ",709805,28],["ἀπέστειλά",701592,155],["σε",711598,163],["τῷ",709436,53],["ὀνόματί",709666,54],["μου",709032,133],["καὶ",707031,7],["πρὸς",710844,0],["Σοφονιαν",711984,6],["υἱὸν",713075,6],["Μαασαιου",708311,18],["τὸν",709436,5],["ἱερέα",706614,6],["εἰπέ",705373,176]],"I sent thee not in my name: and to Sophonias the priest the son of Maasæas say thou,"],["26",[["κύριος",707996,4],["ἔδωκέν",703654,2],["σε",711598,163],["εἰς",704105,0],["ἱερέα",706614,6],["ἀντὶ",701227,0],["Ιωδαε",706908,18],["τοῦ",709436,35],["ἱερέως",706614,18],["γενέσθαι",703104,109],["ἐπιστάτην",705266,6],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["κυρίου",707996,18],["παντὶ",710177,30],["ἀνθρώπῳ",701163,114],["προφητεύοντι",711008,379],["καὶ",707031,7],["παντὶ",710177,30],["ἀνθρώπῳ",701163,114],["μαινομένῳ",708389,241],["καὶ",707031,7],["δώσεις",703654,166],["αὐτὸν",702165,85],["εἰς",704105,0],["τὸ",709436,24],["ἀπόκλεισμα",701483,25],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["καταρράκτην",707404,6]],"The Lord has made thee priest in the place of Jodae the priest, to be ruler in the house of the Lord over every prophet, and to every madman, and thou shalt put them in prison, and into the dungeon."],["27",[["καὶ",707031,7],["νῦν",709384,28],["διὰ",703417,0],["τί",712867,126],["συνελοιδορήσατε",712269,265,150],["Ιερεμιαν",706611,6],["τὸν",709436,5],["ἐξ",704132,0],["Αναθωθ",700953,65],["τὸν",709436,5],["προφητεύσαντα",711008,365],["ὑμῖν",713084,90]],"And now wherefore have ye reviled together Jeremias of Anathoth, who prophesied to you?"],["28",[["οὐ",709805,28],["διὰ",703417,0],["τοῦτο",709858,129],["ἀπέστειλεν",701592,2],["πρὸς",710844,0],["ὑμᾶς",713080,194],["εἰς",704105,0],["Βαβυλῶνα",702352,9],["λέγων",708124,72],["μακράν",708421,36],["ἐστιν",704093,91],["οἰκοδομήσατε",709509,74],["οἰκίας",709505,17],["καὶ",707031,7],["κατοικήσατε",707534,74],["καὶ",707031,7],["φυτεύσατε",713636,74],["κήπους",707654,57],["καὶ",707031,7],["φάγεσθε",705495,124],["τὸν",709436,5],["καρπὸν",707169,6],["αὐτῶν",702165,40]],"Did he not send for this purpose? for in the course of this month he sent to you to Babylon, saying, It is far off: build ye houses, and inhabit [them]; and plant gardens, and eat the fruit of them."],["29",[["καὶ",707031,7],["ἀνέγνω",700922,2],["Σοφονιας",711984,4],["τὸ",709436,24],["βιβλίον",702719,25],["εἰς",704105,0],["τὰ",709436,41],["ὦτα",709852,42],["Ιερεμιου",706611,18]],"And Sophonias read the book in the ears of Jeremias."],["30",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρὸς",710844,0],["Ιερεμιαν",706611,6],["λέγων",708124,72]],"Then the word of the Lord came to Jeremias, saying,"],["31",[["ἀπόστειλον",701592,176],["πρὸς",710844,0],["τὴν",709436,8],["ἀποικίαν",701463,9],["λέγων",708124,72],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["ἐπὶ",705080,0],["Σαμαιαν",711441,6],["τὸν",709436,5],["Νελαμίτην",709250,6],["ἐπειδὴ",705056,7],["ἐπροφήτευσεν",711008,2],["ὑμῖν",713084,90],["Σαμαιας",711441,4],["καὶ",707031,7],["ἐγὼ",704018,164],["οὐκ",709805,28],["ἀπέστειλα",701592,155],["αὐτόν",702165,85],["καὶ",707031,7],["πεποιθέναι",710221,115],["ἐποίησεν",710582,2],["ὑμᾶς",713080,194],["ἐπ᾿",705080,0],["ἀδίκοις",700272,230]],"Send to the captivity, saying, Thus saith the Lord concerning Samæas the Ælamite, Since Samæas has prophesied to you, and I sent him not, and he has made you to trust in iniquity,"],["32",[["διὰ",703417,0],["τοῦτο",709858,129],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐπισκέψομαι",705250,181],["ἐπὶ",705080,0],["Σαμαιαν",711441,6],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸ",709436,24],["γένος",703057,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["αὐτῶν",702165,40],["ἄνθρωπος",701163,4],["ἐν",704639,0],["μέσῳ",708768,30],["ὑμῶν",713091,145],["τοῦ",709436,20],["ἰδεῖν",709725,106],["τὰ",709436,41],["ἀγαθά",700106,68],["ἃ",709781,69],["ἐγὼ",704018,164],["ποιήσω",710582,165],["ὑμῖν",713084,90],["οὐκ",709805,28],["ὄψονται",709725,135]],"therefore thus saith the Lord; Behold, I will visit Samæas, and his family: and there shall not be a man of them in the midst of you to see the good which I will do to you: they shall not see [it]."]]