,7],["διαμείνῃ",703517,172],["ἡμέρας",705984,17],["πλείους",710514,138]],"Take this book of the purchase, and the book that has been read; and thou shalt put it into an earthen vessel, that it may remain many days."],["15",[["ὅτι",709803,7],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["ἔτι",705538,28],["κτηθήσονται",707932,144],["ἀγροὶ",700196,52],["καὶ",707031,7],["οἰκίαι",709505,191],["καὶ",707031,7],["ἀμπελῶνες",700872,52],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ταύτῃ",709858,105]],"For thus saith the Lord; There shall yet be bought fields and houses and vineyards in this land."],["16",[["καὶ",707031,7],["προσευξάμην",710893,161],["πρὸς",710844,0],["κύριον",707996,6],["μετὰ",708780,0],["τὸ",709436,24],["δοῦναί",703654,106],["με",708618,163],["τὸ",709436,24],["βιβλίον",702719,25],["τῆς",709436,16],["κτήσεως",707937,17],["πρὸς",710844,0],["Βαρουχ",702544,6],["υἱὸν",713075,6],["Νηριου",709301,18],["λέγων",708124,72]],"And I prayed to the Lord after I had given the book of the purchase to Baruch the son of Nerias, saying,"],["17",[["ὦ",714081,88],["κύριε",707996,153],["σὺ",712181,164],["ἐποίησας",710582,162],["τὸν",709436,5],["οὐρανὸν",709844,6],["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9],["τῇ",709436,100],["ἰσχύι",706858,1],["σου",711945,133],["τῇ",709436,100],["μεγάλῃ",708653,101],["καὶ",707031,7],["τῷ",709436,113],["βραχίονί",702808,114],["σου",711945,133],["τῷ",709436,113],["ὑψηλῷ",713285,30],["καὶ",707031,7],["τῷ",709436,113],["μετεώρῳ",708831,30],["οὐ",709805,28],["μὴ",708851,28],["ἀποκρυβῇ",701495,384],["ἀπὸ",701425,0],["σοῦ",711945,133],["οὐθέν",709817,46]],"O [ever] living Lord! thou hast made the heaven and the earth by thy great power, and with thy high and lofty arm: nothing can be hidden from thee."],["18",[["ποιῶν",710582,72],["ἔλεος",704426,25],["εἰς",704105,0],["χιλιάδας",713858,39],["καὶ",707031,7],["ἀποδιδοὺς",701449,72],["ἁμαρτίας",700775,39],["πατέρων",710189,81],["εἰς",704105,0],["κόλπους",707800,57],["τέκνων",71