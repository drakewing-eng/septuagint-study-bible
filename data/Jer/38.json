[["1",[["ἐν",704639,0],["τῷ",709436,113],["χρόνῳ",713969,114],["ἐκείνῳ",704183,50],["εἶπεν",705373,2],["κύριος",707996,4],["ἔσομαι",704093,181],["εἰς",704105,0],["θεὸν",706192,6],["τῷ",709436,53],["γένει",703057,54],["Ισραηλ",706839,18],["καὶ",707031,7],["αὐτοὶ",702165,201],["ἔσονταί",704093,135],["μοι",708974,159],["εἰς",704105,0],["λαόν",708094,6]],"At that time, saith the Lord, I will be a God to the family of Israel, and they shall be to me a people."],["2",[["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["εὗρον",705676,155],["θερμὸν",706217,27],["ἐν",704639,0],["ἐρήμῳ",705420,1],["μετὰ",708780,0],["ὀλωλότων",709584,387],["ἐν",704639,0],["μαχαίρᾳ",708593,1],["βαδίσατε",702367,74],["καὶ",707031,7],["μὴ",708851,28],["ὀλέσητε",709584,125],["τὸν",709436,5],["Ισραηλ",706839,6]],"Thus saith the Lord, I found him warm in the wilderness with them that were slain with the sword: go ye and destroy not Israel."],["3",[["κύριος",707996,4],["πόρρωθεν",710681,28],["ὤφθη",709725,37],["αὐτῷ",702165,50],["ἀγάπησιν",700123,9],["αἰωνίαν",700505,36],["ἠγάπησά",700120,155],["σε",711598,163],["διὰ",703417,0],["τοῦτο",709858,129],["εἵλκυσά",704092,155],["σε",711598,163],["εἰς",704105,0],["οἰκτίρημα",709519,25]],"The Lord appeared to him from afar, [saying], I have loved thee with an everlasting love: therefore have I drawn thee in compassion."],["4",[["ἔτι",705538,28],["οἰκοδομήσω",709509,165],["σε",711598,163],["καὶ",707031,7],["οἰκοδομηθήσῃ",709509,364],["παρθένος",710148,12],["Ισραηλ",706839,4],["ἔτι",705538,28],["λήμψῃ",708076,123],["τύμπανόν",713019,25],["σου",711945,133],["καὶ",707031,7],["ἐξελεύσῃ",704909,123],["μετὰ",708780,0],["συναγωγῆς",712376,17],["παιζόντων",709931,170]],"For I will build thee, and thou shalt be built, O virgin of Israel: thou shalt yet take thy timbrel, and go forth with the party of them that make merry."],["5",[["ἔτι",705538,28],["φυτεύσατε",713636,74],["ἀμπελῶνας",700872,57],["ἐν",704639,0],["ὄρεσιν",709768,96],["Σαμαρείας",711449,17],["φυτεύσατε",713636,74],["καὶ",707031,7],["αἰνέσατε",700459,74]],"For ye have planted vineyards on the mountains of Samaria: plant ye, and praise."],["6",[["ὅτι",709803,7],["ἔστιν",704093,91],["ἡμέρα",705984,12],["κλήσεως",707730,17],["ἀπολογουμένων",701516,299],["ἐν",704639,0],["ὄρεσιν",709768,96],["Εφραιμ",705769,18],["ἀνάστητε",701173,74],["καὶ",707031,7],["ἀνάβητε",700905,74],["εἰς",704105,0],["Σιων",711816,9],["πρὸς",710844,0],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["ἡμῶν",705999,145]],"For it is a day when those that plead on the mountains of Ephraim shall call, [saying], Arise ye, and go up to Sion to the Lord your God."],["7",[["ὅτι",709803,7],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["τῷ",709436,113],["Ιακωβ",706401,114],["εὐφράνθητε",705715,372],["καὶ",707031,7],["χρεμετίσατε",713939,74],["ἐπὶ",705080,0],["κεφαλὴν",707639,9],["ἐθνῶν",704068,44],["ἀκουστὰ",700584,68],["ποιήσατε",710582,74],["καὶ",707031,7],["αἰνέσατε",700459,74],["εἴπατε",705373,265],["ἔσωσεν",712627,2],["κύριος",707996,4],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["τὸ",709436,24],["κατάλοιπον",707317,46],["τοῦ",709436,35],["Ισραηλ",706839,18]],"For thus saith the Lord to Jacob; Rejoice ye, and exult over the head of the nations: make proclamation, and praise ye: say, The Lord has delivered his people, the remnant of Israel."],["8",[["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἄγω",700209,157],["αὐτοὺς",702165,62],["ἀπὸ",701425,0],["βορρᾶ",702765,18],["καὶ",707031,7],["συνάξω",712375,165],["αὐτοὺς",702165,62],["ἀπ᾿",701425,0],["ἐσχάτου",705519,116],["τῆς",709436,16],["γῆς",703083,17],["ἐν",704639,0],["ἑορτῇ",704990,1],["φασεκ",713379,118],["καὶ",707031,7],["τεκνοποιήσῃ",712762,172],["ὄχλον",709884,6],["πολύν",710646,27],["καὶ",707031,7],["ἀποστρέψουσιν",701598,218],["ὧδε",714090,28]],"Behold, I bring them from the north, and will gather them from the end of the earth to the feast of the passover: and [the people] shall beget a great multitude, and they shall return hither."],["9",[["ἐν",704639,0],["κλαυθμῷ",707705,114],["ἐξῆλθον",704909,150],["καὶ",707031,7],["ἐν",704639,0],["παρακλήσει",710047,1],["ἀνάξω",700933,165],["αὐτοὺς",702165,62],["αὐλίζων",702138,72],["ἐπὶ",705080,0],["διώρυγας",703770,39],["ὑδάτων",713071,44],["ἐν",704639,0],["ὁδῷ",709458,1],["ὀρθῇ",709738,101],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["πλανηθῶσιν",710495,272],["ἐν",704639,0],["αὐτῇ",702165,105],["ὅτι",709803,7],["ἐγενόμην",703104,161],["τῷ",709436,113],["Ισραηλ",706839,114],["εἰς",704105,0],["πατέρα",710189,6],["καὶ",707031,7],["Εφραιμ",705769,4],["πρωτότοκός",711046,14],["μού",709032,133],["ἐστιν",704093,91]],"They went forth with weeping, and I will bring them back with consolation, causing them to lodge by the channels of waters in a straight way, and they shall not err in it: for I am become a father to Israel, and Ephraim is my first-born."],["10",[["ἀκούσατε",700587,74],["λόγον",708236,6],["κυρίου",707996,18],["ἔθνη",704068,589],["καὶ",707031,7],["ἀναγγείλατε",700921,74],["εἰς",704105,0],["νήσους",709302,39],["τὰς",709436,38],["μακρότερον",708421,61],["εἴπατε",705373,265],["ὁ",709436,3],["λικμήσας",708202,182],["τὸν",709436,5],["Ισραηλ",706839,6],["συνάξει",712375,127],["αὐτὸν",702165,85],["καὶ",707031,7],["φυλάξει",713619,127],["αὐτὸν",702165,85],["ὡς",714148,7],["ὁ",709436,3],["βόσκων",702767,72],["τὸ",709436,24],["ποίμνιον",710598,25],["αὐτοῦ",702165,102]],"Hear the words of the Lord, ye nations, and proclaim [them] to the islands afar off; say, He that scattered Israel will also gather him, and keep him as one that feeds his flock."],["11",[["ὅτι",709803,7],["ἐλυτρώσατο",708282,23],["κύριος",707996,4],["τὸν",709436,5],["Ιακωβ",706401,6],["ἐξείλατο",704838,23],["αὐτὸν",702165,85],["ἐκ",704132,0],["χειρὸς",713787,17],["στερεωτέρων",712075,169],["αὐτοῦ",702165,102]],"For the Lord has ransomed Jacob, he has rescued him out of the hand of them [that were] stronger than he."],["12",[["καὶ",707031,7],["ἥξουσιν",705956,218],["καὶ",707031,7],["εὐφρανθήσονται",705715,144],["ἐν",704639,0],["τῷ",709436,53],["ὄρει",709768,54],["Σιων",711816,17],["καὶ",707031,7],["ἥξουσιν",705956,218],["ἐπ᾿",705080,0],["ἀγαθὰ",700106,68],["κυρίου",707996,18],["ἐπὶ",705080,0],["γῆν",703083,9],["σίτου",711814,18],["καὶ",707031,7],["οἴνου",709530,18],["καὶ",707031,7],["καρπῶν",707169,81],["καὶ",707031,7],["κτηνῶν",707934,44],["καὶ",707031,7],["προβάτων",710768,44],["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτῶν",702165,40],["ὥσπερ",714163,28],["ξύλον",709427,25],["ἔγκαρπον",703962,26],["καὶ",707031,7],["οὐ",709805,28],["πεινάσουσιν",710222,218],["ἔτι",705538,28]],"And they shall come, and shall rejoice in the mount of Sion, and shall come to the good things of the Lord, [even] to a land of corn, and wine, and fruits, and cattle, and sheep: and their soul shall be as a fruitful tree; and they shall hunger no more."],["13",[["τότε",712908,28],["χαρήσονται",713665,144],["παρθένοι",710148,191],["ἐν",704639,0],["συναγωγῇ",712376,1],["νεανίσκων",709232,81],["καὶ",707031,7],["πρεσβῦται",710736,52],["χαρήσονται",713665,144],["καὶ",707031,7],["στρέψω",712160,165],["τὸ",709436,24],["πένθος",710253,25],["αὐτῶν",702165,40],["εἰς",704105,0],["χαρμονὴν",713745,9],["καὶ",707031,7],["ποιήσω",710582,165],["αὐτοὺς",702165,62],["εὐφραινομένους",705715,236]],"Then shall the virgins rejoice in the assembly of youth, and the old men shall rejoice; and I will turn their mourning into joy, and will make them merry."],["14",[["μεγαλυνῶ",708647,165],["καὶ",707031,7],["μεθύσω",708676,165],["τὴν",709436,8],["ψυχὴν",714070,9],["τῶν",709436,80],["ἱερέων",706614,81],["υἱῶν",713075,81],["Λευι",708158,18],["καὶ",707031,7],["ὁ",709436,3],["λαός",708094,4],["μου",709032,133],["τῶν",709436,80],["ἀγαθῶν",700106,169],["μου",709032,133],["ἐμπλησθήσεται",704592,134]],"I will expand and cheer with wine the soul of the priests the sons of Levi, and my people shall be satisfied with my good things: thus saith the Lord."],["15",[["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["φωνὴ",713640,12],["ἐν",704639,0],["Ραμα",711163,1],["ἠκούσθη",700587,37],["θρήνου",706309,18],["καὶ",707031,7],["κλαυθμοῦ",707705,18],["καὶ",707031,7],["ὀδυρμοῦ",709465,18],["Ραχηλ",711208,12],["ἀποκλαιομένη",701482,211],["οὐκ",709805,28],["ἤθελεν",706176,13],["παύσασθαι",710202,109],["ἐπὶ",705080,0],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτῆς",702165,86],["ὅτι",709803,7],["οὐκ",709805,28],["εἰσίν",704093,197]],"A voice was heard in Rama, of lamentation, and of weeping, and wailing; Rachel would not cease weeping for her children, because they are not."],["16",[["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["διαλιπέτω",703496,45],["ἡ",709436,10],["φωνή",713640,12],["σου",711945,133],["ἀπὸ",701425,0],["κλαυθμοῦ",707705,18],["καὶ",707031,7],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["σου",711945,133],["ἀπὸ",701425,0],["δακρύων",703255,44],["σου",711945,133],["ὅτι",709803,7],["ἔστιν",704093,91],["μισθὸς",708939,4],["τοῖς",709436,95],["σοῖς",711943,94],["ἔργοις",705396,96],["καὶ",707031,7],["ἐπιστρέψουσιν",705278,218],["ἐκ",704132,0],["γῆς",703083,17],["ἐχθρῶν",705779,81]],"Thus saith the Lord; Let thy voice cease from weeping, and thine eyes from thy tears: for there is a reward for thy works; and they shall return from the land of [thine] enemies."],["17",[["μόνιμον",708994,27],["τοῖς",709436,95],["σοῖς",711943,94],["τέκνοις",712761,96]],"[There shall be] an abiding [home] for thy children."],["18",[["ἀκοὴν",700561,9],["ἤκουσα",700587,155],["Εφραιμ",705769,114],["ὀδυρομένου",709466,262],["ἐπαίδευσάς",709926,162],["με",708618,163],["καὶ",707031,7],["ἐπαιδεύθην",709926,156],["ἐγώ",704018,164],["ὥσπερ",714163,28],["μόσχος",709029,4],["οὐκ",709805,28],["ἐδιδάχθην",703649,156],["ἐπίστρεψόν",705278,577],["με",708618,163],["καὶ",707031,7],["ἐπιστρέψω",705278,165],["ὅτι",709803,7],["σὺ",712181,164],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133]],"I have heard the sound of Ephraim lamenting, [and saying], Thou hast chastened me, and I was chastened; I as a calf was not [willingly] taught: turn thou me, and I shall turn; for thou [art] the Lord my God."],["19",[["ὅτι",709803,7],["ὕστερον",713273,28],["αἰχμαλωσίας",700499,17],["μου",709032,133],["μετενόησα",708809,155],["καὶ",707031,7],["ὕστερον",713273,28],["τοῦ",709436,20],["γνῶναί",703105,106],["με",708618,163],["ἐστέναξα",712066,155],["ἐφ᾿",705080,0],["ἡμέρας",705984,17],["αἰσχύνης",700483,17],["καὶ",707031,7],["ὑπέδειξά",713192,155],["σοι",711925,159],["ὅτι",709803,7],["ἔλαβον",708076,150],["ὀνειδισμὸν",709657,6],["ἐκ",704132,0],["νεότητός",709258,17],["μου",709032,133]],"For after my captivity I repented; and after I knew, I groaned for the day of shame, and shewed thee that I bore reproach from my youth."],["20",[["υἱὸς",713075,4],["ἀγαπητὸς",700124,14],["Εφραιμ",705769,4],["ἐμοί",704577,159],["παιδίον",709927,25],["ἐντρυφῶν",704810,32],["ὅτι",709803,7],["ἀνθ᾿",701227,0],["ὧν",709781,252],["οἱ",709436,136],["λόγοι",708236,52],["μου",709032,133],["ἐν",704639,0],["αὐτῷ",702165,50],["μνείᾳ",708961,1],["μνησθήσομαι",708923,180],["αὐτοῦ",702165,102],["διὰ",703417,0],["τοῦτο",709858,129],["ἔσπευσα",712011,155],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["ἐλεῶν",704418,72],["ἐλεήσω",704418,165],["αὐτόν",702165,85],["φησὶν",713437,91],["κύριος",707996,4]],"Ephraim is a beloved son, a pleasing child to me: for because my words are in him, I will surely remember him: therefore I made haste [to help] him; I will surely have mercy upon him, saith the Lord."],["21",[["στῆσον",706846,176],["σεαυτήν",711599,104],["Σιων",711816,258],["ποίησον",710582,176],["τιμωρίαν",712863,9],["δὸς",703654,176],["καρδίαν",707141,9],["σου",711945,133],["εἰς",704105,0],["τοὺς",709436,58],["ὤμους",714114,57],["ὁδὸν",709458,9],["ἣν",709781,131],["ἐπορεύθης",710667,168],["ἀποστράφητι",701598,244],["παρθένος",710148,12],["Ισραηλ",706839,18],["ἀποστράφητι",701598,244],["εἰς",704105,0],["τὰς",709436,38],["πόλεις",710612,39],["σου",711945,133],["πενθοῦσα",710251,188]],"Prepare thyself, O Sion; execute vengeance; look to thy ways: return, O virgin of Israel, by the way by which thou wentest, return mourning to thy cities."],["22",[["ἕως",705792,0],["πότε",710696,28],["ἀποστρέψεις",701598,166],["θυγάτηρ",706320,12],["ἠτιμωμένη",702096,451],["ὅτι",709803,7],["ἔκτισεν",707938,2],["κύριος",707996,4],["σωτηρίαν",712658,9],["εἰς",704105,0],["καταφύτευσιν",707486,9],["καινήν",707042,36],["ἐν",704639,0],["σωτηρίᾳ",712658,1],["περιελεύσονται",710314,135],["ἄνθρωποι",701163,52]],"How long, O disgraced daughter, wilt thou turn away? for the Lord has created safety for a new plantation: men shall go about in safety."],["23",[["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["ἔτι",705538,28],["ἐροῦσιν",705415,218],["τὸν",709436,5],["λόγον",708236,6],["τοῦτον",709858,85],["ἐν",704639,0],["γῇ",703083,1],["Ιουδα",706768,18],["καὶ",707031,7],["ἐν",704639,0],["πόλεσιν",710612,76],["αὐτοῦ",702165,102],["ὅταν",709801,28],["ἀποστρέψω",701598,165],["τὴν",709436,8],["αἰχμαλωσίαν",700499,9],["αὐτοῦ",702165,102],["εὐλογημένος",705631,419],["κύριος",707996,4],["ἐπὶ",705080,0],["δίκαιον",703694,27],["ὄρος",709768,25],["τὸ",709436,24],["ἅγιον",700159,46],["αὐτοῦ",702165,102]],"For thus saith the Lord; They shall yet speak this word in the land of Juda, and in the cities thereof, when I shall turn his captivity; blessed be the Lord on his righteous holy mountain!"],["24",[["καὶ",707031,7],["ἐνοικοῦντες",704772,146],["ἐν",704639,0],["ταῖς",709436,75],["πόλεσιν",710612,76],["Ιουδα",706768,18],["καὶ",707031,7],["ἐν",704639,0],["πάσῃ",710177,101],["τῇ",709436,100],["γῇ",703083,1],["αὐτοῦ",702165,102],["ἅμα",700745,28],["γεωργῷ",703082,114],["καὶ",707031,7],["ἀρθήσεται",700473,134],["ἐν",704639,0],["ποιμνίῳ",710598,54]],"And there shall be dwellers in the cities of Juda, and in all his land, together with the husbandman, and [the shepherd] shall go forth with the flock."],["25",[["ὅτι",709803,7],["ἐμέθυσα