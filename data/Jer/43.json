 the Lord, on the fast day; and in the ears of all Juda that come out of their cities, thou shalt read to them."],["7",[["ἴσως",706860,28],["πεσεῖται",710481,93],["ἔλεος",704426,15],["αὐτῶν",702165,40],["κατὰ",707200,0],["πρόσωπον",710986,25],["κυρίου",707996,18],["καὶ",707031,7],["ἀποστρέψουσιν",701598,218],["ἐκ",704132,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["αὐτῶν",702165,40],["τῆς",709436,16],["πονηρᾶς",710660,82],["ὅτι",709803,7],["μέγας",708653,14],["ὁ",709436,3],["θυμὸς",706334,4],["καὶ",707031,7],["ἡ",709436,10],["ὀργὴ",709728,12],["κυρίου",707996,18],["ἣν",709781,131],["ἐλάλησεν",708071,2],["ἐπὶ",705080,0],["τὸν",709436,5],["λαὸν",708094,6],["τοῦτον",709858,85]],"Peradventure their supplication will come before the Lord, and they will turn from their evil way: for great is the wrath and the anger of the Lord, which he has pronounced against this people."],["8",[["καὶ",707031,7],["ἐποίησεν",710582,2],["Βαρουχ",702544,4],["κατὰ",707200,0],["πάντα",710177,68],["ἃ",709781,69],["ἐνετείλατο",704791,23],["αὐτῷ",702165,50],["Ιερεμιας",706611,4],["τοῦ",709436,20],["ἀναγνῶναι",700922,106],["ἐν",704639,0],["τῷ",709436,53],["βιβλίῳ",702719,54],["λόγους",708236,57],["κυρίου",707996,18],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18]],"And Baruch did according to all that Jeremias commanded him—reading in the book the words of the Lord in the Lord's house."],["9",[["καὶ",707031,7],["ἐγενήθη",703104,37],["ἐν",704639,0],["τῷ",709436,53],["ἔτει",705543,54],["τῷ",709436,113],["ὀγδόῳ",709444,30],["βασιλεῖ",702580,114],["Ιωακιμ",706887,114],["τῷ",709436,113],["μηνὶ",708874,114],["τῷ",709436,113],["ἐνάτῳ",704666,30],["ἐξεκκλησίασαν",704895,150],["νηστείαν",709303,9],["κατὰ",707200,0],["πρόσωπον",710986,25],["κυρίου",707996,18],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["οἶκος",709516,4],["Ιουδα",706768,18]],"And it came to pass in the eighth year of king Joakim, in the ninth month, all the people in Jerusalem, and the house of Juda, proclaimed a fast before the Lord."],["10",[["καὶ",707031,7],["ἀνεγίνωσκε",700922,13],["Βαρουχ",702544,4],["ἐν",704639,0],["τῷ",709436,53],["βιβλίῳ",702719,54],["τοὺς",709436,58],["λόγους",708236,57],["Ιερεμιου",706611,18],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18],["ἐν",704639,0],["οἴκῳ",709516,114],["Γαμαριου",702947,18],["υἱοῦ",713075,18],["Σαφαν",711569,18],["τοῦ",709436,35],["γραμματέως",703185,18],["ἐν",704639,0],["τῇ",709436,100],["αὐλῇ",702137,1],["τῇ",709436,100],["ἐπάνω",705030,0],["ἐν",704639,0],["προθύροις",710801,96],["πύλης",711082,17],["τοῦ",709436,35],["οἴκου",709516,18],["κυρίου",707996,18],["τῆς",709436,16],["καινῆς",707042,82],["ἐν",704639,0],["ὠσὶ",704093,271],["παντὸς",710177,116],["τοῦ",709436,35],["λαοῦ",708094,18]],"And Baruch read in the book the words of Jeremias in the house of the Lord, in the house of Gamarias son of Saphan the scribe, in the upper court, in the entrance of the new gate of the house of the Lord, and in the ears of all the people."],["11",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Μιχαιας",708955,4],["υἱὸς",713075,4],["Γαμαριου",702948,18],["υἱοῦ",713075,18],["Σαφαν",711569,18],["ἅπαντας",701362,60],["τοὺς",709436,58],["λόγους",708236,57],["κυρίου",707996,18],["ἐκ",704132,0],["τοῦ",709436,20],["βιβλίου",702719,21]],"And Michæas the son of Gamarias the son of Saphan heard all the words of the Lord, out of the book."],["12",[["καὶ",707031,7],["κατέβη",707202,2],["εἰς",704105,0],["οἶκον",709516,6],["τοῦ",709436,35],["βασιλέως",702580,18],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["γραμματέως",703185,18],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἐκεῖ",704181,28],["πάντες",710177,138],["οἱ",709436,136],["ἄρχοντες",701862,52],["ἐκάθηντο",707000,189],["Ελισαμα",704484,4],["ὁ",709436,3],["γραμματεὺς",703185,4],["καὶ",707031,7],["Δαλαιας",703262,4],["υἱὸς",713075,4],["Σελεμιου",711644,18],["καὶ",707031,7],["Ελναθαν",704526,4],["υἱὸς",713075,4],["Ακχοβωρ",700619,18],["καὶ",707031,7],["Γαμαριας",702946,4],["υἱὸς",713075,4],["Σαφαν",711569,18],["καὶ",707031,7],["Σεδεκιας",711618,4],["υἱὸς",713075,4],["Ανανιου",701016,18],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["ἄρχοντες",701862,52]],"And he went down to the king's house, into the house of the scribe: and, behold, there were sitting there all the princes, Elisama the scribe, and Dalæas the son of Selemias, and Jonathan the son of Acchobor, and Gamarias the son of Saphan, and Sedekias the son of Ananias, and all the princes."],["13",[["καὶ",707031,7],["ἀνήγγειλεν",700921,2],["αὐτοῖς",702165,151],["Μιχαιας",708955,4],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["οὓς",709781,298],["ἤκουσεν",700587,2],["ἀναγινώσκοντος",700922,152],["τοῦ",709436,35],["Βαρουχ",702544,18],["εἰς",704105,0],["τὰ",709436,41],["ὦτα",709852,42],["τοῦ",709436,35],["λαοῦ",708094,18]],"And Michæas reported to them all the words which he had heard Baruch reading in the ears of the people."],["14",[["καὶ",707031,7],["ἀπέστειλαν",701592,150],["πάντες",710177,138],["οἱ",709436,136],["ἄρχοντες",701862,52],["πρὸς",710844,0],["Βαρουχ",702544,6],["υἱὸν",713075,6],["Νηριου",709301,18],["τὸν",709436,5],["Ιουδιν",706778,6],["υἱὸν",713075,6],["Ναθανιου",709168,18],["υἱοῦ",713075,18],["Σελεμιου",711644,18],["υἱοῦ",713075,18],["Χουσι",713933,18],["λέγοντες",708124,146],["τὸ",709436,129],["χαρτίον",713755,25],["ἐν",704639,0],["ᾧ",709781,209],["σὺ",712181,164],["ἀναγινώσκεις",700922,154],["ἐν",704639,0],["αὐτῷ",702165,280],["ἐν",704639,0],["ὠσὶ",704093,271],["τοῦ",709436,35],["λαοῦ",708094,18],["λαβὲ",708076,176],["αὐτὸ",702165,129],["εἰς",704105,0],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133],["καὶ",707031,7],["ἧκε",706696,2],["καὶ",707031,7],["ἔλαβεν",708076,2],["Βαρουχ",702544,4],["τὸ",709436,24],["χαρτίον",713755,25],["καὶ",707031,7],["κατέβη",707202,2],["πρὸς",710844,0],["αὐτούς",702165,62]],"And all the princes sent to Baruch son of Nerias Judin the son of Nathanias, the son of Selemias, the son of Chusi, saying, Take in thine hand the roll in which thou readest in the ears of the people, and come. So Baruch took the roll, and went down to them."],["15",[["καὶ",707031,7],["εἶπαν",705373,150],["αὐτῷ",702165,50],["πάλιν",709942,28],["ἀνάγνωθι",700922,176],["εἰς",704105,0],["τὰ",709436,41],["ὦτα",709852,42],["ἡμῶν",705999,145],["καὶ",707031,7],["ἀνέγνω",700922,2],["Βαρουχ",702544,4]],"And they said to him, Read [it] again in our ears. And Baruch read [it]."],["16",[["καὶ",707031,7],["ἐγενήθη",703104,37],["ὡς",714148,7],["ἤκουσαν",700587,150],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["συνεβουλεύσαντο",712292,189],["ἕκαστος",704133,14],["πρὸς",710844,0],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπαν",705373,150],["ἀναγγέλλοντες",700921,146],["ἀναγγείλωμεν",700921,79],["τῷ",709436,113],["βασιλεῖ",702580,114],["ἅπαντας",701362,60],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62]],"And it came to pass, when they [had] heard all the words, [that] they took counsel each with his neighbour, and said, Let us by all means tell the king all these words."],["17",[["καὶ",707031,7],["τὸν",709436,5],["Βαρουχ",702544,6],["ἠρώτησαν",705459,150],["λέγοντες",708124,146],["πόθεν",710580,28],["ἔγραψας",703194,162],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62]],"And they asked Baruch, saying, Where didst thou write all these words?"],["18",[["καὶ",707031,7],["εἶπεν",705373,2],["Βαρουχ",702544,4],["ἀπὸ",701425,0],["στόματος",712125,21],["αὐτοῦ",702165,102],["ἀνήγγειλέν",700921,2],["μοι",708974,159],["Ιερεμιας",706611,4],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["καὶ",707031,7],["ἔγραφον",703194,137],["ἐν",704639,0],["βιβλίῳ",702719,54]],"And Baruch said, Jeremias told me from his [own] mouth all these words, and I wrote them in a book."],["19",[["καὶ",707031,7],["εἶπαν",705373,150],["τῷ",709436,113],["Βαρουχ",702544,114],["βάδισον",702367,176],["κατακρύβηθι",707292,244],["σὺ",712181,164],["καὶ",707031,7],["Ιερεμιας",706611,4],["ἄνθρωπος",701163,4],["μὴ",708851,28],["γνώτω",703105,45],["ποῦ",710706,28],["ὑμεῖς",713081,219]],"And they said to Baruch, Go, and hide, thou and Jeremias; let no man know where ye [are]."],["20",[["καὶ",707031,7],["εἰσῆλθον",704114,150],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["εἰς",704105,0],["τὴν",709436,8],["αὐλήν",702137,9],["καὶ",707031,7],["τὸ",709436,24],["χαρτίον",713755,25],["ἔδωκαν",703654,150],["φυλάσσειν",713619,55],["ἐν",704639,0],["οἴκῳ",709516,114],["Ελισαμα",704484,18],["καὶ",707031,7],["ἀνήγγειλαν",700921,150],["τῷ",709436,113],["βασιλεῖ",702580,114],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57]],"And they went in to the king into the court, and gave the roll [to one] to keep in the house of Elisama; and they told the king all these words."],["21",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["τὸν",709436,5],["Ιουδιν",706778,6],["λαβεῖν",708076,106],["τὸ",709436,24],["χαρτίον",713755,25],["καὶ",707031,7],["ἔλαβεν",708076,2],["αὐτὸ",702165,129],["ἐξ",704132,0],["οἴκου",709516,18],["Ελισαμα",704484,18],["καὶ",707031,7],["ἀνέγνω",700922,2],["Ιουδιν",706778,4],["εἰς",704105,0],["τὰ",709436,41],["ὦτα",709852,42],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["εἰς",704105,0],["τὰ",709436,41],["ὦτα",709852,42],["πάντων",710177,169],["τῶν",709436,80],["ἀρχόντων",701862,81],["τῶν",709436,80],["ἑστηκότων",706846,387],["περὶ",710285,0],["τὸν",709436,5],["βασιλέα",702580,6]],"And the king sent Judin to fetch the roll: and he took it out of the house of Elisama: and Judin read in the ears of the king, and in the ears of all the princes who stood round the king."],["22",[["καὶ",707031,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐκάθητο",707000,23],["ἐν",704639,0],["οἴκῳ",709516,114],["χειμερινῷ",713784,30],["καὶ",707031,7],["ἐσχάρα",705514,12],["πυρὸς",711088,21],["κατὰ",707200,0],["πρόσωπον",710986,25],["αὐτοῦ",702165,102]],"Now the king was sitting in the winter house: and [there was] a fire on the hearth before him."],["23",[["καὶ",707031,7],["ἐγενήθη",703104,37],["ἀναγινώσκοντος",700922,152],["Ιουδιν",706778,4],["τρεῖς",712927,659],["σελίδας",711651,39],["καὶ",707031,7],["τέσσαρας",712808,60],["ἀπέτεμνεν",701611,13],["αὐτὰς",702165,231],["τῷ",709436,53],["ξυρῷ",709433,54],["τοῦ",709436,35],["γραμματέως",703185,18],["καὶ",707031,7],["ἔρριπτεν",711267,2],["εἰς",704105,0],["τὸ",709436,24],["πῦρ",711088,25],["τὸ",709436,24],["ἐπὶ",705080,0],["τῆς",709436,16],["ἐσχάρας",705514,17],["ἕως",705792,0],["ἐξέλιπεν",704237,2],["πᾶς",710177,14],["ὁ",709436,3],["χάρτης",713754,4],["εἰς",704105,0],["τὸ",709436,24],["πῦρ",711088,25],["τὸ",709436,24],["ἐπὶ",705080,0],["τῆς",709436,16],["ἐσχάρας",705514,17]],"And it came to pass when Judin had read three or four leaves, he cut them off with a penknife, and cast [them] into the fire that was on the hearth, until the whole roll was consumed in the fire that was on the hearth."],["24",[["καὶ",707031,7],["οὐκ",709805,28],["ἐζήτησαν",705879,150],["καὶ",707031,7],["οὐ",709805,28],["διέρρηξαν",703565,150],["τὰ",709436,41],["ἱμάτια",706742,42],["αὐτῶν",702165,40],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["οἱ",709436,136],["παῖδες",709932,52],["αὐτοῦ",702165,102],["οἱ",709436,136],["ἀκούοντες",700587,146],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62]],"And the king and his servants that heard all these words sought not [the Lord], and rent not their garments."],["25",[["καὶ",707031,7],["Ελναθαν",704526,4],["καὶ",707031,7],["Γοδολιας",703148,4],["καὶ",707031,7],["Γαμαριας",702946,4],["ὑπέθεντο",713251,23],["τῷ",709436,113],["βασιλεῖ",702580,114],["πρὸς",710844,0],["τὸ",709436,24],["μὴ",708851,28],["κατακαῦσαι",707258,106],["τὸ",709436,24],["χαρτίον",713755,25]],"But Elnathan and Godolias suggested to the king that he should burn the roll."],["26",[["καὶ",707031,7],["ἐνετείλατο",704791,23],["ὁ",709436,3],["βασιλεὺς",702580,4],["τῷ",709436,113],["Ιερεμεηλ",706610,114],["υἱῷ",713075,114],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["τῷ",709436,113],["Σαραια",711517,114],["υἱῷ",713075,114],["Εσριηλ",705507,18],["συλλαβεῖν",712262,106],["τὸν",709436,5],["Βαρουχ",702544,6],["καὶ",707031,7],["τὸν",709436,5],["Ιερεμιαν",706611,6],["καὶ",707031,7],["κατεκρύβησαν",707292,99]],"And the king commanded Jeremeel the king's son, and Saræas the son of Esriel, to take Baruch and Jeremias: but they were hidden."],["27",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρὸς",710844,0],["Ιερεμιαν",706611,6],["μετὰ",708780,0],["τὸ",709436,24],["κατακαῦσαι",707258,106],["τὸν",709436,5],["βασιλέα",702580,6],["τὸ",709436,24],["χαρτίον",713755,25],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["οὓς",709781,298],["ἔγραψεν",703194,2],["Βαρουχ",702544,4],["ἀπὸ",701425,0],["στόματος",712125,21],["Ιερεμιου",706611,18],["λέγων",708124,72]],"Then the word of the Lord came to Jeremias, after the king had burnt the roll, [even] all the words which Baruch wrote from the mouth of Jeremias, saying,"],["28",[["πάλιν",709942,28],["λαβὲ",708076,176],["σὺ",712181,164],["χαρτίον",713755,25],["ἕτερον",705535,46],["καὶ",707031,7],["γράψον",703194,176],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["τοὺς",709436,58],["ὄντας",704093,235],["ἐπὶ",705080,0],["τοῦ",709436,20],["χαρτίου",713755,21],["οὓς",709781,298],["κατέκαυσεν",707258,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ιωακιμ",706887,4]],"Again take thou another roll, and write all the words that were on the roll, which king Joakim has burnt."],["29",[["καὶ",707031,7],["ἐρεῖς",705415,166],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["σὺ",712181,164],["κατέκαυσας",707258,162],["τὸ",709436,24],["χαρτίον",713755,25],["τοῦτο",709858,129],["λέγων",708124,72],["διὰ",703417,0],["τί",712867,126],["ἔγραψας",703194,162],["ἐπ᾿",705080,0],["αὐτῷ",702165,280],["λέγων",708124,72],["εἰσπορευόμενος",704124,122],["εἰσπορεύσεται",704124,93],["ὁ",709436,3],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,17],["καὶ",707031,7],["ἐξολεθρεύσει",704956,127],["τὴν",709436,8],["γῆν",703083,9],["ταύτην",709858,104],["καὶ",707031,7],["ἐκλείψει",704237,127],["ἀπ᾿",701425,0],["αὐτῆς",702165,86],["ἄνθρωπος",701163,4],["καὶ",707031,7],["κτήνη",707934,64]],"And thou shalt say, Thus saith the Lord; Thou hast burnt this roll, saying, Why hast thou written therein, saying, The king of Babylon shall certainly come in, and destroy this land, and man and cattle shall fail from off it?"],["30",[["διὰ",703417,0],["τοῦτο",709858,129],["οὕτως",709859,28],["εἶπεν",705373,2],["κύριος",707996,4],["ἐπὶ",705080,0],["Ιωακιμ",706887,6],["βασιλέα",702580,6],["Ιουδα",706768,18],["οὐκ",709805,28],["ἔσται",704093,93],["αὐτῷ",702165,50],["καθήμενος",707000,122],["ἐπὶ",705080,0],["θρόνου",706315,18],["Δαυιδ",703232,18],["καὶ",707031,7],["τὸ",709436,34],["θνησιμαῖον",706277,26],["αὐτοῦ",702165,102],["ἔσται",704093,93],["ἐρριμμένον",711267,327],["ἐν",704639,0],["τῷ",709436,53],["καύματι",707564,54],["τῆς",709436,16],["ἡμέρας",705984,17],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["παγετῷ",709908,114],["τῆς",709436,16],["νυκτός",709386,17]],"Therefore thus saith the Lord concerning Joakim king of Juda; He shall not have [a man] to sit on the throne of David: and his carcase shall be cast forth in the heat by day, and in the frost by night."],["31",[["καὶ",707031,7],["ἐπισκέψομαι",705250,181],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸ",709436,24],["γένος",703057,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπὶ",705080,0],["τοὺς",709436,58],["παῖδας",709932,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπάξω",704994,165],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἐπὶ",705080,0],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["ἐπὶ",705080,0],["γῆν",703083,9],["Ιουδα",706768,18],["πάντα",710177,68],["τὰ",709436,41],["κακά",707066,68],["ἃ",709781,69],["ἐλάλησα",708071,155],["πρὸς",710844,0],["αὐτοὺς",702165,62],["καὶ",707031,7],["οὐκ",709805,28],["ἤκουσαν",700587,150]],"And I will visit him, and his family, and his servants: and I will bring upon him, and upon the inhabitants of Jerusalem, and upon the land of Juda, all the evils which I spoke of to them; and they hearkened not."],["32",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Βαρουχ",702544,4],["χαρτίον",713755,25],["ἕτερον",705535,46],["καὶ",707031,7],["ἔγραψεν",703194,2],["ἐπ᾿",705080,0],["αὐτῷ",702165,280],["ἀπὸ",701425,0],["στόματος",712125,21],["Ιερεμιου",706611,18],["ἅπαντας",701362,60],["τοὺς",709436,58],["λόγους",708236,57],["τοῦ",709436,20],["βιβλίου",702719,21],["οὗ",709781,48],["κατέκαυσεν",707258,2],["Ιωακιμ",706887,4],["καὶ",707031,7],["ἔτι",705538,28],["προσετέθησαν",710965,99],["αὐτῷ",702165,50],["λόγοι",708236,52],["πλείονες",710514,138],["ὡς",714148,7],["οὗτοι",709858,201]],"And Baruch took another roll, and wrote upon it from the mouth of Jeremias all the words of the book which Joakim had burnt: and there were yet more words added to it like the former."]]