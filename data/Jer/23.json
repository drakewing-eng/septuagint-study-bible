[["1",[["ὦ",714081,88],["οἱ",709436,136],["ποιμένες",710596,52],["οἱ",709436,136],["διασκορπίζοντες",703579,146],["καὶ",707031,7],["ἀπολλύοντες",701513,146],["τὰ",709436,41],["πρόβατα",710768,42],["τῆς",709436,16],["νομῆς",709337,17],["μου",709032,133]],"Woe to the shepherds that destroy and scatter the sheep of their pasture!"],["2",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἐπὶ",705080,0],["τοὺς",709436,58],["ποιμαίνοντας",710594,235],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["ὑμεῖς",713081,219],["διεσκορπίσατε",703579,265],["τὰ",709436,41],["πρόβατά",710768,42],["μου",709032,133],["καὶ",707031,7],["ἐξώσατε",704985,74],["αὐτὰ",702165,71],["καὶ",707031,7],["οὐκ",709805,28],["ἐπεσκέψασθε",705250,345],["αὐτά",702165,71],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐκδικῶ",704174,165],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["κατὰ",707200,0],["τὰ",709436,41],["πονηρὰ",710660,68],["ἐπιτηδεύματα",705301,42],["ὑμῶν",713091,145]],"Therefore thus saith the Lord against them that tend my people; Ye have scattered my sheep, and driven them out, and ye have not visited them: behold, I [will] take vengeance upon you according to your evil practices."],["3",[["καὶ",707031,7],["ἐγὼ",704018,164],["εἰσδέξομαι",704111,181],["τοὺς",709436,58],["καταλοίπους",707317,60],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133],["ἀπὸ",701425,0],["πάσης",710177,82],["τῆς",709436,16],["γῆς",703083,17],["οὗ",709806,28],["ἐξῶσα",704985,155],["αὐτοὺς",702165,62],["ἐκεῖ",704181,28],["καὶ",707031,7],["καταστήσω",707011,165],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὴν",709436,8],["νομὴν",709337,9],["αὐτῶν",702165,40],["καὶ",707031,7],["αὐξηθήσονται",702144,144],["καὶ",707031,7],["πληθυνθήσονται",710530,144]],"And I will gather in the remnant of my people in every land, whither I have driven them out, and will set them in their pasture; and they shall increase and be multiplied."],["4",[["καὶ",707031,7],["ἀναστήσω",701173,165],["αὐτοῖς",702165,151],["ποιμένας",710596,57],["οἳ",709781,250],["ποιμανοῦσιν",710594,218],["αὐτούς",702165,62],["καὶ",707031,7],["οὐ",709805,28],["φοβηθήσονται",713532,144],["ἔτι",705538,28],["οὐδὲ",709816,7],["πτοηθήσονται",711062,144],["λέγει",708124,91],["κύριος",707996,4]],"And I will raise up shepherds to them, who shall feed them: and they shall fear no more, nor be alarmed, saith the Lord."],["5",[["ἰδοὺ",706497,88],["ἡμέραι",705984,191],["ἔρχονται",705453,269],["λέγει",708124,91],["κύριος",707996,4],["καὶ",707031,7],["ἀναστήσω",701173,165],["τῷ",709436,113],["Δαυιδ",703232,114],["ἀνατολὴν",701071,9],["δικαίαν",703694,36],["καὶ",707031,7],["βασιλεύσει",702581,127],["βασιλεὺς",702580,4],["καὶ",707031,7],["συνήσει",712481,127],["καὶ",707031,7],["ποιήσει",710582,127],["κρίμα",707903,25],["καὶ",707031,7],["δικαιοσύνην",703695,9],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"Behold, the days come, saith the Lord, when I will raise up to David a righteous branch, and a king shall reign and understand, and shall execute judgment and righteousness on the earth."],["6",[["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["αὐτοῦ",702165,102],["σωθήσεται",712627,134],["Ιουδας",706775,4],["καὶ",707031,7],["Ισραηλ",706839,4],["κατασκηνώσει",707423,127],["πεποιθώς",710221,270],["καὶ",707031,7],["τοῦτο",709858,132],["τὸ",709436,34],["ὄνομα",709666,15],["αὐτοῦ",702165,102],["ὃ",709781,33],["καλέσει",707084,127],["αὐτὸν",702165,85],["κύριος",707996,4],["Ιωσεδεκ",706944,4]],"In his days both Juda shall be saved, and Israel shall dwell securely: and this is his name, which the Lord shall call him, Josedec among the prophets."],["9",[["ἐν",704639,0],["τοῖς",709436,147],["προφήταις",711009,148],["συνετρίβη",712520,37],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["ἐν",704639,0],["ἐμοὶ",704577,159],["ἐσαλεύθη",711403,37],["πάντα",710177,195],["τὰ",709436,63],["ὀστᾶ",709792,64],["μου",709032,133],["ἐγενήθην",703104,156],["ὡς",714148,7],["ἀνὴρ",701150,4],["συντετριμμένος",712520,419],["καὶ",707031,7],["ὡς",714148,7],["ἄνθρωπος",701163,4],["συνεχόμενος",712469,122],["ἀπὸ",701425,0],["οἴνου",709530,18],["ἀπὸ",701425,0],["προσώπου",710986,21],["κυρίου",707996,18],["καὶ",707031,7],["ἀπὸ",701425,0],["προσώπου",710986,21],["εὐπρεπείας",705666,17],["δόξης",703791,17],["αὐτοῦ",702165,102]],"My heart is broken within me; all my bones are shaken: I am become as a broken-down man, and as a man overcome with wine, because of the Lord, and because of the excellence of his glory."],["10",[["ὅτι",709803,7],["ἀπὸ",701425,0],["προσώπου",710986,21],["τούτων",709858,40],["ἐπένθησεν",710251,2],["ἡ",709436,10],["γῆ",703083,12],["ἐξηράνθησαν",709419,99],["αἱ",709436,190],["νομαὶ",709337,191],["τῆς",709436,16],["ἐρήμου",705420,17],["καὶ",707031,7],["ἐγένετο",703104,23],["ὁ",709436,3],["δρόμος",703833,4],["αὐτῶν",702165,40],["πονηρὸς",710660,14],["καὶ",707031,7],["ἡ",709436,10],["ἰσχὺς",706858,12],["αὐτῶν",702165,40],["οὐχ",709805,28],["οὕτως",709859,28]],"For because of these things the land mourns; the pastures of the wilderness are dried up; and their course is become evil, and so [also] their strength."],["11",[["ὅτι",709803,7],["ἱερεὺς",706614,4],["καὶ",707031,7],["προφήτης",711009,4],["ἐμολύνθησαν",708987,99],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["μου",709032,133],["εἶδον",709725,155],["πονηρίας",710659,39],["αὐτῶν",702165,40]],"For priest and prophet are defiled; and I have seen their iniquities in my house."],["12",[["διὰ",703417,0],["τοῦτο",709858,129],["γενέσθω",703104,315],["ἡ",709436,10],["ὁδὸς",709458,12],["αὐτῶν",702165,40],["αὐτοῖς",702165,151],["εἰς",704105,0],["ὀλίσθημα",709580,25],["ἐν",704639,0],["γνόφῳ",703131,114],["καὶ",707031,7],["ὑποσκελισθήσονται",713239,144],["καὶ",707031,7],["πεσοῦνται",710481,135],["ἐν",704639,0],["αὐτῇ",702165,105],["διότι",703734,7],["ἐπάξω",704994,165],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["κακὰ",707066,68],["ἐν",704639,0],["ἐνιαυτῷ",704745,114],["ἐπισκέψεως",705252,17],["αὐτῶν",702165,40],["φησὶν",713437,91],["κύριος",707996,4]],"Therefore let their way be to them slippery and dark: and they shall be tripped up and fall in it: for I will bring evils upon them, in the year of their visitation."],["13",[["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["προφήταις",711009,148],["Σαμαρείας",711449,17],["εἶδον",709725,155],["ἀνομήματα",701191,42],["ἐπροφήτευσαν",711008,150],["διὰ",703417,0],["τῆς",709436,16],["Βααλ",702333,17],["καὶ",707031,7],["ἐπλάνησαν",710495,150],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["Ισραηλ",706839,6]],"And in the prophets of Samaria I have seen lawless deeds; they prophesied by Baal, and led my people Israel astray."],["14",[["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["προφήταις",711009,148],["Ιερουσαλημ",706644,17],["ἑώρακα",709725,89],["φρικτά",713581,68],["μοιχωμένους",708976,236],["καὶ",707031,7],["πορευομένους",710667,236],["ἐν",704639,0],["ψεύδεσι",714036,230],["καὶ",707031,7],["ἀντιλαμβανομένους",701243,236],["χειρῶν",713787,65],["πονηρῶν",710660,169],["τοῦ",709436,20],["μὴ",708851,28],["ἀποστραφῆναι",701598,179],["ἕκαστον",704133,27],["ἀπὸ",701425,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["αὐτοῦ",702165,102],["τῆς",709436,16],["πονηρᾶς",710660,82],["ἐγενήθησάν",703104,99],["μοι",708974,159],["πάντες",710177,138],["ὡς",714148,7],["Σοδομα",711920,12],["καὶ",707031,7],["οἱ",709436,136],["κατοικοῦντες",707534,146],["αὐτὴν",702165,104],["ὥσπερ",714163,28],["Γομορρα",703165,12]],"Also in the prophets of Jerusalem I have seen horrible things: as they committed adultery, and walked in lies, and strengthened the hands of many, that they should not return each from his evil way: they are all become to me as Sodoma, and the inhabitants thereof as Gomorrha."],["15",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ψωμιῶ",714077,165],["αὐτοὺς",702165,62],["ὀδύνην",709463,9],["καὶ",707031,7],["ποτιῶ",710700,165],["αὐτοὺς",702165,62],["ὕδωρ",713071,25],["πικρόν",710475,46],["ὅτι",709803,7],["ἀπὸ",701425,0],["τῶν",709436,80],["προφητῶν",711009,81],["Ιερουσαλημ",706644,17],["ἐξῆλθεν",704909,2],["μολυσμὸς",708988,4],["πάσῃ",710177,101],["τῇ",709436,100],["γῇ",703083,1]],"Therefore thus saith the Lord; Behold, I will feed them with pain, and give them bitter water to drink: for from the prophets of Jerusalem has defilement gone forth [into] all the land."],["16",[["οὕτως",709859,28],["λέγει",708124,91],["κύριος",707996,4],["παντοκράτωρ",709986,4],["μὴ",708851,28],["ἀκούετε",700587,335],["τοὺς",709436,58],["λόγους",708236,57],["τῶν",709436,80],["προφητῶν",711009,81],["ὅτι",709803,7],["ματαιοῦσιν",708578,197],["ἑαυτοῖς",703917,151],["ὅρασιν",709721,9],["ἀπὸ",701425,0],["καρδίας",707141,17],["αὐτῶν",702165,40],["λαλοῦσιν",708071,197],["καὶ",707031,7],["οὐκ",709805,28],["ἀπὸ",701425,0],["στόματος",712125,21],["κυρίου",707996,18]],"Thus saith the Lord Almighty, Hearken not to the words of the prophets: for they frame a vain vision for themselves; they speak from their own heart, and not from the mouth of the Lord."],["17",[["λέγουσιν",708124,197],["τοῖς",709436,147],["ἀπωθουμένοις",701659,341],["τὸν",709436,5],["λόγον",708236,6],["κυρίου",707996,18],["εἰρήνη",704098,12],["ἔσται",704093,93],["ὑμῖν",713084,90],["καὶ",707031,7],["πᾶσιν",710177,230],["τοῖς",709436,147],["πορευομένοις",710667,341],["τοῖς",709436,95],["θελήμασιν",706170,96],["αὐτῶν",702165,40],["παντὶ",710177,30],["τῷ",709436,113],["πορευομένῳ",710667,241],["πλάνῃ",710496,1],["καρδίας",707141,17],["αὐτοῦ",702165,102],["εἶπαν",705373,150],["οὐχ",709805,28],["ἥξει",705956,127],["ἐπὶ",705080,0],["σὲ",711598,163],["κακά",707066,195]],"They say to them that reject the word of the Lord, There shall be peace to you; and to all that walk after their own lusts, and to every one that walks in the error of his heart, they have said, No evil shall come upon thee."],["18",[["ὅτι",709803,7],["τίς",712867,158],["ἔστη",706846,2],["ἐν",704639,0],["ὑποστήματι",713243,54],["κυρίου",707996,18],["καὶ",707031,7],["εἶδεν",709725,2],["τὸν",709436,5],["λόγον",708236,6],["αὐτοῦ",702165,102],["τίς",712867,158],["ἐνωτίσατο",704825,23],["καὶ",707031,7],["ἤκουσεν",700587,2]],"For who has stood in the counsel of the Lord, and seen his word? who has hearkened, and heard?"],["19",[["ἰδοὺ",706497,88],["σεισμὸς",711632,4],["παρὰ",709995,0],["κυρίου",707996,18],["καὶ",707031,7],["ὀργὴ",709728,12],["ἐκπορεύεται",704293,117],["εἰς",704105,0],["συσσεισμόν",712553,6],["συστρεφομένη",712562,211],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἀσεβεῖς",701909,60],["ἥξει",705956,127]],"Behold, [there is] an earthquake from the Lord, and anger proceeds to a convulsion, it shall come violently upon the ungodly."],["20",[["καὶ",707031,7],["οὐκέτι",709827,28],["ἀποστρέψει",701598,127],["ὁ",709436,3],["θυμὸς",706334,4],["κυρίου",707996,18],["ἕως",705792,7],["ἂν",700900,11],["ποιήσῃ",710582,172],["αὐτὸ",702165,129],["καὶ",707031,7],["ἕως",705792,7],["ἂν",700900,11],["ἀναστήσῃ",701173,172],["αὐτὸ",702165,129],["ἀπὸ",701425,0],["ἐγχειρήματος",704012,21],["καρδίας",707141,17],["αὐτοῦ",702165,102],["ἐπ᾿",705080,0],["ἐσχάτου",705519,92],["τῶν",709436,130],["ἡμερῶν",705984,65],["νοήσουσιν",709327,218],["αὐτά",702165,71]],"And the Lord's wrath shall return no more, until he have accomplished it, and until he have established it, according to the purpose of his heart: at the end of the days they shall understand it."],["21",[["οὐκ",709805,28],["ἀπέστελλον",701592,333],["τοὺς",709436,58],["προφήτας",711009,57],["καὶ",707031,7],["αὐτοὶ",702165,201],["ἔτρεχον",712931,137],["οὐκ",709805,28],["ἐλάλησα",708071,155],["πρὸς",710844,0],["αὐτούς",702165,62],["καὶ",707031,7],["αὐτοὶ",702165,201],["ἐπροφήτευον",711008,137]],"I sent not the prophets, yet they ran: neither spoke I to them, yet they prophesied."],["22",[["καὶ",707031,7],["εἰ",704071,7],["ἔστησαν",706846,150],["ἐν",704639,0],["τῇ",709436,100],["ὑποστάσει",713241,1],["μου",709032,133],["καὶ",707031,7],["εἰσήκουσαν",704108,150],["τῶν",709436,80],["λόγων",708236,81],["μου",709032,133],["καὶ",707031,7],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["ἂν",700900,11],["ἀπέστρεφον",701598,137],["αὐτοὺς",702165,62],["ἀπὸ",701425,0],["τῶν",709436,43],["πονηρῶν",710660,83],["ἐπιτηδευμάτων",705301,44],["αὐτῶν",702165,40]],"But if they had stood in my counsel, and if they had hearkened to my words, then would they have turned my people from their evil practices."],["23",[["θεὸς",706192,4],["ἐγγίζων",703939,72],["ἐγώ",704018,164],["εἰμι",704093,157],["λέγει",708124,91],["κύριος",707996,4],["καὶ",707031,7],["οὐχὶ",709862,28],["θεὸς",706192,4],["πόρρωθεν",710681,28]],"I am a God nigh at hand, saith the Lord, and not a God afar off."],["24",[["εἰ",704071,7],["κρυβήσεται",707923,134],["ἄνθρωπος",701163,4],["ἐν",704639,0],["κρυφαίοις",707927,230],["καὶ",707031,7],["ἐγὼ",704018,164],["οὐκ",709805,28],["ὄψομαι",709725,181],["αὐτόν",702165,85],["μὴ",708851,28],["οὐχὶ",709862,28],["τὸν",709436,5],["οὐρανὸν",709844,6],["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9],["ἐγὼ",704018,164],["πληρῶ",710543,165],["λέγει",708124,91],["κύριος",707996,4]],"Shall any one hide himself in secret places, and I not see him? Do I not fill heaven and earth? saith the Lord."],["25",[["ἤκουσα",700587,155],["ἃ",709781,69],["λαλοῦσιν",708071,197],["οἱ",709436,136],["προφῆται",711009,52],["ἃ",709781,69],["προφητεύουσιν",711008,197],["ἐπὶ",705080,0],["τῷ",709436,53],["ὀνόματί",709666,54],["μου",709032,133],["ψευδῆ",714036,68],["λέγοντες",708124,146],["ἠνυπνιασάμην",704816,161],["ἐνύπνιον",704818,25]],"I have heard what the prophets say, what they prophesy in my name, saying falsely, I have seen a night vision."],["26",[["ἕως",705792,7],["πότε",710696,28],["ἔσται",704093,93],["ἐν",704639,0],["καρδίᾳ",707141,1],["τῶν",709436,80],["προφητῶν",711009,81],["τῶν",709436,80],["προφητευόντων",711008,170],["ψευδῆ",714036,68],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["προφητεύειν",711008,55],["αὐτοὺς",702165,62],["τὰ",709436,41],["θελήματα",706170,42],["καρδίας",707141,17],["αὐτῶν",702165,40]],"How long shall [these things] be in the heart of the prophets that prophesy lies, when they prophesy the purposes of their own heart?"],["27",[["τῶν",709436,80],["λογιζομένων",708232,299],["τοῦ",709436,20],["ἐπιλαθέσθαι",705187,109],["τοῦ",709436,35],["νόμου",709349,18],["μου",709032,133],["ἐν",704639,0],["τοῖς",709436,95],["ἐνυπνίοις",704818,96],["αὐτῶν",702165,40],["ἃ",709781,69],["διηγοῦντο",703679,139],["ἕκαστος",704133,14],["τῷ",709436,113],["πλησίον",710547,28],["αὐτοῦ",702165,102],["καθάπερ",706984,28],["ἐπελάθοντο",705187,189],["οἱ",709436,136],["πατέρες",710189,52],["αὐτῶν",702165,40],["τοῦ",709436,20],["ὀνόματός",709666,21],["μου",709032,133],["ἐν",704639,0],["τῇ",709436,100],["Βααλ",702333,1]],"who devise that [men] may forget my law by their dreams, which they have told every one to his neighbour, as their fathers forgot my name in [the worship of] Baal."],["28",[["ὁ",709436,3],["προφήτης",711009,4],["ἐν",704639,0],["ᾧ",709781,309],["τὸ",709436,34],["ἐνύπνιόν",704818,15],["ἐστιν",704093,91],["διηγησάσθω",703679,315],["τὸ",709436,24],["ἐνύπνιον",704818,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["ᾧ",709781,309],["ὁ",709436,3],["λόγος",708236,4],["μου",709032,133],["πρὸς",710844,0],["αὐτόν",702165,85],["διηγησάσθω",703679,315],["τὸν",709436,5],["λόγον",708236,6],["μου",709032,133],["ἐπ᾿",705080,0],["ἀληθείας",700656,17],["τί",712867,126],["τὸ",709436,24],["ἄχυρον",702316,25],["πρὸς",710844,0],["τὸν",709436,5],["σῖτον",711814,6],["οὕτως",709859,28],["οἱ",709436,136],["λόγοι",708236,52],["μου",709032,133],["λέγει",708124,91],["κύριος",707996,4]],"The prophet who has a dream, let him tell his dream; and [he] in whom is my word [spoken] to him, let him tell my word truly: what is the chaff to the corn? so are my words, saith the Lord."],["29",[["οὐχὶ",709862,28],["οἱ",709436,136],["λόγοι",708236,52],["μου",709032,133],["ὥσπερ",714163,28],["πῦρ",711088,15],["φλέγον",713518,32],["λέγει",708124,91],["κύριος",707996,4],["καὶ",707031,7],["ὡς",714148,7],["πέλυξ",710243,4],["κόπτων",707829,72],["πέτραν",710443,9]],"Behold, are not my words as fire? saith the Lord; and as an axe cutting the rock?"],["30",[["διὰ",703417,0],["τοῦτο",709858,129],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["πρὸς",710844,0],["τοὺς",709436,58],["προφήτας",711009,57],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["τοὺς",709436,58],["κλέπτοντας",707715,235],["τοὺς",709436,58],["λόγους",708236,57],["μου",709032,133],["ἕκαστος",704133,14],["παρὰ",709995,0],["τοῦ",709436,35],["πλησίον",710547,28],["αὐτοῦ",702165,102]],"Behold, I am therefore against the prophets, saith the Lord God, that steal my words every one from his neighbour."],["31",[["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["πρὸς",710844,0],["τοὺς",709436,58],["προφήτας",711009,57],["τοὺς",709436,58],["ἐκβάλλοντας",704145,235],["προφητείας",711007,39],["γλώσσης",703120,17],["καὶ",707031,7],["νυστάζοντας",709390,235],["νυσταγμὸν",709389,6],["ἑαυτῶν",703917,40]],"Behold, I am against the prophets that put forth prophecies of mere words, and slumber their sleep."],["32",[["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["πρὸς",710844,0],["τοὺς",709436,58],["προφήτας",711009,57],["τοὺς",709436,58],["προφητεύοντας",711008,235],["ἐνύπνια",704818,42],["ψευδῆ",714036,68],["καὶ",707031,7],["διηγοῦντο",703679,139],["αὐτὰ",702165,71],["καὶ",707031,7],["ἐπλάνησαν",710495,150],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["ἐν",704639,0],["τοῖς",709436,95],["ψεύδεσιν",714036,94],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["πλάνοις",710500,148],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐγὼ",704018,164],["οὐκ",709805,28],["ἀπέστειλα",701592,155],["αὐτοὺς",702165,62],["καὶ",707031,7],["οὐκ",709805,28],["ἐνετειλάμην",704791,161],["αὐτοῖς",702165,151],["καὶ",707031,7],["ὠφέλειαν",714170,9],["οὐκ",709805,28],["ὠφελήσουσιν",714171,218],["τὸν",709436,5],["λαὸν",708094,6],["τοῦτον",709858,85]],"Therefore, behold, I am against the prophets that prophesy false dreams, and have not told them [truly], and have caused my people to err by their lies, and by their errors; yet I sent them not, and commanded them not; therefore, they shall not profit this people at all."],["33",[["καὶ",707031,7],["ἐὰν",703912,7],["ἐρωτήσωσί",705459,234],["σε",711598,163],["ὁ",709436,3],["λαὸς",708094,4],["οὗτος",709858,121],["ἢ",705924,7],["ἱερεὺς",706614,4],["ἢ",705924,7],["προφήτης",711009,4],["λέγων",708124,72],["τί",712867,132],["τὸ",709436,34],["λῆμμα",708175,15],["κυρίου",707996,18],["καὶ",707031,7],["ἐρεῖς",705415,166],["αὐτοῖς",702165,151],["ὑμεῖς",713081,219],["ἐστε",704093,87],["τὸ",709436,34],["λῆμμα",708175,15],["καὶ",707031,7],["ῥάξω",711191,165],["ὑμᾶς",713080,194],["λέγει",708124,91],["κύριος",707996,4]],"And if this people, or the priest, or the prophet, should ask, What is the burden of the Lord? then thou shalt say to them, Ye are the burden, and I will dash you down, saith the Lord."],["34",[["καὶ",707031,7],["ὁ",709436,3],["προφήτης",711009,4],["καὶ",707031,7],["ὁ",709436,3],["ἱερεὺς",706614,4],["καὶ",707031,7],["ὁ",709436,3],["λαός",708094,4],["οἳ",709781,250],["ἂν",700900,11],["εἴπωσιν",705373,234],["λῆμμα",708175,15],["κυρίου",707996,18],["καὶ",707031,7],["ἐκδικήσω",704174,165],["τὸν",709436,5],["ἄνθρωπον",701163,6],["ἐκεῖνον",704183,85],["καὶ",707031,7],["τὸν",709436,5],["οἶκον",709516,6],["αὐτοῦ",702165,102]],"[As for] the prophet, and the priests, and the people, who shall say, The burden of the Lord, I will even take vengeance on that man, and on his house."],["35",[["ὅτι",709803,7],["οὕτως",709859,28],["ἐρεῖτε",705415,337],["ἕκαστος",704133,14],["πρὸς",710844,0],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἕκαστος",704133,14],["πρὸς",710844,0],["τὸν",709436,5],["ἀδελφὸν",700249,6],["αὐτοῦ",702165,102],["τί",712867,126],["ἀπεκρίθη",701492,37],["κύριος",707996,4],["καὶ",707031,7],["τί",712867,126],["ἐλάλησεν",708071,2],["κύριος",707996,4]],"Thus shall ye say every one to his neighbour, and every one to his brother, What has the Lord answered? and, what has the Lord said?"],["36",[["καὶ",707031,7],["λῆμμα",708175,15],["κυρίου",707996,18],["μὴ",708851,28],["ὀνομάζετε",709667,335],["ἔτι",705538,28],["ὅτι",709803,7],["τὸ",709436,34],["λῆμμα",708175,15],["τῷ",709436,113],["ἀνθρώπῳ",701163,114],["ἔσται",704093,93],["ὁ",709436,3],["λόγος",708236,4],["αὐτοῦ",702165,102]],"And do ye name no more the burden of the Lord; for his own word shall be a man's burden."],["37",[["καὶ",707031,7],["διὰ",703417,0],["τί",712867,126],["ἐλάλησεν",708071,2],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145]],"But wherefore, [say ye], has the Lord our God spoken?"],["38",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["ἀνθ᾿",701227,0],["ὧν",709781,252],["εἴπατε",705373,265],["τὸν",709436,5],["λόγον",708236,6],["τοῦτον",709858,85],["λῆμμα",708175,15],["κυρίου",707996,18],["καὶ",707031,7],["ἀπέστειλα",701592,155],["πρὸς",710844,0],["ὑμᾶς",713080,194],["λέγων",708124,72],["οὐκ",709805,28],["ἐρεῖτε",705415,337],["λῆμμα",708175,15],["κυρίου",707996,18]],"Therefore thus saith the Lord our God; Because ye have spoken this word, The burden of the Lord, and I sent to you, saying, Ye shall not say, The burden of the Lord;"],["39",[["διὰ",703417,0],["τοῦτο",709858,129],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["λαμβάνω",708076,157],["καὶ",707031,7],["ῥάσσω",711191,157],["ὑμᾶς",713080,194],["καὶ",707031,7],["τὴν",709436,8],["πόλιν",710612,9],["ἣν",709781,131],["ἔδωκα",703654,155],["ὑμῖν",713084,90],["καὶ",707031,7],["τοῖς",709436,147],["πατράσιν",710189,148],["ὑμῶν",713091,145]],"therefore, behold, I [will] seize, and dash down you and the city which I gave to you and your fathers."],["40",[["καὶ",707031,7],["δώσω",703654,165],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["ὀνειδισμὸν",709657,6],["αἰώνιον",700505,27],["καὶ",707031,7],["ἀτιμίαν",702094,9],["αἰώνιον",700505,36],["ἥτις",709793,412],["οὐκ",709805,28],["ἐπιλησθήσεται",705187,134]],"And I will bring upon you an everlasting reproach, and everlasting disgrace, which shall not be forgotten."],["7",[["διὰ",703417,0],["τοῦτο",709858,129],["ἰδοὺ",706497,88],["ἡμέραι",705984,191],["ἔρχονται",705453,269],["λέγει",708124,91],["κύριος",707996,4],["καὶ",707031,7],["οὐκ",709805,28],["ἐροῦσιν",705415,218],["ἔτι",705538,28],["ζῇ",705851,91],["κύριος",707996,4],["ὃς",709781,213],["ἀνήγαγεν",700933,2],["τὸν",709436,5],["οἶκον",709516,6],["Ισραηλ",706839,18],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17]],null],["8",[["ἀλλά",700680,7],["ζῇ",705851,91],["κύριος",707996,4],["ὃς",709781,213],["συνήγαγεν",712375,2],["ἅπαν",701362,46],["τὸ",709436,24],["σπέρμα",712008,25],["Ισραηλ",706839,18],["ἀπὸ",701425,0],["γῆς",703083,17],["βορρᾶ",702765,18],["καὶ",707031,7],["ἀπὸ",701425,0],["πασῶν",710177,198],["τῶν",709436,130],["χωρῶν",714011,65],["οὗ",709806,28],["ἐξῶσεν",704985,2],["αὐτοὺς",702165,62],["ἐκεῖ",704181,28],["καὶ",707031,7],["ἀπεκατέστησεν",701470,2],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["αὐτῶν",702165,40]],null]]