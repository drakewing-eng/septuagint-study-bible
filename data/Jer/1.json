[["1",[["τὸ",709436,34],["ῥῆμα",711246,15],["τοῦ",709436,35],["θεοῦ",706192,18],["ὃ",709781,33],["ἐγένετο",703104,23],["ἐπὶ",705080,0],["Ιερεμιαν",706611,6],["τὸν",709436,5],["τοῦ",709436,48],["Χελκιου",713815,18],["ἐκ",704132,0],["τῶν",709436,80],["ἱερέων",706614,81],["ὃς",709781,213],["κατῴκει",707534,13],["ἐν",704639,0],["Αναθωθ",700953,76],["ἐν",704639,0],["γῇ",703083,1],["Βενιαμιν",702650,18]],"The word of God which came to Jeremias the [son] of Chelcias, of the priests, who dwelt in Anathoth in the land of Benjamin:"],["2",[["ὃς",709781,213],["ἐγενήθη",703104,37],["λόγος",708236,4],["τοῦ",709436,35],["θεοῦ",706192,18],["πρὸς",710844,0],["αὐτὸν",702165,85],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["Ιωσια",706949,18],["υἱοῦ",713075,18],["Αμως",700898,18],["βασιλέως",702580,18],["Ιουδα",706768,18],["ἔτους",705543,21],["τρισκαιδεκάτου",712957,92],["ἐν",704639,0],["τῇ",709436,100],["βασιλείᾳ",702577,1],["αὐτοῦ",702165,102]],"[accordingly] as the word of God came to him in the days of Josias son of Amos king of Juda, in the thirteenth year of his reign."],["3",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["Ιωακιμ",706887,18],["υἱοῦ",713075,18],["Ιωσια",706949,18],["βασιλέως",702580,18],["Ιουδα",706768,18],["ἕως",705792,0],["ἑνδεκάτου",704676,92],["ἔτους",705543,21],["Σεδεκια",711618,114],["υἱοῦ",713075,18],["Ιωσια",706949,18],["βασιλέως",702580,18],["Ιουδα",706768,18],["ἕως",705792,0],["τῆς",709436,16],["αἰχμαλωσίας",700499,17],["Ιερουσαλημ",706644,17],["ἐν",704639,0],["τῷ",709436,113],["πέμπτῳ",710245,30],["μηνί",708874,114]],"And it was in the days of Joakim son of Josias king of Juda, until the eleventh year of Sedekias king of Juda, [even] until the captivity of Jerusalem in the fifth month."],["4",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72]],"And the word of the Lord came to him, [saying],"],["5",[["πρὸ",710747,0],["τοῦ",709436,20],["με",708618,163],["πλάσαι",710503,106],["σε",711598,163],["ἐν",704639,0],["κοιλίᾳ",707761,1],["ἐπίσταμαί",705264,254],["σε",711598,163],["καὶ",707031,7],["πρὸ",710747,0],["τοῦ",709436,20],["σε",711598,163],["ἐξελθεῖν",704909,106],["ἐκ",704132,0],["μήτρας",708894,17],["ἡγίακά",700153,89],["σε",711598,163],["προφήτην",711009,6],["εἰς",704105,0],["ἔθνη",704068,42],["τέθεικά",712849,89],["σε",711598,163]],"Before I formed thee in the belly, I knew thee; and before thou camest forth from the womb, I sanctified thee; I appointed thee a prophet to the nations."],["6",[["καὶ",707031,7],["εἶπα",705373,155],["ὦ",714081,88],["δέσποτα",703379,153],["κύριε",707996,153],["ἰδοὺ",706497,88],["οὐκ",709805,28],["ἐπίσταμαι",705264,254],["λαλεῖν",708071,55],["ὅτι",709803,7],["νεώτερος",709256,224],["ἐγώ",704018,164],["εἰμι",704093,157]],"And I said, O Lord, thou that art supreme Lord, behold, I know not [how] to speak, for I am a child."],["7",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["μὴ",708851,28],["λέγε",708124,240],["ὅτι",709803,7],["νεώτερος",709256,224],["ἐγώ",704018,164],["εἰμι",704093,157],["ὅτι",709803,7],["πρὸς",710844,0],["πάντας",710177,60],["οὓς",709781,298],["ἐὰν",703912,7],["ἐξαποστείλω",704872,207],["σε",711598,163],["πορεύσῃ",710667,123],["καὶ",707031,7],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἐὰν",703912,7],["ἐντείλωμαί",704791,410],["σοι",711925,159],["λαλήσεις",708071,166]],"And the Lord said to me, Say not, I am a child: for thou shalt go to all to whomsoever I shall send thee, and according to all [the words] that I shall command thee, thou shalt speak."],["8",[["μὴ",708851,28],["φοβηθῇς",713532,279],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτῶν",702165,40],["ὅτι",709803,7],["μετὰ",708780,0],["σοῦ",711945,133],["ἐγώ",704018,164],["εἰμι",704093,157],["τοῦ",709436,20],["ἐξαιρεῖσθαί",704838,110],["σε",711598,163],["λέγει",708124,91],["κύριος",707996,4]],"Be not afraid before them: for I am with thee to deliver thee, saith the Lord."],["9",[["καὶ",707031,7],["ἐξέτεινεν",704322,2],["κύριος",707996,4],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["πρός",710844,0],["με",708618,163],["καὶ",707031,7],["ἥψατο",701654,23],["τοῦ",709436,20],["στόματός",712125,21],["μου",709032,133],["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["ἰδοὺ",706497,88],["δέδωκα",703654,89],["τοὺς",709436,58],["λόγους",708236,57],["μου",709032,133],["εἰς",704105,0],["τὸ",709436,24],["στόμα",712125,25],["σου",711945,133]],"And the Lord stretched forth his hand to me, and touched my mouth: and the Lord said to me, Behold, I have put my words into thy mouth."],["10",[["ἰδοὺ",706497,88],["κατέστακά",707011,89],["σε",711598,163],["σήμερον",711751,28],["ἐπὶ",705080,0],["ἔθνη",704068,42],["καὶ",707031,7],["βασιλείας",702577,39],["ἐκριζοῦν",704303,55],["καὶ",707031,7],["κατασκάπτειν",707416,55],["καὶ",707031,7],["ἀπολλύειν",701513,55],["καὶ",707031,7],["ἀνοικοδομεῖν",701187,55],["καὶ",707031,7],["καταφυτεύειν",707487,55]],"Behold, I have appointed thee this day over nations and over kingdoms, to root out, and to pull down, and to destroy, and to rebuild, and to plant."],["11",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["λέγων",708124,72],["τί",712867,126],["σὺ",712181,164],["ὁρᾷς",709725,154],["Ιερεμια",706611,153],["καὶ",707031,7],["εἶπα",705373,155],["βακτηρίαν",702459,9],["καρυΐνην",707184,9]],"And the word of the Lord came to me, saying, What seest thou? And I said, A rod of an almond tree."],["12",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["καλῶς",707106,28],["ἑώρακας",709725,266],["διότι",703734,7],["ἐγρήγορα",703949,89],["ἐγὼ",704018,164],["ἐπὶ",705080,0],["τοὺς",709436,58],["λόγους",708236,57],["μου",709032,133],["τοῦ",709436,20],["ποιῆσαι",710582,106],["αὐτούς",702165,62]],"And the Lord said to me, Thou hast well seen: for I have watched over my words to perform them."],["13",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρός",710844,0],["με",708618,163],["ἐκ",704132,0],["δευτέρου",703389,116],["λέγων",708124,72],["τί",712867,126],["σὺ",712181,164],["ὁρᾷς",709725,154],["καὶ",707031,7],["εἶπα",705373,155],["λέβητα",708121,6],["ὑποκαιόμενον",713202,212],["καὶ",707031,7],["τὸ",709436,34],["πρόσωπον",710986,15],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["προσώπου",710986,21],["βορρᾶ",702765,18]],"And the word of the Lord came to me a second time, saying, What seest thou? And I said, A caldron on the fire; and the face of it is toward the north."],["14",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["ἀπὸ",701425,0],["προσώπου",710986,21],["βορρᾶ",702765,18],["ἐκκαυθήσεται",704205,134],["τὰ",709436,63],["κακὰ",707066,195],["ἐπὶ",705080,0],["πάντας",710177,60],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["τὴν",709436,8],["γῆν",703083,9]],"And the Lord said to me, From the north shall flame forth evils upon all the inhabitants of the land."],["15",[["διότι",703734,7],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["συγκαλῶ",712199,157],["πάσας",710177,119],["τὰς",709436,38],["βασιλείας",702577,39],["ἀπὸ",701425,0],["βορρᾶ",702765,18],["τῆς",709436,16],["γῆς",703083,17],["λέγει",708124,91],["κύριος",707996,4],["καὶ",707031,7],["ἥξουσιν",705956,218],["καὶ",707031,7],["θήσουσιν",712849,218],["ἕκαστος",704133,14],["τὸν",709436,5],["θρόνον",706315,6],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τὰ",709436,41],["πρόθυρα",710801,42],["τῶν",709436,130],["πυλῶν",711082,65],["Ιερουσαλημ",706644,17],["καὶ",707031,7],["ἐπὶ",705080,0],["πάντα",710177,68],["τὰ",709436,41],["τείχη",712759,42],["τὰ",709436,41],["κύκλῳ",707959,114],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐπὶ",705080,0],["πάσας",710177,119],["τὰς",709436,38],["πόλεις",710612,39],["Ιουδα",706768,18]],"For, behold, I call together all the kingdoms of the earth from the north, saith the Lord; and they shall come, and shall set each one his throne at the entrance of the gates of Jerusalem, and against all the walls round about her, and against all the cities of Juda."],["16",[["καὶ",707031,7],["λαλήσω",708071,165],["πρὸς",710844,0],["αὐτοὺς",702165,62],["μετὰ",708780,0],["κρίσεως",707908,17],["περὶ",710285,0],["πάσης",710177,82],["τῆς",709436,16],["κακίας",707054,17],["αὐτῶν",702165,40],["ὡς",714148,7],["ἐγκατέλιπόν",703967,150],["με",708618,163],["καὶ",707031,7],["ἔθυσαν",706349,150],["θεοῖς",706192,148],["ἀλλοτρίοις",700699,230],["καὶ",707031,7],["προσεκύνησαν",710925,150],["τοῖς",709436,95],["ἔργοις",705396,96],["τῶν",709436,130],["χειρῶν",713787,65],["αὐτῶν",702165,40]],"And I will speak to them in judgment, concerning all their iniquity, [forasmuch] as they have forsaken me, and sacrificed to strange gods, and worshipped the works of their own hands."],["17",[["καὶ",707031,7],["σὺ",712181,164],["περίζωσαι",710317,300],["τὴν",709436,8],["ὀσφύν",709800,9],["σου",711945,133],["καὶ",707031,7],["ἀνάστηθι",701173,176],["καὶ",707031,7],["εἰπὸν",705373,176],["πρὸς",710844,0],["αὐτοὺς",702165,62],["πάντα",710177,68],["ὅσα",709788,68],["ἂν",700900,11],["ἐντείλωμαί",704791,410],["σοι",711925,159],["μὴ",708851,28],["φοβηθῇς",713532,279],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτῶν",702165,40],["μηδὲ",708855,7],["πτοηθῇς",711062,279],["ἐναντίον",704654,0],["αὐτῶν",702165,40],["ὅτι",709803,7],["μετὰ",708780,0],["σοῦ",711945,133],["ἐγώ",704018,164],["εἰμι",704093,157],["τοῦ",709436,20],["ἐξαιρεῖσθαί",704838,110],["σε",711598,163],["λέγει",708124,91],["κύριος",707996,4]],"And do thou gird up thy loins, and stand up, and speak all [the words] that I shall command thee: be not afraid of their face, neither be thou alarmed before them; for I am with thee to deliver thee, saith the Lord."],["18",[["ἰδοὺ",706497,88],["τέθεικά",712849,89],["σε",711598,163],["ἐν",704639,0],["τῇ",709436,100],["σήμερον",711751,28],[