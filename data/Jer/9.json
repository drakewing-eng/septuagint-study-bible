[["1",[["τίς",712867,158],["δῴη",703654,225],["μοι",708974,159],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["σταθμὸν",712040,6],["ἔσχατον",705519,27],["καὶ",707031,7],["καταλείψω",707305,165],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["καὶ",707031,7],["ἀπελεύσομαι",701398,181],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["ὅτι",709803,7],["πάντες",710177,138],["μοιχῶνται",708976,269],["σύνοδος",712491,12],["ἀθετούντων",700369,170]],"Who would give me a most distant lodge in the wilderness, that I might leave my people, and depart from them? for they all commit adultery, an assembly of treacherous men."],["2",[["καὶ",707031,7],["ἐνέτειναν",704790,150],["τὴν",709436,8],["γλῶσσαν",703120,9],["αὐτῶν",702165,40],["ὡς",714148,7],["τόξον",712898,25],["ψεῦδος",714044,15],["καὶ",707031,7],["οὐ",709805,28],["πίστις",710484,12],["ἐνίσχυσεν",704750,2],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ὅτι",709803,7],["ἐκ",704132,0],["κακῶν",707066,169],["εἰς",704105,0],["κακὰ",707066,68],["ἐξήλθοσαν",704909,150],["καὶ",707031,7],["ἐμὲ",704555,163],["οὐκ",709805,28],["ἔγνωσαν",703105,150]],"And they have bent their tongue like a bow: falsehood and not faithfulness has prevailed upon the earth; for they have gone on from evil to evil, and have not known me, saith the Lord."],["3",[["ἕκαστος",704133,14],["ἀπὸ",701425,0],["τοῦ",709436,35],["πλησίον",710547,28],["αὐτοῦ",702165,102],["φυλάξασθε",713619,186],["καὶ",707031,7],["ἐπ᾿",705080,0],["ἀδελφοῖς",700249,148],["αὐτῶν",702165,40],["μὴ",708851,28],["πεποίθατε",710221,756],["ὅτι",709803,7],["πᾶς",710177,14],["ἀδελφὸς",700249,4],["πτέρνῃ",711051,1],["πτερνιεῖ",711052,127],["καὶ",707031,7],["πᾶς",710177,14],["φίλος",713492,14],["δολίως",703786,28],["πορεύσεται",710667,93]],"Beware ye each of his neighbour, and trust ye not in your brethren: for every one will surely supplant, and every friend will walk craftily."],["4",[["ἕκαστος",704133,14],["κατὰ",707200,0],["τοῦ",709436,35],["φίλου",713492,116],["αὐτοῦ",702165,102],["καταπαίξεται",707355,127],["ἀλήθειαν",700656,9],["οὐ",709805,28],["μὴ",708851,28],["λαλήσωσιν",708071,234],["μεμάθηκεν",708480,171],["ἡ",709436,10],["γλῶσσα",703120,12],["αὐτῶν",702165,40],["λαλεῖν",708071,55],["ψευδῆ",714036,68],["ἠδίκησαν",700269,150],["καὶ",707031,7],["οὐ",709805,28],["διέλιπον",703496,150],["τοῦ",709436,20],["ἐπιστρέψαι",705278,106]],"Every one will mock his friend; they will not speak truth: their tongue has learned to speak falsehoods; they have committed iniquity, they ceased not, so as to return."],["5",[["τόκος",712882,4],["ἐπὶ",705080,0],["τόκῳ",712882,114],["δόλος",703787,4],["ἐπὶ",705080,0],["δόλῳ",703787,114],["οὐκ",709805,28],["ἤθελον",706176,137],["εἰδέναι",709492,115],["με",708618,163]],"[There is] usury upon usury, and deceit upon deceit: they would not know me, saith the Lord."],["6",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["πυρώσω",711103,165],["αὐτοὺς",702165,62],["καὶ",707031,7],["δοκιμῶ",703776,165],["αὐτούς",702165,62],["ὅτι",709803,7],["ποιήσω",710582,165],["ἀπὸ",701425,0],["προσώπου",710986,21],["πονηρίας",710659,17],["θυγατρὸς",706320,17],["λαοῦ",708094,18],["μου",709032,133]],"Therefore thus saith the Lord, Behold, I will try them with fire, and prove them; for I will do [thus] because of the wickedness of the daughter of my people."],["7",[["βολὶς",702756,12],["τιτρώσκουσα",712871,188],["ἡ",709436,10],["γλῶσσα",703120,12],["αὐτῶν",702165,40],["δόλια",703783,195],["τὰ",709436,63],["ῥήματα",711246,64],["τοῦ",709436,20],["στόματος",712125,21],["αὐτῶν",702165,40],["τῷ",709436,113],["πλησίον",710547,28],["αὐτοῦ",702165,102],["λαλεῖ",708071,91],["εἰρηνικὰ",704099,68],["καὶ",707031,7],["ἐν",704639,0],["ἑαυτῷ",703917,50],["ἔχει",705785,91],["τὴν",709436,8],["ἔχθραν",705775,9]],"Their tongue is a wounding arrow; the words of their mouth are deceitful: [one] speaks peaceably to his neighbour, but in himself retains enmity."],["8",[["μὴ",708851,28],["ἐπὶ",705080,0],["τούτοις",709858,151],["οὐκ",709805,28],["ἐπισκέψομαι",705250,181],["λέγει",708124,91],["κύριος",707996,4],["ἢ",705924,7],["ἐν",704639,0],["λαῷ",708094,114],["τῷ",709436,113],["τοιούτῳ",712878,30],["οὐκ",709805,28],["ἐκδικήσει",704174,127],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133]],"Shall I not visit for these things? saith the Lord: and shall not my soul be avenged on such a people as this?"],["9",[["ἐπὶ",705080,0],["τὰ",709436,41],["ὄρη",709768,42],["λάβετε",708076,74],["κοπετὸν",707821,6],["καὶ",707031,7],["ἐπὶ",705080,0],["τὰς",709436,38],["τρίβους",712939,39],["τῆς",709436,16],["ἐρήμου",705420,17],["θρῆνον",706309,6],["ὅτι",709803,7],["ἐξέλιπον",704237,150],["παρὰ",709995,0],["τὸ",709436,24],["μὴ",708851,28],["εἶναι",704093,55],["ἀνθρώπους",701163,57],["οὐκ",709805,28],["ἤκουσαν",700587,150],["φωνὴν",713640,9],["ὑπάρξεως",713101,17],["ἀπὸ",701425,0],["πετεινῶν",710439,44],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["καὶ",707031,7],["ἕως",705792,0],["κτηνῶν",707934,44],["ἐξέστησαν",704940,150],["ᾤχοντο",709539,139]],"Take up a lamentation for the mountains, and a mournful dirge for the paths of the wilderness, for they are desolate for want of men; they heard not the sound of life from the birds of the sky, nor the cattle: they were amazed, they are gone."],["10",[["καὶ",707031,7],["δώσω",703654,165],["τὴν",709436,8],["Ιερουσαλημ",706644,9],["εἰς",704105,0],["μετοικίαν",708834,9],["καὶ",707031,7],["εἰς",704105,0],["κατοικητήριον",707536,25],["δρακόντων",703822,81],["καὶ",707031,7],["τὰς",709436,38],["πόλεις",710612,39],["Ιουδα",706768,18],["εἰς",704105,0],["ἀφανισμὸν",702183,6],["θήσομαι",712849,181],["παρὰ",709995,0],["τὸ",709436,24],["μὴ",708851,28],["κατοικεῖσθαι",707534,110]],"And I will remove the inhabitants of Jerusalem, and make it a dwelling-place of dragons; and I will utterly waste the cities of Juda, so that they shall not be inhabited."],["11",[["τίς",712867,158],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ὁ",709436,3],["συνετός",712464,14],["καὶ",707031,7],["συνέτω",712481,31],["τοῦτο",709858,129],["καὶ",707031,7],["ᾧ",709781,309],["λόγος",708236,4],["στόματος",712125,21],["κυρίου",707996,18],["πρὸς",710844,0],["αὐτόν",702165,85],["ἀναγγειλάτω",700921,45],["ὑμῖν",713084,90],["ἕνεκεν",704709,0],["τίνος",712867,340],["ἀπώλετο",701513,23],["ἡ",709436,10],["γῆ",703083,12],["ἀνήφθη",701044,37],["ὡς",714148,7],["ἔρημος",705420,12],["παρὰ",709995,0],["τὸ",709436,24],["μὴ",708851,28],["διοδεύεσθαι",703715,110],["αὐτήν",702165,104]],"Who is the wise man, that he may understand this? and he that has the word of the mouth of the Lord [addressed] to him, let him tell you wherefore the land has been destroyed, has been ravaged by fire like a desert, so that no one passes through it."],["12",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["διὰ",703417,0],["τὸ",709436,24],["ἐγκαταλιπεῖν",703967,106],["αὐτοὺς",702165,62],["τὸν",709436,5],["νόμον",709349,6],["μου",709032,133],["ὃν",709781,112],["ἔδωκα",703654,155],["πρὸ",710747,0],["προσώπου",710986,21],["αὐτῶν",702165,40],["καὶ",707031,7],["οὐκ",709805,28],["ἤκουσαν",700587,150],["τῆς",709436,16],["φωνῆς",713640,17],["μου",709032,133]],"And the Lord said to me, Because they have forsaken my law, which I set before them, and have not hearkened to my voice;"],["13",[["ἀλλ᾿",700680,7],["ἐπορεύθησαν",710667,99],["ὀπίσω",709697,0],["τῶν",709436,80],["ἀρεστῶν",701723,169],["τῆς",709436,16],["καρδίας",707141,17],["αὐτῶν",702165,40],["τῆς",709436,16],["κακῆς",707066,82],["καὶ",707031,7],["ὀπίσω",709697,0],["τῶν",709436,43],["εἰδώλων",704079,44],["ἃ",709781,69],["ἐδίδαξαν",703649,150],["αὐτοὺς",702165,62],["οἱ",709436,136],["πατέρες",710189,52],["αὐτῶν",702165,40]],"but went after the lusts of their evil heart, and after the idols which their fathers taught them [to worship]:"],["14",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ψωμιῶ",714077,165],["αὐτοὺς",702165,62],["ἀνάγκας",700925,39],["καὶ",707031,7],["ποτιῶ",710700,165],["αὐτοὺς",702165,62],["ὕδωρ",713071,25],["χολῆς",713900,17]],"therefore thus saith the Lord God of Israel, Behold, I will feed them with trouble and will cause them to drink water of gall:"],["15",[["καὶ",707031,7],["διασκορπιῶ",703579,165],["αὐτοὺς",702165,62],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["εἰς",704105,0],["οὓς",709781,298],["οὐκ",709805,28],["ἐγίνωσκον",703105,137],["αὐτοὶ",702165,201],["καὶ",707031,7],["οἱ",709436,136],["πατέρες",710189,52],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπαποστελῶ",705036,165],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["τὴν",709436,8],["μάχαιραν",708593,9],["ἕως",705792,0],["τοῦ",709436,20],["ἐξαναλῶσαι",704861,106],["αὐτοὺς",702165,62],["ἐν",704639,0],["αὐτῇ",702165,105]],"and I will scatter them among the nations, to them whom neither they nor their fathers knew; and I will send a sword upon them, until I have consumed them with it."],["16",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["καλέσατε",707084,74],["τὰς",709436,38],["θρηνούσας",706306,338],["καὶ",707031,7],["ἐλθέτωσαν",705453,264],["καὶ",707031,7],["πρὸς",710844,0],["τὰς",709436,38],["σοφὰς",711985,119],["ἀποστείλατε",701592,74],["καὶ",707031,7],["φθεγξάσθωσαν",713442,486]],"Thus saith the Lord, Call ye the mourning women, and let them come; and send to the wise women, and let them utter their voice;"],["17",[["καὶ",707031,7],["λαβέτωσαν",708076,264],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["θρῆνον",706309,6],["καὶ",707031,7],["καταγαγέτωσαν",707232,264],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["ὑμῶν",713091,145],["δάκρυα",703255,42],["καὶ",707031,7],["τὰ",709436,63],["βλέφαρα",702741,64],["ὑμῶν",713091,145],["ῥείτω",711241,31],["ὕδωρ",713071,25]],"and let them take up a lamentation for you, and let your eyes pour down tears, and your eyelids drop water."],["18",[["ὅτι",709803,7],["φωνὴ",713640,12],["οἴκτου",709523,18],["ἠκούσθη",700587,37],["ἐν",704639,0],["Σιων",711816,1],["πῶς",711121,28],["ἐταλαιπωρήσαμεν",712694,289],["κατῃσχύνθημεν",707257,485],["σφόδρα",712586,28],["ὅτι",709803,7],["ἐγκατελίπομεν",703967,289],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἀπερρίψαμεν",701563,289],["τὰ",709436,41],["σκηνώματα",711849,42],["ἡμῶν",705999,145]],"For a voice of lamentation has been heard in Sion, How are we become wretched! we are greatly ashamed, for we have forsaken the land, and have abandoned our tabernacles!"],["19",[["ἀκούσατε",700587,74],["δή",703395,11],["γυναῖκες",703209,185],["λόγον",708236,6],["θεοῦ",706192,18],["καὶ",707031,7],["δεξάσθω",703393,315],["τὰ",709436,63],["ὦτα",709852,64],["ὑμῶν",713091,145],["λόγους",708236,57],["στόματος",712125,21],["αὐτοῦ",702165,102],["καὶ",707031,7],["διδάξατε",703649,74],["τὰς",709436,38],["θυγατέρας",706320,39],["ὑμῶν",713091,145],["οἶκτον",709523,6],["καὶ",707031,7],["γυνὴ",703209,12],["τὴν",709436,8],["πλησίον",710547,28],["αὐτῆς",702165,86],["θρῆνον",706309,6]],"Hear now, ye women, the word of God, and let your ears receive the words of his mouth, and teach your daughters lamentation, and [every] woman her neighbour a dirge."],["20",[["ὅτι",709803,7],["ἀνέβη",700905,2],["θάνατος",706096,4],["διὰ",703417,0],["τῶν",709436,130],["θυρίδων",706340,65],["ὑμῶν",713091,145],["εἰσῆλθεν",704114,2],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["ὑμῶν",713091,145],["τοῦ",709436,20],["ἐκτρῖψαι",704345,106],["νήπια",709295,68],["ἔξωθεν",704984,28],["καὶ",707031,7],["νεανίσκους",709232,57],["ἀπὸ",701425,0],["τῶν",709436,130],["πλατειῶν",710509,198]],"For death has come up through your windows, it has entered into our land, to destroy the infants without, and the young men from the streets."],["21",[["καὶ",707031,7],["ἔσονται",704093,135],["οἱ",709436,136],["νεκροὶ",709247,52],["τῶν",709436,80],["ἀνθρώπων",701163,81],["εἰς",704105,0],["παράδειγμα",710008,25],["ἐπὶ",705080,0],["προσώπου",710986,21],["τοῦ",709436,20],["πεδίου",710215,21],["τῆς",709436,16],["γῆς",703083,17],["ὑμῶν",713091,145],["καὶ",707031,7],["ὡς",714148,7],["χόρτος",713923,4],["ὀπίσω",709697,0],["θερίζοντος",706206,152],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ὁ",709436,3],["συνάγων",712375,72]],"And the carcases of the men shall be for an example on the face of the field of your land, like grass after the mower, and there shall be none to gather [them]."],["22",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["μὴ",708851,28],["καυχάσθω",707569,315],["ὁ",709436,3],["σοφὸς",711985,14],["ἐν",704639,0],["τῇ",709436,100],["σοφίᾳ",711981,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["μὴ",708851,28],["καυχάσθω",707569,315],["ὁ",709436,3],["ἰσχυρὸς",706855,14],["ἐν",704639,0],["τῇ",709436,100],["ἰσχύι",706858,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["μὴ",708851,28],["καυχάσθω",707569,315],["ὁ",709436,3],["πλούσιος",710560,14],["ἐν",704639,0],["τῷ",709436,113],["πλούτῳ",710563,114],["αὐτοῦ",702165,102]],"Thus saith the Lord, Let not the wise man boast in his wisdom, and let not the strong man boast in his strength, and let not the rich man boast in his wealth;"],["23",[["ἀλλ᾿",700680,7],["ἢ",705924,7],["ἐν",704639,0],["τούτῳ",709858,50],["καυχάσθω",707569,315],["ὁ",709436,3],["καυχώμενος",707569,122],["συνίειν",712481,55],["καὶ",707031,7],["γινώσκειν",703105,55],["ὅτι",709803,7],["ἐγώ",704018,164],["εἰμι",704093,157],["κύριος",707996,4],["ποιῶν",710582,72],["ἔλεος",704426,25],["καὶ",707031,7],["κρίμα",707903,25],["καὶ",707031,7],["δικαιοσύνην",703695,9],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ὅτι",709803,7],["ἐν",704639,0],["τούτοις",709858,151],["τὸ",709436,34],["θέλημά",706170,15],["μου",709032,133],["λέγει",708124,91],["κύριος",707996,4]],"but let him that boasts boast in this, the understanding and knowing that I am the Lord that exercise mercy, and judgment, and righteousness, upon the earth; for in these things is my pleasure, saith the Lord."],["24",[["ἰδοὺ",706497,88],["ἡμέραι",705984,191],["ἔρχονται",705453,269],["λέγει",708124,91],["κύριος",707996,4],["καὶ",707031,7],["ἐπισκέψομαι",705250,181],["ἐπὶ",705080,0],["πάντας",710177,60],["περιτετμημένους",710402,458],["ἀκροβυστίας",700605,39],["αὐτῶν",702165,40]],"Behold, the days come, saith the Lord, when I will visit upon all the circumcised their uncircumcision;"],["25",[["ἐπ᾿",705080,0],["Αἴγυπτον",700401,9],["καὶ",707031,7],["ἐπὶ",705080,0],["τὴν",709436,8],["Ιουδαίαν",706769,9],["καὶ",707031,7],["ἐπὶ",705080,0],["Εδωμ",704041,6],["καὶ",707031,7],["ἐπὶ",705080,0],["υἱοὺς",713075,57],["Αμμων",700847,18],["καὶ",707031,7],["ἐπὶ",705080,0],["υἱοὺς",713075,57],["Μωαβ",709085,18],["καὶ",707031,7],["ἐπὶ",705080,0],["πάντα",710177,27],["περικειρόμενον",710330,212],["τὰ",709436,41],["κατὰ",707200,0],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["ὅτι",709803,7],["πάντα",710177,195],["τὰ",709436,63],["ἔθνη",704068,64],["ἀπερίτμητα",701397,195],["σαρκί",711537,1],["καὶ",707031,7],["πᾶς",710177,14],["οἶκος",709516,4],["Ισραηλ",706839,18],["ἀπερίτμητοι",701397,138],["καρδίας",707141,39],["αὐτῶν",702165,40]],"on Egypt, and on Idumea, and on Edom, and on the children of Ammon, and on the children of Moab, and on every one that shaves his face round about, [even] them that dwell in the wilderness; for all the Gentiles are uncircumcised in flesh, and all the house of Israel are uncircumcised [in] their hearts."]]