[["1",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐξεγείρω",704889,157],["ἐπὶ",705080,0],["Βαβυλῶνα",702352,9],["καὶ",707031,7],["ἐπὶ",705080,0],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["Χαλδαίους",713678,57],["ἄνεμον",701123,6],["καύσωνα",707567,6],["διαφθείροντα",703624,183]],"Thus saith the Lord; Behold, I stir up against Babylon, and against the Chaldeans dwelling therein, a deadly burning wind."],["2",[["καὶ",707031,7],["ἐξαποστελῶ",704872,165],["εἰς",704105,0],["Βαβυλῶνα",702352,9],["ὑβριστάς",713052,57],["καὶ",707031,7],["καθυβρίσουσιν",707023,218],["αὐτὴν",702165,104],["καὶ",707031,7],["λυμανοῦνται",708270,269],["τὴν",709436,8],["γῆν",703083,9],["αὐτῆς",702165,86],["οὐαὶ",709807,88],["ἐπὶ",705080,0],["Βαβυλῶνα",702352,9],["κυκλόθεν",707956,28],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["κακώσεως",707075,17],["αὐτῆς",702165,86]],"And I will send forth against Babylon spoilers, and they shall spoil her, and shall ravage her land. Woe to Babylon round about [her] in the day of her affliction."],["3",[["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["τεινέτω",712754,31],["ὁ",709436,3],["τείνων",712754,72],["τὸ",709436,24],["τόξον",712898,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["περιθέσθω",710403,315],["ᾧ",709781,309],["ἐστιν",704093,91],["ὅπλα",709704,64],["αὐτῷ",702165,50],["καὶ",707031,7],["μὴ",708851,28],["φείσησθε",713406,142],["ἐπὶ",705080,0],["νεανίσκους",709232,57],["αὐτῆς",702165,86],["καὶ",707031,7],["ἀφανίσατε",702182,74],["πᾶσαν",710177,36],["τὴν",709436,8],["δύναμιν",703839,9],["αὐτῆς",702165,86]],"Let the archer bend his bow, and him that has armour put it on: and spare ye not her young men, but destroy ye all her host."],["4",[["καὶ",707031,7],["πεσοῦνται",710481,135],["τραυματίαι",712921,52],["ἐν",704639,0],["γῇ",703083,1],["Χαλδαίων",713678,81],["καὶ",707031,7],["κατακεκεντημένοι",707269,362],["ἔξωθεν",704984,28],["αὐτῆς",702165,86]],"And slain men shall fall in the land of the Chaldeans, and [men] pierced through shall fall without it."],["5",[["διότι",703734,7],["οὐκ",709805,28],["ἐχήρευσεν",713852,2],["Ισραηλ",706839,4],["καὶ",707031,7],["Ιουδας",706775,4],["ἀπὸ",701425,0],["θεοῦ",706192,18],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["κυρίου",707996,18],["παντοκράτορος",709986,18],["ὅτι",709803,7],["ἡ",709436,10],["γῆ",703083,12],["αὐτῶν",702165,40],["ἐπλήσθη",710532,37],["ἀδικίας",700271,17],["ἀπὸ",701425,0],["τῶν",709436,80],["ἁγίων",700159,169],["Ισραηλ",706839,114]],"For Israel and Juda have not been forsaken of their God, of the Lord Almighty; whereas their land was filled with iniquity against the holy things of Israel."],["6",[["φεύγετε",713433,87],["ἐκ",704132,0],["μέσου",708768,116],["Βαβυλῶνος",702352,17],["καὶ",707031,7],["ἀνασῴζετε",701064,87],["ἕκαστος",704133,14],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["μὴ",708851,28],["ἀπορριφῆτε",701563,394],["ἐν",704639,0],["τῇ",709436,100],["ἀδικίᾳ",700271,1],["αὐτῆς",702165,86],["ὅτι",709803,7],["καιρὸς",707047,4],["ἐκδικήσεως",704175,17],["αὐτῆς",702165,86],["ἐστιν",704093,91],["παρὰ",709995,0],["κυρίου",707996,18],["ἀνταπόδομα",701216,15],["αὐτὸς",702165,121],["ἀνταποδίδωσιν",701215,91],["αὐτῇ",702165,105]],"Flee ye out of the midst of Babylon, and deliver every one his soul: and be not overthrown in her iniquity; for it is the time of her retribution from the Lord; he is rendering to her a recompence."],["7",[["ποτήριον",710699,15],["χρυσοῦν",713971,26],["Βαβυλὼν",702352,12],["ἐν",704639,0],["χειρὶ",713787,1],["κυρίου",707996,18],["μεθύσκον",708676,47],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9],["ἀπὸ",701425,0],["τοῦ",709436,35],["οἴνου",709530,18],["αὐτῆς",702165,86],["ἐπίοσαν",710478,150],["ἔθνη",704068,42],["διὰ",703417,0],["τοῦτο",709858,129],["ἐσαλεύθησαν",711403,99]],"Babylon has been a golden cup in the Lord's hand, causing all the earth to be drunken: the nations have drunk of her wine; therefore they were shaken."],["8",[["καὶ",707031,7],["ἄφνω",702215,28],["ἔπεσεν",710481,2],["Βαβυλὼν",702352,12],["καὶ",707031,7],["συνετρίβη",712520,37],["θρηνεῖτε",706306,87],["αὐτήν",702165,104],["λάβετε",708076,74],["ῥητίνην",711252,9],["τῇ",709436,100],["διαφθορᾷ",703625,1],["αὐτῆς",702165,86],["εἴ",704071,7],["πως",711121,28],["ἰαθήσεται",706424,134]],"And Babylon is fallen suddenly, and is broken to pieces: lament for her; take balm for her deadly wound, if by any means she may be healed."],["9",[["ἰατρεύσαμεν",706458,289],["τὴν",709436,8],["Βαβυλῶνα",702352,9],["καὶ",707031,7],["οὐκ",709805,28],["ἰάθη",706424,37],["ἐγκαταλίπωμεν",703967,79],["αὐτὴν",702165,104],["καὶ",707031,7],["ἀπέλθωμεν",701398,79],["ἕκαστος",704133,14],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ἤγγισεν",703939,2],["εἰς",704105,0],["οὐρανὸν",709844,6],["τὸ",709436,24],["κρίμα",707903,25],["αὐτῆς",702165,86],["ἐξῆρεν",704839,2],["ἕως",705792,0],["τῶν",709436,43],["ἄστρων",702024,44]],"We tried to heal Babylon, but she was not healed: let us forsake her, and depart every one to his own country: for her judgment has reached to the heaven, it has mounted up to the stars."],["10",[["ἐξήνεγκεν",704356,2],["κύριος",707996,4],["τὸ",709436,24],["κρίμα",707903,25],["αὐτοῦ",702165,102],["δεῦτε",703383,28],["καὶ",707031,7],["ἀναγγείλωμεν",700921,79],["εἰς",704105,0],["Σιων",711816,9],["τὰ",709436,41],["ἔργα",705396,42],["κυρίου",707996,18],["θεοῦ",706192,18],["ἡμῶν",705999,145]],"The Lord has brought forth his judgment: come, and let us declare in Sion the works of the Lord our God."],["11",[["παρασκευάζετε",710103,87],["τὰ",709436,41],["τοξεύματα",712895,42],["πληροῦτε",710543,87],["τὰς",709436,38],["φαρέτρας",713364,39],["ἤγειρεν",703949,13],["κύριος",707996,4],["τὸ",709436,24],["πνεῦμα",710566,25],["βασιλέως",702580,18],["Μήδων",708864,81],["ὅτι",709803,7],["εἰς",704105,0],["Βαβυλῶνα",702352,9],["ἡ",709436,10],["ὀργὴ",709728,12],["αὐτοῦ",702165,102],["τοῦ",709436,20],["ἐξολεθρεῦσαι",704956,106],["αὐτήν",702165,104],["ὅτι",709803,7],["ἐκδίκησις",704175,12],["κυρίου",707996,18],["ἐστίν",704093,91],["ἐκδίκησις",704175,12],["λαοῦ",708094,18],["αὐτοῦ",702165,102],["ἐστιν",704093,91]],"Prepare the arrows; fill the quivers: the Lord has stirred up the spirit of the king of the Medes: for his wrath is against Babylon, to destroy it utterly; for it is the Lord's vengeance, it is the vengeance of his people."],["12",[["ἐπὶ",705080,0],["τειχέων",712759,44],["Βαβυλῶνος",702352,17],["ἄρατε",700473,74],["σημεῖον",711748,25],["ἐπιστήσατε",705756,74],["φαρέτρας",713364,39],["ἐγείρατε",703949,74],["φυλακάς",713613,39],["ἑτοιμάσατε",705539,74],["ὅπλα",709704,42],["ὅτι",709803,7],["ἐνεχείρησεν",704011,2],["καὶ",707031,7],["ποιήσει",710582,127],["κύριος",707996,4],["ἃ",709781,69],["ἐλάλησεν",708071,2],["ἐπὶ",705080,0],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["Βαβυλῶνα",702352,9]],"Lift up a standard on the walls of Babylon, prepare the quivers, rouse the guards, prepare the weapons: for the Lord has taken [the work] in hand, and will execute what he has spoken against the inhabitants of Babylon,"],["13",[["κατασκηνοῦντας",707423,235],["ἐφ᾿",705080,0],["ὕδασι",713071,96],["πολλοῖς",710646,94],["καὶ",707031,7],["ἐπὶ",705080,0],["πλήθει",710529,54],["θησαυρῶν",706258,81],["αὐτῆς",702165,86],["ἥκει",705956,91],["τὸ",709436,34],["πέρας",710281,15],["σου",711945,133],["ἀληθῶς",700662,28],["εἰς",704105,0],["τὰ",709436,41],["σπλάγχα",712018,42],["σου",711945,133]],"dwelling on many waters, and amidst the abundance of her treasures; thine end is come verily into thy bowels."],["14",[["ὅτι",709803,7],["ὤμοσεν",709620,2],["κύριος",707996,4],["κατὰ",707200,0],["τοῦ",709436,35],["βραχίονος",702808,18],["αὐτοῦ",702165,102],["διότι",703734,7],["πληρώσω",710543,207],["σε",711598,163],["ἀνθρώπων",701163,81],["ὡσεὶ",714159,28],["ἀκρίδων",700599,65],["καὶ",707031,7],["φθέγξονται",713442,135],["ἐπὶ",705080,0],["σὲ",711598,163],["οἱ",709436,136],["καταβαίνοντες",707202,146]],"For the Lord has sworn by his arm, [saying], I will fill thee with men as with locusts; and they that come down shall cry against thee."],["15",[["ποιῶν",710582,72],["γῆν",703083,9],["ἐν",704639,0],["τῇ",709436,100],["ἰσχύι",706858,1],["αὐτοῦ",702165,102],["ἑτοιμάζων",705539,72],["οἰκουμένην",709517,173],["ἐν",704639,0],["τῇ",709436,100],["σοφίᾳ",711981,1],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῇ",709436,100],["συνέσει",712460,1],["αὐτοῦ",702165,102],["ἐξέτεινεν",704322,2],["τὸν",709436,5],["οὐρανόν",709844,6]],"The Lord made the earth by his power, preparing the world by his wisdom, by his understanding he stretched out the heaven."],["16",[["εἰς",704105,0],["φωνὴν",713640,9],["ἔθετο",712849,23],["ἦχος",706046,4],["ὕδατος",713071,21],["ἐν",704639,0],["τῷ",709436,113],["οὐρανῷ",709844,114],["καὶ",707031,7],["ἀνήγαγεν",700933,2],["νεφέλας",709277,39],["ἀπ᾿",701425,0],["ἐσχάτου",705519,116],["τῆς",709436,16],["γῆς",703083,17],["ἀστραπὰς",702021,39],["εἰς",704105,0],["ὑετὸν",713074,6],["ἐποίησεν",710582,2],["καὶ",707031,7],["ἐξήγαγεν",704834,2],["φῶς",713642,25],["ἐκ",704132,0],["θησαυρῶν",706258,81],["αὐτοῦ",702165,102]],"At [his] voice he makes a sound of water in the heaven, and brings up clouds from the extremity of the earth; he makes lightnings for rain, and brings light out of his treasures."],["17",[["ἐμωράνθη",709105,37],["πᾶς",710177,14],["ἄνθρωπος",701163,4],["ἀπὸ",701425,0],["γνώσεως",703138,17],["κατῃσχύνθη",707257,37],["πᾶς",710177,14],["χρυσοχόος",713979,14],["ἀπὸ",701425,0],["τῶν",709436,80],["γλυπτῶν",703117,169],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ψευδῆ",714036,68],["ἐχώνευσαν",714010,150],["οὐκ",709805,28],["ἔστιν",704093,91],["πνεῦμα",710566,15],["ἐν",704639,0],["αὐτοῖς",702165,151]],"Every man has completely lost understanding; every goldsmith is confounded because of his graven [images]: for they have cast false [gods], there is no breath in them."],["18",[["μάταιά",708575,195],["ἐστιν",704093,91],["ἔργα",705396,64],["μεμωκημένα",709094,370],["ἐν",704639,0],["καιρῷ",707047,114],["ἐπισκέψεως",705252,17],["αὐτῶν",702165,40],["ἀπολοῦνται",701513,135]],"They are vain works, objects of scorn; in the time of their visitation they shall perish."],["19",[["οὐ",709805,28],["τοιαύτη",712878,29],["μερὶς",708748,12],["τῷ",709436,113],["Ιακωβ",706401,114],["ὅτι",709803,7],["ὁ",709436,3],["πλάσας",710503,182],["τὰ",709436,41],["πάντα",710177,27],["αὐτός",702165,121],["ἐστιν",704093,91],["κληρονομία",707725,12],["αὐτοῦ",702165,102],["κύριος",707996,4],["ὄνομα",709666,15],["αὐτῷ",702165,50]],"Not such is Jacob's portion; for he that formed all things, he is his inheritance; the Lord is his name."],["20",[["διασκορπίζεις",703579,154],["σύ",712181,164],["μοι",708974,159],["σκεύη",711844,42],["πολέμου",710605,18],["καὶ",707031,7],["διασκορπιῶ",703579,165],["ἐν",704639,0],["σοὶ",711925,159],["ἔθνη",704068,42],["καὶ",707031,7],["ἐξαρῶ",704839,165],["ἐκ",704132,0],["σοῦ",711945,133],["βασιλεῖς",702580,52]],"Thou scatterest for me the weapons of war: and I will scatter nations by thee, and will destroy kings by means of thee."],["21",[["καὶ",707031,7],["διασκορπιῶ",703579,165],["ἐν",704639,0],["σοὶ",711925,159],["ἵππον",706790,6],["καὶ",707031,7],["ἀναβάτην",700909,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["διασκορπιῶ",703579,165],["ἐν",704639,0],["σοὶ",711925,159],["ἅρματα",701768,42],["καὶ",707031,7],["ἀναβάτας",700909,57],["αὐτῶν",702165,40]],"And by thee I will scatter the horse and his rider; and by thee I will scatter chariots and them that ride in them."],["22",[["καὶ",707031,7],["διασκορπιῶ",703579,165],["ἐν",704639,0],["σοὶ",711925,159],["νεανίσκον",709232,6],["καὶ",707031,7],["παρθένον",710148,9],["καὶ",707031,7],["διασκορπιῶ",703579,165],["ἐν",704639,0],["σοὶ",711925,159],["ἄνδρα",701150,6],["καὶ",707031,7],["γυναῖκα",703209,9]],"And by thee I will scatter youth and maid; and by thee I will scatter man and woman."],["23",[["καὶ",707031,7],["διασκορπιῶ",703579,165],["ἐν",704639,0],["σοὶ",711925,159],["ποιμένα",710596,6],["καὶ",707031,7],["τὸ",709436,24],["ποίμνιον",710598,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["διασκορπιῶ",703579,165],["ἐν",704639,0],["σοὶ",711925,159],["γεωργὸν",703082,6],["καὶ",707031,7],["τὸ",709436,24],["γεώργιον",703081,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["διασκορπιῶ",703579,165],["ἐν",704639,0],["σοὶ",711925,159],["ἡγεμόνας",705930,57],["καὶ",707031,7],["στρατηγούς",712144,57],["σου",711945,133]],"And by thee I will scatter the shepherd and his flock; and by thee I will scatter the husbandman and his husbandry; and by thee I will scatter leaders and the captains."],["24",[["καὶ",707031,7],["ἀνταποδώσω",701215,165],["τῇ",709436,100],["Βαβυλῶνι",702352,1],["καὶ",707031,7],["πᾶσι",710177,230],["τοῖς",709436,147],["κατοικοῦσι",707534,349],["Χαλδαίοις",713678,148],["πάσας",710177,119],["τὰς",709436,38],["κακίας",707054,39],["αὐτῶν",702165,40],["ἃς",709781,193],["ἐποίησαν",710582,150],["ἐπὶ",705080,0],["Σιων",711816,9],["κατ᾿",707200,0],["ὀφθαλμοὺς",709870,57],["ὑμῶν",713091,145],["λέγει",708124,91],["κύριος",707996,4]],"And I will recompense to Babylon and to all the Chaldeans that dwell [there] all their mischiefs that they have done to Sion before your eyes, saith the Lord."],["25",[["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["πρὸς",710844,0],["σέ",711598,163],["τὸ",709436,24],["ὄρος",709768,25],["τὸ",709436,24],["διεφθαρμένον",703624,414],["τὸ",709436,24],["διαφθεῖρον",703624,47],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["ἐκτενῶ",704322,165],["τὴν",709436,8],["χεῖρά",713787,9],["μου",709032,133],["ἐπὶ",705080,0],["σὲ",711598,163],["καὶ",707031,7],["κατακυλιῶ",707295,165],["σε",711598,163],["ἀπὸ",701425,0],["τῶν",709436,80],["πετρῶν",710446,81],["καὶ",707031,7],["δώσω",703654,165],["σε",711598,163],["ὡς",714148,7],["ὄρος",709768,25],["ἐμπεπυρισμένον",704622,448]],"Behold, I am against thee, the ruined mountain, that destroys the whole earth; and I will stretch out mine hand upon thee, and will roll thee down upon the rocks, and will make thee as a burnt mountain."],["26",[["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["λάβωσιν",708076,234],["ἀπὸ",701425,0],["σοῦ",711945,133],["λίθον",708196,6],["εἰς",704105,0],["γωνίαν",703226,9],["καὶ",707031,7],["λίθον",708196,6],["εἰς",704105,0],["θεμέλιον",706181,25],["ὅτι",709803,7],["εἰς",704105,0],["ἀφανισμὸν",702183,6],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἔσῃ",704093,123],["λέγει",708124,91],["κύριος",707996,4]],"And they shall not take from thee a stone for a corner, nor a stone for a foundation: for thou shalt be a desolation for ever, saith the Lord."],["27",[["ἄρατε",700473,74],["σημεῖον",711748,25],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["σαλπίσατε",711425,74],["ἐν",704639,0],["ἔθνεσιν",704068,96],["σάλπιγγι",711424,1],["ἁγιάσατε",700153,74],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["ἔθνη",704068,42],["παραγγείλατε",710004,74],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["βασιλείαις",702577,76],["Αραρατ",701688,118],["παρ᾿",709995,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["τοῖς",709436,147],["Ασχαναζαίοις",702052,148],["ἐπιστήσατε",705756,74],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["βελοστάσεις",702645,39],["ἀναβιβάσατε",700910,74],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["ἵππον",706790,6],["ὡς",714148,7],["ἀκρίδων",700599,65],["πλῆθος",710529,25]],"Lift up a standard in the land, sound the trumpet among the nations, consecrate the nations against her, raise up kings against her by me, and [that] for the people of Achanaz; set against her engines of war; bring up against her horses as a multitude of locusts."],["28",[["ἁγιάσατε",700153,74],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["ἔθνη",704068,42],["τὸν",709436,5],["βασιλέα",702580,6],["τῶν",709436,80],["Μήδων",708864,81],["καὶ",707031,7],["πάσης",710177,82],["τῆς",709436,16],["γῆς",703083,17],["τοὺς",709436,58],["ἡγουμένους",705931,236],["αὐτοῦ",702165,102],["καὶ",707031,7],["πάντας",710177,60],["τοὺς",709436,58],["στρατηγοὺς",712144,57],["αὐτοῦ",702165,102]],"Bring up nations against her, [even] the king of the Medes and of the whole earth, his rulers, and all his captains."],["29",[["ἐσείσθη",711633,37],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["ἐπόνεσεν",710656,2],["διότι",703734,7],["ἐξανέστη",704865,2],["ἐπὶ",705080,0],["Βαβυλῶνα",702352,9],["λογισμὸς",708234,4],["κυρίου",707996,18],["τοῦ",709436,20],["θεῖναι",712849,106],["τὴν",709436,8],["γῆν",703083,9],["Βαβυλῶνος",702352,17],["εἰς",704105,0],["ἀφανισμὸν",702183,6],["καὶ",707031,7],["μὴ",708851,28],["κατοικεῖσθαι",707534,110],["αὐτήν",702165,104]],"The earth has quaked and been troubled, because the purpose of the Lord has risen up against Babylon, to make the land of Babylon a desolation, and uninhabitable."],["30",[["ἐξέλιπεν",704237,2],["μαχητὴς",708602,4],["Βαβυλῶνος",702352,17],["τοῦ",709436,20],["πολεμεῖν",710601,55],["καθήσονται",707007,135],["ἐκεῖ",704181,28],["ἐν",704639,0],["περιοχῇ",710360,1],["ἐθραύσθη",706304,37],["ἡ",709436,10],["δυναστεία",703841,12],["αὐτῶν",702165,40],["ἐγενήθησαν",703104,99],["ὡσεὶ",714159,28],["γυναῖκες",703209,191],["ἐνεπυρίσθη",704622,37],["τὰ",709436,41],["σκηνώματα",711849,42],["αὐτῆς",702165,86],["συνετρίβησαν",712520,99],["οἱ",709436,136],["μοχλοὶ",709040,52],["αὐτῆς",702165,86]],"The warrior of Babylon has failed to fight; they shall sit there in the siege; their power is broken; they are become like women; her tabernacles have been set on fire; her bars are broken."],["31",[["διώκων",703768,72],["εἰς",704105,0],["ἀπάντησιν",701348,9],["διώκοντος",703768,152],["διώξεται",703768,93],["καὶ",707031,7],["ἀναγγέλλων",700921,72],["εἰς",704105,0],["ἀπάντησιν",701348,9],["ἀναγγέλλοντος",700921,152],["τοῦ",709436,20],["ἀναγγεῖλαι",700921,106],["τῷ",709436,113],["βασιλεῖ",702580,114],["Βαβυλῶνος",702352,17],["ὅτι",709803,7],["ἑάλωκεν",700673,171],["ἡ",709436,10],["πόλις",710612,12],["αὐτοῦ",702165,102]],"One shall rush, running to meet [another] runner, and one [shall go] with tidings to meet [another] with tidings, to bring tidings to the king of Babylon, that his city is taken."],["32",[["ἀπ᾿",701425,0],["ἐσχάτου",705519,116],["τῶν",709436,130],["διαβάσεων",703421,65],["αὐτοῦ",702165,102],["ἐλήμφθησαν",708076,99],["καὶ",707031,7],["τὰ",709436,41],["συστέματα",712559,42],["αὐτῶν",702165,40],["ἐνέπρησαν",704617,150],["ἐν",704639,0],["πυρί",711088,54],["καὶ",707031,7],["ἄνδρες",701150,52],["αὐτοῦ",702165,102],["οἱ",709436,136],["πολεμισταὶ",710604,52],["ἐξέρχονται",704909,269]],"At the end of his passages they were taken, and his cisterns they have burnt with fire, and his warriors are going forth."],["33",[["διότι",703734,7],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["οἶκοι",709516,52],["βασιλέως",702580,18],["Βαβυλῶνος",702352,17],["ὡς",714148,7],["ἅλων",700741,12],["ὥριμος",714139,14],["ἀλοηθήσονται",700716,144],["ἔτι",705538,28],["μικρὸν",708915,27],["καὶ",707031,7],["ἥξει",705956,127],["ὁ",709436,3],["ἄμητος",700819,4],["αὐτῆς",702165,86]],"For thus saith the Lord, The houses of the king of Babylon shall be threshed as a floor in the season; yet a little while, and her harvest shall come."],["34",[["κατέφαγέν",707519,2],["με",708618,163],["ἐμερίσατό",708744,23],["με",708618,163],["κατέλαβέν",707300,2],["με",708618,163],["σκεῦος",711844,25],["λεπτὸν",708153,46],["Ναβουχοδονοσορ",709149,4],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,17],["κατέπιέν",707374,2],["με",708618,163],["ὡς",714148,7],["δράκων",703822,4],["ἔπλησεν",710532,2],["τὴν",709436,8],["κοιλίαν",707761,9],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["τῆς",709436,16],["τρυφῆς",713008,17],["μου",709032,133],["ἐξῶσέν",704985,2],["με",708618,163]],"He has devoured me, he has torn me asunder, airy darkness has come upon me; Nabuchodonosor king of Babylon has swallowed me up, as a dragon has he filled his belly with my delicacies."],["35",[["οἱ",709436,136],["μόχθοι",709039,52],["μου",709032,133],["καὶ",707031,7],["αἱ",709436,190],["ταλαιπωρίαι",712695,191],["μου",709032,133],["εἰς",704105,0],["Βαβυλῶνα",702352,9],["ἐρεῖ",705415,127],["κατοικοῦσα",707534,188],["Σιων",711816,9],["καὶ",707031,7],["τὸ",709436,24],["αἷμά",700442,25],["μου",709032,133],["ἐπὶ",705080,0],["τοὺς",709436,58],["κατοικοῦντας",707534,235],["Χαλδαίους",713678,57],["ἐρεῖ",705415,127],["Ιερουσαλημ",706644,12]],"My troubles and my distresses have driven me out into Babylon, shall she that dwells in Sion say; and my blood [shall be] upon the Chaldeans dwelling [there], shall Jerusalem say."],["36",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["κρινῶ",707905,165],["τὴν",709436,8],["ἀντίδικόν",701233,36],["σου",711945,133],["καὶ",707031,7],["ἐκδικήσω",704174,165],["τὴν",709436,8],["ἐκδίκησίν",704175,9],["σου",711945,133],["καὶ",707031,7],["ἐρημώσω",705421,165],["τὴν",709436,8],["θάλασσαν",706069,9],["αὐτῆς",702165,86],["καὶ",707031,7],["ξηρανῶ",709419,165],["τὴν",709436,8],["πηγὴν",710450,9],["αὐτῆς",702165,86]],"Therefore thus saith the Lord, Behold, I will judge thine adversary, and I will execute vengeance for thee; and I will waste her sea, and dry up her fountain."],["37",[["καὶ",707031,7],["ἔσται",704093,93],["Βαβυλὼν",702352,12],["εἰς",704105,0],["ἀφανισμὸν",702183,6],["καὶ",707031,7],["οὐ",709805,28],["κατοικηθήσεται",707534,134]],"And Babylon shall be a desolation, and shall not be inhabited."],["38",[["ἅμα",700745,28],["ὡς",714148,7],["λέοντες",708171,52],["ἐξηγέρθησαν",704889,99],["καὶ",707031,7],["ὡς",714148,7],["σκύμνοι",711903,52],["λεόντων",708171,81]],"For they rose up together as lions, and as lions' whelps."],["39",[["ἐν",704639,0],["τῇ",709436,100],["θερμασίᾳ",706214,1],["αὐτῶν",702165,40],["δώσω",703654,165],["πότημα",710698,25],["αὐτοῖς",702165,151],["καὶ",707031,7],["μεθύσω",708676,165],["αὐτούς",702165,62],["ὅπως",709719,7],["καρωθῶσιν",707164,272],["καὶ",707031,7],["ὑπνώσωσιν",713182,234],["ὕπνον",713181,6],["αἰώνιον",700505,27],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἐγερθῶσι",703949,272],["λέγει",708124,91],["κύριος",707996,4]],"In their heat I will give them a draught, and make them drunk, that they may be stupified, and sleep an everlasting sleep, and not awake, saith the Lord."],["40",[["καταβιβάσω",707208,165],["αὐτοὺς",702165,62],["ὡς",714148,7],["ἄρνας",701731,57],["εἰς",704105,0],["σφαγὴν",712568,9],["καὶ",707031,7],["ὡς",714148,7],["κριοὺς",707906,57],["μετ᾿",708780,0],["ἐρίφων",705429,81]],"And bring thou them down as lambs to the slaughter, and rams with kids."],["41",[["πῶς",711121,28],["ἑάλω",700673,2],["καὶ",707031,7],["ἐθηρεύθη",706248,37],["τὸ",709436,24],["καύχημα",707570,25],["πάσης",710177,82],["τῆς",709436,16],["γῆς",703083,17],["πῶς",711121,28],["ἐγένετο",703104,23],["Βαβυλὼν",702352,12],["εἰς",704105,0],["ἀφανισμὸν",702183,6],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96]],"How has the boast of all the earth been taken and caught in a snare! how has Babylon become a desolation among the nations!"],["42",[["ἀνέβη",700905,2],["ἐπὶ",705080,0],["Βαβυλῶνα",702352,9],["ἡ",709436,10],["θάλασσα",706069,12],["ἐν",704639,0],["ἤχῳ",706046,114],["κυμάτων",707968,44],["αὐτῆς",702165,86],["καὶ",707031,7],["κατεκαλύφθη",707260,37]],"The sea has come up upon Babylon with the sound of its waves, and she is covered."],["43",[["ἐγενήθησαν",703104,99],["αἱ",709436,190],["πόλεις",710612,191],["αὐτῆς",702165,86],["γῆ",703083,12],["ἄνυδρος",701285,29],["καὶ",707031,7],["ἄβατος",700023,29],["οὐ",709805,28],["κατοικήσει",707534,127],["ἐν",704639,0],["αὐτῇ",702165,105],["οὐδὲ",709816,7],["εἷς",704106,14],["οὐδὲ",709816,7],["μὴ",708851,28],["καταλύσῃ",707323,123],["ἐν",704639,0],["αὐτῇ",702165,105],["υἱὸς",713075,4],["ἀνθρώπου",701163,18]],"Her cities are become like a dry and trackless land; not so much as one [man] shall dwell in it, neither shall a son of man lodge in it."],["44",[["καὶ",707031,7],["ἐκδικήσω",704174,165],["ἐπὶ",705080,0],["Βαβυλῶνα",702352,9],["καὶ",707031,7],["ἐξοίσω",704356,165],["ἃ",709781,69],["κατέπιεν",707374,2],["ἐκ",704132,0],["τοῦ",709436,20],["στόματος",712125,21],["αὐτῆς",702165,86],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["συναχθῶσιν",712375,272],["πρὸς",710844,0],["αὐτὴν",702165,104],["ἔτι",705538,28],["τὰ",709436,41],["ἔθνη",704068,42]],"And I will take vengeance on Babylon, and bring forth out of her mouth what she has swallowed down, and the nations shall no more be gathered to her:"],["49",[["καὶ",707031,7],["ἐν",704639,0],["Βαβυλῶνι",702352,1],["πεσοῦνται",710481,135],["τραυματίαι",712921,52],["πάσης",710177,82],["τῆς",709436,16],["γῆς",703083,17]],"and in Babylon the slain men of all the earth shall fall."],["50",[["ἀνασῳζόμενοι",701064,348],["ἐκ",704132,0],["γῆς",703083,17],["πορεύεσθε",710667,374],["καὶ",707031,7],["μὴ",708851,28],["ἵστασθε",706846,73],["οἱ",709436,136],["μακρόθεν",708417,28],["μνήσθητε",708960,372],["τοῦ",709436,35],["κυρίου",707996,18],["καὶ",707031,7],["Ιερουσαλημ",706644,12],["ἀναβήτω",700905,45],["ἐπὶ",705080,0],["τὴν",709436,8],["καρδίαν",707141,9],["ὑμῶν",713091,145]],"Go forth of the land, ye that escape, and stay not; ye that are afar off, remember the Lord, and let Jerusalem come into your mind."],["51",[["ᾐσχύνθημεν",700485,485],["ὅτι",709803,7],["ἠκούσαμεν",700587,289],["ὀνειδισμὸν",709657,6],["ἡμῶν",705999,145],["κατεκάλυψεν",707260,2],["ἀτιμία",702094,12],["τὸ",709436,24],["πρόσωπον",710986,25],["ἡμῶν",705999,145],["εἰσῆλθον",704114,150],["ἀλλογενεῖς",700690,138],["εἰς",704105,0],["τὰ",709436,41],["ἅγια",700159,68],["ἡμῶν",705999,145],["εἰς",704105,0],["οἶκον",709516,6],["κυρίου",707996,18]],"We are ashamed, because we have heard our reproach; disgrace has covered our face; aliens are come into our sanctuary, [even] into the house of the Lord."],["52",[["διὰ",703417,0],["τοῦτο",709858,129],["ἰδοὺ",706497,88],["ἡμέραι",705984,191],["ἔρχονται",705453,269],["λέγει",708124,91],["κύριος",707996,4],["καὶ",707031,7],["ἐκδικήσω",704174,165],["ἐπὶ",705080,0],["τὰ",709436,41],["γλυπτὰ",703117,68],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐν",704639,0],["πάσῃ",710177,101],["τῇ",709436,100],["γῇ",703083,1],["αὐτῆς",702165,86],["πεσοῦνται",710481,135],["τραυματίαι",712921,52]],"Therefore, behold, the days come, saith the Lord, when I will take vengeance upon her graven [images]: and slain men shall fall in all her land."],["53",[["ὅτι",709803,7],["ἐὰν",703912,7],["ἀναβῇ",700905,172],["Βαβυλὼν",702352,12],["ὡς",714148,7],["ὁ",709436,3],["οὐρανὸς",709844,4],["καὶ",707031,7],["ὅτι",709803,7],["ἐὰν",703912,7],["ὀχυρώσῃ",709890,172],["ὕψος",713288,25],["ἰσχύος",706858,17],["αὐτῆς",702165,86],["παρ᾿",709995,0],["ἐμοῦ",704580,133],["ἥξουσιν",705956,218],["ἐξολεθρεύοντες",704956,146],["αὐτήν",702165,104],["λέγει",708124,91],["κύριος",707996,4]],"For though Babylon should go up as the heaven, and though she should strengthen her walls with her power, from me shall come they that shall destroy her, saith the Lord."],["54",[["φωνὴ",713640,12],["κραυγῆς",707886,17],["ἐν",704639,0],["Βαβυλῶνι",702352,1],["καὶ",707031,7],["συντριβὴ",712519,12],["μεγάλη",708653,29],["ἐν",704639,0],["γῇ",703083,1],["Χαλδαίων",713678,81]],"A sound of a cry in Babylon, and great destruction in the land of the Chaldeans:"],["55",[["ὅτι",709803,7],["ἐξωλέθρευσεν",704956,2],["κύριος",707996,4],["τὴν",709436,8],["Βαβυλῶνα",702352,9],["καὶ",707031,7],["ἀπώλεσεν",701513,2],["ἀπ᾿",701425,0],["αὐτῆς",702165,86],["φωνὴν",713640,9],["μεγάλην",708653,36],["ἠχοῦσαν",706045,78],["ὡς",714148,7],["ὕδατα",713071,42],["πολλά",710646,68],["ἔδωκεν",703654,2],["εἰς",704105,0],["ὄλεθρον",709563,6],["φωνὴν",713640,9],["αὐτῆς",702165,86]],"for the Lord has utterly destroyed Babylon, and cut off from her the great voice sounding as many waters: he has consigned her voice to destruction."],["56",[["ὅτι",709803,7],["ἦλθεν",705453,2],["ἐπὶ",705080,0],["Βαβυλῶνα",702352,9],["ταλαιπωρία",712695,12],["ἑάλωσαν",700673,150],["οἱ",709436,136],["μαχηταὶ",708602,52],["αὐτῆς",702165,86],["ἐπτόηται",711062,403],["τὸ",709436,24],["τόξον",712898,25],["αὐτῶν",702165,40],["ὅτι",709803,7],["θεὸς",706192,4],["ἀνταποδίδωσιν",701215,91],["αὐτοῖς",702165,151],["κύριος",707996,4],["ἀνταποδίδωσιν",701215,91],["αὐτῇ",702165,105],["τὴν",709436,8],["ἀνταπόδοσιν",701217,9]],"For distress has come upon Babylon, her warriors are taken, their bows are useless: for God recompenses them."],["57",[["καὶ",707031,7],["μεθύσει",708676,127],["μέθῃ",708667,1],["τοὺς",709436,58],["ἡγεμόνας",705930,57],["αὐτῆς",702165,86],["καὶ",707031,7],["τοὺς",709436,58],["σοφοὺς",711985,60],["αὐτῆς",702165,86],["καὶ",707031,7],["τοὺς",709436,58],["στρατηγοὺς",712144,57],["αὐτῆς",702165,86],["λέγει",708124,91],["ὁ",709436,3],["βασιλεύς",702580,4],["κύριος",707996,4],["παντοκράτωρ",709986,4],["ὄνομα",709666,15],["αὐτῷ",702165,50]],"The Lord recompenses, and will make her leaders and her wise men and her captains completely drunk, saith the King, the Lord Almighty is his name."],["58",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["τεῖχος",712759,15],["Βαβυλῶνος",702352,17],["ἐπλατύνθη",710508,37],["κατασκαπτόμενον",707416,644],["κατασκαφήσεται",707416,134],["καὶ",707031,7],["αἱ",709436,190],["πύλαι",711082,191],["αὐτῆς",702165,86],["αἱ",709436,190],["ὑψηλαὶ",713285,192],["ἐμπυρισθήσονται",704622,144],["καὶ",707031,7],["οὐ",709805,28],["κοπιάσουσιν",707824,218],["λαοὶ",708094,52],["εἰς",704105,0],["κενόν",707612,27],["καὶ",707031,7],["ἔθνη",704068,64],["ἐν",704639,0],["ἀρχῇ",701836,1],["ἐκλείψουσιν",704237,218]],"Thus saith the Lord, The wall of Babylon was made broad, but it shall be completely broken down, and her high gates shall be burnt with fire; and the peoples shall not labour in vain, nor the nations fail in [their] rule."],["59",[["ὁ",709436,3],["λόγος",708236,4],["ὃν",709781,112],["ἐνετείλατο",704791,23],["κύριος",707996,4],["Ιερεμια",706611,114],["τῷ",709436,113],["προφήτῃ",711009,114],["εἰπεῖν",705373,106],["τῷ",709436,113],["Σαραια",711518,114],["υἱῷ",713075,114],["Νηριου",709298,18],["υἱοῦ",713075,18],["Μαασαιου",708311,18],["ὅτε",709802,28],["ἐπορεύετο",710667,19],["παρὰ",709995,0],["Σεδεκιου",711618,18],["βασιλέως",702580,18],["Ιουδα",706768,18],["εἰς",704105,0],["Βαβυλῶνα",702352,9],["ἐν",704639,0],["τῷ",709436,53],["ἔτει",705543,54],["τῷ",709436,53],["τετάρτῳ",712811,97],["τῆς",709436,16],["βασιλείας",702577,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["Σαραιας",711518,4],["ἄρχων",701860,72],["δώρων",703907,44]],"The Word which the Lord commanded the Prophet Jeremias to say to Saræas son of Nerias, son of Maasæas, when he went from Sedekias king of Juda to Babylon, in the fourth year of his reign. And Saræas was over the bounties."],["60",[["καὶ",707031,7],["ἔγραψεν",703194,2],["Ιερεμιας",706611,4],["πάντα",710177,68],["τὰ",709436,41],["κακά",707066,68],["ἃ",709781,69],["ἥξει",705956,127],["ἐπὶ",705080,0],["Βαβυλῶνα",702352,9],["ἐν",704639,0],["βιβλίῳ",702719,54],["ἑνί",704106,97],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["τοὺς",709436,58],["γεγραμμένους",703194,360],["ἐπὶ",705080,0],["Βαβυλῶνα",702352,9]],"And Jeremias wrote in a book all the evils which should come upon Babylon, [even] all these words that are written against Babylon."],["61",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιερεμιας",706611,4],["πρὸς",710844,0],["Σαραιαν",711518,6],["ὅταν",709801,28],["ἔλθῃς",705453,175],["εἰς",704105,0],["Βαβυλῶνα",702352,9],["καὶ",707031,7],["ὄψῃ",709725,123],["καὶ",707031,7],["ἀναγνώσῃ",700922,123],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62]],"And Jeremias said to Saræas, When thou art come to Babylon, and shalt see and read all these words;"],["62",[["καὶ",707031,7],["ἐρεῖς",705415,166],["κύριε",707996,153],["κύριε",707996,153],["σὺ",712181,164],["ἐλάλησας",708071,162],["ἐπὶ",705080,0],["τὸν",709436,5],["τόπον",712903,6],["τοῦτον",709858,85],["τοῦ",709436,20],["ἐξολεθρεῦσαι",704956,106],["αὐτὸν",702165,85],["καὶ",707031,7],["τοῦ",709436,20],["μὴ",708851,28],["εἶναι",704093,55],["ἐν",704639,0],["αὐτῷ",702165,50],["κατοικοῦντας",707534,235],["ἀπὸ",701425,0],["ἀνθρώπου",701163,18],["ἕως",705792,0],["κτήνους",707934,21],["ὅτι",709803,7],["ἀφανισμὸς",702183,4],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἔσται",704093,93]],"then thou shalt say, O Lord God, thou hast spoken against this place, to destroy it, and that there should be none to dwell in it, neither man nor beast; for it shall be a desolation for ever."],["63",[["καὶ",707031,7],["ἔσται",704093,93],["ὅταν",709801,28],["παύσῃ",710202,172],["τοῦ",709436,20],["ἀναγινώσκειν",700922,55],["τὸ",709436,24],["βιβλίον",702719,25],["τοῦτο",709858,129],["καὶ",707031,7],["ἐπιδήσεις",705118,154],["ἐπ᾿",705080,0],["αὐτὸ",702165,129],["λίθον",708196,6],["καὶ",707031,7],["ῥίψεις",711267,154],["αὐτὸ",702165,129],["εἰς",704105,0],["μέσον",708768,27],["τοῦ",709436,35],["Εὐφράτου",705716,18]],"And it shall come to pass, when thou shalt cease from reading this book, that thou shalt bind a stone upon it, and cast it into the midst of Euphrates;"],["64",[["καὶ",707031,7],["ἐρεῖς",705415,166],["οὕτως",709859,28],["καταδύσεται",707250,93],["Βαβυλὼν",702352,12],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἀναστῇ",701173,172],["ἀπὸ",701425,0],["προσώπου",710986,21],["τῶν",709436,80],["κακῶν",707066,169],["ὧν",709781,252],["ἐγὼ",704018,164],["ἐπάγω",704994,157],["ἐπ᾿",705080,0],["αὐτήν",702165,104]],"and shalt say, Thus shall Babylon sink, and not rise, because of the evils which I bring upon it."]]