",702352,1],["ἀποθανῇ",701461,123],["καὶ",707031,7],["ἐκεῖ",704181,28],["ταφήσῃ",706103,123],["σὺ",712181,164],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["φίλοι",713492,138],["σου",711945,133],["οἷς",709781,311],["ἐπροφήτευσας",711008,162],["αὐτοῖς",702165,151],["ψευδῆ",714036,68]],"And thou and all the dwellers in thine house shall go into captivity: and thou shalt die in Babylon, and there thou and all thy friends shall be buried, to whom thou hast prophesied lies."],["7",[["ἠπάτησάς",701364,162],["με",708618,163],["κύριε",707996,153],["καὶ",707031,7],["ἠπατήθην",701364,156],["ἐκράτησας",707879,162],["καὶ",707031,7],["ἠδυνάσθης",703838,168],["ἐγενόμην",703104,161],["εἰς",704105,0],["γέλωτα",703032,6],["πᾶσαν",710177,36],["ἡμέραν",705984,9],["διετέλεσα",703605,155],["μυκτηριζόμενος",709052,466]],"Thou hast deceived me, O Lord, and I have been deceived: thou hast been strong, and hast prevailed: I am become a laughing-stock, I am continually mocked every day."],["8",[["ὅτι",709803,7],["πικρῷ",710475,30],["λόγῳ",708236,114],["μου",709032,133],["γελάσομαι",703019,181],["ἀθεσίαν",700366,9],["καὶ",707031,7],["ταλαιπωρίαν",712695,9],["ἐπικαλέσομαι",705153,181],["ὅτι",709803,7],["ἐγενήθη",703104,37],["λόγος",708236,4],["κυρίου",707996,18],["εἰς",704105,0],["ὀνειδισμὸν",709657,6],["ἐμοὶ",704577,159],["καὶ",707031,7],["εἰς",704105,0],["χλευασμὸν",713875,6],["πᾶσαν",710177,36],["ἡμέραν",705984,9],["μου",709032,133]],"For I will laugh with my bitter speech, I will call upon rebellion and misery: for the word of the Lord is become a reproach to me and a mockery all my days."],["9",[["καὶ",707031,7],["εἶπα",705373,155],["οὐ",709805,28],["μὴ",708851,28],["ὀνομάσω",709667,165],["τὸ",709436,24],["ὄνομα",709666,25],["κυρίου",707996,18],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["λαλήσω",708071,165],["ἔτι",705538,28],["ἐπὶ",705080,0],["τῷ",709436,53],["ὀνόματι",709666,54],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐγένετο",703104,23],["ὡς",714148,7],["πῦρ",711088,15],["καιόμενον",707049,208],["φλέγον",713518,32],["ἐν",704639,0],["τοῖς",709436,95],["ὀστέοις",709792,96],["μου",709032,133],["καὶ",707031,7],["παρεῖμαι",710149,326],["πάντοθεν",709984,28],["καὶ",707031,7],["οὐ",709805,28],["δύναμαι",703838,254],["φέρειν",713428,55]],"Then I said, I will by no means name the name of the Lord, and I will no more at all speak in his name. But it was as burning fire flaming in my bones, and I am utterly weakened on all sides, and cannot bear [up]."],["10",[["ὅτι",709803,7],["ἤκουσα",700587,155],["ψόγον",714061,6],["πολλῶν",710646,169],["συναθροιζομένων",712378,299],["κυκλόθεν",707956,28],["ἐπισύστητε",705283,74],["καὶ",707031,7],["ἐπισυστῶμεν",705283,79],["αὐτῷ",702165,50],["πάντες",710177,138],["ἄνδρες",701150,52],["φίλοι",713492,138],["αὐτοῦ",702165,102],["τηρήσατε",712844,74],["τὴν",709436,8],["ἐπίνοιαν",705215,9],["αὐτοῦ",702165,102],["εἰ",704071,7],["ἀπατηθήσεται",701364,134],["καὶ",707031,7],["δυνησόμεθα",703838,141],["αὐτῷ",702165,50],["καὶ",707031,7],["λημψόμεθα",708076,141],["τὴν",709436,8],["ἐκδίκησιν",704175,9],["ἡμῶν",705999,145],["ἐξ",704132,0],["αὐτοῦ",702165,102]],"For I have heard the reproach of many gathering round, [saying], Conspire ye, and let us conspire together against him, [even] all his friends: watch his intentions, if perhaps he shall be deceived, and we shall prevail against him, and we shall be avenged on him."],["11",[["καὶ",707031,7],["κύριος",707996,4],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["καθὼς",707030,28],["μαχητὴς",708602,4],["ἰσχύων",706858,65],["διὰ",703417,0],["τοῦτο",709858,129],["ἐδίωξαν",703768,150],["καὶ",707031,7],["νοῆσαι",709327,106],["οὐκ",709805,28],["ἠδύναντο",703838,139],["ᾐσχύνθησαν",700485,99],["σφόδρα",712586,28],["ὅτι",709803,7],["οὐκ",709805,28],["ἐνόησαν",709327,150],["ἀτιμίας",702094,39],["αὐτῶν",702165,40],["αἳ",709781,256],["δι᾿",703417,0],["αἰῶνος",700504,18],["οὐκ",709805,28],["ἐπιλησθήσονται",705187,144]],"But the Lord was with me as a mighty man of war: therefore they persecuted [me], but could not perceive [anything against me]; they were greatly confounded, for they perceived not their disgrace, which shall never be forgotten."],["12",[["κύριε",707996,153],["δοκιμάζων",703776,72],["δίκαια",703694,68],["συνίων",712481,72],["νεφροὺς",709282,57],["καὶ",707031,7],["καρδίας",707141,39],["ἴδοιμι",709725,346],["τὴν",709436,8],["παρὰ",709995,0],["σοῦ",711945,133],["ἐκδίκησιν",704175,9],["ἐν",704639,0],["αὐτοῖς",702165,151],["ὅτι",709803,7],["πρὸς",710844,0],["σὲ",711598,163],["ἀπεκάλυψα",701474,155],["τὰ",709436,41],["ἀπολογήματά",701517,42],["μου",709032,133]],"O Lord, that provest just [deeds], understanding the reins and hearts, let me see thy vengeance upon them: for to thee I have revealed my cause."],["13",[["ᾄσατε",700299,74],["τῷ",709436,113],["κυρίῳ",707996,114],["αἰνέσατε",700459,74],["αὐτῷ",702165,50],["ὅτι",709803,7],["ἐξείλατο",704838,23],["ψυχὴν",714070,9],["πένητος",710248,18],["ἐκ",704132,0],["χειρὸς",713787,17],["πονηρευομένων",710658,299]],"Sing ye to the Lord, sing praise to him: for he has rescued the soul of the poor from the hand of evil-doers."],["14",[["ἐπικατάρατος",705159,29],["ἡ",709436,10],["ἡμέρα",705984,12],["ἐν",704639,0],["ᾗ",709781,108],["ἐτέχθην",712853,156],["ἐν",704639,0],["αὐτῇ",702165,105],["ἡ",709436,10],["ἡμέρα",705984,12],["ἐν",704639,0],["ᾗ",709781,108],["ἔτεκέν",712853,2],["με",708618,163],["ἡ",709436,10],["μήτηρ",708892,12],["μου",709032,133],["μὴ",708851,28],["ἔστω",704093,31],["ἐπευκτή",705073,12]],"Cursed be the day wherein I was born: the day wherein my mother brought me forth, let it not be blessed."],["15",[["ἐπικατάρατος",705159,14],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ὁ",709436,3],["εὐαγγελισάμενος",705547,248],["τῷ",709436,113],["πατρί",710189,114],["μου",709032,133],["λέγων",708124,72],["ἐτέχθη",712853,37],["σοι",711925,159],["ἄρσεν",701818,26],["εὐφραινόμενος",705715,122]],"Cursed be the man who brought the glad tidings to my father, saying, A male child is born to thee."],["16",[["ἔστω",704093,31],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ἐκεῖνος",704183,121],["ὡς",714148,7],["αἱ",709436,190],["πόλεις",710612,191],["ἃς",709781,193],["κατέστρεψεν",707444,2],["κύριος",707996,4],["ἐν",704639,0],["θυμῷ",706334,114],["καὶ",707031,7],["οὐ",709805,28],["μετεμελήθη",708805,37],["ἀκουσάτω",700587,45],["κραυγῆς",707886,17],["τὸ",709436,24],["πρωὶ",711021,28],["καὶ",707031,7],["ἀλαλαγμοῦ",700631,18],["μεσημβρίας",708758,17]],"Let that man rejoice as the cities which the Lord overthrew in wrath, and repented not: let him hear crying in the morning, and loud lamentation at noon;"],["17",[["ὅτι",709803,7],["οὐκ",709805,28],["ἀπέκτεινέν",701498,2],["με",708618,163],["ἐν",704639,0],["μήτρᾳ",708894,1],["μητρὸς",708892,17],["καὶ",707031,7],["ἐγένετό",703104,23],["μοι",708974,159],["ἡ",709436,10],["μήτηρ",708892,12],["μου",709032,133],["τάφος",712738,4],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["μήτρα",708894,12],["συλλήμψεως",712265,17],["αἰωνίας",700505,82]],"because he slew me not in the womb, and my mother became not my tomb, and her womb always great with me."],["18",[["ἵνα",706747,7],["τί",712867,126],["τοῦτο",709858,129],["ἐξῆλθον",704909,150],["ἐκ",704132,0],["μήτρας",708894,17],["τοῦ",709436,20],["βλέπειν",702740,55],["κόπους",707825,57],["καὶ",707031,7],["πόνους",710661,57],["καὶ",707031,7],["διετέλεσαν",703605,150],["ἐν",704639,0],["αἰσχύνῃ",700483,1],["αἱ",709436,190],["ἡμέραι",705984,191],["μου",709032,133]],"Why is it that I came forth of the womb to see troubles and distresses, and my days are spent in shame?"]]