[["1",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Πασχωρ",710184,4],["υἱὸς",713075,4],["Εμμηρ",704571,18],["ὁ",709436,3],["ἱερεύς",706614,4],["καὶ",707031,7],["οὗτος",709858,121],["ἦν",704093,13],["καθεσταμένος",707011,419],["ἡγούμενος",705931,122],["οἴκου",709516,18],["κυρίου",707996,18],["τοῦ",709436,35],["Ιερεμιου",706611,18],["προφητεύοντος",711008,152],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62]],"Now Paschor the son of Emmer, the priest, who also had been appointed chief of the house of the Lord, heard Jeremias prophesying these words."],["2",[["καὶ",707031,7],["ἐπάταξεν",710185,2],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐνέβαλεν",704547,2],["αὐτὸν",702165,85],["εἰς",704105,0],["τὸν",709436,5],["καταρράκτην",707404,6],["ὃς",709781,213],["ἦν",704093,13],["ἐν",704639,0],["πύλῃ",711082,1],["οἴκου",709516,18],["ἀποτεταγμένου",701608,482],["τοῦ",709436,20],["ὑπερῴου",713172,21],["ὃς",709781,33],["ἦν",704093,13],["ἐν",704639,0],["οἴκῳ",709516,114],["κυρίου",707996,18]],"And he smote him, and cast him into the dungeon which was by the gate of the upper house that was set apart, which was by the house of the Lord."],["3",[["καὶ",707031,7],["ἐξήγαγεν",704834,2],["Πασχωρ",710184,4],["τὸν",709436,5],["Ιερεμιαν",706611,6],["ἐκ",704132,0],["τοῦ",709436,35],["καταρράκτου",707404,18],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["Ιερεμιας",706611,4],["οὐχὶ",709862,28],["Πασχωρ",710184,6],["ἐκάλεσεν",707084,2],["κύριος",707996,4],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["ἀλλ᾿",700680,7],["ἢ",705924,7],["μέτοικον",708836,6]],"And Paschor brought Jeremias out of the dungeon: and Jeremias said to him, [The Lord] has not called thy name Paschor, but Exile."],["4",[["διότι",703734,7],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["δίδωμί",703654,157],["σε",711598,163],["εἰς",704105,0],["μετοικίαν",708834,9],["σὺν",712372,0],["πᾶσι",710177,230],["τοῖς",709436,147],["φίλοις",713492,230],["σου"