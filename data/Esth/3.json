,703890,116],["ὅς",709781,213],["ἐστιν",704093,91],["Αδαρ",700229,4],["καὶ",707031,7],["διαρπάσαι",703562,106],["τὰ",709436,41],["ὑπάρχοντα",713102,237],["αὐτῶν",702165,40]],"And [the message] was sent by posts throughout the kingdom of Artaxerxes, to destroy utterly the race of the Jews on the first day of the twelfth month, which is Adar, and to plunder their goods."],["13a",[["τῆς",709436,16],["δὲ",703303,11],["ἐπιστολῆς",705272,17],["ἐστιν",704093,91],["τὸ",709436,34],["ἀντίγραφον",701229,15],["τόδε",709446,132],["βασιλεὺς",702580,4],["μέγας",708653,14],["Ἀρταξέρξης",701824,4],["τοῖς",709436,147],["ἀπὸ",701425,0],["τῆς",709436,16],["Ἰνδικῆς",706750,17],["ἕως",705792,0],["τῆς",709436,16],["Αἰθιοπίας",700419,17],["ἑκατὸν",704136,59],["εἴκοσι",704085,59],["ἑπτὰ",705357,59],["χωρῶν",714011,65],["ἄρχουσι",701862,148],["καὶ",707031,7],["τοπάρχαις",712901,148],["ὑποτεταγμένοις",713250,521],["τάδε",709446,71],["γράφει",703194,91]],null],["13b",[["πολλῶν",710646,83],["ἐπάρξας",705046,182],["ἐθνῶν",704068,44],["καὶ",707031,7],["πάσης",710177,82],["ἐπικρατήσας",705176,182],["οἰκουμένης",709517,422],["ἐβουλήθην",702795,156],["μὴ",708851,28],["τῷ",709436,53],["θράσει",706297,54],["τῆς",709436,16],["ἐξουσίας",704974,17],["ἐπαιρόμενος",705002,122],["ἐπιεικέστερον",705130,27],["δὲ",703303,11],["καὶ",707031,7],["μετὰ",708780,0],["ἠπιότητος",706015,17],["ἀεὶ",700311,28],["διεξάγων",703664,72],["τοὺς",709436,58],["τῶν",709436,80],["ὑποτεταγμένων",713250,445],["ἀκυμάτους",700616,60],["διὰ",703417,0],["παντὸς",710177,116],["καταστῆσαι",707011,106],["βίους",702724,57],["τήν",709436,8],["τε",712751,11],["βασιλείαν",702577,9],["ἥμερον",705986,36],["καὶ",707031,7],["πορευτὴν",710668,36],["μέχρι",708849,0],["περάτων",710281,44],["παρεξόμενος",710142,626],["ἀνανεώσασθαί",701011,109],["τε",712751,11],["τὴν",709436,8],["ποθουμένην",710581,173],["τοῖς",709436,147],["πᾶσιν",710177,230],["ἀνθρώποις",701163,148],["εἰρήνην",704098,9]],null],["13c",[["πυθομένου",711085,292],["δέ",703303,11],["μου