[["1",[["καὶ",707031,7],["μετὰ",708780,0],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["ἐκόπασεν",707819,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["τοῦ",709436,35],["θυμοῦ",706334,18],["καὶ",707031,7],["οὐκέτι",709827,28],["ἐμνήσθη",708960,37],["τῆς",709436,16],["Αστιν",702018,17],["μνημονεύων",708965,72],["οἷα",709535,68],["ἐλάλησεν",708071,2],["καὶ",707031,7],["ὡς",714148,7],["κατέκρινεν",707289,2],["αὐτήν",702165,104]],"And after this the king's anger was pacified, and he no more mentioned Astin, bearing in mind what she had said, and how he had condemned her."],["2",[["καὶ",707031,7],["εἶπαν",705373,150],["οἱ",709436,136],["διάκονοι",703478,52],["τοῦ",709436,35],["βασιλέως",702580,18],["ζητηθήτω",705879,22],["τῷ",709436,113],["βασιλεῖ",702580,114],["κοράσια",707832,42],["ἄφθορα",702209,68],["καλὰ",707097,68],["τῷ",709436,53],["εἴδει",704074,54]],"Then the servants of the king said, Let there be sought for the king chaste [and] beautiful young virgins."],["3",[["καὶ",707031,7],["καταστήσει",707011,127],["ὁ",709436,3],["βασιλεὺς",702580,4],["κωμάρχας",708021,57],["ἐν",704639,0],["πάσαις",710177,291],["ταῖς",709436,75],["χώραις",714011,76],["τῆς",709436,16],["βασιλείας",702577,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπιλεξάτωσαν",705188,264],["κοράσια",707832,42],["παρθενικὰ",710147,68],["καλὰ",707097,68],["τῷ",709436,53],["εἴδει",704074,54],["εἰς",704105,0],["Σουσαν",711969,227],["τὴν",709436,8],["πόλιν",710612,9],["εἰς",704105,0],["τὸν",709436,5],["γυναικῶνα",703207,6],["καὶ",707031,7],["παραδοθήτωσαν",710014,51],["τῷ",709436,113],["εὐνούχῳ",705651,114],["τοῦ",709436,35],["βασιλέως",702580,18],["τῷ",709436,113],["φύλακι",713616,114],["τῶν",709436,130],["γυναικῶν",703209,65],["καὶ",707031,7],["δοθήτω",703654,22],["σμῆγμα",711910,15],["καὶ",707031,7],["ἡ",709436,10],["λοιπὴ",708247,29],["ἐπιμέλεια",705198,12]],"And let the king appoint local governors in all the provinces of his kingdom, and let them select fair [and] chaste young damsels [and bring them] to the city Susa, into the women's apartment, and let them be consigned to the king's chamberlain, the keeper of the women; and let things for purification and other attendance be given [to them]."],["4",[["καὶ",707031,7],["ἡ",709436,10],["γυνή",703209,12],["ἣ",709781,177],["ἂν",700900,11],["ἀρέσῃ",701722,172],["τῷ",709436,113],["βασιλεῖ",702580,114],["βασιλεύσει",702581,127],["ἀντὶ",701227,0],["Αστιν",702018,17],["καὶ",707031,7],["ἤρεσεν",701722,2],["τῷ",709436,113],["βασιλεῖ",702580,114],["τὸ",709436,34],["πρᾶγμα",710708,15],["καὶ",707031,7],["ἐποίησεν",710582,2],["οὕτως",709859,28]],"And let the woman who shall please the king be queen instead of Astin. And the thing pleased the king; and he did so."],["5",[["καὶ",707031,7],["ἄνθρωπος",701163,4],["ἦν",704093,13],["Ιουδαῖος",706772,4],["ἐν",704639,0],["Σούσοις",711967,96],["τῇ",709436,100],["πόλει",710612,1],["καὶ",707031,7],["ὄνομα",709666,15],["αὐτῷ",702165,50],["Μαρδοχαῖος",708501,4],["ὁ",709436,3],["τοῦ",709436,35],["Ιαϊρου",706391,18],["τοῦ",709436,35],["Σεμεϊου",711668,18],["τοῦ",709436,35],["Κισαιου",707691,18],["ἐκ",704132,0],["φυλῆς",713620,17],["Βενιαμιν",702650,18]],"Now there was a Jew in the city Susa, and his name was Mardochæus, the [son] of Jairus, [the son] of Semeias, [the son] of Cisæus, of the tribe of Benjamin;"],["6",[["ὃς",709781,213],["ἦν",704093,13],["αἰχμάλωτος",700503,14],["ἐξ",704132,0],["Ιερουσαλημ",706644,17],["ἣν",709781,131],["ᾐχμαλώτευσεν",700500,2],["Ναβουχοδονοσορ",709149,4],["βασιλεὺς",702580,4],["Βαβυλῶνος",702352,18]],"who had been brought a prisoner from Jerusalem, which Nabuchodonosor king of Babylon had carried into captivity."],["7",[["καὶ",707031,7],["ἦν",704093,13],["τούτῳ",709858,50],["παῖς",709932,15],["θρεπτή",706305,12],["θυγάτηρ",706320,12],["Αμιναδαβ",700824,18],["ἀδελφοῦ",700249,18],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὄνομα",709666,15],["αὐτῇ",702165,105],["Εσθηρ",705491,12],["ἐν",704639,0],["δὲ",703303,11],["τῷ",709436,53],["μεταλλάξαι",708801,106],["αὐτῆς",702165,86],["τοὺς",709436,58],["γονεῖς",703169,57],["ἐπαίδευσεν",709926,2],["αὐτὴν",702165,104],["ἑαυτῷ",703917,50],["εἰς",704105,0],["γυναῖκα",703209,9],["καὶ",707031,7],["ἦν",704093,13],["τὸ",709436,34],["κοράσιον",707832,15],["καλὸν",707097,26],["τῷ",709436,53],["εἴδει",704074,54]],"And he had a foster-child, daughter of Aminadab his father's brother, and her name [was] Esther; and when her parents were dead, he brought her up for a wife for himself: and the damsel was beautiful."],["8",[["καὶ",707031,7],["ὅτε",709802,28],["ἠκούσθη",700587,37],["τὸ",709436,34],["τοῦ",709436,35],["βασιλέως",702580,18],["πρόσταγμα",710959,15],["συνήχθησαν",712375,99],["κοράσια",707832,64],["πολλὰ",710646,195],["εἰς",704105,0],["Σουσαν",711969,227],["τὴν",709436,8],["πόλιν",710612,9],["ὑπὸ",713184,0],["χεῖρα",713787,9],["Γαι",702900,18],["καὶ",707031,7],["ἤχθη",700209,37],["Εσθηρ",705491,12],["πρὸς",710844,0],["Γαι",702900,6],["τὸν",709436,5],["φύλακα",713616,6],["τῶν",709436,130],["γυναικῶν",703209,65]],"And because the king's ordinance was published, many damsels were gathered to the city Susa under the hand of Gai; and Esther was brought to Gai the keeper of the women."],["9",[["καὶ",707031,7],["ἤρεσεν",701722,2],["αὐτῷ",702165,50],["τὸ",709436,34],["κοράσιον",707832,15],["καὶ",707031,7],["εὗρεν",705676,2],["χάριν",713735,9],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔσπευσεν",712011,2],["αὐτῇ",702165,105],["δοῦναι",703654,106],["τὸ",709436,24],["σμῆγμα",711910,25],["καὶ",707031,7],["τὴν",709436,8],["μερίδα",708748,9],["καὶ",707031,7],["τὰ",709436,41],["ἑπτὰ",705357,59],["κοράσια",707832,42],["τὰ",709436,41],["ἀποδεδειγμένα",701438,388],["αὐτῇ",702165,105],["ἐκ",704132,0],["βασιλικοῦ",702582,92],["καὶ",707031,7],["ἐχρήσατο",713937,23],["αὐτῇ",702165,105],["καλῶς",707106,28],["καὶ",707031,7],["ταῖς",709436,75],["ἅβραις",700090,76],["αὐτῆς",702165,86],["ἐν",704639,0],["τῷ",709436,113],["γυναικῶνι",703207,114]],"And the damsel pleased him, and she found favour in his sight; and he hasted to give her the things for purification, and her portion, and the seven maidens appointed her out of the palace: and he treated her and her maidens well in the women's apartment."],["10",[["καὶ",707031,7],["οὐχ",709805,28],["ὑπέδειξεν",713192,2],["Εσθηρ",705491,12],["τὸ",709436,24],["γένος",703057,25],["αὐτῆς",702165,86],["οὐδὲ",709816,7],["τὴν",709436,8],["πατρίδα",710196,9],["ὁ",709436,3],["γὰρ",702963,11],["Μαρδοχαῖος",708501,4],["ἐνετείλατο",704791,23],["αὐτῇ",702165,105],["μὴ",708851,28],["ἀπαγγεῖλαι",701321,106]],"But Esther discovered not her family nor her kindred: for Mardochæus had charged her not to tell."],["11",[["καθ᾿",707200,0],["ἑκάστην",704133,36],["δὲ",703303,11],["ἡμέραν",705984,9],["ὁ",709436,3],["Μαρδοχαῖος",708501,4],["περιεπάτει",710362,13],["κατὰ",707200,0],["τὴν",709436,8],["αὐλὴν",702137,9],["τὴν",709436,8],["γυναικείαν",703206,36],["ἐπισκοπῶν",705254,72],["τί",712867,273],["Εσθηρ",705491,1],["συμβήσεται",712277,93]],"But Mardochæus used to walk every day by the women's court, to see what would become of Esther."],["12",[["οὗτος",709858,121],["δὲ",703303,11],["ἦν",704093,13],["καιρὸς",707047,4],["κορασίου",707832,21],["εἰσελθεῖν",704114,106],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["ὅταν",709801,28],["ἀναπληρώσῃ",701035,172],["μῆνας",708874,57],["δέκα",703333,59],["δύο",703849,59],["οὕτως",709859,28],["γὰρ",702963,11],["ἀναπληροῦνται",701035,269],["αἱ",709436,190],["ἡμέραι",705984,191],["τῆς",709436,16],["θεραπείας",706199,17],["μῆνας",708874,57],["ἓξ",704828,59],["ἀλειφόμεναι",700644,305],["ἐν",704639,0],["σμυρνίνῳ",711915,97],["ἐλαίῳ",704380,54],["καὶ",707031,7],["μῆνας",708874,57],["ἓξ",704828,59],["ἐν",704639,0],["τοῖς",709436,95],["ἀρώμασιν",701867,96],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["σμήγμασιν",711910,96],["τῶν",709436,130],["γυναικῶν",703209,65]],"Now this was the time for a virgin to go in to the king, when she should have fulfilled twelve months; for so are the days of purification fulfilled, six months while they are anointing themselves with oil of myrrh, and six months with spices and women's purifications."],["13",[["καὶ",707031,7],["τότε",712908,28],["εἰσπορεύεται",704124,117],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["καὶ",707031,7],["ὃ",709781,128],["ἐὰν",703912,7],["εἴπῃ",708124,172],["παραδώσει",710014,127],["αὐτῇ",702165,105],["συνεισέρχεσθαι",712437,110],["αὐτῇ",702165,105],["ἀπὸ",701425,0],["τοῦ",709436,35],["γυναικῶνος",703207,18],["ἕως",705792,0],["τῶν",709436,80],["βασιλείων",702578,44]],"And then [the damsel] goes in to the king; and [the officer] to whomsoever he shall give the command, will bring her to come in with him from the women's apartment to the king's chamber."],["14",[["δείλης",703318,17],["εἰσπορεύεται",704124,117],["καὶ",707031,7],["πρὸς",710844,0],["ἡμέραν",705984,9],["ἀποτρέχει",701623,91],["εἰς",704105,0],["τὸν",709436,5],["γυναικῶνα",703207,6],["τὸν",709436,5],["δεύτερον",703389,27],["οὗ",709806,28],["Γαι",702900,4],["ὁ",709436,3],["εὐνοῦχος",705651,4],["τοῦ",709436,35],["βασιλέως",702580,18],["ὁ",709436,3],["φύλαξ",713616,4],["τῶν",709436,130],["γυναικῶν",703209,65],["καὶ",707031,7],["οὐκέτι",709827,28],["εἰσπορεύεται",704124,117],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["ἐὰν",703912,7],["μὴ",708851,28],["κληθῇ",707084,384],["ὀνόματι",709666,54]],"She enters in the evening, and in the morning she departs to the second women's apartment, where Gai the king's chamberlain [is] keeper of the women: and she goes not in to the king again, unless she should be called by name."],["15",[["ἐν",704639,0],["δὲ",703303,11],["τῷ",709436,53],["ἀναπληροῦσθαι",701035,110],["τὸν",709436,5],["χρόνον",713969,6],["Εσθηρ",705491,17],["τῆς",709436,16],["θυγατρὸς",706320,17],["Αμιναδαβ",700824,18],["ἀδελφοῦ",700249,18],["πατρὸς",710189,18],["Μαρδοχαίου",708501,18],["εἰσελθεῖν",704114,106],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["οὐδὲν",709817,46],["ἠθέτησεν",700369,2],["ὧν",709781,103],["αὐτῇ",702165,105],["ἐνετείλατο",704791,23],["ὁ",709436,3],["εὐνοῦχος",705651,4],["ὁ",709436,3],["φύλαξ",713616,4],["τῶν",709436,130],["γυναικῶν",703209,65],["ἦν",704093,13],["γὰρ",702963,11],["Εσθηρ",705491,12],["εὑρίσκουσα",705676,188],["χάριν",713735,9],["παρὰ",709995,0],["πάντων",710177,169],["τῶν",709436,80],["βλεπόντων",702740,170],["αὐτήν",702165,104]],"And when the time was fulfilled for Esther the daughter of Aminadab the brother of Mardochæus' father to go in to the king, she neglected nothing which the chamberlain, the women's keeper, commanded; for Esther found grace in the sight of all that looked upon her."],["16",[["καὶ",707031,7],["εἰσῆλθεν",704114,2],["Εσθηρ",705491,12],["πρὸς",710844,0],["Ἀρταξέρξην",701824,6],["τὸν",709436,5],["βασιλέα",702580,6],["τῷ",709436,113],["δωδεκάτῳ",703890,30],["μηνί",708874,114],["ὅς",709781,213],["ἐστιν",704093,91],["Αδαρ",700229,4],["τῷ",709436,53],["ἑβδόμῳ",703925,97],["ἔτει",705543,54],["τῆς",709436,16],["βασιλείας",702577,17],["αὐτοῦ",702165,102]],"So Esther went in to king Artaxerxes in the twelfth month, which is Adar, in the seventh year of his reign."],["17",[["καὶ",707031,7],["ἠράσθη",705380,37],["ὁ",709436,3],["βασιλεὺς",702580,4],["Εσθηρ",705491,17],["καὶ",707031,7],["εὗρεν",705676,2],["χάριν",713735,9],["παρὰ",709995,0],["πάσας",710177,119],["τὰς",709436,38],["παρθένους",710148,39],["καὶ",707031,7],["ἐπέθηκεν",705304,2],["αὐτῇ",702165,105],["τὸ",709436,24],["διάδημα",703447,25],["τὸ",709436,24],["γυναικεῖον",703206,46]],"And the king loved Esther, and she found favour beyond all the [other] virgins: and he put on her the queen's crown."],["18",[["καὶ",707031,7],["ἐποίησεν",710582,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["πότον",710704,6],["πᾶσι",710177,230],["τοῖς",709436,147],["φίλοις",713492,230],["αὐτοῦ",702165,102],["καὶ",707031,7],["ταῖς",709436,75],["δυνάμεσιν",703839,76],["ἐπὶ",705080,0],["ἡμέρας",705984,39],["ἑπτὰ",705357,59],["καὶ",707031,7],["ὕψωσεν",713289,2],["τοὺς",709436,58],["γάμους",702957,57],["Εσθηρ",705491,17],["καὶ",707031,7],["ἄφεσιν",702199,9],["ἐποίησεν",710582,2],["τοῖς",709436,147],["ὑπὸ",713184,0],["τὴν",709436,8],["βασιλείαν",702577,9],["αὐτοῦ",702165,102]],"And the king made a banquet for all his friends and great men for seven days, and he highly celebrated the marriage of Esther; and he made a release to those who were under his dominion."],["19",[["ὁ",709436,3],["δὲ",703303,11],["Μαρδοχαῖος",708501,4],["ἐθεράπευεν",706200,13],["ἐν",704639,0],["τῇ",709436,100],["αὐλῇ",702137,1]],"But Mardochæus served in the palace."],["20",[["ἡ",709436,10],["δὲ",703303,11],["Εσθηρ",705491,12],["οὐχ",709805,28],["ὑπέδειξεν",713192,2],["τὴν",709436,8],["πατρίδα",710196,9],["αὐτῆς",702165,86],["οὕτως",709859,28],["γὰρ",702963,11],["ἐνετείλατο",704791,23],["αὐτῇ",702165,105],["Μαρδοχαῖος",708501,4],["φοβεῖσθαι",713532,110],["τὸν",709436,5],["θεὸν",706192,6],["καὶ",707031,7],["ποιεῖν",710582,55],["τὰ",709436,41],["προστάγματα",710959,42],["αὐτοῦ",702165,102],["καθὼς",707030,28],["ἦν",704093,13],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["Εσθηρ",705491,12],["οὐ",709805,28],["μετήλλαξεν",708801,2],["τὴν",709436,8],["ἀγωγὴν",700210,9],["αὐτῆς",702165,86]],"Now Esther had not discovered her kindred; for so Mardochæus commanded her, to fear God, and perform his commandments, as when she was with him: and Esther changed not her manner of life."],["21",[["καὶ",707031,7],["ἐλυπήθησαν",708272,99],["οἱ",709436,136],["δύο",703849,59],["εὐνοῦχοι",705651,52],["τοῦ",709436,35],["βασιλέως",702580,18],["οἱ",709436,136],["ἀρχισωματοφύλακες",701854,52],["ὅτι",709803,7],["προήχθη",710748,37],["Μαρδοχαῖος",708501,4],["καὶ",707031,7],["ἐζήτουν",705879,137],["ἀποκτεῖναι",701498,106],["Ἀρταξέρξην",701824,6],["τὸν",709436,5],["βασιλέα",702580,6]],"And two chamberlains of the king, the chiefs of the body-guard, were grieved, because Mardochæus was promoted; and they sought to kill king Artaxerxes."],["22",[["καὶ",707031,7],["ἐδηλώθη",703402,37],["Μαρδοχαίῳ",708501,114],["ὁ",709436,3],["λόγος",708236,4],["καὶ",707031,7],["ἐσήμανεν",711745,2],["Εσθηρ",705491,1],["καὶ",707031,7],["αὐτὴ",702165,107],["ἐνεφάνισεν",704628,2],["τῷ",709436,113],["βασιλεῖ",702580,114],["τὰ",709436,41],["τῆς",709436,16],["ἐπιβουλῆς",705095,17]],"And the matter was discovered to Mardochæus, and he made it known to Esther, and she declared to the king the matter of the conspiracy."],["23",[["ὁ",709436,3],["δὲ",703303,11],["βασιλεὺς",702580,4],["ἤτασεν",705526,2],["τοὺς",709436,58],["δύο",703849,59],["εὐνούχους",705651,57],["καὶ",707031,7],["ἐκρέμασεν",707892,2],["αὐτούς",702165,62],["καὶ",707031,7],["προσέταξεν",710962,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["καταχωρίσαι",707499,106],["εἰς",704105,0],["μνημόσυνον",708966,25],["ἐν",704639,0],["τῇ",709436,100],["βασιλικῇ",702582,101],["βιβλιοθήκῃ",702718,1],["ὑπὲρ",713111,0],["τῆς",709436,16],["εὐνοίας",705648,17],["Μαρδοχαίου",708501,18],["ἐν",704639,0],["ἐγκωμίῳ",704003,54]],"And the king examined the two chamberlains, and hanged them: and the king gave orders to make a note for a memorial in the royal records of the good offices of Mardochæus, as a commendation."]]