[["1",[["ἐν",704639,0],["γὰρ",702963,11],["τῷ",709436,113],["δωδεκάτῳ",703890,30],["μηνὶ",708874,114],["τρισκαιδεκάτῃ",712957,101],["τοῦ",709436,35],["μηνός",708874,18],["ὅς",709781,213],["ἐστιν",704093,91],["Αδαρ",700229,4],["παρῆν",710126,13],["τὰ",709436,63],["γράμματα",703183,64],["τὰ",709436,63],["γραφέντα",703194,352],["ὑπὸ",713184,0],["τοῦ",709436,35],["βασιλέως",702580,18]],"For in the twelfth month, on the thirteenth day of the month which is Adar, the letters written by the king arrived."],["2",[["ἐν",704639,0],["αὐτῇ",702165,105],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἀπώλοντο",701513,189],["οἱ",709436,136],["ἀντικείμενοι",701240,348],["τοῖς",709436,147],["Ιουδαίοις",706772,148],["οὐδεὶς",709817,14],["γὰρ",702963,11],["ἀντέστη",701154,2],["φοβούμενος",713532,122],["αὐτούς",702165,62]],"In that day the adversaries of the Jews perished: for no one resisted, through fear of them."],["3",[["οἱ",709436,136],["γὰρ",702963,11],["ἄρχοντες",701862,52],["τῶν",709436,80],["σατραπῶν",711555,81],["καὶ",707031,7],["οἱ",709436,136],["τύραννοι",713026,52],["καὶ",707031,7],["οἱ",709436,136],["βασιλικοὶ",702582,138],["γραμματεῖς",703185,52],["ἐτίμων",712855,137],["τοὺς",709436,58],["Ιουδαίους",706772,57],["ὁ",709436,3],["γὰρ",702963,11],["φόβος",713534,4],["Μαρδοχαίου",708501,18],["ἐνέκειτο",703972,19],["αὐτοῖς",702165,151]],"For the chiefs of the satraps, and the princes and the royal scribes, honoured the Jews; for the fear of Mardochæus lay upon them."],["4",[["προσέπεσεν",710952,2],["γὰρ",702963,11],["τὸ",709436,34],["πρόσταγμα",710959,15],["τοῦ",709436,35],["βασιλέως",702580,18],["ὀνομασθῆναι",709667,179],["ἐν",704639,0],["πάσῃ",710177,101],["τῇ",709436,100],["βασιλείᾳ",702577,1]],"For the order of the king was in force, that he should be celebrated in all the kingdom."],["6",[["καὶ",707031,7],["ἐν",704639,0],["Σούσοις",711967,96],["τῇ",709436,100],["πόλει",710612,1],["ἀπέκτειναν",701498,150],["οἱ",709436,136],["Ιουδαῖοι",706772,52],["ἄνδρας",701150,57],["πεντακοσίους",710261,60]],"And in the city Susa the Jews slew five hundred men:"],["7",[["τόν",709436,5],["τε",712751,11],["Φαρσαννεσταιν",713374,6],["καὶ",707031,7],["Δελφων",703351,6],["καὶ",707031,7],["Φασγα",713377,6]],"both Pharsannes, and Delphon and Phasga,"],["8",[["καὶ",707031,7],["Φαρδαθα",713361,6],["καὶ",707031,7],["Βαρεα",702531,6],["καὶ",707031,7],["Σαρβαχα",711523,6]],"and Pharadatha, and Barea, and Sarbaca,"],["9",[["καὶ",707031,7],["Μαρμασιμα",708517,6],["καὶ",707031,7],["Αρουφαιον",701800,6],["καὶ",707031,7],["Αρσαιον",701815,6],["καὶ",707031,7],["Ζαβουθαιθαν",705812,6]],"and Marmasima, and Ruphæus, and Arsæus, and Zabuthæus,"],["10",[["τοὺς",709436,58],["δέκα",703333,59],["υἱοὺς",713075,57],["Αμαν",700764,18],["Αμαδαθου",700748,18],["Βουγαίου",702780,18],["τοῦ",709436,35],["ἐχθροῦ",705779,116],["τῶν",709436,80],["Ιουδαίων",706772,81],["καὶ",707031,7],["διήρπασαν",703562,150]],"the ten sons of Aman the son of Amadathes the Bugæan, the enemy of the Jews, and they plundered [their property] on the same day:"],["11",[["ἐν",704639,0],["αὐτῇ",702165,105],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐπεδόθη",705121,37],["ὁ",709436,3],["ἀριθμὸς",701744,4],["τῷ",709436,113],["βασιλεῖ",702580,114],["τῶν",709436,80],["ἀπολωλότων",701513,387],["ἐν",704639,0],["Σούσοις",711967,96]],"and the number of them that perished in Susa was rendered to the king."],["12",[["εἶπεν",705373,2],["δὲ",703303,11],["ὁ",709436,3],["βασιλεὺς",702580,4],["πρὸς",710844,0],["Εσθηρ",705491,9],["ἀπώλεσαν",701513,150],["οἱ",709436,136],["Ιουδαῖοι",706772,52],["ἐν",704639,0],["Σούσοις",711967,96],["τῇ",709436,100],["πόλει",710612,1],["ἄνδρας",701150,57],["πεντακοσίους",710261,60],["ἐν",704639,0],["δὲ",703303,11],["τῇ",709436,100],["περιχώρῳ",710423,101],["πῶς",711121,28],["οἴει",709534,259],["ἐχρήσαντο",713937,189],["τί",712867,126],["οὖν",709835,11],["ἀξιοῖς",701309,154],["ἔτι",705538,28],["καὶ",707031,7],["ἔσται",704093,93],["σοι",711925,159]],"And the king said to Esther, The Jews have slain five hundred men in the city Susa; and how, thinkest thou, have they used them in the rest of the country? What then dost thou yet ask, that it may be [done] for thee?"],["13",[["καὶ",707031,7],["εἶπεν",705373,2],["Εσθηρ",705491,12],["τῷ",709436,113],["βασιλεῖ",702580,114],["δοθήτω",703654,22],["τοῖς",709436,147],["Ιουδαίοις",706772,148],["χρῆσθαι",713936,110],["ὡσαύτως",714158,28],["τὴν",709436,8],["αὔριον",702149,28],["ὥστε",714164,7],["τοὺς",709436,58],["δέκα",703333,59],["υἱοὺς",713075,57],["κρεμάσαι",707892,106],["Αμαν",700764,18]],"And Esther said to the king, Let it be granted to the Jews so to treat them to-morrow as to hang the ten sons of Aman."],["14",[["καὶ",707031,7],["ἐπέτρεψεν",705311,2],["οὕτως",709859,28],["γενέσθαι",703104,109],["καὶ",707031,7],["ἐξέθηκε",704330,2],["τοῖς",709436,147],["Ιουδαίοις",706772,148],["τῆς",709436,16],["πόλεως",710612,17],["τὰ",709436,41],["σώματα",712635,42],["τῶν",709436,80],["υἱῶν",713075,81],["Αμαν",700764,18],["κρεμάσαι",707892,106]],"And he permitted it to be so done; and he gave up to the Jews of the city the bodies of the sons of Aman to hang."],["15",[["καὶ",707031,7],["συνήχθησαν",712375,99],["οἱ",709436,136],["Ιουδαῖοι",706772,52],["ἐν",704639,0],["Σούσοις",711967,96],["τῇ",709436,100],["τεσσαρεσκαιδεκάτῃ",712809,101],["τοῦ",709436,35],["Αδαρ",700229,18],["καὶ",707031,7],["ἀπέκτειναν",701498,150],["ἄνδρας",701150,57],["τριακοσίους",712936,60],["καὶ",707031,7],["οὐδὲν",709817,46],["διήρπασαν",703562,150]],"And the Jews assembled in Susa on the fourteenth [day] of Adar, and slew three hundred men, but plundered no property."],["16",[["οἱ",709436,136],["δὲ",703303,11],["λοιποὶ",708248,138],["τῶν",709436,80],["Ιουδαίων",706772,81],["οἱ",709436,136],["ἐν",704639,0],["τῇ",709436,100],["βασιλείᾳ",702577,1],["συνήχθησαν",712375,99],["καὶ",707031,7],["ἑαυτοῖς",703917,151],["ἐβοήθουν",702746,137],["καὶ",707031,7],["ἀνεπαύσαντο",701027,189],["ἀπὸ",701425,0],["τῶν",709436,80],["πολεμίων",710603,169],["ἀπώλεσαν",701513,150],["γὰρ",702963,11],["αὐτῶν",702165,40],["μυρίους",709063,60],["πεντακισχιλίους",710260,60],["τῇ",709436,100],["τρισκαιδεκάτῃ",712957,101],["τοῦ",709436,35],["Αδαρ",700229,18],["καὶ",707031,7],["οὐδὲν",709817,46],["διήρπασαν",703562,150]],"And the rest of the Jews who were in the kingdom assembled, and helped one another, and obtained rest from their enemies: for they destroyed fifteen thousand of them on the thirteenth [day] of Adar, but took no spoil."],["17",[["καὶ",707031,7],["ἀνεπαύσαντο",701027,189],["τῇ",709436,100],["τεσσαρεσκαιδεκάτῃ",712809,101],["τοῦ",709436,35],["αὐτοῦ",702165,102],["μηνὸς",708874,18],["καὶ",707031,7],["ἦγον",700209,137],["αὐτὴν",702165,104],["ἡμέραν",705984,9],["ἀναπαύσεως",701026,17],["μετὰ",708780,0],["χαρᾶς",713719,17],["καὶ",707031,7],["εὐφροσύνης",705717,17]],"And they rested on the fourteenth of the same month, and kept it as a day of rest with joy and gladness."],["18",[["οἱ",709436,136],["δὲ",703303,11],["Ιουδαῖοι",706772,52],["οἱ",709436,136],["ἐν",704639,0],["Σούσοις",711967,96],["τῇ",709436,100],["πόλει",710612,1],["συνήχθησαν",712375,99],["καὶ",707031,28],["τῇ",709436,100],["τεσσαρεσκαιδεκάτῃ",712809,101],["καὶ",707031,7],["οὐκ",709805,28],["ἀνεπαύσαντο",701027,189],["ἦγον",700209,137],["δὲ",703303,11],["καὶ",707031,28],["τὴν",709436,8],["πεντεκαιδεκάτην",710268,36],["μετὰ",708780,0],["χαρᾶς",713719,17],["καὶ",707031,7],["εὐφροσύνης",705717,17]],"And the Jews in the city Susa assembled also on the fourteenth [day] and rested; and they kept also the fifteenth with joy and gladness."],["19",[["διὰ",703417,0],["τοῦτο",709858,129],["οὖν",709835,11],["οἱ",709436,136],["Ιουδαῖοι",706772,52],["οἱ",709436,136],["διεσπαρμένοι",703584,429],["ἐν",704639,0],["πάσῃ",710177,101],["χώρᾳ",714011,1],["τῇ",709436,100],["ἔξω",704983,28],["ἄγουσιν",700209,197],["τὴν",709436,8],["τεσσαρεσκαιδεκάτην",712809,36],["τοῦ",709436,35],["Αδαρ",700229,18],["ἡμέραν",705984,9],["ἀγαθὴν",700106,36],["μετ᾿",708780,0],["εὐφροσύνης",705717,17],["ἀποστέλλοντες",701592,146],["μερίδας",708748,39],["ἕκαστος",704133,14],["τῷ",709436,113],["πλησίον",710547,28],["οἱ",709436,136],["δὲ",703303,11],["κατοικοῦντες",707534,146],["ἐν",704639,0],["ταῖς",709436,75],["μητροπόλεσιν",708895,76],["καὶ",707031,28],["τὴν",709436,8],["πεντεκαιδεκάτην",710268,36],["τοῦ",709436,35],["Αδαρ",700229,18],["ἡμέραν",705984,9],["εὐφροσύνην",705717,9],["ἀγαθὴν",700106,36],["ἄγουσιν",700209,197],["ἐξαποστέλλοντες",704872,146],["μερίδας",708748,39],["τοῖς",709436,147],["πλησίον",710547,28]],"On this account then [it is that] the Jews dispersed in every foreign land keep the fourteenth of Adar [as] a holy day with joy, sending portions each to his neighbour."],["20",[["ἔγραψεν",703194,2],["δὲ",703303,11],["Μαρδοχαῖος",708501,4],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["εἰς",704105,0],["βιβλίον",702719,25],["καὶ",707031,7],["ἐξαπέστειλεν",704872,2],["τοῖς",709436,147],["Ιουδαίοις",706772,148],["ὅσοι",709788,138],["ἦσαν",704093,137],["ἐν",704639,0],["τῇ",709436,100],["Ἀρταξέρξου",701824,18],["βασιλείᾳ",702577,1],["τοῖς",709436,147],["ἐγγὺς",703948,28],["καὶ",707031,7],["τοῖς",709436,147],["μακράν",708411,28]],"And Mardochæus wrote these things in a book, and sent them to the Jews, as many as were in the kingdom of Artaxerxes, both them that were near and them that were afar off,"],["21",[["στῆσαι",706846,106],["τὰς",709436,38],["ἡμέρας",705984,39],["ταύτας",709858,231],["ἀγαθὰς",700106,119],["ἄγειν",700209,55],["τε",712751,11],["τὴν",709436,8],["τεσσαρεσκαιδεκάτην",712809,36],["καὶ",707031,7],["τὴν",709436,8],["πεντεκαιδεκάτην",710268,36],["τοῦ",709436,35],["Αδαρ",700229,18]],"to establish these [as] joyful days, and to keep the fourteenth and fifteenth of Adar;"],["22",[["ἐν",704639,0],["γὰρ",702963,11],["ταύταις",709858,200],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἀνεπαύσαντο",701027,189],["οἱ",709436,136],["Ιουδαῖοι",706772,52],["ἀπὸ",701425,0],["τῶν",709436,80],["ἐχθρῶν",705779,169],["αὐτῶν",702165,40],["καὶ",707031,7],["τὸν",709436,5],["μῆνα",708874,6],["ἐν",704639,0],["ᾧ",709781,309],["ἐστράφη",712160,37],["αὐτοῖς",702165,151],["ὃς",709781,213],["ἦν",704093,13],["Αδαρ",700229,4],["ἀπὸ",701425,0],["πένθους",710253,21],["εἰς",704105,0],["χαρὰν",713719,9],["καὶ",707031,7],["ἀπὸ",701425,0],["ὀδύνης",709463,17],["εἰς",704105,0],["ἀγαθὴν",700106,36],["ἡμέραν",705984,9],["ἄγειν",700209,55],["ὅλον",709597,27],["ἀγαθὰς",700106,119],["ἡμέρας",705984,39],["γάμων",702957,81],["καὶ",707031,7],["εὐφροσύνης",705717,17],["ἐξαποστέλλοντας",704872,235],["μερίδας",708748,39],["τοῖς",709436,147],["φίλοις",713492,230],["καὶ",707031,7],["τοῖς",709436,147],["πτωχοῖς",711076,148]],"for on these days the Jews obtained rest from their enemies: and [as to] the month, which was Adar, in which a change was made for them, from mourning to joy, and from sorrow to a good day, to spend the whole of it [in] good days of feasting and gladness, sending portions to their friends, and to the poor."],["23",[["καὶ",707031,7],["προσεδέξαντο",710874,189],["οἱ",709436,136],["Ιουδαῖοι",706772,52],["καθὼς",707030,28],["ἔγραψεν",703194,2],["αὐτοῖς",702165,151],["ὁ",709436,3],["Μαρδοχαῖος",708501,4]],"And the Jews consented [to this] accordingly as Mardochæus wrote to them,"],["24",[["πῶς",711121,28],["Αμαν",700764,4],["Αμαδαθου",700748,18],["ὁ",709436,3],["Μακεδὼν",708402,4],["ἐπολέμει",710601,13],["αὐτούς",702165,62],["καθὼς",707030,28],["ἔθετο",712849,23],["ψήφισμα",714050,25],["καὶ",707031,7],["κλῆρον",707727,6],["ἀφανίσαι",702182,106],["αὐτούς",702165,62]],"[shewing] how Aman the son of Amadathes the Macedonian fought against them, how he made a decree and cast lots to destroy them utterly;"],["25",[["καὶ",707031,7],["ὡς",714148,7],["εἰσῆλθεν",704114,2],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["λέγων",708124,72],["κρεμάσαι",707892,106],["τὸν",709436,5],["Μαρδοχαῖον",708501,6],["ὅσα",709788,68],["δὲ",703303,11],["ἐπεχείρησεν",705334,2],["ἐπάξαι",704994,106],["ἐπὶ",705080,0],["τοὺς",709436,58],["Ιουδαίους",706772,57],["κακά",707066,68],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["ἐγένοντο",703104,189],["καὶ",707031,7],["ἐκρεμάσθη",707892,37],["αὐτὸς",702165,121],["καὶ",707031,7],["τὰ",709436,63],["τέκνα",712761,64],["αὐτοῦ",702165,102]],"also how he went in to the king, telling [him] to hang Mardochæus: but all the calamities he tried to bring upon the Jews came upon himself, and he was hanged, and his children."],["26",[["διὰ",703417,0],["τοῦτο",709858,129],["ἐπεκλήθησαν",705153,99],["αἱ",709436,190],["ἡμέραι",705984,191],["αὗται",709858,202],["Φρουραι",713594,313],["διὰ",703417,0],["τοὺς",709436,58],["κλήρους",707727,57],["ὅτι",709803,7],["τῇ",709436,100],["διαλέκτῳ",703497,1],["αὐτῶν",702165,40],["καλοῦνται",707084,269],["Φρουραι",713594,191],["διὰ",703417,0],["τοὺς",709436,58],["λόγους",708236,57],["τῆς",709436,16],["ἐπιστολῆς",705272,17],["ταύτης",709858,86],["καὶ",707031,7],["ὅσα",709788,195],["πεπόνθασιν",710183,353],["διὰ",703417,0],["ταῦτα",709858,71],["καὶ",707031,7],["ὅσα",709788,195],["αὐτοῖς",702165,151],["ἐγένετο",703104,23]],"Therefore these days were called Phruræ, because of the lots; (for in their language they are called Phruræ;) because of the words of this letter, and [because of] all they suffered on this account, and all that happened to them."],["27",[["καὶ",707031,7],["ἔστησεν",706846,2],["καὶ",707031,7],["προσεδέχοντο",710874,139],["οἱ",709436,136],["Ιουδαῖοι",706772,52],["ἐφ᾿",705080,0],["ἑαυτοῖς",703917,151],["καὶ",707031,7],["ἐπὶ",705080,0],["τῷ",709436,53],["σπέρματι",712008,54],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπὶ",705080,0],["τοῖς",709436,147],["προστεθειμένοις",710965,521],["ἐπ᾿",705080,0],["αὐτῶν",702165,40],["οὐδὲ",709816,7],["μὴν",708873,11],["ἄλλως",700711,28],["χρήσονται",713937,135],["αἱ",709436,190],["δὲ",703303,11],["ἡμέραι",705984,191],["αὗται",709858,202],["μνημόσυνον",708966,15],["ἐπιτελούμενον",705297,208],["κατὰ",707200,0],["γενεὰν",703037,9],["καὶ",707031,7],["γενεὰν",703037,9],["καὶ",707031,7],["πόλιν",710612,9],["καὶ",707031,7],["πατριὰν",710192,9],["καὶ",707031,7],["χώραν",714011,9]],"And [Mardochæus] established it, and the Jews took upon themselves, and upon their seed, and upon those that were joined to them [to observe it], neither would they on any account behave differently: but these days [were to be] a memorial kept in every generation, and city, and family, and province."],["28",[["αἱ",709436,190],["δὲ",703303,11],["ἡμέραι",705984,191],["αὗται",709858,202],["τῶν",709436,130],["Φρουραι",713594,65],["ἀχθήσονται",700209,144],["εἰς",704105,0],["τὸν",709436,5],["ἅπαντα",701362,27],["χρόνον",713969,6],["καὶ",707031,7],["τὸ",709436,34],["μνημόσυνον",708966,15],["αὐτῶν",702165,284],["οὐ",709805,28],["μὴ",708851,28],["ἐκλίπῃ",704237,172],["ἐκ",704132,0],["τῶν",709436,130],["γενεῶν",703037,65]],"And these days of the Phruræ, [said they], shall be kept for ever, and their memorial shall not fail in any generation."],["29",[["καὶ",707031,7],["ἔγραψεν",703194,2],["Εσθηρ",705491,12],["ἡ",709436,10],["βασίλισσα",702584,12],["θυγάτηρ",706320,12],["Αμιναδαβ",700824,18],["καὶ",707031,7],["Μαρδοχαῖος",708501,4],["ὁ",709436,3],["Ιουδαῖος",706772,4],["ὅσα",709788,68],["ἐποίησαν",710582,150],["τό",709436,24],["τε",712751,11],["στερέωμα",712077,25],["τῆς",709436,16],["ἐπιστολῆς",705272,17],["τῶν",709436,130],["Φρουραι",713594,65]],"And queen Esther, the daughter of Aminadab, and Mardochæus the Jew, wrote all that they had done, and the confirmation of the letter of Phruræ."],["31",[["καὶ",707031,7],["Μαρδοχαῖος",708501,4],["καὶ",707031,7],["Εσθηρ",705491,12],["ἡ",709436,10],["βασίλισσα",702584,12],["ἔστησαν",706846,150],["ἑαυτοῖς",703917,151],["καθ᾿",707200,0],["ἑαυτῶν",703917,40],["καὶ",707031,7],["τότε",712908,28],["στήσαντες",706846,196],["κατὰ",707200,0],["τῆς",709436,16],["ὑγιείας",713058,17],["αὐτῶν",702165,40],["καὶ",707031,7],["τὴν",709436,8],["βουλὴν",702792,9],["αὐτῶν",702165,40]],"And Mardochæus and Esther the queen appointed [a fast] for themselves privately, even at that time also having formed their plan against their own health."],["32",[["καὶ",707031,7],["Εσθηρ",705491,12],["λόγῳ",708236,114],["ἔστησεν",706846,2],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["καὶ",707031,7],["ἐγράφη",703194,37],["εἰς",704105,0],["μνημόσυνον",708966,25]],"And Esther established it by a command for ever, and it was written for a memorial."]]