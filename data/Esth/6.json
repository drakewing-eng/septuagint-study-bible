[["1",[["ὁ",709436,3],["δὲ",703303,11],["κύριος",707996,4],["ἀπέστησεν",702214,2],["τὸν",709436,5],["ὕπνον",713181,6],["ἀπὸ",701425,0],["τοῦ",709436,35],["βασιλέως",702580,18],["τὴν",709436,8],["νύκτα",709386,9],["ἐκείνην",704183,104],["καὶ",707031,7],["εἶπεν",705373,2],["τῷ",709436,113],["διδασκάλῳ",703648,114],["αὐτοῦ",702165,102],["εἰσφέρειν",704127,55],["γράμματα",703183,42],["μνημόσυνα",708966,42],["τῶν",709436,130],["ἡμερῶν",705984,65],["ἀναγινώσκειν",700922,55],["αὐτῷ",702165,50]],"But the Lord removed sleep from the king that night: and he told his servant to bring in the books, the registers of daily events, to read to him."],["2",[["εὗρεν",705676,2],["δὲ",703303,11],["τὰ",709436,41],["γράμματα",703183,42],["τὰ",709436,41],["γραφέντα",703194,328],["περὶ",710285,0],["Μαρδοχαίου",708501,18],["ὡς",714148,7],["ἀπήγγειλεν",701321,2],["τῷ",709436,113],["βασιλεῖ",702580,114],["περὶ",710285,0],["τῶν",709436,80],["δύο",703849,59],["εὐνούχων",705651,81],["τοῦ",709436,35],["βασιλέως",702580,18],["ἐν",704639,0],["τῷ",709436,53],["φυλάσσειν",713619,55],["αὐτοὺς",702165,62],["καὶ",707031,7],["ζητῆσαι",705879,106],["ἐπιβαλεῖν",705083,106],["τὰς",709436,38],["χεῖρας",713787,39],["Ἀρταξέρξῃ",701824,114]],"And he found the records written concerning Mardochæus, how he had told the king concerning the two chamberlains of the king, when they were keeping guard, and sought to lay hands on Artaxerxes."],["3",[["εἶπεν",705373,2],["δὲ",703303,11],["ὁ",709436,3],["βασιλεύς",702580,4],["τίνα",712867,648],["δόξαν",703791,9],["ἢ",705924,7],["χάριν",713735,9],["ἐποιήσαμεν",710582,289],["τῷ",709436,113],["Μαρδοχαίῳ",708501,114],["καὶ",707031,7],["εἶπαν",705373,150],["οἱ",709436,136],["διάκονοι",703478,52],["τοῦ",709436,35],["βασιλέως",702580,18],["οὐκ",709805,28],["ἐποίησας",710582,162],["αὐτῷ",702165,50],["οὐδέν",709817,46]],"And the king said, What honour or favour have we done to Mardochæus? And the king's servants said, Thou hast not done anything to him."],["4",[["ἐν",704639,0],["δὲ",703303,11],["τῷ",709436,53],["πυνθάνεσθαι",711085,110],["τὸν",709436,5],["βασιλέα",702580,6],["περὶ",710285,0],["τῆς",709436,16],["εὐνοίας",705648,17],["Μαρδοχαίου",708501,18],["ἰδοὺ",706497,88],["Αμαν",700764,4],["ἐν",704639,0],["τῇ",709436,100],["αὐλῇ",702137,1],["εἶπεν",705373,2],["δὲ",703303,11],["ὁ",709436,3],["βασιλεύς",702580,4],["τίς",712867,158],["ἐν",704639,0],["τῇ",709436,100],["αὐλῇ",702137,1],["ὁ",709436,3],["δὲ",703303,11],["Αμαν",700764,4],["εἰσῆλθεν",704114,2],["εἰπεῖν",708124,106],["τῷ",709436,113],["βασιλεῖ",702580,114],["κρεμάσαι",707892,106],["τὸν",709436,5],["Μαρδοχαῖον",708501,6],["ἐπὶ",705080,0],["τῷ",709436,53],["ξύλῳ",709427,54],["ᾧ",709781,209],["ἡτοίμασεν",705539,2]],"And while the king was enquiring about the kindness of Mardochæus, behold, Aman [was] in the court. And the king said, Who [is] in the court? Now Aman was come in to speak to the king, that he should hang Mardochæus on the gallows, which he had prepared."],["5",[["καὶ",707031,7],["εἶπαν",705373,150],["οἱ",709436,136],["διάκονοι",703478,52],["τοῦ",709436,35],["βασιλέως",702580,18],["ἰδοὺ",706497,88],["Αμαν",700764,4],["ἕστηκεν",706846,171],["ἐν",704639,0],["τῇ",709436,100],["αὐλῇ",702137,1],["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεύς",702580,4],["καλέσατε",707084,74],["αὐτόν",702165,85]],"And the king's servants said, Behold, Aman stands in the court. And the king said, Call him."],["6",[["εἶπεν",705373,2],["δὲ",703303,11],["ὁ",709436,3],["βασιλεὺς",702580,4],["τῷ",709436,113],["Αμαν",700764,114],["τί",712867,126],["ποιήσω",710582,165],["τῷ",709436,113],["ἀνθρώπῳ",701163,114],["ὃν",709781,112],["ἐγὼ",704018,164],["θέλω",706176,157],["δοξάσαι",703792,106],["εἶπεν",705373,2],["δὲ",703303,11],["ἐν",704639,0],["ἑαυτῷ",703917,50],["Αμαν",700764,4],["τίνα",712867,356],["θέλει",706176,91],["ὁ",709436,3],["βασιλεὺς",702580,4],["δοξάσαι",703792,106],["εἰ",704071,7],["μὴ",708851,28],["ἐμέ",704555,163]],"And the king said to Aman, What shall I do to the man whom I wish to honour? And Aman said within himself, Whom would the king honour but myself?"],["7",[["εἶπεν",705373,2],["δὲ",703303,11],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["ἄνθρωπον",701163,6],["ὃν",709781,112],["ὁ",709436,3],["βασιλεὺς",702580,4],["θέλει",706176,91],["δοξάσαι",703792,106]],"and he said to the king, As for the man whom the king wishes to honour,"],["8",[["ἐνεγκάτωσαν",713428,264],["οἱ",709436,136],["παῖδες",709932,52],["τοῦ",709436,35],["βασιλέως",702580,18],["στολὴν",712120,9],["βυσσίνην",702833,36],["ἣν",709781,131],["ὁ",709436,3],["βασιλεὺς",702580,4],["περιβάλλεται",710294,117],["καὶ",707031,7],["ἵππον",706790,6],["ἐφ᾿",705080,0],["ὃν",709781,112],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐπιβαίνει",705082,91]],"let the king's servants bring the robe of fine linen which the king puts on, and the horse on which the king rides,"],["9",[["καὶ",707031,7],["δότω",703654,45],["ἑνὶ",704106,30],["τῶν",709436,80],["φίλων",713492,169],["τοῦ",709436,35],["βασιλέως",702580,18],["τῶν",709436,80],["ἐνδόξων",704694,169],["καὶ",707031,7],["στολισάτω",712121,45],["τὸν",709436,5],["ἄνθρωπον",701163,6],["ὃν",709781,112],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἀγαπᾷ",700120,91],["καὶ",707031,7],["ἀναβιβασάτω",700910,45],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["τὸν",709436,5],["ἵππον",706790,6],["καὶ",707031,7],["κηρυσσέτω",707662,31],["διὰ",703417,0],["τῆς",709436,16],["πλατείας",710506,17],["τῆς",709436,16],["πόλεως",710612,17],["λέγων",708124,72],["οὕτως",709859,28],["ἔσται",704093,93],["παντὶ",710177,30],["ἀνθρώπῳ",701163,114],["ὃν",709781,112],["ὁ",709436,3],["βασιλεὺς",702580,4],["δοξάζει",703792,91]],"and let him give [it] to one of the king's noble friends, and let him array the man whom the king loves; and let him mount him on the horse, and proclaim through the street of the city, saying, Thus shall it be [done] to every man whom the king honours."],["10",[["εἶπεν",705373,2],["δὲ",703303,11],["ὁ",709436,3],["βασιλεὺς",702580,4],["τῷ",709436,113],["Αμαν",700764,114],["καθὼς",707030,28],["ἐλάλησας",708071,162],["οὕτως",709859,28],["ποίησον",710582,176],["τῷ",709436,113],["Μαρδοχαίῳ",708501,114],["τῷ",709436,113],["Ιουδαίῳ",706772,114],["τῷ",709436,113],["θεραπεύοντι",706200,379],["ἐν",704639,0],["τῇ",709436,100],["αὐλῇ",702137,1],["καὶ",707031,7],["μὴ",708851,28],["παραπεσάτω",710089,45],["σου",711945,133],["λόγος",708236,4],["ὧν",709781,252],["ἐλάλησας",708071,162]],"Then the king said to Aman, Thou hast well said: so do to Mardochæus the Jew, who waits in the palace, and let not a word of what thou hast spoken be neglected."],["11",[["ἔλαβεν",708076,2],["δὲ",703303,11],["Αμαν",700764,4],["τὴν",709436,8],["στολὴν",712120,9],["καὶ",707031,7],["τὸν",709436,5],["ἵππον",706790,6],["καὶ",707031,7],["ἐστόλισεν",712121,2],["τὸν",709436,5],["Μαρδοχαῖον",708501,6],["καὶ",707031,7],["ἀνεβίβασεν",700910,2],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["τὸν",709436,5],["ἵππον",706790,6],["καὶ",707031,7],["διῆλθεν",703673,2],["διὰ",703417,0],["τῆς",709436,16],["πλατείας",710506,17],["τῆς",709436,16],["πόλεως",710612,17],["καὶ",707031,7],["ἐκήρυσσεν",707662,2],["λέγων",708124,72],["οὕτως",709859,28],["ἔσται",704093,93],["παντὶ",710177,30],["ἀνθρώπῳ",701163,114],["ὃν",709781,112],["ὁ",709436,3],["βασιλεὺς",702580,4],["θέλει",706176,91],["δοξάσαι",703792,106]],"So Aman took the robe and the horse, and arrayed Mardochæus, and mounted him on the horse, and went through the street of the city, and proclaimed, saying, Thus shall it be to every man whom the king wishes to honour."],["12",[["ἐπέστρεψεν",705278,2],["δὲ",703303,11],["ὁ",709436,3],["Μαρδοχαῖος",708501,4],["εἰς",704105,0],["τὴν",709436,8],["αὐλήν",702137,9],["Αμαν",700764,4],["δὲ",703303,11],["ὑπέστρεψεν",713246,2],["εἰς",704105,0],["τὰ",709436,41],["ἴδια",706493,68],["λυπούμενος",708272,122],["κατὰ",707200,0],["κεφαλῆς",707639,17]],"And Mardochæus returned to the palace: but Aman went home mourning, and having his head covered."],["13",[["καὶ",707031,7],["διηγήσατο",703679,23],["Αμαν",700764,4],["τὰ",709436,41],["συμβεβηκότα",712277,518],["αὐτῷ",702165,50],["Ζωσαρα",705921,1],["τῇ",709436,100],["γυναικὶ",703209,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["τοῖς",709436,147],["φίλοις",713492,230],["καὶ",707031,7],["εἶπαν",705373,150],["πρὸς",710844,0],["αὐτὸν",702165,85],["οἱ",709436,136],["φίλοι",713492,138],["καὶ",707031,7],["ἡ",709436,10],["γυνή",703209,12],["εἰ",704071,7],["ἐκ",704132,0],["γένους",703057,21],["Ιουδαίων",706772,81],["Μαρδοχαῖος",708501,4],["ἦρξαι",701860,106],["ταπεινοῦσθαι",712717,110],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["πεσὼν",710481,182],["πεσῇ",710481,123],["οὐ",709805,28],["μὴ",708851,28],["δύνῃ",703838,259],["αὐτὸν",702165,85],["ἀμύνασθαι",700880,109],["ὅτι",709803,7],["θεὸς",706192,4],["ζῶν",705851,72],["μετ᾿",708780,0],["αὐτοῦ",702165,102]],"And Aman related the events that had befallen him to Zosara his wife, and to [his] friends: and his friends and his wife said to him, If Mardochæus [be] of the race of the Jews, [and] thou hast begun to be humbled before him, thou wilt assuredly fall, and thou wilt not be able to withstand him, for the living God [is] with him."],["14",[["ἔτι",705538,28],["αὐτῶν",702165,40],["λαλούντων",708071,170],["παραγίνονται",710006,269],["οἱ",709436,136],["εὐνοῦχοι",705651,52],["ἐπισπεύδοντες",705260,146],["τὸν",709436,5],["Αμαν",700764,6],["ἐπὶ",705080,0],["τὸν",709436,5],["πότον",710704,6],["ὃν",709781,112],["ἡτοίμασεν",705539,2],["Εσθηρ",705491,12]],"While they were yet speaking, the chamberlains arrived, to hasten Aman to the banquet which Esther had prepared."]]