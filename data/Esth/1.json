36,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["ὠργίσθη",709729,37]],"But queen Astin hearkened not to him to come with the chamberlains: so the king was grieved and angered."],["13",[["καὶ",707031,7],["εἶπεν",705373,2],["τοῖς",709436,147],["φίλοις",713492,230],["αὐτοῦ",702165,102],["κατὰ",707200,0],["ταῦτα",709858,71],["ἐλάλησεν",708071,2],["Αστιν",702018,12],["ποιήσατε",710582,74],["οὖν",709835,11],["περὶ",710285,0],["τούτου",709858,49],["νόμον",709349,6],["καὶ",707031,7],["κρίσιν",707908,9]],"And he said to his friends, Thus has Astin spoken: pronounce therefore upon this [case] law and judgment."],["14",[["καὶ",707031,7],["προσῆλθεν",710890,2],["αὐτῷ",702165,50],["Αρκεσαιος",701762,4],["καὶ",707031,7],["Σαρσαθαιος",711542,4],["καὶ",707031,7],["Μαλησεαρ",708445,4],["οἱ",709436,136],["ἄρχοντες",701862,52],["Περσῶν",710429,81],["καὶ",707031,7],["Μήδων",708864,81],["οἱ",709436,136],["ἐγγὺς",703948,28],["τοῦ",709436,35],["βασιλέως",702580,18],["οἱ",709436,136],["πρῶτοι",711041,480],["παρακαθήμενοι",710036,348],["τῷ",709436,113],["βασιλεῖ",702580,114]],"So Arkesæus, and Sarsathæus, and Malisear, the princes of the Persians and Medes, who were near the king, who sat chief [in rank] by the king, drew near to him,"],["15",[["καὶ",707031,7],["ἀπήγγειλαν",701321,150],["αὐτῷ",702165,50],["κατὰ",707200,0],["τοὺς",709436,58],["νόμους",709349,57],["ὡς",714148,7],["δεῖ",703312,91],["ποιῆσαι",710582,106],["Αστιν",702018,1],["τῇ",709436,100],["βασιλίσσῃ",702584,1],["ὅτι",709803,7],["οὐκ",709805,28],["ἐποίησεν",710582,2],["τὰ",709436,41],["ὑπὸ",713184,0],["τοῦ",709436,35],["βασιλέως",702580,18],["προσταχθέντα",710962,328],["διὰ",703417,0],["τῶν",709436,80],["εὐνούχων",705651,81]],"and reported to him according to the laws how it was proper to do to queen Astin, because she had not done the things commanded of the king by the chamberlains."],["16",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["Μουχαιος",709035,4],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["καὶ",707031,7],["τοὺς",709436,58],["ἄρχοντας",701862,57],["οὐ",709805,28],["τὸν",709436,5],["βασιλέα",702580,6],["μόνον",709001,28],["ἠδίκησεν",700269,2],["Αστιν",702018,12],["ἡ",709436,10],["βασίλισσα",702584,12],["ἀλλὰ",700680,7],["καὶ",707031,28],["πάντας",710177,60],["τοὺς",709436,58],["ἄρχοντας",701862,57],["καὶ",707031,7],["τοὺς",709436,58],["ἡγουμένους",705931,236],["τοῦ",709436,35],["βασιλέως",702580,18]],"And Muchæus said to the king and to the princes, Queen Astin has not wronged the king only, but also all the king's rulers and princes:"],["17",[["καὶ",707031,7],["γὰρ",702963,11],["διηγήσατο",703679,23],["αὐτοῖς",702165,151],["τὰ",709436,41],["ῥήματα",711246,42],["τῆς",709436,16],["βασιλίσσης",702584,17],["καὶ",707031,7],["ὡς",714148,7],["ἀντεῖπεν",701223,2],["τῷ",709436,113],["βασιλεῖ",702580,114],["ὡς",714148,7],["οὖν",709835,11],["ἀντεῖπεν",701223,2],["τῷ",709436,113],["βασιλεῖ",702580,114],["Ἀρταξέρξῃ",701824,114]],"for he has told them the words of the queen, and how she disobeyed the king. As then, [said he], she refused [to obey] king Artaxerxes,"],["18",[["οὕτως",709859,28],["σήμερον",711751,28],["αἱ",709436,190],["τυραννίδες",713025,191],["αἱ",709436,190],["λοιπαὶ",708248,192],["τῶν",709436,80],["ἀρχόντων",701862,81],["Περσῶν",710429,81],["καὶ",707031,7],["Μήδων",708864,81],["ἀκούσασαι",700587,389],["τὰ",709436,41],["τῷ",709436,113],["βασιλεῖ",702580,114],["λεχθέντα",708124,328],["ὑπ᾿",713184,0],["αὐτῆς",702165,86],["τολμήσουσιν",712886,218],["ὁμοίως",709630,28],["ἀτιμάσαι",702092,106],["τοὺς",709436,58],["ἄνδρας",701150,57],["αὐτῶν",702165,284]],"so this day shall the other ladies of the chiefs of the Persians and Medes, having heard what she said to the king, dare in the same way to dishonour their husbands."],["19",[["εἰ",704071,7],["οὖν",709835,11],["δοκεῖ",703775,91],["τῷ",709436,113],["βασιλεῖ",702580,114],["προσταξάτω",710962,45],["βασιλικόν",702582,46],["καὶ",707031,7],["γραφήτω",703194,22],["κατὰ",707200,0],["τοὺς",709436,58],["νόμους",709349,57],["Μήδων",708864,81],["καὶ",707031,7],["Περσῶν",710429,81],["καὶ",707031,7],["μὴ",708851,28],["ἄλλως",700711,28],["χρησάσθω",713937,315],["μηδὲ",708855,7],["εἰσελθάτω",704114,45],["ἔτι",705538,28],["ἡ",709436,10],["βασίλισσα",702584,12],["πρὸς",710844,0],["αὐτόν",702165,85],["καὶ",707031,7],["τὴν",709436,8],["βασιλείαν",702577,9],["αὐτῆς",702165,86],["δότω",703654,45],["ὁ",709436,3],["βασιλεὺς",702580,4],["γυναικὶ",703209,1],["κρείττονι",707891,101],["αὐτῆς",702165,86]],"If then it seem good to the king, let him make a royal decree, and let it be written according to the laws of the Medes and Persians, and let him not alter [it]: and let not the queen come in to him any more; and let the king give her royalty to a woman better than she."],["20",[["καὶ",707031,7],["ἀκουσθήτω",700587,22],["ὁ",709436,3],["νόμος",709349,4],["ὁ",709436,3],["ὑπὸ",713184,0],["τοῦ",709436,35],["βασιλέως",702580,18],["ὃν",709781,112],["ἐὰν",703912,7],["ποιῇ",710582,204],["ἐν",704639,0],["τῇ",709436,100],["βασιλείᾳ",702577,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὕτως",709859,28],["πᾶσαι",710177,192],["αἱ",709436,190],["γυναῖκες",703209,191],["περιθήσουσιν",710403,218],["τιμὴν",712856,9],["τοῖς",709436,147],["ἀνδράσιν",701150,148],["ἑαυτῶν",703917,284],["ἀπὸ",701425,0],["πτωχοῦ",711076,18],["ἕως",705792,0],["πλουσίου",710560,82]],"And let the law of the king which he shall have made, be widely proclaimed, in his kingdom: and so shall all the women give honour to their husbands, from the poor even to the rich."],["21",[["καὶ",707031,7],["ἤρεσεν",701722,2],["ὁ",709436,3],["λόγος",708236,4],["τῷ",709436,113],["βασιλεῖ",702580,114],["καὶ",707031,7],["τοῖς",709436,147],["ἄρχουσι",701862,148],["καὶ",707031,7],["ἐποίησεν",710582,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["καθὰ",706979,28],["ἐλάλησεν",708071,2],["ὁ",709436,3],["Μουχαιος",709035,4]],"And the saying pleased the king and the princes; and the king did as Muchæus had said,"],["22",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["εἰς",704105,0],["πᾶσαν",710177,36],["τὴν",709436,8],["βασιλείαν",702577,9],["κατὰ",707200,0],["χώραν",714011,9],["κατὰ",707200,0],["τὴν",709436,8],["λέξιν",708144,9],["αὐτῶν",702165,40],["ὥστε",714164,7],["εἶναι",704093,55],["φόβον",713534,6],["αὐτοῖς",702165,151],["ἐν",704639,0],["ταῖς",709436,75],["οἰκίαις",709505,76],["αὐτῶν",702165,40]],"and sent into all his kingdom through the several provinces, according to their language, in order that men might be feared in their own houses."]]