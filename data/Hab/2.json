[["1",[["ἐπὶ",705080,0],["τῆς",709436,16],["φυλακῆς",713613,17],["μου",709032,133],["στήσομαι",706846,181],["καὶ",707031,7],["ἐπιβήσομαι",705082,181],["ἐπὶ",705080,0],["πέτραν",710443,9],["καὶ",707031,7],["ἀποσκοπεύσω",701576,165],["τοῦ",709436,20],["ἰδεῖν",709725,106],["τί",712867,126],["λαλήσει",708071,127],["ἐν",704639,0],["ἐμοὶ",704577,159],["καὶ",707031,7],["τί",712867,126],["ἀποκριθῶ",701492,321],["ἐπὶ",705080,0],["τὸν",709436,5],["ἔλεγχόν",704415,6],["μου",709032,133]],"I will stand upon my watch, and mount upon the rock, and watch to see what he will say by me, and what I shall answer when I am reproved."],["2",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["πρός",710844,0],["με",708618,163],["κύριος",707996,4],["καὶ",707031,7],["εἶπεν",705373,2],["γράψον",703194,176],["ὅρασιν",709721,9],["καὶ",707031,7],["σαφῶς",711589,28],["ἐπὶ",705080,0],["πυξίον",711086,25],["ὅπως",709719,7],["διώκῃ",703768,204],["ὁ",709436,3],["ἀναγινώσκων",700922,72],["αὐτά",702165,71]],"And the Lord answered me and said, Write the vision, and [that] plainly on a tablet, that he that reads it may run."],["3",[["διότι",703734,7],["ἔτι",705538,28],["ὅρασις",709721,12],["εἰς",704105,0],["καιρὸν",707047,6],["καὶ",707031,7],["ἀνατελεῖ",701066,127],["εἰς",704105,0],["πέρας",710281,15],["καὶ",707031,7],["οὐκ",709805,28],["εἰς",704105,0],["κενόν",707612,46],["ἐὰν",703912,7],["ὑστερήσῃ",713270,172],["ὑπόμεινον",713219,176],["αὐτόν",702165,85],["ὅτι",709803,7],["ἐρχόμενος",705453,122],["ἥξει",705956,127],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["χρονίσῃ",713967,172]],"For the vision [is] yet for a time, and it shall shoot forth at the end, and not in vain: though he should tarry, wait for him; for he will surely come, and will not tarry."],["4",[["ἐὰν",703912,7],["ὑποστείληται",713242,239],["οὐκ",709805,28],["εὐδοκεῖ",705565,91],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ἐν",704639,0],["αὐτῷ",702165,50],["ὁ",709436,3],["δὲ",703303,11],["δίκαιος",703694,14],["ἐκ",704132,0],["πίστεώς",710484,17],["μου",709032,133],["ζήσεται",705851,93]],"If he should draw back, my soul has no pleasure in him: but the just shall live by my faith."],["5",[["ὁ",709436,3],["δὲ",703303,11],["κατοινωμένος",707542,122],["καὶ",707031,7],["καταφρονητὴς",707484,4],["ἀνὴρ",701150,4],["ἀλαζών",700629,4],["οὐδὲν",709817,46],["μὴ",708851,28],["περάνῃ",710279,172],["ὃς",709781,213],["ἐπλάτυνεν",710508,13],["καθὼς",707030,28],["ὁ",709436,3],["ᾅδης",700255,4],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὗτος",709858,121],["ὡς",714148,7],["θάνατος",706096,4],["οὐκ",709805,28],["ἐμπιπλάμενος",704592,122],["καὶ",707031,7],["ἐπισυνάξει",705280,127],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["πάντα",710177,68],["τὰ",709436,41],["ἔθνη",704068,42],["καὶ",707031,7],["εἰσδέξεται",704111,93],["πρὸς",710844,0],["αὐτὸν",702165,85],["πάντας",710177,60],["τοὺς",709436,58],["λαούς",708094,57]],"But the arrogant man and the scorner, the boastful man, shall not finish anything; who has enlarged his desire as the grave, and like death he is never satisfied, and he will gather to himself all the nations, and will receive to himself all the peoples."],["6",[["οὐχὶ",709862,28],["ταῦτα",709858,71],["πάντα",710177,46],["παραβολὴν",710003,9],["κατ᾿",707200,0],["αὐτοῦ",702165,102],["λήμψονται",708076,135],["καὶ",707031,7],["πρόβλημα",710771,25],["εἰς",704105,0],["διήγησιν",703681,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐροῦσιν",705415,218],["οὐαὶ",709807,88],["ὁ",709436,3],["πληθύνων",710530,72],["ἑαυτῷ",703917,50],["τὰ",709436,41],["οὐκ",709805,28],["ὄντα",704093,237],["αὐτοῦ",702165,102],["ἕως",705792,0],["τίνος",712867,308],["καὶ",707031,7],["βαρύνων",702553,72],["τὸν",709436,5],["κλοιὸν",707741,6],["αὐτοῦ",702165,102],["στιβαρῶς",712100,28]],"Shall not all these take up a parable against him? and a proverb to tell against him? and they shall say, Woe to him that multiplies to himself the possessions which are not his! how long? and who heavily loads his yoke."],["7",[["ὅτι",709803,7],["ἐξαίφνης",704842,28],["ἀναστήσονται",701173,135],["δάκνοντες",703254,146],["αὐτόν",702165,85],["καὶ",707031,7],["ἐκνήψουσιν",704265,218],["οἱ",709436,136],["ἐπίβουλοί",705096,52],["σου",711945,133],["καὶ",707031,7],["ἔσῃ",704093,123],["εἰς",704105,0],["διαρπαγὴν",703561,9],["αὐτοῖς",702165,151]],"For suddenly there shall arise up those that bite him, and they that plot against thee shall awake, and thou shalt be a plunder to them."],["8",[["διότι",703734,7],["σὺ",712181,164],["ἐσκύλευσας",711900,182],["ἔθνη",704068,42],["πολλά",710646,68],["σκυλεύσουσίν",711900,218],["σε",711598,163],["πάντες",710177,138],["οἱ",709436,136],["ὑπολελειμμένοι",713212,429],["λαοὶ",708094,52],["δι᾿",703417,0],["αἵματα",700442,42],["ἀνθρώπων",701163,81],["καὶ",707031,7],["ἀσεβείας",701904,17],["γῆς",703083,17],["καὶ",707031,7],["πόλεως",710612,17],["καὶ",707031,7],["πάντων",710177,169],["τῶν",709436,80],["κατοικούντων",707534,170],["αὐτήν",702165,104]],"Because thou hast spoiled many nations, all the nations that are left shall spoil [thee], because of the blood of men, and the sins of the land and city, and of all that dwell in it."],["9",[["ὦ",714081,88],["ὁ",709436,3],["πλεονεκτῶν",710521,72],["πλεονεξίαν",710523,9],["κακὴν",707066,36],["τῷ",709436,113],["οἴκῳ",709516,114],["αὐτοῦ",702165,102],["τοῦ",709436,20],["τάξαι",712730,106],["εἰς",704105,0],["ὕψος",713288,25],["νοσσιὰν",709360,9],["αὐτοῦ",702165,102],["τοῦ",709436,20],["ἐκσπασθῆναι",704311,179],["ἐκ",704132,0],["χειρὸς",713787,17],["κακῶν",707066,83]],"Woe to him that covets an evil covetousness to his house, that he may set his nest on high, that he may be delivered from the power of evils."],["10",[["ἐβουλεύσω",702791,174],["αἰσχύνην",700483,9],["τῷ",709436,113],["οἴκῳ",709516,114],["σου",711945,133],["συνεπέρανας",712328,162],["λαοὺς",708094,57],["πολλούς",710646,60],["καὶ",707031,7],["ἐξήμαρτεν",704859,2],["ἡ",709436,10],["ψυχή",714070,12],["σου",711945,133]],"Thou hast devised shame to thy house, thou hast utterly destroyed many nations, and thy soul has sinned."],["11",[["διότι",703734,7],["λίθος",708196,4],["ἐκ",704132,0],["τοίχου",712879,18],["βοήσεται",702743,93],["καὶ",707031,7],["κάνθαρος",707125,4],["ἐκ",704132,0],["ξύλου",709427,21],["φθέγξεται",713442,93],["αὐτά",702165,71]],"For the stone shall cry out of the wall, and the beetle out of the timber shall speak."],["12",[["οὐαὶ",709807,88],["ὁ",709436,3],["οἰκοδομῶν",709509,72],["πόλιν",710612,9],["ἐν",704639,0],["αἵμασιν",700442,96],["καὶ",707031,7],["ἑτοιμάζων",705539,72],["πόλιν",710612,9],["ἐν",704639,0],["ἀδικίαις",700271,76]],"Woe to him that builds a city with blood, and establishes a city by unrighteousness."],["13",[["οὐ",709805,28],["ταῦτά",709858,290],["ἐστιν",704093,91],["παρὰ",709995,0],["κυρίου",707996,18],["παντοκράτορος",709986,18],["καὶ",707031,7],["ἐξέλιπον",704237,150],["λαοὶ",708094,52],["ἱκανοὶ",706710,138],["ἐν",704639,0],["πυρί",711088,54],["καὶ",707031,7],["ἔθνη",704068,64],["πολλὰ",710646,195],["ὠλιγοψύχησαν",709572,150]],"Are not these things of the Lord Almighty? surely many people have been exhausted in the fire, and many nations have fainted."],["14",[["ὅτι",709803,7],["πλησθήσεται",710532,134],["ἡ",709436,10],["γῆ",703083,12],["τοῦ",709436,20],["γνῶναι",703105,106],["τὴν",709436,8],["δόξαν",703791,9],["κυρίου",707996,18],["ὡς",714148,7],["ὕδωρ",713071,15],["κατακαλύψει",707260,127],["αὐτούς",702165,62]],"For the earth shall be filled with the knowledge of the glory of the Lord; it shall cover them as water."],["15",[["ὦ",714081,88],["ὁ",709436,3],["ποτίζων",710700,72],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102],["ἀνατροπῇ",701076,1],["θολερᾷ",706286,101],["καὶ",707031,7],["μεθύσκων",708676,72],["ὅπως",709719,7],["ἐπιβλέπῃ",705088,204],["ἐπὶ",705080,0],["τὰ",709436,41],["σπήλαια",712012,42],["αὐτῶν",702165,40]],"Woe to him that gives his neighbour to drink the thick lees [of wine], and intoxicates [him], that he may look upon their secret parts."],["16",[["πλησμονὴν",710549,9],["ἀτιμίας",702094,17],["ἐκ",704132,0],["δόξης",703791,17],["πίε",710478,176],["καὶ",707031,7],["σὺ",712181,164],["καὶ",707031,7],["διασαλεύθητι",703571,244],["καὶ",707031,7],["σείσθητι",711633,244],["ἐκύκλωσεν",707958,2],["ἐπὶ",705080,0],["σὲ",711598,163],["ποτήριον",710699,15],["δεξιᾶς",703360,82],["κυρίου",707996,18],["καὶ",707031,7],["συνήχθη",712375,37],["ἀτιμία",702094,12],["ἐπὶ",705080,0],["τὴν",709436,8],["δόξαν",703791,9],["σου",711945,133]],"Drink thou also [thy] fill of disgrace instead of glory: shake, O heart, and quake, the cup of the right hand of the Lord has come round upon thee, and dishonour has gathered upon thy glory."],["17",[["διότι",703734,7],["ἀσέβεια",701904,12],["τοῦ",709436,35],["Λιβάνου",708185,18],["καλύψει",707102,127],["σε",711598,163],["καὶ",707031,7],["ταλαιπωρία",712695,12],["θηρίων",706252,44],["πτοήσει",711062,127],["σε",711598,163],["διὰ",703417,0],["αἵματα",700442,42],["ἀνθρώπων",701163,81],["καὶ",707031,7],["ἀσεβείας",701904,39],["γῆς",703083,17],["καὶ",707031,7],["πόλεως",710612,17],["καὶ",707031,7],["πάντων",710177,169],["τῶν",709436,80],["κατοικούντων",707534,170],["αὐτήν",702165,104]],"For the ungodliness of Libanus shall cover thee, and distress because of wild beasts shall dismay thee, because of the blood of men, and the sins of the land and city, and of all that dwell in it."],["18",[["τί",712867,126],["ὠφελεῖ",714171,91],["γλυπτόν",703117,26],["ὅτι",709803,7],["ἔγλυψαν",703119,150],["αὐτό",702165,129],["ἔπλασαν",710503,150],["αὐτὸ",702165,129],["χώνευμα",714005,25],["φαντασίαν",713347,9],["ψευδῆ",714036,36],["ὅτι",709803,7],["πέποιθεν",710221,171],["ὁ",709436,3],["πλάσας",710503,182],["ἐπὶ",705080,0],["τὸ",709436,24],["πλάσμα",710502,25],["αὐτοῦ",702165,102],["τοῦ",709436,20],["ποιῆσαι",710582,106],["εἴδωλα",704079,42],["κωφά",708033,68]],"What profits it the graven image, that they have graven it? [one] has made it a molten work, a false image; for the maker has trusted in his work, to make dumb idols."],["19",[["οὐαὶ",709807,88],["ὁ",709436,3],["λέγων",708124,72],["τῷ",709436,53],["ξύλῳ",709427,54],["ἔκνηψον",704265,176],["ἐξεγέρθητι",704889,244],["καὶ",707031,7],["τῷ",709436,113],["λίθῳ",708196,114],["ὑψώθητι",713289,244],["καὶ",707031,7],["αὐτό",702165,132],["ἐστιν",704093,91],["φαντασία",713347,12],["τοῦτο",709858,132],["δέ",703303,11],["ἐστιν",704093,91],["ἔλασμα",704385,4],["χρυσίου",713972,21],["καὶ",707031,7],["ἀργυρίου",701707,21],["καὶ",707031,7],["πᾶν",710177,26],["πνεῦμα",710566,15],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐν",704639,0],["αὐτῷ",702165,50]],"Woe to him that says to the wood, Awake, arise; and to the stone, Be thou exalted! whereas it is an image, and this is a casting of gold and silver, and there is no breath in it."],["20",[["ὁ",709436,3],["δὲ",703303,11],["κύριος",707996,4],["ἐν",704639,0],["ναῷ",709191,114],["ἁγίῳ",700159,30],["αὐτοῦ",702165,102],["εὐλαβείσθω",705627,407],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["πᾶσα",710177,29],["ἡ",709436,10],["γῆ",703083,12]],"But the Lord is in his holy temple: let all the earth fear before him."]]