[["1",[["τὸ",709436,34],["λῆμμα",708175,15],["ὃ",709781,128],["εἶδεν",709725,2],["Αμβακουμ",700790,4],["ὁ",709436,3],["προφήτης",711009,4]],"The burden which the prophet Ambacum saw."],["2",[["ἕως",705792,0],["τίνος",712867,308],["κύριε",707996,153],["κεκράξομαι",707868,181],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["εἰσακούσῃς",704108,175],["βοήσομαι",702743,181],["πρὸς",710844,0],["σὲ",711598,163],["ἀδικούμενος",700269,466],["καὶ",707031,7],["οὐ",709805,28],["σώσεις",712627,166]],"How long, O Lord, shall I cry out, and thou wilt not hearken? [how long] shall I cry out to thee being injured, and thou wilt not save?"],["3",[["ἵνα",706747,7],["τί",712867,126],["μοι",708974,159],["ἔδειξας",703314,162],["κόπους",707825,57],["καὶ",707031,7],["πόνους",710661,57],["ἐπιβλέπειν",705088,55],["ταλαιπωρίαν",712695,9],["καὶ",707031,7],["ἀσέβειαν",701904,9],["ἐξ",704132,0],["ἐναντίας",704656,82],["μου",709032,133],["γέγονεν",703104,171],["κρίσις",707908,12],["καὶ",707031,7],["ὁ",709436,3],["κριτὴς",707910,4],["λαμβάνει",708076,91]],"Wherefore hast thou shewn me troubles and griefs to look upon, misery and ungodliness? judgment is before me, and the judge receives a reward."],["4",[["διὰ",703417,0],["τοῦτο",709858,129],["διεσκέδασται",703575,187],["νόμος",709349,4],["καὶ",707031,7],["οὐ",709805,28],["διεξάγεται",703664,117],["εἰς",704105,0],["τέλος",712787,25],["κρίμα",707903,15],["ὅτι",709803,7],["ὁ",709436,3],["ἀσεβὴς",701909,14],["καταδυναστεύει",707248,91],["τὸν",709436,5],["δίκαιον",703694,27],["ἕνεκεν",704709,0],["τούτου",709858,49],["ἐξελεύσεται",704909,93],["τὸ",709436,34],["κρίμα",707903,15],["διεστραμμένον",703592,327]],"Therefore the law is frustrated, and judgment proceeds not effectually, for the ungodly [man] prevails over the just; therefore perverse judgment will proceed."],["5",[["ἴδετε",709725,74],["οἱ",709436,643],["καταφρονηταί",707484,274],["καὶ",707031,7],["ἐπιβλέψατε",705088,74],["καὶ",707031,7],["θαυμάσατε",706135,74],["θαυμάσια",706136,68],["καὶ",707031,7],["ἀφανίσθητε",702182,372],["διότι",703734,7],["ἔργον",705396,25],["ἐγὼ",704018,164],["ἐργάζομαι",705383,254],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ὑμῶν",713091,145],["ὃ",709781,128],["οὐ",709805,28],["μὴ",708851,28],["πιστεύσητε",710483,125],["ἐάν",703912,7],["τις",712866,158],["ἐκδιηγῆται",704172,428]],"Behold, ye despisers, and look, and wonder marvellously, and vanish: for I work a work in your days, which ye will in no wise believe, though a man declare [it to you]."],["6",[["διότι",703734,7],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐξεγείρω",704889,157],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["τοὺς",709436,58],["Χαλδαίους",713678,57],["τοὺς",709436,58],["μαχητάς",708602,57],["τὸ",709436,24],["ἔθνος",704068,25],["τὸ",709436,24],["πικρὸν",710475,27],["καὶ",707031,7],["τὸ",709436,24],["ταχινὸν",712744,46],["τὸ",709436,24],["πορευόμενον",710667,214],["ἐπὶ",705080,0],["τὰ",709436,41],["πλάτη",710507,42],["τῆς",709436,16],["γῆς",703083,17],["τοῦ",709436,20],["κατακληρονομῆσαι",707274,106],["σκηνώματα",711849,42],["οὐκ",709805,28],["αὐτοῦ",702165,49]],"Wherefore, behold, I stir up the Chaldeans, the bitter and hasty nation, that walks upon the breadth of the earth, to inherit tabernacles not his own."],["7",[["φοβερὸς",713530,14],["καὶ",707031,7],["ἐπιφανής",705319,14],["ἐστιν",704093,91],["ἐξ",704132,0],["αὐτοῦ",702165,102],["τὸ",709436,34],["κρίμα",707903,15],["αὐτοῦ",702165,102],["ἔσται",704093,93],["καὶ",707031,7],["τὸ",709436,34],["λῆμμα",708175,15],["αὐτοῦ",702165,102],["ἐξ",704132,0],["αὐτοῦ",702165,102],["ἐξελεύσεται",704909,93]],"He is terrible and famous; his judgment shall proceed of himself, and his dignity shall come out of himself."],["8",[["καὶ",707031,7],["ἐξαλοῦνται",704856,135],["ὑπὲρ",713111,0],["παρδάλεις",710122,39],["οἱ",709436,136],["ἵπποι",706790,52],["αὐτοῦ",702165,49],["καὶ",707031,7],["ὀξύτεροι",709682,267],["ὑπὲρ",713111,0],["τοὺς",709436,58],["λύκους",708269,57],["τῆς",709436,16],["Ἀραβίας",701673,17],["καὶ",707031,7],["ἐξιππάσονται",704935,135],["οἱ",709436,136],["ἱππεῖς",706786,52],["αὐτοῦ",702165,49],["καὶ",707031,7],["ὁρμήσουσιν",709755,218],["μακρόθεν",708417,28],["καὶ",707031,7],["πετασθήσονται",710441,144],["ὡς",714148,7],["ἀετὸς",700318,4],["πρόθυμος",710799,14],["εἰς",704105,0],["τὸ",709436,24],["φαγεῖν",713296,106]],"And his horses shall bound [more swiftly] than leopards, and [they are] fiercer than the wolves of Arabia: and his horsemen shall ride forth, and shall rush from far; and they shall fly as an eagle hasting to eat."],["9",[["συντέλεια",712509,12],["εἰς",704105,0],["ἀσεβεῖς",701909,138],["ἥξει",705956,127],["ἀνθεστηκότας",701154,277],["προσώποις",710986,96],["αὐτῶν",702165,40],["ἐξ",704132,0],["ἐναντίας",704656,82],["καὶ",707031,7],["συνάξει",712375,127],["ὡς",714148,7],["ἄμμον",700845,9],["αἰχμαλωσίαν",700499,9]],"Destruction shall come upon ungodly men, resisting with their adverse front, and he shall gather the captivity as the sand."],["10",[["καὶ",707031,7],["αὐτὸς",702165,121],["ἐν",704639,0],["βασιλεῦσιν",702580,148],["ἐντρυφήσει",704810,127],["καὶ",707031,7],["τύραννοι",713026,52],["παίγνια",709922,64],["αὐτοῦ",702165,102],["καὶ",707031,7],["αὐτὸς",702165,121],["εἰς",704105,0],["πᾶν",710177,46],["ὀχύρωμα",709891,25],["ἐμπαίξεται",704583,93],["καὶ",707031,7],["βαλεῖ",702487,127],["χῶμα",714000,25],["καὶ",707031,7],["κρατήσει",707879,127],["αὐτοῦ",702165,49]],"And he shall be at his ease with kings, and princes are his toys, and he shall mock at every strong-hold, and shall cast a mound, and take possession of it."],["11",[["τότε",712908,28],["μεταβαλεῖ",708782,127],["τὸ",709436,24],["πνεῦμα",710566,25],["καὶ",707031,7],["διελεύσεται",703673,93],["καὶ",707031,7],["ἐξιλάσεται",704932,93],["αὕτη",709858,107],["ἡ",709436,10],["ἰσχὺς",706858,12],["τῷ",709436,113],["θεῷ",706192,114],["μου",709032,133]],"Then shall he change his spirit, and he shall pass through, and make an atonement, [saying], This strength [belongs] to my god."],["12",[["οὐχὶ",709862,28],["σὺ",712181,164],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["κύριε",707996,153],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["ἅγιός",700159,14],["μου",709032,133],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἀποθάνωμεν",701461,79],["κύριε",707996,153],["εἰς",704105,0],["κρίμα",707903,25],["τέταχας",712730,266],["αὐτόν",702165,85],["καὶ",707031,7],["ἔπλασέν",710503,2],["με",708618,163],["τοῦ",709436,20],["ἐλέγχειν",704416,55],["παιδείαν",709924,9],["αὐτοῦ",702165,102]],"[Art] not thou from the beginning, O Lord God, my Holy One? and surely we shall not die. O Lord, thou hast established it for judgment, and he has formed me to chasten [with] his correction."],["13",[["καθαρὸς",706988,14],["ὀφθαλμὸς",709870,4],["τοῦ",709436,35],["μὴ",708851,28],["ὁρᾶν",709725,55],["πονηρά",710660,68],["καὶ",707031,7],["ἐπιβλέπειν",705088,55],["ἐπὶ",705080,0],["πόνους",710661,57],["οὐ",709805,28],["δυνήσῃ",703838,123],["ἵνα",706747,7],["τί",712867,126],["ἐπιβλέπεις",705088,154],["ἐπὶ",705080,0],["καταφρονοῦντας",707482,235],["παρασιωπήσῃ",710102,123],["ἐν",704639,0],["τῷ",709436,53],["καταπίνειν",707374,55],["ἀσεβῆ",701909,27],["τὸν",709436,5],["δίκαιον",703694,27]],"[His] eye is too pure to behold evil [doings], and to look upon grievous afflictions: wherefore dost thou look upon despisers? wilt thou be silent when the ungodly swallows up the just?"],["14",[["καὶ",707031,7],["ποιήσεις",710582,166],["τοὺς",709436,58],["ἀνθρώπους",701163,57],["ὡς",714148,7],["τοὺς",709436,58],["ἰχθύας",706870,57],["τῆς",709436,16],["θαλάσσης",706069,17],["καὶ",707031,7],["ὡς",714148,7],["τὰ",709436,41],["ἑρπετὰ",705441,42],["τὰ",709436,41],["οὐκ",709805,28],["ἔχοντα",705785,237],["ἡγούμενον",705931,212]],"And wilt thou make men as the fishes of the sea, and as the reptiles which have no guide?"],["15",[["συντέλειαν",712509,9],["ἐν",704639,0],["ἀγκίστρῳ",700164,54],["ἀνέσπασεν",701052,2],["καὶ",707031,7],["εἵλκυσεν",704508,2],["αὐτὸν",702165,85],["ἐν",704639,0],["ἀμφιβλήστρῳ",700884,54],["καὶ",707031,7],["συνήγαγεν",712375,2],["αὐτὸν",702165,85],["ἐν",704639,0],["ταῖς",709436,75],["σαγήναις",711364,76],["αὐτοῦ",702165,102],["ἕνεκεν",704709,0],["τούτου",709858,49],["εὐφρανθήσεται",705715,134],["καὶ",707031,7],["χαρήσεται",713665,134],["ἡ",709436,10],["καρδία",707141,12],["αὐτοῦ",702165,102]],"He has brought up destruction with a hook, and drawn one with a casting net, and caught another in his drags: therefore shall his heart rejoice and be glad."],["16",[["ἕνεκεν",704709,0],["τούτου",709858,102],["θύσει",706349,127],["τῇ",709436,100],["σαγήνῃ",711365,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["θυμιάσει",706332,127],["τῷ",709436,53],["ἀμφιβλήστρῳ",700884,54],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ἐν",704639,0],["αὐτοῖς",702165,151],["ἐλίπανεν",708215,2],["μερίδα",708748,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["βρώματα",702823,42],["αὐτοῦ",702165,102],["ἐκλεκτά",704240,68]],"Therefore will he sacrifice to his drag, and burn incense to his casting-net, because by them he has made his portion fat, and his meats choice."],["17",[["διὰ",703417,0],["τοῦτο",709858,129],["ἀμφιβαλεῖ",700883,127],["τὸ",709436,24],["ἀμφίβληστρον",700884,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["διὰ",703417,0],["παντὸς",710177,92],["ἀποκτέννειν",701498,55],["ἔθνη",704068,42],["οὐ",709805,28],["φείσεται",713406,93]],"Therefore will he cast his net, and will not spare to slay the nations continually."]]