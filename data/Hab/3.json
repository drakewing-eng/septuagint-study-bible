[["1",[["προσευχὴ",710892,12],["Αμβακουμ",700790,18],["τοῦ",709436,35],["προφήτου",711009,18],["μετὰ",708780,0],["ᾠδῆς",714091,17]],"A Prayer of the Prophet Ambacum, with a Song."],["2",[["κύριε",707996,153],["εἰσακήκοα",704108,89],["τὴν",709436,8],["ἀκοήν",700561,9],["σου",711945,133],["καὶ",707031,7],["ἐφοβήθην",713532,156],["κατενόησα",707341,155],["τὰ",709436,41],["ἔργα",705396,42],["σου",711945,133],["καὶ",707031,7],["ἐξέστην",704940,155],["ἐν",704639,0],["μέσῳ",708768,97],["δύο",703849,59],["ζῴων",705916,44],["γνωσθήσῃ",703105,364],["ἐν",704639,0],["τῷ",709436,53],["ἐγγίζειν",703939,55],["τὰ",709436,41],["ἔτη",705543,42],["ἐπιγνωσθήσῃ",705104,364],["ἐν",704639,0],["τῷ",709436,53],["παρεῖναι",710126,55],["τὸν",709436,5],["καιρὸν",707047,6],["ἀναδειχθήσῃ",700935,364],["ἐν",704639,0],["τῷ",709436,53],["ταραχθῆναι",712721,179],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἐν",704639,0],["ὀργῇ",709728,1],["ἐλέους",704426,42],["μνησθήσῃ",708923,364]],"O Lord, I have heard thy report, and was afraid: I considered thy works, and was amazed: thou shalt be known between the two living creatures, thou shalt be acknowledged when the years draw nigh; thou shalt be manifested when the time is come; when my soul is troubled, thou wilt in wrath remember mercy."],["3",[["ὁ",709436,3],["θεὸς",706192,4],["ἐκ",704132,0],["Θαιμαν",706062,118],["ἥξει",705956,127],["καὶ",707031,7],["ὁ",709436,3],["ἅγιος",700159,14],["ἐξ",704132,0],["ὄρους",709768,21],["κατασκίου",707425,92],["δασέος",703299,116],["διάψαλμα",703641,15],["ἐκάλυψεν",707102,2],["οὐρανοὺς",709844,57],["ἡ",709436,10],["ἀρετὴ",701727,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["αἰνέσεως",700457,17],["αὐτοῦ",702165,102],["πλήρης",710541,29],["ἡ",709436,10],["γῆ",703083,12]],"God shall come from Thæman, and the Holy One from the dark shady mount Pharan. Pause."],["4",[["καὶ",707031,7],["φέγγος",713404,15],["αὐτοῦ",702165,102],["ὡς",714148,7],["φῶς",713642,15],["ἔσται",704093,93],["κέρατα",707625,64],["ἐν",704639,0],["χερσὶν",713787,76],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔθετο",712849,23],["ἀγάπησιν",700123,9],["κραταιὰν",707873,36],["ἰσχύος",706858,17],["αὐτοῦ",702165,102]],"His excellence covered the heavens, and the earth was full of his praise. And his brightness shall be as light; [there were] horns in his hands, and he caused a mighty love of his strength."],["5",[["πρὸ",710747,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["πορεύσεται",710667,93],["λόγος",708236,4],["καὶ",707031,7],["ἐξελεύσεται",704909,93],["ἐν",704639,0],["πεδίλοις",710213,96],["οἱ",709436,136],["πόδες",710707,52],["αὐτοῦ",702165,102]],"Before his face shall go a report, and it shall go forth into the plains,"],["6",[["ἔστη",706846,2],["καὶ",707031,7],["ἐσαλεύθη",711403,37],["ἡ",709436,10],["γῆ",703083,12],["ἐπέβλεψεν",705088,2],["καὶ",707031,7],["διετάκη",703606,37],["ἔθνη",704068,42],["διεθρύβη",703457,37],["τὰ",709436,63],["ὄρη",709768,64],["βίᾳ",702712,1],["ἐτάκησαν",712839,99],["βουνοὶ",702797,52],["αἰώνιοι",700505,138]],"the earth stood at his feet and trembled: he beheld, and the nations melted away: the mountains were violently burst through, the everlasting hills melted at his everlasting going forth."],["7",[["πορείας",710665,39],["αἰωνίας",700505,119],["αὐτοῦ",702165,102],["ἀντὶ",701227,0],["κόπων",707825,81],["εἶδον",709725,155],["σκηνώματα",711849,64],["Αἰθιόπων",700420,81],["πτοηθήσονται",711062,144],["καὶ",707031,7],["αἱ",709436,190],["σκηναὶ",711845,191],["γῆς",703083,17],["Μαδιαμ",708355,118]],"Because of troubles I looked upon the tents of the Ethiopians: the tabernacles also of the land of Madiam shall be dismayed."],["8",[["μὴ",708851,28],["ἐν",704639,0],["ποταμοῖς",710693,148],["ὠργίσθης",709729,168],["κύριε",707996,153],["ἢ",705924,7],["ἐν",704639,0],["ποταμοῖς",710693,148],["ὁ",709436,3],["θυμός",706334,4],["σου",711945,133],["ἢ",705924,7],["ἐν",704639,0],["θαλάσσῃ",706069,1],["τὸ",709436,34],["ὅρμημά",709757,15],["σου",711945,133],["ὅτι",709803,7],["ἐπιβήσῃ",705082,123],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἵππους",706790,57],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["ἱππασία",706785,12],["σου",711945,133],["σωτηρία",712658,12]],"Wast thou angry, O Lord, with the rivers? or [was] thy wrath against the rivers, or thine anger against the sea? for thou wilt mount on thine horses, and thy chariots are salvation."],["9",[["ἐντείνων",704790,72],["ἐντενεῖς",704790,166],["τὸ",709436,24],["τόξον",712898,25],["σου",711945,133],["ἐπὶ",705080,0],["τὰ",709436,41],["σκῆπτρα",711851,42],["λέγει",708124,91],["κύριος",707996,4],["διάψαλμα",703641,15],["ποταμῶν",710693,81],["ῥαγήσεται",711243,134],["γῆ",703083,12]],"Surely thou didst bend thy bow at sceptres, saith the Lord. Pause. The land of rivers shall be torn asunder."],["10",[["ὄψονταί",709725,135],["σε",711598,163],["καὶ",707031,7],["ὠδινήσουσιν",714095,218],["λαοί",708094,52],["σκορπίζων",711881,72],["ὕδατα",713071,42],["πορείας",710665,17],["αὐτοῦ",702165,102],["ἔδωκεν",703654,2],["ἡ",709436,10],["ἄβυσσος",700098,12],["φωνὴν",713640,9],["αὐτῆς",702165,86],["ὕψος",713288,25],["φαντασίας",713347,17],["αὐτῆς",702165,86]],"The nations shall see thee and be in pain, [as thou dost] divide the moving waters: the deep uttered her voice, and raised her form on high."],["11",[["ἐπήρθη",705002,37],["ὁ",709436,3],["ἥλιος",705974,4],["καὶ",707031,7],["ἡ",709436,10],["σελήνη",711650,12],["ἔστη",706846,2],["ἐν",704639,0],["τῇ",709436,100],["τάξει",712712,1],["αὐτῆς",702165,86],["εἰς",704105,0],["φῶς",713642,25],["βολίδες",702756,191],["σου",711945,133],["πορεύσονται",710667,135],["εἰς",704105,0],["φέγγος",713404,25],["ἀστραπῆς",702021,17],["ὅπλων",709704,44],["σου",711945,133]],"The sun was exalted, and the moon stood still in her course: thy darts shall go forth at the light, at the brightness of the gleaming of thine arms."],["12",[["ἐν",704639,0],["ἀπειλῇ",701375,1],["ὀλιγώσεις",709576,166],["γῆν",703083,9],["καὶ",707031,7],["ἐν",704639,0],["θυμῷ",706334,114],["κατάξεις",707232,166],["ἔθνη",704068,42]],"Thou wilt bring low the land with threatening, and in wrath thou wilt break down the nations."],["13",[["ἐξῆλθες",704909,162],["εἰς",704105,0],["σωτηρίαν",712658,9],["λαοῦ",708094,18],["σου",711945,133],["τοῦ",709436,20],["σῶσαι",712627,106],["τοὺς",709436,58],["χριστούς",713964,60],["σου",711945,133],["ἔβαλες",702487,162],["εἰς",704105,0],["κεφαλὰς",707639,39],["ἀνόμων",701194,169],["θάνατον",706096,6],["ἐξήγειρας",704889,162],["δεσμοὺς",703372,57],["ἕως",705792,0],["τραχήλου",712924,18],["διάψαλμα",703641,15]],"Thou wentest forth for the salvation of thy people, to save thine anointed: thou shalt bring death on the heads of transgressors; thou hast brought bands upon [their] neck. Pause."],["14",[["διέκοψας",703481,162],["ἐν",704639,0],["ἐκστάσει",704314,1],["κεφαλὰς",707639,39],["δυναστῶν",703844,81],["σεισθήσονται",711633,144],["ἐν",704639,0],["αὐτῇ",702165,105],["διανοίξουσιν",703532,218],["χαλινοὺς",713685,57],["αὐτῶν",702165,40],["ὡς",714148,7],["ἔσθων",705495,72],["πτωχὸς",711076,4],["λάθρᾳ",708057,28]],"Thou didst cut asunder the heads of princes with amazement, they shall tremble in it; they shall burst their bridles, [they shall be] as a poor man devouring in secret."],["15",[["καὶ",707031,7],["ἐπεβίβασας",705086,162],["εἰς",704105,0],["θάλασσαν",706069,9],["τοὺς",709436,58],["ἵππους",706790,57],["σου",711945,133],["ταράσσοντας",712721,235],["ὕδωρ",713071,25],["πολύ",710646,46]],"And thou dost cause thine horses to enter the sea, disturbing much water."],["16",[["ἐφυλαξάμην",713619,161],["καὶ",707031,7],["ἐπτοήθη",711062,37],["ἡ",709436,10],["κοιλία",707761,12],["μου",709032,133],["ἀπὸ",701425,0],["φωνῆς",713640,17],["προσευχῆς",710892,17],["χειλέων",713781,44],["μου",709032,133],["καὶ",707031,7],["εἰσῆλθεν",704114,2],["τρόμος",712975,4],["εἰς",704105,0],["τὰ",709436,41],["ὀστᾶ",709792,42],["μου",709032,133],["καὶ",707031,7],["ὑποκάτωθέν",713205,0],["μου",709032,133],["ἐταράχθη",712721,37],["ἡ",709436,10],["ἕξις",704937,12],["μου",709032,133],["ἀναπαύσομαι",701027,181],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["θλίψεως",706276,17],["τοῦ",709436,20],["ἀναβῆναι",700905,106],["εἰς",704105,0],["λαὸν",708094,6],["παροικίας",710158,17],["μου",709032,133]],"I watched, and my belly trembled at the sound of the prayer of my lips, and trembling entered into my bones, and my frame was troubled within me; I will rest in the day of affliction, from going up to the people of my sojourning."],["17",[["διότι",703734,7],["συκῆ",712254,12],["οὐ",709805,28],["καρποφορήσει",707170,127],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["γενήματα",703052,64],["ἐν",704639,0],["ταῖς",709436,75],["ἀμπέλοις",700870,76],["ψεύσεται",714045,93],["ἔργον",705396,15],["ἐλαίας",704376,17],["καὶ",707031,7],["τὰ",709436,63],["πεδία",710215,64],["οὐ",709805,28],["ποιήσει",710582,127],["βρῶσιν",702825,9],["ἐξέλιπον",704237,150],["ἀπὸ",701425,0],["βρώσεως",702825,17],["πρόβατα",710768,64],["καὶ",707031,7],["οὐχ",709805,28],["ὑπάρχουσιν",713104,197],["βόες",702798,52],["ἐπὶ",705080,0],["φάτναις",713391,76]],"For [though] the fig-tree shall bear no fruit, and there shall be no produce on the vines; the labour of the olive shall fail, and the fields shall produce no food: the sheep have failed from the pasture, and there are no oxen at the cribs;"],["18",[["ἐγὼ",704018,164],["δὲ",703303,11],["ἐν",704639,0],["τῷ",709436,113],["κυρίῳ",707996,114],["ἀγαλλιάσομαι",700114,181],["χαρήσομαι",713665,180],["ἐπὶ",705080,0],["τῷ",709436,113],["θεῷ",706192,114],["τῷ",709436,113],["σωτῆρί",712657,114],["μου",709032,133]],"yet I will exult in the Lord, I will joy in God my Saviour."],["19",[["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["δύναμίς",703839,12],["μου",709032,133],["καὶ",707031,7],["τάξει",712730,127],["τοὺς",709436,58],["πόδας",710707,57],["μου",709032,133],["εἰς",704105,0],["συντέλειαν",712509,9],["ἐπὶ",705080,0],["τὰ",709436,41],["ὑψηλὰ",713285,68],["ἐπιβιβᾷ",705086,127],["με",708618,163],["τοῦ",709436,20],["νικῆσαι",709309,106],["ἐν",704639,0],["τῇ",709436,100],["ᾠδῇ",714091,1],["αὐτοῦ",702165,102]],"The Lord God is my strength, and he will perfectly strengthen my feet; he mounts me upon high places, that I may conquer by his song."]]