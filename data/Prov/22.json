[["1",[["αἱρετώτερον",700471,385],["ὄνομα",709666,15],["καλὸν",707097,26],["ἢ",705924,7],["πλοῦτος",710563,4],["πολύς",710646,14],["ὑπὲρ",713111,0],["δὲ",703303,11],["ἀργύριον",701707,25],["καὶ",707031,7],["χρυσίον",713972,25],["χάρις",713735,12],["ἀγαθή",700106,29]],"A fair name is better than much wealth, and good favour is above silver and gold."],["2",[["πλούσιος",710560,14],["καὶ",707031,7],["πτωχὸς",711076,4],["συνήντησαν",712394,150],["ἀλλήλοις",700689,151],["ἀμφοτέρους",700892,60],["δὲ",703303,11],["ὁ",709436,3],["κύριος",707996,4],["ἐποίησεν",710582,2]],"The rich and the poor meet together; but the Lord made them both."],["3",[["πανοῦργος",709972,14],["ἰδὼν",709725,182],["πονηρὸν",710660,27],["τιμωρούμενον",712861,212],["κραταιῶς",707877,28],["αὐτὸς",702165,121],["παιδεύεται",709926,391],["οἱ",709436,136],["δὲ",703303,11],["ἄφρονες",702236,138],["παρελθόντες",710141,196],["ἐζημιώθησαν",705878,99]],"An intelligent man seeing a bad man severely punished is himself instructed, but fools pass by and are punished."],["4",[["γενεὰ",703037,12],["σοφίας",711981,17],["φόβος",713534,4],["κυρίου",707996,18],["καὶ",707031,7],["πλοῦτος",710563,4],["καὶ",707031,7],["δόξα",703791,12],["καὶ",707031,7],["ζωή",705910,12]],"The fear of the Lord is the offspring of wisdom, and wealth, and glory, and life."],["5",[["τρίβολοι",712938,52],["καὶ",707031,7],["παγίδες",709910,191],["ἐν",704639,0],["ὁδοῖς",709458,76],["σκολιαῖς",711868,291],["ὁ",709436,3],["δὲ",703303,11],["φυλάσσων",713619,72],["τὴν",709436,8],["ἑαυτοῦ",703917,102],["ψυχὴν",714070,9],["ἀφέξεται",701405,93],["αὐτῶν",702165,40]],"Thistles and snares are in perverse ways; but he that keeps his soul will refrain from them."],["7",[["πλούσιοι",710560,138],["πτωχῶν",711076,81],["ἄρξουσιν",701860,218],["καὶ",707031,7],["οἰκέται",709496,52],["ἰδίοις",706493,230],["δεσπόταις",703379,148],["δανιοῦσιν",703277,218]],"The rich will rule over the poor, and servants will lend to their own masters."],["8",[["ὁ",709436,3],["σπείρων",712006,72],["φαῦλα",713398,68],["θερίσει",706206,127],["κακά",707066,68],["πληγὴν",710527,9],["δὲ",703303,11],["ἔργων",705396,44],["αὐτοῦ",702165,102],["συντελέσει",712510,127]],"He that sows wickedness shall reap troubles; and shall fully receive the punishment of his deeds."],["8a",[["ἄνδρα",701150,6],["ἱλαρὸν",706723,27],["καὶ",707031,7],["δότην",703810,6],["εὐλογεῖ",705631,91],["ὁ",709436,3],["θεός",706192,4],["ματαιότητα",708576,9],["δὲ",703303,11],["ἔργων",705396,44],["αὐτοῦ",702165,102],["συντελέσει",712510,127]],null],["9",[["ὁ",709436,3],["ἐλεῶν",704418,72],["πτωχὸν",711076,6],["αὐτὸς",702165,121],["διατραφήσεται",703613,134],["τῶν",709436,80],["γὰρ",702963,11],["ἑαυτοῦ",703917,102],["ἄρτων",701829,81],["ἔδωκεν",703654,2],["τῷ",709436,113],["πτωχῷ",711076,114]],"He that has pity on the poor shall himself be maintained; for he has given of his own bread to the poor."],["9a",[["νίκην",709310,9],["καὶ",707031,7],["τιμὴν",712856,9],["περιποιεῖται",710367,117],["ὁ",709436,3],["δῶρα",703907,42],["δούς",703654,182],["τὴν",709436,8],["μέντοι",708734,11],["ψυχὴν",714070,9],["ἀφαιρεῖται",702177,117],["τῶν",709436,80],["κεκτημένων",707932,445]],null],["10",[["ἔκβαλε",704145,176],["ἐκ",704132,0],["συνεδρίου",712429,21],["λοιμόν",708245,27],["καὶ",707031,7],["συνεξελεύσεται",712447,93],["αὐτῷ",702165,50],["νεῖκος",709246,15],["ὅταν",709801,28],["γὰρ",702963,11],["καθίσῃ",707006,123],["ἐν",704639,0],["συνεδρίῳ",712429,54],["πάντας",710177,60],["ἀτιμάζει",702092,91]],"Cast out a pestilent person from the council, and strife shall go out with him; for when he sits in the council he dishonours all."],["11",[["ἀγαπᾷ",700120,91],["κύριος",707996,4],["ὁσίας",709782,119],["καρδίας",707141,39],["δεκτοὶ",703348,138],["δὲ",703303,11],["αὐτῷ",702165,50],["πάντες",710177,138],["ἄμωμοι",700895,138],["χείλεσιν",713781,96],["ποιμαίνει",710594,91],["βασιλεύς",702580,4]],"The Lord loves holy hearts, and all blameless persons are acceptable with him: a king rules with his lips."],["12",[["οἱ",709436,136],["δὲ",703303,11],["ὀφθαλμοὶ",709870,52],["κυρίου",707996,18],["διατηροῦσιν",703607,197],["αἴσθησιν",700477,9],["φαυλίζει",713394,91],["δὲ",703303,11],["λόγους",708236,57],["παράνομος",710080,14]],"But the eyes of the Lord preserve discretion; but the transgressor despises [wise] words."],["13",[["προφασίζεται",711003,117],["καὶ",707031,7],["λέγει",708124,91],["ὀκνηρός",709550,14],["λέων",708171,4],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["ἐν",704639,0],["δὲ",703303,11],["ταῖς",709436,75],["πλατείαις",710509,291],["φονευταί",713545,52]],"The sluggard makes excuses, and says, [There is] a lion in the ways, and murderers in the streets."],["14",[["βόθρος",702749,4],["βαθὺς",702381,14],["στόμα",712125,15],["παρανόμου",710080,116],["ὁ",709436,3],["δὲ",703303,11],["μισηθεὶς",708935,217],["ὑπὸ",713184,0],["κυρίου",707996,18],["ἐμπεσεῖται",704593,93],["εἰς",704105,0],["αὐτόν",702165,85]],"The mouth of a transgressor is a deep pit; and he that is hated of the Lord shall fall into it."],["14a",[["εἰσὶν",704093,197],["ὁδοὶ",709458,191],["κακαὶ",707066,192],["ἐνώπιον",704823,28],["ἀνδρός",701150,18],["καὶ",707031,7],["οὐκ",709805,28],["ἀγαπᾷ",700120,91],["τοῦ",709436,20],["ἀποστρέψαι",701598,106],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["ἀποστρέφειν",701598,55],["δὲ",703303,11],["δεῖ",703312,91],["ἀπὸ",701425,0],["ὁδοῦ",709458,17],["σκολιᾶς",711868,82],["καὶ",707031,7],["κακῆς",707066,82]],null],["15",[["ἄνοια",701185,12],["ἐξῆπται",704874,187],["καρδίας",707141,17],["νέου",709256,116],["ῥάβδος",711135,12],["δὲ",703303,11],["καὶ",707031,7],["παιδεία",709924,12],["μακρὰν",708411,28],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102]],"Folly is attached to the heart of a child, but the rod and instruction are [then] far from him."],["16",[["ὁ",709436,3],["συκοφαντῶν",712256,72],["πένητα",710248,6],["πολλὰ",710646,68],["ποιεῖ",710582,91],["τὰ",709436,41],["ἑαυτοῦ",703917,102],["δίδωσιν",703654,91],["δὲ",703303,11],["πλουσίῳ",710560,30],["ἐπ᾿",705080,0],["ἐλάσσονι",704388,30]],"He that oppresses the poor, increases his own substance, yet gives to the rich so as to make it less."],["17",[["λόγοις",708236,148],["σοφῶν",711985,169],["παράβαλλε",709997,240],["σὸν",711943,46],["οὖς",709852,25],["καὶ",707031,7],["ἄκουε",700587,240],["ἐμὸν",704578,27],["λόγον",708236,6],["τὴν",709436,8],["δὲ",703303,11],["σὴν",711943,36],["καρδίαν",707141,9],["ἐπίστησον",705756,176],["ἵνα",706747,7],["γνῷς",703105,175],["ὅτι",709803,7],["καλοί",707097,138],["εἰσιν",704093,197]],"Incline thine ear to the words of wise men: hear also my word, and apply thine heart,"],["18",[["καὶ",707031,7],["ἐὰν",703912,7],["ἐμβάλῃς",704547,175],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὴν",709436,8],["καρδίαν",707141,9],["σου",711945,133],["εὐφρανοῦσίν",705715,218],["σε",711598,163],["ἅμα",700745,28],["ἐπὶ",705080,0],["σοῖς",711943,94],["χείλεσιν",713781,96]],"that thou mayest know that they are good: and if thou lay them to heart, they shall also gladden thee on thy lips."],["19",[["ἵνα",706747,7],["σου",711945,133],["γένηται",703104,239],["ἐπὶ",705080,0],["κύριον",707996,6],["ἡ",709436,10],["ἐλπὶς",704530,12],["καὶ",707031,7],["γνωρίσῃ",703135,172],["σοι",711925,159],["τὴν",709436,8],["ὁδὸν",709458,9],["αὐτοῦ",702165,102]],"That thy hope may be in the Lord, and he may make thy way known to thee."],["20",[["καὶ",707031,7],["σὺ",712181,164],["δὲ",703303,11],["ἀπόγραψαι",701437,300],["αὐτὰ",702165,71],["σεαυτῷ",711599,50],["τρισσῶς",712962,28],["εἰς",704105,0],["βουλὴν",702792,9],["καὶ",707031,7],["γνῶσιν",703138,9],["ἐπὶ",705080,0],["τὸ",709436,24],["πλάτος",710507,25],["τῆς",709436,16],["καρδίας",707141,17],["σου",711945,133]],"And do thou too repeatedly record them for thyself on the table of thine heart, for counsel and knowledge."],["21",[["διδάσκω",703649,157],["οὖν",709835,11],["σε",711598,163],["ἀληθῆ",700658,27],["λόγον",708236,6],["καὶ",707031,7],["γνῶσιν",703138,9],["ἀγαθὴν",700106,36],["ὑπακούειν",713096,55],["τοῦ",709436,20],["ἀποκρίνεσθαι",701492,110],["λόγους",708236,57],["ἀληθείας",700656,17],["τοῖς",709436,147],["προβαλλομένοις",710764,341],["σοι",711925,159]],"I therefore teach thee truth, and knowledge good to hear; that thou mayest answer words of truth to them that question thee."],["22",[["μὴ",708851,28],["ἀποβιάζου",701429,253],["πένητα",710248,6],["πτωχὸς",711076,4],["γάρ",702963,11],["ἐστιν",704093,91],["καὶ",707031,7],["μὴ",708851,28],["ἀτιμάσῃς",702092,175],["ἀσθενῆ",701939,27],["ἐν",704639,0],["πύλαις",711082,76]],"Do no violence to the poor, for he is needy: neither dishonour the helpless [man] in the gates."],["23",[["ὁ",709436,3],["γὰρ",702963,11],["κύριος",707996,4],["κρινεῖ",707905,127],["αὐτοῦ",702165,102],["τὴν",709436,8],["κρίσιν",707908,9],["καὶ",707031,7],["ῥύσῃ",711309,123],["σὴν",711943,36],["ἄσυλον",702031,36],["ψυχήν",714070,9]],"For the Lord will plead his cause, and thou shalt deliver thy soul in safety."],["24",[["μὴ",708851,28],["ἴσθι",704093,240],["ἑταῖρος",705529,4],["ἀνδρὶ",701150,114],["θυμώδει",706336,30],["φίλῳ",713492,30],["δὲ",703303,11],["ὀργίλῳ",709730,30],["μὴ",708851,28],["συναυλίζου",712409,253]],"Be not companion to a furious man; neither lodge with a passionate man:"],["25",[["μήποτε",708882,28],["μάθῃς",708480,175],["τῶν",709436,130],["ὁδῶν",709458,65],["αὐτοῦ",702165,102],["καὶ",707031,7],["λάβῃς",708076,175],["βρόχους",702820,57],["τῇ",709436,100],["σῇ",711943,101],["ψυχῇ",714070,1]],"lest thou learn of his ways, and get snares to thy soul."],["26",[["μὴ",708851,28],["δίδου",703654,240],["σεαυτὸν",711599,85],["εἰς",704105,0],["ἐγγύην",703945,9],["αἰσχυνόμενος",700485,122],["πρόσωπον",710986,25]],"Become not surety from respect of a man's person."],["27",[["ἐὰν",703912,7],["γὰρ",702963,11],["μὴ",708851,28],["ἔχῃς",705785,205],["πόθεν",710580,28],["ἀποτείσῃς",701618,175],["λήμψονται",708076,135],["τὸ",709436,24],["στρῶμα",712173,25],["τὸ",709436,24],["ὑπὸ",713184,0],["τὰς",709436,38],["πλευράς",710524,39],["σου",711945,133]],"For if those have not whence to give compensation, they will take the bed [that is] under thee."],["28",[["μὴ",708851,28],["μέταιρε",708794,240],["ὅρια",709749,42],["αἰώνια",700505,68],["ἃ",709781,69],["ἔθεντο",712849,189],["οἱ",709436,136],["πατέρες",710189,52],["σου",711945,133]],"Remove not the old landmarks, which thy fathers placed."],["29",[["ὁρατικὸν",709723,27],["ἄνδρα",701150,6],["καὶ",707031,7],["ὀξὺν",709682,27],["ἐν",704639,0],["τοῖς",709436,147],["ἔργοις",705396,96],["αὐτοῦ",702165,102],["βασιλεῦσι",702580,148],["δεῖ",703312,91],["παρεστάναι",710152,115],["καὶ",707031,7],["μὴ",708851,28],["παρεστάναι",710152,115],["ἀνδράσι",701150,148],["νωθροῖς",709398,230]],"It is fit that an observant man and [one] diligent in his business should attend on kings, and not attend on slothful men."]]