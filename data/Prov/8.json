[["1",[["σὺ",712181,164],["τὴν",709436,8],["σοφίαν",711981,9],["κηρύξεις",707662,166],["ἵνα",706747,7],["φρόνησίς",713588,12],["σοι",711925,159],["ὑπακούσῃ",713096,172]],"Thou shalt proclaim wisdom, that understanding may be obedient to thee."],["2",[["ἐπὶ",705080,0],["γὰρ",702963,11],["τῶν",709436,43],["ὑψηλῶν",713285,83],["ἄκρων",700608,83],["ἐστίν",704093,91],["ἀνὰ",700902,0],["μέσον",708768,46],["δὲ",703303,11],["τῶν",709436,130],["τρίβων",712941,198],["ἕστηκεν",706846,171]],"For she is on lofty eminences, and stands in the midst of the ways."],["3",[["παρὰ",709995,0],["γὰρ",702963,11],["πύλαις",711082,76],["δυναστῶν",703844,81],["παρεδρεύει",710123,91],["ἐν",704639,0],["δὲ",703303,11],["εἰσόδοις",704119,76],["ὑμνεῖται",713085,117]],"For she sits by the gates of princes, and sings in the entrances, [saying],"],["4",[["ὑμᾶς",713080,194],["ὦ",714081,88],["ἄνθρωποι",701163,274],["παρακαλῶ",710039,157],["καὶ",707031,7],["προΐεμαι",710802,254],["ἐμὴν",704578,36],["φωνὴν",713640,9],["υἱοῖς",713075,148],["ἀνθρώπων",701163,81]],"You, O men, I exhort; and utter my voice to the sons of men."],["5",[["νοήσατε",709327,74],["ἄκακοι",700512,138],["πανουργίαν",709971,9],["οἱ",709436,136],["δὲ",703303,11],["ἀπαίδευτοι",701328,138],["ἔνθεσθε",704796,186],["καρδίαν",707141,9]],"O ye simple, understand subtlety, and ye that are untaught, imbibe knowledge."],["6",[["εἰσακούσατέ",704108,74],["μου",709032,133],["σεμνὰ",711682,68],["γὰρ",702963,11],["ἐρῶ",705415,165],["καὶ",707031,7],["ἀνοίσω",701083,165],["ἀπὸ",701425,0],["χειλέων",713781,44],["ὀρθά",709738,68]],"Hearken to me; for I will speak solemn [truths]; and will produce right [sayings] from my lips."],["7",[["ὅτι",709803,7],["ἀλήθειαν",700656,9],["μελετήσει",708698,127],["ὁ",709436,3],["φάρυγξ",713375,4],["μου",709032,133],["ἐβδελυγμένα",703920,443],["δὲ",703303,11],["ἐναντίον",704654,28],["ἐμοῦ",704580,133],["χείλη",713781,64],["ψευδῆ",714036,195]],"For my throat shall meditate truth; and false lips are an abomination before me."],["8",[["μετὰ",708780,0],["δικαιοσύνης",703695,17],["πάντα",710177,195],["τὰ",709436,63],["ῥήματα",711246,64],["τοῦ",709436,20],["στόματός",712125,21],["μου",709032,133],["οὐδὲν",709817,26],["ἐν",704639,0],["αὐτοῖς",702165,151],["σκολιὸν",711868,26],["οὐδὲ",709816,7],["στραγγαλῶδες",712136,26]],"All the words of my mouth are in righteousness; there is nothing in them wrong or perverse."],["9",[["πάντα",710177,195],["ἐνώπια",704823,195],["τοῖς",709436,147],["συνιοῦσιν",712481,349],["καὶ",707031,7],["ὀρθὰ",709738,195],["τοῖς",709436,147],["εὑρίσκουσι",705676,349],["γνῶσιν",703138,9]],"They are all evident to those that understand, and right to those that find knowledge."],["10",[["λάβετε",708076,74],["παιδείαν",709924,9],["καὶ",707031,7],["μὴ",708851,28],["ἀργύριον",701707,25],["καὶ",707031,7],["γνῶσιν",703138,9],["ὑπὲρ",713111,0],["χρυσίον",713972,25],["δεδοκιμασμένον",703776,414],["ἀνθαιρεῖσθε",701207,253],["δὲ",703303,11],["αἴσθησιν",700477,9],["χρυσίου",713972,21],["καθαροῦ",706988,92]],"Receive instruction, and not silver; and knowledge rather than tried gold.",{"s":"d","q":0.67}],["11",[["κρείσσων",707891,14],["γὰρ",702963,11],["σοφία",711981,12],["λίθων",708196,81],["πολυτελῶν",710647,169],["πᾶν",710177,26],["δὲ",703303,11],["τίμιον",712858,26],["οὐκ",709805,28],["ἄξιον",701308,26],["αὐτῆς",702165,86],["ἐστιν",704093,91]],"For wisdom is better than precious stones; and no valuable substance is of equal worth with it."],["12",[["ἐγὼ",704018,164],["ἡ",709436,10],["σοφία",711981,12],["κατεσκήνωσα",707423,155],["βουλήν",702792,9],["καὶ",707031,7],["γνῶσιν",703138,9],["καὶ",707031,7],["ἔννοιαν",704764,9],["ἐγὼ",704018,164],["ἐπεκαλεσάμην",705153,161]],"I wisdom have dwelt [with] counsel and knowledge, and I have called upon understanding."],["13",[["φόβος",713534,4],["κυρίου",707996,18],["μισεῖ",708935,91],["ἀδικίαν",700271,9],["ὕβριν",713051,9],["τε",712751,11],["καὶ",707031,7],["ὑπερηφανίαν",713138,9],["καὶ",707031,7],["ὁδοὺς",709458,39],["πονηρῶν",710660,83],["μεμίσηκα",708935,89],["δὲ",703303,11],["ἐγὼ",704018,164],["διεστραμμένας",703592,498],["ὁδοὺς",709458,39],["κακῶν",707066,83]],"The fear of the Lord hates unrighteousness, and insolence, and pride, and the ways of wicked men; and I hate the perverse ways of bad men."],["14",[["ἐμὴ",704578,29],["βουλὴ",702792,12],["καὶ",707031,7],["ἀσφάλεια",702039,12],["ἐμὴ",704578,29],["φρόνησις",713588,12],["ἐμὴ",704578,29],["δὲ",703303,11],["ἰσχύς",706858,12]],"Counsel and safety are mine: prudence is mine, and strength is mine."],["15",[["δι᾿",703417,0],["ἐμοῦ",704580,133],["βασιλεῖς",702580,52],["βασιλεύουσιν",702581,197],["καὶ",707031,7],["οἱ",709436,136],["δυνάσται",703844,52],["γράφουσιν",703194,197],["δικαιοσύνην",703695,9]],"By me kings reign, and princes decree justice."],["16",[["δι᾿",703417,0],["ἐμοῦ",704580,133],["μεγιστᾶνες",708657,52],["μεγαλύνονται",708647,269],["καὶ",707031,7],["τύραννοι",713026,52],["δι᾿",703417,0],["ἐμοῦ",704580,133],["κρατοῦσι",707879,197],["γῆς",703083,17]],"By me nobles become great, and monarchs by me rule over the earth."],["17",[["ἐγὼ",704018,164],["τοὺς",709436,58],["ἐμὲ",704555,163],["φιλοῦντας",713471,235],["ἀγαπῶ",700120,157],["οἱ",709436,136],["δὲ",703303,11],["ἐμὲ",704555,163],["ζητοῦντες",705879,146],["εὑρήσουσιν",705676,218]],"I love those that love me; and they that seek me shall find [me]."],["18",[["πλοῦτος",710563,4],["καὶ",707031,7],["δόξα",703791,12],["ἐμοὶ",704577,159],["ὑπάρχει",713104,91],["καὶ",707031,7],["κτῆσις",707937,12],["πολλῶν",710646,169],["καὶ",707031,7],["δικαιοσύνη",703695,12]],"Wealth and glory belong to me; yea, abundant possessions and righteousness."],["19",[["βέλτιον",702647,26],["ἐμὲ",704555,163],["καρπίζεσθαι",707166,110],["ὑπὲρ",713111,0],["χρυσίον",713972,25],["καὶ",707031,7],["λίθον",708196,6],["τίμιον",712858,27],["τὰ",709436,63],["δὲ",703303,11],["ἐμὰ",704578,195],["γενήματα",703052,64],["κρείσσω",707891,195],["ἀργυρίου",701707,21],["ἐκλεκτοῦ",704240,92]],"[It is] better to have my fruit than [to have] gold and precious stones; and my produce is better than choice silver."],["20",[["ἐν",704639,0],["ὁδοῖς",709458,76],["δικαιοσύνης",703695,17],["περιπατῶ",710362,157],["καὶ",707031,7],["ἀνὰ",700902,0],["μέσον",708768,46],["τρίβων",712939,17],["δικαιώματος",703697,21],["ἀναστρέφομαι",701060,254]],"I walk in ways of righteousness, and [am] conversant with the paths of judgment;"],["21",[["ἵνα",706747,7],["μερίσω",708744,165],["τοῖς",709436,147],["ἐμὲ",704555,163],["ἀγαπῶσιν",700120,349],["ὕπαρξιν",713101,9],["καὶ",707031,7],["τοὺς",709436,58],["θησαυροὺς",706258,57],["αὐτῶν",702165,40],["ἐμπλήσω",704592,165],["ἀγαθῶν",700106,169]],"that I may divide substance to them that love me, and may fill their treasures with good things."],["21a",[["ἐὰν",703912,7],["ἀναγγείλω",700921,207],["ὑμῖν",713084,90],["τὰ",709436,41],["καθ᾿",707200,0],["ἡμέραν",705984,9],["γινόμενα",703104,67],["μνημονεύσω",708965,165],["τὰ",709436,41],["ἐξ",704132,0],["αἰῶνος",700504,18],["ἀριθμῆσαι",701742,106]],null],["22",[["κύριος",707996,4],["ἔκτισέν",707938,2],["με",708618,163],["ἀρχὴν",701836,9],["ὁδῶν",709458,65],["αὐτοῦ",702165,102],["εἰς",704105,0],["ἔργα",705396,42],["αὐτοῦ",702165,102]],"The Lord made me the beginning of his ways for his works."],["23",[["πρὸ",710747,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["ἐθεμελίωσέν",706182,2],["με",708618,163],["ἐν",704639,0],["ἀρχῇ",701836,1]],"He established me before time [was] in the beginning, before he made the earth:",{"s":"d","q":0.58}],["24",[["πρὸ",710747,0],["τοῦ",709436,20],["τὴν",709436,8],["γῆν",703083,9],["ποιῆσαι",710582,106],["καὶ",707031,7],["πρὸ",710747,0],["τοῦ",709436,20],["τὰς",709436,38],["ἀβύσσους",700098,39],["ποιῆσαι",710582,106],["πρὸ",710747,0],["τοῦ",709436,20],["προελθεῖν",710789,106],["τὰς",709436,38],["πηγὰς",710450,39],["τῶν",709436,43],["ὑδάτων",713071,44]],"even before he made the depths; before the fountains of water came forth:"],["25",[["πρὸ",710747,0],["τοῦ",709436,20],["ὄρη",709768,42],["ἑδρασθῆναι",704037,179],["πρὸ",710747,0],["δὲ",703303,11],["πάντων",710177,169],["βουνῶν",702797,81],["γεννᾷ",703051,91],["με",708618,163]],"before the mountains were settled, and before all hills, he begets me."],["26",[["κύριος",707996,4],["ἐποίησεν",710582,2],["χώρας",714011,39],["καὶ",707031,7],["ἀοικήτους",701315,60],["καὶ",707031,7],["ἄκρα",700608,68],["οἰκούμενα",709499,67],["τῆς",709436,16],["ὑπ᾿",713184,0],["οὐρανόν",709844,6]],"The Lord made countries and uninhabited [tracts], and the highest inhabited parts of the world."],["27",[["ἡνίκα",706008,28],["ἡτοίμαζεν",705539,13],["τὸν",709436,5],["οὐρανόν",709844,6],["συμπαρήμην",712322,161],["αὐτῷ",702165,50],["καὶ",707031,7],["ὅτε",709802,28],["ἀφώριζεν",702227,13],["τὸν",709436,5],["ἑαυτοῦ",703917,102],["θρόνον",706315,6],["ἐπ᾿",705080,0],["ἀνέμων",701123,81]],"When he prepared the heaven, I was present with him; and when he prepared his throne upon the winds:"],["28",[["ἡνίκα",706008,28],["ἰσχυρὰ",706855,68],["ἐποίει",710582,13],["τὰ",709436,41],["ἄνω",701296,28],["νέφη",709281,42],["καὶ",707031,7],["ὡς",714148,28],["ἀσφαλεῖς",702040,60],["ἐτίθει",712849,13],["πηγὰς",710450,39],["τῆς",709436,16],["ὑπ᾿",713184,0],["οὐρανὸν",709844,6]],"and when he strengthened the clouds above; and when he secured the fountains of the earth:"],["29",[["καὶ",707031,7],["ἰσχυρὰ",706855,68],["ἐποίει",710582,13],["τὰ",709436,41],["θεμέλια",706181,42],["τῆς",709436,16],["γῆς",703083,17]],"and when he strengthened the foundations of the earth:"],["30",[["ἤμην",704578,36],["παρ᾿",709995,0],["αὐτῷ",702165,50],["ἁρμόζουσα",701775,188],["ἐγὼ",704018,164],["ἤμην",704578,36],["ᾗ",709781,108],["προσέχαιρεν",710979,13],["καθ᾿",707200,0],["ἡμέραν",705984,9],["δὲ",703303,11],["εὐφραινόμην",705715,334],["ἐν",704639,0],["προσώπῳ",710986,54],["αὐτοῦ",702165,102],["ἐν",704639,0],["παντὶ",710177,30],["καιρῷ",707047,114]],"I was by him, suiting [myself to him], I was that wherein he took delight; and daily I rejoiced in his presence continually."],["31",[["ὅτε",709802,28],["εὐφραίνετο",705715,23],["τὴν",709436,8],["οἰκουμένην",709517,173],["συντελέσας",712510,182],["καὶ",707031,7],["ἐνευφραίνετο",704721,23],["ἐν",704639,0],["υἱοῖς",713075,148],["ἀνθρώπων",701163,81]],"For he rejoiced when he had completed the world, and rejoiced among the children of men."],["32",[["νῦν",709384,28],["οὖν",709835,11],["υἱέ",713075,153],["ἄκουέ",700587,240],["μου",709032,133]],"Now then, [my] son, hear me: blessed is the man who shall hearken to me, and the mortal who shall keep my ways;"],["34",[["μακάριος",708397,14],["ἀνήρ",701150,4],["ὃς",709781,213],["εἰσακούσεταί",704108,93],["μου",709032,133],["καὶ",707031,7],["ἄνθρωπος",701163,4],["ὃς",709781,213],["τὰς",709436,38],["ἐμὰς",704578,119],["ὁδοὺς",709458,39],["φυλάξει",713619,127],["ἀγρυπνῶν",700197,72],["ἐπ᾿",705080,0],["ἐμαῖς",704578,291],["θύραις",706337,76],["καθ᾿",707200,0],["ἡμέραν",705984,9],["τηρῶν",712844,72],["σταθμοὺς",712040,57],["ἐμῶν",704578,198],["εἰσόδων",704119,65]],"watching daily at my doors, waiting at the posts of my entrances."],["35",[["αἱ",709436,190],["γὰρ",702963,11],["ἔξοδοί",704948,191],["μου",709032,133],["ἔξοδοι",704948,191],["ζωῆς",705910,17],["καὶ",707031,7],["ἑτοιμάζεται",705539,117],["θέλησις",706172,12],["παρὰ",709995,0],["κυρίου",707996,18]],"For my outgoings are the outgoings of life, and [in them] is prepared favour from the Lord."],["36",[["οἱ",709436,136],["δὲ",703303,11],["εἰς",704105,0],["ἐμὲ",704555,163],["ἁμαρτάνοντες",700773,146],["ἀσεβοῦσιν",701906,197],["τὰς",709436,38],["ἑαυτῶν",703917,40],["ψυχάς",714070,39],["καὶ",707031,7],["οἱ",709436,136],["μισοῦντές",708935,146],["με",708618,163],["ἀγαπῶσιν",700120,197],["θάνατον",706096,6]],"But they that sin against me act wickedly against their own souls: and they that hate me love death."]]