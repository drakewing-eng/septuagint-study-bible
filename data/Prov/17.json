[["1",[["κρείσσων",707891,14],["ψωμὸς",714078,4],["μεθ᾿",708780,0],["ἡδονῆς",705942,17],["ἐν",704639,0],["εἰρήνῃ",704098,1],["ἢ",705924,7],["οἶκος",709516,4],["πλήρης",710541,14],["πολλῶν",710646,169],["ἀγαθῶν",700106,169],["καὶ",707031,7],["ἀδίκων",700272,83],["θυμάτων",706327,44],["μετὰ",708780,0],["μάχης",708601,17]],"Better is a morsel with pleasure in peace, than a house [full] of many good things and unjust sacrifices, with strife."],["2",[["οἰκέτης",709496,4],["νοήμων",709329,14],["κρατήσει",707879,127],["δεσποτῶν",703379,81],["ἀφρόνων",702236,169],["ἐν",704639,0],["δὲ",703303,11],["ἀδελφοῖς",700249,148],["διελεῖται",703459,93],["μέρη",708752,42]],"A wise servant shall have rule over foolish masters, and shall divide portions among brethren."],["3",[["ὥσπερ",714163,28],["δοκιμάζεται",703776,117],["ἐν",704639,0],["καμίνῳ",707113,114],["ἄργυρος",701711,4],["καὶ",707031,7],["χρυσός",713975,14],["οὕτως",709859,28],["ἐκλεκταὶ",704240,192],["καρδίαι",707141,191],["παρὰ",709995,0],["κυρίῳ",707996,114]],"As silver and gold are tried in a furnace, so are choice hearts with the Lord."],["4",[["κακὸς",707066,14],["ὑπακούει",713096,91],["γλώσσης",703120,17],["παρανόμων",710080,169],["δίκαιος",703694,14],["δὲ",703303,11],["οὐ",709805,28],["προσέχει",710895,91],["χείλεσιν",713781,96],["ψευδέσιν",714036,230]],"A bad man hearkens to the tongue of transgressors: but a righteous man attends not to false lips."],["5",[["ὁ",709436,3],["καταγελῶν",707222,72],["πτωχοῦ",711076,18],["παροξύνει",710164,91],["τὸν",709436,5],["ποιήσαντα",710582,365],["αὐτόν",702165,85],["ὁ",709436,3],["δὲ",703303,11],["ἐπιχαίρων",705330,72],["ἀπολλυμένῳ",701513,241],["οὐκ",709805,28],["ἀθῳωθήσεται",700391,134],["ὁ",709436,3],["δὲ",703303,11],["ἐπισπλαγχνιζόμενος",705261,466],["ἐλεηθήσεται",704418,134]],"He that laughs at the poor provokes him that made him; and he that rejoices at the destruction of another shall not be held guiltless: but he that has compassion shall find mercy."],["6",[["στέφανος",712083,4],["γερόντων",703065,81],["τέκνα",712761,64],["τέκνων",712761,44],["καύχημα",707570,15],["δὲ",703303,11],["τέκνων",712761,44],["πατέρες",710189,52],["αὐτῶν",702165,40]],"Children's children are the crown of old men; and their fathers are the glory of children."],["6a",[["τοῦ",709436,35],["πιστοῦ",710486,116],["ὅλος",709597,14],["ὁ",709436,3],["κόσμος",707851,4],["τῶν",709436,43],["χρημάτων",713948,44],["τοῦ",709436,35],["δὲ",703303,11],["ἀπίστου",701413,116],["οὐδὲ",709816,7],["ὀβολός",709441,4]],null],["7",[["οὐχ",709805,28],["ἁρμόσει",701775,127],["ἄφρονι",702236,30],["χείλη",713781,64],["πιστὰ",710486,195],["οὐδὲ",709816,7],["δικαίῳ",703694,30],["χείλη",713781,64],["ψευδῆ",714036,195]],"Faithful lips will not suit a fool; nor lying lips a just man."],["8",[["μισθὸς",708939,4],["χαρίτων",713735,65],["ἡ",709436,10],["παιδεία",709924,12],["τοῖς",709436,147],["χρωμένοις",713936,341],["οὗ",709781,48],["δ᾿",703303,11],["ἂν",700900,11],["ἐπιστρέψῃ",705278,123],["εὐοδωθήσεται",705654,134]],"Instruction is to them that use it a gracious reward: and whithersoever it may turn, it shall prosper."],["9",[["ὃς",709781,213],["κρύπτει",707923,91],["ἀδικήματα",700270,42],["ζητεῖ",705879,91],["φιλίαν",713474,9],["ὃς",709781,213],["δὲ",703303,11],["μισεῖ",708935,91],["κρύπτειν",707923,55],["διίστησιν",703690,91],["φίλους",713492,60],["καὶ",707031,7],["οἰκείους",709493,60]],"He that conceals injuries seeks love; but he that hates to hide [them] separates friends and kindred."],["10",[["συντρίβει",712520,91],["ἀπειλὴ",701375,12],["καρδίαν",707141,9],["φρονίμου",713589,116],["ἄφρων",702236,14],["δὲ",703303,11],["μαστιγωθεὶς",708566,217],["οὐκ",709805,28],["αἰσθάνεται",700476,117]],"A threat breaks down the heart of a wise man; but a fool, though scourged, understands not."],["11",[["ἀντιλογίας",701249,39],["ἐγείρει",703949,91],["πᾶς",710177,14],["κακός",707066,14],["ὁ",709436,3],["δὲ",703303,11],["κύριος",707996,4],["ἄγγελον",700140,6],["ἀνελεήμονα",701120,27],["ἐκπέμψει",704274,127],["αὐτῷ",702165,50]],"Every bad man stirs up strifes: but the Lord will send out against him an unmerciful messenger."],["12",[["ἐμπεσεῖται",704593,93],["μέριμνα",708745,12],["ἀνδρὶ",701150,114],["νοήμονι",709329,30],["οἱ",709436,136],["δὲ",703303,11],["ἄφρονες",702236,138],["διαλογιοῦνται",703505,135],["κακά",707066,68]],"Care may befall a man of understanding; but fools will meditate evils."],["13",[["ὃς",709781,213],["ἀποδίδωσιν",701449,91],["κακὰ",707066,68],["ἀντὶ",701227,0],["ἀγαθῶν",700106,169],["οὐ",709805,28],["κινηθήσεται",707679,134],["κακὰ",707066,68],["ἐκ",704132,0],["τοῦ",709436,35],["οἴκου",709516,18],["αὐτοῦ",702165,102]],"Whoso rewards evil for good, evil shall not be removed from his house."],["14",[["ἐξουσίαν",704974,9],["δίδωσιν",703654,91],["λόγοις",708236,148],["ἀρχὴ",701836,12],["δικαιοσύνης",703695,17],["προηγεῖται",710791,117],["δὲ",703303,11],["τῆς",709436,16],["ἐνδείας",704672,17],["στάσις",712049,12],["καὶ",707031,7],["μάχη",708601,12]],"Rightful rule gives power to words; but sedition and strife precede poverty."],["15",[["ὃς",709781,213],["δίκαιον",703694,27],["κρίνει",707905,91],["τὸν",709436,5],["ἄδικον",700272,27],["ἄδικον",700272,27],["δὲ",703303,11],["τὸν",709436,5],["δίκαιον",703694,27],["ἀκάθαρτος",700508,14],["καὶ",707031,7],["βδελυκτὸς",702606,14],["παρὰ",709995,0],["θεῷ",706192,114]],"He that pronounces the unjust just, and the just unjust, is unclean and abominable with God."],["16",[["ἵνα",706747,7],["τί",712867,126],["ὑπῆρξεν",713104,2],["χρήματα",713948,42],["ἄφρονι",702236,30],["κτήσασθαι",707932,109],["γὰρ",702963,11],["σοφίαν",711981,9],["ἀκάρδιος",700519,14],["οὐ",709805,28],["δυνήσεται",703838,93]],"Why has the fool wealth? for a senseless man will not be able to purchase wisdom."],["16a",[["ὃς",709781,213],["ὑψηλὸν",713285,27],["ποιεῖ",710582,91],["τὸν",709436,5],["ἑαυτοῦ",703917,102],["οἶκον",709516,6],["ζητεῖ",705879,91],["συντριβήν",712519,9],["ὁ",709436,3],["δὲ",703303,11],["σκολιάζων",711867,72],["τοῦ",709436,20],["μαθεῖν",708480,106],["ἐμπεσεῖται",704593,93],["εἰς",704105,0],["κακά",707066,68]],null],["17",[["εἰς",704105,0],["πάντα",710177,27],["καιρὸν",707047,6],["φίλος",713492,14],["ὑπαρχέτω",713104,31],["σοι",711925,159],["ἀδελφοὶ",700249,52],["δὲ",703303,11],["ἐν",704639,0],["ἀνάγκαις",700925,76],["χρήσιμοι",713953,138],["ἔστωσαν",704093,56],["τούτου",709858,102],["γὰρ",702963,11],["χάριν",713735,9],["γεννῶνται",703051,699]],"Have thou a friend for every time, and let brethren be useful in distress; for on this account are they born."],["18",[["ἀνὴρ",701150,4],["ἄφρων",702236,14],["ἐπικροτεῖ",705180,91],["καὶ",707031,7],["ἐπιχαίρει",705330,91],["ἑαυτῷ",703917,50],["ὡς",714148,7],["καὶ",707031,28],["ὁ",709436,3],["ἐγγυώμενος",703944,122],["ἐγγύῃ",703945,1],["τὸν",709436,5],["ἑαυτοῦ",703917,102],["φίλον",713492,27]],"A foolish man applauds and rejoices over himself, [as he] also that becomes surety would make himself responsible for his own friends."],["19",[["φιλαμαρτήμων",713460,14],["χαίρει",713665,91],["μάχαις",708601,76]],"A lover of sin rejoices in strifes;"],["20",[["ὁ",709436,3],["δὲ",703303,11],["σκληροκάρδιος",711860,14],["οὐ",709805,28],["συναντᾷ",712394,91],["ἀγαθοῖς",700106,230],["ἀνὴρ",701150,4],["εὐμετάβολος",705643,14],["γλώσσῃ",703120,1],["ἐμπεσεῖται",704593,93],["εἰς",704105,0],["κακά",707066,68]],"and the hard-hearted man comes not in for good. A man of a changeful tongue will fall into mischiefs;"],["21",[["καρδία",707141,12],["δὲ",703303,11],["ἄφρονος",702236,116],["ὀδύνη",709463,12],["τῷ",709436,113],["κεκτημένῳ",707932,516],["αὐτήν",702165,104],["οὐκ",709805,28],["εὐφραίνεται",705715,117],["πατὴρ",710189,4],["ἐπὶ",705080,0],["υἱῷ",713075,114],["ἀπαιδεύτῳ",701328,30],["υἱὸς",713075,4],["δὲ",703303,11],["φρόνιμος",713589,14],["εὐφραίνει",705715,91],["μητέρα",708892,9],["αὐτοῦ",702165,102]],"and the heart of a fool is grief to its possessor. A father rejoices not over an uninstructed son; but a wise son gladdens his mother."],["22",[["καρδία",707141,12],["εὐφραινομένη",705715,211],["εὐεκτεῖν",705571,55],["ποιεῖ",710582,91],["ἀνδρὸς",701150,18],["δὲ",703303,11],["λυπηροῦ",708274,116],["ξηραίνεται",709419,117],["τὰ",709436,41],["ὀστᾶ",709792,42]],"A glad heart promotes health; but the bones of a sorrowful man dry up."],["23",[["λαμβάνοντος",708076,152],["δῶρα",703907,42],["ἐν",704639,0],["κόλπῳ",707800,114],["ἀδίκως",700273,28],["οὐ",709805,28],["κατευοδοῦνται",707523,269],["ὁδοί",709458,191],["ἀσεβὴς",701909,14],["δὲ",703303,11],["ἐκκλίνει",704220,91],["ὁδοὺς",709458,39],["δικαιοσύνης",703695,17]],"The ways of a man who unjustly receives gifts in [his] bosom do not prosper; and an ungodly man perverts the ways of righteousness."],["24",[["πρόσωπον",710986,15],["συνετὸν",712464,26],["ἀνδρὸς",701150,18],["σοφοῦ",711985,116],["οἱ",709436,136],["δὲ",703303,11],["ὀφθαλμοὶ",709870,52],["τοῦ",709436,35],["ἄφρονος",702236,116],["ἐπ᾿",705080,0],["ἄκρα",700608,68],["γῆς",703083,17]],"The countenance of a wise man is sensible; but the eyes of a fool [go] to the ends of the earth."],["25",[["ὀργὴ",709728,12],["πατρὶ",710189,114],["υἱὸς",713075,4],["ἄφρων",702236,14],["καὶ",707031,7],["ὀδύνη",709463,12],["τῇ",709436,100],["τεκούσῃ",712853,603],["αὐτοῦ",702165,102]],"A foolish son [is a cause of] anger to his father, and grief to her that bore him."],["26",[["ζημιοῦν",705878,55],["ἄνδρα",701150,6],["δίκαιον",703694,27],["οὐ",709805,28],["καλόν",707097,26],["οὐδὲ",709816,7],["ὅσιον",709782,27],["ἐπιβουλεύειν",705094,55],["δυνάσταις",703844,148],["δικαίοις",703694,230]],"[It is] not right to punish a righteous man, nor [is it] holy to plot against righteous princes."],["27",[["ὃς",709781,213],["φείδεται",713406,117],["ῥῆμα",711246,25],["προέσθαι",710802,109],["σκληρόν",711861,46],["ἐπιγνώμων",705106,14],["μακρόθυμος",708420,14],["δὲ",703303,11],["ἀνὴρ",701150,4],["φρόνιμος",713589,14]],"He that forbears to utter a hard word is discreet, and a patient man is wise."],["28",[["ἀνοήτῳ",701184,30],["ἐπερωτήσαντι",705069,350],["σοφίαν",711981,9],["σοφία",711981,12],["λογισθήσεται",708232,134],["ἐνεὸν",709256,27],["δέ",703303,11],["τις",712866,158],["ἑαυτὸν",703917,85],["ποιήσας",710582,182],["δόξει",703775,127],["φρόνιμος",713589,14],["εἶναι",704093,55]],"Wisdom shall be imputed to a fool who asks after wisdom: and he who holds his peace shall seem to be sensible."]]