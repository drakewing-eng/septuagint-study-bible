[["1",[["υἱὸς",713075,4],["σοφὸς",711985,14],["εὐφραίνει",705715,91],["πατέρα",710189,6],["υἱὸς",713075,4],["δὲ",703303,11],["ἄφρων",702236,14],["λύπη",708273,12],["τῇ",709436,100],["μητρί",708892,1]],"A wise son makes [his] father glad: but a foolish son is a grief to his mother."],["2",[["οὐκ",709805,28],["ὠφελήσουσιν",714171,218],["θησαυροὶ",706258,52],["ἀνόμους",701194,60],["δικαιοσύνη",703695,12],["δὲ",703303,11],["ῥύσεται",711309,93],["ἐκ",704132,0],["θανάτου",706096,18]],"Treasures shall not profit the lawless: but righteousness shall deliver from death."],["3",[["οὐ",709805,28],["λιμοκτονήσει",708209,127],["κύριος",707996,4],["ψυχὴν",714070,9],["δικαίαν",703694,36],["ζωὴν",705910,9],["δὲ",703303,11],["ἀσεβῶν",701909,169],["ἀνατρέψει",701073,127]],"The Lord will not famish a righteous soul: but he will overthrow the life of the ungodly."],["4",[["πενία",710254,12],["ἄνδρα",701150,6],["ταπεινοῖ",712717,91],["χεῖρες",713787,191],["δὲ",703303,11],["ἀνδρείων",701101,169],["πλουτίζουσιν",710562,197]],"Poverty brings a man low: but the hands of the vigorous make rich."],["4a",[["υἱὸς",713075,4],["πεπαιδευμένος",709926,419],["σοφὸς",711985,14],["ἔσται",704093,93],["τῷ",709436,113],["δὲ",703303,11],["ἄφρονι",702236,30],["διακόνῳ",703478,114],["χρήσεται",713937,93]],null],["5",[["διεσώθη",703599,37],["ἀπὸ",701425,0],["καύματος",707564,21],["υἱὸς",713075,4],["νοήμων",709329,14],["ἀνεμόφθορος",701125,14],["δὲ",703303,11],["γίνεται",703104,117],["ἐν",704639,0],["ἀμήτῳ",700819,114],["υἱὸς",713075,4],["παράνομος",710080,14]],"A wise son is saved from heat: but a lawless son is blighted of the winds in harvest."],["6",[["εὐλογία",705633,12],["κυρίου",707996,18],["ἐπὶ",705080,0],["κεφαλὴν",707639,9],["δικαίου",703694,116],["στόμα",712125,15],["δὲ",703303,11],["ἀσεβῶν",701909,169],["καλύψει",707102,127],["πένθος",710253,25],["ἄωρον",702329,46]],"The blessing of the Lord is upon the head of the just: but untimely grief shall cover the mouth of the ungodly."],["7",[["μνήμη",708964,12],["δικαίων",703694,169],["μετ᾿",708780,0],["ἐγκωμίων",704004,44],["ὄνομα",709666,15],["δὲ",703303,11],["ἀσεβοῦς",701909,116],["σβέννυται",711596,117]],"The memory of the just is praised; but the name of the ungodly [man] is extinguished."],["8",[["σοφὸς",711985,14],["καρδίᾳ",707141,1],["δέξεται",703393,93],["ἐντολάς",704802,39],["ὁ",709436,3],["δὲ",703303,11],["ἄστεγος",702013,14],["χείλεσιν",713781,96],["σκολιάζων",711867,72],["ὑποσκελισθήσεται",713239,134]],"A wise man in heart will receive commandments; but he that is unguarded in his lips shall be overthrown in his perverseness."],["9",[["ὃς",709781,213],["πορεύεται",710667,117],["ἁπλῶς",701423,28],["πορεύεται",710667,117],["πεποιθώς",710221,270],["ὁ",709436,3],["δὲ",703303,11],["διαστρέφων",703592,72],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτοῦ",702165,102],["γνωσθήσεται",703105,134]],"He that walks simply, walks confidently; but he that perverts his ways shall be known."],["10",[["ὁ",709436,3],["ἐννεύων",704761,72],["ὀφθαλμοῖς",709870,148],["μετὰ",708780,0],["δόλου",703787,18],["συνάγει",712375,91],["ἀνδράσι",701150,148],["λύπας",708273,39],["ὁ",709436,3],["δὲ",703303,11],["ἐλέγχων",704416,72],["μετὰ",708780,0],["παρρησίας",710173,17],["εἰρηνοποιεῖ",704101,91]],"He that winks with his eyes deceitfully, procures griefs for men; but he that reproves boldly is a peacemaker."],["11",[["πηγὴ",710450,12],["ζωῆς",705910,17],["ἐν",704639,0],["χειρὶ",713787,1],["δικαίου",703694,116],["στόμα",712125,15],["δὲ",703303,11],["ἀσεβοῦς",701909,116],["καλύψει",707102,127],["ἀπώλεια",701660,12]],"[There is] a fountain of life in the hand of a righteous man; but destruction shall cover the mouth of the ungodly."],["12",[["μῖσος",708947,15],["ἐγείρει",703949,91],["νεῖκος",709246,25],["πάντας",710177,60],["δὲ",703303,11],["τοὺς",709436,58],["μὴ",708851,28],["φιλονεικοῦντας",713485,235],["καλύπτει",707102,91],["φιλία",713474,12]],"Hatred stirs up strife; but affection covers all that do not love strife."],["13",[["ὃς",709781,213],["ἐκ",704132,0],["χειλέων",713781,44],["προφέρει",711006,91],["σοφίαν",711981,9],["ῥάβδῳ",711135,1],["τύπτει",713022,91],["ἄνδρα",701150,6],["ἀκάρδιον",700519,27]],"He that brings forth wisdom from his lips smites the fool with a rod."],["14",[["σοφοὶ",711985,138],["κρύψουσιν",707923,218],["αἴσθησιν",700477,9],["στόμα",712125,15],["δὲ",703303,11],["προπετοῦς",710836,116],["ἐγγίζει",703939,91],["συντριβῇ",712519,12]],"The wise will hide discretion; but the mouth of the hasty draws near to ruin."],["15",[["κτῆσις",707937,12],["πλουσίων",710560,169],["πόλις",710612,12],["ὀχυρά",709889,29],["συντριβὴ",712519,12],["δὲ",703303,11],["ἀσεβῶν",701909,169],["πενία",710254,64]],"The wealth of rich men is a strong city; but poverty is the ruin of the ungodly."],["16",[["ἔργα",705396,64],["δικαίων",703694,169],["ζωὴν",705910,9],["ποιεῖ",710582,91],["καρποὶ",707169,52],["δὲ",703303,11],["ἀσεβῶν",701909,169],["ἁμαρτίας",700775,39]],"The works of the righteous produce life; but the fruits of the ungodly [produce] sins."],["17",[["ὁδοὺς",709458,39],["δικαίας",703694,82],["ζωῆς",705910,17],["φυλάσσει",713619,91],["παιδεία",709924,12],["παιδεία",709924,12],["δὲ",703303,11],["ἀνεξέλεγκτος",701127,29],["πλανᾶται",710495,117]],"Instruction keeps the right ways of life; but instruction unchastened goes astray."],["18",[["καλύπτουσιν",707102,197],["ἔχθραν",705779,36],["χείλη",713781,64],["δίκαια",703694,195],["οἱ",709436,136],["δὲ",703303,11],["ἐκφέροντες",704356,146],["λοιδορίας",708242,39],["ἀφρονέστατοί",702236,480],["εἰσιν",704093,197]],"Righteous lips cover enmity; but they that utter railings are most foolish."],["19",[["ἐκ",704132,0],["πολυλογίας",710630,17],["οὐκ",709805,28],["ἐκφεύξῃ",704357,123],["ἁμαρτίαν",700775,9],["φειδόμενος",713406,122],["δὲ",703303,11],["χειλέων",713781,44],["νοήμων",709329,14],["ἔσῃ",704093,123]],"By a multitude of words thou shalt not escape sin; but if thou refrain thy lips thou wilt be prudent."],["20",[["ἄργυρος",701711,4],["πεπυρωμένος",711103,251],["γλῶσσα",703120,12],["δικαίου",703694,116],["καρδία",707141,12],["δὲ",703303,11],["ἀσεβοῦς",701909,116],["ἐκλείψει",704237,127]],"The tongue of the just is tried silver; but the heart of the ungodly shall fail."],["21",[["χείλη",713781,64],["δικαίων",703694,169],["ἐπίσταται",705264,117],["ὑψηλά",713285,68],["οἱ",709436,136],["δὲ",703303,11],["ἄφρονες",702236,138],["ἐν",704639,0],["ἐνδείᾳ",704672,1],["τελευτῶσιν",712781,197]],"The lips of the righteous know sublime [truths]: but the foolish die in want."],["22",[["εὐλογία",705633,12],["κυρίου",707996,18],["ἐπὶ",705080,0],["κεφαλὴν",707639,9],["δικαίου",703694,116],["αὕτη",709858,107],["πλουτίζει",710562,91],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["προστεθῇ",710965,384],["αὐτῇ",702165,105],["λύπη",708273,12],["ἐν",704639,0],["καρδίᾳ",707141,1]],"The blessing of the Lord is upon the head of the righteous; it enriches [him], and grief of heart shall not be added to [it]."],["23",[["ἐν",704639,0],["γέλωτι",703032,114],["ἄφρων",702236,14],["πράσσει",710721,91],["κακά",707066,68],["ἡ",709436,10],["δὲ",703303,11],["σοφία",711981,12],["ἀνδρὶ",701150,114],["τίκτει",712853,91],["φρόνησιν",713588,9]],"A fool does mischief in sport; but wisdom brings forth prudence for a man."],["24",[["ἐν",704639,0],["ἀπωλείᾳ",701660,1],["ἀσεβὴς",701909,14],["περιφέρεται",710410,117],["ἐπιθυμία",705147,12],["δὲ",703303,11],["δικαίου",703694,116],["δεκτή",703348,29]],"The ungodly is engulphed in destruction; but the desire of the righteous is acceptable."],["25",[["παραπορευομένης",710094,422],["καταιγίδος",707254,1],["ἀφανίζεται",702182,117],["ἀσεβής",701909,14],["δίκαιος",703694,14],["δὲ",703303,11],["ἐκκλίνας",704220,182],["σῴζεται",712627,117],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"When the storm passes by, the ungodly vanishes away; but the righteous turns aside and escapes for ever."],["26",[["ὥσπερ",714163,28],["ὄμφαξ",709651,12],["ὀδοῦσι",709461,148],["βλαβερὸν",702730,27],["καὶ",707031,7],["καπνὸς",707132,4],["ὄμμασιν",709616,96],["οὕτως",709859,28],["παρανομία",710079,12],["τοῖς",709436,147],["χρωμένοις",713936,341],["αὐτήν",702165,104]],"As a sour grape is hurtful to the teeth, and smoke to the eyes, so iniquity hurts those that practise it."],["27",[["φόβος",713534,4],["κυρίου",707996,18],["προστίθησιν",710965,91],["ἡμέρας",705984,39],["ἔτη",705543,64],["δὲ",703303,11],["ἀσεβῶν",701909,169],["ὀλιγωθήσεται",709576,134]],"The fear of the Lord adds [length] of days: but the years of the ungodly shall be shortened."],["28",[["ἐγχρονίζει",704016,91],["δικαίοις",703694,230],["εὐφροσύνη",705717,12],["ἐλπὶς",704530,12],["δὲ",703303,11],["ἀσεβῶν",701909,169],["ὄλλυται",709584,117]],"Joy rests long with the righteous: but the hope of the ungodly shall perish."],["29",[["ὀχύρωμα",709891,15],["ὁσίου",709782,116],["φόβος",713534,4],["κυρίου",707996,18],["συντριβὴ",712519,12],["δὲ",703303,11],["τοῖς",709436,147],["ἐργαζομένοις",705383,341],["κακά",707066,68]],"The fear of the Lord is a strong hold of the saints: but ruin [comes] to them that work wickedness."],["30",[["δίκαιος",703694,14],["τὸν",709436,5],["αἰῶνα",700504,6],["οὐκ",709805,28],["ἐνδώσει",704689,127],["ἀσεβεῖς",701909,138],["δὲ",703303,11],["οὐκ",709805,28],["οἰκήσουσιν",709499,218],["γῆν",703083,9]],"The righteous shall never fail: but the ungodly shall not dwell in the earth."],["31",[["στόμα",712125,15],["δικαίου",703694,116],["ἀποστάζει",701584,91],["σοφίαν",711981,9],["γλῶσσα",703120,12],["δὲ",703303,11],["ἀδίκου",700272,116],["ἐξολεῖται",704955,93]],"The mouth of the righteous drops wisdom: but the tongue of the unjust shall perish."],["32",[["χείλη",713781,64],["ἀνδρῶν",701150,81],["δικαίων",703694,169],["ἀποστάζει",701584,91],["χάριτας",713735,39],["στόμα",712125,15],["δὲ",703303,11],["ἀσεβῶν",701909,169],["ἀποστρέφεται",701598,117]],"The lips of just men drop grace: but the mouth of the ungodly is perverse."]]