[["2",[["πάντα",710177,195],["τὰ",709436,63],["ἔργα",705396,64],["τοῦ",709436,35],["ταπεινοῦ",712714,116],["φανερὰ",713342,195],["παρὰ",709995,0],["τῷ",709436,113],["θεῷ",706192,114],["οἱ",709436,136],["δὲ",703303,11],["ἀσεβεῖς",701909,138],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["κακῇ",707066,101],["ὀλοῦνται",709584,135]],"All the works of the humble [man] are manifest with God; but the ungodly shall perish in an evil day."],["5",[["ἀκάθαρτος",700508,14],["παρὰ",709995,0],["θεῷ",706192,114],["πᾶς",710177,14],["ὑψηλοκάρδιος",713284,14],["χειρὶ",713787,1],["δὲ",703303,11],["χεῖρας",713787,39],["ἐμβαλὼν",704547,182],["ἀδίκως",700273,28],["οὐκ",709805,28],["ἀθῳωθήσεται",700391,134]],"Every one that is proud in heart is unclean before God, and he that unjustly strikes hands with hand shall not be held guiltless."],["7",[["ἀρχὴ",701836,12],["ὁδοῦ",709458,17],["ἀγαθῆς",700106,82],["τὸ",709436,34],["ποιεῖν",710582,55],["τὰ",709436,41],["δίκαια",703694,68],["δεκτὰ",703348,68],["δὲ",703303,11],["παρὰ",709995,0],["θεῷ",706192,114],["μᾶλλον",708448,28],["ἢ",705924,7],["θύειν",706349,55],["θυσίας",706345,17]],"The beginning of a good way is to do justly; and it is more acceptable with God than to offer sacrifices."],["8",[["ὁ",709436,3],["ζητῶν",705879,72],["τὸν",709436,5],["κύριον",707996,6],["εὑρήσει",705676,127],["γνῶσιν",703138,9],["μετὰ",708780,0],["δικαιοσύνης",703695,17],["οἱ",709436,136],["δὲ",703303,11],["ὀρθῶς",709746,28],["ζητοῦντες",705879,146],["αὐτὸν",702165,85],["εὑρήσουσιν",705676,218],["εἰρήνην",704098,9]],"He that seeks the Lord shall find knowledge with righteousness: and they that rightly seek him shall find peace."],["9",[["πάντα",710177,195],["τὰ",709436,63],["ἔργα",705396,64],["τοῦ",709436,35],["κυρίου",707996,18],["μετὰ",708780,0],["δικαιοσύνης",703695,17],["φυλάσσεται",713619,117],["δὲ",703303,11],["ὁ",709436,3],["ἀσεβὴς",701909,14],["εἰς",704105,0],["ἡμέραν",705984,9],["κακήν",707066,36]],"All the works of the Lord [are done] with righteousness; and the ungodly [man] is kept for the evil day."],["10",[["μαντεῖον",708489,15],["ἐπὶ",705080,0],["χείλεσιν",713781,96],["βασιλέως",702580,18],["ἐν",704639,0],["δὲ",703303,11],["κρίσει",707908,1],["οὐ",709805,28],["μὴ",708851,28],["πλανηθῇ",710495,384],["τὸ",709436,34],["στόμα",712125,15],["αὐτοῦ",702165,102]],"[There is] an oracle upon the lips of a king; and his mouth shall not err in judgment."],["11",[["ῥοπὴ",711294,12],["ζυγοῦ",705894,21],["δικαιοσύνη",703695,12],["παρὰ",709995,0],["κυρίῳ",707996,114],["τὰ",709436,63],["δὲ",703303,11],["ἔργα",705396,64],["αὐτοῦ",702165,102],["στάθμια",712039,64],["δίκαια",703694,195]],"The poise of the balance is righteousness with the Lord; and his works are righteous measures."],["12",[["βδέλυγμα",702604,15],["βασιλεῖ",702580,114],["ὁ",709436,3],["ποιῶν",710582,72],["κακά",707066,68],["μετὰ",708780,0],["γὰρ",702963,11],["δικαιοσύνης",703695,17],["ἑτοιμάζεται",705539,117],["θρόνος",706315,4],["ἀρχῆς",701836,17]],"An evil-doer is an abomination to a king; for the throne of rule is established by righteousness."],["13",[["δεκτὰ",703348,68],["βασιλεῖ",702580,114],["χείλη",713781,42],["δίκαια",703694,68],["λόγους",708236,57],["δὲ",703303,11],["ὀρθοὺς",709738,60],["ἀγαπᾷ",700120,91]],"Righteous lips are acceptable to a king; and he loves right words."],["14",[["θυμὸς",706334,4],["βασιλέως",702580,18],["ἄγγελος",700140,4],["θανάτου",706096,18],["ἀνὴρ",701150,4],["δὲ",703303,11],["σοφὸς",711985,14],["ἐξιλάσεται",704932,93],["αὐτόν",702165,85]],"The anger of a king is a messenger of death; but a wise man will pacify him."],["15",[["ἐν",704639,0],["φωτὶ",713642,54],["ζωῆς",705910,17],["υἱὸς",713075,4],["βασιλέως",702580,18],["οἱ",709436,136],["δὲ",703303,11],["προσδεκτοὶ",710872,138],["αὐτῷ",702165,50],["ὥσπερ",714163,28],["νέφος",709281,15],["ὄψιμον",709899,26]],"The son of a king is in the light of life; and they that are in favour with him are as a cloud of latter rain."],["16",[["νοσσιαὶ",709360,191],["σοφίας",711981,17],["αἱρετώτεραι",700471,481],["χρυσίου",713972,21],["νοσσιαὶ",709360,191],["δὲ",703303,11],["φρονήσεως",713588,17],["αἱρετώτεραι",700471,481],["ὑπὲρ",713111,0],["ἀργύριον",701707,25]],"The brood of wisdom is more to be chosen than gold, and the brood of prudence more to be chosen than silver."],["17",[["τρίβοι",712939,191],["ζωῆς",705910,17],["ἐκκλίνουσιν",704220,197],["ἀπὸ",701425,0],["κακῶν",707066,169],["μῆκος",708868,15],["δὲ",703303,11],["βίου",702724,18],["ὁδοὶ",709458,191],["δικαιοσύνης",703695,17],["ὁ",709436,3],["δεχόμενος",703393,122],["παιδείαν",709924,9],["ἐν",704639,0],["ἀγαθοῖς",700106,230],["ἔσται",704093,93],["ὁ",709436,3],["δὲ",703303,11],["φυλάσσων",713619,72],["ἐλέγχους",704415,57],["σοφισθήσεται",711982,134],["ὃς",709781,213],["φυλάσσει",713619,91],["τὰς",709436,38],["ἑαυτοῦ",703917,102],["ὁδούς",709458,39],["τηρεῖ",712844,91],["τὴν",709436,8],["ἑαυτοῦ",703917,102],["ψυχήν",714070,9],["ἀγαπῶν",700120,72],["δὲ",703303,11],["ζωὴν",705910,9],["αὐτοῦ",702165,102],["φείσεται",713406,93],["στόματος",712125,21],["αὐτοῦ",702165,102]],"The paths of life turn aside from evil; and the ways of righteousness are length of life. He that receives instruction shall be in prosperity; and he that regards reproofs shall be made wise. He that keeps his ways, preserves his own soul; and he that loves his life will spare his mouth."],["18",[["πρὸ",710747,0],["συντριβῆς",712519,17],["ἡγεῖται",705931,117],["ὕβρις",713051,12],["πρὸ",710747,0],["δὲ",703303,11],["πτώματος",711071,21],["κακοφροσύνη",707071,12]],"Pride goes before destruction, and folly before a fall."],["19",[["κρείσσων",707891,14],["πραΰθυμος",710723,14],["μετὰ",708780,0],["ταπεινώσεως",712719,17],["ἢ",705924,7],["ὃς",709781,213],["διαιρεῖται",703459,117],["σκῦλα",711902,42],["μετὰ",708780,0],["ὑβριστῶν",713052,81]],"Better is a meek-spirited [man] with lowliness, than one who divides spoils with the proud."],["20",[["συνετὸς",712464,14],["ἐν",704639,0],["πράγμασιν",710708,96],["εὑρετὴς",705673,4],["ἀγαθῶν",700106,169],["πεποιθὼς",710221,270],["δὲ",703303,11],["ἐπὶ",705080,0],["θεῷ",706192,114],["μακαριστός",708399,14]],"[He who is] skilful in business finds good: but he that trusts in God is most blessed."],["21",[["τοὺς",709436,58],["σοφοὺς",711985,60],["καὶ",707031,7],["συνετοὺς",712464,60],["φαύλους",713398,60],["καλοῦσιν",707084,197],["οἱ",709436,136],["δὲ",703303,11],["γλυκεῖς",703114,138],["ἐν",704639,0],["λόγῳ",708236,114],["πλείονα",710514,27],["ἀκούσονται",700587,144]],"[Men] call the wise and understanding evil: but they that are pleasing in speech shall hear more."],["22",[["πηγὴ",710450,12],["ζωῆς",705910,17],["ἔννοια",704764,12],["τοῖς",709436,147],["κεκτημένοις",707932,521],["παιδεία",709924,12],["δὲ",703303,11],["ἀφρόνων",702236,169],["κακή",707066,29]],"Understanding is a fountain of life to its possessors; but the instruction of fools is evil."],["23",[["καρδία",707141,12],["σοφοῦ",711985,116],["νοήσει",709327,127],["τὰ",709436,41],["ἀπὸ",701425,0],["τοῦ",709436,20],["ἰδίου",706493,92],["στόματος",712125,21],["ἐπὶ",705080,0],["δὲ",703303,11],["χείλεσιν",713781,96],["φορέσει",713554,127],["ἐπιγνωμοσύνην",705105,9]],"The heart of the wise will discern the [things which proceed] from his own mouth; and on his lips he will wear knowledge."],["24",[["κηρία",707657,64],["μέλιτος",708700,21],["λόγοι",708236,52],["καλοί",707097,138],["γλύκασμα",703111,15],["δὲ",703303,11],["αὐτῶν",702165,40],["ἴασις",706444,12],["ψυχῆς",714070,17]],"Good words are honeycombs, and the sweetness thereof is a healing of the soul."],["25",[["εἰσὶν",704093,197],["ὁδοὶ",709458,191],["δοκοῦσαι",703775,306],["εἶναι",704093,55],["ὀρθαὶ",709738,192],["ἀνδρί",701150,114],["τὰ",709436,63],["μέντοι",708734,11],["τελευταῖα",712780,195],["αὐτῶν",702165,40],["βλέπει",702740,91],["εἰς",704105,0],["πυθμένα",711079,6],["ᾅδου",700255,18]],"There are ways that seem to be right to a man, but the end of them looks to the depth of hell."],["26",[["ἀνὴρ",701150,4],["ἐν",704639,0],["πόνοις",710661,148],["πονεῖ",710656,91],["ἑαυτῷ",703917,50],["καὶ",707031,7],["ἐκβιάζεται",704149,117],["ἑαυτοῦ",703917,102],["τὴν",709436,8],["ἀπώλειαν",701660,9],["ὁ",709436,3],["μέντοι",708734,11],["σκολιὸς",711868,14],["ἐπὶ",705080,0],["τῷ",709436,53],["ἑαυτοῦ",703917,102],["στόματι",712125,54],["φορεῖ",713554,91],["τὴν",709436,8],["ἀπώλειαν",701660,9]],"A man who labours, labours for himself, and drives from [him] his own ruin."],["27",[["ἀνὴρ",701150,4],["ἄφρων",702236,14],["ὀρύσσει",709775,91],["ἑαυτῷ",703917,50],["κακά",707066,68],["ἐπὶ",705080,0],["δὲ",703303,11],["τῶν",709436,43],["ἑαυτοῦ",703917,102],["χειλέων",713781,44],["θησαυρίζει",706256,91],["πῦρ",711088,25]],"But the perverse bears destruction upon his own mouth: a foolish man digs up evil for himself, and treasures fire on his own lips."],["28",[["ἀνὴρ",701150,4],["σκολιὸς",711868,14],["διαπέμπεται",703542,117],["κακὰ",707066,68],["καὶ",707031,7],["λαμπτῆρα",708084,6],["δόλου",703787,18],["πυρσεύει",711110,91],["κακοῖς",707066,230],["καὶ",707031,7],["διαχωρίζει",703640,91],["φίλους",713492,60]],"A perverse man spreads mischief, and will kindle a torch of deceit with mischiefs; and he separates friends."],["29",[["ἀνὴρ",701150,4],["παράνομος",710080,14],["ἀποπειρᾶται",701542,117],["φίλων",713492,169],["καὶ",707031,7],["ἀπάγει",701324,91],["αὐτοὺς",702165,62],["ὁδοὺς",709458,39],["οὐκ",709805,28],["ἀγαθάς",700106,119]],"A transgressor tries [to ensnare] friends, and leads them in ways [that are] not good."],["30",[["στηρίζων",712098,72],["ὀφθαλμοὺς",709870,57],["αὐτοῦ",702165,102],["λογίζεται",708232,117],["διεστραμμένα",703592,388],["ὁρίζει",709748,91],["δὲ",703303,11],["τοῖς",709436,95],["χείλεσιν",713781,96],["αὐτοῦ",702165,102],["πάντα",710177,68],["τὰ",709436,41],["κακά",707066,68],["οὗτος",709858,121],["κάμινός",707113,4],["ἐστιν",704093,91],["κακίας",707054,17]],"And the man that fixes his eyes devises perverse things, and marks out with his lips all evils: he is a furnace of wickedness."],["31",[["στέφανος",712083,4],["καυχήσεως",707571,17],["γῆρας",703089,15],["ἐν",704639,0],["δὲ",703303,11],["ὁδοῖς",709458,76],["δικαιοσύνης",703695,17],["εὑρίσκεται",705676,117]],"Old age is a crown of honour, but it is found in the ways of righteousness."],["32",[["κρείσσων",707891,14],["ἀνὴρ",701150,4],["μακρόθυμος",708420,14],["ἰσχυροῦ",706855,116],["ὁ",709436,3],["δὲ",703303,11],["κρατῶν",707879,72],["ὀργῆς",709728,17],["κρείσσων",707891,14],["καταλαμβανομένου",707300,262],["πόλιν",710612,9]],"A man slow to anger is better than a strong [man]; and he that governs [his] temper better than he that takes a city."],["33",[["εἰς",704105,0],["κόλπους",707800,57],["ἐπέρχεται",705068,117],["πάντα",710177,195],["τοῖς",709436,147],["ἀδίκοις",700272,230],["παρὰ",709995,0],["δὲ",703303,11],["κυρίου",707996,18],["πάντα",710177,195],["τὰ",709436,63],["δίκαια",703694,195]],"All [evils] come upon the ungodly into [their] bosoms; but all righteous things [come] of the Lord."]]