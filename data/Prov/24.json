[["1",[["υἱέ",713075,153],["μὴ",708851,28],["ζηλώσῃς",705873,175],["κακοὺς",707066,60],["ἄνδρας",701150,57],["μηδὲ",708855,7],["ἐπιθυμήσῃς",705141,175],["εἶναι",704093,55],["μετ᾿",708780,0],["αὐτῶν",702165,40]],"[My] son, envy not bad men, nor desire to be with them."],["2",[["ψεύδη",714036,68],["γὰρ",702963,11],["μελετᾷ",708698,91],["ἡ",709436,10],["καρδία",707141,12],["αὐτῶν",702165,40],["καὶ",707031,7],["πόνους",710661,57],["τὰ",709436,63],["χείλη",713781,64],["αὐτῶν",702165,40],["λαλεῖ",708071,91]],"For their heart meditates falsehoods, and their lips speak mischiefs."],["3",[["μετὰ",708780,0],["σοφίας",711981,17],["οἰκοδομεῖται",709509,391],["οἶκος",709516,4],["καὶ",707031,7],["μετὰ",708780,0],["συνέσεως",712460,17],["ἀνορθοῦται",701197,391]],"A house is built by wisdom, and is set up by understanding."],["4",[["μετὰ",708780,0],["αἰσθήσεως",700477,17],["ἐμπίμπλαται",704592,117],["ταμίεια",712700,64],["ἐκ",704132,0],["παντὸς",710177,116],["πλούτου",710563,18],["τιμίου",712858,116],["καὶ",707031,7],["καλοῦ",707097,116]],"By discretion the chambers are filled with all precious and excellent wealth."],["5",[["κρείσσων",707891,14],["σοφὸς",711985,14],["ἰσχυροῦ",706855,116],["καὶ",707031,7],["ἀνὴρ",701150,4],["φρόνησιν",713588,9],["ἔχων",705785,72],["γεωργίου",703081,21],["μεγάλου",708653,92]],"A wise man is better than a strong man; and a man who has prudence than a large estate."],["6",[["μετὰ",708780,0],["κυβερνήσεως",707947,17],["γίνεται",703104,117],["πόλεμος",710605,4],["βοήθεια",702745,12],["δὲ",703303,11],["μετὰ",708780,0],["καρδίας",707141,17],["βουλευτικῆς",702790,82]],"War is carried on with generalship, and aid is supplied to the heart of a counsellor."],["7",[["σοφία",711981,12],["καὶ",707031,7],["ἔννοια",704764,12],["ἀγαθὴ",700106,29],["ἐν",704639,0],["πύλαις",711082,76],["σοφῶν",711985,169],["σοφοὶ",711985,138],["οὐκ",709805,28],["ἐκκλίνουσιν",704220,197],["ἐκ",704132,0],["στόματος",712125,21],["κυρίου",707996,18]],"Wisdom and good understanding are in the gates of the wise: the wise turn not aside from the mouth of the Lord,"],["8",[["ἀλλὰ",700680,7],["λογίζονται",708232,269],["ἐν",704639,0],["συνεδρίοις",712429,96],["ἀπαιδεύτοις",701328,94],["συναντᾷ",712394,91],["θάνατος",706096,4]],"but deliberate in council. Death befalls uninstructed [men]."],["9",[["ἀποθνῄσκει",701461,91],["δὲ",703303,11],["ἄφρων",702236,14],["ἐν",704639,0],["ἁμαρτίαις",700775,76],["ἀκαθαρσία",700507,12],["δὲ",703303,11],["ἀνδρὶ",701150,114],["λοιμῷ",708245,30],["ἐμμολυνθήσεται",704573,37]],"The fool also dies in sins; and uncleanness [attaches] to a pestilent man."],["10",[["ἐν",704639,0],["ἡμέρᾳ",705984,1],["κακῇ",707066,101],["καὶ",707031,7],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["θλίψεως",706276,17],["ἕως",705792,7],["ἂν",700900,11],["ἐκλίπῃ",704237,172]],"He shall be defiled in the evil day, and in the day of affliction, until he be utterly consumed."],["11",[["ῥῦσαι",711309,300],["ἀγομένους",700209,236],["εἰς",704105,0],["θάνατον",706096,6],["καὶ",707031,7],["ἐκπρίου",704298,253],["κτεινομένους",704322,236],["μὴ",708851,28],["φείσῃ",713406,420]],"Deliver them that are led away to death, and redeem them that are appointed to be slain; spare not [thy help]."],["12",[["ἐὰν",703912,7],["δὲ",703303,11],["εἴπῃς",705373,175],["οὐκ",709805,28],["οἶδα",709492,89],["τοῦτον",709858,129],["γίνωσκε",703105,240],["ὅτι",709803,7],["κύριος",707996,4],["καρδίας",707141,17],["πάντων",710177,169],["γινώσκει",703105,91],["καὶ",707031,7],["ὁ",709436,3],["πλάσας",710503,182],["πνοὴν",710574,9],["πᾶσιν",710177,230],["αὐτὸς",702165,121],["οἶδεν",709492,171],["πάντα",710177,27],["ὃς",709781,213],["ἀποδίδωσιν",701449,91],["ἑκάστῳ",704133,30],["κατὰ",707200,0],["τὰ",709436,41],["ἔργα",705396,42],["αὐτοῦ",702165,102]],"But if thou shouldest say, I know not this man; know that the Lord knows the hearts of all; and he that formed breath for all, he knows all things, who renders to every man according to his works."],["13",[["φάγε",713296,176],["μέλι",708700,25],["υἱέ",713075,153],["ἀγαθὸν",700106,26],["γὰρ",702963,11],["κηρίον",707657,15],["ἵνα",706747,7],["γλυκανθῇ",703110,384],["σου",711945,133],["ὁ",709436,3],["φάρυγξ",713375,4]],"[My] son, eat honey, for the honeycomb is good, that thy throat may be sweetened."],["14",[["οὕτως",709859,28],["αἰσθήσῃ",700476,364],["σοφίαν",711981,9],["τῇ",709436,100],["σῇ",711943,101],["ψυχῇ",714070,1],["ἐὰν",703912,7],["γὰρ",702963,11],["εὕρῃς",705676,175],["ἔσται",704093,93],["καλὴ",707097,29],["ἡ",709436,10],["τελευτή",712782,12],["σου",711945,133],["καὶ",707031,7],["ἐλπίς",704530,12],["σε",711598,163],["οὐκ",709805,28],["ἐγκαταλείψει",703967,127]],"Thus shalt thou perceive wisdom in thy soul: for if thou find it, thine end shall be good, and hope shall not fail thee."],["15",[["μὴ",708851,28],["προσαγάγῃς",710848,175],["ἀσεβῆ",701909,27],["νομῇ",709337,1],["δικαίων",703694,169],["μηδὲ",708855,7],["ἀπατηθῇς",701364,279],["χορτασίᾳ",713920,1],["κοιλίας",707761,17]],"Bring not an ungodly man into the dwelling of the righteous: neither be deceived by the feeding of the belly."],["16",[["ἑπτάκι",705361,28],["γὰρ",702963,11],["πεσεῖται",710481,93],["ὁ",709436,3],["δίκαιος",703694,14],["καὶ",707031,7],["ἀναστήσεται",701173,93],["οἱ",709436,136],["δὲ",703303,11],["ἀσεβεῖς",701909,138],["ἀσθενήσουσιν",701938,218],["ἐν",704639,0],["κακοῖς",707066,230]],"For a righteous man will fall seven times, and rise [again]: but the ungodly shall be without strength in troubles."],["17",[["ἐὰν",703912,7],["πέσῃ",710481,123],["ὁ",709436,3],["ἐχθρός",705779,14],["σου",711945,133],["μὴ",708851,28],["ἐπιχαρῇς",705330,279],["αὐτῷ",702165,50],["ἐν",704639,0],["δὲ",703303,11],["τῷ",709436,113],["ὑποσκελίσματι",713240,114],["αὐτοῦ",702165,102],["μὴ",708851,28],["ἐπαίρου",705002,253]],"If thine enemy should fall, rejoice not over him, neither be elated at his overthrow."],["18",[["ὅτι",709803,7],["ὄψεται",709725,93],["κύριος",707996,4],["καὶ",707031,7],["οὐκ",709805,28],["ἀρέσει",701724,127],["αὐτῷ",702165,50],["καὶ",707031,7],["ἀποστρέψει",701598,127],["τὸν",709436,5],["θυμὸν",706334,6],["αὐτοῦ",702165,102],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102]],"For the Lord will see [it], and it will not please him, and he will turn away his wrath from him."],["19",[["μὴ",708851,28],["χαῖρε",713665,240],["ἐπὶ",705080,0],["κακοποιοῖς",707064,138],["μηδὲ",708855,7],["ζήλου",705873,253],["ἁμαρτωλούς",700776,60]],"Rejoice not in evil-doers, neither be envious of sinners."],["20",[["οὐ",709805,28],["γὰρ",702963,11],["μὴ",708851,28],["γένηται",703104,239],["ἔκγονα",704159,195],["πονηρῶν",710660,169],["λαμπτὴρ",708084,4],["δὲ",703303,11],["ἀσεβῶν",701909,169],["σβεσθήσεται",711596,134]],"For the evil man shall have no posterity: and the light of the wicked shall be put out."],["21",[["φοβοῦ",713532,253],["τὸν",709436,5],["θεόν",706192,6],["υἱέ",713075,153],["καὶ",707031,7],["βασιλέα",702580,6],["καὶ",707031,7],["μηθετέρῳ",708866,30],["αὐτῶν",702165,40],["ἀπειθήσῃς",701370,175]],"[My] son, fear God and the king; and do not disobey either of them."],["22",[["ἐξαίφνης",704842,28],["γὰρ",702963,11],["τείσονται",712865,135],["τοὺς",709436,58],["ἀσεβεῖς",701909,60],["τὰς",709436,38],["δὲ",703303,11],["τιμωρίας",712863,39],["ἀμφοτέρων",700892,169],["τίς",712867,158],["γνώσεται",703105,93]],"For they will suddenly punish the ungodly, and who can know the vengeance [inflicted] by both?"],["22a",[["λόγον",708236,6],["φυλασσόμενος",713619,122],["υἱὸς",713075,4],["ἀπωλείας",701660,17],["ἐκτὸς",704339,0],["ἔσται",704093,93],["δεχόμενος",703393,122],["δὲ",703303,11],["ἐδέξατο",703393,23],["αὐτόν",702165,85]],null],["22b",[["μηδὲν",708857,46],["ψεῦδος",714044,25],["ἀπὸ",701425,0],["γλώσσης",703120,17],["βασιλεῖ",702580,114],["λεγέσθω",708124,407],["καὶ",707031,7],["οὐδὲν",709817,46],["ψεῦδος",714044,25],["ἀπὸ",701425,0],["γλώσσης",703120,17],["αὐτοῦ",702165,102],["οὐ",709805,28],["μὴ",708851,28],["ἐξέλθῃ",704909,172]],null],["22c",[["μάχαιρα",708593,12],["γλῶσσα",703120,12],["βασιλέως",702580,18],["καὶ",707031,7],["οὐ",709805,28],["σαρκίνη",711534,29],["ὃς",709781,213],["δ᾿",703303,11],["ἂν",700900,11],["παραδοθῇ",710014,384],["συντριβήσεται",712520,134]],null],["22d",[["ἐὰν",703912,7],["γὰρ",702963,11],["ὀξυνθῇ",709681,384],["ὁ",709436,3],["θυμὸς",706334,4],["αὐτοῦ",702165,102],["σὺν",712372,0],["νεύροις",709275,96],["ἀνθρώπους",701163,57],["ἀναλίσκει",700992,91]],null],["22e",[["καὶ",707031,7],["ὀστᾶ",709792,42],["ἀνθρώπων",701163,81],["κατατρώγει",707466,91],["καὶ",707031,7],["συγκαίει",712198,91],["ὥσπερ",714163,28],["φλὸξ",713524,12],["ὥστε",714164,7],["ἄβρωτα",700097,195],["εἶναι",704093,55],["νεοσσοῖς",709257,148],["ἀετῶν",700318,81]],null],["23",[["ταῦτα",709858,71],["δὲ",703303,11],["λέγω",708124,157],["ὑμῖν",713084,90],["τοῖς",709436,147],["σοφοῖς",711985,230],["ἐπιγινώσκειν",705104,55],["αἰδεῖσθαι",700404,110],["πρόσωπον",710986,25],["ἐν",704639,0],["κρίσει",707908,1],["οὐ",709805,28],["καλόν",707097,26]],"And this thing I say to you that are wise [for you] to learn: It is not good to have respect of persons in judgment."],["24",[["ὁ",709436,3],["εἰπὼν",705373,182],["τὸν",709436,5],["ἀσεβῆ",701909,27],["δίκαιός",703694,14],["ἐστιν",704093,91],["ἐπικατάρατος",705159,14],["λαοῖς",708094,148],["ἔσται",704093,93],["καὶ",707031,7],["μισητὸς",708936,14],["εἰς",704105,0],["ἔθνη",704068,42]],"He that says of the ungodly, He is righteous, shall be cursed by peoples, and hateful among the nations."],["25",[["οἱ",709436,136],["δὲ",703303,11],["ἐλέγχοντες",704416,146],["βελτίους",702647,138],["φανοῦνται",713311,135],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["δὲ",703303,11],["ἥξει",705956,127],["εὐλογία",705633,12],["ἀγαθή",700106,29]],"But they that reprove [him] shall appear more excellent, and blessing shall come upon them;"],["26",[["χείλη",713781,42],["δὲ",703303,11],["φιλήσουσιν",713471,218],["ἀποκρινόμενα",701492,67],["λόγους",708236,57],["ἀγαθούς",700106,60]],"and [men] will kiss lips that answer well."],["27",[["ἑτοίμαζε",705539,240],["εἰς",704105,0],["τὴν",709436,8],["ἔξοδον",704948,9],["τὰ",709436,41],["ἔργα",705396,42],["σου",711945,133],["καὶ",707031,7],["παρασκευάζου",710103,253],["εἰς",704105,0],["τὸν",709436,5],["ἀγρὸν",700196,6],["καὶ",707031,7],["πορεύου",710667,253],["κατόπισθέν",707544,28],["μου",709032,133],["καὶ",707031,7],["ἀνοικοδομήσεις",701187,166],["τὸν",709436,5],["οἶκόν",709516,6],["σου",711945,133]],"Prepare thy works for [thy] going forth, and prepare thyself for the field; and come after me, and thou shalt rebuild thine house."],["28",[["μὴ",708851,28],["ἴσθι",704093,240],["ψευδὴς",714036,14],["μάρτυς",708527,4],["ἐπὶ",705080,0],["σὸν",711943,27],["πολίτην",710616,6],["μηδὲ",708855,7],["πλατύνου",710508,253],["σοῖς",711943,94],["χείλεσιν",713781,96]],"Be not a false witness against thy [fellow] citizen, neither exaggerate with thy lips."],["29",[["μὴ",708851,28],["εἴπῃς",705373,175],["ὃν",709781,112],["τρόπον",712980,6],["ἐχρήσατό",713937,23],["μοι",708974,159],["χρήσομαι",713937,181],["αὐτῷ",702165,50],["τείσομαι",712865,181],["δὲ",703303,11],["αὐτὸν",702165,85],["ἅ",709781,69],["με",708618,163],["ἠδίκησεν",700269,2]],"Say not, As he has treated me, so will I treat him, and I will avenge myself on him for that wherein he has injured me."],["30",[["ὥσπερ",714163,28],["γεώργιον",703081,15],["ἀνὴρ",701150,4],["ἄφρων",702236,14],["καὶ",707031,7],["ὥσπερ",714163,28],["ἀμπελὼν",700872,4],["ἄνθρωπος",701163,4],["ἐνδεὴς",704671,14],["φρενῶν",713578,65]],"A foolish man is like a farm, and a senseless man is like a vineyard."],["31",[["ἐὰν",703912,7],["ἀφῇς",702211,175],["αὐτόν",702165,85],["χερσωθήσεται",713832,134],["καὶ",707031,7],["χορτομανήσει",713922,127],["ὅλος",709597,14],["καὶ",707031,7],["γίνεται",703104,117],["ἐκλελειμμένος",704237,419],["οἱ",709436,136],["δὲ",703303,11],["φραγμοὶ",713572,52],["τῶν",709436,80],["λίθων",708196,81],["αὐτοῦ",702165,102],["κατασκάπτονται",707416,699]],"If thou let him alone, he will altogether remain barren and covered with weeds; and he becomes destitute, and his stone walls are broken down."],["32",[["ὕστερον",713273,28],["ἐγὼ",704018,164],["μετενόησα",708809,155],["ἐπέβλεψα",705088,155],["τοῦ",709436,20],["ἐκλέξασθαι",704236,109],["παιδείαν",709924,9]],"Afterwards I reflected, I looked that I might receive instruction."],["33",[["ὀλίγον",709568,27],["νυστάζω",709390,157],["ὀλίγον",709568,27],["δὲ",703303,11],["καθυπνῶ",707026,157],["ὀλίγον",709568,27],["δὲ",703303,11],["ἐναγκαλίζομαι",704641,254],["χερσὶν",713787,76],["στήθη",712089,42]],"[The sluggard says], I slumber a little, and I sleep a little, and for a little while I fold my arms across [my] breast."],["34",[["ἐὰν",703912,7],["δὲ",703303,11],["τοῦτο",709858,129],["ποιῇς",710582,205],["ἥξει",705956,127],["προπορευομένη",710839,211],["ἡ",709436,10],["πενία",710254,12],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["ἔνδειά",704672,12],["σου",711945,133],["ὥσπερ",714163,28],["ἀγαθὸς",700106,14],["δρομεύς",703832,4]],"But if thou do this, thy poverty will come speedily; and thy want like a swift courier."]]