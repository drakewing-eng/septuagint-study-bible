[["1",[["ὥσπερ",714163,28],["ὁρμὴ",709756,12],["ὕδατος",713071,21],["οὕτως",709859,28],["καρδία",707141,12],["βασιλέως",702580,18],["ἐν",704639,0],["χειρὶ",713787,1],["θεοῦ",706192,18],["οὗ",709781,48],["ἐὰν",703912,7],["θέλων",706176,72],["νεύσῃ",709276,123],["ἐκεῖ",704181,28],["ἔκλινεν",707738,13],["αὐτήν",702165,104]],"As a rush of water, so is the king's heart in God's hand: he turns it whithersoever he may desire to point out."],["2",[["πᾶς",710177,14],["ἀνὴρ",701150,4],["φαίνεται",713311,117],["ἑαυτῷ",703917,50],["δίκαιος",703694,14],["κατευθύνει",707521,91],["δὲ",703303,11],["καρδίας",707141,17],["κύριος",707996,4]],"Every man seems to himself righteous; but the Lord directs the hearts."],["3",[["ποιεῖν",710582,55],["δίκαια",703694,68],["καὶ",707031,7],["ἀληθεύειν",700657,55],["ἀρεστὰ",701723,68],["παρὰ",709995,0],["θεῷ",706192,114],["μᾶλλον",708448,28],["ἢ",705924,7],["θυσιῶν",706345,65],["αἷμα",700442,25]],"To do justly and to speak truth, are more pleasing to God than the blood of sacrifices."],["4",[["μεγαλόφρων",708644,4],["ἐφ᾿",705080,0],["ὕβρει",713051,1],["θρασυκάρδιος",706298,14],["λαμπτὴρ",708084,4],["δὲ",703303,11],["ἀσεβῶν",701909,169],["ἁμαρτία",700775,12]],"A high-minded man is stout-hearted in [his] pride; and the lamp of the wicked is sin."],["6",[["ὁ",709436,3],["ἐνεργῶν",704718,72],["θησαυρίσματα",706257,42],["γλώσσῃ",703120,1],["ψευδεῖ",714036,30],["μάταια",708575,68],["διώκει",703768,91],["ἐπὶ",705080,0],["παγίδας",709910,17],["θανάτου",706096,18]],"He that gathers treasures with a lying tongue pursues vanity [on] to the snares of death."],["7",[["ὄλεθρος",709563,4],["ἀσεβέσιν",701909,230],["ἐπιξενωθήσεται",705217,134],["οὐ",709805,28],["γὰρ",702963,11],["βούλονται",702795,269],["πράσσειν",710721,55],["τὰ",709436,41],["δίκαια",703694,68]],"Destruction shall lodge with the ungodly; for they refuse to do justly."],["8",[["πρὸς",710844,0],["τοὺς",709436,58],["σκολιοὺς",711868,60],["σκολιὰς",711868,119],["ὁδοὺς",709458,39],["ἀποστέλλει",701592,91],["ὁ",709436,3],["θεός",706192,4],["ἁγνὰ",700178,195],["γὰρ",702963,11],["καὶ",707031,7],["ὀρθὰ",709738,195],["τὰ",709436,63],["ἔργα",705396,64],["αὐτοῦ",702165,102]],"To the froward God sends froward ways; for his works are pure and right."],["9",[["κρεῖσσον",707890,26],["οἰκεῖν",709499,55],["ἐπὶ",705080,0],["γωνίας",703226,17],["ὑπαίθρου",713094,82],["ἢ",705924,7],["ἐν",704639,0],["κεκονιαμένοις",707813,632],["μετὰ",708780,0],["ἀδικίας",700271,17],["καὶ",707031,7],["ἐν",704639,0],["οἴκῳ",709516,114],["κοινῷ",707772,30]],"[It is] better to dwell in a corner on the house-top, than in plastered [rooms] with unrighteousness, and in an open house."],["10",[["ψυχὴ",714070,12],["ἀσεβοῦς",701909,116],["οὐκ",709805,28],["ἐλεηθήσεται",704418,134],["ὑπ᾿",713184,0],["οὐδενὸς",709817,116],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"The soul of the ungodly shall not be pitied by any man."],["11",[["ζημιουμένου",705878,262],["ἀκολάστου",700565,116],["πανουργότερος",709972,224],["γίνεται",703104,117],["ὁ",709436,3],["ἄκακος",700512,14],["συνίων",712481,72],["δὲ",703303,11],["σοφὸς",711985,14],["δέξεται",703393,93],["γνῶσιν",703138,9]],"When an intemperate man is punished the simple becomes wiser: and a wise man understanding will receive knowledge."],["12",[["συνίει",712481,91],["δίκαιος",703694,14],["καρδίας",707141,39],["ἀσεβῶν",701909,169],["καὶ",707031,7],["φαυλίζει",713394,91],["ἀσεβεῖς",701909,60],["ἐν",704639,0],["κακοῖς",707066,230]],"A righteous man understands the hearts of the ungodly: and despises the ungodly for their wickedness."],["13",[["ὃς",709781,213],["φράσσει",713575,91],["τὰ",709436,41],["ὦτα",709852,25],["τοῦ",709436,20],["μὴ",708851,28],["ἐπακοῦσαι",705009,106],["ἀσθενοῦς",701939,116],["καὶ",707031,28],["αὐτὸς",702165,121],["ἐπικαλέσεται",705153,93],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ὁ",709436,3],["εἰσακούων",704108,72]],"He that stops his ears from hearing the poor, himself also shall cry, and there shall be none to hear [him]."],["14",[["δόσις",703809,12],["λάθριος",708060,29],["ἀνατρέπει",701073,91],["ὀργάς",709728,39],["δώρων",703907,44],["δὲ",703303,11],["ὁ",709436,3],["φειδόμενος",713406,122],["θυμὸν",706334,6],["ἐγείρει",703949,91],["ἰσχυρόν",706855,27]],"A secret gift calms anger: but he that forbears to give stirs up strong wrath."],["15",[["εὐφροσύνη",705717,12],["δικαίων",703694,169],["ποιεῖν",710582,55],["κρίμα",707903,25],["ὅσιος",709782,14],["δὲ",703303,11],["ἀκάθαρτος",700508,14],["παρὰ",709995,0],["κακούργοις",707070,230]],"[It is] the joy of the righteous to do judgment: but a holy [man] is abominable with evil-doers."],["16",[["ἀνὴρ",701150,4],["πλανώμενος",710495,122],["ἐξ",704132,0],["ὁδοῦ",709458,17],["δικαιοσύνης",703695,17],["ἐν",704639,0],["συναγωγῇ",712376,1],["γιγάντων",703101,81],["ἀναπαύσεται",701027,93]],"A man that wanders out of the way of righteousness, shall rest in the congregation of giants."],["17",[["ἀνὴρ",701150,4],["ἐνδεὴς",704671,14],["ἀγαπᾷ",700120,91],["εὐφροσύνην",705717,9],["φιλῶν",713471,72],["οἶνον",709530,6],["καὶ",707031,7],["ἔλαιον",704380,25],["εἰς",704105,0],["πλοῦτον",710563,6]],"A poor man loves mirth, loving wine and oil in abundance;"],["18",[["περικάθαρμα",710323,15],["δὲ",703303,11],["δικαίου",703694,116],["ἄνομος",701194,14]],"and a transgressor is the abomination of a righteous man."],["19",[["κρεῖσσον",707890,26],["οἰκεῖν",709499,55],["ἐν",704639,0],["γῇ",703083,1],["ἐρήμῳ",705420,1],["ἢ",705924,7],["μετὰ",708780,0],["γυναικὸς",703209,17],["μαχίμου",708603,82],["καὶ",707031,7],["γλωσσώδους",703125,82],["καὶ",707031,7],["ὀργίλου",709730,82]],"[It is] better to dwell in a wilderness than with a quarrelsome and talkative and passionate woman."],["20",[["θησαυρὸς",706258,4],["ἐπιθυμητὸς",705146,14],["ἀναπαύσεται",701027,93],["ἐπὶ",705080,0],["στόματος",712125,21],["σοφοῦ",711985,116],["ἄφρονες",702236,138],["δὲ",703303,11],["ἄνδρες",701150,52],["καταπίονται",707374,135],["αὐτόν",702165,85]],"A desirable treasure will rest on the mouth of the wise; but foolish men will swallow it up."],["21",[["ὁδὸς",709458,12],["δικαιοσύνης",703695,17],["καὶ",707031,7],["ἐλεημοσύνης",704421,17],["εὑρήσει",705676,127],["ζωὴν",705910,9],["καὶ",707031,7],["δόξαν",703791,9]],"The way of righteousness and mercy will find life and glory."],["22",[["πόλεις",710612,39],["ὀχυρὰς",709889,119],["ἐπέβη",705082,2],["σοφὸς",711985,14],["καὶ",707031,7],["καθεῖλεν",706982,2],["τὸ",709436,24],["ὀχύρωμα",709891,25],["ἐφ᾿",705080,0],["ᾧ",709781,309],["ἐπεποίθεισαν",710221,263],["οἱ",709436,136],["ἀσεβεῖς",701909,138]],"A wise man assaults strong cities, and demolishes the fortress in which the ungodly trusted."],["23",[["ὃς",709781,213],["φυλάσσει",713619,91],["τὸ",709436,24],["στόμα",712125,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὴν",709436,8],["γλῶσσαν",703120,9],["διατηρεῖ",703607,91],["ἐκ",704132,0],["θλίψεως",706276,17],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102]],"He that keeps his mouth and his tongue keeps his soul from trouble."],["24",[["θρασὺς",706300,14],["καὶ",707031,7],["αὐθάδης",702125,14],["καὶ",707031,7],["ἀλαζὼν",700629,4],["λοιμὸς",708245,14],["καλεῖται",707084,117],["ὃς",709781,213],["δὲ",703303,11],["μνησικακεῖ",708967,91],["παράνομος",710080,14]],"A bold and self-willed and insolent [man] is called a pest: and he that remembers injuries is a transgressor."],["25",[["ἐπιθυμίαι",705147,191],["ὀκνηρὸν",709550,27],["ἀποκτείνουσιν",701498,197],["οὐ",709805,28],["γὰρ",702963,11],["προαιροῦνται",710752,269],["αἱ",709436,190],["χεῖρες",713787,191],["αὐτοῦ",702165,102],["ποιεῖν",710582,55],["τι",712866,126]],"Desires kill the sluggard; for his hands do not choose to do anything."],["26",[["ἀσεβὴς",701909,14],["ἐπιθυμεῖ",705141,91],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9],["ἐπιθυμίας",705147,39],["κακάς",707066,119],["ὁ",709436,3],["δὲ",703303,11],["δίκαιος",703694,14],["ἐλεᾷ",704412,91],["καὶ",707031,7],["οἰκτίρει",709518,91],["ἀφειδῶς",702192,28]],"An ungodly man entertains evil desires all the day: but the righteous is unsparingly merciful and compassionate."],["27",[["θυσίαι",706345,191],["ἀσεβῶν",701909,169],["βδέλυγμα",702604,15],["κυρίῳ",707996,114],["καὶ",707031,7],["γὰρ",702963,11],["παρανόμως",710081,28],["προσφέρουσιν",710974,197],["αὐτάς",702165,231]],"The sacrifices of the ungodly are abomination to the Lord, for they offer them wickedly."],["28",[["μάρτυς",708527,4],["ψευδὴς",714036,14],["ἀπολεῖται",701513,93],["ἀνὴρ",701150,4],["δὲ",703303,11],["ὑπήκοος",713176,4],["φυλασσόμενος",713619,122],["λαλήσει",708071,127]],"A false witness shall perish; but an obedient man will speak cautiously."],["29",[["ἀσεβὴς",701909,14],["ἀνὴρ",701150,4],["ἀναιδῶς",700960,28],["ὑφίσταται",713281,117],["προσώπῳ",710986,54],["ὁ",709436,3],["δὲ",703303,11],["εὐθὴς",705596,14],["αὐτὸς",702165,121],["συνίει",712481,91],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτοῦ",702165,102]],"An ungodly man impudently withstands with his face; but the upright man himself understands his ways."],["30",[["οὐκ",709805,28],["ἔστιν",704093,91],["σοφία",711981,12],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀνδρεία",701100,12],["οὐκ",709805,28],["ἔστιν",704093,91],["βουλὴ",702792,12],["πρὸς",710844,0],["τὸν",709436,5],["ἀσεβῆ",701909,27]],"There is no wisdom, there is no courage, there is no counsel against the ungodly."],["31",[["ἵππος",706790,4],["ἑτοιμάζεται",705539,117],["εἰς",704105,0],["ἡμέραν",705984,9],["πολέμου",710605,18],["παρὰ",709995,0],["δὲ",703303,11],["κυρίου",707996,18],["ἡ",709436,10],["βοήθεια",702745,12]],"A horse is prepared for the day of battle; but help is of the Lord."]]