[["3",[["ἀφροσύνη",702235,12],["ἀνδρὸς",701150,18],["λυμαίνεται",708270,117],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτοῦ",702165,102],["τὸν",709436,5],["δὲ",703303,11],["θεὸν",706192,6],["αἰτιᾶται",700493,117],["τῇ",709436,100],["καρδίᾳ",707141,1],["αὐτοῦ",702165,102]],"The folly of a man spoils his ways: and he blames God in his heart."],["4",[["πλοῦτος",710563,4],["προστίθησιν",710965,91],["φίλους",713492,60],["πολλούς",710646,60],["ὁ",709436,3],["δὲ",703303,11],["πτωχὸς",711076,4],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,35],["ὑπάρχοντος",713102,152],["φίλου",713492,116],["λείπεται",708131,117]],"Wealth acquires many friends; but the poor is deserted even of the friend he has."],["5",[["μάρτυς",708527,4],["ψευδὴς",714036,14],["οὐκ",709805,28],["ἀτιμώρητος",702097,14],["ἔσται",704093,93],["ὁ",709436,3],["δὲ",703303,11],["ἐγκαλῶν",703961,72],["ἀδίκως",700273,28],["οὐ",709805,28],["διαφεύξεται",703623,93]],"A false witness shall not be unpunished, and he that accuses unjustly shall not escape."],["6",[["πολλοὶ",710646,138],["θεραπεύουσιν",706200,197],["πρόσωπα",710986,42],["βασιλέων",702580,81],["πᾶς",710177,14],["δὲ",703303,11],["ὁ",709436,3],["κακὸς",707066,14],["γίνεται",703104,117],["ὄνειδος",709658,15],["ἀνδρί",701150,114]],"Many court the favour of kings; but every bad man becomes a reproach to [another] man."],["7",[["πᾶς",710177,14],["ὃς",709781,213],["ἀδελφὸν",700249,6],["πτωχὸν",711076,6],["μισεῖ",708935,91],["καὶ",707031,7],["φιλίας",713474,39],["μακρὰν",708411,28],["ἔσται",704093,93],["ἔννοια",704764,12],["ἀγαθὴ",700106,29],["τοῖς",709436,147],["εἰδόσιν",704075,536],["αὐτὴν",702165,104],["ἐγγιεῖ",703939,127],["ἀνὴρ",701150,4],["δὲ",703303,11],["φρόνιμος",713589,14],["εὑρήσει",705676,127],["αὐτήν",702165,104],["ὁ",709436,3],["πολλὰ",710646,68],["κακοποιῶν",707062,72],["τελεσιουργεῖ",712776,91],["κακίαν",707054,9],["ὃς",709781,213],["δὲ",703303,11],["ἐρεθίζει",705400,91],["λόγους",708236,57],["οὐ",709805,28],["σωθήσεται",712627,134]],"Every one who hates [his] poor brother shall also be far from friendship. Good understanding will draw near to them that know it, and a sensible man will find it. He that does much harm perfects mischief; and he that uses provoking words shall not escape."],["8",[["ὁ",709436,3],["κτώμενος",707932,122],["φρόνησιν",713588,9],["ἀγαπᾷ",700120,91],["ἑαυτόν",703917,85],["ὃς",709781,213],["δὲ",703303,11],["φυλάσσει",713619,91],["φρόνησιν",713588,9],["εὑρήσει",705676,127],["ἀγαθά",700106,68]],"He that procures wisdom loves himself; and he that keeps wisdom shall find good."],["9",[["μάρτυς",708527,4],["ψευδὴς",714036,14],["οὐκ",709805,28],["ἀτιμώρητος",702097,14],["ἔσται",704093,93],["ὃς",709781,213],["δ᾿",703303,11],["ἂν",700900,11],["ἐκκαύσῃ",704205,123],["κακίαν",707054,9],["ἀπολεῖται",701513,93],["ὑπ᾿",713184,0],["αὐτῆς",702165,86]],"A false witness shall not be unpunished; and whosoever shall kindle mischief shall perish by it."],["10",[["οὐ",709805,28],["συμφέρει",712353,91],["ἄφρονι",702236,30],["τρυφή",713008,12],["καὶ",707031,7],["ἐὰν",703912,7],["οἰκέτης",709496,4],["ἄρξηται",701860,239],["μεθ᾿",708780,0],["ὕβρεως",713051,17],["δυναστεύειν",703843,55]],"Delight does not suit a fool, nor [is it seemly] if a servant should begin to rule with haughtiness."],["11",[["ἐλεήμων",704422,14],["ἀνὴρ",701150,4],["μακροθυμεῖ",708418,91],["τὸ",709436,34],["δὲ",703303,11],["καύχημα",707570,15],["αὐτοῦ",702165,102],["ἐπέρχεται",705068,117],["παρανόμοις",710080,230]],"A merciful man is long-suffering; and his triumph overtakes transgressors."],["12",[["βασιλέως",702580,18],["ἀπειλὴ",701375,12],["ὁμοία",709626,29],["βρυγμῷ",702821,114],["λέοντος",708171,18],["ὥσπερ",714163,28],["δὲ",703303,11],["δρόσος",703835,12],["ἐπὶ",705080,0],["χόρτῳ",713923,114],["οὕτως",709859,28],["τὸ",709436,34],["ἱλαρὸν",706723,26],["αὐτοῦ",702165,102]],"The threatening of a king is like the roaring of a lion; but as dew on the grass, so is his favour."],["13",[["αἰσχύνη",700483,12],["πατρὶ",710189,114],["υἱὸς",713075,4],["ἄφρων",702236,14],["καὶ",707031,7],["οὐχ",709805,28],["ἁγναὶ",700178,192],["εὐχαὶ",705726,191],["ἀπὸ",701425,0],["μισθώματος",708941,21],["ἑταίρας",705527,17]],"A foolish son is a disgrace to his father: vows [paid out] of the hire of a harlot are not pure."],["14",[["οἶκον",709516,6],["καὶ",707031,7],["ὕπαρξιν",713101,9],["μερίζουσιν",708744,197],["πατέρες",710189,52],["παισίν",709932,148],["παρὰ",709995,0],["δὲ",703303,11],["θεοῦ",706192,18],["ἁρμόζεται",701775,117],["γυνὴ",703209,12],["ἀνδρί",701150,114]],"Fathers divide house and substance to [their] children: but a wife is suited to a man by the Lord."],["15",[["δειλία",703319,12],["κατέχει",707526,91],["ἀνδρογύναιον",701105,27],["ψυχὴ",714070,12],["δὲ",703303,11],["ἀεργοῦ",700316,116],["πεινάσει",710222,127]],"Cowardice possesses the effeminate [man]; and the soul of the sluggard shall hunger."],["16",[["ὃς",709781,213],["φυλάσσει",713619,91],["ἐντολήν",704802,9],["τηρεῖ",712844,91],["τὴν",709436,8],["ἑαυτοῦ",703917,102],["ψυχήν",714070,9],["ὁ",709436,3],["δὲ",703303,11],["καταφρονῶν",707482,72],["τῶν",709436,80],["ἑαυτοῦ",703917,102],["ὁδῶν",709458,65],["ἀπολεῖται",701513,93]],"He that keeps the commandment keeps his own soul; but he that despises his ways shall perish."],["17",[["δανίζει",703277,91],["θεῷ",706192,114],["ὁ",709436,3],["ἐλεῶν",704418,72],["πτωχόν",711076,6],["κατὰ",707200,0],["δὲ",703303,11],["τὸ",709436,24],["δόμα",703789,25],["αὐτοῦ",702165,102],["ἀνταποδώσει",701215,127],["αὐτῷ",702165,50]],"He that has pity on the poor lends to the Lord; and he will recompense to him according to his gift."],["18",[["παίδευε",709926,240],["υἱόν",713075,6],["σου",711945,133],["οὕτως",709859,28],["γὰρ",702963,11],["ἔσται",704093,93],["εὔελπις",705572,12],["εἰς",704105,0],["δὲ",703303,11],["ὕβριν",713051,9],["μὴ",708851,28],["ἐπαίρου",705002,253],["τῇ",709436,100],["ψυχῇ",714070,1],["σου",711945,133]],"Chasten thy son, for so he shall be hopeful; and be not exalted in thy soul to haughtiness."],["19",[["κακόφρων",707072,14],["ἀνὴρ",701150,4],["πολλὰ",710646,68],["ζημιωθήσεται",705878,134],["ἐὰν",703912,7],["δὲ",703303,11],["λοιμεύηται",708244,462],["καὶ",707031,7],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["προσθήσει",710965,127]],"A malicious man shall be severely punished, and if he commit injury, he shall also lose his life."],["20",[["ἄκουε",700587,240],["υἱέ",713075,153],["παιδείαν",709924,9],["πατρός",710189,18],["σου",711945,133],["ἵνα",706747,7],["σοφὸς",711985,14],["γένῃ",703104,420],["ἐπ᾿",705080,0],["ἐσχάτων",705519,169],["σου",711945,133]],"Hear, son, the instruction of thy father, that thou mayest be wise at thy latter end."],["21",[["πολλοὶ",710646,138],["λογισμοὶ",708234,52],["ἐν",704639,0],["καρδίᾳ",707141,1],["ἀνδρός",701150,18],["ἡ",709436,10],["δὲ",703303,11],["βουλὴ",702792,12],["τοῦ",709436,35],["κυρίου",707996,18],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["μένει",708736,91]],"[There are] many thoughts in a man's heart; but the counsel of the Lord abides for ever."],["22",[["καρπὸς",707169,4],["ἀνδρὶ",701150,114],["ἐλεημοσύνη",704421,12],["κρείσσων",707891,14],["δὲ",703303,11],["πτωχὸς",711076,4],["δίκαιος",703694,14],["ἢ",705924,7],["πλούσιος",710560,14],["ψεύστης",714046,4]],"Mercy is a fruit to a man: and a poor man is better than a rich liar."],["23",[["φόβος",713534,4],["κυρίου",707996,18],["εἰς",704105,0],["ζωὴν",705910,9],["ἀνδρί",701150,114],["ὁ",709436,3],["δὲ",703303,11],["ἄφοβος",702217,14],["αὐλισθήσεται",702138,134],["ἐν",704639,0],["τόποις",712903,148],["οὗ",709781,48],["οὐκ",709805,28],["ἐπισκοπεῖται",705254,117],["γνῶσις",703138,12]],"The fear of the Lord is life to a man: and he shall lodge without fear in places where knowledge is not seen."],["24",[["ὁ",709436,3],["ἐγκρύπτων",703993,72],["εἰς",704105,0],["τὸν",709436,5],["κόλπον",707800,6],["αὐτοῦ",702165,102],["χεῖρας",713787,39],["ἀδίκως",700273,28],["οὐδὲ",709816,7],["τῷ",709436,53],["στόματι",712125,54],["οὐ",709805,28],["μὴ",708851,28],["προσαγάγῃ",710848,172],["αὐτάς",702165,231]],"He that unjustly hides his hands in his bosom, will not even [bring] them up to his mouth."],["25",[["λοιμοῦ",708245,116],["μαστιγουμένου",708566,262],["ἄφρων",702236,14],["πανουργότερος",709972,224],["γίνεται",703104,117],["ἐὰν",703912,7],["δὲ",703303,11],["ἐλέγχῃς",704416,205],["ἄνδρα",701150,6],["φρόνιμον",713589,27],["νοήσει",709327,127],["αἴσθησιν",700477,9]],"When a pestilent character is scourged, a simple man is made wiser: and if thou reprove a wise man, he will understand discretion."],["26",[["ὁ",709436,3],["ἀτιμάζων",702092,72],["πατέρα",710189,6],["καὶ",707031,7],["ἀπωθούμενος",701659,122],["μητέρα",708892,9],["αὐτοῦ",702165,102],["καταισχυνθήσεται",707257,134],["καὶ",707031,7],["ἐπονείδιστος",705347,14],["ἔσται",704093,93]],"He that dishonours his father, and drives away his mother, shall be disgraced and shall be exposed to reproach."],["27",[["υἱὸς",713075,4],["ἀπολειπόμενος",701508,122],["φυλάξαι",713619,106],["παιδείαν",709924,9],["πατρὸς",710189,18],["μελετήσει",708698,127],["ῥήσεις",711250,39],["κακάς",707066,119]],"A son who ceases to attend to the instruction of a father will cherish evil designs."],["28",[["ὁ",709436,3],["ἐγγυώμενος",703944,122],["παῖδα",709932,6],["ἄφρονα",702236,27],["καθυβρίζει",707023,91],["δικαίωμα",703697,25],["στόμα",712125,15],["δὲ",703303,11],["ἀσεβῶν",701909,169],["καταπίεται",707374,93],["κρίσεις",707908,39]],"He that becomes surety for a foolish child will despise the ordinance: and the mouth of ungodly men shall drink down judgments."],["29",[["ἑτοιμάζονται",705539,269],["ἀκολάστοις",700565,230],["μάστιγες",708568,191],["καὶ",707031,7],["τιμωρίαι",712863,191],["ὤμοις",714114,148],["ἀφρόνων",702236,169]],"Scourges are preparing for the intemperate, and punishments likewise for fools."]]