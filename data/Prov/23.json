[["1",[["ἐὰν",703912,7],["καθίσῃς",707006,175],["δειπνεῖν",703330,55],["ἐπὶ",705080,0],["τραπέζης",712919,17],["δυναστῶν",703844,81],["νοητῶς",709330,28],["νόει",709327,240],["τὰ",709436,41],["παρατιθέμενά",710111,67],["σοι",711925,159]],"If thou sit to sup at the table of a prince, consider attentively the things set before thee:"],["2",[["καὶ",707031,7],["ἐπίβαλλε",705083,240],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133],["εἰδὼς",704075,270],["ὅτι",709803,7],["τοιαῦτά",712878,68],["σε",711598,163],["δεῖ",703312,91],["παρασκευάσαι",710103,106]],"and apply thine hand, knowing that it behoves thee to prepare such [meats]: but if thou art very insatiable,"],["3",[["εἰ",704071,7],["δὲ",703303,11],["ἀπληστότερος",701418,224],["εἶ",704093,154],["μὴ",708851,28],["ἐπιθύμει",705141,240],["τῶν",709436,43],["ἐδεσμάτων",704032,44],["αὐτοῦ",702165,102],["ταῦτα",709858,290],["γὰρ",702963,11],["ἔχεται",705785,117],["ζωῆς",705910,17],["ψευδοῦς",714036,82]],"desire not his provisions; for these belong to a false life."],["4",[["μὴ",708851,28],["παρεκτείνου",710129,733],["πένης",710248,4],["ὢν",704093,72],["πλουσίῳ",710560,30],["τῇ",709436,100],["δὲ",703303,11],["σῇ",711943,101],["ἐννοίᾳ",704764,1],["ἀπόσχου",701225,300]],"If thou art poor, measure not thyself with a rich man; but refrain thyself in thy wisdom."],["5",[["ἐὰν",703912,7],["ἐπιστήσῃς",705756,175],["τὸ",709436,24],["σὸν",711943,46],["ὄμμα",709616,25],["πρὸς",710844,0],["αὐτόν",702165,85],["οὐδαμοῦ",709813,28],["φανεῖται",713311,93],["κατεσκεύασται",707419,187],["γὰρ",702963,11],["αὐτῷ",702165,50],["πτέρυγες",711057,39],["ὥσπερ",714163,28],["ἀετοῦ",700318,18],["καὶ",707031,7],["ὑποστρέφει",713246,91],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["προεστηκότος",710803,310],["αὐτοῦ",702165,102]],"If thou shouldest fix thine eye upon him, he will disappear; for wings like an eagle's are prepared for him, and he returns to the house of his master."],["6",[["μὴ",708851,28],["συνδείπνει",712414,240],["ἀνδρὶ",701150,114],["βασκάνῳ",702589,30],["μηδὲ",708855,7],["ἐπιθύμει",705141,240],["τῶν",709436,43],["βρωμάτων",702823,44],["αὐτοῦ",702165,102]],"Sup not with an envious man, neither desire thou his meats:"],["7",[["ὃν",709781,112],["τρόπον",712980,6],["γὰρ",702963,11],["εἴ",704071,7],["τις",712866,158],["καταπίοι",707374,225],["τρίχα",706312,9],["οὕτως",709859,28],["ἐσθίει",705495,91],["καὶ",707031,7],["πίνει",710478,91]],null,{"s":"j","with":"23:8"}],["8",[["μηδὲ",708855,7],["πρὸς",710844,0],["σὲ",711598,163],["εἰσαγάγῃς",704107,175],["αὐτὸν",702165,85],["καὶ",707031,7],["φάγῃς",713296,175],["τὸν",709436,5],["ψωμόν",714078,6],["σου",711945,133],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἐξεμέσει",704901,127],["γὰρ",702963,11],["αὐτὸν",702165,85],["καὶ",707031,7],["λυμανεῖται",708270,117],["τοὺς",709436,58],["λόγους",708236,57],["σου",711945,133],["τοὺς",709436,58],["καλούς",707097,60]],"so he eats and drinks as if any one should swallow a hair, and do not bring him in to thyself, nor eat thy morsel with him: for he will vomit it up, and spoil thy fair words.",{"s":"m","br":"23:7 23:8","q":0.67}],["9",[["εἰς",704105,0],["ὦτα",709852,25],["ἄφρονος",702236,116],["μηδὲν",708857,46],["λέγε",708124,240],["μήποτε",708882,28],["μυκτηρίσῃ",709052,172],["τοὺς",709436,58],["συνετοὺς",712464,60],["λόγους",708236,57],["σου",711945,133]],"Say nothing in the ears of a fool, lest at any time he sneer at thy wise words."],["10",[["μὴ",708851,28],["μεταθῇς",708820,205],["ὅρια",709749,42],["αἰώνια",700505,68],["εἰς",704105,0],["δὲ",703303,11],["κτῆμα",707933,25],["ὀρφανῶν",709779,169],["μὴ",708851,28],["εἰσέλθῃς",704114,175]],"Remove not the ancient landmarks; and enter not upon the possession of the fatherless:"],["11",[["ὁ",709436,3],["γὰρ",702963,11],["λυτρούμενος",708282,122],["αὐτοὺς",702165,62],["κύριος",707996,4],["κραταιός",707873,14],["ἐστιν",704093,91],["καὶ",707031,7],["κρινεῖ",707905,127],["τὴν",709436,8],["κρίσιν",707908,9],["αὐτῶν",702165,40],["μετὰ",708780,0],["σοῦ",711945,133]],"for the Lord is their redeemer; he is mighty, and will plead their cause with thee."],["12",[["δὸς",703654,176],["εἰς",704105,0],["παιδείαν",709924,9],["τὴν",709436,8],["καρδίαν",707141,9],["σου",711945,133],["τὰ",709436,41],["δὲ",703303,11],["ὦτά",709852,42],["σου",711945,133],["ἑτοίμασον",705539,176],["λόγοις",708236,148],["αἰσθήσεως",700477,17]],"Apply thine heart to instruction, and prepare thine ears for words of discretion."],["13",[["μὴ",708851,28],["ἀπόσχῃ",701225,172],["νήπιον",709295,27],["παιδεύειν",709926,55],["ὅτι",709803,7],["ἐὰν",703912,7],["πατάξῃς",710185,175],["αὐτὸν",702165,85],["ῥάβδῳ",711135,1],["οὐ",709805,28],["μὴ",708851,28],["ἀποθάνῃ",701461,172]],"Refrain not from chastening a child; for if thou beat him with the rod, he shall not die."],["14",[["σὺ",712181,164],["μὲν",708730,11],["γὰρ",702963,11],["πατάξεις",710185,166],["αὐτὸν",702165,85],["ῥάβδῳ",711135,1],["τὴν",709436,8],["δὲ",703303,11],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["ἐκ",704132,0],["θανάτου",706096,18],["ῥύσῃ",711309,123]],"For thou shalt beat him with the rod, and shalt deliver his soul from death."],["15",[["υἱέ",713075,153],["ἐὰν",703912,7],["σοφὴ",711985,29],["γένηταί",703104,239],["σου",711945,133],["ἡ",709436,10],["καρδία",707141,12],["εὐφρανεῖς",705715,166],["καὶ",707031,7],["τὴν",709436,8],["ἐμὴν",704578,36],["καρδίαν",707141,9]],"Son, if thy heart be wise, thou shalt also gladden my heart;"],["16",[["καὶ",707031,7],["ἐνδιατρίψει",704687,127],["λόγοις",708236,148],["τὰ",709436,63],["σὰ",711943,195],["χείλη",713781,64],["πρὸς",710844,0],["τὰ",709436,41],["ἐμὰ",704578,68],["χείλη",713781,42],["ἐὰν",703912,7],["ὀρθὰ",709738,68],["ὦσιν",709852,96]],"and thy lips shall converse with my lips, if they be right."],["17",[["μὴ",708851,28],["ζηλούτω",705873,31],["ἡ",709436,10],["καρδία",707141,12],["σου",711945,133],["ἁμαρτωλούς",700776,60],["ἀλλὰ",700680,7],["ἐν",704639,0],["φόβῳ",713534,114],["κυρίου",707996,18],["ἴσθι",704093,240],["ὅλην",709597,36],["τὴν",709436,8],["ἡμέραν",705984,9]],"Let not thine heart envy sinners: but be thou in the fear of the Lord all the day."],["18",[["ἐὰν",703912,7],["γὰρ",702963,11],["τηρήσῃς",712844,175],["αὐτά",702165,71],["ἔσται",704093,93],["σοι",711925,159],["ἔκγονα",704159,195],["ἡ",709436,10],["δὲ",703303,11],["ἐλπίς",704530,12],["σου",711945,133],["οὐκ",709805,28],["ἀποστήσεται",702214,93]],"For if thou shouldest keep these things, thou shalt have posterity; and thine hope shall not be removed."],["19",[["ἄκουε",700587,240],["υἱέ",713075,153],["καὶ",707031,7],["σοφὸς",711985,14],["γίνου",703104,253],["καὶ",707031,7],["κατεύθυνε",707521,240],["ἐννοίας",704764,39],["σῆς",711943,82],["καρδίας",707141,17]],"Hear, [my] son, and be wise, and rightly direct the thoughts of thine heart."],["20",[["μὴ",708851,28],["ἴσθι",704093,240],["οἰνοπότης",709529,15],["μηδὲ",708855,7],["ἐκτείνου",704322,253],["συμβολαῖς",712287,76],["κρεῶν",707889,44],["τε",712751,11],["ἀγορασμοῖς",700186,148]],"Be not a wine-bibber, neither continue long at feasts, and purchases of flesh:"],["21",[["πᾶς",710177,14],["γὰρ",702963,11],["μέθυσος",708675,14],["καὶ",707031,7],["πορνοκόπος",710677,14],["πτωχεύσει",711074,127],["καὶ",707031,7],["ἐνδύσεται",704701,93],["διερρηγμένα",703565,388],["καὶ",707031,7],["ῥακώδη",711161,42],["πᾶς",710177,14],["ὑπνώδης",713183,14]],"for every drunkard and whoremonger shall be poor; and every sluggard shall clothe himself with tatters and ragged garments."],["22",[["ἄκουε",700587,240],["υἱέ",713075,153],["πατρὸς",710189,18],["τοῦ",709436,35],["γεννήσαντός",703051,500],["σε",711598,163],["καὶ",707031,7],["μὴ",708851,28],["καταφρόνει",707482,240],["ὅτι",709803,7],["γεγήρακέν",703090,171],["σου",711945,133],["ἡ",709436,10],["μήτηρ",708892,12]],"Hearken, [my] son, to thy father which begot thee, and despise not [thy mother] because she is grown old."],["24",[["καλῶς",707106,28],["ἐκτρέφει",704342,91],["πατὴρ",710189,4],["δίκαιος",703694,14],["ἐπὶ",705080,0],["δὲ",703303,11],["υἱῷ",713075,114],["σοφῷ",711985,30],["εὐφραίνεται",705715,117],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτοῦ",702165,102]],"A righteous father brings up [his children] well; and his soul rejoices over a wise son."],["25",[["εὐφραινέσθω",705715,407],["ὁ",709436,3],["πατὴρ",710189,4],["καὶ",707031,7],["ἡ",709436,10],["μήτηρ",708892,12],["ἐπὶ",705080,0],["σοί",711925,159],["καὶ",707031,7],["χαιρέτω",713665,31],["ἡ",709436,10],["τεκοῦσά",712853,149],["σε",711598,163]],"Let thy father and thy mother rejoice over thee, and let her that bore thee be glad."],["26",[["δός",703654,176],["μοι",708974,159],["υἱέ",713075,153],["σὴν",711943,36],["καρδίαν",707141,9],["οἱ",709436,136],["δὲ",703303,11],["σοὶ",711925,159],["ὀφθαλμοὶ",709870,52],["ἐμὰς",704578,119],["ὁδοὺς",709458,39],["τηρείτωσαν",712844,56]],"[My] son, give me thine heart, and let thine eyes observe my ways."],["27",[["πίθος",710467,4],["γὰρ",702963,11],["τετρημένος",712814,251],["ἐστὶν",704093,91],["ἀλλότριος",700699,14],["οἶκος",709516,4],["καὶ",707031,7],["φρέαρ",713576,15],["στενὸν",712068,26],["ἀλλότριον",700699,26]],"For a strange house is a vessel full of holes; and a strange well is narrow."],["28",[["οὗτος",709858,121],["γὰρ",702963,11],["συντόμως",712516,28],["ἀπολεῖται",701513,93],["καὶ",707031,7],["πᾶς",710177,14],["παράνομος",710080,14],["ἀναλωθήσεται",700992,134]],"For such a one shall perish suddenly; and every transgressor shall be cut off."],["29",[["τίνι",712867,432],["οὐαί",709807,88],["τίνι",712867,432],["θόρυβος",706293,4],["τίνι",712867,432],["κρίσις",707908,12],["τίνι",712867,432],["ἀηδίαι",700352,191],["καὶ",707031,7],["λέσχαι",708156,191],["τίνι",712867,432],["συντρίμματα",712521,64],["διὰ",703417,0],["κενῆς",707612,82],["τίνος",712867,340],["πέλειοι",710233,138],["οἱ",709436,136],["ὀφθαλμοί",709870,52]],"Who [has] woe? who trouble? who [has] quarrels? and who vexations and disputes? who [has] bruises without a cause? whose eyes are livid?"],["30",[["οὐ",709805,28],["τῶν",709436,80],["ἐγχρονιζόντων",704016,170],["ἐν",704639,0],["οἴνοις",709530,148],["οὐ",709805,28],["τῶν",709436,80],["ἰχνευόντων",706872,170],["ποῦ",710706,28],["πότοι",710704,52],["γίνονται",703104,269]],"Are not those of them that stay long at wine? [are] not [those] of them that haunt [the places] where banquets are? Be not drunk with wine; but converse with just men, and converse [with them] openly.",{"s":"d","q":0.48}],["31",[["μὴ",708851,28],["μεθύσκεσθε",708673,73],["οἴνῳ",709530,114],["ἀλλὰ",700680,7],["ὁμιλεῖτε",709613,335],["ἀνθρώποις",701163,148],["δικαίοις",703694,230],["καὶ",707031,7],["ὁμιλεῖτε",709613,335],["ἐν",704639,0],["περιπάτοις",710363,148],["ἐὰν",703912,7],["γὰρ",702963,11],["εἰς",704105,0],["τὰς",709436,38],["φιάλας",713453,39],["καὶ",707031,7],["τὰ",709436,41],["ποτήρια",710699,42],["δῷς",703654,175],["τοὺς",709436,58],["ὀφθαλμούς",709870,57],["σου",711945,133],["ὕστερον",713273,28],["περιπατήσεις",710362,166],["γυμνότερος",703202,224],["ὑπέρου",713143,253]],"For if thou shouldest set thine eyes on bowls and cups, thou shalt afterwards go more naked than a pestle.",{"s":"d","q":0.59}],["32",[["τὸ",709436,24],["δὲ",703303,11],["ἔσχατον",705519,46],["ὥσπερ",714163,28],["ὑπὸ",713184,0],["ὄφεως",709875,18],["πεπληγὼς",710550,270],["ἐκτείνεται",704322,117],["καὶ",707031,7],["ὥσπερ",714163,28],["ὑπὸ",713184,0],["κεράστου",707627,18],["διαχεῖται",703636,391],["αὐτῷ",702165,50],["ὁ",709436,3],["ἰός",706764,4]],"But at last [such a one] stretches himself out as one smitten by a serpent, and venom is diffused through him as by a horned serpent."],["33",[["οἱ",709436,136],["ὀφθαλμοί",709870,52],["σου",711945,133],["ὅταν",709801,28],["ἴδωσιν",709725,234],["ἀλλοτρίαν",700699,36],["τὸ",709436,34],["στόμα",712125,15],["σου",711945,133],["τότε",712908,28],["λαλήσει",708071,127],["σκολιά",711868,68]],"Whenever thine eyes shall behold a strange woman, then thy mouth shall speak perverse things."],["34",[["καὶ",707031,7],["κατακείσῃ",707267,123],["ὥσπερ",714163,28],["ἐν",704639,0],["καρδίᾳ",707141,1],["θαλάσσης",706069,17],["καὶ",707031,7],["ὥσπερ",714163,28],["κυβερνήτης",707948,4],["ἐν",704639,0],["πολλῷ",710646,30],["κλύδωνι",707744,114]],"And thou shalt lie as in the midst of the sea, and as a pilot in a great storm."],["35",[["ἐρεῖς",705415,166],["δέ",703303,11],["τύπτουσίν",713022,197],["με",708618,163],["καὶ",707031,7],["οὐκ",709805,28],["ἐπόνεσα",710656,155],["καὶ",707031,7],["ἐνέπαιξάν",704583,150],["μοι",708974,159],["ἐγὼ",704018,164],["δὲ",703303,11],["οὐκ",709805,28],["ᾔδειν",709492,499],["πότε",710696,28],["ὄρθρος",709745,4],["ἔσται",704093,93],["ἵνα",706747,7],["ἐλθὼν",705453,182],["ζητήσω",705879,207],["μεθ᾿",708780,0],["ὧν",709781,252],["συνελεύσομαι",712458,181]],"And thou shalt say, They smote me, and I was not pained; and they mocked me, and I knew it not: when will it be morning, that I may go and seek those with whom I may go in company?"]]