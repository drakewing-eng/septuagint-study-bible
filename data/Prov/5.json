[["1",[["υἱέ",713075,153],["ἐμῇ",704578,101],["σοφίᾳ",711981,1],["πρόσεχε",710895,240],["ἐμοῖς",704578,230],["δὲ",703303,11],["λόγοις",708236,148],["παράβαλλε",709997,240],["σὸν",711943,27],["οὖς",709852,25]],"[My] son, attend to my wisdom, and apply thine ear to my words;"],["2",[["ἵνα",706747,7],["φυλάξῃς",713619,175],["ἔννοιαν",704764,9],["ἀγαθήν",700106,36],["αἴσθησιν",700477,9],["δὲ",703303,11],["ἐμῶν",704578,83],["χειλέων",713781,44],["ἐντέλλομαί",704791,254],["σοι",711925,159]],"that thou mayest keep good understanding, and the discretion of my lips gives thee a charge. Give no heed to a worthless woman;"],["3",[["μὴ",708851,28],["πρόσεχε",710895,240],["φαύλῃ",713398,101],["γυναικί",703209,1],["μέλι",708700,15],["γὰρ",702963,11],["ἀποστάζει",701584,91],["ἀπὸ",701425,0],["χειλέων",713781,44],["γυναικὸς",703209,17],["πόρνης",710675,17],["ἣ",709781,11],["πρὸς",710844,0],["καιρὸν",707047,6],["λιπαίνει",708215,91],["σὸν",711943,27],["φάρυγγα",713375,6]],"for honey drops from the lips of a harlot, who for a season pleases thy palate:"],["4",[["ὕστερον",713273,28],["μέντοι",708734,11],["πικρότερον",710475,61],["χολῆς",713900,17],["εὑρήσεις",705676,166],["καὶ",707031,7],["ἠκονημένον",700570,469],["μᾶλλον",708448,28],["μαχαίρας",708593,17],["διστόμου",703746,82]],"but afterwards thou wilt find her more bitter than gall, and sharper than a two-edged sword."],["5",[["τῆς",709436,16],["γὰρ",702963,11],["ἀφροσύνης",702235,17],["οἱ",709436,136],["πόδες",710707,52],["κατάγουσιν",707232,197],["τοὺς",709436,58],["χρωμένους",713936,236],["αὐτῇ",702165,105],["μετὰ",708780,0],["θανάτου",706096,18],["εἰς",704105,0],["τὸν",709436,5],["ᾅδην",700255,6],["τὰ",709436,41],["δὲ",703303,11],["ἴχνη",706821,42],["αὐτῆς",702165,86],["οὐκ",709805,28],["ἐρείδεται",705405,117]],"For the feet of folly lead those who deal with her down to the grave with death; and her steps are not established."],["6",[["ὁδοὺς",709458,39],["γὰρ",702963,11],["ζωῆς",705910,17],["οὐκ",709805,28],["ἐπέρχεται",705068,117],["σφαλεραὶ",712574,192],["δὲ",703303,11],["αἱ",709436,190],["τροχιαὶ",712992,192],["αὐτῆς",702165,86],["καὶ",707031,7],["οὐκ",709805,28],["εὔγνωστοι",705563,192]],"For she goes not upon the paths of life; but her ways are slippery, and not easily known."],["7",[["νῦν",709384,28],["οὖν",709835,11],["υἱέ",713075,153],["ἄκουέ",700587,240],["μου",709032,133],["καὶ",707031,7],["μὴ",708851,28],["ἀκύρους",700617,60],["ποιήσῃς",710582,175],["ἐμοὺς",704578,60],["λόγους",708236,57]],"Now then, [my] son, hear me, and make not my words of none effect."],["8",[["μακρὰν",708411,28],["ποίησον",710582,176],["ἀπ᾿",701425,0],["αὐτῆς",702165,86],["σὴν",711943,36],["ὁδόν",709458,9],["μὴ",708851,28],["ἐγγίσῃς",703939,175],["πρὸς",710844,0],["θύραις",706337,76],["οἴκων",709516,81],["αὐτῆς",702165,86]],"Remove thy way far from her; draw not near to the doors of her house:"],["9",[["ἵνα",706747,7],["μὴ",708851,28],["πρόῃ",710785,278],["ἄλλοις",700697,151],["ζωήν",705910,9],["σου",711945,133],["καὶ",707031,7],["σὸν",711943,27],["βίον",702724,6],["ἀνελεήμοσιν",701120,230]],"lest thou give away thy life to others, and thy substance to the merciless:"],["10",[["ἵνα",706747,7],["μὴ",708851,28],["πλησθῶσιν",710532,272],["ἀλλότριοι",700699,138],["σῆς",711943,82],["ἰσχύος",706858,17],["οἱ",709436,136],["δὲ",703303,11],["σοὶ",711925,159],["πόνοι",710661,52],["εἰς",704105,0],["οἴκους",709516,57],["ἀλλοτρίων",700699,169],["εἰσέλθωσιν",704114,234]],"lest strangers be filled with thy strength, and thy labours come into the houses of strangers;"],["11",[["καὶ",707031,7],["μεταμεληθήσῃ",708805,364],["ἐπ᾿",705080,0],["ἐσχάτων",705519,169],["ἡνίκα",706008,28],["ἂν",700900,11],["κατατριβῶσιν",707464,272],["σάρκες",711537,191],["σώματός",712635,21],["σου",711945,133]],"and thou repent at last, when the flesh of thy body is consumed,"],["12",[["καὶ",707031,7],["ἐρεῖς",705415,166],["πῶς",711121,28],["ἐμίσησα",708935,155],["παιδείαν",709924,9],["καὶ",707031,7],["ἐλέγχους",704415,57],["ἐξέκλινεν",704220,13],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133]],"and thou shalt say, How have I hated instruction, and my heart avoided reproofs!"],["13",[["οὐκ",709805,28],["ἤκουον",700587,333],["φωνὴν",713640,9],["παιδεύοντός",709926,152],["με",708618,163],["καὶ",707031,7],["διδάσκοντός",703649,152],["με",708618,163],["οὐδὲ",709816,7],["παρέβαλλον",709997,333],["τὸ",709436,24],["οὖς",709852,25],["μου",709032,133]],"I heard not the voice of him that instructed me, and taught me, neither did I apply mine ear."],["14",[["παρ᾿",709995,0],["ὀλίγον",709568,27],["ἐγενόμην",703104,161],["ἐν",704639,0],["παντὶ",710177,97],["κακῷ",707066,97],["ἐν",704639,0],["μέσῳ",708768,97],["ἐκκλησίας",704216,17],["καὶ",707031,7],["συναγωγῆς",712376,17]],"I was almost in all evil in the midst of the congregation and assembly."],["15",[["πῖνε",710478,240],["ὕδατα",713071,25],["ἀπὸ",701425,0],["σῶν",711943,83],["ἀγγείων",700138,44],["καὶ",707031,7],["ἀπὸ",701425,0],["σῶν",711943,83],["φρεάτων",713576,44],["πηγῆς",710450,17]],"Drink waters out of thine own vessels, and out of thine own springing wells."],["16",[["μὴ",708851,28],["ὑπερεκχείσθω",713132,628],["σοι",711925,159],["τὰ",709436,63],["ὕδατα",713071,64],["ἐκ",704132,0],["τῆς",709436,16],["σῆς",711943,82],["πηγῆς",710450,17],["εἰς",704105,0],["δὲ",703303,11],["σὰς",711943,119],["πλατείας",710509,119],["διαπορευέσθω",703551,407],["τὰ",709436,63],["σὰ",711943,195],["ὕδατα",713071,64]],"Let not waters out of thy fountain be spilt by thee, but let thy waters go into thy streets."],["17",[["ἔστω",704093,31],["σοι",711925,159],["μόνῳ",709003,30],["ὑπάρχοντα",713102,242],["καὶ",707031,7],["μηδεὶς",708857,14],["ἀλλότριος",700699,14],["μετασχέτω",708828,45],["σοι",711925,159]],"Let them be only thine own, and let no stranger partake with thee."],["18",[["ἡ",709436,10],["πηγή",710450,12],["σου",711945,133],["τοῦ",709436,20],["ὕδατος",713071,21],["ἔστω",704093,31],["σοι",711925,159],["ἰδία",706493,29],["καὶ",707031,7],["συνευφραίνου",712467,253],["μετὰ",708780,0],["γυναικὸς",703209,17],["τῆς",709436,16],["ἐκ",704132,0],["νεότητός",709258,17],["σου",711945,133]],"Let thy fountain of water be [truly] thine own; and rejoice with the wife of thy youth."],["19",[["ἔλαφος",704398,4],["φιλίας",713474,17],["καὶ",707031,7],["πῶλος",711117,4],["σῶν",711943,198],["χαρίτων",713735,65],["ὁμιλείτω",709613,31],["σοι",711925,159],["ἡ",709436,10],["δὲ",703303,11],["ἰδία",706493,29],["ἡγείσθω",705931,407],["σου",711945,133],["καὶ",707031,7],["συνέστω",712435,31],["σοι",711925,159],["ἐν",704639,0],["παντὶ",710177,30],["καιρῷ",707047,114],["ἐν",704639,0],["γὰρ",702963,11],["τῇ",709436,100],["ταύτης",709858,86],["φιλίᾳ",713474,1],["συμπεριφερόμενος",712330,122],["πολλοστὸς",710620,14],["ἔσῃ",704093,123]],"Let [thy] loving hart and thy graceful colt company with thee, and let her be considered thine own, and be with thee at all times; for ravished with her love thou shalt be greatly increased."],["20",[["μὴ",708851,28],["πολὺς",710646,14],["ἴσθι",704093,240],["πρὸς",710844,0],["ἀλλοτρίαν",700699,36],["μηδὲ",708855,7],["συνέχου",712469,253],["ἀγκάλαις",700162,76],["τῆς",709436,16],["μὴ",708851,28],["ἰδίας",706493,82]],"Be not intimate with a strange woman, neither fold thyself in the arms of a woman not thine own."],["21",[["ἐνώπιον",704823,28],["γάρ",702963,11],["εἰσιν",704093,197],["τῶν",709436,80],["τοῦ",709436,35],["θεοῦ",706192,18],["ὀφθαλμῶν",709870,81],["ὁδοὶ",709458,191],["ἀνδρός",701150,18],["εἰς",704105,0],["δὲ",703303,11],["πάσας",710177,119],["τὰς",709436,38],["τροχιὰς",712992,119],["αὐτοῦ",702165,102],["σκοπεύει",711873,91]],"For the ways of a man are before the eyes of God, and he looks on all his paths."],["22",[["παρανομίαι",710079,191],["ἄνδρα",701150,6],["ἀγρεύουσιν",700188,197],["σειραῖς",711625,76],["δὲ",703303,11],["τῶν",709436,130],["ἑαυτοῦ",703917,102],["ἁμαρτιῶν",700775,65],["ἕκαστος",704133,14],["σφίγγεται",712585,117]],"Iniquities ensnare a man, and every one is bound in the chains of his own sins."],["23",[["οὗτος",709858,121],["τελευτᾷ",712781,91],["μετὰ",708780,0],["ἀπαιδεύτων",701328,169],["ἐκ",704132,0],["δὲ",703303,11],["πλήθους",710529,21],["τῆς",709436,16],["ἑαυτοῦ",703917,102],["βιότητος",702726,17],["ἐξερρίφη",704306,37],["καὶ",707031,7],["ἀπώλετο",701513,23],["δι᾿",703417,0],["ἀφροσύνην",702235,9]],"Such a man dies with the uninstructed; and he is cast forth from the abundance of his own substance, and has perished through folly."]]