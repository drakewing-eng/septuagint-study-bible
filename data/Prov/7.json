[["1",[["υἱέ",713075,153],["φύλασσε",713619,240],["ἐμοὺς",704578,60],["λόγους",708236,57],["τὰς",709436,38],["δὲ",703303,11],["ἐμὰς",704578,119],["ἐντολὰς",704802,39],["κρύψον",707923,176],["παρὰ",709995,0],["σεαυτῷ",711599,50]],"[My] son, keep my words, and hide with thee my commandments."],["1a",[["υἱέ",713075,153],["τίμα",712855,240],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["ἰσχύσεις",706859,166],["πλὴν",710540,28],["δὲ",703303,11],["αὐτοῦ",702165,102],["μὴ",708851,28],["φοβοῦ",713532,253],["ἄλλον",700697,85]],null],["2",[["φύλαξον",713619,176],["ἐμὰς",704578,119],["ἐντολάς",704802,39],["καὶ",707031,7],["βιώσεις",702727,166],["τοὺς",709436,58],["δὲ",703303,11],["ἐμοὺς",704578,60],["λόγους",708236,57],["ὥσπερ",714163,28],["κόρας",707836,39],["ὀμμάτων",709616,44]],"keep my commandments, and thou shalt live; and [keep] my words as the pupils of [thine] eyes."],["3",[["περίθου",710403,300],["δὲ",703303,11],["αὐτοὺς",702165,62],["σοῖς",711943,230],["δακτύλοις",703259,148],["ἐπίγραψον",705110,176],["δὲ",703303,11],["ἐπὶ",705080,0],["τὸ",709436,24],["πλάτος",710507,25],["τῆς",709436,16],["καρδίας",707141,17],["σου",711945,133]],"And bind them on thy fingers, and write [them] on the table of thine heart."],["4",[["εἶπον",705373,176],["τὴν",709436,8],["σοφίαν",711981,9],["σὴν",711943,36],["ἀδελφὴν",700244,9],["εἶναι",704093,55],["τὴν",709436,8],["δὲ",703303,11],["φρόνησιν",713588,9],["γνώριμον",703136,36],["περιποίησαι",710367,300],["σεαυτῷ",711599,50]],"Say that wisdom is thy sister, and gain prudence as an acquaintance for thyself;"],["5",[["ἵνα",706747,7],["σε",711598,163],["τηρήσῃ",712844,172],["ἀπὸ",701425,0],["γυναικὸς",703209,17],["ἀλλοτρίας",700699,82],["καὶ",707031,7],["πονηρᾶς",710660,82],["ἐάν",703912,7],["σε",711598,163],["λόγοις",708236,148],["τοῖς",709436,147],["πρὸς",710844,0],["χάριν",713735,9],["ἐμβάληται",704547,239]],"that she may keep thee from the strange and wicked woman, if she should assail thee with flattering words."],["6",[["ἀπὸ",701425,0],["γὰρ",702963,11],["θυρίδος",706340,17],["ἐκ",704132,0],["τοῦ",709436,35],["οἴκου",709516,18],["αὐτῆς",702165,86],["εἰς",704105,0],["τὰς",709436,38],["πλατείας",710509,119],["παρακύπτουσα",710057,188]],"For she looks from a window out of her house into the streets, at one whom she may see of the senseless ones, a young man void of understanding,"],["7",[["ὃν",709781,112],["ἂν",700900,11],["ἴδῃ",709725,172],["τῶν",709436,80],["ἀφρόνων",702236,169],["τέκνων",712761,81],["νεανίαν",709229,6],["ἐνδεῆ",704671,27],["φρενῶν",713578,65]],"passing by the corner in the passages near her house,"],["8",[["παραπορευόμενον",710094,212],["παρὰ",709995,0],["γωνίαν",703226,9],["ἐν",704639,0],["διόδοις",703716,76],["οἴκων",709516,81],["αὐτῆς",702165,86]],"and speaking, in the dark of the evening,"],["9",[["καὶ",707031,7],["λαλοῦντα",708071,183],["ἐν",704639,0],["σκότει",711889,54],["ἑσπερινῷ",705501,97],["ἡνίκα",706008,28],["ἂν",700900,11],["ἡσυχία",706035,12],["νυκτερινὴ",709375,29],["ᾖ",704093,204],["καὶ",707031,7],["γνοφώδης",703133,29]],"when there happens [to be] the stillness of night and of darkness:"],["10",[["ἡ",709436,10],["δὲ",703303,11],["γυνὴ",703209,12],["συναντᾷ",712394,91],["αὐτῷ",702165,50],["εἶδος",704074,25],["ἔχουσα",705785,188],["πορνικόν",710676,46],["ἣ",709781,177],["ποιεῖ",710582,91],["νέων",709256,169],["ἐξίπτασθαι",704936,110],["καρδίας",707141,17]],"and the woman meets him having the appearance of a harlot, that causes the hearts of young men to flutter."],["11",[["ἀνεπτερωμένη",701041,357],["δέ",703303,11],["ἐστιν",704093,91],["καὶ",707031,7],["ἄσωτος",702066,29],["ἐν",704639,0],["οἴκῳ",709516,114],["δὲ",703303,11],["οὐχ",709805,28],["ἡσυχάζουσιν",706033,197],["οἱ",709436,136],["πόδες",710707,52],["αὐτῆς",702165,86]],"And she is fickle, and debauched, and her feet abide not at home."],["12",[["χρόνον",713969,6],["γάρ",702963,11],["τινα",712866,356],["ἔξω",704983,28],["ῥέμβεται",711228,117],["χρόνον",713969,6],["δὲ",703303,11],["ἐν",704639,0],["πλατείαις",710509,291],["παρὰ",709995,0],["πᾶσαν",710177,36],["γωνίαν",703226,9],["ἐνεδρεύει",704703,91]],"For at one time she wanders without, and at [another] time she lies in wait in the streets, at every corner."],["13",[["εἶτα",704129,28],["ἐπιλαβομένη",705185,357],["ἐφίλησεν",713471,2],["αὐτόν",702165,85],["ἀναιδεῖ",700959,30],["δὲ",703303,11],["προσώπῳ",710986,54],["προσεῖπεν",710881,2],["αὐτῷ",702165,50]],"Then she caught him, and kissed him, and with an impudent face said to him,"],["14",[["θυσία",706345,12],["εἰρηνική",704099,29],["μοί",708974,159],["ἐστιν",704093,91],["σήμερον",711751,28],["ἀποδίδωμι",701449,157],["τὰς",709436,38],["εὐχάς",705726,39],["μου",709032,133]],"I have a peace-offering; to-day I pay my vows:"],["15",[["ἕνεκα",704709,0],["τούτου",709858,102],["ἐξῆλθον",704909,155],["εἰς",704105,0],["συνάντησίν",712397,9],["σοι",711925,159],["ποθοῦσα",710581,188],["τὸ",709436,24],["σὸν",711943,46],["πρόσωπον",710986,25],["εὕρηκά",705676,89],["σε",711598,163]],"therefore I came forth to meet thee, desiring thy face; [and] I have found thee."],["16",[["κειρίαις",707596,76],["τέτακα",712754,89],["τὴν",709436,8],["κλίνην",707737,9],["μου",709032,133],["ἀμφιτάποις",700889,291],["δὲ",703303,11],["ἔστρωκα",712175,89],["τοῖς",709436,147],["ἀπ᾿",701425,0],["Αἰγύπτου",700401,17]],"I have spread my bed with sheets, and I have covered it with double tapestry from Egypt."],["17",[["διέρραγκα",703563,89],["τὴν",709436,8],["κοίτην",707781,9],["μου",709032,133],["κρόκῳ",707913,114],["τὸν",709436,5],["δὲ",703303,11],["οἶκόν",709516,6],["μου",709032,133],["κινναμώμῳ",707683,54]],"I have sprinkled my couch with saffron, and my house with cinnamon."],["18",[["ἐλθὲ",705453,176],["καὶ",707031,7],["ἀπολαύσωμεν",701506,79],["φιλίας",713474,17],["ἕως",705792,28],["ὄρθρου",709745,18],["δεῦρο",703382,28],["καὶ",707031,7],["ἐγκυλισθῶμεν",703999,79],["ἔρωτι",705458,114]],"Come, and let us enjoy love until the morning; come, and let us embrace in love."],["19",[["οὐ",709805,28],["γὰρ",702963,11],["πάρεστιν",710126,91],["ὁ",709436,3],["ἀνήρ",701150,4],["μου",709032,133],["ἐν",704639,0],["οἴκῳ",709516,114],["πεπόρευται",710667,187],["δὲ",703303,11],["ὁδὸν",709458,9],["μακρὰν",708421,36]],"For my husband is not at home, but is gone on a long journey,"],["20",[["ἔνδεσμον",704682,36],["ἀργυρίου",701707,21],["λαβὼν",708076,182],["ἐν",704639,0],["χειρὶ",713787,1],["αὐτοῦ",702165,102],["δι᾿",703417,0],["ἡμερῶν",705984,65],["πολλῶν",710646,198],["ἐπανήξει",705024,127],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["αὐτοῦ",702165,102]],"having taken in his hand a bundle of money: after many days he will return to his house."],["21",[["ἀπεπλάνησεν",701547,2],["δὲ",703303,11],["αὐτὸν",702165,85],["πολλῇ",710646,101],["ὁμιλίᾳ",709614,1],["βρόχοις",702820,148],["τε",712751,11],["τοῖς",709436,147],["ἀπὸ",701425,0],["χειλέων",713781,44],["ἐξώκειλεν",704951,2],["αὐτόν",702165,85]],"So with much converse she prevailed on him to go astray, and with the snares of her lips she forced him from [the right path]."],["22",[["ὁ",709436,3],["δὲ",703303,11],["ἐπηκολούθησεν",705007,2],["αὐτῇ",702165,105],["κεπφωθείς",707618,217],["ὥσπερ",714163,28],["δὲ",703303,11],["βοῦς",702798,4],["ἐπὶ",705080,0],["σφαγὴν",712568,9],["ἄγεται",700209,117],["καὶ",707031,7],["ὥσπερ",714163,28],["κύων",708004,4],["ἐπὶ",705080,0],["δεσμοὺς",703372,57]],"And he followed her, being gently led on, and [that] as an ox is led to the slaughter, and as a dog to bonds, or as a hart shot in the liver with an arrow:"],["23",[["ἢ",705924,7],["ὡς",714148,28],["ἔλαφος",704398,4],["τοξεύματι",712895,114],["πεπληγὼς",710550,270],["εἰς",704105,0],["τὸ",709436,24],["ἧπαρ",706012,25],["σπεύδει",712011,91],["δὲ",703303,11],["ὥσπερ",714163,28],["ὄρνεον",709762,15],["εἰς",704105,0],["παγίδα",709910,9],["οὐκ",709805,28],["εἰδὼς",709492,270],["ὅτι",709803,7],["περὶ",710285,0],["ψυχῆς",714070,17],["τρέχει",712931,91]],"and he hastens as a bird into a snare, not knowing that he is running for [his] life."],["24",[["νῦν",709384,28],["οὖν",709835,11],["υἱέ",713075,153],["ἄκουέ",700587,240],["μου",709032,133],["καὶ",707031,7],["πρόσεχε",710895,240],["ῥήμασιν",711246,96],["στόματός",712125,21],["μου",709032,133]],"Now then, [my] son, hearken to me, and attend to the words of my mouth."],["25",[["μὴ",708851,28],["ἐκκλινάτω",704220,45],["εἰς",704105,0],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτῆς",702165,86],["ἡ",709436,10],["καρδία",707141,12],["σου",711945,133]],"Let not thine heart turn aside to her ways:"],["26",[["πολλοὺς",710646,60],["γὰρ",702963,11],["τρώσασα",712871,149],["καταβέβληκεν",707203,171],["καὶ",707031,7],["ἀναρίθμητοί",701047,138],["εἰσιν",704093,197],["οὓς",709781,298],["πεφόνευκεν",713546,171]],"for she has wounded and cast down many, and those whom she has slain are innumerable."],["27",[["ὁδοὶ",709458,191],["ᾅδου",700255,18],["ὁ",709436,3],["οἶκος",709516,4],["αὐτῆς",702165,86],["κατάγουσαι",707232,306],["εἰς",704105,0],["τὰ",709436,41],["ταμίεια",712700,42],["τοῦ",709436,35],["θανάτου",706096,18]],"Her house is the way of hell, leading down to the chambers of death."]]