[["1",[["υἱὸς",713075,4],["πανοῦργος",709972,14],["ὑπήκοος",713176,4],["πατρί",710189,114],["υἱὸς",713075,4],["δὲ",703303,11],["ἀνήκοος",701144,14],["ἐν",704639,0],["ἀπωλείᾳ",701660,1]],"A wise son is obedient to his father: but a disobedient son will be destroyed."],["2",[["ἀπὸ",701425,0],["καρπῶν",707169,81],["δικαιοσύνης",703695,17],["φάγεται",713296,93],["ἀγαθός",700106,14],["ψυχαὶ",714070,191],["δὲ",703303,11],["παρανόμων",710080,169],["ὀλοῦνται",709584,135],["ἄωροι",702329,192]],"A good [man] shall eat of the fruits of righteousness: but the lives of transgressors shall perish before their time."],["3",[["ὃς",709781,213],["φυλάσσει",713619,91],["τὸ",709436,24],["ἑαυτοῦ",703917,102],["στόμα",712125,25],["τηρεῖ",712844,91],["τὴν",709436,8],["ἑαυτοῦ",703917,102],["ψυχήν",714070,9],["ὁ",709436,3],["δὲ",703303,11],["προπετὴς",710836,14],["χείλεσιν",713781,96],["πτοήσει",711062,127],["ἑαυτόν",703917,85]],"He that keeps his own mouth keeps his own life: but he that is hasty with his lips shall bring terror upon himself."],["4",[["ἐν",704639,0],["ἐπιθυμίαις",705147,76],["ἐστὶν",704093,91],["πᾶς",710177,14],["ἀεργός",700316,14],["χεῖρες",713787,191],["δὲ",703303,11],["ἀνδρείων",701101,169],["ἐν",704639,0],["ἐπιμελείᾳ",705198,1]],"Every slothful man desires, but the hands of the active are diligent."],["5",[["λόγον",708236,6],["ἄδικον",700272,27],["μισεῖ",708935,91],["δίκαιος",703694,14],["ἀσεβὴς",701909,14],["δὲ",703303,11],["αἰσχύνεται",700485,117],["καὶ",707031,7],["οὐχ",709805,28],["ἕξει",704937,1],["παρρησίαν",710173,9]],"A righteous man hates an unjust word: but an ungodly man is ashamed, and will have no confidence."],["6",[["δικαιοσύνη",703695,12],["φυλάσσει",713619,91],["ἀκάκους",700512,60],["τοὺς",709436,58],["δὲ",703303,11],["ἀσεβεῖς",701909,138],["φαύλους",713398,60],["ποιεῖ",710582,91],["ἁμαρτία",700775,12]],null],["7",[["εἰσὶν",704093,197],["οἱ",709436,136],["πλουτίζοντες",710562,146],["ἑαυτοὺς",703917,62],["μηδὲν",708857,46],["ἔχοντες",705785,146],["καὶ",707031,7],["εἰσὶν",704093,197],["οἱ",709436,136],["ταπεινοῦντες",712717,146],["ἑαυτοὺς",703917,62],["ἐν",704639,0],["πολλῷ",710646,30],["πλούτῳ",710563,114]],"There are [some] who, having nothing, enrich themselves: and there are [some] who bring themselves down in [the midst of] much wealth."],["8",[["λύτρον",708281,15],["ἀνδρὸς",701150,18],["ψυχῆς",714070,17],["ὁ",709436,3],["ἴδιος",706493,14],["πλοῦτος",710563,4],["πτωχὸς",711076,4],["δὲ",703303,11],["οὐχ",709805,28],["ὑφίσταται",713281,117],["ἀπειλήν",701375,9]],"A man's own wealth is the ransom of his life: but the poor endures not threatening."],["9",[["φῶς",713642,15],["δικαίοις",703694,230],["διὰ",703417,0],["παντός",710177,116],["φῶς",713642,15],["δὲ",703303,11],["ἀσεβῶν",701909,169],["σβέννυται",711596,391]],"The righteous always have light: but the light of the ungodly is quenched."],["9a",[["ψυχαὶ",714070,191],["δόλιαι",703783,192],["πλανῶνται",710495,269],["ἐν",704639,0],["ἁμαρτίαις",700775,76],["δίκαιοι",703694,138],["δὲ",703303,11],["οἰκτίρουσιν",709518,197],["καὶ",707031,7],["ἐλεῶσιν",704412,271]],null],["10",[["κακὸς",707066,14],["μεθ᾿",708780,0],["ὕβρεως",713051,17],["πράσσει",710721,91],["κακά",707066,68],["οἱ",709436,136],["δὲ",703303,11],["ἑαυτῶν",703917,40],["ἐπιγνώμονες",705106,138],["σοφοί",711985,138]],"A bad man does evil with insolence: but they that are judges of themselves are wise."],["11",[["ὕπαρξις",713101,12],["ἐπισπουδαζομένη",705262,211],["μετὰ",708780,0],["ἀνομίας",701192,17],["ἐλάσσων",704388,14],["γίνεται",703104,117],["ὁ",709436,3],["δὲ",703303,11],["συνάγων",712375,72],["ἑαυτῷ",703917,50],["μετ᾿",708780,0],["εὐσεβείας",705685,17],["πληθυνθήσεται",710530,134],["δίκαιος",703694,14],["οἰκτίρει",709518,91],["καὶ",707031,7],["κιχρᾷ",707700,91]],"Wealth gotten hastily with iniquity is diminished: but he that gathers for himself with godliness shall be increased. The righteous is merciful, and lends."],["12",[["κρείσσων",707891,14],["ἐναρχόμενος",704664,122],["βοηθῶν",702746,72],["καρδίᾳ",707141,1],["τοῦ",709436,35],["ἐπαγγελλομένου",704992,262],["καὶ",707031,7],["εἰς",704105,0],["ἐλπίδα",704530,9],["ἄγοντος",700209,152],["δένδρον",703353,15],["γὰρ",702963,11],["ζωῆς",705910,17],["ἐπιθυμία",705147,12],["ἀγαθή",700106,29]],"Better is he that begins to help heartily, than he that promises and leads [another] to hope: for a good desire is a tree of life."],["13",[["ὃς",709781,213],["καταφρονεῖ",707482,91],["πράγματος",710708,21],["καταφρονηθήσεται",707482,134],["ὑπ᾿",713184,0],["αὐτοῦ",702165,102],["ὁ",709436,3],["δὲ",703303,11],["φοβούμενος",713532,122],["ἐντολήν",704802,9],["οὗτος",709858,121],["ὑγιαίνει",713057,91]],"He that slights a matter shall be slighted of it: but he that fears the commandment has health [of soul]."],["13a",[["υἱῷ",713075,114],["δολίῳ",703783,30],["οὐδὲν",709817,26],["ἔσται",704093,93],["ἀγαθόν",700106,14],["οἰκέτῃ",709496,114],["δὲ",703303,11],["σοφῷ",711985,30],["εὔοδοι",705653,192],["ἔσονται",704093,135],["πράξεις",710714,191],["καὶ",707031,7],["κατευθυνθήσεται",707521,134],["ἡ",709436,10],["ὁδὸς",709458,12],["αὐτοῦ",702165,102]],null],["14",[["νόμος",709349,4],["σοφοῦ",711985,116],["πηγὴ",710450,12],["ζωῆς",705910,17],["ὁ",709436,3],["δὲ",703303,11],["ἄνους",701203,14],["ὑπὸ",713184,0],["παγίδος",709910,17],["θανεῖται",706278,93]],"The law of the wise is a fountain of life: but the man void of understanding shall die by a snare."],["15",[["σύνεσις",712460,12],["ἀγαθὴ",700106,29],["δίδωσιν",703654,91],["χάριν",713735,9],["τὸ",709436,34],["δὲ",703303,11],["γνῶναι",703105,106],["νόμον",709349,6],["διανοίας",703531,17],["ἐστὶν",704093,91],["ἀγαθῆς",700106,82],["ὁδοὶ",709458,191],["δὲ",703303,11],["καταφρονούντων",707482,170],["ἐν",704639,0],["ἀπωλείᾳ",701660,1]],"Sound discretion gives favour, and to know the law is the part of a sound understanding: but the ways of scorners tend to destruction."],["16",[["πᾶς",710177,14],["πανοῦργος",709972,14],["πράσσει",710721,91],["μετὰ",708780,0],["γνώσεως",703138,17],["ὁ",709436,3],["δὲ",703303,11],["ἄφρων",702236,14],["ἐξεπέτασεν",704278,2],["ἑαυτοῦ",703917,102],["κακίαν",707054,9]],"Every prudent man acts with knowledge: but the fool displays his own mischief."],["17",[["βασιλεὺς",702580,4],["θρασὺς",706300,14],["ἐμπεσεῖται",704284,93],["εἰς",704105,0],["κακά",707066,68],["ἄγγελος",700140,4],["δὲ",703303,11],["πιστὸς",710486,14],["ῥύσεται",711309,93],["αὐτόν",702165,85]],"A rash king shall fall into mischief: but a wise messenger shall deliver him."],["18",[["πενίαν",710254,9],["καὶ",707031,7],["ἀτιμίαν",702094,9],["ἀφαιρεῖται",702177,117],["παιδεία",709924,12],["ὁ",709436,3],["δὲ",703303,11],["φυλάσσων",713619,72],["ἐλέγχους",704415,57],["δοξασθήσεται",703792,134]],"Instruction removes poverty and disgrace: but he that attends to reproofs shall be honoured."],["19",[["ἐπιθυμίαι",705147,191],["εὐσεβῶν",705687,169],["ἡδύνουσιν",705943,197],["ψυχήν",714070,9],["ἔργα",705396,64],["δὲ",703303,11],["ἀσεβῶν",701909,169],["μακρὰν",708411,28],["ἀπὸ",701425,0],["γνώσεως",703138,17]],"The desires of the godly gladden the soul, but the works of the ungodly are far from knowledge."],["20",[["ὁ",709436,3],["συμπορευόμενος",712342,122],["σοφοῖς",711985,230],["σοφὸς",711985,14],["ἔσται",704093,93],["ὁ",709436,3],["δὲ",703303,11],["συμπορευόμενος",712342,122],["ἄφροσι",702236,230],["γνωσθήσεται",703105,134]],"If thou walkest with wise men thou shalt be wise: but he that walks with fools shall be known."],["21",[["ἁμαρτάνοντας",700773,235],["καταδιώξεται",707243,93],["κακά",707066,195],["τοὺς",709436,58],["δὲ",703303,11],["δικαίους",703694,60],["καταλήμψεται",707300,93],["ἀγαθά",700106,195]],"Evil shall pursue sinners; but good shall overtake the righteous."],["22",[["ἀγαθὸς",700106,14],["ἀνὴρ",701150,4],["κληρονομήσει",707724,127],["υἱοὺς",713075,57],["υἱῶν",713075,81],["θησαυρίζεται",706256,117],["δὲ",703303,11],["δικαίοις",703694,230],["πλοῦτος",710563,4],["ἀσεβὼν",701909,169]],"A good man shall inherit children's children; and the wealth of ungodly men is laid up for the just."],["23",[["δίκαιοι",703694,138],["ποιήσουσιν",710582,218],["ἐν",704639,0],["πλούτῳ",710563,114],["ἔτη",705543,42],["πολλά",710646,68],["ἄδικοι",700272,138],["δὲ",703303,11],["ἀπολοῦνται",701513,135],["συντόμως",712516,28]],"The righteous shall spend many years in wealth: but the unrighteous shall perish suddenly."],["24",[["ὃς",709781,213],["φείδεται",713406,117],["τῆς",709436,16],["βακτηρίας",702459,17],["μισεῖ",708935,91],["τὸν",709436,5],["υἱὸν",713075,6],["αὐτοῦ",702165,102],["ὁ",709436,3],["δὲ",703303,11],["ἀγαπῶν",700120,72],["ἐπιμελῶς",705200,28],["παιδεύει",709926,91]],"He that spares the rod hates his son: but he that loves, carefully chastens [him]."],["25",[["δίκαιος",703694,14],["ἔσθων",705495,72],["ἐμπιπλᾷ",704592,91],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐτοῦ",702165,102],["ψυχαὶ",714070,191],["δὲ",703303,11],["ἀσεβῶν",701909,169],["ἐνδεεῖς",704671,192]],"A just [man] eats and satisfies his soul: but the souls of the ungodly are in want."]]