[["1",[["ὁ",709436,3],["ἀγαπῶν",700120,72],["παιδείαν",709924,9],["ἀγαπᾷ",700120,91],["αἴσθησιν",700477,9],["ὁ",709436,3],["δὲ",703303,11],["μισῶν",708935,72],["ἐλέγχους",704415,57],["ἄφρων",702236,14]],"He that loves instruction loves sense, but he that hates reproofs is a fool."],["2",[["κρείσσων",707891,14],["ὁ",709436,3],["εὑρὼν",705676,182],["χάριν",713735,9],["παρὰ",709995,0],["κυρίῳ",707996,114],["ἀνὴρ",701150,4],["δὲ",703303,11],["παράνομος",710080,14],["παρασιωπηθήσεται",710102,134]],"He that has found favour with the Lord [is made] better; but a transgressor shall be passed over in silence."],["3",[["οὐ",709805,28],["κατορθώσει",707548,127],["ἄνθρωπος",701163,4],["ἐξ",704132,0],["ἀνόμου",701194,116],["αἱ",709436,190],["δὲ",703303,11],["ῥίζαι",711260,191],["τῶν",709436,80],["δικαίων",703694,169],["οὐκ",709805,28],["ἐξαρθήσονται",704839,144]],"A man shall not prosper by wickedness; but the roots of the righteous shall not be taken up."],["4",[["γυνὴ",703209,12],["ἀνδρεία",701101,29],["στέφανος",712083,4],["τῷ",709436,113],["ἀνδρὶ",701150,114],["αὐτῆς",702165,86],["ὥσπερ",714163,28],["δὲ",703303,11],["ἐν",704639,0],["ξύλῳ",709427,54],["σκώληξ",711905,4],["οὕτως",709859,28],["ἄνδρα",701150,6],["ἀπόλλυσιν",701513,91],["γυνὴ",703209,12],["κακοποιός",707064,29]],"A virtuous woman is a crown to her husband; but as a worm in wood, so a bad woman destroys her husband."],["5",[["λογισμοὶ",708234,52],["δικαίων",703694,169],["κρίματα",707903,64],["κυβερνῶσιν",707946,197],["δὲ",703303,11],["ἀσεβεῖς",701909,60],["δόλους",703787,57]],"The thoughts of the righteous [are true] judgments; but ungodly men devise deceits."],["6",[["λόγοι",708236,52],["ἀσεβῶν",701909,169],["δόλιοι",703783,138],["στόμα",712125,15],["δὲ",703303,11],["ὀρθῶν",709738,169],["ῥύσεται",711309,93],["αὐτούς",702165,62]],"The words of ungodly men are crafty; but the mouth of the upright shall deliver them."],["7",[["οὗ",709781,48],["ἐὰν",703912,7],["στραφῇ",712160,384],["ἀσεβὴς",701909,14],["ἀφανίζεται",702182,117],["οἶκοι",709516,52],["δὲ",703303,11],["δικαίων",703694,169],["παραμένουσιν",710071,197]],"When the ungodly is overthrown, he vanishes away; but the houses of the just remain."],["8",[["στόμα",712125,15],["συνετοῦ",712464,116],["ἐγκωμιάζεται",704002,117],["ὑπὸ",713184,0],["ἀνδρός",701150,18],["νωθροκάρδιος",709397,14],["δὲ",703303,11],["μυκτηρίζεται",709052,391]],"The mouth of an understanding [man] is praised by a man; but he that is dull of heart is had in derision."],["9",[["κρείσσων",707891,14],["ἀνὴρ",701150,4],["ἐν",704639,0],["ἀτιμίᾳ",702094,1],["δουλεύων",703814,72],["ἑαυτῷ",703917,50],["ἢ",705924,7],["τιμὴν",712856,9],["ἑαυτῷ",703917,50],["περιτιθεὶς",710403,72],["καὶ",707031,7],["προσδεόμενος",710873,122],["ἄρτου",701829,18]],"Better is a man in dishonour serving himself, than one honouring himself and wanting bread."],["10",[["δίκαιος",703694,14],["οἰκτίρει",709518,91],["ψυχὰς",714070,39],["κτηνῶν",707934,44],["αὐτοῦ",702165,102],["τὰ",709436,63],["δὲ",703303,11],["σπλάγχνα",712018,64],["τῶν",709436,80],["ἀσεβῶν",701909,169],["ἀνελεήμονα",701120,195]],"A righteous man has pity for the lives of his cattle; but the bowels of the ungodly are unmerciful."],["11",[["ὁ",709436,3],["ἐργαζόμενος",705383,122],["τὴν",709436,8],["ἑαυτοῦ",703917,102],["γῆν",703083,9],["ἐμπλησθήσεται",704592,134],["ἄρτων",701829,81],["οἱ",709436,136],["δὲ",703303,11],["διώκοντες",703768,146],["μάταια",708575,68],["ἐνδεεῖς",704671,138],["φρενῶν",713578,65]],"He that tills his own land shall be satisfied with bread; but they that pursue vanities are void of understanding."],["11a",[["ὅς",709781,213],["ἐστιν",704093,91],["ἡδὺς",705945,14],["ἐν",704639,0],["οἴνων",709530,81],["διατριβαῖς",703615,76],["ἐν",704639,0],["τοῖς",709436,147],["ἑαυτοῦ",703917,102],["ὀχυρώμασιν",709891,96],["καταλείψει",707305,127],["ἀτιμίαν",702094,9]],null],["12",[["ἐπιθυμίαι",705147,191],["ἀσεβῶν",701909,169],["κακαί",707066,192],["αἱ",709436,190],["δὲ",703303,11],["ῥίζαι",711260,191],["τῶν",709436,80],["εὐσεβῶν",705687,169],["ἐν",704639,0],["ὀχυρώμασιν",709891,96]],"The desires of the ungodly are evil; but the roots of the godly are firmly set."],["13",[["δι᾿",703417,0],["ἁμαρτίαν",700775,9],["χειλέων",713781,44],["ἐμπίπτει",704593,91],["εἰς",704105,0],["παγίδας",709910,39],["ἁμαρτωλός",700776,14],["ἐκφεύγει",704357,91],["δὲ",703303,11],["ἐξ",704132,0],["αὐτῶν",702165,40],["δίκαιος",703694,14]],"For the sin of [his] lips a sinner falls into snares; but a righteous man escapes from them."],["13a",[["ὁ",709436,3],["βλέπων",702740,72],["λεῖα",708129,68],["ἐλεηθήσεται",704418,134],["ὁ",709436,3],["δὲ",703303,11],["συναντῶν",712394,72],["ἐν",704639,0],["πύλαις",711082,76],["ἐκθλίψει",704199,127],["ψυχάς",714070,39]],null],["14",[["ἀπὸ",701425,0],["καρπῶν",707169,81],["στόματος",712125,21],["ψυχὴ",714070,12],["ἀνδρὸς",701150,18],["πλησθήσεται",710532,134],["ἀγαθῶν",700106,169],["ἀνταπόδομα",701216,64],["δὲ",703303,11],["χειλέων",713781,44],["αὐτοῦ",702165,102],["δοθήσεται",703654,134],["αὐτῷ",702165,50]],"The soul of a man shall be filled with good from the fruits of his mouth; and the recompence of his lips shall be given to him."],["15",[["ὁδοὶ",709458,191],["ἀφρόνων",702236,169],["ὀρθαὶ",709738,192],["ἐνώπιον",704823,28],["αὐτῶν",702165,40],["εἰσακούει",704108,91],["δὲ",703303,11],["συμβουλίας",712293,39],["σοφός",711985,14]],"The ways of fools are right in their own eyes; but a wise man hearkens to counsels."],["16",[["ἄφρων",702236,14],["αὐθημερὸν",702130,28],["ἐξαγγέλλει",704829,91],["ὀργὴν",709728,9],["αὐτοῦ",702165,102],["κρύπτει",707923,91],["δὲ",703303,11],["τὴν",709436,8],["ἑαυτοῦ",703917,102],["ἀτιμίαν",702094,9],["πανοῦργος",709972,14]],"A fool declares his wrath the same day; but a prudent man hides his own disgrace."],["17",[["ἐπιδεικνυμένην",705112,173],["πίστιν",710484,9],["ἀπαγγέλλει",701321,91],["δίκαιος",703694,14],["ὁ",709436,3],["δὲ",703303,11],["μάρτυς",708527,4],["τῶν",709436,80],["ἀδίκων",700272,169],["δόλιος",703783,14]],"A righteous man declares the open truth; but an unjust witness is deceitful."],["18",[["εἰσὶν",704093,197],["οἳ",709781,250],["λέγοντες",708124,146],["τιτρώσκουσιν",712871,197],["μαχαίρᾳ",708593,1],["γλῶσσαι",703120,191],["δὲ",703303,11],["σοφῶν",711985,169],["ἰῶνται",706424,269]],"Some wound as they speak, [like] swords; but the tongues of the wise heal."],["19",[["χείλη",713781,42],["ἀληθινὰ",700659,68],["κατορθοῖ",707548,91],["μαρτυρίαν",708524,9],["μάρτυς",708527,4],["δὲ",703303,11],["ταχὺς",712750,14],["γλῶσσαν",703120,9],["ἔχει",705785,91],["ἄδικον",700272,36]],"True lips establish testimony; but a hasty witness has an unjust tongue."],["20",[["δόλος",703787,4],["ἐν",704639,0],["καρδίᾳ",707141,1],["τεκταινομένου",712764,262],["κακά",707066,68],["οἱ",709436,136],["δὲ",703303,11],["βουλόμενοι",702795,348],["εἰρήνην",704098,9],["εὐφρανθήσονται",705715,144]],"[There is] deceit in the heart of him that imagines evil; but they that love peace shall rejoice."],["21",[["οὐκ",709805,28],["ἀρέσει",701724,127],["τῷ",709436,113],["δικαίῳ",703694,30],["οὐδὲν",709817,26],["ἄδικον",700272,26],["οἱ",709436,136],["δὲ",703303,11],["ἀσεβεῖς",701909,138],["πλησθήσονται",710532,144],["κακῶν",707066,169]],"No injustice will please a just man; but the ungodly will be filled with mischief."],["22",[["βδέλυγμα",702604,15],["κυρίῳ",707996,114],["χείλη",713781,64],["ψευδῆ",714036,195],["ὁ",709436,3],["δὲ",703303,11],["ποιῶν",710582,72],["πίστεις",710484,39],["δεκτὸς",703348,14],["παρ᾿",709995,0],["αὐτῷ",702165,50]],"Lying lips are an abomination to the Lord; but he that deals faithfully is accepted with him."],["23",[["ἀνὴρ",701150,4],["συνετὸς",712464,14],["θρόνος",706315,4],["αἰσθήσεως",700477,17],["καρδία",707141,12],["δὲ",703303,11],["ἀφρόνων",702236,169],["συναντήσεται",712394,93],["ἀραῖς",701665,76]],"An understanding man is a throne of wisdom; but the heart of fools shall meet with curses."],["24",[["χεὶρ",713787,12],["ἐκλεκτῶν",704240,169],["κρατήσει",707879,127],["εὐχερῶς",705725,28],["δόλιοι",703783,138],["δὲ",703303,11],["ἔσονται",704093,135],["εἰς",704105,0],["προνομήν",710827,9]],"The hand of chosen men shall easily obtain rule; but the deceitful shall be for a prey."],["25",[["φοβερὸς",713530,14],["λόγος",708236,4],["καρδίαν",707141,9],["ταράσσει",712721,91],["ἀνδρὸς",701150,18],["δικαίου",703694,116],["ἀγγελία",700139,12],["δὲ",703303,11],["ἀγαθὴ",700106,29],["εὐφραίνει",705715,91],["αὐτόν",702165,85]],"A terrible word troubles the heart of a righteous man; but a good message rejoices him."],["26",[["ἐπιγνώμων",705106,4],["δίκαιος",703694,14],["ἑαυτοῦ",703917,102],["φίλος",713492,14],["ἔσται",704093,93],["αἱ",709436,190],["δὲ",703303,11],["γνῶμαι",703134,191],["τῶν",709436,80],["ἀσεβῶν",701909,169],["ἀνεπιεικεῖς",701130,192],["ἁμαρτάνοντας",700773,235],["καταδιώξεται",707243,93],["κακά",707066,68],["ἡ",709436,10],["δὲ",703303,11],["ὁδὸς",709458,12],["τῶν",709436,80],["ἀσεβῶν",701909,169],["πλανήσει",710495,127],["αὐτούς",702165,62]],"A just arbitrator shall be his own friend; but mischief shall pursue sinners; and the way of ungodly men shall lead them astray."],["27",[["οὐκ",709805,28],["ἐπιτεύξεται",705315,93],["δόλιος",703783,14],["θήρας",706244,17],["κτῆμα",707933,25],["δὲ",703303,11],["τίμιον",712858,27],["ἀνὴρ",701150,4],["καθαρός",706988,14]],"A deceitful man shall catch no game; but a blameless man is a precious possession."],["28",[["ἐν",704639,0],["ὁδοῖς",709458,76],["δικαιοσύνης",703695,17],["ζωή",705910,12],["ὁδοὶ",709458,191],["δὲ",703303,11],["μνησικάκων",708968,169],["εἰς",704105,0],["θάνατον",706096,6]],"In the ways of righteousness is life; but the ways of those that remember injuries [lead] to death."]]