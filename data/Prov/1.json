[["1",[["παροιμίαι",710160,191],["Σαλωμῶντος",711430,18],["υἱοῦ",713075,18],["Δαυιδ",703232,18],["ὃς",709781,213],["ἐβασίλευσεν",702581,2],["ἐν",704639,0],["Ισραηλ",706839,114]],"The Proverbs of Solomon son of David, who reigned in Israel;"],["2",[["γνῶναι",703105,106],["σοφίαν",711981,9],["καὶ",707031,7],["παιδείαν",709924,9],["νοῆσαί",709327,106],["τε",712751,7],["λόγους",708236,57],["φρονήσεως",713588,17]],"to know wisdom and instruction, and to perceive words of understanding;"],["3",[["δέξασθαί",703393,109],["τε",712751,7],["στροφὰς",712169,39],["λόγων",708236,81],["νοῆσαί",709327,106],["τε",712751,7],["δικαιοσύνην",703695,9],["ἀληθῆ",700658,36],["καὶ",707031,7],["κρίμα",707903,25],["κατευθύνειν",707521,55]],"to receive also hard sayings, and to understand true justice, and [how] to direct judgment;"],["4",[["ἵνα",706747,7],["δῷ",703654,172],["ἀκάκοις",700512,230],["πανουργίαν",709971,9],["παιδὶ",709932,114],["δὲ",703303,11],["νέῳ",709256,30],["αἴσθησίν",700477,9],["τε",712751,11],["καὶ",707031,7],["ἔννοιαν",704764,9]],"that he might give subtlety to the simple, and to the young man discernment and understanding."],["5",[["τῶνδε",709446,284],["γὰρ",702963,11],["ἀκούσας",700587,182],["σοφὸς",711985,14],["σοφώτερος",711985,224],["ἔσται",704093,93],["ὁ",709436,3],["δὲ",703303,11],["νοήμων",709329,14],["κυβέρνησιν",707947,6],["κτήσεται",707932,93]],"For by the hearing of these a wise man will be wiser, and the man of understanding will gain direction;"],["6",[["νοήσει",709327,127],["τε",712751,7],["παραβολὴν",710003,9],["καὶ",707031,7],["σκοτεινὸν",711885,27],["λόγον",708236,6],["ῥήσεις",711250,39],["τε",712751,7],["σοφῶν",711985,169],["καὶ",707031,7],["αἰνίγματα",700460,42]],"and will understand a parable, and a dark speech; the sayings of the wise also, and riddles."],["7",[["ἀρχὴ",701836,12],["σοφίας",711981,17],["φόβος",713534,4],["θεοῦ",706192,18],["σύνεσις",712460,12],["δὲ",703303,11],["ἀγαθὴ",700106,29],["πᾶσι",710177,230],["τοῖς",709436,147],["ποιοῦσιν",710582,349],["αὐτήν",702165,104],["εὐσέβεια",705685,12],["δὲ",703303,11],["εἰς",704105,0],["θεὸν",706192,6],["ἀρχὴ",701836,12],["αἰσθήσεως",700477,17],["σοφίαν",711981,9],["δὲ",703303,11],["καὶ",707031,7],["παιδείαν",709924,9],["ἀσεβεῖς",701909,138],["ἐξουθενήσουσιν",704973,218]],"The fear of the Lord is the beginning of wisdom; and [there is] good understanding to all that practise it: and piety toward God is the beginning of discernment; but the ungodly will set at nought wisdom and instruction."],["8",[["ἄκουε",700587,240],["υἱέ",713075,153],["παιδείαν",709924,9],["πατρός",710189,18],["σου",711945,133],["καὶ",707031,7],["μὴ",708851,28],["ἀπώσῃ",701659,172],["θεσμοὺς",706224,57],["μητρός",708892,17],["σου",711945,133]],"Hear, [my] son, the instruction of thy father, and reject not the rules of thy mother."],["9",[["στέφανον",712083,6],["γὰρ",702963,11],["χαρίτων",713735,65],["δέξῃ",703393,420],["σῇ",711943,101],["κορυφῇ",707844,1],["καὶ",707031,7],["κλοιὸν",707741,6],["χρύσεον",713971,27],["περὶ",710285,0],["σῷ",711943,30],["τραχήλῳ",712924,114]],"For thou shalt receive for thine head a crown of graces, and a chain of gold round thy neck."],["10",[["υἱέ",713075,153],["μή",708851,28],["σε",711598,163],["πλανήσωσιν",710495,234],["ἄνδρες",701150,52],["ἀσεβεῖς",701909,138],["μηδὲ",708855,7],["βουληθῇς",702795,279],["ἐὰν",703912,7],["παρακαλέσωσί",710039,234],["σε",711598,163],["λέγοντες",708124,146]],"[My] son, let not ungodly men lead thee astray, neither consent thou [to them].",{"s":"d","q":0.67}],["11",[["ἐλθὲ",705453,240],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["κοινώνησον",707775,176],["αἵματος",700442,21],["κρύψωμεν",707923,79],["δὲ",703303,11],["εἰς",704105,0],["γῆν",703083,9],["ἄνδρα",701150,6],["δίκαιον",703694,27],["ἀδίκως",700273,28]],"If they should exhort thee, saying, Come with us, partake in blood, and let us unjustly hide the just man in the earth:"],["12",[["καταπίωμεν",707374,79],["δὲ",703303,11],["αὐτὸν",702165,85],["ὥσπερ",714163,28],["ᾅδης",700255,4],["ζῶντα",705851,183],["καὶ",707031,7],["ἄρωμεν",700473,79],["αὐτοῦ",702165,102],["τὴν",709436,8],["μνήμην",708964,9],["ἐκ",704132,0],["γῆς",703083,17]],"and let us swallow him alive, as Hades [would], and remove the memorial of him from the earth:"],["13",[["τὴν",709436,8],["κτῆσιν",707937,9],["αὐτοῦ",702165,102],["τὴν",709436,8],["πολυτελῆ",710647,36],["καταλαβώμεθα",707300,276],["πλήσωμεν",710532,79],["δὲ",703303,11],["οἴκους",709516,57],["ἡμετέρους",705987,60],["σκύλων",711902,44]],"let us seize on his valuable property, and let us fill our houses with spoils:"],["14",[["τὸν",709436,5],["δὲ",703303,11],["σὸν",711943,27],["κλῆρον",707727,6],["βάλε",702487,176],["ἐν",704639,0],["ἡμῖν",705994,90],["κοινὸν",707772,46],["δὲ",703303,11],["βαλλάντιον",702486,25],["κτησώμεθα",707932,276],["πάντες",710177,138],["καὶ",707031,7],["μαρσίππιον",708521,25],["ἓν",704106,46],["γενηθήτω",703104,22],["ἡμῖν",705994,90]],"but do thou cast in thy lot with us, and let us all provide a common purse, and let us have one pouch:"],["15",[["μὴ",708851,28],["πορευθῇς",710667,279],["ἐν",704639,0],["ὁδῷ",709458,114],["μετ᾿",708780,0],["αὐτῶν",702165,40],["ἔκκλινον",704220,176],["δὲ",703303,11],["τὸν",709436,5],["πόδα",710707,6],["σου",711945,133],["ἐκ",704132,0],["τῶν",709436,130],["τρίβων",712939,65],["αὐτῶν",702165,40]],"go not in the way with them, but turn aside thy foot from their paths:"],["16",[["οἱ",709436,136],["γὰρ",702963,11],["πόδες",710707,52],["αὐτῶν",702165,40],["εἰς",704105,0],["κακίαν",707054,9],["τρέχουσιν",712931,197],["καὶ",707031,7],["ταχινοὶ",712744,138],["τοῦ",709436,20],["ἐκχέαι",704368,106],["αἷμα",700442,25]],null],["17",[["οὐ",709805,28],["γὰρ",702963,11],["ἀδίκως",700273,28],["ἐκτείνεται",704322,117],["δίκτυα",703703,42],["πτερωτοῖς",711059,94]],"for nets are not without cause spread for birds."],["18",[["αὐτοὶ",702165,201],["γὰρ",702963,11],["οἱ",709436,136],["φόνου",713549,18],["μετέχοντες",708828,146],["θησαυρίζουσιν",706256,197],["ἑαυτοῖς",703917,151],["κακά",707066,68],["ἡ",709436,10],["δὲ",703303,11],["καταστροφὴ",707445,12],["ἀνδρῶν",701150,81],["παρανόμων",710080,169],["κακή",707066,29]],"For they that are concerned in murder store up evils for themselves; and the overthrow of transgressors is evil."],["19",[["αὗται",709858,202],["αἱ",709436,190],["ὁδοί",709458,191],["εἰσιν",704093,197],["πάντων",710177,169],["τῶν",709436,80],["συντελούντων",712510,170],["τὰ",709436,41],["ἄνομα",701194,68],["τῇ",709436,100],["γὰρ",702963,11],["ἀσεβείᾳ",701904,1],["τὴν",709436,8],["ἑαυτῶν",703917,70],["ψυχὴν",714070,9],["ἀφαιροῦνται",702177,269]],"These are the ways of all that perform lawless deeds; for by ungodliness they destroy their own life."],["20",[["σοφία",711981,12],["ἐν",704639,0],["ἐξόδοις",704948,76],["ὑμνεῖται",713085,117],["ἐν",704639,0],["δὲ",703303,11],["πλατείαις",710509,291],["παρρησίαν",710173,9],["ἄγει",700209,91]],"Wisdom sings aloud in passages, and in the broad places speaks boldly."],["21",[["ἐπ᾿",705080,0],["ἄκρων",700608,83],["δὲ",703303,11],["τειχέων",712759,44],["κηρύσσεται",707662,117],["ἐπὶ",705080,0],["δὲ",703303,11],["πύλαις",711082,76],["δυναστῶν",703844,81],["παρεδρεύει",710123,91],["ἐπὶ",705080,0],["δὲ",703303,11],["πύλαις",711082,76],["πόλεως",710612,17],["θαρροῦσα",706122,188],["λέγει",708124,91]],"And she makes proclamation on the top of the walls, and sits by the gates of princes; and at the gates of the city boldly says,"],["22",[["ὅσον",709788,27],["ἂν",700900,11],["χρόνον",713969,6],["ἄκακοι",700512,138],["ἔχωνται",705785,380],["τῆς",709436,16],["δικαιοσύνης",703695,17],["οὐκ",709805,28],["αἰσχυνθήσονται",700485,144],["οἱ",709436,136],["δὲ",703303,11],["ἄφρονες",702236,138],["τῆς",709436,16],["ὕβρεως",713051,17],["ὄντες",704093,146],["ἐπιθυμηταί",705145,52],["ἀσεβεῖς",701909,138],["γενόμενοι",703104,317],["ἐμίσησαν",708935,150],["αἴσθησιν",700477,9]],"So long as the simple cleave to justice, they shall not be ashamed: but the foolish being lovers of haughtiness, having become ungodly have hated knowledge, and are become subject to reproofs."],["23",[["καὶ",707031,7],["ὑπεύθυνοι",713173,52],["ἐγένοντο",703104,189],["ἐλέγχοις",704415,148],["ἰδοὺ",706497,88],["προήσομαι",710802,181],["ὑμῖν",713084,90],["ἐμῆς",704578,82],["πνοῆς",710574,17],["ῥῆσιν",711250,9],["διδάξω",703649,165],["δὲ",703303,11],["ὑμᾶς",713080,194],["τὸν",709436,5],["ἐμὸν",704578,27],["λόγον",708236,6]],"Behold, I will bring forth to you the utterance of my breath, and I will instruct you in my speech."],["24",[["ἐπειδὴ",705056,7],["ἐκάλουν",707084,333],["καὶ",707031,7],["οὐχ",709805,28],["ὑπηκούσατε",713096,265],["καὶ",707031,7],["ἐξέτεινον",704322,333],["λόγους",708236,57],["καὶ",707031,7],["οὐ",709805,28],["προσείχετε",710895,399]],"Since I called, and ye did not hearken; and I spoke at length, and ye gave no heed;"],["25",[["ἀλλὰ",700680,7],["ἀκύρους",700617,119],["ἐποιεῖτε",710582,399],["ἐμὰς",704578,119],["βουλάς",702792,39],["τοῖς",709436,147],["δὲ",703303,11],["ἐμοῖς",704578,230],["ἐλέγχοις",704415,148],["ἠπειθήσατε",701370,265]],"but ye set at nought my counsels, and disregarded my reproofs;"],["26",[["τοιγαροῦν",712874,11],["κἀγὼ",706969,288],["τῇ",709436,100],["ὑμετέρᾳ",713083,101],["ἀπωλείᾳ",701660,1],["ἐπιγελάσομαι",705101,181],["καταχαροῦμαι",707488,181],["δέ",703303,11],["ἡνίκα",706008,28],["ἂν",700900,11],["ἔρχηται",705453,428],["ὑμῖν",713084,90],["ὄλεθρος",709563,4]],"therefore I also will laugh at your destruction; and I will rejoice against [you] when ruin comes upon you:"],["27",[["καὶ",707031,7],["ὡς",714148,28],["ἂν",700900,11],["ἀφίκηται",702212,239],["ὑμῖν",713084,90],["ἄφνω",702215,28],["θόρυβος",706293,4],["ἡ",709436,10],["δὲ",703303,11],["καταστροφὴ",707445,12],["ὁμοίως",709630,28],["καταιγίδι",707254,1],["παρῇ",710126,204],["καὶ",707031,7],["ὅταν",709801,28],["ἔρχηται",705453,428],["ὑμῖν",713084,90],["θλῖψις",706276,12],["καὶ",707031,7],["πολιορκία",710610,12],["ἢ",705924,7],["ὅταν",709801,28],["ἔρχηται",705453,428],["ὑμῖν",713084,90],["ὄλεθρος",709563,4]],"yea when dismay suddenly comes upon you, and [your] overthrow shall arrive like a tempest; and when tribulation and distress shall come upon you, or when ruin shall come upon you."],["28",[["ἔσται",704093,93],["γὰρ",702963,11],["ὅταν",709801,28],["ἐπικαλέσησθέ",705153,142],["με",708618,163],["ἐγὼ",704018,164],["δὲ",703303,11],["οὐκ",709805,28],["εἰσακούσομαι",704108,181],["ὑμῶν",713091,145],["ζητήσουσίν",705879,218],["με",708618,163],["κακοὶ",707066,138],["καὶ",707031,7],["οὐχ",709805,28],["εὑρήσουσιν",705676,218]],"For it shall be that when ye call upon me, I will not hearken to you: wicked men shall seek me, but shall not find [me]."],["29",[["ἐμίσησαν",708935,150],["γὰρ",702963,11],["σοφίαν",711981,9],["τὸν",709436,5],["δὲ",703303,11],["φόβον",713534,6],["τοῦ",709436,35],["κυρίου",707996,18],["οὐ",709805,28],["προείλαντο",710752,189]],"For they hated wisdom, and did not choose the word of the Lord:"],["30",[["οὐδὲ",709816,7],["ἤθελον",706176,137],["ἐμαῖς",704578,291],["προσέχειν",710895,55],["βουλαῖς",702792,76],["ἐμυκτήριζον",709052,137],["δὲ",703303,11],["ἐμοὺς",704578,60],["ἐλέγχους",704415,57]],"neither would they attend to my counsels, but derided my reproofs."],["31",[["τοιγαροῦν",712874,11],["ἔδονται",705495,135],["τῆς",709436,16],["ἑαυτῶν",703917,40],["ὁδοῦ",709458,17],["τοὺς",709436,58],["καρποὺς",707169,57],["καὶ",707031,7],["τῆς",709436,16],["ἑαυτῶν",703917,284],["ἀσεβείας",701904,17],["πλησθήσονται",710532,144]],"Therefore shall they eat the fruits of their own way, and shall be filled with their own ungodliness."],["32",[["ἀνθ᾿",701227,0],["ὧν",709781,252],["γὰρ",702963,11],["ἠδίκουν",700269,137],["νηπίους",709295,60],["φονευθήσονται",713546,144],["καὶ",707031,7],["ἐξετασμὸς",704913,4],["ἀσεβεῖς",701909,60],["ὀλεῖ",709584,127]],"For because they wronged the simple, they shall be slain; and an inquisition shall ruin the ungodly."],["33",[["ὁ",709436,3],["δὲ",703303,11],["ἐμοῦ",704580,133],["ἀκούων",700587,72],["κατασκηνώσει",707423,127],["ἐπ᾿",705080,0],["ἐλπίδι",704530,1],["καὶ",707031,7],["ἡσυχάσει",706033,127],["ἀφόβως",702218,28],["ἀπὸ",701425,0],["παντὸς",710177,92],["κακοῦ",707066,92]],"But he that hearkens to me shall dwell in confidence, and shall rest securely from all evil."]]