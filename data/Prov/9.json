[["1",[["ἡ",709436,10],["σοφία",711981,12],["ᾠκοδόμησεν",709509,2],["ἑαυτῇ",703917,105],["οἶκον",709516,6],["καὶ",707031,7],["ὑπήρεισεν",713131,2],["στύλους",712179,57],["ἑπτά",705357,59]],"Wisdom has built a house for herself, and set up seven pillars."],["2",[["ἔσφαξεν",712571,2],["τὰ",709436,41],["ἑαυτῆς",703917,86],["θύματα",706327,42],["ἐκέρασεν",707623,2],["εἰς",704105,0],["κρατῆρα",707880,6],["τὸν",709436,5],["ἑαυτῆς",703917,86],["οἶνον",709530,6],["καὶ",707031,7],["ἡτοιμάσατο",705539,23],["τὴν",709436,8],["ἑαυτῆς",703917,86],["τράπεζαν",712919,9]],"She has killed her beasts; she has mingled her wine in a bowl, and prepared her table."],["3",[["ἀπέστειλεν",701592,2],["τοὺς",709436,58],["ἑαυτῆς",703917,86],["δούλους",703817,57],["συγκαλούσα",712199,188],["μετὰ",708780,0],["ὑψηλοῦ",713285,92],["κηρύγματος",707660,21],["ἐπὶ",705080,0],["κρατῆρα",707880,6],["λέγουσα",708124,188]],"She has sent forth her servants, calling with a loud proclamation to the feast, saying,"],["4",[["ὅς",709781,561],["ἐστιν",704093,91],["ἄφρων",702236,14],["ἐκκλινάτω",704220,45],["πρός",710844,0],["με",708618,163],["καὶ",707031,7],["τοῖς",709436,147],["ἐνδεέσι",704671,230],["φρενῶν",713578,65],["εἶπεν",705373,2]],"Whoso is foolish, let him turn aside to me: and to them that want understanding she says,"],["5",[["ἔλθατε",705453,74],["φάγετε",713296,74],["τῶν",709436,80],["ἐμῶν",704578,169],["ἄρτων",701829,81],["καὶ",707031,7],["πίετε",710478,74],["οἶνον",709530,6],["ὃν",709781,112],["ἐκέρασα",707624,155],["ὑμῖν",713084,90]],"Come, eat of my bread, and drink wine which I have mingled for you."],["6",[["ἀπολείπετε",701508,335],["ἀφροσύνην",702235,9],["καὶ",707031,7],["ζήσεσθε",705851,124,135],["καὶ",707031,7],["ζητήσατε",705879,74],["φρόνησιν",713588,9],["ἵνα",706747,7],["βιώσητε",702727,125],["καὶ",707031,7],["κατορθώσατε",709740,74],["ἐν",704639,0],["γνώσει",703138,1],["σύνεσιν",712460,9]],"Leave folly, that ye may reign for ever; and seek wisdom, and improve understanding by knowledge."],["7",[["ὁ",709436,3],["παιδεύων",709926,72],["κακοὺς",707066,60],["λήμψεται",708076,93],["ἑαυτῷ",703917,50],["ἀτιμίαν",702094,9],["ἐλέγχων",704416,72],["δὲ",703303,11],["τὸν",709436,5],["ἀσεβῆ",701909,27],["μωμήσεται",709100,93],["ἑαυτόν",703917,85]],"He that reproves evil [men] shall get dishonour to himself; and he that rebukes an ungodly [man] shall disgrace himself."],["8",[["μὴ",708851,28],["ἔλεγχε",704416,240],["κακούς",707066,60],["ἵνα",706747,7],["μὴ",708851,28],["μισῶσίν",708935,271],["σε",711598,163],["ἔλεγχε",704416,240],["σοφόν",711985,27],["καὶ",707031,7],["ἀγαπήσει",700120,127],["σε",711598,163]],"Rebuke not evil [men], lest they should hate thee: rebuke a wise [man], and he will love thee."],["9",[["δίδου",703654,240],["σοφῷ",711985,30],["ἀφορμήν",702230,9],["καὶ",707031,7],["σοφώτερος",711985,224],["ἔσται",704093,93],["γνώριζε",703135,240],["δικαίῳ",703694,30],["καὶ",707031,7],["προσθήσει",710965,127],["τοῦ",709436,20],["δέχεσθαι",703393,110]],"Give an opportunity to a wise [man], and he will be wiser: instruct a just man, and he will receive more [instruction]."],["10",[["ἀρχὴ",701836,12],["σοφίας",711981,17],["φόβος",713534,4],["κυρίου",707996,18],["καὶ",707031,7],["βουλὴ",702792,12],["ἁγίων",700159,83],["σύνεσις",712460,12]],"The fear of the Lord is the beginning of wisdom, and the counsel of saints is understanding:"],["10a",[["τὸ",709436,34],["γὰρ",702963,11],["γνῶναι",703105,106],["νόμον",709349,6],["διανοίας",703531,17],["ἐστὶν",704093,91],["ἀγαθῆς",700106,82]],null],["11",[["τούτῳ",709858,50],["γὰρ",702963,11],["τῷ",709436,113],["τρόπῳ",712980,114],["πολὺν",710646,27],["ζήσεις",705851,166],["χρόνον",713969,6],["καὶ",707031,7],["προστεθήσεταί",710965,134],["σοι",711925,159],["ἔτη",705543,64],["ζωῆς",705910,17],["σου",711945,133]],"For in this way thou shalt live long, and years of thy life shall be added to thee."],["12",[["υἱέ",713075,153],["ἐὰν",703912,7],["σοφὸς",711985,14],["γένῃ",703104,420],["σεαυτῷ",711599,50],["σοφὸς",711985,14],["ἔσῃ",704093,123],["καὶ",707031,7],["τοῖς",709436,147],["πλησίον",710547,28],["ἐὰν",703912,7],["δὲ",703303,11],["κακὸς",707066,14],["ἀποβῇς",701426,175],["μόνος",709003,14],["ἀναντλήσεις",701019,166],["κακά",707066,68]],"Son, if thou be wise for thyself, thou shalt also be wise for thy neighbours; and if thou shouldest prove wicked, thou alone wilt bear the evil."],["12a",[["ὃς",709781,213],["ἐρείδεται",705405,117],["ἐπὶ",705080,0],["ψεύδεσιν",714044,96],["οὗτος",709858,121],["ποιμανεῖ",710594,127],["ἀνέμους",701123,57],["ὁ",709436,3],["δ᾿",703303,11],["αὐτὸς",702165,121],["διώξεται",703768,93],["ὄρνεα",709762,42],["πετόμενα",710441,67]],null],["12b",[["ἀπέλιπεν",701508,2],["γὰρ",702963,11],["ὁδοὺς",709458,39],["τοῦ",709436,35],["ἑαυτοῦ",703917,102],["ἀμπελῶνος",700872,18],["τοὺς",709436,58],["δὲ",703303,11],["ἄξονας",701312,57],["τοῦ",709436,20],["ἰδίου",706493,92],["γεωργίου",703081,21],["πεπλάνηται",710495,187]],null],["12c",[["διαπορεύεται",703551,117],["δὲ",703303,11],["δι᾿",703417,0],["ἀνύδρου",701285,82],["ἐρήμου",705420,17],["καὶ",707031,7],["γῆν",703083,9],["διατεταγμένην",703603,444],["ἐν",704639,0],["διψώδεσιν",703765,291],["συνάγει",712375,91],["δὲ",703303,11],["χερσὶν",713787,76],["ἀκαρπίαν",700521,9]],null],["13",[["γυνὴ",703209,12],["ἄφρων",702236,29],["καὶ",707031,7],["θρασεῖα",706300,29],["ἐνδεὴς",704671,29],["ψωμοῦ",714078,18],["γίνεται",703104,117],["ἣ",709781,177],["οὐκ",709805,28],["ἐπίσταται",705264,117],["αἰσχύνην",700483,9]],"A foolish and bold woman, who knows not modesty, comes to want a morsel."],["14",[["ἐκάθισεν",707006,2],["ἐπὶ",705080,0],["θύραις",706337,76],["τοῦ",709436,35],["ἑαυτῆς",703917,86],["οἴκου",709516,18],["ἐπὶ",705080,0],["δίφρου",703755,18],["ἐμφανῶς",704630,28],["ἐν",704639,0],["πλατείαις",710509,291]],"She sits at the doors of her house, on a seat openly in the streets,"],["15",[["προσκαλουμένη",710912,211],["τοὺς",709436,58],["παριόντας",710126,235],["καὶ",707031,7],["κατευθύνοντας",707521,235],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["αὐτῶν",702165,40]],"calling to passers by, and to those that are going right on their ways;"],["16",[["ὅς",709781,213],["ἐστιν",704093,91],["ὑμῶν",713091,145],["ἀφρονέστατος",702236,480],["ἐκκλινάτω",704220,45],["πρός",710844,0],["με",708618,163],["ἐνδεέσι",704671,230],["δὲ",703303,11],["φρονήσεως",713588,17],["παρακελεύομαι",710045,254],["λέγουσα",708124,188]],"[saying], Whoso is most senseless of you, let him turn aside to me; and I exhort those that want prudence, saying,"],["17",[["ἄρτων",701829,81],["κρυφίων",707930,169],["ἡδέως",705938,28],["ἅψασθε",701654,186,142],["καὶ",707031,7],["ὕδατος",713071,21],["κλοπῆς",707742,17],["γλυκεροῦ",703113,92]],"Take and enjoy secret bread, and the sweet water of theft."],["18",[["ὁ",709436,3],["δὲ",703303,11],["οὐκ",709805,28],["οἶδεν",709492,171],["ὅτι",709803,7],["γηγενεῖς",703085,138],["παρ᾿",709995,0],["αὐτῇ",702165,105],["ὄλλυνται",709584,269],["καὶ",707031,7],["ἐπὶ",705080,0],["πέτευρον",710437,25],["ᾅδου",700255,18],["συναντᾷ",712394,91]],"But he knows that mighty men die by her, and he falls in with a snare of hell."],["18a",[["ἀλλὰ",700680,7],["ἀποπήδησον",701544,176],["μὴ",708851,28],["ἐγχρονίσῃς",704016,175],["ἐν",704639,0],["τῷ",709436,113],["τόπῳ",712903,114],["μηδὲ",708855,7],["ἐπιστήσῃς",705756,175],["τὸ",709436,24],["σὸν",711943,46],["ὄμμα",709616,25],["πρὸς",710844,0],["αὐτήν",702165,104]],null],["18b",[["οὕτως",709859,28],["γὰρ",702963,11],["διαβήσῃ",703419,123],["ὕδωρ",713071,15],["ἀλλότριον",700699,27],["καὶ",707031,7],["ὑπερβήσῃ",713125,123],["ποταμὸν",710693,6],["ἀλλότριον",700699,27]],null],["18c",[["ἀπὸ",701425,0],["δὲ",703303,11],["ὕδατος",713071,21],["ἀλλοτρίου",700699,92],["ἀπόσχου",701225,300],["καὶ",707031,7],["ἀπὸ",701425,0],["πηγῆς",710450,17],["ἀλλοτρίας",700699,82],["μὴ",708851,28],["πίῃς",710478,175]],null],["18d",[["ἵνα",706747,7],["πολὺν",710646,27],["ζήσῃς",705851,175],["χρόνον",713969,6],["προστεθῇ",710965,384],["δέ",703303,11],["σοι",711925,159],["ἔτη",705543,64],["ζωῆς",705910,17]],null]]