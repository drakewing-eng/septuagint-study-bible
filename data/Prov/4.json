[["1",[["ἀκούσατε",700587,74],["παῖδες",709932,274],["παιδείαν",709924,9],["πατρὸς",710189,18],["καὶ",707031,7],["προσέχετε",710895,335],["γνῶναι",703105,106],["ἔννοιαν",704764,9]],"Hear, ye children, the instruction of a father, and attend to know understanding."],["2",[["δῶρον",703907,25],["γὰρ",702963,11],["ἀγαθὸν",700106,46],["δωροῦμαι",703902,254],["ὑμῖν",713084,90],["τὸν",709436,5],["ἐμὸν",704578,27],["νόμον",709349,6],["μὴ",708851,28],["ἐγκαταλίπητε",703967,125]],"For I give you a good gift; forsake ye not my law."],["3",[["υἱὸς",713075,4],["γὰρ",702963,11],["ἐγενόμην",703104,161],["κἀγὼ",706969,288],["πατρὶ",710189,114],["ὑπήκοος",713176,4],["καὶ",707031,7],["ἀγαπώμενος",700120,466],["ἐν",704639,0],["προσώπῳ",710986,54],["μητρός",708892,17]],"For I also was a son obedient to [my] father, and loved in the sight of [my] mother:"],["4",[["οἳ",709781,250],["ἔλεγον",708124,137],["καὶ",707031,7],["ἐδίδασκόν",703649,137],["με",708618,163],["ἐρειδέτω",705405,31],["ὁ",709436,3],["ἡμέτερος",705987,14],["λόγος",708236,4],["εἰς",704105,0],["σὴν",711943,36],["καρδίαν",707141,9]],"who spoke and instructed me, [saying], Let our speech be fixed in thine heart, keep [our] commandments, forget them not:"],["5",[["φύλασσε",713619,240],["ἐντολάς",704802,39],["μὴ",708851,28],["ἐπιλάθῃ",705187,420],["μηδὲ",708855,7],["παρίδῃς",710125,175],["ῥῆσιν",711250,9],["ἐμοῦ",704580,133],["στόματος",712125,21]],"and do not neglect the speech of my mouth."],["6",[["μηδὲ",708855,7],["ἐγκαταλίπῃς",703967,175],["αὐτήν",702165,104],["καὶ",707031,7],["ἀνθέξεταί",701225,93],["σου",711945,133],["ἐράσθητι",705380,244],["αὐτῆς",702165,86],["καὶ",707031,7],["τηρήσει",712844,127],["σε",711598,163]],"And forsake it not, and it shall cleave to thee: love it, and it shall keep thee."],["8",[["περιχαράκωσον",710418,176],["αὐτήν",702165,104],["καὶ",707031,7],["ὑψώσει",713289,127],["σε",711598,163],["τίμησον",712855,176],["αὐτήν",702165,104],["ἵνα",706747,7],["σε",711598,163],["περιλάβῃ",710342,172]],"Secure it, and it shall exalt thee: honour it, that it may embrace thee;"],["9",[["ἵνα",706747,7],["δῷ",703654,172],["τῇ",709436,100],["σῇ",711943,101],["κεφαλῇ",707639,1],["στέφανον",712083,6],["χαρίτων",713735,65],["στεφάνῳ",712083,114],["δὲ",703303,11],["τρυφῆς",713008,17],["ὑπερασπίσῃ",713121,204],["σου",711945,133]],"that it may give unto thy head a crown of graces, and may cover thee with a crown of delight."],["10",[["ἄκουε",700587,240],["υἱέ",713075,153],["καὶ",707031,7],["δέξαι",703393,300],["ἐμοὺς",704578,60],["λόγους",708236,57],["καὶ",707031,7],["πληθυνθήσεται",710530,134],["ἔτη",705543,64],["ζωῆς",705910,17],["σου",711945,133],["ἵνα",706747,7],["σοι",711925,159],["γένωνται",703104,232],["πολλαὶ",710646,192],["ὁδοὶ",709458,191],["βίου",702724,18]],"Hear, [my] son, and receive my words; and the years of thy life shall be increased, that the resources of thy life may be many."],["11",[["ὁδοὺς",709458,39],["γὰρ",702963,11],["σοφίας",711981,17],["διδάσκω",703649,157],["σε",711598,163],["ἐμβιβάζω",704549,157],["δέ",703303,11],["σε",711598,163],["τροχιαῖς",712992,291],["ὀρθαῖς",709738,291]],"For I teach thee the ways of wisdom; and I cause thee to go in right paths."],["12",[["ἐὰν",703912,7],["γὰρ",702963,11],["πορεύῃ",710667,278],["οὐ",709805,28],["συγκλεισθήσεταί",712223,134],["σου",711945,133],["τὰ",709436,63],["διαβήματα",703422,64],["ἐὰν",703912,7],["δὲ",703303,11],["τρέχῃς",712931,205],["οὐ",709805,28],["κοπιάσεις",707824,166]],"For when thou goest, thy steps shall not be straitened; and when thou runnest, thou shalt not be distressed."],["13",[["ἐπιλαβοῦ",705185,300],["ἐμῆς",704578,82],["παιδείας",709924,17],["μὴ",708851,28],["ἀφῇς",702211,175],["ἀλλὰ",700680,7],["φύλαξον",713619,176],["αὐτὴν",702165,104],["σεαυτῷ",711599,50],["εἰς",704105,0],["ζωήν",705910,9],["σου",711945,133]],"Take hold of my instruction; let it not go,—but keep it for thyself for thy life."],["14",[["ὁδοὺς",709458,39],["ἀσεβῶν",701909,169],["μὴ",708851,28],["ἐπέλθῃς",705068,175],["μηδὲ",708855,7],["ζηλώσῃς",705873,175],["ὁδοὺς",709458,39],["παρανόμων",710080,169]],"Go not in the ways of the ungodly, neither covet the ways of transgressors."],["15",[["ἐν",704639,0],["ᾧ",709781,309],["ἂν",700900,11],["τόπῳ",712903,114],["στρατοπεδεύσωσιν",712150,234],["μὴ",708851,28],["ἐπέλθῃς",705068,175],["ἐκεῖ",704181,28],["ἔκκλινον",704220,176],["δὲ",703303,11],["ἀπ᾿",701425,0],["αὐτῶν",702165,70],["καὶ",707031,7],["παράλλαξον",710066,176]],"In whatever place they shall pitch their camp, go not thither; but turn from them, and pass away."],["16",[["οὐ",709805,28],["γὰρ",702963,11],["μὴ",708851,28],["ὑπνώσωσιν",713182,234],["ἐὰν",703912,7],["μὴ",708851,28],["κακοποιήσωσιν",707062,234],["ἀφῄρηται",702177,403],["ὁ",709436,3],["ὕπνος",713181,4],["αὐτῶν",702165,40],["καὶ",707031,7],["οὐ",709805,28],["κοιμῶνται",707767,269]],"For they cannot sleep, unless they have done evil: their sleep is taken away, and they rest not."],["17",[["οἵδε",709446,201],["γὰρ",702963,11],["σιτοῦνται",711806,269],["σῖτα",711814,42],["ἀσεβείας",701904,17],["οἴνῳ",709530,114],["δὲ",703303,11],["παρανόμῳ",710080,30],["μεθύσκονται",708676,269]],"For these live upon the bread of ungodliness, and are drunken with wine of transgression."],["18",[["αἱ",709436,190],["δὲ",703303,11],["ὁδοὶ",709458,191],["τῶν",709436,80],["δικαίων",703694,169],["ὁμοίως",709630,28],["φωτὶ",713642,54],["λάμπουσιν",708085,197],["προπορεύονται",710839,269],["καὶ",707031,7],["φωτίζουσιν",713646,197],["ἕως",705792,7],["κατορθώσῃ",707548,172],["ἡ",709436,10],["ἡμέρα",705984,12]],"But the ways of the righteous shine like light; they go on and shine, until the day be fully come."],["19",[["αἱ",709436,190],["δὲ",703303,11],["ὁδοὶ",709458,191],["τῶν",709436,80],["ἀσεβῶν",701909,169],["σκοτειναί",711885,192],["οὐκ",709805,28],["οἴδασιν",709492,353],["πῶς",711121,28],["προσκόπτουσιν",710923,197]],"But the ways of the ungodly are dark; they know not how they stumble."],["20",[["υἱέ",713075,153],["ἐμῇ",704578,101],["ῥήσει",711250,1],["πρόσεχε",710895,240],["τοῖς",709436,147],["δὲ",703303,11],["ἐμοῖς",704578,230],["λόγοις",708236,148],["παράβαλε",709997,176],["σὸν",711943,27],["οὖς",709852,25]],"[My] son, attend to my speech; and apply thine ear to my words:"],["21",[["ὅπως",709719,7],["μὴ",708851,28],["ἐκλίπωσίν",704237,234],["σε",711598,163],["αἱ",709436,190],["πηγαί",710450,191],["σου",711945,133],["φύλασσε",713619,240],["αὐτὰς",702165,231],["ἐν",704639,0],["σῇ",711943,101],["καρδίᾳ",707141,1]],"that thy fountains may not fail thee; keep them in [thine] heart."],["22",[["ζωὴ",705910,12],["γάρ",702963,11],["ἐστιν",704093,91],["τοῖς",709436,147],["εὑρίσκουσιν",705676,197],["αὐτὰς",702165,231],["καὶ",707031,7],["πάσῃ",710177,101],["σαρκὶ",711537,1],["ἴασις",706444,12]],"For they are life to those that find them, and health to all [their] flesh."],["23",[["πάσῃ",710177,101],["φυλακῇ",713613,1],["τήρει",712844,240],["σὴν",711943,36],["καρδίαν",707141,9],["ἐκ",704132,0],["γὰρ",702963,11],["τούτων",709858,40],["ἔξοδοι",704948,191],["ζωῆς",705910,17]],"Keep thine heart with the utmost care; for out of these are the issues of life."],["24",[["περίελε",710288,176],["σεαυτοῦ",711599,102],["σκολιὸν",711868,46],["στόμα",712125,25],["καὶ",707031,7],["ἄδικα",700272,68],["χείλη",713781,42],["μακρὰν",708411,28],["ἀπὸ",701425,0],["σοῦ",711945,133],["ἄπωσαι",701659,300]],"Remove from thee a froward mouth, and put far away from thee unjust lips."],["25",[["οἱ",709436,136],["ὀφθαλμοί",709870,52],["σου",711945,133],["ὀρθὰ",709738,68],["βλεπέτωσαν",702740,56],["τὰ",709436,41],["δὲ",703303,11],["βλέφαρά",702741,42],["σου",711945,133],["νευέτω",709276,31],["δίκαια",703694,68]],"Let thine eyes look right on, and let thine eyelids assent [to] just [things]."],["26",[["ὀρθὰς",709738,119],["τροχιὰς",712988,39],["ποίει",710582,240],["σοῖς",711943,230],["ποσὶν",710707,148],["καὶ",707031,7],["τὰς",709436,38],["ὁδούς",709458,39],["σου",711945,133],["κατεύθυνε",707521,240]],"Make straight paths for thy feet, and order thy ways aright."],["27",[["μὴ",708851,28],["ἐκκλίνῃς",704220,205],["εἰς",704105,0],["τὰ",709436,41],["δεξιὰ",703360,68],["μηδὲ",708855,7],["εἰς",704105,0],["τὰ",709436,41],["ἀριστερά",701749,68],["ἀπόστρεψον",701598,176],["δὲ",703303,11],["σὸν",711943,27],["πόδα",710707,6],["ἀπὸ",701425,0],["ὁδοῦ",709458,17],["κακῆς",707066,82]],"Turn not aside to the right hand nor to the left, but turn away thy foot from an evil way:"],["27a",[["ὁδοὺς",709458,39],["γὰρ",702963,11],["τὰς",709436,38],["ἐκ",704132,0],["δεξιῶν",703360,169],["οἶδεν",709492,171],["ὁ",709436,3],["θεός",706192,4],["διεστραμμέναι",703592,423],["δέ",703303,11],["εἰσιν",704093,197],["αἱ",709436,190],["ἐξ",704132,0],["ἀριστερῶν",701749,169]],null],["27b",[["αὐτὸς",702165,121],["δὲ",703303,11],["ὀρθὰς",709738,119],["ποιήσει",710582,127],["τὰς",709436,38],["τροχιάς",712990,119],["σου",711945,133],["τὰς",709436,38],["δὲ",703303,11],["πορείας",710665,39],["σου",711945,133],["ἐν",704639,0],["εἰρήνῃ",704098,1],["προάξει",710748,127]],null]]