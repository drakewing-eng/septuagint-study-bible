[["1",[["ἀκόλαστον",700565,26],["οἶνος",709530,4],["καὶ",707031,7],["ὑβριστικὸν",713053,26],["μέθη",708667,12],["πᾶς",710177,14],["δὲ",703303,11],["ὁ",709436,3],["συμμειγνύμενος",712307,122],["αὐτῇ",702165,105],["οὐκ",709805,28],["ἔσται",704093,93],["σοφός",711985,14]],"Wine is an intemperate thing, and strong drink full of violence: but every fool is entangled with them."],["2",[["οὐ",709805,28],["διαφέρει",703622,91],["ἀπειλὴ",701375,12],["βασιλέως",702580,18],["θυμοῦ",706334,18],["λέοντος",708171,18],["ὁ",709436,3],["δὲ",703303,11],["παροξύνων",710164,72],["αὐτὸν",702165,85],["ἁμαρτάνει",700773,91],["εἰς",704105,0],["τὴν",709436,8],["ἑαυτοῦ",703917,102],["ψυχήν",714070,9]],"The threat of a king differs not from the rage of a lion; and he that provokes him sins against his own soul."],["3",[["δόξα",703791,12],["ἀνδρὶ",701150,114],["ἀποστρέφεσθαι",701598,110],["λοιδορίας",708242,39],["πᾶς",710177,14],["δὲ",703303,11],["ἄφρων",702236,14],["τοιούτοις",712878,230],["συμπλέκεται",712334,117]],"[It is] a glory to a man to turn aside from railing; but every fool is entangled with such matters."],["4",[["ὀνειδιζόμενος",709655,122],["ὀκνηρὸς",709550,14],["οὐκ",709805,28],["αἰσχύνεται",700485,117],["ὡσαύτως",714158,28],["καὶ",707031,7],["ὁ",709436,3],["δανιζόμενος",703277,122],["σῖτον",711814,6],["ἐν",704639,0],["ἀμήτῳ",700819,114]],"A sluggard when reproached is not ashamed: so also he who borrows corn in harvest."],["5",[["ὕδωρ",713071,15],["βαθὺ",702381,26],["βουλὴ",702792,12],["ἐν",704639,0],["καρδίᾳ",707141,1],["ἀνδρός",701150,18],["ἀνὴρ",701150,4],["δὲ",703303,11],["φρόνιμος",713589,14],["ἐξαντλήσει",704866,127],["αὐτήν",702165,104]],"Counsel in a man's heart is deep water; but a prudent man will draw it out."],["6",[["μέγα",708653,46],["ἄνθρωπος",701163,4],["καὶ",707031,7],["τίμιον",712858,27],["ἀνὴρ",701150,4],["ἐλεήμων",704422,14],["ἄνδρα",701150,6],["δὲ",703303,11],["πιστὸν",710486,27],["ἔργον",705396,25],["εὑρεῖν",705676,106]],"A man is valuable, and a merciful man precious: but [it is] hard to find a faithful man."],["7",[["ὃς",709781,213],["ἀναστρέφεται",701060,117],["ἄμωμος",700895,14],["ἐν",704639,0],["δικαιοσύνῃ",703695,1],["μακαρίους",708397,60],["τοὺς",709436,58],["παῖδας",709932,57],["αὐτοῦ",702165,102],["καταλείψει",707305,127]],"He that walks blameless in justice, shall leave his children blessed."],["8",[["ὅταν",709801,28],["βασιλεὺς",702580,4],["δίκαιος",703694,14],["καθίσῃ",707006,123],["ἐπὶ",705080,0],["θρόνου",706315,18],["οὐκ",709805,28],["ἐναντιοῦται",704655,117],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["αὐτοῦ",702165,102],["πᾶν",710177,46],["πονηρόν",710660,46]],"Whenever a righteous king sits on the throne, no evil thing can stand before his presence."],["9",[["τίς",712867,158],["καυχήσεται",707569,93],["ἁγνὴν",700178,36],["ἔχειν",705785,55],["τὴν",709436,8],["καρδίαν",707141,9],["ἢ",705924,7],["τίς",712867,158],["παρρησιάσεται",710174,93],["καθαρὸς",706988,14],["εἶναι",704093,55],["ἀπὸ",701425,0],["ἁμαρτιῶν",700775,65]],"Who will boast that he has a pure heart? or who will boldly say that he is pure from sins?"],["9a",[["κακολογοῦντος",707058,152],["πατέρα",710189,6],["ἢ",705924,7],["μητέρα",708892,9],["σβεσθήσεται",711596,134],["λαμπτήρ",708084,4],["αἱ",709436,190],["δὲ",703303,11],["κόραι",707836,191],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["αὐτοῦ",702165,102],["ὄψονται",709725,135],["σκότος",711889,25]],null],["9b",[["μερὶς",708748,12],["ἐπισπουδαζομένη",705262,211],["ἐν",704639,0],["πρώτοις",711041,230],["ἐν",704639,0],["τοῖς",709436,147],["τελευταίοις",712780,230],["οὐκ",709805,28],["εὐλογηθήσεται",705631,134]],null],["9c",[["μὴ",708851,28],["εἴπῃς",705373,175],["τείσομαι",712865,181],["τὸν",709436,5],["ἐχθρόν",705779,27],["ἀλλὰ",700680,7],["ὑπόμεινον",713219,176],["τὸν",709436,5],["κύριον",707996,6],["ἵνα",706747,7],["σοι",711925,159],["βοηθήσῃ",702746,420]],null],["10",[["στάθμιον",712039,15],["μέγα",708653,26],["καὶ",707031,7],["μικρὸν",708915,26],["καὶ",707031,7],["μέτρα",708846,64],["δισσά",703744,195],["ἀκάθαρτα",700508,195],["ἐνώπιον",704823,28],["κυρίου",707996,18],["καὶ",707031,7],["ἀμφότερα",700892,195]],"A large and small weight, and divers measures, are even both of them unclean before the Lord; and [so is] he that makes them."],["11",[["καὶ",707031,7],["ὁ",709436,3],["ποιῶν",710582,72],["αὐτὰ",702165,71],["ἐν",704639,0],["τοῖς",709436,95],["ἐπιτηδεύμασιν",705301,96],["αὐτοῦ",702165,102],["συμποδισθήσεται",712338,134],["νεανίσκος",709232,4],["μετὰ",708780,0],["ὁσίου",709782,116],["καὶ",707031,7],["εὐθεῖα",705602,29],["ἡ",709436,10],["ὁδὸς",709458,12],["αὐτοῦ",702165,102]],"A youth [when in company] with a godly man, will be restrained in his devices, and [then] his way will be straight."],["12",[["οὖς",709852,15],["ἀκούει",700587,91],["καὶ",707031,7],["ὀφθαλμὸς",709870,4],["ὁρᾷ",709725,91],["κυρίου",707996,18],["ἔργα",705396,64],["καὶ",707031,7],["ἀμφότερα",700892,195]],"The ear hears, and the eye sees: even both of them are the Lord's work."],["13",[["μὴ",708851,28],["ἀγάπα",700120,240],["καταλαλεῖν",707298,55],["ἵνα",706747,7],["μὴ",708851,28],["ἐξαρθῇς",704839,279],["διάνοιξον",703532,176],["τοὺς",709436,58],["ὀφθαλμούς",709870,57],["σου",711945,133],["καὶ",707031,7],["ἐμπλήσθητι",704592,244],["ἄρτων",701829,81]],"Love not to speak ill, lest thou be cut off: open thine eyes, and be filled with bread."],["23",[["βδέλυγμα",702604,15],["κυρίῳ",707996,114],["δισσὸν",703744,26],["στάθμιον",712039,15],["καὶ",707031,7],["ζυγὸς",705894,15],["δόλιος",703783,14],["οὐ",709805,28],["καλὸν",707097,26],["ἐνώπιον",704823,28],["αὐτοῦ",702165,102]],"A double weight is an abomination to the Lord; and a deceitful balance is not good in his sight."],["24",[["παρὰ",709995,0],["κυρίου",707996,18],["εὐθύνεται",705601,391],["τὰ",709436,63],["διαβήματα",703422,64],["ἀνδρί",701150,114],["θνητὸς",706279,14],["δὲ",703303,11],["πῶς",711121,28],["ἂν",700900,11],["νοήσαι",709327,106],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτοῦ",702165,102]],"A man's goings are directed of the Lord: how then can a mortal understand his ways?"],["25",[["παγὶς",709910,12],["ἀνδρὶ",701150,114],["ταχύ",712748,46],["τι",712866,126],["τῶν",709436,80],["ἰδίων",706493,169],["ἁγιάσαι",700153,106],["μετὰ",708780,0],["γὰρ",702963,11],["τὸ",709436,24],["εὔξασθαι",705727,109],["μετανοεῖν",708809,55],["γίνεται",703104,117]],"It is a snare to a man hastily to consecrate some of his own property: for [in that case] repentance comes after vowing."],["26",[["λικμήτωρ",708203,4],["ἀσεβῶν",701909,169],["βασιλεὺς",702580,4],["σοφὸς",711985,14],["καὶ",707031,7],["ἐπιβαλεῖ",705083,127],["αὐτοῖς",702165,151],["τροχόν",712994,6]],"A wise king utterly crushes the ungodly, and will bring a wheel upon them."],["27",[["φῶς",713642,15],["κυρίου",707996,18],["πνοὴ",710574,12],["ἀνθρώπων",701163,81],["ὃς",709781,213],["ἐρευνᾷ",705412,91],["ταμίεια",712700,42],["κοιλίας",707761,17]],"The spirit of man is a light of the Lord, who searches the inmost parts of the belly."],["28",[["ἐλεημοσύνη",704421,12],["καὶ",707031,7],["ἀλήθεια",700656,12],["φυλακὴ",713613,12],["βασιλεῖ",702580,114],["καὶ",707031,7],["περικυκλώσουσιν",710339,218],["ἐν",704639,0],["δικαιοσύνῃ",703695,1],["τὸν",709436,5],["θρόνον",706315,6],["αὐτοῦ",702165,102]],"Mercy and truth are a guard to a king, and will surround his throne with righteousness."],["29",[["κόσμος",707851,4],["νεανίαις",709229,148],["σοφία",711981,12],["δόξα",703791,12],["δὲ",703303,11],["πρεσβυτέρων",710735,81],["πολιαί",710607,191]],"Wisdom is an ornament to young men; and grey [hairs] are the glory of old men."],["30",[["ὑπώπια",713266,64],["καὶ",707031,7],["συντρίμματα",712521,64],["συναντᾷ",712394,91],["κακοῖς",707066,230],["πληγαὶ",710527,191],["δὲ",703303,11],["εἰς",704105,0],["ταμίεια",712700,42],["κοιλίας",707761,17]],"Bruises and contusions befall bad men; and plagues [shall come] into the inward parts of [their] belly."]]