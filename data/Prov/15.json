[["1",[["ὀργὴ",709728,12],["ἀπόλλυσιν",701513,91],["καὶ",707031,7],["φρονίμους",713589,60],["ἀπόκρισις",701493,12],["δὲ",703303,11],["ὑποπίπτουσα",713232,188],["ἀποστρέφει",701598,91],["θυμόν",706334,6],["λόγος",708236,4],["δὲ",703303,11],["λυπηρὸς",708274,14],["ἐγείρει",703949,91],["ὀργάς",709728,39]],"Anger slays even wise men; yet a submissive answer turns away wrath: but a grievous word stirs up anger."],["2",[["γλῶσσα",703120,12],["σοφῶν",711985,169],["καλὰ",707097,68],["ἐπίσταται",705264,117],["στόμα",712125,25],["δὲ",703303,11],["ἀφρόνων",702236,169],["ἀναγγελεῖ",700921,127],["κακά",707066,68]],"The tongue of the wise knows what is good: but the mouth of the foolish tells out evil things."],["3",[["ἐν",704639,0],["παντὶ",710177,30],["τόπῳ",712903,114],["ὀφθαλμοὶ",709870,52],["κυρίου",707996,18],["σκοπεύουσιν",711873,197],["κακούς",707066,60],["τε",712751,11],["καὶ",707031,7],["ἀγαθούς",700106,60]],"The eyes of the Lord behold both the evil and the good in every place."],["4",[["ἴασις",706444,12],["γλώσσης",703120,17],["δένδρον",703353,15],["ζωῆς",705910,17],["ὁ",709436,3],["δὲ",703303,11],["συντηρῶν",712512,72],["αὐτὴν",702165,104],["πλησθήσεται",710532,134],["πνεύματος",710566,21]],"The wholesome tongue is a tree of life, and he that keeps it shall be filled with understanding."],["5",[["ἄφρων",702236,14],["μυκτηρίζει",709052,91],["παιδείαν",709924,9],["πατρός",710189,18],["ὁ",709436,3],["δὲ",703303,11],["φυλάσσων",713619,72],["ἐντολὰς",704802,39],["πανουργότερος",709972,224]],"A fool scorns his father's instruction: but he that keeps his commandments is more prudent. In abounding righteousness is great strength: but the ungodly shall utterly perish from the earth."],["6",[["ἐν",704639,0],["πλεοναζούσῃ",710516,220],["δικαιοσύνῃ",703695,1],["ἰσχὺς",706858,12],["πολλή",710646,29],["οἱ",709436,136],["δὲ",703303,11],["ἀσεβεῖς",701909,138],["ὁλόρριζοι",709596,138],["ἐκ",704132,0],["γῆς",703083,17],["ὀλοῦνται",709584,135],["οἴκοις",709516,148],["δικαίων",703694,169],["ἰσχὺς",706858,12],["πολλή",710646,29],["καρποὶ",707169,52],["δὲ",703303,11],["ἀσεβῶν",701909,169],["ἀπολοῦνται",701513,135]],"In the houses of the righteous is much strength: but the fruits of the ungodly shall perish."],["7",[["χείλη",713781,64],["σοφῶν",711985,169],["δέδεται",703394,187],["αἰσθήσει",700477,1],["καρδίαι",707141,191],["δὲ",703303,11],["ἀφρόνων",702236,169],["οὐκ",709805,28],["ἀσφαλεῖς",702040,138]],"The lips of the wise are bound by discretion: but the hearts of the foolish are not safe."],["8",[["θυσίαι",706345,191],["ἀσεβῶν",701909,169],["βδέλυγμα",702604,15],["κυρίῳ",707996,114],["εὐχαὶ",705726,191],["δὲ",703303,11],["κατευθυνόντων",707521,170],["δεκταὶ",703348,192],["παρ᾿",709995,0],["αὐτῷ",702165,50]],"The sacrifices of the ungodly are an abomination to the Lord; but the prayers of them that walk honestly are acceptable with him."],["9",[["βδέλυγμα",702604,15],["κυρίῳ",707996,114],["ὁδοὶ",709458,191],["ἀσεβοῦς",701909,116],["διώκοντας",703768,235],["δὲ",703303,11],["δικαιοσύνην",703695,9],["ἀγαπᾷ",700120,91]],"The ways of an ungodly [man] are an abomination to the Lord; but he loves those that follow after righteousness."],["10",[["παιδεία",709924,12],["ἀκάκου",700512,116],["γνωρίζεται",703135,117],["ὑπὸ",713184,0],["τῶν",709436,80],["παριόντων",710149,170],["οἱ",709436,136],["δὲ",703303,11],["μισοῦντες",708935,146],["ἐλέγχους",704415,57],["τελευτῶσιν",712781,197],["αἰσχρῶς",700482,28]],"The instruction of the simple is known by them that pass by; but they that hate reproofs die disgracefully."],["11",[["ᾅδης",700255,4],["καὶ",707031,7],["ἀπώλεια",701660,12],["φανερὰ",713342,29],["παρὰ",709995,0],["τῷ",709436,113],["κυρίῳ",707996,114],["πῶς",711121,28],["οὐχὶ",709862,28],["καὶ",707031,28],["αἱ",709436,190],["καρδίαι",707141,191],["τῶν",709436,80],["ἀνθρώπων",701163,81]],"Hell and destruction are manifest to the Lord; how shall not also be the hearts of men?"],["12",[["οὐκ",709805,28],["ἀγαπήσει",700120,127],["ἀπαίδευτος",701328,14],["τοὺς",709436,58],["ἐλέγχοντας",704416,235],["αὐτόν",702165,85],["μετὰ",708780,0],["δὲ",703303,11],["σοφῶν",711985,169],["οὐχ",709805,28],["ὁμιλήσει",709613,127]],"An uninstructed person will not love those that reprove him; neither will he associate with the wise."],["13",[["καρδίας",707141,17],["εὐφραινομένης",705715,422],["πρόσωπον",710986,15],["θάλλει",706073,91],["ἐν",704639,0],["δὲ",703303,11],["λύπαις",708273,76],["οὔσης",704093,222],["σκυθρωπάζει",711896,91]],"When the heart rejoices the countenance is cheerful; but when it is in sorrow, [the countenance] is sad."],["14",[["καρδία",707141,12],["ὀρθὴ",709738,29],["ζητεῖ",705879,91],["αἴσθησιν",700477,9],["στόμα",712125,15],["δὲ",703303,11],["ἀπαιδεύτων",701328,169],["γνώσεται",703105,93],["κακά",707066,68]],"An upright heart seeks discretion; but the mouth of the uninstructed will experience evils."],["15",[["πάντα",710177,27],["τὸν",709436,5],["χρόνον",713969,6],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["τῶν",709436,80],["κακῶν",707066,169],["προσδέχονται",710874,269],["κακά",707066,68],["οἱ",709436,136],["δὲ",703303,11],["ἀγαθοὶ",700106,138],["ἡσυχάζουσιν",706033,197],["διὰ",703417,0],["παντός",710177,116]],"The eyes of the wicked are always looking for evil things; but the good are always quiet."],["16",[["κρείσσων",707891,29],["μικρὰ",708915,29],["μερὶς",708748,12],["μετὰ",708780,0],["φόβου",713534,18],["κυρίου",707996,18],["ἢ",705924,7],["θησαυροὶ",706258,52],["μεγάλοι",708653,138],["μετὰ",708780,0],["ἀφοβίας",702216,17]],"Better is a small portion with the fear of the Lord, than great treasures without the fear [of the Lord]."],["17",[["κρείσσων",707891,14],["ξενισμὸς",709412,4],["λαχάνων",708114,44],["πρὸς",710844,0],["φιλίαν",713474,9],["καὶ",707031,7],["χάριν",713735,9],["ἢ",705924,7],["παράθεσις",710027,12],["μόσχων",709029,81],["μετὰ",708780,0],["ἔχθρας",705779,82]],"Better is an entertainment of herbs with friendliness and kindness, than a feast of calves, with enmity."],["18",[["ἀνὴρ",701150,4],["θυμώδης",706336,14],["παρασκευάζει",710103,91],["μάχας",708601,39],["μακρόθυμος",708420,14],["δὲ",703303,11],["καὶ",707031,7],["τὴν",709436,8],["μέλλουσαν",708705,78],["καταπραΰνει",707388,91]],"A passionate man stirs up strife; but [he that is] slow to anger appeases even a rising one."],["18a",[["μακρόθυμος",708420,14],["ἀνὴρ",701150,4],["κατασβέσει",707412,127],["κρίσεις",707908,39],["ὁ",709436,3],["δὲ",703303,11],["ἀσεβὴς",701909,14],["ἐγείρει",703949,91],["μᾶλλον",708448,28]],null],["19",[["ὁδοὶ",709458,191],["ἀεργῶν",700316,169],["ἐστρωμέναι",712128,423],["ἀκάνθαις",700517,76],["αἱ",709436,190],["δὲ",703303,11],["τῶν",709436,80],["ἀνδρείων",701101,169],["τετριμμέναι",712940,423]],"The ways of sluggards are strewn with thorns; but those of the diligent are made smooth."],["20",[["υἱὸς",713075,4],["σοφὸς",711985,14],["εὐφραίνει",705715,91],["πατέρα",710189,6],["υἱὸς",713075,4],["δὲ",703303,11],["ἄφρων",702236,14],["μυκτηρίζει",709052,91],["μητέρα",708892,9],["αὐτοῦ",702165,102]],"A wise son gladdens [his] father; but a foolish son sneers at his mother."],["21",[["ἀνοήτου",701184,116],["τρίβοι",712939,191],["ἐνδεεῖς",704671,192],["φρενῶν",713578,65],["ἀνὴρ",701150,4],["δὲ",703303,11],["φρόνιμος",713589,14],["κατευθύνων",707521,72],["πορεύεται",710667,117]],"The ways of a foolish man are void of sense; but a wise man proceeds on his way aright."],["22",[["ὑπερτίθενται",713160,269],["λογισμοὺς",708234,57],["οἱ",709436,136],["μὴ",708851,28],["τιμῶντες",712855,146],["συνέδρια",712429,42],["ἐν",704639,0],["δὲ",703303,11],["καρδίαις",707141,76],["βουλευομένων",702791,299],["μένει",708736,91],["βουλή",702792,12]],"They that honour not councils put off deliberation; but counsel abides in the hearts of counsellors."],["23",[["οὐ",709805,28],["μὴ",708851,28],["ὑπακούσῃ",713096,172],["ὁ",709436,3],["κακὸς",707066,14],["αὐτῇ",702165,105],["οὐδὲ",709816,7],["μὴ",708851,28],["εἴπῃ",705373,172],["καίριόν",707046,46],["τι",712866,126],["καὶ",707031,7],["καλὸν",707097,46],["τῷ",709436,113],["κοινῷ",707772,30]],"A bad man will by no means attend to counsel; neither will he say anything seasonable, or good for the common [weal]."],["24",[["ὁδοὶ",709458,191],["ζωῆς",705910,17],["διανοήματα",703529,64],["συνετοῦ",712464,116],["ἵνα",706747,7],["ἐκκλίνας",704220,182],["ἐκ",704132,0],["τοῦ",709436,35],["ᾅδου",700255,18],["σωθῇ",712627,384]],"The thoughts of the wise are ways of life, that he may turn aside and escape from hell."],["25",[["οἴκους",709516,57],["ὑβριστῶν",713052,81],["κατασπᾷ",707431,91],["κύριος",707996,4],["ἐστήρισεν",712098,2],["δὲ",703303,11],["ὅριον",709749,25],["χήρας",713848,17]],"The Lord pulls down the houses of scorners; but he establishes the border of the widow."],["26",[["βδέλυγμα",702604,15],["κυρίῳ",707996,114],["λογισμὸς",708234,4],["ἄδικος",700272,14],["ἁγνῶν",700178,169],["δὲ",703303,11],["ῥήσεις",711250,191],["σεμναί",711682,192]],"An unrighteous thought is abomination to the Lord; but the sayings of the pure are held in honour."],["27",[["ἐξόλλυσιν",704955,91],["ἑαυτὸν",703917,85],["ὁ",709436,3],["δωρολήμπτης",703906,4],["ὁ",709436,3],["δὲ",703303,11],["μισῶν",708935,72],["δώρων",703907,44],["λήμψεις",708183,39],["σῴζεται",712627,391]],"A receiver of bribes destroys himself; but he that hates the receiving of bribes is safe."],["27a",[["ἐλεημοσύναις",704421,76],["καὶ",707031,7],["πίστεσιν",710484,76],["ἀποκαθαίρονται",701467,269],["ἁμαρτίαι",700775,191],["τῷ",709436,113],["δὲ",703303,11],["φόβῳ",713534,114],["κυρίου",707996,18],["ἐκκλίνει",704220,91],["πᾶς",710177,14],["ἀπὸ",701425,0],["κακοῦ",707066,116]],null],["28",[["καρδίαι",707141,191],["δικαίων",703694,169],["μελετῶσιν",708698,197],["πίστεις",710484,39],["στόμα",712125,15],["δὲ",703303,11],["ἀσεβῶν",701909,169],["ἀποκρίνεται",701492,117],["κακά",707066,68]],"The hearts of the righteous meditate faithfulness; but the mouth of the ungodly answers evil things."],["28a",[["δεκταὶ",703348,192],["παρὰ",709995,0],["κυρίῳ",707996,114],["ὁδοὶ",709458,191],["ἀνθρώπων",701163,81],["δικαίων",703694,169],["διὰ",703417,0],["δὲ",703303,11],["αὐτῶν",702165,40],["καὶ",707031,7],["οἱ",709436,136],["ἐχθροὶ",705779,138],["φίλοι",713492,138],["γίνονται",703104,269]],null],["29",[["μακρὰν",708411,28],["ἀπέχει",701405,91],["ὁ",709436,3],["θεὸς",706192,4],["ἀπὸ",701425,0],["ἀσεβῶν",701909,169],["εὐχαῖς",705726,76],["δὲ",703303,11],["δικαίων",703694,169],["ἐπακούει",705009,91]],"God is far from the ungodly; but he hearkens to the prayers of the righteous."],["29a",[["κρείσσων",707891,29],["ὀλίγη",709568,29],["λῆμψις",708183,12],["μετὰ",708780,0],["δικαιοσύνης",703695,17],["ἢ",705924,7],["πολλὰ",710646,195],["γενήματα",703052,64],["μετὰ",708780,0],["ἀδικίας",700271,17]],null],["29b",[["καρδία",707141,12],["ἀνδρὸς",701150,18],["λογιζέσθω",708232,407],["δίκαια",703694,68],["ἵνα",706747,7],["ὑπὸ",713184,0],["τοῦ",709436,35],["θεοῦ",706192,18],["διορθωθῇ",703728,384],["τὰ",709436,41],["διαβήματα",703422,42],["αὐτοῦ",702165,102]],null],["30",[["θεωρῶν",706226,72],["ὀφθαλμὸς",709870,4],["καλὰ",707097,68],["εὐφραίνει",705715,91],["καρδίαν",707141,9],["φήμη",713436,12],["δὲ",703303,11],["ἀγαθὴ",700106,29],["πιαίνει",710464,91],["ὀστᾶ",709792,42]],"The eye that sees rightly rejoices the heart; and a good report fattens the bones."],["32",[["ὃς",709781,213],["ἀπωθεῖται",701659,117],["παιδείαν",709924,9],["μισεῖ",708935,91],["ἑαυτόν",703917,85],["ὁ",709436,3],["δὲ",703303,11],["τηρῶν",712844,72],["ἐλέγχους",704415,57],["ἀγαπᾷ",700120,91],["ψυχὴν",714070,9],["αὐτοῦ",702165,102]],"He that rejects instruction hates himself; but he that minds reproofs loves his soul."],["33",[["φόβος",713534,4],["θεοῦ",706192,18],["παιδεία",709924,12],["καὶ",707031,7],["σοφία",711981,12],["καὶ",707031,7],["ἀρχὴ",701836,12],["δόξης",703791,17],["ἀποκριθήσεται",701492,134],["αὐτῇ",702165,105]],"The fear of the Lord is instruction and wisdom; and the highest honour will correspond therewith."]]