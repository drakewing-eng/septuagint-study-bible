[["1",[["κρείσσων",707891,14],["ἀνὴρ",701150,4],["ἐλέγχων",704415,81],["ἀνδρὸς",701150,18],["σκληροτραχήλου",711863,116],["ἐξαπίνης",704869,28],["γὰρ",702963,11],["φλεγομένου",713518,262],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἔστιν",704093,91],["ἴασις",706444,12]],"A reprover is better than a stiff-necked man: for when the latter is suddenly set on fire, there shall be no remedy.",{"s":"m","br":"29:1","q":1.0}],["2",[["ἐγκωμιαζομένων",704002,299],["δικαίων",703694,169],["εὐφρανθήσονται",705715,144],["λαοί",708094,52],["ἀρχόντων",701860,170],["δὲ",703303,11],["ἀσεβῶν",701909,169],["στένουσιν",712072,197],["ἄνδρες",701150,52]],"When the righteous are praised, the people will rejoice: but when the ungodly rule, men mourn.",{"s":"m","br":"29:2","q":1.0}],["3",[["ἀνδρὸς",701150,18],["φιλοῦντος",713471,152],["σοφίαν",711981,9],["εὐφραίνεται",705715,117],["πατὴρ",710189,4],["αὐτοῦ",702165,102],["ὃς",709781,213],["δὲ",703303,11],["ποιμαίνει",710594,91],["πόρνας",710675,39],["ἀπολεῖ",701513,127],["πλοῦτον",710563,6]],"When a man loves wisdom, his father rejoices: but he that keeps harlots will waste wealth.",{"s":"m","br":"29:3","q":1.0}],["4",[["βασιλεὺς",702580,4],["δίκαιος",703694,14],["ἀνίστησιν",701173,91],["χώραν",714011,9],["ἀνὴρ",701150,4],["δὲ",703303,11],["παράνομος",710080,14],["κατασκάπτει",707416,91]],"A righteous king establishes a country: but a transgressor destroys [it].",{"s":"m","br":"29:4","q":1.0}],["5",[["ὃς",709781,213],["παρασκευάζεται",710103,117],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["τοῦ",709436,35],["ἑαυτοῦ",703917,102],["φίλου",713492,116],["δίκτυον",703703,25],["περιβάλλει",710294,91],["αὐτὸ",702165,129],["τοῖς",709436,147],["ἑαυτοῦ",703917,102],["ποσίν",710707,148]],"He that prepares a net in the way of his own friend, entangles his own feet in it.",{"s":"m","br":"29:5","q":1.0}],["6",[["ἁμαρτάνοντι",700773,379],["ἀνδρὶ",701150,114],["μεγάλη",708653,29],["παγίς",709910,12],["δίκαιος",703694,14],["δὲ",703303,11],["ἐν",704639,0],["χαρᾷ",713719,1],["καὶ",707031,7],["ἐν",704639,0],["εὐφροσύνῃ",705717,1],["ἔσται",704093,93]],"A great snare [is spread] for a sinner: but the righteous shall be in joy and gladness.",{"s":"m","br":"29:6","q":1.0}],["7",[["ἐπίσταται",705264,117],["δίκαιος",703694,14],["κρίνειν",707905,55],["πενιχροῖς",710255,230],["ὁ",709436,3],["δὲ",703303,11],["ἀσεβὴς",701909,14],["οὐ",709805,28],["συνήσει",712481,127],["γνῶσιν",703138,9],["καὶ",707031,7],["πτωχῷ",711076,114],["οὐχ",709805,28],["ὑπάρχει",713104,91],["νοῦς",709374,4],["ἐπιγνώμων",705106,14]],"A righteous man knows how to judge for the poor: but the ungodly understands not knowledge; and the poor man has not an understanding mind.",{"s":"m","br":"29:7","q":0.94}],["8",[["ἄνδρες",701150,52],["λοιμοὶ",708245,138],["ἐξέκαυσαν",704205,150],["πόλιν",710612,9],["σοφοὶ",711985,138],["δὲ",703303,11],["ἀπέστρεψαν",701598,150],["ὀργήν",709728,9]],"Lawless men burn down a city: but wise men turn away wrath.",{"s":"m","br":"29:8","q":0.88}],["9",[["ἀνὴρ",701150,4],["σοφὸς",711985,14],["κρίνει",707905,91],["ἔθνη",704068,42],["ἀνὴρ",701150,4],["δὲ",703303,11],["φαῦλος",713398,14],["ὀργιζόμενος",709729,122],["καταγελᾶται",707222,117],["καὶ",707031,7],["οὐ",709805,28],["καταπτήσσει",707392,91]],"A wise man shall judge nations: but a worthless man being angry laughs and fears not.",{"s":"m","br":"29:9","q":1.0}],["10",[["ἄνδρες",701150,52],["αἱμάτων",700442,44],["μέτοχοι",708839,138],["μισήσουσιν",708935,218],["ὅσιον",709782,27],["οἱ",709436,136],["δὲ",703303,11],["εὐθεῖς",705602,138],["ἐκζητήσουσιν",704187,218],["ψυχὴν",714070,9],["αὐτοῦ",702165,102]],"Bloody men hate a holy [person], but the upright will seek his soul.",{"s":"m","br":"29:10","q":0.91}],["11",[["ὅλον",709597,27],["τὸν",709436,5],["θυμὸν",706334,6],["αὐτοῦ",702165,102],["ἐκφέρει",704356,91],["ἄφρων",702236,14],["σοφὸς",711985,14],["δὲ",703303,11],["ταμιεύεται",712703,117],["κατὰ",707200,0],["μέρος",708752,25]],"A fool utters all his mind: but the wise reserves his in part.",{"s":"m","br":"29:11","q":1.0}],["12",[["βασιλέως",702580,18],["ὑπακούοντος",713096,152],["λόγον",708236,6],["ἄδικον",700272,27],["πάντες",710177,138],["οἱ",709436,136],["ὑπ᾿",713184,0],["αὐτὸν",702165,85],["παράνομοι",710080,138]],"When a king hearkens to unjust language, all his subjects are transgressors.",{"s":"m","br":"29:12","q":1.0}],["13",[["δανιστοῦ",703280,18],["καὶ",707031,7],["χρεοφειλέτου",713944,18],["ἀλλήλοις",700689,151],["συνελθόντων",712458,221],["ἐπισκοπὴν",705255,9],["ποιεῖται",710582,117],["ἀμφοτέρων",700892,527],["ὁ",709436,3],["κύριος",707996,4]],"When the creditor and debtor meet together, the Lord oversees them both.",{"s":"m","br":"29:13","q":0.9}],["14",[["βασιλέως",702580,18],["ἐν",704639,0],["ἀληθείᾳ",700656,1],["κρίνοντος",707905,152],["πτωχοὺς",711076,57],["ὁ",709436,3],["θρόνος",706315,4],["αὐτοῦ",702165,102],["εἰς",704105,0],["μαρτύριον",708525,25],["κατασταθήσεται",707011,134]],"When a king judges the poor in truth, his throne shall be established for a testimony.",{"s":"m","br":"29:14","q":1.0}],["15",[["πληγαὶ",710527,191],["καὶ",707031,7],["ἔλεγχοι",704415,52],["διδόασιν",703654,197],["σοφίαν",711981,9],["παῖς",709932,4],["δὲ",703303,11],["πλανώμενος",710495,122],["αἰσχύνει",700485,91],["γονεῖς",703169,57],["αὐτοῦ",702165,102]],"Stripes and reproofs give wisdom: but an erring child disgraces his parents.",{"s":"m","br":"29:15","q":1.0}],["16",[["πολλῶν",710646,169],["ὄντων",704093,170],["ἀσεβῶν",701909,169],["πολλαὶ",710646,192],["γίνονται",703104,269],["ἁμαρτίαι",700775,191],["οἱ",709436,136],["δὲ",703303,11],["δίκαιοι",703694,138],["ἐκείνων",704183,40],["πιπτόντων",710481,170],["κατάφοβοι",707479,14],["γίνονται",703104,269]],"When the ungodly abound, sins abound: but when they fall, the righteous are warned.",{"s":"m","br":"29:16","q":0.92}],["17",[["παίδευε",709926,240],["υἱόν",713075,6],["σου",711945,133],["καὶ",707031,7],["ἀναπαύσει",701027,127],["σε",711598,163],["καὶ",707031,7],["δώσει",703654,127],["κόσμον",707851,6],["τῇ",709436,100],["ψυχῇ",714070,1],["σου",711945,133]],"Chasten thy son, and he shall give thee rest; and he shall give honour to thy soul.",{"s":"m","br":"29:17","q":1.0}],["18",[["οὐ",709805,28],["μὴ",708851,28],["ὑπάρξῃ",713104,172],["ἐξηγητὴς",704920,4],["ἔθνει",704068,54],["παρανόμῳ",710080,30],["ὁ",709436,3],["δὲ",703303,11],["φυλάσσων",713619,72],["τὸν",709436,5],["νόμον",709349,6],["μακαριστός",708399,14]],"There shall be no interpreter to a sinful nation: but he that observes the law is blessed.",{"s":"m","br":"29:18","q":1.0}],["19",[["λόγοις",708236,148],["οὐ",709805,28],["παιδευθήσεται",709926,134],["οἰκέτης",709496,4],["σκληρός",711861,14],["ἐὰν",703912,7],["γὰρ",702963,11],["καὶ",707031,28],["νοήσῃ",709327,172],["ἀλλ᾿",700680,7],["οὐχ",709805,28],["ὑπακούσεται",713096,93]],"A stubborn servant will not be reproved by words: for even if he understand, still he will not obey.",{"s":"m","br":"29:19","q":1.0}],["20",[["ἐὰν",703912,7],["ἴδῃς",709725,175],["ἄνδρα",701150,6],["ταχὺν",712750,27],["ἐν",704639,0],["λόγοις",708236,148],["γίνωσκε",703105,240],["ὅτι",709803,7],["ἐλπίδα",704530,9],["ἔχει",705785,91],["μᾶλλον",708448,28],["ἄφρων",702236,14],["αὐτοῦ",702165,102]],"If thou see a man hasty in [his] words, know that the fool has hope rather than he.",{"s":"m","br":"29:20","q":0.93}],["21",[["ὃς",709781,213],["κατασπαταλᾷ",707430,91],["ἐκ",704132,0],["παιδός",709932,18],["οἰκέτης",709496,4],["ἔσται",704093,93],["ἔσχατον",705519,27],["δὲ",703303,11],["ὀδυνηθήσεται",709462,134],["ἐφ᾿",705080,0],["ἑαυτῷ",703917,50]],"He that lives wantonly from a child, shall be a servant, and in the end shall grieve over himself.",{"s":"m","br":"29:21","q":1.0}],["22",[["ἀνὴρ",701150,4],["θυμώδης",706336,14],["ὀρύσσει",709775,91],["νεῖκος",709246,25],["ἀνὴρ",701150,4],["δὲ",703303,11],["ὀργίλος",709730,14],["ἐξώρυξεν",704967,2],["ἁμαρτίας",700775,39]],"A furious man stirs up strife, and a passionate man digs up sin.",{"s":"m","br":"29:22","q":0.89}],["23",[["ὕβρις",713051,12],["ἄνδρα",701150,6],["ταπεινοῖ",712717,91],["τοὺς",709436,58],["δὲ",703303,11],["ταπεινόφρονας",712716,57],["ἐρείδει",705405,91],["δόξῃ",703791,1],["κύριος",707996,4]],"Pride brings a man low, but the Lord upholds the humble-minded with honour.",{"s":"m","br":"29:23","q":1.0}],["24",[["ὃς",709781,213],["μερίζεται",708744,117],["κλέπτῃ",707714,114],["μισεῖ",708935,91],["τὴν",709436,8],["ἑαυτοῦ",703917,102],["ψυχήν",714070,9],["ἐὰν",703912,7],["δὲ",703303,11],["ὅρκου",709753,18],["προτεθέντος",710993,319],["ἀκούσαντες",700587,196],["μὴ",708851,28],["ἀναγγείλωσιν",700921,234]],"He that shares with a thief, hates his own soul: and if any having heard an oath uttered tell not of it,",{"s":"m","br":"29:24","q":1.0}],["25",[["φοβηθέντες",713532,247],["καὶ",707031,7],["αἰσχυνθέντες",700485,247],["ἀνθρώπους",701163,57],["ὑπεσκελίσθησαν",713239,99],["ὁ",709436,3],["δὲ",703303,11],["πεποιθὼς",710221,270],["ἐπὶ",705080,0],["κύριον",707996,6],["εὐφρανθήσεται",705715,134],["ἀσέβεια",701904,12],["ἀνδρὶ",701150,114],["δίδωσιν",703654,91],["σφάλμα",712576,25],["ὃς",709781,213],["δὲ",703303,11],["πέποιθεν",710221,171],["ἐπὶ",705080,0],["τῷ",709436,113],["δεσπότῃ",703379,114],["σωθήσεται",712627,134]],"[they] fearing and reverencing men [unreasonably] have been overthrown, but he that trusts in the Lord shall rejoice. Ungodliness causes a man to stumble: but he that trusts in his master shall be safe.",{"s":"m","br":"29:25","q":0.95}],["26",[["πολλοὶ",710646,138],["θεραπεύουσιν",706200,197],["πρόσωπα",710986,42],["ἡγουμένων",705931,299],["παρὰ",709995,0],["δὲ",703303,11],["κυρίου",707996,18],["γίνεται",703104,117],["τὸ",709436,24],["δίκαιον",703694,46],["ἀνδρί",701150,114]],"Many wait on the favour of rulers; but justice comes to a man from the Lord.",{"s":"m","br":"29:26","q":1.0}],["27",[["βδέλυγμα",702604,15],["δικαίοις",703694,230],["ἀνὴρ",701150,4],["ἄδικος",700272,14],["βδέλυγμα",702604,15],["δὲ",703303,11],["ἀνόμῳ",701194,30],["κατευθύνουσα",707521,188],["ὁδός",709458,12]],"A righteous man is an abomination to an unrighteous man, and the direct way is an abomination to the sinner.",{"s":"m","br":"29:27","q":0.8}]]