[["1",[["υἱέ",713075,153],["ἐὰν",703912,7],["δεξάμενος",703393,248],["ῥῆσιν",711250,9],["ἐμῆς",704578,82],["ἐντολῆς",704802,17],["κρύψῃς",707923,175],["παρὰ",709995,0],["σεαυτῷ",711599,50]],"[My] son, if thou wilt receive the utterance of my commandment, and hide it with thee;"],["2",[["ὑπακούσεται",713096,93],["σοφίας",711981,17],["τὸ",709436,34],["οὖς",709852,15],["σου",711945,133],["καὶ",707031,7],["παραβαλεῖς",709997,166],["καρδίαν",707141,9],["σου",711945,133],["εἰς",704105,0],["σύνεσιν",712460,9],["παραβαλεῖς",709997,166],["δὲ",703303,11],["αὐτὴν",702165,104],["ἐπὶ",705080,0],["νουθέτησιν",709369,9],["τῷ",709436,113],["υἱῷ",713075,114],["σου",711945,133]],"thine ear shall hearken to wisdom; thou shalt also apply thine heart to understanding, and shalt apply it to the instruction of thy son."],["3",[["ἐὰν",703912,7],["γὰρ",702963,11],["τὴν",709436,8],["σοφίαν",711981,9],["ἐπικαλέσῃ",705153,172],["καὶ",707031,7],["τῇ",709436,100],["συνέσει",712460,1],["δῷς",703654,175],["φωνήν",713640,9],["σου",711945,133],["τὴν",709436,8],["δὲ",703303,11],["αἴσθησιν",700477,9],["ζητήσῃς",705879,175],["μεγάλῃ",708653,101],["τῇ",709436,100],["φωνῇ",713640,1]],"For if thou shalt call to wisdom, and utter thy voice for understanding;"],["4",[["καὶ",707031,7],["ἐὰν",703912,7],["ζητήσῃς",705879,175],["αὐτὴν",702165,104],["ὡς",714148,7],["ἀργύριον",701707,25],["καὶ",707031,7],["ὡς",714148,7],["θησαυροὺς",706258,57],["ἐξερευνήσῃς",704905,175],["αὐτήν",702165,104]],"and if thou shalt seek it as silver, and search diligently for it as for treasures;"],["5",[["τότε",712908,28],["συνήσεις",712481,166],["φόβον",713534,6],["κυρίου",707996,18],["καὶ",707031,7],["ἐπίγνωσιν",705107,9],["θεοῦ",706192,18],["εὑρήσεις",705676,166]],"then shalt thou understand the fear of the Lord, and find the knowledge of God."],["6",[["ὅτι",709803,7],["κύριος",707996,4],["δίδωσιν",703654,91],["σοφίαν",711981,9],["καὶ",707031,7],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["γνῶσις",703138,12],["καὶ",707031,7],["σύνεσις",712460,12]],"For the Lord gives wisdom; and from his presence [come] knowledge and understanding,"],["7",[["καὶ",707031,7],["θησαυρίζει",706256,91],["τοῖς",709436,147],["κατορθοῦσι",707548,349],["σωτηρίαν",712658,9],["ὑπερασπιεῖ",713121,127],["τὴν",709436,8],["πορείαν",710665,9],["αὐτῶν",702165,40]],"and he treasures up salvation for them that walk uprightly: he will protect their way;"],["8",[["τοῦ",709436,20],["φυλάξαι",713619,106],["ὁδοὺς",709458,39],["δικαιωμάτων",703697,44],["καὶ",707031,7],["ὁδὸν",709458,9],["εὐλαβουμένων",705627,299],["αὐτὸν",702165,85],["διαφυλάξει",703632,127]],"that he may guard the righteous ways: and he will preserve the way of them that fear him."],["9",[["τότε",712908,28],["συνήσεις",712481,166],["δικαιοσύνην",703695,9],["καὶ",707031,7],["κρίμα",707903,25],["καὶ",707031,7],["κατορθώσεις",707548,166],["πάντας",710177,60],["ἄξονας",701312,57],["ἀγαθούς",700106,60]],"Then shalt thou understand righteousness, and judgment; and shalt direct all thy course aright."],["10",[["ἐὰν",703912,7],["γὰρ",702963,11],["ἔλθῃ",705453,172],["ἡ",709436,10],["σοφία",711981,12],["εἰς",704105,0],["σὴν",711943,36],["διάνοιαν",703531,9],["ἡ",709436,10],["δὲ",703303,11],["αἴσθησις",700477,12],["τῇ",709436,100],["σῇ",711943,101],["ψυχῇ",714070,1],["καλὴ",707097,29],["εἶναι",704093,55],["δόξῃ",703775,172]],"For if wisdom shall come into thine understanding, and discernment shall seem pleasing to thy soul,"],["11",[["βουλὴ",702792,12],["καλὴ",707097,29],["φυλάξει",713619,127],["σε",711598,163],["ἔννοια",704764,12],["δὲ",703303,11],["ὁσία",709782,29],["τηρήσει",712844,127],["σε",711598,163]],"good counsel shall guard thee, and holy understanding shall keep thee;"],["12",[["ἵνα",706747,7],["ῥύσηταί",711309,239],["σε",711598,163],["ἀπὸ",701425,0],["ὁδοῦ",709458,17],["κακῆς",707066,82],["καὶ",707031,7],["ἀπὸ",701425,0],["ἀνδρὸς",701150,18],["λαλοῦντος",708071,152],["μηδὲν",708857,46],["πιστόν",710486,46]],"to deliver thee from the evil way, and from the man that speaks nothing faithfully."],["13",[["ὦ",714081,88],["οἱ",709436,136],["ἐγκαταλείποντες",703967,146],["ὁδοὺς",709458,39],["εὐθείας",705602,82],["τοῦ",709436,20],["πορεύεσθαι",710667,110],["ἐν",704639,0],["ὁδοῖς",709458,76],["σκότους",711889,21]],"Alas [for those] who forsake right paths, to walk in ways of darkness;"],["14",[["οἱ",709436,136],["εὐφραινόμενοι",705715,348],["ἐπὶ",705080,0],["κακοῖς",707066,230],["καὶ",707031,7],["χαίροντες",713665,146],["ἐπὶ",705080,0],["διαστροφῇ",703593,1],["κακῇ",707066,101]],"who rejoice in evils, and delight in wicked perverseness;"],["15",[["ὧν",709781,252],["αἱ",709436,190],["τρίβοι",712939,191],["σκολιαὶ",711868,192],["καὶ",707031,7],["καμπύλαι",707119,192],["αἱ",709436,190],["τροχιαὶ",712988,191],["αὐτῶν",702165,40]],"whose paths are crooked, and their courses winding;"],["16",[["τοῦ",709436,20],["μακράν",708411,28],["σε",711598,163],["ποιῆσαι",710582,106],["ἀπὸ",701425,0],["ὁδοῦ",709458,17],["εὐθείας",705602,82],["καὶ",707031,7],["ἀλλότριον",700699,27],["τῆς",709436,16],["δικαίας",703694,82],["γνώμης",703134,17]],"to remove thee far from the straight way, and to estrange thee from a righteous purpose. [My] son, let not evil counsel overtake thee,"],["17",[["υἱέ",713075,153],["μή",708851,28],["σε",711598,163],["καταλάβῃ",707300,172],["κακὴ",707066,29],["βουλὴ",702792,12],["ἡ",709436,10],["ἀπολείπουσα",701508,188],["διδασκαλίαν",703647,9],["νεότητος",709258,17],["καὶ",707031,7],["διαθήκην",703456,9],["θείαν",706154,36],["ἐπιλελησμένη",705187,203]],"[of her] who has forsaken the instruction of her youth, and forgotten the covenant of God."],["18",[["ἔθετο",712849,23],["γὰρ",702963,11],["παρὰ",709995,0],["τῷ",709436,113],["θανάτῳ",706096,114],["τὸν",709436,5],["οἶκον",709516,6],["αὐτῆς",702165,86],["καὶ",707031,7],["παρὰ",709995,0],["τῷ",709436,113],["ᾅδῃ",700255,114],["μετὰ",708780,0],["τῶν",709436,80],["γηγενῶν",703085,169],["τοὺς",709436,58],["ἄξονας",701312,57],["αὐτῆς",702165,86]],"For she has fixed her house near death, and [guided] her wheels near Hades with the giants."],["19",[["πάντες",710177,138],["οἱ",709436,136],["πορευόμενοι",710667,348],["ἐν",704639,0],["αὐτῇ",702165,105],["οὐκ",709805,28],["ἀναστρέψουσιν",701060,218],["οὐδὲ",709816,7],["μὴ",708851,28],["καταλάβωσιν",707300,234],["τρίβους",712939,39],["εὐθείας",705602,82],["οὐ",709805,28],["γὰρ",702963,11],["καταλαμβάνονται",707300,269],["ὑπὸ",713184,0],["ἐνιαυτῶν",704745,81],["ζωῆς",705910,17]],"None that go by her shall return, neither shall they take hold of right paths, for they are not apprehended of the years of life."],["20",[["εἰ",704071,7],["γὰρ",702963,11],["ἐπορεύοντο",710667,139],["τρίβους",712939,39],["ἀγαθάς",700106,119],["εὕροσαν",705676,150],["ἂν",700900,11],["τρίβους",712939,39],["δικαιοσύνης",703695,17],["λείους",708129,119]],"For had they gone in good paths, they would have found the paths of righteousness easy."],["21",[["χρηστοὶ",713958,138],["ἔσονται",704093,135],["οἰκήτορες",709504,52],["γῆς",703083,17],["ἄκακοι",700512,138],["δὲ",703303,11],["ὑπολειφθήσονται",713212,144],["ἐν",704639,0],["αὐτῇ",702165,105],["ὅτι",709803,7],["εὐθεῖς",705602,138],["κατασκηνώσουσι",707423,218],["γῆν",703083,9],["καὶ",707031,7],["ὅσιοι",709782,138],["ὑπολειφθήσονται",713212,144],["ἐν",704639,0],["αὐτῇ",702165,105]],"For the upright shall dwell in the earth, and the holy shall be left behind in it."],["22",[["ὁδοὶ",709458,191],["ἀσεβῶν",701909,169],["ἐκ",704132,0],["γῆς",703083,17],["ὀλοῦνται",709584,135],["οἱ",709436,136],["δὲ",703303,11],["παράνομοι",710080,138],["ἐξωσθήσονται",704985,144],["ἀπ᾿",701425,0],["αὐτῆς",702165,86]],"The paths of the ungodly shall perish out of the earth, and transgressors shall be driven away from it."]]