[["1",[["υἱέ",713075,153],["ἐμῶν",704578,83],["νομίμων",709340,83],["μὴ",708851,28],["ἐπιλανθάνου",705187,253],["τὰ",709436,41],["δὲ",703303,11],["ῥήματά",711246,42],["μου",709032,133],["τηρείτω",712844,31],["σὴ",711943,29],["καρδία",707141,12]],"[My] son, forget not my laws; but let thine heart keep my words:"],["2",[["μῆκος",708868,25],["γὰρ",702963,11],["βίου",702724,18],["καὶ",707031,7],["ἔτη",705543,42],["ζωῆς",705910,17],["καὶ",707031,7],["εἰρήνην",704098,9],["προσθήσουσίν",710965,218],["σοι",711925,159]],"for length of existence, and years of life, and peace, shall they add to thee."],["3",[["ἐλεημοσύναι",704421,191],["καὶ",707031,7],["πίστεις",710484,191],["μὴ",708851,28],["ἐκλιπέτωσάν",704237,264],["σε",711598,163],["ἄφαψαι",702184,106],["δὲ",703303,11],["αὐτὰς",702165,231],["ἐπὶ",705080,0],["σῷ",711943,30],["τραχήλῳ",712924,114],["καὶ",707031,7],["εὑρήσεις",705676,166],["χάριν",713735,9]],"Let not mercy and truth forsake thee; but bind them about thy neck:"],["4",[["καὶ",707031,7],["προνοοῦ",710824,253],["καλὰ",707097,68],["ἐνώπιον",704823,28],["κυρίου",707996,18],["καὶ",707031,7],["ἀνθρώπων",701163,81]],"so shalt thou find favour: and do thou provide things honest in the sight of the Lord, and of men."],["5",[["ἴσθι",704093,240],["πεποιθὼς",710221,270],["ἐν",704639,0],["ὅλῃ",709597,101],["καρδίᾳ",707141,1],["ἐπὶ",705080,0],["θεῷ",706192,114],["ἐπὶ",705080,0],["δὲ",703303,11],["σῇ",711943,101],["σοφίᾳ",711981,1],["μὴ",708851,28],["ἐπαίρου",705002,253]],"Trust in God with all thine heart; and be not exalted in thine own wisdom."],["6",[["ἐν",704639,0],["πάσαις",710177,291],["ὁδοῖς",709458,76],["σου",711945,133],["γνώριζε",703135,240],["αὐτήν",702165,104],["ἵνα",706747,7],["ὀρθοτομῇ",709739,204],["τὰς",709436,38],["ὁδούς",709458,39],["σου",711945,133],["ὁ",709436,3],["δὲ",703303,11],["πούς",710707,4],["σου",711945,133],["οὐ",709805,28],["μὴ",708851,28],["προσκόπτῃ",710923,204]],"In all thy ways acquaint thyself with her, that she may rightly direct thy paths."],["7",[["μὴ",708851,28],["ἴσθι",704093,240],["φρόνιμος",713589,14],["παρὰ",709995,0],["σεαυτῷ",711599,50],["φοβοῦ",713532,253],["δὲ",703303,11],["τὸν",709436,5],["θεὸν",706192,6],["καὶ",707031,7],["ἔκκλινε",704220,240],["ἀπὸ",701425,0],["παντὸς",710177,116],["κακοῦ",707066,116]],"Be not wise in thine own conceit; but fear God, and depart from all evil."],["8",[["τότε",712908,28],["ἴασις",706444,12],["ἔσται",704093,93],["τῷ",709436,53],["σώματί",712635,54],["σου",711945,133],["καὶ",707031,7],["ἐπιμέλεια",705198,12],["τοῖς",709436,95],["ὀστέοις",709792,96],["σου",711945,133]],"Then shall there be health to thy body, and good keeping to thy bones."],["9",[["τίμα",712855,240],["τὸν",709436,5],["κύριον",707996,6],["ἀπὸ",701425,0],["σῶν",711943,169],["δικαίων",703694,169],["πόνων",710661,81],["καὶ",707031,7],["ἀπάρχου",701361,253],["αὐτῷ",702165,50],["ἀπὸ",701425,0],["σῶν",711943,169],["καρπῶν",707169,81],["δικαιοσύνης",703695,17]],"Honour the Lord with thy just labours, and give him the first of thy fruits of righteousness:"],["10",[["ἵνα",706747,7],["πίμπληται",710532,428],["τὰ",709436,41],["ταμίειά",712700,42],["σου",711945,133],["πλησμονῆς",710549,17],["σίτου",711814,18],["οἴνῳ",709530,114],["δὲ",703303,11],["αἱ",709436,190],["ληνοί",708176,191],["σου",711945,133],["ἐκβλύζωσιν",704151,271]],"that thy storehouses may be completely filled with corn, and that thy presses may burst forth with wine."],["11",[["υἱέ",713075,153],["μὴ",708851,28],["ὀλιγώρει",709577,240],["παιδείας",709924,17],["κυρίου",707996,18],["μηδὲ",708855,7],["ἐκλύου",704254,733],["ὑπ᾿",713184,0],["αὐτοῦ",702165,102],["ἐλεγχόμενος",704416,122]],"[My] son, despise not the chastening of the Lord; nor faint when thou art rebuked of him:"],["12",[["ὃν",709781,112],["γὰρ",702963,11],["ἀγαπᾷ",700120,91],["κύριος",707996,4],["παιδεύει",709926,91],["μαστιγοῖ",708566,91],["δὲ",703303,11],["πάντα",710177,27],["υἱὸν",713075,6],["ὃν",709781,112],["παραδέχεται",710013,117]],"for whom the Lord loves, he rebukes, and scourges every son whom he receives."],["13",[["μακάριος",708397,14],["ἄνθρωπος",701163,4],["ὃς",709781,213],["εὗρεν",705676,2],["σοφίαν",711981,9],["καὶ",707031,7],["θνητὸς",706279,14],["ὃς",709781,213],["εἶδεν",709725,2],["φρόνησιν",713588,9]],"Blessed is the man who has found wisdom, and the mortal who knows prudence."],["14",[["κρεῖττον",707891,46],["γὰρ",702963,11],["αὐτὴν",702165,104],["ἐμπορεύεσθαι",704611,110],["ἢ",705924,7],["χρυσίου",713972,21],["καὶ",707031,7],["ἀργυρίου",701707,21],["θησαυρούς",706258,57]],"For it is better to traffic for her, than for treasures of gold and silver."],["15",[["τιμιωτέρα",712858,484],["δέ",703303,11],["ἐστιν",704093,91],["λίθων",708196,81],["πολυτελῶν",710647,169],["οὐκ",709805,28],["ἀντιτάξεται",701276,93],["αὐτῇ",702165,105],["οὐδὲν",709817,46],["πονηρόν",710660,46],["εὔγνωστός",705563,14],["ἐστιν",704093,91],["πᾶσιν",710177,230],["τοῖς",709436,147],["ἐγγίζουσιν",703939,197],["αὐτῇ",702165,105],["πᾶν",710177,26],["δὲ",703303,11],["τίμιον",712858,26],["οὐκ",709805,28],["ἄξιον",701308,26],["αὐτῆς",702165,86],["ἐστιν",704093,91]],"And she is more valuable than precious stones: no evil thing shall resist her: she is well known to all that approach her, and no precious thing is equal to her in value."],["16",[["μῆκος",708868,25],["γὰρ",702963,11],["βίου",702724,18],["καὶ",707031,7],["ἔτη",705543,42],["ζωῆς",705910,17],["ἐν",704639,0],["τῇ",709436,100],["δεξιᾷ",703360,101],["αὐτῆς",702165,86],["ἐν",704639,0],["δὲ",703303,11],["τῇ",709436,100],["ἀριστερᾷ",701749,101],["αὐτῆς",702165,86],["πλοῦτος",710563,4],["καὶ",707031,7],["δόξα",703791,12]],"For length of existence and years of life are in her right hand; and in her left hand are wealth and glory:"],["16a",[["ἐκ",704132,0],["τοῦ",709436,20],["στόματος",712125,21],["αὐτῆς",702165,86],["ἐκπορεύεται",704293,117],["δικαιοσύνη",703695,12],["νόμον",709349,6],["δὲ",703303,11],["καὶ",707031,7],["ἔλεον",704426,6],["ἐπὶ",705080,0],["γλώσσης",703120,17],["φορεῖ",713554,91]],null],["17",[["αἱ",709436,190],["ὁδοὶ",709458,191],["αὐτῆς",702165,86],["ὁδοὶ",709458,191],["καλαί",707097,192],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["τρίβοι",712939,52],["αὐτῆς",702165,86],["ἐν",704639,0],["εἰρήνῃ",704098,1]],"Her ways are good ways, and all her paths are peaceful."],["18",[["ξύλον",709427,15],["ζωῆς",705910,17],["ἐστι",704093,91],["πᾶσι",710177,230],["τοῖς",709436,147],["ἀντεχομένοις",701225,341],["αὐτῆς",702165,86],["καὶ",707031,7],["τοῖς",709436,147],["ἐπερειδομένοις",705067,341],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["ὡς",714148,7],["ἐπὶ",705080,0],["κύριον",707996,6],["ἀσφαλής",702040,14]],"She is a tree of life to all that lay hold upon her; and she is [a] secure [help] to all that stay themselves on her, as on the Lord."],["19",[["ὁ",709436,3],["θεὸς",706192,4],["τῇ",709436,100],["σοφίᾳ",711981,1],["ἐθεμελίωσεν",706182,2],["τὴν",709436,8],["γῆν",703083,9],["ἡτοίμασεν",705539,2],["δὲ",703303,11],["οὐρανοὺς",709844,57],["ἐν",704639,0],["φρονήσει",713588,1]],"God by wisdom founded the earth, and by prudence he prepared the heavens."],["20",[["ἐν",704639,0],["αἰσθήσει",700477,1],["ἄβυσσοι",700098,52],["ἐρράγησαν",711243,99],["νέφη",709281,64],["δὲ",703303,11],["ἐρρύησαν",711241,150],["δρόσους",703835,39]],"By understanding were the depths broken up, and the clouds dropped water."],["21",[["υἱέ",713075,153],["μὴ",708851,28],["παραρρυῇς",710098,205],["τήρησον",712844,176],["δὲ",703303,11],["ἐμὴν",704578,36],["βουλὴν",702792,9],["καὶ",707031,7],["ἔννοιαν",704764,9]],"[My] son, let [them] not pass from [thee], but keep my counsel and understanding:"],["22",[["ἵνα",706747,7],["ζήσῃ",705851,123],["ἡ",709436,10],["ψυχή",714070,12],["σου",711945,133],["καὶ",707031,7],["χάρις",713735,12],["ᾖ",704093,204],["περὶ",710285,0],["σῷ",711943,734],["τραχήλῳ",712924,114]],"that thy soul may live, and that there may be grace round thy neck;"],["22a",[["ἔσται",704093,93],["δὲ",703303,11],["ἴασις",706444,12],["ταῖς",709436,75],["σαρξί",711537,76],["σου",711945,133],["καὶ",707031,7],["ἐπιμέλεια",705198,12],["τοῖς",709436,95],["σοῖς",711943,735],["ὀστέοις",709792,96]],null],["23",[["ἵνα",706747,7],["πορεύῃ",710667,204],["πεποιθὼς",710221,270],["ἐν",704639,0],["εἰρήνῃ",704098,1],["πάσας",710177,119],["τὰς",709436,38],["ὁδούς",709458,39],["σου",711945,133],["ὁ",709436,3],["δὲ",703303,11],["πούς",710707,4],["σου",711945,133],["οὐ",709805,28],["μὴ",708851,28],["προσκόψῃ",710923,123]],"that thou mayest go confidently in peace in all thy ways, and that thy foot may not stumble."],["24",[["ἐὰν",703912,7],["γὰρ",702963,11],["κάθῃ",707000,278],["ἄφοβος",702217,14],["ἔσῃ",704093,123],["ἐὰν",703912,7],["δὲ",703303,11],["καθεύδῃς",706996,205],["ἡδέως",705938,28],["ὑπνώσεις",713182,166]],"For if thou rest, thou shalt be undismayed; and if thou sleep, thou shalt slumber sweetly."],["25",[["καὶ",707031,7],["οὐ",709805,28],["φοβηθήσῃ",713532,364],["πτόησιν",711064,9],["ἐπελθοῦσαν",705068,610],["οὐδὲ",709816,7],["ὁρμὰς",709756,39],["ἀσεβῶν",701909,169],["ἐπερχομένας",705068,312]],"And thou shalt not be afraid of alarm coming upon thee, neither of approaching attacks of ungodly men."],["26",[["ὁ",709436,3],["γὰρ",702963,11],["κύριος",707996,4],["ἔσται",704093,93],["ἐπὶ",705080,0],["πασῶν",710177,198],["ὁδῶν",709458,65],["σου",711945,133],["καὶ",707031,7],["ἐρείσει",705405,127],["σὸν",711943,27],["πόδα",710707,6],["ἵνα",706747,7],["μὴ",708851,28],["σαλευθῇς",711403,736]],"For the Lord shall be over all thy ways, and shall establish thy foot that thou be not moved."],["27",[["μὴ",708851,28],["ἀπόσχῃ",701225,172],["εὖ",705544,28],["ποιεῖν",710582,55],["ἐνδεῆ",704671,27],["ἡνίκα",706008,28],["ἂν",700900,11],["ἔχῃ",705785,204],["ἡ",709436,10],["χείρ",713787,12],["σου",711945,133],["βοηθεῖν",702746,55]],"Forbear not to do good to the poor, whensoever thy hand may have [power] to help [him]."],["28",[["μὴ",708851,28],["εἴπης",705415,175],["ἐπανελθὼν",705023,196],["ἐπάνηκε",705024,240],["καὶ",707031,7],["αὔριον",702149,28],["δώσω",703654,165],["δυνατοῦ",703845,116],["σου",711945,133],["ὄντος",704093,152],["εὖ",705544,28],["ποιεῖν",710582,55],["οὐ",709805,28],["γὰρ",702963,11],["οἶδας",709492,266],["τί",712867,126],["τέξεται",712853,93],["ἡ",709436,10],["ἐπιοῦσα",705058,188]],"Say not, Come back another time, to-morrow I will give; while thou art able to do [him] good: for thou knowest not what the next day will bring forth."],["29",[["μὴ",708851,28],["τεκτήνῃ",712764,420],["ἐπὶ",705080,0],["σὸν",711943,27],["φίλον",713492,27],["κακὰ",707066,68],["παροικοῦντα",710156,183],["καὶ",707031,7],["πεποιθότα",710221,427],["ἐπὶ",705080,0],["σοί",711925,159]],"Devise not evil against thy friend, living near thee and trusting in thee."],["30",[["μὴ",708851,28],["φιλεχθρήσῃς",713470,175],["πρὸς",710844,0],["ἄνθρωπον",701163,6],["μάτην",708582,28],["μή",708851,28],["τι",712866,126],["εἰς",704105,0],["σὲ",711598,163],["ἐργάσηται",705383,239],["κακόν",707066,46]],"Be not ready to quarrel with a man without a cause, lest he do thee some harm."],["31",[["μὴ",708851,28],["κτήσῃ",707932,420],["κακῶν",707066,169],["ἀνδρῶν",701150,81],["ὀνείδη",709658,42],["μηδὲ",708855,7],["ζηλώσῃς",705873,175],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτῶν",702165,40]],"Procure not the reproaches of bad men, neither do thou covet their ways."],["32",[["ἀκάθαρτος",700508,14],["γὰρ",702963,11],["ἔναντι",704653,28],["κυρίου",707996,18],["πᾶς",710177,14],["παράνομος",710080,14],["ἐν",704639,0],["δὲ",703303,11],["δικαίοις",703694,230],["οὐ",709805,28],["συνεδριάζει",712428,91]],"For every transgressor is unclean before the Lord; neither does he sit among the righteous."],["33",[["κατάρα",707395,12],["θεοῦ",706192,18],["ἐν",704639,0],["οἴκοις",709516,148],["ἀσεβῶν",701909,169],["ἐπαύλεις",705048,191],["δὲ",703303,11],["δικαίων",703694,169],["εὐλογοῦνται",705631,737]],"The curse of God is in the houses of the ungodly; but the habitations of the just are blessed."],["34",[["κύριος",707996,4],["ὑπερηφάνοις",713139,230],["ἀντιτάσσεται",701276,117],["ταπεινοῖς",712714,230],["δὲ",703303,11],["δίδωσιν",703654,91],["χάριν",713735,9]],"The Lord resists the proud; but he gives grace to the humble."],["35",[["δόξαν",703791,9],["σοφοὶ",711985,138],["κληρονομήσουσιν",707724,218],["οἱ",709436,136],["δὲ",703303,11],["ἀσεβεῖς",701909,138],["ὕψωσαν",713289,150],["ἀτιμίαν",702094,9]],"The wise shall inherit glory; but the ungodly have exalted [their own] dishonour."]]