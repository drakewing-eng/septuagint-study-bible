,7],["μισητὴ",708936,29],["γυνὴ",703209,12],["ἐὰν",703912,7],["τύχῃ",713015,172],["ἀνδρὸς",701150,18],["ἀγαθοῦ",700106,116]],"or if a maid-servant should cast out her own mistress; and if a hateful woman should marry a good man.",{"s":"m","br":"24:43","q":1.0}],["24",[["τέσσαρα",712808,195],["δέ",703303,11],["ἐστιν",704093,91],["ἐλάχιστα",704388,739],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ταῦτα",709858,290],["δέ",703303,11],["ἐστιν",704093,91],["σοφώτερα",711985,344],["τῶν",709436,80],["σοφῶν",711985,169]],"And [there are] four very little things upon the earth, but these are wiser than the wise:",{"s":"m","br":"24:44","q":0.85}],["25",[["οἱ",709436,136],["μύρμηκες",709070,52],["οἷς",709781,311],["μὴ",708851,28],["ἔστιν",704093,91],["ἰσχὺς",706858,12],["καὶ",707031,7],["ἑτοιμάζονται",705539,269],["θέρους",706219,21],["τὴν",709436,8],["τροφήν",712984,9]],"the ants which are weak, and [yet ] prepare [their ] food in summer;",{"s":"m","br":"24:45","q":1.0}],["26",[["καὶ",707031,7],["οἱ",709436,136],["χοιρογρύλλιοι",713896,52],["ἔθνος",704068,15],["οὐκ",709805,28],["ἰσχυρόν",706855,26],["οἳ",709781,250],["ἐποιήσαντο",710582,189],["ἐν",704639,0],["πέτραις",710443,76],["τοὺς",709436,58],["ἑαυτῶν",703917,40],["οἴκους",709516,57]],"the rabbits also [are ] a feeble race, who make their houses in the rocks.",{"s":"m","br":"24:46","q":1.0}],["27",[["ἀβασίλευτόν",700021,26],["ἐστιν",704093,91],["ἡ",709436,10],["ἀκρὶς",700599,12],["καὶ",707031,7],["ἐκστρατεύει",704315,91],["ἀφ᾿",701425,0],["ἑνὸς",704106,92],["κελεύσματος",707600,21],["εὐτάκτως",705702,28]],"The locusts have no king, and [yet ] march orderly at one command.",{"s":"m","br":"24:47","q":0.9}],["28",[["καὶ",707031,7],["καλαβώτης",707076,4],["χερσὶν",713787,76],["ἐρειδόμενος",705404,122],["καὶ",707031,7],["εὐάλωτος",705550,14],["ὢν",704093,72],["κατοικεῖ",707534,91],["ἐν",704639,0],["ὀχυρώμασιν",709891,96],["βασιλέως",702580,18]],"And the eft, which supports itself by [its ] hands, and is easily taken,