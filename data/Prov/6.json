[["1",[["υἱέ",713075,153],["ἐὰν",703912,7],["ἐγγυήσῃ",703944,420],["σὸν",711943,27],["φίλον",713492,27],["παραδώσεις",710014,166],["σὴν",711943,36],["χεῖρα",713787,9],["ἐχθρῷ",705779,30]],"[My] son, if thou become surety for thy friend, thou shalt deliver thine hand to an enemy."],["2",[["παγὶς",709910,12],["γὰρ",702963,11],["ἰσχυρὰ",706855,29],["ἀνδρὶ",701150,114],["τὰ",709436,63],["ἴδια",706493,195],["χείλη",713781,64],["καὶ",707031,7],["ἁλίσκεται",700673,391],["χείλεσιν",713781,96],["ἰδίου",706493,92],["στόματος",712125,21]],"For a man's own lips become a strong snare to him, and he is caught with the lips of his own mouth."],["3",[["ποίει",710582,240],["υἱέ",713075,153],["ἃ",709781,69],["ἐγώ",704018,164],["σοι",711925,159],["ἐντέλλομαι",704791,254],["καὶ",707031,7],["σῴζου",712627,253],["ἥκεις",705956,154],["γὰρ",702963,11],["εἰς",704105,0],["χεῖρας",713787,39],["κακῶν",707066,169],["διὰ",703417,0],["σὸν",711943,27],["φίλον",713492,27],["ἴθι",704094,240],["μὴ",708851,28],["ἐκλυόμενος",704254,122],["παρόξυνε",710164,240],["δὲ",703303,11],["καὶ",707031,7],["τὸν",709436,5],["φίλον",713492,27],["σου",711945,133],["ὃν",709781,112],["ἐνεγυήσω",703944,174]],"[My] son, do what I command thee, and deliver thyself; for on thy friend's account thou art come into the power of evil [men]: faint not, but stir up even thy friend for whom thou art become surety."],["4",[["μὴ",708851,28],["δῷς",703654,175],["ὕπνον",713181,6],["σοῖς",711943,94],["ὄμμασιν",709616,96],["μηδὲ",708855,7],["ἐπινυστάξῃς",705216,175],["σοῖς",711943,94],["βλεφάροις",702741,96]],"Give not sleep to thine eyes, nor slumber with thine eyelids;"],["5",[["ἵνα",706747,7],["σῴζῃ",712627,278],["ὥσπερ",714163,28],["δορκὰς",703801,12],["ἐκ",704132,0],["βρόχων",702820,81],["καὶ",707031,7],["ὥσπερ",714163,28],["ὄρνεον",709762,15],["ἐκ",704132,0],["παγίδος",709910,17]],"that thou mayest deliver thyself as a doe out of the toils, and as a bird out of a snare."],["6",[["ἴθι",704094,240],["πρὸς",710844,0],["τὸν",709436,5],["μύρμηκα",709070,6],["ὦ",714081,88],["ὀκνηρέ",709550,564],["καὶ",707031,7],["ζήλωσον",705873,176],["ἰδὼν",709725,182],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["γενοῦ",703104,300],["ἐκείνου",704183,102],["σοφώτερος",711985,224]],"Go to the ant, O sluggard; and see, and emulate his ways, and become wiser than he."],["7",[["ἐκείνῳ",704183,50],["γὰρ",702963,11],["γεωργίου",703081,21],["μὴ",708851,28],["ὑπάρχοντος",713102,152],["μηδὲ",708855,7],["τὸν",709436,5],["ἀναγκάζοντα",700923,183],["ἔχων",705785,72],["μηδὲ",708855,7],["ὑπὸ",713184,0],["δεσπότην",703379,6],["ὢν",704093,72]],"For whereas he has no husbandry, nor any one to compel him, and is under no master,"],["8",[["ἑτοιμάζεται",705539,117],["θέρους",706219,21],["τὴν",709436,8],["τροφὴν",712984,9],["πολλήν",710646,36],["τε",712751,11],["ἐν",704639,0],["τῷ",709436,113],["ἀμήτῳ",700819,114],["ποιεῖται",710582,117],["τὴν",709436,8],["παράθεσιν",710027,9]],"he prepares food for himself in the summer, and lays by abundant store in harvest."],["8a",[["ἢ",705924,7],["πορεύθητι",710667,244],["πρὸς",710844,0],["τὴν",709436,8],["μέλισσαν",708702,9],["καὶ",707031,7],["μάθε",708480,176],["ὡς",714148,7],["ἐργάτις",705391,12],["ἐστὶν",704093,91],["τήν",709436,8],["τε",712751,11],["ἐργασίαν",705385,9],["ὡς",714148,7],["σεμνὴν",711682,36],["ποιεῖται",710582,117]],null],["8b",[["ἧς",709781,167],["τοὺς",709436,58],["πόνους",710661,57],["βασιλεῖς",702580,57],["καὶ",707031,7],["ἰδιῶται",706495,52],["πρὸς",710844,0],["ὑγίειαν",713058,9],["προσφέρονται",710974,269],["ποθεινὴ",710579,29],["δέ",703303,11],["ἐστιν",704093,91],["πᾶσιν",710177,230],["καὶ",707031,7],["ἐπίδοξος",705124,29]],null],["8c",[["καίπερ",707045,7],["οὖσα",704093,188],["τῇ",709436,100],["ῥώμῃ",711321,1],["ἀσθενής",701939,29],["τὴν",709436,8],["σοφίαν",711981,9],["τιμήσασα",712855,149],["προήχθη",710748,37]],null],["9",[["ἕως",705792,28],["τίνος",712867,340],["ὀκνηρέ",709550,564],["κατάκεισαι",707267,259],["πότε",710696,28],["δὲ",703303,11],["ἐξ",704132,0],["ὕπνου",713181,18],["ἐγερθήσῃ",703949,364]],"How long wilt thou lie, O sluggard? and when wilt thou awake out of sleep?"],["10",[["ὀλίγον",709568,46],["μὲν",708730,11],["ὑπνοῖς",713181,148],["ὀλίγον",709568,46],["δὲ",703303,11],["κάθησαι",707000,259],["μικρὸν",708915,46],["δὲ",703303,11],["νυστάζεις",709390,154],["ὀλίγον",709568,46],["δὲ",703303,11],["ἐναγκαλίζῃ",704641,278],["χερσὶν",713787,76],["στήθη",712089,42]],"Thou sleepest a little, and thou restest a little, and thou slumberest a short [time], and thou foldest thine arms over thy breast a little."],["11",[["εἶτ᾿",704093,738],["ἐμπαραγίνεταί",704585,117],["σοι",711925,159],["ὥσπερ",714163,28],["κακὸς",707066,14],["ὁδοιπόρος",709451,14],["ἡ",709436,10],["πενία",710254,12],["καὶ",707031,7],["ἡ",709436,10],["ἔνδεια",704672,12],["ὥσπερ",714163,28],["ἀγαθὸς",700106,14],["δρομεύς",703832,4]],"Then poverty comes upon thee as an evil traveller, and want as a swift courier:"],["11a",[["ἐὰν",703912,7],["δὲ",703303,11],["ἄοκνος",701316,14],["ᾖς",704093,205],["ἥξει",705956,127],["ὥσπερ",714163,28],["πηγὴ",710450,12],["ὁ",709436,3],["ἀμητός",700819,4],["σου",711945,133],["ἡ",709436,10],["δὲ",703303,11],["ἔνδεια",704672,12],["ὥσπερ",714163,28],["κακὸς",707066,14],["δρομεὺς",703832,4],["ἀπαυτομολήσει",701368,127]],null],["12",[["ἀνὴρ",701150,4],["ἄφρων",702236,14],["καὶ",707031,7],["παράνομος",710080,14],["πορεύεται",710667,117],["ὁδοὺς",709458,39],["οὐκ",709805,28],["ἀγαθάς",700106,119]],"A foolish man and a transgressor goes in ways that are not good."],["13",[["ὁ",709436,3],["δ᾿",703303,11],["αὐτὸς",702165,121],["ἐννεύει",704761,91],["ὀφθαλμῷ",709870,114],["σημαίνει",711745,91],["δὲ",703303,11],["ποδί",710707,114],["διδάσκει",703649,91],["δὲ",703303,11],["ἐννεύμασιν",704760,96],["δακτύλων",703259,81]],"And the same winks with the eye, and makes a sign with his foot, and teaches with the beckonings of his fingers."],["14",[["διεστραμμένῃ",703592,455],["δὲ",703303,11],["καρδίᾳ",707141,1],["τεκταίνεται",712764,117],["κακὰ",707066,68],["ἐν",704639,0],["παντὶ",710177,30],["καιρῷ",707047,114],["ὁ",709436,3],["τοιοῦτος",712878,14],["ταραχὰς",712722,39],["συνίστησιν",712482,91],["πόλει",710612,1]],"[His] perverse heart devises evils: at all times such a one causes troubles to a city."],["15",[["διὰ",703417,0],["τοῦτο",709858,129],["ἐξαπίνης",704869,28],["ἔρχεται",705453,117],["ἡ",709436,10],["ἀπώλεια",701660,12],["αὐτοῦ",702165,102],["διακοπὴ",703480,12],["καὶ",707031,7],["συντριβὴ",712519,12],["ἀνίατος",701166,29]],"Therefore his destruction shall come suddenly; overthrow and irretrievable ruin."],["16",[["ὅτι",709803,7],["χαίρει",713665,91],["πᾶσιν",710177,230],["οἷς",709781,311],["μισεῖ",708935,91],["ὁ",709436,3],["κύριος",707996,4],["συντρίβεται",712520,117],["δὲ",703303,11],["δι᾿",703417,0],["ἀκαθαρσίαν",700507,9],["ψυχῆς",714070,17]],"For he rejoices in all things which God hates, and he is ruined by reason of impurity of soul."],["17",[["ὀφθαλμὸς",709870,4],["ὑβριστοῦ",713054,116],["γλῶσσα",703120,12],["ἄδικος",700272,29],["χεῖρες",713787,191],["ἐκχέουσαι",704368,306],["αἷμα",700442,25],["δικαίου",703694,92]],"The eye of the haughty, a tongue unjust, hands shedding the blood of the just;"],["18",[["καὶ",707031,7],["καρδία",707141,12],["τεκταινομένη",712764,211],["λογισμοὺς",708234,57],["κακοὺς",707066,60],["καὶ",707031,7],["πόδες",710707,52],["ἐπισπεύδοντες",705260,146],["κακοποιεῖν",707062,55]],"and a heart devising evil thoughts, and feet hastening to do evil,—[are hateful to God]."],["19",[["ἐκκαίει",704205,91],["ψεύδη",714036,68],["μάρτυς",708527,4],["ἄδικος",700272,14],["καὶ",707031,7],["ἐπιπέμπει",705223,91],["κρίσεις",707908,39],["ἀνὰ",700902,0],["μέσον",708768,46],["ἀδελφῶν",700249,81]],"An unjust witness kindles falsehoods, and brings on quarrels between brethren."],["20",[["υἱέ",713075,153],["φύλασσε",713619,240],["νόμους",709349,57],["πατρός",710189,18],["σου",711945,133],["καὶ",707031,7],["μὴ",708851,28],["ἀπώσῃ",701659,420],["θεσμοὺς",706224,57],["μητρός",708892,17],["σου",711945,133]],"[My] son, keep the laws of thy father, and reject not the ordinances of thy mother:"],["21",[["ἄφαψαι",702184,300],["δὲ",703303,11],["αὐτοὺς",702165,62],["ἐπὶ",705080,0],["σῇ",711943,101],["ψυχῇ",714070,1],["διὰ",703417,0],["παντὸς",710177,116],["καὶ",707031,7],["ἐγκλοίωσαι",703978,300],["ἐπὶ",705080,0],["σῷ",711943,30],["τραχήλῳ",712924,114]],"but bind them upon thy soul continually, and hang them as a chain about thy neck."],["22",[["ἡνίκα",706008,28],["ἂν",700900,11],["περιπατῇς",710362,205],["ἐπάγου",709912,18],["αὐτήν",702165,104],["καὶ",707031,7],["μετὰ",708780,0],["σοῦ",711945,133],["ἔστω",704093,31],["ὡς",714148,7],["δ᾿",703303,11],["ἂν",700900,11],["καθεύδῃς",706996,205],["φυλασσέτω",713619,31],["σε",711598,163],["ἵνα",706747,7],["ἐγειρομένῳ",703949,241],["συλλαλῇ",708071,204],["σοι",711925,159]],"Whensoever thou walkest, lead this along and let it be with thee; and when thou sleepest let it keep thee; that it may talk with thee when thou wakest."],["23",[["ὅτι",709803,7],["λύχνος",708287,4],["ἐντολὴ",704802,12],["νόμου",709349,18],["καὶ",707031,7],["φῶς",713642,15],["καὶ",707031,7],["ὁδὸς",709458,12],["ζωῆς",705910,17],["ἔλεγχος",704415,4],["καὶ",707031,7],["παιδεία",709924,12]],"For the commandment of the law is a lamp and a light; a way of life; reproof also and correction:"],["24",[["τοῦ",709436,20],["διαφυλάσσειν",703632,55],["σε",711598,163],["ἀπὸ",701425,0],["γυναικὸς",703209,17],["ὑπάνδρου",713097,82],["καὶ",707031,7],["ἀπὸ",701425,0],["διαβολῆς",703427,17],["γλώσσης",703120,17],["ἀλλοτρίας",700699,82]],"to keep thee continually from a married woman, and from the calumny of a strange tongue."],["25",[["μή",708851,28],["σε",711598,163],["νικήσῃ",709309,172],["κάλλους",707093,21],["ἐπιθυμία",705147,12],["μηδὲ",708855,7],["ἀγρευθῇς",700188,279],["σοῖς",711943,230],["ὀφθαλμοῖς",709870,148],["μηδὲ",708855,7],["συναρπασθῇς",712406,279],["ἀπὸ",701425,0],["τῶν",709436,43],["αὐτῆς",702165,86],["βλεφάρων",702741,44]],"Let not the desire of beauty overcome thee, neither be thou caught by thine eyes, neither be captivated with her eyelids."],["26",[["τιμὴ",712856,12],["γὰρ",702963,11],["πόρνης",710675,17],["ὅση",709788,29],["καὶ",707031,7],["ἑνὸς",704106,116],["ἄρτου",701829,18],["γυνὴ",703209,12],["δὲ",703303,11],["ἀνδρῶν",701150,81],["τιμίας",712858,82],["ψυχὰς",714070,17],["ἀγρεύει",700188,91]],"For the value of a harlot is as much as of one loaf; and a woman hunts for the precious souls of men."],["27",[["ἀποδήσει",701446,127],["τις",712866,158],["πῦρ",711088,25],["ἐν",704639,0],["κόλπῳ",707800,114],["τὰ",709436,41],["δὲ",703303,11],["ἱμάτια",706742,42],["οὐ",709805,28],["κατακαύσει",707258,127]],"Shall any one bind fire in his bosom, and not burn his garments?"],["28",[["ἢ",705924,7],["περιπατήσει",710362,127],["τις",712866,158],["ἐπ᾿",705080,0],["ἀνθράκων",701160,81],["πυρός",711088,21],["τοὺς",709436,58],["δὲ",703303,11],["πόδας",710707,57],["οὐ",709805,28],["κατακαύσει",707258,127]],"or will any one walk on coals of fire, and not burn his feet?"],["29",[["οὕτως",709859,28],["ὁ",709436,3],["εἰσελθὼν",704114,182],["πρὸς",710844,0],["γυναῖκα",703209,9],["ὕπανδρον",713097,36],["οὐκ",709805,28],["ἀθῳωθήσεται",700391,134],["οὐδὲ",709816,7],["πᾶς",710177,14],["ὁ",709436,3],["ἁπτόμενος",701654,122],["αὐτῆς",702165,86]],"So is he that goes in to a married woman; he shall not be held guiltless, neither any one that touches her."],["30",[["οὐ",709805,28],["θαυμαστὸν",706138,27],["ἐὰν",703912,7],["ἁλῷ",700673,172],["τις",712866,158],["κλέπτων",707715,72],["κλέπτει",707715,91],["γὰρ",702963,11],["ἵνα",706747,7],["ἐμπλήσῃ",704592,172],["τὴν",709436,8],["ψυχὴν",714070,9],["πεινῶν",710223,65]],"It is not to be wondered at if one should be taken stealing, for he steals that when hungry he may satisfy his soul:"],["31",[["ἐὰν",703912,7],["δὲ",703303,11],["ἁλῷ",700673,172],["ἀποτείσει",701618,127],["ἑπταπλάσια",705368,68],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["ὑπάρχοντα",713102,237],["αὐτοῦ",702165,102],["δοὺς",703654,182],["ῥύσεται",711309,93],["ἑαυτόν",703917,85]],"but if he should be taken, he shall repay sevenfold, and shall deliver himself by giving all his goods."],["32",[["ὁ",709436,3],["δὲ",703303,11],["μοιχὸς",708980,4],["δι᾿",703417,0],["ἔνδειαν",704672,9],["φρενῶν",713578,65],["ἀπώλειαν",701660,9],["τῇ",709436,100],["ψυχῇ",714070,1],["αὐτοῦ",702165,102],["περιποιεῖται",710367,117]],"But the adulterer through want of sense procures destruction to his soul."],["33",[["ὀδύνας",709463,39],["τε",712751,11],["καὶ",707031,7],["ἀτιμίας",702094,39],["ὑποφέρει",713256,91],["τὸ",709436,34],["δὲ",703303,11],["ὄνειδος",709658,15],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐξαλειφθήσεται",704852,134],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"He endures both pain and disgrace, and his reproach shall never be wiped off."],["34",[["μεστὸς",708777,14],["γὰρ",702963,11],["ζήλου",705871,18],["θυμὸς",706334,4],["ἀνδρὸς",701150,18],["αὐτῆς",702165,86],["οὐ",709805,28],["φείσεται",713406,93],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["κρίσεως",707908,17]],"For the soul of her husband is full of jealousy: he will not spare in the day of vengeance."],["35",[["οὐκ",709805,28],["ἀνταλλάξεται",701210,93],["οὐδενὸς",709817,92],["λύτρου",708281,21],["τὴν",709436,8],["ἔχθραν",705779,36],["οὐδὲ",709816,7],["μὴ",708851,28],["διαλυθῇ",703509,384],["πολλῶν",710646,83],["δώρων",703907,44]],"He will not forego [his] enmity for any ransom: neither will he be reconciled for many gifts."]]