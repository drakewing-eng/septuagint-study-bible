[["1",[["ζυγοὶ",705894,64],["δόλιοι",703783,138],["βδέλυγμα",702604,15],["ἐνώπιον",704823,28],["κυρίου",707996,18],["στάθμιον",712039,15],["δὲ",703303,11],["δίκαιον",703694,14],["δεκτὸν",703348,14],["αὐτῷ",702165,50]],"False balances are an abomination before the Lord: but a just weight is acceptable unto him."],["2",[["οὗ",709781,48],["ἐὰν",703912,7],["εἰσέλθῃ",704114,172],["ὕβρις",713051,12],["ἐκεῖ",704181,28],["καὶ",707031,28],["ἀτιμία",702094,12],["στόμα",712125,15],["δὲ",703303,11],["ταπεινῶν",712714,169],["μελετᾷ",708698,91],["σοφίαν",711981,9]],"Wherever pride enters, there will be also disgrace: but the mouth of the lowly meditates wisdom."],["3",[["ἀποθανὼν",701461,182],["δίκαιος",703694,14],["ἔλιπεν",708131,2],["μετάμελον",708806,6],["πρόχειρος",711017,14],["δὲ",703303,11],["γίνεται",703104,117],["καὶ",707031,7],["ἐπίχαρτος",705333,14],["ἀσεβῶν",701909,169],["ἀπώλεια",701660,12]],"When a just man dies he leaves regret: but the destruction of the ungodly is speedy, and causes joy."],["5",[["δικαιοσύνη",703695,12],["ἀμώμους",700895,60],["ὀρθοτομεῖ",709739,91],["ὁδούς",709458,39],["ἀσέβεια",701904,12],["δὲ",703303,11],["περιπίπτει",710364,91],["ἀδικίᾳ",700271,1]],"Righteousness traces out blameless paths: but ungodliness encounters unjust dealing."],["6",[["δικαιοσύνη",703695,12],["ἀνδρῶν",701150,81],["ὀρθῶν",709738,169],["ῥύεται",711309,117],["αὐτούς",702165,62],["τῇ",709436,100],["δὲ",703303,11],["ἀπωλείᾳ",701660,1],["αὐτῶν",702165,40],["ἁλίσκονται",700673,699],["παράνομοι",710080,138]],"The righteousness of upright men delivers them: but transgressors are caught in their own destruction."],["7",[["τελευτήσαντος",712781,500],["ἀνδρὸς",701150,18],["δικαίου",703694,116],["οὐκ",709805,28],["ὄλλυται",709584,117],["ἐλπίς",704530,12],["τὸ",709436,34],["δὲ",703303,11],["καύχημα",707570,15],["τῶν",709436,80],["ἀσεβῶν",701909,169],["ὄλλυται",709584,117]],"At the death of a just man his hope does not perish: but the boast of the ungodly perishes."],["8",[["δίκαιος",703694,14],["ἐκ",704132,0],["θήρας",706244,17],["ἐκδύνει",704180,91],["ἀντ᾿",701227,0],["αὐτοῦ",702165,102],["δὲ",703303,11],["παραδίδοται",710014,117],["ὁ",709436,3],["ἀσεβής",701909,14]],"A righteous man escapes from a snare, and the ungodly man is delivered up in his place."],["9",[["ἐν",704639,0],["στόματι",712125,54],["ἀσεβῶν",701909,169],["παγὶς",709910,12],["πολίταις",710616,148],["αἴσθησις",700477,12],["δὲ",703303,11],["δικαίων",703694,169],["εὔοδος",705653,29]],"In the mouth of ungodly men is a snare to citizens: but the understanding of righteous men is prosperous."],["10",[["ἐν",704639,0],["ἀγαθοῖς",700106,230],["δικαίων",703694,169],["κατώρθωσεν",707548,2],["πόλις",710612,12]],"In the prosperity of righteous men a city prospers:"],["11",[["στόμασιν",712125,96],["δὲ",703303,11],["ἀσεβῶν",701909,169],["κατεσκάφη",707416,37]],"but by the mouths of ungodly men it is overthrown."],["12",[["μυκτηρίζει",709052,91],["πολίτας",710616,57],["ἐνδεὴς",704671,14],["φρενῶν",713578,65],["ἀνὴρ",701150,4],["δὲ",703303,11],["φρόνιμος",713589,14],["ἡσυχίαν",706035,9],["ἄγει",700209,91]],"A man void of understanding sneers at [his fellow] citizens: but a sensible man is quiet."],["13",[["ἀνὴρ",701150,4],["δίγλωσσος",703644,14],["ἀποκαλύπτει",701474,91],["βουλὰς",702792,39],["ἐν",704639,0],["συνεδρίῳ",712429,54],["πιστὸς",710486,14],["δὲ",703303,11],["πνοῇ",710574,1],["κρύπτει",707923,91],["πράγματα",710708,42]],"A double-tongued man discloses the [secret] counsels of an assembly: but he that is faithful in spirit conceals matters."],["14",[["οἷς",709781,311],["μὴ",708851,28],["ὑπάρχει",713104,91],["κυβέρνησις",707947,12],["πίπτουσιν",710481,197],["ὥσπερ",714163,28],["φύλλα",713622,64],["σωτηρία",712658,12],["δὲ",703303,11],["ὑπάρχει",713104,91],["ἐν",704639,0],["πολλῇ",710646,101],["βουλῇ",702792,1]],"They that have no guidance fall like leaves: but in much counsel there is safety."],["15",[["πονηρὸς",710660,14],["κακοποιεῖ",707062,91],["ὅταν",709801,28],["συμμείξῃ",712307,172],["δικαίῳ",703694,30],["μισεῖ",708935,91],["δὲ",703303,11],["ἦχον",706046,6],["ἀσφαλείας",702039,17]],"A bad man does harm wherever he meets a just man: and he hates the sound of safety."],["16",[["γυνὴ",703209,12],["εὐχάριστος",705723,29],["ἐγείρει",703949,91],["ἀνδρὶ",701150,114],["δόξαν",703791,9],["θρόνος",706315,4],["δὲ",703303,11],["ἀτιμίας",702094,17],["γυνὴ",703209,12],["μισοῦσα",708935,188],["δίκαια",703694,68],["πλούτου",710563,18],["ὀκνηροὶ",709550,138],["ἐνδεεῖς",704671,138],["γίνονται",703104,269],["οἱ",709436,136],["δὲ",703303,11],["ἀνδρεῖοι",701101,138],["ἐρείδονται",705405,699],["πλούτῳ",710563,114]],"A gracious wife brings glory to her husband: but a woman hating righteousness is a theme of dishonour. The slothful come to want: but the diligent support themselves with wealth."],["17",[["τῇ",709436,100],["ψυχῇ",714070,1],["αὐτοῦ",702165,102],["ἀγαθὸν",700106,27],["ποιεῖ",710582,91],["ἀνὴρ",701150,4],["ἐλεήμων",704422,14],["ἐξολλύει",704955,91],["δὲ",703303,11],["αὐτοῦ",702165,102],["σῶμα",712635,25],["ὁ",709436,3],["ἀνελεήμων",701120,14]],"A merciful man does good to his own soul: but the merciless destroys his own body."],["18",[["ἀσεβὴς",701909,14],["ποιεῖ",710582,91],["ἔργα",705396,42],["ἄδικα",700272,68],["σπέρμα",712008,15],["δὲ",703303,11],["δικαίων",703694,169],["μισθὸς",708939,4],["ἀληθείας",700656,17]],"An ungodly man performs unrighteous works: but the seed of the righteous is a reward of truth."],["19",[["υἱὸς",713075,4],["δίκαιος",703694,14],["γεννᾶται",703051,117],["εἰς",704105,0],["ζωήν",705910,9],["διωγμὸς",703766,4],["δὲ",703303,11],["ἀσεβοῦς",701909,116],["εἰς",704105,0],["θάνατον",706096,6]],"A righteous son is born for life: but the persecution of the ungodly [ends] in death."],["20",[["βδέλυγμα",702604,15],["κυρίῳ",707996,114],["διεστραμμέναι",703592,423],["ὁδοί",709458,191],["προσδεκτοὶ",710872,138],["δὲ",703303,11],["αὐτῷ",702165,50],["πάντες",710177,138],["ἄμωμοι",700895,138],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["αὐτῶν",702165,40]],"Perverse ways are an abomination to the Lord: but all they that are blameless in their ways are acceptable to him."],["21",[["χειρὶ",713787,1],["χεῖρας",713787,39],["ἐμβαλὼν",704547,182],["ἀδίκως",700273,28],["οὐκ",709805,28],["ἀτιμώρητος",702097,14],["ἔσται",704093,93],["ὁ",709436,3],["δὲ",703303,11],["σπείρων",712006,72],["δικαιοσύνην",703695,9],["λήμψεται",708076,93],["μισθὸν",708939,6],["πιστόν",710486,27]],"He that unjustly strikes hands shall not be unpunished: but he that sows righteousness shall receive a faithful reward."],["22",[["ὥσπερ",714163,28],["ἐνώτιον",704826,25],["ἐν",704639,0],["ῥινὶ",711268,1],["ὑός",713268,18],["οὕτως",709859,28],["γυναικὶ",703209,1],["κακόφρονι",707072,30],["κάλλος",707093,25]],"As an ornament in a swine's snout, so is beauty to an ill-minded woman."],["23",[["ἐπιθυμία",705147,12],["δικαίων",703694,169],["πᾶσα",710177,29],["ἀγαθή",700106,29],["ἐλπὶς",704530,12],["δὲ",703303,11],["ἀσεβῶν",701909,169],["ἀπολεῖται",701513,93]],"All the desire of the righteous is good: but the hope of the ungodly shall perish."],["24",[["εἰσὶν",704093,197],["οἳ",709781,250],["τὰ",709436,41],["ἴδια",706493,68],["σπείροντες",712006,146],["πλείονα",710514,27],["ποιοῦσιν",710582,197],["εἰσὶν",704093,197],["καὶ",707031,7],["οἳ",709781,250],["συνάγοντες",712375,146],["ἐλαττονοῦνται",704392,269]],"There are [some] who scatter their own, and make it more: and there are [some] also who gather, [yet] have less."],["25",[["ψυχὴ",714070,12],["εὐλογουμένη",705631,211],["πᾶσα",710177,29],["ἁπλῆ",701421,29],["ἀνὴρ",701150,4],["δὲ",703303,11],["θυμώδης",706336,14],["οὐκ",709805,28],["εὐσχήμων",705700,14]],"Every sincere soul is blessed: but a passionate man is not graceful."],["26",[["ὁ",709436,3],["συνέχων",712468,169],["σῖτον",711814,6],["ὑπολίποιτο",713212,382],["αὐτὸν",702165,85],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["εὐλογία",705633,12],["δὲ",703303,11],["εἰς",704105,0],["κεφαλὴν",707639,9],["τοῦ",709436,35],["μεταδιδόντος",708791,152]],"May he that hoards corn leave it to the nation: but blessing be on the head of him that gives [it]."],["27",[["τεκταινόμενος",712764,419],["ἀγαθὰ",700106,68],["ζητεῖ",705879,91],["χάριν",713735,9],["ἀγαθήν",700106,36],["ἐκζητοῦντα",704187,183],["δὲ",703303,11],["κακά",707066,68],["καταλήμψεται",707300,93],["αὐτόν",702165,85]],"He that devises good [counsels] seeks good favour: but [as for] him that seeks after evil, [evil] shall overtake him."],["28",[["ὁ",709436,3],["πεποιθὼς",710221,270],["ἐπὶ",705080,0],["πλούτῳ",710563,114],["οὗτος",709858,121],["πεσεῖται",710481,93],["ὁ",709436,3],["δὲ",703303,11],["ἀντιλαμβανόμενος",701243,122],["δικαίων",703694,169],["οὗτος",709858,121],["ἀνατελεῖ",701066,127]],"He that trusts in wealth shall fall; but he that helps righteous men shall rise."],["29",[["ὁ",709436,3],["μὴ",708851,28],["συμπεριφερόμενος",712330,122],["τῷ",709436,113],["ἑαυτοῦ",703917,102],["οἴκῳ",709516,114],["κληρονομήσει",707724,127],["ἄνεμον",701123,6],["δουλεύσει",703814,127],["δὲ",703303,11],["ἄφρων",702236,14],["φρονίμῳ",713589,30]],"He that deals not graciously with his own house shall inherit the wind; and the fool shall be servant to the wise man."],["30",[["ἐκ",704132,0],["καρποῦ",707169,18],["δικαιοσύνης",703695,17],["φύεται",713638,117],["δένδρον",703353,25],["ζωῆς",705910,17],["ἀφαιροῦνται",702177,269],["δὲ",703303,11],["ἄωροι",702329,192],["ψυχαὶ",714070,191],["παρανόμων",710080,169]],"Out of the fruit of righteousness grows a tree of life; but the souls of transgressors are cut off before their time."],["31",[["εἰ",704071,7],["ὁ",709436,3],["μὲν",708730,11],["δίκαιος",703694,14],["μόλις",708982,28],["σῴζεται",712627,117],["ὁ",709436,3],["ἀσεβὴς",701909,14],["καὶ",707031,7],["ἁμαρτωλὸς",700776,14],["ποῦ",710706,28],["φανεῖται",713311,93]],"If the righteous scarcely be saved, where shall the ungodly and the sinner appear?"]]