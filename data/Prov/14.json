[["1",[["σοφαὶ",711985,192],["γυναῖκες",703209,191],["ᾠκοδόμησαν",709509,150],["οἴκους",709516,57],["ἡ",709436,10],["δὲ",703303,11],["ἄφρων",702236,14],["κατέσκαψεν",707416,2],["ταῖς",709436,75],["χερσὶν",713787,76],["αὐτῆς",702165,86]],"Wise women build houses: but a foolish one digs [hers] down with her hands."],["2",[["ὁ",709436,3],["πορευόμενος",710667,122],["ὀρθῶς",709746,28],["φοβεῖται",713532,117],["τὸν",709436,5],["κύριον",707996,6],["ὁ",709436,3],["δὲ",703303,11],["σκολιάζων",711867,72],["ταῖς",709436,75],["ὁδοῖς",709458,76],["αὐτοῦ",702165,102],["ἀτιμασθήσεται",702092,134]],"He that walks uprightly fears the Lord; but he that is perverse in his ways shall be dishonoured."],["3",[["ἐκ",704132,0],["στόματος",712125,21],["ἀφρόνων",702236,169],["βακτηρία",702459,12],["ὕβρεως",713051,17],["χείλη",713781,64],["δὲ",703303,11],["σοφῶν",711985,169],["φυλάσσει",713619,91],["αὐτούς",702165,62]],"Out of the mouth of fools [comes] a rod of pride; but the lips of the wise preserve them."],["4",[["οὗ",709781,48],["μή",708851,28],["εἰσιν",704093,197],["βόες",702798,52],["φάτναι",713391,191],["καθαραί",706988,192],["οὗ",709781,48],["δὲ",703303,11],["πολλὰ",710646,195],["γενήματα",703052,64],["φανερὰ",713342,195],["βοὸς",702798,18],["ἰσχύς",706858,12]],"Where no oxen are, the cribs are clean; but where there is abundant produce, the strength of the ox is apparent."],["5",[["μάρτυς",708527,4],["πιστὸς",710486,14],["οὐ",709805,28],["ψεύδεται",714045,117],["ἐκκαίει",704205,91],["δὲ",703303,11],["ψεύδη",714036,68],["μάρτυς",708527,4],["ἄδικος",700272,14]],"A faithful witness does not lie; but an unjust witness kindles falsehoods."],["6",[["ζητήσεις",705879,166],["σοφίαν",711981,9],["παρὰ",709995,0],["κακοῖς",707066,230],["καὶ",707031,7],["οὐχ",709805,28],["εὑρήσεις",705676,166],["αἴσθησις",700477,12],["δὲ",703303,11],["παρὰ",709995,0],["φρονίμοις",713589,230],["εὐχερής",705724,29]],"Thou shalt seek wisdom with bad men, and shalt not find it; but discretion is easily available with the prudent."],["7",[["πάντα",710177,195],["ἐναντία",704656,195],["ἀνδρὶ",701150,114],["ἄφρονι",702236,30],["ὅπλα",709704,64],["δὲ",703303,11],["αἰσθήσεως",700477,17],["χείλη",713781,64],["σοφά",711985,195]],"All things are adverse to a foolish man; but wise lips are the weapons of discretion."],["8",[["σοφία",711981,12],["πανούργων",709972,169],["ἐπιγνώσεται",705104,93],["τὰς",709436,38],["ὁδοὺς",709458,39],["αὐτῶν",702165,40],["ἄνοια",701185,12],["δὲ",703303,11],["ἀφρόνων",702236,169],["ἐν",704639,0],["πλάνῃ",710496,1]],"The wisdom of the prudent will understand their ways; but the folly of fools leads astray."],["9",[["οἰκίαι",709505,191],["παρανόμων",710080,169],["ὀφειλήσουσιν",709865,218],["καθαρισμόν",706987,6],["οἰκίαι",709505,191],["δὲ",703303,11],["δικαίων",703694,169],["δεκταί",703348,192]],"The houses of transgressors will need purification; but the houses of the just are acceptable."],["10",[["καρδία",707141,12],["ἀνδρὸς",701150,18],["αἰσθητική",700479,12],["λυπηρὰ",708274,29],["ψυχὴ",714070,12],["αὐτοῦ",702165,102],["ὅταν",709801,28],["δὲ",703303,11],["εὐφραίνηται",705715,428],["οὐκ",709805,28],["ἐπιμείγνυται",705203,117],["ὕβρει",713051,1]],"[If] a man's mind is intelligent, his soul is sorrowful; and when he rejoices, he has no fellowship with pride."],["11",[["οἰκίαι",709505,191],["ἀσεβῶν",701909,169],["ἀφανισθήσονται",702182,144],["σκηναὶ",711845,191],["δὲ",703303,11],["κατορθούντων",707548,170],["στήσονται",706846,135]],"The houses of ungodly men shall be utterly destroyed; but the tabernacles of them that walk uprightly shall stand."],["12",[["ἔστιν",704093,91],["ὁδὸς",709458,12],["ἣ",709781,177],["δοκεῖ",703775,91],["ὀρθὴ",709738,29],["εἶναι",704093,55],["παρὰ",709995,0],["ἀνθρώποις",701163,148],["τὰ",709436,63],["δὲ",703303,11],["τελευταῖα",712780,195],["αὐτῆς",702165,86],["ἔρχεται",705453,117],["εἰς",704105,0],["πυθμένα",711079,6],["ᾅδου",700255,18]],"There is a way which seems to be right with men, but the ends of it reach to the depth of hell."],["13",[["ἐν",704639,0],["εὐφροσύναις",705717,76],["οὐ",709805,28],["προσμείγνυται",710935,117],["λύπη",708273,12],["τελευταία",712780,29],["δὲ",703303,11],["χαρὰ",713719,12],["εἰς",704105,0],["πένθος",710253,25],["ἔρχεται",705453,117]],"Grief mingles not with mirth; and joy in the end comes to grief."],["14",[["τῶν",709436,130],["ἑαυτοῦ",703917,102],["ὁδῶν",709458,65],["πλησθήσεται",710532,134],["θρασυκάρδιος",706298,14],["ἀπὸ",701425,0],["δὲ",703303,11],["τῶν",709436,43],["διανοημάτων",703529,44],["αὐτοῦ",702165,102],["ἀνὴρ",701150,4],["ἀγαθός",700106,14]],"A stout-hearted [man] shall be filled with his own ways; and a good man with his own thoughts."],["15",[["ἄκακος",700512,14],["πιστεύει",710483,91],["παντὶ",710177,30],["λόγῳ",708236,114],["πανοῦργος",709972,14],["δὲ",703303,11],["ἔρχεται",705453,117],["εἰς",704105,0],["μετάνοιαν",708810,9]],"The simple believes every word: but the prudent man betakes himself to after-thought."],["16",[["σοφὸς",711985,14],["φοβηθεὶς",713532,217],["ἐξέκλινεν",704220,13],["ἀπὸ",701425,0],["κακοῦ",707066,116],["ὁ",709436,3],["δὲ",703303,11],["ἄφρων",702236,14],["ἑαυτῷ",703917,50],["πεποιθὼς",710221,270],["μείγνυται",708911,117],["ἀνόμῳ",701194,30]],"A wise man fears, and departs from evil; but the fool trusts in himself, and joins himself with the transgressor."],["17",[["ὀξύθυμος",709680,14],["πράσσει",710721,91],["μετὰ",708780,0],["ἀβουλίας",700089,17],["ἀνὴρ",701150,4],["δὲ",703303,11],["φρόνιμος",713589,14],["πολλὰ",710646,68],["ὑποφέρει",713256,91]],"A passionate man acts inconsiderately; but a sensible man bears up under many things."],["18",[["μεριοῦνται",708744,135],["ἄφρονες",702236,138],["κακίαν",707054,9],["οἱ",709436,136],["δὲ",703303,11],["πανοῦργοι",709972,138],["κρατήσουσιν",707879,218],["αἰσθήσεως",700477,17]],"Fools shall have mischief for their portion; but the prudent shall take fast hold of understanding."],["19",[["ὀλισθήσουσιν",709579,218],["κακοὶ",707066,138],["ἔναντι",704653,28],["ἀγαθῶν",700106,169],["καὶ",707031,7],["ἀσεβεῖς",701909,138],["θεραπεύσουσιν",706200,218],["θύρας",706337,39],["δικαίων",703694,169]],"Evil men shall fall before the good; and the ungodly shall attend at the gates of the righteous."],["20",[["φίλοι",713492,138],["μισήσουσιν",708935,218],["φίλους",713492,60],["πτωχούς",711076,57],["φίλοι",713492,138],["δὲ",703303,11],["πλουσίων",710560,169],["πολλοί",710646,138]],"Friends will hate poor friends; but the friends of the rich are many."],["21",[["ὁ",709436,3],["ἀτιμάζων",702092,72],["πένητας",710248,57],["ἁμαρτάνει",700773,91],["ἐλεῶν",704418,72],["δὲ",703303,11],["πτωχοὺς",711076,57],["μακαριστός",708399,14]],"He that dishonours the needy sins: but he that has pity on the poor is most blessed."],["22",[["πλανώμενοι",710495,348],["τεκταίνουσι",712764,197],["κακά",707066,68],["ἔλεον",704426,6],["δὲ",703303,11],["καὶ",707031,7],["ἀλήθειαν",700656,9],["τεκταίνουσιν",712764,197],["ἀγαθοί",700106,138],["οὐκ",709805,28],["ἐπίστανται",705264,269],["ἔλεον",704426,6],["καὶ",707031,7],["πίστιν",710484,9],["τέκτονες",712766,52],["κακῶν",707066,169],["ἐλεημοσύναι",704421,191],["δὲ",703303,11],["καὶ",707031,7],["πίστεις",710484,191],["παρὰ",709995,0],["τέκτοσιν",712766,148],["ἀγαθοῖς",700106,230]],"They that go astray devise evils: but the good devise mercy and truth. The framers of evil do not understand mercy and truth: but compassion and faithfulness are with the framers of good."],["23",[["ἐν",704639,0],["παντὶ",710177,30],["μεριμνῶντι",708746,379],["ἔνεστιν",704707,91],["περισσόν",710387,26],["ὁ",709436,3],["δὲ",703303,11],["ἡδὺς",705945,14],["καὶ",707031,7],["ἀνάλγητος",700986,14],["ἐν",704639,0],["ἐνδείᾳ",704672,1],["ἔσται",704093,93]],"With every one [who is] careful there is abundance: but the pleasure-taking and indolent shall be in want."],["24",[["στέφανος",712083,4],["σοφῶν",711985,169],["πανοῦργος",709972,14],["ἡ",709436,10],["δὲ",703303,11],["διατριβὴ",703615,12],["ἀφρόνων",702236,169],["κακή",707066,29]],"A prudent man is the crown of the wise: but the occupation of fools is evil."],["25",[["ῥύσεται",711309,93],["ἐκ",704132,0],["κακῶν",707066,169],["ψυχὴν",714070,9],["μάρτυς",708527,4],["πιστός",710486,14],["ἐκκαίει",704205,91],["δὲ",703303,11],["ψεύδη",714036,68],["δόλιος",703783,14]],"A faithful witness shall deliver a soul from evil: but a deceitful [man] kindles falsehoods."],["26",[["ἐν",704639,0],["φόβῳ",713534,114],["κυρίου",707996,18],["ἐλπὶς",704530,12],["ἰσχύος",706858,17],["τοῖς",709436,147],["δὲ",703303,11],["τέκνοις",712761,96],["αὐτοῦ",702165,102],["καταλείπει",707305,91],["ἔρεισμα",705407,25]],"In the fear of the Lord is strong confidence: and he leaves his children a support."],["27",[["πρόσταγμα",710959,15],["κυρίου",707996,18],["πηγὴ",710450,12],["ζωῆς",705910,17],["ποιεῖ",710582,91],["δὲ",703303,11],["ἐκκλίνειν",704220,55],["ἐκ",704132,0],["παγίδος",709910,17],["θανάτου",706096,18]],"The commandment of the Lord is a fountain of life; and it causes [men] to turn aside from the snare of death."],["28",[["ἐν",704639,0],["πολλῷ",710646,97],["ἔθνει",704068,54],["δόξα",703791,12],["βασιλέως",702580,18],["ἐν",704639,0],["δὲ",703303,11],["ἐκλείψει",704239,1],["λαοῦ",708094,18],["συντριβὴ",712519,12],["δυνάστου",703844,18]],"In a populous nation is the glory of a king: but in the failure of people is the ruin of a prince."],["29",[["μακρόθυμος",708420,14],["ἀνὴρ",701150,4],["πολὺς",710646,14],["ἐν",704639,0],["φρονήσει",713588,1],["ὁ",709436,3],["δὲ",703303,11],["ὀλιγόψυχος",709574,14],["ἰσχυρῶς",706857,28],["ἄφρων",702236,14]],"A man slow to wrath abounds in wisdom: but a man of impatient spirit is very foolish."],["30",[["πραΰθυμος",710723,14],["ἀνὴρ",701150,4],["καρδίας",707141,17],["ἰατρός",706459,4],["σὴς",711943,82],["δὲ",703303,11],["ὀστέων",709792,44],["καρδία",707141,12],["αἰσθητική",700479,12]],"A meek-spirited man is a healer of the heart: but a sensitive heart is a corruption of the bones."],["31",[["ὁ",709436,3],["συκοφαντῶν",712257,81],["πένητα",710248,6],["παροξύνει",710164,91],["τὸν",709436,5],["ποιήσαντα",710582,365],["αὐτόν",702165,85],["ὁ",709436,3],["δὲ",703303,11],["τιμῶν",712855,72],["αὐτὸν",702165,85],["ἐλεᾷ",704412,91],["πτωχόν",711076,6]],"He that oppresses the needy provokes his Maker: but he that honours him has pity upon the poor."],["32",[["ἐν",704639,0],["κακίᾳ",707054,1],["αὐτοῦ",702165,102],["ἀπωσθήσεται",701659,134],["ἀσεβής",701909,14],["ὁ",709436,3],["δὲ",703303,11],["πεποιθὼς",710221,270],["τῇ",709436,100],["ἑαυτοῦ",703917,102],["ὁσιότητι",709783,1],["δίκαιος",703694,14]],"The ungodly shall be driven away in his wickedness: but he who is secure in his own holiness is just."],["33",[["ἐν",704639,0],["καρδίᾳ",707141,1],["ἀγαθῇ",700106,101],["ἀνδρὸς",701150,18],["σοφία",711981,12],["ἐν",704639,0],["δὲ",703303,11],["καρδίᾳ",707141,1],["ἀφρόνων",702236,169],["οὐ",709805,28],["διαγινώσκεται",703435,117]],"There is wisdom in the good heart of a man: but in the heart of fools it is not discerned."],["34",[["δικαιοσύνη",703695,12],["ὑψοῖ",713288,54],["ἔθνος",704068,25],["ἐλασσονοῦσι",704386,197],["δὲ",703303,11],["φυλὰς",713620,39],["ἁμαρτίαι",700775,191]],"Righteousness exalts a nation: but sins diminish tribes."],["35",[["δεκτὸς",703348,14],["βασιλεῖ",702580,114],["ὑπηρέτης",713179,4],["νοήμων",709329,14],["τῇ",709436,100],["δὲ",703303,11],["ἑαυτοῦ",703917,102],["εὐστροφίᾳ",705697,1],["ἀφαιρεῖται",702177,117],["ἀτιμίαν",702094,9]],"An understanding servant is acceptable to a king; and by his good behaviour he removes disgrace."]]