[["1",[["προφάσεις",711004,39],["ζητεῖ",705879,91],["ἀνὴρ",701150,4],["βουλόμενος",702795,122],["χωρίζεσθαι",714014,110],["ἀπὸ",701425,0],["φίλων",713492,169],["ἐν",704639,0],["παντὶ",710177,30],["δὲ",703303,11],["καιρῷ",707047,114],["ἐπονείδιστος",705347,14],["ἔσται",704093,93]],"A man who wishes to separate from friends seeks excuses; but at all times he will be liable to reproach."],["2",[["οὐ",709805,28],["χρείαν",713938,9],["ἔχει",705785,91],["σοφίας",711981,17],["ἐνδεὴς",704671,14],["φρενῶν",713578,65],["μᾶλλον",708448,28],["γὰρ",702963,11],["ἄγεται",700209,117],["ἀφροσύνῃ",702235,1]],"A senseless man feels no need of wisdom, for he is rather led by folly."],["3",[["ὅταν",709801,28],["ἔλθῃ",705453,172],["ἀσεβὴς",701909,14],["εἰς",704105,0],["βάθος",702376,25],["κακῶν",707066,169],["καταφρονεῖ",707482,91],["ἐπέρχεται",705068,117],["δὲ",703303,11],["αὐτῷ",702165,50],["ἀτιμία",702094,12],["καὶ",707031,7],["ὄνειδος",709658,15]],"When an ungodly man comes into a depth of evils, he despises [them]; but dishonour and reproach come upon him."],["4",[["ὕδωρ",713071,15],["βαθὺ",702381,26],["λόγος",708236,4],["ἐν",704639,0],["καρδίᾳ",707141,1],["ἀνδρός",701150,18],["ποταμὸς",710693,4],["δὲ",703303,11],["ἀναπηδύει",701031,91],["καὶ",707031,7],["πηγὴ",710450,12],["ζωῆς",705910,17]],"A word in the heart of a man is a deep water, and a river and fountain of life spring forth."],["5",[["θαυμάσαι",706135,106],["πρόσωπον",710986,25],["ἀσεβοῦς",701909,116],["οὐ",709805,28],["καλόν",707097,26],["οὐδὲ",709816,7],["ὅσιον",709782,26],["ἐκκλίνειν",704220,55],["τὸ",709436,24],["δίκαιον",703694,46],["ἐν",704639,0],["κρίσει",707908,1]],"[It is] not good to accept the person of the ungodly, nor [is it] holy to pervert justice in judgment."],["6",[["χείλη",713781,64],["ἄφρονος",702236,116],["ἄγουσιν",700209,197],["αὐτὸν",702165,85],["εἰς",704105,0],["κακά",707066,68],["τὸ",709436,34],["δὲ",703303,11],["στόμα",712125,15],["αὐτοῦ",702165,102],["τὸ",709436,34],["θρασὺ",706300,26],["θάνατον",706096,6],["ἐπικαλεῖται",705153,117]],"The lips of a fool bring [him] into troubles, and his bold mouth calls for death."],["7",[["στόμα",712125,15],["ἄφρονος",702236,116],["συντριβὴ",712519,12],["αὐτῷ",702165,50],["τὰ",709436,63],["δὲ",703303,11],["χείλη",713781,64],["αὐτοῦ",702165,102],["παγὶς",709910,12],["τῇ",709436,100],["ψυχῇ",714070,1],["αὐτοῦ",702165,102]],"A fool's mouth is ruin to him, and his lips are a snare to his soul."],["8",[["ὀκνηροὺς",709550,60],["καταβάλλει",707203,91],["φόβος",713534,4],["ψυχαὶ",714070,191],["δὲ",703303,11],["ἀνδρογύνων",701106,169],["πεινάσουσιν",710222,218]],"Fear casts down the slothful; and the souls of the effeminate shall hunger."],["9",[["ὁ",709436,3],["μὴ",708851,28],["ἰώμενος",706424,122],["ἑαυτὸν",703917,85],["ἐν",704639,0],["τοῖς",709436,95],["ἔργοις",705396,96],["αὐτοῦ",702165,102],["ἀδελφός",700249,4],["ἐστιν",704093,91],["τοῦ",709436,35],["λυμαινομένου",708270,262],["ἑαυτόν",703917,85]],"A man who helps not himself by his labour is brother of him that ruins himself."],["10",[["ἐκ",704132,0],["μεγαλωσύνης",708652,17],["ἰσχύος",706858,17],["ὄνομα",709666,15],["κυρίου",707996,18],["αὐτῷ",702165,50],["δὲ",703303,11],["προσδραμόντες",710967,196],["δίκαιοι",703694,138],["ὑψοῦνται",713289,699]],"The name of the Lord is of great strength; and the righteous running to it are exalted."],["11",[["ὕπαρξις",713101,12],["πλουσίου",710560,116],["ἀνδρὸς",701150,18],["πόλις",710612,12],["ὀχυρά",709889,29],["ἡ",709436,10],["δὲ",703303,11],["δόξα",703791,12],["αὐτῆς",702165,86],["μέγα",708653,46],["ἐπισκιάζει",705253,91]],"The wealth of a rich man is a strong city; and its glory casts a broad shadow."],["12",[["πρὸ",710747,0],["συντριβῆς",712519,17],["ὑψοῦται",713289,391],["καρδία",707141,12],["ἀνδρός",701150,18],["καὶ",707031,7],["πρὸ",710747,0],["δόξης",703791,17],["ταπεινοῦται",712717,117]],"Before ruin a man's heart is exalted, and before honour it is humble."],["13",[["ὃς",709781,213],["ἀποκρίνεται",701492,117],["λόγον",708236,6],["πρὶν",710742,28],["ἀκοῦσαι",700587,106],["ἀφροσύνη",702235,12],["αὐτῷ",702165,50],["ἐστιν",704093,91],["καὶ",707031,7],["ὄνειδος",709658,15]],"Whoso answers a word before he hears [a cause], it is folly and reproach to him."],["14",[["θυμὸν",706334,6],["ἀνδρὸς",701150,18],["πραΰνει",710724,91],["θεράπων",706201,4],["φρόνιμος",713589,14],["ὀλιγόψυχον",709574,27],["δὲ",703303,11],["ἄνδρα",701150,6],["τίς",712867,158],["ὑποίσει",713256,127]],"A wise servant calms a man's anger; but who can endure a faint-hearted man?"],["15",[["καρδία",707141,12],["φρονίμου",713589,116],["κτᾶται",707932,117],["αἴσθησιν",700477,9],["ὦτα",709852,64],["δὲ",703303,11],["σοφῶν",711985,169],["ζητεῖ",705879,91],["ἔννοιαν",704764,9]],"The heart of the sensible [man] purchases discretion; and the ears of the wise seek understanding."],["16",[["δόμα",703789,15],["ἀνθρώπου",701163,18],["ἐμπλατύνει",704596,91],["αὐτὸν",702165,85],["καὶ",707031,7],["παρὰ",709995,0],["δυνάσταις",703844,148],["καθιζάνει",707005,91],["αὐτόν",702165,85]],"A man's gift enlarges him, and seats him among princes."],["17",[["δίκαιος",703694,14],["ἑαυτοῦ",703917,102],["κατήγορος",707528,4],["ἐν",704639,0],["πρωτολογίᾳ",711038,1],["ὡς",714148,7],["δ᾿",703303,11],["ἂν",700900,11],["ἐπιβάλῃ",705083,172],["ὁ",709436,3],["ἀντίδικος",701233,14],["ἐλέγχεται",704416,117]],"A righteous man accuses himself at the beginning of his speech, but when he has entered upon the attack, the adversary is reproved."],["18",[["ἀντιλογίας",701249,39],["παύει",710202,91],["κλῆρος",707727,4],["ἐν",704639,0],["δὲ",703303,11],["δυνάσταις",703844,148],["ὁρίζει",709748,91]],"A silent [man] quells strifes, and determines between great powers."],["19",[["ἀδελφὸς",700249,4],["ὑπὸ",713184,0],["ἀδελφοῦ",700249,18],["βοηθούμενος",702746,122],["ὡς",714148,7],["πόλις",710612,12],["ὀχυρὰ",709889,29],["καὶ",707031,7],["ὑψηλή",713285,29],["ἰσχύει",706859,91],["δὲ",703303,11],["ὥσπερ",714163,28],["τεθεμελιωμένον",706182,469],["βασίλειον",702578,25]],"A brother helped by a brother is as a strong and high city; and is [as] strong as a [well]-founded palace."],["20",[["ἀπὸ",701425,0],["καρπῶν",707169,81],["στόματος",712125,21],["ἀνὴρ",701150,4],["πίμπλησιν",710532,91],["κοιλίαν",707761,9],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["δὲ",703303,11],["καρπῶν",707169,81],["χειλέων",713781,44],["αὐτοῦ",702165,102],["ἐμπλησθήσεται",704592,134]],"A man fills his belly with the fruits of his mouth; and he shall be satisfied with the fruits of his lips."],["21",[["θάνατος",706096,4],["καὶ",707031,7],["ζωὴ",705910,12],["ἐν",704639,0],["χειρὶ",713787,1],["γλώσσης",703120,17],["οἱ",709436,136],["δὲ",703303,11],["κρατοῦντες",707879,146],["αὐτῆς",702165,86],["ἔδονται",705495,135],["τοὺς",709436,58],["καρποὺς",707169,57],["αὐτῆς",702165,86]],"Life and death are in the power of the tongue; and they that rule it shall eat the fruits thereof."],["22",[["ὃς",709781,213],["εὗρεν",705676,2],["γυναῖκα",703209,9],["ἀγαθήν",700106,36],["εὗρεν",705676,2],["χάριτας",713735,39],["ἔλαβεν",708076,2],["δὲ",703303,11],["παρὰ",709995,0],["θεοῦ",706192,18],["ἱλαρότητα",706724,9]],"He that has found a good wife has found favours, and has received gladness from God."],["22a",[["ὃς",709781,213],["ἐκβάλλει",704145,91],["γυναῖκα",703209,9],["ἀγαθήν",700106,36],["ἐκβάλλει",704145,91],["τὰ",709436,41],["ἀγαθά",700106,68],["ὁ",709436,3],["δὲ",703303,11],["κατέχων",707526,72],["μοιχαλίδα",708975,9],["ἄφρων",702236,14],["καὶ",707031,7],["ἀσεβής",701909,14]],null]]