[["1",[["οἱ",709436,136],["ἐμοὶ",704577,159],["λόγοι",708236,52],["εἴρηνται",705415,255],["ὑπὸ",713184,0],["θεοῦ",706192,18],["βασιλέως",702580,18],["χρηματισμός",713950,4],["ὃν",709781,112],["ἐπαίδευσεν",709926,2],["ἡ",709436,10],["μήτηρ",708892,12],["αὐτοῦ",702165,102]],null],["2",[["τί",712867,126],["τέκνον",712761,297],["τηρήσεις",712844,166],["τί",712867,126],["ῥήσεις",711241,166],["θεοῦ",706192,18],["πρωτογενές",711034,26],["σοὶ",711925,159],["λέγω",708124,157],["υἱέ",713075,153],["τί",712867,126],["τέκνον",712761,297],["ἐμῆς",704578,82],["κοιλίας",707761,17],["τί",712867,126],["τέκνον",712761,297],["ἐμῶν",704578,198],["εὐχῶν",705726,65]],null],["3",[["μὴ",708851,28],["δῷς",703654,175],["γυναιξὶ",703209,76],["σὸν",711943,27],["πλοῦτον",710563,6],["καὶ",707031,7],["τὸν",709436,5],["σὸν",711943,27],["νοῦν",709374,6],["καὶ",707031,7],["βίον",702724,6],["εἰς",704105,0],["ὑστεροβουλίαν",713272,9]],null],["4",[["μετὰ",708780,0],["βουλῆς",702792,17],["πάντα",710177,68],["ποίει",710582,240],["μετὰ",708780,0],["βουλῆς",702792,17],["οἰνοπότει",709528,240],["οἱ",709436,136],["δυνάσται",703844,52],["θυμώδεις",706336,138],["εἰσίν",704093,197],["οἶνον",709530,6],["δὲ",703303,11],["μὴ",708851,28],["πινέτωσαν",710478,56]],null],["5",[["ἵνα",706747,7],["μὴ",708851,28],["πιόντες",710478,196],["ἐπιλάθωνται",705187,232],["τῆς",709436,16],["σοφίας",711981,17],["καὶ",707031,7],["ὀρθὰ",709738,68],["κρῖναι",707905,106],["οὐ",709805,28],["μὴ",708851,28],["δύνωνται",703838,380],["τοὺς",709436,58],["ἀσθενεῖς",701939,60]],null],["6",[["δίδοτε",703654,87],["μέθην",708667,9],["τοῖς",709436,147],["ἐν",704639,0],["λύπαις",708273,76],["καὶ",707031,7],["οἶνον",709530,6],["πίνειν",710478,55],["τοῖς",709436,147],["ἐν",704639,0],["ὀδύναις",709463,76]],null],["7",[["ἵνα",706747,7],["ἐπιλάθωνται",705187,232],["τῆς",709436,16],["πενίας",710254,17],["καὶ",707031,7],["τῶν",709436,80],["πόνων",710661,81],["μὴ",708851,28],["μνησθῶσιν",708923,272],["ἔτι",705538,28]],null],["8",[["ἄνοιγε",701186,240],["σὸν",711943,46],["στόμα",712125,25],["λόγῳ",708236,114],["θεοῦ",706192,18],["καὶ",707031,7],["κρῖνε",707905,240],["πάντας",710177,60],["ὑγιῶς",713060,28]],null],["9",[["ἄνοιγε",701186,240],["σὸν",711943,46],["στόμα",712125,25],["καὶ",707031,7],["κρῖνε",707905,240],["δικαίως",703698,28],["διάκρινε",703488,240],["δὲ",703303,11],["πένητα",710248,6],["καὶ",707031,7],["ἀσθενῆ",701939,27]],null],["10",[["γυναῖκα",703209,9],["ἀνδρείαν",701101,36],["τίς",712867,158],["εὑρήσει",705676,127],["τιμιωτέρα",712858,178],["δέ",703303,11],["ἐστιν",704093,91],["λίθων",708196,81],["πολυτελῶν",710647,169],["ἡ",709436,10],["τοιαύτη",712878,29]],"Who shall find a virtuous woman? for such a one is more valuable than precious stones."],["11",[["θαρσεῖ",706122,91],["ἐπ᾿",705080,0],["αὐτῇ",702165,105],["ἡ",709436,10],["καρδία",707141,12],["τοῦ",709436,35],["ἀνδρὸς",701150,18],["αὐτῆς",702165,86],["ἡ",709436,10],["τοιαύτη",712878,29],["καλῶν",707097,83],["σκύλων",711902,44],["οὐκ",709805,28],["ἀπορήσει",701559,127]],"The heart of her husband trusts in her: such a one shall stand in no need of fine spoils."],["12",[["ἐνεργεῖ",704718,91],["γὰρ",702963,11],["τῷ",709436,113],["ἀνδρὶ",701150,114],["ἀγαθὰ",700106,68],["πάντα",710177,27],["τὸν",709436,5],["βίον",702724,6]],"For she employs all her living for her husband's good."],["13",[["μηρυομένη",708888,211],["ἔρια",705426,42],["καὶ",707031,7],["λίνον",708213,25],["ἐποίησεν",710582,2],["εὔχρηστον",705729,46],["ταῖς",709436,75],["χερσὶν",713787,76],["αὐτῆς",702165,86]],"Gathering wool and flax, she makes it serviceable with her hands."],["14",[["ἐγένετο",703104,23],["ὡσεὶ",714159,28],["ναῦς",709208,12],["ἐμπορευομένη",704611,211],["μακρόθεν",708417,28],["συνάγει",712375,91],["δὲ",703303,11],["αὕτη",709858,107],["τὸν",709436,5],["βίον",702724,6]],"She is like a ship trading from a distance: so she procures her livelihood."],["15",[["καὶ",707031,7],["ἀνίσταται",701173,117],["ἐκ",704132,0],["νυκτῶν",709386,65],["καὶ",707031,7],["ἔδωκεν",703654,2],["βρώματα",702823,42],["τῷ",709436,113],["οἴκῳ",709516,114],["καὶ",707031,7],["ἔργα",705396,42],["ταῖς",709436,75],["θεραπαίναις",706197,76]],"And she rises by night, and gives food to her household, and [appointed] tasks to her maidens."],["16",[["θεωρήσασα",706226,149],["γεώργιον",703081,25],["ἐπρίατο",710740,23],["ἀπὸ",701425,0],["δὲ",703303,11],["καρπῶν",707169,81],["χειρῶν",713787,65],["αὐτῆς",702165,86],["κατεφύτευσεν",707487,2],["κτῆμα",707933,25]],"She views a farm, and buys it: and with the fruit of her hands she plants a possession."],["17",[["ἀναζωσαμένη",700945,357],["ἰσχυρῶς",706857,28],["τὴν",709436,8],["ὀσφὺν",709800,9],["αὐτῆς",702165,86],["ἤρεισεν",705405,2],["τοὺς",709436,58],["βραχίονας",702808,57],["αὐτῆς",702165,86],["εἰς",704105,0],["ἔργον",705396,25]],"She strongly girds her loins, and strengthens her arms for work."],["18",[["ἐγεύσατο",703074,23],["ὅτι",709803,7],["καλόν",707097,26],["ἐστιν",704093,91],["τὸ",709436,34],["ἐργάζεσθαι",705383,110],["καὶ",707031,7],["οὐκ",709805,28],["ἀποσβέννυται",701567,117],["ὅλην",709597,36],["τὴν",709436,8],["νύκτα",709386,9],["ὁ",709436,3],["λύχνος",708287,4],["αὐτῆς",702165,86]],"And she finds by experience that working is good; and her candle goes not out all night."],["19",[["τοὺς",709436,58],["πήχεις",710462,57],["αὐτῆς",702165,86],["ἐκτείνει",704322,91],["ἐπὶ",705080,0],["τὰ",709436,41],["συμφέροντα",712353,237],["τὰς",709436,38],["δὲ",703303,11],["χεῖρας",713787,39],["αὐτῆς",702165,86],["ἐρείδει",705405,91],["εἰς",704105,0],["ἄτρακτον",702105,6]],"She reaches forth her arms to needful [works], and applies her hands to the spindle."],["20",[["χεῖρας",713787,39],["δὲ",703303,11],["αὐτῆς",702165,86],["διήνοιξεν",703532,2],["πένητι",710248,114],["καρπὸν",707169,6],["δὲ",703303,11],["ἐξέτεινεν",704322,2],["πτωχῷ",711076,114]],"And she opens her hands to the needy, and reaches out fruit to the poor."],["21",[["οὐ",709805,28],["φροντίζει",713590,91],["τῶν",709436,80],["ἐν",704639,0],["οἴκῳ",709516,114],["ὁ",709436,3],["ἀνὴρ",701150,4],["αὐτῆς",702165,86],["ὅταν",709801,28],["που",710706,28],["χρονίζῃ",713967,204],["πάντες",710177,138],["γὰρ",702963,11],["οἱ",709436,136],["παρ᾿",709995,0],["αὐτῆς",702165,86],["ἐνδιδύσκονται",704688,269]],"Her husband is not anxious about those at home when he tarries anywhere abroad: for all her household are clothed."],["22",[["δισσὰς",703744,119],["χλαίνας",713871,39],["ἐποίησεν",710582,2],["τῷ",709436,113],["ἀνδρὶ",701150,114],["αὐτῆς",702165,86],["ἐκ",704132,0],["δὲ",703303,11],["βύσσου",702834,17],["καὶ",707031,7],["πορφύρας",710682,17],["ἑαυτῇ",703917,105],["ἐνδύματα",704698,42]],"She makes for her husband clothes of double texture, and garments for herself of fine linen and scarlet."],["23",[["περίβλεπτος",710296,14],["δὲ",703303,11],["γίνεται",703104,117],["ἐν",704639,0],["πύλαις",711082,76],["ὁ",709436,3],["ἀνὴρ",701150,4],["αὐτῆς",702165,86],["ἡνίκα",706008,28],["ἂν",700900,11],["καθίσῃ",707006,172],["ἐν",704639,0],["συνεδρίῳ",712429,54],["μετὰ",708780,0],["τῶν",709436,80],["γερόντων",703065,81],["κατοίκων",707540,81],["τῆς",709436,16],["γῆς",703083,17]],"And her husband becomes a distinguished [person] in the gates, when he sits in council with the old inhabitants of the land."],["24",[["σινδόνας",711795,39],["ἐποίησεν",710582,2],["καὶ",707031,7],["ἀπέδοτο",701449,23],["περιζώματα",710316,42],["δὲ",703303,11],["τοῖς",709436,147],["Χαναναίοις",713711,148]],"She makes fine linens, and sells girdles to the Chananites: she opens her mouth heedfully and with propriety, and controls her tongue."],["25",[["στόμα",712125,25],["αὐτῆς",702165,86],["διήνοιξεν",703532,2],["προσεχόντως",710894,28],["καὶ",707031,7],["ἐννόμως",704767,28],["καὶ",707031,7],["τάξιν",712712,9],["ἐστείλατο",712063,23],["τῇ",709436,100],["γλώσσῃ",703120,1],["αὐτῆς",702165,86]],"She puts on strength and honour; and rejoices in the last days."],["26",[["ἰσχὺν",706858,9],["καὶ",707031,7],["εὐπρέπειαν",705666,9],["ἐνεδύσατο",704701,23],["καὶ",707031,7],["εὐφράνθη",705715,37],["ἐν",704639,0],["ἡμέραις",705984,76],["ἐσχάταις",705519,291]],"The ways of her household are careful, and she eats not the bread of idleness."],["27",[["στεγναὶ",712058,192],["διατριβαὶ",703615,191],["οἴκων",709516,81],["αὐτῆς",702165,86],["σῖτα",711814,42],["δὲ",703303,11],["ὀκνηρὰ",709550,68],["οὐκ",709805,28],["ἔφαγεν",713296,2]],"But she opens her mouth wisely, and according to law."],["28",[["τὸ",709436,24],["στόμα",712125,25],["δὲ",703303,11],["ἀνοίγει",701186,91],["σοφῶς",711986,28],["καὶ",707031,7],["νομοθέσμως",709345,28],["ἡ",709436,10],["δὲ",703303,11],["ἐλεημοσύνη",704421,12],["αὐτῆς",702165,86],["ἀνέστησεν",701173,2],["τὰ",709436,63],["τέκνα",712761,64],["αὐτῆς",702165,86],["καὶ",707031,28],["ἐπλούτησαν",710561,150],["καὶ",707031,7],["ὁ",709436,3],["ἀνὴρ",701150,4],["αὐτῆς",702165,86],["ᾔνεσεν",700459,2],["αὐτήν",702165,104]],"And [her] kindness to them sets up her children for them, and they grow rich, and her husband praises her."],["29",[["πολλαὶ",710646,192],["θυγατέρες",706320,191],["ἐκτήσαντο",707932,189],["πλοῦτον",710563,6],["πολλαὶ",710646,192],["ἐποίησαν",710582,150],["δυνατά",703845,68],["σὺ",712181,164],["δὲ",703303,11],["ὑπέρκεισαι",713145,259],["καὶ",707031,7],["ὑπερῆρας",713116,162],["πάσας",710177,119]],"Many daughters have obtained wealth, many have wrought valiantly; but thou hast exceeded, thou hast surpassed all."],["30",[["ψευδεῖς",714036,192],["ἀρέσκειαι",701721,191],["καὶ",707031,7],["μάταιον",708575,26],["κάλλος",707093,15],["γυναικός",703209,17],["γυνὴ",703209,12],["γὰρ",702963,11],["συνετὴ",712464,29],["εὐλογεῖται",705631,117],["φόβον",713534,6],["δὲ",703303,11],["κυρίου",707996,18],["αὕτη",709858,107],["αἰνείτω",700459,31]],"Charms are false, and woman's beauty is vain: for it is a wise woman that is blessed, and let her praise the fear of the Lord."],["31",[["δότε",703654,74],["αὐτῇ",702165,105],["ἀπὸ",701425,0],["καρπῶν",707169,81],["χειρῶν",713787,65],["αὐτῆς",702165,86],["καὶ",707031,7],["αἰνείσθω",700459,407],["ἐν",704639,0],["πύλαις",711082,76],["ὁ",709436,3],["ἀνὴρ",701150,4],["αὐτῆς",702165,86]],"Give her of the fruit of her lips; and let her husband be praised in the gates."]]