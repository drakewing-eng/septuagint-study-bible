[["1",[["ὥσπερ",714163,28],["δρόσος",703835,12],["ἐν",704639,0],["ἀμήτῳ",700819,114],["καὶ",707031,7],["ὥσπερ",714163,28],["ὑετὸς",713074,4],["ἐν",704639,0],["θέρει",706219,54],["οὕτως",709859,28],["οὐκ",709805,28],["ἔστιν",704093,91],["ἄφρονι",702236,30],["τιμή",712856,12]],"As dew in harvest, and as rain in summer, so honour is not [seemly] for a fool.",{"s":"m","br":"26:1","q":0.93}],["2",[["ὥσπερ",714163,28],["ὄρνεα",709762,64],["πέταται",710434,117],["καὶ",707031,7],["στρουθοί",712167,52],["οὕτως",709859,28],["ἀρὰ",701665,12],["ματαία",708575,29],["οὐκ",709805,28],["ἐπελεύσεται",705068,93],["οὐδενί",709817,30]],"As birds and sparrows fly, so a curse shall not come upon any one without a cause.",{"s":"m","br":"26:2","q":1.0}],["3",[["ὥσπερ",714163,28],["μάστιξ",708568,12],["ἵππῳ",706790,114],["καὶ",707031,7],["κέντρον",707616,15],["ὄνῳ",709671,114],["οὕτως",709859,28],["ῥάβδος",711135,12],["ἔθνει",704068,54],["παρανόμῳ",710080,97]],"As a whip for a horse, and a goad for an ass, so [is] a rod for a simple nation.",{"s":"m","br":"26:3","q":1.0}],["4",[["μὴ",708851,28],["ἀποκρίνου",701492,253],["ἄφρονι",702236,30],["πρὸς",710844,0],["τὴν",709436,8],["ἐκείνου",704183,102],["ἀφροσύνην",702235,9],["ἵνα",706747,7],["μὴ",708851,28],["ὅμοιος",709626,14],["γένῃ",703104,420],["αὐτῷ",702165,50]],"Answer not a fool according to his folly, lest thou become like him.",{"s":"m","br":"26:4","q":1.0}],["5",[["ἀλλὰ",700680,7],["ἀποκρίνου",701492,253],["ἄφρονι",702236,30],["κατὰ",707200,0],["τὴν",709436,8],["ἀφροσύνην",702235,9],["αὐτοῦ",702165,102],["ἵνα",706747,7],["μὴ",708851,28],["φαίνηται",713311,428],["σοφὸς",711985,14],["παρ᾿",709995,0],["ἑαυτῷ",703917,50]],"Yet answer a fool according to his folly, lest he seem wise in his own conceit.",{"s":"m","br":"26:5","q":1.0}],["6",[["ἐκ",704132,0],["τῶν",709436,80],["ἑαυτοῦ",703917,102],["ποδῶν",710707,81],["ὄνειδος",709658,25],["πίεται",710478,93],["ὁ",709436,3],["ἀποστείλας",701592,182],["δι᾿",703417,0],["ἀγγέλου",700140,18],["ἄφρονος",702236,116],["λόγον",708236,6]],"He that sends a message by a foolish messenger procures for himself a reproach from his own ways.",{"s":"m","br":"26:6","q":0.83}],["7",[["ἀφελοῦ",702177,300],["πορείαν",710665,9],["σκελῶν",711831,44],["καὶ",707031,7],["παροιμίαν",710160,9],["ἐκ",704132,0],["στόματος",712125,21],["ἀφρόνων",702236,169]],"[As well] take away the motion of the legs, as transgression from the mouth of fools.",{"s":"m","br":"26:7","q":0.88}],["8",[["ὃς",709781,213],["ἀποδεσμεύει",701443,91],["λίθον",708196,6],["ἐν",704639,0],["σφενδόνῃ",712578,1],["ὅμοιός",709626,14],["ἐστιν",704093,91],["τῷ",709436,113],["διδόντι",703654,379],["ἄφρονι",702236,30],["δόξαν",703791,9]],"He that binds up a stone in a sling, is like one that gives glory to a fool.",{"s":"m","br":"26:8","q":0.91}],["9",[["ἄκανθαι",700517,191],["φύονται",713638,269],["ἐν",704639,0],["χειρὶ",713787,1],["τοῦ",709436,35],["μεθύσου",708675,116],["δουλεία",703813,12],["δὲ",703303,11],["ἐν",704639,0],["χειρὶ",713787,1],["τῶν",709436,80],["ἀφρόνων",702236,169]],"Thorns grow in the hand of a drunkard, and servitude in the hand of fools.",{"s":"m","br":"26:9","q":0.92}],["10",[["πολλὰ",710646,68],["χειμάζεται",713782,391],["πᾶσα",710177,29],["σὰρξ",711537,12],["ἀφρόνων",702236,169],["συντρίβεται",712520,391],["γὰρ",702963,11],["ἡ",709436,10],["ἔκστασις",704314,12],["αὐτῶν",702165,40]],"All the flesh of fools endures much hardship; for their fury is brought to nought.",{"s":"m","br":"26:10","q":1.0}],["11",[["ὥσπερ",714163,28],["κύων",708004,4],["ὅταν",709801,28],["ἐπέλθῃ",705068,172],["ἐπὶ",705080,0],["τὸν",709436,5],["ἑαυτοῦ",703917,102],["ἔμετον",704562,6],["καὶ",707031,7],["μισητὸς",708936,14],["γένηται",703104,239],["οὕτως",709859,28],["ἄφρων",702236,14],["τῇ",709436,100],["ἑαυτοῦ",703917,102],["κακίᾳ",707054,1],["ἀναστρέψας",701060,182],["ἐπὶ",705080,0],["τὴν",709436,8],["ἑαυτοῦ",703917,102],["ἁμαρτίαν",700775,9]],"As when a dog goes to his own vomit, and becomes abominable, so is a fool who returns in his wickedness to his own sin.",{"s":"m","br":"26:11","q":1.0}],["11a",[["ἔστιν",704093,91],["αἰσχύνη",700483,12],["ἐπάγουσα",704994,188],["ἁμαρτίαν",700775,9],["καὶ",707031,7],["ἔστιν",704093,91],["αἰσχύνη",700483,12],["δόξα",703791,12],["καὶ",707031,7],["χάρις",713735,12]],"[There is a shame that brings sin: and there is a shame [that is] glory and grace.]",{"s":"m","br":"26:11a","q":1.0}],["12",[["εἶδον",709725,155],["ἄνδρα",701150,6],["δόξαντα",703775,365],["παρ᾿",709995,0],["ἑαυτῷ",703917,50],["σοφὸν",711985,27],["εἶναι",704093,55],["ἐλπίδα",704530,9],["μέντοι",708734,11],["ἔσχεν",705785,2],["μᾶλλον",708448,28],["ἄφρων",702236,14],["αὐτοῦ",702165,102]],"I have seen a man who seemed to himself to be wise; but a fool had more hope than he.",{"s":"m","br":"26:12","q":0.85}],["13",[["λέγει",708124,91],["ὀκνηρὸς",709550,14],["ἀποστελλόμενος",701592,122],["εἰς",704105,0],["ὁδόν",709458,9],["λέων",708171,4],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76]],"A sluggard when sent on a journey says, [There is] a lion in the ways, and [there are] murderers in the streets.",{"s":"m","br":"26:13","q":0.62,"gd":0.62}],["14",[["ὥσπερ",714163,28],["θύρα",706337,12],["στρέφεται",712160,117],["ἐπὶ",705080,0],["τοῦ",709436,35],["στρόφιγγος",712170,18],["οὕτως",709859,28],["ὀκνηρὸς",709550,14],["ἐπὶ",705080,0],["τῆς",709436,16],["κλίνης",707737,17],["αὐτοῦ",702165,102]],"As a door turns on the hinge, so does a sluggard on his bed.",{"s":"m","br":"26:14","q":1.0}],["15",[["κρύψας",707923,182],["ὀκνηρὸς",709550,14],["τὴν",709436,8],["χεῖρα",713787,9],["ἐν",704639,0],["τῷ",709436,113],["κόλπῳ",707800,114],["αὐτοῦ",702165,102],["οὐ",709805,28],["δυνήσεται",703838,93],["ἐπενεγκεῖν",705322,106],["ἐπὶ",705080,0],["τὸ",709436,24],["στόμα",712125,25]],"A sluggard having hid his hand in his bosom, will not be able to bring it up to his mouth.",{"s":"m","br":"26:15","q":0.93}],["16",[["σοφώτερος",711985,224],["ἑαυτῷ",703917,50],["ὀκνηρὸς",709550,14],["φαίνεται",713311,117],["τοῦ",709436,35],["ἐν",704639,0],["πλησμονῇ",710549,1],["ἀποκομίζοντος",701488,152],["ἀγγελίαν",700139,9]],"A sluggard seems to himself wiser than one who most satisfactorily brings back a message.",{"s":"m","br":"26:16","q":1.0}],["17",[["ὥσπερ",714163,28],["ὁ",709436,3],["κρατῶν",707879,72],["κέρκου",707633,17],["κυνός",708004,18],["οὕτως",709859,28],["ὁ",709436,3],["προεστὼς",710803,270],["ἀλλοτρίας",700699,82],["κρίσεως",707908,17]],"As he that lays hold of a dog's tail, so is he that makes himself the champion of another's cause.",{"s":"m","br":"26:17","q":1.0}],["18",[["ὥσπερ",714163,28],["οἱ",709436,136],["ἰώμενοι",706424,348],["προβάλλουσιν",710764,197],["λόγους",708236,57],["εἰς",704105,0],["ἀνθρώπους",701163,57],["ὁ",709436,3],["δὲ",703303,11],["ἀπαντήσας",701345,182],["τῷ",709436,113],["λόγῳ",708236,114],["πρῶτος",711041,140],["ὑποσκελισθήσεται",713239,134]],"As those who need correction put forth [fair] words to men, and he that first falls in with the proposal will be overthrown;",{"s":"m","br":"26:18","q":1.0}],["19",[["οὕτως",709859,28],["πάντες",710177,138],["οἱ",709436,136],["ἐνεδρεύοντες",704703,146],["τοὺς",709436,58],["ἑαυτῶν",703917,40],["φίλους",713492,60],["ὅταν",709801,28],["δὲ",703303,11],["φωραθῶσιν",713641,272],["λέγουσιν",708124,197],["ὅτι",709803,7],["παίζων",709931,72],["ἔπραξα",710721,155]],"so are all that lay wait for their own friends, and when they are discovered, say, I did it in jest.",{"s":"m","br":"26:19","q":0.93}],["20",[["ἐν",704639,0],["πολλοῖς",710646,94],["ξύλοις",709427,96],["θάλλει",706073,91],["πῦρ",711088,15],["ὅπου",709710,11],["δὲ",703303,11],["οὐκ",709805,28],["ἔστιν",704093,91],["δίθυμος",703687,14],["ἡσυχάζει",706033,91],["μάχη",708601,12]],"With much wood fire increases; but where there is not a double-minded man, strife ceases.",{"s":"m","br":"26:20","q":0.92}],["21",[["ἐσχάρα",705514,12],["ἄνθραξιν",701160,148],["καὶ",707031,7],["ξύλα",709427,64],["πυρί",711088,54],["ἀνὴρ",701150,4],["δὲ",703303,11],["λοίδορος",708243,14],["εἰς",704105,0],["ταραχὴν",712722,9],["μάχης",708601,17]],"A hearth for coals, and wood for fire; and a railing man for the tumult of strife.",{"s":"m","br":"26:21","q":1.0}],["22",[["λόγοι",708236,52],["κερκώπων",707634,81],["μαλακοί",708438,138],["οὗτοι",709858,201],["δὲ",703303,11],["τύπτουσιν",713022,197],["εἰς",704105,0],["ταμίεια",712700,42],["σπλάγχνων",712018,44]],"The words of cunning knaves are soft; but they smite [even] to the inmost parts of the bowels.",{"s":"m","br":"26:22","q":1.0}],["23",[["ἀργύριον",701707,15],["διδόμενον",703654,208],["μετὰ",708780,0],["δόλου",703787,18],["ὥσπερ",714163,28],["ὄστρακον",709796,15],["ἡγητέον",705934,28],["χείλη",713781,64],["λεῖα",708129,195],["καρδίαν",707141,9],["καλύπτει",707102,91],["λυπηράν",708274,36]],"Silver dishonestly given is to be considered as a potsherd: smooth lips cover a grievous heart.",{"s":"m","br":"26:23","q":1.0}],["24",[["χείλεσιν",713781,96],["πάντα",710177,68],["ἐπινεύει",705211,91],["ἀποκλαιόμενος",701482,122],["ἐχθρός",705779,14],["ἐν",704639,0],["δὲ",703303,11],["τῇ",709436,100],["καρδίᾳ",707141,1],["τεκταίνεται",712764,117],["δόλους",703787,57]],"A weeping enemy promises all things with his lips, but in his heart he contrives deceit.",{"s":"m","br":"26:24","q":1.0}],["25",[["ἐάν",703912,7],["σου",711945,133],["δέηται",703394,428],["ὁ",709436,3],["ἐχθρὸς",705779,14],["μεγάλῃ",708653,101],["τῇ",709436,100],["φωνῇ",713640,1],["μὴ",708851,28],["πεισθῇς",710221,279],["ἑπτὰ",705357,59],["γάρ",702963,11],["εἰσιν",704093,197],["πονηρίαι",710659,191],["ἐν",704639,0],["τῇ",709436,100],["ψυχῇ",714070,1],["αὐτοῦ",702165,102]],"Though [thine] enemy intreat thee with a loud voice, consent not: for there are seven abominations in his heart.",{"s":"m","br":"26:25","q":0.94}],["26",[["ὁ",709436,3],["κρύπτων",707923,72],["ἔχθραν",705775,9],["συνίστησιν",712482,91],["δόλον",703787,6],["ἐκκαλύπτει",704208,91],["δὲ",703303,11],["τὰς",709436,38],["ἑαυτοῦ",703917,102],["ἁμαρτίας",700775,39],["εὔγνωστος",705563,14],["ἐν",704639,0],["συνεδρίοις",712429,96]],"He that hides enmity frames deceit: but being easily discerned, exposes his own sins in the public assemblies.",{"s":"m","br":"26:26","q":1.0}],["27",[["ὁ",709436,3],["ὀρύσσων",709775,72],["βόθρον",702749,6],["τῷ",709436,113],["πλησίον",710547,28],["ἐμπεσεῖται",704593,93],["εἰς",704105,0],["αὐτόν",702165,85],["ὁ",709436,3],["δὲ",703303,11],["κυλίων",707967,72],["λίθον",708196,6],["ἐφ᾿",705080,0],["ἑαυτὸν",703917,85],["κυλίει",707967,91]],"He that digs a pit for his neighbour shall fall into it: and he that rolls a stone, rolls it upon himself.",{"s":"m","br":"26:27","q":1.0}],["28",[["γλῶσσα",703120,12],["ψευδὴς",714036,29],["μισεῖ",708935,91],["ἀλήθειαν",700656,9],["στόμα",712125,15],["δὲ",703303,11],["ἄστεγον",702013,26],["ποιεῖ",710582,91],["ἀκαταστασίας",700530,39]],"A lying tongue hates the truth; and an unguarded mouth causes tumults.",{"s":"m","br":"26:28","q":1.0}]]