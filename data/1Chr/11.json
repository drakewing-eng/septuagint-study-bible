[["1",[["καὶ",707031,7],["ἦλθεν",705453,2],["πᾶς",710177,14],["Ισραηλ",706839,4],["πρὸς",710844,0],["Δαυιδ",703232,6],["ἐν",704639,0],["Χεβρων",713777,1],["λέγοντες",708124,146],["ἰδοὺ",706497,88],["ὀστᾶ",709792,64],["σου",711945,133],["καὶ",707031,7],["σάρκες",711537,191],["σου",711945,133],["ἡμεῖς",705983,219]],"And all Israel came to David in Chebron, saying, Behold, we [are] thy bones and thy flesh."],["2",[["καὶ",707031,7],["ἐχθὲς",713853,28],["καὶ",707031,7],["τρίτην",712968,36],["ὄντος",704093,152],["Σαουλ",711499,18],["βασιλέως",702580,18],["σὺ",712181,164],["ἦσθα",704093,363],["ὁ",709436,3],["ἐξάγων",704834,72],["καὶ",707031,7],["εἰσάγων",704107,72],["τὸν",709436,5],["Ισραηλ",706839,6],["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σού",711945,133],["σοι",711925,159],["σὺ",712181,164],["ποιμανεῖς",710594,166],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["τὸν",709436,5],["Ισραηλ",706839,6],["καὶ",707031,7],["σὺ",712181,164],["ἔσῃ",704093,123],["εἰς",704105,0],["ἡγούμενον",705931,212],["ἐπὶ",705080,0],["Ισραηλ",706839,6]],"And heretofore when Saul was king, thou wast he that led Israel in and out, and the Lord of Israel said to thee, Thou shalt feed my people Israel, and thou shalt be for a ruler over Israel."],["3",[["καὶ",707031,7],["ἦλθον",705453,150],["πάντες",710177,138],["πρεσβύτεροι",710735,52],["Ισραηλ",706839,18],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["εἰς",704105,0],["Χεβρων",713777,9],["καὶ",707031,7],["διέθετο",703609,23],["αὐτοῖς",702165,151],["ὁ",709436,3],["βασιλεὺς",702580,4],["Δαυιδ",703232,4],["διαθήκην",703456,9],["ἐν",704639,0],["Χεβρων",713777,1],["ἐναντίον",704654,0],["κυρίου",707996,18],["καὶ",707031,7],["ἔχρισαν",713965,150],["τὸν",709436,5],["Δαυιδ",703232,6],["εἰς",704105,0],["βασιλέα",702580,6],["ἐπὶ",705080,0],["Ισραηλ",706839,6],["κατὰ",707200,0],["τὸν",709436,5],["λόγον",708236,6],["κυρίου",707996,18],["διὰ",703417,0],["χειρὸς",713787,17],["Σαμουηλ",711473,18]],"And all the elders of Israel came to the king to Chebron; and king David made a covenant with them in Chebron before the Lord: and they anointed David to be king over Israel, according to the word of the Lord by Samuel."],["4",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["ἄνδρες",701150,52],["Ισραηλ",706839,18],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["αὕτη",709858,107],["Ιεβους",706517,12],["καὶ",707031,7],["ἐκεῖ",704181,28],["οἱ",709436,136],["Ιεβουσαῖοι",706519,52],["οἱ",709436,136],["κατοικοῦντες",707534,146],["τὴν",709436,8],["γῆν",703083,9]],"And the king and his men went to Jerusalem, this [is] Jebus; and there the Jebusites the inhabitants of the land said to David,"],["5",[["εἶπαν",705373,150],["δὲ",703303,11],["οἱ",709436,136],["κατοικοῦντες",707534,146],["Ιεβους",706517,1],["τῷ",709436,113],["Δαυιδ",703232,114],["οὐκ",709805,28],["εἰσελεύσῃ",704114,123],["ὧδε",714090,28],["καὶ",707031,7],["προκατελάβετο",710809,23],["τὴν",709436,8],["περιοχὴν",710360,9],["Σιων",711816,17],["αὕτη",709858,107],["ἡ",709436,10],["πόλις",710612,12],["Δαυιδ",703232,18]],"Thou shalt not enter in hither. But he took the strong hold of Sion: this [is] the city of David."],["6",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["πᾶς",710177,14],["τύπτων",713022,72],["Ιεβουσαῖον",706519,6],["ἐν",704639,0],["πρώτοις",711041,343],["καὶ",707031,7],["ἔσται",704093,93],["εἰς",704105,0],["ἄρχοντα",701862,6],["καὶ",707031,7],["εἰς",704105,0],["στρατηγόν",712144,6],["καὶ",707031,7],["ἀνέβη",700905,2],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["ἐν",704639,0],["πρώτοις",711041,343],["Ιωαβ",706877,4],["υἱὸς",713075,4],["Σαρουια",711539,17],["καὶ",707031,7],["ἐγένετο",703104,23],["εἰς",704105,0],["ἄρχοντα",701862,6]],"And David said, Whoever first smites the Jebusite, even he shall be chief and captain. And Joab the son of Saruia went up first, and became chief."],["7",[["καὶ",707031,7],["ἐκάθισεν",707006,2],["Δαυιδ",703232,4],["ἐν",704639,0],["τῇ",709436,100],["περιοχῇ",710360,1],["διὰ",703417,0],["τοῦτο",709858,129],["ἐκάλεσεν",707084,2],["αὐτὴν",702165,104],["πόλιν",710612,9],["Δαυιδ",703232,18]],"And David dwelt in the strong hold; therefore he called it the city of David."],["8",[["καὶ",707031,7],["ᾠκοδόμησεν",709509,2],["τὴν",709436,8],["πόλιν",710612,9],["κύκλῳ",707959,114],["καὶ",707031,7],["ἐπολέμησεν",710601,2],["καὶ",707031,7],["ἔλαβεν",708076,2],["τὴν",709436,8],["πόλιν",710612,9]],"And he fortified the city round about."],["9",[["καὶ",707031,7],["ἐπορεύετο",710667,19],["Δαυιδ",703232,4],["πορευόμενος",710667,122],["καὶ",707031,7],["μεγαλυνόμενος",708647,122],["καὶ",707031,7],["κύριος",707996,4],["παντοκράτωρ",709986,4],["μετ᾿",708780,0],["αὐτοῦ",702165,102]],"And David continued to increase, and the Lord Almighty [was] with him."],["10",[["καὶ",707031,7],["οὗτοι",709858,201],["οἱ",709436,136],["ἄρχοντες",701862,52],["τῶν",709436,80],["δυνατῶν",703845,169],["οἳ",709781,250],["ἦσαν",704093,137],["τῷ",709436,113],["Δαυιδ",703232,114],["οἱ",709436,136],["κατισχύοντες",707531,146],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῇ",709436,100],["βασιλείᾳ",702577,1],["αὐτοῦ",702165,102],["μετὰ",708780,0],["παντὸς",710177,116],["Ισραηλ",706839,18],["τοῦ",709436,20],["βασιλεῦσαι",702581,106],["αὐτὸν",702165,85],["κατὰ",707200,0],["τὸν",709436,5],["λόγον",708236,6],["κυρίου",707996,18],["ἐπὶ",705080,0],["Ισραηλ",706839,6]],"And these [are] the chiefs of the mighty men, whom David had, who strengthened [themselves] with him in his kingdom, with all Israel, to make him king, according to the word of the Lord concerning Israel."],["11",[["καὶ",707031,7],["οὗτος",709858,121],["ὁ",709436,3],["ἀριθμὸς",701744,4],["τῶν",709436,80],["δυνατῶν",703845,169],["τοῦ",709436,35],["Δαυιδ",703232,18],["Ιεσεβααλ",706656,4],["υἱὸς",713075,4],["Αχαμανι",702248,18],["πρῶτος",711041,140],["τῶν",709436,80],["τριάκοντα",712934,59],["οὗτος",709858,121],["ἐσπάσατο",712003,23],["τὴν",709436,8],["ῥομφαίαν",711291,9],["αὐτοῦ",702165,102],["ἅπαξ",701350,28],["ἐπὶ",705080,0],["τριακοσίους",712936,60],["τραυματίας",712921,4],["ἐν",704639,0],["καιρῷ",707047,114],["ἑνί",704106,30]],"And this [is] the list of the mighty [men] of David; Jesebada, son of Achaman, first of the thirty: he drew his sword once against three hundred whom he slew at one time."],["12",[["καὶ",707031,7],["μετ᾿",708780,0],["αὐτὸν",702165,85],["Ελεαζαρ",704407,4],["υἱὸς",713075,4],["Δωδαι",703885,18],["ὁ",709436,3],["Αχωχι",702319,4],["οὗτος",709858,121],["ἦν",704093,13],["ἐν",704639,0],["τοῖς",709436,147],["τρισὶν",712927,230],["δυνατοῖς",703845,230]],"And after him Eleazar son of Dodai, the Achochite: he was among the three mighty men."],["13",[["οὗτος",709858,121],["ἦν",704093,13],["μετὰ",708780,0],["Δαυιδ",703232,18],["ἐν",704639,0],["Φασοδομιν",713386,1],["καὶ",707031,7],["οἱ",709436,136],["ἀλλόφυλοι",700706,52],["συνήχθησαν",712375,99],["ἐκεῖ",704181,28],["εἰς",704105,0],["πόλεμον",710605,6],["καὶ",707031,7],["ἦν",704093,13],["μερὶς",708748,12],["τοῦ",709436,35],["ἀγροῦ",700196,18],["πλήρης",710541,14],["κριθῶν",707900,65],["καὶ",707031,7],["ὁ",709436,3],["λαὸς",708094,4],["ἔφυγεν",713433,2],["ἀπὸ",701425,0],["προσώπου",710986,21],["ἀλλοφύλων",700706,81]],"He was with David in Phasodamin, and the Philistines were gathered there to battle, and [there was] a portion of the field full of barley; and the people fled before the Philistines."],["14",[["καὶ",707031,7],["ἔστη",706846,2],["ἐν",704639,0],["μέσῳ",708768,30],["τῆς",709436,16],["μερίδος",708748,17],["καὶ",707031,7],["ἔσωσεν",712627,2],["αὐτὴν",702165,104],["καὶ",707031,7],["ἐπάταξεν",710185,2],["τοὺς",709436,58],["ἀλλοφύλους",700706,60],["καὶ",707031,7],["ἐποίησεν",710582,2],["κύριος",707996,4],["σωτηρίαν",712658,9],["μεγάλην",708653,36]],"And he stood in the midst of the portion, and rescued it, and smote the Philistines; and the Lord wrought a great deliverance."],["15",[["καὶ",707031,7],["κατέβησαν",707202,150],["τρεῖς",712927,138],["ἐκ",704132,0],["τῶν",709436,80],["τριάκοντα",712934,59],["ἀρχόντων",701862,81],["εἰς",704105,0],["τὴν",709436,8],["πέτραν",710443,9],["πρὸς",710844,0],["Δαυιδ",703232,6],["εἰς",704105,0],["τὸ",709436,24],["σπήλαιον",712012,25],["Οδολλαμ",709452,18],["καὶ",707031,7],["παρεμβολὴ",710133,12],["τῶν",709436,80],["ἀλλοφύλων",700706,81],["παρεμβεβλήκει",710132,171],["ἐν",704639,0],["τῇ",709436,100],["κοιλάδι",707758,1],["τῶν",709436,80],["γιγάντων",703101,81]],"And three of the thirty chiefs went down to the rock to David, to the cave of Odollam, and the camp of the Philistines [was] in the giants' valley."],["16",[["καὶ",707031,7],["Δαυιδ",703232,4],["τότε",712908,28],["ἐν",704639,0],["τῇ",709436,100],["περιοχῇ",710359,204],["καὶ",707031,7],["τὸ",709436,34],["σύστεμα",712559,15],["τῶν",709436,80],["ἀλλοφύλων",700706,81],["τότε",712908,28],["ἐν",704639,0],["Βαιθλεεμ",702420,111]],"And David [was] then in the hold, and the garrison of the Philistines [was] then in Bethleem."],["17",[["καὶ",707031,7],["ἐπεθύμησεν",705141,2],["Δαυιδ",703232,4],["καὶ",707031,7],["εἶπεν",705373,2],["τίς",712867,121],["ποτιεῖ",710700,127],["με",708618,163],["ὕδωρ",713071,25],["ἐκ",704132,0],["τοῦ",709436,35],["λάκκου",708067,18],["Βαιθλεεμ",702420,118],["τοῦ",709436,35],["ἐν",704639,0],["τῇ",709436,100],["πύλῃ",711082,1]],"And David longed, and said, Who will give me water to drink of the well of Bethleem, that is in the gate?"],["18",[["καὶ",707031,7],["διέρρηξαν",703565,150],["οἱ",709436,136],["τρεῖς",712927,138],["τὴν",709436,8],["παρεμβολὴν",710133,9],["τῶν",709436,80],["ἀλλοφύλων",700706,81],["καὶ",707031,7],["ὑδρεύσαντο",713066,189],["ὕδωρ",713071,25],["ἐκ",704132,0],["τοῦ",709436,35],["λάκκου",708067,18],["τοῦ",709436,35],["ἐν",704639,0],["Βαιθλεεμ",702420,111],["ὃς",709781,213],["ἦν",704093,13],["ἐν",704639,0],["τῇ",709436,100],["πύλῃ",711082,1],["καὶ",707031,7],["ἔλαβον",708076,150],["καὶ",707031,7],["ἦλθον",705453,150],["πρὸς",710844,0],["Δαυιδ",703232,6],["καὶ",707031,7],["οὐκ",709805,28],["ἠθέλη