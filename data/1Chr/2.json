[["1",[["ταῦτα",709858,290],["τὰ",709436,63],["ὀνόματα",709666,64],["τῶν",709436,80],["υἱῶν",713075,81],["Ισραηλ",706839,18],["Ρουβην",711295,4],["Συμεων",712297,4],["Λευι",708158,4],["Ιουδα",706768,4],["Ισσαχαρ",706843,4],["Ζαβουλων",705813,4]],"These [are] the names of the sons of Israel;"],["2",[["Δαν",703276,4],["Ιωσηφ",706948,4],["Βενιαμιν",702650,4],["Νεφθαλι",709279,4],["Γαδ",702872,4],["Ασηρ",701934,4]],"Ruben, Symeon, Levi, Juda, Issachar, Zabulon, Dan, Joseph, Benjamin, Nephthali, Gad, Aser."],["3",[["υἱοὶ",713075,52],["Ιουδα",706768,18],["Ηρ",706016,4],["Αυναν",702143,4],["Σηλων",711740,4],["τρεῖς",712927,138],["ἐγεννήθησαν",703051,99],["αὐτῷ",702165,50],["ἐκ",704132,0],["τῆς",709436,16],["θυγατρὸς",706320,17],["Σαυας",711559,17],["τῆς",709436,16],["Χαναανίτιδος",713709,17],["καὶ",707031,7],["ἦν",704093,13],["Ηρ",706016,4],["ὁ",709436,3],["πρωτότοκος",711046,14],["Ιουδα",706768,18],["πονηρὸς",710660,14],["ἐναντίον",704654,0],["κυρίου",707996,18],["καὶ",707031,7],["ἀπέκτεινεν",701498,2],["αὐτόν",702165,85]],"The sons of Juda; Er, Aunan, Selom. [These] three were born to him of the daughter of Sava the Chananitish woman: and Er, the first-born of Juda, [was] wicked before the Lord, and he slew him."],["4",[["καὶ",707031,7],["Θαμαρ",706078,12],["ἡ",709436,10],["νύμφη",709381,12],["αὐτοῦ",702165,102],["ἔτεκεν",712853,2],["αὐτῷ",702165,50],["τὸν",709436,5],["Φαρες",713362,6],["καὶ",707031,7],["τὸν",709436,5],["Ζαρα",705837,6],["πάντες",710177,138],["υἱοὶ",713075,52],["Ιουδα",706768,18],["πέντε",710266,59]],"And Thamar his daughter-in-law bore to him Phares, and Zara: all the sons of Juda [were] five."],["5",[["υἱοὶ",713075,52],["Φαρες",713362,18],["Αρσων",701822,4],["καὶ",707031,7],["Ιεμουηλ",706594,4]],"The sons of Phares, Esrom, and Jemuel."],["6",[["καὶ",707031,7],["υἱοὶ",713075,52],["Ζαρα",705837,18],["Ζαμβρι",705831,4],["καὶ",707031,7],["Αιθαν",700416,4],["καὶ",707031,7],["Αιμαν",700444,4],["καὶ",707031,7],["Χαλχαλ",713698,4],["καὶ",707031,7],["Δαρα",703289,4],["πάντες",710177,138],["πέντε",710266,59]],"And the sons of Zara, Zambri, and Ætham, and Æmuan, and Calchal, and Darad, [in] all five."],["7",[["καὶ",707031,7],["υἱοὶ",713075,52],["Χαρμι",713742,18],["Αχαρ",702250,4],["ὁ",709436,3],["ἐμποδοστάτης",704607,4],["Ισραηλ",706839,18],["ὃς",709781,213],["ἠθέτησεν",700369,2],["εἰς",704105,0],["τὸ",709436,24],["ἀνάθεμα",700950,25]],"And the sons of Charmi; Achar the troubler of Israel, who was disobedient in the accursed thing."],["8",[["καὶ",707031,7],["υἱοὶ",713075,52],["Αιθαν",700416,18],["Αζαρια",700327,4]],"And the sons of Ætham; Azarias,"],["9",[["καὶ",707031,7],["υἱοὶ",713075,52],["Εσερων",705480,18],["οἳ",709781,250],["ἐτέχθησαν",712853,99],["αὐτῷ",702165,50],["ὁ",709436,3],["Ιραμεηλ",706796,4],["καὶ",707031,7],["ὁ",709436,3],["Ραμ",711162,4],["καὶ",707031,7],["ὁ",709436,3],["Χαλεβ",713680,4],["καὶ",707031,7],["Αραμ",701682,4]],"and the sons of Esrom who were born to him; Jerameel, and Aram, and Chaleb."],["10",[["καὶ",707031,7],["Αραμ",701682,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Αμιναδαβ",700824,6],["καὶ",707031,7],["Αμιναδαβ",700824,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Ναασσων",709127,6],["ἄρχοντα",701862,6],["τοῦ",709436,35],["οἴκου",709516,18],["Ιουδα",706768,18]],"And Aram begot Aminadab, and Aminadab begot Naasson, chief of the house of Juda."],["11",[["καὶ",707031,7],["Ναασσων",709127,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Σαλμων",711419,6],["καὶ",707031,7],["Σαλμων",711419,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Βοος",702760,6]],"And Naasson begot Salmon, and Salmon begot Booz,"],["12",[["καὶ",707031,7],["Βοος",702760,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Ωβηδ",714084,6],["καὶ",707031,7],["Ωβηδ",714084,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Ιεσσαι",706668,6]],"and Booz begot Obed, and Obed begot Jessæ."],["13",[["καὶ",707031,7],["Ιεσσαι",706668,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["πρωτότοκον",711046,27],["αὐτοῦ",702165,102],["Ελιαβ",704446,6],["Αμιναδαβ",700824,4],["ὁ",709436,3],["δεύτερος",703389,14],["Σαμαα",711434,4],["ὁ",709436,3],["τρίτος",712968,14]],"And Jessæ begot his first-born Eliab, Aminadab [was] the second, Samaa the third,"],["14",[["Ναθαναηλ",709165,4],["ὁ",709436,3],["τέταρτος",712811,14],["Ραδδαι",711147,4],["ὁ",709436,3],["πέμπτος",710245,14]],"Nathanael the fourth, Zabdai the fifth,"],["15",[["Ασομ",701978,4],["ὁ",709436,3],["ἕκτος",704340,14],["Δαυιδ",703232,4],["ὁ",709436,3],["ἕβδομος",703925,14]],"Asam the sixth, David the seventh."],["16",[["καὶ",707031,7],["ἀδελφὴ",700244,12],["αὐτῶν",702165,40],["Σαρουια",711539,12],["καὶ",707031,7],["Αβιγαια",700057,12],["καὶ",707031,7],["υἱοὶ",713075,52],["Σαρουια",711539,17],["Αβεσσα",700051,4],["καὶ",707031,7],["Ιωαβ",706877,4],["καὶ",707031,7],["Ασαηλ",701877,4],["τρεῖς",712927,138]],"And their sister [was] Saruia, and [another] Abigaia: and the sons of Saruia [were] Abisa, and Joab, and Asael, three."],["17",[["καὶ",707031,7],["Αβιγαια",700057,12],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Αμεσσα",700811,6],["καὶ",707031,7],["πατὴρ",710189,4],["Αμεσσα",700811,18],["Ιοθορ",706756,4],["ὁ",709436,3],["Ισμαηλίτης",706819,4]],"And Abigaia bore Amessab: and the father of Amessab [was] Jothor the Ismaelite."],["18",[["καὶ",707031,7],["Χαλεβ",713680,4],["υἱὸς",713075,4],["Εσερων",705480,18],["ἐγέννησεν",703051,2],["τὴν",709436,8],["Γαζουβα",702895,9],["γυναῖκα",703209,9],["καὶ",707031,7],["τὴν",709436,8],["Ιεριωθ",706621,9],["καὶ",707031,7],["οὗτοι",709858,201],["υἱοὶ",713075,52],["αὐτῆς",702165,86],["Ιωασαρ",706897,4],["καὶ",707031,7],["Σωβαβ",712619,4],["καὶ",707031,7],["Ορνα",709760,4]],"And Chaleb the son of Esrom took Gazuba to wife, and Jerioth: and these [were] her sons; Jasar, and Subab, and Ardon."],["19",[["καὶ",707031,7],["ἀπέθανεν",701461,2],["Γαζουβα",702895,12],["καὶ",707031,7],["ἔλαβεν",708076,2],["ἑαυτῷ",703917,50],["Χαλεβ",713680,4],["τὴν",709436,8],["Εφραθ",705763,9],["καὶ",707031,7],["ἔτεκεν",712853,2],["αὐτῷ",702165,50],["τὸν",709436,5],["Ωρ",714127,6]],"And Gazuba died; and Chaleb took to himself Ephrath, and she bore to him Or."],["20",[["καὶ",707031,7],["Ωρ",714127,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Ουρι",709846,6],["καὶ",707031,7],["Ουρι",709846,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Βεσελεηλ",702664,6]],"And Or begot Uri, and Uri begot Beseleel."],["21",[["καὶ",707031,7],["μετὰ",708780,0],["ταῦτα",709858,71],["εἰσῆλθεν",704114,2],["Εσερων",705480,4],["πρὸς",710844,0],["τὴν",709436,8],["θυγατέρα",706320,9],["Μαχιρ",708604,18],["πατρὸς",710189,18],["Γαλααδ",702920,18],["καὶ",707031,7],["οὗτος",709858,121],["ἔλαβεν",708076,2],["αὐτήν",702165,104],["καὶ",707031,7],["αὐτὸς",702165,121],["ἑξήκοντα",704922,59],["ἦν",704093,13],["ἐτῶν",705543,44],["καὶ",707031,7],["ἔτεκεν",712853,2],["αὐτῷ",702165,50],["τὸν",709436,5],["Σεγουβ",711614,6]],"And after this Esron went in to the daughter of Machir the father of Galaad, and he took her when he was sixty-five years old; and she bore him Seruch."],["22",[["καὶ",707031,7],["Σεγουβ",711614,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Ιαϊρ",706390,6],["καὶ",707031,7],["ἦσαν",704093,137],["αὐτῷ",702165,50],["εἴκοσι",704085,59],["τρεῖς",712927,138],["πόλεις",710612,191],["ἐν",704639,0],["τῇ",709436,100],["Γαλααδ",702920,1]],"And Seruch begot Jair, and he had twenty-three cities in Galaad."],["23",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Γεδσουρ",702998,9],["καὶ",707031,7],["Αραμ",701682,9],["τὰς",709436,38],["κώμας",708022,39],["Ιαϊρ",706390,18],["ἐξ",704132,0],["αὐτῶν",702165,40],["τὴν",709436,8],["Καναθ",707123,9],["καὶ",707031,7],["τὰς",709436,38],["κώμας",708022,39],["αὐτῆς",702165,86],["ἑξήκοντα",704922,59],["πόλεις",710612,39],["πᾶσαι",710177,192],["αὗται",709858,202],["υἱῶν",713075,81],["Μαχιρ",708604,18],["πατρὸς",710189,18],["Γαλααδ",702920,18]],"And he took Gedsur and Aram, the towns of Jair from them; [with] Canath and its towns, sixty cities. All these [belonged to] the sons of Machir the father of Galaad."],["24",[["καὶ",707031,7],["μετὰ",708780,0],["τὸ",709436,24],["ἀποθανεῖν",701461,106],["Εσερων",705480,6],["ἦλθεν",705453,2],["Χαλεβ",713680,4],["εἰς",704105,0],["Εφραθα",705765,6],["καὶ",707031,7],["ἡ",709436,10],["γυνὴ",703209,12],["Εσερων",705480,18],["Αβια",700054,12],["καὶ",707031,7],["ἔτεκεν",712853,2],["αὐτῷ",702165,50],["τὸν",709436,5],["Ασχωδ",702058,6],["πατέρα",710189,6],["Θεκωε",706162,18]],"And after the death of Esron, Chaleb came to Ephratha; and the wife of Esron [was] Abia; and she bore him Ascho the father of Thecoe."],["25",[["καὶ",707031,7],["ἦσαν",704093,137],["υἱοὶ",713075,52],["Ιερεμεηλ",706610,18],["πρωτοτόκου",711046,116],["Εσερων",705480,18],["ὁ",709436,3],["πρωτότοκος",711046,14],["Ραμ",711162,4],["καὶ",707031,7],["Βαανα",702348,4],["καὶ",707031,7],["Αραν",701685,4],["καὶ",707031,7],["Ασομ",701978,4],["ἀδελφὸς",700249,4],["αὐτοῦ",702165,102]],"And the sons of Jerameel the first-born of Esron [were], the first-born Ram, and Banaa, and Aram, and Asan his brother."],["26",[["καὶ",707031,7],["ἦν",704093,13],["γυνὴ",703209,12],["ἑτέρα",705535,68],["τῷ",709436,113],["Ιερεμεηλ",706610,114],["καὶ",707031,7],["ὄνομα",709666,15],["αὐτῇ",702165,105],["Αταρα",702072,12],["αὕτη",709858,107],["ἐστὶν",704093,91],["μήτηρ",708892,12],["Οζομ",709480,18]],"And Jerameel had another wife, and her name [was] Atara: she is the mother of Ozom."],["27",[["καὶ",707031,7],["ἦσαν",704093,137],["υἱοὶ",713075,52],["Ραμ",711162,18],["πρωτοτόκου",711046,116],["Ιερεμεηλ",706610,18],["Μαας",708307,4],["καὶ",707031,7],["Ιαμιν",706409,4],["καὶ",707031,7],["Ακορ",700574,4]],"And the sons of Ram the first-born of Jerameel were Maas, and Jamin, and Acor."],["28",[["καὶ",707031,7],["ἦσαν",704093,137],["υἱοὶ",713075,52],["Οζομ",709480,18],["Σαμαι",711439,4],["καὶ",707031,7],["Ιαδαε",706372,4],["καὶ",707031,7],["υἱοὶ",713075,52],["Σαμαι",711439,18],["Ναδαβ",709156,4],["καὶ",707031,7],["Αβισουρ",700078,4]],"And the sons of Ozom were, Samai, and Jadae: and the sons of Samai; Nadab, and Abisur."],["29",[["καὶ",707031,7],["ὄνομα",709666,15],["τῆς",709436,16],["γυναικὸς",703209,17],["Αβισουρ",700078,18],["Αβιχαιλ",700081,12],["καὶ",707031,7],["ἔτεκεν",712853,2],["αὐτῷ",702165,50],["τὸν",709436,5],["Αχαβαρ",702244,6],["καὶ",707031,7],["τὸν",709436,5],["Μωλιδ",709098,6]],"And the name of the wife of Abisur [was] Abichaia, and she bore him Achabar, and Moel."],["30",[["υἱοὶ",713075,52],["Ναδαβ",709156,18],["Σαλαδ",711392,4],["καὶ",707031,7],["Αφφαιμ",702239,4],["καὶ",707031,7],["ἀπέθανεν",701461,2],["Σαλαδ",711392,4],["οὐκ",709805,28],["ἔχων",705785,72],["τέκνα",712761,42]],"And the sons of Nadab; Salad and Apphain; and Salad died without children."],["31",[["καὶ",707031,7],["υἱοὶ",713075,52],["Αφφαιμ",702239,18],["Ισεμιηλ",706814,4],["καὶ",707031,7],["υἱοὶ",713075,52],["Ισεμιηλ",706814,18],["Σωσαν",712651,4],["καὶ",707031,7],["υἱοὶ",713075,52],["Σωσαν",712651,18],["Αχλαι",702302,4]],"And the sons of Apphain, Isemiel; and the sons of Isemiel, Sosan; and the sons of Sosan, Dadai."],["32",[["καὶ",707031,7],["υἱοὶ",713075,52],["Ιαδαε",706372,18],["Αχισαμαι",702293,4],["Ιεθερ",706559,4],["Ιωναθαν",706927,4],["καὶ",707031,7],["ἀπέθανεν",701461,2],["Ιεθερ",706559,4],["οὐκ",709805,28],["ἔχων",705785,72],["τέκνα",712761,42]],"And the sons of Dadai, Achisamas, Jether, Jonathan: and Jether died childless."],["33",[["καὶ",707031,7],["υἱοὶ",713075,52],["Ιωναθαν",706927,18],["Φαλεθ",713328,4],["καὶ",707031,7],["Οζαζα",709468,4],["οὗτοι",709858,201],["ἦσαν",704093,137],["υἱοὶ",713075,52],["Ιερεμεηλ",706610,18]],"And the sons of Jonathan; Phaleth, and Hozam. These were the sons of Jerameel."],["34",[["καὶ",707031,7],["οὐκ",709805,28],["ἦσαν",704093,137],["τῷ",709436,113],["Σωσαν",712651,114],["υἱοί",713075,52],["ἀλλ᾿",700680,7],["ἢ",705924,7],["θυγατέρες",706320,191],["καὶ",707031,7],["τῷ",709436,113],["Σωσαν",712651,114],["παῖς",709932,4],["Αἰγύπτιος",700400,4],["καὶ",707031,7],["ὄνομα",709666,15],["αὐτῷ",702165,50],["Ιωχηλ",706958,4]],"And Sosan had no sons, but daughters. And Sosan had an Egyptian servant, and his name [was] Jochel."],["35",[["καὶ",707031,7],["ἔδωκεν",703654,2],["Σωσαν",712651,4],["τὴν",709436,8],["θυγατέρα",706320,9],["αὐτοῦ",702165,102],["τῷ",709436,113],["Ιωχηλ",706958,114],["παιδὶ",709932,114],["αὐτοῦ",702165,102],["εἰς",704105,0],["γυναῖκα",703209,9],["καὶ",707031,7],["ἔτεκεν",712853,2],["αὐτῷ",702165,50],["τὸν",709436,5],["Εθθι",704059,6]],"And Sosan gave his daughter to Jochel his servant to wife; and she bore him Ethi."],["36",[["καὶ",707031,7],["Εθθι",704059,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Ναθαν",709164,6],["καὶ",707031,7],["Ναθαν",709164,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Ζαβεδ",705808,6]],"And Ethi begot Nathan, and Nathan begot Zabed,"],["37",[["καὶ",707031,7],["Ζαβεδ",705808,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Αφαληλ",702179,6],["καὶ",707031,7],["Αφαληλ",702179,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Ωβηδ",714084,6]],"and Zabed begot Aphamel, and Aphamel begot Obed."],["38",[["καὶ",707031,7],["Ωβηδ",714084,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Ιηου",706697,6],["καὶ",707031,7],["Ιηου",706697,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Αζαριαν",700328,6]],"And Obed begot Jeu, and Jeu begot Azarias,"],["39",[["καὶ",707031,7],["Αζαριας",700328,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Χελλης",713817,6],["καὶ",707031,7],["Χελλης",713817,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Ελεασα",704411,6]],"and Azarias begot Chelles, and Chelles begot Eleasa,"],["40",[["καὶ",707031,7],["Ελεασα",704411,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Σοσομαι",711944,6],["καὶ",707031,7],["Σοσομαι",711944,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Σαλουμ",711422,6]],"and Eleasa begot Sosomai, and Sosomai begot Salum,"],["41",[["καὶ",707031,7],["Σαλουμ",711422,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Ιεχεμιαν",706688,6],["καὶ",707031,7],["Ιεχεμιας",706688,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Ελισαμα",704484,6]],"and Salum begot Jechemias, and Jechemias begot Elisama, and Elisama begot Ismael."],["42",[["καὶ",707031,7],["υἱοὶ",713075,52],["Χαλεβ",713680,18],["ἀδελφοῦ",700249,18],["Ιερεμεηλ",706610,18],["Μαρισα",708510,4],["ὁ",709436,3],["πρωτότοκος",711046,14],["αὐτοῦ",702165,102],["οὗτος",709858,121],["πατὴρ",710189,4],["Ζιφ",705883,18],["καὶ",707031,7],["υἱοὶ",713075,52],["Μαρισα",708510,18],["πατρὸς",710189,18],["Χεβρων",713777,18]],"And the sons of Chaleb the brother of Jerameel [were], Marisa his first-born, he [is] the father of Ziph:—and the sons of Marisa the father of Chebron."],["43",[["καὶ",707031,7],["υἱοὶ",713075,52],["Χεβρων",713777,18],["Κορε",707833,4],["καὶ",707031,7],["Θαπους",706102,4],["καὶ",707031,7],["Ρεκομ",711223,4],["καὶ",707031,7],["Σεμαα",711664,4]],"And the sons of Chebron; Core, and Thapphus, and Recom, and Samaa."],["44",[["καὶ",707031,7],["Σεμαα",711664,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Ραεμ",711149,6],["πατέρα",710189,6],["Ιερκααν",706622,18],["καὶ",707031,7],["Ιερκααν",706622,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Σαμαι",711439,6]],"And Samaa begot Raem the father of Jeclan: and Jeclan begot Samai."],["45",[["καὶ",707031,7],["υἱὸς",713075,4],["αὐτοῦ",702165,102],["Μαων",708615,4],["καὶ",707031,7],["Μαων",708615,4],["πατὴρ",710189,4],["Βαιθσουρ",702435,18]],"And his son [was] Maon: and Maon [is] the father of Bæthsur."],["46",[["καὶ",707031,7],["Γαιφα",702917,12],["ἡ",709436,10],["παλλακὴ",709943,12],["Χαλεβ",713680,18],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Αρραν",701807,6],["καὶ",707031,7],["τὸν",709436,5],["Μωσα",709111,6],["καὶ",707031,7],["τὸν",709436,5],["Γεζουε",703004,6],["καὶ",707031,7],["Αρραν",701807,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Γεζουε",703004,6]],"And Gæpha the concubine of Chaleb bore Aram, and Mosa, and Gezue."],["47",[["καὶ",707031,7],["υἱοὶ",713075,52],["Ιαδαι",706373,18],["Ραγεμ",711139,4],["καὶ",707031,7],["Ιωαθαμ",706885,4],["καὶ",707031,7],["Γηρσωμ",703094,4],["καὶ",707031,7],["Φαλετ",713330,4],["καὶ",707031,7],["Γαιφα",702917,4],["καὶ",707031,7],["Σαγαφ",711362,4]],"And the sons of Addai [were] Ragem, and Joatham, and Sogar, and Phalec, and Gæpha, and Sagae."],["48",[["καὶ",707031,7],["ἡ",709436,10],["παλλακὴ",709943,12],["Χαλεβ",713680,18],["Μωχα",709116,12],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Σαβερ",711353,6],["καὶ",707031,7],["τὸν",709436,5],["Θαρχνα",706128,6]],"And Chaleb's concubine Mocha bore Saber, and Tharam."],["49",[["καὶ",707031,7],["ἐγέννησεν",703051,2],["Σαγαφ",711362,6],["πατέρα",710189,6],["Μαρμηνα",708518,18],["καὶ",707031,7],["τὸν",709436,5],["Σαου",711497,6],["πατέρα",710189,6],["Μαχαβηνα",708590,18],["καὶ",707031,7],["πατέρα",710189,6],["Γαιβαα",702905,18],["καὶ",707031,7],["θυγάτηρ",706320,12],["Χαλεβ",713680,18],["Ασχα",702049,12]],"She bore also Sagae the father of Madmena, and Sau the father of Machabena, and the father of Gæbal: and the daughter of Chaleb [was] Ascha."],["50",[["οὗτοι",709858,201],["ἦσαν",704093,137],["υἱοὶ",713075,52],["Χαλεβ",713680,18],["υἱοὶ",713075,52],["Ωρ",714127,18],["πρωτοτόκου",711046,116],["Εφραθα",705765,18],["Σωβαλ",712622,4],["πατὴρ",710189,4],["Καριαθιαριμ",707151,81]],"These were the sons of Chaleb: the sons of Or the first-born of Ephratha; Sobal the father of Cariathiarim,"],["51",[["Σαλωμων",711430,4],["πατὴρ",710189,4],["Βαιθλαεμ",702420,18],["Αριμ",701745,4],["πατὴρ",710189,4],["Βαιθγεδωρ",702406,18]],"Salomon the father of Bætha, Lammon the father of Bæthalaem, and Arim the father of Bethgedor."],["52",[["καὶ",707031,7],["ἦσαν",704093,137],["υἱοὶ",713075,52],["τῷ",709436,113],["Σωβαλ",712622,114],["πατρὶ",710189,114],["Καριαθιαριμ",707151,81],["Αραα",701668,4],["Εσι",705496,4],["Αμμανιθ",700836,4]],"And the sons of Sobal the father of Cariathiarim were Araa, and Æsi, and Ammanith,"],["53",[["Εμοσφεως",704579,4],["πόλις",710612,12],["Ιαϊρ",706390,18],["Αιθαλιμ",700413,81],["καὶ",707031,7],["Μιφιθιμ",708951,81],["καὶ",707031,7],["Ησαμαθιμ",706028,81],["καὶ",707031,7],["Ημασαραϊμ",705982,81],["ἐκ",704132,0],["τούτων",709858,40],["ἐξήλθοσαν",704909,150],[