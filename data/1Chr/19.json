[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["μετὰ",708780,0],["ταῦτα",709858,71],["ἀπέθανεν",701461,2],["Ναας",709126,4],["βασιλεὺς",702580,4],["υἱῶν",713075,81],["Αμμων",700847,18],["καὶ",707031,7],["ἐβασίλευσεν",702581,2],["Αναν",701007,4],["υἱὸς",713075,4],["αὐτοῦ",702165,102],["ἀντ᾿",701227,0],["αὐτοῦ",702165,102]],"And it came to pass after this, [that] Naas the king of the children of Ammon died, and Anan his son reigned in his stead."],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["ποιήσω",710582,165],["ἔλεος",704426,25],["μετὰ",708780,0],["Αναν",701007,18],["υἱοῦ",713075,18],["Ναας",709126,18],["ὡς",714148,7],["ἐποίησεν",710582,2],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτοῦ",702165,102],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["ἔλεος",704426,25],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["ἀγγέλους",700140,57],["Δαυιδ",703232,4],["τοῦ",709436,20],["παρακαλέσαι",710039,106],["αὐτὸν",702165,85],["περὶ",710285,0],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἦλθον",705453,150],["παῖδες",709932,52],["Δαυιδ",703232,18],["εἰς",704105,0],["γῆν",703083,9],["υἱῶν",713075,81],["Αμμων",700847,18],["τοῦ",709436,20],["παρακαλέσαι",710039,106],["αὐτόν",702165,85]],"And David said, I will act kindly toward Anan the son of Naas, as his father acted kindly towards me. And David sent messengers to condole with him on the death of his father. So the servants of David came into the land of the children of Ammon to Anan, to comfort him."],["3",[["καὶ",707031,7],["εἶπον",705373,150],["ἄρχοντες",701862,52],["Αμμων",700847,18],["πρὸς",710844,0],["Αναν",701007,6],["μὴ",708851,28],["δοξάζων",703792,72],["Δαυιδ",703232,4],["τὸν",709436,5],["πατέρα",710189,6],["σου",711945,133],["ἐναντίον",704654,0],["σου",711945,133],["ἀπέστειλέν",701592,2],["σοι",711925,159],["παρακαλοῦντας",710039,235],["οὐχ",709805,28],["ὅπως",709719,7],["ἐξερευνήσωσιν",704905,234],["τὴν",709436,8],["πόλιν",710612,9],["τοῦ",709436,20],["κατασκοπῆσαι",707426,106],["τὴν",709436,8],["γῆν",703083,9],["ἦλθον",705453,150],["παῖδες",709932,52],["αὐτοῦ",702165,102],["πρὸς",710844,0],["σέ",711598,163]],"And the chiefs of the children of Ammon said to Anan, Is it to honour thy father before thee, that David has sent comforters to thee? Have not his servants come to thee that they might search the city, and to spy out the land?"],["4",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Αναν",701007,4],["τοὺς",709436,58],["παῖδας",709932,57],["Δαυιδ",703232,18],["καὶ",707031,7],["ἐξύρησεν",709431,2],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἀφεῖλεν",702177,2],["τῶν",709436,80],["μανδυῶν",708475,81],["αὐτῶν",702165,40],["τὸ",709436,24],["ἥμισυ",705998,46],["ἕως",705792,0],["τῆς",709436,16],["ἀναβολῆς",700916,17],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["αὐτούς",702165,62]],"And Anan took the servants of David, and shaved them, and cut off the half of their garments as far as their tunic, and sent them away."],["5",[["καὶ",707031,7],["ἦλθον",705453,150],["ἀπαγγεῖλαι",701321,106],["τῷ",709436,113],["Δαυιδ",703232,114],["περὶ",710285,0],["τῶν",709436,80],["ἀνδρῶν",701150,81],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["εἰς",704105,0],["ἀπάντησιν",701348,9],["αὐτοῖς",702165,151],["ὅτι",709803,7],["ἦσαν",704093,137],["ἠτιμωμένοι",702096,627],["σφόδρα",712586,28],["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["βασιλεύς",702580,4],["καθίσατε",707006,74],["ἐν",704639,0],["Ιεριχω",706620,1],["ἕως",705792,0],["τοῦ",709436,20],["ἀνατεῖλαι",701066,106],["τοὺς",709436,58],["πώγωνας",711115,57],["ὑμῶν",713091,145],["καὶ",707031,7],["ἀνακάμψατε",700969,74]],"And there came men to report to David concerning the men: and he sent to meet them, for they were greatly disgraced: and the king said, Dwell in Jericho until your beards have grown, and return."],["6",[["καὶ",707031,7],["εἶδον",709725,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Αμμων",700847,18],["ὅτι",709803,7],["ᾐσχύνθη",700485,37],["λαὸς",708094,4],["Δαυιδ",703232,18],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Αναν",701007,4],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["Αμμων",700847,18],["χίλια",713859,68],["τάλαντα",712697,42],["ἀργυρίου",701707,21],["τοῦ",709436,20],["μισθώσασθαι",708940,109],["ἑαυτοῖς",703917,151],["ἐκ",704132,0],["Συρίας",712533,17],["Μεσοποταμίας",708767,17],["καὶ",707031,7],["ἐκ",704132,0],["Συρίας",712533,17],["Μοοχα",709015,17],["καὶ",707031,7],["ἐκ",704132,0],["Σωβα",712618,17],["ἅρματα",701768,42],["καὶ",707031,7],["ἱππεῖς",706786,57]],"And the children of Ammon saw that the people of David were ashamed, and Anan and the children of Ammon sent a thousand talents of silver to hire for themselves chariots and horsemen out of Syria of Mesopotamia, and out of Syria Maacha, and from Sobal."],["7",[["καὶ",707031,7],["ἐμισθώσαντο",708940,189],["ἑαυτοῖς",703917,151],["δύο",703849,59],["καὶ",707031,7],["τριάκοντα",712934,59],["χιλιάδας",713858,39],["ἁρμάτων",701768,44],["καὶ",707031,7],["τὸν",709436,5],["βασιλέα",702580,6],["Μωχα",709116,17],["καὶ",707031,7],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἦλθον",705453,150],["καὶ",707031,7],["παρενέβαλον",710132,150],["κατέναντι",707507,28],["Μαιδαβα",708384,17],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["Αμμων",700847,18],["συνήχθησαν",712375,99],["ἐκ",704132,0],["τῶν",709436,130],["πόλεων",710612,65],["αὐτῶν",702165,40],["καὶ",707031,7],["ἦλθον",705453,150],["εἰς",704105,0],["τὸ",709436,24],["πολεμῆσαι",710601,106]],"And they hired for themselves two and thirty thousand chariots, and the king of Maacha and his people; and they came and encamped before Medaba: and the children of Ammon assembled out of their cities, and came to fight."],["8",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Δαυιδ",703232,4],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["τὸν",709436,5],["Ιωαβ",706877,6],["καὶ",707031,7],["πᾶσαν",710177,36],["τὴν",709436,8],["στρατιὰν",712145,9],["τῶν",709436,80],["δυνατῶν",703845,169]],"And David heard, and sent Joab and all the host of mighty men."],["9",[["καὶ",707031,7],["ἐξῆλθον",704909,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Αμμων",700847,18],["καὶ",707031,7],["παρατάσσονται",710108,269],["εἰς",704105,0],["πόλεμον",710605,6],["παρὰ",709995,0],["τὸν",709436,5],["πυλῶνα",711083,6],["τῆς",709436,16],["πόλεως",710612,17],["καὶ",707031,7],["οἱ",709436,136],["βασιλεῖς",702580,52],["οἱ",709436,136],["ἐλθόντες",705453,196],["παρενέβαλον",710132,150],["καθ᾿",707200,0],["ἑαυτοὺς",703917,62],["ἐν",704639,0],["τῷ",709436,53],["πεδίῳ",710215,54]],"And the children of Ammon came forth, and set themselves in array for battle by the gate of the city: and the kings that were come forth encamped by themselves in the plain."],["10",[["καὶ",707031,7],["εἶδεν",709725,2],["Ιωαβ",706877,4],["ὅτι",709803,7],["γεγόνασιν",703104,353],["ἀντιπρόσωποι",701270,138],["τοῦ",709436,20],["πολεμεῖν",710601,55],["πρὸς",710844,0],["αὐτὸν",702165,85],["κατὰ",707200,0],["πρόσωπον",710986,25],["καὶ",707031,7],["ἐξόπισθεν",704962,0],["καὶ",707031,7],["ἐξελέξατο",704236,23],["ἐκ",704132,0],["παντὸς",710177,116],["νεανίου",709229,18],["ἐξ",704132,0],["Ισραηλ",706839,18],["καὶ",707031,7],["παρετάξαντο",710108,189],["ἐναντίον",704654,0],["τοῦ",709436,35],["Σύρου",712541,18]],"And Joab saw that they were fronting [him] to fight against him before and behind, and he chose [some] out of all the young men of Israel, and they set themselves in array against the Syrian."],["11",[["καὶ",707031,7],["τὸ",709436,24],["κατάλοιπον",707317,27],["τοῦ",709436,35],["λαοῦ",708094,18],["ἔδωκεν",703654,2],["ἐν",704639,0],["χειρὶ",713787,1],["Αβεσσα",700051,18],["ἀδελφοῦ",700249,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["παρετάξαντο",710108,189],["ἐξ",704132,0],["ἐναντίας",704656,82],["υἱῶν",713075,81],["Αμμων",700847,18]],"And the rest of the people he gave into the hand of his brother Abesai, and they set themselves in array against the children of Ammon."],["12",[["καὶ",707031,7],["εἶπεν",705373,2],["ἐὰν",703912,7],["κρατήσῃ",707879,123],["ὑπὲρ",713111,0],["ἐμὲ",704555,163],["Σύρος",712541,4],["καὶ",707031,7],["ἔσῃ",704093,123],["μοι",708974,159],["εἰς",704105,0],["σωτηρίαν",712658,9],["καὶ",707031,7],["ἐὰν",703912,7],["υἱοὶ",713075,52],["Αμμων",700847,18],["κρατήσωσιν",707879,234],["ὑπὲρ",713111,0],["σέ",711598,163],["καὶ",707031,7],["σώσω",712627,165],["σε",711598,163]],"And he said, If the Syrian should prevail against me, then shalt thou deliver me: and if the children of Ammon should prevail against thee, then will I deliver thee."],["13",[["ἀνδρίζου",701104,253],["καὶ",707031,7],["ἐνισχύσωμεν",704750,79],["περὶ",710285,0],["τοῦ",709436,35],["λαοῦ",708094,18],["ἡμῶν",705999,145],["καὶ",707031,7],["περὶ",710285,0],["τῶν",709436,130],["πόλεων",710612,65],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["καὶ",707031,7],["κύριος",707996,4],["τὸ",709436,24],["ἀγαθὸν",700106,27],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["αὐτοῦ",702165,102],["ποιήσει",710582,127]],"Be of good courage, and let us be strong, for our people, and for the cities of our God: and the Lord shall do what [is] good in his eyes.",{"s":"d","q":0.23}],["14",[["καὶ",707031,7],["παρετάξατο",710108,23],["Ιωαβ",706877,4],["καὶ",707031,7],["ὁ",709436,3],["λαὸς",708094,4],["ὁ",709436,3],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["κατέναντι",707507,28],["Σύρων",712544,81],["εἰς",704105,0],["πόλεμον",710605,6],["καὶ",707031,7],["ἔφυγον",713433,150],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102]],"So Joab and the people that were with him set themselves in battle array against the Syrians, and they fled from them."],["15",[["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["Αμμων",700847,18],["εἶδον",709725,150],["ὅτι",709803,7],["ἔφυγον",713433,150],["Σύροι",712541,52],["καὶ",707031,7],["ἔφυγον",713433,150],["καὶ",707031,7],["αὐτοὶ",702165,201],["ἀπὸ",701425,0],["προσώπου",710986,21],["Ιωαβ",706877,18],["καὶ",707031,7],["ἀπὸ",701425,0],["προσώπου",710986,21],["Αβεσσα",700051,18],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἦλθον",705453,150],["εἰς",704105,0],["τὴν",709436,8],["πόλιν",710612,9],["καὶ",707031,7],["ἦλθεν",705453,2],["Ιωαβ",706877,4],["εἰς",704105,0],["Ιερουσαλημ",706644,9]],"And the children of Ammon saw that the Syrians fled, and they also fled from before Abesai, and from before Joab his brother, and they came to the city: and Joab came to Jerusalem."],["16",[["καὶ",707031,7],["εἶδεν",709725,2],["Σύρος",712541,4],["ὅτι",709803,7],["ἐτροπώσατο",712981,23],["αὐτὸν",702165,85],["Ισραηλ",706839,4],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["ἀγγέλους",700140,57],["καὶ",707031,7],["ἐξήγαγον",704834,150],["τὸν",709436,5],["Σύρον",712541,6],["ἐκ",704132,0],["τοῦ",709436,35],["πέραν",710280,0],["τοῦ",709436,35],["ποταμοῦ",710693,18],["καὶ",707031,7],["Σωφαχ",712668,4],["ἀρχιστράτηγος",701853,4],["δυνάμεως",703839,17],["Αδρααζαρ",700288,18],["ἔμπροσθεν",704618,0],["αὐτῶν",702165,40]],"And the Syrian saw that Israel had defeated him, and he sent messengers, and they brought out the Syrians from beyond the river; and Sophath the commander-in-chief of the forces of Adraazar [was] before them."],["17",[["καὶ",707031,7],["ἀπηγγέλη",701321,37],["τῷ",709436,113],["Δαυιδ",703232,114],["καὶ",707031,7],["συνήγαγεν",712375,2],["τὸν",709436,5],["πάντα",710177,27],["Ισραηλ",706839,6],["καὶ",707031,7],["διέβη",703419,2],["τὸν",709436,5],["Ιορδάνην",706763,6],["καὶ",707031,7],["ἦλθεν",705453,2],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["καὶ",707031,7],["παρετάξατο",710108,23],["ἐπ᾿",705080,0],["αὐτούς",702165,62],["καὶ",707031,7],["παρατάσσεται",710108,117],["Σύρος",712541,4],["ἐξ",704132,0],["ἐναντίας",704656,82],["Δαυιδ",703232,18],["καὶ",707031,7],["ἐπολέμησαν",710601,150],["αὐτόν",702165,85]],"And it was told David; and he gathered all Israel, and crossed over Jordan, and came upon them, and set the battle in array against them. So David set [his army] in array to fight against the Syrians, and they fought against him."],["18",[["καὶ",707031,7],["ἔφυγεν",713433,2],["Σύρος",712541,4],["ἀπὸ",701425,0],["προσώπου",710986,21],["Δαυιδ",703232,18],["καὶ",707031,7],["ἀπέκτεινεν",701498,2],["Δαυιδ",703232,4],["ἀπὸ",701425,0],["τοῦ",709436,35],["Σύρου",712541,18],["ἑπτὰ",705357,59],["χιλιάδας",713858,39],["ἁρμάτων",701768,44],["καὶ",707031,7],["τεσσαράκοντα",712806,59],["χιλιάδας",713858,39],["πεζῶν",710219,169],["καὶ",707031,7],["τὸν",709436,5],["Σωφαχ",712668,6],["ἀρχιστράτηγον",701853,6],["δυνάμεως",703839,17],["ἀπέκτεινεν",701498,2]],"And the Syrians fled from before Israel; and David slew of the Syrians seven thousand [riders in] chariots, and forty thousand infantry, and he slew Sophath the commander-in-chief of the forces."],["19",[["καὶ",707031,7],["εἶδον",709725,150],["παῖδες",709932,52],["Αδρααζαρ",700288,18],["ὅτι",709803,7],["ἐπταίκασιν",711048,353],["ἀπὸ",701425,0],["προσώπου",710986,21],["Ισραηλ",706839,18],["καὶ",707031,7],["διέθεντο",703609,189],["μετὰ",708780,0],["Δαυιδ",703232,18],["καὶ",707031,7],["ἐδούλευσαν",703814,150],["αὐτῷ",702165,50],["καὶ",707031,7],["οὐκ",709805,28],["ἠθέλησεν",706176,2],["Σύρος",712541,4],["τοῦ",709436,20],["βοηθῆσαι",702746,106],["τοῖς",709436,147],["υἱοῖς",713075,148],["Αμμων",700847,18],["ἔτι",705538,28]],"And the servants of Adraazar saw that they were defeated before Israel, and they made peace with David and served him: and the Syrians would not any more help the children of Ammon."]]