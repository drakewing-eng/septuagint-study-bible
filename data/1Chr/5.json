[["1",[["καὶ",707031,7],["υἱοὶ",713075,52],["Ρουβην",711295,18],["πρωτοτόκου",711046,116],["Ισραηλ",706839,18],["ὅτι",709803,7],["οὗτος",709858,121],["ὁ",709436,3],["πρωτότοκος",711046,14],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["ἀναβῆναι",700905,106],["ἐπὶ",705080,0],["τὴν",709436,8],["κοίτην",707781,9],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["ἔδωκεν",703654,2],["εὐλογίαν",705633,9],["αὐτοῦ",702165,102],["τῷ",709436,113],["υἱῷ",713075,114],["αὐτοῦ",702165,102],["Ιωσηφ",706948,114],["υἱῷ",713075,114],["Ισραηλ",706839,114],["καὶ",707031,7],["οὐκ",709805,28],["ἐγενεαλογήθη",703038,37],["εἰς",704105,0],["πρωτοτόκια",711045,42]],"And the sons of Ruben the first-born of Israel (for he [was] the first-born; but because of his going up to his father's couch, [his father] gave his blessing to his son Joseph, [even] the son of Israel; and he was not reckoned as first-born;"],["2",[["ὅτι",709803,7],["Ιουδας",706775,4],["δυνατὸς",703845,14],["ἰσχύι",706858,1],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["ἀδελφοῖς",700249,148],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἰς",704105,0],["ἡγούμενον",705931,212],["ἐξ",704132,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἡ",709436,10],["εὐλογία",705633,12],["τοῦ",709436,35],["Ιωσηφ",706948,18]],"for Judas [was] very mighty even among his brethren, and one was to be a ruler out of him: but the blessing [was] Joseph's)."],["3",[["υἱοὶ",713075,52],["Ρουβην",711295,18],["πρωτοτόκου",711046,116],["Ισραηλ",706839,18],["Ενωχ",704827,4],["καὶ",707031,7],["Φαλλους",713336,4],["Αρσων",701822,4],["καὶ",707031,7],["Χαρμι",713742,4]],"The sons of Ruben the first-born of Israel; Enoch, and Phallus, Asrom, and Charmi."],["4",[["υἱοὶ",713075,52],["Ιωηλ",706916,18],["Σεμεϊ",711666,4],["καὶ",707031,7],["Βαναια",702501,4],["υἱὸς",713075,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["υἱοὶ",713075,52],["Γουγ",703177,18],["υἱοῦ",713075,18],["Σεμεϊ",711666,18]],"The sons of Joel; Semei, and Banaia his son: and the sons of Gug the son of Semei."],["5",[["υἱὸς",713075,4],["αὐτοῦ",702165,102],["Μιχα",708952,4],["υἱὸς",713075,4],["αὐτοῦ",702165,102],["Ρηχα",711255,4],["υἱὸς",713075,4],["αὐτοῦ",702165,102],["Βααλ",702333,4]],"His son [was] Micha, his son Recha, his son Joel,"],["6",[["υἱὸς",713075,4],["αὐτοῦ",702165,102],["Βεηρα",702631,4],["ὃν",709781,112],["μετῴκισεν",708835,2],["Θαγλαθφαλνασαρ",706056,4],["βασιλεὺς",702580,4],["Ασσουρ",702001,18],["οὗτος",709858,121],["ἄρχων",701860,72],["τῶν",709436,80],["Ρουβην",711295,81]],"his son Beël, whom Thagla-phallasar king of Assyria carried away captive: he [is] the chief of the Rubenites."],["7",[["καὶ",707031,7],["ἀδελφοὶ",700249,52],["αὐτοῦ",702165,102],["τῇ",709436,100],["πατριᾷ",710192,1],["αὐτοῦ",702165,102],["ἐν",704639,0],["τοῖς",709436,147],["καταλοχισμοῖς",707319,148],["αὐτῶν",702165,40],["κατὰ",707200,0],["γενέσεις",703043,191],["αὐτῶν",702165,40],["ὁ",709436,3],["ἄρχων",701860,72],["Ιωηλ",706916,4],["καὶ",707031,7],["Ζαχαρια",705847,4]],"And his brethren in his family, in their distribution according to their generations; the chief, Joel, and Zacharia."],["8",[["καὶ",707031,7],["Βαλεκ",702484,4],["υἱὸς",713075,4],["Οζουζ",709482,18],["υἱὸς",713075,4],["Σαμα",711433,18],["υἱὸς",713075,4],["Ιωηλ",706916,18],["οὗτος",709858,121],["κατῴκησεν",707534,2],["ἐν",704639,0],["Αροηρ",701787,114],["καὶ",707031,7],["ἐπὶ",705080,0],["Ναβαυ",709137,6],["καὶ",707031,7],["Βεελμαων",702620,6]],"And Balec the son of Azuz, the son of Sama, the son of Joel: he dwelt in Aroer, and even to Naban, and Beelmasson."],["9",[["καὶ",707031,7],["πρὸς",710844,0],["ἀνατολὰς",701071,39],["κατῴκησεν",707534,2],["ἕως",705792,0],["ἐρχομένων",705453,299],["τῆς",709436,16],["ἐρήμου",705420,17],["ἀπὸ",701425,0],["τοῦ",709436,35],["ποταμοῦ",710693,18],["Εὐφράτου",705716,18],["ὅτι",709803,7],["κτήνη",707934,42],["αὐτῶν",702165,40],["πολλὰ",710646,68],["ἐν",704639,0],["γῇ",703083,1],["Γαλααδ",702920,17]],"And he dwelt eastward to the borders of the wilderness, from the river Euphrates: for they had much cattle in the land of Galaad."],["10",[["καὶ",707031,7],["ἐν",704639,0],["ἡμέραις",705984,76],["Σαουλ",711499,18],["ἐποίησαν",710582,150],["πόλεμον",710605,6],["πρὸς",710844,0],["τοὺς",709436,58],["παροίκους",710159,60],["καὶ",707031,7],["ἔπεσον",710481,150],["ἐν",704639,0],["χερσὶν",713787,76],["αὐτῶν",702165,40],["κατοικοῦντες",707534,146],["ἐν",704639,0],["σκηναῖς",711845,76],["ἕως",705792,0],["πάντες",710177,138],["κατ᾿",707200,0],["ἀνατολὰς",701071,39],["τῆς",709436,16],["Γαλααδ",702920,17]],"And in the days of Saul they made war upon the sojourners [in the land]; and they fell into their hands, all of them dwelling in their tents eastward of Galaad."],["11",[["υἱοὶ",713075,52],["Γαδ",702872,18],["κατέναντι",707507,28],["αὐτῶν",702165,40],["κατῴκησαν",707534,150],["ἐν",704639,0],["τῇ",709436,100],["Βασαν",702564,1],["ἕως",705792,0],["Σελχα",711662,118]],"The sons of Gad dwelt over against them in the land of Basan even to Sela."],["12",[["Ιωηλ",706916,4],["ὁ",709436,3],["πρωτότοκος",711046,14],["καὶ",707031,7],["Σαφαμ",711568,4],["ὁ",709436,3],["δεύτερος",703389,14],["καὶ",707031,7],["Ιανι",706418,4],["ὁ",709436,3],["γραμματεὺς",703185,4],["ἐν",704639,0],["Βασαν",702564,1]],"Joel the first-born, and Sapham the second, and Janin the scribe in Basan."],["13",[["καὶ",707031,7],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["αὐτῶν",702165,40],["κατ᾿",707200,0],["οἴκους",709516,57],["πατριῶν",710192,65],["αὐτῶν",702165,40],["Μιχαηλ",708953,4],["Μοσολλαμ",709022,4],["καὶ",707031,7],["Σεβεε",711605,4],["καὶ",707031,7],["Ιωρεε",706934,4],["καὶ",707031,7],["Ιαχαν",706463,4],["καὶ",707031,7],["Ζουε",705890,4],["καὶ",707031,7],["Ωβηδ",714084,4],["ἑπτά",705357,59]],"And their brethren according to the houses of their fathers; Michael, Mosollam, and Sebee, and Joree, and Joachan, and Zue, and Obed, seven."],["14",[["οὗτοι",709858,201],["υἱοὶ",713075,52],["Αβιχαιλ",700081,18],["υἱοῦ",713075,18],["Ουρι",709846,18],["υἱοῦ",713075,18],["Ιδαι",706482,18],["υἱοῦ",713075,18],["Γαλααδ",702920,18],["υἱοῦ",713075,18],["Μιχαηλ",708953,18],["υἱοῦ",713075,18],["Ισαι",706803,18],["υἱοῦ",713075,18],["Ιουρι",706781,18],["υἱοῦ",713075,18],["Ζαβουχαμ",705815,18]],"These [are] the sons of Abichaia the son of Uri, the son of Idai, the son of Galaad, the son of Michael, the son of Jesai, the son of Jeddai, the son of Buz,"],["15",[["υἱοῦ",713075,18],["Αβδιηλ",700033,18],["υἱοῦ",713075,18],["Γουνι",703180,18],["ἄρχων",701860,72],["οἴκου",709516,18],["πατριῶν",710192,65]],"[who was] the brother of the son of Abdiel, the son of Guni, [he was] chief of the house of their families."],["16",[["κατῴκουν",707534,137],["ἐν",704639,0],["Γαλααδ",702920,1],["ἐν",704639,0],["Βασαν",702564,1],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["κώμαις",708022,76],["αὐτῶν",702165,284],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["περίχωρα",710423,68],["Σαρων",711545,17],["ἕως",705792,0],["ἐξόδου",704948,17]],"They dwelt in Galaad, in Basan, and in their villages, and [in] all the country round about Saron to the border."],["17",[["πάντων",710177,169],["ὁ",709436,3],["καταλοχισμὸς",707319,4],["ἐν",704639,0],["ἡμέραις",705984,76],["Ιωαθαμ",706885,18],["βασιλέως",702580,18],["Ιουδα",706768,18],["καὶ",707031,7],["ἐν",704639,0],["ἡμέραις",705984,76],["Ιεροβοαμ",706629,18],["βασιλέως",702580,18],["Ισραηλ",706839,18]],"The enumeration of [them] all took place in the days of Joatham king of Juda, and in the days of Jeroboam king of Israel."],["18",[["υἱοὶ",713075,52],["Ρουβην",711295,18],["καὶ",707031,7],["Γαδ",702872,18],["καὶ",707031,7],["ἥμισυ",705998,46],["φυλῆς",713620,17],["Μανασση",708470,18],["ἐξ",704132,0],["υἱῶν",713075,81],["δυνάμεως",703839,17],["ἄνδρες",701150,52],["αἴροντες",700473,146],["ἀσπίδας",701991,39],["καὶ",707031,7],["μάχαιραν",708593,9],["καὶ",707031,7],["τείνοντες",712754,146],["τόξον",712898,25],["καὶ",707031,7],["δεδιδαγμένοι",703649,429],["πόλεμον",710605,6],["τεσσαράκοντα",712806,59],["καὶ",707031,7],["τέσσαρες",712808,138],["χιλιάδες",713858,191],["καὶ",707031,7],["ἑπτακόσιοι",705365,138],["καὶ",707031,7],["ἑξήκοντα",704922,59],["ἐκπορευόμενοι",704293,348],["εἰς",704105,0],["παράταξιν",710107,9]],"The sons of Ruben and Gad, and the half-tribe of Manasse, of mighty men, bearing shields and sword, and bending the bow, and skilled in war, [were] forty and four thousand and seven hundred and sixty, going forth to battle."],["19",[["καὶ",707031,7],["ἐποίουν",710582,137],["πόλεμον",710605,6],["μετὰ",708780,0],["τῶν",709436,80],["Αγαρηνῶν",700127,81],["καὶ",707031,7],["Ιτουραίων",706867,81],["καὶ",707031,7],["Ναφισαίων",709217,81],["καὶ",707031,7],["Ναδαβαίων",709158,81]],"And they made war with the Agarenes, and Itureans, and Naphiseans, and Nadabeans,"],["20",[["καὶ",707031,7],["κατίσχυσαν",707531,511],["ἐπ᾿",705080,0],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐδόθησαν",703654,99],["εἰς",704105,0],["χεῖρας",713787,39],["αὐτῶν",702165,40],["οἱ",709436,136],["Αγαραῖοι",700126,52],["καὶ",707031,7],["πάντα",710177,195],["τὰ",709436,63],["σκηνώματα",711849,64],["αὐτῶν",702165,40],["ὅτι",709803,7],["πρὸς",710844,0],["τὸν",709436,5],["θεὸν",706192,6],["ἐβόησαν",702743,150],["ἐν",704639,0],["τῷ",709436,113],["πολέμῳ",710605,114],["καὶ",707031,7],["ἐπήκουσεν",705009,2],["αὐτοῖς",702165,151],["ὅτι",709803,7],["ἤλπισαν",704529,150],["ἐπ᾿",705080,0],["αὐτόν",702165,85]],"and they prevailed against them: and the Agaræans were given into their hands, [they] and all their tents: for they cried to God in the battle, and he hearkened to them, because they trusted on him."],["21",[["καὶ",707031,7],["ᾐχμαλώτευσαν",700500,150],["τὴν",709436,8],["ἀποσκευὴν",701573,9],["αὐτῶν",702165,40],["καμήλους",707110,57],["πεντακισχιλίας",710260,12],["καὶ",707031,7],["προβάτων",710768,44],["διακοσίας",703482,82],["πεντήκοντα",710270,59],["χιλιάδας",713858,39],["ὄνους",709671,57],["δισχιλίους",703747,60],["καὶ",707031,7],["ψυχὰς",714070,39],["ἀνδρῶν",701150,81],["ἑκατὸν",704136,59],["χιλιάδας",713858,39]],"And they took captive their store; five thousand camels, and two hundred and fifty thousand sheep, two thousand asses, and a hundred thousand men."],["22",[["ὅτι",709803,7],["τραυματίαι",712921,52],["πολλοὶ",710646,138],["ἔπεσον",710481,150],["ὅτι",709803,7],["παρὰ",709995,0],["τοῦ",709436,35],["θεοῦ",706192,18],["ὁ",709436,3],["πόλεμος",710605,4],["καὶ",707031,7],["κατῴκησαν",707534,150],["ἀντ᾿",701227,0],["αὐτῶν",702165,40],["ἕως",705792,0],["τῆς",709436,16],["μετοικεσίας",708832,17]],"For many fell slain, because the war [was] of God. And they dwelt in their place until the captivity."],["23",[["καὶ",707031,7],["οἱ",709436,136],["ἡμίσεις",705998,138],["φυλῆς",713620,17],["Μανασση",708470,18],["κατῴκησαν",707534,150],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ἀπὸ",701425,0],["Βασαν",702564,17],["ἕως",705792,0],["Βααλερμων",702339,227],["καὶ",707031,7],["Σανιρ",711494,227],["καὶ",707031,7],["ὄρος",709768,25],["Αερμων",700317,118],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["Λιβάνῳ",708185,114],["αὐτοὶ",702165,201],["ἐπλεονάσθησαν",710516,99]],"And the half-tribe of Manasse dwelt from Basan to Baal, Ermon, and Sanir, and [to] the mount Aërmon: and they increased in Libanus."],["24",[["καὶ",707031,7],["οὗτοι",709858,201],["ἀρχηγοὶ",701838,52],["οἴκου",709516,18],["πατριῶν",710192,65],["αὐτῶν",702165,40],["Οφερ",709868,4],["καὶ",707031,7],["Ισεϊ",706813,4],["καὶ",707031,7],["Ελιηλ",704469,4],["καὶ",707031,7],["Εσδριηλ",705468,4],["καὶ",707031,7],["Ιερμια",706624,4],["καὶ",707031,7],["Ωδουια",714098,4],["καὶ",707031,7],["Ιεδιηλ",706532,4],["ἄνδρες",701150,52],["ἰσχυροὶ",706855,138],["δυνάμει",703839,1],["ἄνδρες",701150,52],["ὀνομαστοί",709669,138],["ἄρχοντες",701862,52],["τῶν",709436,80],["οἴκων",709516,81],["πατριῶν",710192,65],["αὐτῶν",702165,40]],"And these were the heads of the houses of their families; Opher, and Sei, and Eliel, and Jeremia, and Oduia, and Jediel, mighty men of valour, men of renown, heads of the houses of their families."],["25",[["καὶ