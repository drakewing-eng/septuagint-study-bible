[["1",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Χιραμ",713868,4],["βασιλεὺς",702580,4],["Τύρου",713028,18],["ἀγγέλους",700140,57],["πρὸς",710844,0],["Δαυιδ",703232,6],["καὶ",707031,7],["ξύλα",709427,42],["κέδρινα",707589,68],["καὶ",707031,7],["οἰκοδόμους",709511,57],["τοίχων",712879,81],["καὶ",707031,7],["τέκτονας",712766,57],["ξύλων",709427,44],["τοῦ",709436,20],["οἰκοδομῆσαι",709509,106],["αὐτῷ",702165,50],["οἶκον",709516,6]],"And Chiram king of Tyre sent messengers to David, and cedar timbers, and masons, and carpenters, to build a house for him."],["2",[["καὶ",707031,7],["ἔγνω",703105,2],["Δαυιδ",703232,4],["ὅτι",709803,7],["ἡτοίμησεν",705539,2],["αὐτὸν",702165,85],["κύριος",707996,4],["ἐπὶ",705080,0],["Ισραηλ",706839,6],["ὅτι",709803,7],["ηὐξήθη",702144,37],["εἰς",704105,0],["ὕψος",713288,25],["ἡ",709436,10],["βασιλεία",702577,12],["αὐτοῦ",702165,102],["διὰ",703417,0],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["Ισραηλ",706839,6]],"And David knew that the Lord [had] designed him to be king over Israel; because his kingdom was highly exalted, on account of his people Israel."],["3",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Δαυιδ",703232,4],["ἔτι",705538,28],["γυναῖκας",703209,39],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["ἐτέχθησαν",712853,99],["Δαυιδ",703232,4],["ἔτι",705538,28],["υἱοὶ",713075,52],["καὶ",707031,7],["θυγατέρες",706320,191]],"And David took more wives in Jerusalem: and there were born to David more sons and daughters."],["4",[["καὶ",707031,7],["ταῦτα",709858,290],["τὰ",709436,63],["ὀνόματα",709666,64],["αὐτῶν",702165,40],["τῶν",709436,80],["τεχθέντων",712853,249],["οἳ",709781,250],["ἦσαν",704093,137],["αὐτῷ",702165,50],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["Σαμαα",711434,4],["Ισοβααμ",706823,4],["Ναθαν",709164,4],["Σαλωμων",711430,4]],"And these [are] the names of those that were born, who were [born] to him in Jerusalem; Samaa, Sobab, Nathan, and Solomon,"],["5",[["καὶ",707031,7],["Ιβααρ",706471,4],["καὶ",707031,7],["Ελισαε",704481,4],["καὶ",707031,7],["Ελιφαλετ",704496,4]],"and Baar, and Elisa, and Eliphaleth,"],["6",[["καὶ",707031,7],["Ναγε",709153,4],["καὶ",707031,7],["Ναφαγ",709210,4],["καὶ",707031,7],["Ιανουου",706421,4]],"and Nageth, and Naphath, and Japhie,"],["7",[["καὶ",707031,7],["Ελισαμαε",704485,4],["καὶ",707031,7],["Βαλεγδαε",702482,120],["καὶ",707031,7],["Ελιφαλετ",704496,4]],"and Elisamae, and Eliade, and Eliphala."],["8",[["καὶ",707031,7],["ἤκουσαν",700587,150],["ἀλλόφυλοι",700706,52],["ὅτι",709803,7],["ἐχρίσθη",713965,37],["Δαυιδ",703232,4],["βασιλεὺς",702580,4],["ἐπὶ",705080,0],["πάντα",710177,27],["Ισραηλ",706839,6],["καὶ",707031,7],["ἀνέβησαν",700905,150],["πάντες",710177,138],["οἱ",709436,136],["ἀλλόφυλοι",700706,52],["ζητῆσαι",705879,106],["τὸν",709436,5],["Δαυιδ",703232,6],["καὶ",707031,7],["ἤκουσεν",700587,2],["Δαυιδ",703232,4],["καὶ",707031,7],["ἐξῆλθεν",704909,2],["εἰς",704105,0],["ἀπάντησιν",701348,9],["αὐτοῖς",702165,151]],"And the Philistines heard that David was anointed king over all Israel: and all the Philistines went up to seek David; and David heard [it], and went out to meet them."],["9",[["καὶ",707031,7],["ἀλλόφυλοι",700706,52],["ἦλθον",705453,150],["καὶ",707031,7],["συνέπεσον",712332,150],["ἐν",704639,0],["τῇ",709436,100],["κοιλάδι",707758,1],["τῶν",709436,80],["γιγάντων",703101,81]],"And the Philistines came and assembled together in the giants' valley."],["10",[["καὶ",707031,7],["ἠρώτησεν",705459,2],["Δαυιδ",703232,4],["διὰ",703417,0],["τοῦ",709436,35],["θεοῦ",706192,18],["λέγων",708124,72],["εἰ",704071,7],["ἀναβῶ",700905,207],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἀλλοφύλους",700706,60],["καὶ",707031,7],["δώσεις",703654,166],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὰς",709436,38],["χεῖράς",713787,39],["μου",709032,133],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["κύριος",707996,4],["ἀνάβηθι",700905,176],["καὶ",707031,7],["δώσω",703654,165],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὰς",709436,38],["χεῖράς",713787,39],["σου",711945,133]],"And David enquired of God, saying, Shall I go up against the Philistines? and wilt thou deliver them into my hand? And the Lord said to him, Go up, and I will deliver them into thy hands."],["11",[["καὶ",707031,7],["ἀνέβη",700905,2],["εἰς",704105,0],["Βααλφαρασιν",702346,227],["καὶ",707031,7],["ἐπάταξεν",710185,2],["αὐτοὺς",702165,62],["ἐκεῖ",704181,28],["Δαυιδ",703232,4],["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["διέκοψεν",703481,2],["ὁ",709436,3],["θεὸς",706192,4],["τοὺς",709436,58],["ἐχθρούς",705779,57],["μου",709032,133],["ἐν",704639,0],["χειρί",713787,1],["μου",709032,133],["ὡς",714148,7],["διακοπὴν",703480,9],["ὕδατος",713071,21],["διὰ",703417,0],["τοῦτο",709858,129],["ἐκάλεσεν",707084,2],["τὸ",709436,24],["ὄνομα",709666,25],["τοῦ",709436,35],["τόπου",712903,18],["ἐκείνου",704183,102],["Διακοπὴ",703480,12],["φαρασιν",713359,18]],"And he went up to Baal Pharasin, and David smote them there; and David said, God has broken through enemies by my hand like a breach of water: therefore he called the name of that place, the Breach of Pharasin."],["12",[["καὶ",707031,7],["ἐγκατέλιπον",703967,150],["ἐκεῖ",704181,28],["τοὺς",709436,58],["θεοὺς",706192,57],["αὐτῶν",702165,40],["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["κατακαῦσαι",707258,176],["αὐτοὺς",702165,62],["ἐν",704639,0],["πυρί",711088,54]],"And the Philistines left their gods there; and David gave orders to burn them with fire."],["13",[["καὶ",707031,7],["προσέθεντο",710965,189],["ἔτι",705538,28],["ἀλλόφυλοι",700706,52],["καὶ",707031,7],["συνέπεσαν",712332,150],["ἔτι",705538,28],["ἐν",704639,0],["τῇ",709436,100],["κοιλάδι",707758,1],["τῶν",709436,80],["γιγάντων",703101,81]],"And the Philistines once more assembled themselves in the giants' valley."],["14",[["καὶ",707031,7],["ἠρώτησεν",705459,2],["Δαυιδ",703232,4],["ἔτι",705538,28],["ἐν",704639,0],["θεῷ",706192,114],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["ὁ",709436,3],["θεός",706192,4],["οὐ",709805,28],["πο