[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["μετὰ",708780,0],["ταῦτα",709858,71],["καὶ",707031,7],["ἐπάταξεν",710185,2],["Δαυιδ",703232,4],["τοὺς",709436,58],["ἀλλοφύλους",700706,57],["καὶ",707031,7],["ἐτροπώσατο",712981,23],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἔλαβεν",708076,2],["τὴν",709436,8],["Γεθ",703005,9],["καὶ",707031,7],["τὰς",709436,38],["κώμας",708022,39],["αὐτῆς",702165,86],["ἐκ",704132,0],["χειρὸς",713787,17],["ἀλλοφύλων",700706,81]],"And it came to pass afterwards, that David smote the Philistines, and routed them, and took Geth and its villages out of the hand of the Philistines."],["2",[["καὶ",707031,7],["ἐπάταξεν",710185,2],["τὴν",709436,8],["Μωαβ",709085,9],["καὶ",707031,7],["ἦσαν",704093,137],["Μωαβ",709085,12],["παῖδες",709932,52],["τῷ",709436,113],["Δαυιδ",703232,114],["φέροντες",713428,146],["δῶρα",703907,42]],"And he smote Moab; and the Moabites became servants to David, [and] tributaries."],["3",[["καὶ",707031,7],["ἐπάταξεν",710185,2],["Δαυιδ",703232,4],["τὸν",709436,5],["Αδρααζαρ",700288,6],["βασιλέα",702580,6],["Σουβα",711948,17],["Ημαθ",705980,17],["πορευομένου",710667,262],["αὐτοῦ",702165,102],["ἐπιστῆσαι",705756,106],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["ποταμὸν",710693,6],["Εὐφράτην",705716,6]],"And David smote Adraazar king of Suba of Emath, as he was going to establish power toward the river Euphrates."],["4",[["καὶ",707031,7],["προκατελάβετο",710809,23],["Δαυιδ",703232,4],["αὐτῶν",702165,40],["χίλια",713859,68],["ἅρματα",701768,42],["καὶ",707031,7],["ἑπτὰ",705357,59],["χιλιάδας",713858,39],["ἵππων",706790,81],["καὶ",707031,7],["εἴκοσι",704085,59],["χιλιάδας",713858,39],["ἀνδρῶν",701150,81],["πεζῶν",710219,169],["καὶ",707031,7],["παρέλυσεν",710070,2],["Δαυιδ",703232,4],["πάντα",710177,68],["τὰ",709436,41],["ἅρματα",701768,42],["καὶ",707031,7],["ὑπελίπετο",713212,23],["ἐξ",704132,0],["αὐτῶν",702165,40],["ἑκατὸν",704136,59],["ἅρματα",701768,42]],"And David took of them a thousand chariots, and seven thousand horsemen, and twenty thousand infantry: and David houghed all the chariot [horses], but there were reserved of them a hundred chariots."],["5",[["καὶ",707031,7],["ἦλθεν",705453,2],["Σύρος",712541,4],["ἐκ",704132,0],["Δαμασκοῦ",703275,18],["βοηθῆσαι",702746,106],["Αδρααζαρ",700288,114],["βασιλεῖ",702580,114],["Σουβα",711948,17],["καὶ",707031,7],["ἐπάταξεν",710185,2],["Δαυιδ",703232,4],["ἐν",704639,0],["τῷ",709436,113],["Σύρῳ",712541,114],["εἴκοσι",704085,59],["καὶ",707031,7],["δύο",703849,59],["χιλιάδας",713858,39],["ἀνδρῶν",701150,81]],"And the Syrian came from Damascus to help Adraazar king of Suba; and David smote of the Syrian [army] twenty and two thousand men."],["6",[["καὶ",707031,7],["ἔθετο",712849,23],["Δαυιδ",703232,4],["φρουρὰν",713593,9],["ἐν",704639,0],["Συρίᾳ",712533,1],["τῇ",709436,100],["κατὰ",707200,0],["Δαμασκόν",703275,6],["καὶ",707031,7],["ἦσαν",704093,137],["τῷ",709436,113],["Δαυιδ",703232,114],["εἰς",704105,0],["παῖδας",709932,57],["φέροντας",713428,235],["δῶρα",703907,42],["καὶ",707031,7],["ἔσῳζεν",712627,13],["κύριος",707996,4],["τὸν",709436,5],["Δαυιδ",703232,6],["ἐν",704639,0],["πᾶσιν",710177,230],["οἷς",709781,311],["ἐπορεύετο",710667,19]],"And David put a garrison in Syria near Damascus; and they became tributary servants to David: and the Lord delivered David wherever he went."],["7",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Δαυιδ",703232,4],["τοὺς",709436,58],["κλοιοὺς",707741,57],["τοὺς",709436,58],["χρυσοῦς",713971,14],["οἳ",709781,250],["ἦσαν",704093,137],["ἐπὶ",705080,0],["τοὺς",709436,58],["παῖδας",709932,57],["Αδρααζαρ",700288,18],["καὶ",707031,7],["ἤνεγκεν",713428,2],["αὐτοὺς",702165,62],["εἰς",704105,0],["Ιερουσαλημ",706644,9]],"And David took the golden collars that were on the servants of Adraazar, and brought them to Jerusalem."],["8",[["καὶ",707031,7],["ἐκ",704132,0],["τῆς",709436,16],["μεταβηχας",708783,17],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,80],["ἐκλεκτῶν",704240,169],["πόλεων",710612,65],["τῶν",709436,80],["Αδρααζαρ",700288,18],["ἔλαβεν",708076,2],["Δαυιδ",703232,4],["χαλκὸν",713695,6],["πολὺν",710646,27],["σφόδρα",712586,28],["ἐξ",704132,0],["αὐτοῦ",702165,102],["ἐποίησεν",710582,2],["Σαλωμων",711430,4],["τὴν",709436,8],["θάλασσαν",706069,9],["τὴν",709436,8],["χαλκῆν",713690,36],["καὶ",707031,7],["τοὺς",709436,58],["στύλους",712179,57],["καὶ",707031,7],["τὰ",709436,41],["σκεύη",711844,42],["τὰ",709436,41],["χαλκᾶ",713690,68]],"And David took out of Matabeth, and out of the chief cities of Adraazar very much brass: of this Solomon made the brazen sea, and the pillars, and the brazen vessels."],["9",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Θωα",706350,4],["βασιλεὺς",702580,4],["Ημαθ",705980,17],["ὅτι",709803,7],["ἐπάταξεν",710185,2],["Δαυιδ",703232,4],["τὴν",709436,8],["πᾶσαν",710177,36],["δύναμιν",703839,9],["Αδρααζαρ",700288,18],["βασιλέως",702580,18],["Σουβα",711948,17]],"And Thoa king of Emath heard that David had smitten the whole force of Adraazar king of Suba."],["10",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["τὸν",709436,5],["Ιδουραμ",706505,6],["υἱὸν",713075,6],["αὐτοῦ",702165,102],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["Δαυιδ",703232,6],["τοῦ",709436,20],["ἐρωτῆσαι",705459,106],["αὐτὸν",702165,85],["τὰ",709436,41],["εἰς",704105,0],["εἰρήνην",704098,9],["καὶ",707031,7],["τοῦ",709436,20],["εὐλογῆσαι",705631,332],["αὐτὸν",702165,85],["ὑπὲρ",713111,0],["οὗ",709781,48],["ἐπολέμησεν",710601,2],["τὸν",709436,5],["Αδρααζαρ",700288,6],["καὶ",707031,7],["ἐπάταξεν",710185,2],["αὐτόν",702165,85],["ὅτι",709803,7],["ἀνὴρ",701150,4],["πολέμιος",710603,14],["Θωα",706350,4],["ἦν",704093,13],["τῷ",709436,113],["Αδρααζαρ",700288,114],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["σκεύη",711844,42],["ἀργυρᾶ",701705,68],["καὶ",707031,7],["χρυσᾶ",713971,68]],"And he sent Aduram his son to king David to ask how he was, and to congratulate him because he had fought against Adraazar, and smitten him; for Thoa was the enemy of Adraazar."],["11",[["καὶ",707031,7],["ταῦτα",709858,71],["ἡγίασεν",700153,2],["Δαυιδ",703232,4],["τῷ",709436,113],["κυρίῳ",707996,114],["μετὰ",708780,0],["τοῦ",709436,20],["ἀργυρίου",701707,21],["καὶ",707031,7],["τοῦ",709436,20],["χρυσίου",713972,21],["οὗ",709781,48],["ἔλαβεν",708076,2],["ἐκ",704132,0],["πάντων",710177,169],["τῶν",709436,43],["ἐθνῶν",704068,44],["ἐξ",704132,0],["Ιδουμαίας",706503,17],["καὶ",707031,7],["Μωαβ",709085,17],["καὶ",707031,7],["ἐξ",704132,0],["υἱῶν",713075,81],["Αμμων",700847,18],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,80],["ἀλλοφύλων",700706,81],["καὶ",707031,7],["ἐξ",704132,0],["Αμαληκ",700759,18]],"And all the golden and silver and brazen vessels, even these king David consecrated to the Lord, with the silver and the gold which he took from all the nations; from Idumæa, and Moab, and from the children of Ammon, and from the Philistines, and from Amalec."],["12",[["καὶ",707031,7],["Αβεσσα",700051,4],["υἱὸς",713075,4],["Σαρουια",711539,18],["ἐπάταξεν",710185,2],["τὴν",709436,8],["Ιδουμαίαν",706503,9],["ἐν",704639,0],["κοιλάδι",707758,1],["τῶν",709436,80],["ἁλῶν",700728,81],["ὀκτὼ",709555,59],["καὶ",707031,7],["δέκα",703333,59],["χιλιάδας",713858,39]],"And Abesa son of Saruia smote the Idumeans in the valley of Salt, eighteen thousand."],["13",[["καὶ",707031,7],["ἔθετο",712849,23],["ἐν",704639,0],["τῇ",709436,100],["κοιλάδι",707758,1],["φρουράς",713593,39],["καὶ",707031,7],["ἦσαν",704093,137],["πάντες",710177,138],["οἱ",709436,136],["Ιδουμαῖοι",706504,52],["παῖδες",709932,52],["Δαυιδ",703232,18],["καὶ",707031,7],["ἔσῳζεν",712627,13],["κύριος",707996,4],["τὸν",709436,5],["Δαυιδ",703232,6],["ἐν",704639,0],["πᾶσιν",710177,230],["οἷς",709781,311],["ἐπορεύετο",710667,19]],"And he put garrisons in the valley; and all the Idumæans became David's servants: and the Lord delivered David wherever he went."],["14",[["καὶ",707031,7],["ἐβασίλευσεν",702581,2],["Δαυιδ",703232,4],["ἐπὶ",705080,0],["πάντα",710177,27],["Ισραηλ",706839,6],["καὶ",707031,7],["ἦν",704093,13],["ποιῶν",710599,169],["κρίμα",707903,25],["καὶ",707031,7],["δικαιοσύνην",703695,9],["τῷ",709436,113],["παντὶ",710177,30],["λαῷ",708094,114],["αὐτοῦ",702165,102]],"So David reigned over all Israel; and he executed judgment and justice to all his people."],["15",[["καὶ",707031,7],["Ιωαβ",706877,4],["υἱὸς",713075,4],["Σαρουια",711539,18],["ἐπὶ",705080,0],["τῆς",709436,16],["στρατιᾶς",712145,17],["καὶ",707031,7],["Ιωσαφατ",706942,4],["υἱὸς",713075,4],["Αχιλουδ",702276,18],["ὑπομνηματογράφος",713224,4]],"And Joab the son of Saruia [was] over the army, and Josaphat the son of Achilud [was] recorder."],["16",[["καὶ",707031,7],["Σαδωκ",711375,4],["υἱὸς",713075,4],["Αχιτωβ",702297,18],["καὶ",707031,7],["Αχιμελεχ",702282,4],["υἱὸς",713075,4],["Αβιαθαρ",700055,18],["ἱερεῖς",706614,52],["καὶ",707031,7],["Σουσα",711967,4],["γραμματεὺς",703185,4]],"And Sadoc son of Achitob, and Achimelech son of Abiathar, [were] the priests; and Susa [was] the scribe;"],["17",[["καὶ",707031,7],["Βαναιας",702502,4],["υἱὸς",713075,4],["Ιωδαε",706908,18],["ἐπὶ",705080,0],["τοῦ",709436,35],["χερεθθι",713828,18],["καὶ",707031,7],["τοῦ",709436,35],["φελεθθι",713411,18],["καὶ",707031,7],["υἱοὶ",713075,52],["Δαυιδ",703232,18],["οἱ",709436,136],["πρῶτοι",711041,480],["διάδοχοι",703450,52],["τοῦ",709436,35],["βασιλέως",702580,18]],"and Banæas the son of Jodae [was] over the Cherethite and the Phelethite, and the sons of David were the chief deputies of the king."]]