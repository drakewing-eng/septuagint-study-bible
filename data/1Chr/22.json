["διαθήκης",703456,17],["κυρίου",707996,18],["καὶ",707031,7],["σκεύη",711844,42],["τὰ",709436,41],["ἅγια",700159,68],["τοῦ",709436,35],["θεοῦ",706192,18],["εἰς",704105,0],["οἶκον",709516,6],["τὸν",709436,5],["οἰκοδομούμενον",709509,212],["τῷ",709436,53],["ὀνόματι",709666,54],["κυρίου",707996,18]],"Now set your hearts and souls to seek after the Lord your God: and rise, and build a sanctuary to your God to carry in the ark of the covenant of the Lord, and the holy vessels of God, into the house that is to be built to the name of the Lord."]]