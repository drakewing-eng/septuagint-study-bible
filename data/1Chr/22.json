[["1",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["οὗτός",709858,121],["ἐστιν",704093,91],["ὁ",709436,3],["οἶκος",709516,4],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["τοῦτο",709858,132],["τὸ",709436,34],["θυσιαστήριον",706348,15],["εἰς",704105,0],["ὁλοκαύτωσιν",709590,9],["τῷ",709436,113],["Ισραηλ",706839,114]],"And David said, This is the house of the Lord God, and this [is] the altar for whole-burnt-offering for Israel."],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["συναγαγεῖν",712375,106],["πάντας",710177,60],["τοὺς",709436,58],["προσηλύτους",710900,57],["ἐν",704639,0],["γῇ",703083,1],["Ισραηλ",706839,18],["καὶ",707031,7],["κατέστησεν",707011,2],["λατόμους",708104,57],["λατομῆσαι",708102,106],["λίθους",708196,57],["ξυστοὺς",709434,60],["τοῦ",709436,20],["οἰκοδομῆσαι",709509,106],["οἶκον",709516,6],["τῷ",709436,113],["θεῷ",706192,114]],"And David gave orders to gather all the strangers that were in the land of Israel; and he appointed stone-hewers to hew polished stones to build the house to God."],["3",[["καὶ",707031,7],["σίδηρον",711774,6],["πολὺν",710646,27],["εἰς",704105,0],["τοὺς",709436,58],["ἥλους",705977,57],["τῶν",709436,43],["θυρωμάτων",706343,44],["καὶ",707031,7],["τῶν",709436,130],["πυλῶν",711082,65],["καὶ",707031,7],["τοὺς",709436,58],["στροφεῖς",712168,57],["ἡτοίμασεν",705539,2],["Δαυιδ",703232,4],["καὶ",707031,7],["χαλκὸν",713695,6],["εἰς",704105,0],["πλῆθος",710529,25],["οὐκ",709805,28],["ἦν",704093,13],["σταθμός",712040,4]],"And David prepared much iron for the nails of the doors and the gates; the hinges also and brass in abundance, there was no weighing [of it]."],["4",[["καὶ",707031,7],["ξύλα",709427,42],["κέδρινα",707589,68],["οὐκ",709805,28],["ἦν",704093,13],["ἀριθμός",701744,4],["ὅτι",709803,7],["ἐφέροσαν",713428,150],["οἱ",709436,136],["Σιδώνιοι",711776,52],["καὶ",707031,7],["οἱ",709436,136],["Τύριοι",713027,52],["ξύλα",709427,42],["κέδρινα",707589,68],["εἰς",704105,0],["πλῆθος",710529,25],["τῷ",709436,113],["Δαυιδ",703232,114]],"And cedar trees without number: for the Sidonians and the Tyrians brought cedar trees in abundance to David."],["5",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["Σαλωμων",711430,4],["ὁ",709436,3],["υἱός",713075,4],["μου",709032,133],["παιδάριον",709923,25],["ἁπαλόν",701336,46],["καὶ",707031,7],["ὁ",709436,3],["οἶκος",709516,4],["τοῦ",709436,20],["οἰκοδομῆσαι",709509,106],["τῷ",709436,113],["κυρίῳ",707996,114],["εἰς",704105,0],["μεγαλωσύνην",708652,9],["ἄνω",701296,28],["εἰς",704105,0],["ὄνομα",709666,25],["καὶ",707031,7],["εἰς",704105,0],["δόξαν",703791,9],["εἰς",704105,0],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9],["ἑτοιμάσω",705539,165],["αὐτῷ",702165,50],["καὶ",707031,7],["ἡτοίμασεν",705539,2],["Δαυιδ",703232,4],["εἰς",704105,0],["πλῆθος",710529,25],["ἔμπροσθεν",704618,0],["τῆς",709436,16],["τελευτῆς",712782,17],["αὐτοῦ",702165,102]],"And David said, My son Solomon [is] a tender child, and the house [for me] to build to the Lord [is] for superior magnificence for a name and for a glory through all the earth: I will make preparation for it. And David prepared abundantly before his death."],["6",[["καὶ",707031,7],["ἐκάλεσεν",707084,2],["Σαλωμων",711430,4],["τὸν",709436,5],["υἱὸν",713075,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐνετείλατο",704791,23],["αὐτῷ",702165,50],["τοῦ",709436,20],["οἰκοδομῆσαι",709509,106],["τὸν",709436,5],["οἶκον",709516,6],["τῷ",709436,113],["κυρίῳ",707996,114],["θεῷ",706192,114],["Ισραηλ",706839,18]],"And he called Solomon his son, and commanded him to build the house for the Lord God of Israel."],["7",[["καὶ",707031,7],["εἶπεν",705373,2],["Δαυιδ",703232,4],["Σαλωμων",711430,4],["τέκνον",712761,15],["ἐμοὶ",704577,159],["ἐγένετο",703104,23],["ἐπὶ",705080,0],["ψυχῇ",714070,1],["τοῦ",709436,20],["οἰκοδομῆσαι",709509,106],["οἶκον",709516,6],["τῷ",709436,53],["ὀνόματι",709666,54],["κυρίου",707996,18],["θεοῦ",706192,18]],"And David said to Solomon, [My] child, it was in my heart to build a house to the name of the Lord God."],["8",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐπ᾿",705080,0],["ἐμοὶ",704577,159],["λόγος",708236,4],["κυρίου",707996,18],["λέγων",708124,72],["αἷμα",700442,25],["εἰς",704105,0],["πλῆθος",710529,25],["ἐξέχεας",704368,162],["καὶ",707031,7],["πολέμους",710605,57],["μεγάλους",708653,60],["ἐποίησας",710582,162],["οὐκ",709805,28],["οἰκοδομήσεις",709509,166],["οἶκον",709516,6],["τῷ",709436,53],["ὀνόματί",709666,54],["μου",709032,133],["ὅτι",709803,7],["αἵματα",700442,42],["πολλὰ",710646,68],["ἐξέχεας",704368,162],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ἐναντίον",704654,0],["μου",709032,133]],"But the word of the Lord came to me, saying, Thou hast shed blood abundantly, and hast carried on great wars: thou shalt not build a house to my name, because thou hast shed much blood upon the earth before me."],["9",[["ἰδοὺ",706497,88],["υἱὸς",713075,4],["τίκτεταί",712853,403],["σοι",711925,159],["οὗτος",709858,121],["ἔσται",704093,93],["ἀνὴρ",701150,4],["ἀναπαύσεως",701026,17],["καὶ",707031,7],["ἀναπαύσω",701027,207],["αὐτὸν",702165,85],["ἀπὸ",701425,0],["πάντων",710177,169],["τῶν",709436,80],["ἐχθρῶν",705779,81],["κυκλόθεν",707956,28],["ὅτι",709803,7],["Σαλωμων",711430,4],["ὄνομα",709666,25],["αὐτῷ",702165,50],["καὶ",707031,7],["εἰρήνην",704098,9],["καὶ",707031,7],["ἡσυχίαν",706035,9],["δώσω",703654,165],["ἐπὶ",705080,0],["Ισραηλ",706839,6],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["αὐτοῦ",702165,102]],"Behold, a son shall be born to thee, he shall be a man of rest; and I will give him rest from all his enemies round about: for his name [shall be] Solomon, and I will give peace and quietness to Israel in his days."],["10",[["οὗτος",709858,121],["οἰκοδομήσει",709509,127],["οἶκον",709516,6],["τῷ",709436,53],["ὀνόματί",709666,54],["μου",709032,133],["καὶ",707031,7],["οὗτος",709858,121],["ἔσται",704093,93],["μοι",708974,159],["εἰς",704105,0],["υἱὸν",713075,6],["κἀγὼ",706969,288],["αὐτῷ",702165,50],["εἰς",704105,0],["πατέρα",710189,6],["καὶ",707031,7],["ἀνορθώσω",701197,165],["θρόνον",706315,6],["βασιλείας",702577,17],["αὐτοῦ",702165,102],["ἐν",704639,0],["Ισραηλ",706839,114],["ἕως",705792,0],["αἰῶνος",700504,18]],"He shall build a house to my name; and he shall be a son to me, and I will be a father to him; and I will establish the throne of his kingdom in Israel for ever."],["11",[["καὶ",707031,7],["νῦν",709384,28],["υἱέ",713075,153],["μου",709032,133],["ἔσται",704093,93],["μετὰ",708780,0],["σοῦ",711945,133],["κύριος",707996,4],["καὶ",707031,7],["εὐοδώσει",705654,127],["καὶ",707031,7],["οἰκοδομήσεις",709509,166],["οἶκον",709516,6],["τῷ",709436,113],["κυρίῳ",707996,114],["θεῷ",706192,114],["σου",711945,133],["ὡς",714148,7],["ἐλάλησεν",708071,2],["περὶ",710285,0],["σοῦ",711945,133]],"And now, my son, the Lord shall be with thee, and prosper [thee]; and thou shalt build a house to the Lord thy God, as he spoke concerning thee."],["12",[["ἀλλ᾿",700680,7],["ἢ",705924,7],["δῴη",703654,225],["σοι",711925,159],["σοφίαν",711981,9],["καὶ",707031,7],["σύνεσιν",712460,9],["κύριος",707996,4],["καὶ",707031,7],["κατισχύσαι",707531,106],["σε",711598,163],["ἐπὶ",705080,0],["Ισραηλ",706839,6],["καὶ",707031,7],["τοῦ",709436,20],["φυλάσσεσθαι",713619,110],["καὶ",707031,7],["τοῦ",709436,20],["ποιεῖν",710582,55],["τὸν",709436,5],["νόμον",709349,6],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["σου",711945,133]],"Only may the Lord give thee wisdom and prudence, and strengthen thee over Israel, both to keep and to do the law of the Lord thy God."],["13",[["τότε",712908,28],["εὐοδώσει",705654,127],["ἐὰν",703912,7],["φυλάξῃς",713619,175],["τοῦ",709436,20],["ποιεῖν",710582,55],["τὰ",709436,41],["προστάγματα",710959,42],["καὶ",707031,7],["τὰ",709436,41],["κρίματα",707903,42],["ἃ",709781,69],["ἐνετείλατο",704791,23],["κύριος",707996,4],["τῷ",709436,113],["Μωυσῇ",709112,114],["ἐπὶ",705080,0],["Ισραηλ",706839,6],["ἀνδρίζου",701104,253],["καὶ",707031,7],["ἴσχυε",706859,240],["μὴ",708851,28],["φοβοῦ",713532,253],["μηδὲ",708855,7],["πτοηθῇς",711062,279]],"Then will he prosper [thee], if thou take heed to do the commandments and judgments which the Lord commanded Moses for Israel: be courageous and strong; fear not, nor be terrified."],["14",[["καὶ",707031,7],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["κατὰ",707200,0],["τὴν",709436,8],["πτωχείαν",711073,9],["μου",709032,133],["ἡτοίμασα",705539,155],["εἰς",704105,0],["οἶκον",709516,6],["κυρίου",707996,18],["χρυσίου",713972,21],["ταλάντων",712697,44],["ἑκατὸν",704136,59],["χιλιάδας",713858,39],["καὶ",707031,7],["ἀργυρίου",701707,21],["ταλάντων",712697,44],["χιλίας",713859,82],["χιλιάδας",713858,39],["καὶ",707031,7],["χαλκὸν",713695,6],["καὶ",707031,7],["σίδηρον",711774,6],["οὗ",709781,48],["οὐκ",709805,28],["ἔστιν",704093,91],["σταθμός",712040,4],["ὅτι",709803,7],["εἰς",704105,0],["πλῆθός",710529,25],["ἐστιν",704093,91],["καὶ",707031,7],["ξύλα",709427,42],["καὶ",707031,7],["λίθους",708196,57],["ἡτοίμασα",705539,155],["καὶ",707031,7],["πρὸς",710844,0],["ταῦτα",709858,71],["πρόσθες",710965,176]],"And, behold, I according to my poverty have prepared for the house of the Lord a hundred thousand talents of gold, and a million talents of silver, and brass and iron without measure; for it is abundant; and I have prepared timber and stones; and do thou add to these."],["15",[["καὶ",707031,7],["μετὰ",708780,0],["σοῦ",711945,133],["εἰς",704105,0],["πλῆθος",710529,25],["ποιούντων",710582,170],["ἔργα",705396,42],["τεχνῖται",712832,52],["καὶ",707031,7],["οἰκοδόμοι",709511,52],["λίθων",708196,81],["καὶ",707031,7],["τέκτονες",712766,52],["ξύλων",709427,44],["καὶ",707031,7],["πᾶς",710177,14],["σοφὸς",711985,14],["ἐν",704639,0],["παντὶ",710177,97],["ἔργῳ",705396,54]],"And [of them that are] with thee do thou add to the multitude of workmen; [let there be] artificers and masons, and carpenters, and every skilful [workman] in every work;"],["16",[["ἐν",704639,0],["χρυσίῳ",713972,54],["ἐν",704639,0],["ἀργυρίῳ",