709436,35],["οἴκου",709516,18],["τοῦ",709436,35],["θεοῦ",706192,18],["μόσχους",709029,57],["ἑκατόν",704136,59],["κριοὺς",707906,57],["διακοσίους",703482,60],["ἀμνοὺς",700855,57],["τετρακοσίους",712817,60],["χιμάρους",713864,57],["αἰγῶν",700464,81],["περὶ",710285,0],["ἁμαρτίας",700775,17],["ὑπὲρ",713111,0],["παντὸς",710177,116],["Ισραηλ",706839,18],["δώδεκα",703887,59],["εἰς",704105,0],["ἀριθμὸν",701744,6],["φυλῶν",713620,65],["Ισραηλ",706839,18]],"And they offered for the dedication of the house of God a hundred calves, two hundred rams, four hundred lambs, twelve kids of the goats for a sin-offering for all Israel, according to the number of the tribes of Israel."],["18",[["καὶ",707031,7],["ἔστησαν",706846,150],["τοὺς",709436,58],["ἱερεῖς",706614,52],["ἐν",704639,0],["διαιρέσεσιν",703458,76],["αὐτῶν",702165,40],["καὶ",707031,7],["τοὺς",709436,58],["Λευίτας",708160,57],["ἐν",704639,0],["μερισμοῖς",708749,148],["αὐτῶν",702165,40],["ἐπὶ",705080,0],["δουλείᾳ",703813,1],["θεοῦ",706192,18],["τοῦ",709436,35],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["κατὰ",707200,0],["τὴν",709436,8],["γραφὴν",703191,9],["βιβλίου",702719,21],["Μωυσῆ",709112,18]],"And they set the priests in their divisions, and the Levites in their separate orders, for the services of God in Jerusalem, according to the writing of the book of Moses."],["19",[["καὶ",707031,7],["ἐποίησαν",710582,150],["οἱ",709436,136],["υἱοὶ",713075,52],["τῆς",709436,16],["ἀποικεσίας",701462,17],["τὸ",709436,24],["πασχα",710182,25],["τῇ",709436,100],["τεσσαρεσκαιδεκάτῃ",712809,101],["τοῦ",709436,35],["μηνὸς",708874,18],["τοῦ",709436,35],["πρώτου",711041,216]],"And the children of the captivity kept the passover on the fourteenth day of the first month."],["20",[["ὅτι",709803,7],["ἐκαθαρίσθησαν",706985,99],["οἱ",709436,136],["ἱερεῖς",706614,52],["καὶ",707031,7],["οἱ",709436,136],["Λευῖται",708160,52],["ἕως",705792,7],["εἷς",704106,596],["πάντες",710177,138],["καθαροὶ",706988,138],["καὶ",707031,7],["ἔσφαξαν",712571,150],["τὸ",70