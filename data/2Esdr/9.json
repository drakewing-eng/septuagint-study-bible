[["1",[["καὶ",707031,7],["ὡς",714148,7],["ἐτελέσθη",712783,37],["ταῦτα",709858,290],["ἤγγισαν",703939,150],["πρός",710844,0],["με",708618,163],["οἱ",709436,136],["ἄρχοντες",701862,52],["λέγοντες",708124,146],["οὐκ",709805,28],["ἐχωρίσθη",714014,37],["ὁ",709436,3],["λαὸς",708094,4],["Ισραηλ",706839,18],["καὶ",707031,7],["οἱ",709436,136],["ἱερεῖς",706614,52],["καὶ",707031,7],["οἱ",709436,136],["Λευῖται",708160,52],["ἀπὸ",701425,0],["λαῶν",708094,81],["τῶν",709436,80],["γαιῶν",702903,65],["ἐν",704639,0],["μακρύμμασιν",708427,54],["αὐτῶν",702165,40],["τῷ",709436,113],["Χανανι",713712,114],["ὁ",709436,3],["Εθι",704060,4],["ὁ",709436,3],["Φερεζι",713424,4],["ὁ",709436,3],["Ιεβουσι",706520,4],["ὁ",709436,3],["Αμμωνι",700848,4],["ὁ",709436,3],["Μωαβι",709087,4],["ὁ",709436,3],["Μοσερι",709019,4],["καὶ",707031,7],["ὁ",709436,3],["Αμορι",700859,4]],"And when these things were finished, the princes drew near to me, saying, The people of Israel, and the priests, and the Levites, have not separated themselves from the people of the lands in their abominations, [even] the Chananite, the Ethite, the Pherezite, the Jebusite, the Ammonite, the Moabite, and the Moserite and the Amorite."],["2",[["ὅτι",709803,7],["ἐλάβοσαν",708076,150],["ἀπὸ",701425,0],["θυγατέρων",706320,65],["αὐτῶν",702165,40],["ἑαυτοῖς",703917,151],["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτῶν",702165,40],["καὶ",707031,7],["παρήχθη",710007,37],["σπέρμα",712008,25],["τὸ",709436,24],["ἅγιον",700159,46],["ἐν",704639,0],["λαοῖς",708094,148],["τῶν",709436,130],["γαιῶν",702903,65],["καὶ",707031,7],["χεὶρ",713787,12],["τῶν",709436,80],["ἀρχόντων",701862,81],["ἐν",704639,0],["τῇ",709436,100],["ἀσυνθεσίᾳ",702035,1],["ταύτῃ",709858,105],["ἐν",704639,0],["ἀρχῇ",701836,1]],"For they have taken of their daughters for themselves and their sons; and the holy seed has passed among the nations of the lands, and the hand of the rulers [has been] first in this transgression."],["3",[["καὶ",707031,7],["ὡς",714148,7],["ἤκουσα",700587,155],["τὸν",709436,5],["λόγον",708236,6],["τοῦτον",709858,85],["διέρρηξα",703565,155],["τὰ",709436,41],["ἱμάτιά",706742,42],["μου",709032,133],["καὶ",707031,7],["ἐπαλλόμην",709945,334],["καὶ",707031,7],["ἔτιλλον",712854,333],["ἀπὸ",701425,0],["τῶν",709436,130],["τριχῶν",706312,65],["τῆς",709436,16],["κεφαλῆς",707639,17],["μου",709032,133],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,35],["πώγωνός",711115,18],["μου",709032,133],["καὶ",707031,7],["ἐκαθήμην",707000,334],["ἠρεμάζων",706022,72]],"And when I heard this thing, I rent my garments, and trembled, and plucked [some] of the hairs of my head and of my beard, and sat down mourning."],["4",[["καὶ",707031,7],["συνήχθησαν",712375,99],["πρός",710844,0],["με",708618,163],["πᾶς",710177,14],["ὁ",709436,3],["διώκων",703768,72],["λόγον",708236,6],["θεοῦ",706192,18],["Ισραηλ",706839,18],["ἐπὶ",705080,0],["ἀσυνθεσίᾳ",702035,101],["τῆς",709436,16],["ἀποικίας",701463,17],["καὶ",707031,7],["ἐγὼ",704018,164],["καθήμενος",707000,122],["ἠρεμάζων",706023,72],["ἕως",705792,7],["τῆς",709436,16],["θυσίας",706345,17],["τῆς",709436,16],["ἑσπερινῆς",705501,82]],"Then there assembled to me all that followed the word of the God of Israel, on account of the transgression of the captivity; and I remained mourning until the evening sacrifice."],["5",[["καὶ",707031,7],["ἐν",704639,0],["θυσίᾳ",706345,1],["τῇ",709436,100],["ἑσπερινῇ",705501,101],["ἀνέστην",701173,155],["ἀπὸ",701425,0],["ταπεινώσεώς",712719,17],["μου",709032,133],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,53],["διαρρῆξαί",703565,106],["με",708618,163],["τὰ",709436,41],["ἱμάτιά",706742,42],["μου",709032,133],["καὶ",707031,7],["ἐπαλλόμην",709945,334],["καὶ",707031,7],["κλίνω",707738,157],["ἐπὶ",705080,0],["τὰ",709436,41],["γόνατά",703172,42],["μου",709032,133],["καὶ",707031,7],["ἐκπετάζω",704277,157],["τὰς",709436,38],["χεῖράς",713787,39],["μου",709032,133],["πρὸς",710844,0],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6]],"And at the evening sacrifice I rose up from my humiliation; and when I had rent my garments, then I trembled, and I bow myself on my knees, and spread out my hands to the Lord God,"],["6",[["καὶ",707031,7],["εἶπα",705373,155],["κύριε",707996,153],["ᾐσχύνθην",700485,156],["καὶ",707031,7],["ἐνετράπην",704805,156],["τοῦ",709436,35],["ὑψῶσαι",713289,106],["τὸ",709436,24],["πρόσωπόν",710986,25],["μου",709032,133],["πρὸς",710844,0],["σέ",711598,163],["ὅτι",709803,7],["αἱ",709436,190],["ἀνομίαι",701192,191],["ἡμῶν",705999,145],["ἐπληθύνθησαν",710530,99],["ὑπὲρ",713111,0],["κεφαλῆς",707639,17],["ἡμῶν",705999,145],["καὶ",707031,7],["αἱ",709436,190],["πλημμέλειαι",710533,191],["ἡμῶν",705999,145],["ἐμεγαλύνθησαν",708647,99],["ἕως",705792,7],["εἰς",704105,0],["οὐρανόν",709844,6]],"and I said, O Lord, I am ashamed and confounded, O my God, to lift up my face to thee: for our transgressions have abounded over our head, and our trespasses have increased even to heaven."],["7",[["ἀπὸ",701425,0],["ἡμερῶν",705984,65],["πατέρων",710189,81],["ἡμῶν",705999,145],["ἐσμεν",704093,243],["ἐν",704639,0],["πλημμελείᾳ",710533,1],["μεγάλῃ",708653,101],["ἕως",705792,7],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἀνομίαις",701192,76],["ἡμῶν",705999,145],["παρεδόθημεν",710014,485],["ἡμεῖς",705983,219],["καὶ",707031,7],["οἱ",709436,136],["βασιλεῖς",702580,52],["ἡμῶν",705999,145],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["ἡμῶν",705999,145],["ἐν",704639,0],["χειρὶ",713787,1],["βασιλέων",702580,81],["τῶν",709436,43],["ἐθνῶν",704068,44],["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["καὶ",707031,7],["ἐν",704639,0],["αἰχμαλωσίᾳ",700499,1],["καὶ",707031,7],["ἐν",704639,0],["διαρπαγῇ",703561,1],["καὶ",707031,7],["ἐν",704639,0],["αἰσχύνῃ",700483,1],["προσώπου",710986,21],["ἡμῶν",705999,145],["ὡς",714148,7],["ἡ",709436,10],["ἡμέρα",705984,12],["αὕτη",709858,107]],"From the days of our fathers we have been in a great trespass until this day: and because of our iniquities we, and our kings, and our children, have been delivered into the hand of the kings of the Gentiles by the sword, and by captivity, and by spoil, and with shame of our face, as at this day."],["8",[["καὶ",707031,7],["νῦν",709384,28],["ἐπιεικεύσατο",705128,23],["ἡμῖν",705994,90],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["τοῦ",709436,20],["καταλιπεῖν",707305,106],["ἡμῖν",705994,90],["εἰς",704105,0],["σωτηρίαν",712658,9],["καὶ",707031,7],["δοῦναι",703654,106],["ἡμῖν",705994,90],["στήριγμα",712097,25],["ἐν",704639,0],["τόπῳ",712903,114],["ἁγιάσματος",700154,21],["αὐτοῦ",702165,102],["τοῦ",709436,20],["φωτίσαι",713646,106],["ὀφθαλμοὺς",709870,57],["ἡμῶν",705999,145],["καὶ",707031,7],["δοῦναι",703654,106],["ζωοποίησιν",705917,9],["μικρὰν",708915,36],["ἐν",704639,0],["τῇ",709436,100],["δουλείᾳ",703813,1],["ἡμῶν",705999,145]],"And now our God has dealt mercifully with us, so as to leave us to escape, and to give us an establishment in the place of his sanctuary, to enlighten our eyes, and to give a little quickening in our servitude."],["9",[["ὅτι",709803,7],["δοῦλοί",703817,52],["ἐσμεν",704093,243],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["δουλείᾳ",703813,1],["ἡμῶν",705999,145],["οὐκ",709805,28],["ἐγκατέλιπεν",703967,2],["ἡμᾶς",705981,194],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["καὶ",707031,7],["ἔκλινεν",707738,13],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["ἔλεος",704426,4],["ἐνώπιον",704823,27],["βασιλέων",702580,81],["Περσῶν",710429,81],["δοῦναι",703654,106],["ἡμῖν",705994,90],["ζωοποίησιν",705917,9],["τοῦ",709436,35],["ὑψῶσαι",713289,106],["αὐτοὺς",702165,62],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["καὶ",707031,7],["ἀναστῆσαι",701173,106],["τὰ",709436,41],["ἔρημα",705416,42],["αὐτῆς",702165,86],["καὶ",707031,7],["τοῦ",709436,20],["δοῦναι",703654,106],["ἡμῖν",705994,90],["φραγμὸν",713572,6],["ἐν",704639,0],["Ιουδα",706768,114],["καὶ",707031,7],["ἐν",704639,0],["Ιερουσαλημ",706644,1]],"For we are slaves, yet in our servitude the Lord our God has not deserted us; and he has extended favour to us in the sight of the kings of the Persians, to give us a quickening, that they should raise up the house of our God, and restore the desolate places of it, and to give us a fence in Juda and Jerusalem."],["10",[["τί",712867,126],["εἴπωμεν",708124,79],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["μετὰ",708780,0],["τοῦτο",709858,129],["ὅτι",709803,7],["ἐγκατελίπομεν",703967,289],["ἐντολάς",704802,39],["σου",711945,133]],"What shall we say, our God, after this? for we have forsaken thy commandments,"],["11",[["ἃς",709781,193],["ἔδωκας",703654,162],["ἡμῖν",705994,90],["ἐν",704639,0],["χειρὶ",713787,1],["δούλων",703817,81],["σου",711945,133],["τῶν",709436,80],["προφητῶν",711009,81],["λέγων",708124,72],["ἡ",709436,10],["γῆ",703083,12],["εἰς",704105,0],["ἣν",709781,131],["εἰσπορεύεσθε",704124,374],["κληρονομῆσαι",707724,106],["αὐτήν",702165,104],["γῆ",703083,12],["μετακινουμένη",708797,211],["ἐστὶν",704093,91],["ἐν",704639,0],["μετακινήσει",708797,127],["λαῶν",708094,81],["τῶν",709436,43],["ἐθνῶν",704068,44],["ἐν",704639,0],["μακρύμμασιν",708427,96],["αὐτῶν",702165,40],["ὧν",709781,252],["ἔπλησαν",710532,150],["αὐτὴν",702165,104],["ἀπὸ",701425,0],["στόματος",712125,21],["ἐπὶ",705080,0],["στόμα",712125,25],["ἐν",704639,0],["ἀκαθαρσίαις",700507,76],["αὐτῶν",702165,40]],"which thou hast given us by the hand of thy servants the prophets, saying, The land, into which ye go to inherit it, is a land subject to disturbance by the removal of the people of the nations for their abominations, wherewith they have filled it from one end to the other by their uncleannesses."],["12",[["καὶ",707031,7],["νῦν",709384,28],["τὰς",709436,38],["θυγατέρας",706320,39],["ὑμῶν",713091,145],["μὴ",708851,28],["δῶτε",703654,125],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτῶν",702165,40],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,80],["θυγατέρων",706320,65],["αὐτῶν",702165,40],["μὴ",708851,28],["λάβητε",708076,125],["τοῖς",709436,147],["υἱοῖς",713075,148],["ὑμῶν",713091,145],["καὶ",707031,7],["οὐκ",709805,28],["ἐκζητήσετε",704187,337],["εἰρήνην",704098,9],["αὐτῶν",702165,40],["καὶ",707031,7],["ἀγαθὸν",700106,27],["αὐτῶν",702165,40],["ἕως",705792,7],["αἰῶνος",700504,18],["ὅπως",709719,7],["ἐνισχύσητε",704750,125],["καὶ",707031,7],["φάγητε",713296,125],["τὰ",709436,41],["ἀγαθὰ",700106,68],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["κληροδοτήσητε",707723,125],["τοῖς",709436,147],["υἱοῖς",713075,148],["ὑμῶν",713091,145],["ἕως",705792,7],["αἰῶνος",700504,18]],"And now give not your daughters to their sons, and take not of their daughters for your sons, neither shall ye seek their peace or their good for ever: that ye may be strong, and eat the good of the land, and transmit it as an inheritance to your children for ever."],["13",[["καὶ",707031,7],["μετὰ",708780,0],["πᾶν",710177,26],["τὸ",709436,24],["ἐρχόμενον",705453,212],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["ἐν",704639,0],["ποιήμασιν",710583,96],["ἡμῶν",705999,145],["τοῖς",709436,147],["πονηροῖς",710660,230],["καὶ",707031,7],["ἐν",704639,0],["πλημμελείᾳ",710533,1],["ἡμῶν",705999,145],["τῇ",709436,100],["μεγάλῃ",708653,101],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ὡς",714148,7],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["ὅτι",709803,7],["ἐκούφισας",707862,162],["ἡμῶν",705999,145],["τὰς",709436,38],["ἀνομίας",701192,17],["καὶ",707031,7],["ἔδωκας",703654,162],["ἡμῖν",705994,90],["σωτηρίαν",712658,9]],"And after all that is come upon us because of our evil deeds, and our great trespass, [it is clear] that there is none such as our God, for thou hast lightly visited our iniquities, and given us deliverance;"],["14",[["ὅτι",709803,7],["ἐπεστρέψαμεν",705278,289],["διασκεδάσαι",703575,106],["ἐντολάς",704802,39],["σου",711945,133],["καὶ",707031,7],["ἐπιγαμβρεῦσαι",705099,106],["τοῖς",709436,147],["λαοῖς",708094,148],["τῶν",709436,80],["γαιῶν",702903,65],["μὴ",708851,28],["παροξυνθῇς",710164,279],["ἐν",704639,0],["ἡμῖν",705994,90],["ἕως",705792,7],["συντελείας",712509,17],["τοῦ",709436,35],["μὴ",708851,28],["εἶναι",704093,55],["ἐγκατάλειμμα",703966,15],["καὶ",707031,7],["διασῳζόμενον",703599,212]],"whereas we have repeatedly broken thy commandments, and intermarried with the people of the lands: be not very angry with us to [our] utter destruction, so that there should be no remnant or escaping one."],["15",[["κύριε",707996,153],["ὁ",709436,3],["θεὸς",706192,4],["Ισραηλ",706839,18],["δίκαιος",703694,14],["σύ",712181,164],["ὅτι",709803,7],["κατελείφθημεν",707305,485],["διασῳζόμενοι",703599,348],["ὡς",714148,7],["ἡ",709436,10],["ἡμέρα",705984,12],["αὕτη",709858,107],["ἰδοὺ",706497,88],["ἡμεῖς",705983,219],["ἐναντίον",704654,28],["σου",711945,133],["ἐν",704639,0],["πλημμελείαις",710533,76],["ἡμῶν",705999,145],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["στῆναι",706846,106],["ἐνώπιόν",704823,27],["σου",711945,133],["ἐπὶ",705080,0],["τούτῳ",709858,50]],"O Lord God of Israel, thou [art] righteous; for we remain [yet] escaped, as at this day: behold, we [are] before thee in our trespasses: for we cannot stand before thee on this account."]]