[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὡς",714148,28],["ἤκουσεν",700587,2],["Σαναβαλλατ",711486,4],["καὶ",707031,7],["Τωβια",713038,4],["καὶ",707031,7],["οἱ",709436,136],["Ἄραβες",701694,52],["καὶ",707031,7],["οἱ",709436,136],["Αμμανῖται",700834,52],["ὅτι",709803,7],["ἀνέβη",700905,2],["φυὴ",713610,12],["τοῖς",709436,95],["τείχεσιν",712759,96],["Ιερουσαλημ",706644,17],["ὅτι",709803,7],["ἤρξαντο",701860,189],["αἱ",709436,190],["διασφαγαὶ",703596,191],["ἀναφράσσεσθαι",701087,110],["καὶ",707031,7],["πονηρὸν",710660,46],["αὐτοῖς",702165,151],["ἐφάνη",713311,37],["σφόδρα",712586,28]],"But it came to pass, when Sanaballat and Tobia, and the Arabians, and the Ammanites, heard that the building of the walls of Jerusalem was advancing, [and] that the breaches began to be stopped, that it appeared very grievous to them."],["2",[["καὶ",707031,7],["συνήχθησαν",712375,99],["πάντες",710177,138],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτὸ",702165,129],["ἐλθεῖν",705453,106],["παρατάξασθαι",710108,109],["ἐν",704639,0],["Ιερουσαλημ",706644,1]],"And all of them assembled together, to come to fight against Jerusalem, and to destroy it utterly.",{"s":"d","q":0.55}],["3",[["καὶ",707031,7],["προσηυξάμεθα",710893,316],["πρὸς",710844,0],["τὸν",709436,5],["θεὸν",706192,6],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐστήσαμεν",706846,289],["προφύλακας",711013,57],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["ἡμέρας",705984,17],["καὶ",707031,7],["νυκτὸς",709386,17],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτῶν",702165,40]],"So we prayed to our God and set watchmen against them day and night, because of them."],["4",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιουδας",706775,4],["συνετρίβη",712520,37],["ἡ",709436,10],["ἰσχὺς",706858,12],["τῶν",709436,80],["ἐχθρῶν",705779,81],["καὶ",707031,7],["ὁ",709436,3],["χοῦς",713930,4],["πολύς",710646,14],["καὶ",707031,7],["ἡμεῖς",705983,219],["οὐ",709805,28],["δυνησόμεθα",703838,141],["οἰκοδομεῖν",709509,55],["ἐν",704639,0],["τῷ",709436,53],["τείχει",712759,54]],"And Juda said, The strength of the enemies is broken, yet [there is] much rubbish, and we shall not be able to build the wall."],["5",[["καὶ",707031,7],["εἶπαν",705373,150],["οἱ",709436,136],["θλίβοντες",706274,146],["ἡμᾶς",705981,194],["οὐ",709805,28],["γνώσονται",703105,135],["καὶ",707031,7],["οὐκ",709805,28],["ὄψονται",709725,135],["ἕως",705792,7],["ὅτου",709793,581],["ἔλθωμεν",705453,79],["εἰς",704105,0],["μέσον",708768,27],["αὐτῶν",702165,40],["καὶ",707031,7],["φονεύσωμεν",713546,79],["αὐτοὺς",702165,62],["καὶ",707031,7],["καταπαύσωμεν",707365,79],["τὸ",709436,24],["ἔργον",705396,25]],"And they that afflicted us said, They shall not know, and they shall not see, until we come into the midst of them, and slay them, and cause the work to cease."],["6",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὡς",714148,7],["ἤλθοσαν",705453,150],["οἱ",709436,136],["Ιουδαῖοι",706772,52],["οἱ",709436,136],["οἰκοῦντες",709499,146],["ἐχόμενα",705785,67],["αὐτῶν",702165,40],["καὶ",707031,7],["εἴποσαν",705415,150],["ἡμῖν",705994,90],["ἀναβαίνουσιν",700905,197],["ἐκ",704132,0],["πάντων",710177,169],["τῶν",709436,80],["τόπων",712903,81],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194]],"And it came to pass, when the Jews who lived near them came, that they said to us, They are coming up against us from every quarter."],["7",[["καὶ",707031,7],["ἔστησα",706846,155],["εἰς",704105,0],["τὰ",709436,41],["κατώτατα",707562,430],["τοῦ",709436,35],["τόπου",712903,18],["κατόπισθεν",707544,0],["τοῦ",709436,20],["τείχους",712759,21],["ἐν",704639,0],["τοῖς",709436,147],["σκεπεινοῖς",711837,148],["καὶ",707031,7],["ἔστησα",706846,155],["τὸν",709436,5],["λαὸν",708094,6],["κατὰ",707200,0],["δήμους",703411,57],["μετὰ",708780,0],["ῥομφαιῶν",711291,65],["αὐτῶν",702165,40],["λόγχας",708237,39],["αὐτῶν",702165,40],["καὶ",707031,7],["τόξα",712898,42],["αὐτῶν",702165,40]],"So I set [men] in the lowest part of the place behind the wall in the lurking-places, I even set the people according to their families, with their swords, their spears, and their bows."],["8",[["καὶ",707031,7],["εἶδον",709725,155],["καὶ",707031,7],["ἀνέστην",701173,155],["καὶ",707031,7],["εἶπα",705373,155],["πρὸς",710844,0],["τοὺς",709436,58],["ἐντίμους",704798,60],["καὶ",707031,7],["πρὸς",710844,0],["τοὺς",709436,58],["στρατηγοὺς",712144,57],["καὶ",707031,7],["πρὸς",710844,0],["τοὺς",709436,58],["καταλοίπους",707317,60],["τοῦ",709436,35],["λαοῦ",708094,18],["μὴ",708851,28],["φοβηθῆτε",713532,394],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτῶν",702165,40],["μνήσθητε",708960,394],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["τοῦ",709436,35],["μεγάλου",708653,116],["καὶ",707031,7],["φοβεροῦ",713530,116],["καὶ",707031,7],["παρατάξασθε",710108,186],["περὶ",710285,0],["τῶν",709436,80],["ἀδελφῶν",700249,81],["ὑμῶν",713091,145],["υἱῶν",713075,81],["ὑμῶν",713091,145],["καὶ",707031,7],["θυγατέρων",706320,65],["ὑμῶν",713091,145],["γυναικῶν",703209,65],["ὑμῶν",713091,145],["καὶ",707031,7],["οἴκων",709516,81],["ὑμῶν",713091,145]],"And I looked, and arose, and said to the nobles, and to the captains, and to the rest of the people, Be not afraid of them: remember our great and terrible God, and fight for your brethren, your sons, your daughters, your wives, and your houses."],["9",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἡνίκα",706008,28],["ἤκουσαν",700587,150],["οἱ",709436,136],["ἐχθροὶ",705779,52],["ἡμῶν",705999,145],["ὅτι",709803,7],["ἐγνώσθη",703105,37],["ἡμῖν",705994,90],["καὶ",707031,7],["διεσκέδασεν",703575,2],["ὁ",709436,3],["θεὸς",706192,4],["τὴν",709436,8],["βουλὴν",702792,9],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπεστρέψαμεν",705278,289],["πάντες",710177,138],["ἡμεῖς",705983,219],["εἰς",704105,0],["τὸ",709436,24],["τεῖχος",712759,25],["ἀνὴρ",701150,4],["εἰς",704105,0],["τὸ",709436,24],["ἔργον",705396,25],["αὐτοῦ",702165,102]],"And it came to pass, when our enemies heard that it was made known to us, and God had frustrated their counsel, that we all returned to the wall, [every] man to his work."],["10",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἀπὸ",701425,0],["τῆς",709436,16],["ἡμέρας",705984,17],["ἐκείνης",704183,86],["ἥμισυ",705998,26],["τῶν",709436,80],["ἐκτετιναγμένων",704334,445],["ἐποίουν",710582,137],["τὸ",709436,24],["ἔργον",705396,25],["καὶ",707031,7],["ἥμισυ",705998,46],["αὐτῶν",702165,40],["ἀντείχοντο",701225,139],["καὶ",707031,7],["λόγχαι",708237,191],["καὶ",707031,7],["θυρεοὶ",706338,52],["καὶ",707031,7],["τὰ",709436,63],["τόξα",712898,64],["καὶ",707031,7],["οἱ",709436,136],["θώρακες",706356,52],["καὶ",707031,7],["οἱ",709436,136],["ἄρχοντες",701862,52],["ὀπίσω",709697,0],["παντὸς",710177,116],["οἴκου",709516,18],["Ιουδα",706768,18]],"And it came to pass from that day [that] half of them that had been driven forth, wrought the work, and half of them kept guard; and [there were] spears, and shields, and bows, and breast-plates, and rulers behind the whole house of Juda,"],["11",[["τῶν",709436,80],["οἰκοδομούντων",709509,170],["ἐν",704639,0],["τῷ",709436,53],["τείχει",712759,54],["καὶ",707031,7],["οἱ",709436,136],["αἴροντες",700473,146],["ἐν",704639,0],["τοῖς",709436,147],["ἀρτῆρσιν",701825,148],["ἐν",704639,0],["ὅπλοις",709704,96],["ἐν",704639,0],["μιᾷ",704106,101],["χειρὶ",713787,1],["ἐποίει",710582,13],["αὐτὸ",702165,129],["τὸ",709436,24],["ἔργον",705396,25],["καὶ",707031,7],["μία",704106,195],["ἐκράτει",707883,54],["τὴν",709436,8],["βολίδα",702756,9]],"even of them that were building the wall:—and those who carried the burdens [were] under arms: [each] with one hand wrought his work, and with the other held his dart."],["12",[["καὶ",707031,7],["οἱ",709436,136],["οἰκοδόμοι",709511,52],["ἀνὴρ",701150,4],["ῥομφαίαν",711291,9],["αὐτοῦ",702165,102],["ἐζωσμένος",705913,251],["ἐπὶ",705080,0],["τὴν",709436,8],["ὀσφὺν",709800,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ᾠκοδομοῦσαν",709509,137],["καὶ",707031,7],["ὁ",709436,3],["σαλπίζων",711425,72],["ἐν",704639,0],["τῇ",709436,100],["κερατίνῃ",707629,1],["ἐχόμενα",705785,67],["αὐτοῦ",702165,102]],"And the builders [wrought] each man having his sword girt upon his loins, and so they built: and the trumpeter with his trumpet next to him."],["13",[["καὶ",707031,7],["εἶπα",705373,155],["πρὸς",710844,0],["τοὺς",709436,58],["ἐντίμους",704798,60],["καὶ",707031,7],["πρὸς",710844,0],["τοὺς",709436,58],["ἄρχοντας",701862,57],["καὶ",707031,7],["πρὸς",710844,0],["τοὺς",709436,58],["καταλοίπους",707317,60],["τοῦ",709436,35],["λαοῦ",708094,18],["τὸ",709436,132],["ἔργον",705396,15],["πλατὺ",710509,26],["καὶ",707031,7],["πολύ",710646,26],["καὶ",707031,7],["ἡμεῖς",705983,219],["σκορπιζόμεθα",711881,378],["ἐπὶ",705080,0],["τοῦ",709436,20],["τείχους",712759,21],["μακρὰν",708411,28],["ἀνὴρ",701150,4],["ἀπὸ",701425,0],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["αὐτοῦ",702165,102]],"And I said to the nobles, and to the rulers, and to the rest of the people, The work [is] great and abundant, and we are dispersed upon the wall, each at a great distance from his brother."],["14",[["ἐν",704639,0],["τόπῳ",712903,114],["οὗ",709781,48],["ἐὰν",703912,7],["ἀκούσητε",700587,125],["τὴν",709436,8],["φωνὴν",713640,9],["τῆς",709436,16],["κερατίνης",707629,17],["ἐκεῖ",704181,28],["συναχθήσεσθε",712375,261],["πρὸς",710844,0],["ἡμᾶς",705981,194],["καὶ",707031,7],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145],["πολεμήσει",710601,127],["περὶ",710285,0],["ἡμῶν",705999,145]],"In whatsoever place ye shall hear the sound of the cornet, thither gather yourselves together to us; and our God shall fight for us."],["15",[["καὶ",707031,7],["ἡμεῖς",705983,219],["ποιοῦντες",710582,146],["τὸ",709436,24],["ἔργον",705396,25],["καὶ",707031,7],["ἥμισυ",705998,26],["αὐτῶν",702165,40],["κρατοῦντες",707879,146],["τὰς",709436,38],["λόγχας",708237,39],["ἀπὸ",701425,0],["ἀναβάσεως",700907,17],["τοῦ",709436,35],["ὄρθρου",709745,18],["ἕως",705792,7],["ἐξόδου",704948,17],["τῶν",709436,80],["ἄστρων",702024,44]],"So we [continued] labouring at the work: and half of them held the spears from the rising of the morning until the stars appeared."],["16",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["εἶπα",705373,155],["τῷ",709436,113],["λαῷ",708094,114],["αὐλίσθητε",702138,372],["ἐν",704639,0],["μέσῳ",708768,30],["Ιερουσαλημ",706644,17],["καὶ",707031,7],["ἔστω",704093,31],["ὑμῖν",713084,90],["ἡ",709436,10],["νὺξ",709386,12],["προφυλακὴ",711012,12],["καὶ",707031,7],["ἡ",709436,10],["ἡμέρα",705984,12],["ἔργον",705396,15]],"And at that time I said to the people, Lodge ye every man with his servant in the midst of Jerusalem, and let the night be a watch-time to you, and the day a work-time."],["17",[["καὶ",707031,7],["ἤμην",704093,334],["ἐγὼ",704018,164],["καὶ",707031,7],["οἱ",709436,136],["ἄνδρες",701150,52],["τῆς",709436,16],["προφυλακῆς",711012,17],["ὀπίσω",709697,28],["μου",709032,133],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ἐξ",704132,0],["ἡμῶν",705999,145],["ἐκδιδυσκόμενος",704180,122],["ἀνὴρ",701150,4],["τὰ",709436,41],["ἱμάτια",706742,42],["αὐτοῦ",702165,102]],"And I was [there], and the watchmen behind me, and there was not a man of us that put off his garments."]]