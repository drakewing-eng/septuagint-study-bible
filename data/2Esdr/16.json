[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["καθὼς",707030,28],["ἠκούσθη",700587,37],["τῷ",709436,113],["Σαναβαλλατ",711486,114],["καὶ",707031,7],["Τωβια",713038,114],["καὶ",707031,7],["τῷ",709436,113],["Γησαμ",703097,114],["τῷ",709436,113],["Αραβι",701672,114],["καὶ",707031,7],["τοῖς",709436,147],["καταλοίποις",707317,230],["τῶν",709436,80],["ἐχθρῶν",705779,81],["ἡμῶν",705999,145],["ὅτι",709803,7],["ᾠκοδόμησα",709509,155],["τὸ",709436,24],["τεῖχος",712759,25],["καὶ",707031,7],["οὐ",709805,28],["κατελείφθη",707305,37],["ἐν",704639,0],["αὐτοῖς",702165,151],["πνοή",710574,12],["ἕως",705792,0],["τοῦ",709436,35],["καιροῦ",707047,18],["ἐκείνου",704183,102],["θύρας",706337,39],["οὐκ",709805,28],["ἐπέστησα",705756,155],["ἐν",704639,0],["ταῖς",709436,75],["πύλαις",711082,76]],"Now it came to pass, when Sanaballat, and Tobias, and Gesam the Arabian, and the rest of our enemies, heard that I had built the wall, and [that] there was no opening left therein; ([but] hitherto I had not set up the doors on the gates;)"],["2",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Σαναβαλλατ",711486,4],["καὶ",707031,7],["Γησαμ",703097,4],["πρός",710844,0],["με",708618,163],["λέγων",708124,72],["δεῦρο",703382,88],["καὶ",707031,7],["συναχθῶμεν",712375,283],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτὸ",702165,129],["ἐν",704639,0],["ταῖς",709436,75],["κώμαις",708022,76],["ἐν",704639,0],["πεδίῳ",710215,54],["Ωνω",714123,18],["καὶ",707031,7],["αὐτοὶ",702165,201],["λογιζόμενοι",708232,348],["ποιῆσαί",710582,106],["μοι",708974,159],["πονηρίαν",710659,9]],"that Sanaballat and Gesam sent to me, saying, Come and let us meet together in the villages in the plain of Ono. But they [were] plotting to do me mischief."],["3",[["καὶ",707031,7],["ἀπέστειλα",701592,155],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["ἀγγέλους",700140,57],["λέγων",708124,72],["ἔργον",705396,25],["μέγα",708653,46],["ἐγὼ",704018,164],["ποιῶ",710582,157],["καὶ",707031,7],["οὐ",709805,28],["δυνήσομαι",703838,181],["καταβῆναι",707202,106],["μήποτε",708882,28],["καταπαύσῃ",707365,172],["τὸ",709436,34],["ἔργον",705396,15],["ὡς",714148,7],["ἂν",700900,11],["τελειώσω",712771,165],["αὐτό",702165,129],["καταβήσομαι",707202,181],["πρὸς",710844,0],["ὑμᾶς",713080,194]],"So I sent messengers to them, saying, I am doing a great work, and I shall not be able to come down, lest the work should cease: as soon as I shall have finished it, I will come down to you."],["4",[["καὶ",707031,7],["ἀπέστειλαν",701592,150],["πρός",710844,0],["με",708618,163],["ὡς",714148,7],["τὸ",709436,24],["ῥῆμα",711246,25],["τοῦτο",709858,129],["καὶ",707031,7],["ἀπέστειλα",701592,155],["αὐτοῖς",702165,151],["κατὰ",707200,0],["ταῦτα",709858,71]],"And they sent to me [again] to this effect; and I sent them [word] accordingly."],["5",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["πρός",710844,0],["με",708618,163],["Σαναβαλλατ",711486,4],["τὸν",709436,5],["παῖδα",709932,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπιστολὴν",705272,9],["ἀνεῳγμένην",701186,444],["ἐν",704639,0],["χειρὶ",713787,1],["αὐτοῦ",702165,102]],"Then Sanaballat sent his servant to me with an open letter in his hand."],["6",[["καὶ",707031,7],["ἦν",704093,13],["γεγραμμένον",703194,327],["ἐν",704639,0],["αὐτῇ",702165,105],["ἐν",704639,0],["ἔθνεσιν",704068,96],["ἠκούσθη",700587,37],["ὅτι",709803,7],["σὺ",712181,164],["καὶ",707031,7],["οἱ",709436,136],["Ιουδαῖοι",706772,52],["λογίζεσθε",708232,374],["ἀποστατῆσαι",701589,106],["διὰ",703417,0],["τοῦτο",709858,129],["σὺ",712181,164],["οἰκοδομεῖς",709509,154],["τὸ",709436,24],["τεῖχος",712759,25],["καὶ",707031,7],["σὺ",712181,164],["γίνῃ",703104,259],["αὐτοῖς",702165,151],["εἰς",704105,0],["βασιλέα",702580,6]],"And in it was written, It has been reported among the Gentiles that thou and the Jews are planning to revolt: therefore thou art building the wall, and thou wilt be a king to them."],["7",[["καὶ",707031,7],["πρὸς",710844,0],["τούτοις",709858,151],["προφήτας",711009,57],["ἔστησας",706846,162],["σεαυτῷ",711599,50],["ἵνα",706747,7],["καθίσῃς",707006,175],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["εἰς",704105,0],["βασιλέα",702580,6],["ἐν",704639,0],["Ιουδα",706768,114],["καὶ",707031,7],["νῦν",709384,28],["ἀπαγγελήσονται",701321,144],["τῷ",709436,113],["βασιλεῖ",702580,114],["οἱ",709436,136],["λόγοι",708236,52],["οὗτοι",709858,201],["καὶ",707031,7],["νῦν",709384,28],["δεῦρο",703382,88],["βουλευσώμεθα",702791,276],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτό",702165,129]],"And moreover thou hast appointed prophets to thyself, that thou mightest dwell in Jerusalem as a king over Juda: and now these words will be reported to the king. Now then, come, let us take counsel together."],["8",[["καὶ",707031,7],["ἀπέστειλα",701592,155],["πρὸς",710844,0],["αὐτὸν",702165,85],["λέγων",708124,72],["οὐκ",709805,28],["ἐγενήθη",703104,37],["ὡς",714148,7],["οἱ",709436,136],["λόγοι",708236,52],["οὗτοι",709858,201],["οὓς",709781,298],["σὺ",712181,164],["λέγεις",708124,154],["ὅτι",709803,7],["ἀπὸ",701425,0],["καρδίας",707141,17],["σου",711945,133],["σὺ",712181,164],["ψεύδῃ",714045,259],["αὐτούς",702165,62]],"And I sent to him, saying, It has not happened according to these words, [even] as thou sayest, for thou framest them falsely out of thy heart."],["9",[["ὅτι",709803,7],["πάντες",710177,138],["φοβερίζουσιν",713527,197],["ἡμᾶς",705981,194],["λέγοντες",708124,146],["ἐκλυθήσονται",704254,144],["αἱ",709436,190],["χεῖρες",713787,191],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["τοῦ",709436,20],["ἔργου",705396,21],["τούτου",709858,49],["καὶ",707031,7],["οὐ",709805,28],["ποιηθήσεται",710582,134],["καὶ",707031,7],["νῦν",709384,28],["ἐκραταίωσα",707875,155],["τὰς",709436,38],["χεῖράς",713787,39],["μου",709032,133]],"For all were trying to alarm us, saying, Their hands shall be weakened from this work, and it shall not be done. Now therefore I have strengthened my hands."],["10",[["καὶ",707031,7],["ἐγὼ",704018,164],["εἰσῆλθον",704114,150],["εἰς",704105,0],["οἶκον",709516,6],["Σεμεϊ",711666,18],["υἱοῦ",713075,18],["Δαλαια",703261,18],["υἱοῦ",713075,18],["Μεηταβηλ",708662,18],["καὶ",707031,7],["αὐτὸς",702165,121],["συνεχόμενος",712469,122],["καὶ",707031,7],["εἶπεν",705373,2],["συναχθῶμεν",712375,283],["εἰς",704105,0],["οἶκον",709516,6],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐν",704639,0],["μέσῳ",708768,30],["αὐτοῦ",702165,102],["καὶ",707031,7],["κλείσωμεν",707710,79],["τὰς",709436,38],["θύρας",706337,39],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ἔρχονται",705453,269],["νυκτὸς",709386,17],["φονεῦσαί",713546,106],["σε",711598,163]],"And I came into the house of Semei the son of Dalaia the son of Metabeel, and he was shut up; and he said, Let us assemble together in the house of God, in the midst of it, and let us shut the doors of it; for they are coming by night to slay thee."],["11",[["καὶ",707031,7],["εἶπα",705373,155],["τίς",712867,158],["ἐστιν",704093,91],["ὁ",709436,3],["ἀνήρ",701150,4],["ὃς",709781,213],["εἰσελεύσεται",704114,93],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["καὶ",707031,7],["ζήσεται",705851,93]],"And I said, Who is the man that shall enter into the house, that he may live?"],["12",[["καὶ",707031,7],["ἐπέγνων",705104,155],["καὶ",707031,7],["ἰδοὺ",706497,88],["ὁ",709436,3],["θεὸς",706192,4],["οὐκ",709805,28],["ἀπέστειλεν",701592,2],["αὐτόν",702165,85],["ὅτι",709803,7],["ἡ",709436,10],["προφητεία",711007,12],["λόγος",708236,4],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["Τωβιας",713040,4],["καὶ",707031,7],["Σαναβαλλατ",711486,4],["ἐμισθώσαντο",708940,189]],"And I observed, and, behold, God had not sent him, for the prophecy was a fable [devised] against me:"],["13",[["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ὄχλον",709884,6],["ὅπως",709719,7],["φοβηθῶ",713532,321],["καὶ",707031,7],["ποιήσω",710582,207],["οὕτως",709859,28],["καὶ",707031,7],["ἁμάρτω",700773,207],["καὶ",707031,7],["γένωμαι",703104,410],["αὐτοῖς",702165,151],["εἰς",704105,0],["ὄνομα",709666,25],["πονηρόν",710660,46],["ὅπως",709719,7],["ὀνειδίσωσίν",709655,234],["με",708618,163]],"and Tobias and Sanaballat had hired against me a multitude, that I might be frightened, and do this, and sin, and become to them an ill name, that they might reproach me."],["14",[["μνήσθητι",708960,244],["ὁ",709436,3],["θεός",706192,153],["τῷ",709436,113],["Τωβια",713038,114],["καὶ",707031,7],["τῷ",709436,113],["Σαναβαλλατ",711486,114],["ὡς",714148,7],["τὰ",709436,41],["ποιήματα",710583,42],["αὐτοῦ",702165,102],["ταῦτα",709858,71],["καὶ",707031,7],["τῷ",709436,113],["Νωαδια",709392,114],["τῷ",709436,113],["προφήτῃ",711009,114],["καὶ",707031,7],["τοῖς",709436,147],["καταλοίποις",707317,230],["τῶν",709436,80],["προφητῶν",711009,81],["οἳ",709781,250],["ἦσαν",704093,137],["φοβερίζοντές",713527,146],["με",708618,163]],"Remember, O God, Tobias and Sanaballat, according to these their deeds, and the prophetess Noadia, and the rest of the prophets who tried to alarm me."],["15",[["καὶ",707031,7],["ἐτελέσθη",712783,37],["τὸ",709436,34],["τεῖχος",712759,15],["πέμπτῃ",710245,101],["καὶ",707031,7],["εἰκάδι",704082,1],["τοῦ",709436,35],["Ελουλ",704528,18],["εἰς",704105,0],["πεντήκοντα",710270,59],["καὶ",707031,7],["δύο",703849,59],["ἡμέρας",705984,39]],"So the wall was finished on the twenty-fifth day of the [month] Elul, in fifty-two days."],["16",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἡνίκα",706008,28],["ἤκουσαν",700587,150],["πάντες",710177,138],["οἱ",709436,136],["ἐχθροὶ",705779,52],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐφοβήθησαν",713532,99],["πάντα",710177,26],["τὰ",709436,63],["ἔθνη",704068,64],["τὰ",709436,63],["κύκλῳ",707959,114],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐπέπεσεν",705225,2],["φόβος",713534,4],["σφόδρα",712586,28],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["αὐτῶν",702165,40],["καὶ",707031,7],["ἔγνωσαν",703105,150],["ὅτι",709803,7],["παρὰ",709995,0],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["ἐγενήθη",703104,37],["τελειωθῆναι",712771,179],["τὸ",709436,24],["ἔργον",705396,25],["τοῦτο",709858,129]],"And it came to pass, when all our enemies heard [of it], that all the nations round about us feared, and great alarm fell upon them, and they knew that it was of our God that this work should be finished."],["17",[["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["ἀπὸ",701425,0],["πολλῶν",710646,169],["ἐντίμων",704798,169],["Ιουδα",706768,18],["ἐπιστολαὶ",705272,191],["ἐπορεύοντο",710667,139],["πρὸς",710844,0],["Τωβιαν",713039,6],["καὶ",707031,7],["αἱ",709436,190],["Τωβια",713038,18],["ἤρχοντο",705453,139],["πρὸς",710844,0],["αὐτούς",702165,62]],"And in those days letters came to Tobias from many nobles of Juda, and those of Tobias came to them."],["18",[["ὅτι",709803,7],["πολλοὶ",710646,138],["ἐν",704639,0],["Ιουδα",706768,114],["ἔνορκοι",704778,138],["ἦσαν",704093,137],["αὐτῷ",702165,50],["ὅτι",709803,7],["γαμβρὸς",702950,4],["ἦν",704093,13],["τοῦ",709436,35],["Σεχενια",711725,18],["υἱοῦ",713075,18],["Ηραε",706018,18],["καὶ",707031,7],["Ιωαναν",706888,18],["υἱὸς",713075,4],["αὐτοῦ",702165,102],["ἔλαβεν",708076,2],["τὴν",709436,8],["θυγατέρα",706320,9],["Μεσουλαμ",708770,18],["υἱοῦ",713075,18],["Βαραχια",702526,18],["εἰς",704105,0],["γυναῖκα",703209,9]],"For many in Juda were bound to him by oath, because he was son-in-law of Sechenias the son of Herae; and Jonan his son had taken the daughter of Mesulam the son of Barachia to wife."],["19",[["καὶ",707031,7],["τοὺς",709436,58],["λόγους",708236,57],["αὐτοῦ",702165,102],["ἦσαν",704093,137],["λέγοντες",708124,146],["πρός",710844,0],["με",708618,163],["καὶ",707031,7],["λόγους",708236,57],["μου",709032,133],["ἦσαν",704093,137],["ἐκφέροντες",704356,146],["αὐτῷ",702165,50],["καὶ",707031,7],["ἐπιστολὰς",705272,39],["ἀπέστειλεν",701592,2],["Τωβιας",713040,4],["φοβερίσαι",713527,106],["με",708618,163]],"And they reported his words to me, and carried out my words to him: and Tobias sent letters to terrify me."]]