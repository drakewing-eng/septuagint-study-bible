966,4]],"And of the sons of Helam; Matthania, and Zacharia, and Jaïel, and Abdia, and Jarimoth, and Elia."],["27",[["καὶ",707031,7],["ἀπὸ",701425,0],["υἱῶν",713075,81],["Ζαθουα",705818,18],["Ελιωηναι",704500,4],["Ελισουβ",704488,4],["Μαθανια",708376,4],["καὶ",707031,7],["Ιαρμωθ",706440,4],["καὶ",707031,7],["Ζαβαδ",705796,4],["καὶ",707031,7],["Οζιζα",709476,4]],"And of the sons of Zathua; Elionai, Elisub, Matthanai, and Armoth, and Zabad, and Oziza."],["28",[["καὶ",707031,7],["ἀπὸ",701425,0],["υἱῶν",713075,81],["Βαβι",702351,18],["Ιωαναν",706888,4],["Ανανια",701016,4],["καὶ",707031,7],["Ζαβου",705810,4],["Οθαλι",709485,4]],"And of the sons of Babei; Joanan, Anania, and Zabu, and Thali."],["29",[["καὶ",707031,7],["ἀπὸ",701425,0],["υἱῶν",713075,81],["Βανουι",702512,18],["Μεσουλαμ",708770,4],["Μαλουχ",708451,4],["Αδαιας",700221,4],["Ιασουβ",706447,4],["καὶ",707031,7],["Σαλουια",711421,4],["καὶ",707031,7],["Ρημωθ",711247,4]],"And of the sons of Banui; Mosollam, Maluch, Adaias, Jasub, and Saluia, and Remoth."],["30",[["καὶ",707031,7],["ἀπὸ",701425,0],["υἱῶν",713075,81],["Φααθμωαβ",713293,18],["Εδενε",704029,4],["Χαληλ",713683,4],["Βαναια",702501,4],["Μασηα",708550,4],["Μαθανια",708376,4],["Βεσεληλ",702665,4],["καὶ",707031,7],["Βανουι",702512,4],["καὶ",707031,7],["Μανασση",708470,4]],"And of the sons of Phaath Moab; Edne, and Chalel, and Banaia, Maasia, Matthania, Beseleel, and Banui, and Manasse."],["31",[["καὶ",707031,7],["ἀπὸ",701425,0],["υἱῶν",713075,81],["Ηραμ",706020,18],["Ελιεζερ",704468,4],["Ιεσσια",706670,4],["Μελχια",708711,4],["Σαμαια",711440,4],["Σεμεων",711673,4]],"And of the sons of Eram; Eliezer, Jesia, Melchia, Samaias, Semeon,"],["32",[["Βενιαμιν",702650,4],["Μαλουχ",708451,4],["Σαμαρια",711453,4]],"Benjamin, Baluch, Samaria."],["33",[["καὶ",707031,7],["ἀπὸ",701425,0],["υἱῶν",713075,81],["Ησαμ",706027,18],["Μαθανι",708375,4],["Μαθαθα",708371,4],["Ζαβεδ",705808,4],["Ελιφαλεθ",704495,4],["Ιεραμι",706601,4],["Μανασση",708470,4],["Σεμεϊ",711666,4]],"And of the sons of Asem; Metthania, Matthatha, Zadab, Eliphalet, Jerami, Manasse, Semei."],["34",[["ἀπὸ",701425,0],["υἱῶν",713075,81],["Βανι",702508,18],["Μοοδι",709008,4],["Αμραμ",700874,4],["Ουηλ",709823,4]],"And of the sons of Bani; Moodia, Amram, Uel,"],["35",[["Βαναια",702501,4],["Βαδαια",702362,4],["Χελια",713808,4]],"Banaia, Badaia, Chelkia,"],["36",[["Ουιεχωα",709825,4],["Ιεραμωθ",706602,4],["Ελιασιβ",704458,4]],"Uvania, Marimoth, Eliasiph,"],["37",[["Μαθανια",708376,4],["Μαθαναι",708374,4],["καὶ",707031,7],["ἐποίησαν",710582,150]],"Matthania, Matthanai:"],["38",[["οἱ",709436,136],["υἱοὶ",713075,52],["Βανουι",702512,18],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["Σεμεϊ",711666,4]],"and [so] did the children of Banui, and the children of Semei,"],["39",[["καὶ",707031,7],["Σελεμια",711641,4],["καὶ",707031,7],["Ναθαν",709164,4],["καὶ",707031,7],["Αδαια",700220,4]],"and Selemia, and Nathan, and Adaia,"],["40",[["Μαχναδαβου",708609,4],["Σεσι",711711,4],["Σαρου",711538,4]],"Machadnabu, Sesei, Sariu,"],["41",[["Εζερηλ",704049,4],["καὶ",707031,7],["Σελεμια",711641,4],["καὶ",707031,7],["Σαμαρια",711453,4]],"Ezriel, and Selemia, and Samaria,"],["42",[["καὶ",707031,7],["Σαλουμ",711422,4],["Αμαρια",700770,4],["Ιωσηφ",706948,4]],"and Sellum, Amaria, Joseph."],["43",[["ἀπὸ",701425,0],["υἱῶν",713075,81],["Ναβου",709143,18],["Ιιηλ",706707,4],["Μαθαθια",708372,4],["Σεδεμ",711620,4],["Ζαμβινα",705829,4],["Ιαδαι",706373,4],["καὶ",707031,7],["Ιωηλ",706916,4],["καὶ",707031,7],["Βαναια",702501,4]],"Of the sons of Nabu; Jael, Matthanias, Zabad, Zebennas, Jadai, and Joel, and Banaia."],["44",[["πάντες",710177,138],["οὗτοι",709858,201],["ἐλάβοσαν",708076,150],["γυναῖκας",703209,39],["ἀλλοτρίας",700699,119],["καὶ",707031,7],["ἐγέννησαν",703051,150],["ἐξ",704132,0],["αὐτῶν",702165,284],["υἱούς",713075,57]],"All these had taken strange wives, and had begotten sons of them."]]