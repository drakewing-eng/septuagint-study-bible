[["1",[["ἀγαθὸν",700106,26],["ὄνομα",709666,15],["ὑπὲρ",713111,0],["ἔλαιον",704380,25],["ἀγαθὸν",700106,26],["καὶ",707031,7],["ἡμέρα",705984,12],["τοῦ",709436,35],["θανάτου",706096,18],["ὑπὲρ",713111,0],["ἡμέραν",705984,9],["γενέσεως",703043,17],["αὐτοῦ",702165,102]],"A good name is better than good oil; and the day of death than the day of birth."],["2",[["ἀγαθὸν",700106,26],["πορευθῆναι",710667,179],["εἰς",704105,0],["οἶκον",709516,6],["πένθους",710253,21],["ἢ",705924,7],["ὅτι",709803,7],["πορευθῆναι",710667,179],["εἰς",704105,0],["οἶκον",709516,6],["πότου",710704,18],["καθότι",707021,7],["τοῦτο",709858,132],["τέλος",712787,15],["παντὸς",710177,116],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["καὶ",707031,7],["ὁ",709436,3],["ζῶν",705851,72],["δώσει",703654,127],["εἰς",704105,0],["καρδίαν",707141,9],["αὐτοῦ",702165,102]],"[It is] better to go to the house of mourning, than to go to the banquet house: since this is the end of every man; and the living man will apply good [warning] to his heart."],["3",[["ἀγαθὸν",700106,26],["θυμὸς",706334,4],["ὑπὲρ",713111,0],["γέλωτα",703032,6],["ὅτι",709803,7],["ἐν",704639,0],["κακίᾳ",707054,1],["προσώπου",710986,21],["ἀγαθυνθήσεται",700109,134],["καρδία",707141,12]],"Sorrow is better than laughter: for by the sadness of the countenance the heart will be made better."],["4",[["καρδία",707141,12],["σοφῶν",711985,169],["ἐν",704639,0],["οἴκῳ",709516,114],["πένθους",710253,21],["καὶ",707031,7],["καρδία",707141,12],["ἀφρόνων",702236,169],["ἐν",704639,0],["οἴκῳ",709516,114],["εὐφροσύνης",705717,17]],"The heart of the wise is in the house of mourning; but the heart of fools is in the house of mirth."],["5",[["ἀγαθὸν",700106,26],["τὸ",709436,34],["ἀκοῦσαι",700587,106],["ἐπιτίμησιν",705306,9],["σοφοῦ",711985,116],["ὑπὲρ",713111,0],["ἄνδρα",701150,6],["ἀκούοντα",700587,183],["ᾆσμα",701970,25],["ἀφρόνων",702236,169]],"[It is] better to hear a reproof of a wise man, than for a man to hear the song of fools."],["6",[["ὅτι",709803,7],["ὡς",714148,7],["φωνὴ",713640,12],["τῶν",709436,130],["ἀκανθῶν",700517,65],["ὑπὸ",713184,0],["τὸν",709436,5],["λέβητα",708121,6],["οὕτως",709859,28],["γέλως",703032,4],["τῶν",709436,80],["ἀφρόνων",702236,169],["καί",707031,7],["γε",702985,11],["τοῦτο",709858,132],["ματαιότης",708576,12]],"As the sound of thorns under a caldron, so is the laughter of fools: this is also vanity."],["7",[["ὅτι",709803,7],["ἡ",709436,10],["συκοφαντία",712258,12],["περιφέρει",710410,91],["σοφὸν",711985,27],["καὶ",707031,7],["ἀπόλλυσι",701513,91],["τὴν",709436,8],["καρδίαν",707141,9],["εὐτονίας",705709,17],["αὐτοῦ",702165,102]],"For oppression makes a wise man mad, and destroys his noble heart."],["8",[["ἀγαθὴ",700106,29],["ἐσχάτη",705519,29],["λόγων",708236,81],["ὑπὲρ",713111,0],["ἀρχὴν",701836,9],["αὐτοῦ",702165,102],["ἀγαθὸν",700106,26],["μακρόθυμος",708420,14],["ὑπὲρ",713111,0],["ὑψηλὸν",713285,27],["πνεύματι",710566,54]],"The end of a matter is better than the beginning thereof: the patient is better than the high-minded."],["9",[["μὴ",708851,28],["σπεύσῃς",712011,175],["ἐν",704639,0],["πνεύματί",710566,54],["σου",711945,133],["τοῦ",709436,20],["θυμοῦσθαι",706335,110],["ὅτι",709803,7],["θυμὸς",706334,4],["ἐν",704639,0],["κόλπῳ",707800,114],["ἀφρόνων",702236,169],["ἀναπαύσεται",701027,93]],"Be not hasty in thy spirit to be angry: for anger will rest in the bosom of fools."],["10",[["μὴ",708851,28],["εἴπῃς",705373,175],["τί",712867,126],["ἐγένετο",703104,23],["ὅτι",709803,7],["αἱ",709436,190],["ἡμέραι",705984,191],["αἱ",709436,190],["πρότεραι",710992,192],["ἦσαν",704093,137],["ἀγαθαὶ",700106,192],["ὑπὲρ",713111,0],["ταύτας",709858,231],["ὅτι",709803,7],["οὐκ",709805,28],["ἐν",704639,0],["σοφίᾳ",711981,1],["ἐπηρώτησας",705069,162],["περὶ",710285,0],["τούτου",709858,102]],"Say not, What has happened, that the former days were better than these? for thou dost not enquire in wisdom concerning this."],["11",[["ἀγαθὴ",700106,29],["σοφία",711981,12],["μετὰ",708780,0],["κληροδοσίας",707722,17],["καὶ",707031,7],["περισσεία",710384,12],["τοῖς",709436,147],["θεωροῦσιν",706226,349],["τὸν",709436,5],["ἥλιον",705974,6]],"Wisdom is good with an inheritance: and [there is] an advantage [by it] to them that see the sun."],["12",[["ὅτι",709803,7],["ἐν",704639,0],["σκιᾷ",711852,1],["αὐτῆς",702165,86],["ἡ",709436,10],["σοφία",711981,12],["ὡς",714148,7],["σκιὰ",711852,12],["τοῦ",709436,20],["ἀργυρίου",701707,21],["καὶ",707031,7],["περισσεία",710384,12],["γνώσεως",703138,17],["τῆς",709436,16],["σοφίας",711981,17],["ζωοποιήσει",705917,127],["τὸν",709436,5],["παρ᾿",709995,0],["αὐτῆς",702165,86]],"For wisdom in its shadow is as the shadow of silver: and the excellence of the knowledge of wisdom will give life to him that has it."],["13",[["ἰδὲ",709725,176],["τὰ",709436,41],["ποιήματα",710583,42],["τοῦ",709436,35],["θεοῦ",706192,18],["ὅτι",709803,7],["τίς",712867,158],["δυνήσεται",703838,93],["τοῦ",709436,20],["κοσμῆσαι",707847,106],["ὃν",709781,112],["ἂν",700900,11],["ὁ",709436,3],["θεὸς",706192,4],["διαστρέψῃ",703592,123],["αὐτόν",702165,85]],"Behold the works of God: for who shall be able to straighten him whom God has made crooked?"],["14",[["ἐν",704639,0],["ἡμέρᾳ",705984,1],["ἀγαθωσύνης",700111,17],["ζῆθι",705851,240],["ἐν",704639,0],["ἀγαθῷ",700106,30],["καὶ",707031,7],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["κακίας",707054,17],["ἰδέ",709725,176],["καί",707031,7],["γε",702985,11],["σὺν",712372,0],["τοῦτο",709858,129],["σύμφωνον",712368,46],["τούτῳ",709858,50],["ἐποίησεν",710582,2],["ὁ",709436,3],["θεὸς",706192,4],["περὶ",710285,0],["λαλιᾶς",708074,17],["ἵνα",706747,7],["μὴ",708851,28],["εὕρῃ",705676,172],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ὀπίσω",709697,28],["αὐτοῦ",702165,102],["μηδέν",708857,46]],"In the day of prosperity live joyfully, and consider in the day of adversity: consider, [I say], God also has caused the one to agree with the other for [this] reason, that man should find nothing after him."],["15",[["σὺν",712372,0],["τὰ",709436,41],["πάντα",710177,68],["εἶδον",709725,155],["ἐν",704639,0],["ἡμέραις",705984,76],["ματαιότητός",708576,17],["μου",709032,133],["ἔστιν",704093,91],["δίκαιος",703694,14],["ἀπολλύμενος",701513,122],["ἐν",704639,0],["δικαίῳ",703694,30],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔστιν",704093,91],["ἀσεβὴς",701909,14],["μένων",708736,72],["ἐν",704639,0],["κακίᾳ",707054,1],["αὐτοῦ",702165,102]],"I have seen all things in the days of my vanity: there is a just man perishing in his justice, and there is an ungodly man remaining in his wickedness."],["16",[["μὴ",708851,28],["γίνου",703104,253],["δίκαιος",703694,14],["πολὺ",710646,46],["καὶ",707031,7],["μὴ",708851,28],["σοφίζου",711982,253],["περισσά",710387,68],["μήποτε",708882,28],["ἐκπλαγῇς",704287,279]],"Be not very just; neither be very wise: lest thou be confounded."],["17",[["μὴ",708851,28],["ἀσεβήσῃς",701906,175],["πολὺ",710646,46],["καὶ",707031,7],["μὴ",708851,28],["γίνου",703104,253],["σκληρός",711861,14],["ἵνα",706747,7],["μὴ",708851,28],["ἀποθάνῃς",701461,175],["ἐν",704639,0],["οὐ",709805,28],["καιρῷ",707047,114],["σου",711945,133]],"Be not very wicked; and be not stubborn: lest thou shouldest die before thy time."],["18",[["ἀγαθὸν",700106,26],["τὸ",709436,34],["ἀντέχεσθαί",701225,110],["σε",711598,163],["ἐν",704639,0],["τούτῳ",709858,50],["καί",707031,7],["γε",702985,11],["ἀπὸ",701425,0],["τούτου",709858,102],["μὴ",708851,28],["ἀνῇς",701169,175],["τὴν",709436,8],["χεῖρά",713787,9],["σου",711945,133],["ὅτι",709803,7],["φοβούμενος",713532,122],["τὸν",709436,5],["θεὸν",706192,6],["ἐξελεύσεται",704909,93],["τὰ",709436,41],["πάντα",710177,68]],"It is well for thee to hold fast by this; also by this defile not thine hand: for to them that fear God all things shall come forth [well]."],["19",[["ἡ",709436,10],["σοφία",711981,12],["βοηθήσει",702743,364],["τῷ",709436,113],["σοφῷ",711985,30],["ὑπὲρ",713111,0],["δέκα",703333,59],["ἐξουσιάζοντας",704975,235],["τοὺς",709436,58],["ὄντας",704093,235],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1]],"Wisdom will help the wise man more than ten mighty men which are in the city."],["20",[["ὅτι",709803,7],["ἄνθρωπος",701163,4],["οὐκ",709805,28],["ἔστιν",704093,91],["δίκαιος",703694,14],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["ὃς",709781,213],["ποιήσει",710582,127],["ἀγαθὸν",700106,46],["καὶ",707031,7],["οὐχ",709805,28],["ἁμαρτήσεται",700773,93]],"For there is not a righteous man in the earth, who will do good, and not sin."],["21",[["καί",707031,7],["γε",702985,11],["εἰς",704105,0],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["οὓς",709781,298],["λαλήσουσιν",708071,218],["μὴ",708851,28],["θῇς",712849,175],["καρδίαν",707141,9],["σου",711945,133],["ὅπως",709719,7],["μὴ",708851,28],["ἀκούσῃς",700587,175],["τοῦ",709436,35],["δούλου",703817,18],["σου",711945,133],["καταρωμένου",707396,262],["σε",711598,163]],"Also take no heed to all the words which ungodly men shall speak; lest thou hear thy servant cursing thee."],["22",[["ὅτι",709803,7],["πλειστάκις",710512,28],["πονηρεύσεταί",710658,93],["σε",711598,163],["καὶ",707031,7],["καθόδους",707014,39],["πολλὰς",710646,119],["κακώσει",707073,127],["καρδίαν",707141,9],["σου",711945,133],["ὅπως",709719,7],["καί",707031,7],["γε",702985,11],["σὺ",712181,164],["κατηράσω",707396,174],["ἑτέρους",705535,60]],"For many times he shall trespass against thee, and repeatedly shall he afflict thine heart; for thus also hast thou cursed others."],["23",[["πάντα",710177,68],["ταῦτα",709858,71],["ἐπείρασα",710225,155],["ἐν",704639,0],["τῇ",709436,100],["σοφίᾳ",711981,1],["εἶπα",705373,155],["σοφισθήσομαι",711982,180]],"All these things have I proved in wisdom: I said, I will be wise; but it was far from me."],["24",[["καὶ",707031,7],["αὐτὴ",702165,107],["ἐμακρύνθη",708428,2],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["μακρὰν",708421,36],["ὑπὲρ",713111,0],["ὃ",709781,213],["ἦν",704093,13],["καὶ",707031,7],["βαθὺ",702381,26],["βάθος",702376,15],["τίς",712867,158],["εὑρήσει",705676,127],["αὐτό",702165,129]],"[That which is] far beyond what was, and a great depth, who shall find it out?"],["25",[["ἐκύκλωσα",707958,155],["ἐγώ",704018,164],["καὶ",707031,7],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["τοῦ",709436,20],["γνῶναι",703105,106],["καὶ",707031,7],["τοῦ",709436,20],["κατασκέψασθαι",707418,109],["καὶ",707031,7],["ζητῆσαι",705879,106],["σοφίαν",711981,9],["καὶ",707031,7],["ψῆφον",714052,9],["καὶ",707031,7],["τοῦ",709436,20],["γνῶναι",703105,106],["ἀσεβοῦς",701909,116],["ἀφροσύνην",702235,9],["καὶ",707031,7],["σκληρίαν",711858,9],["καὶ",707031,7],["περιφοράν",710411,9]],"I and my heart went round about to know, and to examine, and to seek wisdom, and the account [of things], and to know the folly and trouble and madness of the ungodly man."],["26",[["καὶ",707031,7],["εὑρίσκω",705676,157],["ἐγὼ",704018,164],["πικρότερον",710475,61],["ὑπὲρ",713111,0],["θάνατον",706096,6],["σὺν",712372,0],["τὴν",709436,8],["γυναῖκα",703209,9],["ἥτις",709793,412],["ἐστὶν",704093,91],["θηρεύματα",706245,64],["καὶ",707031,7],["σαγῆναι",711365,191],["καρδία",707141,12],["αὐτῆς",702165,86],["δεσμοὶ",703372,52],["χεῖρες",713787,191],["αὐτῆς",702165,86],["ἀγαθὸς",700106,14],["πρὸ",710747,0],["προσώπου",710986,21],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐξαιρεθήσεται",704838,134],["ἀπ᾿",701425,0],["αὐτῆς",702165,86],["καὶ",707031,7],["ἁμαρτάνων",700773,72],["συλλημφθήσεται",712262,134],["ἐν",704639,0],["αὐτῇ",702165,105]],"And I find her [to be], and I will pronounce [to be] more bitter than death the woman which is a snare, and her heart nets, [who has] a band in her hands: [he that is] good in the sight of God shall be delivered from her; but the sinner shall be caught by her."],["27",[["ἰδὲ",709725,176],["τοῦτο",709858,129],["εὗρον",705676,155],["εἶπεν",705373,2],["ὁ",709436,3],["Ἐκκλησιαστής",704218,4],["μία",704106,29],["τῇ",709436,100],["μιᾷ",704106,101],["τοῦ",709436,20],["εὑρεῖν",705676,106],["λογισμόν",708234,6]],"Behold, this have I found, said the Preacher, [seeking] by one at a time to find out the account,"],["28",[["ὃν",709781,112],["ἔτι",705538,28],["ἐζήτησεν",705879,2],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["καὶ",707031,7],["οὐχ",709805,28],["εὗρον",705676,155],["ἄνθρωπον",701163,6],["ἕνα",704106,27],["ἀπὸ",701425,0],["χιλίων",713859,169],["εὗρον",705676,155],["καὶ",707031,7],["γυναῖκα",703209,9],["ἐν",704639,0],["πᾶσι",710177,230],["τούτοις",709858,151],["οὐχ",709805,28],["εὗρον",705676,155]],"which my soul sought after, but I found not: for I have found one man of a thousand; but a woman in all these I have not found."],["29",[["πλὴν",710540,28],["ἰδὲ",709725,176],["τοῦτο",709858,129],["εὗρον",705676,155],["ὃ",709781,213],["ἐποίησεν",710582,2],["ὁ",709436,3],["θεὸς",706192,4],["σὺν",712372,0],["τὸν",709436,5],["ἄνθρωπον",701163,6],["εὐθῆ",705596,27],["καὶ",707031,7],["αὐτοὶ",702165,201],["ἐζήτησαν",705879,150],["λογισμοὺς",708234,57],["πολλούς",710646,60]],"But, behold, this have I found, that God made man upright; but they have sought out many devices. Who knows the wise? and who knows the interpretation of a saying?"]]