[["1",[["τίς",712867,158],["οἶδεν",709492,171],["σοφούς",711985,60],["καὶ",707031,7],["τίς",712867,158],["οἶδεν",709492,171],["λύσιν",708277,9],["ῥήματος",711246,21],["σοφία",711981,12],["ἀνθρώπου",701163,18],["φωτιεῖ",713646,127],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀναιδὴς",700959,14],["προσώπῳ",710986,54],["αὐτοῦ",702165,102],["μισηθήσεται",708935,134]],"A man's wisdom will lighten his countenance; but a man of shameless countenance will be hated."],["2",[["στόμα",712125,25],["βασιλέως",702580,18],["φύλαξον",713619,176],["καὶ",707031,7],["περὶ",710285,0],["λόγου",708236,18],["ὅρκου",709753,18],["θεοῦ",706192,18],["μὴ",708851,28],["σπουδάσῃς",712031,175]],"Observe the commandment of the king, and [that] because of the word of the oath of God."],["3",[["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["πορεύσῃ",710667,420],["μὴ",708851,28],["στῇς",706846,175],["ἐν",704639,0],["λόγῳ",708236,114],["πονηρῷ",710660,30],["ὅτι",709803,7],["πᾶν",710177,46],["ὃ",709781,128],["ἐὰν",703912,7],["θελήσῃ",706176,172],["ποιήσει",710582,127]],"Be not hasty; thou shalt go forth out of his presence: stand not in an evil matter; for he will do whatsoever he shall please,"],["4",[["καθὼς",707030,28],["λαλεῖ",708071,91],["βασιλεὺς",702580,4],["ἐξουσιάζων",704975,72],["καὶ",707031,7],["τίς",712867,158],["ἐρεῖ",705415,127],["αὐτῷ",702165,50],["τί",712867,126],["ποιήσεις",710582,166]],"even as a king having power: and who will say to him, What doest thou?"],["5",[["ὁ",709436,3],["φυλάσσων",713619,72],["ἐντολὴν",704802,9],["οὐ",709805,28],["γνώσεται",703105,93],["ῥῆμα",711246,25],["πονηρόν",710660,46],["καὶ",707031,7],["καιρὸν",707047,6],["κρίσεως",707908,17],["γινώσκει",703105,91],["καρδία",707141,12],["σοφοῦ",711985,116]],"He that keeps the commandment shall not know an evil thing: and the heart of the wise knows the time of judgment."],["6",[["ὅτι",709803,7],["παντὶ",710177,97],["πράγματι",710708,54],["ἔστιν",704093,91],["καιρὸς",707047,4],["καὶ",707031,7],["κρίσις",707908,12],["ὅτι",709803,7],["γνῶσις",703138,12],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["πολλὴ",710646,29],["ἐπ᾿",705080,0],["αὐτόν",702165,85]],"For to every thing there is time and judgment; for the knowledge of a man is great to him."],["7",[["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["γινώσκων",703105,72],["τί",712867,126],["τὸ",709436,24],["ἐσόμενον",704093,673],["ὅτι",709803,7],["καθὼς",707030,28],["ἔσται",704093,93],["τίς",712867,158],["ἀναγγελεῖ",700921,127],["αὐτῷ",702165,50]],"For there is no one that knows what is going to be: for who shall tell him how it shall be?"],["8",[["οὐκ",709805,28],["ἔστιν",704093,91],["ἄνθρωπος",701163,4],["ἐξουσιάζων",704975,72],["ἐν",704639,0],["πνεύματι",710566,54],["τοῦ",709436,20],["κωλῦσαι",708020,106],["σὺν",712372,0],["τὸ",709436,24],["πνεῦμα",710566,25],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐξουσία",704974,12],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["τοῦ",709436,35],["θανάτου",706096,18],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀποστολὴ",701596,12],["ἐν",704639,0],["τῷ",709436,113],["πολέμῳ",710605,114],["καὶ",707031,7],["οὐ",709805,28],["διασώσει",703599,127],["ἀσέβεια",701904,12],["τὸν",709436,5],["παρ᾿",709995,0],["αὐτῆς",702165,86]],"There is no man that has power over the spirit to retain the spirit; and there is no power in the day of death: and there is no discharge in the day of battle; neither shall ungodliness save her votary."],["9",[["καὶ",707031,7],["σὺν",712372,0],["πᾶν",710177,46],["τοῦτο",709858,129],["εἶδον",709725,155],["καὶ",707031,7],["ἔδωκα",703654,155],["τὴν",709436,8],["καρδίαν",707141,9],["μου",709032,133],["εἰς",704105,0],["πᾶν",710177,46],["ποίημα",710583,25],["ὃ",709781,33],["πεποίηται",710582,403],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6],["τὰ",709436,41],["ὅσα",709788,68],["ἐξουσιάσατο",704975,23],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ἐν",704639,0],["ἀνθρώπῳ",701163,114],["τοῦ",709436,20],["κακῶσαι",707073,106],["αὐτόν",702165,85]],"So I saw all this, and I applied my heart to every work that has been done under the sun; all the things wherein man has power over man to afflict him."],["10",[["καὶ",707031,7],["τότε",712908,28],["εἶδον",709725,155],["ἀσεβεῖς",701909,60],["εἰς",704105,0],["τάφους",712738,57],["εἰσαχθέντας",704107,460],["καὶ",707031,7],["ἐκ",704132,0],["τόπου",712903,18],["ἁγίου",700159,116],["ἐπορεύθησαν",710667,99],["καὶ",707031,7],["ἐπῃνέθησαν",705000,99],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["ὅτι",709803,7],["οὕτως",709859,28],["ἐποίησαν",710582,150],["καί",707031,7],["γε",702985,11],["τοῦτο",709858,132],["ματαιότης",708576,12]],"And then I saw the ungodly carried into the tombs, and [that] out of the holy place: and they departed, and were praised in the city, because they had done thus: this also is vanity."],["11",[["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["γινομένη",703104,211],["ἀντίρρησις",701272,12],["ἀπὸ",701425,0],["τῶν",709436,80],["ποιούντων",710582,170],["τὸ",709436,24],["πονηρὸν",710660,46],["ταχύ",712748,46],["διὰ",703417,0],["τοῦτο",709858,129],["ἐπληροφορήθη",710542,37],["καρδία",707141,12],["υἱῶν",713075,81],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["ἐν",704639,0],["αὐτοῖς",702165,151],["τοῦ",709436,20],["ποιῆσαι",710582,106],["τὸ",709436,24],["πονηρόν",710660,46]],"Because there is no contradiction made on the part of those who do evil quickly, therefore the heart of the children of men is fully determined in them to do evil."],["12",[["ὃς",709781,213],["ἥμαρτεν",700773,2],["ἐποίησεν",710582,2],["τὸ",709436,24],["πονηρὸν",710660,46],["ἀπὸ",701425,0],["τότε",712908,28],["καὶ",707031,7],["ἀπὸ",701425,0],["μακρότητος",708423,17],["αὐτῷ",702165,50],["ὅτι",709803,7],["καί",707031,7],["γε",702985,11],["γινώσκω",703105,157],["ἐγὼ",704018,164],["ὅτι",709803,7],["ἔσται",704093,93],["ἀγαθὸν",700106,26],["τοῖς",709436,147],["φοβουμένοις",713532,341],["τὸν",709436,5],["θεόν",706192,6],["ὅπως",709719,7],["φοβῶνται",713532,380],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102]],"He that has sinned has done evil from that time, and long from beforehand: nevertheless I know, that it is well with them that fear God, that they may fear before him:"],["13",[["καὶ",707031,7],["ἀγαθὸν",700106,26],["οὐκ",709805,28],["ἔσται",704093,93],["τῷ",709436,113],["ἀσεβεῖ",701909,30],["καὶ",707031,7],["οὐ",709805,28],["μακρυνεῖ",708428,127],["ἡμέρας",705984,39],["ἐν",704639,0],["σκιᾷ",711852,1],["ὃς",709781,213],["οὐκ",709805,28],["ἔστιν",704093,91],["φοβούμενος",713532,122],["ἀπὸ",701425,0],["προσώπου",710986,21],["τοῦ",709436,35],["θεοῦ",706192,18]],"but it shall not be well with the ungodly, and he shall not prolong his days, [which are] as a shadow; forasmuch as he fears not before God."],["14",[["ἔστιν",704093,91],["ματαιότης",708576,12],["ἣ",709781,177],["πεποίηται",710582,187],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ὅτι",709803,7],["εἰσὶ",704093,197],["δίκαιοι",703694,138],["ὅτι",709803,7],["φθάνει",713439,91],["πρὸς",710844,0],["αὐτοὺς",702165,62],["ὡς",714148,7],["ποίημα",710583,15],["τῶν",709436,80],["ἀσεβῶν",701909,169],["καὶ",707031,7],["εἰσὶν",704093,197],["ἀσεβεῖς",701909,138],["ὅτι",709803,7],["φθάνει",713439,91],["πρὸς",710844,0],["αὐτοὺς",702165,62],["ὡς",714148,7],["ποίημα",710583,15],["τῶν",709436,80],["δικαίων",703694,169],["εἶπα",705373,155],["ὅτι",709803,7],["καί",707031,7],["γε",702985,11],["τοῦτο",709858,132],["ματαιότης",708576,12]],"There is a vanity which is done upon the earth; that there are righteous persons to whom it happens according to the doing of the ungodly; and there are ungodly men, to whom it happens according to the doing of the just: I said, This is also vanity."],["15",[["καὶ",707031,7],["ἐπῄνεσα",705000,155],["ἐγὼ",704018,164],["σὺν",712372,0],["τὴν",709436,8],["εὐφροσύνην",705717,9],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀγαθὸν",700106,26],["τῷ",709436,113],["ἀνθρώπῳ",701163,114],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6],["ὅτι",709803,7],["εἰ",704071,7],["μὴ",708851,28],["τοῦ",709436,20],["φαγεῖν",713296,106],["καὶ",707031,7],["τοῦ",709436,20],["πιεῖν",710478,106],["καὶ",707031,7],["τοῦ",709436,20],["εὐφρανθῆναι",705715,179],["καὶ",707031,7],["αὐτὸ",702165,129],["συμπροσέσται",712349,93],["αὐτῷ",702165,50],["ἐν",704639,0],["μόχθῳ",709039,114],["αὐτοῦ",702165,102],["ἡμέρας",705984,39],["ζωῆς",705910,17],["αὐτοῦ",702165,102],["ὅσας",709788,119],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["ὁ",709436,3],["θεὸς",706192,4],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6]],"Then I praised mirth, because there is no good for a man under the sun, but to eat, and drink, and be merry: and this shall attend him in his labour all the days of his life, which God has given him under the sun."],["16",[["ἐν",704639,0],["οἷς",709781,311],["ἔδωκα",703654,155],["τὴν",709436,8],["καρδίαν",707141,9],["μου",709032,133],["τοῦ",709436,20],["γνῶναι",703105,106],["σοφίαν",711981,9],["καὶ",707031,7],["τοῦ",709436,20],["ἰδεῖν",709725,106],["τὸν",709436,5],["περισπασμὸν",710381,6],["τὸν",709436,5],["πεποιημένον",710582,439],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ὅτι",709803,7],["καί",707031,28],["γε",702985,11],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["καὶ",707031,7],["ἐν",704639,0],["νυκτὶ",709386,1],["ὕπνον",713181,6],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἔστιν",704093,91],["βλέπων",702740,72]],"Whereupon I set my heart to know wisdom, and to perceive the trouble that was wrought upon the earth: for there is that neither by day nor night sees sleep with his eyes."],["17",[["καὶ",707031,7],["εἶδον",709725,155],["σὺν",712372,0],["πάντα",710177,68],["τὰ",709436,41],["ποιήματα",710583,42],["τοῦ",709436,35],["θεοῦ",706192,18],["ὅτι",709803,7],["οὐ",709805,28],["δυνήσεται",703838,93],["ἄνθρωπος",701163,4],["τοῦ",709436,20],["εὑρεῖν",705676,106],["σὺν",712372,0],["τὸ",709436,24],["ποίημα",710583,25],["τὸ",709436,24],["πεποιημένον",710582,414],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6],["ὅσα",709788,68],["ἂν",700900,11],["μοχθήσῃ",709037,172],["ὁ",709436,3],["ἄνθρωπος",701163,4],["τοῦ",709436,20],["ζητῆσαι",705879,106],["καὶ",707031,7],["οὐχ",709805,28],["εὑρήσει",705676,127],["καί",707031,7],["γε",702985,11],["ὅσα",709788,68],["ἂν",700900,11],["εἴπῃ",705373,172],["ὁ",709436,3],["σοφὸς",711985,14],["τοῦ",709436,20],["γνῶναι",703105,106],["οὐ",709805,28],["δυνήσεται",703838,93],["τοῦ",709436,20],["εὑρεῖν",705676,106]],"And I beheld all the works of God, that a man shall not be able to discover the work which is wrought under the sun; whatsoever things a man shall endeavour to seek, however a man may labour to seek it, yet he shall not find it; yea, how much soever a wise man may speak of knowing it, he shall not be able to find it: for I applied all this to my heart, and my heart has seen all this."]]