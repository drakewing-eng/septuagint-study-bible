[["1",[["ἔστιν",704093,91],["πονηρία",710659,12],["ἣν",709781,131],["εἶδον",709725,155],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6],["καὶ",707031,7],["πολλή",710646,29],["ἐστιν",704093,91],["ἐπὶ",705080,0],["τὸν",709436,5],["ἄνθρωπον",701163,6]],"There is an evil which I have seen under the sun, and it is abundant with man:"],["2",[["ἀνήρ",701150,4],["ᾧ",709781,309],["δώσει",703654,127],["αὐτῷ",702165,50],["ὁ",709436,3],["θεὸς",706192,4],["πλοῦτον",710563,6],["καὶ",707031,7],["ὑπάρχοντα",713102,183],["καὶ",707031,7],["δόξαν",703791,9],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ὑστερῶν",713270,72],["τῇ",709436,100],["ψυχῇ",714070,1],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["πάντων",710177,169],["ὧν",709781,252],["ἐπιθυμήσει",705141,127],["καὶ",707031,7],["οὐκ",709805,28],["ἐξουσιάσει",704975,127],["αὐτῷ",702165,50],["ὁ",709436,3],["θεὸς",706192,4],["τοῦ",709436,20],["φαγεῖν",713296,106],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ἀνὴρ",701150,4],["ξένος",709415,14],["φάγεται",713296,93],["αὐτόν",702165,85],["τοῦτο",709858,132],["ματαιότης",708576,12],["καὶ",707031,7],["ἀρρωστία",701813,12],["πονηρά",710660,29],["ἐστιν",704093,91]],"a man to whom God shall give wealth, and substance, and honour, and he wants nothing for his soul of all things that he shall desire, yet God shall not give him power to eat of it, for a stranger shall devour it: this is vanity, and an evil infirmity."],["3",[["ἐὰν",703912,7],["γεννήσῃ",703051,123],["ἀνὴρ",701150,4],["ἑκατὸν",704136,59],["καὶ",707031,7],["ἔτη",705543,42],["πολλὰ",710646,68],["ζήσεται",705851,93],["καὶ",707031,7],["πλῆθος",710529,25],["ὅ",709781,128],["τι",712866,126],["ἔσονται",704093,135],["ἡμέραι",705984,191],["ἐτῶν",705543,44],["αὐτοῦ",702165,102],["καὶ",707031,7],["ψυχὴ",714070,12],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐμπλησθήσεται",704592,134],["ἀπὸ",701425,0],["τῆς",709436,16],["ἀγαθωσύνης",700111,17],["καί",707031,7],["γε",702985,11],["ταφὴ",712736,12],["οὐκ",709805,28],["ἐγένετο",703104,23],["αὐτῷ",702165,50],["εἶπα",705373,155],["ἀγαθὸν",700106,26],["ὑπὲρ",713111,0],["αὐτὸν",702165,85],["τὸ",709436,34],["ἔκτρωμα",704348,15]],"If a man beget a hundred [children], and live many years, yea, however abundant the days of his years shall be, yet [if] his soul shall not be satisfied with good, and also he have no burial; I said, An untimely birth is better than he."],["4",[["ὅτι",709803,7],["ἐν",704639,0],["ματαιότητι",708576,1],["ἦλθεν",705453,2],["καὶ",707031,7],["ἐν",704639,0],["σκότει",711889,54],["πορεύεται",710667,117],["καὶ",707031,7],["ἐν",704639,0],["σκότει",711889,54],["ὄνομα",709666,15],["αὐτοῦ",702165,102],["καλυφθήσεται",707102,134]],"For he came in vanity, and departs in darkness, and his name shall be covered in darkness."],["5",[["καί",707031,7],["γε",702985,11],["ἥλιον",705974,6],["οὐκ",709805,28],["εἶδεν",709725,2],["καὶ",707031,7],["οὐκ",709805,28],["ἔγνω",703105,2],["ἀνάπαυσις",701026,12],["τούτῳ",709858,50],["ὑπὲρ",713111,0],["τοῦτον",709858,85]],"Moreover he has not seen the sun, nor known rest: there is [no more rest] to this one than another."],["6",[["καὶ",707031,7],["εἰ",704071,7],["ἔζησεν",705851,2],["χιλίων",713859,83],["ἐτῶν",705543,44],["καθόδους",707014,39],["καὶ",707031,7],["ἀγαθωσύνην",700111,9],["οὐκ",709805,28],["εἶδεν",709725,2],["μὴ",708851,28],["οὐκ",709805,28],["εἰς",704105,0],["τόπον",712903,6],["ἕνα",704106,27],["τὰ",709436,41,5],["πάντα",710177,27],["πορεύεται",710667,117]],"Though he has lived to the return of a thousand years, yet he has seen no good: do not all go to one place?"],["7",[["πᾶς",710177,14],["μόχθος",709039,4],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["εἰς",704105,0],["στόμα",712125,25],["αὐτοῦ",702165,102],["καί",707031,7],["γε",702985,11],["ἡ",709436,10],["ψυχὴ",714070,12],["οὐ",709805,28],["πληρωθήσεται",710543,134]],"All the labour of a man is for his mouth, and yet the appetite shall not be satisfied."],["8",[["ὅτι",709803,7],["τίς",712867,359],["περισσεία",710384,12],["τῷ",709436,113],["σοφῷ",711985,30],["ὑπὲρ",713111,0],["τὸν",709436,5],["ἄφρονα",702236,27],["διότι",703734,7],["ὁ",709436,3],["πένης",710248,4],["οἶδεν",709492,171],["πορευθῆναι",710667,179],["κατέναντι",707507,28],["τῆς",709436,16],["ζωῆς",705910,17]],"For [what] advantage has the wise man over the fool, since [even] the poor knows how to walk in the direction of life?"],["9",[["ἀγαθὸν",700106,26],["ὅραμα",709720,15],["ὀφθαλμῶν",709870,81],["ὑπὲρ",713111,0],["πορευόμενον",710667,214],["ψυχῇ",714070,1],["καί",707031,7],["γε",702985,11],["τοῦτο",709858,132],["ματαιότης",708576,12],["καὶ",707031,7],["προαίρεσις",710751,12],["πνεύματος",710566,21]],"The sight of the eyes is better than that which wanders in soul: this is also vanity, and waywardness of spirit."],["10",[["εἴ",704071,7],["τι",712867,273],["ἐγένετο",703104,23],["ἤδη",705939,28],["κέκληται",707084,403],["ὄνομα",709666,15],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐγνώσθη",703105,37],["ὅ",709781,213],["ἐστιν",704093,91],["ἄνθρωπος",701163,4],["καὶ",707031,7],["οὐ",709805,28],["δυνήσεται",703838,93],["τοῦ",709436,20],["κριθῆναι",707905,179],["μετὰ",708780,0],["τοῦ",709436,35],["ἰσχυροῦ",706855,116],["ὑπὲρ",713111,0],["αὐτόν",702165,85]],"If anything has been, its name has already been called: and it is known what man is; neither can he contend with him who is stronger than he."],["11",[["ὅτι",709803,7],["εἰσὶν",704093,197],["λόγοι",708236,52],["πολλοὶ",710646,138],["πληθύνοντες",710530,146],["ματαιότητα",708576,9],["τί",712867,126],["περισσὸν",710387,28],["τῷ",709436,113],["ἀνθρώπῳ",701163,114]],"For there are many things which increase vanity.",{"s":"d","q":0.5}],["12",[["ὅτι",709803,7],["τίς",712867,158],["οἶδεν",709492,171],["τί",712867,126],["ἀγαθὸν",700106,46],["τῷ",709436,113],["ἀνθρώπῳ",701163,114],["ἐν",704639,0],["τῇ",709436,100],["ζωῇ",705910,1],["ἀριθμὸν",701744,6],["ἡμερῶν",705984,65],["ζωῆς",705910,17],["ματαιότητος",708576,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐποίησεν",710582,2],["αὐτὰς",702165,231],["ἐν",704639,0],["σκιᾷ",711852,1],["ὅτι",709803,7],["τίς",712867,158],["ἀπαγγελεῖ",701321,127],["τῷ",709436,113],["ἀνθρώπῳ",701163,114],["τί",712867,126],["ἔσται",704093,93],["ὀπίσω",709697,28],["αὐτοῦ",702165,102],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6]],"What advantage has a man? for who knows [what is] good for a man in his life, [during] the number of the life of the days of his vanity? and he has spent them as a shadow; for who shall tell a man what shall be after him under the sun?"]]