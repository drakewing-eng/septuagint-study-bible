[["1",[["καὶ",707031,7],["ἐπέστρεψα",705278,155],["ἐγὼ",704018,164],["καὶ",707031,7],["εἶδον",709725,155],["σὺν",712372,0],["πάσας",710177,119],["τὰς",709436,38],["συκοφαντίας",712258,39],["τὰς",709436,38],["γινομένας",703104,312],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6],["καὶ",707031,7],["ἰδοὺ",706497,88],["δάκρυον",703255,15],["τῶν",709436,80],["συκοφαντουμένων",712256,299],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["αὐτοῖς",702165,151],["παρακαλῶν",710039,72],["καὶ",707031,7],["ἀπὸ",701425,0],["χειρὸς",713787,17],["συκοφαντούντων",712256,170],["αὐτοὺς",702165,62],["ἰσχύς",706858,12],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["αὐτοῖς",702165,151],["παρακαλῶν",710039,72]],"So I returned, and saw all the oppressions that were done under the sun: and behold the tear of the oppressed, and they had no comforter; and on the side of them that oppressed them was power; but they had no comforter:"],["2",[["καὶ",707031,7],["ἐπῄνεσα",705000,155],["ἐγὼ",704018,164],["σὺν",712372,0],["τοὺς",709436,58],["τεθνηκότας",706278,277],["τοὺς",709436,58],["ἤδη",705939,28],["ἀποθανόντας",701461,454],["ὑπὲρ",713111,0],["τοὺς",709436,58],["ζῶντας",705851,235],["ὅσοι",709788,138],["αὐτοὶ",702165,201],["ζῶσιν",705851,197],["ἕως",705792,28],["τοῦ",709436,35],["νῦν",709384,28]],"and I praised all the dead that had already died more than the living, as many as are alive until now."],["3",[["καὶ",707031,7],["ἀγαθὸς",700106,14],["ὑπὲρ",713111,0],["τοὺς",709436,58],["δύο",703849,59],["τούτους",709858,62],["ὅστις",709793,425],["οὔπω",709837,28],["ἐγένετο",703104,23],["ὃς",709781,213],["οὐκ",709805,28],["εἶδεν",709725,2],["σὺν",712372,0],["τὸ",709436,24],["ποίημα",710583,25],["τὸ",709436,24],["πονηρὸν",710660,27],["τὸ",709436,24],["πεποιημένον",710582,448],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6]],"Better also than both these is he who has not yet been, who has not seen all the evil work that is done under the sun."],["4",[["καὶ",707031,7],["εἶδον",709725,155],["ἐγὼ",704018,164],["σὺν",712372,0],["πάντα",710177,27],["τὸν",709436,5],["μόχθον",709039,6],["καὶ",707031,7],["σὺν",712372,0],["πᾶσαν",710177,36],["ἀνδρείαν",701101,36],["τοῦ",709436,20],["ποιήματος",710583,21],["ὅτι",709803,7],["αὐτὸ",702165,132],["ζῆλος",705871,4],["ἀνδρὸς",701150,18],["ἀπὸ",701425,0],["τοῦ",709436,35],["ἑταίρου",705529,18],["αὐτοῦ",702165,102],["καί",707031,7],["γε",702985,11],["τοῦτο",709858,132],["ματαιότης",708576,12],["καὶ",707031,7],["προαίρεσις",710751,12],["πνεύματος",710566,21]],"And I saw all labour, and all the diligent work, that this is a man's envy from his neighbour. This is also vanity and waywardness of spirit."],["5",[["ὁ",709436,3],["ἄφρων",702236,14],["περιέλαβεν",710342,2],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔφαγεν",713296,2],["τὰς",709436,38],["σάρκας",711537,39],["αὐτοῦ",702165,102]],"The fool folds his hands together, and eats his own flesh."],["6",[["ἀγαθὸν",700106,26],["πλήρωμα",710544,15],["δρακὸς",703824,17],["ἀναπαύσεως",701026,17],["ὑπὲρ",713111,0],["πλήρωμα",710544,25],["δύο",703849,59],["δρακῶν",703824,65],["μόχθου",709039,18],["καὶ",707031,7],["προαιρέσεως",710751,17],["πνεύματος",710566,21]],"Better is a handful of rest than two handfuls of trouble and waywardness of spirit."],["7",[["καὶ",707031,7],["ἐπέστρεψα",705278,155],["ἐγὼ",704018,164],["καὶ",707031,7],["εἶδον",709725,155],["ματαιότητα",708576,9],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6]],"So I returned, and saw vanity under the sun."],["8",[["ἔστιν",704093,91],["εἷς",704106,596],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["δεύτερος",703389,14],["καί",707031,7],["γε",702985,11],["υἱὸς",713075,4],["καὶ",707031,7],["ἀδελφὸς",700249,4],["οὐκ",709805,28],["ἔστιν",704093,91],["αὐτῷ",702165,50],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["περασμὸς",710282,4],["τῷ",709436,113],["παντὶ",710177,30],["μόχθῳ",709039,114],["αὐτοῦ",702165,102],["καί",707031,7],["γε",702985,11],["ὀφθαλμὸς",709870,4],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐμπίπλαται",704592,117],["πλούτου",710563,18],["καὶ",707031,7],["τίνι",712867,432],["ἐγὼ",704018,164],["μοχθῶ",709037,157],["καὶ",707031,7],["στερίσκω",712079,157],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἀπὸ",701425,0],["ἀγαθωσύνης",700111,17],["καί",707031,7],["γε",702985,11],["τοῦτο",709858,132],["ματαιότης",708576,12],["καὶ",707031,7],["περισπασμὸς",710381,4],["πονηρός",710660,14],["ἐστιν",704093,91]],"There is one [alone], and there is not a second; yea, he has neither son nor brother: yet there is no end to all his labour; neither is his eye satisfied with wealth; and for whom do I labour, and deprive my soul of good? this is also vanity, and an evil trouble."],["9",[["ἀγαθοὶ",700106,138],["οἱ",709436,136],["δύο",703849,59],["ὑπὲρ",713111,0],["τὸν",709436,5],["ἕνα",704106,27],["οἷς",709781,311],["ἔστιν",704093,91],["αὐτοῖς",702165,151],["μισθὸς",708939,4],["ἀγαθὸς",700106,14],["ἐν",704639,0],["μόχθῳ",709039,114],["αὐτῶν",702165,40]],"Two [are] better than one, [seeing] they have a good reward for their labour."],["10",[["ὅτι",709803,7],["ἐὰν",703912,7],["πέσωσιν",710481,234],["ὁ",709436,3],["εἷς",704106,596],["ἐγερεῖ",703949,127],["τὸν",709436,5],["μέτοχον",708839,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐαὶ",709807,88],["αὐτῷ",702165,50],["τῷ",709436,113],["ἑνί",704106,30],["ὅταν",709801,28],["πέσῃ",710481,123],["καὶ",707031,7],["μὴ",708851,28],["ᾖ",704093,204],["δεύτερος",703389,14],["τοῦ",709436,20],["ἐγεῖραι",703949,106],["αὐτόν",702165,85]],"For if they fall, the one will lift up his fellow: but woe to him that is alone when he falls, and there is not a second to lift him up."],["11",[["καί",707031,7],["γε",702985,11],["ἐὰν",703912,7],["κοιμηθῶσιν",707767,272],["δύο",703849,59],["καὶ",707031,7],["θέρμη",706217,29],["αὐτοῖς",702165,151],["καὶ",707031,7],["ὁ",709436,3],["εἷς",704106,596],["πῶς",711121,28],["θερμανθῇ",706213,384]],"Also if two should lie together, they also get heat: but how shall one be warmed [alone]?"],["12",[["καὶ",707031,7],["ἐὰν",703912,7],["ἐπικραταιωθῇ",705174,384],["ὁ",709436,3],["εἷς",704106,596],["οἱ",709436,136],["δύο",703849,59],["στήσονται",706846,135],["κατέναντι",707507,28],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὸ",709436,34],["σπαρτίον",711999,15],["τὸ",709436,34],["ἔντριτον",704807,26],["οὐ",709805,28],["ταχέως",712743,28],["ἀπορραγήσεται",701561,134]],"And if one should prevail against [him], the two shall withstand him; and a threefold cord shall not be quickly broken."],["13",[["ἀγαθὸς",700106,14],["παῖς",709932,4],["πένης",710248,4],["καὶ",707031,7],["σοφὸς",711985,14],["ὑπὲρ",713111,0],["βασιλέα",702580,6],["πρεσβύτερον",710735,6],["καὶ",707031,7],["ἄφρονα",702236,27],["ὃς",709781,213],["οὐκ",709805,28],["ἔγνω",703105,2],["τοῦ",709436,20],["προσέχειν",710895,55],["ἔτι",705538,28]],"Better is a poor and wise child than an old and foolish king, who knows not how to take heed any longer."],["14",[["ὅτι",709803,7],["ἐξ",704132,0],["οἴκου",709516,18],["τῶν",709436,43],["δεσμίων",703371,83],["ἐξελεύσεται",704909,93],["τοῦ",709436,20],["βασιλεῦσαι",702581,106],["ὅτι",709803,7],["καί",707031,7],["γε",702985,11],["ἐν",704639,0],["βασιλείᾳ",702577,1],["αὐτοῦ",702165,102],["ἐγεννήθη",703051,37],["πένης",710248,4]],"For he shall come forth out of the house of the prisoners to reign, because [he] also that was in his kingdom has become poor."],["15",[["εἶδον",709725,155],["σὺν",712372,0],["πάντας",710177,60],["τοὺς",709436,58],["ζῶντας",705851,235],["τοὺς",709436,58],["περιπατοῦντας",710362,235],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6],["μετὰ",708780,0],["τοῦ",709436,35],["νεανίσκου",709232,18],["τοῦ",709436,35],["δευτέρου",703389,116],["ὃς",709781,213],["στήσεται",706846,93],["ἀντ᾿",701227,0],["αὐτοῦ",702165,102]],"I beheld all the living who were walking under the sun, with the second youth who shall stand up in each one's place."],["16",[["οὐκ",709805,28],["ἔστιν",704093,91],["περασμὸς",710282,4],["τῷ",709436,113],["παντὶ",710177,30],["λαῷ",708094,114],["τοῖς",709436,147],["πᾶσιν",710177,230],["ὅσοι",709788,138],["ἐγένοντο",703104,189],["ἔμπροσθεν",704618,0],["αὐτῶν",702165,40],["καί",707031,7],["γε",702985,11],["οἱ",709436,136],["ἔσχατοι",705519,138],["οὐκ",709805,28],["εὐφρανθήσονται",705715,144],["ἐν",704639,0],["αὐτῷ",702165,50],["ὅτι",709803,7],["καί",707031,7],["γε",702985,11],["τοῦτο",709858,132],["ματαιότης",708576,12],["καὶ",707031,7],["προαίρεσις",710751,12],["πνεύματος",710566,21]],"There is no end to all the people, to all who were before them: and the last shall not rejoice in him: for this also is vanity and waywardness of spirit."],["17",[["φύλαξον",713619,176],["πόδα",710707,6],["σου",711945,133],["ἐν",704639,0],["ᾧ",709781,309],["ἐὰν",703912,7],["πορεύῃ",710667,204],["εἰς",704105,0],["οἶκον",709516,6],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["ἐγγὺς",703948,28],["τοῦ",709436,20],["ἀκούειν",700587,55],["ὑπὲρ",713111,0],["δόμα",703789,25],["τῶν",709436,80],["ἀφρόνων",702236,169],["θυσία",706345,12],["σου",711945,133],["ὅτι",709803,7],["οὔκ",709805,28],["εἰσιν",704093,197],["εἰδότες",704075,268],["τοῦ",709436,20],["ποιῆσαι",710582,106],["κακόν",707066,46]],"Keep thy foot, whensoever thou goest to the house of God; and [when thou art] near to hear, let thy sacrifice [be] better than the gift of fools: for they know not that they are doing evil."]]