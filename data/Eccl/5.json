[["1",[["μὴ",708851,28],["σπεῦδε",712011,240],["ἐπὶ",705080,0],["στόματί",712125,54],["σου",711945,133],["καὶ",707031,7],["καρδία",707141,12],["σου",711945,133],["μὴ",708851,28],["ταχυνάτω",712749,45],["τοῦ",709436,20],["ἐξενέγκαι",704356,106],["λόγον",708236,6],["πρὸ",710747,0],["προσώπου",710986,21],["τοῦ",709436,35],["θεοῦ",706192,18],["ὅτι",709803,7],["ὁ",709436,3],["θεὸς",706192,4],["ἐν",704639,0],["τῷ",709436,113],["οὐρανῷ",709844,114],["καὶ",707031,7],["σὺ",712181,164],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ἐπὶ",705080,0],["τούτῳ",709858,50],["ἔστωσαν",704093,56],["οἱ",709436,136],["λόγοι",708236,52],["σου",711945,133],["ὀλίγοι",709568,138]],"Be not hasty with thy mouth, and let not thine heart be swift to utter anything before God; for God is in heaven above, and thou upon earth: therefore let thy words be few."],["2",[["ὅτι",709803,7],["παραγίνεται",710006,117],["ἐνύπνιον",704818,15],["ἐν",704639,0],["πλήθει",710529,54],["περισπασμοῦ",710381,18],["καὶ",707031,7],["φωνὴ",713640,12],["ἄφρονος",702236,116],["ἐν",704639,0],["πλήθει",710529,54],["λόγων",708236,81]],"For through the multitude of trial a dream comes; and a fool's voice is with a multitude of words."],["3",[["καθὼς",707030,28],["ἂν",700900,11],["εὔξῃ",705727,420],["εὐχὴν",705726,9],["τῷ",709436,113],["θεῷ",706192,114],["μὴ",708851,28],["χρονίσῃς",713967,175],["τοῦ",709436,20],["ἀποδοῦναι",701449,106],["αὐτήν",702165,104],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["θέλημα",706170,15],["ἐν",704639,0],["ἄφροσιν",702236,230],["σὺν",712372,0],["ὅσα",709788,68],["ἐὰν",703912,7],["εὔξῃ",705727,420],["ἀπόδος",701449,176]],"Whenever thou shalt vow a vow to God, defer not to pay it; for [he has] no pleasure in fools: pay thou therefore whatsoever thou shalt have vowed."],["4",[["ἀγαθὸν",700106,26],["τὸ",709436,34],["μὴ",708851,28],["εὔξασθαί",705727,109],["σε",711598,163],["ἢ",705924,7],["τὸ",709436,24],["εὔξασθαί",705727,109],["σε",711598,163],["καὶ",707031,7],["μὴ",708851,28],["ἀποδοῦναι",701449,106]],"[It is] better that thou shouldest not vow, than that thou shouldest vow and not pay."],["5",[["μὴ",708851,28],["δῷς",703654,175],["τὸ",709436,24],["στόμα",712125,25],["σου",711945,133],["τοῦ",709436,20],["ἐξαμαρτῆσαι",704859,106],["τὴν",709436,8],["σάρκα",711537,9],["σου",711945,133],["καὶ",707031,7],["μὴ",708851,28],["εἴπῃς",705373,175],["πρὸ",710747,0],["προσώπου",710986,21],["τοῦ",709436,35],["θεοῦ",706192,18],["ὅτι",709803,7],["ἄγνοιά",700177,12],["ἐστιν",704093,91],["ἵνα",706747,7],["μὴ",708851,28],["ὀργισθῇ",709729,384],["ὁ",709436,3],["θεὸς",706192,4],["ἐπὶ",705080,0],["φωνῇ",713640,1],["σου",711945,133],["καὶ",707031,7],["διαφθείρῃ",703624,204],["τὰ",709436,41],["ποιήματα",710583,42],["χειρῶν",713787,65],["σου",711945,133]],"Suffer not thy mouth to lead thy flesh to sin; and say not in the presence of God, It was an error: lest God be angry at thy voice, and destroy the works of thy hands."],["6",[["ὅτι",709803,7],["ἐν",704639,0],["πλήθει",710529,54],["ἐνυπνίων",704818,44],["καὶ",707031,7],["ματαιότητες",708576,191],["καὶ",707031,7],["λόγοι",708236,52],["πολλοί",710646,138],["ὅτι",709803,7],["σὺν",712372,0],["τὸν",709436,5],["θεὸν",706192,6],["φοβοῦ",713532,253]],"For [there is evil] in a multitude of dreams and vanities and many words: but fear thou God."],["7",[["ἐὰν",703912,7],["συκοφαντίαν",712258,9],["πένητος",710248,18],["καὶ",707031,7],["ἁρπαγὴν",701802,9],["κρίματος",707903,21],["καὶ",707031,7],["δικαιοσύνης",703695,17],["ἴδῃς",709725,175],["ἐν",704639,0],["χώρᾳ",714011,1],["μὴ",708851,28],["θαυμάσῃς",706135,175],["ἐπὶ",705080,0],["τῷ",709436,53],["πράγματι",710708,54],["ὅτι",709803,7],["ὑψηλὸς",713285,14],["ἐπάνω",705030,28],["ὑψηλοῦ",713285,116],["φυλάξαι",713619,106],["καὶ",707031,7],["ὑψηλοὶ",713285,138],["ἐπ᾿",705080,0],["αὐτούς",702165,62]],"If thou shouldest see the oppression of the poor, and the wresting of judgment and of justice in the land, wonder not at the matter: for [there is] a high one to watch over him that is high, and high ones over them."],["8",[["καὶ",707031,7],["περισσεία",710384,12],["γῆς",703083,17],["ἐν",704639,0],["παντί",710177,30],["ἐστι",704093,91],["βασιλεὺς",702580,4],["τοῦ",709436,35],["ἀγροῦ",700196,18],["εἰργασμένου",705383,482]],"Also the abundance of the earth is for every one: the king [is dependent on] the tilled field."],["9",[["ἀγαπῶν",700120,72],["ἀργύριον",701707,25],["οὐ",709805,28],["πλησθήσεται",710532,134],["ἀργυρίου",701707,21],["καὶ",707031,7],["τίς",712867,158],["ἠγάπησεν",700120,2],["ἐν",704639,0],["πλήθει",710529,54],["αὐτῶν",702165,40],["γένημα",703052,25],["καί",707031,7],["γε",702985,11],["τοῦτο",709858,132],["ματαιότης",708576,12]],"He that loves silver shall not be satisfied with silver: and who has loved gain, in the abundance thereof? this is also vanity."],["10",[["ἐν",704639,0],["πλήθει",710529,54],["τῆς",709436,16],["ἀγαθωσύνης",700111,17],["ἐπληθύνθησαν",710530,99],["ἔσθοντες",705495,146],["αὐτήν",702165,104],["καὶ",707031,7],["τί",712867,359],["ἀνδρεία",701101,29],["τῷ",709436,113],["παρ᾿",709995,0],["αὐτῆς",702165,86],["ὅτι",709803,7],["ἀλλ᾿",700680,7],["ἢ",705924,7],["τοῦ",709436,20],["ὁρᾶν",709725,55],["ὀφθαλμοῖς",709870,148],["αὐτοῦ",702165,102]],"In the multitude of good they are increased that eat it: and what virtue has the owner, but the right of beholding [it] with his eyes?"],["11",[["γλυκὺς",703114,14],["ὕπνος",713181,4],["τοῦ",709436,35],["δούλου",703817,18],["εἰ",704071,7],["ὀλίγον",709568,27],["καὶ",707031,7],["εἰ",704071,7],["πολὺ",710646,46],["φάγεται",713296,93],["καὶ",707031,7],["τῷ",709436,113],["ἐμπλησθέντι",704592,238],["τοῦ",709436,20],["πλουτῆσαι",710561,106],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀφίων",702211,72],["αὐτὸν",702165,85],["τοῦ",709436,20],["ὑπνῶσαι",713182,106]],"The sleep of a servant is sweet, whether he eat little or much: but to one who is satiated with wealth, there is none that suffers him to sleep."],["12",[["ἔστιν",704093,91],["ἀρρωστία",701813,12],["ἣν",709781,131],["εἶδον",709725,155],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6],["πλοῦτον",710563,6],["φυλασσόμενον",713619,212],["τῷ",709436,113],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["εἰς",704105,0],["κακίαν",707054,9],["αὐτοῦ",702165,102]],"There is an infirmity which I have seen under the sun, [namely], wealth kept for its owner to his hurt."],["13",[["καὶ",707031,7],["ἀπολεῖται",701513,93],["ὁ",709436,3],["πλοῦτος",710563,4],["ἐκεῖνος",704183,121],["ἐν",704639,0],["περισπασμῷ",710381,114],["πονηρῷ",710660,30],["καὶ",707031,7],["ἐγέννησεν",703051,2],["υἱόν",713075,6],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐν",704639,0],["χειρὶ",713787,1],["αὐτοῦ",702165,102],["οὐδέν",709817,26]],"And that wealth shall perish in an evil trouble: and [the man] begets a son, and there is nothing in his hand."],["14",[["καθὼς",707030,28],["ἐξῆλθεν",704909,2],["ἀπὸ",701425,0],["γαστρὸς",702976,17],["μητρὸς",708892,17],["αὐτοῦ",702165,102],["γυμνός",703202,14],["ἐπιστρέψει",705278,127],["τοῦ",709436,20],["πορευθῆναι",710667,179],["ὡς",714148,7],["ἥκει",705956,91],["καὶ",707031,7],["οὐδὲν",709817,46],["οὐ",709805,28],["λήμψεται",708076,93],["ἐν",704639,0],["μόχθῳ",709039,114],["αὐτοῦ",702165,102],["ἵνα",706747,7],["πορευθῇ",710667,384],["ἐν",704639,0],["χειρὶ",713787,1],["αὐτοῦ",702165,102]],"As he came forth naked from his mother's womb, he shall return back as he came, and he shall receive nothing for his labour, that it should go [with him] in his hand."],["15",[["καί",707031,7],["γε",702985,11],["τοῦτο",709858,132],["πονηρὰ",710660,29],["ἀρρωστία",701813,12],["ὥσπερ",714163,28],["γὰρ",702963,11],["παρεγένετο",710006,23],["οὕτως",709859,28],["καὶ",707031,7],["ἀπελεύσεται",701398,93],["καὶ",707031,7],["τίς",712867,359],["περισσεία",710384,12],["αὐτῷ",702165,50],["ᾗ",709781,108],["μοχθεῖ",709037,91],["εἰς",704105,0],["ἄνεμον",701123,6]],"And this is also an evil infirmity: for as he came, so also shall he return: and what is his gain, for which he vainly labours?"],["16",[["καί",707031,7],["γε",702985,11],["πᾶσαι",710177,192],["αἱ",709436,190],["ἡμέραι",705984,191],["αὐτοῦ",702165,102],["ἐν",704639,0],["σκότει",711889,54],["καὶ",707031,7],["πένθει",710253,54],["καὶ",707031,7],["θυμῷ",706334,114],["πολλῷ",710646,30],["καὶ",707031,7],["ἀρρωστίᾳ",701813,1],["καὶ",707031,7],["χόλῳ",713903,114]],"Yea, all his days are in darkness, and in mourning, and much sorrow, and infirmity, and wrath."],["17",[["ἰδοὺ",706497,88],["ὃ",709781,128],["εἶδον",709725,155],["ἐγὼ",704018,164],["ἀγαθόν",700106,26],["ὅ",709781,33],["ἐστιν",704093,91],["καλόν",707097,26],["τοῦ",709436,20],["φαγεῖν",713296,106],["καὶ",707031,7],["τοῦ",709436,20],["πιεῖν",710478,106],["καὶ",707031,7],["τοῦ",709436,20],["ἰδεῖν",709725,106],["ἀγαθωσύνην",700111,9],["ἐν",704639,0],["παντὶ",710177,30],["μόχθῳ",709039,114],["αὐτοῦ",702165,102],["ᾧ",709781,309],["ἐὰν",703912,7],["μοχθῇ",709037,204],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6],["ἀριθμὸν",701744,6],["ἡμερῶν",705984,65],["ζωῆς",705910,17],["αὐτοῦ",702165,102],["ὧν",709781,252],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["ὁ",709436,3],["θεός",706192,4],["ὅτι",709803,7],["αὐτὸ",702165,132],["μερὶς",708748,12],["αὐτοῦ",702165,102]],"Behold, I have seen good, that it is a fine thing [for a man] to eat and to drink, and to see good in all his labour in which he may labour under the sun, [all] the number of the days of his life which God has given to him: for it is his portion."],["18",[["καί",707031,7],["γε",702985,11],["πᾶς",710177,14],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ᾧ",709781,309],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["ὁ",709436,3],["θεὸς",706192,4],["πλοῦτον",710563,6],["καὶ",707031,7],["ὑπάρχοντα",713102,183],["καὶ",707031,7],["ἐξουσίασεν",704975,2],["αὐτὸν",702165,85],["τοῦ",709436,20],["φαγεῖν",713296,106],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["τοῦ",709436,20],["λαβεῖν",708076,106],["τὸ",709436,24],["μέρος",708752,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["τοῦ",709436,20],["εὐφρανθῆναι",705715,179],["ἐν",704639,0],["μόχθῳ",709039,114],["αὐτοῦ",702165,102],["τοῦτο",709858,132],["δόμα",703789,15],["θεοῦ",706192,18],["ἐστιν",704093,91]],"Yea, and [as for] every man to whom God has given wealth and possessions, and has given him power to eat thereof, and to receive his portion, and to rejoice in his labour; this is the gift of God."],["19",[["ὅτι",709803,7],["οὐ",709805,28],["πολλὰ",710646,68],["μνησθήσεται",708923,134],["τὰς",709436,38],["ἡμέρας",705984,17],["τῆς",709436,16],["ζωῆς",705910,17],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ὁ",709436,3],["θεὸς",706192,4],["περισπᾷ",710382,91],["αὐτὸν",702165,85],["ἐν",704639,0],["εὐφροσύνῃ",705717,1],["καρδίας",707141,17],["αὐτοῦ",702165,102]],"For he shall not much remember the days of his life; for God troubles him in the mirth of his heart."]]