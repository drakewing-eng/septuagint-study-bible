[["1",[["καὶ",707031,7],["μνήσθητι",708960,244],["τοῦ",709436,35],["κτίσαντός",707938,500],["σε",711598,163],["ἐν",704639,0],["ἡμέραις",705984,76],["νεότητός",709258,17],["σου",711945,133],["ἕως",705792,28],["ὅτου",709793,581],["μὴ",708851,28],["ἔλθωσιν",705453,234],["ἡμέραι",705984,191],["τῆς",709436,16],["κακίας",707054,17],["καὶ",707031,7],["φθάσωσιν",713439,234],["ἔτη",705543,64],["ἐν",704639,0],["οἷς",709781,311],["ἐρεῖς",705415,166],["οὐκ",709805,28],["ἔστιν",704093,91],["μοι",708974,159],["ἐν",704639,0],["αὐτοῖς",702165,151],["θέλημα",706170,15]],"And remember thy Creator in the days of thy youth, before the days of evil come, and the years overtake [thee] in which thou shalt say, I have no pleasure in them."],["2",[["ἕως",705792,28],["οὗ",709781,48],["μὴ",708851,28],["σκοτισθῇ",711887,384],["ὁ",709436,3],["ἥλιος",705974,4],["καὶ",707031,7],["τὸ",709436,34],["φῶς",713642,15],["καὶ",707031,7],["ἡ",709436,10],["σελήνη",711650,12],["καὶ",707031,7],["οἱ",709436,136],["ἀστέρες",702017,52],["καὶ",707031,7],["ἐπιστρέψωσιν",705278,234],["τὰ",709436,63],["νέφη",709281,64],["ὀπίσω",709697,28],["τοῦ",709436,35],["ὑετοῦ",713074,18]],"While the sun and light are not darkened, nor the moon and the stars; nor the clouds return after the rain:"],["3",[["ἐν",704639,0],["ἡμέρᾳ",705984,1],["ᾗ",709781,108],["ἐὰν",703912,7],["σαλευθῶσιν",711403,272],["φύλακες",713616,52],["τῆς",709436,16],["οἰκίας",709505,17],["καὶ",707031,7],["διαστραφῶσιν",703592,272],["ἄνδρες",701150,52],["τῆς",709436,16],["δυνάμεως",703839,17],["καὶ",707031,7],["ἤργησαν",701701,150],["αἱ",709436,190],["ἀλήθουσαι",700661,306],["ὅτι",709803,7],["ὠλιγώθησαν",709576,99],["καὶ",707031,7],["σκοτάσουσιν",711884,218],["αἱ",709436,190],["βλέπουσαι",702740,306],["ἐν",704639,0],["ταῖς",709436,75],["ὀπαῖς",709688,76]],"in the day wherein the keepers of the house shall tremble, and the mighty men shall become bent, and the grinding [women] cease because they have become few, and the [women] looking out at the windows be dark;"],["4",[["καὶ",707031,7],["κλείσουσιν",707710,218],["θύρας",706337,17],["ἐν",704639,0],["ἀγορᾷ",700183,1],["ἐν",704639,0],["ἀσθενείᾳ",701937,1],["φωνῆς",713640,17],["τῆς",709436,16],["ἀληθούσης",700661,222],["καὶ",707031,7],["ἀναστήσεται",701173,93],["εἰς",704105,0],["φωνὴν",713640,9],["τοῦ",709436,35],["στρουθίου",712166,21],["καὶ",707031,7],["ταπεινωθήσονται",712717,144],["πᾶσαι",710177,192],["αἱ",709436,190],["θυγατέρες",706320,191],["τοῦ",709436,20],["ᾄσματος",701970,21]],"and they shall shut the doors in the market-place, because of the weakness of the voice of her that grinds [at the mill]; and he shall rise up at the voice of the sparrow, and all the daughters of song shall be brought low;"],["5",[["καί",707031,7],["γε",702985,11],["ἀπὸ",701425,0],["ὕψους",713288,21],["ὄψονται",709725,135],["καὶ",707031,7],["θάμβοι",706082,52],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["καὶ",707031,7],["ἀνθήσῃ",701152,172],["τὸ",709436,34],["ἀμύγδαλον",700877,15],["καὶ",707031,7],["παχυνθῇ",710205,172],["ἡ",709436,10],["ἀκρίς",700599,12],["καὶ",707031,7],["διασκεδασθῇ",703575,384],["ἡ",709436,10],["κάππαρις",707135,12],["ὅτι",709803,7],["ἐπορεύθη",710667,37],["ὁ",709436,3],["ἄνθρωπος",701163,4],["εἰς",704105,0],["οἶκον",709516,6],["αἰῶνος",700504,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐκύκλωσαν",707958,150],["ἐν",704639,0],["ἀγορᾷ",700183,1],["οἱ",709436,136],["κοπτόμενοι",707829,348]],"and they shall look up, and fears [shall be] in the way, and the almond tree shall blossom, and the locust shall increase, and the caper shall be scattered: because man has gone to his eternal home, and the mourners have gone about the market:"],["6",[["ἕως",705792,28],["ὅτου",709793,581],["μὴ",708851,28],["ἀνατραπῇ",701073,172],["σχοινίον",712610,15],["τοῦ",709436,20],["ἀργυρίου",701707,21],["καὶ",707031,7],["συνθλιβῇ",712480,172],["ἀνθέμιον",701151,15],["τοῦ",709436,20],["χρυσίου",713972,21],["καὶ",707031,7],["συντριβῇ",712520,172],["ὑδρία",713067,12],["ἐπὶ",705080,0],["τὴν",709436,8],["πηγήν",710450,9],["καὶ",707031,7],["συντροχάσῃ",712526,172],["ὁ",709436,3],["τροχὸς",712994,4],["ἐπὶ",705080,0],["τὸν",709436,5],["λάκκον",708067,6]],"before the silver cord be [let go], or the choice gold be broken, or the pitcher be broken at the fountain, or the wheel run down to the cistern;"],["7",[["καὶ",707031,7],["ἐπιστρέψῃ",705278,123],["ὁ",709436,3],["χοῦς",713930,4],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["ὡς",714148,7],["ἦν",704093,13],["καὶ",707031,7],["τὸ",709436,34],["πνεῦμα",710566,15],["ἐπιστρέψῃ",705278,123],["πρὸς",710844,0],["τὸν",709436,5],["θεόν",706192,6],["ὃς",709781,213],["ἔδωκεν",703654,2],["αὐτό",702165,129]],"[before] the dust also return to the earth as it was, and the spirit return to God who gave it."],["8",[["ματαιότης",708576,12],["ματαιοτήτων",708576,65],["εἶπεν",705373,2],["ὁ",709436,3],["Ἐκκλησιαστής",704218,4],["τὰ",709436,63],["πάντα",710177,195],["ματαιότης",708576,12]],"Vanity of vanities, said the Preacher; all is vanity."],["9",[["καὶ",707031,7],["περισσὸν",710387,28],["ὅτι",709803,7],["ἐγένετο",703104,23],["Ἐκκλησιαστὴς",704218,4],["σοφός",711985,14],["ἔτι",705538,28],["ἐδίδαξεν",703649,2],["γνῶσιν",703138,9],["σὺν",712372,0],["τὸν",709436,5],["λαόν",708094,6],["καὶ",707031,7],["οὖς",709852,15],["ἐξιχνιάσεται",704941,93],["κόσμιον",707848,25],["παραβολῶν",710003,65]],"And because the Preacher was wise above [others, so it was] that he taught man excellent knowledge, and the ear will trace out the parables."],["10",[["πολλὰ",710646,68],["ἐζήτησεν",705879,2],["Ἐκκλησιαστὴς",704218,4],["τοῦ",709436,20],["εὑρεῖν",705676,106],["λόγους",708236,57],["θελήματος",706170,21],["καὶ",707031,7],["γεγραμμένον",703194,469],["εὐθύτητος",705603,17],["λόγους",708236,57],["ἀληθείας",700656,17]],"The Preacher sought diligently to find out acceptable words, and a correct writing, [even] words of truth."],["11",[["λόγοι",708236,52],["σοφῶν",711985,169],["ὡς",714148,7],["τὰ",709436,63],["βούκεντρα",702784,64],["καὶ",707031,7],["ὡς",714148,7],["ἧλοι",705977,52],["πεφυτευμένοι",713636,362],["οἳ",709781,250],["παρὰ",709995,0],["τῶν",709436,43],["συναγμάτων",712374,44],["ἐδόθησαν",703654,99],["ἐκ",704132,0],["ποιμένος",710596,18],["ἑνὸς",704106,116],["καὶ",707031,7],["περισσὸν",710387,28],["ἐξ",704132,0],["αὐτῶν",702165,40]],"The words of the wise are as goads, and as nails firmly fastened, which have been given from one shepherd by agreement."],["12",[["υἱέ",713075,153],["μου",709032,133],["φύλαξαι",713619,300],["ποιῆσαι",710582,106],["βιβλία",702719,42],["πολλά",710646,68],["οὐκ",709805,28],["ἔστιν",704093,91],["περασμός",710282,4],["καὶ",707031,7],["μελέτη",708699,12],["πολλὴ",710646,29],["κόπωσις",707830,12],["σαρκός",711537,17]],"And moreover, my son, guard thyself by means of them: of making many books there is no end; and much study is a weariness of the flesh."],["13",[["τέλος",712787,15],["λόγου",708236,18],["τὸ",709436,34],["πᾶν",710177,26],["ἀκούεται",700587,391],["τὸν",709436,5],["θεὸν",706192,6],["φοβοῦ",713532,253],["καὶ",707031,7],["τὰς",709436,38],["ἐντολὰς",704802,39],["αὐτοῦ",702165,102],["φύλασσε",713619,240],["ὅτι",709803,7],["τοῦτο",709858,132],["πᾶς",710177,14],["ὁ",709436,3],["ἄνθρωπος",701163,4]],"Hear the end of the matter, the sum: Fear God, and keep his commandments: for this is the whole man."],["14",[["ὅτι",709803,7],["σὺν",712372,0],["πᾶν",710177,46],["τὸ",709436,24],["ποίημα",710583,25],["ὁ",709436,3],["θεὸς",706192,4],["ἄξει",700209,127],["ἐν",704639,0],["κρίσει",707908,1],["ἐν",704639,0],["παντὶ",710177,97],["παρεωραμένῳ",710125,746],["ἐὰν",703912,7],["ἀγαθὸν",700106,26],["καὶ",707031,7],["ἐὰν",703912,7],["πονηρόν",710660,26]],"For God will bring every work into judgment, with everything that has been overlooked, whether [it be] good, or whether [it be] evil."]]