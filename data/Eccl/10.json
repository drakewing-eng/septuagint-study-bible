[["1",[["μυῖαι",709050,191],["θανατοῦσαι",706097,306],["σαπριοῦσιν",711504,218],["σκευασίαν",711842,9],["ἐλαίου",704380,21],["ἡδύσματος",705946,21],["τίμιον",712858,27],["ὀλίγον",709568,27],["σοφίας",711981,17],["ὑπὲρ",713111,0],["δόξαν",703791,9],["ἀφροσύνης",702235,17],["μεγάλης",708653,82]],"Pestilent flies will corrupt a preparation of sweet ointment: [and] a little wisdom is more precious than great glory of folly."],["2",[["καρδία",707141,12],["σοφοῦ",711985,116],["εἰς",704105,0],["δεξιὸν",703360,27],["αὐτοῦ",702165,102],["καὶ",707031,7],["καρδία",707141,12],["ἄφρονος",702236,116],["εἰς",704105,0],["ἀριστερὸν",701749,27],["αὐτοῦ",702165,102]],"A wise man's heart is at his right hand; but a fool's heart at his left."],["3",[["καί",707031,7],["γε",702985,11],["ἐν",704639,0],["ὁδῷ",709458,1],["ὅταν",709801,28],["ἄφρων",702236,14],["πορεύηται",710667,428],["καρδία",707141,12],["αὐτοῦ",702165,102],["ὑστερήσει",713270,127],["καὶ",707031,7],["ἃ",709781,69],["λογιεῖται",708232,93],["πάντα",710177,27],["ἀφροσύνη",702235,12],["ἐστίν",704093,91]],"Yea, and whenever a fool walks by the way, his heart will fail him, and all that he thinks of is folly."],["4",[["ἐὰν",703912,7],["πνεῦμα",710566,15],["τοῦ",709436,35],["ἐξουσιάζοντος",704975,152],["ἀναβῇ",700905,172],["ἐπὶ",705080,0],["σέ",711598,163],["τόπον",712903,6],["σου",711945,133],["μὴ",708851,28],["ἀφῇς",702211,175],["ὅτι",709803,7],["ἴαμα",706405,15],["καταπαύσει",707365,127],["ἁμαρτίας",700775,39],["μεγάλας",708653,119]],"If the spirit of the ruler rise up against thee, leave not thy place; for soothing will put an end to great offences."],["5",[["ἔστιν",704093,91],["πονηρία",710659,12],["ἣν",709781,131],["εἶδον",709725,155],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6],["ὡς",714148,7],["ἀκούσιον",700582,26],["ὃ",709781,33],["ἐξῆλθεν",704909,2],["ἀπὸ",701425,0],["προσώπου",710986,21],["τοῦ",709436,35],["ἐξουσιάζοντος",704975,152]],"There is an evil which I have seen under the sun, wherein an error has proceeded from the ruler."],["6",[["ἐδόθη",703654,37],["ὁ",709436,3],["ἄφρων",702236,14],["ἐν",704639,0],["ὕψεσι",713288,148],["μεγάλοις",708653,230],["καὶ",707031,7],["πλούσιοι",710560,138],["ἐν",704639,0],["ταπεινῷ",712714,30],["καθήσονται",707007,135]],"The fool has been set in very high places, while rich men would sit in a low one."],["7",[["εἶδον",709725,155],["δούλους",703817,57],["ἐφ᾿",705080,0],["ἵππους",706790,57],["καὶ",707031,7],["ἄρχοντας",701862,57],["πορευομένους",710667,236],["ὡς",714148,7],["δούλους",703817,57],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"I have seen servants upon horses, and princes walking as servants on the earth."],["8",[["ὁ",709436,3],["ὀρύσσων",709775,72],["βόθρον",702749,6],["ἐν",704639,0],["αὐτῷ",702165,50],["ἐμπεσεῖται",704593,93],["καὶ",707031,7],["καθαιροῦντα",706982,183],["φραγμόν",713572,6],["δήξεται",703254,93],["αὐτὸν",702165,85],["ὄφις",709875,4]],"He that digs a pit shall fall into it; and him that breaks down a hedge a serpent shall bite."],["9",[["ἐξαίρων",704839,72],["λίθους",708196,57],["διαπονηθήσεται",703550,134],["ἐν",704639,0],["αὐτοῖς",702165,151],["σχίζων",712604,72],["ξύλα",709427,42],["κινδυνεύσει",707677,127],["ἐν",704639,0],["αὐτοῖς",702165,151]],"He that removes stones shall be troubled thereby; he that cleaves wood shall be endangered thereby."],["10",[["ἐὰν",703912,7],["ἐκπέσῃ",704284,172],["τὸ",709436,34],["σιδήριον",711772,15],["καὶ",707031,7],["αὐτὸς",702165,121],["πρόσωπον",710986,25],["ἐτάραξεν",712721,2],["καὶ",707031,7],["δυνάμεις",703839,39],["δυναμώσει",703840,127],["καὶ",707031,7],["περισσεία",710384,12],["τοῦ",709436,35],["ἀνδρείου",701101,116],["σοφία",711981,12]],"If the axe-head should fall off, then the man troubles his countenance, and he must put forth more strength: and [in that case] skill is of no advantage to a man."],["11",[["ἐὰν",703912,7],["δάκῃ",703254,172],["ὁ",709436,3],["ὄφις",709875,4],["ἐν",704639,0],["οὐ",709805,28],["ψιθυρισμῷ",714054,114],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["περισσεία",710384,12],["τῷ",709436,113],["ἐπᾴδοντι",704997,379]],"If a serpent bite when there is no [charmer's] whisper, then there is no advantage to the charmer."],["12",[["λόγοι",708236,52],["στόματος",712125,21],["σοφοῦ",711985,116],["χάρις",713735,12],["καὶ",707031,7],["χείλη",713781,64],["ἄφρονος",702236,116],["καταποντιοῦσιν",707385,218],["αὐτόν",702165,85]],"The words of a wise mouth are gracious: but the lips of a fool will swallow him up."],["13",[["ἀρχὴ",701836,12],["λόγων",708236,81],["στόματος",712125,21],["αὐτοῦ",702165,102],["ἀφροσόνη",702235,12],["καὶ",707031,7],["ἐσχάτη",705519,29],["στόματος",712125,21],["αὐτοῦ",702165,102],["περιφέρεια",710408,12],["πονηρά",710660,29]],"The beginning of the words of his mouth is folly: and the end of his talk mischievous madness."],["14",[["καὶ",707031,7],["ὁ",709436,3],["ἄφρων",702236,14],["πληθύνει",710530,91],["λόγους",708236,57],["οὐκ",709805,28],["ἔγνω",703105,2],["ὁ",709436,3],["ἄνθρωπος",701163,4],["τί",712867,126],["τὸ",709436,24],["γενόμενον",703104,604],["καὶ",707031,7],["τί",712867,126],["τὸ",709436,24],["ἐσόμενον",704093,400],["ὀπίσω",709697,28],["αὐτοῦ",702165,102],["τίς",712867,158],["ἀναγγελεῖ",700921,127],["αὐτῷ",702165,50]],"A fool moreover multiplies words: man knows not what has been, nor what will be: who shall tell him what will come after him?"],["15",[["μόχθος",709039,4],["τῶν",709436,80],["ἀφρόνων",702236,169],["κοπώσει",707826,127],["αὐτούς",702165,62],["ὃς",709781,213],["οὐκ",709805,28],["ἔγνω",703105,2],["τοῦ",709436,20],["πορευθῆναι",710667,179],["εἰς",704105,0],["πόλιν",710612,9]],"The labour of fools will afflict them, [as that of one] who knows not to go to the city."],["16",[["οὐαί",709807,88],["σοι",711925,159],["πόλις",710612,12],["ἧς",709781,167],["ὁ",709436,3],["βασιλεύς",702580,4],["σου",711945,133],["νεώτερος",709256,224],["καὶ",707031,7],["οἱ",709436,136],["ἄρχοντές",701862,52],["σου",711945,133],["ἐν",704639,0],["πρωίᾳ",711025,1],["ἐσθίουσιν",705495,197]],"Woe to thee, O city, whose king is young, and thy princes eat in the morning!"],["17",[["μακαρία",708397,29],["σύ",712181,164],["γῆ",703083,12],["ἧς",709781,167],["ὁ",709436,3],["βασιλεύς",702580,4],["σου",711945,133],["υἱὸς",713075,4],["ἐλευθέρων",704428,169],["καὶ",707031,7],["οἱ",709436,136],["ἄρχοντές",701862,52],["σου",711945,133],["πρὸς",710844,0],["καιρὸν",707047,6],["φάγονται",713296,135],["ἐν",704639,0],["δυνάμει",703839,1],["καὶ",707031,7],["οὐκ",709805,28],["αἰσχυνθήσονται",700485,144]],"Blessed art thou, O land, whose king is a son of nobles, and whose princes shall eat seasonably, for strength, and shall not be ashamed."],["18",[["ἐν",704639,0],["ὀκνηρίαις",709549,76],["ταπεινωθήσεται",712717,134],["ἡ",709436,10],["δόκωσις",703782,12],["καὶ",707031,7],["ἐν",704639,0],["ἀργίᾳ",701702,1],["χειρῶν",713787,65],["στάξει",712038,127],["ἡ",709436,10],["οἰκία",709505,12]],"By slothful neglect a building will be brought low: and by idleness of the hands the house will fall to pieces."],["19",[["εἰς",704105,0],["γέλωτα",703032,6],["ποιοῦσιν",710582,197],["ἄρτον",701829,6],["καὶ",707031,7],["οἶνος",709530,4],["εὐφραίνει",705715,91],["ζῶντας",705851,235],["καὶ",707031,7],["τοῦ",709436,20],["ἀργυρίου",701707,21],["ἐπακούσεται",705009,93],["σὺν",712372,0],["τὰ",709436,41],["πάντα",710177,68]],"Men prepare bread for laughter, and wine and oil that the living should rejoice: but to money all things will humbly yield obedience."],["20",[["καί",707031,7],["γε",702985,11],["ἐν",704639,0],["συνειδήσει",712432,1],["σου",711945,133],["βασιλέα",702580,6],["μὴ",708851,28],["καταράσῃ",707396,420],["καὶ",707031,7],["ἐν",704639,0],["ταμιείοις",712700,96],["κοιτώνων",707782,81],["σου",711945,133],["μὴ",708851,28],["καταράσῃ",707396,420],["πλούσιον",710560,27],["ὅτι",709803,7],["πετεινὸν",710439,15],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["ἀποίσει",701632,127],["σὺν",712372,0],["τὴν",709436,8],["φωνήν",713640,9],["καὶ",707031,7],["ὁ",709436,3],["ἔχων",705785,72],["τὰς",709436,38],["πτέρυγας",711057,39],["ἀπαγγελεῖ",701321,127],["λόγον",708236,6]],"Even in thy conscience, curse not the king; and curse not the rich in thy bedchamber: for a bird of the air shall carry thy voice, and that which has wings shall report thy speech."]]