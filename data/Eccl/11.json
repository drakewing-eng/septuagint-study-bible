[["1",[["ἀπόστειλον",701592,176],["τὸν",709436,5],["ἄρτον",701829,6],["σου",711945,133],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["τοῦ",709436,20],["ὕδατος",713071,21],["ὅτι",709803,7],["ἐν",704639,0],["πλήθει",710529,54],["τῶν",709436,130],["ἡμερῶν",705984,65],["εὑρήσεις",705676,166],["αὐτόν",702165,85]],"Send forth thy bread upon the face of the water: for thou shalt find it after many days."],["2",[["δὸς",703654,176],["μερίδα",708748,9],["τοῖς",709436,147],["ἑπτὰ",705357,59],["καί",707031,7],["γε",702985,11],["τοῖς",709436,147],["ὀκτώ",709555,59],["ὅτι",709803,7],["οὐ",709805,28],["γινώσκεις",703105,154],["τί",712867,126],["ἔσται",704093,93],["πονηρὸν",710660,26],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9]],"Give a portion to seven, and also to eight; for thou knowest not what evil there shall be upon the earth."],["3",[["ἐὰν",703912,7],["πληρωθῶσιν",710543,272],["τὰ",709436,63],["νέφη",709281,64],["ὑετοῦ",713074,18],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["ἐκχέουσιν",704368,197],["καὶ",707031,7],["ἐὰν",703912,7],["πέσῃ",710481,172],["ξύλον",709427,15],["ἐν",704639,0],["τῷ",709436,113],["νότῳ",709364,114],["καὶ",707031,7],["ἐὰν",703912,7],["ἐν",704639,0],["τῷ",709436,113],["βορρᾷ",702765,114],["τόπῳ",712903,114],["οὗ",709781,48],["πεσεῖται",710481,93],["τὸ",709436,34],["ξύλον",709427,15],["ἐκεῖ",704181,28],["ἔσται",704093,93]],"If the clouds be filled with rain, they pour [it] out upon the earth: and if a tree fall southward, or if it fall northward, in the place where the tree shall fall, there it shall be."],["4",[["τηρῶν",712844,72],["ἄνεμον",701123,6],["οὐ",709805,28],["σπερεῖ",712006,127],["καὶ",707031,7],["βλέπων",702740,72],["ἐν",704639,0],["ταῖς",709436,75],["νεφέλαις",709277,76],["οὐ",709805,28],["θερίσει",706206,127]],"He that observes the wind sows not; and he that looks at the clouds will not reap."],["5",[["ἐν",704639,0],["οἷς",709781,311],["οὐκ",709805,28],["ἔστιν",704093,91],["γινώσκων",703105,72],["τίς",712867,359],["ἡ",709436,10],["ὁδὸς",709458,12],["τοῦ",709436,20],["πνεύματος",710566,21],["ὡς",714148,7],["ὀστᾶ",709792,64],["ἐν",704639,0],["γαστρὶ",702976,1],["τῆς",709436,16],["κυοφορούσης",707979,222],["οὕτως",709859,28],["οὐ",709805,28],["γνώσῃ",703105,123],["τὰ",709436,41],["ποιήματα",710583,42],["τοῦ",709436,35],["θεοῦ",706192,18],["ὅσα",709788,68],["ποιήσει",710582,127],["σὺν",712372,0],["τὰ",709436,41],["πάντα",710177,68]],"Among whom none knows what is the way of the wind: as the bones [are hid] in the womb of a pregnant [woman], so thou shalt not know the works of God, [even] all things whatsoever he shall do."],["6",[["ἐν",704639,0],["πρωίᾳ",711025,1],["σπεῖρον",712006,176],["τὸ",709436,24],["σπέρμα",712008,25],["σου",711945,133],["καὶ",707031,7],["εἰς",704105,0],["ἑσπέραν",705500,9],["μὴ",708851,28],["ἀφέτω",702211,31],["ἡ",709436,10],["χείρ",713787,12],["σου",711945,133],["ὅτι",709803,7],["οὐ",709805,28],["γινώσκεις",703105,154],["ποῖον",710599,46],["στοιχήσει",712119,127],["ἢ",705924,7],["τοῦτο",709858,132],["ἢ",705924,7],["τοῦτο",709858,132],["καὶ",707031,7],["ἐὰν",703912,7],["τὰ",709436,63],["δύο",703849,59],["ἐπὶ",705080,0],["τὸ",709436,34],["αὐτὸ",702165,132],["ἀγαθά",700106,195]],"In the morning sow thy seed, and in the evening let not thine hand be slack: for thou knowest not what sort shall prosper, whether this or that, or whether both shall be good alike."],["7",[["καὶ",707031,7],["γλυκὺ",703114,26],["τὸ",709436,34],["φῶς",713642,15],["καὶ",707031,7],["ἀγαθὸν",700106,26],["τοῖς",709436,147],["ὀφθαλμοῖς",709870,148],["τοῦ",709436,20],["βλέπειν",702740,55],["σὺν",712372,0],["τὸν",709436,5],["ἥλιον",705974,6]],"Moreover the light is sweet, and it is good for the eyes to see the sun."],["8",[["ὅτι",709803,7],["καὶ",707031,7],["ἐὰν",703912,7],["ἔτη",705543,42],["πολλὰ",710646,68],["ζήσεται",705851,93],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ἐν",704639,0],["πᾶσιν",710177,230],["αὐτοῖς",702165,151],["εὐφρανθήσεται",705715,134],["καὶ",707031,7],["μνησθήσεται",708923,134],["τὰς",709436,38],["ἡμέρας",705984,39],["τοῦ",709436,20],["σκότους",711889,21],["ὅτι",709803,7],["πολλαὶ",710646,192],["ἔσονται",704093,135],["πᾶν",710177,26],["τὸ",709436,34],["ἐρχόμενον",705453,208],["ματαιότης",708576,12]],"For even if a man should live many years, [and] rejoice in them all; yet let him remember the days of darkness; for they shall be many. All that comes is vanity."],["9",[["εὐφραίνου",705715,253],["νεανίσκε",709232,153],["ἐν",704639,0],["νεότητί",709258,1],["σου",711945,133],["καὶ",707031,7],["ἀγαθυνάτω",700109,45],["σε",711598,163],["ἡ",709436,10],["καρδία",707141,12],["σου",711945,133],["ἐν",704639,0],["ἡμέραις",705984,76],["νεότητός",709258,17],["σου",711945,133],["καὶ",707031,7],["περιπάτει",710362,240],["ἐν",704639,0],["ὁδοῖς",709458,76],["καρδίας",707141,17],["σου",711945,133],["καὶ",707031,7],["ἐν",704639,0],["ὁράσει",709721,1],["ὀφθαλμῶν",709870,81],["σου",711945,133],["καὶ",707031,7],["γνῶθι",703105,176],["ὅτι",709803,7],["ἐπὶ",705080,0],["πᾶσι",710177,230],["τούτοις",709858,151],["ἄξει",700209,127],["σε",711598,163],["ὁ",709436,3],["θεὸς",706192,4],["ἐν",704639,0],["κρίσει",707908,1]],"Rejoice, O young man, in thy youth; and let thy heart cheer thee in the days of thy youth, and walk in the ways of thy heart blameless, but not in the sight of thine eyes: yet know that for all these things God will bring thee into judgment."],["10",[["καὶ",707031,7],["ἀπόστησον",702214,176],["θυμὸν",706334,6],["ἀπὸ",701425,0],["καρδίας",707141,17],["σου",711945,133],["καὶ",707031,7],["παράγαγε",710007,176],["πονηρίαν",710659,9],["ἀπὸ",701425,0],["σαρκός",711537,17],["σου",711945,133],["ὅτι",709803,7],["ἡ",709436,10],["νεότης",709258,12],["καὶ",707031,7],["ἡ",709436,10],["ἄνοια",701185,12],["ματαιότης",708576,12]],"Therefore remove sorrow from thy heart, and put away evil from thy flesh: for youth and folly are vanity."]]