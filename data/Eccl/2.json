[["1",[["εἶπον",705373,150],["ἐγὼ",704018,164],["ἐν",704639,0],["καρδίᾳ",707141,1],["μου",709032,133],["δεῦρο",703382,28],["δὴ",703395,11],["πειράσω",710225,165],["σε",711598,163],["ἐν",704639,0],["εὐφροσύνῃ",705717,1],["καὶ",707031,7],["ἰδὲ",709725,176],["ἐν",704639,0],["ἀγαθῷ",700106,30],["καὶ",707031,7],["ἰδοὺ",706497,88],["καί",707031,7],["γε",702985,11],["τοῦτο",709858,129],["ματαιότης",708576,12]],"I said in my heart, Come now, I will prove thee with mirth, and behold thou good: and, behold, this is also vanity."],["2",[["τῷ",709436,113],["γέλωτι",703032,114],["εἶπα",705373,155],["περιφορὰν",710411,9],["καὶ",707031,7],["τῇ",709436,100],["εὐφροσύνῃ",705717,1],["τί",712867,126],["τοῦτο",709858,129],["ποιεῖς",710582,154]],"I said to laughter, Madness: and to mirth, Why doest thou this?"],["3",[["κατεσκεψάμην",707418,161],["ἐν",704639,0],["καρδίᾳ",707141,1],["μου",709032,133],["τοῦ",709436,20],["ἑλκύσαι",704508,106],["εἰς",704105,0],["οἶνον",709530,6],["τὴν",709436,8],["σάρκα",711537,9],["μου",709032,133],["καὶ",707031,7],["καρδία",707141,12],["μου",709032,133],["ὡδήγησεν",709448,2],["ἐν",704639,0],["σοφίᾳ",711981,1],["καὶ",707031,7],["τοῦ",709436,20],["κρατῆσαι",707879,106],["ἐπ᾿",705080,0],["ἀφροσύνῃ",702235,1],["ἕως",705792,28],["οὗ",709781,48],["ἴδω",709725,207],["ποῖον",710599,46],["τὸ",709436,24],["ἀγαθὸν",700106,46],["τοῖς",709436,147],["υἱοῖς",713075,148],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["ὃ",709781,213],["ποιήσουσιν",710582,218],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6],["ἀριθμὸν",701744,6],["ἡμερῶν",705984,65],["ζωῆς",705910,17],["αὐτῶν",702165,40]],"And I examined whether my heart would excite my flesh as [with] wine, (though my heart guided [me] in wisdom,) and [I desired] to lay hold of mirth, until I should see of what kind is the good to the sons of men, which they should do under the sun all the days of their life."],["4",[["ἐμεγάλυνα",708647,155],["ποίημά",710583,25],["μου",709032,133],["ᾠκοδόμησά",709509,155],["μοι",708974,159],["οἴκους",709516,57],["ἐφύτευσά",713636,155],["μοι",708974,159],["ἀμπελῶνας",700872,57]],"I enlarged my work; I built me houses; I planted me vineyards."],["5",[["ἐποίησά",710582,155],["μοι",708974,159],["κήπους",707654,57],["καὶ",707031,7],["παραδείσους",710012,57],["καὶ",707031,7],["ἐφύτευσα",713636,155],["ἐν",704639,0],["αὐτοῖς",702165,151],["ξύλον",709427,25],["πᾶν",710177,46],["καρποῦ",707169,18]],"I made me gardens and orchards, and planted in them every kind of fruit-tree."],["6",[["ἐποίησά",710582,155],["μοι",708974,159],["κολυμβήθρας",707802,39],["ὑδάτων",713071,44],["τοῦ",709436,20],["ποτίσαι",710700,106],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["δρυμὸν",703836,6],["βλαστῶντα",702734,183],["ξύλα",709427,42]],"I made me pools of water, to water from them the timber-bearing wood."],["7",[["ἐκτησάμην",707932,161],["δούλους",703817,57],["καὶ",707031,7],["παιδίσκας",709928,39],["καὶ",707031,7],["οἰκογενεῖς",709508,138],["ἐγένοντό",703104,189],["μοι",708974,159],["καί",707031,7],["γε",702985,11],["κτῆσις",707937,12],["βουκολίου",702794,21],["καὶ",707031,7],["ποιμνίου",710598,21],["πολλὴ",710646,29],["ἐγένετό",703104,23],["μοι",708974,159],["ὑπὲρ",713111,0],["πάντας",710177,60],["τοὺς",709436,58],["γενομένους",703104,525],["ἔμπροσθέν",704618,0],["μου",709032,133],["ἐν",704639,0],["Ιερουσαλημ",706644,744]],"I got servants and maidens, and servants were born to me in the house: also I had abundant possession of flocks and herds, beyond all who were before me in Jerusalem."],["8",[["συνήγαγόν",712375,155],["μοι",708974,159],["καί",707031,7],["γε",702985,11],["ἀργύριον",701707,25],["καὶ",707031,7],["χρυσίον",713972,25],["καὶ",707031,7],["περιουσιασμοὺς",710357,57],["βασιλέων",702580,81],["καὶ",707031,7],["τῶν",709436,130],["χωρῶν",714011,65],["ἐποίησά",710582,155],["μοι",708974,159],["ᾄδοντας",700299,235],["καὶ",707031,7],["ᾀδούσας",700299,338],["καὶ",707031,7],["ἐντρυφήματα",704811,42],["υἱῶν",713075,81],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["οἰνοχόον",709533,27],["καὶ",707031,7],["οἰνοχόας",709533,119]],"Moreover I collected for myself both silver and gold also, and the peculiar treasures of kings and provinces: I procured me singing men and singing women, and delights of the sons of men, a butler and female cupbearers."],["9",[["καὶ",707031,7],["ἐμεγαλύνθην",708647,156],["καὶ",707031,7],["προσέθηκα",710965,155],["παρὰ",709995,0],["πάντας",710177,60],["τοὺς",709436,58],["γενομένους",703104,525],["ἔμπροσθέν",704618,0],["μου",709032,133],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καί",707031,7],["γε",702985,11],["σοφία",711981,12],["μου",709032,133],["ἐστάθη",706846,37],["μοι",708974,159]],"So I became great, and advanced beyond all that were before me in Jerusalem: also my wisdom was established to me."],["10",[["καὶ",707031,7],["πᾶν",710177,46],["ὃ",709781,128],["ᾔτησαν",700489,150],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["μου",709032,133],["οὐχ",709805,28],["ὑφεῖλον",713276,150],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["οὐκ",709805,28],["ἀπεκώλυσα",701501,155],["τὴν",709436,8],["καρδίαν",707141,9],["μου",709032,133],["ἀπὸ",701425,0],["πάσης",710177,82],["εὐφροσύνης",705717,17],["ὅτι",709803,7],["καρδία",707141,12],["μου",709032,133],["εὐφράνθη",705715,37],["ἐν",704639,0],["παντὶ",710177,30],["μόχθῳ",709039,114],["μου",709032,133],["καὶ",707031,7],["τοῦτο",709858,132],["ἐγένετο",703104,23],["μερίς",708748,12],["μου",709032,133],["ἀπὸ",701425,0],["παντὸς",710177,116],["μόχθου",709039,18],["μου",709032,133]],"And whatever mine eyes desired, I withheld not from them, I withheld not my heart from all my mirth: for my heart rejoiced in all my labour; and this was my portion of all my labour."],["11",[["καὶ",707031,7],["ἐπέβλεψα",705088,155],["ἐγὼ",704018,164],["ἐν",704639,0],["πᾶσιν",710177,94],["ποιήμασίν",710583,96],["μου",709032,133],["οἷς",709781,295],["ἐποίησαν",710582,150],["αἱ",709436,190],["χεῖρές",713787,191],["μου",709032,133],["καὶ",707031,7],["ἐν",704639,0],["μόχθῳ",709039,114],["ᾧ",709781,309],["ἐμόχθησα",709037,155],["τοῦ",709436,20],["ποιεῖν",710582,55],["καὶ",707031,7],["ἰδοὺ",706497,88],["τὰ",709436,63],["πάντα",710177,195],["ματαιότης",708576,12],["καὶ",707031,7],["προαίρεσις",710751,12],["πνεύματος",710566,21],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["περισσεία",710384,12],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6]],"And I looked on all my works which my hands had wrought, and on my labour which I laboured to perform: and, behold, all was vanity and waywardness of spirit, and there is no advantage under the sun."],["12",[["καὶ",707031,7],["ἐπέβλεψα",705088,155],["ἐγὼ",704018,164],["τοῦ",709436,20],["ἰδεῖν",709725,106],["σοφίαν",711981,9],["καὶ",707031,7],["περιφορὰν",710411,9],["καὶ",707031,7],["ἀφροσύνην",702235,9],["ὅτι",709803,7],["τίς",712867,158],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ὃς",709781,213],["ἐπελεύσεται",705068,93],["ὀπίσω",709697,28],["τῆς",709436,16],["βουλῆς",702792,17],["τὰ",709436,41],["ὅσα",709788,68],["ἐποίησεν",710582,2],["αὐτήν",702165,104]],"Then I looked on to see wisdom, and madness, and folly: for who is the man who will follow after counsel, in all things wherein he employs it?"],["13",[["καὶ",707031,7],["εἶδον",709725,155],["ἐγὼ",704018,164],["ὅτι",709803,7],["ἔστιν",704093,91],["περισσεία",710384,12],["τῇ",709436,100],["σοφίᾳ",711981,1],["ὑπὲρ",713111,0],["τὴν",709436,8],["ἀφροσύνην",702235,9],["ὡς",714148,7],["περισσεία",710384,12],["τοῦ",709436,20],["φωτὸς",713642,21],["ὑπὲρ",713111,0],["τὸ",709436,24],["σκότος",711889,25]],"And I saw that wisdom excels folly, as much as light excels darkness."],["14",[["τοῦ",709436,35],["σοφοῦ",711985,116],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["αὐτοῦ",702165,102],["ἐν",704639,0],["κεφαλῇ",707639,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὁ",709436,3],["ἄφρων",702236,14],["ἐν",704639,0],["σκότει",711889,54],["πορεύεται",710667,117],["καὶ",707031,7],["ἔγνων",703105,155],["καί",707031,7],["γε",702985,11],["ἐγὼ",704018,164],["ὅτι",709803,7],["συνάντημα",712396,15],["ἓν",704106,26],["συναντήσεται",712394,93],["τοῖς",709436,147],["πᾶσιν",710177,230],["αὐτοῖς",702165,151]],"The wise man's eyes are in his head; but the fool walks in darkness: and I perceived, even I, that one event shall happen to them all."],["15",[["καὶ",707031,7],["εἶπα",705373,155],["ἐγὼ",704018,164],["ἐν",704639,0],["καρδίᾳ",707141,1],["μου",709032,133],["ὡς",714148,7],["συνάντημα",712396,15],["τοῦ",709436,35],["ἄφρονος",702236,116],["καί",707031,7],["γε",702985,11],["ἐμοὶ",704577,159],["συναντήσεταί",712394,93],["μοι",708974,159],["καὶ",707031,7],["ἵνα",706747,7],["τί",712867,126],["ἐσοφισάμην",711982,161],["ἐγὼ",704018,164],["τότε",712908,28],["περισσὸν",710387,46],["ἐλάλησα",708071,155],["ἐν",704639,0],["καρδίᾳ",707141,1],["μου",709032,133],["διότι",703734,7],["ἄφρων",702236,14],["ἐκ",704132,0],["περισσεύματος",710385,21],["λαλεῖ",708071,91],["ὅτι",709803,7],["καί",707031,7],["γε",702985,11],["τοῦτο",709858,129],["ματαιότης",708576,12]],"And I said in my heart, As the event of the fool is, so shall it be to me, even to me; and to what purpose have I gained wisdom? I said moreover in my heart, This is also vanity, because the fool speaks of his abundance."],["16",[["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["μνήμη",708964,12],["τοῦ",709436,35],["σοφοῦ",711985,116],["μετὰ",708780,0],["τοῦ",709436,35],["ἄφρονος",702236,116],["εἰς",704105,0],["αἰῶνα",700504,6],["καθότι",707021,7],["ἤδη",705939,28],["αἱ",709436,190],["ἡμέραι",705984,191],["αἱ",709436,190],["ἐρχόμεναι",705453,305],["τὰ",709436,63],["πάντα",710177,195],["ἐπελήσθη",705187,37],["καὶ",707031,7],["πῶς",711121,28],["ἀποθανεῖται",701461,93],["ὁ",709436,3],["σοφὸς",711985,14],["μετὰ",708780,0],["τοῦ",709436,35],["ἄφρονος",702236,116]],"For there is no remembrance of the wise man with the fool for ever; forasmuch as now [in] the coming days all things are forgotten: and how shall the wise man die with the fool?"],["17",[["καὶ",707031,7],["ἐμίσησα",708935,155],["σὺν",712372,0],["τὴν",709436,8],["ζωήν",705910,9],["ὅτι",709803,7],["πονηρὸν",710660,26],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["τὸ",709436,34],["ποίημα",710583,15],["τὸ",709436,34],["πεποιημένον",710582,327],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6],["ὅτι",709803,7],["τὰ",709436,63],["πάντα",710177,195],["ματαιότης",708576,12],["καὶ",707031,7],["προαίρεσις",710751,12],["πνεύματος",710566,21]],"So I hated life; because the work that was wrought under the sun was evil before me: for all is vanity and waywardness of spirit."],["18",[["καὶ",707031,7],["ἐμίσησα",708935,155],["ἐγὼ",704018,164],["σὺν",712372,0],["πάντα",710177,27],["μόχθον",709039,6],["μου",709032,133],["ὃν",709781,112],["ἐγὼ",704018,164],["μοχθῶ",709037,157],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6],["ὅτι",709803,7],["ἀφίω",702211,438],["αὐτὸν",702165,85],["τῷ",709436,113],["ἀνθρώπῳ",701163,114],["τῷ",709436,113],["γινομένῳ",703104,241],["μετ᾿",708780,0],["ἐμέ",704555,163]],"And I hated the whole of my labour which I took under the sun; because I must leave it to the man who will come after me."],["19",[["καὶ",707031,7],["τίς",712867,158],["οἶδεν",709492,171],["εἰ",704071,7],["σοφὸς",711985,14],["ἔσται",704093,93],["ἢ",705924,7],["ἄφρων",702236,14],["καὶ",707031,7],["ἐξουσιάζεται",704975,117],["ἐν",704639,0],["παντὶ",710177,30],["μόχθῳ",709039,114],["μου",709032,133],["ᾧ",709781,309],["ἐμόχθησα",709037,155],["καὶ",707031,7],["ᾧ",709781,309],["ἐσοφισάμην",711982,161],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6],["καί",707031,7],["γε",702985,11],["τοῦτο",709858,132],["ματαιότης",708576,12]],"And who knows whether he will be a wise [man] or a fool? and whether he will have power over all my labour in which I laboured, and wherein I grew wise under the sun? this is also vanity."],["20",[["καὶ",707031,7],["ἐπέστρεψα",705278,155],["ἐγὼ",704018,164],["τοῦ",709436,20],["ἀποτάξασθαι",701608,109],["τῇ",709436,100],["καρδίᾳ",707141,1],["μου",709032,133],["ἐπὶ",705080,0],["παντὶ",710177,30],["τῷ",709436,113],["μόχθῳ",709039,114],["ᾧ",709781,309],["ἐμόχθησα",709037,155],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6]],"So I went about to dismiss from my heart all my labour wherein I had laboured under the sun."],["21",[["ὅτι",709803,7],["ἔστιν",704093,91],["ἄνθρωπος",701163,4],["οὗ",709781,48],["μόχθος",709039,4],["αὐτοῦ",702165,102],["ἐν",704639,0],["σοφίᾳ",711981,1],["καὶ",707031,7],["ἐν",704639,0],["γνώσει",703138,1],["καὶ",707031,7],["ἐν",704639,0],["ἀνδρείᾳ",701101,101],["καὶ",707031,7],["ἄνθρωπος",701163,4],["ὃς",709781,213],["οὐκ",709805,28],["ἐμόχθησεν",709037,2],["ἐν",704639,0],["αὐτῷ",702165,50],["δώσει",703654,127],["αὐτῷ",702165,50],["μερίδα",708748,9],["αὐτοῦ",702165,102],["καί",707031,7],["γε",702985,11],["τοῦτο",709858,132],["ματαιότης",708576,12],["καὶ",707031,7],["πονηρία",710659,12],["μεγάλη",708653,29]],"For there is [such] a man that his labour is in wisdom, and in knowledge, and in fortitude; yet [this] man shall give his portion to one who has not laboured therein. This is also vanity and great evil."],["22",[["ὅτι",709803,7],["τί",712867,273],["γίνεται",703104,117],["τῷ",709436,113],["ἀνθρώπῳ",701163,114],["ἐν",704639,0],["παντὶ",710177,30],["μόχθῳ",709039,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["προαιρέσει",710751,1],["καρδίας",707141,17],["αὐτοῦ",702165,102],["ᾧ",709781,309],["αὐτὸς",702165,121],["μοχθεῖ",709037,91],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6]],"For it happens to a man in all his labour, and in the purpose of his heart wherein he labours under the sun."],["23",[["ὅτι",709803,7],["πᾶσαι",710177,192],["αἱ",709436,190],["ἡμέραι",705984,191],["αὐτοῦ",702165,102],["ἀλγημάτων",700640,44],["καὶ",707031,7],["θυμοῦ",706334,18],["περισπασμὸς",710381,4],["αὐτοῦ",702165,102],["καί",707031,7],["γε",702985,11],["ἐν",704639,0],["νυκτὶ",709386,1],["οὐ",709805,28],["κοιμᾶται",707767,117],["ἡ",709436,10],["καρδία",707141,12],["αὐτοῦ",702165,102],["καί",707031,7],["γε",702985,11],["τοῦτο",709858,132],["ματαιότης",708576,12],["ἐστίν",704093,91]],"For all his days [are days] of sorrows, and vexation of spirit is his; in the night also his heart rests not. This is also vanity."],["24",[["οὐκ",709805,28],["ἔστιν",704093,91],["ἀγαθὸν",700106,26],["ἐν",704639,0],["ἀνθρώπῳ",701163,114],["ὃ",709781,128],["φάγεται",713296,93],["καὶ",707031,7],["ὃ",709781,128],["πίεται",710478,93],["καὶ",707031,7],["ὃ",709781,128],["δείξει",703314,127],["τῇ",709436,100],["ψυχῇ",714070,1],["αὐτοῦ",702165,102],["ἀγαθὸν",700106,26],["ἐν",704639,0],["μόχθῳ",709039,114],["αὐτοῦ",702165,102],["καί",707031,7],["γε",702985,11],["τοῦτο",709858,129],["εἶδον",709725,155],["ἐγὼ",704018,164],["ὅτι",709803,7],["ἀπὸ",701425,0],["χειρὸς",713787,17],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐστιν",704093,91]],"A man has nothing [really] good to eat, and to drink, and to shew his soul [as] good in his trouble. This also I saw, that it is from the hand of God."],["25",[["ὅτι",709803,7],["τίς",712867,158],["φάγεται",713296,93],["καὶ",707031,7],["τίς",712867,158],["φείσεται",713406,93],["πάρεξ",710136,0],["αὐτοῦ",702165,102]],"For who shall eat, or who shall drink, without him?"],["26",[["ὅτι",709803,7],["τῷ",709436,113],["ἀνθρώπῳ",701163,114],["τῷ",709436,113],["ἀγαθῷ",700106,30],["πρὸ",710747,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["ἔδωκεν",703654,2],["σοφίαν",711981,9],["καὶ",707031,7],["γνῶσιν",703138,9],["καὶ",707031,7],["εὐφροσύνην",705717,9],["καὶ",707031,7],["τῷ",709436,113],["ἁμαρτάνοντι",700773,379],["ἔδωκεν",703654,2],["περισπασμὸν",710381,6],["τοῦ",709436,20],["προσθεῖναι",710965,55],["καὶ",707031,7],["τοῦ",709436,20],["συναγαγεῖν",712375,106],["τοῦ",709436,20],["δοῦναι",703654,106],["τῷ",709436,113],["ἀγαθῷ",700106,30],["πρὸ",710747,0],["προσώπου",710986,21],["τοῦ",709436,35],["θεοῦ",706192,18],["ὅτι",709803,7],["καί",707031,7],["γε",702985,11],["τοῦτο",709858,132],["ματαιότης",708576,12],["καὶ",707031,7],["προαίρεσις",710751,12],["πνεύματος",710566,21]],"For [God] has given to the man who is good in his sight, wisdom, and knowledge, and joy: but he has given to the sinner trouble, to add and to heap up, that he may give to him that is good before God; for this is also vanity and waywardness of spirit."]]