[["1",[["ὅτι",709803,7],["σὺν",712372,0],["πᾶν",710177,46],["τοῦτο",709858,129],["ἔδωκα",703654,155],["εἰς",704105,0],["καρδίαν",707141,9],["μου",709032,133],["καὶ",707031,7],["καρδία",707141,12],["μου",709032,133],["σὺν",712372,0],["πᾶν",710177,46],["εἶδεν",709725,2],["τοῦτο",709858,129],["ὡς",714148,7],["οἱ",709436,136],["δίκαιοι",703694,138],["καὶ",707031,7],["οἱ",709436,136],["σοφοὶ",711985,138],["καὶ",707031,7],["ἐργασίαι",705385,191],["αὐτῶν",702165,40],["ἐν",704639,0],["χειρὶ",713787,1],["τοῦ",709436,35],["θεοῦ",706192,18],["καί",707031,7],["γε",702985,11],["ἀγάπην",700122,9],["καί",707031,7],["γε",702985,11],["μῖσος",708947,46],["οὐκ",709805,28],["ἔστιν",704093,91],["εἰδὼς",704075,270],["ὁ",709436,3],["ἄνθρωπος",701163,4],["τὰ",709436,63],["πάντα",710177,195],["πρὸ",710747,0],["προσώπου",710986,21],["αὐτῶν",702165,40]],"[I saw] that the righteous, and the wise, and their works, are in the hand of God: yea, there is no man that knows either love or hatred, [though] all are before their face."],["2",[["ματαιότης",708576,12],["ἐν",704639,0],["τοῖς",709436,147],["πᾶσιν",710177,230],["συνάντημα",712396,15],["ἓν",704106,26],["τῷ",709436,113],["δικαίῳ",703694,30],["καὶ",707031,7],["τῷ",709436,113],["ἀσεβεῖ",701909,30],["τῷ",709436,113],["ἀγαθῷ",700106,30],["καὶ",707031,7],["τῷ",709436,113],["κακῷ",707066,30],["καὶ",707031,7],["τῷ",709436,113],["καθαρῷ",706988,30],["καὶ",707031,7],["τῷ",709436,113],["ἀκαθάρτῳ",700508,30],["καὶ",707031,7],["τῷ",709436,113],["θυσιάζοντι",706346,379],["καὶ",707031,7],["τῷ",709436,113],["μὴ",708851,28],["θυσιάζοντι",706346,379],["ὡς",714148,7],["ὁ",709436,3],["ἀγαθός",700106,14],["ὧς",714148,7],["ὁ",709436,3],["ἁμαρτάνων",700773,72],["ὧς",714148,7],["ὁ",709436,3],["ὀμνύων",709620,72],["καθὼς",707030,28],["ὁ",709436,3],["τὸν",709436,5],["ὅρκον",709753,6],["φοβούμενος",713532,122]],"Vanity is in all: there is one event to the righteous, and to the wicked; to the good, and to the bad; both to the pure, and to the impure; both to him that sacrifices, and to him that sacrifices not: as is the good, so is the sinner: as is the swearer, even so is he that fears an oath."],["3",[["τοῦτο",709858,132],["πονηρὸν",710660,26],["ἐν",704639,0],["παντὶ",710177,30],["πεποιημένῳ",710582,516],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6],["ὅτι",709803,7],["συνάντημα",712396,15],["ἓν",704106,26],["τοῖς",709436,147],["πᾶσιν",710177,230],["καί",707031,7],["γε",702985,11],["καρδία",707141,12],["υἱῶν",713075,81],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["ἐπληρώθη",710543,37],["πονηροῦ",710660,116],["καὶ",707031,7],["περιφέρεια",710408,12],["ἐν",704639,0],["καρδίᾳ",707141,1],["αὐτῶν",702165,40],["ἐν",704639,0],["ζωῇ",705910,1],["αὐτῶν",702165,40],["καὶ",707031,7],["ὀπίσω",709697,28],["αὐτῶν",702165,40],["πρὸς",710844,0],["τοὺς",709436,58],["νεκρούς",709247,57]],"There is this evil in all that is done under the sun, that there is one event to all: yea, the heart of the sons of men is filled with evil, and madness is in their heart during their life, and after that [they go] to the dead."],["4",[["ὅτι",709803,7],["τίς",712867,158],["ὃς",709781,213],["κοινωνεῖ",707775,91],["πρὸς",710844,0],["πάντας",710177,60],["τοὺς",709436,58],["ζῶντας",705851,235],["ἔστιν",704093,91],["ἐλπίς",704530,12],["ὅτι",709803,7],["ὁ",709436,3],["κύων",708004,4],["ὁ",709436,3],["ζῶν",705851,72],["αὐτὸς",702165,121],["ἀγαθὸς",700106,14],["ὑπὲρ",713111,0],["τὸν",709436,5],["λέοντα",708171,6],["τὸν",709436,5],["νεκρόν",709247,6]],"For who is he that has fellowship with all the living? there is hope [of him]: for a living dog is better than a dead lion."],["5",[["ὅτι",709803,7],["οἱ",709436,136],["ζῶντες",705851,146],["γνώσονται",703105,135],["ὅτι",709803,7],["ἀποθανοῦνται",701461,135],["καὶ",707031,7],["οἱ",709436,136],["νεκροὶ",709247,52],["οὔκ",709805,28],["εἰσιν",704093,197],["γινώσκοντες",703105,146],["οὐδέν",709817,46],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["αὐτοῖς",702165,151],["ἔτι",705538,28],["μισθός",708939,4],["ὅτι",709803,7],["ἐπελήσθη",705187,37],["ἡ",709436,10],["μνήμη",708964,12],["αὐτῶν",702165,40]],"For the living will know that they shall die: but the dead know nothing, and there is no longer any reward to them; for their memory is lost."],["6",[["καί",707031,7],["γε",702985,11],["ἀγάπη",700122,12],["αὐτῶν",702165,40],["καί",707031,7],["γε",702985,11],["μῖσος",708947,15],["αὐτῶν",702165,40],["καί",707031,7],["γε",702985,11],["ζῆλος",705871,4],["αὐτῶν",702165,40],["ἤδη",705939,28],["ἀπώλετο",701513,23],["καὶ",707031,7],["μερὶς",708748,12],["οὐκ",709805,28],["ἔστιν",704093,91],["αὐτοῖς",702165,151],["ἔτι",705538,28],["εἰς",704105,0],["αἰῶνα",700504,6],["ἐν",704639,0],["παντὶ",710177,30],["τῷ",709436,113],["πεποιημένῳ",710582,516],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6]],"Also their love, and their hatred, and their envy, have now perished; yea, there is no portion for them any more for ever in all that is done under the sun."],["7",[["δεῦρο",703382,28],["φάγε",713296,176],["ἐν",704639,0],["εὐφροσύνῃ",705717,1],["ἄρτον",701829,6],["σου",711945,133],["καὶ",707031,7],["πίε",710478,176],["ἐν",704639,0],["καρδίᾳ",707141,1],["ἀγαθῇ",700106,101],["οἶνόν",709530,6],["σου",711945,133],["ὅτι",709803,7],["ἤδη",705939,28],["εὐδόκησεν",705565,2],["ὁ",709436,3],["θεὸς",706192,4],["τὰ",709436,41],["ποιήματά",710583,42],["σου",711945,133]],"Go, eat thy bread with mirth, and drink thy wine with a joyful heart; for now God has favourably accepted thy works."],["8",[["ἐν",704639,0],["παντὶ",710177,30],["καιρῷ",707047,114],["ἔστωσαν",704093,56],["ἱμάτιά",706742,64],["σου",711945,133],["λευκά",708165,195],["καὶ",707031,7],["ἔλαιον",704380,15],["ἐπὶ",705080,0],["κεφαλήν",707639,9],["σου",711945,133],["μὴ",708851,28],["ὑστερησάτω",713270,45]],"Let thy garments be always white; and let not oil be wanting on thine head."],["9",[["ἰδὲ",709725,176],["ζωὴν",705910,9],["μετὰ",708780,0],["γυναικός",703209,17],["ἧς",709781,167],["ἠγάπησας",700120,162],["πάσας",710177,119],["ἡμέρας",705984,39],["ζωῆς",705910,17],["ματαιότητός",708576,17],["σου",711945,133],["τὰς",709436,38],["δοθείσας",703654,535],["σοι",711925,159],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6],["πάσας",710177,119],["ἡμέρας",705984,39],["ματαιότητός",708576,17],["σου",711945,133],["ὅτι",709803,7],["αὐτὸ",702165,132],["μερίς",708748,12],["σου",711945,133],["ἐν",704639,0],["τῇ",709436,100],["ζωῇ",705910,1],["σου",711945,133],["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["μόχθῳ",709039,114],["σου",711945,133],["ᾧ",709781,309],["σὺ",712181,164],["μοχθεῖς",709037,154],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6]],"And see life with the wife whom thou lovest all the days of the life of thy vanity, which are given thee under the sun: for that is thy portion in thy life, and in thy labour wherein thou labourest under the sun."],["10",[["πάντα",710177,68],["ὅσα",709788,68],["ἂν",700900,11],["εὕρῃ",705676,172],["ἡ",709436,10],["χείρ",713787,12],["σου",711945,133],["τοῦ",709436,20],["ποιῆσαι",710582,106],["ὡς",714148,7],["ἡ",709436,10],["δύναμίς",703839,12],["σου",711945,133],["ποίησον",710582,176],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ποίημα",710583,15],["καὶ",707031,7],["λογισμὸς",708234,4],["καὶ",707031,7],["γνῶσις",703138,12],["καὶ",707031,7],["σοφία",711981,12],["ἐν",704639,0],["ᾅδῃ",700255,114],["ὅπου",709710,11],["σὺ",712181,164],["πορεύῃ",710667,204],["ἐκεῖ",704181,28]],"Whatsoever thine hand shall find to do, do with all thy might; for there is no work, nor device, nor knowledge, nor wisdom, in Hades whither thou goest."],["11",[["ἐπέστρεψα",705278,155],["καὶ",707031,7],["εἶδον",709725,155],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6],["ὅτι",709803,7],["οὐ",709805,28],["τοῖς",709436,147],["κούφοις",707863,230],["ὁ",709436,3],["δρόμος",703833,4],["καὶ",707031,7],["οὐ",709805,28],["τοῖς",709436,147],["δυνατοῖς",703845,230],["ὁ",709436,3],["πόλεμος",710605,4],["καί",707031,7],["γε",702985,11],["οὐ",709805,28],["τοῖς",709436,147],["σοφοῖς",711985,230],["ἄρτος",701829,4],["καί",707031,7],["γε",702985,11],["οὐ",709805,28],["τοῖς",709436,147],["συνετοῖς",712464,230],["πλοῦτος",710563,4],["καί",707031,7],["γε",702985,11],["οὐ",709805,28],["τοῖς",709436,147],["γινώσκουσιν",703105,197],["χάρις",713735,12],["ὅτι",709803,7],["καιρὸς",707047,4],["καὶ",707031,7],["ἀπάντημα",701347,15],["συναντήσεται",712394,93],["τοῖς",709436,147],["πᾶσιν",710177,230],["αὐτοῖς",702165,151]],"I returned, and saw under the sun, that the race is not to the swift, nor the battle to the strong, nor yet bread to the wise, nor yet wealth to men of understanding, nor yet favour to men of knowledge; for time and chance will happen to them all."],["12",[["ὅτι",709803,7],["καί",707031,7],["γε",702985,11],["οὐκ",709805,28],["ἔγνω",703105,2],["ὁ",709436,3],["ἄνθρωπος",701163,4],["τὸν",709436,5],["καιρὸν",707047,6],["αὐτοῦ",702165,102],["ὡς",714148,7],["οἱ",709436,136],["ἰχθύες",706870,52],["οἱ",709436,136],["θηρευόμενοι",706248,348],["ἐν",704639,0],["ἀμφιβλήστρῳ",700884,54],["κακῷ",707066,30],["καὶ",707031,7],["ὡς",714148,7],["ὄρνεα",709762,64],["τὰ",709436,63],["θηρευόμενα",706248,210],["ἐν",704639,0],["παγίδι",709910,1],["ὡς",714148,7],["αὐτὰ",702165,71],["παγιδεύονται",709909,699],["οἱ",709436,136],["υἱοὶ",713075,52],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["εἰς",704105,0],["καιρὸν",707047,6],["πονηρόν",710660,27],["ὅταν",709801,28],["ἐπιπέσῃ",705225,123],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["ἄφνω",702215,28]],"For surely man also knows not his time: as fishes that are taken in an evil net, and as birds that are caught in a snare; even thus the sons of men are snared at an evil time, when it falls suddenly upon them."],["13",[["καί",707031,7],["γε",702985,11],["τοῦτο",709858,129],["εἶδον",709725,155],["σοφίαν",711981,9],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6],["καὶ",707031,7],["μεγάλη",708653,29],["ἐστὶν",704093,91],["πρός",710844,0],["με",708618,163]],"This I also saw [to be] wisdom under the sun, and it is great before me:"],["14",[["πόλις",710612,12],["μικρὰ",708915,29],["καὶ",707031,7],["ἄνδρες",701150,52],["ἐν",704639,0],["αὐτῇ",702165,105],["ὀλίγοι",709568,138],["καὶ",707031,7],["ἔλθῃ",705453,172],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["βασιλεὺς",702580,4],["μέγας",708653,14],["καὶ",707031,7],["κυκλώσῃ",707958,172],["αὐτὴν",702165,104],["καὶ",707031,7],["οἰκοδομήσῃ",709509,123],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["χάρακας",713729,57],["μεγάλους",708653,60]],"[suppose there were] a little city, and few men in it; and there should come against it a great king, and surround it, and build great mounds against it;"],["15",[["καὶ",707031,7],["εὕρῃ",705676,172],["ἐν",704639,0],["αὐτῇ",702165,105],["ἄνδρα",701150,6],["πένητα",710248,6],["σοφόν",711985,27],["καὶ",707031,7],["διασώσει",703599,127],["αὐτὸς",702165,121],["τὴν",709436,8],["πόλιν",710612,9],["ἐν",704639,0],["τῇ",709436,100],["σοφίᾳ",711981,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἄνθρωπος",701163,4],["οὐκ",709805,28],["ἐμνήσθη",708960,37],["σὺν",712372,0],["τοῦ",709436,35],["ἀνδρὸς",701150,18],["τοῦ",709436,35],["πένητος",710248,18],["ἐκείνου",704183,102]],"and should find in it a poor wise man, and he should save the city through his wisdom: yet no man would remember that poor man."],["16",[["καὶ",707031,7],["εἶπα",705373,155],["ἐγώ",704018,164],["ἀγαθὴ",700106,29],["σοφία",711981,12],["ὑπὲρ",713111,0],["δύναμιν",703839,9],["καὶ",707031,7],["σοφία",711981,12],["τοῦ",709436,35],["πένητος",710248,18],["ἐξουδενωμένη",704969,451],["καὶ",707031,7],["λόγοι",708236,52],["αὐτοῦ",702165,102],["οὔκ",709805,28],["εἰσιν",704093,197],["ἀκουόμενοι",700587,348]],"And I said, Wisdom is better than power: yet the wisdom of the poor man is set at nought, and his words not listened to."],["17",[["λόγοι",708236,52],["σοφῶν",711985,169],["ἐν",704639,0],["ἀναπαύσει",701026,1],["ἀκούονται",700587,269],["ὑπὲρ",713111,0],["κραυγὴν",707886,9],["ἐξουσιαζόντων",704975,170],["ἐν",704639,0],["ἀφροσύναις",702235,76]],"The words of the wise are heard in quiet more than the cry of them that rule in folly."],["18",[["ἀγαθὴ",700106,29],["σοφία",711981,12],["ὑπὲρ",713111,0],["σκεύη",711844,42],["πολέμου",710605,18],["καὶ",707031,7],["ἁμαρτάνων",700773,72],["εἷς",704106,596],["ἀπολέσει",701513,127],["ἀγαθωσύνην",700111,9],["πολλήν",710646,36]],"Wisdom is better than weapons of war: and one sinner will destroy much good."]]