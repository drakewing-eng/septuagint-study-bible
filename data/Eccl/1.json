[["1",[["ῥήματα",711246,64],["Ἐκκλησιαστοῦ",704218,18],["υἱοῦ",713075,18],["Δαυιδ",703232,18],["βασιλέως",702580,18],["Ισραηλ",706839,18],["ἐν",704639,0],["Ιερουσαλημ",706644,1]],"The words of the Preacher, the son of David, king of Israel in Jerusalem."],["2",[["ματαιότης",708576,12],["ματαιοτήτων",708576,65],["εἶπεν",705373,2],["ὁ",709436,3],["Ἐκκλησιαστής",704218,4],["ματαιότης",708576,4],["ματαιοτήτων",708576,65],["τὰ",709436,63],["πάντα",710177,195],["ματαιότης",708576,12]],"Vanity of vanities, said the Preacher, vanity of vanities; all is vanity."],["3",[["τίς",712867,359],["περισσεία",710384,12],["τῷ",709436,113],["ἀνθρώπῳ",701163,114],["ἐν",704639,0],["παντὶ",710177,30],["μόχθῳ",709039,114],["αὐτοῦ",702165,102],["ᾧ",709781,309],["μοχθεῖ",709037,91],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6]],"What advantage [is there] to a man in all his labour that he takes under the sun?"],["4",[["γενεὰ",703037,12],["πορεύεται",710667,117],["καὶ",707031,7],["γενεὰ",703037,12],["ἔρχεται",705453,117],["καὶ",707031,7],["ἡ",709436,10],["γῆ",703083,12],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἕστηκεν",706846,171]],"A generation goes, and a generation comes: but the earth stands for ever."],["5",[["καὶ",707031,7],["ἀνατέλλει",701066,91],["ὁ",709436,3],["ἥλιος",705974,4],["καὶ",707031,7],["δύνει",703848,91],["ὁ",709436,3],["ἥλιος",705974,4],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["τόπον",712903,6],["αὐτοῦ",702165,102],["ἕλκει",704508,91]],"And the sun arises, and the sun goes down and draws toward its place;"],["6",[["ἀνατέλλων",701066,72],["αὐτὸς",702165,121],["ἐκεῖ",704181,28],["πορεύεται",710667,117],["πρὸς",710844,0],["νότον",709364,6],["καὶ",707031,7],["κυκλοῖ",707958,91],["πρὸς",710844,0],["βορρᾶν",702765,6],["κυκλοῖ",707958,91],["κυκλῶν",707957,81],["πορεύεται",710667,117],["τὸ",709436,34],["πνεῦμα",710566,15],["καὶ",707031,7],["ἐπὶ",705080,0],["κύκλους",707957,57],["αὐτοῦ",702165,102],["ἐπιστρέφει",705278,91],["τὸ",709436,34],["πνεῦμα",710566,15]],"arising there it proceeds southward, and goes round toward the north. The wind goes round and round, and the wind returns to its circuits."],["7",[["πάντες",710177,138],["οἱ",709436,136],["χείμαρροι",713783,52],["πορεύονται",710667,269],["εἰς",704105,0],["τὴν",709436,8],["θάλασσαν",706069,9],["καὶ",707031,7],["ἡ",709436,10],["θάλασσα",706069,12],["οὐκ",709805,28],["ἔσται",704093,93],["ἐμπιμπλαμένη",704592,211],["εἰς",704105,0],["τόπον",712903,6],["οὗ",709781,48],["οἱ",709436,136],["χείμαρροι",713783,52],["πορεύονται",710667,269],["ἐκεῖ",704181,28],["αὐτοὶ",702165,201],["ἐπιστρέφουσιν",705278,197],["τοῦ",709436,20],["πορευθῆναι",710667,179]],"All the rivers run into the sea; and yet the sea is not filled: to the place whence the rivers come, thither they return again."],["8",[["πάντες",710177,138],["οἱ",709436,136],["λόγοι",708236,52],["ἔγκοποι",703983,138],["οὐ",709805,28],["δυνήσεται",703838,93],["ἀνὴρ",701150,4],["τοῦ",709436,20],["λαλεῖν",708071,55],["καὶ",707031,7],["οὐκ",709805,28],["ἐμπλησθήσεται",704592,134],["ὀφθαλμὸς",709870,4],["τοῦ",709436,20],["ὁρᾶν",709725,55],["καὶ",707031,7],["οὐ",709805,28],["πληρωθήσεται",710543,134],["οὖς",709852,15],["ἀπὸ",701425,0],["ἀκροάσεως",700603,17]],"All things are full of labour; a man will not be able to speak [of them]: neither shall the eye be satisfied with seeing, neither shall the ear be filled with hearing."],["9",[["τί",712867,273],["τὸ",709436,34],["γεγονός",703104,426],["αὐτὸ",702165,132],["τὸ",709436,34],["γενησόμενον",703104,741],["καὶ",707031,7],["τί",712867,273],["τὸ",709436,34],["πεποιημένον",710582,413],["αὐτὸ",702165,132],["τὸ",709436,34],["ποιηθησόμενον",710582,742],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["πᾶν",710177,26],["πρόσφατον",710972,26],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6]],"What is that which has been? the very thing which shall be: and what is that which has been done? the very thing which shall be done: and there is no new thing under the sun."],["10",[["ὃς",709781,213],["λαλήσει",708071,127],["καὶ",707031,7],["ἐρεῖ",705415,127],["ἰδὲ",709725,176],["τοῦτο",709858,132],["καινόν",707042,26],["ἐστιν",704093,91],["ἤδη",705939,28],["γέγονεν",703104,171],["ἐν",704639,0],["τοῖς",709436,147],["αἰῶσιν",700504,148],["τοῖς",709436,147],["γενομένοις",703104,615],["ἀπὸ",701425,0],["ἔμπροσθεν",704618,0],["ἡμῶν",705999,145]],"[Who is he] that shall speak and say, Behold, this is new? it has already been in the ages that have passed before us."],["11",[["οὐκ",709805,28],["ἔστιν",704093,91],["μνήμη",708964,12],["τοῖς",709436,147],["πρώτοις",711041,343],["καί",707031,7],["γε",702985,11],["τοῖς",709436,147],["ἐσχάτοις",705519,230],["γενομένοις",703104,615],["οὐκ",709805,28],["ἔσται",704093,93],["αὐτοῖς",702165,151],["μνήμη",708964,12],["μετὰ",708780,0],["τῶν",709436,43],["γενησομένων",703104,743],["εἰς",704105,0],["τὴν",709436,8],["ἐσχάτην",705519,36]],"There is no memorial to the first things; neither to the things that have been last shall their memorial be with them that shall be at the last [time]."],["12",[["ἐγὼ",704018,164],["Ἐκκλησιαστὴς",704218,4],["ἐγενόμην",703104,161],["βασιλεὺς",702580,4],["ἐπὶ",705080,0],["Ισραηλ",706839,6],["ἐν",704639,0],["Ιερουσαλημ",706644,1]],"I the Preacher was king over Israel in Jerusalem."],["13",[["καὶ",707031,7],["ἔδωκα",703654,155],["τὴν",709436,8],["καρδίαν",707141,9],["μου",709032,133],["τοῦ",709436,20],["ἐκζητῆσαι",704187,106],["καὶ",707031,7],["τοῦ",709436,20],["κατασκέψασθαι",707418,109],["ἐν",704639,0],["τῇ",709436,100],["σοφίᾳ",711981,1],["περὶ",710285,0],["πάντων",710177,169],["τῶν",709436,80],["γινομένων",703104,299],["ὑπὸ",713184,0],["τὸν",709436,5],["οὐρανόν",709844,6],["ὅτι",709803,7],["περισπασμὸν",710381,6],["πονηρὸν",710660,27],["ἔδωκεν",703654,2],["ὁ",709436,3],["θεὸς",706192,4],["τοῖς",709436,147],["υἱοῖς",713075,148],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["τοῦ",709436,20],["περισπᾶσθαι",710382,110],["ἐν",704639,0],["αὐτῷ",702165,50]],"And I applied my heart to seek out and examine by wisdom concerning all things that are done under heaven, for God has given to the sons of men an evil trouble to be troubled therewith."],["14",[["εἶδον",709725,155],["σὺν",712372,0],["πάντα",710177,68],["τὰ",709436,41],["ποιήματα",710583,42],["τὰ",709436,41],["πεποιημένα",710582,388],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6],["καὶ",707031,7],["ἰδοὺ",706497,88],["τὰ",709436,63],["πάντα",710177,195],["ματαιότης",708576,12],["καὶ",707031,7],["προαίρεσις",710751,12],["πνεύματος",710566,21]],"I beheld all the works that were wrought under the sun; and, behold, all were vanity and waywardness of spirit."],["15",[["διεστραμμένον",703592,439],["οὐ",709805,28],["δυνήσεται",703838,93],["τοῦ",709436,20],["ἐπικοσμηθῆναι",705171,179],["καὶ",707031,7],["ὑστέρημα",713271,15],["οὐ",709805,28],["δυνήσεται",703838,93],["τοῦ",709436,20],["ἀριθμηθῆναι",701742,179]],"That which is crooked cannot be made straight: and deficiency cannot be numbered."],["16",[["ἐλάλησα",708071,155],["ἐγὼ",704018,164],["ἐν",704639,0],["καρδίᾳ",707141,1],["μου",709032,133],["τῷ",709436,113],["λέγειν",708124,55],["ἐγὼ",704018,164],["ἰδοὺ",706497,88],["ἐμεγαλύνθην",708647,156],["καὶ",707031,7],["προσέθηκα",710965,155],["σοφίαν",711981,9],["ἐπὶ",705080,0],["πᾶσιν",710177,230],["οἳ",709781,250],["ἐγένοντο",703104,189],["ἔμπροσθέν",704618,0],["μου",709032,133],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["καρδία",707141,12],["μου",709032,133],["εἶδεν",709725,2],["πολλά",710646,68],["σοφίαν",711981,9],["καὶ",707031,7],["γνῶσιν",703138,9]],"I spoke in my heart, saying, Behold, I am increased, and have acquired wisdom beyond all who were before me in Jerusalem: also I applied my heart to know wisdom and knowledge."],["17",[["καὶ",707031,7],["ἔδωκα",703654,155],["καρδίαν",707141,9],["μου",709032,133],["τοῦ",709436,20],["γνῶναι",703105,106],["σοφίαν",711981,9],["καὶ",707031,7],["γνῶσιν",703138,9],["παραβολὰς",710003,39],["καὶ",707031,7],["ἐπιστήμην",705267,9],["ἔγνων",703105,155],["ὅτι",709803,7],["καί",707031,28],["γε",702985,11],["τοῦτ᾿",709858,132],["ἔστιν",704093,91],["προαίρεσις",710751,12],["πνεύματος",710566,21]],"And my heart knew much—wisdom, and knowledge, parables and understanding: I perceived that this also is waywardness of spirit."],["18",[["ὅτι",709803,7],["ἐν",704639,0],["πλήθει",710529,54],["σοφίας",711981,17],["πλῆθος",710529,25],["γνώσεως",703138,17],["καὶ",707031,7],["ὁ",709436,3],["προστιθεὶς",710965,72],["γνῶσιν",703138,9],["προσθήσει",710965,127],["ἄλγημα",700640,25]],"For in the abundance of wisdom is abundance of knowledge; and he that increases knowledge will increase sorrow."]]