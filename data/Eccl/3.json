[["1",[["τοῖς",709436,147],["πᾶσιν",710177,230],["χρόνος",713969,4],["καὶ",707031,7],["καιρὸς",707047,4],["τῷ",709436,113],["παντὶ",710177,97],["πράγματι",710708,54],["ὑπὸ",713184,0],["τὸν",709436,5],["οὐρανόν",709844,6]],"To all things there is a time, and a season for every matter under heaven."],["2",[["καιρὸς",707047,4],["τοῦ",709436,20],["τεκεῖν",712853,106],["καὶ",707031,7],["καιρὸς",707047,4],["τοῦ",709436,20],["ἀποθανεῖν",701461,106],["καιρὸς",707047,4],["τοῦ",709436,20],["φυτεῦσαι",713636,106],["καὶ",707031,7],["καιρὸς",707047,4],["τοῦ",709436,20],["ἐκτῖλαι",704332,106],["πεφυτευμένον",713636,448]],"A time of birth, and a time to die; a time to plant, and a time to pluck up what has been planted;"],["3",[["καιρὸς",707047,4],["τοῦ",709436,20],["ἀποκτεῖναι",701498,106],["καὶ",707031,7],["καιρὸς",707047,4],["τοῦ",709436,20],["ἰάσασθαι",706424,109],["καιρὸς",707047,4],["τοῦ",709436,20],["καθελεῖν",706982,106],["καὶ",707031,7],["καιρὸς",707047,4],["τοῦ",709436,20],["οἰκοδομῆσαι",709509,106]],"a time to kill, and a time to heal; a time to pull down, and a time to build up;"],["4",[["καιρὸς",707047,4],["τοῦ",709436,20],["κλαῦσαι",707703,106],["καὶ",707031,7],["καιρὸς",707047,4],["τοῦ",709436,20],["γελάσαι",703019,106],["καιρὸς",707047,4],["τοῦ",709436,20],["κόψασθαι",707829,109],["καὶ",707031,7],["καιρὸς",707047,4],["τοῦ",709436,20],["ὀρχήσασθαι",709780,109]],"a time to weep, and a time to laugh; a time to lament, and a time to dance;"],["5",[["καιρὸς",707047,4],["τοῦ",709436,20],["βαλεῖν",702487,106],["λίθους",708196,57],["καὶ",707031,7],["καιρὸς",707047,4],["τοῦ",709436,20],["συναγαγεῖν",712375,106],["λίθους",708196,57],["καιρὸς",707047,4],["τοῦ",709436,20],["περιλαβεῖν",710342,106],["καὶ",707031,7],["καιρὸς",707047,4],["τοῦ",709436,35],["μακρυνθῆναι",708428,179],["ἀπὸ",701425,0],["περιλήμψεως",710344,17]],"a time to throw stones, and a time to gather stones together; a time to embrace, and a time to abstain from embracing;"],["6",[["καιρὸς",707047,4],["τοῦ",709436,20],["ζητῆσαι",705879,106],["καὶ",707031,7],["καιρὸς",707047,4],["τοῦ",709436,20],["ἀπολέσαι",701513,106],["καιρὸς",707047,4],["τοῦ",709436,20],["φυλάξαι",713619,106],["καὶ",707031,7],["καιρὸς",707047,4],["τοῦ",709436,20],["ἐκβαλεῖν",704145,106]],"a time to seek, and a time to lose; a time to keep, and a time to cast away;"],["7",[["καιρὸς",707047,4],["τοῦ",709436,20],["ῥῆξαι",711243,106],["καὶ",707031,7],["καιρὸς",707047,4],["τοῦ",709436,20],["ῥάψαι",711185,106],["καιρὸς",707047,4],["τοῦ",709436,20],["σιγᾶν",711767,55],["καὶ",707031,7],["καιρὸς",707047,4],["τοῦ",709436,20],["λαλεῖν",708071,55]],"a time to rend, and a time to sew; a time to be silent, and a time to speak;"],["8",[["καιρὸς",707047,4],["τοῦ",709436,20],["φιλῆσαι",713471,106],["καὶ",707031,7],["καιρὸς",707047,4],["τοῦ",709436,20],["μισῆσαι",708935,106],["καιρὸς",707047,4],["πολέμου",710605,18],["καὶ",707031,7],["καιρὸς",707047,4],["εἰρήνης",704098,17]],"a time to love, and a time to hate; a time of war, and a time of peace."],["9",[["τίς",712867,359],["περισσεία",710384,12],["τοῦ",709436,35],["ποιοῦντος",710582,152],["ἐν",704639,0],["οἷς",709781,311],["αὐτὸς",702165,121],["μοχθεῖ",709037,91]],"What advantage [has] he that works in those things wherein he labours?"],["10",[["εἶδον",709725,155],["σὺν",712372,0],["τὸν",709436,5],["περισπασμόν",710381,6],["ὃν",709781,112],["ἔδωκεν",703654,2],["ὁ",709436,3],["θεὸς",706192,4],["τοῖς",709436,147],["υἱοῖς",713075,148],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["τοῦ",709436,20],["περισπᾶσθαι",710382,110],["ἐν",704639,0],["αὐτῷ",702165,50]],"I have seen all the trouble, which God has given to the sons of men to be troubled with."],["11",[["σὺν",712372,0],["τὰ",709436,41],["πάντα",710177,68],["ἐποίησεν",710582,2],["καλὰ",707097,68],["ἐν",704639,0],["καιρῷ",707047,114],["αὐτοῦ",702165,102],["καί",707031,7],["γε",702985,11],["σὺν",712372,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἔδωκεν",703654,2],["ἐν",704639,0],["καρδίᾳ",707141,1],["αὐτῶν",702165,40],["ὅπως",709719,7],["μὴ",708851,28],["εὕρῃ",705676,172],["ὁ",709436,3],["ἄνθρωπος",701163,4],["τὸ",709436,24],["ποίημα",710583,25],["ὃ",709781,128],["ἐποίησεν",710582,2],["ὁ",709436,3],["θεός",706192,4],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["καὶ",707031,7],["μέχρι",708849,0],["τέλους",712787,21]],"All the things which he has made are beautiful in his time: he has also set the whole world in their heart, that man might not find out the work which God has wrought from the beginning even to the end."],["12",[["ἔγνων",703105,155],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀγαθὸν",700106,27],["ἐν",704639,0],["αὐτοῖς",702165,151],["εἰ",704071,7],["μὴ",708851,28],["τοῦ",709436,20],["εὐφρανθῆναι",705715,179],["καὶ",707031,7],["τοῦ",709436,20],["ποιεῖν",710582,55],["ἀγαθὸν",700106,27],["ἐν",704639,0],["ζωῇ",705910,1],["αὐτοῦ",702165,102]],"I know that there is no good in them, except [for a man] to rejoice, and to do good in his life."],["13",[["καί",707031,7],["γε",702985,11],["πᾶς",710177,14],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ὃς",709781,213],["φάγεται",713296,93],["καὶ",707031,7],["πίεται",710478,93],["καὶ",707031,7],["ἴδῃ",709725,172],["ἀγαθὸν",700106,46],["ἐν",704639,0],["παντὶ",710177,30],["μόχθῳ",709039,114],["αὐτοῦ",702165,102],["δόμα",703789,15],["θεοῦ",706192,18],["ἐστιν",704093,91]],"Also [in the case of] every man who shall eat and drink, and see good in all his labour, [this] is a gift of God."],["14",[["ἔγνων",703105,155],["ὅτι",709803,7],["πάντα",710177,195],["ὅσα",709788,68],["ἐποίησεν",710582,2],["ὁ",709436,3],["θεός",706192,4],["αὐτὰ",702165,290],["ἔσται",704093,93],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["οὐκ",709805,28],["ἔστιν",704093,91],["προσθεῖναι",710965,55],["καὶ",707031,7],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀφελεῖν",702177,106],["καὶ",707031,7],["ὁ",709436,3],["θεὸς",706192,4],["ἐποίησεν",710582,2],["ἵνα",706747,7],["φοβηθῶσιν",713532,272],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102]],"I know that whatsoever things God has done, they shall be for ever: it is impossible to add to it, and it is impossible to take away from it: and God has done [it], that [men] may fear before him."],["15",[["τὸ",709436,34],["γενόμενον",703104,745],["ἤδη",705939,28],["ἐστίν",704093,91],["καὶ",707031,7],["ὅσα",709788,195],["τοῦ",709436,20],["γίνεσθαι",703104,110],["ἤδη",705939,28],["γέγονεν",703104,171],["καὶ",707031,7],["ὁ",709436,3],["θεὸς",706192,4],["ζητήσει",705880,1],["τὸν",709436,5],["διωκόμενον",703768,212]],"That which has been is now; and whatever things [are appointed] to be have already been; and God will seek out that which is past."],["16",[["καὶ",707031,7],["ἔτι",705538,28],["εἶδον",709725,155],["ὑπὸ",713184,0],["τὸν",709436,5],["ἥλιον",705974,6],["τόπον",712903,6],["τῆς",709436,16],["κρίσεως",707908,17],["ἐκεῖ",704181,28],["ὁ",709436,3],["ἀσεβής",701909,14],["καὶ",707031,7],["τόπον",712903,6],["τοῦ",709436,35],["δικαίου",703694,116],["ἐκεῖ",704181,28],["ὁ",709436,3],["ἀσεβής",701909,14]],"And moreover I saw under the sun the place of judgment, there was the ungodly one; and the place of righteousness, there was the godly one."],["17",[["εἶπα",705373,155],["ἐγὼ",704018,164],["ἐν",704639,0],["καρδίᾳ",707141,1],["μου",709032,133],["σὺν",712372,0],["τὸν",709436,5],["δίκαιον",703694,27],["καὶ",707031,7],["σὺν",712372,0],["τὸν",709436,24],["ἀσεβῆ",701909,46],["κρινεῖ",707905,127],["ὁ",709436,3],["θεός",706192,4],["ὅτι",709803,7],["καιρὸς",707047,4],["τῷ",709436,53],["παντὶ",710177,97],["πράγματι",710708,54],["καὶ",707031,7],["ἐπὶ",705080,0],["παντὶ",710177,97],["τῷ",709436,53],["ποιήματι",710583,54]],"And I said in my heart, God will judge the righteous and the ungodly: for there is a time there for every action and for every work."],["18",[["ἐκεῖ",704181,28],["εἶπα",705373,155],["ἐγὼ",704018,164],["ἐν",704639,0],["καρδίᾳ",707141,1],["μου",709032,133],["περὶ",710285,0],["λαλιᾶς",708074,17],["υἱῶν",713075,81],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["ὅτι",709803,7],["διακρινεῖ",703488,127],["αὐτοὺς",702165,62],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["τοῦ",709436,20],["δεῖξαι",703314,106],["ὅτι",709803,7],["αὐτοὶ",702165,201],["κτήνη",707934,64],["εἰσὶν",704093,197],["καί",707031,7],["γε",702985,11],["αὐτοῖς",702165,151]],"I said in my heart, concerning the speech of the sons of man, God will judge them, and that to shew that they are beasts."],["19",[["ὅτι",709803,7],["συνάντημα",712396,4],["υἱῶν",713075,81],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["καὶ",707031,7],["συνάντημα",712396,15],["τοῦ",709436,20],["κτήνους",707934,21],["συνάντημα",712396,15],["ἓν",704106,26],["αὐτοῖς",702165,151],["ὡς",714148,7],["ὁ",709436,3],["θάνατος",706096,4],["τούτου",709858,102],["οὕτως",709859,28],["ὁ",709436,3],["θάνατος",706096,4],["τούτου",709858,102],["καὶ",707031,7],["πνεῦμα",710566,15],["ἓν",704106,26],["τοῖς",709436,147],["πᾶσιν",710177,230],["καὶ",707031,7],["τί",712867,126],["ἐπερίσσευσεν",710386,2],["ὁ",709436,3],["ἄνθρωπος",701163,4],["παρὰ",709995,0],["τὸ",709436,24],["κτῆνος",707934,25],["οὐδέν",709817,46],["ὅτι",709803,7],["τὰ",709436,63],["πάντα",710177,195],["ματαιότης",708576,12]],"Also to them is the event of the sons of man, and the event of the brute; one event befalls them: as is the death of the one, so also the death of the other; and there is one breath to all: and what has the man more than the brute? nothing; for all is vanity."],["20",[["τὰ",709436,63],["πάντα",710177,195],["πορεύεται",710667,117],["εἰς",704105,0],["τόπον",712903,6],["ἕνα",704106,27],["τὰ",709436,63],["πάντα",710177,195],["ἐγένετο",703104,23],["ἀπὸ",701425,0],["τοῦ",709436,35],["χοός",713930,18],["καὶ",707031,7],["τὰ",709436,63],["πάντα",710177,195],["ἐπιστρέφει",705278,91],["εἰς",704105,0],["τὸν",709436,5],["χοῦν",713930,6]],"All [go] to one place; all were formed of the dust, and all will return to dust."],["21",[["καὶ",707031,7],["τίς",712867,158],["οἶδεν",709492,171],["πνεῦμα",710566,25],["υἱῶν",713075,81],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["εἰ",704071,7],["ἀναβαίνει",700905,91],["αὐτὸ",702165,129],["εἰς",704105,0],["ἄνω",701296,28],["καὶ",707031,7],["πνεῦμα",710566,25],["τοῦ",709436,20],["κτήνους",707934,21],["εἰ",704071,7],["καταβαίνει",707202,91],["αὐτὸ",702165,129],["κάτω",707557,28],["εἰς",704105,0],["γῆν",703083,9]],"And who has seen the spirit of the sons of man, whether it goes upward? and the spirit of the beast, whether it goes downward to the earth?"],["22",[["καὶ",707031,7],["εἶδον",709725,155],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀγαθὸν",700106,26],["εἰ",704071,7],["μὴ",708851,28],["ὃ",709781,213],["εὐφρανθήσεται",705715,134],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ἐν",704639,0],["ποιήμασιν",710583,96],["αὐτοῦ",702165,102],["ὅτι",709803,7],["αὐτὸ",702165,132],["μερὶς",708748,12],["αὐτοῦ",702165,102],["ὅτι",709803,7],["τίς",712867,158],["ἄξει",700209,127],["αὐτὸν",702165,85],["τοῦ",709436,20],["ἰδεῖν",709725,106],["ἐν",704639,0],["ᾧ",709781,209],["ἐὰν",703912,7],["γένηται",703104,239],["μετ᾿",708780,0],["αὐτόν",702165,85]],"And I saw that there was no good, but that wherein a man shall rejoice in his works, for it is his portion, for who shall bring him to see any thing of that which shall be after him?"]]