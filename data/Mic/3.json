[["1",[["καὶ",707031,7],["ἐρεῖ",705415,127],["ἀκούσατε",700587,74],["δὴ",703395,11],["ταῦτα",709858,71],["αἱ",709436,190],["ἀρχαὶ",701836,191],["οἴκου",709516,18],["Ιακωβ",706401,18],["καὶ",707031,7],["οἱ",709436,136],["κατάλοιποι",707317,138],["οἴκου",709516,18],["Ισραηλ",706839,18],["οὐχ",709805,28],["ὑμῖν",713084,90],["ἐστιν",704093,91],["τοῦ",709436,20],["γνῶναι",703105,106],["τὸ",709436,24],["κρίμα",707903,25]],"And he shall say, Hear now these words, ye heads of the house of Jacob, and ye remnant of the house of Israel; is it not for you to know judgment?"],["2",[["οἱ",709436,136],["μισοῦντες",708935,146],["τὰ",709436,41],["καλὰ",707097,68],["καὶ",707031,7],["ζητοῦντες",705879,146],["τὰ",709436,41],["πονηρά",710660,68],["ἁρπάζοντες",701804,146],["τὰ",709436,41],["δέρματα",703363,42],["αὐτῶν",702165,40],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰς",709436,38],["σάρκας",711537,39],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["τῶν",709436,43],["ὀστέων",709792,44],["αὐτῶν",702165,40]],"[who] hate good, and seek evil; [who] tear their skins off them, and their flesh off their bones:"],["3",[["ὃν",709781,112],["τρόπον",712980,6],["κατέφαγον",707519,150],["τὰς",709436,38],["σάρκας",711537,39],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133],["καὶ",707031,7],["τὰ",709436,41],["δέρματα",703363,42],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["τῶν",709436,43],["ὀστέων",709792,44],["αὐτῶν",702165,40],["ἐξέδειραν",704164,150],["καὶ",707031,7],["τὰ",709436,41],["ὀστέα",709792,42],["αὐτῶν",702165,40],["συνέθλασαν",712479,150],["καὶ",707031,7],["ἐμέλισαν",708701,150],["ὡς",714148,7],["σάρκας",711537,39],["εἰς",704105,0],["λέβητα",708121,6],["καὶ",707031,7],["ὡς",714148,7],["κρέα",707889,42],["εἰς",704105,0],["χύτραν",713989,9]],"even as they devoured the flesh of my people, and stripped their skins off them, and broke their bones, and divided [them] as flesh for the caldron, and as meat for the pot,"],["4",[["οὕτως",709859,28],["κεκράξονται",707868,135],["πρὸς",71084