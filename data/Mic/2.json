[["1",[["ἐγένοντο",703104,189],["λογιζόμενοι",708232,348],["κόπους",707825,57],["καὶ",707031,7],["ἐργαζόμενοι",705383,348],["κακὰ",707066,68],["ἐν",704639,0],["ταῖς",709436,75],["κοίταις",707781,76],["αὐτῶν",702165,40],["καὶ",707031,7],["ἅμα",700745,28],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["συνετέλουν",712510,137],["αὐτά",702165,71],["διότι",703734,7],["οὐκ",709805,28],["ἦραν",700473,150],["πρὸς",710844,0],["τὸν",709436,5],["θεὸν",706192,6],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτῶν",702165,40]],"They meditated troubles, and wrought wickedness on their beds, and they put it in execution with the daylight; for they have not lifted up their hands to God."],["2",[["καὶ",707031,7],["ἐπεθύμουν",705141,137],["ἀγροὺς",700196,57],["καὶ",707031,7],["διήρπαζον",703562,137],["ὀρφανοὺς",709779,60],["καὶ",707031,7],["οἴκους",709516,57],["κατεδυνάστευον",707248,137],["καὶ",707031,7],["διήρπαζον",703562,137],["ἄνδρα",701150,6],["καὶ",707031,7],["τὸν",709436,5],["οἶκον",709516,6],["αὐτοῦ",702165,102],["ἄνδρα",701150,6],["καὶ",707031,7],["τὴν",709436,8],["κληρονομίαν",707725,9],["αὐτοῦ",702165,102]],"And they desired fields, and plundered orphans, and oppressed families, and spoiled a man and his house, even a man and his inheritance."],["3",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["λογίζομαι",708232,254],["ἐπὶ",705080,0],["τὴν",709436,8],["φυλὴν",713620,9],["ταύτην",709858,104],["κακά",707066,68],["ἐξ",704132,0],["ὧν",709781,252],["οὐ",709805,28],["μὴ",708851,28],["ἄρητε",700473,125],["τοὺς",709436,58],["τραχήλους",712924,57],["ὑμῶν",713091,145],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["πορευθῆτε",710667,394],["ὀρθοὶ",709738,138],["ἐξαίφνης",704842,28],["ὅτι",709803,7],["καιρὸς",707047,4],["πονηρός",710660,14],["ἐστιν",704093,91]],"Therefore thus saith the Lord; Behold, I devise evils against this family, out of which ye shall not lift up your necks, neither shall ye walk