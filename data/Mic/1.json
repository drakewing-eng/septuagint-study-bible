[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["λόγος",708236,4],["κυρίου",707996,18],["πρὸς",710844,0],["Μιχαιαν",708955,6],["τὸν",709436,5],["τοῦ",709436,35],["Μωρασθι",709106,18],["ἐν",704639,0],["ἡμέραις",705984,76],["Ιωαθαμ",706885,18],["καὶ",707031,7],["Αχαζ",702245,18],["καὶ",707031,7],["Εζεκιου",704044,18],["βασιλέων",702580,81],["Ιουδα",706768,18],["ὑπὲρ",713111,0],["ὧν",709781,252],["εἶδεν",709725,2],["περὶ",710285,0],["Σαμαρείας",711449,17],["καὶ",707031,7],["περὶ",710285,0],["Ιερουσαλημ",706644,17]],"And the word of the Lord came to Michæas the son of Morasthi, in the days of Joatham, and Achaz, and Ezekias, kings of Juda, concerning what he saw regarding Samaria and Jerusalem."],["2",[["ἀκούσατε",700587,74],["λαοί",708094,274],["λόγους",708236,57],["καὶ",707031,7],["προσεχέτω",710895,31],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["ἐν",704639,0],["αὐτῇ",702165,105],["καὶ",707031,7],["ἔσται",704093,93],["κύριος",707996,4],["ἐν",704639,0],["ὑμῖν",713084,90],["εἰς",704105,0],["μαρτύριον",708525,25],["κύριος",707996,4],["ἐξ",704132,0],["οἴκου",709516,18],["ἁγίου",700159,116],["αὐτοῦ",702165,102]],"Hear [these] words, ye people; and let the earth give heed, and all that are in it: and the Lord God shall be among you for a testimony, the Lord out of his holy habitation."],["3",[["διότι",703734,7],["ἰδοὺ",706497,88],["κύριος",707996,4],["ἐκπορεύεται",704293,117],["ἐκ",704132,0],["τοῦ",709436,35],["τόπου",712903,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["καταβήσεται",707202,93],["καὶ",707031,7],["ἐπιβήσεται",705082,93],["ἐπὶ",705080,0],["τὰ",709436,41],["ὕψη",713288,42],["τῆς",709436,16],["γῆς",703083,17]],"For, behold, the Lord comes forth out of his place, and will come down, and will go upon the high places of the earth."],["4",[["καὶ",707031,7],["σαλευθήσεται",711403,134],["τὰ",709436,63],["ὄρη",709768,64],["ὑποκάτωθεν",713205,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["αἱ",709436,190],["κοιλάδες",707758,191],["τακήσονται",712839,135],["ὡς",714148,7],["κηρὸς",707659,4],["ἀπὸ",701425,0],["προσώπου",710986,21],["πυρὸς",711088,21],["καὶ",707031,7],["ὡς",714148,7],["ὕδωρ",713071,15],["καταφερόμενον",707471,644],["ἐν",704639,0],["καταβάσει",707206,1]],"And the mountains shall be shaken under him, and the valleys shall melt like wax before the fire, and as water rushing down a declivity."],["5",[["διὰ",703417,0],["ἀσέβειαν",701904,9],["Ιακωβ",706401,18],["πάντα",710177,195],["ταῦτα",709858,290],["καὶ",707031,7],["διὰ",703417,0],["ἁμαρτίαν",700775,9],["οἴκου",709516,18],["Ισραηλ",706839,18],["τίς",712867,359],["ἡ",709436,10],["ἀσέβεια",701904,12],["τοῦ",709436,35],["Ιακωβ",706401,18],["οὐ",709805,28],["Σαμάρεια",711449,12],["καὶ",707031,7],["τίς",712867,359],["ἡ",709436,10],["ἁμαρτία",700775,12],["οἴκου",709516,18],["Ιουδα",706768,18],["οὐχὶ",709862,28],["Ιερουσαλημ",706644,12]],"All these [calamities are] for the transgression of Jacob, and for the sin of the house of Israel. What is the transgression of Jacob? [is it] not Samaria? and what is the sin of the house of Juda? [is it] not Jerusalem?"],["6",[["καὶ",707031,7],["θήσομαι",712849,181],["Σαμάρειαν",711449,9],["εἰς",704105,0],["ὀπωροφυλάκιον",709718,25],["ἀγροῦ",700196,18],["καὶ",707031,7],["εἰς",704105,0],["φυτείαν",713634,9],["ἀμπελῶνος",700872,18],["καὶ",707031,7],["κατασπάσω",707431,165],["εἰς",704105,0],["χάος",713718,25],["τοὺς",709436,58],["λίθους",708196,57],["αὐτῆς",702165,86],["καὶ",707031,7],["τὰ",709436,41],["θεμέλια",706181,42],["αὐτῆς",702165,86],["ἀποκαλύψω",701474,165]],"Therefore I will make Samaria [as] a store-house of the fruits of the field, and [as] a planting of a vineyard: and I will utterly demolish her stones, and I will expose her foundations."],["7",[["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["γλυπτὰ",703117,68],["αὐτῆς",702165,86],["κατακόψουσιν",707285,218],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["μισθώματα",708941,42],["αὐτῆς",702165,86],["ἐμπρήσουσιν",704592,218],["ἐν",704639,0],["πυρί",711088,54],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["εἴδωλα",704079,42],["αὐτῆς",702165,86],["θήσομαι",712849,181],["εἰς",704105,0],["ἀφανισμόν",702183,6],["διότι",703734,7],["ἐκ",704132,0],["μισθωμάτων",708941,44],["πορνείας",710672,17],["συνήγαγεν",712375,2],["καὶ",707031,7],["ἐκ",704132,0],["μισθωμάτων",708941,44],["πορνείας",710672,17],["συνέστρεψεν",712562,2]],"And they shall cut in pieces all the graven images, and all that she has hired they shall burn with fire, and I will utterly destroy all her idols: because she has gathered of the hires of fornication, and of the hires of fornication has she amassed [wealth]."],["8",[["ἕνεκεν",704709,0],["τούτου",709858,102],["κόψεται",707829,93],["καὶ",707031,7],["θρηνήσει",706306,93],["πορεύσεται",710667,93],["ἀνυπόδετος",701288,29],["καὶ",707031,7],["γυμνή",703202,29],["ποιήσεται",710582,93],["κοπετὸν",707821,6],["ὡς",714148,7],["δρακόντων",703822,81],["καὶ",707031,7],["πένθος",710253,25],["ὡς",714148,7],["θυγατέρων",706320,65],["σειρήνων",711627,65]],"Therefore shall she lament and wail, she shall go barefooted, and [being] naked she shall make lamentation as [that] of serpents, and mourning as of the daughters of sirens."],["9",[["ὅτι",709803,7],["κατεκράτησεν",707287,2],["ἡ",709436,10],["πληγὴ",710527,12],["αὐτῆς",702165,86],["διότι",703734,7],["ἦλθεν",705453,2],["ἕως",705792,0],["Ιουδα",706768,18],["καὶ",707031,7],["ἥψατο",701654,23],["ἕως",705792,0],["πύλης",711082,17],["λαοῦ",708094,18],["μου",709032,133],["ἕως",705792,0],["Ιερουσαλημ",706644,17]],"For her plague has become grievous; for it has come even to Juda; and has reached to the gate of my people, even to Jerusalem."],["10",[["οἱ",709436,136],["ἐν",704639,0],["Γεθ",703005,111],["μὴ",708851,28],["μεγαλύνεσθε",708647,73],["οἱ",709436,136],["ἐν",704639,0],["Ακιμ",700543,111],["μὴ",708851,28],["ἀνοικοδομεῖτε",701187,335],["ἐξ",704132,0],["οἴκου",709516,18],["κατὰ",707200,0],["γέλωτα",703032,6],["γῆν",703083,9],["καταπάσασθε",707359,186],["κατὰ",707200,0],["γέλωτα",703032,6],["ὑμῶν",713091,145]],"Ye that are in Geth, exalt not yourselves, and ye Enakim, do not rebuild from [the ruins of] the house in derision: sprinkle dust [in the place of] your laughter."],["11",[["κατοικοῦσα",707534,188],["καλῶς",707106,28],["τὰς",709436,38],["πόλεις",710612,39],["αὐτῆς",702165,86],["οὐκ",709805,28],["ἐξῆλθεν",704909,2],["κατοικοῦσα",707534,188],["Σεννααν",711690,227],["κόψασθαι",707829,109],["οἶκον",709516,6],["ἐχόμενον",705785,212],["αὐτῆς",702165,86],["λήμψεται",708076,93],["ἐξ",704132,0],["ὑμῶν",713091,145],["πληγὴν",710527,9],["ὀδύνης",709463,17]],"The inhabitant of Sennaar, fairly inhabiting her cities, came not forth to mourn for the house next to her: she shall receive of you the stroke of grief."],["12",[["τίς",712867,158],["ἤρξατο",701860,23],["εἰς",704105,0],["ἀγαθὰ",700106,68],["κατοικούσῃ",707534,220],["ὀδύνας",709463,39],["ὅτι",709803,7],["κατέβη",707202,2],["κακὰ",707066,195],["παρὰ",709995,0],["κυρίου",707996,18],["ἐπὶ",705080,0],["πύλας",711082,39],["Ιερουσαλημ",706644,17]],"Who has begun [to act] for good to her that dwells in sorrow? for calamities have come down from the Lord upon the gates of Jerusalem,"],["13",[["ψόφος",714064,4],["ἁρμάτων",701768,44],["καὶ",707031,7],["ἱππευόντων",706787,170],["κατοικοῦσα",707534,188],["Λαχις",708116,227],["ἀρχηγὸς",701838,4],["ἁμαρτίας",700775,17],["αὐτή",702165,107],["ἐστιν",704093,91],["τῇ",709436,100],["θυγατρὶ",706320,1],["Σιων",711816,118],["ὅτι",709803,7],["ἐν",704639,0],["σοὶ",711925,159],["εὑρέθησαν",705676,99],["ἀσέβειαι",701904,191],["τοῦ",709436,35],["Ισραηλ",706839,18]],"[even] a sound of chariots and horsemen: the inhabitants of Lachis, she is the leader of sin to the daughter of Sion: for in thee were found the transgressions of Israel."],["14",[["διὰ",703417,0],["τοῦτο",709858,129],["δώσεις",703654,166],["ἐξαποστελλομένους",704872,236],["ἕως",705792,0],["κληρονομίας",707725,17],["Γεθ",703005,118],["οἴκους",709516,57],["ματαίους",708575,60],["εἰς",704105,0],["κενὰ",707612,68],["ἐγένετο",703104,23],["τοῖς",709436,147],["βασιλεῦσιν",702580,148],["τοῦ",709436,35],["Ισραηλ",706839,18]],"Therefore shall he cause men to be sent forth as far as the inheritance of Geth, [even] vain houses; they are become vanity to the kings of Israel;"],["15",[["ἕως",705792,0],["τοὺς",709436,58],["κληρονόμους",707726,57],["ἀγάγω",700209,207],["σοι",711925,159],["κατοικοῦσα",707534,188],["Λαχις",708116,227],["κληρονομία",707725,12],["ἕως",705792,0],["Οδολλαμ",709452,227],["ἥξει",705956,127],["ἡ",709436,10],["δόξα",703791,12],["τῆς",709436,16],["θυγατρὸς",706320,17],["Ισραηλ",706839,18]],"until they bring the heirs, O inhabitant of Lachis: the inheritance shall reach to Odollam, [even] the glory of the daughter of Israel."],["16",[["ξύρησαι",709431,300],["καὶ",707031,7],["κεῖραι",707597,300],["ἐπὶ",705080,0],["τὰ",709436,41],["τέκνα",712761,42],["τὰ",709436,41],["τρυφερά",713006,68],["σου",711945,133],["ἐμπλάτυνον",704596,47],["τὴν",709436,8],["χηρείαν",713849,9],["σου",711945,133],["ὡς",714148,7],["ἀετός",700318,4],["ὅτι",709803,7],["ᾐχμαλωτεύθησαν",700500,99],["ἀπὸ",701425,0],["σοῦ",711945,133]],"Shave thine hair, and make thyself bald for thy delicate children; increase thy widowhood as an eagle; for [thy people] are gone into captivity from thee."]]