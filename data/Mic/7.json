[["1",[["οἴμμοι",709525,88],["ὅτι",709803,7],["ἐγενόμην",703104,161],["ὡς",714148,7],["συνάγων",712375,72],["καλάμην",707079,9],["ἐν",704639,0],["ἀμήτῳ",700819,114],["καὶ",707031,7],["ὡς",714148,7],["ἐπιφυλλίδα",705326,9],["ἐν",704639,0],["τρυγήτῳ",712998,114],["οὐχ",709805,28],["ὑπάρχοντος",713102,152],["βότρυος",702775,18],["τοῦ",709436,20],["φαγεῖν",713296,106],["τὰ",709436,41],["πρωτόγονα",711035,68],["οἴμμοι",709525,88],["ψυχή",714070,12]],"Alas for me! for I am become as one gathering straw in harvest, and as [one gathering] grape-gleanings in the vintage, when there is no cluster for me to eat the first-ripe fruit: alas my soul!"],["2",[["ὅτι",709803,7],["ἀπόλωλεν",701513,171],["εὐλαβὴς",705628,14],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["κατορθῶν",707548,72],["ἐν",704639,0],["ἀνθρώποις",701163,148],["οὐχ",709805,28],["ὑπάρχει",713104,91],["πάντες",710177,138],["εἰς",704105,0],["αἵματα",700442,42],["δικάζονται",703691,269],["ἕκαστος",704133,14],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102],["ἐκθλίβουσιν",704199,197],["ἐκθλιβῇ",704199,204]],"For the godly is perished from the earth; and there is none among men that orders [his way] aright: they all quarrel even to blood: they grievously afflict every one his neighbour:"],["3",[["ἐπὶ",705080,0],["τὸ",709436,24],["κακὸν",707066,46],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτῶν",702165,40],["ἑτοιμάζουσιν",705539,197],["ὁ",709436,3],["ἄρχων",701862,4],["αἰτεῖ",700489,91],["καὶ",707031,7],["ὁ",709436,3],["κριτὴς",707910,4],["εἰρηνικοὺς",704099,60],["λόγους",708236,57],["ἐλάλησεν",708071,2],["καταθύμιον",707253,46],["ψυχῆς",714070,17],["αὐτοῦ",702165,102],["ἐστιν",704093,91],["καὶ",707031,7],["ἐξελοῦμαι",704838,181]],"they prepare their hands for mischief, the prince asks [a reward], and the judge speaks flattering words; it is the desire of their soul:"],["4",[["τὰ",709436,41],["ἀγαθὰ",700106,68],["αὐτῶν",702165,40],["ὡς",714148,7],["σὴς",711943,82],["ἐκτρώγων",704347,72],["καὶ",707031,7],["βαδίζων",702367,72],["ἐπὶ",705080,0],["κανόνος",707128,18],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["σκοπιᾶς",711876,17],["οὐαὶ",709807,88],["οὐαί",709807,88],["αἱ",709436,190],["ἐκδικήσεις",704175,191],["σου",711945,133],["ἥκασιν",705956,197],["νῦν",709384,28],["ἔσονται",704093,135],["κλαυθμοὶ",707705,52],["αὐτῶν",702165,40]],"therefore I will take away their goods as a devouring moth, and as one who acts by a [rigid] rule in a day of visitation. Woe, woe, thy times of vengeance are come; now shall be their lamentations."],["5",[["μὴ",708851,28],["καταπιστεύετε",707376,87],["ἐν",704639,0],["φίλοις",713492,230],["καὶ",707031,7],["μὴ",708851,28],["ἐλπίζετε",704529,87],["ἐπὶ",705080,0],["ἡγουμένοις",705931,341],["ἀπὸ",701425,0],["τῆς",709436,16],["συγκοίτου",712227,82],["σου",711945,133],["φύλαξαι",713619,300],["τοῦ",709436,20],["ἀναθέσθαι",701068,109],["τι",712866,126],["αὐτῇ",702165,105]],"Trust not in friends, and confide not in guides: beware of thy wife, so as not to commit anything to her."],["6",[["διότι",703734,7],["υἱὸς",713075,4],["ἀτιμάζει",702092,91],["πατέρα",710189,6],["θυγάτηρ",706320,12],["ἐπαναστήσεται",705026,93],["ἐπὶ",705080,0],["τὴν",709436,8],["μητέρα",708892,9],["αὐτῆς",702165,86],["νύμφη",709381,12],["ἐπὶ",705080,0],["τὴν",709436,8],["πενθερὰν",710249,9],["αὐτῆς",702165,86],["ἐχθροὶ",705779,52],["ἀνδρὸς",701150,18],["πάντες",710177,138],["οἱ",709436,136],["ἄνδρες",701150,52],["οἱ",709436,136],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["αὐτοῦ",702165,102]],"For the son dishonours his father, the daughter will rise up against her mother, the daughter-in-law against her mother-in-law: those in his house [shall be] all a man's enemies."],["7",[["ἐγὼ",704018,164],["δὲ",703303,11],["ἐπὶ",705080,0],["τὸν",709436,5],["κύριον",707996,6],["ἐπιβλέψομαι",705088,181],["ὑπομενῶ",713219,165],["ἐπὶ",705080,0],["τῷ",709436,113],["θεῷ",706192,114],["τῷ",709436,113],["σωτῆρί",712657,114],["μου",709032,133],["εἰσακούσεταί",704108,93],["μου",709032,133],["ὁ",709436,3],["θεός",706192,4],["μου",709032,133]],"But I will look to the Lord; I will wait upon God my Saviour: my God will hearken to me."],["8",[["μὴ",708851,28],["ἐπίχαιρέ",705330,240],["μοι",708974,159],["ἡ",709436,10],["ἐχθρά",705775,12],["μου",709032,133],["ὅτι",709803,7],["πέπτωκα",710481,89],["καὶ",707031,7],["ἀναστήσομαι",701173,181],["διότι",703734,7],["ἐὰν",703912,7],["καθίσω",707006,165],["ἐν",704639,0],["τῷ",709436,53],["σκότει",711889,54],["κύριος",707996,4],["φωτιεῖ",713646,127],["μοι",708974,159]],"Rejoice not against me, mine enemy; for I have fallen [yet] shall arise; for though I should sit in darkness, the Lord shall be a light to me."],["9",[["ὀργὴν",709728,9],["κυρίου",707996,18],["ὑποίσω",713256,165],["ὅτι",709803,7],["ἥμαρτον",700773,155],["αὐτῷ",702165,50],["ἕως",705792,0],["τοῦ",709436,20],["δικαιῶσαι",703696,106],["αὐτὸν",702165,85],["τὴν",709436,8],["δίκην",703702,9],["μου",709032,133],["καὶ",707031,7],["ποιήσει",710582,127],["τὸ",709436,24],["κρίμα",707903,25],["μου",709032,133],["καὶ",707031,7],["ἐξάξει",704834,127],["με",708618,163],["εἰς",704105,0],["τὸ",709436,24],["φῶς",713642,25],["ὄψομαι",709725,181],["τὴν",709436,8],["δικαιοσύνην",703695,9],["αὐτοῦ",702165,102]],"I will bear the indignation of the Lord, because I have sinned against him, until he make good my cause: he also shall maintain my right, and shall bring me out to the light, [and] I shall behold his righteousness."],["10",[["καὶ",707031,7],["ὄψεται",709725,93],["ἡ",709436,10],["ἐχθρά",705775,12],["μου",709032,133],["καὶ",707031,7],["περιβαλεῖται",710294,93],["αἰσχύνην",700483,9],["ἡ",709436,10],["λέγουσα",708124,188],["πρός",710844,0],["με",708618,163],["ποῦ",710706,28],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["σου",711945,133],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["μου",709032,133],["ἐπόψονται",705057,135],["αὐτήν",702165,104],["νῦν",709384,28],["ἔσται",704093,93],["εἰς",704105,0],["καταπάτημα",707361,25],["ὡς",714148,7],["πηλὸς",710457,4],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76]],"And she that is mine enemy shall see it, and shall clothe herself with shame, who says, Where [is] the Lord thy God? mine eyes shall look upon her: now shall she be for trampling as mire in the ways."],["11",[["ἡμέρας",705984,17],["ἀλοιφῆς",700725,17],["πλίνθου",710554,17],["ἐξάλειψίς",704853,12],["σου",711945,133],["ἡ",709436,10],["ἡμέρα",705984,12],["ἐκείνη",704183,107],["καὶ",707031,7],["ἀποτρίψεται",701624,134],["νόμιμά",709340,195],["σου",711945,133]],"[It is] the day of making of brick; that day shall be thine utter destruction, and that day shall utterly abolish thine ordinances."],["12",[["ἡ",709436,10],["ἡμέρα",705984,12],["ἐκείνη",704183,107],["καὶ",707031,7],["αἱ",709436,190],["πόλεις",710612,191],["σου",711945,133],["ἥξουσιν",705956,218],["εἰς",704105,0],["ὁμαλισμὸν",709608,6],["καὶ",707031,7],["εἰς",704105,0],["διαμερισμὸν",703519,6],["Ἀσσυρίων",702004,81],["καὶ",707031,7],["αἱ",709436,190],["πόλεις",710612,191],["σου",711945,133],["αἱ",709436,190],["ὀχυραὶ",709889,192],["εἰς",704105,0],["διαμερισμὸν",703519,6],["ἀπὸ",701425,0],["Τύρου",713028,17],["ἕως",705792,0],["τοῦ",709436,35],["ποταμοῦ",710693,18],["Συρίας",712533,17],["ἡμέρα",705984,12],["ὕδατος",713071,21],["καὶ",707031,7],["θορύβου",706293,18]],"And thy cities shall be levelled, and parted among the Assyrians; and thy strong cities shall be parted from Tyre to the river, and from sea to sea, and from mountain to mountain.",{"s":"d","q":0.7}],["13",[["καὶ",707031,7],["ἔσται",704093,93],["ἡ",709436,10],["γῆ",703083,12],["εἰς",704105,0],["ἀφανισμὸν",702183,6],["σὺν",712372,0],["τοῖς",709436,147],["κατοικοῦσιν",707534,349],["αὐτὴν",702165,104],["ἐκ",704132,0],["καρπῶν",707169,81],["ἐπιτηδευμάτων",705301,44],["αὐτῶν",702165,40]],"And the land shall be utterly desolate together with them that inhabit it, because of the fruit of their doings."],["14",[["ποίμαινε",710594,240],["λαόν",708094,6],["σου",711945,133],["ἐν",704639,0],["ῥάβδῳ",711135,1],["σου",711945,133],["πρόβατα",710768,42],["κληρονομίας",707725,17],["σου",711945,133],["κατασκηνοῦντας",707423,235],["καθ᾿",707200,0],["ἑαυτοὺς",703917,62],["δρυμὸν",703836,6],["ἐν",704639,0],["μέσῳ",708768,97],["τοῦ",709436,35],["Καρμήλου",707161,18],["νεμήσονται",709253,135],["τὴν",709436,8],["Βασανῖτιν",702569,9],["καὶ",707031,7],["τὴν",709436,8],["Γαλααδῖτιν",702925,9],["καθὼς",707030,28],["αἱ",709436,190],["ἡμέραι",705984,191],["τοῦ",709436,35],["αἰῶνος",700504,18]],"Tend thy people with thy rod, the sheep of thine inheritance, those that inhabit by themselves the thicket in the midst of Carmel: they shall feed in the land of Basan, and in the land of Galaad, as in the days of old."],["15",[["καὶ",707031,7],["κατὰ",707200,0],["τὰς",709436,38],["ἡμέρας",705984,39],["ἐξοδίας",704944,17],["σου",711945,133],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["ὄψεσθε",709725,124],["θαυμαστά",706138,68]],"And according to the days of thy departure out of Egypt shall ye see marvellous [things]."],["16",[["ὄψονται",709725,135],["ἔθνη",704068,64],["καὶ",707031,7],["καταισχυνθήσονται",707257,144],["ἐκ",704132,0],["πάσης",710177,82],["τῆς",709436,16],["ἰσχύος",706858,17],["αὐτῶν",702165,40],["ἐπιθήσουσιν",705304,218],["χεῖρας",713787,39],["ἐπὶ",705080,0],["τὸ",709436,24],["στόμα",712125,25],["αὐτῶν",702165,40],["τὰ",709436,63],["ὦτα",709852,64],["αὐτῶν",702165,40],["ἀποκωφωθήσονται",701502,144]],"The nations shall see and be ashamed; and at all their might they shall lay their hands upon their mouth, their ears shall be deafened."],["17",[["λείξουσιν",708139,218],["χοῦν",713930,6],["ὡς",714148,7],["ὄφεις",709875,52],["σύροντες",712543,146],["γῆν",703083,9],["συγχυθήσονται",712243,144],["ἐν",704639,0],["συγκλεισμῷ",712220,114],["αὐτῶν",702165,40],["ἐπὶ",705080,0],["τῷ",709436,113],["κυρίῳ",707996,114],["θεῷ",706192,114],["ἡμῶν",705999,145],["ἐκστήσονται",704940,135],["καὶ",707031,7],["φοβηθήσονται",713532,144],["ἀπὸ",701425,0],["σοῦ",711945,133]],"They shall lick the dust as serpents crawling on the earth, they shall be confounded in their holes; they shall be amazed at the Lord our God, and will be afraid of thee."],["18",[["τίς",712867,158],["θεὸς",706192,4],["ὥσπερ",714163,28],["σύ",712181,164],["ἐξαίρων",704839,72],["ἀδικίας",700271,39],["καὶ",707031,7],["ὑπερβαίνων",713125,72],["ἀσεβείας",701904,39],["τοῖς",709436,147],["καταλοίποις",707317,230],["τῆς",709436,16],["κληρονομίας",707725,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐ",709805,28],["συνέσχεν",712469,2],["εἰς",704105,0],["μαρτύριον",708525,25],["ὀργὴν",709728,9],["αὐτοῦ",702165,102],["ὅτι",709803,7],["θελητὴς",706173,4],["ἐλέους",704426,42],["ἐστίν",704093,91]],"Who is a God like thee, cancelling iniquities, and passing over the sins of the remnant of his inheritance? and he has not kept his anger for a testimony, for he delights in mercy."],["19",[["αὐτὸς",702165,121],["ἐπιστρέψει",705278,127],["καὶ",707031,7],["οἰκτιρήσει",709518,127],["ἡμᾶς",705981,194],["καταδύσει",707250,127],["τὰς",709436,38],["ἀδικίας",700271,39],["ἡμῶν",705999,145],["καὶ",707031,7],["ἀπορριφήσονται",701563,144],["εἰς",704105,0],["τὰ",709436,41],["βάθη",702376,42],["τῆς",709436,16],["θαλάσσης",706069,17],["πάσας",710177,119],["τὰς",709436,38],["ἁμαρτίας",700775,39],["ἡμῶν",705999,145]],"He will return and have mercy upon us; he will sink our iniquities, and they shall be cast into the depths of the sea, [even] all our sins."],["20",[["δώσεις",703654,166],["ἀλήθειαν",700656,9],["τῷ",709436,113],["Ιακωβ",706401,114],["ἔλεον",704426,25],["τῷ",709436,113],["Αβρααμ",700091,114],["καθότι",707021,28],["ὤμοσας",709620,162],["τοῖς",709436,147],["πατράσιν",710189,148],["ἡμῶν",705999,145],["κατὰ",707200,0],["τὰς",709436,38],["ἡμέρας",705984,39],["τὰς",709436,38],["ἔμπροσθεν",704618,28]],"He shall give blessings truly to Jacob, and mercy to Abraam, as thou swarest to our fathers, according to the former days."]]