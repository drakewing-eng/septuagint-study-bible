[["1",[["οὕτως",709859,28],["ἔδειξέν",703314,2],["μοι",708974,159],["κύριος",707996,4],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἐπιγονὴ",705109,12],["ἀκρίδων",700599,65],["ἐρχομένη",705453,211],["ἑωθινή",705790,29],["καὶ",707031,7],["ἰδοὺ",706497,88],["βροῦχος",702818,4],["εἷς",704106,14],["Γωγ",703213,4],["ὁ",709436,3],["βασιλεύς",702580,4]],"Thus has the Lord God shewed me; and, behold, a swarm of locusts coming from the east; and, behold, one caterpillar, king Gog."],["2",[["καὶ",707031,7],["ἔσται",704093,93],["ἐὰν",703912,7],["συντελέσῃ",712510,172],["τοῦ",709436,20],["καταφαγεῖν",707519,106],["τὸν",709436,5],["χόρτον",713923,6],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["εἶπα",705373,155],["κύριε",707996,153],["κύριε",707996,153],["ἵλεως",706732,14],["γενοῦ",703104,300],["τίς",712867,158],["ἀναστήσει",701173,127],["τὸν",709436,5],["Ιακωβ",706401,6],["ὅτι",709803,7],["ὀλιγοστός",709569,14],["ἐστιν",704093,91]],"And it came to pass when he had finished devouring the grass of the land, that I said, Lord God, be merciful; who shall raise up Jacob? for he is small in number."],["3",[["μετανόησον",708809,176],["κύριε",707996,153],["ἐπὶ",705080,0],["τούτῳ",709858,50],["καὶ",707031,7],["τοῦτο",709858,132],["οὐκ",709805,28],["ἔσται",704093,93],["λέγει",708124,91],["κύριος",707996,4]],"Repent, O Lord, for this. And this shall not be, saith the Lord."],["4",[["οὕτως",709859,28],["ἔδειξέν",703314,2],["μοι",708974,159],["κύριος",707996,4],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἐκάλεσεν",707084,2],["τὴν",709436,8],["δίκην",703702,9],["ἐν",704639,0],["πυρὶ",711088,54],["κύριος",707996,4],["καὶ",707031,7],["κατέφαγε",707519,2],["τὴν",709436,8],["ἄβυσσον",700098,9],["τὴν",709436,8],["πολλὴν",710646,36],["καὶ",707031,7],["κατέφαγεν",707519,2],["τὴν",709436,8],["μερίδα",708748,9]],"Thus has the Lord shewed me; and, behold, the Lord called for judgment by fire, and it devoured the great deep, and devoured the Lord's portion."],["5",[["καὶ",707031,7],["εἶπα",705373,155],["κύριε",707996,153],["κύριε",707996,153],["κόπασον",707819,176],["δή",703395,11],["τίς",712867,158],["ἀναστήσει",701173,127],["τὸν",709436,5],["Ιακωβ",706401,6],["ὅτι",709803,7],["ὀλιγοστός",709569,14],["ἐστιν",704093,91]],"Then I said, O Lord, cease, I pray thee: who shall raise up Jacob? for he is small in number. Repent, O Lord, for this."],["6",[["μετανόησον",708809,176],["κύριε",707996,153],["ἐπὶ",705080,0],["τούτῳ",709858,50],["καὶ",707031,7],["τοῦτο",709858,132],["οὐ",709805,28],["μὴ",708851,28],["γένηται",703104,239],["λέγει",708124,91],["κύριος",707996,4]],"This also shall not be, saith the Lord."],["7",[["οὕτως",709859,28],["ἔδειξέν",703314,2],["μοι",708974,159],["κύριος",707996,4],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἀνὴρ",701150,4],["ἑστηκὼς",706846,270],["ἐπὶ",705080,0],["τείχους",712759,21],["ἀδαμαντίνου",700224,92],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["χειρὶ",713787,1],["αὐτοῦ",702165,102],["ἀδάμας",700225,4]],"Thus the Lord shewed me; and behold, he stood upon a wall of adamant, and in his hand [was] an adamant."],["8",[["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["τί",712867,126],["σὺ",712181,164],["ὁρᾷς",709725,154],["Αμως",700898,153],["καὶ",707031,7],["εἶπα",705373,155],["ἀδάμαντα",700225,6],["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐντάσσω",704786,157],["ἀδάμαντα",700225,6],["ἐν",704639,0],["μέσῳ",708768,97],["λαοῦ",708094,18],["μου",709032,133],["Ισραηλ",706839,18],["οὐκέτι",709827,28],["μὴ",708851,28],["προσθῶ",710965,207],["τοῦ",709436,20],["παρελθεῖν",710141,106],["αὐτόν",702165,85]],"And the Lord said to me, What seest thou, Amos? And I said, An adamant. And the Lord said to me, Behold, I appoint an adamant in the midst of my people Israel: I will not pass by them any more."],["9",[["καὶ",707031,7],["ἀφανισθήσονται",702182,144],["βωμοὶ",702840,52],["τοῦ",709436,35],["γέλωτος",703032,18],["καὶ",707031,7],["αἱ",709436,190],["τελεταὶ",712779,191],["τοῦ",709436,35],["Ισραηλ",706839,18],["ἐξερημωθήσονται",704907,144],["καὶ",707031,7],["ἀναστήσομαι",701173,181],["ἐπὶ",705080,0],["τὸν",709436,5],["οἶκον",709516,6],["Ιεροβοαμ",706629,18],["ἐν",704639,0],["ῥομφαίᾳ",711291,1]],"And the joyful altars shall be abolished, and the sacrifices of Israel shall be set aside; and I will rise up against the house of Jeroboam with the sword."],["10",[["καὶ",707031,7],["ἐξαπέστειλεν",704872,2],["Αμασιας",700784,4],["ὁ",709436,3],["ἱερεὺς",706614,4],["Βαιθηλ",702412,17],["πρὸς",710844,0],["Ιεροβοαμ",706629,6],["βασιλέα",702580,6],["Ισραηλ",706839,18],["λέγων",708124,72],["συστροφὰς",712563,39],["ποιεῖται",710582,117],["κατὰ",707200,0],["σοῦ",711945,133],["Αμως",700898,4],["ἐν",704639,0],["μέσῳ",708768,97],["οἴκου",709516,18],["Ισραηλ",706839,18],["οὐ",709805,28],["μὴ",708851,28],["δύνηται",703838,428],["ἡ",709436,10],["γῆ",703083,12],["ὑπενεγκεῖν",713256,106],["ἅπαντας",701362,60],["τοὺς",709436,58],["λόγους",708236,57],["αὐτοῦ",702165,102]],"Then Amasias the priest of Bæthel sent to Jeroboam king of Israel, saying, Amos is forming conspiracies against thee in the midst of the house of Israel: the land will be utterly unable to bear all his words."],["11",[["διότι",703734,7],["τάδε",709446,71],["λέγει",708124,91],["Αμως",700898,4],["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["τελευτήσει",712781,127],["Ιεροβοαμ",706629,4],["ὁ",709436,3],["δὲ",703303,11],["Ισραηλ",706839,4],["αἰχμάλωτος",700503,14],["ἀχθήσεται",700209,134],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["αὐτοῦ",702165,102]],"For thus says Amos, Jeroboam shall die by the sword, and Israel shall be led away captive from his land."],["12",[["καὶ",707031,7],["εἶπεν",705373,2],["Αμασιας",700784,4],["πρὸς",710844,0],["Αμως",700898,6],["ὁ",709436,3],["ὁρῶν",709725,72],["βάδιζε",702367,240],["ἐκχώρησον",704371,176],["εἰς",704105,0],["γῆν",703083,9],["Ιουδα",706768,18],["καὶ",707031,7],["ἐκεῖ",704181,28],["καταβίου",707210,240],["καὶ",707031,7],["ἐκεῖ",704181,28],["προφητεύσεις",711008,166]],"And Amasias said to Amos, Go, seer, remove thou into the land of Juda, and live there, and thou shalt prophesy there:"],["13",[["εἰς",704105,0],["δὲ",703303,11],["Βαιθηλ",702412,9],["οὐκέτι",709827,28],["μὴ",708851,28],["προσθῇς",710965,175],["τοῦ",709436,20],["προφητεῦσαι",711008,106],["ὅτι",709803,7],["ἁγίασμα",700154,15],["βασιλέως",702580,18],["ἐστὶν",704093,91],["καὶ",707031,7],["οἶκος",709516,4],["βασιλείας",702577,17],["ἐστίν",704093,91]],"but thou shalt no longer prophesy at Bæthel: for it is the king's sanctuary, and it is the royal house."],["14",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["Αμως",700898,4],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["Αμασιαν",700783,6],["οὐκ",709805,28],["ἤμην",704093,333],["προφήτης",711009,4],["ἐγὼ",704018,164],["οὐδὲ",709816,7],["υἱὸς",713075,4],["προφήτου",711009,18],["ἀλλ᾿",700680,7],["ἢ",705924,7],["αἰπόλος",700466,4],["ἤμην",704093,333],["καὶ",707031,7],["κνίζων",707755,72],["συκάμινα",712252,42]],"And Amos answered, and said to Amasias, I was not a prophet, nor the son of a prophet; but I was a herdman, and a gatherer of sycamore fruits."],["15",[["καὶ",707031,7],["ἀνέλαβέν",700984,2],["με",708618,163],["κύριος",707996,4],["ἐκ",704132,0],["τῶν",709436,43],["προβάτων",710768,44],["καὶ",707031,7],["εἶπεν",705373,2],["κύριος",707996,4],["πρός",710844,0],["με",708618,163],["βάδιζε",702367,240],["προφήτευσον",711008,176],["ἐπὶ",705080,0],["τὸν",709436,5],["λαόν",708094,6],["μου",709032,133],["Ισραηλ",706839,6]],"And the Lord took me from the sheep, and the Lord said to me, Go, and prophesy to my people Israel."],["16",[["καὶ",707031,7],["νῦν",709384,28],["ἄκουε",700587,240],["λόγον",708236,6],["κυρίου",707996,18],["σὺ",712181,164],["λέγεις",708124,154],["μὴ",708851,28],["προφήτευε",711008,240],["ἐπὶ",705080,0],["τὸν",709436,5],["Ισραηλ",706839,6],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ὀχλαγωγήσῃς",709882,175],["ἐπὶ",705080,0],["τὸν",709436,5],["οἶκον",709516,6],["Ιακωβ",706401,18]],"And now hear the word of the Lord: Thou sayest, Prophesy not to Israel, and raise not a tumult against the house of Jacob."],["17",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ἡ",709436,10],["γυνή",703209,12],["σου",711945,133],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["πορνεύσει",710674,127],["καὶ",707031,7],["οἱ",709436,136],["υἱοί",713075,52],["σου",711945,133],["καὶ",707031,7],["αἱ",709436,190],["θυγατέρες",706320,191],["σου",711945,133],["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["πεσοῦνται",710481,135],["καὶ",707031,7],["ἡ",709436,10],["γῆ",703083,12],["σου",711945,133],["ἐν",704639,0],["σχοινίῳ",712610,54],["καταμετρηθήσεται",707330,134],["καὶ",707031,7],["σὺ",712181,164],["ἐν",704639,0],["γῇ",703083,1],["ἀκαθάρτῳ",700508,101],["τελευτήσεις",712781,166],["ὁ",709436,3],["δὲ",703303,11],["Ισραηλ",706839,4],["αἰχμάλωτος",700503,14],["ἀχθήσεται",700209,134],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["αὐτοῦ",702165,102]],"Therefore thus saith the Lord; Thy wife shall be a harlot in the city, and thy sons and thy daughters shall fall by the sword, and thy land shall be measured with the line; and thou shalt die in an unclean land; and Israel shall be led captive out of his land. Thus has the Lord God shewed me."]]