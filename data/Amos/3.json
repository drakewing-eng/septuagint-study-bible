[["1",[["ἀκούσατε",700587,74],["τὸν",709436,5],["λόγον",708236,6],["τοῦτον",709858,85],["ὃν",709781,112],["ἐλάλησεν",708071,2],["κύριος",707996,4],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["οἶκος",709516,4],["Ισραηλ",706839,18],["καὶ",707031,7],["κατὰ",707200,0],["πάσης",710177,82],["φυλῆς",713620,17],["ἧς",709781,167],["ἀνήγαγον",700933,155],["ἐκ",704132,0],["γῆς",703083,17],["Αἰγύπτου",700401,17],["λέγων",708124,72]],"Hear ye this word, O house of Israel, which the Lord has spoken concerning you, and against the whole family whom I brought up out of the land of Egypt, saying,"],["2",[["πλὴν",710540,28],["ὑμᾶς",713080,194],["ἔγνων",703105,155],["ἐκ",704132,0],["πασῶν",710177,198],["φυλῶν",713620,65],["τῆς",709436,16],["γῆς",703083,17],["διὰ",703417,0],["τοῦτο",709858,129],["ἐκδικήσω",704174,165],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["πάσας",710177,119],["τὰς",709436,38],["ἁμαρτίας",700775,39],["ὑμῶν",713091,145]],"You especially have I known out of all the families of the earth: therefore will I take vengeance upon you for all your sins."],["3",[["εἰ",704071,7],["πορεύσονται",710667,135],["δύο",703849,59],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτὸ",702165,129],["καθόλου",707016,28],["ἐὰν",703912,7],["μὴ",708851,28],["γνωρίσωσιν",703135,234],["ἑαυτούς",703917,62]],"Shall two walk together at all, if they do not know one another?"],["4",[["εἰ",704071,7],["ἐρεύξεται",705410,93],["λέων",708171,4],["ἐκ",704132,0],["τοῦ",709436,35],["δρυμοῦ",703836,18],["αὐτοῦ",702165,102],["θήραν",706244,9],["οὐκ",709805,28],["ἔχων",705785,72],["εἰ",704071,7],["δώσει",703654,127],["σκύμνος",711903,4],["φωνὴν",713640,9],["αὐτοῦ",702165,102],["ἐκ",704132,0],["τῆς",709436,16],["μάνδρας",708473,17],["αὐτοῦ",702165,102],["καθόλου",707016,28],["ἐὰν",703912,7],["μὴ",708851,28],["ἁρπάσῃ",701804,172],["τι",712866,126]],"Will a lion roar out of his thicket if he has no prey? will a [lion's] whelp utter his voice at all out of his lair, if he have taken nothing?"],["5",[["εἰ",704071,7],["πεσεῖται",710481,93],["ὄρνεον",709762,15],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["ἄνευ",701137,0],["ἰξευτοῦ",706752,18],["εἰ",704071,7],["σχασθήσεται",712595,134],["παγὶς",709910,12],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ἄνευ",701137,0],["τοῦ",709436,20],["συλλαβεῖν",712262,55],["τι",712866,126]],"Will a bird fall on the earth without a fowler? will a snare be taken up from the earth without having taken anything?"],["6",[["εἰ",704071,7],["φωνήσει",713639,127],["σάλπιγξ",711424,12],["ἐν",704639,0],["πόλει",710612,1],["καὶ",707031,7],["λαὸς",708094,4],["οὐ",709805,28],["πτοηθήσεται",711062,134],["εἰ",704071,7],["ἔσται",704093,93],["κακία",707054,12],["ἐν",704639,0],["πόλει",710612,1],["ἣν",709781,131],["κύριος",707996,4],["οὐκ",709805,28],["ἐποίησεν",710582,2]],"Shall the trumpet sound in the city, and the people not be alarmed? shall there be evil in a city which the Lord has not wrought?"],["7",[["διότι",703734,7],["οὐ",709805,28],["μὴ",708851,28],["ποιήσῃ",710582,172],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["πρᾶγμα",710708,25],["ἐὰν",703912,7],["μὴ",708851,28],["ἀποκαλύψῃ",701474,123],["παιδείαν",709924,9],["αὐτοῦ",702165,102],["πρὸς",710844,0],["τοὺς",709436,58],["δούλους",703817,57],["αὐτοῦ",702165,102],["τοὺς",709436,58],["προφήτας",711009,57]],"For the Lord God will do nothing, without revealing instruction to his servants the prophets."],["8",[["λέων",708171,4],["ἐρεύξεται",705410,93],["καὶ",707031,7],["τίς",712867,158],["οὐ",709805,28],["φοβηθήσεται",713532,134],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἐλάλησεν",708071,2],["καὶ",707031,7],["τίς",712867,158],["οὐ",709805,28],["προφητεύσει",711008,127]],"A lion shall roar, and who will not be alarmed? the Lord God has spoken, and who will not prophesy?"],["9",[["ἀπαγγείλατε",701321,74],["χώραις",714011,76],["ἐν",704639,0],["Ἀσσυρίοις",702004,148],["καὶ",707031,7],["ἐπὶ",705080,0],["τὰς",709436,38],["χώρας",714011,39],["τῆς",709436,16],["Αἰγύπτου",700401,17],["καὶ",707031,7],["εἴπατε",705373,265],["συνάχθητε",712375,372],["ἐπὶ",705080,0],["τὸ",709436,24],["ὄρος",709768,25],["Σαμαρείας",711449,17],["καὶ",707031,7],["ἴδετε",709725,74],["θαυμαστὰ",706138,68],["πολλὰ",710646,68],["ἐν",704639,0],["μέσῳ",708768,97],["αὐτῆς",702165,86],["καὶ",707031,7],["τὴν",709436,8],["καταδυναστείαν",707247,9],["τὴν",709436,8],["ἐν",704639,0],["αὐτῇ",702165,105]],"Proclaim it to the regions among the Assyrians, and to the regions of Egypt, and say, Gather yourselves to the mountain of Samaria, and behold many wonderful things in the midst of it, and the oppression that is in it."],["10",[["καὶ",707031,7],["οὐκ",709805,28],["ἔγνω",703105,2],["ἃ",709781,69],["ἔσται",704093,93],["ἐναντίον",704654,0],["αὐτῆς",702165,86],["λέγει",708124,91],["κύριος",707996,4],["οἱ",709436,136],["θησαυρίζοντες",706256,146],["ἀδικίαν",700271,9],["καὶ",707031,7],["ταλαιπωρίαν",712695,9],["ἐν",704639,0],["ταῖς",709436,75],["χώραις",714011,76],["αὐτῶν",702165,40]],"And she knew not what things would come against her, saith the Lord, [even] those that store up wrong and misery in their countries."],["11",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4],["Τύρος",713028,12],["κυκλόθεν",707956,28],["ἡ",709436,10],["γῆ",703083,12],["σου",711945,133],["ἐρημωθήσεται",705421,134],["καὶ",707031,7],["κατάξει",707232,127],["ἐκ",704132,0],["σοῦ",711945,133],["ἰσχύν",706858,9],["σου",711945,133],["καὶ",707031,7],["διαρπαγήσονται",703562,144],["αἱ",709436,190],["χῶραί",714011,191],["σου",711945,133]],"Therefore thus saith the Lord God; O Tyre, thy land shall be made desolate round about [thee]; and he shall bring down thy strength out of thee, and thy countries shall be spoiled."],["12",[["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὃν",709781,112],["τρόπον",712980,6],["ὅταν",709801,28],["ἐκσπάσῃ",704311,172],["ὁ",709436,3],["ποιμὴν",710596,4],["ἐκ",704132,0],["στόματος",712125,21],["τοῦ",709436,35],["λέοντος",708171,18],["δύο",703849,59],["σκέλη",711831,42],["ἢ",705924,7],["λοβὸν",708229,6],["ὠτίου",714165,21],["οὕτως",709859,28],["ἐκσπασθήσονται",704311,144],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["οἱ",709436,136],["κατοικοῦντες",707534,146],["ἐν",704639,0],["Σαμαρείᾳ",711449,1],["κατέναντι",707507,28],["φυλῆς",713620,17],["καὶ",707031,7],["ἐν",704639,0],["Δαμασκῷ",703275,111],["ἱερεῖς",706614,52]],"Thus saith the Lord; As when a shepherd rescues from the mouth of a lion two legs or a piece of an ear, so shall be drawn forth the children of Israel who dwell in Samaria in the presence of [a foreign] tribe, and in Damascus."],["13",[["ἀκούσατε",700587,74],["καὶ",707031,7],["ἐπιμαρτύρασθε",705197,186],["τῷ",709436,113],["οἴκῳ",709516,114],["Ιακωβ",706401,18],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["παντοκράτωρ",709986,4]],"Hear, O ye priests, and testify to the house of Jacob, saith the Lord God Almighty."],["14",[["διότι",703734,7],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ὅταν",709801,28],["ἐκδικῶ",704174,157],["ἀσεβείας",701904,17],["τοῦ",709436,35],["Ισραηλ",706839,18],["ἐπ᾿",705080,0],["αὐτόν",702165,85],["καὶ",707031,7],["ἐκδικήσω",704174,165],["ἐπὶ",705080,0],["τὰ",709436,41],["θυσιαστήρια",706348,42],["Βαιθηλ",702412,17],["καὶ",707031,7],["κατασκαφήσεται",707416,134],["τὰ",709436,41],["κέρατα",707625,42],["τοῦ",709436,20],["θυσιαστηρίου",706348,21],["καὶ",707031,7],["πεσοῦνται",710481,135],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9]],"For in the day wherein I shall take vengeance of the sins of Israel upon him, I will also take vengeance on the altars of Bæthel: and the horns of the altar shall be broken down, and they shall fall upon the ground."],["15",[["συγχεῶ",712243,165],["καὶ",707031,7],["πατάξω",710185,165],["τὸν",709436,5],["οἶκον",709516,6],["τὸν",709436,5],["περίπτερον",710372,27],["ἐπὶ",705080,0],["τὸν",709436,5],["οἶκον",709516,6],["τὸν",709436,5],["θερινόν",706207,27],["καὶ",707031,7],["ἀπολοῦνται",701513,135],["οἶκοι",709516,52],["ἐλεφάντινοι",704436,138],["καὶ",707031,7],["προστεθήσονται",710965,144],["οἶκοι",709516,52],["ἕτεροι",705535,138],["πολλοί",710646,138],["λέγει",708124,91],["κύριος",707996,4]],"I will crush and smite the turreted-house upon the summer-house; and the ivory-houses shall be destroyed, and many other houses also, saith the Lord."]]