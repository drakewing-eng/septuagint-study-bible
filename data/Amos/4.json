",[["εἰσήλθατε",704114,265],["εἰς",704105,0],["Βαιθηλ",702412,9],["καὶ",707031,7],["ἠνομήσατε",701190,265],["καὶ",707031,7],["εἰς",704105,0],["Γαλγαλα",702933,9],["ἐπληθύνατε",710530,265],["τοῦ",709436,20],["ἀσεβῆσαι",701906,106],["καὶ",707031,7],["ἠνέγκατε",713428,265],["εἰς",704105,0],["τὸ",709436,24],["πρωὶ",711021,28],["θυσίας",706345,39],["ὑμῶν",713091,145],["εἰς",704105,0],["τὴν",709436,8],["τριημερίαν",712944,9],["τὰ",709436,41],["ἐπιδέκατα",705114,68],["ὑμῶν",713091,145]],"Ye went into Bæthel, and sinned, and ye multiplied sin at Galgala; and ye brought your meat-offerings in the morning, [and] your tithes every third day."],["5",[["καὶ",707031,7],["ἀνέγνωσαν",700922,150],["ἔξω",704983,28],["νόμον",709349,6],["καὶ",707031,7],["ἐπεκαλέσαντο",705153,189],["ὁμολογίας",709633,39],["ἀπαγγείλατε",701321,74],["ὅτι",709803,7],["ταῦτα",709858,71],["ἠγάπησαν",700120,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεός",706192,4]],"And they read the law without, and called for public professions: proclaim aloud that the children of Israel have loved these things, saith the Lord."],["6",[["καὶ",707031,7],["ἐγὼ",704018,164],["δώσω",703654,165],["ὑμῖν",713084,90],["γομφιασμὸν",703168,6],["ὀδόντων",709461,81],["ἐν",704639,0],["πάσαις",710177,291],["ταῖς",709436,75],["πόλεσιν",710612,76],["ὑμῶν",713091,145],["καὶ",707031,7],["ἔνδειαν",704672,9],["ἄρτων",701829,81],["ἐν",704639,0],["πᾶσι",710177,230],["τοῖς",709436,147],["τόποις",712903,148],["ὑμῶν",713091,145],["καὶ",707031,7],["οὐκ",709805,28],["ἐπεστρέψατε",705278,265],["πρός",710844,0],["με",708618,163],["λέγει",708124,91],["κύριος",707996,4]],"And I will give you dulness of teeth in all your cities, and want of bread in all your places: yet ye returned not to me, saith the Lord."],["7",[["καὶ",707031,7],["ἐγὼ",704018,164],["ἀνέσχον",701140,155],["ἐξ",704132,0],["ὑμῶν",713091,145],["τὸν",709436,5],["ὑετὸν",713074,6],["πρὸ",710747,0],["τριῶν",712927,169],["μηνῶν",708874,81],["τοῦ",709436,35],["τρυγήτου",712998,18],["καὶ",707031,7],["βρέξω",702812,165],["ἐπὶ",705080,0],["πόλιν",710612,9],["μίαν",704106,36],["ἐπὶ",705080,0],["δὲ",703303,11],["πόλιν",710612,9],["μίαν",704106,36],["οὐ",709805,28],["βρέξω",702812,165],["μερὶς",708748,12],["μία",704106,29],["βραχήσεται",702812,134],["καὶ",707031,7],["μερίς",708748,12],["ἐφ᾿",705080,0],["ἣν",709781,131],["οὐ",709805,28],["βρέξω",702812,165],["ἐπ᾿",705080,0],["αὐτήν",702165,104],["ξηρανθήσεται",709419,134]],"Also I withheld from you the rain three months before the harvest: and I will rain upon one city, and on another city I will not rain: one part shall be rained upon, and the part on which I shall not rain shall be dried up."],["8",[["καὶ",707031,7],["συναθροισθήσονται",712378,144],["δύο",703849,59],["καὶ",707031,7],["τρεῖς",712927,192],["πόλεις",710612,191],["εἰς",704105,0],["πόλιν",710612,9],["μίαν",704106,36],["τοῦ",709436,20],["πιεῖν",710478,106],["ὕδωρ",713071,25],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἐμπλησθῶσιν",704592,272],["καὶ",707031,7],["οὐκ",709805,28],["ἐπεστρέψατε",705278,265],["πρός",710844,0],["με",708618,163],["λέγει",708124,91],["κύριος",707996,4]],"And [the inhabitants of] two or three cities shall be gathered to one city to drink water, and they shall not be satisfied: yet ye have not returned to me, saith the Lord."],["9",[["ἐπάταξα",710185,155],["ὑμᾶς",713080,194],["ἐν",704639,0],["πυρώσει",711114,1,76],["καὶ",707031,7],["ἐν",704639,0],["ἰκτέρῳ",706720,114],["ἐπληθύνατε",710530,265],["κήπους",707654,57],["ὑμῶν",713091,145],["ἀμπελῶνας",700872,57],["ὑμῶν",713091,145],["καὶ",707031,7],["συκῶνας",712259,57],["ὑμῶν",713091,145],["καὶ",707031,7],["ἐλαιῶνας",704381,57],["ὑμῶν",713091,145],["κατέφαγεν",707519,2],["ἡ",709436,10],["κάμπη",707117,12],["καὶ",707031,7],["οὐδ᾿",709816,7],["ὧς",714148,7],["ἐπεστρέψατε",705278,265],["πρός",710844,0],["με",708618,163],["λέγει",708124,91],["κύριος",707996,4]],"I smote you with parching, and with blight: ye multiplied your gardens, your vineyards, and your fig-grounds, and the cankerworm devoured your oliveyards: yet not [even] thus did ye return to me, saith the Lord."],["10",[["ἐξαπέστειλα",704872,155],["εἰς",704105,0],["ὑμᾶς",713080,194],["θάνατον",706096,6],["ἐν",704639,0],["ὁδῷ",709458,1],["Αἰγύπτου",700401,17],["καὶ",707031,7],["ἀπέκτεινα",701498,155],["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["τοὺς",709436,58],["νεανίσκους",709232,57],["ὑμῶν",713091,145],["μετὰ",708780,0],["αἰχμαλωσίας",700499,17],["ἵππων",706790,81],["σου",711945,133],["καὶ",707031,7],["ἀνήγαγον",700933,155],["ἐν",704639,0],["πυρὶ",711088,54],["τὰς",709436,38],["παρεμβολὰς",710133,39],["ὑμῶν",713091,145],["ἐν",704639,0],["τῇ",709436,100],["ὀργῇ",709728,1],["μου",709032,133],["καὶ",707031,7],["οὐδ᾿",709816,7],["ὧς",714148,7],["ἐπεστρέψατε",705278,265],["πρός",710844,0],["με",708618,163],["λέγει",708124,91],["κύριος",707996,4]],"I sent pestilence among you by the way of Egypt, and slew your young men with the sword, together with thy horses that were taken captive; and in my wrath against you I set fire to your camps: yet not even thus did ye return to me, saith the Lord."],["11",[["κατέστρεψα",707444,155],["ὑμᾶς",713080,194],["καθὼς",707030,28],["κατέστρεψεν",707444,2],["ὁ",709436,3],["θεὸς",706192,4],["Σοδομα",711920,227],["καὶ",707031,7],["Γομορρα",703165,227],["καὶ",707031,7],["ἐγένεσθε",703104,345],["ὡς",714148,7],["δαλὸς",703268,4],["ἐξεσπασμένος",704311,419],["ἐκ",704132,0],["πυρός",711088,21],["καὶ",707031,7],["οὐδ᾿",709816,7],["ὧς",714148,7],["ἐπεστρέψατε",705278,265],["πρός",710844,0],["με",708618,163],["λέγει",708124,91],["κύριος",707996,4]],"I overthrew you, as God overthrew Sodoma and Gomorrha, and ye became as a brand plucked out of the fire: yet not even thus did ye return to me, saith the Lord."],["12",[["διὰ",703417,0],["τοῦτο",709858,129],["οὕτως",709859,28],["ποιήσω",710582,165],["σοι",711925,159],["Ισραηλ",706839,153],["πλὴν",710540,28],["ὅτι",709803,7],["οὕτως",709859,28],["ποιήσω",710582,165],["σοι",711925,159],["ἑτοιμάζου",705539,253],["τοῦ",709436,20],["ἐπικαλεῖσθαι",705153,110],["τὸν",709436,5],["θεόν",706192,6],["σου",711945,133],["Ισραηλ",706839,153]],"Therefore thus will I do to thee, O Israel: nay because I will do thus to thee, prepare to call on thy God, O Israel."],["13",[["διότι",703734,7],["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["στερεῶν",712076,72],["βροντὴν",702816,9],["καὶ",707031,7],["κτίζων",707938,72],["πνεῦμα",710566,25],["καὶ",707031,7],["ἀπαγγέλλων",701321,72],["εἰς",704105,0],["ἀνθρώπους",701163,57],["τὸν",709436,5],["χριστὸν",713964,27],["αὐτοῦ",702165,102],["ποιῶν",710582,72],["ὄρθρον",709745,6],["καὶ",707031,7],["ὁμίχλην",709615,9],["καὶ",707031,7],["ἐπιβαίνων",705082,72],["ἐπὶ",705080,0],["τὰ",709436,41],["ὕψη",713288,42],["τῆς",709436,16],["γῆς",703083,17],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["παντοκράτωρ",709986,4],["ὄνομα",709666,15],["αὐτῷ",702165,50]],"For, behold, I am he that strengthens the thunder, and creates the wind, and proclaims to men his Christ, forming the morning and the darkness, and mounting on the high places of the earth, The Lord God Almighty is his name."]]