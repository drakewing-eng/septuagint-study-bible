[["1",[["ἀκούσατε",700587,74],["τὸν",709436,5],["λόγον",708236,6],["κυρίου",707996,18],["τοῦτον",709858,85],["ὃν",709781,112],["ἐγὼ",704018,164],["λαμβάνω",708076,157],["ἐφ᾿",705080,0],["ὑμᾶς",713080,194],["θρῆνον",706309,6],["οἶκος",709516,4],["Ισραηλ",706839,18]],"Hear ye this word of the Lord, even a lamentation, which I take up against you. The house of Israel is fallen; it shall no more rise."],["2",[["ἔπεσεν",710481,2],["οὐκέτι",709827,28],["μὴ",708851,28],["προσθῇ",710965,172],["τοῦ",709436,20],["ἀναστῆναι",701173,106],["παρθένος",710148,12],["τοῦ",709436,35],["Ισραηλ",706839,18],["ἔσφαλεν",712575,2],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["αὐτῆς",702165,86],["οὐκ",709805,28],["ἔστιν",704093,91],["ὁ",709436,3],["ἀναστήσων",701173,512],["αὐτήν",702165,104]],"The virgin of Israel has fallen upon his land; there is none that shall raise her up."],["3",[["διότι",703734,7],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["κύριος",707996,4],["ἡ",709436,10],["πόλις",710612,12],["ἐξ",704132,0],["ἧς",709781,167],["ἐξεπορεύοντο",704293,139],["χίλιοι",713859,138],["ὑπολειφθήσονται",713212,144],["ἑκατόν",704136,59],["καὶ",707031,7],["ἐξ",704132,0],["ἧς",709781,167],["ἐξεπορεύοντο",704293,139],["ἑκατόν",704136,59],["ὑπολειφθήσονται",713212,144],["δέκα",703333,59],["τῷ",709436,113],["οἴκῳ",709516,114],["Ισραηλ",706839,18]],"Therefore thus saith the Lord God; The city out of which there went forth a thousand, [in it] there shall be left a hundred, and [in that] out of which there went forth a hundred, there shall be left ten to the house of Israel."],["4",[["διότι",703734,7],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["πρὸς",710844,0],["τὸν",709436,5],["οἶκον",709516,6],["Ισραηλ",706839,18],["ἐκζητήσατέ",704187,74],["με",708618,163],["καὶ",707031,7],["ζήσεσθε",705851,124]],"Wherefore thus saith the Lord to the house of Israel, Seek ye me, and ye shall live."],["5",[["καὶ",707031,7],["μὴ",708851,28],["ἐκζητεῖτε",704187,87],["Βαιθηλ",702412,9],["καὶ",707031,7],["εἰς",704105,0],["Γαλγαλα",702933,9],["μὴ",708851,28],["εἰσπορεύεσθε",704124,73],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸ",709436,24],["φρέαρ",713576,25],["τοῦ",709436,35],["ὅρκου",709753,18],["μὴ",708851,28],["διαβαίνετε",703419,335],["ὅτι",709803,7],["Γαλγαλα",702933,12],["αἰχμαλωτευομένη",700500,473],["αἰχμαλωτευθήσεται",700500,134],["καὶ",707031,7],["Βαιθηλ",702412,12],["ἔσται",704093,93],["ὡς",714148,7],["οὐχ",709805,28],["ὑπάρχουσα",713104,188]],"But seek not Bæthel, and go not in to Galgala, and cross not over to the Well of the Oath: for Galgala shall surely go into captivity, and Bæthel shall be as that which is not."],["6",[["ἐκζητήσατε",704187,74],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["ζήσατε",705851,74],["ὅπως",709719,7],["μὴ",708851,28],["ἀναλάμψῃ",700985,172],["ὡς",714148,7],["πῦρ",711088,15],["ὁ",709436,3],["οἶκος",709516,4],["Ιωσηφ",706948,18],["καὶ",707031,7],["καταφάγεται",707519,93],["αὐτόν",702165,85],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ὁ",709436,3],["σβέσων",711596,512],["τῷ",709436,113],["οἴκῳ",709516,114],["Ισραηλ",706839,18]],"Seek ye the Lord, and ye shall live; lest the house of Joseph blaze as fire, and it devour him, and there shall be none to quench it for the house of Israel."],["7",[["κύριος",707996,4],["ὁ",709436,3],["ποιῶν",710582,72],["εἰς",704105,0],["ὕψος",713288,25],["κρίμα",707903,25],["καὶ",707031,7],["δικαιοσύνην",703695,9],["εἰς",704105,0],["γῆν",703083,9],["ἔθηκεν",712849,2]],"[It is he] that executes judgment in the height [above], and he has established justice on the earth:"],["8",[["ποιῶν",710582,72],["πάντα",710177,68],["καὶ",707031,7],["μετασκευάζων",708816,72],["καὶ",707031,7],["ἐκτρέπων",704341,72],["εἰς",704105,0],["τὸ",709436,24],["πρωὶ",711021,28],["σκιὰν",711852,9],["θανάτου",706096,18],["καὶ",707031,7],["ἡμέραν",705984,9],["εἰς",704105,0],["νύκτα",709386,9],["συσκοτάζων",712551,72],["ὁ",709436,3],["προσκαλούμενος",710912,122],["τὸ",709436,24],["ὕδωρ",713071,25],["τῆς",709436,16],["θαλάσσης",706069,17],["καὶ",707031,7],["ἐκχέων",704368,72],["αὐτὸ",702165,129],["ἐπὶ",705080,0],["προσώπου",710986,21],["τῆς",709436,16],["γῆς",703083,17],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["παντοκράτωρ",709986,4],["ὄνομα",709666,15],["αὐτῷ",702165,50]],"who makes all things, and changes [them], and turns darkness into the morning, and darkens the day into night: who calls for the water of the sea, and pours it out on the face of the earth: the Lord is his name:"],["9",[["ὁ",709436,3],["διαιρῶν",703459,72],["συντριμμὸν",712522,6],["ἐπ᾿",705080,0],["ἰσχὺν",706858,9],["καὶ",707031,7],["ταλαιπωρίαν",712695,9],["ἐπὶ",705080,0],["ὀχύρωμα",709891,25],["ἐπάγων",704994,72]],"who dispenses ruin to strength, and brings distress upon the fortress."],["10",[["ἐμίσησαν",708935,150],["ἐν",704639,0],["πύλαις",711082,76],["ἐλέγχοντα",704416,183],["καὶ",707031,7],["λόγον",708236,6],["ὅσιον",709782,27],["ἐβδελύξαντο",702608,189]],"They hated him that reproved in the gates, and abhorred holy speech."],["11",[["διὰ",703417,0],["τοῦτο",709858,129],["ἀνθ᾿",701227,0],["ὧν",709781,252],["κατεκονδυλίζετε",707281,399],["πτωχοὺς",711076,57],["καὶ",707031,7],["δῶρα",703907,42],["ἐκλεκτὰ",704240,68],["ἐδέξασθε",703393,345],["παρ᾿",709995,0],["αὐτῶν",702165,40],["οἴκους",709516,57],["ξυστοὺς",709434,60],["ᾠκοδομήσατε",709509,265],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["κατοικήσητε",707534,125],["ἐν",704639,0],["αὐτοῖς",702165,151],["ἀμπελῶνας",700872,57],["ἐπιθυμητοὺς",705146,60],["ἐφυτεύσατε",713636,265],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["πίητε",710478,125],["τὸν",709436,5],["οἶνον",709530,6],["ἐξ",704132,0],["αὐτῶν",702165,40]],"Therefore because they have smitten the poor with their fists, and ye have received of them choice gifts; ye have built polished houses, but ye shall not dwell in them; ye have planted desirable vineyards, but ye shall not drink the wine of them."],["12",[["ὅτι",709803,7],["ἔγνων",703105,155],["πολλὰς",710646,119],["ἀσεβείας",701904,39],["ὑμῶν",713091,145],["καὶ",707031,7],["ἰσχυραὶ",706855,192],["αἱ",709436,190],["ἁμαρτίαι",700775,191],["ὑμῶν",713091,145],["καταπατοῦντες",707360,146],["δίκαιον",703694,27],["λαμβάνοντες",708076,146],["ἀλλάγματα",700682,42],["καὶ",707031,7],["πένητας",710248,57],["ἐν",704639,0],["πύλαις",711082,76],["ἐκκλίνοντες",704220,146]],"For I know your many transgressions, and your sins are great, trampling on the just, taking bribes, and turning aside [the judgment of] the poor in the gates."],["13",[["διὰ",703417,0],["τοῦτο",709858,129],["ὁ",709436,3],["συνίων",712481,72],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["σιωπήσεται",711818,93],["ὅτι",709803,7],["καιρὸς",707047,4],["πονηρός",710660,14],["ἐστιν",704093,91]],"Therefore the prudent shall be silent at that time; for it is a time of evils."],["14",[["ἐκζητήσατε",704187,74],["τὸ",709436,24],["καλὸν",707097,46],["καὶ",707031,7],["μὴ",708851,28],["τὸ",709436,24],["πονηρόν",710660,46],["ὅπως",709719,7],["ζήσητε",705851,125],["καὶ",707031,7],["ἔσται",704093,93],["οὕτως",709859,28],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["παντοκράτωρ",709986,4],["ὃν",709781,112],["τρόπον",712980,6],["εἴπατε",705373,265]],"Seek good, and not evil, that ye may live: and so the Lord God Almighty shall be with you, as ye have said,"],["15",[["μεμισήκαμεν",708935,314],["τὰ",709436,41],["πονηρὰ",710660,68],["καὶ",707031,7],["ἠγαπήκαμεν",700120,314],["τὰ",709436,41],["καλά",707097,68],["καὶ",707031,7],["ἀποκαταστήσατε",701470,74],["ἐν",704639,0],["πύλαις",711082,76],["κρίμα",707903,25],["ὅπως",709719,7],["ἐλεήσῃ",704418,45],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["παντοκράτωρ",709986,4],["τοὺς",709436,58],["περιλοίπους",710345,60],["τοῦ",709436,35],["Ιωσηφ",706948,18]],"We have hated evil, and loved good: and restore ye judgment in the gates; that the Lord God Almighty may have mercy on the remnant of Joseph."],["16",[["διὰ",703417,0],["τοῦτο",709858,129],["τάδε",709446,71],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["παντοκράτωρ",709986,4],["ἐν",704639,0],["πάσαις",710177,291],["πλατείαις",710509,291],["κοπετός",707821,4],["καὶ",707031,7],["ἐν",704639,0],["πάσαις",710177,291],["ὁδοῖς",709458,76],["ῥηθήσεται",705415,134],["οὐαὶ",709807,88],["οὐαί",709807,88],["κληθήσεται",707084,134],["γεωργὸς",703082,4],["εἰς",704105,0],["πένθος",710253,25],["καὶ",707031,7],["κοπετὸν",707821,6],["καὶ",707031,7],["εἰς",704105,0],["εἰδότας",704075,277],["θρῆνον",706309,6]],"Therefore thus saith the Lord God Almighty; In all the streets [shall be] lamentations; and in all the ways shall it be said, Woe, woe! the husbandman shall be called to mourning and lamentation, and to them that are skilled in complaining."],["17",[["καὶ",707031,7],["ἐν",704639,0],["πάσαις",710177,291],["ὁδοῖς",709458,76],["κοπετός",707821,4],["διότι",703734,7],["διελεύσομαι",703673,181],["διὰ",703417,0],["μέσου",708768,92],["σου",711945,133],["εἶπεν",705373,2],["κύριος",707996,4]],"And [there shall be] lamentation in all the ways; because I will pass through the midst of thee, saith the Lord."],["18",[["οὐαὶ",709807,88],["οἱ",709436,136],["ἐπιθυμοῦντες",705141,146],["τὴν",709436,8],["ἡμέραν",705984,9],["κυρίου",707996,18],["ἵνα",706747,7],["τί",712867,126],["αὕτη",709858,107],["ὑμῖν",713084,90],["ἡ",709436,10],["ἡμέρα",705984,12],["τοῦ",709436,35],["κυρίου",707996,18],["καὶ",707031,7],["αὐτή",702165,107],["ἐστιν",704093,91],["σκότος",711889,15],["καὶ",707031,7],["οὐ",709805,28],["φῶς",713642,15]],"Woe to you that desire the day of the Lord! what is this day of the Lord to you? whereas it is darkness, and not light."],["19",[["ὃν",709781,112],["τρόπον",712980,6],["ὅταν",709801,28],["φύγῃ",713433,172],["ἄνθρωπος",701163,4],["ἐκ",704132,0],["προσώπου",710986,21],["τοῦ",709436,35],["λέοντος",708171,18],["καὶ",707031,7],["ἐμπέσῃ",704593,123],["αὐτῷ",702165,50],["ἡ",709436,10],["ἄρκος",701766,12],["καὶ",707031,7],["εἰσπηδήσῃ",704122,172],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀπερείσηται",701394,239],["τὰς",709436,38],["χεῖρας",713787,39],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τὸν",709436,5],["τοῖχον",712879,6],["καὶ",707031,7],["δάκῃ",703254,172],["αὐτὸν",702165,85],["ὁ",709436,3],["ὄφις",709875,4]],"As if a man should flee from the face of a lion, and a bear should meet him; and he should spring into his house, and lean his hands upon the wall, and a serpent should bite him."],["20",[["οὐχὶ",709862,28],["σκότος",711889,15],["ἡ",709436,10],["ἡμέρα",705984,12],["τοῦ",709436,35],["κυρίου",707996,18],["καὶ",707031,7],["οὐ",709805,28],["φῶς",713642,15],["καὶ",707031,7],["γνόφος",703131,4],["οὐκ",709805,28],["ἔχων",705785,72],["φέγγος",713404,25],["αὐτῇ",702165,105]],"Is not the day of the Lord darkness, and not light? and is not this [day] gloom without brightness?"],["21",[["μεμίσηκα",708935,89],["ἀπῶσμαι",701659,326],["ἑορτὰς",704990,39],["ὑμῶν",713091,145],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ὀσφρανθῶ",709798,321],["ἐν",704639,0],["ταῖς",709436,75],["πανηγύρεσιν",709963,76],["ὑμῶν",713091,145]],"I hate, I reject your feasts, and I will not smell [your] meat-offerings in your general assemblies."],["22",[["διότι",703734,7],["καὶ",707031,7],["ἐὰν",703912,7],["ἐνέγκητέ",713428,125],["μοι",708974,159],["ὁλοκαυτώματα",709589,42],["καὶ",707031,7],["θυσίας",706345,39],["ὑμῶν",713091,145],["οὐ",709805,28],["προσδέξομαι",710874,181],["αὐτά",702165,71],["καὶ",707031,7],["σωτηρίου",712659,21],["ἐπιφανείας",705318,39],["ὑμῶν",713091,145],["οὐκ",709805,28],["ἐπιβλέψομαι",705088,181]],"Wherefore if ye should bring me your whole-burnt-sacrifices and meat-offerings, I will not accept [them]: neither will I have respect to your grand peace-offerings."],["23",[["μετάστησον",708668,176],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["ἦχον",706046,6],["ᾠδῶν",714091,65],["σου",711945,133],["καὶ",707031,7],["ψαλμὸν",714022,6],["ὀργάνων",709727,44],["σου",711945,133],["οὐκ",709805,28],["ἀκούσομαι",700587,181]],"Remove from me the sound of thy songs, and I will not hear the music of thine instruments."],["24",[["καὶ",707031,7],["κυλισθήσεται",707967,134],["ὡς",714148,7],["ὕδωρ",713071,15],["κρίμα",707903,15],["καὶ",707031,7],["δικαιοσύνη",703695,12],["ὡς",714148,7],["χειμάρρους",713783,14],["ἄβατος",700023,14]],"But let judgment roll down as water, and righteousness as an impassable torrent."],["25",[["μὴ",708851,28],["σφάγια",712570,42],["καὶ",707031,7],["θυσίας",706345,39],["προσηνέγκατέ",710974,265],["μοι",708974,159],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1],["τεσσαράκοντα",712806,59],["ἔτη",705543,42],["οἶκος",709516,4],["Ισραηλ",706839,18]],"Have ye offered to me victims and sacrifices, O house of Israel, forty years in the wilderness?"],["26",[["καὶ",707031,7],["ἀνελάβετε",700984,265],["τὴν",709436,8],["σκηνὴν",711845,9],["τοῦ",709436,35],["Μολοχ",708984,118],["καὶ",707031,7],["τὸ",709436,24],["ἄστρον",702024,25],["τοῦ",709436,35],["θεοῦ",706192,18],["ὑμῶν",713091,145],["Ραιφαν",711159,118],["τοὺς",709436,58],["τύπους",713020,57],["αὐτῶν",702165,40],["οὓς",709781,298],["ἐποιήσατε",710582,265],["ἑαυτοῖς",703917,151]],"Yea, ye took up the tabernacle of Moloch, and the star of your god Ræphan, the images of them which ye made for yourselves."],["27",[["καὶ",707031,7],["μετοικιῶ",708835,165],["ὑμᾶς",713080,194],["ἐπέκεινα",705062,28],["Δαμασκοῦ",703275,118],["λέγει",708124,91],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["παντοκράτωρ",709986,4],["ὄνομα",709666,15],["αὐτῷ",702165,50]],"And I will carry you away beyond Damascus, saith the Lord, the Almighty God is his name."]]