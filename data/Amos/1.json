701227,0],["ὧν",709781,252],["ἀνέσχιζον",701063,137],["τὰς",709436,38],["ἐν",704639,0],["γαστρὶ",702976,1],["ἐχούσας",705785,338],["τῶν",709436,80],["Γαλααδιτῶν",702925,81],["ὅπως",709719,7],["ἐμπλατύνωσιν",704596,271],["τὰ",709436,41],["ὅρια",709749,42],["αὐτῶν",702165,40]],"Thus saith the Lord; For three sins of the children of Ammon, and for four, I will not turn away from him; because they ripped up the women with child of the Galaadites, that they might widen their coasts."],["14",[["καὶ",707031,7],["ἀνάψω",701044,165],["πῦρ",711088,25],["ἐπὶ",705080,0],["τὰ",709436,41],["τείχη",712759,42],["Ραββα",711131,118],["καὶ",707031,7],["καταφάγεται",707519,93],["θεμέλια",706181,42],["αὐτῆς",702165,86],["μετὰ",708780,0],["κραυγῆς",707886,17],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["πολέμου",710605,18],["καὶ",707031,7],["σεισθήσεται",711633,134],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["συντελείας",712509,17],["αὐτῆς",702165,86]],"And I will kindle a fire on the walls of Rabbath, and it shall devour her foundations with shouting in the day of war, and she shall be shaken in the days of her destruction:"],["15",[["καὶ",707031,7],["πορεύσονται",710667,135],["οἱ",709436,136],["βασιλεῖς",702580,52],["αὐτῆς",702165,86],["ἐν",704639,0],["αἰχμαλωσίᾳ",700499,1],["οἱ",709436,136],["ἱερεῖς",706614,52],["αὐτῶν",702165,40],["καὶ",707031,7],["οἱ",709436,136],["ἄρχοντες",701862,52],["αὐτῶν",702165,40],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτό",702165,129],["λέγει",708124,91],["κύριος",707996,4]],"and her kings shall go into captivity, their priests and their rulers together, saith the Lord."]]