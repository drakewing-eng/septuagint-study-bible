[["1",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Ιωβ",706903,4],["λέγει",708124,91]],"Then Job answered and said,"],["2",[["ἕως",705792,0],["τίνος",712867,340],["ἔγκοπον",703983,36],["ποιήσετε",710582,337],["ψυχήν",714070,9],["μου",709032,133],["καὶ",707031,7],["καθαιρεῖτε",706982,87],["με",708618,163],["λόγοις",708236,148]],"How long will ye vex my soul, and destroy me with words? only know that the Lord has dealt with me thus.",{"s":"d","q":0.59}],["3",[["γνῶτε",703105,74],["μόνον",709001,28],["ὅτι",709803,7],["ὁ",709436,3],["κύριος",707996,4],["ἐποίησέ",710582,2],["με",708618,163],["οὕτως",709859,28],["καταλαλεῖτέ",707298,87],["μου",709032,133],["οὐκ",709805,28],["αἰσχυνόμενοί",700485,348],["με",708618,163],["ἐπίκεισθέ",705160,374],["μοι",708974,159]],"Ye speak against me; ye do not feel for me, but bear hard upon me.",{"s":"d","q":0.47}],["4",[["ναὶ",709173,11],["δὴ",703395,11],["ἐπ᾿",705080,0],["ἀληθείας",700656,17],["ἐγὼ",704018,164],["ἐπλανήθην",710495,156],["παρ᾿",709995,0],["ἐμοὶ",704577,159],["δὲ",703303,11],["αὐλίζεται",702138,117],["πλάνος",710500,14]],"Yea verily, I have erred in truth, (but the error abides with myself)"],["4a",[["λαλῆσαι",708071,106],["ῥῆμα",711246,25],["ὃ",709781,128],["οὐκ",709805,28],["ἔδει",703312,13],["τὰ",709436,63],["δὲ",703303,11],["ῥήματά",711246,64],["μου",709032,133],["πλανᾶται",710495,117],["καὶ",707031,7],["οὐκ",709805,28],["ἐπὶ",705080,0],["καιροῦ",707047,18]],null],["5",[["ἔα",703911,88],["δὲ",703303,11],["ὅτι",709803,7],["ἐπ᾿",705080,0],["ἐμοὶ",704577,159],["μεγαλύνεσθε",708647,374],["ἐνάλλεσθε",704652,374],["δέ",703303,11],["μοι",708974,159],["ὀνείδει",709658,54]],"But alas! for ye magnify yourselves against me, and insult me with reproach."],["6",[["γνῶτε",703105,74],["οὖν",709835,11],["ὅτι",709803,7],["ὁ",709436,3],["κύριός",707996,4],["ἐστιν",704093,91],["ὁ",709436,3],["ταράξας",712721,182],["ὀχύρωμα",709891,25],["δὲ",703303,11],["αὐτοῦ",702165,102],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ὕψωσεν",713289,2]],"Know then that it is the Lord that has troubled [me], and has raised his bulwark against me."],["7",[["ἰδοὺ",706497,88],["γελῶ",703019,157],["ὀνείδει",709658,54],["καὶ",707031,7],["οὐ",709805,28],["λαλήσω",708071,165],["κεκράξομαι",707868,181],["καὶ",707031,7],["οὐδαμοῦ",709813,28],["κρίμα",707903,15]],"Behold, I laugh at reproach; I will not speak: [or] I will cry out, but [there is] nowhere judgment."],["8",[["κύκλῳ",707959,114],["περιῳκοδόμημαι",710354,584],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["διαβῶ",703419,207],["ἐπὶ",705080,0],["πρόσωπόν",710986,25],["μου",709032,133],["σκότος",711889,25],["ἔθετο",712849,23]],"I am fenced round about, and can by no means escape: he has set darkness before my face."],["9",[["τὴν",709436,8],["δὲ",703303,11],["δόξαν",703791,9],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["ἐξέδυσεν",704180,2],["ἀφεῖλεν",702177,2],["δὲ",703303,11],["στέφανον",712083,6],["ἀπὸ",701425,0],["κεφαλῆς",707639,17],["μου",709032,133]],"And he has stripped me of my glory, and has taken the crown from my head."],["10",[["διέσπασέν",703583,2],["με",708618,163],["κύκλῳ",707959,114],["καὶ",707031,7],["ᾠχόμην",709539,334],["ἐξέκοψεν",704225,2],["δὲ",703303,11],["ὥσπερ",714163,28],["δένδρον",703353,25],["τὴν",709436,8],["ἐλπίδα",704530,9],["μου",709032,133]],"He has torn me round about, and I am gone: and he has cut off my hope like a tree."],["11",[["δεινῶς",703329,28],["δέ",703303,11],["μοι",708974,159],["ὀργῇ",709728,1],["ἐχρήσατο",713937,23],["ἡγήσατο",705931,23],["δέ",703303,11],["με",708618,163],["ὥσπερ",714163,28],["ἐχθρόν",705779,6]],"And he has dreadfully handled me in anger, and has counted me for an enemy."],["12",[["ὁμοθυμαδὸν",709624,28],["δὲ",703303,11],["ἦλθον",705453,150],["τὰ",709436,63],["πειρατήρια",710228,64],["αὐτοῦ",702165,102],["ἐπ᾿",705080,0],["ἐμοὶ",704577,159],["ταῖς",709436,75],["ὁδοῖς",709458,76],["μου",709032,133],["ἐκύκλωσάν",707958,150],["με",708618,163],["ἐγκάθετοι",703951,14]],"His troops also came upon me with one accord, liers in wait compassed my ways."],["13",[["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["δὲ",703303,11],["ἀδελφοί",700249,52],["μου",709032,133],["ἀπέστησαν",702214,150],["ἔγνωσαν",703105,150],["ἀλλοτρίους",700699,60],["ἢ",705924,7],["ἐμέ",704555,163],["φίλοι",713492,138],["δέ",703303,11],["μου",709032,133],["ἀνελεήμονες",701120,52],["γεγόνασιν",703104,353]],"My brethren have stood aloof from me; they have recognised strangers [rather] than me: and my friends have become pitiless."],["14",[["οὐ",709805,28],["προσεποιήσαντό",710953,189],["με",708618,163],["οἱ",709436,136],["ἐγγύτατοί",703948,480],["μου",709032,133],["καὶ",707031,7],["οἱ",709436,136],["εἰδότες",709492,268],["μου",709032,133],["τὸ",709436,24],["ὄνομα",709666,25],["ἐπελάθοντό",705187,189],["μου",709032,133]],"My nearest of kin have not acknowledged me, and they that knew my name, have forgotten me."],["15",[["γείτονες",703016,52],["οἰκίας",709505,17],["θεράπαιναί",706197,191],["τέ",712751,11],["μου",709032,133],["ἀλλογενὴς",700690,14],["ἤμην",704093,334],["ἐναντίον",704654,0],["αὐτῶν",702165,40]],"[As for] my household, and my maid-servants, I was a stranger before them."],["16",[["θεράποντά",706201,6],["μου",709032,133],["ἐκάλεσα",707084,155],["καὶ",707031,7],["οὐχ",709805,28],["ὑπήκουσεν",713096,2],["στόμα",712125,15],["δέ",703303,11],["μου",709032,133],["ἐδέετο",703361,19]],"I called my servant, and he hearkened not; and my mouth intreated [him]."],["17",[["καὶ",707031,7],["ἱκέτευον",706716,333],["τὴν",709436,8],["γυναῖκά",703209,9],["μου",709032,133],["προσεκαλούμην",710912,334],["δὲ",703303,11],["κολακεύων",707787,72],["υἱοὺς",713075,57],["παλλακίδων",709944,65],["μου",709032,133]],"And I besought my wife, and earnestly intreated the sons of my concubines."],["18",[["οἱ",709436,136],["δὲ",703303,11],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνά",700504,6],["με",708618,163],["ἀπεποιήσαντο",701552,189],["ὅταν",709801,28],["ἀναστῶ",701173,207],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["λαλοῦσιν",708071,197]],"But they rejected me for ever; whenever I rise up, they speak against me."],["19",[["ἐβδελύξαντο",702608,189],["δέ",703303,11],["με",708618,163],["οἱ",709436,136],["εἰδότες",709492,268],["με",708618,163],["οὓς",709781,298],["δὴ",703395,11],["ἠγαπήκειν",700120,499],["ἐπανέστησάν",705026,150],["μοι",708974,159]],"They that saw me abhorred me: the very persons whom I had loved, rose up against me."],["20",[["ἐν",704639,0],["δέρματί",703363,54],["μου",709032,133],["ἐσάπησαν",711754,150],["αἱ",709436,190],["σάρκες",711537,191],["μου",709032,133],["τὰ",709436,63],["δὲ",703303,11],["ὀστᾶ",709792,64],["μου",709032,133],["ἐν",704639,0],["ὀδοῦσιν",709461,148],["ἔχεται",705785,117]],"My flesh is corrupt under my skin, and my bones are held in [my] teeth."],["21",[["ἐλεήσατέ",704418,74],["με",708618,163],["ἐλεήσατέ",704418,74],["με",708618,163],["ὦ",714081,88],["φίλοι",713492,138],["χεὶρ",713787,12],["γὰρ",702963,11],["κυρίου",707996,18],["ἡ",709436,10],["ἁψαμένη",701654,357],["μού",709032,133],["ἐστιν",704093,91]],"Pity me, pity me, O friends; for it is the hand of the Lord that has touched me."],["22",[["διὰ",703417,0],["τί",712867,126],["δέ",703303,11],["με",708618,163],["διώκετε",703768,87],["ὥσπερ",714163,28],["καὶ",707031,7],["ὁ",709436,3],["κύριος",707996,4],["ἀπὸ",701425,0],["δὲ",703303,11],["σαρκῶν",711537,65],["μου",709032,133],["οὐκ",709805,28],["ἐμπίπλασθε",704592,753]],"Wherefore do ye persecute me as also the Lord [does], and are not satisfied with my flesh?"],["23",[["τίς",712867,158],["γὰρ",702963,11],["ἂν",700900,11],["δῴη",703654,225],["γραφῆναι",703194,179],["τὰ",709436,63],["ῥήματά",711246,64],["μου",709032,133],["τεθῆναι",712849,179],["δὲ",703303,11],["αὐτὰ",702165,71],["ἐν",704639,0],["βιβλίῳ",702719,54],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6]],"For oh that my words were written, and that they were recorded in a book for ever,"],["24",[["ἐν",704639,0],["γραφείῳ",703190,54],["σιδηρῷ",711771,97],["καὶ",707031,7],["μολίβῳ",708981,114],["ἢ",705924,7],["ἐν",704639,0],["πέτραις",710443,76],["ἐγγλυφῆναι",703941,179]],"with an iron pen and lead, or graven in the rocks!"],["25",[["οἶδα",709492,89],["γὰρ",702963,11],["ὅτι",709803,7],["ἀέναός",700313,14],["ἐστιν",704093,91],["ὁ",709436,3],["ἐκλύειν",704254,55],["με",708618,163],["μέλλων",708705,72],["ἐπὶ",705080,0],["γῆς",703083,17]],"For I know that he is eternal who is about to deliver me,"],["26",[["ἀναστήσαι",701173,225],["τὸ",709436,24],["δέρμα",703363,25],["μου",709032,133],["τὸ",709436,24],["ἀνατλῶν",701136,511],["ταῦτα",709858,71],["παρὰ",709995,0],["γὰρ",702963,11],["κυρίου",707996,18],["ταῦτά",709858,290],["μοι",708974,159],["συνετελέσθη",712510,37]],"[and] to raise up upon the earth my skin that endures these [sufferings]: for these things have been accomplished to me of the Lord;"],["27",[["ἃ",709781,69],["ἐγὼ",704018,164],["ἐμαυτῷ",704545,50],["συνεπίσταμαι",712451,254],["ἃ",709781,69],["ὁ",709436,3],["ὀφθαλμός",709870,4],["μου",709032,133],["ἑόρακεν",709725,171],["καὶ",707031,7],["οὐκ",709805,28],["ἄλλος",700697,121],["πάντα",710177,26],["δέ",703303,11],["μοι",708974,159],["συντετέλεσται",712510,403],["ἐν",704639,0],["κόλπῳ",707800,114]],"which I am conscious of in myself, which mine eye has seen, and not another, but all have been fulfilled to me in [my] bosom."],["28",[["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["ἐρεῖτε",705415,337],["τί",712867,126],["ἐροῦμεν",705415,275],["ἔναντι",704653,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ῥίζαν",711260,9],["λόγου",708236,18],["εὑρήσομεν",705676,275],["ἐν",704639,0],["αὐτῷ",702165,50]],"But if ye shall also say, What shall we say before him, and [so] find the root of the matter in him?"],["29",[["εὐλαβήθητε",705627,472],["δὴ",703395,11],["καὶ",707031,28],["ὑμεῖς",713081,219],["ἀπὸ",701425,0],["ἐπικαλύμματος",705154,21],["θυμὸς",706334,4],["γὰρ",702963,11],["ἐπ᾿",705080,0],["ἀνόμους",701194,60],["ἐπελεύσεται",705068,93],["καὶ",707031,7],["τότε",712908,28],["γνώσονται",703105,135],["ποῦ",710706,28],["ἐστιν",704093,91],["αὐτῶν",702165,40],["ἡ",709436,10],["ὕλη",713077,12]],"Do ye also beware of deceit: for wrath will come upon transgressors; and then shall they know where their substance is."]]