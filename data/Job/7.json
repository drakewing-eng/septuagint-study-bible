[["1",[["πότερον",710697,28],["οὐχὶ",709862,28],["πειρατήριόν",710228,15],["ἐστιν",704093,91],["ὁ",709436,3],["βίος",702724,4],["ἀνθρώπου",701163,18],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ὥσπερ",714163,28],["μισθίου",708938,116],["αὐθημερινοῦ",702129,116],["ἡ",709436,10],["ζωὴ",705910,12],["αὐτοῦ",702165,102]],"Is not the life of man upon earth a state of trial? and his existence as that of a hireling by the day?"],["2",[["ἢ",705924,7],["ὥσπερ",714163,28],["θεράπων",706201,4],["δεδοικὼς",703313,270],["τὸν",709436,5],["κύριον",707996,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["τετευχὼς",713015,270],["σκιᾶς",711852,17],["ἢ",705924,7],["ὥσπερ",714163,28],["μισθωτὸς",708942,14],["ἀναμένων",701000,72],["τὸν",709436,5],["μισθὸν",708939,6],["αὐτοῦ",702165,102]],"Or as a servant that fears his master, and one who has grasped a shadow? or as a hireling waiting for his pay?"],["3",[["οὕτως",709859,28],["κἀγὼ",706969,288],["ὑπέμεινα",713219,155],["μῆνας",708874,57],["κενούς",707612,60],["νύκτες",709386,191],["δὲ",703303,11],["ὀδυνῶν",709463,65],["δεδομέναι",703654,415],["μοί",708974,159],["εἰσιν",704093,197]],"So have I also endured months of vanity, and nights of pain have been appointed me."],["4",[["ἐὰν",703912,7],["κοιμηθῶ",707767,321],["λέγω",708124,157],["πότε",710696,28],["ἡμέρα",705984,12],["ὡς",714148,7],["δ᾿",703303,11],["ἂν",700900,11],["ἀναστῶ",701173,207],["πάλιν",709942,28],["πότε",710696,28],["ἑσπέρα",705500,12],["πλήρης",710541,14],["δὲ",703303,11],["γίνομαι",703104,254],["ὀδυνῶν",709463,65],["ἀπὸ",701425,0],["ἑσπέρας",705500,17],["ἕως",705792,0],["πρωί",711021,28]],"Whenever I lie down, I say, When [will it be] day? and whenever I rise up, again [I say] when [will it be] evening? and I am full of pains from evening to morning."],["5",[["φύρεται",713629,391],["δέ",703303,11],["μου",709032,133],["τὸ",709436,34],["σῶμα",712635,15],["ἐν",704639,0],["σαπρίᾳ",711503,1],["σκωλήκων",711905,81],["τήκω",712839,157],["δὲ",703303,11],["βώλακας",702838,39],["γῆς",703083,17],["ἀπὸ",701425,0],["ἰχῶρος",706874,18],["ξύων",709435,72]],"And my body is covered with loathsome worms; and I waste away, scraping off clods of dust from my eruption."],["6",[["ὁ",709436,3],["δὲ",703303,11],["βίος",702724,4],["μού",709032,133],["ἐστιν",704093,91],["ἐλαφρότερος",704399,224],["λαλιᾶς",708074,17],["ἀπόλωλεν",701513,171],["δὲ",703303,11],["ἐν",704639,0],["κενῇ",707612,101],["ἐλπίδι",704530,1]],"And my life is lighter than a word, and has perished in vain hope."],["7",[["μνήσθητι",708960,244],["οὖν",709835,11],["ὅτι",709803,7],["πνεῦμά",710566,15],["μου",709032,133],["ἡ",709436,10],["ζωὴ",705910,12],["καὶ",707031,7],["οὐκέτι",709827,28],["ἐπανελεύσεται",705023,93],["ὁ",709436,3],["ὀφθαλμός",709870,4],["μου",709032,133],["ἰδεῖν",709725,106],["ἀγαθόν",700106,46]],"Remember then that my life is breath, and mine eye shall not yet again see good."],["8",[["οὐ",709805,28],["περιβλέψεταί",710297,93],["με",708618,163],["ὀφθαλμὸς",709870,4],["ὁρῶντός",709725,152],["με",708618,163],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["σου",711945,133],["ἐν",704639,0],["ἐμοί",704577,159],["καὶ",707031,7],["οὐκέτι",709827,28],["εἰμὶ",704093,157]],"The eye of him that sees me shall not see me [again]: thine eyes are upon me, and I am no more."],["9",[["ὥσπερ",714163,28],["νέφος",709281,15],["ἀποκαθαρθὲν",701467,418],["ἀπ᾿",701425,0],["οὐρανοῦ",709844,18],["ἐὰν",703912,7],["γὰρ",702963,11],["ἄνθρωπος",701163,4],["καταβῇ",707202,172],["εἰς",704105,0],["ᾅδην",700255,6],["οὐκέτι",709827,28],["μὴ",708851,28],["ἀναβῇ",700905,172]],"[I am] as a cloud that is cleared away from the sky: for if a man go down to the grave, he shall not come up again:"],["10",[["οὐδ᾿",709816,7],["οὐ",709805,28],["μὴ",708851,28],["ἐπιστρέψῃ",705278,172],["ἔτι",705538,28],["εἰς",704105,0],["τὸν",709436,5],["ἴδιον",706493,27],["οἶκον",709516,6],["οὐδὲ",709816,7],["μὴ",708851,28],["ἐπιγνῷ",705104,172],["αὐτὸν",702165,85],["ἔτι",705538,28],["ὁ",709436,3],["τόπος",712903,4],["αὐτοῦ",702165,102]],"and he shall surely not return to his own house, neither shall his place know him any more."],["11",[["ἀτὰρ",702071,7],["οὖν",709835,11],["οὐδὲ",709816,7],["ἐγὼ",704018,164],["φείσομαι",713406,181],["τῷ",709436,53],["στόματί",712125,54],["μου",709032,133],["λαλήσω",708071,165],["ἐν",704639,0],["ἀνάγκῃ",700925,1],["ὤν",704093,72],["ἀνοίξω",701186,165],["πικρίαν",710472,9],["ψυχῆς",714070,17],["μου",709032,133],["συνεχόμενος",712469,122]],"Then neither will I refrain my mouth: I will speak being in distress; being in anguish I will disclose the bitterness of my soul."],["12",[["πότερον",710697,28],["θάλασσά",706069,12],["εἰμι",704093,157],["ἢ",705924,7],["δράκων",703822,4],["ὅτι",709803,7],["κατέταξας",707453,162],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["φυλακήν",713613,9]],"Am I a sea, or a serpent, that thou hast set a watch over me?"],["13",[["εἶπα",705373,155],["ὅτι",709803,7],["παρακαλέσει",710039,127],["με",708618,163],["ἡ",709436,10],["κλίνη",707737,12],["μου",709032,133],["ἀνοίσω",701083,165],["δὲ",703303,11],["πρὸς",710844,0],["ἐμαυτὸν",704545,85],["ἰδίᾳ",706493,101],["λόγον",708236,6],["τῇ",709436,100],["κοίτῃ",707781,1],["μου",709032,133]],"I said that my bed should comfort me, and I would privately counsel with myself on my couch."],["14",[["ἐκφοβεῖς",704360,154],["με",708618,163],["ἐνυπνίοις",704818,96],["καὶ",707031,7],["ἐν",704639,0],["ὁράμασίν",709720,96],["με",708618,163],["καταπλήσσεις",707380,154]],"Thou scarest me with dreams, and dost terrify me with visions."],["15",[["ἀπαλλάξεις",701333,166],["ἀπὸ",701425,0],["πνεύματός",710566,21],["μου",709032,133],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἀπὸ",701425,0],["δὲ",703303,11],["θανάτου",706096,18],["τὰ",709436,41],["ὀστᾶ",709792,42],["μου",709032,133]],"Thou wilt separate life from my spirit; and yet [keep] my bones from death."],["16",[["οὐ",709805,28],["γὰρ",702963,11],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ζήσομαι",705851,181],["ἵνα",706747,7],["μακροθυμήσω",708418,207],["ἀπόστα",702214,176],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["κενὸς",707612,14],["γάρ",702963,11],["μου",709032,133],["ὁ",709436,3],["βίος",702724,4]],"For I shall not live for ever, that I should patiently endure: depart from me, for my life [is] vain."],["17",[["τί",712867,273],["γάρ",702963,11],["ἐστιν",704093,91],["ἄνθρωπος",701163,4],["ὅτι",709803,7],["ἐμεγάλυνας",708647,162],["αὐτὸν",702165,85],["ἢ",705924,7],["ὅτι",709803,7],["προσέχεις",710895,154],["τὸν",709436,5],["νοῦν",709374,6],["εἰς",704105,0],["αὐτὸν",702165,85]],"For what is man, that thou hast magnified him? or that thou givest heed to him?"],["18",[["ἢ",705924,7],["ἐπισκοπὴν",705255,9],["αὐτοῦ",702165,102],["ποιήσῃ",710582,123],["ἕως",705792,0],["τὸ",709436,24],["πρωὶ",711021,28],["καὶ",707031,7],["εἰς",704105,0],["ἀνάπαυσιν",701026,9],["αὐτὸν",702165,85],["κρινεῖς",707905,166]],"Wilt thou visit him till the morning, and judge him till [the time of] rest?"],["19",[["ἕως",705792,0],["τίνος",712867,340],["οὐκ",709805,28],["ἐᾷς",703918,154],["με",708618,163],["οὐδὲ",709816,7],["προΐῃ",710802,259],["με",708618,163],["ἕως",705792,7],["ἂν",700900,11],["καταπίω",707374,207],["τὸν",709436,5],["πτύελόν",711067,6],["μου",709032,133],["ἐν",704639,0],["ὀδύνῃ",709463,1]],"How long dost thou not let me alone, nor let me go, until I shall swallow down my spittle?"],["20",[["εἰ",704071,7],["ἐγὼ",704018,164],["ἥμαρτον",700773,155],["τί",712867,126],["δύναμαί",703838,254],["σοι",711925,159],["πρᾶξαι",710721,106],["ὁ",709436,3],["ἐπιστάμενος",705264,122],["τὸν",709436,5],["νοῦν",709374,6],["τῶν",709436,80],["ἀνθρώπων",701163,81],["διὰ",703417,0],["τί",712867,126],["ἔθου",712849,174],["με",708618,163],["κατεντευκτήν",707510,6],["σου",711945,133],["εἰμὶ",704093,157],["δὲ",703303,11],["ἐπὶ",705080,0],["σοὶ",711925,159],["φορτίον",713563,25]],"If I have sinned, what shall I be able to do, O thou that understandest the mind of men? why hast thou made me as thine accuser, and [why] am I a burden to thee?"],["21",[["καὶ",707031,7],["διὰ",703417,0],["τί",712867,126],["οὐκ",709805,28],["ἐποιήσω",710582,174],["τῆς",709436,16],["ἀνομίας",701192,17],["μου",709032,133],["λήθην",708174,9],["καὶ",707031,7],["καθαρισμὸν",706987,6],["τῆς",709436,16],["ἁμαρτίας",700775,17],["μου",709032,133],["νυνὶ",709385,28],["δὲ",703303,11],["εἰς",704105,0],["γῆν",703083,9],["ἀπελεύσομαι",701398,181],["ὀρθρίζων",709742,72],["δὲ",703303,11],["οὐκέτι",709827,28],["εἰμί",704093,157]],"Why hast thou not forgotten my iniquity, and purged my sin? but now I shall depart to the earth; and in the morning, I am no more."]]