[["1",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Ιωβ",706903,4],["λέγει",708124,91]],"But Job answered and said,"],["2",[["εἰ",704071,7],["γάρ",702963,11],["τις",712866,158],["ἱστῶν",706846,72],["στήσαι",706846,225],["μου",709032,133],["τὴν",709436,8],["ὀργήν",709728,9],["τὰς",709436,38],["δὲ",703303,11],["ὀδύνας",709463,39],["μου",709032,133],["ἄραι",700473,106],["ἐν",704639,0],["ζυγῷ",705894,114],["ὁμοθυμαδόν",709624,28]],"Oh that one would indeed weigh the wrath that is upon me, and take up my griefs in a balance together!"],["3",[["καὶ",707031,7],["δὴ",703395,11],["ἄμμου",700845,17],["παραλίας",710063,82],["βαρυτέρα",702554,484],["ἔσται",704093,93],["ἀλλ᾿",700680,7],["ὡς",714148,7],["ἔοικεν",704088,171],["τὰ",709436,63],["ῥήματά",711246,64],["μού",709032,133],["ἐστιν",704093,91],["φαῦλα",713398,195]],"And verily they would be heavier than the sand by the seashore: but, as it seems, my words are vain."],["4",[["βέλη",702644,64],["γὰρ",702963,11],["κυρίου",707996,18],["ἐν",704639,0],["τῷ",709436,53],["σώματί",712635,54],["μού",709032,133],["ἐστιν",704093,91],["ὧν",709781,103],["ὁ",709436,3],["θυμὸς",706334,4],["αὐτῶν",702165,70],["ἐκπίνει",704283,91],["μου",709032,133],["τὸ",709436,24],["αἷμα",700442,25],["ὅταν",709801,28],["ἄρξωμαι",701860,410],["λαλεῖν",708071,55],["κεντοῦσί",707615,197],["με",708618,163]],"For the arrows of the Lord are in my body, whose violence drinks up my blood: whenever I am going to speak, they pierce me."],["5",[["τί",712867,273],["γάρ",702963,11],["μὴ",708851,28],["διὰ",703417,0],["κενῆς",707612,82],["κεκράξεται",707868,93],["ὄνος",709671,4],["ἄγριος",700191,14],["ἀλλ᾿",700680,7],["ἢ",705924,7],["τὰ",709436,41],["σῖτα",711814,42],["ζητῶν",705879,72],["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["ῥήξει",711243,127],["φωνὴν",713640,9],["βοῦς",702798,12],["ἐπὶ",705080,0],["φάτνης",713391,17],["ἔχων",705785,72],["τὰ",709436,41],["βρώματα",702823,42]],"What then? will the wild ass bray for nothing, if he is not seeking food? or again, will the ox low at the manger, when he has fodder?"],["6",[["εἰ",704071,7],["βρωθήσεται",702722,134],["ἄρτος",701829,4],["ἄνευ",701137,0],["ἁλός",700728,18],["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["ἔστιν",704093,91],["γεῦμα",703072,15],["ἐν",704639,0],["ῥήμασιν",711246,96],["κενοῖς",707612,94]],"Shall bread be eaten without salt? or again, is there taste in empty words?"],["7",[["οὐ",709805,28],["δύναται",703838,117],["γὰρ",702963,11],["παύσασθαί",710202,109],["μου",709032,133],["ἡ",709436,10],["ψυχή",714070,12],["βρόμον",702814,6],["γὰρ",702963,11],["ὁρῶ",709725,157],["τὰ",709436,41],["σῖτά",711814,42],["μου",709032,133],["ὥσπερ",714163,28],["ὀσμὴν",709786,9],["λέοντος",708171,18]],"For my wrath cannot cease; for I perceive my food as the smell of a lion [to be] loathsome."],["8",[["εἰ",704071,7],["γὰρ",702963,11],["δῴη",703654,225],["καὶ",707031,7],["ἔλθοι",705453,225],["μου",709032,133],["ἡ",709436,10],["αἴτησις",700491,12],["καὶ",707031,7],["τὴν",709436,8],["ἐλπίδα",704530,9],["μου",709032,133],["δῴη",703654,225],["ὁ",709436,3],["κύριος",707996,4]],"For oh that he would grant [my desire], and my petition might come, and the Lord would grant my hope!"],["9",[["ἀρξάμενος",701860,248],["ὁ",709436,3],["κύριος",707996,4],["τρωσάτω",712871,45],["με",708618,163],["εἰς",704105,0],["τέλος",712787,25],["δὲ",703303,11],["μή",708851,28],["με",708618,163],["ἀνελέτω",700962,45]],"Let the Lord begin and wound me, but let him not utterly destroy me."],["10",[["εἴη",704093,301],["δέ",703303,11],["μου",709032,133],["πόλις",710612,12],["τάφος",712738,4],["ἐφ᾿",705080,0],["ἧς",709781,167],["ἐπὶ",705080,0],["τειχέων",712759,44],["ἡλλόμην",700696,334],["ἐπ᾿",705080,0],["αὐτῆς",702165,86],["οὐ",709805,28],["μὴ",708851,28],["φείσωμαι",713406,410],["οὐ",709805,28],["γὰρ",702963,11],["ἐψευσάμην",714045,161],["ῥήματα",711246,42],["ἅγια",700159,68],["θεοῦ",706192,18],["μου",709032,133]],"Let the grave be my city, upon the walls of which I have leaped: I will not shrink from it; for I have not denied the holy words of my God."],["11",[["τίς",712867,158],["γάρ",702963,11],["μου",709032,133],["ἡ",709436,10],["ἰσχύς",706858,12],["ὅτι",709803,7],["ὑπομένω",713219,157],["ἢ",705924,7],["τίς",712867,158],["μου",709032,133],["ὁ",709436,3],["χρόνος",713969,4],["ὅτι",709803,7],["ἀνέχεταί",701140,117],["μου",709032,133],["ἡ",709436,10],["ψυχή",714070,12]],"For what is my strength, that I continue? what is my time, that my soul endures?"],["12",[["μὴ",708851,28],["ἰσχὺς",706858,12],["λίθων",708196,81],["ἡ",709436,10],["ἰσχύς",706858,12],["μου",709032,133],["ἢ",705924,7],["αἱ",709436,190],["σάρκες",711537,191],["μού",709032,133],["εἰσιν",704093,197],["χάλκειαι",713689,192]],"Is my strength the strength of stones? or is my flesh of brass?"],["13",[["ἦ",705925,28],["οὐκ",709805,28],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["ἐπεποίθειν",710221,499],["βοήθεια",702745,12],["δὲ",703303,11],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["ἄπεστιν",701376,91]],"Or have I not trusted in him? but help is [far] from me."],["14",[["ἀπείπατό",701378,23],["με",708618,163],["ἔλεος",704426,25],["ἐπισκοπὴ",705255,12],["δὲ",703303,11],["κυρίου",707996,18],["ὑπερεῖδέν",713154,2],["με",708618,163]],"Mercy has rejected me; and the visitation of the Lord has disregarded me."],["15",[["οὐ",709805,28],["προσεῖδόν",710943,150],["με",708618,163],["οἱ",709436,136],["ἐγγύτατοί",703948,480],["μου",709032,133],["ὥσπερ",714163,28],["χειμάρρους",713783,6],["ἐκλείπων",704237,72],["ἢ",705924,7],["ὥσπερ",714163,28],["κῦμα",707968,15],["παρῆλθόν",710141,150],["με",708618,163]],"My nearest relations have not regarded me; they have passed me by like a failing brook, or like a wave."],["16",[["οἵτινές",709793,450],["με",708618,163],["διευλαβοῦντο",703678,139],["νῦν",709384,28],["ἐπιπεπτώκασίν",705225,353],["μοι",708974,159],["ὥσπερ",714163,28],["χιὼν",713870,12],["ἢ",705924,7],["κρύσταλλος",707926,4],["πεπηγώς",710452,270]],"They who used to reverence me, now have come against me like snow or congealed ice."],["17",[["καθὼς",707030,28],["τακεῖσα",712839,217],["θέρμης",706217,82],["γενομένης",703104,638],["οὐκ",709805,28],["ἐπεγνώσθη",705104,37],["ὅπερ",709789,33],["ἦν",704093,13]],"When it has melted at the approach of heat, it is not known what it was."],["18",[["οὕτως",709859,28],["κἀγὼ",706969,288],["κατελείφθην",707305,156],["ὑπὸ",713184,0],["πάντων",710177,169],["ἀπωλόμην",701513,161],["δὲ",703303,11],["καὶ",707031,7],["ἔξοικος",704950,14],["ἐγενόμην",703104,161]],"Thus I also have been deserted of all; and I am ruined, and become an outcast."],["19",[["ἴδετε",709725,74],["ὁδοὺς",709458,39],["Θαιμανων",706062,81],["ἀτραποὺς",702106,39],["Σαβων",711336,81],["οἱ",709436,136],["διορῶντες",703726,146]],"Behold the ways of the Thæmanites, ye that mark the paths of the Sabæans."],["20",[["καὶ",707031,7],["αἰσχύνην",700483,9],["ὀφειλήσουσιν",709865,218],["οἱ",709436,136],["ἐπὶ",705080,0],["πόλεσιν",710612,76],["καὶ",707031,7],["χρήμασιν",713948,96],["πεποιθότες",710221,268]],"They too that trust in cities and riches shall come to shame."],["21",[["ἀτὰρ",702071,7],["δὲ",703303,11],["καὶ",707031,7],["ὑμεῖς",713081,219],["ἐπέβητέ",705082,265],["μοι",708974,159],["ἀνελεημόνως",701119,28],["ὥστε",714164,7],["ἰδόντες",709725,196],["τὸ",709436,24],["ἐμὸν",704578,46],["τραῦμα",712920,25],["φοβήθητε",713532,394]],"But ye also have come to me without pity; so that beholding my wound ye are afraid."],["22",[["τί",712867,273],["γάρ",702963,11],["μή",708851,28],["τι",712866,126],["ὑμᾶς",713080,194],["ᾔτησα",700489,155],["ἢ",705924,7],["τῆς",709436,16],["παρ᾿",709995,0],["ὑμῶν",713091,145],["ἰσχύος",706858,17],["ἐπιδέομαι",705118,254]],"What? have I made any demand of you? or do I ask for strength from you,"],["23",[["ὥστε",714164,7],["σῶσαί",712627,106],["με",708618,163],["ἐξ",704132,0],["ἐχθρῶν",705779,81],["ἢ",705924,7],["ἐκ",704132,0],["χειρὸς",713787,17],["δυναστῶν",703844,81],["ῥύσασθαί",711309,109],["με",708618,163]],"to deliver me from enemies, or to rescue me from the hand of the mighty ones?"],["24",[["διδάξατέ",703649,74],["με",708618,163],["ἐγὼ",704018,164],["δὲ",703303,11],["κωφεύσω",708032,165],["εἴ",704071,7],["τι",712866,126],["πεπλάνημαι",710495,584],["φράσατέ",713573,74],["μοι",708974,159]],"Teach ye me, and I will be silent: if in anything I have erred, tell me."],["25",[["ἀλλ᾿",700680,7],["ὡς",714148,7],["ἔοικεν",704088,171],["φαῦλα",713398,195],["ἀληθινοῦ",700659,116],["ῥήματα",711246,64],["οὐ",709805,28],["γὰρ",702963,11],["παρ᾿",709995,0],["ὑμῶν",713091,145],["ἰσχὺν",706858,9],["αἰτοῦμαι",700489,254]],"But as it seems, the words of a true man are vain, because I do not ask strength of you."],["26",[["οὐδὲ",709816,7],["ὁ",709436,3],["ἔλεγχος",704415,4],["ὑμῶν",713091,145],["ῥήμασίν",711246,96],["με",708618,163],["παύσει",710202,127],["οὐδὲ",709816,7],["γὰρ",702963,11],["ὑμῶν",713091,145],["φθέγμα",713443,25],["ῥήματος",711246,21],["ἀνέξομαι",701140,181]],"Neither will your reproof cause me to cease my words, for neither will I endure the sound of your speech."],["27",[["πλὴν",710540,28],["ὅτι",709803,7],["ἐπ᾿",705080,0],["ὀρφανῷ",709779,30],["ἐπιπίπτετε",705225,87],["ἐνάλλεσθε",704652,374],["δὲ",703303,11],["ἐπὶ",705080,0],["φίλῳ",713492,30],["ὑμῶν",713091,145]],"Even because ye attack the fatherless, and insult your friend."],["28",[["νυνὶ",709385,28],["δὲ",703303,11],["εἰσβλέψας",704110,182],["εἰς",704105,0],["πρόσωπα",710986,42],["ὑμῶν",713091,145],["οὐ",709805,28],["ψεύσομαι",714045,181]],"But now, having looked upon your countenances, I will not lie."],["29",[["καθίσατε",707006,74],["δὴ",703395,11],["καὶ",707031,7],["μὴ",708851,28],["εἴη",704093,301],["ἄδικον",700272,26],["καὶ",707031,7],["πάλιν",709942,28],["τῷ",709436,113],["δικαίῳ",703694,30],["συνέρχεσθε",712458,374]],"Sit down now, and let there not be unrighteousness; and unite again with the just."],["30",[["οὐ",709805,28],["γάρ",702963,11],["ἐστιν",704093,91],["ἐν",704639,0],["γλώσσῃ",703120,1],["μου",709032,133],["ἄδικον",700272,26],["ἢ",705924,7],["ὁ",709436,3],["λάρυγξ",708098,4],["μου",709032,133],["οὐχὶ",709862,28],["σύνεσιν",712460,9],["μελετᾷ",708698,91]],"For there is no injustice in my tongue; and does not my throat meditate understanding?"]]