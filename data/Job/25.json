[["1",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Βαλδαδ",702480,4],["ὁ",709436,3],["Σαυχίτης",711565,4],["λέγει",708124,91]],"Then Baldad the Sauchite answered and said,"],["2",[["τί",712867,273],["γὰρ",702963,11],["προοίμιον",710831,15],["ἢ",705924,7],["φόβος",713534,4],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["ὁ",709436,3],["ποιῶν",710582,72],["τὴν",709436,8],["σύμπασαν",712324,36],["ἐν",704639,0],["ὑψίστῳ",713287,30]],"What beginning or fear is his—even he that makes all things in the highest?"],["3",[["μὴ",708851,28],["γάρ",702963,11],["τις",712866,158],["ὑπολάβοι",713210,225],["ὅτι",709803,7],["ἔστιν",704093,91],["παρέλκυσις",710130,12],["πειραταῖς",710229,148],["ἐπὶ",705080,0],["τίνας",712867,668],["δὲ",703303,11],["οὐκ",709805,28],["ἐπελεύσεται",705068,93],["ἔνεδρα",704702,12],["παρ᾿",709995,0],["αὐτοῦ",702165,102]],"For let none think that there is a respite for robbers: and upon whom will there not come a snare from him?"],["4",[["πῶς",711121,28],["γὰρ",702963,11],["ἔσται",704093,93],["δίκαιος",703694,14],["βροτὸς",702817,4],["ἔναντι",704653,0],["κυρίου",707996,18],["ἢ",705924,7],["τίς",712867,158],["ἂν",700900,11],["ἀποκαθαρίσαι",701468,225],["ἑαυτὸν",703917,85],["γεννητὸς",703055,14],["γυναικός",703209,17]],"For how shall a mortal be just before the Lord? or who that is born of a woman shall purify himself?"],["5",[["εἰ",704071,7],["σελήνῃ",711650,1],["συντάσσει",712508,91],["καὶ",707031,7],["οὐκ",709805,28],["ἐπιφαύσκει",705321,91],["ἄστρα",702024,64],["δὲ",703303,11],["οὐ",709805,28],["καθαρὰ",706988,195],["ἐναντίον",704654,0],["αὐτοῦ",702165,102]],"If he gives an order to the moon, then it shines not; and the stars are not pure before him."],["6",[["ἔα",703911,88],["δέ",703303,11],["ἄνθρωπος",701163,4],["σαπρία",711503,12],["καὶ",707031,7],["υἱὸς",713075,4],["ἀνθρώπου",701163,18],["σκώληξ",711905,4]],"But alas! man is corruption, and the son of man a worm."]]