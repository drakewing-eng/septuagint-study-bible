[["1",[["ἰδοὺ",706497,88],["ταῦτα",709858,71],["ἑώρακέν",709725,171],["μου",709032,133],["ὁ",709436,3],["ὀφθαλμὸς",709870,4],["καὶ",707031,7],["ἀκήκοέν",700587,171],["μου",709032,133],["τὸ",709436,34],["οὖς",709852,15]],"Behold, mine eye has seen these things, and mine ear has heard [them]."],["2",[["καὶ",707031,7],["οἶδα",709492,89],["ὅσα",709788,68],["καὶ",707031,28],["ὑμεῖς",713081,219],["ἐπίστασθε",705264,374],["καὶ",707031,7],["οὐκ",709805,28],["ἀσυνετώτερός",702034,224],["εἰμι",704093,157],["ὑμῶν",713091,145]],"And I know all that ye too know; and I have not less understanding than you."],["3",[["οὐ",709805,28],["μὴν",708873,11],["δὲ",703303,11],["ἀλλ᾿",700680,7],["ἐγὼ",704018,164],["πρὸς",710844,0],["κύριον",707996,6],["λαλήσω",708071,165],["ἐλέγξω",704416,165],["δὲ",703303,11],["ἐναντίον",704654,0],["αὐτοῦ",702165,102],["ἐὰν",703912,7],["βούληται",702795,428]],"Nevertheless I will speak to the Lord, and I will reason before him, if he will."],["4",[["ὑμεῖς",713081,219],["δέ",703303,11],["ἐστε",704093,87],["ἰατροὶ",706459,52],["ἄδικοι",700272,138],["καὶ",707031,7],["ἰαταὶ",706455,52],["κακῶν",707066,83],["πάντες",710177,138]],"But ye are all bad physicians, and healers of diseases."],["5",[["εἴη",704093,301],["δὲ",703303,11],["ὑμῖν",713084,90],["κωφεῦσαι",708032,106],["καὶ",707031,7],["ἀποβήσεται",701426,93],["ὑμῖν",713084,90],["εἰς",704105,0],["σοφίαν",711981,9]],"But would that ye were silent, and it would be wisdom to you in the end."],["6",[["ἀκούσατε",700587,74],["ἔλεγχον",704415,6],["στόματός",712125,21],["μου",709032,133],["κρίσιν",707908,9],["δὲ",703303,11],["χειλέων",713781,44],["μου",709032,133],["προσέχετε",710895,335]],"But hear ye the reasoning of my mouth, and attend to the judgment of my lips."],["7",[["πότερον",710697,28],["οὐκ",709805,28],["ἔναντι",704653,0],["κυρίου",707996,18],["λαλεῖτε",708071,87],["ἔναντι",704653,0],["δὲ",703303,11],["αὐτοῦ",702165,102],["φθέγγεσθε",713442,374],["δόλον",703787,6]],"Do ye not speak before the Lord, and utter deceit before him?"],["8",[["ἦ",705925,28],["ὑποστελεῖσθε",713242,124],["ὑμεῖς",713081,219],["δὲ",703303,11],["αὐτοὶ",702165,201],["κριταὶ",707910,52],["γένεσθε",703104,186]],"Or will ye draw back? nay, do ye yourselves be judges."],["9",[["καλόν",707097,26],["γε",702985,11],["ἐὰν",703912,7],["ἐξιχνιάσῃ",704941,172],["ὑμᾶς",713080,194],["εἰ",704071,7],["γὰρ",702963,11],["τὰ",709436,41],["πάντα",710177,68],["ποιοῦντες",710582,146],["προστεθήσεσθε",710965,261],["αὐτῷ",702165,50]],"For [it were] well if he would thoroughly search you: for though doing all things [in your power] ye should attach yourselves to him,"],["10",[["οὐθὲν",709817,26],["ἧττον",706042,26],["ἐλέγξει",704416,127],["ὑμᾶς",713080,194],["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["κρυφῇ",707929,28],["πρόσωπα",710986,42],["θαυμάσετε",706135,337]],"he will not reprove you at all the less: but if moreover ye should secretly respect persons,"],["11",[["πότερον",710697,28],["οὐχὶ",709862,28],["δεινὰ",703328,195],["αὐτοῦ",702165,102],["στροβήσει",712163,127],["ὑμᾶς",713080,194],["φόβος",713534,4],["δὲ",703303,11],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["ἐπιπεσεῖται",705225,93],["ὑμῖν",713084,90]],"shall not his whirlpool sweep you round, and terror from him fall upon you?",{"s":"d","q":0.64}],["12",[["ἀποβήσεται",701426,93],["δὲ",703303,11],["ὑμῶν",713091,145],["τὸ",709436,34],["ἀγαυρίαμα",700131,15],["ἴσα",706832,28],["σποδῷ",712022,1],["τὸ",709436,24],["δὲ",703303,11],["σῶμα",712635,25],["πήλινον",710456,46]],"And your glorying shall prove in the end to you like ashes, and your body [like a body] of clay."],["13",[["κωφεύσατε",708032,74],["ἵνα",706747,7],["λαλήσω",708071,207],["καὶ",707031,7],["ἀναπαύσωμαι",701027,410],["θυμοῦ",706334,18]],"Be silent, that I may speak, and cease from [mine] anger,"],["14",[["ἀναλαβὼν",700984,182],["τὰς",709436,38],["σάρκας",711537,39],["μου",709032,133],["τοῖς",709436,147],["ὀδοῦσιν",709461,148],["ψυχὴν",714070,9],["δέ",703303,11],["μου",709032,133],["θήσω",712849,165],["ἐν",704639,0],["χειρί",713787,1]],"while I may take my flesh in my teeth, and put my life in my hand."],["15",[["ἐάν",703912,7],["με",708618,163],["χειρώσηται",713794,239],["ὁ",709436,3],["δυνάστης",703844,4],["ἐπεὶ",705054,7],["καὶ",707031,28],["ἦρκται",701860,187],["ἦ",705925,28],["μὴν",708873,11],["λαλήσω",708071,165],["καὶ",707031,7],["ἐλέγξω",704416,165],["ἐναντίον",704654,0],["αὐτοῦ",702165,102]],"Though the Mighty One should lay hand upon me, forasmuch as he has begun, verily I will speak, and plead before him."],["16",[["καὶ",707031,7],["τοῦτό",709858,132],["μοι",708974,159],["ἀποβήσεται",701426,93],["εἰς",704105,0],["σωτηρίαν",712658,9],["οὐ",709805,28],["γὰρ",702963,11],["ἐναντίον",704654,0],["αὐτοῦ",702165,102],["δόλος",703787,4],["εἰσελεύσεται",704114,93]],"And this shall turn to me for salvation; for fraud shall have no entrance before him."],["17",[["ἀκούσατε",700587,74],["ἀκούσατε",700587,74],["τὰ",709436,41],["ῥήματά",711246,42],["μου",709032,133],["ἀναγγελῶ",700921,165],["γὰρ",702963,11],["ὑμῶν",713091,145],["ἀκουόντων",700587,170]],"Hear, hear ye my words, for I will declare in your hearing."],["18",[["ἰδοὺ",706497,88],["ἐγὼ",704018,164],["ἐγγύς",703948,28],["εἰμι",704093,157],["τοῦ",709436,20],["κρίματός",707903,21],["μου",709032,133],["οἶδα",709492,89],["ἐγὼ",704018,164],["ὅτι",709803,7],["δίκαιος",703694,14],["ἀναφανοῦμαι",701080,181]],"Behold, I am near my judgment: I know that I shall appear evidently just."],["19",[["τίς",712867,158],["γάρ",702963,11],["ἐστιν",704093,91],["ὁ",709436,3],["κριθησόμενός",707905,751],["μοι",708974,159],["ὅτι",709803,7],["νῦν",709384,28],["κωφεύσω",708032,165],["καὶ",707031,7],["ἐκλείψω",704237,165]],"For who is he that shall plead with me, that I should now be silent, and expire?"],["20",[["δυεῖν",703849,533],["δέ",703303,11],["μοι",708974,159],["χρήσῃ",713937,123],["τότε",712908,28],["ἀπὸ",701425,0],["τοῦ",709436,20],["προσώπου",710986,21],["σου",711945,133],["οὐ",709805,28],["κρυβήσομαι",707923,180]],"But grant me two things: then I will not hide myself from thy face."],["21",[["τὴν",709436,8],["χεῖρα",713787,9],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["ἀπέχου",701225,253],["καὶ",707031,7],["ὁ",709436,3],["φόβος",713534,4],["σου",711945,133],["μή",708851,28],["με",708618,163],["καταπλησσέτω",707380,31]],"Withhold [thine] hand from me: and let not thy fear terrify me."],["22",[["εἶτα",704129,28],["καλέσεις",707084,166],["ἐγὼ",704018,164],["δέ",703303,11],["σοι",711925,159],["ὑπακούσομαι",713096,181],["ἢ",705924,7],["λαλήσεις",708071,166],["ἐγὼ",704018,164],["δέ",703303,11],["σοι",711925,159],["δώσω",703654,165],["ἀνταπόκρισιν",701220,9]],"Then shalt thou call, and I will hearken to thee: or thou shalt speak, and I will give thee an answer."],["23",[["πόσαι",710692,192],["εἰσὶν",704093,197],["αἱ",709436,190],["ἁμαρτίαι",700775,191],["μου",709032,133],["καὶ",707031,7],["αἱ",709436,190],["ἀνομίαι",701192,191],["μου",709032,133],["δίδαξόν",703649,176],["με",708618,163],["τίνες",712867,392],["εἰσίν",704093,197]],"How many are my sins and my transgressions? teach me what they are."],["24",[["διὰ",703417,0],["τί",712867,126],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["κρύπτῃ",707923,259],["ἥγησαι",705931,332],["δέ",703303,11],["με",708618,163],["ὑπεναντίον",713109,27],["σοι",711925,159]],"Wherefore hidest thou thyself from me, and deemest me thine enemy?"],["25",[["ἦ",705925,28],["ὡς",714148,7],["φύλλον",713622,25],["κινούμενον",707679,576],["ὑπὸ",713184,0],["ἀνέμου",701123,18],["εὐλαβηθήσῃ",705627,364],["ἢ",705924,7],["ὡς",714148,7],["χόρτῳ",713923,114],["φερομένῳ",713428,752],["ὑπὸ",713184,0],["πνεύματος",710566,21],["ἀντίκεισαί",701240,259],["μοι",708974,159]],"Wilt thou be startled [at me], as [at] a leaf shaken by the wind? or wilt thou set thyself against me as against grass borne upon the breeze?"],["26",[["ὅτι",709803,7],["κατέγραψας",707231,162],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["κακά",707066,68],["περιέθηκας",710403,162],["δέ",703303,11],["μοι",708974,159],["νεότητος",709258,17],["ἁμαρτίας",700775,39]],"For thou hast written evil things against me, and thou hast compassed me with the sins of my youth."],["27",[["ἔθου",712849,174],["δέ",703303,11],["μου",709032,133],["τὸν",709436,5],["πόδα",710707,6],["ἐν",704639,0],["κωλύματι",708018,54],["ἐφύλαξας",713619,162],["δέ",703303,11],["μου",709032,133],["πάντα",710177,68],["τὰ",709436,41],["ἔργα",705396,42],["εἰς",704105,0],["δὲ",703303,11],["ῥίζας",711260,39],["τῶν",709436,80],["ποδῶν",710707,81],["μου",709032,133],["ἀφίκου",702212,174]],"And thou hast placed my foot in the stocks; and thou hast watched all my works, and hast penetrated to my heels."],["28",[["ὃ",709781,33],["παλαιοῦται",709937,391],["ἴσα",706832,28],["ἀσκῷ",701968,114],["ἢ",705924,7],["ὥσπερ",714163,28],["ἱμάτιον",706742,15],["σητόβρωτον",711757,26]],"[I am as] that which waxes old like a bottle, or like a moth-eaten garment."]]