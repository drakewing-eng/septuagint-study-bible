[["1",[["οὐχ",709805,28],["ἑόρακας",709725,266],["αὐτὸν",702165,85],["οὐδὲ",709816,7],["ἐπὶ",705080,0],["τοῖς",709436,147],["λεγομένοις",708124,341],["τεθαύμακας",706135,266]],"Hast thou not seen him? and hast thou not wondered at the things said [of him]?"],["2",[["οὐ",709805,28],["δέδοικας",703313,266],["ὅτι",709803,7],["ἡτοίμασταί",705539,403],["μοι",708974,159],["τίς",712867,158],["γάρ",702963,11],["ἐστιν",704093,91],["ὁ",709436,3],["ἐμοὶ",704577,159],["ἀντιστάς",701154,182]],"Dost thou not fear because preparation has been made by me? for who is there that resists me?"],["3",[["ἢ",705924,7],["τίς",712867,158],["ἀντιστήσεταί",701154,93],["μοι",708974,159],["καὶ",707031,7],["ὑπομενεῖ",713219,127],["εἰ",704071,7],["πᾶσα",710177,29],["ἡ",709436,10],["ὑπ᾿",713184,0],["οὐρανὸν",709844,6],["ἐμή",704578,29],["ἐστιν",704093,91]],"Or who will resist me, and abide, since the whole [world] under heaven is mine?"],["4",[["οὐ",709805,28],["σιωπήσομαι",711818,181],["δι᾿",703417,0],["αὐτόν",702165,85],["καὶ",707031,7],["λόγον",708236,6],["δυνάμεως",703839,17],["ἐλεήσει",704418,127],["τὸν",709436,5],["ἴσον",706832,27],["αὐτοῦ",702165,102]],"I will not be silent because of him: though because of his power [one] shall pity his antagonist."],["5",[["τίς",712867,158],["ἀποκαλύψει",701474,127],["πρόσωπον",710986,25],["ἐνδύσεως",704700,17],["αὐτοῦ",702165,102],["εἰς",704105,0],["δὲ",703303,11],["πτύξιν",711068,9],["θώρακος",706356,18],["αὐτοῦ",702165,102],["τίς",712867,158],["ἂν",700900,11],["εἰσέλθοι",704114,225]],"Who will open the face of his garment? and who can enter within the fold of his breast-plate?"],["6",[["πύλας",711082,39],["προσώπου",710986,21],["αὐτοῦ",702165,102],["τίς",712867,158],["ἀνοίξει",701186,127],["κύκλῳ",707959,114],["ὀδόντων",709461,81],["αὐτοῦ",702165,102],["φόβος",713534,4]],"Who will open the doors of his face? terror is round about his teeth."],["7",[["τὰ",709436,63],["ἔγκατα",703964,64],["αὐτοῦ",702165,102],["ἀσπίδες",701991,191],["χάλκειαι",713689,192],["σύνδεσμος",712416,4],["δὲ",703303,11],["αὐτοῦ",702165,102],["ὥσπερ",714163,28],["σμιρίτης",711913,4],["λίθος",708196,4]],"His inwards are [as] brazen plates, and the texture of his [skin] as a smyrite stone."],["8",[["εἷς",704106,14],["τοῦ",709436,35],["ἑνὸς",704106,116],["κολλῶνται",707791,699],["πνεῦμα",710566,15],["δὲ",703303,11],["οὐ",709805,28],["μὴ",708851,28],["διέλθῃ",703673,172],["αὐτόν",702165,85]],"One [part] cleaves fast to another, and the air cannot come between them."],["9",[["ἀνὴρ",701150,4],["τῷ",709436,113],["ἀδελφῷ",700249,114],["αὐτοῦ",702165,102],["προσκολληθήσεται",710921,134],["συνέχονται",712469,197],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἀποσπασθῶσιν",701583,272]],"They will remain united each to the other: they are closely joined, and cannot be separated."],["10",[["ἐν",704639,0],["πταρμῷ",711049,114],["αὐτοῦ",702165,102],["ἐπιφαύσκεται",705321,117],["φέγγος",713404,15],["οἱ",709436,136],["δὲ",703303,11],["ὀφθαλμοὶ",709870,52],["αὐτοῦ",702165,102],["εἶδος",704074,15],["ἑωσφόρου",705793,18]],"At his sneezing a light shines, and his eyes are [as] the appearance of the morning star."],["11",[["ἐκ",704132,0],["στόματος",712125,21],["αὐτοῦ",702165,102],["ἐκπορεύονται",704293,269],["λαμπάδες",708079,191],["καιόμεναι",707049,305],["καὶ",707031,7],["διαρριπτοῦνται",703567,269],["ἐσχάραι",705514,191],["πυρός",711088,21]],"Out of his mouth proceed as it were burning lamps, and as it were hearths of fire are cast abroad."],["12",[["ἐκ",704132,0],["μυκτήρων",709051,4],["αὐτοῦ",702165,102],["ἐκπορεύεται",704293,117],["καπνὸς",707132,4],["καμίνου",707113,17],["καιομένης",707049,422],["πυρὶ",711088,54],["ἀνθράκων",701160,81]],"Out of his nostrils proceeds smoke of a furnace burning with fire of coals."],["13",[["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτοῦ",702165,102],["ἄνθρακες",701160,52],["φλὸξ",713524,12],["δὲ",703303,11],["ἐκ",704132,0],["στόματος",712125,21],["αὐτοῦ",702165,102],["ἐκπορεύεται",704293,117]],"His breath is [as] live coals, and a flame goes out of his mouth."],["14",[["ἐν",704639,0],["δὲ",703303,11],["τραχήλῳ",712924,114],["αὐτοῦ",702165,102],["αὐλίζεται",702138,117],["δύναμις",703839,12],["ἔμπροσθεν",704618,0],["αὐτοῦ",702165,102],["τρέχει",712931,91],["ἀπώλεια",701660,12]],"And power is lodged in his neck, before him destruction runs."],["15",[["σάρκες",711537,191],["δὲ",703303,11],["σώματος",712635,21],["αὐτοῦ",702165,102],["κεκόλληνται",707791,408],["καταχέει",707491,91],["ἐπ᾿",705080,0],["αὐτόν",702165,85],["οὐ",709805,28],["σαλευθήσεται",711403,134]],"The flesh also of his body is joined together: [if one] pours [violence] upon him, he shall not be moved."],["16",[["ἡ",709436,10],["καρδία",707141,12],["αὐτοῦ",702165,102],["πέπηγεν",710452,171],["ὡς",714148,7],["λίθος",708196,4],["ἕστηκεν",706846,171],["δὲ",703303,11],["ὥσπερ",714163,28],["ἄκμων",700560,4],["ἀνήλατος",701146,14]],"His heart is firm as a stone, and it stands like an unyielding anvil."],["17",[["στραφέντος",712160,319],["δὲ",703303,11],["αὐτοῦ",702165,102],["φόβος",713534,4],["θηρίοις",706252,96],["τετράποσιν",712823,148],["ἐπὶ",705080,0],["γῆς",703083,17],["ἁλλομένοις",700696,341]],"And when he turns, [he is] a terror to the four-footed wild beasts which leap upon the earth."],["18",[["ἐὰν",703912,7],["συναντήσωσιν",712394,234],["αὐτῷ",702165,50],["λόγχαι",708237,191],["οὐδὲν",709817,46],["μὴ",708851,28],["ποιήσωσιν",710582,234],["δόρυ",703804,25],["ἐπηρμένον",705002,414],["καὶ",707031,7],["θώρακα",706356,6,57]],"If spears should come against him, [men] will effect nothing, [either with] the spear or the breast-plate."],["19",[["ἥγηται",705931,187],["μὲν",708730,11],["γὰρ",702963,11],["σίδηρον",711774,6],["ἄχυρα",702316,42],["χαλκὸν",713695,6],["δὲ",703303,11],["ὥσπερ",714163,28],["ξύλον",709427,25],["σαθρόν",711381,46]],"For he considers iron as chaff, and brass as rotten wood."],["20",[["οὐ",709805,28],["μὴ",708851,28],["τρώσῃ",712871,172],["αὐτὸν",702165,85],["τόξον",712898,15],["χάλκειον",713688,15],["ἥγηται",705931,187],["μὲν",708730,11],["πετροβόλον",710445,6],["χόρτον",713923,6]],"The bow of brass shall not wound him, he deems a slinger as grass."],["21",[["ὡς",714148,7],["καλάμη",707079,12],["ἐλογίσθησαν",708232,99],["σφῦραι",712592,191],["καταγελᾷ",707222,91],["δὲ",703303,11],["σεισμοῦ",711632,18],["πυρφόρου",711112,116]],"Mauls are counted as stubble; and he laughs to scorn the waving of the firebrand."],["22",[["ἡ",709436,10],["στρωμνὴ",712174,12],["αὐτοῦ",702165,102],["ὀβελίσκοι",709440,52],["ὀξεῖς",709682,138],["πᾶς",710177,14],["δὲ",703303,11],["χρυσὸς",713975,4],["θαλάσσης",706069,17],["ὑπ᾿",713184,0],["αὐτὸν",702165,85],["ὥσπερ",714163,28],["πηλὸς",710457,4],["ἀμύθητος",700878,14]],"His lair is [formed of] sharp points; and all the gold of the sea under him is as an immense [quantity of] clay."],["23",[["ἀναζεῖ",700942,91],["τὴν",709436,8],["ἄβυσσον",700098,9],["ὥσπερ",714163,28],["χαλκεῖον",713688,25],["ἥγηται",705931,187],["δὲ",703303,11],["τὴν",709436,8],["θάλασσαν",706069,9],["ὥσπερ",714163,28],["ἐξάλειπτρον",704851,25]],"He makes the deep boil like a brazen caldron; and he regards the sea as a pot of ointment,"],["24",[["τὸν",709436,5],["δὲ",703303,11],["τάρταρον",712728,6],["τῆς",709436,16],["ἀβύσσου",700098,17],["ὥσπερ",714163,28],["αἰχμάλωτον",700503,27],["ἐλογίσατο",708232,23],["ἄβυσσον",700098,9],["εἰς",704105,0],["περίπατον",710363,6]],"and the lowest part of the deep as a captive: he reckons the deep as [his] range."],["25",[["οὐκ",709805,28],["ἔστιν",704093,91],["οὐδὲν",709817,26],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ὅμοιον",709626,27],["αὐτῷ",702165,50],["πεποιημένον",710582,439],["ἐγκαταπαίζεσθαι",703969,110],["ὑπὸ",713184,0],["τῶν",709436,80],["ἀγγέλων",700140,81],["μου",709032,133]],"There is nothing upon the earth like to him, formed to be sported with by my angels."],["26",[["πᾶν",710177,46],["ὑψηλὸν",713285,46],["ὁρᾷ",709725,91],["αὐτὸς",702165,121],["δὲ",703303,11],["βασιλεὺς",702580,4],["πάντων",710177,169],["τῶν",709436,80],["ἐν",704639,0],["τοῖς",709436,95],["ὕδασιν",713071,96]],"He beholds every high thing: and he is king of all that are in the waters."]]