[["1",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Ιωβ",706903,4],["λέγει",708124,91]],"But Job answered and said,"],["2",[["τίνι",712867,435],["πρόσκεισαι",710916,259],["ἢ",705924,7],["τίνι",712867,435],["μέλλεις",708705,154],["βοηθεῖν",702746,55],["πότερον",710697,28],["οὐχ",709805,28],["ᾧ",709781,309],["πολλὴ",710646,29],["ἰσχὺς",706858,12],["καὶ",707031,7],["ᾧ",709781,309],["βραχίων",702808,4],["κραταιός",707873,14],["ἐστιν",704093,91]],"To whom dost thou attach thyself, or whom art thou going to assist? is it not he that [has] much strength, and [he] who has a strong arm?"],["3",[["τίνι",712867,432],["συμβεβούλευσαι",712292,332],["οὐχ",709805,28],["ᾧ",709781,309],["πᾶσα",710177,29],["σοφία",711981,12],["ἢ",705924,7],["τίνι",712867,432],["ἐπακολουθήσεις",705007,166],["οὐχ",709805,28],["ᾧ",709781,309],["μεγίστη",708653,417],["δύναμις",703839,12]],"To whom hast thou given counsel? is it not to him who has all wisdom? whom wilt thou follow? is it not one who has the greatest power?"],["4",[["τίνι",712867,432],["ἀνήγγειλας",700921,162],["ῥήματα",711246,42],["πνοὴ",710574,12],["δὲ",703303,11],["τίνος",712867,340],["ἐστὶν",704093,91],["ἡ",709436,10],["ἐξελθοῦσα",704909,149],["ἐκ",704132,0],["σοῦ",711945,133]],"To whom hast thou uttered words? and whose breath is it that has come forth from thee?"],["5",[["μὴ",708851,28],["γίγαντες",703101,52],["μαιωθήσονται",708390,144],["ὑποκάτωθεν",713205,28],["ὕδατος",713071,21],["καὶ",707031,7],["τῶν",709436,80],["γειτόνων",703016,81],["αὐτοῦ",702165,102]],"Shall giants be born from under the water and the inhabitants thereof?"],["6",[["γυμνὸς",703202,14],["ὁ",709436,3],["ᾅδης",700255,4],["ἐπώπιον",705376,28],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["περιβόλαιον",710300,15],["τῇ",709436,100],["ἀπωλείᾳ",701660,1]],"Hell is naked before him, and destruction has no covering."],["7",[["ἐκτείνων",704322,72],["βορέαν",702765,6],["ἐπ᾿",705080,0],["οὐδέν",709817,46],["κρεμάζων",707892,72],["γῆν",703083,9],["ἐπὶ",705080,0],["οὐδενός",709817,116]],"He stretches out the north wind upon nothing, and he upon nothing hangs the earth;"],["8",[["δεσμεύων",703369,72],["ὕδωρ",713071,25],["ἐν",704639,0],["νεφέλαις",709277,76],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ἐρράγη",711243,37],["νέφος",709281,25],["ὑποκάτω",713204,28],["αὐτοῦ",702165,102]],"binding water in his clouds, and the cloud is not rent under it."],["9",[["ὁ",709436,3],["κρατῶν",707879,72],["πρόσωπον",710986,25],["θρόνου",706315,18],["ἐκπετάζων",704277,72],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["νέφος",709281,25],["αὐτοῦ",702165,102]],"He keeps back the face of his throne, stretching out his cloud upon it."],["10",[["πρόσταγμα",710959,25],["ἐγύρωσεν",703211,2],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["ὕδατος",713071,21],["μέχρι",708849,0],["συντελείας",712509,17],["φωτὸς",713642,21],["μετὰ",708780,0],["σκότους",711889,21]],"He has encompassed the face of the water by an appointed ordinance, until the end of light and darkness."],["11",[["στῦλοι",712179,52],["οὐρανοῦ",709844,18],["ἐπετάσθησαν",710435,99],["καὶ",707031,7],["ἐξέστησαν",704940,150],["ἀπὸ",701425,0],["τῆς",709436,16],["ἐπιτιμήσεως",705306,17],["αὐτοῦ",702165,102]],"The pillars of heaven are prostrate and astonished at his rebuke."],["12",[["ἰσχύι",706858,1],["κατέπαυσεν",707365,2],["τὴν",709436,8],["θάλασσαν",706069,9],["ἐπιστήμῃ",705267,1],["δὲ",703303,11],["ἔτρωσε",712871,2],["τὸ",709436,24],["κῆτος",707664,25]],"He has calmed the sea with [his] might, and by [his] wisdom the whale has been overthrown."],["13",[["κλεῖθρα",707708,64],["δὲ",703303,11],["οὐρανοῦ",709844,18],["δεδοίκασιν",703313,353],["αὐτόν",702165,85],["προστάγματι",710959,54],["δὲ",703303,11],["ἐθανάτωσεν",706097,2],["δράκοντα",703822,6],["ἀποστάτην",701590,6]],"And the barriers of heaven fear him, and by a command he has slain the apostate dragon."],["14",[["ἰδοὺ",706497,88],["ταῦτα",709858,290],["μέρη",708752,64],["ὁδοῦ",709458,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπὶ",705080,0],["ἰκμάδα",706719,39],["λόγου",708236,18],["ἀκουσόμεθα",700587,141],["ἐν",704639,0],["αὐτῷ",702165,50],["σθένος",711760,25],["δὲ",703303,11],["βροντῆς",702816,17],["αὐτοῦ",702165,102],["τίς",712867,158],["οἶδεν",709492,171],["ὁπότε",709709,28],["ποιήσει",710582,127]],"Behold, these are parts of his way; and we will hearken to him at the least intimation of his word: but the strength of his thunder who knows, when he shall employ [it]?"]]