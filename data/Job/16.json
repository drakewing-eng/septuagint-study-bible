[["1",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Ιωβ",706903,4],["λέγει",708124,91]],"But Job answered and said,"],["2",[["ἀκήκοα",700587,89],["τοιαῦτα",712878,68],["πολλά",710646,68],["παρακλήτορες",710049,52],["κακῶν",707066,169],["πάντες",710177,138]],"I have heard many such things: poor comforters are ye all."],["3",[["τί",712867,273],["γάρ",702963,11],["μὴ",708851,28],["τάξις",712712,12],["ἐστὶν",704093,91],["ῥήμασιν",711246,96],["πνεύματος",710566,21],["ἢ",705924,7],["τί",712867,273],["παρενοχλήσει",710135,127],["σοι",711925,159],["ὅτι",709803,7],["ἀποκρίνῃ",701492,204]],"What! is there any reason in vain words? or what will hinder thee from answering?"],["4",[["κἀγὼ",706969,288],["καθ᾿",707200,0],["ὑμᾶς",713080,194],["λαλήσω",708071,207],["εἰ",704071,7],["ὑπέκειτό",713206,19],["γε",702985,11],["ἡ",709436,10],["ψυχὴ",714070,12],["ὑμῶν",713091,145],["ἀντὶ",701227,0],["τῆς",709436,16],["ἐμῆς",704578,82],["εἶτ᾿",704129,28],["ἐναλοῦμαι",704652,165],["ὑμῖν",713084,90],["ῥήμασιν",711246,96],["κινήσω",707679,165],["δὲ",703303,11],["καθ᾿",707200,0],["ὑμῶν",713091,145],["κεφαλήν",707639,9]],"I also will speak as ye [do]: if indeed your soul were in my [soul's] stead, then would I insult you with words, and I would shake my head at you."],["5",[["εἴη",704093,301],["δὲ",703303,11],["ἰσχὺς",706858,12],["ἐν",704639,0],["τῷ",709436,53],["στόματί",712125,54],["μου",709032,133],["κίνησιν",707681,9],["δὲ",703303,11],["χειλέων",713781,44],["οὐ",709805,28],["φείσομαι",713406,181]],"And would there were strength in my mouth, and I would not spare the movement of my lips."],["6",[["ἐὰν",703912,7],["γὰρ",702963,11],["λαλήσω",708071,165],["οὐκ",709805,28],["ἀλγήσω",700638,165],["τὸ",709436,24],["τραῦμα",712920,25],["ἐὰν",703912,7],["δὲ",703303,11],["καὶ",707031,7],["σιωπήσω",711818,165],["τί",712867,273],["ἔλαττον",704388,26],["τρωθήσομαι",712871,180]],"For if I should speak, I shall not feel the pain of my wound: and if I should be silent, how shall I be wounded the less?"],["7",[["νῦν",709384,28],["δὲ",703303,11],["κατάκοπόν",707284,27],["με",708618,163],["πεποίηκεν",710582,171],["μωρόν",709110,27],["σεσηπότα",711754,427]],"But now he has made me weary, and a worn-out fool; and thou hast laid hold of me."],["8",[["καὶ",707031,7],["ἐπελάβου",705185,174],["μου",709032,133],["εἰς",704105,0],["μαρτύριον",708525,25],["ἐγενήθη",703104,37],["καὶ",707031,7],["ἀνέστη",701173,2],["ἐν",704639,0],["ἐμοὶ",704577,159],["τὸ",709436,34],["ψεῦδός",714044,15],["μου",709032,133],["κατὰ",707200,0],["πρόσωπόν",710986,25],["μου",709032,133],["ἀνταπεκρίθη",701219,37]],"My falsehood has become a testimony, and has risen up against me: it has confronted me to my face."],["9",[["ὀργῇ",709728,1],["χρησάμενος",713937,248],["κατέβαλέν",707203,2],["με",708618,163],["ἔβρυξεν",702822,2],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["τοὺς",709436,58],["ὀδόντας",709461,57],["βέλη",702644,64],["πειρατῶν",710229,81],["αὐτοῦ",702165,102],["ἐπ᾿",705080,0],["ἐμοὶ",704577,159],["ἔπεσεν",710481,2]],"In his anger he has cast me down; he has gnashed his teeth upon me: the weapons of his robbers have fallen upon me."],["10",[["ἀκίσιν",700546,76],["ὀφθαλμῶν",709870,81],["ἐνήλατο",704652,23],["ὀξεῖ",709682,30],["ἔπαισέν",709933,2],["με",708618,163],["εἰς",704105,0],["σιαγόνα",711763,9],["ὁμοθυμαδὸν",709624,28],["δὲ",703303,11],["κατέδραμον",707463,150],["ἐπ᾿",705080,0],["ἐμοί",704577,159]],"He has attacked me with the keen glances of his eyes; with his sharp [spear] he has smitten me [down] upon my knees; and they have run upon me with one accord."],["11",[["παρέδωκεν",710014,2],["γάρ",702963,11],["με",708618,163],["ὁ",709436,3],["κύριος",707996,4],["εἰς",704105,0],["χεῖρας",713787,39],["ἀδίκου",700272,116],["ἐπὶ",705080,0],["δὲ",703303,11],["ἀσεβέσιν",701909,230],["ἔρριψέν",711267,2],["με",708618,163]],"For the Lord has delivered me into the hands of unrighteous men, and thrown me upon the ungodly."],["12",[["εἰρηνεύοντα",704097,183],["διεσκέδασέν",703575,2],["με",708618,163],["λαβών",708076,182],["με",708618,163],["τῆς",709436,16],["κόμης",707803,17],["διέτιλεν",703610,2],["κατέστησέν",707011,2],["με",708618,163],["ὥσπερ",714163,28],["σκοπόν",711877,6]],"When I was at peace he distracted me: he took me by the hair of the head, and plucked it out: he set me up as a mark."],["13",[["ἐκύκλωσάν",707958,150],["με",708618,163],["λόγχαις",708237,76],["βάλλοντες",702487,146],["εἰς",704105,0],["νεφρούς",709282,57],["μου",709032,133],["οὐ",709805,28],["φειδόμενοι",713406,348],["ἐξέχεαν",704368,150],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["τὴν",709436,8],["χολήν",713900,9],["μου",709032,133]],"They surrounded me with spears, aiming at my reins: without sparing [me] they poured out my gall upon the ground."],["14",[["κατέβαλόν",707203,150],["με",708618,163],["πτῶμα",711071,25],["ἐπὶ",705080,0],["πτώματι",711071,54],["ἔδραμον",712931,150],["πρός",710844,0],["με",708618,163],["δυνάμενοι",703838,348]],"They overthrew me with fall upon fall: they ran upon me in [their] might."],["15",[["σάκκον",711386,6],["ἔρραψα",711185,155],["ἐπὶ",705080,0],["βύρσης",702832,17],["μου",709032,133],["τὸ",709436,34],["δὲ",703303,11],["σθένος",711760,15],["μου",709032,133],["ἐν",704639,0],["γῇ",703083,1],["ἐσβέσθη",711596,37]],"They sewed sackcloth upon my skin, and my strength has been spent on the ground."],["16",[["ἡ",709436,10],["γαστήρ",702976,12],["μου",709032,133],["συγκέκαυται",712198,403],["ἀπὸ",701425,0],["κλαυθμοῦ",707705,18],["ἐπὶ",705080,0],["δὲ",703303,11],["βλεφάροις",702741,148],["μου",709032,133],["σκιά",711852,12]],"My belly has been parched with wailing, and darkness is on my eyelids."],["17",[["ἄδικον",700272,26],["δὲ",703303,11],["οὐδὲν",709817,26],["ἦν",704093,13],["ἐν",704639,0],["χερσίν",713787,76],["μου",709032,133],["εὐχὴ",705726,12],["δέ",703303,11],["μου",709032,133],["καθαρά",706988,29]],"Yet there was no injustice in my hands, and my prayer is pure."],["18",[["γῆ",703083,12],["μὴ",708851,28],["ἐπικαλύψῃς",705155,175],["ἐφ᾿",705080,0],["αἵματι",700442,54],["τῆς",709436,16],["σαρκός",711537,17],["μου",709032,133],["μηδὲ",708855,7],["εἴη",704093,301],["τόπος",712903,4],["τῇ",709436,100],["κραυγῇ",707886,1],["μου",709032,133]],"Earth, cover not over the blood of my flesh, and let my cry have no place."],["19",[["καὶ",707031,7],["νῦν",709384,28],["ἰδοὺ",706497,88],["ἐν",704639,0],["οὐρανοῖς",709844,148],["ὁ",709436,3],["μάρτυς",708527,4],["μου",709032,133],["ὁ",709436,3],["δὲ",703303,11],["συνίστωρ",712483,4],["μου",709032,133],["ἐν",704639,0],["ὑψίστοις",713287,94]],"And now, behold, my witness is in heaven, and my advocate is on high."],["20",[["ἀφίκοιτό",702212,382],["μου",709032,133],["ἡ",709436,10],["δέησις",703311,12],["πρὸς",710844,0],["κύριον",707996,6],["ἔναντι",704653,0],["δὲ",703303,11],["αὐτοῦ",702165,102],["στάζοι",712038,301],["μου",709032,133],["ὁ",709436,3],["ὀφθαλμός",709870,4]],"Let my supplication come to the Lord, and let mine eye weep before him."],["21",[["εἴη",704093,301],["δὲ",703303,11],["ἔλεγχος",704415,4],["ἀνδρὶ",701150,114],["ἔναντι",704653,0],["κυρίου",707996,18],["καὶ",707031,7],["υἱὸς",713075,4],["ἀνθρώπου",701163,18],["τῷ",709436,113],["πλησίον",710547,28],["αὐτοῦ",702165,102]],"Oh that a man might plead before the Lord, even [as] the son of man with his neighbour!"],["22",[["ἔτη",705543,64],["δὲ",703303,11],["ἀριθμητὰ",701743,195],["ἥκασιν",705956,197],["ὁδῷ",709458,1],["δέ",703303,11],["ᾗ",709781,108],["οὐκ",709805,28],["ἐπαναστραφήσομαι",705020,180],["πορεύσομαι",710667,181]],"But my years are numbered and [their end] come, and I shall go by the way by which I shall not return."]]