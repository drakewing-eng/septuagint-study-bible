[["1",[["μετὰ",708780,0],["τοῦτο",709858,129],["ἤνοιξεν",701186,2],["Ιωβ",706903,4],["τὸ",709436,24],["στόμα",712125,25],["αὐτοῦ",702165,102]],"After this Job opened his mouth, and cursed his day,"],["2",[["καὶ",707031,7],["κατηράσατο",707396,23],["τὴν",709436,8],["ἡμέραν",705984,9],["αὐτοῦ",702165,102],["λέγων",708124,72]],"saying,"],["3",[["ἀπόλοιτο",701513,382],["ἡ",709436,10],["ἡμέρα",705984,12],["ἐν",704639,0],["ᾗ",709781,108],["ἐγεννήθην",703051,156],["καὶ",707031,7],["ἡ",709436,10],["νύξ",709386,12],["ἐν",704639,0],["ᾗ",709781,108],["εἶπαν",705373,150],["ἰδοὺ",706497,88],["ἄρσεν",701818,26]],"Let the day perish in which I was born, and that night in which they said, Behold a man-child!"],["4",[["ἡ",709436,10],["ἡμέρα",705984,12],["ἐκείνη",704183,107],["εἴη",704093,301],["σκότος",711889,25],["καὶ",707031,7],["μὴ",708851,28],["ἀναζητήσαι",700943,225],["αὐτὴν",702165,104],["ὁ",709436,3],["κύριος",707996,4],["ἄνωθεν",701298,28],["μηδὲ",708855,7],["ἔλθοι",705453,225],["εἰς",704105,0],["αὐτὴν",702165,104],["φέγγος",713404,15]],"Let that night be darkness, and let not the Lord regard it from above, neither let light come upon it."],["5",[["ἐκλάβοι",704231,225],["δὲ",703303,11],["αὐτὴν",702165,104],["σκότος",711889,15],["καὶ",707031,7],["σκιὰ",711852,12],["θανάτου",706096,18],["ἐπέλθοι",705068,225],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["γνόφος",703131,4]],"But let darkness and the shadow of death seize it; let blackness come upon it;"],["6",[["καταραθείη",707396,528],["ἡ",709436,10],["ἡμέρα",705984,12],["καὶ",707031,7],["ἡ",709436,10],["νὺξ",709386,12],["ἐκείνη",704183,107],["ἀπενέγκαιτο",701632,382],["αὐτὴν",702165,104],["σκότος",711889,15],["μὴ",708851,28],["εἴη",704093,301],["εἰς",704105,0],["ἡμέρας",705984,39],["ἐνιαυτοῦ",704745,18],["μηδὲ",708855,7],["ἀριθμηθείη",701742,528],["εἰς",704105,0],["ἡμέρας",705984,39],["μηνῶν",708874,81]],"let that day and night be cursed, let darkness carry them away; let it not come into the days of the year, neither let it be numbered with the days of the months."],["7",[["ἀλλὰ",700680,7],["ἡ",709436,10],["νὺξ",709386,12],["ἐκείνη",704183,107],["εἴη",704093,301],["ὀδύνη",709463,12],["καὶ",707031,7],["μὴ",708851,28],["ἔλθοι",705453,225],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["εὐφροσύνη",705717,12],["μηδὲ",708855,7],["χαρμονή",713745,12]],"But let that night be pain, and let not mirth come upon it, nor joy."],["8",[["ἀλλὰ",700680,7],["καταράσαιτο",707396,382],["αὐτὴν",702165,104],["ὁ",709436,3],["καταρώμενος",707396,122],["τὴν",709436,8],["ἡμέραν",705984,9],["ἐκείνην",704183,104],["ὁ",709436,3],["μέλλων",708705,72],["τὸ",709436,24],["μέγα",708653,46],["κῆτος",707664,25],["χειρώσασθαι",713794,109]],"But let him that curses that day curse it, [even] he that is ready to attack the great whale."],["9",[["σκοτωθείη",711890,528],["τὰ",709436,63],["ἄστρα",702024,64],["τῆς",709436,16],["νυκτὸς",709386,17],["ἐκείνης",704183,86],["ὑπομείναι",713219,225],["καὶ",707031,28],["εἰς",704105,0],["φωτισμὸν",713647,6],["μὴ",708851,28],["ἔλθοι",705453,225],["καὶ",707031,7],["μὴ",708851,28],["ἴδοι",709725,225],["ἑωσφόρον",705793,6],["ἀνατέλλοντα",701066,183]],"Let the stars of that night be darkened; let it remain [dark], and not come into light; and let it not see the morning star arise:"],["10",[["ὅτι",709803,7],["οὐ",709805,28],["συνέκλεισεν",712223,2],["πύλας",711082,39],["γαστρὸς",702976,17],["μητρός",708892,17],["μου",709032,133],["ἀπήλλαξεν",701333,2],["γὰρ",702963,11],["ἂν",700900,11],["πόνον",710661,6],["ἀπὸ",701425,0],["ὀφθαλμῶν",709870,81],["μου",709032,133]],"because it shut not up the gates of my mother's womb, for [so] it would have removed sorrow from my eyes."],["11",[["διὰ",703417,0],["τί",712867,126],["γὰρ",702963,11],["ἐν",704639,0],["κοιλίᾳ",707761,1],["οὐκ",709805,28],["ἐτελεύτησα",712781,155],["ἐκ",704132,0],["γαστρὸς",702976,17],["δὲ",703303,11],["ἐξῆλθον",704909,155],["καὶ",707031,28],["οὐκ",709805,28],["εὐθὺς",705602,28],["ἀπωλόμην",701513,161]],"For why died I not in the belly? and [why] did I not come forth from the womb and die immediately?"],["12",[["ἵνα",706747,7],["τί",712867,126],["δὲ",703303,11],["συνήντησάν",712394,150],["μοι",708974,159],["γόνατα",703172,64],["ἵνα",706747,7],["τί",712867,126],["δὲ",703303,11],["μαστοὺς",708569,57],["ἐθήλασα",706233,155]],"And why did the knees support me? and why did I suck the breasts?"],["13",[["νῦν",709384,28],["ἂν",700900,11],["κοιμηθεὶς",707767,217],["ἡσύχασα",706033,155],["ὑπνώσας",713182,182],["δὲ",703303,11],["ἀνεπαυσάμην",701027,161]],"Now I should have lain down and been quiet, I should have slept and been at rest,"],["14",[["μετὰ",708780,0],["βασιλέων",702580,81],["βουλευτῶν",702789,81],["γῆς",703083,17],["οἳ",709781,250],["ἠγαυριῶντο",700132,139],["ἐπὶ",705080,0],["ξίφεσιν",709423,96]],"with kings [and] councillors of the earth, who gloried in [their] swords;"],["15",[["ἢ",705924,7],["μετὰ",708780,0],["ἀρχόντων",701862,81],["ὧν",709781,252],["πολὺς",710646,14],["ὁ",709436,3],["χρυσός",713975,4],["οἳ",709781,250],["ἔπλησαν",710532,150],["τοὺς",709436,58],["οἴκους",709516,57],["αὐτῶν",702165,40],["ἀργυρίου",701707,21]],"or with rulers, whose gold was abundant, who filled their houses with silver:"],["16",[["ἢ",705924,7],["ὥσπερ",714163,28],["ἔκτρωμα",704348,15],["ἐκπορευόμενον",704293,122],["ἐκ",704132,0],["μήτρας",708894,17],["μητρὸς",708892,17],["ἢ",705924,7],["ὥσπερ",714163,28],["νήπιοι",709295,138],["οἳ",709781,250],["οὐκ",709805,28],["εἶδον",709725,150],["φῶς",713642,25]],"or [I should have been] as an untimely birth proceeding from his mother's womb, or as infants who never saw light."],["17",[["ἐκεῖ",704181,28],["ἀσεβεῖς",701909,138],["ἐξέκαυσαν",704205,150],["θυμὸν",706334,6],["ὀργῆς",709728,17],["ἐκεῖ",704181,28],["ἀνεπαύσαντο",701027,189],["κατάκοποι",707284,138],["τῷ",709436,53],["σώματι",712635,54]],"There the ungodly have burnt out the fury of rage; there the wearied in body rest."],["18",[["ὁμοθυμαδὸν",709624,28],["δὲ",703303,11],["οἱ",709436,136],["αἰώνιοι",700505,138],["οὐκ",709805,28],["ἤκουσαν",700587,150],["φωνὴν",713640,9],["φορολόγου",713559,18]],"And the men of old time have together ceased to hear the exactor's voice."],["19",[["μικρὸς",708915,14],["καὶ",707031,7],["μέγας",708653,14],["ἐκεῖ",704181,28],["ἐστιν",704093,91],["καὶ",707031,7],["θεράπων",706201,4],["οὐ",709805,28],["δεδοικὼς",703313,270],["τὸν",709436,5],["κύριον",707996,6],["αὐτοῦ",702165,102]],"The small and great are there, and the servant that feared his lord."],["20",[["ἵνα",706747,7],["τί",712867,126],["γὰρ",702963,11],["δέδοται",703654,187],["τοῖς",709436,147],["ἐν",704639,0],["πικρίᾳ",710472,1],["φῶς",713642,15],["ζωὴ",705910,12],["δὲ",703303,11],["ταῖς",709436,75],["ἐν",704639,0],["ὀδύναις",709463,76],["ψυχαῖς",714070,76]],"For why is light given to those who are in bitterness, and life to the souls which are in griefs?"],["21",[["οἳ",709781,250],["ὁμείρονται",706745,269],["τοῦ",709436,35],["θανάτου",706096,18],["καὶ",707031,7],["οὐ",709805,28],["τυγχάνουσιν",713015,197],["ἀνορύσσοντες",701198,146],["ὥσπερ",714163,28],["θησαυρούς",706258,57]],"who desire death, and obtain it not, digging [for it] as [for] treasures;"],["22",[["περιχαρεῖς",710419,138],["δὲ",703303,11],["ἐγένοντο",703104,189],["ἐὰν",703912,7],["κατατύχωσιν",707467,234]],"and would be very joyful if they should gain it?"],["23",[["θάνατος",706096,4],["ἀνδρὶ",701150,114],["ἀνάπαυμα",701025,15],["συνέκλεισεν",712223,2],["γὰρ",702963,11],["ὁ",709436,3],["θεὸς",706192,4],["κατ᾿",707200,0],["αὐτοῦ",702165,102]],"Death [is] rest to [such] a man, for God has hedged him in."],["24",[["πρὸ",710747,0],["γὰρ",702963,11],["τῶν",709436,80],["σίτων",711814,81],["μου",709032,133],["στεναγμός",712065,4],["μοι",708974,159],["ἥκει",705956,91],["δακρύω",703256,157],["δὲ",703303,11],["ἐγὼ",704018,164],["συνεχόμενος",712469,122],["φόβῳ",713534,114]],"For my groaning comes before my food, and I weep being beset with terror."],["25",[["φόβος",713534,4],["γάρ",702963,11],["ὃν",709781,112],["ἐφρόντισα",713590,155],["ἦλθέν",705453,2],["μοι",708974,159],["καὶ",707031,7],["ὃν",709781,112],["ἐδεδοίκειν",703313,499],["συνήντησέν",712394,2],["μοι",708974,159]],"For the terror of which I meditated has come upon me, and that which I had feared has befallen me."],["26",[["οὔτε",709857,7],["εἰρήνευσα",704097,155],["οὔτε",709857,7],["ἡσύχασα",706033,155],["οὔτε",709857,7],["ἀνεπαυσάμην",701027,161],["ἦλθεν",705453,2],["δέ",703303,11],["μοι",708974,159],["ὀργή",709728,12]],"I was not at peace, nor quiet, nor had I rest; yet wrath came upon me."]]