[["1",[["προσθεὶς",710965,182],["δὲ",703303,11],["Ελιους",704478,4],["ἔτι",705538,28],["λέγει",708124,91]],"And Elius further continued, and said,"],["2",[["μεῖνόν",708736,176],["με",708618,163],["μικρὸν",708915,27],["ἔτι",705538,28],["ἵνα",706747,7],["διδάξω",703649,165],["σε",711598,163],["ἔτι",705538,28],["γὰρ",702963,11],["ἐν",704639,0],["ἐμοί",704577,159],["ἐστιν",704093,91],["λέξις",708144,12]],"Wait for me yet a little while, that I may teach thee: for there is yet speech in me."],["3",[["ἀναλαβὼν",700984,182],["τὴν",709436,8],["ἐπιστήμην",705267,9],["μου",709032,133],["μακρὰν",708411,28],["ἔργοις",705396,96],["δέ",703303,11],["μου",709032,133],["δίκαια",703694,68],["ἐρῶ",705415,165]],"Having fetched my knowledge from afar, and according to my works,"],["4",[["ἐπ᾿",705080,0],["ἀληθείας",700656,17],["καὶ",707031,7],["οὐκ",709805,28],["ἄδικα",700272,68],["ῥήματα",711246,42],["ἀδίκως",700273,28],["συνίεις",712481,154]],"I will speak just things truly, and thou shalt not unjustly receive unjust words."],["5",[["γίγνωσκε",703105,240],["δὲ",703303,11],["ὅτι",709803,7],["ὁ",709436,3],["κύριος",707996,4],["οὐ",709805,28],["μὴ",708851,28],["ἀποποιήσηται",701552,239],["τὸν",709436,5],["ἄκακον",700512,27],["δυνατὸς",703845,14],["ἰσχύι",706858,1],["καρδίας",707141,17]],"But know that the Lord will not cast off an innocent man: being mighty in strength of wisdom,"],["6",[["ἀσεβῆ",701909,27],["οὐ",709805,28],["μὴ",708851,28],["ζωοποιήσει",705917,127],["καὶ",707031,7],["κρίμα",707903,25],["πτωχῶν",711076,81],["δώσει",703654,127]],"he will not by any means save alive the ungodly: and he will grant the judgment of the poor."],["7",[["οὐκ",709805,28],["ἀφελεῖ",702177,127],["ἀπὸ",701425,0],["δικαίου",703694,116],["ὀφθαλμοὺς",709870,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["μετὰ",708780,0],["βασιλέων",702580,81],["εἰς",704105,0],["θρόνον",706315,6],["καὶ",707031,7],["καθιεῖ",707006,127],["αὐτοὺς",702165,62],["εἰς",704105,0],["νεῖκος",709246,25],["καὶ",707031,7],["ὑψωθήσονται",713289,144]],"He will not turn away his eyes from the righteous, but [they shall be] with kings on the throne: and he will establish them in triumph, and they shall be exalted."],["8",[["καὶ",707031,7],["εἰ",704071,7],["πεπεδημένοι",710208,362],["ἐν",704639,0],["χειροπέδαις",713795,76],["συσχεθήσονται",712469,144],["ἐν",704639,0],["σχοινίοις",712610,96],["πενίας",710254,17]],"But they that are bound in fetters shall be holden in cords of poverty."],["9",[["καὶ",707031,7],["ἀναγγελεῖ",700921,127],["αὐτοῖς",702165,151],["τὰ",709436,41],["ἔργα",705396,42],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,41],["παραπτώματα",710095,42],["αὐτῶν",702165,40],["ὅτι",709803,7],["ἰσχύσουσιν",706859,218]],"And he shall recount to them their works, and their transgressions, for such will act with violence."],["10",[["ἀλλὰ",700680,7],["τοῦ",709436,35],["δικαίου",703694,116],["εἰσακούσεται",704108,93],["καὶ",707031,7],["εἶπεν",705373,2],["ὅτι",709803,7],["ἐπιστραφήσονται",705278,144],["ἐξ",704132,0],["ἀδικίας",700271,17]],"But he will hearken to the righteous: and he has said that they shall turn from unrighteousness."],["11",[["ἐὰν",703912,7],["ἀκούσωσιν",700587,234],["καὶ",707031,7],["δουλεύσωσιν",703814,234],["συντελέσουσιν",712510,218],["τὰς",709436,38],["ἡμέρας",705984,39],["αὐτῶν",702165,40],["ἐν",704639,0],["ἀγαθοῖς",700106,230],["καὶ",707031,7],["τὰ",709436,41],["ἔτη",705543,42],["αὐτῶν",702165,40],["ἐν",704639,0],["εὐπρεπείαις",705666,76]],"If they should hear and serve [him], they shall spend their days in prosperity, and their years in honour."],["12",[["ἀσεβεῖς",701909,138],["δὲ",703303,11],["οὐ",709805,28],["διασῴζει",703599,91],["παρὰ",709995,0],["τὸ",709436,24],["μὴ",708851,28],["βούλεσθαι",702795,110],["εἰδέναι",709492,115],["αὐτοὺς",702165,62],["τὸν",709436,5],["κύριον",707996,6],["καὶ",707031,7],["διότι",703734,7],["νουθετούμενοι",709367,348],["ἀνήκοοι",701144,138],["ἦσαν",704093,137]],"But he preserves not the ungodly; because they are not willing to know the Lord, and because when reproved they were disobedient."],["13",[["καὶ",707031,7],["ὑποκριταὶ",713209,4],["καρδίᾳ",707141,1],["τάξουσιν",712730,218],["θυμόν",706334,6],["οὐ",709805,28],["βοήσονται",702743,135],["ὅτι",709803,7],["ἔδησεν",703394,2],["αὐτούς",702165,62]],"And the hypocrites in heart will array wrath [against themselves]; they will not cry, because he has bound them."],["14",[["ἀποθάνοι",701461,225],["τοίνυν",712875,11],["ἐν",704639,0],["νεότητι",709258,1],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτῶν",702165,40],["ἡ",709436,10],["δὲ",703303,11],["ζωὴ",705910,12],["αὐτῶν",702165,40],["τιτρωσκομένη",712871,473],["ὑπὸ",713184,0],["ἀγγέλων",700140,81]],"Therefore let their soul die in youth, and their life be wounded by messengers [of death]."],["15",[["ἀνθ᾿",701227,0],["ὧν",709781,252],["ἔθλιψαν",706274,150],["ἀσθενῆ",701939,68],["καὶ",707031,7],["ἀδύνατον",700297,27],["κρίμα",707903,25],["δὲ",703303,11],["πραέων",710725,169],["ἐκθήσει",704330,127]],"Because they afflicted the weak and helpless: and he will vindicate the judgment of the meek."],["16",[["καὶ",707031,7],["προσέτι",710891,28],["ἠπάτησέν",701364,2],["σε",711598,163],["ἐκ",704132,0],["στόματος",712125,21],["ἐχθροῦ",705779,18],["ἄβυσσος",700098,12],["κατάχυσις",707497,12],["ὑποκάτω",713204,28],["αὐτῆς",702165,86],["καὶ",707031,7],["κατέβη",707202,2],["τράπεζά",712919,12],["σου",711945,133],["πλήρης",710541,14],["πιότητος",710479,17]],"And he has also enticed thee out of the mouth of the enemy:"],["17",[["οὐχ",709805,28],["ὑστερήσει",713270,127],["δὲ",703303,11],["ἀπὸ",701425,0],["δικαίων",703694,169],["κρίμα",707903,25]],"[there is] a deep gulf [and] a rushing stream beneath it, and thy table came down full of fatness. Judgment shall not fail from the righteous;"],["18",[["θυμὸς",706334,4],["δὲ",703303,11],["ἐπ᾿",705080,0],["ἀσεβεῖς",701909,60],["ἔσται",704093,93],["δι᾿",703417,0],["ἀσέβειαν",701904,9],["δώρων",703907,44],["ὧν",709781,103],["ἐδέχοντο",703393,139],["ἐπ᾿",705080,0],["ἀδικίαις",700271,76]],"but there shall be wrath upon the ungodly, by reason of the ungodliness of the bribes which they received for iniquities."],["19",[["μή",708851,28],["σε",711598,163],["ἐκκλινάτω",704220,45],["ἑκὼν",704374,14],["ὁ",709436,3],["νοῦς",709374,4],["δεήσεως",703311,17],["ἐν",704639,0],["ἀνάγκῃ",700925,1],["ὄντων",704093,170],["ἀδυνάτων",700297,169],["καὶ",707031,7],["πάντας",710177,60],["τοὺς",709436,58],["κραταιοῦντας",707875,235],["ἰσχύν",706858,9]],"Let not [thy] mind willingly turn thee aside from the petition of the feeble that are in distress."],["20",[["μὴ",708851,28],["ἐξελκύσῃς",704900,175],["τὴν",709436,8],["νύκτα",709386,9],["τοῦ",709436,20],["ἀναβῆναι",700905,106],["λαοὺς",708094,57],["ἀντ᾿",701227,0],["αὐτῶν",702165,40]],"And draw not forth all the mighty [men] by night, so that the people should go up instead of them."],["21",[["ἀλλὰ",700680,7],["φύλαξαι",713619,300],["μὴ",708851,28],["πράξῃς",710721,175],["ἄτοπα",702102,68],["ἐπὶ",705080,0],["τοῦτον",709858,85],["γὰρ",702963,11],["ἐξείλω",704893,157],["ἀπὸ",701425,0],["πτωχείας",711073,17]],"But take heed lest thou do that which is wrong: for of this thou hast made choice because of poverty."],["22",[["ἰδοὺ",706497,88],["ὁ",709436,3],["ἰσχυρὸς",706855,14],["κραταιώσει",707875,127],["ἐν",704639,0],["ἰσχύι",706858,1],["αὐτοῦ",702165,102],["τίς",712867,158],["γάρ",702963,11],["ἐστιν",704093,91],["κατ᾿",707200,0],["αὐτὸν",702165,85],["δυνάστης",703844,4]],"Behold, the Mighty One shall prevail by his strength: for who is powerful as he is?"],["23",[["τίς",712867,158],["δέ",703303,11],["ἐστιν",704093,91],["ὁ",709436,3],["ἐτάζων",705526,72],["αὐτοῦ",702165,102],["τὰ",709436,41],["ἔργα",705396,42],["ἢ",705924,7],["τίς",712867,158],["ὁ",709436,3],["εἴπας",705373,182],["ἔπραξεν",710721,2],["ἄδικα",700272,68]],"And who is he that examines his works? or who can say, He has wrought injustice?"],["24",[["μνήσθητι",708960,244],["ὅτι",709803,7],["μεγάλα",708653,195],["ἐστὶν",704093,91],["αὐτοῦ",702165,102],["τὰ",709436,63],["ἔργα",705396,64],["ὧν",709781,252],["ἦρξαν",701860,150],["ἄνδρες",701150,52]],"Remember that his works are great [beyond] those which men have attempted."],["25",[["πᾶς",710177,14],["ἄνθρωπος",701163,4],["εἶδεν",709725,2],["ἐν",704639,0],["ἑαυτῷ",703917,50],["ὅσοι",709788,138],["τιτρωσκόμενοί",712871,645],["εἰσιν",704093,197],["βροτοί",702817,52]],"Every man has seen in himself, how many mortals are wounded."],["26",[["ἰδοὺ",706497,88],["ὁ",709436,3],["ἰσχυρὸς",706855,14],["πολύς",710646,14],["καὶ",707031,7],["οὐ",709805,28],["γνωσόμεθα",703105,141],["ἀριθμὸς",701744,4],["ἐτῶν",705543,44],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀπέραντος",701393,14]],"Behold, the Mighty One is great, and we shall not know [him]: the number of his years is even infinite."],["27",[["ἀριθμηταὶ",701742,428],["δὲ",703303,11],["αὐτῷ",702165,50],["σταγόνες",712036,191],["ὑετοῦ",713074,18],["καὶ",707031,7],["ἐπιχυθήσονται",705337,144],["ὑετῷ",713074,114],["εἰς",704105,0],["νεφέλην",709277,9]],"And the drops of rain are numbered by him, and shall be poured out in rain to form a cloud."],["28",[["ῥυήσονται",711241,135],["παλαιώματα",709941,64],["ἐσκίασεν",711855,2],["δὲ",703303,11],["νέφη",709281,64],["ἐπὶ",705080,0],["ἀμυθήτων",700878,169],["βροτῶν",702817,81]],"The ancient [heavens] shall flow, and the clouds overshadow innumerable mortals:"],["28a",[["ὥραν",714128,9],["ἔθετο",712849,23],["κτήνεσιν",707934,96],["οἴδασιν",709492,353],["δὲ",703303,11],["κοίτης",707781,17],["τάξιν",712712,9]],null],["28b",[["ἐπὶ",705080,0],["τούτοις",709858,151],["πᾶσιν",710177,230],["οὐκ",709805,28],["ἐξίσταταί",704940,117],["σου",711945,133],["ἡ",709436,10],["διάνοια",703531,12],["οὐδὲ",709816,7],["διαλλάσσεταί",703502,117],["σου",711945,133],["ἡ",709436,10],["καρδία",707141,12],["ἀπὸ",701425,0],["σώματος",712635,21]],null],["29",[["καὶ",707031,7],["ἐὰν",703912,7],["συνῇ",712435,204],["ἀπεκτάσεις",701383,39],["νεφέλης",709277,17],["ἰσότητα",706833,39],["σκηνῆς",711845,17],["αὐτοῦ",702165,102]],"And though one should understand the outspreadings of the clouds, [or] the measure of his tabernacle;"],["30",[["ἰδοὺ",706497,88],["ἐκτείνει",704322,91],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["ηδω",705949,227],["καὶ",707031,7],["ῥιζώματα",711262,42],["τῆς",709436,16],["θαλάσσης",706069,17],["ἐκάλυψεν",707102,2]],"behold he will stretch his bow against him, and he covers the bottom of the sea."],["31",[["ἐν",704639,0],["γὰρ",702963,11],["αὐτοῖς",702165,151],["κρινεῖ",707905,127],["λαούς",708094,57],["δώσει",703654,127],["τροφὴν",712984,9],["τῷ",709436,113],["ἰσχύοντι",706859,379]],"For by them he will judge the nations: he will give food to him that has strength."],["32",[["ἐπὶ",705080,0],["χειρῶν",713787,65],["ἐκάλυψεν",707102,2],["φῶς",713642,25],["καὶ",707031,7],["ἐνετείλατο",704791,23],["περὶ",710285,0],["αὐτῆς",702165,86],["ἐν",704639,0],["ἀπαντῶντι",701345,379]],"He has hidden the light in [his] hands, and given charge concerning it to the interposing [cloud]."],["33",[["ἀναγγελεῖ",700921,127],["περὶ",710285,0],["αὐτοῦ",702165,102],["φίλον",713492,27],["αὐτοῦ",702165,102],["κτῆσις",707937,12],["καὶ",707031,7],["περὶ",710285,0],["ἀδικίας",700271,17]],"The Lord will declare concerning this [to] his friend: [but there is] a portion also for unrighteousness."]]