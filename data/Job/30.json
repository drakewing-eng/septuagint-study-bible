[["1",[["νυνὶ",709385,28],["δὲ",703303,11],["κατεγέλασάν",707222,150],["μου",709032,133],["ἐλάχιστοι",704388,480],["νῦν",709384,28],["νουθετοῦσίν",709367,197],["με",708618,163],["ἐν",704639,0],["μέρει",708752,54],["ὧν",709781,252],["ἐξουδένουν",704969,333],["πατέρας",710189,57],["αὐτῶν",702165,40],["οὓς",709781,298],["οὐχ",709805,28],["ἡγησάμην",705931,161],["εἶναι",704093,55],["ἀξίους",701308,60],["κυνῶν",708004,65],["τῶν",709436,130],["ἐμῶν",704578,198],["νομάδων",709334,65]],"But now the youngest have laughed me to scorn, now they reprove me in [their] turn, whose fathers I set at nought; whom I did not deem worthy [to be with] my shepherd dogs."],["2",[["καί",707031,7],["γε",702985,11],["ἰσχὺς",706858,12],["χειρῶν",713787,65],["αὐτῶν",702165,40],["ἵνα",706747,7],["τί",712867,126],["μοι",708974,159],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["ἀπώλετο",701513,23],["συντέλεια",712509,12]],"Yea, why had I the strength of their hands? for them the full term [of life] was lost."],["3",[["ἐν",704639,0],["ἐνδείᾳ",704672,1],["καὶ",707031,7],["λιμῷ",708210,114],["ἄγονος",700182,14],["οἱ",709436,136],["φεύγοντες",713433,146],["ἄνυδρον",701285,27],["ἐχθὲς",713853,28],["συνοχὴν",712503,9],["καὶ",707031,7],["ταλαιπωρίαν",712695,9]],"[One is] childless in want and famine, [such as] they that fled but lately the distress and misery of drought."],["4",[["οἱ",709436,136],["περικλῶντες",710333,146],["ἅλιμα",700671,195],["ἐπὶ",705080,0],["ἠχοῦντι",706047,98],["οἵτινες",709793,450],["ἅλιμα",700671,195],["ἦν",704093,13],["αὐτῶν",702165,40],["τὰ",709436,41],["σῖτα",711814,42],["ἄτιμοι",702095,138],["δὲ",703303,11],["καὶ",707031,7],["πεφαυλισμένοι",713394,429],["ἐνδεεῖς",704671,138],["παντὸς",710177,116],["ἀγαθοῦ",700106,116],["οἳ",709781,250],["καὶ",707031,28],["ῥίζας",711260,39],["ξύλων",709427,44],["ἐμασῶντο",708558,139],["ὑπὸ",713184,0],["λιμοῦ",708210,18],["μεγάλου",708653,116]],"Who compass the salt places on the sounding [shore], who had salt [herbs] for their food, and were dishonourable and of no repute, in want of every good thing; who also ate roots of trees by reason of great hunger."],["5",[["ἐπανέστησάν",705026,150],["μοι",708974,159],["κλέπται",707714,52]],"Thieves have risen up against me,"],["6",[["ὧν",709781,252],["οἱ",709436,136],["οἶκοι",709516,52],["αὐτῶν",702165,40],["ἦσαν",704093,137],["τρῶγλαι",713012,191],["πετρῶν",710446,81]],"whose houses were the caves of the rocks, who lived under the wild shrubs."],["7",[["ἀνὰ",700902,0],["μέσον",708768,27],["εὐήχων",705586,169],["βοήσονται",702743,135],["οἳ",709781,250],["ὑπὸ",713184,0],["φρύγανα",713601,42],["ἄγρια",700191,68],["διῃτῶντο",703461,139]],"They will cry out among the rustling [bushes]."],["8",[["ἀφρόνων",702236,169],["υἱοὶ",713075,52],["καὶ",707031,7],["ἀτίμων",702095,169],["ὄνομα",709666,15],["καὶ",707031,7],["κλέος",707713,15],["ἐσβεσμένον",711596,413],["ἀπὸ",701425,0],["γῆς",703083,17]],"[They are] sons of fools and vile men, [whose] name and glory [are] quenched from off the earth."],["9",[["νυνὶ",709385,28],["δὲ",703303,11],["κιθάρα",707669,12],["ἐγώ",704018,164],["εἰμι",704093,157],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐμὲ",704555,163],["θρύλημα",706318,25],["ἔχουσιν",705785,197]],"But now I am their music, and they have me for a by-word."],["10",[["ἐβδελύξαντο",702608,189],["δέ",703303,11],["με",708618,163],["ἀποστάντες",702214,196],["μακράν",708411,28],["ἀπὸ",701425,0],["δὲ",703303,11],["προσώπου",710986,21],["μου",709032,133],["οὐκ",709805,28],["ἐφείσαντο",713406,189],["πτύελον",711067,6]],"And they stood aloof and abhorred me, and spared not to spit in my face."],["11",[["ἀνοίξας",701186,182],["γὰρ",702963,11],["φαρέτραν",713364,9],["αὐτοῦ",702165,102],["ἐκάκωσέν",707073,2],["με",708618,163],["καὶ",707031,7],["χαλινὸν",713685,6],["τοῦ",709436,20],["προσώπου",710986,21],["μου",709032,133],["ἐξαπέστειλαν",704872,150]],"For he has opened his quiver and afflicted me: they also have cast off the restraint of my presence."],["12",[["ἐπὶ",705080,0],["δεξιῶν",703360,169],["βλαστοῦ",702736,18],["ἐπανέστησαν",705026,150],["πόδα",710707,6],["αὐτῶν",702165,40],["ἐξέτειναν",704322,150],["καὶ",707031,7],["ὡδοποίησαν",709456,150],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["τρίβους",712939,39],["ἀπωλείας",701660,39],["αὐτῶν",702165,40]],"They have risen up against [me] on the right hand of [their] offspring; they have stretched out their foot, and directed against me the ways of their destruction."],["13",[["ἐξετρίβησαν",704345,99],["τρίβοι",712939,191],["μου",709032,133],["ἐξέδυσεν",704180,2],["γάρ",702963,11],["μου",709032,133],["τὴν",709436,8],["στολήν",712120,9]],"My paths are ruined; for they have stripped off my raiment: he has shot at me with his weapons."],["14",[["βέλεσιν",702644,96],["αὐτοῦ",702165,102],["κατηκόντισέν",707282,2],["με",708618,163],["κέχρηταί",713936,187],["μοι",708974,159],["ὡς",714148,7],["βούλεται",702795,117],["ἐν",704639,0],["ὀδύναις",709463,76],["πέφυρμαι",713629,326]],"And he has pleaded against me as he will: I am overwhelmed with pains."],["15",[["ἐπιστρέφονται",705278,269],["δέ",703303,11],["μου",709032,133],["αἱ",709436,190],["ὀδύναι",709463,191],["ᾤχετό",709539,19],["μου",709032,133],["ἡ",709436,10],["ἐλπὶς",704530,12],["ὥσπερ",714163,28],["πνεῦμα",710566,25],["καὶ",707031,7],["ὥσπερ",714163,28],["νέφος",709281,25],["ἡ",709436,10],["σωτηρία",712658,12],["μου",709032,133]],"My pains return upon [me]; my hope is gone like the wind, and my safety as a cloud."],["16",[["καὶ",707031,7],["νῦν",709384,28],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ἐκχυθήσεται",704368,134],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["ἔχουσιν",705785,197],["δέ",703303,11],["με",708618,163],["ἡμέραι",705984,191],["ὀδυνῶν",709463,65]],"Even now my life shall be poured forth upon me; and days of anguish seize me."],["17",[["νυκτὶ",709386,1],["δέ",703303,11],["μου",709032,133],["τὰ",709436,63],["ὀστᾶ",709792,64],["συγκέκαυται",712198,403],["τὰ",709436,63],["δὲ",703303,11],["νεῦρά",709275,64],["μου",709032,133],["διαλέλυται",703509,403]],"And by night my bones are confounded; and my sinews are relaxed."],["18",[["ἐν",704639,0],["πολλῇ",710646,101],["ἰσχύι",706858,1],["ἐπελάβετό",705185,23],["μου",709032,133],["τῆς",709436,16],["στολῆς",712120,17],["ὥσπερ",714163,28],["τὸ",709436,24],["περιστόμιον",710394,25],["τοῦ",709436,35],["χιτῶνός",713869,18],["μου",709032,133],["περιέσχεν",710315,2],["με",708618,163]],"With great force [my disease] has taken hold of my garment: it has compassed me as the collar of my coat."],["19",[["ἥγησαι",705931,332],["δέ",703303,11],["με",708618,163],["ἴσα",706832,28],["πηλῷ",710457,114],["ἐν",704639,0],["γῇ",703083,1],["καὶ",707031,7],["σποδῷ",712022,1],["μου",709032,133],["ἡ",709436,10],["μερίς",708748,12]],"And thou hast counted me as clay; my portion is in dust and ashes."],["20",[["κέκραγα",707868,89],["δὲ",703303,11],["πρὸς",710844,0],["σὲ",711598,163],["καὶ",707031,7],["οὐκ",709805,28],["εἰσακούεις",704108,154],["μου",709032,133],["ἔστησαν",706846,150],["καὶ",707031,7],["κατενόησάν",707341,150],["με",708618,163]],"And I have cried to thee, but thou hearest me not: but they stood still, and observed me."],["21",[["ἐπέβης",705082,162],["δέ",703303,11],["μοι",708974,159],["ἀνελεημόνως",701119,28],["χειρὶ",713787,1],["κραταιᾷ",707873,101],["με",708618,163],["ἐμαστίγωσας",708566,162]],"They attacked me also without mercy: thou hast scourged me with a strong hand."],["22",[["ἔταξας",712730,162],["δέ",703303,11],["με",708618,163],["ἐν",704639,0],["ὀδύναις",709463,76],["καὶ",707031,7],["ἀπέρριψάς",701563,162],["με",708618,163],["ἀπὸ",701425,0],["σωτηρίας",712658,17]],"And thou hast put me to grief, and hast cast me away from safety."],["23",[["οἶδα",709492,89],["γὰρ",702963,11],["ὅτι",709803,7],["θάνατός",706096,4],["με",708618,163],["ἐκτρίψει",704345,127],["οἰκία",709505,12],["γὰρ",702963,11],["παντὶ",710177,30],["θνητῷ",706279,30],["γῆ",703083,12]],"For I know that death will destroy me: for the earth is the house [appointed] for every mortal."],["24",[["εἰ",704071,7],["γὰρ",702963,11],["ὄφελον",709866,155],["δυναίμην",703838,712],["ἐμαυτὸν",704545,85],["χειρώσασθαι",713794,109],["ἢ",705924,7],["δεηθείς",703394,217],["γε",702985,11],["ἑτέρου",705535,116],["καὶ",707031,7],["ποιήσει",710582,127],["μοι",708974,159],["τοῦτο",709858,129]],"Oh then that I might lay hands upon myself, or at least ask another, and he should do this for me."],["25",[["ἐγὼ",704018,164],["δὲ",703303,11],["ἐπὶ",705080,0],["παντὶ",710177,30],["ἀδυνάτῳ",700297,30],["ἔκλαυσα",707703,155],["ἐστέναξα",712066,155],["δὲ",703303,11],["ἰδὼν",709725,182],["ἄνδρα",701150,6],["ἐν",704639,0],["ἀνάγκαις",700925,76]],"Yet I wept over every helpless man; I groaned when I saw a man in distress."],["26",[["ἐγὼ",704018,164],["δὲ",703303,11],["ἐπέχων",705076,72],["ἀγαθοῖς",700106,230],["ἰδοὺ",706497,88],["συνήντησάν",712394,150],["μοι",708974,159],["μᾶλλον",708448,28],["ἡμέραι",705984,191],["κακῶν",707066,83]],"But I, when I waited for good things, behold, days of evils came the more upon me."],["27",[["ἡ",709436,10],["κοιλία",707761,12],["μου",709032,133],["ἐξέζεσεν",704186,2],["καὶ",707031,7],["οὐ",709805,28],["σιωπήσεται",711818,93],["προέφθασάν",711011,150],["με",708618,163],["ἡμέραι",705984,191],["πτωχείας",711073,17]],"My belly boiled, and would not cease: the days of poverty prevented me."],["28",[["στένων",712072,72],["πεπόρευμαι",710667,326],["ἄνευ",701137,0],["φιμοῦ",713508,18],["ἕστηκα",706846,89],["δὲ",703303,11],["ἐν",704639,0],["ἐκκλησίᾳ",704216,1],["κεκραγώς",707868,270]],"I went mourning without restraint: and I have stood and cried out in the assembly."],["29",[["ἀδελφὸς",700249,4],["γέγονα",703104,89],["σειρήνων",711627,65],["ἑταῖρος",705529,4],["δὲ",703303,11],["στρουθῶν",712167,81]],"I am become a brother of monsters, and a companion of ostriches."],["30",[["τὸ",709436,34],["δὲ",703303,11],["δέρμα",703363,15],["μου",709032,133],["ἐσκότωται",711890,403],["μεγάλως",708650,28],["τὰ",709436,63],["δὲ",703303,11],["ὀστᾶ",709792,64],["μου",709032,133],["ἀπὸ",701425,0],["καύματος",707564,21]],"And my skin has been greatly blackened, and my bones are burned with heat."],["31",[["ἀπέβη",701426,2],["δὲ",703303,11],["εἰς",704105,0],["πάθος",709918,25],["μου",709032,133],["ἡ",709436,10],["κιθάρα",707669,12],["ὁ",709436,3],["δὲ",703303,11],["ψαλμός",714022,4],["μου",709032,133],["εἰς",704105,0],["κλαυθμὸν",707705,6],["ἐμοί",704577,159]],"My harp also has been turned into mourning, and my song into my weeping."]]