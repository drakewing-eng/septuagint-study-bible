[["1",[["καὶ",707031,7],["ταύτης",709858,86],["ἐταράχθη",712721,37],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["καὶ",707031,7],["ἀπερρύη",701559,37],["ἐκ",704132,0],["τοῦ",709436,35],["τόπου",712903,18],["αὐτῆς",702165,86]],"At this also my heart is troubled, and moved out of its place."],["2",[["ἄκουε",700587,240],["ἀκοὴν",700561,9],["ἐν",704639,0],["ὀργῇ",709728,1],["θυμοῦ",706334,18],["κυρίου",707996,18],["καὶ",707031,7],["μελέτη",708699,12],["ἐκ",704132,0],["στόματος",712125,21],["αὐτοῦ",702165,102],["ἐξελεύσεται",704909,93]],"Hear thou a report by the anger of the Lord's wrath, and a discourse shall come out of his mouth."],["3",[["ὑποκάτω",713204,28],["παντὸς",710177,116],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["ἀρχὴ",701836,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὸ",709436,24],["φῶς",713642,25],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["πτερύγων",711057,65],["τῆς",709436,16],["γῆς",703083,17]],"His dominion is under the whole heaven, and his light is at the extremities of the earth."],["4",[["ὀπίσω",709697,0],["αὐτοῦ",702165,102],["βοήσεται",702743,93],["φωνή",713640,12],["βροντήσει",702815,127],["ἐν",704639,0],["φωνῇ",713640,1],["ὕβρεως",713051,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ἀνταλλάξει",701210,127],["αὐτούς",702165,62],["ὅτι",709803,7],["ἀκούσει",700587,127],["φωνὴν",713640,9],["αὐτοῦ",702165,102]],"After him shall be a cry with a [loud] voice; he shall thunder with the voice of his excellency, yet he shall not cause men to pass away, for one shall hear his voice."],["5",[["βροντήσει",702815,127],["ὁ",709436,3],["ἰσχυρὸς",706855,14],["ἐν",704639,0],["φωνῇ",713640,1],["αὐτοῦ",702165,102],["θαυμάσια",706136,68],["ἐποίησεν",710582,2],["γὰρ",702963,11],["μεγάλα",708653,68],["ἃ",709781,69],["οὐκ",709805,28],["ᾔδειμεν",709492,376]],"The Mighty One shall thunder wonderfully with his voice: for he has done great things which we knew not;"],["6",[["συντάσσων",712508,72],["χιόνι",713870,1],["γίνου",703104,253],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["χειμὼν",713786,4],["ὑετός",713074,4],["καὶ",707031,7],["χειμὼν",713786,4],["ὑετῶν",713074,81],["δυναστείας",703841,17],["αὐτοῦ",702165,102]],"commanding the snow, Be thou upon the earth, and the stormy rain, and the storm of the showers of his might."],["7",[["ἐν",704639,0],["χειρὶ",713787,1],["παντὸς",710177,116],["ἀνθρώπου",701163,18],["κατασφραγίζει",707450,91],["ἵνα",706747,7],["γνῷ",703105,172],["πᾶς",710177,14],["ἄνθρωπος",701163,4],["τὴν",709436,8],["ἑαυτοῦ",703917,102],["ἀσθένειαν",701937,9]],"He seals up the hand of every man, that every man may know his own weakness."],["8",[["εἰσῆλθεν",704114,2],["δὲ",703303,11],["θηρία",706252,64],["ὑπὸ",713184,0],["σκέπην",711838,9],["ἡσύχασαν",706033,150],["δὲ",703303,11],["ἐπὶ",705080,0],["κοίτης",707781,17]],"And the wild beasts come in under the covert, and rest in [their] lair."],["9",[["ἐκ",704132,0],["ταμιείων",712700,44],["ἐπέρχονται",705068,269],["δῖναι",703713,191],["ἀπὸ",701425,0],["δὲ",703303,11],["ἀκρωτηρίων",700614,44],["ψῦχος",714073,15]],"Troubles come on out of the secret chambers, and cold from the mountain-tops."],["10",[["καὶ",707031,7],["ἀπὸ",701425,0],["πνοῆς",710574,17],["ἰσχυροῦ",706855,116],["δώσει",703654,127],["πάγος",709912,4],["οἰακίζει",709490,91],["δὲ",703303,11],["τὸ",709436,24],["ὕδωρ",713071,25],["ὡς",714148,7],["ἐὰν",703912,7],["βούληται",702795,428]],"And from the breath of the Mighty One he will send frost; and he guides the water in whatever way he pleases."],["11",[["καὶ",707031,7],["ἐκλεκτὸν",704240,27],["καταπλάσσει",707377,91],["νεφέλη",709277,12],["διασκορπιεῖ",703579,127],["νέφος",709281,25],["φῶς",713642,15],["αὐτοῦ",702165,102]],"And [if] a cloud obscures [what is] precious [to him], his light will disperse the cloud."],["12",[["καὶ",707031,7],["αὐτὸς",702165,121],["κυκλώματα",707960,42],["διαστρέψει",703592,127],["ἐν",704639,0],["θεεβουλαθω",706149,285],["εἰς",704105,0],["ἔργα",705396,42],["αὐτῶν",702165,40],["πάντα",710177,68],["ὅσα",709788,68],["ἂν",700900,11],["ἐντείληται",704791,239],["αὐτοῖς",702165,151],["ταῦτα",709858,290],["συντέτακται",712508,403],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"And he will carry round the encircling [clouds] by his governance, to [perform] their works: whatsoever he shall command them,"],["13",[["ἐὰν",703912,7],["εἰς",704105,0],["παιδείαν",709924,9],["ἐὰν",703912,7],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["αὐτοῦ",702165,102],["ἐὰν",703912,7],["εἰς",704105,0],["ἔλεος",704426,25],["εὑρήσει",705676,127],["αὐτόν",702165,85]],"this has been appointed by him on the earth, whether for correction, [or] for his land, or if he shall find him [an object] for mercy."],["14",[["ἐνωτίζου",704825,253],["ταῦτα",709858,71],["Ιωβ",706903,153],["στῆθι",706846,176],["νουθετοῦ",709367,733],["δύναμιν",703839,9],["κυρίου",707996,18]],"Hearken to this, O Job: stand still, and be admonished of the power of the Lord."],["15",[["οἴδαμεν",709492,314],["ὅτι",709803,7],["ὁ",709436,3],["θεὸς",706192,4],["ἔθετο",712849,23],["ἔργα",705396,42],["αὐτοῦ",702165,102],["φῶς",713642,25],["ποιήσας",710582,182],["ἐκ",704132,0],["σκότους",711889,21]],"We know that God has disposed his works, having made light out of darkness."],["16",[["ἐπίσταται",705264,117],["δὲ",703303,11],["διάκρισιν",703489,9],["νεφῶν",709281,44],["ἐξαίσια",704840,68],["δὲ",703303,11],["πτώματα",711071,42],["πονηρῶν",710660,169]],"And he knows the divisions of the clouds, and the signal overthrows of the ungodly."],["17",[["σοῦ",711945,133],["δὲ",703303,11],["ἡ",709436,10],["στολὴ",712120,12],["θερμή",706217,29],["ἡσυχάζεται",706033,117],["δὲ",703303,11],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"But thy robe is warm, and there is quiet upon the land."],["18",[["στερεώσεις",712076,166],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["εἰς",704105,0],["παλαιώματα",709941,42],["ἰσχυραὶ",706855,192],["ὡς",714148,7],["ὅρασις",709721,12],["ἐπιχύσεως",705339,17]],"Wilt thou establish with him [foundations] for the ancient [heavens? they are] strong as a molten mirror."],["19",[["διὰ",703417,0],["τί",712867,126],["δίδαξόν",703649,176],["με",708618,163],["τί",712867,126],["ἐροῦμεν",705415,275],["αὐτῷ",702165,50],["καὶ",707031,7],["παυσώμεθα",710202,276],["πολλὰ",710646,68],["λέγοντες",708124,146]],"Wherefore teach me, what shall we say to him? and let us cease from saying much."],["20",[["μὴ",708851,28],["βίβλος",702721,12],["ἢ",705924,7],["γραμματεύς",703185,4],["μοι",708974,159],["παρέστηκεν",710152,171],["ἵνα",706747,7],["ἄνθρωπον",701163,6],["ἑστηκὼς",706846,270],["κατασιωπήσω",707415,207]],"Have I a book or a scribe by me, that I may stand and put man to silence?"],["21",[["πᾶσιν",710177,230],["δ᾿",703303,11],["οὐχ",709805,28],["ὁρατὸν",709724,46],["τὸ",709436,24],["φῶς",713642,25],["τηλαυγές",712841,26],["ἐστιν",704093,91],["ἐν",704639,0],["τοῖς",709436,147],["παλαιώμασιν",709941,148],["ὥσπερ",714163,28],["τὸ",709436,24],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["νεφῶν",709281,44]],"But the light is not visible to all: it shines afar off in the heavens, as that which is from him in the clouds."],["22",[["ἀπὸ",701425,0],["βορρᾶ",702765,18],["νέφη",709281,64],["χρυσαυγοῦντα",713970,242],["ἐπὶ",705080,0],["τούτοις",709858,151],["μεγάλη",708653,29],["ἡ",709436,10],["δόξα",703791,12],["καὶ",707031,7],["τιμὴ",712856,12],["παντοκράτορος",709986,18]],"From the north [come] the clouds shining like gold: in these great are the glory and honour of the Almighty;"],["23",[["καὶ",707031,7],["οὐχ",709805,28],["εὑρίσκομεν",705676,243],["ἄλλον",700697,85],["ὅμοιον",709626,27],["τῇ",709436,100],["ἰσχύι",706858,1],["αὐτοῦ",702165,102],["ὁ",709436,3],["τὰ",709436,41],["δίκαια",703694,68],["κρίνων",707905,72],["οὐκ",709805,28],["οἴει",709534,91],["ἐπακούειν",705009,55],["αὐτόν",702165,85]],"and we do not find another his equal in strength: [as for] him that judges justly, dost thou not think that he listens?"],["24",[["διὸ",703714,7],["φοβηθήσονται",713532,144],["αὐτὸν",702165,85],["οἱ",709436,136],["ἄνθρωποι",701163,52],["φοβηθήσονται",713532,144],["δὲ",703303,11],["αὐτὸν",702165,85],["καὶ",707031,7],["οἱ",709436,136],["σοφοὶ",711985,138],["καρδίᾳ",707141,1]],"Wherefore men shall fear him; and the wise also in heart shall fear him."]]