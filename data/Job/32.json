[["1",[["ἡσύχασαν",706033,150],["δὲ",703303,11],["καὶ",707031,7],["οἱ",709436,136],["τρεῖς",712927,138],["φίλοι",713492,138],["αὐτοῦ",702165,102],["ἔτι",705538,28],["ἀντειπεῖν",701223,106],["Ιωβ",706903,4],["ἦν",704093,13],["γὰρ",702963,11],["Ιωβ",706903,4],["δίκαιος",703694,14],["ἐναντίον",704654,0],["αὐτῶν",702165,40]],"And his three friends also ceased any longer to answer Job: for Job was righteous before them."],["2",[["ὠργίσθη",709729,37],["δὲ",703303,11],["Ελιους",704478,4],["ὁ",709436,3],["τοῦ",709436,35],["Βαραχιηλ",702527,18],["ὁ",709436,3],["Βουζίτης",702782,4],["ἐκ",704132,0],["τῆς",709436,16],["συγγενείας",712184,17],["Ραμ",711162,17],["τῆς",709436,16],["Αυσίτιδος",702151,17],["χώρας",714011,17],["ὠργίσθη",709729,37],["δὲ",703303,11],["τῷ",709436,113],["Ιωβ",706903,114],["σφόδρα",712586,28],["διότι",703734,7],["ἀπέφηνεν",701631,2],["ἑαυτὸν",703917,85],["δίκαιον",703694,27],["ἐναντίον",704654,0],["κυρίου",707996,18]],"Then Elius the son of Barachiel, the Buzite, of the kindred of Ram, of the country of Ausis, was angered: and he was very angry with Job, because he justified himself before the Lord."],["3",[["καὶ",707031,7],["κατὰ",707200,0],["τῶν",709436,80],["τριῶν",712927,169],["δὲ",703303,11],["φίλων",713492,169],["ὠργίσθη",709729,37],["σφόδρα",712586,28],["διότι",703734,7],["οὐκ",709805,28],["ἠδυνήθησαν",703838,99],["ἀποκριθῆναι",701492,179],["ἀντίθετα",701236,68],["Ιωβ",706903,6],["καὶ",707031,7],["ἔθεντο",712849,189],["αὐτὸν",702165,85],["εἶναι",704093,55],["ἀσεβῆ",701909,68]],"And he was also very angry with [his] three friends, because they were not able to return answers to Job, yet set him down for an ungodly man."],["4",[["Ελιους",704478,4],["δὲ",703303,11],["ὑπέμεινεν",713219,2],["δοῦναι",703654,106],["ἀπόκρισιν",701493,9],["Ιωβ",706903,6],["ὅτι",709803,7],["πρεσβύτεροι",710735,52],["αὐτοῦ",702165,102],["εἰσιν",704093,197],["ἡμέραις",705984,76]],"But Elius had forborne to give an answer to Job, because they were older than he."],["5",[["καὶ",707031,7],["εἶδεν",709725,2],["Ελιους",704478,4],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀπόκρισις",701493,12],["ἐν",704639,0],["στόματι",712125,54],["τῶν",709436,80],["τριῶν",712927,169],["ἀνδρῶν",701150,81],["καὶ",707031,7],["ἐθυμώθη",706335,37],["ὀργὴ",709728,12],["αὐτοῦ",702165,102]],"And Elius saw that there was no answer in the mouth of the three men; and he was angered in his wrath."],["6",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Ελιους",704478,4],["ὁ",709436,3],["τοῦ",709436,35],["Βαραχιηλ",702527,18],["ὁ",709436,3],["Βουζίτης",702782,4],["εἶπεν",705373,2],["νεώτερος",709256,224],["μέν",708730,11],["εἰμι",704093,157],["τῷ",709436,113],["χρόνῳ",713969,114],["ὑμεῖς",713081,219],["δέ",703303,11],["ἐστε",704093,87],["πρεσβύτεροι",710735,52],["διὸ",703714,7],["ἡσύχασα",706033,155],["φοβηθεὶς",713532,217],["τοῦ",709436,20],["ὑμῖν",713084,90],["ἀναγγεῖλαι",700921,106],["τὴν",709436,8],["ἐμαυτοῦ",704545,102],["ἐπιστήμην",705267,9]],"And Elius the Buzite the son of Barachiel answered and said, I am younger in age, and ye are elder; wherefore I kept silence, fearing to declare to you my own knowledge."],["7",[["εἶπα",705373,155],["δὲ",703303,11],["ὅτι",709803,7],["ὁ",709436,3],["χρόνος",713969,4],["ἐστὶν",704093,91],["ὁ",709436,3],["λαλῶν",708071,72],["ἐν",704639,0],["πολλοῖς",710646,230],["δὲ",703303,11],["ἔτεσιν",705543,96],["οἴδασιν",709492,353],["σοφίαν",711981,9]],"And I said, It is not time that speaks, though in many years [men] know wisdom:"],["8",[["ἀλλὰ",700680,7],["πνεῦμά",710566,15],["ἐστιν",704093,91],["ἐν",704639,0],["βροτοῖς",702817,148],["πνοὴ",710574,12],["δὲ",703303,11],["παντοκράτορός",709986,18],["ἐστιν",704093,91],["ἡ",709436,10],["διδάσκουσα",703649,188]],"but there is a spirit in mortals; and the inspiration of the Almighty is that which teaches."],["9",[["οὐχ",709805,28],["οἱ",709436,136],["πολυχρόνιοί",710652,138],["εἰσιν",704093,197],["σοφοί",711985,138],["οὐδ᾿",709816,7],["οἱ",709436,136],["γέροντες",703065,52],["οἴδασιν",709492,353],["κρίμα",707903,25]],"The long-lived are not wise [as such]; neither do the aged know judgment."],["10",[["διὸ",703714,7],["εἶπα",705373,155],["ἀκούσατέ",700587,74],["μου",709032,133],["καὶ",707031,7],["ἀναγγελῶ",700921,165],["ὑμῖν",713084,90],["ἃ",709781,69],["οἶδα",709492,89]],"Wherefore I said, Hear me, and I will tell you what I know."],["11",[["ἐνωτίζεσθέ",704825,73],["μου",709032,133],["τὰ",709436,41],["ῥήματα",711246,42],["ἐρῶ",705415,165],["γὰρ",702963,11],["ὑμῶν",713091,145],["ἀκουόντων",700587,170],["ἄχρι",702313,0],["οὗ",709781,48],["ἐτάσητε",705526,125],["λόγους",708236,57]],"Hearken to my words; for I will speak in your hearing, until ye shall have tried [the matter] with words:"],["12",[["καὶ",707031,7],["μέχρι",708849,0],["ὑμῶν",713091,145],["συνήσω",712481,165],["καὶ",707031,7],["ἰδοὺ",706497,88],["οὐκ",709805,28],["ἦν",704093,13],["τῷ",709436,113],["Ιωβ",706903,114],["ἐλέγχων",704416,72],["ἀνταποκρινόμενος",701219,122],["ῥήματα",711246,42],["αὐτοῦ",702165,102],["ἐξ",704132,0],["ὑμῶν",713091,145]],"and I shall understand as far as you; and, behold, there was no one of you that answered Job his words in argument,"],["13",[["ἵνα",706747,7],["μὴ",708851,28],["εἴπητε",705373,125],["εὕρομεν",705676,289],["σοφίαν",711981,9],["κυρίῳ",707996,114],["προσθέμενοι",710965,317]],"lest ye should say, We have found that we have added wisdom to the Lord."],["14",[["ἀνθρώπῳ",701163,114],["δὲ",703303,11],["ἐπετρέψατε",705311,265],["λαλῆσαι",708071,106],["τοιαῦτα",712878,68],["ῥήματα",711246,42]],"And ye have commissioned a man to speak such words."],["15",[["ἐπτοήθησαν",711062,99],["οὐκ",709805,28],["ἀπεκρίθησαν",701492,99],["ἔτι",705538,28],["ἐπαλαίωσαν",709937,150],["ἐξ",704132,0],["αὐτῶν",702165,40],["λόγους",708236,57]],"They were afraid, they answered no longer; they gave up their speaking."],["16",[["ὑπέμεινα",713219,155],["οὐ",709805,28],["γὰρ",702963,11],["ἐλάλησαν",708071,150],["ὅτι",709803,7],["ἔστησαν",706846,150],["οὐκ",709805,28],["ἀπεκρίθησαν",701492,99]],"I waited, (for I had not spoken,) because they stood still, they answered not."],["17",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Ελιους",704478,4],["λέγει",708124,91]],"And Elius continued, and said, I will again speak,"],["18",[["πάλιν",709942,28],["λαλήσω",708071,165],["πλήρης",710541,14],["γάρ",702963,11],["εἰμι",704093,157],["ῥημάτων",711246,44],["ὀλέκει",709565,91],["γάρ",702963,11],["με",708618,163],["τὸ",709436,34],["πνεῦμα",710566,15],["τῆς",709436,16],["γαστρός",702976,17]],"for I am full of words, for the spirit of my belly destroys me."],["19",[["ἡ",709436,10],["δὲ",703303,11],["γαστήρ",702976,12],["μου",709032,133],["ὥσπερ",714163,28],["ἀσκὸς",701968,4],["γλεύκους",703108,21],["ζέων",705869,72],["δεδεμένος",703394,419],["ἢ",705924,7],["ὥσπερ",714163,28],["φυσητὴρ",713632,4],["χαλκέως",713691,18],["ἐρρηγώς",711243,270]],"And my belly is as a skin of sweet wine bound up [and] ready to burst; or as a brazier's labouring bellows."],["20",[["λαλήσω",708071,165],["ἵνα",706747,7],["ἀναπαύσωμαι",701027,410],["ἀνοίξας",701186,182],["τὰ",709436,41],["χείλη",713781,42]],"I will speak, that I may open my lips and relieve myself."],["21",[["ἄνθρωπον",701163,6],["γὰρ",702963,11],["οὐ",709805,28],["μὴ",708851,28],["αἰσχυνθῶ",700485,321],["ἀλλὰ",700680,7],["μὴν",708873,11],["οὐδὲ",709816,7],["βροτὸν",702817,6],["οὐ",709805,28],["μὴ",708851,28],["ἐντραπῶ",704805,207]],"For truly I will not be awed because of man, nor indeed will I be confounded before a mortal."],["22",[["οὐ",709805,28],["γὰρ",702963,11],["ἐπίσταμαι",705264,254],["θαυμάσαι",706135,106],["πρόσωπον",710986,25],["εἰ",704071,7],["δὲ",703303,11],["μή",708851,28],["καὶ",707031,7],["ἐμὲ",704555,163],["σῆτες",711756,52],["ἔδονται",705495,135]],"For I know not how to respect persons: and if otherwise, even the moths would eat me."]]