[["1",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Ελιους",704478,4],["λέγει",708124,91]],"And Elius continued, and said,"],["2",[["ἀκούσατέ",700587,74],["μου",709032,133],["σοφοί",711985,138],["ἐπιστάμενοι",705756,348],["ἐνωτίζεσθε",704825,73],["τὸ",709436,24],["καλόν",707097,27]],"Hear me, ye wise men; hearken, ye that have knowledge."],["3",[["ὅτι",709803,7],["οὖς",709852,15],["λόγους",708236,57],["δοκιμάζει",703776,91],["καὶ",707031,7],["λάρυγξ",708098,4],["γεύεται",703074,117],["βρῶσιν",702825,9]],"For the ear tries words, and the mouth tastes meat."],["4",[["κρίσιν",707908,9],["ἑλώμεθα",700472,276],["ἑαυτοῖς",703917,151],["γνῶμεν",703105,79],["ἀνὰ",700902,0],["μέσον",708768,27],["ἑαυτῶν",703917,40],["ὅ",709781,128],["τι",712866,126],["καλόν",707097,46]],"Let us choose judgment to ourselves: let us know among ourselves what is right."],["5",[["ὅτι",709803,7],["εἴρηκεν",705415,171],["Ιωβ",706903,4],["δίκαιός",703694,14],["εἰμι",704093,157],["ὁ",709436,3],["κύριος",707996,4],["ἀπήλλαξέν",701333,2],["μου",709032,133],["τὸ",709436,24],["κρίμα",707903,25]],"For Job has said, I am righteous: the Lord has removed my judgment."],["6",[["ἐψεύσατο",714045,23],["δὲ",703303,11],["τῷ",709436,53],["κρίματί",707903,54],["μου",709032,133],["βίαιον",702714,46],["τὸ",709436,24],["βέλος",702644,25],["μου",709032,133],["ἄνευ",701137,0],["ἀδικίας",700271,17]],"And he has erred in my judgment: my wound is severe without unrighteousness [of mine]."],["7",[["τίς",712867,158],["ἀνὴρ",701150,4],["ὥσπερ",714163,28],["Ιωβ",706903,4],["πίνων",710478,72],["μυκτηρισμὸν",709053,6],["ὥσπερ",714163,28],["ὕδωρ",713071,15]],"What man is as Job, drinking scorning like water?"],["8",[["οὐχ",709805,28],["ἁμαρτὼν",700773,182],["οὐδὲ",709816,7],["ἀσεβήσας",701906,182],["ἢ",705924,7],["ὁδοῦ",709458,17],["κοινωνήσας",707775,182],["μετὰ",708780,0],["ποιούντων",710582,170],["τὰ",709436,41],["ἄνομα",701194,68],["τοῦ",709436,20],["πορευθῆναι",710667,179],["μετὰ",708780,0],["ἀσεβῶν",701909,169]],"[saying], I have not sinned, nor committed ungodliness, nor had fellowship with workers of iniquity, to go with the ungodly."],["9",[["μὴ",708851,28],["γὰρ",702963,11],["εἴπῃς",705373,175],["ὅτι",709803,7],["οὐκ",709805,28],["ἔσται",704093,93],["ἐπισκοπὴ",705255,12],["ἀνδρός",701150,18],["καὶ",707031,7],["ἐπισκοπὴ",705255,12],["αὐτῷ",702165,50],["παρὰ",709995,0],["κυρίου",707996,18]],"For thou shouldest not say, There shall be no visitation of a man, whereas [there is] a visitation on him from the Lord."],["10",[["διό",703714,7],["συνετοὶ",712464,538],["καρδίας",707141,17],["ἀκούσατέ",700587,74],["μου",709032,133],["μή",708851,28],["μοι",708974,159],["εἴη",704093,301],["ἔναντι",704653,0],["κυρίου",707996,18],["ἀσεβῆσαι",701906,106],["καὶ",707031,7],["ἔναντι",704653,0],["παντοκράτορος",709986,18],["ταράξαι",712721,106],["τὸ",709436,24],["δίκαιον",703694,46]],"Wherefore hear me, ye that are wise in heart: far be it from me to sin before the Lord, and to pervert righteousness before the Almighty."],["11",[["ἀλλὰ",700680,7],["ἀποδιδοῖ",701449,301],["ἀνθρώπῳ",701163,114],["καθὰ",706979,28],["ποιεῖ",710582,91],["ἕκαστος",704133,14],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐν",704639,0],["τρίβῳ",712939,114],["ἀνδρὸς",701150,18],["εὑρήσει",705676,127],["αὐτόν",702165,85]],"Yea, he renders to a man accordingly as each of them does, and in a man's path he will find him."],["12",[["οἴῃ",709534,204],["δὲ",703303,11],["τὸν",709436,5],["κύριον",707996,6],["ἄτοπα",702102,68],["ποιήσειν",710582,296],["ἢ",705924,7],["ὁ",709436,3],["παντοκράτωρ",709986,4],["ταράξει",712721,127],["κρίσιν",707908,9]],"And thinkest thou that the Lord will do wrong, or will the Almighty who made the earth wrest judgment?"],["13",[["ὃς",709781,213],["ἐποίησεν",710582,2],["τὴν",709436,8],["γῆν",703083,9],["τίς",712867,158],["δέ",703303,11],["ἐστιν",704093,91],["ὁ",709436,3],["ποιῶν",710582,72],["τὴν",709436,8],["ὑπ᾿",713184,0],["οὐρανὸν",709844,6],["καὶ",707031,7],["τὰ",709436,41],["ἐνόντα",704707,237],["πάντα",710177,68]],"And who is he that made [the whole world] under heaven, and all things therein?"],["14",[["εἰ",704071,7],["γὰρ",702963,11],["βούλοιτο",702795,700],["συνέχειν",712469,55],["καὶ",707031,7],["τὸ",709436,24],["πνεῦμα",710566,25],["παρ᾿",709995,0],["αὐτῷ",702165,50],["κατασχεῖν",707526,106]],"For if he would confine, and restrain his spirit with himself;"],["15",[["τελευτήσει",712781,127],["πᾶσα",710177,29],["σὰρξ",711537,12],["ὁμοθυμαδόν",709624,28],["πᾶς",710177,14],["δὲ",703303,11],["βροτὸς",702817,4],["εἰς",704105,0],["γῆν",703083,9],["ἀπελεύσεται",701398,93],["ὅθεν",709486,28],["καὶ",707031,7],["ἐπλάσθη",710503,37]],"all flesh would die together, and every mortal would return to the earth, whence also he was formed."],["16",[["εἰ",704071,7],["δὲ",703303,11],["μὴ",708851,28],["νουθετῇ",709367,204],["ἄκουε",700587,240],["ταῦτα",709858,71],["ἐνωτίζου",704825,253],["φωνὴν",713640,9],["ῥημάτων",711246,44]],"Take heed lest he rebuke [thee]: hear this, hearken to the voice of words."],["17",[["ἰδὲ",709725,176],["σὺ",712181,164],["τὸν",709436,5],["μισοῦντα",708935,183],["ἄνομα",701194,68],["καὶ",707031,7],["τὸν",709436,5],["ὀλλύντα",709584,183],["τοὺς",709436,58],["πονηροὺς",710660,60],["ὄντα",704093,183],["αἰώνιον",700505,27],["δίκαιον",703694,27]],"Behold then the one that hates iniquities, and that destroys the wicked, who is for ever just."],["18",[["ἀσεβὴς",701909,14],["ὁ",709436,3],["λέγων",708124,72],["βασιλεῖ",702580,114],["παρανομεῖς",710078,154],["ἀσεβέστατε",701909,710],["τοῖς",709436,147],["ἄρχουσιν",701862,148]],"[He is] ungodly that says to a king, Thou art a transgressor, [that says] to princes, O most ungodly one."],["19",[["ὃς",709781,213],["οὐκ",709805,28],["ἐπῃσχύνθη",705003,37],["πρόσωπον",710986,25],["ἐντίμου",704798,116],["οὐδὲ",709816,7],["οἶδεν",709492,171],["τιμὴν",712856,9],["θέσθαι",712849,109],["ἁδροῖς",700292,230],["θαυμασθῆναι",706135,179],["πρόσωπα",710986,42],["αὐτῶν",702165,40]],"[Such a one] as would not reverence the face of an honourable man, neither knows how to give honour to the great, so as that their persons should be respected."],["20",[["κενὰ",707612,68],["δὲ",703303,11],["αὐτοῖς",702165,151],["ἀποβήσεται",701426,93],["τὸ",709436,24],["κεκραγέναι",707868,115],["καὶ",707031,7],["δεῖσθαι",703394,110],["ἀνδρός",701150,18],["ἐχρήσαντο",713937,189],["γὰρ",702963,11],["παρανόμως",710081,28],["ἐκκλινομένων",704220,299],["ἀδυνάτων",700297,169]],"But it shall turn out vanity to them, to cry and beseech a man; for they dealt unlawfully, the poor being turned aside [from their right]."],["21",[["αὐτὸς",702165,121],["γὰρ",702963,11],["ὁρατής",709722,4],["ἐστιν",704093,91],["ἔργων",705396,44],["ἀνθρώπων",701163,81],["λέληθεν",708088,171],["δὲ",703303,11],["αὐτὸν",702165,85],["οὐδὲν",709817,46],["ὧν",709781,252],["πράσσουσιν",710721,197]],"For he surveys the works of men, and nothing of what they do has escaped him."],["22",[["οὐδὲ",709816,7],["ἔσται",704093,93],["τόπος",712903,4],["τοῦ",709436,20],["κρυβῆναι",707923,179],["τοὺς",709436,58],["ποιοῦντας",710582,235],["τὰ",709436,41],["ἄνομα",701194,68]],"Neither shall there be a place for the workers of iniquity to hide themselves."],["23",[["ὅτι",709803,7],["οὐκ",709805,28],["ἐπ᾿",705080,0],["ἄνδρα",701150,6],["θήσει",712849,127],["ἔτι",705538,28],["ὁ",709436,3],["γὰρ",702963,11],["κύριος",707996,4],["πάντας",710177,60],["ἐφορᾷ",705057,91]],"For he will not lay upon a man more [than right].",{"s":"d","q":0.5}],["24",[["ὁ",709436,3],["καταλαμβάνων",707300,72],["ἀνεξιχνίαστα",701129,68],["ἔνδοξά",704694,68],["τε",712751,11],["καὶ",707031,7],["ἐξαίσια",704840,68],["ὧν",709781,252],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀριθμός",701744,4]],"For the Lord looks down upon all men, who comprehends unsearchable things, glorious also and excellent things without number."],["25",[["ὁ",709436,3],["γνωρίζων",703135,72],["αὐτῶν",702165,40],["τὰ",709436,41],["ἔργα",705396,42],["καὶ",707031,7],["στρέψει",712160,127],["νύκτα",709386,9],["καὶ",707031,7],["ταπεινωθήσονται",712717,144]],"Who discovers their works, and will bring night about [upon them], and they shall be brought low."],["26",[["ἔσβεσεν",711596,2],["δὲ",703303,11],["ἀσεβεῖς",701909,60],["ὁρατοὶ",709724,138],["δὲ",703303,11],["ἐναντίον",704654,0],["αὐτοῦ",702165,102]],"And he quite destroys the ungodly, for they are seen before him."],["27",[["ὅτι",709803,7],["ἐξέκλιναν",704220,150],["ἐκ",704132,0],["νόμου",709349,18],["θεοῦ",706192,18],["δικαιώματα",703697,42],["δὲ",703303,11],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐπέγνωσαν",705104,150]],"Because they turned aside from the law of God, and did not regard his ordinances,"],["28",[["τοῦ",709436,20],["ἐπαγαγεῖν",704994,106],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["κραυγὴν",707886,9],["πένητος",710248,18],["καὶ",707031,7],["κραυγὴν",707886,9],["πτωχῶν",711076,81],["εἰσακούσεται",704108,93]],"so as to bring before him the cry of the needy; for he will hear the cry of the poor."],["29",[["καὶ",707031,7],["αὐτὸς",702165,121],["ἡσυχίαν",706035,9],["παρέξει",710142,127],["καὶ",707031,7],["τίς",712867,158],["καταδικάσεται",707241,93],["καὶ",707031,7],["κρύψει",707923,127],["πρόσωπον",710986,25],["καὶ",707031,7],["τίς",712867,158],["ὄψεται",709725,93],["αὐτόν",702165,85],["καὶ",707031,7],["κατὰ",707200,0],["ἔθνους",704068,21],["καὶ",707031,7],["κατὰ",707200,0],["ἀνθρώπου",701163,18],["ὁμοῦ",709644,116]],"And he will give quiet, and who will condemn? and he will hide his face, and who shall see him? whether [it be done] against a nation, or against a man also:"],["30",[["βασιλεύων",702581,72],["ἄνθρωπον",701163,6],["ὑποκριτὴν",713209,6],["ἀπὸ",701425,0],["δυσκολίας",703859,17],["λαοῦ",708094,18]],"causing a hypocrite to be king, because of the waywardness of the people."],["31",[["ὅτι",709803,7],["πρὸς",710844,0],["τὸν",709436,5],["ἰσχυρὸν",706855,27],["ὁ",709436,3],["λέγων",708124,72],["εἴληφα",708076,89],["οὐκ",709805,28],["ἐνεχυράσω",704722,165]],"For [there is] one that says to the Mighty One, I have received [blessings]; I will not take a pledge:"],["32",[["ἄνευ",701137,0],["ἐμαυτοῦ",704545,102],["ὄψομαι",709725,181],["σὺ",712181,164],["δεῖξόν",703314,176],["μοι",708974,159],["εἰ",704071,7],["ἀδικίαν",700271,9],["ἠργασάμην",705383,161],["οὐ",709805,28],["μὴ",708851,28],["προσθήσω",710965,165]],"I will see apart from myself: do thou shew me if I have done unrighteousness; I will not do [so] any more."],["33",[["μὴ",708851,28],["παρὰ",709995,0],["σοῦ",711945,133],["ἀποτείσει",701618,127],["αὐτήν",702165,104],["ὅτι",709803,7],["ἀπώσῃ",701659,172],["ὅτι",709803,7],["σὺ",712181,164],["ἐκλέξῃ",704236,123],["καὶ",707031,7],["οὐκ",709805,28],["ἐγώ",704018,164],["καὶ",707031,7],["τί",712867,126],["ἔγνως",703105,162],["λάλησον",708071,176]],"Will he take vengeance for it on thee, whereas thou wilt put [it] far [from thee]? for thou shalt choose, and not I; and what thou knowest, speak thou."],["34",[["διὸ",703714,7],["συνετοὶ",712464,138],["καρδίας",707141,17],["ἐροῦσιν",705415,218],["ταῦτα",709858,71],["ἀνὴρ",701150,4],["δὲ",703303,11],["σοφὸς",711985,14],["ἀκήκοέν",700587,171],["μου",709032,133],["τὸ",709436,24],["ῥῆμα",711246,25]],"Because the wise in heart shall say this, and a wise man listens to my word."],["35",[["Ιωβ",706903,4],["δὲ",703303,11],["οὐκ",709805,28],["ἐν",704639,0],["συνέσει",712460,1],["ἐλάλησεν",708071,2],["τὰ",709436,41],["δὲ",703303,11],["ῥήματα",711246,42],["αὐτοῦ",702165,102],["οὐκ",709805,28],["ἐν",704639,0],["ἐπιστήμῃ",705267,1]],"But Job has not spoken with understanding, his words are not [uttered] with knowledge."],["36",[["οὐ",709805,28],["μὴν",708873,11],["δὲ",703303,11],["ἀλλὰ",700680,7],["μάθε",708480,176],["Ιωβ",706903,153],["μὴ",708851,28],["δῷς",703654,175],["ἔτι",705538,28],["ἀνταπόκρισιν",701220,9],["ὥσπερ",714163,28],["οἱ",709436,136],["ἄφρονες",702236,138]],"Howbeit do thou learn, Job: no longer make answer as the foolish:"],["37",[["ἵνα",706747,7],["μὴ",708851,28],["προσθῶμεν",710965,79],["ἐφ᾿",705080,0],["ἁμαρτίαις",700775,76],["ἡμῶν",705999,145],["ἀνομία",701192,12],["δὲ",703303,11],["ἐφ᾿",705080,0],["ἡμῖν",705994,90],["λογισθήσεται",708232,134],["πολλὰ",710646,68],["λαλούντων",708071,170],["ῥήματα",711246,42],["ἐναντίον",704654,0],["τοῦ",709436,35],["κυρίου",707996,18]],"that we add not to our sins: for iniquity will be reckoned against us, if [we] speak many words before the Lord."]]