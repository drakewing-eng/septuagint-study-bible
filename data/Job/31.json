[["1",[["διαθήκην",703456,9],["ἐθέμην",712849,161],["τοῖς",709436,147],["ὀφθαλμοῖς",709870,148],["μου",709032,133],["καὶ",707031,7],["οὐ",709805,28],["συνήσω",712481,165],["ἐπὶ",705080,0],["παρθένον",710148,9]],"I made a covenant with mine eyes, and I will not think upon a virgin."],["2",[["καὶ",707031,7],["τί",712867,126],["ἐμέρισεν",708744,2],["ὁ",709436,3],["θεὸς",706192,4],["ἀπάνωθεν",701349,28],["καὶ",707031,7],["κληρονομία",707725,12],["ἱκανοῦ",706710,116],["ἐξ",704132,0],["ὑψίστων",713287,169]],"Now what portion has God given from above? and is there an inheritance [given] of the Mighty One from the highest?"],["3",[["οὐχὶ",709862,28],["ἀπώλεια",701660,12],["τῷ",709436,113],["ἀδίκῳ",700272,30],["καὶ",707031,7],["ἀπαλλοτρίωσις",701335,12],["τοῖς",709436,147],["ποιοῦσιν",710582,349],["ἀνομίαν",701192,9]],"Alas! destruction to the unrighteous, and rejection to them that do iniquity."],["4",[["οὐχὶ",709862,28],["αὐτὸς",702165,121],["ὄψεται",709725,93],["ὁδόν",709458,9],["μου",709032,133],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["διαβήματά",703422,42],["μου",709032,133],["ἐξαριθμήσεται",704877,93]],"Will he not see my way, and number all my steps?"],["5",[["εἰ",704071,7],["δὲ",703303,11],["ἤμην",704093,334],["πεπορευμένος",710667,419],["μετὰ",708780,0],["γελοιαστῶν",703028,81],["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["ἐσπούδασεν",712031,2],["ὁ",709436,3],["πούς",710707,4],["μου",709032,133],["εἰς",704105,0],["δόλον",703787,6]],"But if I had gone with scorners, and if too my foot has hasted to deceit:"],["6",[["ἱσταίη",706846,301],["με",708618,163],["ἄρα",701666,11],["ἐν",704639,0],["ζυγῷ",705894,114],["δικαίῳ",703694,30],["οἶδεν",709492,171],["δὲ",703303,11],["ὁ",709436,3],["κύριος",707996,4],["τὴν",709436,8],["ἀκακίαν",700511,9],["μου",709032,133]],"(for I am weighed in a just balance, and the Lord knows my innocence:)"],["7",[["εἰ",704071,7],["ἐξέκλινεν",704220,13],["ὁ",709436,3],["πούς",710707,4],["μου",709032,133],["ἐκ",704132,0],["τῆς",709436,16],["ὁδοῦ",709458,17],["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["τῷ",709436,113],["ὀφθαλμῷ",709870,114],["ἐπηκολούθησεν",705007,2],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["ταῖς",709436,75],["χερσίν",713787,76],["μου",709032,133],["ἡψάμην",701654,161],["δώρων",703907,44]],"if my foot has turned aside out of the way, or if mine heart has followed mine eye, and if too I have touched gifts with my hands;"],["8",[["σπείραιμι",712006,346],["ἄρα",701666,11],["καὶ",707031,7],["ἄλλοι",700697,201],["φάγοισαν",705495,396],["ἄρριζος",701810,14],["δὲ",703303,11],["γενοίμην",703104,755],["ἐπὶ",705080,0],["γῆς",703083,17]],"then let me sow, and let others eat; and let me be uprooted on the earth."],["9",[["εἰ",704071,7],["ἐξηκολούθησεν",704845,2],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["γυναικὶ",703209,1],["ἀνδρὸς",701150,18],["ἑτέρου",705535,116],["εἰ",704071,7],["καὶ",707031,7],["ἐγκάθετος",703951,14],["ἐγενόμην",703104,161],["ἐπὶ",705080,0],["θύραις",706337,76],["αὐτῆς",702165,86]],"If my heart has gone forth after another man's wife, and if I laid wait at her doors;"],["10",[["ἀρέσαι",701722,225],["ἄρα",701666,11],["καὶ",707031,7],["ἡ",709436,10],["γυνή",703209,12],["μου",709032,133],["ἑτέρῳ",705535,30],["τὰ",709436,63],["δὲ",703303,11],["νήπιά",709295,195],["μου",709032,133],["ταπεινωθείη",712717,528]],"then let my wife also please another, and let my children be brought low."],["11",[["θυμὸς",706334,4],["γὰρ",702963,11],["ὀργῆς",709728,17],["ἀκατάσχετος",700533,14],["τὸ",709436,24],["μιᾶναι",708900,106],["ἀνδρὸς",701150,18],["γυναῖκα",703209,9]],"For the rage of anger is not to be controlled, [in the case] of defiling [another] man's wife."],["12",[["πῦρ",711088,15],["γάρ",702963,11],["ἐστιν",704093,91],["καιόμενον",707049,208],["ἐπὶ",705080,0],["πάντων",710177,83],["τῶν",709436,43],["μερῶν",708752,44],["οὗ",709781,48],["δ᾿",703303,11],["ἂν",700900,11],["ἐπέλθῃ",705068,172],["ἐκ",704132,0],["ῥιζῶν",711260,65],["ἀπώλεσεν",701513,2]],"For it is a fire burning on every side, and whomsoever it attacks, it utterly destroys."],["13",[["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["ἐφαύλισα",713394,155],["κρίμα",707903,25],["θεράποντός",706201,18],["μου",709032,133],["ἢ",705924,7],["θεραπαίνης",706197,17],["κρινομένων",707905,299],["αὐτῶν",702165,40],["πρός",710844,0],["με",708618,163]],"And if too I despised the judgment of my servant or [my] handmaid, when they pleaded with me;"],["14",[["τί",712867,126],["γὰρ",702963,11],["ποιήσω",710582,207],["ἐὰν",703912,7],["ἔτασίν",705530,9],["μου",709032,133],["ποιήσηται",710582,239],["ὁ",709436,3],["κύριος",707996,4],["ἐὰν",703912,7],["δὲ",703303,11],["καὶ",707031,7],["ἐπισκοπήν",705255,9],["τίνα",712867,356],["ἀπόκρισιν",701493,9],["ποιήσομαι",710582,181]],"what then shall I do if the Lord should try me? and if also he should at all visit me, can I make an answer?"],["15",[["πότερον",710697,28],["οὐχ",709805,28],["ὡς",714148,7],["καὶ",707031,28],["ἐγὼ",704018,164],["ἐγενόμην",703104,161],["ἐν",704639,0],["γαστρί",702976,1],["καὶ",707031,7],["ἐκεῖνοι",704183,201],["γεγόνασιν",703104,353],["γεγόναμεν",703104,314],["δὲ",703303,11],["ἐν",704639,0],["τῇ",709436,100],["αὐτῇ",702165,105],["κοιλίᾳ",707761,1]],"Were not they too formed as I also was formed in the womb? yea, we were formed in the same womb."],["16",[["ἀδύνατοι",700297,138],["δὲ",703303,11],["χρείαν",713938,9],["ἥν",709781,131],["ποτ᾿",710695,28],["εἶχον",705785,137],["οὐκ",709805,28],["ἀπέτυχον",701627,150],["χήρας",713848,39],["δὲ",703303,11],["τὸν",709436,5],["ὀφθαλμὸν",709870,6],["οὐκ",709805,28],["ἐξέτηξα",704329,155]],"But the helpless missed not whatever need they had, and I did not cause the eye of the widow to fail."],["17",[["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["τὸν",709436,5],["ψωμόν",714078,6],["μου",709032,133],["ἔφαγον",713296,155],["μόνος",709003,14],["καὶ",707031,7],["οὐχὶ",709862,28],["ὀρφανῷ",709779,30],["μετέδωκα",708791,155]],"And if too I ate my morsel alone, and did not impart [of it] to the orphan;"],["18",[["ὅτι",709803,7],["ἐκ",704132,0],["νεότητός",709258,17],["μου",709032,133],["ἐξέτρεφον",704342,333],["ὡς",714148,7],["πατὴρ",710189,4],["καὶ",707031,7],["ἐκ",704132,0],["γαστρὸς",702976,17],["μητρός",708892,17],["μου",709032,133],["ὡδήγησα",709448,155]],"(for I nourished [them] as a father from my youth, and guided [them] from my mother's womb.)"],["19",[["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["ὑπερεῖδον",713154,155],["γυμνὸν",703202,27],["ἀπολλύμενον",701513,212],["καὶ",707031,7],["οὐκ",709805,28],["ἠμφίασα",700881,155]],"And if too I overlooked the naked as he was perishing, and did not clothe him;"],["20",[["ἀδύνατοι",700297,138],["δὲ",703303,11],["εἰ",704071,7],["μὴ",708851,28],["εὐλόγησάν",705631,150],["με",708618,163],["ἀπὸ",701425,0],["δὲ",703303,11],["κουρᾶς",707859,17],["ἀμνῶν",700855,81],["μου",709032,133],["ἐθερμάνθησαν",706213,99],["οἱ",709436,136],["ὦμοι",714114,52],["αὐτῶν",702165,40]],"and if the poor did not bless me, and their shoulders were [not] warmed with the fleece of my lambs;"],["21",[["εἰ",704071,7],["ἐπῆρα",705002,155],["ὀρφανῷ",709779,30],["χεῖρα",713787,9],["πεποιθὼς",710221,270],["ὅτι",709803,7],["πολλή",710646,29],["μοι",708974,159],["βοήθεια",702745,12],["περίεστιν",710310,91]],"if I lifted my hand against an orphan, trusting that my strength was far superior [to his]:"],["22",[["ἀποσταίη",702214,225],["ἄρα",701666,11],["ὁ",709436,3],["ὦμός",714114,4],["μου",709032,133],["ἀπὸ",701425,0],["τῆς",709436,16],["κλειδός",707709,17],["ὁ",709436,3],["δὲ",703303,11],["βραχίων",702808,4],["μου",709032,133],["ἀπὸ",701425,0],["τοῦ",709436,35],["ἀγκῶνός",700166,18],["μου",709032,133],["συντριβείη",712520,528]],"let then my shoulder start from the blade-bone, and my arm be crushed off from the elbow."],["23",[["φόβος",713534,4],["γὰρ",702963,11],["κυρίου",707996,18],["συνέσχεν",712469,2],["με",708618,163],["καὶ",707031,7],["ἀπὸ",701425,0],["τοῦ",709436,20],["λήμματος",708175,21],["αὐτοῦ",702165,102],["οὐχ",709805,28],["ὑποίσω",713256,165]],"For the fear of the Lord constrained me, and I cannot bear up by reason of his burden."],["24",[["εἰ",704071,7],["ἔταξα",712730,155],["χρυσίον",713972,25],["ἰσχύν",706858,9],["μου",709032,133],["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,28],["λίθῳ",708196,114],["πολυτελεῖ",710647,30],["ἐπεποίθησα",710221,499]],"If I made gold my treasure, and if too I trusted the precious stone;"],["25",[["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,28],["εὐφράνθην",705715,156],["πολλοῦ",710646,116],["πλούτου",710563,18],["μοι",708974,159],["γενομένου",703104,292],["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,28],["ἐπ᾿",705080,0],["ἀναριθμήτοις",701047,230],["ἐθέμην",712849,161],["χεῖρά",713787,9],["μου",709032,133]],"and if too I rejoiced when my wealth was abundant, and if too I laid my hand on innumerable [treasures]:"],["26",[["ἦ",705925,28],["οὐχ",709805,28],["ὁρῶ",709725,157],["μὲν",708730,11],["ἥλιον",705974,6],["τὸν",709436,5],["ἐπιφαύσκοντα",705321,183],["ἐκλείποντα",704237,183],["σελήνην",711650,9],["δὲ",703303,11],["φθίνουσαν",713446,78],["οὐ",709805,28],["γὰρ",702963,11],["ἐπ᾿",705080,0],["αὐτοῖς",702165,151],["ἐστιν",704093,91]],"(do we not see the shining sun eclipsed, and the moon waning? for they have not [power to continue]:)"],["27",[["καὶ",707031,7],["εἰ",704071,7],["ἠπατήθη",701364,37],["λάθρᾳ",708057,28],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["χεῖρά",713787,9],["μου",709032,133],["ἐπιθεὶς",705304,182],["ἐπὶ",705080,0],["στόματί",712125,54],["μου",709032,133],["ἐφίλησα",713471,155]],"and if my heart was secretly deceived, and if I have laid my hand upon my mouth and kissed it:"],["28",[["καὶ",707031,7],["τοῦτό",709858,129],["μοι",708974,159],["ἄρα",701666,11],["ἀνομία",701192,12],["ἡ",709436,10],["μεγίστη",708653,417],["λογισθείη",708232,528],["ὅτι",709803,7],["ἐψευσάμην",714045,161],["ἐναντίον",704654,0],["κυρίου",707996,18],["τοῦ",709436,35],["ὑψίστου",713287,116]],"let this also then be reckoned to me as the greatest iniquity: for I [should] have lied against the Lord Most High."],["29",[["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["ἐπιχαρὴς",705331,14],["ἐγενόμην",703104,161],["πτώματι",711071,54],["ἐχθρῶν",705779,81],["μου",709032,133],["καὶ",707031,7],["εἶπεν",705373,2],["ἡ",709436,10],["καρδία",707141,12],["μου",709032,133],["εὖγε",705557,88]],"And if too I was glad at the fall of mine enemies, and mine heart said, Aha!"],["30",[["ἀκούσαι",700587,315],["ἄρα",701666,11],["τὸ",709436,24],["οὖς",709852,25],["μου",709032,133],["τὴν",709436,8],["κατάραν",707395,9],["μου",709032,133],["θρυληθείην",706317,727],["δὲ",703303,11],["ἄρα",701666,11],["ὑπὸ",713184,0],["λαοῦ",708094,18],["μου",709032,133],["κακούμενος",707073,122]],"let then mine ear hear my curse, and let me be a by-word among my people in my affliction."],["31",[["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["πολλάκις",710617,28],["εἶπον",705373,150],["αἱ",709436,190],["θεράπαιναί",706197,191],["μου",709032,133],["τίς",712867,158],["ἂν",700900,11],["δῴη",703654,225],["ἡμῖν",705994,90],["τῶν",709436,130],["σαρκῶν",711537,65],["αὐτοῦ",702165,102],["πλησθῆναι",710532,179],["λίαν",708184,28],["μου",709032,133],["χρηστοῦ",713958,116],["ὄντος",704093,152]],"And if too my handmaids have often said, Oh that we might be satisfied with his flesh; (whereas I was very kind:"],["32",[["ἔξω",704983,28],["δὲ",703303,11],["οὐκ",709805,28],["ηὐλίζετο",702138,19],["ξένος",709415,14],["ἡ",709436,10],["δὲ",703303,11],["θύρα",706337,12],["μου",709032,133],["παντὶ",710177,30],["ἐλθόντι",705453,350],["ἀνέῳκτο",701186,322]],"for the stranger did not lodge without, and my door was opened to every one that came:)"],["33",[["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["ἁμαρτὼν",700773,182],["ἀκουσίως",700583,28],["ἔκρυψα",707923,155],["τὴν",709436,8],["ἁμαρτίαν",700775,9],["μου",709032,133]],"or if too having sinned unintentionally, I hid my sin;"],["34",[["οὐ",709805,28],["γὰρ",702963,11],["διετράπην",703612,156],["πολυοχλίαν",710634,9],["πλήθους",710529,21],["τοῦ",709436,20],["μὴ",708851,28],["ἐξαγορεῦσαι",704831,106],["ἐνώπιον",704823,0],["αὐτῶν",702165,40],["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["εἴασα",703918,155],["ἀδύνατον",700297,27],["ἐξελθεῖν",704909,106],["θύραν",706337,9],["μου",709032,133],["κόλπῳ",707800,114],["κενῷ",707612,30]],"(for I did not stand in awe of a great multitude, so as not to declare boldly before them:) and if too I permitted a poor man to go out of my door with an empty bosom:"],["35",[["τίς",712867,158],["δῴη",703654,225],["ἀκούοντά",700587,183],["μου",709032,133],["χεῖρα",713787,9],["δὲ",703303,11],["κυρίου",707996,18],["εἰ",704071,7],["μὴ",708851,28],["ἐδεδοίκειν",703313,499],["συγγραφὴν",712192,9],["δέ",703303,11],["ἣν",709781,131],["εἶχον",705785,137],["κατά",707200,0],["τινος",712866,340]],"(Oh that I had a hearer,) and if I had not feared the hand of the Lord; and [as to] the written charge which I had against any one,"],["36",[["ἐπ᾿",705080,0],["ὤμοις",714114,148],["ἂν",700900,11],["περιθέμενος",710403,248],["στέφανον",712083,6],["ἀνεγίνωσκον",700922,333]],"I would place [it] as a chaplet on my shoulders, and read it."],["37",[["καὶ",707031,7],["εἰ",704071,7],["μὴ",708851,28],["ῥήξας",711243,182],["αὐτὴν",702165,104],["ἀπέδωκα",701449,155],["οὐθὲν",709817,46],["λαβὼν",708076,182],["παρὰ",709995,0],["χρεοφειλέτου",713945,18]],"And if I did not read it and return it, having taken nothing from the debtor:"],["38",[["εἰ",704071,7],["ἐπ᾿",705080,0],["ἐμοί",704577,159],["ποτε",710695,28],["ἡ",709436,10],["γῆ",703083,12],["ἐστέναξεν",712066,2],["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["οἱ",709436,136],["αὔλακες",702134,52],["αὐτῆς",702165,86],["ἔκλαυσαν",707703,150],["ὁμοθυμαδόν",709624,28]],"If at any time the land groaned against me, and if its furrows mourned together;"],["39",[["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["τὴν",709436,8],["ἰσχὺν",706858,9],["αὐτῆς",702165,86],["ἔφαγον",713296,155],["μόνος",709003,14],["ἄνευ",701137,0],["τιμῆς",712856,17],["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["ψυχὴν",714070,9],["κυρίου",707996,18],["τῆς",709436,16],["γῆς",703083,17],["ἐκβαλὼν",704145,182],["ἐλύπησα",708272,155]],"and if I ate its strength alone without price, and if too I grieved the heart of the owner of the soil, by taking [aught] from [him]:"],["40",[["ἀντὶ",701227,0],["πυροῦ",711101,18],["ἄρα",701666,11],["ἐξέλθοι",704909,225],["μοι",708974,159],["κνίδη",707753,12],["ἀντὶ",701227,0],["δὲ",703303,11],["κριθῆς",707900,17],["βάτος",702598,12],["καὶ",707031,7],["ἐπαύσατο",710202,23],["Ιωβ",706903,4],["ῥήμασιν",711246,96]],"then let the nettle come up to me instead of wheat, and a bramble instead of barley. And Job ceased speaking."]]