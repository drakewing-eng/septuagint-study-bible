[["1",[["εἰ",704071,7],["ἔγνως",703105,162],["καιρὸν",707047,6],["τοκετοῦ",712881,18],["τραγελάφων",712916,81],["πέτρας",710443,39],["ἐφύλαξας",713619,162],["δὲ",703303,11],["ὠδῖνας",714094,39],["ἐλάφων",704398,81]],"[Say] if thou knowest the time of the bringing forth of the wild goats of the rock, and [if] thou hast marked the calving of the hinds:"],["2",[["ἠρίθμησας",701742,162],["δὲ",703303,11],["αὐτῶν",702165,40],["μῆνας",708874,57],["πλήρεις",710541,60],["τοκετοῦ",712881,18],["ὠδῖνας",714094,39],["δὲ",703303,11],["αὐτῶν",702165,40],["ἔλυσας",708288,162]],"and [if] thou hast numbered the full months of their being with young, and [if] thou hast relieved their pangs:"],["3",[["ἐξέθρεψας",704342,162],["δὲ",703303,11],["αὐτῶν",702165,40],["τὰ",709436,41],["παιδία",709927,42],["ἔξω",704983,0],["φόβου",713534,18],["ὠδῖνας",714094,39],["αὐτῶν",702165,40],["ἐξαποστελεῖς",704872,166]],"and hast reared their young without fear; and wilt thou loosen their pangs?"],["4",[["ἀπορρήξουσιν",701561,218],["τὰ",709436,63],["τέκνα",712761,64],["αὐτῶν",702165,40],["πληθυνθήσονται",710530,144],["ἐν",704639,0],["γενήματι",703052,54],["ἐξελεύσονται",704909,135],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἀνακάμψουσιν",700969,218],["αὐτοῖς",702165,151]],"Their young will break forth; they will be multiplied with offspring: [their young] will go forth, and will not return to them."],["5",[["τίς",712867,158],["δέ",703303,11],["ἐστιν",704093,91],["ὁ",709436,3],["ἀφεὶς",702211,182],["ὄνον",709671,6],["ἄγριον",700191,27],["ἐλεύθερον",704428,27],["δεσμοὺς",703372,57],["δὲ",703303,11],["αὐτοῦ",702165,102],["τίς",712867,158],["ἔλυσεν",708288,2]],"And who is he that sent forth the wild ass free? and who loosed his bands?"],["6",[["ἐθέμην",712849,161],["δὲ",703303,11],["τὴν",709436,8],["δίαιταν",703460,9],["αὐτοῦ",702165,102],["ἔρημον",705420,9],["καὶ",707031,7],["τὰ",709436,41],["σκηνώματα",711849,42],["αὐτοῦ",702165,102],["ἁλμυρίδα",700714,42]],"whereas I made his habitation the wilderness, and the salt land his coverts."],["7",[["καταγελῶν",707222,72],["πολυοχλίας",710634,39],["πόλεως",710612,17],["μέμψιν",708729,9],["δὲ",703303,11],["φορολόγου",713559,18],["οὐκ",709805,28],["ἀκούων",700587,72]],"He laughs to scorn the multitude of the city, and hears not the chiding of the tax-gatherer."],["8",[["κατασκέψεται",707418,93],["ὄρη",709768,42],["νομὴν",709337,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὀπίσω",709697,0],["παντὸς",710177,116],["χλωροῦ",713880,116],["ζητεῖ",705879,91]],"He will survey the mountains [as] his pasture, and he seeks after every green thing."],["9",[["βουλήσεται",702795,93],["δέ",703303,11],["σοι",711925,159],["μονόκερως",708999,4],["δουλεῦσαι",703814,106],["ἢ",705924,7],["κοιμηθῆναι",707767,179],["ἐπὶ",705080,0],["φάτνης",713391,17],["σου",711945,133]],"And will the unicorn be willing to serve thee, or to lie down at thy manger?"],["10",[["δήσεις",703394,166],["δὲ",703303,11],["ἐν",704639,0],["ἱμᾶσι",706741,114],["ζυγὸν",705894,6],["αὐτοῦ",702165,102],["ἢ",705924,7],["ἑλκύσει",704508,127],["σου",711945,133],["αὔλακας",702134,57],["ἐν",704639,0],["πεδίῳ",710215,54]],"And wilt thou bind his yoke with thongs, or will he plough furrows for thee in the plain?"],["11",[["πέποιθας",710221,266],["δὲ",703303,11],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["ὅτι",709803,7],["πολλὴ",710646,29],["ἡ",709436,10],["ἰσχὺς",706858,12],["αὐτοῦ",702165,102],["ἐπαφήσεις",705051,166],["δὲ",703303,11],["αὐτῷ",702165,50],["τὰ",709436,41],["ἔργα",705396,42],["σου",711945,133]],"And dost thou trust him, because his strength is great? and wilt thou commit thy works to him?"],["12",[["πιστεύσεις",710483,166],["δὲ",703303,11],["ὅτι",709803,7],["ἀποδώσει",701449,127],["σοι",711925,159],["τὸν",709436,5],["σπόρον",712030,6],["εἰσοίσει",704127,127],["δέ",703303,11],["σου",711945,133],["τὸν",709436,5],["ἅλωνα",700741,6]],"And wilt thou believe that he will return to thee thy seed, and bring [it] in [to] thy threshing-floor?"],["13",[["πτέρυξ",711057,12],["τερπομένων",712804,66],["νεελασα",709239,118],["ἐὰν",703912,7],["συλλάβῃ",712262,175],["ασιδα",701946,12],["καὶ",707031,7],["νεσσα",709265,12]],"The peacock has a beautiful wing: if the stork and the ostrich conceive, [it is worthy of notice],"],["14",[["ὅτι",709803,7],["ἀφήσει",702211,127],["εἰς",704105,0],["γῆν",703083,9],["τὰ",709436,41],["ᾠὰ",714125,42],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐπὶ",705080,0],["χοῦν",713930,6],["θάλψει",706075,127]],"for [the ostrich] will leave her eggs in the ground, and warm them on the dust,"],["15",[["καὶ",707031,7],["ἐπελάθετο",705187,23],["ὅτι",709803,7],["ποὺς",710707,4],["σκορπιεῖ",711881,127],["καὶ",707031,7],["θηρία",706252,64],["ἀγροῦ",700196,18],["καταπατήσει",707360,127]],"and has forgotten that the foot will scatter them, and the wild beasts of the field trample them."],["16",[["ἀπεσκλήρυνεν",701575,13],["τὰ",709436,41],["τέκνα",712761,42],["αὐτῆς",702165,86],["ὥστε",714164,7],["μὴ",708851,28],["ἑαυτῇ",703917,105],["εἰς",704105,0],["κενὸν",707612,27],["ἐκοπίασεν",707824,2],["ἄνευ",701137,0],["φόβου",713534,18]],"She has hardened [herself] against her young ones, as though [she bereaved] not herself: she labours in vain without fear."],["17",[["ὅτι",709803,7],["κατεσιώπησεν",707415,2],["αὐτῇ",702165,105],["ὁ",709436,3],["θεὸς",706192,4],["σοφίαν",711981,9],["καὶ",707031,7],["οὐκ",709805,28],["ἐμέρισεν",708744,2],["αὐτῇ",702165,105],["ἐν",704639,0],["τῇ",709436,100],["συνέσει",712460,1]],"For God has withholden wisdom from her, and not given her a portion in understanding."],["18",[["κατὰ",707200,0],["καιρὸν",707047,6],["ἐν",704639,0],["ὕψει",713288,54],["ὑψώσει",713289,127],["καταγελάσεται",707222,127],["ἵππου",706790,18],["καὶ",707031,7],["τοῦ",709436,35],["ἐπιβάτου",705085,18],["αὐτοῦ",702165,102]],"In her season she will lift herself on high; she will scorn the horse and his rider."],["19",[["ἦ",705925,28],["σὺ",712181,164],["περιέθηκας",710403,162],["ἵππῳ",706790,114],["δύναμιν",703839,9],["ἐνέδυσας",704701,162],["δὲ",703303,11],["τραχήλῳ",712924,114],["αὐτοῦ",702165,102],["φόβον",713534,6]],"Hast thou invested the horse with strength, and clothed his neck with terror?"],["20",[["περιέθηκας",710403,162],["δὲ",703303,11],["αὐτῷ",702165,50],["πανοπλίαν",709968,9],["δόξαν",703791,9],["δὲ",703303,11],["στηθέων",712089,44],["αὐτοῦ",702165,102],["τόλμῃ",712884,1]],"And hast thou clad him in perfect armour, and made his breast glorious with courage?"],["21",[["ἀνορύσσων",701198,72],["ἐν",704639,0],["πεδίῳ",710215,54],["γαυριᾷ",702982,91],["ἐκπορεύεται",704293,117],["δὲ",703303,11],["εἰς",704105,0],["πεδίον",710215,25],["ἐν",704639,0],["ἰσχύι",706858,1]],"He paws exulting in the plain, and goes forth in strength into the plain."],["22",[["συναντῶν",712394,72],["βέλει",702644,54],["καταγελᾷ",707222,91],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἀποστραφῇ",701598,384],["ἀπὸ",701425,0],["σιδήρου",711774,18]],"He laughs to scorn a king as he meets him, and will by no means turn back from the sword."],["23",[["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["γαυριᾷ",702982,91],["τόξον",712898,25],["καὶ",707031,7],["μάχαιρα",708593,12]],"The bow and sword resound against him; and [his] rage will swallow up the ground:"],["24",[["καὶ",707031,7],["ὀργῇ",709728,1],["ἀφανιεῖ",702182,127],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["πιστεύσῃ",710483,123],["ἕως",705792,7],["ἂν",700900,11],["σημάνῃ",711745,172],["σάλπιγξ",711424,12]],"and he will not believe until the trumpet sounds."],["25",[["σάλπιγγος",711424,17],["δὲ",703303,11],["σημαινούσης",711745,222],["λέγει",708124,91],["εὖγε",705557,88],["πόρρωθεν",710681,28],["δὲ",703303,11],["ὀσφραίνεται",709798,117],["πολέμου",710605,18],["σὺν",712372,0],["ἅλματι",700712,54],["καὶ",707031,7],["κραυγῇ",707886,1]],"And when the trumpet sounds, he says, Aha! and afar off he smells the war with prancing and neighing."],["26",[["ἐκ",704132,0],["δὲ",703303,11],["τῆς",709436,16],["σῆς",711943,82],["ἐπιστήμης",705267,17],["ἕστηκεν",706846,171],["ἱέραξ",706603,4],["ἀναπετάσας",701030,182],["τὰς",709436,38],["πτέρυγας",711057,39],["ἀκίνητος",700545,14],["καθορῶν",707019,72],["τὰ",709436,41],["πρὸς",710844,0],["νότον",709364,6]],"And does the hawk remain steady by thy wisdom, having spread out her wings unmoved, looking toward the region of the south?"],["27",[["ἐπὶ",705080,0],["δὲ",703303,11],["σῷ",711943,97],["προστάγματι",710959,54],["ὑψοῦται",713289,117],["ἀετός",700318,4],["γὺψ",703212,4],["δὲ",703303,11],["ἐπὶ",705080,0],["νοσσιᾶς",709360,17],["αὐτοῦ",702165,102],["καθεσθεὶς",706993,182],["αὐλίζεται",702138,117]],"And does the eagle rise at thy command, and the vulture remain sitting over his nest,"],["28",[["ἐπ᾿",705080,0],["ἐξοχῇ",704952,1],["πέτρας",710443,17],["καὶ",707031,7],["ἀποκρύφῳ",701497,97]],"on a crag of a rock, and in a secret [place]?"],["29",[["ἐκεῖσε",704184,28],["ὢν",704093,72],["ζητεῖ",705879,91],["τὰ",709436,41],["σῖτα",711814,42],["πόρρωθεν",710681,28],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["αὐτοῦ",702165,102],["σκοπεύουσιν",711873,197]],"Thence he seeks food, his eyes observe from far."],["30",[["νεοσσοὶ",709257,52],["δὲ",703303,11],["αὐτοῦ",702165,102],["φύρονται",713629,269],["ἐν",704639,0],["αἵματι",700442,54],["οὗ",709781,48],["δ᾿",703303,11],["ἂν",700900,11],["ὦσι",704093,271],["τεθνεῶτες",706278,268],["παραχρῆμα",710119,28],["εὑρίσκονται",705676,699]],"And his young ones roll themselves in blood, and wherever the carcases may be, immediately they are found."]]