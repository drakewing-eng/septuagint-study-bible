[["1",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Σωφαρ",712665,4],["ὁ",709436,3],["Μιναῖος",708925,4],["λέγει",708124,91]],"Then Sophar the Minæan answered and said,"],["2",[["οὐχ",709805,28],["οὕτως",709859,28],["ὑπελάμβανον",713210,333],["ἀντερεῖν",701223,296],["σε",711598,163],["ταῦτα",709858,71],["καὶ",707031,7],["οὐχὶ",709862,28],["συνίετε",712481,87],["μᾶλλον",708448,28],["ἢ",705924,7],["καὶ",707031,28],["ἐγώ",704018,164]],"I did not suppose that thou wouldest answer thus: neither do ye understand more than I."],["3",[["παιδείαν",709924,9],["ἐντροπῆς",704809,17],["μου",709032,133],["ἀκούσομαι",700587,181],["καὶ",707031,7],["πνεῦμα",710566,15],["ἐκ",704132,0],["τῆς",709436,16],["συνέσεως",712460,17],["ἀποκρίνεταί",701492,117],["μοι",708974,159]],"I will hear my shameful reproach; and the spirit of my understanding answers me."],["4",[["μὴ",708851,28],["ταῦτα",709858,71],["ἔγνως",703105,162],["ἀπὸ",701425,0],["τοῦ",709436,20],["ἔτι",705538,28],["ἀφ᾿",701425,0],["οὗ",709781,48],["ἐτέθη",712849,37],["ἄνθρωπος",701163,4],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"Hast thou [not] known these things of old, from the time that man was set upon the earth?"],["5",[["εὐφροσύνη",705717,12],["γὰρ",702963,11],["ἀσεβῶν",701909,169],["πτῶμα",711071,15],["ἐξαίσιον",704840,26],["χαρμονὴ",713745,12],["δὲ",703303,11],["παρανόμων",710080,169],["ἀπώλεια",701660,12]],"But the mirth of the ungodly is a signal downfall, and the joy of transgressors is destruction:"],["6",[["ἐὰν",703912,7],["ἀναβῇ",700905,172],["εἰς",704105,0],["οὐρανὸν",709844,6],["αὐτοῦ",702165,102],["τὰ",709436,63],["δῶρα",703907,64],["ἡ",709436,10],["δὲ",703303,11],["θυσία",706345,12],["αὐτοῦ",702165,102],["νεφῶν",709281,44],["ἅψηται",701654,239]],"although his gifts should go up to heaven, and his sacrifice reach the clouds."],["7",[["ὅταν",709801,28],["γὰρ",702963,11],["δοκῇ",703775,204],["ἤδη",705939,28],["κατεστηρίχθαι",707440,675],["τότε",712908,28],["εἰς",704105,0],["τέλος",712787,25],["ἀπολεῖται",701513,93],["οἱ",709436,136],["δὲ",703303,11],["ἰδόντες",709725,196],["αὐτὸν",702165,85],["ἐροῦσιν",705415,218],["ποῦ",710706,28],["ἐστιν",704093,91]],"For when he shall seem to be now established, then he shall utterly perish: and they that knew him shall say, Where is he?"],["8",[["ὥσπερ",714163,28],["ἐνύπνιον",704818,15],["ἐκπετασθὲν",704277,418],["οὐ",709805,28],["μὴ",708851,28],["εὑρεθῇ",705676,384],["ἔπτη",710441,23],["δὲ",703303,11],["ὥσπερ",714163,28],["φάσμα",713385,15],["νυκτερινόν",709375,26]],"Like a dream that has fled away, he shall not be found; and he has fled like a vision of the night."],["9",[["ὀφθαλμὸς",709870,4],["παρέβλεψεν",710002,2],["καὶ",707031,7],["οὐ",709805,28],["προσθήσει",710965,127],["καὶ",707031,7],["οὐκέτι",709827,28],["προσνοήσει",710937,127],["αὐτὸν",702165,85],["ὁ",709436,3],["τόπος",712903,4],["αὐτοῦ",702165,102]],"The eye has looked upon him, but shall not [see him] again; and his place shall no longer perceive him."],["10",[["τοὺς",709436,58],["υἱοὺς",713075,57],["αὐτοῦ",702165,102],["ὀλέσαισαν",709584,396],["ἥττονες",706042,138],["αἱ",709436,190],["δὲ",703303,11],["χεῖρες",713787,191],["αὐτοῦ",702165,102],["πυρσεύσαισαν",711110,396],["ὀδύνας",709463,39]],"Let [his] inferiors destroy his children, and let his hands kindle the fire of sorrow."],["11",[["ὀστᾶ",709792,64],["αὐτοῦ",702165,102],["ἐνεπλήσθησαν",704592,99],["νεότητος",709258,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["χώματος",714000,21],["κοιμηθήσεται",707767,134]],"His bones have been filled with [vigour of] his youth, and it shall lie down with him in the dust."],["12",[["ἐὰν",703912,7],["γλυκανθῇ",703110,384],["ἐν",704639,0],["στόματι",712125,54],["αὐτοῦ",702165,102],["κακία",707054,12],["κρύψει",707923,127],["αὐτὴν",702165,104],["ὑπὸ",713184,0],["τὴν",709436,8],["γλῶσσαν",703120,9],["αὐτοῦ",702165,102]],"Though evil be sweet in his mouth, [though] he will hide it under his tongue;"],["13",[["οὐ",709805,28],["φείσεται",713406,93],["αὐτῆς",702165,86],["καὶ",707031,7],["οὐκ",709805,28],["ἐγκαταλείψει",703967,127],["αὐτὴν",702165,104],["καὶ",707031,7],["συνέξει",712469,127],["αὐτὴν",702165,104],["ἐν",704639,0],["μέσῳ",708768,97],["τοῦ",709436,35],["λάρυγγος",708098,18],["αὐτοῦ",702165,102]],"though he will not spare it, and will not leave it, but will keep it in the midst of his throat:"],["14",[["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["δυνηθῇ",703838,384],["βοηθῆσαι",702746,106],["ἑαυτῷ",703917,50],["χολὴ",713900,12],["ἀσπίδος",701991,17],["ἐν",704639,0],["γαστρὶ",702976,1],["αὐτοῦ",702165,102]],"yet he shall not at all be able to help himself; the gall of an asp is in his belly."],["15",[["πλοῦτος",710563,4],["ἀδίκως",700273,28],["συναγόμενος",712375,466],["ἐξεμεσθήσεται",704901,134],["ἐξ",704132,0],["οἰκίας",709505,17],["αὐτοῦ",702165,102],["ἐξελκύσει",704900,127],["αὐτὸν",702165,85],["ἄγγελος",700140,4]],"[His] wealth unjustly collected shall be vomited up; a messenger [of wrath] shall drag him out of his house."],["16",[["θυμὸν",706334,6],["δὲ",703303,11],["δρακόντων",703822,81],["θηλάσειεν",706233,225],["ἀνέλοι",700962,225],["δὲ",703303,11],["αὐτὸν",702165,85],["γλῶσσα",703120,12],["ὄφεως",709875,18]],"And let him suck the poison of serpents, and let the serpent's tongue slay him."],["17",[["μὴ",708851,28],["ἴδοι",709725,225],["ἄμελξιν",700804,9],["νομάδων",709334,65],["μηδὲ",708855,7],["νομὰς",709337,39],["μέλιτος",708700,21],["καὶ",707031,7],["βουτύρου",702800,21]],"Let him not see the milk of the pastures, nor the supplies of honey and butter."],["18",[["εἰς",704105,0],["κενὰ",707612,68],["καὶ",707031,7],["μάταια",708575,68],["ἐκοπίασεν",707824,2],["πλοῦτον",710563,6],["ἐξ",704132,0],["οὗ",709781,48],["οὐ",709805,28],["γεύσεται",703074,93],["ὥσπερ",714163,28],["στρίφνος",712162,4],["ἀμάσητος",700780,14],["ἀκατάποτος",700528,14]],"He has laboured unprofitably and in vain, [for] wealth of which he shall not taste: [it is] as a lean thing, unfit for food, which he cannot swallow."],["19",[["πολλῶν",710646,169],["γὰρ",702963,11],["ἀδυνάτων",700297,169],["οἴκους",709516,57],["ἔθλασεν",706273,2],["δίαιταν",703460,9],["δὲ",703303,11],["ἥρπασεν",701804,2],["καὶ",707031,7],["οὐκ",709805,28],["ἔστησεν",706846,2]],"For he has broken down the houses of many mighty men: and he has plundered an habitation, though he built [it] not."],["20",[["οὐκ",709805,28],["ἔστιν",704093,91],["αὐτοῦ",702165,102],["σωτηρία",712658,12],["τοῖς",709436,95],["ὑπάρχουσιν",713104,358],["ἐν",704639,0],["ἐπιθυμίᾳ",705147,1],["αὐτοῦ",702165,102],["οὐ",709805,28],["σωθήσεται",712627,134]],"There is no security to his possessions; he shall not be saved by his desire."],["21",[["οὐκ",709805,28],["ἔστιν",704093,91],["ὑπόλειμμα",713211,15],["τοῖς",709436,95],["βρώμασιν",702823,96],["αὐτοῦ",702165,102],["διὰ",703417,0],["τοῦτο",709858,129],["οὐκ",709805,28],["ἀνθήσει",701152,127],["αὐτοῦ",702165,102],["τὰ",709436,63],["ἀγαθά",700106,195]],"There is nothing remaining of his provisions; therefore his goods shall not flourish."],["22",[["ὅταν",709801,28],["δὲ",703303,11],["δοκῇ",703775,204],["ἤδη",705939,28],["πεπληρῶσθαι",710543,675],["θλιβήσεται",706274,134],["πᾶσα",710177,29],["δὲ",703303,11],["ἀνάγκη",700925,12],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["ἐπελεύσεται",705068,93]],"But when he shall seem to be just satisfied, he shall be straitened; and all distress shall come upon him."],["23",[["εἴ",704071,7],["πως",711121,28],["πληρώσαι",710543,106],["γαστέρα",702976,9],["αὐτοῦ",702165,102],["ἐπαποστείλαι",705036,106],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["θυμὸν",706334,6],["ὀργῆς",709728,17],["νίψαι",709314,225],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["ὀδύνας",709463,39]],"If by any means he would fill his belly, let [God] send upon him the fury of wrath; let him bring a torrent of pains upon him."],["24",[["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["σωθῇ",712627,384],["ἐκ",704132,0],["χειρὸς",713787,17],["σιδήρου",711774,18],["τρώσαι",712871,225],["αὐτὸν",702165,85],["τόξον",712898,15],["χάλκειον",713688,15]],"And he shall by no means escape from the power of the sword; let the brazen bow wound him."],["25",[["διεξέλθοι",703665,225],["δὲ",703303,11],["διὰ",703417,0],["σώματος",712635,21],["αὐτοῦ",702165,102],["βέλος",702644,25],["ἀστραπαὶ",702021,191],["δὲ",703303,11],["ἐν",704639,0],["διαίταις",703460,76],["αὐτοῦ",702165,102],["περιπατήσαισαν",710362,396],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["φόβοι",713534,52]],"And let the arrow pierce through his body; and let the stars be against his dwelling-place: let terrors come upon him."],["26",[["πᾶν",710177,26],["δὲ",703303,11],["σκότος",711889,15],["αὐτῷ",702165,50],["ὑπομείναι",713219,225],["κατέδεται",707519,93],["αὐτὸν",702165,85],["πῦρ",711088,15],["ἄκαυστον",700535,26],["κακώσαι",707073,225],["δὲ",703303,11],["αὐτοῦ",702165,102],["ἐπήλυτος",705078,4],["τὸν",709436,5],["οἶκον",709516,6]],"And let all darkness wait for him: a fire that burns not out shall consume him; and let a stranger plague his house."],["27",[["ἀνακαλύψαι",700968,225],["δὲ",703303,11],["αὐτοῦ",702165,102],["ὁ",709436,3],["οὐρανὸς",709844,4],["τὰς",709436,38],["ἀνομίας",701192,39],["γῆ",703083,12],["δὲ",703303,11],["ἐπανασταίη",705026,225],["αὐτῷ",702165,50]],"And let the heaven reveal his iniquities, and the earth rise up against him."],["28",[["ἑλκύσαι",704508,225],["τὸν",709436,5],["οἶκον",709516,6],["αὐτοῦ",702165,102],["ἀπώλεια",701660,12],["εἰς",704105,0],["τέλος",712787,25],["ἡμέρα",705984,12],["ὀργῆς",709728,17],["ἐπέλθοι",705068,225],["αὐτῷ",702165,50]],"Let destruction bring his house to an end; let a day of wrath come upon him."],["29",[["αὕτη",709858,107],["ἡ",709436,10],["μερὶς",708748,12],["ἀνθρώπου",701163,18],["ἀσεβοῦς",701909,116],["παρὰ",709995,0],["κυρίου",707996,18],["καὶ",707031,7],["κτῆμα",707933,15],["ὑπαρχόντων",713102,170],["αὐτῷ",702165,50],["παρὰ",709995,0],["τοῦ",709436,35],["ἐπισκόπου",705256,18]],"This is the portion of an ungodly man from the Lord, and the possession of his goods [appointed him] by the all-seeing [God]."]]