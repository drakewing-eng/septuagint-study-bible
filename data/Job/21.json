[["1",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Ιωβ",706903,4],["λέγει",708124,91]],"But Job answered and said,"],["2",[["ἀκούσατε",700587,74],["ἀκούσατέ",700587,74],["μου",709032,133],["τῶν",709436,80],["λόγων",708236,81],["ἵνα",706747,7],["μὴ",708851,28],["ᾖ",704093,204],["μοι",708974,159],["παρ᾿",709995,0],["ὑμῶν",713091,145],["αὕτη",709858,107],["ἡ",709436,10],["παράκλησις",710047,12]],"Hear ye, hear ye my words, that I may not have this consolation from you."],["3",[["ἄρατέ",700473,74],["με",708618,163],["ἐγὼ",704018,164],["δὲ",703303,11],["λαλήσω",708071,165],["εἶτ᾿",704129,28],["οὐ",709805,28],["καταγελάσετέ",707222,337],["μου",709032,133]],"Raise me, and I will speak; then ye shall not laugh me to scorn."],["4",[["τί",712867,126],["γάρ",702963,11],["μὴ",708851,28],["ἀνθρώπου",701163,18],["μου",709032,133],["ἡ",709436,10],["ἔλεγξις",704414,12],["ἢ",705924,7],["διὰ",703417,0],["τί",712867,126],["οὐ",709805,28],["θυμωθήσομαι",706335,180]],"What! is my reproof of man? and why should I not be angry?"],["5",[["εἰσβλέψαντες",704110,196],["εἰς",704105,0],["ἐμὲ",704555,163],["θαυμάσατε",706135,74],["χεῖρα",713787,9],["θέντες",712849,196],["ἐπὶ",705080,0],["σιαγόνι",711763,1]],"Look upon me, and wonder, laying your hand upon your cheek."],["6",[["ἐάν",703912,7],["τε",712751,11],["γὰρ",702963,11],["μνησθῶ",708960,321],["ἐσπούδακα",712031,89],["ἔχουσιν",705785,197],["δέ",703303,11],["μου",709032,133],["τὰς",709436,38],["σάρκας",711537,39],["ὀδύναι",709463,191]],"For even when I remember, I am alarmed, and pains seize my flesh."],["7",[["διὰ",703417,0],["τί",712867,126],["ἀσεβεῖς",701909,138],["ζῶσιν",705851,197],["πεπαλαίωνται",709937,255],["δὲ",703303,11],["καὶ",707031,7],["ἐν",704639,0],["πλούτῳ",710563,114]],"Wherefore do the ungodly live, and grow old even in wealth?"],["8",[["ὁ",709436,3],["σπόρος",712030,4],["αὐτῶν",702165,40],["κατὰ",707200,0],["ψυχήν",714070,9],["τὰ",709436,63],["δὲ",703303,11],["τέκνα",712761,64],["αὐτῶν",702165,40],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148]],"Their seed is according to [their] desire, and their children are in [their] sight."],["9",[["οἱ",709436,136],["οἶκοι",709516,52],["αὐτῶν",702165,40],["εὐθηνοῦσιν",705594,197],["φόβος",713534,4],["δὲ",703303,11],["οὐδαμοῦ",709813,28],["μάστιξ",708568,12],["δὲ",703303,11],["παρὰ",709995,0],["κυρίου",707996,18],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐπ᾿",705080,0],["αὐτοῖς",702165,151]],"Their houses are prosperous, neither [have they] any where [cause for] fear, neither is there a scourge from the Lord upon them."],["10",[["ἡ",709436,10],["βοῦς",702798,12],["αὐτῶν",702165,40],["οὐκ",709805,28],["ὠμοτόκησεν",714116,2],["διεσώθη",703599,37],["δὲ",703303,11],["αὐτῶν",702165,40],["ἐν",704639,0],["γαστρὶ",702976,1],["ἔχουσα",705785,188],["καὶ",707031,7],["οὐκ",709805,28],["ἔσφαλεν",712575,2]],"Their cow does not cast her calf, and their [beast] with young is safe, and does not miscarry."],["11",[["μένουσιν",708736,197],["δὲ",703303,11],["ὡς",714148,7],["πρόβατα",710768,42],["αἰώνια",700505,68],["τὰ",709436,41],["δὲ",703303,11],["παιδία",709927,42],["αὐτῶν",702165,40],["προσπαίζουσιν",710949,197]],"And they remain as an unfailing flock, and their children play before [them], taking up the psaltery and harp;"],["12",[["ἀναλαβόντες",700984,196],["ψαλτήριον",714023,25],["καὶ",707031,7],["κιθάραν",707669,9],["καὶ",707031,7],["εὐφραίνονται",705715,699],["φωνῇ",713640,1],["ψαλμοῦ",714022,18]],"and they rejoice at the voice of a song."],["13",[["συνετέλεσαν",712510,150],["δὲ",703303,11],["ἐν",704639,0],["ἀγαθοῖς",700106,230],["τὸν",709436,5],["βίον",702724,6],["αὐτῶν",702165,40],["ἐν",704639,0],["δὲ",703303,11],["ἀναπαύσει",701026,1],["ᾅδου",700255,18],["ἐκοιμήθησαν",707767,99]],"And they spend their days in wealth, and fall asleep in the rest of the grave."],["14",[["λέγει",708124,91],["δὲ",703303,11],["κυρίῳ",707996,114],["ἀπόστα",702214,176],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["ὁδούς",709458,39],["σου",711945,133],["εἰδέναι",709492,115],["οὐ",709805,28],["βούλομαι",702795,254]],"Yet [such a man] says to the Lord, Depart from me; I desire not to know thy ways."],["15",[["τί",712867,273],["ἱκανός",706710,14],["ὅτι",709803,7],["δουλεύσομεν",703814,275],["αὐτῷ",702165,50],["καὶ",707031,7],["τίς",712867,273],["ὠφέλεια",714170,12],["ὅτι",709803,7],["ἀπαντήσομεν",701345,275],["αὐτῷ",702165,50]],"What is the Mighty One, that we should serve him? and what profit is there that we should approach him?"],["16",[["ἐν",704639,0],["χερσὶν",713787,76],["γὰρ",702963,11],["ἦν",704093,13],["αὐτῶν",702165,40],["τὰ",709436,63],["ἀγαθά",700106,195],["ἔργα",705396,64],["δὲ",703303,11],["ἀσεβῶν",701909,169],["οὐκ",709805,28],["ἐφορᾷ",705057,91]],"For their good things were in [their] hands, but he regards not the works of the ungodly."],["17",[["οὐ",709805,28],["μὴν",708873,11],["δὲ",703303,11],["ἀλλὰ",700680,7],["καὶ",707031,7],["ἀσεβῶν",701909,169],["λύχνος",708287,4],["σβεσθήσεται",711596,134],["ἐπελεύσεται",705068,93],["δὲ",703303,11],["αὐτοῖς",702165,151],["ἡ",709436,10],["καταστροφή",707445,12],["ὠδῖνες",714094,191],["δὲ",703303,11],["αὐτοὺς",702165,62],["ἕξουσιν",705785,218],["ἀπὸ",701425,0],["ὀργῆς",709728,17]],"Nevertheless, the lamp of the ungodly also shall be put out, and destruction shall come upon them, and pangs of vengeance shall seize them."],["18",[["ἔσονται",704093,135],["δὲ",703303,11],["ὥσπερ",714163,28],["ἄχυρα",702316,42],["πρὸ",710747,0],["ἀνέμου",701123,18],["ἢ",705924,7],["ὥσπερ",714163,28],["κονιορτός",707815,4],["ὃν",709781,112],["ὑφείλατο",713276,23],["λαῖλαψ",708061,12]],"And they shall be as chaff before the wind, or as dust which the storm has taken up."],["19",[["ἐκλίποι",704237,225],["υἱοὺς",713075,57],["τὰ",709436,63],["ὑπάρχοντα",713102,242],["αὐτοῦ",702165,102],["ἀνταποδώσει",701215,127],["πρὸς",710844,0],["αὐτὸν",702165,85],["καὶ",707031,7],["γνώσεται",703105,93]],"Let his substance fail [to supply] his children: [God] shall recompense him, and he shall know it."],["20",[["ἴδοισαν",709725,396],["οἱ",709436,136],["ὀφθαλμοὶ",709870,52],["αὐτοῦ",702165,102],["τὴν",709436,8],["ἑαυτοῦ",703917,102],["σφαγήν",712568,9],["ἀπὸ",701425,0],["δὲ",703303,11],["κυρίου",707996,18],["μὴ",708851,28],["διασωθείη",703599,528]],"Let his eyes see his own destruction, and let him not be saved by the Lord."],["21",[["ὅτι",709803,7],["τί",712867,273],["θέλημα",706170,15],["αὐτοῦ",702165,102],["ἐν",704639,0],["οἴκῳ",709516,114],["αὐτοῦ",702165,102],["μετ᾿",708780,0],["αὐτόν",702165,85],["καὶ",707031,7],["ἀριθμοὶ",701744,52],["μηνῶν",708874,81],["αὐτοῦ",702165,102],["διῃρέθησαν",703459,99]],"For his desire is in his house with him, and the number of his months has been suddenly cut off."],["22",[["πότερον",710697,28],["οὐχὶ",709862,28],["ὁ",709436,3],["κύριός",707996,4],["ἐστιν",704093,91],["ὁ",709436,3],["διδάσκων",703649,72],["σύνεσιν",712460,9],["καὶ",707031,7],["ἐπιστήμην",705267,9],["αὐτὸς",702165,121],["δὲ",703303,11],["φόνους",713549,57],["διακρινεῖ",703488,127]],"Is it not the Lord who teaches understanding and knowledge? and does not he judge murders?"],["23",[["οὗτος",709858,121],["ἀποθανεῖται",701461,93],["ἐν",704639,0],["κράτει",707883,54],["ἁπλοσύνης",701419,17],["αὐτοῦ",702165,102],["ὅλος",709597,14],["δὲ",703303,11],["εὐπαθῶν",705657,72],["καὶ",707031,7],["εὐθηνῶν",705594,72]],"One shall die in his perfect strength, and wholly at ease and prosperous;"],["24",[["τὰ",709436,63],["δὲ",703303,11],["ἔγκατα",703964,64],["αὐτοῦ",702165,102],["πλήρη",710541,195],["στέατος",712054,21],["μυελὸς",709046,4],["δὲ",703303,11],["αὐτοῦ",702165,102],["διαχεῖται",703636,117]],"and his inwards are full of fat, and his marrow is diffused [throughout him]."],["25",[["ὁ",709436,3],["δὲ",703303,11],["τελευτᾷ",712781,91],["ὑπὸ",713184,0],["πικρίας",710472,17],["ψυχῆς",714070,17],["οὐ",709805,28],["φαγὼν",705495,182],["οὐδὲν",709817,46],["ἀγαθόν",700106,46]],"And another dies in bitterness of soul, not eating any good thing."],["26",[["ὁμοθυμαδὸν",709624,28],["δὲ",703303,11],["ἐπὶ",705080,0],["γῆς",703083,17],["κοιμῶνται",707767,269],["σαπρία",711503,12],["δὲ",703303,11],["αὐτοὺς",702165,62],["ἐκάλυψεν",707102,2]],"But they lie down in the earth together, and corruption covers them."],["27",[["ὥστε",714164,7],["οἶδα",709492,89],["ὑμᾶς",713080,194],["ὅτι",709803,7],["τόλμῃ",712884,1],["ἐπίκεισθέ",705160,374],["μοι",708974,159]],"So I know you, that ye presumptuously attack me:"],["28",[["ὅτι",709803,7],["ἐρεῖτε",705415,337],["ποῦ",710706,28],["ἐστιν",704093,91],["οἶκος",709516,4],["ἄρχοντος",701862,18],["καὶ",707031,7],["ποῦ",710706,28],["ἐστιν",704093,91],["ἡ",709436,10],["σκέπη",711838,12],["τῶν",709436,43],["σκηνωμάτων",711849,44],["τῶν",709436,80],["ἀσεβῶν",701909,169]],"so that ye will say, Where is the house of the prince? and where is the covering of the tabernacles of the ungodly?"],["29",[["ἐρωτήσατε",705459,74],["παραπορευομένους",710094,236],["ὁδόν",709458,9],["καὶ",707031,7],["τὰ",709436,41],["σημεῖα",711748,42],["αὐτῶν",702165,40],["οὐκ",709805,28],["ἀπαλλοτριώσετε",701334,166]],"Ask those that go by the way, and do not disown their tokens."],["30",[["ὅτι",709803,7],["εἰς",704105,0],["ἡμέραν",705984,9],["ἀπωλείας",701660,17],["κουφίζεται",707862,391],["ὁ",709436,3],["πονηρός",710660,14],["εἰς",704105,0],["ἡμέραν",705984,9],["ὀργῆς",709728,17],["αὐτοῦ",702165,102],["ἀπαχθήσονται",701324,144]],"For the wicked hastens to the day of destruction: they shall be led away for the day of his vengeance."],["31",[["τίς",712867,158],["ἀπαγγελεῖ",701321,127],["ἐπὶ",705080,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["τὴν",709436,8],["ὁδὸν",709458,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["αὐτὸς",702165,121],["ἐποίησεν",710582,2],["τίς",712867,158],["ἀνταποδώσει",701215,127],["αὐτῷ",702165,50]],"Who will tell him his way to his face, whereas he has done [it]? who shall recompense him?"],["32",[["καὶ",707031,7],["αὐτὸς",702165,121],["εἰς",704105,0],["τάφους",712738,57],["ἀπηνέχθη",701632,37],["καὶ",707031,7],["ἐπὶ",705080,0],["σορῷ",711942,1],["ἠγρύπνησεν",700197,2]],"And he has been led away to the tombs, and he has watched over the heaps."],["33",[["ἐγλυκάνθησαν",703110,99],["αὐτῷ",702165,50],["χάλικες",713686,52],["χειμάρρου",713783,18],["καὶ",707031,7],["ὀπίσω",709697,0],["αὐτοῦ",702165,102],["πᾶς",710177,14],["ἄνθρωπος",701163,4],["ἀπελεύσεται",701398,93],["καὶ",707031,7],["ἔμπροσθεν",704618,0],["αὐτοῦ",702165,102],["ἀναρίθμητοι",701047,138]],"The stones of the valley have been sweet to him, and every man shall depart after him, and [there are] innumerable [ones] before him."],["34",[["πῶς",711121,28],["δὲ",703303,11],["παρακαλεῖτέ",710039,87],["με",708618,163],["κενά",707612,68],["τὸ",709436,24],["δὲ",703303,11],["ἐμὲ",704555,163],["καταπαύσασθαι",707365,109],["ἀφ᾿",701425,0],["ὑμῶν",713091,145],["οὐδέν",709817,46]],"How then do ye comfort me in vain? whereas I have no rest from your molestation."]]