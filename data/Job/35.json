[["1",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Ελιους",704478,4],["λέγει",708124,91]],"And Elius resumed and said,"],["2",[["τί",712867,126],["τοῦτο",709858,129],["ἡγήσω",705931,174],["ἐν",704639,0],["κρίσει",707908,1],["σὺ",712181,164],["τίς",712867,158],["εἶ",704093,154],["ὅτι",709803,7],["εἶπας",705373,162],["δίκαιός",703694,14],["εἰμι",704093,157],["ἔναντι",704653,0],["κυρίου",707996,18]],"What is this that thou thinkest to be according to right? who art thou that thou hast said, I am righteous before the Lord?"],["3",[["ἢ",705924,7],["ἐρεῖς",705415,166],["τί",712867,126],["ποιήσω",710582,207],["ἁμαρτών",700773,182]],null],["4",[["ἐγὼ",704018,164],["σοὶ",711925,159],["δώσω",703654,165],["ἀπόκρισιν",701493,9],["καὶ",707031,7],["τοῖς",709436,147],["τρισὶν",712927,230],["φίλοις",713492,230],["σου",711945,133]],"I will answer thee, and thy three friends."],["5",[["ἀνάβλεψον",700913,176],["εἰς",704105,0],["τὸν",709436,5],["οὐρανὸν",709844,6],["καὶ",707031,7],["ἰδέ",709725,176],["κατάμαθε",707324,176],["δὲ",703303,11],["νέφη",709281,42],["ὡς",714148,7],["ὑψηλὰ",713285,68],["ἀπὸ",701425,0],["σοῦ",711945,133]],"Look up to the sky and see; and consider the clouds, how high [they are] above thee."],["6",[["εἰ",704071,7],["ἥμαρτες",700773,162],["τί",712867,126],["πράξεις",710721,166],["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["πολλὰ",710646,68],["ἠνόμησας",701190,162],["τί",712867,126],["δύνασαι",703838,259],["ποιῆσαι",710582,106]],"If thou hast sinned, what wilt thou do? and if too thou hast transgressed much, what canst thou perform?"],["7",[["ἐπεὶ",705054,7],["δὲ",703303,11],["οὖν",709835,11],["δίκαιος",703694,14],["εἶ",704093,154],["τί",712867,126],["δώσεις",703654,166],["αὐτῷ",702165,50],["ἢ",705924,7],["τί",712867,126],["ἐκ",704132,0],["χειρός",713787,17],["σου",711945,133],["λήμψεται",708076,93]],"And suppose thou art righteous, what wilt thou give him? or what shall he receive of thy hand?"],["8",[["ἀνδρὶ",701150,114],["τῷ",709436,113],["ὁμοίῳ",709626,30],["σου",711945,133],["ἡ",709436,10],["ἀσέβειά",701904,12],["σου",711945,133],["καὶ",707031,7],["υἱῷ",713075,114],["ἀνθρώπου",701163,18],["ἡ",709436,10],["δικαιοσύνη",703695,12],["σου",711945,133]],"Thy ungodliness [may affect] a man who is like to thee; or thy righteousness a son of man."],["9",[["ἀπὸ",701425,0],["πλήθους",710529,21],["συκοφαντούμενοι",712256,348],["κεκράξονται",707868,135],["βοήσονται",702743,135],["ἀπὸ",701425,0],["βραχίονος",702808,18],["πολλῶν",710646,169]],"They that are oppressed of a multitude will be ready to cry out; they will call for help because of the arm of many."],["10",[["καὶ",707031,7],["οὐκ",709805,28],["εἶπεν",705373,2],["ποῦ",710706,28],["ἐστιν",704093,91],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["ποιήσας",710582,182],["με",708618,163],["ὁ",709436,3],["κατατάσσων",707453,72],["φυλακὰς",713613,39],["νυκτερινάς",709375,82]],"But none said, Where is God that made me, who appoints the night-watches;"],["11",[["ὁ",709436,3],["διορίζων",703730,72],["με",708618,163],["ἀπὸ",701425,0],["τετραπόδων",712823,169],["γῆς",703083,17],["ἀπὸ",701425,0],["δὲ",703303,11],["πετεινῶν",710439,44],["οὐρανοῦ",709844,18]],"who makes me to differ from the four-footed beasts of the earth, and from the birds of the sky?"],["12",[["ἐκεῖ",704181,28],["κεκράξονται",707868,135],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["εἰσακούσῃ",704108,172],["καὶ",707031,7],["ἀπὸ",701425,0],["ὕβρεως",713051,17],["πονηρῶν",710660,169]],"There they shall cry, and none shall hearken, even because of the insolence of wicked men."],["13",[["ἄτοπα",702102,68],["γὰρ",702963,11],["οὐ",709805,28],["βούλεται",702795,117],["ὁ",709436,3],["κύριος",707996,4],["ἰδεῖν",709725,106],["αὐτὸς",702165,121],["γὰρ",702963,11],["ὁ",709436,3],["παντοκράτωρ",709986,4],["ὁρατής",709722,4],["ἐστιν",704093,91]],"For the Lord desires not to look on error, for he is the Almighty One."],["14",[["τῶν",709436,80],["συντελούντων",712510,170],["τὰ",709436,41],["ἄνομα",701194,68],["καὶ",707031,7],["σώσει",712627,127],["με",708618,163],["κρίθητι",707905,244],["δὲ",703303,11],["ἐναντίον",704654,0],["αὐτοῦ",702165,102],["εἰ",704071,7],["δύνασαι",703838,259],["αἰνέσαι",700459,106],["αὐτόν",702165,85],["ὡς",714148,7],["ἔστιν",704093,91]],"He beholds them that perform lawless deeds, and he will save me: and do thou plead before him, if thou canst praise him, as it is [possible] even now."],["15",[["καὶ",707031,7],["νῦν",709384,28],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐπισκεπτόμενος",705250,122],["ὀργὴν",709728,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ἔγνω",703105,2],["παραπτώματι",710095,54],["σφόδρα",712586,28]],"For he is not [now] regarding his wrath, nor has he noticed severely any trespass."],["16",[["καὶ",707031,7],["Ιωβ",706903,4],["ματαίως",708579,28],["ἀνοίγει",701186,91],["τὸ",709436,24],["στόμα",712125,25],["αὐτοῦ",702165,102],["ἐν",704639,0],["ἀγνωσίᾳ",700180,1],["ῥήματα",711246,42],["βαρύνει",702553,91]],"Yet Job vainly opens his mouth, in ignorance he multiplies words."]]