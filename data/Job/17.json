[["1",[["ὀλέκομαι",709565,254],["πνεύματι",710566,54],["φερόμενος",713428,122],["δέομαι",703394,254],["δὲ",703303,11],["ταφῆς",712736,17],["καὶ",707031,7],["οὐ",709805,28],["τυγχάνω",713015,157]],"I perish, carried away by the wind, and I seek for burial, and obtain [it] not."],["2",[["λίσσομαι",708219,254],["κάμνων",707115,72],["καὶ",707031,7],["τί",712867,126],["ποιήσας",710582,182]],"Weary I intreat; and what have I done? and strangers have stolen my goods."],["3",[["ἔκλεψαν",707715,150],["δέ",703303,11],["μου",709032,133],["τὰ",709436,41],["ὑπάρχοντα",713102,237],["ἀλλότριοι",700699,138],["τίς",712867,158],["ἐστιν",704093,91],["οὗτος",709858,121],["τῇ",709436,100],["χειρί",713787,1],["μου",709032,133],["συνδεθήτω",712417,22]],"Who is this? let him join hands with me."],["4",[["ὅτι",709803,7],["καρδίαν",707141,9],["αὐτῶν",702165,40],["ἔκρυψας",707923,162],["ἀπὸ",701425,0],["φρονήσεως",713588,17],["διὰ",703417,0],["τοῦτο",709858,129],["οὐ",709805,28],["μὴ",708851,28],["ὑψώσῃς",713289,175],["αὐτούς",702165,62]],"For thou hast hid their heart from wisdom; therefore thou shalt not exalt them."],["5",[["τῇ",709436,100],["μερίδι",708748,1],["ἀναγγελεῖ",700921,127],["κακίας",707054,39],["ὀφθαλμοὶ",709870,52],["δέ",703303,11],["μου",709032,133],["ἐφ᾿",705080,0],["υἱοῖς",713075,148],["ἐτάκησαν",712839,99]],"He shall promise mischief to [his] companions: but [their] eyes have failed for [their] children."],["6",[["ἔθου",712849,174],["δέ",703303,11],["με",708618,163],["θρύλημα",706318,25],["ἐν",704639,0],["ἔθνεσιν",704068,96],["γέλως",703032,4],["δὲ",703303,11],["αὐτοῖς",702165,151],["ἀπέβην",701426,155]],"But thou hast made me a byword among the nations, and I am become a scorn to them."],["7",[["πεπώρωνται",711119,408],["γὰρ",702963,11],["ἀπὸ",701425,0],["ὀργῆς",709728,17],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["μου",709032,133],["πεπολιόρκημαι",710608,584],["μεγάλως",708650,28],["ὑπὸ",713184,0],["πάντων",710177,169]],"For my eyes are dimmed through pain; I have been grievously beset by all."],["8",[["θαῦμα",706134,15],["ἔσχεν",705785,2],["ἀληθινοὺς",700659,60],["ἐπὶ",705080,0],["τούτῳ",709858,280],["δίκαιος",703694,14],["δὲ",703303,11],["ἐπὶ",705080,0],["παρανόμῳ",710080,30],["ἐπανασταίη",705026,225]],"Wonder has seized true men upon this; and let the just rise up against the transgressor."],["9",[["σχοίη",705785,225],["δὲ",703303,11],["πιστὸς",710486,14],["τὴν",709436,8],["ἑαυτοῦ",703917,102],["ὁδόν",709458,9],["καθαρὸς",706988,14],["δὲ",703303,11],["χεῖρας",713787,39],["ἀναλάβοι",700984,225],["θάρσος",706126,25]],"But let the faithful hold on his own way, and let him that is pure of hands take courage."],["10",[["οὐ",709805,28],["μὴν",708873,11],["δὲ",703303,11],["ἀλλὰ",700680,7],["πάντες",710177,138],["ἐρείδετε",705405,87],["καὶ",707031,7],["δεῦτε",703383,28],["δή",703395,11],["οὐ",709805,28],["γὰρ",702963,11],["εὑρίσκω",705676,157],["ἐν",704639,0],["ὑμῖν",713084,90],["ἀληθές",700658,46]],"Howbeit, do ye all strengthen [yourselves] and come now, for I do not find truth in you."],["11",[["αἱ",709436,190],["ἡμέραι",705984,191],["μου",709032,133],["παρῆλθον",710141,150],["ἐν",704639,0],["βρόμῳ",702814,114],["ἐρράγη",711243,37],["δὲ",703303,11],["τὰ",709436,63],["ἄρθρα",701736,64],["τῆς",709436,16],["καρδίας",707141,17],["μου",709032,133]],"My days have passed in groaning, and my heart-strings are broken."],["12",[["νύκτα",709386,9],["εἰς",704105,0],["ἡμέραν",705984,9],["ἔθηκαν",712849,150],["φῶς",713642,15],["ἐγγὺς",703948,28],["ἀπὸ",701425,0],["προσώπου",710986,21],["σκότους",711889,21]],"I have turned the night into day: the light is short because of darkness."],["13",[["ἐὰν",703912,7],["γὰρ",702963,11],["ὑπομείνω",713219,207],["ᾅδης",700255,4],["μου",709032,133],["ὁ",709436,3],["οἶκος",709516,4],["ἐν",704639,0],["δὲ",703303,11],["γνόφῳ",703131,114],["ἔστρωταί",712175,403],["μου",709032,133],["ἡ",709436,10],["στρωμνή",712174,12]],"For if I remain, Hades is my habitation: and my bed has been made in darkness."],["14",[["θάνατον",706096,6],["ἐπεκαλεσάμην",705153,161],["πατέρα",710189,6],["μου",709032,133],["εἶναι",704093,55],["μητέρα",708892,9],["δέ",703303,11],["μου",709032,133],["καὶ",707031,7],["ἀδελφὴν",700244,9],["σαπρίαν",711503,9]],"I have called upon death to be my father, and corruption [to be] my mother and sister."],["15",[["ποῦ",710706,28],["οὖν",709835,11],["μου",709032,133],["ἔτι",705538,28],["ἐστὶν",704093,91],["ἡ",709436,10],["ἐλπίς",704530,12],["ἦ",705925,28],["τὰ",709436,41],["ἀγαθά",700106,68],["μου",709032,133],["ὄψομαι",709725,181]],"Where then is yet my hope? or [where] shall I see my good?"],["16",[["ἦ",705925,28],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["εἰς",704105,0],["ᾅδην",700255,6],["καταβήσονται",707202,135],["ἢ",705924,7],["ὁμοθυμαδὸν",709624,28],["ἐπὶ",705080,0],["χώματος",714000,21],["καταβησόμεθα",707202,141]],"Will they go down with me to Hades, or shall we go down together to the tomb?"]]