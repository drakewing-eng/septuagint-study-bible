[["1",[["ἔτι",705538,28],["δὲ",703303,11],["προσθεὶς",710965,182],["Ιωβ",706903,4],["εἶπεν",705373,2],["τῷ",709436,53],["προοιμίῳ",710831,54]],"And Job continued and said in his parable,"],["2",[["τίς",712867,158],["ἄν",700900,11],["με",708618,163],["θείη",712849,225],["κατὰ",707200,0],["μῆνα",708874,6],["ἔμπροσθεν",704618,0],["ἡμερῶν",705984,65],["ὧν",709781,199],["με",708618,163],["ὁ",709436,3],["θεὸς",706192,4],["ἐφύλαξεν",713619,2]],"Oh that I were as in months past, wherein God preserved me!"],["3",[["ὡς",714148,7],["ὅτε",709802,28],["ηὔγει",702123,13],["ὁ",709436,3],["λύχνος",708287,4],["αὐτοῦ",702165,102],["ὑπὲρ",713111,0],["κεφαλῆς",707639,17],["μου",709032,133],["ὅτε",709802,28],["τῷ",709436,53],["φωτὶ",713642,54],["αὐτοῦ",702165,102],["ἐπορευόμην",710667,334],["ἐν",704639,0],["σκότει",711889,54]],"As when his lamp shone over my head; when by his light I walked through darkness."],["4",[["ὅτε",709802,28],["ἤμην",704093,334],["ἐπιβρίθων",705098,72],["ὁδοῖς",709458,76],["ὅτε",709802,28],["ὁ",709436,3],["θεὸς",706192,4],["ἐπισκοπὴν",705255,9],["ἐποιεῖτο",710582,19],["τοῦ",709436,35],["οἴκου",709516,18],["μου",709032,133]],"[As] when I steadfastly pursued my ways, when God took care of my house."],["5",[["ὅτε",709802,28],["ἤμην",704093,334],["ὑλώδης",713079,14],["λίαν",708184,28],["κύκλῳ",707959,114],["δέ",703303,11],["μου",709032,133],["οἱ",709436,136],["παῖδες",709932,52]],"When I was very fruitful, and my children were about me;"],["6",[["ὅτε",709802,28],["ἐχέοντό",713845,139],["μου",709032,133],["αἱ",709436,190],["ὁδοὶ",709458,191],["βουτύρῳ",702800,54],["τὰ",709436,63],["δὲ",703303,11],["ὄρη",709768,64],["μου",709032,133],["ἐχέοντο",713845,139],["γάλακτι",702919,54]],"when my ways were moistened with butter, and the mountains flowed for me with milk."],["7",[["ὅτε",709802,28],["ἐξεπορευόμην",704293,334],["ὄρθριος",709744,14],["ἐν",704639,0],["πόλει",710612,1],["ἐν",704639,0],["δὲ",703303,11],["πλατείαις",710509,291],["ἐτίθετό",712849,19],["μου",709032,133],["ὁ",709436,3],["δίφρος",703755,4]],"When I went forth early in the city, and the seat was placed for me in the streets."],["8",[["ἰδόντες",709725,196],["με",708618,163],["νεανίσκοι",709232,52],["ἐκρύβησαν",707923,99],["πρεσβῦται",710736,52],["δὲ",703303,11],["πάντες",710177,138],["ἔστησαν",706846,150]],"The young men saw me, and hid themselves: and all the old men stood up."],["9",[["ἁδροὶ",700292,138],["δὲ",703303,11],["ἐπαύσαντο",710202,189],["λαλοῦντες",708071,146],["δάκτυλον",703259,6],["ἐπιθέντες",705304,196],["ἐπὶ",705080,0],["στόματι",712125,54]],"And the great men ceased speaking, and laid their finger on their mouth."],["10",[["οἱ",709436,136],["δὲ",703303,11],["ἀκούσαντες",700587,196],["ἐμακάρισάν",708396,150],["με",708618,163],["καὶ",707031,7],["γλῶσσα",703120,12],["αὐτῶν",702165,40],["τῷ",709436,113],["λάρυγγι",708098,114],["αὐτῶν",702165,40],["ἐκολλήθη",707791,37]],"And they that heard [me] blessed me, and their tongue clave to their throat."],["11",[["ὅτι",709803,7],["οὖς",709852,15],["ἤκουσεν",700587,2],["καὶ",707031,7],["ἐμακάρισέν",708396,2],["με",708618,163],["ὀφθαλμὸς",709870,4],["δὲ",703303,11],["ἰδών",709725,182],["με",708618,163],["ἐξέκλινεν",704220,13]],"For the ear heard, and blessed me; and the eye saw me, and turned aside."],["12",[["διέσωσα",703599,155],["γὰρ",702963,11],["πτωχὸν",711076,6],["ἐκ",704132,0],["χειρὸς",713787,17],["δυνάστου",703844,18],["καὶ",707031,7],["ὀρφανῷ",709779,30],["ᾧ",709781,309],["οὐκ",709805,28],["ἦν",704093,13],["βοηθός",702748,4],["ἐβοήθησα",702746,155]],"For I saved the poor out of the hand of the oppressor, and helped the fatherless who had no helper."],["13",[["εὐλογία",705633,12],["ἀπολλυμένου",701513,262],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ἔλθοι",705453,225],["στόμα",712125,25],["δὲ",703303,11],["χήρας",713848,17],["με",708618,163],["εὐλόγησεν",705631,2]],"Let the blessing of the perishing one come upon me; yea, the mouth of the widow has blessed me."],["14",[["δικαιοσύνην",703695,9],["δὲ",703303,11],["ἐνεδεδύκειν",704701,499],["ἠμφιασάμην",700881,161],["δὲ",703303,11],["κρίμα",707903,25],["ἴσα",706832,28],["διπλοΐδι",703739,1]],"Also I put on righteousness, and clothed myself with judgment like a mantle."],["15",[["ὀφθαλμὸς",709870,4],["ἤμην",704093,334],["τυφλῶν",713031,169],["ποὺς",710707,4],["δὲ",703303,11],["χωλῶν",713999,169]],"I was the eye of the blind, and the foot of the lame."],["16",[["ἐγὼ",704018,164],["ἤμην",704093,334],["πατὴρ",710189,4],["ἀδυνάτων",700297,169],["δίκην",703702,9],["δέ",703303,11],["ἣν",709781,131],["οὐκ",709805,28],["ᾔδειν",709492,499],["ἐξιχνίασα",704941,155]],"I was the father of the helpless; and I searched out the cause which I knew not."],["17",[["συνέτριψα",712520,155],["δὲ",703303,11],["μύλας",709054,39],["ἀδίκων",700272,169],["ἐκ",704132,0],["δὲ",703303,11],["μέσου",708768,116],["τῶν",709436,80],["ὀδόντων",709461,81],["αὐτῶν",702165,40],["ἅρπαγμα",701803,25],["ἐξέσπασα",704311,155]],"And I broke the jaw-teeth of the unrighteous; I plucked the spoil out of the midst of their teeth."],["18",[["εἶπα",705373,155],["δέ",703303,11],["ἡ",709436,10],["ἡλικία",705971,12],["μου",709032,133],["γηράσει",703090,127],["ὥσπερ",714163,28],["στέλεχος",712062,15],["φοίνικος",713541,18],["πολὺν",710646,27],["χρόνον",713969,6],["βιώσω",702727,165]],"And I said, My age shall continue as the stem of a palm-tree; I shall live a long while."],["19",[["ἡ",709436,10],["ῥίζα",711260,12],["μου",709032,133],["διήνοικται",703532,187],["ἐπὶ",705080,0],["ὕδατος",713071,21],["καὶ",707031,7],["δρόσος",703835,12],["αὐλισθήσεται",702138,134],["ἐν",704639,0],["τῷ",709436,113],["θερισμῷ",706208,114],["μου",709032,133]],"[My] root was spread out by the water, and the dew would lodge on my crop."],["20",[["ἡ",709436,10],["δόξα",703791,12],["μου",709032,133],["καινὴ",707042,29],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["τὸ",709436,34],["τόξον",712898,15],["μου",709032,133],["ἐν",704639,0],["χειρὶ",713787,1],["αὐτοῦ",702165,102],["πορεύσεται",710667,93]],"My glory was fresh in me, and my bow prospered in his hand."],["21",[["ἐμοῦ",704580,133],["ἀκούσαντες",700587,196],["προσέσχον",710895,150],["ἐσιώπησαν",711818,150],["δὲ",703303,11],["ἐπὶ",705080,0],["τῇ",709436,100],["ἐμῇ",704578,101],["βουλῇ",702792,1]],"[Men] heard me, and gave heed, and they were silent at my counsel."],["22",[["ἐπὶ",705080,0],["δὲ",703303,11],["τῷ",709436,53],["ἐμῷ",704578,97],["ῥήματι",711246,54],["οὐ",709805,28],["προσέθεντο",710965,189],["περιχαρεῖς",710419,60],["δὲ",703303,11],["ἐγίνοντο",703104,139],["ὁπόταν",709708,7],["αὐτοῖς",702165,151],["ἐλάλουν",708071,333]],"At my word they spoke not again, and they were very glad whenever I spoke to them."],["23",[["ὥσπερ",714163,28],["γῆ",703083,12],["διψῶσα",703763,188],["προσδεχομένη",710874,211],["τὸν",709436,5],["ὑετόν",713074,6],["οὕτως",709859,28],["οὗτοι",709858,201],["τὴν",709436,8],["ἐμὴν",704578,36],["λαλιάν",708074,9]],"As the thirsty earth expecting the rain, so they [waited for] my speech."],["24",[["ἐὰν",703912,7],["γελάσω",703019,207],["πρὸς",710844,0],["αὐτούς",702165,62],["οὐ",709805,28],["μὴ",708851,28],["πιστεύσωσιν",710483,234],["καὶ",707031,7],["φῶς",713642,15],["τοῦ",709436,20],["προσώπου",710986,21],["μου",709032,133],["οὐκ",709805,28],["ἀπέπιπτεν",701546,13]],"Were I to laugh on them, they would not believe [it]; and the light of my face has not failed."],["25",[["ἐξελεξάμην",704236,161],["ὁδὸν",709458,9],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐκάθισα",707006,155],["ἄρχων",701862,4],["καὶ",707031,7],["κατεσκήνουν",707423,333],["ὡσεὶ",714159,28],["βασιλεὺς",702580,4],["ἐν",704639,0],["μονοζώνοις",708997,148],["ὃν",709781,112],["τρόπον",712980,6],["παθεινοὺς",709915,57],["παρακαλῶν",710039,72]],"I chose out their way, and sat chief, and dwelt as a king in the midst of warriors, as one comforting mourners."]]