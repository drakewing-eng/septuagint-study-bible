[["1",[["ἐπικάλεσαι",705153,300],["δέ",703303,11],["εἴ",704071,7],["τίς",712866,158],["σοι",711925,159],["ὑπακούσεται",713096,93],["ἢ",705924,7],["εἴ",704071,7],["τινα",712866,356],["ἀγγέλων",700140,81],["ἁγίων",700159,169],["ὄψῃ",709725,123]],"But call, if any one will hearken to thee, or if thou shalt see any of the holy angels."],["2",[["καὶ",707031,7],["γὰρ",702963,11],["ἄφρονα",702236,27],["ἀναιρεῖ",700962,91],["ὀργή",709728,12],["πεπλανημένον",710495,469],["δὲ",703303,11],["θανατοῖ",706097,91],["ζῆλος",705871,4]],"For wrath destroys the foolish one, and envy slays him that has gone astray."],["3",[["ἐγὼ",704018,164],["δὲ",703303,11],["ἑώρακα",709725,89],["ἄφρονας",702236,60],["ῥίζαν",711260,9],["βάλλοντας",702487,235],["ἀλλ᾿",700680,7],["εὐθέως",705593,28],["ἐβρώθη",702722,37],["αὐτῶν",702165,40],["ἡ",709436,10],["δίαιτα",703460,12]],"And I have seen foolish ones taking root: but suddenly their habitation was devoured."],["4",[["πόρρω",710680,28],["γένοιντο",703104,529],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["σωτηρίας",712658,17],["κολαβρισθείησαν",707785,393],["δὲ",703303,11],["ἐπὶ",705080,0],["θύραις",706337,76],["ἡσσόνων",706042,169],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ὁ",709436,3],["ἐξαιρούμενος",704838,122]],"Let their children be far from safety, and let them be crushed at the doors of vile men, and let there be no deliverer."],["5",[["ἃ",709781,69],["γὰρ",702963,11],["ἐκεῖνοι",704183,201],["συνήγαγον",712375,150],["δίκαιοι",703694,138],["ἔδονται",705495,135],["αὐτοὶ",702165,201],["δὲ",703303,11],["ἐκ",704132,0],["κακῶν",707066,83],["οὐκ",709805,28],["ἐξαίρετοι",704837,138],["ἔσονται",704093,135],["ἐκσιφωνισθείη",704309,528],["αὐτῶν",702165,40],["ἡ",709436,10],["ἰσχύς",706858,12]],"For what they have collected, the just shall eat; but they shall not be delivered out of calamities: let their strength be utterly exhausted."],["6",[["οὐ",709805,28],["γὰρ",702963,11],["μὴ",708851,28],["ἐξέλθῃ",704909,172],["ἐκ",704132,0],["τῆς",709436,16],["γῆς",703083,17],["κόπος",707825,4],["οὐδὲ",709816,7],["ἐξ",704132,0],["ὀρέων",709768,44],["ἀναβλαστήσει",700912,127],["πόνος",710661,4]],"For labour cannot by any means come out of the earth, nor shall trouble spring out of the mountains:"],["7",[["ἀλλὰ",700680,7],["ἄνθρωπος",701163,4],["γεννᾶται",703051,117],["κόπῳ",707825,114],["νεοσσοὶ",709257,52],["δὲ",703303,11],["γυπὸς",703212,18],["τὰ",709436,41],["ὑψηλὰ",713285,68],["πέτονται",710441,269]],"yet man is born to labour, and [even so] the vulture's young seek the high places."],["8",[["οὐ",709805,28],["μὴν",708873,11],["δὲ",703303,11],["ἀλλὰ",700680,7],["ἐγὼ",704018,164],["δεηθήσομαι",703394,180],["κυρίου",707996,18],["κύριον",707996,6],["δὲ",703303,11],["τὸν",709436,5],["πάντων",710177,169],["δεσπότην",703379,6],["ἐπικαλέσομαι",705153,181]],"Nevertheless I will beseech the Lord, and will call upon the Lord, the sovereign of all;"],["9",[["τὸν",709436,5],["ποιοῦντα",710582,183],["μεγάλα",708653,68],["καὶ",707031,7],["ἀνεξιχνίαστα",701129,68],["ἔνδοξά",704694,68],["τε",712751,11],["καὶ",707031,7],["ἐξαίσια",704840,68],["ὧν",709781,103],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀριθμός",701744,4]],"who does great things and untraceable, glorious things also, and marvellous, of which there is no number:"],["10",[["τὸν",709436,5],["διδόντα",703654,183],["ὑετὸν",713074,6],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["ἀποστέλλοντα",701592,183],["ὕδωρ",713071,25],["ἐπὶ",705080,0],["τὴν",709436,8],["ὑπ᾿",713184,0],["οὐρανόν",709844,6]],"who gives rain upon the earth, sending water on the earth:"],["11",[["τὸν",709436,5],["ποιοῦντα",710582,183],["ταπεινοὺς",712714,60],["εἰς",704105,0],["ὕψος",713288,25],["καὶ",707031,7],["ἀπολωλότας",701513,277],["ἐξεγείροντα",704889,183]],"who exalts the lowly, and raises up them that are lost:"],["12",[["διαλλάσσοντα",703502,183],["βουλὰς",702792,39],["πανούργων",709972,169],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ποιήσουσιν",710582,218],["αἱ",709436,190],["χεῖρες",713787,191],["αὐτῶν",702165,40],["ἀληθές",700658,46]],"frustrating the counsels of the crafty, and their hands shall not perform the truth:"],["13",[["ὁ",709436,3],["καταλαμβάνων",707300,72],["σοφοὺς",711985,60],["ἐν",704639,0],["τῇ",709436,100],["φρονήσει",713588,1],["βουλὴν",702792,9],["δὲ",703303,11],["πολυπλόκων",710643,169],["ἐξέστησεν",704940,2]],"who takes the wise in their wisdom, and subverts the counsel of the crafty."],["14",[["ἡμέρας",705984,17],["συναντήσεται",712394,93],["αὐτοῖς",702165,151],["σκότος",711889,15],["τὸ",709436,24],["δὲ",703303,11],["μεσημβρινὸν",708759,46],["ψηλαφήσαισαν",714047,396],["ἴσα",706832,28],["νυκτί",709386,1]],"In the day darkness shall come upon them, and let them grope in the noon-day even as in the night:"],["15",[["ἀπόλοιντο",701513,529],["δὲ",703303,11],["ἐν",704639,0],["πολέμῳ",710605,114],["ἀδύνατος",700297,14],["δὲ",703303,11],["ἐξέλθοι",704909,225],["ἐκ",704132,0],["χειρὸς",713787,17],["δυνάστου",703844,18]],"and let them perish in war, and let the weak escape from the hand of the mighty."],["16",[["εἴη",704093,301],["δὲ",703303,11],["ἀδυνάτῳ",700297,30],["ἐλπίς",704530,12],["ἀδίκου",700272,116],["δὲ",703303,11],["στόμα",712125,15],["ἐμφραχθείη",704635,528]],"And let the weak have hope, but the mouth of the unjust be stopped."],["17",[["μακάριος",708397,14],["δὲ",703303,11],["ἄνθρωπος",701163,4],["ὃν",709781,112],["ἤλεγξεν",704416,2],["ὁ",709436,3],["κύριος",707996,4],["νουθέτημα",709368,25],["δὲ",703303,11],["παντοκράτορος",709986,18],["μὴ",708851,28],["ἀπαναίνου",701342,253]],"But blessed [is] the man whom the Lord has reproved; and reject not thou the chastening of the Almighty."],["18",[["αὐτὸς",702165,121],["γὰρ",702963,11],["ἀλγεῖν",700638,55],["ποιεῖ",710582,91],["καὶ",707031,7],["πάλιν",709942,28],["ἀποκαθίστησιν",701470,91],["ἔπαισεν",709933,2],["καὶ",707031,7],["αἱ",709436,190],["χεῖρες",713787,191],["αὐτοῦ",702165,102],["ἰάσαντο",706424,189]],"For he causes [a man] to be in pain, and restores [him] again: he smites, and his hands heal."],["19",[["ἑξάκις",704843,28],["ἐξ",704132,0],["ἀναγκῶν",700925,65],["σε",711598,163],["ἐξελεῖται",704838,93],["ἐν",704639,0],["δὲ",703303,11],["τῷ",709436,113],["ἑβδόμῳ",703925,30],["οὐ",709805,28],["μὴ",708851,28],["ἅψηταί",701654,239],["σου",711945,133],["κακόν",707066,26]],"Six times he shall deliver thee out of distresses: and in the seventh harm shall not touch thee."],["20",[["ἐν",704639,0],["λιμῷ",708210,114],["ῥύσεταί",711309,93],["σε",711598,163],["ἐκ",704132,0],["θανάτου",706096,18],["ἐν",704639,0],["πολέμῳ",710605,114],["δὲ",703303,11],["ἐκ",704132,0],["χειρὸς",713787,17],["σιδήρου",711774,18],["λύσει",708288,127],["σε",711598,163]],"In famine he shall deliver thee from death: and in war he shall free thee from the power of the sword."],["21",[["ἀπὸ",701425,0],["μάστιγος",708568,17],["γλώσσης",703120,17],["σε",711598,163],["κρύψει",707923,127],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["φοβηθῇς",713532,279],["ἀπὸ",701425,0],["κακῶν",707066,83],["ἐρχομένων",705453,369]],"He shall hide thee from the scourge of the tongue: and thou shalt not be afraid of coming evils."],["22",[["ἀδίκων",700272,169],["καὶ",707031,7],["ἀνόμων",701194,169],["καταγελάσῃ",707222,123],["ἀπὸ",701425,0],["δὲ",703303,11],["θηρίων",706252,44],["ἀγρίων",700191,83],["οὐ",709805,28],["μὴ",708851,28],["φοβηθῇς",713532,279]],"Thou shalt laugh at the unrighteous and the lawless: and thou shalt not be afraid of wild beasts."],["23",[["θῆρες",706243,52],["γὰρ",702963,11],["ἄγριοι",700191,138],["εἰρηνεύσουσίν",704097,218],["σοι",711925,159]],"For the wild beasts of the field shall be at peace with thee."],["24",[["εἶτα",704129,28],["γνώσῃ",703105,123],["ὅτι",709803,7],["εἰρηνεύσει",704097,127],["σου",711945,133],["ὁ",709436,3],["οἶκος",709516,4],["ἡ",709436,10],["δὲ",703303,11],["δίαιτα",703460,12],["τῆς",709436,16],["σκηνῆς",711845,17],["σου",711945,133],["οὐ",709805,28],["μὴ",708851,28],["ἁμάρτῃ",700773,172]],"Then shalt thou know that thy house shall be at peace, and the provision for thy tabernacle shall not fail."],["25",[["γνώσῃ",703105,123],["δὲ",703303,11],["ὅτι",709803,7],["πολὺ",710646,26],["τὸ",709436,34],["σπέρμα",712008,15],["σου",711945,133],["τὰ",709436,63],["δὲ",703303,11],["τέκνα",712761,64],["σου",711945,133],["ἔσται",704093,93],["ὥσπερ",714163,28],["τὸ",709436,34],["παμβότανον",709947,15],["τοῦ",709436,35],["ἀγροῦ",700196,18]],"And thou shalt know that thy seed [shall be] abundant; and thy children shall be like the herbage of the field."],["26",[["ἐλεύσῃ",705453,123],["δὲ",703303,11],["ἐν",704639,0],["τάφῳ",712738,114],["ὥσπερ",714163,28],["σῖτος",711814,4],["ὥριμος",714139,26],["κατὰ",707200,0],["καιρὸν",707047,6],["θεριζόμενος",706206,466],["ἢ",705924,7],["ὥσπερ",714163,28],["θιμωνιὰ",706266,12],["ἅλωνος",700741,17],["καθ᾿",707200,0],["ὥραν",714128,9],["συγκομισθεῖσα",712229,307]],"And thou shalt come to the grave like ripe corn reaped in its season, or as a heap of the corn-flour collected in proper time."],["27",[["ἰδοὺ",706497,88],["ταῦτα",709858,71],["οὕτως",709859,28],["ἐξιχνιάσαμεν",704941,289],["ταῦτά",709858,71],["ἐστιν",704093,91],["ἃ",709781,69],["ἀκηκόαμεν",700587,314],["σὺ",712181,164],["δὲ",703303,11],["γνῶθι",703105,176],["σεαυτῷ",711599,50],["εἴ",704071,7],["τι",712866,126],["ἔπραξας",710721,162]],"Behold, we have thus sought out these matters; these are what we have heard: but do thou reflect with thyself, if thou hast done anything [wrong]."]]