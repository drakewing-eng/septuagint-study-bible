[["1",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Ελιφας",704499,4],["ὁ",709436,3],["Θαιμανίτης",706063,4],["λέγει",708124,91]],"Then Eliphaz the Thæmanite answered and said,"],["2",[["μὴ",708851,28],["πολλάκις",710617,28],["σοι",711925,159],["λελάληται",708071,187],["ἐν",704639,0],["κόπῳ",707825,114],["ἰσχὺν",706858,9],["δὲ",703303,11],["ῥημάτων",711246,44],["σου",711945,133],["τίς",712867,158],["ὑποίσει",713256,127]],"Hast thou been often spoken to in distress? but who shall endure the force of thy words?"],["3",[["εἰ",704071,7],["γὰρ",702963,11],["σὺ",712181,164],["ἐνουθέτησας",709367,162],["πολλοὺς",710646,60],["καὶ",707031,7],["χεῖρας",713787,39],["ἀσθενοῦς",701939,119],["παρεκάλεσας",710039,162]],"For whereas thou hast instructed many, and hast strengthened the hands of the weak one,"],["4",[["ἀσθενοῦντάς",701938,235],["τε",712751,11],["ἐξανέστησας",704865,162],["ῥήμασιν",711246,96],["γόνασίν",703172,96],["τε",712751,11],["ἀδυνατοῦσιν",700296,358],["θάρσος",706126,25],["περιέθηκας",710403,162]],"and hast supported the failing with words, and hast imparted courage to feeble knees."],["5",[["νῦν",709384,28],["δὲ",703303,11],["ἥκει",705956,91],["ἐπὶ",705080,0],["σὲ",711598,163],["πόνος",710661,4],["καὶ",707031,7],["ἥψατό",701654,23],["σου",711945,133],["σὺ",712181,164],["δὲ",703303,11],["ἐσπούδασας",712031,162]],"Yet now [that] pain has come upon thee, and touched thee, thou art troubled."],["6",[["πότερον",710697,28],["οὐχ",709805,28],["ὁ",709436,3],["φόβος",713534,4],["σού",711945,133],["ἐστιν",704093,91],["ἐν",704639,0],["ἀφροσύνῃ",702235,1],["καὶ",707031,7],["ἡ",709436,10],["ἐλπίς",704530,12],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["ἀκακία",700511,12],["τῆς",709436,16],["ὁδοῦ",709458,17],["σου",711945,133]],"Is not thy fear [founded] in folly, thy hope also, and the mischief of thy way?"],["7",[["μνήσθητι",708960,244],["οὖν",709835,11],["τίς",712867,158],["καθαρὸς",706988,14],["ὢν",704093,72],["ἀπώλετο",701513,23],["ἢ",705924,7],["πότε",710696,28],["ἀληθινοὶ",700659,138],["ὁλόρριζοι",709596,138],["ἀπώλοντο",701513,189]],"Remember then who has perished, being pure? or when were the true-hearted utterly destroyed?"],["8",[["καθ᾿",707200,0],["ὃν",709781,112],["τρόπον",712980,6],["εἶδον",709725,155],["τοὺς",709436,58],["ἀροτριῶντας",701791,235],["τὰ",709436,41],["ἄτοπα",702102,68],["οἱ",709436,136],["δὲ",703303,11],["σπείροντες",712006,146],["αὐτὰ",702165,71],["ὀδύνας",709463,39],["θεριοῦσιν",706206,218],["ἑαυτοῖς",703917,151]],"Accordingly as I have seen men ploughing barren places, and they that sow them will reap sorrows for themselves."],["9",[["ἀπὸ",701425,0],["προστάγματος",710959,21],["κυρίου",707996,18],["ἀπολοῦνται",701513,135],["ἀπὸ",701425,0],["δὲ",703303,11],["πνεύματος",710566,21],["ὀργῆς",709728,17],["αὐτοῦ",702165,102],["ἀφανισθήσονται",702182,144]],"They shall perish by the command of the Lord, and shall be utterly consumed by the breath of his wrath."],["10",[["σθένος",711760,15],["λέοντος",708171,18],["φωνὴ",713640,12],["δὲ",703303,11],["λεαίνης",708117,17],["γαυρίαμα",702981,15],["δὲ",703303,11],["δρακόντων",703822,81],["ἐσβέσθη",711596,37]],"The strength of the lion, and the voice of the lioness, and the exulting cry of serpents are quenched."],["11",[["μυρμηκολέων",709069,4],["ὤλετο",709584,23],["παρὰ",709995,0],["τὸ",709436,24],["μὴ",708851,28],["ἔχειν",705785,55],["βοράν",702762,9],["σκύμνοι",711903,52],["δὲ",703303,11],["λεόντων",708171,81],["ἔλιπον",708131,150],["ἀλλήλους",700689,62]],"The old lion has perished for want of food, and the lions' whelps have forsaken one another."],["12",[["εἰ",704071,7],["δέ",703303,11],["τι",712866,273],["ῥῆμα",711246,15],["ἀληθινὸν",700659,26],["ἐγεγόνει",703104,143],["ἐν",704639,0],["λόγοις",708236,148],["σου",711945,133],["οὐθὲν",709817,26],["ἄν",700900,11],["σοι",711925,159],["τούτων",709858,70],["κακὸν",707066,26],["ἀπήντησεν",701345,2],["πότερον",710697,28],["οὐ",709805,28],["δέξεταί",703393,93],["μου",709032,133],["τὸ",709436,34],["οὖς",709852,15],["ἐξαίσια",704841,68],["παρ᾿",709995,0],["αὐτοῦ",702165,102]],"But if there had been any truth in thy words, none of these evils would have befallen thee. Shall not mine ear receive excellent [revelations] from him?"],["13",[["φόβοι",713534,52],["δὲ",703303,11],["καὶ",707031,7],["ἠχὼ",706047,12],["νυκτερινή",709375,29],["ἐπιπίπτων",705225,72],["φόβος",713534,4],["ἐπ᾿",705080,0],["ἀνθρώπους",701163,57]],"But [as when] terror falls upon men, with dread and a sound in the night,"],["14",[["φρίκη",713580,12],["δέ",703303,11],["μοι",708974,159],["συνήντησεν",712394,2],["καὶ",707031,7],["τρόμος",712975,4],["καὶ",707031,7],["μεγάλως",708650,28],["μου",709032,133],["τὰ",709436,63],["ὀστᾶ",709792,64],["συνέσεισεν",712554,2]],"horror and trembling seized me, and caused all my bones greatly to shake."],["15",[["καὶ",707031,7],["πνεῦμα",710566,15],["ἐπὶ",705080,0],["πρόσωπόν",710986,25],["μου",709032,133],["ἐπῆλθεν",705068,2],["ἔφριξαν",713585,150],["δέ",703303,11],["μου",709032,133],["τρίχες",706312,191],["καὶ",707031,7],["σάρκες",711537,191]],"And a spirit came before my face; and my hair and flesh quivered."],["16",[["ἀνέστην",701173,155],["καὶ",707031,7],["οὐκ",709805,28],["ἐπέγνων",705104,155],["εἶδον",709725,155],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["μορφὴ",709018,12],["πρὸ",710747,0],["ὀφθαλμῶν",709870,81],["μου",709032,133],["ἀλλ᾿",700680,7],["ἢ",705924,7],["αὔραν",702146,9],["καὶ",707031,7],["φωνὴν",713640,9],["ἤκουον",700587,333]],"I arose and perceived it not: I looked, and there was no form before my eyes: but I only heard a breath and a voice, [saying],"],["17",[["τί",712867,273],["γάρ",702963,11],["μὴ",708851,28],["καθαρὸς",706988,14],["ἔσται",704093,93],["βροτὸς",702817,4],["ἐναντίον",704654,0],["κυρίου",707996,18],["ἢ",705924,7],["ἀπὸ",701425,0],["τῶν",709436,43],["ἔργων",705396,44],["αὐτοῦ",702165,102],["ἄμεμπτος",700807,14],["ἀνήρ",701150,4]],"What, shall a mortal be pure before the Lord? or a man be blameless in regard to his works?"],["18",[["εἰ",704071,7],["κατὰ",707200,0],["παίδων",709932,81],["αὐτοῦ",702165,102],["οὐ",709805,28],["πιστεύει",710483,91],["κατὰ",707200,0],["δὲ",703303,11],["ἀγγέλων",700140,81],["αὐτοῦ",702165,102],["σκολιόν",711868,46],["τι",712866,126],["ἐπενόησεν",705214,2]],"Whereas he trusts not in his servants, and perceives perverseness in his angels."],["19",[["τοὺς",709436,58],["δὲ",703303,11],["κατοικοῦντας",707534,235],["οἰκίας",709505,39],["πηλίνας",710456,119],["ἐξ",704132,0],["ὧν",709781,252],["καὶ",707031,7],["αὐτοὶ",702165,201],["ἐκ",704132,0],["τοῦ",709436,35],["αὐτοῦ",702165,102],["πηλοῦ",710457,18],["ἐσμεν",704093,243],["ἔπαισεν",709933,2],["αὐτοὺς",702165,62],["σητὸς",711756,18],["τρόπον",712980,6]],"But [as for] them that dwell in houses of clay, of whom we also are formed of the same clay, he smites them like a moth."],["20",[["καὶ",707031,7],["ἀπὸ",701425,0],["πρωίθεν",711022,28],["ἕως",705792,0],["ἑσπέρας",705500,17],["οὐκέτι",709827,28],["εἰσίν",704093,197],["παρὰ",709995,0],["τὸ",709436,24],["μὴ",708851,28],["δύνασθαι",703838,110],["αὐτοὺς",702165,62],["ἑαυτοῖς",703917,151],["βοηθῆσαι",702746,106],["ἀπώλοντο",701513,189]],"And from morning to evening they no longer exist: they have perished, because they cannot help themselves."],["21",[["ἐνεφύσησεν",704636,2],["γὰρ",702963,11],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἐξηράνθησαν",709419,99],["ἀπώλοντο",701513,189],["παρὰ",709995,0],["τὸ",709436,24],["μὴ",708851,28],["ἔχειν",705785,55],["αὐτοὺς",702165,62],["σοφίαν",711981,9]],"For he blows upon them, and they are withered: they have perished for lack of wisdom."]]