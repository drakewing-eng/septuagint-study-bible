[["1",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Ελιφας",704499,4],["ὁ",709436,3],["Θαιμανίτης",706063,4],["λέγει",708124,91]],"Then Eliphaz the Thæmanite answered and said,"],["2",[["πότερον",710697,28],["οὐχὶ",709862,28],["ὁ",709436,3],["κύριός",707996,4],["ἐστιν",704093,91],["ὁ",709436,3],["διδάσκων",703649,72],["σύνεσιν",712460,9],["καὶ",707031,7],["ἐπιστήμην",705267,9]],"Is it not the Lord that teaches understanding and knowledge?"],["3",[["τί",712867,273],["γὰρ",702963,11],["μέλει",708696,91],["τῷ",709436,113],["κυρίῳ",707996,114],["ἐὰν",703912,7],["σὺ",712181,164],["ἦσθα",704093,363],["τοῖς",709436,95],["ἔργοις",705396,96],["ἄμεμπτος",700807,14],["ἢ",705924,7],["ὠφέλεια",714170,12],["ὅτι",709803,7],["ἁπλώσῃς",701422,175],["τὴν",709436,8],["ὁδόν",709458,9],["σου",711945,133]],"For what matters it to the Lord, if thou wert blameless in [thy] works? or is it profitable that thou shouldest perfect thy way?"],["4",[["ἦ",705925,28],["λόγον",708236,6],["σου",711945,133],["ποιούμενος",710582,122],["ἐλέγξει",704416,127],["σε",711598,163],["καὶ",707031,7],["συνεισελεύσεταί",712437,93],["σοι",711925,159],["εἰς",704105,0],["κρίσιν",707908,9]],"Wilt thou maintain and plead thine own cause? and will he enter into judgment with thee?"],["5",[["πότερον",710697,28],["οὐχ",709805,28],["ἡ",709436,10],["κακία",707054,12],["σού",711945,133],["ἐστιν",704093,91],["πολλή",710646,29],["ἀναρίθμητοι",701047,192],["δέ",703303,11],["σού",711945,133],["εἰσιν",704093,197],["αἱ",709436,190],["ἁμαρτίαι",700775,191]],"Is not thy wickedness abundant, and thy sins innumerable?"],["6",[["ἠνεχύραζες",704722,363],["δὲ",703303,11],["τοὺς",709436,58],["ἀδελφούς",700249,57],["σου",711945,133],["διὰ",703417,0],["κενῆς",707612,82],["ἀμφίασιν",700882,6],["δὲ",703303,11],["γυμνῶν",703202,169],["ἀφείλου",702177,174]],"And thou hast taken security of thy brethren for nothing, and hast taken away the clothing of the naked."],["7",[["οὐδὲ",709816,7],["ὕδωρ",713071,15],["διψῶντας",703763,235],["ἐπότισας",710700,162],["ἀλλὰ",700680,7],["πεινώντων",710222,170],["ἐστέρησας",712076,162],["ψωμόν",714078,6]],"Neither hast thou given water to the thirsty to drink, but hast taken away the morsel of the hungry."],["8",[["ἐθαύμασας",706135,162],["δέ",703303,11],["τινων",712866,754],["πρόσωπον",710986,25],["ᾤκισας",709507,162],["δὲ",703303,11],["τοὺς",709436,58],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"And thou hast accepted the persons of some; and thou hast established those [that were already settled] on the earth."],["9",[["χήρας",713848,39],["δὲ",703303,11],["ἐξαπέστειλας",704872,162],["κενάς",707612,119],["ὀρφανοὺς",709779,60],["δὲ",703303,11],["ἐκάκωσας",707073,162]],"But thou hast sent widows away empty, and hast afflicted orphans."],["10",[["τοιγαροῦν",712874,7],["ἐκύκλωσάν",707958,150],["σε",711598,163],["παγίδες",709910,191],["καὶ",707031,7],["ἐσπούδασέν",712031,2],["σε",711598,163],["πόλεμος",710605,4],["ἐξαίσιος",704840,14]],"Therefore snares have compassed thee, and disastrous war has troubled thee."],["11",[["τὸ",709436,34],["φῶς",713642,15],["σοι",711925,159],["σκότος",711889,25],["ἀπέβη",701426,2],["κοιμηθέντα",707767,260],["δὲ",703303,11],["ὕδωρ",713071,15],["σε",711598,163],["ἐκάλυψεν",707102,2]],"The light has proved darkness to thee, and water has covered thee on thy lying down."],["12",[["μὴ",708851,28],["οὐχὶ",709862,28],["ὁ",709436,3],["τὰ",709436,41],["ὑψηλὰ",713285,68],["ναίων",709177,72],["ἐφορᾷ",705057,91],["τοὺς",709436,58],["δὲ",703303,11],["ὕβρει",713051,1],["φερομένους",713428,236],["ἐταπείνωσεν",712717,2]],"Does not he that dwells in the high places observe? and has he not brought down the proud?"],["13",[["καὶ",707031,7],["εἶπας",705373,162],["τί",712867,126],["ἔγνω",703105,2],["ὁ",709436,3],["ἰσχυρός",706855,14],["ἦ",705925,28],["κατὰ",707200,0],["τοῦ",709436,35],["γνόφου",703131,18],["κρινεῖ",707905,127]],"And thou hast said, What does the Mighty One know? does he judge in the dark?"],["14",[["νέφη",709281,64],["ἀποκρυφὴ",701496,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐχ",709805,28],["ὁραθήσεται",709725,134],["καὶ",707031,7],["γῦρον",703210,6],["οὐρανοῦ",709844,18],["διαπορεύσεται",703551,93]],"A cloud is his hiding-place, and he shall not be seen; and he passes through the circle of heaven."],["15",[["μὴ",708851,28],["τρίβον",712939,9],["αἰώνιον",700505,36],["φυλάξεις",713619,166],["ἣν",709781,131],["ἐπάτησαν",710187,150],["ἄνδρες",701150,52],["ἄδικοι",700272,138]],"Wilt thou [not] mark the old way, which righteous men have trodden?"],["16",[["οἳ",709781,250],["συνελήμφθησαν",712262,99],["ἄωροι",702329,138],["ποταμὸς",710693,4],["ἐπιρρέων",705236,72],["οἱ",709436,136],["θεμέλιοι",706181,52],["αὐτῶν",702165,40]],"who were seized before their time: their foundations [are as] an overflowing stream."],["17",[["οἱ",709436,136],["λέγοντες",708124,146],["κύριος",707996,4],["τί",712867,126],["ποιήσει",710582,127],["ἡμῖν",705994,90],["ἢ",705924,7],["τί",712867,126],["ἐπάξεται",704994,93],["ἡμῖν",705994,90],["ὁ",709436,3],["παντοκράτωρ",709986,4]],"Who say, What will the Lord do to us? or what will the Almighty bring upon us?"],["18",[["ὃς",709781,213],["δὲ",703303,11],["ἐνέπλησεν",704592,2],["τοὺς",709436,58],["οἴκους",709516,57],["αὐτῶν",702165,40],["ἀγαθῶν",700106,169],["βουλὴ",702792,12],["δὲ",703303,11],["ἀσεβῶν",701909,169],["πόρρω",710680,28],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102]],"Yet he filled their houses with good things: but the counsel of the wicked is far from him."],["19",[["ἰδόντες",709725,196],["δίκαιοι",703694,138],["ἐγέλασαν",703019,150],["ἄμεμπτος",700807,14],["δὲ",703303,11],["ἐμυκτήρισεν",709052,2]],"The righteous have seen [it], and laughed, and the blameless one has derided [them]."],["20",[["εἰ",704071,7],["μὴ",708851,28],["ἠφανίσθη",702182,37],["ἡ",709436,10],["ὑπόστασις",713241,12],["αὐτῶν",702165,40],["καὶ",707031,7],["τὸ",709436,24],["κατάλειμμα",707304,25],["αὐτῶν",702165,40],["καταφάγεται",707519,93],["πῦρ",711088,15]],"Verily their substance has been utterly destroyed, and the fire shall devour what is left of their [property]."],["21",[["γενοῦ",703104,300],["δὴ",703395,11],["σκληρός",711861,14],["ἐὰν",703912,7],["ὑπομείνῃς",713219,175],["εἶτ᾿",704129,28],["ὁ",709436,3],["καρπός",707169,4],["σου",711945,133],["ἔσται",704093,93],["ἐν",704639,0],["ἀγαθοῖς",700106,230]],"Be firm, I pray thee, if thou canst endure; then thy fruit shall prosper."],["22",[["ἔκλαβε",704231,176],["δὲ",703303,11],["ἐκ",704132,0],["στόματος",712125,21],["αὐτοῦ",702165,102],["ἐξηγορίαν",704921,9],["καὶ",707031,7],["ἀνάλαβε",700984,176],["τὰ",709436,41],["ῥήματα",711246,42],["αὐτοῦ",702165,102],["ἐν",704639,0],["καρδίᾳ",707141,1],["σου",711945,133]],"And receive a declaration from his mouth, and lay up his words in thine heart."],["23",[["ἐὰν",703912,7],["δὲ",703303,11],["ἐπιστραφῇς",705278,279],["καὶ",707031,7],["ταπεινώσῃς",712717,175],["σεαυτὸν",711599,85],["ἔναντι",704653,0],["κυρίου",707996,18],["πόρρω",710680,28],["ἐποίησας",710582,162],["ἀπὸ",701425,0],["διαίτης",703460,17],["σου",711945,133],["τὸ",709436,24],["ἄδικον",700272,46]],"And if thou shalt turn and humble thyself before the Lord, thou hast [thus] removed unrighteousness far from thy habitation."],["24",[["θήσῃ",712849,364],["ἐπὶ",705080,0],["χώματι",714000,54],["ἐν",704639,0],["πέτρᾳ",710443,1],["καὶ",707031,7],["ὡς",714148,7],["πέτρᾳ",710443,1],["χειμάρρους",713783,6],["Ωφιρ",714173,18]],"Thou shalt lay up for thyself [treasure] in a heap on the rock; and Sophir [shall be] as the rock of the torrent."],["25",[["ἔσται",704093,93],["οὖν",709835,11],["σου",711945,133],["ὁ",709436,3],["παντοκράτωρ",709986,4],["βοηθὸς",702748,4],["ἀπὸ",701425,0],["ἐχθρῶν",705779,81],["καθαρὸν",706988,27],["δὲ",703303,11],["ἀποδώσει",701449,127],["σε",711598,163],["ὥσπερ",714163,28],["ἀργύριον",701707,25],["πεπυρωμένον",711103,448]],"So the Almighty shall be thy helper from enemies, and he shall bring thee forth pure as silver that has been tried by fire."],["26",[["εἶτα",704129,28],["παρρησιασθήσῃ",710174,364],["ἔναντι",704653,0],["κυρίου",707996,18],["ἀναβλέψας",700913,182],["εἰς",704105,0],["τὸν",709436,5],["οὐρανὸν",709844,6],["ἱλαρῶς",706727,28]],"Then shalt thou have boldness before the Lord, looking up cheerfully to heaven."],["27",[["εὐξαμένου",705727,292],["δέ",703303,11],["σου",711945,133],["πρὸς",710844,0],["αὐτὸν",702165,85],["εἰσακούσεταί",704108,93],["σου",711945,133],["δώσει",703654,127],["δέ",703303,11],["σοι",711925,159],["ἀποδοῦναι",701449,106],["τὰς",709436,38],["εὐχάς",705726,39]],"And he shall hear thee when thou prayest to him, and he shall grant thee [power] to pay thy vows."],["28",[["ἀποκαταστήσει",701470,127],["δέ",703303,11],["σοι",711925,159],["δίαιταν",703460,9],["δικαιοσύνης",703695,17],["ἐπὶ",705080,0],["δὲ",703303,11],["ὁδοῖς",709458,76],["σου",711945,133],["ἔσται",704093,93],["φέγγος",713404,15]],"And he shall establish to thee again a habitation of righteousness and there shall be light upon thy paths."],["29",[["ὅτι",709803,7],["ἐταπείνωσεν",712717,2],["αὐτόν",702165,85],["καὶ",707031,7],["ἐρεῖς",705415,166],["ὑπερηφανεύσατο",713136,23],["καὶ",707031,7],["κύφοντα",708001,183],["ὀφθαλμοῖς",709870,148],["σώσει",712627,127]],"Because thou hast humbled thyself; and thou shalt say, [Man] has behaved proudly, but he shall save him that is of lowly eyes."],["30",[["ῥύσεται",711309,93],["ἀθῷον",700390,27],["καὶ",707031,7],["διασώθητι",703599,244],["ἐν",704639,0],["καθαραῖς",706988,291],["χερσίν",713787,76],["σου",711945,133]],"He shall deliver the innocent, and do thou save thyself by thy pure hands."]]