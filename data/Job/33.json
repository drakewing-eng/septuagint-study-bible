[["1",[["οὐ",709805,28],["μὴν",708873,11],["δὲ",703303,11],["ἀλλὰ",700680,7],["ἄκουσον",700587,176],["Ιωβ",706903,4],["τὰ",709436,41],["ῥήματά",711246,42],["μου",709032,133],["καὶ",707031,7],["λαλιὰν",708074,9],["ἐνωτίζου",704825,253],["μου",709032,133]],"Howbeit hear, Job, my words, and hearken to my speech."],["2",[["ἰδοὺ",706497,88],["γὰρ",702963,11],["ἤνοιξα",701186,155],["τὸ",709436,24],["στόμα",712125,25],["μου",709032,133],["καὶ",707031,7],["ἐλάλησεν",708071,2],["ἡ",709436,10],["γλῶσσά",703120,12],["μου",709032,133]],"For behold, I have opened my mouth, and my tongue has spoken."],["3",[["καθαρά",706988,29],["μου",709032,133],["ἡ",709436,10],["καρδία",707141,12],["ῥήμασιν",711246,96],["σύνεσις",712460,12],["δὲ",703303,11],["χειλέων",713781,44],["μου",709032,133],["καθαρὰ",706988,29],["νοήσει",709327,127]],"My heart [shall be found] pure by [my] words; and the understanding of my lips shall meditate purity."],["4",[["πνεῦμα",710566,15],["θεῖον",706154,26],["τὸ",709436,34],["ποιῆσάν",710582,293],["με",708618,163],["πνοὴ",710574,12],["δὲ",703303,11],["παντοκράτορος",709986,18],["ἡ",709436,10],["διδάσκουσά",703649,188],["με",708618,163]],"The Divine Spirit is that which formed me, and the breath of the Almighty that which teaches me."],["5",[["ἐὰν",703912,7],["δύνῃ",703838,278],["δός",703654,176],["μοι",708974,159],["ἀπόκρισιν",701493,9],["πρὸς",710844,0],["ταῦτα",709858,71],["ὑπόμεινον",713219,176],["στῆθι",706846,176],["κατ᾿",707200,0],["ἐμὲ",704555,163],["καὶ",707031,7],["ἐγὼ",704018,164],["κατὰ",707200,0],["σέ",711598,163]],"If thou canst, give me an answer: wait therefore; stand against me, and I [will stand] against thee."],["6",[["ἐκ",704132,0],["πηλοῦ",710457,18],["διήρτισαι",703570,332],["σὺ",712181,164],["ὡς",714148,7],["καὶ",707031,7],["ἐγώ",704018,164],["ἐκ",704132,0],["τοῦ",709436,35],["αὐτοῦ",702165,102],["διηρτίσμεθα",703570,580]],"Thou art formed out of the clay as also I: we have been formed out of the same [substance]."],["7",[["οὐχ",709805,28],["ὁ",709436,3],["φόβος",713534,4],["μού",709032,133],["σε",711598,163],["στροβήσει",712163,127],["οὐδὲ",709816,7],["ἡ",709436,10],["χείρ",713787,12],["μου",709032,133],["βαρεῖα",702554,29],["ἔσται",704093,93],["ἐπὶ",705080,0],["σοί",711925,159]],"My fear shall not terrify thee, neither shall my hand be heavy upon thee."],["8",[["πλὴν",710540,28],["εἶπας",705373,162],["ἐν",704639,0],["ὠσίν",709852,96],["μου",709032,133],["φωνὴν",713640,9],["ῥημάτων",711246,44],["σου",711945,133],["ἀκήκοα",700587,89]],"But thou hast said in mine ears, (I have heard the voice of thy words;) because thou sayest, I am pure, not having sinned;"],["9",[["διότι",703734,7],["λέγεις",708124,154],["καθαρός",706988,14],["εἰμι",704093,157],["οὐχ",709805,28],["ἁμαρτών",700773,182],["ἄμεμπτος",700807,14],["δέ",703303,11],["εἰμι",704093,157],["οὐ",709805,28],["γὰρ",702963,11],["ἠνόμησα",701190,155]],"I am blameless, for I have not transgressed."],["10",[["μέμψιν",708729,9],["δὲ",703303,11],["κατ᾿",707200,0],["ἐμοῦ",704580,133],["εὗρεν",705676,2],["ἥγηται",705931,187],["δέ",703303,11],["με",708618,163],["ὥσπερ",714163,28],["ὑπεναντίον",713109,27]],"Yet he has discovered a charge against me, and he has reckoned me as an adversary."],["11",[["ἔθετο",712849,23],["δὲ",703303,11],["ἐν",704639,0],["ξύλῳ",709427,54],["τὸν",709436,5],["πόδα",710707,6],["μου",709032,133],["ἐφύλαξεν",713619,2],["δέ",703303,11],["μου",709032,133],["πάσας",710177,119],["τὰς",709436,38],["ὁδούς",709458,39]],"And he has put my foot in the stocks, and has watched all my ways."],["12",[["πῶς",711121,28],["γὰρ",702963,11],["λέγεις",708124,154],["δίκαιός",703694,14],["εἰμι",704093,157],["καὶ",707031,7],["οὐκ",709805,28],["ἐπακήκοέν",705009,171],["μου",709032,133],["αἰώνιος",700505,14],["γάρ",702963,11],["ἐστιν",704093,91],["ὁ",709436,3],["ἐπάνω",705030,28],["βροτῶν",702817,81]],"For how sayest thou, I am righteous, yet he has not hearkened to me? for he that is above mortals is eternal."],["13",[["λέγεις",708124,154],["δέ",703303,11],["διὰ",703417,0],["τί",712867,126],["τῆς",709436,16],["δίκης",703702,17],["μου",709032,133],["οὐκ",709805,28],["ἐπακήκοεν",705009,171],["πᾶν",710177,46],["ῥῆμα",711246,25]],"But thou sayest, Why has he not heard every word of my cause?"],["14",[["ἐν",704639,0],["γὰρ",702963,11],["τῷ",709436,53],["ἅπαξ",701350,28],["λαλήσαι",708071,106],["ὁ",709436,3],["κύριος",707996,4],["ἐν",704639,0],["δὲ",703303,11],["τῷ",709436,53],["δευτέρῳ",703389,97],["ἐνύπνιον",704818,25]],"For when the Lord speaks once, or a second time,"],["15",[["ἢ",705924,7],["ἐν",704639,0],["μελέτῃ",708699,1],["νυκτερινῇ",709375,101],["ὡς",714148,7],["ὅταν",709801,28],["ἐπιπίπτῃ",705225,204],["δεινὸς",703328,14],["φόβος",713534,4],["ἐπ᾿",705080,0],["ἀνθρώπους",701163,57],["ἐπὶ",705080,0],["νυσταγμάτων",709388,44],["ἐπὶ",705080,0],["κοίτης",707781,17]],"[sending] a dream, or in the meditation of the night; (as when a dreadful alarm happens to fall upon men, in slumberings on the bed:)"],["16",[["τότε",712908,28],["ἀνακαλύπτει",700968,91],["νοῦν",709374,6],["ἀνθρώπων",701163,81],["ἐν",704639,0],["εἴδεσιν",704074,96],["φόβου",713534,18],["τοιούτοις",712878,230],["αὐτοὺς",702165,62],["ἐξεφόβησεν",704360,2]],"then opens he the understanding of men: he scares them with such fearful visions:"],["17",[["ἀποστρέψαι",701598,106],["ἄνθρωπον",701163,6],["ἐξ",704132,0],["ἀδικίας",700271,17],["τὸ",709436,24],["δὲ",703303,11],["σῶμα",712635,25],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["πτώματος",711071,21],["ἐρρύσατο",711309,23]],"to turn a man from unrighteousness, and he delivers his body from a fall."],["18",[["ἐφείσατο",713406,23],["δὲ",703303,11],["τῆς",709436,16],["ψυχῆς",714070,17],["αὐτοῦ",702165,102],["ἀπὸ",701425,0],["θανάτου",706096,18],["καὶ",707031,7],["μὴ",708851,28],["πεσεῖν",710481,106],["αὐτὸν",702165,85],["ἐν",704639,0],["πολέμῳ",710605,114]],"He spares also his soul from death, and [suffers] him not to fall in war."],["19",[["πάλιν",709942,28],["δὲ",703303,11],["ἤλεγξεν",704416,2],["αὐτὸν",702165,85],["ἐν",704639,0],["μαλακίᾳ",708435,1],["ἐπὶ",705080,0],["κοίτης",707781,17],["καὶ",707031,7],["πλῆθος",710529,25],["ὀστῶν",709792,44],["αὐτοῦ",702165,102],["ἐνάρκησεν",709196,2]],"And again, he chastens him with sickness on his bed, and the multitude of his bones is benumbed."],["20",[["πᾶν",710177,27],["δὲ",703303,11],["βρωτὸν",702826,27],["σίτου",711814,18],["οὐ",709805,28],["μὴ",708851,28],["δύνηται",703838,428],["προσδέξασθαι",710874,109],["καὶ",707031,7],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτοῦ",702165,102],["βρῶσιν",702825,9],["ἐπιθυμήσει",705141,225]],"And he shall not be able to take any food, though his soul shall desire meat;"],["21",[["ἕως",705792,7],["ἂν",700900,11],["σαπῶσιν",711754,234],["αὐτοῦ",702165,102],["αἱ",709436,190],["σάρκες",711537,191],["καὶ",707031,7],["ἀποδείξῃ",701438,172],["τὰ",709436,41],["ὀστᾶ",709792,42],["αὐτοῦ",702165,102],["κενά",707612,68]],"until his flesh shall be consumed, and he shall shew his bones bare."],["22",[["ἤγγισεν",703939,2],["δὲ",703303,11],["εἰς",704105,0],["θάνατον",706096,6],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτοῦ",702165,102],["ἡ",709436,10],["δὲ",703303,11],["ζωὴ",705910,12],["αὐτοῦ",702165,102],["ἐν",704639,0],["ᾅδῃ",700255,114]],"His soul also draws nigh to death, and his life is in Hades."],["23",[["ἐὰν",703912,7],["ὦσιν",704093,271],["χίλιοι",713859,138],["ἄγγελοι",700140,52],["θανατηφόροι",706095,138],["εἷς",704106,14],["αὐτῶν",702165,40],["οὐ",709805,28],["μὴ",708851,28],["τρώσῃ",712871,172],["αὐτόν",702165,85],["ἐὰν",703912,7],["νοήσῃ",709327,172],["τῇ",709436,100],["καρδίᾳ",707141,1],["ἐπιστραφῆναι",705278,179],["ἐπὶ",705080,0],["κύριον",707996,6],["ἀναγγείλῃ",700921,172],["δὲ",703303,11],["ἀνθρώπῳ",701163,114],["τὴν",709436,8],["ἑαυτοῦ",703917,102],["μέμψιν",708729,9],["τὴν",709436,8],["δὲ",703303,11],["ἄνοιαν",701185,9],["αὐτοῦ",702165,102],["δείξῃ",703314,172]],"Though there should be a thousand messengers of death, not one of them shall wound him: if he should purpose in his heart to turn to the Lord, and declare to man his fault, and shew his folly;"],["24",[["ἀνθέξεται",701225,93],["τοῦ",709436,20],["μὴ",708851,28],["πεσεῖν",710481,106],["αὐτὸν",702165,85],["εἰς",704105,0],["θάνατον",706096,6],["ἀνανεώσει",701011,127],["δὲ",703303,11],["αὐτοῦ",702165,102],["τὸ",709436,24],["σῶμα",712635,25],["ὥσπερ",714163,28],["ἀλοιφὴν",700725,9],["ἐπὶ",705080,0],["τοίχου",712879,18],["τὰ",709436,41],["δὲ",703303,11],["ὀστᾶ",709792,42],["αὐτοῦ",702165,102],["ἐμπλήσει",704592,127],["μυελοῦ",709046,18]],"he will support him, that he should not perish, and will restore his body as [fresh] plaster upon a wall; and he will fill his bones with marrow."],["25",[["ἁπαλυνεῖ",701338,91],["δὲ",703303,11],["αὐτοῦ",702165,102],["τὰς",709436,38],["σάρκας",711537,39],["ὥσπερ",714163,28],["νηπίου",709295,116],["ἀποκαταστήσει",701470,127],["δὲ",703303,11],["αὐτὸν",702165,85],["ἀνδρωθέντα",701111,260],["ἐν",704639,0],["ἀνθρώποις",701163,148]],"And he will make his flesh tender as that of a babe, and he will restore him among men in [his] full strength."],["26",[["εὐξάμενος",705727,248],["δὲ",703303,11],["πρὸς",710844,0],["κύριον",707996,6],["καὶ",707031,7],["δεκτὰ",703348,68],["αὐτῷ",702165,50],["ἔσται",704093,93],["εἰσελεύσεται",704114,93],["δὲ",703303,11],["προσώπῳ",710986,54],["καθαρῷ",706988,30],["σὺν",712372,0],["ἐξηγορίᾳ",704921,1],["ἀποδώσει",701449,127],["δὲ",703303,11],["ἀνθρώποις",701163,148],["δικαιοσύνην",703695,9]],"And he shall pray to the Lord, and his prayer shall be accepted of him; he shall enter with a cheerful countenance, with a full expression [of praise]: for he will render to men [their] due."],["27",[["εἶτα",704129,28],["τότε",712908,28],["ἀπομέμψεται",701529,93],["ἄνθρωπος",701163,4],["αὐτὸς",702165,121],["ἑαυτῷ",703917,50],["λέγων",708124,72],["οἷα",709535,69],["συνετέλουν",712510,421],["καὶ",707031,7],["οὐκ",709805,28],["ἄξια",701308,68],["ἤτασέν",705526,2],["με",708618,163],["ὧν",709781,252],["ἥμαρτον",700773,155]],"Even then a man shall blame himself, saying, What kind of things have I done? and he has not punished me according to the full amount of my sins."],["28",[["σῶσον",712627,176],["ψυχήν",714070,9],["μου",709032,133],["τοῦ",709436,20],["μὴ",708851,28],["ἐλθεῖν",705453,106],["εἰς",704105,0],["διαφθοράν",703625,9],["καὶ",707031,7],["ἡ",709436,10],["ζωή",705910,12],["μου",709032,133],["φῶς",713642,25],["ὄψεται",709725,93]],"Deliver my soul, that it may not go to destruction, and my life shall see the light."],["29",[["ἰδοὺ",706497,88],["πάντα",710177,68],["ταῦτα",709858,71],["ἐργᾶται",705383,117],["ὁ",709436,3],["ἰσχυρὸς",706855,14],["ὁδοὺς",709458,39],["τρεῖς",712927,119],["μετὰ",708780,0],["ἀνδρός",701150,18]],"Behold, all these things the Mighty One works in a threefold manner with a man."],["30",[["ἀλλ᾿",700680,7],["ἐρρύσατο",711309,23],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["ἐκ",704132,0],["θανάτου",706096,18],["ἵνα",706747,7],["ἡ",709436,10],["ζωή",705910,12],["μου",709032,133],["ἐν",704639,0],["φωτὶ",713642,54],["αἰνῇ",700459,204],["αὐτόν",702165,85]],"And he has delivered my soul from death, that my life may praise him in the light."],["31",[["ἐνωτίζου",704825,253],["Ιωβ",706903,153],["καὶ",707031,7],["ἄκουέ",700587,240],["μου",709032,133],["κώφευσον",708032,176],["καὶ",707031,7],["ἐγώ",704018,164],["εἰμι",704093,157],["λαλήσω",708071,165]],"Hearken, Job, and hear me: be silent, and I will speak."],["32",[["εἰ",704071,7],["εἰσὶν",704093,197],["λόγοι",708236,52],["ἀποκρίθητί",701492,244],["μοι",708974,159],["λάλησον",708071,176],["θέλω",706176,157],["γὰρ",702963,11],["δικαιωθῆναί",703696,179],["σε",711598,163]],"If thou hast words, answer me: speak, for I desire thee to be justified."],["33",[["εἰ",704071,7],["μή",708851,28],["σὺ",712181,164],["ἄκουσόν",700587,176],["μου",709032,133],["κώφευσον",708032,176],["καὶ",707031,7],["διδάξω",703649,165],["σε",711598,163],["σοφίαν",711981,9]],"If not, do thou hear me: be silent, and I will teach thee."]]