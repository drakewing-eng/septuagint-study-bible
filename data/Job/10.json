[["1",[["κάμνων",707115,72],["τῇ",709436,100],["ψυχῇ",714070,1],["μου",709032,133],["στένων",712072,72],["ἐπαφήσω",705051,165],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["τὰ",709436,41],["ῥήματά",711246,42],["μου",709032,133],["λαλήσω",708071,165],["πικρίᾳ",710472,1],["ψυχῆς",714070,17],["μου",709032,133],["συνεχόμενος",712469,122]],"Weary in my soul, I will pour my words with groans upon him: I will speak being straitened in the bitterness of my soul."],["2",[["καὶ",707031,7],["ἐρῶ",705415,165],["πρὸς",710844,0],["κύριον",707996,6],["μή",708851,28],["με",708618,163],["ἀσεβεῖν",701906,55],["δίδασκε",703649,240],["καὶ",707031,7],["διὰ",703417,0],["τί",712867,126],["με",708618,163],["οὕτως",709859,28],["ἔκρινας",707905,162]],"And I will say to the Lord, Do not teach me to be impious; and wherefore hast thou thus judged me?"],["3",[["ἦ",705925,28],["καλόν",707097,26],["σοι",711925,159],["ἐὰν",703912,7],["ἀδικήσω",700269,207],["ὅτι",709803,7],["ἀπείπω",701378,207],["ἔργα",705396,42],["χειρῶν",713787,65],["σου",711945,133],["βουλῇ",702792,1],["δὲ",703303,11],["ἀσεβῶν",701909,169],["προσέσχες",710895,162]],"Is it good before thee if I be unrighteous? for thou hast disowned the work of thy hands, and attended to the counsel of the ungodly."],["4",[["ἦ",705925,28],["ὥσπερ",714163,28],["βροτὸς",702817,4],["ὁρᾷ",709725,91],["καθορᾷς",707019,154],["ἢ",705924,7],["καθὼς",707030,28],["ὁρᾷ",709725,91],["ἄνθρωπος",701163,4],["βλέψῃ",702740,123]],"Or dost thou see as a mortal sees? or wilt thou look as a man sees?"],["5",[["ἦ",705925,28],["ὁ",709436,3],["βίος",702724,4],["σου",711945,133],["ἀνθρώπινός",701162,14],["ἐστιν",704093,91],["ἢ",705924,7],["τὰ",709436,63],["ἔτη",705543,64],["σου",711945,133],["ἀνδρός",701150,18]],"Or is thy life human, or thy years [the years] of a man,"],["6",[["ὅτι",709803,7],["ἀνεζήτησας",700943,162],["τὴν",709436,8],["ἀνομίαν",701192,9],["μου",709032,133],["καὶ",707031,7],["τὰς",709436,38],["ἁμαρτίας",700775,39],["μου",709032,133],["ἐξιχνίασας",704941,162]],"that thou hast enquired into mine iniquity, and searched out my sins?"],["7",[["οἶδας",709492,266],["γὰρ",702963,11],["ὅτι",709803,7],["οὐκ",709805,28],["ἠσέβησα",701906,155],["ἀλλὰ",700680,7],["τίς",712867,158],["ἐστιν",704093,91],["ὁ",709436,3],["ἐκ",704132,0],["τῶν",709436,130],["χειρῶν",713787,65],["σου",711945,133],["ἐξαιρούμενος",704838,122]],"For thou knowest that I have not committed iniquity: but who is he that can deliver out of thy hands?"],["8",[["αἱ",709436,190],["χεῖρές",713787,191],["σου",711945,133],["ἔπλασάν",710503,150],["με",708618,163],["καὶ",707031,7],["ἐποίησάν",710582,150],["με",708618,163],["μετὰ",708780,0],["ταῦτα",709858,71],["μεταβαλών",708782,182],["με",708618,163],["ἔπαισας",709933,162]],"Thy hands have formed me and made me; afterwards thou didst change [thy mind], and smite me."],["9",[["μνήσθητι",708960,244],["ὅτι",709803,7],["πηλόν",710457,6],["με",708618,163],["ἔπλασας",710503,162],["εἰς",704105,0],["δὲ",703303,11],["γῆν",703083,9],["με",708618,163],["πάλιν",709942,28],["ἀποστρέφεις",701598,154]],"Remember that thou hast made me [as] clay, and thou dost turn me again to earth."],["10",[["ἦ",705925,28],["οὐχ",709805,28],["ὥσπερ",714163,28],["γάλα",702919,25],["με",708618,163],["ἤμελξας",700802,162],["ἐτύρωσας",713030,162],["δέ",703303,11],["με",708618,163],["ἴσα",706832,28],["τυρῷ",713029,114]],"Hast thou not poured me out like milk, and curdled me like cheese?"],["11",[["δέρμα",703363,25],["καὶ",707031,7],["κρέας",707889,25],["με",708618,163],["ἐνέδυσας",704701,162],["ὀστέοις",709792,96],["δὲ",703303,11],["καὶ",707031,7],["νεύροις",709275,96],["με",708618,163],["ἐνεῖρας",704708,162]],"And thou didst clothe me with skin and flesh, and frame me with bones and sinews."],["12",[["ζωὴν",705910,9],["δὲ",703303,11],["καὶ",707031,7],["ἔλεος",704426,25],["ἔθου",712849,174],["παρ᾿",709995,0],["ἐμοί",704577,159],["ἡ",709436,10],["δὲ",703303,11],["ἐπισκοπή",705255,12],["σου",711945,133],["ἐφύλαξέν",713619,2],["μου",709032,133],["τὸ",709436,24],["πνεῦμα",710566,25]],"And thou didst bestow upon me life and mercy, and thy oversight has preserved my spirit."],["13",[["ταῦτα",709858,71],["ἔχων",705785,72],["ἐν",704639,0],["σεαυτῷ",711599,50],["οἶδα",709492,89],["ὅτι",709803,7],["πάντα",710177,68],["δύνασαι",703838,259],["ἀδυνατεῖ",700296,91],["δέ",703303,11],["σοι",711925,159],["οὐθέν",709817,26]],"Having these things in thyself, I know that thou canst do all things; for nothing is impossible with thee."],["14",[["ἐάν",703912,7],["τε",712751,11],["γὰρ",702963,11],["ἁμάρτω",700773,207],["φυλάσσεις",713619,154],["με",708618,163],["ἀπὸ",701425,0],["δὲ",703303,11],["ἀνομίας",701192,17],["οὐκ",709805,28],["ἀθῷόν",700390,27],["με",708618,163],["πεποίηκας",710582,266]],"And if I should sin, thou watchest me; and thou hast not cleared me from iniquity."],["15",[["ἐάν",703912,7],["τε",712751,11],["γὰρ",702963,11],["ἀσεβὴς",701909,14],["ὦ",704093,438],["οἴμμοι",709525,88],["ἐάν",703912,7],["τε",712751,11],["ὦ",704093,438],["δίκαιος",703694,14],["οὐ",709805,28],["δύναμαι",703838,254],["ἀνακύψαι",700983,106],["πλήρης",710541,14],["γὰρ",702963,11],["ἀτιμίας",702094,17],["εἰμί",704093,157]],"Or if I should be ungodly, woe is me: and if I should be righteous, I cannot lift myself up, for I am full of dishonour."],["16",[["ἀγρεύομαι",700188,257],["γὰρ",702963,11],["ὥσπερ",714163,28],["λέων",708171,4],["εἰς",704105,0],["σφαγήν",712568,9],["πάλιν",709942,28],["δὲ",703303,11],["μεταβαλὼν",708782,182],["δεινῶς",703329,28],["με",708618,163],["ὀλέκεις",709565,154]],"For I am hunted like a lion for slaughter; for again thou hast changed and art terribly destroying me;"],["17",[["ἐπανακαινίζων",705017,72],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["τὴν",709436,8],["ἔτασίν",705530,9],["μου",709032,133],["ὀργῇ",709728,1],["δὲ",703303,11],["μεγάλῃ",708653,101],["μοι",708974,159],["ἐχρήσω",713937,174],["ἐπήγαγες",704994,162],["δὲ",703303,11],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["πειρατήρια",710228,42]],"renewing against me my torture: and thou hast dealt with me in great anger, and thou hast brought trials upon me."],["18",[["ἵνα",706747,7],["τί",712867,273],["οὖν",709835,11],["ἐκ",704132,0],["κοιλίας",707761,17],["με",708618,163],["ἐξήγαγες",704834,162],["καὶ",707031,7],["οὐκ",709805,28],["ἀπέθανον",701461,155],["ὀφθαλμὸς",709870,4],["δέ",703303,11],["με",708618,163],["οὐκ",709805,28],["εἶδεν",709725,2]],"Why then didst thou bring me out of the womb? and why did I not die, and no eye see me,"],["19",[["καὶ",707031,7],["ὥσπερ",714163,28],["οὐκ",709805,28],["ὢν",704093,72],["ἐγενόμην",703104,161],["διὰ",703417,0],["τί",712867,126],["γὰρ",702963,11],["ἐκ",704132,0],["γαστρὸς",702976,17],["εἰς",704105,0],["μνῆμα",708962,25],["οὐκ",709805,28],["ἀπηλλάγην",701333,156]],"and I become as if I had not been? for why was I not carried from the womb to the grave?"],["20",[["ἦ",705925,28],["οὐκ",709805,28],["ὀλίγος",709568,14],["ἐστὶν",704093,91],["ὁ",709436,3],["χρόνος",713969,4],["τοῦ",709436,35],["βίου",702724,18],["μου",709032,133],["ἔασόν",703918,176],["με",708618,163],["ἀναπαύσασθαι",701027,109],["μικρὸν",708915,46]],"Is not the time of my life short? suffer me to rest a little,"],["21",[["πρὸ",710747,0],["τοῦ",709436,20],["με",708618,163],["πορευθῆναι",710667,179],["ὅθεν",709486,28],["οὐκ",709805,28],["ἀναστρέψω",701060,165],["εἰς",704105,0],["γῆν",703083,9],["σκοτεινὴν",711885,36],["καὶ",707031,7],["γνοφεράν",703130,36]],"before I go whence I shall not return, to a land of darkness and gloominess;"],["22",[["εἰς",704105,0],["γῆν",703083,9],["σκότους",711889,21],["αἰωνίου",700505,92],["οὗ",709781,48],["οὐκ",709805,28],["ἔστιν",704093,91],["φέγγος",713404,15],["οὐδὲ",709816,7],["ὁρᾶν",709725,55],["ζωὴν",705910,9],["βροτῶν",702817,81]],"to a land of perpetual darkness, where there is no light, neither [can any one] see the life of mortals."]]