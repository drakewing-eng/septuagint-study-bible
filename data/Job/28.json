[["1",[["ἔστιν",704093,91],["γὰρ",702963,11],["ἀργυρίῳ",701707,54],["τόπος",712903,4],["ὅθεν",709486,28],["γίνεται",703104,117],["τόπος",712903,4],["δὲ",703303,11],["χρυσίῳ",713972,54],["ὅθεν",709486,28],["διηθεῖται",703682,23]],"For there is a place for the silver, whence it comes, and a place for the gold, whence it is refined."],["2",[["σίδηρος",711774,4],["μὲν",708730,11],["γὰρ",702963,11],["ἐκ",704132,0],["γῆς",703083,17],["γίνεται",703104,117],["χαλκὸς",713695,4],["δὲ",703303,11],["ἴσα",706832,28],["λίθῳ",708196,114],["λατομεῖται",708102,117]],"For iron comes out of the earth, and brass is hewn out like stone."],["3",[["τάξιν",712712,9],["ἔθετο",712849,23],["σκότει",711889,54],["καὶ",707031,7],["πᾶν",710177,26],["πέρας",710281,15],["αὐτὸς",702165,121],["ἐξακριβάζεται",704849,117],["λίθος",708196,4],["σκοτία",711886,12],["καὶ",707031,7],["σκιὰ",711852,12],["θανάτου",706096,18]],"He has set a bound to darkness, and he searches out every limit: a stone [is] darkness, and the shadow of death."],["4",[["διακοπὴ",703480,12],["χειμάρρου",713783,18],["ἀπὸ",701425,0],["κονίας",707811,17],["οἱ",709436,136],["δὲ",703303,11],["ἐπιλανθανόμενοι",705187,348],["ὁδὸν",709458,9],["δικαίαν",703694,36],["ἠσθένησαν",701938,150],["ἐκ",704132,0],["βροτῶν",702817,81]],"There is a cutting off of the torrent by reason of dust: so they that forget the right way are weakened; they are removed from [among] men."],["5",[["γῆ",703083,12],["ἐξ",704132,0],["αὐτῆς",702165,86],["ἐξελεύσεται",704909,93],["ἄρτος",701829,4],["ὑποκάτω",713204,28],["αὐτῆς",702165,86],["ἐστράφη",712160,37],["ὡσεὶ",714159,28],["πῦρ",711088,15]],"[As for] the earth, out of it shall come bread: under it has been turned up as it were fire."],["6",[["τόπος",712903,4],["σαπφείρου",711505,17],["οἱ",709436,136],["λίθοι",708196,52],["αὐτῆς",702165,86],["καὶ",707031,7],["χῶμα",714000,15],["χρυσίον",713972,15],["αὐτῷ",702165,50]],"Her stones are the place of the sapphire: and [her] dust [supplies] man with gold."],["7",[["τρίβος",712939,12],["οὐκ",709805,28],["ἔγνω",703105,2],["αὐτὴν",702165,104],["πετεινόν",710439,15],["καὶ",707031,7],["οὐ",709805,28],["παρέβλεψεν",710002,2],["αὐτὴν",702165,104],["ὀφθαλμὸς",709870,4],["γυπός",703212,18]],"[There is] a path, the fowl has not known it, neither has the eye of the vulture seen it:"],["8",[["οὐκ",709805,28],["ἐπάτησαν",710187,150],["αὐτὴν",702165,104],["υἱοὶ",713075,52],["ἀλαζόνων",700629,81],["οὐ",709805,28],["παρῆλθεν",710141,2],["ἐπ᾿",705080,0],["αὐτῆς",702165,86],["λέων",708171,4]],"neither have the sons of the proud trodden it, a lion has not passed upon it."],["9",[["ἐν",704639,0],["ἀκροτόμῳ",700611,30],["ἐξέτεινεν",704322,2],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["κατέστρεψεν",707444,2],["δὲ",703303,11],["ἐκ",704132,0],["ῥιζῶν",711260,65],["ὄρη",709768,42]],"He has stretched forth his hand on the sharp [rock], and turned up mountains by the roots:"],["10",[["δίνας",703713,39],["δὲ",703303,11],["ποταμῶν",710693,81],["ἔρρηξεν",711243,2],["πᾶν",710177,46],["δὲ",703303,11],["ἔντιμον",704798,46],["εἶδέν",709725,2],["μου",709032,133],["ὁ",709436,3],["ὀφθαλμός",709870,4]],"and he has interrupted the whirlpools of rivers, and mine eye has seen every precious thing."],["11",[["βάθη",702376,42],["δὲ",703303,11],["ποταμῶν",710693,81],["ἀνεκάλυψεν",700968,2],["ἔδειξεν",703314,2],["δὲ",703303,11],["ἑαυτοῦ",703917,102],["δύναμιν",703839,9],["εἰς",704105,0],["φῶς",713642,25]],"And he has laid bare the depths of rivers, and has brought his power to light."],["12",[["ἡ",709436,10],["δὲ",703303,11],["σοφία",711981,12],["πόθεν",710580,28],["εὑρέθη",705676,37],["ποῖος",710599,14],["δὲ",703303,11],["τόπος",712903,4],["ἐστὶν",704093,91],["τῆς",709436,16],["ἐπιστήμης",705267,17]],"But whence has wisdom been discovered? and what is the place of knowledge?"],["13",[["οὐκ",709805,28],["οἶδεν",709492,171],["βροτὸς",702817,4],["ὁδὸν",709458,9],["αὐτῆς",702165,86],["οὐδὲ",709816,7],["μὴ",708851,28],["εὑρεθῇ",705676,384],["ἐν",704639,0],["ἀνθρώποις",701163,148]],"A mortal has not known its way, neither indeed has it been discovered among men."],["14",[["ἄβυσσος",700098,12],["εἶπεν",705373,2],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐν",704639,0],["ἐμοί",704577,159],["καὶ",707031,7],["θάλασσα",706069,12],["εἶπεν",705373,2],["οὐκ",709805,28],["ἔστιν",704093,91],["μετ᾿",708780,0],["ἐμοῦ",704580,133]],"The depth said, It is not in me: and the sea said, It is not with me."],["15",[["οὐ",709805,28],["δώσει",703654,127],["συγκλεισμὸν",712220,6],["ἀντ᾿",701227,0],["αὐτῆς",702165,86],["καὶ",707031,7],["οὐ",709805,28],["σταθήσεται",706846,134],["ἀργύριον",701707,25],["ἀντάλλαγμα",701209,25],["αὐτῆς",702165,86]],"One shall not give fine gold instead of it, neither shall silver be weighed in exchange for it."],["16",[["καὶ",707031,7],["οὐ",709805,28],["συμβασταχθήσεται",712279,134],["χρυσίῳ",713972,54],["Ωφιρ",714173,18],["ἐν",704639,0],["ὄνυχι",709673,114],["τιμίῳ",712858,30],["καὶ",707031,7],["σαπφείρῳ",711505,1]],"Neither shall it be compared with gold of Sophir, with the precious onyx and sapphire."],["17",[["οὐκ",709805,28],["ἰσωθήσεται",706837,134],["αὐτῇ",702165,105],["χρυσίον",713972,15],["καὶ",707031,7],["ὕαλος",713049,12],["καὶ",707031,7],["τὸ",709436,34],["ἄλλαγμα",700682,15],["αὐτῆς",702165,86],["σκεύη",711844,64],["χρυσᾶ",713971,195]],"Gold and crystal shall not be equalled to it, neither shall vessels of gold be its exchange."],["18",[["μετέωρα",708831,195],["καὶ",707031,7],["γαβις",702867,120],["οὐ",709805,28],["μνησθήσεται",708923,134],["καὶ",707031,7],["ἕλκυσον",704508,176],["σοφίαν",711981,9],["ὑπὲρ",713111,0],["τὰ",709436,41],["ἐσώτατα",705524,430]],"Coral and fine pearl shall not be mentioned: but do thou esteem wisdom above the most precious things."],["19",[["οὐκ",709805,28],["ἰσωθήσεται",706837,134],["αὐτῇ",702165,105],["τοπάζιον",712900,15],["Αἰθιοπίας",700419,17],["χρυσίῳ",713972,54],["καθαρῷ",706988,97],["οὐ",709805,28],["συμβασταχθήσεται",712279,134]],"The topaz of Ethiopia shall not be equalled to it; it shall not be compared with pure gold."],["20",[["ἡ",709436,10],["δὲ",703303,11],["σοφία",711981,12],["πόθεν",710580,28],["εὑρέθη",705676,37],["ποῖος",710599,14],["δὲ",703303,11],["τόπος",712903,4],["ἐστὶν",704093,91],["τῆς",709436,16],["συνέσεως",712460,17]],"Whence then is wisdom found? and of what kind is the place of understanding?"],["21",[["λέληθεν",708088,171],["πάντα",710177,27],["ἄνθρωπον",701163,6],["καὶ",707031,7],["ἀπὸ",701425,0],["πετεινῶν",710439,44],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["ἐκρύβη",707923,37]],"It has escaped the notice of every man, and has been hidden from the birds of the sky."],["22",[["ἡ",709436,10],["ἀπώλεια",701660,12],["καὶ",707031,7],["ὁ",709436,3],["θάνατος",706096,4],["εἶπαν",705373,150],["ἀκηκόαμεν",700587,314],["δὲ",703303,11],["αὐτῆς",702165,86],["τὸ",709436,24],["κλέος",707713,25]],"Destruction and Death said, We have heard the report of it."],["23",[["ὁ",709436,3],["θεὸς",706192,4],["εὖ",705544,28],["συνέστησεν",712482,2],["αὐτῆς",702165,86],["τὴν",709436,8],["ὁδόν",709458,9],["αὐτὸς",702165,121],["δὲ",703303,11],["οἶδεν",709492,171],["τὸν",709436,5],["τόπον",712903,6],["αὐτῆς",702165,86]],"God has well ordered the way of it, and he knows the place of it."],["24",[["αὐτὸς",702165,121],["γὰρ",702963,11],["τὴν",709436,8],["ὑπ᾿",713184,0],["οὐρανὸν",709844,6],["πᾶσαν",710177,36],["ἐφορᾷ",705057,91],["εἰδὼς",709492,270],["τὰ",709436,41],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["πάντα",710177,68],["ἃ",709781,69],["ἐποίησεν",710582,2]],"For he surveys the whole [earth] under heaven, knowing the things in the earth:"],["25",[["ἀνέμων",701123,81],["σταθμὸν",712040,6],["ὕδατός",713071,21],["τε",712751,11],["μέτρα",708846,42]],"all that he has made; the weight of the winds, the measures of the water."],["26",[["ὅτε",709802,28],["ἐποίησεν",710582,2],["οὕτως",709859,28],["ὑετὸν",713074,6],["ἠρίθμησεν",701742,2],["καὶ",707031,7],["ὁδὸν",709458,9],["ἐν",704639,0],["τινάγματι",712864,54],["φωνάς",713640,17]],"When he made [them], thus he saw and numbered them, and made a way for the pealing of the thunder."],["27",[["τότε",712908,28],["εἶδεν",709725,2],["αὐτὴν",702165,104],["καὶ",707031,7],["ἐξηγήσατο",704918,23],["αὐτήν",702165,104],["ἑτοιμάσας",705539,182],["ἐξιχνίασεν",704941,2]],"Then he saw it, and declared it: he prepared it [and] traced it out."],["28",[["εἶπεν",705373,2],["δὲ",703303,11],["ἀνθρώπῳ",701163,114],["ἰδοὺ",706497,88],["ἡ",709436,10],["θεοσέβειά",706193,12],["ἐστιν",704093,91],["σοφία",711981,12],["τὸ",709436,24],["δὲ",703303,11],["ἀπέχεσθαι",701404,110],["ἀπὸ",701425,0],["κακῶν",707066,169],["ἐστιν",704093,91],["ἐπιστήμη",705267,12]],"And he said to man, Behold, godliness is wisdom; and to abstain from evil is understanding."]]