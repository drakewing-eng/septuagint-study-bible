[["1",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Βαλδαδ",702480,4],["ὁ",709436,3],["Σαυχίτης",711565,4],["λέγει",708124,91]],"Then Baldad the Sauchite answered, and said,"],["2",[["μέχρι",708849,0],["τίνος",712867,340],["λαλήσεις",708071,166],["ταῦτα",709858,71],["πνεῦμα",710566,15],["πολυρῆμον",710645,26],["τοῦ",709436,20],["στόματός",712125,21],["σου",711945,133]],"How long wilt thou speak these things, [how long shall] the breath of thy mouth [be] abundant in words?"],["3",[["μὴ",708851,28],["ὁ",709436,3],["κύριος",707996,4],["ἀδικήσει",700269,127],["κρίνων",707905,72],["ἢ",705924,7],["ὁ",709436,3],["τὰ",709436,41],["πάντα",710177,68],["ποιήσας",710582,182],["ταράξει",712721,127],["τὸ",709436,24],["δίκαιον",703694,46]],"Will the Lord be unjust when he judges; or will he that has made all things pervert justice?"],["4",[["εἰ",704071,7],["οἱ",709436,136],["υἱοί",713075,52],["σου",711945,133],["ἥμαρτον",700773,150],["ἐναντίον",704654,0],["αὐτοῦ",702165,102],["ἀπέστειλεν",701592,2],["ἐν",704639,0],["χειρὶ",713787,1],["ἀνομίας",701192,17],["αὐτῶν",702165,40]],"If thy sons have sinned before him, he has cast them away because of their transgression."],["5",[["σὺ",712181,164],["δὲ",703303,11],["ὄρθριζε",709742,240],["πρὸς",710844,0],["κύριον",707996,6],["παντοκράτορα",709986,6],["δεόμενος",703394,122]],"But be thou early in prayer to the Lord Almighty."],["6",[["εἰ",704071,7],["καθαρὸς",706988,14],["εἶ",704093,154],["καὶ",707031,7],["ἀληθινός",700659,14],["δεήσεως",703311,17],["ἐπακούσεταί",705009,93],["σου",711945,133],["ἀποκαταστήσει",701470,127],["δέ",703303,11],["σοι",711925,159],["δίαιταν",703460,9],["δικαιοσύνης",703695,17]],"If thou art pure and true, he will hearken to thy supplication, and will restore to thee the habitation of righteousness."],["7",[["ἔσται",704093,93],["οὖν",709835,11],["τὰ",709436,63],["μὲν",708730,11],["πρῶτά",711041,739],["σου",711945,133],["ὀλίγα",709568,195],["τὰ",709436,63],["δὲ",703303,11],["ἔσχατά",705519,195],["σου",711945,133],["ἀμύθητα",700878,195]],"Though then thy beginning should be small, yet thy end should be unspeakably great."],["8",[["ἐπερώτησον",705069,176],["γὰρ",702963,11],["γενεὰν",703037,9],["πρώτην",711041,506],["ἐξιχνίασον",704941,176],["δὲ",703303,11],["κατὰ",707200,0],["γένος",703057,25],["πατέρων",710189,81]],"For ask of the former generation, and search diligently among the race of [our] fathers:"],["9",[["χθιζοὶ",713854,138],["γάρ",702963,11],["ἐσμεν",704093,243],["καὶ",707031,7],["οὐκ",709805,28],["οἴδαμεν",709492,314],["σκιὰ",711852,12],["γάρ",702963,11],["ἐστιν",704093,91],["ἡμῶν",705999,145],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ὁ",709436,3],["βίος",702724,4]],"(for we are of yesterday, and know nothing; for our life upon the earth is a shadow:)"],["10",[["ἦ",705925,28],["οὐχ",709805,28],["οὗτοί",709858,201],["σε",711598,163],["διδάξουσιν",703649,218],["καὶ",707031,7],["ἀναγγελοῦσιν",700921,218],["καὶ",707031,7],["ἐκ",704132,0],["καρδίας",707141,17],["ἐξάξουσιν",704834,218],["ῥήματα",711246,42]],"shall not these teach thee, and report [to thee], and bring out words from [their] heart?"],["11",[["μὴ",708851,28],["θάλλει",706073,91],["πάπυρος",709994,4],["ἄνευ",701137,0],["ὕδατος",713071,21],["ἢ",705924,7],["ὑψωθήσεται",713289,134],["βούτομον",702799,15],["ἄνευ",701137,0],["πότου",710704,18]],"Does the rush flourish without water, or shall the flag grow up without moisture?"],["12",[["ἔτι",705538,28],["ὂν",704093,32],["ἐπὶ",705080,0],["ῥίζης",711260,17],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["θερισθῇ",706206,384],["πρὸ",710747,0],["τοῦ",709436,20],["πιεῖν",710478,106],["πᾶσα",710177,29],["βοτάνη",702772,12],["οὐχὶ",709862,28],["ξηραίνεται",709419,391]],"When it is yet on the root, and [though] it has not been cut down, does not any herb wither before it has received moisture?"],["13",[["οὕτως",709859,28],["τοίνυν",712875,11],["ἔσται",704093,93],["τὰ",709436,63],["ἔσχατα",705519,195],["πάντων",710177,169],["τῶν",709436,80],["ἐπιλανθανομένων",705187,299],["τοῦ",709436,35],["κυρίου",707996,18],["ἐλπὶς",704530,12],["γὰρ",702963,11],["ἀσεβοῦς",701909,116],["ἀπολεῖται",701513,93]],"Thus then shall be the end of all that forget the Lord: for the hope of the ungodly shall perish."],["14",[["ἀοίκητος",701315,14],["γὰρ",702963,11],["αὐτοῦ",702165,102],["ἔσται",704093,93],["ὁ",709436,3],["οἶκος",709516,4],["ἀράχνη",701693,12],["δὲ",703303,11],["αὐτοῦ",702165,102],["ἀποβήσεται",701426,93],["ἡ",709436,10],["σκηνή",711845,12]],"For his house shall be without inhabitants, and his tent shall prove a spider's web."],["15",[["ἐὰν",703912,7],["ὑπερείσῃ",713131,172],["τὴν",709436,8],["οἰκίαν",709505,9],["αὐτοῦ",702165,102],["οὐ",709805,28],["μὴ",708851,28],["στῇ",706846,172],["ἐπιλαβομένου",705185,292],["δὲ",703303,11],["αὐτοῦ",702165,102],["οὐ",709805,28],["μὴ",708851,28],["ὑπομείνῃ",713219,172]],"If he should prop up his house, it shall not stand: and when he has taken hold of it, it shall not remain."],["16",[["ὑγρὸς",713063,14],["γάρ",702963,11],["ἐστιν",704093,91],["ὑπὸ",713184,0],["ἡλίου",705974,18],["καὶ",707031,7],["ἐκ",704132,0],["σαπρίας",711503,17],["αὐτοῦ",702165,102],["ὁ",709436,3],["ῥάδαμνος",711146,4],["αὐτοῦ",702165,102],["ἐξελεύσεται",704909,93]],"For it is moist under the sun, and his branch shall come forth out of his dung-heap."],["17",[["ἐπὶ",705080,0],["συναγωγὴν",712376,9],["λίθων",708196,81],["κοιμᾶται",707767,117],["ἐν",704639,0],["δὲ",703303,11],["μέσῳ",708768,97],["χαλίκων",713686,81],["ζήσεται",705851,93]],"He lies down upon a gathering of stones, and shall live in the midst of flints."],["18",[["ἐὰν",703912,7],["καταπίῃ",707374,172],["ὁ",709436,3],["τόπος",712903,4],["ψεύσεται",714045,93],["αὐτόν",702165,85],["οὐχ",709805,28],["ἑόρακας",709725,266],["τοιαῦτα",712878,68]],"If [God] should destroy [him], his place shall deny him. Hast thou not seen such things,"],["19",[["ὅτι",709803,7],["καταστροφὴ",707445,12],["ἀσεβοῦς",701909,116],["τοιαύτη",712878,29],["ἐκ",704132,0],["δὲ",703303,11],["γῆς",703083,17],["ἄλλον",700697,85],["ἀναβλαστήσει",700912,127]],"that such is the overthrow of the ungodly? and out of the earth another shall grow."],["20",[["ὁ",709436,3],["γὰρ",702963,11],["κύριος",707996,4],["οὐ",709805,28],["μὴ",708851,28],["ἀποποιήσηται",701552,239],["τὸν",709436,5],["ἄκακον",700512,27],["πᾶν",710177,46],["δὲ",703303,11],["δῶρον",703907,25],["ἀσεβοῦς",701909,116],["οὐ",709805,28],["δέξεται",703393,93]],"For the Lord will by no means reject the harmless man; but he will not receive any gift of the ungodly."],["21",[["ἀληθινῶν",700659,169],["δὲ",703303,11],["στόμα",712125,25],["ἐμπλήσει",704592,127],["γέλωτος",703032,18],["τὰ",709436,41],["δὲ",703303,11],["χείλη",713781,42],["αὐτῶν",702165,40],["ἐξομολογήσεως",704961,17]],"But he will fill with laughter the mouth of the sincere, and their lips with thanksgiving."],["22",[["οἱ",709436,136],["δὲ",703303,11],["ἐχθροὶ",705779,52],["αὐτῶν",702165,40],["ἐνδύσονται",704701,135],["αἰσχύνην",700483,9],["δίαιτα",703460,12],["δὲ",703303,11],["ἀσεβοῦς",701909,116],["οὐκ",709805,28],["ἔσται",704093,93]],"But their adversaries shall clothe themselves with shame; and the habitation of the ungodly shall perish."]]