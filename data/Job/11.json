[["1",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Σωφαρ",712665,4],["ὁ",709436,3],["Μιναῖος",708925,4],["λέγει",708124,91]],"Then Sophar the Minæan answered and said,"],["2",[["ὁ",709436,3],["τὰ",709436,41],["πολλὰ",710646,68],["λέγων",708124,72],["καὶ",707031,7],["ἀντακούσεται",701208,93],["ἢ",705924,7],["καὶ",707031,7],["ὁ",709436,3],["εὔλαλος",705630,14],["οἴεται",709534,117],["εἶναι",704093,55],["δίκαιος",703694,14],["εὐλογημένος",705631,251],["γεννητὸς",703055,14],["γυναικὸς",703209,17],["ὀλιγόβιος",709566,14]],"He that speaks much, should also hear on the other side: or does the fluent speaker think himself to be righteous? blessed [is] the short-lived offspring of woman."],["3",[["μὴ",708851,28],["πολὺς",710646,14],["ἐν",704639,0],["ῥήμασιν",711246,96],["γίνου",703104,253],["οὐ",709805,28],["γάρ",702963,11],["ἐστιν",704093,91],["ὁ",709436,3],["ἀντικρινόμενός",701241,122],["σοι",711925,159]],"Be not a speaker of many words; for is there none to answer thee?"],["4",[["μὴ",708851,28],["γὰρ",702963,11],["λέγε",708124,240],["ὅτι",709803,7],["καθαρός",706988,14],["εἰμι",704093,157],["τοῖς",709436,95],["ἔργοις",705396,96],["καὶ",707031,7],["ἄμεμπτος",700807,14],["ἐναντίον",704654,0],["αὐτοῦ",702165,102]],"For say not, I am pure in my works, and blameless before him."],["5",[["ἀλλὰ",700680,7],["πῶς",711121,28],["ἂν",700900,11],["ὁ",709436,3],["κύριος",707996,4],["λαλήσαι",708071,106],["πρὸς",710844,0],["σέ",711598,163],["καὶ",707031,7],["ἀνοίξει",701186,127],["χείλη",713781,42],["αὐτοῦ",702165,102],["μετὰ",708780,0],["σοῦ",711945,133]],"But oh that the Lord would speak to thee, and open his lips with thee!"],["6",[["εἶτα",704129,28],["ἀναγγελεῖ",700921,127],["σοι",711925,159],["δύναμιν",703839,9],["σοφίας",711981,17],["ὅτι",709803,7],["διπλοῦς",703740,14],["ἔσται",704093,93],["τῶν",709436,43],["κατὰ",707200,0],["σέ",711598,163],["καὶ",707031,7],["τότε",712908,28],["γνώσῃ",703105,123],["ὅτι",709803,7],["ἄξιά",701308,195],["σοι",711925,159],["ἀπέβη",701426,2],["ἀπὸ",701425,0],["κυρίου",707996,18],["ὧν",709781,103],["ἡμάρτηκας",700773,266]],"Then shall he declare to thee the power of wisdom; for it shall be double of that which is with thee: and then shalt thou know, that a just recompence of thy sins has come to thee from the Lord."],["7",[["ἦ",705925,28],["ἴχνος",706873,25],["κυρίου",707996,18],["εὑρήσεις",705676,166],["ἢ",705924,7],["εἰς",704105,0],["τὰ",709436,41],["ἔσχατα",705519,68],["ἀφίκου",702212,174],["ἃ",709781,69],["ἐποίησεν",710582,2],["ὁ",709436,3],["παντοκράτωρ",709986,4]],"Wilt thou find out the traces of the Lord? or hast thou come to the end [of that] which the Almighty has made?"],["8",[["ὑψηλὸς",713285,14],["ὁ",709436,3],["οὐρανός",709844,4],["καὶ",707031,7],["τί",712867,126],["ποιήσεις",710582,166],["βαθύτερα",702381,484],["δὲ",703303,11],["τῶν",709436,80],["ἐν",704639,0],["ᾅδου",700255,18],["τί",712867,126],["οἶδας",709492,266]],"Heaven [is] high; and what wilt thou do? and there are deeper things than those in hell; what dost thou know?"],["9",[["ἢ",705924,7],["μακρότερα",708421,484],["μέτρου",708846,21],["γῆς",703083,17],["ἢ",705924,7],["εὔρους",705677,21],["θαλάσσης",706069,17]],"Or longer than the measure of the earth, or the breadth of the sea."],["10",[["ἐὰν",703912,7],["δὲ",703303,11],["καταστρέψῃ",707444,123],["τὰ",709436,41],["πάντα",710177,68],["τίς",712867,158],["ἐρεῖ",705415,127],["αὐτῷ",702165,50],["τί",712867,126],["ἐποίησας",710582,162]],"And if he should overthrow all things, who will say to him, What hast thou done?"],["11",[["αὐτὸς",702165,121],["γὰρ",702963,11],["οἶδεν",709492,171],["ἔργα",705396,42],["ἀνόμων",701194,169],["ἰδὼν",709725,182],["δὲ",703303,11],["ἄτοπα",702102,68],["οὐ",709805,28],["παρόψεται",710125,93]],"For he knows the works of transgressors; and when he sees wickedness, he will not overlook [it]."],["12",[["ἄνθρωπος",701163,4],["δὲ",703303,11],["ἄλλως",700711,28],["νήχεται",709307,117],["λόγοις",708236,148],["βροτὸς",702817,4],["δὲ",703303,11],["γεννητὸς",703055,14],["γυναικὸς",703209,17],["ἴσα",706832,28],["ὄνῳ",709671,114],["ἐρημίτῃ",705419,114]],"But man vainly buoys himself up with words; and a mortal born of woman [is] like an ass of the desert."],["13",[["εἰ",704071,7],["γὰρ",702963,11],["σὺ",712181,164],["καθαρὰν",706988,36],["ἔθου",712849,174],["τὴν",709436,8],["καρδίαν",707141,9],["σου",711945,133],["ὑπτιάζεις",713264,154],["δὲ",703303,11],["χεῖρας",713787,39],["πρὸς",710844,0],["αὐτόν",702165,85]],"For if thou hast made thine heart pure, and liftest up [thine] hands towards him;"],["14",[["εἰ",704071,7],["ἄνομόν",701194,26],["τί",712866,273],["ἐστιν",704093,91],["ἐν",704639,0],["χερσίν",713787,76],["σου",711945,133],["πόρρω",710680,28],["ποίησον",710582,176],["αὐτὸ",702165,129],["ἀπὸ",701425,0],["σοῦ",711945,133],["ἀδικία",700271,12],["δὲ",703303,11],["ἐν",704639,0],["διαίτῃ",703460,1],["σου",711945,133],["μὴ",708851,28],["αὐλισθήτω",702138,22]],"if there is any iniquity in thy hands, put it far from thee, and let not unrighteousness lodge in thy habitation."],["15",[["οὕτως",709859,28],["γὰρ",702963,11],["ἀναλάμψει",700985,123],["σου",711945,133],["τὸ",709436,24],["πρόσωπον",710986,25],["ὥσπερ",714163,28],["ὕδωρ",713071,15],["καθαρόν",706988,26],["ἐκδύσῃ",704180,123],["δὲ",703303,11],["ῥύπον",711311,25],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["φοβηθῇς",713532,279]],"For thus shall thy countenance shine again, as pure water; and thou shalt divest thyself of uncleanness, and shalt not fear."],["16",[["καὶ",707031,7],["τὸν",709436,5],["κόπον",707825,6],["ἐπιλήσῃ",705187,123],["ὥσπερ",714163,28],["κῦμα",707968,25],["παρελθὸν",710141,511],["καὶ",707031,7],["οὐ",709805,28],["πτοηθήσῃ",711062,364]],"And thou shalt forget trouble, as a wave that has passed by; and thou shalt not be scared."],["17",[["ἡ",709436,10],["δὲ",703303,11],["εὐχή",705726,12],["σου",711945,133],["ὥσπερ",714163,28],["ἑωσφόρος",705793,4],["ἐκ",704132,0],["δὲ",703303,11],["μεσημβρίας",708758,17],["ἀνατελεῖ",701066,127],["σοι",711925,159],["ζωή",705910,12]],"And thy prayer [shall be] as the morning star, and life shall arise to thee [as] from the noon-day."],["18",[["πεποιθώς",710221,270],["τε",712751,11],["ἔσῃ",704093,123],["ὅτι",709803,7],["ἔστιν",704093,91],["σοι",711925,159],["ἐλπίς",704530,12],["ἐκ",704132,0],["δὲ",703303,11],["μερίμνης",708745,17],["καὶ",707031,7],["φροντίδος",713591,17],["ἀναφανεῖταί",701080,93],["σοι",711925,159],["εἰρήνη",704098,12]],"And thou shalt be confident, because thou hast hope; and peace shall dawn to thee from out of anxiety and care."],["19",[["ἡσυχάσεις",706033,166],["γάρ",702963,11],["καὶ",707031,7],["οὐκ",709805,28],["ἔσται",704093,93],["ὁ",709436,3],["πολεμῶν",710601,72],["σε",711598,163],["μεταβαλόμενοι",708782,317],["δὲ",703303,11],["πολλοί",710646,138],["σου",711945,133],["δεηθήσονται",703394,144]],"For thou shalt be at ease, and there shall be no one to fight against thee; and many shall charge, and make supplication to thee."],["20",[["σωτηρία",712658,12],["δὲ",703303,11],["αὐτοὺς",702165,62],["ἀπολείψει",701508,127],["ἡ",709436,10],["γὰρ",702963,11],["ἐλπὶς",704530,12],["αὐτῶν",702165,40],["ἀπώλεια",701660,12],["ὀφθαλμοὶ",709870,52],["δὲ",703303,11],["ἀσεβῶν",701909,169],["τακήσονται",712839,144]],"But safety shall fail them; for their hope is destruction, and the eyes of the ungodly shall waste away."]]