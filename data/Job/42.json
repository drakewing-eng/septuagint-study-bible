[["1",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Ιωβ",706903,4],["λέγει",708124,91],["τῷ",709436,113],["κυρίῳ",707996,114]],"Then Job answered and said to the Lord,"],["2",[["οἶδα",709492,89],["ὅτι",709803,7],["πάντα",710177,68],["δύνασαι",703838,259],["ἀδυνατεῖ",700296,91],["δέ",703303,11],["σοι",711925,159],["οὐθέν",709817,46]],"I know that thou canst do all things, and nothing is impossible with thee."],["3",[["τίς",712867,158],["γάρ",702963,11],["ἐστιν",704093,91],["ὁ",709436,3],["κρύπτων",707923,72],["σε",711598,163],["βουλήν",702792,9],["φειδόμενος",713406,122],["δὲ",703303,11],["ῥημάτων",711246,44],["καὶ",707031,7],["σὲ",711598,163],["οἴεται",709534,117],["κρύπτειν",707923,55],["τίς",712867,158],["δὲ",703303,11],["ἀναγγελεῖ",700921,127],["μοι",708974,159],["ἃ",709781,69],["οὐκ",709805,28],["ᾔδειν",709492,499],["μεγάλα",708653,68],["καὶ",707031,7],["θαυμαστὰ",706138,68],["ἃ",709781,69],["οὐκ",709805,28],["ἠπιστάμην",705756,334]],"For who is he that hides counsel from thee? or who keeps back his words, and thinks to hide them from thee? and who will tell me what I knew not, great and wonderful things which I understood not?"],["4",[["ἄκουσον",700587,176],["δέ",703303,11],["μου",709032,133],["κύριε",707996,153],["ἵνα",706747,7],["κἀγὼ",706969,288],["λαλήσω",708071,165],["ἐρωτήσω",705459,207],["δέ",703303,11],["σε",711598,163],["σὺ",712181,164],["δέ",703303,11],["με",708618,163],["δίδαξον",703649,176]],"But hear me, O Lord, that I also may speak: and I will ask thee, and do thou teach me."],["5",[["ἀκοὴν",700561,9],["μὲν",708730,11],["ὠτὸς",709852,21],["ἤκουόν",700587,333],["σου",711945,133],["τὸ",709436,24],["πρότερον",710991,46],["νυνὶ",709385,28],["δὲ",703303,11],["ὁ",709436,3],["ὀφθαλμός",709870,4],["μου",709032,133],["ἑόρακέν",709725,171],["σε",711598,163]],"I have heard the report of thee by the ear before; but now mine eye has seen thee."],["6",[["διὸ",703714,7],["ἐφαύλισα",713394,155],["ἐμαυτὸν",704545,85],["καὶ",707031,7],["ἐτάκην",712839,156],["ἥγημαι"