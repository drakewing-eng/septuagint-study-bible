[["1",[["βροτὸς",702817,4],["γὰρ",702963,11],["γεννητὸς",703055,14],["γυναικὸς",703209,17],["ὀλιγόβιος",709566,14],["καὶ",707031,7],["πλήρης",710541,14],["ὀργῆς",709728,17]],"For a mortal born of a woman [is] short-lived, and full of wrath."],["2",[["ἢ",705924,7],["ὥσπερ",714163,28],["ἄνθος",701157,15],["ἀνθῆσαν",701152,293],["ἐξέπεσεν",704284,2],["ἀπέδρα",701448,2],["δὲ",703303,11],["ὥσπερ",714163,28],["σκιὰ",711852,12],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["στῇ",706846,172]],"Or he falls like a flower that has bloomed; and he departs like a shadow, and cannot continue."],["3",[["οὐχὶ",709862,28],["καὶ",707031,7],["τούτου",709858,102],["λόγον",708236,6],["ἐποιήσω",710582,174],["καὶ",707031,7],["τοῦτον",709858,85],["ἐποίησας",710582,162],["εἰσελθεῖν",704114,106],["ἐν",704639,0],["κρίματι",707903,54],["ἐνώπιόν",704823,0],["σου",711945,133]],"Hast thou not taken account even of him, and caused him to enter into judgment before thee?"],["4",[["τίς",712867,158],["γὰρ",702963,11],["καθαρὸς",706988,14],["ἔσται",704093,93],["ἀπὸ",701425,0],["ῥύπου",711311,18],["ἀλλ᾿",700680,7],["οὐθείς",709817,29]],"For who shall be pure from uncleanness? not even one;"],["5",[["ἐὰν",703912,7],["καὶ",707031,7],["μία",704106,29],["ἡμέρα",705984,12],["ὁ",709436,3],["βίος",702724,4],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["ἀριθμητοὶ",701743,138],["δὲ",703303,11],["μῆνες",708874,52],["αὐτοῦ",702165,102],["παρὰ",709995,0],["σοί",711925,159],["εἰς",704105,0],["χρόνον",713969,6],["ἔθου",712849,174],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ὑπερβῇ",713125,172]],"if even his life should be [but] one day upon the earth: and his months are numbered by him: thou hast appointed [him] for a time, and he shall by no means exceed [it]."],["6",[["ἀπόστα",702214,176],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["ἵνα",706747,7],["ἡσυχάσῃ",706033,172],["καὶ",707031,7],["εὐδοκήσῃ",705565,172],["τὸν",709436,5],["βίον",702724,6],["ὥσπερ",714163,28],["ὁ",709436,3],["μισθωτός",708942,14]],"Depart from him, that he may be quiet, and take pleasure in his life, [though] as a hireling."],["7",[["ἔστιν",704093,91],["γὰρ",702963,11],["δένδρῳ",703353,54],["ἐλπίς",704530,12],["ἐὰν",703912,7],["γὰρ",702963,11],["ἐκκοπῇ",704225,172],["ἔτι",705538,28],["ἐπανθήσει",705025,127],["καὶ",707031,7],["ὁ",709436,3],["ῥάδαμνος",711146,4],["αὐτοῦ",702165,49],["οὐ",709805,28],["μὴ",708851,28],["ἐκλίπῃ",704237,172]],"For there is hope for a tree, even if it should be cut down, [that] it shall blossom again, and its branch shall not fail."],["8",[["ἐὰν",703912,7],["γὰρ",702963,11],["γηράσῃ",703090,172],["ἐν",704639,0],["γῇ",703083,1],["ἡ",709436,10],["ῥίζα",711260,12],["αὐτοῦ",702165,49],["ἐν",704639,0],["δὲ",703303,11],["πέτρᾳ",710443,1],["τελευτήσῃ",712781,172],["τὸ",709436,34],["στέλεχος",712062,15],["αὐτοῦ",702165,49]],"For though its root should grow old in the earth, and its stem die in the rock;"],["9",[["ἀπὸ",701425,0],["ὀσμῆς",709786,17],["ὕδατος",713071,21],["ἀνθήσει",701152,127],["ποιήσει",710582,127],["δὲ",703303,11],["θερισμὸν",706208,6],["ὥσπερ",714163,28],["νεόφυτον",709260,46]],"it will blossom from the scent of water, and will produce a crop, as one newly planted."],["10",[["ἀνὴρ",701150,4],["δὲ",703303,11],["τελευτήσας",712781,182],["ᾤχετο",709539,19],["πεσὼν",710481,182],["δὲ",703303,11],["βροτὸς",702817,4],["οὐκέτι",709827,28],["ἔστιν",704093,91]],"But a man that has died is utterly gone; and when a mortal has fallen, he is no more."],["11",[["χρόνῳ",713969,114],["γὰρ",702963,11],["σπανίζεται",711991,391],["θάλασσα",706069,12],["ποταμὸς",710693,4],["δὲ",703303,11],["ἐρημωθεὶς",705421,217],["ἐξηράνθη",709419,37]],"For the sea wastes in [length of] time, and a river fails and is dried up."],["12",[["ἄνθρωπος",701163,4],["δὲ",703303,11],["κοιμηθεὶς",707767,217],["οὐ",709805,28],["μὴ",708851,28],["ἀναστῇ",701173,172],["ἕως",705792,7],["ἂν",700900,11],["ὁ",709436,3],["οὐρανὸς",709844,4],["οὐ",709805,28],["μὴ",708851,28],["συρραφῇ",712542,384],["καὶ",707031,7],["οὐκ",709805,28],["ἐξυπνισθήσονται",704979,144,134],["ἐξ",704132,0],["ὕπνου",713181,18],["αὐτῶν",702165,40]],"And man that has lain down [in death] shall certainly not rise again till the heaven be dissolved, and they shall not awake from their sleep."],["13",[["εἰ",704071,7],["γὰρ",702963,11],["ὄφελον",709866,155],["ἐν",704639,0],["ᾅδῃ",700255,114],["με",708618,163],["ἐφύλαξας",713619,162],["ἔκρυψας",707923,162],["δέ",703303,11],["με",708618,163],["ἕως",705792,7],["ἂν",700900,11],["παύσηταί",710202,239],["σου",711945,133],["ἡ",709436,10],["ὀργὴ",709728,12],["καὶ",707031,7],["τάξῃ",712730,172],["μοι",708974,159],["χρόνον",713969,6],["ἐν",704639,0],["ᾧ",709781,309],["μνείαν",708961,9],["μου",709032,133],["ποιήσῃ",710582,123]],"For oh that thou hadst kept me in the grave, and hadst hidden me until thy wrath should cease, and thou shouldest set me a time in which thou wouldest remember me!"],["14",[["ἐὰν",703912,7],["γὰρ",702963,11],["ἀποθάνῃ",701461,172],["ἄνθρωπος",701163,4],["ζήσεται",705851,93],["συντελέσας",712510,182],["ἡμέρας",705984,39],["τοῦ",709436,35],["βίου",702724,18],["αὐτοῦ",702165,102],["ὑπομενῶ",713219,207],["ἕως",705792,7],["ἂν",700900,11],["πάλιν",709942,28],["γένωμαι",703104,410]],"For if a man should die, shall he live [again], having accomplished the days of his life? I will wait till I exist again?"],["15",[["εἶτα",704129,28],["καλέσεις",707084,166],["ἐγὼ",704018,164],["δέ",703303,11],["σοι",711925,159],["ὑπακούσομαι",713096,181],["τὰ",709436,41],["δὲ",703303,11],["ἔργα",705396,42],["τῶν",709436,130],["χειρῶν",713787,65],["σου",711945,133],["μὴ",708851,28],["ἀποποιοῦ",701552,253]],"Then shalt thou call, and I will hearken to thee: but do not thou reject the work of thine hands."],["16",[["ἠρίθμησας",701742,162],["δέ",703303,11],["μου",709032,133],["τὰ",709436,41],["ἐπιτηδεύματα",705301,42],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["παρέλθῃ",710141,172],["σε",711598,163],["οὐδὲν",709817,26],["τῶν",709436,130],["ἁμαρτιῶν",700775,65],["μου",709032,133]],"But thou hast numbered my devices: and not one of my sins shall escape thee?"],["17",[["ἐσφράγισας",712590,162],["δέ",703303,11],["μου",709032,133],["τὰς",709436,38],["ἀνομίας",701192,39],["ἐν",704639,0],["βαλλαντίῳ",702486,54],["ἐπεσημήνω",705244,174],["δέ",703303,11],["εἴ",704071,7],["τι",712866,126],["ἄκων",700622,14],["παρέβην",709996,155]],"And thou hast sealed up my transgressions in a bag, and marked if I have been guilty of any transgression unawares."],["18",[["καὶ",707031,7],["πλὴν",710540,28],["ὄρος",709768,15],["πῖπτον",710481,32],["διαπεσεῖται",703546,127],["καὶ",707031,7],["πέτρα",710443,12],["παλαιωθήσεται",709937,134],["ἐκ",704132,0],["τοῦ",709436,35],["τόπου",712903,18],["αὐτῆς",702165,86]],"And verily a mountain falling will utterly be destroyed, and a rock shall be worn out of its place."],["19",[["λίθους",708196,57],["ἐλέαναν",708118,150],["ὕδατα",713071,64],["καὶ",707031,7],["κατέκλυσεν",707278,2],["ὕδατα",713071,64],["ὕπτια",713265,68],["τοῦ",709436,20],["χώματος",714000,21],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ὑπομονὴν",713226,9],["ἀνθρώπου",701163,18],["ἀπώλεσας",701513,162]],"The waters wear the stones, and waters falling headlong [overflow] a heap of the earth: and thou destroyest the hope of man."],["20",[["ὦσας",714100,162],["αὐτὸν",702165,85],["εἰς",704105,0],["τέλος",712787,25],["καὶ",707031,7],["ᾤχετο",709539,19],["ἐπέστησας",705756,162],["αὐτῷ",702165,50],["τὸ",709436,24],["πρόσωπον",710986,25],["καὶ",707031,7],["ἐξαπέστειλας",704872,162]],"Thou drivest him to an end, and he is gone: thou settest thy face against him, and sendest him away;"],["21",[["πολλῶν",710646,169],["δὲ",703303,11],["γενομένων",703104,490],["τῶν",709436,80],["υἱῶν",713075,81],["αὐτοῦ",702165,102],["οὐκ",709805,28],["οἶδεν",709492,171],["ἐὰν",703912,7],["δὲ",703303,11],["ὀλίγοι",709568,138],["γένωνται",703104,232],["οὐκ",709805,28],["ἐπίσταται",705264,117]],"and though his children be multiplied, he knows [it] not; and if they be few, he is not aware."],["22",[["ἀλλ᾿",700680,7],["ἢ",705924,7],["αἱ",709436,190],["σάρκες",711537,191],["αὐτοῦ",702165,102],["ἤλγησαν",700638,150],["ἡ",709436,10],["δὲ",703303,11],["ψυχὴ",714070,12],["αὐτοῦ",702165,102],["ἐπένθησεν",710251,2]],"But his flesh is in pain, and his soul mourns."]]