[["1",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Βαλδαδ",702480,4],["ὁ",709436,3],["Σαυχίτης",711565,4],["λέγει",708124,91]],"Then Baldad the Sauchite answered and said,"],["2",[["μέχρι",708849,0],["τίνος",712867,308],["οὐ",709805,28],["παύσῃ",710202,123],["ἐπίσχες",705076,176],["ἵνα",706747,7],["καὶ",707031,28],["αὐτοὶ",702165,201],["λαλήσωμεν",708071,79]],"How long wilt thou continue? forbear, that we also may speak."],["3",[["διὰ",703417,0],["τί",712867,126],["ὥσπερ",714163,28],["τετράποδα",712823,195],["σεσιωπήκαμεν",711818,314],["ἐναντίον",704654,0],["σου",711945,133]],"For wherefore have we been silent before thee like brutes?"],["4",[["κέχρηταί",713936,187],["σοι",711925,159],["ὀργή",709728,12],["τί",712867,273],["γάρ",702963,11],["ἐὰν",703912,7],["σὺ",712181,164],["ἀποθάνῃς",701461,175],["ἀοίκητος",701315,29],["ἡ",709436,10],["ὑπ᾿",713184,0],["οὐρανόν",709844,6],["ἢ",705924,7],["καταστραφήσεται",707444,134],["ὄρη",709768,64],["ἐκ",704132,0],["θεμελίων",706181,44]],"Anger has possessed thee: for what if thou shouldest die; would [the earth] under heaven be desolate? or shall the mountains be overthrown from their foundations?"],["5",[["καὶ",707031,28],["φῶς",713642,25],["ἀσεβῶν",701909,169],["σβεσθήσεται",711596,134],["καὶ",707031,7],["οὐκ",709805,28],["ἀποβήσεται",701426,93],["αὐτῶν",702165,40],["ἡ",709436,10],["φλόξ",713524,12]],"But the light of the ungodly shall be quenched, and their flame shall not go up."],["6",[["τὸ",709436,34],["φῶς",713642,15],["αὐτοῦ",702165,102],["σκότος",711889,15],["ἐν",704639,0],["διαίτῃ",703460,1],["ὁ",709436,3],["δὲ",703303,11],["λύχνος",708287,4],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["σβεσθήσεται",711596,134]],"His light [shall be] darkness in [his] habitation, and his lamp shall be put out with him."],["7",[["θηρεύσαισαν",706248,396],["ἐλάχιστοι",704388,480],["τὰ",709436,41],["ὑπάρχοντα",713102,237],["αὐτοῦ",702165,102],["σφάλαι",712575,225],["δὲ",703303,11],["αὐτοῦ",702165,102],["ἡ",709436,10],["βουλή",702792,12]],"Let the meanest of men spoil his goods, and let his counsel deceive [him]."],["8",[["ἐμβέβληται",704547,187],["δὲ",703303,11],["ὁ",709436,3],["ποὺς",710707,4],["αὐτοῦ",702165,102],["ἐν",704639,0],["παγίδι",709910,1],["ἐν",704639,0],["δικτύῳ",703703,54],["ἑλιχθείη",704491,528]],"His foot also has been caught in a snare, [and] let it be entangled in a net."],["9",[["ἔλθοισαν",705453,396],["δὲ",703303,11],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["παγίδες",709910,191],["κατισχύσει",707531,127],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["διψῶντας",703763,235]],"And let snares come upon him: he shall strengthen those that thirst for his destruction."],["10",[["κέκρυπται",707923,187],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["σχοινίον",712610,15],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἡ",709436,10],["σύλλημψις",712265,12],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τρίβων",712939,81]],"His snare is hid in the earth, and that which shall take him is by the path."],["11",[["κύκλῳ",707959,114],["ὀλέσαισαν",709584,396],["αὐτὸν",702165,85],["ὀδύναι",709463,191],["πολλοὶ",710646,138],["δὲ",703303,11],["περὶ",710285,0],["πόδας",710707,57],["αὐτοῦ",702165,102],["ἔλθοισαν",705453,396],["ἐν",704639,0],["λιμῷ",708210,114],["στενῷ",712068,30]],"Let pains destroy him round about, and let many [enemies] come about him,"],["12",[["πτῶμα",711071,15],["δὲ",703303,11],["αὐτῷ",702165,50],["ἡτοίμασται",705539,403],["ἐξαίσιον",704840,26]],"[vex him] with distressing hunger: and a signal destruction has been prepared for him."],["13",[["βρωθείησαν",702722,393],["αὐτοῦ",702165,102],["κλῶνες",707747,52],["ποδῶν",710707,81],["κατέδεται",707519,93],["δὲ",703303,11],["τὰ",709436,41],["ὡραῖα",714132,68],["αὐτοῦ",702165,102],["θάνατος",706096,4]],"Let the soles of his feet be devoured: and death shall consume his beauty."],["14",[["ἐκραγείη",704302,528],["δὲ",703303,11],["ἐκ",704132,0],["διαίτης",703460,17],["αὐτοῦ",702165,102],["ἴασις",706444,12],["σχοίη",705785,225],["δὲ",703303,11],["αὐτὸν",702165,85],["ἀνάγκη",700925,12],["αἰτίᾳ",700492,1],["βασιλικῇ",702582,101]],"And let health be utterly banished from his tabernacle, and let distress seize upon him with a charge from the king."],["15",[["κατασκηνώσει",707423,127],["ἐν",704639,0],["τῇ",709436,100],["σκηνῇ",711845,1],["αὐτοῦ",702165,102],["ἐν",704639,0],["νυκτὶ",709386,1],["αὐτοῦ",702165,102],["κατασπαρήσονται",707432,144],["τὰ",709436,63],["εὐπρεπῆ",705667,195],["αὐτοῦ",702165,102],["θείῳ",706153,54]],"It shall dwell in his tabernacle in his night: his excellency shall be sown with brimstone."],["16",[["ὑποκάτωθεν",713205,28],["αἱ",709436,190],["ῥίζαι",711260,191],["αὐτοῦ",702165,102],["ξηρανθήσονται",709419,144],["καὶ",707031,7],["ἐπάνωθεν",705032,28],["ἐπιπεσεῖται",705225,93],["θερισμὸς",706208,4],["αὐτοῦ",702165,102]],"His roots shall be dried up from beneath, and his crop shall fall away from above."],["17",[["τὸ",709436,34],["μνημόσυνον",708966,15],["αὐτοῦ",702165,102],["ἀπόλοιτο",701513,382],["ἐκ",704132,0],["γῆς",703083,17],["καὶ",707031,7],["ὑπάρχει",713104,91],["ὄνομα",709666,15],["αὐτῷ",702165,50],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["ἐξωτέρω",704987,28]],"Let his memorial perish out of the earth, and his name shall be publicly cast out."],["18",[["ἀπώσειεν",701659,225],["αὐτὸν",702165,85],["ἐκ",704132,0],["φωτὸς",713642,21],["εἰς",704105,0],["σκότος",711889,25]],"Let [one] drive him from light into darkness."],["19",[["οὐκ",709805,28],["ἔσται",704093,93],["ἐπίγνωστος",705108,14],["ἐν",704639,0],["λαῷ",708094,114],["αὐτοῦ",702165,102],["οὐδὲ",709816,7],["σεσῳσμένος",712627,251],["ἐν",704639,0],["τῇ",709436,100],["ὑπ᾿",713184,0],["οὐρανὸν",709844,6],["ὁ",709436,3],["οἶκος",709516,4],["αὐτοῦ",702165,102],["ἀλλ᾿",700680,7],["ἐν",704639,0],["τοῖς",709436,95],["αὐτοῦ",702165,102],["ζήσονται",705851,135],["ἕτεροι",705535,138]],"He shall not be known among his people, nor his house preserved on the earth."],["20",[["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["ἐστέναξαν",712066,150],["ἔσχατοι",705519,138],["πρώτους",711041,612],["δὲ",703303,11],["ἔσχεν",705785,2],["θαῦμα",706134,15]],"But strangers shall dwell in his possessions: the last groaned for him, and wonder seized the first.",{"s":"d","q":0.46}],["21",[["οὗτοί",709858,201],["εἰσιν",704093,197],["οἶκοι",709516,52],["ἀδίκων",700272,169],["οὗτος",709858,121],["δὲ",703303,11],["ὁ",709436,3],["τόπος",712903,4],["τῶν",709436,80],["μὴ",708851,28],["εἰδότων",709492,387],["τὸν",709436,5],["κύριον",707996,6]],"These are the houses of the unrighteous, and this is the place of them that know not the Lord."]]