[["1",[["ἔτι",705538,28],["δὲ",703303,11],["προσθεὶς",710965,182],["Ιωβ",706903,4],["εἶπεν",705373,2],["τῷ",709436,53],["προοιμίῳ",710831,54]],"And Job further continued and said in his parable,"],["2",[["ζῇ",705851,91],["κύριος",707996,4],["ὃς",709781,213],["οὕτω",709859,28],["με",708618,163],["κέκρικεν",707905,171],["καὶ",707031,7],["ὁ",709436,3],["παντοκράτωρ",709986,4],["ὁ",709436,3],["πικράνας",710469,182],["μου",709032,133],["τὴν",709436,8],["ψυχήν",714070,9]],"[As] God lives, who has thus judged me; and the Almighty, who has embittered my soul;"],["3",[["ἦ",705925,28],["μὴν",708873,11],["ἔτι",705538,28],["τῆς",709436,16],["πνοῆς",710574,17],["μου",709032,133],["ἐνούσης",704707,222],["πνεῦμα",710566,15],["δὲ",703303,11],["θεῖον",706154,26],["τὸ",709436,34],["περιόν",710310,32],["μοι",708974,159],["ἐν",704639,0],["ῥισίν",711268,76]],"verily, while my breath is yet in [me], and the breath of God which remains to me is in my nostrils,"],["4",[["μὴ",708851,28],["λαλήσειν",708071,296],["τὰ",709436,41],["χείλη",713781,42],["μου",709032,133],["ἄνομα",701194,68],["οὐδὲ",709816,7],["ἡ",709436,10],["ψυχή",714070,12],["μου",709032,133],["μελετήσει",708698,127],["ἄδικα",700272,68]],"my lips shall not speak evil words, neither shall my soul meditate unrighteous thoughts."],["5",[["μή",708851,28],["μοι",708974,159],["εἴη",704093,301],["δικαίους",703694,60],["ὑμᾶς",713080,194],["ἀποφῆναι",701631,106],["ἕως",705792,7],["ἂν",700900,11],["ἀποθάνω",701461,207],["οὐ",709805,28],["γὰρ",702963,11],["ἀπαλλάξω",701333,165],["μου",709032,133],["τὴν",709436,8],["ἀκακίαν",700511,9]],"Far be it from me that I should justify you till I die; for I will not let go my innocence,"],["6",[["δικαιοσύνῃ",703695,1],["δὲ",703303,11],["προσέχων",710895,72],["οὐ",709805,28],["μὴ",708851,28],["προῶμαι",710802,410],["οὐ",709805,28],["γὰρ",702963,11],["σύνοιδα",712433,89],["ἐμαυτῷ",704545,50],["ἄτοπα",702102,68],["πράξας",710721,182]],"but keeping fast to [my] righteousness I will by no means let it go: for I am not conscious to myself of having done any thing amiss."],["7",[["οὐ",709805,28],["μὴν",708873,11],["δὲ",703303,11],["ἀλλὰ",700680,7],["εἴησαν",704093,701],["οἱ",709436,136],["ἐχθροί",705779,52],["μου",709032,133],["ὥσπερ",714163,28],["ἡ",709436,10],["καταστροφὴ",707445,12],["τῶν",709436,80],["ἀσεβῶν",701909,169],["καὶ",707031,7],["οἱ",709436,136],["ἐπ᾿",705080,0],["ἐμὲ",704555,163],["ἐπανιστανόμενοι",705026,317],["ὥσπερ",714163,28],["ἡ",709436,10],["ἀπώλεια",701660,12],["τῶν",709436,80],["παρανόμων",710080,169]],"Nay rather, but let mine enemies be as the overthrow of the ungodly, and they that rise up against me, as the destruction of transgressors."],["8",[["καὶ",707031,7],["τίς",712867,158],["γάρ",702963,11],["ἐστιν",704093,91],["ἐλπὶς",704530,12],["ἀσεβεῖ",701909,30],["ὅτι",709803,7],["ἐπέχει",705076,91],["πεποιθὼς",710221,270],["ἐπὶ",705080,0],["κύριον",707996,6],["ἆρα",701667,11],["σωθήσεται",712627,134]],"For what is the hope of the ungodly, that he holds to it? will he indeed trust in the Lord [and] be saved?"],["9",[["ἦ",705925,28],["τὴν",709436,8],["δέησιν",703311,9],["αὐτοῦ",702165,102],["εἰσακούσεται",704108,93],["κύριος",707996,4],["ἢ",705924,7],["ἐπελθούσης",705068,494],["αὐτῷ",702165,50],["ἀνάγκης",700925,17]],"Will God hear his prayer? or, when distress has come upon him,"],["10",[["μὴ",708851,28],["ἔχει",705785,91],["τινὰ",712866,356],["παρρησίαν",710173,9],["ἔναντι",704653,0],["αὐτοῦ",702165,102],["ἢ",705924,7],["ὡς",714148,7],["ἐπικαλεσαμένου",705153,292],["αὐτοῦ",702165,102],["εἰσακούσεται",704108,93],["αὐτοῦ",702165,102]],"has he any confidence before him? or will [God] hear him as he calls upon him?"],["11",[["ἀλλὰ",700680,7],["δὴ",703395,11],["ἀναγγελῶ",700921,165],["ὑμῖν",713084,90],["τί",712867,126],["ἐστιν",704093,91],["ἐν",704639,0],["χειρὶ",713787,1],["κυρίου",707996,18],["ἅ",709781,69],["ἐστιν",704093,91],["παρὰ",709995,0],["παντοκράτορι",709986,114],["οὐ",709805,28],["ψεύσομαι",714045,181]],"Yet now I will tell you what is in the hand of the Lord: I will not lie concerning the things which are with the Almighty."],["12",[["ἰδοὺ",706497,88],["δὴ",703395,11],["πάντες",710177,138],["οἴδατε",709492,756],["ὅτι",709803,7],["κενὰ",707612,68],["κενοῖς",707612,230],["ἐπιβάλλετε",705083,87]],"Behold, ye all know that ye are adding vanity to vanity."],["13",[["αὕτη",709858,107],["ἡ",709436,10],["μερὶς",708748,12],["ἀνθρώπου",701163,18],["ἀσεβοῦς",701909,116],["παρὰ",709995,0],["κυρίου",707996,18],["κτῆμα",707933,15],["δὲ",703303,11],["δυναστῶν",703844,81],["ἐλεύσεται",705453,93],["παρὰ",709995,0],["παντοκράτορος",709986,18],["ἐπ᾿",705080,0],["αὐτούς",702165,62]],"This is the portion of an ungodly man from the Lord, and the possession of oppressors shall come upon them from the Almighty."],["14",[["ἐὰν",703912,7],["δὲ",703303,11],["πολλοὶ",710646,138],["γένωνται",703104,232],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτοῦ",702165,102],["εἰς",704105,0],["σφαγὴν",712568,9],["ἔσονται",704093,135],["ἐὰν",703912,7],["δὲ",703303,11],["καὶ",707031,7],["ἀνδρωθῶσιν",701111,272],["προσαιτήσουσιν",710849,218]],"And if their children be many, they shall be for slaughter: and if they grow up, they shall beg."],["15",[["οἱ",709436,136],["δὲ",703303,11],["περιόντες",710310,146],["αὐτοῦ",702165,102],["ἐν",704639,0],["θανάτῳ",706096,114],["τελευτήσουσιν",712781,218],["χήρας",713848,17],["δὲ",703303,11],["αὐτῶν",702165,40],["οὐθεὶς",709817,29],["ἐλεήσει",704418,127]],"And they that survive of him shall utterly perish, and no one shall pity their widows."],["16",[["ἐὰν",703912,7],["συναγάγῃ",712375,172],["ὥσπερ",714163,28],["γῆν",703083,9],["ἀργύριον",701707,25],["ἴσα",706832,28],["δὲ",703303,11],["πηλῷ",710457,114],["ἑτοιμάσῃ",705539,123],["χρυσίον",713972,25]],"Even if he should gather silver as earth, and prepare gold as clay;"],["17",[["ταῦτα",709858,71],["πάντα",710177,68],["δίκαιοι",703694,138],["περιποιήσονται",710367,135],["τὰ",709436,41],["δὲ",703303,11],["χρήματα",713948,42],["αὐτοῦ",702165,102],["ἀληθινοὶ",700659,138],["καθέξουσιν",707526,218]],"all these things shall the righteous gain, and the truehearted shall possess his wealth."],["18",[["ἀπέβη",701426,2],["δὲ",703303,11],["ὁ",709436,3],["οἶκος",709516,4],["αὐτοῦ",702165,102],["ὥσπερ",714163,28],["σῆτες",711756,52],["καὶ",707031,7],["ὥσπερ",714163,28],["ἀράχνη",701693,12]],"And his house is gone like moths, and like a spider's web."],["19",[["πλούσιος",710560,14],["κοιμηθεὶς",707767,217],["καὶ",707031,7],["οὐ",709805,28],["προσθήσει",710965,127],["ὀφθαλμοὺς",709870,57],["αὐτοῦ",702165,102],["διήνοιξεν",703532,2],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91]],"The rich man shall lie down, and shall not continue: he has opened his eyes, and he is not."],["20",[["συνήντησαν",712394,150],["αὐτῷ",702165,50],["ὥσπερ",714163,28],["ὕδωρ",713071,15],["αἱ",709436,190],["ὀδύναι",709463,191],["νυκτὶ",709386,1],["δὲ",703303,11],["ὑφείλατο",713276,23],["αὐτὸν",702165,85],["γνόφος",703131,4]],"Pains have come upon him as water, and darkness has carried him away by night."],["21",[["ἀναλήμψεται",700984,93],["αὐτὸν",702165,85],["καύσων",707049,512],["καὶ",707031,7],["ἀπελεύσεται",701398,93],["καὶ",707031,7],["λικμήσει",708202,127],["αὐτὸν",702165,85],["ἐκ",704132,0],["τοῦ",709436,35],["τόπου",712903,18],["αὐτοῦ",702165,102]],"And a burning wind shall catch him, and he shall depart, and it shall utterly drive him out of his place."],["22",[["καὶ",707031,7],["ἐπιρρίψει",705238,127],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["καὶ",707031,7],["οὐ",709805,28],["φείσεται",713406,93],["ἐκ",704132,0],["χειρὸς",713787,17],["αὐτοῦ",702165,102],["φυγῇ",713609,1],["φεύξεται",713433,93]],"And [God] shall cast [trouble] upon him, and not spare: he would fain flee out of his hand."],["23",[["κροτήσει",707918,127],["ἐπ᾿",705080,0],["αὐτοῦ",702165,102],["χεῖρας",713787,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["συριεῖ",712538,127],["αὐτὸν",702165,85],["ἐκ",704132,0],["τοῦ",709436,35],["τόπου",712903,18],["αὐτοῦ",702165,49]],"He shall cause [men] to clap their hands against them, and shall hiss him out of his place."]]