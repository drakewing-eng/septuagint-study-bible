[["1",[["μετὰ",708780,0],["δὲ",703303,11],["τὸ",709436,24],["παύσασθαι",710202,109],["Ελιουν",704478,6],["τῆς",709436,16],["λέξεως",708144,17],["εἶπεν",705373,2],["ὁ",709436,3],["κύριος",707996,4],["τῷ",709436,113],["Ιωβ",706903,114],["διὰ",703417,0],["λαίλαπος",708061,17],["καὶ",707031,7],["νεφῶν",709281,44]],"And after Elius had ceased from speaking, the Lord spoke to Job through the whirlwind and clouds, [saying],"],["2",[["τίς",712867,158],["οὗτος",709858,121],["ὁ",709436,3],["κρύπτων",707923,72],["με",708618,163],["βουλήν",702792,9],["συνέχων",712469,72],["δὲ",703303,11],["ῥήματα",711246,42],["ἐν",704639,0],["καρδίᾳ",707141,1],["ἐμὲ",704555,163],["δὲ",703303,11],["οἴεται",709534,117],["κρύπτειν",707923,55]],"Who is this that hides counsel from me, and confines words in [his] heart, and thinks to conceal [them] from me?"],["3",[["ζῶσαι",705913,300],["ὥσπερ",714163,28],["ἀνὴρ",701150,4],["τὴν",709436,8],["ὀσφύν",709800,9],["σου",711945,133],["ἐρωτήσω",705459,207],["δέ",703303,11],["σε",711598,163],["σὺ",712181,164],["δέ",703303,11],["μοι",708974,159],["ἀποκρίθητι",701492,244]],"Gird thy loins like a man; and I will ask thee, and do thou answer me."],["4",[["ποῦ",710706,28],["ἦς",704093,757],["ἐν",704639,0],["τῷ",709436,53],["θεμελιοῦν",706182,55],["με",708618,163],["τὴν",709436,8],["γῆν",703083,9],["ἀπάγγειλον",701321,176],["δέ",703303,11],["μοι",708974,159],["εἰ",704071,7],["ἐπίστῃ",705264,278],["σύνεσιν",712460,9]],"Where wast thou when I founded the earth? tell me now, if thou hast knowledge,"],["5",[["τίς",712867,158],["ἔθετο",712849,23],["τὰ",709436,41],["μέτρα",708846,42],["αὐτῆς",702165,86],["εἰ",704071,7],["οἶδας",709492,266],["ἢ",705924,7],["τίς",712867,158],["ὁ",709436,3],["ἐπαγαγὼν",704994,182],["σπαρτίον",711999,25],["ἐπ᾿",705080,0],["αὐτῆς",702165,86]],"who set the measures of it, if thou knowest? or who stretched a line upon it?"],["6",[["ἐπὶ",705080,0],["τίνος",712867,340],["οἱ",709436,136],["κρίκοι",707902,52],["αὐτῆς",702165,86],["πεπήγασιν",710452,353],["τίς",712867,158],["δέ",703303,11],["ἐστιν",704093,91],["ὁ",709436,3],["βαλὼν",702487,182],["λίθον",708196,6],["γωνιαῖον",703227,27],["ἐπ᾿",705080,0],["αὐτῆς",702165,86]],"On what are its rings fastened? and who is he that laid the corner-stone upon it?"],["7",[["ὅτε",709802,28],["ἐγενήθησαν",703104,99],["ἄστρα",702024,64],["ᾔνεσάν",700459,150],["με",708618,163],["φωνῇ",713640,1],["μεγάλῃ",708653,101],["πάντες",710177,138],["ἄγγελοί",700140,52],["μου",709032,133]],"When the stars were made, all my angels praised me with a loud voice."],["8",[["ἔφραξα",713575,155],["δὲ",703303,11],["θάλασσαν",706069,9],["πύλαις",711082,76],["ὅτε",709802,28],["ἐμαίμασσεν",708387,2],["ἐκ",704132,0],["κοιλίας",707761,17],["μητρὸς",708892,17],["αὐτῆς",702165,86],["ἐκπορευομένη",704293,211]],"And I shut up the sea with gates, when it rushed out, coming forth out of its mother's womb."],["9",[["ἐθέμην",712849,161],["δὲ",703303,11],["αὐτῇ",702165,105],["νέφος",709281,25],["ἀμφίασιν",700882,6],["ὁμίχλῃ",709615,1],["δὲ",703303,11],["αὐτὴν",702165,104],["ἐσπαργάνωσα",711996,155]],"And I made a cloud its clothing, and swathed it in mist."],["10",[["ἐθέμην",712849,161],["δὲ",703303,11],["αὐτῇ",702165,105],["ὅρια",709749,42],["περιθεὶς",710403,182],["κλεῖθρα",707708,42],["καὶ",707031,7],["πύλας",711082,39]],"And I set bounds to it, surrounding it with bars and gates."],["11",[["εἶπα",705373,155],["δὲ",703303,11],["αὐτῇ",702165,105],["μέχρι",708849,0],["τούτου",709858,102],["ἐλεύσῃ",705453,123],["καὶ",707031,7],["οὐχ",709805,28],["ὑπερβήσῃ",713125,123],["ἀλλ᾿",700680,7],["ἐν",704639,0],["σεαυτῇ",711599,105],["συντριβήσεταί",712520,134],["σου",711945,133],["τὰ",709436,63],["κύματα",707968,64]],"And I said to it, Hitherto shalt thou come, but thou shalt not go beyond, but thy waves shall be confined within thee."],["12",[["ἦ",705925,28],["ἐπὶ",705080,0],["σοῦ",711945,133],["συντέταχα",712508,89],["φέγγος",713404,25],["πρωινόν",711024,46],["ἑωσφόρος",705793,4],["δὲ",703303,11],["εἶδεν",709725,2],["τὴν",709436,8],["ἑαυτοῦ",703917,102],["τάξιν",712712,9]],"Or did I order the morning light in thy time; and [did] the morning star [then first] see his appointed place;"],["13",[["ἐπιλαβέσθαι",705185,109],["πτερύγων",711057,65],["γῆς",703083,17],["ἐκτινάξαι",704334,106],["ἀσεβεῖς",701909,60],["ἐξ",704132,0],["αὐτῆς",702165,86]],"to lay hold of the extremities of the earth, to cast out the ungodly out of it?"],["14",[["ἦ",705925,28],["σὺ",712181,164],["λαβὼν",708076,182],["γῆν",703083,9],["πηλὸν",710457,6],["ἔπλασας",710503,162],["ζῷον",705916,25],["καὶ",707031,7],["λαλητὸν",708073,6],["αὐτὸν",702165,85],["ἔθου",712849,174],["ἐπὶ",705080,0],["γῆς",703083,17]],"Or didst thou take clay of the ground, and form a living creature, and set it with the power of speech upon the earth?"],["15",[["ἀφεῖλας",702177,162],["δὲ",703303,11],["ἀπὸ",701425,0],["ἀσεβῶν",701909,169],["τὸ",709436,24],["φῶς",713642,25],["βραχίονα",702808,6],["δὲ",703303,11],["ὑπερηφάνων",713139,169],["συνέτριψας",712520,162]],"And hast thou removed light from the ungodly, and crushed the arm of the proud?"],["16",[["ἦλθες",705453,162],["δὲ",703303,11],["ἐπὶ",705080,0],["πηγὴν",710450,9],["θαλάσσης",706069,17],["ἐν",704639,0],["δὲ",703303,11],["ἴχνεσιν",706873,96],["ἀβύσσου",700098,17],["περιεπάτησας",710362,162]],"Or hast thou gone to the source of the sea, and walked in the tracks of the deep?"],["17",[["ἀνοίγονται",701186,269],["δέ",703303,11],["σοι",711925,159],["φόβῳ",713534,114],["πύλαι",711082,191],["θανάτου",706096,18],["πυλωροὶ",711084,52],["δὲ",703303,11],["ᾅδου",700255,18],["ἰδόντες",709725,196],["σε",711598,163],["ἔπτηξαν",711060,150]],"And do the gates of death open to thee for fear; and did the porters of hell quake when they saw thee?"],["18",[["νενουθέτησαι",709367,724],["δὲ",703303,11],["τὸ",709436,24],["εὖρος",705677,25],["τῆς",709436,16],["ὑπ᾿",713184,0],["οὐρανόν",709844,6],["ἀνάγγειλον",700921,176],["δή",703395,11],["μοι",708974,159],["πόση",710692,29],["τίς",712867,158],["ἐστιν",704093,91]],"And hast thou been instructed in the breadth of the [whole earth] under heaven? tell me now, what is the extent of it?"],["19",[["ποίᾳ",710599,101],["δὲ",703303,11],["γῇ",703083,1],["αὐλίζεται",702138,117],["τὸ",709436,34],["φῶς",713642,15],["σκότους",711889,21],["δὲ",703303,11],["ποῖος",710599,14],["ὁ",709436,3],["τόπος",712903,4]],"And in what kind of a land does the light dwell? and of what kind is the place of darkness?"],["20",[["εἰ",704071,7],["ἀγάγοις",700209,657],["με",708618,163],["εἰς",704105,0],["ὅρια",709749,42],["αὐτῶν",702165,40],["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["ἐπίστασαι",705264,259],["τρίβους",712939,39],["αὐτῶν",702165,40]],"If thou couldest bring me to their [utmost] boundaries, and if also thou knowest their paths;"],["21",[["οἶδα",709492,89],["ἄρα",701666,11],["ὅτι",709803,7],["τότε",712908,28],["γεγέννησαι",703051,332],["ἀριθμὸς",701744,4],["δὲ",703303,11],["ἐτῶν",705543,44],["σου",711945,133],["πολύς",710646,14]],"I know then that thou wert born at that time, and the number of thy years is great."],["22",[["ἦλθες",705453,162],["δὲ",703303,11],["ἐπὶ",705080,0],["θησαυροὺς",706258,57],["χιόνος",713870,17],["θησαυροὺς",706258,57],["δὲ",703303,11],["χαλάζης",713667,17],["ἑόρακας",709725,266]],"But hast thou gone to the treasures of snow? and hast thou seen the treasures of hail?"],["23",[["ἀπόκειται",701476,117],["δέ",703303,11],["σοι",711925,159],["εἰς",704105,0],["ὥραν",714128,9],["ἐχθρῶν",705779,81],["εἰς",704105,0],["ἡμέραν",705984,9],["πολέμου",710605,18],["καὶ",707031,7],["μάχης",708601,17]],"And is there a store [of them], for thee against the time of [thine] enemies, for the day of wars and battle?"],["24",[["πόθεν",710580,28],["δὲ",703303,11],["ἐκπορεύεται",704293,117],["πάχνη",710203,12],["ἢ",705924,7],["διασκεδάννυται",703575,391],["νότος",709364,4],["εἰς",704105,0],["τὴν",709436,8],["ὑπ᾿",713184,0],["οὐρανόν",709844,6]],"And whence proceeds the frost? or [whence] is the south wind dispersed over the [whole world] under heaven?"],["25",[["τίς",712867,158],["δὲ",703303,11],["ἡτοίμασεν",705539,2],["ὑετῷ",713074,114],["λάβρῳ",708047,30],["ῥύσιν",711312,9],["ὁδὸν",709458,9],["δὲ",703303,11],["κυδοιμῶν",707951,72]],"And who prepared a course for the violent rain, and a way for the thunders;"],["26",[["τοῦ",709436,20],["ὑετίσαι",713073,106],["ἐπὶ",705080,0],["γῆν",703083,9],["οὗ",709781,48],["οὐκ",709805,28],["ἀνήρ",701150,4],["ἔρημον",705420,9],["οὗ",709781,48],["οὐχ",709805,28],["ὑπάρχει",713104,91],["ἄνθρωπος",701163,4],["ἐν",704639,0],["αὐτῇ",702165,105]],"to rain upon the land where [there is] no man, the wilderness, where there is not a man in it; so as to feed the untrodden and uninhabited [land],"],["27",[["τοῦ",709436,20],["χορτάσαι",713919,106],["ἄβατον",700023,27],["καὶ",707031,7],["ἀοίκητον",701315,27],["καὶ",707031,7],["τοῦ",709436,20],["ἐκβλαστῆσαι",704150,106],["ἔξοδον",704948,9],["χλόης",713877,17]],"and cause it to send forth a crop of green herbs?"],["28",[["τίς",712867,158],["ἐστιν",704093,91],["ὑετοῦ",713074,18],["πατήρ",710189,4],["τίς",712867,158],["δέ",703303,11],["ἐστιν",704093,91],["ὁ",709436,3],["τετοκὼς",712853,270],["βώλους",702839,39],["δρόσου",703835,17]],"Who is the rain's father? and who has generated the drops of dew?"],["29",[["ἐκ",704132,0],["γαστρὸς",702976,17],["δὲ",703303,11],["τίνος",712867,340],["ἐκπορεύεται",704293,117],["ὁ",709436,3],["κρύσταλλος",707926,4],["πάχνην",710203,9],["δὲ",703303,11],["ἐν",704639,0],["οὐρανῷ",709844,114],["τίς",712867,158],["τέτοκεν",712853,171]],"And out of whose womb comes the ice? and who has produced the frost in the sky,"],["30",[["ἣ",709781,177],["καταβαίνει",707202,91],["ὥσπερ",714163,28],["ὕδωρ",713071,15],["ῥέον",711241,32],["πρόσωπον",710986,25],["δὲ",703303,11],["ἀβύσσου",700098,17],["τίς",712867,158],["ἔπηξεν",710452,2]],"which descends like flowing water? who has terrified the face of the ungodly?",{"s":"d","q":0.67}],["31",[["συνῆκας",712481,162],["δὲ",703303,11],["δεσμὸν",703372,6],["Πλειάδος",710511,18],["καὶ",707031,7],["φραγμὸν",713572,6],["Ὠρίωνος",714140,18],["ἤνοιξας",701186,162]],"And dost thou understand the band of Pleias, and hast thou opened the barrier of Orion?"],["32",[["ἦ",705925,28],["διανοίξεις",703532,166],["μαζουρωθ",708368,6],["ἐν",704639,0],["καιρῷ",707047,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["Ἕσπερον",705503,6],["ἐπὶ",705080,0],["κόμης",707803,17],["αὐτοῦ",702165,102],["ἄξεις",700209,166],["αὐτά",702165,71]],"Or wilt thou reveal Mazuroth in his season, and the evening star with his rays? Wilt thou guide them?"],["33",[["ἐπίστασαι",705264,259],["δὲ",703303,11],["τροπὰς",712978,39],["οὐρανοῦ",709844,18],["ἢ",705924,7],["τὰ",709436,41],["ὑπ᾿",713184,0],["οὐρανὸν",709844,6],["ὁμοθυμαδὸν",709624,28],["γινόμενα",703104,67]],"And knowest thou the changes of heaven, or the events which take place together under heaven?"],["34",[["καλέσεις",707084,166],["δὲ",703303,11],["νέφος",709281,25],["φωνῇ",713640,1],["καὶ",707031,7],["τρόμῳ",712975,114],["ὕδατος",713071,21],["λάβρῳ",708047,30],["ὑπακούσεταί",713096,93],["σου",711945,133]],"And wilt thou call a cloud with thy voice, and will it obey thee with a violent shower of much rain?"],["35",[["ἀποστελεῖς",701592,166],["δὲ",703303,11],["κεραυνοὺς",707631,57],["καὶ",707031,7],["πορεύσονται",710667,135],["ἐροῦσιν",705415,218],["δέ",703303,11],["σοι",711925,159],["τί",712867,273],["ἐστιν",704093,91]],"And wilt thou send lightnings, and they shall go? and shall they say to thee, What is [thy pleasure]?"],["36",[["τίς",712867,158],["δὲ",703303,11],["ἔδωκεν",703654,2],["γυναιξὶν",703209,76],["ὑφάσματος",713280,21],["σοφίαν",711981,9],["ἢ",705924,7],["ποικιλτικὴν",710591,36],["ἐπιστήμην",705267,9]],"And who has given to women skill in weaving, or knowledge of embroidery?"],["37",[["τίς",712867,158],["δὲ",703303,11],["ὁ",709436,3],["ἀριθμῶν",701742,72],["νέφη",709281,42],["σοφίᾳ",711981,1],["οὐρανὸν",709844,6],["δὲ",703303,11],["εἰς",704105,0],["γῆν",703083,9],["ἔκλινεν",707738,13]],"And who is he that numbers the clouds in wisdom, and has bowed the heaven [down] to the earth?"],["38",[["κέχυται",713845,187],["δὲ",703303,11],["ὥσπερ",714163,28],["γῆ",703083,12],["κονία",707811,12],["κεκόλληκα",707791,89],["δὲ",703303,11],["αὐτὸν",702165,85],["ὥσπερ",714163,28],["λίθῳ",708196,114],["κύβον",707949,6]],"For it is spread out as dusty earth, and I have cemented it as one hewn stone to another."],["39",[["θηρεύσεις",706248,166],["δὲ",703303,11],["λέουσιν",708171,148],["βοράν",702762,9],["ψυχὰς",714070,39],["δὲ",703303,11],["δρακόντων",703822,81],["ἐμπλήσεις",704592,166]],"And wilt thou hunt a prey for the lions? and satisfy the desires of the serpents?"],["40",[["δεδοίκασιν",703313,353],["γὰρ",702963,11],["ἐν",704639,0],["κοίταις",707781,76],["αὐτῶν",702165,40],["κάθηνται",707000,269],["δὲ",703303,11],["ἐν",704639,0],["ὕλαις",713077,76],["ἐνεδρεύοντες",704703,146]],"For they fear in their lairs, and lying in wait couch in the woods."],["41",[["τίς",712867,158],["δὲ",703303,11],["ἡτοίμασεν",705539,2],["κόρακι",707831,114],["βοράν",702762,9],["νεοσσοὶ",709257,52],["γὰρ",702963,11],["αὐτοῦ",702165,102],["πρὸς",710844,0],["κύριον",707996,6],["κεκράγασιν",707868,353],["πλανώμενοι",710495,348],["τὰ",709436,41],["σῖτα",711814,42],["ζητοῦντες",705879,146]],"And who has prepared food for the raven? for its young ones wander and cry to the Lord, in search of food."]]