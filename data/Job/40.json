[["1",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τῷ",709436,113],["Ιωβ",706903,114],["καὶ",707031,7],["εἶπεν",705373,2]],"And the Lord God answered Job, and said,"],["2",[["μὴ",708851,28],["κρίσιν",707908,9],["μετὰ",708780,0],["ἱκανοῦ",706710,116],["ἐκκλινεῖ",704220,127],["ἐλέγχων",704416,72],["θεὸν",706192,6],["ἀποκριθήσεται",701492,134],["αὐτήν",702165,104]],"Will [any one] pervert judgment with the Mighty One? and he that reproves God, let him return it for answer."],["3",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Ιωβ",706903,4],["λέγει",708124,91],["τῷ",709436,113],["κυρίῳ",707996,114]],"And Job answered and said to the Lord,"],["4",[["τί",712867,126],["ἔτι",705538,28],["ἐγὼ",704018,164],["κρίνομαι",707905,254],["νουθετούμενος",709367,466],["καὶ",707031,7],["ἐλέγχων",704416,72],["κύριον",707996,6],["ἀκούων",700587,72],["τοιαῦτα",712878,68],["οὐθὲν",709817,46],["ὤν",704093,72],["ἐγὼ",704018,164],["δὲ",703303,11],["τίνα",712867,356],["ἀπόκρισιν",701493,9],["δῶ",703654,207],["πρὸς",710844,0],["ταῦτα",709858,71],["χεῖρα",713787,9],["θήσω",712849,165],["ἐπὶ",705080,0],["στόματί",712125,54],["μου",709032,133]],"Why do I yet plead? being rebuked even while reproving the Lord: hearing such things, whereas I am nothing: and what shall I answer to these [arguments]? I will lay my hand upon my mouth."],["5",[["ἅπαξ",701350,28],["λελάληκα",708071,89],["ἐπὶ",705080,0],["δὲ",703303,11],["τῷ",709436,113],["δευτέρῳ",703389,30],["οὐ",709805,28],["προσθήσω",710965,165]],"I have spoken once; but I will not do so a second time."],["6",[["ἔτι",705538,28],["δὲ",703303,11],["ὑπολαβὼν",713210,182],["ὁ",709436,3],["κύριος",707996,4],["εἶπεν",705373,2],["τῷ",709436,113],["Ιωβ",706903,114],["ἐκ",704132,0],["τοῦ",709436,20],["νέφους",709281,21]],"And the Lord yet again answered and spoke to Job out of the cloud, [saying],"],["7",[["μή",708851,28],["ἀλλὰ",700680,7],["ζῶσαι",705913,300],["ὥσπερ",714163,28],["ἀνὴρ",701150,4],["τὴν",709436,8],["ὀσφύν",709800,9],["σου",711945,133],["ἐρωτήσω",705459,207],["δέ",703303,11],["σε",711598,163],["σὺ",712181,164],["δέ",703303,11],["μοι",708974,159],["ἀποκρίθητι",701492,244]],"Nay, gird up now thy loins like a man; and I will ask thee, and do thou answer me."],["8",[["μὴ",708851,28],["ἀποποιοῦ",701552,253],["μου",709032,133],["τὸ",709436,24],["κρίμα",707903,25],["οἴει",709534,259],["δέ",703303,11],["με",708618,163],["ἄλλως",700711,28],["σοι",711925,159],["κεχρηματικέναι",713949,115],["ἢ",705924,7],["ἵνα",706747,7],["ἀναφανῇς",701080,279],["δίκαιος",703694,14]],"Do not set aside my judgment: and dost thou think that I have dealt with thee in any other way, than that thou mightest appear to be righteous?"],["9",[["ἦ",705925,28],["βραχίων",702808,4],["σοί",711925,159],["ἐστιν",704093,91],["κατὰ",707200,0],["τοῦ",709436,35],["κυρίου",707996,18],["ἢ",705924,7],["φωνῇ",713640,1],["κατ᾿",707200,0],["αὐτὸν",702165,85],["βροντᾷς",702815,154]],"Hast thou an arm like the Lord's? or dost thou thunder with a voice like his?"],["10",[["ἀνάλαβε",700984,176],["δὴ",703395,11],["ὕψος",713288,25],["καὶ",707031,7],["δύναμιν",703839,9],["δόξαν",703791,9],["δὲ",703303,11],["καὶ",707031,7],["τιμὴν",712856,9],["ἀμφίεσαι",700886,300]],"Assume now a lofty bearing and power; and clothe thyself with glory and honour."],["11",[["ἀπόστειλον",701592,176],["δὲ",703303,11],["ἀγγέλους",700140,57],["ὀργῇ",709728,1],["πᾶν",710177,27],["δὲ",703303,11],["ὑβριστὴν",713052,6],["ταπείνωσον",712717,758]],"And send forth messengers with wrath; and lay low every haughty one."],["12",[["ὑπερήφανον",713139,27],["δὲ",703303,11],["σβέσον",711596,176],["σῆψον",711754,176],["δὲ",703303,11],["ἀσεβεῖς",701909,60],["παραχρῆμα",710119,28]],"Bring down also the proud man; and consume at once the ungodly."],["13",[["κρύψον",707923,176],["δὲ",703303,11],["εἰς",704105,0],["γῆν",703083,9],["ἔξω",704983,28],["ὁμοθυμαδόν",709624,28],["τὰ",709436,41],["δὲ",703303,11],["πρόσωπα",710986,42],["αὐτῶν",702165,40],["ἀτιμίας",702094,17],["ἔμπλησον",704592,176]],"And hide them together in the earth; and fill their faces with shame."],["14",[["ὁμολογήσω",709632,165],["ἄρα",701666,11],["ὅτι",709803,7],["δύναται",703838,117],["ἡ",709436,10],["δεξιά",703360,68],["σου",711945,133],["σῶσαι",712627,106]],"[Then] will I confess that thy right hand can save [thee]."],["15",[["ἀλλὰ",700680,7],["δὴ",703395,11],["ἰδοὺ",706497,88],["θηρία",706252,42],["παρὰ",709995,0],["σοί",711925,159],["χόρτον",713923,6],["ἴσα",706832,28],["βουσὶν",702798,76],["ἐσθίει",705495,91]],"But now look at the wild beasts with thee; they eat grass like oxen."],["16",[["ἰδοὺ",706497,88],["δὴ",703395,11],["ἰσχὺς",706858,12],["αὐτοῦ",702165,102],["ἐπ᾿",705080,0],["ὀσφύι",709800,1],["ἡ",709436,10],["δὲ",703303,11],["δύναμις",703839,12],["ἐπ᾿",705080,0],["ὀμφαλοῦ",709650,18],["γαστρός",702976,17]],"Behold now, his strength is in his loins, and his force is in the navel of his belly."],["17",[["ἔστησεν",706846,2],["οὐρὰν",709839,9],["ὡς",714148,7],["κυπάρισσον",707982,6],["τὰ",709436,63],["δὲ",703303,11],["νεῦρα",709275,64],["αὐτοῦ",702165,102],["συμπέπλεκται",712334,403]],"He sets up his tail like a cypress; and his nerves are wrapped together."],["18",[["αἱ",709436,190],["πλευραὶ",710524,191],["αὐτοῦ",702165,102],["πλευραὶ",710524,191],["χάλκειαι",713689,192],["ἡ",709436,10],["δὲ",703303,11],["ῥάχις",711209,12],["αὐτοῦ",702165,102],["σίδηρος",711774,4],["χυτός",713988,14]],"His sides are sides of brass; and his backbone is [as] cast iron."],["19",[["τοῦτ᾿",709858,132],["ἔστιν",704093,91],["ἀρχὴ",701836,12],["πλάσματος",710502,21],["κυρίου",707996,18],["πεποιημένον",710582,469],["ἐγκαταπαίζεσθαι",703969,110],["ὑπὸ",713184,0],["τῶν",709436,80],["ἀγγέλων",700140,81],["αὐτοῦ",702165,102]],"This is the chief of the creation of the Lord; made to be played with by his angels."],["20",[["ἐπελθὼν",705068,182],["δὲ",703303,11],["ἐπ᾿",705080,0],["ὄρος",709768,25],["ἀκρότομον",700611,46],["ἐποίησεν",710582,2],["χαρμονὴν",713745,9],["τετράποσιν",712823,148],["ἐν",704639,0],["τῷ",709436,113],["ταρτάρῳ",712728,114]],"And when he has gone up to a steep mountain, he causes joy to the quadrupeds in the deep."],["21",[["ὑπὸ",713184,0],["παντοδαπὰ",709982,68],["δένδρα",703353,42],["κοιμᾶται",707767,117],["παρὰ",709995,0],["πάπυρον",709994,6],["καὶ",707031,7],["κάλαμον",707082,6],["καὶ",707031,7],["βούτομον",702799,25]],"He lies under trees of every kind, by the papyrus, and reed, and bulrush."],["22",[["σκιάζονται",711855,269],["δὲ",703303,11],["ἐν",704639,0],["αὐτῷ",702165,280],["δένδρα",703353,64],["μεγάλα",708653,195],["σὺν",712372,0],["ῥαδάμνοις",711146,148],["καὶ",707031,7],["κλῶνες",707747,52],["ἄγνου",700179,18]],"And the great trees make a shadow over him with their branches, and [so do] the bushes of the field."],["23",[["ἐὰν",703912,7],["γένηται",703104,239],["πλήμμυρα",710539,12],["οὐ",709805,28],["μὴ",708851,28],["αἰσθηθῇ",700476,384],["πέποιθεν",710221,171],["ὅτι",709803,7],["προσκρούσει",710924,127],["ὁ",709436,3],["Ιορδάνης",706763,4],["εἰς",704105,0],["τὸ",709436,24],["στόμα",712125,25],["αὐτοῦ",702165,49]],"If there should be a flood, he will not perceive it; he trusts that Jordan will rush up into his mouth."],["24",[["ἐν",704639,0],["τῷ",709436,113],["ὀφθαλμῷ",709870,114],["αὐτοῦ",702165,49],["δέξεται",703393,93],["αὐτόν",702165,129],["ἐνσκολιευόμενος",704784,122],["τρήσει",712870,127],["ῥῖνα",711268,9]],"[Yet one] shall take him in his sight; [one] shall catch [him] with a cord, and pierce his nose."],["25",[["ἄξεις",700209,166],["δὲ",703303,11],["δράκοντα",703822,6],["ἐν",704639,0],["ἀγκίστρῳ",700164,54],["περιθήσεις",710403,166],["δὲ",703303,11],["φορβεὰν",713552,9],["περὶ",710285,0],["ῥῖνα",711268,9],["αὐτοῦ",702165,102]],"But wilt thou catch the serpent with a hook, and put a halter about his nose?"],["26",[["εἰ",704071,7],["δήσεις",703394,166],["κρίκον",707902,6],["ἐν",704639,0],["τῷ",709436,113],["μυκτῆρι",709051,114],["αὐτοῦ",702165,102],["ψελίῳ",714034,54],["δὲ",703303,11],["τρυπήσεις",713002,166],["τὸ",709436,24],["χεῖλος",713781,25],["αὐτοῦ",702165,102]],"Or wilt thou fasten a ring in his nostril, and bore his lip with a clasp?"],["27",[["λαλήσει",708071,127],["δέ",703303,11],["σοι",711925,159],["δεήσει",703311,1],["ἱκετηρίᾳ",706717,101],["μαλακῶς",708441,28]],"Will he address thee with a petition? softly, with the voice of a suppliant?"],["28",[["θήσεται",712849,93],["δὲ",703303,11],["διαθήκην",703456,9],["μετὰ",708780,0],["σοῦ",711945,133],["λήμψῃ",708076,123],["δὲ",703303,11],["αὐτὸν",702165,85],["δοῦλον",703817,6],["αἰώνιον",700505,27]],"And will he make a covenant with thee? and wilt thou take him for a perpetual servant?"],["29",[["παίξῃ",709931,123],["δὲ",703303,11],["ἐν",704639,0],["αὐτῷ",702165,50],["ὥσπερ",714163,28],["ὀρνέῳ",709762,54],["ἢ",705924,7],["δήσεις",703394,166],["αὐτὸν",702165,85],["ὥσπερ",714163,28],["στρουθίον",712166,25],["παιδίῳ",709927,54]],"And wilt thou play with him as with a bird? or bind him as a sparrow for a child?"],["30",[["ἐνσιτοῦνται",704783,269],["δὲ",703303,11],["ἐν",704639,0],["αὐτῷ",702165,50],["ἔθνη",704068,64],["μεριτεύονται",708750,269],["δὲ",703303,11],["αὐτὸν",702165,85],["φοινίκων",713541,81],["γένη",703057,42]],"And do the nations feed upon him, and the nations of the Phœnicians share him?"],["31",[["πᾶν",710177,26],["δὲ",703303,11],["πλωτὸν",710565,26],["συνελθὸν",712458,293],["οὐ",709805,28],["μὴ",708851,28],["ἐνέγκωσιν",713428,234],["βύρσαν",702832,9],["μίαν",704106,36],["οὐρᾶς",709839,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐν",704639,0],["πλοίοις",710556,96],["ἁλιέων",700665,81],["κεφαλὴν",707639,9],["αὐτοῦ",702165,102]],"And all the ships come together would not be able to bear the mere skin of his tail; neither [shall they carry] his head in fishing-vessels."],["32",[["ἐπιθήσεις",705304,166],["δὲ",703303,11],["αὐτῷ",702165,50],["χεῖρα",713787,9],["μνησθεὶς",708923,217],["πόλεμον",710605,6],["τὸν",709436,5],["γινόμενον",703104,212],["ἐν",704639,0],["σώματι",712635,54],["αὐτοῦ",702165,102],["καὶ",707031,7],["μηκέτι",708867,28],["γινέσθω",703104,407]],"But thou shalt lay thy hand upon him [once], remembering the war that is waged by his mouth; and let it not be done any more."]]