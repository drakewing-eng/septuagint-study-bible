[["1",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Ελιφας",704499,4],["ὁ",709436,3],["Θαιμανίτης",706063,4],["λέγει",708124,91]],"Then Eliphaz the Thæmanite answered and said,"],["2",[["πότερον",710697,28],["σοφὸς",711985,14],["ἀπόκρισιν",701493,9],["δώσει",703654,127],["συνέσεως",712460,17],["πνεύματος",710566,21],["καὶ",707031,7],["ἐνέπλησεν",704592,2],["πόνον",710661,6],["γαστρὸς",702976,17]],"Will a wise man give for answer a [mere] breath of wisdom? and does he fill up the pain of his belly,"],["3",[["ἐλέγχων",704416,72],["ἐν",704639,0],["ῥήμασιν",711246,96],["οἷς",709781,295],["οὐ",709805,28],["δεῖ",703312,91],["ἐν",704639,0],["λόγοις",708236,148],["οἷς",709781,311],["οὐδὲν",709817,26],["ὄφελος",709867,15]],"reasoning with improper sayings, and with words wherein is no profit?"],["4",[["οὐ",709805,28],["καὶ",707031,7],["σὺ",712181,164],["ἀπεποιήσω",701552,174],["φόβον",713534,6],["συνετελέσω",712510,174],["δὲ",703303,11],["ῥήματα",711246,42],["τοιαῦτα",712878,68],["ἔναντι",704653,0],["τοῦ",709436,35],["κυρίου",707996,18]],"Hast not thou moreover cast off fear, and accomplished such words before the Lord?"],["5",[["ἔνοχος",704781,14],["εἶ",704093,154],["ῥήμασιν",711246,96],["στόματός",712125,21],["σου",711945,133],["οὐδὲ",709816,7],["διέκρινας",703488,162],["ῥήματα",711246,42],["δυναστῶν",703844,81]],"Thou art guilty by the words of thy mouth, neither hast thou discerned the words of the mighty."],["6",[["ἐλέγξαι",704416,225],["σε",711598,163],["τὸ",709436,34],["σὸν",711943,26],["στόμα",712125,15],["καὶ",707031,7],["μὴ",708851,28],["ἐγώ",704018,164],["τὰ",709436,63],["δὲ",703303,11],["χείλη",713781,64],["σου",711945,133],["καταμαρτυρήσουσίν",707325,218],["σου",711945,133]],"Let thine own mouth, and not me, reprove thee: and thy lips shall testify against thee."],["7",[["τί",712867,273],["γάρ",702963,11],["μὴ",708851,28],["πρῶτος",711041,140],["ἀνθρώπων",701163,81],["ἐγενήθης",703104,168],["ἢ",705924,7],["πρὸ",710747,0],["θινῶν",706269,81],["ἐπάγης",710452,168]],"What! art thou the first man that was born? or wert thou established before the hills?"],["8",[["ἦ",705925,28],["σύνταγμα",712505,25],["κυρίου",707996,18],["ἀκήκοας",700587,266],["εἰς",704105,0],["δὲ",703303,11],["σὲ",711598,163],["ἀφίκετο",702212,23],["σοφία",711981,12]],"Or hast thou heard the ordinance of the Lord? or has God used thee as [his] counsellor? and has wisdom come [only] to thee?",{"s":"d","q":0.62}],["9",[["τί",712867,126],["γὰρ",702963,11],["οἶδας",709492,266],["ὃ",709781,128],["οὐκ",709805,28],["οἴδαμεν",709492,314],["ἢ",705924,7],["τί",712867,126],["συνίεις",712481,154],["ὃ",709781,128],["οὐχὶ",709862,28],["καὶ",707031,28],["ἡμεῖς",705983,219]],"For what knowest thou, that we know not? or what understandest thou, which we do not also?"],["10",[["καί",707031,7],["γε",702985,11],["πρεσβύτης",710736,4],["καί",707031,7],["γε",702985,11],["παλαιὸς",709936,14],["ἐν",704639,0],["ἡμῖν",705994,90],["βαρύτερος",702554,224],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["ἡμέραις",705984,76]],"Truly among us [are] both the old and very aged man, more advanced in days than thy father."],["11",[["ὀλίγα",709568,68],["ὧν",709781,252],["ἡμάρτηκας",700773,266],["μεμαστίγωσαι",708566,724],["μεγάλως",708650,28],["ὑπερβαλλόντως",713126,28],["λελάληκας",708071,266]],"Thou hast been scourged for [but] few of thy sins: thou hast spoken haughtily [and] extravagantly."],["12",[["τί",712867,126],["ἐτόλμησεν",712886,2],["ἡ",709436,10],["καρδία",707141,12],["σου",711945,133],["ἢ",705924,7],["τί",712867,126],["ἐπήνεγκαν",705322,150],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["σου",711945,133]],"What has thine heart dared? or what have thine eyes [aimed at],"],["13",[["ὅτι",709803,7],["θυμὸν",706334,6],["ἔρρηξας",711243,162],["ἔναντι",704653,0],["κυρίου",707996,18],["ἐξήγαγες",704834,162],["δὲ",703303,11],["ἐκ",704132,0],["στόματος",712125,21],["ῥήματα",711246,42],["τοιαῦτα",712878,68]],"that thou hast vented [thy] rage before the Lord, and delivered such words from [thy] mouth?"],["14",[["τίς",712867,158],["γὰρ",702963,11],["ὢν",704093,72],["βροτός",702817,4],["ὅτι",709803,7],["ἔσται",704093,93],["ἄμεμπτος",700807,14],["ἢ",705924,7],["ὡς",714148,7],["ἐσόμενος",704093,626],["δίκαιος",703694,14],["γεννητὸς",703055,14],["γυναικός",703209,17]],"For who, being a mortal, [is such] that he shall be blameless? or, [who that is] born of a woman, that he should be just?"],["15",[["εἰ",704071,7],["κατὰ",707200,0],["ἁγίων",700159,169],["οὐ",709805,28],["πιστεύει",710483,91],["οὐρανὸς",709844,4],["δὲ",703303,11],["οὐ",709805,28],["καθαρὸς",706988,14],["ἐναντίον",704654,0],["αὐτοῦ",702165,102]],"Forasmuch as he trusts not his saints; and the heaven is not pure before him."],["16",[["ἔα",703911,88],["δὲ",703303,11],["ἐβδελυγμένος",702608,251],["καὶ",707031,7],["ἀκάθαρτος",700508,14],["ἀνὴρ",701150,4],["πίνων",710478,72],["ἀδικίας",700271,17],["ἴσα",706832,28],["ποτῷ",710703,114]],"Alas then, abominable and unclean is man, drinking unrighteousness as a draught."],["17",[["ἀναγγελῶ",700921,165],["δέ",703303,11],["σοι",711925,159],["ἄκουέ",700587,240],["μου",709032,133],["ἃ",709781,69],["δὴ",703395,11],["ἑώρακα",709725,89],["ἀναγγελῶ",700921,165],["σοι",711925,159]],"But I will tell thee, hearken to me; I will tell thee now what I have seen;"],["18",[["ἃ",709781,69],["σοφοὶ",711985,138],["ἐροῦσιν",705415,218],["καὶ",707031,7],["οὐκ",709805,28],["ἔκρυψαν",707923,150],["πατέρας",710189,57],["αὐτῶν",702165,40]],"things wise men say, and their fathers have not hidden."],["19",[["αὐτοῖς",702165,151],["μόνοις",709003,230],["ἐδόθη",703654,37],["ἡ",709436,10],["γῆ",703083,12],["καὶ",707031,7],["οὐκ",709805,28],["ἐπῆλθεν",705068,2],["ἀλλογενὴς",700690,14],["ἐπ᾿",705080,0],["αὐτούς",702165,62]],"To them alone the earth was given, and no stranger came upon them."],["20",[["πᾶς",710177,14],["ὁ",709436,3],["βίος",702724,4],["ἀσεβοῦς",701909,116],["ἐν",704639,0],["φροντίδι",713591,1],["ἔτη",705543,64],["δὲ",703303,11],["ἀριθμητὰ",701743,195],["δεδομένα",703654,443],["δυνάστῃ",703844,114]],"All the life of the ungodly [is spent] in care, and the years granted to the oppressor are numbered."],["21",[["ὁ",709436,3],["δὲ",703303,11],["φόβος",713534,4],["αὐτοῦ",702165,102],["ἐν",704639,0],["ὠσὶν",709852,96],["αὐτοῦ",702165,102],["ὅταν",709801,28],["δοκῇ",703775,204],["ἤδη",705939,28],["εἰρηνεύειν",704097,55],["ἥξει",705956,127],["αὐτοῦ",702165,102],["ἡ",709436,10],["καταστροφή",707445,12]],"And his terror is in his ears: just when he seems to be at peace, his overthrow will come."],["22",[["μὴ",708851,28],["πιστευέτω",710483,31],["ἀποστραφῆναι",701598,179],["ἀπὸ",701425,0],["σκότους",711889,21],["ἐντέταλται",704791,403],["γὰρ",702963,11],["ἤδη",705939,28],["εἰς",704105,0],["χεῖρας",713787,39],["σιδήρου",711774,18]],"Let him not trust that he shall return from darkness, for he has been already made over to the power of the sword."],["23",[["κατατέτακται",707453,403],["δὲ",703303,11],["εἰς",704105,0],["σῖτα",711814,42],["γυψίν",703212,148],["οἶδεν",709492,171],["δὲ",703303,11],["ἐν",704639,0],["ἑαυτῷ",703917,50],["ὅτι",709803,7],["μένει",708736,91],["εἰς",704105,0],["πτῶμα",711071,25],["ἡμέρα",705984,12],["δὲ",703303,11],["αὐτὸν",702165,85],["σκοτεινὴ",711885,29],["στροβήσει",712163,127]],"And he has been appointed to be food for vultures; and he knows within himself that he is doomed to be a carcase: and a dark day shall carry him away as with a whirlwind."],["24",[["ἀνάγκη",700925,12],["δὲ",703303,11],["καὶ",707031,7],["θλῖψις",706276,12],["αὐτὸν",702165,85],["καθέξει",707526,127],["ὥσπερ",714163,28],["στρατηγὸς",712144,4],["πρωτοστάτης",711042,4],["πίπτων",710481,72]],"Distress also and anguish shall come upon him: he shall fall as a captain in the first rank."],["25",[["ὅτι",709803,7],["ἦρκεν",700473,353],["χεῖρας",713787,39],["ἐναντίον",704654,0],["τοῦ",709436,35],["κυρίου",707996,18],["ἔναντι",704653,0],["δὲ",703303,11],["κυρίου",707996,18],["παντοκράτορος",709986,18],["ἐτραχηλίασεν",712923,2]],"For he has lifted his hands against the Lord, and he has hardened his neck against the Almighty Lord."],["26",[["ἔδραμεν",712931,2],["δὲ",703303,11],["ἐναντίον",704654,0],["αὐτοῦ",702165,102],["ὕβρει",713051,1],["ἐν",704639,0],["πάχει",710204,54],["νώτου",709403,21],["ἀσπίδος",701991,17],["αὐτοῦ",702165,102]],"And he has run against him with insolence, on the thickness of the back of his shield."],["27",[["ὅτι",709803,7],["ἐκάλυψεν",707102,2],["τὸ",709436,24],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["ἐν",704639,0],["στέατι",712054,54],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐποίησεν",710582,2],["περιστόμιον",710394,25],["ἐπὶ",705080,0],["τῶν",709436,43],["μηρίων",708884,44]],"For he has covered his face with his fat, and made layers of fat upon his thighs."],["28",[["αὐλισθείη",702138,528],["δὲ",703303,11],["πόλεις",710612,39],["ἐρήμους",705420,119],["εἰσέλθοι",704114,225],["δὲ",703303,11],["εἰς",704105,0],["οἴκους",709516,57],["ἀοικήτους",701315,60],["ἃ",709781,69],["δὲ",703303,11],["ἐκεῖνοι",704183,201],["ἡτοίμασαν",705539,150],["ἄλλοι",700697,201],["ἀποίσονται",701632,135]],"And let him lodge in desolate cities, and enter into houses without inhabitant: and what they have prepared, others shall carry away."],["29",[["οὔτε",709857,7],["μὴ",708851,28],["πλουτισθῇ",710562,384],["οὔτε",709857,7],["μὴ",708851,28],["μείνῃ",708736,172],["αὐτοῦ",702165,102],["τὰ",709436,63],["ὑπάρχοντα",713102,242],["οὐ",709805,28],["μὴ",708851,28],["βάλῃ",702487,172],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["σκιὰν",711852,9]],"Neither shall he at all grow rich, nor shall his substance remain: he shall not cast a shadow upon the earth."],["30",[["οὐδὲ",709816,7],["μὴ",708851,28],["ἐκφύγῃ",704357,172],["τὸ",709436,24],["σκότος",711889,25],["τὸν",709436,5],["βλαστὸν",702736,6],["αὐτοῦ",702165,102],["μαράναι",708497,225],["ἄνεμος",701123,4],["ἐκπέσοι",704284,583],["δὲ",703303,11],["αὐτοῦ",702165,102],["τὸ",709436,34],["ἄνθος",701157,15]],"Neither shall he in any wise escape the darkness: let the wind blast his blossom, and let his flower fall off."],["31",[["μὴ",708851,28],["πιστευέτω",710483,31],["ὅτι",709803,7],["ὑπομενεῖ",713219,127],["κενὰ",707612,195],["γὰρ",702963,11],["ἀποβήσεται",701426,93],["αὐτῷ",702165,50]],"Let him not think that he shall endure; for his end shall be vanity."],["32",[["ἡ",709436,10],["τομὴ",712890,12],["αὐτοῦ",702165,102],["πρὸ",710747,0],["ὥρας",714128,17],["φθαρήσεται",713445,134],["καὶ",707031,7],["ὁ",709436,3],["ῥάδαμνος",711146,4],["αὐτοῦ",702165,102],["οὐ",709805,28],["μὴ",708851,28],["πυκάσῃ",711080,172]],"His harvest shall perish before the time, and his branch shall not flourish."],["33",[["τρυγηθείη",712996,528],["δὲ",703303,11],["ὥσπερ",714163,28],["ὄμφαξ",709651,12],["πρὸ",710747,0],["ὥρας",714128,17],["ἐκπέσοι",704284,583],["δὲ",703303,11],["ὡς",714148,7],["ἄνθος",701157,15],["ἐλαίας",704376,17]],"And let him be gathered as the unripe grape before the time, and let him fall as the blossom of the olive."],["34",[["μαρτύριον",708525,15],["γὰρ",702963,11],["ἀσεβοῦς",701909,116],["θάνατος",706096,4],["πῦρ",711088,15],["δὲ",703303,11],["καύσει",707049,127],["οἴκους",709516,57],["δωροδεκτῶν",703904,81]],"For death is the witness of an ungodly man, and fire shall burn the houses of them that receive gifts."],["35",[["ἐν",704639,0],["γαστρὶ",702976,1],["δὲ",703303,11],["λήμψεται",708076,93],["ὀδύνας",709463,39],["ἀποβήσεται",701426,93],["δὲ",703303,11],["αὐτῷ",702165,50],["κενά",707612,195],["ἡ",709436,10],["δὲ",703303,11],["κοιλία",707761,12],["αὐτοῦ",702165,102],["ὑποίσει",713256,127],["δόλον",703787,6]],"And he shall conceive sorrows, and his end shall be vanity, and his belly shall bear deceit."]]