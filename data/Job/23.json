[["1",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Ιωβ",706903,4],["λέγει",708124,91]],"Then Job answered and said,"],["2",[["καὶ",707031,28],["δὴ",703395,11],["οἶδα",709492,89],["ὅτι",709803,7],["ἐκ",704132,0],["χειρός",713787,17],["μου",709032,133],["ἡ",709436,10],["ἔλεγξίς",704414,12],["ἐστιν",704093,91],["καὶ",707031,7],["ἡ",709436,10],["χεὶρ",713787,12],["αὐτοῦ",702165,102],["βαρεῖα",702554,29],["γέγονεν",703104,171],["ἐπ᾿",705080,0],["ἐμῷ",704578,30],["στεναγμῷ",712065,114]],"Yea, I know that pleading is out of my reach; and his hand has been made heavy upon my groaning."],["3",[["τίς",712867,158],["δ᾿",703303,11],["ἄρα",701666,11],["γνοίη",703105,225],["ὅτι",709803,7],["εὕροιμι",705676,346],["αὐτὸν",702165,85],["καὶ",707031,7],["ἔλθοιμι",705453,346],["εἰς",704105,0],["τέλος",712787,25]],"Who would then know that I might find him, and come to an end [of the matter]?"],["4",[["εἴποιμι",705415,346],["δὲ",703303,11],["ἐμαυτοῦ",704545,102],["κρίμα",707903,25],["τὸ",709436,24],["δὲ",703303,11],["στόμα",712125,25],["μου",709032,133],["ἐμπλήσαιμι",704592,346],["ἐλέγχων",704415,81]],"And I would plead my own cause, and he would fill my mouth with arguments."],["5",[["γνῴην",703105,346],["δὲ",703303,11],["ῥήματα",711246,42],["ἅ",709781,69],["μοι",708974,159],["ἐρεῖ",705415,127],["αἰσθοίμην",700476,755],["δὲ",703303,11],["τίνα",712867,356],["μοι",708974,159],["ἀπαγγελεῖ",701321,127]],"And I would know the remedies which he would speak to me, and I would perceive what he would tell me."],["6",[["καὶ",707031,7],["εἰ",704071,7],["ἐν",704639,0],["πολλῇ",710646,101],["ἰσχύι",706858,1],["ἐπελεύσεταί",705068,93],["μοι",708974,159],["εἶτα",704129,28],["ἐν",704639,0],["ἀπειλῇ",701375,1],["μοι",708974,159],["οὐ",709805,28],["χρήσεται",713937,93]],"Though he should come on me in [his] great strength, then he would not threaten me;"],["7",[["ἀλήθεια",700656,12],["γὰρ",702963,11],["καὶ",707031,7],["ἔλεγχος",704415,4],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["ἐξαγάγοι",704834,225],["δὲ",703303,11],["εἰς",704105,0],["τέλος",712787,25],["τὸ",709436,24],["κρίμα",707903,25],["μου",709032,133]],"for truth and reproof are from him; and he would bring forth my judgment to an end."],["8",[["εἰς",704105,0],["γὰρ",702963,11],["πρῶτα",711041,430],["πορεύσομαι",710667,181],["καὶ",707031,7],["οὐκέτι",709827,28],["εἰμί",704093,157],["τὰ",709436,69],["δὲ",703303,11],["ἐπ᾿",705080,0],["ἐσχάτοις",705519,230],["τί",712867,126],["οἶδα",709492,89]],"For if I shall go first, and exist no longer, still what do I know [concerning] the latter end?"],["9",[["ἀριστερὰ",701749,68],["ποιήσαντος",710582,500],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐ",709805,28],["κατέσχον",707526,155],["περιβαλεῖ",710294,127],["δεξιά",703360,68],["καὶ",707031,7],["οὐκ",709805,28],["ὄψομαι",709725,181]],"When he wrought on the left hand, then I observed [it] not: his right hand shall encompass me but I shall not see [it]."],["10",[["οἶδεν",709492,171],["γὰρ",702963,11],["ἤδη",705939,28],["ὁδόν",709458,9],["μου",709032,133],["διέκρινεν",703488,2],["δέ",703303,11],["με",708618,163],["ὥσπερ",714163,28],["τὸ",709436,24],["χρυσίον",713972,25]],"For he knows already my way; and he has tried me as gold."],["11",[["ἐξελεύσομαι",704909,181],["δὲ",703303,11],["ἐν",704639,0],["ἐντάλμασιν",704785,96],["αὐτοῦ",702165,102],["ὁδοὺς",709458,39],["γὰρ",702963,11],["αὐτοῦ",702165,102],["ἐφύλαξα",713619,155],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["ἐκκλίνω",704220,157]],"And I will go forth according to his commandments, for I have kept his ways; and I shall not turn aside from his commandments,"],["12",[["ἀπὸ",701425,0],["ἐνταλμάτων",704785,44],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["παρέλθω",710141,207],["ἐν",704639,0],["δὲ",703303,11],["κόλπῳ",707800,114],["μου",709032,133],["ἔκρυψα",707923,155],["ῥήματα",711246,42],["αὐτοῦ",702165,102]],"neither shall I transgress; but I have hid his words in my bosom."],["13",[["εἰ",704071,7],["δὲ",703303,11],["καὶ",707031,7],["αὐτὸς",702165,121],["ἔκρινεν",707905,2],["οὕτως",709859,28],["τίς",712867,158],["ἐστιν",704093,91],["ὁ",709436,3],["ἀντειπὼν",701223,182],["αὐτῷ",702165,50],["ὃ",709781,128],["γὰρ",702963,11],["αὐτὸς",702165,121],["ἠθέλησεν",706176,2],["καὶ",707031,28],["ἐποίησεν",710582,2]],"And if too he has thus judged, who is he that has contradicted, for he has both willed [a thing] and done it."],["15",[["διὰ",703417,0],["τοῦτο",709858,129],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["ἐσπούδακα",712031,89],["νουθετούμενος",709367,122],["δὲ",703303,11],["ἐφρόντισα",713590,155],["αὐτοῦ",702165,102]],"Therefore am I troubled at him; and when I was reproved, I thought of him."],["15a",[["ἐπὶ",705080,0],["τούτῳ",709858,50],["ἀπὸ",701425,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["κατασπουδασθῶ",707434,321],["κατανοήσω",707341,165],["καὶ",707031,7],["πτοηθήσομαι",711062,180],["ἐξ",704132,0],["αὐτοῦ",702165,102]],null],["16",[["κύριος",707996,4],["δὲ",703303,11],["ἐμαλάκυνεν",708440,13],["τὴν",709436,8],["καρδίαν",707141,9],["μου",709032,133],["ὁ",709436,3],["δὲ",703303,11],["παντοκράτωρ",709986,4],["ἐσπούδασέν",712031,2],["με",708618,163]],"But the Lord has softened my heart, and the Almighty has troubled me."],["17",[["οὐ",709805,28],["γὰρ",702963,11],["ᾔδειν",709492,499],["ὅτι",709803,7],["ἐπελεύσεταί",705068,93],["μοι",708974,159],["σκότος",711889,25],["πρὸ",710747,0],["προσώπου",710986,21],["δέ",703303,11],["μου",709032,133],["ἐκάλυψεν",707102,2],["γνόφος",703131,4]],"For I knew not that darkness would come upon me, and thick darkness has covered [me] before my face."]]