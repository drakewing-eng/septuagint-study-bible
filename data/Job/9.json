[["1",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Ιωβ",706903,4],["λέγει",708124,91]],"Then Job answered and said,"],["2",[["ἐπ᾿",705080,0],["ἀληθείας",700656,17],["οἶδα",709492,89],["ὅτι",709803,7],["οὕτως",709859,28],["ἐστίν",704093,91],["πῶς",711121,28],["γὰρ",702963,11],["ἔσται",704093,93],["δίκαιος",703694,14],["βροτὸς",702817,4],["παρὰ",709995,0],["κυρίῳ",707996,114]],"I know of a truth that it is so: for how shall a mortal man be just before the Lord?"],["3",[["ἐὰν",703912,7],["γὰρ",702963,11],["βούληται",702795,428],["κριθῆναι",707905,179],["αὐτῷ",702165,50],["οὐ",709805,28],["μὴ",708851,28],["ὑπακούσῃ",713096,172],["αὐτῷ",702165,50],["ἵνα",706747,7],["μὴ",708851,28],["ἀντείπῃ",701223,172],["πρὸς",710844,0],["ἕνα",704106,27],["λόγον",708236,6],["αὐτοῦ",702165,102],["ἐκ",704132,0],["χιλίων",713859,169]],"For if he would enter into judgment with him, [God] would not hearken to him, so that he should answer to one of his charges of a thousand."],["4",[["σοφὸς",711985,14],["γάρ",702963,11],["ἐστιν",704093,91],["διανοίᾳ",703531,1],["κραταιός",707873,14],["τε",712751,11],["καὶ",707031,7],["μέγας",708653,14],["τίς",712867,158],["σκληρὸς",711861,14],["γενόμενος",703104,248],["ἐναντίον",704654,0],["αὐτοῦ",702165,102],["ὑπέμεινεν",713219,2]],"For he is wise in mind, and mighty, and great: who has hardened himself against him and endured?"],["5",[["ὁ",709436,3],["παλαιῶν",709937,170],["ὄρη",709768,42],["καὶ",707031,7],["οὐκ",709805,28],["οἴδασιν",709492,353],["ὁ",709436,3],["καταστρέφων",707444,72],["αὐτὰ",702165,71],["ὀργῇ",709728,1]],"Who wears out the mountains, and [men] know it not: who overturns them in anger."],["6",[["ὁ",709436,3],["σείων",711633,72],["τὴν",709436,8],["ὑπ᾿",713184,0],["οὐρανὸν",709844,6],["ἐκ",704132,0],["θεμελίων",706181,44],["οἱ",709436,136],["δὲ",703303,11],["στῦλοι",712179,52],["αὐτῆς",702165,86],["σαλεύονται",711403,197]],"Who shakes the [earth] under heaven from its foundations, and its pillars totter."],["7",[["ὁ",709436,3],["λέγων",708124,72],["τῷ",709436,113],["ἡλίῳ",705974,114],["καὶ",707031,7],["οὐκ",709805,28],["ἀνατέλλει",701066,91],["κατὰ",707200,0],["δὲ",703303,11],["ἄστρων",702024,44],["κατασφραγίζει",707450,91]],"Who commands the sun, and it rises not; and he seals up the stars."],["8",[["ὁ",709436,3],["τανύσας",712710,182],["τὸν",709436,5],["οὐρανὸν",709844,6],["μόνος",709003,14],["καὶ",707031,7],["περιπατῶν",710362,72],["ὡς",714148,7],["ἐπ᾿",705080,0],["ἐδάφους",704022,21],["ἐπὶ",705080,0],["θαλάσσης",706069,17]],"Who alone has stretched out the heavens, and walks on the sea as on firm ground."],["9",[["ὁ",709436,3],["ποιῶν",710582,72],["Πλειάδα",710511,9,39],["καὶ",707031,7],["ἕσπερον",705502,6],["καὶ",707031,7],["ἀρκτοῦρον",701767,6],["καὶ",707031,7],["ταμίεια",712700,42],["νότου",709364,18]],"Who makes Pleias, and Hesperus, and Arcturus, and the chambers of the south."],["10",[["ὁ",709436,3],["ποιῶν",710582,72],["μεγάλα",708653,68],["καὶ",707031,7],["ἀνεξιχνίαστα",701129,68],["ἔνδοξά",704694,68],["τε",712751,11],["καὶ",707031,7],["ἐξαίσια",704840,68],["ὧν",709781,103],["οὐκ",709805,28],["ἔστιν",704093,91],["ἀριθμός",701744,4]],"Who does great and unsearchable things; glorious also and excellent things, innumerable."],["11",[["ἐὰν",703912,7],["ὑπερβῇ",713125,172],["με",708618,163],["οὐ",709805,28],["μὴ",708851,28],["ἴδω",709725,207],["καὶ",707031,7],["ἐὰν",703912,7],["παρέλθῃ",710141,172],["με",708618,163],["οὐδ᾿",709816,7],["ὧς",714148,28],["ἔγνων",703105,155]],"If ever he should go beyond me, I shall not see him: if he should pass by me, neither thus have I known [it]."],["12",[["ἐὰν",703912,7],["ἀπαλλάξῃ",701333,172],["τίς",712867,158],["ἀποστρέψει",701598,127],["ἢ",705924,7],["τίς",712867,158],["ἐρεῖ",705415,127],["αὐτῷ",702165,50],["τί",712867,126],["ἐποίησας",710582,162]],"If he would take away, who shall turn him back? or who shall say to him, What hast thou done?"],["13",[["αὐτὸς",702165,121],["γὰρ",702963,11],["ἀπέστραπται",701598,187],["ὀργήν",709728,9],["ὑπ᾿",713184,0],["αὐτοῦ",702165,102],["ἐκάμφθησαν",707118,99],["κήτη",707664,64],["τὰ",709436,63],["ὑπ᾿",713184,0],["οὐρανόν",709844,6]],"For [if] he has turned away [his] anger, the whales under heaven have stooped under him."],["14",[["ἐὰν",703912,7],["δέ",703303,11],["μου",709032,133],["ὑπακούσηται",713096,239],["ἦ",705925,28],["διακρινεῖ",703488,127],["τὰ",709436,41],["ῥήματά",711246,42],["μου",709032,133]],"Oh then that he would hearken to me, or judge my cause."],["15",[["ἐάν",703912,7],["τε",712751,11],["γὰρ",702963,11],["ὦ",704093,438],["δίκαιος",703694,14],["οὐκ",709805,28],["εἰσακούσεταί",704108,93],["μου",709032,133],["τοῦ",709436,20],["κρίματος",707903,21],["αὐτοῦ",702165,102],["δεηθήσομαι",703394,180]],"For though I be righteous, he will not hearken to me: I will intreat his judgment."],["16",[["ἐάν",703912,7],["τε",712751,11],["καλέσω",707084,207],["καὶ",707031,7],["ὑπακούσῃ",713096,172],["οὐ",709805,28],["πιστεύω",710483,157],["ὅτι",709803,7],["εἰσακήκοέν",704108,171],["μου",709032,133]],"And if I should call and he should not hearken, I cannot believe that he has listened to my voice."],["17",[["μὴ",708851,28],["γνόφῳ",703131,114],["με",708618,163],["ἐκτρίψῃ",704345,172],["πολλὰ",710646,68],["δέ",703303,11],["μου",709032,133],["τὰ",709436,41],["συντρίμματα",712521,42],["πεποίηκεν",710582,171],["διὰ",703417,0],["κενῆς",707612,82]],"Let him not crush me with a dark storm: but he has made my bruises many without cause."],["18",[["οὐκ",709805,28],["ἐᾷ",703918,91],["γάρ",702963,11],["με",708618,163],["ἀναπνεῦσαι",701037,106],["ἐνέπλησεν",704592,2],["δέ",703303,11],["με",708618,163],["πικρίας",710472,17]],"For he suffers me not to take breath, but he has filled me with bitterness."],["19",[["ὅτι",709803,7],["μὲν",708730,11],["γὰρ",702963,11],["ἰσχύι",706858,1],["κρατεῖ",707879,91],["τίς",712867,158],["οὖν",709835,11],["κρίματι",707903,54],["αὐτοῦ",702165,102],["ἀντιστήσεται",701154,93]],"For indeed he is strong in power: who then shall resist his judgment?"],["20",[["ἐὰν",703912,7],["γὰρ",702963,11],["ὦ",704093,438],["δίκαιος",703694,14],["τὸ",709436,34],["στόμα",712125,15],["μου",709032,133],["ἀσεβήσει",701906,127],["ἐάν",703912,7],["τε",712751,11],["ὦ",704093,438],["ἄμεμπτος",700807,14],["σκολιὸς",711868,14],["ἀποβήσομαι",701426,181]],"For though I should seem righteous, my mouth will be profane: and though I should seem blameless, I shall be proved perverse."],["21",[["εἴτε",704130,7],["γὰρ",702963,11],["ἠσέβησα",701906,155],["οὐκ",709805,28],["οἶδα",709492,89],["τῇ",709436,100],["ψυχῇ",714070,1],["πλὴν",710540,28],["ὅτι",709803,7],["ἀφαιρεῖταί",702177,391],["μου",709032,133],["ἡ",709436,10],["ζωή",705910,12]],"For even if I have sinned, I know it not [in] my soul: but my life is taken away."],["22",[["διὸ",703714,7],["εἶπον",705373,155],["μέγαν",708653,27],["καὶ",707031,7],["δυνάστην",703844,6],["ἀπολλύει",701513,91],["ὀργή",709728,12]],"Wherefore I said, Wrath slays the great and mighty man."],["23",[["ὅτι",709803,7],["φαῦλοι",713398,138],["ἐν",704639,0],["θανάτῳ",706096,114],["ἐξαισίῳ",704840,30],["ἀλλὰ",700680,7],["δίκαιοι",703694,138],["καταγελῶνται",707222,269]],"For the worthless die, but the righteous are laughed to scorn."],["24",[["παραδέδονται",710014,408],["γὰρ",702963,11],["εἰς",704105,0],["χεῖρας",713787,39],["ἀσεβοῦς",701909,116],["πρόσωπα",710986,42],["κριτῶν",707910,81],["αὐτῆς",702165,86],["συγκαλύπτει",712201,91],["εἰ",704071,7],["δὲ",703303,11],["μὴ",708851,28],["αὐτός",702165,121],["τίς",712867,158],["ἐστιν",704093,91]],"For they are delivered into the hands of the unrighteous [man]: he covers the faces of the judges [of the earth]: but if it be not he, who is it?"],["25",[["ὁ",709436,3],["δὲ",703303,11],["βίος",702724,4],["μού",709032,133],["ἐστιν",704093,91],["ἐλαφρότερος",704399,224],["δρομέως",703832,18],["ἀπέδρασαν",701448,150],["καὶ",707031,7],["οὐκ",709805,28],["εἴδοσαν",709725,150]],"But my life is swifter than a post: [my days] have fled away, and they knew it not."],["26",[["ἦ",705925,28],["καὶ",707031,7],["ἔστιν",704093,91],["ναυσὶν",709208,76],["ἴχνος",706873,15],["ὁδοῦ",709458,17],["ἢ",705924,7],["ἀετοῦ",700318,18],["πετομένου",710441,262],["ζητοῦντος",705879,152],["βοράν",702762,9]],"Or again, is there a trace of [their] path [left] by ships? or is there one of the flying eagle as it seeks [its] prey?"],["27",[["ἐάν",703912,7],["τε",712751,11],["γὰρ",702963,11],["εἴπω",705373,207],["ἐπιλήσομαι",705187,181],["λαλῶν",708071,72],["συγκύψας",712240,182],["τῷ",709436,53],["προσώπῳ",710986,54],["στενάξω",712066,165]],"And if I should say, I will forget to speak, I will bow down my face and groan;"],["28",[["σείομαι",711633,254],["πᾶσιν",710177,94],["τοῖς",709436,95],["μέλεσιν",708707,96],["οἶδα",709492,89],["γὰρ",702963,11],["ὅτι",709803,7],["οὐκ",709805,28],["ἀθῷόν",700390,27],["με",708618,163],["ἐάσεις",703918,166]],"I quake in all my limbs, for I know that thou wilt not leave me alone [as] innocent."],["29",[["ἐπειδὴ",705056,7],["δέ",703303,11],["εἰμι",704093,157],["ἀσεβής",701909,14],["διὰ",703417,0],["τί",712867,126],["οὐκ",709805,28],["ἀπέθανον",701461,155]],"But since I am ungodly, why have I not died?"],["30",[["ἐὰν",703912,7],["γὰρ",702963,11],["ἀπολούσωμαι",701520,410],["χιόνι",713870,1],["καὶ",707031,7],["ἀποκαθάρωμαι",701467,410],["χερσὶν",713787,76],["καθαραῖς",706988,291]],"For if I should wash myself with snow, and purge myself with pure hands,"],["31",[["ἱκανῶς",706712,28],["ἐν",704639,0],["ῥύπῳ",711311,114],["με",708618,163],["ἔβαψας",702517,162],["ἐβδελύξατο",702608,23],["δέ",703303,11],["με",708618,163],["ἡ",709436,10],["στολή",712120,12]],"thou hadst thoroughly plunged me in filth, and my garment had abhorred me."],["32",[["οὐ",709805,28],["γὰρ",702963,11],["εἶ",704093,154],["ἄνθρωπος",701163,4],["κατ᾿",707200,0],["ἐμέ",704555,163],["ᾧ",709781,309],["ἀντικρινοῦμαι",701241,181],["ἵνα",706747,7],["ἔλθωμεν",705453,79],["ὁμοθυμαδὸν",709624,28],["εἰς",704105,0],["κρίσιν",707908,9]],"For thou art not man like me, with whom I could contend, that we might come together to judgment."],["33",[["εἴθε",704080,88],["ἦν",704093,13],["ὁ",709436,3],["μεσίτης",708761,4],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐλέγχων",704416,72],["καὶ",707031,7],["διακούων",703485,72],["ἀνὰ",700902,0],["μέσον",708768,46],["ἀμφοτέρων",700892,169]],"Would that [he] our mediator were [present], and a reprover, and one who should hear [the cause] between both."],["34",[["ἀπαλλαξάτω",701333,45],["ἀπ᾿",701425,0],["ἐμοῦ",704580,133],["τὴν",709436,8],["ῥάβδον",711135,9],["ὁ",709436,3],["δὲ",703303,11],["φόβος",713534,4],["αὐτοῦ",702165,102],["μή",708851,28],["με",708618,163],["στροβείτω",712163,31]],"Let him remove [his] rod from me, and let not his fear terrify me:"],["35",[["καὶ",707031,7],["οὐ",709805,28],["μὴ",708851,28],["φοβηθῶ",713532,321],["ἀλλὰ",700680,7],["λαλήσω",708071,165],["οὐ",709805,28],["γὰρ",702963,11],["οὕτω",709859,28],["συνεπίσταμαι",712451,254]],"so shall I not be afraid, but I will speak: for I am not thus conscious [of guilt]."]]