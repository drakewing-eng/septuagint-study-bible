[["1",[["ὑπολαβὼν",713210,182],["δὲ",703303,11],["Ιωβ",706903,4],["λέγει",708124,91]],"And Job answered and said,"],["2",[["εἶτα",704129,28],["ὑμεῖς",713081,219],["ἐστε",704093,87],["ἄνθρωποι",701163,52],["ἦ",705925,28],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["τελευτήσει",712781,127],["σοφία",711981,12]],"So then ye [alone] are men, and wisdom shall die with you?"],["3",[["κἀμοὶ",706969,540],["μὲν",708730,11],["καρδία",707141,12],["καθ᾿",707200,0],["ὑμᾶς",713080,194],["ἐστιν",704093,91]],"[But] I also have a heart as well as you."],["4",[["δίκαιος",703694,14],["γὰρ",702963,11],["ἀνὴρ",701150,4],["καὶ",707031,7],["ἄμεμπτος",700807,14],["ἐγενήθη",703104,37],["εἰς",704105,0],["χλεύασμα",713874,25]],"For a righteous and blameless man has become a subject for mockery."],["5",[["εἰς",704105,0],["χρόνον",713969,6],["γὰρ",702963,11],["τακτὸν",712692,27],["ἡτοίμαστο",705539,19],["πεσεῖν",710481,106],["ὑπὸ",713184,0],["ἄλλους",700697,62],["οἴκους",709516,57],["τε",712751,11],["αὐτοῦ",702165,102],["ἐκπορθεῖσθαι",704294,395],["ὑπὸ",713184,0],["ἀνόμων",701194,169]],"For it had been ordained that he should fall under others at the appointed time, and that his houses should be spoiled by transgressors: let not however any one trust that, being evil, he shall be [held] guiltless,"],["6",[["οὐ",709805,28],["μὴν",708873,11],["δὲ",703303,11],["ἀλλὰ",700680,7],["μηδεὶς",708857,14],["πεποιθέτω",710221,750],["πονηρὸς",710660,14],["ὢν",704093,72],["ἀθῷος",700390,14],["ἔσεσθαι",704093,492],["ὅσοι",709788,138],["παροργίζουσιν",710167,197],["τὸν",709436,5],["κύριον",707996,6],["ὡς",714148,7],["οὐχὶ",709862,28],["καὶ",707031,28],["ἔτασις",705530,12],["αὐτῶν",702165,40],["ἔσται",704093,93]],"even as many as provoke the Lord, as if there were indeed to be no inquisition [made] of them."],["7",[["ἀλλὰ",700680,7],["δὴ",703395,11],["ἐπερώτησον",705069,176],["τετράποδα",712823,68],["ἐάν",703912,7],["σοι",711925,159],["εἴπωσιν",705373,234],["πετεινὰ",710439,68],["δὲ",703303,11],["οὐρανοῦ",709844,18],["ἐάν",703912,7],["σοι",711925,159],["ἀπαγγείλωσιν",701321,234]],"But ask now the beasts, if they may speak to thee; and the birds of the air, if they may declare to thee."],["8",[["ἐκδιήγησαι",704172,300],["δὲ",703303,11],["γῇ",703083,1],["ἐάν",703912,7],["σοι",711925,159],["φράσῃ",713573,172],["καὶ",707031,7],["ἐξηγήσονταί",704918,135],["σοι",711925,159],["οἱ",709436,136],["ἰχθύες",706870,52],["τῆς",709436,16],["θαλάσσης",706069,17]],"Tell the earth, if it may speak to thee: and the fishes of the sea shall explain to thee."],["9",[["τίς",712867,158],["οὐκ",709805,28],["ἔγνω",703105,2],["ἐν",704639,0],["πᾶσι",710177,230],["τούτοις",709858,151],["ὅτι",709803,7],["χεὶρ",713787,12],["κυρίου",707996,18],["ἐποίησεν",710582,2],["ταῦτα",709858,71]],"Who then has not known in all these things, that the hand of the Lord has made them?"],["10",[["εἰ",704071,7],["μὴ",708851,28],["ἐν",704639,0],["χειρὶ",713787,1],["αὐτοῦ",702165,102],["ψυχὴ",714070,12],["πάντων",710177,169],["τῶν",709436,80],["ζώντων",705851,170],["καὶ",707031,7],["πνεῦμα",710566,15],["παντὸς",710177,116],["ἀνθρώπου",701163,18]],"Whereas the life of all living things is in his hand, and the breath of every man."],["11",[["οὖς",709852,15],["μὲν",708730,11],["γὰρ",702963,11],["ῥήματα",711246,42],["διακρίνει",703488,91],["λάρυγξ",708098,4],["δὲ",703303,11],["σῖτα",711814,42],["γεύεται",703074,117]],"For the ear tries words, and the palate tastes meats."],["12",[["ἐν",704639,0],["πολλῷ",710646,30],["χρόνῳ",713969,114],["σοφία",711981,12],["ἐν",704639,0],["δὲ",703303,11],["πολλῷ",710646,30],["βίῳ",702724,114],["ἐπιστήμη",705267,12]],"In length of time is wisdom, and in long life knowledge."],["13",[["παρ᾿",709995,0],["αὐτῷ",702165,50],["σοφία",711981,12],["καὶ",707031,7],["δύναμις",703839,12],["αὐτῷ",702165,50],["βουλὴ",702792,12],["καὶ",707031,7],["σύνεσις",712460,12]],"With him are wisdom and power, with him counsel and understanding."],["14",[["ἐὰν",703912,7],["καταβάλῃ",707203,172],["τίς",712867,158],["οἰκοδομήσει",709509,127],["ἐὰν",703912,7],["κλείσῃ",707710,172],["κατὰ",707200,0],["ἀνθρώπων",701163,81],["τίς",712867,158],["ἀνοίξει",701186,127]],"If he should cast down, who will build up? if he should shut up against men, who shall open?"],["15",[["ἐὰν",703912,7],["κωλύσῃ",708020,172],["τὸ",709436,24],["ὥδωρ",714099,25],["ξηρανεῖ",709419,127],["τὴν",709436,8],["γῆν",703083,9],["ἐὰν",703912,7],["δὲ",703303,11],["ἐπαφῇ",705051,172],["ἀπώλεσεν",701513,2],["αὐτὴν",702165,104],["καταστρέψας",707444,182]],"If he should withhold the water, he will dry the earth: and if he should let it loose, he overthrows and destroys it."],["16",[["παρ᾿",709995,0],["αὐτῷ",702165,50],["κράτος",707883,15],["καὶ",707031,7],["ἰσχύς",706858,12],["αὐτῷ",702165,50],["ἐπιστήμη",705267,12],["καὶ",707031,7],["σύνεσις",712460,12]],"With him are strength and power: he has knowledge and understanding."],["17",[["διάγων",703442,72],["βουλευτὰς",702789,57],["αἰχμαλώτους",700503,60],["κριτὰς",707910,57],["δὲ",703303,11],["γῆς",703083,17],["ἐξέστησεν",704940,2]],"He leads counsellors away captive, and maddens the judges of the earth."],["18",[["καθιζάνων",707005,72],["βασιλεῖς",702580,57],["ἐπὶ",705080,0],["θρόνους",706315,57],["καὶ",707031,7],["περιέδησεν",710307,2],["ζώνῃ",705912,1],["ὀσφύας",709800,39],["αὐτῶν",702165,40]],"He seats kings upon thrones, and girds their loins with a girdle."],["19",[["ἐξαποστέλλων",704872,72],["ἱερεῖς",706614,57],["αἰχμαλώτους",700503,60],["δυνάστας",703844,57],["δὲ",703303,11],["γῆς",703083,17],["κατέστρεψεν",707444,2]],"He sends away priests into captivity, and overthrows the mighty ones of the earth."],["20",[["διαλλάσσων",703502,72],["χείλη",713781,42],["πιστῶν",710486,169],["σύνεσιν",712460,9],["δὲ",703303,11],["πρεσβυτέρων",710735,169],["ἔγνω",703105,2]],"He changes the lips of the trusty, and he knows the understanding of the elders."],["21",[["ἐκχέων",704368,72],["ἀτιμίαν",702094,9],["ἐπ᾿",705080,0],["ἄρχοντας",701862,57],["ταπεινοὺς",712714,60],["δὲ",703303,11],["ἰάσατο",706424,23]],"He pours dishonour upon princes, and heals the lowly."],["22",[["ἀνακαλύπτων",700968,72],["βαθέα",702381,68],["ἐκ",704132,0],["σκότους",711889,21],["ἐξήγαγεν",704834,2],["δὲ",703303,11],["εἰς",704105,0],["φῶς",713642,25],["σκιὰν",711852,9],["θανάτου",706096,18]],"Revealing deep things out of darkness: and he has brought into light the shadow of death."],["23",[["πλανῶν",710495,72],["ἔθνη",704068,42],["καὶ",707031,7],["ἀπολλύων",701513,72],["αὐτά",702165,71],["καταστρωννύων",707446,72],["ἔθνη",704068,42],["καὶ",707031,7],["καθοδηγῶν",707013,72],["αὐτά",702165,71]],"Causing the nations to wander, and destroying them: overthrowing the nations, and leading them [away]."],["24",[["διαλλάσσων",703502,72],["καρδίας",707141,39],["ἀρχόντων",701862,81],["γῆς",703083,17],["ἐπλάνησεν",710495,2],["δὲ",703303,11],["αὐτοὺς",702165,62],["ὁδῷ",709458,1],["ᾗ",709781,108],["οὐκ",709805,28],["ᾔδεισαν",709492,263]],"Perplexing the minds of the princes of the earth: and he causes them to wander in a way they have not known, [saying],"],["25",[["ψηλαφήσαισαν",714047,396],["σκότος",711889,25],["καὶ",707031,7],["μὴ",708851,28],["φῶς",713642,25],["πλανηθείησαν",710495,393],["δὲ",703303,11],["ὥσπερ",714163,28],["ὁ",709436,3],["μεθύων",708676,72]],"Let them grope [in] darkness, and [let there be] no light, and let them wander as a drunken man."]]