[["1",[["Ελεαζαρος",704408,4],["δέ",703303,11],["τις",712866,158],["ἀνὴρ",701150,4],["ἐπίσημος",705245,14],["τῶν",709436,80],["ἀπὸ",701425,0],["τῆς",709436,16],["χώρας",714011,17],["ἱερέων",706614,81],["ἐν",704639,0],["πρεσβείῳ",710730,54],["τὴν",709436,8],["ἡλικίαν",705971,9],["ἤδη",705939,28],["λελογχὼς",708052,270],["καὶ",707031,7],["πάσῃ",710177,101],["τῇ",709436,100],["κατὰ",707200,0],["τὸν",709436,5],["βίον",702724,6],["ἀρετῇ",701727,1],["κεκοσμημένος",707847,251],["τοὺς",709436,58],["περὶ",710285,0],["αὐτὸν",702165,85],["καταστείλας",707437,182],["πρεσβυτέρους",710735,496],["ἐπικαλεῖσθαι",705153,110],["τὸν",709436,5],["ἅγιον",700159,27],["θεὸν",706192,6],["προσηύξατο",710893,23],["τάδε",709446,71]],"And Eleazar, an illustrious priest of the country, who had attained to length of days, and whose life had been adorned with virtue, caused the presbyters who were about him to cease to cry out to the holy God, and prayed thus:"],["2",[["βασιλεῦ",702580,153],["μεγαλοκράτωρ",708629,153],["ὕψιστε",713286,564],["παντοκράτωρ",709986,153],["θεὲ",706192,153],["τὴν",709436,8],["πᾶσαν",710177,36],["διακυβερνῶν",703490,646],["ἐν",704639,0],["οἰκτιρμοῖς",709520,148],["κτίσιν",707939,9]],"O King, mighty in power, most high, Almighty God, who regulatest the whole creation with thy tender mercy,"],["3",[["ἔπιδε",705057,694],["ἐπὶ",705080,0],["Αβρααμ",700091,18],["σπέρμα",712008,25],["ἐπὶ",705080,0],["ἡγιασμένου",700153,474],["τέκνα",712761,42],["Ιακωβ",706401,18],["μερίδος",708748,17],["ἡγιασμένης",700153,446],["σου",711945,133],["λαὸν",708094,6],["ἐν",704639,0],["ξένῃ",709415,101],["γῇ",703083,1],["ξένον",709415,27],["ἀδίκως",700273,28],["ἀπολλύμενον",701513,212],["πάτερ",710189,153]],"look upon the seed of Abraham, upon the children of the sanctified Jacob, thy sanctified inheritance, O Father, now being wrongfully destroyed as strangers in a strange land."],["4",[["σὺ",712181,164],["Φαραω",713360,6],["πληθύνοντα",710530,183],["ἅρμασιν",701768,96],["τὸν",709436,5],["πρὶν",710742,28],["Αἰγύπτου",700401,17],["ταύτης",709858,86],["δυνάστην",703844,6],["ἐπαρθέντα",705002,260],["ἀνόμῳ",701194,30],["θράσει",706300,30],["καὶ",707031,7],["γλώσσῃ",703120,1],["μεγαλορρήμονι",708639,101],["σὺν",712372,0],["τῇ",709436,100],["ὑπερηφάνῳ",713141,101],["στρατιᾷ",712145,1],["ποντοβρόχους",710662,119],["ἀπώλεσας",701513,162],["φέγγος",713404,25],["ἐπιφάνας",705317,182],["ἐλέους",704426,21],["Ισραηλ",706839,6],["γένει",703057,54]],"Thou destroyedst Pharaoh, with his host of chariots, when that lord of this same Egypt was uplifted with lawless hardihood and loud-sounding tongue. Shedding the beams of thy mercy upon the race of Israel, thou didst overwhelm him with his proud army."],["5",[["σὺ",712181,164],["τὸν",709436,5],["ἀναριθμήτοις",701047,291],["δυνάμεσιν",703839,76],["γαυρωθέντα",702984,260],["Σενναχηριμ",711693,4],["βαρὺν",702554,27],["Ἀσσυρίων",702004,18],["βασιλέα",702580,6],["δόρατι",703804,54],["τὴν",709436,8],["πᾶσαν",710177,36],["ὑποχείριον",713258,36],["ἤδη",705939,28],["λαβόντα",708076,365],["γῆν",703083,9],["καὶ",707031,7],["μετεωρισθέντα",708829,328],["ἐπὶ",705080,0],["τὴν",709436,8],["ἁγίαν",700159,36],["σου",711945,133],["πόλιν",710612,9],["βαρέα",702554,68],["λαλοῦντα",708071,183],["κόμπῳ",707807,114],["καὶ",707031,7],["θράσει",706300,30],["σύ",712181,164],["δέσποτα",703379,153],["ἔθραυσας",706304,162],["ἔκδηλον",704167,46],["δεικνὺς",703314,154],["ἔθνεσιν",704068,96],["πολλοῖς",710646,94],["τὸ",709436,24],["σὸν",711943,46],["κράτος",707883,25]],"When Sennacherim, the grievous king of the Assyrians, glorying in his countless hosts, had subdued the whole land with his spear, and was lifting himself against thy holy city, with boastings grievous to be endured, thou, O Lord, didst demolish him and didst shew forth thy might to many nations."],["6",[["σὺ",712181,164],["τοὺς",709436,58],["κατὰ",707200,0],["τὴν",709436,8],["Βαβυλωνίαν",702354,9],["τρεῖς",712927,595],["ἑταίρους",705529,57],["πυρὶ",711088,54],["τὴν",709436,8],["ψυχὴν",714070,9],["αὐθαιρέτως",702126,28],["δεδωκότας",703654,277],["εἰς",704105,0],["τὸ",709436,24],["μὴ",708851,28],["λατρεῦσαι",708108,106],["τοῖς",709436,147],["κενοῖς",707612,230],["διάπυρον",703557,27],["δροσίσας",703834,182],["κάμινον",707113,6],["ἐρρύσω",711309,174],["μέχρι",708849,0],["τριχὸς",706312,17],["ἀπημάντους",701407,36],["φλόγα",713524,9],["πᾶσιν",710177,230],["ἐπιπέμψας",705223,182],["τοῖς",709436,147],["ὑπεναντίοις",713109,230]],"When the three friends in the land of Babylon of their own will exposed their lives to the fire rather than serve vain things, thou didst send a dewy coolness through the fiery furnace, and bring the fire upon all their adversaries."],["7",[["σὺ",712181,164],["τὸν",709436,5],["διαβολαῖς",703427,76],["φθόνου",713450,18],["λέουσι",708171,148],["κατὰ",707200,0],["γῆς",703083,17],["ῥιφέντα",711267,260],["θηρσὶν",706243,148],["βορὰν",702762,9],["Δανιηλ",703283,4],["εἰς",704105,0],["φῶς",713642,25],["ἀνήγαγες",700933,162],["ἀσινῆ",701957,27]],"It was thou who, when Daniel was hurled, through slander and envy, as a prey to lions down below, didst bring him back again unhurt to light."],["8",[["τόν",709436,5],["τε",712751,11],["βυθοτρεφοῦς",702831,46],["ἐν",704639,0],["γαστρὶ",702976,1],["κήτους",707664,21],["Ιωναν",706930,6],["τηκόμενον",712839,212],["ἀφιδὼν",702224,182],["ἀπήμαντον",701407,27],["πᾶσιν",710177,230],["οἰκείοις",709493,230],["ἀνέδειξας",700935,162],["πάτερ",710189,153]],"When Jonah was pining away in the belly of the sea-bred monster, thou didst look upon him, O Father, and recover him to the sight of his own."],["9",[["καὶ",707031,7],["νῦν",709384,28],["μίσυβρι",708948,114],["πολυέλεε",710624,564],["τῶν",709436,80],["ὅλων",709597,169],["σκεπαστά",711836,153],["τὸ",709436,24],["τάχος",712747,25],["ἐπιφάνηθι",705317,244],["τοῖς",709436,147],["ἀπὸ",701425,0],["Ισραηλ",706839,18],["γένους",703057,21],["ὑπὸ",713184,0],["ἐβδελυγμένων",702608,688],["ἀνόμων",701194,83],["ἐθνῶν",704068,44],["ὑβριζομένοις",713050,341]],"And now, thou who hatest insolence; thou who dost abound in mercy; thou who art the protector of all things; appear quickly to those of the race of Israel, who are insulted by abhorred, lawless Gentiles."],["10",[["εἰ",704071,7],["δὲ",703303,11],["ἀσεβείαις",701904,76],["κατὰ",707200,0],["τὴν",709436,8],["ἀποικίαν",701463,9],["ὁ",709436,3],["βίος",702724,4],["ἡμῶν",705999,145],["ἐνέσχηται",704727,695],["ῥυσάμενος",711309,248],["ἡμᾶς",705981,194],["ἀπὸ",701425,0],["ἐχθρῶν",705779,169],["χειρός",713787,17],["ᾧ",709781,309],["προαιρῇ",710753,204],["δέσποτα",703379,153],["ἀπόλεσον",701513,176],["ἡμᾶς",705981,194],["μόρῳ",709017,114]],"If our life has during our exile been stained with iniquity, deliver us from the hand of the enemy, and destroy us, O Lord, by the death which thou preferrest."],["11",[["μὴ",708851,28],["τοῖς",709436,147],["ματαίοις",708575,230],["οἱ",709436,136],["ματαιόφρονες",708577,52],["εὐλογησάτωσαν",705631,264],["ἐπὶ",705080,0],["τῇ",709436,100],["τῶν",709436,80],["ἠγαπημένων",700120,445],["σου",711945,133],["ἀπωλείᾳ",701660,1],["λέγοντες",708124,146],["οὐδὲ",709816,11],["ὁ",709436,3],["θεὸς",706192,4],["αὐτῶν",702165,40],["ἐρρύσατο",711309,23],["αὐτούς",702165,62]],"Let not the vain-minded congratulate vain idols at the destruction of thy beloved, saying, Neither did their God deliver them."],["12",[["σὺ",712181,164],["δέ",703303,11],["ὁ",709436,3],["πᾶσαν",710177,36],["ἀλκὴν",700678,9],["καὶ",707031,7],["δυναστείαν",703841,9],["ἔχων",705785,72],["ἅπασαν",701362,36],["αἰώνιε",700505,564],["νῦν",709384,28],["ἔπιδε",705057,176],["ἐλέησον",704418,176],["ἡμᾶς",705981,194],["τοὺς",709436,58],["καθ᾿",707200,0],["ὕβριν",713051,9],["ἀνόμων",701194,169],["ἀλόγιστον",700719,27],["ἐκ",704132,0],["τοῦ",709436,20],["ζῆν",705851,55],["μεθισταμένους",708668,236],["ἐν",704639,0],["ἐπιβούλων",705096,169],["τρόπῳ",712980,114]],"Thou who art All-powerful and Almighty, O Eternal One, behold! have mercy upon us who are being withdrawn from life, like traitors, by the unreasoning insolence of lawless men."],["13",[["πτηξάτω",711060,176],["δὲ",703303,11],["ἔθνη",704068,42],["σὴν",711943,36],["δύναμιν",703839,9],["ἀνίκητον",701170,36],["σήμερον",711751,28],["ἔντιμε",704798,564],["δύναμιν",703839,9],["ἔχων",705785,72],["ἐπὶ",705080,0],["σωτηρίᾳ",712658,1],["Ιακωβ",706401,6],["γένους",703057,21]],"Let the heathen cower before thy invincible might to-day, O glorious One, who hast all power to save the race of Jacob."],["14",[["ἱκετεύει",706716,91],["σε",711598,163],["τὸ",709436,34],["πᾶν",710177,26],["πλῆθος",710529,15],["τῶν",709436,80],["νηπίων",709295,169],["καὶ",707031,7],["οἱ",709436,136],["τούτων",709858,40],["γονεῖς",703169,52],["μετὰ",708780,0],["δακρύων",703255,44]],"The whole band of infants and their parents with tears beseech thee."],["15",[["δειχθήτω",703314,22],["πᾶσιν",710177,94],["ἔθνεσιν",704068,96],["ὅτι",709803,7],["μεθ᾿",708780,0],["ἡμῶν",705999,145],["εἶ",704093,154],["κύριε",707996,153],["καὶ",707031,7],["οὐκ",709805,28],["ἀπέστρεψας",701598,162],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["ἀφ᾿",701425,0],["ἡμῶν",705999,145],["ἀλλὰ",700680,7],["καθὼς",707030,28],["εἶπας",705373,162],["ὅτι",709803,7],["οὐδὲ",709816,11],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["τῶν",709436,80],["ἐχθρῶν",705779,169],["αὐτῶν",702165,40],["ὄντων",704093,170],["ὑπερεῖδον",713154,176],["αὐτούς",702165,62],["οὕτως",709859,28],["ἐπιτέλεσον",705297,176],["κύριε",707996,153]],"Let it be shewn to all the nations that thou art with us, O Lord, and hast not turned thy face away from us; but as thou saidst that thou wouldst not forget them even in the land of their enemies, so do thou fulfil this saying, O Lord."],["16",[["τοῦ",709436,35],["δὲ",703303,11],["Ελεαζαρου",704408,18],["λήγοντος",708173,152],["ἄρτι",701826,28],["τῆς",709436,16],["προσευχῆς",710892,17],["ὁ",709436,3],["βασιλεὺς",702580,4],["σὺν",712372,0],["τοῖς",709436,95],["θηρίοις",706252,96],["καὶ",707031,7],["παντὶ",710177,30],["τῷ",709436,113],["τῆς",709436,16],["δυνάμεως",703839,17],["φρυάγματι",713598,54],["κατὰ",707200,0],["τὸν",709436,5],["ἱππόδρομον",706789,6],["παρῆγεν",710007,13]],"Now, at the time that Eleazar had ended his prayer, the king came along to the hippodrome, with the wild beasts, and with his tumultuous power."],["17",[["καὶ",707031,7],["θεωρήσαντες",706226,196],["οἱ",709436,136],["Ιουδαῖοι",706772,52],["μέγα",708653,46],["εἰς",704105,0],["οὐρανὸν",709844,6],["ἀνέκραξαν",700979,150],["ὥστε",714164,7],["καὶ",707031,7],["τοὺς",709436,58],["παρακειμένους",710044,236],["αὐλῶνας",702141,57],["συνηχήσαντας",712473,454],["ἀκατάσχετον",700533,36],["πτόην",711063,9],["ποιῆσαι",710582,106],["παντὶ",710177,97],["τῷ",709436,53],["στρατοπέδῳ",712151,54]],"When the Jews saw this, they uttered a loud cry to heaven, so that the adjacent valleys resounded, and caused an irrepressible lamentation throughout the army."],["18",[["τότε",712908,28],["ὁ",709436,3],["μεγαλόδοξος",708627,14],["παντοκράτωρ",709986,4],["καὶ",707031,7],["ἀληθινὸς",700659,14],["θεὸς",706192,4],["ἐπιφάνας",705317,182],["τὸ",709436,24],["ἅγιον",700159,46],["αὐτοῦ",702165,102],["πρόσωπον",710986,25],["ἠνέῳξεν",701186,2],["τὰς",709436,38],["οὐρανίους",709842,60],["πύλας",711082,39],["ἐξ",704132,0],["ὧν",709781,252],["δεδοξασμένοι",703792,429],["δύο",703849,543],["φοβεροειδεῖς",713529,52],["ἄγγελοι",700140,52],["κατέβησαν",707202,150],["φανεροὶ",713342,138],["πᾶσιν",710177,230],["πλὴν",710540,28],["τοῖς",709436,147],["Ιουδαίοις",706772,148]],"Then the all-glorious, all-powerful, and true God, displayed his holy countenance, and opened the gates of heaven, from which two angels, dreadful of form, came down, and were visible to all but the Jews."],["19",[["καὶ",707031,7],["ἀντέστησαν",701154,150],["καὶ",707031,7],["τὴν",709436,8],["δύναμιν",703839,9],["τῶν",709436,80],["ὑπεναντίων",713109,169],["ἐπλήρωσαν",710543,150],["ταραχῆς",712722,17],["καὶ",707031,7],["δειλίας",703319,17],["καὶ",707031,7],["ἀκινήτοις",700545,230],["ἔδησαν",703394,150],["πέδαις",710210,191]],"And they stood opposite, and filled the enemies' host with confusion and cowardice; and bound them with immoveable fetters."],["20",[["καὶ",707031,7],["ὑπόφρικον",713257,46],["καὶ",707031,7],["τὸ",709436,34],["τοῦ",709436,35],["βασιλέως",702580,18],["σῶμα",712635,15],["ἐγενήθη",703104,37],["καὶ",707031,7],["λήθη",708174,12],["τὸ",709436,24],["θράσος",706297,25],["αὐτοῦ",702165,102],["τὸ",709436,24],["βαρύθυμον",702551,46],["ἔλαβεν",708076,2]],"And a cold shudder came over the person of the king, and oblivion paralysed the vehemence of his spirit."],["21",[["καὶ",707031,7],["ἀπέστρεψαν",701598,150],["τὰ",709436,63],["θηρία",706252,64],["ἐπὶ",705080,0],["τὰς",709436,38],["συνεπομένας",712454,312],["ἐνόπλους",704776,119],["δυνάμεις",703839,39],["καὶ",707031,7],["κατεπάτουν",707360,137],["αὐτὰς",702165,231],["καὶ",707031,7],["ὠλέθρευον",709560,137]],"They turned back the animals upon the armed forces which followed them; and the animals trod them down, and destroyed them."],["22",[["καὶ",707031,7],["μετεστράφη",708817,37],["τοῦ",709436,35],["βασιλέως",702580,18],["ἡ",709436,10],["ὀργὴ",709728,12],["εἰς",704105,0],["οἶκτον",709523,6],["καὶ",707031,7],["δάκρυα",703255,42],["ὑπὲρ",713111,0],["τῶν",709436,80],["ἔμπροσθεν",704618,28],["αὐτῷ",702165,50],["μεμηχανευμένων",708897,419]],"The king's wrath was converted into compassion; and he wept at his own machinations."],["23",[["ἀκούσας",700587,182],["γὰρ",702963,11],["τῆς",709436,16],["κραυγῆς",707886,17],["καὶ",707031,7],["συνιδὼν",712433,182],["πρηνεῖς",710739,60],["ἅπαντας",701362,60],["εἰς",704105,0],["τὴν",709436,8],["ἀπώλειαν",701660,9],["δακρύσας",703256,182],["μετ᾿",708780,0],["ὀργῆς",709728,17],["τοῖς",709436,147],["φίλοις",713492,230],["διηπειλεῖτο",703539,19],["λέγων",708124,72]],"For when he heard the cry, and saw them all on the verge of destruction, with tears he angrily threatened his friends, saying,"],["24",[["παραβασιλεύετε",709998,87],["καὶ",707031,7],["τυράννους",713026,57],["ὑπερβεβήκατε",713125,330],["ὠμότητι",714115,114],["καὶ",707031,7],["ἐμὲ",704555,163],["αὐτὸν",702165,85],["τὸν",709436,5],["ὑμῶν",713091,145],["εὐεργέτην",705578,6],["ἐπιχειρεῖτε",705334,87],["τῆς",709436,16],["ἀρχῆς",701836,17],["ἤδη",705939,28],["καὶ",707031,7],["τοῦ",709436,20],["πνεύματος",710566,21],["μεθιστᾶν",708668,32],["λάθρᾳ",708057,28],["μηχανώμενοι",708897,348],["τὰ",709436,41],["μὴ",708851,28],["συμφέροντα",712353,237],["τῇ",709436,100],["βασιλείᾳ",702577,1]],"Ye have governed badly; and have exceeded tyrants in cruelty; and me your benefactor ye have laboured to deprive at once of my dominion and my life, by secretly devising measures injurious to the kingdom."],["25",[["τίς",712867,158],["τοὺς",709436,58],["κρατήσαντας",707879,454],["ἡμῶν",705999,145],["ἐν",704639,0],["πίστει",710484,1],["τὰ",709436,41],["τῆς",709436,16],["χώρας",714011,17],["ὀχυρώματα",709891,42],["τῆς",709436,16],["οἰκίας",709505,17],["ἀποστήσας",702214,182],["ἕκαστον",704133,27],["ἀλόγως",700722,28],["ἤθροισεν",700384,2],["ἐνθάδε",704732,28]],"Who has gathered here, unreasonably removing each from his home, those who, in fidelity to us, had held the fortresses of the country?"],["26",[["τίς",712867,158],["τοὺς",709436,58],["ἐξ",704132,0],["ἀρχῆς",701836,17],["εὐνοίᾳ",705648,1],["πρὸς",710844,0],["ἡμᾶς",705981,194],["κατὰ",707200,0],["πάντα",710177,60],["διαφέροντας",703622,235],["πάντων",710177,83],["ἐθνῶν",704068,44],["καὶ",707031,7],["τοὺς",709436,58],["χειρίστους",707066,612],["πλεονάκις",710517,28],["ἀνθρώπων",701163,81],["ἐπιδεδεγμένους",705117,360],["κινδύνους",707678,57],["οὕτως",709859,28],["ἀθέσμως",700368,28],["περιέβαλεν",710294,2],["αἰκίαις",700424,76]],"Who has thus consigned to unmerited punishments those who in good will towards us from the beginning have in all things surpassed all nations, and who often have engaged in the most dangerous undertakings?"],["27",[["λύσατε",708288,74],["ἐκλύσατε",704254,74],["ἄδικα",700272,68],["δεσμά",703372,42],["εἰς",704105,0],["τὰ",709436,41],["ἴδια",706493,68],["μετ᾿",708780,0],["εἰρήνης",704098,17],["ἐξαποστείλατε",704872,74],["τὰ",709436,41],["προπεπραγμένα",710840,388],["παραιτησάμενοι",710033,317]],"Loose, loose the unjust bonds; send them to their homes in peace, and deprecate what has been done."],["28",[["ἀπολύσατε",701524,74],["τοὺς",709436,58],["υἱοὺς",713075,57],["τοῦ",709436,35],["παντοκράτορος",709986,18],["ἐπουρανίου",705355,116],["θεοῦ",706192,18],["ζῶντος",705851,152],["ὃς",709781,213],["ἀφ᾿",701425,0],["ἡμετέρων",705987,169],["μέχρι",708849,0],["τοῦ",709436,35],["νῦν",709384,28],["προγόνων",710777,81],["ἀπαραπόδιστον",701353,36],["μετὰ",708780,0],["δόξης",703791,17],["εὐστάθειαν",705692,9],["παρέχει",710142,91],["τοῖς",709436,95],["ἡμετέροις",705987,94],["πράγμασιν",710708,96]],"Release the sons of the almighty living God of heaven, who from our ancestors' times until now has granted a glorious and uninterrupted prosperity to our affairs."],["29",[["ὁ",709436,3],["μὲν",708730,11],["οὖν",709835,11],["ταῦτα",709858,71],["ἔλεξεν",708124,2],["οἱ",709436,136],["δὲ",703303,11],["ἐν",704639,0],["ἀμερεῖ",700809,30],["χρόνῳ",713969,114],["λυθέντες",708288,247],["τὸν",709436,5],["ἅγιον",700159,27],["σωτῆρα",712657,6],["θεὸν",706192,6],["αὐτῶν",702165,40],["εὐλόγουν",705631,47],["ἄρτι",701826,28],["τὸν",709436,5],["θάνατον",706096,6],["ἐκπεφευγότες",704357,268]],"These things he said: and they, released the same moment, having now escaped death, praised God their holy Saviour."],["30",[["εἶτα",704129,28],["ὁ",709436,3],["βασιλεὺς",702580,4],["εἰς",704105,0],["τὴν",709436,8],["πόλιν",710612,9],["ἀπαλλαγεὶς",701333,217],["τὸν",709436,5],["ἐπὶ",705080,0],["τῶν",709436,130],["προσόδων",710938,65],["προσκαλεσάμενος",710912,248],["ἐκέλευσεν",707601,2],["οἴνους",709530,57],["τε",712751,11],["καὶ",707031,7],["τὰ",709436,41],["λοιπὰ",708248,68],["πρὸς",710844,0],["εὐωχίαν",705738,9],["ἐπιτήδεια",705300,68],["τοῖς",709436,147],["Ιουδαίοις",706772,148],["χορηγεῖν",713911,106],["ἐπὶ",705080,0],["ἡμέρας",705984,39],["ἑπτὰ",705357,59],["κρίνας",707905,182],["αὐτοὺς",702165,62],["ἐν",704639,0],["ᾧ",709781,309],["τόπῳ",712903,114],["ἔδοξαν",703775,150],["τὸν",709436,5],["ὄλεθρον",709563,6],["ἀναλαμβάνειν",700984,55],["ἐν",704639,0],["τούτῳ",709858,50],["ἐν",704639,0],["εὐφροσύνῃ",705717,1],["πάσῃ",710177,101],["σωτήρια",712658,9],["ἀγαγεῖν",700209,106]],"The king then departed to the city, and called his financier to him, and bade him provide a seven days' quantity of wine and other materials for feasting for the Jews. He decided that they should keep a gladsome festival of deliverance in the very place in which they expected to meet with their destruction."],["31",[["τότε",712908,28],["οἱ",709436,136],["τὸ",709436,24],["πρὶν",710742,28],["ἐπονείδιστοι",705347,138],["καὶ",707031,7],["πλησίον",710547,28],["τοῦ",709436,35],["ᾅδου",700255,18],["μᾶλλον",708448,28],["δὲ",703303,11],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["βεβηκότες",702445,268],["ἀντὶ",701227,0],["πικροῦ",710475,116],["καὶ",707031,7],["δυσαιάκτου",703851,116],["μόρου",709017,18],["κώθωνα",708007,6],["σωτήριον",712659,27],["συστησάμενοι",712482,317],["τὸν",709436,5],["εἰς",704105,0],["πτῶσιν",711072,9],["αὐτοῖς",702165,151],["καὶ",707031,7],["τάφον",712738,6],["ἡτοιμασμένον",705539,469],["τόπον",712903,6],["κλισίαις",707739,76],["κατεμερίσαντο",707327,189],["πλήρεις",710541,138],["χαρμονῆς",713745,17]],"Then they who were before despised and nigh unto Hades, yea, rather advanced into it, partook of the cup of salvation, instead of a grievous and lamentable death. Full of exultation, they parted out the place intended for their fall and burial into banqueting booths."],["32",[["καταλήξαντες",707309,196],["δὲ",703303,11],["θρήνων",706309,81],["πανόδυρτον",709966,46],["μέλος",708707,25],["ἀνέλαβον",700984,150],["ᾠδὴν",714091,9],["πάτριον",710195,27],["τὸν",709436,5],["σωτῆρα",712657,6],["καὶ",707031,7],["τερατοποιὸν",712796,27],["αἰνοῦντες",700459,146],["θεόν",706192,6],["οἰμωγήν",709526,9],["τε",712751,11],["πᾶσαν",710177,36],["καὶ",707031,7],["κωκυτὸν",708010,6],["ἀπωσάμενοι",701659,317],["χοροὺς",713915,57],["συνίσταντο",712482,139],["εὐφροσύνης",705717,17],["εἰρηνικῆς",704099,82],["σημεῖον",711748,25]],"Ceasing their miserable strain of woe, they took up the subject of their fatherland, hymning in praise God their wonder-working Saviour. All groans, all wailing, were laid aside: they formed dances in token of serene joy."],["33",[["ὡσαύτως",714158,28],["δὲ",703303,11],["καὶ",707031,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["περὶ",710285,0],["τούτων",709858,40],["συμπόσιον",712345,25],["βαρὺ",702554,46],["συναγαγὼν",712375,182],["ἀδιαλείπτως",700260,28],["εἰς",704105,0],["οὐρανὸν",709844,6],["ἀνθωμολογεῖτο",701155,19],["μεγαλομερῶς",708631,28],["ἐπὶ",705080,0],["τῇ",709436,100],["παραδόξῳ",710016,114],["γενηθείσῃ",703104,696],["αὐτῷ",702165,50],["σωτηρίᾳ",712658,1]],"So, also, the king collected a number of guests for the occasion, and returned unceasing thanks with much magnificence for the unexpected deliverance afforded him."],["34",[["οἵ",709781,250],["τε",712751,11],["πρὶν",710742,28],["εἰς",704105,0],["ὄλεθρον",709563,6],["καὶ",707031,7],["οἰωνοβρώτους",709544,60],["αὐτοὺς",702165,62],["ἔσεσθαι",704093,492],["τιθέμενοι",712849,348],["καὶ",707031,7],["μετὰ",708780,0],["χαρᾶς",713719,17],["ἀπογραψάμενοι",701437,317],["κατεστέναξαν",707439,150],["αἰσχύνην",700483,9],["ἐφ᾿",705080,0],["ἑαυτοῖς",703917,151],["περιβαλόμενοι",710294,317],["καὶ",707031,7],["τὴν",709436,8],["πυρόπνουν",711100,36],["τόλμαν",712884,9],["ἀκλεῶς",700553,28],["ἐσβεσμένοι",711596,317]],"Those who had marked them out as for death and for carrion, and had registered them with joy, howled aloud, and were clothed with shame, and had the fire of their rage ingloriously put out."],["35",[["οἵ",709781,250],["τε",712751,11],["Ιουδαῖοι",706772,52,148],["καθὼς",707030,28],["προειρήκαμεν",710788,314],["συστησάμενοι",712482,317],["τὸν",709436,5],["προειρημένον",710788,439],["χορὸν",713915,6],["μετ᾿",708780,0],["εὐωχίας",705738,17],["ἐν",704639,0],["ἐξομολογήσεσιν",704961,1],["ἱλαραῖς",706723,291],["καὶ",707031,7],["ψαλμοῖς",714022,148],["διῆγον",703442,137]],"But the Jews, as we just said, instituted a dance, and then gave themselves up to feasting, glad thanksgivings, and psalms."],["36",[["καὶ",707031,7],["κοινὸν",707772,27],["ὁρισάμενοι",709748,317],["περὶ",710285,0],["τούτων",709858,40],["θεσμὸν",706224,6],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["τὴν",709436,8],["παροικίαν",710158,9],["αὐτῶν",702165,40],["εἰς",704105,0],["γενεὰς",703037,39],["τὰς",709436,38],["προειρημένας",710788,498],["ἡμέρας",705984,39],["ἄγειν",700209,55],["ἔστησαν",706846,150],["εὐφροσύνους",705718,60],["οὐ",709805,28],["πότου",710702,92],["χάριν",713735,9],["καὶ",707031,7],["λιχνείας",708223,17],["σωτηρίας",712658,17],["δὲ",703303,11],["τῆς",709436,16],["διὰ",703417,0],["θεὸν",706192,6],["γενομένης",703104,638],["αὐτοῖς",702165,151]],"They made a public ordinance to commemorate these things for generations to come, as long as they should be sojourners. They thus established these days as days of mirth, not for the purpose of drinking or luxury, but because God had saved them."],["37",[["ἐνέτυχον",704812,150],["δὲ",703303,11],["τῷ",709436,113],["βασιλεῖ",702580,114],["τὴν",709436,8],["ἀπόλυσιν",701521,9],["αὐτῶν",702165,40],["εἰς",704105,0],["τὰ",709436,41],["ἴδια",706493,68],["αἰτούμενοι",700489,348]],"They requested the king to send them back to their homes."],["38",[["ἀπογράφονται",701437,269],["δὲ",703303,11],["αὐτοὺς",702165,62],["ἀπὸ",701425,0],["πέμπτης",710245,82],["καὶ",707031,7],["εἰκάδος",704082,17],["τοῦ",709436,35],["Παχων",710207,118],["ἕως",705792,7],["τῆς",709436,16],["τετάρτης",712811,82],["τοῦ",709436,35],["Επιφι",705324,18],["ἐπὶ",705080,0],["ἡμέρας",705984,39],["τεσσαράκοντα",712806,59],["συνίστανται",712482,269],["δὲ",703303,11],["αὐτῶν",702165,40],["τὴν",709436,8],["ἀπώλειαν",701660,9],["ἀπὸ",701425,0],["πέμπτης",710245,82],["τοῦ",709436,35],["Επιφι",705324,18],["ἕως",705792,7],["ἑβδόμης",703925,82],["ἡμέραις",705984,76],["τρισίν",712927,230]],"They were being enrolled from the twenty-fifth of Pachon to the fourth of Epiphi, a period of forty days: the measures taken for their destruction lasted from the fifth of Epiphi till the seventh, that is, three days."],["39",[["ἐν",704639,0],["αἷς",709781,281],["καὶ",707031,7],["μεγαλοδόξως",708628,28],["ἐπιφάνας",705317,182],["τὸ",709436,24],["ἔλεος",704426,25],["αὐτοῦ",702165,102],["ὁ",709436,3],["τῶν",709436,80],["πάντων",710177,169],["δυνάστης",703844,4],["ἀπταίστους",701651,60],["αὐτοὺς",702165,62],["ἐρρύσατο",711309,23],["ὁμοθυμαδόν",709624,28]],"The Ruler over all did during this time manifest forth his mercy gloriously, and did deliver them all together unharmed."],["40",[["εὐωχοῦντο",705737,137],["δὲ",703303,11],["πάνθ᾿",710177,97],["ὑπὸ",713184,0],["τοῦ",709436,35],["βασιλέως",702580,18],["χορηγούμενοι",713911,348],["μέχρι",708849,0],["τῆς",709436,16],["τεσσαρεσκαιδεκάτης",712809,82],["ἐν",704639,0],["ᾗ",709781,108],["καὶ",707031,7],["τὴν",709436,8],["ἐντυχίαν",704813,9],["ἐποιήσαντο",710582,189],["περὶ",710285,0],["τῆς",709436,16],["ἀπολύσεως",701521,17],["αὐτῶν",702165,40]],"They feasted upon the king's provision up to the fourteenth day, and then asked to be sent away."],["41",[["συναινέσας",712379,182],["δὲ",703303,11],["αὐτοῖς",702165,151],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἔγραψεν",703194,2],["αὐτοῖς",702165,151],["τὴν",709436,8],["ὑπογεγραμμένην",713189,444],["ἐπιστολὴν",705272,9],["πρὸς",710844,0],["τοὺς",709436,58],["κατὰ",707200,0],["πόλιν",710612,9],["στρατηγοὺς",712144,57],["μεγαλοψύχως",708646,28],["τὴν",709436,8],["ἐκτενίαν",704327,9],["ἔχουσαν",705785,78]],"The king commended them, and wrote the subjoined letter, of magnanimous import for them, to the commanders of every city."]]