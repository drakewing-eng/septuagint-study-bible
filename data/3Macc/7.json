[["1",[["βασιλεὺς",702580,4],["Πτολεμαῖος",711066,4],["Φιλοπάτωρ",713488,4],["τοῖς",709436,147],["κατ᾿",707200,0],["Αἴγυπτον",700401,9],["στρατηγοῖς",712144,148],["καὶ",707031,7],["πᾶσιν",710177,230],["τοῖς",709436,147],["τεταγμένοις",712730,521],["ἐπὶ",705080,0],["πραγμάτων",710708,44],["χαίρειν",713665,55],["καὶ",707031,7],["ἐρρῶσθαι",711323,431]],"King Ptolemy Philopator to the commanders throughout Egypt, and to all who are set over affairs, joy and strength."],["2",[["ἐρρώμεθα",711323,580],["δὲ",703303,11],["καὶ",707031,7],["αὐτοὶ",702165,201],["καὶ",707031,7],["τὰ",709436,63],["τέκνα",712761,64],["ἡμῶν",705999,145],["κατευθύναντος",707521,500],["ἡμῖν",705994,90],["τοῦ",709436,35],["μεγάλου",708653,116],["θεοῦ",706192,18],["τὰ",709436,41],["πράγματα",710708,42],["καθὼς",707030,28],["προαιρούμεθα",710752,378]],"We, too, and our children are well; and God has directed our affairs as we wish."],["3",[["τῶν",709436,80],["φίλων",713492,169],["τινὲς",712866,392],["κατὰ",707200,0],["κακοήθειαν",707056,9],["πυκνότερον",711081,28],["ἡμῖν",705994,90],["παρακείμενοι",710044,348],["συνέπεισαν",712327,150],["ἡμᾶς",705981,194],["εἰς",704105,0],["τὸ",709436,24],["τοὺς",709436,58],["ὑπὸ",713184,0],["τὴν",709436,8],["βασιλείαν",702577,9],["Ιουδαίους",706772,57],["συναθροίσαντας",712378,454],["σύστημα",712560,25],["κολάσασθαι",707786,109],["ξενιζούσαις",709409,495],["ἀποστατῶν",701590,81],["τιμωρίαις",712863,76]],"Certain of our friends did of malice vehemently urge us to punish the Jews of our realm in a body, with the infliction of a monstrous punishment."],["4",[["προφερόμενοι",711006,348],["μηδέποτε",708858,28],["εὐσταθήσειν",705693,296],["τὰ",709436,41],["πράγματα",710708,42],["ἡμῶν",705999,145],["δι᾿",703417,0],["ἣν",709781,131],["ἔχουσιν",705785,197],["οὗτοι",709858,201],["πρὸς",710844,0],["πάντα",710177,68],["τὰ",709436,41],["ἔθνη",704068,42],["δυσμένειαν",703862,9],["μέχρι",708849,0],["ἂν",700900,11],["συντελεσθῇ",712510,384],["τοῦτο",709858,132]],"They pretended that our affairs would never be in a good state till this took place. Such, they said, was the hatred borne by the Jews to all other people."],["5",[["οἳ",709781,250],["καὶ",707031,28],["δεσμίους",703371,60],["καταγαγόντες",707232,196],["αὐτοὺς",702165,62],["μετὰ",708780,0],["σκυλμῶν",711901,81],["ὡς",714148,28],["ἀνδράποδα",701099,42],["μᾶλλον",708448,28],["δὲ",703303,11],["ὡς",714148,28],["ἐπιβούλους",705096,60],["ἄνευ",701137,0],["πάσης",710177,82],["ἀνακρίσεως",700981,17],["καὶ",707031,7],["ἐξετάσεως",704912,17],["ἐπεχείρησαν",705334,150],["ἀνελεῖν",700962,106],["νόμου",709349,18],["Σκυθῶν",711893,286],["ἀγριωτέραν",700191,36],["ἐμπεπορπημένοι",704615,429],["ὠμότητα",714115,9]],"They brought them fettered in grievous chains as slaves, nay, as traitors. Without enquiry or examination they endeavoured to annihilate them. They buckled themselves with a savage cruelty, worse than Scythian custom."],["6",[["ἡμεῖς",705983,219],["δὲ",703303,11],["ἐπὶ",705080,0],["τούτοις",709858,151],["σκληρότερον",711865,28],["διαπειλησάμενοι",703539,317],["καθ᾿",707200,0],["ἣν",709781,131],["ἔχομεν",705785,243],["πρὸς",710844,0],["ἅπαντας",701362,60],["ἀνθρώπους",701163,57],["ἐπιείκειαν",705127,9],["μόγις",708972,28],["τὸ",709436,24],["ζῆν",705851,55],["αὐτοῖς",702165,151],["χαρισάμενοι",713734,317],["καὶ",707031,7],["τὸν",709436,5],["ἐπουράνιον",705355,27],["θεὸν",706192,6],["ἐγνωκότες",703105,268],["ἀσφαλῶς",702045,28],["ὑπερησπικότα",713121,427],["τῶν",709436,80],["Ιουδαίων",706772,81],["ὡς",714148,28],["πατέρα",710189,6],["ὑπὲρ",713111,0],["υἱῶν",713075,81],["διὰ",703417,0],["παντὸς",710177,116],["συμμαχοῦντα",712300,212]],"For this cause we severely threatened them; yet, with the clemency which we are wont to extend to all men, we at length permitted them to live. Finding that the God of heaven cast a shield of protection over the Jews so as to preserve them, and that he fought for them as a father always fights for his sons;"],["7",[["τήν",709436,8],["τε",712751,11],["τοῦ",709436,35],["φίλου",713492,116],["ἣν",709781,131],["ἔχουσιν",705785,197],["βεβαίαν",702609,36],["πρὸς",710844,0],["ἡμᾶς",705981,194],["καὶ",707031,7],["τοὺς",709436,58],["προγόνους",710777,57],["ἡμῶν",705999,145],["εὔνοιαν",705648,9],["ἀναλογισάμενοι",700993,317],["δικαίως",703698,28],["ἀπολελύκαμεν",701524,314],["πάσης",710177,82],["καθ᾿",707200,0],["ὁντινοῦν",709794,356],["αἰτίας",700492,17],["τρόπον",712980,6]],"and taking into consideration their constancy and fidelity towards us and towards our ancestors, we have, as we ought, acquitted them of every sort of charge."],["8",[["καὶ",707031,7],["προστετάχαμεν",710962,314],["ἑκάστῳ",704133,30],["πάντας",710177,60],["εἰς",704105,0],["τὰ",709436,41],["ἴδια",706493,68],["ἐπιστρέφειν",705278,55],["ἐν",704639,0],["παντὶ",710177,30],["τόπῳ",712903,114],["μηθενὸς",708857,116],["αὐτοὺς",702165,62],["τὸ",709436,24],["σύνολον",712499,46],["καταβλάπτοντος",707211,152],["μήτε",708891,7],["ὀνειδίζειν",709655,55],["περὶ",710285,0],["τῶν",709436,80],["γεγενημένων",703104,445],["παρὰ",709995,0],["λόγον",708236,6]],"And we have dismissed them to their several homes; bidding all men everywhere to do them no wrong, or unrighteously revile them about the past."],["9",[["γινώσκετε",703105,87],["γὰρ",702963,11],["ὅτι",709803,7],["κατὰ",707200,0],["τούτων",709858,40],["ἐάν",703912,7],["τι",712866,126],["κακοτεχνήσωμεν",707067,79],["πονηρὸν",710660,27],["ἢ",705924,7],["ἐπιλυπήσωμεν",705195,79],["αὐτοὺς",702165,62],["τὸ",709436,24],["σύνολον",712498,46],["οὐκ",709805,28],["ἄνθρωπον",701163,6],["ἀλλὰ",700680,7],["τὸν",709436,5],["πάσης",710177,82],["δεσπόζοντα",703376,183],["δυνάμεως",703839,17],["θεὸν",706192,6],["ὕψιστον",713287,27],["ἀντικείμενον",701240,212],["ἡμῖν",705994,90],["ἐπ᾿",705080,0],["ἐκδικήσει",704175,1],["τῶν",709436,43],["πραγμάτων",710708,44],["κατὰ",707200,0],["πᾶν",710177,46],["ἀφεύκτως",702201,28],["διὰ",703417,0],["παντὸς",710177,116],["ἕξομεν",705785,275],["ἔρρωσθε",711323,680]],"For know ye, that should we conceive any evil design against, or in any manner aggrieve them, we shall ever have as our opposite, not man, but the highest God, the ruler of all might. From Him there will be no escape, as the avenger of such deeds. Fare ye well."],["10",[["λαβόντες",708076,196],["δὲ",703303,11],["τὴν",709436,8],["ἐπιστολὴν",705272,9],["ταύτην",709858,104],["οὐκ",709805,28],["ἐσπούδασαν",712031,150],["εὐθέως",705593,28],["γενέσθαι",703104,109],["περὶ",710285,0],["τὴν",709436,8],["ἄφοδον",702221,9],["ἀλλὰ",700680,7],["τὸν",709436,5],["βασιλέα",702580,6],["προσηξίωσαν",710858,150],["τοὺς",709436,58],["ἐκ",704132,0],["τοῦ",709436,20],["γένους",703057,21],["τῶν",709436,80],["Ιουδαίων",706772,81],["τὸν",709436,5],["ἅγιον",700159,27],["θεὸν",706192,6],["αὐθαιρέτως",702126,28],["παραβεβηκότας",709996,277],["καὶ",707031,7],["τοῦ",709436,35],["θεοῦ",706192,18],["τὸν",709436,5],["νόμον",709349,6],["τυχεῖν",713015,106],["δι᾿",703417,0],["αὐτῶν",702165,40],["τῆς",709436,16],["ὀφειλομένης",709865,422],["κολάσεως",707789,17]],"When they had received this letter, they were not forward to depart immediately. They petitioned the king to be allowed to inflict fitting punishment upon those of their race who had willingly transgressed the holy God, and the law of God."],["11",[["προφερόμενοι",711006,348],["τοὺς",709436,58],["γαστρὸς",702976,17],["ἕνεκεν",704709,0],["τὰ",709436,41],["θεῖα",706154,68],["παραβεβηκότας",709996,277],["προστάγματα",710959,42],["μηδέποτε",708858,28],["εὐνοήσειν",705647,296],["μηδὲ",708855,7],["τοῖς",709436,147],["τοῦ",709436,35],["βασιλέως",702580,18],["πράγμασιν",710708,96]],"They alleged that men who had for their bellies' sake transgressed the ordinances of God, would never be faithful to the interests of the king."],["12",[["ὁ",709436,3],["δὲ",703303,11],["τἀληθὲς",700658,697],["αὐτοὺς",702165,62],["λέγειν",708124,55],["παραδεξάμενος",710013,248],["καὶ",707031,7],["παραινέσας",710031,182],["ἔδωκεν",703654,2],["αὐτοῖς",702165,151],["ἄδειαν",700242,9],["πάντων",710177,198],["ὅπως",709719,7],["τοὺς",709436,58],["παραβεβηκότας",709996,277],["τοῦ",709436,35],["θεοῦ",706192,18],["τὸν",709436,5],["νόμον",709349,6],["ἐξολεθρεύσωσιν",704956,234],["κατὰ",707200,0],["πάντα",710177,27],["τὸν",709436,5],["ὑπὸ",713184,0],["τὴν",709436,8],["βασιλείαν",702577,9],["αὐτοῦ",702165,102],["τόπον",712903,6],["μετὰ",708780,0],["παρρησίας",710173,17],["ἄνευ",701137,0],["πάσης",710177,82],["βασιλικῆς",702582,82],["ἐξουσίας",704974,17],["καὶ",707031,7],["ἐπισκέψεως",705252,17]],"The king admitted the truth of this reasoning, and commended them. Full power was given them, without warrant or special commission, to destroy those who had transgressed the law of God boldly in every part of the king's dominions."],["13",[["τότε",712908,28],["κατευφημήσαντες",707524,196],["αὐτόν",702165,85],["ὡς",714148,28],["πρέπον",710728,47],["ἦν",704093,13],["οἱ",709436,136],["τούτων",709858,40],["ἱερεῖς",706614,52],["καὶ",707031,7],["πᾶν",710177,46],["τὸ",709436,24],["πλῆθος",710529,25],["ἐπιφωνήσαντες",705329,196],["τὸ",709436,24],["αλληλουια",700688,88],["μετὰ",708780,0],["χαρᾶς",713719,17],["ἀνέλυσαν",700995,150]],"Their priests, then, as it was meet, saluted him with good wishes, and all the people echoed with the Hallelujah. They then joyfully departed."],["14",[["οὕτως",709859,28],["τε",712751,11],["τὸν",709436,5],["ἐμπεσόντα",704593,676],["τῶν",709436,80],["μεμιαμμένων",708900,445],["ὁμοεθνῆ",709621,27],["κατὰ",707200,0],["τὴν",709436,8],["ὁδὸν",709458,9],["ἐκολάζοντο",707786,139],["καὶ",707031,7],["μετὰ",708780,0],["παραδειγματισμῶν",710010,18],["ἀνῄρουν",700962,137]],"Then they punished and destroyed with ignominy every polluted Jew that fell in their way;"],["15",[["ἐκείνῃ",704183,105],["δὲ",703303,11],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἀνεῖλον",700962,150],["ὑπὲρ",713111,0],["τοὺς",709436,58],["τριακοσίους",712936,60],["ἄνδρας",701150,57],["ἣν",709781,131],["καὶ",707031,7],["ἤγαγον",700209,150],["εὐφροσύνην",705717,9],["μετὰ",708780,0],["χαρᾶς",713719,17],["βεβήλους",702613,60],["χειρωσάμενοι",713798,317]],"slaying thus, in that day, above three hundred men, and esteeming this destruction of the wicked a season of joy."],["16",[["αὐτοὶ",702165,201],["δὲ",703303,11],["οἱ",709436,136],["μέχρι",708849,0],["θανάτου",706096,18],["τὸν",709436,5],["θεὸν",706192,6],["ἐσχηκότες",705785,268],["παντελῆ",709977,36],["σωτηρίας",712658,17],["ἀπόλαυσιν",701505,9],["εἰληφότες",708076,268],["ἀνέζευξαν",700941,150],["ἐκ",704132,0],["τῆς",709436,16],["πόλεως",710612,17],["παντοίοις",709985,94],["εὐωδεστάτοις",705733,509],["ἄνθεσιν",701157,96],["κατεστεμμένοι",707444,317],["μετ᾿",708780,0],["εὐφροσύνης",705717,17],["καὶ",707031,7],["βοῆς",702744,17],["ἐν",704639,0],["αἴνοις",700462,148],["καὶ",707031,7],["παμμελέσιν",709948,230],["ὕμνοις",713089,148],["εὐχαριστοῦντες",705721,146],["τῷ",709436,113],["θεῷ",706192,114],["τῶν",709436,80],["πατέρων",710189,81],["αὐτῶν",702165,40],["αἰωνίῳ",700505,30],["σωτῆρι",712657,114],["τοῦ",709436,35],["Ισραηλ",706839,18]],"They themselves having held fast their God unto death, and having enjoyed a full deliverance, departed from the city garlanded with sweet-flowered wreaths of every kind. Uttering exclamations of joy, with songs of praise, and melodious hymns they thanked the God of their fathers, the eternal Saviour of Israel."],["17",[["παραγενηθέντες",710006,247],["δὲ",703303,11],["εἰς",704105,0],["Πτολεμαίδα",711066,9],["τὴν",709436,8],["ὀνομαζομένην",709667,173],["διὰ",703417,0],["τὴν",709436,8],["τοῦ",709436,35],["τόπου",712903,18],["ἰδιότητα",706494,9],["ῥοδοφόρον",711283,36],["ἐν",704639,0],["ᾗ",709781,108],["προσέμεινεν",710934,2],["αὐτοὺς",702165,62],["ὁ",709436,3],["στόλος",712124,4],["κατὰ",707200,0],["κοινὴν",707772,36],["αὐτῶν",702165,40],["βουλὴν",702792,9],["ἡμέρας",705984,39],["ἑπτά",705357,59]],"Having arrived at Ptolemais, called from the specialty of that district Rose-bearing, where the fleet, in accordance with the general wish, waited for them seven days,"],["18",[["ἐκεῖ",704181,28],["ἐποίησαν",710582,150],["πότον",710704,6],["σωτήριον",712659,27],["τοῦ",709436,35],["βασιλέως",702580,18],["χορηγήσαντος",713911,500],["αὐτοῖς",702165,151],["εὐψύχως",705732,28],["τὰ",709436,41],["πρὸς",710844,0],["τὴν",709436,8],["ἄφιξιν",702213,9],["πάντα",710177,68],["ἑκάστῳ",704133,30],["ἕως",705792,0],["εἰς",704105,0],["τὴν",709436,8],["ἰδίαν",706493,36],["οἰκίαν",709505,9]],"they partook of a banquet of deliverance, for the king generously granted them severally the means of securing a return home."],["19",[["καταχθέντες",707232,247],["δὲ",703303,11],["μετ᾿",708780,0],["εἰρήνης",704098,17],["ἐν",704639,0],["ταῖς",709436,75],["πρεπούσαις",710728,495],["ἐξομολογήσεσιν",704961,76],["ὡσαύτως",714158,28],["κἀκεῖ",707051,554],["ἔστησαν",706846,150],["καὶ",707031,28],["ταύτας",709858,231],["ἄγειν",700209,55],["τὰς",709436,38],["ἡμέρας",705984,39],["ἐπὶ",705080,0],["τὸν",709436,5],["τῆς",709436,16],["παροικίας",710158,17],["αὐτῶν",702165,40],["χρόνον",713969,6],["εὐφροσύνους",705718,119]],"They were accordingly brought back in peace, while they gave utterance to becoming thanks; and they determined to keep these days during their sojourn as days of joyfulness."],["20",[["ἃς",709781,193],["καὶ",707031,7],["ἀνιερώσαντες",701167,196],["ἐν",704639,0],["στήλῃ",712092,1],["κατὰ",707200,0],["τὸν",709436,5],["τῆς",709436,16],["συμποσίας",712344,17],["τόπον",712903,6],["προσευχῆς",710892,17],["καθιδρύσαντες",707004,196],["ἀνέλυσαν",700995,150],["ἀσινεῖς",701957,138],["ἐλεύθεροι",704428,138],["ὑπερχαρεῖς",713169,138],["διά",703417,0],["τε",712751,11],["γῆς",703083,17],["καὶ",707031,7],["θαλάσσης",706069,17],["καὶ",707031,7],["ποταμοῦ",710693,18],["ἀνασῳζόμενοι",701064,348],["τῇ",709436,100],["τοῦ",709436,35],["βασιλέως",702580,18],["ἐπιταγῇ",705290,1],["ἕκαστος",704133,14],["εἰς",704105,0],["τὴν",709436,8],["ἰδίαν",706493,36]],"These they registered as sacred upon a pillar, when they had dedicated the place of their festivity to be one of prayer. They departed unharmed, free, abundant in joy, preserved by the king's command, by land, by sea, and by river, each to his own home."],["21",[["καὶ",707031,7],["πλείστην",710646,506],["ἢ",705924,7],["ἔμπροσθεν",704618,28],["ἐν",704639,0],["τοῖς",709436,147],["ἐχθροῖς",705779,230],["ἐξουσίαν",704974,9],["ἐσχηκότες",705785,268],["μετὰ",708780,0],["δόξης",703791,17],["καὶ",707031,7],["φόβου",713534,18],["τὸ",709436,24],["σύνολον",712498,46],["ὑπὸ",713184,0],["μηδενὸς",708857,116],["διασεισθέντες",703574,247],["τῶν",709436,80],["ὑπαρχόντων",713102,170]],"They had more weight than before among their enemies; and were honoured and feared, and no one in any way robbed them of their goods."],["22",[["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["ἑαυτῶν",703917,40],["πάντες",710177,138],["ἐκομίσαντο",707805,189],["ἐξ",704132,0],["ἀπογραφῆς",701436,17],["ὥστε",714164,7],["τοὺς",709436,58],["ἔχοντάς",705785,235],["τι",712866,126],["μετὰ",708780,0],["φόβου",713534,18],["μεγίστου",708653,216],["ἀποδοῦναι",701449,106],["αὐτοῖς",702165,151],["τὰ",709436,41],["μεγαλεῖα",708625,68],["τοῦ",709436,35],["μεγίστου",708653,216],["θεοῦ",706192,18],["ποιήσαντος",710582,500],["τελείως",712772,28],["ἐπὶ",705080,0],["σωτηρίᾳ",712658,1],["αὐτῶν",702165,40]],"Every man received back his own, according to inventory; those who had obtained their goods, giving them up with the greatest terror. For the greatest God wrought with perfectness wonders for their salvation."],["23",[["εὐλογητὸς",705632,14],["ὁ",709436,3],["ῥύστης",711313,4],["Ισραηλ",706839,18],["εἰς",704105,0],["τοὺς",709436,58],["ἀεὶ",700311,28],["χρόνους",713969,57],["αμην",700818,88]],"Blessed be the Redeemer of Israel unto everlasting. Amen."]]