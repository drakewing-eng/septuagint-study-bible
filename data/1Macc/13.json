[["1",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Σιμων",711792,4],["ὅτι",709803,7],["συνήγαγεν",712375,2],["Τρύφων",713010,4],["δύναμιν",703839,9],["πολλὴν",710646,36],["τοῦ",709436,20],["ἐλθεῖν",705453,106],["εἰς",704105,0],["γῆν",703083,9],["Ιουδα",706768,18],["καὶ",707031,7],["ἐκτρῖψαι",704345,106],["αὐτήν",702165,104]],"Now when Simon heard that Tryphon had gathered together a great host to invade the land of Judea, and destroy it,"],["2",[["καὶ",707031,7],["εἶδεν",709725,2],["τὸν",709436,5],["λαόν",708094,6],["ὅτι",709803,7],["ἔντρομός",704808,14],["ἐστιν",704093,91],["καὶ",707031,7],["ἔκφοβος",704361,14],["καὶ",707031,7],["ἀνέβη",700905,2],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["ἤθροισεν",700384,2],["τὸν",709436,5],["λαὸν",708094,6]],"and saw that the people was in great trembling and fear, he went up to Jerusalem, and gathered the people together,"],["3",[["καὶ",707031,7],["παρεκάλεσεν",710039,2],["αὐτοὺς",702165,62],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["αὐτοὶ",702165,201],["οἴδατε",709492,330],["ὅσα",709788,68],["ἐγὼ",704018,164],["καὶ",707031,7],["οἱ",709436,136],["ἀδελφοί",700249,52],["μου",709032,133],["καὶ",707031,7],["ὁ",709436,3],["οἶκος",709516,4],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133],["ἐποιήσαμεν",710582,289],["περὶ",710285,0],["τῶν",709436,80],["νόμων",709349,81],["καὶ",707031,7],["τῶν",709436,80],["ἁγίων",700159,169],["καὶ",707031,7],["τοὺς",709436,58],["πολέμους",710605,57],["καὶ",707031,7],["τὰς",709436,38],["στενοχωρίας",712071,39],["ἃς",709781,193],["εἴδομεν",709725,289]],"and gave them exhortation, saying, Ye yourselves know what great things I, and my brethren, and my father's house, have done for the laws and the sanctuary, the battles also and troubles which we have seen,"],["4",[["τούτου",709858,102],["χάριν",713735,9],["ἀπώλοντο",701513,189],["οἱ",709436,136],["ἀδελφοί",700249,52],["μου",709032,133],["πάντες",710177,138],["χάριν",713735,9],["τοῦ",709436,35],["Ισραηλ",706839,18],["καὶ",707031,7],["κατελείφθην",707305,156],["ἐγὼ",704018,164],["μόνος",709003,14]],"by reason whereof all my brethren are slain for Israel's sake, and I am left alone."],["5",[["καὶ",707031,7],["νῦν",709384,28],["μή",708851,28],["μοι",708974,159],["γένοιτο",703104,382],["φείσασθαί",713406,109],["μου",709032,133],["τῆς",709436,16],["ψυχῆς",714070,17],["ἐν",704639,0],["παντὶ",710177,30],["καιρῷ",707047,114],["θλίψεως",706276,17],["οὐ",709805,28],["γάρ",702963,11],["εἰμι",704093,157],["κρείσσων",707891,14],["τῶν",709436,80],["ἀδελφῶν",700249,81],["μου",709032,133]],"Now therefore be it far from me, that I should spare mine own life in any time of trouble: for I am no better than my brethren."],["6",[["πλὴν",710540,28],["ἐκδικήσω",704174,165],["περὶ",710285,0],["τοῦ",709436,20],["ἔθνους",704068,21],["μου",709032,133],["καὶ",707031,7],["περὶ",710285,0],["τῶν",709436,80],["ἁγίων",700159,169],["καὶ",707031,7],["περὶ",710285,0],["τῶν",709436,130],["γυναικῶν",703209,65],["καὶ",707031,7],["τέκνων",712761,44],["ὑμῶν",713091,145],["ὅτι",709803,7],["συνήχθησαν",712375,99],["πάντα",710177,68],["τὰ",709436,41],["ἔθνη",704068,42],["ἐκτρῖψαι",704345,106],["ἡμᾶς",705981,194],["ἔχθρας",705775,82],["χάριν",713735,9]],"Doubtless I will avenge my nation, and the sanctuary, and our wives, and our children: for all the heathen are gathered to destroy us of very malice."],["7",[["καὶ",707031,7],["ἀνεζωπύρησεν",700946,2],["τὸ",709436,34],["πνεῦμα",710566,15],["τοῦ",709436,35],["λαοῦ",708094,18],["ἅμα",700745,28],["τοῦ",709436,20],["ἀκοῦσαι",700587,106],["τῶν",709436,80],["λόγων",708236,81],["τούτων",709858,40]],"Now as soon as the people heard these words, their spirit revived."],["8",[["καὶ",707031,7],["ἀπεκρίθησαν",701492,99],["φωνῇ",713640,1],["μεγάλῃ",708653,101],["λέγοντες",708124,146],["σὺ",712181,164],["εἶ",704093,154],["ἡμῶν",705999,145],["ἡγούμενος",705931,122],["ἀντὶ",701227,0],["Ιουδου",706775,18],["καὶ",707031,7],["Ιωναθου",706927,18],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["σου",711945,133]],"And they answered with a loud voice, saying, Thou shalt be our leader instead of Judas and Jonathan thy brother."],["9",[["πολέμησον",710601,176],["τὸν",709436,5],["πόλεμον",710605,6],["ἡμῶν",705999,145],["καὶ",707031,7],["πάντα",710177,68],["ὅσα",709788,68],["ἂν",700900,11],["εἴπῃς",705373,175],["ἡμῖν",705994,90],["ποιήσομεν",710582,275]],"Fight thou our battles, and whatsoever thou commandest us, that will we do."],["10",[["καὶ",707031,7],["συνήγαγεν",712375,2],["πάντας",710177,60],["τοὺς",709436,58],["ἄνδρας",701150,57],["τοὺς",709436,58],["πολεμιστὰς",710604,57],["καὶ",707031,7],["ἐτάχυνεν",712749,2],["τοῦ",709436,20],["τελέσαι",712783,106],["τὰ",709436,41],["τείχη",712759,42],["Ιερουσαλημ",706644,17],["καὶ",707031,7],["ὠχύρωσεν",709890,2],["αὐτὴν",702165,104],["κυκλόθεν",707956,28]],"So then he gathered together all the men of war, and made haste to finish the walls of Jerusalem, and he fortified it round about."],["11",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Ιωναθαν",706927,4],["τὸν",709436,5],["τοῦ",709436,35],["Αψαλωμου",702320,18],["καὶ",707031,7],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["δύναμιν",703839,9],["ἱκανὴν",706710,36],["εἰς",704105,0],["Ιοππην",706760,9],["καὶ",707031,7],["ἐξέβαλεν",704145,2],["τοὺς",709436,58],["ὄντας",704093,235],["ἐν",704639,0],["αὐτῇ",702165,105],["καὶ",707031,7],["ἔμεινεν",708736,2],["ἐκεῖ",704181,28],["ἐν",704639,0],["αὐτῇ",702165,105]],"Also he sent Jonathan the [son] of Absalom, and with him a great power, to Joppe: who casting out them that were therein remained there in it."],["12",[["καὶ",707031,7],["ἀπῆρεν",701329,2],["Τρύφων",713010,4],["ἀπὸ",701425,0],["Πτολεμαίδος",711066,17],["μετὰ",708780,0],["δυνάμεως",703839,17],["πολλῆς",710646,82],["ἐλθεῖν",705453,106],["εἰς",704105,0],["γῆν",703083,9],["Ιουδα",706768,18],["καὶ",707031,7],["Ιωναθαν",706927,4],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἐν",704639,0],["φυλακῇ",713613,1]],"So Tryphon removed from Ptolemais with a great power to invade the land of Judea, and Jonathan was with him in ward."],["13",[["Σιμων",711792,4],["δὲ",703303,11],["παρενέβαλεν",710132,2],["ἐν",704639,0],["Αδιδοις",700266,285],["κατὰ",707200,0],["πρόσωπον",710986,25],["τοῦ",709436,20],["πεδίου",710215,21]],"But Simon pitched his tents at Adida, over against the plain."],["14",[["καὶ",707031,7],["ἐπέγνω",705104,2],["Τρύφων",713010,4],["ὅτι",709803,7],["ἀνέστη",701173,2],["Σιμων",711792,4],["ἀντὶ",701227,0],["Ιωναθου",706927,18],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὅτι",709803,7],["συνάπτειν",712404,55],["αὐτῷ",702165,50],["μέλλει",708705,91],["πόλεμον",710605,6],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["πρὸς",710844,0],["αὐτὸν",702165,85],["πρέσβεις",710733,57],["λέγων",708124,72]],"Now when Tryphon knew that Simon was risen up instead of his brother Jonathan, and meant to join battle with him, he sent messengers unto him, saying,"],["15",[["περὶ",710285,0],["ἀργυρίου",701707,21],["οὗ",709781,160],["ὤφειλεν",709865,13],["Ιωναθαν",706927,4],["ὁ",709436,3],["ἀδελφός",700249,4],["σου",711945,133],["εἰς",704105,0],["τὸ",709436,24],["βασιλικὸν",702582,46],["δι᾿",703417,0],["ἃς",709781,193],["εἶχεν",705785,13],["χρείας",713938,39],["συνέχομεν",712469,243],["αὐτόν",702165,85]],"Whereas we have Jonathan thy brother in hold, it is for money that he is owing unto the king's treasure, concerning the business that was committed unto him."],["16",[["καὶ",707031,7],["νῦν",709384,28],["ἀπόστειλον",701592,176],["ἀργυρίου",701707,21],["τάλαντα",712697,42],["ἑκατὸν",704136,59],["καὶ",707031,7],["δύο",703849,59],["τῶν",709436,80],["υἱῶν",713075,81],["αὐτοῦ",702165,102],["ὅμηρα",709612,68],["ὅπως",709719,7],["μὴ",708851,28],["ἀφεθεὶς",702211,217],["ἀποστατήσῃ",701589,172],["ἀφ᾿",701425,0],["ἡμῶν",705999,145],["καὶ",707031,7],["ἀφήσομεν",702211,275],["αὐτόν",702165,85]],"Wherefore now send an hundred talents of silver, and two of his sons for hostages, that when he is at liberty he may not revolt from us, and we will let him go."],["17",[["καὶ",707031,7],["ἔγνω",703105,2],["Σιμων",711792,4],["ὅτι",709803,7],["δόλῳ",703787,114],["λαλοῦσιν",708071,197],["πρὸς",710844,0],["αὐτόν",702165,85],["καὶ",707031,7],["πέμπει",710246,91],["τοῦ",709436,20],["λαβεῖν",708076,106],["τὸ",709436,24],["ἀργύριον",701707,25],["καὶ",707031,7],["τὰ",709436,41],["παιδάρια",709923,42],["μήποτε",708882,28],["ἔχθραν",705775,36],["ἄρῃ",700473,172],["μεγάλην",708653,36],["πρὸς",710844,0],["τὸν",709436,5],["λαὸν",708094,6]],"Hereupon Simon, albeit he perceived that they spake deceitfully unto him, yet sent he the money and the children, lest peradventure he should procure to himself great hatred of the people:"],["18",[["λέγοντες",708124,146],["ὅτι",709803,7],["οὐκ",709805,28],["ἀπέστειλα",701592,155],["αὐτῷ",702165,50],["τὸ",709436,24],["ἀργύριον",701707,25],["καὶ",707031,7],["τὰ",709436,41],["παιδάρια",709923,42],["ἀπώλετο",701513,23]],"who might have said, Because I sent him not the money and the children, therefore is [Jonathan] dead."],["19",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["τὰ",709436,41],["παιδάρια",709923,42],["καὶ",707031,7],["τὰ",709436,41],["ἑκατὸν",704136,59],["τάλαντα",712697,42],["καὶ",707031,7],["διεψεύσατο",703642,23],["καὶ",707031,7],["οὐκ",709805,28],["ἀφῆκεν",702211,2],["τὸν",709436,5],["Ιωναθαν",706927,6]],"So he sent them the children and the hundred talents: howbeit [Tryphon] dissembled, neither would he let Jonathan go."],["20",[["καὶ",707031,7],["μετὰ",708780,0],["ταῦτα",709858,71],["ἦλθεν",705453,2],["Τρύφων",713010,4],["τοῦ",709436,20],["ἐμβατεῦσαι",704548,106],["εἰς",704105,0],["τὴν",709436,8],["χώραν",714011,9],["καὶ",707031,7],["ἐκτρῖψαι",704345,106],["αὐτήν",702165,104],["καὶ",707031,7],["ἐκύκλωσαν",707958,150],["ὁδὸν",709458,9],["τὴν",709436,8],["εἰς",704105,0],["Αδωρα",700308,227],["καὶ",707031,7],["Σιμων",711792,4],["καὶ",707031,7],["ἡ",709436,10],["παρεμβολὴ",710133,12],["αὐτοῦ",702165,102],["ἀντιπαρῆγεν",701260,13],["αὐτῷ",702165,50],["εἰς",704105,0],["πάντα",710177,27],["τόπον",712903,6],["οὗ",709781,48],["ἂν",700900,11],["ἐπορεύετο",710667,19]],"And after this came Tryphon to invade the land, and destroy it, going round about by the way that leadeth unto Adora: but Simon and his host marched against him in every place, wheresoever he went."],["21",[["οἱ",709436,136],["δὲ",703303,11],["ἐκ",704132,0],["τῆς",709436,16],["ἄκρας",700588,17],["ἀπέστελλον",701592,137],["πρὸς",710844,0],["Τρύφωνα",713010,6],["πρεσβευτὰς",710731,57],["κατασπεύδοντας",707433,235],["αὐτὸν",702165,85],["τοῦ",709436,20],["ἐλθεῖν",705453,106],["πρὸς",710844,0],["αὐτοὺς",702165,62],["διὰ",703417,0],["τῆς",709436,16],["ἐρήμου",705420,17],["καὶ",707031,7],["ἀποστεῖλαι",701592,106],["αὐτοῖς",702165,151],["τροφάς",712984,39]],"Now they that were in the tower sent messengers unto Tryphon, to the end that he should hasten his coming unto them by the wilderness, and send them victuals."],["22",[["καὶ",707031,7],["ἡτοίμασεν",705539,2],["Τρύφων",713010,4],["πᾶσαν",710177,36],["τὴν",709436,8],["ἵππον",706790,9],["αὐτοῦ",702165,102],["ἐλθεῖν",705453,106],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["νυκτὶ",709386,1],["ἐκείνῃ",704183,105],["ἦν",704093,13],["χιὼν",713870,12],["πολλὴ",710646,29],["σφόδρα",712586,28],["καὶ",707031,7],["οὐκ",709805,28],["ἦλθεν",705453,2],["διὰ",703417,0],["τὴν",709436,8],["χιόνα",713870,9],["καὶ",707031,7],["ἀπῆρεν",701329,2],["καὶ",707031,7],["ἦλθεν",705453,2],["εἰς",704105,0],["τὴν",709436,8],["Γαλααδῖτιν",702925,9]],"Wherefore Tryphon made ready all his horsemen to come that night: but there fell a very great snow, by reason whereof he came not. So he departed, and came into the country of Galaad."],["23",[["ὡς",714148,7],["δὲ",703303,11],["ἤγγισεν",703939,2],["τῆς",709436,16],["Βασκαμα",702587,17],["ἀπέκτεινεν",701498,2],["τὸν",709436,5],["Ιωναθαν",706927,6],["καὶ",707031,7],["ἐτάφη",706103,37],["ἐκεῖ",704181,28]],"And when he came near to Bascama, he slew Jonathan, who was buried there."],["24",[["καὶ",707031,7],["ἐπέστρεψεν",705278,2],["Τρύφων",713010,4],["καὶ",707031,7],["ἀπῆλθεν",701398,2],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["αὐτοῦ",702165,102]],"Afterward Tryphon returned and went into his own land."],["25",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Σιμων",711792,4],["καὶ",707031,7],["ἔλαβεν",708076,2],["τὰ",709436,41],["ὀστᾶ",709792,42],["Ιωναθου",706927,18],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔθαψεν",706103,2],["αὐτὸν",702165,85],["ἐν",704639,0],["Μωδεϊν",709092,1],["πόλει",710612,1],["τῶν",709436,80],["πατέρων",710189,81],["αὐτοῦ",702165,102]],"Then sent Simon, and took the bones of Jonathan his brother, and buried them in Modin, the city of his fathers."],["26",[["καὶ",707031,7],["ἐκόψαντο",707829,189],["αὐτὸν",702165,85],["πᾶς",710177,14],["Ισραηλ",706839,4],["κοπετὸν",707821,6],["μέγαν",708653,27],["καὶ",707031,7],["ἐπένθησαν",710251,150],["αὐτὸν",702165,85],["ἡμέρας",705984,39],["πολλάς",710646,119]],"And all Israel made great lamentation for him, and bewailed him many days."],["27",[["καὶ",707031,7],["ᾠκοδόμησεν",709509,2],["Σιμων",711792,4],["ἐπὶ",705080,0],["τὸν",709436,5],["τάφον",712738,6],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["τῶν",709436,80],["ἀδελφῶν",700249,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὕψωσεν",713289,2],["αὐτὸν",702165,85],["τῇ",709436,100],["ὁράσει",709721,1],["λίθῳ",708196,114],["ξεστῷ",709418,30],["ἐκ",704132,0],["τῶν",709436,80],["ὄπισθεν",709691,28],["καὶ",707031,7],["ἔμπροσθεν",704618,28]],"Simon also built a monument upon the sepulchre of his father and his brethren, and raised it aloft to the sight, with hewn stone behind and before."],["28",[["καὶ",707031,7],["ἔστησεν",706846,2],["ἑπτὰ",705357,59],["πυραμίδας",711090,9],["μίαν",704106,36],["κατέναντι",707507,28],["τῆς",709436,16],["μιᾶς",704106,82],["τῷ",709436,113],["πατρὶ",710189,114],["καὶ",707031,7],["τῇ",709436,100],["μητρὶ",708892,1],["καὶ",707031,7],["τοῖς",709436,147],["τέσσαρσιν",712808,230],["ἀδελφοῖς",700249,148]],"Moreover he set up seven pyramids, one against another, for his father, and his mother, and his four brethren."],["29",[["καὶ",707031,7],["ταύταις",709858,200],["ἐποίησεν",710582,2],["μηχανήματα",708899,42],["περιθεὶς",710403,182],["στύλους",712179,57],["μεγάλους",708653,60],["καὶ",707031,7],["ἐποίησεν",710582,2],["ἐπὶ",705080,0],["τοῖς",709436,147],["στύλοις",712179,148],["πανοπλίας",709968,39],["εἰς",704105,0],["ὄνομα",709666,25],["αἰώνιον",700505,46],["καὶ",707031,7],["παρὰ",709995,0],["ταῖς",709436,75],["πανοπλίαις",709968,76],["πλοῖα",710556,42],["ἐγγεγλυμμένα",703941,437],["εἰς",704105,0],["τὸ",709436,24],["θεωρεῖσθαι",706226,110],["ὑπὸ",713184,0],["πάντων",710177,169],["τῶν",709436,80],["πλεόντων",710526,170],["τὴν",709436,8],["θάλασσαν",706069,9]],"And in these he made cunning devices, about the which he set great pillars, and upon the pillars he made all their armour for a perpetual memory, and by the armour ships carved, that they might be seen of all that sail on the sea."],["30",[["οὗτος",709858,121],["ὁ",709436,3],["τάφος",712738,4],["ὃν",709781,112],["ἐποίησεν",710582,2],["ἐν",704639,0],["Μωδεϊν",709092,1],["ἕως",705792,28],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86]],"This is the sepulchre which he made at Modin, and it standeth yet unto this day."],["31",[["ὁ",709436,3],["δὲ",703303,11],["Τρύφων",713010,4],["ἐπορεύετο",710667,19],["δόλῳ",703787,114],["μετὰ",708780,0],["Ἀντιόχου",701257,18],["τοῦ",709436,35],["βασιλέως",702580,18],["τοῦ",709436,35],["νεωτέρου",709256,229],["καὶ",707031,7],["ἀπέκτεινεν",701498,2],["αὐτὸν",702165,85]],"Now Tryphon dealt deceitfully with the young king Antiochus, and slew him."],["32",[["καὶ",707031,7],["ἐβασίλευσεν",702581,2],["ἀντ᾿",701227,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["περιέθετο",710403,23],["τὸ",709436,24],["διάδημα",703447,25],["τῆς",709436,16],["Ἀσίας",701944,17],["καὶ",707031,7],["ἐποίησεν",710582,2],["πληγὴν",710527,9],["μεγάλην",708653,36],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17]],"And he reigned in his stead, and crowned himself king of Asia, and brought a great calamity upon the land."],["33",[["καὶ",707031,7],["ᾠκοδόμησεν",709509,2],["Σιμων",711792,4],["τὰ",709436,41],["ὀχυρώματα",709891,42],["τῆς",709436,16],["Ιουδαίας",706769,1],["καὶ",707031,7],["περιετείχισεν",710400,2],["πύργοις",711092,148],["ὑψηλοῖς",713285,230],["καὶ",707031,7],["τείχεσιν",712759,96],["μεγάλοις",708653,94],["καὶ",707031,7],["πύλαις",711082,76],["καὶ",707031,7],["μοχλοῖς",709040,148],["καὶ",707031,7],["ἔθετο",712849,23],["βρώματα",702823,42],["ἐν",704639,0],["τοῖς",709436,95],["ὀχυρώμασιν",709891,96]],"Then Simon built up the strong holds in Judea, and fenced them about with high towers, and great walls, and gates, and bars, and laid up victuals therein."],["34",[["καὶ",707031,7],["ἐπέλεξεν",705188,2],["Σιμων",711792,4],["ἄνδρας",701150,57],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["πρὸς",710844,0],["Δημήτριον",703407,6],["τὸν",709436,5],["βασιλέα",702580,6],["τοῦ",709436,20],["ποιῆσαι",710582,106],["ἄφεσιν",702199,9],["τῇ",709436,100],["χώρᾳ",714011,1],["ὅτι",709803,7],["πᾶσαι",710177,192],["αἱ",709436,190],["πράξεις",710714,191],["Τρύφωνος",713010,18],["ἦσαν",704093,137],["ἁρπαγαί",701802,191]],"Moreover Simon chose men, and sent to king Demetrius, to the end he should give the land an immunity, because all that Tryphon did was to spoil."],["35",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["αὐτῷ",702165,50],["Δημήτριος",703407,4],["ὁ",709436,3],["βασιλεὺς",702580,4],["κατὰ",707200,0],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["καὶ",707031,7],["ἀπεκρίθη",701492,37],["αὐτῷ",702165,50],["καὶ",707031,7],["ἔγραψεν",703194,2],["αὐτῷ",702165,50],["ἐπιστολὴν",705272,9],["τοιαύτην",712878,36]],"Unto whom king Demetrius answered and wrote after this manner:"],["36",[["βασιλεὺς",702580,4],["Δημήτριος",703407,4],["Σιμωνι",711792,114],["ἀρχιερεῖ",701845,114],["καὶ",707031,7],["φίλῳ",713492,30],["βασιλέων",702580,81],["καὶ",707031,7],["πρεσβυτέροις",710735,148],["καὶ",707031,7],["ἔθνει",704068,54],["Ιουδαίων",706772,81],["χαίρειν",713665,55]],"King Demetrius unto Simon the high priest, and friend of kings, as also unto the elders and nation of the Jews, sendeth greeting:"],["37",[["τὸν",709436,5],["στέφανον",712083,6],["τὸν",709436,5],["χρυσοῦν",713971,27],["καὶ",707031,7],["τὴν",709436,8],["βαΐνην",702444,9],["ἣν",709781,131],["ἀπεστείλατε",701592,265],["κεκομίσμεθα",707805,580],["καὶ",707031,7],["ἕτοιμοί",705541,138],["ἐσμεν",704093,243],["τοῦ",709436,20],["ποιεῖν",710582,55],["ὑμῖν",713084,90],["εἰρήνην",704098,9],["μεγάλην",708653,36],["καὶ",707031,7],["γράφειν",703194,55],["τοῖς",709436,147],["ἐπὶ",705080,0],["τῶν",709436,130],["χρειῶν",713938,65],["τοῦ",709436,20],["ἀφιέναι",702211,55],["ὑμῖν",713084,90],["τὰ",709436,41],["ἀφέματα",702195,42]],"The golden crown, and the scarlet robe, which ye sent unto us, we have received: and we are ready to make a stedfast peace with you, yea, and to write unto our officers, to confirm the immunities which we have granted."],["38",[["καὶ",707031,7],["ὅσα",709788,68],["ἐστήσαμεν",706846,289],["πρὸς",710844,0],["ὑμᾶς",713080,194],["ἕστηκεν",706846,171],["καὶ",707031,7],["τὰ",709436,41],["ὀχυρώματα",709891,42],["ἃ",709781,69],["ᾠκοδομήσατε",709509,265],["ὑπαρχέτω",713104,31],["ὑμῖν",713084,90]],"And whatsoever covenants we have made with you shall stand; and the strong holds, which ye have builded, shall be your own."],["39",[["ἀφίεμεν",702211,243],["δὲ",703303,11],["ἀγνοήματα",700176,42],["καὶ",707031,7],["τὰ",709436,41],["ἁμαρτήματα",700774,42],["ἕως",705792,28],["τῆς",709436,16],["σήμερον",711751,28],["ἡμέρας",705984,17],["καὶ",707031,7],["τὸν",709436,5],["στέφανον",712083,6],["ὃν",709781,112],["ὠφείλετε",709865,399],["καὶ",707031,7],["εἴ",704071,7],["τι",712866,273],["ἄλλο",700697,132],["ἐτελωνεῖτο",712788,530],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["μηκέτι",708867,28],["τελωνείσθω",712788,628]],"As for any oversight or fault committed unto this day, we forgive it, and the crown tax also, which ye owe us: and if there were any other tribute paid in Jerusalem, it shall no more be paid."],["40",[["καὶ",707031,7],["εἴ",704071,7],["τινες",712866,392],["ἐπιτήδειοι",705300,138],["ὑμῶν",713091,145],["γραφῆναι",703194,179],["εἰς",704105,0],["τοὺς",709436,58],["περὶ",710285,0],["ἡμᾶς",705981,194],["ἐγγραφέσθωσαν",703943,650],["καὶ",707031,7],["γινέσθω",703104,407],["ἀνὰ",700902,0],["μέσον",708768,27],["ἡμῶν",705999,145],["εἰρήνη",704098,12]],"And look who are meet among you to be in our court, let them be enrolled, and let there be peace betwixt us."],["41",[["ἔτους",705543,21],["ἑβδομηκοστοῦ",703924,92],["καὶ",707031,7],["ἑκατοστοῦ",704143,92],["ἤρθη",700473,37],["ὁ",709436,3],["ζυγὸς",705894,15],["τῶν",709436,43],["ἐθνῶν",704068,44],["ἀπὸ",701425,0],["τοῦ",709436,35],["Ισραηλ",706839,18]],"Thus the yoke of the heathen was taken away from Israel in the hundred and seventieth year."],["42",[["καὶ",707031,7],["ἤρξατο",701860,23],["ὁ",709436,3],["λαὸς",708094,4],["γράφειν",703194,55],["ἐν",704639,0],["ταῖς",709436,75],["συγγραφαῖς",712192,76],["καὶ",707031,7],["συναλλάγμασιν",712382,96],["ἔτους",705543,21],["πρώτου",711041,404],["ἐπὶ",705080,0],["Σιμωνος",711792,18],["ἀρχιερέως",701845,18],["μεγάλου",708653,116],["καὶ",707031,7],["στρατηγοῦ",712144,18],["καὶ",707031,7],["ἡγουμένου",705931,262],["Ιουδαίων",706772,81]],"Then the people of Israel began to write in their instruments and contracts, In the first year of Simon the high priest, the governor and leader of the Jews."],["43",[["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["παρενέβαλεν",710132,2],["ἐπὶ",705080,0],["Γαζαρα",702887,227],["καὶ",707031,7],["ἐκύκλωσεν",707958,2],["αὐτὴν",702165,104],["παρεμβολαῖς",710133,76],["καὶ",707031,7],["ἐποίησεν",710582,2],["ἑλεόπολιν",704425,9],["καὶ",707031,7],["προσήγαγεν",710848,2],["τῇ",709436,100],["πόλει",710612,1],["καὶ",707031,7],["ἐπάταξεν",710185,2],["πύργον",711092,6],["ἕνα",704106,27],["καὶ",707031,7],["κατελάβετο",707300,23]],"In those days Simon camped against Gaza, and besieged it round about; he made also an engine of war, and set it by the city, and battered a certain tower, and took it."],["44",[["καὶ",707031,7],["ἐξήλλοντο",704856,139],["οἱ",709436,136],["ἐν",704639,0],["τῇ",709436,100],["ἑλεοπόλει",704425,1],["εἰς",704105,0],["τὴν",709436,8],["πόλιν",710612,9],["καὶ",707031,7],["ἐγένετο",703104,23],["κίνημα",707680,15],["μέγα",708653,26],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1]],"And they that were in the engine leaped into the city; whereupon there was a great uproar in the city:"],["45",[["καὶ",707031,7],["ἀνέβησαν",700905,150],["οἱ",709436,136],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["σὺν",712372,0],["γυναιξὶν",703209,76],["καὶ",707031,7],["τοῖς",709436,95],["τέκνοις",712761,96],["ἐπὶ",705080,0],["τὸ",709436,24],["τεῖχος",712759,25],["διερρηχότες",703566,268],["τὰ",709436,41],["ἱμάτια",706742,42],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐβόησαν",702743,150],["φωνῇ",713640,1],["μεγάλῃ",708653,101],["ἀξιοῦντες",701309,146],["Σιμωνα",711792,6],["δεξιὰς",703360,119],["αὐτοῖς",702165,151],["δοῦναι",703654,106]],"insomuch as the people of the city rent their clothes, and climbed upon the walls with their wives and children, and cried with a loud voice, beseeching Simon to grant them peace."],["46",[["καὶ",707031,7],["εἶπαν",705373,150],["μὴ",708851,28],["ἡμῖν",705994,90],["χρήσῃ",713937,420],["κατὰ",707200,0],["τὰς",709436,38],["πονηρίας",710659,39],["ἡμῶν",705999,145],["ἀλλὰ",700680,7],["κατὰ",707200,0],["τὸ",709436,24],["ἔλεός",704426,25],["σου",711945,133]],"And they said, Deal not with us according to our wickedness, but according to thy mercy."],["47",[["καὶ",707031,7],["συνελύθη",712273,37],["αὐτοῖς",702165,151],["Σιμων",711792,4],["καὶ",707031,7],["οὐκ",709805,28],["ἐπολέμησεν",710601,2],["αὐτούς",702165,62],["καὶ",707031,7],["ἐξέβαλεν",704145,2],["αὐτοὺς",702165,62],["ἐκ",704132,0],["τῆς",709436,16],["πόλεως",710612,17],["καὶ",707031,7],["ἐκαθάρισεν",706985,2],["τὰς",709436,38],["οἰκίας",709505,39],["ἐν",704639,0],["αἷς",709781,281],["ἦν",704093,13],["τὰ",709436,41],["εἴδωλα",704079,42],["καὶ",707031,7],["οὕτως",709859,28],["εἰσῆλθεν",704114,2],["εἰς",704105,0],["αὐτὴν",702165,104],["ὑμνῶν",713089,81],["καὶ",707031,7],["εὐλογῶν",705631,72]],"So Simon was appeased toward them, and fought no more against them, but put them out of the city, and cleansed the houses wherein the idols were, and so entered into it with songs and thanksgiving."],["48",[["καὶ",707031,7],["ἐξέβαλεν",704145,2],["ἐξ",704132,0],["αὐτῆς",702165,86],["πᾶσαν",710177,36],["ἀκαθαρσίαν",700507,9],["καὶ",707031,7],["κατῴκισεν",707534,2],["ἐν",704639,0],["αὐτῇ",702165,105],["ἄνδρας",701150,57],["οἵτινες",709793,450],["τὸν",709436,5],["νόμον",709349,6],["ποιήσωσιν",710582,234],["καὶ",707031,7],["προσωχύρωσεν",710947,2],["αὐτὴν",702165,104],["καὶ",707031,7],["ᾠκοδόμησεν",709509,2],["ἑαυτῷ",703917,50],["ἐν",704639,0],["αὐτῇ",702165,105],["οἴκησιν",709501,9]],"Yea, he put all uncleanness out of it, and placed such men there as would keep the law, and made it stronger than it was before, and built therein a dwelling place for himself."],["49",[["οἱ",709436,136],["δὲ",703303,11],["ἐκ",704132,0],["τῆς",709436,16],["ἄκρας",700588,17],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["ἐκωλύοντο",708020,139],["ἐκπορεύεσθαι",704293,110],["καὶ",707031,7],["εἰσπορεύεσθαι",704124,110],["εἰς",704105,0],["τὴν",709436,8],["χώραν",714011,9],["ἀγοράζειν",700184,55],["καὶ",707031,7],["πωλεῖν",711116,55],["καὶ",707031,7],["ἐπείνασαν",710222,150],["σφόδρα",712586,28],["καὶ",707031,7],["ἀπώλοντο",701513,189],["ἐξ",704132,0],["αὐτῶν",702165,40],["ἱκανοὶ",706710,138],["τῷ",709436,113],["λιμῷ",708210,114]],"They also of the tower in Jerusalem were kept so strait, that they could neither come forth, nor go into the country, nor buy, nor sell: wherefore they were in great distress for want of victuals, and a great number of them perished through famine."],["50",[["καὶ",707031,7],["ἐβόησαν",702743,150],["πρὸς",710844,0],["Σιμωνα",711792,6],["δεξιὰς",703360,119],["λαβεῖν",708076,106],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἐξέβαλεν",704145,2],["αὐτοὺς",702165,62],["ἐκεῖθεν",704182,28],["καὶ",707031,7],["ἐκαθάρισεν",706985,2],["τὴν",709436,8],["ἄκραν",700588,9],["ἀπὸ",701425,0],["τῶν",709436,43],["μιασμάτων",708909,44]],"Then cried they to Simon, beseeching him to be at one with them: which thing he granted them; and when he had put them out from thence, he cleansed the tower from pollutions;"],["51",[["καὶ",707031,7],["εἰσῆλθον",704114,150],["εἰς",704105,0],["αὐτὴν",702165,104],["τῇ",709436,100],["τρίτῃ",712968,101],["καὶ",707031,7],["εἰκάδι",704082,1],["τοῦ",709436,35],["δευτέρου",703389,116],["μηνὸς",708874,18],["ἔτους",705543,21],["πρώτου",711041,404],["καὶ",707031,7],["ἑβδομηκοστοῦ",703924,92],["καὶ",707031,7],["ἑκατοστοῦ",704143,92],["μετὰ",708780,0],["αἰνέσεως",700457,17],["καὶ",707031,7],["βαΐων",702446,44],["καὶ",707031,7],["ἐν",704639,0],["κινύραις",707684,76],["καὶ",707031,7],["ἐν",704639,0],["κυμβάλοις",707972,96],["καὶ",707031,7],["ἐν",704639,0],["νάβλαις",709142,76],["καὶ",707031,7],["ἐν",704639,0],["ὕμνοις",713089,148],["καὶ",707031,7],["ἐν",704639,0],["ᾠδαῖς",714091,76],["ὅτι",709803,7],["συνετρίβη",712520,37],["ἐχθρὸς",705779,14],["μέγας",708653,14],["ἐξ",704132,0],["Ισραηλ",706839,18]],"and entered into it the three and twentieth day of the second month, in the hundred seventy and first year, with thanksgiving, and branches of palm trees, and with harps, and cymbals, and with viols, and hymns, and songs: because there was destroyed a great enemy out of Israel."],["52",[["καὶ",707031,7],["ἔστησεν",706846,2],["κατ᾿",707200,0],["ἐνιαυτὸν",704745,6],["τοῦ",709436,20],["ἄγειν",700209,55],["τὴν",709436,8],["ἡμέραν",705984,9],["ταύτην",709858,104],["μετὰ",708780,0],["εὐφροσύνης",705717,17],["καὶ",707031,7],["προσωχύρωσεν",710947,2],["τὸ",70943