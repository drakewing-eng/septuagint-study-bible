[["1",[["καὶ",707031,7],["ἀνέβη",700905,2],["Ιωαννης",706892,4],["ἐκ",704132,0],["Γαζαρων",702889,118],["καὶ",707031,7],["ἀπήγγειλεν",701321,2],["Σιμωνι",711792,114],["τῷ",709436,113],["πατρὶ",710189,114],["αὐτοῦ",702165,102],["ἃ",709781,69],["συνετέλεσεν",712510,2],["Κενδεβαῖος",707602,4]],"Then came up John from Gazara, and told Simon his father what Cendebeus had done."],["2",[["καὶ",707031,7],["ἐκάλεσεν",707084,2],["Σιμων",711792,4],["τοὺς",709436,58],["δύο",703849,59],["υἱοὺς",713075,57],["αὐτοῦ",702165,102],["τοὺς",709436,58],["πρεσβυτέρους",710735,60],["Ιουδαν",706775,6],["καὶ",707031,7],["Ιωαννην",706891,6],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["ἐγὼ",704018,164],["καὶ",707031,7],["οἱ",709436,136],["ἀδελφοί",700249,52],["μου",709032,133],["καὶ",707031,7],["ὁ",709436,3],["οἶκος",709516,4],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133],["ἐπολεμήσαμεν",710601,289],["τοὺς",709436,58],["πολέμους",710605,57],["Ισραηλ",706839,18],["ἀπὸ",701425,0],["νεότητος",709258,17],["ἕως",705792,28],["τῆς",709436,16],["σήμερον",711751,28],["ἡμέρας",705984,17],["καὶ",707031,7],["εὐοδώθη",705654,37],["ἐν",704639,0],["ταῖς",709436,75],["χερσὶν",713787,76],["ἡμῶν",705999,145],["ῥύσασθαι",711309,109],["τὸν",709436,5],["Ισραηλ",706839,4],["πλεονάκις",710517,28]],"Wherefore Simon called his two eldest sons, Judas and John, and said unto them, I, and my brethren, and my father's house, have ever from our youth unto this day fought against the enemies of Israel; and things have prospered so well in our hands, that we have delivered Israel oftentimes."],["3",[["νυνὶ",709385,28],["δὲ",703303,11],["γεγήρακα",703090,89],["καὶ",707031,7],["ὑμεῖς",713081,219],["δὲ",703303,11],["ἐν",704639,0],["τῷ",709436,53],["ἐλέει",704426,54],["ἱκανοί",706710,138],["ἐστε",704093,87],["ἐν",704639,0],["τοῖς",709436,95],["ἔτεσιν",705543,96],["γίνεσθε",703104,374],["ἀντ᾿",701227,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["μου",709032,133],["καὶ",707031,7],["ἐξελθόντες",704909,196],["ὑπερμαχεῖτε",713148,335],["ὑπὲρ",713111,0],["τοῦ",709436,20],["ἔθνους",704068,21],["ἡμῶν",705999,145],["ἡ",709436,10],["δὲ",703303,11],["ἐκ",704132,0],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["βοήθεια",702745,12],["ἔστω",704093,31],["μεθ᾿",708780,0],["ὑμῶν",713091,145]],"But now I am old, and ye, by [God's] mercy, are of a sufficient age: be ye instead of me and my brother, and go and fight for our nation, and the help from heaven be with you."],["4",[["καὶ",707031,7],["ἐπέλεξεν",705188,2],["ἐκ",704132,0],["τῆς",709436,16],["χώρας",714011,17],["εἴκοσι",704085,59],["χιλιάδας",713858,39],["ἀνδρῶν",701150,81],["πολεμιστῶν",710604,81],["καὶ",707031,7],["ἱππεῖς",706786,57],["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["ἐπὶ",705080,0],["τὸν",709436,5],["Κενδεβαῖον",707602,6],["καὶ",707031,7],["ἐκοιμήθησαν",707767,99],["ἐν",704639,0],["Μωδεϊν",709092,1]],"So he chose out of the country twenty thousand men of war with horsemen, who went out against Cendebeus, and rested that night at Modin."],["5",[["καὶ",707031,7],["ἀναστάντες",701173,196],["τὸ",709436,24],["πρωὶ",711021,28],["ἐπορεύθησαν",710667,99],["εἰς",704105,0],["τὸ",709436,24],["πεδίον",710215,25],["καὶ",707031,7],["ἰδοὺ",706497,88],["δύναμις",703839,12],["πολλὴ",710646,29],["εἰς",704105,0],["συνάντησιν",712397,9],["αὐτοῖς",702165,151],["πεζικὴ",710217,29],["καὶ",707031,7],["ἱππεῖς",706786,52],["καὶ",707031,7],["χειμάρρους",713783,52],["ἦν",704093,13],["ἀνὰ",700902,0],["μέσον",708768,27],["αὐτῶν",702165,40]],"And when as they rose in the morning, and went into the plain, behold, a mighty great host both of footmen and horsemen came against them: howbeit there was a water brook betwixt them."],["6",[["καὶ",707031,7],["παρενέβαλε",710132,2],["κατὰ",707200,0],["πρόσωπον",710986,25],["αὐτῶν",702165,40],["αὐτὸς",702165,121],["καὶ",707031,7],["ὁ",709436,3],["λαὸς",708094,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶδεν",709725,2],["τὸν",709436,5],["λαὸν",708094,6],["δειλούμενον",703323,212],["διαπερᾶσαι",703543,106],["τὸν",709436,5],["χειμάρρουν",713783,27],["καὶ",707031,7],["διεπέρασεν",703543,2],["πρῶτος",711041,140],["καὶ",707031,7],["εἶδον",709725,150],["αὐτὸν",702165,85],["οἱ",709436,136],["ἄνδρες",701150,52],["καὶ",707031,7],["διεπέρασαν",703543,150],["κατόπισθεν",707544,28],["αὐτοῦ",702165,102]],"So he and his people pitched over against them: and when he saw that the people were afraid to go over the water brook, he went first over himself, and then the men seeing him passed through after him."],["7",[["καὶ",707031,7],["διεῖλεν",703459,2],["τὸν",709436,5],["λαὸν",708094,6],["καὶ",707031,7],["τοὺς",709436,58],["ἱππεῖς",706786,57],["ἐν",704639,0],["μέσῳ",708768,30],["τῶν",709436,80],["πεζῶν",710219,169],["ἦν",704093,13],["δὲ",703303,11],["ἵππος",706790,12],["τῶν",709436,80],["ὑπεναντίων",713109,169],["πολλὴ",710646,29],["σφόδρα",712586,28]],"[That done], he divided his men, and set the horsemen in the midst of the footmen: for the enemies' horsemen were very many."],["8",[["καὶ",707031,7],["ἐσάλπισαν",711425,150],["ταῖς",709436,75],["σάλπιγξιν",711424,76],["καὶ",707031,7],["ἐτροπώθη",712981,37],["Κενδεβαῖος",707602,4],["καὶ",707031,7],["ἡ",709436,10],["παρεμβολὴ",710133,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔπεσον",710481,150],["ἐξ",704132,0],["αὐτῶν",702165,40],["τραυματίαι",712921,52],["πολλοί",710646,138],["οἱ",709436,136],["δὲ",703303,11],["καταλειφθέντες",707305,247],["ἔφυγον",713433,150],["εἰς",704105,0],["τὸ",709436,24],["ὀχύρωμα",709891,25]],"Then sounded they with the holy trumpets: whereupon Cendebeus and his host were put to flight, so that many of them were slain, and the remnant gat them to the strong hold."],["9",[["τότε",712908,28],["ἐτραυματίσθη",712922,37],["Ιουδας",706775,4],["ὁ",709436,3],["ἀδελφὸς",700249,4],["Ιωαννου",706892,18],["Ιωαννης",706892,4],["δὲ",703303,11],["κατεδίωξεν",707243,2],["αὐτούς",702165,62],["ἕως",705792,7],["ἦλθεν",705453,2],["εἰς",704105,0],["Κεδρων",707591,9],["ἣν",709781,131],["ᾠκοδόμησεν",709509,2]],"At that time was Judas John's brother wounded; but John still followed after them, until he came to Cedron, which [Cendebeus] had built."],["10",[["καὶ",707031,7],["ἔφυγον",713433,150],["εἰς",704105,0],["τοὺς",709436,58],["πύργους",711092,57],["τοὺς",709436,58],["ἐν",704639,0],["τοῖς",709436,147],["ἀγροῖς",700196,148],["Ἀζώτου",700351,18],["καὶ",707031,7],["ἐνεπύρισεν",704622,2],["αὐτὴν",702165,104],["ἐν",704639,0],["πυρί",711088,54],["καὶ",707031,7],["ἔπεσον",710481,150],["ἐξ",704132,0],["αὐτῶν",702165,40],["εἰς",704105,0],["ἄνδρας",701150,57],["δισχιλίους",703747,60],["καὶ",707031,7],["ἀπέστρεψεν",701598,2],["εἰς",704105,0],["τὴν",709436,8],["Ιουδαίαν",706769,9],["μετὰ",708780,0],["εἰρήνης",704098,17]],"So they fled even unto the towers in the fields of Azotus; wherefore he burned it with fire: so that there were slain of them about two thousand men. Afterward he returned into the land of Judea in peace."],["11",[["καὶ",707031,7],["Πτολεμαῖος",711066,4],["ὁ",709436,3],["τοῦ",709436,35],["Ἀβούβου",700086,18],["ἦν",704093,13],["καθεσταμένος",707011,419],["στρατηγὸς",712144,4],["εἰς",704105,0],["τὸ",709436,24],["πεδίον",710215,25],["Ιεριχω",706620,118],["καὶ",707031,7],["ἔσχεν",705785,2],["ἀργύριον",701707,25],["καὶ",707031,7],["χρυσίον",713972,25],["πολύ",710646,46]],"Moreover in the plain of Jericho was Ptolemeus the [son] of Abubus made captain, and he had abundance of silver and gold:"],["12",[["ἦν",704093,13],["γὰρ",702963,11],["γαμβρὸς",702950,4],["τοῦ",709436,35],["ἀρχιερέως",701845,18]],"for he was the high priest's son in law."],["13",[["καὶ",707031,7],["ὑψώθη",713289,37],["ἡ",709436,10],["καρδία",707141,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐβουλήθη",702795,37],["κατακρατῆσαι",707287,106],["τῆς",709436,16],["χώρας",714011,17],["καὶ",707031,7],["ἐβουλεύετο",702791,19],["δόλῳ",703787,114],["κατὰ",707200,0],["Σιμωνος",711792,18],["καὶ",707031,7],["τῶν",709436,80],["υἱῶν",713075,81],["αὐτοῦ",702165,102],["ἆραι",700473,106],["αὐτούς",702165,62]],"Wherefore his heart being lifted up, he thought to get the country to himself, and thereupon consulted deceitfully against Simon and his sons to destroy them."],["14",[["Σιμων",711792,4],["δὲ",703303,11],["ἦν",704093,13],["ἐφοδεύων",705757,72],["τὰς",709436,38],["πόλεις",710612,39],["τὰς",709436,38],["ἐν",704639,0],["τῇ",709436,100],["χώρᾳ",714011,1],["καὶ",707031,7],["φροντίζων",713590,72],["τῆς",709436,16],["ἐπιμελείας",705198,17],["αὐτῶν",702165,40],["καὶ",707031,7],["κατέβη",707202,2],["εἰς",704105,0],["Ιεριχω",706620,227],["αὐτὸς",702165,121],["καὶ",707031,7],["Ματταθιας",708585,4],["καὶ",707031,7],["Ιουδας",706775,4],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτοῦ",702165,102],["ἔτους",705543,21],["ἑβδόμου",703925,92],["καὶ",707031,7],["ἑβδομηκοστοῦ",703924,92],["καὶ",707031,7],["ἑκατοστοῦ",704143,92],["ἐν",704639,0],["μηνὶ",708874,114],["ἑνδεκάτῳ",704676,30],["οὗτος",709858,121],["ὁ",709436,3],["μὴν",708874,4],["Σαβατ",711343,118]],"Now Simon was visiting the cities that were in the country, and taking care for the good ordering of them; at which time he came down himself to Jericho with his sons, Mattathias and Judas, in the hundred threescore and seventeenth year, in the eleventh month, called Sabat:"],["15",[["καὶ",707031,7],["ὑπεδέξατο",713193,23],["αὐτοὺς",702165,62],["ὁ",709436,3],["τοῦ",709436,35],["Ἀβούβου",700086,18],["εἰς",704105,0],["τὸ",709436,24],["ὀχυρωμάτιον",709892,25],["τὸ",709436,24],["καλούμενον",707084,214],["Δωκ",703895,227],["μετὰ",708780,0],["δόλου",703787,18],["ὃ",709781,128],["ᾠκοδόμησεν",709509,2],["καὶ",707031,7],["ἐποίησεν",710582,2],["αὐτοῖς",702165,151],["πότον",710702,6],["μέγαν",708653,27],["καὶ",707031,7],["ἐνέκρυψεν",703993,2],["ἐκεῖ",704181,28],["ἄνδρας",701150,57]],"where the [son] of Abubus receiving them deceitfully into a little hold, called Docus, which he had built, made them a great banquet: howbeit he had hid men there."],["16",[["καὶ",707031,7],["ὅτε",709802,28],["ἐμεθύσθη",708676,37],["Σιμων",711792,4],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτοῦ",702165,102],["ἐξανέστη",704865,2],["Πτολεμαῖος",711066,4],["καὶ",707031,7],["οἱ",709436,136],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔλαβον",708076,150],["τὰ",709436,41],["ὅπλα",709704,42],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπεισῆλθον",705059,150],["τῷ",709436,113],["Σιμωνι",711792,114],["εἰς",704105,0],["τὸ",709436,24],["συμπόσιον",712345,25],["καὶ",707031,7],["ἀπέκτειναν",701498,150],["αὐτὸν",702165,85],["καὶ",707031,7],["τοὺς",709436,58],["δύο",703849,59],["υἱοὺς",713075,57],["αὐτοῦ",702165,102],["καί",707031,7],["τινας",712866,668],["τῶν",709436,43],["παιδαρίων",709923,44],["αὐτοῦ",702165,102]],"So when Simon and his sons had drunk largely, Ptolemee and his men rose up, and took their weapons, and came upon Simon into the banqueting place, and slew him, and his two sons, and certain of his servants."],["17",[["καὶ",707031,7],["ἐποίησεν",710582,2],["ἀθεσίαν",700366,36],["μεγάλην",708653,36],["καὶ",707031,7],["ἀπέδωκεν",701449,2],["κακὰ",707066,68],["ἀντὶ",701227,0],["ἀγαθῶν",700106,169]],"In which doing he committed a great treachery, and recompensed evil for good."],["18",[["καὶ",707031,7],["ἔγραψεν",703194,2],["ταῦτα",709858,71],["Πτολεμαῖος",711066,4],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["τῷ",709436,113],["βασιλεῖ",702580,114],["ὅπως",709719,7],["ἀποστείλῃ",701592,172],["αὐτῷ",702165,50],["δυνάμεις",703839,39],["εἰς",704105,0],["βοήθειαν",702745,9],["καὶ",707031,7],["παραδῷ",710014,172],["τὴν",709436,8],["χώραν",714011,9],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰς",709436,38],["πόλεις",710612,39]],"Then Ptolemee wrote these things, and sent to the king, that he should send him an host to aid him, and he would deliver him the country and cities."],["19",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["ἑτέρους",705535,60],["εἰς",704105,0],["Γαζαρα",702887,227],["ἆραι",700473,106],["τὸν",709436,5],["Ιωαννην",706892,6],["καὶ",707031,7],["τοῖς",709436,147],["χιλιάρχοις",713857,148],["ἀπέστειλεν",701592,2],["ἐπιστολὰς",705272,39],["παραγενέσθαι",710006,109],["πρὸς",710844,0],["αὐτόν",702165,85],["ὅπως",709719,7],["δῷ",703654,172],["αὐτοῖς",702165,151],["ἀργύριον",701707,25],["καὶ",707031,7],["χρυσίον",713972,25],["καὶ",707031,7],["δόματα",703789,42]],"He sent others also to Gazara to kill John: and unto the tribunes he sent letters to come unto him, that he might give them silver, and gold, and rewards."],["20",[["καὶ",707031,7],["ἑτέρους",705535,60],["ἀπέστειλεν",701592,2],["καταλαβέσθαι",707300,109],["τὴν",709436,8],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["τὸ",709436,24],["ὄρος",709768,25],["τοῦ",709436,20],["ἱεροῦ",706631,21]],"And others he sent to take Jerusalem, and the mountain of the temple."],["21",[["καὶ",707031,7],["προδραμών",710997,182],["τις",712866,158],["ἀπήγγειλεν",701321,2],["Ιωαννη",706892,114],["εἰς",704105,0],["Γαζαρα",702887,227],["ὅτι",709803,7],["ἀπώλετο",701513,23],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὅτι",709803,7],["ἀπέσταλκεν",701592,171],["καὶ",707031,7],["σὲ",711598,163],["ἀποκτεῖναι",701498,106]],"Now one had run afore to Gazara, and told John that his father and brethren were slain, and, [quoth he, Ptolemee] hath sent to slay thee also."],["22",[["καὶ",707031,7],["ἀκούσας",700587,182],["ἐξέστη",704940,2],["σφόδρα",712586,28],["καὶ",707031,7],["συνέλαβεν",712262,2],["τοὺς",709436,58],["ἄνδρας",701150,57],["τοὺς",709436,58],["ἐλθόντας",705453,454],["ἀπολέσαι",701513,106],["αὐτὸν",702165,85],["καὶ",707031,7],["ἀπέκτεινεν",701498,2],["αὐτούς",702165,62],["ἐπέγνω",705104,2],["γὰρ",702963,11],["ὅτι",709803,7],["ἐζήτουν",705879,137],["αὐτὸν",702165,85],["ἀπολέσαι",701513,106]],"Hereof when he heard, he was sore astonished: so he laid hands on them that were come to destroy him, and slew them; for he knew that they sought to make him away."],["23",[["καὶ",707031,7],["τὰ",709436,63],["λοιπὰ",708248,195],["τῶν",709436,80],["λόγων",708236,81],["Ιωαννου",706892,18],["καὶ",707031,7],["τῶν",709436,80],["πολέμων",710605,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["τῶν",709436,130],["ἀνδραγαθιῶν",701098,65],["αὐτοῦ",702165,102],["ὧν",709781,199],["ἠνδραγάθησεν",701096,2],["καὶ",707031,7],["τῆς",709436,16],["οἰκοδομῆς",709510,17],["τῶν",709436,43],["τειχῶν",712759,44],["ὧν",709781,103],["ᾠκοδόμησεν",709509,2],["καὶ",707031,7],["τῶν",709436,130],["πράξεων",710714,65],["αὐτοῦ",702165,102]],"As concerning the rest of the acts of John, and his wars, and worthy deeds which he did, and the building of the walls which he made, and his doings,"],["24",[["ἰδοὺ",706497,88],["ταῦτα",709858,290],["γέγραπται",703194,403],["ἐπὶ",705080,0],["βιβλίῳ",702719,54],["ἡμερῶν",705984,65],["ἀρχιερωσύνης",701846,17],["αὐτοῦ",702165,102],["ἀφ᾿",701425,0],["οὗ",709781,48],["ἐγενήθη",703104,37],["ἀρχιερεὺς",701845,4],["μετὰ",708780,0],["τὸν",709436,5],["πατέρα",710189,6],["αὐτοῦ",702165,102]],"behold, these are written in the chronicles of his priesthood, from the time he was made high priest after his father."]]