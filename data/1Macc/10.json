[["1",[["καὶ",707031,7],["ἐν",704639,0],["ἔτει",705543,54],["ἑξηκοστῷ",704924,97],["καὶ",707031,7],["ἑκατοστῷ",704143,97],["ἀνέβη",700905,2],["Ἀλέξανδρος",700652,4],["ὁ",709436,3],["τοῦ",709436,35],["Ἀντιόχου",701257,18],["ὁ",709436,3],["Ἐπιφανὴς",705320,4],["καὶ",707031,7],["κατελάβετο",707300,23],["Πτολεμαίδα",711066,9],["καὶ",707031,7],["ἐπεδέξαντο",705117,189],["αὐτόν",702165,85],["καὶ",707031,7],["ἐβασίλευσεν",702581,2],["ἐκεῖ",704181,28]],"In the hundred and sixtieth year Alexander, the [son] of Antiochus [surnamed] Epiphanes, went up and took Ptolemais: for the people had received him, by means whereof he reigned there."],["2",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Δημήτριος",703407,4],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["συνήγαγεν",712375,2],["δυνάμεις",703839,39],["πολλὰς",710646,119],["σφόδρα",712586,28],["καὶ",707031,7],["ἐξῆλθεν",704909,2],["εἰς",704105,0],["συνάντησιν",712397,9],["αὐτῷ",702165,50],["εἰς",704105,0],["πόλεμον",710605,6]],"Now when king Demetrius heard thereof, he gathered together an exceeding great host, and went forth against him to fight."],["3",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Δημήτριος",703407,4],["πρὸς",710844,0],["Ιωναθαν",706927,6],["ἐπιστολὰς",705272,39],["λόγοις",708236,148],["εἰρηνικοῖς",704099,230],["ὥστε",714164,7],["μεγαλῦναι",708647,106],["αὐτόν",702165,85]],"Moreover Demetrius sent letters unto Jonathan with loving words, so as he magnified him."],["4",[["εἶπεν",705373,2],["γάρ",702963,11],["προφθάσωμεν",711011,79],["τοῦ",709436,20],["εἰρήνην",704098,9],["θεῖναι",712849,106],["μετ᾿",708780,0],["αὐτῶν",702165,40],["πρὶν",710742,28],["ἢ",705924,7],["θεῖναι",712849,106],["αὐτὸν",702165,85],["μετὰ",708780,0],["Ἀλεξάνδρου",700652,18],["καθ᾿",707200,0],["ἡμῶν",705999,145]],"For said he, Let us first make peace with him, before he join with Alexander against us:"],["5",[["μνησθήσεται",708923,134],["γὰρ",702963,11],["πάντων",710177,83],["τῶν",709436,43],["κακῶν",707066,83],["ὧν",709781,103],["συνετελέσαμεν",712510,289],["πρὸς",710844,0],["αὐτὸν",702165,85],["καὶ",707031,7],["εἰς",704105,0],["τοὺς",709436,58],["ἀδελφοὺς",700249,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἰς",704105,0],["τὸ",709436,24],["ἔθνος",704068,25]],"else he will remember all the evils that we have done against him, and against his brethren and his people."],["6",[["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["ἐξουσίαν",704974,9],["συναγαγεῖν",712375,106],["δυνάμεις",703839,39],["καὶ",707031,7],["κατασκευάζειν",707419,55],["ὅπλα",709704,42],["καὶ",707031,7],["εἶναι",704093,55],["αὐτὸν",702165,85],["σύμμαχον",712301,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["ὅμηρα",709612,68],["τὰ",709436,41],["ἐν",704639,0],["τῇ",709436,100],["ἄκρᾳ",700588,1],["εἶπεν",705373,2],["παραδοῦναι",710014,106],["αὐτῷ",702165,50]],"Wherefore he gave him authority to gather together an host, and to provide weapons, that he might aid him in battle: he commanded also that the hostages that were in the tower should be delivered him."],["7",[["καὶ",707031,7],["ἦλθεν",705453,2],["Ιωναθαν",706927,4],["εἰς",704105,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["ἀνέγνω",700922,2],["τὰς",709436,38],["ἐπιστολὰς",705272,39],["εἰς",704105,0],["τὰ",709436,41],["ὦτα",709852,42],["παντὸς",710177,116],["τοῦ",709436,35],["λαοῦ",708094,18],["καὶ",707031,7],["τῶν",709436,80],["ἐκ",704132,0],["τῆς",709436,16],["ἄκρας",700588,17]],"Then came Jonathan to Jerusalem, and read the letters in the audience of all the people, and of them that were in the tower:"],["8",[["καὶ",707031,7],["ἐφοβήθησαν",713532,99],["φόβον",713534,6],["μέγαν",708653,27],["ὅτε",709802,28],["ἤκουσαν",700587,150],["ὅτι",709803,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐξουσίαν",704974,9],["συναγαγεῖν",712375,106],["δύναμιν",703839,9]],"who were sore afraid, when they heard that the king had given him authority to gather together an host."],["9",[["καὶ",707031,7],["παρέδωκαν",710014,150],["οἱ",709436,136],["ἐκ",704132,0],["τῆς",709436,16],["ἄκρας",700588,17],["Ιωναθαν",706927,114],["τὰ",709436,41],["ὅμηρα",709612,68],["καὶ",707031,7],["ἀπέδωκεν",701449,2],["αὐτοὺς",702165,62],["τοῖς",709436,147],["γονεῦσιν",703169,148],["αὐτῶν",702165,40]],"Whereupon they of the tower delivered their hostages unto Jonathan, and he delivered them unto their parents."],["10",[["καὶ",707031,7],["ᾤκησεν",709499,2],["Ιωναθαν",706927,4],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["ἤρξατο",701860,23],["οἰκοδομεῖν",709509,55],["καὶ",707031,7],["καινίζειν",707041,55],["τὴν",709436,8],["πόλιν",710612,9]],"This done, Jonathan settled himself in Jerusalem, and began to build and repair the city."],["11",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["τοὺς",709436,58],["ποιοῦντας",710582,235],["τὰ",709436,41],["ἔργα",705396,42],["οἰκοδομεῖν",709509,55],["τὰ",709436,41],["τείχη",712759,42],["καὶ",707031,7],["τὸ",709436,24],["ὄρος",709768,25],["Σιων",711816,118],["κυκλόθεν",707956,28],["ἐκ",704132,0],["λίθων",708196,81],["τετραπόδων",712823,169],["εἰς",704105,0],["ὀχύρωσιν",709893,9],["καὶ",707031,7],["ἐποίησαν",710582,150],["οὕτως",709859,28]],"And he commanded the workmen to build the walls and the mount Sion round about with square stones for fortification; and they did so."],["12",[["καὶ",707031,7],["ἔφυγον",713433,150],["οἱ",709436,136],["ἀλλογενεῖς",700690,138],["οἱ",709436,136],["ὄντες",704093,146],["ἐν",704639,0],["τοῖς",709436,95],["ὀχυρώμασιν",709891,96],["οἷς",709781,295],["ᾠκοδόμησεν",709509,2],["Βακχίδης",702461,4]],"Then the strangers, that were in the fortresses which Bacchides had built, fled away;"],["13",[["καὶ",707031,7],["κατέλιπεν",707305,2],["ἕκαστος",704133,14],["τὸν",709436,5],["τόπον",712903,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀπῆλθεν",701398,2],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["αὐτοῦ",702165,102]],"insomuch as every man left his place, and went into his own country."],["14",[["πλὴν",710540,28],["ἐν",704639,0],["Βαιθσουροις",702436,285],["ὑπελείφθησάν",713212,99],["τινες",712866,392],["τῶν",709436,80],["καταλιπόντων",707305,221],["τὸν",709436,5],["νόμον",709349,6],["καὶ",707031,7],["τὰ",709436,41],["προστάγματα",710959,42],["ἦν",704093,13],["γὰρ",702963,11],["εἰς",704105,0],["φυγαδευτήριον",713605,25]],"Only at Bethsura certain of those that had forsaken the law and the commandments remained still: for it was their place of refuge."],["15",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Ἀλέξανδρος",700652,4],["ὁ",709436,3],["βασιλεὺς",702580,4],["τὰς",709436,38],["ἐπαγγελίας",704991,39],["ὅσας",709788,119],["ἀπέστειλεν",701592,2],["Δημήτριος",703407,4],["τῷ",709436,113],["Ιωναθαν",706927,114],["καὶ",707031,7],["διηγήσαντο",703679,189],["αὐτῷ",702165,50],["τοὺς",709436,58],["πολέμους",710605,57],["καὶ",707031,7],["τὰς",709436,38],["ἀνδραγαθίας",701098,39],["ἃς",709781,193],["ἐποίησεν",710582,2],["αὐτὸς",702165,121],["καὶ",707031,7],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["τοὺς",709436,58],["κόπους",707825,57],["οὓς",709781,298],["ἔσχον",705785,150]],"Now when king Alexander had heard what promises Demetrius had sent unto Jonathan: when also it was told him of the battles and noble acts which he and his brethren had done, and of the pains that they had endured,"],["16",[["καὶ",707031,7],["εἶπεν",705373,2],["μὴ",708851,28],["εὑρήσομεν",705676,275],["ἄνδρα",701150,6],["τοιοῦτον",712878,27],["ἕνα",704106,27],["καὶ",707031,7],["νῦν",709384,28],["ποιήσομεν",710582,275],["αὐτὸν",702165,85],["φίλον",713492,27],["καὶ",707031,7],["σύμμαχον",712301,6],["ἡμῶν",705999,145]],"he said, Shall we find such another man? now therefore we will make him our friend and confederate."],["17",[["καὶ",707031,7],["ἔγραψεν",703194,2],["ἐπιστολὰς",705272,39],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["αὐτῷ",702165,50],["κατὰ",707200,0],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["λέγων",708124,72]],"Upon this he wrote a letter, and sent it unto him, according to these words, saying,"],["18",[["βασιλεὺς",702580,4],["Ἀλέξανδρος",700652,4],["τῷ",709436,113],["ἀδελφῷ",700249,114],["Ιωναθαν",706927,114],["χαίρειν",713665,55]],"King Alexander to his brother Jonathan sendeth greeting:"],["19",[["ἀκηκόαμεν",700587,314],["περὶ",710285,0],["σοῦ",711945,133],["ὅτι",709803,7],["ἀνὴρ",701150,4],["δυνατὸς",703845,14],["ἰσχύι",706858,1],["καὶ",707031,7],["ἐπιτήδειος",705300,14],["εἶ",704093,154],["τοῦ",709436,20],["εἶναι",704093,55],["ἡμῶν",705999,145],["φίλος",713492,14]],"We have heard of thee, that thou art a man of great power, and meet to be our friend."],["20",[["καὶ",707031,7],["νῦν",709384,28],["καθεστάκαμέν",707011,314],["σε",711598,163],["σήμερον",711751,28],["ἀρχιερέα",701845,6],["τοῦ",709436,20],["ἔθνους",704068,21],["σου",711945,133],["καὶ",707031,7],["φίλον",713492,27],["βασιλέως",702580,18],["καλεῖσθαί",707084,110],["σε",711598,163],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["αὐτῷ",702165,50],["πορφύραν",710682,9],["καὶ",707031,7],["στέφανον",712083,6],["χρυσοῦν",713971,27],["καὶ",707031,7],["φρονεῖν",713586,55],["τὰ",709436,41],["ἡμῶν",705999,145],["καὶ",707031,7],["συντηρεῖν",712512,55],["φιλίας",713474,17],["πρὸς",710844,0],["ἡμᾶς",705981,194]],"Wherefore now this day we ordain thee to be the high priest of thy nation, and to be called the king's friend; (and therewithal he sent him a purple robe and a crown of gold:) and [require thee] to take our part, and keep friendship with us."],["21",[["καὶ",707031,7],["ἐνεδύσατο",704701,23],["Ιωναθαν",706927,4],["τὴν",709436,8],["ἁγίαν",700159,36],["στολὴν",712120,9],["τῷ",709436,113],["ἑβδόμῳ",703925,30],["μηνὶ",708874,114],["ἔτους",705543,21],["ἑξηκοστοῦ",704924,92],["καὶ",707031,7],["ἑκατοστοῦ",704143,92],["ἐν",704639,0],["ἑορτῇ",704990,1],["σκηνοπηγίας",711846,17],["καὶ",707031,7],["συνήγαγεν",712375,2],["δυνάμεις",703839,191],["καὶ",707031,7],["κατεσκεύασεν",707419,2],["ὅπλα",709704,42],["πολλά",710646,68]],"So in the seventh month of the hundred and sixtieth year, at the feast of the tabernacles, Jonathan put on the holy robe, and gathered together forces, and provided much armour."],["22",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Δημήτριος",703407,4],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["καὶ",707031,7],["ἐλυπήθη",708272,37],["καὶ",707031,7],["εἶπεν",705373,2]],"Whereof when Demetrius heard, he was very sorry, and said,"],["23",[["τί",712867,126],["τοῦτο",709858,129],["ἐποιήσαμεν",710582,289],["ὅτι",709803,7],["προέφθακεν",711011,171],["ἡμᾶς",705981,194],["Ἀλέξανδρος",700652,4],["τοῦ",709436,35],["φιλίαν",713474,9],["καταλαβέσθαι",707300,109],["τοῖς",709436,147],["Ιουδαίοις",706772,148],["εἰς",704105,0],["στήριγμα",712097,25]],"What have we done, that Alexander hath prevented us in making amity with the Jews to strengthen himself?"],["24",[["γράψω",703194,165],["αὐτοῖς",702165,151],["κἀγὼ",706969,288],["λόγους",708236,57],["παρακλήσεως",710047,17],["καὶ",707031,7],["ὕψους",713288,21],["καὶ",707031,7],["δομάτων",703789,44],["ὅπως",709719,7],["ὦσιν",709852,96],["σὺν",712372,0],["ἐμοὶ",704577,159],["εἰς",704105,0],["βοήθειαν",702745,9]],"I also will write unto them words of encouragement, [and promise them] dignities and gifts, that I may have their aid."],["25",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["αὐτοῖς",702165,151],["κατὰ",707200,0],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["βασιλεὺς",702580,4],["Δημήτριος",703407,4],["τῷ",709436,53],["ἔθνει",704068,54],["τῶν",709436,80],["Ιουδαίων",706772,81],["χαίρειν",713665,55]],"He sent unto them therefore to this effect: King Demetrius unto the people of the Jews sendeth greeting:"],["26",[["ἐπεὶ",705054,7],["συνετηρήσατε",712512,265],["τὰς",709436,38],["πρὸς",710844,0],["ἡμᾶς",705981,194],["συνθήκας",712477,39],["καὶ",707031,7],["ἐνεμείνατε",704570,265],["τῇ",709436,100],["φιλίᾳ",713474,1],["ἡμῶν",705999,145],["καὶ",707031,7],["οὐ",709805,28],["προσεχωρήσατε",710983,265],["τοῖς",709436,147],["ἐχθροῖς",705779,230],["ἡμῶν",705999,145],["ἠκούσαμεν",700587,289],["καὶ",707031,7],["ἐχάρημεν",713665,485]],"Whereas ye have kept covenants with us, and continued in our friendship, not joining yourselves with our enemies, we have heard hereof, and are glad."],["27",[["καὶ",707031,7],["νῦν",709384,28],["ἐμμείνατε",704570,74],["ἔτι",705538,28],["τοῦ",709436,20],["συντηρῆσαι",712512,106],["πρὸς",710844,0],["ἡμᾶς",705981,194],["πίστιν",710484,9],["καὶ",707031,7],["ἀνταποδώσομεν",701215,275],["ὑμῖν",713084,90],["ἀγαθὰ",700106,68],["ἀνθ᾿",701227,0],["ὧν",709781,252],["ποιεῖτε",710582,87],["μεθ᾿",708780,0],["ἡμῶν",705999,145]],"Wherefore now continue ye still to be faithful unto us, and we will well recompense you for the things ye do in our behalf,"],["28",[["καὶ",707031,7],["ἀφήσομεν",702211,275],["ὑμῖν",713084,90],["ἀφέματα",702195,42],["πολλὰ",710646,68],["καὶ",707031,7],["δώσομεν",703654,275],["ὑμῖν",713084,90],["δόματα",703789,42]],"and will grant you many immunities, and give you rewards."],["29",[["καὶ",707031,7],["νῦν",709384,28],["ἀπολύω",701524,157],["ὑμᾶς",713080,194],["καὶ",707031,7],["ἀφίημι",702211,157],["πάντας",710177,60],["τοὺς",709436,58],["Ιουδαίους",706772,57],["ἀπὸ",701425,0],["τῶν",709436,130],["φόρων",713561,81],["καὶ",707031,7],["τῆς",709436,16],["τιμῆς",712856,17],["τοῦ",709436,35],["ἁλὸς",700728,18],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,80],["στεφάνων",712083,81]],"And now do I free you, and [for your sake] I release all the Jews, from tributes, and from the customs of salt, and from crown taxes,"],["30",[["καὶ",707031,7],["ἀντὶ",701227,0],["τοῦ",709436,35],["τρίτου",712968,116],["τῆς",709436,16],["σπορᾶς",712027,17],["καὶ",707031,7],["ἀντὶ",701227,0],["τοῦ",709436,35],["ἡμίσους",705998,116],["τοῦ",709436,35],["καρποῦ",707169,18],["τοῦ",709436,35],["ξυλίνου",709425,116],["τοῦ",709436,35],["ἐπιβάλλοντός",705083,152],["μοι",708974,159],["λαβεῖν",708076,106],["ἀφίημι",702211,157],["ἀπὸ",701425,0],["τῆς",709436,16],["σήμερον",711751,28],["καὶ",707031,7],["ἐπέκεινα",705062,28],["τοῦ",709436,20],["λαβεῖν",708076,106],["ἀπὸ",701425,0],["γῆς",703083,17],["Ιουδα",706768,18],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,130],["τριῶν",712927,198],["νομῶν",709337,65],["τῶν",709436,130],["προστιθεμένων",710965,522],["αὐτῇ",702165,105],["ἀπὸ",701425,0],["τῆς",709436,16],["Σαμαρίτιδος",711451,17],["καὶ",707031,7],["Γαλιλαίας",702940,17],["ἀπὸ",701425,0],["τῆς",709436,16],["σήμερον",711751,28],["ἡμέρας",705984,17],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["ἅπαντα",701362,27],["χρόνον",713969,6]],"and from that which appertaineth unto me to receive for the third part of the seed, and the half of the fruit of the trees, I release it from this day forth, so that they shall not be taken of the land of Juda, nor of the three governments which are added thereunto out of the country of Samaria and Galilee, from this day forth for evermore."],["31",[["καὶ",707031,7],["Ιερουσαλημ",706644,12],["ἔστω",704093,31],["ἁγία",700159,29],["καὶ",707031,7],["ἀφειμένη",702211,203],["καὶ",707031,7],["τὰ",709436,63],["ὅρια",709749,64],["αὐτῆς",702165,86],["αἱ",709436,190],["δεκάται",703343,192],["καὶ",707031,7],["τὰ",709436,63],["τέλη",712787,64]],"Let Jerusalem also be holy and free, with the borders thereof, both from tenths and tributes."],["32",[["ἀφίημι",702211,157],["καὶ",707031,28],["τὴν",709436,8],["ἐξουσίαν",704974,9],["τῆς",709436,16],["ἄκρας",700588,17],["τῆς",709436,16],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["δίδωμι",703654,157],["τῷ",709436,113],["ἀρχιερεῖ",701845,114],["ὅπως",709719,7],["ἂν",700900,11],["καταστήσῃ",707011,172],["ἐν",704639,0],["αὐτῇ",702165,105],["ἄνδρας",701150,57],["οὓς",709781,298],["ἂν",700900,11],["αὐτὸς",702165,121],["ἐκλέξηται",704236,239],["τοῦ",709436,20],["φυλάσσειν",713619,55],["αὐτήν",702165,104]],"And as for the tower which is at Jerusalem, I yield up my authority over it, and give it to the high priest, that he may set in it such men as he shall choose to keep it."],["33",[["καὶ",707031,7],["πᾶσαν",710177,36],["ψυχὴν",714070,9],["Ιουδαίων",706772,81],["τὴν",709436,8],["αἰχμαλωτισθεῖσαν",700501,406],["ἀπὸ",701425,0],["γῆς",703083,17],["Ιουδα",706768,18],["εἰς",704105,0],["πᾶσαν",710177,36],["βασιλείαν",702577,9],["μου",709032,133],["ἀφίημι",702211,157],["ἐλευθέραν",704428,36],["δωρεάν",703901,9],["καὶ",707031,7],["πάντες",710177,138],["ἀφιέτωσαν",702211,264],["τοὺς",709436,58],["φόρους",713561,57],["καὶ",707031,7],["τῶν",709436,43],["κτηνῶν",707934,44],["αὐτῶν",702165,40]],"Moreover I freely set at liberty every one of the Jews, that were carried captives out of the land of Juda into any part of my kingdom, and [I will] that all my officers remit the tributes even of their cattle."],["34",[["καὶ",707031,7],["πᾶσαι",710177,192],["αἱ",709436,190],["ἑορταὶ",704990,191],["καὶ",707031,7],["τὰ",709436,63],["σάββατα",711350,64],["καὶ",707031,7],["νουμηνίαι",709371,191],["καὶ",707031,7],["ἡμέραι",705984,191],["ἀποδεδειγμέναι",701438,423],["καὶ",707031,7],["τρεῖς",712927,192],["ἡμέραι",705984,191],["πρὸ",710747,0],["ἑορτῆς",704990,17],["καὶ",707031,7],["τρεῖς",712927,192],["μετὰ",708780,0],["ἑορτὴν",704990,9],["ἔστωσαν",704093,56],["πᾶσαι",710177,192],["ἡμέραι",705984,191],["ἀτελείας",702082,17],["καὶ",707031,7],["ἀφέσεως",702199,17],["πᾶσιν",710177,230],["τοῖς",709436,147],["Ιουδαίοις",706772,148],["τοῖς",709436,147],["οὖσιν",704093,349],["ἐν",704639,0],["τῇ",709436,100],["βασιλείᾳ",702577,1],["μου",709032,133]],"Furthermore [I will] that all the feasts, and sabbaths, and new moons, and solemn days, and the three days before the feast, and the three days after the feast, shall be all days of immunity and freedom for all the Jews in my realm."],["35",[["καὶ",707031,7],["οὐχ",709805,28],["ἕξει",705785,127],["ἐξουσίαν",704974,9],["οὐδεὶς",709817,14],["πράσσειν",710721,55],["καὶ",707031,7],["παρενοχλεῖν",710135,55],["τινα",712866,356],["αὐτῶν",702165,40],["περὶ",710285,0],["παντὸς",710177,92],["πράγματος",710708,21]],"Also no man shall have authority to meddle [with them], or to molest any of them in any matter."],["36",[["καὶ",707031,7],["προγραφήτωσαν",710778,51],["τῶν",709436,80],["Ιουδαίων",706772,81],["εἰς",704105,0],["τὰς",709436,38],["δυνάμεις",703839,39],["τοῦ",709436,35],["βασιλέως",702580,18],["εἰς",704105,0],["τριάκοντα",712934,59],["χιλιάδας",713858,39],["ἀνδρῶν",701150,81],["καὶ",707031,7],["δοθήσεται",703654,134],["αὐτοῖς",702165,151],["ξένια",709410,42],["ὡς",714148,7],["καθήκει",706998,91],["πάσαις",710177,291],["ταῖς",709436,75],["δυνάμεσιν",703839,76],["τοῦ",709436,35],["βασιλέως",702580,18]],"[I will] further, that there be enrolled among the king's forces about thirty thousand men of the Jews, unto whom pay shall be given, as belongeth to all the king's forces."],["37",[["καὶ",707031,7],["κατασταθήσεται",707011,134],["ἐξ",704132,0],["αὐτῶν",702165,40],["ἐν",704639,0],["τοῖς",709436,95],["ὀχυρώμασιν",709891,96],["τοῦ",709436,35],["βασιλέως",702580,18],["τοῖς",709436,147],["μεγάλοις",708653,230],["καὶ",707031,7],["ἐκ",704132,0],["τούτων",709858,40],["κατασταθήσονται",707011,144],["ἐπὶ",705080,0],["χρειῶν",713938,65],["τῆς",709436,16],["βασιλείας",702577,17],["τῶν",709436,130],["οὐσῶν",704093,66],["εἰς",704105,0],["πίστιν",710484,9],["καὶ",707031,7],["οἱ",709436,136],["ἐπ᾿",705080,0],["αὐτῶν",702165,40],["καὶ",707031,7],["οἱ",709436,136],["ἄρχοντες",701862,52],["ἔστωσαν",704093,56],["ἐξ",704132,0],["αὐτῶν",702165,40],["καὶ",707031,7],["πορευέσθωσαν",710667,77],["τοῖς",709436,147],["νόμοις",709349,148],["αὐτῶν",702165,40],["καθὰ",706979,69],["καὶ",707031,7],["προσέταξεν",710962,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐν",704639,0],["γῇ",703083,1],["Ιουδα",706768,18]],"And of them [some] shall be placed in the king's strong holds, of whom also [some] shall be set over the affairs of the kingdom, which are of trust: and [I will] that their overseers and governors be of themselves, and that they live after their own laws, even as the king hath commanded in the land of Judea."],["38",[["καὶ",707031,7],["τοὺς",709436,58],["τρεῖς",712927,60],["νομοὺς",709349,57],["τοὺς",709436,58],["προστεθέντας",710965,460],["τῇ",709436,100],["Ιουδαίᾳ",706769,1],["ἀπὸ",701425,0],["τῆς",709436,16],["χώρας",714011,17],["Σαμαρείας",711449,17],["προστεθήτω",710965,22],["τῇ",709436,100],["Ιουδαίᾳ",706769,1],["πρὸς",710844,0],["τὸ",709436,24],["λογισθῆναι",708232,179],["τοῦ",709436,20],["γενέσθαι",703104,109],["ὑφ᾿",713184,0],["ἕνα",704106,27],["τοῦ",709436,20],["μὴ",708851,28],["ὑπακοῦσαι",713096,106],["ἄλλης",700697,86],["ἐξουσίας",704974,17],["ἀλλ᾿",700680,7],["ἢ",705924,7],["τοῦ",709436,35],["ἀρχιερέως",701845,18]],"And concerning the three governments that are added to Judea from the country of Samaria, let them be joined with Judea, that they may be reckoned to be under one, nor bound to obey other authority than the high priest's."],["39",[["Πτολεμαίδα",711066,9],["καὶ",707031,7],["τὴν",709436,8],["προσκυροῦσαν",710928,78],["αὐτῇ",702165,105],["δέδωκα",703654,89],["δόμα",703789,25],["τοῖς",709436,147],["ἁγίοις",700159,230],["τοῖς",709436,147],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["εἰς",704105,0],["τὴν",709436,8],["καθήκουσαν",706998,78],["δαπάνην",703287,9],["τοῖς",709436,147],["ἁγίοις",700159,230]],"[As for] Ptolemais, and the land pertaining thereto, I give [it] as a free gift to the sanctuary at Jerusalem for the necessary expences of the sanctuary."],["40",[["κἀγὼ",706969,288],["δίδωμι",703654,157],["κατ᾿",707200,0],["ἐνιαυτὸν",704745,6],["δέκα",703333,59],["πέντε",710266,59],["χιλιάδας",713858,39],["σίκλων",711786,81],["ἀργυρίου",701707,21],["ἀπὸ",701425,0],["τῶν",709436,80],["λόγων",708236,81],["τοῦ",709436,35],["βασιλέως",702580,18],["ἀπὸ",701425,0],["τῶν",709436,80],["τόπων",712903,81],["τῶν",709436,80],["ἀνηκόντων",701145,170]],"Moreover I give every year fifteen thousand shekels of silver out of the king's accounts from the places appertaining."],["41",[["καὶ",707031,7],["πᾶν",710177,46],["τὸ",709436,24],["πλεονάζον",710516,47],["ὃ",709781,128],["οὐκ",709805,28],["ἀπεδίδοσαν",701449,137],["ἀπὸ",701425,0],["τῶν",709436,130],["χρειῶν",713938,65],["ὡς",714148,7],["ἐν",704639,0],["τοῖς",709436,95],["πρώτοις",711041,509],["ἔτεσιν",705543,96],["ἀπὸ",701425,0],["τοῦ",709436,35],["νῦν",709384,28],["δώσουσιν",703654,218],["εἰς",704105,0],["τὰ",709436,41],["ἔργα",705396,42],["τοῦ",709436,35],["οἴκου",709516,18]],"And all the overplus, which the officers paid not in as in former time, from henceforth shall be given toward the works of the temple."],["42",[["καὶ",707031,7],["ἐπὶ",705080,0],["τούτοις",709858,151],["πεντακισχιλίους",710260,60],["σίκλους",711786,57],["ἀργυρίου",701707,21],["οὓς",709781,298],["ἐλάμβανον",708076,137],["ἀπὸ",701425,0],["τῶν",709436,130],["χρειῶν",713938,65],["τοῦ",709436,35],["ἁγίου",700159,116],["ἀπὸ",701425,0],["τοῦ",709436,35],["λόγου",708236,18],["κατ᾿",707200,0],["ἐνιαυτόν",704745,6],["καὶ",707031,7],["ταῦτα",709858,71],["ἀφίεται",702211,391],["διὰ",703417,0],["τὸ",709436,24],["ἀνήκειν",701145,55],["αὐτὰ",702165,71],["τοῖς",709436,147],["ἱερεῦσιν",706614,148],["τοῖς",709436,147],["λειτουργοῦσιν",708132,197]],"And beside this, the five thousand shekels of silver, which they took from the uses of the temple out of the accounts year by year, even those things shall be released, because they appertain to the priests that minister."],["43",[["καὶ",707031,7],["ὅσοι",709788,138],["ἐὰν",703912,7],["φύγωσιν",713433,234],["εἰς",704105,0],["τὸ",709436,24],["ἱερὸν",706631,25],["τὸ",709436,24],["ἐν",704639,0],["Ιεροσολύμοις",706634,285],["καὶ",707031,7],["ἐν",704639,0],["πᾶσιν",710177,94],["τοῖς",709436,95],["ὁρίοις",709749,96],["αὐτοῦ",702165,102],["ὀφείλων",709865,72],["βασιλικὰ",702582,68],["καὶ",707031,7],["πᾶν",710177,26],["πρᾶγμα",710708,15],["ἀπολελύσθωσαν",701524,669],["καὶ",707031,7],["πάντα",710177,195],["ὅσα",709788,195],["ἐστὶν",704093,91],["αὐτοῖς",702165,151],["ἐν",704639,0],["τῇ",709436,100],["βασιλείᾳ",702577,1],["μου",709032,133]],"And whosoever they be that flee unto the temple at Jerusalem, or be within the liberties thereof, being indebted unto the king, or for any other matter, let them be at liberty, and all that they have in my realm."],["44",[["καὶ",707031,7],["τοῦ",709436,20],["οἰκοδομηθῆναι",709509,179],["καὶ",707031,7],["ἐπικαινισθῆναι",705151,179],["τὰ",709436,41],["ἔργα",705396,42],["τῶν",709436,80],["ἁγίων",700159,169],["καὶ",707031,7],["ἡ",709436,10],["δαπάνη",703287,12],["δοθήσεται",703654,134],["ἐκ",704132,0],["τοῦ",709436,35],["λόγου",708236,18],["τοῦ",709436,35],["βασιλέως",702580,18]],"For the building also and repairing of the works of the sanctuary, expences shall be given out of the king's accounts."],["45",[["καὶ",707031,7],["τοῦ",709436,20],["οἰκοδομηθῆναι",709509,179],["τὰ",709436,41],["τείχη",712759,42],["Ιερουσαλημ",706644,17],["καὶ",707031,7],["ὀχυρῶσαι",709890,106],["κυκλόθεν",707956,28],["καὶ",707031,7],["ἡ",709436,10],["δαπάνη",703287,12],["δοθήσεται",703654,134],["ἐκ",704132,0],["τοῦ",709436,35],["λόγου",708236,18],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["τοῦ",709436,20],["οἰκοδομηθῆναι",709509,179],["τὰ",709436,41],["τείχη",712759,42],["ἐν",704639,0],["τῇ",709436,100],["Ιουδαίᾳ",706769,1]],"Yea, and for the building of the walls of Jerusalem, and the fortifying thereof round about, expences shall be given out of the king's accounts, as also for the building of the walls in Judea."],["46",[["ὡς",714148,7],["δὲ",703303,11],["ἤκουσεν",700587,2],["Ιωναθαν",706927,4],["καὶ",707031,7],["ὁ",709436,3],["λαὸς",708094,4],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["οὐκ",709805,28],["ἐπίστευσαν",710483,150],["αὐτοῖς",702165,151],["οὐδὲ",709816,7],["ἐπεδέξαντο",705117,189],["ὅτι",709803,7],["ἐπεμνήσθησαν",705205,99],["τῆς",709436,16],["κακίας",707054,17],["τῆς",709436,16],["μεγάλης",708653,82],["ἧς",709781,167],["ἐποίησεν",710582,2],["ἐν",704639,0],["Ισραηλ",706839,111],["καὶ",707031,7],["ἔθλιψεν",706274,2],["αὐτοὺς",702165,62],["σφόδρα",712586,28]],"Now when Jonathan and the people heard these words, they gave no credit unto them, nor received them, because they remembered the great evil that he had done in Israel; for he had afflicted them very sore."],["47",[["καὶ",707031,7],["εὐδόκησαν",705565,150],["ἐν",704639,0],["Ἀλεξάνδρῳ",700652,114],["ὅτι",709803,7],["αὐτὸς",702165,121],["ἐγένετο",703104,23],["αὐτοῖς",702165,151],["ἀρχηγὸς",701838,4],["λόγων",708236,81],["εἰρηνικῶν",704099,169],["καὶ",707031,7],["συνεμάχουν",712298,137],["αὐτῷ",702165,50],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39]],"But with Alexander they were well pleased, because he was the first that entreated of true peace with them, and they were confederate with him always."],["48",[["καὶ",707031,7],["συνήγαγεν",712375,2],["Ἀλέξανδρος",700652,4],["ὁ",709436,3],["βασιλεὺς",702580,4],["δυνάμεις",703839,39],["μεγάλας",708653,119],["καὶ",707031,7],["παρενέβαλεν",710132,2],["ἐξ",704132,0],["ἐναντίας",704656,82],["Δημητρίου",703407,18]],"Then gathered king Alexander great forces, and camped over against Demetrius."],["49",[["καὶ",707031,7],["συνῆψαν",712404,150],["πόλεμον",710605,6],["οἱ",709436,136],["δύο",703849,59],["βασιλεῖς",702580,52],["καὶ",707031,7],["ἔφυγεν",713433,2],["ἡ",709436,10],["παρεμβολὴ",710133,12],["Δημητρίου",703407,18],["καὶ",707031,7],["ἐδίωξεν",703768,2],["αὐτὸν",702165,85],["ὁ",709436,3],["Ἀλέξανδρος",700652,4],["καὶ",707031,7],["ἴσχυσεν",706859,2],["ἐπ᾿",705080,0],["αὐτούς",702165,62]],"And after the two kings had joined battle, Demetrius' host fled: but Alexander followed after him, and prevailed against them."],["50",[["καὶ",707031,7],["ἐστερέωσεν",712076,2],["τὸν",709436,5],["πόλεμον",710605,6],["σφόδρα",712586,28],["ἕως",705792,7],["ἔδυ",703848,2],["ὁ",709436,3],["ἥλιος",705974,4],["καὶ",707031,7],["ἔπεσεν",710481,2],["ὁ",709436,3],["Δημήτριος",703407,4],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105]],"And he continued the battle very sore until the sun went down: and that day was Demetrius slain."],["51",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Ἀλέξανδρος",700652,4],["πρὸς",710844,0],["Πτολεμαῖον",711066,6],["βασιλέα",702580,6],["Αἰγύπτου",700401,17],["πρέσβεις",710733,52],["κατὰ",707200,0],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["λέγων",708124,72]],"Afterward Alexander sent ambassadors to Ptolemee king of Egypt with a message to this effect:"],["52",[["ἐπεὶ",705054,7],["ἀνέστρεψα",701060,155],["εἰς",704105,0],["τὴν",709436,8],["βασιλείαν",702577,9],["μου",709032,133],["καὶ",707031,7],["ἐνεκάθισα",703953,155],["ἐπὶ",705080,0],["θρόνου",706315,18],["πατέρων",710189,81],["μου",709032,133],["καὶ",707031,7],["ἐκράτησα",707879,155],["τῆς",709436,16],["ἀρχῆς",701836,17],["καὶ",707031,7],["συνέτριψα",712520,155],["τὸν",709436,5],["Δημήτριον",703407,6],["καὶ",707031,7],["ἐπεκράτησα",705176,155],["τῆς",709436,16],["χώρας",714011,17],["ἡμῶν",705999,145]],"Forasmuch as I am come again to my realm, and am set in the throne of my progenitors, and have gotten the dominion, and overthrown Demetrius, and recovered our country;"],["53",[["καὶ",707031,7],["συνῆψα",712404,155],["πρὸς",710844,0],["αὐτὸν",702165,85],["μάχην",708601,9],["καὶ",707031,7],["συνετρίβη",712520,37],["αὐτὸς",702165,121],["καὶ",707031,7],["ἡ",709436,10],["παρεμβολὴ",710133,12],["αὐτοῦ",702165,102],["ὑφ᾿",713184,0],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐκαθίσαμεν",707006,289],["ἐπὶ",705080,0],["θρόνου",706315,18],["βασιλείας",702577,17],["αὐτοῦ",702165,102]],"for after I had joined battle with him, both he and his host was discomfited by us, so that we sit in the throne of his kingdom:"],["54",[["καὶ",707031,7],["νῦν",709384,28],["στήσωμεν",706846,79],["πρὸς",710844,0],["αὑτοὺς",703917,62],["φιλίαν",713474,9],["καὶ",707031,7],["νῦν",709384,28],["δός",703654,176],["μοι",708974,159],["τὴν",709436,8],["θυγατέρα",706320,9],["σου",711945,133],["εἰς",704105,0],["γυναῖκα",703209,9],["καὶ",707031,7],["ἐπιγαμβρεύσω",705099,165],["σοι",711925,159],["καὶ",707031,7],["δώσω",703654,165],["σοι",711925,159],["δόματα",703789,42],["καὶ",707031,7],["αὐτῇ",702165,105],["ἄξιά",701308,29],["σου",711945,133]],"now therefore let us make a league of amity together, and give me now thy daughter to wife: and I will be thy son in law, and will give both thee and her gifts according to thy dignity."],["55",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["Πτολεμαῖος",711066,4],["ὁ",709436,3],["βασιλεὺς",702580,4],["λέγων",708124,72],["ἀγαθὴ",700106,29],["ἡμέρα",705984,12],["ἐν",704639,0],["ᾗ",709781,108],["ἐπέστρεψας",705278,162],["εἰς",704105,0],["γῆν",703083,9],["πατέρων",710189,81],["σου",711945,133],["καὶ",707031,7],["ἐκάθισας",707006,162],["ἐπὶ",705080,0],["θρόνου",706315,18],["βασιλείας",702577,17],["αὐτῶν",702165,40]],"Then Ptolemee the king gave answer, saying, Happy be the day wherein thou didst return into the land of thy fathers, and satest in the throne of their kingdom."],["56",[["καὶ",707031,7],["νῦν",709384,28],["ποιήσω",710582,165],["σοι",711925,159],["ἃ",709781,69],["ἔγραψας",703194,162],["ἀλλὰ",700680,7],["ἀπάντησον",701345,176],["εἰς",704105,0],["Πτολεμαίδα",711066,9],["ὅπως",709719,7],["ἴδωμεν",709725,79],["ἀλλήλους",700689,62],["καὶ",707031,7],["ἐπιγαμβρεύσω",705099,165],["σοι",711925,159],["καθὼς",707030,28],["εἴρηκας",705415,266]],"And now will I do to thee, as thou hast written: meet me therefore at Ptolemais, that we may see one another; for I will marry my daughter to thee according to thy desire."],["57",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["Πτολεμαῖος",711066,4],["ἐξ",704132,0],["Αἰγύπτου",700401,17],["αὐτὸς",702165,121],["καὶ",707031,7],["Κλεοπάτρα",707712,12],["ἡ",709436,10],["θυγάτηρ",706320,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἦλθεν",705453,2],["εἰς",704105,0],["Πτολεμαίδα",711066,9],["ἔτους",705543,21],["δευτέρου",703389,92],["καὶ",707031,7],["ἑξηκοστοῦ",704924,92],["καὶ",707031,7],["ἑκατοστοῦ",704143,92]],"So Ptolemee went out of Egypt with his daughter Cleopatra, and they came unto Ptolemais in the hundred threescore and second year:"],["58",[["καὶ",707031,7],["ἀπήντησεν",701345,2],["αὐτῷ",702165,50],["Ἀλέξανδρος",700652,4],["ὁ",709436,3],["βασιλεύς",702580,4],["καὶ",707031,7],["ἐξέδετο",704171,23],["αὐτῷ",702165,50],["Κλεοπάτραν",707712,9],["τὴν",709436,8],["θυγατέρα",706320,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐποίησεν",710582,2],["τὸν",709436,5],["γάμον",702957,6],["αὐτῆς",702165,86],["ἐν",704639,0],["Πτολεμαίδι",711066,1],["καθὼς",707030,28],["οἱ",709436,136],["βασιλεῖς",702580,52],["ἐν",704639,0],["δόξῃ",703791,1],["μεγάλῃ",708653,101]],"where king Alexander meeting him, he gave unto him his daughter Cleopatra, and celebrated her marriage at Ptolemais with great glory, as the manner of kings is."],["59",[["καὶ",707031,7],["ἔγραψεν",703194,2],["Ἀλέξανδρος",700652,4],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ιωναθη",706927,114],["ἐλθεῖν",705453,106],["εἰς",704105,0],["συνάντησιν",712397,9],["αὐτῷ",702165,50]],"Now king Alexander had written unto Jonathan, that he should come and meet him."],["60",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["μετὰ",708780,0],["δόξης",703791,17],["εἰς",704105,0],["Πτολεμαίδα",711066,9],["καὶ",707031,7],["ἀπήντησεν",701345,2],["τοῖς",709436,147],["δυσὶν",703849,405],["βασιλεῦσι",702580,148],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτοῖς",702165,151],["ἀργύριον",701707,25],["καὶ",707031,7],["χρυσίον",713972,25],["καὶ",707031,7],["τοῖς",709436,147],["φίλοις",713492,230],["αὐτῶν",702165,40],["καὶ",707031,7],["δόματα",703789,42],["πολλὰ",710646,68],["καὶ",707031,7],["εὗρεν",705676,2],["χάριν",713735,9],["ἐνώπιον",704823,0],["αὐτῶν",702165,40]],"Who thereupon went honourably to Ptolemais, where he met the two kings, and gave them and their friends silver and gold, and many presents, and found favour in their sight."],["61",[["καὶ",707031,7],["ἐπισυνήχθησαν",705280,99],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["ἄνδρες",701150,52],["λοιμοὶ",708245,138],["ἐξ",704132,0],["Ισραηλ",706839,18],["ἄνδρες",701150,52],["παράνομοι",710080,138],["ἐντυχεῖν",704812,106],["κατ᾿",707200,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐ",709805,28],["προσέσχεν",710895,2],["αὐτοῖς",702165,151],["ὁ",709436,3],["βασιλεύς",702580,4]],"At that time certain pestilent fellows of Israel, men of a wicked life, assembled themselves against him, to accuse him: but the king would not hear them."],["62",[["καὶ",707031,7],["προσέταξεν",710962,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["ἐξέδυσαν",704180,150],["Ιωναθαν",706927,6],["τὰ",709436,41],["ἱμάτια",706742,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐνέδυσαν",704701,150],["αὐτὸν",702165,85],["πορφύραν",710682,9],["καὶ",707031,7],["ἐποίησαν",710582,150],["οὕτως",709859,28]],"Yea more than that, the king commanded to take off his garments, and clothe him in purple: and they did so."],["63",[["καὶ",707031,7],["ἐκάθισεν",707006,2],["αὐτὸν",702165,85],["ὁ",709436,3],["βασιλεὺς",702580,4],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["τοῖς",709436,147],["ἄρχουσιν",701862,148],["αὐτοῦ",702165,102],["ἐξέλθατε",704909,74],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["εἰς",704105,0],["μέσον",708768,27],["τῆς",709436,16],["πόλεως",710612,17],["καὶ",707031,7],["κηρύξατε",707662,74],["τοῦ",709436,20],["μηδένα",708857,27],["ἐντυγχάνειν",704812,55],["κατ᾿",707200,0],["αὐτοῦ",702165,102],["περὶ",710285,0],["μηδενὸς",708857,92],["πράγματος",710708,21],["καὶ",707031,7],["μηδεὶς",708857,14],["αὐτῷ",702165,50],["παρενοχλείτω",710135,31],["περὶ",710285,0],["παντὸς",710177,116],["λόγου",708236,18]],"Also he made him sit by himself, and said unto his princes, Go with him into the midst of the city, and make proclamation, that no man complain against him of any matter, and that no man trouble him for any manner of cause."],["64",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὡς",714148,7],["εἶδον",709725,150],["οἱ",709436,136],["ἐντυγχάνοντες",704812,146],["τὴν",709436,8],["δόξαν",703791,9],["αὐτοῦ",702165,102],["καθὼς",707030,28],["ἐκήρυξεν",707662,2],["καὶ",707031,7],["περιβεβλημένον",710294,439],["αὐτὸν",702165,85],["πορφύραν",710682,9],["καὶ",707031,7],["ἔφυγον",713433,150],["πάντες",710177,138]],"Now when his accusers saw that he was honoured according to the proclamation, and clothed in purple, they fled all away."],["65",[["καὶ",707031,7],["ἐδόξασεν",703792,2],["αὐτὸν",702165,85],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["ἔγραψεν",703194,2],["αὐτὸν",702165,85],["τῶν",709436,80],["πρώτων",711041,616],["φίλων",713492,169],["καὶ",707031,7],["ἔθετο",712849,23],["αὐτὸν",702165,85],["στρατηγὸν",712144,6],["καὶ",707031,7],["μεριδάρχην",708742,9]],"So the king honoured him, and wrote him among his chief friends, and made him a duke, and partaker of his dominion."],["66",[["καὶ",707031,7],["ἐπέστρεψεν",705278,2],["Ιωναθαν",706927,4],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["μετ᾿",708780,0],["εἰρήνης",704098,17],["καὶ",707031,7],["εὐφροσύνης",705717,17]],"Afterward Jonathan returned to Jerusalem with peace and gladness."],["67",[["καὶ",707031,7],["ἐν",704639,0],["ἔτει",705543,54],["πέμπτῳ",710245,97],["καὶ",707031,7],["ἑξηκοστῷ",704924,97],["καὶ",707031,7],["ἑκατοστῷ",704143,97],["ἦλθεν",705453,2],["Δημήτριος",703407,4],["υἱὸς",713075,4],["Δημητρίου",703407,18],["ἐκ",704132,0],["Κρήτης",707899,17],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["τῶν",709436,80],["πατέρων",710189,81],["αὐτοῦ",702165,102]],"Furthermore in the hundred threescore and fifth year came Demetrius son of Demetrius out of Crete into the land of his fathers:"],["68",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Ἀλέξανδρος",700652,4],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["ἐλυπήθη",708272,37],["σφόδρα",712586,28],["καὶ",707031,7],["ὑπέστρεψεν",713246,2],["εἰς",704105,0],["Ἀντιόχειαν",701252,9]],"whereof when king Alexander heard tell, he was right sorry, and returned into Antioch."],["69",[["καὶ",707031,7],["κατέστησεν",707011,2],["Δημήτριος",703407,4],["Ἀπολλώνιον",701515,6],["τὸν",709436,5],["ὄντα",704093,183],["ἐπὶ",705080,0],["Κοίλης",707760,17],["Συρίας",712533,17],["καὶ",707031,7],["συνήγαγεν",712375,2],["δύναμιν",703839,9],["μεγάλην",708653,36],["καὶ",707031,7],["παρενέβαλεν",710132,2],["ἐπὶ",705080,0],["Ιάμνειαν",706412,9],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["πρὸς",710844,0],["Ιωναθαν",706927,6],["τὸν",709436,5],["ἀρχιερέα",701845,6],["λέγων",708124,72]],"Then Demetrius made Apollonius the governor of Celosyria his general, who gathered together a great host, and camped in Jamnia, and sent unto Jonathan the high priest, saying,"],["70",[["σὺ",712181,164],["μονώτατος",709003,140],["ἐπαίρῃ",705002,204],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["ἐγὼ",704018,164],["δὲ",703303,11],["ἐγενήθην",703104,156],["εἰς",704105,0],["καταγέλωτα",707223,6],["καὶ",707031,7],["εἰς",704105,0],["ὀνειδισμὸν",709657,6],["διὰ",703417,0],["σέ",711598,163],["καὶ",707031,7],["διὰ",703417,0],["τί",712867,126],["σὺ",712181,164],["ἐξουσιάζῃ",704975,259],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["ἐν",704639,0],["τοῖς",709436,95],["ὄρεσι",709768,96]],"Thou alone liftest up thyself against us, and I am laughed to scorn for thy sake, and reproached: and why dost thou vaunt thy power against us in the mountains?"],["71",[["νῦν",709384,28],["οὖν",709835,11],["εἰ",704071,7],["πέποιθας",710221,266],["ἐπὶ",705080,0],["ταῖς",709436,75],["δυνάμεσίν",703839,76],["σου",711945,133],["κατάβηθι",707202,176],["πρὸς",710844,0],["ἡμᾶς",705981,194],["εἰς",704105,0],["τὸ",709436,24],["πεδίον",710215,25],["καὶ",707031,7],["συγκριθῶμεν",712233,283],["ἑαυτοῖς",703917,151],["ἐκεῖ",704181,28],["ὅτι",709803,7],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["ἐστιν",704093,91],["δύναμις",703839,12],["τῶν",709436,130],["πόλεων",710612,65]],"Now therefore, if thou trustest in thine own strength, come down to us into the plain field, and there let us try the matter together: for with me is the power of the cities."],["72",[["ἐρώτησον",705459,176],["καὶ",707031,7],["μάθε",708480,176],["τίς",712867,158],["εἰμι",704093,157],["καὶ",707031,7],["οἱ",709436,136],["λοιποὶ",708248,138],["οἱ",709436,136],["βοηθοῦντες",702746,146],["ἡμῖν",705994,90],["καὶ",707031,7],["λέγουσιν",708124,197],["οὐκ",709805,28],["ἔστιν",704093,91],["ὑμῖν",713084,90],["στάσις",712049,12],["ποδὸς",710707,18],["κατὰ",707200,0],["πρόσωπον",710986,25],["ἡμῶν",705999,145],["ὅτι",709803,7],["δὶς",703741,28],["ἐτροπώθησαν",712981,99],["οἱ",709436,136],["πατέρες",710189,52],["σου",711945,133],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["αὐτῶν",702165,40]],"Ask and learn who I am, and the rest that take our part, and they shall tell thee that thy foot is not able to stand before our face; for thy fathers have been twice put to flight in their own land."],["73",[["καὶ",707031,7],["νῦν",709384,28],["οὐ",709805,28],["δυνήσῃ",703838,123],["ὑποστῆναι",713281,106],["τὴν",709436,8],["ἵππον",706790,9],["καὶ",707031,7],["δύναμιν",703839,9],["τοιαύτην",712878,36],["ἐν",704639,0],["τῷ",709436,53],["πεδίῳ",710215,54],["ὅπου",709710,28],["οὐκ",709805,28],["ἔστιν",704093,91],["λίθος",708196,4],["οὐδὲ",709816,7],["κόχλαξ",707866,4],["οὐδὲ",709816,7],["τόπος",712903,4],["τοῦ",709436,20],["φυγεῖν",713433,106]],"Wherefore now thou shalt not be able to abide the horsemen and so great a power in the plain, where is neither stone nor flint, nor place to flee unto."],["74",[["ὡς",714148,7],["δὲ",703303,11],["ἤκουσεν",700587,2],["Ιωναθαν",706927,4],["τῶν",709436,80],["λόγων",708236,81],["Ἀπολλωνίου",701515,18],["ἐκινήθη",707679,37],["τῇ",709436,100],["διανοίᾳ",703531,1],["καὶ",707031,7],["ἐπέλεξεν",705188,2],["δέκα",703333,59],["χιλιάδας",713858,39],["ἀνδρῶν",701150,81],["καὶ",707031,7],["ἐξῆλθεν",704909,2],["ἐξ",704132,0],["Ιερουσαλημ",706644,17],["καὶ",707031,7],["συνήντησεν",712394,2],["αὐτῷ",702165,50],["Σιμων",711792,4],["ὁ",709436,3],["ἀδελφὸς",700249,4],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["βοήθειαν",702745,9],["αὐτῷ",702165,50]],"So when Jonathan heard these words of Apollonius, he was moved in his mind, and choosing ten thousand men he went out of Jerusalem, where Simon his brother met him for to help him."],["75",[["καὶ",707031,7],["παρενέβαλεν",710132,2],["ἐπὶ",705080,0],["Ιοππην",706760,9],["καὶ",707031,7],["ἀπέκλεισαν",701484,150],["αὐτὴν",702165,104],["οἱ",709436,136],["ἐκ",704132,0],["τῆς",709436,16],["πόλεως",710612,17],["ὅτι",709803,7],["φρουρὰ",713593,12],["Ἀπολλωνίου",701515,18],["ἐν",704639,0],["Ιοππη",706760,1],["καὶ",707031,7],["ἐπολέμησαν",710601,150],["αὐτήν",702165,104]],"And he pitched his tents against Joppe: but they shut him out of the city, because Apollonius had a garrison in Joppe."],["76",[["καὶ",707031,7],["φοβηθέντες",713532,247],["ἤνοιξαν",701186,150],["οἱ",709436,136],["ἐκ",704132,0],["τῆς",709436,16],["πόλεως",710612,17],["καὶ",707031,7],["ἐκυρίευσεν",707995,2],["Ιωναθαν",706927,4],["Ιοππης",706760,17]],"Then Jonathan laid siege unto it: whereupon they of the city let him in for fear: and so Jonathan won Joppe."],["77",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Ἀπολλώνιος",701515,4],["καὶ",707031,7],["παρενέβαλεν",710132,2],["τρισχιλίαν",712965,36],["ἵππον",706790,9],["καὶ",707031,7],["δύναμιν",703839,9],["πολλὴν",710646,36],["καὶ",707031,7],["ἐπορεύθη",710667,37],["εἰς",704105,0],["Ἄζωτον",700351,9],["ὡς",714148,7],["διοδεύων",703715,72],["καὶ",707031,7],["ἅμα",700745,28],["προῆγεν",710748,13],["εἰς",704105,0],["τὸ",709436,24],["πεδίον",710215,25],["διὰ",703417,0],["τὸ",709436,24],["ἔχειν",705785,55],["αὐτὸν",702165,85],["πλῆθος",710529,25],["ἵππου",706790,17],["καὶ",707031,7],["πεποιθέναι",710221,115],["ἐπ᾿",705080,0],["αὐτῇ",702165,105]],"Whereof when Apollonius heard, he took three thousand horsemen, with a great host [of footmen], and went to Azotus as one that journeyed, and therewithal drew him forth into the plain, because he had a great number of horsemen, in whom he put his trust."],["78",[["καὶ",707031,7],["κατεδίωξεν",707243,2],["ὀπίσω",709697,28],["αὐτοῦ",702165,102],["εἰς",704105,0],["Ἄζωτον",700351,9],["καὶ",707031,7],["συνῆψαν",712404,150],["αἱ",709436,190],["παρεμβολαὶ",710133,191],["εἰς",704105,0],["πόλεμον",710605,6]],"Then Jonathan followed after him to Azotus, where the armies joined battle."],["79",[["καὶ",707031,7],["ἀπέλιπεν",701508,2],["Απολλώνιος",701515,4],["χιλίαν",713861,36],["ἵππον",706790,9],["κρυπτῶς",707924,28],["κατόπισθεν",707544,28],["αὐτῶν",702165,40]],"Now Apollonius had left a thousand horsemen in ambush."],["80",[["καὶ",707031,7],["ἔγνω",703105,2],["Ιωναθαν",706927,4],["ὅτι",709803,7],["ἔστιν",704093,91],["ἔνεδρον",704704,25],["κατόπισθεν",707544,28],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐκύκλωσαν",707958,150],["αὐτοῦ",702165,102],["τὴν",709436,8],["παρεμβολὴν",710133,9],["καὶ",707031,7],["ἐξετίναξαν",704334,150],["τὰς",709436,38],["σχίζας",712603,39],["εἰς",704105,0],["τὸν",709436,5],["λαὸν",708094,6],["ἐκ",704132,0],["πρωίθεν",711022,28],["ἕως",705792,28],["δείλης",703324,82]],"And Jonathan knew that there was an ambushment behind him; for they had compassed in his host, and cast darts at the people, from morning till evening."],["81",[["ὁ",709436,3],["δὲ",703303,11],["λαὸς",708094,4],["εἱστήκει",706846,143],["καθὼς",707030,28],["ἐπέταξεν",705294,2],["Ιωναθαν",706927,4],["καὶ",707031,7],["ἐκοπίασαν",707824,150],["οἱ",709436,136],["ἵπποι",706790,52],["αὐτῶν",702165,40]],"But the people stood still, as Jonathan had commanded them: and so the enemies' horses were tired."],["82",[["καὶ",707031,7],["εἵλκυσεν",704508,2],["Σιμων",711792,4],["τὴν",709436,8],["δύναμιν",703839,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["συνῆψεν",712404,2],["πρὸς",710844,0],["τὴν",709436,8],["φάλαγγα",713320,9],["ἡ",709436,10],["γὰρ",702963,11],["ἵππος",706790,12],["ἐξελύθη",704254,37],["καὶ",707031,7],["συνετρίβησαν",712520,99],["ὑπ᾿",713184,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔφυγον",713433,150]],"Then brought Simon forth his host, and set them against the footmen, (for the horsemen were spent,) who were discomfited by him, and fled."],["83",[["καὶ",707031,7],["ἡ",709436,10],["ἵππος",706790,12],["ἐσκορπίσθη",711881,37],["ἐν",704639,0],["τῷ",709436,53],["πεδίῳ",710215,54],["καὶ",707031,7],["ἔφυγον",713433,150],["εἰς",704105,0],["Ἄζωτον",700351,9],["καὶ",707031,7],["εἰσῆλθον",704114,150],["εἰς",704105,0],["Βηθδαγων",702684,227],["τὸ",709436,24],["εἰδώλιον",704077,25],["αὐτῶν",702165,40],["τοῦ",709436,20],["σωθῆναι",712627,179]],"The horsemen also, being scattered in the field, fled to Azotus, and went into Beth-dagon, their idol's temple, for safety."],["84",[["καὶ",707031,7],["ἐνεπύρισεν",704622,2],["Ιωναθαν",706927,4],["τὴν",709436,8],["Ἄζωτον",700351,9],["καὶ",707031,7],["τὰς",709436,38],["πόλεις",710612,39],["τὰς",709436,38],["κύκλῳ",707959,114],["αὐτῆς",702165,86],["καὶ",707031,7],["ἔλαβεν",708076,2],["τὰ",709436,41],["σκῦλα",711902,42],["αὐτῶν",702165,40],["καὶ",707031,7],["τὸ",709436,24],["ἱερὸν",706631,25],["Δαγων",703240,118],["καὶ",707031,7],["τοὺς",709436,58],["συμφυγόντας",712354,454],["εἰς",704105,0],["αὐτὸ",702165,129],["ἐνεπύρισεν",704622,2],["πυρί",711088,54]],"But Jonathan set fire on Azotus, and the cities round about it, and took their spoils; and the temple of Dagon, with them that were fled into it, he burned with fire."],["85",[["καὶ",707031,7],["ἐγένοντο",703104,189],["οἱ",709436,136],["πεπτωκότες",710481,268],["μαχαίρᾳ",708593,1],["σὺν",712372,0],["τοῖς",709436,147],["ἐμπυρισθεῖσιν",704622,477],["εἰς",704105,0],["ἄνδρας",701150,57],["ὀκτακισχιλίους",709551,60]],"Thus there were burned and slain with the sword well nigh eight thousand men."],["86",[["καὶ",707031,7],["ἀπῆρεν",701329,2],["ἐκεῖθεν",704182,28],["Ιωναθαν",706927,4],["καὶ",707031,7],["παρενέβαλεν",710132,2],["ἐπὶ",705080,0],["Ἀσκαλῶνα",701962,227],["καὶ",707031,7],["ἐξῆλθον",704909,150],["οἱ",709436,136],["ἐκ",704132,0],["τῆς",709436,16],["πόλεως",710612,17],["εἰς",704105,0],["συνάντησιν",712397,9],["αὐτῷ",702165,50],["ἐν",704639,0],["δόξῃ",703791,1],["μεγάλῃ",708653,101]],"And from thence Jonathan removed his host, and camped against Ascalon, where the men of the city came forth, and met him with great pomp."],["87",[["καὶ",707031,7],["ἐπέστρεψεν",705278,2],["Ιωναθαν",706927,4],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["σὺν",712372,0],["τοῖς",709436,147],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["ἔχοντες",705785,146],["σκῦλα",711902,42],["πολλά",710646,68]],"After this returned Jonathan and his host unto Jerusalem, having many spoils."],["88",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὡς",714148,7],["ἤκουσεν",700587,2],["Ἀλέξανδρος",700652,4],["ὁ",709436,3],["βασιλεὺς",702580,4],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["καὶ",707031,7],["προσέθετο",710965,23],["ἔτι",705538,28],["δοξάσαι",703792,106],["τὸν",709436,5],["Ιωναθαν",706927,6]],"Now when king Alexander heard these things, he honoured Jonathan yet more,"],["89",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["αὐτῷ",702165,50],["πόρπην",710679,9],["χρυσῆν",713971,36],["ὡς",714148,7],["ἔθος",704069,25],["ἐστὶν",704093,91],["δίδοσθαι",703654,110],["τοῖς",709436,147],["συγγενέσιν",712185,230],["τῶν",709436,80],["βασιλέων",702580,81],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["τὴν",709436,8],["Ακκαρων",700549,9],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["ὅρια",709749,42],["αὐτῆς",702165,86],["εἰς",704105,0],["κληροδοσίαν",707722,9]],"and sent him a buckle of gold, as the use is to be given to such as are of the king's blood: he gave him also Accaron with the borders thereof in possession."]]