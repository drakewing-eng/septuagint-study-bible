[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὅτε",709802,28],["ἤκουσαν",700587,150],["τὰ",709436,63],["ἔθνη",704068,64],["κυκλόθεν",707956,28],["ὅτι",709803,7],["ᾠκοδομήθη",709509,37],["τὸ",709436,34],["θυσιαστήριον",706348,15],["καὶ",707031,7],["ἐνεκαινίσθη",703956,37],["τὸ",709436,34],["ἁγίασμα",700154,15],["ὡς",714148,7],["τὸ",709436,24],["πρότερον",710991,46],["καὶ",707031,7],["ὠργίσθησαν",709729,99],["σφόδρα",712586,28]],"Now when the nations round about heard that the altar was built, and the sanctuary renewed as before, it displeased them very much."],["2",[["καὶ",707031,7],["ἐβουλεύσαντο",702791,189],["τοῦ",709436,20],["ἆραι",700473,106],["τὸ",709436,24],["γένος",703057,25],["Ιακωβ",706401,18],["τοὺς",709436,58],["ὄντας",704093,235],["ἐν",704639,0],["μέσῳ",708768,30],["αὐτῶν",702165,40],["καὶ",707031,7],["ἤρξαντο",701860,189],["τοῦ",709436,20],["θανατοῦν",706097,55],["ἐν",704639,0],["τῷ",709436,113],["λαῷ",708094,114],["καὶ",707031,7],["ἐξαίρειν",704839,55]],"Wherefore they thought to destroy the generation of Jacob that was among them, and thereupon they began to slay and destroy the people."],["3",[["καὶ",707031,7],["ἐπολέμει",710601,13],["Ιουδας",706775,4],["πρὸς",710844,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ησαυ",706030,118],["ἐν",704639,0],["τῇ",709436,100],["Ιδουμαίᾳ",706503,1],["τὴν",709436,8],["Ακραβαττήνην",700589,9],["ὅτι",709803,7],["περιεκάθηντο",710324,139],["τὸν",709436,5],["Ισραηλ",706839,6],["καὶ",707031,7],["ἐπάταξεν",710185,2],["αὐτοὺς",702165,62],["πληγὴν",710527,9],["μεγάλην",708653,36],["καὶ",707031,7],["συνέστειλεν",712558,2],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἔλαβεν",708076,2],["τὰ",709436,41],["σκῦλα",711902,42],["αὐτῶν",702165,40]],"Then Judas fought against the children of Esau in Idumea at Acrabattine, because they besieged Israel: and he gave them a great overthrow, and abated their courage, and took their spoils."],["4",[["καὶ",707031,7],["ἐμνήσθη",708960,37],["τῆς",709436,16],["κακίας",707054,17],["υἱῶν",713075,81],["Βαιαν",702384,118],["οἳ",709781,250],["ἦσαν",704093,137],["τῷ",709436,113],["λαῷ",708094,114],["εἰς",704105,0],["παγίδα",709910,9],["καὶ",707031,7],["σκάνδαλον",711825,25],["ἐν",704639,0],["τῷ",709436,53],["ἐνεδρεύειν",704703,55],["αὐτοὺς",702165,62],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76]],"Also he remembered the injury of the children of Bæan, who had been a snare and an offence unto the people, in that they lay in wait for them in the ways."],["5",[["καὶ",707031,7],["συνεκλείσθησαν",712223,99],["ὑπ᾿",713184,0],["αὐτοῦ",702165,102],["εἰς",704105,0],["τοὺς",709436,58],["πύργους",711092,57],["καὶ",707031,7],["παρενέβαλεν",710132,2],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἀνεθεμάτισεν",700951,2],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἐνεπύρισε",704622,2],["τοὺς",709436,58],["πύργους",711092,57],["αὐτῆς",702165,86],["ἐν",704639,0],["πυρὶ",711088,54],["σὺν",712372,0],["πᾶσιν",710177,230],["τοῖς",709436,147],["ἐνοῦσιν",704707,349]],"He shut them up therefore in the towers, and encamped against them, and destroyed them utterly, and burned the towers of that [place] with fire, and all that were therein."],["6",[["καὶ",707031,7],["διεπέρασεν",703543,2],["ἐπὶ",705080,0],["τοὺς",709436,58],["υἱοὺς",713075,57],["Αμμων",700847,118],["καὶ",707031,7],["εὗρεν",705676,2],["χεῖρα",713787,9],["κραταιὰν",707873,36],["καὶ",707031,7],["λαὸν",708094,6],["πολὺν",710646,27],["καὶ",707031,7],["Τιμόθεον",712860,6],["ἡγούμενον",705931,212],["αὐτῶν",702165,40]],"Afterward he passed over to the children of Ammon, where he found a mighty power, and much people, with Timotheus their captain."],["7",[["καὶ",707031,7],["συνῆψεν",712404,2],["πρὸς",710844,0],["αὐτοὺς",702165,62],["πολέμους",710605,57],["πολλούς",710646,60],["καὶ",707031,7],["συνετρίβησαν",712520,99],["πρὸ",710747,0],["προσώπου",710986,21],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπάταξεν",710185,2],["αὐτούς",702165,62]],"So he fought many battles with them, till at length they were discomfited before him; and he smote them."],["8",[["καὶ",707031,7],["προκατελάβετο",710809,23],["τὴν",709436,8],["Ιαζηρ",706382,9],["καὶ",707031,7],["τὰς",709436,38],["θυγατέρας",706320,39],["αὐτῆς",702165,86],["καὶ",707031,7],["ἀνέστρεψεν",701060,2],["εἰς",704105,0],["τὴν",709436,8],["Ιουδαίαν",706769,9]],"And when he had taken Jazer, with the towns belonging thereto, he returned into Judea."],["9",[["καὶ",707031,7],["ἐπισυνήχθησαν",705280,99],["τὰ",709436,63],["ἔθνη",704068,64],["τὰ",709436,63],["ἐν",704639,0],["τῇ",709436,100],["Γαλααδ",702920,1],["ἐπὶ",705080,0],["τὸν",709436,5],["Ισραηλ",706839,6],["τοὺς",709436,58],["ὄντας",704093,235],["ἐπὶ",705080,0],["τοῖς",709436,95],["ὁρίοις",709749,96],["αὐτῶν",702165,40],["τοῦ",709436,20],["ἐξᾶραι",704839,106],["αὐτούς",702165,62],["καὶ",707031,7],["ἔφυγον",713433,150],["εἰς",704105,0],["Δαθεμα",703245,227],["τὸ",709436,24],["ὀχύρωμα",709891,25]],"Then the heathen that were at Galaad assembled themselves together against the Israelites that were in their quarters, to destroy them: but they fled to the fortress of Dathema,"],["10",[["καὶ",707031,7],["ἀπέστειλαν",701592,150],["γράμματα",703183,42],["πρὸς",710844,0],["Ιουδαν",706775,6],["καὶ",707031,7],["τοὺς",709436,58],["ἀδελφοὺς",700249,57],["αὐτοῦ",702165,102],["λέγοντες",708124,146],["ἐπισυνηγμένα",705280,443],["ἐστὶν",704093,91],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["τὰ",709436,63],["ἔθνη",704068,64],["κύκλῳ",707959,114],["ἡμῶν",705999,145],["τοῦ",709436,20],["ἐξᾶραι",704839,106],["ἡμᾶς",705981,194]],"and sent letters unto Judas and his brethren, saying, The heathen that are round about us are assembled together against us to destroy us:"],["11",[["καὶ",707031,7],["ἑτοιμάζονται",705539,269],["ἐλθεῖν",705453,106],["καὶ",707031,7],["προκαταλαβέσθαι",710809,109],["τὸ",709436,24],["ὀχύρωμα",709891,25],["εἰς",704105,0],["ὃ",709781,128],["κατεφύγομεν",707472,289],["καὶ",707031,7],["Τιμόθεος",712860,4],["ἡγεῖται",705931,117],["τῆς",709436,16],["δυνάμεως",703839,17],["αὐτῶν",702165,40]],"and they are preparing to come and take the fortress where unto we are fled, Timotheus being captain of their host."],["12",[["νῦν",709384,28],["οὖν",709835,11],["ἐλθὼν",705453,182],["ἐξελοῦ",704838,300],["ἡμᾶς",705981,194],["ἐκ",704132,0],["χειρὸς",713787,17],["αὐτῶν",702165,40],["ὅτι",709803,7],["πέπτωκεν",710481,171],["ἐξ",704132,0],["ἡμῶν",705999,145],["πλῆθος",710529,25]],"Come now therefore, and deliver us from their hands, for many of us are slain:"],["13",[["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["ἡμῶν",705999,145],["οἱ",709436,136],["ὄντες",704093,146],["ἐν",704639,0],["τοῖς",709436,147],["Τουβίου",712910,18],["τεθανάτωνται",706097,408],["καὶ",707031,7],["ᾐχμαλωτίκασιν",700501,353],["τὰς",709436,38],["γυναῖκας",703209,39],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,41],["τέκνα",712761,42],["καὶ",707031,7],["τὴν",709436,8],["ἀποσκευὴν",701573,9],["καὶ",707031,7],["ἀπώλεσαν",701513,150],["ἐκεῖ",704181,28],["ὡσεὶ",714159,28],["μίαν",704106,36],["χιλιαρχίαν",713856,9],["ἀνδρῶν",701150,81]],"yea, all our brethren that were in the places of Tobie are put to death: their wives and their children also they have carried away captives, and borne away their stuff; and they have destroyed there about a thousand men."],["14",[["ἔτι",705538,28],["αἱ",709436,190],["ἐπιστολαὶ",705272,191],["ἀνεγιγνώσκοντο",700922,139],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἄγγελοι",700140,52],["ἕτεροι",705535,138],["παρεγένοντο",710006,189],["ἐκ",704132,0],["τῆς",709436,16],["Γαλιλαίας",702940,17],["διερρηχότες",703566,268],["τὰ",709436,41],["ἱμάτια",706742,42],["ἀπαγγέλλοντες",701321,146],["κατὰ",707200,0],["τὰ",709436,41],["ῥήματα",711246,42],["ταῦτα",709858,71]],"While these letters were yet being read, behold, there came other messengers from Galilee with their clothes rent, who reported on this wise,"],["15",[["λέγοντες",708124,146],["ἐπισυνῆχθαι",705280,431],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["ἐκ",704132,0],["Πτολεμαίδος",711066,17],["καὶ",707031,7],["Τύρου",713028,18],["καὶ",707031,7],["Σιδῶνος",711775,118],["καὶ",707031,7],["πᾶσαν",710177,36],["Γαλιλαίαν",702940,9],["ἀλλοφύλων",700706,169],["τοῦ",709436,20],["ἐξαναλῶσαι",704861,106],["ἡμᾶς",705981,194]],"saying that they of Ptolemais, and of Tyrus, and Sidon, and all Galilee of the Gentiles, were assembled together against them to consume us."],["16",[["ὡς",714148,7],["δὲ",703303,11],["ἤκουσεν",700587,2],["Ιουδας",706775,4],["καὶ",707031,7],["ὁ",709436,3],["λαὸς",708094,4],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["ἐπισυνήχθη",705280,37],["ἐκκλησία",704216,12],["μεγάλη",708653,29],["βουλεύσασθαι",702791,109],["τί",712867,126],["ποιήσωσιν",710582,234],["τοῖς",709436,147],["ἀδελφοῖς",700249,148],["αὐτῶν",702165,40],["τοῖς",709436,147],["οὖσιν",704093,349],["ἐν",704639,0],["θλίψει",706276,1],["καὶ",707031,7],["πολεμουμένοις",710601,341],["ὑπ᾿",713184,0],["αὐτῶν",702165,40]],"Now when Judas and the people heard these words, there assembled a great congregation together, to consult what they should do for their brethren, that were in trouble, and assaulted of them."],["17",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιουδας",706775,4],["Σιμωνι",711792,114],["τῷ",709436,113],["ἀδελφῷ",700249,114],["αὐτοῦ",702165,102],["ἐπίλεξον",705188,176],["σεαυτῷ",711599,50],["ἄνδρας",701150,57],["καὶ",707031,7],["πορεύου",710667,253],["καὶ",707031,7],["ῥῦσαι",711309,300],["τοὺς",709436,58],["ἀδελφούς",700249,57],["σου",711945,133],["τοὺς",709436,58],["ἐν",704639,0],["τῇ",709436,100],["Γαλιλαίᾳ",702940,1],["ἐγὼ",704018,164],["δὲ",703303,11],["καὶ",707031,7],["Ιωναθαν",706927,4],["ὁ",709436,3],["ἀδελφός",700249,4],["μου",709032,133],["πορευσόμεθα",710667,141],["εἰς",704105,0],["τὴν",709436,8],["Γαλααδῖτιν",702925,9]],"Then said Judas unto Simon his brother, Choose thee out men, and go and deliver thy brethren that are in Galilee, for I and Jonathan my brother will go into the country of Galaad."],["18",[["καὶ",707031,7],["κατέλιπεν",707305,2],["Ιωσηπον