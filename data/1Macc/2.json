[["1",[["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["ἀνέστη",701173,2],["Ματταθιας",708585,4],["υἱὸς",713075,4],["Ιωαννου",706892,18],["τοῦ",709436,35],["Συμεων",712297,18],["ἱερεὺς",706614,4],["τῶν",709436,80],["υἱῶν",713075,81],["Ιωαριβ",706894,18],["ἀπὸ",701425,0],["Ιερουσαλημ",706644,17],["καὶ",707031,7],["ἐκάθισεν",707006,2],["ἐν",704639,0],["Μωδεϊν",709092,1]],"In those days arose Mattathias [the son] of John, [the son] of Simeon, a priest of the sons of Joarib, from Jerusalem, and dwelt in Modin."],["2",[["καὶ",707031,7],["αὐτῷ",702165,50],["υἱοὶ",713075,52],["πέντε",710266,59],["Ιωαννης",706892,4],["ὁ",709436,3],["ἐπικαλούμενος",705153,122],["Γαδδι",702877,4]],"And he had five sons, Joannan, called Caddis:"],["3",[["Σιμων",711792,4],["ὁ",709436,3],["καλούμενος",707084,122],["Θασσι",706132,4]],"Simon, called Thassi:"],["4",[["Ιουδας",706775,4],["ὁ",709436,3],["καλούμενος",707084,122],["Μακκαβαῖος",708410,4]],"Judas, who was called Maccabeus:"],["5",[["Ελεαζαρ",704407,4],["ὁ",709436,3],["καλούμενος",707084,122],["Αυαραν",702118,4],["Ιωναθης",706929,4],["ὁ",709436,3],["καλούμενος",707084,122],["Απφους",701658,4]],"Eleazar, called Avaran: and Jonathan, whose surname was Apphus.",{"s":"d","q":0.5}],["6",[["καὶ",707031,7],["εἶδεν",709725,2],["τὰς",709436,38],["βλασφημίας",702738,39],["τὰς",709436,38],["γινομένας",703104,312],["ἐν",704639,0],["Ιουδα",706768,114],["καὶ",707031,7],["ἐν",704639,0],["Ιερουσαλημ",706644,1]],"And when he saw the blasphemies that were committed in Juda and Jerusalem,"],["7",[["καὶ",707031,7],["εἶπεν",705373,2],["οἴμμοι",709525,88],["ἵνα",706747,7],["τί",712867,126],["τοῦτο",709858,129],["ἐγεννήθην",703051,156],["ἰδεῖν",709725,106],["τὸ",709436,24],["σύντριμμα",712521,25],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",709032,133],["καὶ",707031,7],["τὸ",709436,24],["σύντριμμα",712521,25],["τῆς",709436,16],["ἁγίας",700159,82],["πόλεως",710612,17],["καὶ",707031,7],["καθίσαι",707006,106],["ἐκεῖ",704181,28],["ἐν",704639,0],["τῷ",709436,53],["δοθῆναι",703654,179],["αὐτὴν",702165,104],["ἐν",704639,0],["χειρὶ",713787,1],["ἐχθρῶν",705779,169],["τὸ",709436,24],["ἁγίασμα",700154,25],["ἐν",704639,0],["χειρὶ",713787,1],["ἀλλοτρίων",700699,169]],"he said, Woe is me! wherefore was I born to see this misery of my people, and of the holy city, and to dwell there, when it was delivered into the hand of the enemy, and the sanctuary into the hand of strangers?"],["8",[["ἐγένετο",703104,23],["ὁ",709436,3],["ναὸς",709191,4],["αὐτῆς",702165,86],["ὡς",714148,7],["ἀνὴρ",701150,4],["ἄδοξος",700286,14]],"Her temple is become as a man without glory."],["9",[["τὰ",709436,63],["σκεύη",711843,64],["τῆς",709436,16],["δόξης",703791,17],["αὐτῆς",702165,86],["αἰχμάλωτα",700503,68],["ἀπήχθη",701324,37],["ἀπεκτάνθη",701498,37],["τὰ",709436,63],["νήπια",709295,195],["αὐτῆς",702165,86],["ἐν",704639,0],["ταῖς",709436,75],["πλατείαις",710509,291],["αὐτῆς",702165,86],["οἱ",709436,136],["νεανίσκοι",709232,52],["αὐτῆς",702165,86],["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["ἐχθροῦ",705779,116]],"Her glorious vessels are carried away into captivity, her infants are slain in the streets, her young men with the sword of the enemy."],["10",[["ποῖον",710599,26],["ἔθνος",704068,15],["οὐκ",709805,28],["ἐκληρονόμησεν",707724,2],["βασίλεια",702578,64],["καὶ",707031,7],["οὐκ",709805,28],["ἐκράτησεν",707879,2],["τῶν",709436,43],["σκύλων",711902,44],["αὐτῆς",702165,86]],"What nation hath not had a part in [her] kingdom, and gotten of her spoils?"],["11",[["πᾶς",710177,14],["ὁ",709436,3],["κόσμος",707851,4],["αὐτῆς",702165,86],["ἀφῃρέθη",702177,37],["ἀντὶ",701227,0],["ἐλευθέρας",704428,82],["ἐγένετο",703104,23],["εἰς",704105,0],["δούλην",703815,9]],"All her ornaments are taken away; of a free woman she has become a bondslave."],["12",[["καὶ",707031,7],["ἰδοὺ",706497,88],["τὰ",709436,63],["ἅγια",700159,195],["ἡμῶν",705999,145],["καὶ",707031,7],["ἡ",709436,10],["καλλονὴ",707092,12],["ἡμῶν",705999,145],["καὶ",707031,7],["ἡ",709436,10],["δόξα",703791,12],["ἡμῶν",705999,145],["ἠρημώθη",705421,37],["καὶ",707031,7],["ἐβεβήλωσαν",702614,150],["αὐτὰ",702165,71],["τὰ",709436,63],["ἔθνη",704068,64]],"And, behold, our sanctuary, even our beauty and our glory, is laid waste, and the Gentiles have profaned it."],["13",[["ἵνα",706747,7],["τί",712867,126],["ἡμῖν",705994,90],["ἔτι",705538,28],["ζωή",705910,12]],"To what end therefore shall we live any longer?"],["14",[["καὶ",707031,7],["διέρρηξεν",703565,2],["Ματταθιας",708585,4],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτοῦ",702165,102],["τὰ",709436,41],["ἱμάτια",706742,42],["αὐτῶν",702165,40],["καὶ",707031,7],["περιεβάλοντο",710294,189],["σάκκους",711386,57],["καὶ",707031,7],["ἐπένθησαν",710251,150],["σφόδρα",712586,28]],"Then Mattathias and his sons rent their clothes, and put on sackcloth, and mourned very sore."],["15",[["καὶ",707031,7],["ἦλθον",705453,150],["οἱ",709436,136],["παρὰ",709995,0],["τοῦ",709436,35],["βασιλέως",702580,18],["οἱ",709436,136],["καταναγκάζοντες",707336,146],["τὴν",709436,8],["ἀποστασίαν",701586,9],["εἰς",704105,0],["Μωδεϊν",709092,9],["τὴν",709436,8],["πόλιν",710612,9],["ἵνα",706747,7],["θυσιάσωσιν",706346,234]],"In the mean while the king's officers, such as compelled the people to revolt, came into the city Modin, to make them sacrifice."],["16",[["καὶ",707031,7],["πολλοὶ",710646,138],["ἀπὸ",701425,0],["Ισραηλ",706839,18],["πρὸς",710844,0],["αὐτοὺς",702165,62],["προσῆλθον",710890,150],["καὶ",707031,7],["Ματταθιας",708585,4],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτοῦ",702165,102],["συνήχθησαν",712375,99]],"And when many of Israel came unto them, Mattathias also and his sons came together."],["17",[["καὶ",707031,7],["ἀπεκρίθησαν",701492,99],["οἱ",709436,136],["παρὰ",709995,0],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["εἶπον",705373,150],["τῷ",709436,113],["Ματταθια",708585,114],["λέγοντες",708124,146],["ἄρχων",701862,4],["καὶ",707031,7],["ἔνδοξος",704694,14],["καὶ",707031,7],["μέγας",708653,14],["εἶ",704093,154],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["ταύτῃ",709858,105],["καὶ",707031,7],["ἐστηρισμένος",712098,419],["υἱοῖς",713075,148],["καὶ",707031,7],["ἀδελφοῖς",700249,148]],"Then answered the king's officers, and said to Mattathias on this wise, Thou art a ruler, and an honourable and great man in this city, and strengthened with sons and brethren:"],["18",[["νῦν",709384,28],["πρόσελθε",710890,176],["πρῶτος",711041,140],["καὶ",707031,7],["ποίησον",710582,176],["τὸ",709436,24],["πρόσταγμα",710959,25],["τοῦ",709436,35],["βασιλέως",702580,18],["ὡς",714148,7],["ἐποίησαν",710582,150],["πάντα",710177,195],["τὰ",709436,63],["ἔθνη",704068,64],["καὶ",707031,7],["οἱ",709436,136],["ἄνδρες",701150,52],["Ιουδα",706768,18],["καὶ",707031,7],["οἱ",709436,136],["καταλειφθέντες",707305,247],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["ἔσῃ",704093,123],["σὺ",712181,164],["καὶ",707031,7],["οἱ",709436,136],["υἱοί",713075,52],["σου",711945,133],["τῶν",709436,80],["φίλων",713492,169],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["σὺ",712181,164],["καὶ",707031,7],["οἱ",709436,136],["υἱοί",713075,52],["σου",711945,133],["δοξασθήσεσθε",703792,261],["ἀργυρίῳ",701707,54],["καὶ",707031,7],["χρυσίῳ",713972,54],["καὶ",707031,7],["ἀποστολαῖς",701596,76],["πολλαῖς",710646,291]],"now therefore come thou first, and fulfil the king's commandment, like as all the nations have done, yea, and the men of Juda also, and such as remain at Jerusalem: so shalt thou and thy house be in the number of the king's friends, and thou and thy children shall be honoured with silver and gold, and many rewards."],["19",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["Ματταθιας",708585,4],["καὶ",707031,7],["εἶπεν",705373,2],["φωνῇ",713640,1],["μεγάλῃ",708653,101],["εἰ",704071,7],["πάντα",710177,195],["τὰ",709436,63],["ἔθνη",704068,64],["τὰ",709436,63],["ἐν",704639,0],["οἴκῳ",709516,114],["τῆς",709436,16],["βασιλείας",702577,17],["τοῦ",709436,35],["βασιλέως",702580,18],["ἀκούουσιν",700587,197],["αὐτοῦ",702165,102],["ἀποστῆναι",702214,106],["ἕκαστος",704133,14],["ἀπὸ",701425,0],["λατρείας",708106,17],["πατέρων",710189,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["ᾑρετίσαντο",700469,189],["ἐν",704639,0],["ταῖς",709436,75],["ἐντολαῖς",704802,76],["αὐτοῦ",702165,102]],"Then Mattathias answered and spake with a loud voice, Though all the nations that are under the king's dominion obey him, and fall away every one from the religion of their fathers, and give consent to his commandments:"],["20",[["κἀγὼ",706969,288],["καὶ",707031,7],["οἱ",709436,136],["υἱοί",713075,52],["μου",709032,133],["καὶ",707031,7],["οἱ",709436,136],["ἀδελφοί",700249,52],["μου",709032,133],["πορευσόμεθα",710667,141],["ἐν",704639,0],["διαθήκῃ",703456,1],["πατέρων",710189,81],["ἡμῶν",705999,145]],"yet will I and my sons and my brethren walk in the covenant of our fathers."],["21",[["ἵλεως",706732,28],["ἡμῖν",705994,90],["καταλιπεῖν",707305,106],["νόμον",709349,6],["καὶ",707031,7],["δικαιώματα",703697,42]],"God forbid that we should forsake the law and the ordinances."],["22",[["τῶν",709436,80],["λόγων",708236,81],["τοῦ",709436,35],["βασιλέως",702580,18],["οὐκ",709805,28],["ἀκουσόμεθα",700587,141],["παρελθεῖν",710141,106],["τὴν",709436,8],["λατρείαν",708106,9],["ἡμῶν",705999,145],["δεξιὰν",703360,36],["ἢ",705924,7],["ἀριστεράν",701749,36]],"We will not hearken to the king's words, to go from our religion, either on the right hand, or the left."],["23",[["καὶ",707031,7],["ὡς",714148,7],["ἐπαύσατο",710202,23],["λαλῶν",708071,72],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["προσῆλθεν",710890,2],["ἀνὴρ",701150,4],["Ιουδαῖος",706772,14],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["πάντων",710177,169],["θυσιάσαι",706346,106],["ἐπὶ",705080,0],["τοῦ",709436,35],["βωμοῦ",702840,18],["ἐν",704639,0],["Μωδεϊν",709092,1],["κατὰ",707200,0],["τὸ",709436,24],["πρόσταγμα",710959,25],["τοῦ",709436,35],["βασιλέως",702580,18]],"Now when he had left speaking these words, there came one of the Jews in the sight of all to sacrifice on the altar which was at Modin, according to the king's commandment."],["24",[["καὶ",707031,7],["εἶδεν",709725,2],["Ματταθιας",708585,4],["καὶ",707031,7],["ἐζήλωσεν",705873,2],["καὶ",707031,7],["ἐτρόμησαν",712974,150],["οἱ",709436,136],["νεφροὶ",709282,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀνήνεγκεν",701083,2],["θυμὸν",706334,6],["κατὰ",707200,0],["τὸ",709436,24],["κρίμα",707903,25],["καὶ",707031,7],["δραμὼν",712931,182],["ἔσφαξεν",712571,2],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["τὸν",709436,5],["βωμόν",702840,6]],"Which thing when Mattathias saw, he was inflamed with zeal, and his reins trembled, neither could he forbear to shew his anger according to judgment: wherefore he ran, and slew him upon the altar."],["25",[["καὶ",707031,7],["τὸν",709436,5],["ἄνδρα",701150,6],["τοῦ",709436,35],["βασιλέως",702580,18],["τὸν",709436,5],["ἀναγκάζοντα",700923,183],["θύειν",706349,55],["ἀπέκτεινεν",701498,2],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["καὶ",707031,7],["τὸν",709436,5],["βωμὸν",702840,6],["καθεῖλεν",706982,2]],"Also the king's commissioner, who compelled men to sacrifice, he killed at that time, and the altar he pulled down."],["26",[["καὶ",707031,7],["ἐζήλωσεν",705873,2],["τῷ",709436,113],["νόμῳ",709349,114],["καθὼς",707030,28],["ἐποίησεν",710582,2],["Φινεες",713510,4],["τῷ",709436,113],["Ζαμβρι",705831,114],["υἱῷ",713075,114],["Σαλωμ",711427,18]],"Thus dealt he zealously for the law of God, like as Phinees did unto Zambri the son of Salom."],["27",[["καὶ",707031,7],["ἀνέκραξεν",700979,2],["Ματταθιας",708585,4],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["φωνῇ",713640,1],["μεγάλῃ",708653,101],["λέγων",708124,72],["πᾶς",710177,14],["ὁ",709436,3],["ζηλῶν",705873,72],["τῷ",709436,113],["νόμῳ",709349,114],["καὶ",707031,7],["ἱστῶν",706850,81],["διαθήκην",703456,9],["ἐξελθέτω",704909,45],["ὀπίσω",709697,28],["μου",709032,133]],"And Mattathias cried throughout the city with a loud voice, saying, Whosoever is zealous of the law, and maintaineth the covenant, let him follow me."],["28",[["καὶ",707031,7],["ἔφυγεν",713433,2],["αὐτὸς",702165,121],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὰ",709436,41],["ὄρη",709768,42],["καὶ",707031,7],["ἐγκατέλιπον",703967,150],["ὅσα",709788,68],["εἶχον",705785,137],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1]],"So he and his sons fled into the mountains, and left all that ever they had in the city."],["29",[["τότε",712908,28],["κατέβησαν",707202,150],["πολλοὶ",710646,138],["ζητοῦντες",705879,146],["δικαιοσύνην",703695,9],["καὶ",707031,7],["κρίμα",707903,25],["εἰς",704105,0],["τὴν",709436,8],["ἔρημον",705420,9],["καθίσαι",707006,106],["ἐκεῖ",704181,28]],"Then many that sought after justice and judgment went down into the wilderness, to dwell there:"],["30",[["αὐτοὶ",702165,201],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτῶν",702165,40],["καὶ",707031,7],["αἱ",709436,190],["γυναῖκες",703209,191],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,63],["κτήνη",707934,64],["αὐτῶν",702165,40],["ὅτι",709803,7],["ἐσκληρύνθη",711864,37],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["τὰ",709436,63],["κακά",707066,195]],"both they and their children, and their wives, and their cattle; because afflictions increased sore upon them."],["31",[["καὶ",707031,7],["ἀνηγγέλη",700921,37],["τοῖς",709436,147],["ἀνδράσιν",701150,148],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["ταῖς",709436,75],["δυνάμεσιν",703839,76],["αἳ",709781,256],["ἦσαν",704093,137],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["πόλει",710612,1],["Δαυιδ",703232,18],["ὅτι",709803,7],["κατέβησαν",707202,150],["ἄνδρες",701150,52],["οἵτινες",709793,450],["διεσκέδασαν",703575,150],["τὴν",709436,8],["ἐντολὴν",704802,9],["τοῦ",709436,35],["βασιλέως",702580,18],["εἰς",704105,0],["τοὺς",709436,58],["κρύφους",707931,57],["ἐν",704639,0],["τῇ",709436,100],["ἐρήμῳ",705420,1]],"Now when it was told the king's servants, and the host that was at Jerusalem, in the city of David, that certain men, who had broken the king's commandment, were gone down into the secret places in the wilderness,"],["32",[["καὶ",707031,7],["ἔδραμον",712931,150],["ὀπίσω",709697,28],["αὐτῶν",702165,40],["πολλοὶ",710646,138],["καὶ",707031,7],["κατελάβοντο",707300,189],["αὐτοὺς",702165,62],["καὶ",707031,7],["παρενέβαλον",710132,150],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["καὶ",707031,7],["συνεστήσαντο",712482,189],["πρὸς",710844,0],["αὐτοὺς",702165,62],["πόλεμον",710605,6],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῶν",709436,43],["σαββάτων",711350,44]],"they pursued after them a great number, and having overtaken them, they camped against them, and made war against them on the sabbath day."],["33",[["καὶ",707031,7],["εἶπον",705373,150],["πρὸς",710844,0],["αὐτούς",702165,62],["ἕως",705792,28],["τοῦ",709436,35],["νῦν",709384,28],["ἐξελθόντες",704909,196],["ποιήσατε",710582,74],["κατὰ",707200,0],["τὸν",709436,5],["λόγον",708236,6],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["ζήσεσθε",705851,124]],"And they said unto them, Let that which ye have done hitherto suffice; come forth, and do according to the commandment of the king, and ye shall live."],["34",[["καὶ",707031,7],["εἶπον",705373,150],["οὐκ",709805,28],["ἐξελευσόμεθα",704909,141],["οὐδὲ",709816,7],["ποιήσομεν",710582,275],["τὸν",709436,5],["λόγον",708236,6],["τοῦ",709436,35],["βασιλέως",702580,18],["βεβηλῶσαι",702614,106],["τὴν",709436,8],["ἡμέραν",705984,9],["τῶν",709436,43],["σαββάτων",711350,44]],"But they said, We will not come forth, neither will we do the king's commandment, to profane the sabbath day."],["35",[["καὶ",707031,7],["ἐτάχυναν",712749,150],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["πόλεμον",710605,6]],"So then they gave them the battle with all speed."],["36",[["καὶ",707031,7],["οὐκ",709805,28],["ἀπεκρίθησαν",701492,99],["αὐτοῖς",702165,151],["οὐδὲ",709816,7],["λ