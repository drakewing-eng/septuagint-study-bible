[["1",[["καὶ",707031,7],["βασιλεὺς",702580,4],["Αἰγύπτου",700401,17],["ἤθροισεν",700384,2],["δυνάμεις",703839,39],["πολλὰς",710646,119],["ὡς",714148,7],["ἡ",709436,10],["ἄμμος",700845,12],["ἡ",709436,10],["παρὰ",709995,0],["τὸ",709436,24],["χεῖλος",713781,25],["τῆς",709436,16],["θαλάσσης",706069,17],["καὶ",707031,7],["πλοῖα",710556,42],["πολλὰ",710646,68],["καὶ",707031,7],["ἐζήτησε",705879,2],["κατακρατῆσαι",707287,106],["τῆς",709436,16],["βασιλείας",702577,17],["Ἀλεξάνδρου",700652,18],["δόλῳ",703787,114],["καὶ",707031,7],["προσθεῖναι",710965,106],["αὐτὴν",702165,104],["τῇ",709436,100],["βασιλείᾳ",702577,1],["αὐτοῦ",702165,102]],"And the king of Egypt gathered together a great host, like the sand that lieth upon the sea shore, and many ships, and went about through deceit to get Alexander's kingdom, and join it to his own."],["2",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["εἰς",704105,0],["Συρίαν",712533,9],["λόγοις",708236,148],["εἰρηνικοῖς",704099,230],["καὶ",707031,7],["ἤνοιγον",701186,137],["αὐτῷ",702165,50],["οἱ",709436,136],["ἀπὸ",701425,0],["τῶν",709436,130],["πόλεων",710612,65],["καὶ",707031,7],["συνήντων",712394,137],["αὐτῷ",702165,50],["ὅτι",709803,7],["ἐντολὴ",704802,12],["ἦν",704093,13],["Ἀλεξάνδρου",700652,18],["τοῦ",709436,35],["βασιλέως",702580,18],["συναντᾶν",712394,55],["αὐτῷ",702165,50],["διὰ",703417,0],["τὸ",709436,24],["πενθερὸν",710250,6],["αὐτοῦ",702165,102],["εἶναι",704093,55]],"Whereupon he took his journey into Syria in peaceable manner, so as they of the cities opened unto him, and met him: for king Alexander had commanded them so to do, because he was his father in law."],["3",[["ὡς",714148,7],["δὲ",703303,11],["εἰσεπορεύετο",704124,19],["εἰς",704105,0],["τὰς",709436,38],["πόλεις",710612,39],["Πτολεμαῖος",711066,4],["ἀπέτασσε",701608,13],["τὰς",709436,38],["δυνάμεις",703839,39],["φρουρὰν",713593,9],["ἐν",704639,0],["ἑκάστῃ",704133,101],["πόλει",710612,1]],"Now as Ptolemee entered into the cities, he set in every one of them a garrison of soldiers to keep it."],["4",[["ὡς",714148,7],["δὲ",703303,11],["ἤγγισαν",703939,150],["Αζώτου",700351,17],["ἔδειξαν",703314,150],["αὐτῷ",702165,50],["τὸ",709436,24],["ἱερὸν",706631,25],["Δαγων",703240,118],["ἐμπεπυρισμένον",704622,448],["καὶ",707031,7],["Ἄζωτον",700351,9],["καὶ",707031,7],["τὰ",709436,41],["περιπόλια",710369,42],["αὐτῆς",702165,86],["καθῃρημένα",706982,388],["καὶ",707031,7],["τὰ",709436,41],["σώματα",712635,42],["ἐρριμμένα",711267,437],["καὶ",707031,7],["τοὺς",709436,58],["ἐμπεπυρισμένους",704622,458],["οὓς",709781,298],["ἐνεπύρισεν",704622,2],["ἐν",704639,0],["τῷ",709436,113],["πολέμῳ",710605,114],["ἐποίησαν",710582,150],["γὰρ",702963,11],["θιμωνιὰς",706266,39],["αὐτῶν",702165,40],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["αὐτοῦ",702165,102]],"And when he came near to Azotus, they shewed him the temple of Dagon that was burnt, and Azotus and the suburbs thereof that were destroyed, and the bodies that were cast abroad, and them that he had burnt in the battle: for they had made heaps of them by the way where he should pass."],["5",[["καὶ",707031,7],["διηγήσαντο",703679,189],["τῷ",709436,113],["βασιλεῖ",702580,114],["ἃ",709781,69],["ἐποίησεν",710582,2],["Ιωναθαν",706927,4],["εἰς",704105,0],["τὸ",709436,24],["ψογίσαι",714060,106],["αὐτόν",702165,85],["καὶ",707031,7],["ἐσίγησεν",711767,2],["ὁ",709436,3],["βασιλεύς",702580,4]],"Also they told the king whatsoever Jonathan had done, to the intent he might blame him: but the king held his peace."],["6",[["καὶ",707031,7],["συνήντησεν",712394,2],["Ιωναθαν",706927,4],["τῷ",709436,113],["βασιλεῖ",702580,114],["εἰς",704105,0],["Ιοππην",706760,9],["μετὰ",708780,0],["δόξης",703791,17],["καὶ",707031,7],["ἠσπάσαντο",701987,189],["ἀλλήλους",700689,62],["καὶ",707031,7],["ἐκοιμήθησαν",707767,99],["ἐκεῖ",704181,28]],"Then Jonathan met the king with great pomp at Joppe, where they saluted one another, and lodged."],["7",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["Ιωναθαν",706927,4],["μετὰ",708780,0],["τοῦ",709436,35],["βασιλέως",702580,18],["ἕως",705792,28],["τοῦ",709436,35],["ποταμοῦ",710693,18],["τοῦ",709436,35],["καλουμένου",707084,262],["Ἐλευθέρου",704429,18],["καὶ",707031,7],["ἐπέστρεψεν",705278,2],["εἰς",704105,0],["Ιερουσαλημ",706644,9]],"Afterward Jonathan, when he had gone with the king to the river called Eleutherus, returned again to Jerusalem."],["8",[["ὁ",709436,3],["δὲ",703303,11],["βασιλεὺς",702580,4],["Πτολεμαῖος",711066,4],["ἐκυρίευσεν",707995,2],["τῶν",709436,130],["πόλεων",710612,65],["τῆς",709436,16],["παραλίας",710061,17],["ἕως",705792,28],["Σελευκείας",711645,17],["τῆς",709436,16],["παραθαλασσίας",710023,82],["καὶ",707031,7],["διελογίζετο",703505,19],["περὶ",710285,0],["Ἀλεξάνδρου",700652,18],["λογισμοὺς",708234,57],["πονηρούς",710660,60]],"King Ptolemee therefore, having gotten the dominion of the cities by the sea unto Seleucia upon the sea coast, imagined wicked counsels against Alexander."],["9",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["πρέσβεις",710733,57],["πρὸς",710844,0],["Δημήτριον",703407,6],["τὸν",709436,5],["βασιλέα",702580,6],["λέγων",708124,72],["δεῦρο",703382,28],["συνθώμεθα",712513,276],["πρὸς",710844,0],["ἑαυτοὺς",703917,62],["διαθήκην",703456,9],["καὶ",707031,7],["δώσω",703654,165],["σοι",711925,159],["τὴν",709436,8],["θυγατέρα",706320,9],["μου",709032,133],["ἣν",709781,131],["εἶχεν",705785,13],["Ἀλέξανδρος",700652,4],["καὶ",707031,7],["βασιλεύσεις",702581,166],["τῆς",709436,16],["βασιλείας",702577,17],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133]],"Whereupon he sent ambassadors unto king Demetrius, saying, Come, let us make a league betwixt us, and I will give thee my daughter whom Alexander hath, and thou shalt reign in thy father's kingdom:"],["10",[["μεταμεμέλημαι",708805,326],["γὰρ",702963,11],["δοὺς",703654,182],["αὐτῷ",702165,50],["τὴν",709436,8],["θυγατέρα",706320,9],["μου",709032,133],["ἐζήτησεν",705879,2],["γὰρ",702963,11],["ἀποκτεῖναί",701498,106],["με",708618,163]],"for I repent that I gave my daughter unto him, for he sought to slay me."],["11",[["καὶ",707031,7],["ἐψόγισεν",714060,2],["αὐτὸν",702165,85],["χάριν",713735,9],["τοῦ",709436,20],["ἐπιθυμῆσαι",705141,106],["αὐτὸν",702165,85],["τῆς",709436,16],["βασιλείας",702577,17],["αὐτοῦ",702165,102]],"Thus did he slander him, because he was desirous of his kingdom."],["12",[["καὶ",707031,7],["ἀφελόμενος",702177,248],["αὐτοῦ",702165,102],["τὴν",709436,8],["θυγατέρα",706320,9],["ἔδωκεν",703654,2],["αὐτὴν",702165,104],["τῷ",709436,113],["Δημητρίῳ",703407,114],["καὶ",707031,7],["ἠλλοιώθη",700694,37],["τῷ",709436,113],["Ἀλεξάνδρῳ",700652,114],["καὶ",707031,7],["ἐφάνη",713311,37],["ἡ",709436,10],["ἔχθρα",705779,29],["αὐτῶν",702165,40]],"Wherefore he took his daughter from him, and gave her to Demetrius, and forsook Alexander, so that their hatred was openly known."],["13",[["καὶ",707031,7],["εἰσῆλθεν",704114,2],["Πτολεμαῖος",711066,4],["εἰς",704105,0],["Ἀντιόχειαν",701252,9],["καὶ",707031,7],["περιέθετο",710403,23],["τὸ",709436,24],["διάδημα",703447,25],["τῆς",709436,16],["Ἀσίας",701944,17],["καὶ",707031,7],["περιέθετο",710403,23],["δύο",703849,59],["διαδήματα",703447,42],["περὶ",710285,0],["τὴν",709436,8],["κεφαλὴν",707639,9],["αὐτοῦ",702165,102],["τὸ",709436,24],["τῆς",709436,16],["Αἰγύπτου",700401,17],["καὶ",707031,7],["Ἀσίας",701944,17]],"Then Ptolemee entered into Antioch, where he set two crowns upon his head, the crown of Asia, and of Egypt."],["14",[["Ἀλέξανδρος",700652,4],["δὲ",703303,11],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἦν",704093,13],["ἐν",704639,0],["Κιλικίᾳ",707672,1],["κατὰ",707200,0],["τοὺς",709436,58],["καιροὺς",707047,57],["ἐκείνους",704183,62],["ὅτι",709803,7],["ἀπεστάτουν",701589,137],["οἱ",709436,136],["ἀπὸ",701425,0],["τῶν",709436,80],["τόπων",712903,81],["ἐκείνων",704183,40]],"In the mean season was king Alexander in Cilicia, because those that dwelt in those parts had revolted from him."],["15",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Ἀλέξανδρος",700652,4],["καὶ",707031,7],["ἦλθεν",705453,2],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["ἐν",704639,0],["πολέμῳ",710605,114],["καὶ",707031,7],["ἐξήγαγεν",704834,2],["Πτολεμαῖος",711066,4],["καὶ",707031,7],["ἀπήντησεν",701345,2],["αὐτῷ",702165,50],["ἐν",704639,0],["χειρὶ",713787,1],["ἰσχυρᾷ",706855,101],["καὶ",707031,7],["ἐτροπώσατο",712981,23],["αὐτόν",702165,85]],"But when Alexander heard of this, he came to war against him: whereupon [king] Ptolemee brought forth his host, and met him with a mighty power, and put him to flight."],["16",[["καὶ",707031,7],["ἔφυγεν",713433,2],["Ἀλέξανδρος",700652,4],["εἰς",704105,0],["τὴν",709436,8],["Ἀραβίαν",701673,9],["τοῦ",709436,20],["σκεπασθῆναι",711832,179],["αὐτὸν",702165,85],["ἐκεῖ",704181,28],["ὁ",709436,3],["δὲ",703303,11],["βασιλεὺς",702580,4],["Πτολεμαῖος",711066,4],["ὑψώθη",713289,37]],"So Alexander fled into Arabia, there to be defended; but king Ptolemee was exalted:"],["17",[["καὶ",707031,7],["ἀφεῖλεν",702177,2],["Ζαβδιηλ",705805,4],["ὁ",709436,3],["Ἄραψ",701694,4],["τὴν",709436,8],["κεφαλὴν",707639,9],["Ἀλεξάνδρου",700652,18],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["τῷ",709436,113],["Πτολεμαίῳ",711066,114]],"for Zabdiel the Arabian took off Alexander's head, and sent it unto Ptolemee."],["18",[["καὶ",707031,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["Πτολεμαῖος",711066,4],["ἀπέθανεν",701461,2],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["τρίτῃ",712968,101],["καὶ",707031,7],["οἱ",709436,136],["ὄντες",704093,146],["ἐν",704639,0],["τοῖς",709436,95],["ὀχυρώμασιν",709891,96],["αὐτοῦ",702165,102],["ἀπώλοντο",701513,189],["ὑπὸ",713184,0],["τῶν",709436,80],["ἐν",704639,0],["τοῖς",709436,95],["ὀχυρώμασιν",709891,96]],"King Ptolemee also died the third day after, and they that were in the strong holds were slain one of another."],["19",[["καὶ",707031,7],["ἐβασίλευσεν",702581,2],["Δημήτριος",703407,4],["ἔτους",705543,21],["ἑβδόμου",703925,92],["καὶ",707031,7],["ἑξηκοστοῦ",704924,92],["καὶ",707031,7],["ἑκατοστοῦ",704143,92]],"By this means Demetrius reigned in the hundred threescore and seventh year."],["20",[["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["συνήγαγεν",712375,2],["Ιωναθαν",706927,4],["τοὺς",709436,58],["ἐκ",704132,0],["τῆς",709436,16],["Ιουδαίας",706769,17],["τοῦ",709436,20],["ἐκπολεμῆσαι",704290,106],["τὴν",709436,8],["ἄκραν",700588,9],["τὴν",709436,8],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["καὶ",707031,7],["ἐποίησεν",710582,2],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["μηχανὰς",708898,39],["πολλάς",710646,119]],"At the same time Jonathan gathered together them that were in Judea, to take the tower that was in Jerusalem: and he made many engines of war against it."],["21",[["καὶ",707031,7],["ἐπορεύθησάν",710667,99],["τινες",712866,392],["μισοῦντες",708935,146],["τὸ",709436,24],["ἔθνος",704068,25],["αὐτῶν",702165,40],["ἄνδρες",701150,52],["παράνομοι",710080,138],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["καὶ",707031,7],["ἀπήγγειλαν",701321,150],["αὐτῷ",702165,50],["ὅτι",709803,7],["Ιωναθαν",706927,4],["περικάθηται",710324,117],["τὴν",709436,8],["ἄκραν",700588,9]],"Then certain ungodly persons, who hated their own people, went unto the king, and told him that Jonathan besieged the tower."],["22",[["καὶ",707031,7],["ἀκούσας",700587,182],["ὠργίσθη",709729,37],["ὡς",714148,7],["δὲ",703303,11],["ἤκουσεν",700587,2],["εὐθέως",705593,28],["ἀναζεύξας",700941,182],["ἦλθεν",705453,2],["εἰς",704105,0],["Πτολεμαίδα",711066,9],["καὶ",707031,7],["ἔγραψεν",703194,2],["Ιωναθαν",706927,114],["τοῦ",709436,20],["μὴ",708851,28],["περικαθῆσθαι",710324,110],["καὶ",707031,7],["τοῦ",709436,20],["ἀπαντῆσαι",701345,106],["αὐτὸν",702165,85],["αὐτῷ",702165,50],["συμμίσγειν",712310,55],["εἰς",704105,0],["Πτολεμαίδα",711066,9],["τὴν",709436,8],["ταχίστην",712750,506]],"Whereof when he heard, he was angry, and immediately removing, he came to Ptolemais, and wrote unto Jonathan, that he should not lay siege to the tower, but come and speak with him at Ptolemais in great haste."],["23",[["ὡς",714148,7],["δὲ",703303,11],["ἤκουσεν",700587,2],["Ιωναθαν",706927,4],["ἐκέλευσεν",707601,2],["περικαθῆσθαι",710324,110],["καὶ",707031,7],["ἐπέλεξεν",705188,2],["τῶν",709436,80],["πρεσβυτέρων",710735,81],["Ισραηλ",706839,18],["καὶ",707031,7],["τῶν",709436,80],["ἱερέων",706614,81],["καὶ",707031,7],["ἔδωκεν",703654,2],["ἑαυτὸν",703917,85],["τῷ",709436,113],["κινδύνῳ",707678,114]],"Nevertheless Jonathan, when he heard this, commanded to besiege it [still]: and he chose certain of the elders of Israel and the priests, and put himself in peril;"],["24",[["καὶ",707031,7],["λαβὼν",708076,182],["ἀργύριον",701707,25],["καὶ",707031,7],["χρυσίον",713972,25],["καὶ",707031,7],["ἱματισμὸν",706744,6],["καὶ",707031,7],["ἕτερα",705535,68],["ξένια",709410,42],["πλείονα",710514,68],["καὶ",707031,7],["ἐπορεύθη",710667,37],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["εἰς",704105,0],["Πτολεμαίδα",711066,9],["καὶ",707031,7],["εὗρεν",705676,2],["χάριν",713735,9],["ἐναντίον",704654,28],["αὐτοῦ",702165,102]],"and took silver and gold, and raiment, and divers presents besides, and went to Ptolemais unto the king, where he found favour in his sight."],["25",[["καὶ",707031,7],["ἐνετύγχανον",704812,137],["κατ᾿",707200,0],["αὐτοῦ",702165,102],["τινες",712866,392],["ἄνομοι",701194,138],["τῶν",709436,80],["ἐκ",704132,0],["τοῦ",709436,20],["ἔθνους",704068,21]],"And though certain ungodly men of the people had made complaints against him,"],["26",[["καὶ",707031,7],["ἐποίησεν",710582,2],["αὐτῷ",702165,50],["ὁ",709436,3],["βασιλεὺς",702580,4],["καθὼς",707030,28],["ἐποίησαν",710582,150],["αὐτῷ",702165,50],["οἱ",709436,136],["πρὸ",710747,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὕψωσεν",713289,2],["αὐτὸν",702165,85],["ἐναντίον",704654,28],["τῶν",709436,80],["φίλων",713492,169],["αὐτοῦ",702165,102],["πάντων",710177,169]],"yet the king entreated him as his predecessors had done before, and promoted him in the sight of all his friends,"],["27",[["καὶ",707031,7],["ἔστησεν",706846,2],["αὐτῷ",702165,50],["τὴν",709436,8],["ἀρχιερωσύνην",701846,9],["καὶ",707031,7],["ὅσα",709788,68],["ἄλλα",700697,68],["εἶχεν",705785,13],["τίμια",712858,68],["τὸ",709436,24],["πρότερον",710991,46],["καὶ",707031,7],["ἐποίησεν",710582,2],["αὐτὸν",702165,85],["τῶν",709436,80],["πρώτων",711041,616],["φίλων",713492,169],["ἡγεῖσθαι",705931,110]],"and confirmed him in the high priesthood, and in all the honours that he had before, and gave him pre-eminence among his chief friends."],["28",[["καὶ",707031,7],["ἠξίωσεν",701309,2],["Ιωναθαν",706927,4],["τὸν",709436,5],["βασιλέα",702580,6],["ποιῆσαι",710582,106],["τὴν",709436,8],["Ιουδαίαν",706769,9],["ἀφορολόγητον",702231,36],["καὶ",707031,7],["τὰς",709436,38],["τρεῖς",712927,119],["τοπαρχίας",712902,39],["καὶ",707031,7],["τὴν",709436,8],["Σαμαρῖτιν",711451,9],["καὶ",707031,7],["ἐπηγγείλατο",704992,23],["αὐτῷ",702165,50],["τάλαντα",712697,42],["τριακόσια",712936,68]],"Then Jonathan desired the king, that he would make Judea free from tribute, as also the three governments, with the country of Samaria; and he promised him three hundred talents."],["29",[["καὶ",707031,7],["εὐδόκησεν",705565,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["καὶ",707031,7],["ἔγραψεν",703194,2],["τῷ",709436,113],["Ιωναθαν",706927,114],["ἐπιστολὰς",705272,39],["περὶ",710285,0],["πάντων",710177,169],["τούτων",709858,40],["ἐχούσας",705785,338],["τὸν",709436,5],["τρόπον",712980,6],["τοῦτον",709858,85]],"So the king consented, and wrote letters unto Jonathan of all these things after this manner:"],["30",[["βασιλεὺς",702580,4],["Δημήτριος",703407,4],["Ιωναθαν",706927,114],["τῷ",709436,113],["ἀδελφῷ",700249,114],["χαίρειν",713665,55],["καὶ",707031,7],["ἔθνει",704068,54],["Ιουδαίων",706772,81]],"King Demetrius unto his brother Jonathan, and unto the nation of the Jews, sendeth greeting:"],["31",[["τὸ",709436,24],["ἀντίγραφον",701229,25],["τῆς",709436,16],["ἐπιστολῆς",705272,17],["ἧς",709781,167],["ἐγράψαμεν",703194,289],["Λασθένει",708101,114],["τῷ",709436,113],["συγγενεῖ",712185,30],["ἡμῶν",705999,145],["περὶ",710285,0],["ὑμῶν",713091,145],["γεγράφαμεν",703194,314],["καὶ",707031,28],["πρὸς",710844,0],["ὑμᾶς",713080,194],["ὅπως",709719,7],["εἰδῆτε",709492,670]],"We send you here a copy of the letter which we did write unto our cousin Lasthenes concerning you, that ye might see it."],["32",[["βασιλεὺς",702580,4],["Δημήτριος",703407,4],["Λασθένει",708101,114],["τῷ",709436,113],["πατρὶ",710189,114],["χαίρειν",713665,55]],"King Demetrius unto his father Lasthenes sendeth greeting:"],["33",[["τῷ",709436,53],["ἔθνει",704068,54],["τῶν",709436,80],["Ιουδαίων",706772,81],["φίλοις",713492,230],["ἡμῶν",705999,145],["καὶ",707031,7],["συντηροῦσιν",712512,197],["τὰ",709436,41],["πρὸς",710844,0],["ἡμᾶς",705981,194],["δίκαια",703694,68],["ἐκρίναμεν",707905,289],["ἀγαθὸν",700106,46],["ποιῆσαι",710582,106],["χάριν",713735,9],["τῆς",709436,16],["ἐξ",704132,0],["αὐτῶν",702165,40],["εὐνοίας",705648,17],["πρὸς",710844,0],["ἡμᾶς",705981,194]],"We are determined to do good to the people of the Jews, who are our friends, and keep covenants with us, because of their good will toward us."],["34",[["ἑστάκαμεν",706846,314],["αὐτοῖς",702165,151],["τά",709436,41],["τε",712751,11],["ὅρια",709749,42],["τῆς",709436,16],["Ιουδαίας",706769,17],["καὶ",707031,7],["τοὺς",709436,58],["τρεῖς",712927,60],["νομοὺς",709349,57],["Αφαιρεμα",702174,227],["καὶ",707031,7],["Λυδδα",708263,227],["καὶ",707031,7],["Ραθαμιν",711153,227],["προσετέθησαν",710965,99],["τῇ",709436,100],["Ιουδαίᾳ",706769,1],["ἀπὸ",701425,0],["τῆς",709436,16],["Σαμαρίτιδος",711451,17],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["συγκυροῦντα",712241,237],["αὐτοῖς",702165,151],["πᾶσιν",710177,230],["τοῖς",709436,147],["θυσιάζουσιν",706346,197],["εἰς",704105,0],["Ιεροσόλυμα",706634,227],["ἀντὶ",701227,0],["τῶν",709436,80],["βασιλικῶν",702582,169],["ὧν",709781,252],["ἐλάμβανεν",708076,13],["ὁ",709436,3],["βασιλεὺς",702580,4],["παρ᾿",709995,0],["αὐτῶν",702165,40],["τὸ",709436,24],["πρότερον",710991,46],["κατ᾿",707200,0],["ἐνιαυτὸν",704745,6],["ἀπὸ",701425,0],["τῶν",709436,43],["γενημάτων",703052,44],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["τῶν",709436,80],["ἀκροδρύων",700607,44]],"Wherefore we have ratified unto them the borders of Judea, with the three governments of Apherema and Lydda and Ramathem, that are added unto Judea from the country of Samaria, and all things appertaining unto them, for all such as do sacrifice in Jerusalem, instead of the payments which the king received of them yearly aforetime out of the fruits of the earth and of trees."],["35",[["καὶ",707031,7],["τὰ",709436,41],["ἄλλα",700697,68],["τὰ",709436,41],["ἀνήκοντα",701145,237],["ἡμῖν",705994,90],["ἀπὸ",701425,0],["τοῦ",709436,35],["νῦν",709384,28],["τῶν",709436,43],["δεκατῶν",703343,83],["καὶ",707031,7],["τῶν",709436,80],["τελῶν",712787,81],["τῶν",709436,80],["ἀνηκόντων",701145,170],["ἡμῖν",705994,90],["καὶ",707031,7],["τὰς",709436,38],["τοῦ",709436,35],["ἁλὸς",700728,18],["λίμνας",708208,39],["καὶ",707031,7],["τοὺς",709436,58],["ἀνήκοντας",701145,235],["ἡμῖν",705994,90],["στεφάνους",712083,57],["πάντα",710177,68],["ἐπαρκέσομεν",705039,275],["αὐτοῖς",702165,151]],"And as for other things that belong unto us, of the tithes and customs pertaining unto us, as also the saltpits, and the crown taxes, which are due unto us, we discharge them of them all for their relief."],["36",[["καὶ",707031,7],["οὐκ",709805,28],["ἀθετηθήσεται",700369,134],["οὐδὲ",709816,7],["ἓν",704106,46],["τούτων",709858,40],["ἀπὸ",701425,0],["τοῦ",709436,35],["νῦν",709384,28],["εἰς",704105,0],["τὸν",709436,5],["ἅπαντα",701362,27],["χρόνον",713969,6]],"And nothing hereof shall be revoked from this time forth for ever."],["37",[["νῦν",709384,28],["οὖν",709835,11],["ἐπιμέλεσθε",705199,374],["τοῦ",709436,20],["ποιῆσαι",710582,106],["τούτων",709858,40],["ἀντίγραφον",701229,25],["καὶ",707031,7],["δοθήτω",703654,22],["Ιωναθαν",706927,114],["καὶ",707031,7],["τεθήτω",712849,22],["ἐν",704639,0],["τῷ",709436,53],["ὄρει",709768,54],["τῷ",709436,53],["ἁγίῳ",700159,97],["ἐν",704639,0],["τόπῳ",712903,114],["ἐπισήμῳ",705245,30]],"Now therefore see that thou make a copy of these things, and let it be delivered unto Jonathan, and set upon the holy mount in a conspicuous place."],["38",[["καὶ",707031,7],["εἶδεν",709725,2],["Δημήτριος",703407,4],["ὁ",709436,3],["βασιλεὺς",702580,4],["ὅτι",709803,7],["ἡσύχασεν",706033,2],["ἡ",709436,10],["γῆ",703083,12],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐδὲν",709817,46],["αὐτῷ",702165,50],["ἀνθειστήκει",701154,143],["καὶ",707031,7],["ἀπέλυσεν",701524,2],["πάσας",710177,119],["τὰς",709436,38],["δυνάμεις",703839,39],["αὐτοῦ",702165,102],["ἕκαστον",704133,27],["εἰς",704105,0],["τὸν",709436,5],["ἴδιον",706493,27],["τόπον",712903,6],["πλὴν",710540,28],["τῶν",709436,80],["ξένων",709415,169],["δυνάμεων",703839,65],["ὧν",709781,252],["ἐξενολόγησεν",709414,2],["ἀπὸ",701425,0],["τῶν",709436,130],["νήσων",709302,65],["τῶν",709436,43],["ἐθνῶν",704068,44],["καὶ",707031,7],["ἤχθραναν",705776,150],["αὐτῷ",702165,50],["πᾶσαι",710177,192],["αἱ",709436,190],["δυνάμεις",703839,191],["αἱ",709436,190],["ἀπὸ",701425,0],["τῶν",709436,80],["πατέρων",710189,81]],"After this, when king Demetrius saw that the land was quiet before him, and that no resistance was made against him, he sent away all his forces, every one to his own place, except certain bands of strangers, whom he had gathered from the isles of the heathen: wherefore all the forces of his fathers hated him."],["39",[["Τρύφων",713010,4],["δὲ",703303,11],["ἦν",704093,13],["τῶν",709436,80],["παρὰ",709995,0],["Ἀλεξάνδρου",700652,18],["τὸ",709436,24],["πρότερον",710991,46],["καὶ",707031,7],["εἶδεν",709725,2],["ὅτι",709803,7],["πᾶσαι",710177,192],["αἱ",709436,190],["δυνάμεις",703839,191],["καταγογγύζουσιν",707229,197],["κατὰ",707200,0],["τοῦ",709436,35],["Δημητρίου",703407,18],["καὶ",707031,7],["ἐπορεύθη",710667,37],["πρὸς",710844,0],["Ιμαλκουε",706737,6],["τὸν",709436,5],["Ἄραβα",701694,6],["ὃς",709781,213],["ἔτρεφεν",712930,13],["Ἀντίοχον",701257,6],["τὸ",709436,24],["παιδάριον",709923,25],["τὸν",709436,5],["τοῦ",709436,35],["Ἀλεξάνδρου",700652,18]],"Moreover there was one Tryphon, that had been of Alexander's part afore, who, seeing that all the host murmured against Demetrius, went to Simalcue the Arabian, that brought up Antiochus the young son of Alexander,"],["40",[["καὶ",707031,7],["προσήδρευεν",710879,13],["αὐτῷ",702165,50],["ὅπως",709719,7],["παραδοῖ",710014,172],["αὐτὸν",702165,85],["αὐτῷ",702165,50],["ὅπως",709719,7],["βασιλεύσῃ",702581,123],["ἀντὶ",701227,0],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀπήγγειλεν",701321,2],["αὐτῷ",702165,50],["ὅσα",709788,68],["συνετέλεσεν",712510,2],["ὁ",709436,3],["Δημήτριος",703407,4],["καὶ",707031,7],["τὴν",709436,8],["ἔχθραν",705779,36],["ἣν",709781,131],["ἐχθραίνουσιν",705776,197],["αὐτῷ",702165,50],["αἱ",709436,190],["δυνάμεις",703839,191],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔμεινεν",708736,2],["ἐκεῖ",704181,28],["ἡμέρας",705984,39],["πολλάς",710646,119]],"and lay sore upon him to deliver him [this young Antiochus], that he might reign in his father's stead: he told him therefore all that Demetrius had done, and how his men of war were at enmity with him, and there he remained a long season."],["41",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Ιωναθαν",706927,4],["πρὸς",710844,0],["Δημήτριον",703407,6],["τὸν",709436,5],["βασιλέα",702580,6],["ἵνα",706747,7],["ἐκβάλῃ",704145,172],["τοὺς",709436,58],["ἐκ",704132,0],["τῆς",709436,16],["ἄκρας",700588,17],["ἐξ",704132,0],["Ιερουσαλημ",706644,17],["καὶ",707031,7],["τοὺς",709436,58],["ἐν",704639,0],["τοῖς",709436,95],["ὀχυρώμασιν",709891,96],["ἦσαν",704093,137],["γὰρ",702963,11],["πολεμοῦντες",710601,146],["τὸν",709436,5],["Ισραηλ",706839,6]],"In the mean time Jonathan sent unto king Demetrius, that he would cast those of the tower out of Jerusalem, and those also in the fortresses: for they fought against Israel."],["42",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Δημήτριος",703407,4],["πρὸς",710844,0],["Ιωναθαν",706927,6],["λέγων",708124,72],["οὐ",709805,28],["ταῦτα",709858,71],["μόνον",709001,28],["ποιήσω",710582,165],["σοι",711925,159],["καὶ",707031,7],["τῷ",709436,53],["ἔθνει",704068,54],["σου",711945,133],["ἀλλὰ",700680,7],["δόξῃ",703791,1],["δοξάσω",703792,165],["σε",711598,163],["καὶ",707031,7],["τὸ",709436,24],["ἔθνος",704068,25],["σου",711945,133],["ἐὰν",703912,7],["εὐκαιρίας",705611,39],["τύχω",713015,207]],"So Demetrius sent unto Jonathan, saying, I will not only do this for thee and thy people, but I will greatly honour thee and thy nation, if opportunity serve."],["43",[["νῦν",709384,28],["οὖν",709835,11],["ὀρθῶς",709746,28],["ποιήσεις",710582,166],["ἀποστείλας",701592,182],["μοι",708974,159],["ἄνδρας",701150,57],["οἳ",709781,250],["συμμαχήσουσίν",712298,218],["μοι",708974,159],["ὅτι",709803,7],["ἀπέστησαν",702214,150],["πᾶσαι",710177,192],["αἱ",709436,190],["δυνάμεις",703839,191],["μου",709032,133]],"Now therefore thou shalt do well, if thou send me men to help me; for all my forces are gone from me."],["44",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Ιωναθαν",706927,4],["ἄνδρας",701150,57],["τρισχιλίους",712964,60],["δυνατοὺς",703845,60],["ἰσχύι",706858,1],["αὐτῷ",702165,50],["εἰς",704105,0],["Ἀντιόχειαν",701252,9],["καὶ",707031,7],["ἦλθον",705453,150],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["καὶ",707031,7],["ηὐφράνθη",705715,37],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐπὶ",705080,0],["τῇ",709436,100],["ἐφόδῳ",705760,1],["αὐτῶν",702165,40]],"Upon this Jonathan sent him three thousand strong men unto Antioch: and when they came to the king, the king was very glad of their coming."],["45",[["καὶ",707031,7],["ἐπισυνήχθησαν",705280,99],["οἱ",709436,136],["ἀπὸ",701425,0],["τῆς",709436,16],["πόλεως",710612,17],["εἰς",704105,0],["μέσον",708768,27],["τῆς",709436,16],["πόλεως",710612,17],["εἰς",704105,0],["ἀνδρῶν",701150,81],["δώδεκα",703887,59],["μυριάδας",709062,39],["καὶ",707031,7],["ἠβούλοντο",702795,139],["ἀνελεῖν",700962,106],["τὸν",709436,5],["βασιλέα",702580,6]],"Howbeit they that were of the city gathered themselves together into the midst of the city, to the number of an hundred and twenty thousand men, and would have slain the king."],["46",[["καὶ",707031,7],["ἔφυγεν",713433,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["εἰς",704105,0],["τὴν",709436,8],["αὐλήν",702137,9],["καὶ",707031,7],["κατελάβοντο",707300,189],["οἱ",709436,136],["ἐκ",704132,0],["τῆς",709436,16],["πόλεως",710612,17],["τὰς",709436,38],["διόδους",703716,39],["τῆς",709436,16],["πόλεως",710612,17],["καὶ",707031,7],["ἤρξαντο",701860,189],["πολεμεῖν",710601,55]],"Wherefore the king fled into the court, but they of the city kept the passages of the city, and began to fight."],["47",[["καὶ",707031,7],["ἐκάλεσεν",707084,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["τοὺς",709436,58],["Ιουδαίους",706772,57],["ἐπὶ",705080,0],["βοήθειαν",702745,9],["καὶ",707031,7],["ἐπισυνήχθησαν",705280,99],["πρὸς",710844,0],["αὐτὸν",702165,85],["πάντες",710177,138],["ἅμα",700745,28],["καὶ",707031,7],["διεσπάρησαν",703584,99],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["καὶ",707031,7],["ἀπέκτειναν",701498,150],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["εἰς",704105,0],["μυριάδας",709062,39],["δέκα",703333,59]],"Then the king called to the Jews for help, who came unto him all at once, and dispersing themselves through the city slew that day in the city to the number of an hundred thousand."],["48",[["καὶ",707031,7],["ἐνεπύρισαν",704622,150],["τὴν",709436,8],["πόλιν",710612,9],["καὶ",707031,7],["ἔλαβον",708076,150],["σκῦλα",711902,42],["πολλὰ",710646,68],["ἐν",704639,0],["ἐκείνῃ",704183,105],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["καὶ",707031,7],["ἔσωσαν",712627,150],["τὸν",709436,5],["βασιλέα",702580,6]],"Also they set fire on the city, and gat many spoils that day, and delivered the king."],["49",[["καὶ",707031,7],["εἶδον",709725,150],["οἱ",709436,136],["ἀπὸ",701425,0],["τῆς",709436,16],["πόλεως",710612,17],["ὅτι",709803,7],["κατεκράτησαν",707287,150],["οἱ",709436,136],["Ιουδαῖοι",706772,52],["τῆς",709436,16],["πόλεως",710612,17],["ὡς",714148,7],["ἠβούλοντο",702795,139],["καὶ",707031,7],["ἠσθένησαν",701938,150],["ταῖς",709436,75],["διανοίαις",703531,76],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐκέκραξαν",707868,150],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["μετὰ",708780,0],["δεήσεως",703311,17],["λέγοντες",708124,146]],"So when they of the city saw that the Jews had got the city as they would, their courage was abated: wherefore they made supplication to the king, and cried, saying,"],["50",[["δὸς",703654,176],["ἡμῖν",705994,90],["δεξιὰς",703360,119],["καὶ",707031,7],["παυσάσθωσαν",710202,486],["οἱ",709436,136],["Ιουδαῖοι",706772,52],["πολεμοῦντες",710601,146],["ἡμᾶς",705981,194],["καὶ",707031,7],["τὴν",709436,8],["πόλιν",710612,9]],"Grant us peace, and let the Jews cease from assaulting us and the city."],["51",[["καὶ",707031,7],["ἔρριψαν",711267,150],["τὰ",709436,41],["ὅπλα",709704,42],["καὶ",707031,7],["ἐποίησαν",710582,150],["εἰρήνην",704098,9],["καὶ",707031,7],["ἐδοξάσθησαν",703792,99],["οἱ",709436,136],["Ιουδαῖοι",706772,52],["ἐναντίον",704654,0],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["ἐνώπιον",704823,0],["πάντων",710177,169],["τῶν",709436,80],["ἐν",704639,0],["τῇ",709436,100],["βασιλείᾳ",702577,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπέστρεψαν",705278,150],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["ἔχοντες",705785,146],["σκῦλα",711902,42],["πολλά",710646,68]],"With that they cast away their weapons, and made peace; and the Jews were honoured in the sight of the king, and in the sight of all that were in his realm; and they returned to Jerusalem, having great spoils."],["52",[["καὶ",707031,7],["ἐκάθισεν",707006,2],["Δημήτριος",703407,4],["ὁ",709436,3],["βασιλεὺς",702580,4],["ἐπὶ",705080,0],["θρόνου",706315,18],["τῆς",709436,16],["βασιλείας",702577,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἡσύχασεν",706033,2],["ἡ",709436,10],["γῆ",703083,12],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102]],"So king Demetrius sat on the throne of his kingdom, and the land was quiet before him."],["53",[["καὶ",707031,7],["ἐψεύσατο",714045,23],["πάντα",710177,68],["ὅσα",709788,68],["εἶπεν",705373,2],["καὶ",707031,7],["ἠλλοτριώθη",700701,37],["τῷ",709436,113],["Ιωναθαν",706927,114],["καὶ",707031,7],["οὐκ",709805,28],["ἀνταπέδωκεν",701215,2],["τὰς",709436,38],["εὐνοίας",705648,39],["ἃς",709781,193],["ἀνταπέδωκεν",701215,2],["αὐτῷ",702165,50],["καὶ",707031,7],["ἔθλιβεν",706274,13],["αὐτὸν",702165,85],["σφόδρα",712586,28]],"Nevertheless he dissembled in all that ever he spake, and estranged himself from Jonathan, neither rewarded he him according to the benefits which he had received of him, but troubled him very sore."],["54",[["μετὰ",708780,0],["δὲ",703303,11],["ταῦτα",709858,71],["ἀπέστρεψεν",701598,2],["Τρύφων",713010,4],["καὶ",707031,7],["Ἀντίοχος",701257,4],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["παιδάριον",709923,15],["νεώτερον",709256,385],["καὶ",707031,7],["ἐβασίλευσεν",702581,2],["καὶ",707031,7],["ἐπέθετο",705304,23],["διάδημα",703447,25]],"After this returned Tryphon, and with him the young child Antiochus, who reigned, and was crowned."],["55",[["καὶ",707031,7],["ἐπισυνήχθησαν",705280,99],["πρὸς",710844,0],["αὐτὸν",702165,85],["πᾶσαι",710177,192],["αἱ",709436,190],["δυνάμεις",703839,191],["ἃς",709781,193],["ἀπεσκοράκισεν",701578,2],["Δημήτριος",703407,4],["καὶ",707031,7],["ἐπολέμησαν",710601,150],["πρὸς",710844,0],["αὐτόν",702165,85],["καὶ",707031,7],["ἔφυγεν",713433,2],["καὶ",707031,7],["ἐτροπώθη",712981,37]],"Then there gathered unto him all the men of war, whom Demetrius had put away, and they fought against Demetrius, who turned his back and fled."],["56",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Τρύφων",713010,4],["τὰ",709436,41],["θηρία",706252,42],["καὶ",707031,7],["κατεκράτησεν",707287,2],["τῆς",709436,16],["Ἀντιοχείας",701252,17]],"Moreover Tryphon took the elephants, and won Antioch."],["57",[["καὶ",707031,7],["ἔγραψεν",703194,2],["Ἀντίοχος",701257,4],["ὁ",709436,3],["νεώτερος",709256,224],["Ιωναθη",706927,114],["λέγων",708124,72],["ἵστημί",706846,157],["σοι",711925,159],["τὴν",709436,8],["ἀρχιερωσύνην",701846,9],["καὶ",707031,7],["καθίστημί",707011,157],["σε",711598,163],["ἐπὶ",705080,0],["τῶν",709436,80],["τεσσάρων",712808,169],["νομῶν",709348,81],["καὶ",707031,7],["εἶναί",704093,55],["σε",711598,163],["τῶν",709436,80],["φίλων",713492,169],["τοῦ",709436,35],["βασιλέως",702580,18]],"At that time young Antiochus wrote unto Jonathan, saying, I confirm thee in the high priesthood, and appoint thee ruler over the four governments, and to be one of the king's friends."],["58",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["αὐτῷ",702165,50],["χρυσώματα",713981,42],["καὶ",707031,7],["διακονίαν",703477,9],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["ἐξουσίαν",704974,9],["πίνειν",710478,55],["ἐν",704639,0],["χρυσώμασιν",713981,96],["καὶ",707031,7],["εἶναι",704093,55],["ἐν",704639,0],["πορφύρᾳ",710682,1],["καὶ",707031,7],["ἔχειν",705785,55],["πόρπην",710679,9],["χρυσῆν",713971,36]],"Upon this he sent him golden vessels to be served in, and gave him leave to drink in gold, and to be clothed in purple, and to wear a golden buckle."],["59",[["καὶ",707031,7],["Σιμωνα",711792,6],["τὸν",709436,5],["ἀδελφὸν",700249,6],["αὐτοῦ",702165,102],["κατέστησεν",707011,2],["στρατηγὸν",712144,6],["ἀπὸ",701425,0],["τῆς",709436,16],["κλίμακος",707736,17],["Τύρου",713028,118],["ἕως",705792,28],["τῶν",709436,43],["ὁρίων",709749,44],["Αἰγύπτου",700401,17]],"His brother Simon also he made captain from the place called The ladder of Tyrus unto the borders of Egypt."],["60",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["Ιωναθαν",706927,4],["καὶ",707031,7],["διεπορεύετο",703551,19],["πέραν",710280,28],["τοῦ",709436,35],["ποταμοῦ",710693,18],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["πόλεσιν",710612,76],["καὶ",707031,7],["ἠθροίσθησαν",700384,99],["πρὸς",710844,0],["αὐτὸν",702165,85],["πᾶσα",710177,29],["δύναμις",703839,12],["Συρίας",712533,17],["εἰς",704105,0],["συμμαχίαν",712299,9],["καὶ",707031,7],["ἦλθεν",705453,2],["εἰς",704105,0],["Ἀσκαλῶνα",701962,227],["καὶ",707031,7],["ἀπήντησαν",701364,150],["αὐτῷ",702165,50],["οἱ",709436,136],["ἐκ",704132,0],["τῆς",709436,16],["πόλεως",710612,17],["ἐνδόξως",704695,28]],"Then Jonathan went forth, and passed through the cities beyond the water, and all the forces of Syria gathered themselves unto him for to help him: and when he came to Ascalon, they of the city met him honourably."],["61",[["καὶ",707031,7],["ἀπῆλθεν",701398,2],["ἐκεῖθεν",704182,28],["εἰς",704105,0],["Γάζαν",702884,9],["καὶ",707031,7],["ἀπέκλεισαν",701484,150],["οἱ",709436,136],["ἀπὸ",701425,0],["Γάζης",702884,17],["καὶ",707031,7],["περιεκάθισεν",710325,2],["περὶ",710285,0],["αὐτὴν",702165,104],["καὶ",707031,7],["ἐνεπύρισεν",704622,2],["τὰ",709436,41],["περιπόλια",710369,42],["αὐτῆς",702165,86],["ἐν",704639,0],["πυρὶ",711088,54],["καὶ",707031,7],["ἐσκύλευσεν",711900,2],["αὐτά",702165,71]],"From whence he went to Gaza, but they of Gaza shut him out; wherefore he laid siege unto it, and burned the suburbs thereof with fire, and spoiled them."],["62",[["καὶ",707031,7],["ἠξίωσαν",701309,150],["οἱ",709436,136],["ἀπὸ",701425,0],["Γάζης",702884,17],["Ιωναθαν",706927,18],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτοῖς",702165,151],["δεξιὰς",703360,119],["καὶ",707031,7],["ἔλαβεν",708076,2],["τοὺς",709436,58],["υἱοὺς",713075,57],["τῶν",709436,80],["ἀρχόντων",701862,81],["αὐτῶν",702165,40],["εἰς",704105,0],["ὅμηρα",709612,68],["καὶ",707031,7],["ἐξαπέστειλεν",704872,2],["αὐτοὺς",702165,62],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["διῆλθεν",703673,2],["τὴν",709436,8],["χώραν",714011,9],["ἕως",705792,28],["Δαμασκοῦ",703275,118]],"Afterward, when they of Gaza made supplication unto Jonathan, he made peace with them, and took the sons of their chief men for hostages, and sent them to Jerusalem, and passed through the country unto Damascus."],["63",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Ιωναθαν",706927,4],["ὅτι",709803,7],["παρῆσαν",710126,137],["οἱ",709436,136],["ἄρχοντες",701862,52],["Δημητρίου",703407,18],["εἰς",704105,0],["Κηδες",707649,9],["τὴν",709436,8],["ἐν",704639,0],["τῇ",709436,100],["Γαλιλαίᾳ",702940,1],["μετὰ",708780,0],["δυνάμεως",703839,17],["πολλῆς",710646,82],["βουλόμενοι",702795,348],["μεταστῆσαι",708668,106],["αὐτὸν",702165,85],["τῆς",709436,16],["χρείας",713938,17]],"Now when Jonathan heard that Demetrius' princes were come to Cades, which is in Galilee, with a great power, purposing to remove him out of the country,"],["64",[["καὶ",707031,7],["συνήντησεν",712394,2],["αὐτοῖς",702165,151],["τὸν",709436,5],["δὲ",703303,11],["ἀδελφὸν",700249,6],["αὐτοῦ",702165,102],["Σιμωνα",711792,6],["κατέλιπεν",707305,2],["ἐν",704639,0],["τῇ",709436,100],["χώρᾳ",714011,1]],"he went to meet them, and left Simon his brother in the country."],["65",[["καὶ",707031,7],["παρενέβαλεν",710132,2],["Σιμων",711792,4],["ἐπὶ",705080,0],["Βαιθσουρα",702436,9],["καὶ",707031,7],["ἐπολέμει",710601,13],["αὐτὴν",702165,104],["ἡμέρας",705984,39],["πολλὰς",710646,119],["καὶ",707031,7],["συνέκλεισεν",712223,2],["αὐτήν",702165,104]],"Then Simon encamped against Bethsura, and fought against it a long season, and shut it up:"],["66",[["καὶ",707031,7],["ἠξίωσαν",701309,150],["αὐτὸν",702165,85],["τοῦ",709436,20],["δεξιὰς",703360,119],["λαβεῖν",708076,106],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἐξέβαλεν",704145,2],["αὐτοὺς",702165,62],["ἐκεῖθεν",704182,28],["καὶ",707031,7],["κατελάβετο",707300,23],["τὴν",709436,8],["πόλιν",710612,9],["καὶ",707031,7],["ἔθετο",712849,23],["ἐπ᾿",705080,0],["αὐτὴν",702165,104],["φρουράν",713593,9]],"but they desired to have peace with him, which he granted them, and then put them out from thence, and took the city, and set a garrison in it."],["67",[["καὶ",707031,7],["Ιωναθαν",706927,4],["καὶ",707031,7],["ἡ",709436,10],["παρεμβολὴ",710133,12],["αὐτοῦ",702165,102],["παρενέβαλον",710132,150],["ἐπὶ",705080,0],["τὸ",709436,24],["ὕδωρ",713071,25],["τοῦ",709436,35],["Γεννησαρ",703053,118],["καὶ",707031,7],["ὤρθρισαν",709742,150],["τὸ",709436,24],["πρωὶ",711021,28],["εἰς",704105,0],["τὸ",709436,24],["πεδίον",710215,25],["Ασωρ",702063,118]],"As for Jonathan and his host, they pitched at the water of Gennesar, from whence betimes in the morning they gat them to the plain of Nasor."],["68",[["καὶ",707031,7],["ἰδοὺ",706497,88],["ἡ",709436,10],["παρεμβολὴ",710133,12],["ἀλλοφύλων",700706,169],["ἀπήντα",701364,13],["αὐτῷ",702165,50],["ἐν",704639,0],["τῷ",709436,53],["πεδίῳ",710215,54],["καὶ",707031,7],["ἐξέβαλον",704145,150],["ἔνεδρον",704704,25],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["ἐν",704639,0],["τοῖς",709436,95],["ὄρεσιν",709768,96],["αὐτοὶ",702165,201],["δὲ",703303,11],["ἀπήντησαν",701364,150],["ἐξ",704132,0],["ἐναντίας",704656,82]],"And, behold, the host of strangers met them in the plain, who, having laid men in ambush for him in the mountains, came themselves over against him."],["69",[["τὰ",709436,63],["δὲ",703303,11],["ἔνεδρα",704704,64],["ἐξανέστησαν",704865,150],["ἐκ",704132,0],["τῶν",709436,80],["τόπων",712903,81],["αὐτῶν",702165,40],["καὶ",707031,7],["συνῆψαν",712404,150],["πόλεμον",710605,6]],"So when they that lay in ambush rose out of their places, and joined battle, all that were of Jonathan's side fled;"],["70",[["καὶ",707031,7],["ἔφυγον",713433,150],["οἱ",709436,136],["παρὰ",709995,0],["Ιωναθου",706927,18],["πάντες",710177,138],["οὐδὲ",709816,7],["εἷς",704106,596],["κατελείφθη",707305,37],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["πλὴν",710540,28],["Ματταθιας",708585,4],["ὁ",709436,3],["τοῦ",709436,35],["Αψαλωμου",702320,18],["καὶ",707031,7],["Ιουδας",706775,4],["ὁ",709436,3],["τοῦ",709436,35],["Χαλφι",713697,18],["ἄρχοντες",701862,52],["τῆς",709436,16],["στρατιᾶς",712145,17],["τῶν",709436,130],["δυνάμεων",703839,65]],"insomuch as there was not one of them left, except Mattathias the [son] of Absalom, and Judas the [son] of Calphi, the captains of the host."],["71",[["καὶ",707031,7],["διέρρηξεν",703565,2],["Ιωναθαν",706927,4],["τὰ",709436,41],["ἱμάτια",706742,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπέθετο",705304,23],["γῆν",703083,9],["ἐπὶ",705080,0],["τὴν",709436,8],["κεφαλὴν",707639,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["προσηύξατο",710893,23]],"Then Jonathan rent his clothes, and cast earth upon his head, and prayed."],["72",[["καὶ",707031,7],["ὑπέστρεψεν",713246,2],["πρὸς",710844,0],["αὐτοὺς",702165,62],["πολέμῳ",710605,114],["καὶ",707031,7],["ἐτροπώσατο",712981,23],["αὐτούς",702165,62],["καὶ",707031,7],["ἔφυγον",713433,150]],"Afterwards turning again to battle, he put them to flight, and so they ran away."],["73",[["καὶ",707031,7],["εἶδον",709725,150],["οἱ",709436,136],["φεύγοντες",713433,146],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπέστρεψαν",705278,150],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐδίωκον",703768,137],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἕως",705792,28],["Κεδες",707585,118],["ἕως",705792,28],["τῆς",709436,16],["παρεμβολῆς",710133,17],["αὐτῶν",702165,40],["καὶ",707031,7],["παρενέβαλον",710132,150],["ἐκεῖ",704181,28]],"Now when his own men that were fled saw this, they turned again unto him, and with him pursued them to Cades, even unto their own tents, and there they camped."],["74",[["καὶ",707031,7],["ἔπεσον",710481,150],["ἐκ",704132,0],["τῶν",709436,80],["ἀλλοφύλων",700706,169],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["εἰς",704105,0],["ἄνδρας",701150,57],["τρισχιλίους",712964,60],["καὶ",707031,7],["ἐπέστρεψεν",705278,2],["Ιωναθαν",706927,4],["εἰς",704105,0],["Ιερουσαλημ",706644,9]],"So there were slain of the heathen that day about three thousand men: but Jonathan returned to Jerusalem."]]