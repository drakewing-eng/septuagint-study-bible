[["1",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["Ἀντίοχος",701257,4],["υἱὸς",713075,4],["Δημητρίου",703407,18],["τοῦ",709436,35],["βασιλέως",702580,18],["ἐπιστολὰς",705272,39],["ἀπὸ",701425,0],["τῶν",709436,130],["νήσων",709302,65],["τῆς",709436,16],["θαλάσσης",706069,17],["Σιμωνι",711792,114],["ἱερεῖ",706614,114],["καὶ",707031,7],["ἐθνάρχῃ",704064,114],["τῶν",709436,80],["Ιουδαίων",706772,81],["καὶ",707031,7],["παντὶ",710177,97],["τῷ",709436,53],["ἔθνει",704068,54]],"Moreover Antiochus son of Demetrius the king sent letters from the isles of the sea unto Simon the priest and prince of the Jews, and to all the people;"],["2",[["καὶ",707031,7],["ἦσαν",704093,137],["περιέχουσαι",710315,306],["τὸν",709436,5],["τρόπον",712980,6],["τοῦτον",709858,85],["βασιλεὺς",702580,4],["Ἀντίοχος",701257,4],["Σίμωνι",711792,114],["ἱερεῖ",706614,114],["μεγάλῳ",708653,30],["καὶ",707031,7],["ἐθνάρχῃ",704064,114],["καὶ",707031,7],["ἔθνει",704068,54],["Ιουδαίων",706772,81],["χαίρειν",713665,55]],"the contents whereof were these: King Antiochus to Simon the high priest and prince of his nation, and to the people of the Jews, greeting:"],["3",[["ἐπεί",705054,7],["τινες",712866,392],["λοιμοὶ",708245,138],["κατεκράτησαν",707287,150],["τῆς",709436,16],["βασιλείας",702577,17],["τῶν",709436,80],["πατέρων",710189,81],["ἡμῶν",705999,145],["βούλομαι",702795,254],["δὲ",703303,11],["ἀντιποιήσασθαι",701266,109],["τῆς",709436,16],["βασιλείας",702577,17],["ὅπως",709719,7],["ἀποκαταστήσω",701470,207],["αὐτὴν",702165,104],["ὡς",714148,7],["ἦν",704093,13],["τὸ",709436,24],["πρότερον",710991,46],["ἐξενολόγησα",709414,155],["δὲ",703303,11],["πλῆθος",710529,25],["δυνάμεων",703839,65],["καὶ",707031,7],["κατεσκεύασα",707419,155],["πλοῖα",710556,42],["πολεμικά",710602,68]],"Forasmuch as certain pestilent men have usurped the kingdom of our fathers, and my purpose is to challenge it again, that I may restore it to the old estate, and to that end have gathered a multitude of foreign soldiers together, and prepared ships of war;"],["4",[["βούλομαι",702795,254],["δὲ",703303,11],["ἐκβῆναι",704144,106],["κατὰ",707200,0],["τὴν",709436,8],["χώραν",714011,9],["ὅπως",709719,7],["μετέλθω",708827,207],["τοὺς",709436,58],["κατεφθαρκότας",707474,277],["τὴν",709436,8],["χώραν",714011,9],["ἡμῶν",705999,145],["καὶ",707031,7],["τοὺς",709436,58],["ἠρημωκότας",705421,277],["πόλεις",710612,39],["πολλὰς",710646,119],["ἐν",704639,0],["τῇ",709436,100],["βασιλείᾳ",702577,1],["μου",709032,133]],"my meaning also being to go through the country, that I may be avenged of them that have destroyed it, and made many cities in the kingdom desolate:"],["5",[["νῦν",709384,28],["οὖν",709835,11],["ἵστημί",706846,157],["σοι",711925,159],["πάντα",710177,68],["τὰ",709436,41],["ἀφέματα",702195,42],["ἃ",709781,69],["ἀφῆκάν",702211,150],["σοι",711925,159],["οἱ",709436,136],["πρὸ",710747,0],["ἐμοῦ",704580,133],["βασιλεῖς",702580,52],["καὶ",707031,7],["ὅσα",709788,68],["ἄλλα",700697,68],["δόματα",703789,42],["ἀφῆκάν",702211,150],["σοι",711925,159]],"now therefore I confirm unto thee all the oblations which the kings before me granted thee, and whatsoever gifts besides they granted."],["6",[["καὶ",707031,7],["ἐπέτρεψά",705311,155],["σοι",711925,159],["ποιῆσαι",710582,106],["κόμμα",707806,25],["ἴδιον",706493,46],["νόμισμα",709342,25],["τῇ",709436,100],["χώρᾳ",714011,1],["σου",711945,133]],"I give thee leave also to coin money for thy country with thine own stamp."],["7",[["Ιερουσαλημ",706644,12],["δὲ",703303,11],["καὶ",707031,7],["τὰ",709436,63],["ἅγια",700159,195],["εἶναι",704093,55],["ἐλεύθερα",704428,195],["καὶ",707031,7],["πάντα",710177,68],["τὰ",709436,41],["ὅπλα",709704,42],["ὅσα",709788,68],["κατεσκεύασας",707419,162],["καὶ",707031,7],["τὰ",709436,41],["ὀχυρώματα",709891,42],["ἃ",709781,69],["ᾠκοδόμησας",709509,162],["ὧν",709781,252],["κρατεῖς",707879,154],["μενέτω",708736,31],["σοι",711925,159]],"And as concerning Jerusalem and the sanctuary, let them be free; and all the armour that thou hast made, and fortresses that thou hast built, and keepest in thine hands, let them remain unto thee."],["8",[["καὶ",707031,7],["πᾶν",710177,26],["ὀφείλημα",709864,15],["βασιλικὸν",702582,26],["καὶ",707031,7],["τὰ",709436,63],["ἐσόμενα",704093,672],["βασιλικὰ",702582,195],["ἀπὸ",701425,0],["τοῦ",709436,35],["νῦν",709384,28],["καὶ",707031,7],["εἰς",704105,0],["τὸν",709436,5],["ἅπαντα",701362,27],["χρόνον",713969,6],["ἀφιέσθω",702211,628],["σοι",711925,159]],"And if any thing be, or shall be, owing to the king, let it be forgiven thee from this time forth for evermore."],["9",[["ὡς",714148,7],["δ᾿",703303,11],["ἂν",700900,11],["κρατήσωμεν",707879,79],["τῆς",709436,16],["βασιλείας",702577,17],["ἡμῶν",705999,145],["δοξάσομέν",703792,275],["σε",711598,163],["καὶ",707031,7],["τὸ",709436,24],["ἔθνος",704068,25],["σου",711945,133],["καὶ",707031,7],["τὸ",709436,24],["ἱερὸν",706631,25],["δόξῃ",703791,1],["μεγάλῃ",708653,101],["ὥστε",714164,7],["φανερὰν",713342,36],["γενέσθαι",703104,109],["τὴν",709436,8],["δόξαν",703791,9],["ὑμῶν",713091,145],["ἐν",704639,0],["πάσῃ",710177,101],["τῇ",709436,100],["γῇ",703083,1]],"Furthermore, when we have obtained our kingdom, we will honour thee, and thy nation, and thy temple, with great honour, so that your honour shall be known throughout the world."],["10",[["ἔτους",705543,21],["τετάρτου",712811,92],["καὶ",707031,7],["ἑβδομηκοστοῦ",703924,92],["καὶ",707031,7],["ἑκατοστοῦ",704143,92],["ἐξῆλθεν",704909,2],["Ἀντίοχος",701257,4],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["τῶν",709436,80],["πατέρων",710189,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["συνῆλθον",712458,150],["πρὸς",710844,0],["αὐτὸν",702165,85],["πᾶσαι",710177,192],["αἱ",709436,190],["δυνάμεις",703839,191],["ὥστε",714164,7],["ὀλίγους",709568,60],["εἶναι",704093,55],["σὺν",712372,0],["Τρύφωνι",713010,114]],"In the hundred threescore and fourteenth year went Antiochus into the land of his fathers: at which time all the forces came together unto him, so that few were left with Tryphon."],["11",[["καὶ",707031,7],["ἐδίωξεν",703768,2],["αὐτὸν",702165,85],["Ἀντίοχος",701257,4],["καὶ",707031,7],["ἦλθεν",705453,2],["εἰς",704105,0],["Δωρα",703899,227],["φεύγων",713433,72],["τὴν",709436,8],["ἐπὶ",705080,0],["θαλάσσης",706069,17]],"Wherefore being pursued by king Antiochus, he fled unto Dora, which lieth by the sea side:",{"s":"d","q":0.69}],["12",[["ᾔδει",709492,143],["γὰρ",702963,11],["ὅτι",709803,7],["ἐπισυνῆκται",705280,187],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["τὰ",709436,63],["κακά",707066,195],["καὶ",707031,7],["ἀφῆκαν",702211,150],["αὐτὸν",702165,85],["αἱ",709436,190],["δυνάμεις",703839,191]],"for he saw that troubles came upon him all at once, and that his forces had forsaken him."],["13",[["καὶ",707031,7],["παρενέβαλεν",710132,2],["Ἀντίοχος",701257,4],["ἐπὶ",705080,0],["Δωρα",703899,227],["καὶ",707031,7],["σὺν",712372,0],["αὐτῷ",702165,50],["δώδεκα",703887,59],["μυριάδες",709062,191],["ἀνδρῶν",701150,81],["πολεμιστῶν",710604,81],["καὶ",707031,7],["ὀκτακισχιλία",709552,29],["ἵππος",706790,12]],"Then camped Antiochus against Dora, having with him an hundred and twenty thousand men of war, and eight thousand horsemen."],["14",[["καὶ",707031,7],["ἐκύκλωσεν",707958,2],["τὴν",709436,8],["πόλιν",710612,9],["καὶ",707031,7],["τὰ",709436,63],["πλοῖα",710556,64],["ἀπὸ",701425,0],["θαλάσσης",706069,17],["συνῆψαν",712404,150],["καὶ",707031,7],["ἔθλιβε",706274,13],["τὴν",709436,8],["πόλιν",710612,9],["ἀπὸ",701425,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["τῆς",709436,16],["θαλάσσης",706069,17],["καὶ",707031,7],["οὐκ",709805,28],["εἴασεν",703918,2],["οὐδένα",709817,27],["ἐκπορεύεσθαι",704293,110],["οὐδὲ",709816,7],["εἰσπορεύεσθαι",704124,110]],"And when he had compassed the city round about, and joined ships close to the town on the sea side, he vexed the city by land and by sea, neither suffered he any to go out or in."],["15",[["καὶ",707031,7],["ἦλθεν",705453,2],["Νουμήνιος",709372,4],["καὶ",707031,7],["οἱ",709436,136],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["ἐκ",704132,0],["Ῥώμης",711322,17],["ἔχοντες",705785,146],["ἐπιστολὰς",705272,39],["τοῖς",709436,147],["βασιλεῦσιν",702580,148],["καὶ",707031,7],["ταῖς",709436,75],["χώραις",714011,76],["ἐν",704639,0],["αἷς",709781,281],["ἐγέγραπτο",703194,322],["τάδε",709446,290]],"In the mean season came Numenius and his company from Rome, having letters to the kings and countries; wherein were written these things:"],["16",[["Λεύκιος",708164,4],["ὕπατος",713106,4],["Ῥωμαίων",711318,81],["Πτολεμαίῳ",711066,114],["βασιλεῖ",702580,114],["χαίρειν",713665,55]],"Lucius, consul of the Romans unto king Ptolemee, greeting:"],["17",[["οἱ",709436,136],["πρεσβευταὶ",710731,52],["τῶν",709436,80],["Ιουδαίων",706772,81],["ἦλθον",705453,150],["πρὸς",710844,0],["ἡμᾶς",705981,194],["φίλοι",713492,138],["ἡμῶν",705999,145],["καὶ",707031,7],["σύμμαχοι",712301,52],["ἀνανεούμενοι",701011,348],["τὴν",709436,8],["ἐξ",704132,0],["ἀρχῆς",701836,17],["φιλίαν",713474,9],["καὶ",707031,7],["συμμαχίαν",712299,9],["ἀπεσταλμένοι",701592,429],["ἀπὸ",701425,0],["Σιμωνος",711792,18],["τοῦ",709436,35],["ἀρχιερέως",701845,18],["καὶ",707031,7],["τοῦ",709436,35],["δήμου",703411,18],["τῶν",709436,80],["Ιουδαίων",706772,81]],"The Jews' ambassadors, our friends and confederates, came unto us to renew the old friendship and league, being sent from Simon the high priest, and from the people of the Jews:"],["18",[["ἤνεγκαν",713428,150],["δὲ",703303,11],["ἀσπίδα",701991,9],["χρυσῆν",713971,36],["ἀπὸ",701425,0],["μνῶν",708959,65],["χιλίων",713859,198]],"and they brought a shield of gold of a thousand pound."],["19",[["ἤρεσεν",701722,2],["οὖν",709835,11],["ἡμῖν",705994,90],["γράψαι",703194,106],["τοῖς",709436,147],["βασιλεῦσιν",702580,148],["καὶ",707031,7],["ταῖς",709436,75],["χώραις",714011,76],["ὅπως",709719,7],["μὴ",708851,28],["ἐκζητήσωσιν",704187,234],["αὐτοῖς",702165,151],["κακὰ",707066,68],["καὶ",707031,7],["μὴ",708851,28],["πολεμήσωσιν",710601,234],["αὐτοὺς",702165,62],["καὶ",707031,7],["τὰς",709436,38],["πόλεις",710612,39],["αὐτῶν",702165,40],["καὶ",707031,7],["τὴν",709436,8],["χώραν",714011,9],["αὐτῶν",702165,40],["καὶ",707031,7],["ἵνα",706747,7],["μὴ",708851,28],["συμμαχῶσιν",712298,271],["τοῖς",709436,147],["πολεμοῦσιν",710601,349],["πρὸς",710844,0],["αὐτούς",702165,62]],"We thought it good therefore to write unto the kings and countries, that they should do them no harm, nor fight against them, their cities, or countries, nor yet aid their enemies against them."],["20",[["ἔδοξεν",703775,2],["δὲ",703303,11],["ἡμῖν",705994,90],["δέξασθαι",703393,109],["τὴν",709436,8],["ἀσπίδα",701991,9],["παρ᾿",709995,0],["αὐτῶν",702165,40]],"It seemed also good to us to receive the shield of them."],["21",[["εἴ",704071,7],["τινες",712866,392],["οὖν",709835,11],["λοιμοὶ",708245,138],["διαπεφεύγασιν",703623,353],["ἐκ",704132,0],["τῆς",709436,16],["χώρας",714011,17],["αὐτῶν",702165,40],["πρὸς",710844,0],["ὑμᾶς",713080,194],["παράδοτε",710014,74],["αὐτοὺς",702165,62],["Σιμωνι",711792,114],["τῷ",709436,113],["ἀρχιερεῖ",701845,114],["ὅπως",709719,7],["ἐκδικήσῃ",704174,123],["αὐτοὺς",702165,62],["κατὰ",707200,0],["τὸν",709436,5],["νόμον",709349,6],["αὐτῶν",702165,40]],"If therefore there be any pestilent fellows, that have fled from their country unto you, deliver them unto Simon the high priest, that he may punish them according to their own law."],["22",[["καὶ",707031,7],["ταὐτὰ",709436,71],["ἔγραψεν",703194,2],["Δημητρίῳ",703407,114],["τῷ",709436,113],["βασιλεῖ",702580,114],["καὶ",707031,7],["Ἀττάλῳ",702110,114],["καὶ",707031,7],["Ἀριαράθῃ",701738,114],["καὶ",707031,7],["Ἀρσάκῃ",701816,114]],"The same things wrote he likewise unto Demetrius the king, and Attalus, to Ariarathes, and Arsaces,"],["23",[["καὶ",707031,7],["εἰς",704105,0],["πάσας",710177,119],["τὰς",709436,38],["χώρας",714011,39],["καὶ",707031,7],["Σαμψάμῃ",711481,114],["καὶ",707031,7],["Σπαρτιάταις",711998,148],["καὶ",707031,7],["εἰς",704105,0],["Δῆλον",703400,227],["καὶ",707031,7],["εἰς",704105,0],["Μύνδον",709058,227],["καὶ",707031,7],["εἰς",704105,0],["Σικυῶνα",711789,227],["καὶ",707031,7],["εἰς",704105,0],["τὴν",709436,8],["Καρίαν",707145,9],["καὶ",707031,7],["εἰς",704105,0],["Σάμον",711470,227],["καὶ",707031,7],["εἰς",704105,0],["τὴν",709436,8],["Παμφυλίαν",709954,9],["καὶ",707031,7],["εἰς",704105,0],["Λυκίαν",708268,9],["καὶ",707031,7],["εἰς",704105,0],["Ἁλικαρνασσὸν",700669,227],["καὶ",707031,7],["εἰς",704105,0],["Ῥόδον",711282,227],["καὶ",707031,7],["εἰς",704105,0],["Φασηλίδα",713382,9],["καὶ",707031,7],["εἰς",704105,0],["Κῶ",708029,227],["καὶ",707031,7],["εἰς",704105,0],["Σίδην",711770,9],["καὶ",707031,7],["εἰς",704105,0],["Ἄραδον",701679,227],["καὶ",707031,7],["Γόρτυναν",703175,9],["καὶ",707031,7],["Κνίδον",707754,227],["καὶ",707031,7],["Κύπρον",707987,227],["καὶ",707031,7],["Κυρήνην",707992,9]],"and to all the countries, and to Sampsames, and the Lacedemonians, and to Delus, and Myndus, and Sicyon, and Caria, and Samos, and Pamphylia, and Lycia, and Halicarnassus, and Rhodus, and Phaselis, and Cos, and Side, and Aradus, and Gortyna, and Cnidus, and Cyprus, and Cyrene."],["24",[["τὸ",709436,24],["δὲ",703303,11],["ἀντίγραφον",701229,25],["τούτων",709858,40],["ἔγραψαν",703194,150],["Σιμωνι",711792,114],["τῷ",709436,113],["ἀρχιερεῖ",701845,114]],"And the copy hereof they wrote to Simon the high priest."],["25",[["ἀντίοχος",701256,4],["δὲ",703303,11],["ὁ",709436,3],["βασιλεὺς",702580,4],["παρενέβαλεν",710132,2],["ἐπὶ",705080,0],["Δωρα",703899,227],["ἐν",704639,0],["τῇ",709436,100],["δευτέρᾳ",703389,101],["προσάγων",710848,72],["διὰ",703417,0],["παντὸς",710177,116],["αὐτῇ",702165,105],["τὰς",709436,38],["χεῖρας",713787,39],["καὶ",707031,7],["μηχανὰς",708898,39],["ποιούμενος",710582,122],["καὶ",707031,7],["συνέκλεισεν",712223,2],["τὸν",709436,5],["Τρύφωνα",713010,6],["τοῦ",709436,20],["ἐκπορεύεσθαι",704293,110],["καὶ",707031,7],["εἰσπορεύεσθαι",704124,110]],"So Antiochus the king camped against Dora the second [day], assaulting it continually, and making engines, by which means he shut up Tryphon, that he could neither go out nor in."],["26",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["αὐτῷ",702165,50],["Σιμων",711792,4],["δισχιλίους",703747,60],["ἄνδρας",701150,57],["ἐκλεκτοὺς",704240,60],["συμμαχῆσαι",712298,106],["αὐτῷ",702165,50],["καὶ",707031,7],["ἀργύριον",701707,25],["καὶ",707031,7],["χρυσίον",713972,25],["καὶ",707031,7],["σκεύη",711844,42],["ἱκανά",706710,68]],"At that time Simon sent him two thousand chosen men to aid him; silver also, and gold, and much armour."],["27",[["καὶ",707031,7],["οὐκ",709805,28],["ἠβούλετο",702795,19],["αὐτὰ",702165,71],["δέξασθαι",703393,109],["ἀλλὰ",700680,7],["ἠθέτησεν",700369,2],["πάντα",710177,68],["ὅσα",709788,68],["συνέθετο",712513,23],["αὐτῷ",702165,50],["τὸ",709436,24],["πρότερον",710991,46],["καὶ",707031,7],["ἠλλοτριοῦτο",700701,19],["αὐτῷ",702165,50]],"Nevertheless he would not receive them, but brake all the covenants which he had made with him afore, and became strange unto him."],["28",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["πρὸς",710844,0],["αὐτὸν",702165,85],["Ἀθηνόβιον",700374,6],["ἕνα",704106,27],["τῶν",709436,80],["φίλων",713492,169],["αὐτοῦ",702165,102],["κοινολογησόμενον",707770,673],["αὐτῷ",702165,50],["λέγων",708124,72],["ὑμεῖς",713081,219],["κατακρατεῖτε",707287,87],["τῆς",709436,16],["Ιοππης",706760,17],["καὶ",707031,7],["Γαζαρων",702889,118],["καὶ",707031,7],["τῆς",709436,16],["ἄκρας",700588,17],["τῆς",709436,16],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["πόλεις",710612,191],["τῆς",709436,16],["βασιλείας",702577,17],["μου",709032,133]],"Furthermore he sent unto him Athenobius, one of his friends, to commune with him, and say, Ye withhold Joppe and Gazara, with the tower that is in Jerusalem, which are cities of my realm."],["29",[["τὰ",709436,41],["ὅρια",709749,42],["αὐτῶν",702165,40],["ἠρημώσατε",705421,265],["καὶ",707031,7],["ἐποιήσατε",710582,265],["πληγὴν",710527,9],["μεγάλην",708653,36],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["ἐκυριεύσατε",707995,265],["τόπων",712903,81],["πολλῶν",710646,169],["ἐν",704639,0],["τῇ",709436,100],["βασιλείᾳ",702577,1],["μου",709032,133]],"The borders thereof ye have wasted, and done great hurt in the land, and got the dominion of many places within my kingdom."],["30",[["νῦν",709384,28],["οὖν",709835,11],["παράδοτε",710014,74],["τὰς",709436,38],["πόλεις",710612,39],["ἃς",709781,193],["κατελάβεσθε",707300,345],["καὶ",707031,7],["τοὺς",709436,58],["φόρους",713561,57],["τῶν",709436,80],["τόπων",712903,81],["ὧν",709781,252],["κατεκυριεύσατε",707297,265],["ἐκτὸς",704339,0],["τῶν",709436,43],["ὁρίων",709749,44],["τῆς",709436,16],["Ιουδαίας",706769,17]],"Now therefore deliver the cities which ye have taken, and the tributes of the places, whereof ye have gotten dominion without the borders of Judea:"],["31",[["εἰ",704071,7],["δὲ",703303,11],["μή",708851,28],["δότε",703654,74],["ἀντ᾿",701227,0],["αὐτῶν",702165,40],["πεντακόσια",710261,68],["τάλαντα",712697,42],["ἀργυρίου",701707,21],["καὶ",707031,7],["τῆς",709436,16],["καταφθορᾶς",707475,17],["ἧς",709781,167],["κατεφθάρκατε",707474,330],["καὶ",707031,7],["τῶν",709436,80],["φόρων",713561,81],["τῶν",709436,130],["πόλεων",710612,65],["ἄλλα",700697,68],["τάλαντα",712697,42],["πεντακόσια",710261,68],["εἰ",704071,7],["δὲ",703303,11],["μή",708851,28],["παραγενόμενοι",710006,317],["ἐκπολεμήσομεν",704290,275],["ὑμᾶς",713080,194]],"or else give me for them five hundred talents of silver; and for the harm that ye have done, and the tributes of the cities, other five hundred talents: if not, we will come and fight against you."],["32",[["καὶ",707031,7],["ἦλθεν",705453,2],["Ἀθηνόβιος",700374,4],["ὁ",709436,3],["φίλος",713492,14],["τοῦ",709436,35],["βασιλέως",702580,18],["εἰς",704105,0],["Ιερουσαλημ",706644,9],["καὶ",707031,7],["εἶδεν",709725,2],["τὴν",709436,8],["δόξαν",703791,9],["Σιμωνος",711792,18],["καὶ",707031,7],["κυλικεῖον",707965,25],["μετὰ",708780,0],["χρυσωμάτων",713981,44],["καὶ",707031,7],["ἀργυρωμάτων",701713,44],["καὶ",707031,7],["παράστασιν",710105,9],["ἱκανὴν",706710,36],["καὶ",707031,7],["ἐξίστατο",704940,19],["καὶ",707031,7],["ἀπήγγειλεν",701321,2],["αὐτῷ",702165,50],["τοὺς",709436,58],["λόγους",708236,57],["τοῦ",709436,35],["βασιλέως",702580,18]],"So Athenobius the king's friend came to Jerusalem: and when he saw the glory of Simon, and the cupboard of gold and silver plate, and his great attendance, he was astonished, and told him the king's message."],["33",[["καὶ",707031,7],["ἀποκριθεὶς",701492,217],["Σιμων",711792,4],["εἶπεν",705373,2],["αὐτῷ",702165,50],["οὔτε",709857,7],["γῆν",703083,9],["ἀλλοτρίαν",700699,36],["εἰλήφαμεν",708076,314],["οὔτε",709857,7],["ἀλλοτρίων",700699,169],["κεκρατήκαμεν",707879,314],["ἀλλὰ",700680,7],["τῆς",709436,16],["κληρονομίας",707725,17],["τῶν",709436,80],["πατέρων",710189,81],["ἡμῶν",705999,145],["ὑπὸ",713184,0],["δὲ",703303,11],["ἐχθρῶν",705779,169],["ἡμῶν",705999,145],["ἀκρίτως",700600,28],["ἔν",704639,0],["τινι",712866,435],["καιρῷ",707047,114],["κατεκρατήθη",707287,37]],"Then answered Simon, and said unto him, We have neither taken other men's land, nor holden that which appertaineth to others, but the inheritance of our fathers, which our enemies had wrongfully in possession a certain time."],["34",[["ἡμεῖς",705983,219],["δὲ",703303,11],["καιρὸν",707047,6],["ἔχοντες",705785,146],["ἀντεχόμεθα",701225,378],["τῆς",709436,16],["κληρονομίας",707725,17],["τῶν",709436,80],["πατέρων",710189,81],["ἡμῶν",705999,145]],"Wherefore we, having opportunity, hold the inheritance of our fathers."],["35",[["περὶ",710285,0],["δὲ",703303,11],["Ιοππης",706760,17],["καὶ",707031,7],["Γαζαρων",702889,118],["ὧν",709781,252],["αἰτεῖς",700489,154],["αὗται",709858,202],["ἐποίουν",710582,137],["ἐν",704639,0],["τῷ",709436,113],["λαῷ",708094,114],["πληγὴν",710527,9],["μεγάλην",708653,36],["καὶ",707031,7],["τὴν",709436,8],["χώραν",714011,9],["ἡμῶν",705999,145],["τούτων",709858,40],["δώσομεν",703654,275],["τάλαντα",712697,42],["ἑκατόν",704136,59]],"And whereas thou demandest Joppe and Gazara, albeit they did great harm unto the people in our country, yet will we give an hundred talents for them. Hereunto Athenobius answered him not a word;"],["36",[["καὶ",707031,7],["οὐκ",709805,28],["ἀπεκρίθη",701492,37],["αὐτῷ",702165,50],["λόγον",708236,6],["ἀπέστρεψεν",701598,2],["δὲ",703303,11],["μετὰ",708780,0],["θυμοῦ",706334,18],["πρὸς",710844,0],["τὸν",709436,5],["βασιλέα",702580,6],["καὶ",707031,7],["ἀπήγγειλεν",701321,2],["αὐτῷ",702165,50],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["καὶ",707031,7],["τὴν",709436,8],["δόξαν",703791,9],["Σιμωνος",711792,18],["καὶ",707031,7],["πάντα",710177,68],["ὅσα",709788,68],["εἶδεν",709725,2],["καὶ",707031,7],["ὠργίσθη",709729,37],["ὁ",709436,3],["βασιλεὺς",702580,4],["ὀργὴν",709728,9],["μεγάλην",708653,36]],"but returned in a rage to the king, and made report unto him of these speeches, and of the glory of Simon, and of all that he had seen: whereupon the king was exceeding wroth."],["37",[["τρύφων",713008,65],["δὲ",703303,11],["ἐμβὰς",704546,182],["εἰς",704105,0],["πλοῖον",710556,25],["ἔφυγεν",713433,2],["εἰς",704105,0],["Ὀρθωσίαν",709747,9]],"In the mean time fled Tryphon by ship unto Orthosias."],["38",[["καὶ",707031,7],["κατέστησεν",707011,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["τὸν",709436,5],["Κενδεβαῖον",707602,6],["ἐπιστράτηγον",705276,6],["τῆς",709436,16],["παραλίας",710061,17],["καὶ",707031,7],["δυνάμεις",703839,39],["πεζικὰς",710217,119],["καὶ",707031,7],["ἱππικὰς",706788,119],["ἔδωκεν",703654,2],["αὐτῷ",702165,50]],"Then the king made Cendebeus captain of the sea coast, and gave him an host of footmen and horsemen,"],["39",[["καὶ",707031,7],["ἐνετείλατο",704791,23],["αὐτῷ",702165,50],["παρεμβάλλειν",710132,55],["κατὰ",707200,0],["πρόσωπον",710986,25],["τῆς",709436,16],["Ιουδαίας",706769,17],["καὶ",707031,7],["ἐνετείλατο",704791,23],["αὐτῷ",702165,50],["οἰκοδομῆσαι",709509,106],["τὴν",709436,8],["Κεδρων",707591,9],["καὶ",707031,7],["ὀχυρῶσαι",709890,106],["τὰς",709436,38],["πύλας",711082,39],["καὶ",707031,7],["ὅπως",709719,7],["πολεμῇ",710601,204],["τὸν",709436,5],["λαόν",708094,6],["ὁ",709436,3],["δὲ",703303,11],["βασιλεὺς",702580,4],["ἐδίωκε",703768,13],["τὸν",709436,5],["Τρύφωνα",713010,6]],"and commanded him to remove his host toward Judea: also he commanded him to build up Cedron, and to fortify the gates, and to war against the people; but as for the king [himself], he pursued Tryphon."],["40",[["καὶ",707031,7],["παρεγενήθη",710006,37],["Κενδεβαῖος",707602,4],["εἰς",704105,0],["Ιάμνειαν",706412,9],["καὶ",707031,7],["ἤρξατο",701860,23],["τοῦ",709436,20],["ἐρεθίζειν",705400,55],["τὸν",709436,5],["λαὸν",708094,6],["καὶ",707031,7],["ἐμβατεύειν",704548,55],["εἰς",704105,0],["τὴν",709436,8],["Ιουδαίαν",706769,9],["καὶ",707031,7],["αἰχμαλωτίζειν",700501,55],["τὸν",709436,5],["λαὸν",708094,6],["καὶ",707031,7],["φονεύειν",713546,55]],"So Cendebeus came to Jamnia, and began to provoke the people, and to invade Judea, and to take the people prisoners, and slay them."],["41",[["καὶ",707031,7],["ᾠκοδόμησεν",709509,2],["τὴν",709436,8],["Κεδρων",707591,9],["καὶ",707031,7],["ἀπέταξεν",701608,2],["ἐκεῖ",704181,28],["ἱππεῖς",706786,57],["καὶ",707031,7],["δυνάμεις",703839,39],["ὅπως",709719,7],["ἐκπορευόμενοι",704293,348],["ἐξοδεύωσιν",704943,271],["τὰς",709436,38],["ὁδοὺς",709458,39],["τῆς",709436,16],["Ιουδαίας",706769,17],["καθὰ",706979,28],["συνέταξεν",712508,2],["αὐτῷ",702165,50],["ὁ",709436,3],["βασιλεύς",702580,4]],"And when he had built up Cedron, he set horsemen there, and an host [of footmen], to the end that issuing out they might make outroads upon the ways of Judea, as the king had commanded him."]]