[["1",[["καὶ",707031,7],["ἀνέστη",701173,2],["Ιουδας",706775,4],["ὁ",709436,3],["καλούμενος",707084,122],["Μακκαβαῖος",708410,4],["υἱὸς",713075,4],["αὐτοῦ",702165,102],["ἀντ᾿",701227,0],["αὐτοῦ",702165,102]],"Then his son Judas, called Maccabeus, rose up in his stead."],["2",[["καὶ",707031,7],["ἐβοήθουν",702746,137],["αὐτῷ",702165,50],["πάντες",710177,138],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["πάντες",710177,138],["ὅσοι",709788,138],["ἐκολλήθησαν",707791,99],["τῷ",709436,113],["πατρὶ",710189,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπολέμουν",710601,137],["τὸν",709436,5],["πόλεμον",710605,6],["Ισραηλ",706839,114],["μετ᾿",708780,0],["εὐφροσύνης",705717,17]],"And all his brethren helped him, and so did all they that held with his father, and they fought with cheerfulness the battle of Israel."],["3",[["καὶ",707031,7],["ἐπλάτυνεν",710508,13],["δόξαν",703791,9],["τῷ",709436,113],["λαῷ",708094,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐνεδύσατο",704701,23],["θώρακα",706356,6],["ὡς",714148,7],["γίγας",703101,4],["καὶ",707031,7],["συνεζώσατο",712250,23],["τὰ",709436,41],["σκεύη",711843,42],["τὰ",709436,41],["πολεμικὰ",710602,68],["αὐτοῦ",702165,102],["καὶ",707031,7],["πολέμους",710605,57],["συνεστήσατο",712482,23],["σκεπάζων",711832,72],["παρεμβολὴν",710133,9],["ἐν",704639,0],["ῥομφαίᾳ",711291,1]],"So he gat his people great honour, and put on a breastplate as a giant, and girt his warlike harness about him, and he made battles, protecting the host with his sword."],["4",[["καὶ",707031,7],["ὡμοιώθη",709628,37],["λέοντι",708171,114],["ἐν",704639,0],["τοῖς",709436,95],["ἔργοις",705396,96],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὡς",714148,7],["σκύμνος",711903,4],["ἐρευγόμενος",705410,122],["εἰς",704105,0],["θήραν",706244,9]],"In his acts he was like a lion, and like a lion's whelp roaring for his prey."],["5",[["καὶ",707031,7],["ἐδίωξεν",703768,2],["ἀνόμους",701194,60],["ἐξερευνῶν",704905,72],["καὶ",707031,7],["τοὺς",709436,58],["ταράσσοντας",712721,235],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["ἐφλόγισεν",713521,2]],"For he pursued the wicked, and sought them out, and burnt up those that vexed his people."],["6",[["καὶ",707031,7],["συνεστάλησαν",712558,99],["ἄνομοι",701194,138],["ἀπὸ",701425,0],["τοῦ",709436,35],["φόβου",713534,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["ἐργάται",705390,52],["τῆς",709436,16],["ἀνομίας",701192,17],["συνεταράχθησαν",712507,99],["καὶ",707031,7],["εὐοδώθη",705654,37],["σωτηρία",712658,12],["ἐν",704639,0],["χειρὶ",713787,1],["αὐτοῦ",702165,102]],"Wherefore the wicked shrunk for fear of him, and all the workers of iniquity were troubled, because salvation prospered in his hand."],["7",[["καὶ",707031,7],["ἐπίκρανεν",710469,2],["βασιλεῖς",702580,57],["πολλοὺς",710646,60],["καὶ",707031,7],["εὔφρανεν",705715,2],["τὸν",709436,5],["Ιακωβ",706401,6],["ἐν",704639,0],["τοῖς",709436,95],["ἔργοις",705396,96],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἕως",705792,28],["τοῦ",709436,35],["αἰῶνος",700504,18],["τὸ",709436,34],["μνημόσυνον",708966,15],["αὐτοῦ",702165,102],["εἰς",704105,0],["εὐλογίαν",705633,9]],"He grieved also many kings, and made Jacob glad with his acts, and his memorial is blessed for ever."],["8",[["καὶ",707031,7],["διῆλθεν",703673,2],["ἐν",704639,0],["πόλεσιν",710612,76],["Ιουδα",706768,18],["καὶ",707031,7],["ἐξωλέθρευσεν",704956,2],["ἀσεβεῖς",701909,60],["ἐξ",704132,0],["αὐτῆς",702165,86],["καὶ",707031,7],["ἀπέστρεψεν",701598,2],["ὀργὴν",709728,9],["ἀπὸ",701425,0],["Ισραηλ",706839,18]],"Moreover he went through the cities of Juda, destroying the ungodly out of them, and turning away wrath from Israel:"],["9",[["καὶ",707031,7],["ὠνομάσθη",709667,37],["ἕως",705792,28],["ἐσχάτου",705519,116],["γῆς",703083,17],["καὶ",707031,7],["συνήγαγεν",712375,2],["ἀπολλυμένους",701513,236]],"so that he was renowned unto the utmost part of the earth, and he received unto him such as were ready to perish."],["10",[["καὶ",707031,7],["συνήγαγεν",712375,2],["Ἀπολλώνιος",701515,4],["ἔθνη",704068,42],["καὶ",707031,7],["ἀπὸ",701425,0],["Σαμαρείας",711449,17],["δύναμιν",703839,9],["μεγάλην",708653,36],["τοῦ",709436,20],["πολεμῆσαι",710601,106],["πρὸς",710844,0],["τὸν",709436,5],["Ισραηλ",706839,6]],"Then Apollonius gathered the Gentiles together, and a great host out of Samaria, to fight against Israel."],["11",[["καὶ",707031,7],["ἔγνω",703105,2],["Ιουδας",706775,4],["καὶ",707031,7],["ἐξῆλθεν",704909,2],["εἰς",704105,0],["συνάντησιν",712397,9],["αὐτῷ",702165,50],["καὶ",707031,7],["ἐπάταξεν",710185,2],["αὐτὸν",702165,85],["καὶ",707031,7],["ἀπέκτεινεν",701498,2],["καὶ",707031,7],["ἔπεσον",710481,150],["τραυματίαι",712921,52],["πολλοί",710646,138],["καὶ",707031,7],["οἱ",709436,136],["ἐπίλοιποι",705194,138],["ἔφυγον",713433,150]],"Which thing when Judas perceived, he went forth to meet him, and so he smote him, and slew him: many also fell down slain, but the rest fled."],["12",[["καὶ",707031,7],["ἔλαβον",708076,150],["τὰ",709436,41],["σκῦλα",711902,42],["αὐτῶν",702165,40],["καὶ",707031,7],["τὴν",709436,8],["μάχαιραν",708593,9],["Ἀπολλωνίου",701515,18],["ἔλαβεν",708076,2],["Ιουδας",706775,4],["καὶ",707031,7],["ἦν",704093,13],["πολεμῶν",710605,81],["ἐν",704639,0],["αὐτῇ",702165,105],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39]],"Wherefore Judas took their spoils, and Apollonius' sword also, and therewith he fought all his life long."],["13",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Σήρων",711755,4],["ὁ",709436,3],["ἄρχων",701862,4],["τῆς",709436,16],["δυνάμεως",703839,17],["Συρίας",712533,17],["ὅτι",709803,7],["ἤθροισεν",700384,2],["Ιουδας",706775,4],["ἄθροισμα",700385,25],["καὶ",707031,7],["ἐκκλησίαν",704216,9],["πιστῶν",710486,169],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐκπορευομένων",704293,299],["εἰς",704105,0],["πόλεμον",710605,6]],"Now when Seron, a prince of the army of Syria, heard say that Judas had gathered unto him a multitude and company of the faithful to go out with him to war;"],["14",[["καὶ",707031,7],["εἶπεν",705373,2],["ποιήσω",710582,165],["ἐμαυτῷ",704545,50],["ὄνομα",709666,25],["καὶ",707031,7],["δοξασθήσομαι",703792,180],["ἐν",704639,0],["τῇ",709436,100],["βασιλείᾳ",702577,1],["καὶ",707031,7],["πολεμήσω",710601,165],["τὸν",709436,5],["Ιουδαν",706775,6],["καὶ",707031,7],["τοὺς",709436,58],["σὺν",712372,0],["αὐτῷ",702165,50],["τοὺς",709436,58],["ἐξουδενοῦντας",704969,235],["τὸν",709436,5],["λόγον",708236,6],["τοῦ",709436,35],["βασιλέως",702580,18]],"he said, I will get me a name and honour in the kingdom; for I will go fight with Judas and them that are with him, who despise the king's commandment."],["15",[["καὶ",707031,7],["προσέθετο",710965,23],["καὶ",707031,7],["ἀνέβη",700905,2],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["παρεμβολὴ",710133,12],["ἀσεβῶν",701909,169],["ἰσχυρὰ",706855,29],["βοηθῆσαι",702746,106],["αὐτῷ",702165,50],["ποιῆσαι",710582,106],["τὴν",709436,8],["ἐκδίκησιν",704175,9],["ἐν",704639,0],["υἱοῖς",713075,148],["Ισραηλ",706839,18]],"So he made him ready to go up, and there went with him a mighty host of the ungodly to help him, and to be avenged of the children of Israel."],["16",[["καὶ",707031,7],["ἤγγισεν",703939,2],["ἕως",705792,7],["ἀναβάσεως",700907,17],["Βαιθωρων",702442,118],["καὶ",707031,7],["ἐξῆλθεν",704909,2],["Ιουδας",706775,4],["εἰς",704105,0],["συνάντησιν",712397,9],["αὐτῷ",702165,50],["ὀλιγοστός",709569,14]],"And when he came near to the going up of Bethhoron, Judas went forth to meet him with a small company:"],["17",[["ὡς",714148,7],["δὲ",703303,11],["εἶδον",709725,150],["τὴν",709436,8],["παρεμβολὴν",710133,9],["ἐρχομένην",705453,173],["εἰς",704105,0],["συνάντησιν",712397,9],["αὐτῶν",702165,40],["εἶπον",705373,150],["τῷ",709436,113],["Ιουδα",706775,114],["τί",712867,273],["δυνησόμεθα",703838,141],["ὀλιγοστοὶ",709569,138],["ὄντες",704093,146],["πολεμῆσαι",710601,106],["πρὸς",710844,0],["πλῆθος",710529,25],["τοσοῦτο",712907,129],["ἰσχυρόν",706855,46],["καὶ",707031,7],["ἡμεῖς",705983,219],["ἐκλελύμεθα",704254,580],["ἀσιτοῦντες",701959,146],["σήμερον",711751,28]],"who, when they saw the host coming to meet them, said unto Judas, How shall we be able, being so few, to fight against so great a multitude [and] so strong, seeing we are ready to faint with fasting all this day?"],["18",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιουδας",706775,4],["εὔκοπόν",705622,26],["ἐστιν",704093,91],["συγκλεισθῆναι",712223,179],["πολλοὺς",710646,60],["ἐν",704639,0],["χερσὶν",713787,76],["ὀλίγων",709568,169],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["διαφορὰ",703630,12],["ἐναντίον",704654,0],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["σῴζειν",712627,55],["ἐν",704639,0],["πολλοῖς",710646,230],["ἢ",705924,7],["ἐν",704639,0],["ὀλίγοις",709568,230]],"Unto whom Judas answered, It is no hard matter for many to be shut up in the hands of a few; and with [the God of] heaven it is all one, to deliver with a great multitude, or a small company;"],["19",[["ὅτι",709803,7],["οὐκ",709805,28],["ἐν",704639,0],["πλήθει",710529,54],["δυνάμεως",703839,17],["νίκη",709310,12],["πολέμου",710605,18],["ἐστίν",704093,91],["ἀλλ᾿",700680,7],["ἐκ",704132,0],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["ἡ",709436,10],["ἰσχύς",706858,12]],"for the victory of battle standeth not in the multitude of an host; but strength cometh from heaven."],["20",[["αὐτοὶ",702165,201],["ἔρχονται",705453,269],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["ἐν",704639,0],["πλήθει",710529,54],["ὕβρεως",713051,17],["καὶ",707031,7],["ἀνομίας",701192,17],["τοῦ",709436,20],["ἐξᾶραι",704839,106],["ἡμᾶς",705981,194],["καὶ",707031,7],["τὰς",709436,38],["γυναῖκας",703209,39],["ἡμῶν",705999,145],["καὶ",707031,7],["τὰ",709436,41],["τέκνα",712761,42],["ἡμῶν",705999,145],["τοῦ",709436,20],["σκυλεῦσαι",711900,106],["ἡμᾶς",705981,194]],"They come against us in much pride and iniquity to destroy us, and our wives and children, and to spoil us:"],["21",[["ἡμεῖς",705983,219],["δὲ",703303,11],["πολεμοῦμεν",710601,243],["περὶ",710285,0],["τῶν",709436,130],["ψυχῶν",714070,65],["ἡμῶν",705999,145],["καὶ",707031,7],["τῶν",709436,80],["νομίμων",709340,169],["ἡμῶν",705999,145]],"but we fight for our lives and our laws."],["22",[["καὶ",707031,7],["αὐτὸς",702165,121],["συντρίψει",712520,127],["αὐτοὺς",702165,62],["πρὸ",710747,0],["προσώπου",710986,21],["ἡμῶν",705999,145],["ὑμεῖς",713081,219],["δὲ",703303,11],["μὴ",708851,28],["φοβεῖσθε",713532,374],["ἀπ᾿",701425,0],["αὐτῶν",702165,40]],"Wherefore the Lord himself will overthrow them before our face: and as for you, be ye not afraid of them."],["23",[["ὡς",714148,7],["δὲ",703303,11],["ἐπαύσατο",710202,23],["λαλῶν",708071,72],["ἐνήλατο",704652,19],["εἰς",704105,0],["αὐτοὺς",702165,62],["ἄφνω",702215,28],["καὶ",707031,7],["συνετρίβη",712520,37],["Σήρων",711755,4],["καὶ",707031,7],["ἡ",709436,10],["παρεμβολὴ",710133,12],["αὐτοῦ",702165,102],["ἐνώπιον",704823,28],["αὐτοῦ",702165,102]],"Now as soon as he had left off speaking, he leaped suddenly upon them, and so Seron and his host were overthrown before him."],["24",[["καὶ",707031,7],["ἐδίωκον",703768,137],["αὐτὸν",702165,85],["ἐν",704639,0],["τῇ",709436,100],["καταβάσει",707206,1],["Βαιθωρων",702442,118],["ἕως",705792,28],["τοῦ",709436,20],["πεδίου",710215,21],["καὶ",707031,7],["ἔπεσον",710481,150],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["εἰς",704105,0],["ἄνδρας",701150,57],["ὀκτακοσίους",709553,60],["οἱ",709436,136],["δὲ",703303,11],["λοιποὶ",708248,138],["ἔφυγον",713433,150],["εἰς",704105,0],["γῆν",703083,9],["Φυλιστιιμ",713621,81]],"And they pursued them from the going down of Bethhoron unto the plain, where were slain about eight hundred men of them; and the residue fled into the land of the Philistines."],["25",[["καὶ",707031,7],["ἤρξατο",701860,23],["ὁ",709436,3],["φόβος",713534,4],["Ιουδου",706775,18],["καὶ",707031,7],["τῶν",709436,80],["ἀδελφῶν",700249,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἡ",709436,10],["πτόη",711063,12],["ἐπέπιπτεν",705225,13],["ἐπὶ",705080,0],["τὰ",709436,41],["ἔθνη",704068,42],["τὰ",709436,41],["κύκλῳ",707959,114],["αὐτῶν",702165,40]],"Then began the fear of Judas and his brethren, and exceeding great dread, to fall upon the nations round about them:"],["26",[["καὶ",707031,7],["ἤγγισεν",703939,2],["ἕως",705792,28],["τοῦ",709436,35],["βασιλέως",702580,18],["τὸ",709436,34],["ὄνομα",709666,15],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὑπὲρ",713111,0],["τῶν",709436,80],["παρατάξεων",710107,81],["Ιουδου",706775,18],["ἐξηγεῖτο",704918,19],["τὰ",709436,63],["ἔθνη",704068,64]],"insomuch as his fame came unto the king, and all nations talked of the battles of Judas."],["27",[["ὡς",714148,7],["δὲ",703303,11],["ἤκουσεν",700587,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["Ἀντίοχος",701257,4],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["ὠργίσθη",709729,37],["θυμῷ",706334,114],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["καὶ",707031,7],["συνήγαγεν",712375,2],["τὰς",709436,38],["δυνάμεις",703839,39],["πάσας",710177,119],["τῆς",709436,16],["βασιλείας",702577,17],["αὐτοῦ",702165,102],["παρεμβολὴν",710133,9],["ἰσχυρὰν",706855,36],["σφόδρα",712586,28]],"Now when king Antiochus heard these things, he was full of indignation: wherefore he sent and gathered together all the forces of his realm, [even] a very strong army."],["28",[["καὶ",707031,7],["ἤνοιξεν",701186,2],["τὸ",709436,24],["γαζοφυλάκιον",702896,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔδωκεν",703654,2],["ὀψώνια",709906,42],["ταῖς",709436,75],["δυνάμεσιν",703839,76],["εἰς",704105,0],["ἐνιαυτὸν",704745,6],["καὶ",707031,7],["ἐνετείλατο",704791,23],["αὐτοῖς",702165,151],["εἶναι",704093,55],["ἑτοίμους",705541,60],["εἰς",704105,0],["πᾶσαν",710177,36],["χρείαν",713938,9]],"He opened also his treasure, and gave his soldiers pay for a year, commanding them to be ready whensoever he should need them."],["29",[["καὶ",707031,7],["εἶδεν",709725,2],["ὅτι",709803,7],["ἐξέλιπεν",704237,2],["τὸ",709436,24],["ἀργύριον",701707,25],["ἐκ",704132,0],["τῶν",709436,80],["θησαυρῶν",706258,81],["καὶ",707031,7],["οἱ",709436,136],["φόροι",713561,52],["τῆς",709436,16],["χώρας",714011,17],["ὀλίγοι",709568,138],["χάριν",713735,9],["τῆς",709436,16],["διχοστασίας",703759,17],["καὶ",707031,7],["πληγῆς",710527,17],["ἧς",709781,167],["κατεσκεύασεν",707419,2],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["τοῦ",709436,20],["ἆραι",700473,106],["τὰ",709436,41],["νόμιμα",709340,68],["ἃ",709781,69],["ἦσαν",704093,137],["ἀφ᾿",701425,0],["ἡμερῶν",705984,65],["τῶν",709436,130],["πρώτων",711041,665]],"Nevertheless, when he saw that the money of his treasures failed, and that the tributes in the country were small, because of the dissension and plague, which he had brought upon the land in taking away the laws which had been of old time;"],["30",[["καὶ",707031,7],["εὐλαβήθη",705627,37],["μὴ",708851,28],["οὐκ",709805,28],["ἔχῃ",705785,204],["ὡς",714148,7],["ἅπαξ",701350,28],["καὶ",707031,7],["δὶς",703741,28],["εἰς",704105,0],["τὰς",709436,38],["δαπάνας",703287,39],["καὶ",707031,7],["τὰ",709436,41],["δόματα",703789,42],["ἃ",709781,69],["ἐδίδου",703654,13],["ἔμπροσθεν",704618,28],["δαψιλῇ",703302,101],["χειρὶ",713787,1],["καὶ",707031,7],["ἐπερίσσευσεν",710386,2],["ὑπὲρ",713111,0],["τοὺς",709436,58],["βασιλεῖς",702580,57],["τοὺς",709436,58],["ἔμπροσθεν",704618,28]],"he feared that he should not be able to bear the charges any longer, nor to have such gifts to give so liberally as he did before: for he had abounded above the kings that were before him."],["31",[["καὶ",707031,7],["ἠπορεῖτο",701559,19],["τῇ",709436,100],["ψυχῇ",714070,1],["αὐτοῦ",702165,102],["σφόδρα",712586,28],["καὶ",707031,7],["ἐβουλεύσατο",702791,23],["τοῦ",709436,20],["πορευθῆναι",710667,179],["εἰς",704105,0],["τὴν",709436,8],["Περσίδα",710431,9],["καὶ",707031,7],["λαβεῖν",708076,106],["τοὺς",709436,58],["φόρους",713561,57],["τῶν",709436,130],["χωρῶν",714011,65],["καὶ",707031,7],["συναγαγεῖν",712375,106],["ἀργύριον",701707,25],["πολύ",710646,46]],"Wherefore, being greatly perplexed in his mind, he determined to go into Persia, there to take the tributes of the countries, and to gather much money."],["32",[["καὶ",707031,7],["κατέλιπεν",707305,2],["Λυσίαν",708275,6],["ἄνθρωπον",701163,6],["ἔνδοξον",704694,27],["καὶ",707031,7],["ἀπὸ",701425,0],["γένους",703057,21],["τῆς",709436,16],["βασιλείας",702577,17],["ἐπὶ",705080,0],["τῶν",709436,43],["πραγμάτων",710708,44],["τοῦ",709436,35],["βασιλέως",702580,18],["ἀπὸ",701425,0],["τοῦ",709436,35],["ποταμοῦ",710693,18],["Εὐφράτου",705716,18],["καὶ",707031,7],["ἕως",705792,28],["ὁρίων",709749,44],["Αἰγύπτου",700401,17]],"So he left Lysias, a nobleman, and one of the blood royal, to oversee the affairs of the king from the river Euphrates unto the borders of Egypt:"],["33",[["καὶ",707031,7],["τρέφειν",712930,55],["Ἀντίοχον",701257,6],["τὸν",709436,5],["υἱὸν",713075,6],["αὐτοῦ",702165,102],["ἕως",705792,28],["τοῦ",709436,20],["ἐπιστρέψαι",705278,106],["αὐτόν",702165,85]],"and to bring up his son Antiochus, until he came again."],["34",[["καὶ",707031,7],["παρέδωκεν",710014,2],["αὐτῷ",702165,50],["τὰς",709436,38],["ἡμίσεις",705998,119],["τῶν",709436,130],["δυνάμεων",703839,65],["καὶ",707031,7],["τοὺς",709436,58],["ἐλέφαντας",704438,57],["καὶ",707031,7],["ἐνετείλατο",704791,23],["αὐτῷ",702165,50],["περὶ",710285,0],["πάντων",710177,169],["ὧν",709781,252],["ἠβούλετο",702795,19],["καὶ",707031,7],["περὶ",710285,0],["τῶν",709436,80],["κατοικούντων",707534,170],["τὴν",709436,8],["Ιουδαίαν",706769,9],["καὶ",707031,7],["Ιερουσαλημ",706644,9]],"Moreover he delivered unto him the half of his forces, and the elephants, and gave him charge of all things that he would have done, as also concerning them that dwelt in Juda and Jerusalem;"],["35",[["ἀποστεῖλαι",701592,106],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["δύναμιν",703839,9],["τοῦ",709436,20],["ἐκτρῖψαι",704345,106],["καὶ",707031,7],["ἐξᾶραι",704839,106],["τὴν",709436,8],["ἰσχὺν",706858,9],["Ισραηλ",706839,18],["καὶ",707031,7],["τὸ",709436,24],["κατάλειμμα",707304,25],["Ιερουσαλημ",706644,17],["καὶ",707031,7],["ἆραι",700473,106],["τὸ",709436,24],["μνημόσυνον",708966,25],["αὐτῶν",702165,40],["ἀπὸ",701425,0],["τοῦ",709436,35],["τόπου",712903,18]],"[to wit], that he should send an army against them, to destroy and root out the strength of Israel, and the remnant of Jerusalem, and to take away their memorial from that place;"],["36",[["καὶ",707031,7],["κατοικίσαι",707538,106],["υἱοὺς",713075,57],["ἀλλογενεῖς",700690,60],["ἐν",704639,0],["πᾶσιν",710177,94],["τοῖς",709436,95],["ὁρίοις",709749,96],["αὐτῶν",702165,40],["καὶ",707031,7],["κατακληροδοτῆσαι",707273,106],["τὴν",709436,8],["γῆν",703083,9],["αὐτῶν",702165,40]],"and that he should place strangers in all their quarters, and divide their land by lot."],["37",[["καὶ",707031,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["παρέλαβεν",710059,2],["τὰς",709436,38],["ἡμίσεις",705998,119],["τῶν",709436,130],["δυνάμεων",703839,65],["τὰς",709436,38],["καταλειφθείσας",707305,535],["καὶ",707031,7],["ἀπῆρεν",701329,2],["ἀπὸ",701425,0],["Ἀντιοχείας",701252,17],["ἀπὸ",701425,0],["πόλεως",710612,17],["βασιλείας",702577,17],["αὐτοῦ",702165,102],["ἔτους",705543,21],["ἑβδόμου",703925,92],["καὶ",707031,7],["τεσσαρακοστοῦ",712807,92],["καὶ",707031,7],["ἑκατοστοῦ",704143,92],["καὶ",707031,7],["διεπέρασεν",703543,2],["τὸν",709436,5],["Εὐφράτην",705716,6],["ποταμὸν",710693,6],["καὶ",707031,7],["διεπορεύετο",703551,19],["τὰς",709436,38],["ἐπάνω",705030,28],["χώρας",714011,39]],"So the king took the half of the forces that remained, and departed from Antioch, his royal city, the hundred forty and seventh year; and he passed the river Euphrates, and went through the high countries."],["38",[["καὶ",707031,7],["ἐπέλεξεν",705188,2],["Λυσίας",708275,4],["Πτολεμαῖον",711066,6],["τὸν",709436,5],["Δορυμένους",703805,18],["καὶ",707031,7],["Νικάνορα",709308,6],["καὶ",707031,7],["Γοργίαν",703174,6],["ἄνδρας",701150,57],["δυνατοὺς",703845,60],["τῶν",709436,80],["φίλων",713492,169],["τοῦ",709436,35],["βασιλέως",702580,18]],"Then Lysias chose Ptolemee the [son] of Dorymenes, and Nicanor, and Gorgias, mighty men of the king's friends:"],["39",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["μετ᾿",708780,0],["αὐτῶν",702165,40],["τεσσαράκοντα",712806,59],["χιλιάδας",713858,39],["ἀνδρῶν",701150,81],["καὶ",707031,7],["ἑπτακισχιλίαν",705364,36],["ἵππον",706790,9],["τοῦ",709436,20],["ἐλθεῖν",705453,106],["εἰς",704105,0],["γῆν",703083,9],["Ιουδα",706768,18],["καὶ",707031,7],["καταφθεῖραι",707474,106],["αὐτὴν",702165,104],["κατὰ",707200,0],["τὸν",709436,5],["λόγον",708236,6],["τοῦ",709436,35],["βασιλέως",702580,18]],"and with them he sent forty thousand footmen, and seven thousand horsemen, to go into the land of Juda, and to destroy it, as the king commanded."],["40",[["καὶ",707031,7],["ἀπῆρεν",701329,2],["σὺν",712372,0],["πάσῃ",710177,101],["τῇ",709436,100],["δυνάμει",703839,1],["αὐτῶν",702165,40],["καὶ",707031,7],["ἦλθον",705453,150],["καὶ",707031,7],["παρενέβαλον",710132,150],["πλησίον",710547,28],["Αμμαους",700841,6],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["τῇ",709436,100],["πεδινῇ",710214,101]],"So they went forth with all their power, and came and pitched by Emmaus in the plain country."],["41",[["καὶ",707031,7],["ἤκουσαν",700587,150],["οἱ",709436,136],["ἔμποροι",704614,52],["τῆς",709436,16],["χώρας",714011,17],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτῶν",702165,40],["καὶ",707031,7],["ἔλαβον",708076,150],["ἀργύριον",701707,25],["καὶ",707031,7],["χρυσίον",713972,25],["πολὺ",710646,46],["σφόδρα",712586,28],["καὶ",707031,7],["πέδας",710210,39],["καὶ",707031,7],["ἦλθον",705453,150],["εἰς",704105,0],["τὴν",709436,8],["παρεμβολὴν",710133,9],["τοῦ",709436,20],["λαβεῖν",708076,106],["τοὺς",709436,58],["υἱοὺς",713075,57],["Ισραηλ",706839,18],["εἰς",704105,0],["παῖδας",709932,57],["καὶ",707031,7],["προσετέθησαν",710965,99],["πρὸς",710844,0],["αὐτοὺς",702165,62],["δύναμις",703839,12],["Συρίας",712533,17],["καὶ",707031,7],["γῆς",703083,17],["ἀλλοφύλων",700706,169]],"And the merchants of the country, hearing the fame of them, took silver and gold very much, with servants, and came into the camp to buy the children of Israel for slaves: a power also of Syria and of the land of the Philistines joined themselves unto them."],["42",[["καὶ",707031,7],["εἶδεν",709725,2],["Ιουδας",706775,4],["καὶ",707031,7],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["αὐτοῦ",702165,102],["ὅτι",709803,7],["ἐπληθύνθη",710530,37],["τὰ",709436,63],["κακὰ",707066,195],["καὶ",707031,7],["αἱ",709436,190],["δυνάμεις",703839,191],["παρεμβάλλουσιν",710132,197],["ἐν",704639,0],["τοῖς",709436,95],["ὁρίοις",709749,96],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπέγνωσαν",705104,150],["τοὺς",709436,58],["λόγους",708236,57],["τοῦ",709436,35],["βασιλέως",702580,18],["οὓς",709781,298],["ἐνετείλατο",704791,23],["ποιῆσαι",710582,106],["τῷ",709436,113],["λαῷ",708094,114],["εἰς",704105,0],["ἀπώλειαν",701660,9],["καὶ",707031,7],["συντέλειαν",712509,9]],"Now when Judas and his brethren saw that miseries were multiplied, and that the forces did encamp themselves in their borders; for they knew how the king had given commandment to destroy the people, and utterly abolish them;"],["43",[["καὶ",707031,7],["εἶπαν",705373,150],["ἕκαστος",704133,14],["πρὸς",710844,0],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102],["ἀναστήσωμεν",701173,79],["τὴν",709436,8],["καθαίρεσιν",706981,9],["τοῦ",709436,35],["λαοῦ",708094,18],["ἡμῶν",705999,145],["καὶ",707031,7],["πολεμήσωμεν",710601,79],["περὶ",710285,0],["τοῦ",709436,35],["λαοῦ",708094,18],["ἡμῶν",705999,145],["καὶ",707031,7],["τῶν",709436,80],["ἁγίων",700159,169]],"they said one to another, Let us restore the decayed estate of our people, and let us fight for our people and the sanctuary."],["44",[["καὶ",707031,7],["ἠθροίσθη",700384,37],["ἡ",709436,10],["συναγωγὴ",712376,12],["τοῦ",709436,20],["εἶναι",704093,55],["ἑτοίμους",705541,60],["εἰς",704105,0],["πόλεμον",710605,6],["καὶ",707031,7],["τοῦ",709436,20],["προσεύξασθαι",710893,109],["καὶ",707031,7],["αἰτῆσαι",700489,106],["ἔλεος",704426,25],["καὶ",707031,7],["οἰκτιρμούς",709520,57]],"Then the congregation gathered together, that they might be ready for battle, and that they might pray, and ask mercy and compassion."],["45",[["καὶ",707031,7],["Ιερουσαλημ",706644,12],["ἦν",704093,13],["ἀοίκητος",701315,14],["ὡς",714148,7],["ἔρημος",705420,12],["οὐκ",709805,28],["ἦν",704093,13],["ὁ",709436,3],["εἰσπορευόμενος",704124,122],["καὶ",707031,7],["ἐκπορευόμενος",704293,122],["ἐκ",704132,0],["τῶν",709436,43],["γενημάτων",703052,44],["αὐτῆς",702165,86],["καὶ",707031,7],["τὸ",709436,34],["ἁγίασμα",700154,15],["καταπατούμενον",707360,644],["καὶ",707031,7],["υἱοὶ",713075,52],["ἀλλογενῶν",700690,169],["ἐν",704639,0],["τῇ",709436,100],["ἄκρᾳ",700588,1],["κατάλυμα",707320,25],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["καὶ",707031,7],["ἐξήρθη",704839,37],["τέρψις",712805,12],["ἐξ",704132,0],["Ιακωβ",706401,18],["καὶ",707031,7],["ἐξέλιπεν",704237,2],["αὐλὸς",702139,4],["καὶ",707031,7],["κινύρα",707684,12]],"Now Jerusalem was laid void as a wilderness, there was none of her children that went in or out: the sanctuary also was trodden down, and aliens kept the strong hold; the heathen had their habitation in that place; and joy was taken from Jacob, and the pipe with the harp ceased."],["46",[["καὶ",707031,7],["συνήχθησαν",712375,99],["καὶ",707031,7],["ἤλθοσαν",705453,150],["εἰς",704105,0],["Μασσηφα",708561,227],["κατέναντι",707507,28],["Ιερουσαλημ",706644,17],["ὅτι",709803,7],["τόπος",712903,4],["προσευχῆς",710892,17],["ἦν",704093,13],["ἐν",704639,0],["Μασσηφα",708561,111],["τὸ",709436,24],["πρότερον",710991,46],["τῷ",709436,113],["Ισραηλ",706839,114]],"Wherefore the Israelites assembled themselves together, and came to Maspha, over against Jerusalem; for in Maspha was the place where they prayed aforetime in Israel."],["47",[["καὶ",707031,7],["ἐνήστευσαν",709304,150],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["καὶ",707031,7],["περιεβάλοντο",710294,189],["σάκκους",711386,6],["καὶ",707031,7],["σποδὸν",