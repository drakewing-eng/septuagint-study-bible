[["1",[["καὶ",707031,7],["ἐν",704639,0],["ἔτει",705543,54],["δευτέρῳ",703389,97],["καὶ",707031,7],["ἑβδομηκοστῷ",703924,97],["καὶ",707031,7],["ἑκατοστῷ",704143,97],["συνήγαγεν",712375,2],["Δημήτριος",703407,4],["ὁ",709436,3],["βασιλεὺς",702580,4],["τὰς",709436,38],["δυνάμεις",703839,39],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπορεύθη",710667,37],["εἰς",704105,0],["Μηδίαν",708860,9],["τοῦ",709436,20],["ἐπισπάσασθαι",705258,109],["βοήθειαν",702745,9],["ἑαυτῷ",703917,50],["ὅπως",709719,7],["πολεμήσῃ",710601,123],["τὸν",709436,5],["Τρύφωνα",713010,6]],"Now in the hundred threescore and twelfth year king Demetrius gathered his forces together, and went into Media, to get him help to fight against Tryphon."],["2",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Ἀρσάκης",701816,4],["ὁ",709436,3],["βασιλεὺς",702580,4],["τῆς",709436,16],["Περσίδος",710431,17],["καὶ",707031,7],["Μηδίας",708860,17],["ὅτι",709803,7],["εἰσῆλθεν",704114,2],["Δημήτριος",703407,4],["εἰς",704105,0],["τὰ",709436,41],["ὅρια",709749,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἀπέστειλεν",701592,2],["ἕνα",704106,27],["τῶν",709436,80],["ἀρχόντων",701862,81],["αὐτοῦ",702165,102],["συλλαβεῖν",712262,106],["αὐτὸν",702165,85],["ζῶντα",705851,183]],"But when Arsaces, the king of Persia and Media, heard that Demetrius was entered within his borders, he sent one of his princes to take him alive:"],["3",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["καὶ",707031,7],["ἐπάταξεν",710185,2],["τὴν",709436,8],["παρεμβολὴν",710133,9],["Δημητρίου",703407,18],["καὶ",707031,7],["συνέλαβεν",712262,2],["αὐτὸν",702165,85],["καὶ",707031,7],["ἤγαγεν",700209,2],["αὐτὸν",702165,85],["πρὸς",710844,0],["Ἀρσάκην",701816,6],["καὶ",707031,7],["ἔθετο",712849,23],["αὐτὸν",702165,85],["ἐν",704639,0],["φυλακῇ",713613,1]],"who went and smote the host of Demetrius, and took him, and brought him to Arsaces, by whom he was put in ward."],["4",[["καὶ",707031,7],["ἡσύχασεν",706033,2],["ἡ",709436,10],["γῆ",703083,12],["Ιουδα",706768,18],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["Σιμωνος",711792,18],["καὶ",707031,7],["ἐζήτησεν",705879,2],["ἀγαθὰ",700106,68],["τῷ",709436,53],["ἔθνει",704068,54],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἤρεσεν",701722,2],["αὐτοῖς",702165,151],["ἡ",709436,10],["ἐξουσία",704974,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἡ",709436,10],["δόξα",703791,12],["αὐτοῦ",702165,102],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39]],"As for the land [of Judea], that was quiet all the days of Simon; for he sought the good of his nation in such wise, as that evermore his authority and honour pleased them well."],["5",[["καὶ",707031,7],["μετὰ",708780,0],["πάσης",710177,82],["τῆς",709436,16],["δόξης",703791,17],["αὐτοῦ",702165,102],["ἔλαβεν",708076,2],["τὴν",709436,8],["Ιοππην",706760,9],["εἰς",704105,0],["λιμένα",708207,6],["καὶ",707031,7],["ἐποίησεν",710582,2],["εἴσοδον",704119,9],["ταῖς",709436,75],["νήσοις",709302,76],["τῆς",709436,16],["θαλάσσης",706069,17]],"And as he was honourable in all his acts, so in this, that he took Joppe for an haven, and made an entrance to the isles of the sea,"],["6",[["καὶ",707031,7],["ἐπλάτυνεν",710508,13],["τὰ",709436,41],["ὅρια",709749,42],["τῷ",709436,53],["ἔθνει",704068,54],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐκράτησεν",707879,2],["τῆς",709436,16],["χώρας",714011,17]],"and enlarged the bounds of his nation, and recovered the country,"],["7",[["καὶ",707031,7],["συνήγαγεν",712375,2],["αἰχμαλωσίαν",700499,9],["πολλὴν",710646,36],["καὶ",707031,7],["ἐκυρίευσεν",707995,2],["Γαζαρων",702887,286],["καὶ",707031,7],["Βαιθσουρων",702436,286],["καὶ",707031,7],["τῆς",709436,16],["ἄκρας",700588,17],["καὶ",707031,7],["ἐξῆρεν",704839,2],["τὰς",709436,38],["ἀκαθαρσίας",700507,39],["ἐξ",704132,0],["αὐτῆς",702165,86],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ὁ",709436,3],["ἀντικείμενος",701240,122],["αὐτῷ",702165,50]],"and gathered together a great number of captives, and had the dominion of Gazara, and Bethsura, and the tower, out of the which he took all uncleanness, neither was there any that resisted him."],["8",[["καὶ",707031,7],["ἦσαν",704093,137],["γεωργοῦντες",703079,146],["τὴν",709436,8],["γῆν",703083,9],["αὐτῶν",702165,40],["μετ᾿",708780,0],["εἰρήνης",704098,17],["καὶ",707031,7],["ἡ",709436,10],["γῆ",703083,12],["ἐδίδου",703654,13],["τὰ",709436,41],["γενήματα",703052,42],["αὐτῆς",702165,86],["καὶ",707031,7],["τὰ",709436,41],["ξύλα",709427,42],["τῶν",709436,43],["πεδίων",710215,44],["τὸν",709436,5],["καρπὸν",707169,6],["αὐτῶν",702165,40]],"Then did they till their ground in peace, and the earth gave her increase, and the trees of the field their fruit."],["9",[["πρεσβύτεροι",710735,52],["ἐν",704639,0],["ταῖς",709436,75],["πλατείαις",710509,291],["ἐκάθηντο",707000,139],["πάντες",710177,138],["περὶ",710285,0],["ἀγαθῶν",700106,169],["ἐκοινολογοῦντο",707770,139],["καὶ",707031,7],["οἱ",709436,136],["νεανίσκοι",709232,52],["ἐνεδύσαντο",704701,189],["δόξας",703791,39],["καὶ",707031,7],["στολὰς",712120,39],["πολέμου",710605,18]],"The ancient men sat all in the streets, communing together of good things, and the young men put on glorious and warlike apparel."],["10",[["ταῖς",709436,75],["πόλεσιν",710612,76],["ἐχορήγησεν",713911,2],["βρώματα",702823,42],["καὶ",707031,7],["ἔταξεν",712730,2],["αὐτὰς",702165,231],["ἐν",704639,0],["σκεύεσιν",711844,96],["ὀχυρώσεως",709893,17],["ἕως",705792,28],["ὅτου",709793,581],["ὠνομάσθη",709667,37],["τὸ",709436,34],["ὄνομα",709666,15],["τῆς",709436,16],["δόξης",703791,17],["αὐτοῦ",702165,102],["ἕως",705792,28],["ἄκρου",700608,116],["γῆς",703083,17]],"He provided victuals for the cities, and set in them all manner of munition, so that his honourable name was renowned unto the end of the world."],["11",[["ἐποίησεν",710582,2],["εἰρήνην",704098,9],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["εὐφράνθη",705715,37],["Ισραηλ",706839,4],["εὐφροσύνην",705717,9],["μεγάλην",708653,36]],"He made peace in the land, and Israel rejoiced with great joy:"],["12",[["καὶ",707031,7],["ἐκάθισεν",707006,2],["ἕκαστος",704133,14],["ὑπὸ",713184,0],["τὴν",709436,8],["ἄμπελον",700870,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὴν",709436,8],["συκῆν",712254,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ὁ",709436,3],["ἐκφοβῶν",704360,72],["αὐτούς",702165,62]],"for every man sat under his vine and his fig tree, and there was none to fray them:"],["13",[["καὶ",707031,7],["ἐξέλιπεν",704237,2],["πολεμῶν",710605,81],["αὐτοὺς",702165,62],["ἐπὶ",705080,0],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["οἱ",709436,136],["βασιλεῖς",702580,52],["συνετρίβησαν",712520,99],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200]],"neither was there any left in the land to fight against them: yea, the kings themselves were overthrown in those days."],["14",[["καὶ",707031,7],["ἐστήρισεν",712098,2],["πάντας",710177,60],["τοὺς",709436,58],["ταπεινοὺς",712714,60],["τοῦ",709436,35],["λαοῦ",708094,18],["αὐτοῦ",702165,102],["τὸν",709436,5],["νόμον",709349,6],["ἐξεζήτησεν",704187,2],["καὶ",707031,7],["ἐξῆρεν",704839,2],["πάντα",710177,27],["ἄνομον",701194,27],["καὶ",707031,7],["πονηρόν",710660,27]],"Moreover he strengthened all those of his people that were brought low: the law he searched out; and every contemner of the law and wicked person he took away."],["15",[["τὰ",709436,41],["ἅγια",700159,68],["ἐδόξασεν",703792,2],["καὶ",707031,7],["ἐπλήθυνεν",710530,13],["τὰ",709436,41],["σκεύη",711844,42],["τῶν",709436,80],["ἁγίων",700159,169]],"He beautified the sanctuary, and multiplied the vessels of the temple."],["16",[["καὶ",707031,7],["ἠκούσθη",700587,37],["ἐν",704639,0],["Ῥώμῃ",711322,1],["ὅτι",709803,7],["ἀπέθανεν",701461,2],["Ιωναθαν",706927,4],["καὶ",707031,7],["ἕως",705792,28],["Σπάρτης",711997,17],["καὶ",707031,7],["ἐλυπήθησαν",708272,99],["σφόδρα",712586,28]],"Now when it was heard at Rome, and as far as Sparta, that Jonathan was dead, they were very sorry."],["17",[["ὡς",714148,7],["δὲ",703303,11],["ἤκουσαν",700587,150],["ὅτι",709803,7],["Σιμων",711792,4],["ὁ",709436,3],["ἀδελφὸς",700249,4],["αὐτοῦ",702165,102],["γέγονεν",703104,171],["ἀρχιερεὺς",701845,4],["ἀντ᾿",701227,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["αὐτὸς",702165,121],["ἐπικρατεῖ",705176,91],["τῆς",709436,16],["χώρας",714011,17],["καὶ",707031,7],["τῶν",709436,130],["πόλεων",710612,65],["τῶν",709436,80],["ἐν",704639,0],["αὐτῇ",702165,105]],"But as soon as they heard that his brother Simon was made high priest in his stead, and ruled the country, and the cities therein:"],["18",[["ἔγραψαν",703194,150],["πρὸς",710844,0],["αὐτὸν",702165,85],["δέλτοις",703350,76],["χαλκαῖς",713690,291],["τοῦ",709436,20],["ἀνανεώσασθαι",701011,109],["πρὸς",710844,0],["αὐτὸν",702165,85],["φιλίαν",713474,9],["καὶ",707031,7],["συμμαχίαν",712299,9],["ἣν",709781,131],["ἔστησαν",706846,150],["πρὸς",710844,0],["Ιουδαν",706775,6],["καὶ",707031,7],["Ιωναθαν",706927,6],["τοὺς",709436,58],["ἀδελφοὺς",700249,57],["αὐτοῦ",702165,102]],"they wrote unto him in tables of brass, to renew the friendship and league which they had made with Judas and Jonathan his brethren:"],["19",[["καὶ",707031,7],["ἀνεγνώσθησαν",700922,99],["ἐνώπιον",704823,0],["τῆς",709436,16],["ἐκκλησίας",704216,17],["ἐν",704639,0],["Ιερουσαλημ",706644,1]],"which writings were read before the congregation at Jerusalem."],["20",[["καὶ",707031,7],["τοῦτο",709858,132],["τὸ",709436,34],["ἀντίγραφον",701229,15],["τῶν",709436,130],["ἐπιστολῶν",705272,65],["ὧν",709781,199],["ἀπέστειλαν",701592,150],["οἱ",709436,136],["Σπαρτιᾶται",711998,52],["Σπαρτιατῶν",711998,81],["ἄρχοντες",701862,52],["καὶ",707031,7],["ἡ",709436,10],["πόλις",710612,12],["Σιμωνι",711792,114],["ἱερεῖ",706614,114],["μεγάλῳ",708653,30],["καὶ",707031,7],["τοῖς",709436,147],["πρεσβυτέροις",710735,148],["καὶ",707031,7],["τοῖς",709436,147],["ἱερεῦσιν",706614,148],["καὶ",707031,7],["τῷ",709436,113],["λοιπῷ",708247,30],["δήμῳ",703411,114],["τῶν",709436,80],["Ιουδαίων",706772,81],["ἀδελφοῖς",700249,148],["χαίρειν",713665,55]],"And this is the copy of the letters that the Lacedemonians sent; The rulers of the Lacedemonians, with the city, unto Simon the high priest, and the elders, and priests, and residue of the people of the Jews, our brethren, [send] greeting:"],["21",[["οἱ",709436,136],["πρεσβευταὶ",710731,52],["οἱ",709436,136],["ἀποσταλέντες",701592,247],["πρὸς",710844,0],["τὸν",709436,5],["δῆμον",703411,6],["ἡμῶν",705999,145],["ἀπήγγειλαν",701321,150],["ἡμῖν",705994,90],["περὶ",710285,0],["τῆς",709436,16],["δόξης",703791,17],["ὑμῶν",713091,145],["καὶ",707031,7],["τιμῆς",712856,17],["καὶ",707031,7],["ηὐφράνθημεν",705715,485],["ἐπὶ",705080,0],["τῇ",709436,100],["ἐφόδῳ",705760,1],["αὐτῶν",702165,40]],"The ambassadors that were sent unto our people certified us of your glory and honour: wherefore we were glad of their coming,"],["22",[["καὶ",707031,7],["ἀνεγράψαμεν",700932,289],["τὰ",709436,41],["ὑπ᾿",713184,0],["αὐτῶν",702165,40],["εἰρημένα",705415,388],["ἐν",704639,0],["ταῖς",709436,75],["βουλαῖς",702792,76],["τοῦ",709436,35],["δήμου",703411,18],["οὕτως",709859,28],["Νουμήνιος",709372,4],["Ἀντιόχου",701257,18],["καὶ",707031,7],["Ἀντίπατρος",701264,4],["Ἰάσονος",706454,18],["πρεσβευταὶ",710731,52],["Ιουδαίων",706772,81],["ἦλθον",705453,150],["πρὸς",710844,0],["ἡμᾶς",705981,194],["ἀνανεούμενοι",701011,348],["τὴν",709436,8],["πρὸς",710844,0],["ἡμᾶς",705981,194],["φιλίαν",713474,9]],"and did register the things that they spake in the council of the people in this manner; Numenius [son] of Antiochus, and Antipater [son] of Jason, the Jews' ambassadors, came unto us, to renew the friendship they had with us."],["23",[["καὶ",707031,7],["ἤρεσεν",701722,2],["τῷ",709436,113],["δήμῳ",703411,114],["ἐπιδέξασθαι",705117,109],["τοὺς",709436,58],["ἄνδρας",701150,57],["ἐνδόξως",704695,28],["καὶ",707031,7],["τοῦ",709436,20],["θέσθαι",712849,109],["τὸ",709436,24],["ἀντίγραφον",701229,25],["τῶν",709436,80],["λόγων",708236,81],["αὐτῶν",702165,40],["ἐν",704639,0],["τοῖς",709436,147],["ἀποδεδειγμένοις",701438,521],["τῷ",709436,113],["δήμῳ",703411,114],["βιβλίοις",702719,96],["τοῦ",709436,20],["μνημόσυνον",708966,25],["ἔχειν",705785,55],["τὸν",709436,5],["δῆμον",703411,6],["τῶν",709436,80],["Σπαρτιατῶν",711998,81],["τὸ",709436,24],["δὲ",703303,11],["ἀντίγραφον",701229,25],["τούτων",709858,40],["ἔγραψαν",703194,150],["Σιμωνι",711792,114],["τῷ",709436,113],["ἀρχιερεῖ",701845,114]],"And it pleased the people to entertain the men honourably, and to put the copy of their ambassage in public records, to the end the people of the Lacedemonians might have a memorial thereof: furthermore we have written a copy thereof unto Simon the high priest."],["24",[["μετὰ",708780,0],["ταῦτα",709858,71],["ἀπέστειλεν",701592,2],["Σιμων",711792,4],["τὸν",709436,5],["Νουμήνιον",709372,6],["εἰς",704105,0],["Ῥώμην",711322,9],["ἔχοντα",705785,183],["ἀσπίδα",701991,9],["χρυσῆν",713971,36],["μεγάλην",708653,36],["ὁλκὴν",709583,9],["μνῶν",708959,65],["χιλίων",713859,198],["εἰς",704105,0],["τὸ",709436,24],["στῆσαι",706846,106],["πρὸς",710844,0],["αὐτοὺς",702165,62],["τὴν",709436,8],["συμμαχίαν",712299,9]],"After this Simon sent Numenius to Rome with a great shield of gold of a thousand pound weight, to confirm the league with them."],["25",[["ὡς",714148,7],["δὲ",703303,11],["ἤκουσεν",700587,2],["ὁ",709436,3],["δῆμος",703411,4],["τῶν",709436,80],["λόγων",708236,81],["τούτων",709858,40],["εἶπαν",705373,150],["τίνα",712867,648],["χάριν",713735,9],["ἀποδώσομεν",701449,275],["Σιμωνι",711792,114],["καὶ",707031,7],["τοῖς",709436,147],["υἱοῖς",713075,148],["αὐτοῦ",702165,102]],"Whereof when the people heard, they said, What thanks shall we give to Simon and his sons?"],["26",[["ἐστήρισεν",712098,2],["γὰρ",702963,11],["αὐτὸς",702165,121],["καὶ",707031,7],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὁ",709436,3],["οἶκος",709516,4],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπολέμησεν",710601,2],["τοὺς",709436,58],["ἐχθροὺς",705779,60],["Ισραηλ",706839,18],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["καὶ",707031,7],["ἔστησαν",706846,150],["αὐτῷ",702165,50],["ἐλευθερίαν",704427,9],["καὶ",707031,7],["κατέγραψαν",707231,150],["ἐν",704639,0],["δέλτοις",703350,76],["χαλκαῖς",713690,291],["καὶ",707031,7],["ἔθεντο",712849,189],["ἐν",704639,0],["στήλαις",712092,76],["ἐν",704639,0],["ὄρει",709768,54],["Σιων",711816,118]],"For he and his brethren and the house of his father have established Israel, and chased away in fight their enemies from them, and confirmed their liberty.",{"s":"d","q":0.64}],["27",[["καὶ",707031,7],["τοῦτο",709858,132],["τὸ",709436,34],["ἀντίγραφον",701229,15],["τῆς",709436,16],["γραφῆς",703191,17],["ὀκτωκαιδεκάτῃ",709557,101],["Ελουλ",704528,118],["ἔτους",705543,21],["δευτέρου",703389,92],["καὶ",707031,7],["ἑβδομηκοστοῦ",703924,92],["καὶ",707031,7],["ἑκατοστοῦ",704143,92],["καὶ",707031,7],["τοῦτο",709858,132],["τρίτον",712968,26],["ἔτος",705543,15],["ἐπὶ",705080,0],["Σιμωνος",711792,18],["ἀρχιερέως",701845,18],["μεγάλου",708653,116],["ἐν",704639,0],["ασαραμελ",701888,111]],"So then they wrote [it] in tables of brass, which they set upon pillars in mount Sion: and this is the copy of the writing; The eighteenth day of [the month] Elul, in the hundred threescore and twelfth year, being the third year of Simon the high priest,",{"s":"d","q":0.67}],["28",[["ἐπὶ",705080,0],["συναγωγῆς",712376,17],["μεγάλης",708653,82],["ἱερέων",706614,81],["καὶ",707031,7],["λαοῦ",708094,18],["καὶ",707031,7],["ἀρχόντων",701862,81],["ἔθνους",704068,21],["καὶ",707031,7],["τῶν",709436,80],["πρεσβυτέρων",710735,81],["τῆς",709436,16],["χώρας",714011,17],["ἐγνώρισεν",703135,2],["ἡμῖν",705994,90]],"at Saramel in the great congregation of the priests, and people, and rulers of the nation, and elders of the country, were these things notified unto us."],["29",[["ἐπεὶ",705054,7],["πολλάκις",710617,28],["ἐγενήθησαν",703104,99],["πόλεμοι",710605,52],["ἐν",704639,0],["τῇ",709436,100],["χώρᾳ",714011,1],["Σιμων",711792,4],["δὲ",703303,11],["υἱὸς",713075,4],["Ματταθιου",708585,18],["ἱερεὺς",706614,4],["τῶν",709436,80],["υἱῶν",713075,81],["Ιωαριβ",706894,118],["καὶ",707031,7],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["αὐτοῦ",702165,102],["ἔδωκαν",703654,150],["αὑτοὺς",703917,62],["τῷ",709436,113],["κινδύνῳ",707678,114],["καὶ",707031,7],["ἀντέστησαν",701154,150],["τοῖς",709436,147],["ὑπεναντίοις",713109,230],["τοῦ",709436,20],["ἔθνους",704068,21],["αὐτῶν",702165,40],["ὅπως",709719,7],["σταθῇ",706846,384],["τὰ",709436,63],["ἅγια",700159,195],["αὐτῶν",702165,40],["καὶ",707031,7],["ὁ",709436,3],["νόμος",709349,4],["καὶ",707031,7],["δόξῃ",703791,1],["μεγάλῃ",708653,101],["ἐδόξασαν",703792,150],["τὸ",709436,24],["ἔθνος",704068,25],["αὐτῶν",702165,40]],"Forasmuch as oftentimes there have been wars in the country, wherein for the maintenance of their sanctuary, and the law, Simon the son of Mattathias, of the posterity of Jarib, together with his brethren, put themselves in jeopardy, and resisting the enemies of their nation did their nation great honour:"],["30",[["καὶ",707031,7],["ἤθροισεν",700384,2],["Ιωναθαν",706927,4],["τὸ",709436,24],["ἔθνος",704068,25],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐγενήθη",703104,37],["αὐτοῖς",702165,151],["ἀρχιερεὺς",701845,4],["καὶ",707031,7],["προσετέθη",710965,37],["πρὸς",710844,0],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102]],"(For after that Jonathan, having gathered his nation together, and been their high priest, was added to his people,"],["31",[["καὶ",707031,7],["ἐβουλήθησαν",702795,99],["οἱ",709436,136],["ἐχθροὶ",705779,138],["αὐτῶν",702165,40],["ἐμβατεῦσαι",704548,106],["εἰς",704105,0],["τὴν",709436,8],["χώραν",714011,9],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐκτεῖναι",704322,106],["χεῖρας",713787,39],["ἐπὶ",705080,0],["τὰ",709436,41],["ἅγια",700159,68],["αὐτῶν",702165,40]],"their enemies purposed to invade their country, that they might destroy it, and lay hands on the sanctuary:"],["32",[["τότε",712908,28],["ἀντέστη",701154,2],["Σιμων",711792,4],["καὶ",707031,7],["ἐπολέμησε",710601,2],["περὶ",710285,0],["τοῦ",709436,20],["ἔθνους",704068,21],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐδαπάνησεν",703286,2],["χρήματα",713948,42],["πολλὰ",710646,68],["τῶν",709436,80],["ἑαυτοῦ",703917,102],["καὶ",707031,7],["ὁπλοδότησεν",709700,2],["τοὺς",709436,58],["ἄνδρας",701150,57],["τῆς",709436,16],["δυνάμεως",703839,17],["τοῦ",709436,20],["ἔθνους",704068,21],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτοῖς",702165,151],["ὀψώνια",709906,42]],"at which time Simon rose up, and fought for his nation, and spent much of his own substance, and armed the valiant men of his nation, and gave them wages,"],["33",[["καὶ",707031,7],["ὠχύρωσεν",709890,2],["τὰς",709436,38],["πόλεις",710612,39],["τῆς",709436,16],["Ιουδαίας",706769,17],["καὶ",707031,7],["τὴν",709436,8],["Βαιθσουραν",702436,9],["τὴν",709436,8],["ἐπὶ",705080,0],["τῶν",709436,43],["ὁρίων",709749,44],["τῆς",709436,16],["Ιουδαίας",706769,17],["οὗ",709781,48],["ἦν",704093,13],["τὰ",709436,63],["ὅπλα",709704,64],["τῶν",709436,80],["πολεμίων",710603,169],["τὸ",709436,24],["πρότερον",710991,46],["καὶ",707031,7],["ἔθετο",712849,23],["ἐκεῖ",704181,28],["φρουρὰν",713593,9],["ἄνδρας",701150,57],["Ιουδαίους",706772,57]],"and fortified the cities of Judea, together with Bethsura, that lieth upon the borders of Judea, where the armour of the enemies had been before; but he set a garrison of Jews there:"],["34",[["καὶ",707031,7],["Ιοππην",706760,9],["ὠχύρωσεν",709890,2],["τὴν",709436,8],["ἐπὶ",705080,0],["τῆς",709436,16],["θαλάσσης",706069,17],["καὶ",707031,7],["τὴν",709436,8],["Γαζαραν",702887,9],["τὴν",709436,8],["ἐπὶ",705080,0],["τῶν",709436,43],["ὁρίων",709749,44],["Ἀζώτου",700351,18],["ἐν",704639,0],["ᾗ",709781,108],["ᾤκουν",709499,137],["οἱ",709436,136],["πολέμιοι",710603,138],["τὸ",709436,24],["πρότερον",710991,46],["καὶ",707031,7],["κατῴκισεν",707534,2],["ἐκεῖ",704181,28],["Ιουδαίους",706772,57],["καὶ",707031,7],["ὅσα",709788,195],["ἐπιτήδεια",705300,195],["ἦν",704093,13],["πρὸς",710844,0],["τῇ",709436,100],["τούτων",709858,40],["ἐπανορθώσει",705029,1],["ἔθετο",712849,23],["ἐν",704639,0],["αὐτοῖς",702165,151]],"moreover he fortified Joppe, which lieth upon the sea, and Gazara, that bordereth upon Azotus, where the enemies had dwelt before: but he placed Jews there, and furnished them with all things convenient for the reparation thereof.)"],["35",[["καὶ",707031,7],["εἶδεν",709725,2],["ὁ",709436,3],["λαὸς",708094,4],["τὴν",709436,8],["πίστιν",710484,9],["τοῦ",709436,35],["Σιμωνος",711792,18],["καὶ",707031,7],["τὴν",709436,8],["δόξαν",703791,9],["ἣν",709781,131],["ἐβουλεύσατο",702791,23],["ποιῆσαι",710582,106],["τῷ",709436,53],["ἔθνει",704068,54],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔθεντο",712849,189],["αὐτὸν",702165,85],["ἡγούμενον",705931,212],["αὐτῶν",702165,40],["καὶ",707031,7],["ἀρχιερέα",701845,6],["διὰ",703417,0],["τὸ",709436,24],["αὐτὸν",702165,85],["πεποιηκέναι",710582,115],["πάντα",710177,68],["ταῦτα",709858,71],["καὶ",707031,7],["τὴν",709436,8],["δικαιοσύνην",703695,9],["καὶ",707031,7],["τὴν",709436,8],["πίστιν",710484,9],["ἣν",709781,131],["συνετήρησεν",712512,2],["τῷ",709436,53],["ἔθνει",704068,54],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐξεζήτησεν",704187,2],["παντὶ",710177,30],["τρόπῳ",712980,114],["ὑψῶσαι",713289,106],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102]],"The people therefore, seeing the acts of Simon, and unto what glory he thought to bring his nation, made him their governor and chief priest, because he had done all these things, and for the justice and faith which he kept to his nation, and for that he sought by all means to exalt his people."],["36",[["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["αὐτοῦ",702165,102],["εὐοδώθη",705654,37],["ἐν",704639,0],["ταῖς",709436,75],["χερσὶν",713787,76],["αὐτοῦ",702165,102],["τοῦ",709436,20],["ἐξαρθῆναι",704839,179],["τὰ",709436,41],["ἔθνη",704068,42],["ἐκ",704132,0],["τῆς",709436,16],["χώρας",714011,17],["αὐτῶν",702165,70],["καὶ",707031,7],["τοὺς",709436,58],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["Δαυιδ",703232,18],["τοὺς",709436,58],["ἐν",704639,0],["Ιερουσαλημ",706644,1],["οἳ",709781,250],["ἐποίησαν",710582,150],["αὑτοῖς",703917,151],["ἄκραν",700588,9],["ἐξ",704132,0],["ἧς",709781,167],["ἐξεπορεύοντο",704293,139],["καὶ",707031,7],["ἐμίαινον",708900,137],["κύκλῳ",707959,114],["τῶν",709436,80],["ἁγίων",700159,169],["καὶ",707031,7],["ἐποίουν",710582,137],["πληγὴν",710527,9],["μεγάλην",708653,36],["ἐν",704639,0],["τῇ",709436,100],["ἁγνείᾳ",700171,1]],"For in his time things prospered in his hands, so that the heathen were taken out of their country, and they also that were in the city of David in Jerusalem, who had made themselves a tower, out of which they issued, and polluted all about the sanctuary, and did much hurt in the holy place:"],["37",[["καὶ",707031,7],["κατῴκισεν",707534,2],["ἐν",704639,0],["αὐτῇ",702165,105],["ἄνδρας",701150,57],["Ιουδαίους",706772,57],["καὶ",707031,7],["ὠχύρωσεν",709890,2],["αὐτὴν",702165,104],["πρὸς",710844,0],["ἀσφάλειαν",702039,9],["τῆς",709436,16],["χώρας",714011,17],["καὶ",707031,7],["τῆς",709436,16],["πόλεως",710612,17],["καὶ",707031,7],["ὕψωσεν",713289,2],["τὰ",709436,41],["τείχη",712759,42],["τῆς",709436,16],["Ιερουσαλημ",706644,17]],"but he placed Jews therein, and fortified it for the safety of the country and the city, and raised up the walls of Jerusalem."],["38",[["καὶ",707031,7],["ὁ",709436,3],["βασιλεὺς",702580,4],["Δημήτριος",703407,4],["ἔστησεν",706846,2],["αὐτῷ",702165,50],["τὴν",709436,8],["ἀρχιερωσύνην",701846,9],["κατὰ",707200,0],["ταῦτα",709858,71]],"King Demetrius also confirmed him in the high priesthood according to those things,"],["39",[["καὶ",707031,7],["ἐποίησεν",710582,2],["αὐτὸν",702165,85],["τῶν",709436,80],["φίλων",713492,169],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐδόξασεν",703792,2],["αὐτὸν",702165,85],["δόξῃ",703791,1],["μεγάλῃ",708653,101]],"and made him one of his friends, and honoured him with great honour."],["40",[["ἤκουσεν",700587,2],["γὰρ",702963,11],["ὅτι",709803,7],["προσηγόρευνται",710847,408],["οἱ",709436,136],["Ιουδαῖοι",706772,52],["ὑπὸ",713184,0],["Ῥωμαίων",711318,81],["φίλοι",713492,138],["καὶ",707031,7],["σύμμαχοι",712301,52],["καὶ",707031,7],["ἀδελφοί",700249,52],["καὶ",707031,7],["ὅτι",709803,7],["ἀπήντησαν",701364,150],["τοῖς",709436,147],["πρεσβευταῖς",710731,148],["Σιμωνος",711792,18],["ἐνδόξως",704695,28]],"For he had heard say, that the Romans had called the Jews their friends and confederates and brethren; and that they had entertained the ambassadors of Simon honourably:"],["41",[["καὶ",707031,7],["ὅτι",709803,7],["οἱ",709436,136],["Ιουδαῖοι",706772,52],["καὶ",707031,7],["οἱ",709436,136],["ἱερεῖς",706614,52],["εὐδόκησαν",705565,150],["τοῦ",709436,20],["εἶναι",704093,55],["αὐτῶν",702165,40],["Σιμωνα",711792,6],["ἡγούμενον",705931,212],["καὶ",707031,7],["ἀρχιερέα",701845,6],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["ἕως",705792,28],["τοῦ",709436,20],["ἀναστῆναι",701173,106],["προφήτην",711009,6],["πιστὸν",710486,27]],"also that the Jews and priests were well pleased that Simon should be their governor and high priest for ever, until there should arise a faithful prophet;"],["42",[["καὶ",707031,7],["τοῦ",709436,20],["εἶναι",704093,55],["ἐπ᾿",705080,0],["αὐτῶν",702165,40],["στρατηγόν",712144,6],["καὶ",707031,7],["ὅπως",709719,7],["μέλῃ",708696,204],["αὐτῷ",702165,50],["περὶ",710285,0],["τῶν",709436,80],["ἁγίων",700159,169],["καθιστάναι",707011,55],["δι᾿",703417,0],["αὐτοῦ",702165,102],["ἐπὶ",705080,0],["τῶν",709436,43],["ἔργων",705396,44],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐπὶ",705080,0],["τῆς",709436,16],["χώρας",714011,17],["καὶ",707031,7],["ἐπὶ",705080,0],["τῶν",709436,43],["ὅπλων",709704,44],["καὶ",707031,7],["ἐπὶ",705080,0],["τῶν",709436,43],["ὀχυρωμάτων",709891,44]],"moreover that he should be their captain, and should take charge of the sanctuary, to set them over their works, and over the country, and over the armour, and over the fortresses, that, [I say], he should take charge of the sanctuary;"],["43",[["καὶ",707031,7],["ὅπως",709719,7],["μέλῃ",708696,204],["αὐτῷ",702165,50],["περὶ",710285,0],["τῶν",709436,80],["ἁγίων",700159,169],["καὶ",707031,7],["ὅπως",709719,7],["ἀκούηται",700587,428],["ὑπὸ",713184,0],["πάντων",710177,169],["καὶ",707031,7],["ὅπως",709719,7],["γράφωνται",703194,380],["ἐπὶ",705080,0],["τῷ",709436,53],["ὀνόματι",709666,54],["αὐτοῦ",702165,102],["πᾶσαι",710177,192],["συγγραφαὶ",712192,191],["ἐν",704639,0],["τῇ",709436,100],["χώρᾳ",714011,1],["καὶ",707031,7],["ὅπως",709719,7],["περιβάλληται",710294,428],["πορφύραν",710682,9],["καὶ",707031,7],["χρυσοφορῇ",713977,204]],"beside this, that he should be obeyed of every man, and that all the writings in the country should be made in his name, and that he should be clothed in purple, and wear gold:"],["44",[["καὶ",707031,7],["οὐκ",709805,28],["ἐξέσται",704910,93],["οὐθενὶ",709817,30],["τοῦ",709436,35],["λαοῦ",708094,18],["καὶ",707031,7],["τῶν",709436,80],["ἱερέων",706614,81],["ἀθετῆσαί",700369,106],["τι",712866,126],["τούτων",709858,40],["καὶ",707031,7],["ἀντειπεῖν",701223,106],["τοῖς",709436,95],["ὑπ᾿",713184,0],["αὐτοῦ",702165,102],["ῥηθησομένοις",705454,671],["καὶ",707031,7],["ἐπισυστρέψαι",705278,106],["συστροφὴν",712563,9],["ἐν",704639,0],["τῇ",709436,100],["χώρᾳ",714011,1],["ἄνευ",701137,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["περιβάλλεσθαι",710294,110],["πορφύραν",710682,9],["καὶ",707031,7],["ἐμπορποῦσθαι",704616,109],["πόρπην",710679,9],["χρυσῆν",713971,36]],"Also that it should be lawful for none of the people or priests to break any of these things, or to gainsay his words, or to gather an assembly in the country without him, or to be clothed in purple, or wear a buckle of gold:"],["45",[["ὃς",709781,213],["δ᾿",703303,11],["ἂν",700900,11],["παρὰ",709995,0],["ταῦτα",709858,71],["ποιήσῃ",710582,172],["ἢ",705924,7],["ἀθετήσῃ",700369,172],["τι",712866,126],["τούτων",709858,40],["ἔνοχος",704781,14],["ἔσται",704093,93]],"and whosoever should do otherwise, or break any of these things, he should be punished."],["46",[["καὶ",707031,7],["εὐδόκησεν",705565,2],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["θέσθαι",712849,109],["Σιμωνι",711792,114],["ποιῆσαι",710582,106],["κατὰ",707200,0],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62]],"Thus it liked all the people to deal with Simon, and to do as hath been said."],["47",[["καὶ",707031,7],["ἐπεδέξατο",705117,23],["Σιμων",711792,4],["καὶ",707031,7],["εὐδόκησεν",705565,2],["ἀρχιερατεύειν",701844,55],["καὶ",707031,7],["εἶναι",704093,55],["στρατηγὸς",712144,4],["καὶ",707031,7],["ἐθνάρχης",704064,4],["τῶν",709436,80],["Ιουδαίων",706772,81],["καὶ",707031,7],["ἱερέων",706614,81],["καὶ",707031,7],["τοῦ",709436,20],["προστατῆσαι",710963,106],["πάντων",710177,169]],"Then Simon accepted hereof, and was well pleased to be high priest, and captain and governor of the Jews and priests, and to defend them all."],["48",[["καὶ",707031,7],["τὴν",709436,8],["γραφὴν",703191,9],["ταύτην",709858,104],["εἶπον",705373,150],["θέσθαι",712849,109],["ἐν",704639,0],["δέλτοις",703350,76],["χαλκαῖς",713690,291],["καὶ",707031,7],["στῆσαι",706846,106],["αὐτὰς",702165,231],["ἐν",704639,0],["περιβόλῳ",710302,114],["τῶν",709436,80],["ἁγίων",700159,169],["ἐν",704639,0],["τόπῳ",712903,114],["ἐπισήμῳ",705245,30]],"So they commanded that this writing should be put in tables of brass, and that they should be set up within the compass of the sanctuary in a conspicuous place;"],["49",[["τὰ",709436,41],["δὲ",703303,11],["ἀντίγραφα",701229,42],["αὐτῶν",702165,40],["θέσθαι",712849,109],["ἐν",704639,0],["τῷ",709436,53],["γαζοφυλακίῳ",702896,54],["ὅπως",709719,7],["ἔχῃ",705785,204],["Σιμων",711792,4],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτοῦ",702165,102]],"also that the copies thereof should be laid up in the treasury, to the end that Simon and his sons might have them."]]