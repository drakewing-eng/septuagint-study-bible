[["1",[["καὶ",707031,7],["παρέλαβεν",710059,2],["Γοργίας",703174,4],["πεντακισχιλίους",710260,60],["ἄνδρας",701150,57],["καὶ",707031,7],["χιλίαν",713861,36],["ἵππον",706790,9],["ἐκλεκτήν",704240,36],["καὶ",707031,7],["ἀπῆρεν",701329,2],["ἡ",709436,10],["παρεμβολὴ",710133,12],["νυκτὸς",709386,17]],"Then took Gorgias five thousand footmen, and a thousand of the best horsemen, and removed out of the camp by night;"],["2",[["ὥστε",714164,7],["ἐπιβαλεῖν",705083,106],["ἐπὶ",705080,0],["τὴν",709436,8],["παρεμβολὴν",710133,9],["τῶν",709436,80],["Ιουδαίων",706772,81],["καὶ",707031,7],["πατάξαι",710185,106],["αὐτοὺς",702165,62],["ἄφνω",702215,28],["καὶ",707031,7],["υἱοὶ",713075,52],["τῆς",709436,16],["ἄκρας",700588,17],["ἦσαν",704093,137],["αὐτῷ",702165,50],["ὁδηγοί",709449,52]],"to the end he might rush in upon the camp of the Jews, and smite them suddenly. And the men of the fortress were his guides."],["3",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Ιουδας",706775,4],["καὶ",707031,7],["ἀπῆρεν",701329,2],["αὐτὸς",702165,121],["καὶ",707031,7],["οἱ",709436,136],["δυνατοὶ",703845,138],["πατάξαι",710185,106],["τὴν",709436,8],["δύναμιν",703839,9],["τοῦ",709436,35],["βασιλέως",702580,18],["τὴν",709436,8],["ἐν",704639,0],["Αμμαους",700841,111]],"Now when Judas heard thereof, he himself removed, and the valiant men with him, that he might smite the king's army which was at Emmaus,"],["4",[["ἕως",705792,7],["ἔτι",705538,28],["ἐσκορπισμέναι",711881,423],["ἦσαν",704093,137],["αἱ",709436,190],["δυνάμεις",703839,191],["ἀπὸ",701425,0],["τῆς",709436,16],["παρεμβολῆς",710133,17]],"while as yet the forces were dispersed from the camp."],["5",[["καὶ",707031,7],["ἦλθεν",705453,2],["Γοργίας",703174,4],["εἰς",704105,0],["τὴν",709436,8],["παρεμβολὴν",710133,9],["Ιουδου",706775,18],["νυκτὸς",709386,17],["καὶ",707031,7],["οὐδένα",709817,27],["εὗρεν",705676,2],["καὶ",707031,7],["ἐζήτει",705879,13],["αὐτοὺς",702165,62],["ἐν",704639,0],["τοῖς",709436,95],["ὄρεσιν",709768,96],["ὅτι",709803,7],["εἶπεν",705373,2],["φεύγουσιν",713433,197],["οὗτοι",709858,201],["ἀφ᾿",701425,0],["ἡμῶν",705999,145]],"In the mean season came Gorgias by night into the camp of Judas: and when he found no man there, he sought them in the mountains: for he said, These [fellows] flee from us."],["6",[["καὶ",707031,7],["ἅμα",700745,28],["ἡμέρᾳ",705984,1],["ὤφθη",709725,37],["Ιουδας",706775,4],["ἐν",704639,0],["τῷ",709436,53],["πεδίῳ",710215,54],["ἐν",704639,0],["τρισχιλίοις",712964,230],["ἀνδράσιν",701150,148],["πλὴν",710540,28],["καλύμματα",707099,42],["καὶ",707031,7],["μαχαίρας",708593,39],["οὐκ",709805,28],["εἶχον",705785,137],["ὡς",714148,7],["ἠβούλοντο",702795,139]],"But as soon as it was day, Judas shewed himself in the plain with three thousand men, who nevertheless had neither armour nor swords to their minds."],["7",[["καὶ",707031,7],["εἶδον",709725,150],["παρεμβολὴν",710133,9],["ἐθνῶν",704068,44],["ἰσχυρὰν",706855,36],["καὶ",707031,7],["τεθωρακισμένην",706354,436],["καὶ",707031,7],["ἵππον",706790,9],["κυκλοῦσαν",707958,78],["αὐτήν",702165,104],["καὶ",707031,7],["οὗτοι",709858,201],["διδακτοὶ",703646,138],["πολέμου",710605,18]],"And they saw the camp of the heathen, that it was strong and well harnessed, and compassed round about with horsemen; and these were expert of war."],["8",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιουδας",706775,4],["τοῖς",709436,147],["ἀνδράσιν",701150,148],["τοῖς",709436,147],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["μὴ",708851,28],["φοβεῖσθε",713532,73],["τὸ",709436,24],["πλῆθος",710529,25],["αὐτῶν",702165,40],["καὶ",707031,7],["τὸ",709436,24],["ὅρμημα",709757,25],["αὐτῶν",702165,40],["μὴ",708851,28],["δειλωθῆτε",703323,394]],"Then said Judas to the men that were with him, Fear ye not their multitude, neither be ye afraid of their assault."],["9",[["μνήσθητε",708960,372],["ὡς",714148,7],["ἐσώθησαν",712627,99],["οἱ",709436,136],["πατέρες",710189,52],["ἡμῶν",705999,145],["ἐν",704639,0],["θαλάσσῃ",706069,1],["ἐρυθρᾷ",705447,101],["ὅτε",709802,28],["ἐδίωκεν",703768,13],["αὐτοὺς",702165,62],["Φαραω",713360,4],["ἐν",704639,0],["δυνάμει",703839,1]],"Remember how our fathers were delivered in the Red sea, when Pharaoh pursued them with an army."],["10",[["καὶ",707031,7],["νῦν",709384,28],["βοήσωμεν",702743,79],["εἰς",704105,0],["οὐρανόν",709844,6],["εἰ",704071,7],["θελήσει",706176,127],["ἡμᾶς",705981,194],["καὶ",707031,7],["μνησθήσεται",708923,134],["διαθήκης",703456,17],["πατέρων",710189,81],["καὶ",707031,7],["συντρίψει",712520,127],["τὴν",709436,8],["παρεμβολὴν",710133,9],["ταύτην",709858,104],["κατὰ",707200,0],["πρόσωπον",710986,25],["ἡμῶν",705999,145],["σήμερον",711751,28]],"Now therefore let us cry unto heaven, if peradventure the Lord will have mercy upon us, and remember the covenant of our fathers, and destroy this host before our face this day:"],["11",[["καὶ",707031,7],["γνώσονται",703105,135],["πάντα",710177,195],["τὰ",709436,63],["ἔθνη",704068,64],["ὅτι",709803,7],["ἔστιν",704093,91],["ὁ",709436,3],["λυτρούμενος",708282,122],["καὶ",707031,7],["σῴζων",712627,72],["τὸν",709436,5],["Ισραηλ",706839,6]],"that so all the heathen may know that there is one who delivereth and saveth Israel."],["12",[["καὶ",707031,7],["ἦραν",700473,150],["οἱ",709436,136],["ἀλλόφυλοι",700706,138],["τοὺς",709436,58],["ὀφθαλμοὺς",709870,57],["αὐτῶν",702165,40],["καὶ",707031,7],["εἶδον",709725,150],["αὐτοὺς",702165,62],["ἐρχομένους",705453,236],["ἐξ",704132,0],["ἐναντίας",704656,82]],"Then the strangers lifted up their eyes, and saw them coming over against them."],["13",[["καὶ",707031,7],["ἐξῆλθον",704909,150],["ἐκ",704132,0],["τῆς",709436,16],["παρεμβολῆς",710133,17],["εἰς",704105,0],["πόλεμον",710605,6],["καὶ",707031,7],["ἐσάλπισαν",711425,150],["οἱ",709436,136],["παρὰ",709995,0],["Ιουδου",706775,18]],"Wherefore they went out of the camp to battle; but they that were with Judas sounded their trumpets."],["14",[["καὶ",707031,7],["συνῆψαν",712404,150],["καὶ",707031,7],["συνετρίβησαν",712520,99],["τὰ",709436,41],["ἔθνη",704068,42],["καὶ",707031,7],["ἔφυγον",713433,150],["εἰς",704105,0],["τὸ",709436,24],["πεδίον",710215,25]],"So they joined battle, and the heathen being discomfited, fled into the plain."],["15",[["οἱ",709436,136],["δὲ",703303,11],["ἔσχατοι",705519,138],["πάντες",710177,138],["ἔπεσον",710481,150],["ἐν",704639,0],["ῥομφαίᾳ",711291,1],["καὶ",707031,7],["ἐδίωξαν",703768,150],["αὐτοὺς",702165,62],["ἕως",705792,28],["Γαζηρων",702893,118],["καὶ",707031,7],["ἕως",705792,28],["τῶν",709436,43],["πεδίων",710215,44],["τῆς",709436,16],["Ιδουμαίας",706503,17],["καὶ",707031,7],["Ἀζώτου",700351,17],["καὶ",707031,7],["Ιαμνείας",706412,118],["καὶ",707031,7],["ἔπεσαν",710481,150],["ἐξ",704132,0],["αὐτῶν",702165,40],["εἰς",704105,0],["ἄνδρας",701150,57],["τρισχιλίους",712964,60]],"Howbeit all the hindmost of them were slain with the sword: for they pursued them unto Gazera, and unto the plains of Idumea, and Azotus, and Jamnia, so that there were slain of them as many as three thousand men."],["16",[["καὶ",707031,7],["ἀπέστρεψεν",701598,2],["Ιουδας",706775,4],["καὶ",707031,7],["ἡ",709436,10],["δύναμις",703839,12],["ἀπὸ",701425,0],["τοῦ",709436,20],["διώκειν",703768,55],["ὄπισθεν",709691,0],["αὐτῶν",702165,40]],"This done, Judas returned again with his host from pursuing them,"],["17",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["τὸν",709436,5],["λαόν",708094,6],["μὴ",708851,28],["ἐπιθυμήσητε",705141,125],["τῶν",709436,43],["σκύλων",711902,44],["ὅτι",709803,7],["πόλεμος",710605,4],["ἐξ",704132,0],["ἐναντίας",704656,82],["ἡμῶν",705999,145]],"and said to the people, Be not greedy of the spoils, inasmuch as there is a battle before us,"],["18",[["καὶ",707031,7],["Γοργίας",703174,4],["καὶ",707031,7],["ἡ",709436,10],["δύναμις",703839,12],["ἐν",704639,0],["τῷ",709436,53],["ὄρει",709768,54],["ἐγγὺς",703948,0],["ἡμῶν",705999,145],["ἀλλὰ",700680,7],["στῆτε",706846,74],["νῦν",709384,28],["ἐναντίον",704654,0],["τῶν",709436,80],["ἐχθρῶν",705779,169],["ἡμῶν",705999,145],["καὶ",707031,7],["πολεμήσατε",710601,74],["αὐτούς",702165,62],["καὶ",707031,7],["μετὰ",708780,0],["ταῦτα",709858,71],["λάβετε",708076,74],["τὰ",709436,41],["σκῦλα",711902,42],["μετὰ",708780,0],["παρρησίας",710173,17]],"and Gorgias and his host are here by us in the mountain: but stand ye now against our enemies, and overcome them, and after this ye may boldly take the spoils."],["19",[["ἔτι",705538,28],["πληροῦντος",710543,152],["Ιουδου",706775,18],["ταῦτα",709858,71],["μέρος",708752,15],["τι",712866,273],["ὤφθη",709725,37],["ἐκκύπτον",704229,32],["ἐκ",704132,0],["τοῦ",709436,20],["ὄρους",709768,21]],"As Judas was yet speaking these words, there appeared a part of them looking out of the mountain:"],["20",[["καὶ",707031,7],["εἶδεν",709725,2],["ὅτι",709803,7],["τετρόπωνται",712981,408],["καὶ",707031,7],["ἐμπυρίζουσιν",704622,197],["τὴν",709436,8],["παρεμβολήν",710133,9],["ὁ",709436,3],["γὰρ",702963,11],["καπνὸς",707132,4],["ὁ",709436,3],["θεωρούμενος",706226,466],["ἐνεφάνιζεν",704628,13],["τὸ",709436,24],["γεγονός",703104,409]],"who when they perceived that the Jews had put their host to flight, and were burning the tents; for the smoke that was seen declared what was done:"],["21",[["οἱ",709436,136],["δὲ",703303,11],["ταῦτα",709858,71],["συνιδόντες",712433,196],["ἐδειλώθησαν",703323,99],["σφόδρα",712586,28],["συνιδόντες",712433,196],["δὲ",703303,11],["καὶ",707031,28],["τὴν",709436,8],["Ιουδου",706775,18],["παρεμβολὴν",710133,9],["ἐν",704639,0],["τῷ",709436,53],["πεδίῳ",710215,54],["ἑτοίμην",705541,36],["εἰς",704105,0],["παράταξιν",710107,9]],"when therefore they perceived these things, they were sore afraid, and seeing also the host of Judas in the plain ready to fight,"],["22",[["ἔφυγον",713433,150],["πάντες",710177,138],["εἰς",704105,0],["γῆν",703083,9],["ἀλλοφύλων",700706,169]],"they fled every one into the land of strangers."],["23",[["καὶ",707031,7],["Ιουδας",706775,4],["ἀνέστρεψεν",701060,2],["ἐπὶ",705080,0],["τὴν",709436,8],["σκυλείαν",711899,9],["τῆς",709436,16],["παρεμβολῆς",710133,17],["καὶ",707031,7],["ἔλαβον",708076,150],["χρυσίον",713972,25],["πολὺ",710646,46],["καὶ",707031,7],["ἀργύριον",701707,25],["καὶ",707031,7],["ὑάκινθον",713048,9],["καὶ",707031,7],["πορφύραν",710682,9],["θαλασσίαν",706070,36],["καὶ",707031,7],["πλοῦτον",710563,6],["μέγαν",708653,27]],"Then Judas returned to spoil the tents, where they got much gold, and silver, and blue silk, and purple of the sea, and great riches."],["24",[["καὶ",707031,7],["ἐπιστραφέντες",705278,247],["ὕμνουν",713085,137],["καὶ",707031,7],["εὐλόγουν",705631,137],["εἰς",704105,0],["οὐρανὸν",709844,6],["ὅτι",709803,7],["καλόν",707097,27],["ὅτι",709803,7],["εἰς",704105,0],["τὸν",709436,5],["αἰῶνα",700504,6],["τὸ",709436,24],["ἔλεος",704426,25],["αὐτοῦ",702165,102]],"After this they went home, and sung a song of thanksgiving, and praised the Lord in heaven: because it is good, because his mercy [endureth] for ever."],["25",[["καὶ",707031,7],["ἐγενήθη",703104,37],["σωτηρία",712658,12],["μεγάλη",708653,29],["τῷ",709436,113],["Ισραηλ",706839,114],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105]],"Thus Israel had a great deliverance that day."],["26",[["ὅσοι",709788,138],["δὲ",703303,11],["τῶν",709436,80],["ἀλλοφύλων",700706,169],["διεσώθησαν",703599,99],["παραγενηθέντες",710006,247],["ἀπήγγειλαν",701321,150],["τῷ",709436,113],["Λυσίᾳ",708275,114],["πάντα",710177,68],["τὰ",709436,41],["συμβεβηκότα",712277,518]],"Now all the strangers that had escaped came and told Lysias what had happened:"],["27",[["ὁ",709436,3],["δὲ",703303,11],["ἀκούσας",700587,182],["συνεχύθη",712243,37],["καὶ",707031,7],["ἠθύμει",700387,13],["ὅτι",709803,7],["οὐχ",709805,28],["οἷα",709535,68],["ἤθελεν",706176,13],["τοιαῦτα",712878,195],["ἐγεγόνει",703104,143],["τῷ",709436,113],["Ισραηλ",706839,114],["καὶ",707031,7],["οὐχ",709805,28],["οἷα",709535,68],["αὐτῷ",702165,50],["ἐνετείλατο",704791,23],["ὁ",709436,3],["βασιλεύς",702580,4],["ἐξέβη",704144,2]],"who, when he heard thereof, was confounded and discouraged, because neither such things as he would were done unto Israel, nor such things as the king commanded him were come to pass."],["28",[["καὶ",707031,7],["ἐν",704639,0],["τῷ",709436,113],["ἐρχομένῳ",705453,241],["ἐνιαυτῷ",704745,114],["συνελόχησεν",712270,2],["ἀνδρῶν",701150,81],["ἐπιλέκτων",705189,169],["ἑξήκοντα",704922,59],["χιλιάδας",713858,39],["καὶ",707031,7],["πεντακισχιλίαν",710260,36],["ἵππον",706790,9],["ὥστε",714164,7],["ἐκπολεμῆσαι",704290,106],["αὐτούς",702165,62]],"In the following year therefore, Lysias gathered together threescore thousand choice men [of foot], and five thousand horsemen, that he might subdue them."],["29",[["καὶ",707031,7],["ἦλθον",705453,150],["εἰς",704105,0],["τὴν",709436,8],["Ιδουμαίαν",706503,9],["καὶ",707031,7],["παρενέβαλον",710132,150],["ἐν",704639,0],["Βαιθσουροις",702436,285],["καὶ",707031,7],["συνήντησεν",712394,2],["αὐτοῖς",702165,151],["Ιουδας",706775,4],["ἐν",704639,0],["δέκα",703333,59],["χιλιάσιν",713858,76],["ἀνδρῶν",701150,81]],"So they came into Idumea, and pitched their tents at Bethsura, and Judas met them with ten thousand men."],["30",[["καὶ",707031,7],["εἶδεν",709725,2],["τὴν",709436,8],["παρεμβολὴν",710133,9],["ἰσχυρὰν",706855,36],["καὶ",707031,7],["προσηύξατο",710893,23],["καὶ",707031,7],["εἶπεν",705373,2],["εὐλογητὸς",705632,14],["εἶ",704093,154],["ὁ",709436,630],["σωτὴρ",712657,153],["Ισραηλ",706839,18],["ὁ",709436,3],["συντρίψας",712520,182],["τὸ",709436,24],["ὅρμημα",709757,25],["τοῦ",709436,35],["δυνατοῦ",703845,116],["ἐν",704639,0],["χειρὶ",713787,1],["τοῦ",709436,35],["δούλου",703817,18],["σου",711945,133],["Δαυιδ",703232,18],["καὶ",707031,7],["παρέδωκας",710014,162],["τὴν",709436,8],["παρεμβολὴν",710133,9],["τῶν",709436,80],["ἀλλοφύλων",700706,169],["εἰς",704105,0],["χεῖρας",713787,39],["Ιωναθου",706928,18],["υἱοῦ",713075,18],["Σαουλ",711499,18],["καὶ",707031,7],["τοῦ",709436,35],["αἴροντος",700473,152],["τὰ",709436,41],["σκεύη",711844,42],["αὐτοῦ",702165,102]],"And when he saw that mighty army, he prayed and said, Ble