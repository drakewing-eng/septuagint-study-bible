,7],["ἐτέλεσαν",712783,150],["πάντα",710177,68],["τὰ",709436,41],["ἔργα",705396,42],["ἃ",709781,69],["ἐποίησαν",710582,150]],"Furthermore they set the loaves upon the table, and spread out the veils, and finished all the works which they had begun to make."],["52",[["καὶ",707031,7],["ὤρθρισαν",709742,150],["τὸ",709436,24],["πρωὶ",711021,28],["τῇ",709436,100],["πέμπτῃ",710245,101],["καὶ",707031,7],["εἰκάδι",704082,1],["τοῦ",709436,35],["μηνὸς",708874,18],["τοῦ",709436,35],["ἐνάτου",704666,116],["οὗτος",709858,121],["ὁ",709436,3],["μὴν",708874,4],["Χασελευ",713762,118],["τοῦ",709436,20],["ὀγδόου",709444,92],["καὶ",707031,7],["τεσσαρακοστοῦ",712807,92],["καὶ",707031,7],["ἑκατοστοῦ",704143,92],["ἔτους",705543,21]],"Now on the five and twentieth day of the ninth month, which [is called] the month Casleu, in the hundred forty and eighth year, they rose up betimes in the morning,"],["53",[["καὶ",707031,7],["ἀνήνεγκαν",701083,150],["θυσίαν",706345,9],["κατὰ",707200,0],["τὸν",709436,5],["νόμον",709349,6],["ἐπὶ",705080,0],["τὸ",709436,24],["θυσιαστήριον",706348,25],["τῶν",709436,43],["ὁλοκαυτωμάτων",709589,44],["τὸ",709436,24],["καινόν",707042,46],["ὃ",709781,128],["ἐποίησαν",710582,150]],"and offered sacrifice according to the law upon the new altar of burnt offerings, which they had made."],["54",[["κατὰ",707200,0],["τὸν",709436,5],["καιρὸν",707047,6],["καὶ",707031,7],["κατὰ",707200,0],["τὴν",709436,8],["ἡμέραν",705984,9],["ἐν",704639,0],["ᾗ",709781,108],["ἐβεβήλωσαν",702614,150],["αὐτὸ",702165,129],["τὰ",709436,63],["ἔθνη",704068,64],["ἐν",704639,0],["ἐκείνῃ",704183,105],["ἐνεκαινίσθη",703956,37],["ἐν",704639,0],["ᾠδαῖς",714091,76],["καὶ",707031,7],["κιθάραις",707669,76],["καὶ",707031,7],["κινύραις",707684,76],["καὶ",707031,7],["κυμβάλοις",707972,96]],"At what time and day the heathen had profaned it, even in that was it dedicated with songs, and citherns, and harps, and cymbals."],["55",[["καὶ",707031,7],["ἔπεσεν",710481,2],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["καὶ",707031,7],["προσεκύνησαν",710925,150],["καὶ",707031,7],["εὐλόγησαν",705631,150],["εἰς",704105,0],["οὐρανὸν",709844,6],["τὸν",709436,5],["εὐοδώσαντα",705654,365],["αὐτοῖς",702165,151]],"Then all the people fell upon their faces, worshipping and praising [the God of] heaven, who had given them good success."],["56",[["καὶ",707031,7],["ἐποίησαν",710582,150],["τὸν",709436,5],["ἐγκαινισμὸν",703958,6],["τοῦ",709436,20],["θυσιαστηρίου",706348,21],["ἡμέρας",705984,39],["ὀκτὼ",709555,59],["καὶ",707031,7],["προσήνεγκαν",710974,150],["ὁλοκαυτώματα",709589,42],["μετ᾿",708780,0],["εὐφροσύνης",705717,17],["καὶ",707031,7],["ἔθυσαν",706349,150],["θυσίαν",706345,9],["σωτηρίου",712659,21],["καὶ",707031,7],["αἰνέσεως",700457,17]],"And so they kept the dedication of the altar eight days, and offered burnt offerings with gladness, and sacrificed the sacrifice of deliverance and praise."],["57",[["καὶ",707031,7],["κατεκόσμησαν",707286,150],["τὸ",709436,24],["κατὰ",707200,0],["πρόσωπον",710986,25],["τοῦ",709436,35],["ναοῦ",709191,18],["στεφάνοις",712083,148],["χρυσοῖς",713971,230],["καὶ",707031,7],["ἀσπιδίσκαις",701990,76],["καὶ",707031,7],["ἐνεκαίνισαν",703956,150],["τὰς",709436,38],["πύλας",711082,39],["καὶ",707031,7],["τὰ",709436,41],["παστοφόρια",710181,42],["καὶ",707031,7],["ἐθύρωσαν",706341,150],["αὐτά",702165,71]],"They decked also the forefront of the temple with crowns of gold and with shields; and the gates and the chambers they renewed, and hanged doors upon them."],["58",[["καὶ",707031,7],["ἐγενήθη",703104,37],["εὐφροσύνη",705717,12],["μεγάλη",708653,29],["ἐν",704639,0],["τῷ",709436,113],["λαῷ",708094,114],["σφόδρα",712586,28],["καὶ",707031,7],["ἀπεστράφη",701598,37],["ὀνειδισμὸς",709657,4],["ἐθνῶν",704068,44]],"Thus was there very great gladness among the people, for that the reproach of the heathen was put away."],["59",[["καὶ",707031,7],["ἔστησεν",706846,2],["Ιουδας",706775,4],["καὶ",707031,7],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["πᾶσα",710177,29],["ἡ",709436,10],["ἐκκλησία",704216,12],["Ισραηλ",706839,18],["ἵνα",706747,7],["ἄγωνται",700209,380],["αἱ",709436,190],["ἡμέραι",705984,191],["τοῦ",709436,35],["ἐγκαινισμοῦ",703958,18],["τοῦ",709436,20],["θυσιαστηρίου",706348,21],["ἐν",704639,0],["τοῖς",709436,147],["καιροῖς",707047,148],["αὐτῶν",702165,284],["ἐνιαυτὸν",704745,6],["κατ᾿",707200,0],["ἐνιαυτὸν",704745,6],["ἡμέρας",705984,39],["ὀκτὼ",709555,59],["ἀπὸ",701425,0],["τῆς",709436,16],["πέμπτης",710245,82],["καὶ",707031,7],["εἰκάδος",704082,17],["τοῦ",709436,35],["μηνὸς",708874,18],["Χασελευ",713762,118],["μετ᾿",708780,0],["εὐφροσύνης",705717,17],["καὶ",707031,7],["χαρᾶς",713719,17]],"Moreover Judas and his brethren with the whole congregation of Israel ordained, that the days of the dedication of the altar should be kept in their season from year to year by the space of eight days, from the five and twentieth day of the month Casleu, with mirth and gladness."],["60",[["καὶ",707031,7],["ᾠκοδόμησαν",709509,150],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["τὸ",709436,24],["ὄρος",709768,25],["Σιων",711816,118],["κυκλόθεν",707956,28],["τείχη",712759,42],["ὑψηλὰ",713285,68],["καὶ",707031,7],["πύργους",711092,57],["ὀχυρούς",709889,60],["μήποτε",708882,28],["παραγενηθέντα",710006,352],["τὰ",709436,63],["ἔθνη",704068,64],["καταπατήσωσιν",707360,234],["αὐτά",702165,71],["ὡς",714148,7],["ἐποίησαν",710582,150],["τὸ",709436,24],["πρότερον",710991,46]],"At that time also they builded up the mount Sion with high walls and strong towers round about, lest the Gentiles should come and tread it down, as they had done before."],["61",[["καὶ",707031,7],["ἀπέταξεν",701608,2],["ἐκεῖ",704181,28],["δύναμιν",703839,9],["τηρεῖν",712844,55],["αὐτὸ",702165,129],["καὶ",707031,7],["ὠχύρωσεν",709890,2],["αὐτὸ",702165,129],["τηρεῖν",712844,55],["τὴν",709436,8],["Βαιθσουραν",702436,9],["τοῦ",709436,20],["ἔχειν",705785,55],["τὸν",709436,5],["λαὸν",708094,6],["ὀχύρωμα",709891,25],["κατὰ",707200,0],["πρόσωπον",710986,25],["τῆς",709436,16],["Ιδουμαίας",706503,17]],"And they set there a garrison to keep it, and fortified Bethsura to preserve it; that the people might have a defence against Idumea."]]