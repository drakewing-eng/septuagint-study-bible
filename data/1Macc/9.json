[["1",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Δημήτριος",703407,4],["ὅτι",709803,7],["ἔπεσεν",710481,2],["Νικάνωρ",709308,4],["καὶ",707031,7],["ἡ",709436,10],["δύναμις",703839,12],["αὐτοῦ",702165,102],["ἐν",704639,0],["πολέμῳ",710605,114],["καὶ",707031,7],["προσέθετο",710965,23],["τὸν",709436,5],["Βακχίδην",702461,6],["καὶ",707031,7],["τὸν",709436,5],["Ἄλκιμον",700679,6],["ἐκ",704132,0],["δευτέρου",703389,116],["ἀποστεῖλαι",701592,106],["εἰς",704105,0],["γῆν",703083,9],["Ιουδα",706768,18],["καὶ",707031,7],["τὸ",709436,24],["δεξιὸν",703360,46],["κέρας",707625,25],["μετ᾿",708780,0],["αὐτῶν",702165,40]],"Furthermore when Demetrius heard that Nicanor and his host were slain in battle, he sent Bacchides and Alcimus into the land of Judea the second time, and with them the chief strength of his host:"],["2",[["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["ὁδὸν",709458,9],["τὴν",709436,8],["εἰς",704105,0],["Γαλγαλα",702933,227],["καὶ",707031,7],["παρενέβαλον",710132,150],["ἐπὶ",705080,0],["Μαισαλωθ",708392,17],["τὴν",709436,8],["ἐν",704639,0],["Αρβηλοις",701698,148],["καὶ",707031,7],["προκατελάβοντο",710809,189],["αὐτὴν",702165,104],["καὶ",707031,7],["ἀπώλεσαν",701513,150],["ψυχὰς",714070,39],["ἀνθρώπων",701163,81],["πολλάς",710646,119]],"who went forth by the way that leadeth to Galgala, and pitched their tents before Masaloth, which is in Arbela, and after they had won it, they slew much people."],["3",[["καὶ",707031,7],["τοῦ",709436,35],["μηνὸς",708874,18],["τοῦ",709436,35],["πρώτου",711041,216],["ἔτους",705543,21],["τοῦ",709436,20],["δευτέρου",703389,92],["καὶ",707031,7],["πεντηκοστοῦ",710273,92],["καὶ",707031,7],["ἑκατοστοῦ",704143,92],["παρενέβαλον",710132,150],["ἐπὶ",705080,0],["Ιερουσαλημ",706644,17]],"Also the first month of the hundred fifty and second year they encamped before Jerusalem:"],["4",[["καὶ",707031,7],["ἀπῆραν",701329,150],["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["εἰς",704105,0],["Βερεαν",702654,9],["ἐν",704639,0],["εἴκοσι",704085,59],["χιλιάσιν",713858,76],["ἀνδρῶν",701150,81],["καὶ",707031,7],["δισχιλίᾳ",703748,101],["ἵππῳ",706790,1]],"from whence they removed, and went to Berea, with twenty thousand footmen and two thousand horsemen."],["5",[["καὶ",707031,7],["Ιουδας",706775,4],["ἦν",704093,13],["παρεμβεβληκὼς",710132,270],["ἐν",704639,0],["Ελασα",704384,111],["καὶ",707031,7],["τρισχίλιοι",712964,138],["ἄνδρες",701150,52],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἐκλεκτοί",704240,138]],"Now Judas had pitched his tents at Eleasa, and three thousand chosen men with him:"],["6",[["καὶ",707031,7],["εἶδον",709725,150],["τὸ",709436,24],["πλῆθος",710529,25],["τῶν",709436,130],["δυνάμεων",703839,65],["ὅτι",709803,7],["πολλοί",710646,138],["εἰσιν",704093,197],["καὶ",707031,7],["ἐφοβήθησαν",713532,99],["σφόδρα",712586,28],["καὶ",707031,7],["ἐξερρύησαν",704300,150],["πολλοὶ",710646,138],["ἀπὸ",701425,0],["τῆς",709436,16],["παρεμβολῆς",710133,17],["οὐ",709805,28],["κατελείφθησαν",707305,99],["ἐξ",704132,0],["αὐτῶν",702165,40],["ἀλλ᾿",700680,7],["ἢ",705924,7],["ὀκτακόσιοι",709553,138],["ἄνδρες",701150,52]],"who seeing the multitude of the other army to be so great, were sore afraid; whereupon many conveyed themselves out of the host, insomuch as there abode of them no more but eight hundred men."],["7",[["καὶ",707031,7],["εἶδεν",709725,2],["Ιουδας",706775,4],["ὅτι",709803,7],["ἀπερρύη",701559,2],["ἡ",709436,10],["παρεμβολὴ",710133,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὁ",709436,3],["πόλεμος",710605,4],["ἔθλιβεν",706274,13],["αὐτόν",702165,85],["καὶ",707031,7],["συνετρίβη",712520,37],["τῇ",709436,100],["καρδίᾳ",707141,1],["ὅτι",709803,7],["οὐκ",709805,28],["εἶχεν",705785,13],["καιρὸν",707047,6],["συναγαγεῖν",712375,106],["αὐτούς",702165,62]],"When Judas therefore saw that his host slipt away, and that the battle pressed upon him, he was sore troubled in mind, and much distressed, for that he had no time to gather them together."],["8",[["καὶ",707031,7],["ἐξελύθη",704254,37],["καὶ",707031,7],["εἶπεν",705373,2],["τοῖς",709436,147],["καταλειφθεῖσιν",707305,477],["ἀναστῶμεν",701173,79],["καὶ",707031,7],["ἀναβῶμεν",700905,79],["ἐπὶ",705080,0],["τοὺς",709436,58],["ὑπεναντίους",713109,60],["ἡμῶν",705999,145],["ἐὰν",703912,7],["ἄρα",701666,11],["δυνώμεθα",703838,488],["πολεμῆσαι",710601,106],["πρὸς",710844,0],["αὐτούς",702165,62]],"Nevertheless unto them that remained he said, Let us arise and go up against our enemies, if peradventure we may be able to fight with them."],["9",[["καὶ",707031,7],["ἀπέστρεφον",701598,137],["αὐτὸν",702165,85],["λέγοντες",708124,146],["οὐ",709805,28],["μὴ",708851,28],["δυνώμεθα",703838,488],["ἀλλ᾿",700680,7],["ἢ",705924,7],["σῴζωμεν",712627,233],["τὰς",709436,38],["ἑαυτῶν",703917,40],["ψυχὰς",714070,39],["τὸ",709436,24],["νῦν",709384,28],["ἐπιστρέψωμεν",705278,79],["καὶ",707031,7],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["ἡμῶν",705999,145],["καὶ",707031,7],["πολεμήσωμεν",710601,79],["πρὸς",710844,0],["αὐτούς",702165,62],["ἡμεῖς",705983,219],["δὲ",703303,11],["ὀλίγοι",709568,138]],"But they dehorted him, saying, We shall never be able: let us now rather save our lives, and hereafter we will return with our brethren, and fight against them: for we are but few."],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιουδας",706775,4],["μὴ",708851,7],["γένοιτο",703104,382],["ποιῆσαι",710582,106],["τὸ",709436,24],["πρᾶγμα",710708,25],["τοῦτο",709858,129],["φυγεῖν",713433,106],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["καὶ",707031,7],["εἰ",704071,7],["ἤγγικεν",703939,171],["ὁ",709436,3],["καιρὸς",707047,4],["ἡμῶν",705999,145],["καὶ",707031,7],["ἀποθάνωμεν",701461,79],["ἐν",704639,0],["ἀνδρείᾳ",701101,101],["χάριν",713735,9],["τῶν",709436,80],["ἀδελφῶν",700249,81],["ἡμῶν",705999,145],["καὶ",707031,7],["μὴ",708851,28],["καταλίπωμεν",707305,79],["αἰτίαν",700492,9],["τῇ",709436,100],["δόξῃ",703791,1],["ἡμῶν",705999,145]],"Then Judas said, God forbid that I should do this thing, and flee away from them: if our time be come, let us die manfully for our brethren, and let us not stain our honour."],["11",[["καὶ",707031,7],["ἀπῆρεν",701329,2],["ἡ",709436,10],["δύναμις",703839,12],["ἀπὸ",701425,0],["τῆς",709436,16],["παρεμβολῆς",710133,17],["καὶ",707031,7],["ἔστησαν",706846,150],["εἰς",704105,0],["συνάντησιν",712397,9],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἐμερίσθη",708744,37],["ἡ",709436,10],["ἵππος",706790,12],["εἰς",704105,0],["δύο",703849,59],["μέρη",708752,42],["καὶ",707031,7],["οἱ",709436,136],["σφενδονῆται",712579,52],["καὶ",707031,7],["οἱ",709436,136],["τοξόται",712899,52],["προεπορεύοντο",710839,139],["τῆς",709436,16],["δυνάμεως",703839,17],["καὶ",707031,7],["οἱ",709436,136],["πρωταγωνισταὶ",711028,52],["πάντες",710177,138],["οἱ",709436,136],["δυνατοί",703845,138],["Βακχίδης",702461,4],["δὲ",703303,11],["ἦν",704093,13],["ἐν",704639,0],["τῷ",709436,53],["δεξιῷ",703360,97],["κέρατι",707625,54]],"With that the host [of Bacchides] removed out of their tents, and stood over against them, their horsemen being divided into two troops, and their slingers and archers going before the host, and they that marched in the foreward were all mighty men."],["12",[["καὶ",707031,7],["ἤγγισεν",703939,2],["ἡ",709436,10],["φάλαγξ",713320,12],["ἐκ",704132,0],["τῶν",709436,43],["δύο",703849,59],["μερῶν",708752,44],["καὶ",707031,7],["ἐφώνουν",713639,137],["ταῖς",709436,75],["σάλπιγξιν",711424,76],["καὶ",707031,7],["ἐσάλπισαν",711425,150],["οἱ",709436,136],["παρὰ",709995,0],["Ιουδου",706775,18],["καὶ",707031,7],["αὐτοὶ",702165,201],["ταῖς",709436,75],["σάλπιγξιν",711424,76]],"As for Bacchides, he was in the right wing: so the host drew near on the two parts, and sounded their trumpets."],["13",[["καὶ",707031,7],["ἐσαλεύθη",711403,37],["ἡ",709436,10],["γῆ",703083,12],["ἀπὸ",701425,0],["τῆς",709436,16],["φωνῆς",713640,17],["τῶν",709436,130],["παρεμβολῶν",710133,65],["καὶ",707031,7],["ἐγένετο",703104,23],["ὁ",709436,3],["πόλεμος",710605,4],["συνημμένος",712404,419],["ἀπὸ",701425,0],["πρωίθεν",711022,28],["ἕως",705792,28],["ἑσπέρας",705500,17]],"They also of Judas' side, even they sounded their trumpets also, so that the earth shook at the noise of the armies, and the battle continued from morning till night."],["14",[["καὶ",707031,7],["εἶδεν",709725,2],["Ιουδας",706775,4],["ὅτι",709803,7],["Βακχίδης",702461,4],["καὶ",707031,7],["τὸ",709436,34],["στερέωμα",712077,15],["τῆς",709436,16],["παρεμβολῆς",710133,17],["ἐν",704639,0],["τοῖς",709436,95],["δεξιοῖς",703360,94],["καὶ",707031,7],["συνῆλθον",712458,150],["αὐτῷ",702165,50],["πάντες",710177,138],["οἱ",709436,136],["εὔψυχοι",705731,138],["τῇ",709436,100],["καρδίᾳ",707141,1]],"Now when Judas perceived that Bacchides and the strength of his army were on the right side, he took with him all the hardy men,"],["15",[["καὶ",707031,7],["συνετρίβη",712520,37],["τὸ",709436,24],["δεξιὸν",703360,46],["μέρος",708752,25],["ἀπ᾿",701425,0],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐδίωκεν",703768,13],["ὀπίσω",709697,28],["αὐτῶν",702165,40],["ἕως",705792,28],["Αζωτου",700351,17],["ὄρους",709768,21]],"who discomfited the right wing, and pursued them unto the mount Azotus."],["16",[["καὶ",707031,7],["οἱ",709436,136],["εἰς",704105,0],["τὸ",709436,24],["ἀριστερὸν",701749,46],["κέρας",707625,25],["εἶδον",709725,150],["ὅτι",709803,7],["συνετρίβη",712520,37],["τὸ",709436,24],["δεξιὸν",703360,46],["κέρας",707625,25],["καὶ",707031,7],["ἐπέστρεψαν",705278,150],["κατὰ",707200,0],["πόδας",710707,57],["Ιουδου",706775,18],["καὶ",707031,7],["τῶν",709436,80],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["ἐκ",704132,0],["τῶν",709436,80],["ὄπισθεν",709691,28]],"But when they of the left wing saw that they of the right wing were discomfited, they followed upon Judas and those that were with him hard at the heels from behind:"],["17",[["καὶ",707031,7],["ἐβαρύνθη",702553,37],["ὁ",709436,3],["πόλεμος",710605,4],["καὶ",707031,7],["ἔπεσον",710481,150],["τραυματίαι",712921,52],["πολλοὶ",710646,138],["ἐκ",704132,0],["τούτων",709858,40],["καὶ",707031,7],["ἐκ",704132,0],["τούτων",709858,40]],"whereupon there was a sore battle, insomuch as many were slain on both parts."],["18",[["καὶ",707031,7],["Ιουδας",706775,4],["ἔπεσεν",710481,2],["καὶ",707031,7],["οἱ",709436,136],["λοιποὶ",708248,138],["ἔφυγον",713433,150]],"Judas also was killed, and the remnant fled."],["19",[["καὶ",707031,7],["ἦρεν",700473,2],["Ιωναθαν",706927,4],["καὶ",707031,7],["Σιμων",711792,4],["Ιουδαν",706775,6],["τὸν",709436,5],["ἀδελφὸν",700249,6],["αὐτῶν",702165,40],["καὶ",707031,7],["ἔθαψαν",706103,150],["αὐτὸν",702165,85],["ἐν",704639,0],["τῷ",709436,113],["τάφῳ",712738,114],["τῶν",709436,80],["πατέρων",710189,81],["αὐτοῦ",702165,102],["ἐν",704639,0],["Μωδεϊν",709092,1]],"Then Jonathan and Simon took Judas their brother, and buried him in the sepulchre of his fathers in Modin."],["20",[["καὶ",707031,7],["ἔκλαυσαν",707703,150],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐκόψαντο",707829,189],["αὐτὸν",702165,85],["πᾶς",710177,14],["Ισραηλ",706839,4],["κοπετὸν",707821,6],["μέγαν",708653,27],["καὶ",707031,7],["ἐπένθουν",710251,137],["ἡμέρας",705984,39],["πολλὰς",710646,119],["καὶ",707031,7],["εἶπον",705373,150]],"Moreover they bewailed him, and all Israel made great lamentation for him, and mourned many days, saying,"],["21",[["πῶς",711121,28],["ἔπεσεν",710481,2],["δυνατὸς",703845,14],["σῴζων",712627,72],["τὸν",709436,5],["Ισραηλ",706839,6]],"How is the valiant man fallen, that delivered Israel!"],["22",[["καὶ",707031,7],["τὰ",709436,63],["περισσὰ",710387,195],["τῶν",709436,80],["λόγων",708236,81],["Ιουδου",706775,18],["καὶ",707031,7],["τῶν",709436,80],["πολέμων",710605,81],["καὶ",707031,7],["τῶν",709436,130],["ἀνδραγαθιῶν",701098,65],["ὧν",709781,252],["ἐποίησεν",710582,2],["καὶ",707031,7],["τῆς",709436,16],["μεγαλωσύνης",708652,17],["αὐτοῦ",702165,102],["οὐ",709805,28],["κατεγράφη",707231,37],["πολλὰ",710646,195],["γὰρ",702963,11],["ἦν",704093,13],["σφόδρα",712586,28]],"As for the other things concerning Judas and his wars, and the noble acts which he did, and his greatness, they are not written, for they were very many."],["23",[["καὶ",707031,7],["ἐγένετο",703104,23],["μετὰ",708780,0],["τὴν",709436,8],["τελευτὴν",712782,9],["Ιουδου",706775,18],["ἐξέκυψαν",704229,150],["οἱ",709436,136],["ἄνομοι",701194,138],["ἐν",704639,0],["πᾶσιν",710177,94],["τοῖς",709436,95],["ὁρίοις",709749,96],["Ισραηλ",706839,18],["καὶ",707031,7],["ἀνέτειλαν",701066,150],["πάντες",710177,138],["οἱ",709436,136],["ἐργαζόμενοι",705383,348],["τὴν",709436,8],["ἀδικίαν",700271,9]],"Now after the death of Judas the wicked began to put forth their heads in all the coasts of Israel, and there arose up all such as wrought iniquity."],["24",[["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ἐκείναις",704183,200],["ἐγενήθη",703104,37],["λιμὸς",708210,4],["μέγας",708653,14],["σφόδρα",712586,28],["καὶ",707031,7],["αὐτομόλησεν",702164,2],["ἡ",709436,10],["χώρα",714011,12],["μετ᾿",708780,0],["αὐτῶν",702165,40]],"In those days also was there a very great famine, by reason whereof the country revolted, and went with them."],["25",[["καὶ",707031,7],["ἐξέλεξεν",704236,2],["Βακχίδης",702461,4],["τοὺς",709436,58],["ἀσεβεῖς",701909,60],["ἄνδρας",701150,57],["καὶ",707031,7],["κατέστησεν",707011,2],["αὐτοὺς",702165,62],["κυρίους",707996,57],["τῆς",709436,16],["χώρας",714011,17]],"Then Bacchides chose the wicked men, and made them lords of the country."],["26",[["καὶ",707031,7],["ἐξεζήτουν",704187,137],["καὶ",707031,7],["ἠρεύνων",705412,137],["τοὺς",709436,58],["φίλους",713492,60],["Ιουδου",706775,18],["καὶ",707031,7],["ἦγον",700209,137],["αὐτοὺς",702165,62],["πρὸς",710844,0],["Βακχίδην",702461,6],["καὶ",707031,7],["ἐξεδίκα",704174,13],["αὐτοὺς",702165,62],["καὶ",707031,7],["ἐνέπαιζεν",704583,13],["αὐτοῖς",702165,151]],"And they made enquiry and search for Judas' friends, and brought them unto Bacchides, who took vengeance of them, and used them despitefully."],["27",[["καὶ",707031,7],["ἐγένετο",703104,23],["θλῖψις",706276,12],["μεγάλη",708653,29],["ἐν",704639,0],["τῷ",709436,113],["Ισραηλ",706839,114],["ἥτις",709793,412],["οὐκ",709805,28],["ἐγένετο",703104,23],["ἀφ᾿",701425,0],["ἧς",709781,167],["ἡμέρας",705984,17],["οὐκ",709805,28],["ὤφθη",709725,37],["προφήτης",711009,4],["αὐτοῖς",702165,151]],"So was there a great affliction in Israel, the like whereof was not since the time that a prophet was not seen among them."],["28",[["καὶ",707031,7],["ἠθροίσθησαν",700384,99],["πάντες",710177,138],["οἱ",709436,136],["φίλοι",713492,138],["Ιουδου",706775,18],["καὶ",707031,7],["εἶπον",705373,150],["τῷ",709436,113],["Ιωναθαν",706927,114]],"For this cause all Judas' friends came together, and said unto Jonathan,"],["29",[["ἀφ᾿",701425,0],["οὗ",709781,48],["ὁ",709436,3],["ἀδελφός",700249,4],["σου",711945,133],["Ιουδας",706775,4],["τετελεύτηκεν",712781,171],["καὶ",707031,7],["ἀνὴρ",701150,4],["ὅμοιος",709626,14],["αὐτῷ",702165,50],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐξελθεῖν",704909,106],["καὶ",707031,7],["εἰσελθεῖν",704114,106],["πρὸς",710844,0],["τοὺς",709436,58],["ἐχθροὺς",705779,60],["καὶ",707031,7],["Βακχίδην",702461,6],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,147],["ἐχθραίνουσιν",705776,349],["τοῦ",709436,20],["ἔθνους",704068,21],["ἡμῶν",705999,145]],"Since thy brother Judas died, we have no man like him to go forth against our enemies, and Bacchides, and against them of our nation that are adversaries to us."],["30",[["νῦν",709384,28],["οὖν",709835,11],["σὲ",711598,163],["ᾑρετισάμεθα",700469,316],["σήμερον",711751,28],["τοῦ",709436,20],["εἶναι",704093,55],["ἀντ᾿",701227,0],["αὐτοῦ",702165,102],["ἡμῖν",705994,90],["εἰς",704105,0],["ἄρχοντα",701862,6],["καὶ",707031,7],["ἡγούμενον",705931,212],["τοῦ",709436,20],["πολεμῆσαι",710601,106],["τὸν",709436,5],["πόλεμον",710605,6],["ἡμῶν",705999,145]],"Now therefore we have chosen thee this day to be our prince and captain in his stead, that thou mayest fight our battles."],["31",[["καὶ",707031,7],["ἐπεδέξατο",705117,23],["Ιωναθαν",706927,4],["ἐν",704639,0],["τῷ",709436,113],["καιρῷ",707047,114],["ἐκείνῳ",704183,50],["τὴν",709436,8],["ἥγησιν",705933,9],["καὶ",707031,7],["ἀνέστη",701173,2],["ἀντὶ",701227,0],["Ιουδου",706775,18],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["αὐτοῦ",702165,102]],"Upon this Jonathan took the governance upon him at that time, and rose up instead of his brother Judas."],["32",[["καὶ",707031,7],["ἔγνω",703105,2],["Βακχίδης",702461,4],["καὶ",707031,7],["ἐζήτει",705879,13],["αὐτὸν",702165,85],["ἀποκτεῖναι",701498,106]],"But when Bacchides gat knowledge thereof, he sought for to slay him."],["33",[["καὶ",707031,7],["ἔγνω",703105,2],["Ιωναθαν",706927,4],["καὶ",707031,7],["Σιμων",711792,4],["ὁ",709436,3],["ἀδελφὸς",700249,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔφυγον",713433,150],["εἰς",704105,0],["τὴν",709436,8],["ἔρημον",705420,9],["Θεκωε",706162,9],["καὶ",707031,7],["παρενέβαλον",710132,150],["ἐπὶ",705080,0],["τὸ",709436,24],["ὕδωρ",713071,25],["λάκκου",708067,18],["Ασφαρ",702047,118]],"Then Jonathan, and Simon his brother, and all that were with him, perceiving that, fled into the wilderness of Thecoe, and pitched their tents by the water of the pool Asphar."],["34",[["καὶ",707031,7],["ἔγνω",703105,2],["Βακχίδης",702461,4],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῶν",709436,43],["σαββάτων",711350,44],["καὶ",707031,7],["ἦλθεν",705453,2],["αὐτὸς",702165,121],["καὶ",707031,7],["πᾶν",710177,26],["τὸ",709436,34],["στράτευμα",712139,15],["αὐτοῦ",702165,102],["πέραν",710280,28],["τοῦ",709436,35],["Ιορδάνου",706763,18]],"Which when Bacchides understood, he came near to Jordan with all his host upon the sabbath day."],["35",[["καὶ",707031,7],["ἀπέστειλεν",701592,2],["τὸν",709436,5],["ἀδελφὸν",700249,6],["αὐτοῦ",702165,102],["ἡγούμενον",705931,212],["τοῦ",709436,35],["ὄχλου",709884,18],["καὶ",707031,7],["παρεκάλεσεν",710039,2],["τοὺς",709436,58],["Ναβαταίους",709136,57],["φίλους",713492,60],["αὐτοῦ",702165,102],["τοῦ",709436,20],["παραθέσθαι",710111,109],["αὐτοῖς",702165,151],["τὴν",709436,8],["ἀποσκευὴν",701573,9],["αὐτῶν",702165,40],["τὴν",709436,8],["πολλήν",710646,36]],"Now Jonathan had sent his brother [John], a captain of the people, to pray his friends the Nabathites, that they might leave with them their carriage, which was much."],["36",[["καὶ",707031,7],["ἐξῆλθον",704909,150],["οἱ",709436,136],["υἱοὶ",713075,52],["Ιαμβρι",706406,18],["οἱ",709436,136],["ἐκ",704132,0],["Μηδαβα",708852,118],["καὶ",707031,7],["συνέλαβον",712262,150],["Ιωαννην",706892,6],["καὶ",707031,7],["πάντα",710177,68],["ὅσα",709788,68],["εἶχεν",705785,13],["καὶ",707031,7],["ἀπῆλθον",701398,150],["ἔχοντες",705785,146]],"But the children of Jambri came out of Medaba, and took John, and all that he had, and went their way with it."],["37",[["μετὰ",708780,0],["τοὺς",709436,58],["λόγους",708236,57],["τούτους",709858,62],["ἀπήγγειλαν",701321,150],["Ιωναθαν",706927,114],["καὶ",707031,7],["Σιμωνι",711792,114],["τῷ",709436,113],["ἀδελφῷ",700249,114],["αὐτοῦ",702165,102],["ὅτι",709803,7],["υἱοὶ",713075,52],["Ιαμβρι",706406,18],["ποιοῦσιν",710582,197],["γάμον",702957,6],["μέγαν",708653,27],["καὶ",707031,7],["ἄγουσιν",700209,197],["τὴν",709436,8],["νύμφην",709381,9],["ἀπὸ",701425,0],["Ναδαβαθ",709157,118],["θυγατέρα",706320,9],["ἑνὸς",704106,116],["τῶν",709436,80],["μεγάλων",708653,169],["μεγιστάνων",708657,81],["Χανααν",713708,118],["μετὰ",708780,0],["παραπομπῆς",710093,17],["μεγάλης",708653,82]],"After this came word to Jonathan and Simon his brother, that the children of Jambri made a great marriage, and were bringing the bride from Nadabatha with a great train, as being the daughter of one of the great princes of Chanaan."],["38",[["καὶ",707031,7],["ἐμνήσθησαν",708960,99],["τοῦ",709436,20],["αἵματος",700442,21],["Ιωαννου",706892,18],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["αὐτῶν",702165,40],["καὶ",707031,7],["ἀνέβησαν",700905,150],["καὶ",707031,7],["ἐκρύβησαν",707923,99],["ὑπὸ",713184,0],["τὴν",709436,8],["σκέπην",711839,9],["τοῦ",709436,20],["ὄρους",709768,21]],"Therefore they remembered John their brother, and went up, and hid themselves under the covert of the mountain:"],["39",[["καὶ",707031,7],["ἦραν",700473,150],["τοὺς",709436,58],["ὀφθαλμοὺς",709870,57],["αὐτῶν",702165,40],["καὶ",707031,7],["εἶδον",709725,150],["καὶ",707031,7],["ἰδοὺ",706497,88],["θροῦς",706316,4],["καὶ",707031,7],["ἀποσκευὴ",701573,12],["πολλή",710646,29],["καὶ",707031,7],["ὁ",709436,3],["νυμφίος",709382,4],["ἐξῆλθεν",704909,2],["καὶ",707031,7],["οἱ",709436,136],["φίλοι",713492,138],["αὐτοῦ",702165,102],["καὶ",707031,7],["οἱ",709436,136],["ἀδελφοὶ",700249,52],["αὐτοῦ",702165,102],["εἰς",704105,0],["συνάντησιν",712397,9],["αὐτῶν",702165,40],["μετὰ",708780,0],["τυμπάνων",713019,44],["καὶ",707031,7],["μουσικῶν",709034,169],["καὶ",707031,7],["ὅπλων",709704,44],["πολλῶν",710646,83]],"where they lifted up their eyes, and looked, and, behold, there was much ado and great carriage: and the bridegroom came forth, and his friends and brethren, to meet them with drums, and instruments of music, and many weapons."],["40",[["καὶ",707031,7],["ἐξανέστησαν",704865,150],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["ἀπὸ",701425,0],["τοῦ",709436,20],["ἐνέδρου",704704,21],["καὶ",707031,7],["ἀπέκτειναν",701498,150],["αὐτούς",702165,62],["καὶ",707031,7],["ἔπεσον",710481,150],["τραυματίαι",712921,52],["πολλοί",710646,138],["καὶ",707031,7],["οἱ",709436,136],["ἐπίλοιποι",705194,138],["ἔφυγον",713433,150],["εἰς",704105,0],["τὸ",709436,24],["ὄρος",709768,25],["καὶ",707031,7],["ἔλαβον",708076,150],["πάντα",710177,68],["τὰ",709436,41],["σκῦλα",711902,42],["αὐτῶν",702165,40]],"Then Jonathan and they that were with him rose up against them from the place where they lay in ambush, and made a slaughter of them in such sort, as many fell down dead, and the remnant fled into the mountain, and they took all their spoils."],["41",[["καὶ",707031,7],["μετεστράφη",708817,37],["ὁ",709436,3],["γάμος",702957,4],["εἰς",704105,0],["πένθος",710253,25],["καὶ",707031,7],["φωνὴ",713640,12],["μουσικῶν",709034,169],["αὐτῶν",702165,40],["εἰς",704105,0],["θρῆνον",706309,6]],"Thus was the marriage turned into mourning, and the noise of their melody into lamentation."],["42",[["καὶ",707031,7],["ἐξεδίκησαν",704173,150],["τὴν",709436,8],["ἐκδίκησιν",704175,9],["αἵματος",700442,21],["ἀδελφοῦ",700249,18],["αὐτῶν",702165,40],["καὶ",707031,7],["ἀπέστρεψαν",701598,150],["εἰς",704105,0],["τὸ",709436,24],["ἕλος",704527,25],["τοῦ",709436,35],["Ιορδάνου",706763,18]],"So when they had avenged fully the blood of their brother, they turned again to the marsh of Jordan."],["43",[["καὶ",707031,7],["ἤκουσεν",700587,2],["Βακχίδης",702461,4],["καὶ",707031,7],["ἦλθεν",705453,2],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῶν",709436,43],["σαββάτων",711350,44],["ἕως",705792,28],["τῶν",709436,130],["κρηπίδων",707897,65],["τοῦ",709436,35],["Ιορδάνου",706763,18],["ἐν",704639,0],["δυνάμει",703839,1],["πολλῇ",710646,101]],"Now when Bacchides heard hereof, he came on the sabbath day unto the banks of Jordan with a great power."],["44",[["καὶ",707031,7],["εἶπεν",705373,2],["Ιωναθαν",706927,4],["τοῖς",709436,147],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["ἀναστῶμεν",701173,79],["δὴ",703395,11],["καὶ",707031,7],["πολεμήσωμεν",710601,79],["περὶ",710285,0],["τῶν",709436,130],["ψυχῶν",714070,65],["ἡμῶν",705999,145],["οὐ",709805,28],["γάρ",702963,11],["ἐστιν",704093,91],["σήμερον",711751,28],["ὡς",714148,7],["ἐχθὲς",713853,28],["καὶ",707031,7],["τρίτην",712968,36],["ἡμέραν",705984,9]],"Then Jonathan said to his company, Let us go up now and fight for our lives, for it standeth not with us to day, as in time past:"],["45",[["ἰδοὺ",706497,88],["γὰρ",702963,11],["ὁ",709436,3],["πόλεμος",710605,4],["ἐξ",704132,0],["ἐναντίας",704656,82],["καὶ",707031,7],["ἐξόπισθεν",704962,28],["ἡμῶν",705999,145],["τὸ",709436,34],["δὲ",703303,11],["ὕδωρ",713071,15],["τοῦ",709436,35],["Ιορδάνου",706763,18],["ἔνθεν",704732,28],["καὶ",707031,7],["ἔνθεν",704732,28],["καὶ",707031,7],["ἕλος",704527,15],["καὶ",707031,7],["δρυμός",703836,4],["οὐκ",709805,28],["ἔστιν",704093,91],["τόπος",712903,4],["τοῦ",709436,20],["ἐκκλῖναι",704220,106]],"for, behold, the battle is before us and behind us, and the water of Jordan on this side and that side, the marsh likewise and wood, neither is there place for us to turn aside."],["46",[["νῦν",709384,28],["οὖν",709835,11],["κεκράξατε",707868,74],["εἰς",704105,0],["τὸν",709436,5],["οὐρανόν",709844,6],["ὅπως",709719,7],["διασωθῆτε",703599,394],["ἐκ",704132,0],["χειρὸς",713787,17],["τῶν",709436,80],["ἐχθρῶν",705779,169],["ἡμῶν",705999,145]],"Wherefore cry ye now unto heaven, that ye may be delivered from the hand of your enemies."],["47",[["καὶ",707031,7],["συνῆψεν",712404,2],["ὁ",709436,3],["πόλεμος",710605,4],["καὶ",707031,7],["ἐξέτεινεν",704322,2],["Ιωναθαν",706927,4],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102],["πατάξαι",710185,106],["τὸν",709436,5],["Βακχίδην",702461,6],["καὶ",707031,7],["ἐξέκλινεν",704220,13],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὰ",709436,41],["ὀπίσω",709697,28]],"With that they joined battle, and Jonathan stretched forth his hand to smite Bacchides, but he turned back from him."],["48",[["καὶ",707031,7],["ἐνεπήδησεν",704591,2],["Ιωναθαν",706927,4],["καὶ",707031,7],["οἱ",709436,136],["μετ᾿",708780,0],["αὐτοῦ",702165,102],["εἰς",704105,0],["τὸν",709436,5],["Ιορδάνην",706763,6],["καὶ",707031,7],["διεκολύμβησαν",703475,150],["εἰς",704105,0],["τὸ",709436,24],["πέραν",710280,28],["καὶ",707031,7],["οὐ",709805,28],["διέβησαν",703419,150],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["τὸν",709436,5],["Ιορδάνην",706763,6]],"Then Jonathan and they that were with him leapt into Jordan, and swam over unto the farther bank: howbeit the other passed not over Jordan unto them."],["49",[["ἔπεσον",710481,150],["δὲ",703303,11],["παρὰ",709995,0],["Βακχίδου",702461,18],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["εἰς",704105,0],["χιλίους",713859,60],["ἄνδρας",701150,57]],"So there were slain of Bacchides' side that day about a thousand men."],["50",