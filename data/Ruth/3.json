[["1",[["εἶπεν",705373,2],["δὲ",703303,11],["αὐτῇ",702165,105],["Νωεμιν",709396,12],["ἡ",709436,10],["πενθερὰ",710249,12],["αὐτῆς",702165,86],["θύγατερ",706320,258],["οὐ",709805,28],["μὴ",708851,28],["ζητήσω",705879,207],["σοι",712181,550],["ἀνάπαυσιν",701026,9],["ἵνα",706747,7],["εὖ",705544,28],["γένηταί",703104,239],["σοι",712181,550]],"And she lodged with her mother-in-law: and Noemin her mother-in-law said to her, My daughter, shall I not seek rest for thee, that it may be well with thee?"],["2",[["καὶ",707031,7],["νῦν",709384,28],["οὐχὶ",709862,28],["Βοος",702760,4],["γνώριμος",703136,14],["ἡμῶν",705999,546],["οὗ",709781,48],["ἦς",704093,363],["μετὰ",708780,0],["τῶν",709436,43],["κορασίων",707832,44],["αὐτοῦ",702165,102],["ἰδοὺ",706497,88],["αὐτὸς",702165,121],["λικμᾷ",708202,91],["τὸν",709436,5],["ἅλωνα",700741,6],["τῶν",709436,130],["κριθῶν",707900,65],["ταύτῃ",709858,105],["τῇ",709436,100],["νυκτί",709386,1]],"And now [is] not Booz our kinsman, with whose damsels thou wast? behold, he winnows barley this night in the floor."],["3",[["σὺ",712181,553],["δὲ",703303,11],["λούσῃ",708258,123],["καὶ",707031,7],["ἀλείψῃ",700644,123],["καὶ",707031,7],["περιθήσεις",710403,166],["τὸν",709436,5],["ἱματισμόν",706744,6],["σου",712181,547],["ἐπὶ",705080,0],["σεαυτῇ",711599,105],["καὶ",707031,7],["ἀναβήσῃ",700905,123],["ἐπὶ",705080,0],["τὸν",709436,5],["ἅλω",700741,6],["μὴ",708851,28],["γνωρισθῇς",703135,279],["τῷ",709436,113],["ἀνδρὶ",701150,114],["ἕως",705792,7],["οὗ",709781,48],["συντελέσαι",712510,106],["αὐτὸν",702165,85],["πιεῖν",710478,106],["καὶ",707031,7],["φαγεῖν",713296,106]],"But do thou wash, and anoint thyself, and put thy raiment upon thee, and go up to the threshing-floor: do not discover thyself to the man until he has done eating and drinking."],["4",[["καὶ",707031,7],["ἔσται",704093,93],["ἐν",704639,0],["τῷ",709436,53],["κοιμηθῆναι",707767,179],["αὐτόν",702165,85],["καὶ",707031,7],["γνώσῃ",703105,123],["τὸν",709436,5],["τόπον",712903,6],["ὅπου",709710,28],["κοιμᾶται",707767,117],["ἐκεῖ",704181,28],["καὶ",707031,7],["ἐλεύσῃ",705453,123],["καὶ",707031,7],["ἀποκαλύψεις",701475,166],["τὰ",709436,41],["πρὸς",710844,0],["ποδῶν",710707,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["κοιμηθήσῃ",707767,364],["καὶ",707031,7],["αὐτὸς",702165,121],["ἀπαγγελεῖ",701321,127],["σοι",712181,550],["ἃ",709781,69],["ποιήσεις",710582,166]],"And it shall come to pass when he lies down, that thou shalt mark the place where he lies down, and shalt come and lift up the covering of his feet, and shalt lie down; and he shall tell thee what thou shalt do."],["5",[["εἶπεν",705373,2],["δὲ",703303,11],["Ρουθ",711297,12],["πρὸς",710844,0],["αὐτήν",702165,104],["πάντα",710177,68],["ὅσα",709788,68],["ἐὰν",703912,7],["εἴπῃς",705373,175],["ποιήσω",710582,165]],"And Ruth said to her, All that thou shalt say, I will do."],["6",[["καὶ",707031,7],["κατέβη",707202,2],["εἰς",704105,0],["τὸν",709436,5],["ἅλω",700741,6],["καὶ",707031,7],["ἐποίησεν",710582,2],["κατὰ",707200,0],["πάντα",710177,68],["ὅσα",709788,68],["ἐνετείλατο",704791,23],["αὐτῇ",702165,105],["ἡ",709436,10],["πενθερὰ",710249,12],["αὐτῆς",702165,86]],"And she went down to the threshing-floor, and did according to all that her mother-in-law enjoined her."],["7",[["καὶ",707031,7],["ἔφαγεν",713296,2],["Βοος",702760,4],["καὶ",707031,7],["ἠγαθύνθη",700109,37],["ἡ",709436,10],["καρδία",707141,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἦλθεν",705453,2],["κοιμηθῆναι",707767,179],["ἐν",704639,0],["μερίδι",708748,1],["τῆς",709436,16],["στοιβῆς",712116,17],["ἡ",709436,10],["δὲ",703303,11],["ἦλθεν",705453,2],["κρυφῇ",707929,28],["καὶ",707031,7],["ἀπεκάλυψεν",701474,2],["τὰ",709436,41],["πρὸς",710844,0],["ποδῶν",710707,81],["αὐτοῦ",702165,102]],"And Booz ate and drank, and his heart was glad, and he came to lie down by the side of the heap of corn; and she came secretly, and lifted up the covering of his feet."],["8",[["ἐγένετο",703104,23],["δὲ",703303,11],["ἐν",704639,0],["τῷ",709436,53],["μεσονυκτίῳ",708765,54],["καὶ",707031,7],["ἐξέστη",704940,2],["ὁ",709436,3],["ἀνὴρ",701150,4],["καὶ",707031,7],["ἐταράχθη",712721,37],["καὶ",707031,7],["ἰδοὺ",706497,88],["γυνὴ",703209,12],["κοιμᾶται",707767,117],["πρὸς",710844,0],["ποδῶν",710707,81],["αὐτοῦ",702165,102]],"And it came to pass at midnight that the man was amazed, and troubled, and behold, a woman lay at his feet."],["9",[["εἶπεν",705373,2],["δέ",703303,11],["τίς",712867,359],["εἶ",704093,154],["σύ",712181,553],["ἡ",709436,10],["δὲ",703303,11],["εἶπεν",705373,2],["ἐγώ",704018,553],["εἰμι",704093,157],["Ρουθ",711297,12],["ἡ",709436,10],["δούλη",703815,12],["σου",712181,559],["καὶ",707031,7],["περιβαλεῖς",710294,166],["τὸ",709436,24],["πτερύγιόν",711056,25],["σου",712181,559],["ἐπὶ",705080,0],["τὴν",709436,8],["δούλην",703815,9],["σου",712181,559],["ὅτι",709803,7],["ἀγχιστεὺς",700203,4],["εἶ",704093,154],["σύ",712181,561]],"And he said, Who art thou? and she said, I am thine handmaid Ruth; spread therefore thy skirt over thine handmaid, for thou art a near relation."],["10",[["καὶ",707031,7],["εἶπεν",705373,2],["Βοος",702760,4],["εὐλογημένη",705631,451],["σὺ",712181,553],["τῷ",709436,113],["κυρίῳ",707996,114],["θεῷ",706192,114],["θύγατερ",706320,258],["ὅτι",709803,7],["ἠγάθυνας",700109,162],["τὸ",709436,24],["ἔλεός",704426,25],["σου",712181,547],["τὸ",709436,24],["ἔσχατον",705519,46],["ὑπὲρ",713111,0],["τὸ",709436,24],["πρῶτον",711041,46],["τὸ",709436,24],["μὴ",708851,28],["πορευθῆναί",710667,179],["σε",712181,551],["ὀπίσω",709697,0],["νεανιῶν",709229,81],["εἴτοι",704131,7],["πτωχὸς",711076,14],["εἴτοι",704131,7],["πλούσιος",710560,14]],"And Booz said, Blessed [be] thou of the Lord God, [my] daughter, for thou hast made thy latter kindness greater than the former, in that thou followest not after young men, whether [any be] poor or rich."],["11",[["καὶ",707031,7],["νῦν",709384,28],["θύγατερ",706320,258],["μὴ",708851,28],["φοβοῦ",713532,253],["πάντα",710177,68],["ὅσα",709788,68],["ἐὰν",703912,7],["εἴπῃς",705373,175],["ποιήσω",710582,165],["σοι",712181,550],["οἶδεν",709492,171],["γὰρ",702963,11],["πᾶσα",710177,29],["φυλὴ",713620,12],["λαοῦ",708094,18],["μου",704018,559],["ὅτι",709803,7],["γυνὴ",703209,12],["δυνάμεως",703839,17],["εἶ",704093,154],["σύ",712181,553]],"And now fear not, my daughter, whatever thou shalt say I will do to thee; for all the tribe of my people knows that thou art a virtuous woman."],["12",[["καὶ",707031,7],["ὅτι",709803,7],["ἀληθῶς",700662,28],["ἀγχιστεὺς",700203,4],["ἐγώ",704018,561],["εἰμι",704093,157],["καί",707031,7],["γε",702985,11],["ἔστιν",704093,91],["ἀγχιστεὺς",700203,4],["ἐγγίων",703948,224],["ὑπὲρ",713111,0],["ἐμέ",704018,556]],"And now I am truly akin to thee; nevertheless there is a kinsman nearer than I."],["13",[["αὐλίσθητι",702138,244],["τὴν",709436,8],["νύκτα",709386,9],["καὶ",707031,7],["ἔσται",704093,93],["τὸ",709436,34],["πρωί",711021,28],["ἐὰν",703912,7],["ἀγχιστεύσῃ",700205,172],["σε",712181,551],["ἀγαθόν",700106,562],["ἀγχιστευέτω",700205,31],["ἐὰν",703912,7],["δὲ",703303,11],["μὴ",708851,28],["βούληται",702795,428],["ἀγχιστεῦσαί",700205,106],["σε",712181,551],["ἀγχιστεύσω",700205,165],["σε",712181,551],["ἐγώ",704018,561],["ζῇ",705851,91],["κύριος",707996,4],["κοιμήθητι",707767,244],["ἕως",705792,7],["πρωί",711021,28]],"Lodge [here] for the night, and it shall be in the morning, if he will do the part of a kinsman to thee, well—let him do it: but if he will not do the part of a kinsman to thee, I will do the kinsman's part to thee, [as] the Lord lives; lie down till the morning."],["14",[["καὶ",707031,7],["ἐκοιμήθη",707767,37],["πρὸς",710844,0],["ποδῶν",710707,81],["αὐτοῦ",702165,102],["ἕως",705792,7],["πρωί",711021,28],["ἡ",709436,10],["δὲ",703303,11],["ἀνέστη",701173,2],["πρὸ",710747,0],["τοῦ",709436,20],["ἐπιγνῶναι",705104,106],["ἄνδρα",701150,6],["τὸν",709436,5],["πλησίον",710547,28],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["Βοος",702760,4],["μὴ",708851,28],["γνωσθήτω",703105,22],["ὅτι",709803,7],["ἦλθεν",705453,2],["γυνὴ",703209,12],["εἰς",704105,0],["τὸν",709436,5],["ἅλωνα",700741,6]],"And she lay at his feet until the morning; and she rose up before a man could know his neighbour; and Booz said, Let it not be known that a woman came into the floor."],["15",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῇ",702165,105],["φέρε",713428,240],["τὸ",709436,24],["περίζωμα",710316,25],["τὸ",709436,24],["ἐπάνω",705030,563],["σου",712181,547],["καὶ",707031,7],["ἐκράτησεν",707879,2],["αὐτό",702165,129],["καὶ",707031,7],["ἐμέτρησεν",708840,2],["ἓξ",704828,59],["κριθῶν",707900,65],["καὶ",707031,7],["ἐπέθηκεν",705304,2],["ἐπ᾿",705080,0],["αὐτήν",702165,104],["καὶ",707031,7],["εἰσῆλθεν",704114,2],["εἰς",704105,0],["τὴν",709436,8],["πόλιν",710612,9]],"And he said to her, Bring the apron that is upon thee: and she held it, and he measured six measures of barley, and put them upon her, and she went into the city."],["16",[["καὶ",707031,7],["Ρουθ",711297,12],["εἰσῆλθεν",704114,2],["πρὸς",710844,0],["τὴν",709436,8],["πενθερὰν",710249,9],["αὐτῆς",702165,86],["ἡ",709436,10],["δὲ",703303,11],["εἶπεν",705373,2],["τίς",712867,359],["εἶ",704093,154],["θύγατερ",706320,258],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῇ",702165,105],["πάντα",710177,68],["ὅσα",709788,68],["ἐποίησεν",710582,2],["αὐτῇ",702165,105],["ὁ",709436,3],["ἀνήρ",701150,4]],"And Ruth went in to her mother-in-law, and she said to her, [My] daughter! and [Ruth] told her all that the man had done to her."],["17",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῇ",702165,105],["τὰ",709436,41],["ἓξ",704828,59],["τῶν",709436,130],["κριθῶν",707900,65],["ταῦτα",709858,71],["ἔδωκέν",703654,2],["μοι",704018,550],["ὅτι",709803,7],["εἶπεν",705373,2],["πρός",710844,0],["με",704018,551],["μὴ",708851,28],["εἰσέλθῃς",704114,175],["κενὴ",707612,29],["πρὸς",710844,0],["τὴν",709436,8],["πενθεράν",710249,9],["σου",712181,547]],"And she said to her, He gave me these six measures of barley, for he said to me, Go not empty to thy mother-in-law."],["18",[["ἡ",709436,10],["δὲ",703303,11],["εἶπεν",705373,2],["κάθου",707000,253],["θύγατερ",706320,258],["ἕως",705792,7],["τοῦ",709436,20],["ἐπιγνῶναί",705104,106],["σε",712181,551],["πῶς",711121,28],["οὐ",709805,28],["πεσεῖται",710481,93],["ῥῆμα",711246,15],["οὐ",709805,28],["γὰρ",702963,11],["μὴ",708851,28],["ἡσυχάσῃ",706033,172],["ὁ",709436,3],["ἀνήρ",701150,4],["ἕως",705792,7],["ἂν",700900,11],["τελέσῃ",712783,172],["τὸ",709436,34],["ῥῆμα",711246,15],["σήμερον",711751,28]],"And she said, Sit still, [my] daughter, until thou shalt know how the matter will fall out; for the man will not rest until the matter be accomplished this day."]]