[["1",[["καὶ",707031,7],["Βοος",702760,4],["ἀνέβη",700905,2],["ἐπὶ",705080,0],["τὴν",709436,8],["πύλην",711082,9],["καὶ",707031,7],["ἐκάθισεν",707006,2],["ἐκεῖ",704181,28],["καὶ",707031,7],["ἰδοὺ",706497,88],["ὁ",709436,3],["ἀγχιστευτὴς",700204,4],["παρεπορεύετο",710094,19],["ὃν",709781,112],["εἶπεν",705373,2],["Βοος",702760,4],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτὸν",702165,85],["Βοος",702760,4],["ἐκκλίνας",704220,182],["κάθισον",707006,176],["ὧδε",714090,28],["κρύφιε",707930,564],["καὶ",707031,7],["ἐξέκλινεν",704220,13],["καὶ",707031,7],["ἐκάθισεν",707006,2]],"And Booz went up to the gate, and sat there; and behold, the relative passed by, of whom Booz spoke: and Booz said to him, Turn aside, sit down here, such a one: and he turned aside and sat down."],["2",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Βοος",702760,4],["δέκα",703333,59],["ἄνδρας",701150,57],["ἀπὸ",701425,0],["τῶν",709436,80],["πρεσβυτέρων",710735,527],["τῆς",709436,16],["πόλεως",710612,17],["καὶ",707031,7],["εἶπεν",705373,2],["καθίσατε",707006,74],["ὧδε",714090,28],["καὶ",707031,7],["ἐκάθισαν",707006,150]],"And Booz took ten men of the elders of the city, and said, Sit ye here; and they sat down."],["3",[["καὶ",707031,7],["εἶπεν",705373,2],["Βοος",702760,4],["τῷ",709436,113],["ἀγχιστεῖ",700203,114],["τὴν",709436,8],["μερίδα",708748,9],["τοῦ",709436,35],["ἀγροῦ",700196,18],["ἥ",709781,177],["ἐστιν",704093,91],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["ἡμῶν",705999,565],["τοῦ",709436,35],["Αβιμελεχ",700068,18],["ἣ",709781,177],["δέδοται",703654,187],["Νωεμιν",709396,1],["τῇ",709436,100],["ἐπιστρεφούσῃ",705278,220],["ἐξ",704132,0],["ἀγροῦ",700196,18],["Μωαβ",709085,118]],"And Booz said to the relative, [The matter regards] the portion of the field which was our brother Elimelech's which was given to Noemin, now returning out of the land of Moab;"],["4",[["κἀγὼ",706969,566],["εἶπα",705373,155],["ἀποκαλύψω",701474,165],["τὸ",709436,24],["οὖς",709852,25],["σου",712181,559],["λέγων",708124,72],["κτῆσαι",707932,300],["ἐναντίον",704656,567],["τῶν",709436,80],["καθημένων",707000,299],["καὶ",707031,7],["ἐναντίον",704656,567],["τῶν",709436,80],["πρεσβυτέρων",710735,527],["τοῦ",709436,35],["λαοῦ",708094,18],["μου",704018,559],["εἰ",704071,7],["ἀγχιστεύεις",700205,154],["ἀγχίστευε",700205,240],["εἰ",704071,7],["δὲ",703303,11],["μὴ",708851,28],["ἀγχιστεύεις",700205,154],["ἀνάγγειλόν",700921,176],["μοι",704018,560],["καὶ",707031,7],["γνώσομαι",703105,181],["ὅτι",709803,7],["οὐκ",709805,28],["ἔστιν",704093,91],["πάρεξ",710136,0],["σοῦ",712181,559],["τοῦ",709436,20],["ἀγχιστεῦσαι",700205,106],["κἀγώ",706969,566],["εἰμι",704093,157],["μετὰ",708780,0],["σέ",712181,556],["ὁ",709436,3],["δὲ",703303,11],["εἶπεν",705373,2],["ἐγώ",704018,561],["εἰμι",704093,157],["ἀγχιστεύσω",700205,165]],"and I said, I will inform thee, saying, Buy it before those that sit, and before the elders of my people: if thou wilt redeem it, redeem it, but if thou wilt not redeem it, tell me, and I shall know; for there is no one beside thee to do the office of a kinsman, and I am after thee: and he said, I am [here], I will redeem it."],["5",[["καὶ",707031,7],["εἶπεν",705373,2],["Βοος",702760,4],["ἐν",704639,0],["ἡμέρᾳ",705984,1],["τοῦ",709436,20],["κτήσασθαί",707932,109],["σε",712181,556],["τὸν",709436,5],["ἀγρὸν",700196,6],["ἐκ",704132,0],["χειρὸς",713787,17],["Νωεμιν",709396,18],["καὶ",707031,7],["παρὰ",709995,0],["Ρουθ",711297,17],["τῆς",709436,16],["Μωαβίτιδος",709089,82],["γυναικὸς",703209,17],["τοῦ",709436,35],["τεθνηκότος",706278,310],["καὶ",707031,7],["αὐτὴν",702165,104],["κτήσασθαί",707932,109],["σε",712181,556],["δεῖ",703312,91],["ὥστε",714164,7],["ἀναστῆσαι",701173,106],["τὸ",709436,24],["ὄνομα",709666,25],["τοῦ",709436,35],["τεθνηκότος",706278,310],["ἐπὶ",705080,0],["τῆς",709436,16],["κληρονομίας",707725,17],["αὐτοῦ",702165,102]],"And Booz said, In the day of thy buying the field of the hand of Noemin and of Ruth the Moabitess the wife of the deceased, thou must also buy her, so as to raise up the name of the dead upon his inheritance."],["6",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["ἀγχιστεύς",700203,4],["οὐ",709805,28],["δυνήσομαι",703838,181],["ἀγχιστεῦσαι",700205,106],["ἐμαυτῷ",704545,50],["μήποτε",708882,28],["διαφθείρω",703624,157],["τὴν",709436,8],["κληρονομίαν",707725,9],["μου",704018,559],["ἀγχίστευσον",700205,176],["σεαυτῷ",711599,50],["τὴν",709436,8],["ἀγχιστείαν",700202,9],["μου",704018,559],["ὅτι",709803,7],["οὐ",709805,28],["δυνήσομαι",703838,181],["ἀγχιστεῦσαι",700205,106]],"And the kinsman said, I shall not be able to redeem it for myself, lest I mar my own inheritance; do thou redeem my right for thyself, for I shall not be able to redeem [it]."],["7",[["καὶ",707031,7],["τοῦτο",709858,132],["τὸ",709436,34],["δικαίωμα",703697,15],["ἔμπροσθεν",704618,28],["ἐν",704639,0],["τῷ",709436,113],["Ισραηλ",706839,4],["ἐπὶ",705080,0],["τὴν",709436,8],["ἀγχιστείαν",700202,9],["καὶ",707031,7],["ἐπὶ",705080,0],["τὸ",709436,24],["ἀντάλλαγμα",701209,25],["τοῦ",709436,20],["στῆσαι",706846,106],["πᾶν",710177,27],["λόγον",708236,6],["καὶ",707031,7],["ὑπελύετο",713217,19],["ὁ",709436,3],["ἀνὴρ",701150,4],["τὸ",709436,24],["ὑπόδημα",713195,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐδίδου",703654,13],["τῷ",709436,113],["πλησίον",710547,28],["αὐτοῦ",702165,102],["τῷ",709436,113],["ἀγχιστεύοντι",700205,379],["τὴν",709436,8],["ἀγχιστείαν",700202,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["τοῦτο",709858,132],["ἦν",704093,13],["μαρτύριον",708525,15],["ἐν",704639,0],["Ισραηλ",706839,114]],"And this [was] in former time the ordinance in Israel for redemption, and for a bargain, to confirm every word: A man loosed his shoe, and gave it to his neighbour that redeemed his right; and this was a testimony in Israel."],["8",[["καὶ",707031,7],["εἶπεν",705373,2],["ὁ",709436,3],["ἀγχιστεὺς",700203,4],["τῷ",709436,113],["Βοος",702760,114],["κτῆσαι",707932,300],["σεαυτῷ",711599,50],["τὴν",709436,8],["ἀγχιστείαν",700202,9],["μου",704018,559],["καὶ",707031,7],["ὑπελύσατο",713217,23],["τὸ",709436,24],["ὑπόδημα",713195,25],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50]],"And the kinsman said to Booz, Buy my right for thyself: and he took off his shoe and gave it to him."],["9",[["καὶ",707031,7],["εἶπεν",705373,2],["Βοος",702760,4],["τοῖς",709436,147],["πρεσβυτέροις",710735,532],["καὶ",707031,7],["παντὶ",710177,30],["τῷ",709436,113],["λαῷ",708094,114],["μάρτυρες",708527,52],["ὑμεῖς",713081,568],["σήμερον",711751,28],["ὅτι",709803,7],["κέκτημαι",707932,326],["πάντα",710177,68],["τὰ",709436,41],["τοῦ",709436,35],["Αβιμελεχ",700068,18],["καὶ",707031,7],["πάντα",710177,68],["ὅσα",709788,195],["ὑπάρχει",713104,91],["τῷ",709436,113],["Χελαιων",713800,114],["καὶ",707031,7],["τῷ",709436,113],["Μααλων",708301,114],["ἐκ",704132,0],["χειρὸς",713787,17],["Νωεμιν",709396,17]],"And Booz said to the elders and to all the people, Ye [are] this day witnesses, that I have bought all that was Elimelech's, and all that belonged to Chelaion and Maalon, of the hand of Noemin."],["10",[["καί",707031,7],["γε",702985,11],["Ρουθ",711297,9],["τὴν",709436,8],["Μωαβῖτιν",709089,36],["τὴν",709436,8],["γυναῖκα",703209,9],["Μααλων",708301,18],["κέκτημαι",707932,326],["ἐμαυτῷ",704545,50],["εἰς",704105,0],["γυναῖκα",703209,9],["τοῦ",709436,20],["ἀναστῆσαι",701173,106],["τὸ",709436,24],["ὄνομα",709666,25],["τοῦ",709436,35],["τεθνηκότος",706278,310],["ἐπὶ",705080,0],["τῆς",709436,16],["κληρονομίας",707725,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["οὐκ",709805,28],["ἐξολεθρευθήσεται",704956,134],["τὸ",709436,34],["ὄνομα",709666,15],["τοῦ",709436,35],["τεθνηκότος",706278,310],["ἐκ",704132,0],["τῶν",709436,80],["ἀδελφῶν",700249,81],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐκ",704132,0],["τῆς",709436,16],["φυλῆς",713620,17],["λαοῦ",708094,18],["αὐτοῦ",702165,102],["μάρτυρες",708527,52],["ὑμεῖς",713081,568],["σήμερον",711751,28]],"Moreover I have bought for myself for a wife Ruth the Moabitess, the wife of Maalon, to raise up the name of the dead upon his inheritance; so the name of the dead shall not be destroyed from among his brethren, and from the tribe of his people: ye [are] this day witnesses."],["11",[["καὶ",707031,7],["εἴποσαν",705415,150],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["οἱ",709436,136],["ἐν",704639,0],["τῇ",709436,100],["πύλῃ",711082,1],["μάρτυρες",708527,52],["καὶ",707031,7],["οἱ",709436,136],["πρεσβύτεροι",710735,267],["εἴποσαν",705415,150],["δῴη",703654,225],["κύριος",707996,4],["τὴν",709436,8],["γυναῖκά",703209,9],["σου",712181,559],["τὴν",709436,8],["εἰσπορευομένην",704124,173],["εἰς",704105,0],["τὸν",709436,5],["οἶκόν",709516,6],["σου",712181,559],["ὡς",714148,7],["Ραχηλ",711208,9],["καὶ",707031,7],["ὡς",714148,7],["Λειαν",708127,9],["αἳ",709781,256],["ᾠκοδόμησαν",709509,150],["ἀμφότεραι",700892,192],["τὸν",709436,5],["οἶκον",709516,6],["Ισραηλ",706839,18],["καὶ",707031,7],["ἐποίησαν",710582,150],["δύναμιν",703839,9],["ἐν",704639,0],["Εφραθα",705765,111],["καὶ",707031,7],["ἔσται",704093,93],["ὄνομα",709666,15],["ἐν",704639,0],["Βαιθλεεμ",702420,111]],"And all the people who were in the gate said, [We are] witnesses: and the elders said, The Lord make thy wife who goes into thy house, as Rachel and as Lia, who both [together] built the house of Israel, and wrought mightily in Ephratha, and there shall be a name [to thee] in Bethleem."],["12",[["καὶ",707031,7],["γένοιτο",703104,382],["ὁ",709436,3],["οἶκός",709516,4],["σου",712181,559],["ὡς",714148,7],["ὁ",709436,3],["οἶκος",709516,4],["Φαρες",713362,18],["ὃν",709781,112],["ἔτεκεν",712853,2],["Θαμαρ",706078,12],["τῷ",709436,113],["Ιουδα",706768,114],["ἐκ",704132,0],["τοῦ",709436,20],["σπέρματος",712008,21],["οὗ",709781,160],["δώσει",703654,127],["κύριός",707996,4],["σοι",712181,560],["ἐκ",704132,0],["τῆς",709436,16],["παιδίσκης",709928,17],["ταύτης",709858,86]],"And let thy house be as the house of Phares, whom Thamar bore to Juda, of the seed which the Lord shall give thee of this handmaid."],["13",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Βοος",702760,4],["τὴν",709436,8],["Ρουθ",711297,9],["καὶ",707031,7],["ἐγενήθη",703104,37],["αὐτῷ",702165,50],["εἰς",704105,0],["γυναῖκα",703209,9],["καὶ",707031,7],["εἰσῆλθεν",704114,2],["πρὸς",710844,0],["αὐτήν",702165,104],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῇ",702165,105],["κύριος",707996,4],["κύησιν",707953,9],["καὶ",707031,7],["ἔτεκεν",712853,2],["υἱόν",713075,6]],"And Booz took Ruth, and she became his wife, and he went in to her; and the Lord gave her conception, and she bore a son."],["14",[["καὶ",707031,7],["εἶπαν",705373,150],["αἱ",709436,190],["γυναῖκες",703209,191],["πρὸς",710844,0],["Νωεμιν",709396,9],["εὐλογητὸς",705632,14],["κύριος",707996,4],["ὃς",709781,213],["οὐ",709805,28],["κατέλυσέ",707323,2],["σοι",712181,550],["σήμερον",711751,28],["τὸν",709436,5],["ἀγχιστέα",700203,6],["καὶ",707031,7],["καλέσαι",707084,225],["τὸ",709436,34],["ὄνομά",709666,15],["σου",712181,547],["ἐν",704639,0],["Ισραηλ",706839,114]],"And the women said to Noemin, Blessed [is] the Lord, who has not suffered a redeemer to fail thee this day, even to make thy name famous in Israel."],["15",[["καὶ",707031,7],["ἔσται",704093,93],["σοι",712181,550],["εἰς",704105,0],["ἐπιστρέφοντα",705278,183],["ψυχὴν",714070,9],["καὶ",707031,7],["τοῦ",709436,20],["διαθρέψαι",703613,106],["τὴν",709436,8],["πολιάν",710607,9],["σου",712181,547],["ὅτι",709803,7],["ἡ",709436,10],["νύμφη",709381,12],["σου",712181,547],["ἡ",709436,10],["ἀγαπήσασά",700120,149],["σε",712181,551],["ἔτεκεν",712853,2],["αὐτόν",702165,85],["ἥ",709781,177],["ἐστιν",704093,91],["ἀγαθή",700106,29],["σοι",712181,550],["ὑπὲρ",713111,0],["ἑπτὰ",705357,59],["υἱούς",713075,57]],"And he shall be to thee a restorer of thy soul, and one to cherish thy old age; for thy daughter-in-law which has loved thee, who is better to thee than seven sons, has born him."],["16",[["καὶ",707031,7],["ἔλαβεν",708076,2],["Νωεμιν",709396,12],["τὸ",709436,24],["παιδίον",709927,25],["καὶ",707031,7],["ἔθηκεν",712849,2],["εἰς",704105,0],["τὸν",709436,5],["κόλπον",707800,6],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐγενήθη",703104,37],["αὐτῷ",702165,50],["εἰς",704105,0],["τιθηνόν",712852,6]],"And Noemin took the child and laid it in her bosom, and became a nurse to it."],["17",[["καὶ",707031,7],["ἐκάλεσαν",707084,150],["αὐτοῦ",702165,102],["αἱ",709436,190],["γείτονες",703016,191],["ὄνομα",709666,25],["λέγουσαι",708124,306],["ἐτέχθη",712853,37],["υἱὸς",713075,4],["τῇ",709436,100],["Νωεμιν",709396,1],["καὶ",707031,7],["ἐκάλεσαν",707084,150],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["Ωβηδ",714084,6],["οὗτος",709858,121],["πατὴρ",710189,4],["Ιεσσαι",706668,18],["πατρὸς",710189,18],["Δαυιδ",703232,18]],"And the neighbours gave it a name, saying, A son has been born to Noemin; and they called his name Obed; this [is] the father of Jessæ the father of David."],["18",[["καὶ",707031,7],["αὗται",709858,202],["αἱ",709436,190],["γενέσεις",703043,191],["Φαρες",713362,18],["Φαρες",713362,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Εσρων",705510,6]],"And these [are] the generations of Phares: Phares begot Esrom:"],["19",[["Εσρων",705510,4],["δὲ",703303,11],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Αρραν",701807,6],["καὶ",707031,7],["Αρραν",701807,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Αμιναδαβ",700824,6]],"Esrom begot Aram; and Aram begot Aminadab."],["20",[["καὶ",707031,7],["Αμιναδαβ",700824,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Ναασσων",709127,6],["καὶ",707031,7],["Ναασσων",709127,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Σαλμαν",711417,6]],"And Aminadab begot Naasson; and Naasson begot Salmon."],["21",[["καὶ",707031,7],["Σαλμαν",711417,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Βοος",702760,6],["καὶ",707031,7],["Βοος",702760,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Ωβηδ",714084,6]],"And Salmon begot Booz; and Booz begot Obed."],["22",[["καὶ",707031,7],["Ωβηδ",714084,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Ιεσσαι",706668,6],["καὶ",707031,7],["Ιεσσαι",706668,4],["ἐγέννησεν",703051,2],["τὸν",709436,5],["Δαυιδ",703232,6]],"And Obed begot Jessæ; and Jessæ begot David."]]