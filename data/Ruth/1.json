[["1",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["τῷ",709436,53],["κρίνειν",707905,55],["τοὺς",709436,58],["κριτὰς",707910,57],["καὶ",707031,7],["ἐγένετο",703104,23],["λιμὸς",708210,4],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["καὶ",707031,7],["ἐπορεύθη",710667,37],["ἀνὴρ",701150,4],["ἀπὸ",701425,0],["Βαιθλεεμ",702420,228],["τῆς",709436,16],["Ιουδα",706768,17],["τοῦ",709436,20],["παροικῆσαι",710156,106],["ἐν",704639,0],["ἀγρῷ",700196,114],["Μωαβ",709085,228],["αὐτὸς",702165,121],["καὶ",707031,7],["ἡ",709436,10],["γυνὴ",703209,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["οἱ",709436,136],["υἱοὶ",713075,52],["αὐτοῦ",702165,102]],"And it came to pass when the judges ruled, that there was a famine in the land: and a man went from Bethleem Juda to sojourn in the land of Moab, he, and his wife, and his two sons."],["2",[["καὶ",707031,7],["ὄνομα",709666,15],["τῷ",709436,113],["ἀνδρὶ",701150,114],["Αβιμελεχ",700068,4],["καὶ",707031,7],["ὄνομα",709666,15],["τῇ",709436,100],["γυναικὶ",703209,1],["αὐτοῦ",702165,102],["Νωεμιν",709396,12],["καὶ",707031,7],["ὄνομα",709666,15],["τοῖς",709436,147],["δυσὶν",703849,223],["υἱοῖς",713075,148],["αὐτοῦ",702165,102],["Μααλων",708301,4],["καὶ",707031,7],["Χελαιων",713800,4],["Εφραθαῖοι",705766,52],["ἐκ",704132,0],["Βαιθλεεμ",702420,17],["τῆς",709436,16],["Ιουδα",706768,17],["καὶ",707031,7],["ἤλθοσαν",705453,150],["εἰς",704105,0],["ἀγρὸν",700196,6],["Μωαβ",709085,118],["καὶ",707031,7],["ἦσαν",704093,137],["ἐκεῖ",704181,28]],"And the man's name [was] Elimelech, and his wife's name Noemin, and the names of his two sons Maalon and Chelaion, Ephrathites of Bethleem of Juda: and they came to the land of Moab, and remained there."],["3",[["καὶ",707031,7],["ἀπέθανεν",701461,2],["Αβιμελεχ",700068,4],["ὁ",709436,3],["ἀνὴρ",701150,4],["τῆς",709436,16],["Νωεμιν",709396,17],["καὶ",707031,7],["κατελείφθη",707305,37],["αὐτὴ",702165,107],["καὶ",707031,7],["οἱ",709436,136],["δύο",703849,543],["υἱοὶ",713075,52],["αὐτῆς",702165,86]],"And Elimelech the husband of Noemin died; and she was left, and her two sons."],["4",[["καὶ",707031,7],["ἐλάβοσαν",708076,150],["ἑαυτοῖς",703917,151],["γυναῖκας",703209,39],["Μωαβίτιδας",709089,119],["ὄνομα",709666,15],["τῇ",709436,100],["μιᾷ",704106,101],["Ορφα",709777,12],["καὶ",707031,7],["ὄνομα",709666,15],["τῇ",709436,100],["δευτέρᾳ",703389,101],["Ρουθ",711297,12],["καὶ",707031,7],["κατῴκησαν",707534,150],["ἐκεῖ",704181,28],["ὡς",714148,7],["δέκα",703333,59],["ἔτη",705543,42]],"And they took to themselves wives, women of Moab; the name of the one [was] Orpha, and the name of the second Ruth; and they dwelt there about ten years."],["5",[["καὶ",707031,7],["ἀπέθανον",701461,150],["καί",707031,7],["γε",702985,11],["ἀμφότεροι",700892,138],["Μααλων",708301,4],["καὶ",707031,7],["Χελαιων",713800,4],["καὶ",707031,7],["κατελείφθη",707305,37],["ἡ",709436,10],["γυνὴ",703209,12],["ἀπὸ",701425,0],["τοῦ",709436,35],["ἀνδρὸς",701150,18],["αὐτῆς",702165,86],["καὶ",707031,7],["ἀπὸ",701425,0],["τῶν",709436,80],["δύο",703849,544],["υἱῶν",713075,81],["αὐτῆς",702165,86]],"And both Maalon and Chelaion died also; and the woman was left of her husband and her two sons."],["6",[["καὶ",707031,7],["ἀνέστη",701173,2],["αὐτὴ",702165,107],["καὶ",707031,7],["αἱ",709436,190],["δύο",703849,545],["νύμφαι",709381,191],["αὐτῆς",702165,86],["καὶ",707031,7],["ἀπέστρεψαν",701598,150],["ἐξ",704132,0],["ἀγροῦ",700196,18],["Μωαβ",709085,118],["ὅτι",709803,7],["ἤκουσαν",700587,150],["ἐν",704639,0],["ἀγρῷ",700196,114],["Μωαβ",709085,118],["ὅτι",709803,7],["ἐπέσκεπται",705250,187],["κύριος",707996,4],["τὸν",709436,5],["λαὸν",708094,6],["αὐτοῦ",702165,102],["δοῦναι",703654,106],["αὐτοῖς",702165,151],["ἄρτους",701829,57]],"And she rose up and her two daughters-in-law, and they returned out of the country of Moab, for she heard in the country of Moab that the Lord [had] visited his people to give them bread."],["7",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["ἐκ",704132,0],["τοῦ",709436,35],["τόπου",712903,18],["οὗ",709806,28],["ἦν",704093,13],["ἐκεῖ",704181,28],["καὶ",707031,7],["αἱ",709436,190],["δύο",703849,545],["νύμφαι",709381,191],["αὐτῆς",702165,86],["μετ᾿",708780,0],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐπορεύοντο",710667,139],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["τοῦ",709436,20],["ἐπιστρέψαι",705278,106],["εἰς",704105,0],["τὴν",709436,8],["γῆν",703083,9],["Ιουδα",706768,17]],"And she went forth out of the place where she was, and her two daughters-in-law with her: and they went by the way to return to the land of Juda."],["8",[["καὶ",707031,7],["εἶπεν",705373,2],["Νωεμιν",709396,12],["ταῖς",709436,75],["νύμφαις",709381,76],["αὐτῆς",702165,86],["πορεύεσθε",710667,73],["δὴ",703395,11],["ἀποστράφητε",701598,372],["ἑκάστη",704133,29],["εἰς",704105,0],["οἶκον",709516,6],["μητρὸς",708892,17],["αὐτῆς",702165,86],["ποιήσαι",710582,225],["κύριος",707996,4],["μεθ᾿",708780,0],["ὑμῶν",713091,546],["ἔλεος",704426,25],["καθὼς",707030,28],["ἐποιήσατε",710582,265],["μετὰ",708780,0],["τῶν",709436,80],["τεθνηκότων",706278,387],["καὶ",707031,7],["μετ᾿",708780,0],["ἐμοῦ",704580,547]],"And Noemin said to her daughters-in-law, Go now, return each to the house of her mother: the Lord deal mercifully with you, as ye have dealt with the dead, and with me."],["9",[["δῴη",703654,225],["κύριος",707996,4],["ὑμῖν",713084,548],["καὶ",707031,7],["εὕροιτε",705676,549],["ἀνάπαυσιν",701026,9],["ἑκάστη",704133,29],["ἐν",704639,0],["οἴκῳ",709516,114],["ἀνδρὸς",701150,18],["αὐτῆς",702165,86],["καὶ",707031,7],["κατεφίλησεν",707476,2],["αὐτάς",702165,231],["καὶ",707031,7],["ἐπῆραν",705002,150],["τὴν",709436,8],["φωνὴν",713640,9],["αὐτῶν",702165,284],["καὶ",707031,7],["ἔκλαυσαν",707703,150]],"The Lord grant you that ye may find rest each of you in the house of her husband: and she kissed them; and they lifted up their voice, and wept."],["10",[["καὶ",707031,7],["εἶπαν",705373,150],["αὐτῇ",702165,105],["μετὰ",708780,0],["σοῦ",712181,547],["ἐπιστρέφομεν",705278,243],["εἰς",704105,0],["τὸν",709436,5],["λαόν",708094,6],["σου",712181,547]],"And they said to her, We will return with thee to thy people."],["11",[["καὶ",707031,7],["εἶπεν",705373,2],["Νωεμιν",709396,12],["ἐπιστράφητε",705278,372],["δή",703395,11],["θυγατέρες",706320,185],["μου",704018,547],["καὶ",707031,7],["ἵνα",706747,7],["τί",712867,126],["πορεύεσθε",710667,374],["μετ᾿",708780,0],["ἐμοῦ",704580,547],["μὴ",708851,28],["ἔτι",705538,28],["μοι",704018,550],["υἱοὶ",713075,52],["ἐν",704639,0],["τῇ",709436,100],["κοιλίᾳ",707761,1],["μου",704018,547],["καὶ",707031,7],["ἔσονται",704093,135],["ὑμῖν",713084,548],["εἰς",704105,0],["ἄνδρας",701150,57]],"And Noemin said, Return now, my daughters; and why do ye go with me? have I yet sons in my womb to be your husbands?"],["12",[["ἐπιστράφητε",705278,372],["δή",703395,11],["θυγατέρες",706320,185],["μου",704018,547],["διότι",703734,7],["γεγήρακα",703090,89],["τοῦ",709436,20],["μὴ",708851,28],["εἶναι",704093,55],["ἀνδρί",701150,114],["ὅτι",709803,7],["εἶπα",705373,155],["ὅτι",709803,7],["ἔστιν",704093,91],["μοι",704018,550],["ὑπόστασις",713241,12],["τοῦ",709436,20],["γενηθῆναί",703104,179],["με",704018,551],["ἀνδρὶ",701150,114],["καὶ",707031,7],["τέξομαι",712853,181],["υἱούς",713075,57]],"Turn now, my daughters, for I am too old to be married: for I said, Suppose I were married, and should bear sons;"],["13",[["μὴ",708851,28],["αὐτοὺς",702165,62],["προσδέξεσθε",710874,124],["ἕως",705792,7],["οὗ",709781,28],["ἁδρυνθῶσιν",700293,272],["ἢ",705924,7],["αὐτοῖς",702165,151],["κατασχεθήσεσθε",707526,261],["τοῦ",709436,20],["μὴ",708851,28],["γενέσθαι",703104,109],["ἀνδρί",701150,114],["μὴ",708851,28],["δή",703395,11],["θυγατέρες",706320,185],["μου",704018,547],["ὅτι",709803,7],["ἐπικράνθη",710469,37],["μοι",704018,550],["ὑπὲρ",713111,0],["ὑμᾶς",713080,552],["ὅτι",709803,7],["ἐξῆλθεν",704909,2],["ἐν",704639,0],["ἐμοὶ",704577,550],["χεὶρ",713787,12],["κυρίου",707996,18]],"would ye wait for them till they should be grown? or would ye refrain from being married for their sakes? Not so, my daughters; for I am grieved for you, that the hand of the Lord has gone forth against me."],["14",[["καὶ",707031,7],["ἐπῆραν",705002,150],["τὴν",709436,8],["φωνὴν",713640,9],["αὐτῶν",702165,284],["καὶ",707031,7],["ἔκλαυσαν",707703,150],["ἔτι",705538,28],["καὶ",707031,7],["κατεφίλησεν",707476,2],["Ορφα",709777,12],["τὴν",709436,8],["πενθερὰν",710249,9],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐπέστρεψεν",705278,2],["εἰς",704105,0],["τὸν",709436,5],["λαὸν",708094,6],["αὐτῆς",702165,86],["Ρουθ",711297,12],["δὲ",703303,11],["ἠκολούθησεν",700566,2],["αὐτῇ",702165,105]],"And they lifted up their voice, and wept again; and Orpha kissed her mother-in-law and returned to her people; but Ruth followed her."],["15",[["καὶ",707031,7],["εἶπεν",705373,2],["Νωεμιν",709396,12],["πρὸς",710844,0],["Ρουθ",711297,9],["ἰδοὺ",706497,88],["ἀνέστρεψεν",701060,2],["ἡ",709436,10],["σύννυμφός",712488,12],["σου",712181,547],["πρὸς",710844,0],["λαὸν",708094,6],["αὐτῆς",702165,86],["καὶ",707031,7],["πρὸς",710844,0],["τοὺς",709436,58],["θεοὺς",706192,57],["αὐτῆς",702165,86],["ἐπιστράφητι",705278,244],["δὴ",703395,11],["καὶ",707031,7],["σὺ",712181,553],["ὀπίσω",709697,0],["τῆς",709436,16],["συννύμφου",712488,17],["σου",712181,547]],"And Noemin said to Ruth, Behold, thy sister-in-law has returned to her people and to her gods; turn now thou also after thy sister-in-law."],["16",[["εἶπεν",705373,2],["δὲ",703303,11],["Ρουθ",711297,12],["μὴ",708851,28],["ἀπαντήσαι",701345,300],["ἐμοὶ",704577,550],["τοῦ",709436,20],["καταλιπεῖν",707305,106],["σε",712181,551],["ἢ",705924,7],["ἀποστρέψαι",701598,106],["ὄπισθέν",709691,28],["σου",712181,547],["ὅτι",709803,7],["σὺ",712181,553],["ὅπου",709710,28],["ἐὰν",703912,7],["πορευθῇς",710667,279],["πορεύσομαι",710667,181],["καὶ",707031,7],["οὗ",709781,28],["ἐὰν",703912,7],["αὐλισθῇς",702138,279],["αὐλισθήσομαι",702138,180],["ὁ",709436,3],["λαός",708094,4],["σου",712181,547],["λαός",708094,4],["μου",704018,547],["καὶ",707031,7],["ὁ",709436,3],["θεός",706192,4],["σου",712181,547],["θεός",706192,4],["μου",704018,547]],"And Ruth said, Intreat me not to leave thee, or to return from following thee; for whithersoever thou goest, I will go, and wheresoever thou lodgest, I will lodge; thy people [shall be] my people, and thy God my God."],["17",[["καὶ",707031,7],["οὗ",709781,28],["ἐὰν",703912,7],["ἀποθάνῃς",701461,175],["ἀποθανοῦμαι",701461,181],["κἀκεῖ",707051,554],["ταφήσομαι",706103,180],["τάδε",709446,71],["ποιήσαι",710582,225],["μοι",704018,550],["κύριος",707996,4],["καὶ",707031,7],["τάδε",709446,71],["προσθείη",710965,225],["ὅτι",709803,7],["θάνατος",706096,4],["διαστελεῖ",703588,127],["ἀνὰ",700902,0],["μέσον",708768,46],["ἐμοῦ",704580,547],["καὶ",707031,7],["σοῦ",712181,547]],"And wherever thou diest, I will die, and there will I be buried: the Lord do so to me, and more also, [if I leave thee], for death [only] shall divide between me and thee."],["18",[["ἰδοῦσα",709725,149],["δὲ",703303,11],["Νωεμιν",709396,12],["ὅτι",709803,7],["κραταιοῦται",707875,391],["αὐτὴ",702165,107],["τοῦ",709436,20],["πορεύεσθαι",710667,110],["μετ᾿",708780,0],["αὐτῆς",702165,86],["ἐκόπασεν",707819,2],["τοῦ",709436,20],["λαλῆσαι",708071,106],["πρὸς",710844,0],["αὐτὴν",702165,104],["ἔτι",705538,28]],"And Noemin seeing that she was determined to go with her, ceased to speak to her any more."],["19",[["ἐπορεύθησαν",710667,99],["δὲ",703303,11],["ἀμφότεραι",700892,192],["ἕως",705792,7],["τοῦ",709436,20],["παραγενέσθαι",710006,109],["αὐτὰς",702165,231],["εἰς",704105,0],["Βαιθλεεμ",702420,227],["καὶ",707031,7],["ἤχησεν",706045,2],["πᾶσα",710177,29],["ἡ",709436,10],["πόλις",710612,12],["ἐπ᾿",705080,0],["αὐταῖς",702165,200],["καὶ",707031,7],["εἶπον",705373,150],["αὕτη",709858,107],["ἐστὶν",704093,91],["Νωεμιν",709396,12]],"And they went both of them until they came to Bethleem: and it came to pass, when they arrived at Bethleem, that all the city rang with them, and they said, Is this Noemin?"],["20",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτάς",702165,231],["μὴ",708851,28],["δὴ",703395,11],["καλεῖτέ",707084,335],["με",704018,551],["Νωεμιν",709396,9],["καλέσατέ",707084,74],["με",704018,551],["Πικράν",710470,9],["ὅτι",709803,7],["ἐπικράνθη",710469,37],["ἐν",704639,0],["ἐμοὶ",704577,550],["ὁ",709436,3],["ἱκανὸς",706710,14],["σφόδρα",712586,28]],"And she said to them, Nay, do not call me Noemin; call me ‘Bitter,’ for the Mighty One has dealt very bitterly with me."],["21",[["ἐγὼ",704018,553],["πλήρης",710541,14],["ἐπορεύθην",710667,156],["καὶ",707031,7],["κενὴν",707612,36],["ἀπέστρεψέν",701598,2],["με",704018,551],["ὁ",709436,3],["κύριος",707996,4],["καὶ",707031,7],["ἵνα",706747,7],["τί",712867,555],["καλεῖτέ",707084,87],["με",704018,551],["Νωεμιν",709396,9],["καὶ",707031,7],["κύριος",707996,4],["ἐταπείνωσέν",712717,2],["με",704018,551],["καὶ",707031,7],["ὁ",709436,3],["ἱκανὸς",706710,14],["ἐκάκωσέν",707073,2],["με",704018,551]],"I went out full, and the Lord has brought me back empty: and why call ye me Noemin, whereas the Lord has humbled me, and the Mighty One has afflicted me?"],["22",[["καὶ",707031,7],["ἐπέστρεψεν",705278,2],["Νωεμιν",709396,12],["καὶ",707031,7],["Ρουθ",711297,12],["ἡ",709436,10],["Μωαβῖτις",709089,29],["ἡ",709436,10],["νύμφη",709381,12],["αὐτῆς",702165,86],["ἐπιστρέφουσα",705278,188],["ἐξ",704132,0],["ἀγροῦ",700196,18],["Μωαβ",709085,118],["αὐταὶ",702165,202],["δὲ",703303,11],["παρεγενήθησαν",710006,99],["εἰς",704105,0],["Βαιθλεεμ",702420,227],["ἐν",704639,0],["ἀρχῇ",701836,1],["θερισμοῦ",706208,18],["κριθῶν",707900,65]],"So Noemin and Ruth the Moabitess, her daughter-in-law, returned from the country of Moab; and they came to Bethleem in the beginning of barley harvest."]]