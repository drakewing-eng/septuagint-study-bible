[["1",[["καὶ",707031,7],["τῇ",709436,100],["Νωεμιν",709396,1],["ἀνὴρ",701150,4],["γνώριμος",703136,14],["τῷ",709436,113],["ἀνδρὶ",701150,114],["αὐτῆς",702165,86],["ὁ",709436,3],["δὲ",703303,11],["ἀνὴρ",701150,4],["δυνατὸς",703845,14],["ἰσχύι",706858,1],["ἐκ",704132,0],["τῆς",709436,16],["συγγενείας",712184,17],["Αβιμελεχ",700068,18],["καὶ",707031,7],["ὄνομα",709666,15],["αὐτῷ",702165,50],["Βοος",702760,4]],"And Noemin had [a friend] an acquaintance of her husband, and the man [was] a mighty man of the kindred of Elimelech, and his name [was] Booz."],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["Ρουθ",711297,12],["ἡ",709436,10],["Μωαβῖτις",709089,29],["πρὸς",710844,0],["Νωεμιν",709396,9],["πορευθῶ",710667,321],["δὴ",703395,11],["εἰς",704105,0],["ἀγρὸν",700196,6],["καὶ",707031,7],["συνάξω",712375,165],["ἐν",704639,0],["τοῖς",709436,147],["στάχυσιν",712053,148],["κατόπισθεν",707544,28],["οὗ",709781,28],["ἐὰν",703912,7],["εὕρω",705676,207],["χάριν",713735,9],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["αὐτοῦ",702165,102],["εἶπεν",705373,2],["δὲ",703303,11],["αὐτῇ",702165,105],["πορεύου",710667,253],["θύγατερ",706320,258]],"And Ruth the Moabitess said to Noemin, Let me go now to the field, and I will glean among the ears behind the man with whomsoever I shall find favour: and she said to her, Go, daughter."],["3",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["καὶ",707031,7],["συνέλεξεν",712263,2],["ἐν",704639,0],["τῷ",709436,113],["ἀγρῷ",700196,114],["κατόπισθεν",707544,28],["τῶν",709436,80],["θεριζόντων",706206,170],["καὶ",707031,7],["περιέπεσεν",710364,2],["περιπτώματι",710373,114],["τῇ",709436,100],["μερίδι",708748,1],["τοῦ",709436,35],["ἀγροῦ",700196,18],["Βοος",702760,18],["τοῦ",709436,35],["ἐκ",704132,0],["συγγενείας",712184,17],["Αβιμελεχ",700068,18]],"And she went; and came and gleaned in the field behind the reapers; and she happened by chance to come on a portion of the land of Booz, of the kindred of Elimelech."],["4",[["καὶ",707031,7],["ἰδοὺ",706497,88],["Βοος",702760,4],["ἦλθεν",705453,2],["ἐκ",704132,0],["Βαιθλεεμ",702420,118],["καὶ",707031,7],["εἶπεν",705373,2],["τοῖς",709436,147],["θερίζουσιν",706206,349],["κύριος",707996,4],["μεθ᾿",708780,0],["ὑμῶν",713091,145],["καὶ",707031,7],["εἶπον",705373,150],["αὐτῷ",702165,50],["εὐλογήσαι",705631,225],["σε",712181,556],["κύριος",707996,4]],"And, behold, Booz came from Bethleem, and said to the reapers, The Lord [be] with you: and they said to him, The Lord bless thee."],["5",[["καὶ",707031,7],["εἶπεν",705373,2],["Βοος",702760,4],["τῷ",709436,53],["παιδαρίῳ",709923,54],["αὐτοῦ",702165,102],["τῷ",709436,53],["ἐφεστῶτι",705756,557],["ἐπὶ",705080,0],["τοὺς",709436,58],["θερίζοντας",706206,235],["τίνος",712867,558],["ἡ",709436,10],["νεᾶνις",709231,12],["αὕτη",709858,107]],"And Booz said to his servant who was set over the reapers, Whose [is] this damsel?"],["6",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["τὸ",709436,34],["παιδάριον",709923,15],["τὸ",709436,34],["ἐφεστὸς",705756,426],["ἐπὶ",705080,0],["τοὺς",709436,58],["θερίζοντας",706206,235],["καὶ",707031,7],["εἶπεν",705373,2],["ἡ",709436,10],["παῖς",709932,12],["ἡ",709436,10],["Μωαβῖτίς",709089,29],["ἐστιν",704093,91],["ἡ",709436,10],["ἀποστραφεῖσα",701598,307],["μετὰ",708780,0],["Νωεμιν",709396,17],["ἐξ",704132,0],["ἀγροῦ",700196,18],["Μωαβ",709085,18]],"And his servant who was set over the reapers answered and said, It is the Moabitish damsel who returned with Noemin out of the land of Moab."],["7",[["καὶ",707031,7],["εἶπεν",705373,2],["συλλέξω",712263,165],["δὴ",703395,11],["καὶ",707031,7],["συνάξω",712375,165],["ἐν",704639,0],["τοῖς",709436,95],["δράγμασιν",703820,96],["ὄπισθεν",709691,28],["τῶν",709436,80],["θεριζόντων",706206,170],["καὶ",707031,7],["ἦλθεν",705453,2],["καὶ",707031,7],["ἔστη",706846,2],["ἀπὸ",701425,0],["πρωίθεν",711022,28],["καὶ",707031,7],["ἕως",705792,7],["ἑσπέρας",705500,17],["οὐ",709805,28],["κατέπαυσεν",707365,2],["ἐν",704639,0],["τῷ",709436,113],["ἀγρῷ",700196,114],["μικρόν",708915,27]],"And she said, I pray you, let me glean and gather among the sheaves after the reapers: and she came and stood from morning till evening, and rested not [even] a little in the field."],["8",[["καὶ",707031,7],["εἶπεν",705373,2],["Βοος",702760,4],["πρὸς",710844,0],["Ρουθ",711297,9],["οὐκ",709805,28],["ἤκουσας",700587,162],["θύγατερ",706320,258],["μὴ",708851,28],["πορευθῇς",710667,279],["ἐν",704639,0],["ἀγρῷ",700196,114],["συλλέξαι",712263,106],["ἑτέρῳ",705535,30],["καὶ",707031,7],["σὺ",712181,553],["οὐ",709805,28],["πορεύσῃ",710667,420],["ἐντεῦθεν",704793,28],["ὧδε",714090,28],["κολλήθητι",707791,244],["μετὰ",708780,0],["τῶν",709436,43],["κορασίων",707832,44],["μου",704018,559]],"And Booz said to Ruth, Hast thou not heard, [my] daughter? go not to glean in another field; and depart not thou hence, join thyself here with my damsels."],["9",[["οἱ",709436,136],["ὀφθαλμοί",709870,52],["σου",712181,547],["εἰς",704105,0],["τὸν",709436,5],["ἀγρόν",700196,6],["οὗ",709781,28],["ἐὰν",703912,7],["θερίζωσιν",706206,271],["καὶ",707031,7],["πορεύσῃ",710667,420],["κατόπισθεν",707544,28],["αὐτῶν",702165,40],["ἰδοὺ",706497,88],["ἐνετειλάμην",704791,161],["τοῖς",709436,95],["παιδαρίοις",709923,96],["τοῦ",709436,20],["μὴ",708851,28],["ἅψασθαί",701654,109],["σου",712181,547],["καὶ",707031,7],["ὅ",709781,128],["τι",712866,126],["διψήσεις",703763,166],["καὶ",707031,7],["πορευθήσῃ",710667,364],["εἰς",704105,0],["τὰ",709436,41],["σκεύη",711844,42],["καὶ",707031,7],["πίεσαι",710478,123],["ὅθεν",709486,28],["ἂν",700900,11],["ὑδρεύωνται",713066,380],["τὰ",709436,63],["παιδάρια",709923,64]],"[Let] thine eyes [be] on the field where [my men] shall reap, and thou shalt go after them: behold, I have charged the young men not to touch thee: and when thou shalt thirst, then thou shalt go to the vessels, and drink of that which the young men shall have drawn."],["10",[["καὶ",707031,7],["ἔπεσεν",710481,2],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["αὐτῆς",702165,86],["καὶ",707031,7],["προσεκύνησεν",710925,2],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτόν",702165,85],["τί",712867,555],["ὅτι",709803,7],["εὗρον",705676,155],["χάριν",713735,9],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["σου",712181,559],["τοῦ",709436,20],["ἐπιγνῶναί",705104,106],["με",704018,551],["καὶ",707031,7],["ἐγώ",704018,553],["εἰμι",704093,157],["ξένη",709415,29]],"And she fell upon her face, and did reverence to the ground, and said to him, How is it that I have found grace in thine eyes, that thou shouldest take notice of me, whereas I am a stranger?"],["11",[["καὶ",707031,7],["ἀπεκρίθη",701492,37],["Βοος",702760,4],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῇ",702165,105],["ἀπαγγελίᾳ",701320,1],["ἀπηγγέλη",701321,37],["μοι",704018,560],["ὅσα",709788,68],["πεποίηκας",710582,266],["μετὰ",708780,0],["τῆς",709436,16],["πενθερᾶς",710249,17],["σου",712181,547],["μετὰ",708780,0],["τὸ",709436,24],["ἀποθανεῖν",701461,106],["τὸν",709436,5],["ἄνδρα",701150,6],["σου",712181,547],["καὶ",707031,7],["πῶς",711121,28],["κατέλιπες",707305,162],["τὸν",709436,5],["πατέρα",710189,6],["σου",712181,547],["καὶ",707031,7],["τὴν",709436,8],["μητέρα",708892,9],["σου",712181,547],["καὶ",707031,7],["τὴν",709436,8],["γῆν",703083,9],["γενέσεώς",703043,17],["σου",712181,547],["καὶ",707031,7],["ἐπορεύθης",710667,168],["πρὸς",710844,0],["λαὸν",708094,6],["ὃν",709781,112],["οὐκ",709805,28],["ᾔδεις",709492,508],["ἐχθὲς",713853,28],["καὶ",707031,7],["τρίτης",712968,82]],"And Booz answered and said to her, It has fully been told me how thou hast dealt with thy mother-in-law after the death of thy husband; and how thou didst leave thy father and thy mother, and the land of thy birth, and camest to a people whom thou knewest not before."],["12",[["ἀποτείσαι",701618,225],["κύριος",707996,4],["τὴν",709436,8],["ἐργασίαν",705385,9],["σου",712181,547],["καὶ",707031,7],["γένοιτο",703104,382],["ὁ",709436,3],["μισθός",708939,4],["σου",712181,547],["πλήρης",710541,14],["παρὰ",709995,0],["κυρίου",707996,18],["θεοῦ",706192,18],["Ισραηλ",706839,18],["πρὸς",710844,0],["ὃν",709781,112],["ἦλθες",705453,162],["πεποιθέναι",710221,115],["ὑπὸ",713184,0],["τὰς",709436,38],["πτέρυγας",711057,39],["αὐτοῦ",702165,102]],"The Lord recompense thy work: may a full reward be given thee of the Lord God of Israel, to whom thou hast come to trust under his wings."],["13",[["ἡ",709436,10],["δὲ",703303,11],["εἶπεν",705373,2],["εὕροιμι",705676,346],["χάριν",713735,9],["ἐν",704639,0],["ὀφθαλμοῖς",709870,148],["σου",712181,559],["κύριε",707996,153],["ὅτι",709803,7],["παρεκάλεσάς",710039,162],["με",704018,551],["καὶ",707031,7],["ὅτι",709803,7],["ἐλάλησας",708071,162],["ἐπὶ",705080,0],["καρδίαν",707141,9],["τῆς",709436,16],["δούλης",703815,17],["σου",712181,547],["καὶ",707031,7],["ἰδοὺ",706497,88],["ἐγὼ",704018,553],["ἔσομαι",704093,181],["ὡς",714148,7],["μία",704106,36],["τῶν",709436,80],["παιδισκῶν",709928,81],["σου",712181,559]],"And she said, Let me find grace in thy sight, my lord, because thou hast comforted me, and because thou hast spoken kindly to thy handmaid, and behold, I shall be as one of thy servants."],["14",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῇ",702165,105],["Βοος",702760,4],["ἤδη",705939,28],["ὥρᾳ",714128,1],["τοῦ",709436,20],["φαγεῖν",713296,106],["πρόσελθε",710890,176],["ὧδε",714090,28],["καὶ",707031,7],["φάγεσαι",713296,123],["τῶν",709436,80],["ἄρτων",701829,81],["καὶ",707031,7],["βάψεις",702517,166],["τὸν",709436,5],["ψωμόν",714078,6],["σου",712181,547],["ἐν",704639,0],["τῷ",709436,113],["ὄξει",709678,54],["καὶ",707031,7],["ἐκάθισεν",707006,2],["Ρουθ",711297,12],["ἐκ",704132,0],["πλαγίων",710493,169],["τῶν",709436,80],["θεριζόντων",706206,170],["καὶ",707031,7],["ἐβούνισεν",702796,2],["αὐτῇ",702165,105],["Βοος",702760,4],["ἄλφιτον",700737,25],["καὶ",707031,7],["ἔφαγεν",713296,2],["καὶ",707031,7],["ἐνεπλήσθη",704592,37],["καὶ",707031,7],["κατέλιπεν",707305,2]],"And Booz said to her, Now [it is] time to eat; come hither, and thou shalt eat of the bread, and thou shalt dip thy morsel in the vinegar: and Ruth sat by the side of the reapers, and Booz handed her meal, and she ate, and was satisfied, and left."],["15",[["καὶ",707031,7],["ἀνέστη",701173,2],["τοῦ",709436,20],["συλλέγειν",712263,55],["καὶ",707031,7],["ἐνετείλατο",704791,23],["Βοος",702760,4],["τοῖς",709436,95],["παιδαρίοις",709923,96],["αὐτοῦ",702165,102],["λέγων",708124,72],["καί",707031,7],["γε",702985,11],["ἀνὰ",700902,0],["μέσον",708768,46],["τῶν",709436,43],["δραγμάτων",703820,44],["συλλεγέτω",712263,31],["καὶ",707031,7],["μὴ",708851,28],["καταισχύνητε",707257,355],["αὐτήν",702165,104]],"And she rose up to glean; and Booz charged his young men, saying, Let her even glean among the sheaves, and reproach her not."],["16",[["καὶ",707031,7],["βαστάζοντες",702594,146],["βαστάξατε",702594,74],["αὐτῇ",702165,105],["καί",707031,7],["γε",702985,11],["παραβάλλοντες",709997,146],["παραβαλεῖτε",709997,337],["αὐτῇ",702165,105],["ἐκ",704132,0],["τῶν",709436,80],["βεβουνισμένων",702796,445],["καὶ",707031,7],["ἄφετε",702211,74],["καὶ",707031,7],["συλλέξει",712263,127],["καὶ",707031,7],["οὐκ",709805,28],["ἐπιτιμήσετε",705305,337],["αὐτῇ",702165,105]],"And do ye by all means carry it for her, and ye shall surely let fall for her some of that which is heaped up; and let her eat, and glean, and rebuke her not."],["17",[["καὶ",707031,7],["συνέλεξεν",712263,2],["ἐν",704639,0],["τῷ",709436,113],["ἀγρῷ",700196,114],["ἕως",705792,7],["ἑσπέρας",705500,17],["καὶ",707031,7],["ἐρράβδισεν",711134,2],["ἃ",709781,69],["συνέλεξεν",712263,2],["καὶ",707031,7],["ἐγενήθη",703104,37],["ὡς",714148,7],["οιφι",709538,25],["κριθῶν",707900,65]],"So she gleaned in the field till evening, and beat out that she had gleaned, and it was about an ephah of barley."],["18",[["καὶ",707031,7],["ἦρεν",700473,2],["καὶ",707031,7],["εἰσῆλθεν",704114,2],["εἰς",704105,0],["τὴν",709436,8],["πόλιν",710612,9],["καὶ",707031,7],["εἶδεν",709725,2],["ἡ",709436,10],["πενθερὰ",710249,12],["αὐτῆς",702165,86],["ἃ",709781,69],["συν