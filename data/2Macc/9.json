[["1",[["περὶ",710285,0],["δὲ",703303,11],["τὸν",709436,5],["καιρὸν",707047,6],["ἐκεῖνον",704183,85],["ἐτύγχανεν",713015,13],["Ἀντίοχος",701257,4],["ἀναλελυκὼς",700995,270],["ἀκόσμως",700576,28],["ἐκ",704132,0],["τῶν",709436,80],["περὶ",710285,0],["τὴν",709436,8],["Περσίδα",710431,9],["τόπων",712903,81]],"About that time came Antiochus with dishonour out of the country of Persia."],["2",[["εἰσεληλύθει",704114,171],["γὰρ",702963,11],["εἰς",704105,0],["τὴν",709436,8],["λεγομένην",708124,173],["Περσέπολιν",710428,9],["καὶ",707031,7],["ἐπεχείρησεν",705334,2],["ἱεροσυλεῖν",706638,55],["καὶ",707031,7],["τὴν",709436,8],["πόλιν",710612,9],["συνέχειν",712469,55],["διὸ",703714,7],["δὴ",703395,11],["τῶν",709436,43],["πληθῶν",710529,44],["ὁρμησάντων",709755,329],["ἐπὶ",705080,0],["τὴν",709436,8],["τῶν",709436,43],["ὅπλων",709704,44],["βοήθειαν",702745,9],["ἐτράπησαν",712929,99],["καὶ",707031,7],["συνέβη",712277,2],["τροπωθέντα",712981,328],["τὸν",709436,5],["Ἀντίοχον",701257,6],["ὑπὸ",713184,0],["τῶν",709436,80],["ἐγχωρίων",704017,169],["ἀσχήμονα",702055,36],["τὴν",709436,8],["ἀναζυγὴν",700944,9],["ποιήσασθαι",710582,109]],"For he had entered the [city] called Persepolis, and went about to rob the temple, and to hold the city; whereupon the multitude running to defend themselves with their weapons put them to flight; and so it happened, that Antiochus being put to flight of the inhabitants returned with shame."],["3",[["ὄντι",704093,379],["δὲ",703303,11],["αὐτῷ",702165,50],["κατ᾿",707200,0],["Ἐκβάτανα",704147,227],["προσέπεσεν",710952,2],["τὰ",709436,41],["κατὰ",707200,0],["Νικάνορα",709308,6],["καὶ",707031,7],["τοὺς",709436,58],["περὶ",710285,0],["Τιμόθεον",712860,6],["γεγονότα",703104,427]],"Now when he came to Ecbatane, news was brought him what had happened unto Nicanor and Timotheus."],["4",[["ἐπαρθεὶς",705002,217],["δὲ",703303,11],["τῷ",709436,113],["θυμῷ",706334,114],["ᾤετο",709534,19],["καὶ",707031,7],["τὴν",709436,8],["τῶν",709436,80],["πεφυγαδευκότων",713606,387],["αὐτὸν",702165,85],["κακίαν",707054,9],["εἰς",704105,0],["τοὺς",709436,58],["Ιουδαίους",706772,57],["ἐναπερείσασθαι",704658,109],["διὸ",703714,7],["συνέταξεν",712508,2],["τὸν",709436,5],["ἁρματηλάτην",701772,6],["ἀδιαλείπτως",700260,28],["ἐλαύνοντα",704397,183],["κατανύειν",707348,55],["τὴν",709436,8],["πορείαν",710665,9],["τῆς",709436,16],["ἐξ",704132,0],["οὐρανοῦ",709844,18],["δὴ",703395,11],["κρίσεως",707908,17],["συνούσης",712435,222],["αὐτῷ",702165,50],["οὕτως",709859,28],["γὰρ",702963,11],["ὑπερηφάνως",713140,28],["εἶπεν",705373,2],["πολυάνδριον",710621,25],["Ιουδαίων",706772,81],["Ιεροσόλυμα",706634,6],["ποιήσω",710582,207],["παραγενόμενος",710006,248],["ἐκεῖ",704181,28]],"Then swelling with anger, he thought to avenge upon the Jews the disgrace done unto him by those that made him flee. Therefore commanded he his chariotman to drive without ceasing, and to dispatch the journey, the judgment of God now following him. For he had spoken proudly in this sort, That he would come to Jerusalem, and make it a common burying place of the Jews."],["5",[["ὁ",709436,3],["δὲ",703303,11],["παντεπόπτης",709979,14],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["τοῦ",709436,35],["Ισραηλ",706839,18],["ἐπάταξεν",710185,2],["αὐτὸν",702165,85],["ἀνιάτῳ",701166,30],["καὶ",707031,7],["ἀοράτῳ",701318,30],["πληγῇ",710527,1],["ἄρτι",701826,28],["δὲ",703303,11],["αὐτοῦ",702165,102],["καταλήξαντος",707309,500],["τὸν",709436,5],["λόγον",708236,6],["ἔλαβεν",708076,2],["αὐτὸν",702165,85],["ἀνήκεστος",701143,14],["τῶν",709436,43],["σπλάγχνων",712018,44],["ἀλγηδὼν",700639,12],["καὶ",707031,7],["πικραὶ",710475,192],["τῶν",709436,80],["ἔνδον",704692,28],["βάσανοι",702570,191]],"But the Lord Almighty, the God of Israel, smote him with an incurable and invisible plague: for as soon as he had spoken these words, a pain of the bowels that was remediless came upon him, and sore torments of the inner parts;"],["6",[["πάνυ",709991,28],["δικαίως",703698,28],["τὸν",709436,5],["πολλαῖς",710646,291],["καὶ",707031,7],["ξενιζούσαις",709409,495],["συμφοραῖς",712357,76],["ἑτέρων",705535,169],["σπλάγχνα",712018,42],["βασανίσαντα",702566,373]],"and that most justly: for he had tormented other men's bowels with many and strange torments."],["7",[["ὁ",709436,3],["δ᾿",703303,11],["οὐδαμῶς",709814,28],["τῆς",709436,16],["ἀγερωχίας",700150,17],["ἔληγεν",708173,2],["ἔτι",705538,28],["δὲ",703303,11],["καὶ",707031,7],["τῆς",709436,16],["ὑπερηφανίας",713138,17],["ἐπεπλήρωτο",710543,13],["πῦρ",711088,25],["πνέων",710571,72],["τοῖς",709436,147],["θυμοῖς",706334,148],["ἐπὶ",705080,0],["τοὺς",709436,58],["Ιουδαίους",706772,57],["καὶ",707031,7],["κελεύων",707601,72],["ἐποξύνειν",705349,55],["τὴν",709436,8],["πορείαν",710665,9],["συνέβη",712277,2],["δὲ",703303,11],["καὶ",707031,7],["πεσεῖν",710481,106],["αὐτὸν",702165,85],["ἀπὸ",701425,0],["τοῦ",709436,20],["ἅρματος",701768,21],["φερομένου",713428,262],["ῥοίζῳ",711286,97],["καὶ",707031,7],["δυσχερεῖ",703882,97],["πτώματι",711071,54],["περιπεσόντα",710364,676],["πάντα",710177,68],["τὰ",709436,41],["μέλη",708707,42],["τοῦ",709436,20],["σώματος",712635,21],["ἀποστρεβλοῦσθαι",701597,106]],"Howbeit he nothing at all ceased from his bragging, but still was filled with pride, breathing out fire in his rage against the Jews, and commanding to haste the journey: but it came to pass that he fell down from his chariot, carried violently; so that having a sore fall, all the members of his body were much pained."],["8",[["ὁ",709436,3],["δ᾿",703303,11],["ἄρτι",701826,28],["δοκῶν",703775,72],["τοῖς",709436,95],["τῆς",709436,16],["θαλάσσης",706069,17],["κύμασιν",707968,96],["ἐπιτάσσειν",705294,55],["διὰ",703417,0],["τὴν",709436,8],["ὑπὲρ",713111,0],["ἄνθρωπον",701163,6],["ἀλαζονείαν",700627,9],["καὶ",707031,7],["πλάστιγγι",710504,1],["τὰ",709436,41],["τῶν",709436,43],["ὀρέων",709768,44],["οἰόμενος",709534,122],["ὕψη",713288,42],["στήσειν",706846,296],["κατὰ",707200,0],["γῆν",703083,9],["γενόμενος",703104,248],["ἐν",704639,0],["φορείῳ",713553,54],["παρεκομίζετο",710054,19],["φανερὰν",713342,36],["τοῦ",709436,35],["θεοῦ",706192,18],["πᾶσιν",710177,230],["τὴν",709436,8],["δύναμιν",703839,9],["ἐνδεικνύμενος",704673,122]],"And thus he that a little afore thought he might command the waves of the sea, (so proud was he beyond the condition of men) and weigh the high mountains in a balance, was now cast on the ground, and carried in an horselitter, shewing forth unto all the manifest power of God."],["9",[["ὥστε",714164,7],["καὶ",707031,7],["ἐκ",704132,0],["τοῦ",709436,20],["σώματος",712635,21],["τοῦ",709436,35],["δυσσεβοῦς",703873,116],["σκώληκας",711905,57],["ἀναζεῖν",700942,55],["καὶ",707031,7],["ζῶντος",705851,152],["ἐν",704639,0],["ὀδύναις",709463,76],["καὶ",707031,7],["ἀλγηδόσιν",700639,76],["τὰς",709436,38],["σάρκας",711537,39],["αὐτοῦ",702165,102],["διαπίπτειν",703546,55],["ὑπὸ",713184,0],["δὲ",703303,11],["τῆς",709436,16],["ὀσμῆς",709786,17],["αὐτοῦ",702165,102],["πᾶν",710177,26],["τὸ",709436,24],["στρατόπεδον",712151,25],["βαρύνεσθαι",702553,110],["τὴν",709436,8],["σαπρίαν",711503,9]],"So that the worms rose up out of the body of this wicked man, and whiles he lived in sorrow and pain, his flesh fell away, and the filthiness of his smell was noisome to all his army."],["10",[["καὶ",707031,7],["τὸν",709436,5],["μικρῷ",708915,30],["πρότερον",710991,28],["τῶν",709436,43],["οὐρανίων",709842,83],["ἄστρων",702024,44],["ἅπτεσθαι",701654,110],["δοκοῦντα",703775,237],["παρακομίζειν",710054,55],["οὐδεὶς",709817,14],["ἐδύνατο",703838,19],["διὰ",703417,0],["τὸ",709436,24,5],["τῆς",709436,16],["ὀσμῆς",709786,17],["ἀφόρητον",702225,27],["βάρος",702542,15]],"And the man, that thought a little afore he could reach to the stars of heaven, no man could endure to carry for his intolerable stink."],["11",[["ἐνταῦθα",704787,28],["οὖν",709835,11],["ἤρξατο",701860,23],["τὸ",709436,24],["πολὺ",710646,46],["τῆς",709436,16],["ὑπερηφανίας",713138,17],["λήγειν",708173,55],["τεθραυσμένος",706304,419],["καὶ",707031,7],["εἰς",704105,0],["ἐπίγνωσιν",705107,9],["ἔρχεσθαι",705453,110],["θείᾳ",706154,101],["μάστιγι",708568,1],["κατὰ",707200,0],["στιγμὴν",712104,9],["ἐπιτεινόμενος",705296,122],["ταῖς",709436,75],["ἀλγηδόσιν",700639,76]],"Here therefore, being plagued, he began to leave off his great pride, and to come to the knowledge [of himself] by the scourge of God, his pain increasing every moment."],["12",[["καὶ",707031,7],["μηδὲ",708855,7],["τῆς",709436,16],["ὀσμῆς",709786,17],["αὐτοῦ",702165,102],["δυνάμενος",703838,122],["ἀνέχεσθαι",701140,110],["ταῦτ᾿",709858,71],["ἔφη",713437,13],["δίκαιον",703694,27],["ὑποτάσσεσθαι",713250,110],["τῷ",709436,113],["θεῷ",706192,114],["καὶ",707031,7],["μὴ",708851,28],["θνητὸν",706279,27],["ὄντα",704093,183],["ἰσόθεα",706826,68],["φρονεῖν",713586,55]],"And when he himself could not abide his own smell, he said these words, It is meet to be subject unto God, and that a man that is mortal should not proudly think of himself, as if he were God."],["13",[["ηὔχετο",705727,19],["δὲ",703303,11],["ὁ",709436,3],["μιαρὸς",708906,14],["πρὸς",710844,0],["τὸν",709436,5],["οὐκέτι",709827,28],["αὐτὸν",702165,85],["ἐλεήσοντα",704418,676],["δεσπότην",703379,6],["οὕτως",709859,28],["λέγων",708124,72]],"This wicked person vowed also unto the Lord, who now no more would have mercy upon him, saying thus,"],["14",[["τὴν",709436,8],["μὲν",708730,11],["ἁγίαν",700159,36],["πόλιν",710612,9],["ἣν",709781,131],["σπεύδων",712011,72],["παρεγίνετο",710006,19],["ἰσόπεδον",706829,36],["ποιῆσαι",710582,106],["καὶ",707031,7],["πολυάνδριον",710621,25],["οἰκοδομῆσαι",709509,106],["ἐλευθέραν",704428,36],["ἀναδεῖξαι",700935,106]],"That the holy city (to the which he was going in haste, to lay it even with the ground, and to make it a common burying place,) he would set at liberty:"],["15",[["τοὺς",709436,58],["δὲ",703303,11],["Ιουδαίους",706772,57],["οὓς",709781,298],["διεγνώκει",703435,143],["μηδὲ",708855,7],["ταφῆς",712736,17],["ἀξιῶσαι",701309,106],["οἰωνοβρώτους",709544,57],["δὲ",703303,11],["σὺν",712372,0],["τοῖς",709436,147],["νηπίοις",709295,230],["ἐκρίψειν",707907,115],["θηρίοις",706252,96],["πάντας",710177,60],["αὐτοὺς",702165,62],["ἴσους",706832,60],["Ἀθηναίοις",700373,148],["ποιήσειν",710582,296]],"and as touching the Jews, whom he had judged not worthy so much as to be buried, but to be cast out with their children to be devoured of the fowls and wild beasts, he would make them all equals to the citizens of Athens:"],["16",[["ὃν",709781,112],["δὲ",703303,11],["πρότερον",710991,28],["ἐσκύλευσεν",711900,2],["ἅγιον",700159,27],["νεὼ",709287,6],["καλλίστοις",707097,343],["ἀναθήμασιν",700950,96],["κοσμήσειν",707847,296],["καὶ",707031,7],["τὰ",709436,41],["ἱερὰ",706633,68],["σκεύη",711844,42],["πολυπλάσια",710639,68],["πάντα",710177,68],["ἀποδώσειν",701449,296],["τὰς",709436,38],["δὲ",703303,11],["ἐπιβαλλούσας",705083,338],["πρὸς",710844,0],["τὰς",709436,38],["θυσίας",706345,39],["συντάξεις",712506,39],["ἐκ",704132,0],["τῶν",709436,80],["ἰδίων",706493,169],["προσόδων",710938,65],["χορηγήσειν",713911,296]],"and the holy temple, which before he had spoiled, he would garnish with goodly gifts, and restore all the holy vessels with many more, and out of his own revenue defray the charges belonging to the sacrifices:"],["17",[["πρὸς",710844,0],["δὲ",703303,11],["τούτοις",709858,151],["καὶ",707031,7],["Ιουδαῖον",706772,6],["ἔσεσθαι",704093,492],["καὶ",707031,7],["πάντα",710177,27],["τόπον",712903,6],["οἰκητὸν",709503,27],["ἐπελεύσεσθαι",705068,492],["καταγγέλλοντα",707220,183],["τὸ",709436,24],["τοῦ",709436,35],["θεοῦ",706192,18],["κράτος",707883,25]],"yea, and that also he would become a Jew himself, and go through all the world that was inhabited, and declare the power of God."],["18",[["οὐδαμῶς",709814,28],["δὲ",703303,11],["ληγόντων",708173,170],["τῶν",709436,80],["πόνων",710661,81],["ἐπεληλύθει",705068,171],["γὰρ",702963,11],["ἐπ᾿",705080,0],["αὐτὸν",702165,85],["δικαία",703694,29],["ἡ",709436,10],["τοῦ",709436,35],["θεοῦ",706192,18],["κρίσις",707908,12],["τὰ",709436,41],["κατ᾿",707200,0],["αὐτὸν",702165,85],["ἀπελπίσας",701388,182],["ἔγραψεν",703194,2],["πρὸς",710844,0],["τοὺς",709436,58],["Ιουδαίους",706772,57],["τὴν",709436,8],["ὑπογεγραμμένην",713189,444],["ἐπιστολὴν",705272,9],["ἱκετηρίας",706717,82],["τάξιν",712712,9],["ἔχουσαν",705785,78],["περιέχουσαν",710315,78],["δὲ",703303,11],["οὕτως",709859,28]],"But for all this his pains would not cease: for the just judgment of God was come upon him: therefore despairing of his health, he wrote unto the Jews the letter underwritten, containing the form of a supplication, after this manner:"],["19",[["τοῖς",709436,147],["χρηστοῖς",713958,230],["Ιουδαίοις",706772,148],["τοῖς",709436,147],["πολίταις",710616,148],["πολλὰ",710646,68],["χαίρειν",713665,55],["καὶ",707031,7],["ὑγιαίνειν",713057,55],["καὶ",707031,7],["εὖ",705544,28],["πράττειν",710721,55],["βασιλεὺς",702580,4],["καὶ",707031,7],["στρατηγὸς",712144,4],["Ἀντίοχος",701257,4]],"Antiochus, king and governor, to the good Jews his citizens wisheth much joy, health, and prosperity:"],["20",[["εἰ",704071,7],["ἔρρωσθε",711323,680],["καὶ",707031,7],["τὰ",709436,41],["τέκνα",712761,42],["καὶ",707031,7],["τὰ",709436,41],["ἴδια",706493,68],["κατὰ",707200,0],["γνώμην",703134,9],["ἐστὶν",704093,91],["ὑμῖν",713084,90],["εἰς",704105,0],["οὐρανὸν",709844,6],["τὴν",709436,8],["ἐλπίδα",704530,9],["ἔχων",705785,72]],"if ye and your children fare well, and your affairs be to your contentment, I give very great thanks to God, having my hope in heaven."],["21",[["ὑμῶν",713091,145],["τὴν",709436,8],["τιμὴν",712856,9],["καὶ",707031,7],["τὴν",709436,8],["εὔνοιαν",705648,9],["ἐμνημόνευον",708965,137],["φιλοστόργως",713498,28],["ἐπανάγων",705015,72],["ἐκ",704132,0],["τῶν",709436,80],["κατὰ",707200,0],["τὴν",709436,8],["Περσίδα",710431,9],["τόπων",712903,81],["καὶ",707031,7],["περιπεσὼν",710364,182],["ἀσθενείᾳ",701937,1],["δυσχέρειαν",703881,9],["ἐχούσῃ",705785,220],["ἀναγκαῖον",700924,27],["ἡγησάμην",705931,161],["φροντίσαι",713590,106],["τῆς",709436,16],["κοινῆς",707772,82],["πάντων",710177,169],["ἀσφαλείας",702039,17]],"As for me, I was weak, or else I would have remembered kindly your honour and good will. Returning out of Persia, and being taken with a grievous disease, I thought it necessary to care for the common safety of all:"],["22",[["οὐκ",709805,28],["ἀπογινώσκων",701434,72],["τὰ",709436,41],["κατ᾿",707200,0],["ἐμαυτόν",704545,85],["ἀλλὰ",700680,7],["ἔχων",705785,72],["πολλὴν",710646,36],["ἐλπίδα",704530,9],["ἐκφεύξεσθαι",704357,492],["τὴν",709436,8],["ἀσθένειαν",701937,9]],"not distrusting mine health, but having great hope to escape this sickness."],["23",[["θεωρῶν",706226,72],["δὲ",703303,11],["ὅτι",709803,7],["καὶ",707031,7],["ὁ",709436,3],["πατήρ",710189,4],["καθ᾿",707200,0],["οὓς",709781,298],["καιροὺς",707047,57],["εἰς",704105,0],["τοὺς",709436,58],["ἄνω",701296,28],["τόπους",712903,57],["ἐστρατοπέδευσεν",712150,2],["ἀνέδειξεν",700935,2],["τὸν",709436,5],["διαδεξάμενον",703444,424]],"But considering that even my father, at what time he led an army into the high countries, appointed a successor,"],["24",[["ὅπως",709719,7],["ἐάν",703912,7],["τι",712866,126],["παράδοξον",710015,577],["ἀποβαίνῃ",701426,204],["ἢ",705924,7],["καὶ",707031,7],["προσαγγελθῇ",710846,384],["τι",712866,126],["δυσχερές",703882,46],["εἰδότες",704075,196],["οἱ",709436,136],["κατὰ",707200,0],["τὴν",709436,8],["χώραν",714011,9],["ᾧ",709781,309],["καταλέλειπται",707305,187],["τὰ",709436,41],["πράγματα",710708,42],["μὴ",708851,28],["ἐπιταράσσωνται",705292,232]],"to the end that, if any thing fell out contrary to expectation, or if any tidings were brought that were grievous, they of the land, knowing to whom the state was left, might not be troubled:"],["25",[["πρὸς",710844,0],["δὲ",703303,11],["τούτοις",709858,151],["κατανοῶν",707341,72],["τοὺς",709436,58],["παρακειμένους",710044,236],["δυνάστας",703844,57],["καὶ",707031,7],["γειτνιῶντας",703015,235],["τῇ",709436,100],["βασιλείᾳ",702577,1],["τοῖς",709436,147],["καιροῖς",707047,148],["ἐπέχοντας",705076,235],["καὶ",707031,7],["προσδοκῶντας",710876,235],["τὸ",709436,24],["ἀποβησόμενον",701426,400],["ἀναδέδειχα",700935,89],["τὸν",709436,5],["υἱὸν",713075,6],["Ἀντίοχον",701257,6],["βασιλέα",702580,6],["ὃν",709781,112],["πολλάκις",710617,28],["ἀνατρέχων",701075,72],["εἰς",704105,0],["τὰς",709436,38],["ἐπάνω",705030,28],["σατραπείας",711554,39],["τοῖς",709436,147],["πλείστοις",710646,343],["ὑμῶν",713091,145],["παρεκατετιθέμην",710043,334],["καὶ",707031,7],["συνίστων",712482,72],["γέγραφα",703194,89],["δὲ",703303,11],["πρὸς",710844,0],["αὐτὸν",702165,85],["τὰ",709436,41],["ὑπογεγραμμένα",713189,388]],"Again, considering how that the princes that are borderers and neighbours unto my kingdom wait for opportunities, and expect what shall be the event, I have appointed my son Antiochus king, whom I often committed and commended unto many of you, when I went up into the high provinces; to whom I have written as followeth:"],["26",[["παρακαλῶ",710039,157],["οὖν",709835,11],["ὑμᾶς",713080,194],["καὶ",707031,7],["ἀξιῶ",701309,157],["μεμνημένους",708923,360],["τῶν",709436,80],["εὐεργεσιῶν",705574,65],["κοινῇ",707772,101],["καὶ",707031,7],["κατ᾿",707200,0],["ἰδίαν",706493,36],["ἕκαστον",704133,27],["συντηρεῖν",712512,55],["τὴν",709436,8],["οὖσαν",704093,78],["εὔνοιαν",705648,9],["εἰς",704105,0],["ἐμὲ",704555,163],["καὶ",707031,7],["τὸν",709436,5],["υἱόν",713075,6]],"Therefore I pray and request you to remember the benefits that I have done unto you generally, and in special, and that every man will be still faithful to me and my son."],["27",[["πέπεισμαι",710221,326],["γὰρ",702963,11],["αὐτὸν",702165,85],["ἐπιεικῶς",705131,28],["καὶ",707031,7],["φιλανθρώπως",713464,28],["παρακολουθοῦντα",710053,183],["τῇ",709436,100],["ἐμῇ",704578,101],["προαιρέσει",710751,1],["συμπεριενεχθήσεσθαι",712330,681],["ὑμῖν",713084,90]],"For I am persuaded that he understanding my mind will favourably and graciously yield to your desires."],["28",[["ὁ",709436,3],["μὲν",708730,11],["οὖν",709835,11],["ἀνδροφόνος",701110,14],["καὶ",707031,7],["βλάσφημος",702739,14],["τὰ",709436,41],["χείριστα",707066,430],["παθών",710183,182],["ὡς",714148,7],["ἑτέρους",705535,60],["διέθηκεν",703609,2],["ἐπὶ",705080,0],["ξένης",709415,82],["ἐν",704639,0],["τοῖς",709436,95],["ὄρεσιν",709768,96],["οἰκτίστῳ",709522,30],["μόρῳ",709017,114],["κατέστρεψεν",707444,2],["τὸν",709436,5],["βίον",702724,6]],"Thus the murderer and blasphemer having suffered most grievously, as he entreated other men, so died he a miserable death in a strange country in the mountains."],["29",[["παρεκομίζετο",710054,19],["δὲ",703303,11],["τὸ",709436,24],["σῶμα",712635,25],["Φίλιππος",713476,4],["ὁ",709436,3],["σύντροφος",712525,14],["αὐτοῦ",702165,102],["ὃς",709781,213],["καὶ",707031,7],["διευλαβηθεὶς",703678,217],["τὸν",709436,5],["υἱὸν",713075,6],["Ἀντιόχου",701257,18],["πρὸς",710844,0],["Πτολεμαῖον",711066,6],["τὸν",709436,5],["Φιλομήτορα",713483,6],["εἰς",704105,0],["Αἴγυπτον",700401,9],["διεκομίσθη",703476,37]],"And Philip, that was brought up with him, carried away his body, who also fearing the son of Antiochus went into Egypt to Ptolemeus Philometor."]]