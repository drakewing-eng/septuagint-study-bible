[["1",[["μετ᾿",708780,0],["οὐ",709805,28],["πολὺν",710646,27],["δὲ",703303,11],["χρόνον",713969,6],["ἐξαπέστειλεν",704872,2],["ὁ",709436,3],["βασιλεὺς",702580,4],["γέροντα",703065,6],["Ἀθηναῖον",700373,6],["ἀναγκάζειν",700923,55],["τοὺς",709436,58],["Ιουδαίους",706772,57],["μεταβαίνειν",708781,55],["ἀπὸ",701425,0],["τῶν",709436,80],["πατρίων",710195,169],["νόμων",709349,81],["καὶ",707031,7],["τοῖς",709436,147],["τοῦ",709436,35],["θεοῦ",706192,18],["νόμοις",709349,148],["μὴ",708851,28],["πολιτεύεσθαι",710615,110]],"Not long after this the king sent an old man of Athens to compel the Jews to depart from the laws of their fathers, and not to live after the laws of God:"],["2",[["μολῦναι",708987,106],["δὲ",703303,11],["καὶ",707031,7],["τὸν",709436,5],["ἐν",704639,0],["Ιεροσολύμοις",706634,148],["νεὼ",709287,6],["καὶ",707031,7],["προσονομάσαι",710942,106],["Διὸς",705866,18],["Ὀλυμπίου",709603,18],["καὶ",707031,7],["τὸν",709436,5],["ἐν",704639,0],["Γαριζιν",702969,111],["καθὼς",707030,28],["ἐτύγχανον",713015,137],["οἱ",709436,136],["τὸν",709436,5],["τόπον",712903,6],["οἰκοῦντες",709499,146],["Διὸς",705866,18],["Ξενίου",709411,18]],"and to pollute also the temple in Jerusalem, and to call it the temple of Jupiter Olympius; and that in Garizim, of Jupiter the defender of strangers, as they did desire that dwelt in the place."],["3",[["χαλεπὴ",713682,29],["δὲ",703303,11],["καὶ",707031,7],["τοῖς",709436,147],["ὅλοις",709597,230],["ἦν",704093,13],["δυσχερὴς",703882,14],["ἡ",709436,10],["ἐπίτασις",705293,12],["τῆς",709436,16],["κακίας",707054,17]],"The coming in of this mischief was sore and grievous to the people:"],["4",[["τὸ",709436,34],["μὲν",708730,11],["γὰρ",702963,11],["ἱερὸν",706631,15],["ἀσωτίας",702065,17],["καὶ",707031,7],["κώμων",708023,81],["ὑπὸ",713184,0],["τῶν",709436,43],["ἐθνῶν",704068,44],["ἐπεπληροῦτο",705227,530],["ῥᾳθυμούντων",711155,84],["μεθ᾿",708780,0],["ἑταιρῶν",705527,65],["καὶ",707031,7],["ἐν",704639,0],["τοῖς",709436,95],["ἱεροῖς",706633,94],["περιβόλοις",710302,96],["γυναιξὶ",703209,76],["πλησιαζόντων",710546,84],["ἔτι",705538,28],["δὲ",703303,11],["τὰ",709436,41],["μὴ",708851,28],["καθήκοντα",706998,237],["ἔνδον",704692,28],["εἰσφερόντων",704127,84]],"for the temple was filled with riot and revelling by the Gentiles, who dallied with harlots, and had to do with women within the circuit of the holy places, and besides that brought in things that were not lawful."],["5",[["τὸ",709436,34],["δὲ",703303,11],["θυσιαστήριον",706348,15],["τοῖς",709436,147],["ἀποδιεσταλμένοις",701447,521],["ἀπὸ",701425,0],["τῶν",709436,80],["νόμων",709349,81],["ἀθεμίτοις",700363,230],["ἐπεπλήρωτο",710543,530]],"The altar also was filled with profane things, which the law forbiddeth."],["6",[["ἦν",704093,13],["δ᾿",703303,11],["οὔτε",709857,7],["σαββατίζειν",711349,55],["οὔτε",709857,7],["πατρῴους",710199,60],["ἑορτὰς",704990,39],["διαφυλάττειν",703632,55],["οὔτε",709857,7],["ἁπλῶς",701423,28],["Ιουδαῖον",706772,6],["ὁμολογεῖν",709632,55],["εἶναι",704093,55]],"Neither was it lawful for a man to keep sabbath days or ancient feasts, or to profess himself at all to be a Jew."],["7",[["ἤγοντο",700209,139],["δὲ",703303,11],["μετὰ",708780,0],["πικρᾶς",710475,82],["ἀνάγκης",700925,17],["εἰς",704105,0],["τὴν",709436,8],["κατὰ",707200,0],["μῆνα",708874,6],["τοῦ",709436,35],["βασιλέως",702580,18],["γενέθλιον",703039,36],["ἡμέραν",705984,9],["ἐπὶ",705080,0],["σπλαγχνισμόν",712017,6],["γενομένης",703104,638],["δὲ",703303,11],["Διονυσίων",703723,44],["ἑορτῆς",704990,17],["ἠναγκάζοντο",700923,667],["κισσοὺς",707693,57],["ἔχοντες",705785,146],["πομπεύειν",710655,55],["τῷ",709436,113],["Διονύσῳ",703724,114]],"And in the day of the king's birth every month they were brought by bitter constraint to eat of the sacrifices; and when the feast of Bacchus was kept, the Jews were compelled to go in procession to Bacchus, carrying ivy."],["8",[["ψήφισμα",714050,25],["δὲ",703303,11],["ἐξέπεσεν",704284,2],["εἰς",704105,0],["τὰς",709436,38],["ἀστυγείτονας",702026,119],["Ἑλληνίδας",704518,39],["πόλεις",710612,39],["Πτολεμαίου",711066,18],["ὑποθεμένου",713251,292],["τὴν",709436,8],["αὐτὴν",702165,104],["ἀγωγὴν",700210,9],["κατὰ",707200,0],["τῶν",709436,80],["Ιουδαίων",706772,81],["ἄγειν",700209,55],["καὶ",707031,7],["σπλαγχνίζειν",712016,55]],"Moreover there went out a decree to the neighbour cities of the heathen, by the suggestion of Ptolemee, against the Jews, that they should observe the same fashions, and be partakers of their sacrifices:"],["9",[["τοὺς",709436,58],["δὲ",703303,11],["μὴ",708851,28],["προαιρουμένους",710752,236],["μεταβαίνειν",708781,55],["ἐπὶ",705080,0],["τὰ",709436,41],["ἑλληνικὰ",704516,68],["κατασφάζειν",707448,55],["παρῆν",710126,13],["οὖν",709835,11],["ὁρᾶν",709725,55],["τὴν",709436,8],["ἐνεστῶσαν",704749,610],["ταλαιπωρίαν",712695,9]],"and whoso would not conform themselves to the manners of the Gentiles should be put to death. Then might a man have seen the present misery."],["10",[["δύο",703849,59],["γὰρ",702963,11],["γυναῖκες",703209,191],["ἀνήχθησαν",700933,99],["περιτετμηκυῖαι",710402,570],["τὰ",709436,41],["τέκνα",712761,42],["τούτων",709858,284],["δὲ",703303,11],["ἐκ",704132,0],["τῶν",709436,80],["μαστῶν",708569,81],["κρεμάσαντες",707892,196],["τὰ",709436,41],["βρέφη",702811,42],["καὶ",707031,7],["δημοσίᾳ",703412,101],["περιαγαγόντες",710287,196],["αὐτὰς",702165,231],["τὴν",709436,8],["πόλιν",710612,9],["κατὰ",707200,0],["τοῦ",709436,20],["τείχους",712759,21],["ἐκρήμνισαν",707894,610]],"For there were two women brought, who had circumcised their children; whom when they had openly led round about the city, the babes hanging at their breasts, they cast them down headlong from the wall."],["11",[["ἕτεροι",705535,138],["δὲ",703303,11],["πλησίον",710547,28],["συνδραμόντες",712518,196],["εἰς",704105,0],["τὰ",709436,41],["σπήλαια",712012,42],["λεληθότως",708141,28],["ἄγειν",700209,55],["τὴν",709436,8],["ἑβδομάδα",703921,9],["μηνυθέντες",708881,247],["τῷ",709436,113],["Φιλίππῳ",713476,114],["συνεφλογίσθησαν",712356,99],["διὰ",703417,0],["τὸ",709436,24],["εὐλαβῶς",705629,28],["ἔχειν",705785,55],["βοηθῆσαι",702746,106],["ἑαυτοῖς",703917,151],["κατὰ",707200,0],["τὴν",709436,8],["δόξαν",703791,9],["τῆς",709436,16],["σεμνοτάτης",711682,416],["ἡμέρας",705984,17]],"And others, that had run together into caves near by, to keep the sabbath day secretly, being discovered to Philip, were all burnt together, because they made a conscience to help themselves for the honour of the most sacred day."],["12",[["παρακαλῶ",710039,157],["οὖν",709835,11],["τοὺς",709436,58],["ἐντυγχάνοντας",704812,235],["τῇδε",709446,105],["τῇ",709436,100],["βίβλῳ",702721,1],["μὴ",708851,28],["συστέλλεσθαι",712063,110],["διὰ",703417,0],["τὰς",709436,38],["συμφοράς",712357,39],["λογίζεσθαι",708232,110],["δὲ",703303,11],["τὰς",709436,38],["τιμωρίας",712863,39],["μὴ",708851,28],["πρὸς",710844,0],["ὄλεθρον",709563,6],["ἀλλὰ",700680,7],["πρὸς",710844,0],["παιδείαν",709924,9],["τοῦ",709436,20],["γένους",703057,21],["ἡμῶν",705999,145],["εἶναι",704093,55]],"Now I beseech those that read this book, that they be not discouraged for these calamities, but that they judge those punishments not to be for destruction, but for a chastening of our nation."],["13",[["καὶ",707031,7],["γὰρ",702963,11],["τὸ",709436,24],["μὴ",708851,28],["πολὺν",710646,27],["χρόνον",713969,6],["ἐᾶσθαι",703918,110],["τοὺς",709436,58],["δυσσεβοῦντας",703871,235],["ἀλλ᾿",700680,7],["εὐθέως",705593,28],["περιπίπτειν",710364,55],["ἐπιτίμοις",705309,230],["μεγάλης",708653,82],["εὐεργεσίας",705574,17],["σημεῖόν",711748,25],["ἐστιν",704093,91]],"For it is a token of his great goodness, when wicked doers are not suffered any longer time, but forthwith punished."],["14",[["οὐ",709805,28],["γὰρ",702963,11],["καθάπερ",706984,28],["καὶ",707031,7],["ἐπὶ",705080,0],["τῶν",709436,43],["ἄλλων",700697,70],["ἐθνῶν",704068,44],["ἀναμένει",701000,91],["μακροθυμῶν",708420,169],["ὁ",709436,3],["δεσπότης",703379,4],["μέχρι",708849,0],["τοῦ",709436,35],["καταντήσαντας",707343,454],["αὐτοὺς",702165,62],["πρὸς",710844,0],["ἐκπλήρωσιν",704286,9],["ἁμαρτιῶν",700775,65],["κολάσαι",707786,106],["οὕτως",709859,28],["καὶ",707031,7],["ἐφ᾿",705080,0],["ἡμῶν",705999,145],["ἔκρινεν",707905,2],["εἶναι",704093,55]],"For not as with other nations, whom the Lord patiently forbeareth to punish, till they be come to the fulness of their sins, so dealeth he with us,"],["15",[["ἵνα",706747,7],["μὴ",708851,28],["πρὸς",710844,0],["τέλος",712787,25],["ἀφικομένων",702212,490],["ἡμῶν",705999,145],["τῶν",709436,130],["ἁμαρτιῶν",700775,65],["ὕστερον",713273,28],["ἡμᾶς",705981,194],["ἐκδικᾷ",704173,106]],"lest that, being come to the height of sin, afterwards he should take vengeance of us."],["16",[["διόπερ",703725,28],["οὐδέποτε",709818,28],["μὲν",708730,11],["τὸν",709436,24],["ἔλεον",704426,25],["ἀφ᾿",701425,0],["ἡμῶν",705999,145],["ἀφίστησιν",702214,19],["παιδεύων",709926,72],["δὲ",703303,11],["μετὰ",708780,0],["συμφορᾶς",712357,17],["οὐκ",709805,28],["ἐγκαταλείπει",703967,91],["τὸν",709436,5],["ἑαυτοῦ",703917,102],["λαόν",708094,6]],"And therefore he never withdraweth his mercy from us: and though he punish with adversity, yet doth he never forsake his people."],["17",[["πλὴν",710540,28],["ἕως",705792,0],["ὑπομνήσεως",713225,17],["ταῦθ᾿",709858,71],["ἡμῖν",705994,90],["εἰρήσθω",705415,678],["δι᾿",703417,0],["ὀλίγων",709568,169],["δ᾿",703303,11],["ἐλευστέον",704431,26],["ἐπὶ",705080,0],["τὴν",709436,8],["διήγησιν",703681,9]],"But let this that we have spoken be for a warning unto us. And now will we come to the declaring of the matter in a few words."],["18",[["Ελεάζαρός",704408,4],["τις",712866,158],["τῶν",709436,80],["πρωτευόντων",711030,170],["γραμματέων",703185,81],["ἀνὴρ",701150,4],["ἤδη",705939,28],["προβεβηκὼς",710763,270],["τὴν",709436,8],["ἡλικίαν",705971,9],["καὶ",707031,7],["τὴν",709436,8],["πρόσοψιν",710948,9],["τοῦ",709436,20],["προσώπου",710986,21],["κάλλιστος",707097,140],["ἀναχανὼν",701090,182],["ἠναγκάζετο",700923,530],["φαγεῖν",713296,106],["ὕειον",713072,46],["κρέας",707889,25]],"Eleazar, one of the principal scribes, an aged man, and of a well-favoured countenance, was constrained to open his mouth, and to eat swine's flesh."],["19",[["ὁ",709436,3],["δὲ",703303,11],["τὸν",709436,5],["μετ᾿",708780,0],["εὐκλείας",705618,17],["θάνατον",706096,6],["μᾶλλον",708448,28],["ἢ",705924,7],["τὸν",709436,5],["μετὰ",708780,0],["μύσους",709078,21],["βίον",702724,6],["ἀναδεξάμενος",700938,248],["αὐθαιρέτως",702126,28],["ἐπὶ",705080,0],["τὸ",709436,24],["τύμπανον",713019,25],["προσῆγεν",710848,13]],"But he, choosing rather to die gloriously, than to live stained with such an abomination, spit it forth, and came of his own accord to the torment."],["20",[["προπτύσας",710841,182],["δὲ",703303,11],["καθ᾿",707200,0],["ὃν",709781,112],["ἔδει",705495,127],["τρόπον",712980,6],["προσέρχεσθαι",710890,110],["τοὺς",709436,58],["ὑπομένοντας",713219,235],["ἀμύνασθαι",700880,109],["ὧν",709781,252],["οὐ",709805,28],["θέμις",706184,12],["γεύσασθαι",703074,109],["διὰ",703417,0],["τὴν",709436,8],["πρὸς",710844,0],["τὸ",709436,24],["ζῆν",705851,55],["φιλοστοργίαν",713496,9]],"As it behoved them to come, that are resolute to stand out against such things as are not lawful for love of life to be tasted."],["21",[["οἱ",709436,136],["δὲ",703303,11],["πρὸς",710844,0],["τῷ",709436,113],["παρανόμῳ",710080,30],["σπλαγχνισμῷ",712017,114],["τεταγμένοι",712730,429],["διὰ",703417,0],["τὴν",709436,8],["ἐκ",704132,0],["τῶν",709436,80],["παλαιῶν",709936,169],["χρόνων",713969,81],["πρὸς",710844,0],["τὸν",709436,5],["ἄνδρα",701150,6],["γνῶσιν",703138,9],["ἀπολαβόντες",701504,196],["αὐτὸν",702165,85],["κατ᾿",707200,0],["ἰδίαν",706493,36],["παρεκάλουν",710039,137],["ἐνέγκαντα",713428,365],["κρέα",707889,42],["οἷς",709781,311],["καθῆκον",706998,47],["αὐτῷ",702165,50],["χρᾶσθαι",713936,110],["δι᾿",703417,0],["αὐτοῦ",702165,102],["παρασκευασθέντα",710103,377],["ὑποκριθῆναι",713207,179],["δὲ",703303,11],["ὡς",714148,7],["ἐσθίοντα",705495,183],["τὰ",709436,41],["ὑπὸ",713184,0],["τοῦ",709436,35],["βασιλέως",702580,18],["προστεταγμένα",710962,388],["τῶν",709436,80],["ἀπὸ",701425,0],["τῆς",709436,16],["θυσίας",706345,17],["κρεῶν",707889,44]],"But they that had the charge of that wicked feast, for the old acquaintance they had with the man, taking him aside, besought him to bring flesh of his own provision, such as was lawful for him to use, and make as if he did eat of the flesh taken from the sacrifice commanded by the king;"],["22",[["ἵνα",706747,7],["τοῦτο",709858,129],["πράξας",710721,182],["ἀπολυθῇ",701524,384],["τοῦ",709436,35],["θανάτου",706096,18],["καὶ",707031,7],["διὰ",703417,0],["τὴν",709436,8],["ἀρχαίαν",701835,36],["πρὸς",710844,0],["αὐτοὺς",702165,62],["φιλίαν",713474,9],["τύχῃ",713034,1],["φιλανθρωπίας",713462,17]],"that in so doing he might be delivered from death, and for the old friendship with them find favour."],["23",[["ὁ",709436,3],["δὲ",703303,11],["λογισμὸν",708234,6],["ἀστεῖον",702014,27],["ἀναλαβὼν",700984,182],["καὶ",707031,7],["ἄξιον",701308,27],["τῆς",709436,16],["ἡλικίας",705971,17],["καὶ",707031,7],["τῆς",709436,16],["τοῦ",709436,35],["γήρως",703089,21],["ὑπεροχῆς",713155,17],["καὶ",707031,7],["τῆς",709436,16],["ἐπικτήτου",705182,82],["καὶ",707031,7],["ἐπιφανοῦς",705319,82],["πολιᾶς",710607,17],["καὶ",707031,7],["τῆς",709436,16],["ἐκ",704132,0],["παιδὸς",709932,18],["καλλίστης",707097,416],["ἀναστροφῆς",701061,17],["μᾶλλον",708448,28],["δὲ",703303,11],["τῆς",709436,16],["ἁγίας",700159,82],["καὶ",707031,7],["θεοκτίστου",706190,82],["νομοθεσίας",709344,17],["ἀκολούθως",700569,28],["ἀπεφήνατο",701631,23],["ταχέως",712743,28],["λέγων",708124,72],["προπέμπειν",710835,55],["εἰς",704105,0],["τὸν",709436,5],["ᾅδην",700255,6]],"But he began to consider discreetly, and as became his age, and the excellency of his ancient years, and the honour of his gray head, whereunto he was come, and his most honest education from a child, or rather the holy law made and given by God: therefore he answered accordingly, and willed them straightways to send him to the grave."],["24",[["οὐ",709805,28],["γὰρ",702963,11],["τῆς",709436,16],["ἡμετέρας",705987,82],["ἡλικίας",705971,17],["ἄξιόν",701308,27],["ἐστιν",704093,91],["ὑποκριθῆναι",713207,179],["ἵνα",706747,7],["πολλοὶ",710646,138],["τῶν",709436,80],["νέων",709256,169],["ὑπολαβόντες",713210,196],["Ελεαζαρον",704408,6],["τὸν",709436,5],["ἐνενηκονταετῆ",704714,59],["μεταβεβηκέναι",708781,115],["εἰς",704105,0],["ἀλλοφυλισμὸν",700705,6]],"For it becometh not our age, [said he], in any wise to dissemble, whereby many young persons might think that Eleazar, being fourscore years old and ten, were now gone to a strange religion;"],["25",[["καὶ",707031,7],["αὐτοὶ",702165,201],["διὰ",703417,0],["τὴν",709436,8],["ἐμὴν",704578,36],["ὑπόκρισιν",713208,9],["καὶ",707031,7],["διὰ",703417,0],["τὸ",709436,24],["μικρὸν",708915,46],["καὶ",707031,7],["ἀκαριαῖον",700520,46],["ζῆν",705851,55],["πλανηθῶσιν",710495,272],["δι᾿",703417,0],["ἐμέ",704555,163],["καὶ",707031,7],["μύσος",709078,25],["καὶ",707031,7],["κηλῖδα",707652,9],["τοῦ",709436,35],["γήρως",703089,21],["κατακτήσωμαι",707293,410]],"and so they through mine hypocrisy, and desire to live a little time and a moment longer, should be deceived by me, and I get a stain to mine old age, and make it abominable."],["26",[["εἰ",704071,7],["γὰρ",702963,11],["καὶ",707031,7],["ἐπὶ",705080,0],["τοῦ",709436,35],["παρόντος",710126,152],["ἐξελοῦμαι",704838,181],["τὴν",709436,8],["ἐξ",704132,0],["ἀνθρώπων",701163,81],["τιμωρίαν",712863,9],["ἀλλὰ",700680,7],["τὰς",709436,38],["τοῦ",709436,35],["παντοκράτορος",709986,18],["χεῖρας",713787,39],["οὔτε",709857,7],["ζῶν",705851,72],["οὔτε",709857,7],["ἀποθανὼν",701461,182],["ἐκφεύξομαι",704357,181]],"For though for the present time I should be delivered from the punishment of men: yet should I not escape the hand of the Almighty, neither alive, nor dead."],["27",[["διόπερ",703725,28],["ἀνδρείως",701103,28],["μὲν",708730,11],["νῦν",709384,28],["διαλλάξας",703502,182],["τὸν",709436,5],["βίον",702724,6],["τοῦ",709436,35],["μὲν",708730,11],["γήρως",703089,21],["ἄξιος",701308,14],["φανήσομαι",713311,180]],"Wherefore now, manfully changing this life, I will shew myself such an one as mine age requireth,"],["28",[["τοῖς",709436,147],["δὲ",703303,11],["νέοις",709256,230],["ὑπόδειγμα",713191,25],["γενναῖον",703048,46],["καταλελοιπὼς",707305,270],["εἰς",704105,0],["τὸ",709436,24],["προθύμως",710800,28],["καὶ",707031,7],["γενναίως",703050,28],["ὑπὲρ",713111,0],["τῶν",709436,80],["σεμνῶν",711682,169],["καὶ",707031,7],["ἁγίων",700159,169],["νόμων",709349,81],["ἀπευθανατίζειν",701399,55],["τοσαῦτα",712907,71],["δὲ",703303,11],["εἰπὼν",708124,182],["ἐπὶ",705080,0],["τὸ",709436,24],["τύμπανον",713019,25],["εὐθέως",705593,28],["ἦλθεν",705453,2]],"and leave a notable example to such as be young to die willingly and courageously for the honourable and holy laws. And when he had said these words, immediately he went to the torment:"],["29",[["τῶν",709436,80],["δὲ",703303,11],["ἀγόντων",700209,170],["πρὸς",710844,0],["αὐτὸν",702165,85],["τὴν",709436,8],["μικρῷ",708915,30],["πρότερον",710991,28],["εὐμένειαν",705639,9],["εἰς",704105,0],["δυσμένειαν",703862,9],["μεταβαλόντων",708782,221],["διὰ",703417,0],["τὸ",709436,24],["τοὺς",709436,58],["προειρημένους",710788,360],["λόγους",708236,57],["ὡς",714148,7],["αὐτοὶ",702165,201],["διελάμβανον",703493,137],["ἀπόνοιαν",701535,9],["εἶναι",704093,55]],"they that led him changing the good will they bare him a little before into hatred, because the foresaid speeches proceeded, as they thought, from a desperate mind."],["30",[["μέλλων",708705,72],["δὲ",703303,11],["ταῖς",709436,75],["πληγαῖς",710527,76],["τελευτᾶν",712781,55],["ἀναστενάξας",701057,182],["εἶπεν",705373,2],["τῷ",709436,113],["κυρίῳ",707996,114],["τῷ",709436,113],["τὴν",709436,8],["ἁγίαν",700159,36],["γνῶσιν",703138,9],["ἔχοντι",705785,379],["φανερόν",713342,27],["ἐστιν",704093,91],["ὅτι",709803,7],["δυνάμενος",703838,122],["ἀπολυθῆναι",701524,179],["τοῦ",709436,35],["θανάτου",706096,18],["σκληρὰς",711861,119],["ὑποφέρω",713256,157],["κατὰ",707200,0],["τὸ",709436,24],["σῶμα",712635,25],["ἀλγηδόνας",700639,39],["μαστιγούμενος",708566,122],["κατὰ",707200,0],["ψυχὴν",714070,9],["δὲ",703303,11],["ἡδέως",705938,28],["διὰ",703417,0],["τὸν",709436,5],["αὐτοῦ",702165,102],["φόβον",713534,6],["ταῦτα",709858,71],["πάσχω",710183,157]],"But when he was ready to die with stripes, he groaned, and said, It is manifest unto the Lord, that hath the holy knowledge, that whereas I might have been delivered from death, I [now] endure sore pains in body by being beaten: but in soul am well content to suffer these things, because I fear him."],["31",[["καὶ",707031,7],["οὗτος",709858,121],["οὖν",709835,11],["τοῦτον",709858,85],["τὸν",709436,5],["τρόπον",712980,6],["μετήλλαξεν",708801,2],["οὐ",709805,28],["μόνον",709001,27],["τοῖς",709436,147],["νέοις",709256,230],["ἀλλὰ",700680,7],["καὶ",707031,7],["τοῖς",709436,95],["πλείστοις",710646,509],["τοῦ",709436,20],["ἔθνους",704068,21],["τὸν",709436,5],["ἑαυτοῦ",703917,102],["θάνατον",706096,6],["ὑπόδειγμα",713191,25],["γενναιότητος",703049,17],["καὶ",707031,7],["μνημόσυνον",708966,25],["ἀρετῆς",701727,17],["καταλιπών",707305,182]],"And thus this man died, leaving his death for an example of a noble courage, and a memorial of virtue, not only unto young men, but unto all his nation."]]