[["1",[["Ιουδας",706775,4],["δὲ",703303,11],["ὁ",709436,3],["καὶ",707031,7],["Μακκαβαῖος",708410,4],["καὶ",707031,7],["οἱ",709436,136],["σὺν",712372,0],["αὐτῷ",702165,50],["παρεισπορευόμενοι",710127,348],["λεληθότως",708141,28],["εἰς",704105,0],["τὰς",709436,38],["κώμας",708022,39],["προσεκαλοῦντο",710912,139],["τοὺς",709436,58],["συγγενεῖς",712185,60],["καὶ",707031,7],["τοὺς",709436,58],["μεμενηκότας",708736,277],["ἐν",704639,0],["τῷ",709436,113],["Ιουδαϊσμῷ",706773,114],["προσλαμβανόμενοι",710930,348],["συνήγαγον",712375,150],["εἰς",704105,0],["ἑξακισχιλίους",704844,60]],"Then Judas Maccabeus, and they that were with him, went privily into the towns, and called their kinsfolks together, and took unto them all such as continued in the Jews' religion, and assembled about six thousand men."],["2",[["καὶ",707031,7],["ἐπεκαλοῦντο",705153,139],["τὸν",709436,5],["κύριον",707996,6],["ἐπιδεῖν",705118,55],["τὸν",709436,5],["ὑπὸ",713184,0],["πάντων",710177,169],["καταπατούμενον",707360,212],["λαόν",708094,6],["οἰκτῖραι",709518,106],["δὲ",703303,11],["καὶ",707031,7],["τὸν",709436,5],["ναὸν",709191,6],["τὸν",709436,5],["ὑπὸ",713184,0],["τῶν",709436,80],["ἀσεβῶν",701909,169],["ἀνθρώπων",701163,81],["βεβηλωθέντα",702614,260]],"And they called upon the Lord, that he would look upon the people that was trodden down of all; and also pity the temple profaned of ungodly men;"],["3",[["ἐλεῆσαι",704418,106],["δὲ",703303,11],["καὶ",707031,7],["τὴν",709436,8],["καταφθειρομένην",707474,173],["πόλιν",710612,9],["καὶ",707031,7],["μέλλουσαν",708705,78],["ἰσόπεδον",706829,46],["γίνεσθαι",703104,110],["καὶ",707031,7],["τῶν",709436,80],["καταβοώντων",707213,170],["πρὸς",710844,0],["αὐτὸν",702165,85],["αἱμάτων",700442,44],["εἰσακοῦσαι",704108,106]],"and that he would have compassion upon the city, sore defaced, and ready to be made even with the ground; and hear the blood that cried unto him,"],["4",[["μνησθῆναι",708960,179],["δὲ",703303,11],["καὶ",707031,7],["τῆς",709436,16],["τῶν",709436,80],["ἀναμαρτήτων",700998,169],["νηπίων",709295,169],["παρανόμου",710080,116],["ἀπωλείας",701660,17],["καὶ",707031,7],["περὶ",710285,0],["τῶν",709436,80],["γενομένων",703104,490],["εἰς",704105,0],["τὸ",709436,24],["ὄνομα",709666,25],["αὐτοῦ",702165,102],["βλασφημιῶν",702738,65],["καὶ",707031,7],["μισοπονηρῆσαι",708944,106]],"and remember the wicked slaughter of harmless infants, and the blasphemies committed against his name; and that he would shew his hatred against the wicked."],["5",[["γενόμενος",703104,248],["δὲ",703303,11],["ὁ",709436,3],["Μακκαβαῖος",708410,18],["ἐν",704639,0],["συστέματι",712559,114],["ἀνυπόστατος",701292,14],["ἤδη",705939,28],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["ἐγίνετο",703104,19],["τῆς",709436,16],["ὀργῆς",709728,17],["τοῦ",709436,35],["κυρίου",707996,18],["εἰς",704105,0],["ἔλεον",704426,25],["τραπείσης",712929,493]],"Now when Maccabeus had his company about him, he could not be withstood by the heathen: for the wrath of the Lord was turned into mercy."],["6",[["πόλεις",710612,39],["δὲ",703303,11],["καὶ",707031,7],["κώμας",708022,39],["ἀπροσδοκήτως",701649,28],["ἐρχόμενος",705453,122],["ἐνεπίμπρα",704592,2],["καὶ",707031,7],["τοὺς",709436,58],["ἐπικαίρους",705152,60],["τόπους",712903,57],["ἀπολαμβάνων",701504,72],["οὐκ",709805,28],["ὀλίγους",709568,60],["τῶν",709436,80],["πολεμίων",710603,169],["τροπούμενος",712981,122]],"Therefore he came at unawares, and burnt up towns and cities, and got into his hands the most commodious places, and overcame and put to flight no small number of his enemies."],["7",[["μάλιστα",708446,28],["τὰς",709436,38],["νύκτας",709386,39],["πρὸς",710844,0],["τὰς",709436,38],["τοιαύτας",712878,119],["ἐπιβολὰς",705093,39],["συνεργοὺς",712456,60],["ἐλάμβανεν",708076,13],["καὶ",707031,7],["λαλιὰ",708074,12],["τῆς",709436,16],["εὐανδρίας",705552,17],["αὐτοῦ",702165,102],["διηχεῖτο",703686,13],["πανταχῆ",709974,28]],"But specially took he advantage of the night for such privy attempts, insomuch that the bruit of his manliness was spread every where."],["8",[["συνορῶν",712433,72],["δὲ",703303,11],["ὁ",709436,3],["Φίλιππος",713476,4],["κατὰ",707200,0],["μικρὸν",708915,27],["εἰς",704105,0],["προκοπὴν",710813,9],["ἐρχόμενον",705453,212],["τὸν",709436,5],["ἄνδρα",701150,6],["πυκνότερον",711081,61],["δὲ",703303,11],["ἐν",704639,0],["ταῖς",709436,75],["εὐημερίαις",705585,76],["προβαίνοντα",710763,183],["πρὸς",710844,0],["Πτολεμαῖον",711066,6],["τὸν",709436,5],["Κοίλης",707760,17],["Συρίας",712533,17],["καὶ",707031,7],["Φοινίκης",713538,17],["στρατηγὸν",712144,6],["ἔγραψεν",703194,2],["ἐπιβοηθεῖν",705091,55],["τοῖς",709436,147],["τοῦ",709436,35],["βασιλέως",702580,18],["πράγμασιν",710708,96]],"So when Philip saw that this man increased by little and little, and that things prospered with him still more and more, he wrote unto Ptolemeus, the governor of Celosyria and Phenice, to yield more aid to the king's affairs."],["9",[["ὁ",709436,3],["δὲ",703303,11],["ταχέως",712743,28],["προχειρισάμενος",711016,248],["Νικάνορα",709308,6],["τὸν",709436,5],["τοῦ",709436,35],["Πατρόκλου",710197,18],["τῶν",709436,80],["πρώτων",711041,616],["φίλων",713492,169],["ἀπέστειλεν",701592,2],["ὑποτάξας",713250,182],["παμφύλων",709955,169],["ἔθνη",704068,42],["οὐκ",709805,28],["ἐλάττους",704388,68],["τῶν",709436,80],["δισμυρίων",703743,198],["τὸ",709436,24],["σύμπαν",712324,46],["τῆς",709436,16],["Ιουδαίας",706769,17],["ἐξᾶραι",704839,106],["γένος",703057,25],["συνέστησεν",712482,2],["δὲ",703303,11],["αὐτῷ",702165,50],["καὶ",707031,7],["Γοργίαν",703174,9],["ἄνδρα",701150,6],["στρατηγὸν",712144,6],["καὶ",707031,7],["ἐν",704639,0],["πολεμικαῖς",710602,291],["χρείαις",713938,76],["πεῖραν",710224,9],["ἔχοντα",705785,183]],"Then forthwith choosing Nicanor the [son] of Patroclus, one of his special friends, he sent him with no fewer than twenty thousand of all nations under him, to root out the whole generation of the Jews; and with him he joined also Gorgias a captain, who in matters of war had great experience."],["10",[["διεστήσατο",703690,23],["δὲ",703303,11],["ὁ",709436,3],["Νικάνωρ",709308,4],["τὸν",709436,5],["φόρον",713561,6],["τῷ",709436,113],["βασιλεῖ",702580,114],["τοῖς",709436,147],["Ῥωμαίοις",711318,148],["ὄντα",704093,183],["ταλάντων",712697,44],["δισχιλίων",703747,83],["ἐκ",704132,0],["τῆς",709436,16],["τῶν",709436,80],["Ιουδαίων",706772,81],["αἰχμαλωσίας",700499,17],["ἐκπληρώσειν",704285,296]],"So Nicanor undertook to make so much money of the captive Jews, as should defray the tribute of two thousand talents, which the king was to pay to the Romans."],["11",[["εὐθέως",705593,28],["δὲ",703303,11],["εἰς",704105,0],["τὰς",709436,38],["παραθαλασσίους",710023,119],["πόλεις",710612,39],["ἀπέστειλεν",701592,2],["προκαλούμενος",710808,122],["ἐπ᾿",705080,0],["ἀγορασμὸν",700186,6],["Ιουδαίων",706772,81],["σωμάτων",712635,44],["ὑπισχνούμενος",713180,679],["ἐνενήκοντα",704713,59],["σώματα",712635,42],["ταλάντου",712697,21],["παραχωρήσειν",710120,296],["οὐ",709805,28],["προσδεχόμενος",710874,122],["τὴν",709436,8],["παρὰ",709995,0],["τοῦ",709436,35],["παντοκράτορος",709986,18],["μέλλουσαν",708705,78],["παρακολουθήσειν",710053,296],["ἐπ᾿",705080,0],["αὐτῷ",702165,50],["δίκην",703702,9]],"Wherefore immediately he sent to the cities upon the sea coast, proclaiming a sale of the captive Jews, and promising that they should have fourscore and ten bodies for one talent, not expecting the vengeance that was to follow upon him from the Almighty God."],["12",[["τῷ",709436,113],["δὲ",703303,11],["Ιουδα",706775,114],["προσέπεσεν",710952,2],["περὶ",710285,0],["τῆς",709436,16],["τοῦ",709436,35],["Νικάνορος",709308,18],["ἐφόδου",705760,17],["καὶ",707031,7],["μεταδόντος",708791,500],["τοῖς",709436,147],["σὺν",712372,0],["αὐτῷ",702165,50],["τὴν",709436,8],["παρουσίαν",710172,9],["τοῦ",709436,20],["στρατοπέδου",712151,21]],"Now when word was brought unto Judas of Nicanor's coming, and he had imparted unto those that were with him that the army was at hand,"],["13",[["οἱ",709436,136],["δειλανδροῦντες",703317,146],["καὶ",707031,7],["ἀπιστοῦντες",701411,146],["τὴν",709436,8],["τοῦ",709436,35],["θεοῦ",706192,18],["δίκην",703702,9],["διεδίδρασκον",703448,137],["ἑαυτοὺς",703917,62],["καὶ",707031,7],["ἐξετόπιζον",704338,137]],"they that were fearful, and distrusted the justice of God, fled, and conveyed themselves away."],["14",[["οἱ",709436,136],["δὲ",703303,11],["τὰ",709436,41],["περιλελειμμένα",710343,388],["πάντα",710177,68],["ἐπώλουν",711116,137],["ὁμοῦ",709644,28],["δὲ",703303,11],["τὸν",709436,5],["κύριον",707996,6],["ἠξίουν",701309,137],["ῥύσασθαι",711309,109],["τοὺς",709436,58],["ὑπὸ",713184,0],["τοῦ",709436,35],["δυσσεβοῦς",703873,116],["Νικάνορος",709308,18],["πρὶν",710742,28],["συντυχεῖν",712527,106],["πεπραμένους",710480,360]],"Others sold all that they had left, and withal besought the Lord to deliver them, being sold by the wicked Nicanor before they met together:"],["15",[["καὶ",707031,7],["εἰ",704071,7],["μὴ",708851,28],["δι᾿",703417,0],["αὐτούς",702165,62],["ἀλλὰ",700680,7],["διὰ",703417,0],["τὰς",709436,38],["πρὸς",710844,0],["τοὺς",709436,58],["πατέρας",710189,57],["αὐτῶν",702165,40],["διαθήκας",703456,39],["καὶ",707031,7],["ἕνεκα",704709,0],["τῆς",709436,16],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["ἐπικλήσεως",705164,17],["τοῦ",709436,35],["σεμνοῦ",711682,116],["καὶ",707031,7],["μεγαλοπρεποῦς",708633,92],["ὀνόματος",709666,21],["αὐτοῦ",702165,102]],"and if not for their own sakes, yet for the covenants he had made with their fathers, and for his holy and glorious name's sake, by which they were called."],["16",[["συναγαγὼν",712375,182],["δὲ",703303,11],["ὁ",709436,3],["Μακκαβαῖος",708410,4],["τοὺς",709436,58],["περὶ",710285,0],["αὐτὸν",702165,85],["ὄντας",704093,235],["ἀριθμὸν",701744,6],["ἑξακισχιλίους",704844,60],["παρεκάλει",710039,13],["μὴ",708851,28],["καταπλαγῆναι",707380,179],["τοῖς",709436,147],["πολεμίοις",710603,230],["μηδὲ",708855,7],["εὐλαβεῖσθαι",705627,110],["τὴν",709436,8],["τῶν",709436,80],["ἀδίκως",700273,28],["παραγινομένων",710006,299],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["ἐθνῶν",704068,44],["πολυπλήθειαν",710641,9],["ἀγωνίσασθαι",700214,109],["δὲ",703303,11],["γενναίως",703050,28]],"So Maccabeus called his men together unto the number of six thousand, and exhorted them not to be stricken with terror of the enemy, nor to fear the great multitude of the heathen, who came wrongfully against them; but to fight manfully,"],["17",[["πρὸ",710747,0],["ὀφθαλμῶν",709870,81],["λαβόντας",708076,454],["τὴν",709436,8],["ἀνόμως",701195,28],["εἰς",704105,0],["τὸν",709436,5],["ἅγιον",700159,27],["τόπον",712903,6],["συντετελεσμένην",712510,444],["ὑπ᾿",713184,0],["αὐτῶν",702165,40],["ὕβριν",713051,9],["καὶ",707031,7],["τὸν",709436,5],["τῆς",709436,16],["ἐμπεπαιγμένης",704583,422],["πόλεως",710612,17],["αἰκισμόν",700427,27],["ἔτι",705538,28],["δὲ",703303,11],["τὴν",709436,8],["τῆς",709436,16],["προγονικῆς",710776,82],["πολιτείας",710613,17],["κατάλυσιν",707321,9]],"and to set before their eyes the injury that they had unjustly done to the holy place, and the cruel handling of the city whereof they made a mockery, and also the taking away of the government of their forefathers:"],["18",[["οἱ",709436,136],["μὲν",708730,11],["γὰρ",702963,11],["ὅπλοις",709704,96],["πεποίθασιν",710221,353],["ἅμα",700745,28],["καὶ",707031,7],["τόλμαις",712884,76],["ἔφησεν",713437,2],["ἡμεῖς",705983,219],["δὲ",703303,11],["ἐπὶ",705080,0],["τῷ",709436,113],["παντοκράτορι",709986,114],["θεῷ",706192,114],["δυναμένῳ",703838,241],["καὶ",707031,7],["τοὺς",709436,58],["ἐρχομένους",705453,236],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["καὶ",707031,7],["τὸν",709436,5],["ὅλον",709597,27],["κόσμον",707851,6],["ἑνὶ",704106,97],["νεύματι",709272,54],["καταβαλεῖν",707203,296],["πεποίθαμεν",710221,314]],"For they, said he, trust in their weapons and boldness; but our confidence is in the Almighty God, who at a beck can cast down both them that come against us, and also all the world."],["19",[["προσαναλεξάμενος",710852,248],["δὲ",703303,11],["αὐτοῖς",702165,151],["καὶ",707031,7],["τὰς",709436,38],["ἐπὶ",705080,0],["τῶν",709436,80],["προγόνων",710777,81],["γενομένας",703104,503],["ἀντιλήμψεις",701247,39],["καὶ",707031,7],["τὴν",709436,8],["ἐπὶ",705080,0],["Σενναχηριμ",711693,6],["ἑκατὸν",704136,59],["ὀγδοήκοντα",709442,59],["πέντε",710266,59],["χιλιάδες",713858,191],["ὡς",714148,7],["ἀπώλοντο",701513,189]],"Moreover he recounted unto them what helps their forefathers had found, and how they were delivered, when under Sennacherib an hundred fourscore and five thousand perished."],["20",[["καὶ",707031,7],["τὴν",709436,8],["ἐν",704639,0],["τῇ",709436,100],["Βαβυλωνίᾳ",702353,1],["τὴν",709436,8],["πρὸς",710844,0],["τοὺς",709436,58],["Γαλάτας",702931,57],["παράταξιν",710107,9],["γενομένην",703104,639],["ὡς",714148,7],["οἱ",709436,136],["πάντες",710177,138],["ἐπὶ",705080,0],["τὴν",709436,8],["χρείαν",713938,9],["ἦλθον",705453,150],["ὀκτακισχίλιοι",709551,52],["σὺν",712372,0],["Μακεδόσιν",708402,148],["τετρακισχιλίοις",712816,230],["τῶν",709436,80],["Μακεδόνων",708402,81],["ἀπορουμένων",701559,299],["οἱ",709436,136],["ὀκτακισχίλιοι",709551,138],["τὰς",709436,38],["δώδεκα",703887,59],["μυριάδας",709062,39],["ἀπώλεσαν",701513,150],["διὰ",703417,0],["τὴν",709436,8],["γινομένην",703104,173],["αὐτοῖς",702165,151],["ἀπ᾿",701425,0],["οὐρανοῦ",709844,18],["βοήθειαν",702745,9],["καὶ",707031,7],["ὠφέλειαν",714170,9],["πολλὴν",710646,36],["ἔλαβον",708076,150]],"And he told them of the battle that they had in Babylon with the Galatians, how they came but eight thousand in all to the business, with four thousand Macedonians, and that the Macedonians being perplexed, the eight thousand destroyed an hundred and twenty thousand because of the help that they had from heaven, and so received a great booty."],["21",[["ἐφ᾿",705080,0],["οἷς",709781,311],["εὐθαρσεῖς",705590,60],["αὐτοὺς",702165,62],["παραστήσας",710152,182],["καὶ",707031,7],["ἑτοίμους",705541,60],["ὑπὲρ",713111,0],["τῶν",709436,80],["νόμων",709349,81],["καὶ",707031,7],["τῆς",709436,16],["πατρίδος",710196,17],["ἀποθνῄσκειν",701461,55],["τετραμερές",712819,68],["τι",712866,126],["τὸ",709436,24],["στράτευμα",712139,25],["ἐποίησεν",710582,2]],"Thus when he had made them bold with these words, and ready to die for the laws and the country, he divided his army into four parts;"],["22",[["τάξας",712730,182],["καὶ",707031,7],["τοὺς",709436,58],["ἀδελφοὺς",700249,57],["αὐτοῦ",702165,102],["προηγουμένους",710791,236],["ἑκατέρας",704134,82],["τάξεως",712712,17],["Σιμωνα",711792,6],["καὶ",707031,7],["Ιωσηπον",706947,6],["καὶ",707031,7],["Ιωναθην",706929,6],["ὑποτάξας",713250,182],["ἑκάστῳ",704133,30],["χιλίους",713859,60],["πρὸς",710844,0],["τοῖς",709436,147],["πεντακοσίοις",710261,230]],"and joined with himself his own brethren, leaders of each band, [to wit], Simon, and Joseph, and Jonathan, giving each one fifteen hundred men."],["23",[["ἔτι",705538,28],["δὲ",703303,11],["καὶ",707031,7],["Ελεαζαρον",704408,6],["παραναγνοὺς",710075,182],["τὴν",709436,8],["ἱερὰν",706633,36],["βίβλον",702721,9],["καὶ",707031,7],["δοὺς",703654,182],["σύνθημα",712478,25],["θεοῦ",706192,18],["βοηθείας",702745,17],["τῆς",709436,16],["πρώτης",711041,416],["σπείρας",712004,17],["αὐτὸς",702165,121],["προηγούμενος",710791,122],["συνέβαλε",712278,2],["τῷ",709436,113],["Νικάνορι",709308,114]],"Also [he appointed] Eleazar to read the holy book: and when he had given them this watchword, The help of God: himself leading the first band, he joined battle with Nicanor."],["24",[["γενομένου",703104,292],["δὲ",703303,11],["αὐτοῖς",702165,151],["τοῦ",709436,35],["παντοκράτορος",709986,18],["συμμάχου",712300,253],["κατέσφαξαν",707448,150],["τῶν",709436,80],["πολεμίων",710603,169],["ὑπὲρ",713111,0],["τοὺς",709436,58],["ἐνακισχιλίους",704648,60],["τραυματίας",712921,4],["δὲ",703303,11],["καὶ",707031,7],["τοῖς",709436,95],["μέλεσιν",708707,96],["ἀναπείρους",701032,60],["τὸ",709436,24],["πλεῖον",710514,46],["μέρος",708752,25],["τῆς",709436,16],["τοῦ",709436,35],["Νικάνορος",709308,18],["στρατιᾶς",712145,17],["ἐποίησαν",710582,150],["πάντας",710177,60],["δὲ",703303,11],["φυγεῖν",713433,106],["ἠνάγκασαν",700923,150]],"And by the help of the Almighty they slew above nine thousand of their enemies, and wounded and maimed the most part of Nicanor's host, and so put all to flight;"],["25",[["τὰ",709436,41],["δὲ",703303,11],["χρήματα",713948,42],["τῶν",709436,80],["παραγεγονότων",710006,387],["ἐπὶ",705080,0],["τὸν",709436,5],["ἀγορασμὸν",700186,6],["αὐτῶν",702165,40],["ἔλαβον",708076,150],["συνδιώξαντες",712418,196],["δὲ",703303,11],["αὐτοὺς",702165,62],["ἐφ᾿",705080,0],["ἱκανὸν",706710,27],["ἀνέλυσαν",700995,150],["ὑπὸ",713184,0],["τῆς",709436,16],["ὥρας",714128,17],["συγκλειόμενοι",712223,348]],"and took their money that came to buy them, and pursued them far: but lacking time they returned:"],["26",[["ἦν",704093,13],["γὰρ",702963,11],["ἡ",709436,10],["πρὸ",710747,0],["τοῦ",709436,20],["σαββάτου",711350,21],["δι᾿",703417,0],["ἣν",709781,131],["αἰτίαν",700492,9],["οὐκ",709805,28],["ἐμακροτόνησαν",708424,150],["κατατρέχοντες",707463,146],["αὐτούς",702165,62]],"for it was the day before the sabbath, and therefore they would no longer pursue them."],["27",[["ὁπλολογήσαντες",709702,196],["δὲ",703303,11],["αὐτοὺς",702165,62],["καὶ",707031,7],["τὰ",709436,41],["σκῦλα",711902,42],["ἐκδύσαντες",704180,196],["τῶν",709436,80],["πολεμίων",710603,169],["περὶ",710285,0],["τὸ",709436,24],["σάββατον",711350,25],["ἐγίνοντο",703104,139],["περισσῶς",710388,28],["εὐλογοῦντες",705631,146],["καὶ",707031,7],["ἐξομολογούμενοι",704960,348],["τῷ",709436,113],["κυρίῳ",707996,114],["τῷ",709436,113],["διασώσαντι",703599,350],["εἰς",704105,0],["τὴν",709436,8],["ἡμέραν",705984,9],["ταύτην",709858,104],["ἀρχὴν",701836,9],["ἐλέους",704426,21],["τάξαντος",712730,500],["αὐτοῖς",702165,151]],"So when they had gathered their armour together, and spoiled their enemies, they occupied themselves about the sabbath, yielding exceeding praise and thanks to the Lord, who had preserved them unto that day, which was the beginning of mercy distilling upon them."],["28",[["μετὰ",708780,0],["δὲ",703303,11],["τὸ",709436,24],["σάββατον",711350,25],["τοῖς",709436,147],["ᾐκισμένοις",700426,521],["καὶ",707031,7],["ταῖς",709436,75],["χήραις",713848,76],["καὶ",707031,7],["ὀρφανοῖς",709779,230],["μερίσαντες",708744,196],["ἀπὸ",701425,0],["τῶν",709436,43],["σκύλων",711902,44],["τὰ",709436,41],["λοιπὰ",708248,68],["αὐτοὶ",702165,201],["καὶ",707031,7],["τὰ",709436,41],["παιδία",709927,42],["διεμερίσαντο",703518,189]],"And after the sabbath, when they had given part of the spoils to the maimed, and the widows, and orphans, the residue they divided among themselves and their servants."],["29",[["ταῦτα",709858,71],["δὲ",703303,11],["διαπραξάμενοι",703553,317],["καὶ",707031,7],["κοινὴν",707772,36],["ἱκετείαν",706715,9],["ποιησάμενοι",710582,317],["τὸν",709436,5],["ἐλεήμονα",704422,27],["κύριον",707996,6],["ἠξίουν",701309,137],["εἰς",704105,0],["τέλος",712787,25],["καταλλαγῆναι",707315,106],["τοῖς",709436,147],["αὑτοῦ",703917,102],["δούλοις",703817,148]],"When this was done, and they had made a common supplication, they besought the merciful Lord to be reconciled with his servants for ever."],["30",[["καὶ",707031,7],["τοῖς",709436,147],["περὶ",710285,0],["Τιμόθεον",712860,6],["καὶ",707031,7],["Βακχίδην",702461,6],["συνερίσαντες",712457,196],["ὑπὲρ",713111,0],["τοὺς",709436,58],["δισμυρίους",703743,60],["αὐτῶν",702165,40],["ἀνεῖλον",700962,150],["καὶ",707031,7],["ὀχυρωμάτων",709891,44],["ὑψηλῶν",713285,83],["εὖ",705544,28],["μάλα",708433,28],["ἐγκρατεῖς",703990,60],["ἐγένοντο",703104,189],["καὶ",707031,7],["λάφυρα",708112,42],["πλείονα",710514,68],["ἐμερίσαντο",708744,189],["ἰσομοίρους",706827,60],["αὑτοῖς",703917,151],["καὶ",707031,7],["τοῖς",709436,147],["ᾐκισμένοις",700426,521],["καὶ",707031,7],["ὀρφανοῖς",709779,230],["καὶ",707031,7],["χήραις",713848,76],["ἔτι",705538,28],["δὲ",703303,11],["καὶ",707031,7],["πρεσβυτέροις",710735,148],["ποιήσαντες",710582,196]],"Moreover of those that were with Timotheus and Bacchides, who fought against them, they slew above twenty thousand, and very easily got high and strong holds, and divided among themselves many spoils more, and made the maimed, orphans, widows, yea, and the aged also, equal in spoils with themselves."],["31",[["ὁπλολογήσαντες",709702,196],["δὲ",703303,11],["αὑτοὺς",703917,62],["ἐπιμελῶς",705200,28],["πάντα",710177,68],["συνέθηκαν",712513,150],["εἰς",704105,0],["τοὺς",709436,58],["ἐπικαίρους",705152,60],["τόπους",712903,57],["τὰ",709436,41],["δὲ",703303,11],["λοιπὰ",708248,68],["τῶν",709436,43],["σκύλων",711902,44],["ἤνεγκαν",713428,150],["εἰς",704105,0],["Ιεροσόλυμα",706634,6]],"And when they had gathered their armour together, they laid them up all carefully in convenient places, and the remnant of the spoils they brought to Jerusalem."],["32",[["τὸν",709436,5],["δὲ",703303,11],["φυλάρχην",713617,6],["τῶν",709436,80],["περὶ",710285,0],["Τιμόθεον",712860,6],["ἀνεῖλον",700962,150],["ἀνοσιώτατον",701199,534],["ἄνδρα",701150,6],["καὶ",707031,7],["πολλὰ",710646,68],["τοὺς",709436,58],["Ιουδαίους",706772,57],["ἐπιλελυπηκότα",705195,518]],"They slew also Philarches, that wicked person, who was with Timotheus, and had annoyed the Jews many ways."],["33",[["ἐπινίκια",705213,68],["δὲ",703303,11],["ἄγοντες",700209,146],["ἐν",704639,0],["τῇ",709436,100],["πατρίδι",710196,1],["τοὺς",709436,58],["ἐμπρήσαντας",704617,454],["τοὺς",709436,58],["ἱεροὺς",706633,60],["πυλῶνας",711083,57],["καὶ",707031,7],["Καλλισθένην",707091,6],["ὑφῆψαν",713279,150],["εἰς",704105,0],["ἓν",704106,46],["οἰκίδιον",709506,25],["πεφευγότα",713433,518],["καὶ",707031,7],["τὸν",709436,5],["ἄξιον",701308,27],["τῆς",709436,16],["δυσσεβείας",703870,17],["ἐκομίσατο",707805,23],["μισθόν",708939,6]],"Furthermore at such time as they kept the feast for the victory in their country they burnt Callisthenes, [and some others] that had set fire upon the holy gates, who had fled into a little house; and they received a reward meet for their wickedness."],["34",[["ὁ",709436,3],["δὲ",703303,11],["τρισαλιτήριος",712955,14],["Νικάνωρ",709308,4],["ὁ",709436,3],["τοὺς",709436,58],["χιλίους",713859,60],["ἐμπόρους",704614,57],["ἐπὶ",705080,0],["τὴν",709436,8],["πρᾶσιν",710719,9],["τῶν",709436,80],["Ιουδαίων",706772,81],["ἀγαγὼν",700209,182]],"As for that most ungracious Nicanor, who had brought a thousand merchants to buy the Jews,"],["35",[["ταπεινωθεὶς",712717,217],["ὑπὸ",713184,0],["τῶν",709436,80],["κατ᾿",707200,0],["αὐτὸν",702165,85],["νομιζομένων",709338,299],["ἐλαχίστων",704400,616],["εἶναι",704093,55],["τῇ",709436,100],["τοῦ",709436,35],["κυρίου",707996,18],["βοηθείᾳ",702745,1],["τὴν",709436,8],["δοξικὴν",703795,36],["ἀποθέμενος",701613,248],["ἐσθῆτα",705492,9],["διὰ",703417,0],["τῆς",709436,16],["μεσογείου",708762,82],["δραπέτου",703825,18],["τρόπον",712980,6],["ἔρημον",705420,9],["ἑαυτὸν",703917,85],["ποιήσας",710582,182],["ἧκεν",706696,2],["εἰς",704105,0],["Ἀντιόχειαν",701252,9],["ὑπὲρ",713111,0],["ἅπαν",701362,68],["εὐημερηκὼς",705584,270],["ἐπὶ",705080,0],["τῇ",709436,100],["τοῦ",709436,35],["στρατοῦ",712152,18],["διαφθορᾷ",703625,1]],"he was through the help of the Lord brought down by them, of whom he made least account; and putting off his glorious apparel, and discharging his company, he came like a fugitive servant through the midland unto Antioch, having very great dishonour, for that his host was destroyed."],["36",[["καὶ",707031,7],["ὁ",709436,3],["τοῖς",709436,147],["Ῥωμαίοις",711318,148],["ἀναδεξάμενος",700938,248],["φόρον",713561,6],["ἀπὸ",701425,0],["τῆς",709436,16],["τῶν",709436,80],["ἐν",704639,0],["Ιεροσολύμοις",706634,148],["αἰχμαλωσίας",700499,17],["κατορθώσασθαι",707548,109],["κατήγγελλεν",707220,13],["ὑπέρμαχον",713149,6],["ἔχειν",705785,55],["τοὺς",709436,58],["Ιουδαίους",706772,57],["καὶ",707031,7],["διὰ",703417,0],["τὸν",709436,5],["τρόπον",712980,6],["τοῦτον",709858,85],["ἀτρώτους",702108,27],["εἶναι",704093,55],["τοὺς",709436,58],["Ιουδαίους",706772,57],["διὰ",703417,0],["τὸ",709436,24],["ἀκολουθεῖν",700566,55],["τοῖς",709436,147],["ὑπ᾿",713184,0],["αὐτοῦ",702165,102],["προτεταγμένοις",710987,521],["νόμοις",709349,148]],"Thus he, that took upon him to make good to the Romans their tribute by means of the captives in Jerusalem, told abroad, that the Jews had God to fight for them, and therefore they could not be hurt, because they followed the laws that he gave them."]]