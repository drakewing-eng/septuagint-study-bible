[["1",[["μετ᾿",708780,0],["ὀλίγον",709568,27],["δὲ",703303,11],["παντελῶς",709978,28],["χρονίσκον",713968,6],["Λυσίας",708275,4],["ἐπίτροπος",705314,4],["τοῦ",709436,35],["βασιλέως",702580,18],["καὶ",707031,7],["συγγενὴς",712185,14],["καὶ",707031,7],["ἐπὶ",705080,0],["τῶν",709436,43],["πραγμάτων",710708,44],["λίαν",708184,28],["βαρέως",702534,28],["φέρων",713428,72],["ἐπὶ",705080,0],["τοῖς",709436,147],["γεγονόσι",703104,536]],"Not long after this, Lysias the king's protector and cousin, who also managed the affairs, took sore displeasure for the things that were done."],["2",[["συναθροίσας",712378,182],["περὶ",710285,0],["τὰς",709436,38],["ὀκτὼ",709555,59],["μυριάδας",709062,39],["καὶ",707031,7],["τὴν",709436,8],["ἵππον",706790,6],["ἅπασαν",701362,36],["παρεγίνετο",710006,19],["ἐπὶ",705080,0],["τοὺς",709436,58],["Ιουδαίους",706772,57],["λογιζόμενος",708232,122],["τὴν",709436,8],["μὲν",708730,11],["πόλιν",710612,9],["Ἕλλησιν",704515,148],["οἰκητήριον",709502,25],["ποιήσειν",710582,296]],"And when he had gathered about fourscore thousand with all the horsemen, he came against the Jews, thinking to make the city an habitation of the Gentiles,"],["3",[["τὸ",709436,24],["δὲ",703303,11],["ἱερὸν",706631,25],["ἀργυρολόγητον",701710,6],["καθὼς",707030,28],["τὰ",709436,41],["λοιπὰ",708248,68],["τῶν",709436,43],["ἐθνῶν",704068,44],["τεμένη",712790,42],["πρατὴν",710722,36],["δὲ",703303,11],["κατὰ",707200,0],["ἔτος",705543,25],["τὴν",709436,8],["ἀρχιερωσύνην",701846,9],["ποιήσειν",710582,296]],"and to make a gain of the temple, as of the other chapels of the heathen, and to set the high priesthood to sale every year:"],["4",[["οὐδαμῶς",709814,28],["ἐπιλογιζόμενος",705193,122],["τὸ",709436,24],["τοῦ",709436,35],["θεοῦ",706192,18],["κράτος",707883,25],["πεφρενωμένος",713577,122],["δὲ",703303,11],["ταῖς",709436,75],["μυριάσιν",709062,76],["τῶν",709436,80],["πεζῶν",710219,169],["καὶ",707031,7],["ταῖς",709436,75],["χιλιάσιν",713858,76],["τῶν",709436,80],["ἱππέων",706786,81],["καὶ",707031,7],["τοῖς",709436,147],["ἐλέφασιν",704438,148],["τοῖς",709436,147],["ὀγδοήκοντα",709442,59]],"not at all considering the power of God, but puffed up with his ten thousands of footmen, and his thousands of horsemen, and his fourscore elephants."],["5",[["εἰσελθὼν",704114,182],["δὲ",703303,11],["εἰς",704105,0],["τὴν",709436,8],["Ιουδαίαν",706769,9],["καὶ",707031,7],["συνεγγίσας",712423,182],["Βαιθσουρα",702436,227],["ὄντι",704093,379],["μὲν",708730,11],["ἐρυμνῷ",705448,97],["χωρίῳ",714015,54],["Ιεροσολύμων",706634,18],["δὲ",703303,11],["ἀπέχοντι",701225,379],["ὡσεὶ",714159,11],["σταδίους",712037,57],["πέντε",710266,59],["τοῦτο",709858,129],["ἔθλιβεν",706274,13]],"So he came to Judea, and drew near to Bethsura, which was a strong town, but distant from Jerusalem about five furlongs, and he laid sore siege unto it."],["6",[["ὡς",714148,7],["δὲ",703303,11],["μετέλαβον",708800,150],["οἱ",709436,136],["περὶ",710285,0],["τὸν",709436,5],["Μακκαβαῖον",708410,6],["πολιορκοῦντα",710608,183],["αὐτὸν",702165,85],["τὰ",709436,41],["ὀχυρώματα",709891,42],["μετὰ",708780,0],["ὀδυρμῶν",709465,81],["καὶ",707031,7],["δακρύων",703255,44],["ἱκέτευον",706716,47],["σὺν",712372,0],["τοῖς",709436,147],["ὄχλοις",709884,148],["τὸν",709436,5],["κύριον",707996,6],["ἀγαθὸν",700106,27],["ἄγγελον",700140,6],["ἀποστεῖλαι",701592,106],["πρὸς",710844,0],["σωτηρίαν",712658,9],["τῷ",709436,113],["Ισραηλ",706839,114]],"Now when they that were with Maccabeus heard that he besieged the holds, they and all the people with lamentation and tears besought the Lord that he would send a good angel to deliver Israel."],["7",[["αὐτὸς",702165,121],["δὲ",703303,11],["πρῶτος",711041,140],["ὁ",709436,3],["Μακκαβαῖος",708410,4],["ἀναλαβὼν",700984,182],["τὰ",709436,41],["ὅπλα",709704,42],["προετρέψατο",710996,23],["τοὺς",709436,58],["ἄλλους",700697,62],["ἅμα",700745,28],["αὐτῷ",702165,50],["διακινδυνεύοντας",703471,235],["ἐπιβοηθεῖν",705091,55],["τοῖς",709436,147],["ἀδελφοῖς",700249,148],["αὐτῶν",702165,40],["ὁμοῦ",709644,28],["δὲ",703303,11],["καὶ",707031,7],["προθύμως",710800,28],["ἐξώρμησαν",704966,150]],"Then Maccabeus himself first of all took weapons, exhorting the other that they would jeopard themselves together with him to help their brethren: so they went forth together with a willing mind."],["8",[["αὐτόθι",702161,28],["δὲ",703303,11],["πρὸς",710844,0],["τοῖς",709436,147],["Ιεροσολύμοις",706634,148],["ὄντων",704093,170],["ἐφάνη",713311,37],["προηγούμενος",710791,122],["αὐτῶν",702165,40],["ἔφιππος",705755,14],["ἐν",704639,0],["λευκῇ",708165,101],["ἐσθῆτι",705492,1],["πανοπλίαν",709968,9],["χρυσῆν",713971,36],["κραδαίνων",707867,72]],"And as they were at Jerusalem, there appeared before them on horseback one in white clothing, shaking his armour of gold."],["9",[["ὁμοῦ",709644,28],["δὲ",703303,11],["πάντες",710177,138],["εὐλόγησαν",705631,511],["τὸν",709436,5],["ἐλεήμονα",704422,27],["θεὸν",706192,6],["καὶ",707031,7],["ἐπερρώσθησαν",705240,99],["ταῖς",709436,75],["ψυχαῖς",714070,76],["οὐ",709805,28],["μόνον",709001,28],["ἀνθρώπους",701163,57],["θῆρας",706244,39],["δὲ",703303,11],["τοὺς",709436,58],["ἀγριωτάτους",700191,612],["καὶ",707031,7],["σιδηρᾶ",711771,68],["τείχη",712759,42],["τιτρώσκειν",712871,55],["ὄντες",704093,146],["ἕτοιμοι",705541,138]],"Then they praised the merciful God all together, and took heart, insomuch that they were ready not only to fight with men, but with most cruel beasts, and to pierce through walls of iron."],["10",[["προῆγον",710748,137],["ἐν",704639,0],["διασκευῇ",703577,1],["τὸν",709436,5],["ἀπ᾿",701425,0],["οὐρανοῦ",709844,18],["σύμμαχον",712301,6],["ἔχοντες",705785,146],["ἐλεήσαντος",704418,500],["αὐτοὺς",702165,62],["τοῦ",709436,35],["κυρίου",707996,18]],"Thus they marched forward in their armour, having an helper from heaven: for the Lord was merciful unto them."],["11",[["λεοντηδὸν",708145,28],["δὲ",703303,11],["ἐντινάξαντες",704801,196],["εἰς",704105,0],["τοὺς",709436,58],["πολεμίους",710603,60],["κατέστρωσαν",707446,150],["αὐτῶν",702165,40],["χιλίους",713859,60],["πρὸς",710844,0],["τοῖς",709436,147],["μυρίοις",709063,230],["ἱππεῖς",706786,52],["δὲ",703303,11],["ἑξακοσίους",704847,60],["πρὸς",710844,0],["τοῖς",709436,147],["χιλίοις",713859,230],["τοὺς",709436,58],["δὲ",703303,11],["πάντας",710177,60],["ἠνάγκασαν",700923,150],["φεύγειν",713433,55]],"And giving a charge upon their enemies like lions, they slew eleven thousand [footmen], and sixteen hundred horsemen, and put all the other to flight."],["12",[["οἱ",709436,136],["πλείονες",710514,138],["δὲ",703303,11],["αὐτῶν",702165,40],["τραυματίαι",712921,52],["γυμνοὶ",703202,138],["διεσώθησαν",703599,99],["καὶ",707031,7],["αὐτὸς",702165,121],["δὲ",703303,11],["ὁ",709436,3],["Λυσίας",708275,4],["αἰσχρῶς",700482,28],["φεύγων",713433,72],["διεσώθη",703599,37]],"Many of them also being wounded escaped naked; and Lysias himself fled away shamefully, and so escaped."],["13",[["οὐκ",709805,28],["ἄνους",701203,14],["δὲ",703303,11],["ὑπάρχων",713104,72],["πρὸς",710844,0],["ἑαυτὸν",703917,85],["ἀντιβάλλων",701228,72],["τὸ",709436,24],["γεγονὸς",703104,427],["περὶ",710285,0],["αὐτὸν",702165,85],["ἐλάττωμα",704395,25],["καὶ",707031,7],["συννοήσας",712486,182],["ἀνικήτους",701170,60],["εἶναι",704093,55],["τοὺς",709436,58],["Εβραίους",703933,57],["τοῦ",709436,35],["δυναμένου",703838,262],["θεοῦ",706192,18],["συμμαχοῦντος",712298,152],["αὐτοῖς",702165,151]],"Who, as he was a man of understanding, casting with himself what loss he had had, and considering that the Hebrews could not be overcome, because the Almighty God helped them, he sent unto them,"],["14",[["προσαποστείλας",710861,182],["ἔπεισεν",710221,2],["συλλύεσθαι",712273,110],["ἐπὶ",705080,0],["πᾶσι",710177,230],["τοῖς",709436,147],["δικαίοις",703694,230],["καὶ",707031,7],["διότι",703734,7],["καὶ",707031,7],["τὸν",709436,5],["βασιλέα",702580,6],["πείσει",710221,127],["φίλον",713492,27],["αὐτοῖς",702165,151],["ἀναγκάζων",700923,72],["γενέσθαι",703104,109]],"and persuaded them to agree to all reasonable [conditions], and [promised] that he would persuade the king that he must needs be a friend unto them."],["15",[["ἐπένευσεν",705211,2],["δὲ",703303,11],["ὁ",709436,3],["Μακκαβαῖος",708410,4],["ἐπὶ",705080,0],["πᾶσιν",710177,94],["οἷς",709781,295],["ὁ",709436,3],["Λυσίας",708275,4],["παρεκάλει",710039,13],["τοῦ",709436,35],["συμφέροντος",712353,152],["φροντίζων",713590,72],["ὅσα",709788,68],["γὰρ",702963,11],["ὁ",709436,3],["Μακκαβαῖος",708410,4],["ἐπέδωκεν",705121,2],["τῷ",709436,113],["Λυσίᾳ",708275,114],["διὰ",703417,0],["γραπτῶν",703189,44],["περὶ",710285,0],["τῶν",709436,80],["Ιουδαίων",706772,81],["συνεχώρησεν",712246,2],["ὁ",709436,3],["βασιλεύς",702580,4]],"Then Maccabeus consented to all that Lysias desired, being careful of the common good; and whatsoever Maccabeus wrote unto Lysias concerning the Jews, the king granted it."],["16",[["ἦσαν",704093,137],["γὰρ",702963,11],["αἱ",709436,190],["γεγραμμέναι",703194,423],["τοῖς",709436,147],["Ιουδαίοις",706772,148],["ἐπιστολαὶ",705272,39],["παρὰ",709995,0],["μὲν",708730,11],["Λυσίου",708275,18],["περιέχουσαι",710315,306],["τὸν",709436,5],["τρόπον",712980,6],["τοῦτον",709858,85],["Λυσίας",708275,4],["τῷ",709436,53],["πλήθει",710529,54],["τῶν",709436,80],["Ιουδαίων",706772,81],["χαίρειν",713665,55]],"For there were letters written unto the Jews from Lysias to this effect: Lysias unto the people of the Jews [sendeth] greeting:"],["17",[["Ιωαννης",706892,4],["καὶ",707031,7],["Αβεσσαλωμ",700052,4],["οἱ",709436,136],["πεμφθέντες",710246,247],["παρ᾿",709995,0],["ὑμῶν",713091,145],["ἐπιδόντες",705121,196],["τὸν",709436,5],["ὑπογεγραμμένον",713189,439],["χρηματισμὸν",713950,6],["ἠξίουν",701309,137],["περὶ",710285,0],["τῶν",709436,80],["δι᾿",703417,0],["αὐτοῦ",702165,102],["σημαινομένων",711745,299]],"John and Absalon, who were sent from you, delivered me the petition subscribed, and made request for the performance of the contents thereof."],["18",[["ὅσα",709788,68],["μὲν",708730,11],["οὖν",709835,11],["ἔδει",705495,127],["καὶ",707031,7],["τῷ",709436,113],["βασιλεῖ",702580,114],["προσενεχθῆναι",710974,179],["διεσάφησα",703572,155],["ἃ",709781,69],["δὲ",703303,11],["ἦν",704093,13],["ἐνδεχόμενα",704683,67],["συνεχώρησεν",712246,2]],"Therefore what things soever were meet to be reported to the king, I have declared them, and he hath granted as much as might be."],["19",[["ἐὰν",703912,7],["μὲν",708730,11],["οὖν",709835,11],["συντηρήσητε",712512,125],["τὴν",709436,8],["εἰς",704105,0],["τὰ",709436,41],["πράγματα",710708,42],["εὔνοιαν",705648,9],["καὶ",707031,7],["εἰς",704105,0],["τὸ",709436,24],["λοιπὸν",708247,46],["πειράσομαι",710230,181],["παραίτιος",710034,14],["ἀγαθῶν",700106,169],["γενέσθαι",703104,109]],"If then ye will keep yourselves loyal to the state, hereafter also will I endeavour to be a means of your good."],["20",[["ὑπὲρ",713111,0],["δὲ",703303,11],["τούτων",709858,70],["καὶ",707031,7],["τῶν",709436,43],["κατὰ",707200,0],["μέρος",708752,25],["ἐντέταλμαι",704791,326],["τούτοις",709858,206],["τε",712751,11],["καὶ",707031,7],["τοῖς",709436,147],["παρ᾿",709995,0],["ἐμοῦ",704580,133],["διαλεχθῆναι",703495,179],["ὑμῖν",713084,90]],"But of the particulars I have given order both to these, and the other that came from me, to commune with you."],["21",[["ἔρρωσθε",711323,680],["ἔτους",705543,21],["ἑκατοστοῦ",704143,92],["τεσσαρακοστοῦ",712807,92],["ὀγδόου",709444,92],["Διὸς",705866,18],["Κορινθίου",707837,18],["τετράδι",712824,1],["καὶ",707031,7],["εἰκάδι",704082,1]],"Fare ye well. The hundred and eight and fortieth year, the four and twentieth day of [the month] Dioscorinthius."],["22",[["ἡ",709436,10],["δὲ",703303,11],["τοῦ",709436,35],["βασιλέως",702580,18],["ἐπιστολὴ",705272,12],["περιεῖχεν",710315,13],["οὕτως",709859,28],["βασιλεὺς",702580,4],["Ἀντίοχος",701257,4],["τῷ",709436,113],["ἀδελφῷ",700249,114],["Λυσίᾳ",708275,114],["χαίρειν",713665,55]],"Now the king's letter contained these words: King Antiochus unto his brother Lysias [sendeth] greeting:"],["23",[["τοῦ",709436,35],["πατρὸς",710189,18],["ἡμῶν",705999,145],["εἰς",704105,0],["θεοὺς",706192,57],["μεταστάντος",708668,500],["βουλόμενοι",702795,348],["τοὺς",709436,58],["ἐκ",704132,0],["τῆς",709436,16],["βασιλείας",702577,17],["ἀταράχους",702074,60],["ὄντας",704093,235],["γενέσθαι",703104,109],["πρὸς",710844,0],["τὴν",709436,8],["τῶν",709436,80],["ἰδίων",706493,169],["ἐπιμέλειαν",705198,9]],"since our father is translated unto the gods, our will is, that they that are in our realm live quietly, that every one may attend upon his own affairs."],["24",[["ἀκηκοότες",700587,268],["τοὺς",709436,58],["Ιουδαίους",706772,57],["μὴ",708851,28],["συνευδοκοῦντας",712466,235],["τῇ",709436,100],["τοῦ",709436,35],["πατρὸς",710189,18],["ἐπὶ",705080,0],["τὰ",709436,41],["Ἑλληνικὰ",704517,68],["μεταθέσει",708793,9],["ἀλλὰ",700680,7],["τὴν",709436,8],["ἑαυτῶν",703917,40],["ἀγωγὴν",700210,9],["αἱρετίζοντας",700469,338],["ἀξιοῦντας",701309,338],["συγχωρηθῆναι",712246,179],["αὐτοῖς",702165,151],["τὰ",709436,41],["νόμιμα",709340,68]],"We understand also that the Jews would not consent to our father, for to be brought unto the customs of the Gentiles, but had rather keep their own manner of living: for the which cause they require of us, that we should suffer them to live after their own laws."],["25",[["αἱρούμενοι",700472,348],["οὖν",709835,11],["καὶ",707031,7],["τοῦτο",709858,129],["τὸ",709436,24],["ἔθνος",704068,25],["ἐκτὸς",704339,0],["ταραχῆς",712722,17],["εἶναι",704093,55],["κρίνομεν",707905,243],["τό",709436,24],["τε",712751,11],["ἱερὸν",706631,25],["ἀποκατασταθῆναι",701470,179],["αὐτοῖς",702165,151],["καὶ",707031,7],["πολιτεύεσθαι",710615,110],["κατὰ",707200,0],["τὰ",709436,41],["ἐπὶ",705080,0],["τῶν",709436,80],["προγόνων",710777,81],["αὐτῶν",702165,40],["ἔθη",704069,42]],"Wherefore our mind is, that this nation shall be in rest, and we have determined to restore them their temple, that they may live according to the customs of their forefathers."],["26",[["εὖ",705544,28],["οὖν",709835,11],["ποιήσεις",710582,166],["διαπεμψάμενος",703542,248],["πρὸς",710844,0],["αὐτοὺς",702165,62],["καὶ",707031,7],["δοὺς",703654,182],["δεξιάς",703360,119],["ὅπως",709719,7],["εἰδότες",709492,196],["τὴν",709436,8],["ἡμετέραν",705987,36],["προαίρεσιν",710751,9],["εὔθυμοί",705599,138],["τε",712751,11],["ὦσιν",709852,96],["καὶ",707031,7],["ἡδέως",705938,28],["διαγίνωνται",703434,380],["πρὸς",710844,0],["τῇ",709436,100],["τῶν",709436,80],["ἰδίων",706493,169],["ἀντιλήμψει",701247,1]],"Thou shalt do well therefore to send unto them, and grant them peace, that when they are certified of our mind, they may be of good comfort, and ever go cheerfully about their own affairs."],["27",[["πρὸς",710844,0],["δὲ",703303,11],["τὸ",709436,24],["ἔθνος",704068,25],["ἡ",709436,10],["τοῦ",709436,35],["βασιλέως",702580,18],["ἐπιστολὴ",705272,12],["τοιάδε",712877,71],["ἦν",704093,13],["βασιλεὺς",702580,4],["Ἀντίοχος",701257,4],["τῇ",709436,100],["γερουσίᾳ",703063,1],["τῶν",709436,80],["Ιουδαίων",706772,81],["καὶ",707031,7],["τοῖς",709436,147],["ἄλλοις",700697,151],["Ιουδαίοις",706772,148],["χαίρειν",713665,55]],"And the letter of the king unto the nation of the Jews was after this manner: King Antiochus [sendeth] greeting unto the council, and the rest of the Jews;"],["28",[["εἰ",704071,7],["ἔρρωσθε",711323,680],["εἴη",704093,301],["ἂν",700900,11],["ὡς",714148,7],["βουλόμεθα",702795,378],["καὶ",707031,7],["αὐτοὶ",702165,201],["δὲ",703303,11],["ὑγιαίνομεν",713057,243]],"If ye fare well, we have our desire; we are also in good health."],["29",[["ἐνεφάνισεν",704628,2],["ἡμῖν",705994,90],["Μενέλαος",708731,4],["βούλεσθαι",702795,110],["κατελθόντας",707518,454],["ὑμᾶς",713080,194],["γίνεσθαι",703104,110],["πρὸς",710844,0],["τοῖς",709436,95],["ἰδίοις",706493,94]],"Menelaus declared unto us, that your desire was to return home, and to follow your own business:"],["30",[["τοῖς",709436,95],["οὖν",709835,11],["καταπορευομένοις",707387,341],["μέχρι",708849,0],["τριακάδος",712933,17],["Ξανθικοῦ",709406,118],["ὑπάρξει",713104,127],["δεξιὰ",703360,68],["μετὰ",708780,0],["τῆς",709436,16],["ἀδείας",700242,17]],"wherefore they that will depart shall have safe conduct till the thirtieth day of Xanthicus with security."],["31",[["χρῆσθαι",713936,110],["τοὺς",709436,58],["Ιουδαίους",706772,57],["τοῖς",709436,95],["ἑαυτῶν",703917,40],["δαπανήμασιν",703288,96],["καὶ",707031,7],["νόμοις",709349,148],["καθὰ",706979,28],["καὶ",707031,7],["τὸ",709436,24],["πρότερον",710991,46],["καὶ",707031,7],["οὐδεὶς",709817,14],["αὐτῶν",702165,40],["κατ᾿",707200,0],["οὐδένα",709817,27],["τρόπον",712980,6],["παρενοχληθήσεται",710135,134],["περὶ",710285,0],["τῶν",709436,80],["ἠγνοημένων",700175,682]],"And the Jews shall use their own kind of meats and laws, as before: and none of them any manner of ways shall be molested for things ignorantly done."],["32",[["πέπομφα",710246,89],["δὲ",703303,11],["καὶ",707031,7],["τὸν",709436,5],["Μενέλαον",708731,6],["παρακαλέσοντα",710039,676],["ὑμᾶς",713080,194]],"I have sent also Menelaus, that he may comfort you."],["33",[["ἔρρωσθε",711323,680],["ἔτους",705543,21],["ἑκατοστοῦ",704143,92],["τεσσαρακοστοῦ",712807,92],["ὀγδόου",709444,92],["Ξανθικοῦ",709406,118],["πεντεκαιδεκάτῃ",710268,101]],"Fare ye well. In the hundred forty and eighth year, [and] the fifteenth [day] of [the month] Xanthicus."],["34",[["ἔπεμψαν",710246,150],["δὲ",703303,11],["καὶ",707031,7],["οἱ",709436,136],["Ῥωμαῖοι",711318,52],["πρὸς",710844,0],["αὐτοὺς",702165,62],["ἐπιστολὴν",705272,9],["ἔχουσαν",705785,78],["οὕτως",709859,28],["Κόιντος",707774,4],["Μέμμιος",708725,4],["Τίτος",712869,4],["Μάνιος",708484,4],["πρεσβῦται",710736,52],["Ῥωμαίων",711318,81],["τῷ",709436,113],["δήμῳ",703411,114],["τῶν",709436,80],["Ιουδαίων",706772,81],["χαίρειν",713665,55]],"The Romans also sent unto them a letter containing these words: Quintus Memmius and Titus Manlius, ambassadors of the Romans, [send] greeting unto the people of the Jews."],["35",[["ὑπὲρ",713111,0],["ὧν",709781,252],["Λυσίας",708275,4],["ὁ",709436,3],["συγγενὴς",712185,14],["τοῦ",709436,35],["βασιλέως",702580,18],["συνεχώρησεν",712246,2],["ὑμῖν",713084,90],["καὶ",707031,7],["ἡμεῖς",705983,219],["συνευδοκοῦμεν",712466,243]],"Whatsoever Lysias the king's cousin hath granted, therewith we also are well pleased."],["36",[["ἃ",709781,69],["δὲ",703303,11],["ἔκρινεν",707905,2],["προσανενεχθῆναι",710856,179],["τῷ",709436,113],["βασιλεῖ",702580,114],["πέμψατέ",710246,74],["τινα",712866,126],["παραχρῆμα",710119,25],["ἐπισκεψάμενοι",705250,317],["περὶ",710285,0],["τούτων",709858,40],["ἵνα",706747,7],["ἐκθῶμεν",704197,233],["ὡς",714148,7],["καθήκει",706998,91],["ὑμῖν",713084,90],["ἡμεῖς",705983,219],["γὰρ",702963,11],["προσάγομεν",710848,243],["πρὸς",710844,0],["Ἀντιόχειαν",701252,9]],"But touching such things as he judged to be referred to the king, after ye have advised thereof, send one forthwith, that we may declare as it is convenient for you: for we are now going to Antioch."],["37",[["διὸ",703714,7],["σπεύσατε",712011,74],["καὶ",707031,7],["πέμψατέ",710246,74],["τινας",712866,668],["ὅπως",709719,7],["καὶ",707031,7],["ἡμεῖς",705983,219],["ἐπιγνῶμεν",705104,233],["ὁποίας",709707,82],["ἐστὲ",704093,87],["γνώμης",703134,17]],"Therefore send some with speed, that we may know what is your mind."],["38",[["ὑγιαίνετε",713057,335],["ἔτους",705543,21],["ἑκατοστοῦ",704143,92],["τεσσαρακοστοῦ",712807,92],["ὀγδόου",709444,92],["Ξανθικοῦ",709406,118],["πεντεκαιδεκάτῃ",710268,101]],"Farewell. This hundred and eight and fortieth year, the fifteenth day of [the month] Xanthicus."]]