[["1",[["καὶ",707031,7],["Τωβιτ",713044,4],["ἔγραψεν",703194,2],["προσευχὴν",710892,9],["εἰς",704105,0],["ἀγαλλίασιν",700113,9],["καὶ",707031,7],["εἶπεν",705373,2]],"Then Tobit wrote a prayer of rejoicing, and said, Blessed be God that liveth for ever, and blessed be his kingdom."],["2",[["εὐλογητὸς",705632,14],["ὁ",709436,3],["θεὸς",706192,4],["ὁ",709436,3],["ζῶν",705851,72],["εἰς",704105,0],["τοὺς",709436,58],["αἰῶνας",700504,57],["καὶ",707031,7],["ἡ",709436,10],["βασιλεία",702577,12],["αὐτοῦ",702165,102],["ὅτι",709803,7],["αὐτὸς",702165,121],["μαστιγοῖ",708566,91],["καὶ",707031,7],["ἐλεᾷ",704412,91],["κατάγει",707232,91],["εἰς",704105,0],["ᾅδην",700255,6],["καὶ",707031,7],["ἀνάγει",700933,91],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ὃς",709781,213],["ἐκφεύξεται",704357,93],["τὴν",709436,8],["χεῖρα",713787,9],["αὐτοῦ",702165,102]],"For he doth scourge, and hath mercy: he leadeth down to hell, and bringeth up again: neither is there any that can avoid his hand."],["3",[["ἐξομολογεῖσθε",704960,73],["αὐτῷ",702165,50],["οἱ",709436,136],["υἱοὶ",713075,52],["Ισραηλ",706839,18],["ἐνώπιον",704823,0],["τῶν",709436,43],["ἐθνῶν",704068,44],["ὅτι",709803,7],["αὐτὸς",702165,121],["διέσπειρεν",703584,2],["ἡμᾶς",705981,194],["ἐν",704639,0],["αὐτοῖς",702165,151]],"Confess him before the Gentiles, ye children of Israel: for he hath scattered us among them."],["4",[["ἐκεῖ",704181,28],["ὑποδείξατε",713192,74],["τὴν",709436,8],["μεγαλωσύνην",708652,9],["αὐτοῦ",702165,102],["ὑψοῦτε",713289,335],["αὐτὸν",702165,85],["ἐνώπιον",704823,0],["παντὸς",710177,92],["ζῶντος",705851,294],["καθότι",707021,7],["αὐτὸς",702165,121],["κύριος",707996,4],["ἡμῶν",705999,145],["καὶ",707031,7],["θεός",706192,4],["αὐτὸς",702165,121],["πατὴρ",710189,4],["ἡμῶν",705999,145],["εἰς",704105,0],["πάντας",710177,60],["τοὺς",709436,58],["αἰῶνας",700504,57]],"There declare his greatness, and extol him before all the living: for he is our Lord, and he is the God our Father for ever."],["5",[["καὶ",707