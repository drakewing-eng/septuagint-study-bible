[["1",[["καὶ",707031,7],["ἐκάλεσεν",707084,2],["Τωβιας",713037,4],["τὸν",709436,5],["Ραφαηλ",711194,6],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50]],"Then Tobias called Raphael, and said unto him,"],["2",[["Αζαρια",700328,153],["ἄδελφε",700249,153],["λαβὲ",708076,176],["μετὰ",708780,0],["σεαυτοῦ",711599,102],["παῖδα",709932,6],["καὶ",707031,7],["δύο",703849,543],["καμήλους",707110,57],["καὶ",707031,7],["πορεύθητι",710667,244],["ἐν",704639,0],["Ῥάγοις",711143,111],["τῆς",709436,16],["Μηδίας",708856,17],["παρὰ",709995,0],["Γαβαηλ",702853,6],["καὶ",707031,7],["κόμισαί",707805,300],["μοι",708974,159],["τὸ",709436,24],["ἀργύριον",701707,25],["καὶ",707031,7],["αὐτὸν",702165,85],["ἄγε",700209,240],["εἰς",704105,0],["τὸν",709436,5],["γάμον",702957,6]],"Brother Azarias, take with thee a servant, and two camels, and go to Rages of Media to Gabael, and bring me the money, and bring him to the wedding."],["3",[["διότι",703734,7],["ὀμώμοκεν",709620,171],["Ραγουηλ",711144,4],["μὴ",708851,28],["ἐξελθεῖν",704909,106],["με",708618,163]],"For Raguel hath sworn that I shall not depart."],["4",[["καὶ",707031,7],["ὁ",709436,3],["πατήρ",710189,4],["μου",709032,133],["ἀριθμεῖ",701742,91],["τὰς",709436,38],["ἡμέρας",705984,39],["καὶ",707031,7],["ἐὰν",703912,7],["χρονίσω",713967,207],["μέγα",708653,46],["ὀδυνηθήσεται",709462,134],["λίαν",708184,28]],"But my father counteth the days; and if I tarry long, he will be very sorry."],["5",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["Ραφαηλ",711194,4],["καὶ",707031,7],["ηὐλίσθη",702138,37],["παρὰ",709995,0],["Γαβαήλῳ",702854,114],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["τὸ",709436,24],["χειρόγραφον",713792,25],["ὃς",709781,213],["δὲ",703303,11],["προήνεγκεν",711006,2],["τὰ",709436,41],["θυλάκια",706325,42],["ἐν",704639,0],["ταῖς",709436,75],["σφραγῖσιν",712591,76],["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50]],"So Raphael went out, and lodged with Gabael, and gave him the handwriting: who brought forth bags which were sealed up, and gave them to him."],["6",[["καὶ",707031,7],["ὤρθρευσαν",709741,150],["κοινῶς",707778,28],["καὶ",707031,7],["ἤλθοσαν",705453,150],["εἰς",704105,0],["τὸν",709436,5],["γάμον",702957,6],["καὶ",707031,7],["εὐλόγησεν",705631,2],["Τωβιας",713037,4],["τὴν",709436,8],["γυναῖκα",703209,9],["αὐτοῦ",702165,102]],"And early in the morning they went forth both together, and came to the wedding: and Tobias blessed his wife."]]