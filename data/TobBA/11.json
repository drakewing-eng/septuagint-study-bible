[["1",[["καὶ",707031,7],["ἐπορεύετο",710667,19],["μέχρις",708849,28],["οὗ",709781,48],["ἐγγίσαι",703939,106],["αὐτοὺς",702165,62],["εἰς",704105,0],["Νινευη",709312,9],["καὶ",707031,7],["εἶπεν",705373,2],["Ραφαηλ",711194,4],["πρὸς",710844,0],["Τωβιαν",713037,6]],"After these things Tobias went his way, praising God that he had given him a prosperous journey, and blessed Raguel and Edna his wife, and went on his way till they drew near unto Nineve."],["2",[["οὐ",709805,28],["γινώσκεις",703105,154],["ἄδελφε",700249,153],["πῶς",711121,28],["ἀφῆκας",702211,162],["τὸν",709436,5],["πατέρα",710189,6],["σου",711945,133]],"Then Raphael said to Tobias, Dost thou not know, brother, how thou didst leave thy father?"],["3",[["προδράμωμεν",710997,79],["ἔμπροσθεν",704618,0],["τῆς",709436,16],["γυναικός",703209,17],["σου",711945,133],["καὶ",707031,7],["ἑτοιμάσωμεν",705539,79],["τὴν",709436,8],["οἰκίαν",709505,9]],"let us haste before thy wife, and prepare the house;"],["4",[["λαβὲ",708076,176],["δὲ",703303,11],["παρὰ",709995,0],["χεῖρα",713787,9],["τὴν",709436,8],["χολὴν",713900,6],["τοῦ",709436,35],["ἰχθύος",706870,18],["καὶ",707031,7],["ἐπορεύθησαν",710667,99],["καὶ",707031,7],["συνῆλθεν",712458,2],["ὁ",709436,3],["κύων",708004,4],["ὄπισθεν",709691,28],["αὐτῶν",702165,40]],"and take in thine hand the gall of the fish. So they went their way, and the dog went after them."],["5",[["καὶ",707031,7],["Αννα",701176,12],["ἐκάθητο",707000,19],["περιβλεπομένη",710297,211],["εἰς",704105,0],["τὴν",709436,8],["ὁδὸν",709458,9],["τὸν",709436,5],["παῖδα",709932,6],["αὐτῆς",702165,86]],"Now Anna sat looking about toward the way for her son."],["6",[["καὶ",707031,7],["προσενόησεν",710937,2],["αὐτὸν",702165,85],["ἐρχόμενον",705453,212],["καὶ",707031,7],["εἶπεν",705373,2],["τῷ",709436,113],["πατρὶ",710189,114],["αὐτοῦ",702165,102],["ἰδοὺ",709725,300],["ὁ",709436,3],["υἱός",713075,4],["σου",711945,133],["ἔρχεται",705453,117],["καὶ",707031,7],["ὁ",709436,3],["ἄνθρωπος",701163,4],["ὁ",709436,3],["πορευ