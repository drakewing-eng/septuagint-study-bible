"],["11",[["καὶ",707031,7],["ἐπελάβετο",705185,23],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["καὶ",707031,7],["προσέπασεν",710951,2],["τὴν",709436,8],["χολὴν",713900,9],["ἐπὶ",705080,0],["τοὺς",709436,58],["ὀφθαλμοὺς",709870,57],["τοῦ",709436,35],["πατρὸς",710189,18],["αὐτοῦ",702165,102],["λέγων",708124,72],["θάρσει",706122,240],["πάτερ",710189,153]],"and took hold of his father: and he strake of the gall on his father's eyes, saying, Be of good hope, my father."],["12",[["ὡς",714148,28],["δὲ",703303,11],["συνεδήχθησαν",712413,99],["διέτριψε",703616,2],["τοὺς",709436,58],["ὀφθαλμοὺς",709870,57],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐλεπίσθη",708146,37],["ἀπὸ",701425,0],["τῶν",709436,80],["κανθῶν",707126,81],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["αὐτοῦ",702165,102],["τὰ",709436,41],["λευκώματα",708167,42]],"And when his eyes began to smart, he rubbed them;"],["13",[["καὶ",707031,7],["ἰδὼν",709725,182],["τὸν",709436,5],["υἱὸν",713075,6],["αὐτοῦ",702165,102],["ἐπέπεσεν",705225,2],["ἐπὶ",705080,0],["τὸν",709436,5],["τράχηλον",712924,6],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔκλαυσεν",707703,2],["καὶ",707031,7],["εἶπεν",705373,2]],"and the whiteness pilled away from the corners of his eyes: and when he saw his son, he fell upon his neck."],["14",[["εὐλογητὸς",705632,14],["εἶ",704093,154],["ὁ",709436,3],["θεός",706192,4],["καὶ",707031,7],["εὐλογητὸν",705632,26],["τὸ",709436,34],["ὄνομά",709666,15],["σου",711945,133],["εἰς",704105,0],["τοὺς",709436,58],["αἰῶνας",700504,57],["καὶ",707031,7],["εὐλογημένοι",705631,429],["πάντες",710177,138],["οἱ",709436,136],["ἅγιοί",700159,138],["σου",711945,133],["ἄγγελοι",700140,52],["ὅτι",709803,7],["ἐμαστίγωσας",708566,162],["καὶ",707031,7],["ἠλέησάς",704418,162],["με",708618,163],["ἰδοὺ",709725,300],["βλέπω",702740,157],["Τωβιαν",713037,6],["τὸν",709436,5],["υἱόν",713075,6],["μου",709032,133]],"And he wept, and said, Blessed art thou, O God, and blessed is thy name for ever; and blessed are all thine holy angels:"],["15",[["καὶ",707031,7],["εἰσῆλθεν",704114,2],["ὁ",709436,3],["υἱὸς",713075,4],["αὐτοῦ",702165,102],["χαίρων",713665,72],["καὶ",707031,7],["ἀπήγγειλεν",701321,2],["τῷ",709436,113],["πατρὶ",710189,114],["αὐτοῦ",702165,102],["τὰ",709436,41],["μεγαλεῖα",708625,68],["τὰ",709436,41],["γενόμενα",703104,611],["αὐτῷ",702165,50],["ἐν",704639,0],["τῇ",709436,100],["Μηδίᾳ",708856,1]],"for thou hast scourged, and hast taken pity [on me]: for, behold, I see my son Tobias. And his son went in rejoicing, and told his father the great things that had happened to him in Media."],["16",[["καὶ",707031,7],["ἐξῆλθεν",704909,2],["Τωβιτ",713044,4],["εἰς",704105,0],["συνάντησιν",712397,9],["τῇ",709436,100],["νύμφῃ",709381,1],["αὐτοῦ",702165,102],["χαίρων",713665,72],["καὶ",707031,7],["εὐλογῶν",705631,72],["τὸν",709436,5],["θεὸν",706192,6],["πρὸς",710844,0],["τῇ",709436,100],["πύλῃ",711082,1],["Νινευη",709312,1],["καὶ",707031,7],["ἐθαύμαζον",706135,137],["οἱ",709436,136],["θεωροῦντες",706226,146],["αὐτὸν",702165,85],["πορευόμενον",710667,212],["ὅτι",709803,7],["ἔβλεψεν",702740,2],["καὶ",707031,7],["Τωβιτ",713044,4],["ἐξωμολογεῖτο",704960,19],["ἐνώπιον",704823,0],["αὐτῶν",702165,40],["ὅτι",709803,7],["ἠλέησεν",704418,2],["αὐτὸν",702165,85],["ὁ",709436,3],["θεός",706192,4]],"Then Tobit went out to meet his daughter in law at the gate of Nineve, rejoicing, and praising God: and they which saw him go marvelled, because he had received his sight."],["17",[["καὶ",707031,7],["ὡς",714148,28],["ἤγγισεν",703939,2],["Τωβιτ",713044,4],["Σαρρα",711541,1],["τῇ",709436,100],["νύμφῃ",709381,1],["αὐτοῦ",702165,102],["κατευλόγησεν",707522,2],["αὐτὴν",702165,104],["λέγων",708124,72],["ἔλθοις",705453,657],["ὑγιαίνουσα",713057,188],["θύγατερ",706320,153],["εὐλογητὸς",705632,14],["ὁ",709436,3],["θεός",706192,4],["ὃς",709781,213],["ἤγαγέν",700209,2],["σε",711598,163],["πρὸς",710844,0],["ἡμᾶς",705981,194],["καὶ",707031,7],["ὁ",709436,3],["πατήρ",710189,4],["σου",711945,133],["καὶ",707031,7],["ἡ",709436,10],["μήτηρ",708892,12],["σου",711945,133]],"But Tobit gave thanks before them, because God had mercy on him. And when he came near to Sara his daughter in law, he blessed her, saying, Thou art welcome, daughter: God be blessed, which hath brought thee unto us, and [blessed be] thy father and thy mother. And there was joy among all his brethren which were at Nineve."],["18",[["καὶ",707031,7],["ἐγένετο",703104,23],["χαρὰ",713719,12],["πᾶσι",710177,230],["τοῖς",709436,147],["ἐν",704639,0],["Νινευη",709312,1],["ἀδελφοῖς",700249,148],["αὐτοῦ",702165,102]],"And Achiacharus, and Nasbas his brother's son, came:"],["19",[["καὶ",707031,7],["παρεγένετο",710006,23],["Αχιαχαρος",702266,4],["καὶ",707031,7],["Νασβας",709198,4],["ὁ",709436,3],["ἐξάδελφος",704835,4],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἤχθη",700209,37],["ὁ",709436,3],["γάμος",702957,4],["Τωβια",713036,18],["μετ᾿",708780,0],["εὐφροσύνης",705717,17],["ἑπτὰ",705357,59],["ἡμέρας",705984,39]],"and Tobias' wedding was kept seven days with great joy."]]