[["1",[["καὶ",707031,7],["ἀποκριθεὶς",701492,217],["Τωβιας",713037,4],["εἶπεν",705373,2],["αὐτῷ",702165,50],["πάτερ",710189,153],["ποιήσω",710582,165],["πάντα",710177,68],["ὅσα",709788,68],["ἐντέταλσαί",704791,332],["μοι",708974,159]],"Tobias then answered and said, Father, I will do all things which thou hast commanded me:"],["2",[["ἀλλὰ",700680,7],["πῶς",711121,28],["δυνήσομαι",703838,181],["λαβεῖν",708076,106],["τὸ",709436,24],["ἀργύριον",701707,25],["καὶ",707031,7],["οὐ",709805,28],["γινώσκω",703105,157],["αὐτόν",702165,85]],"but how can I receive the money, seeing I know him not?"],["3",[["καὶ",707031,7],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["τὸ",709436,24],["χειρόγραφον",713792,25],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["ζήτησον",705879,176],["σεαυτῷ",711599,50],["ἄνθρωπον",701163,6],["ὃς",709781,213],["συμπορεύσεταί",712342,93],["σοι",711925,159],["καὶ",707031,7],["δώσω",703654,165],["αὐτῷ",702165,50],["μισθόν",708939,6],["ἕως",705792,7],["ζῶ",705851,157],["καὶ",707031,7],["λαβὲ",708076,176],["πορευθεὶς",710667,217],["τὸ",709436,24],["ἀργύριον",701707,25]],"Then he gave him the handwriting, and said unto him, Seek thee a man which may go with thee, and I will give him wages whiles I yet live: and go and receive the money."],["4",[["καὶ",707031,7],["ἐπορεύθη",710667,37],["ζητῆσαι",705879,106],["ἄνθρωπον",701163,6],["καὶ",707031,7],["εὗρεν",705676,2],["τὸν",709436,5],["Ραφαηλ",711194,6],["ὃς",709781,213],["ἦν",704093,13],["ἄγγελος",700140,4],["καὶ",707031,7],["οὐκ",709805,28],["ᾔδει",709492,143]],"Therefore when he went to seek a man, he found Raphael that was an angel."],["5",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["εἰ",704071,7],["δύναμαι",703838,254],["πορευθῆναι",710667,179],["μετὰ",708780,0],["σοῦ",711945,133],["ἐν",704639,0],["Ῥάγοις",711143,111],["τῆς",709436,16],["Μηδίας",708856,17],["καὶ",707031,7],["εἰ",704071,7],["ἔμπειρος",704587,14],["εἶ",704093,154],["τῶν",709436,80],["τόπων",712903,81]],"But he knew not; and he said unto him, Canst thou go with me to Rages? and knowest thou those places well?"],["6",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["ὁ",709436,3],["ἄγγελος",700140,4],["πορεύσομαι",710667,181],["μετὰ",708780,0],["σοῦ",711945,133],["καὶ",707031,7],["τῆς",709436,16],["ὁδοῦ",709458,17],["ἐμπειρῶ",704588,157],["καὶ",707031,7],["παρὰ",709995,0],["Γαβαηλ",702853,6],["τὸν",709436,5],["ἀδελφὸν",700249,6],["ἡμῶν",705999,145],["ηὐλίσθην",702138,156]],"To whom the angel said, I will go with thee, and I know the way well: for I have lodged with our brother Gabael."],["7",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["Τωβιας",713037,4],["ὑπόμεινόν",713219,176],["με",708618,163],["καὶ",707031,7],["ἐρῶ",705415,165],["τῷ",709436,113],["πατρί",710189,114],["μου",709032,133]],"Then Tobias said unto him, Tarry for me, till I tell my father."],["8",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["πορεύου",710667,253],["καὶ",707031,7],["μὴ",708851,28],["χρονίσῃς",713967,175]],"Then he said unto him, Go, and tarry not. So he went in and said to his father, Behold, I have found one which will go with me. Then he said, Call him unto me, that I may know of what tribe he is, and whether he be a trusty man to go with thee."],["9",[["καὶ",707031,7],["εἰσελθὼν",704114,182],["εἶπεν",705373,2],["τῷ",709436,113],["πατρί",710189,114],["ἰδοὺ",709725,300],["εὕρηκα",705676,89],["ὃς",709781,213],["συμπορεύσεταί",712342,93],["μοι",708974,159],["ὁ",709436,3],["δὲ",703303,11],["εἶπεν",705373,2],["φώνησον",713639,176],["αὐτὸν",702165,85],["πρός",710844,0],["με",708618,163],["ἵνα",706747,7],["ἐπιγνῶ",705104,172],["ποίας",710599,82],["φυλῆς",713620,17],["ἐστιν",704093,91],["καὶ",707031,7],["εἰ",704071,7],["πιστὸς",710486,14],["τοῦ",709436,20],["πορευθῆναι",710667,179],["μετὰ",708780,0],["σοῦ",711945,133]],"So he called him, and he came in, and they saluted one another."],["10",[["καὶ",707031,7],["ἐκάλεσεν",707084,2],["αὐτόν",702165,85],["καὶ",707031,7],["εἰσῆλθεν",704114,2],["καὶ",707031,7],["ἠσπάσαντο",701987,189],["ἀλλήλους",700689,62]],"Then Tobit said unto him, Brother, shew me of what tribe and family thou art."],["11",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["Τωβιτ",713044,153],["ἄδελφε",700249,153],["ἐκ",704132,0],["ποίας",710599,82],["φυλῆς",713620,17],["καὶ",707031,7],["ἐκ",704132,0],["ποίας",710599,82],["πατρίδος",710196,17],["σὺ",712181,164],["εἶ",704093,154],["ὑπόδειξόν",713192,176],["μοι",708974,159]],"To whom he said, Dost thou seek for a tribe or family, or an hired man to go with thy son? Then Tobit said unto him, I would know, brother, thy kindred and name."],["12",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["φυλὴν",713620,9],["καὶ",707031,7],["πατριὰν",710192,9],["σὺ",712181,164],["ζητεῖς",705879,154],["ἢ",705924,7],["μίσθιον",708938,27],["ὃς",709781,213],["συμπορεύσεται",712342,93],["μετὰ",708780,0],["τοῦ",709436,35],["υἱοῦ",713075,18],["σου",711945,133],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["Τωβιτ",713044,153],["βούλομαι",702795,254],["ἄδελφε",700249,153],["ἐπιγνῶναι",705104,106],["τὸ",709436,24],["γένος",703057,25],["σου",711945,133],["καὶ",707031,7],["τὸ",709436,24],["ὄνομα",709666,25]],"Then he said, I am Azarias, [the son] of Ananias the great, and of thy brethren."],["13",[["ὁ",709436,3],["δὲ",703303,11],["εἶπεν",705373,2],["ἐγὼ",704018,164],["Αζαριας",700328,4],["Ανανιου",701016,18],["τοῦ",709436,35],["μεγάλου",708653,116],["τῶν",709436,80],["ἀδελφῶν",700249,81],["σου",711945,133]],"Then Tobit said, Thou art welcome, brother; be not now angry with me, because I have enquired to know thy tribe and thy family; for thou art my brother, of an honest and good stock: for I know Ananias and Jonathas, sons of that great Samaias, as we went together to Jerusalem to worship, and offered the firstborn, and the tenths of the fruits; and they were not seduced with the error of our brethren: my brother, thou art of a good stock."],["14",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["ὑγιαίνων",713057,72],["ἔλθοις",705453,657],["ἄδελφε",700249,153],["καὶ",707031,7],["μή",708851,28],["μοι",708974,159],["ὀργισθῇς",709729,279],["ὅτι",709803,7],["ἐζήτησα",705879,155],["τὴν",709436,8],["φυλήν",713620,9],["σου",711945,133],["καὶ",707031,7],["τὴν",709436,8],["πατριάν",710192,9],["σου",711945,133],["ἐπιγνῶναι",705104,106],["καὶ",707031,7],["σὺ",712181,164],["τυγχάνεις",713015,154],["ἀδελφός",700249,4],["μου",709032,133],["ἐκ",704132,0],["τῆς",709436,16],["καλῆς",707097,82],["καὶ",707031,7],["ἀγαθῆς",700106,82],["γενεᾶς",703037,17],["ἐπεγίνωσκον",705104,333],["γὰρ",702963,11],["ἐγὼ",704018,164],["Ανανιαν",701016,6],["καὶ",707031,7],["Ιαθαν",706388,6],["τοὺς",709436,58],["υἱοὺς",713075,57],["Σεμειου",711668,18],["τοῦ",709436,35],["μεγάλου",708653,116],["ὡς",714148,28],["ἐπορευόμεθα",710667,502],["κοινῶς",707778,28],["εἰς",704105,0],["Ιεροσόλυμα",706644,227],["προσκυνεῖν",710925,55],["ἀναφέροντες",701083,146],["τὰ",709436,41],["πρωτότοκα",711046,68],["καὶ",707031,7],["τὰς",709436,38],["δεκάτας",703342,119],["τῶν",709436,43],["γενημάτων",703052,44],["καὶ",707031,7],["οὐκ",709805,28],["ἐπλανήθησαν",710495,99],["ἐν",704639,0],["τῇ",709436,100],["πλάνῃ",710496,1],["τῶν",709436,80],["ἀδελφῶν",700249,81],["ἡμῶν",705999,145],["ἐκ",704132,0],["ῥίζης",711260,17],["καλῆς",707097,82],["εἶ",704093,154],["ἄδελφε",700249,153]],"But tell me, what wages shall I give thee? [wilt thou] a drachm a day, and things necessary, as to mine own son?"],["15",[["ἀλλ᾿",700680,7],["εἰπόν",705373,176],["μοι",708974,159],["τίνα",712867,356],["σοι",711925,159],["ἔσομαι",704093,181],["μισθὸν",708939,6],["διδόναι",703654,55],["δραχμὴν",703827,9],["τῆς",709436,16],["ἡμέρας",705984,17],["καὶ",707031,7],["τὰ",709436,41],["δέοντά",703394,237],["σοι",711925,159],["ὡς",714148,28],["καὶ",707031,28],["τῷ",709436,113],["υἱῷ",713075,114],["μου",709032,133]],"Yea, moreover, if ye return safe, I will add something to thy wages."],["16",[["καὶ",707031,7],["ἔτι",705538,28],["προσθήσω",710965,165],["σοι",711925,159],["ἐπὶ",705080,0],["τὸν",709436,5],["μισθόν",708939,6],["ἐὰν",703912,7],["ὑγιαίνοντες",713057,146],["ἐπιστρέψητε",705278,125]],"So they were well pleased. Then said he to Tobias, Prepare thyself for the journey, and God send you a good journey. And when his son had prepared all things for the journey, his father said, Go thou with this man, and God, which dwelleth in heaven, prosper your journey, and the angel of God keep you company. So they went forth both, and the young man's dog with them."],["17",[["καὶ",707031,7],["εὐδόκησαν",705565,150],["οὕτως",709859,28],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["Τωβιαν",713037,6],["ἕτοιμος",705541,14],["γίνου",703104,253],["πρὸς",710844,0],["τὴν",709436,8],["ὁδόν",709458,9],["καὶ",707031,7],["εὐοδωθείητε",705654,531],["καὶ",707031,7],["ἡτοίμασεν",705539,2],["ὁ",709436,3],["υἱὸς",713075,4],["αὐτοῦ",702165,102],["τὰ",709436,41],["πρὸς",710844,0],["τὴν",709436,8],["ὁδόν",709458,9],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτοῦ",702165,102],["πορεύου",710667,253],["μετὰ",708780,0],["τοῦ",709436,35],["ἀνθρώπου",701163,18],["ὁ",709436,3],["δὲ",703303,11],["ἐν",704639,0],["τῷ",709436,113],["οὐρανῷ",709844,114],["οἰκῶν",709516,81],["θεὸς",706192,4],["εὐοδώσει",705654,127],["τὴν",709436,8],["ὁδὸν",709458,9],["ὑμῶν",713091,145],["καὶ",707031,7],["ὁ",709436,3],["ἄγγελος",700140,4],["αὐτοῦ",702165,102],["συμπορευθήτω",712342,22],["ὑμῖν",713084,90],["καὶ",707031,7],["ἐξῆλθαν",704909,150],["ἀμφότεροι",700892,138],["ἀπελθεῖν",701398,106],["καὶ",707031,7],["ὁ",709436,3],["κύων",708004,4],["τοῦ",709436,20],["παιδαρίου",709923,21],["μετ᾿",708780,0],["αὐτῶν",702165,40]],"But Anna his mother wept, and said to Tobit, Why hast thou sent away our son? is he not the staff of our hand, in going in and out before us?"],["18",[["ἔκλαυσεν",707703,2],["δὲ",703303,11],["Αννα",701176,12],["ἡ",709436,10],["μήτηρ",708892,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["Τωβιτ",713044,6],["τί",712867,126],["ἐξαπέστειλας",704872,162],["τὸ",709436,24],["παιδίον",709927,25],["ἡμῶν",705999,145],["ἢ",705924,7],["οὐχὶ",709862,28],["ἡ",709436,10],["ῥάβδος",711135,12],["τῆς",709436,16],["χειρὸς",713787,17],["ἡμῶν",705999,145],["ἐστιν",704093,91],["ἐν",704639,0],["τῷ",709436,53],["εἰσπορεύεσθαι",704124,110],["αὐτὸν",702165,85],["καὶ",707031,7],["ἐκπορεύεσθαι",704293,110],["ἐνώπιον",704823,0],["ἡμῶν",705999,145]],"Be not greedy to add money to money: but let it be as refuse in respect of our child."],["19",[["ἀργύριον",701707,25],["τῷ",709436,53],["ἀργυρίῳ",701707,54],["μὴ",708851,28],["φθάσαι",713439,225],["ἀλλὰ",700680,7],["περίψημα",710424,15],["τοῦ",709436,20],["παιδίου",709927,21],["ἡμῶν",705999,145],["γένοιτο",703104,382]],"For that which the Lord hath given us to live with doth suffice us."],["20",[["ὡς",714148,7],["γὰρ",702963,11],["δέδοται",703654,187],["ἡμῖν",705994,90],["ζῆν",705851,55],["παρὰ",709995,0],["τοῦ",709436,35],["κυρίου",707996,18],["τοῦτο",709858,132],["ἱκανὸν",706710,26],["ἡμῖν",705994,90],["ὑπάρχει",713104,91]],"Then said Tobit to her, Take no care, my sister; he shall return in safety, and thine eyes shall see him."],["21",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῇ",702165,105],["Τωβιτ",713044,4],["μὴ",708851,28],["λόγον",708236,6],["ἔχε",705785,240],["ἀδελφή",700244,258],["ὑγιαίνων",713057,72],["ἐλεύσεται",705453,93],["καὶ",707031,7],["οἱ",709436,136],["ὀφθαλμοί",709870,52],["σου",711945,133],["ὄψονται",709725,135],["αὐτόν",702165,85]],"For the good angel will keep him company, and his journey shall be prosperous, and he shall return safe."],["22",[["ἄγγελος",700140,4],["γὰρ",702963,11],["ἀγαθὸς",700106,14],["συμπορεύσεται",712342,93],["αὐτῷ",702165,50],["καὶ",707031,7],["εὐοδωθήσεται",705654,134],["ἡ",709436,10],["ὁδὸς",709458,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["ὑποστρέψει",713246,127],["ὑγιαίνων",713057,72]],"Then she made an end of weeping."],["23",[["καὶ",707031,7],["ἐπαύσατο",710202,23],["κλαίουσα",707703,188]],null]]