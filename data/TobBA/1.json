[["1",[["βίβλος",702721,12],["λόγων",708236,81],["Τωβιτ",713044,18],["τοῦ",709436,35],["Τωβιηλ",713041,18],["τοῦ",709436,35],["Ανανιηλ",701017,18],["τοῦ",709436,35],["Αδουηλ",700287,18],["τοῦ",709436,35],["Γαβαηλ",702853,18],["ἐκ",704132,0],["τοῦ",709436,20],["σπέρματος",712008,21],["Ασιηλ",701951,18],["ἐκ",704132,0],["τῆς",709436,16],["φυλῆς",713620,17],["Νεφθαλιμ",709279,17]],"The book of the words of Tobit, the [son] of Tobiel, the son of Ananiel, the son of Aduel, the son of Gabael, of the seed of Asael, of the tribe of Nephthali;"],["2",[["ὃς",709781,213],["ᾐχμαλωτεύθη",700500,37],["ἐν",704639,0],["ἡμέραις",705984,76],["Ενεμεσσαρου",704711,18],["τοῦ",709436,35],["βασιλέως",702580,18],["Ἀσσυρίων",702004,81],["ἐκ",704132,0],["Θισβης",706270,17],["ἥ",709781,177],["ἐστιν",704093,91],["ἐκ",704132,0],["δεξιῶν",703360,83],["Κυδιως",707950,118],["τῆς",709436,16],["Νεφθαλιμ",709279,17],["ἐν",704639,0],["τῇ",709436,100],["Γαλιλαίᾳ",702940,1],["ὑπεράνω",713118,0],["Ασηρ",701934,18]],"who in the time of Enemessar king of the Assyrians was led captive out of Thisbe, which is at the right hand of that city, which is called properly Nephthali in Galilee above Aser."],["3",[["ἐγὼ",704018,164],["Τωβιτ",713044,4],["ὁδοῖς",709458,76],["ἀληθείας",700656,17],["ἐπορευόμην",710667,334],["καὶ",707031,7],["δικαιοσύνης",703695,17],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["τῆς",709436,16],["ζωῆς",705910,17],["μου",709032,133],["καὶ",707031,7],["ἐλεημοσύνας",704421,39],["πολλὰς",710646,119],["ἐποίησα",710582,155],["τοῖς",709436,147],["ἀδελφοῖς",700249,148],["μου",709032,133],["καὶ",707031,7],["τῷ",709436,53],["ἔθνει",704068,54],["τοῖς",709436,147],["συμπορευθεῖσιν",712342,477],["μετ᾿",708780,0],["ἐμοῦ",704580,133],["εἰς",704105,0],["χώραν",714011,9],["Ἀσσυρίων",702004,81],["εἰς",704105,0],["Νινευη",709312,9]],"I Tobit have walked all the days of my life in the way of truth and justice, and I did many alms-deeds to my brethren, and my nation, who came with me to Nineve, into the land of the Assyrians."],["4",[["καὶ",707031,7],["ὅτε",709802,28],["ἤμην",704578,36],["ἐν",704639,0],["τῇ",709436,100],["χώρᾳ",714011,1],["μου",709032,133],["ἐν",704639,0],["τῇ",709436,100],["γῇ",703083,1],["Ισραηλ",706839,18],["νεωτέρου",709256,229],["μου",709032,133],["ὄντος",704093,152],["πᾶσα",710177,29],["φυλὴ",713620,12],["τοῦ",709436,35],["Νεφθαλιμ",709279,18],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133],["ἀπέστη",702214,2],["ἀπὸ",701425,0],["τοῦ",709436,35],["οἴκου",709516,18],["Ιεροσολύμων",706644,118],["τῆς",709436,16],["ἐκλεγείσης",704236,222],["ἀπὸ",701425,0],["πασῶν",710177,198],["τῶν",709436,130],["φυλῶν",713620,65],["Ισραηλ",706839,18],["εἰς",704105,0],["τὸ",709436,24],["θυσιάζειν",706346,55],["πάσας",710177,119],["τὰς",709436,38],["φυλάς",713620,39],["καὶ",707031,7],["ἡγιάσθη",700153,37],["ὁ",709436,3],["ναὸς",709191,4],["τῆς",709436,16],["κατασκηνώσεως",707424,17],["τοῦ",709436,35],["ὑψίστου",713287,116],["καὶ",707031,7],["ᾠκοδομήθη",709509,37],["εἰς",704105,0],["πάσας",710177,119],["τὰς",709436,38],["γενεὰς",703037,39],["τοῦ",709436,35],["αἰῶνος",700504,18]],"And when I was in mine own country, in the land of Israel, being but young, all the tribe of Nephthali my father fell from the house of Jerusalem, which was chosen out of all the tribes of Israel, that all the tribes should sacrifice [there], and, [where] the temple of the habitation of the most High was consecrated and built for all ages."],["5",[["καὶ",707031,7],["πᾶσαι",710177,192],["αἱ",709436,190],["φυλαὶ",713620,191],["αἱ",709436,190],["συναποστᾶσαι",712411,389],["ἔθυον",706349,137],["τῇ",709436,100],["Βααλ",702333,1],["τῇ",709436,100],["δαμάλει",703271,1],["καὶ",707031,7],["ὁ",709436,3],["οἶκος",709516,4],["Νεφθαλιμ",709279,18],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133]],"Now all the tribes which together revolted, and the house of my father Nephthali, sacrificed unto the heifer Baal."],["6",[["κἀγὼ",706969,288],["μόνος",709003,14],["ἐπορευόμην",710667,334],["πλεονάκις",710517,28],["εἰς",704105,0],["Ιεροσόλυμα",706644,227],["ἐν",704639,0],["ταῖς",709436,75],["ἑορταῖς",704990,76],["καθὼς",707030,28],["γέγραπται",703194,187],["παντὶ",710177,30],["τῷ",709436,113],["Ισραηλ",706839,114],["ἐν",704639,0],["προστάγματι",710959,54],["αἰωνίῳ",700505,97],["τὰς",709436,38],["ἀπαρχὰς",701359,39],["καὶ",707031,7],["τὰς",709436,38],["δεκάτας",703342,119],["τῶν",709436,43],["γενημάτων",703052,44],["καὶ",707031,7],["τὰς",709436,38],["πρωτοκουρίας",711037,39],["ἔχων",705785,72]],"But I alone went often to Jerusalem at the feasts, as it was ordained unto all the people of Israel by an everlasting decree, having the first-fruits and tenths of increase, with that which was first shorn; and them gave I at the altar to the priests the children of Aaron.",{"s":"d","q":0.62}],["7",[["καὶ",707031,7],["ἐδίδουν",703654,333,334],["αὐτὰς",702165,231],["τοῖς",709436,147],["ἱερεῦσιν",706614,148],["τοῖς",709436,147],["υἱοῖς",713075,148],["Ααρων",700005,18],["πρὸς",710844,0],["τὸ",709436,24],["θυσιαστήριον",706348,25],["πάντων",710177,83],["τῶν",709436,43],["γενημάτων",703052,44],["τὴν",709436,8],["δεκάτην",703342,36],["ἐδίδουν",703654,333,334],["τοῖς",709436,147],["υἱοῖς",713075,148],["Λευι",708158,18],["τοῖς",709436,147],["θεραπεύουσιν",706200,349],["ἐν",704639,0],["Ιερουσαλημ",706644,120],["καὶ",707031,7],["τὴν",709436,8],["δευτέραν",703389,36],["δεκάτην",703342,36],["ἀπεπρατιζόμην",701555,334],["καὶ",707031,7],["ἐπορευόμην",710667,334],["καὶ",707031,7],["ἐδαπάνων",703286,137],["αὐτὰ",702165,71],["ἐν",704639,0],["Ιεροσολύμοις",706644,111],["καθ᾿",707200,0],["ἕκαστον",704133,27],["ἐνιαυτόν",704745,6]],"The first tenth part of all increase I gave to the sons of Aaron, who ministered at Jerusalem: another tenth part I sold away, and went, and spent it every year at Jerusalem:",{"s":"d","q":0.59}],["8",[["καὶ",707031,7],["τὴν",709436,8],["τρίτην",712968,36],["ἐδίδουν",703654,333,334],["οἷς",709781,311],["καθήκει",706998,91],["καθὼς",707030,28],["ἐνετείλατο",704791,23],["Δεββωρα",703305,12],["ἡ",709436,10],["μήτηρ",708892,12],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133],["διότι",703734,7],["ὀρφανὸς",709779,14],["κατελείφθην",707305,156],["ὑπὸ",713184,0],["τοῦ",709436,35],["πατρός",710189,18],["μου",709032,133]],"and the third I gave unto them to whom it was meet, as Debora my father's mother had commanded me, because I was left an orphan by my father."],["9",[["καὶ",707031,7],["ὅτε",709802,28],["ἐγενόμην",703104,161],["ἀνήρ",701150,4],["ἔλαβον",708076,155],["Ανναν",701177,9],["γυναῖκα",703209,9],["ἐκ",704132,0],["τοῦ",709436,20],["σπέρματος",712008,21],["τῆς",709436,16],["πατριᾶς",710195,82],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐγέννησα",703051,155],["ἐξ",704132,0],["αὐτῆς",702165,86],["Τωβιαν",713037,6]],"Furthermore, when I was come to the age of a man, I married Anna of mine own kindred, and of her I begat Tobias."],["10",[["καὶ",707031,7],["ὅτε",709802,28],["ᾐχμαλωτίσθην",700501,156],["εἰς",704105,0],["Νινευη",709312,9],["πάντες",710177,138],["οἱ",709436,136],["ἀδελφοί",700249,52],["μου",709032,133],["καὶ",707031,7],["οἱ",709436,136],["ἐκ",704132,0],["τοῦ",709436,20],["γένους",703057,21],["μου",709032,133],["ἤσθιον",705495,137],["ἐκ",704132,0],["τῶν",709436,80],["ἄρτων",701829,81],["τῶν",709436,80],["ἐθνῶν",704068,44]],"And when we were carried away captives to Nineve, all my brethren and those that were of my kindred did eat of the bread of the Gentiles."],["11",[["ἐγὼ",704018,164],["δὲ",703303,11],["συνετήρησα",712512,155],["τὴν",709436,8],["ψυχήν",714070,9],["μου",709032,133],["μὴ",708851,28],["φαγεῖν",713296,106]],"But I kept myself from eating;"],["12",[["καθότι",707021,7],["ἐμεμνήμην",708923,655],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐν",704639,0],["ὅλῃ",709597,101],["τῇ",709436,100],["ψυχῇ",714070,1],["μου",709032,133]],"because I remembered God with all my heart."],["13",[["καὶ",707031,7],["ἔδωκεν",703654,2],["ὁ",709436,3],["ὕψιστος",713287,14],["χάριν",713735,9],["καὶ",707031,7],["μορφὴν",709018,9],["ἐνώπιον",704823,0],["Ενεμεσσαρου",704711,18],["καὶ",707031,7],["ἤμην",704578,36],["αὐτοῦ",702165,102],["ἀγοραστής",700187,4]],"And the most High gave me grace and favour before Enemessar, so that I was his purveyor."],["14",[["καὶ",707031,7],["ἐπορευόμην",710667,334],["εἰς",704105,0],["τὴν",709436,8],["Μηδίαν",708856,9],["καὶ",707031,7],["παρεθέμην",710111,333],["Γαβαήλῳ",702854,114],["τῷ",709436,113],["ἀδελφῷ",700249,114],["Γαβρια",702869,18],["ἐν",704639,0],["Ραγοις",711143,111],["τῆς",709436,16],["Μηδίας",708856,17],["ἀργυρίου",701707,21],["τάλαντα",712697,42],["δέκα",703333,59]],"And I went into Media, and left in trust with Gabael, the brother of Gabrias, at Rages a city of Media, ten talents of silver."],["15",[["καὶ",707031,7],["ὅτε",709802,28],["ἀπέθανεν",701461,2],["Ενεμεσσαρος",704711,4],["ἐβασίλευσεν",702581,2],["Σενναχηριμ",711693,4],["ὁ",709436,3],["υἱὸς",713075,4],["αὐτοῦ",702165,102],["ἀντ᾿",701227,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["αἱ",709436,190],["ὁδοὶ",709458,191],["αὐτοῦ",702165,102],["ἠκαταστάτησαν",700531,150],["καὶ",707031,7],["οὐκέτι",709827,28],["ἠδυνάσθην",703838,156],["πορευθῆναι",710667,179],["εἰς",704105,0],["τὴν",709436,8],["Μηδίαν",708856,9]],"Now when Enemessar was dead, Sennacherib his son reigned in his stead; whose estate was troubled, that I could not go into Media."],["16",[["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["Ενεμεσσαρου",704711,18],["ἐλεημοσύνας",704421,39],["πολλὰς",710646,119],["ἐποίουν",710582,137],["τοῖς",709436,147],["ἀδελφοῖς",700249,148],["μου",709032,133]],"And in the time of Enemessar I gave many alms to my brethren, and gave my bread to the hungry,"],["17",[["τοὺς",709436,58],["ἄρτους",701829,57],["μου",709032,133],["ἐδίδουν",703654,333,334],["τοῖς",709436,147],["πεινῶσιν",710222,349],["καὶ",707031,7],["τὰ",709436,41],["ἱμάτιά",706742,42],["μου",709032,133],["τοῖς",709436,147],["γυμνοῖς",703202,230],["καὶ",707031,7],["εἴ",704071,7],["τινα",712866,356],["ἐκ",704132,0],["τοῦ",709436,20],["γένους",703057,21],["μου",709032,133],["ἐθεώρουν",706226,333],["τεθνηκότα",706278,427],["καὶ",707031,7],["ἐρριμμένον",711267,439],["ὀπίσω",709697,28],["τοῦ",709436,20],["τείχους",712759,21],["Νινευη",709312,17],["ἔθαπτον",706103,333],["αὐτόν",702165,85]],"and my clothes to the naked: and if I saw any of my nation dead, or cast about the walls of Nineve, I buried him."],["18",[["καὶ",707031,7],["εἴ",704071,7],["τινα",712866,356],["ἀπέκτεινεν",701498,2],["Σενναχηριμ",711693,4],["ὁ",709436,3],["βασιλεύς",702580,4],["ὅτε",709802,28],["ἦλθεν",705453,2],["φεύγων",713433,72],["ἐκ",704132,0],["τῆς",709436,16],["Ιουδαίας",706769,17],["ἔθαψα",706103,155],["αὐτοὺς",702165,62],["κλέπτων",707715,72],["πολλοὺς",710646,60],["γὰρ",702963,11],["ἀπέκτεινεν",701498,2],["ἐν",704639,0],["τῷ",709436,113],["θυμῷ",706334,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐζητήθη",705879,37],["ὑπὸ",713184,0],["τοῦ",709436,35],["βασιλέως",702580,18],["τὰ",709436,63],["σώματα",712635,64],["καὶ",707031,7],["οὐχ",709805,28],["εὑρέθη",705676,37]],"And if the king Sennacherib had slain any, when he was come, and fled from Judea, I buried them privily; for in his wrath he killed many; but the bodies were not found, when they were sought for of the king."],["19",[["πορευθεὶς",710667,217],["δὲ",703303,11],["εἷς",704106,596],["τῶν",709436,80],["ἐν",704639,0],["Νινευη",709312,1],["ὑπέδειξε",713192,2],["τῷ",709436,113],["βασιλεῖ",702580,114],["περὶ",710285,0],["ἐμοῦ",704580,133],["ὅτι",709803,7],["θάπτω",706103,157],["αὐτούς",702165,62],["καὶ",707031,7],["ἐκρύβην",707923,156],["ἐπιγνοὺς",705104,182],["δὲ",703303,11],["ὅτι",709803,7],["ζητοῦμαι",705879,254],["ἀποθανεῖν",701461,106],["φοβηθεὶς",713532,217],["ἀνεχώρησα",701092,155]],"And when one of the Ninevites went and complained of me to the king, that I buried them, and hid myself; understanding that I was sought for to be put to death, I withdrew myself for fear."],["20",[["καὶ",707031,7],["διηρπάγη",703562,37],["πάντα",710177,68],["τὰ",709436,41],["ὑπάρχοντά",713102,237],["μου",709032,133],["καὶ",707031,7],["οὐ",709805,28],["κατελείφθη",707305,37],["μοι",708974,159],["οὐδὲν",709817,46],["πλὴν",710540,28],["Αννας",701178,17],["τῆς",709436,16],["γυναικός",703209,17],["μου",709032,133],["καὶ",707031,7],["Τωβιου",713037,18],["τοῦ",709436,35],["υἱοῦ",713075,18],["μου",709032,133]],"Then all my goods were forcibly taken away, neither was there any thing left me, beside my wife Anna and my son Tobias."],["21",[["καὶ",707031,7],["οὐ",709805,28],["διῆλθον",703673,150],["ἡμέραι",705984,191],["πεντήκοντα",710270,59],["ἕως",705792,7],["οὗ",709781,48],["ἀπέκτειναν",701498,150],["αὐτὸν",702165,85],["οἱ",709436,136],["δύο",703849,543],["υἱοὶ",713075,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔφυγον",713433,150],["εἰς",704105,0],["τὰ",709436,41],["ὄρη",709768,42],["Αραρατ",701688,118],["καὶ",707031,7],["ἐβασίλευσεν",702581,2],["Σαχερδονος",711592,4],["ὁ",709436,3],["υἱὸς",713075,4],["αὐτοῦ",702165,102],["ἀντ᾿",701227,0],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔταξεν",712730,2],["Αχιαχαρον",702266,6],["τὸν",709436,5],["Αναηλ",700947,6],["υἱὸν",713075,6],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["μου",709032,133],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["τὴν",709436,8],["ἐκλογιστίαν",704250,9],["τῆς",709436,16],["βασιλείας",702577,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐπὶ",705080,0],["πᾶσαν",710177,36],["τὴν",709436,8],["διοίκησιν",703718,9]],"And there passed not fifty days, before two of his sons killed him, and they fled into the mountains of Ararath; and Sarchedonus his son reigned in his stead; who appointed over his father's accounts, and over all his affairs, Achiacharus my brother Anael's son."],["22",[["καὶ",707031,7],["ἠξίωσεν",701309,2],["Αχιαχαρος",702266,4],["περὶ",710285,0],["ἐμοῦ",704580,133],["καὶ",707031,7],["ἦλθον",705453,155],["εἰς",704105,0],["Νινευη",709312,9],["Αχιαχαρος",702266,4],["δὲ",703303,11],["ἦν",704093,13],["ὁ",709436,3],["οἰνοχόος",709533,4],["καὶ",707031,7],["ἐπὶ",705080,0],["τοῦ",709436,35],["δακτυλίου",703258,18],["καὶ",707031,7],["διοικητὴς",703719,4],["καὶ",707031,7],["ἐκλογιστής",704249,4],["καὶ",707031,7],["κατέστησεν",707011,2],["αὐτὸν",702165,85],["ὁ",709436,3],["Σαχερδονος",711592,4],["ἐκ",704132,0],["δευτέρας",703389,119],["ἦν",704093,13],["δὲ",703303,11],["ἐξάδελφός",704835,4],["μου",709032,133]],"And Achiacharus intreating for me, I returned to Nineve. Now Achiacharus was cupbearer, and keeper of the signet, and steward, and overseer of the accounts: and Sarchedonus appointed him next unto him: and he was my brother's son."]]