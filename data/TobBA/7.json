[["1",[["καὶ",707031,7],["ἦλθον",705453,150],["εἰς",704105,0],["Ἐκβάτανα",704147,227],["καὶ",707031,7],["παρεγένοντο",710006,189],["εἰς",704105,0],["τὴν",709436,8],["οἰκίαν",709505,9],["Ραγουηλ",711144,18],["Σαρρα",711541,4],["δὲ",703303,11],["ὑπήντησεν",713098,2],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἐχαιρέτισεν",713664,2],["αὐτοὺς",702165,62],["καὶ",707031,7],["αὐτοὶ",702165,201],["αὐτήν",702165,104],["καὶ",707031,7],["εἰσήγαγεν",704107,2],["αὐτοὺς",702165,62],["εἰς",704105,0],["τὴν",709436,8],["οἰκίαν",709505,9]],"And he came to the house of Raguel; and Sara met him: and saluted him, and he them; and she brought them into the house."],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["Ραγουηλ",711144,4],["Εδνα",704034,1],["τῇ",709436,100],["γυναικὶ",703209,1],["αὐτοῦ",702165,102],["ὡς",714148,28],["ὅμοιος",709626,14],["ὁ",709436,3],["νεανίσκος",709232,4],["Τωβιτ",713044,18],["τῷ",709436,113],["ἀνεψιῷ",701141,114],["μου",709032,133]],"Then said Raguel to Edna his wife, How like is this young man to Tobit my cousin!"],["3",[["καὶ",707031,7],["ἠρώτησεν",705459,2],["αὐτοὺς",702165,62],["Ραγουηλ",711144,4],["πόθεν",710580,0],["ἐστέ",704093,87],["ἀδελφοί",700249,52],["καὶ",707031,7],["εἶπαν",705373,150],["αὐτῷ",702165,50],["ἐκ",704132,0],["τῶν",709436,80],["υἱῶν",713075,81],["Νεφθαλι",709279,18],["τῶν",709436,80],["αἰχμαλώτων",700503,169],["ἐν",704639,0],["Νινευη",709312,1]],"And Raguel asked them, From whence are ye, brethren? To whom they said, We are of the sons of Nephthali, which are captives in Nineve."],["4",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["γινώσκετε",703105,87],["Τωβιτ",713044,6],["τὸν",709436,5],["ἀδελφὸν",700249,6],["ἡμῶν",705999,145],["οἱ",709436,136],["δὲ",703303,11],["εἶπαν",705373,150],["γινώσκομεν",703105,243]],"Then he said to them, Do ye know Tobit our kinsman? And they said, We know him. Then said he, Is he in good health?"],["5",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτοῖς",702165,151],["ὑγιαίνει",713057,91],["οἱ",709436,136],["δὲ",703303,11],["εἶπαν",705373,150],["καὶ",707031,28],["ζῇ",705851,91],["καὶ",707031,7],["ὑγιαίνει",713057,91],["καὶ",707031,7],["εἶπεν",705373,2],["Τωβιας",713040,4],["πατήρ",710189,4],["μού",709032,133],["ἐστιν",704093,91]],"And they said, He is both alive, and in good health: and Tobias said, He is my father."],["6",[["καὶ",707031,7],["ἀνεπήδησεν",701031,2],["Ραγουηλ",711144,4],["καὶ",707031,7],["κατεφίλησεν",707476,2],["αὐτὸν",702165,85],["καὶ",707031,7],["ἔκλαυσε",707703,2],["καὶ",707031,7],["εὐλόγησεν",705631,2],["αὐτὸν",702165,85],["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["ὁ",709436,3],["τοῦ",709436,35],["καλοῦ",707097,116],["καὶ",707031,7],["ἀγαθοῦ",700106,116],["ἀνθρώπου",701163,18],["καὶ",707031,7],["ἀκούσας",700587,182],["ὅτι",709803,7],["Τωβιτ",713044,4],["ἀπώλεσεν",701513,2],["τοὺς",709436,58],["ὀφθαλμοὺς",709870,57],["αὐτοῦ",702165,102],["ἐλυπήθη",708272,37],["καὶ",707031,7],["ἔκλαυσεν",707703,2]],"Then Raguel leaped up, and kissed him, and wept,"],["7",[["καὶ",707031,7],["Εδνα",704034,12],["ἡ",709436,10],["γυνὴ",703209,12],["αὐτοῦ",702165,102],["καὶ",707031,7],["Σαρρα",711541,12],["ἡ",709436,10],["θυγάτηρ",706320,12],["αὐτοῦ",702165,102],["ἔκλαυσαν",707703,150],["καὶ",707031,7],["ὑπεδέξαντο",713193,189],["αὐτοὺς",702165,62],["προθύμως",710800,28]],"and blessed him, and said unto him, [Thou art] the son of an honest and good man. But when he had heard that Tobit was blind, he was sorrowful, and wept."],["8",[["καὶ",707031,7],["ἔθυσαν",706349,150],["κριὸν",707906,6],["προβάτων",710768,44],["καὶ",707031,7],["παρέθηκαν",710111,150],["ὄψα",709903,42],["πλείονα",710514,68]],"And likewise Edna his wife and Sara his daughter wept. Moreover they entertained them cheerfully; and after that they had killed a ram of the flock, they set store of meat on the table. Then said Tobias to Raphael, Brother Azarias, speak of those things of which thou didst talk in the way, and let this business be dispatched."],["9",[["εἶπεν",705373,2],["δὲ",703303,11],