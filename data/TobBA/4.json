[["1",[["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ἐκείνῃ",704183,105],["ἐμνήσθη",708960,37],["Τωβιτ",713044,4],["περὶ",710285,0],["τοῦ",709436,20],["ἀργυρίου",701707,21],["οὗ",709781,160],["παρέθετο",710111,23],["Γαβαηλ",702853,114],["ἐν",704639,0],["Ῥάγοις",711143,111],["τῆς",709436,16],["Μηδίας",708860,17]],"In that day Tobit remembered the money which he had committed to Gabael in Rages of Media,"],["2",[["καὶ",707031,7],["εἶπεν",705373,2],["ἐν",704639,0],["ἑαυτῷ",703917,50],["ἐγὼ",704018,164],["ᾐτησάμην",700489,161],["θάνατον",706096,6],["τί",712867,126],["οὐ",709805,28],["καλῶ",707084,157],["Τωβιαν",713037,6],["τὸν",709436,5],["υἱόν",713075,6],["μου",709032,133],["ἵνα",706747,7],["αὐτῷ",702165,50],["ὑποδείξω",713192,165],["πρὶν",710742,28],["ἀποθανεῖν",701461,106],["με",708618,163]],"and said with himself, I have wished for death; wherefore do I not call for my son Tobias, that I may signify to him [of the money] before I die?"],["3",[["καὶ",707031,7],["καλέσας",707084,182],["αὐτὸν",702165,85],["εἶπεν",705373,2],["παιδίον",709927,297],["ἐὰν",703912,7],["ἀποθάνω",701461,207],["θάψον",706103,176],["με",708618,163],["καὶ",707031,7],["μὴ",708851,28],["ὑπερίδῃς",713154,175],["τὴν",709436,8],["μητέρα",708892,9],["σου",711945,133],["τίμα",712855,240],["αὐτὴν",702165,104],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["τῆς",709436,16],["ζωῆς",705910,17],["σου",711945,133],["καὶ",707031,7],["ποίει",710582,240],["τὸ",709436,24],["ἀρεστὸν",701723,46],["αὐτῇ",702165,105],["καὶ",707031,7],["μὴ",708851,28],["λυπήσῃς",708272,175],["αὐτήν",702165,104]],"And when he had called him, he said, My son, when I am dead, bury me; and despise not thy mother, but honour her all the days of thy life, and do that which shall please her, and grieve her not."],["4",[["μνήσθητι",708960,244],["παιδίον",709927,297],["ὅτι",709803,7],["πολλοὺς",710646,60],["κινδύνους",707678,57],["ἑόρακεν",709725,171],["ἐπὶ",705080,0],["σοὶ",711925,159],["ἐν",704639,0],["τῇ",709436,100],["κοιλίᾳ",707761,1],["ὅταν",709801,28],["ἀποθάνῃ",701461,172],["θάψον",706103,176],["αὐτὴν",702165,104],["παρ᾿",709995,0],["ἐμοὶ",704577,159],["ἐν",704639,0],["ἑνὶ",704106,30],["τάφῳ",712738,114]],"Remember, my son, that she saw many dangers for thee, [when thou wast] in her womb; and when she is dead, bury her by me in one grave."],["5",[["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["παιδίον",709927,297],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["μνημόνευε",708965,240],["καὶ",707031,7],["μὴ",708851,28],["θελήσῃς",706176,175],["ἁμαρτάνειν",700773,55],["καὶ",707031,7],["παραβῆναι",709996,106],["τὰς",709436,38],["ἐντολὰς",704802,39],["αὐτοῦ",702165,102],["δικαιοσύνην",703695,9],["ποίει",710582,240],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["τῆς",709436,16],["ζωῆς",705910,17],["σου",711945,133],["καὶ",707031,7],["μὴ",708851,28],["πορευθῇς",710667,279],["ταῖς",709436,75],["ὁδοῖς",709458,76],["τῆς",709436,16],["ἀδικίας",700271,17]],"My son, be mindful of the Lord our God all thy days, and let not thy will be set to sin, or to transgress his commandments: do uprightly all thy life long, and follow not the ways of unrighteousness."],["6",[["διότι",703734,7],["ποιοῦντός",710582,152],["σου",711945,133],["τὴν",709436,8],["ἀλήθειαν",700656,9],["εὐοδίαι",705652,191],["ἔσονται",704093,135],["ἐν",704639,0],["τοῖς",709436,147],["ἔργοις",705396,96],["σου",711945,133]],"For if thou deal truly, thy doings shall prosperously succeed to thee, and to all them that live justly.",{"s":"d","q":0.65}],["7",[["καὶ",707031,7],["πᾶσι",710177,230],["τοῖς",709436,147],["ποιοῦσι",710582,349],["τὴν",709436,8],["δικαιοσύνην",703695,9],["ἐκ",704132,0],["τῶν",709436,80],["ὑπαρχόντων",713102,170],["σοι",711925,159],["ποίει",710582,240],["ἐλεημοσύνην",704421,9],["καὶ",707031,7],["μὴ",708851,28],["φθονεσάτω",713449,45],["σου",711945,133],["ὁ",709436,3],["ὀφθαλμὸς",709870,4],["ἐν",704639,0],["τῷ",709436,53],["ποιεῖν",710582,55],["σε",711598,163],["ἐλεημοσύνην",704421,9],["μὴ",708851,28],["ἀποστρέψῃς",701598,175],["τὸ",709436,24],["πρόσωπόν",710986,25],["σου",711945,133],["ἀπὸ",701425,0],["παντὸς",710177,116],["πτωχοῦ",711076,18],["καὶ",707031,7],["ἀπὸ",701425,0],["σοῦ",711945,133],["οὐ",709805,28],["μὴ",708851,28],["ἀποστραφῇ",701598,384],["τὸ",709436,34],["πρόσωπον",710986,15],["τοῦ",709436,35],["θεοῦ",706192,18]],"Give alms of thy substance; and when thou givest alms, let not thine eye be envious, neither turn thy face from any poor, and the face of God shall not be turned away from thee."],["8",[["ὡς",714148,7],["σοὶ",711925,159],["ὑπάρχει",713104,91],["κατὰ",707200,0],["τὸ",709436,24],["πλῆθος",710529,25],["ποίησον",710582,176],["ἐξ",704132,0],["αὐτῶν",702165,70],["ἐλεημοσύνην",704421,9],["ἐὰν",703912,7],["ὀλίγον",709568,46],["σοι",711925,159],["ὑπάρχῃ",713104,204],["κατὰ",707200,0],["τὸ",709436,24],["ὀλίγον",709568,46],["μὴ",708851,28],["φοβοῦ",713532,253],["ποιεῖν",710582,55],["ἐλεημοσύνην",704421,9]],"If thou hast abundance, give alms accordingly: if thou have but a little, be not afraid to give according to that little:",{"s":"m","br":"4:7a","q":1.0}],["9",[["θέμα",706178,25],["γὰρ",702963,11],["ἀγαθὸν",700106,46],["θησαυρίζεις",706256,154],["σεαυτῷ",711599,50],["εἰς",704105,0],["ἡμέραν",705984,9],["ἀνάγκης",700925,17]],"for thou layest up a good treasure for thyself against the day of necessity.",{"s":"m","br":"4:7b","q":1.0}],["10",[["διότι",703734,7],["ἐλεημοσύνη",704421,12],["ἐκ",704132,0],["θανάτου",706096,18],["ῥύεται",711314,117],["καὶ",707031,7],["οὐκ",709805,28],["ἐᾷ",703918,91],["εἰσελθεῖν",704114,106],["εἰς",704105,0],["τὸ",709436,24],["σκότος",711889,25]],"Because that alms do deliver from death, and suffereth not to come into darkness.",{"s":"m","br":"4:7c","q":1.0}],["11",[["δῶρον",703907,15],["γὰρ",702963,11],["ἀγαθόν",700106,26],["ἐστιν",704093,91],["ἐλεημοσύνη",704421,12],["πᾶσι",710177,230],["τοῖς",709436,147],["ποιοῦσιν",710582,197],["αὐτὴν",702165,104],["ἐνώπιον",704823,0],["τοῦ",709436,35],["ὑψίστου",713287,116]],"For alms is a good gift unto all that give it in the sight of the most High.",{"s":"m","br":"4:7d","q":1.0}],["12",[["πρόσεχε",710895,240],["σεαυτῷ",711599,50],["παιδίον",709927,297],["ἀπὸ",701425,0],["πάσης",710177,82],["πορνείας",710672,17],["καὶ",707031,7],["γυναῖκα",703209,9],["πρῶτον",711039,28],["λαβὲ",708076,176],["ἀπὸ",701425,0],["τοῦ",709436,20],["σπέρματος",712008,21],["τῶν",709436,80],["πατέρων",710189,81],["σου",711945,133],["μὴ",708851,28],["λάβῃς",708076,175],["γυναῖκα",703209,9],["ἀλλοτρίαν",700699,36],["ἣ",709781,177],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐκ",704132,0],["τῆς",709436,16],["φυλῆς",713620,17],["τοῦ",709436,35],["πατρός",710189,18],["σου",711945,133],["διότι",703734,7],["υἱοὶ",713075,52],["προφητῶν",711009,81],["ἐσμεν",704093,243],["Νωε",709395,4],["Αβρααμ",700091,4],["Ισαακ",706799,4],["Ιακωβ",706401,4],["οἱ",709436,136],["πατέρες",710189,52],["ἡμῶν",705999,145],["ἀπὸ",701425,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["μνήσθητι",708960,244],["παιδίον",709927,297],["ὅτι",709803,7],["οὗτοι",709858,201],["πάντες",710177,138],["ἔλαβον",708076,150],["γυναῖκας",703209,39],["ἐκ",704132,0],["τῶν",709436,80],["ἀδελφῶν",700249,81],["αὐτῶν",702165,40],["καὶ",707031,7],["εὐλογήθησαν",705631,144],["ἐν",704639,0],["τοῖς",709436,95],["τέκνοις",712761,96],["αὐτῶν",702165,40],["καὶ",707031,7],["τὸ",709436,24],["σπέρμα",712008,25],["αὐτῶν",702165,40],["κληρονομήσει",707724,127],["γῆν",703083,9]],"Beware of all whoredom, my son, and chiefly take a wife of the seed of thy fathers, and take not a strange woman to wife, which is not of thy father's tribe: for we are the children of the prophets, Noe, Abraham, Isaac, and Jacob. Remember, my son, that our fathers from the beginning, even that they all married wives of their own kindred, and were blessed in their children, and their seed shall inherit the land.",{"s":"m","br":"4:7e","q":0.97}],["13",[["καὶ",707031,7],["νῦν",709384,28],["παιδίον",709927,297],["ἀγάπα",700120,240],["τοὺς",709436,58],["ἀδελφούς",700249,57],["σου",711945,133],["καὶ",707031,7],["μὴ",708851,28],["ὑπερηφανεύου",713135,300],["τῇ",709436,100],["καρδίᾳ",707141,1],["σου",711945,133],["ἀπὸ",701425,0],["τῶν",709436,80],["ἀδελφῶν",700249,81],["σου",711945,133],["καὶ",707031,7],["τῶν",709436,80],["υἱῶν",713075,81],["καὶ",707031,7],["θυγατέρων",706320,65],["τοῦ",709436,35],["λαοῦ",708094,18],["σου",711945,133],["λαβεῖν",708076,106],["σεαυτῷ",711599,50],["ἐξ",704132,0],["αὐτῶν",702165,284],["γυναῖκα",703209,9],["διότι",703734,7],["ἐν",704639,0],["τῇ",709436,100],["ὑπερηφανίᾳ",713138,1],["ἀπώλεια",701660,12],["καὶ",707031,7],["ἀκαταστασία",700530,12],["πολλή",710646,29],["καὶ",707031,7],["ἐν",704639,0],["τῇ",709436,100],["ἀχρειότητι",702310,1],["ἐλάττωσις",704396,12],["καὶ",707031,7],["ἔνδεια",704672,12],["μεγάλη",708653,29],["ἡ",709436,10],["γὰρ",702963,11],["ἀχρειότης",702310,12],["μήτηρ",708892,12],["ἐστὶν",704093,91],["τοῦ",709436,35],["λιμοῦ",708210,18]],"Now therefore, my son, love thy brethren, and despise not in thy heart thy brethren, the sons and daughters of thy people, in [not] taking a wife of them: for in pride is destruction and much trouble, and in lewdness is decay and great want: for lewdness is the mother of famine.",{"s":"m","br":"4:7f","q":0.98}],["14",[["μισθὸς",708939,4],["παντὸς",710177,116],["ἀνθρώπου",701163,18],["ὃς",709781,213],["ἐὰν",703912,7],["ἐργάσηται",705383,239],["παρὰ",709995,0],["σοὶ",711925,159],["μὴ",708851,28],["αὐλισθήτω",702138,22],["ἀλλὰ",700680,7],["ἀπόδος",701449,176],["αὐτῷ",702165,50],["παραυτίκα",710113,28],["καὶ",707031,7],["ἐὰν",703912,7],["δουλεύσῃς",703814,175],["τῷ",709436,113],["θεῷ",706192,114],["ἀποδοθήσεταί",701449,134],["σοι",711925,159],["πρόσεχε",710895,240],["σεαυτῷ",711599,50],["παιδίον",709927,297],["ἐν",704639,0],["πᾶσι",710177,94],["τοῖς",709436,95],["ἔργοις",705396,96],["σου",711945,133],["καὶ",707031,7],["ἴσθι",709492,656],["πεπαιδευμένος",709926,419],["ἐν",704639,0],["πάσῃ",710177,101],["ἀναστροφῇ",701061,1],["σου",711945,133]],"Let not the wages of any man, which hath wrought for thee, tarry with thee, but give him it out of hand: for if thou serve God, he will also repay thee: be circumspect, my son, in all things thou doest, and be wise in all thy conversation.",{"s":"m","br":"4:7g","q":0.92}],["15",[["καὶ",707031,7],["ὃ",709781,213],["μισεῖς",708935,154],["μηδενὶ",708857,30],["ποιήσῃς",710582,175],["οἶνον",709530,6],["εἰς",704105,0],["μέθην",708667,9],["μὴ",708851,28],["πίῃς",710478,175],["καὶ",707031,7],["μὴ",708851,28],["πορευθήτω",710667,22],["μετὰ",708780,0],["σοῦ",711945,133],["μέθη",708667,12],["ἐν",704639,0],["τῇ",709436,100],["ὁδῷ",709458,1],["σου",711945,133]],"Do that to no man which thou hatest: drink not wine to make thee drunken: neither let drunkenness go with thee in thy journey.",{"s":"m","br":"4:7h","q":1.0}],["16",[["ἐκ",704132,0],["τοῦ",709436,35],["ἄρτου",701829,18],["σου",711945,133],["δίδου",703654,240],["πεινῶντι",710222,379],["καὶ",707031,7],["ἐκ",704132,0],["τῶν",709436,43],["ἱματίων",706742,44],["σου",711945,133],["τοῖς",709436,147],["γυμνοῖς",703202,230],["πᾶν",710177,26],["ὃ",709781,33],["ἐὰν",703912,7],["περισσεύσῃ",710386,240],["σοι",711925,159],["ποίει",710582,240],["ἐλεημοσύνην",704421,9],["καὶ",707031,7],["μὴ",708851,28],["φθονεσάτω",713449,45],["σου",711945,133],["ὁ",709436,3],["ὀφθαλμὸς",709870,4],["ἐν",704639,0],["τῷ",709436,53],["ποιεῖν",710582,55],["σε",711598,163],["ἐλεημοσύνην",704421,9]],"Give of thy bread to the hungry, and of thy garments to them that are naked; and according to thine abundance give alms; and let not thine eye be envious, when thou givest alms.",{"s":"m","br":"4:7i","q":1.0}],["17",[["ἔκχεον",704368,176],["τοὺς",709436,58],["ἄρτους",701829,57],["σου",711945,133],["ἐπὶ",705080,0],["τὸν",709436,5],["τάφον",712738,6],["τῶν",709436,80],["δικαίων",703694,169],["καὶ",707031,7],["μὴ",708851,28],["δῷς",703654,175],["τοῖς",709436,147],["ἁμαρτωλοῖς",700776,230]],"Pour out thy bread on the burial of the just, but give nothing to the wicked.",{"s":"m","br":"4:7k","q":1.0}],["18",[["συμβουλίαν",712293,9],["παρὰ",709995,0],["παντὸς",710177,116],["φρονίμου",713589,116],["ζήτησον",705879,176],["καὶ",707031,7],["μὴ",708851,28],["καταφρονήσῃς",707482,175],["ἐπὶ",705080,0],["πάσης",710177,82],["συμβουλίας",712293,17],["χρησίμης",713953,82]],null],["19",[["καὶ",707031,7],["ἐν",704639,0],["παντὶ",710177,30],["καιρῷ",707047,114],["εὐλόγει",705631,240],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["καὶ",707031,7],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["αἴτησον",700489,176],["ὅπως",709719,7],["αἱ",709436,190],["ὁδοί",709458,191],["σου",711945,133],["εὐθεῖαι",705602,192],["γένωνται",703104,232],["καὶ",707031,7],["πᾶσαι",710177,192],["αἱ",709436,190],["τρίβοι",712940,301],["καὶ",707031,7],["βουλαὶ",702792,191],["εὐοδωθῶσιν",705654,272],["διότι",703734,7],["πᾶν",710177,26],["ἔθνος",704068,15],["οὐκ",709805,28],["ἔχει",705785,91],["βουλήν",702792,9],["ἀλλὰ",700680,7],["αὐτὸς",702165,121],["ὁ",709436,3],["κύριος",707996,4],["δίδωσιν",703654,91],["πάντα",710177,68],["τὰ",709436,41],["ἀγαθὰ",700106,68],["καὶ",707031,7],["ὃν",709781,112],["ἐὰν",703912,7],["θέλῃ",706176,204],["ταπεινοῖ",712717,204],["καθὼς",707030,28],["βούλεται",702795,117],["καὶ",707031,7],["νῦν",709384,28],["παιδίον",709927,297],["μνημόνευε",708965,240],["τῶν",709436,130],["ἐντολῶν",704802,65],["μου",709032,133],["καὶ",707031,7],["μὴ",708851,28],["ἐξαλειφθήτωσαν",704852,51],["ἐκ",704132,0],["τῆς",709436,16],["καρδίας",707141,17],["σου",711945,133]],"Bless the Lord thy God alway, and desire of him that thy ways may be directed, and that all thy paths and counsels may prosper: for every nation hath not counsel; but the Lord himself giveth all good things, and he humbleth whom he will, as he will; now therefore, my son, remember my commandments, neither let them be put out of thy mind."],["20",[["καὶ",707031,7],["νῦν",709384,28],["ὑποδεικνύω",713192,438],["σοι",711925,159],["τὰ",709436,41],["δέκα",703333,59],["τάλαντα",712697,42],["τοῦ",709436,20],["ἀργυρίου",701707,21],["ἃ",709781,69],["παρεθέμην",710111,334],["Γαβαήλῳ",702854,114],["τῷ",709436,113],["τοῦ",709436,35],["Γαβρια",702869,18],["ἐν",704639,0],["Ῥάγοις",711143,111],["τῆς",709436,16],["Μηδίας",708856,17]],"And now I signify this to thee, that I committed ten talents to Gabael the [son] of Gabrias at Rages in Media."],["21",[["καὶ",707031,7],["μὴ",708851,28],["φοβοῦ",713532,253],["παιδίον",709927,297],["ὅτι",709803,7],["ἐπτωχεύσαμεν",711074,289],["ὑπάρχει",713104,91],["σοι",711925,159],["πολλά",710646,195],["ἐὰν",703912,7],["φοβηθῇς",713532,279],["τὸν",709436,5],["θεὸν",706192,6],["καὶ",707031,7],["ἀποστῇς",702214,175],["ἀπὸ",701425,0],["πάσης",710177,82],["ἁμαρτίας",700775,17],["καὶ",707031,7],["ποιήσῃς",710582,175],["τὸ",709436,24],["ἀρεστὸν",701723,46],["ἐνώπιον",704823,0],["αὐτοῦ",702165,102]],"And fear not, my son, that we are made poor: for thou hast much wealth, if thou fear God, and depart from all sin, and do that which is pleasing in his sight."]]