705785,240],["ὅτι",709803,7],["τὴν",709436,8],["νύκτα",709386,9],["ταύτην",709858,104],["δοθήσεταί",703654,134],["σοι",711925,159],["αὕτη",709858,107],["εἰς",704105,0],["γυναῖκα",703209,9]],"And when thou shalt come into the marriage chamber, thou shalt take the ashes of perfume, and shalt lay upon them some of the heart and liver of the fish, and shalt make a smoke with it:"],["17",[["καὶ",707031,7],["ἐὰν",703912,7],["εἰσέλθῃς",704114,175],["εἰς",704105,0],["τὸν",709436,5],["νυμφῶνα",709383,6],["λήμψῃ",708076,123],["τέφραν",712827,9],["θυμιαμάτων",706330,44],["καὶ",707031,7],["ἐπιθήσεις",705304,166],["ἀπὸ",701425,0],["τῆς",709436,16],["καρδίας",707141,17],["καὶ",707031,7],["τοῦ",709436,20],["ἥπατος",706012,21],["τοῦ",709436,35],["ἰχθύος",706870,18],["καὶ",707031,7],["καπνίσεις",707131,166],["καὶ",707031,7],["ὀσφρανθήσεται",709798,134],["τὸ",709436,34],["δαιμόνιον",703249,15],["καὶ",707031,7],["φεύξεται",713433,93],["καὶ",707031,7],["οὐκ",709805,28],["ἐπανελεύσεται",705023,93],["τὸν",709436,5],["αἰῶνα",700504,6],["τοῦ",709436,35],["αἰῶνος",700504,18]],"and the devil shall smell it, and flee away, and never come again any more: but when thou shalt come to her, rise up both of you, and pray to God which is merciful, who will have pity on you, and save you: fear not, for she is appointed unto thee from the beginning; and thou shalt preserve her, and she shall go with thee. Moreover I suppose that she shall bear thee children. Now when Tobias had heard these things, he loved her, and his heart was effectually joined to her. And he came to Ecbatane."],["18",[["ὅταν",709801,28],["δὲ",703303,11],["προσπορεύῃ",710954,204],["αὐτῇ",702165,105],["ἐγέρθητε",703949,394],["ἀμφότεροι",700892,138],["καὶ",707031,7],["βοήσατε",702743,74],["πρὸς",710844,0],["τὸν",709436,5],["ἐλεήμονα",704422,27],["θεόν",706192,6],["καὶ",707031,7],["σώσει",712627,127],["ὑμᾶς",713080,194],["καὶ",707031,7],["ἐλεήσει",704418,127],["μὴ",708851,28],["φοβοῦ",713532,253],["ὅτι",709803,7],["σοὶ",711925,159],["αὐτὴ",702165,107],["ἡτοιμασμένη",705539,203],["ἦν",704093,13],["ἀπὸ",701425,0],["τοῦ",709436,35],["αἰῶνος",700504,18],["καὶ",707031,7],["σὺ",712181,164],["αὐτὴν",702165,104],["σώσεις",712627,166],["καὶ",707031,7],["πορεύσεται",710667,93],["μετὰ",708780,0],["σοῦ",711945,133],["καὶ",707031,7],["ὑπολαμβάνω",713210,157],["ὅτι",709803,7],["σοὶ",711925,159],["ἔσται",704093,93],["ἐξ",704132,0],["αὐτῆς",702165,86],["παιδία",709927,64]],null],["19",[["καὶ",707031,7],["ὡς",714148,28],["ἤκουσεν",700587,2],["Τωβιας",713037,4],["ταῦτα",709858,71],["ἐφίλησεν",713471,2],["αὐτήν",702165,104],["καὶ",707031,7],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτοῦ",702165,102],["ἐκολλήθη",707791,37],["αὐτῇ",702165,105],["σφόδρα",712586,28]],null]]