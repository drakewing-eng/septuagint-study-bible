[["1",[["οἱ",709436,136],["δὲ",703303,11],["πορευόμενοι",710667,348],["τὴν",709436,8],["ὁδὸν",709458,9],["ἦλθον",705453,150],["ἑσπέρας",705500,17],["ἐπὶ",705080,0],["τὸν",709436,5],["Τίγριν",712848,6],["ποταμὸν",710693,6],["καὶ",707031,7],["ηὐλίζοντο",702138,139],["ἐκεῖ",704181,28]],"And as they went on their journey, they came in the evening to the river Tigris, and they lodged there."],["2",[["τὸ",709436,34],["δὲ",703303,11],["παιδάριον",709923,15],["κατέβη",707202,2],["περικλύσασθαι",710334,109],["καὶ",707031,7],["ἀνεπήδησεν",701031,2],["ἰχθὺς",706870,4],["ἀπὸ",701425,0],["τοῦ",709436,35],["ποταμοῦ",710693,18],["καὶ",707031,7],["ἐβουλήθη",702795,37],["καταπιεῖν",707374,106],["τὸ",709436,24],["παιδάριον",709923,25]],"And when the young man went down to wash himself, a fish leaped out of the river, and would have devoured him."],["3",[["ὁ",709436,3],["δὲ",703303,11],["ἄγγελος",700140,4],["εἶπεν",705373,2],["αὐτῷ",702165,50],["ἐπιλαβοῦ",705185,176],["τοῦ",709436,35],["ἰχθύος",706870,18],["καὶ",707031,7],["ἐκράτησεν",707879,2],["τὸν",709436,5],["ἰχθὺν",706870,6],["τὸ",709436,34],["παιδάριον",709923,15],["καὶ",707031,7],["ἀνέβαλεν",700906,2],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["τὴν",709436,8],["γῆν",703083,9]],"Then the angel said unto him, Take the fish. And the young man laid hold of the fish, and drew it to land."],["4",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["ὁ",709436,3],["ἄγγελος",700140,4],["ἀνάτεμε",701067,240],["τὸν",709436,5],["ἰχθὺν",706870,6],["καὶ",707031,7],["λαβὼν",708076,182],["τὴν",709436,8],["καρδίαν",707141,9],["καὶ",707031,7],["τὸ",709436,24],["ἧπαρ",706012,25],["καὶ",707031,7],["τὴν",709436,8],["χολὴν",713900,9],["θὲς",712849,176],["ἀσφαλῶς",702045,28]],"To whom the angel said, Open the fish, and take the heart and the liver and the gall, and put them up safely."],["5",[["καὶ",707031,7],["ἐποίησεν",710582,2],["τὸ",709436,34],["παιδάριον",709923,15],["ὡς",714148,28],["εἶπεν",705373,2],["αὐτῷ",702165,50],["ὁ",709436,3],["ἄγγελος",700140,4],["τὸν",709436,5],["δὲ",703303,11],["ἰχθὺν",706870,6],["ὀπτήσαντες",709715,196],["ἔφαγον",713296,150]],"So the young man did as the angel commanded him; and when they had roasted the fish, they did eat it: then they both went on their way, till they drew near to Ecbatane."],["6",[["καὶ",707031,7],["ὥδευον",709447,137],["ἀμφότεροι",700892,138],["ἕως",705792,7],["ἤγγισαν",703939,150],["ἐν",704639,0],["Ἐκβατάνοις",704147,111]],"Then the young man said to the angel, Brother Azarias, to what use is the heart and the liver and the gall of the fish?"],["7",[["καὶ",707031,7],["εἶπεν",705373,2],["τὸ",709436,34],["παιδάριον",709923,15],["τῷ",709436,113],["ἀγγέλῳ",700140,114],["Αζαρια",700328,153],["ἄδελφε",700249,153],["τί",712867,126],["ἐστιν",704093,91],["τὸ",709436,34],["ἧπαρ",706012,15],["καὶ",707031,7],["ἡ",709436,10],["καρδία",707141,12],["καὶ",707031,7],["ἡ",709436,10],["χολὴ",713900,12],["τοῦ",709436,35],["ἰχθύος",706870,18]],"And he said unto him, Touching the heart and the liver, if a devil or an evil spirit trouble any, we must make a smoke thereof before the man or the woman, and the party shall be no more vexed."],["8",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["ἡ",709436,10],["καρδία",707141,12],["καὶ",707031,7],["τὸ",709436,34],["ἧπαρ",706012,15],["ἐάν",703912,7],["τινα",712866,356],["ὀχλῇ",709883,204],["δαιμόνιον",703249,15],["ἢ",705924,7],["πνεῦμα",710566,15],["πονηρόν",710660,14],["ταῦτα",709858,71],["δεῖ",703312,91],["καπνίσαι",707131,106],["ἐνώπιον",704823,0],["ἀνθρώπου",701163,18],["ἢ",705924,7],["γυναικός",703209,17],["καὶ",707031,7],["οὐκέτι",709827,28],["οὐ",709805,28],["μὴ",708851,28],["ὀχληθῇ",709883,384]],"As for the gall, [it is good] to anoint a man that hath whiteness in his eyes, and he shall be healed."],["9",[["ἡ",709436,10],["δὲ",703303,11],["χολή",713900,12],["ἐγχρῖσαι",704015,106],["ἄνθρωπον",701163,6],["ὃς",709781,213],["ἔχει",705785,91],["λευκώματα",708167,42],["ἐν",704639,0],["τοῖς",709436,147],["ὀφθαλμοῖς",709870,148],["καὶ",707031,7],["ἰαθήσεται",706424,134]],"And when they were come near to Rages,"],["10",[["ὡς",714148,7],["δὲ",703303,11],["προσήγγισαν",710878,150],["τῇ",709436,100],["Ραγη",711140,1]],"the angel said to the young man, Brother, to day we shall lodge with Raguel, who is thy cousin; he also hath one only daughter, named Sara; I will speak for her, that she may be given thee for a wife."],["11",[["εἶπεν",705373,2],["ὁ",709436,3],["ἄγγελος",700140,4],["τῷ",709436,53],["παιδαρίῳ",709923,54],["ἄδελφε",700249,297],["σήμερον",711751,28],["αὐλισθησόμεθα",702138,347],["παρὰ",709995,0],["Ραγουηλ",711144,6],["καὶ",707031,7],["αὐτὸς",702165,121],["συγγενής",712185,14],["σού",711945,133],["ἐστιν",704093,91],["καὶ",707031,7],["ἔστιν",704093,91],["αὐτῷ",702165,50],["θυγάτηρ",706320,12],["μονογενὴς",708996,29],["ὀνόματι",709666,54],["Σαρρα",711541,12]],"For to thee doth the right of her appertain, seeing thou only art of her kindred."],["12",[["λαλήσω",708071,165],["περὶ",710285,0],["αὐτῆς",702165,86],["τοῦ",709436,20],["δοθῆναί",703654,179],["σοι",711925,159],["αὐτὴν",702165,104],["εἰς",704105,0],["γυναῖκα",703209,9],["ὅτι",709803,7],["σοὶ",711925,159],["ἐπιβάλλει",705083,91],["ἡ",709436,10],["κληρονομία",707725,12],["αὐτῆς",702165,86],["καὶ",707031,7],["σὺ",712181,164],["μόνος",709003,14],["εἶ",704093,154],["ἐκ",704132,0],["τοῦ",709436,20],["γένους",703057,21],["αὐτῆς",702165,86],["καὶ",707031,7],["τὸ",709436,34],["κοράσιον",707832,15],["καλὸν",707097,26],["καὶ",707031,7],["φρόνιμόν",713589,26],["ἐστιν",704093,91]],"And the maid is fair and wise: now therefore hear me, and I will speak to her father; and when we return from Rages we will celebrate the marriage: for I know that Raguel cannot marry her to another according to the law of Moses, but he shall be guilty of death, because the right of inheritance doth rather appertain to thee than to any other."],["13",[["καὶ",707031,7],["νῦν",709384,28],["ἄκουσόν",700587,176],["μου",709032,133],["καὶ",707031,7],["λαλήσω",708071,165],["τῷ",709436,113],["πατρὶ",710189,114],["αὐτῆς",702165,86],["καὶ",707031,7],["ὅταν",709801,28],["ὑποστρέψωμεν",713246,79],["ἐκ",704132,0],["Ῥάγων",711143,118],["ποιήσομεν",710582,275],["τὸν",709436,5],["γάμον",702957,6],["διότι",703734,7],["ἐπίσταμαι",705264,254],["Ραγουηλ",711144,6],["ὅτι",709803,7],["οὐ",709805,28],["μὴ",708851,28],["δῷ",703654,172],["αὐτὴν",702165,104],["ἀνδρὶ",701150,114],["ἑτέρῳ",705535,30],["κατὰ",707200,0],["τὸν",709436,5],["νόμον",709349,6],["Μωυσῆ",709112,18],["ἢ",705924,7],["ὀφειλέσει",709865,127],["θάνατον",706096,6],["ὅτι",709803,7],["τὴν",709436,8],["κληρονομίαν",707725,9],["σοὶ",711925,159],["καθήκει",706998,91],["λαβεῖν",708076,106],["ἢ",705924,7],["πάντα",710177,27],["ἄνθρωπον",701163,6]],"Then the young man answered the angel, I have heard, brother Azarias, that this maid hath been given to seven men, who all died in the marriage chamber."],["14",[["τότε",712908,28],["εἶπεν",705373,2],["τὸ",709436,34],["παιδάριον",709923,15],["τῷ",709436,113],["ἀγγέλῳ",700140,114],["Αζαρια",700328,153],["ἄδελφε",700249,153],["ἀκήκοα",700587,89],["ἐγὼ",704018,164],["τὸ",709436,24],["κοράσιον",707832,25],["δεδόσθαι",703654,431],["ἑπτὰ",705357,59],["ἀνδράσιν",701150,148],["καὶ",707031,7],["πάντας",710177,60],["ἐν",704639,0],["τῷ",709436,113],["νυμφῶνι",709383,114],["ἀπολωλότας",701513,277]],"And now I am the only son of my father, and I am afraid, lest, if I go in unto her, I die, as the others before: for a wicked spirit loveth her, which hurteth no one except those which come unto her: wherefore I also fear lest I die, and bring my father's and my mother's life because of me to the grave with sorrow: for they have no other son to bury them."],["15",[["καὶ",707031,7],["νῦν",709384,28],["ἐγὼ",704018,164],["μόνος",709003,14],["εἰμὶ",704093,157],["τῷ",709436,113],["πατρὶ",710189,114],["καὶ",707031,7],["φοβοῦμαι",713532,254],["μὴ",708851,28],["εἰσελθὼν",704114,182],["ἀποθάνω",701461,207],["καθὼς",707030,28],["καὶ",707031,28],["οἱ",709436,136],["πρότ