[["1",[["καὶ",707031,7],["Τωβιτ",713044,4],["ὁ",709436,3],["πατὴρ",710189,4],["αὐτοῦ",702165,102],["ἐλογίζετο",708232,19],["ἑκάστης",704133,82],["ἡμέρας",705984,17],["καὶ",707031,7],["ὡς",714148,28],["ἐπληρώθησαν",710543,99],["αἱ",709436,190],["ἡμέραι",705984,191],["τῆς",709436,16],["πορείας",710665,17],["καὶ",707031,7],["οὐκ",709805,28],["ἤρχοντο",705453,139]],"Now Tobit his father counted every day: and when the days of the journey were expired, and they came not,"],["2",[["εἶπεν",705373,2],["μήποτε",708882,28],["κατῄσχυνται",707257,255],["ἢ",705924,7],["μήποτε",708882,28],["ἀπέθανεν",701461,2],["Γαβαηλ",702853,4],["καὶ",707031,7],["οὐδεὶς",709817,14],["δίδωσιν",703654,91],["αὐτῷ",702165,50],["τὸ",709436,24],["ἀργύριον",701707,25]],"then Tobit said, Are they detained? or is Gabael dead, and there is no man to give him the money?"],["3",[["καὶ",707031,7],["ἐλυπεῖτο",708272,19],["λίαν",708184,28]],"Therefore he was very sorry."],["4",[["εἶπεν",705373,2],["δὲ",703303,11],["αὐτῷ",702165,50],["ἡ",709436,10],["γυνή",703209,12],["ἀπώλετο",701513,23],["τὸ",709436,34],["παιδίον",709927,15],["διότι",703734,7],["κεχρόνικεν",713967,171],["καὶ",707031,7],["ἤρξατο",701860,23],["θρηνεῖν",706306,55],["αὐτὸν",702165,85],["καὶ",707031,7],["εἶπεν",705373,2]],"Then his wife said unto him, My son is dead, seeing he stayeth long; and she began to bewail him, and said,"],["5",[["οὐ",709805,28],["μέλει",708696,91],["μοι",708974,159],["τέκνον",712761,297],["ὅτι",709803,7],["ἀφῆκά",702211,155],["σε",711598,163],["τὸ",709436,24],["φῶς",713642,25],["τῶν",709436,80],["ὀφθαλμῶν",709870,81],["μου",709032,133]],"Now I care for nothing, my son, since I have let thee go, the light of mine eyes."],["6",[["καὶ",707031,7],["Τωβιτ",713044,4],["λέγει",708124,91],["αὐτῇ",702165,105],["σίγα",711767,240],["μὴ",708851,28],["λόγον",708236,6],["ἔχε",705785,240],["ὑγιαίνει",713057,91]],"To whom Tobit said, Hold thy peace, take no care, for he is safe."],["7",[["καὶ",707031,7],["εἶπεν",705373,2],["αὐτῷ",702165,50],["σίγα",711767,240],["μὴ",708851,28],["πλάνα",710495,240],["με",708618,163],["ἀπώλετο",701513,23],["τὸ",709436,34],["παιδίον",709927,15],["μου",709032,133],["καὶ",707031,7],["ἐπορεύετο",710667,19],["καθ᾿",707200,0],["ἡμέραν",705984,9],["εἰς",704105,0],["τὴν",709436,8],["ὁδὸν",709458,9],["ἔξω",704983,28],["οἵας",709535,82],["ἀπῆλθεν",701398,2],["ἡμέρας",705984,17],["τε",712751,11],["ἄρτον",701829,6],["οὐκ",709805,28],["ἤσθιεν",705495,13],["τὰς",709436,38],["δὲ",703303,11],["νύκτας",709386,39],["οὐ",709805,28],["διελίμπανεν",703500,13],["θρηνοῦσα",706306,188],["Τωβιαν",713037,6],["τὸν",709436,5],["υἱὸν",713075,6],["αὐτῆς",702165,86],["ἕως",705792,7],["οὗ",709781,48],["συνετελέσθησαν",712510,99],["αἱ",709436,190],["δέκα",703333,59],["τέσσαρες",712808,138],["ἡμέραι",705984,191],["τοῦ",709436,35],["γάμου",702957,18],["ἃς",709781,193],["ὤμοσεν",709620,2],["Ραγουηλ",711144,4],["ποιῆσαι",710582,106],["αὐτὸν",702165,85],["ἐκεῖ",704181,28]],"But she said, Hold thy peace, and deceive me not; my son is dead. And she went out every day into the way which they went, and did eat no meat in the daytime, and ceased not whole nights to bewail her son Tobias, until the fourteen days of the wedding were expired, which Raguel had sworn that he should spend there. Then Tobias said to Raguel,"],["8",[["εἶπεν",705373,2],["δὲ",703303,11],["Τωβιας",713037,4],["τῷ",709436,113],["Ραγουηλ",711144,114],["ἐξαπόστειλόν",704872,176],["με",708618,163],["ὅτι",709803,7],["ὁ",709436,3],["πατήρ",710189,4],["μου",709032,133],["καὶ",707031,7],["ἡ",709436,10],["μήτηρ",708892,12],["μου",709032,133],["οὐκέτι",709827,28],["ἐλπίζουσιν",704529,197],["ὄψεσθαί",709725,492],["με",708618,163]],"Let me go, for my father and my mother look no more to see me."],["9",[["εἶπεν",705373,2],["δὲ",703303,11],["αὐτῷ",702165,50],["ὁ",709436,3],["πενθερὸς",710250,4],["αὐτοῦ",702165,102],["μεῖνον",708736,176],["παρ᾿",709995,0],["ἐμοί",704577,159],["κἀγὼ",706969,288],["ἐξαποστελῶ",704872,165],["πρὸς",710844,0],["τὸν",709436,5],["πατέρα",710189,6],["σου",711945,133],["καὶ",707031,7],["δηλώσουσιν",703402,218],["αὐτῷ",702165,50],["τὰ",709436,41],["κατὰ",707200,0],["σέ",711598,163],["καὶ",707031,7],["Τωβιας",713037,4],["λέγει",708124,91],["οὐχί",709862,28],["ἀλλὰ",700680,7],["ἐξαπόστειλόν",704872,176],["με",708618,163],["πρὸς",710844,0],["τὸν",709436,5],["πατέρα",710189,6],["μου",709032,133]],"But his father in law said unto him, Tarry with me, and I will send to thy father, and they shall declare unto him how things go with thee."],["10",[["ἀναστὰς",701173,182],["δὲ",703303,11],["Ραγουηλ",711144,4],["ἔδωκεν",703654,2],["αὐτῷ",702165,50],["Σαρραν",711541,9],["τὴν",709436,8],["γυναῖκα",703209,9],["αὐτοῦ",702165,102],["καὶ",707031,7],["τὰ",709436,41],["ἥμισυ",705998,46],["τῶν",709436,43],["ὑπαρχόντων",713102,84],["σώματα",712635,42],["καὶ",707031,7],["κτήνη",707934,42],["καὶ",707031,7],["ἀργύριον",701707,25]],"But Tobias said, No; but let me go to my father."],["11",[["καὶ",707031,7],["εὐλογήσας",705631,182],["αὐτοὺς",702165,62],["ἐξαπέστειλεν",704872,2],["λέγων",708124,72],["εὐοδώσει",705654,127],["ὑμᾶς",713080,194],["τέκνα",712761,589],["ὁ",709436,3],["θεὸς",706192,4],["τοῦ",709436,35],["οὐρανοῦ",709844,18],["πρὸ",710747,0],["τοῦ",709436,20],["με",708618,163],["ἀποθανεῖν",701461,106]],"Then Raguel arose, and gave him Sara his wife, and half his goods, servants, and cattle, and money:"],["12",[["καὶ",707031,7],["εἶπεν",705373,2],["τῇ",709436,100],["θυγατρὶ",706320,1],["αὐτοῦ",702165,102],["τίμα",712855,240],["τοὺς",709436,58],["πενθερούς",710250,57],["σου",711945,133],["αὐτοὶ",702165,201],["νῦν",709384,28],["γονεῖς",703169,52],["σού",711945,133],["εἰσιν",704093,197],["ἀκούσαιμί",700587,346],["σου",711945,133],["ἀκοὴν",700561,9],["καλήν",707097,36],["καὶ",707031,7],["ἐφίλησεν",713471,2],["αὐτήν",702165,104]],"and he blessed them, and sent them away, saying, The God of heaven give you a prosperous journey, my children."],["13",[["καὶ",707031,7],["Εδνα",704034,12],["εἶπεν",705373,2],["πρὸς",7