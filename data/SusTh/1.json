[["1",[["καὶ",707031,7],["ἦν",704093,13],["ἀνὴρ",701150,4],["οἰκῶν",709499,72],["ἐν",704639,0],["Βαβυλῶνι",702352,1],["καὶ",707031,7],["ὄνομα",709666,15],["αὐτῷ",702165,50],["Ιωακιμ",706887,4]],"There dwelt a man in Babylon, called Joacim:"],["2",[["καὶ",707031,7],["ἔλαβεν",708076,2],["γυναῖκα",703209,9],["ᾗ",709781,108],["ὄνομα",709666,25],["Σουσαννα",711971,12],["θυγάτηρ",706320,12],["Χελκιου",713816,18],["καλὴ",707097,29],["σφόδρα",712586,28],["καὶ",707031,7],["φοβουμένη",713532,211],["τὸν",709436,5],["κύριον",707996,6]],"and he took a wife, whose name was Susanna, the daughter of Chelcias, a very fair woman, and one that feared the Lord."],["3",[["καὶ",707031,7],["οἱ",709436,136],["γονεῖς",703169,52],["αὐτῆς",702165,86],["δίκαιοι",703694,138],["καὶ",707031,7],["ἐδίδαξαν",703649,150],["τὴν",709436,8],["θυγατέρα",706320,9],["αὐτῶν",702165,40],["κατὰ",707200,0],["τὸν",709436,5],["νόμον",709349,6],["Μωυσῆ",709112,18]],"Her parents also were righteous, and taught their daughter according to the law of Moses."],["4",[["καὶ",707031,7],["ἦν",704093,13],["Ιωακιμ",706887,4],["πλούσιος",710560,14],["σφόδρα",712586,28],["καὶ",707031,7],["ἦν",704093,13],["αὐτῷ",702165,50],["παράδεισος",710012,4],["γειτνιῶν",703015,72],["τῷ",709436,113],["οἴκῳ",709516,114],["αὐτοῦ",702165,102],["καὶ",707031,7],["πρὸς",710844,0],["αὐτὸν",702165,85],["προσήγοντο",710848,139],["οἱ",709436,136],["Ιουδαῖοι",706772,52],["διὰ",703417,0],["τὸ",709436,24],["εἶναι",704093,55],["αὐτὸν",702165,85],["ἐνδοξότερον",704694,61],["πάντων",710177,169]],"Now Joacim was a very rich man, and had a fair garden joining unto his house; and to him resorted the Jews; because he was more honourable than all others."],["5",[["καὶ",707031,7],["ἀπεδείχθησαν",701438,99],["δύο",703849,543],["πρεσβύτεροι",710735,52],["ἐκ",704132,0],["τοῦ",709436,35],["λαοῦ",708094,18],["κριταὶ",707910,52],["ἐν",704639,0],["τῷ",709436,113],["ἐνιαυτῷ",704745,114],["ἐκείνῳ",704183,50],["περὶ",710285,0],["ὧν",709781,252],["ἐλάλησεν",708071,2],["ὁ",709436,3],["δεσπότης",703379,4],["ὅτι",709803,7],["ἐξῆλθεν",704909,2],["ἀνομία",701192,12],["ἐκ",704132,0],["Βαβυλῶνος",702352,17],["ἐκ",704132,0],["πρεσβυτέρων",710735,81],["κριτῶν",707910,81],["οἳ",709781,250],["ἐδόκουν",703775,137],["κυβερνᾶν",707946,55],["τὸν",709436,5],["λαόν",708094,6]],"The same year were appointed two of the ancients of the people to be judges, such as the Lord spake of, that wickedness came from Babylon from ancient judges, who seemed to govern the people."],["6",[["οὗτοι",709858,201],["προσεκαρτέρουν",710913,137],["ἐν",704639,0],["τῇ",709436,100],["οἰκίᾳ",709505,1],["Ιωακιμ",706887,18],["καὶ",707031,7],["ἤρχοντο",705453,139],["πρὸς",710844,0],["αὐτοὺς",702165,62],["πάντες",710177,138],["οἱ",709436,136],["κρινόμενοι",707905,348]],"These kept much at Joacim's house, and all that had any suits in law came unto them."],["7",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἡνίκα",706008,28],["ἀπέτρεχεν",701623,13],["ὁ",709436,3],["λαὸς",708094,4],["μέσον",708768,27],["ἡμέρας",705984,17],["εἰσεπορεύετο",704124,19],["Σουσαννα",711971,12],["καὶ",707031,7],["περιεπάτει",710362,13],["ἐν",704639,0],["τῷ",709436,113],["παραδείσῳ",710012,114],["τοῦ",709436,35],["ἀνδρὸς",701150,18],["αὐτῆς",702165,86]],"Now when the people departed away at noon, Susanna went into her husband's garden to walk."],["8",[["καὶ",707031,7],["ἐθεώρουν",706226,137],["αὐτὴν",702165,104],["οἱ",709436,136],["δύο",703849,543],["πρεσβύτεροι",710735,52],["καθ᾿",707200,0],["ἡμέραν",705984,9],["εἰσπορευομένην",704124,173],["καὶ",707031,7],["περιπατοῦσαν",710362,78],["καὶ",707031,7],["ἐγένοντο",703104,189],["ἐν",704639,0],["ἐπιθυμίᾳ",705147,1],["αὐτῆς",702165,86]],"And the two elders saw her going in every day, and walking; so that their lust was inflamed toward her."],["9",[["καὶ",707031,7],["διέστρεψαν",703592,150],["τὸν",709436,5],["ἑαυτῶν",703917,40],["νοῦν",709374,6],["καὶ",707031,7],["ἐξέκλιναν",704220,150],["τοὺς",709436,58],["ὀφθαλμοὺς",709870,57],["αὐτῶν",702165,40],["τοῦ",709436,20],["μὴ",708851,28],["βλέπειν",702740,55],["εἰς",704105,0],["τὸν",709436,5],["οὐρανὸν",709844,6],["μηδὲ",708855,7],["μνημονεύειν",708965,55],["κριμάτων",707903,44],["δικαίων",703694,83]],"And they perverted their own mind, and turned away their eyes, that they might not look unto heaven, nor remember just judgments."],["10",[["καὶ",707031,7],["ἦσαν",704093,137],["ἀμφότεροι",700892,138],["κατανενυγμένοι",707347,429],["περὶ",710285,0],["αὐτῆς",702165,86],["καὶ",707031,7],["οὐκ",709805,28],["ἀνήγγειλαν",700921,150],["ἀλλήλοις",700689,151],["τὴν",709436,8],["ὀδύνην",709463,9],["αὐτῶν",702165,40]],"And albeit they both were wounded with her love, yet durst not one shew another his grief."],["11",[["ὅτι",709803,7],["ᾐσχύνοντο",700485,139],["ἀναγγεῖλαι",700921,106],["τὴν",709436,8],["ἐπιθυμίαν",705147,9],["αὐτῶν",702165,40],["ὅτι",709803,7],["ἤθελον",706176,137],["συγγενέσθαι",712186,109],["αὐτῇ",702165,105]],"For they were ashamed to declare their lust, that they desired to have to do with her."],["12",[["καὶ",707031,7],["παρετηροῦσαν",710110,137],["φιλοτίμως",713503,28],["καθ᾿",707200,0],["ἡμέραν",705984,9],["ὁρᾶν",709725,55],["αὐτήν",702165,104]],"Yet they watched diligently from day to day to see her."],["13",[["καὶ",707031,7],["εἶπαν",705373,150],["ἕτερος",705535,14],["τῷ",709436,113],["ἑτέρῳ",705535,30],["πορευθῶμεν",710667,283],["δὴ",703395,11],["εἰς",704105,0],["οἶκον",709516,6],["ὅτι",709803,7],["ἀρίστου",701753,21],["ὥρα",714128,12],["ἐστίν",704093,91],["καὶ",707031,7],["ἐξελθόντες",704909,196],["διεχωρίσθησαν",703640,99],["ἀπ᾿",701425,0],["ἀλλήλων",700689,40]],"And the one said to the other, Let us now go home: for it is dinner time."],["14",[["καὶ",707031,7],["ἀνακάμψαντες",700969,196],["ἦλθον",705453,150],["ἐπὶ",705080,0],["τὸ",709436,24],["αὐτὸ",702165,129],["καὶ",707031,7],["ἀνετάζοντες",701135,146],["ἀλλήλους",700689,62],["τὴν",709436,8],["αἰτίαν",700492,9],["ὡμολόγησαν",709632,150],["τὴν",709436,8],["ἐπιθυμίαν",705147,9],["αὐτῶν",702165,40],["καὶ",707031,7],["τότε",712908,28],["κοινῇ",707772,101],["συνετάξαντο",712508,189],["καιρὸν",707047,6],["ὅτε",709802,28],["αὐτὴν",702165,104],["δυνήσονται",703838,135],["εὑρεῖν",705676,106],["μόνην",709003,36]],"So when they were gone out, they parted the one from the other, and turning back again they came to the same place; and after that they had asked one another the cause, they acknowledged their lust: then appointed they a time both together, when they might find her alone."],["15",[["καὶ",707031,7],["ἐγένετο",703104,23],["ἐν",704639,0],["τῷ",709436,53],["παρατηρεῖν",710110,55],["αὐτοὺς",702165,62],["ἡμέραν",705984,9],["εὔθετον",705592,36],["εἰσῆλθέν",704114,2],["ποτε",710695,28],["καθὼς",707030,7],["ἐχθὲς",713853,28],["καὶ",707031,7],["τρίτης",712968,82],["ἡμέρας",705984,17],["μετὰ",708780,0],["δύο",703849,797],["μόνων",709003,83],["κορασίων",707832,44],["καὶ",707031,7],["ἐπεθύμησε",705141,2],["λούσασθαι",708258,109],["ἐν",704639,0],["τῷ",709436,113],["παραδείσῳ",710012,114],["ὅτι",709803,7],["καῦμα",707564,15],["ἦν",704093,13]],"And it fell out, as they watched a fit time, she went in as before with two maids only, and she was desirous to wash herself in the garden: for it was hot."],["16",[["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["οὐδεὶς",709817,14],["ἐκεῖ",704181,28],["πλὴν",710540,28],["οἱ",709436,136],["δύο",703849,543],["πρεσβύτεροι",710735,52],["κεκρυμμένοι",707923,429],["καὶ",707031,7],["παρατηροῦντες",710110,146],["αὐτήν",702165,104]],"And there was nobody there save the two elders, that had hid themselves, and watched her."],["17",[["καὶ",707031,7],["εἶπεν",705373,2],["τοῖς",709436,95],["κορασίοις",707832,96],["ἐνέγκατε",713428,74],["δή",703395,11],["μοι",708974,159],["ἔλαιον",704380,25],["καὶ",707031,7],["σμῆγμα",711910,25],["καὶ",707031,7],["τὰς",709436,38],["θύρας",706337,39],["τοῦ",709436,35],["παραδείσου",710012,18],["κλείσατε",707710,74],["ὅπως",709719,7],["λούσωμαι",708258,410]],"Then she said to her maids, Bring me oil and washing balls, and shut the garden doors, that I may wash."],["18",[["καὶ",707031,7],["ἐποίησαν",710582,150],["καθὼς",707030,7],["εἶπεν",705373,2],["καὶ",707031,7],["ἀπέκλεισαν",701484,150],["τὰς",709436,38],["θύρας",706337,39],["τοῦ",709436,35],["παραδείσου",710012,18],["καὶ",707031,7],["ἐξῆλθαν",704909,150],["κατὰ",707200,0],["τὰς",709436,38],["πλαγίας",710493,119],["θύρας",706337,39],["ἐνέγκαι",713428,106],["τὰ",709436,41],["προστεταγμένα",710962,388],["αὐταῖς",702165,200],["καὶ",707031,7],["οὐκ",709805,28],["εἴδοσαν",709725,150],["τοὺς",709436,58],["πρεσβυτέρους",710735,57],["ὅτι",709803,7],["ἦσαν",704093,137],["κεκρυμμένοι",707923,429]],"And they did as she bade them, and shut the garden doors, and went out themselves at private doors to fetch the things that she had commanded them: but they saw not the elders, because they were hid."],["19",[["καὶ",707031,7],["ἐγένετο",703104,23],["ὡς",714148,7],["ἐξήλθοσαν",704909,150],["τὰ",709436,41],["κοράσια",707832,42],["καὶ",707031,7],["ἀνέστησαν",701173,150],["οἱ",709436,136],["δύο",703849,543],["πρεσβῦται",710736,52],["καὶ",707031,7],["ἐπέδραμον",705312,150],["αὐτῇ",702165,105]],"Now when the maids were gone forth, the two elders rose up, and ran unto her, saying,"],["20",[["καὶ",707031,7],["εἶπον",705373,150],["ἰδοὺ",709725,300],["αἱ",709436,190],["θύραι",706337,191],["τοῦ",709436,35],["παραδείσου",710012,18],["κέκλεινται",707710,255],["καὶ",707031,7],["οὐδεὶς",709817,14],["θεωρεῖ",706226,91],["ἡμᾶς",705981,194],["καὶ",707031,7],["ἐν",704639,0],["ἐπιθυμίᾳ",705147,1],["σού",711945,133],["ἐσμεν",704093,243],["διὸ",703714,7],["συγκατάθου",712207,300],["ἡμῖν",705994,90],["καὶ",707031,7],["γενοῦ",703104,300],["μεθ᾿",708780,0],["ἡμῶν",705999,145]],"Behold, the garden doors are shut, that no man can see us, and we are in love with thee; therefore consent unto us, and lie with us."],["21",[["εἰ",704071,7],["δὲ",703303,11],["μή",708851,28],["καταμαρτυρήσομέν",707325,275],["σου",711945,133],["ὅτι",709803,7],["ἦν",704093,13],["μετὰ",708780,0],["σοῦ",711945,133],["νεανίσκος",709232,4],["καὶ",707031,7],["διὰ",703417,0],["τοῦτο",709858,129],["ἐξαπέστειλας",704872,162],["τὰ",709436,41],["κοράσια",707832,42],["ἀπὸ",701425,0],["σοῦ",711945,133]],"If thou wilt not, we will bear witness against thee, that a young man was with thee: and therefore thou didst send away thy maids from thee."],["22",[["καὶ",707031,7],["ἀνεστέναξεν",701057,2],["Σουσαννα",711971,12],["καὶ",707031,7],["εἶπεν",705373,2],["στενά",712068,195],["μοι",708974,159],["πάντοθεν",709984,28],["ἐάν",703912,7],["τε",712751,11],["γὰρ",702963,11],["τοῦτο",709858,129],["πράξω",710721,207],["θάνατός",706096,4],["μοί",708974,159],["ἐστιν",704093,91],["ἐάν",703912,7],["τε",712751,11],["μὴ",708851,28],["πράξω",710721,207],["οὐκ",709805,28],["ἐκφεύξομαι",704357,181],["τὰς",709436,38],["χεῖρας",713787,39],["ὑμῶν",713091,145]],"Then Susanna sighed, and said, I am straitened on every side: for if I do this thing, it is death unto me: and if I do it not, I cannot escape your hands."],["23",[["αἱρετόν",700471,26],["μοί",708974,159],["ἐστιν",704093,91],["μὴ",708851,28],["πράξασαν",710721,610],["ἐμπεσεῖν",704593,106],["εἰς",704105,0],["τὰς",709436,38],["χεῖρας",713787,39],["ὑμῶν",713091,145],["ἢ",705924,7],["ἁμαρτεῖν",700773,106],["ἐνώπιον",704823,563],["κυρίου",707996,18]],"It is better for me to fall into your hands, and not do it, than to sin in the sight of the Lord."],["24",[["καὶ",707031,7],["ἀνεβόησεν",700915,2],["φωνῇ",713640,1],["μεγάλῃ",708653,101],["Σουσαννα",711971,12],["ἐβόησαν",702743,150],["δὲ",703303,11],["καὶ",707031,7],["οἱ",709436,136],["δύο",703849,543],["πρεσβῦται",710736,52],["κατέναντι",707507,28],["αὐτῆς",702165,86]],"With that Susanna cried with a loud voice: and the two elders cried out against her."],["25",[["καὶ",707031,7],["δραμὼν",712931,182],["ὁ",709436,3],["εἷς",704106,596],["ἤνοιξεν",701186,2],["τὰς",709436,38],["θύρας",706337,39],["τοῦ",709436,35],["παραδείσου",710012,18]],"Then ran the one, and opened the garden door."],["26",[["ὡς",714148,7],["δὲ",703303,11],["ἤκουσαν",700587,150],["τὴν",709436,8],["κραυγὴν",707886,9],["ἐν",704639,0],["τῷ",709436,113],["παραδείσῳ",710012,114],["οἱ",709436,136],["ἐκ",704132,0],["τῆς",709436,16],["οἰκίας",709505,17],["εἰσεπήδησαν",704122,150],["διὰ",703417,0],["τῆς",709436,16],["πλαγίας",710493,82],["θύρας",706337,17],["ἰδεῖν",709725,106],["τὸ",709436,24],["συμβεβηκὸς",712277,409],["αὐτῇ",702165,105]],"So when the servants of the house heard the cry in the garden, they rushed in at a private door, to see what was done unto her."],["27",[["ἡνίκα",706008,28],["δὲ",703303,11],["εἶπαν",705373,150],["οἱ",709436,136],["πρεσβῦται",710736,52],["τοὺς",709436,58],["λόγους",708236,57],["αὐτῶν",702165,40],["κατῃσχύνθησαν",707257,99],["οἱ",709436,136],["δοῦλοι",703817,52],["σφόδρα",712586,28],["ὅτι",709803,7],["πώποτε",711118,28],["οὐκ",709805,28],["ἐρρέθη",705415,37],["λόγος",708236,4],["τοιοῦτος",712878,14],["περὶ",710285,0],["Σουσαννης",711971,17]],"But when the elders had declared their matter, the servants were greatly ashamed: for there was never such a report made of Susanna."],["28",[["καὶ",707031,7],["ἐγένετο",703104,23],["τῇ",709436,100],["ἐπαύριον",705050,28],["ὡς",714148,7],["συνῆλθεν",712458,2],["ὁ",709436,3],["λαὸς",708094,4],["πρὸς",710844,0],["τὸν",709436,5],["ἄνδρα",701150,6],["αὐτῆς",702165,86],["Ιωακιμ",706887,6],["ἦλθον",705453,150],["οἱ",709436,136],["δύο",703849,543],["πρεσβῦται",710736,52],["πλήρεις",710541,138],["τῆς",709436,16],["ἀνόμου",701194,82],["ἐννοίας",704764,17],["κατὰ",707200,0],["Σουσαννης",711971,17],["τοῦ",709436,20],["θανατῶσαι",706097,106],["αὐτὴν",702165,104]],"And it came to pass the next day, when the people were assembled to her husband Joacim, the two elders came also full of mischievous imagination against Susanna to put her to death;"],["29",[["καὶ",707031,7],["εἶπαν",705373,150],["ἔμπροσθεν",704618,0],["τοῦ",709436,35],["λαοῦ",708094,18],["ἀποστείλατε",701592,74],["ἐπὶ",705080,0],["Σουσανναν",711971,9],["θυγατέρα",706320,9],["Χελκιου",713816,18],["ἥ",709781,177],["ἐστιν",704093,91],["γυνὴ",703209,12],["Ιωακιμ",706887,18],["οἱ",709436,136],["δὲ",703303,11],["ἀπέστειλαν",701592,150]],"and said before the people, Send for Susanna, the daughter of Chelcias, Joacim's wife. And so they sent."],["30",[["καὶ",707031,7],["ἦλθεν",705453,2],["αὐτὴ",702165,107],["καὶ",707031,7],["οἱ",709436,136],["γονεῖς",703169,52],["αὐτῆς",702165,86],["καὶ",707031,7],["τὰ",709436,63],["τέκνα",712761,64],["αὐτῆς",702165,86],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["συγγενεῖς",712185,138],["αὐτῆς",702165,86]],"So she came with her father and mother, her children, and all her kindred."],["31",[["ἡ",709436,10],["δὲ",703303,11],["Σουσαννα",711971,12],["ἦν",704093,13],["τρυφερὰ",713006,29],["σφόδρα",712586,28],["καὶ",707031,7],["καλὴ",707097,29],["τῷ",709436,113],["εἴδει",704074,54]],"Now Susanna was a very delicate woman, and beauteous to behold."],["32",[["οἱ",709436,136],["δὲ",703303,11],["παράνομοι",710080,138],["ἐκέλευσαν",707601,150],["ἀποκαλυφθῆναι",701474,179],["αὐτήν",702165,104],["ἦν",704093,13],["γὰρ",702963,11],["κατακεκαλυμμένη",707260,203],["ὅπως",709719,7],["ἐμπλησθῶσιν",704592,272],["τοῦ",709436,20],["κάλλους",707093,21],["αὐτῆς",702165,86]],"And these wicked men commanded to uncover her [face] (for she was covered), that they might be filled with her beauty."],["33",[["ἔκλαιον",707703,137],["δὲ",703303,11],["οἱ",709436,136],["παρ᾿",709995,0],["αὐτῆς",702165,86],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["ἰδόντες",709725,196],["αὐτήν",702165,104]],"Therefore her friends and all that saw her wept."],["34",[["ἀναστάντες",701173,196],["δὲ",703303,11],["οἱ",709436,136],["δύο",703849,543],["πρεσβῦται",710736,52],["ἐν",704639,0],["μέσῳ",708768,30],["τῷ",709436,113],["λαῷ",708094,114],["ἔθηκαν",712849,150],["τὰς",709436,38],["χεῖρας",713787,39],["ἐπὶ",705080,0],["τὴν",709436,8],["κεφαλὴν",707639,9],["αὐτῆς",702165,86]],"Then the two elders stood up in the midst of the people, and laid their hands upon her head."],["35",[["ἡ",709436,10],["δὲ",703303,11],["κλαίουσα",707703,188],["ἀνέβλεψεν",700913,2],["εἰς",704105,0],["τὸν",709436,5],["οὐρανόν",709844,6],["ὅτι",709803,7],["ἦν",704093,13],["ἡ",709436,10],["καρδία",707141,12],["αὐτῆς",702165,86],["πεποιθυῖα",710221,287],["ἐπὶ",705080,0],["τῷ",709436,113],["κυρίῳ",707996,114]],"And she weeping looked up toward heaven: for her heart trusted in the Lord."],["36",[["εἶπαν",705373,150],["δὲ",703303,11],["οἱ",709436,136],["πρεσβῦται",710736,52],["περιπατούντων",710362,170],["ἡμῶν",705999,145],["ἐν",704639,0],["τῷ",709436,113],["παραδείσῳ",710012,114],["μόνων",709003,169],["εἰσῆλθεν",704114,2],["αὕτη",709858,107],["μετὰ",708780,0],["δύο",703849,544],["παιδισκῶν",709928,65],["καὶ",707031,7],["ἀπέκλεισεν",701484,2],["τὰς",709436,38],["θύρας",706337,39],["τοῦ",709436,35],["παραδείσου",710012,18],["καὶ",707031,7],["ἀπέλυσεν",701524,2],["τὰς",709436,38],["παιδίσκας",709928,39]],"And the elders said, As we walked in the garden alone, this woman came in with two maids, and shut the garden doors, and sent the maids away."],["37",[["καὶ",707031,7],["ἦλθεν",705453,2],["πρὸς",710844,0],["αὐτὴν",702165,104],["νεανίσκος",709232,4],["ὃς",709781,213],["ἦν",704093,13],["κεκρυμμένος",707923,419],["καὶ",707031,7],["ἀνέπεσε",701033,2],["μετ᾿",708780,0],["αὐτῆς",702165,86]],"Then a young man, who there was hid, came unto her, and lay with her."],["38",[["ἡμεῖς",705983,219],["δὲ",703303,11],["ὄντες",704093,146],["ἐν",704639,0],["τῇ",709436,100],["γωνίᾳ",703226,1],["τοῦ",709436,35],["παραδείσου",710012,18],["ἰδόντες",709725,196],["τὴν",709436,8],["ἀνομίαν",701192,9],["ἐδράμομεν",712931,289],["ἐπ᾿",705080,0],["αὐτούς",702165,62]],"Then we that stood in a corner of the garden, seeing this wickedness, ran unto them."],["39",[["καὶ",707031,7],["ἰδόντες",709725,196],["συγγινομένους",712186,236],["αὐτοὺς",702165,62],["ἐκείνου",704183,102],["μὲν",708730,11],["οὐκ",709805,28],["ἠδυνήθημεν",703838,485],["ἐγκρατεῖς",703990,138],["γενέσ