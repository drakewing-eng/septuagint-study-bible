ν",710133,9],["αὐτῶν",702165,40],["καὶ",707031,7],["ἐγεροῦσι",703949,135],["τοὺς",709436,58],["στρατηγοὺς",712144,57],["τῆς",709436,16],["δυνάμεως",703839,17],["Ασσουρ",702001,18],["καὶ",707031,7],["συνδραμοῦνται",712518,135],["ἐπὶ",705080,0],["τὴν",709436,8],["σκηνὴν",711845,9],["Ολοφέρνου",709601,18],["καὶ",707031,7],["οὐχ",709805,28],["εὑρήσουσιν",705676,218],["αὐτόν",702165,85],["καὶ",707031,7],["ἐπιπεσεῖται",705225,93],["ἐπ᾿",705080,0],["αὐτοὺς",702165,62],["φόβος",713534,4],["καὶ",707031,7],["φεύξονται",713433,135],["ἀπὸ",701425,0],["προσώπου",710986,21],["ὑμῶν",713091,145]],"Then they shall take their armour, and shall go into their camp, and raise up the captains of the army of Assur, and they shall run to the tent of Holofernes, but shall not find him: then fear shall fall upon them, and they shall flee before your face."],["4",[["καὶ",707031,7],["ἐπακολουθήσαντες",705007,196],["ὑμεῖς",713081,219],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["κατοικοῦντες",707534,146],["πᾶν",710177,46],["ὅριον",709749,25],["Ισραηλ",706839,18],["καταστρώσατε",707446,74],["αὐτοὺς",702165,62],["ἐν",704639,0],["ταῖς",709436,75],["ὁδοῖς",709458,76],["αὐτῶν",702165,40]],"So ye, and all that inherit the coast of Israel, shall pursue them, and overthrow them as they go."],["5",[["πρὸ",710747,0],["δὲ",703303,11],["τοῦ",709436,20],["ποιῆσαι",710582,106],["ταῦτα",709858,71],["καλέσατέ",707084,74],["μοι",708974,159],["Αχιωρ",702301,6],["τὸν",709436,5],["Αμμανίτην",700839,6],["ἵνα",706747,7],["ἰδὼν",704075,182],["ἐπιγνοῖ",705104,172],["τὸν",709436,5],["ἐκφαυλίσαντα",704355,365],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["Ισραηλ",706839,18],["καὶ",707031,7],["αὐτὸν",702165,85],["ὡς",714148,7],["εἰς",704105,0],["θάνατον",706096,6],["ἀποστείλαντα",701592,365],["εἰς",704105,0],["ἡμᾶς",705981,194]],"But before ye do these things, call me Achior the Ammonite, that he may see and know him that despised the house of Israel, and that sent him to us, as it were to his death."],["6",[["καὶ",707031,7],["ἐκάλεσαν",707084,150],["τὸν",709436,5],["Αχιωρ",702301,6],["ἐκ",704132,0],["τοῦ",709436,35],["οἴκου",709516,18],["Οζια",709474,18],["ὡς",714148,7],["δὲ",703303,11],["ἦλθεν",705453,2],["καὶ",707031,7],["εἶδεν",704075,2],["τὴν",709436,8],["κεφαλὴν",707639,9],["Ολοφέρνου",709601,18],["ἐν",704639,0],["χειρὶ",713787,1],["ἀνδρὸς",701150,18],["ἑνὸς",704106,116],["ἐν",704639,0],["τῇ",709436,100],["ἐκκλησίᾳ",704216,1],["τοῦ",709436,35],["λαοῦ",708094,18],["ἔπεσεν",710481,2],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["καὶ",707031,7],["ἐξελύθη",704254,37],["τὸ",709436,34],["πνεῦμα",710566,15],["αὐτοῦ",702165,102]],"Then they called Achior out of the house of Ozias; and when he was come, and saw the head of Holofernes in a man's hand in the assembly of the people, he fell down on his face, and his spirit failed."],["7",[["ὡς",714148,7],["δὲ",703303,11],["ἀνέλαβον",700984,150],["αὐτόν",702165,85],["προσέπεσεν",710952,2],["τοῖς",709436,147],["ποσὶν",710707,148],["Ιουδιθ",706777,17],["καὶ",707031,7],["προσεκύνησεν",710925,2],["τῷ",709436,53],["προσώπῳ",710986,54],["αὐτῆς",702165,86],["καὶ",707031,7],["εἶπεν",705373,2],["εὐλογημένη",705631,203],["σὺ",712181,164],["ἐν",704639,0],["παντὶ",710177,97],["σκηνώματι",711849,54],["Ιουδα",706768,18],["καὶ",707031,7],["ἐν",704639,0],["παντὶ",710177,97],["ἔθνει",704068,54],["οἵτινες",709793,450],["ἀκούσαντες",700587,196],["τὸ",709436,24],["ὄνομά",709666,25],["σου",711945,133],["ταραχθήσονται",712721,144]],"But when they had recovered him, he fell at Judith's feet, and reverenced her, and said, Blessed art thou in all the tabernacle of Juda, and in all nations, which hearing thy name shall be astonished."],["8",[["καὶ",707031,7],["νῦν",709384,28],["ἀνάγγειλόν",700921,176],["μοι",708974,159],["ὅσα",709788,68],["ἐποίησας",710582,162],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["ταύταις",709858,200],["καὶ",707031,7],["ἀπήγγειλεν",701321,2],["αὐτῷ",702165,50],["Ιουδιθ",706777,12],["ἐν",704639,0],["μέσῳ",708768,97],["τοῦ",709436,35],["λαοῦ",708094,18],["πάντα",710177,68],["ὅσα",709788,195],["ἦν",704093,13],["πεποιηκυῖα",710582,586],["ἀφ᾿",701425,0],["ἧς",709781,167],["ἡμέρας",705984,17],["ἐξῆλθεν",704909,2],["ἕως",705792,0],["οὗ",709781,167],["ἐλάλει",708071,13],["αὐτοῖς",702165,151]],"Now therefore tell me all the things that thou hast done in these days. Then Judith declared unto him in the midst of the people all that she had done, from the day that she went forth until that hour she spake unto them."],["9",[["ὡς",714148,7],["δὲ",703303,11],["ἐπαύσατο",710202,23],["λαλοῦσα",708071,188],["ἠλάλαξεν",700632,2],["ὁ",709436,3],["λαὸς",708094,4],["φωνῇ",713640,1],["μεγάλῃ",708653,101],["καὶ",707031,7],["ἔδωκεν",703654,2],["φωνὴν",713640,9],["εὐφρόσυνον",705718,36],["ἐν",704639,0],["τῇ",709436,100],["πόλει",710612,1],["αὐτῶν",702165,40]],"And when she had left off speaking, the people shouted with a loud voice, and made a joyful noise in their city."],["10",[["ἰδὼν",704075,182],["δὲ",703303,11],["Αχιωρ",702301,4],["πάντα",710177,68],["ὅσα",709788,68],["ἐποίησεν",710582,2],["ὁ",709436,3],["θεὸς",706192,4],["τοῦ",709436,35],["Ισραηλ",706839,18],["ἐπίστευσεν",710483,2],["τῷ",709436,113],["θεῷ",706192,114],["σφόδρα",712586,28],["καὶ",707031,7],["περιετέμετο",710402,23],["τὴν",709436,8],["σάρκα",711537,9],["τῆς",709436,16],["ἀκροβυστίας",700605,17],["αὐτοῦ",702165,102],["καὶ",707031,7],["προσετέθη",710965,37],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["Ισραηλ",706839,18],["ἕως",705792,0],["τῆς",709436,16],["ἡμέρας",705984,17],["ταύτης",709858,86]],"And when Achior had seen all that the God of Israel had done, he believed in God greatly, and circumcised the flesh of his foreskin, and was joined unto the house of Israel unto this day."],["11",[["ἡνίκα",706008,28],["δὲ",703303,11],["ὁ",709436,3],["ὄρθρος",709745,4],["ἀνέβη",700905,2],["καὶ",707031,7],["ἐκρέμασαν",707892,150],["τὴν",709436,8],["κεφαλὴν",707639,9],["Ολοφέρνου",709601,18],["ἐκ",704132,0],["τοῦ",709436,20],["τείχους",712759,21],["καὶ",707031,7],["ἀνέλαβεν",700984,2],["πᾶς",710177,14],["ἀνὴρ",701150,4],["τὰ",709436,41],["ὅπλα",709704,42],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἐξήλθοσαν",704909,150],["κατὰ",707200,0],["σπείρας",712004,39],["ἐπὶ",705080,0],["τὰς",709436,38],["ἀναβάσεις",700907,39],["τοῦ",709436,20],["ὄρους",709768,21]],"And as soon as the morning arose, they hanged the head of Holofernes upon the wall, and every man took his weapons, and they went forth by bands unto the straits of the mountain."],["12",[["οἱ",709436,136],["δὲ",703303,11],["υἱοὶ",713075,52],["Ασσουρ",702001,18],["ὡς",714148,7],["εἶδον",704075,150],["αὐτούς",702165,62],["διέπεμψαν",703542,150],["ἐπὶ",705080,0],["τοὺς",709436,58],["ἡγουμένους",705931,236],["αὐτῶν",702165,40],["οἱ",709436,136],["δὲ",703303,11],["ἦλθον",705453,150],["ἐπὶ",705080,0],["τοὺς",709436,58],["στρατηγοὺς",712144,57],["καὶ",707031,7],["χιλιάρχους",713857,57],["καὶ",707031,7],["ἐπὶ",705080,0],["πάντα",710177,27],["ἄρχοντα",701862,6],["αὐτῶν",702165,40]],"But when the Assyrians saw them, they sent to their leaders, which came to their captains and tribunes, and to every one of their rulers."],["13",[["καὶ",707031,7],["παρεγένοντο",710006,189],["ἐπὶ",705080,0],["τὴν",709436,8],["σκηνὴν",711845,9],["Ολοφέρνου",709601,18],["καὶ",707031,7],["εἶπαν",705373,150],["τῷ",709436,113],["ὄντι",704093,379],["ἐπὶ",705080,0],["πάντων",710177,83],["τῶν",709436,43],["αὐτοῦ",702165,102],["ἔγειρον",703949,176],["δὴ",703395,11],["τὸν",709436,5],["κύριον",707996,6],["ἡμῶν",705999,145],["ὅτι",709803,7],["ἐτόλμησαν",712886,150],["οἱ",709436,136],["δοῦλοι",703817,52],["καταβαίνειν",707202,55],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["εἰς",704105,0],["πόλεμον",710605,6],["ἵνα",706747,7],["ἐξολεθρευθῶσιν",704956,272],["εἰς",704105,0],["τέλος",712787,25]],"So they came to Holofernes' tent, and said to him that had the charge of all his things, Waken now our lord: for the slaves have been bold to come down upon us to battle, that they may be utterly destroyed."],["14",[["καὶ",707031,7],["εἰσῆλθεν",704114,2],["Βαγώας",702361,4],["καὶ",707031,7],["ἔκρουσε",707920,2],["τὴν",709436,8],["αὐλαίαν",702133,9],["τῆς",709436,16],["σκηνῆς",711845,17],["ὑπενόει",713227,13],["γὰρ",702963,11],["καθεύδειν",706996,55],["αὐτὸν",702165,85],["μετὰ",708780,0],["Ιουδιθ",706777,17]],"Then went in Bagoas, and knocked at the door of the tent; for he thought that he had slept with Judith."],["15",[["ὡς",714148,7],["δ᾿",703303,11],["οὐθεὶς",709817,14],["ἐπήκουσεν",705009,2],["διαστείλας",703588,182],["εἰσῆλθεν",704114,2],["εἰς",704105,0],["τὸν",709436,5],["κοιτῶνα",707782,6],["καὶ",707031,7],["εὗρεν",705676,2],["αὐτὸν",702165,85],["ἐπὶ",705080,0],["τῆς",709436,16],["χελωνίδος",713823,17],["ἐρριμμένον",711267,469],["νεκρόν",709247,6],["καὶ",707031,7],["ἡ",709436,10],["κεφαλὴ",707639,12],["αὐτοῦ",702165,102],["ἀφῄρητο",702177,361],["ἀπ᾿",701425,0],["αὐτοῦ",702165,102]],"But because none answered, he opened it, and went into the bedchamber, and found him cast upon the floor dead, and his head was taken from him."],["16",[["καὶ",707031,7],["ἐβόησεν",702743,2],["φωνῇ",713640,1],["μεγάλῃ",708653,101],["μετὰ",708780,0],["κλαυθμοῦ",707705,18],["καὶ",707031,7],["στεναγμοῦ",712065,18],["καὶ",707031,7],["βοῆς",702744,17],["ἰσχυρᾶς",706855,82],["καὶ",707031,7],["διέρρηξεν",703565,2],["τὰ",709436,41],["ἱμάτια",706742,42],["αὐτοῦ",702165,102]],"Therefore he cried with a loud voice, with weeping, and sighing, and a mighty cry, and rent his garments."],["17",[["καὶ",707031,7],["εἰσῆλθεν",704114,2],["εἰς",704105,0],["τὴν",709436,8],["σκηνήν",711845,9],["οὗ",709806,28],["ἦν",704093,13],["Ιουδιθ",706777,12],["καταλύουσα",707323,188],["καὶ",707031,7],["οὐχ",709805,28],["εὗρεν",705676,2],["αὐτήν",702165,104],["καὶ",707031,7],["ἐξεπήδησεν",704280,2],["εἰς",704105,0],["τὸν",709436,5],["λαὸν",708094,6],["καὶ",707031,7],["ἐβόησεν",702743,2]],"After he went into the tent where Judith lodged: and when he found her not, he leaped out to the people, and cried,"],["18",[["ἠθέτησαν",700369,150],["οἱ",709436,136],["δοῦλοι",703817,52],["ἐποίησεν",710582,2],["αἰσχύνην",700483,9],["μία",704106,29],["γυνὴ",703209,12],["τῶν",709436,80],["Εβραίων",703933,81],["εἰς",704105,0],["τὸν",709436,5],["οἶκον",709516,6],["τοῦ",709436,35],["βασιλέως",702580,18],["Ναβουχοδονοσορ",709149,18],["ὅτι",709803,7],["ἰδοὺ",706497,88],["Ολοφέρνης",709601,4],["χαμαί",713701,28],["καὶ",707031,7],["ἡ",709436,10],["κεφαλὴ",707639,12],["οὐκ",709805,28],["ἔστιν",704093,91],["ἐπ᾿",705080,0],["αὐτῷ",702165,50]],"These slaves have dealt treacherously; one woman of the Hebrews hath brought shame upon the house of king Nabuchodonosor: for, behold, Holofernes [lieth] upon the ground without a head."],["19",[["ὡς",714148,7],["δὲ",703303,11],["ἤκουσαν",700587,150],["ταῦτα",709858,71],["τὰ",709436,41],["ῥήματα",711246,42],["οἱ",709436,136],["ἄρχοντες",701862,52],["τῆς",709436,16],["δυνάμεως",703839,17],["Ασσουρ",702001,18],["τοὺς",709436,58],["χιτῶνας",713869,57],["αὐτῶν",702165,40],["διέρρηξαν",703565,150],["καὶ",707031,7],["ἐταράχθη",712721,37],["αὐτῶν",702165,40],["ἡ",709436,10],["ψυχὴ",714070,12],["σφόδρα",712586,28],["καὶ",707031,7],["ἐγένετο",703104,23],["αὐτῶν",702165,40],["κραυγὴ",707886,12],["καὶ",707031,7],["βοὴ",702744,12],["μεγάλη",708653,29],["σφόδρα",712586,28],["ἐν",704639,0],["μέσῳ",708768,97],["τῆς",709436,16],["παρεμβολῆς",710133,17]],"When the captains of the Assyrians' army heard these words, they rent their coats, and their minds were wonderfully troubled, and there was a cry and a very great noise throughout the camp."]]