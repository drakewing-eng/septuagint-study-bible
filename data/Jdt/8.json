,["ἐτελεύτησεν",712781,2],["ἐν",704639,0],["Βαιτυλουα",702453,1],["τῇ",709436,100],["πόλει",710612,1],["αὐτοῦ",702165,102],["καὶ",707031,7],["ἔθαψαν",706103,150],["αὐτὸν",702165,85],["μετὰ",708780,0],["τῶν",709436,80],["πατέρων",710189,81],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,113],["ἀγρῷ",700196,114],["τῷ",709436,113],["ἀνὰ",700902,0],["μέσον",708768,46],["Δωθαϊμ",703894,118],["καὶ",707031,7],["Βαλαμων",702475,118]],"For as he stood overseeing them that bound sheaves in the field, the heat came upon his head, and he fell on his bed, and died in his city of Bethulia: and they buried him with his fathers in the field between Dothaim and Balamo."],["4",[["καὶ",707031,7],["ἦν",704093,13],["Ιουδιθ",706777,12],["ἐν",704639,0],["τῷ",709436,113],["οἴκῳ",709516,114],["αὐτῆς",702165,86],["χηρεύουσα",713852,188],["ἔτη",705543,42],["τρία",712927,68],["καὶ",707031,7],["μῆνας",708874,57],["τέσσαρας",712808,60]],"So Judith was a widow in her house three years and four months."],["5",[["καὶ",707031,7],["ἐποίησεν",710582,2],["ἑαυτῇ",703917,105],["σκηνὴν",711845,9],["ἐπὶ",705080,0],["τοῦ",709436,20],["δώματος",703896,21],["τοῦ",709436,35],["οἴκου",709516,18],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐπέθηκεν",705304,2],["ἐπὶ",705080,0],["τὴν",709436,8],["ὀσφὺν",709800,9],["αὐτῆς",702165,86],["σάκκον",711386,6],["καὶ",707031,7],["ἦν",704093,13],["ἐπ᾿",705080,0],["αὐτῆς",702165,86],["τὰ",709436,63],["ἱμάτια",706742,64],["τῆς",709436,16],["χηρεύσεως",713851,17],["αὐτῆς",702165,86]],"And she made her a tent upon the top of her house, and put on sackcloth upon her loins, and ware her widow's apparel."],["6",[["καὶ",707031,7],["ἐνήστευε",709304,13],["πάσας",710177,119],["τὰς",709436,38],["ἡμέρας",705984,39],["τῆς",709436,16],["χηρεύσεως",713851,17],["αὐτῆς",702165,86],["χωρὶς",714016,0],["προσαββάτων",710845,44],["καὶ",707031,7],["σαββάτων",711350,44],["καὶ",707031,7],["προνουμηνιῶν",710828,65],["καὶ",707031,7],["νουμηνιῶν",709371,65],["καὶ",707031,7],["ἑορτῶν",704990,65],["καὶ",707031,7],["χαρμοσυνῶν",713747,169],["οἴκου",709516,18],["Ισραηλ",706839,18]],"And she fasted all the days of her widowhood, save the eves of the sabbaths, and the sabbaths, and the eves of the new moons, and the new moons, and the feasts and solemn days of the house of Israel."],["7",[["καὶ",707031,7],["ἦν",704093,13],["καλὴ",707097,29],["τῷ",709436,53],["εἴδει",704074,54],["καὶ",707031,7],["ὡραία",714132,29],["τῇ",709436,100],["ὄψει",709901,1],["σφόδρα",712586,28],["καὶ",707031,7],["ὑπελίπετο",713212,23],["αὐτῇ",702165,105],["Μανασσης",708470,4],["ὁ",709436,3],["ἀνὴρ",701150,4],["αὐτῆς",702165,86],["χρυσίον",713972,25],["καὶ",707031,7],["ἀργύριον",701707,25],["καὶ",707031,7],["παῖδας",709932,57],["καὶ",707031,7],["παιδίσκας",709928,39],["καὶ",707031,7],["κτήνη",707934,42],["καὶ",707031,7],["ἀγρούς",700196,57],["καὶ",707031,7],["ἔμενεν",708736,13],["ἐπ᾿",705080,0],["αὐτῶν",702165,40]],"She was also of a goodly countenance, and very beautiful to behold: and her husband Manasses had left her gold, and silver, and menservants, and maidservants, and cattle, and lands; and she remained upon them."],["8",[["καὶ",707031,7],["οὐκ",709805,28],["ἦν",704093,13],["ὃς",709781,213],["ἐπήνεγκεν",705322,2],["αὐτῇ",702165,105],["ῥῆμα",711246,25],["πονηρόν",710660,46],["ὅτι",709803,7],["ἐφοβεῖτο",713532,19],["τὸν",709436,5],["θεὸν",706192,6],["σφόδρα",712586,28]],"And there was none that gave her an ill word; for she feared God greatly."],["9",[["καὶ",707031,7],["ἤκουσεν",700587,2],["τὰ",709436,41],["ῥήματα",711246,42],["τοῦ",709436,35],["λαοῦ",708094,18],["τὰ",709436,41],["πονηρὰ",710660,68],["ἐπὶ",705080,0],["τὸν",709436,5],["ἄρχοντα",701862,6],["ὅτι",709803,7],["ὠλιγοψύχησαν",709575,150],["ἐν",704639,0],["τῇ",709436,100],["σπάνει",711993,1],["τῶν",709436,43],["ὑδάτων",713071,44],["καὶ",707031,7],["ἤκουσεν",700587,2],["πάντας",710177,60],["τοὺς",709436,58],["λόγους",708236,57],["Ιουδιθ",706777,12],["οὓς",709781,298],["ἐλάλησεν",708071,2],["πρὸς",710844,0],["αὐτοὺς",702165,62],["Οζιας",709474,4],["ὡς",714148,7],["ὤμοσεν",709620,2],["αὐτοῖς",702165,151],["παραδώσειν",710014,296],["τὴν",709436,8],["πόλιν",710612,9],["μετὰ",708780,0],["ἡμέρας",705984,39],["πέντε",710266,59],["τοῖς",709436,147],["Ἀσσυρίοις",702004,148]],"Now when she heard the evil words of the people against the governor, that they fainted for lack of water; for Judith had heard all the words that Ozias had spoken unto them, and that he had sworn to deliver the city unto the Assyrians after five days;"],["10",[["καὶ",707031,7],["ἀποστείλασα",701592,149],["τὴν",709436,8],["ἅβραν",700090,9],["αὐτῆς",702165,86],["τὴν",709436,8],["ἐφεστῶσαν",705756,336],["πᾶσιν",710177,94],["τοῖς",709436,95],["ὑπάρχουσιν",713104,358],["αὐτῆς",702165,86],["ἐκάλεσεν",707084,2],["Χαβριν",713655,6],["καὶ",707031,7],["Χαρμιν",713743,6],["τοὺς",709436,58],["πρεσβυτέρους",710735,496],["τῆς",709436,16],["πόλεως",710612,17],["αὐτῆς",702165,86]],"then she sent her waiting-woman, that had the government of all things that she had, to call Ozias and Chabris and Charmis, the ancients of the city."],["11",[["καὶ",707031,7],["ἦλθον",705453,150],["πρὸς",710844,0],["αὐτήν",702165,104],["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτούς",702165,62],["ἀκούσατε",700587,74],["δή",703395,11],["μου",709032,133],["ἄρχοντες",701862,274],["τῶν",709436,80],["κατοικούντων",707534,170],["ἐν",704639,0],["Βαιτυλουα",702453,1],["ὅτι",709803,7],["οὐκ",709805,28],["εὐθὴς",705596,14],["ὁ",709436,3],["λόγος",708236,4],["ὑμῶν",713091,145],["ὃν",709781,112],["ἐλαλήσατε",708071,265],["ἐναντίον",704654,0],["τοῦ",709436,35],["λαοῦ",708094,18],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["ταύτῃ",709858,105],["καὶ",707031,7],["ἐστήσατε",706846,265],["τὸν",709436,5],["ὅρκον",709753,6],["τοῦτον",709858,85],["ὃν",709781,112],["ἐλαλήσατε",708071,265],["ἀνὰ",700902,0],["μέσον",708768,46],["τοῦ",709436,35],["θεοῦ",706192,18],["καὶ",707031,7],["ὑμῶν",713091,145],["καὶ",707031,7],["εἴπατε",705373,265],["ἐκδώσειν",704171,296],["τὴν",709436,8],["πόλιν",710612,9],["τοῖς",709436,147],["ἐχθροῖς",705779,230],["ἡμῶν",705999,145],["ἐὰν",703912,7],["μὴ",708851,28],["ἐν",704639,0],["αὐταῖς",702165,200],["ἐπιστρέψῃ",705278,172],["κύριος",707996,4],["βοήθειαν",702745,9],["ὑμῖν",713084,90]],"And they came unto her, and she said unto them, Hear me now, O ye governors of the inhabitants of Bethulia: for your words that ye have spoken before the people this day are not right, touching this oath which ye made and pronounced between God and you, and have promised to deliver the city to our enemies, unless within these days the Lord turn to help you."],["12",[["καὶ",707031,7],["νῦν",709384,28],["τίνες",712867,392],["ἐστὲ",704093,87],["ὑμεῖς",713081,219],["οἳ",709781,250],["ἐπειράσατε",710225,265],["τὸν",709436,5],["θεὸν",706192,6],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["σήμερον",711751,28],["καὶ",707031,7],["ἵστατε",706846,87],["ὑπὲρ",713111,0],["τοῦ",709436,35],["θεοῦ",706192,18],["ἐν",704639,0],["μέσῳ",708768,97],["υἱῶν",713075,81],["ἀνθρώπων",701163,81]],"And now who are ye that have tempted God this day, and stand instead of God among the children of men?"],["13",[["καὶ",707031,7],["νῦν",709384,28],["κύριον",707996,6],["παντοκράτορα",709986,6],["ἐξετάζετε",704911,87],["καὶ",707031,7],["οὐθὲν",709817,46],["ἐπιγνώσεσθε",705104,124],["ἕως",705792,0],["τοῦ",709436,35],["αἰῶνος",700504,18]],"And now try the Lord Almighty, but ye shall never know any thing."],["14",[["ὅτι",709803,7],["βάθος",702376,25],["καρδίας",707141,17],["ἀνθρώπου",701163,18],["οὐχ",709805,28],["εὑρήσετε",705676,337],["καὶ",707031,7],["λόγους",708236,57],["τῆς",709436,16],["διανοίας",703531,17],["αὐτοῦ",702165,102],["οὐ",709805,28],["διαλήμψεσθε",703493,124],["καὶ",707031,7],["πῶς",711121,28],["τὸν",709436,5],["θεόν",706192,6],["ὃς",709781,213],["ἐποίησεν",710582,2],["πάντα",710177,68],["ταῦτα",709858,71],["ἐρευνήσετε",705412,337],["καὶ",707031,7],["τὸν",709436,5],["νοῦν",709374,6],["αὐτοῦ",702165,102],["ἐπιγνώσεσθε",705104,124],["καὶ",707031,7],["τὸν",709436,5],["λογισμὸν",708234,6],["αὐτοῦ",702165,102],["κατανοήσετε",707341,337],["μηδαμῶς",708854,28],["ἀδελφοί",700249,274],["μὴ",708851,28],["παροργίζετε",710167,335],["κύριον",707996,6],["τὸν",709436,5],["θεὸν",706192,6],["ἡμῶν",705999,145]],"For ye cannot find the depth of the heart of man, neither can ye perceive the things that he thinketh: then how can ye search out God, that hath made all these things, and know his mind, or comprehend his purpose? Nay, my brethren, provoke not the Lord our God to anger."],["15",[["ὅτι",709803,7],["ἐὰν",703912,7],["μὴ",708851,28],["βούληται",702795,428],["ἐν",704639,0],["ταῖς",709436,75],["πέντε",710266,59],["ἡμέραις",705984,76],["βοηθῆσαι",702746,106],["ἡμῖν",705994,90],["αὐτὸς",702165,121],["ἔχει",705785,91],["τὴν",709436,8],["ἐξουσίαν",704974,9],["ἐν",704639,0],["αἷς",709781,281],["θέλει",706176,91],["σκεπάσαι",711832,106],["ἡμέραις",705984,76],["ἢ",705924,7],["καὶ",707031,28],["ὀλεθρεῦσαι",709560,106],["ἡμᾶς",705981,194],["πρὸ",710747,0],["προσώπου",710986,21],["τῶν",709436,80],["ἐχθρῶν",705779,169],["ἡμῶν",705999,145]],"For if he will not help us within these five days, he hath power to defend us when he will, even every day, or to destroy us before our enemies."],["16",[["ὑμεῖς",713081,219],["δὲ",703303,11],["μὴ",708851,28],["ἐνεχυράζετε",704722,335],["τὰς",709436,38],["βουλὰς",702792,39],["κυρίου",707996,18],["τοῦ",709436,35],["θεοῦ",706192,18],["ἡμῶν",705999,145],["ὅτι",709803,7],["οὐχ",709805,28],["ὡς",714148,7],["ἄνθρωπος",701163,4],["ὁ",709436,3],["θεὸς",706192,4],["ἀπειληθῆναι",701374,179],["οὐδ᾿",709816,7],["ὡς",714148,7],["υἱὸς",713075,4],["ἀνθρώπου",701163,18],["διαιτηθῆναι",703462,179]],"Do not bind the counsels of the Lord our God: for God is not as man, that he may be threatened; neither is he as the son of man, that he should be wavering."],["17",[["διόπερ",703725,7],["ἀναμένοντες",701000,146],["τὴν",709436,8],["παρ᾿",709995,0],["αὐτοῦ",702165,102],["σωτηρίαν",712658,9],["ἐπικαλεσώμεθα",705153,276],["αὐτὸν",702165,85],["εἰς",704105,0],["βοήθειαν",702745,9],["ἡμῶν",705999,145],["καὶ",707031,7],["εἰσακούσεται",704108,93],["τῆς",709436,16],["φωνῆς",713640,17],["ἡμῶν",705999,145],["ἐὰν",703912,7],["ᾖ",704093,204],["αὐτῷ",702165,50],["ἀρεστόν",701723,26]],"Therefore let us wait for salvation of him, and call upon him to help us, and he will hear our voice, if it please him."],["18",[["ὅτι",709803,7],["οὐκ",709805,28],["ἀνέστη",701173,2],["ἐν",704639,0],["ταῖς",709436,75],["γενεαῖς",703037,76],["ἡμῶν",705999,145],["οὐδέ",709816,7],["ἐστιν",704093,91],["ἐν",704639,0],["τῇ",709436,100],["ἡμέρᾳ",705984,1],["τῇ",709436,100],["σήμερον",711751,28],["οὔτε",709857,7],["φυλὴ",713620,12],["οὔτε",709857,7],["πατριὰ",710192,12],["οὔτε",709857,7],["δῆμος",703411,4],["οὔτε",709857,7],["πόλις",710612,12],["ἐξ",704132,0],["ἡμῶν",705999,145],["οἳ",709781,250],["προσκυνοῦσι",710925,197],["θεοῖς",706192,148],["χειροποιήτοις",713796,230],["καθάπερ",706984,28],["ἐγένετο",703104,23],["ἐν",704639,0],["ταῖς",709436,75],["πρότερον",710991,28],["ἡμέραις",705984,76]],"For there arose none in our age, neither is there any now in these days, neither tribe, nor family, nor people, nor city, among us, which worship gods made with hands, as hath been aforetime."],["19",[["ὧν",709781,252],["χάριν",713735,9],["ἐδόθησαν",703654,99],["εἰς",704105,0],["ῥομφαίαν",711291,9],["καὶ",707031,7],["εἰς",704105,0],["διαρπαγὴν",703561,9],["οἱ",709436,136],["πατέρες",710189,52],["ἡμῶν",705999,145],["καὶ",707031,7],["ἔπεσον",710481,150],["πτῶμα",711071,25],["μέγα",708653,46],["ἐνώπιον",704823,0],["τῶν",709436,80],["ἐχθρῶν",705779,169],["ἡμῶν",705999,145]],"For the which cause our fathers were given to the sword, and for a spoil, and had a great fall before our enemies."],["20",[["ἡμεῖς",705983,219],["δὲ",703303,11],["ἕτερον",705535,27],["θεὸν",706192,6],["οὐκ",709805,28],["ἔγνωμεν",703105,289],["πλὴν",710540,0],["αὐτοῦ",702165,102],["ὅθεν",709486,28],["ἐλπίζομεν",704529,243],["ὅτι",709803,7],["οὐχ",709805,28],["ὑπερόψεται",713154,93],["ἡμᾶς",705981,194],["οὐδ᾿",709816,7],["ἀπὸ",701425,0],["τοῦ",709436,20],["γένους",703057,21],["ἡμῶν",705999,145]],"But we know none other God, therefore we trust that he will not despise us, nor any of our nation."],["21",[["ὅτι",709803,7],["ἐν",704639,0],["τῷ",709436,53],["λημφθῆναι",708076,179],["ἡμᾶς",705981,194],["οὕτως",709859,28],["καὶ",707031,7],["λημφθήσεται",708076,134],["πᾶσα",710177,29],["ἡ",709436,10],["Ιουδαία",706769,12],["καὶ",707031,7],["προνομευθήσεται",710826,134],["τὰ",709436,63],["ἅγια",700159,195],["ἡμῶν",705999,145],["καὶ",707031,7],["ἐκζητήσει",704187,127],["τὴν",709436,8],["βεβήλωσιν",702615,9],["αὐτῶν",702165,40],["ἐκ",704132,0],["τοῦ",709436,20],["αἵματος",700442,21],["ἡμῶν",705999,145]],"For if we be taken so, all Judea shall lie waste, and our sanctuary shall be spoiled; and he will require the profanation thereof at our mouth."],["22",[["καὶ",707031,7],["τὸν",709436,5],["φόνον",713549,6],["τῶν",709436,80],["ἀδελφῶν",700249,81],["ἡμῶν",705999,145],["καὶ",707031,7],["τὴν",709436,8],["αἰχμαλωσίαν",700499,9],["τῆς",709436,16],["γῆς",703083,17],["καὶ",707031,7],["τὴν",709436,8],["ἐρήμωσιν",705422,9],["τῆς",709436,16],["κληρονομίας",707725,17],["ἡμῶν",705999,145],["ἐπιστρέψει",705278,127],["εἰς",704105,0],["κεφαλὴν",707639,9],["ἡμῶν",705999,145],["ἐν",704639,0],["τοῖς",709436,95],["ἔθνεσιν",704068,96],["οὗ",709806,28],["ἐὰν",703912,7],["δουλεύσωμεν",703814,79],["ἐκεῖ",704181,28],["καὶ",707031,7],["ἐσόμεθα",704093,141],["εἰς",704105,0],["πρόσκομμα",710922,25],["καὶ",707031,7],["εἰς",704105,0],["ὄνειδος",709658,25],["ἐναντίον",704654,0],["τῶν",709436,80],["κτωμένων",707932,299],["ἡμᾶς",705981,194]],"And the slaughter of our brethren, and the captivity of the country, and the desolation of our inheritance, will he turn upon our heads among the Gentiles, wheresoever we shall be in bondage; and we shall be an offence and a reproach to all them that possess us."],["23",[["ὅτι",709803,7],["οὐ",709805,28],["κατευθυνθήσεται",707521,134],["ἡ",709436,10],["δουλεία",703813,12],["ἡμῶν",705999,145],["εἰς",704105,0],["χάριν",713735,9],["ἀλλ᾿",700680,7],["εἰς",704105,0],["ἀτιμίαν",702094,9],["θήσει",712849,127],["αὐτὴν",702165,104],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἡμῶν",705999,145]],"For our servitude shall not be directed to favour; but the Lord our God shall turn it to dishonour."],["24",[["καὶ",707031,7],["νῦν",709384,28],["ἀδελφοί",700249,274],["ἐπιδειξώμεθα",705112,276],["τοῖς",709436,147],["ἀδελφοῖς",700249,148],["ἡμῶν",705999,145],["ὅτι",709803,7],["ἐξ",704132,0],["ἡμῶν",705999,145],["κρέμαται",707892,117],["ἡ",709436,10],["ψυχὴ",714070,12],["αὐτῶν",702165,40],["καὶ",707031,7],["τὰ",709436,63],["ἅγια",700159,195],["καὶ",707031,7],["ὁ",709436,3],["οἶκος",709516,4],["καὶ",707031,7],["τὸ",709436,34],["θυσιαστήριον",706348,15],["ἐπεστήρισται",705270,23],["ἐφ᾿",705080,0],["ἡμῖν",705994,90]],"Now therefore, O brethren, let us shew an example to our brethren, because their hearts depend upon us, and the sanctuary, and the house, and the altar, rest upon us."],["25",[["παρὰ",709995,0],["ταῦτα",709858,71],["πάντα",710177,68],["εὐχαριστήσωμεν",705721,79],["κυρίῳ",707996,114],["τῷ",709436,113],["θεῷ",706192,114],["ἡμῶν",705999,145],["ὃς",709781,213],["πειράζει",710225,91],["ἡμᾶς",705981,194],["καθὰ",706979,28],["καὶ",707031,28],["τοὺς",709436,58],["πατέρας",710189,57],["ἡμῶν",705999,145]],"Moreover let us give thanks to the Lord our God, which trieth us, even as he did our fathers."],["26",[["μνήσθητε",708960,372],["ὅσα",709788,68],["ἐποίησεν",710582,2],["μετὰ",708780,0],["Αβρααμ",700091,18],["καὶ",707031,7],["ὅσα",709788,68],["ἐπείρασεν",710225,2],["τὸν",709436,5],["Ισαακ",706799,6],["καὶ",707031,7],["ὅσα",709788,195],["ἐγένετο",703104,23],["τῷ",709436,113],["Ιακωβ",706401,114],["ἐν",704639,0],["Μεσοποταμίᾳ",708767,1],["τῆς",709436,16],["Συρίας",712533,17],["ποιμαίνοντι",710594,379],["τὰ",709436,41],["πρόβατα",710768,42],["Λαβαν",708037,18],["τοῦ",709436,35],["ἀδελφοῦ",700249,18],["τῆς",709436,16],["μητρὸς",708892,17],["αὐτοῦ",702165,102]],"Remember what things he did to Abraham, and how he tried Isaac, and what happened to Jacob in Mesopotamia of Syria, when he kept the sheep of Laban his mother's brother."],["27",[["ὅτι",709803,7],["οὐ",709805,28],["καθὼς",707030,7],["ἐκείνους",704183,62],["ἐπύρωσεν",711103,2],["εἰς",704105,0],["ἐτασμὸν",705531,6],["τῆς",709436,16],["καρδίας",707141,17],["αὐτῶν",702165,40],["καὶ",707031,7],["ἡμᾶς",705981,194],["οὐκ",709805,28],["ἐξεδίκησεν",704174,2],["ἀλλ᾿",700680,7],["εἰς",704105,0],["νουθέτησιν",709369,9],["μαστιγοῖ",708566,91],["κύριος",707996,4],["τοὺς",709436,58],["ἐγγίζοντας",703939,235],["αὐτῷ",702165,50]],"For he hath not tried us in the fire, as he did them, for the examination of their hearts, neither hath he taken vengeance on us: but the Lord doth scourge them that come near unto him, to admonish them."],["28",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτὴν",702165,104],["Οζιας",709474,4],["πάντα",710177,68],["ὅσα",709788,68],["εἶπας",705373,162],["ἐν",704639,0],["ἀγαθῇ",700106,101],["καρδίᾳ",707141,1],["ἐλάλησας",708071,162],["καὶ",707031,7],["οὐκ",709805,28],["ἔστιν",704093,91],["ὃς",709781,213],["ἀντιστήσεται",701154,93],["τοῖς",709436,147],["λόγοις",708236,148],["σου",711945,133]],"Then said Ozias to her, All that thou hast spoken hast thou spoken with a good heart, and there is none that may gainsay thy words."],["29",[["ὅτι",709803,7],["οὐκ",709805,28],["ἐν",704639,0],["τῇ",709436,100],["σήμερον",711751,28],["ἡ",709436,10],["σοφία",711981,12],["σου",711945,133],["πρόδηλός",710779,29],["ἐστιν",704093,91],["ἀλλ᾿",700680,7],["ἀπ᾿",701425,0],["ἀρχῆς",701836,17],["ἡμερῶν",705984,65],["σου",711945,133],["ἔγνω",703105,2],["πᾶς",710177,14],["ὁ",709436,3],["λαὸς",708094,4],["τὴν",709436,8],["σύνεσίν",712460,9],["σου",711945,133],["καθότι",707021,7],["ἀγαθόν",700106,26],["ἐστιν",704093,91],["τὸ",709436,34],["πλάσμα",710502,15],["τῆς",709436,16],["καρδίας",707141,17],["σου",711945,133]],"For this is not the first day wherein thy wisdom is manifested; but from the beginning of thy days all the people have known thy understanding, because the disposition of thine heart is good."],["30",[["ἀλλὰ",700680,7],["ὁ",709436,3],["λαὸς",708094,4],["δεδίψηκεν",703763,171],["σφόδρα",712586,28],["καὶ",707031,7],["ἠνάγκασαν",700923,150],["ἡμᾶς",705981,194],["ποιῆσαι",710582,106],["καθὰ",706979,28],["ἐλαλήσαμεν",708071,289],["αὐτοῖς",702165,151],["καὶ",707031,7],["ἐπαγαγεῖν",704994,106],["ἐφ᾿",705080,0],["ἡμᾶς",705981,194],["ὅρκον",709753,6],["ὃν",709781,112],["οὐ",709805,28],["παραβησόμεθα",709996,141]],"But the people were very thirsty, and compelled us to do unto them as we have spoken, and to bring an oath upon ourselves, which we will not break."],["31",[["καὶ",707031,7],["νῦν",709384,28],["δεήθητι",703394,244],["περὶ",710285,0],["ἡμῶν",705999,145],["ὅτι",709803,7],["γυνὴ",703209,12],["εὐσεβὴς",705687,29],["εἶ",704093,154],["καὶ",707031,7],["ἀποστελεῖ",701592,127],["κύριος",707996,4],["τὸν",709436,5],["ὑετὸν",713074,6],["εἰς",704105,0],["πλήρωσιν",710545,9],["τῶν",709436,80],["λάκκων",708067,81],["ἡμῶν",705999,145],["καὶ",707031,7],["οὐκ",709805,28],["ἐκλείψομεν",704237,275],["ἔτι",705538,28]],"Therefore now pray thou for us, because thou art a godly woman, and the Lord will send us rain to fill our cisterns, and we shall faint no more."],["32",[["καὶ",707031,7],["εἶπεν",705373,2],["πρὸς",710844,0],["αὐτοὺς",702165,62],["Ιουδιθ",706777,12],["ἀκούσατέ",700587,74],["μου",709032,133],["καὶ",707031,7],["ποιήσω",710582,165],["πρᾶγμα",710708,25],["ὃ",709781,213],["ἀφίξεται",702212,93],["εἰς",704105,0],["γενεὰς",703037,39],["γενεῶν",703037,65],["υἱοῖς",713075,148],["τοῦ",709436,20],["γένους",703057,21],["ἡμῶν",705999,145]],"Then said Judith unto them, Hear me, and I will do a thing, which shall go throughout all generations to the children of our nation."],["33",[["ὑμεῖς",713081,219],["στήσεσθε",706846,124],["ἐπὶ",705080,0],["τῆς",709436,16],["πύλης",711082,17],["τὴν",709436,8],["νύκτα",709386,9],["ταύτην",709858,104],["καὶ",707031,7],["ἐξελεύσομαι",704909,181],["ἐγὼ",704018,164],["μετὰ",708780,0],["τῆς",709436,16],["ἅβρας",700090,17],["μου",709032,133],["καὶ",707031,7],["ἐν",704639,0],["ταῖς",709436,75],["ἡμέραις",705984,76],["μεθ᾿",708780,0],["ἃς",709781,193],["εἴπατε",705373,265],["παραδώσειν",710014,296],["τὴν",709436,8],["πόλιν",710612,9],["τοῖς",709436,147],["ἐχθροῖς",705779,230],["ἡμῶν",705999,145],["ἐπισκέψεται",705250,93],["κύριος",707996,4],["τὸν",709436,5],["Ισραηλ",706839,6],["ἐν",704639,0],["χειρί",713787,1],["μου",709032,133]],"Ye shall stand this night in the gate, and I will go forth with my waitingwoman: and within the days that ye have promised to deliver the city to our enemies the Lord will visit Israel by mine hand."],["34",[["ὑμεῖς",713081,219],["δὲ",703303,11],["οὐκ",709805,28],["ἐξερευνήσετε",704905,337],["τὴν",709436,8],["πρᾶξίν",710714,9],["μου",709032,133],["οὐ",709805,28],["γὰρ",702963,11],["ἐρῶ",705415,165],["ὑμῖν",713084,90],["ἕως",705792,0],["τοῦ",709436,20],["τελεσθῆναι",712783,179],["ἃ",709781,69],["ἐγὼ",704018,164],["ποιῶ",710582,157]],"But enquire not ye of mine act: for I will not declare it unto you, till the things be finished that I do."],["35",[["καὶ",707031,7],["εἶπεν",705373,2],["Οζιας",709474,4],["καὶ",707031,7],["οἱ",709436,136],["ἄρχοντες",701862,52],["πρὸς",710844,0],["αὐτήν",702165,104],["πορεύου",710667,240],["εἰς",704105,0],["εἰρήνην",704098,9],["καὶ",707031,7],["κύριος",707996,4],["ὁ",709436,3],["θεὸς",706192,4],["ἔμπροσθέν",704618,0],["σου",711945,133],["εἰς",704105,0],["ἐκδίκησιν",704175,9],["τῶν",709436,80],["ἐχθρῶν",705779,169],["ἡμῶν",705999,145]],"Then said Ozias and the princes unto her, Go in peace, and the Lord God be before thee, to take vengeance on our enemies."],["36",[["καὶ",707031,7],["ἀποστρέψαντες",701598,196],["ἐκ",704132,0],["τῆς",709436,16],["σκηνῆς",711845,17],["ἐπορεύθησαν",710667,99],["ἐπὶ",705080,0],["τὰς",709436,38],["διατάξεις",703602,39],["αὐτῶν",702165,40]],"So they returned from the tent, and went to their wards."]]