ς",703209,39],["τοιαύτας",712878,119],["ὅτι",709803,7],["οὐ",709805,28],["καλόν",707097,46],["ἐστιν",704093,91],["ὑπολείπεσθαι",713212,110],["ἐξ",704132,0],["αὐτῶν",702165,40],["ἄνδρα",701150,6],["ἕνα",704106,27],["οἳ",709781,250],["ἀφεθέντες",702211,247],["δυνήσονται",703838,135],["κατασοφίσασθαι",707429,109],["πᾶσαν",710177,36],["τὴν",709436,8],["γῆν",703083,9]],"And they wondered at her beauty, and admired the children of Israel because of her, and every one said to his neighbour, Who would despise this people, that have among them such women? surely it is not good that one man of them be left, who being let go might deceive the whole earth."],["20",[["καὶ",707031,7],["ἐξῆλθον",704909,150],["οἱ",709436,136],["παρακαθεύδοντες",710035,146],["Ολοφέρνῃ",709601,114],["καὶ",707031,7],["πάντες",710177,138],["οἱ",709436,136],["θεράποντες",706201,52],["αὐτοῦ",702165,102],["καὶ",707031,7],["εἰσήγαγον",704107,150],["αὐτὴν",702165,104],["εἰς",704105,0],["τὴν",709436,8],["σκηνήν",711845,9]],"And they that lay near Holofernes went out, and all his servants, and they brought her into the tent."],["21",[["καὶ",707031,7],["ἦν",704093,13],["Ολοφέρνης",709601,4],["ἀναπαυόμενος",701027,122],["ἐπὶ",705080,0],["τῆς",709436,16],["κλίνης",707737,17],["αὐτοῦ",702165,102],["ἐν",704639,0],["τῷ",709436,53],["κωνωπίῳ",708025,54],["ὃ",709781,33],["ἦν",704093,13],["ἐκ",704132,0],["πορφύρας",710682,17],["καὶ",707031,7],["χρυσίου",713972,21],["καὶ",707031,7],["σμαράγδου",711909,18],["καὶ",707031,7],["λίθων",708196,81],["πολυτελῶν",710647,169],["καθυφασμένων",707028,445]],"Now Holofernes rested upon his bed under a canopy, which was woven with purple, and gold, and emeralds, and precious stones."],["22",[["καὶ",707031,7],["ἀνήγγειλαν",700921,150],["αὐτῷ",702165,50],["περὶ",710285,0],["αὐτῆς",702165,86],["καὶ",707031,7],["ἐξῆλθεν",704909,2],["εἰς",704105,0],["τὸ",709436,24],["προσκήνιον",710918,25],["καὶ",707031,7],["λαμπάδες",708079,191],["ἀργυραῖ",701705,192],["προάγουσαι",710748,306],["αὐτοῦ",702165,102]],"So they shewed him of her; and he came out before his tent with silver lamps going before him."],["23",[["ὡς",714148,7],["δὲ",703303,11],["ἦλθεν",705453,2],["κατὰ",707200,0],["πρόσωπον",710986,25],["αὐτοῦ",702165,102],["Ιουδιθ",706777,12],["καὶ",707031,7],["τῶν",709436,80],["θεραπόντων",706201,81],["αὐτοῦ",702165,102],["ἐθαύμασαν",706135,150],["πάντες",710177,138],["ἐπὶ",705080,0],["τῷ",709436,53],["κάλλει",707093,54],["τοῦ",709436,20],["προσώπου",710986,21],["αὐτῆς",702165,86],["καὶ",707031,7],["πεσοῦσα",710481,149],["ἐπὶ",705080,0],["πρόσωπον",710986,25],["προσεκύνησεν",710925,2],["αὐτῷ",702165,50],["καὶ",707031,7],["ἤγειραν",703949,150],["αὐτὴν",702165,104],["οἱ",709436,136],["δοῦλοι",703817,52],["αὐτοῦ",702165,102]],"And when Judith was come before him and his servants, they all marvelled at the beauty of her countenance; and she fell down upon her face, and did reverence unto him: and his servants took her up."]]